diff --git a/app/models/account/data_transfer/card_archive.rb b/app/models/account/data_transfer/card_archive.rb
new file mode 100644
index 0000000..a606a92
--- /dev/null
+++ b/app/models/account/data_transfer/card_archive.rb
@@ -0,0 +1,127 @@
+class Account::DataTransfer::CardArchive
+  def initialize(user: nil, account: nil)
+    @user = user
+    @account = account || user&.account
+  end
+
+  def write(zip, include_files: true)
+    @zip = zip
+    @include_files = include_files
+    @written_files = {}
+
+    cards.find_each do |card|
+      files = files_for(card)
+      comment_payloads = card.comments.map { |comment| comment_payload(comment) }
+      zip.add_file("cards/#{card.number}.json", JSON.generate(card_payload(card, files, comment_payloads)))
+    end
+  end
+
+  private
+    attr_reader :zip
+
+    def cards
+      scope = if @user
+        @user.accessible_cards
+      else
+        @account.cards
+      end
+
+      scope.includes(
+        :board,
+        :column,
+        :tags,
+        :steps,
+        :assignees,
+        { creator: :identity },
+        { image_attachment: :blob },
+        { rich_text_description: { embeds_attachments: :blob } },
+        comments: [
+          { creator: :identity },
+          { rich_text_body: { embeds_attachments: :blob } }
+        ]
+      )
+    end
+
+    def card_payload(card, files, comments)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        due_on: card.due_on,
+        created_at: card.created_at&.utc&.iso8601,
+        updated_at: card.updated_at&.utc&.iso8601,
+        last_active_at: card.last_active_at&.utc&.iso8601,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        board: { id: card.board_id, name: card.board.name },
+        column: card.column && { id: card.column_id, name: card.column.name, color: card.column.read_attribute(:color) },
+        creator: person(card.creator),
+        assignees: card.assignees.map { |user| person(user) },
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.map { |step| { id: step.id, content: step.content, completed: step.completed? } },
+        description: rich_text_payload(card.try(:description)),
+        image: files[:image],
+        attachments: files[:attachments],
+        comments: comments
+      }
+    end
+
+    def comment_payload(comment)
+      files = attachment_descriptors(comment)
+      {
+        id: comment.id,
+        created_at: comment.created_at&.utc&.iso8601,
+        updated_at: comment.updated_at&.utc&.iso8601,
+        creator: person(comment.creator),
+        body: rich_text_payload(comment.body),
+        attachments: files
+      }
+    end
+
+    def files_for(card)
+      image = descriptor_for_blob(card.image.blob) if card.image.attached?
+      { image: image, attachments: attachment_descriptors(card) }
+    end
+
+    def attachment_descriptors(record)
+      return [] unless record.respond_to?(:attachments)
+
+      record.attachments.filter_map { |attachment| descriptor_for_blob(attachment.blob) }
+    end
+
+    def descriptor_for_blob(blob)
+      return unless blob
+
+      write_file(blob)
+      {
+        path: Account::DataTransfer.file_path(blob.key),
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size
+      }
+    end
+
+    def write_file(blob)
+      return unless @include_files
+      return if @written_files[blob.key]
+
+      @written_files[blob.key] = true
+      zip.add_file(Account::DataTransfer.file_path(blob.key), compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+
+    def person(user)
+      return unless user
+
+      { id: user.id, name: user.name, email_address: user.identity&.email_address }
+    end
+
+    def rich_text_payload(rich_text)
+      return { plain_text: "", html: "" } if rich_text.blank?
+
+      { plain_text: rich_text.to_plain_text, html: rich_text.to_s }
+    end
+end
diff --git a/app/models/account/data_transfer/cleaner.rb b/app/models/account/data_transfer/cleaner.rb
new file mode 100644
index 0000000..8a42ab3
--- /dev/null
+++ b/app/models/account/data_transfer/cleaner.rb
@@ -0,0 +1,81 @@
+class Account::DataTransfer::Cleaner
+  JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  def self.wipe(account)
+    new(account).wipe
+  end
+
+  def initialize(account)
+    @account = account
+  end
+
+  def wipe
+    return unless @account && Account.exists?(@account.id)
+
+    delete_files
+    delete_join_rows
+    delete_search_records
+    delete_account_rows
+    @account.delete
+  end
+
+  private
+    def delete_files
+      ActiveStorage::Blob.where(account_id: @account.id).find_each do |blob|
+        blob.service.delete(blob.key)
+      rescue StandardError
+        nil
+      end
+    end
+
+    def delete_join_rows
+      filter_ids = Filter.where(account_id: @account.id).pluck(:id)
+      return if filter_ids.empty?
+
+      JOIN_TABLES.each do |table|
+        quoted = ApplicationRecord.connection.quote_table_name(table)
+        ApplicationRecord.connection.execute(
+          ApplicationRecord.sanitize_sql_array([ "DELETE FROM #{quoted} WHERE filter_id IN (?)", filter_ids ])
+        )
+      end
+    end
+
+    def delete_search_records
+      scope = Search::Record.for(@account.id).where(account_id: @account.id)
+      scope.find_each(&:destroy)
+    rescue StandardError
+      nil
+    end
+
+    def delete_account_rows
+      models.each do |model|
+        next if model == Account
+
+        model.where(account_id: @account.id).delete_all
+      end
+    end
+
+    def models
+      Rails.application.eager_load! unless Rails.application.config.eager_load
+
+      klasses = ApplicationRecord.descendants + [
+        ActiveStorage::Blob,
+        ActiveStorage::Attachment,
+        ActiveStorage::VariantRecord,
+        ActionText::RichText
+      ]
+
+      klasses.uniq.select do |model|
+        model.respond_to?(:column_names) && model.table_exists? && model.column_names.include?("account_id")
+      rescue StandardError
+        false
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/import_context.rb b/app/models/account/data_transfer/import_context.rb
new file mode 100644
index 0000000..b07031b
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,57 @@
+class Account::DataTransfer::ImportContext
+  attr_accessor :account
+  attr_reader :identity, :importer, :id_map, :key_map, :uploaded_keys
+
+  def initialize(identity:, importer:)
+    @identity = identity
+    @importer = importer
+    @id_map = {}
+    @key_map = {}
+    @uploaded_keys = []
+  end
+
+  def allocate(old_id)
+    return if old_id.blank?
+
+    id_map[old_id.to_s] ||= ActiveRecord::Type::Uuid.generate
+  end
+
+  def remap(old_id)
+    return if old_id.blank?
+
+    id_map[old_id.to_s]
+  end
+
+  def map_key(old_key, new_key)
+    key_map[old_key] = new_key
+  end
+
+  def remap_key(old_key)
+    key_map[old_key]
+  end
+
+  def deep_remap(value)
+    case value
+    when Hash
+      value.transform_values { |nested| deep_remap(nested) }
+    when Array
+      value.map { |nested| deep_remap(nested) }
+    when String
+      remap(value) || value
+    else
+      value
+    end
+  end
+
+  def rewrite_sgid(sgid)
+    signed = SignedGlobalID.parse(sgid, for: "attachable")
+    return sgid unless signed
+
+    new_id = remap(signed.model_id)
+    return sgid unless new_id
+
+    signed.model_class.new(id: new_id).to_sgid(expires_in: nil, for: "attachable").to_s
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ArgumentError
+    sgid
+  end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..97b952d
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,99 @@
+class Account::DataTransfer::Importer
+  def initialize(zip, identity:, importer:)
+    @zip = zip
+    @context = Account::DataTransfer::ImportContext.new(identity: identity, importer: importer)
+  end
+
+  def perform
+    manifest = read_manifest
+    unless manifest["format"] == Account::DataTransfer::ACCOUNT_FORMAT
+      raise Account::DataTransfer::InvalidArchive, "This file isn't a Fizzy account export."
+    end
+
+    sets = record_sets
+    account_set = sets.find { |set| set.is_a?(Account::DataTransfer::AccountRecordSet) }
+    raise Account::DataTransfer::InvalidArchive, "This file isn't a Fizzy account export." unless account_set
+
+    account_set.import(@zip, @context)
+    raise Account::DataTransfer::InvalidArchive, "This file isn't a Fizzy account export." unless @context.account
+
+    Current.with_account(@context.account) do
+      sets.each do |set|
+        next if set.equal?(account_set)
+
+        set.preallocate(@zip, @context)
+      end
+
+      sets.each do |set|
+        next if set.equal?(account_set)
+
+        set.import(@zip, @context)
+      end
+
+      ensure_importer_access
+    end
+
+    finalize(@context.account)
+    @context.account
+  rescue => error
+    Account::DataTransfer::Cleaner.wipe(@context.account)
+    raise error
+  end
+
+  private
+    def read_manifest
+      unless @zip.exists?("manifest.json")
+        raise Account::DataTransfer::InvalidArchive, "This file isn't a Fizzy account export."
+      end
+
+      JSON.parse(@zip.read("manifest.json"))
+    rescue JSON::ParserError
+      raise Account::DataTransfer::InvalidArchive, "This file isn't a Fizzy account export."
+    end
+
+    def record_sets
+      Account::DataTransfer::Manifest.new(nil).each_record_set.to_a
+    end
+
+    def ensure_importer_access
+      account = @context.account
+      identity = @context.identity
+      existing = account.users.find_by(identity: identity)
+
+      if existing
+        unless existing.active? && existing.verified?
+          existing.update_columns(active: true, verified_at: existing.verified_at || Time.current)
+        end
+      else
+        user = account.users.create!(
+          identity: identity,
+          name: @context.importer&.name.presence || identity.email_address,
+          role: :owner,
+          active: true,
+          verified_at: Time.current
+        )
+        account.boards.find_each do |board|
+          board.accesses.create!(user: user) unless board.accessible_to?(user)
+        end
+      end
+    end
+
+    def finalize(account)
+      Account::JoinCode.create!(account: account) unless account.join_code
+      reindex(account)
+      reconcile_storage(account)
+    rescue => error
+      Rails.error.report(error, handled: true)
+      Rails.logger.error("Account import finalize failed: #{error.class}: #{error.message}")
+    end
+
+    def reindex(account)
+      Card.where(account_id: account.id).find_each(&:reindex)
+      Comment.where(account_id: account.id).find_each(&:reindex)
+    end
+
+    def reconcile_storage(account)
+      account.reconcile_storage
+      Board.where(account_id: account.id).find_each(&:reconcile_storage)
+    end
+end
