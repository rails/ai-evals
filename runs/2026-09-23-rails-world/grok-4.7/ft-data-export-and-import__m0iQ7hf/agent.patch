diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..e8fcbee
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,60 @@
+class Export < ApplicationRecord
+  DOWNLOAD_EXPIRES_IN = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :kind, %w[ account cards ].index_by(&:itself)
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  def process_later
+    ExportJob.perform_later(self)
+  end
+
+  def process
+    update!(status: :processing)
+
+    filename = kind == "cards" ? "fizzy-cards.zip" : "fizzy-account.zip"
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if cards?
+        Account::DataTransfer::CardArchive.new(user: user).write(zip)
+        zip.add_file("manifest.json", JSON.generate(card_manifest))
+      else
+        Account::DataTransfer.export(account, zip)
+        Account::DataTransfer::CardArchive.new(account: account).write(zip, include_files: false)
+        zip.add_file("manifest.json", JSON.generate(account_manifest))
+      end
+    end
+
+    update!(status: :completed, completed_at: Time.current, error_message: nil)
+    ExportMailer.ready(self).deliver_later
+  rescue => error
+    update!(status: :failed, error_message: error.message.to_s.truncate(500))
+    ExportMailer.failed(self).deliver_later
+  end
+
+  def download_id
+    signed_id(purpose: :download, expires_in: DOWNLOAD_EXPIRES_IN)
+  end
+
+  private
+    def account_manifest
+      {
+        format: Account::DataTransfer::ACCOUNT_FORMAT,
+        version: Account::DataTransfer::VERSION,
+        exported_at: Time.current.utc.iso8601,
+        account_name: account.name
+      }
+    end
+
+    def card_manifest
+      {
+        format: Account::DataTransfer::CARDS_FORMAT,
+        version: Account::DataTransfer::VERSION,
+        exported_at: Time.current.utc.iso8601
+      }
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..3db29e7
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,46 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :identity
+  belongs_to :created_account, class_name: "Account", optional: true
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  validates :file, presence: true, on: :process
+
+  def process_later
+    ImportJob.perform_later(self)
+  end
+
+  def process
+    update!(status: :processing, error_message: nil)
+
+    created = nil
+
+    begin
+      created = Account::DataTransfer.import(file.blob, identity: identity, importer: user)
+      update!(status: :completed, created_account: created, error_message: nil)
+      ImportMailer.completed(self).deliver_later
+    rescue => error
+      Account::DataTransfer::Cleaner.wipe(created)
+      update!(status: :failed, created_account: nil, error_message: failure_message(error))
+      ImportMailer.failed(self).deliver_later
+    end
+  end
+
+  private
+    def failure_message(error)
+      message = case error
+      when Account::DataTransfer::InvalidArchive
+        error.message
+      when ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::InvalidStructure
+        "The file isn't a valid zip archive."
+      else
+        "Something went wrong while importing: #{error.message}"
+      end
+
+      message.to_s.truncate(500)
+    end
+end
