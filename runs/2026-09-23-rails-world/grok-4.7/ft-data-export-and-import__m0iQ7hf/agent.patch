+class Account::ImportsController < ApplicationController
+  def new
+  end
+
+  def create
+    import = Import.new(account: Current.account, user: Current.user, identity: Current.identity)
+    import.file.attach(import_file)
+
+    if import.file.attached? && import.save
+      import.process_later
+
+      respond_to do |format|
+        format.html { redirect_to new_account_import_path, notice: "We'll email you when your import is done." }
+        format.json { render json: { id: import.id, status: import.status }, status: :accepted }
