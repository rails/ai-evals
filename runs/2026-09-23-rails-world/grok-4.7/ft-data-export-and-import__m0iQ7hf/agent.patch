diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..559f854
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,61 @@
+class ZipFile::BlobIO
+  def initialize(blob)
+    @blob = blob
+    @pos = 0
+    @file = open_local_file
+  end
+
+  def binmode
+    self
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise ArgumentError, "Unsupported seek mode #{mode}" unless mode == IO::SEEK_SET
+
+    @pos = offset
+    @file&.seek(offset)
+    0
+  end
+
+  def read(n_bytes = nil)
+    return "" if n_bytes == 0
+
+    available = size - @pos
+    return nil if n_bytes && available <= 0
+    return "" if available <= 0
+
+    n_bytes = available if n_bytes.nil? || n_bytes > available
+    return "" if n_bytes == 0
+
+    data = if @file
+      @file.read(n_bytes)
+    else
+      @blob.service.download_chunk(@blob.key, @pos..(@pos + n_bytes - 1))
+    end
+
+    @pos += data.to_s.bytesize
+    data
+  end
+
+  def size
+    @blob.byte_size
+  end
+
+  def tell
+    @pos
+  end
+
+  def close
+    @file&.close
+    @file = nil
+  end
+
+  private
+    def open_local_file
+      return unless @blob.service.respond_to?(:path_for)
+
+      File.open(@blob.service.path_for(@blob.key), "rb")
+    rescue Errno::ENOENT
+      nil
+    end
+end
diff --git a/app/models/zip_file/extract_io.rb b/app/models/zip_file/extract_io.rb
new file mode 100644
index 0000000..1c17b7c
--- /dev/null
+++ b/app/models/zip_file/extract_io.rb
@@ -0,0 +1,41 @@
+class ZipFile::ExtractIO
+  def initialize(io, entry)
+    @io = io
+    @entry = entry
+    rewind
+  end
+
+  def size
+    @entry.uncompressed_size
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      data = +"".b
+      until @reader.eof?
+        chunk = @reader.extract(1.megabyte)
+        break if chunk.nil?
+        data << chunk
+      end
+      return outbuf ? outbuf.replace(data) : data
+    end
+
+    while @buffer.bytesize < length && !@reader.eof?
+      chunk = @reader.extract([ length, 1.megabyte ].max)
+      break if chunk.nil?
+      @buffer << chunk
+    end
+
+    data = @buffer.byteslice(0, length).to_s
+    @buffer = (@buffer.byteslice(length..) || +"".b).b
+    return nil if data.empty? && @reader.eof?
+
+    outbuf ? outbuf.replace(data) : data
+  end
+
+  def rewind
+    @reader = @entry.extractor_from(@io)
+    @buffer = +"".b
+    0
+  end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..6c55666
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,56 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+    @by_name = @entries.index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries.map(&:filename).select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(path)
+    @by_name.key?(path)
+  end
+
+  def read(path)
+    reader = extractor_for(path)
+    data = +"".b
+
+    until reader.eof?
+      chunk = reader.extract(1.megabyte)
+      break if chunk.nil?
+      data << chunk
+    end
+
+    data
+  end
+
+  def each_line(path)
+    reader = extractor_for(path)
+    buffer = +"".b
+
+    until reader.eof?
+      chunk = reader.extract(1.megabyte)
+      break if chunk.nil?
+
+      buffer << chunk
+      while (newline = buffer.index("\n"))
+        line = buffer.slice!(0..newline)
+        yield line
+      end
+    end
+
+    yield buffer if buffer.present?
+  end
+
+  def extract_io(path)
+    entry = @by_name.fetch(path)
+    ZipFile::ExtractIO.new(@io, entry)
+  end
+
+  private
+    def extractor_for(path)
+      @by_name.fetch(path).extractor_from(@io)
+    end
+end
