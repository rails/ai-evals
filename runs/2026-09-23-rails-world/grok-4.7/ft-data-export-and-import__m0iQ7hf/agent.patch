diff --git a/app/models/account/data_transfer.rb b/app/models/account/data_transfer.rb
new file mode 100644
index 0000000..e03c075
--- /dev/null
+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,27 @@
+module Account::DataTransfer
+  VERSION = 1
+  ACCOUNT_FORMAT = "fizzy-account"
+  CARDS_FORMAT = "fizzy-cards"
+  FILE_PREFIX = "files"
+
+  class Error < StandardError; end
+  class InvalidArchive < Error; end
+
+  def self.export(account, zip)
+    Manifest.new(account).each_record_set do |record_set|
+      record_set.export(zip)
+    end
+  end
+
+  def self.import(blob, identity:, importer:)
+    ZipFile.open_blob(blob) do |zip|
+      Importer.new(zip, identity: identity, importer: importer).perform
+    end
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::InvalidStructure
+    raise InvalidArchive, "The file isn't a valid zip archive."
+  end
+
+  def self.file_path(key)
+    "#{FILE_PREFIX}/#{key}"
+  end
+end
diff --git a/app/models/account/data_transfer/account_record_set.rb b/app/models/account/data_transfer/account_record_set.rb
index 7e4fee3..051674f 100644
--- a/app/models/account/data_transfer/account_record_set.rb
+++ b/app/models/account/data_transfer/account_record_set.rb
@@ -3,9 +3,39 @@ class Account::DataTransfer::AccountRecordSet < Account::DataTransfer::RecordSet
     super(account: account, model: Account)
   end
 
+  def import(zip, context)
+    attrs = exported_account(zip)
+    raise Account::DataTransfer::InvalidArchive, "This file isn't a Fizzy account export." unless attrs
+
+    new_id = context.allocate(attrs["id"])
+    now = Time.current
+
+    Account.insert_all!([ {
+      id: new_id,
+      name: attrs["name"].presence || "Imported account",
+      cards_count: attrs["cards_count"].to_i,
+      external_account_id: Account::ExternalIdSequence.next,
+      created_at: attrs["created_at"] || now,
+      updated_at: attrs["updated_at"] || now
+    } ], record_timestamps: false)
+
+    context.account = Account.find(new_id)
+  end
+
   private
     def records
       [ account ]
     end
 
+    def exported_account(zip)
+      return unless zip.exists?(records_path)
+
+      zip.each_line(records_path) do |line|
+        next if line.strip.empty?
+
+        return JSON.parse(line)
+      end
+
+      nil
+    end
 end
