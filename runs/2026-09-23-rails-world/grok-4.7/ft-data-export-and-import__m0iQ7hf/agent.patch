diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..477c3dd
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @owner = users(:jason)
+    @member = users(:david)
+    sign_in_as @owner
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "admin exports the account and receives a one-day download link" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("png-bytes"), filename: "logo.png", content_type: "image/png")
+
+    assert_enqueued_with(job: ExportJob) do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @owner.identity.email_address ], mail.to
+    body = [ mail.text_part&.body, mail.html_part&.body, mail.body ].compact.map(&:to_s).join("\n")
+    assert_match "1 day", body
+
+    link = body[/https?:\/\/[^\s"<]+\/exports\/[^\s"<]+/]
+    assert link, "expected a download link in #{body}"
+
+    signed_id = Rack::Utils.unescape(link.split("/exports/").last)
+    untenanted do
+      get export_path(signed_id)
+      assert_response :redirect
+      assert_match "rails/active_storage", response.location
+
+      travel 2.days do
+        get export_path(signed_id)
+        assert_response :not_found
+      end
+    end
+  end
+
+  test "members cannot export the account" do
+    logout_and_sign_in_as @member
+    clear_enqueued_jobs
+
+    post account_exports_path
+    assert_response :forbidden
+  end
+
+  test "a user can export the cards they can see" do
+    logout_and_sign_in_as @member
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+
+    assert_enqueued_with(job: ExportJob) do
+      post user_export_path(@member)
+    end
+
+    assert_redirected_to user_path(@member)
+
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @member.identity.email_address ], mail.to
+    body = [ mail.text_part&.body, mail.html_part&.body, mail.body ].compact.map(&:to_s).join("\n")
+    assert_match "1 day", body
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..b65ef50
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+    sign_in_as @user
+  end
+
+  test "signed in user can start an import" do
+    get new_account_import_path
+    assert_response :success
+
+    file = Tempfile.new([ "account", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    writer.add_file("manifest.json", JSON.generate(format: "fizzy-account", version: 1))
+    writer.close
+    file.rewind
+
+    assert_enqueued_with(job: ImportJob) do
+      post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(file.path, "application/zip") } }
+    end
+
+    assert_redirected_to new_account_import_path
+    assert_equal "We'll email you when your import is done.", flash[:notice]
+  end
+
+  test "a failed import emails why and leaves no account" do
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+    before = Account.count
+
+    file = Tempfile.new([ "bad", ".zip" ])
+    file.binmode
+    file.write("not a zip")
+    file.rewind
+
+    post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(file.path, "application/zip") } }
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    assert_equal before, Account.count
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:jason).email_address ], mail.to
+    body = [ mail.text_part&.body, mail.html_part&.body, mail.body ].compact.map(&:to_s).join("\n")
+    assert_match(/isn.t a valid zip|couldn.t be completed/i, body)
+  end
+end
diff --git a/test/models/account/data_transfer_test.rb b/test/models/account/data_transfer_test.rb
new file mode 100644
index 0000000..fa2b48a
--- /dev/null
+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:jason)
+    Current.account = @account
+  end
+
+  test "account export and import copies boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("image-bytes"), filename: "logo.png", content_type: "image/png")
+    card.update!(description: "A logo <strong>note</strong>")
+    comment = card.comments.create!(creator: users(:jz), body: "Looks good")
+
+    blob = nil
+    Dir.mktmpdir do |dir|
+      path = File.join(dir, "export.zip")
+      File.open(path, "wb") do |file|
+        writer = ZipFile::Writer.new(file)
+        Account::DataTransfer.export(@account, writer)
+        Account::DataTransfer::CardArchive.new(account: @account).write(writer, include_files: false)
+        writer.add_file("manifest.json", JSON.generate(format: Account::DataTransfer::ACCOUNT_FORMAT, version: 1))
+        writer.close
+      end
+
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: File.open(path),
+        filename: "export.zip",
+        content_type: "application/zip"
+      )
+    end
+
+    before_ids = Account.pluck(:id)
+
+    imported = Account::DataTransfer.import(blob, identity: identities(:jason), importer: @user)
+
+    assert_not_includes before_ids, imported.id
+    assert_equal @account.name, imported.name
+    assert_equal @account.boards.count, imported.boards.count
+    assert_equal @account.cards.count, imported.cards.count
+    assert_equal @account.users.count, imported.users.count
+
+    imported_card = imported.cards.find_by!(title: card.title)
+    assert_equal card.comments.count, imported_card.comments.count
+    assert imported_card.image.attached?
+    assert_equal "image-bytes", imported_card.image.download
+    assert_includes imported_card.description.to_plain_text, "logo"
+    assert imported_card.comments.any? { |imported_comment| imported_comment.body.to_plain_text == comment.body.to_plain_text }
+
+    imported_user = imported.users.find_by!(name: "Jason")
+    assert_equal identities(:jason), imported_user.identity
+  end
+
+  test "a failed import leaves no account behind" do
+    before = Account.count
+
+    assert_raises Account::DataTransfer::InvalidArchive do
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("not a zip"),
+        filename: "bad.zip",
+        content_type: "application/zip"
+      )
+      Account::DataTransfer.import(blob, identity: identities(:jason), importer: @user)
+    end
+
+    assert_equal before, Account.count
+  end
+
+  test "an import that fails after creating an account leaves nothing behind" do
+    blob = export_blob
+    before = Account.pluck(:id)
+
+    Account::DataTransfer::Importer.any_instance.stubs(:ensure_importer_access).raises(StandardError, "disk full")
+
+    error = assert_raises StandardError do
+      Account::DataTransfer.import(blob, identity: identities(:jason), importer: @user)
+    end
+
+    assert_equal "disk full", error.message
+    assert_equal before.sort, Account.pluck(:id).sort
+  end
+
+  private
+    def export_blob
+      Dir.mktmpdir do |dir|
+        path = File.join(dir, "export.zip")
+        File.open(path, "wb") do |file|
+          writer = ZipFile::Writer.new(file)
+          Account::DataTransfer.export(@account, writer)
+          writer.add_file("manifest.json", JSON.generate(format: Account::DataTransfer::ACCOUNT_FORMAT, version: 1))
+          writer.close
+        end
+
+        ActiveStorage::Blob.create_and_upload!(
+          io: File.open(path),
+          filename: "export.zip",
+          content_type: "application/zip"
+        )
+      end
+    end
+test "card archive includes comments and attached files" do
+  card = cards(:logo)
+  card.image.attach(io: StringIO.new("img"), filename: "logo.png", content_type: "image/png")
+  card.comments.create!(creator: users(:jz), body: "Ship it")
+
+  Dir.mktmpdir do |dir|
+    path = File.join(dir, "cards.zip")
+    File.open(path, "wb") do |file|
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::CardArchive.new(user: users(:david)).write(writer)
+      writer.close
+    end
+
+    File.open(path, "rb") do |file|
+      reader = ZipFile::Reader.new(file)
+      payload = JSON.parse(reader.read("cards/#{card.number}.json"))
+      assert_includes payload["comments"].map { |comment| comment.dig("body", "plain_text") }, "Ship it"
+      assert payload["image"]["path"].start_with?("files/")
+      assert reader.exists?(payload["image"]["path"])
+    end
+  end
+end
+end
