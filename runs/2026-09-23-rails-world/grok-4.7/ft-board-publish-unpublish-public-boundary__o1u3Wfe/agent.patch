diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..daed10e
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,33 @@
+<div class="margin-block-end">
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <p>Anyone with this secret link can view the board, its columns, and its published cards.</p>
+
+    <% url = board_public_url(board) %>
+    <div class="flex align-center gap-half">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" readonly aria-label="Public board link">
+      <%= button_to_copy_to_clipboard(url) do %>
+        <%= icon_tag "copy-paste" %>
+        <span>Copy link</span>
+      <% end %>
+    </div>
+
+    <% if Current.user.can_administer_board?(board) %>
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-small margin-block-start",
+            data: { turbo_confirm: "Unpublish this board? The current link will stop working." } do %>
+        <span>Unpublish</span>
+      <% end %>
+    <% end %>
+  <% else %>
+    <p>Publish this board to share a secret link. Draft cards stay private.</p>
+
+    <% if Current.user.can_administer_board?(board) %>
+      <%= button_to board_publication_path(board), class: "btn" do %>
+        <span>Publish board</span>
+      <% end %>
+    <% else %>
+      <p class="txt-small">Only admins can publish this board.</p>
+    <% end %>
+  <% end %>
+</div>
