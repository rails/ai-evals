diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..b3bcea3
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,55 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, public_board_path(@publication.key), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card-perma" style="--card-color: <%= @card.color %>">
+  <header>
+    <% if @card.column %>
+      <p><%= link_to @card.column.name, public_board_column_path(@publication.key, @card.column) %></p>
+    <% end %>
+
+    <% if @card.tags.any? %>
+      <ul>
+        <% @card.tags.each do |tag| %>
+          <li><%= tag.title %></li>
+        <% end %>
+      </ul>
+    <% end %>
+  </header>
+
+  <% if @card.description.present? %>
+    <div class="card__description lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ol class="steps">
+      <% @card.steps.each do |step| %>
+        <li class="step"><%= step.content %></li>
+      <% end %>
+    </ol>
+  <% end %>
+
+  <p>Added by <%= @card.creator.name %></p>
+</article>
+
+<% if @comments.any? %>
+  <section>
+    <h2>Comments</h2>
+    <% @comments.each do |comment| %>
+      <article id="<%= dom_id(comment) %>" class="comment">
+        <h3><%= comment.creator.name %></h3>
+        <div class="comment__body lexxy-content"><%= comment.body %></div>
+      </article>
+    <% end %>
+  </section>
+<% end %>
