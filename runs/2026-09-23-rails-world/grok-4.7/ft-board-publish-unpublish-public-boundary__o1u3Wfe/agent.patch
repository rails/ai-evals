 Returns `204 No Content` on success.
 
+
+`public_url` is `null` until an admin publishes the board. After publication it is the secret URL anyone can open.
+
+## `POST /:account_slug/boards/:board_id/publication`
+
+Publishes a board. Only admins can publish a board. Publishing again keeps the same secret URL.
+
+__Response:__
+
+Returns `201 Created` with the board JSON, including `public_url`.
+
+## `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes a board and retires its secret URL. Only admins can unpublish a board.
+
+__Response:__
+
+Returns `204 No Content`.
+
+## Public boards
+
+Anyone with the secret URL can view a published board without signing in:
+
+- `GET /:account_slug/public/boards/:key`
+- `GET /:account_slug/public/boards/:key/columns/:column_id`
+- `GET /:account_slug/public/boards/:key/cards/:number`
+
+Only published cards are visible. Draft cards are omitted.
+
 ## Board Accesses
 
 Board accesses let you see who has access to a board and their involvement level (watching or access only). Any board member can view this information.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..400d0a6
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin publishes a board and exposes a secret public url" do
+    assert_nil board_json["public_url"]
+
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    @board.reload
+
+    assert @board.published?
+    assert_equal public_board_url(@board.publication.key), response.parsed_body["public_url"]
+    assert_equal response.parsed_body["public_url"], response.headers["Location"]
+    assert_match %r{/public/boards/}, response.parsed_body["public_url"]
+  end
+
+  test "publishing again keeps the same secret url" do
+    post board_publication_path(@board)
+    key = @board.reload.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert_equal key, @board.reload.publication.key
+    assert_equal public_board_url(key), response.parsed_body["public_url"]
+  end
+
+  test "admin unpublishes a board" do
+    post board_publication_path(@board)
+    key = @board.reload.publication.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+
+  test "html publish and unpublish redirect back to board settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_select "input[value=?]", public_board_url(@board.reload.publication.key)
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "board creator can publish" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "members cannot publish or unpublish" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    Current.account = accounts("37s")
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "index json includes public_url nil by default" do
+    get boards_path, as: :json
+    assert_response :success
+    assert response.parsed_body.all? { |board| board.key?("public_url") && board["public_url"].nil? }
+  end
+
+  private
+    def board_json
+      get board_path(@board), as: :json
+      assert_response :success
+      response.parsed_body
+    end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..0e7dba1
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+    @key = @publication.key
+  end
+
+  test "anyone can view a published board without signing in" do
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a", text: cards(:logo).title
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo))
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage))
+  end
+
+  test "published board json omits drafts" do
+    drafted = @board.cards.create!(creator: users(:david), status: "drafted", title: "Secret draft")
+
+    get public_board_path(@key), as: :json
+
+    assert_response :success
+    titles = response.parsed_body["cards"].map { |card| card["title"] }
+    assert_includes titles, cards(:logo).title
+    assert_not_includes titles, drafted.title
+    assert_equal public_board_url(@key), response.parsed_body["public_url"]
+  end
+
+  test "unpublished and unknown keys are not found" do
+    @board.unpublish
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_path("missing-key")
+    assert_response :not_found
+  end
+
+  test "column and published card can be opened directly" do
+    column = columns(:writebook_triage)
+    card = cards(:logo)
+
+    get public_board_column_path(@key, column)
+    assert_response :success
+    assert_select "h1", text: column.name
+    assert_select "a", text: card.title
+
+    get public_board_column_path(@key, column), as: :json
+    assert_response :success
+    assert_equal column.name, response.parsed_body["name"]
+
+    get public_board_card_path(@key, card)
+    assert_response :success
+    assert_select "h1", text: card.title
+
+    get public_board_card_path(@key, card), as: :json
+    assert_response :success
+    assert_equal card.number, response.parsed_body["number"]
+    assert_equal public_board_card_url(@key, card), response.parsed_body["url"]
+  end
+
+  test "draft cards and unknown card numbers are not opened" do
+    draft = @board.cards.create!(creator: users(:david), status: "drafted", title: "Secret draft")
+
+    get public_board_card_path(@key, draft.number)
+    assert_response :not_found
+
+    get public_board_card_path(@key, 999_999)
+    assert_response :not_found
+  end
+
+  test "columns from another board are not opened" do
+    other_column = boards(:miltons_wish_list).columns.create!(name: "Elsewhere", color: "var(--color-card-1)")
+
+    get public_board_column_path(@key, other_column)
+    assert_response :not_found
+  end
+
+  test "republishing retires the previous secret url" do
+    old_key = @key
+    @board.unpublish
+    new_key = @board.publish.key
+
+    get public_board_path(old_key)
+    assert_response :not_found
+
+    get public_board_path(new_key)
+    assert_response :success
+  end
+
+  test "secret urls do not cross accounts or cancelled accounts" do
+    other = boards(:miltons_wish_list)
+    other_key = other.publish.key
+
+    get public_board_path(other_key)
+    assert_response :not_found
+
+    accounts("37s").cancel(initiated_by: users(:kevin))
+    get public_board_path(@key)
+    assert_response :not_found
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..282aeb3
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publish creates one secret publication and unpublish removes it" do
+    publication = @board.publish
+
+    assert @board.published?
+    assert publication.key.present?
+    assert_equal publication, @board.publish
+
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_not Board::Publication.exists?(publication.id)
+  end
+
+  test "cards are publicly accessible only while their board is published" do
+    assert_not cards(:logo).publicly_accessible?
+
+    @board.publish
+    assert cards(:logo).reload.publicly_accessible?
+
+    @board.unpublish
+    assert_not cards(:logo).reload.publicly_accessible?
+  end
+end
