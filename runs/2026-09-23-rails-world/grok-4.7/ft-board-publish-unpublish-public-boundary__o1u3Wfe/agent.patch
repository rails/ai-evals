@@ -0,0 +1,19 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+
+    before_action :set_public_board
+
+    layout "public"
+  end
+
+  private
+    def set_public_board
+      @publication = Board::Publication.find_by!(key: params[:key] || params[:board_key], account: Current.account)
+      @board = @publication.board
+
+      raise ActiveRecord::RecordNotFound unless Current.account.active?
+    end
+end
