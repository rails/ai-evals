diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..6168296 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,11 +24,55 @@ module Card::Entropic
   end
 
   class_methods do
+    # Hourly sweep. A per-row datetime() comparison cannot use
+    # index_cards_on_account_id_and_last_active_at_and_status, so on SQLite
+    # find_each re-scans every card for each batch and stops fitting in the hour.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      Account.find_each do |account|
+        auto_postpone_due_cards_for(account, now)
       end
     end
+
+    private
+      def auto_postpone_due_cards_for(account, now)
+        user = nil
+        fallback_period = account.entropy&.auto_postpone_period
+
+        boards_grouped_by_postpone_period(account, fallback_period).each do |period, board_ids|
+          each_due_card(account, board_ids, period, now) do |card|
+            user ||= account.system_user
+            card.auto_postpone(user: user)
+          end
+        end
+      end
+
+      def boards_grouped_by_postpone_period(account, fallback_period)
+        account.boards.left_outer_joins(:entropy).pluck("boards.id", "entropies.auto_postpone_period").each_with_object({}) do |(board_id, period), grouped|
+          effective_period = period || fallback_period
+          next if effective_period.nil?
+
+          (grouped[effective_period] ||= []) << board_id
+        end
+      end
+
+      def each_due_card(account, board_ids, period, now)
+        threshold = now - period.to_i
+
+        board_ids.each_slice(500) do |board_id_slice|
+          due_ids = due_cards_on_boards(account, board_id_slice, threshold).ids
+          due_ids.each_slice(1000) do |card_ids|
+            Card.where(id: card_ids).preload(:account, :board, :column, :not_now, :closure, :activity_spike).each do |card|
+              yield card
+            end
+          end
+        end
+      end
+
+      def due_cards_on_boards(account, board_ids, threshold)
+        active.where(account_id: account.id, board_id: board_ids).where(last_active_at: ..threshold)
+      end
   end
 
   def entropy
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..115b3e3 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,62 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due skips closed, drafted, and already postponed cards" do
+    period = entropies(:writebook_board).auto_postpone_period
+    due_at = period.seconds.ago - 1.day
+
+    closed = cards(:logo)
+    closed.update!(last_active_at: due_at)
+    closed.close(user: users(:david))
+
+    drafted = cards(:text)
+    drafted.update!(status: "drafted", last_active_at: due_at)
+
+    postponed = cards(:shipping)
+    postponed.update!(last_active_at: due_at)
+    postponed.postpone(user: users(:david))
+
+    due = cards(:layout)
+    due.update!(last_active_at: due_at)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert due.reload.postponed?
+    assert closed.reload.closed?
+    assert_not closed.postponed?
+    assert drafted.reload.drafted?
+    assert_not drafted.postponed?
+    assert postponed.reload.postponed?
+  end
+
+  test "auto postpone all due includes a card inactive for exactly the period" do
+    freeze_time
+
+    period = entropies(:writebook_board).auto_postpone_period
+    cards(:logo).update!(last_active_at: period.seconds.ago)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+  end
+
+  test "auto postpone all due uses each board period within one account" do
+    entropies(:writebook_board).update!(auto_postpone_period: 7.days)
+    entropies(:private_board).update!(auto_postpone_period: 90.days)
+
+    short_period_card = cards(:logo)
+    long_period_card = cards(:layout)
+    long_period_card.update!(board: boards(:private))
+
+    short_period_card.update!(last_active_at: 8.days.ago)
+    long_period_card.update!(last_active_at: 8.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert short_period_card.reload.postponed?
+    assert_not long_period_card.reload.postponed?
+  end
 end
