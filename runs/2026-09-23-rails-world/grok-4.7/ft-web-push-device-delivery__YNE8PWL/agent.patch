new file mode 100644
index 0000000..be02efd
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @user = users(:kevin)
+    @subscription = {
+      endpoint: "https://updates.push.services.mozilla.com/wpush/v2/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    }
+  end
+
+  test "create stores the posted subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.sole
+    assert_equal @subscription[:endpoint], subscription.endpoint
+    assert_equal @subscription[:p256dh_key], subscription.p256dh_key
+    assert_equal @subscription[:auth_key], subscription.auth_key
+    assert_equal subscription.id, @response.parsed_body["id"]
+  end
+
+  test "create accepts form parameters from the browser" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }
+
+    assert_redirected_to notifications_settings_path
+    assert_equal @subscription[:endpoint], @user.push_subscriptions.sole.endpoint
+  end
+
+  test "create cannot register another user's device" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the subscription" do
+    subscription = PushSubscription.subscribe(user: @user, **@subscription)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
