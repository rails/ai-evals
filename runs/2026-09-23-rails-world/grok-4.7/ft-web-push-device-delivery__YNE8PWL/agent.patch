@@ -0,0 +1,42 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = PushSubscription.subscribe(user: @user, **push_subscription_params.to_h.symbolize_keys)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on" }
+      format.json { render :show, status: @push_subscription.previously_new_record? ? :created : :ok }
+    end
+  rescue ActiveRecord::RecordInvalid => error
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, alert: error.record.errors.full_messages.to_sentence }
+      format.json { render json: error.record.errors, status: :unprocessable_entity }
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned off" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..8f056d5
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,131 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "toggle", "unsupported" ]
+  static values = { url: String, publicKey: String, subscriptionId: String }
+
+  connect() {
+    this.#refresh()
+  }
+
+  toggle() {
+    if (this.element.classList.contains("notifications--on")) {
+      this.#turnOff()
+    } else {
+      this.#turnOn()
+    }
+  }
+
+  async #refresh() {
+    if (!this.#supported) {
+      this.#showUnsupported()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#setBlocked(true)
+      this.#setOn(false)
+      return
+    }
+
+    this.#setBlocked(false)
+
+    const subscription = await this.#existingSubscription()
+    if (subscription && Notification.permission === "granted") {
+      this.#setOn(await this.#save(subscription))
+    } else {
+      this.#setOn(false)
+    }
+  }
+
+  async #turnOn() {
+    if (!this.#supported || !this.publicKeyValue) return
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.#setBlocked(permission === "denied")
+      this.#setOn(false)
+      return
+    }
+
+    this.#setBlocked(false)
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey()
+    })
+
+    this.#setOn(await this.#save(subscription))
+  }
+
+  async #turnOff() {
+    const subscription = await this.#existingSubscription()
+
+    if (this.subscriptionIdValue) {
+      await destroy(`${this.urlValue}/${this.subscriptionIdValue}`, { responseKind: "json" })
+    }
+
+    if (subscription) await subscription.unsubscribe()
+
+    this.subscriptionIdValue = ""
+    this.#setOn(false)
+    this.#setBlocked(false)
+  }
+
+  async #save(subscription) {
+    const keys = subscription.toJSON().keys || {}
+    const response = await post(this.urlValue, {
+      responseKind: "json",
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      }
+    })
+
+    if (!response.ok) return false
+
+    const data = await response.json
+    this.subscriptionIdValue = data.id
+    return true
+  }
+
+  async #existingSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  #setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+  }
+
+  #setBlocked(blocked) {
+    this.element.classList.toggle("notifications--blocked", blocked)
+  }
+
+  #showUnsupported() {
+    if (this.hasUnsupportedTarget) this.unsupportedTarget.hidden = false
+    if (this.hasToggleTarget) this.toggleTarget.hidden = true
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window && this.publicKeyValue
+  }
+
+  #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = window.atob(base64)
+    const output = new Uint8Array(raw.length)
+
+    for (let i = 0; i < raw.length; i++) {
+      output[i] = raw.charCodeAt(i)
+    }
+
+    return output
+  }
+}
diff --git a/app/jobs/push_subscription/delivery_job.rb b/app/jobs/push_subscription/delivery_job.rb
