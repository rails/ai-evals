--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = PushSubscription.subscribe(
+      user: @user,
+      endpoint: "https://fcm.googleapis.com/fcm/send/tray",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+  end
+
+  test "a notification landing in the tray is pushed to each subscription" do
+    switch_env "VAPID_PUBLIC_KEY", "public" do
+      switch_env "VAPID_PRIVATE_KEY", "private" do
+        assert_enqueued_with(job: PushSubscription::DeliveryJob, args: [ @subscription, notifications(:logo_assignment_kevin) ]) do
+          notifications(:logo_assignment_kevin).send(:deliver_pushes_later)
+        end
+      end
+    end
+  end
+
+  test "creating a notification enqueues a push" do
+    switch_env "VAPID_PUBLIC_KEY", "public" do
+      switch_env "VAPID_PRIVATE_KEY", "private" do
+        notifications(:layout_commented_kevin).destroy
+
+        assert_enqueued_jobs 1, only: PushSubscription::DeliveryJob do
+          Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+        end
+      end
+    end
+  end
+
+  test "push is skipped when vapid keys are not configured" do
+    switch_env "VAPID_PUBLIC_KEY", nil do
+      switch_env "VAPID_PRIVATE_KEY", nil do
+        assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+          notifications(:logo_assignment_kevin).send(:deliver_pushes_later)
+        end
+      end
+    end
+  end
+
+  private
+    def switch_env(key, value)
+      old, ENV[key] = ENV[key], value
+      yield
+    ensure
+      ENV[key] = old
+    end
+end
