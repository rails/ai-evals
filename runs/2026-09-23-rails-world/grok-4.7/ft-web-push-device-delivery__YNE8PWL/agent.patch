--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,83 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :deliver_pushes_on_create
+    after_update_commit :deliver_pushes_on_update, if: :source_id_previously_changed?
+  end
+
+  def push_message
+    Message.new(self).to_h
+  end
+
+  private
+    def deliver_pushes_on_create
+      deliver_pushes_later
+    end
+
+    def deliver_pushes_on_update
+      deliver_pushes_later
+    end
+
+    def deliver_pushes_later
+      return if read? || !user.active?
+
+      user.push_subscriptions.each do |subscription|
+        subscription.deliver_later(self)
+      end
+    end
+
+    class Message
+      include NotificationsHelper
+      include Rails.application.routes.url_helpers
+
+      attr_reader :notification
+
+      def initialize(notification)
+        @notification = notification
+      end
+
+      def to_h
+        {
+          title: title,
+          body: body,
+          path: path,
+          url: url,
+          tag: notification.id
+        }
+      end
+
+      def url_options
+        (Rails.application.routes.default_url_options.presence ||
+          Rails.application.config.action_mailer.default_url_options ||
+          {}).merge(script_name: notification.account.slug)
+      end
+
+      private
+        def title
+          case source
+          when Event then event_notification_title(source)
+          when Mention then "#{source.mentioner.first_name} @mentioned you"
+          end
+        end
+
+        def body
+          case source
+          when Event then event_notification_body(source)
+          when Mention then source.source.mentionable_content.to_s.truncate(200)
+          end
+        end
+
+        def path
+          polymorphic_path(notification.card, script_name: notification.account.slug)
+        end
+
+        def url
+          polymorphic_url(notification.card, url_options)
+        end
+
+        def source
+          notification.source
+        end
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..4fc58f9
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,113 @@
+class PushSubscription < ApplicationRecord
+  class Unreachable < StandardError; end
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint_digest, uniqueness: true
+  validate :endpoint_is_https
+
+  normalizes :endpoint, with: -> { it.to_s.strip }
+  normalizes :p256dh_key, with: -> { it.to_s.strip }
+  normalizes :auth_key, with: -> { it.to_s.strip }
+
+  before_validation :set_endpoint_digest
+
+  class << self
+    def subscribe(user:, endpoint:, p256dh_key:, auth_key:)
+      endpoint = endpoint.to_s.strip
+      attempts = 0
+
+      begin
+        attempts += 1
+        record = find_or_initialize_by(endpoint: endpoint)
+        record.user = user
+        record.account = user.account
+        record.p256dh_key = p256dh_key
+        record.auth_key = auth_key
+        record.save!
+        record
+      rescue ActiveRecord::RecordNotUnique
+        retry if attempts < 2
+        raise
+      end
+    end
+
+    def vapid_configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].to_s.strip.presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].to_s.strip.presence
+    end
+
+    def vapid_options
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    def vapid_subject
+      configured = ENV["VAPID_SUBJECT"].to_s.strip
+      if configured.present?
+        configured
+      else
+        from = ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <support@fizzy.do>")
+        email = from[/<([^>]+)>/, 1] || from[/\S+@\S+/] || "support@fizzy.do"
+        "mailto:#{email}"
+      end
+    end
+  end
+
+  def deliver_later(notification)
+    if self.class.vapid_configured?
+      DeliveryJob.perform_later(self, notification)
+    end
+  end
+
+  def deliver(notification)
+    return unless self.class.vapid_configured?
+
+    transmit(notification.push_message.to_json)
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def transmit(message)
+      Request.new(
+        endpoint: endpoint,
+        p256dh: padded_key(p256dh_key),
+        auth: padded_key(auth_key),
+        message: message,
+        vapid: self.class.vapid_options
+      ).perform
+    end
+
+    def padded_key(key)
+      stripped = key.to_s.delete("=")
+      stripped + ("=" * ((4 - stripped.length % 4) % 4))
+    end
+
+    def set_endpoint_digest
+      if endpoint.present?
+        self.endpoint_digest = Digest::SHA256.hexdigest(endpoint)
+      end
+    end
+
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present?
+        errors.add(:endpoint, "must be an https URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be an https URL")
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..ff3bdcc
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,44 @@
+class PushSubscription::Request < WebPush::Request
+  def initialize(endpoint:, p256dh:, auth:, message:, vapid:)
+    super(
+      message: message,
+      subscription: {
+        endpoint: endpoint,
+        keys: { p256dh: p256dh, auth: auth }
+      },
+      vapid: vapid,
+      open_timeout: 5,
+      read_timeout: 5,
+      ssl_timeout: 5
+    )
+  end
+
+  def perform
+    raise PushSubscription::Unreachable, "endpoint is not a public https URL" unless deliverable?
+
+    http = Net::HTTP.new(uri.host, uri.port)
+    http.ipaddr = resolved_ip
+    http.use_ssl = true
+    http.open_timeout = 5
+    http.read_timeout = 5
+    http.ssl_timeout = 5 if http.respond_to?(:ssl_timeout=)
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+
+    response = http.request(request)
+    verify_response(response)
+    response
+  end
+
+  private
+    def deliverable?
+      uri.is_a?(URI::HTTPS) && uri.host.present? && resolved_ip.present?
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+
+      @resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+    end
+end
