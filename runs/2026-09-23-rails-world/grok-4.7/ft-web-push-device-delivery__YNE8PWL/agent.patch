+require "test_helper"
+
+class PushSubscription::RequestTest < ActiveSupport::TestCase
+  PUBLIC_TEST_IP = "93.184.216.34"
+
+  setup do
+    @vapid = WebPush.generate_key
+  end
+
+  test "pins delivery to the resolved public address" do
+    stub_dns_resolution(PUBLIC_TEST_IP)
+    stub_request(:post, "https://example.com/push").with(ipaddr: PUBLIC_TEST_IP).to_return(status: 201)
+
+    request.perform
+
+    assert_requested :post, "https://example.com/push"
+  end
+
+  test "refuses endpoints that resolve to a private address" do
+    stub_dns_resolution("127.0.0.1")
+    stub_request(:post, "https://example.com/push")
+
+    assert_raises PushSubscription::Unreachable do
+      request.perform
+    end
+
+    assert_not_requested :post, "https://example.com/push"
+  end
+
+  private
+    def request
+      PushSubscription::Request.new(
+        endpoint: "https://example.com/push",
+        p256dh: "unused",
+        auth: "unused",
+        message: "",
+        vapid: {
+          subject: "mailto:support@fizzy.do",
+          public_key: @vapid.public_key,
+          private_key: @vapid.private_key
+        }
+      )
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..1312aa3
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @endpoint = "https://fcm.googleapis.com/fcm/send/kevin-device"
+    @attributes = {
+      user: @user,
+      endpoint: @endpoint,
+      p256dh_key: "BNcRD7examplekey",
+      auth_key: "authsecret"
+    }
+  end
+
+  test "subscribe stores the browser subscription for the user" do
+    subscription = PushSubscription.subscribe(**@attributes)
+
+    assert_equal @user, subscription.user
+    assert_equal @user.account, subscription.account
+    assert_equal @endpoint, subscription.endpoint
+    assert_equal "BNcRD7examplekey", subscription.p256dh_key
+    assert_equal "authsecret", subscription.auth_key
+  end
+
+  test "subscribe updates keys and owner when the endpoint already exists" do
+    PushSubscription.subscribe(**@attributes)
+
+    subscription = PushSubscription.subscribe(**@attributes, user: users(:david), p256dh_key: "rotated", auth_key: "rotated-auth")
+
+    assert_equal 1, PushSubscription.where(endpoint: @endpoint).count
+    assert_equal users(:david), subscription.reload.user
+    assert_equal users(:david).account, subscription.account
+    assert_equal "rotated", subscription.p256dh_key
+    assert_equal "rotated-auth", subscription.auth_key
+  end
+
+  test "endpoint must be https" do
+    subscription = PushSubscription.new(**@attributes, endpoint: "http://fcm.googleapis.com/fcm/send/insecure")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be an https URL"
+  end
+
+  test "deliver sends the tray title and body and opens the card" do
+    with_vapid_keys do
+      subscription = PushSubscription.subscribe(**@attributes)
+      notification = notifications(:logo_assignment_kevin)
+      transmitted = []
+      subscription.define_singleton_method(:transmit) { |message| transmitted << JSON.parse(message) }
+
+      subscription.deliver(notification)
+
+      payload = transmitted.sole
+      assert_equal "The logo isn't big enough", payload["title"]
+      assert_equal "Assigned to Kevin", payload["body"]
+      assert_equal "/#{@user.account.external_account_id}/cards/1", payload["path"]
+      assert_includes payload["url"], "/cards/1"
+      assert_equal notification.id, payload["tag"]
+    end
+  end
+
+  test "deliver destroys subscriptions the push service has expired" do
+    with_vapid_keys do
+      subscription = PushSubscription.subscribe(**@attributes)
+      error = WebPush::ExpiredSubscription.new(stub(body: ""), "fcm.googleapis.com")
+      subscription.define_singleton_method(:transmit) { |*| raise error }
+
+      subscription.deliver(notifications(:logo_assignment_kevin))
+
+      assert_not PushSubscription.exists?(subscription.id)
+    end
+  end
+
+  private
+    def with_vapid_keys
+      switch_env("VAPID_PUBLIC_KEY", "public") do
+        switch_env("VAPID_PRIVATE_KEY", "private") do
+          yield
+        end
+      end
+    end
+
+    def switch_env(key, value)
+      old, ENV[key] = ENV[key], value
+      yield
+    ensure
+      ENV[key] = old
+    end
+end
