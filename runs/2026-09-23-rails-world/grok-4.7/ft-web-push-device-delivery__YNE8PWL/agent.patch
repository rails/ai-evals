+++ b/app/jobs/push_subscription/delivery_job.rb
@@ -0,0 +1,15 @@
+class PushSubscription::DeliveryJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+  discard_on PushSubscription::Unreachable
+
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError,
+    Net::OpenTimeout, Net::ReadTimeout, SocketError, OpenSSL::SSL::SSLError,
+    Resolv::ResolvError, Resolv::ResolvTimeout,
+    wait: :polynomially_longer, attempts: 8
+
+  def perform(push_subscription, notification)
+    push_subscription.deliver(notification)
+  end
+end
