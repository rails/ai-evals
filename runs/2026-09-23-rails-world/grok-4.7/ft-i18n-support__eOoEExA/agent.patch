diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..ee1f708
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,47 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function locale() {
+  return getMetaContent("locale") || document.documentElement.lang || "en"
+}
+
+export function japanese() {
+  return locale() === "ja"
+}
+
+const JA = {
+  "Less than a minute ago": "1分未満前",
+  "today": "今日",
+  "yesterday": "昨日",
+  "tomorrow": "明日",
+  "days ago": "日前",
+  "days": "日",
+  "day": "日",
+  "in": "あと",
+  "Today": "今日",
+  "Stalled for": "停滞",
+  "Please fill out this field": "この項目を入力してください",
+  "Back to %{label}": "%{label}に戻る",
+  "Are you sure?": "よろしいですか？",
+  "No selection": "未選択",
+  " or ": "または",
+  ", or ": "、または",
+  "minute": "分",
+  "minutes": "分",
+  "hour": "時間",
+  "hours": "時間",
+  "week": "週間",
+  "weeks": "週間",
+  "month": "ヶ月",
+  "months": "ヶ月",
+  "year": "年",
+  "years": "年",
+  "ago": "前"
+}
+
+export function t(text, vars = {}) {
+  let template = japanese() ? (JA[text] || text) : text
+  Object.entries(vars).forEach(([key, value]) => {
+    template = template.replaceAll(`%{${key}}`, value)
+  })
+  return template
+}
