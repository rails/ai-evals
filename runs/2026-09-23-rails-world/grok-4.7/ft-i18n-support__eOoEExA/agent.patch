diff --git a/test/integration/locale_email_test.rb b/test/integration/locale_email_test.rb
new file mode 100644
index 0000000..8085abe
--- /dev/null
+++ b/test/integration/locale_email_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class LocaleEmailTest < ActionDispatch::IntegrationTest
+  test "magic link email is Japanese after choosing Japanese" do
+    get new_session_url(script_name: nil), params: { locale: "ja" }
+
+    assert_enqueued_emails 1 do
+      post session_url(script_name: nil), params: { email_address: identities(:david).email_address }
+    end
+
+    assert_equal "ja", identities(:david).reload.locale
+
+    perform_enqueued_jobs
+    mail = ActionMailer::Base.deliveries.last
+    assert_includes mail.subject, "Fizzyのコードは"
+    assert_includes mail.html_part.body.decoded, "確認コード"
+  end
+
+  test "locale chosen while signed in is stored on the identity" do
+    sign_in_as :kevin
+    assert_nil identities(:kevin).locale
+
+    get root_url, params: { locale: "ja" }
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get root_url
+    assert_includes response.body, "ホーム"
+  end
+end
diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..601cf5e
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "japanese query param translates the sign-in page and sticks in the session" do
+    get new_session_url(script_name: nil), params: { locale: "ja" }
+
+    assert_response :success
+    assert_includes response.body, "Fizzyに入る"
+    assert_not_includes response.body, "Get into Fizzy"
+    assert_equal "ja", session[:locale]
+  end
+
+  test "unknown locale does not switch and does not break the page" do
+    get new_session_url(script_name: nil), params: { locale: "xx" }
+
+    assert_response :success
+    assert_includes response.body, "Get into Fizzy"
+    assert_nil session[:locale]
+  end
+
+  test "chosen locale is restored on the next sign-in" do
+    identity = identities(:david)
+    identity.update!(locale: "ja")
+
+    sign_in_as identity
+
+    get root_url
+    assert_includes response.body, "ホーム"
+  end
+
+  test "people who never chose a locale still see English" do
+    sign_in_as :kevin
+
+    get root_url
+    assert_includes response.body, "Home"
+    assert_not_includes response.body, "ホーム"
+  end
+end
