diff --git a/app/controllers/concerns/locale.rb b/app/controllers/concerns/locale.rb
new file mode 100644
index 0000000..4303cae
--- /dev/null
+++ b/app/controllers/concerns/locale.rb
@@ -0,0 +1,53 @@
+module Locale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :with_locale
+    helper_method :jt, :jt_html
+    etag { I18n.locale unless Fizzy::Translation.english? }
+  end
+
+  private
+    def with_locale(&block)
+      remember_requested_locale
+      I18n.with_locale(locale_for_request, &block)
+    end
+
+    def remember_requested_locale
+      requested = params[:locale].to_s
+      return if requested.blank?
+      return unless Fizzy::Translation.available?(requested)
+
+      session[:locale] = requested
+      persist_locale(requested)
+    end
+
+    def locale_for_request
+      chosen = session[:locale].presence
+      chosen = nil unless Fizzy::Translation.available?(chosen)
+
+      if chosen.blank? && Current.identity&.locale.present? && Fizzy::Translation.available?(Current.identity.locale)
+        chosen = Current.identity.locale
+        session[:locale] = chosen
+      end
+
+      Current.chosen_locale = chosen
+      Fizzy::Translation.cast(chosen)
+    end
+
+    def persist_locale(locale)
+      identity = Current.identity
+      return unless identity&.persisted?
+      return if identity.locale == locale
+
+      identity.update_column(:locale, locale)
+    end
+
+    def jt(text, **vars)
+      Fizzy::Translation.t(text, **vars)
+    end
+
+    def jt_html(text)
+      Fizzy::Translation.t_html(text)
+    end
+end
