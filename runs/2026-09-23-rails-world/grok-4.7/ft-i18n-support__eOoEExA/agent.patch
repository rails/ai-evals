diff --git a/lib/fizzy/translation.rb b/lib/fizzy/translation.rb
new file mode 100644
index 0000000..5fdf68b
--- /dev/null
+++ b/lib/fizzy/translation.rb
@@ -0,0 +1,99 @@
+module Fizzy
+  module Translation
+    LOCALES = %w[en ja].freeze
+    def self.dictionary_path
+        Rails.root.join("config/translations/ja.yml")
+      end
+
+    class << self
+      def available?(locale)
+        LOCALES.include?(locale.to_s)
+      end
+
+      def cast(locale)
+        available?(locale) ? locale.to_s : I18n.default_locale.to_s
+      end
+
+      def english?
+        I18n.locale.to_s == I18n.default_locale.to_s
+      end
+
+      # Plain-string translation for Ruby (flash, helpers, mail subjects).
+      # English is returned unchanged so existing copy stays byte-for-byte.
+      def t(text, **vars)
+        return text if text.nil?
+
+        template = english? ? text.to_s : lookup(text.to_s)
+        interpolate(template, vars)
+      end
+
+      # HTML text-node translation. In English the original markup, including
+      # entities and whitespace, is returned untouched.
+      def t_html(original)
+        return original if original.nil?
+        return original.to_s.html_safe if english?
+
+        leading = original[/\A\s*/]
+        trailing = original[/\s*\z/]
+        core = original.strip
+        key = CGI.unescapeHTML(core)
+        translated = lookup(key)
+        (leading + ERB::Util.html_escape(translated) + trailing).html_safe
+      end
+
+      def lookup(text)
+        dictionary.fetch(text, text)
+      end
+
+      def dictionary
+        @dictionary ||= load_dictionary
+      end
+
+      def reload!
+        @dictionary = nil
+      end
+
+      def translate_system_comment(html)
+        translated = html.dup
+        system_comment_patterns.each do |pattern, template|
+          translated = translated.sub(pattern) do
+            vars = Regexp.last_match.named_captures.transform_keys(&:to_sym)
+            interpolate(template, vars)
+          end
+        end
+        translated
+      end
+
+      private
+        def load_dictionary
+          return {} unless dictionary_path.exist?
+
+          data = YAML.safe_load(dictionary_path.read, permitted_classes: [ Date, Time ], aliases: true) || {}
+          data.transform_keys(&:to_s)
+        end
+
+        def interpolate(template, vars)
+          return template if vars.empty?
+
+          vars.reduce(template.to_s) do |result, (key, value)|
+            result.gsub("%{#{key}}", value.to_s)
+          end
+        end
+
+        def system_comment_patterns
+          [
+            [ /(?<creator>.+?) <strong>assigned<\/strong> this to (?<names>.+?)\./, "%{creator}が%{names}にこれを<strong>割り当て</strong>ました。" ],
+            [ /(?<creator>.+?) <strong>unassigned<\/strong> from (?<names>.+?)\./, "%{creator}が%{names}の<strong>割り当てを解除</strong>しました。" ],
+            [ /<strong>Moved<\/strong> to “Done” by (?<name>.+)/, "<strong>完了</strong>に移動しました（%{name}）" ],
+            [ /<strong>Reopened<\/strong> by (?<name>.+)/, "%{name}が<strong>再開</strong>しました" ],
+            [ /(?<creator>.+?) <strong>moved<\/strong> this to “Not Now”/, "%{creator}がこれを「今はやらない」に<strong>移動</strong>しました" ],
+            [ /<strong>Moved<\/strong> to “Not Now” due to inactivity/, "操作がなかったため「今はやらない」に<strong>移動</strong>しました" ],
+            [ /(?<creator>.+?) <strong>changed the title<\/strong> from “(?<old>.+?)” to “(?<new>.+?)”\./, "%{creator}がタイトルを「%{old}」から「%{new}」に<strong>変更</strong>しました。" ],
+            [ /(?<creator>.+?) <strong>moved<\/strong> this from “(?<old>.+?)” to “(?<new>.+?)”\./, "%{creator}がこれを「%{old}」から「%{new}」に<strong>移動</strong>しました。" ],
+            [ /(?<creator>.+?) <strong>moved<\/strong> this to “(?<column>.+?)”/, "%{creator}がこれを「%{column}」に<strong>移動</strong>しました" ],
+            [ /(?<creator>.+?) <strong>moved<\/strong> this back to “Maybe\?”/, "%{creator}がこれを「検討中」に<strong>戻し</strong>ました" ]
+          ]
+        end
+    end
+  end
+end
