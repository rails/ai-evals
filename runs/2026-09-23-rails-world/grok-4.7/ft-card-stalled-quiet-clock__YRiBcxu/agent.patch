diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..a31ca0b
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @board.update!(auto_postpone_period: 30.days)
+    @card = @board.cards.create!(title: "Burst candidate", creator: users(:david), status: :published)
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    comment_at(10.days.ago, users(:david))
+    comment_at(5.days.ago, users(:kevin))
+
+    assert_changes -> { @card.reload.burst_at.present? }, from: false, to: true do
+      comment_at(Time.current, users(:david))
+    end
+  end
+
+  test "comments outside the burst window do not count" do
+    comment_at(10.days.ago - 1.second, users(:david))
+    comment_at(5.days.ago, users(:kevin))
+    comment_at(Time.current, users(:david))
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "three comments from one person are not a burst" do
+    3.times { |i| comment_at(i.hours.ago, users(:david)) }
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "two comments from two people are not a burst" do
+    comment_at(1.hour.ago, users(:david))
+    comment_at(Time.current, users(:kevin))
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    comment_at(2.hours.ago, users(:david))
+    comment_at(1.hour.ago, users(:david))
+    @card.comments.create!(creator: @card.account.system_user, body: "System note", created_at: Time.current)
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "assigning someone is a burst" do
+    assert_changes -> { @card.reload.burst_at.present? }, from: false, to: true do
+      @card.toggle_assignment(users(:kevin))
+    end
+  end
+
+  test "reopening a card is a burst" do
+    @card.close
+    assert_nil @card.reload.burst_at
+
+    @card.reopen
+
+    assert @card.reload.burst_at.present?
+  end
+
+  test "a burst followed by two weeks of silence is stalled" do
+    @card.toggle_assignment(users(:kevin))
+    assert_not @card.reload.stalled?
+
+    burst_at = @card.reload.last_active_at
+    travel_to burst_at + 2.weeks - 1.minute
+    assert_not @card.reload.stalled?
+
+    travel_to burst_at + 2.weeks + 1.second
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+    assert_includes users(:david).filters.new(indexed_by: "stalled").cards, @card
+  end
+
+  test "any activity resets a stall until there is a new burst" do
+    @card.toggle_assignment(users(:kevin))
+
+    travel_to @card.reload.last_active_at + 2.weeks + 1.second
+    assert @card.reload.stalled?
+
+    @card.comments.create!(creator: users(:david), body: "Still here")
+    assert_not @card.reload.stalled?
+    assert_nil @card.burst_at
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed and postponed cards are not listed as stalled" do
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    @card.close
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    other = @board.cards.create!(title: "Parked", creator: users(:david), status: :published)
+    other.update_columns(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    other.postpone
+
+    assert_not other.reload.stalled?
+    assert_not_includes Card.stalled, other
+  end
+
+  private
+    def comment_at(time, user)
+      travel_to(time) do
+        @card.comments.create!(creator: user, body: "From #{user.name}")
+      end
+    end
+end
