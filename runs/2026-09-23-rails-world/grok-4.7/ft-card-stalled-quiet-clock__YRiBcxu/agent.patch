diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..8790a59
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,73 @@
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  # How long a card must sit quiet after a burst before it is stalled.
+  STALL_AFTER = 2.weeks
+  BURST_COMMENT_THRESHOLD = 3
+  BURST_PEOPLE_THRESHOLD = 2
+
+  included do
+    # Open, published, not postponed. Joins are avoided so the cards index can
+    # apply its own open/not-now filters without duplicating LEFT JOINs.
+    scope :stalled, -> {
+      published
+        .where.not(burst_at: nil)
+        .where(last_active_at: ..STALL_AFTER.ago)
+        .where.not(id: Closure.select(:card_id))
+        .where.not(id: Card::NotNow.select(:card_id))
+    }
+  end
+
+  def stalled?
+    burst_at.present? && quiet_since_burst? && active?
+  end
+
+  # Comments from at least two people, landing inside a third of the board's
+  # auto-close period, are a burst. Called after the comment has been saved.
+  def detect_comment_burst(at:)
+    if comment_burst?(ending_at: at)
+      record_burst(at: at)
+    end
+  end
+
+  # Assignment and reopen are bursts on their own. Other activity clears the
+  # watch via #touch_last_active_at before this is called.
+  def record_burst_from(event)
+    if event.action.card_assigned? || event.action.card_reopened?
+      record_burst(at: event.created_at)
+    end
+  end
+
+  def record_burst(at: Time.current)
+    attributes = {}
+    attributes[:burst_at] = at if burst_at != at
+    attributes[:last_active_at] = at if last_active_at.nil? || last_active_at < at
+
+    update!(attributes) if attributes.any?
+  end
+
+  def burst_window
+    auto_postpone_period.to_f / 3
+  end
+
+  def cache_version
+    version = super
+
+    if version
+      "#{version}-stalled=#{stalled?}"
+    else
+      version
+    end
+  end
+
+  private
+    def quiet_since_burst?
+      last_active_at.present? && last_active_at <= STALL_AFTER.ago
+    end
+
+    def comment_burst?(ending_at:)
+      recent_comments = comments.by_user.where(created_at: (ending_at - burst_window)..ending_at)
+      recent_comments.count >= BURST_COMMENT_THRESHOLD &&
+        recent_comments.distinct.count(:creator_id) >= BURST_PEOPLE_THRESHOLD
+    end
+end
