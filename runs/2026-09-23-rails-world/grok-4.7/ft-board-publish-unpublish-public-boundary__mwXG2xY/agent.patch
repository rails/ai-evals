new file mode 100644
index 0000000..ad2f971
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = Current.set(account: accounts("37s")) { @board.publish }
+    @key = @publication.key
+  end
+
+  test "anyone can view a published board without signing in" do
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a", text: columns(:writebook_triage).name
+    assert_select "a", text: cards(:logo).title
+    assert_select "a", text: cards(:buy_domain).title
+    assert_select "a", text: cards(:shipping).title
+  end
+
+  test "published board json lists columns" do
+    get public_board_path(@key), as: :json
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal public_board_url(@key), @response.parsed_body["public_url"]
+    assert_includes @response.parsed_body["columns"].map { |column| column["id"] }, columns(:writebook_in_progress).id
+  end
+
+  test "column can be opened directly" do
+    column = columns(:writebook_in_progress)
+
+    get public_board_column_path(@key, column)
+
+    assert_response :success
+    assert_select "h1", text: column.name
+    assert_select "a", text: cards(:text).title
+    assert_no_match(/#{Regexp.escape(cards(:logo).title)}/, response.body)
+  end
+
+  test "column json lists active cards" do
+    column = columns(:writebook_in_progress)
+
+    get public_board_column_path(@key, column), as: :json
+
+    assert_response :success
+    assert_equal column.name, @response.parsed_body["name"]
+    assert_equal [ cards(:text).number ], @response.parsed_body["cards"].map { |card| card["number"] }
+    assert_equal public_board_card_url(@key, cards(:text)), @response.parsed_body["cards"].first["url"]
+  end
+
+  test "published card can be opened directly" do
+    get public_board_card_path(@key, cards(:logo))
+
+    assert_response :success
+    assert_select "h1", text: /logo/
+    assert_select "h2", text: cards(:logo).title
+  end
+
+  test "closed published cards can be opened directly" do
+    get public_board_card_path(@key, cards(:shipping))
+
+    assert_response :success
+    assert_select "h1", text: cards(:shipping).title
+  end
+
+  test "card json does not include email addresses" do
+    get public_board_card_path(@key, cards(:logo)), as: :json
+
+    assert_response :success
+    assert_equal cards(:logo).number, @response.parsed_body["number"]
+    assert_equal cards(:logo).title, @response.parsed_body["title"]
+    assert_not response.body.include?("email_address")
+  end
+
+  test "draft cards are not publicly visible" do
+    card = nil
+    Current.set(account: accounts("37s"), user: users(:david)) do
+      card = @board.cards.create!(creator: users(:david), title: "Secret draft", status: :drafted)
+    end
+
+    get public_board_card_path(@key, card.number)
+    assert_response :not_found
+    assert_no_match(/Secret draft/, public_board_body)
+  end
+
+  test "columns and cards from another board are not found" do
+    other = columns(:writebook_in_progress)
+    other_board = boards(:private)
+    other_publication = Current.set(account: accounts("37s")) { other_board.publish }
+    foreign_column = other_board.columns.create!(name: "Elsewhere")
+
+    get public_board_column_path(@key, foreign_column)
+    assert_response :not_found
+
+    get public_board_card_path(other_publication.key, cards(:logo))
+    assert_response :not_found
+
+    get public_board_column_path(@key, other)
+    assert_response :success
+  end
+
+  test "missing or unpublished keys are not found" do
+    get public_board_path("not-a-real-key")
+    assert_response :not_found
+
+    @board.unpublish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_column_path(@key, columns(:writebook_triage))
+    assert_response :not_found
+
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :not_found
+  end
+
+  test "public urls work without an account slug" do
+    get "/public/boards/#{@key}"
+
+    assert_response :success
+    assert_match @board.name, response.body
+  end
+
+  test "public board from another account is not found when the request is tenanted" do
+    other = Current.set(account: accounts(:initech)) { boards(:miltons_wish_list).publish }
+
+    get public_board_path(other.key)
+    assert_response :not_found
+  end
+
+  private
+    def public_board_body
+      get public_board_path(@key)
+      response.body
+    end
+end
