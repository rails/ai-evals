index 0000000..1d2e743
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "create publishes the board and exposes a public url" do
+    assert_nil board_json["public_url"]
+
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert @board.reload.published?
+
+    url = @response.parsed_body["public_url"]
+    assert_equal public_board_url(@board.publication.key), url
+    assert_match %r{/public/boards/#{@board.publication.key}\z}, url
+  end
+
+  test "create is idempotent" do
+    post board_publication_path(@board)
+    key = @board.reload.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert_equal key, @board.reload.publication.key
+    assert_equal public_board_url(key), @response.parsed_body["public_url"]
+  end
+
+  test "create redirects html requests back to board settings" do
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "destroy unpublishes the board" do
+    post board_publication_path(@board), as: :json
+    assert @board.reload.published?
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "destroy is idempotent" do
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "board creators can publish their board" do
+    logout_and_sign_in_as :david
+    assert_not users(:david).admin?
+    assert users(:david).can_administer_board?(@board)
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "members who cannot administer the board cannot publish or unpublish" do
+    logout_and_sign_in_as :jz
+    assert_not users(:jz).can_administer_board?(@board)
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    Current.set(account: accounts("37s")) { @board.publish }
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "show json includes public_url nil by default" do
+    get board_path(@board), as: :json
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+    assert @response.parsed_body.key?("public_url")
+  end
+
+  test "index json includes public_url" do
+    @board.publish
+
+    get boards_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body.find { |board| board["id"] == @board.id }
+    assert_equal public_board_url(@board.publication.key), json["public_url"]
+
+    unpublished = @response.parsed_body.find { |board| board["id"] == boards(:private).id }
+    assert_nil unpublished["public_url"]
+  end
+
+  private
+    def board_json
+      get board_path(@board), as: :json
+      assert_response :success
+      @response.parsed_body
+    end
+end
