diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..668a1fb
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,30 @@
+<div class="margin-block-end">
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <% url = public_url_for(board) %>
+    <p class="margin-none-block-start">Anyone with this secret link can view the board, its columns, and published cards.</p>
+    <div class="flex align-center gap-half margin-block">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" readonly>
+    </div>
+    <%= tag.button class: "btn btn--link", data: {
+          controller: "copy-to-clipboard", action: "copy-to-clipboard#copy",
+          copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: url } do %>
+      <%= icon_tag "copy-paste" %>
+      <span>Copy public link</span>
+    <% end %>
+
+    <% if Current.user.can_administer_board?(board) %>
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-small", form_class: "margin-block-start" do %>
+        <span>Unpublish</span>
+      <% end %>
+    <% end %>
+  <% elsif Current.user.can_administer_board?(board) %>
+    <p class="margin-none-block-start">Publish this board to share a secret link. Anyone with the link can view it without an account.</p>
+    <%= button_to board_publication_path(board), class: "btn", form_class: "margin-block-start" do %>
+      <span>Publish board</span>
+    <% end %>
+  <% else %>
+    <p class="margin-none">Only admins can publish this board.</p>
+  <% end %>
+</div>
