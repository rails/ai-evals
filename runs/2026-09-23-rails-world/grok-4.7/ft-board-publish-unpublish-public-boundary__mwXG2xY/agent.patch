diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..952b3ad
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,22 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+  end
+
+  def publish
+    publication || create_publication!(account: account)
+  rescue ActiveRecord::RecordNotUnique
+    reload_publication
+  end
+
+  def unpublish
+    publication&.destroy
+    reload_publication
+  end
+
+  def published?
+    publication.present?
+  end
+end
