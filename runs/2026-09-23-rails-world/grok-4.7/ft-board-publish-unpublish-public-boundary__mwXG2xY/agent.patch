diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..99df07a
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,44 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <% back_path = @card.column ? public_board_column_path(@publication.key, @card.column) : public_board_path(@publication.key) %>
+    <%= link_to back_path, class: "btn btn--back" do %>
+      <%= icon_tag "arrow-left" %>
+      <span>Back to <%= @card.column ? @card.column.name : @board.name %></span>
+    <% end %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card-perma" id="<%= dom_id(@card) %>">
+  <p class="txt-small">
+    <%= link_to @board.name, public_board_path(@publication.key) %>
+    <% if @card.column %>
+      · <%= link_to @card.column.name, public_board_column_path(@publication.key, @card.column) %>
+    <% end %>
+  </p>
+
+  <h2 class="card__title"><%= @card.title %></h2>
+
+  <% unless @card.description.blank? %>
+    <div class="card__description lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @comments.any? %>
+    <section class="comments">
+      <h3>Comments</h3>
+      <% @comments.each do |comment| %>
+        <article id="<%= dom_id(comment) %>" class="comment">
+          <strong><%= comment.creator.name %></strong>
+          <div class="comment__body"><%= comment.body %></div>
+        </article>
+      <% end %>
+    </section>
+  <% end %>
+</article>
