+# Adapts a ZipKit extractor to an IO that Active Storage can upload from.
+class ZipFile::ExtractorIO
+  def initialize(extractor, size)
+    @extractor = extractor
+    @size = size
+    @buffer = +"".b
+    @eof = false
+  end
+
+  def size
+    @size
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      data = +"".b
+      data << @buffer
+      @buffer = +"".b
+      until extractor_eof?
+        chunk = @extractor.extract(1.megabyte)
+        break if chunk.nil?
+
+        data << chunk
+      end
+      @eof = true
+      return nil if data.empty?
+
+      return assign_outbuf(outbuf, data)
+    end
+
+    while @buffer.bytesize < length && !extractor_eof?
+      chunk = @extractor.extract([ length, 1.megabyte ].max)
+      break if chunk.nil?
+
+      @buffer << chunk
+    end
+
+    if @buffer.empty?
+      @eof = true
+      return nil
+    end
+
+    result = @buffer.byteslice(0, length) || "".b
+    @buffer = @buffer.byteslice(length..) || +"".b
+    assign_outbuf(outbuf, result)
+  end
+
+  def eof?
+    @eof || (extractor_eof? && @buffer.empty?)
+  end
+
+  def binmode
+    self
+  end
+
+  private
+    def extractor_eof?
+      @extractor.eof?
+    end
+
+    def assign_outbuf(outbuf, data)
+      if outbuf
+        outbuf.replace(data)
+      else
+        data
+      end
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..28dfd89
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,65 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+    @by_name = @entries.index_by(&:filename)
+  end
+
+  def glob(pattern)
+    flags = File::FNM_PATHNAME | File::FNM_EXTGLOB
+    @entries.map(&:filename).select { |name| File.fnmatch(pattern, name, flags) }.sort
+  end
+
+  def exists?(path)
+    @by_name.key?(path)
+  end
+
+  def read(path)
+    entry = @by_name[path]
+    return nil unless entry
+
+    extract_string(entry)
+  end
+
+  def each_line(path)
+    entry = @by_name[path]
+    return unless entry
+
+    extractor = entry.extractor_from(@io)
+    buffer = +"".b
+
+    until extractor.eof?
+      chunk = extractor.extract(64.kilobytes)
+      break if chunk.nil?
+
+      buffer << chunk.b
+      while (index = buffer.index("\n".b))
+        line = buffer.byteslice(0, index)
+        buffer = buffer.byteslice((index + 1)..) || +"".b
+        yield line.force_encoding(Encoding::UTF_8)
+      end
+    end
+
+    yield buffer.force_encoding(Encoding::UTF_8) if buffer.present?
+  end
+
+  def extract_io(path)
+    entry = @by_name.fetch(path)
+    ZipFile::ExtractorIO.new(entry.extractor_from(@io), entry.uncompressed_size)
+  end
+
+  private
+    def extract_string(entry)
+      data = +"".b
+      extractor = entry.extractor_from(@io)
+
+      until extractor.eof?
+        chunk = extractor.extract(1.megabyte)
+        break if chunk.nil?
+
+        data << chunk
+      end
+
+      data
+    end
+end
diff --git a/app/models/zip_file/service_io.rb b/app/models/zip_file/service_io.rb
new file mode 100644
index 0000000..c3e4b41
--- /dev/null
+++ b/app/models/zip_file/service_io.rb
@@ -0,0 +1,50 @@
+# Range-reading IO over an Active Storage service.
+# Disk and S3 both implement +download_chunk+, so imports can stream
+# very large archives without downloading them first.
+class ZipFile::ServiceIO
+  def initialize(service, key, size)
+    @service = service
+    @key = key
+    @size = size
+    @pos = 0
+  end
+
+  def size
+    @size
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise ArgumentError, "Unsupported seek mode #{mode}" unless mode == IO::SEEK_SET
+
+    @pos = offset.clamp(0, @size)
+    0
+  end
+
+  def tell
+    @pos
+  end
+
+  def read(n_bytes = nil)
+    available = @size - @pos
+    return "".b if n_bytes == 0
+    return nil if available <= 0
+
+    length = n_bytes.nil? ? available : [ n_bytes, available ].min
+    return "".b if length.zero?
+
+    data = @service.download_chunk(@key, @pos..(@pos + length - 1))
+    @pos += data.bytesize
+    data
+  end
+
+  def binmode
+    self
+  end
+
+  def close
+  end
+
+  def closed?
+    false
+  end
+end
