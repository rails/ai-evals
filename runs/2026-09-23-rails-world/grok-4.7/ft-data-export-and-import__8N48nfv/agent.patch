--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "signed in user can import an account file" do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    blob = account_export_blob
+
+    assert_difference -> { Account.count }, +1 do
+      assert_enqueued_with(job: Account::Import::ProcessJob) do
+        post account_imports_path, params: {
+          import: { file: Rack::Test::UploadedFile.new(blob_file(blob), "application/zip") }
+        }
+      end
+      ActionMailer::Base.deliveries.clear
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+    end
+
+    assert_redirected_to new_account_import_path
+    imported = Account.order(:created_at).last
+    assert_equal accounts("37s").name, imported.name
+    assert imported.boards.exists?
+    assert imported.cards.exists?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_includes email.body.encoded, imported.name
+  end
+
+  test "a failed import emails the reason and leaves nothing behind" do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+
+    bad = Tempfile.new([ "bad", ".zip" ])
+    bad.write("not a zip")
+    bad.rewind
+
+    assert_no_difference -> { Account.count } do
+      post account_imports_path, params: {
+        import: { file: Rack::Test::UploadedFile.new(bad.path, "application/zip") }
+      }
+      ActionMailer::Base.deliveries.clear
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal "Your Fizzy account import failed", email.subject
+    assert_match(/not a Fizzy account export|could not be completed|invalid/i, email.body.encoded)
+  end
+
+  test "import page is available" do
+    sign_in_as :david
+    get new_account_import_path
+    assert_response :success
+    assert_select "input[type=file]"
+  end
+
+  private
+    def account_export_blob
+      export = accounts("37s").exports.create!(user: users(:kevin), purpose: "account")
+      export.process
+      raise export.error_message unless export.downloadable?
+      export.file.blob
+    end
+
+    def blob_file(blob)
+      file = Tempfile.new([ "export", ".zip" ])
+      file.binmode
+      file.write(blob.download)
+      file.rewind
+      file
+    end
+end
