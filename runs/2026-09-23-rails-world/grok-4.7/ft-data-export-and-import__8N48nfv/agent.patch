+class Account::Import < ApplicationRecord
+  STATUSES = %w[ pending completed failed ].freeze
+
+  belongs_to :account
+  belongs_to :user
+  belongs_to :identity
+  belongs_to :created_account, class_name: "Account", optional: true
+
+  has_one_attached :file
+
+  validates :status, inclusion: { in: STATUSES }
+
+  def process_later
+    Account::Import::ProcessJob.perform_later(self)
+  end
+
+  def process
+    created = Account::DataTransfer.import(file.blob, identity: identity)
+    update!(status: "completed", created_account: created, error_message: nil)
+    Account::ImportMailer.completed(self).deliver_later
+  rescue StandardError => error
+    Rails.error.report(error, context: { import_id: id })
+    update!(status: "failed", error_message: failure_message(error), created_account: nil)
+    Account::ImportMailer.failed(self).deliver_later
+  end
+
+  private
+    def failure_message(error)
+      if error.is_a?(Account::DataTransfer::Error)
+        error.message
+      else
+        "The import could not be completed (#{error.message})"
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..fe57802
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,68 @@
+class Export < ApplicationRecord
+  LINK_TTL = 1.day
+  PURPOSES = %w[ account cards ].freeze
+  STATUSES = %w[ pending ready failed ].freeze
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :status, inclusion: { in: STATUSES }
+
+  before_validation :assign_token, on: :create
+
+  def process_later
+    Export::ProcessJob.perform_later(self)
+  end
+
+  def process
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if purpose == "account"
+        Account::DataTransfer.export(account, zip)
+      else
+        Export::CardsArchive.new(visible_cards).write_into(zip, include_files: true)
+      end
+    end
+
+    update!(status: "ready", expires_at: LINK_TTL.from_now, error_message: nil)
+    ExportMailer.ready(self).deliver_later
+  rescue StandardError => error
+    Rails.error.report(error, context: { export_id: id })
+    update!(status: "failed", error_message: error.message)
+    ExportMailer.failed(self).deliver_later
+  end
+
+  def ready?
+    status == "ready" && file.attached?
+  end
+
+  def expired?
+    expires_at.present? && expires_at.past?
+  end
+
+  def downloadable?
+    ready? && !expired?
+  end
+
+  private
+    def assign_token
+      self.token ||= SecureRandom.urlsafe_base64(32)
+    end
+
+    def filename
+      if purpose == "account"
+        "#{account.name.parameterize.presence || "account"}-fizzy-export.zip"
+      else
+        "fizzy-cards.zip"
+      end
+    end
+
+    def visible_cards
+      board_ids = user.boards.select(:id)
+      published = Card.where(board_id: board_ids, status: "published")
+      own_drafts = Card.where(board_id: board_ids, creator_id: user.id, status: "drafted")
+      published.or(own_drafts).distinct
+    end
+end
diff --git a/app/models/export/cards_archive.rb b/app/models/export/cards_archive.rb
