+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -1,11 +1,45 @@
 class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransfer::RecordSet
+  PORTABLE_TYPES = %w[ ActiveStorage::Blob User ].freeze
+
   def initialize(account)
     super(account: account, model: ::ActionText::RichText)
   end
 
   private
     def records
+      return ::ActionText::RichText.none unless account
+
       ::ActionText::RichText.where(account: account)
     end
 
+    def serialize(record)
+      data = super
+      data["body"] = portable_body(data["body"])
+      data
+    end
+
+    def portable_body(html)
+      return html if html.blank? || !html.include?("action-text-attachment")
+
+      fragment = Nokogiri::HTML.fragment(html)
+      fragment.css("action-text-attachment").each do |node|
+        rewrite_attachment_node(node)
+      end
+      fragment.to_html
+    end
+
+    def rewrite_attachment_node(node)
+      return if node["sgid"].blank?
+
+      attachable = begin
+        ActionText::Attachable.from_attachable_sgid(node["sgid"])
+      rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+        nil
+      end
+
+      if attachable.respond_to?(:id) && PORTABLE_TYPES.include?(attachable.class.name)
+        node["sgid"] = "export:#{attachable.class.name}/#{attachable.id}"
+        node.remove_attribute("url") if attachable.is_a?(ActiveStorage::Blob)
+      end
+    end
 end
