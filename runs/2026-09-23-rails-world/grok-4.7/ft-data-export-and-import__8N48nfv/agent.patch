diff --git a/app/models/account/data_transfer.rb b/app/models/account/data_transfer.rb
new file mode 100644
index 0000000..b4ee29c
--- /dev/null
+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,96 @@
+module Account::DataTransfer
+  class Error < StandardError; end
+
+  VERSION = 1
+
+  class << self
+    def export(account, zip)
+      zip.add_file("manifest.json", { version: VERSION, kind: "account" }.to_json)
+      Manifest.new(account).each_record_set do |record_set|
+        record_set.export_to(zip)
+      end
+      Export::CardsArchive.new(account.cards).write_into(zip, include_files: false)
+    end
+
+    def import(blob, identity:)
+      context = ImportContext.new(identity: identity)
+
+      begin
+        ZipFile.open(blob) do |zip|
+          unless zip.exists?("accounts/records.jsonl")
+            raise Error, "This file is not a Fizzy account export."
+          end
+
+          Manifest.new(nil).each_record_set do |record_set|
+            record_set.import_from(zip, context)
+          end
+        end
+
+        context.finalize!
+        context.account
+      rescue Error
+        purge(context.account)
+        context.purge_created_identities
+        raise
+      rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::InvalidStructure
+        purge(context.account)
+        context.purge_created_identities
+        raise Error, "This file is not a Fizzy account export."
+      rescue StandardError => error
+        purge(context.account)
+        context.purge_created_identities
+        raise Error, error.message
+      end
+    end
+
+    # Removes every trace of an account created by a failed import.
+    def purge(account)
+      return unless account&.persisted?
+
+      blob_rows = ::ActiveStorage::Blob.where(account_id: account.id).pluck(:key, :service_name)
+      filter_ids = Filter.where(account_id: account.id).pluck(:id)
+      board_ids = Board.where(account_id: account.id).pluck(:id)
+
+      delete_join_rows(filter_ids)
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+      Storage::Total.where(owner_type: "Account", owner_id: account.id).delete_all
+      Storage::Entry.where(account_id: account.id).delete_all
+
+      Manifest.purgeable_models.each do |model|
+        model.where(account_id: account.id).delete_all
+      end
+
+      Account::JoinCode.where(account_id: account.id).delete_all
+      Account::Cancellation.where(account_id: account.id).delete_all
+      User.where(account_id: account.id).delete_all
+
+      delete_search_records(account)
+      delete_stored_files(blob_rows)
+      account.delete
+    end
+
+    private
+      def delete_join_rows(filter_ids)
+        return if filter_ids.empty?
+
+        %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].each do |table|
+          model = Class.new(ApplicationRecord) { self.table_name = table }
+          model.where(filter_id: filter_ids).delete_all
+        end
+      end
+
+      def delete_search_records(account)
+        Search::Record.for(account.id).where(account_id: account.id).delete_all
+      rescue StandardError
+        nil
+      end
+
+      def delete_stored_files(blob_rows)
+        blob_rows.each do |key, service_name|
+          ::ActiveStorage::Blob.services.fetch(service_name).delete(key)
+        rescue StandardError
+          nil
+        end
+      end
+  end
+end
