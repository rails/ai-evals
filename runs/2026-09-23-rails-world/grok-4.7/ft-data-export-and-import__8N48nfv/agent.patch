diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..8859683
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "admin can export the account and download it for a day" do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+
+    assert_enqueued_with(job: Export::ProcessJob) do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+
+    export = Export.last
+    assert_equal "account", export.purpose
+
+    ActionMailer::Base.deliveries.clear
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+    export.reload
+    assert export.downloadable?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_includes email.body.encoded, export.token
+    assert_match(/one day/i, email.body.encoded)
+
+    get account_export_path(export.token)
+    assert_response :redirect
+
+    travel 2.days do
+      get account_export_path(export.token)
+      assert_response :gone
+    end
+  end
+
+  test "members cannot export the whole account" do
+    sign_in_as :david
+
+    get account_settings_path
+    assert_response :success
