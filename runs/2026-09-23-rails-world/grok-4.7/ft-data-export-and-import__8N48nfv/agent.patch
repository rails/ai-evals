+require "test_helper"
+
+class Users::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "a user can download the cards they can see" do
+    Current.set(account: accounts("37s"), user: users(:kevin)) do
+      boards(:private).cards.create!(
+        title: "Secret card",
+        creator: users(:kevin),
+        status: "published"
+      )
+    end
+
+    sign_in_as :david
+    clear_enqueued_jobs
+
+    get user_path(users(:david))
+    assert_response :success
+    assert_select "button", text: "Download my cards"
+
+    assert_enqueued_with(job: Export::ProcessJob) do
+      post user_export_path(users(:david))
+    end
+    assert_redirected_to user_path(users(:david))
+
+    ActionMailer::Base.deliveries.clear
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+    export = Export.last
+    assert_equal "cards", export.purpose
+    assert export.downloadable?, export.error_message
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_includes email.body.encoded, export.token
+
+    ZipFile.open(export.file.blob) do |zip|
+      cards = JSON.parse(zip.read("cards.json"))
+      titles = cards.map { |card| card["title"] }
+
+      assert_includes titles, cards(:logo).title
+      assert_not_includes titles, "Secret card"
+
+      logo = cards.find { |card| card["title"] == cards(:logo).title }
+      assert logo["comments"].any?
+      assert logo.key?("files")
+    end
+  end
