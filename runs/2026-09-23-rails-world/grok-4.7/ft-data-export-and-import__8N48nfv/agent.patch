@@ -0,0 +1,29 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, purpose: "account")
+    export.process_later
+
+    redirect_to account_settings_path, notice: "We're preparing your account export. We'll email you a download link when it's ready."
+  end
+
+  def show
+    export = Export.find_by(token: params[:id])
+
+    if export.nil? || !export.ready?
+      head :not_found
+    elsif export.expired?
+      render plain: "This download link has expired.", status: :gone
+    else
+      ActiveStorage::Current.url_options = {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.port
+      }
+      redirect_to export.file.url(disposition: :attachment, expires_in: 10.minutes), allow_other_host: true
+    end
+  end
+end
