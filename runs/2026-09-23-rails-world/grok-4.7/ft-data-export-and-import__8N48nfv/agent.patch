new file mode 100644
index 0000000..542d76a
--- /dev/null
+++ b/app/models/zip_file/counting_io.rb
@@ -0,0 +1,45 @@
+# Counts and checksums every byte ZipKit writes, whichever IO method it uses.
+class ZipFile::CountingIO
+  def initialize(io, writer)
+    @io = io
+    @writer = writer
+  end
+
+  def write(data)
+    return 0 if data.nil?
+
+    bytes = data.b
+    @writer.note_write(bytes)
+    @io.write(bytes)
+  end
+
+  def <<(data)
+    write(data)
+    self
+  end
+
+  def binmode
+    @io.binmode if @io.respond_to?(:binmode)
+    self
+  end
+
+  def flush
+    @io.flush if @io.respond_to?(:flush)
+  end
+
+  def close
+    @io.close if @io.respond_to?(:close)
+  end
+
+  def method_missing(name, ...)
+    if @io.respond_to?(name)
+      @io.public_send(name, ...)
+    else
+      super
+    end
+  end
+
+  def respond_to_missing?(name, include_private = false)
+    @io.respond_to?(name, include_private) || super
+  end
+end
