--- /dev/null
+++ b/app/models/export/cards_archive.rb
@@ -0,0 +1,93 @@
+class Export::CardsArchive
+  def initialize(cards)
+    @cards = cards
+  end
+
+  def write_into(zip, include_files:)
+    payload = []
+
+    relation.find_each do |card|
+      files = files_for(card)
+      payload << serialize_card(card, files)
+      write_files(zip, files) if include_files
+    end
+
+    zip.add_file("cards.json", JSON.pretty_generate(payload))
+  end
+
+  private
+    def relation
+      @cards.includes(
+        :board,
+        :column,
+        :creator,
+        image_attachment: :blob,
+        comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ],
+        rich_text_description: { embeds_attachments: :blob }
+      )
+    end
+
+    def serialize_card(card, files)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        board: card.board.name,
+        column: card.column&.name,
+        created_at: card.created_at,
+        last_active_at: card.last_active_at,
+        creator: person(card.creator),
+        description_html: card.description.to_s,
+        description_plain: card.description.to_plain_text,
+        comments: card.comments.chronologically.map { |comment| serialize_comment(comment) },
+        files: files.map { |blob| file_entry(blob) }
+      }
+    end
+
+    def serialize_comment(comment)
+      {
+        id: comment.id,
+        created_at: comment.created_at,
+        creator: person(comment.creator),
+        body_html: comment.body.to_s,
+        body_plain: comment.body.to_plain_text
+      }
+    end
+
+    def person(user)
+      return nil unless user
+
+      {
+        name: user.name,
+        email: user.identity&.email_address
+      }
+    end
+
+    def files_for(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat(card.attachments.filter_map(&:blob))
+      card.comments.each do |comment|
+        blobs.concat(comment.attachments.filter_map(&:blob))
+      end
+      blobs.uniq
+    end
+
+    def file_entry(blob)
+      {
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: "files/#{blob.key}"
+      }
+    end
+
+    def write_files(zip, blobs)
+      blobs.each do |blob|
+        zip.add_file("files/#{blob.key}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+end
