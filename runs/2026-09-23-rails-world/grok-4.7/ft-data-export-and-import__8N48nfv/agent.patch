diff --git a/app/models/account/data_transfer/filter_record_set.rb b/app/models/account/data_transfer/filter_record_set.rb
new file mode 100644
index 0000000..5b6313f
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,58 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  JOINS = {
+    "assignee_ids" => [ "assignees_filters", "assignee_id" ],
+    "assigner_ids" => [ "assigners_filters", "assigner_id" ],
+    "board_ids" => [ "boards_filters", "board_id" ],
+    "closer_ids" => [ "closers_filters", "closer_id" ],
+    "creator_ids" => [ "creators_filters", "creator_id" ],
+    "tag_ids" => [ "filters_tags", "tag_id" ]
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: ::Filter)
+  end
+
+  private
+    def serialize(record)
+      super.merge(join_ids_for(record))
+    end
+
+    def join_ids_for(record)
+      JOINS.each_with_object({}) do |(key, (table, column)), ids|
+        ids[key] = join_model(table).where(filter_id: record.id).pluck(column)
+      end
+    end
+
+    def after_insert(attrs, context)
+      new_id = context.remap(attrs["id"])
+      insert_joins(attrs, new_id, context)
+      refresh_digest(new_id)
+    end
+
+    def insert_joins(attrs, new_id, context)
+      JOINS.each do |key, (table, column)|
+        rows = Array(attrs[key]).filter_map do |old_id|
+          mapped = context.remap(old_id)
+          { column => mapped, "filter_id" => new_id } if mapped
+        end
+        next if rows.empty?
+
+        join_model(table).insert_all!(rows)
+      end
+    end
+
+    def refresh_digest(filter_id)
+      filter = Filter.find_by(id: filter_id)
+      return unless filter
+
+      filter.update_column(:params_digest, Filter.digest_params(filter.as_params))
+    rescue StandardError
+      nil
+    end
+
+    def join_model(table_name)
+      Class.new(ApplicationRecord) do
+        self.table_name = table_name
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/import_context.rb b/app/models/account/data_transfer/import_context.rb
new file mode 100644
index 0000000..162847b
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,118 @@
+class Account::DataTransfer::ImportContext
+  attr_accessor :account
+  attr_reader :identity, :created_identity_ids, :old_external_account_id
+
+  def initialize(identity:)
+    @identity = identity
+    @id_map = {}
+    @key_map = {}
+    @created_identity_ids = []
+    @old_external_account_id = nil
+  end
+
+  def register(old_id, new_id)
+    return if old_id.blank?
+
+    @id_map[old_id.to_s] = new_id
+  end
+
+  def remap(old_id)
+    return nil if old_id.blank?
+
+    @id_map[old_id.to_s]
+  end
+
+  def register_key(old_key, new_key)
+    @key_map[old_key] = new_key
+  end
+
+  def key_for(old_key)
+    @key_map[old_key]
+  end
+
+  def each_key
+    @key_map.each { |old_key, new_key| yield old_key, new_key }
+  end
+
+  def remember_external_account_id(external_account_id)
+    @old_external_account_id = external_account_id
+  end
+
+  def track_identity(identity, created:)
+    @created_identity_ids << identity.id if created
+    identity
+  end
+
+  def generate_id
+    ActiveRecord::Type::Uuid.generate
+  end
+
+  def finalize!
+    raise Account::DataTransfer::Error, "The export did not include an account." unless account
+
+    Current.with_account(account) do
+      ensure_importer!
+      ensure_user_settings!
+      ensure_webhook_trackers!
+      account.update_column(:cards_count, account.cards.maximum(:number) || 0)
+      reindex
+      reconcile_storage
+    end
+  end
+
+  def purge_created_identities
+    Identity.where(id: created_identity_ids).find_each do |created|
+      created.destroy if created.users.none?
+    end
+  end
+
+  private
+    def ensure_importer!
+      user = account.users.find_by(identity: identity)
+
+      if user
+        user.update!(active: true, verified_at: user.verified_at || Time.current) unless user.active? && user.verified?
+      else
+        user = account.users.create!(
+          identity: identity,
+          name: identity.email_address.to_s.truncate(255, omission: ""),
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+
+      missing_boards = account.boards.where.not(id: user.boards.select(:id))
+      missing_boards.find_each do |board|
+        board.accesses.grant_to(user)
+      end
+    end
+
+    def ensure_user_settings!
+      account.users.where.not(role: "system").find_each do |user|
+        User::Settings.create!(user: user, account: account) unless user.settings
+      end
+    end
+
+    def ensure_webhook_trackers!
+      account.webhooks.find_each do |webhook|
+        next if webhook.delinquency_tracker
+
+        Webhook::DelinquencyTracker.create!(webhook: webhook, account: account)
+      end
+    end
+
+    def reindex
+      account.cards.find_each do |card|
+        card.reindex if card.searchable?
+      end
+
+      Comment.where(account: account).find_each do |comment|
+        comment.reindex if comment.searchable?
+      end
+    end
+
+    def reconcile_storage
+      account.boards.find_each(&:reconcile_storage)
+      account.reconcile_storage
+    end
+end
