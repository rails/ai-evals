+class Account::ImportsController < ApplicationController
+  def new
+  end
+
+  def create
+    file = params.dig(:import, :file)
+
+    if file.blank?
+      redirect_to new_account_import_path, alert: "Choose an account export to import."
+      return
+    end
+
+    import = Current.account.imports.create!(user: Current.user, identity: Current.identity)
+    import.file.attach(file)
+    import.process_later
+
+    redirect_to new_account_import_path, notice: "We're importing that file into a new account. We'll email you when it's done."
+  end
+end
