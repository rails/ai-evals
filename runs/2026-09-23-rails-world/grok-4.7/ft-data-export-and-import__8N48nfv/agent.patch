+  test "you cannot export someone else's cards" do
+    sign_in_as :david
+
+    post user_export_path(users(:kevin))
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/account/data_transfer_test.rb b/test/models/account/data_transfer_test.rb
new file mode 100644
index 0000000..ba029ee
--- /dev/null
+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:jason)
+    @account = Account.create_with_owner(
+      account: { name: "Export Co" },
+      owner: { name: "Jason", identity: @identity }
+    )
+
+    @owner = @account.users.find_by!(identity: @identity)
+    Current.set(account: @account, user: @owner) do
+      @board = @account.boards.create!(name: "Launch", creator: @owner, all_access: true)
+      @column = @board.columns.create!(name: "Doing")
+      @card = @board.cards.create!(
+        title: "Ship the export",
+        creator: @owner,
+        status: "published",
+        column: @column,
+        description: "Bring the files."
+      )
+      @card.image.attach(io: StringIO.new("image-bytes"), filename: "pic.png", content_type: "image/png")
+
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("note-bytes"),
+        filename: "note.txt",
+        content_type: "text/plain"
+      )
+      @card.comments.create!(
+        creator: @owner,
+        body: "See #{ActionText::Attachment.from_attachable(blob).to_html}"
+      )
+    end
+  end
+
+  test "round trip restores boards, cards, comments, files, and people" do
+    blob = export_blob(@account)
+
+    ZipFile.open(blob) do |zip|
+      cards = JSON.parse(zip.read("cards.json"))
+      card = cards.find { |entry| entry["title"] == "Ship the export" }
+      assert_equal "Bring the files.", card["description_plain"]
+      assert card["comments"].any?
+      assert card["files"].any?
+      assert zip.exists?(card["files"].first["path"])
+    end
+
+    imported = nil
+    assert_difference -> { Account.count }, +1 do
+      imported = Account::DataTransfer.import(blob, identity: identities(:david))
+    end
+
+    assert_equal "Export Co", imported.name
+    assert_not_equal @account.id, imported.id
+
+    imported_owner = imported.users.find_by!(identity: @identity)
+    assert_equal "Jason", imported_owner.name
+    assert imported.users.exists?(role: "system")
+    assert imported.users.exists?(identity: identities(:david), role: "owner")
+
+    card = imported.cards.find_by!(title: "Ship the export")
+    assert_equal @card.number, card.number
+    assert_equal "Launch", card.board.name
+    assert_equal "Doing", card.column.name
+    assert_equal "Bring the files.", card.description.to_plain_text
+    assert_equal "image-bytes", card.image.download
+
+    comment = card.comments.sole
+    assert_includes comment.body.to_plain_text, "See"
+    assert_equal "note-bytes", comment.attachments.sole.blob.download
+  end
+
+  test "a failed import leaves nothing behind" do
+    blob = export_blob(@account)
+    before = Account.pluck(:id)
+
+    Account::DataTransfer::ActiveStorage::FileRecordSet.any_instance.stubs(:import_from).raises(Account::DataTransfer::Error, "disk full")
+
+    error = assert_raises(Account::DataTransfer::Error) do
+      Account::DataTransfer.import(blob, identity: identities(:david))
+    end
+
+    assert_equal "disk full", error.message
+    assert_equal before.sort, Account.pluck(:id).sort
+    assert_not Board.exists?(name: "Launch", account_id: Account.where.not(id: before).select(:id))
+  end
+
+  test "rejects a file that is not an account export" do
+    export = @account.exports.create!(user: @owner, purpose: "cards")
+    export.process
+
+    assert_no_difference -> { Account.count } do
+      error = assert_raises(Account::DataTransfer::Error) do
+        Account::DataTransfer.import(export.file.blob, identity: identities(:david))
+      end
+      assert_match(/not a Fizzy account export/, error.message)
+    end
+  end
+
+  private
+    def export_blob(account)
+      export = account.exports.create!(user: account.users.owner.first, purpose: "account")
+      export.process
+      assert export.downloadable?, export.error_message.to_s
+      export.file.blob
+    end
+end
diff --git a/test/models/zip_file_reader_test.rb b/test/models/zip_file_reader_test.rb
new file mode 100644
index 0000000..0079558
--- /dev/null
+++ b/test/models/zip_file_reader_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "reader lists and reads entries written by the writer" do
+    io = StringIO.new(+"")
+    io.binmode
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.add_file("docs/guide.txt", "Guide")
+    writer.close
+
+    blob_io = StringIO.new(io.string)
+    reader = ZipFile::Reader.new(blob_io)
+
+    assert reader.exists?("hello.txt")
+    assert_equal "Hello, World!", reader.read("hello.txt")
+    assert_equal [ "docs/guide.txt" ], reader.glob("docs/*")
+  end
+
+  test "service io can read a zip with ranged downloads" do
+    io = StringIO.new(+"")
+    io.binmode
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("cards.json", "{\"ok\":true}")
+    writer.close
+
+    service = FakeRangeService.new(io.string)
+    range_io = ZipFile::ServiceIO.new(service, "archive", io.string.bytesize)
+    reader = ZipFile::Reader.new(range_io)
+
+    assert_equal "{\"ok\":true}", reader.read("cards.json")
+    assert service.reads.positive?
+  end
+
+  class FakeRangeService
+    attr_reader :reads
+
+    def initialize(data)
+      @data = data
+      @reads = 0
+    end
+
+    def download_chunk(_key, range)
+      @reads += 1
+      @data.byteslice(range)
+    end
+  end
+end
