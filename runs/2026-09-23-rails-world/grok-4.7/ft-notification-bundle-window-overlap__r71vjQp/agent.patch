diff --git a/script/check_notification_bundles.rb b/script/check_notification_bundles.rb
new file mode 100644
index 0000000..8b5fa6a
--- /dev/null
+++ b/script/check_notification_bundles.rb
@@ -0,0 +1,43 @@
+# Run with: bin/rails runner script/check_notification_bundles.rb
+# Exercises digest windows without the test suite.
+
+require "active_support/testing/time_helpers"
+
+include ActiveSupport::Testing::TimeHelpers
+
+user = User.joins(:identity).where.not(role: "system").first
+raise "no user" unless user
+
+Current.account = user.account
+user.notifications.delete_all
+user.notification_bundles.delete_all
+user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+event = Event.where(account: user.account).first
+card = event.card
+creator = user.account.users.where.not(id: user.id).first || user
+
+def make_notification(user, event, creator, at)
+  Notification.where(user: user, card: event.card).delete_all
+  Notification.create!(user: user, source: event, creator: creator, created_at: at, updated_at: at)
+end
+
+landed_at = Time.zone.parse("2026-04-02 09:07:00")
+first = travel_to(landed_at) { make_notification(user, event, creator, landed_at) }
+bundle = first.bundle
+raise "clock did not start at landing time" unless bundle.starts_at == landed_at
+raise "window is not four hours" unless bundle.ends_at == landed_at + 4.hours
+
+other_event = Event.where(account: user.account).where.not(id: event.id).first
+late_at = landed_at - 90.minutes
+late = travel_to(landed_at + 30.minutes) { make_notification(user, other_event, creator, late_at) }
+raise "late notification opened a second window" unless late.reload.bundle_id == bundle.id
+raise "overlapping windows" if Notification::Bundle.overlapping?(user)
+
+user.settings.update!(bundle_email_frequency: "never")
+user.notifications.delete_all
+user.notification_bundles.delete_all
+skipped = travel_to(landed_at) { make_notification(user, event, creator, landed_at) }
+raise "off still bundled" if skipped.bundle_id.present?
+
+puts "notification bundles ok"
