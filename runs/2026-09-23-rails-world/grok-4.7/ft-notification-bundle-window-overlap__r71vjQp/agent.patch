diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..5cf8a3c
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,130 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, -> { order(:created_at, :id) }, foreign_key: :bundle_id, dependent: :nullify, inverse_of: :bundle
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+  scope :ordered, -> { order(starts_at: :asc, id: :asc) }
+
+  validate :no_overlap, on: :create
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def find_or_open_for(user, at:)
+      settings = User::Settings.find_by(user_id: user.id)
+      return if settings.nil? || settings.bundle_email_period.nil?
+
+      user.with_lock do
+        settings.reload
+        period = settings.bundle_email_period
+
+        if period.nil?
+          nil
+        else
+          locate_or_create(user, at, period, settings.bundle_email_frequency)
+        end
+      end
+    end
+
+    def deliver_due
+      due.find_each(&:deliver)
+    end
+
+    def overlapping?(user)
+      ordered.where(user: user).each_cons(2).any? { |earlier, later| earlier.overlaps?(later) }
+    end
+
+    private
+      def locate_or_create(user, at, period, frequency)
+        bundles = where(user_id: user.id).ordered.to_a
+        now = Time.current
+
+        if bundle = bundles.find { |candidate| candidate.cover?(at) }
+          bundle
+        elsif bundle = bundle_for_late_arrival(bundles, at, now, period)
+          bundle
+        else
+          create!(
+            user: user,
+            account: user.account,
+            frequency: frequency,
+            starts_at: at,
+            ends_at: at + period
+          )
+        end
+      end
+
+      # Notifications can be recorded after a later one has already started the
+      # clock. They join the window that is already open instead of starting a
+      # second window that would overlap it.
+      def bundle_for_late_arrival(bundles, at, now, period)
+        current = bundles.find { |candidate| candidate.cover?(now) }
+
+        if current && at < current.starts_at
+          current
+        else
+          prospective_end = at + period
+          overlapping = bundles.select { |candidate| candidate.overlaps_range?(at, prospective_end) }
+          opened = overlapping.select { |candidate| candidate.starts_at <= now }
+          opened.min_by(&:starts_at) || overlapping.min_by(&:starts_at)
+        end
+      end
+  end
+
+  def deliver
+    with_lock do
+      if delivered?
+        nil
+      else
+        if deliverable?
+          Current.with_account(account) do
+            NotificationMailer.bundle(self).deliver_now
+          end
+        end
+
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def cover?(time)
+    starts_at <= time && time < ends_at
+  end
+
+  def overlaps?(other)
+    overlaps_range?(other.starts_at, other.ends_at)
+  end
+
+  def overlaps_range?(range_start, range_end)
+    starts_at < range_end && range_start < ends_at
+  end
+
+  def accepting_activity?
+    !delivered? && cover?(Time.current)
+  end
+
+  private
+    def schedule_delivery
+      Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+
+    def deliverable?
+      notifications.any? && user.active? && account.active? && user.identity&.email_address.present?
+    end
+
+    def no_overlap
+      overlapping = self.class.where(user_id: user_id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+      overlapping = overlapping.where.not(id: id) if persisted?
+
+      if overlapping.exists?
+        errors.add(:base, "overlaps another notification window")
+      end
+    end
+end
