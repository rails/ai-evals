diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..a7110d5
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+    @user.notifications.delete_all
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "clock starts when the first notification lands" do
+    landed_at = Time.zone.parse("2026-03-01 12:13:00")
+
+    notification = travel_to(landed_at) { create_notification(:logo_published, at: landed_at) }
+
+    assert_equal landed_at, notification.bundle.starts_at
+    assert_equal landed_at + 4.hours, notification.bundle.ends_at
+    assert_equal "every_few_hours", notification.bundle.frequency
+  end
+
+  test "notifications in the same window share one bundle" do
+    first = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+    second = travel_to(Time.zone.parse("2026-03-01 15:59:00")) do
+      create_notification(:layout_published)
+    end
+
+    assert_equal first.bundle, second.reload.bundle
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "a notification landing when the window ends opens the next window" do
+    first = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+    second = travel_to(Time.zone.parse("2026-03-01 16:00:00")) do
+      create_notification(:layout_published)
+    end
+
+    assert_not_equal first.bundle, second.bundle
+    assert_equal first.bundle.ends_at, second.bundle.starts_at
+    assert_not Notification::Bundle.overlapping?(@user)
+  end
+
+  test "a late notification joins the window that has already opened" do
+    opened = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+
+    late = travel_to(Time.zone.parse("2026-03-01 13:00:00")) do
+      create_notification(:layout_published, at: Time.zone.parse("2026-03-01 11:00:00"))
+    end
+
+    assert_equal opened.bundle, late.reload.bundle
+    assert_equal 1, @user.notification_bundles.count
+    assert_not Notification::Bundle.overlapping?(@user)
+  end
+
+  test "a late notification that would overlap an opened window does not open another" do
+    travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+
+    travel_to(Time.zone.parse("2026-03-01 13:00:00")) do
+      create_notification(:layout_published, at: Time.zone.parse("2026-03-01 09:30:00"))
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_not Notification::Bundle.overlapping?(@user)
+  end
+
+  test "a late notification whose time falls in a closed window joins that window" do
+    first = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+    travel_to(Time.zone.parse("2026-03-01 16:00:00")) do
+      create_notification(:layout_published)
+    end
+    late = travel_to(Time.zone.parse("2026-03-01 17:00:00")) do
+      create_notification(:text_published, at: Time.zone.parse("2026-03-01 13:00:00"))
+    end
+
+    assert_equal first.bundle, late.reload.bundle
+    assert_not Notification::Bundle.overlapping?(@user)
+  end
+
+  test "changing frequency does not resize the window that already opened" do
+    notification = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    assert_equal notification.created_at + 4.hours, notification.bundle.reload.ends_at
+
+    later = travel_to(notification.bundle.ends_at) do
+      create_notification(:layout_published)
+    end
+
+    assert_equal later.created_at + 1.week, later.bundle.ends_at
+    assert_not Notification::Bundle.overlapping?(@user)
+  end
+
+  test "daily and weekly windows use their own durations" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    daily = travel_to(Time.zone.parse("2026-03-01 08:15:00")) { create_notification(:logo_published) }
+    assert_equal daily.created_at + 1.day, daily.bundle.ends_at
+
+    @user.notifications.delete_all
+    @user.notification_bundles.delete_all
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    weekly = travel_to(Time.zone.parse("2026-03-01 08:15:00")) { create_notification(:logo_published) }
+    assert_equal weekly.created_at + 1.week, weekly.bundle.ends_at
+  end
+
+  test "off sends nothing and opens no window" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    notification = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+
+    assert_nil notification.bundle
+    assert_empty @user.notification_bundles
+    assert_no_enqueued_jobs only: Notification::BundleDeliveryJob
+  end
+
+  test "one email is sent per window when it closes" do
+    bundle = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published).bundle
+    end
+    travel_to(Time.zone.parse("2026-03-01 13:00:00")) do
+      create_notification(:layout_published)
+    end
+
+    assert_no_emails
+
+    travel_to(bundle.ends_at) do
+      assert_emails 1 do
+        Notification::Bundle.deliver_due
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications in 37signals", email.subject
+    assert_match "Layout is broken", email.html_part.body.decoded
+    assert bundle.reload.delivered?
+
+    assert_no_emails do
+      Notification::Bundle.deliver_due
+    end
+  end
+
+  test "people do not share windows" do
+    other = users(:kevin)
+    other.notifications.delete_all
+    other.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+      Notification.create!(user: other, source: events(:layout_published), creator: users(:david))
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 1, other.notification_bundles.count
+    assert_not_equal @user.notification_bundles.first, other.notification_bundles.first
+  end
+
+  test "later activity on a delivered notification opens the next window" do
+    notification = travel_to(Time.zone.parse("2026-03-01 12:00:00")) do
+      create_notification(:logo_published)
+    end
+    bundle = notification.bundle
+
+    travel_to(bundle.ends_at) { bundle.deliver }
+    assert bundle.reload.delivered?
+
+    travel_to(bundle.ends_at + 5.minutes) do
+      notification.update!(source: events(:logo_assignment_km), creator: users(:david))
+    end
+
+    notification.reload
+    assert_not_equal bundle, notification.bundle
+    assert_equal bundle.ends_at + 5.minutes, notification.bundle.starts_at
+    assert_not Notification::Bundle.overlapping?(@user)
+  end
+
+  private
+    def create_notification(event_name, at: Time.current)
+      Notification.create!(
+        user: @user,
+        source: events(event_name),
+        creator: users(:david),
+        created_at: at,
+        updated_at: at
+      )
+    end
+end
