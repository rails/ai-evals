@@ -0,0 +1,87 @@
+class Sessions::MagicLinksController < ApplicationController
+  include EmailCodeAuthentication
+
+  skip_before_action :require_account
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def show
+    @magic_link = pending_magic_link
+
+    if @magic_link&.usable?
+      render :show
+    else
+      redirect_to new_session_path, alert: "That code expired. Request a new one."
+    end
+  end
+
+  def create
+    magic_link = MagicLink.consume(pending_authentication_token, params[:code])
+
+    if magic_link
+      cookies.delete(:pending_authentication_token)
+      start_new_session_for magic_link.identity
+      finish_magic_link magic_link
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def finish_magic_link(magic_link)
+      if magic_link.purpose_sign_up?
+        respond_with_session new_signup_completion_url(script_name: nil)
+      elsif magic_link.purpose_join?
+        finish_join magic_link
+      else
+        respond_with_session after_authentication_url
+      end
+    end
+
+    def finish_join(magic_link)
+      join_code = magic_link.join_code
+      identity = magic_link.identity
+      join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html { redirect_after_join user, join_code }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def redirect_after_join(user, join_code)
+      if user.setup?
+        redirect_to landing_url(script_name: join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+
+    def respond_with_session(url)
+      respond_to do |format|
+        format.html { redirect_to url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
