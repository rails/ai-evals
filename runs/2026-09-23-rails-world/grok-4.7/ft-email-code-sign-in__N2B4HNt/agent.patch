+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "issues a six character code that expires in fifteen minutes" do
+    magic_link = MagicLink.issue_for(identities(:kevin), purpose: :sign_in)
+
+    assert_equal 6, magic_link.code.length
+    assert_match /\A[A-Z2-9]{6}\z/, magic_link.code
+    assert_in_delta 15.minutes.from_now, magic_link.expires_at, 2.seconds
+    assert magic_link.usable?
+  end
+
+  test "consume rejects an expired code" do
+    magic_link = MagicLink.issue_for(identities(:kevin), purpose: :sign_in)
+    token = magic_link.authentication_token
+
+    travel 16.minutes do
+      assert_nil MagicLink.consume(token, magic_link.code)
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+end
