new file mode 100644
index 0000000..c09daf0
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,36 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def send_email_code(identity, purpose:, join_code: nil)
+      magic_link = MagicLink.issue_for(identity, purpose: purpose, join_code: join_code)
+      MagicLinkMailer.sign_in_code(magic_link).deliver_now
+      set_pending_authentication_token magic_link
+      respond_with_pending_authentication
+    end
+
+    def set_pending_authentication_token(magic_link)
+      cookies.signed[:pending_authentication_token] = {
+        value: magic_link.authentication_token,
+        httponly: true,
+        same_site: :lax,
+        expires: magic_link.expires_at
+      }
+    end
+
+    def pending_authentication_token
+      cookies.signed[:pending_authentication_token]
+    end
+
+    def pending_magic_link
+      token = pending_authentication_token
+      MagicLink.find_signed(token, purpose: MagicLink::TOKEN_PURPOSE) if token.present?
+    end
+
+    def respond_with_pending_authentication
+      respond_to do |format|
+        format.html { redirect_to main_app.session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+      end
+    end
+end
