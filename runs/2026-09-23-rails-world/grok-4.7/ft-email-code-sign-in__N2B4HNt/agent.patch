@@ -0,0 +1,96 @@
+require "test_helper"
+
+class EmailCodeFlowsTest < ActionDispatch::IntegrationTest
+  test "signing up by email code signs the person in" do
+    email_address = "new-signup-#{SecureRandom.hex(4)}@example.com"
+
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "sign_up", magic_link.purpose
+      assert_includes delivered_email.subject, magic_link.code
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "joining by email code adds the person to the account" do
+    account = accounts("37s")
+    join_code = account_join_codes("37s")
+    email_address = "new-joiner-#{SecureRandom.hex(4)}@example.com"
+
+    assert_difference -> { Identity.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+    end
+
+    assert_redirected_to session_magic_link_url(script_name: nil)
+    assert_equal "join", magic_link.purpose
+    assert_includes delivered_email.subject, magic_link.code
+
+    assert_difference -> { account.users.count }, 1 do
+      post session_magic_link_path(script_name: nil), params: { code: magic_link.code }
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    user = account.users.find_by!(identity: identity)
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert_not user.setup?
+    assert cookies[:session_token].present?
+  end
+
+  test "joining an existing member by email code signs them in" do
+    account = accounts("37s")
+    join_code = account_join_codes("37s")
+    identity = identities(:jz)
+    usage_count = join_code.usage_count
+
+    assert identity.users.find_by!(account: account).setup?
+
+    assert_no_difference -> { User.count } do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identity.email_address }
+    end
+
+    assert_redirected_to session_magic_link_url(script_name: nil)
+
+    post session_magic_link_path(script_name: nil), params: { code: magic_link.code }
+
+    assert_redirected_to landing_url(script_name: account.slug)
+    assert_equal usage_count, join_code.reload.usage_count
+    assert cookies[:session_token].present?
+  end
+
+  test "a code stops working one second after it expires" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      code = magic_link.code
+
+      travel_to magic_link.expires_at + 1.second do
+        post session_magic_link_path, params: { code: code }
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  private
+    def magic_link
+      MagicLink.order(:created_at).last
+    end
+
+    def delivered_email
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+      ActionMailer::Base.deliveries.last
+    end
+end
diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..d29a603
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "sign in by email code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal 6, magic_link.code.length
+      assert_includes delivered_email.subject, magic_link.code
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_magic_link_path, params: { code: "  #{magic_link.code.downcase} " }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "sign in by email code via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+
+      assert_response :created
+      assert @response.parsed_body["pending_authentication_token"].present?
+      code = magic_link.code
+      assert_equal 6, code.length
+      assert_includes delivered_email.subject, code
+
+      post session_magic_link_path(format: :json), params: { code: code }, as: :json
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "invalid code does not sign in" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = magic_link.code
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "invalid code via JSON is unauthorized" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+
+      post session_magic_link_path(format: :json), params: { code: "NOPE00" }, as: :json
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "code expires after fifteen minutes" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = magic_link.code
+
+      travel 15.minutes + 1.second do
+        post session_magic_link_path, params: { code: code }
+
+        assert_not cookies[:session_token].present?
+        assert_redirected_to session_magic_link_path
+      end
+    end
+  end
+
+  test "a code only works once" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = magic_link.code
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      delete session_path
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: code }
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "requesting a new code invalidates the previous one" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      old_code = magic_link.code
+
+      post session_path, params: { email_address: @identity.email_address.upcase }
+      new_code = magic_link.code
+
+      assert_not_equal old_code, new_code
+
+      post session_magic_link_path, params: { code: old_code }
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: new_code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "invalid email is rejected when signups are enabled" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: "not-an-email" }, as: :json
+
+      assert_response :unprocessable_entity
+      assert_enqueued_jobs 0, only: ActionMailer::MailDeliveryJob
+    end
+  end
+
+  private
+    def magic_link
+      MagicLink.last
+    end
+
+    def delivered_email
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+      ActionMailer::Base.deliveries.last
+    end
+end
