@@ -0,0 +1,48 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path(script_name: nil), class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.text_field :code,
+          required: true,
+          autofocus: true,
+          autocomplete: "one-time-code",
+          autocapitalize: "characters",
+          spellcheck: false,
+          maxlength: MagicLink::CODE_LENGTH,
+          class: "input",
+          placeholder: "H7K2MP" %>
+
+    <p>
+      We sent a code to <strong><%= @magic_link.identity.email_address %></strong>.
+      <% if @magic_link.purpose_sign_up? %>
+        Enter it to finish signing up.
+      <% elsif @magic_link.purpose_join? %>
+        Enter it to join <%= @magic_link.join_code.account.name %>.
+      <% else %>
+        Enter it to sign in.
+      <% end %>
+      It works for 15 minutes.
+    </p>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle margin-block-start">
+    <% if @magic_link.purpose_sign_up? %>
+      <%= link_to "Use a different email", new_signup_path, class: "txt-link" %>
+    <% elsif @magic_link.purpose_join? %>
+      <%= link_to "Use a different email", join_path(code: @magic_link.join_code.code, script_name: @magic_link.join_code.account.slug), class: "txt-link" %>
+    <% else %>
+      <%= link_to "Use a different email", new_session_path, class: "txt-link" %>
+    <% end %>
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
