diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..ca39a80
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,56 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  TOKEN_PURPOSE = :email_code
+  ALPHABET = (("A".."Z").to_a + ("2".."9").to_a - %w[O I]).freeze
+
+  belongs_to :identity
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), prefix: :purpose, validate: true
+
+  before_validation :set_defaults, on: :create
+
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+  validates :expires_at, presence: true
+  validates :join_code, presence: true, if: :purpose_join?
+
+  def self.issue_for(identity, purpose:, join_code: nil)
+    transaction do
+      identity.magic_links.delete_all
+      create!(identity: identity, purpose: purpose, join_code: join_code)
+    end
+  end
+
+  def self.consume(token, code)
+    if token.present? && (magic_link = find_signed(token, purpose: TOKEN_PURPOSE))
+      if magic_link.usable? && magic_link.code_matches?(code)
+        magic_link.destroy!
+        magic_link
+      end
+    end
+  end
+
+  def self.generate_code
+    Array.new(CODE_LENGTH) { ALPHABET[SecureRandom.random_number(ALPHABET.length)] }.join
+  end
+
+  def authentication_token
+    signed_id(purpose: TOKEN_PURPOSE, expires_at: expires_at)
+  end
+
+  def usable?
+    expires_at.future?
+  end
+
+  def code_matches?(candidate)
+    normalized = candidate.to_s.gsub(/[[:space:]]/, "").upcase
+    normalized.bytesize == code.bytesize && ActiveSupport::SecurityUtils.secure_compare(code, normalized)
+  end
+
+  private
+    def set_defaults
+      self.code ||= self.class.generate_code
+      self.expires_at ||= EXPIRATION.from_now
+    end
+end
