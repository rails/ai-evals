diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..1e71486
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,43 @@
+const JA = {
+  "Less than a minute ago": "1分未満前",
+  "today": "今日",
+  "yesterday": "昨日",
+  "tomorrow": "明日",
+  "Today": "今日",
+  "day": "日",
+  "days": "日",
+  "days ago": "日前",
+  "in": "あと",
+  "Stalled for": "停滞",
+  "Please fill out this field": "この項目を入力してください",
+  "No selection": "未選択",
+  "Are you sure?": "よろしいですか？"
+}
+
+export function appLocale() {
+  return document.documentElement.lang || "en"
+}
+
+export function t(english) {
+  if (appLocale() !== "ja") return english
+  return JA[english] || english
+}
+
+export function relativeAgo(quantity, unit) {
+  if (appLocale() !== "ja") {
+    const suffix = quantity === 1 ? "" : "s"
+    return `${quantity} ${unit}${suffix} ago`
+  }
+  const units = { year: "年", month: "か月", week: "週間", day: "日", hour: "時間", minute: "分" }
+  return `${quantity}${units[unit] || unit}前`
+}
+
+export function daysAgoLabel(days) {
+  if (appLocale() !== "ja") return `${days} days ago`
+  return `${days}日前`
+}
+
+export function inDaysLabel(days) {
+  if (appLocale() !== "ja") return `in ${days} days`
+  return `あと${days}日`
+}
