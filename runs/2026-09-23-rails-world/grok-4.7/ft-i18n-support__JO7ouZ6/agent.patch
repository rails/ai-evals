diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..18a57c2
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,78 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :remember_locale_param
+    around_action :switch_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def remember_locale_param
+      if chosen = Localization.available_locale(params[:locale])
+        session[:locale] = chosen
+        persist_identity_locale(chosen)
+      end
+    end
+
+    def switch_locale
+      I18n.with_locale(resolved_locale) { yield }
+    end
+
+    def resolved_locale
+      if chosen = Localization.available_locale(params[:locale])
+        session[:locale] = chosen
+        persist_identity_locale(chosen)
+        return chosen
+      end
+
+      Localization.available_locale(session[:locale]) ||
+        Localization.available_locale(Current.identity&.locale) ||
+        I18n.default_locale
+    end
+
+    def persist_identity_locale(locale)
+      identity = Current.identity
+      return unless identity
+      return if identity.locale == locale
+
+      identity.update_column(:locale, locale)
+    end
+
+    def adopt_locale_for_identity
+      identity = Current.identity
+      return unless identity
+
+      if locale = Localization.available_locale(request.session[:locale])
+        persist_identity_locale(locale)
+      elsif locale = Localization.available_locale(identity.locale)
+        request.session[:locale] = locale
+      end
+    end
+
+    def tx(message, **interpolations)
+      Localization.translate(message, **interpolations)
+    end
+
+    def tx_pluralize(count, singular, plural = nil)
+      if I18n.locale.to_s == "en"
+        pluralize(count, singular, plural)
+      else
+        word = count.to_i == 1 ? singular : (plural || singular.pluralize)
+        tx("%{count} #{word}", count: count)
+      end
+    end
+
+    def localized_strftime(time, format)
+      return if time.blank?
+      return time.strftime(format) if I18n.locale.to_s == "en"
+
+      named = {
+        tx("%b %d, %Y") => :stamp,
+        tx("%b %e") => :abbr_stamp,
+        tx("%-l%P on %A, %B %-d") => :notification_since
+      }[format]
+
+      named ? I18n.l(time, format: named) : I18n.l(time, format: format)
+    end
+end
