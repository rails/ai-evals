diff --git a/lib/localization.rb b/lib/localization.rb
new file mode 100644
index 0000000..522085b
--- /dev/null
+++ b/lib/localization.rb
@@ -0,0 +1,37 @@
+module Localization
+  AVAILABLE = %w[en ja].freeze
+
+  module_function
+
+  def available_locale(value)
+    locale = value.to_s.downcase
+    AVAILABLE.include?(locale) ? locale : nil
+  end
+
+  def translate(message, **interpolations)
+    return message if message.nil?
+
+    original = message.to_s
+    locale = I18n.locale.to_s
+    translated = if locale == "en" || locale.blank?
+      original
+    else
+      strings.dig(locale, original) || original
+    end
+
+    interpolations.empty? ? translated : I18n.interpolate(translated, interpolations)
+  end
+
+  def strings
+    @strings ||= begin
+      path = Rails.root.join("config/locales/ja.json")
+      json = File.exist?(path) ? JSON.parse(File.read(path)) : {}
+      { "ja" => json }
+    end
+  end
+
+  def reload_strings!
+    @strings = nil
+    strings
+  end
+end
