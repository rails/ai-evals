diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..5d9f999
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "japanese query param switches the page and sticks in the session" do
+    untenanted { get new_session_path(locale: "ja") }
+
+    assert_response :success
+    assert_match "メインコンテンツへスキップ", response.body
+    assert_match "Fizzyに入る", response.body
+    assert_no_match "Get into Fizzy", response.body
+
+    untenanted { get new_session_path }
+    assert_response :success
+    assert_match "Fizzyに入る", response.body
+  end
+
+  test "unknown locale does not break the page or switch language" do
+    untenanted { get new_session_path(locale: "xx") }
+
+    assert_response :success
+    assert_match "Get into Fizzy", response.body
+    assert_no_match "Fizzyに入る", response.body
+  end
+
+  test "locale persists on the identity and is restored on the next sign in" do
+    sign_in_as :david
+    get root_path
+    get root_path(locale: "ja")
+    assert_equal "ja", identities(:david).reload.locale
+
+    sign_out
+    cookies.delete("session_token")
+    reset!
+
+    sign_in_as :david
+    get root_path
+    assert_match(/lang="ja"/, response.body)
+  end
+
+end
+
