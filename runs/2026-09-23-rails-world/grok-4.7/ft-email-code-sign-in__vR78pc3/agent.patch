@@ -0,0 +1,27 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "issues a six character code that authenticates for fifteen minutes" do
+    identity = identities(:kevin)
+
+    magic_link = MagicLink.issue(email_address: identity.email_address, purpose: :sign_in, identity: identity)
+
+    assert_equal MagicLink::CODE_LENGTH, magic_link.code.length
+    assert magic_link.authenticate_code(magic_link.code)
+    assert_equal magic_link, MagicLink.authenticate(magic_link.pending_token, magic_link.code.downcase)
+
+    travel MagicLink::EXPIRATION + 1.second do
+      assert_not magic_link.active?
+      assert_nil MagicLink.authenticate(magic_link.pending_token, magic_link.code)
+    end
+  end
+
+  test "sign up and join establish an identity" do
+    magic_link = MagicLink.create!(email_address: "fresh@example.com", purpose: :sign_up)
+
+    assert_difference -> { Identity.count }, 1 do
+      identity = magic_link.establish_identity
+      assert_equal "fresh@example.com", identity.email_address
+    end
+  end
+end
