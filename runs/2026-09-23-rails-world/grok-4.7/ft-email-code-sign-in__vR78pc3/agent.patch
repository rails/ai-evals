diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..fd22547
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,62 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  has_secure_password :code, validations: false, reset_token: false
+
+  belongs_to :identity, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+
+  normalizes :email_address, with: ->(value) { value.to_s.strip.downcase.presence }
+
+  validates :email_address, presence: true, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, :code_digest, presence: true
+
+  before_validation :generate_code, on: :create
+
+  def self.issue(email_address:, purpose:, identity: nil, join_code: nil)
+    create!(email_address: email_address, purpose: purpose, identity: identity, join_code: join_code).tap(&:deliver)
+  end
+
+  def self.authenticate(pending_token, submitted_code)
+    return if pending_token.blank? || submitted_code.blank?
+
+    magic_link = find_signed(pending_token, purpose: :pending_authentication)
+    return unless magic_link&.active?
+
+    normalized_code = submitted_code.to_s.gsub(/\s+/, "").upcase
+    magic_link if magic_link.authenticate_code(normalized_code)
+  end
+
+  def code=(value)
+    super(value.to_s.strip.upcase.presence)
+  end
+
+  def pending_token
+    signed_id(expires_in: EXPIRATION, purpose: :pending_authentication)
+  end
+
+  def active?
+    created_at >= EXPIRATION.ago
+  end
+
+  def deliver
+    MagicLinkMailer.authentication_code(email_address, code).deliver_later
+  end
+
+  def establish_identity
+    case purpose
+    when "sign_in"
+      identity || Identity.find_by(email_address: email_address)
+    else
+      identity || Identity.find_or_create_by!(email_address: email_address)
+    end
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH) if code.blank?
+    end
+end
