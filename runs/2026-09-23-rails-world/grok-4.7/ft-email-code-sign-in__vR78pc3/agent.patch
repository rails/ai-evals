+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "show" do
+    untenanted do
+      get session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "input[name=code]"
+  end
+
+  test "sign in with an emailed code" do
+    code = nil
+
+    untenanted do
+      code = request_email_code do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      assert_redirected_to session_magic_link_path
+      assert cookies[:pending_authentication_token].present?
+      assert_equal @identity.email_address, MagicLink.last.email_address
+      assert_equal "sign_in", MagicLink.last.purpose
+
+      assert_difference -> { Session.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "sign in via JSON" do
+    code = nil
+
+    untenanted do
+      code = request_email_code do
+        post session_path(format: :json), params: { email_address: "Kevin@37signals.com" }
+      end
+
+      assert_response :created
+      assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+
+      post session_magic_link_path(format: :json), params: { code: code.downcase }
+
+      assert_response :success
+      assert_equal cookies[:session_token], @response.parsed_body["session_token"]
+    end
+  end
+
+  test "code is in the email subject" do
+    untenanted do
+      request_email_code do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match(/\A[A-Z0-9]{6} /, email.subject)
+    assert_includes email.text_part.body.decoded, email.subject.split.first
+    assert_includes email.html_part.body.decoded, email.subject.split.first
+  end
+
+  test "code expires after fifteen minutes" do
+    code = nil
+
+    untenanted do
+      code = request_email_code do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      travel 15.minutes + 1.second do
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to session_magic_link_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "code still works just before fifteen minutes" do
+    code = nil
+
+    untenanted do
+      code = request_email_code do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      travel 14.minutes do
+        post session_magic_link_path, params: { code: code }
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "wrong code is rejected and can be retried" do
+    code = nil
+
+    untenanted do
+      code = request_email_code do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      post session_magic_link_path, params: { code: "NOPE00" }
+      assert_redirected_to session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "code cannot be reused" do
+    code = nil
+
+    untenanted do
+      code = request_email_code do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      delete session_path
+      post session_magic_link_path, params: { code: code }
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "invalid email is unprocessable when signups are open" do
+    untenanted do
+      assert_no_enqueued_emails do
+        post session_path, params: { email_address: "not-an-email" }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "unknown email starts signup when signups are open" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        request_email_code do
+          post session_path, params: { email_address: "new-person@example.com" }
+        end
+      end
+
+      assert_equal "sign_up", MagicLink.last.purpose
+
+      assert_difference -> { Identity.count }, 1 do
+        post session_magic_link_path, params: { code: ActionMailer::Base.deliveries.last.subject.split.first }
+      end
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "unknown email does not reveal whether an account exists when signups are closed" do
+    with_multi_tenant_mode(false) do
+      untenanted do
+        assert_no_enqueued_emails do
+          post session_path, params: { email_address: "missing@example.com" }
+        end
+
+        assert_redirected_to session_magic_link_path
+        follow_redirect!
+        assert_response :success
+        assert_no_match "missing@example.com", response.body
+      end
+    end
+  end
+
+  test "invalid code via JSON is unauthorized" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+      assert_response :unauthorized
+    end
+  end
+
+  test "submitting a code is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+      assert_response :too_many_requests
+    end
+  end
+
+  private
+    def request_email_code
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        yield
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_not_nil email
+      code = email.subject.split.first
+      assert_equal MagicLink::CODE_LENGTH, code.length
+      code
+    end
+end
