index 0000000..40a3c09
--- /dev/null
+++ b/app/views/sessions/magic_links/show.html.erb
@@ -0,0 +1,40 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+              maxlength: MagicLink::CODE_LENGTH, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <% if @magic_link %>
+      <p>We sent a six-character code to <strong><%= @magic_link.email_address %></strong>. Enter it to continue. It works for 15 minutes.</p>
+    <% else %>
+      <p>Enter the six-character code from your email. It works for 15 minutes.</p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle center">
+    <% if @magic_link&.sign_up? %>
+      <%= link_to "Use a different email", new_signup_path, class: "txt-link" %>
+    <% elsif @magic_link&.join? && @magic_link.join_code %>
+      <%= link_to "Use a different email", join_path(code: @magic_link.join_code.code, script_name: @magic_link.join_code.account.slug), class: "txt-link" %>
+    <% else %>
+      <%= link_to "Use a different email", new_session_path, class: "txt-link" %>
+    <% end %>
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
