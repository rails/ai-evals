diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..461b62b
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,84 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def show
+    @magic_link = MagicLink.find_signed(cookies.signed[:pending_authentication_token].to_s, purpose: :pending_authentication)
+  end
+
+  def create
+    magic_link = MagicLink.authenticate(cookies.signed[:pending_authentication_token], params[:code])
+
+    if magic_link && identity = magic_link.establish_identity
+      finish_sign_in magic_link, identity
+    else
+      reject_authentication
+    end
+  end
+
+  private
+    def finish_sign_in(magic_link, identity)
+      url, alert = completion_for(magic_link, identity)
+      magic_link.destroy!
+      start_new_session_for identity
+      cookies.delete :pending_authentication_token
+
+      respond_to do |format|
+        format.html { redirect_to url, **({ alert: alert }.compact) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def completion_for(magic_link, identity)
+      case magic_link.purpose
+      when "sign_up"
+        [ new_signup_completion_path, nil ]
+      when "join"
+        join_completion_for(magic_link, identity)
+      else
+        [ after_authentication_url, nil ]
+      end
+    end
+
+    def join_completion_for(magic_link, identity)
+      join_code = magic_link.join_code
+      return [ new_session_path, "That code didn't work. Try again." ] unless join_code
+
+      account = join_code.account
+
+      if join_code.active?
+        join_code.redeem_if { identity.join(account) }
+      end
+
+      user = User.active.find_by(account: account, identity: identity)
+
+      if user&.setup?
+        [ landing_url(script_name: account.slug), nil ]
+      elsif user
+        [ new_users_verification_url(script_name: account.slug), nil ]
+      else
+        [ join_path(code: join_code.code, script_name: account.slug), "That code is all used up" ]
+      end
+    end
+
+    def reject_authentication
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
