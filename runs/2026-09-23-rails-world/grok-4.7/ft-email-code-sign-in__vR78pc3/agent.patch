+class JoinCodesControllerEmailCodeTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "create sends a code and entering it joins a new person" do
+    assert_no_difference -> { Identity.count } do
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "joiner@example.com" }
+      end
+    end
+
+    assert_redirected_to session_magic_link_path(script_name: nil)
+    code = ActionMailer::Base.deliveries.last.subject.split.first
+
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_difference -> { User.count }, 1 do
+          post "/session/magic_link", params: { code: code }
+        end
+      end
+
+      assert_redirected_to new_users_verification_url(script_name: @account.slug)
+      assert cookies[:session_token].present?
+    end
+
+    identity = Identity.find_by!(email_address: "joiner@example.com")
+    assert identity.users.exists?(account: @account)
+  end
+
+  test "create sends a code for an existing identity that is not signed in" do
+    identity = identities(:mike)
+    assert_not identity.users.exists?(account: @account)
+
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+    end
+
+    code = ActionMailer::Base.deliveries.last.subject.split.first
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post "/session/magic_link", params: { code: code }
+      end
+
+      assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    end
+  end
+end
