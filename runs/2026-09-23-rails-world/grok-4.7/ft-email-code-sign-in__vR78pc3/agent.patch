--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,36 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def send_magic_link(email_address:, purpose:, identity: nil, join_code: nil)
+      magic_link = MagicLink.issue(
+        email_address: email_address,
+        purpose: purpose,
+        identity: identity,
+        join_code: join_code
+      )
+      set_pending_authentication_cookie magic_link.pending_token
+      respond_with_magic_link
+    end
+
+    def pretend_magic_link_sent
+      set_pending_authentication_cookie SecureRandom.uuid
+      respond_with_magic_link
+    end
+
+    def set_pending_authentication_cookie(token)
+      cookies.signed[:pending_authentication_token] = {
+        value: token,
+        httponly: true,
+        same_site: :lax,
+        expires: MagicLink::EXPIRATION.from_now
+      }
+    end
+
+    def respond_with_magic_link
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+      end
+    end
+end
