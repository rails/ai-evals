diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..896c129 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,49 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  const payload = event.data ? event.data.json() : {}
+  const title = payload.title || "Fizzy"
+  const options = {
+    body: payload.body || "",
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192.png",
+    tag: payload.tag,
+    renotify: Boolean(payload.tag),
+    data: { url: payload.url }
+  }
+
+  event.waitUntil(self.registration.showNotification(title, options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  const url = notificationUrl(event.notification)
+
+  event.waitUntil(openNotification(url))
+})
+
+function notificationUrl(notification) {
+  const url = notification.data && notification.data.url
+  if (!url) return self.location.origin + "/"
+
+  const destination = new URL(url, self.location.origin)
+  if (destination.origin === self.location.origin) return destination.href
+
+  return new URL(destination.pathname + destination.search + destination.hash, self.location.origin).href
+}
+
+async function openNotification(url) {
+  const windowClients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  for (const client of windowClients) {
+    if (new URL(client.url).origin !== self.location.origin) continue
+    if (!("navigate" in client)) continue
+
+    await client.focus()
+    return client.navigate(url)
+  }
+
+  return self.clients.openWindow(url)
+}
