diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..ab42d6f
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,119 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, get, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "status" ]
+  static values = {
+    publicKey: String,
+    subscriptionsUrl: String
+  }
+
+  connect() {
+    if (!this.#supported) return
+
+    this.#reflectPermission()
+  }
+
+  async turnOn() {
+    if (!this.#supported || !this.publicKeyValue) return
+
+    const permission = await Notification.requestPermission()
+    this.#reflectPermission(permission)
+    if (permission !== "granted") return
+
+    const subscription = await this.#subscribe()
+    if (await this.#store(subscription)) this.#markOn()
+  }
+
+  async turnOff() {
+    if (!this.#supported) return
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription) {
+      await this.#remove(subscription)
+      await subscription.unsubscribe()
+    }
+
+    this.element.classList.remove("notifications--on")
+  }
+
+  async #reflectPermission(permission = Notification.permission) {
+    if (permission === "denied") {
+      this.element.classList.add("notifications--blocked")
+      return
+    }
+
+    this.element.classList.remove("notifications--blocked")
+
+    if (permission === "granted") {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        this.#markOn()
+        this.#store(subscription)
+      }
+    }
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    const options = { userVisibleOnly: true, applicationServerKey: this.#applicationServerKey }
+
+    try {
+      return await registration.pushManager.subscribe(options)
+    } catch (error) {
+      const existing = await registration.pushManager.getSubscription()
+      if (existing) await existing.unsubscribe()
+      return registration.pushManager.subscribe(options)
+    }
+  }
+
+  async #store(subscription) {
+    const json = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: json.keys?.p256dh,
+          auth_key: json.keys?.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    return response.ok
+  }
+
+  async #remove(subscription) {
+    const response = await get(this.subscriptionsUrlValue, { responseKind: "json" })
+    if (!response.ok) return
+
+    const subscriptions = await response.json
+    const current = subscriptions.find((item) => item.endpoint === subscription.endpoint)
+    if (current) {
+      await destroy(`${this.subscriptionsUrlValue}/${current.id}`, { responseKind: "json" })
+    }
+  }
+
+  #markOn() {
+    this.element.classList.add("notifications--on")
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window && this.hasSubscriptionsUrlValue
+  }
+
+  get #applicationServerKey() {
+    return urlBase64ToUint8Array(this.publicKeyValue)
+  }
+}
+
+function urlBase64ToUint8Array(base64String) {
+  const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+  const raw = atob(base64)
+  return Uint8Array.from([...raw].map((char) => char.charCodeAt(0)))
+}
