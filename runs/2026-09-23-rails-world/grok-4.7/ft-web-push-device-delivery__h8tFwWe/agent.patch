diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..844c620
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @attributes = {
+      endpoint: "https://push.example.test/subscriptions/device-1",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    }
+  end
+
+  test "create stores the subscription the browser posted" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal @attributes[:endpoint], subscription.endpoint
+    assert_equal @attributes[:p256dh_key], subscription.p256dh_key
+    assert_equal @attributes[:auth_key], subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal subscription.id, response.parsed_body["id"]
+  end
+
+  test "create updates keys when the same device subscribes again" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes.merge(auth_key: "rotated") }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal "rotated", @user.push_subscriptions.last.auth_key
+  end
+
+  test "create rejects another person's user" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @attributes }, as: :json
+
+    assert_response :not_found
+    assert_equal 0, PushSubscription.count
+  end
+
+  test "destroy removes this device" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+    subscription = @user.push_subscriptions.last
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..6c21bab
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    @keys = { "VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key" }
+  end
+
+  test "a tray notification is pushed with the tray copy and the card url" do
+    notification = notifications(:logo_assignment_kevin)
+    sent = nil
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).with { |args| sent = args; true }
+
+      perform_enqueued_jobs do
+        notification.update!(source: events(:logo_published), creator: users(:david), read_at: nil, unread_count: notification.unread_count + 1)
+      end
+    end
+
+    assert sent, "expected a web push to be sent"
+    message = JSON.parse(sent[:message])
+
+    assert_equal ApplicationController.helpers.notification_title(notification.reload), message["title"]
+    assert_equal ApplicationController.helpers.notification_body(notification), message["body"]
+    assert_includes message["url"], "/cards/#{notification.card.number}"
+    assert_equal @subscription.endpoint, sent[:endpoint]
+    assert_equal @subscription.p256dh_key, sent[:p256dh]
+    assert_equal @subscription.auth_key, sent[:auth]
+    assert_equal "public-key", sent[:vapid][:public_key]
+    assert_equal "private-key", sent[:vapid][:private_key]
+  end
+
+  test "creating a notification pushes it too" do
+    notifications(:layout_commented_kevin).destroy!
+    sent = false
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).with { sent = true }
+
+      perform_enqueued_jobs do
+        Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+      end
+    end
+
+    assert sent
+  end
+
+  test "reading a notification does not push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).never
+
+      perform_enqueued_jobs do
+        notification.read
+      end
+    end
+  end
+
+  test "an expired subscription is removed" do
+    response = Struct.new(:body).new("gone")
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(notifications(:logo_assignment_kevin))
+      end
+    end
+  end
+
+  test "nothing is sent when vapid keys are not configured" do
+    WebPush.expects(:payload_send).never
+
+    perform_enqueued_jobs do
+      notifications(:logo_assignment_kevin).update!(source: events(:logo_published), creator: users(:david), read_at: nil)
+    end
+  end
+
+  private
+    def with_vapid_keys
+      previous = @keys.keys.index_with { |key| ENV[key] }
+      @keys.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous.each { |key, value| ENV[key] = value }
+    end
+end
