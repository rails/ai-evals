diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..9858c53
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,49 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+
+  def index
+    @push_subscriptions = @user.push_subscriptions.order(created_at: :desc)
+  end
+
+  def create
+    @push_subscription = PushSubscription.register(user: @user, **push_subscription_attributes)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on for this device" }
+      format.json { render :show, status: @push_subscription.previously_new_record? ? :created : :ok }
+    end
+  end
+
+  def destroy
+    subscription.destroy!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned off for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+      head :not_found unless @user.identity_id == Current.identity&.id
+    end
+
+    def push_subscription_attributes
+      push_subscription_params.to_h.symbolize_keys
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def subscription
+      if endpoint = params[:endpoint].presence || params.dig(:push_subscription, :endpoint)
+        @user.push_subscriptions.find_by!(endpoint: endpoint)
+      else
+        @user.push_subscriptions.find(params[:id])
+      end
+    end
+end
