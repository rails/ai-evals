diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..b15d18f
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,59 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  before_validation :set_endpoint_digest
+
+  class << self
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+
+    def vapid_subject
+      ENV["VAPID_SUBJECT"].presence || "mailto:support@fizzy.do"
+    end
+
+    def register(user:, endpoint:, p256dh_key:, auth_key:)
+      endpoint = endpoint.to_s.strip
+      subscription = user.push_subscriptions.find_or_initialize_by(endpoint: endpoint)
+      subscription.account = user.account
+      subscription.p256dh_key = p256dh_key
+      subscription.auth_key = auth_key
+      subscription.save!
+      subscription
+    rescue ActiveRecord::RecordNotUnique
+      user.push_subscriptions.find_by!(endpoint: endpoint).tap do |existing|
+        existing.update!(p256dh_key: p256dh_key, auth_key: auth_key)
+      end
+    end
+  end
+
+  def deliver(notification)
+    if self.class.configured?
+      WebPush.payload_send(
+        message: notification.push_payload.to_json,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: {
+          subject: self.class.vapid_subject,
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        },
+        urgency: "high",
+        ssl_timeout: 5,
+        open_timeout: 5,
+        read_timeout: 5
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s.strip)
+    end
+end
