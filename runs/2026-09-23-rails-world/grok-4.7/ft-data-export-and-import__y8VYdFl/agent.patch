diff --git a/app/models/account/data_transfer/rich_text.rb b/app/models/account/data_transfer/rich_text.rb
new file mode 100644
index 0000000..0653b1e
--- /dev/null
+++ b/app/models/account/data_transfer/rich_text.rb
@@ -0,0 +1,62 @@
+class Account::DataTransfer::RichText
+  class << self
+    def resign(body, account:)
+      new(body, account: account).resign
+    end
+  end
+
+  def initialize(body, account:)
+    @body = body.to_s
+    @account = account
+  end
+
+  def resign
+    return @body if @body.blank? || @account.nil?
+
+    @body.gsub(/<action-text-attachment\b([^>]*)>/) do
+      attrs = $1
+      sgid = attrs[/sgid=["']([^"']+)["']/, 1]
+      record = locate(sgid)
+
+      if record
+        attrs = replace_attr(attrs, "sgid", record.attachable_sgid)
+        attrs = replace_attr(attrs, "url", blob_path(record)) if record.is_a?(ActiveStorage::Blob)
+      end
+
+      "<action-text-attachment#{attrs}>"
+    end
+  end
+
+  private
+    def locate(sgid)
+      gid = gid_from_sgid(sgid)
+      return if gid.blank?
+
+      GlobalID::Locator.locate(gid)
+    rescue ActiveRecord::RecordNotFound, NameError
+      nil
+    end
+
+    def gid_from_sgid(sgid)
+      return if sgid.blank?
+
+      payload, = sgid.split("--", 2)
+      decoded = JSON.parse(Base64.urlsafe_decode64(payload))
+      data = decoded.dig("_rails", "data") || decoded["gid"]
+      data.to_s.split("?").first.presence
+    rescue ArgumentError, JSON::ParserError
+      nil
+    end
+
+    def replace_attr(attrs, name, value)
+      if attrs.match?(/#{name}=["'][^"']*["']/)
+        attrs.sub(/#{name}=["'][^"']*["']/, %(#{name}="#{value}"))
+      else
+        %(#{attrs} #{name}="#{value}")
+      end
+    end
+
+    def blob_path(blob)
+      Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true, script_name: @account.slug)
+    end
+end
