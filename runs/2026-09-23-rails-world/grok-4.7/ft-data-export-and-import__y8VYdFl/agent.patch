--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,40 @@
+class Account::DataTransfer::Exporter
+  VERSION = 1
+
+  def initialize(export)
+    @export = export
+  end
+
+  def write(zip)
+    zip.add_file("manifest.json", JSON.generate(manifest))
+
+    if export.kind_account?
+      Account::DataTransfer::Manifest.new(export.account).each_record_set do |record_set|
+        record_set.export_to(zip)
+      end
+
+      write_cards(zip, export.account.cards, write_files: false)
+    else
+      write_cards(zip, export.user.accessible_cards, write_files: true)
+    end
+  end
+
+  private
+    attr_reader :export
+
+    def manifest
+      {
+        version: VERSION,
+        kind: export.kind,
+        account_id: export.account_id,
+        account_name: export.account.name,
+        exported_at: Time.current.iso8601
+      }
+    end
+
+    def write_cards(zip, cards, write_files:)
+      cards.includes(:board, :column, :creator, :tags, image_attachment: :blob, comments: :creator).find_each do |card|
+        Account::DataTransfer::CardSerializer.new(card).write(zip, write_files: write_files)
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/extractor_io.rb b/app/models/account/data_transfer/extractor_io.rb
new file mode 100644
index 0000000..1337871
--- /dev/null
+++ b/app/models/account/data_transfer/extractor_io.rb
@@ -0,0 +1,66 @@
+# A readable IO over a ZipKit extractor so storage services can stream large files
+# without loading them into memory.
+class Account::DataTransfer::ExtractorIO
+  def initialize(extractor, size)
+    @extractor = extractor
+    @size = size.to_i
+    @buffer = +"".b
+    @read = 0
+  end
+
+  def size
+    @size
+  end
+
+  def eof?
+    @buffer.empty? && @read >= @size
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      data = @buffer.dup
+      @buffer.clear
+      until @read >= @size
+        chunk = pull(1.megabyte)
+        break if chunk.nil?
+
+        data << chunk
+      end
+      @read = @size
+      return fill(outbuf, data)
+    end
+
+    while @buffer.bytesize < length && @read < @size
+      chunk = pull([ length - @buffer.bytesize, 1.megabyte ].max)
+      break if chunk.nil?
+    end
+
+    taken = @buffer.byteslice(0, length) || +"".b
+    @buffer = @buffer.byteslice(taken.bytesize..) || +"".b
+    return if taken.empty?
+
+    fill(outbuf, taken)
+  end
+
+  private
+    def pull(length)
+      return if @extractor.eof?
+
+      chunk = @extractor.extract(length)
+      return if chunk.nil? || chunk.bytesize.zero?
+
+      chunk = chunk.b
+      @read += chunk.bytesize
+      @buffer << chunk
+      chunk
+    end
+
+    def fill(outbuf, data)
+      if outbuf
+        outbuf.replace(data)
+        outbuf
+      else
+        data
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..5af78c2
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,145 @@
+class Account::DataTransfer::Importer
+  def initialize(import)
+    @import = import
+    @uploaded_keys = []
+  end
+
+  def perform
+    account = nil
+    committed = false
+
+    with_archive do |archive|
+      manifest = archive.manifest
+      validate!(manifest)
+
+      Account.transaction do
+        Account::DataTransfer::Manifest.new(nil).each_record_set do |record_set|
+          record_set.import_from(archive, uploaded_keys: @uploaded_keys)
+        end
+
+        account = Account.find(manifest["account_id"])
+        ActiveStorage::VariantRecord.where(account_id: account.id).delete_all
+        create_join_code(account)
+        ensure_importer_access(account)
+      end
+
+      committed = true
+    end
+
+    finalize(account)
+    account
+  rescue
+    cleanup_uploads unless committed
+    raise
+  end
+
+  def finalize(account)
+    return if account.nil?
+
+    account.reconcile_storage
+    reindex(account)
+  rescue => error
+    Rails.logger.error("Import finalize failed for account #{account.id}: #{error.class}: #{error.message}")
+  end
+
+  private
+    attr_reader :import
+
+    def with_archive
+      blob = import.file.blob
+      service = blob.service
+
+      if service.respond_to?(:path_for)
+        File.open(service.path_for(blob.key), "rb") do |io|
+          yield Account::DataTransfer::Archive.new(io)
+        end
+      else
+        url = blob.url(expires_in: 12.hours, disposition: :attachment)
+        yield Account::DataTransfer::Archive.new(ZipKit::RemoteIO.new(url))
+      end
+    end
+
+    def validate!(manifest)
+      unless manifest["version"] == Account::DataTransfer::Exporter::VERSION
+        raise Account::DataTransfer::Error, "This export was made by a different version of Fizzy and can't be imported."
+      end
+
+      unless manifest["kind"] == "account"
+        raise Account::DataTransfer::Error, "This file isn't a full account export. Card downloads can't be imported as an account."
+      end
+
+      if manifest["account_id"].blank?
+        raise Account::DataTransfer::Error, "This file isn't a Fizzy account export."
+      end
+    end
+
+    def create_join_code(account)
+      Account::JoinCode.create!(account: account) unless Account::JoinCode.exists?(account_id: account.id)
+    end
+
+    def ensure_importer_access(account)
+      identity = import.identity
+      return if identity.nil?
+      return if User.exists?(account_id: account.id, identity_id: identity.id)
+
+      now = Time.current
+      user_id = ActiveRecord::Type::Uuid.generate
+      role = User.exists?(account_id: account.id, role: "owner") ? "admin" : "owner"
+
+      User.insert_all!([ {
+        id: user_id,
+        account_id: account.id,
+        identity_id: identity.id,
+        name: identity.email_address,
+        role: role,
+        active: true,
+        verified_at: now,
+        created_at: now,
+        updated_at: now
+      } ])
+
+      User::Settings.insert_all!([ {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: account.id,
+        user_id: user_id,
+        bundle_email_frequency: User::Settings.bundle_email_frequencies[:every_few_hours],
+        created_at: now,
+        updated_at: now
+      } ])
+
+      board_ids = Board.where(account_id: account.id, all_access: true).pluck(:id)
+      return if board_ids.empty?
+
+      Access.insert_all!(board_ids.map { |board_id|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          board_id: board_id,
+          user_id: user_id,
+          involvement: "access_only",
+          created_at: now,
+          updated_at: now
+        }
+      })
+    end
+
+    def reindex(account)
+      Current.with_account(account) do
+        account.cards.find_each do |card|
+          card.reindex if card.published?
+        end
+
+        Comment.where(account_id: account.id).find_each do |comment|
