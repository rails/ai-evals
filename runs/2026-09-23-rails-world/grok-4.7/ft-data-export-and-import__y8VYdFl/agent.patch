+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "signed in user can open the import page" do
+    sign_in_as :david
+
+    get new_account_import_path
+    assert_response :success
+    assert_match "Import an account", response.body
+  end
+
+  test "import page is available at /account/imports/new without an account prefix" do
+    sign_in_as :david
+
+    untenanted do
+      get "/account/imports/new"
+      assert_response :success
+    end
+  end
+
+  test "import requires a file" do
+    sign_in_as :david
+
+    post account_imports_path
+    assert_response :unprocessable_entity
+  end
+
+  test "signed in user can submit an account file" do
+    sign_in_as :david
+
+    file = Rack::Test::UploadedFile.new(StringIO.new("zip"), "application/zip", original_filename: "account.zip")
+
+    assert_enqueued_with(job: Account::ImportJob) do
+      post account_imports_path, params: { file: file }
+    end
+
+    assert_redirected_to new_account_import_path
+    assert Import.last.file.attached?
+  end
+end
diff --git a/test/models/account/data_transfer/roundtrip_test.rb b/test/models/account/data_transfer/roundtrip_test.rb
new file mode 100644
index 0000000..7ec9548
--- /dev/null
+++ b/test/models/account/data_transfer/roundtrip_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Account::DataTransfer::RoundtripTest < ActiveSupport::TestCase
+  setup do
+    @identity = Identity.create!(email_address: "exporter-#{SecureRandom.hex(4)}@example.com")
+    @account = Account.create_with_owner(
+      account: { name: "Exportable" },
+      owner: { name: "Owner Person", identity: @identity }
+    )
+
+    Current.with_account(@account) do
+      @owner = @account.users.find_by!(role: :owner)
+      Current.user = @owner
+      @board = @account.boards.create!(name: "Roadmap", creator: @owner, all_access: true)
+      @column = @board.columns.create!(name: "Now", color: "var(--color-card-1)")
+      @card = @board.cards.create!(
+        title: "Ship export",
+        status: "published",
+        creator: @owner,
+        column: @column,
+        last_active_at: Time.current
+      )
+      @card.image.attach(io: StringIO.new("png-bytes"), filename: "shot.png", content_type: "image/png")
+
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("notes-bytes"),
+        filename: "notes.txt",
+        content_type: "text/plain"
+      )
+      @comment = @card.comments.create!(
+        creator: @owner,
+        body: %(<div>See <action-text-attachment sgid="#{blob.attachable_sgid}" filename="notes.txt"></action-text-attachment></div>)
+      )
+    end
+  end
+
+  test "account export zip contains card json, comments, and files" do
+    export = export_account
+    export.process
+
+    entries = zip_entries(export)
+    card_entry = entries.find { |entry| entry.filename == "cards/#{@card.number}.json" }
+    assert card_entry, "expected card JSON in the export"
+
+    card_json = JSON.parse(extract(export, card_entry))
+    assert_equal "Ship export", card_json["title"]
+    assert_equal 1, card_json["comments"].size
+    assert card_json["image"]["path"].start_with?("files/")
+    assert entries.any? { |entry| entry.filename == card_json["image"]["path"] }
+    assert entries.any? { |entry| entry.filename == "accounts.jsonl" }
+    assert_equal "account", JSON.parse(extract(export, entries.find { |entry| entry.filename == "manifest.json" }))["kind"]
+  end
+
+  test "import restores boards, cards, comments, files, and people into a new account" do
+    export = export_account
+    export.process
+    original_external_id = @account.external_account_id
+    zip_path = ActiveStorage::Blob.service.path_for(export.file.blob.key)
+    zip_copy = Tempfile.new([ "import", ".zip" ])
+    IO.copy_stream(zip_path, zip_copy.path)
+
+    destroy_account(@account)
+    export.destroy!
+
+    import = nil
+    Current.with_account(accounts(:"37s")) do
+      import = accounts(:"37s").imports.create!(identity: identities(:jason))
+      import.file.attach(io: File.open(zip_copy.path), filename: "account.zip", content_type: "application/zip")
+    end
+
+    assert_difference -> { Account.count }, 1 do
+      import.process
+    end
+
+    imported = import.reload.created_account
+    assert_not_equal original_external_id, imported.external_account_id
+    assert_equal "Exportable", imported.name
+    assert imported.boards.exists?(name: "Roadmap")
+    card = imported.cards.find_by!(title: "Ship export")
+    assert_equal 1, card.comments.count
+    assert card.image.attached?
+    assert_equal "png-bytes", card.image.download
+    assert_includes card.comments.first.body.to_s, "action-text-attachment"
+    assert imported.users.joins(:identity).exists?(identities: { email_address: @identity.email_address })
+    assert imported.join_code.present?
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:jason).email_address ], mail.to
+    assert_match "ready", mail.subject
+  end
+
+  test "a failed import leaves no account behind" do
+    importer = identities(:kevin)
+    before = Account.pluck(:id)
+
+    import = nil
+    Current.with_account(accounts(:"37s")) do
+      import = accounts(:"37s").imports.create!(identity: importer)
+      import.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip")
+    end
+
+    assert_no_difference -> { Account.count } do
+      import.process
+    end
+
+    assert import.reload.failed?
+    assert_equal before.sort, Account.pluck(:id).sort
+    assert_match "valid Fizzy export", import.error_message
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ importer.email_address ], mail.to
+    assert_match import.error_message, mail.body.encoded
+  end
+
+  test "card export only includes cards the user can see" do
+    outsider = Identity.create!(email_address: "outsider-#{SecureRandom.hex(4)}@example.com")
+    hidden_board = nil
+
+    Current.with_account(@account) do
+      Current.user = @owner
+      member = @account.users.create!(name: "Member", identity: outsider, role: :member, verified_at: Time.current)
+      hidden_board = @account.boards.create!(name: "Secret", creator: @owner, all_access: false)
+      hidden_board.cards.create!(title: "Hidden card", status: "published", creator: @owner, last_active_at: Time.current)
+      @board.accesses.grant_to([ member ])
+
+      export = @account.exports.create!(user: member, kind: :cards)
+      export.process
+
+      entries = zip_entries(export)
+      card_files = entries.select { |entry| entry.filename.start_with?("cards/") }
+      titles = card_files.map { |entry| JSON.parse(extract(export, entry))["title"] }
+      assert_includes titles, "Ship export"
+      assert_not_includes titles, "Hidden card"
+      assert_equal "cards", JSON.parse(extract(export, entries.find { |entry| entry.filename == "manifest.json" }))["kind"]
+    end
+  end
+
+  private
+    def export_account
+      Current.with_account(@account) do
+      Current.user = @owner
+        export = @account.exports.create!(user: @owner, kind: :account)
+        export
+      end
+    end
+
+    def zip_entries(export)
+      File.open(ActiveStorage::Blob.service.path_for(export.file.blob.key), "rb") do |io|
+        ZipKit::FileReader.read_zip_structure(io: io)
+      end
+    end
+
+    def extract(export, entry)
+      File.open(ActiveStorage::Blob.service.path_for(export.file.blob.key), "rb") do |io|
+        reader = entry.extractor_from(io)
+        buffer = +"".b
+        until reader.eof?
+          buffer << reader.extract(64.kilobytes)
+        end
+        buffer
+      end
+    end
+
+    def destroy_account(account)
+      ActiveStorage::Attachment.where(account_id: account.id).find_each do |attachment|
+        attachment.purge
+      end
+      account.destroy!
+    end
+end
