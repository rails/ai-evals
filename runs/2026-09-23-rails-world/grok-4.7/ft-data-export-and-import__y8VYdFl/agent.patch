diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..6098568
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "admin can request an account export" do
+    sign_in_as :kevin
+
+    assert_enqueued_with(job: Account::ExportJob) do
+      post account_exports_path, params: { kind: "account" }
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.kind
+  end
+
+  test "members cannot export the whole account" do
+    sign_in_as :david
+
+    assert_no_enqueued_jobs do
+      post account_exports_path, params: { kind: "account" }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "anyone can export the cards they can see and download them for a day" do
+    sign_in_as :david
+
+    assert_enqueued_with(job: Account::ExportJob) do
+      post account_exports_path, params: { kind: "cards" }
+    end
+
+    export = Export.last
+    perform_enqueued_jobs only: Account::ExportJob
+    export.reload
+
+    assert export.ready?
+    assert export.expires_at <= 1.day.from_now + 1.minute
+    assert export.file.attached?
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ users(:david).identity.email_address ], mail.to
+    assert_match "day", mail.body.encoded
+
+    download = URI.parse(mail.body.encoded[/http[^"\s]+/]).request_uri
+    get download
+    assert_response :redirect
+
+    travel 2.days do
+      get download
+      assert_response :gone
+    end
+  end
+
+  test "profile page offers a card download" do
+    sign_in_as :david
+    get user_path(users(:david))
+    assert_response :success
+    assert_match "Download my cards", response.body
+  end
+
+  test "account settings offers an export to admins" do
+    sign_in_as :kevin
+    get account_settings_path
+    assert_response :success
+    assert_match "Export account", response.body
+    assert_match "Import an account", response.body
+  end
+end
