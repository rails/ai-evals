+++ b/app/models/export.rb
@@ -0,0 +1,49 @@
+class Export < ApplicationRecord
+  LINK_TTL = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :kind, %w[ account cards ].index_by(&:itself), prefix: :kind
+  enum :status, %w[ pending processing ready failed ].index_by(&:itself)
+
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  def process
+    Current.with_account(account) do
+      build_archive
+      update!(status: :ready, expires_at: LINK_TTL.from_now, error_message: nil)
+      ExportMailer.ready(self).deliver_now
+    end
+  rescue => error
+    update!(status: :failed, error_message: error.message.to_s.truncate(5_000))
+    ExportMailer.failed(self).deliver_now if user.identity
+  end
+
+  def downloadable?
+    ready? && file.attached? && expires_at&.future?
+  end
+
+  def download_id
+    signed_id(purpose: :download, expires_at: expires_at)
+  end
+
+  private
+    def build_archive
+      update!(status: :processing, error_message: nil)
+
+      ZipFile.create_for(file, filename: archive_filename) do |zip|
+        Account::DataTransfer::Exporter.new(self).write(zip)
+      end
+    end
+
+    def archive_filename
+      if kind_account?
+        "#{account.name.parameterize.presence || "account"}-export.zip"
+      else
+        "cards-export.zip"
+      end
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..d74d4a3
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,38 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  belongs_to :created_account, class_name: "Account", optional: true
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself)
+
+  def process
+    return if completed?
+
+    update!(status: :processing, error_message: nil)
+    created = Account::DataTransfer::Importer.new(self).perform
+    update!(status: :completed, created_account: created, error_message: nil)
+    ImportMailer.completed(self).deliver_now
+  rescue Account::DataTransfer::Error => error
+    fail_with(error.message)
+  rescue ActiveRecord::RecordNotUnique
+    fail_with("The import conflicts with data already on this Fizzy, so it couldn't be completed.")
+  rescue => error
+    if completed?
+      Rails.logger.error("Import notification failed: #{error.class}: #{error.message}")
+    else
+      Rails.error.report(error) if defined?(Rails.error)
+      fail_with(error.message.presence || "The import couldn't be completed.")
+    end
+  end
+
+  private
+    def fail_with(message)
+      created = created_account
+      reload
+      update!(status: :failed, error_message: message.to_s.truncate(5_000), created_account_id: nil)
+      created.destroy if created&.persisted? && Account.exists?(created.id)
+      ImportMailer.failed(self).deliver_now
+    end
+end
