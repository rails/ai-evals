@@ -0,0 +1,36 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+
+  def new
+  end
+
+  def create
+    account = import_account
+
+    if account.nil?
+      redirect_to session_menu_path(script_name: nil), alert: "You need an account before you can import one."
+      return
+    end
+
+    if params[:file].blank?
+      @error = "Choose an account export to import."
+      render :new, status: :unprocessable_entity
+      return
+    end
+
+    import = nil
+
+    Current.with_account(account) do
+      import = account.imports.create!(identity: Current.identity)
+      import.file.attach(params[:file])
+    end
+
+    Account::ImportJob.perform_later(import)
+    redirect_to new_account_import_path, notice: "We'll email you when the import is done, or if it failed and why."
+  end
+
+  private
+    def import_account
+      Current.account || Current.identity.accounts.active.first
+    end
+end
