index 0000000..c2c71b6
--- /dev/null
+++ b/app/models/account/data_transfer/card_serializer.rb
@@ -0,0 +1,94 @@
+class Account::DataTransfer::CardSerializer
+  def initialize(card)
+    @card = card
+  end
+
+  def write(zip, write_files:)
+    blobs.each do |blob|
+      next unless write_files
+
+      zip.add_file(file_path(blob), compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+
+    zip.add_file("cards/#{card.number}.json", JSON.generate(as_json))
+  end
+
+  private
+    attr_reader :card
+
+    def as_json
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        created_at: card.created_at&.iso8601,
+        updated_at: card.updated_at&.iso8601,
+        last_active_at: card.last_active_at&.iso8601,
+        board: { id: card.board_id, name: card.board.name },
+        column: card.column && { id: card.column_id, name: card.column.name },
+        creator: user_json(card.creator),
+        tags: card.tags.map(&:title).sort,
+        image: (card.image.attached? ? file_json(card.image.blob) : nil),
+        attachments: embed_blobs(card.description).map { |blob| file_json(blob) },
+        comments: card.comments.chronologically.map { |comment| comment_json(comment) }
+      }
+    end
+
+    def comment_json(comment)
+      {
+        id: comment.id,
+        created_at: comment.created_at&.iso8601,
+        updated_at: comment.updated_at&.iso8601,
+        body: comment.body.to_plain_text,
+        body_html: comment.body.to_s,
+        creator: user_json(comment.creator),
+        attachments: embed_blobs(comment.body).map { |blob| file_json(blob) }
+      }
+    end
+
+    def user_json(user)
+      return unless user
+
+      {
+        id: user.id,
+        name: user.name,
+        email_address: user.identity&.email_address
+      }
+    end
+
+    def file_json(blob)
+      return unless blob
+
+      {
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: file_path(blob)
+      }
+    end
+
+    def file_path(blob)
+      "files/#{blob.id}"
+    end
+
+    def blobs
+      list = []
+      list << card.image.blob if card.image.attached?
+      list.concat(embed_blobs(card.description))
+      card.comments.each do |comment|
+        list.concat(embed_blobs(comment.body))
+      end
+      list.uniq
+    end
+
+    def embed_blobs(rich_text)
+      return [] if rich_text.blank?
+
+      rich_text.embeds.filter_map { |embed| embed.blob if embed.respond_to?(:blob) }
+    end
+end
