diff --git a/app/models/account/data_transfer/archive.rb b/app/models/account/data_transfer/archive.rb
new file mode 100644
index 0000000..c10c2e7
--- /dev/null
+++ b/app/models/account/data_transfer/archive.rb
@@ -0,0 +1,59 @@
+class Account::DataTransfer::Archive
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD
+    raise Account::DataTransfer::Error, "This file isn't a valid Fizzy export."
+  end
+
+  def manifest
+    raw = read("manifest.json")
+    raise Account::DataTransfer::Error, "This file isn't a Fizzy export." if raw.blank?
+
+    JSON.parse(raw)
+  rescue JSON::ParserError
+    raise Account::DataTransfer::Error, "This file isn't a Fizzy export."
+  end
+
+  def read(path)
+    entry = @entries[path]
+    return unless entry
+
+    buffer = +"".b
+    reader = entry.extractor_from(@io)
+
+    until reader.eof?
+      chunk = reader.extract(1.megabyte)
+      break if chunk.nil? || chunk.bytesize.zero?
+
+      buffer << chunk
+    end
+
+    buffer
+  end
+
+  def each_line(path)
+    contents = read(path)
+    return unless contents
+
+    contents.force_encoding(Encoding::UTF_8).each_line do |line|
+      line = line.strip
+      yield line if line.present?
+    end
+  end
+
+  def each_file
+    @entries.each do |filename, entry|
+      next unless filename.start_with?("files/")
+
+      blob_id = filename.delete_prefix("files/")
+      next if blob_id.blank? || blob_id.include?("/")
+
+      yield blob_id, entry
+    end
+  end
+
+  def extractor_io(entry)
+    Account::DataTransfer::ExtractorIO.new(entry.extractor_from(@io), entry.uncompressed_size)
+  end
+end
diff --git a/app/models/account/data_transfer/card_serializer.rb b/app/models/account/data_transfer/card_serializer.rb
