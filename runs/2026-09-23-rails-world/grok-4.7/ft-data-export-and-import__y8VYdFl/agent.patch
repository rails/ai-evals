index 0000000..7144089
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,37 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_can_export, only: :create
+  allow_unauthenticated_access only: :show
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, kind: export_kind)
+    Account::ExportJob.perform_later(export)
+
+    redirect_back fallback_location: fallback_path, notice: "We'll email you a download link when it's ready. The link works for a day."
+  end
+
+  def show
+    export = Export.find_signed(params[:id], purpose: :download)
+
+    if export&.downloadable?
+      redirect_to rails_blob_url(export.file, disposition: :attachment, expires_in: 10.minutes), allow_other_host: true
+    else
+      render plain: "This download link has expired.", status: :gone
+    end
+  end
+
+  private
+    def ensure_can_export
+      if export_kind == "account" && !Current.user.admin?
+        head :forbidden
+      end
+    end
+
+    def export_kind
+      kind = params[:kind].presence || "account"
+      kind.in?(%w[account cards]) ? kind : "account"
+    end
+
+    def fallback_path
+      export_kind == "cards" ? user_path(Current.user) : account_settings_path
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
