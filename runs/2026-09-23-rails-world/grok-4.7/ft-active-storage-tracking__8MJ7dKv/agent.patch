new file mode 100644
index 0000000..b927ac2
--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,34 @@
+module Account::Storage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    super.to_i
+  end
+
+  def refresh_bytes_used_later
+    version = Storage.next_version_for(self)
+    Account::RefreshStorageJob.perform_later(self, version) if version
+  end
+
+  # Account usage is the sum of board counters. Those counters are what the
+  # background jobs recalculate, so an account with many boards does not
+  # rescan every attachment.
+  def refresh_bytes_used(version)
+    return unless Storage.current_version?(self, version)
+
+    current = boards.sum(:bytes_used).to_i
+
+    with_lock do
+      return unless storage_version == version
+
+      update_columns(bytes_used: current) if bytes_used != current
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  def reconcile_storage
+    boards.find_each(&:reconcile_bytes_used)
+    update_columns(bytes_used: boards.sum(:bytes_used).to_i)
+  end
+end
