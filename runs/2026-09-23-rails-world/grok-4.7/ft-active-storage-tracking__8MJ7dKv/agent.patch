diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..2ceb43c
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,84 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :refresh_account_bytes_used_later
+  end
+
+  def bytes_used
+    super.to_i
+  end
+
+  def refresh_bytes_used_later
+    version = Storage.next_version_for(self)
+    Board::RefreshStorageJob.perform_later(self, version) if version
+  end
+
+  def refresh_bytes_used(version)
+    return unless Storage.current_version?(self, version)
+
+    current = calculate_bytes_used
+
+    changed = false
+    with_lock do
+      return unless storage_version == version
+
+      changed = bytes_used != current
+      update_columns(bytes_used: current) if changed
+    end
+
+    refresh_account_bytes_used_later if changed
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  # Synchronous recount used after imports, which insert attachments
+  # without callbacks, and to backfill existing boards.
+  def reconcile_bytes_used
+    current = calculate_bytes_used
+    with_lock do
+      update_columns(bytes_used: current) if bytes_used != current
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  private
+    def refresh_account_bytes_used_later
+      account = Account.find_by(id: account_id)
+      account&.refresh_bytes_used_later
+    end
+
+    # Distinct blobs, so a file embedded twice on the same board is stored once.
+    # Subqueries keep this to a single aggregate even when a board has a lot of files.
+    def calculate_bytes_used
+      ActiveStorage::Blob.where(id: counted_attachments.select(:blob_id)).sum(:byte_size).to_i
+    end
+
+    def counted_attachments
+      card_image_attachments.or(embedded_file_attachments)
+    end
+
+    def card_image_attachments
+      ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: cards.select(:id))
+    end
+
+    def embedded_file_attachments
+      ActiveStorage::Attachment.where(
+        record_type: "ActionText::RichText",
+        name: "embeds",
+        record_id: counted_rich_text_ids
+      )
+    end
+
+    def counted_rich_text_ids
+      ActionText::RichText.where(record_type: "Board", record_id: id, name: "public_description")
+        .or(ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description"))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids, name: "body"))
+        .select(:id)
+    end
+
+    def comment_ids
+      Comment.where(card_id: cards.select(:id)).select(:id)
+    end
+end
