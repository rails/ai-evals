diff --git a/test/models/storage_test.rb b/test/models/storage_test.rb
new file mode 100644
index 0000000..aeb241c
--- /dev/null
+++ b/test/models/storage_test.rb
@@ -0,0 +1,206 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "bytes used starts at zero when nothing countable is attached" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "card images, descriptions, comments, and board descriptions are counted in the background" do
+    image_size = 120
+    description_size = 30
+    comment_size = 40
+    board_size = 50
+
+    track_storage do
+      @card.image.attach(io: StringIO.new("a" * image_size), filename: "cover.png", content_type: "image/png")
+      @card.update!(description: embed_html(blob_with_size(description_size)))
+      @card.comments.create!(creator: users(:david), body: embed_html(blob_with_size(comment_size)))
+      @board.update!(public_description: embed_html(blob_with_size(board_size)))
+    end
+
+    expected = image_size + description_size + comment_size + board_size
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+  end
+
+  test "bytes used stays stale until the background refresh runs" do
+    @card.image.attach(io: StringIO.new("a" * 80), filename: "cover.png", content_type: "image/png")
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+
+    drain_storage_jobs
+
+    assert_equal 80, @board.reload.bytes_used
+    assert_equal 80, @account.reload.bytes_used
+  end
+
+  test "removing a card image releases its bytes" do
+    track_storage do
+      @card.image.attach(io: StringIO.new("a" * 64), filename: "cover.png", content_type: "image/png")
+    end
+    assert_equal 64, @board.reload.bytes_used
+
+    track_storage do
+      @card.image.purge
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "replacing an embedded file counts only the new file" do
+    track_storage do
+      @card.update!(description: embed_html(blob_with_size(25)))
+    end
+    assert_equal 25, @board.reload.bytes_used
+
+    track_storage do
+      @card.update!(description: embed_html(blob_with_size(70)))
+    end
+
+    assert_equal 70, @board.reload.bytes_used
+    assert_equal 70, @account.reload.bytes_used
+  end
+
+  test "moving a card moves its usage between boards without changing the account" do
+    track_storage do
+      @card.image.attach(io: StringIO.new("a" * 90), filename: "cover.png", content_type: "image/png")
+      @card.update!(description: embed_html(blob_with_size(10)))
+    end
+
+    assert_equal 100, @board.reload.bytes_used
+    assert_equal 0, @other_board.reload.bytes_used
+
+    track_storage do
+      @card.move_to(@other_board)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 100, @other_board.reload.bytes_used
+    assert_equal 100, @account.reload.bytes_used
+  end
+
+  test "destroying a card or board drops its usage from the account" do
+    track_storage do
+      @card.image.attach(io: StringIO.new("a" * 55), filename: "cover.png", content_type: "image/png")
+    end
+    assert_equal 55, @account.reload.bytes_used
+
+    track_storage do
+      @card.destroy
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+
+    other_card = cards(:shipping)
+    track_storage do
+      other_card.image.attach(io: StringIO.new("b" * 33), filename: "cover.png", content_type: "image/png")
+    end
+    assert_equal 33, @account.reload.bytes_used
+
+    track_storage do
+      @board.destroy
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "avatars and files on other boards or accounts are not counted" do
+    other_account = accounts(:initech)
+    other_account_board = boards(:miltons_wish_list)
+    private_card = @other_board.cards.create!(title: "Private", creator: users(:kevin), status: "published", last_active_at: Time.current)
+
+    track_storage do
+      blob = blob_with_size(200)
+      ActiveStorage::Attachment.create!(record: users(:david), name: "avatar", blob: blob)
+
+      private_card.image.attach(io: StringIO.new("a" * 15), filename: "other.png", content_type: "image/png")
+
+      Current.account = other_account
+      other_account_board.cards.first.image.attach(io: StringIO.new("a" * 500), filename: "radio.png", content_type: "image/png")
+    end
+
+    assert_equal 15, @other_board.reload.bytes_used
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 15, @account.reload.bytes_used
+    assert_equal 500, other_account.reload.bytes_used
+  end
+
+  test "the same blob embedded twice on a board is stored once" do
+    blob = blob_with_size(42)
+
+    track_storage do
+      @card.update!(description: embed_html(blob))
+      @card.comments.create!(creator: users(:david), body: embed_html(blob))
+    end
+
+    assert_equal 42, @board.reload.bytes_used
+    assert_equal 42, @account.reload.bytes_used
+  end
+
+  test "refreshing storage does not touch the board" do
+    @card.image.attach(io: StringIO.new("a" * 21), filename: "cover.png", content_type: "image/png")
+    updated_at = @board.reload.updated_at
+
+    drain_storage_jobs
+
+    assert_equal 21, @board.reload.bytes_used
+    assert_equal updated_at, @board.updated_at
+  end
+
+  test "a burst of uploads settles on the combined total" do
+    cards = @board.cards.limit(4).to_a
+
+    track_storage do
+      cards.each_with_index do |card, i|
+        card.image.attach(io: StringIO.new("a" * (10 + i)), filename: "f.png", content_type: "image/png")
+      end
+    end
+
+    assert_equal 10 + 11 + 12 + 13, @board.reload.bytes_used
+    assert_equal @board.bytes_used, @account.reload.bytes_used
+  end
+
+  private
+    STORAGE_JOBS = [ Board::RefreshStorageJob, Account::RefreshStorageJob ]
+
+    def track_storage
+      saved_account = Current.account
+      perform_enqueued_jobs only: STORAGE_JOBS do
+        Current.account = saved_account
+        yield
+      end
+      drain_storage_jobs
+    end
+
+    def drain_storage_jobs
+      5.times do
+        break unless enqueued_jobs.any? { |job| STORAGE_JOBS.include?(job[:job]) }
+
+        perform_enqueued_jobs only: STORAGE_JOBS
+      end
+    end
+
+    def blob_with_size(bytes)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("a" * bytes),
+        filename: "file-#{bytes}.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def embed_html(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
