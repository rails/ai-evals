--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,33 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    # after_create_commit does not fire for attachments saved through the
+    # parent record, so remember the board on create/destroy and refresh on
+    # the commit callback that does run.
+    after_create :prepare_counted_storage_refresh
+    before_destroy :prepare_counted_storage_refresh
+    after_commit :refresh_counted_storage_later
+  end
+
+  # purge/purge_later delete the row without destroy callbacks.
+  def delete
+    board = Storage.board_for(self)
+    result = super
+    board&.refresh_bytes_used_later
+    result
+  end
+
+  private
+    def prepare_counted_storage_refresh
+      @counted_storage_board = Storage.board_for(self)
+      @refresh_counted_storage = true
+    end
+
+    def refresh_counted_storage_later
+      return unless @refresh_counted_storage
+
+      @refresh_counted_storage = false
+      @counted_storage_board&.refresh_bytes_used_later
+    end
+end
