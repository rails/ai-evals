+class Board::RefreshStorageJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # One scan per board at a time. Older generations no-op, so a burst of
+  # uploads still costs a single recount.
+  limits_concurrency to: 1, key: ->(board, _version) { board }, duration: 15.minutes
+
+  def perform(board, version)
+    board.refresh_bytes_used(version)
+  end
+end
