new file mode 100644
index 0000000..d2f4014
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,73 @@
+class Webhook::Payload
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  include Rails.application.routes.url_helpers
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def body
+    @body ||= if webhook.for_slack?
+      { text: chat_text }.to_json
+    elsif webhook.for_campfire? || webhook.for_basecamp?
+      { content: chat_text }.to_json
+    else
+      json_body
+    end
+  end
+
+  def url_options
+    @url_options ||= begin
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        { host: "localhost" }
+      options.merge(script_name: event.account.slug)
+    end
+  end
+
+  def headers
+    {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+      "X-Webhook-Signature" => signature
+    }
+  end
+
+  private
+    attr_reader :webhook, :event
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def json_body
+      ActiveStorage::Current.set(url_options: url_options) do
+        renderer.render(template: "webhooks/event", formats: [ :json ], assigns: { event: event })
+      end
+    end
+
+    def chat_text
+      sentence = CGI.unescapeHTML(event.description_for(nil).to_plain_text.to_str)
+      url = polymorphic_url(event.eventable, **url_options) if event.eventable
+      [ sentence, url ].compact.join(" ")
+    end
+
+    def renderer
+      ApplicationController.renderer.new(
+        http_host: http_host,
+        https: url_options[:protocol].to_s == "https",
+        script_name: event.account.slug
+      )
+    end
+
+    def http_host
+      if url_options[:port]
+        "#{url_options[:host]}:#{url_options[:port]}"
+      else
+        url_options[:host]
+      end
+    end
+end
