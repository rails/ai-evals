@@ -29,4 +56,72 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    # A delivery is posted at most once. A retried job sees a non-pending state and skips the POST.
+    def claim
+      with_lock do
+        if pending?
+          in_progress!
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def transmit(body, headers)
+      code = post(body, headers)
+      update!(state: :completed, response: { code: code, error: nil })
+
+      if succeeded?
+        webhook.record_delivery_success
+      else
+        webhook.record_delivery_failure
+      end
+    rescue StandardError => error
+      Rails.logger.info("Webhook delivery #{id} failed: #{error.class}: #{error.message}")
+      record_failure("destination_unreachable")
+    end
+
+    def record_failure(error)
+      update!(state: :errored, response: { error: error })
+      webhook.record_delivery_failure
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      ip = public_ip_for(uri)
+      raise "destination unreachable" if ip.blank?
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+      http.write_timeout = 10 if http.respond_to?(:write_timeout=)
+
+      request = Net::HTTP::Post.new(uri.request_uri.presence || "/")
+      headers.each { |key, value| request[key] = value }
+      request.body = body
+
+      http.request(request).code.to_i
+    end
+
+    def public_ip_for(uri)
+      return if uri.host.blank?
+
+      if literal_ip?(uri.host)
+        uri.host unless SsrfProtection.blocked_address?(uri.host)
+      else
+        SsrfProtection.resolve_public_ip(uri.host)
+      end
+    end
+
+    def literal_ip?(host)
+      IPAddr.new(host)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
 end
