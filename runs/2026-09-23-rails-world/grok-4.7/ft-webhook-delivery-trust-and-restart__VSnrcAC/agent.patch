+++ b/app/models/event/relaying.rb
@@ -0,0 +1,43 @@
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :remember_relaying_suppression
+    after_create_commit :relay_later
+  end
+
+  class_methods do
+    def suppress
+      previous = Thread.current[:event_relaying_suppressed]
+      Thread.current[:event_relaying_suppressed] = true
+      yield
+    ensure
+      Thread.current[:event_relaying_suppressed] = previous
+    end
+
+    def suppressed?
+      Thread.current[:event_relaying_suppressed] == true
+    end
+  end
+
+  def relay_later
+    return if relaying_suppressed?
+
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    board.webhooks.active.find_each do |webhook|
+      webhook.deliver(self)
+    end
+  end
+
+  private
+    def remember_relaying_suppression
+      @relaying_suppressed = self.class.suppressed?
+    end
+
+    def relaying_suppressed?
+      self.class.suppressed? || @relaying_suppressed
+    end
+end
