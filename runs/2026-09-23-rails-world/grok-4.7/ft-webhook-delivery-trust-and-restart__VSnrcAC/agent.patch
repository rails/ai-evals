--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,34 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    with_lock do
+      if consecutive_failures_count != 0 || first_failure_at.present?
+        update!(consecutive_failures_count: 0, first_failure_at: nil)
+      end
+    end
+  end
+
+  def record_failure
+    with_lock do
+      now = Time.current
+
+      if first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+        self.consecutive_failures_count = 1
+        self.first_failure_at = now
+      else
+        self.consecutive_failures_count += 1
+      end
+
+      save!
+
+      if consecutive_failures_count >= FAILURE_LIMIT
+        webhook.deactivate
+      end
+    end
+  end
+end
