@@ -0,0 +1,12 @@
+class Board::CalculateStorageUsageJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # One scan per board at a time. Stale versions no-op; the current version
+  # does the aggregate. Waiting beats discarding so a burst cannot drop the
+  # calculation that still needs to run.
+  limits_concurrency to: 1, key: ->(board, _version) { board }, duration: 5.minutes
+
+  def perform(board, version)
+    board.calculate_storage_usage(version)
+  end
+end
