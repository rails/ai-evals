--- /dev/null
+++ b/app/models/card/storage.rb
@@ -0,0 +1,33 @@
+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    # Remember the move before Card#handle_board_change saves again. That
+    # nested update replaces saved_changes, so an after_commit check of
+    # saved_change_to_board_id? would miss the move.
+    after_update :remember_board_change_for_storage
+    after_update_commit :calculate_storage_usage_for_board_change_later, if: :board_changed_for_storage?
+  end
+
+  private
+    def remember_board_change_for_storage
+      if saved_change_to_board_id?
+        @previous_board_id_for_storage = board_id_before_last_save
+      end
+    end
+
+    def board_changed_for_storage?
+      @previous_board_id_for_storage.present?
+    end
+
+    def calculate_storage_usage_for_board_change_later
+      previous_board_id = @previous_board_id_for_storage
+      @previous_board_id_for_storage = nil
+
+      if previous_board = Board.find_by(id: previous_board_id)
+        previous_board.calculate_storage_usage_later
+      end
+
+      board.calculate_storage_usage_later
+    end
+end
diff --git a/app/models/storage/attachment_tracking.rb b/app/models/storage/attachment_tracking.rb
new file mode 100644
index 0000000..d40a78c
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,69 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_boards
+    after_create_commit :track_storage_increase_later
+    after_destroy_commit :track_storage_decrease_later
+  end
+
+  # purge, purge_later, and detach remove the row with delete, which skips
+  # destroy callbacks. Capture the boards first, then schedule the recount
+  # only if the surrounding transaction commits.
+  def delete
+    boards = storage_boards
+    super.tap { track_storage_later(boards) }
+  end
+
+  private
+    def track_storage_increase_later
+      track_storage_later(storage_boards)
+    end
+
+    def track_storage_decrease_later
+      track_storage_later(@storage_boards || storage_boards)
+    end
+
+    def remember_storage_boards
+      @storage_boards = storage_boards
+    end
+
+    def track_storage_later(boards)
+      return if boards.blank?
+
+      ActiveRecord.after_all_transactions_commit do
+        boards.each(&:calculate_storage_usage_later)
+      end
+    end
+
+    def storage_boards
+      ids = storage_board_ids
+      return [] if ids.empty?
+
+      Board.where(id: ids).to_a
+    end
+
+    def storage_board_ids
+      case record_type
+      when "Card"
+        name == "image" ? [ record&.board_id ] : []
+      when "ActionText::RichText"
+        name == "embeds" ? [ board_id_for_rich_text(record) ] : []
+      else
+        []
+      end.compact
+    end
+
+    def board_id_for_rich_text(rich_text)
+      return if rich_text.nil?
+
+      case rich_text.record
+      when Board
+        rich_text.record_id
+      when Card
+        rich_text.record.board_id
+      when Comment
+        rich_text.record.card.board_id
+      end
+    end
+end
