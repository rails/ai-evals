diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..2d2d563
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,80 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :calculate_account_storage_usage_later
+  end
+
+  # Reads the latest total written by Board::CalculateStorageUsageJob.
+  def bytes_used
+    ApplicationRecord.connected_to(role: :writing) do
+      self.class.where(id: id).pick(:bytes_used).to_i
+    end
+  end
+
+  # Bumps a version so in-flight calculations cannot overwrite newer ones,
+  # then enqueues a single cheap no-op for every stale version. Only the job
+  # whose version is still current scans attachments, so bursts of uploads
+  # from many users collapse into one calculation.
+  def calculate_storage_usage_later
+    updated = self.class.where(id: id).update_all("storage_version = storage_version + 1")
+    return unless updated == 1
+
+    version = self.class.where(id: id).pick(:storage_version)
+    Board::CalculateStorageUsageJob.perform_later(self, version)
+  end
+
+  def calculate_storage_usage(version)
+    return unless current_storage_version == version
+
+    bytes = computed_bytes_used
+    self.class.where(id: id, storage_version: version).update_all(bytes_used: bytes)
+
+    if current_storage_version == version
+      account.calculate_storage_usage
+    elsif latest = current_storage_version
+      Board::CalculateStorageUsageJob.perform_later(self, latest)
+    end
+  end
+
+  def computed_bytes_used
+    card_image_bytes + board_description_bytes + card_description_bytes + comment_bytes
+  end
+
+  private
+    def calculate_account_storage_usage_later
+      Account::CalculateStorageUsageJob.perform_later(account)
+    end
+
+    def current_storage_version
+      self.class.where(id: id).pick(:storage_version)
+    end
+
+    def card_image_bytes
+      blob_bytes_for(record_type: "Card", name: "image", record_id: cards.unscope(:order).select(:id))
+    end
+
+    def board_description_bytes
+      rich_text_embed_bytes(record_type: "Board", name: "public_description", record_id: id)
+    end
+
+    def card_description_bytes
+      rich_text_embed_bytes(record_type: "Card", name: "description", record_id: cards.unscope(:order).select(:id))
+    end
+
+    def comment_bytes
+      comment_ids = Comment.where(card_id: cards.unscope(:order).select(:id)).select(:id)
+      rich_text_embed_bytes(record_type: "Comment", name: "body", record_id: comment_ids)
+    end
+
+    def rich_text_embed_bytes(record_type:, name:, record_id:)
+      rich_text_ids = ActionText::RichText.where(record_type:, name:, record_id:).select(:id)
+      blob_bytes_for(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+    end
+
+    def blob_bytes_for(record_type:, name:, record_id:)
+      ActiveStorage::Blob.joins(:attachments).where(
+        active_storage_attachments: { record_type:, name:, record_id: }
+      ).sum("active_storage_blobs.byte_size").to_i
+    end
+end
