diff --git a/app/models/account/storage.rb b/app/models/account/storage.rb
new file mode 100644
index 0000000..6d16395
--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,36 @@
+module Account::Storage
+  extend ActiveSupport::Concern
+
+  REFRESH_ATTEMPTS = 5
+
+  # Reads the latest background-calculated total. The heavy scan lives on
+  # boards; an account total is the sum of those cached board totals.
+  def bytes_used
+    ApplicationRecord.connected_to(role: :writing) do
+      self.class.where(id: id).pick(:bytes_used).to_i
+    end
+  end
+
+  def calculate_storage_usage
+    mark_storage_changed
+    refresh_bytes_used_from_boards
+  end
+
+  def mark_storage_changed
+    self.class.where(id: id).update_all("storage_version = storage_version + 1")
+  end
+
+  def refresh_bytes_used_from_boards
+    REFRESH_ATTEMPTS.times do
+      version = self.class.where(id: id).pick(:storage_version)
+      total = boards.sum(:bytes_used).to_i
+      self.class.where(id: id, storage_version: version).update_all(bytes_used: total)
+
+      # Compare versions rather than rows-affected: SQLite reports 0 when the
+      # value does not change, which is not a conflict.
+      return if self.class.where(id: id).pick(:storage_version) == version
+    end
+
+    Account::CalculateStorageUsageJob.perform_later(self)
+  end
+end
