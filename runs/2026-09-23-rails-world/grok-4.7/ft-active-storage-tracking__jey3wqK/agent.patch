diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..15ce146
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+    @image = file_fixture("moon.jpg")
+    @image_bytes = @image.size
+  end
+
+  test "bytes used starts at zero and ignores unrelated files" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    users(:david).avatar.attach(io: @image.open, filename: "avatar.jpg", content_type: "image/jpeg")
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("orphan"), filename: "orphan.txt", content_type: "text/plain")
+    calculate_storage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "card images are counted on the board and the account" do
+    @card.image.attach(io: @image.open, filename: "moon.jpg", content_type: "image/jpeg")
+    calculate_storage
+
+    assert_equal @image_bytes, @board.bytes_used
+    assert_equal @image_bytes, @account.bytes_used
+    assert_equal 0, @other_board.bytes_used
+  end
+
+  test "replacing or purging a card image updates the total" do
+    @card.image.attach(io: StringIO.new("small"), filename: "small.txt", content_type: "text/plain")
+    calculate_storage
+    assert_equal 5, @board.bytes_used
+
+    @card.image.attach(io: StringIO.new("a much larger file"), filename: "large.txt", content_type: "text/plain")
+    calculate_storage
+    assert_equal "a much larger file".bytesize, @board.bytes_used
+    assert_equal "a much larger file".bytesize, @account.bytes_used
+
+    @card.image.purge_later
+    calculate_storage
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "files embedded in card descriptions, comments, and board descriptions are counted" do
+    card_blob = upload("card-file")
+    comment_blob = upload("comment-file")
+    board_blob = upload("board-file")
+
+    @card.update!(description: attachment_html(card_blob))
+    @card.comments.create!(body: attachment_html(comment_blob), creator: users(:david))
+    @board.update!(public_description: attachment_html(board_blob))
+    calculate_storage
+
+    expected = card_blob.byte_size + comment_blob.byte_size + board_blob.byte_size
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+  end
+
+  test "removing an embedded file decreases usage" do
+    blob = upload("notes")
+    @card.update!(description: attachment_html(blob))
+    calculate_storage
+    assert_equal blob.byte_size, @board.bytes_used
+
+    @card.update!(description: "No file anymore")
+    calculate_storage
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "moving a card moves its usage between boards without changing the account" do
+    @card.image.attach(io: StringIO.new("card-image"), filename: "image.txt", content_type: "text/plain")
+    blob = upload("described")
+    @card.update!(description: attachment_html(blob))
+    @card.comments.create!(body: attachment_html(upload("commented")), creator: users(:david))
+    calculate_storage
+
+    expected = @board.bytes_used
+    assert_operator expected, :>, 0
+    assert_equal expected, @account.bytes_used
+
+    @card.move_to(@other_board)
+    calculate_storage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal expected, @other_board.bytes_used
+    assert_equal expected, @account.bytes_used
+  end
+
+  test "destroying a card, comment, or board releases its usage" do
+    @card.image.attach(io: StringIO.new("keep-me"), filename: "keep.txt", content_type: "text/plain")
+    other_card = @other_board.cards.create!(title: "Other", creator: users(:david), status: "published", last_active_at: Time.current)
+    other_card.image.attach(io: StringIO.new("other"), filename: "other.txt", content_type: "text/plain")
+    comment = @card.comments.create!(body: attachment_html(upload("comment")), creator: users(:david))
+    calculate_storage
+
+    comment.destroy!
+    calculate_storage
+    assert_equal "keep-me".bytesize, @board.bytes_used
+
+    @card.destroy!
+    calculate_storage
+    assert_equal 0, @board.bytes_used
+    assert_equal "other".bytesize, @account.bytes_used
+
+    @other_board.destroy!
+    calculate_storage
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "usage stays current for many attachments without loading them into memory" do
+    blobs = 25.times.map { |index| upload("file-#{index}") }
+    html = blobs.map { |blob| attachment_html(blob) }.join
+    @card.update!(description: html)
+    calculate_storage
+
+    assert_equal blobs.sum(&:byte_size), @board.bytes_used
+    assert_equal blobs.sum(&:byte_size), @account.bytes_used
+    assert_equal @board.computed_bytes_used, @board.bytes_used
+  end
+
+  private
+    def calculate_storage
+      perform_enqueued_jobs only: [ Board::CalculateStorageUsageJob, Account::CalculateStorageUsageJob ]
+      perform_enqueued_jobs only: [ Board::CalculateStorageUsageJob, Account::CalculateStorageUsageJob ]
+    end
+
+    def upload(contents)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new(contents), filename: "#{contents}.txt", content_type: "text/plain")
+    end
+
+    def attachment_html(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
