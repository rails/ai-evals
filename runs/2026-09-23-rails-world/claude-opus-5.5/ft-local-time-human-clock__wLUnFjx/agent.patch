+
+// "Thursday, September 12"
+export function formatWeekday(date) {
+  return formatter({ weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+// "9/12/25, 1:42 PM"
+export function formatDateTime(date) {
+  return formatter({ dateStyle: "short", timeStyle: "short" }).format(date)
+}
+
+// "Thursday, September 12, 2025 at 1:42 PM"
+export function formatLongDateTime(date) {
+  return formatter({ dateStyle: "full", timeStyle: "short" }).format(date)
+}
+
+// "1:42 PM" today, "yesterday", "5 days ago" within the week, "Sep 12" beyond
+export function formatAgo(date, now = new Date()) {
+  const days = signedDifferenceInDays(date, now)
+
+  if (days < 1) {
+    return formatTime(date)
+  } else if (days === 1) {
+    return "yesterday"
+  } else if (days < 7) {
+    return `${days} days ago`
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+// "today", "yesterday", "5 days ago", "3 months ago", "2 years ago"
+export function formatDaysAgo(date, now = new Date()) {
+  const days = signedDifferenceInDays(date, now)
+
+  if (days < 1) {
+    return "today"
+  } else if (days === 1) {
+    return "yesterday"
+  } else if (days < 31) {
