diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..c65214b
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,97 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatAgo, formatDate, formatDateTime, formatDaysAgo, formatFullDate,
+  formatInDays, formatLongDateTime, formatTime, formatWeekday
+} from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute
+
+const FORMATTERS = {
+  time: formatTime,         // "1:42 PM"
+  date: formatDate,         // "Sep 12"
+  fulldate: formatFullDate, // "Sep 12, 2025"
+  weekday: formatWeekday,   // "Thursday, September 12"
+  datetime: formatDateTime, // "9/12/25, 1:42 PM"
+  ago: formatAgo,           // "1:42 PM", "yesterday", "5 days ago", "Sep 12"
+  daysago: formatDaysAgo,   // "today", "yesterday", "5 days ago", "3 months ago"
+  indays: formatInDays      // "today", "tomorrow", "in 3 days"
+}
+
+// Renders server-provided timestamps (<time datetime="…">) in the viewer's own
+// timezone, so the server never bakes a timezone into (cacheable) HTML.
+//
+// Render the elements with TimeHelper#local_datetime_tag.
+export default class extends Controller {
+  static targets = Object.keys(FORMATTERS)
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(this.refresh, REFRESH_INTERVAL)
+
+    document.addEventListener("visibilitychange", this.#refreshOnVisible)
+    document.addEventListener("turbo:morph", this.refresh)
+    document.addEventListener("turbo:frame-load", this.refresh)
+    document.addEventListener("turbo:before-stream-render", this.#refreshAfterStreamRender)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+
+    document.removeEventListener("visibilitychange", this.#refreshOnVisible)
+    document.removeEventListener("turbo:morph", this.refresh)
+    document.removeEventListener("turbo:frame-load", this.refresh)
+    document.removeEventListener("turbo:before-stream-render", this.#refreshAfterStreamRender)
+  }
+
+  timeTargetConnected(element) { this.#render(element, "time") }
+  dateTargetConnected(element) { this.#render(element, "date") }
+  fulldateTargetConnected(element) { this.#render(element, "fulldate") }
+  weekdayTargetConnected(element) { this.#render(element, "weekday") }
+  datetimeTargetConnected(element) { this.#render(element, "datetime") }
+  agoTargetConnected(element) { this.#render(element, "ago") }
+  daysagoTargetConnected(element) { this.#render(element, "daysago") }
+  indaysTargetConnected(element) { this.#render(element, "indays") }
+
+  refresh = () => {
+    for (const style of Object.keys(FORMATTERS)) {
+      for (const element of this[`${style}Targets`]) {
+        this.#render(element, style)
+      }
+    }
+  }
+
+  #refreshOnVisible = () => {
+    if (document.visibilityState === "visible") this.refresh()
+  }
+
+  // Morphing stream actions can reset an element's contents without
+  // reconnecting it as a target, so re-render once the stream is applied.
+  #refreshAfterStreamRender = (event) => {
+    const render = event.detail.render
+
+    event.detail.render = async (streamElement) => {
+      await render(streamElement)
+      this.refresh()
+    }
+  }
+
+  #render(element, style) {
+    const date = this.#parse(element)
+    if (!date) return
+
+    const text = FORMATTERS[style](date)
+    if (element.textContent !== text) element.textContent = text
+
+    const title = formatLongDateTime(date)
+    if (element.getAttribute("title") !== title) element.setAttribute("title", title)
+  }
+
+  #parse(element) {
+    const value = element.getAttribute("datetime")
+    if (!value) return null
+
+    const date = new Date(value)
+    return isNaN(date) ? null : date
+  }
+}
