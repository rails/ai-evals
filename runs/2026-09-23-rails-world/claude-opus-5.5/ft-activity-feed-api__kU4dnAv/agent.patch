@@ -0,0 +1,28 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Event.activity.where(board: boards).preloaded.reverse_chronologically
+      events = events.where(creator_id: creator_ids) if params[:creator_ids].present?
+      events
+    end
+
+    def boards
+      if params[:board_ids].present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
