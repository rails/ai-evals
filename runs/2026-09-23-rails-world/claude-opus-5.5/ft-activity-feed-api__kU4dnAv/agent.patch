@@ -0,0 +1,53 @@
+# Activities
+
+Activities are the events that make up an account's timeline: cards being added, assigned, moved, renamed, closed, and commented on.
+
+## `GET /:account_slug/activities`
+
+Returns account activity visible to the current user, newest first. Only activity on boards the current user has access to is returned.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Only return activity created by these users |
+| `board_ids[]` | Only return activity on these boards |
+
+The returned actions are: `card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, and `comment_created`.
+
+`eventable` is a [card](cards.md) when `eventable_type` is `Card`, and a [comment](comments.md) when it is `Comment`. `url` opens the card, or for comments, opens the card at the comment.
+
+`particulars` contains event-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| Others | `{}` |
+
+Missing board, title, or column values are returned as empty strings.
+
+This endpoint is [paginated](../README.md#pagination).
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03axlzd1s35zo2fvpwh6amek2",
+    "action": "card_assigned",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David assigned JZ to &quot;Layout is broken&quot;",
+    "particulars": {
+      "assignee_ids": ["03axm5wipv7jz0p6hm7887igt"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2",
+    "eventable_type": "Card",
+    "eventable": { "id": "03aynd0o4ephqf5pyy81quef7", "number": 2, "title": "Layout is broken", "...": "..." },
+    "board": { "id": "03ayv6mp60xg3aqes0m9sa68w", "name": "Writebook", "...": "..." },
+    "creator": { "id": "03azfurjljx3onhc5w51s9r6h", "name": "David", "...": "..." }
+  }
+]
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..8e01b63
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+    assert_response :success
+
+    body = @response.parsed_body
+    assert_kind_of Array, body
+    assert body.any?
+
+    created_ats = body.map { it["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+
+    body.each do |event|
+      %w[ id action created_at description particulars url eventable_type eventable board creator ].each do |key|
+        assert event.key?(key), "missing #{key}"
+      end
+      assert_includes Event::ACTIVITY_ACTIONS, event["action"]
+    end
+  end
+
+  test "event attributes" do
+    get activities_path, as: :json
+
+    event = events(:logo_assignment_jz)
+    json = @response.parsed_body.find { it["id"] == event.id }
+    assert_equal "card_assigned", json["action"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, json["particulars"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, json["description"]
+    assert_equal card_url(event.card), json["url"]
+    assert_equal "Card", json["eventable_type"]
+    assert_equal event.card.id, json.dig("eventable", "id")
+    assert_equal event.board.id, json.dig("board", "id")
+    assert_equal users(:david).id, json.dig("creator", "id")
+
+    json = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+    assert_equal({}, json["particulars"])
+  end
+
+  test "comment events link to the comment" do
+    get activities_path, as: :json
+
+    event = events(:layout_commented)
+    json = @response.parsed_body.find { it["id"] == event.id }
+    assert_equal "Comment", json["eventable_type"]
+    assert_equal card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), json["url"]
+  end
+
+  test "title changes are included, collection changes are not" do
+    card = cards(:logo)
+    title_event = Event.create!(board: card.board, creator: users(:david), eventable: card, action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old", new_title: "New" } })
+    collection_event = Event.create!(board: card.board, creator: users(:david), eventable: card, action: "card_collection_changed",
+      particulars: { particulars: { new_collection: "X" } })
+    board_event = Event.create!(board: card.board, creator: users(:david), eventable: card, action: "card_board_changed",
+      particulars: { particulars: { new_board: "B" } })
+    triage_event = Event.create!(board: card.board, creator: users(:david), eventable: card, action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+    ids = @response.parsed_body.map { it["id"] }
+
+    assert_includes ids, title_event.id
+    assert_not_includes ids, collection_event.id
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, @response.parsed_body.find { it["id"] == title_event.id }["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "B" }, @response.parsed_body.find { it["id"] == board_event.id }["particulars"])
+    assert_equal({ "column" => "" }, @response.parsed_body.find { it["id"] == triage_event.id }["particulars"])
+  end
+
+  test "filter by creators and boards" do
+    get activities_path, params: { creator_ids: [ users(:david).id ] }, as: :json
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { it.dig("creator", "id") == users(:david).id }
+
+    board = boards(:writebook)
+    get activities_path, params: { board_ids: [ board.id ] }, as: :json
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { it.dig("board", "id") == board.id }
+  end
+
+  test "only accessible boards" do
+    get activities_path, as: :json
+    board_ids = @response.parsed_body.map { it.dig("board", "id") }.uniq
+    assert (board_ids - users(:kevin).boards.ids).empty?
+
+    inaccessible = Board.where.not(id: users(:kevin).boards.ids).first
+    if inaccessible
+      get activities_path, params: { board_ids: [ inaccessible.id ] }, as: :json
+      assert_equal [], @response.parsed_body
+    end
+  end
+end
