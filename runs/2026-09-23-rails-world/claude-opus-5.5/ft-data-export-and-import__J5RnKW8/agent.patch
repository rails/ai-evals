--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,28 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if file = import_file
+      import = Account::Import.start(identity: Current.identity, file: file)
+      redirect_to account_import_path(import)
+    else
+      redirect_to new_account_import_path, alert: "Choose a Fizzy account export (.zip) to import."
+    end
+  end
+
+  def show
+    @import = Current.identity.account_imports.find(params[:id])
+  end
+
+  private
+    def import_file
+      params.dig(:import, :file).presence.then do |file|
+        file if file.respond_to?(:original_filename)
+      end
+    end
+end
