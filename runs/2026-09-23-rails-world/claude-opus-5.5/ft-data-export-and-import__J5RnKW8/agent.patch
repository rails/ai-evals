+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  test "contains the cards the user can see, with comments and files" do
+    user = users(:david)
+    card = user.accessible_cards.published.first
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png")
+    card.comments.create!(creator: user, body: "Look <action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment>")
+
+    export = user.data_exports.create!(account: user.account)
+    export.build
+
+    Tempfile.create([ "export", ".zip" ], binmode: true) do |file|
+      file.write(export.file.download)
+      file.rewind
+      zip = ZipFile::Reader.new(file)
+
+      assert_equal user.accessible_cards.published.map { "cards/#{it.number}.json" }.sort, zip.glob("cards/*.json")
+
+      data = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, data["title"]
+      assert_equal card.board.name, data["board"]
+      assert_equal card.comments.count, data["comments"].size
+
+      assert_equal "cards/#{card.number}/moon.jpg", data["image"]["path"]
+      assert_equal file_fixture("moon.jpg").binread, zip.read(data["image"]["path"])
+
+      comment = data["comments"].find { it["body"].start_with?("Look") }
+      assert_equal "avatar.png", comment["attachments"].first["filename"]
+      assert_equal file_fixture("avatar.png").binread, zip.read(comment["attachments"].first["path"])
+    end
+  end
+
+  test "doesn't contain cards the user can't see" do
+    user = users(:david)
+    board, hidden = with_current_user(:kevin) do
+      board = Board.create!(name: "Secret", all_access: false)
+      [ board, board.cards.create!(title: "Secret plans", status: :published) ]
+    end
+    assert_not user.accessible_cards.include?(hidden)
+
+    export = user.data_exports.create!(account: user.account)
+    export.build
+
+    Tempfile.create([ "export", ".zip" ], binmode: true) do |file|
+      file.write(export.file.download)
+      file.rewind
+      zip = ZipFile::Reader.new(file)
+
+      assert_not zip.exists?("cards/#{hidden.number}.json")
+    end
+  end
+end
