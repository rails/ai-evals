+class Users::DataExportsController < ApplicationController
+  before_action :set_user, :ensure_current_user
+
+  def create
+    export = @user.data_exports.in_progress.first || start_export
+    redirect_to user_data_export_path(@user, export)
+  end
+
+  def show
+    @export = @user.data_exports.find(params[:id])
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
