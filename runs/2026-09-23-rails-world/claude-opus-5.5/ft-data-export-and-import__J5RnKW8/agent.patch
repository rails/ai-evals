     end
 
+    def export_file(blob)
+      # Files that went missing from storage can't be exported, but that
+      # shouldn't prevent exporting everything else.
+      if blob.service.exist?(blob.key)
+        zip.add_file(file_path_for(blob.key), compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+
+    def file_path_for(key)
+      "storage/#{key}"
+    end
+
+    def import_file(path)
+      if blob = ::ActiveStorage::Blob.find_by(account: account, key: translator.blob_key(File.basename(path)))
+        blob.service.upload blob.key, zip.open(path), checksum: blob.checksum
+      end
+    rescue ::ActiveStorage::IntegrityError
+      raise IntegrityError, "The file #{blob.filename} is corrupted"
+    end
 end
