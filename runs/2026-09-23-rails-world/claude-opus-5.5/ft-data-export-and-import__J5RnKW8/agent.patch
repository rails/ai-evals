index 0000000..1bb1c1f
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,155 @@
+# Random access reader for ZIP archives of any size.
+#
+# Only the central directory is read up front. Local file headers are resolved lazily,
+# when an entry is read, so opening a remote archive with millions of entries doesn't
+# issue one request per entry.
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+  class EntryNotFound < InvalidArchive; end
+
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(io)
+    @io = io
+    @entries = read_entries
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def glob(pattern)
+    candidates_for(pattern).select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def size_of(path)
+    entry_for(path).uncompressed_size
+  end
+
+  # Returns the content of the entry at +path+. When a block is given, the content is
+  # yielded in chunks instead, so large files never have to fit in memory.
+  def read(path)
+    extractor = extractor_for(path)
+
+    if block_given?
+      while (chunk = extractor.extract(CHUNK_SIZE)) && !chunk.empty?
+        yield chunk
+      end
+    else
+      +"".b.tap do |content|
+        while (chunk = extractor.extract(CHUNK_SIZE)) && !chunk.empty?
+          content << chunk
+        end
+      end
+    end
+  end
+
+  # Returns a read-only IO for the entry at +path+, suitable for handing off to
+  # Active Storage services for uploading.
+  def open(path)
+    EntryIO.new(self, path, size_of(path))
+  end
+
+  def extractor_for(path)
+    entry = entry_for(path)
+
+    unless entry.known_offset?
+      entry.compressed_data_offset = zip_reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+    end
+
+    entry.extractor_from(@io)
+  end
+
+  private
+    def read_entries
+      raise InvalidArchive, "This is not a valid ZIP file (it's empty)" if @io.size.zero?
+
+      zip_reader.read_zip_structure(io: @io, read_local_headers: false).index_by(&:filename).tap do |entries|
+        @paths_by_directory = entries.keys.group_by { |path| File.dirname(path) }
+      end
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::MissingEOCD => error
+      raise InvalidArchive, "This is not a valid ZIP file (#{error.message})"
+    end
+
+    def zip_reader
+      @zip_reader ||= ZipKit::FileReader.new
+    end
+
+    def candidates_for(pattern)
+      directory = File.dirname(pattern)
+
+      if directory.match?(/[*?\[{]/)
+        @entries.keys
+      else
+        @paths_by_directory.fetch(directory, [])
+      end
+    end
+
+    def entry_for(path)
+      @entries[path] || raise(EntryNotFound, "#{path} is missing from the archive")
+    end
+
+    class EntryIO
+      attr_reader :size
+
+      def initialize(reader, path, size)
+        @reader = reader
+        @path = path
+        @size = size
+        rewind
+      end
+
+      def read(length = nil, outbuf = nil)
+        fill(length)
+
+        data = length ? @buffer.slice!(0, length) : @buffer.slice!(0..)
+        @position += data.bytesize
+
+        result = if data.empty? && length&.positive?
+          nil
+        else
+          data
+        end
+
+        if outbuf
+          outbuf.replace(result || "")
+          result && outbuf
+        else
+          result
+        end
+      end
+
+      def rewind
+        @extractor = @reader.extractor_for(@path)
+        @buffer = +"".b
+        @position = 0
+        0
+      end
+
+      def eof?
+        fill(1)
+        @buffer.empty?
+      end
+
+      def pos
+        @position
+      end
+      alias_method :tell, :pos
+
+      def binmode
+        self
+      end
+
+      def close
+      end
+
+      private
+        def fill(length)
+          while length.nil? || @buffer.bytesize < length
+            chunk = @extractor.extract(ZipFile::Reader::CHUNK_SIZE)
+            break if chunk.nil? || chunk.empty?
+            @buffer << chunk
+          end
+        end
+    end
+end
