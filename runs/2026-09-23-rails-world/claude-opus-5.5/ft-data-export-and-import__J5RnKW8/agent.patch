+require "test_helper"
+
+class Account::DataTransfer::TranslatorTest < ActiveSupport::TestCase
+  setup do
+    @source = { "id" => accounts("37s").id, "external_account_id" => accounts("37s").external_account_id }
+    @translator = Account::DataTransfer::Translator.new(account: accounts(:initech), source: @source, salt: "salt")
+  end
+
+  test "translates ids deterministically" do
+    id = cards(:logo).id
+
+    assert_equal @translator.id(id), @translator.id(id)
+    assert_not_equal id, @translator.id(id)
+    assert_equal 25, @translator.id(id).length
+    assert_not_equal @translator.id(id), Account::DataTransfer::Translator.new(account: accounts(:initech), source: @source, salt: "other").id(id)
+  end
+
+  test "keeps the chronological order of ids" do
+    older, newer = ActiveRecord::Type::Uuid.generate, (sleep(0.002); ActiveRecord::Type::Uuid.generate)
+    assert @translator.id(older) < @translator.id(newer)
+  end
+
+  test "translates the source account to the new account" do
+    assert_equal accounts(:initech).id, @translator.id(accounts("37s").id)
+    assert_nil @translator.id(nil)
+  end
+
+  test "rejects invalid ids" do
+    assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { @translator.id("../../etc") }
+    assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { @translator.id("z" * 26) }
+  end
+
+  test "rewrites links to the source account" do
+    assert_equal "#{accounts(:initech).slug}/cards/1", @translator.url("#{accounts("37s").slug}/cards/1")
+    assert_equal "https://fizzy.example#{accounts(:initech).slug}/cards/1", @translator.url("https://fizzy.example#{accounts("37s").slug}/cards/1")
+    assert_equal "https://example.com/other", @translator.url("https://example.com/other")
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..f2f0b5c
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  setup do
+    @source = accounts("37s")
+    @identity = identities(:david)
+  end
+
+  test "importing an export creates a new account with everything in it" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    embed_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png")
+    comment = card.comments.create!(creator: users(:david), body: "See <action-text-attachment sgid=\"#{embed_blob.attachable_sgid}\"></action-text-attachment> and <action-text-attachment sgid=\"#{users(:kevin).attachable_sgid}\" content-type=\"application/vnd.actiontext.mention\"></action-text-attachment>")
+
+    import = import_file(export_file)
+
+    assert import.completed?, import.failure_reason
+    account = import.account
+
+    assert_equal @source.name, account.name
+    assert_not_equal @source.id, account.id
+    assert_equal @source.boards.count, account.boards.count
+    assert_equal @source.cards.count, account.cards.count
+    assert_equal Comment.where(account: @source).count, Comment.where(account: account).count
+    assert_equal @source.users.count, account.users.count
+    assert_equal @source.cards_count, account.reload.cards_count
+
+    Current.with_account(account) do
+      imported_card = account.cards.find_by!(number: card.number)
+      assert_equal card.title, imported_card.title
+      assert_equal card.board.name, imported_card.board.name
+      assert imported_card.image.attached?
+      assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+
+      imported_comment = imported_card.comments.find { |c| c.body.to_plain_text.start_with?("See") }
+      attachables = imported_comment.body.body.attachables
+      assert_equal 2, attachables.size
+      imported_blob = attachables.grep(ActiveStorage::Blob).first
+      assert_equal account.id, imported_blob.account_id
+      assert_equal file_fixture("avatar.png").binread, imported_blob.download
+      assert_equal account.users.find_by!(identity: identities(:kevin)), attachables.grep(User).first
+    end
+
+    owner = account.users.find_by!(identity: @identity)
+    assert owner.owner?
+    assert account.users.find_by!(role: :system)
+  end
+
+  test "every kind of record is imported" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+
+    import = import_file(export_file)
+    assert import.completed?, import.failure_reason
+
+    (Account::DataTransfer::Manifest.new(@source).models - [ Account, Filter, ActiveStorage::Attachment, ActiveStorage::Blob ]).each do |model|
+      assert_equal model.where(account_id: @source.id).count, model.where(account_id: import.account.id).count, "Expected the same number of #{model.name.pluralize}"
+    end
+
+    internal = Account::DataTransfer::RecordSet::INTERNAL_RECORD_TYPES
+    assert_equal ActiveStorage::Attachment.where(account_id: @source.id).where.not(record_type: internal).count,
+      ActiveStorage::Attachment.where(account_id: import.account.id).where.not(record_type: internal).count
+  end
+
+  test "imported cards are searchable and storage is tracked" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+
+    import = import_file(export_file)
+    account = import.account
+
+    assert Search::Record.for(account.id).where(account_id: account.id).exists?
+    assert_equal @source.reload.bytes_used_exact, account.bytes_used_exact
+  end
+
+  test "the same export can be imported twice" do
+    file = export_file
+    first = import_file(file)
+    second = import_file(file)
+
+    assert first.completed?, first.failure_reason
+    assert second.completed?, second.failure_reason
+    assert_equal first.account.cards.count, second.account.cards.count
+  end
+
+  test "an import that fails leaves nothing behind" do
+    file = export_file(tamper: ->(entries) { entries.select { |path, _| path.start_with?("data/cards/") }.each { |_, data| data["account_id"] = accounts(:initech).id } })
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Card.count }, -> { Identity.count }, -> { ActiveStorage::Blob.count }, -> { ActiveStorage::Attachment.count }, -> { Board.count } ] do
+      import = import_file(file)
+      assert import.failed?
+      assert_nil import.account
+      assert_match "belongs to another account", import.failure_reason
+    end
+  end
+
+  test "an import with a corrupted file leaves no files behind" do
+    image = cards(:logo).image.tap { it.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg") }.blob
+    file = export_file(tamper: ->(entries) { entries[entries.keys.find { it.start_with?("storage/") }] = "corrupted" })
+
+    import, uploaded_key = nil
+
+    assert_no_difference [ -> { Account.count }, -> { ActiveStorage::Blob.count } ] do
+      upload = Rack::Test::UploadedFile.new(file.path, "application/zip", original_filename: "export.zip")
+      import = Current.without_account { Account::Import.start(identity: @identity, file: upload) }
+      uploaded_key = import.file.blob.key
+
+      perform_enqueued_jobs only: ImportAccountDataJob
+    end
+
+    assert import.reload.failed?
+    assert_match "corrupted", import.failure_reason
+
+    imported_key = Account::DataTransfer::Translator.new(account: nil, source: {}, salt: import.id).blob_key(image.key)
+    assert_not ActiveStorage::Blob.service.exist?(imported_key)
+    assert_not ActiveStorage::Blob.service.exist?(uploaded_key)
+    assert ActiveStorage::Blob.service.exist?(image.key)
+  end
+
+  test "a file that isn't a zip fails" do
+    import = import_file(Tempfile.new.tap { |f| f.write("nope"); f.rewind })
+    assert import.failed?
+    assert_match "not a valid ZIP", import.failure_reason
+  end
+
+  private
+    def export_file(tamper: nil)
+      export = Account::Export.create!(account: @source, user: users(:david))
+      export.build
+      path = Tempfile.new([ "export", ".zip" ]).tap(&:binmode)
+      path.write(export.file.download)
+      path.rewind
+
+      if tamper
+        path = rewrite(path, tamper)
+      end
+
+      path
+    end
+
+    def rewrite(file, tamper)
+      entries = {}
+      reader = ZipFile::Reader.new(File.open(file.path, "rb"))
+      reader.glob("**/*").each { |p| entries[p] = p.end_with?(".json") ? JSON.parse(reader.read(p)) : reader.read(p) }
+      tamper.call(entries)
+
+      Tempfile.new([ "tampered", ".zip" ]).tap do |out|
+        out.binmode
+        writer = ZipFile::Writer.new(out)
+        entries.each { |p, data| writer.add_file(p, data.is_a?(Hash) ? data.to_json : data) }
+        writer.close
+        out.rewind
+      end
+    end
+
+    def import_file(file)
+      upload = Rack::Test::UploadedFile.new(file.path, "application/zip", original_filename: "export.zip")
+      import = Current.without_account { Account::Import.start(identity: @identity, file: upload) }
+      perform_enqueued_jobs only: ImportAccountDataJob
+      import.reload
+    end
+end
