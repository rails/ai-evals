+++ b/app/models/user/data_export.rb
@@ -0,0 +1,100 @@
+# The cards a person can see, as JSON, along with their comments and every picture and
+# file attached to them:
+#
+#   cards/<number>.json
+#   cards/<number>/<filename>
+class User::DataExport < Export
+  private
+    def populate_zip(zip)
+      exportable_cards.find_each do |card|
+        add_card_to_zip(zip, card)
+      end
+    end
+
+    def exportable_cards
+      user.accessible_cards.published.includes(
+        :board, :column, :creator, :tags, :steps, :goldness, :assignees, :image_attachment,
+        closure: :user, not_now: :user, rich_text_description: { embeds_attachments: :blob }
+      )
+    end
+
+    def add_card_to_zip(zip, card)
+      data = card_data(card, zip)
+      zip.add_file "cards/#{card.number}.json", JSON.pretty_generate(data)
+    end
+
+    def card_data(card, zip)
+      {
+        number: card.number,
+        title: card.title,
+        board: card.board.name,
+        column: card.column&.name,
+        status: card_status(card),
+        golden: card.golden?,
+        tags: card.tags.map(&:title).sort,
+        creator: person(card.creator),
+        assignees: card.assignees.map { |assignee| person(assignee) },
+        description: card.description.to_plain_text,
+        description_html: card.description.body&.to_html,
+        steps: card.steps.map { |step| { content: step.content, completed: step.completed } },
+        image: (export_file(zip, card, card.image.blob) if card.image.attached?),
+        attachments: export_files(zip, card, card.attachments),
+        closed_at: card.closed_at,
+        closed_by: person(card.closed_by),
+        postponed_at: card.not_now&.created_at,
+        due_on: card.due_on,
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        last_active_at: card.last_active_at,
+        comments: card.comments.chronologically.preloaded.includes(:creator, rich_text_body: { embeds_attachments: :blob }).map { |comment| comment_data(comment, card, zip) }
+      }
+    end
+
+    def card_status(card)
+      if card.closed?
+        "closed"
+      elsif card.postponed?
+        "not_now"
+      elsif card.column
+        "in_column"
+      else
+        "maybe"
+      end
+    end
+
+    def comment_data(comment, card, zip)
+      {
+        id: comment.id,
+        creator: person(comment.creator),
+        body: comment.body.to_plain_text,
+        body_html: comment.body.body&.to_html,
+        attachments: export_files(zip, card, comment.attachments),
+        created_at: comment.created_at,
+        updated_at: comment.updated_at
+      }
+    end
+
+    def person(user)
+      if user
+        { id: user.id, name: user.name }
+      end
+    end
+
+    def export_files(zip, card, attachments)
+      attachments.filter_map do |attachment|
+        export_file(zip, card, attachment.blob)
+      end
+    end
+
+    def export_file(zip, card, blob)
+      if blob.service.exist?(blob.key)
+        path = zip.unique_path_for("cards/#{card.number}/#{blob.filename.sanitized}")
+
+        zip.add_file(path, compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+
+        { path: path, filename: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size }
+      end
+    end
+end
