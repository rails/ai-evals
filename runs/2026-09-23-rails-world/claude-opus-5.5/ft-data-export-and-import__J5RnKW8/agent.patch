 end
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  setup do
+    @tempfile = Tempfile.new([ "test", ".zip" ]).tap(&:binmode)
+    @big = SecureRandom.random_bytes(3.megabytes)
+
+    writer = ZipFile::Writer.new(@tempfile)
+    writer.add_file("data/cards/1.json", '{"id":"1"}')
+    writer.add_file("data/cards/2.json", '{"id":"2"}')
+    writer.add_file("data/boards/1.json", '{"id":"1"}')
+    writer.add_file("storage/abc", @big, compress: false)
+    writer.close
+    @tempfile.rewind
+  end
+
+  teardown do
+    @tempfile.close!
+  end
+
+  test "reads entries" do
+    reader = ZipFile::Reader.new(@tempfile)
+
+    assert_equal '{"id":"2"}', reader.read("data/cards/2.json")
+    assert_equal @big, reader.read("storage/abc")
+    assert_equal @big.bytesize, reader.size_of("storage/abc")
+  end
+
+  test "globs entries by directory" do
+    reader = ZipFile::Reader.new(@tempfile)
+
+    assert_equal [ "data/cards/1.json", "data/cards/2.json" ], reader.glob("data/cards/*.json")
+    assert_equal [ "storage/abc" ], reader.glob("storage/*")
+    assert_equal 4, reader.glob("**/*").size
+  end
+
+  test "opens entries as IO" do
+    io = ZipFile::Reader.new(@tempfile).open("storage/abc")
+
+    content = +""
+    while (chunk = io.read(100.kilobytes))
+      content << chunk
+    end
+
+    assert_equal @big, content
+    assert_equal @big.bytesize, io.size
+
+    io.rewind
+    assert_equal @big.first(10), io.read(10)
+  end
+
+  test "reads from blobs through ranged downloads" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: @tempfile, filename: "test.zip")
+    reader = ZipFile::Reader.new(ZipFile::BlobIO.new(blob, read_ahead: 1.megabyte))
+
+    assert_equal '{"id":"1"}', reader.read("data/boards/1.json")
+    assert_equal @big, reader.read("storage/abc")
+  end
+
+  test "missing entries" do
+    assert_raises(ZipFile::Reader::EntryNotFound) do
+      ZipFile::Reader.new(@tempfile).read("missing.json")
+    end
+  end
+
+  test "invalid archives" do
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(StringIO.new("not a zip")) }
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(StringIO.new("")) }
+  end
+end
