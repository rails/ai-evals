+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins see the export button in account settings" do
+    get account_settings_path
+    assert_select "form[action='#{account_exports_path}']"
+
+    logout_and_sign_in_as :david
+    get account_settings_path
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+
+  test "admins can export the account" do
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with job: DataExportJob do
+        post account_exports_path
+      end
+    end
+
+    export = Account::Export.last
+    assert_equal users(:kevin), export.user
+    assert_redirected_to account_export_path(export)
+
+    follow_redirect!
+    assert_response :success
+    assert_select "p", /preparing/
+  end
+
+  test "an export in progress is reused" do
+    post account_exports_path
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+  end
+
+  test "members can't export the account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show a completed export with its download link" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    perform_enqueued_jobs { export.build_later }
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a[href*='rails/active_storage']", text: /Download/
+
+    get rails_blob_path(export.reload.file, disposition: "attachment")
+    assert_response :redirect
+  end
+
+  test "expired exports can't be downloaded" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    travel Export::AVAILABILITY + 1.minute do
+      get account_export_path(export)
+      assert_response :success
+      assert_select "a[href*='rails/active_storage']", count: 0
+      assert_select "p", /expired/
+
+      get rails_blob_path(export.file, disposition: "attachment")
+      assert_response :forbidden
+    end
+  end
+
+  test "can't see other people's exports" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason))
+
+    get account_export_path(export)
+    assert_response :not_found
+  end
+end
