+class ImportAccountDataJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    # Imports can be picked up again if they were interrupted, as importing is idempotent
+    import.process if import.pending? || import.processing?
+  end
+end
