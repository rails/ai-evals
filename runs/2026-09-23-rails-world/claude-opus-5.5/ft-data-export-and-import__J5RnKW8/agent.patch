+class ExportMailer < ApplicationMailer
+  def completed(export)
+    @export = export
+    @user = export.user
+    @account = export.account
+    @url = export_url_for(export)
+
+    mail to: @user.identity.email_address, subject: "Your Fizzy export is ready to download"
+  end
+
+  private
+    def export_url_for(export)
+      case export
+      when Account::Export then account_export_url(export, script_name: export.account.slug)
+      else user_data_export_url(export.user, export, script_name: export.account.slug)
+      end
+    end
+end
