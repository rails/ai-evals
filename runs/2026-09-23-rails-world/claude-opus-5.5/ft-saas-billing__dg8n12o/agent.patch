+<% account = Current.account %>
+<% plan = account.plan %>
+
+<section class="settings__section" id="account_subscription">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= plan.name %></strong> plan<%= " (complimentary)" if account.comped? %>:
+      <%= plan_allowance(plan).downcase_first %>.
+    </div>
+    <div class="txt-small txt-ink-medium margin-block-start-half">
+      <% if plan.limit_cards? %>
+        <%= number_with_delimiter(account.billed_cards_count) %> of <%= number_with_delimiter(plan.card_limit) %> cards used ·
+      <% end %>
+      <%= number_to_human_size(account.billed_bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage used
+    </div>
+    <% if (subscription = account.active_subscription) && subscription.cancel_at && !account.comped? %>
+      <div class="txt-small margin-block-start-half">Your subscription ends on <%= subscription.cancel_at.to_date.to_fs(:long) %>.</div>
+    <% end %>
+  </header>
+
