+        <%= link_to "Upgrade", saas.account_subscription_path, class: "btn btn--link" %>
+      <% end %>
+
+      <% if account.subscription&.stripe_subscription_id %>
+        <%= button_to "Manage billing", saas.account_billing_portal_path, method: :post, class: "btn", form: { data: { turbo: false } } %>
+      <% end %>
+    </div>
+  <% end %>
+</section>
