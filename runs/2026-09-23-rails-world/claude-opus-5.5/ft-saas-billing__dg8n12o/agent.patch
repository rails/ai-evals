@@ -0,0 +1,116 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "← Accounts", saas.admin_accounts_path, class: "btn txt-small" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <dl class="admin-account__details margin-block-half" style="text-align: left">
+      <dt class="txt-x-small txt-ink-medium">Account ID</dt>
+      <dd>#<%= @account.external_account_id %> · <%= link_to "Open account", main_app.root_url(script_name: @account.slug) %></dd>
+
+      <dt class="txt-x-small txt-ink-medium">Owner</dt>
+      <dd><%= [ @account.owner_name, @account.owner_email ].compact.join(" · ").presence || "No owner" %></dd>
+
+      <dt class="txt-x-small txt-ink-medium">Created</dt>
+      <dd><%= @account.created_at.to_date.to_fs(:long) %> (<%= time_ago_in_words(@account.created_at) %> ago)</dd>
+
+      <% if @account.cancelled? %>
+        <dt class="txt-x-small txt-ink-medium">Cancelled</dt>
+        <dd><%= time_ago_in_words(@account.cancellation.created_at) %> ago</dd>
+      <% end %>
+    </dl>
+  </div>
+
+  <div class="settings__panel panel shadow" id="admin_account_billing">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <dl class="margin-block-half" style="text-align: left">
+      <dt class="txt-x-small txt-ink-medium">Plan</dt>
+      <dd><strong><%= @account.plan.name %></strong><%= " (comped)" if @account.comped? %></dd>
+
+      <% if subscription = @account.subscription %>
+        <dt class="txt-x-small txt-ink-medium">Stripe</dt>
+        <dd>
+          Customer <code><%= subscription.stripe_customer_id %></code>
+          <% if subscription.stripe_subscription_id %>
+            · Subscription <code><%= subscription.stripe_subscription_id %></code> (<%= subscription.status || "unknown" %>)
+          <% end %>
+        </dd>
+
+        <% if subscription.current_period_end %>
+          <dt class="txt-x-small txt-ink-medium">Current period ends</dt>
+          <dd><%= subscription.current_period_end.to_date.to_fs(:long) %></dd>
+        <% end %>
+
+        <% if subscription.cancel_at %>
+          <dt class="txt-x-small txt-ink-medium">Cancels on</dt>
+          <dd><%= subscription.cancel_at.to_date.to_fs(:long) %></dd>
+        <% end %>
+      <% end %>
+    </dl>
+
+    <% if @account.comped? %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--negative" %>
+    <% else %>
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+    <% end %>
+  </div>
+
+  <div class="settings__panel panel shadow" id="admin_account_limits">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Usage &amp; limits</h2>
+    </header>
+
+    <dl class="margin-block-half" style="text-align: left">
+      <dt class="txt-x-small txt-ink-medium">Cards</dt>
+      <dd>
+        <%= number_with_delimiter(@account.billed_cards_count) %>
+        of <%= @account.plan.limit_cards? ? number_with_delimiter(@account.card_limit) : "unlimited" %>
+        <% if @account.overridden_limits&.card_count %>
+          <span class="txt-x-small txt-ink-medium">(overridden, actual <%= number_with_delimiter(@account.cards_count) %>)</span>
+        <% end %>
+      </dd>
+
+      <dt class="txt-x-small txt-ink-medium">Storage</dt>
+      <dd>
+        <%= number_to_human_size(@account.billed_bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+        <% if @account.overridden_limits&.bytes_used %>
+          <span class="txt-x-small txt-ink-medium">(overridden, actual <%= number_to_human_size(@account.bytes_used) %>)</span>
+        <% end %>
+      </dd>
+    </dl>
+
+    <%= form_with model: @account.overridden_limits || Account::OverriddenLimits.new, scope: :overridden_limits,
+          url: saas.admin_account_overridden_limits_path(@account), method: :patch,
+          class: "flex flex-column gap-half margin-block-half", style: "text-align: left" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, min: 0, step: 1, class: "input", placeholder: @account.cards_count %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, min: 0, step: 1, class: "input", placeholder: @account.bytes_used %>
+      </div>
+
+      <div>
+        <%= form.submit "Override", class: "btn" %>
+      </div>
+    <% end %>
+
+    <% if @account.overridden_limits&.persisted? %>
+      <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn btn--negative" %>
+    <% end %>
+  </div>
+</section>
