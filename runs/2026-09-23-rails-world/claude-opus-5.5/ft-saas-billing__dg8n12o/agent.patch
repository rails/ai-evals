+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half margin-block-half" do |form| %>
+      <%= form.search_field :q, value: @query, placeholder: "Name or account ID…", class: "input flex-item-grow", aria: { label: "Search accounts" } %>
+      <%= form.submit "Search", class: "btn", name: nil %>
+    <% end %>
+
+    <ul class="margin-block-half" id="admin_accounts">
+      <% @page.records.each do |account| %>
+        <li class="flex align-start gap-half margin-block-start-half" id="<%= dom_id(account, :admin) %>">
+          <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+            <strong><%= link_to account.name, saas.admin_account_path(account) %></strong>
+            <br>
+            <span class="txt-x-small txt-ink-medium">
+              #<%= account.external_account_id %> •
+              <%= account.owner_email || "No owner" %> •
+              <%= account.plan.name %><%= " (comped)" if account.comped? %>
+              <% if account.cancelled? %>• Cancelled<% end %>
+            </span>
+          </div>
+
+          <div class="txt-medium" style="text-align: right">
+            <strong><%= number_with_delimiter(account.billed_cards_count) %></strong>
+            <span class="txt-x-small txt-ink-medium">cards</span>
+            <br>
+            <span class="txt-x-small txt-ink-medium"><%= number_to_human_size(account.billed_bytes_used) %></span>
+          </div>
+        </li>
+      <% end %>
+    </ul>
+
+    <% if @page.records.empty? %>
+      <p class="txt-ink-medium">No accounts found.</p>
+    <% end %>
+
+    <% unless @page.last? %>
+      <%= link_to "Next page", saas.admin_accounts_path(q: @query.presence, page: @page.next_param), class: "btn txt-small" %>
+    <% end %>
+  </div>
+</section>
diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
