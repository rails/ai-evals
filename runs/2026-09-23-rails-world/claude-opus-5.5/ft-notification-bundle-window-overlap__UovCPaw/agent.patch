diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..afa8ce2
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @user.notifications.delete_all
+    @user.settings.bundle_email_every_few_hours!
+  end
+
+  test "the first notification opens a window lasting the chosen period" do
+    notification = notify(events(:logo_published))
+
+    bundle = @user.notification_bundles.sole
+    assert bundle.pending?
+    assert_equal notification.created_at.to_i, bundle.starts_at.to_i
+    assert_equal (notification.created_at + 4.hours).to_i, bundle.ends_at.to_i
+    assert_equal [ notification ], bundle.notifications
+  end
+
+  test "window length follows the frequency" do
+    { daily: 1.day, weekly: 1.week }.each do |frequency, period|
+      @user.notification_bundles.delete_all
+      @user.notifications.delete_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      notify(events(:logo_published))
+
+      bundle = @user.notification_bundles.sole
+      assert_equal period, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "nothing is bundled when emails are off" do
+    @user.settings.bundle_email_never!
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      assert_nil notify(events(:logo_published)).bundle
+    end
+  end
+
+  test "notifications within the window share it and later ones open a new one" do
+    first = notify(events(:logo_published))
+    travel 3.hours
+    second = notify(events(:layout_published))
+    travel 2.hours
+    third = notify(events(:text_published))
+
+    bundle_1, bundle_2 = @user.notification_bundles.chronologically
+    assert_equal [ first, second ].sort_by(&:id), bundle_1.notifications.sort_by(&:id)
+    assert_equal [ third ], bundle_2.notifications.to_a
+    assert_equal third.created_at.to_i, bundle_2.starts_at.to_i
+  end
+
+  test "late notifications join the window that already opened" do
+    notify(events(:logo_published))
+    late = notify(events(:layout_published), created_at: 1.hour.ago)
+
+    bundle = @user.notification_bundles.sole
+    assert_includes bundle.notifications, late
+  end
+
+  test "late notifications landing in an already delivered window go into the next one" do
+    travel_to 5.hours.ago do
+      notify(events(:logo_published))
+    end
+    delivered = @user.notification_bundles.sole
+    delivered.deliver
+
+    late = notify(events(:layout_published), created_at: delivered.ends_at - 1.minute)
+
+    assert_equal 2, @user.notification_bundles.count
+    open = @user.notification_bundles.pending.sole
+    assert_equal late.bundle, open
+    assert_equal delivered.ends_at, open.starts_at
+  end
+
+  test "renotifications land in the current window" do
+    notification = notify(events(:logo_published))
+    first_bundle = notification.bundle
+    first_bundle.delivered!
+
+    travel 5.hours
+    notification.update!(source: events(:logo_assignment_david), read_at: nil)
+
+    assert_not_equal first_bundle, notification.reload.bundle
+    assert notification.bundle.pending?
+  end
+
+  test "windows never overlap" do
+    notify(events(:logo_published))
+    existing = @user.notification_bundles.sole
+
+    overlapping = @user.notification_bundles.build(starts_at: existing.starts_at + 1.hour)
+    assert_not overlapping.valid?
+
+    adjacent = @user.notification_bundles.build(starts_at: existing.ends_at)
+    assert adjacent.valid?
+  end
+
+  test "deliver_all delivers due bundles in a single email" do
+    notify(events(:logo_published))
+    notify(events(:layout_published))
+    bundle = @user.notification_bundles.sole
+
+    assert_no_enqueued_jobs(only: Notification::Bundle::DeliverJob) { Notification::Bundle.deliver_all }
+
+    travel 4.hours + 1.minute
+    assert_emails 1 do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliverJob) { Notification::Bundle.deliver_all }
+    end
+
+    assert bundle.reload.delivered?
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "no email when everything was read already" do
+    notify(events(:logo_published)).read
+    bundle = @user.notification_bundles.sole
+
+    travel 5.hours
+    assert_no_emails { bundle.deliver }
+    assert bundle.reload.delivered?
+  end
+
+  test "no email once the person turned bundling off" do
+    notify(events(:logo_published))
+    bundle = @user.notification_bundles.sole
+    @user.settings.bundle_email_never!
+
+    travel 5.hours
+    assert_no_emails { bundle.deliver }
+  end
+
+  test "a bundle is only delivered once" do
+    notify(events(:logo_published))
+    bundle = @user.notification_bundles.sole
+
+    travel 5.hours
+    assert_emails 1 do
+      bundle.deliver
+      Notification::Bundle.find(bundle.id).deliver
+    end
+  end
+
+  private
+    def notify(event, **attributes)
+      @user.notifications.create!(source: event, creator: users(:kevin), unread_count: 1, **attributes)
+    end
+end
