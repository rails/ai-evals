+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.bundle_email_daily!
+    @bundle = @user.notification_bundles.create!(starts_at: 2.weeks.ago)
+    @user.notifications.update_all(bundle_id: @bundle.id)
+  end
+
+  test "notification lists the unread notifications in the bundle" do
+    email = Current.with_account(@user.account) { Notification::BundleMailer.notification(@bundle) }
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match(/\d+ new notifications in #{@user.account.name}/, email.subject)
+    assert_match ERB::Util.html_escape(cards(:logo).title), email.html_part.body.to_s
+    assert_match cards(:logo).title, email.text_part.body.to_s
+    assert_match "/notifications/settings", email.html_part.body.to_s
+  end
+end
