@@ -0,0 +1,28 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    before_save :assign_to_bundle, if: :landing?
+  end
+
+  private
+    def landing?
+      will_save_change_to_source_id? || will_save_change_to_source_type?
+    end
+
+    def assign_to_bundle
+      if bundleable?
+        self.bundle = user.notification_bundle_for(landed_at)
+      end
+    end
+
+    def bundleable?
+      user.bundling_notification_emails? && !creator&.system?
+    end
+
+    def landed_at
+      (new_record? && created_at) || Time.current
+    end
+end
