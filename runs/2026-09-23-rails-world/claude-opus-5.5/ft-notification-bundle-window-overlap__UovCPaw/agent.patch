diff --git a/app/models/user/notification_bundling.rb b/app/models/user/notification_bundling.rb
new file mode 100644
index 0000000..d454326
--- /dev/null
+++ b/app/models/user/notification_bundling.rb
@@ -0,0 +1,40 @@
+module User::NotificationBundling
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :notification_bundles, class_name: "Notification::Bundle", dependent: :delete_all
+  end
+
+  def bundling_notification_emails?
+    active? && settings&.bundling_emails?
+  end
+
+  # Returns the bundle for a notification that landed at +time+, opening a new window when there
+  # isn't one already open. Late arrivals, landing before the open window started, join that window.
+  def notification_bundle_for(time)
+    with_notification_bundling_lock do
+      open_notification_bundle_for(time) || notification_bundles.create!(starts_at: next_notification_bundle_start_for(time))
+    end
+  end
+
+  # Serializes the creation, filling and delivery of a person's bundles, so that concurrent
+  # notifications can't open overlapping windows or join a bundle that is being delivered.
+  def with_notification_bundling_lock
+    transaction do
+      User::Settings.where(user_id: id).lock.pluck(:id)
+      yield
+    end
+  end
+
+  private
+    def open_notification_bundle_for(time)
+      pending_bundles = notification_bundles.pending
+      pending_bundles.containing(time).first || pending_bundles.where(starts_at: time..).chronologically.first
+    end
+
+    # A late notification can land inside a window that was already delivered. The new window then
+    # starts right after it to avoid overlapping.
+    def next_notification_bundle_start_for(time)
+      [ time, notification_bundles.containing(time).maximum(:ends_at) ].compact.max
+    end
+end
