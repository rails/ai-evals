@@ -0,0 +1,14 @@
+class Notification::BundleMailer < ApplicationMailer
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications_by_board = bundle.unread_notifications.preloaded.group_by { it.card.board }
+
+    mail to: @user.identity.email_address, subject: subject_for(bundle.unread_notifications.count)
+  end
+
+  private
+    def subject_for(count)
+      "#{count} new #{"notification".pluralize(count)} in #{@bundle.account.name} on Fizzy"
+    end
+end
