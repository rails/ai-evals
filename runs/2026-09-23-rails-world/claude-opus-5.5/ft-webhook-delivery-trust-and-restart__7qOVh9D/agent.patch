+require "test_helper"
+
+class Webhook::TriggerableTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_published)
+    Webhook::Delivery.delete_all
+  end
+
+  test "triggered_by scope matches board and subscribed action" do
+    assert_includes Webhook.triggered_by(@event), @webhook
+
+    @webhook.update! subscribed_actions: %w[ card_closed ]
+    assert_not_includes Webhook.triggered_by(@event), @webhook
+  end
+
+  test "trigger creates a pending delivery and enqueues it" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      assert_difference -> { @webhook.deliveries.count }, +1 do
+        @webhook.trigger(@event)
+      end
+    end
+    assert @webhook.deliveries.last.pending?
+  end
+
+  test "trigger is idempotent per event" do
+    @webhook.trigger(@event)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      @webhook.trigger(@event)
+    end
+  end
+
+  test "inactive or unsubscribed webhooks are not triggered" do
+    @webhook.deactivate
+    assert_nil @webhook.trigger(@event)
+
+    @webhook.activate
+    @webhook.update! subscribed_actions: %w[ card_closed ]
+    assert_nil @webhook.trigger(@event)
+    assert_empty @webhook.deliveries
+  end
+end
