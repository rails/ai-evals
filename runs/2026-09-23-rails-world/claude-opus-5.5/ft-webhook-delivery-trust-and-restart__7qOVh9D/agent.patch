+require "test_helper"
+
+class Webhook::DeliveryLifecycleTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = webhook_deliveries(:pending)
+    stub_dns_resolution(PUBLIC_IP)
+  end
+
+  test "deliver posts a signed JSON payload and logs the response" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_requested stub, times: 1
+    assert_requested(:post, @webhook.url) do |request|
+      expected = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body)
+      request.headers["X-Webhook-Signature"] == expected &&
+        request.headers["Content-Type"] == "application/json" &&
+        request.headers["X-Webhook-Delivery"] == @delivery.id &&
+        JSON.parse(request.body)["id"] == @delivery.event_id
+    end
+
+    @delivery.reload
+    assert @delivery.completed?
+    assert @delivery.succeeded?
+    assert_equal 200, @delivery.response[:code]
+    assert @delivery.sanitized_request[:headers].key?("X-Webhook-Event")
+    assert_not @delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+  end
+
+  test "deliver only sends once" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver
+    @delivery.deliver
+    Webhook::Delivery.find(@delivery.id).deliver
+    perform_enqueued_jobs { Webhook::DeliveryJob.perform_later(@delivery) }
+
+    assert_requested stub, times: 1
+  end
+
+  test "deliver skips deliveries already claimed" do
+    stub = stub_request(:post, @webhook.url)
+
+    webhook_deliveries(:in_progress).deliver
+
+    assert_not_requested stub
+  end
+
+  test "non-2xx responses are logged as failures" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    @delivery.deliver
+
+    assert @delivery.reload.failed?
+    assert_equal 500, @delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "network errors are logged" do
+    stub_request(:post, @webhook.url).to_timeout
+    @delivery.deliver
+    assert_equal "connection_timeout", @delivery.reload.response[:error]
+    assert @delivery.failed?
+
+    other = @webhook.deliveries.create!(event: events(:layout_commented))
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    other.deliver
+    assert_equal "destination_unreachable", other.reload.response[:error]
+  end
+
+  test "private addresses are never requested" do
+    stub_dns_resolution("10.0.0.1")
+    stub = stub_request(:post, @webhook.url)
+
+    @delivery.deliver
+
+    assert_not_requested stub
+    assert_equal "private_uri", @delivery.reload.response[:error]
+  end
+
+  test "private IP literal urls are never requested" do
+    @webhook.update_columns url: "http://127.0.0.1:3000/hook"
+    stub = stub_request(:post, "http://127.0.0.1:3000/hook")
+
+    @delivery.deliver
+
+    assert_not_requested stub
+    assert_equal "private_uri", @delivery.reload.response[:error]
+  end
+
+  test "deliveries for deactivated webhooks are not sent" do
+    stub = stub_request(:post, @webhook.url)
+    @webhook.deactivate
+
+    @delivery.deliver
+
+    assert_not_requested stub
+    assert @delivery.reload.errored?
+  end
+
+  test "unexpected errors mark the delivery errored" do
+    Webhook::Delivery::Request.any_instance.stubs(:perform).raises(RuntimeError, "boom")
+
+    @delivery.deliver
+
+    assert @delivery.reload.errored?
+    assert_equal "internal_error", @delivery.response[:error]
+  end
+
+  test "slack payload" do
+    @webhook.update_columns url: "https://hooks.slack.com/services/T123/B456/abcdef"
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_requested(:post, @webhook.url) do |request|
+      text = JSON.parse(request.body)["text"]
+      text.present? && text.match?(%r{<https?://\S+\|↗︎>}) && request.headers["Content-Type"] == "application/json"
+    end
+  end
+
+  test "campfire and basecamp payloads" do
+    @webhook.update_columns url: "https://campfire.example.com/rooms/1/2-bot/messages"
+    stub_request(:post, @webhook.url).to_return(status: 201)
+    @delivery.deliver
+    assert_requested(:post, @webhook.url) { |r| r.headers["Content-Type"] == "text/html" && r.body.include?("<a href=") }
+
+    delivery = @webhook.deliveries.create!(event: events(:layout_commented))
+    @webhook.update_columns url: "https://basecamp.example.com/1/integrations/tok/buckets/2/chats/3/lines"
+    stub_request(:post, @webhook.url).to_return(status: 201)
+    delivery.deliver
+    assert_requested(:post, @webhook.url) { |r| r.headers["Content-Type"] == "application/x-www-form-urlencoded" && Rack::Utils.parse_query(r.body)["content"].present? }
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    old = webhook_deliveries(:successfully_completed)
+    old.update_columns created_at: 8.days.ago
+    recent = webhook_deliveries(:pending)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old.id)
+    assert Webhook::Delivery.exists?(recent.id)
+  end
+end
