index 0000000..93f81d1
--- /dev/null
+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  setup do
+    Webhook::Delivery.delete_all
+    Current.session = sessions(:david)
+  end
+
+  test "creating an event dispatches it to subscribed webhooks once" do
+    card = boards(:writebook).cards.create!(title: "Hooked", status: :drafted)
+
+    perform_enqueued_jobs only: Event::WebhookDispatchJob do
+      card.publish
+    end
+
+    delivery = webhooks(:active).deliveries.sole
+    assert_equal "card_published", delivery.event.action
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery ]
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      delivery.event.dispatch_webhooks
+    end
+  end
+
+  test "no dispatch for boards without active webhooks" do
+    card = boards(:private).cards.create!(title: "Quiet", status: :drafted)
+
+    assert_no_enqueued_jobs only: Event::WebhookDispatchJob do
+      card.publish
+    end
+  end
+
+  test "no deliveries while the account is not active" do
+    event = events(:logo_published)
+    Account.any_instance.stubs(:active?).returns(false)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..5873991
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "created on demand, once per webhook" do
+    assert @tracker.persisted?
+    assert_equal @tracker, @webhook.reload.delinquency_tracker
+  end
+
+  test "deactivates after ten consecutive failures spanning an hour" do
+    freeze_time
+
+    9.times { @tracker.record_delivery_of(failed_delivery) }
+    travel 1.hour
+    assert @webhook.reload.active?
+
+    @tracker.record_delivery_of(failed_delivery)
+    assert_not @webhook.reload.active?
+  end
+
+  test "ten quick failures are not enough" do
+    10.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+    assert_equal 10, @tracker.consecutive_failures_count
+  end
+
+  test "failing for an hour with fewer than ten failures is not enough" do
+    @tracker.record_delivery_of(failed_delivery)
+    travel 2.hours
+    8.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+  end
+
+  test "a success resets the streak" do
+    9.times { @tracker.record_delivery_of(failed_delivery) }
+    travel 2.hours
+    @tracker.record_delivery_of(webhook_deliveries(:successfully_completed))
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    @tracker.record_delivery_of(failed_delivery)
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating resets the streak" do
+    @tracker.update! consecutive_failures_count: 10, first_failure_at: 2.hours.ago
+    @webhook.deactivate
+
+    @webhook.activate
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+  end
+
+  private
+    def failed_delivery
+      webhook_deliveries(:unsuccessfully_completed)
+    end
+end
