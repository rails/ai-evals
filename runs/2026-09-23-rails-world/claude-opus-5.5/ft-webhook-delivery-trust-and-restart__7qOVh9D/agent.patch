+module Event::Webhookable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :dispatch_webhooks_later, if: -> { board.webhooks.active.exists? }
+  end
+
+  def dispatch_webhooks
+    if account.active?
+      Webhook.active.triggered_by(self).find_each do |webhook|
+        webhook.trigger(self)
+      end
+    end
+  end
+
+  private
+    def dispatch_webhooks_later
+      Event::WebhookDispatchJob.perform_later(self)
+    end
+end
