diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..dae5747
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,126 @@
+# Builds and performs the HTTP POST for a webhook delivery.
+class Webhook::Delivery::Request
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => Webhook::Delivery::USER_AGENT,
+      "Content-Type" => content_type,
+      "X-Webhook-Delivery" => delivery.id,
+      "X-Webhook-Event" => event.action.to_s,
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+      "X-Webhook-Signature" => signature
+    }
+  end
+
+  def payload
+    @payload ||= \
+      if webhook.for_campfire?
+        render_payload(format: :html)
+      elsif webhook.for_basecamp?
+        { content: render_payload(format: :html) }.to_query
+      elsif webhook.for_slack?
+        { text: html_to_mrkdwn(render_payload(format: :html)) }.to_json
+      else
+        render_payload(format: :json)
+      end
+  end
+
+  # Returns the response summary stored on the delivery.
+  def perform
+    if ip = resolved_ip
+      response = http(ip).request(post_request)
+      { code: response.code.to_i }
+    else
+      { error: "private_uri" }
+    end
+  rescue Resolv::ResolvError, Resolv::ResolvTimeout, SocketError
+    { error: "dns_lookup_failed" }
+  rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Errno::ETIMEDOUT
+    { error: "connection_timeout" }
+  rescue Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ECONNRESET, EOFError, IOError
+    { error: "destination_unreachable" }
+  rescue OpenSSL::SSL::SSLError
+    { error: "failed_tls" }
+  end
+
+  private
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def resolved_ip
+      if literal_ip = ip_literal(uri.hostname)
+        literal_ip.to_s unless SsrfProtection.blocked_address?(literal_ip)
+      else
+        SsrfProtection.resolve_public_ip(uri.hostname)
+      end
+    end
+
+    def ip_literal(host)
+      IPAddr.new(host)
+    rescue IPAddr::Error
+      nil
+    end
+
+    def http(ip)
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = Webhook::Delivery::ENDPOINT_TIMEOUT
+        http.read_timeout = Webhook::Delivery::ENDPOINT_TIMEOUT
+        http.write_timeout = Webhook::Delivery::ENDPOINT_TIMEOUT
+        http.max_retries = 0 # Never resend a POST: deliver exactly once
+      end
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri, headers).tap { it.body = payload }
+    end
+
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      elsif webhook.for_basecamp?
+        "application/x-www-form-urlencoded"
+      else
+        "application/json"
+      end
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def render_payload(format:)
+      renderer.render(template: "webhooks/event", formats: [ format ], assigns: { event: event }, layout: false).strip
+    end
+
+    def renderer
+      ApplicationController.renderer.new(**renderer_options)
+    end
+
+    def renderer_options
+      url_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+
+      { script_name: event.account.slug }.tap do |options|
+        if url_options[:host].present?
+          options[:http_host] = [ url_options[:host], url_options[:port] ].compact.join(":")
+          options[:https] = url_options.fetch(:protocol, "https").to_s.start_with?("https")
+        end
+      end
+    end
+
+    def html_to_mrkdwn(html)
+      fragment = Nokogiri::HTML5.fragment(html)
+      fragment.css("a").each { |link| link.replace(Nokogiri::XML::Text.new("<#{link["href"]}|#{link.text}>", fragment.document)) }
+      fragment.text.squish
+    end
+end
diff --git a/app/models/webhook/triggerable.rb b/app/models/webhook/triggerable.rb
new file mode 100644
index 0000000..a47c036
--- /dev/null
+++ b/app/models/webhook/triggerable.rb
@@ -0,0 +1,24 @@
+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :triggered_by, ->(event) { where(board: event.board).subscribed_to(event.action) }
+
+    # subscribed_actions is a JSON-serialized array, so this narrows the candidates in SQL
+    # and #triggered_by? confirms the exact match.
+    scope :subscribed_to, ->(action) { where("subscribed_actions LIKE ?", "%#{action.to_s.to_json}%") }
+  end
+
+  def triggered_by?(event)
+    active? && board_id == event.board_id && subscribed_actions.include?(event.action.to_s)
+  end
+
+  # Idempotent: an event produces at most one delivery per webhook.
+  def trigger(event)
+    if triggered_by?(event)
+      deliveries.create_or_find_by!(event: event).tap do |delivery|
+        delivery.deliver_later if delivery.pending?
+      end
+    end
+  end
+end
