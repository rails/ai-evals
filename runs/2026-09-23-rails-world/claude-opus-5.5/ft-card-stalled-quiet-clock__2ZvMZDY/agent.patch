diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..87ff406
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+    @card.board.update!(auto_postpone_period: 30.days)
+    @card.comments.by_user.destroy_all
+    @card.assignments.delete_all
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    comment_as :david, :kevin
+    assert_nil @card.reload.burst
+
+    travel 9.days
+    comment_as :david
+    assert @card.reload.burst.present?
+  end
+
+  test "comments spread beyond a third of the auto-close period are not a burst" do
+    comment_as :david
+    travel 6.days
+    comment_as :kevin
+    travel 6.days
+    comment_as :david
+
+    assert_nil @card.reload.burst
+  end
+
+  test "comments from a single person are not a burst" do
+    comment_as :david, :david, :david, :david
+    assert_nil @card.reload.burst
+  end
+
+  test "assigning is a burst" do
+    @card.toggle_assignment(users(:jz))
+    assert @card.reload.burst.present?
+  end
+
+  test "reopening is a burst" do
+    @card.close
+    @card.reopen
+    assert @card.reload.burst.present?
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    @card.toggle_assignment(users(:jz))
+
+    travel 13.days
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.days
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "a card without a burst never stalls" do
+    travel 1.month
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "any activity resets a stalled card" do
+    @card.toggle_assignment(users(:jz))
+    travel 3.weeks
+    assert @card.reload.stalled?
+
+    comment_as :kevin
+    assert_not @card.reload.stalled?
+    assert_nil @card.burst
+
+    travel 3.weeks
+    assert_not @card.reload.stalled?, "needs a fresh burst to stall again"
+  end
+
+  test "reactions reset a stalled card" do
+    @card.toggle_assignment(users(:jz))
+    travel 3.weeks
+
+    @card.reactions.create!(content: "👍")
+    assert_not @card.reload.stalled?
+  end
+
+  test "activity before the card stalls pushes the stall back" do
+    @card.toggle_assignment(users(:jz))
+    travel 10.days
+    comment_as :kevin
+
+    travel 10.days
+    assert_not @card.reload.stalled?
+
+    travel 5.days
+    assert @card.reload.stalled?
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.toggle_assignment(users(:jz))
+    @card.close
+    travel 3.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "stall state is part of the cache version" do
+    @card.toggle_assignment(users(:jz))
+    version = @card.reload.cache_version
+
+    travel 3.weeks
+    assert_not_equal version, @card.reload.cache_version
+  end
+
+  private
+    def comment_as(*user_names)
+      user_names.each do |name|
+        @card.comments.create!(creator: users(name), body: "Comment by #{name}")
+      end
+    end
+end
