     end
 
+    def export_attributes(record)
+      super.merge("body" => export_body(record.read_attribute_before_type_cast("body")))
+    end
+
+    def export_body(body)
+      body&.gsub(ATTACHMENT_TAG) do |tag|
+        tag.sub(SGID_ATTRIBUTE) do
+          if gid = locate_gid(CGI.unescapeHTML($1))
+            %( gid="#{CGI.escapeHTML(gid)}")
+          else
+            $&
+          end
+        end
+      end
+    end
+
+    def locate_gid(sgid)
+      if gid = SignedGlobalID.parse(sgid, for: ::ActionText::Attachable::LOCATOR_NAME)
+        URI::GID.build(app: gid.app, model_name: gid.model_name, model_id: gid.model_id).to_s
+      end
+    end
+
+    def import_attributes(row)
+      super.merge("body" => import_body(row["body"]))
+    end
+
+    def import_body(body)
+      body&.gsub(ATTACHMENT_TAG) do |tag|
+        if (match = tag.match(GID_ATTRIBUTE)) && (uri = imported_gid(CGI.unescapeHTML(match[1])))
+          import_attachment_tag(tag, uri)
+        else
+          tag.sub(GID_ATTRIBUTE, "")
+        end
+      end
+    end
+
+    def imported_gid(gid)
+      uri = URI::GID.parse(gid)
+      URI::GID.build(app: GlobalID.app, model_name: uri.model_name, model_id: id_map[uri.model_id])
+    rescue URI::Error, Account::DataTransfer::InvalidExport
+      nil
+    end
+
+    def import_attachment_tag(tag, uri)
+      sgid = SignedGlobalID.new(uri, for: ::ActionText::Attachable::LOCATOR_NAME, expires_in: nil).to_s
+      tag = tag.sub(GID_ATTRIBUTE) { %( sgid="#{CGI.escapeHTML(sgid)}") }
+
+      # URLs of files point to the original instance and account, so they're replaced.
+      if uri.model_name == "ActiveStorage::Blob" && tag.match?(URL_ATTRIBUTE)
+        tag.sub(URL_ATTRIBUTE) { %( url="#{CGI.escapeHTML(imported_blob_url(uri.model_id).to_s)}") }
+      else
+        tag
+      end
+    end
+
+    def imported_blob_url(blob_id)
+      if blob = ::ActiveStorage::Blob.find_by(id: blob_id, account: account)
+        Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true, script_name: account.slug)
+      end
+    end
 end
