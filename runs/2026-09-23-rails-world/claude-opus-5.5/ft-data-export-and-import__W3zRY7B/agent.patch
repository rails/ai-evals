+++ b/app/models/card/exportable.rb
@@ -0,0 +1,85 @@
+module Card::Exportable
+  extend ActiveSupport::Concern
+
+  def export_data(files:)
+    {
+      number: number,
+      title: title,
+      board: board.name,
+      column: column&.name,
+      status: export_status,
+      golden: golden?,
+      creator: export_person(creator),
+      assignees: assignees.map { |assignee| export_person(assignee) },
+      tags: tags.map(&:title),
+      steps: steps.map { |step| { content: step.content, completed: step.completed } },
+      description: export_rich_text(description, files: files),
+      image: (files.add(image.blob) if image.attached?),
+      attachments: export_attachments(description, files: files),
+      due_on: due_on,
+      created_at: created_at,
+      updated_at: updated_at,
+      last_active_at: last_active_at,
+      closed_at: closed_at,
+      closed_by: (export_person(closed_by) if closed?),
+      comments: export_comments(files: files)
+    }
+  end
+
+  private
+    def export_status
+      if closed?
+        "closed"
+      elsif postponed?
+        "not_now"
+      elsif awaiting_triage?
+        "awaiting_triage"
+      else
+        "open"
+      end
+    end
+
+    def export_person(user)
+      if user
+        { name: user.name, email_address: user.identity&.email_address }
+      end
+    end
+
+    def export_rich_text(rich_text, files:)
+      if rich_text.present?
+        { html: export_html(rich_text.body, files: files), text: rich_text.to_plain_text }
+      end
+    end
+
+    # Attachments point to the exported files, relative to the card's JSON file, and
+    # mentions become plain names.
+    def export_html(content, files:)
+      content.render_attachments do |attachment|
+        case attachable = attachment.attachable
+        when ActiveStorage::Blob
+          file = files.add(attachable)
+          ApplicationController.helpers.link_to(file[:filename], files.relative_path(file[:path]))
+        when User
+          ERB::Util.html_escape("@#{attachable.name}")
+        else
+          attachment.to_html
+        end
+      end.to_html
+    end
+
+    def export_attachments(rich_text, files:)
+      rich_text&.embeds&.map { |embed| files.add(embed.blob) } || []
+    end
+
+    def export_comments(files:)
+      comments.chronologically.includes(:creator, rich_text_body: { embeds_attachments: :blob }).map do |comment|
+        {
+          creator: export_person(comment.creator),
+          body: export_rich_text(comment.body, files: files),
+          attachments: export_attachments(comment.body, files: files),
+          created_at: comment.created_at,
+          updated_at: comment.updated_at
+        }
+      end
+    end
+end
diff --git a/app/models/card/exportable/files.rb b/app/models/card/exportable/files.rb
