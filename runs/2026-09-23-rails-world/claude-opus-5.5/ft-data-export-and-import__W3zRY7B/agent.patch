index 0000000..4b57f81
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+  end
+
+  test "build attaches a zip file and emails a download link" do
+    assert_enqueued_emails 1 do
+      @export.build
+    end
+
+    assert @export.completed?
+    assert @export.file.attached?
+    assert_equal "application/zip", @export.file.content_type
+    assert_equal "fizzy-37signals-#{Date.current.iso8601}.zip", @export.file.filename.to_s
+  end
+
+  test "build marks the export as failed when something goes wrong" do
+    Account::DataTransfer::Manifest.any_instance.stubs(:each_record_set).raises(RuntimeError, "boom")
+
+    assert_raises(RuntimeError) { @export.build }
+    assert @export.reload.failed?
+  end
+
+  test "exports are downloadable by the person who asked for them, for a day" do
+    @export.build
+
+    assert @export.accessible_to?(users(:kevin))
+    assert_not @export.accessible_to?(users(:jason))
+
+    travel Export::EXPIRES_IN + 1.minute do
+      assert @export.expired?
+      assert_not @export.accessible_to?(users(:kevin))
+    end
+  end
+
+  test "cleanup removes expired exports and their files" do
+    @export.build
+    fresh = Account::Export.create!(account: accounts("37s"), user: users(:kevin)).tap(&:build)
+
+    travel Export::EXPIRES_IN + 1.minute do
+      fresh.update!(completed_at: Time.current)
+
+      assert_difference -> { Export.count }, -1 do
+        perform_enqueued_jobs { Export.cleanup }
+      end
+    end
+
+    assert_not Export.exists?(@export.id)
+    assert Export.exists?(fresh.id)
+  end
+
+  test "account export files are left out of later account exports" do
+    @export.build
+    second = Account::Export.create!(account: accounts("37s"), user: users(:kevin)).tap(&:build)
+
+    Tempfile.create([ "export", ".zip" ], binmode: true) do |file|
+      file.write(second.file.download)
+      file.flush
+
+      File.open(file.path, "rb") do |io|
+        zip = ZipFile::Reader.new(io)
+        assert_not zip.exists?("storage/#{@export.file.key}")
+
+        blob_keys = []
+        zip.each_line("data/active_storage_blobs.jsonl") { |line| blob_keys << JSON.parse(line)["key"] }
+        assert_not_includes blob_keys, @export.file.key
+      end
+    end
+  end
+end
diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
