diff --git a/app/models/user/data_export.rb b/app/models/user/data_export.rb
new file mode 100644
index 0000000..b8dd8df
--- /dev/null
+++ b/app/models/user/data_export.rb
@@ -0,0 +1,36 @@
+# The cards someone can see, each as a JSON file with its comments, along with every
+# picture and file attached to them.
+class User::DataExport < Export
+  private
+    def export_name
+      "#{user.name} cards"
+    end
+
+    def populate_zip(zip)
+      exportable_cards.find_each do |card|
+        add_card_to_zip(zip, card)
+      end
+    end
+
+    def exportable_cards
+      user.accessible_cards.published.includes(
+        :board, :column, :creator, :tags, :assignees, :steps, :closure, :not_now, :goldness,
+        :rich_text_description, image_attachment: :blob
+      )
+    end
+
+    def add_card_to_zip(zip, card)
+      directory = "cards/#{card.number}"
+      files = Card::Exportable::Files.new(directory)
+
+      zip.add_file "#{directory}/card.json", JSON.pretty_generate(card.export_data(files: files).as_json)
+
+      files.each do |path, blob|
+        if blob.service.exist?(blob.key)
+          zip.add_file(path, compress: false) do |sink|
+            blob.download { |chunk| sink.write(chunk) }
