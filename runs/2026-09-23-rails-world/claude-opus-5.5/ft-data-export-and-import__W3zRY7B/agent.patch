     super(account: account, model: Entropy)
   end
+
+  private
+    # The account's own entropy is created along with the account, so it gets updated
+    # instead of inserted.
+    def insert(rows)
+      account_rows, other_rows = rows.partition { |row| row["container_type"] == "Account" }
+
+      account_rows.each do |row|
+        account.entropy.update_columns(auto_postpone_period: row["auto_postpone_period"]) if row["auto_postpone_period"].present?
