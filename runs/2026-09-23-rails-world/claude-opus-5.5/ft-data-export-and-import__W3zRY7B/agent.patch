+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    @card.update!(description: "Look at <strong>this</strong>")
+    @comment = @card.comments.create!(creator: users(:kevin), body: "Nice")
+    embed = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embedded file"), filename: "notes.txt", content_type: "text/plain")
+    @comment.update!(body: "With a file #{ActionText::Content.new("").append_attachables([ embed ]).to_html} and a mention #{ActionText::Content.new("").append_attachables([ users(:jz) ]).to_html}")
+  end
+
+  test "an exported account imports into a new account with everything in it" do
+    import = import_file(export_file)
+
+    assert import.reload.completed?, import.failure_reason
+    account = import.account
+
+    assert_not_equal @source, account
+    assert_equal @source.name, account.name
+    assert_equal @source.boards.count, account.boards.count
+    assert_equal @source.cards.count, account.cards.count
+    assert_equal Comment.where(account: @source).count, Comment.where(account: account).count
+    assert_equal @source.users.count, account.users.count
+    assert_equal @source.cards.maximum(:number), account.cards_count if account.cards_count < @source.cards.maximum(:number).to_i
+
+    imported_card = account.cards.find_by!(number: @card.number)
+    assert_equal @card.title, imported_card.title
+    assert_equal @card.board.name, imported_card.board.name
+    assert_equal @card.creator.identity, imported_card.creator.identity
+    assert_equal "Look this", imported_card.description.to_plain_text.squish.gsub("at ", "")
+    assert imported_card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+
+    imported_comment = imported_card.comments.find_by!(created_at: @comment.created_at)
+    embed = imported_comment.body.embeds.sole.blob
+    assert_equal "embedded file", embed.download
+    assert_equal account, embed.account
+    attachables = imported_comment.body.body.attachables
+    assert_includes attachables, embed
+    assert_includes attachables, account.users.find_by!(identity: users(:jz).identity)
+
+    owner = account.users.find_by!(identity: @identity)
+    assert owner.owner?
+    assert_equal [ owner ], account.users.owner.to_a
+    assert account.users.exists?(role: :system)
+
+    assert_nil import.reload.file.blob
+    assert Search::Record.for(account.id).where(account_id: account.id).exists?
+  end
+
+  test "people are linked to their identities by email address, signing up the ones who are new" do
+    file = export_file
+    identities(:kevin).update!(email_address: "kevin@elsewhere.com")
+
+    assert_difference -> { Identity.count }, +1 do
+      @account = import_file(file).reload.account
+    end
+
+    assert @account.users.find_by!(name: "Kevin").identity.email_address == "kevin@37signals.com"
+    assert_equal identities(:jz), @account.users.find_by!(name: "JZ").identity
+  end
+
+  test "importing a file with an unknown format version fails" do
+    Account::Export.any_instance.stubs(:metadata).returns(format: "fizzy-account", version: 99)
+
+    import = import_file(export_file)
+
+    assert import.reload.failed?
+    assert_match /newer version/, import.failure_reason
+  end
+
+  test "the same export can be imported more than once" do
+    file = export_file
+
+    first = import_file(file).reload.account
+    second = import_file(Rack::Test::UploadedFile.new(file.path, "application/zip", original_filename: "export.zip")).reload.account
+
+    assert_not_equal first, second
+    assert_equal first.cards.count, second.cards.count
+    assert_empty first.cards.ids & second.cards.ids
+  end
+
+  test "an imported account can be exported and imported again" do
+    imported = import_file(export_file).reload.account
+    @source = imported
+
+    reimported = import_file(export_file).reload.account
+
+    assert_equal imported.cards.count, reimported.cards.count
+    assert_equal imported.cards.pluck(:title).sort, reimported.cards.pluck(:title).sort
+    assert reimported.cards.find_by!(number: @card.number).image.attached?
+  end
+
+  test "an invalid file leaves nothing behind" do
+    file = Rack::Test::UploadedFile.new(StringIO.new("not a zip"), "application/zip", original_filename: "export.zip")
+
+    assert_no_difference %w[ Account.count ActiveStorage::Blob.count User.count ] do
+      import = import_file(file)
+
+      assert import.reload.failed?
+      assert_nil import.account
+      assert_match /valid ZIP/, import.failure_reason
+    end
+  end
+
+  test "a failure halfway through leaves nothing behind" do
+    file = export_file
+    identities(:kevin).update!(email_address: "kevin@elsewhere.com") # So the import signs up kevin@37signals.com
+    Account::DataTransfer::ActionText::RichTextRecordSet.any_instance.stubs(:import).raises(RuntimeError, "boom")
+
+    counts = [ Account, Card, Comment, User, Board, Identity, Event, ActiveStorage::Blob, ActiveStorage::Attachment, ActionText::RichText, Storage::Entry ].index_with(&:count)
+
+    import = import_file(file)
+
+    assert import.reload.failed?
+    assert_match /Something went wrong/, import.failure_reason
+    counts.each { |model, count| assert_equal count, model.count, model.name }
+  end
+
+  test "a zip that isn't a Fizzy export fails with a reason" do
+    tempfile = Tempfile.new([ "other", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("hello.txt", "Hello")
+    writer.close
+    tempfile.rewind
+
+    import = import_file(Rack::Test::UploadedFile.new(tempfile.path, "application/zip", original_filename: "other.zip"))
+
+    assert import.reload.failed?
+    assert_equal "This file isn't a Fizzy account export.", import.failure_reason
+  end
+
+  test "failure emails the person importing" do
+    file = Rack::Test::UploadedFile.new(StringIO.new("not a zip"), "application/zip", original_filename: "export.zip")
+
+    assert_emails 1 do
+      import_file(file)
+    end
+  end
+
+  private
+    def export_file
+      export = Account::Export.create!(account: @source, user: @source.users.find_by!(identity: @identity))
+      export.build
+
+      tempfile = Tempfile.new([ "export", ".zip" ])
+      tempfile.binmode
+      tempfile.write(export.file.download)
+      tempfile.rewind
+
+      Rack::Test::UploadedFile.new(tempfile.path, "application/zip", original_filename: "export.zip")
+    end
+
+    def import_file(file)
+      Current.without_account do
+        import = Account::Import.start(identity: @identity, file: file)
+        perform_enqueued_jobs only: ImportAccountDataJob
+        perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+        import
+      end
+    end
+end
