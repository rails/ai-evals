diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..b327073
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,34 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  before_action :ensure_accepting_accounts, only: %i[ new create ]
+
+  rate_limit to: 5, within: 1.hour, only: :create, with: -> { redirect_to new_account_import_path, alert: "Too many imports. Try again later." }
+
+  layout "public"
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Account::Import.start(identity: Current.identity, file: import_params[:file])
+    redirect_to account_import_path(@import)
+  rescue ActiveRecord::RecordInvalid => error
+    @import = error.record
+    render :new, status: :unprocessable_entity
+  end
+
+  def show
+    @import = Current.identity.account_imports.find(params[:id])
+  end
+
+  private
+    def ensure_accepting_accounts
+      redirect_to session_menu_path, alert: "This Fizzy doesn’t accept new accounts." unless Account.accepting_signups?
+    end
+
+    def import_params
+      params.expect(account_import: [ :file ])
+    end
+end
