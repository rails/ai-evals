index 0000000..0dbbb3d
--- /dev/null
+++ b/test/models/account/data_transfer/id_map_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Account::DataTransfer::IdMapTest < ActiveSupport::TestCase
+  setup do
+    @source_id = accounts("37s").id
+    @account = accounts(:initech)
+    @id_map = Account::DataTransfer::IdMap.new(source_account_id: @source_id, account: @account, seed: "one")
+  end
+
+  test "maps the source account to the imported account" do
+    assert_equal @account.id, @id_map[@source_id]
+  end
+
+  test "maps IDs to new, stable, valid IDs" do
+    id = cards(:logo).id
+    new_id = @id_map[id]
+
+    assert_not_equal id, new_id
+    assert_equal new_id, @id_map[id]
+    assert_equal 25, new_id.length
+    assert_equal ActiveRecord::Type::Uuid.base36_to_hex(id).first(12), ActiveRecord::Type::Uuid.base36_to_hex(new_id).first(12)
+  end
+
+  test "different imports get different IDs" do
+    other = Account::DataTransfer::IdMap.new(source_account_id: @source_id, account: @account, seed: "two")
+
+    assert_not_equal @id_map[cards(:logo).id], other[cards(:logo).id]
+    assert_not_equal @id_map.key("abc"), other.key("abc")
+  end
+
+  test "keeps order" do
+    older, newer = ActiveRecord::Type::Uuid.generate, (sleep 0.002; ActiveRecord::Type::Uuid.generate)
+
+    assert @id_map[older] < @id_map[newer]
+  end
+
+  test "nil stays nil" do
+    assert_nil @id_map[nil]
+  end
+
+  test "rejects invalid IDs" do
+    assert_raises(Account::DataTransfer::InvalidExport) { @id_map["not an id!"] }
+  end
+
+  test "remaps references in JSON documents" do
+    id = cards(:logo).id
+
+    assert_equal({ "assignee_ids" => [ @id_map[id] ], "particulars" => { "old_title" => "x" }, "card_id" => @id_map[id] },
+      @id_map.remap_references("assignee_ids" => [ id ], "particulars" => { "old_title" => "x" }, "card_id" => id))
+  end
+end
