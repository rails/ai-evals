+      <span>Import</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <%= link_to "Back to your accounts", session_menu_path, class: "btn btn--plain txt-link center txt-small" %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
