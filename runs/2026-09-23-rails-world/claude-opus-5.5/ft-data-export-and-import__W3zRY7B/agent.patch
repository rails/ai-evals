+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <p class="margin-none">Choose a .zip file exported from Fizzy, in <em>Account Settings</em>. We’ll create a new account with everything in it — boards, cards, comments, files, and people — and email you when it’s done.</p>
+
+  <%= form_with model: @import, url: account_imports_path, scope: :account_import, class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small" style="text-align: left;">
