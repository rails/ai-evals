@@ -1,4 +1,32 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("notes"), filename: "notes.txt", content_type: "text/plain")
+    @card = cards(:logo)
+    @card.update!(description: "See #{ActionText::Content.new("").append_attachables([ @blob, users(:kevin) ]).to_html}")
+    @record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(@account)
+  end
+
+  test "exports attachments with plain global IDs instead of signed ones" do
+    body = @record_set.send(:export_body, @card.description.read_attribute_before_type_cast("body"))
+
+    assert_not_includes body, "sgid="
+    assert_includes body, %(gid="gid://fizzy/ActiveStorage::Blob/#{@blob.id}")
+    assert_includes body, %(gid="gid://fizzy/User/#{users(:kevin).id}")
+  end
+
+  test "imports attachments signed for the imported records" do
+    account = Account.create!(name: "Imported")
+    id_map = Account::DataTransfer::IdMap.new(source_account_id: @account.id, account: account, seed: "seed")
+    exported = @record_set.send(:export_body, @card.description.read_attribute_before_type_cast("body"))
+
+    record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(account)
+    imported = record_set.send(:with_id_map, id_map) { record_set.send(:import_body, exported) }
+
+    sgids = imported.scan(/sgid="([^"]*)"/).flatten.map { |sgid| SignedGlobalID.parse(CGI.unescapeHTML(sgid), for: "attachable") }
+    assert_equal [ id_map[@blob.id], id_map[users(:kevin).id] ], sgids.map(&:model_id)
+    assert_not_includes imported, " gid="
+  end
 end
