@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "new" do
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :success
+    assert_select "input[type=file][name='account_import[file]']"
+  end
+
+  test "requires signing in" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :redirect
+  end
+
+  test "create starts importing into a new account" do
+    untenanted do
+      assert_difference -> { Account.count } => +1, -> { Account::Import.count } => +1 do
+        assert_enqueued_with job: ImportAccountDataJob do
+          post account_imports_path, params: { account_import: { file: fixture_file_upload("moon.jpg", "application/zip").tap { |file| file.original_filename.replace("export.zip") } } }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_equal identities(:david), import.identity
+    assert import.file.attached?
+    assert_redirected_to account_import_path(import, script_name: nil)
+
+    get account_import_path(import, script_name: nil)
+
+    assert_response :success
+    assert_match /Importing your account/, response.body
+  end
+
+  test "create rejects files that aren't zip files" do
+    untenanted do
+      assert_no_difference -> { Account.count } do
+        post account_imports_path, params: { account_import: { file: fixture_file_upload("moon.jpg", "image/jpeg") } }
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "show a failed import with the reason" do
+    import = Account::Import.new(identity: identities(:david), status: :failed, failure_reason: "This file isn't a Fizzy account export.")
+    import.save!(validate: false)
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :success
+    assert_match "This file isn't a Fizzy account export.", CGI.unescapeHTML(response.body)
+  end
+
+  test "show a completed import with a link to the account" do
+    import = Account::Import.new(identity: identities(:david), account: accounts(:initech), status: :completed)
+    import.save!(validate: false)
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :success
+    assert_select "a[href^='#{accounts(:initech).slug}']"
+  end
+
+  test "can't see someone else's import" do
+    import = Account::Import.new(identity: identities(:kevin), status: :failed, failure_reason: "Nope")
+    import.save!(validate: false)
+
+    untenanted do
+      get account_import_path(import)
+    end
+
+    assert_response :not_found
+  end
+
+  test "imports aren't available when not accepting new accounts" do
+    with_multi_tenant_mode(false) do
+      untenanted do
+        get new_account_import_path
+      end
+    end
+
+    assert_response :redirect
+  end
+end
