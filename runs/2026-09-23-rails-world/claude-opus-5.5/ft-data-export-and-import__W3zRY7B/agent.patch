+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @card = cards(:logo)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    embed = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("notes"), filename: "notes.txt", content_type: "text/plain")
+    @card.comments.create!(creator: users(:kevin), body: "See #{ActionText::Content.new("").append_attachables([ embed ]).to_html}")
+  end
+
+  test "exports the cards the user can see as JSON, with comments and attached files" do
+    export = @user.data_exports.create!(account: @user.account)
+    export.build
+
+    read_zip(export) do |zip|
+      accessible_numbers = @user.accessible_cards.published.pluck(:number).sort
+      assert_equal accessible_numbers.map { |number| "cards/#{number}/card.json" }, zip.glob("cards/*/card.json").sort_by { |path| path[/\d+/].to_i }
+
+      card = JSON.parse(zip.read("cards/#{@card.number}/card.json"))
+      assert_equal @card.title, card["title"]
+      assert_equal @card.board.name, card["board"]
+      assert_equal "cards/#{@card.number}/files/moon.jpg", card["image"]["path"]
+      assert_equal file_fixture("moon.jpg").binread.b, zip.read(card["image"]["path"]).b
+
+      comment = card["comments"].last
+      assert_equal "Kevin", comment["creator"]["name"]
+      assert_equal "notes.txt", comment["attachments"].sole["filename"]
+      assert_includes comment["body"]["html"], %(<a href="files/notes.txt">notes.txt</a>)
+      assert_equal "notes", zip.read(comment["attachments"].sole["path"])
+    end
+  end
+
+  test "leaves out cards on boards the user can't access" do
+    inaccessible = @card
+    @user.accesses.where(board: inaccessible.board).destroy_all
+
+    export = @user.data_exports.create!(account: @user.account).tap(&:build)
+
+    read_zip(export) do |zip|
+      assert_not zip.exists?("cards/#{inaccessible.number}/card.json")
+    end
+  end
+
+  private
+    def read_zip(export)
+      Tempfile.create([ "export", ".zip" ], binmode: true) do |file|
+        file.write(export.file.download)
+        file.flush
+        File.open(file.path, "rb") { |io| yield ZipFile::Reader.new(io) }
+      end
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..7ad69df 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -38,3 +38,72 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
 end
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  setup do
+    @tempfile = Tempfile.new([ "test", ".zip" ])
+    @tempfile.binmode
+
+    writer = ZipFile::Writer.new(@tempfile)
+    writer.add_file("data/records.jsonl") { |sink| 3.times { |n| sink.write(%({"n":#{n}}\n)) } }
+    writer.add_file("storage/file", "stored content", compress: false)
+    writer.close
+    @tempfile.flush
+  end
+
+  teardown do
+    @tempfile.close!
+  end
+
+  test "reads entries written by the writer" do
+    File.open(@tempfile.path, "rb") do |io|
+      reader = ZipFile::Reader.new(io)
+
+      assert reader.exists?("storage/file")
+      assert_equal [ "data/records.jsonl" ], reader.glob("data/*.jsonl")
+      assert_equal "stored content", reader.read("storage/file")
+    end
+  end
+
+  test "reads lines while reading other entries" do
+    File.open(@tempfile.path, "rb") do |io|
+      reader = ZipFile::Reader.new(io)
+      lines = []
+
+      reader.each_line("data/records.jsonl") do |line|
+        lines << JSON.parse(line)["n"]
+        assert_equal "stored content", reader.read("storage/file")
+      end
+
+      assert_equal [ 0, 1, 2 ], lines
+    end
+  end
+
+  test "limits how much is read" do
+    File.open(@tempfile.path, "rb") do |io|
+      assert_raises(ZipFile::Reader::EntryTooLarge) { ZipFile::Reader.new(io).read("storage/file", limit: 5) }
+    end
+  end
+
+  test "raises on files that aren't zip files" do
+    assert_raises(ZipFile::Reader::Error) { ZipFile::Reader.new(StringIO.new("not a zip")) }
+  end
+
+  test "raises on missing entries" do
+    File.open(@tempfile.path, "rb") do |io|
+      assert_raises(ZipFile::Reader::EntryNotFound) { ZipFile::Reader.new(io).read("missing") }
+    end
+  end
+
+  test "reads blobs stored in any service" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: File.open(@tempfile.path, "rb"), filename: "test.zip")
+
+    ZipFile.read_from(blob) do |reader|
+      assert_equal "stored content", reader.read("storage/file")
+    end
+
+    reader = ZipFile::Reader.new(ZipFile::RemoteIO.new(blob))
+    assert_equal "stored content", reader.read("storage/file")
+    assert_equal 3, reader.to_enum(:each_line, "data/records.jsonl").count
+  end
+end
