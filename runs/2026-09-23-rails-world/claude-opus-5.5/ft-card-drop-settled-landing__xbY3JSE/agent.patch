+require "test_helper"
+
+class Columns::Cards::Drops::ClosuresControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post columns_card_drops_closure_path(card), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(card, :article)
+    assert_turbo_stream action: :replace, target: "closed-cards-count"
+  end
+end
diff --git a/test/controllers/columns/cards/drops/columns_controller_test.rb b/test/controllers/columns/cards/drops/columns_controller_test.rb
