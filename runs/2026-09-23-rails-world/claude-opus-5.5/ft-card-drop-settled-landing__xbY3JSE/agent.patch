diff --git a/app/controllers/concerns/card_droppable.rb b/app/controllers/concerns/card_droppable.rb
new file mode 100644
index 0000000..c981e54
--- /dev/null
+++ b/app/controllers/concerns/card_droppable.rb
@@ -0,0 +1,19 @@
+# Drag and drop on the board is optimistic: the browser has already moved the
+# card when these requests arrive. So instead of re-rendering whole columns (which
+# would reshuffle what the person just arranged), we only refresh the dropped card
+# itself and the column counts.
+module CardDroppable
+  extend ActiveSupport::Concern
+
+  included do
+    include CardScoped
+  end
+
+  private
+    def render_drop
+      respond_to do |format|
+        format.turbo_stream { render "columns/cards/drops/create" }
+        format.json { head :no_content }
+      end
+    end
+end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..9d0d796
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,225 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+const DRAG_DATA_TYPE = "application/x-fizzy-card"
+const CARD_PLACEHOLDER = "__card__"
+
+// Moves cards between the board columns (Maybe?, Not Now, Done and the regular columns).
+//
+// Drops are optimistic: the card is moved, restyled and counted in its new column right
+// away, in the same spot the server will list it, so nothing moves around once the save
+// lands. The server only answers with a refreshed card and authoritative counts.
+// Columns keep their own order, so dropping a card into the column it came from does nothing.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #pendingDrops = Promise.resolve()
+
+  // Actions
+
+  async dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    const container = item && this.#containerContaining(item)
+
+    if (!container) return
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData(DRAG_DATA_TYPE, item.dataset.dragAndDropCardNumber)
+
+    this.draggedItem = item
+    this.sourceContainer = container
+
+    // Wait so the browser snapshots the drag image before the card dims
+    await nextFrame()
+    if (this.draggedItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#dropContainerFor(event.target)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (this.draggedItem && !this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#dropContainerFor(event.target)
+
+    if (container) {
+      event.preventDefault()
+      this.#move(this.draggedItem, this.sourceContainer, container)
+    }
+
+    this.#finishDrag()
+  }
+
+  dragEnd() {
+    this.#finishDrag()
+  }
+
+  // Private
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerContaining(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+
+  #dropContainerFor(element) {
+    const container = element instanceof Node && this.#containerContaining(element)
+    return container && container !== this.sourceContainer ? container : null
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(each => each.classList.toggle(this.hoverContainerClass, each === container))
+  }
+
+  #finishDrag() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  #move(item, source, target) {
+    const original = { clone: item.cloneNode(true), parent: item.parentNode, nextSibling: item.nextSibling }
+    original.clone.classList.remove(this.draggedItemClass)
+
+    this.#adjustCount(source, -1)
+    this.#adjustCount(target, +1)
+    this.#restyle(item, target)
+    const placed = this.#place(item, target)
+
+    this.#enqueue(async () => {
+      if (await this.#save(item, target)) {
+        if (!placed) this.#reloadFramesIn(target)
+      } else {
+        this.#revert(item, original, source, target)
+      }
+    })
+  }
+
+  #adjustCount(container, delta) {
+    const counter = container.querySelector(".cards__expander-count[data-count]")
+
+    if (counter) {
+      const count = Math.max(0, parseInt(counter.dataset.count, 10) + delta)
+      counter.dataset.count = count
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  // Make the card look like it belongs to its new column before the server confirms it
+  #restyle(item, container) {
+    const { dragAndDropCardColor: color, dragAndDropColumnId: columnId, dragAndDropClosed: closed, dragAndDropPostponed: postponed } = container.dataset
+
+    if (color) item.style.setProperty("--card-color", color)
+
+    item.classList.toggle("card--postponed", !!postponed)
+    item.classList.toggle("card--active", !closed && !postponed)
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+
+    if (!closed) {
+      item.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+        stage.classList.toggle("card__column-name--current", stage.dataset.columnId === columnId)
+      })
+    }
+
+    this.#setColumnLabel(item, columnId ? container.dataset.columnName : null)
+  }
+
+  #setColumnLabel(item, name) {
+    const header = item.querySelector(".card__header")
+    let label = header?.querySelector(":scope > .card__column-name--current")
+
+    if (name && header) {
+      if (!label) {
+        label = document.createElement("span")
+        label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        label.append(Object.assign(document.createElement("span"), { className: "overflow-ellipsis" }))
+        header.append(label)
+      }
+      label.firstElementChild.textContent = name
+    } else {
+      label?.remove()
+    }
+  }
+
+  // Insert the card where the server lists it: the moved card is the most recently
+  // active one, so it goes first — after the golden cards in columns that pin them on top.
+  #place(item, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (!list) {
+      item.remove()
+      return false
+    }
+
+    const cards = Array.from(list.querySelectorAll("[data-drag-and-drop-target~='item']")).filter(card => card !== item)
+    const lastGolden = "dragAndDropGoldenFirst" in container.dataset && !this.#isGolden(item) ?
+      cards.filter(card => this.#isGolden(card)).at(-1) : null
+
+    if (lastGolden) {
+      lastGolden.after(item)
+    } else if (cards.length > 0) {
+      cards[0].before(item)
+    } else {
+      list.prepend(item)
+    }
+
+    return true
+  }
+
+  #isGolden(card) {
+    return card.classList.contains("golden-effect")
+  }
+
+  #enqueue(fn) {
+    // Saves run one after another so their responses land in the order the drops happened
+    this.#pendingDrops = this.#pendingDrops.then(fn, fn)
+  }
+
+  async #save(item, container) {
+    const url = container.dataset.dragAndDropUrl.replace(CARD_PLACEHOLDER, encodeURIComponent(item.dataset.dragAndDropCardNumber))
+
+    try {
+      const response = await post(url, { responseKind: "turbo-stream" })
+      return response.ok
+    } catch (error) {
+      console.error("Couldn't move the card", error)
+      return false
+    }
+  }
+
+  #reloadFramesIn(container) {
+    container.querySelectorAll("turbo-frame[src]").forEach(frame => frame.reload())
+  }
+
+  #revert(item, original, source, target) {
+    this.#adjustCount(source, +1)
+    this.#adjustCount(target, -1)
+
+    if (original.parent.isConnected) {
+      const nextSibling = original.nextSibling?.parentNode === original.parent ? original.nextSibling : null
+      original.parent.insertBefore(original.clone, nextSibling)
+    }
+
+    item.remove()
+  }
+}
