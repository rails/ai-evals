diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..fef078a
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,175 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @board = boards(:writebook)
+  end
+
+  test "dropping a card into a column updates the board before the save finishes" do
+    card, neighbor, column = cards(:buy_domain), cards(:text), columns(:writebook_in_progress)
+    visit_board
+
+    delay_saves
+    drag card, to: "##{dom_id(column)}"
+
+    # Already in place, before the server answers
+    assert_equal "pending", saves_state
+    assert_card_order [ card, neighbor ], in: "##{dom_id(column)}"
+    assert_count 2, in: "##{dom_id(column)}"
+    assert_count 0, in: "#maybe"
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_no_selector ".drag-and-drop__dragged-item"
+
+    release_saves
+    wait_until { card.reload.column == column }
+
+    # And nothing moves once it does
+    assert_card_order [ card, neighbor ], in: "##{dom_id(column)}"
+    assert_count 2, in: "##{dom_id(column)}"
+    assert_count 0, in: "#maybe"
+  end
+
+  test "dropping a card into Done, Not Now and back into Maybe?" do
+    card = cards(:logo)
+    visit_board
+
+    drag card, to: "#closed-cards"
+    assert_card_order [ card ], in: "#closed-cards", partial: true
+    wait_until { card.reload.closed? }
+    assert_selector "##{dom_id(card, :article)} .card__closed", visible: :all, wait: 5
+
+    drag card, to: "#not-now"
+    assert_card_order [ card ], in: "#not-now", partial: true
+    wait_until { card.reload.postponed? }
+
+    drag card, to: "#maybe"
+    assert_card_order [ card, cards(:buy_domain) ], in: "#maybe"
+    wait_until { card.reload.awaiting_triage? }
+    assert_no_selector "##{dom_id(card, :article)} .card__closed", visible: :all
+  end
+
+  test "golden cards stay on top" do
+    golden = cards(:buy_domain).tap(&:gild)
+    card, golden_card = cards(:layout), cards(:logo)
+    visit_board
+
+    drag card, to: "#maybe"
+    assert_card_order [ golden, card ], in: "#maybe"
+    wait_until { card.reload.awaiting_triage? }
+
+    drag golden_card, to: "#maybe"
+    assert_card_order [ golden_card, golden, card ], in: "#maybe"
+    wait_until { golden_card.reload.awaiting_triage? }
+
+    sleep 0.5
+    assert_card_order [ golden_card, golden, card ], in: "#maybe"
+    assert_equal [ golden_card, golden, card ], @board.cards.awaiting_triage.latest.with_golden_first.to_a
+  end
+
+  test "dropping a card back into its own column does nothing" do
+    card = cards(:buy_domain)
+    visit_board
+
+    drag card, to: "#maybe"
+
+    assert_card_order [ card ], in: "#maybe"
+    assert_count 1, in: "#maybe"
+    sleep 0.5
+    assert card.reload.awaiting_triage?
+  end
+
+  test "while dragging, the column under the pointer lights up and the card dims" do
+    card, column = cards(:buy_domain), columns(:writebook_in_progress)
+    visit_board
+
+    page.execute_script(<<~JS, "##{dom_id(card, :article)}", "##{dom_id(column)}")
+      window.dragTransfer = new DataTransfer()
+      window.fireDrag = (selector, type) => document.querySelector(selector).dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer: window.dragTransfer }))
+      fireDrag(arguments[0], "dragstart")
+    JS
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    page.execute_script("fireDrag(\"#maybe .cards__list\", \"dragover\")")
+    assert_no_selector ".drag-and-drop__hover-container"
+
+    page.execute_script("fireDrag(\"##{dom_id(column)}\", \"dragover\")")
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+
+    page.execute_script("fireDrag(\"##{dom_id(card, :article)}\", \"dragend\")")
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_card_order [ card ], in: "#maybe"
+    assert card.reload.awaiting_triage?
+  end
+
+  test "a failed save puts the card back" do
+    card, column = cards(:buy_domain), columns(:writebook_in_progress)
+    visit_board
+
+    card.destroy!
+    drag card, to: "##{dom_id(column)}"
+
+    wait_until { page.evaluate_script("!!document.querySelector('#maybe ##{dom_id(card, :article)}')") }
+    assert_count 1, in: "#maybe"
+    assert_count 1, in: "##{dom_id(column)}"
+  end
+
+  private
+    def visit_board
+      visit board_url(@board)
+      assert_selector "##{dom_id(cards(:text), :article)}", visible: :all
+      assert_selector "##{dom_id(cards(:logo), :article)}", visible: :all
+      assert_selector "##{dom_id(cards(:shipping), :article)}", visible: :all
+    end
+
+    def drag(card, to:)
+      page.execute_script(<<~JS, "##{dom_id(card, :article)}", to)
+        const [ source, target ] = [ document.querySelector(arguments[0]), document.querySelector(arguments[1]) ]
+        const dataTransfer = new DataTransfer()
+        const fire = (element, type) => element.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+
+        fire(source, "dragstart")
+        fire(target, "dragover")
+        fire(target, "drop")
+        fire(source, "dragend")
+      JS
+    end
+
+    def delay_saves
+      page.execute_script(<<~JS)
+        window.savesState = "pending"
+        import("@rails/request.js").then(({ RequestInterceptor }) => {
+          RequestInterceptor.register(() => new Promise(resolve => window.releaseSaves = () => { window.savesState = "released"; resolve() }))
+        })
+      JS
+      wait_until { page.evaluate_script("typeof window.releaseSaves === 'undefined'") }
+    end
+
+    def release_saves
+      wait_until { page.evaluate_script("typeof window.releaseSaves === 'function'") }
+      page.execute_script("window.releaseSaves()")
+    end
+
+    def saves_state
+      page.evaluate_script("window.savesState")
+    end
+
+    def assert_card_order(cards, in:, partial: false)
+      ids = page.evaluate_script(<<~JS)
+        Array.from(document.querySelectorAll("#{binding.local_variable_get(:in)} .cards__list .card")).map(card => card.id)
+      JS
+      expected = cards.map { dom_id(it, :article) }
+      partial ? assert_equal(expected, ids.first(expected.size)) : assert_equal(expected, ids)
+    end
+
+    def assert_count(count, in:)
+      assert_equal count.to_s, page.evaluate_script("document.querySelector('#{binding.local_variable_get(:in)} .cards__expander-count').textContent.trim()")
+    end
+
+    def wait_until(timeout: 5)
+      Timeout.timeout(timeout) { sleep 0.05 until yield }
+    end
+end
