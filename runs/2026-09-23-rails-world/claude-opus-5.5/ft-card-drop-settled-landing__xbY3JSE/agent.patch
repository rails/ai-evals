index 0000000..875447e
--- /dev/null
+++ b/test/controllers/columns/cards/drops/columns_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Columns::Cards::Drops::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, from: columns(:writebook_triage), to: column do
+      post columns_card_drops_column_path(card, column_id: column.id), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(card, :article)
+    assert_turbo_stream action: :replace, target: "#{dom_id(column)}-count"
+    assert_turbo_stream action: :replace, target: "#{dom_id(columns(:writebook_triage))}-count"
+    assert_turbo_stream action: :replace, target: "maybe-count"
+  end
+
+  test "create reopens and resumes the card" do
+    card = cards(:logo)
+    card.close(user: users(:kevin))
+    column = columns(:writebook_in_progress)
+
+    post columns_card_drops_column_path(card, column_id: column.id), as: :turbo_stream
+
+    assert_response :success
+    assert card.reload.active?
+    assert_equal column, card.column
+  end
+
+  test "create moves the card to the top of its new column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    post columns_card_drops_column_path(card, column_id: column.id), as: :turbo_stream
+
+    assert_equal card, column.cards.active.latest.with_golden_first.first
+  end
+
+  test "create requires a column from the card board" do
+    card = cards(:logo)
+    other_column = boards(:private).columns.create!(name: "Elsewhere")
+
+    post columns_card_drops_column_path(card, column_id: other_column.id), as: :turbo_stream
+
+    assert_response :not_found
+    assert_equal columns(:writebook_triage), card.reload.column
+  end
+
+  test "create as JSON" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    post columns_card_drops_column_path(card, column_id: column.id), as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+end
