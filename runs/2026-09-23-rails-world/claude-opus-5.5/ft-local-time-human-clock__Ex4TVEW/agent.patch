diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..66fd438
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,80 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, fullLocalTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+const connectedControllers = new Set
+let refreshTimer
+
+// Renders a server-provided UTC timestamp in the viewer's timezone. See
+// TimeHelper#local_datetime_tag. When the `attribute` value is present, the
+// formatted time is written to that attribute instead of the element's text.
+export default class extends Controller {
+  static values = { datetime: String, format: { type: String, default: "relative" }, attribute: String }
+
+  connect() {
+    this.render()
+    startRefreshing(this)
+  }
+
+  disconnect() {
+    stopRefreshing(this)
+  }
+
+  datetimeValueChanged() {
+    this.render()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const date = this.#date
+    const text = formatLocalTime(date, this.formatValue)
+
+    if (text) {
+      if (this.hasAttributeValue) {
+        this.#write(this.attributeValue, text)
+      } else {
+        if (this.element.textContent !== text) this.element.textContent = text
+        this.#write("title", fullLocalTime(date))
+      }
+    }
+  }
+
+  get #date() {
+    return new Date(this.hasDatetimeValue ? this.datetimeValue : this.element.getAttribute("datetime"))
+  }
+
+  #write(attribute, value) {
+    if (this.element.getAttribute(attribute) !== value) {
+      this.element.setAttribute(attribute, value)
+    }
+  }
+}
+
+function startRefreshing(controller) {
+  connectedControllers.add(controller)
+
+  if (!refreshTimer) {
+    refreshTimer = setInterval(refreshAll, REFRESH_INTERVAL)
+    document.addEventListener("visibilitychange", refreshAll)
+  }
+}
+
+function stopRefreshing(controller) {
+  connectedControllers.delete(controller)
+
+  if (connectedControllers.size === 0) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+    document.removeEventListener("visibilitychange", refreshAll)
+  }
+}
+
+function refreshAll() {
+  if (document.visibilityState !== "hidden") {
+    connectedControllers.forEach(controller => controller.render())
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..a618f4c
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,108 @@
+// Formats timestamps in the viewer's own timezone. The server renders raw UTC
+// timestamps (see TimeHelper#local_datetime_tag) so its HTML can be cached and
+// shared, and the browser turns them into words here.
+
+const LOCALE = "en-US"
+const MILLISECONDS_PER_DAY = 1000 * 60 * 60 * 24
+const CLOCK_SKEW_TOLERANCE = 1000 * 60 // Treat timestamps up to a minute ahead as "now"
+const DAYS_AGO_LIMIT = 6
+
+const FORMATS = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  dateWithYear: { month: "short", day: "numeric", year: "numeric" },
+  shortDatetime: { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" },
+  full: { weekday: "long", month: "long", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" },
+  dayParts: { year: "numeric", month: "numeric", day: "numeric" }
+}
+
+export function formatLocalTime(date, format = "relative", { now = new Date(), timeZone } = {}) {
+  if (!isValidDate(date)) return null
+
+  switch (format) {
+    case "relative": return relativeTime(date, now, timeZone)
+    case "date":     return shortDate(date, now, timeZone)
+    default:         return formatWith(format in FORMATS ? format : "dateWithYear", date, timeZone)
+  }
+}
+
+export function fullLocalTime(date, { timeZone } = {}) {
+  return isValidDate(date) ? formatWith("full", date, timeZone) : null
+}
+
+// Whole calendar days from `fromDate` to `toDate` in the viewer's timezone.
+export function calendarDaysBetween(fromDate, toDate, timeZone) {
+  return Math.round((dayNumber(toDate, timeZone) - dayNumber(fromDate, timeZone)) / MILLISECONDS_PER_DAY)
+}
+
+function relativeTime(date, now, timeZone) {
+  const days = calendarDaysBetween(date, now, timeZone)
+
+  if (days === 0) {
+    return date - now > CLOCK_SKEW_TOLERANCE ? "today" : formatWith("time", date, timeZone)
+  } else if (days > 0) {
+    return pastDays(days, date, now, timeZone)
+  } else {
+    return futureDays(-days)
+  }
+}
+
+function pastDays(days, date, now, timeZone) {
+  if (days === 1) {
+    return "yesterday"
+  } else if (days <= DAYS_AGO_LIMIT) {
+    return `${days} days ago`
+  } else {
+    return shortDate(date, now, timeZone)
+  }
+}
+
+function futureDays(days) {
+  return days === 1 ? "tomorrow" : `in ${days} days`
+}
+
+function shortDate(date, now, timeZone) {
+  const sameYear = dayParts(date, timeZone).year === dayParts(now, timeZone).year
+  return formatWith(sameYear ? "date" : "dateWithYear", date, timeZone)
+}
+
+function dayNumber(date, timeZone) {
+  const { year, month, day } = dayParts(date, timeZone)
+  return Date.UTC(year, month - 1, day)
+}
+
+function dayParts(date, timeZone) {
+  return formatter("dayParts", timeZone).formatToParts(date).reduce((parts, { type, value }) => {
+    if (type !== "literal") parts[type] = parseInt(value, 10)
+    return parts
+  }, {})
+}
+
+function formatWith(format, date, timeZone) {
+  // Some engines separate the time from "AM"/"PM" with a narrow no-break space
+  return formatter(format, timeZone).format(date).replace(/[\u202f\u00a0]/g, " ")
+}
+
+const formatters = new Map
+
+function formatter(format, timeZone) {
+  const key = `${format}:${timeZone ?? ""}`
+
+  if (!formatters.has(key)) {
+    formatters.set(key, buildFormatter(FORMATS[format], timeZone))
+  }
+
+  return formatters.get(key)
+}
+
+function buildFormatter(options, timeZone) {
+  try {
+    return new Intl.DateTimeFormat(LOCALE, { ...options, timeZone })
+  } catch {
+    return new Intl.DateTimeFormat(LOCALE, options)
+  }
+}
+
+function isValidDate(date) {
+  return date instanceof Date && !isNaN(date)
+}
