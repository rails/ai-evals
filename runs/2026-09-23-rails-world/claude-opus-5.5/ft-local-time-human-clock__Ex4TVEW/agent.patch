+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    @card = cards(:logo)
+    @card.comments.destroy_all
+  end
+
+  test "times are rendered in the browser" do
+    @card.comments.create!(body: "Earlier this week", creator: users(:david), created_at: 3.days.ago)
+    @card.update_columns created_at: 20.days.ago, last_active_at: 3.days.ago
+    entropies(:writebook_board).update! auto_postpone_period: 7.days
+
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    within(".comment__permalink-title") { assert_selector "time", text: "3 days ago" }
+    assert_selector ".card__meta-text--added time", text: /\A#{browser_format(@card.created_at, **short_date_options(@card.created_at))}\z/i
+    assert_selector ".card__meta-text--updated time", text: /\A3 days ago\z/i
+    assert_selector ".card-perma__closure-message time", text: "in 4 days"
+  end
+
+  test "recent times read as the time of day" do
+    comment = @card.comments.create!(body: "Just now", creator: users(:david))
+
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    within(".comment__permalink-title") { assert_selector "time", text: browser_format(comment.created_at, hour: "numeric", minute: "2-digit") }
+  end
+
+  private
+    def short_date_options(time)
+      { month: "short", day: "numeric" }.tap do |options|
+        options[:year] = "numeric" unless time.year == Time.current.year
+      end
+    end
+
+    def browser_format(time, **options)
+      page.evaluate_script(<<~JS)
+        new Intl.DateTimeFormat("en-US", #{options.to_json}).format(new Date(#{(time.to_f * 1000).to_i})).replace(/\s/g, " ")
+      JS
+    end
+end
