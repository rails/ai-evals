diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..63bf98e
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local datetime tag renders a timezone-neutral time element" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    html = Time.use_zone("Tokyo") { local_datetime_tag(time.in_time_zone, format: :short_datetime, class: "stamp") }
+
+    assert_dom_equal \
+      %(<time datetime="2025-09-12T13:42:00Z" class="stamp" data-controller="local-time" data-local-time-format-value="shortDatetime">Sep 12, 2025</time>),
+      html
+  end
+
+  test "local datetime tag is the same whatever the server timezone" do
+    time = Time.utc(2025, 9, 12, 23, 30)
+
+    assert_equal \
+      Time.use_zone("UTC") { local_datetime_tag(time.in_time_zone) },
+      Time.use_zone("Pacific/Auckland") { local_datetime_tag(time.in_time_zone) }
+  end
+
+  test "local datetime tag keeps other controllers" do
+    html = local_datetime_tag(Time.current, data: { controller: "tooltip" })
+    assert_match %(data-controller="local-time tooltip"), html
+  end
+
+  test "local datetime data formats into an attribute" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    expected = { controller: "local-time", local_time_datetime_value: "2025-09-12T13:42:00Z", local_time_format_value: "dateWithYear", local_time_attribute_value: "data-bridge-description" }
+    assert_equal expected, local_datetime_data(time, format: :date_with_year, attribute: "data-bridge-description")
+  end
+end
