diff --git a/app/controllers/concerns/card_dropping.rb b/app/controllers/concerns/card_dropping.rb
new file mode 100644
index 0000000..56fa118
--- /dev/null
+++ b/app/controllers/concerns/card_dropping.rb
@@ -0,0 +1,14 @@
+# Drops happen on the board, where the card has already been moved into place
+# by the time the request arrives. We only refresh the card itself, in place,
+# so that the rest of the board stays exactly as the person left it.
+module CardDropping
+  extend ActiveSupport::Concern
+
+  include CardScoped
+
+  private
+    def render_dropped_card
+      # Every preview of the card (the board, and the pins tray) gets refreshed
+      render turbo_stream: turbo_stream.replace_all("##{helpers.dom_id(@card, :article)}", partial: "cards/display/preview", method: :morph, locals: { card: @card.reload })
+    end
+end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..cba7efb
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,238 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves cards between columns (or statuses) on the board.
+//
+// Columns keep their own order, so a card can only be dropped on a different
+// container, and it lands where the server would put it: at the top, after
+// golden cards for containers that sort golden cards first.
+//
+// The move is applied optimistically when the card is dropped: the card is
+// placed, restyled and counted before the request is sent. The server only
+// morphs the card itself in place, so nothing moves after the drop. If the
+// request fails, the move is undone.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static DATA_TYPE = "application/x-fizzy-card"
+
+  async dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    const sourceContainer = item && this.#containerContaining(item)
+    if (!sourceContainer) return
+
+    this.draggedItem = item
+    this.sourceContainer = sourceContainer
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData(this.constructor.DATA_TYPE, item.dataset.dragAndDropCard)
+    if (event.target !== item) {
+      const rect = item.getBoundingClientRect()
+      event.dataTransfer.setDragImage(item, event.clientX - rect.left, event.clientY - rect.top)
+    }
+
+    // Wait so the browser captures the drag image before we dim the card
+    await nextFrame()
+    if (this.draggedItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#droppableContainerAt(event.target)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (this.draggedItem && !this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#droppableContainerAt(event.target)
+    if (!container) return
+
+    event.preventDefault()
+    this.#move(this.draggedItem, this.sourceContainer, container)
+    this.dragEnd()
+  }
+
+  dragEnd() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  // Private
+
+  #move(item, source, target) {
+    const url = target.dataset.dragAndDropUrl.replace("__card__", encodeURIComponent(item.dataset.dragAndDropCard))
+    const undo = this.#moveOptimistically(item, source, target)
+
+    this.#submit(url).then(succeeded => {
+      if (!succeeded) undo()
+    })
+  }
+
+  #moveOptimistically(item, source, target) {
+    const original = item.cloneNode(true)
+    const originalParent = item.parentNode
+    const originalNextSibling = item.nextSibling
+
+    original.classList.remove(this.draggedItemClass)
+
+    this.#insert(item, target)
+    this.#restyle(item, target)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(target, +1)
+
+    return () => {
+      if (originalParent.isConnected) {
+        item.remove()
+        originalParent.insertBefore(original, originalNextSibling?.parentNode === originalParent ? originalNextSibling : null)
+        this.#adjustCount(source, +1)
+        this.#adjustCount(target, -1)
+      }
+    }
+  }
+
+  async #submit(url) {
+    try {
+      const response = await post(url, { responseKind: "turbo-stream" })
+      return response.ok
+    } catch (error) {
+      console.error(error)
+      return false
+    }
+  }
+
+  // Place the card where the server will sort it: at the top, after golden
+  // cards when the container shows golden cards first.
+  #insert(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) {
+      // Cards haven't loaded yet; they will include this card once they do
+      item.remove()
+      return
+    }
+
+    const items = this.#itemsIn(list).filter(it => it !== item)
+    const goldenFirst = container.hasAttribute("data-drag-and-drop-golden-first")
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (goldenFirst && !isGolden) {
+      const firstRegular = items.find(it => !it.classList.contains("golden-effect"))
+      if (firstRegular) {
+        firstRegular.before(item)
+      } else if (items.length > 0) {
+        items[items.length - 1].after(item)
+      } else {
+        this.#prepend(item, list)
+      }
+    } else if (items.length > 0) {
+      items[0].before(item)
+    } else {
+      this.#prepend(item, list)
+    }
+  }
+
+  #prepend(item, list) {
+    const firstPage = list.querySelector("turbo-frame")
+    ;(firstPage || list).prepend(item)
+  }
+
+  // Make the card look like the server will render it in its new place.
+  // Closing a card keeps its column, so a card dropped into Done keeps its
+  // color and column; other drops set (or clear) the column.
+  #restyle(item, container) {
+    const status = container.dataset.dragAndDropStatus
+    const active = status === "column" || status === "stream"
+
+    item.classList.toggle("card--postponed", status === "not_now")
+    item.classList.toggle("card--active", active)
+
+    this.#updateStamp(item, container)
+    this.#updateCurrentColumnLabel(item, status === "column" ? container.dataset.dragAndDropColumnName : null)
+
+    if (status !== "closed") {
+      item.style.setProperty("--card-color", container.dataset.dragAndDropCardColor)
+      this.#updateColumnStages(item, status === "column" ? container.dataset.dragAndDropColumnName : null)
+    }
+  }
+
+  #updateStamp(item, container) {
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+
+    const template = container.querySelector("template[data-drag-and-drop-target~='stamp']")
+    const body = item.querySelector(".card__body")
+    if (template && body) {
+      body.append(template.content.cloneNode(true))
+    }
+  }
+
+  #updateCurrentColumnLabel(item, columnName) {
+    const header = item.querySelector(".card__header")
+    header?.querySelectorAll(".card__column-name--current").forEach(label => label.remove())
+
+    if (columnName && header) {
+      const label = document.createElement("span")
+      label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+      const name = document.createElement("span")
+      name.className = "overflow-ellipsis"
+      name.textContent = columnName
+
+      label.append(name)
+      header.append(label)
+    }
+  }
+
+  #updateColumnStages(item, columnName) {
+    item.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.textContent.trim() === columnName)
+    })
+  }
+
+  #adjustCount(container, delta) {
+    const counter = container.querySelector(".cards__expander-count[data-count]")
+    if (!counter) return
+
+    const count = Math.max(0, parseInt(counter.dataset.count, 10) + delta)
+    counter.dataset.count = count
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(it => it.classList.toggle(this.hoverContainerClass, it === container))
+  }
+
+  #droppableContainerAt(element) {
+    const container = this.#containerContaining(element)
+    return container && container !== this.sourceContainer ? container : null
+  }
+
+  #itemsIn(element) {
+    return Array.from(element.querySelectorAll("[data-drag-and-drop-target~='item']"))
+  }
+
+  #itemContaining(element) {
+    return element?.closest?.("[data-drag-and-drop-target~='item']")
+  }
+
+  #containerContaining(element) {
+    const container = element?.closest?.("[data-drag-and-drop-target~='container']")
+    return container && this.element.contains(container) ? container : null
+  }
+}
