@@ -0,0 +1,72 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 15.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :ensure_authentication_is_pending
+
+  layout "public"
+
+  def show
+    @email_address = email_address_pending_authentication
+  end
+
+  def create
+    if magic_link = identity_pending_authentication&.magic_links&.consume(code)
+      sign_in magic_link
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def ensure_authentication_is_pending
+      if email_address_pending_authentication.blank?
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email address to get a new code." }
+          format.json { render json: { message: "Enter your email address to get a new code." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def code
+      params.expect(:code)
+    end
+
+    def identity_pending_authentication
+      Identity.find_by(email_address: email_address_pending_authentication)
+    end
+
+    def sign_in(magic_link)
+      clear_pending_authentication
+      start_new_session_for magic_link.identity
+
+      respond_to do |format|
+        format.html { redirect_to after_sign_in_url(magic_link) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def after_sign_in_url(magic_link)
+      if magic_link.for_sign_up?
+        new_signup_completion_path
+      else
+        after_authentication_url
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: "That code didn't work. Check it and try again." }
+        format.json { render json: { message: "That code didn't work. Check it and try again." }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
