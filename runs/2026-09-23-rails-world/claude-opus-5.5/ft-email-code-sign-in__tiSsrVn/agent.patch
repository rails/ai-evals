new file mode 100644
index 0000000..78efe37
--- /dev/null
+++ b/app/controllers/concerns/authentication/via_magic_link.rb
@@ -0,0 +1,54 @@
+module Authentication::ViaMagicLink
+  extend ActiveSupport::Concern
+
+  private
+    def redirect_to_session_magic_link(magic_link, return_to: nil)
+      set_pending_authentication_for magic_link.identity.email_address, expires_at: magic_link.expires_at
+      session[:return_to_after_authenticating] = return_to if return_to
+      serve_development_magic_link magic_link
+
+      respond_to do |format|
+        format.html { redirect_to main_app.session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    # Behave as if a code was sent, so the response doesn't reveal whether an email address has an identity.
+    def redirect_to_fake_session_magic_link(email_address)
+      set_pending_authentication_for email_address, expires_at: MagicLink::EXPIRATION_TIME.from_now
+
+      respond_to do |format|
+        format.html { redirect_to main_app.session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def set_pending_authentication_for(email_address, expires_at:)
+      cookies[:pending_authentication_token] = {
+        value: pending_authentication_verifier.generate(email_address, expires_at: expires_at),
+        expires: expires_at, httponly: true, same_site: :lax
+      }
+    end
+
+    def email_address_pending_authentication
+      pending_authentication_verifier.verified(pending_authentication_token)
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def clear_pending_authentication
+      cookies.delete :pending_authentication_token
+    end
+
+    def pending_authentication_verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+
+    def serve_development_magic_link(magic_link)
+      if Rails.env.development?
+        flash[:magic_link_code] = magic_link.code
+      end
+    end
+end
