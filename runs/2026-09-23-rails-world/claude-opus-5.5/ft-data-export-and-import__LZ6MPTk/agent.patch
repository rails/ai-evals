+++ b/test/models/export_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "build an account export and email the requester" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    export.build
+
+    assert export.completed?
+    assert export.file.attached?
+    assert_enqueued_email_with ExportMailer, :completed, args: [ export ]
+
+    ZipFile::Reader.new(StringIO.new(export.file.download)).tap do |zip|
+      assert zip.exists?("data/accounts/#{accounts("37s").id}.json")
+      assert zip.exists?("data/cards/#{cards(:logo).id}.json")
+      assert_equal users(:kevin).identity.email_address, JSON.parse(zip.read("data/users/#{users(:kevin).id}.json"))["email_address"]
+    end
+  end
+
+  test "a data export includes the cards the user can see with their comments and files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    export = User::DataExport.create!(account: accounts("37s"), user: users(:kevin))
+
+    export.build
+
+    zip = ZipFile::Reader.new(StringIO.new(export.file.download))
+    assert_equal users(:kevin).accessible_cards.published.count, zip.glob("cards/*.json").count
+
+    json = JSON.parse(zip.read("cards/#{card.number}.json"))
+    assert_equal card.title, json["title"]
+    assert_equal card.comments.count, json["comments"].count
+    assert_equal file_fixture("moon.jpg").binread, zip.read(json["image"]["path"])
+  end
+
+  test "exports expire after a day" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    assert export.accessible_to?(users(:kevin))
+    assert_not export.accessible_to?(users(:jason))
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.accessible_to?(users(:kevin))
+
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+
+  test "failed builds are marked as failed" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    Account::DataTransfer::Manifest.any_instance.stubs(:each_record_set).raises(RuntimeError, "boom")
+
+    assert_raises(RuntimeError) { export.build }
+    assert export.reload.failed?
+  end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
