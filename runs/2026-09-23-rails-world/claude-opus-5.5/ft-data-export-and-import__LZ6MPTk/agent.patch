 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "exports attachments as global ids and imports them as signed ids of the imported records" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    cards(:logo).update!(description: %(<p>Hi</p><action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>))
+
+    zip = build_zip { |writer| Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export(to: writer) }
+    body = zip.glob("data/action_text_rich_texts/*.json").map { |path| JSON.parse(zip.read(path)) }.find { |data| data["record_id"] == cards(:logo).id }["body"]
+
+    assert_includes body, %(gid="#{blob.to_global_id}")
+    assert_not_includes body, "sgid="
+  end
+
+  test "check rejects rich texts for unrecognized record types" do
+    zip = build_zip do |writer|
+      writer.add_file "data/action_text_rich_texts/#{id = ActiveRecord::Type::Uuid.generate}.json",
+        { id: id, record_type: "Identity", record_id: identities(:kevin).id, name: "bio", body: "<p>Hi</p>" }.to_json
+    end
+
+    error = assert_raises Account::DataTransfer::RecordSet::IntegrityError do
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).check(from: zip)
+    end
+
+    assert_match "unrecognized record type", error.message
+  end
+
+  test "check rejects records whose id doesn't match the file" do
+    zip = build_zip do |writer|
+      writer.add_file "data/action_text_rich_texts/#{ActiveRecord::Type::Uuid.generate}.json",
+        { id: ActiveRecord::Type::Uuid.generate, record_type: "Card", record_id: cards(:logo).id, name: "description", body: "" }.to_json
+    end
+
+    assert_raises Account::DataTransfer::RecordSet::IntegrityError do
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).check(from: zip)
+    end
+  end
+
+  test "import drops references to records outside the imported account" do
+    foreign_blob = Current.with_account(accounts(:initech)) do
+      ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    end
+    target = Account.create!(name: "Target")
+    id = ActiveRecord::Type::Uuid.generate
+
+    zip = build_zip do |writer|
+      writer.add_file "data/action_text_rich_texts/#{id}.json",
+        { id: id, record_type: "Card", record_id: ActiveRecord::Type::Uuid.generate, name: "description",
+          body: %(<action-text-attachment gid="#{foreign_blob.to_global_id}"></action-text-attachment>),
+          created_at: Time.current, updated_at: Time.current }.to_json
+    end
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(target).import(from: zip)
+
+    body = ActionText::RichText.where(account: target).sole.body.to_html
+    assert_not_includes body, "gid="
+    assert_not_includes ActionText::RichText.where(account: target).sole.body.attachables, foreign_blob
+  end
+
+  private
+    def build_zip
+      tempfile = Tempfile.new([ "test", ".zip" ]).tap(&:binmode)
+      writer = ZipFile::Writer.new(tempfile)
+      yield writer
+      writer.close
+      tempfile.rewind
+      ZipFile::Reader.new(StringIO.new(tempfile.read))
+    end
 end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..b931a7e
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper, ActiveJob::Continuation::TestHelper
+
+  setup do
+    @source = accounts("37s")
+    @exporter = users(:david)
+  end
+
+  test "export and import round trip next to the original account" do
+    attach_image_to cards(:logo)
+    zip = export_zip
+
+    import = start_import(zip)
+    import.process
+
+    assert import.reload.completed?
+    assert import.remap_ids?
+
+    account = import.account
+    assert_equal @source.name, account.name
+    assert_equal @source.boards.count, account.boards.count
+    assert_equal @source.cards.count, account.cards.count
+    assert_equal Comment.where(account: @source).count, Comment.where(account: account).count
+    assert_equal @source.users.count, account.users.count
+    assert_equal ActionText::RichText.where(account: @source).count, ActionText::RichText.where(account: account).count
+
+    assert_empty account.boards.pluck(:id) & @source.boards.pluck(:id)
+
+    card = account.cards.find_by!(number: cards(:logo).number)
+    assert_equal cards(:logo).title, card.title
+    assert card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, card.image.download
+    assert_equal account, card.board.account
+    assert_equal account, card.creator.account
+
+    importer = account.users.find_by!(identity: @exporter.identity)
+    assert importer.owner?
+
+    assert_equal cards(:logo).comments.count, card.comments.count
+  end
+
+  test "keeps the ids when importing into another instance" do
+    zip = export_zip
+    source_card_ids = @source.cards.pluck(:id).sort
+    Current.without_account { @source.incinerate }
+
+    import = start_import(zip)
+    import.process
+
+    assert import.reload.completed?
+    assert_not import.remap_ids?
+    assert_equal source_card_ids, import.account.cards.pluck(:id).sort
+  end
+
+  test "a failed import leaves nothing behind" do
+    zip = export_zip
+    import = start_import(zip)
+    account = import.account
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.any_instance.stubs(:import_batch).raises(RuntimeError, "boom")
+
+    assert_raises(RuntimeError) { import.process }
+
+    assert import.reload.failed?
+    assert_nil import.account
+    assert_not Account.exists?(account.id)
+    assert_equal 0, Card.where(account_id: account.id).count
+    assert_equal 0, User.where(account_id: account.id).count
+    assert_equal 0, ActiveStorage::Blob.where(account_id: account.id).count
+    assert_equal Account::Import::GENERIC_FAILURE_REASON, import.failure_reason
+  end
+
+  test "an invalid file fails with a reason" do
+    import = start_import(StringIO.new("not a zip"))
+
+    assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { import.process }
+    assert import.reload.failed?
+    assert_match "couldn't be imported", import.failure_reason
+  end
+
+  test "importing in the background emails the importer" do
+    zip = export_zip
+
+    import = start_import(zip)
+    perform_enqueued_jobs only: Account::ImportJob
+
+    assert import.reload.completed?
+    assert_enqueued_email_with ImportMailer, :completed, args: [ import ]
+  end
+
+  test "an interrupted import resumes where it left off" do
+    zip = export_zip
+    import = start_import(zip)
+
+    interrupt_job_during_step(Account::ImportJob, :import_records, cursor: [ 2, nil ]) do
+      perform_enqueued_jobs only: Account::ImportJob
+    end
+
+    assert import.reload.processing?
+    assert_equal @source.users.count, import.account.users.count
+
+    perform_enqueued_jobs only: Account::ImportJob
+
+    assert import.reload.completed?
+    assert_equal @source.users.count, import.account.users.count
+    assert_equal @source.cards.count, import.account.cards.count
+  end
+
+  test "a failed background import emails the reason" do
+    import = start_import(StringIO.new("not a zip"))
+    perform_enqueued_jobs only: Account::ImportJob
+
+    assert import.reload.failed?
+    assert_enqueued_email_with ImportMailer, :failed, args: [ import ]
+  end
+
+  test "rejects records attached to unrecognized record types" do
+    attach_image_to cards(:logo)
+
+    zip = tamper_with(export_zip) do |path, content|
+      if path.start_with?("data/active_storage_attachments/")
+        JSON.parse(content).merge("record_type" => "Identity").to_json
+      end
+    end
+
+    import = start_import(zip)
+    error = assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { import.process }
+    assert_match "unrecognized record type", error.message
+    assert import.reload.failed?
+  end
+
+  test "references to records outside the export never point to existing records" do
+    other_card = Card.where(account: accounts(:initech)).first
+
+    zip = tamper_with(export_zip) do |path, content|
+      if path.start_with?("data/comments/")
+        JSON.parse(content).merge("card_id" => other_card.id).to_json
+      end
+    end
+
+    import = start_import(zip)
+    import.process
+
+    assert import.reload.completed?
+    assert_not Comment.where(account: import.account, card_id: other_card.id).exists?
+    assert_equal Comment.where(account: accounts("37s")).count, Comment.where(account: import.account).count
+  end
+
+  private
+    def tamper_with(io)
+      reader = ZipFile::Reader.new(io)
+      tempfile = Tempfile.new([ "tampered", ".zip" ]).tap(&:binmode)
+      writer = ZipFile::Writer.new(tempfile)
+
+      reader.paths.each do |path|
+        content = reader.read(path)
+        writer.add_file path, yield(path, content) || content
+      end
+
+      writer.close
+      tempfile.rewind
+      StringIO.new(tempfile.read)
+    end
+
+    def export_zip
+      export = Account::Export.create!(account: @source, user: @exporter)
+      export.build
+      assert export.completed?
+      StringIO.new(export.file.download)
+    end
+
+    def start_import(io)
+      Current.without_account do
+        Account::Import.start(identity: @exporter.identity, file: { io: io, filename: "export.zip", content_type: "application/zip" })
+      end
+    end
+
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+end
