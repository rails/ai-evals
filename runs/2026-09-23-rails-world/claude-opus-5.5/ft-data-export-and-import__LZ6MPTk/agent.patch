diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..9209091
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins can export the account" do
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with job: DataExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal users(:kevin), Account::Export.last.user
+  end
+
+  test "members can't export the account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show a completed export with a download link" do
+    export = build_export(users(:kevin))
+
+    get account_export_path(export)
+
+    assert_response :success
+    assert_select "a", text: "Download"
+  end
+
+  test "expired exports can't be downloaded" do
+    export = build_export(users(:kevin))
+    export.update!(completed_at: 2.days.ago)
+
+    get account_export_path(export)
+
+    assert_response :success
+    assert_select "a", text: "Download", count: 0
+    assert_match "expired", response.body
+  end
+
+  test "exports are only visible to whoever requested them" do
+    export = build_export(users(:jason))
+
+    get account_export_path(export)
+
+    assert_response :not_found
+  end
+
+  test "only the requester can download the file" do
+    export = build_export(users(:kevin))
+
+    get rails_blob_path(export.file, disposition: "attachment")
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+
+    logout_and_sign_in_as :jason
+    get rails_blob_path(export.file, disposition: "attachment")
+    assert_response :forbidden
+  end
+
+  test "admins see the export button in the account settings" do
+    get account_settings_path
+    assert_select "form[action=?]", account_exports_path
+
+    logout_and_sign_in_as :david
+    get account_settings_path
+    assert_select "form[action=?]", account_exports_path, count: 0
+  end
+
+  private
+    def build_export(user)
+      Account::Export.create!(account: accounts("37s"), user: user).tap(&:build)
+    end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..c2a51d4
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "new" do
+    untenanted { get new_account_import_path(script_name: nil) }
+
+    assert_response :success
+  end
+
+  test "create starts an import into a new account" do
+    file = export_file
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_with job: Account::ImportJob do
+        untenanted { post account_imports_path(script_name: nil), params: { account_import: { file: file } } }
+      end
+    end
+
+    import = Account::Import.last
+    assert_redirected_to account_import_path(import, script_name: nil)
+    assert_equal identities(:david), import.identity
+    assert import.account.present?
+
+    perform_enqueued_jobs only: Account::ImportJob
+    assert import.reload.completed?
+
+    untenanted { get account_import_path(import, script_name: nil) }
+    assert_response :success
+    assert_match "Your import is done", response.body
+  end
+
+  test "create requires a zip file" do
+    assert_no_difference [ -> { Account::Import.count }, -> { Account.count } ] do
+      untenanted { post account_imports_path(script_name: nil), params: { account_import: { file: fixture_file_upload("moon.jpg", "image/jpeg") } } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "imports are only visible to whoever started them" do
+    import = Current.without_account do
+      Account::Import.start(identity: identities(:kevin), file: { io: StringIO.new("zip"), filename: "export.zip" })
+    end
+
+    untenanted { get account_import_path(import, script_name: nil) }
+
+    assert_response :not_found
+  end
+
+  private
+    def export_file
+      export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+      export.build
+
+      tempfile = Tempfile.new([ "export", ".zip" ]).tap(&:binmode)
+      tempfile.write(export.file.download)
+      tempfile.rewind
+
+      Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "export.zip")
+    end
+end
