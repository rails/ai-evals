@@ -37,4 +37,60 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+
+  test "reader reads, globs and streams entries" do
+    io = build_zip do |writer|
+      writer.add_file("data/cards/1.json", '{"id":1}')
+      writer.add_file("data/cards/2.json", '{"id":2}')
+      writer.add_file("data/tags/1.json", '{"id":3}')
+      writer.add_file("storage/abc", "binary" * 1000, compress: false)
+    end
+
+    reader = ZipFile::Reader.new(io)
+
+    assert_equal [ "data/cards/1.json", "data/cards/2.json" ], reader.glob("data/cards/*.json")
+    assert_equal '{"id":2}', reader.read("data/cards/2.json")
+    assert reader.exists?("storage/abc")
+    assert_equal "binary" * 1000, reader.open("storage/abc").read
+    assert_raises(ZipFile::Reader::EntryNotFound) { reader.read("missing") }
+    assert_raises(ZipFile::Reader::EntryTooLarge) { reader.read("storage/abc", max_size: 10) }
+  end
+
+  test "reader rejects files that aren't zips" do
+    assert_raises(ZipFile::Reader::Error) { ZipFile::Reader.new(StringIO.new("nope")) }
+  end
+
+  test "read from a blob in ranges" do
+    io = build_zip do |writer|
+      writer.add_file("hello.txt", "Hello, World!" * 1000)
+    end
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: io, filename: "test.zip")
+    ActiveStorage::Blob.any_instance.expects(:download).never
+
+    ZipFile.read_from(blob) do |zip|
+      assert_equal "Hello, World!" * 1000, zip.read("hello.txt")
+    end
+  end
+
+  test "blob io seeks and reads across buffers" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("0123456789" * 10), filename: "digits.txt")
+    io = ZipFile::BlobIO.new(blob, buffer_size: 7)
+
+    assert_equal 100, io.size
+    assert_equal "0123456789012", io.read(13)
+    io.seek(-3, IO::SEEK_END)
+    assert_equal "789", io.read(10)
+    assert_nil io.read(1)
+  end
+
+  private
+    def build_zip
+      tempfile = Tempfile.new([ "test", ".zip" ]).tap(&:binmode)
+      writer = ZipFile::Writer.new(tempfile)
+      yield writer
+      writer.close
+      tempfile.rewind
+      StringIO.new(tempfile.read)
+    end
 end
