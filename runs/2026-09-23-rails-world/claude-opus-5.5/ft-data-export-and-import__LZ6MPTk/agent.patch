@@ -0,0 +1,41 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  rate_limit to: 10, within: 1.hour, only: :create, with: -> { redirect_to new_account_import_path, alert: "Try again later." }
+
+  before_action :set_import, only: :show
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Account::Import.start(identity: Current.identity, file: import_params[:file])
+
+    respond_to do |format|
+      format.html { redirect_to account_import_path(@import) }
+      format.json { head :accepted, location: account_import_path(@import, format: :json) }
+    end
+  rescue ActiveRecord::RecordInvalid => error
+    @import = error.record.is_a?(Account::Import) ? error.record : Account::Import.new
+
+    respond_to do |format|
+      format.html { render :new, status: :unprocessable_entity }
+      format.json { render json: @import.errors, status: :unprocessable_entity }
+    end
+  end
+
+  def show
+  end
+
+  private
+    def set_import
+      @import = Current.identity.account_imports.find(params[:id])
+    end
+
+    def import_params
+      params.fetch(:account_import, {}).permit(:file)
+    end
+end
