+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,23 @@
+class Account::ImportJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    step :check do
+      import.check
+    end
+
+    step :import_records do |step|
+      import.import_records(start: step.cursor) { |cursor| step.set! cursor }
+    end
+
+    step :finish do
+      import.finish
+    end
+  rescue => error
+    import.fail(error)
+  end
+end
