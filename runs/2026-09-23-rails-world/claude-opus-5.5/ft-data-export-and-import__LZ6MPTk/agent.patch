@@ -2,4 +2,21 @@ class Account::DataTransfer::EntropyRecordSet < Account::DataTransfer::RecordSet
   def initialize(account)
     super(account: account, model: Entropy)
   end
+
+  private
+    # The account's own entropy already exists: it's created along with the account
+    def import_batch(batch)
+      rows = batch.map { |file| load(file) }
+      account_rows, other_rows = rows.partition { |data| data["container_type"] == "Account" }
+
+      account_rows.each do |data|
+        account.entropy.update_columns(auto_postpone_period: data["auto_postpone_period"]) if data["auto_postpone_period"].present?
+      end
+
+      model.insert_all!(other_rows.map { |data| import_attributes(data) }) if other_rows.any?
+    end
+
+    def conflicting_batch?(batch)
+      model.where(id: batch.map { |file| id_map[File.basename(file, ".json")] }).where.not(container_type: "Account").exists?
+    end
 end
