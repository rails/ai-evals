+      creator: export_person(creator),
+      assignees: assignees.map { |assignee| export_person(assignee) },
+      tags: tags.map(&:title).sort,
+      closed: closed?,
+      closed_at: closed_at&.utc,
+      postponed: postponed?,
+      golden: golden?,
+      created_at: created_at.utc,
+      updated_at: updated_at.utc,
+      last_active_at: last_active_at&.utc,
+      description: export_rich_text(description),
+      image: image.attached? ? export_file(image.blob) : nil,
+      attachments: description_attachments.map { |blob| export_file(blob) },
+      steps: steps.map { |step| { content: step.content, completed: step.completed? } },
+      comments: exportable_comments.map { |comment| export_comment(comment) }
+    }
+  end
+
+  # The files to include along with the card, by their path in the export
+  def export_files
+    blobs = [ (image.blob if image.attached?), *description_attachments, *exportable_comments.flat_map { |comment| comment_attachments(comment) } ]
+    blobs.compact.uniq.index_by { |blob| export_file_path(blob) }
+  end
+
+  private
+    def exportable_comments
+      @exportable_comments ||= comments.chronologically.includes(:creator, rich_text_body: { embeds_attachments: :blob })
+    end
+
+    def export_comment(comment)
+      {
+        id: comment.id,
+        creator: export_person(comment.creator),
+        created_at: comment.created_at.utc,
+        updated_at: comment.updated_at.utc,
+        body: export_rich_text(comment.body),
+        attachments: comment_attachments(comment).map { |blob| export_file(blob) }
+      }
+    end
+
+    def export_person(user)
+      { id: user.id, name: user.name } if user
+    end
+
+    def export_rich_text(rich_text)
+      {
+        plain_text: rich_text&.to_plain_text.to_s,
+        html: rich_text&.body&.to_html.to_s
+      }
+    end
+
+    def export_file(blob)
+      {
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: export_file_path(blob)
+      }
+    end
+
+    def export_file_path(blob)
+      "cards/#{number}/#{blob.id}-#{blob.filename.sanitized}"
+    end
+
+    def description_attachments
+      description&.embeds&.map(&:blob) || []
+    end
+
+    def comment_attachments(comment)
+      comment.body&.embeds&.map(&:blob) || []
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..c01760d
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,68 @@
+class Export < ApplicationRecord
+  EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :expired, -> { where(completed_at: ...EXPIRATION.ago).or(where(status: %w[ pending processing failed ], created_at: ...EXPIRATION.ago)) }
+  scope :in_progress, -> { where(status: %w[ pending processing ]) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def build_later
+    DataExportJob.perform_later(self)
+  end
+
+  def build
+    Current.with_account(account) do
+      processing!
+
+      ZipFile.create_for(file, filename: filename) do |zip|
+        populate_zip(zip)
+      end
+
+      mark_completed
+      ExportMailer.completed(self).deliver_later
+    end
+  rescue => error
+    failed!
+    raise error
+  end
+
+  def expires_at
+    completed_at + EXPIRATION if completed_at
+  end
+
+  def expired?
+    completed_at.present? && completed_at < EXPIRATION.ago
+  end
+
+  def downloadable?
+    completed? && !expired? && file.attached?
+  end
+
+  def accessible_to?(accessor)
+    accessor.present? && accessor == user && !expired?
+  end
+
+  private
+    def filename
+      "fizzy-#{account.name.parameterize.presence || "account"}-#{created_at.strftime("%Y-%m-%d")}-#{id}.zip"
+    end
+
+    def populate_zip(zip)
+      raise NotImplementedError, "Subclasses must implement populate_zip"
+    end
+
+    def mark_completed
+      update!(status: :completed, completed_at: Time.current)
+    end
+end
