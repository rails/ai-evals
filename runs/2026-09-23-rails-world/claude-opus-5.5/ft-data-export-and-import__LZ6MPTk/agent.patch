@@ -0,0 +1,38 @@
+# The cards a person can see, as JSON, along with their comments and every file attached to them.
+class User::DataExport < ::Export
+  private
+    def filename
+      "fizzy-cards-#{user.name.parameterize.presence || "export"}-#{created_at.strftime("%Y-%m-%d")}-#{id}.zip"
+    end
+
+    def populate_zip(zip)
+      exportable_cards.find_each do |card|
+        add_card_to_zip(zip, card)
+      end
+    end
+
+    def exportable_cards
+      user.accessible_cards.published.or(user.accessible_cards.where(creator: user))
+        .includes(:board, :column, :creator, :assignees, :tags, :steps, :closure, :not_now, :goldness, :rich_text_description, image_attachment: :blob)
+    end
+
+    def add_card_to_zip(zip, card)
+      zip.add_file "cards/#{card.number}.json", JSON.pretty_generate(card.export_json.as_json)
+
+      card.export_files.each do |path, blob|
+        add_blob_to_zip(zip, path, blob)
+      end
+    end
+
+    def add_blob_to_zip(zip, path, blob)
+      if zip.exists?(path)
+        # Already added
+      elsif blob.service.exist?(blob.key)
+        zip.add_file path, compress: false do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      else
+        Rails.logger.warn "[DataExport] Skipping missing file for blob #{blob.id}"
+      end
+    end
+end
