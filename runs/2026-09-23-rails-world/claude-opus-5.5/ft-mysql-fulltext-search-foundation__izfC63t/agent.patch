diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..ed2e68f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+    assert_select "#search_results", count: 0
+  end
+
+  test "show highlights matches in titles and comments" do
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "#search_results li", count: 1
+    assert_select "#search_results mark", text: "logo"
+
+    get search_path(q: "overflowing")
+    assert_select "#search_results a", text: /Layout is broken/
+    assert_select "#search_results mark", text: "overflowing"
+  end
+
+  test "show excludes inaccessible and draft cards" do
+    get search_path(q: "radio")
+    assert_response :success
+    assert_select "#search_results", count: 0
+    assert_select "p", text: /No cards match/
+
+    boards(:writebook).cards.create!(title: "Draft quokka", creator: users(:kevin), status: :drafted)
+    get search_path(q: "quokka")
+    assert_select "#search_results", count: 0
+  end
+
+  test "show escapes the query" do
+    get search_path(q: "<em>zzz</em>")
+    assert_response :success
+    assert_includes response.body, "&lt;em&gt;zzz&lt;/em&gt;"
+    assert_select "em", text: "zzz", count: 0
+  end
+end
