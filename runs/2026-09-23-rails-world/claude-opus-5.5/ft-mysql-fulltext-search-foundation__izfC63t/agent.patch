diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..595f1a3
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,30 @@
+module SearchesHelper
+  def highlight_search_terms(text, terms)
+    text = text.to_s
+
+    if terms.any?
+      safe_join text.split(search_terms_pattern(terms)).each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part }
+    else
+      text
+    end
+  end
+
+  def search_excerpt(text, terms, radius: 100)
+    text = text.to_s.squish
+
+    if match = text.match(search_terms_pattern(terms))
+      start = [ match.begin(0) - radius, 0 ].max
+      finish = [ match.end(0) + radius, text.length ].min
+      excerpt = text[start...finish]
+      excerpt = "…#{excerpt}" if start > 0
+      excerpt = "#{excerpt}…" if finish < text.length
+
+      highlight_search_terms excerpt, terms
+    end
+  end
+
+  private
+    def search_terms_pattern(terms)
+      /(#{Regexp.union(terms.sort_by { -it.length }).source})/i
+    end
+end
