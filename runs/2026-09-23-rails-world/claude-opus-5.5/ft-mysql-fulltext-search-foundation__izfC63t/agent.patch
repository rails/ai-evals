diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..dd8b1c6
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide borderless center margin-block-start flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half", role: "search" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", aria: { label: "Search" },
+          class: "input flex-item-grow", autofocus: @search.query.blank?, autocomplete: "off" %>
+    <%= form.button "Search", type: :submit, name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <% if @page.records.any? %>
+      <ul class="search-results txt-align-start flex flex-column unpad margin-none" id="search_results">
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+      </ul>
+
+      <% unless @page.last? %>
+        <%= link_to "More results", search_path(q: @search.query, page: @page.next_param), class: "btn center" %>
+      <% end %>
+    <% else %>
+      <p class="txt-subtle">No cards match <strong><%= @search.query %></strong>.</p>
+    <% end %>
+  <% end %>
+</section>
