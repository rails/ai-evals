@@ -0,0 +1,23 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "wraps matched terms in mark, case-insensitively" do
+    assert_equal "The <mark>Logo</mark> is <mark>big</mark>", highlight_search_terms("The Logo is big", %w[ logo big ])
+  end
+
+  test "escapes HTML in the text and the terms" do
+    assert_equal "&lt;b&gt;<mark>a&amp;b</mark>&lt;/b&gt;", highlight_search_terms("<b>a&b</b>", %w[ a&b ])
+    assert_equal "1 <mark>+</mark> 1", highlight_search_terms("1 + 1", %w[ + ])
+  end
+
+  test "prefers the longest overlapping term" do
+    assert_equal "<mark>catalog</mark>", highlight_search_terms("catalog", %w[ cat catalog ])
+  end
+
+  test "excerpt trims around the first match" do
+    text = "#{"a " * 100}needle#{" b" * 100}"
+    excerpt = search_excerpt(text, %w[ needle ], radius: 10)
+
+    assert_equal "…a a a a a <mark>needle</mark> b b b b b…", excerpt
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..b8769a0
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "finds cards by title, description, and comment body" do
+    by_title = boards(:writebook).cards.create!(title: "Zebra crossing", creator: users(:kevin), status: :published)
+    by_description = boards(:writebook).cards.create!(title: "Other", description: "A zebra appeared", creator: users(:kevin), status: :published)
+    by_comment = boards(:writebook).cards.create!(title: "Another", creator: users(:kevin), status: :published)
+    by_comment.comments.create!(body: "Spotted a ZEBRA today", creator: users(:kevin))
+
+    assert_equal [ by_comment, by_description, by_title ].sort_by(&:created_at).reverse, search("zebra").cards.to_a
+  end
+
+  test "orders newest first" do
+    older = boards(:writebook).cards.create!(title: "Walrus old", creator: users(:kevin), status: :published, created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Walrus new", creator: users(:kevin), status: :published, created_at: 1.hour.ago)
+
+    assert_equal [ newer, older ], search("walrus").cards.to_a
+  end
+
+  test "requires every term to match" do
+    both = boards(:writebook).cards.create!(title: "Purple giraffe", creator: users(:kevin), status: :published)
+    boards(:writebook).cards.create!(title: "Purple elephant", creator: users(:kevin), status: :published)
+
+    assert_equal [ both ], search("giraffe purple").cards.to_a
+  end
+
+  test "only includes cards from boards the user can currently access" do
+    card = boards(:private).cards.create!(title: "Secret aardvark", creator: users(:kevin), status: :published)
+
+    assert_includes search("aardvark", user: users(:kevin)).cards, card
+    assert_empty search("aardvark", user: users(:david)).cards
+    assert_empty search("radio", user: users(:kevin)).cards
+
+    boards(:private).accesses.revoke_from users(:kevin)
+    assert_empty search("aardvark", user: users(:kevin).reload).cards
+  end
+
+  test "never includes drafts or their comments" do
+    boards(:writebook).cards.create!(title: "Draft okapi", creator: users(:kevin), status: :drafted)
+    assert_empty search("okapi").cards
+
+    commented = boards(:writebook).cards.create!(title: "Ordinary", creator: users(:kevin), status: :published)
+    commented.comments.create!(body: "Mentions a narwhal", creator: users(:kevin))
+    assert_equal [ commented ], search("narwhal").cards.to_a
+
+    commented.update_column :status, "drafted"
+    assert_empty search("narwhal").cards
+  end
+
+  test "treats LIKE wildcards literally" do
+    card = boards(:writebook).cards.create!(title: "Grew 50% faster", creator: users(:kevin), status: :published)
+    boards(:writebook).cards.create!(title: "Grew 500 users", creator: users(:kevin), status: :published)
+
+    assert_equal [ card ], search("50%").cards.to_a
+    assert_empty search("_").cards
+  end
+
+  test "blank queries find nothing" do
+    assert_empty search("").cards
+    assert_empty search("   ").cards
+    assert_empty search(nil).cards
+  end
+
+  test "excerpt comes from the description or the first matching comment" do
+    card = boards(:writebook).cards.create!(title: "Plain", description: "Nothing here", creator: users(:kevin), status: :published)
+    card.comments.create!(body: "First comment", creator: users(:kevin))
+    card.comments.create!(body: "Talks about a tapir", creator: users(:kevin))
+
+    assert_equal "Talks about a tapir", search("tapir").excerpt_for(card)
+    assert_equal "Nothing here", search("nothing").excerpt_for(card)
+    assert_nil search("plain").excerpt_for(card)
+  end
+
+  private
+    def search(query, user: users(:kevin))
+      Search.new(user: user, query: query)
+    end
+end
