diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..46b8084
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,37 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  LIKE_ESCAPE_CHARACTER = "!"
+
+  included do
+    scope :searching, ->(terms) { Array(terms).inject(all) { |cards, term| cards.matching(term) } }
+
+    scope :matching, ->(term) do
+      pattern = "%#{sanitize_sql_like(term, LIKE_ESCAPE_CHARACTER)}%"
+
+      where(sql_like("cards.title", pattern))
+        .or(where(description_like(pattern).arel.exists))
+        .or(where(comment_like(pattern).arel.exists))
+    end
+  end
+
+  class_methods do
+    def description_like(pattern)
+      ActionText::RichText
+        .where(record_type: "Card", name: "description")
+        .where("action_text_rich_texts.record_id = cards.id")
+        .where(sql_like("action_text_rich_texts.body", pattern))
+    end
+
+    def comment_like(pattern)
+      Comment
+        .joins(:rich_text_body)
+        .where("comments.card_id = cards.id")
+        .where(sql_like("action_text_rich_texts.body", pattern))
+    end
+
+    def sql_like(column, pattern)
+      sanitize_sql_array [ "#{column} LIKE ? ESCAPE '#{LIKE_ESCAPE_CHARACTER}'", pattern ]
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..8337d4d
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,29 @@
+class Search
+  MAXIMUM_TERMS = 10
+
+  attr_reader :user, :query, :terms
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.squish
+    @terms = @query.split(" ").uniq(&:downcase).first(MAXIMUM_TERMS)
+  end
+
+  def cards
+    if terms.any?
+      user.accessible_cards.published.searching(terms).reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  def excerpt_for(card)
+    matching_text card.description.to_plain_text or
+      card.comments.chronologically.with_rich_text_body.lazy.map { |comment| matching_text comment.body.to_plain_text }.find(&:itself)
+  end
+
+  private
+    def matching_text(text)
+      text if text.present? && terms.any? { |term| text.downcase.include?(term.downcase) }
+    end
+end
