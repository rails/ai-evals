diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..cda6c37
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,30 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless flex flex-column gap margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half", role: "search" do |form| %>
+    <%= form.search_field :q, value: @query, class: "input full-width", placeholder: "Search cards and comments…", autofocus: @query.blank?, aria: { label: "Search cards and comments" } %>
+    <%= form.button "Search", type: :submit, name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @terms.any? %>
+    <% if @page.used? %>
+      <ol class="search__results flex flex-column gap-half unpad margin-none" style="list-style: none">
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { terms: @terms } %>
+      </ol>
+
+      <% unless @page.last? %>
+        <%= link_to "More results…", search_path(q: @query, page: @page.next_param), class: "btn center" %>
+      <% end %>
+    <% else %>
+      <p class="search__empty txt-align-center">No cards match <strong><%= @query %></strong>.</p>
+    <% end %>
+  <% end %>
+</section>
