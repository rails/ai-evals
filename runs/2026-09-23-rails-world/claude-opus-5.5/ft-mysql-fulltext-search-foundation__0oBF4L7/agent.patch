diff --git a/app/models/concerns/searchable.rb b/app/models/concerns/searchable.rb
new file mode 100644
index 0000000..84c0476
--- /dev/null
+++ b/app/models/concerns/searchable.rb
@@ -0,0 +1,43 @@
+module Searchable
+  extend ActiveSupport::Concern
+
+  MAX_TERMS = 10
+
+  class_methods do
+    def search_terms_from(query)
+      query.to_s.split.uniq(&:downcase).first(MAX_TERMS)
+    end
+
+    def column_matching(column, term)
+      arel_table[column].lower.matches(like_pattern(term), "\\")
+    end
+
+    # Rich text bodies are stored as HTML, so the database narrows down the candidates
+    # and then we confirm the term appears in the text itself, not in the markup.
+    def ids_with_rich_text_matching(name, term)
+      rich_texts_matching(name, term).pluck(:record_id, :body).filter_map do |record_id, body|
+        record_id if plain_text_from(body).include?(term.downcase)
+      end
+    end
+
+    private
+      def rich_texts_matching(name, term)
+        rich_texts = ActionText::RichText.where(record_type: base_class.name, name: name)
+        rich_texts = rich_texts.where(account: Current.account) if Current.account
+
+        rich_texts.where(ActionText::RichText.arel_table[:body].lower.matches(like_pattern(html_escaped(term)), "\\"))
+      end
+
+      def like_pattern(term)
+        "%#{sanitize_sql_like(term.downcase)}%"
+      end
+
+      def html_escaped(term)
+        term.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
+      end
+
+      def plain_text_from(html)
+        CGI.unescapeHTML(html.to_s.gsub(/<[^>]*>/, " ")).downcase
+      end
+  end
+end
