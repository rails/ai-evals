+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "blank query" do
+    get search_path
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "finds cards by title and highlights matches" do
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "##{dom_id(cards(:logo), :search_result)} mark", text: "logo"
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update!(description: "<p>Pretty <strong>zanzibar</strong> stuff</p>")
+
+    get search_path(q: "Zanzibar")
+    assert_select "##{dom_id(cards(:layout), :search_result)} mark", text: "zanzibar"
+    assert_select ".search__result", count: 1
+  end
+
+  test "finds cards by comment body" do
+    cards(:text).comments.create!(body: "Needs more quokkas", creator: users(:david))
+
+    get search_path(q: "quokkas")
+    assert_select "##{dom_id(cards(:text), :search_result)} mark", text: "quokkas"
+  end
+
+  test "newest first" do
+    cards(:logo).update_columns(created_at: 1.minute.ago)
+    cards(:layout).update_columns(created_at: 1.hour.ago)
+    cards(:logo).update_columns(title: "Wombat logo")
+    cards(:layout).update_columns(title: "Wombat layout")
+
+    get search_path(q: "wombat")
+    ids = css_select(".search__result").map { |node| node["id"] }
+    assert_equal [ dom_id(cards(:logo), :search_result), dom_id(cards(:layout), :search_result) ], ids
+  end
+
+  test "excludes cards from inaccessible boards" do
+    card = cards(:logo)
+    card.update_columns(title: "Secret platypus")
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.where(user: users(:kevin)).destroy_all
+
+    get search_path(q: "platypus")
+    assert_select ".search__result", count: 0
+  end
+
+  test "excludes draft cards and their comments" do
+    draft = boards(:writebook).cards.create!(status: :drafted, creator: users(:kevin), title: "Draft echidna", description: "echidna")
+
+    get search_path(q: "echidna")
+    assert_select ".search__result", count: 0
+    assert_select "##{dom_id(draft, :search_result)}", count: 0
+  end
+
+  test "escapes html in content" do
+    cards(:logo).update_columns(title: "<script>alert('narwhal')</script>")
+
+    get search_path(q: "narwhal")
+    assert_select "script", text: /narwhal/, count: 0
+    assert_select "mark", text: "narwhal"
+  end
+
+  test "requires all terms" do
+    cards(:logo).update_columns(title: "Ocelot report")
+    cards(:layout).update_columns(title: "Ocelot")
+    cards(:logo).comments.create!(body: "gibbon", creator: users(:david))
+
+    get search_path(q: "ocelot gibbon")
+    assert_select ".search__result", count: 1
+    assert_select "##{dom_id(cards(:logo), :search_result)}"
+  end
+
+  test "like wildcards are literal" do
+    get search_path(q: "%")
+    assert_select ".search__result", count: 0
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..1861a03
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "matches title, description, and comments case-insensitively" do
+    cards(:logo).update!(title: "Capybara logo")
+    cards(:layout).update!(description: "A capybara appeared")
+    cards(:text).comments.create!(body: "CAPYBARA!")
+
+    assert_equal [ cards(:logo), cards(:layout), cards(:text) ].sort_by(&:id), Card.search("capybara").sort_by(&:id)
+  end
+
+  test "blank query matches nothing" do
+    assert_empty Card.search("   ")
+    assert_empty Card.search(nil)
+  end
+
+  test "does not match html markup in rich text" do
+    cards(:layout).update!(description: "<p>Hello <strong>there</strong></p>")
+
+    assert_not_includes Card.search("strong"), cards(:layout)
+    assert_includes Card.search("there"), cards(:layout)
+  end
+end
