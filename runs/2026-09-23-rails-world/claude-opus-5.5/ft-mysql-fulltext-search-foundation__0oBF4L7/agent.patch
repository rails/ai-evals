--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,39 @@
+module SearchesHelper
+  EXCERPT_RADIUS = 80
+
+  def search_highlight(text, terms)
+    if terms.any?
+      parts = text.to_s.split(search_terms_pattern(terms))
+      safe_join parts.map.with_index { |part, index| index.odd? ? tag.mark(part) : part }
+    else
+      text.to_s
+    end
+  end
+
+  def search_excerpt(card, terms)
+    if text = search_matching_text_for(card, terms)
+      search_highlight excerpt(text, search_terms_pattern(terms), radius: EXCERPT_RADIUS), terms
+    end
+  end
+
+  private
+    def search_terms_pattern(terms)
+      /(#{terms.sort_by(&:length).reverse.map { |term| Regexp.escape(term) }.join("|")})/i
+    end
+
+    def search_matching_text_for(card, terms)
+      search_candidate_texts_for(card, terms).find { |text| text.match?(search_terms_pattern(terms)) }
+    end
+
+    def search_candidate_texts_for(card, terms)
+      Enumerator.new do |texts|
+        texts << card.description.to_plain_text.squish
+
+        terms.each do |term|
+          card.comments.search(term).chronologically.with_rich_text_body.each do |comment|
+            texts << comment.body.to_plain_text.squish
+          end
+        end
+      end
+    end
+end
