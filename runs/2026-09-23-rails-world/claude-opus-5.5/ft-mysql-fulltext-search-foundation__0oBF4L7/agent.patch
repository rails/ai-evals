@@ -0,0 +1,25 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  include ::Searchable
+
+  included do
+    scope :search, ->(query) do
+      terms = search_terms_from(query)
+
+      if terms.any?
+        terms.inject(all) { |cards, term| cards.where(term_matching(term)) }
+      else
+        none
+      end
+    end
+  end
+
+  class_methods do
+    def term_matching(term)
+      column_matching(:title, term)
+        .or(arel_table[:id].in(ids_with_rich_text_matching(:description, term)))
+        .or(arel_table[:id].in(Comment.search(term).select(:card_id).arel))
+    end
+  end
+end
