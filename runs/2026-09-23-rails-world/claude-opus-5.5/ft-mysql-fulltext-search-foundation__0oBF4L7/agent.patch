+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = Card.search_terms_from(@query)
+
+    set_page_and_extract_portion_from found_cards
+  end
+
+  private
+    def found_cards
+      Current.user.accessible_cards.published.search(@query).reverse_chronologically.preloaded
+    end
+end
