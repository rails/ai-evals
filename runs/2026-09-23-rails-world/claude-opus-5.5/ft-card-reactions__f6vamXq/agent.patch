@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::DataTransfer::ReactionRecordSetTest < ActiveSupport::TestCase
+  test "imports legacy reactions that reference comments via comment_id" do
+    comment = comments(:logo_1)
+    data = {
+      "id" => ActiveRecord::Type::Uuid.generate,
+      "account_id" => "some_other_account_id_123456",
+      "comment_id" => comment.id,
+      "reacter_id" => users(:david).id,
+      "content" => "👍",
+      "created_at" => Time.current.iso8601,
+      "updated_at" => Time.current.iso8601
+    }
+
+    record_set = Account::DataTransfer::ReactionRecordSet.new(comment.account)
+    record_set.import(from: build_reader(data))
+
+    reaction = Reaction.find(data["id"])
+    assert_equal comment, reaction.reactable
+    assert_equal comment.account, reaction.account
+  end
+
+  private
+    def build_reader(data)
+      @tempfile = Tempfile.new([ "import_test", ".zip" ])
+      @tempfile.binmode
+
+      writer = ZipFile::Writer.new(@tempfile)
+      writer.add_file("data/reactions/#{data['id']}.json", data.to_json)
+      writer.close
+      @tempfile.rewind
+
+      ZipFile::Reader.new(@tempfile)
+    end
+
+    def teardown
+      @tempfile&.close
+      @tempfile&.unlink
+    end
+end
