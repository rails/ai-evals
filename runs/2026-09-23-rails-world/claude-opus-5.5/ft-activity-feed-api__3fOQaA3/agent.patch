--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,29 @@
+module ActivitiesHelper
+  def activity_event_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(event.assignee_ids) }
+    when "card_board_changed"
+      activity_event_particulars_slice(event, :old_board, :new_board)
+    when "card_title_changed"
+      activity_event_particulars_slice(event, :old_title, :new_title)
+    when "card_triaged"
+      activity_event_particulars_slice(event, :column)
+    else
+      {}
+    end
+  end
+
+  def activity_event_url(event)
+    case event.eventable
+    when Comment then card_url(event.eventable.card, anchor: dom_id(event.eventable))
+    else card_url(event.eventable)
+    end
+  end
+
+  private
+    def activity_event_particulars_slice(event, *keys)
+      details = event.particulars&.dig("particulars") || {}
+      keys.index_with { |key| details[key.to_s].to_s }
+    end
+end
