@@ -0,0 +1,75 @@
+# Activities
+
+Activities are the events that make up the account's activity timeline: cards being added, assigned, moved, renamed, closed, reopened, commented on, and so on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of events on the boards you have access to, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the ID(s) of the users who performed the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Actions:__
+
+`card_published`, `card_assigned`, `card_unassigned`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, `comment_created`.
+
+__Particulars:__
+
+The `particulars` object contains details that depend on the event's `action`:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other actions return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
+
+`eventable_type` is either `Card` or `Comment`, and `eventable` contains the card or comment, using the same representation as the [cards](cards.md) and [comments](comments.md) endpoints. The `url` opens the card; for comments, it jumps to the comment on its card.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_title_changed",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David renamed &quot;Layout is broken&quot; (was: &quot;Layout broken&quot;)",
+    "particulars": {
+      "old_title": "Layout broken",
+      "new_title": "Layout is broken"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 2,
+      "title": "Layout is broken",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/2"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Writebook",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+The `eventable` and `board` objects are abbreviated above.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..b5feba2
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_includes activity_ids, events(:logo_published).id
+    assert_includes activity_ids, events(:layout_commented).id
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.map { |event| Time.iso8601(event["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index as JSON includes event attributes" do
+    get activities_path, as: :json
+
+    event = find_activity(events(:logo_published))
+
+    assert_equal "card_published", event["action"]
+    assert_equal "Card", event["eventable_type"]
+    assert_equal events(:logo_published).description_for(users(:kevin)).to_plain_text, event["description"]
+    assert_equal({}, event["particulars"])
+    assert_equal card_url(cards(:logo)), event["url"]
+    assert_equal cards(:logo).id, event.dig("eventable", "id")
+    assert_equal boards(:writebook).id, event.dig("board", "id")
+    assert_equal users(:david).id, event.dig("creator", "id")
+  end
+
+  test "index as JSON links comment events to the comment on its card" do
+    get activities_path, as: :json
+
+    event = find_activity(events(:layout_commented))
+    comment = events(:layout_commented).eventable
+
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+  end
+
+  test "index as JSON includes assignment particulars" do
+    get activities_path, as: :json
+
+    event = find_activity(events(:logo_assignment_jz))
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event["particulars"])
+  end
+
+  test "index as JSON includes title change events with particulars" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, find_activity(event)["particulars"])
+  end
+
+  test "index as JSON includes board change particulars with blank defaults" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "new_board" => "Other" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "Other" }, find_activity(event)["particulars"])
+  end
+
+  test "index as JSON includes triage particulars" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    assert_equal({ "column" => "" }, find_activity(event)["particulars"])
+  end
+
+  test "index as JSON omits deprecated collection change events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_not_includes activity_ids, event.id
+  end
+
+  test "index as JSON filters by creator" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+
+    assert_not_empty activity_ids
+    assert @response.parsed_body.all? { |event| event.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index as JSON filters by board" do
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_not_empty activity_ids
+    assert @response.parsed_body.all? { |event| event.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index as JSON only returns activity from accessible boards" do
+    private_event = boards(:private).events.create!(action: "card_published", creator: users(:kevin), eventable: cards(:logo))
+
+    get activities_path, as: :json
+    assert_includes activity_ids, private_event.id
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+    assert_not_includes activity_ids, private_event.id
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_not_includes activity_ids, private_event.id
+  end
+
+  test "index as JSON with a bearer token" do
+    sign_out
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_includes activity_ids, events(:logo_published).id
+  end
+
+  private
+    def activity_ids
+      @response.parsed_body.map { |event| event["id"] }
+    end
+
+    def find_activity(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+end
