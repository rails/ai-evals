+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.notifications.delete_all
+    @user.notifications.create!(source: events(:logo_published), creator: users(:jz))
+    @user.notifications.create!(source: events(:layout_published), creator: users(:jz))
+    @bundle = @user.notification_bundles.sole
+  end
+
+  test "notification" do
+    email = Notification::BundleMailer.notification(@bundle)
+
+    assert_emails 1 do
+      Current.with_account(@user.account) { email.deliver_now }
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications in Fizzy", email.subject
+    assert_match ERB::Util.html_escape(cards(:logo).title), email.html_part.body.to_s
+    assert_match cards(:layout).title, email.text_part.body.to_s
+    assert_match "/#{@user.account.slug.delete_prefix("/")}/notifications/settings", email.html_part.body.to_s
+  end
+end
