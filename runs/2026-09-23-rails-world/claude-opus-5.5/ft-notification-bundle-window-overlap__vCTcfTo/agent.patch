+module Notification::Bundled
+  extend ActiveSupport::Concern
+
+  included do
+    # Bundle whenever the notification is created or resurfaced by a new source. This runs
+    # after commit so the bundling transaction starts with the per-user lock, and sees every
+    # window committed by concurrent notifications.
+    after_save_commit :bundle, if: :source_id_previously_changed?
+  end
+
+  def bundle
+    user.bundle(self) unless creator&.system?
+  end
+end
