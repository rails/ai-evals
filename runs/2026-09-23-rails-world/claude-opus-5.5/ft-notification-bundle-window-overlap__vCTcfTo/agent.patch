diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..ae33396
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @user.notifications.delete_all
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "the first notification opens a window" do
+    notification = assert_difference -> { @user.notification_bundles.pending.count }, +1 do
+      notify(:logo_published)
+    end
+
+    bundle = @user.notification_bundles.last
+    assert_equal notification.updated_at, bundle.starts_at
+    assert_equal notification.updated_at + 4.hours, bundle.ends_at
+    assert_includes bundle.notifications, notification
+  end
+
+  test "notifications within the window share it and later ones open a new one" do
+    first = notify(:logo_published)
+    travel 3.hours
+    second = notify(:layout_published)
+    travel 3.hours
+    third = notify(:text_published)
+
+    assert_equal 2, @user.notification_bundles.count
+    earlier, later = @user.notification_bundles.chronologically.to_a
+
+    assert_equal [ first, second ].sort_by(&:id), earlier.notifications.sort_by(&:id)
+    assert_equal [ third ], later.notifications.to_a
+    assert_equal third.updated_at, later.starts_at
+  end
+
+  test "window length follows the chosen frequency" do
+    { "daily" => 1.day, "weekly" => 1.week }.each do |frequency, period|
+      @user.notification_bundles.delete_all
+      @user.notifications.delete_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      notification = notify(:logo_published)
+      assert_equal notification.updated_at + period, @user.notification_bundles.sole.ends_at
+    end
+  end
+
+  test "no bundles when bundling is off" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notify(:logo_published)
+    end
+  end
+
+  test "turning bundling off drops pending windows" do
+    notify(:logo_published)
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_empty @user.notification_bundles.pending
+  end
+
+  test "a late notification joins the window that has already opened" do
+    notify(:logo_published)
+    bundle = @user.notification_bundles.sole
+
+    late = travel_to(bundle.starts_at - 1.hour) { notify(:layout_published) }
+
+    assert_equal bundle, @user.notification_bundles.sole
+    assert_equal late.updated_at, bundle.reload.starts_at
+    assert_includes bundle.notifications, late
+  end
+
+  test "a stretched window never reaches back over an earlier one" do
+    delivered = @user.notification_bundles.create!(starts_at: 6.hours.ago, ends_at: 2.hours.ago, status: "delivered")
+    notify(:logo_published)
+    open = @user.notification_bundles.pending.sole
+
+    travel_to(3.hours.ago) { notify(:layout_published) }
+
+    assert_equal delivered.ends_at, open.reload.starts_at
+    assert_no_overlaps
+  end
+
+  test "a new window never overlaps an earlier one" do
+    delivered = @user.notification_bundles.create!(starts_at: 3.hours.ago, ends_at: 1.hour.from_now, status: "delivered")
+
+    notify(:logo_published)
+
+    bundle = @user.notification_bundles.pending.sole
+    assert_equal delivered.ends_at, bundle.starts_at
+    assert_no_overlaps
+  end
+
+  test "re-notifying an existing notification bundles it again" do
+    notification = notify(:logo_published)
+    @user.notification_bundles.delete_all
+
+    travel 1.day
+    notification.update!(source: events(:logo_assignment_david), read_at: nil)
+
+    assert_includes @user.notification_bundles.sole.notifications, notification
+  end
+
+  test "overlapping windows are invalid" do
+    @user.notification_bundles.create!(starts_at: Time.current, ends_at: 4.hours.from_now)
+    overlapping = @user.notification_bundles.build(starts_at: 2.hours.from_now, ends_at: 6.hours.from_now)
+    adjacent = @user.notification_bundles.build(starts_at: 4.hours.from_now, ends_at: 8.hours.from_now)
+
+    assert_not overlapping.valid?
+    assert adjacent.valid?
+  end
+
+  test "read notifications are left out" do
+    notification = notify(:logo_published)
+    notification.read
+
+    assert_empty @user.notification_bundles.sole.notifications
+  end
+
+  test "deliver_all delivers due bundles only" do
+    notify(:logo_published)
+    due = @user.notification_bundles.sole
+
+    assert_no_enqueued_jobs(only: Notification::Bundle::DeliverJob) { Notification::Bundle.deliver_all }
+
+    travel 4.hours + 1.minute
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, args: [ due ]) { Notification::Bundle.deliver_all }
+  end
+
+  test "deliver sends one email and marks the bundle delivered" do
+    notify(:logo_published)
+    notify(:layout_published)
+    bundle = @user.notification_bundles.sole
+
+    assert_emails 1 do
+      bundle.deliver
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email when everything has been read" do
+    notify(:logo_published).read
+    bundle = @user.notification_bundles.sole
+
+    assert_no_emails { bundle.deliver }
+    assert bundle.reload.delivered?
+  end
+
+  private
+    def notify(event)
+      @user.notifications.create!(source: events(event), creator: users(:jz))
+    end
+
+    def assert_no_overlaps
+      @user.notification_bundles.chronologically.each_cons(2) do |a, b|
+        assert a.ends_at <= b.starts_at, "#{a.window} overlaps #{b.window}"
+      end
+    end
+end
