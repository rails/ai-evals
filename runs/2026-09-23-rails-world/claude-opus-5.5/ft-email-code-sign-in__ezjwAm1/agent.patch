+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign_in_instructions puts the code in the subject and body" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_includes email.text_part.body.to_s, magic_link.code
+    assert_includes email.html_part.body.to_s, magic_link.code
+    assert_includes email.text_part.body.to_s, "15 minutes"
+  end
+end
