diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..961b327
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,48 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), default: :sign_in, prefix: :for
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ...Time.current) }
+
+  before_validation :generate_code, :set_expiration, on: :create
+
+  validates :code, length: { is: CODE_LENGTH }
+
+  class << self
+    def consume(code)
+      if (sanitized_code = Code.sanitize(code)).present?
+        active.find_by(code: sanitized_code)&.consume
+      end
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def consume
+    destroy!
+    self
+  end
+
+  def active?
+    expires_at.future?
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..66184fc
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,20 @@
+# Short, human-friendly codes using Crockford's Base32 alphabet: no I, L, O, or U,
+# so codes are easy to read from an email and type in by hand.
+module MagicLink::Code
+  ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".chars.freeze
+
+  # Characters people commonly type in place of the ones in the alphabet.
+  SUBSTITUTIONS = { "O" => "0", "I" => "1", "L" => "1", "U" => "V" }.freeze
+
+  class << self
+    def generate(length)
+      Array.new(length) { ALPHABET[SecureRandom.random_number(ALPHABET.size)] }.join
+    end
+
+    def sanitize(code)
+      if code.present?
+        code.to_s.upcase.gsub(/[OILU]/, SUBSTITUTIONS).gsub(/[^#{ALPHABET.join}]/, "")
+      end
+    end
+  end
+end
