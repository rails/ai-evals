+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "show requires a pending authentication" do
+    untenanted do
+      get session_magic_link_path
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "sign in with an emailed code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      assert_redirected_to session_magic_link_url
+
+      follow_redirect!
+      assert_response :success
+      assert_in_body identity.email_address
+
+      magic_link = identity.magic_links.last
+      post session_magic_link_path, params: { code: magic_link.code.downcase }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not MagicLink.exists?(magic_link.id), "The code should be single use"
+    end
+  end
+
+  test "sign in via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+      assert_response :created
+      token = response.parsed_body["pending_authentication_token"]
+      assert token.present?
+
+      cookies.delete :pending_authentication_token
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path(format: :json), params: { code: identity.magic_links.last.code }
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "wrong code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "code for a different email address is rejected" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      other = identities(:david).send_magic_link
+
+      post session_magic_link_path, params: { code: other.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(other.id)
+    end
+  end
+
+  test "expired code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      code = identity.magic_links.last.code
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: code }
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "sign up with an emailed code" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        post signup_path, params: { signup: { email_address: "newbie@example.com" } }
+      end
+      assert_redirected_to session_magic_link_url
+
+      magic_link = Identity.find_by!(email_address: "newbie@example.com").magic_links.last
+      assert magic_link.for_sign_up?
+
+      post session_magic_link_path, params: { code: magic_link.code }
+      assert_redirected_to new_signup_completion_path
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+    end
+  end
+
+  test "an unknown email on the sign in page starts a sign up" do
+    untenanted do
+      post session_path, params: { email_address: "newbie@example.com" }
+      magic_link = Identity.find_by!(email_address: "newbie@example.com").magic_links.last
+
+      post session_magic_link_path, params: { code: magic_link.code }
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  test "an unknown email when not accepting signups doesn't reveal anything" do
+    Account.stubs(:accepting_signups?).returns(false)
+
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+          post session_path, params: { email_address: "stranger@example.com" }
+        end
+      end
+
+      assert_redirected_to session_magic_link_url
+    end
+  end
+
+  test "join with an emailed code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_difference -> { User.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joiner@example.com" }
+    end
+    assert_redirected_to session_magic_link_url(script_name: nil)
+
+    identity = Identity.find_by!(email_address: "joiner@example.com")
+
+    untenanted do
+      post session_magic_link_path(script_name: nil), params: { code: identity.magic_links.last.code }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert identity.users.exists?(account: account)
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+      assert_redirected_to session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+end
