diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..66f8c64
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six character code that expires in fifteen minutes" do
+    freeze_time do
+      magic_link = MagicLink.create!(identity: @identity)
+
+      assert_equal 6, magic_link.code.length
+      assert_match(/\A[0-9A-HJKMNP-TV-Z]{6}\z/, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "consume returns and destroys the matching active link" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume is forgiving about case, whitespace and look-alike characters" do
+    magic_link = MagicLink.create!(identity: @identity, code: "0A1B2C")
+
+    assert_equal magic_link, MagicLink.consume(" oa-ib2c ")
+  end
+
+  test "consume ignores expired links" do
+    magic_link = MagicLink.create!(identity: @identity)
+
+    travel 16.minutes do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume ignores blank codes" do
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume("---")
+  end
+
+  test "cleanup removes stale links" do
+    stale = MagicLink.create!(identity: @identity, expires_at: 1.minute.ago)
+    active = MagicLink.create!(identity: @identity)
+
+    MagicLink.cleanup
+
+    assert_not MagicLink.exists?(stale.id)
+    assert MagicLink.exists?(active.id)
+  end
+
+  test "identity sends a magic link by email" do
+    assert_difference -> { @identity.magic_links.count }, 1 do
+      assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+        @identity.send_magic_link
+      end
+    end
+  end
+end
