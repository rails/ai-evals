diff --git a/app/models/entropy.rb b/app/models/entropy.rb
index c896fc4..efd18a6 100644
--- a/app/models/entropy.rb
+++ b/app/models/entropy.rb
@@ -24,6 +24,21 @@ class Entropy < ApplicationRecord
     self.auto_postpone_period = new_value.to_i.days.to_i
   end
 
+  # Active cards governed by this entropy (a board's own entropy takes precedence over its
+  # account's) that have been inactive for longer than the auto-postpone period.
+  def cards_due_to_be_postponed(now: Time.now)
+    due = Card.active.where(last_active_at: ..(now - auto_postpone_period.seconds))
+
+    case container
+    when Board
+      due.where(account_id: container.account_id, board_id: container.id)
+    when Account
+      due.where(account_id: container.id).where.not(board_id: Entropy.where(container_type: "Board").select(:container_id))
+    else
+      Card.none
+    end
+  end
+
   private
     def default_auto_postpone_period_in_days
       if container.is_a?(Board)
