diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..2112110
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,109 @@
+# Kamal configuration for self-hosting Fizzy on a single server.
+#
+# One box, one container: Puma serves the web app and runs the background jobs
+# (Solid Queue runs inside Puma), everything is stored in SQLite, and kamal-proxy
+# terminates SSL with a certificate from Let's Encrypt.
+#
+# To deploy your own copy:
+#
+#   1. Fill in the three values below (server, hostname, sender address) and the SMTP settings in `env`.
+#   2. Put your secrets in the environment (or edit .kamal/secrets), see docs/deploying.md.
+#   3. Run `bin/kamal setup` for the first deploy and `bin/kamal deploy` afterwards.
+#
+# Full guide: docs/deploying.md. Kamal reference: https://kamal-deploy.org/docs/configuration/
+
+<%
+  # The IP address or hostname Kamal connects to over SSH. Docker must be installed, or installable by Kamal.
+  server = "192.0.2.1"
+
+  # The public hostname Fizzy will be served from. Point its DNS A/AAAA records to the server first,
+  # so that Let's Encrypt can issue a certificate.
+  host = "fizzy.example.com"
+
+  # The "From" address on emails Fizzy sends (sign-in codes, notifications, ...).
+  mailer_from = "Fizzy <fizzy@#{host}>"
+%>
+
+# Name of the application. Used as the container name prefix.
+service: fizzy
+
+# Name of the container image.
+image: fizzy
+
+# Deploy to this server. Background jobs run in the same container as the web app.
+servers:
+  web:
+    - <%= server %>
+
+# kamal-proxy terminates SSL and gets a free certificate from Let's Encrypt for `host`.
+# The server must accept connections on ports 80 and 443.
+proxy:
+  ssl: true
+  host: <%= host %>
+  app_port: 80
+  healthcheck:
+    path: /up
+    interval: 3
+    timeout: 30
+
+# Kamal pushes the image to a registry running on your own machine and the server pulls
+# it through the SSH connection, so no external registry account is needed.
+# To use Docker Hub (or any other registry) instead, set its server and username, and
+# add KAMAL_REGISTRY_PASSWORD to .kamal/secrets:
+#
+#   registry:
+#     server: registry.docker.io # or ghcr.io, ...
+#     username: my-user
+#     password:
+#       - KAMAL_REGISTRY_PASSWORD
+registry:
+  server: localhost:5555
+
+# Build the image locally for the server's architecture.
+builder:
+  arch: amd64 # Change to arm64 if your server is ARM-based.
+
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+  clear:
+    # Absolute URLs (links in emails, webhooks, push notifications) point here.
+    APP_HOST: <%= host %>
+    MAILER_FROM_ADDRESS: <%= mailer_from %>
+
+    # Your mail server. Fizzy signs people in with emailed codes, so this must work.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # SMTP_AUTHENTICATION: plain        # plain, login or cram_md5
+    # SMTP_ENABLE_STARTTLS_AUTO: true   # set to false if your server doesn't support STARTTLS
+    # SMTP_TLS: true                    # for implicit TLS, usually on port 465
+
+    # Run Solid Queue (background jobs) inside the web container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Web and job processes default to one per CPU core. Lower these on small servers.
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 1
+
+    # Allow more than one account to sign up on this installation.
+    # MULTI_TENANT: true
+
+# SQLite databases (app, queue, cache, cable) and uploaded files live in /rails/storage.
+# This named Docker volume keeps them across deploys and restarts. Back it up!
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests during a deploy.
+asset_path: /rails/public/assets
+
+# Handy shortcuts, e.g. `bin/kamal console`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
