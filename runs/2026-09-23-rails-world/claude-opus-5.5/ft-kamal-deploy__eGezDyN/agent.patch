+# Secrets for config/deploy.yml, read by Kamal from your local environment at deploy time.
+# Don't write the secret values into this file: it is checked into git. Export them in
+# your shell (or use a password manager, see https://kamal-deploy.org/docs/commands/secrets/).
+#
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#
+# SECRET_KEY_BASE must stay the same between deploys, or everyone gets signed out.
+# Generate the VAPID key pair (for browser push notifications) once, see docs/deploying.md.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Only needed if you push to an external registry (see `registry` in config/deploy.yml).
+# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
