@@ -0,0 +1,27 @@
+<h1 class="title"><%= pluralize @notifications.size, "new notification" %></h1>
+<p class="subtitle">Here’s what happened in <%= @bundle.account.name %> since <%= l @bundle.starts_at.in_time_zone, format: :long %>.</p>
+
+<% @notifications.group_by { it.card.board }.each do |board, notifications| %>
+  <hr class="notification__board-separator">
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification">
+      <tr>
+        <td class="avatar__container"><%= mail_avatar_tag notification.creator %></td>
+        <td>
+          <h3 class="card__title"><%= link_to payload.title, payload.url %></h3>
+          <p class="notification__details"><%= payload.body %></p>
+          <p class="notification__author"><%= notification.creator.name %>, <%= l notification.updated_at.in_time_zone, format: :short %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "See all your notifications", notifications_url %>.
+  You get these emails <%= frequency_description %>.
+  <%= link_to "Change how often", notifications_settings_url %>.
+</p>
