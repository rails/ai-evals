--- /dev/null
+++ b/app/mailers/notification/bundle_mailer.rb
@@ -0,0 +1,26 @@
+class Notification::BundleMailer < ApplicationMailer
+  FREQUENCY_DESCRIPTIONS = {
+    "every_few_hours" => "every few hours",
+    "daily" => "once a day",
+    "weekly" => "once a week"
+  }.freeze
+
+  helper_method :frequency_description
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.deliverable_notifications.to_a
+
+    mail to: @user.identity.email_address, subject: subject_for(@notifications)
+  end
+
+  private
+    def subject_for(notifications)
+      "#{notifications.size} new #{"notification".pluralize(notifications.size)} in #{@bundle.account.name}"
+    end
+
+    def frequency_description
+      FREQUENCY_DESCRIPTIONS.fetch(@user.settings.bundle_email_frequency, "periodically")
+    end
+end
