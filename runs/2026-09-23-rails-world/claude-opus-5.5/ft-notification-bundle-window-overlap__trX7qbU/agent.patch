@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    Notification.create!(user: @user, source: events(:layout_published), creator: users(:jz), unread_count: 1)
+    Notification.create!(user: @user, source: events(:text_published), creator: users(:jz), unread_count: 1)
+    @bundle = @user.notification_bundles.sole
+  end
+
+  test "notification" do
+    email = Current.with_account(@user.account) { Notification::BundleMailer.notification(@bundle) }
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications in #{@user.account.name}", email.subject
+
+    [ email.html_part, email.text_part ].each do |part|
+      body = part.body.to_s
+      assert_includes body, cards(:layout).title
+      assert_includes body, cards(:text).title
+      assert_includes body, "/notifications/settings"
+    end
+    assert_includes email.html_part.body.to_s, "once a day"
+  end
+end
