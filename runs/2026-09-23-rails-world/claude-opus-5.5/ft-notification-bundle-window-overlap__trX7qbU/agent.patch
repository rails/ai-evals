@@ -0,0 +1,21 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :add_to_bundle, if: :source_id_previously_changed?
+  end
+
+  def add_to_bundle
+    unless creator&.system?
+      user.bundle_notification(self, at: notified_at)
+    end
+  end
+
+  private
+    # Re-notifications reuse the existing record, so their moment is the latest update.
+    def notified_at
+      previously_new_record? ? created_at : updated_at
+    end
+end
