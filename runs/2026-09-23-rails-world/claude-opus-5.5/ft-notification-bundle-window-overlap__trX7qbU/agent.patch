diff --git a/app/models/user/notification_bundling.rb b/app/models/user/notification_bundling.rb
new file mode 100644
index 0000000..52d4d0f
--- /dev/null
+++ b/app/models/user/notification_bundling.rb
@@ -0,0 +1,29 @@
+module User::NotificationBundling
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :notification_bundles, class_name: "Notification::Bundle", dependent: :destroy
+  end
+
+  # Adds the notification to the window open at +at+, starting a new window when there is none.
+  # The settings row is locked so that concurrent notifications can't open overlapping windows.
+  def bundle_notification(notification, at: notification.created_at)
+    settings&.with_lock do
+      if settings.bundling_emails?
+        bundle = notification_bundle_open_at(at) || start_notification_bundle_at(at)
+        bundle.collect(notification, at: at)
+        bundle
+      end
+    end
+  end
+
+  private
+    def notification_bundle_open_at(time)
+      notification_bundles.pending.ending_after(time).chronologically.first
+    end
+
+    def start_notification_bundle_at(time)
+      starts_at = [ time, notification_bundles.maximum(:ends_at) ].compact.max
+      notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + settings.bundle_aggregation_period)
+    end
+end
