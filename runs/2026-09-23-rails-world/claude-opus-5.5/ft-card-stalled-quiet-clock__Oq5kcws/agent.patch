diff --git a/test/controllers/cards/stalled_cards_test.rb b/test/controllers/cards/stalled_cards_test.rb
new file mode 100644
index 0000000..ac34b3d
--- /dev/null
+++ b/test/controllers/cards/stalled_cards_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Cards::StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    cards(:text).record_burst
+    travel 15.days
+  end
+
+  test "index filters stalled cards as JSON" do
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+
+    assert_equal [ cards(:text).number ], @response.parsed_body.pluck("number")
+    assert @response.parsed_body.first["stalled"]
+  end
+
+  test "index shows stalled cards" do
+    get cards_path(indexed_by: "stalled")
+    assert_response :success
+    assert_select ".card--stalled .card__stalled", text: "Stalled"
+  end
+
+  test "card shows it's stalled" do
+    get card_path(cards(:text))
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+
+    get card_path(cards(:text), format: :json)
+    assert @response.parsed_body["stalled"]
+
+    get card_path(cards(:layout), format: :json)
+    assert_not @response.parsed_body["stalled"]
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..b5f9d8b
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+    boards(:writebook).update! auto_postpone_period: 30.days
+  end
+
+  test "comments from two people within a third of the auto-close period make a burst" do
+    comment_by :david
+    comment_by :david
+    assert_nil @card.reload.burst
+
+    comment_by :kevin
+    assert @card.reload.burst
+  end
+
+  test "comments from a single person don't make a burst" do
+    3.times { comment_by :david }
+    assert_nil @card.reload.burst
+  end
+
+  test "comments spread beyond a third of the auto-close period don't make a burst" do
+    comment_by :david
+    travel 6.days
+    comment_by :kevin
+    travel 6.days
+    comment_by :jz
+    assert_nil @card.reload.burst
+  end
+
+  test "assigning or reopening makes a burst" do
+    @card.toggle_assignment(users(:kevin))
+    assert @card.reload.burst
+
+    cards(:shipping).reopen
+    assert cards(:shipping).reload.burst
+  end
+
+  test "a burst followed by two weeks without activity is stalled" do
+    freeze_time
+    @card.toggle_assignment(users(:kevin))
+
+    travel 13.days
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.day
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "cards without a burst never stall" do
+    travel 1.month
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity within the two weeks postpones the stall" do
+    @card.toggle_assignment(users(:kevin))
+    travel 10.days
+    comment_by :david
+    travel 10.days
+    assert_not @card.reload.stalled?
+    travel 5.days
+    assert @card.reload.stalled?
+  end
+
+  test "any activity resets a stalled card" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+    assert @card.reload.stalled?
+
+    comment_by :david
+    assert_not @card.reload.stalled?
+    assert_nil @card.burst
+
+    travel 15.days
+    assert_not @card.reload.stalled?
+  end
+
+  test "reacting resets a stalled card" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+    @card.reactions.create!(content: "👍", reacter: users(:kevin))
+    assert_not @card.reload.stalled?
+  end
+
+  test "closed cards are not stalled" do
+    @card.toggle_assignment(users(:kevin))
+    @card.close
+    travel 15.days
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "indexed_by stalled" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+    assert_equal [ @card ], Card.indexed_by("stalled").to_a
+  end
+
+  test "touch newly stalled cards once" do
+    @card.toggle_assignment(users(:kevin))
+    travel 15.days
+
+    assert_changes -> { @card.reload.updated_at } do
+      Card.touch_all_newly_stalled
+    end
+
+    assert_no_changes -> { @card.reload.updated_at } do
+      travel 1.hour
+      Card.touch_all_newly_stalled
+    end
+  end
+
+  private
+    def comment_by(user)
+      @card.comments.create!(body: "Hi", creator: users(user))
+    end
+end
