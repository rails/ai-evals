diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..845154f
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,71 @@
+# A card gets a burst of attention when several people comment on it in a short
+# span, or when someone assigns or reopens it. If the attention then dries up for
+# STALL_PERIOD, the card is stalled. Any activity on a stalled card resets it.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_MIN_COMMENTS = 3
+  BURST_MIN_COMMENTERS = 2
+
+  included do
+    has_one :burst, dependent: :destroy, class_name: "Card::Burst"
+
+    scope :stalled, -> { active.joins(:burst).where(last_active_at: ..STALL_PERIOD.ago) }
+
+    after_update :track_burst, if: :saved_change_to_last_active_at?
+  end
+
+  class_methods do
+    # Cards stall by the passing of time rather than by an update, so touch the ones
+    # that stalled since they were last updated to refresh their cached renderings.
+    def touch_all_newly_stalled
+      stalled
+        .where("#{connection.date_subtract('cards.updated_at', STALL_PERIOD.to_i)} < cards.last_active_at")
+        .find_each(&:touch)
+    end
+  end
+
+  def stalled?
+    active? && burst.present? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def record_burst
+    if burst
+      burst.touch
+    else
+      create_burst!
+    end
+  end
+
+  private
+    def track_burst
+      if comments_burst?
+        record_burst
+      elsif stalled_before_last_activity?
+        reset_burst
+      end
+    end
+
+    def comments_burst?
+      count, commenters = comments.by_user
+        .where(created_at: (last_active_at - burst_window)..last_active_at)
+        .pick(Arel.sql("COUNT(*)"), Arel.sql("COUNT(DISTINCT comments.creator_id)"))
+
+      count >= BURST_MIN_COMMENTS && commenters >= BURST_MIN_COMMENTERS
+    end
+
+    def burst_window
+      (auto_postpone_period / 3).seconds
+    end
+
+    def stalled_before_last_activity?
+      burst.present? && last_active_at_before_last_save.present? &&
+        last_active_at_before_last_save <= last_active_at - STALL_PERIOD
+    end
+
+    def reset_burst
+      burst.destroy
+      reload_burst
+    end
+end
