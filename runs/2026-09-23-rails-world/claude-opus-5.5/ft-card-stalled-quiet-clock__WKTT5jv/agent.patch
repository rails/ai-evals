diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..930be87
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,32 @@
+# A card that had a burst of activity (see Card::ActivitySpike::Detector) and then
+# sees no activity at all for a while is stalled. Any activity on the card bumps
+# +last_active_at+, which resets it.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 14.days
+
+  included do
+    has_one :activity_spike, dependent: :destroy, class_name: "Card::ActivitySpike"
+
+    scope :stalled, -> { active.joins(:activity_spike).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    active? && activity_spike.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def stalled_since
+    last_active_at + STALLED_AFTER if stalled?
+  end
+
+  def detect_activity_spike(event: nil)
+    Card::ActivitySpike::Detector.new(self, event: event).detect
+  end
+
+  # Stalling happens with the passage of time rather than through a change to the
+  # card, so account for it when caching card views.
+  def cache_version
+    stalled? ? "#{super}-stalled" : super
+  end
+end
