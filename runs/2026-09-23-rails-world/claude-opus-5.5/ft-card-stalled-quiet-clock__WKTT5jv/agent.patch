diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..aa8a888
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+    @card.comments.destroy_all
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    comment_as :david, :kevin, :david
+
+    assert @card.reload.activity_spike.present?
+  end
+
+  test "three comments from a single person is not a burst" do
+    comment_as :david, :david, :david
+
+    assert_nil @card.reload.activity_spike
+  end
+
+  test "two comments from two people is not a burst" do
+    comment_as :david, :kevin
+
+    assert_nil @card.reload.activity_spike
+  end
+
+  test "comments spread beyond a third of the auto-close period are not a burst" do
+    period = @card.auto_postpone_period
+
+    travel_to (period / 3 + 1.day).seconds.ago do
+      comment_as :david, :kevin
+    end
+
+    comment_as :david
+
+    assert_nil @card.reload.activity_spike
+  end
+
+  test "the burst window follows the board's auto-close period" do
+    @card.board.update! auto_postpone_period: 3.days
+
+    travel_to 2.days.ago do
+      comment_as :david, :kevin
+    end
+
+    comment_as :david
+    assert_nil @card.reload.activity_spike
+
+    comment_as :kevin, :david
+    assert @card.reload.activity_spike.present?
+  end
+
+  test "system comments don't count towards a burst" do
+    comment_as :david, :kevin
+    @card.comments.create!(body: "System", creator: users(:system))
+
+    assert_nil @card.reload.activity_spike
+  end
+
+  test "assigning someone is a burst" do
+    with_current_user(:david) { @card.toggle_assignment(users(:kevin)) }
+
+    assert @card.reload.activity_spike.present?
+  end
+
+  test "unassigning someone is not a burst" do
+    card = cards(:logo)
+    card.comments.destroy_all
+
+    with_current_user(:david) { card.toggle_assignment(users(:kevin)) }
+
+    assert_nil card.reload.activity_spike
+  end
+
+  test "reopening is a burst" do
+    @card.close
+    assert_nil @card.reload.activity_spike
+
+    @card.reopen
+    assert @card.reload.activity_spike.present?
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    with_current_user(:david) { @card.toggle_assignment(users(:kevin)) }
+    assert_not @card.reload.stalled?
