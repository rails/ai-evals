diff --git a/app/models/card/activity_spike/detector.rb b/app/models/card/activity_spike/detector.rb
new file mode 100644
index 0000000..fcb33ff
--- /dev/null
+++ b/app/models/card/activity_spike/detector.rb
@@ -0,0 +1,56 @@
+# A card has a burst of activity when several people pile onto it with comments
+# within a short window (a third of its board's auto-close period), or when
+# someone is assigned to it or reopens it.
+class Card::ActivitySpike::Detector
+  MINIMUM_COMMENTS = 3
+  MINIMUM_PARTICIPANTS = 2
+  WINDOW_FRACTION_OF_AUTO_POSTPONE_PERIOD = 1.0 / 3
+
+  attr_reader :card, :event
+
+  def initialize(card, event: nil)
+    @card = card
+    @event = event
+  end
+
+  def detect
+    if spike?
+      register_spike
+      true
+    else
+      false
+    end
+  end
+
+  private
+    def spike?
+      card.published? && (card_was_just_assigned? || card_was_just_reopened? || multiple_people_commented?)
+    end
+
+    def card_was_just_assigned?
+      event&.action&.card_assigned?
+    end
+
+    def card_was_just_reopened?
+      event&.action&.card_reopened?
+    end
+
+    def multiple_people_commented?
+      recent_comments = card.comments.by_user.where(created_at: window_start..)
+
+      recent_comments.count >= MINIMUM_COMMENTS &&
+        recent_comments.distinct.count(:creator_id) >= MINIMUM_PARTICIPANTS
+    end
+
+    def window_start
+      (card.auto_postpone_period * WINDOW_FRACTION_OF_AUTO_POSTPONE_PERIOD).seconds.ago
+    end
+
+    def register_spike
+      if card.activity_spike
+        card.activity_spike.touch
+      else
+        card.create_activity_spike!
+      end
+    end
+end
