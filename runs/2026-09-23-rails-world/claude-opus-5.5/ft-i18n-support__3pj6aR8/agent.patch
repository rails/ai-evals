diff --git a/app/javascript/helpers/locale_helpers.js b/app/javascript/helpers/locale_helpers.js
new file mode 100644
index 0000000..5806580
--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,76 @@
+// Strings rendered by JavaScript. Server-rendered text lives in config/locales;
+// keep these in sync when adding a locale.
+const TRANSLATIONS = {
+  en: {
+    intlLocale: "en-US",
+    lessThanAMinuteAgo: "Less than a minute ago",
+    timeAgo: {
+      year: { one: "%{count} year ago", other: "%{count} years ago" },
+      month: { one: "%{count} month ago", other: "%{count} months ago" },
+      week: { one: "%{count} week ago", other: "%{count} weeks ago" },
+      day: { one: "%{count} day ago", other: "%{count} days ago" },
+      hour: { one: "%{count} hour ago", other: "%{count} hours ago" },
+      minute: { one: "%{count} minute ago", other: "%{count} minutes ago" }
+    },
+    today: "today",
+    yesterday: "yesterday",
+    tomorrow: "tomorrow",
+    daysAgo: "%{days} days ago",
+    inDays: "in %{days} days",
+    backTo: "Back to %{label}",
+    fillOutThisField: "Please fill out this field",
+    areYouSure: "Are you sure?",
+    noSelection: "No selection",
+    orConnectors: { two_words_connector: " or ", last_word_connector: ", or " }
+  },
+  ja: {
+    intlLocale: "ja-JP",
+    lessThanAMinuteAgo: "1分以内",
+    timeAgo: {
+      year: { other: "%{count}年前" },
+      month: { other: "%{count}か月前" },
+      week: { other: "%{count}週間前" },
+      day: { other: "%{count}日前" },
+      hour: { other: "%{count}時間前" },
+      minute: { other: "%{count}分前" }
+    },
+    today: "今日",
+    yesterday: "昨日",
+    tomorrow: "明日",
+    daysAgo: "%{days}日前",
+    inDays: "%{days}日後",
+    backTo: "%{label}に戻る",
+    fillOutThisField: "このフィールドを入力してください",
+    areYouSure: "よろしいですか？",
+    noSelection: "未選択",
+    orConnectors: { words_connector: "、", two_words_connector: "または", last_word_connector: "、または" }
+  }
+}
+
+export function currentLocale() {
+  const lang = document.documentElement.lang
+  return TRANSLATIONS[lang] ? lang : "en"
+}
+
+export function intlLocale() {
+  return translate("intlLocale")
+}
+
+export function translate(key, interpolations = {}) {
+  const value = lookup(currentLocale(), key) ?? lookup("en", key)
+  return typeof value === "string" ? interpolate(value, interpolations) : value
+}
+
+export function translatePlural(key, count, interpolations = {}) {
+  const forms = translate(key)
+  const form = (count === 1 && forms.one) ? forms.one : forms.other
+  return interpolate(form, { count, ...interpolations })
+}
+
+function lookup(locale, key) {
+  return key.split(".").reduce((value, part) => value?.[part], TRANSLATIONS[locale])
+}
+
+function interpolate(string, interpolations) {
+  return string.replace(/%\{(\w+)\}/g, (match, name) => name in interpolations ? interpolations[name] : match)
+}
