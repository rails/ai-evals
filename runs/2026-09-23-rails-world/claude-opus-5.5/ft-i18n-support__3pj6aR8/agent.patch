diff --git a/config/initializers/i18n.rb b/config/initializers/i18n.rb
new file mode 100644
index 0000000..80c0d82
--- /dev/null
+++ b/config/initializers/i18n.rb
@@ -0,0 +1,11 @@
+# Load the Rails framework translations (dates, validation errors, number
+# formats…) for the non-English locales we offer. English keeps using the
+# framework defaults, so we only take rails-i18n's English pluralization rule.
+rails_i18n = Gem.loaded_specs["rails-i18n"].full_gem_path
+
+Rails.application.config.i18n.available_locales.each do |locale|
+  I18n.load_path += Dir[File.join(rails_i18n, "rails", "pluralization", "#{locale}.rb")]
+  I18n.load_path += Dir[File.join(rails_i18n, "rails", "locale", "#{locale}.yml")] unless locale == :en
+end
+
+I18n::Backend::Simple.include I18n::Backend::Pluralization
