+<% @page_title = "Plans" %>
+<% account = Current.account %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <%= @page_title %>
+    <div class="txt-normal font-weight-normal">
+      <%= account.name %> is on the <%= account.plan.name %> plan<%= " (complimentary)" if account.comped? %>
+    </div>
+  </h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <% if params[:checkout] == "complete" && !account.subscribed? %>
+      <p class="txt-medium"><strong>Thanks for upgrading!</strong> We’re confirming your payment with Stripe — this page will show your new plan in a moment.</p>
+    <% end %>
+
+    <ul class="list-unindented flex flex-column gap margin-block-half">
+      <% Plan.all.each do |plan| %>
+        <li class="flex align-center gap-half txt-align-start" id="plan_<%= plan.key %>">
+          <div class="flex-item-grow">
+            <strong><%= plan.name %></strong> — <%= plan_price(plan) %>
+            <div class="txt-small txt-ink-medium">
+              <%= plan_card_allowance(plan) %>, <%= plan_storage_allowance(plan) %> storage
+            </div>
+          </div>
+
+          <% if plan == account.plan %>
+            <span class="txt-small"><strong>Current plan</strong></span>
+          <% elsif plan.paid? && Current.user.admin? && !account.comped? && !account.subscribed? %>
+            <%= button_to "Upgrade", upgrade_path, params: { plan: plan.to_param },
+                  class: "btn btn--link", form: { data: { turbo: false } } %>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+
+    <% if Current.user.admin? %>
+      <% if account.subscribed? %>
+        <p class="txt-small">Change or cancel your plan, update payment details, and download invoices in billing.</p>
+        <%= button_to "Manage billing", manage_billing_path, class: "btn", form: { data: { turbo: false } } %>
+      <% end %>
+    <% else %>
+      <p class="txt-small">Only admins can change the plan. Ask an admin of <%= account.name %> to upgrade.</p>
+    <% end %>
+
+    <%= link_to "Back to account settings", account_settings_path, class: "btn btn--plain txt-small margin-block-start" %>
+  </div>
+</div>
