+class Account::BillingPortalsController < ApplicationController
+  include BillingUrls
+
+  before_action :ensure_admin
+  before_action :ensure_customer
+
+  def create
+    redirect_to Current.account.billing_portal_url(return_url: plans_url), allow_other_host: true
+  rescue Stripe::StripeError => error
+    Rails.logger.error "[Billing] Stripe portal failed for account #{Current.account.id}: #{error.message}"
+    Sentry.capture_exception(error) if defined?(Sentry)
+    redirect_to plans_path, alert: "We couldn’t open billing. Please try again."
+  end
+
+  private
+    def ensure_customer
+      redirect_to plans_path unless Current.account.subscription
+    end
+end
