--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,49 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+
+  def plan
+    Plan.find(plan_key) || (Plan.unlimited if active?)
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def canceling?
+    active? && cancel_at.present?
+  end
+
+  def past_due?
+    status == "past_due"
+  end
+
+  def cancel_at_period_end
+    update_stripe_subscription(cancel_at_period_end: true)
+  end
+
+  def resume
+    update_stripe_subscription(cancel_at_period_end: false)
+  end
+
+  def cancel
+    if stripe_subscription_id.present? && !canceled?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+      update!(status: "canceled")
+    end
+  end
+
+  private
+    def update_stripe_subscription(**attributes)
+      if stripe_subscription_id.present? && active?
+        Stripe::Subscription.update(stripe_subscription_id, attributes)
+      end
+    end
+end
diff --git a/saas/app/models/account/subscription/stripe_event.rb b/saas/app/models/account/subscription/stripe_event.rb
new file mode 100644
index 0000000..3eb9635
--- /dev/null
+++ b/saas/app/models/account/subscription/stripe_event.rb
@@ -0,0 +1,98 @@
+# Applies a (verified) Stripe webhook event to our copy of the subscription. Everything
+# needed is in the event payload, so handling an event never calls back into Stripe.
+class Account::Subscription::StripeEvent
+  SUBSCRIPTION_EVENTS = %w[
+    customer.subscription.created
+    customer.subscription.updated
+    customer.subscription.deleted
+    customer.subscription.paused
+    customer.subscription.resumed
+  ].freeze
+
+  attr_reader :type, :object
+
+  def initialize(event)
+    @type = event.type
+    @object = event.data.object.to_hash.deep_symbolize_keys
+  end
+
+  def process
+    case type
+    when "checkout.session.completed" then link_checkout_session
+    when *SUBSCRIPTION_EVENTS then sync_subscription
+    end
+  end
+
+  private
+    def link_checkout_session
+      if object[:mode] == "subscription" && (subscription = find_subscription_for_checkout)
+        subscription.update!(stripe_subscription_id: object[:subscription])
+      end
+    end
+
+    def find_subscription_for_checkout
+      Account::Subscription.find_by(stripe_customer_id: object[:customer]) ||
+        Account::Subscription.find_by(account_id: object[:client_reference_id])
+    end
+
+    def sync_subscription
+      if (subscription = find_subscription) && applicable_to?(subscription)
+        subscription.update!(subscription_attributes)
+      end
+    end
+
+    def find_subscription
+      Account::Subscription.find_by(stripe_subscription_id: object[:id]) ||
+        Account::Subscription.find_by(stripe_customer_id: object[:customer]) ||
+        Account::Subscription.find_by(account_id: object.dig(:metadata, :account_id))
+    end
+
+    # Stripe doesn't guarantee delivery order. A subscription never goes back to incomplete, a
+    # canceled one never comes back, and a stale event about an old subscription must not
+    # clobber the one the customer has now.
+    def applicable_to?(subscription)
+      if subscription.stripe_subscription_id == object[:id]
+        deleted? || !(subscription.canceled? || (subscription.active? && object[:status] == "incomplete"))
+      else
+        subscription.stripe_subscription_id.blank? || !subscription.active? || active?
+      end
+    end
+
+    def subscription_attributes
+      {
+        stripe_subscription_id: object[:id],
+        status: deleted? ? "canceled" : object[:status],
+        plan_key: Plan.find_by_stripe_price_id(price_id)&.key,
+        current_period_end: period_end,
+        cancel_at: cancel_at
+      }
+    end
+
+    def cancel_at
+      timestamp(object[:cancel_at]) || (period_end if object[:cancel_at_period_end])
+    end
+
+    def period_end
+      timestamp(item&.dig(:current_period_end) || object[:current_period_end])
+    end
+
+    def deleted?
+      type == "customer.subscription.deleted"
+    end
+
+    def active?
+      object[:status].in?(Account::Subscription::ACTIVE_STATUSES) && !deleted?
+    end
+
+    def price_id
+      item&.dig(:price, :id) || object.dig(:plan, :id)
+    end
+
+    def item
+      object.dig(:items, :data)&.first
+    end
+
+    def timestamp(value)
+      Time.at(value).utc if value.present?
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..f25318f
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,107 @@
+class Plan
+  PLANS = {
+    free_v1: {
+      name: "Free",
+      price: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte
+    },
+    monthly_v1: {
+      name: "Unlimited",
+      price: 20,
+      storage_limit: 5.gigabytes,
+      stripe_price_id_key: "STRIPE_MONTHLY_V1_PRICE_ID"
+    },
+    monthly_extra_storage_v1: {
+      name: "Unlimited+",
+      price: 25,
+      storage_limit: 500.gigabytes,
+      stripe_price_id_key: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+    }
+  }.freeze
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  class << self
+    def all
+      @all ||= PLANS.map { |key, attributes| new(key: key, **attributes) }
+    end
+
+    def paid
+      all.reject(&:free?)
+    end
+
+    def find(key)
+      all.find { |plan| plan.key.to_s == key.to_s } if key.present?
+    end
+    alias_method :[], :find
+
+    def find_by_stripe_price_id(price_id)
+      all.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id } if price_id.present?
+    end
+
+    def free
+      find(:free_v1)
+    end
+
+    def unlimited
+      find(:monthly_v1)
+    end
+
+    def unlimited_plus
+      find(:monthly_extra_storage_v1)
+    end
+
+    # Accounts comped by support get the standard paid plan without a Stripe subscription.
+    def comped
+      unlimited
+    end
+  end
+
+  def initialize(key:, name:, price:, storage_limit:, card_limit: nil, stripe_price_id_key: nil)
+    @key, @name, @price, @storage_limit, @card_limit = key, name, price, storage_limit, card_limit
+    @stripe_price_id_key = stripe_price_id_key
+  end
+
+  # Read at call time so each environment (and tests) can supply its own Stripe prices.
+  def stripe_price_id
+    ENV[@stripe_price_id_key] if @stripe_price_id_key
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def limits_cards?
+    card_limit.present?
+  end
+
+  def upgrades
+    self.class.paid.select { |plan| plan.storage_limit > storage_limit }
+  end
+
+  def upgradable?
+    upgrades.any?
+  end
+
+  def to_param
+    key.to_s
+  end
+
+  def to_s
+    name
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && other.key == key
+  end
+  alias_method :eql?, :==
+
+  def hash
+    key.hash
+  end
+end
