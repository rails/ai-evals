@@ -0,0 +1,39 @@
+class Account::SubscriptionsController < ApplicationController
+  include BillingUrls
+
+  before_action :ensure_admin, only: :create
+  before_action :ensure_billable, only: :create
+  before_action :set_plan, only: :create
+
+  def show
+  end
+
+  def create
+    redirect_to Current.account.checkout_url_for(@plan,
+      success_url: plans_url(checkout: "complete"),
+      cancel_url: plans_url), allow_other_host: true
+  rescue Stripe::StripeError => error
+    report_stripe_error(error)
+    redirect_to plans_path, alert: "We couldn’t start the upgrade. Please try again."
+  end
+
+  private
+    # Accounts that already pay (or are comped) change plans through the Stripe portal.
+    def ensure_billable
+      if Current.account.comped?
+        redirect_to plans_path, alert: "This account is already on a complimentary plan."
+      elsif Current.account.subscribed?
+        redirect_to plans_path, alert: "Manage your existing subscription to change plans."
+      end
+    end
+
+    def set_plan
+      @plan = Plan.paid.find { |plan| plan.to_param == params[:plan] }
+      head :unprocessable_entity unless @plan
+    end
+
+    def report_stripe_error(error)
+      Rails.logger.error "[Billing] Stripe checkout failed for account #{Current.account.id}: #{error.message}"
+      Sentry.capture_exception(error) if defined?(Sentry)
+    end
+end
