diff --git a/saas/test/controllers/account/billing_settings_test.rb b/saas/test/controllers/account/billing_settings_test.rb
new file mode 100644
index 0000000..524ddf3
--- /dev/null
+++ b/saas/test/controllers/account/billing_settings_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Account::BillingSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "#billing" do
+      assert_select "strong", text: "Free"
+      assert_select "li", text: /0 of 1,000 cards/
+      assert_select "a[href=?]", "#{accounts(:initech).slug}/account/subscription", text: "Upgrade"
+    end
+  end
+
+  test "subscribers see their plan and manage billing" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_1", status: "active", plan_key: "monthly_v1", current_period_end: 2.weeks.from_now)
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select "#billing" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "a", text: "Upgrade"
+      assert_select "button", text: "Manage billing"
+      assert_select "li", text: /\$20\/month, renews on/
+    end
+  end
+
+  test "top-tier subscribers aren't offered an upgrade" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_1", status: "active", plan_key: "monthly_extra_storage_v1")
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select "#billing a", text: "Upgrade", count: 0
+  end
+
+  test "members don't see billing" do
+    sign_in_as :jz
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "#billing", count: 0
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..26aa28f
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :mike
+  end
+
+  test "show lists the plans" do
+    get saas.account_subscription_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#plan_free_v1", text: /Free.*Current plan/m
+    assert_select "#plan_monthly_v1", text: /Unlimited.*\$20\/month.*5 GB/m
+    assert_select "#plan_monthly_extra_storage_v1", text: /Unlimited\+.*\$25\/month.*500 GB/m
+    assert_select "button", text: "Upgrade", count: 2
+  end
+
+  test "upgrading starts a Stripe checkout" do
+    Stripe::Customer.expects(:create).returns(stub(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:line_items] == [ { price: PRICE_IDS["STRIPE_MONTHLY_V1_PRICE_ID"], quantity: 1 } ] &&
+        params[:success_url] == "http://www.example.com#{@account.slug}/account/subscription?checkout=complete" &&
+        params[:cancel_url] == "http://www.example.com#{@account.slug}/account/subscription"
+    end.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_1"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_1"
+    assert_equal "cus_new", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "unknown or free plans are refused" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "free_v1" }
+    assert_response :unprocessable_entity
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "bogus" }
+    assert_response :unprocessable_entity
+  end
+
+  test "Stripe errors are shown rather than raised" do
+    Stripe::Customer.expects(:create).raises(Stripe::APIConnectionError.new("unreachable"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_v1" }
+
+    assert_redirected_to saas.account_subscription_path(script_name: @account.slug)
+    assert_match "couldn’t start the upgrade", flash[:alert]
+  end
+
+  test "subscribed accounts manage their plan in billing" do
+    @account.create_subscription!(stripe_customer_id: "cus_1", status: "active", plan_key: "monthly_v1")
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_extra_storage_v1" }
+    assert_redirected_to saas.account_subscription_path(script_name: @account.slug)
+
+    get saas.account_subscription_path(script_name: @account.slug)
+    assert_select "#plan_monthly_v1", text: /Current plan/
+    assert_select "button", text: "Upgrade", count: 0
+    assert_select "button", text: "Manage billing"
+  end
+
+  test "non-admins can see plans but not upgrade" do
+    logout_and_sign_in_as users(:jz)
+    @account = accounts(:"37s")
+
+    get saas.account_subscription_path(script_name: @account.slug)
+    assert_response :success
+    assert_select "button", text: "Upgrade", count: 0
+    assert_select "p", text: /Ask an admin/
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_v1" }
+    assert_response :forbidden
+  end
+
+  test "billing portal" do
+    @account.create_subscription!(stripe_customer_id: "cus_1", status: "active", plan_key: "monthly_v1")
+    Stripe::BillingPortal::Session.expects(:create)
+      .with(customer: "cus_1", return_url: "http://www.example.com#{@account.slug}/account/subscription")
+      .returns(stub(url: "https://billing.stripe.com/p/session/1"))
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/1"
+  end
+
+  test "billing portal needs a Stripe customer" do
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to saas.account_subscription_path(script_name: @account.slug)
+  end
+end
