+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: :show
+
+  def index
+    set_page_and_extract_portion_from matching_accounts.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  private
+    def matching_accounts
+      if query = params[:q].to_s.strip.presence
+        by_name = Account.where("name LIKE ?", "%#{Account.sanitize_sql_like(query)}%")
+        query.match?(/\A\d+\z/) ? by_name.or(Account.where(external_account_id: query)) : by_name
+      else
+        Account.all
+      end
+    end
+
+    def set_account
+      @account = Account.find(params[:id])
+    end
+end
