+require "test_helper"
+
+class Admin::Accounts::BillingWaiversControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "comp and uncomp" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_billing_waiver_path(@account) }
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert @account.reload.comped?
+    assert_equal Plan.comped, @account.plan
+
+    untenanted { get saas.admin_account_path(@account) }
+    assert_select "button", text: "Uncomp"
+    assert_select "button", text: "Comp", count: 0
+
+    untenanted { delete saas.admin_account_billing_waiver_path(@account) }
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert_not @account.reload.comped?
+  end
+
+  test "non-staff cannot comp" do
+    sign_in_as :jz
+
+    untenanted { post saas.admin_account_billing_waiver_path(@account) }
+
+    assert_response :forbidden
+    assert_not @account.reload.comped?
+  end
+end
diff --git a/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
new file mode 100644
index 0000000..48e28af
--- /dev/null
+++ b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "override and reset" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "1200", bytes_used: "1048576" } }
+    end
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert_equal 1_200, @account.reload.billed_cards_count
+    assert_equal 1.megabyte, @account.billed_bytes_used
+    assert @account.exceeding_card_limit?
+
+    untenanted { get saas.admin_account_path(@account) }
+    assert_select "input[name='overridden_limits[card_count]'][value='1200']"
+    assert_select "button", text: "Reset"
+
+    untenanted { delete saas.admin_account_overridden_limits_path(@account) }
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert_nil @account.reload.overridden_limits
+    assert_equal @account.cards_count, @account.billed_cards_count
+  end
+
+  test "invalid overrides are rejected" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "-5", bytes_used: "" } }
+    end
+
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert flash[:alert].present?
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "non-staff cannot override" do
+    sign_in_as :jz
+
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "0" } }
+    end
+
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limits
+  end
+end
