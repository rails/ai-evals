+<% account = Current.account %>
+
+<section class="settings__section" id="billing">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= account.plan.name %></strong> plan<%= " (complimentary)" if account.comped? %>.
+    </div>
+  </header>
+
+  <ul class="list-unindented margin-block-half txt-small">
+    <li><%= account_card_usage(account) %></li>
+    <li><%= account_storage_usage(account) %> storage</li>
+    <% if (subscription = account.active_subscription) %>
+      <% if subscription.past_due? %>
+        <li class="txt-negative">Your last payment didn’t go through. Please update your payment details.</li>
+      <% elsif subscription.canceling? %>
+        <li>Your subscription ends on <%= subscription.cancel_at.to_date.to_fs(:long) %>.</li>
+      <% elsif subscription.current_period_end %>
+        <li><%= plan_price(account.plan) %>, renews on <%= subscription.current_period_end.to_date.to_fs(:long) %>.</li>
