diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..6fd9dc3 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,37 @@
+# Permanently removes all data belonging to accounts that were cancelled more
+# than INCINERATION_GRACE_PERIOD ago. Until then, a cancelled account can be
+# reactivated.
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> do
+      joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago })
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+  end
+
+  def incinerate
+    Current.with_account(self) do
+      Storage::Entry.without_tracking do
+        destroy!
+        delete_leftover_data
+      end
+    end
+  end
+
+  private
+    # Destroying the account cascades through its associations, but a few records
+    # can outlive it: storage ledger entries and totals aren't dependents of the
+    # account, and blobs are otherwise only purged asynchronously.
+    def delete_leftover_data
+      Storage::Entry.where(account_id: id).delete_all
+      Storage::Total.where(owner_type: self.class.name, owner_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
 end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
index d5ed775..de7780b 100644
--- a/app/models/storage/entry.rb
+++ b/app/models/storage/entry.rb
@@ -5,11 +5,25 @@ class Storage::Entry < ApplicationRecord
 
   scope :pending, ->(last_entry_id) { where.not(id: ..last_entry_id) if last_entry_id }
 
+  # Skip ledger entries entirely, e.g. while incinerating a whole account, when
+  # detach callbacks would otherwise try to record entries for a deleted account.
+  def self.without_tracking
+    previous, ActiveSupport::IsolatedExecutionState[:storage_tracking_disabled] = ActiveSupport::IsolatedExecutionState[:storage_tracking_disabled], true
+    yield
+  ensure
+    ActiveSupport::IsolatedExecutionState[:storage_tracking_disabled] = previous
+  end
+
+  def self.tracking?
+    !ActiveSupport::IsolatedExecutionState[:storage_tracking_disabled]
+  end
+
   # Records may be destroyed (during cascading deletes) but .id still works.
   # Skip entirely if account is destroyed - no need to track storage for deleted accounts.
   # Skip materialize jobs for destroyed boards since there's nothing to update.
   def self.record(delta:, operation:, account:, board: nil, recordable: nil, blob: nil)
     return if delta.zero?
+    return unless tracking?
     return if account.destroyed?
     entry = create! \
       account_id: account.id,
