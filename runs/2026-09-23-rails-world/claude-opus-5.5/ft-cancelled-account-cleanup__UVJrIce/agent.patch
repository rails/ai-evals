diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8a1d83d
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not User.exists?(account_id: @account.id)
+    assert_not Card.exists?(account_id: @account.id)
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  test "does not incinerate accounts cancelled recently" do
+    @account.cancel(initiated_by: @user)
+
+    travel 29.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Card.exists?(account_id: @account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "keeps going when one account fails to incinerate" do
+    other = accounts(:initech)
+    @account.cancel(initiated_by: @user)
+    other.cancel(initiated_by: other.users.where.not(role: :system).first)
+
+    Account.any_instance.stubs(:incinerate).raises(StandardError).then.returns(true)
+    travel 31.days do
+      assert_nothing_raised { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "is scheduled as a recurring task" do
+    config = ActiveSupport::ConfigurationFile.parse(Rails.root.join("config/recurring.yml"))
+    assert_equal "Account::IncinerateDueJob", config.dig("production", "incinerate_due_accounts", "class")
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..dc70b16
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes only accounts cancelled more than the grace period ago" do
+    @account.cancel(initiated_by: @user)
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+
+    travel Account::INCINERATION_GRACE_PERIOD + 1.minute do
+      assert_includes Account.due_for_incineration, @account
+      assert @account.reload.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, accounts(:initech)
+    end
+  end
+
+  test "reactivated accounts are not due for incineration" do
+    @account.cancel(initiated_by: @user)
+    @account.reactivate
+
+    travel Account::INCINERATION_GRACE_PERIOD + 1.minute do
+      assert_not_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "incinerate removes all data associated with the account" do
+    Current.session = sessions(:david)
+    card = @account.cards.first
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @account.materialize_storage
+
+    other_account = accounts(:initech)
+    other_counts = account_scoped_models.to_h { |model| [ model, model.where(account_id: other_account.id).count ] }
+
+    assert account_scoped_models.any? { |model| model.where(account_id: @account.id).exists? }
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    account_scoped_models.each do |model|
+      assert_not model.where(account_id: @account.id).exists?, "Expected no #{model.name} records left for the incinerated account"
+    end
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: @account.id)
+
+    account_scoped_models.each do |model|
+      assert_equal other_counts[model], model.where(account_id: other_account.id).count, "#{model.name} of other accounts should be untouched"
+    end
+  end
+
+  private
+    def account_scoped_models
+      Rails.application.eager_load!
+      ActiveRecord::Base.descendants
+        .reject(&:abstract_class?)
+        .select { |model| model.table_exists? && model.column_names.include?("account_id") }
+        .uniq(&:table_name)
+        .map(&:unscoped)
+        .map(&:klass)
+    end
+end
