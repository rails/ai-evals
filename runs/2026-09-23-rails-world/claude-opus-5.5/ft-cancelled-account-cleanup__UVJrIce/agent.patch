new file mode 100644
index 0000000..f2b1c65
--- /dev/null
+++ b/app/jobs/account/incinerate_due_job.rb
@@ -0,0 +1,18 @@
+class Account::IncinerateDueJob < ApplicationJob
+  queue_as :backend
+
+  def perform
+    Account.due_for_incineration.find_each do |account|
+      incinerate(account)
+    end
+  end
+
+  private
+    def incinerate(account)
+      account.incinerate
+    rescue => error
+      # Don't let one failing account prevent the others from being incinerated.
+      # It will be retried on the next run.
+      Rails.error.report(error, context: { account_id: account.id })
+    end
+end
