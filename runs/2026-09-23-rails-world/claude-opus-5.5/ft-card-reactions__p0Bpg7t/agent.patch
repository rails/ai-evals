+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @david_reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    @kevin_reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "destroy" do
+    reaction = @david_reaction
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, @kevin_reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "cannot destroy a comment reaction through the card" do
+    comment_reaction = comments(:logo_agreement_jz).reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_reaction_path(@card, comment_reaction, format: :turbo_stream)
+      assert_response :not_found
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+    assert_equal card_reaction_url(@card, @david_reaction), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+  end
+
+  test "create with flat JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { content: "👍" }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "destroy as JSON" do
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, @david_reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "card detail view lets users react to the card" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :reacting)}" do
+      assert_select "##{dom_id(@david_reaction)}"
+      assert_select "a[href=?]", new_card_reaction_path(@card)
+    end
+  end
+
+  test "card JSON includes the reactions url" do
+    get card_path(@card), as: :json
+
+    assert_equal card_reactions_url(@card), @response.parsed_body["reactions_url"]
+  end
+end
diff --git a/test/models/account/data_transfer/reaction_record_set_test.rb b/test/models/account/data_transfer/reaction_record_set_test.rb
new file mode 100644
index 0000000..c335729
--- /dev/null
+++ b/test/models/account/data_transfer/reaction_record_set_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Account::DataTransfer::ReactionRecordSetTest < ActiveSupport::TestCase
+  test "import accepts legacy reactions that reference a comment_id" do
+    comment = comments(:logo_1)
+    data = build_reaction_data("comment_id" => comment.id)
+
+    record_set = Account::DataTransfer::ReactionRecordSet.new(comment.account)
+    record_set.import(from: build_reader(data))
+
+    reaction = Reaction.find(data["id"])
+    assert_equal comment, reaction.reactable
+  end
+
+  test "import accepts card reactions" do
+    card = cards(:logo)
+    data = build_reaction_data("reactable_type" => "Card", "reactable_id" => card.id)
+
+    record_set = Account::DataTransfer::ReactionRecordSet.new(card.account)
+    record_set.import(from: build_reader(data))
+
+    assert_equal card, Reaction.find(data["id"]).reactable
+  end
+
+  test "check accepts legacy reactions that reference a comment_id" do
+    data = build_reaction_data("comment_id" => "nonexistent_comment_id_12345", "reacter_id" => "nonexistent_user_id_123456789")
+
+    record_set = Account::DataTransfer::ReactionRecordSet.new(accounts("37s"))
+    record_set.importable_model_names = %w[ Card Comment ]
+
+    assert_nothing_raised do
+      record_set.check(from: build_reader(data))
+    end
+  end
+
+  private
+    def build_reaction_data(reactable_attributes)
+      {
+        "id" => ActiveRecord::Type::Uuid.generate,
+        "account_id" => "nonexistent_account_id_1234567",
+        "content" => "👍",
+        "reacter_id" => users(:david).id,
+        "created_at" => Time.current.iso8601,
+        "updated_at" => Time.current.iso8601
+      }.merge(reactable_attributes)
+    end
+
+    def build_reader(data)
+      tempfile = Tempfile.new([ "import_test", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      writer.add_file("data/reactions/#{data['id']}.json", data.to_json)
+      writer.close
+      tempfile.rewind
+
+      @tempfiles ||= []
+      @tempfiles << tempfile
+
+      ZipFile::Reader.new(tempfile)
+    end
+
+    def teardown
+      @tempfiles&.each { |f| f.close; f.unlink }
+    end
+end
