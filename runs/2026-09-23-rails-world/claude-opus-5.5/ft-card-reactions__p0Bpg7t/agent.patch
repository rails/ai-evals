       comments(:logo_1).reactions.create!(content: "Nice!")
     end
   end
+
+  test "creating a card reaction touches the card activity" do
+    assert_changes -> { cards(:logo).reload.last_active_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "card reactions default account and reacter" do
+    reaction = cards(:logo).reactions.create!(content: "👍")
+
+    assert_equal cards(:logo), reaction.reactable
+    assert_equal cards(:logo), reaction.card
+    assert_equal cards(:logo).account, reaction.account
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "card and comment reactions are kept apart" do
+    card_reaction = cards(:logo).reactions.create!(content: "👍")
+    comment_reaction = comments(:logo_1).reactions.create!(content: "🎉")
+
+    assert_equal [ card_reaction ], cards(:logo).reactions.to_a
+    assert_includes comments(:logo_1).reactions, comment_reaction
+    assert_not_includes comments(:logo_1).reactions, card_reaction
+    assert_equal cards(:logo), comment_reaction.card
+  end
+
+  test "destroying a card reaction touches the card so cached previews refresh" do
+    reaction = cards(:logo).reactions.create!(content: "👍")
+
+    assert_changes -> { cards(:logo).reload.updated_at } do
+      travel 1.minute do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "destroying a card destroys its reactions" do
+    card = cards(:logo)
+    reaction = card.reactions.create!(content: "👍")
+
+    card.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
 end
