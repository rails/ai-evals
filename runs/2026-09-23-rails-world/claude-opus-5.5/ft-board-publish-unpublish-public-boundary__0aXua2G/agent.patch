+  <%= render "public/boards/column", board: @board, column: nil, name: "Not now", cards: open_cards.select(&:postponed?) %>
+  <%= render "public/boards/column", board: @board, column: nil, name: "Done", cards: @cards.select(&:closed?) %>
+</div>
