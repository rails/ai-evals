@@ -0,0 +1,40 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <% if board.published? %>
+      <p class="margin-none-block-start">This board is published. Anyone with the link below can see it, without signing in.</p>
+
+      <div class="flex flex-column gap-half align-center">
+        <%= link_to published_board_url(board), published_board_url(board), class: "txt-small overflow-ellipsis max-width", target: "_blank", data: { turbo_frame: "_top" } %>
+
+        <div class="flex flex-wrap justify-center align-center gap-half">
+          <%= tag.button class: "btn", type: "button", data: {
+                controller: "copy-to-clipboard", action: "copy-to-clipboard#copy",
+                copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: published_board_url(board) } do %>
+            <%= icon_tag "copy-paste" %>
+            <span class="txt-nowrap">Copy public link</span>
+          <% end %>
+
+          <% if Current.user.admin? %>
+            <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative" do %>
+              <span>Unpublish</span>
+            <% end %>
+          <% end %>
+        </div>
+      </div>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to get a secret link that lets anyone see it, without signing in.</p>
+
+      <% if Current.user.admin? %>
+        <div class="flex justify-center">
+          <%= button_to board_publication_path(board), method: :post, class: "btn" do %>
+            <span>Publish this board</span>
+          <% end %>
+        </div>
+      <% else %>
+        <p class="txt-small translucent">Only admins can publish boards.</p>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
