diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..a05c483
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,57 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preload(:reacter)
+  end
+
+  def new
+    @reaction = @comment.reactions.build
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.any(:html, :turbo_stream) { render :new, formats: :html, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden unless @reaction.reacted_by?(Current.user)
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..e961965
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,60 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reactions are rendered once for everyone (cached and broadcast), so whether
+// a reaction is yours, and can be removed, is decided here on the client.
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  #expanded = false
+
+  connect() {
+    this.update()
+  }
+
+  // Reapply client-side state after a page refresh morphs this element
+  update() {
+    const deleteable = this.#isDeleteable
+
+    this.element.classList.toggle(this.deleteableClass, deleteable)
+    this.element.classList.toggle(this.expandedClass, deleteable && this.#expanded)
+
+    if (deleteable) {
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("aria-expanded", this.#expanded)
+    } else {
+      this.element.removeAttribute("tabindex")
+      this.element.removeAttribute("role")
+      this.element.removeAttribute("aria-expanded")
+    }
+  }
+
+  toggle(event) {
+    if (event.target.closest("form")) return
+
+    if (this.#isDeleteable) {
+      this.#expanded = !this.#expanded
+      this.update()
+    }
+  }
+
+  collapse() {
+    if (this.#expanded) {
+      this.#expanded = false
+      this.update()
+    }
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  markDeleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  get #isDeleteable() {
+    return !!this.reacterIdValue && this.reacterIdValue === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
