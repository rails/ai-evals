+<%= turbo_frame_tag comment, :new_reaction do %>
+  <%= form_with model: reaction, scope: :reaction, url: card_comment_reactions_path(comment.card, comment),
+        class: "reaction reaction__form expanded",
+        data: { controller: "reaction-form form morph-guard", action: "keydown.esc->reaction-form#cancel:stop submit->form#preventEmptySubmit" } do |form| %>
+    <%= form.label :content, for: dom_id(comment, :reaction_content), class: "reaction__form-label reaction__avatar flex-item-no-shrink", style: "--avatar-size: auto;", tabindex: -1 do %>
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      <span class="for-screen-reader">Your reaction</span>
+    <% end %>
+
+    <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "input reaction__input",
+          maxlength: Reaction::MAX_LENGTH, required: true, autocomplete: "off", autofocus: true,
+          aria: { invalid: reaction.errors[:content].any? || nil },
+          data: { reaction_form_target: "input", form_target: "input", validation_message: "Type an emoji or a few words" } %>
+
+    <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false" data-action="click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog" data-action="keydown.esc->dialog#close:stop">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn btn--plain" title="<%= name %>" aria-label="<%= name %>"
+                data-action="reaction-form#insertEmoji dialog#close" data-reaction-form-emoji-param="<%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(comment.card, comment), class: "reaction__cancel-btn btn btn--circle borderless",
+          data: { reaction_form_target: "cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
