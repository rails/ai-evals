--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input", "cancel" ]
+
+  connect() {
+    this.inputTarget.focus()
+  }
+
+  insertEmoji({ params: { emoji } }) {
+    const input = this.inputTarget
+    const { selectionStart: start, selectionEnd: end, value } = input
+    const updated = value.slice(0, start ?? value.length) + emoji + value.slice(end ?? value.length)
+
+    if (input.maxLength < 0 || updated.length <= input.maxLength) {
+      input.value = updated
+      input.setSelectionRange(start + emoji.length, start + emoji.length)
+    }
+
+    input.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.cancelTarget.click()
+  }
+}
