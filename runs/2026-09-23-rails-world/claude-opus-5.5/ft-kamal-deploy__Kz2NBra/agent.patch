diff --git a/.kamal/secrets b/.kamal/secrets
new file mode 100644
index 0000000..950080b
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,19 @@
+# Secrets for `bin/kamal`, used by the `env.secret` section of config/deploy.yml.
+#
+# Don't put raw credentials in this file! It is checked into git. Instead, read each value from
+# an environment variable or a password manager, e.g.:
+#
+#   SMTP_PASSWORD=$(op read op://Vault/Fizzy/smtp_password)
+#   SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from Vault/Fizzy SECRET_KEY_BASE SMTP_PASSWORD)
+#
+# Generate SECRET_KEY_BASE with:  bin/rails secret
+# Generate VAPID keys with:       bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{k.private_key}", "VAPID_PUBLIC_KEY=#{k.public_key}"'
+#
+# Keep SECRET_KEY_BASE and the VAPID keys stable between deploys: changing them signs everyone
+# out and breaks existing push notification subscriptions.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
