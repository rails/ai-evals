diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..69504d3
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,107 @@
+# Deploy Fizzy to a single Linux server with Kamal: https://kamal-deploy.org
+#
+# Everything runs in one container on one box: the web server (Puma behind Thruster), the
+# background jobs (Solid Queue inside Puma), and SQLite databases for the app, jobs, cache and
+# Action Cable. kamal-proxy terminates SSL with a Let's Encrypt certificate.
+#
+# To deploy your own instance:
+#
+#   1. Point a DNS record for your hostname at your server, open ports 80 and 443, and make sure
+#      you can `ssh root@your-server` (or set `ssh.user` below). Kamal installs Docker if needed.
+#   2. Replace every `fizzy.example.com` / `mail.example.com` below with your own values.
+#   3. Export the secrets listed in .kamal/secrets in your shell (or change that file to read
+#      them from your password manager).
+#   4. Run `bin/kamal setup` for the first deploy, and `bin/kamal deploy` for every deploy after.
+#
+# Your data (SQLite databases and uploaded files) lives in the `fizzy_storage` Docker volume on
+# the server, so it survives deploys. Back that volume up.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. With the local registry below, it never leaves your machines.
+image: fizzy
+
+# Deploy to this server. Background jobs run inside the web container, so no job role is needed.
+servers:
+  web:
+    - fizzy.example.com
+
+# kamal-proxy routes traffic for this host to the app and gets an SSL certificate from
+# Let's Encrypt. The host's DNS must resolve to the server before running `kamal setup`.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  # Thruster listens on port 80 inside the container.
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Push the image through a registry Kamal runs locally and tunnels to the server over SSH,
+# so you don't need a Docker Hub (or other) account. To use a hosted registry instead, set
+# `server`, `username` and `password` (e.g. `password: [ KAMAL_REGISTRY_PASSWORD ]`).
+registry:
+  server: localhost:5555
+
+# Environment for the app container.
+env:
+  # Values read from .kamal/secrets.
+  secret:
+    - SECRET_KEY_BASE
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+  clear:
+    # Public URL of your instance, used for links in emails.
+    BASE_URL: https://fizzy.example.com
+
+    # Your outgoing mail server. Sign-in codes are delivered by email, so this must work.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+    SMTP_ADDRESS: mail.example.com
+    SMTP_PORT: 587
+    # SMTP_DOMAIN: example.com            # HELO domain; defaults to the BASE_URL host
+    # SMTP_AUTHENTICATION: plain          # plain, login or cram_md5
+    # SMTP_TLS: true                      # for implicit TLS, usually on port 465
+    # SMTP_ENABLE_STARTTLS_AUTO: false
+
+    # Run Solid Queue (background and recurring jobs) inside Puma, in this same container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Use SQLite (the default outside SaaS mode) and store uploads on local disk, both in the volume below.
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Set to true to allow more than one account on this instance.
+    MULTI_TENANT: false
+
+    # Number of Puma workers and Solid Queue worker processes. Default: one per CPU core.
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 1
+
+# Persist SQLite databases and Active Storage files across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Give the first boot time to create the databases before the health check gives up.
+deploy_timeout: 60
+
+# Bridge fingerprinted assets between versions to avoid 404s on in-flight requests during deploys.
+asset_path: /rails/public/assets
+
+# Build the image from the Dockerfile in this repository.
+builder:
+  # Change to arm64 if your server runs on ARM. Building for a different architecture than
+  # your machine uses emulation, which is slow; see `remote` in the Kamal docs to build on the server.
+  arch: amd64
+
+# Use a non-root SSH user (it must be able to run Docker).
+# ssh:
+#   user: app
+
+# Shortcuts: `bin/kamal console`, `bin/kamal shell`, `bin/kamal logs`, `bin/kamal dbc`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
