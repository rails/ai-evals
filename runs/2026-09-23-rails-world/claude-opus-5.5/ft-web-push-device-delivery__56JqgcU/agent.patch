new file mode 100644
index 0000000..c0eda0f
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,24 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions.register(**push_subscription_params, session: Current.session, user_agent: request.user_agent)
+    head :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: error.record.errors, status: :unprocessable_entity
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..187abdc
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,141 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+const SERVICE_WORKER_URL = "/service-worker.js"
+
+// Turns on push notifications for the device in use: asks for permission,
+// subscribes with the push service, and hands the subscription to the server.
+export default class extends Controller {
+  static targets = [ "action", "details", "blockedMessage", "unsupportedMessage" ]
+  static classes = [ "enabled" ]
+  static values = { subscriptionsUrl: String, publicKey: String }
+
+  async connect() {
+    this.#reset()
+
+    if (!this.#supported) {
+      this.#showHelp(this.unsupportedMessageTarget)
+    } else if (Notification.permission === "denied") {
+      this.#showHelp(this.blockedMessageTarget)
+    } else if (Notification.permission === "granted") {
+      await this.#resync()
+    }
+  }
+
+  async subscribe() {
+    if (!this.#supported) {
+      this.#showHelp(this.unsupportedMessageTarget)
+      return
+    }
+
+    // Must be requested straight from the click, before anything else is awaited
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      await this.#subscribeWithPushService()
+    } else if (permission === "denied") {
+      this.#showHelp(this.blockedMessageTarget)
+    }
+  }
+
+  async #resync() {
+    try {
+      const subscription = await this.#existingSubscription()
+
+      if (subscription) {
+        await this.#register(subscription)
+      }
+    } catch (error) {
+      console.error("Couldn't check the push subscription", error)
+    }
+  }
+
+  async #subscribeWithPushService() {
+    try {
+      const subscription = await this.#existingSubscription() || await this.#createSubscription()
+      await this.#register(subscription)
+    } catch (error) {
+      console.error("Couldn't subscribe to push notifications", error)
+      this.#showHelp(this.blockedMessageTarget)
+    }
+  }
+
+  async #existingSubscription() {
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && !this.#signedWithCurrentKey(subscription)) {
+      await subscription.unsubscribe()
+      return null
+    } else {
+      return subscription
+    }
+  }
+
+  async #createSubscription() {
+    const registration = await this.#serviceWorkerRegistration()
+    return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      this.#reset()
+      this.element.classList.add(this.enabledClass)
+    } else {
+      await subscription.unsubscribe()
+      this.#showHelp(this.unsupportedMessageTarget)
+    }
+  }
+
+  async #serviceWorkerRegistration() {
+    if (!await navigator.serviceWorker.getRegistration("/")) {
+      await navigator.serviceWorker.register(SERVICE_WORKER_URL, { scope: "/" })
+    }
+
+    return navigator.serviceWorker.ready
+  }
+
+  #signedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+
+    if (key) {
+      const current = this.#applicationServerKey
+      const existing = new Uint8Array(key)
+      return existing.length === current.length && existing.every((byte, index) => byte === current[index])
+    } else {
+      return true
+    }
+  }
+
+  #reset() {
+    this.element.classList.remove(this.enabledClass)
+    this.actionTarget.hidden = false
+    this.blockedMessageTarget.hidden = true
+    this.unsupportedMessageTarget.hidden = true
+    this.detailsTargets.forEach(target => target.hidden = true)
+  }
+
+  #showHelp(message) {
+    this.#reset()
+    this.actionTarget.hidden = message === this.unsupportedMessageTarget
+    message.hidden = false
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
