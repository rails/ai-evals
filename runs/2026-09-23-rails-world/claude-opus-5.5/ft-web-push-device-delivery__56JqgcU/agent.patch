diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..a71af61
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,37 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :push_later, on: %i[ create update ], if: :landed_in_tray?
+  end
+
+  def push
+    if pushable?
+      payload = push_payload
+
+      user.push_subscriptions.find_each do |subscription|
+        subscription.deliver(payload)
+      rescue WebPush::Error, Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError, OpenSSL::SSL::SSLError => error
+        Rails.error.report(error, severity: :warning, context: { push_subscription_id: subscription.id })
+      end
+    end
+  end
+
+  private
+    def landed_in_tray?
+      previously_new_record? || saved_change_to_source_id?
+    end
+
+    def push_later
+      Notification::PushJob.perform_later(self) if pushable?
+    end
+
+    def pushable?
+      Push.enabled? && !read? && user.active? && !user.system? && user.push_subscriptions.exists?
+    end
+
+    def push_payload
+      ApplicationController.renderer.new(script_name: account.slug)
+        .render(partial: "notifications/push", formats: :json, locals: { notification: self })
+    end
+end
