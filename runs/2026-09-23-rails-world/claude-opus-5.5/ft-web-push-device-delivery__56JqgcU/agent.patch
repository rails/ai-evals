--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,10 @@
+# VAPID key pair used to sign Web Push requests. Generate a pair with:
+#
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}", "VAPID_PRIVATE_KEY=#{key.private_key}"'
+#
+# Push notifications are disabled unless both keys are present.
+Rails.application.configure do
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+  config.x.vapid.subject = ENV.fetch("VAPID_SUBJECT") { "mailto:#{Mail::Address.new(ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")).address}" }
+end
