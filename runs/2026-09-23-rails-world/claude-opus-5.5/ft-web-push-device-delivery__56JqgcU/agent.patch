diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..7f8807a
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    @kevin = users(:kevin)
+  end
+
+  test "a new notification is pushed to every device the user subscribed" do
+    with_vapid_keys do
+      notification = nil
+      assert_enqueued_with(job: Notification::PushJob) do
+        notification = create_notification_for @kevin
+      end
+
+      delivered = []
+      Push::Subscription.any_instance.stubs(:deliver).with { |payload| delivered << payload }
+
+      perform_enqueued_jobs only: Notification::PushJob
+
+      assert_equal 2, delivered.size
+      payload = JSON.parse(delivered.first)
+      assert_equal "Layout is broken", payload["title"]
+      assert_equal "Added by David", payload["body"]
+      assert_equal "/#{accounts("37s").external_account_id}/cards/#{notification.card.number}", payload["path"]
+      assert_equal ActionView::RecordIdentifier.dom_id(notification), payload["tag"]
+      assert_equal @kevin.notifications.unread.count, payload["badge"]
+    end
+  end
+
+  test "the push says what the tray says" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = JSON.parse(notification.send(:push_payload))
+
+    tray = ApplicationController.render(partial: "notifications/notification", formats: :json, locals: { notification: notification })
+    assert_equal JSON.parse(tray).values_at("title", "body"), payload.values_at("title", "body")
+  end
+
+  test "a notification that resurfaces with a new source is pushed again" do
+    with_vapid_keys do
+      notification = notifications(:logo_assignment_kevin)
+      notification.read
+
+      assert_enqueued_with(job: Notification::PushJob, args: [ notification ]) do
+        notification.update!(source: events(:logo_published), read_at: nil)
+      end
+
+      assert_no_enqueued_jobs only: Notification::PushJob do
+        notification.read
+      end
+    end
+  end
+
+  test "nothing is pushed when push isn't configured" do
+    assert_not Push.enabled?
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      create_notification_for @kevin
+    end
+  end
+
+  test "nothing is pushed to users without subscriptions" do
+    with_vapid_keys do
+      assert_no_enqueued_jobs only: Notification::PushJob do
+        create_notification_for users(:jz)
+      end
+    end
+  end
+
+  test "a notification read before the push goes out isn't pushed" do
+    with_vapid_keys do
+      notification = create_notification_for @kevin
+      notification.read
+
+      Push::Subscription.any_instance.expects(:deliver).never
+      notification.push
+    end
+  end
+
+  test "a failing device doesn't stop the others" do
+    with_vapid_keys do
+      notification = create_notification_for @kevin
+
+      WebPush.expects(:payload_send).twice.raises(WebPush::PushServiceError.new(stub(body: ""), "fcm.googleapis.com")).then.returns(true)
+      assert_nothing_raised { notification.push }
+      assert_equal 2, @kevin.push_subscriptions.count
+    end
+  end
+
+  private
+    def create_notification_for(user)
+      event = events(:layout_published)
+      user.notifications.find_by(card: event.card)&.destroy
+      user.notifications.create!(source: event, creator: event.creator, unread_count: 1)
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..6c74bfb
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    @user = users(:david)
+  end
+
+  test "accepts endpoints from the push services browsers use" do
+    %w[
+      https://fcm.googleapis.com/fcm/send/abc
+      https://updates.push.services.mozilla.com/wpush/v2/abc
+      https://web.push.apple.com/QGuQyavXutnMH6nd7GAdYe
+      https://wns2-par02p.notify.windows.com/w/?token=abc
+    ].each do |endpoint|
+      assert build_subscription(endpoint: endpoint).valid?, "Expected #{endpoint} to be accepted"
+    end
+  end
+
+  test "rejects endpoints that aren't a known push service" do
+    %w[
+      http://fcm.googleapis.com/fcm/send/abc
+      https://example.com/push
+      https://fcm.googleapis.com.example.com/push
+      https://fcm.googleapis.com:8443/fcm/send/abc
+      https://user:secret@fcm.googleapis.com/fcm/send/abc
+      https://169.254.169.254/latest/meta-data
+      https://localhost/push
+      javascript:alert(1)
+      not\ a\ url
+    ].each do |endpoint|
+      subscription = build_subscription(endpoint: endpoint)
+      assert_not subscription.valid?, "Expected #{endpoint} to be rejected"
+      assert subscription.errors.of_kind?(:endpoint, :invalid) || subscription.errors[:endpoint].any?
+    end
+  end
+
+  test "rejects malformed keys" do
+    assert_not build_subscription(p256dh_key: "not-a-key").valid?
+    assert_not build_subscription(auth_key: Base64.urlsafe_encode64("short", padding: false)).valid?
+    assert_not build_subscription(p256dh_key: "", auth_key: "").valid?
+  end
+
+  test "register creates a subscription and updates it when the endpoint is seen again" do
+    endpoint = "https://fcm.googleapis.com/fcm/send/new-device"
+
+    subscription = assert_difference -> { @user.push_subscriptions.count }, +1 do
+      @user.push_subscriptions.register(endpoint: endpoint, **push_subscription_keys)
+    end
+    assert_equal accounts("37s"), subscription.account
+
+    new_keys = push_subscription_keys
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      @user.push_subscriptions.register(endpoint: endpoint, **new_keys)
+    end
+    assert_equal new_keys[:p256dh_key], subscription.reload.p256dh_key
+  end
+
+  test "deliver sends the payload to the push service" do
+    subscription = push_subscriptions(:kevin_chrome)
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |message:, endpoint:, p256dh:, auth:, vapid:, **|
+        message == "payload" && endpoint == subscription.endpoint && p256dh == subscription.p256dh_key &&
+          auth == subscription.auth_key && vapid[:public_key] == Push.vapid_public_key
+      end
+
+      subscription.deliver("payload")
+    end
+  end
+
+  test "deliver forgets subscriptions the push service no longer knows" do
+    [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription ].each do |error|
+      subscription = @user.push_subscriptions.register(endpoint: "https://fcm.googleapis.com/fcm/send/#{error.name}", **push_subscription_keys)
+      WebPush.expects(:payload_send).raises(error.new(stub(body: ""), "fcm.googleapis.com"))
+
+      with_vapid_keys { subscription.deliver("payload") }
+
+      assert subscription.destroyed?
+    end
+  end
+
+  test "deliver never contacts a stored endpoint that isn't a push service" do
+    subscription = push_subscriptions(:kevin_chrome)
+    subscription.update_column :endpoint, "https://169.254.169.254/latest/meta-data"
+
+    WebPush.expects(:payload_send).never
+    with_vapid_keys { subscription.deliver("payload") }
+
+    assert subscription.destroyed?
+  end
+
+  test "signing out removes the subscriptions made in that session" do
+    signed_in, other = push_subscriptions(:kevin_chrome), push_subscriptions(:kevin_safari)
+
+    sessions(:kevin).destroy
+
+    assert_not Push::Subscription.exists?(signed_in.id)
+    assert Push::Subscription.exists?(other.id)
+  end
+
+  test "deactivating a user removes their subscriptions" do
+    users(:kevin).deactivate
+
+    assert_empty users(:kevin).push_subscriptions
+  end
+
+  private
+    def build_subscription(**attributes)
+      @user.push_subscriptions.build(endpoint: "https://fcm.googleapis.com/fcm/send/abc", **push_subscription_keys, **attributes)
+    end
+end
diff --git a/test/test_helpers/push_test_helper.rb b/test/test_helpers/push_test_helper.rb
new file mode 100644
index 0000000..2febbe6
--- /dev/null
+++ b/test/test_helpers/push_test_helper.rb
@@ -0,0 +1,19 @@
+module PushTestHelper
+  def with_vapid_keys(&)
+    key = WebPush.generate_key
+    vapid = Rails.configuration.x.vapid
+
+    original = vapid.public_key, vapid.private_key
+    vapid.public_key, vapid.private_key = key.public_key, key.private_key
+    yield
+  ensure
+    vapid.public_key, vapid.private_key = original
+  end
+
+  def push_subscription_keys
+    {
+      p256dh_key: Base64.urlsafe_encode64(OpenSSL::PKey::EC.generate("prime256v1").public_key.to_bn.to_s(2), padding: false),
+      auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16), padding: false)
+    }
+  end
+end
