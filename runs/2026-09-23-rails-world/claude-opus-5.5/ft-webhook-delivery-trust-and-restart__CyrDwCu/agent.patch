diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..afcfce3
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,34 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  DELINQUENCY_THRESHOLD = 10
+  DELINQUENCY_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_delivery_of(delivery)
+    if delivery.succeeded?
+      reset
+    else
+      record_failure
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def delinquent?
+    consecutive_failures_count >= DELINQUENCY_THRESHOLD && first_failure_at.present? && first_failure_at <= DELINQUENCY_DURATION.ago
+  end
+
+  private
+    def record_failure
+      with_lock do
+        self.first_failure_at = Time.current if consecutive_failures_count.zero?
+        self.consecutive_failures_count += 1
+        save!
+      end
+
+      webhook.deactivate if delinquent?
+    end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..55facc8 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,7 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 7.days
+  CLEANUP_BATCH_SIZE = 1_000
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +12,29 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  after_create_commit :deliver_later
+
+  def self.cleanup
+    stale.in_batches(of: CLEANUP_BATCH_SIZE).delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  # Delivery happens at most once: the pending -> in_progress transition is an atomic
+  # claim, so duplicated or retried jobs can't send the same delivery twice.
+  def deliver
+    if claim
+      if webhook.active?
+        perform_delivery
+      else
+        update! state: :errored, response: { error: :webhook_inactive }
+      end
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +53,42 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+        self.state = :in_progress
+        true
+      end
+    end
+
+    def perform_delivery
+      outgoing = Webhook::Request.new(self)
+      self.request = { headers: outgoing.headers }
+
+      begin
+        self.response = outgoing.perform
+        self.state = :completed
+      rescue => error
+        self.response = { error: error_code_for(error) }
+        self.state = :errored
+        Rails.error.report(error, handled: true, severity: :info, context: { webhook_delivery_id: id })
+      end
+
+      save!
+      webhook.tracker.record_delivery_of(self)
+    end
+
+    def error_code_for(error)
+      case error
+      when Webhook::Request::PrivateDestinationError then :private_uri
+      when Resolv::ResolvError, SocketError then :dns_lookup_failed
+      when Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Timeout::Error then :connection_timeout
+      when OpenSSL::SSL::SSLError then :failed_tls
+      when Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ECONNRESET, EOFError, IOError then :destination_unreachable
+      else :internal_error
+      end
+    end
 end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..827513e
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,123 @@
+class Webhook::Request
+  class PrivateDestinationError < StandardError; end
+
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 7.seconds
+  READ_TIMEOUT = 7.seconds
+  MAX_RESPONSE_BODY_SIZE = 64.kilobytes
+
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def perform
+    http_response = http.request(post_request)
+
+    { code: http_response.code.to_i, headers: http_response.each_header.to_h, body: http_response.body.to_s.byteslice(0, MAX_RESPONSE_BODY_SIZE).scrub }
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => content_type,
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Timestamp" => timestamp
+    }
+  end
+
+  def body
+    @body ||= if webhook.for_campfire?
+      render_event(:html)
+    elsif webhook.for_basecamp?
+      { content: render_event(:html) }.to_query
+    elsif webhook.for_slack?
+      { text: slack_text }.to_json
+    else
+      render_event(:json)
+    end
+  end
+
+  private
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      elsif webhook.for_basecamp?
+        "application/x-www-form-urlencoded"
+      else
+        "application/json"
+      end
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def timestamp
+      @timestamp ||= Time.current.utc.iso8601(3)
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = READ_TIMEOUT
+      end
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri, headers).tap { it.body = body }
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    # Pin the connection to a vetted public address so that DNS rebinding can't
+    # point a webhook at internal services.
+    def resolved_ip
+      SsrfProtection.resolve_public_ip(uri.host) or raise PrivateDestinationError, "#{uri.host} does not resolve to a public IP address"
+    end
+
+    def render_event(format)
+      renderer.render(template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event })
+    end
+
+    def slack_text
+      description = slack_escape(CGI.unescapeHTML(event.description_for(nil).to_plain_text.to_str))
+
+      if event.eventable
+        "#{description} <#{Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)}|↗︎>"
+      else
+        description
+      end
+    end
+
+    # Slack's mrkdwn only requires &, <, and > to be escaped
+    def slack_escape(text)
+      text.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(
+        http_host: [ url_options[:host], url_options[:port] ].compact.join(":"),
+        https: url_options[:protocol] == "https",
+        script_name: url_options[:script_name]
+      )
+    end
+
+    def url_options
+      @url_options ||= begin
+        base = (Rails.application.routes.default_url_options.presence ||
+          Rails.application.config.action_mailer.default_url_options.presence ||
+          { host: "localhost" }).symbolize_keys
+
+        base.merge(protocol: base.fetch(:protocol, "https").to_s.delete_suffix("://"), script_name: event.account.slug)
+      end
+    end
+end
