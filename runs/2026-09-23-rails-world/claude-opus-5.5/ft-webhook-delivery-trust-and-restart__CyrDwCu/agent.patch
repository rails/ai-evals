index 0000000..4b7bc32
--- /dev/null
+++ b/test/models/webhook/delivery_flow_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class Webhook::DeliveryFlowTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    Current.session = sessions(:david)
+    @webhook = webhooks(:active)
+    stub_dns_resolution(PUBLIC_IP)
+  end
+
+  test "an event on the board is POSTed to subscribed webhooks, signed, and logged" do
+    stub = stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200, body: "ok")
+    card = cards(:logo)
+    card.reopen if card.closed?
+
+    perform_enqueued_jobs do
+      card.close
+    end
+
+    assert_requested stub, times: 1
+    delivery = @webhook.deliveries.ordered.first
+    assert_equal "card_closed", delivery.event.action
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+
+    assert_requested(:post, @webhook.url) do |request|
+      payload = JSON.parse(request.body)
+      expected_signature = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body)
+
+      payload["action"] == "card_closed" &&
+        payload.dig("eventable", "id") == card.id &&
+        request.headers["X-Webhook-Signature"] == expected_signature &&
+        request.headers["Content-Type"] == "application/json" &&
+        request.headers["X-Webhook-Timestamp"].present?
+    end
+  end
+
+  test "events are not dispatched to unsubscribed, inactive, or other-board webhooks" do
+    event = events(:layout_commented) # comment_created, not subscribed
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks
+    end
+
+    event = new_event("card_published")
+    Webhook::Delivery.delete_all
+    @webhook.deactivate
+    event.dispatch_webhooks
+    assert_empty Webhook::Delivery.where(event: event)
+
+    @webhook.activate
+    other_board_event = new_event("card_published", board: boards(:private))
+    other_board_event.dispatch_webhooks
+    assert_empty Webhook::Delivery.where(event: other_board_event)
+  end
+
+  test "dispatching twice creates a single delivery" do
+    event = new_event("card_published")
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      event.dispatch_webhooks
+      event.dispatch_webhooks
+    end
+  end
+
+  test "a delivery is sent exactly once even if its job runs repeatedly" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+    delivery = @webhook.deliveries.create!(event: new_event("card_closed"))
+
+    3.times { Webhook::DeliveryJob.perform_now(delivery) }
+    Webhook::Delivery.find(delivery.id).deliver
+
+    assert_requested stub, times: 1
+    assert delivery.reload.succeeded?
+  end
+
+  test "failed deliveries are logged with the response code or error" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    delivery = @webhook.deliveries.create!(event: new_event("card_closed"))
+    delivery.deliver
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+
+    stub_request(:post, @webhook.url).to_timeout
+    delivery = @webhook.deliveries.create!(event: new_event("card_closed"))
+    delivery.deliver
+    assert delivery.reload.errored?
+    assert_equal "connection_timeout", delivery.response[:error]
+    assert_nil delivery.sanitized_request[:headers]["X-Webhook-Signature"]
+  end
+
+  test "private destinations are refused" do
+    stub_dns_resolution("127.0.0.1")
+    delivery = @webhook.deliveries.create!(event: new_event("card_closed"))
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "private_uri", delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "ten consecutive failures over an hour deactivate the webhook" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    travel_to 2.hours.ago do
+      fail_deliveries 5
+    end
+    assert @webhook.reload.active?
+
+    fail_deliveries 4
+    assert @webhook.reload.active?, "only nine failures so far"
+
+    fail_deliveries 1
+    assert_not @webhook.reload.active?
+  end
+
+  test "ten failures within an hour don't deactivate the webhook" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    fail_deliveries 12
+    assert @webhook.reload.active?
+  end
+
+  test "a success resets the failure streak" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    travel_to(2.hours.ago) { fail_deliveries 9 }
+
+    stub_request(:post, @webhook.url).to_return(status: 204)
+    fail_deliveries 1
+    assert_equal 0, @webhook.tracker.reload.consecutive_failures_count
+
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    fail_deliveries 1
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating resets the tracker" do
+    @webhook.tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @webhook.tracker.consecutive_failures_count
+  end
+
+  test "deliveries queued for a deactivated webhook are not sent" do
+    delivery = @webhook.deliveries.create!(event: new_event("card_closed"))
+    @webhook.deactivate
+
+    delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+    assert_equal "webhook_inactive", delivery.reload.response[:error]
+  end
+
+  test "cleanup keeps a week of deliveries" do
+    recent = @webhook.deliveries.create!(event: new_event("card_closed"))
+    old = @webhook.deliveries.create!(event: new_event("card_closed"), created_at: 8.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(recent.id)
+    assert_not Webhook::Delivery.exists?(old.id)
+  end
+
+  test "slack, campfire, and basecamp payloads" do
+    event = events(:layout_commented)
+
+    @webhook.update_columns url: "https://hooks.slack.com/services/T1/B1/abc"
+    request = Webhook::Request.new(@webhook.deliveries.new(event: event))
+    text = JSON.parse(request.body)["text"]
+    assert_match %r{<https://example.com/\d+/cards/}, text
+    assert_includes text, %("Layout is broken")
+    assert_equal "application/json", request.headers["Content-Type"]
+
+    @webhook.update_columns url: "https://example.com/rooms/1/2-bot/messages"
+    request = Webhook::Request.new(@webhook.deliveries.new(event: event))
+    assert_equal "text/html", request.headers["Content-Type"]
+    assert_includes request.body, "href="
+
+    @webhook.update_columns url: "https://3.basecamp.com/1/integrations/tok/buckets/2/chats/3/lines"
+    request = Webhook::Request.new(@webhook.deliveries.new(event: event))
+    assert_equal "application/x-www-form-urlencoded", request.headers["Content-Type"]
+    assert Rack::Utils.parse_query(request.body)["content"].present?
+  end
+
+  private
+    def fail_deliveries(count)
+      count.times do
+        Webhook::Delivery.create!(webhook: @webhook, event: new_event("card_closed")).deliver
+      end
+    end
+
+    def new_event(action, board: @webhook.board)
+      Event.create!(action: action, board: board, eventable: cards(:logo), creator: users(:david))
+    end
+end
