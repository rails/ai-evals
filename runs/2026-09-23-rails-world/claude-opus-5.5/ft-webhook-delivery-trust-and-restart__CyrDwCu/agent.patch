+module Event::Webhookable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :dispatch_webhooks_later
+  end
+
+  def dispatch_webhooks
+    Webhook.active.triggered_by(self).find_each do |webhook|
+      webhook.trigger(self) if webhook.triggered_by?(self)
