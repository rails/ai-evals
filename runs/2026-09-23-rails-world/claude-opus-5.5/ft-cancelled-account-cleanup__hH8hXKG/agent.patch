diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..6a140ea
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    due = accounts(:"37s")
+    recent = accounts(:initech)
+
+    due.cancel(initiated_by: users(:david))
+    due.cancellation.update!(created_at: 31.days.ago)
+    recent.cancel(initiated_by: recent.users.first)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due.id)
+    assert_not Card.exists?(account_id: due.id)
+    assert_not User.exists?(account_id: due.id)
+    assert Account.exists?(recent.id)
+    assert Card.exists?(account_id: recent.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..fea6afe
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    cancel @account, days_ago: 31
+    cancel accounts(:initech), days_ago: 29
+
+    assert_equal [ @account ], Account.due_for_incineration.to_a
+  end
+
+  test "incinerate removes all data associated with the account" do
+    Current.session = sessions(:david)
+    card = @account.cards.first
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @account.boards.first.cards.create!(title: "Searchable incineration card", status: :published)
+    @user.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @account.materialize_storage
+
+    cancel @account, days_ago: 31
+    other_account_counts = account_scoped_row_counts(accounts(:initech))
+
+    assert_not_empty account_scoped_row_counts(@account)
+    assert ActiveStorage::Blob.where(account_id: @account.id).exists?
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty account_scoped_row_counts(@account)
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: @account.id)
+    assert_equal other_account_counts, account_scoped_row_counts(accounts(:initech))
+    assert Identity.exists?(identities(:david).id)
+  end
+
+  test "incinerate does nothing for accounts that are not due" do
+    cancel @account, days_ago: 29
+    @account.incinerate
+    assert Account.exists?(@account.id)
+
+    accounts(:initech).incinerate
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  test "incinerate does nothing if the account was reactivated" do
+    cancel @account, days_ago: 31
+    stale = Account.find(@account.id)
+    @account.reactivate
+
+    stale.incinerate
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate_all_due only incinerates due accounts" do
+    cancel @account, days_ago: 31
+    cancel accounts(:initech), days_ago: 29
+
+    Account.incinerate_all_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  private
+    def cancel(account, days_ago:)
+      account.cancel(initiated_by: account.users.owner.first || account.users.first)
+      account.cancellation.update!(created_at: days_ago.days.ago)
+    end
+
+    def account_scoped_row_counts(account)
+      connection = ActiveRecord::Base.connection
+      connection.tables.select { |table| connection.column_exists?(table, :account_id) }.to_h do |table|
+        [ table, Class.new(ApplicationRecord) { self.table_name = table }.where(account_id: account.id).count ]
+      end.reject { |_, count| count.zero? }
+    end
+end
