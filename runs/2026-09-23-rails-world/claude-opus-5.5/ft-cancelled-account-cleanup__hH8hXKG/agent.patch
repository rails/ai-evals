diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..0653169 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,82 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_all_due
+      due_for_incineration.find_each do |account|
+        account.incinerate
+      rescue => error
+        Rails.error.report(error, context: { account_id: account.id })
+      end
+    end
+  end
+
+  def incinerate
+    if destroyed_for_incineration?
+      sweep_incinerated_data
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    def destroyed_for_incineration?
+      with_lock do
+        if due_for_incineration?
+          destroy!
+        end
+      end.present?
+    end
+
+    # Destroying the account cascades through its associations, running callbacks that clean up
+    # search records, attachments, etc. Once that has committed (and its after-commit callbacks
+    # have run), sweep anything the cascade didn't reach, so no data tied to the account survives.
+    def sweep_incinerated_data
+      sweep_search_records
+      sweep_filters
+      sweep_storage_totals
+      sweep_active_storage
+      sweep_account_scoped_tables
+    end
+
+    def sweep_search_records
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+    end
+
+    def sweep_filters
+      Filter.where(account_id: id).find_each(&:destroy!)
+    end
+
+    def sweep_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: Board.where(account_id: id).select(:id)).delete_all
+    end
+
+    def sweep_active_storage
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
+
+    def sweep_account_scoped_tables
+      account_scoped_tables.each do |table|
+        incinerable_rows_in(table).delete_all
+      end
+    end
+
+    def account_scoped_tables
+      self.class.connection.then { |connection| connection.tables.select { |table| connection.column_exists?(table, :account_id) } }
+    end
+
+    def incinerable_rows_in(table)
+      Class.new(ApplicationRecord) { self.table_name = table }.where(account_id: id)
+    end
 end
