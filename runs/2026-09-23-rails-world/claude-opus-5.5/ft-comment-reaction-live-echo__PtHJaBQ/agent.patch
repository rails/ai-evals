+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "new" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} form.reaction__form input.reaction__input[maxlength=16]"
+  end
+
+  test "index renders the trigger back" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger"
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great work!" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions)
+    assert_turbo_stream action: :update, target: dom_id(@comment, :new_reaction) do
+      assert_select "a.reactions__trigger"
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal "Great work!", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "create with too long content" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy" do
+    reaction = reactions(:kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "can't destroy someone else's reaction" do
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reactions(:david)), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "card shows the reactions strip" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 2
+    assert_select "##{dom_id(@comment, :reactions)} ##{dom_id(reactions(:kevin))}[data-reaction-reacter-id-value=?]", users(:kevin).id
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger img[src*=boost-color]"
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ "👍", "Great 👍" ], @response.parsed_body.pluck("content")
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "create as JSON" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :json
+
+    assert_response :created
+    assert_equal "🎉", @response.parsed_body["content"]
+  end
+
+  test "destroy as JSON" do
+    delete card_comment_reaction_path(@card, @comment, reactions(:kevin)), as: :json
+
+    assert_response :no_content
+  end
+end
