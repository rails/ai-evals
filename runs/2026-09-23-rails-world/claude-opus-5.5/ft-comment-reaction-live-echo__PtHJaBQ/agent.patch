+module Reaction::Broadcastable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit  :broadcast_addition
+    after_destroy_commit :broadcast_removal
+  end
+
+  private
+    def broadcast_addition
+      broadcast_append_to card, target: ActionView::RecordIdentifier.dom_id(reactable, :reactions), partial: "reactions/reaction"
+    end
+
+    def broadcast_removal
+      broadcast_remove_to card
+    end
+end
