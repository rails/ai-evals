@@ -0,0 +1,18 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    polymorphic_path([ *reactable_route(reactable), :reactions ])
+  end
+
+  def new_reaction_path_for(reactable)
+    new_polymorphic_path([ *reactable_route(reactable), :reaction ])
+  end
+
+  def reaction_path_for(reaction)
+    polymorphic_path([ *reactable_route(reaction.reactable), reaction ])
+  end
+
+  private
+    def reactable_route(reactable)
+      [ reactable.card, reactable ]
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..558f572
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,58 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reactions are rendered the same for everyone (they are cached and broadcast),
+// so ownership is resolved on the client: only the reacter can reveal the
+// button to remove their reaction.
+export default class extends Controller {
+  static values = { reacterId: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  refresh() {
+    this.element.classList.toggle("reaction--deleteable", this.#deleteable)
+
+    if (this.#deleteable) {
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("aria-expanded", this.#expanded)
+    }
+  }
+
+  toggle(event) {
+    if (!this.#deleteable || this.#isOnDeleteButton(event)) return
+
+    this.#expanded ? this.collapse() : this.#expand()
+  }
+
+  collapse() {
+    this.element.classList.remove("expanded")
+    this.refresh()
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  remove() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  #expand() {
+    this.element.classList.add("expanded")
+    this.refresh()
+  }
+
+  #isOnDeleteButton(event) {
+    return event.target.closest(".reaction__delete, form")
+  }
+
+  get #expanded() {
+    return this.element.classList.contains("expanded")
+  }
+
+  get #deleteable() {
+    return Current.user?.id === this.reacterIdValue
+  }
+}
