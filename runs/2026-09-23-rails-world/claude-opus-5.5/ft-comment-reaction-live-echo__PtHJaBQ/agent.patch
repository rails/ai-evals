+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "fixtures" do
+    assert_equal @comment, reactions(:kevin).reactable
+    assert_equal users(:kevin), reactions(:kevin).reacter
+    assert_equal [ reactions(:kevin), reactions(:david) ], @comment.reactions.to_a
+  end
+
+  test "create defaults the reacter and account" do
+    reaction = @comment.reactions.create!(content: "🎉")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "content is stripped and required" do
+    assert_equal "Nice", @comment.reactions.create!(content: "  Nice  ").content
+    assert_not @comment.reactions.build(content: "   ").valid?
+  end
+
+  test "content is at most 16 characters" do
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+    assert @comment.reactions.build(content: "👨‍👩‍👧‍👦" * 16).valid?
+  end
+
+  test "reacting touches the comment and the card activity" do
+    card = @comment.card
+    card.update_column :last_active_at, 1.week.ago
+
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create!(content: "👍")
+    end
+    assert_in_delta Time.current, card.reload.last_active_at, 5.seconds
+  end
+
+  test "emoji only" do
+    assert Reaction.new(content: "👍").emoji_only?
+    assert Reaction.new(content: "❤️🎉").emoji_only?
+    assert Reaction.new(content: "👍🏽").emoji_only?
+    assert_not Reaction.new(content: "Great 👍").emoji_only?
+    assert_not Reaction.new(content: "123").emoji_only?
+  end
+
+  test "broadcasts additions and removals to the card" do
+    assert_turbo_stream_broadcasts(@comment.card) { @comment.reactions.create!(content: "👍") }
+    assert_turbo_stream_broadcasts(@comment.card) { reactions(:kevin).destroy! }
+  end
+
+  test "reactions are removed with the comment" do
+    assert_difference -> { Reaction.count }, -2 do
+      @comment.destroy!
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..5dde272
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,151 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+    @card = @comment.card
+  end
+
+  test "adding a reaction to a comment" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within_reactions do
+      assert_no_selector ".reaction"
+      find(".reactions__trigger").click
+
+      find(".reaction__input").fill_in with: "Nice one!"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "Nice one!"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal [ "Nice one!" ], @comment.reactions.pluck(:content)
+  end
+
+  test "picking an emoji" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[value='🎉']").click
+
+      assert_selector ".reaction", text: "🎉"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "canceling a reaction" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Never mind"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_empty @comment.reactions
+  end
+
+  test "removing your own reaction" do
+    mine = @comment.reactions.create!(content: "👍", reacter: users(:david))
+    theirs = @comment.reactions.create!(content: "🎉", reacter: users(:jz))
+
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within_reactions do
+      find("##{dom_id(theirs)}").click
+      assert_no_selector "##{dom_id(theirs)} .reaction__delete", visible: true
+
+      find("##{dom_id(mine)}").click
+      find("##{dom_id(mine)} .reaction__delete").click
+
+      assert_no_selector "##{dom_id(mine)}"
+      assert_selector "##{dom_id(theirs)}"
+    end
+
+    assert_equal [ theirs ], @comment.reactions.reload.to_a
+  end
+
+  test "reactions from others appear live" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    Current.set(session: sessions(:jz)) do
+      @comment.reactions.create!(content: "Live!")
+    end
+
+    within_reactions do
+      assert_selector ".reaction", text: "Live!", wait: 5
+      find(".reaction", text: "Live!").click
+      assert_no_selector ".reaction__delete", visible: true
+    end
+
+    @comment.reactions.last.destroy!
+
+    within_reactions { assert_no_selector ".reaction", text: "Live!", wait: 5 }
+  end
+
+  test "someone else's reaction doesn't disturb yours in progress" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Typing"
+    end
+
+    Current.set(session: sessions(:jz)) do
+      @comment.reactions.create!(content: "Live!")
+    end
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within_reactions do
+      assert_selector ".reaction", text: "Live!", wait: 5
+      assert_field class: "reaction__input", with: "Typing"
+    end
+  end
+
+  test "your reactions stay removable after a live refresh" do
+    mine = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    sign_in_as(users(:david))
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    Current.set(session: sessions(:jz)) do
+      @comment.reactions.create!(content: "Live!")
+    end
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within_reactions do
+      assert_selector ".reaction", text: "Live!", wait: 5
+      find("##{dom_id(mine)}").click
+      find("##{dom_id(mine)} .reaction__delete").click
+      assert_no_selector "##{dom_id(mine)}"
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions_strip)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
