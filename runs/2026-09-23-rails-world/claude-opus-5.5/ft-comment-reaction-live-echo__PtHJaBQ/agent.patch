--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,39 @@
+class Reaction < ApplicationRecord
+  MAX_LENGTH = 16
+
+  include Broadcastable
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true
+  validate :content_is_short
+
+  after_create :register_card_activity
+
+  delegate :card, to: :reactable
+
+  def emoji_only?
+    content.match?(/\A[\p{Extended_Pictographic}\p{Emoji_Modifier}\p{Regional_Indicator}\u200D\uFE0F\u20E3\s]+\z/)
+  end
+
+  def reacted_by?(user)
+    reacter == user
+  end
+
+  private
+    def content_is_short
+      if content.present? && (content.grapheme_clusters.size > MAX_LENGTH || content.length > 255)
+        errors.add(:content, :too_long, count: MAX_LENGTH)
+      end
+    end
+
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
