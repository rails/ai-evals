diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..50d1c60
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "gets a six-character code that works for fifteen minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_match(/\A[0-9A-HJKMNP-TV-Z]{6}\z/, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "consume uses up the code" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_nil MagicLink.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume forgives case, spacing and lookalike letters" do
+    magic_link = @identity.magic_links.create!(code: "AB01CD")
+
+    assert_equal magic_link, MagicLink.consume(" ab-oi cd ")
+  end
+
+  test "consume ignores expired codes" do
+    magic_link = @identity.magic_links.create!
+
+    travel MagicLink::EXPIRATION_TIME + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "consume ignores codes that can't be codes" do
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume([ "ABC123" ])
+  end
+
+  test "cleanup deletes expired codes" do
+    stale = @identity.magic_links.create!(expires_at: 1.minute.ago)
+    fresh = @identity.magic_links.create!
+
+    MagicLink.cleanup
+
+    assert_not MagicLink.exists?(stale.id)
+    assert MagicLink.exists?(fresh.id)
+  end
+
+  test "identity sends a code by email" do
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      assert_difference -> { @identity.magic_links.count }, 1 do
+        @identity.send_magic_link
+      end
+    end
+  end
+end
