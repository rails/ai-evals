@@ -0,0 +1,30 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width txt-align-center", autofocus: true,
+              autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, maxlength: 10,
+              placeholder: "Enter your code…", aria: { label: "Code" } %>
+      </label>
+    </div>
+
+    <p>We sent a <%= MagicLink::CODE_LENGTH %>-character code to <strong><%= @email_address %></strong>. Enter it here to continue. It works for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="margin-block-start txt-small">
+    Didn’t get it? Check your spam folder, or <%= link_to "try a different email address", new_session_path, class: "txt-link" %>.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
