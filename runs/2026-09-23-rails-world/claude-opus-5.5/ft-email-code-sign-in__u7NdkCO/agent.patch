+          post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newcomer@example.com" }
+        end
+      end
+    end
+
+    assert_redirected_to session_magic_link_url(script_name: nil)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "newcomer@example.com" ], email.to
+    code = email.subject[/[0-9A-Z]{6}\z/]
+    assert code.present?
+
+    untenanted do
+      post session_magic_link_path(script_name: ""), params: { code: code }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert User.find_by!(account: @account, identity: Identity.find_by!(email_address: "newcomer@example.com")).active?
+  end
+
+  test "create for an existing identity that isn't signed in sends a code" do
+    identity = identities(:jz)
+
+    assert_no_difference -> { User.count } do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+    end
+
+    assert_redirected_to session_magic_link_url(script_name: nil)
+
+    untenanted do
+      post session_magic_link_path(script_name: ""), params: { code: identity.magic_links.last.code }
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+  end
+
+  test "create for a different email address than the signed-in identity signs out and sends a code" do
+    sign_in_as :kevin
+
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "someone.else@example.com" }
+
+    assert_redirected_to session_magic_link_url(script_name: nil)
+    assert_not cookies[:session_token].present?
+    assert Identity.find_by!(email_address: "someone.else@example.com").magic_links.exists?
+  end
+
