@@ -0,0 +1,77 @@
+class Sessions::MagicLinksController < ApplicationController
+  include Authentication::ViaMagicLink
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 15.minutes, only: :create, with: :rate_limit_exceeded
+  rate_limit to: 10, within: 15.minutes, only: :create, with: :rate_limit_exceeded,
+    by: -> { email_address_pending_authentication.to_s }, name: "pending_email_address"
+
+  before_action :ensure_authentication_is_pending
+
+  layout "public"
+
+  def show
+    @email_address = email_address_pending_authentication
+  end
+
+  def create
+    if magic_link = consume_magic_link
+      sign_in magic_link
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def ensure_authentication_is_pending
+      unless email_address_pending_authentication
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email address to get a code." }
+          format.json { render json: { message: "Request a code first." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def consume_magic_link
+      if identity = Identity.find_by(email_address: email_address_pending_authentication)
+        identity.magic_links.consume(params[:code])
+      end
+    end
+
+    def sign_in(magic_link)
+      clear_pending_authentication_token
+      start_new_session_for magic_link.identity
+
+      respond_to do |format|
+        format.html { redirect_to after_sign_in_url(magic_link) }
+        format.json { render json: { session_token: session_token, requires_signup_completion: magic_link.for_sign_up? } }
+      end
+    end
+
+    def after_sign_in_url(magic_link)
+      if magic_link.for_sign_up?
+        new_signup_completion_url
+      else
+        after_authentication_url
+      end
+    end
+
+    def invalid_code
+      message = "That code didn’t work. Check it and try again, or request a new one."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
