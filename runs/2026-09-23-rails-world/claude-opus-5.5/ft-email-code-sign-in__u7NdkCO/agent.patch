new file mode 100644
index 0000000..108e10e
--- /dev/null
+++ b/app/controllers/concerns/authentication/via_magic_link.rb
@@ -0,0 +1,42 @@
+# Signing in with a short code sent by email. Asking for a code remembers, in a signed
+# cookie, which email address is waiting to be verified; a code only works for that address.
+module Authentication::ViaMagicLink
+  extend ActiveSupport::Concern
+
+  private
+    def redirect_to_session_magic_link(magic_link, return_to: nil)
+      set_pending_authentication_token magic_link.identity.email_address
+      session[:return_to_after_authenticating] = return_to if return_to
+
+      respond_to do |format|
+        format.html { redirect_to main_app.session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    # Behaves just like a real code was sent, so the response doesn't reveal whether an account exists.
+    def redirect_to_fake_session_magic_link(email_address, **)
+      redirect_to_session_magic_link MagicLink.new(identity: Identity.new(email_address: email_address)), **
+    end
+
+    def set_pending_authentication_token(email_address)
+      cookies.signed[:pending_authentication_token] = {
+        value: email_address,
+        expires: MagicLink::EXPIRATION_TIME,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def email_address_pending_authentication
+      cookies.signed[:pending_authentication_token].presence
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete :pending_authentication_token
+    end
+end
