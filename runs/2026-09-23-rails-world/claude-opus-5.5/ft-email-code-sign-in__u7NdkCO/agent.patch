diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..7007e3b
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "sign in with the emailed code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_enqueued_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      assert_redirected_to session_magic_link_url
+
+      get session_magic_link_path
+      assert_response :success
+      assert_in_body identity.email_address
+
+      post session_magic_link_path, params: { code: identity.magic_links.last.code.downcase }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "sign up with the emailed code" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        post session_path, params: { email_address: "newbie@example.com" }
+      end
+      assert_redirected_to session_magic_link_url
+
+      magic_link = Identity.find_by!(email_address: "newbie@example.com").magic_links.last
+      assert magic_link.for_sign_up?
+
+      post session_magic_link_path, params: { code: magic_link.code }
+      assert_redirected_to new_signup_completion_url
+    end
+  end
+
+  test "a code for another email address doesn't work" do
+    other_code = identities(:david).magic_links.create!.code
+
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      post session_magic_link_path, params: { code: other_code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(code: other_code), "The other code should still be usable"
+    end
+  end
+
+  test "a wrong or expired code doesn't work" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      code = identity.magic_links.last.code
+
+      post session_magic_link_path, params: { code: "ZZZZZZ" }
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+
+      travel MagicLink::EXPIRATION_TIME + 1.second do
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "without a pending email address" do
+    untenanted do
+      get session_magic_link_path
+      assert_redirected_to new_session_path
+
+      post session_magic_link_path, params: { code: "ABC123" }
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "unknown email address when not accepting signups behaves like a known one" do
+    with_multi_tenant_mode(false) do
+      untenanted do
+        assert_no_difference -> { Identity.count } do
+          assert_no_enqueued_emails do
+            post session_path, params: { email_address: "stranger@example.com" }
+          end
+        end
+        assert_redirected_to session_magic_link_url
+
+        post session_magic_link_path, params: { code: "ABC123" }
+        assert_redirected_to session_magic_link_path
+      end
+    end
+  end
+
+  test "sign in via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+      assert_response :created
+      token = response.parsed_body["pending_authentication_token"]
+      assert token.present?
+
+      cookies.delete :pending_authentication_token
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path(format: :json), params: { code: identity.magic_links.last.code }
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+      assert_equal false, response.parsed_body["requires_signup_completion"]
+    end
+  end
+
+  test "wrong code via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: identities(:kevin).email_address }
+      post session_magic_link_path(format: :json), params: { code: "ZZZZZZ" }
+
+      assert_response :unauthorized
+    end
+  end
+end
