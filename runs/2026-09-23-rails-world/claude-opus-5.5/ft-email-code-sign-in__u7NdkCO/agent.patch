diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..662ed93
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,48 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), prefix: :for, default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ...Time.current) }
+
+  before_validation :generate_code, :set_expiration, on: :create
+
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+
+  class << self
+    def consume(code)
+      if code = Code.sanitize(code)
+        active.find_by(code: code)&.consume
+      end
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  # Returns the magic link when this call used it up, or nil if it had already been used.
+  def consume
+    self if self.class.where(id: id).delete_all == 1
+  end
+
+  def expired?
+    expires_at.past?
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..4fedca7
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,21 @@
+# Short, human-friendly codes using Crockford's Base32 alphabet, which leaves out
+# letters that are easily mistaken for digits (I, L, O) and U.
+module MagicLink::Code
+  ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".chars.freeze
+  LOOKALIKES = { "O" => "0", "I" => "1", "L" => "1" }.freeze
+
+  extend self
+
+  def generate(length)
+    Array.new(length) { ALPHABET[SecureRandom.random_number(ALPHABET.size)] }.join
+  end
+
+  # Normalizes what a person typed: case, spacing, dashes, and lookalike letters.
+  # Returns nil when what's left can't be a code.
+  def sanitize(code)
+    if code.is_a?(String)
+      sanitized = code.upcase.gsub(/[^0-9A-Z]/, "").gsub(/[OIL]/, LOOKALIKES)
+      sanitized.presence if sanitized.chars.all? { |char| ALPHABET.include?(char) }
+    end
+  end
+end
