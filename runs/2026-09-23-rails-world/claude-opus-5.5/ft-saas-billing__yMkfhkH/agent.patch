index 0000000..23a17de
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "approved pricing" do
+    assert_equal [ "Free", 0, 1_000, 1.gigabyte ], plan_terms(Plan.free)
+    assert_equal [ "Unlimited", 20, nil, 5.gigabytes ], plan_terms(Plan.find(:monthly_v1))
+    assert_equal [ "Unlimited+", 25, nil, 500.gigabytes ], plan_terms(Plan.find(:monthly_extra_storage_v1))
+  end
+
+  test "only the free plan limits cards" do
+    assert Plan.free.limit_cards?
+    assert Plan.paid.none?(&:limit_cards?)
+  end
+
+  test "find by stripe price id" do
+    assert_equal Plan.find(:monthly_v1), Plan.find_by_stripe_price_id(ENV["STRIPE_MONTHLY_V1_PRICE_ID"])
+    assert_nil Plan.find_by_stripe_price_id("price_unknown")
+    assert_nil Plan.find_by_stripe_price_id(nil)
+  end
+
+  test "upgrades offer more storage" do
+    assert_equal Plan.paid, Plan.free.upgrades
+    assert_equal [ Plan.find(:monthly_extra_storage_v1) ], Plan.find(:monthly_v1).upgrades
+    assert_empty Plan.find(:monthly_extra_storage_v1).upgrades
+  end
+
+  private
+    def plan_terms(plan)
+      [ plan.name, plan.price, plan.card_limit, plan.storage_limit ]
+    end
+end
diff --git a/saas/test/test_helpers/stripe_test_helper.rb b/saas/test/test_helpers/stripe_test_helper.rb
