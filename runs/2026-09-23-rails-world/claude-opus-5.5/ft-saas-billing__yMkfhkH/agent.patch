--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,73 @@
+class Account::Subscription < SaasRecord
+  # Past-due subscriptions keep their plan while Stripe retries the payment.
+  ACTIVE_STATUSES = %w[ active trialing past_due ]
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES) && plan.present?
+  end
+
+  def canceling?
+    active? && cancel_at.present?
+  end
+
+  def sync(stripe_subscription)
+    return if superseded_by?(stripe_subscription)
+
+    item = stripe_subscription.items.data.first
+
+    update! \
+      stripe_subscription_id: stripe_subscription.id,
+      plan_key: Plan.find_by_stripe_price_id(item&.price&.id)&.key,
+      status: stripe_subscription.status,
+      current_period_end: time_from(item&.current_period_end),
+      cancel_at: time_from(stripe_subscription.cancel_at)
+  end
+
+  def plan_change_url(plan, return_url:)
+    item = Stripe::Subscription.retrieve(stripe_subscription_id).items.data.first
+
+    Stripe::BillingPortal::Session.create(
+      customer: stripe_customer_id,
+      return_url: return_url,
+      flow_data: {
+        type: "subscription_update_confirm",
+        subscription_update_confirm: {
+          subscription: stripe_subscription_id,
+          items: [ { id: item.id, price: plan.stripe_price_id, quantity: 1 } ]
+        },
+        after_completion: { type: "redirect", redirect: { return_url: return_url } }
+      }
+    ).url
+  end
+
+  def cancel_at_period_end_later
+    Account::Subscription::RenewalJob.perform_later(self, renew: false) if stripe_subscription_id
+  end
+
+  def renew_later
+    Account::Subscription::RenewalJob.perform_later(self, renew: true) if stripe_subscription_id
+  end
+
+  def update_renewal(renew:)
+    sync Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: !renew)
+  end
+
+  private
+    # Events about an old subscription (its deletion arriving late, say) must not clobber the one in use.
+    def superseded_by?(stripe_subscription)
+      active? && stripe_subscription_id.present? && stripe_subscription.id != stripe_subscription_id &&
+        !stripe_subscription.status.in?(ACTIVE_STATUSES)
+    end
+
+    def time_from(timestamp)
+      Time.at(timestamp) if timestamp
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..aff0375
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,65 @@
+class Plan
+  PLANS = {
+    free_v1: { name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte },
+    monthly_v1: { name: "Unlimited", price: 20, storage_limit: 5.gigabytes, stripe_price_id: ENV["STRIPE_MONTHLY_V1_PRICE_ID"] },
+    monthly_extra_storage_v1: { name: "Unlimited+", price: 25, storage_limit: 500.gigabytes, stripe_price_id: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] }
+  }
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit, :stripe_price_id
+
+  class << self
+    def all
+      @all ||= PLANS.map { |key, properties| new(key: key, **properties) }
+    end
+
+    def free
+      find(:free_v1)
+    end
+
+    def paid
+      all.select(&:paid?)
+    end
+
+    def find(key)
+      all.find { |plan| plan.key == key&.to_sym }
+    end
+
+    def find_by_stripe_price_id(price_id)
+      all.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+    end
+  end
+
+  def initialize(key:, name:, price:, storage_limit:, card_limit: nil, stripe_price_id: nil)
+    @key, @name, @price, @storage_limit = key, name, price, storage_limit
+    @card_limit, @stripe_price_id = card_limit, stripe_price_id
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def limit_cards?
+    card_limit.present?
+  end
+
+  def upgrades
+    Plan.paid.select { |plan| plan.storage_limit > storage_limit }
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && key == other.key
+  end
+  alias eql? ==
+
+  def hash
+    key.hash
+  end
+
+  def to_param
+    key.to_s
+  end
+end
