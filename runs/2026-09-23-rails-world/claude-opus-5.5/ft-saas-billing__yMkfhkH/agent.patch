index 0000000..afdc648
--- /dev/null
+++ b/saas/test/test_helpers/stripe_test_helper.rb
@@ -0,0 +1,32 @@
+module StripeTestHelper
+  def stripe_subscription(id: "sub_123", customer: "cus_123", plan: :monthly_v1, status: "active", cancel_at: nil, current_period_end: 1.month.from_now)
+    Stripe::Subscription.construct_from(stripe_subscription_attributes(id:, customer:, plan:, status:, cancel_at:, current_period_end:))
+  end
+
+  def stripe_subscription_attributes(id:, customer:, plan:, status:, cancel_at: nil, current_period_end: 1.month.from_now)
+    {
+      id: id,
+      object: "subscription",
+      customer: customer,
+      status: status,
+      cancel_at: cancel_at&.to_i,
+      items: {
+        object: "list",
+        data: [ { id: "si_123", object: "subscription_item", current_period_end: current_period_end.to_i, price: { id: Plan.find(plan).stripe_price_id, object: "price" } } ]
+      }
+    }
+  end
+
+  def post_stripe_event(type, object, secret: ENV["STRIPE_WEBHOOK_SECRET"])
+    payload = { id: "evt_123", object: "event", type: type, data: { object: object } }.to_json
+    timestamp = Time.now
+    signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+
+    untenanted do
+      post saas.stripe_webhooks_path, params: payload, headers: {
+        "Content-Type" => "application/json",
+        "Stripe-Signature" => "t=#{timestamp.to_i},v1=#{signature}"
+      }
+    end
+  end
+end
