@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts get 1,000 cards" do
+    @account.update_column(:cards_count, 999)
+    assert_not @account.out_of_cards?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.out_of_cards?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1_001)
+    assert @account.exceeding_card_limit?
+  end
+
+  test "remaining cards and the countdown from 100 out" do
+    @account.update_column(:cards_count, 899)
+    assert_equal 101, @account.remaining_cards_count
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert_equal 50, @account.remaining_cards_count
+    assert @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 1_200)
+    assert_equal 0, @account.remaining_cards_count
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid plans don't limit cards" do
+    @account.update_column(:cards_count, 50_000)
+    @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "monthly_v1", status: "active")
+
+    assert_not @account.out_of_cards?
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_nil @account.remaining_cards_count
+  end
+
+  test "paid plans bring their own storage allowance" do
+    Account.any_instance.stubs(:bytes_used).returns(2.gigabytes)
+    assert @account.exceeding_storage_limit?
+
+    @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "monthly_v1", status: "active")
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_storage_limit?
+
+    @account.subscription.update!(plan_key: "monthly_extra_storage_v1")
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "storage exceptions never shrink a plan's allowance" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "monthly_v1", status: "active")
+    @account.add_storage_exception(2.gigabytes)
+
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+end
diff --git a/saas/test/models/account/limits_overridable_test.rb b/saas/test/models/account/limits_overridable_test.rb
new file mode 100644
index 0000000..3363d47
--- /dev/null
+++ b/saas/test/models/account/limits_overridable_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Account::LimitsOverridableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.update_column(:cards_count, 1_500)
+  end
+
+  test "overriding the card count" do
+    assert @account.exceeding_card_limit?
+
+    @account.override_limits(card_count: 10)
+
+    assert_equal 10, @account.billed_cards_count
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "overriding bytes used" do
+    Account.any_instance.stubs(:bytes_used).returns(2.gigabytes)
+
+    @account.override_limits(bytes_used: 100.megabytes)
+
+    assert_equal 100.megabytes, @account.billed_bytes_used
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "overriding again updates the same record" do
+    @account.override_limits(card_count: 10)
+
+    assert_no_difference -> { Account::OverriddenLimits.count } do
+      @account.override_limits(card_count: 20, bytes_used: 5)
+    end
+
+    assert_equal [ 20, 5 ], [ @account.overridden_limits.card_count, @account.overridden_limits.bytes_used ]
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 10)
+    @account.reset_overridden_limits
+
+    assert_nil @account.overridden_limits
+    assert_equal 1_500, @account.billed_cards_count
+    assert_equal 0, Account::OverriddenLimits.where(account: @account).count
+  end
+
+  test "overriding with nothing resets" do
+    @account.override_limits(card_count: 10)
+    @account.override_limits(card_count: nil, bytes_used: nil)
+
+    assert_nil @account.overridden_limits
+  end
+
+  test "overrides can't be negative" do
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(card_count: -1) }
+  end
+end
