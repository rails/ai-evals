diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..c65d8df
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,45 @@
+#!/usr/bin/env ruby
+#
+# Sets up Stripe for development: reads the Development environment's keys
+# and price IDs from 1Password, and starts `stripe listen` in the background
+# to forward webhooks to the local server.
+#
+# Usage: eval "$(bundle exec stripe-dev)"
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+FORWARD_TO = "http://localhost:#{ENV.fetch("PORT", 3006)}/stripe/webhooks"
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/Development/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+env = %w[ STRIPE_SECRET_KEY STRIPE_MONTHLY_V1_PRICE_ID STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID ].to_h { |name| [ name, op_read(name) ] }
+
+if env.values.any?(&:empty?)
+  warn "Error: Could not fetch Stripe credentials from 1Password"
+  warn "Make sure you're signed in: op signin --account #{OP_ACCOUNT}"
+  exit 1
+end
+
+webhook_secret = `stripe listen --api-key #{env["STRIPE_SECRET_KEY"]} --print-secret 2>/dev/null`.strip
+
+if webhook_secret.empty?
+  warn "Error: Could not get a webhook secret from the Stripe CLI"
+  warn "Make sure it's installed and you've run `stripe login`: https://stripe.com/docs/stripe-cli"
+  exit 1
+end
+
+log = File.expand_path("log/stripe.log", Dir.pwd)
+pid = Process.spawn("stripe", "listen", "--api-key", env["STRIPE_SECRET_KEY"], "--forward-to", FORWARD_TO, out: log, err: log)
+Process.detach(pid)
+
+env.merge("STRIPE_WEBHOOK_SECRET" => webhook_secret).each do |name, value|
+  puts %Q(export #{name}="#{value}")
+end
+
+warn ""
+warn "Stripe configured for development"
+warn "  Forwarding webhooks to #{FORWARD_TO} (pid #{pid}, logging to #{log})"
+warn "  Stop with: kill #{pid}"
