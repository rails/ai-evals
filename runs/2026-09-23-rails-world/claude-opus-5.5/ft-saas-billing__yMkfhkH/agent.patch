+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_plan, only: :create
+
+  layout "public"
+
+  def new
+    @plans = Current.account.plan.upgrades
+  end
+
+  def create
+    redirect_to Current.account.checkout_url(@plan, success_url: saas.account_subscription_url, cancel_url: main_app.account_settings_url),
+      allow_other_host: true
+  end
+
+  # Where Stripe checkout returns to. The plan itself changes when Stripe posts the subscription to the webhook.
+  def show
+    redirect_to main_app.account_settings_path, notice: "Thanks for upgrading!"
+  end
+
+  private
+    def set_plan
+      unless @plan = Current.account.plan.upgrades.find { |plan| plan.key.to_s == params[:plan] }
+        redirect_to saas.new_account_subscription_path, alert: "Pick a plan to upgrade to"
+      end
+    end
+end
