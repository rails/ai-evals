+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_123")
+  end
+
+  test "a new subscription upgrades the account" do
+    post_stripe_event "customer.subscription.created", stripe_subscription_attributes(id: "sub_123", customer: "cus_123", plan: :monthly_v1, status: "active")
+
+    assert_response :ok
+    assert_equal Plan.find(:monthly_v1), @account.reload.plan
+    assert_equal "sub_123", @subscription.reload.stripe_subscription_id
+  end
+
+  test "a plan change moves the account to the new plan" do
+    @subscription.update!(stripe_subscription_id: "sub_123", plan_key: "monthly_v1", status: "active")
+
+    post_stripe_event "customer.subscription.updated", stripe_subscription_attributes(id: "sub_123", customer: "cus_123", plan: :monthly_extra_storage_v1, status: "active")
+
+    assert_response :ok
+    assert_equal Plan.find(:monthly_extra_storage_v1), @account.reload.plan
+  end
+
+  test "a deleted subscription drops the account back to free" do
+    @subscription.update!(stripe_subscription_id: "sub_123", plan_key: "monthly_v1", status: "active")
+
+    post_stripe_event "customer.subscription.deleted", stripe_subscription_attributes(id: "sub_123", customer: "cus_123", plan: :monthly_v1, status: "canceled")
+
+    assert_response :ok
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "events for unknown customers and other event types are acknowledged" do
+    post_stripe_event "customer.subscription.created", stripe_subscription_attributes(id: "sub_999", customer: "cus_unknown", plan: :monthly_v1, status: "active")
+    assert_response :ok
+
+    post_stripe_event "invoice.paid", { id: "in_123", object: "invoice", customer: "cus_123" }
+    assert_response :ok
+    assert_nil @subscription.reload.status
+  end
+
+  test "rejects events with a bad signature" do
+    post_stripe_event "customer.subscription.created", stripe_subscription_attributes(id: "sub_123", customer: "cus_123", plan: :monthly_v1, status: "active"), secret: "whsec_wrong"
+
+    assert_response :bad_request
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "rejects unsigned events" do
+    untenanted do
+      post saas.stripe_webhooks_path, params: "{}", headers: { "Content-Type" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..ef22bc3
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start on the free plan" do
+    assert_equal Plan.free, @account.plan
+    assert_not @account.subscribed?
+  end
+
+  test "an active subscription brings its plan" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "monthly_extra_storage_v1", status: "active")
+
+    assert_equal Plan.find(:monthly_extra_storage_v1), @account.plan
+    assert @account.subscribed?
+  end
+
+  test "past due subscriptions keep their plan while Stripe retries" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "monthly_v1", status: "past_due")
+
+    assert_equal Plan.find(:monthly_v1), @account.plan
+  end
+
+  test "canceled or unpaid subscriptions fall back to free" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "monthly_v1", status: "canceled")
+    assert_equal Plan.free, @account.plan
+
+    subscription.update!(status: "unpaid")
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "comp and uncomp" do
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.find(:monthly_v1), @account.plan
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "comped accounts that also pay for more storage get the bigger plan" do
+    @account.comp
+    @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "monthly_extra_storage_v1", status: "active")
+
+    assert_equal Plan.find(:monthly_extra_storage_v1), @account.plan
+  end
+
+  test "checkout creates a Stripe customer once and starts a subscription checkout" do
+    Stripe::Customer.expects(:create).once.returns(Stripe::Customer.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).twice.with do |params|
+      params[:customer] == "cus_new" && params[:mode] == "subscription" &&
+        params[:line_items] == [ { price: ENV["STRIPE_MONTHLY_V1_PRICE_ID"], quantity: 1 } ]
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/c/pay/cs_1"))
+
+    2.times do
+      assert_equal "https://checkout.stripe.com/c/pay/cs_1", @account.checkout_url(Plan.find(:monthly_v1), success_url: "https://example.com/ok", cancel_url: "https://example.com/no")
+    end
+
+    assert_equal "cus_new", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "subscribed accounts change plans in the customer portal" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "monthly_v1", status: "active")
+
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::Subscription.expects(:retrieve).with("sub_123").returns(stripe_subscription)
+    Stripe::BillingPortal::Session.expects(:create).with do |params|
+      params[:customer] == "cus_123" &&
+        params.dig(:flow_data, :subscription_update_confirm, :items) == [ { id: "si_123", price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"], quantity: 1 } ]
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session/1"))
+
+    assert_equal "https://billing.stripe.com/p/session/1",
+      @account.checkout_url(Plan.find(:monthly_extra_storage_v1), success_url: "https://example.com/ok", cancel_url: "https://example.com/no")
+  end
+
+  test "cancelling the account stops renewal and reactivating resumes it" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "monthly_v1", status: "active")
+
+    with_multi_tenant_mode(true) do
+      Stripe::Subscription.expects(:update).with("sub_123", cancel_at_period_end: true).returns(stripe_subscription(cancel_at: 1.month.from_now))
+      perform_enqueued_jobs(only: Account::Subscription::RenewalJob) { @account.cancel(initiated_by: users(:mike)) }
+      assert subscription.reload.canceling?
+
+      Stripe::Subscription.expects(:update).with("sub_123", cancel_at_period_end: false).returns(stripe_subscription)
+      perform_enqueued_jobs(only: Account::Subscription::RenewalJob) { @account.reactivate }
+      assert_not subscription.reload.canceling?
+    end
+  end
+end
