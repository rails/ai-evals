+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and an upgrade" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select ".settings__section--billing" do
+      assert_select "strong", text: "Free"
+      assert_select "a[href=?]", saas.new_account_subscription_path(script_name: accounts(:initech).slug), text: "Upgrade"
+    end
+  end
+
+  test "subscribers can manage billing" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "monthly_extra_storage_v1", status: "active", current_period_end: 1.week.from_now)
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select ".settings__section--billing" do
+      assert_select "strong", text: "Unlimited+"
+      assert_select "a[href=?]", saas.account_billing_portal_path(script_name: accounts(:initech).slug), text: "Manage billing"
+      assert_select "a", text: "Upgrade", count: 0
+    end
+  end
+
+  test "members don't see billing" do
+    sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings__section--billing", count: 0
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..43173f2
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+  end
+
+  test "new lists the plans to upgrade to" do
+    get saas.new_account_subscription_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "button", text: "Upgrade to Unlimited"
+    assert_select "button", text: "Upgrade to Unlimited+"
+  end
+
+  test "create sends the admin to Stripe checkout" do
+    Stripe::Customer.expects(:create).returns(Stripe::Customer.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:success_url].end_with?("/account/subscription") &&
+        params[:line_items].first[:price] == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/c/pay/cs_1"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_extra_storage_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_1"
+  end
+
+  test "create rejects plans that aren't upgrades" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "free_v1" }
+
+    assert_redirected_to saas.new_account_subscription_path(script_name: @account.slug)
+  end
+
+  test "returning from checkout lands back in settings" do
+    get saas.account_subscription_path(script_name: @account.slug)
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+  end
+
+  test "only admins can upgrade" do
+    logout_and_sign_in_as :david
+
+    get saas.new_account_subscription_path
+    assert_response :forbidden
+
+    post saas.account_subscription_path, params: { plan: "monthly_v1" }
+    assert_response :forbidden
+  end
+end
