diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..127d561
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,73 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  COMPED_PLAN_KEY = :monthly_v1
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, -> { subscription&.cancel_at_period_end_later }
+    set_callback :reactivate, :after, -> { subscription&.renew_later }
+  end
+
+  def plan
+    [ active_subscription&.plan, comped_plan ].compact.max_by(&:storage_limit) || Plan.free
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    reload_billing_waiver
+  end
+
+  # Free accounts check out a new subscription; subscribed ones confirm the plan change in the customer portal.
+  def checkout_url(plan, success_url:, cancel_url:)
+    if active_subscription&.stripe_subscription_id
+      active_subscription.plan_change_url(plan, return_url: cancel_url)
+    else
+      Stripe::Checkout::Session.create(
+        mode: "subscription",
+        customer: stripe_customer_id,
+        client_reference_id: id,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        subscription_data: { metadata: { account_id: id } },
+        success_url: success_url,
+        cancel_url: cancel_url
+      ).url
+    end
+  end
+
+  def billing_portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(customer: subscription.stripe_customer_id, return_url: return_url).url
+  end
+
+  private
+    def comped_plan
+      Plan.find(COMPED_PLAN_KEY) if comped?
+    end
+
+    def stripe_customer_id
+      subscription&.stripe_customer_id || create_stripe_customer.stripe_customer_id
+    end
+
+    def create_stripe_customer
+      customer = Stripe::Customer.create(name: name, email: owner_email, metadata: { account_id: id, queenbee_id: external_account_id })
+      create_subscription!(stripe_customer_id: customer.id)
+    end
+end
