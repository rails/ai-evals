+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @subscription = accounts(:initech).create_subscription!(stripe_customer_id: "cus_123")
+  end
+
+  test "sync from a Stripe subscription" do
+    period_end = 1.month.from_now.change(usec: 0)
+    @subscription.sync stripe_subscription(plan: :monthly_extra_storage_v1, current_period_end: period_end)
+
+    assert_equal "sub_123", @subscription.stripe_subscription_id
+    assert_equal Plan.find(:monthly_extra_storage_v1), @subscription.plan
+    assert_equal "active", @subscription.status
+    assert_equal period_end, @subscription.current_period_end
+    assert @subscription.active?
+    assert_not @subscription.canceling?
+  end
+
+  test "sync a pending cancellation" do
+    @subscription.sync stripe_subscription(cancel_at: 1.week.from_now)
+
+    assert @subscription.canceling?
+  end
+
+  test "unknown prices don't grant a plan" do
+    attributes = stripe_subscription_attributes(id: "sub_123", customer: "cus_123", plan: :monthly_v1, status: "active")
+    attributes[:items][:data].first[:price][:id] = "price_unknown"
+    @subscription.sync Stripe::Subscription.construct_from(attributes)
+
+    assert_not @subscription.active?
+  end
+
+  test "late events for a replaced subscription are ignored" do
+    @subscription.sync stripe_subscription(id: "sub_new")
+    @subscription.sync stripe_subscription(id: "sub_old", status: "canceled")
+
+    assert_equal "sub_new", @subscription.stripe_subscription_id
+    assert @subscription.active?
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
