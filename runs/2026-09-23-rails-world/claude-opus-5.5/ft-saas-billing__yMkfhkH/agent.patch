new file mode 100644
index 0000000..a90f722
--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,27 @@
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def remaining_cards_count
+    [ card_limit - billed_cards_count, 0 ].max if plan.limit_cards?
+  end
+
+  # No room left to create another card.
+  def out_of_cards?
+    plan.limit_cards? && billed_cards_count >= card_limit
+  end
+
+  # Holding more cards than the plan allows, so drafts can't be published.
+  def exceeding_card_limit?
+    plan.limit_cards? && billed_cards_count > card_limit
+  end
+
+  def nearing_card_limit?
+    plan.limit_cards? && !exceeding_card_limit? && remaining_cards_count <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+end
