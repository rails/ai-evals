@@ -0,0 +1,34 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json { set_page_and_extract_portion_from activities }
+    end
+  end
+
+  private
+    def activities
+      events = Event.activities.where(board: boards).preloaded.reverse_chronologically
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events
+    end
+
+    def boards
+      if board_ids.any?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def creator_ids
+      list_param(:creator_ids)
+    end
+
+    def board_ids
+      list_param(:board_ids)
+    end
+
+    def list_param(name)
+      Array(params[name]).flatten.map(&:to_s).compact_blank
+    end
+end
