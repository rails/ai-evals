@@ -0,0 +1,70 @@
+# Activities
+
+Activities are the events that happened in the account, such as cards being added, moved, assigned, or commented on. They mirror the activity timeline shown in the web app.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity events on the boards the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Only return events created by these users |
+| `board_ids[]` | Only return events on these boards |
+
+__Actions:__
+
+`card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, and `comment_created`.
+
+__Particulars:__
+
+The `particulars` object contains event-specific details. Missing board, title, or column values are returned as empty strings.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| Other actions | `{}` |
+
+`description` is the plain-text description of the event, with HTML special characters escaped (as in webhook payloads).
+
+For card events, `url` opens the card. For comment events, it opens the card and jumps to the comment.
+
+`eventable` is a [card](cards.md) or a [comment](comments.md) depending on `eventable_type`. `board` is a [board](boards.md) and `creator` is a [user](users.md).
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_triaged",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David moved &quot;Plain text mentions&quot; to &quot;In progress&quot;",
+    "particulars": {
+      "column": "In progress"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 3,
+      "title": "Plain text mentions",
+      "...": "..."
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "...": "..."
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "...": "..."
+    }
+  }
+]
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..d8723d1
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of events, newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_kind_of Array, body
+    assert body.any?
+
+    times = body.map { Time.zone.parse(it["created_at"]) }
+    assert_equal times.sort.reverse, times
+  end
+
+  test "index as JSON includes event attributes" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, event.keys.sort
+    assert_equal "card_published", event["action"]
+    assert_equal "Card", event["eventable_type"]
+    assert_equal({}, event["particulars"])
+    assert_equal events(:logo_published).description_for(users(:kevin)).to_plain_text, event["description"]
+    assert_equal card_url(cards(:logo)), event["url"]
+    assert_equal cards(:logo).id, event.dig("eventable", "id")
+    assert_equal boards(:writebook).id, event.dig("board", "id")
+    assert_equal users(:david).id, event.dig("creator", "id")
+  end
+
+  test "comment events link to the comment on the card" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { it["id"] == events(:layout_commented).id }
+    comment = events(:layout_commented).eventable
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+  end
+
+  test "particulars" do
+    events(:logo_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old" } })
+    events(:layout_published).update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "A", "new_board" => "B" } })
+    events(:text_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+    body = @response.parsed_body.index_by { it["id"] }
+
+    assert_equal({ "old_title" => "Old", "new_title" => "" }, body[events(:logo_published).id]["particulars"])
+    assert_equal({ "old_board" => "A", "new_board" => "B" }, body[events(:layout_published).id]["particulars"])
+    assert_equal({ "column" => "" }, body[events(:text_published).id]["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, body[events(:logo_assignment_jz).id]["particulars"])
+  end
+
+  test "omits deprecated collection changed events" do
+    events(:logo_published).update_columns(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_not @response.parsed_body.any? { it["id"] == events(:logo_published).id }
+  end
+
+  test "filters by creator and board" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+    assert @response.parsed_body.all? { it.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+    assert @response.parsed_body.all? { it.dig("board", "id") == boards(:private).id }
+  end
+
+  test "only returns events from accessible boards" do
+    sign_in_as :jz
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+end
