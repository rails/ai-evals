+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,25 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    details = event.particulars&.dig("particulars") || {}
+
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(event.assignee_ids) }
+    when "card_board_changed"
+      { old_board: details["old_board"].to_s, new_board: details["new_board"].to_s }
+    when "card_title_changed"
+      { old_title: details["old_title"].to_s, new_title: details["new_title"].to_s }
+    when "card_triaged"
+      { column: details["column"].to_s }
+    else
+      {}
+    end
+  end
+
+  def activity_target_url(event)
+    case event.eventable
+    when Comment then card_url(event.eventable.card, anchor: dom_id(event.eventable))
+    else card_url(event.card)
+    end
+  end
+end
