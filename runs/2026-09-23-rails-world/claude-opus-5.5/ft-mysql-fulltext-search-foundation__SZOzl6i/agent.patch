diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..fb509be
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,26 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Coarse, SQL-level match on raw title, description and comment HTML. Every term
+    # must appear somewhere in the card. Use Search for precise, plain-text matching.
+    scope :mentioning, ->(terms) do
+      Array(terms).inject(all) do |cards, term|
+        cards.where(<<~SQL.squish, term: "%#{sanitize_sql_like(term, "!")}%")
+          cards.title LIKE :term ESCAPE '!'
+          OR EXISTS (
+            SELECT 1 FROM action_text_rich_texts descriptions
+            WHERE descriptions.record_type = 'Card' AND descriptions.name = 'description'
+              AND descriptions.record_id = cards.id AND descriptions.body LIKE :term ESCAPE '!'
+          )
+          OR EXISTS (
+            SELECT 1 FROM comments
+            INNER JOIN action_text_rich_texts bodies
+              ON bodies.record_type = 'Comment' AND bodies.name = 'body' AND bodies.record_id = comments.id
+            WHERE comments.card_id = cards.id AND bodies.body LIKE :term ESCAPE '!'
+          )
+        SQL
+      end
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..7c3a156
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,70 @@
+class Search
+  MAX_TERMS = 10
+
+  attr_reader :user, :query, :terms
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish
+    @terms = @query.split.uniq(&:downcase).first(MAX_TERMS)
+  end
+
+  def present?
+    terms.any?
+  end
+
+  def cards
+    if present?
+      searchable_cards.where(id: matching_card_ids).reverse_chronologically
+        .with_rich_text_description.preload(:board, comments: :rich_text_body)
+    else
+      Card.none
+    end
+  end
+
+  def matches?(text)
+    present? && text.to_s.match?(pattern)
+  end
+
+  def pattern
+    @pattern ||= Regexp.new(terms.sort_by(&:length).reverse.map { Regexp.escape(it) }.join("|"), Regexp::IGNORECASE)
+  end
+
+  private
+    def searchable_cards
+      user.accessible_cards.published
+    end
+
+    # The SQL match runs against stored HTML, so re-check candidates against their
+    # plain text to avoid matching markup such as tag or attribute names.
+    def matching_card_ids
+      candidates = searchable_cards.mentioning(terms)
+      texts = texts_by_card_id(candidates)
+
+      texts.select { |_id, text| terms.all? { text.include?(it.downcase) } }.keys
+    end
+
+    def texts_by_card_id(candidates)
+      Hash.new { |hash, key| hash[key] = +"" }.tap do |texts|
+        candidates.pluck(:id, :title).each { |id, title| texts[id] << title.to_s.downcase << "\n" }
+
+        rich_texts_for(candidates).each do |card_id, body|
+          texts[card_id] << body.to_plain_text.downcase << "\n" if texts.key?(card_id)
+        end
+      end
+    end
+
+    def rich_texts_for(candidates)
+      ids = candidates.select(:id)
+
+      descriptions = ActionText::RichText.where(record_type: "Card", name: "description", record_id: ids)
+        .pluck(:record_id, :body)
+
+      comments = ActionText::RichText.where(record_type: "Comment", name: "body")
+        .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+        .where(comments: { card_id: ids })
+        .pluck("comments.card_id", :body)
+
+      descriptions + comments
+    end
+end
