+module SearchesHelper
+  EXCERPT_RADIUS = 100
+
+  def search_highlight(text, search)
+    parts = text.to_s.split(/(#{search.pattern.source})/i)
+    safe_join parts.each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part }
+  end
+
+  def search_excerpt(text, search)
+    search_highlight excerpt(text.to_s.squish, search.pattern, radius: EXCERPT_RADIUS), search
+  end
+end
