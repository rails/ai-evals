diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..6e2b36d
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+    assert_select "#search_results", count: 0
+  end
+
+  test "finds cards by title and highlights matches" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "#search_results mark", text: /logo/i
+    assert_select "##{dom_id(cards(:logo), :search_result)}"
+  end
+
+  test "finds cards by description" do
+    cards(:text).update!(description: "Needs a bigger typeface everywhere")
+
+    get search_path(q: "typeface")
+
+    assert_select "##{dom_id(cards(:text), :search_result)}"
+    assert_select ".search-result__description mark", text: "typeface"
+  end
+
+  test "finds cards by comment body" do
+    cards(:layout).comments.create!(body: "The sidebar overlaps the gutter", creator: users(:kevin))
+
+    get search_path(q: "gutter")
+
+    assert_select "##{dom_id(cards(:layout), :search_result)}"
+    assert_select ".search-result__comment mark", text: "gutter"
+  end
+
+  test "orders results newest first" do
+    cards(:logo).update!(description: "zebra", created_at: 2.days.ago)
+    cards(:layout).update!(description: "zebra", created_at: 1.day.ago)
+
+    get search_path(q: "zebra")
+
+    ids = css_select(".search-result").map { it["id"] }
+    assert_equal [ dom_id(cards(:layout), :search_result), dom_id(cards(:logo), :search_result) ], ids
+  end
+
+  test "excludes cards from boards without access" do
+    boards(:writebook).accesses.find_by(user: users(:kevin)).destroy
+    cards(:logo).update_column(:title, "Kaleidoscope")
+
+    get search_path(q: "kaleidoscope")
+
+    assert_select ".search-result", count: 0
+  end
+
+  test "excludes drafts and their comments" do
+    cards(:logo).update_column(:title, "Kaleidoscope")
+    cards(:logo).comments.create!(body: "Marmalade", creator: users(:kevin))
+    cards(:logo).update_column(:status, "drafted")
+
+    get search_path(q: "kaleidoscope")
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "marmalade")
+    assert_select ".search-result", count: 0
+  end
+
+  test "escapes content and does not match markup" do
+    cards(:text).update!(description: "<strong>bold</strong> <script>alert(1)</script>")
+
+    get search_path(q: "strong")
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "bold")
+    assert_select ".search-result__description mark", text: "bold"
+    assert_no_match "<script>alert", response.body
+  end
+
+  test "treats like wildcards literally" do
+    get search_path(q: "%")
+    assert_select ".search-result", count: 0
+  end
+end
