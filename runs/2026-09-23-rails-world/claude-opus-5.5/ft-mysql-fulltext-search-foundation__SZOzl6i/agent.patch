diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..5e1f9c9
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,23 @@
+<li class="search-result pad" id="<%= dom_id(card, :search_result) %>" style="border-block-end: 1px solid var(--color-ink-lighter)">
+  <div class="flex align-center gap-half txt-small txt-subtle">
+    <span><%= card.board.name %></span>
+    <span>#<%= card.number %></span>
+    <%= local_datetime_tag card.created_at, style: :ago %>
+  </div>
+
+  <h2 class="txt-medium margin-none">
+    <%= link_to search_highlight(card.title, search), card_path(card) %>
+  </h2>
+
+  <% if search.matches?(description = card.description.to_plain_text) %>
+    <p class="search-result__description margin-none"><%= search_excerpt description, search %></p>
+  <% end %>
+
+  <% card.comments.sort_by(&:created_at).each do |comment| %>
+    <% if search.matches?(body = comment.body.to_plain_text) %>
+      <p class="search-result__comment margin-none txt-small">
+        <%= link_to search_excerpt(body, search), card_path(card, anchor: dom_id(comment)) %>
+      </p>
+    <% end %>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..7a01dcb
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,30 @@
+<% @page_title = @search.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="searches panel panel--wide center borderless flex flex-column gap margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", autofocus: true, class: "input full-width", aria: { label: "Search" } %>
+    <%= form.button "Search", type: :submit, name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @search.present? %>
+    <% if @page.records.any? %>
+      <ol class="search-results flex flex-column gap unpad margin-none" style="list-style: none" id="search_results">
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+      </ol>
+
+      <% unless @page.last? %>
+        <%= link_to "More results", search_path(q: @search.query, page: @page.next_param), class: "btn center" %>
+      <% end %>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% end %>
+</section>
