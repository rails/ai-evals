diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..1ee2d28 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,25 @@
 module TimeHelper
+  # Renders an empty <time> element carrying the raw timestamp. The `local-time` Stimulus controller
+  # formats it in the viewer's own timezone, so the HTML is the same for everyone and safe to cache.
+  #
+  # Styles (see app/javascript/controllers/local_time_controller.js):
+  #
+  #   :time      1:42 PM
+  #   :shortdate Sep 12
+  #   :date      Sep 12, 2025
+  #   :longdate  Friday, September 12
+  #   :datetime  9/12/25, 1:42 PM
+  #   :ago       just now, 5 minutes ago, 3 hours ago, yesterday, 5 days ago...
+  #   :indays    today, tomorrow, in 3 days
+  #   :relative  1:42 PM (today), yesterday, 5 days ago (this week), Sep 12, Sep 12, 2024
+  LOCAL_DATETIME_STYLES = %i[ time shortdate date longdate datetime ago indays relative ]
+
+  def local_datetime_tag(datetime, style: :time, **attributes)
+    raise ArgumentError, "Unknown local datetime style: #{style.inspect}" unless style.to_sym.in?(LOCAL_DATETIME_STYLES)
+
+    tag.time "", **attributes.except(:class, :data),
+      class: token_list("local-time-value", attributes[:class]),
+      datetime: datetime.utc.iso8601,
+      data: { local_time_target: style, action: "turbo:morph-element->local-time#refreshTarget", **attributes.fetch(:data, {}) }
+  end
 end
