diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..c0ccf97
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,117 @@
+import { Controller } from "@hotwired/stimulus"
+import { calendarDaysBetween } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+const MINUTE = 60_000
+const HOUR = 60 * MINUTE
+const DAY = 24 * HOUR
+
+// Formats <time datetime="..."> elements (see TimeHelper#local_datetime_tag) in the viewer's
+// own timezone. The server only sends raw timestamps, so its HTML can be cached and shared.
+export default class extends Controller {
+  static targets = [ "time", "shortdate", "date", "longdate", "datetime", "ago", "indays", "relative" ]
+
+  #timer
+
+  initialize() {
+    const locale = document.documentElement.lang || "en"
+
+    this.formatters = {
+      time: new Intl.DateTimeFormat(locale, { hour: "numeric", minute: "2-digit" }),
+      shortdate: new Intl.DateTimeFormat(locale, { month: "short", day: "numeric" }),
+      date: new Intl.DateTimeFormat(locale, { month: "short", day: "numeric", year: "numeric" }),
+      longdate: new Intl.DateTimeFormat(locale, { weekday: "long", month: "long", day: "numeric" }),
+      datetime: new Intl.DateTimeFormat(locale, { dateStyle: "short", timeStyle: "short" }),
+      full: new Intl.DateTimeFormat(locale, { dateStyle: "full", timeStyle: "short" }),
+      relative: new Intl.RelativeTimeFormat(locale, { numeric: "auto" })
+    }
+  }
+
+  connect() {
+    this.#timer = setInterval(() => this.refreshAll(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  refreshAll() {
+    this.constructor.targets.forEach(style => {
+      this[`${style}Targets`].forEach(target => this.#render(target, style))
+    })
+  }
+
+  refreshTarget({ target }) {
+    const style = target.getAttribute(`data-${this.identifier}-target`)
+    if (this.constructor.targets.includes(style)) this.#render(target, style)
+  }
+
+  timeTargetConnected(target) { this.#render(target, "time") }
+  shortdateTargetConnected(target) { this.#render(target, "shortdate") }
+  dateTargetConnected(target) { this.#render(target, "date") }
+  longdateTargetConnected(target) { this.#render(target, "longdate") }
+  datetimeTargetConnected(target) { this.#render(target, "datetime") }
+  agoTargetConnected(target) { this.#render(target, "ago") }
+  indaysTargetConnected(target) { this.#render(target, "indays") }
+  relativeTargetConnected(target) { this.#render(target, "relative") }
+
+  #render(target, style) {
+    const date = new Date(target.getAttribute("datetime"))
+    if (isNaN(date)) return
+
+    const text = this.#format(date, style)
+    const title = this.formatters.full.format(date)
+
+    if (target.textContent !== text) target.textContent = text
+    if (target.title !== title) target.title = title
+  }
+
+  #format(date, style) {
+    switch (style) {
+      case "ago":      return this.#ago(date)
+      case "indays":   return this.#inDays(date)
+      case "relative": return this.#relative(date)
+      default:         return this.formatters[style].format(date)
+    }
+  }
+
+  // "just now", "5 minutes ago", "3 hours ago", "yesterday", "5 days ago", "2 months ago", "last year"
+  #ago(date, now = new Date()) {
+    const elapsed = Math.max(now - date, 0)
+    const days = calendarDaysBetween(date, now)
+
+    if (elapsed < MINUTE) {
+      return "just now"
+    } else if (elapsed < HOUR) {
+      return this.formatters.relative.format(-Math.floor(elapsed / MINUTE), "minute")
+    } else if (elapsed < DAY) {
+      return this.formatters.relative.format(-Math.floor(elapsed / HOUR), "hour")
+    } else if (days < 30) {
+      return this.formatters.relative.format(-days, "day")
+    } else if (days < 365) {
+      return this.formatters.relative.format(-Math.floor(days / 30), "month")
+    } else {
+      return this.formatters.relative.format(-Math.floor(days / 365), "year")
+    }
+  }
+
+  // "today", "tomorrow", "in 3 days"
+  #inDays(date, now = new Date()) {
+    return this.formatters.relative.format(Math.max(calendarDaysBetween(now, date), 0), "day")
+  }
+
+  // "1:42 PM" (today), "yesterday", "5 days ago" (this past week), "Sep 12", "Sep 12, 2024"
+  #relative(date, now = new Date()) {
+    const days = calendarDaysBetween(date, now)
+
+    if (days === 0) {
+      return this.formatters.time.format(date)
+    } else if (days > 0 && days < 7) {
+      return this.formatters.relative.format(-days, "day")
+    } else if (date.getFullYear() === now.getFullYear()) {
+      return this.formatters.shortdate.format(date)
+    } else {
+      return this.formatters.date.format(date)
+    }
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..5dbfe6c 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,12 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+// Number of calendar days from one date to another in the browser's own timezone
+// (e.g. 11pm yesterday to 1am today is 1 day). Negative when `toDate` is earlier.
+export function calendarDaysBetween(fromDate, toDate) {
+  const from = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const to = new Date(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+
+  return Math.round((to - from) / (1000 * 60 * 60 * 24))
+}
