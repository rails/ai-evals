diff --git a/test/controllers/cards/local_times_test.rb b/test/controllers/cards/local_times_test.rb
new file mode 100644
index 0000000..d2ad9f4
--- /dev/null
+++ b/test/controllers/cards/local_times_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Cards::LocalTimesTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "comment times are rendered in the browser, not baked into the cached html" do
+    comment = comments(:logo_agreement_jz)
+
+    bodies = %w[ America/Los_Angeles Asia/Tokyo ].map do |zone|
+      cookies[:timezone] = zone
+      get card_path(cards(:logo))
+      assert_response :success
+
+      assert_select "##{dom_id(comment)} time[data-local-time-target=relative][datetime=?]", comment.created_at.utc.iso8601
+      css_select("##{dom_id(comment)}").to_html
+    end
+
+    assert_equal 1, bodies.uniq.size
+  end
+
+  test "card meta and closure notice use local times" do
+    get card_path(cards(:logo))
+
+    assert_select ".card__meta time[data-local-time-target=ago]", minimum: 2
+    assert_select "body[data-controller~=local-time]"
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..e5049c1
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag renders the raw UTC timestamp for the browser to format" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    render html: local_datetime_tag(time.in_time_zone("Tokyo"), style: :relative)
+
+    assert_select "time.local-time-value[datetime=?][data-local-time-target=relative]", "2025-09-12T13:42:00Z", text: ""
+    assert_select "time[data-action=?]", "turbo:morph-element->local-time#refreshTarget"
+  end
+
+  test "local_datetime_tag renders the same html in every server timezone" do
+    time = Time.utc(2025, 9, 12, 23, 30)
+
+    html = %w[ UTC America/Los_Angeles Asia/Tokyo ].map do |zone|
+      Time.use_zone(zone) { local_datetime_tag(time.in_time_zone, style: :ago) }
+    end
+
+    assert_equal 1, html.uniq.size
+  end
+
+  test "local_datetime_tag merges attributes" do
+    render html: local_datetime_tag(Time.utc(2025, 9, 12), style: :date, class: "txt-small", data: { foo: "bar" })
+
+    assert_select "time.local-time-value.txt-small[data-foo=bar][data-local-time-target=date]"
+  end
+
+  test "local_datetime_tag rejects unknown styles" do
+    assert_raises(ArgumentError) { local_datetime_tag(Time.current, style: :bogus) }
+  end
+end
