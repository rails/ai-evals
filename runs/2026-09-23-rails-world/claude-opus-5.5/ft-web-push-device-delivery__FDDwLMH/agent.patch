new file mode 100644
index 0000000..b62c134
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,41 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+
+    if @push_subscription.update(push_subscription_params.merge(user_agent: request.user_agent))
+      claim_endpoint
+
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path }
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: "Couldn’t turn on notifications for this device" }
+        format.json { render json: @push_subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    # A browser has a single push endpoint. Once somebody else signs in on it and turns
+    # on notifications, it stops receiving pushes meant for whoever used it before.
+    def claim_endpoint
+      Push::Subscription.where(endpoint: @push_subscription.endpoint).where.not(user: Current.identity.users).delete_all
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..a74bb0d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,97 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns on push notifications for the device you're using.
+export default class extends Controller {
+  static targets = [ "button", "explainer", "installer" ]
+  static classes = [ "on" ]
+  static values = { subscriptionsUrl: String, publicKey: String, endpoints: Array }
+
+  connect() {
+    this.#refresh()
+  }
+
+  async turnOn() {
+    if (!this.#supported) return
+
+    this.buttonTarget.disabled = true
+
+    try {
+      if (await Notification.requestPermission() === "granted") {
+        const subscription = await this.#subscribe()
+
+        if (await this.#save(subscription)) {
+          this.endpointsValue = [ ...this.endpointsValue, subscription.endpoint ]
+        }
+      }
+    } catch (error) {
+      console.error("Couldn't turn on push notifications", error)
+    } finally {
+      this.buttonTarget.disabled = false
+      this.#refresh()
+    }
+  }
+
+  async #refresh() {
+    const supported = this.#supported
+    const blocked = supported && Notification.permission === "denied"
+    const on = supported && Notification.permission === "granted" && await this.#subscribedHere()
+
+    this.element.classList.toggle(this.onClass, on)
+    this.buttonTarget.hidden = !supported || blocked
+    this.explainerTarget.hidden = !blocked
+    this.installerTarget.hidden = supported
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async #subscribedHere() {
+    const registration = await navigator.serviceWorker.getRegistration("/")
+    const subscription = await registration?.pushManager.getSubscription()
+
+    return !!subscription && this.endpointsValue.includes(subscription.endpoint)
+  }
+
+  async #subscribe() {
+    const registration = await this.#registration()
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && this.#subscribedWithCurrentKey(subscription)) {
+      return subscription
+    } else {
+      await subscription?.unsubscribe()
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  async #registration() {
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    return navigator.serviceWorker.ready
+  }
+
+  #subscribedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+
+    return !key || new Uint8Array(key).toString() === this.#applicationServerKey.toString()
+  }
+
+  async #save(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } },
+      responseKind: "json"
+    })
+
+    return response.ok
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+
+    return Uint8Array.from(atob(padded), (character) => character.charCodeAt(0))
+  }
+}
