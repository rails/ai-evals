index 0000000..c041369
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  ENDPOINT = "https://fcm.googleapis.com/fcm/send/new-device-token"
+
+  setup do
+    sign_in_as :kevin
+    @kevin = users(:kevin)
+  end
+
+  test "create subscribes this device" do
+    assert_difference -> { @kevin.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@kevin), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+    subscription = @kevin.push_subscriptions.find_by!(endpoint: ENDPOINT)
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "create from a form redirects back to notification settings" do
+    post user_push_subscriptions_path(@kevin), params: subscription_params
+
+    assert_redirected_to notifications_settings_path
+  end
+
+  test "create again for the same device updates its keys" do
+    existing = push_subscriptions(:kevin_chrome)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@kevin), params: subscription_params(endpoint: existing.endpoint, p256dh_key: "new-p256dh", auth_key: "new-auth"), as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", existing.reload.p256dh_key
+    assert_equal "new-auth", existing.auth_key
+  end
+
+  test "create hands the device over from whoever used it before" do
+    shared = push_subscriptions(:kevin_chrome)
+    logout_and_sign_in_as :david
+
+    post user_push_subscriptions_path(users(:david)), params: subscription_params(endpoint: shared.endpoint), as: :json
+
+    assert_response :created
+    assert_not Push::Subscription.exists?(shared.id)
+    assert users(:david).push_subscriptions.exists?(endpoint: shared.endpoint)
+  end
+
+  test "create rejects endpoints that aren't push services" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@kevin), params: subscription_params(endpoint: "https://169.254.169.254/latest/meta-data"), as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires the subscription keys" do
+    post user_push_subscriptions_path(@kevin), params: { push_subscription: { endpoint: ENDPOINT } }, as: :json
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create can't subscribe somebody else" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: subscription_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "settings let you turn on push notifications when VAPID keys are configured" do
+    with_push_enabled { get notifications_settings_path }
+
+    assert_response :success
+    assert_select "[data-controller=notifications][data-notifications-subscriptions-url-value=?]", user_push_subscriptions_path(@kevin)
+    assert_select "[data-notifications-public-key-value=?]", PushTestHelper::VAPID_KEY.public_key
+    assert_select "button[data-action='notifications#turnOn']"
+  end
+
+  test "settings leave push notifications out without VAPID keys" do
+    with_push_disabled { get notifications_settings_path }
+
+    assert_response :success
+    assert_select "[data-controller=notifications]", count: 0
+  end
+
+  private
+    def subscription_params(endpoint: ENDPOINT, p256dh_key: "p256dh", auth_key: "auth")
+      { push_subscription: { endpoint: endpoint, p256dh_key: p256dh_key, auth_key: auth_key } }
+    end
+end
