diff --git a/app/jobs/storage/materialize_job.rb b/app/jobs/storage/materialize_job.rb
new file mode 100644
index 0000000..e699910
--- /dev/null
+++ b/app/jobs/storage/materialize_job.rb
@@ -0,0 +1,11 @@
+class Storage::MaterializeJob < ApplicationJob
+  # One job per owner at a time. Jobs arriving while another runs wait their turn and
+  # then usually find nothing left to fold in, since each run consumes all pending entries.
+  limits_concurrency to: 1, key: ->(owner) { owner }, duration: 5.minutes, group: "Storage"
+
+  discard_on ActiveJob::DeserializationError, ActiveRecord::RecordNotFound
+
+  def perform(owner)
+    owner.materialize_storage_now
+  end
+end
