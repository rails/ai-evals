diff --git a/lib/rails_ext/active_storage_attachment_storage_tracking.rb b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
new file mode 100644
index 0000000..3bace7d
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
@@ -0,0 +1,38 @@
+# Record storage usage changes for attachments that count towards account and board usage
+# (see Storage::Tracked). Entries are written in the same transaction as the attachment itself.
+#
+# Removals are tracked when the row is actually deleted, which covers both +destroy+ and +delete+
+# (used by +purge+ and +purge_later+), and only counts rows that were really deleted, so
+# concurrent purges of the same attachment don't subtract its size twice.
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create { track_storage(+1) }
+  end
+
+  private
+    def _delete_row
+      super.tap do |affected_rows|
+        track_storage(-1) if affected_rows.to_i > 0
+      end
+    end
+
+    def track_storage(sign)
+      if trackable = storage_trackable
+        trackable.track_storage sign * blob&.byte_size.to_i
+      end
+    end
+
+    def storage_trackable
+      trackable = record.is_a?(ActionText::RichText) ? record.record : record
+
+      if trackable.is_a?(Storage::Tracked) && trackable.storage_tracked_attachment?(self)
+        trackable
+      end
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorageAttachmentStorageTracking
+end
diff --git a/script/migrations/20260720-backfill-storage-totals.rb b/script/migrations/20260720-backfill-storage-totals.rb
new file mode 100755
index 0000000..84bc5c1
--- /dev/null
+++ b/script/migrations/20260720-backfill-storage-totals.rb
@@ -0,0 +1,14 @@
+#!/usr/bin/env ruby
+
+# Calculates the initial storage totals for existing accounts and boards. Totals are otherwise
+# created lazily, the first time a tracked attachment changes. Safe to re-run: reconciling
+# recalculates the totals from scratch.
+
+require_relative "../../config/environment"
+
+Account.find_each do |account|
+  account.reconcile_storage_later
+  account.boards.find_each(&:reconcile_storage_later)
+end
+
+puts "Enqueued storage reconciliation for all accounts and boards"
