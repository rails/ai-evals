+require "test_helper"
+
+class Storage::TrackingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "card images count towards board and account" do
+    blob = create_blob
+
+    @card.update!(image: blob)
+    materialize
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+    assert_equal 0, @other_board.bytes_used
+  end
+
+  test "files embedded in card descriptions, comments and board descriptions count" do
+    card_blob, comment_blob, board_blob = create_blob, create_blob("avatar.png"), create_blob("avatar.svg")
+
+    @card.update!(description: embed(card_blob))
+    @card.comments.create!(body: embed(comment_blob))
+    @board.update!(public_description: embed(board_blob))
+    materialize
+
+    expected = card_blob.byte_size + comment_blob.byte_size + board_blob.byte_size
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+    assert_equal expected, @board.calculate_bytes_used
+    assert_equal expected, @account.calculate_bytes_used
+  end
+
+  test "bytes are released when attachments are removed" do
+    @card.update!(image: create_blob, description: embed(create_blob("avatar.png")))
+    comment = @card.comments.create!(body: embed(create_blob("avatar.svg")))
+    materialize
+    assert @board.bytes_used > 0
+
+    @card.image.purge_later
+    materialize
+    assert_equal @board.calculate_bytes_used, @board.bytes_used
+
+    @card.update!(description: "No more files")
+    comment.destroy!
+    materialize
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "replacing a card image" do
+    @card.update!(image: create_blob)
+    @card.update!(image: create_blob("avatar.png"))
+    materialize
+
+    assert_equal create_blob("avatar.png").byte_size, @board.bytes_used
+  end
+
+  test "destroying a card releases its bytes" do
+    @card.update!(image: create_blob, description: embed(create_blob("avatar.png")))
+    @card.comments.create!(body: embed(create_blob("avatar.svg")))
+    materialize
+
+    @card.destroy!
+    materialize
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "moving a card moves its bytes to the new board" do
+    @card.update!(image: create_blob, description: embed(create_blob("avatar.png")))
+    @card.comments.create!(body: embed(create_blob("avatar.svg")))
+    materialize
+    bytes = @board.bytes_used
+
+    @card.move_to(@other_board)
+    materialize
+
+    assert_equal 0, @board.bytes_used
+    assert_equal bytes, @other_board.bytes_used
+    assert_equal bytes, @account.bytes_used
+  end
+
+  test "destroying a board releases its bytes from the account and cleans up" do
+    @card.update!(image: create_blob)
+    materialize
+
+    @board.destroy!
+    materialize
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, Storage::Entry.where(owner: @board).count
+    assert_not Storage::Total.exists?(owner: @board)
+  end
+
+  test "other attachments are not counted" do
+    users(:david).avatar.attach create_blob("avatar.png")
+    materialize
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "reconciling fixes drift" do
+    @card.update!(image: create_blob)
+    materialize
+
+    Storage::Total.find_by(owner: @board).update!(bytes: 42)
+    @board.reconcile_storage_later
+    perform_enqueued_jobs
+
+    assert_equal @board.calculate_bytes_used, @board.bytes_used
+  end
+
+  test "first materialization of existing data calculates it from scratch" do
+    @card.update!(image: create_blob)
+    Storage::Entry.delete_all
+    assert_equal 0, @board.bytes_used
+
+    @card.comments.create!(body: embed(create_blob("avatar.png")))
+    materialize
+
+    assert_equal create_blob.byte_size + create_blob("avatar.png").byte_size, @board.bytes_used
+  end
+
+  test "materializing consumes entries in batches" do
+    @board.reconcile_storage_now
+    stub_const(Storage::Total, :MATERIALIZATION_BATCH_SIZE, 2) do
+      5.times { Storage::Entry.create!(account: @account, owner: @board, delta: 10) }
+      @board.materialize_storage_now
+    end
+
+    assert_equal 50, @board.bytes_used
+    assert_equal 0, Storage::Entry.where(owner: @board).count
+  end
+
+  test "stale entries are materialized by the safety net" do
+    @board.reconcile_storage_now
+    Storage::Entry.create!(account: @account, owner: @board, delta: 7).update_column(:created_at, 1.hour.ago)
+    clear_enqueued_jobs
+
+    Storage::MaterializeStaleJob.perform_now
+    perform_enqueued_jobs
+
+    assert_equal 7, @board.bytes_used
+  end
+
+  test "recording usage doesn't touch the totals" do
+    @board.reconcile_storage_now
+    @account.reconcile_storage_now
+
+    assert_no_changes -> { Storage::Total.pluck(:updated_at).sort } do
+      @card.update!(image: create_blob)
+    end
+  end
+
+  private
+    def create_blob(name = "moon.jpg")
+      @blobs ||= {}
+      @blobs[name] ||= ActiveStorage::Blob.create_and_upload!(io: file_fixture(name).open, filename: name)
+    end
+
+    def embed(blob)
+      %(<p>Look</p><action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+
+    def materialize
+      perform_enqueued_jobs only: Storage::MaterializeJob
+    end
+
+    def stub_const(klass, name, value)
+      original = klass.const_get(name)
+      klass.send(:remove_const, name)
+      klass.const_set(name, value)
+      yield
+    ensure
+      klass.send(:remove_const, name)
+      klass.const_set(name, original)
+    end
+end
