diff --git a/app/models/concerns/storage/totaled.rb b/app/models/concerns/storage/totaled.rb
new file mode 100644
index 0000000..ccc49b1
--- /dev/null
+++ b/app/models/concerns/storage/totaled.rb
@@ -0,0 +1,50 @@
+# Owners of storage usage: accounts and boards.
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total"
+    has_many :storage_entries, as: :owner, class_name: "Storage::Entry"
+
+    after_destroy :delete_storage_records
+  end
+
+  # The bytes used as last calculated in the background. Always read fresh from the database.
+  def bytes_used
+    reload_storage_total&.bytes || 0
+  end
+
+  def materialize_storage_later
+    unless destroyed?
+      Current.with_account(account) { Storage::MaterializeJob.perform_later(self) }
+    end
+  end
+
+  def materialize_storage_now
+    if total = reload_storage_total
+      total.materialize
+    else
+      reconcile_storage_now
+    end
+  end
+
+  def reconcile_storage_later
+    Current.with_account(account) { Storage::ReconcileJob.perform_later(self) }
+  end
+
+  def reconcile_storage_now
+    Storage::Total.for(self).reconcile
+  end
+
+  # Exact usage calculated from the attachments themselves. Expensive for large owners: use
+  # +bytes_used+ instead, unless you really need to bypass the materialized total.
+  def calculate_bytes_used
+    storage_usage.bytes
+  end
+
+  private
+    def delete_storage_records
+      Storage::Entry.where(owner: self).delete_all
+      Storage::Total.where(owner: self).delete_all
+    end
+end
diff --git a/app/models/concerns/storage/tracked.rb b/app/models/concerns/storage/tracked.rb
new file mode 100644
index 0000000..351d67d
--- /dev/null
+++ b/app/models/concerns/storage/tracked.rb
@@ -0,0 +1,32 @@
+# Records whose attachments count towards storage usage: files attached directly to them (only the
+# ones declared with +tracks_storage_of+) and files embedded in any of their rich texts.
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  included do
+    class_attribute :storage_tracked_attachment_names, instance_writer: false, default: []
+  end
+
+  class_methods do
+    def tracks_storage_of(*names)
+      self.storage_tracked_attachment_names = names.map(&:to_s)
+    end
+  end
+
+  def track_storage(delta)
+    Storage::Entry.record delta, account: account, board: storage_board
+  end
+
+  def storage_tracked_attachment?(attachment)
+    if attachment.record.is_a?(ActionText::RichText)
+      attachment.name == "embeds"
+    else
+      attachment.name.in?(storage_tracked_attachment_names)
+    end
+  end
+
+  private
+    def storage_board
+      board
+    end
+end
