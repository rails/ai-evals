index 0000000..0f3359d
--- /dev/null
+++ b/test/controllers/cards/drops/closures_controller_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class Cards::Drops::ClosuresControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create closes the card" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post card_drops_closure_path(card), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(card, :article)
+  end
+
+  test "create closes a postponed card" do
+    card = cards(:logo)
+    card.postpone(user: users(:kevin))
+
+    post card_drops_closure_path(card), as: :turbo_stream
+
+    assert card.reload.closed?
+    assert_not card.postponed?
+  end
+end
diff --git a/test/controllers/cards/drops/columns_controller_test.rb b/test/controllers/cards/drops/columns_controller_test.rb
new file mode 100644
index 0000000..8623f3c
--- /dev/null
+++ b/test/controllers/cards/drops/columns_controller_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Cards::Drops::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create moves the card into the column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, to: column do
+      post card_drops_column_path(card, column_id: column.id), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(card, :article)
+  end
+
+  test "create reopens a closed card" do
+    card = cards(:shipping)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.closed? }, from: true, to: false do
+      post card_drops_column_path(card, column_id: column.id), as: :turbo_stream
+    end
+
+    assert_equal column, card.column
+  end
+
+  test "create makes the card the most recently active" do
+    card = cards(:logo)
+
+    post card_drops_column_path(card, column_id: columns(:writebook_in_progress).id), as: :turbo_stream
+
+    assert_equal card, card.board.cards.active.latest.first
+  end
+
+  test "create rejects columns from other boards" do
+    card = cards(:logo)
+    other_column = boards(:private).columns.create!(name: "Elsewhere")
+
+    post card_drops_column_path(card, column_id: other_column.id), as: :turbo_stream
+
+    assert_response :not_found
+  end
+
+  test "create as JSON" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    post card_drops_column_path(card, column_id: column.id), as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+end
