diff --git a/app/controllers/concerns/cards/dropping.rb b/app/controllers/concerns/cards/dropping.rb
new file mode 100644
index 0000000..b6ecec5
--- /dev/null
+++ b/app/controllers/concerns/cards/dropping.rb
@@ -0,0 +1,13 @@
+# The board has already moved the dropped card to its new place optimistically, so we
+# only refresh the card's own contents (stamp, column name, color) and leave it where it is.
+module Cards::Dropping
+  extend ActiveSupport::Concern
+
+  private
+    def render_dropped_card
+      respond_to do |format|
+        format.turbo_stream { render "cards/drops/create", locals: { card: @card.reload } }
+        format.json { head :no_content }
+      end
+    end
+end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..72a3420
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,184 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post } from "@rails/request.js"
+
+// Moves cards between columns by dragging. The move is applied to the board as soon as the card is
+// dropped — placed exactly where the server's ordering will put it — and saved in the background.
+//
+// Columns keep their own order (golden cards first, then most recently active), so a dropped card always
+// lands at the top of its new column (or right below the golden cards), never at an arbitrary position.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #pendingSaves = 0
+  #failedSave = false
+
+  // Actions
+
+  dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    const sourceContainer = this.#containerContaining(item)
+    if (!item || !sourceContainer || this.#dragAndDropUnavailable) return
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.dataset.dragAndDropId)
+
+    this.draggedItem = item
+    this.sourceContainer = sourceContainer
+    this.originalCardColor = item.style.getPropertyValue("--card-color")
+
+    // Style on the next frame so the browser's drag image is taken from the un-dimmed card
+    requestAnimationFrame(() => this.draggedItem?.classList.add(this.draggedItemClass))
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#droppableContainerAt(event.target)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#previewCardColorFor(container)
+    } else {
+      this.#restoreCardColor()
+    }
+  }
+
+  dragLeave(event) {
+    if (this.draggedItem && !this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+      this.#restoreCardColor()
+    }
+  }
+
+  drop(event) {
+    const container = this.#droppableContainerAt(event.target)
+    if (!this.draggedItem || !container) return
+
+    event.preventDefault()
+    this.#move(this.draggedItem, this.sourceContainer, container)
+    this.wasDropped = true
+  }
+
+  dragEnd() {
+    if (!this.draggedItem) return
+
+    this.draggedItem.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    if (!this.wasDropped) this.#restoreCardColor()
+
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.originalCardColor = null
+    this.wasDropped = false
+  }
+
+  // Private
+
+  get #dragAndDropUnavailable() {
+    return window.matchMedia("(max-width: 639px)").matches
+  }
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerContaining(element) {
+    return element && this.containerTargets.find(container => container.contains(element))
+  }
+
+  #droppableContainerAt(element) {
+    const container = this.#containerContaining(element)
+    return container !== this.sourceContainer ? container : null
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(each => each.classList.toggle(this.hoverContainerClass, each === container))
+  }
+
+  #previewCardColorFor(container) {
+    const color = container.dataset.dragAndDropCardColor
+    if (color) {
+      this.draggedItem.style.setProperty("--card-color", color)
+    } else {
+      this.#restoreCardColor()
+    }
+  }
+
+  #restoreCardColor() {
+    if (this.originalCardColor) this.draggedItem?.style.setProperty("--card-color", this.originalCardColor)
+  }
+
+  #move(item, sourceContainer, targetContainer) {
+    this.#previewCardColorFor(targetContainer)
+    item.classList.remove(this.draggedItemClass)
+    this.#insert(item, targetContainer)
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, +1)
+    this.#save(item, targetContainer)
+  }
+
+  // Place the card where the column's own ordering puts it: moving touches the card, so it becomes the most
+  // recently active (or closed) card. In golden-first columns, that's right after the golden cards, unless
+  // the card is golden itself.
+  #insert(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return item.remove()
+
+    const cards = Array.from(list.querySelectorAll(".card")).filter(card => card !== item)
+    const goldenCards = cards.filter(card => this.#isGolden(card))
+    const afterGoldenCards = this.#isGoldenFirst(container) && !this.#isGolden(item) && goldenCards.length > 0
+
+    if (afterGoldenCards) {
+      goldenCards.at(-1).after(item)
+    } else if (cards.length > 0) {
+      cards[0].before(item)
+    } else {
+      (list.querySelector("turbo-frame") || list).prepend(item)
+    }
+  }
+
+  #isGolden(card) {
+    return card.dataset.dragAndDropGolden === "true"
+  }
+
+  #isGoldenFirst(container) {
+    return container.dataset.dragAndDropGoldenFirst === "true"
+  }
+
+  #adjustCount(container, delta) {
+    const counter = container.querySelector(".cards__expander-count")
+    const count = Number(counter?.textContent.trim())
+
+    if (counter && Number.isInteger(count)) {
+      const newCount = Math.max(count + delta, 0)
+      counter.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+
+  async #save(item, container) {
+    const url = container.dataset.dragAndDropUrl.replaceAll("__id__", item.dataset.dragAndDropId)
+
+    this.#pendingSaves++
+    try {
+      const response = await post(url, { responseKind: "turbo-stream" })
+      if (!response.ok) this.#failedSave = true
+    } catch {
+      this.#failedSave = true
+    } finally {
+      this.#pendingSaves--
+      this.#restoreBoardIfSaveFailed()
+    }
+  }
+
+  // The board already shows the move, so a failed save is the only case where we need to go back to the server
+  #restoreBoardIfSaveFailed() {
+    if (this.#pendingSaves === 0 && this.#failedSave) {
+      this.#failedSave = false
+      Turbo.visit(window.location.href, { action: "replace" })
+    }
+  }
+}
