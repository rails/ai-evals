@@ -0,0 +1,126 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:kevin)
+    visit board_url(boards(:writebook))
+  end
+
+  test "dropping a card moves it to the top of the new column right away" do
+    card = cards(:layout)
+    hold_drop_requests
+
+    drag card, to: columns(:writebook_in_progress)
+
+    assert_equal [ card.title, cards(:text).title ], card_titles_in(columns(:writebook_in_progress))
+    assert_equal [ cards(:logo).title ], card_titles_in(columns(:writebook_triage))
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_equal columns(:writebook_triage), card.reload.column, "the board moved before the save"
+
+    release_drop_requests
+    wait_for { card.reload.column == columns(:writebook_in_progress) }
+    assert_card_order_survives_reload columns(:writebook_in_progress)
+  end
+
+  test "dropping a card into a golden-first column puts it below the golden cards" do
+    card = cards(:text)
+
+    drag card, to: columns(:writebook_triage)
+
+    assert_equal [ cards(:logo).title, card.title, cards(:layout).title ], card_titles_in(columns(:writebook_triage))
+
+    wait_for { card.reload.column == columns(:writebook_triage) }
+    assert_card_order_survives_reload columns(:writebook_triage)
+  end
+
+  test "dropping a card on Done closes it" do
+    card = cards(:layout)
+
+    drag card, to: "#closed-cards"
+
+    assert_selector "#closed-cards ##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "##{dom_id(columns(:writebook_triage))} ##{dom_id(card, :article)}", visible: :all
+
+    wait_for { card.reload.closed? }
+  end
+
+  test "dropping a card back on its own column does nothing" do
+    card = cards(:layout)
+
+    drag card, to: columns(:writebook_triage)
+
+    assert_equal [ cards(:logo).title, card.title ], card_titles_in(columns(:writebook_triage))
+    sleep 0.5
+    assert_equal columns(:writebook_triage), card.reload.column
+  end
+
+  test "dropping a card updates the column counts" do
+    assert_equal "2", column_count(columns(:writebook_triage))
+    assert_equal "1", column_count(columns(:writebook_in_progress))
+
+    drag cards(:layout), to: columns(:writebook_in_progress)
+
+    assert_equal "1", column_count(columns(:writebook_triage))
+    assert_equal "2", column_count(columns(:writebook_in_progress))
+  end
+
+  test "a failed save puts the card back" do
+    card = cards(:layout)
+    execute_script <<~JS
+      const fetch = window.fetch
+      window.fetch = (url, options) => String(url).includes("/drops/") ? Promise.resolve(new Response("", { status: 500 })) : fetch(url, options)
+    JS
+
+    drag card, to: columns(:writebook_in_progress)
+
+    assert_selector "##{dom_id(columns(:writebook_triage))} ##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "##{dom_id(columns(:writebook_in_progress))} ##{dom_id(card, :article)}", visible: :all
+    assert_equal columns(:writebook_triage), card.reload.column
+  end
+
+  private
+    def column_count(column)
+      find("##{dom_id(column)} .cards__expander-count", visible: :all).text(:all).strip
+    end
+
+    def expand_column(name)
+      find(".cards__expander", text: /#{Regexp.escape(name)}/i).click
+    end
+
+    def drag(card, to:)
+      expand_column card.column.name
+      target = to.is_a?(String) ? find(to) : find("##{dom_id(to)}")
+      find("##{dom_id(card, :article)}").drag_to target
+    end
+
+    def card_titles_in(column)
+      all("##{dom_id(column)} .card .card__title", visible: :all).map { it.text(:all).strip }
+    end
+
+    def assert_card_order_survives_reload(column)
+      titles = card_titles_in(column)
+      visit current_url
+      assert_selector "##{dom_id(column)} .card", visible: :all, count: titles.size
+      assert_equal titles, card_titles_in(column)
+    end
+
+    def hold_drop_requests
+      execute_script <<~JS
+        const fetch = window.fetch
+        window.heldDrops = []
+        window.fetch = (url, options) => String(url).includes("/drops/") ?
+          new Promise(resolve => window.heldDrops.push(() => resolve(fetch(url, options)))) :
+          fetch(url, options)
+      JS
+    end
+
+    def release_drop_requests
+      assert_equal 1, evaluate_script("window.heldDrops.length")
+      execute_script "window.heldDrops.forEach(release => release())"
+    end
+
+    def wait_for(timeout: 5)
+      Timeout.timeout(timeout) { sleep 0.05 until yield }
+    end
+end
