@@ -0,0 +1,21 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <% if board.published? %>
+      <p class="margin-none-block-start">Anyone with this link can see this board, even without a Fizzy account.</p>
+      <div class="flex align-center gap-half">
+        <input type="text" class="input" value="<%= public_board_url(board.publication.key) %>" readonly aria-label="Public link">
+      </div>
+      <% if Current.user.can_administer_board?(board) %>
+        <%= button_to "Turn off public link", board_publication_path(board), method: :delete, class: "btn txt-small margin-block-start",
+              data: { turbo_confirm: "Are you sure? The current public link will stop working." } %>
+      <% end %>
+    <% else %>
+      <p class="margin-none-block-start">Share a read-only version of this board with anyone, via a secret link.</p>
+      <% if Current.user.can_administer_board?(board) %>
+        <%= button_to "Publish this board", board_publication_path(board), method: :post, class: "btn txt-small" %>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
