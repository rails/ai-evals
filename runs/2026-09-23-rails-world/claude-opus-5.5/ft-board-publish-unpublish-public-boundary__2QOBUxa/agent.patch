+<% @page_title = @board.name %>
+<% @body_class = "contained-scrolling" %>
+<% key = @board.publication.key %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<%= tag.div class: "card-columns hide-scrollbar", data: {
+      controller: "collapsible-columns",
+      collapsible_columns_board_value: @board.id,
+      collapsible_columns_collapsed_class: "is-collapsed",
+      collapsible_columns_expanded_class: "is-expanded",
+      collapsible_columns_no_transitions_class: "no-transitions",
+      collapsible_columns_title_not_visible_class: "is-off-screen" } do %>
+  <div class="card-columns__left">
+    <%= render "public/boards/column", id: "not-now", name: "Not Now", class: "cards--on-deck", style: "--card-color: var(--color-card-complete);",
+          count: @board.cards.postponed.count, path: public_board_columns_not_now_path(key), frame: :not_now_column %>
+  </div>
+
+  <%= column_tag id: "maybe", name: "Maybe?", drop_url: nil, collapsed: false, selected: "true", class: "cards--maybe", data: { collapsible_columns_target: "column maybeColumn" } do %>
+    <header class="cards__header">
+      <%= render "boards/show/expander", title: "Maybe?", count: @board.cards.awaiting_triage.count, column_id: "maybe" %>
+      <%= render "boards/show/menu/maximize", column_path: public_board_columns_stream_path(key) %>
+    </header>
+    <div class="cards__list hide-scrollbar">
+      <% if @page.used? %>
+        <%= with_automatic_pagination "maybe", @page do %>
+          <%= render partial: "public/boards/cards/preview", collection: @page.records, as: :card %>
+        <% end %>
+      <% end %>
+    </div>
+  <% end %>
+
+  <div class="card-columns__right">
+    <% @board.columns.sorted.each do |column| %>
+      <%= render "public/boards/column", id: dom_id(column), name: column.name, class: "cards--doing", style: "--card-color: #{column.color};",
+            count: column.cards.active.count, path: public_board_column_path(key, column), frame: dom_id(column, :cards) %>
+    <% end %>
+
+    <%= render "public/boards/column", id: "closed-cards", name: "Done", class: "cards--closed", style: "--card-color: var(--color-card-complete);",
+          count: @board.cards.published.closed.count, path: public_board_columns_closed_path(key), frame: :closed_column %>
+  </div>
+<% end %>
