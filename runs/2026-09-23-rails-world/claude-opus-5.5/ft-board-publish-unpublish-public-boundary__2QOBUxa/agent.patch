+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show without being signed in" do
+    get public_board_path(@board.publication.key)
+
+    assert_response :success
+    assert_match @board.name, @response.body
+  end
+
+  test "show when signed in" do
+    sign_in_as :kevin
+
+    get public_board_path(@board.publication.key)
+
+    assert_response :success
+  end
+
+  test "not found once unpublished" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_path(key)
+
+    assert_response :not_found
+  end
+
+  test "not found with an invalid key" do
+    get public_board_path("invalid")
+
+    assert_response :not_found
+  end
+
+  test "pseudo columns" do
+    get public_board_columns_not_now_path(@board.publication.key)
+    assert_response :success
+
+    get public_board_columns_stream_path(@board.publication.key)
+    assert_response :success
+
+    get public_board_columns_closed_path(@board.publication.key)
+    assert_response :success
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..62c15cc
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publish and unpublish" do
+    assert_not @board.published?
+
+    @board.publish
+    assert @board.published?
+    assert @board.publication.key.present?
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    @board.unpublish
+    assert_not @board.published?
+  end
+
+  test "find by published key" do
+    @board.publish
+
+    assert_equal @board, Board.find_by_published_key(@board.publication.key)
+
+    assert_raises ActiveRecord::RecordNotFound do
+      Board.find_by_published_key("missing")
+    end
+  end
+
+  test "republishing generates a new key" do
+    @board.publish
+    old_key = @board.publication.key
+
+    @board.unpublish
+    @board.publish
+
+    assert_not_equal old_key, @board.publication.key
+  end
+end
