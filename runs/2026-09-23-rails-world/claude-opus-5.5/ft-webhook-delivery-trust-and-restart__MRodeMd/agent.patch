 class Webhook::Delivery < ApplicationRecord
+  STALE_THRESHOLD = 7.days
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  ENDPOINT_TIMEOUT = 7.seconds
+
+  NETWORK_ERRORS = {
+    connection_timeout: [ Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Timeout::Error ],
+    failed_tls: [ OpenSSL::SSL::SSLError ],
+    destination_unreachable: [ SocketError, SystemCallError, IOError, EOFError, Net::HTTPBadResponse, Net::ProtocolError ]
+  }.freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +19,27 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...STALE_THRESHOLD.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      stale.in_batches(of: 1_000).delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  # Each delivery is attempted at most once: the pending → in_progress transition is
+  # claimed atomically, so a duplicated or re-run job can never POST the same event twice.
+  def deliver
+    if claim
+      deliver_claimed
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +58,130 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      claimed = self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload if claimed
+      claimed
+    end
+
+    def deliver_claimed
+      self.request = { headers: headers }
+      self.response = perform_request
+      self.state = response[:error].present? ? :errored : :completed
+      save!
+
+      webhook.delinquency_tracker.record_delivery_of(self)
+    rescue
+      self.class.where(id: id, state: :in_progress).update_all(state: :errored, response: { error: "internal_error" }, updated_at: Time.current)
+      raise
+    end
+
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => timestamp
+      }
+    end
+
+    def perform_request
+      if resolved_ip.nil?
+        { error: :private_uri }
+      else
+        response = http.request(post_request)
+        { code: response.code.to_i }
+      end
+    rescue *NETWORK_ERRORS.values.flatten => error
+      { error: network_error_for(error) }
+    end
+
+    def resolved_ip
+      @resolved_ip ||= SsrfProtection.resolve_public_ip(uri.host) if uri&.host.present?
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    rescue URI::InvalidURIError
+      nil
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri, headers).tap { it.body = payload }
+    end
+
+    def network_error_for(error)
+      NETWORK_ERRORS.find { |_, classes| classes.any? { error.is_a?(it) } }.first
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def timestamp
+      @timestamp ||= Time.current.utc.iso8601(3)
+    end
+
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      elsif webhook.for_basecamp?
+        "application/x-www-form-urlencoded"
+      else
+        "application/json"
+      end
+    end
+
+    def payload
+      @payload ||= if webhook.for_campfire?
+        render_payload(formats: :html)
+      elsif webhook.for_basecamp?
+        { content: render_payload(formats: :html) }.to_query
+      elsif webhook.for_slack?
+        { text: slack_text }.to_json
+      else
+        render_payload(formats: :json)
+      end
+    end
+
+    def slack_text
+      description = event.description_for(nil).to_plain_text
+
+      if event.eventable
+        "#{description} <#{Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options, script_name: account.slug)}|↗︎>"
+      else
+        description
+      end
+    end
+
+    def render_payload(formats:)
+      renderer.render template: "webhooks/event", formats: formats, assigns: { event: event }, layout: false
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(**renderer_env)
+    end
+
+    def renderer_env
+      host = [ url_options[:host], url_options[:port] ].compact.join(":")
+      { http_host: host.presence, https: url_options[:protocol].to_s.start_with?("https"), script_name: account.slug }.compact
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options || {}
+    end
 end
