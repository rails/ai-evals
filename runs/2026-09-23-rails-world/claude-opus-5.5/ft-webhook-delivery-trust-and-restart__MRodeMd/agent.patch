diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..9fb9ef9
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "is created along with the webhook" do
+    webhook = Webhook.create! name: "New", url: "https://example.com/hook", board: boards(:writebook)
+    assert webhook.delinquency_tracker.persisted?
+  end
+
+  test "a success resets the failure streak" do
+    3.times { @tracker.record_delivery_of(failed_delivery) }
+    assert_equal 3, @tracker.consecutive_failures_count
+
+    @tracker.record_delivery_of(webhook_deliveries(:successfully_completed))
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "ten failures in a row over an hour deactivate the webhook" do
+    travel_to 2.hours.ago do
+      @tracker.record_delivery_of(failed_delivery)
+    end
+    8.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+
+    @tracker.record_delivery_of(failed_delivery)
+    assert_not @webhook.reload.active?
+  end
+
+  test "ten quick failures don't deactivate the webhook" do
+    12.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+  end
+
+  test "failures spread over an hour but fewer than ten don't deactivate the webhook" do
+    travel_to 3.hours.ago do
+      @tracker.record_delivery_of(failed_delivery)
+    end
+    7.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating a webhook starts a fresh streak" do
+    @tracker.update! consecutive_failures_count: 10, first_failure_at: 2.hours.ago
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+  end
+
+  private
+    def failed_delivery
+      webhook_deliveries(:unsuccessfully_completed)
+    end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..5fe2040 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -78,3 +78,135 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
     assert_nil delivery.response_summary
   end
 end
+
+class Webhook::DeliveryDeliverTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:layout_commented)
+    stub_dns_resolution(PUBLIC_IP)
+  end
+
+  test "creating a delivery enqueues it" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    end
+  end
+
+  test "deliver POSTs a signed payload to the pinned public IP and logs the result" do
+    request = stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert_requested request
+    assert delivery.reload.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request[:headers]["User-Agent"]
+
+    assert_requested(:post, @webhook.url) do |req|
+      body = JSON.parse(req.body)
+      assert_equal @event.id, body["id"]
+      assert_equal "comment_created", body["action"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, req.body), req.headers["X-Webhook-Signature"]
+      assert_equal "application/json", req.headers["Content-Type"]
+    end
+  end
+
+  test "deliver sends exactly once even when run repeatedly" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+    delivery.deliver
+    Webhook::Delivery.find(delivery.id).deliver
+
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "deliver skips deliveries already claimed by another worker" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    Webhook::Delivery.where(id: delivery.id).update_all(state: :in_progress)
+
+    delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "non-2XX responses are logged as failed" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+  end
+
+  test "network errors are logged as errored" do
+    { Errno::ECONNREFUSED => "destination_unreachable", Net::OpenTimeout => "connection_timeout", OpenSSL::SSL::SSLError => "failed_tls" }.each do |error, logged|
+      WebMock.reset!
+      stub_request(:post, @webhook.url).to_raise(error)
+      delivery = Webhook::Delivery.create!(webhook: @webhook, event: Event.create!(board: @webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_published"))
+
+      delivery.deliver
+
+      assert delivery.reload.errored?
+      assert_equal logged, delivery.response[:error]
+    end
+  end
+
+  test "URLs resolving to private addresses are never requested" do
+    stub_dns_resolution("10.0.0.1")
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "private_uri", delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "failures and successes are reported to the delinquency tracker" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    Webhook::Delivery.create!(webhook: @webhook, event: @event).deliver
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+
+    stub_request(:post, @webhook.url).to_return(status: 204)
+    Webhook::Delivery.create!(webhook: @webhook, event: Event.create!(board: @webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_published")).deliver
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "slack, campfire and basecamp receive their own formats" do
+    {
+      "https://hooks.slack.com/services/T123/B123/abc" => "application/json",
+      "https://campfire.example.com/rooms/1/2-bot/messages" => "text/html",
+      "https://3.basecamp.com/1/integrations/tok/buckets/2/chats/3/lines" => "application/x-www-form-urlencoded"
+    }.each do |url, content_type|
+      @webhook.update_column :url, url
+      stub_request(:post, url).to_return(status: 200)
+      Webhook::Delivery.where(webhook: @webhook).delete_all
+
+      Webhook::Delivery.create!(webhook: @webhook, event: @event).deliver
+
+      assert_requested(:post, url) do |req|
+        assert_equal content_type, req.headers["Content-Type"]
+        assert_includes CGI.unescape(req.body), "commented"
+      end
+    end
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    fresh = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    stale = webhook_deliveries(:successfully_completed)
+    stale.update_column :created_at, 8.days.ago
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(fresh.id)
+    assert_not Webhook::Delivery.exists?(stale.id)
+  end
+end
