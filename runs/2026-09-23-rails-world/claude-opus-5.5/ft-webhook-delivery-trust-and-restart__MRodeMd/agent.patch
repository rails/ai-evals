+require "test_helper"
+
+class Webhook::TriggerableTest < ActiveSupport::TestCase
+  test "events dispatch a delivery to each active, subscribed webhook on the board" do
+    subscribed = webhooks(:active)
+    unsubscribed = Webhook.create! name: "Comments", url: "https://example.com/c", board: subscribed.board, subscribed_actions: %w[ comment_created ]
+    inactive = Webhook.create! name: "Off", url: "https://example.com/o", board: subscribed.board, subscribed_actions: %w[ card_published ], active: false
+
+    event = nil
+    assert_enqueued_with job: Event::WebhookDispatchJob do
+      event = Event.create!(board: subscribed.board, creator: users(:david), eventable: cards(:logo), action: "card_published")
+    end
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      perform_enqueued_jobs only: Event::WebhookDispatchJob
+    end
+
+    assert subscribed.deliveries.exists?(event: event)
+    assert_not unsubscribed.deliveries.exists?(event: event)
+    assert_not inactive.deliveries.exists?(event: event)
+  end
+
+  test "events with no interested webhooks don't enqueue a dispatch" do
+    assert_no_enqueued_jobs only: Event::WebhookDispatchJob do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_title_changed")
+    end
+  end
+
+  test "dispatching twice creates a single delivery" do
+    event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      event.dispatch_webhooks
+      event.dispatch_webhooks
+    end
+  end
+
+  test "subscribed_to matches whole actions only" do
+    webhook = Webhook.create! name: "Postponed", url: "https://example.com/p", board: boards(:writebook), subscribed_actions: %w[ card_auto_postponed ]
+
+    assert_not_includes Webhook.subscribed_to("card_postponed"), webhook
+    assert_includes Webhook.subscribed_to("card_auto_postponed"), webhook
+  end
+end
+
+class Webhook::EndToEndTest < ActiveSupport::TestCase
+  test "an event results in exactly one POST to each subscribed receiver" do
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs do
+      Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_published")
+    end
+
+    assert_requested :post, webhook.url, times: 1
+    assert webhook.deliveries.ordered.first.succeeded?
+  end
+
+  test "unexpected errors mark the delivery errored without counting against the receiver" do
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    Net::HTTP.any_instance.stubs(:request).raises(ArgumentError, "boom")
+
+    assert_raises(ArgumentError) { delivery.deliver }
+
+    assert delivery.reload.errored?
+    assert_equal "internal_error", delivery.response[:error]
+    assert_equal 0, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+end
