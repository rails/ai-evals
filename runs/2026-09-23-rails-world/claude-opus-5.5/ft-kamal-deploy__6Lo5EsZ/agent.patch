diff --git a/.kamal/secrets b/.kamal/secrets
new file mode 100644
index 0000000..40a4361
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,29 @@
+# Secrets defined here are available for reference under `env.secret` in
+# config/deploy.yml. All secrets should be pulled from either password manager,
+# ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe
+# for git.
+#
+# By default these are read from your shell environment, e.g.:
+#
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#   export VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...
+#   export SMTP_USERNAME=... SMTP_PASSWORD=...
+#   bin/kamal setup
+#
+# Generate a VAPID key pair (for web push notifications) with:
+#
+#   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}", "VAPID_PRIVATE_KEY=#{k.private_key}"'
+#
+# Keep SECRET_KEY_BASE and the VAPID keys the same between deploys: changing
+# them signs everyone out and breaks existing push subscriptions.
+#
+# Alternatively, fetch them from a password manager, e.g. 1Password:
+#
+#   SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from Vault/Fizzy SECRET_KEY_BASE VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY SMTP_USERNAME SMTP_PASSWORD)
+#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
