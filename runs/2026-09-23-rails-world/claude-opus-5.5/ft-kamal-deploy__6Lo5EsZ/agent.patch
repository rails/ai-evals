--- a/README.md
+++ b/README.md
@@ -9,6 +9,17 @@ You are welcome -- and encouraged -- to modify Fizzy to your liking.
 Please see our [Development guide](docs/development.md) for how to get Fizzy set up for local development.
 
 
+## Deploying with Kamal
+
+Fizzy ships with a [Kamal](https://kamal-deploy.org) config for running everything on one Linux server with Docker: the web app, background jobs (Solid Queue inside Puma) and SQLite, in a single container, with SSL provided by kamal-proxy via Let's Encrypt.
+
+1. Point your hostname's DNS at the server, and make sure you can SSH into it as root (or set `ssh.user`).
+2. In `config/deploy.yml`, replace `fizzy.example.com` with your hostname (in `servers`, `proxy.host` and `BASE_URL`), and set `MAILER_FROM_ADDRESS` and your `SMTP_*` mail server settings.
+3. Export the secrets read by `.kamal/secrets`: `SECRET_KEY_BASE` (`bin/rails secret`), `VAPID_PUBLIC_KEY`/`VAPID_PRIVATE_KEY` (see [development](docs/development.md)), `SMTP_USERNAME` and `SMTP_PASSWORD`.
+4. Run `bin/kamal setup`. Later deploys are `bin/kamal deploy`.
+
+Databases and uploaded files live in the `fizzy_storage` Docker volume on the server, so they survive redeploys. Back it up.
+
 ## Contributing
 
 We welcome contributions! Please read our [style guide](STYLE.md) before submitting code.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..4561717
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,112 @@
+# Deploy Fizzy to a single Linux server with Kamal.
+#
+# Everything runs in one container on one box: the web server (Puma behind
+# Thruster), background jobs (Solid Queue inside Puma), and SQLite databases.
+# kamal-proxy terminates SSL with a free Let's Encrypt certificate.
+#
+# To deploy your own:
+#
+#   1. Point a DNS record for your hostname at your server, and make sure you
+#      can `ssh root@your-server` (or set `ssh.user` below).
+#   2. Replace every fizzy.example.com / mail.example.com below with your own.
+#   3. Provide the secrets listed in .kamal/secrets (see that file).
+#   4. Run `bin/kamal setup` for the first deploy, `bin/kamal deploy` afterwards.
+#
+# Data (SQLite databases and uploaded files) lives in /rails/storage, which is
+# mounted from the `fizzy_storage` Docker volume on the host, so it survives
+# redeploys. Back up that volume!
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. Built locally and pushed to a registry that
+# Kamal runs on the server itself (see `registry` below).
+image: fizzy
+
+# The server(s) to deploy to. Only the web role is needed: jobs run inside Puma.
+servers:
+  web:
+    - fizzy.example.com
+
+# kamal-proxy fronts the app, provisions a Let's Encrypt certificate for `host`
+# and forwards traffic to Thruster on port 80 inside the container.
+# Your DNS must point at the server before running `kamal setup`.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Push the image through an SSH tunnel to a registry that Kamal runs on the
+# deploy host, so no Docker Hub (or other registry) account is required.
+# To use a remote registry instead, set `server`, `username` and `password`.
+registry:
+  server: localhost:5555
+
+# Build for the server's architecture. Change to arm64 for ARM servers.
+builder:
+  arch: amd64
+
+env:
+  # Secrets are read from .kamal/secrets.
+  secret:
+    - SECRET_KEY_BASE
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+  clear:
+    # The public URL of your Fizzy, used to build links in emails etc.
+    BASE_URL: https://fizzy.example.com
+
+    # Who emails appear to come from.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+
+    # Your outgoing mail server. Port 587 uses STARTTLS; for implicit TLS
+    # (usually port 465) set SMTP_TLS: true.
+    SMTP_ADDRESS: mail.example.com
+    SMTP_PORT: 587
+    # SMTP_TLS: true
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+
+    # Run Solid Queue background jobs inside the Puma web process.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # SQLite on local disk; uploaded files on local disk too.
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # SSL is terminated by kamal-proxy.
+    ASSUME_SSL: true
+    FORCE_SSL: true
+
+    # Allow anyone to sign up and create their own account? Leave false for a
+    # single-account install.
+    MULTI_TENANT: false
+
+    # Number of Puma worker processes. Defaults to the number of CPU cores.
+    # WEB_CONCURRENCY: 2
+
+    # Log level. Use "debug" when troubleshooting.
+    # RAILS_LOG_LEVEL: info
+
+# Persist SQLite databases and uploaded files across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between old and new versions during deploys, to
+# avoid 404s on in-flight requests.
+asset_path: /rails/public/assets
+
+# Handy shortcuts, e.g. `bin/kamal console`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Use a different SSH user than root:
+# ssh:
+#   user: app
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..5e21cf2 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,35 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Set BASE_URL (e.g. https://fizzy.example.com) so links in emails, webhooks,
+  # notifications and exports point at the right host.
+  if base_url = ENV["BASE_URL"].presence
+    uri = URI.parse(base_url)
+    url_options = { host: uri.host, protocol: uri.scheme }
+    url_options[:port] = uri.port if uri.port && uri.port != uri.default_port
+
+    Rails.application.routes.default_url_options = url_options
+    config.action_mailer.default_url_options = url_options
+  end
+
+  # Deliver email via SMTP when SMTP_ADDRESS is set.
+  if smtp_address = ENV["SMTP_ADDRESS"].presence
+    smtp_tls = ENV["SMTP_TLS"] == "true"
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: Integer(ENV.fetch("SMTP_PORT", smtp_tls ? 465 : 587)),
+      domain: ENV["SMTP_DOMAIN"].presence,
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: (ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym if ENV["SMTP_USERNAME"].present?),
+      tls: smtp_tls,
+      enable_starttls_auto: !smtp_tls,
+      openssl_verify_mode: ENV["SMTP_SSL_VERIFY_MODE"].presence
+    }.compact
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
