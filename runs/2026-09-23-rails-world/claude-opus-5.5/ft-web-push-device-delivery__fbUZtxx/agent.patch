diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..6ab190e 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,51 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Push notifications
+self.addEventListener("push", (event) => {
+  const { title, body, path, tag } = readPushData(event)
+
+  event.waitUntil(self.registration.showNotification(title || "Fizzy", {
+    body,
+    tag,
+    renotify: Boolean(tag),
+    icon: "/app-icon-192.png",
+    data: { path }
+  }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openNotificationTarget(event.notification.data?.path))
+})
+
+function readPushData(event) {
+  try {
+    return event.data?.json() ?? {}
+  } catch {
+    return { body: event.data?.text() }
+  }
+}
+
+async function openNotificationTarget(path) {
+  const url = new URL(path || "/", self.location.origin)
+  if (url.origin !== self.location.origin) return
+
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const existing = windows.find(client => client.url === url.href) || windows.find(client => new URL(client.url).origin === url.origin)
+
+  if (existing) {
+    const client = await existing.focus()
+    if (client.url !== url.href) {
+      try {
+        await client.navigate(url.href)
+      } catch {
+        await self.clients.openWindow(url.href)
+      }
+    }
+  } else {
+    await self.clients.openWindow(url.href)
+  }
+}
+
 TurboOffline.start()
