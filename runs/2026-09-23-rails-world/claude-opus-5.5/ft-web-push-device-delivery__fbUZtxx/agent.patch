+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @params = { push_subscription: {
+      endpoint: "https://updates.push.services.mozilla.com/wpush/v2/new-token",
+      p256dh_key: "BJnS49FOQGfUCjJxcxYahSWnWRgmfHaYBhj2TqqzrgJcw7cEC1NFGvngDKErBS1I6t0mqwV3LzwgYMht4W1-H00",
+      auth_key: "L8NWhBacYqJujWagLbUI7g"
+    } }
+  end
