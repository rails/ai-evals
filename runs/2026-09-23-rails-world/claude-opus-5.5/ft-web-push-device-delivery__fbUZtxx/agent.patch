+++ b/config/initializers/web_push.rb
@@ -0,0 +1,8 @@
+# VAPID keys identify this server to browser push services. Generate a pair with
+# `bin/rails runner 'k = WebPush.generate_key; puts k.public_key, k.private_key'`.
+# Web push stays off until both keys are set.
+Rails.application.configure do
+  config.x.vapid.public_key = ENV.fetch("VAPID_PUBLIC_KEY") { config.x.vapid.public_key }
+  config.x.vapid.private_key = ENV.fetch("VAPID_PRIVATE_KEY") { config.x.vapid.private_key }
+  config.x.vapid.subject = ENV.fetch("VAPID_SUBJECT") { config.x.vapid.subject || "mailto:#{ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")[/[^<\s]+@[^>\s]+/]}" }
+end
