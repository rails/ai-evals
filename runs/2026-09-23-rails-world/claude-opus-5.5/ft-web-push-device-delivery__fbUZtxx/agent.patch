diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..5e1f694
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,26 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+
+    head :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..a263782
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,106 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "explainer", "details", "button" ]
+  static classes = [ "on" ]
+  static values = { subscriptionsUrl: String, publicKey: String }
+
+  async connect() {
+    if (!this.#supported) {
+      this.#showHelp({ unsupported: true })
+    } else if (Notification.permission === "denied") {
+      this.#showHelp()
+    } else if (Notification.permission === "granted") {
+      const subscription = await this.#existingSubscription()
+      if (subscription && await this.#register(subscription)) this.#turnedOn()
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (!this.#supported) {
+      this.#showHelp({ unsupported: true })
+      return
+    }
+
+    this.buttonTarget.disabled = true
+
+    try {
+      if (await Notification.requestPermission() === "granted") {
+        if (await this.#register(await this.#subscribe())) this.#turnedOn()
+      } else {
+        this.#showHelp()
+      }
+    } catch (error) {
+      console.error("Couldn't turn on push notifications", error)
+      this.#showHelp()
+    } finally {
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async #existingSubscription() {
+    const registration = await this.#serviceWorkerRegistration()
+    const subscription = await registration.pushManager.getSubscription()
+
+    return this.#isForThisServer(subscription) ? subscription : null
+  }
+
+  async #subscribe() {
+    const registration = await this.#serviceWorkerRegistration()
+    const existing = await registration.pushManager.getSubscription()
+
+    if (this.#isForThisServer(existing)) {
+      return existing
+    } else {
+      // A subscription made with a different key pair can't be reused.
+      await existing?.unsubscribe()
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  async #serviceWorkerRegistration() {
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    return navigator.serviceWorker.ready
+  }
+
+  #isForThisServer(subscription) {
+    const key = subscription?.options?.applicationServerKey
+    return subscription && (!key || this.#sameKey(new Uint8Array(key), this.#applicationServerKey))
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    return response.ok
+  }
+
+  #turnedOn() {
+    this.element.classList.add(this.onClass)
+    this.explainerTarget.hidden = true
+  }
+
+  #showHelp({ unsupported = false } = {}) {
+    this.element.classList.remove(this.onClass)
+    this.detailsTargets.forEach(target => target.hidden = unsupported)
+    this.explainerTarget.hidden = false
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+
+  #sameKey(a, b) {
+    return a.length === b.length && a.every((byte, index) => byte === b[index])
+  }
+}
