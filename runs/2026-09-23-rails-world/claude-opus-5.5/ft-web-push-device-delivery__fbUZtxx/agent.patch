diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..9de5e01
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,35 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :push_later, on: %i[ create update ], if: :landed_in_tray?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if Push.enabled?
+  end
+
+  def push_now
+    if pushable?
+      message = push_message
+      user.push_subscriptions.find_each { it.push(message) }
+    end
+  end
+
+  private
+    def landed_in_tray?
+      previously_new_record? || saved_change_to_source_id?
+    end
+
+    def pushable?
+      !read? && user.active? && user.push_subscriptions.exists?
+    end
+
+    def push_message
+      renderer.render template: "notifications/push", formats: :json, assigns: { notification: self }
+    end
+
+    def renderer
+      ApplicationController.renderer.new(script_name: account.slug, https: !Rails.env.local?)
+    end
+end
