+    end
+
+    assert_response :forbidden
+  end
+
+  test "non-admins can't unpublish" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :forbidden
+  end
+end
