diff --git a/app/views/public/cards/show.html.erb b/app/views/public/cards/show.html.erb
new file mode 100644
index 0000000..7cddbe8
--- /dev/null
+++ b/app/views/public/cards/show.html.erb
@@ -0,0 +1,55 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@board.publication.key), class: "btn btn--back" do %>
+      <strong class="overflow-ellipsis">Back to <%= @board.name %></strong>
+    <% end %>
+  </div>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card", id: dom_id(@card, :public_article) do %>
+      <header class="card__header">
+        <span class="txt-small">#<%= @card.number %></span>
+
+        <% if @card.column %>
+          <%= link_to @card.column.name, public_board_column_path(@board.publication.key, @card.column), class: "btn txt-uppercase txt-small" %>
+        <% end %>
+
+        <% @card.tags.each do |tag| %>
+          <span class="card__tag txt-small">#<%= tag.title %></span>
+        <% end %>
+      </header>
+
+      <div class="card__body">
+        <div class="card__content">
+          <h1 class="card__title"><%= card_html_title(@card) %></h1>
+
+          <% if @card.description.present? %>
+            <div class="card__description rich-text-content"><%= @card.description %></div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ul class="steps">
+              <% @card.steps.each do |step| %>
+                <li class="step"><%= step.completed? ? "☑" : "☐" %> <%= step.content %></li>
+              <% end %>
+            </ul>
+          <% end %>
+        </div>
+
+        <% if @card.closed? %>
+          <p class="txt-subtle">Done</p>
+        <% elsif @card.postponed? %>
+          <p class="txt-subtle">Not now</p>
+        <% end %>
+      </div>
+
+      <footer class="card__footer txt-small txt-subtle">
+        Added by <%= @card.creator.name %> on <%= local_datetime_tag(@card.created_at, style: :shortdate) %>
+      </footer>
+    <% end %>
+  </div>
+</section>
