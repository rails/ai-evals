+namespace :storage do
+  desc "Recalculate storage usage totals for every account and board in the background"
+  task reconcile: :environment do
+    Account.find_each do |account|
+      Current.with_account(account) do
+        account.boards.find_each(&:reconcile_storage_later)
+        account.reconcile_storage_later
+      end
+    end
+  end
+end
