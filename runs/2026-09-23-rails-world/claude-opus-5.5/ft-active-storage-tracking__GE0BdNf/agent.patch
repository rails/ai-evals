diff --git a/lib/rails_ext/active_storage_attachment_storage_tracking.rb b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
new file mode 100644
index 0000000..5607b1b
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
@@ -0,0 +1,43 @@
+# Logs storage ledger entries (see Storage) as tracked attachments come and go: card images,
+# and files embedded in board descriptions, card descriptions, and comments.
+#
+# Entries are written within the same transaction as the attachment change. Detaching and
+# purging delete attachments without callbacks, so +delete+ is covered too.
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create  -> { track_storage_usage(+1) }
+    after_destroy -> { track_storage_usage(-1) }
+  end
+
+  def delete
+    was_persisted = persisted?
+
+    super.tap do
+      track_storage_usage(-1) if was_persisted
+    end
+  end
+
+  private
+    def track_storage_usage(sign)
+      if (board = storage_board) && blob
+        Storage::Entry.record(board: board, delta: sign * blob.byte_size)
+      end
+    end
+
+    def storage_board
+      if record_type == "Card" && name == "image"
+        record&.board
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        case rich_text_record = record&.record
+        when Board then rich_text_record
+        when Card, Comment then rich_text_record.board
+        end
+      end
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageAttachmentStorageTracking
+end
