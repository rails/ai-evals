--- /dev/null
+++ b/test/models/storage/tracking_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class Storage::TrackingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "card images count towards the board and the account" do
+    assert_storage_change board: +moon_size, account: +moon_size do
+      @card.image.attach(moon_upload)
+    end
+  end
+
+  test "replacing and removing a card image" do
+    @card.image.attach(moon_upload)
+
+    assert_storage_change board: 0, account: 0 do
+      @card.image.attach(moon_upload)
+    end
+
+    assert_storage_change board: -moon_size, account: -moon_size do
+      @card.image.purge_later
+    end
+  end
+
+  test "files embedded in card descriptions, comments and board descriptions" do
+    assert_storage_change board: +3 * moon_size, account: +3 * moon_size do
+      @card.update!(description: embed(create_blob))
+      @card.comments.create!(body: embed(create_blob))
+      @board.update!(public_description: embed(create_blob))
+    end
+
+    assert_storage_change board: -moon_size, account: -moon_size do
+      @card.update!(description: "No more files")
+    end
+  end
+
+  test "keeping the same embeds doesn't change usage" do
+    blob = create_blob
+    @card.update!(description: embed(blob))
+
+    assert_storage_change board: 0, account: 0 do
+      @card.update!(description: embed(blob) + "<p>More text</p>")
+    end
+  end
+
+  test "destroying cards, comments and boards frees their storage" do
+    comment = @card.comments.create!(body: embed(create_blob))
+    @card.image.attach(moon_upload)
+
+    assert_storage_change board: -moon_size, account: -moon_size do
+      comment.destroy!
+    end
+
+    assert_storage_change board: -moon_size, account: -moon_size do
+      @card.destroy!
+    end
+
+    @card = cards(:layout)
+    @card.image.attach(moon_upload)
+    assert_difference -> { @account.reload.bytes_used }, -moon_size do
+      @board.destroy!
+    end
+  end
+
+  test "moving a card moves its usage between boards" do
+    @card.image.attach(moon_upload)
+    @card.comments.create!(body: embed(create_blob))
+
+    assert_changes -> { @other_board.bytes_used }, from: 0, to: 2 * moon_size do
+      assert_storage_change board: -2 * moon_size, account: 0 do
+        @card.move_to(@other_board)
+      end
+    end
+  end
+
+  test "untracked attachments don't count" do
+    assert_storage_change board: 0, account: 0 do
+      users(:david).avatar.attach(moon_upload)
+    end
+  end
+
+  test "materializing folds settled entries without changing usage" do
+    @card.image.attach(moon_upload)
+    @board.reconcile_storage
+
+    travel_to 2.minutes.from_now do
+      @card.comments.create!(body: embed(create_blob))
+    end
+
+    travel_to 4.minutes.from_now do
+      assert_no_changes -> { @board.reload.bytes_used } do
+        @board.materialize_storage
+      end
+      assert_equal 2 * moon_size, @board.storage_total.reload.bytes_stored
+
+      @card.update!(description: embed(create_blob))
+      assert_no_changes -> { @board.reload.bytes_used } do
+        @board.materialize_storage
+      end
+      assert_equal 2 * moon_size, @board.storage_total.reload.bytes_stored, "unsettled entries stay pending"
+      assert_equal 3 * moon_size, @board.bytes_used
+    end
+  end
+
+  test "reconciling recalculates usage from scratch" do
+    @card.image.attach(moon_upload)
+    Storage::Entry.delete_all
+
+    assert_equal 0, @board.bytes_used
+
+    @board.reconcile_storage
+    @account.reconcile_storage
+
+    assert_equal moon_size, @board.reload.bytes_used
+    assert_equal moon_size, @account.reload.bytes_used
+
+    @card.comments.create!(body: embed(create_blob))
+    assert_equal 2 * moon_size, @board.reload.bytes_used
+
+    @account.reconcile_storage
+    assert_equal 2 * moon_size, @account.reload.bytes_used
+  end
+
+  test "entries schedule materialization of totals" do
+    assert_enqueued_with job: Storage::MaterializeJob, args: [ @board ] do
+      @card.image.attach(moon_upload)
+    end
+
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert @board.reload.storage_total
+    assert_equal moon_size, @board.bytes_used
+    assert_equal moon_size, @account.reload.bytes_used
+  end
+
+  test "destroying the account removes storage records" do
+    @card.image.attach(moon_upload)
+    @account.reconcile_storage
+
+    @account.destroy!
+
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Storage::Total.where(account_id: @account.id)
+  end
+
+  private
+    def assert_storage_change(board: 0, account: 0, &block)
+      assert_difference -> { @board.reload.bytes_used }, board do
+        assert_difference -> { @account.reload.bytes_used }, account, &block
+      end
+    end
+
+    def moon_upload
+      { io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg" }
+    end
+
+    def moon_size
+      file_fixture("moon.jpg").size
+    end
+
+    def create_blob
+      ActiveStorage::Blob.create_and_upload!(**moon_upload)
+    end
+
+    def embed(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
