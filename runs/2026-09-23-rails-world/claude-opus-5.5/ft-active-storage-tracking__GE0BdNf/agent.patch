+  extend ActiveSupport::Concern
+
+  included do
+    after_update :transfer_storage_usage, if: :saved_change_to_board_id?
+  end
+
+  private
+    def transfer_storage_usage
+      bytes = Storage::Usage.new(cards: Card.where(id: id)).bytes
+
+      if bytes.nonzero? && old_board = Board.find_by(id: board_id_before_last_save)
+        Storage::Entry.record(board: old_board, delta: -bytes)
+        Storage::Entry.record(board: board, delta: bytes)
+      end
+    end
+end
diff --git a/app/models/storage.rb b/app/models/storage.rb
new file mode 100644
index 0000000..111a20e
--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,16 @@
+# Tracks the bytes used by card images and by files embedded in board descriptions,
+# card descriptions and comments, per board and per account.
+#
+# Every change is appended to a ledger (Storage::Entry) in the same transaction as the
+# attachment change, so writers never contend on a shared counter row. Totals
+# (Storage::Total) are folded from the ledger in the background, and reads add whatever
+# entries haven't been folded yet, so they're always up to date and always cheap.
+module Storage
+  # Entries younger than this might still have concurrent, uncommitted siblings with
+  # lower ids, so they're left pending (and summed on read) rather than folded into a total.
+  SETTLE_PERIOD = 1.minute
+
+  def self.table_name_prefix
+    "storage_"
+  end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..3eeead3
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,23 @@
+class Storage::Entry < ApplicationRecord
+  belongs_to :account
+  belongs_to :board
+
+  scope :after, ->(entry_id) { entry_id ? where(arel_table[:id].gt(entry_id)) : all }
+  scope :up_to, ->(entry_id) { where(arel_table[:id].lteq(entry_id)) }
+  scope :settled, -> { where(created_at: ..Storage::SETTLE_PERIOD.ago) }
+
+  after_create_commit :materialize_totals_later
+
+  class << self
+    def record(board:, delta:)
+      create!(account: board.account, board: board, delta: delta) unless delta.zero?
+    end
+  end
+
+  private
+    def materialize_totals_later
+      [ account, board ].each do |owner|
+        Storage::MaterializeJob.set(wait: Storage::SETTLE_PERIOD).perform_later(owner) unless owner.destroyed?
+      end
+    end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..3656439
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,40 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  def current_usage
+    bytes_stored + pending_entries.sum(:delta)
+  end
+
+  # Folds settled ledger entries into the stored total.
+  def materialize
+    with_lock do
+      if last_settled_entry_id = pending_entries.settled.maximum(:id)
+        update! \
+          bytes_stored: bytes_stored + pending_entries.up_to(last_settled_entry_id).sum(:delta),
+          last_entry_id: last_settled_entry_id
+      end
+    end
+  end
+
+  # Recalculates the stored total from scratch, correcting any drift.
+  def reconcile
+    with_lock do
+      last_settled_entry_id = entries.settled.maximum(:id)
+      unsettled_bytes = entries.after(last_settled_entry_id).sum(:delta)
+
+      update! \
+        bytes_stored: Storage::Usage.new(**owner.storage_scopes).bytes - unsettled_bytes,
+        last_entry_id: last_settled_entry_id
+    end
+  end
+
+  private
+    def pending_entries
+      entries.after(last_entry_id)
+    end
+
+    def entries
+      owner.storage_entries
+    end
+end
diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
new file mode 100644
index 0000000..5c8a4bc
--- /dev/null
+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,40 @@
+# Storage usage for owners of tracked attachments (accounts and boards).
+#
+# Including models must define:
+#
+# * +storage_entries+: the ledger entries affecting the owner.
+# * +storage_scopes+: the boards and cards whose attachments the owner is charged for.
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, class_name: "Storage::Total", as: :owner, dependent: :delete
+  end
+
+  def bytes_used
+    (storage_total || Storage::Total.new(owner: self)).current_usage
+  end
+
+  def materialize_storage
+    if storage_total
+      storage_total.materialize
+    else
+      reconcile_storage
+    end
+  end
+
+  def reconcile_storage
+    (storage_total || create_storage_total!).reconcile
+  rescue ActiveRecord::RecordNotUnique
+    reload_storage_total.reconcile
+  end
+
+  def reconcile_storage_later
+    Storage::ReconcileJob.perform_later(self)
+  end
+
+  private
+    def create_storage_total!
+      Storage::Total.create!(owner: self, account: account)
+    end
+end
diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..39d62ec
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,36 @@
+# Calculates, from scratch, the bytes used by the card images and the files embedded in
+# the rich texts of the given boards and cards (including the cards' comments).
+class Storage::Usage
+  attr_reader :boards, :cards
+
+  def initialize(boards: Board.none, cards: Card.none)
+    @boards, @cards = boards, cards
+  end
+
+  def bytes
+    total_bytes(card_images) + total_bytes(embeds)
+  end
+
+  private
+    def total_bytes(attachments)
+      attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+
+    def card_images
+      ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: cards.select(:id))
+    end
+
+    def embeds
+      ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_texts.select(:id))
+    end
+
+    def rich_texts
+      ActionText::RichText.where(record_type: "Board", name: "public_description", record_id: boards.select(:id))
+        .or(ActionText::RichText.where(record_type: "Card", name: "description", record_id: cards.select(:id)))
+        .or(ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comments.select(:id)))
+    end
+
+    def comments
+      Comment.where(card_id: cards.select(:id))
+    end
+end
