+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <%= tag.button emoji, type: "button", class: "btn btn--plain", title: name, aria: { label: name },
+                  data: { action: "reaction-form#pick", reaction_form_content_param: emoji } %>
