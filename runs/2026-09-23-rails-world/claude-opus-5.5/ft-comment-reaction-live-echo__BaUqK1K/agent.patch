new file mode 100644
index 0000000..8727e30
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  include ActionCable::TestHelper, Turbo::Broadcastable::TestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    Current.account = accounts("37s")
+  end
+
+  test "content is limited to 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert comment.reactions.build(content: "a" * 16).valid?
+    assert_not comment.reactions.build(content: "a" * 17).valid?
+    assert_not comment.reactions.build(content: "   ").valid?
+  end
+
+  test "content is squished" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "  so   good  ")
+
+    assert_equal "so good", reaction.content
+  end
+
+  test "defaults reacter and account" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "🎉")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal comments(:logo_agreement_jz).account, reaction.account
+  end
+
+  test "emoji only" do
+    assert Reaction.new(content: "👍").emoji_only?
+    assert Reaction.new(content: "❤️🔥").emoji_only?
+    assert Reaction.new(content: "👍🏽").emoji_only?
+    assert Reaction.new(content: "👨‍👩‍👧").emoji_only?
+    assert_not Reaction.new(content: "Nice 👍").emoji_only?
+    assert_not Reaction.new(content: "123").emoji_only?
+    assert_not Reaction.new(content: "#").emoji_only?
+  end
+
+  test "reacting touches the comment and registers card activity" do
+    comment = comments(:logo_agreement_jz)
+
+    travel_to 1.minute.from_now do
+      assert_changes -> { comment.reload.updated_at } do
+        assert_changes -> { comment.card.reload.last_active_at } do
+          comment.reactions.create!(content: "👀")
+        end
+      end
+    end
+  end
+
+  test "broadcasts additions to the card" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "🔥")
+    perform_enqueued_jobs
+
+    append = capture_turbo_stream_broadcasts(comment.card).find { it["action"] == "append" }
+    assert_equal ActionView::RecordIdentifier.dom_id(comment, :reactions_list), append["target"]
+    assert_includes append.to_html, ActionView::RecordIdentifier.dom_id(reaction)
+    assert_includes append.to_html, "🔥"
+    assert_includes append.to_html, %(action="#{accounts("37s").slug}/cards/#{comment.card.number}/comments/#{comment.id}/reactions/#{reaction.id}")
+  end
+
+  test "broadcasts removals to the card" do
+    reaction = reactions(:kevin)
+
+    reaction.destroy
+
+    remove = capture_turbo_stream_broadcasts(reaction.card).find { it["action"] == "remove" }
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), remove["target"]
+  end
+
+  test "deleting a comment deletes its reactions" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { Reaction.count }, -2 do
+      comment.destroy
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..dda5e06
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,139 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "adding a reaction" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Ship it!"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Ship it!"
+      assert_no_selector "input"
+      assert_selector "a.reactions__trigger"
+    end
+
+    assert @comment.reactions.exists?(content: "Ship it!", reacter: users(:david))
+  end
+
+  test "adding an emoji reaction from the picker" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      click_on "Party popper"
+
+      assert_selector ".reaction", text: "🎉"
+      assert_no_selector "input"
+    end
+  end
+
+  test "canceling brings the button back" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      assert_selector "input"
+      click_on "Cancel"
+
+      assert_no_selector "input"
+      assert_selector "a.reactions__trigger"
+    end
+  end
+
+  test "removing your own reaction" do
+    reaction = reactions(:david)
+    visit card_url(@card)
+
+    within_reactions do
+      assert_no_button "Remove your reaction"
+
+      find(".reaction", text: "Nice work!").click
+      click_on "Remove your reaction"
+
+      assert_no_selector ".reaction", text: "Nice work!"
+      assert_selector ".reaction", text: "👍"
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "others' reactions can't be removed" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reaction", text: "👍").click
+      assert_no_button "Remove your reaction"
+      assert_no_selector ".reaction--deleteable", text: "👍"
+      assert_selector ".reaction--deleteable", text: "Nice work!"
+    end
+  end
+
+  test "reactions from others land without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    react_elsewhere_as users(:jz), with: "🚀"
+
+    within_reactions do
+      assert_selector ".reaction", text: "🚀", wait: 5
+      assert_selector ".reaction", count: 3
+    end
+  end
+
+  test "a reaction in progress survives reactions from others" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Half typed"
+    end
+    count_morphs
+
+    react_elsewhere_as users(:jz), with: "🚀"
+
+    within_reactions do
+      assert_selector ".reaction", text: "🚀", wait: 5
+      assert_morphed
+      assert_field "Your reaction", with: "Half typed"
+      assert_selector ".reaction--deleteable", text: "Nice work!"
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def react_elsewhere_as(user, with:)
+      Current.set(user: user, account: user.account) do
+        @comment.reactions.create!(content: with)
+      end
+      perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+    end
+
+    def count_morphs
+      page.execute_script("window.morphs = 0; addEventListener('turbo:morph', () => window.morphs++)")
+    end
+
+    def assert_morphed
+      Timeout.timeout(5) { sleep 0.1 until page.evaluate_script("window.morphs").positive? }
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
