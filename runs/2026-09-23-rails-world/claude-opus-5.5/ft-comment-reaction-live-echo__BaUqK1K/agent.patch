+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "index" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 2
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a[href=?]", new_card_comment_reaction_path(@card, @comment)
+  end
+
+  test "new" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} form[action=?]", card_comment_reactions_path(@card, @comment) do
+      assert_select "input[name='reaction[content]'][maxlength='16']"
+      assert_select ".reaction__submit-btn"
+      assert_select ".reaction__cancel-btn[href=?]", card_comment_reactions_path(@card, @comment)
+    end
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal "Great 👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions_list) do
+      assert_select "##{dom_id(reaction)}", text: /Great 👍/
+    end
+    assert_turbo_stream action: :update, target: dom_id(@comment, :new_reaction) do
+      assert_select "a.reactions__trigger[href=?]", new_card_comment_reaction_path(@card, @comment)
+      assert_select "input", count: 0
+    end
+  end
+
+  test "create rejects content longer than 16 characters" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction" do
+    reaction = reactions(:kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "cannot destroy someone else's reaction" do
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reactions(:david)), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot react to comments on inaccessible cards" do
+    @card.board.update!(all_access: false)
+    @card.board.accesses.where(user: users(:kevin)).destroy_all
+
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+
+    assert_response :not_found
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ "👍", "Nice work!" ], @response.parsed_body.pluck("content")
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reactions(:kevin)), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "🎉" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🎉", @comment.reactions.last.content
+  end
+
+  test "destroy as JSON" do
+    delete card_comment_reaction_path(@card, @comment, reactions(:kevin)), as: :json
+
+    assert_response :no_content
+  end
+
+  test "comments render their reactions strip" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment)} .reactions" do
+      assert_select ".reaction[data-reaction-reacter-id-value=?]", users(:kevin).id do
+        assert_select ".reaction__avatar"
+        assert_select ".reaction__content.txt-small.txt-medium", text: "👍"
+        assert_select ".reaction__delete"
+      end
+      assert_select ".reaction__content", text: "Nice work!"
+      assert_select "a.reactions__trigger img[src*='boost-color']"
+    end
+    assert_select "##{dom_id(comments(:logo_1))} .reactions", count: 0
+  end
+end
