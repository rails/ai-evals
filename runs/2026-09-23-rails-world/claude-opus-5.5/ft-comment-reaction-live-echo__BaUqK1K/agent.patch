diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..3d8b9c2
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,33 @@
+class Reaction < ApplicationRecord
+  include Broadcastable
+
+  CONTENT_MAX_LENGTH = 16
+  EMOJI_ONLY = /\A(?:\p{Extended_Pictographic}|\p{Emoji_Modifier}|\p{Regional_Indicator}|[\u{200D}\u{FE0F}\u{20E3}\u{E0020}-\u{E007F}])+\z/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :ordered, -> { order(:created_at, :id) }
+
+  normalizes :content, with: -> { it.squish }
+
+  validates :content, presence: true, length: { maximum: CONTENT_MAX_LENGTH }
+
+  after_create :register_card_activity
+
+  delegate :card, to: :comment
+
+  def emoji_only?
+    content.match?(EMOJI_ONLY)
+  end
+
+  def reacted_by?(user)
+    reacter == user
+  end
+
+  private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
