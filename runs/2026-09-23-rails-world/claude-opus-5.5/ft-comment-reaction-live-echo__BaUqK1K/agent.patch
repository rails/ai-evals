diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..aa193bf
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,51 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.includes(:reacter)
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :created, location: card_comment_reactions_url(@card, @comment, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden unless @reaction.reacted_by?(Current.user)
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..4bca4d5
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,55 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  #expanded = false
+
+  connect() {
+    this.restore()
+  }
+
+  // Morphing resets the element to the server-rendered (user-agnostic) markup, so reapply our state
+  restore() {
+    if (this.#isOwnReaction) {
+      this.element.classList.add(this.deleteableClass)
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("role", "button")
+      this.#render()
+    }
+  }
+
+  toggle(event) {
+    if (!this.#isOwnReaction || event.target.closest("form")) return
+
+    event.preventDefault()
+    this.#expanded = !this.#expanded
+    this.#render()
+  }
+
+  collapse() {
+    this.#expanded = false
+    this.#render()
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (this.#expanded && !this.element.contains(target)) this.collapse()
+  }
+
+  markDeleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  #render() {
+    if (!this.#isOwnReaction) return
+
+    this.element.classList.toggle(this.expandedClass, this.#expanded)
+    this.element.setAttribute("aria-expanded", this.#expanded)
+  }
+
+  get #isOwnReaction() {
+    return this.reacterIdValue === getMetaContent("current-user-id")
+  }
+}
