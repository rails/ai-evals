+++ b/app/jobs/storage/materialize_all_job.rb
@@ -0,0 +1,7 @@
+# Safety net for entries whose materialization job was skipped (e.g. discarded
+# while another job for the same owner was finishing up).
+class Storage::MaterializeAllJob < ApplicationJob
+  def perform
+    Storage.materialize_all_later
+  end
+end
diff --git a/app/jobs/storage/materialize_job.rb b/app/jobs/storage/materialize_job.rb
new file mode 100644
index 0000000..c7cc84e
--- /dev/null
+++ b/app/jobs/storage/materialize_job.rb
@@ -0,0 +1,11 @@
+class Storage::MaterializeJob < ApplicationJob
+  # A job that is already enqueued or running for the same owner will pick up any
+  # new entries, so there's no need to pile up more of them for busy owners.
+  limits_concurrency key: ->(owner) { owner }, on_conflict: :discard
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(owner)
+    owner.materialize_storage
+  end
+end
