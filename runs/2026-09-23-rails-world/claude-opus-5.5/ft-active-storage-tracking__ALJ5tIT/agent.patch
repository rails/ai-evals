+require "test_helper"
+
+class Storage::TrackedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @account = @board.account
+    @card = cards(:logo)
+  end
+
+  test "card images count towards the board and account" do
+    blob = create_blob
+
+    @card.image.attach(blob)
+    assert_bytes_used blob.byte_size, @board, @account
+
+    @card.image.purge
+    assert_bytes_used 0, @board, @account
+  end
+
+  test "replacing a card image only counts the new one" do
+    @card.image.attach(create_blob(size: 100))
+    @card.image.attach(create_blob(size: 30))
+
+    assert_bytes_used 30, @board, @account
+  end
+
+  test "files embedded in board descriptions, card descriptions, and comments count" do
+    @board.update!(public_description: embed(create_blob(size: 10)))
+    @card.update!(description: embed(create_blob(size: 20)))
+    @card.comments.create!(body: embed(create_blob(size: 40)))
+
+    assert_bytes_used 70, @board, @account
+  end
+
+  test "removing an embed from a description stops counting it" do
+    @card.update!(description: embed(create_blob(size: 20)))
+    @card.update!(description: "No more files")
+
+    assert_bytes_used 0, @board, @account
+  end
+
+  test "destroying comments, cards, and boards stops counting their files" do
+    @board.update!(public_description: embed(create_blob(size: 10)))
+    @card.image.attach(create_blob(size: 20))
+    comment = @card.comments.create!(body: embed(create_blob(size: 40)))
+
+    comment.destroy!
+    assert_bytes_used 30, @board, @account
+
+    @card.destroy!
+    assert_bytes_used 10, @board, @account
+
+    @board.destroy!
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.where(owner: @board)
+    assert_empty Storage::Total.where(owner: @board)
+  end
+
+  test "moving a card moves its usage to the new board" do
+    other_board = boards(:private)
+    @card.image.attach(create_blob(size: 20))
+    @card.comments.create!(body: embed(create_blob(size: 40)))
+
+    @card.move_to(other_board)
+
+    assert_bytes_used 0, @board
+    assert_bytes_used 60, other_board, @account
+  end
+
+  test "other attachments don't count" do
+    users(:david).avatar.attach(create_blob(size: 50))
+
+    assert_bytes_used 0, @account
+  end
+
+  test "usage is up to date before the background materialization runs" do
+    @card.image.attach(create_blob(size: 20))
+
+    assert_equal 20, @board.bytes_used
+    assert_equal 20, @account.bytes_used
+    assert Storage::Entry.where(owner: @board).exists?
+  end
+
+  test "changes are materialized in the background" do
+    assert_enqueued_with job: Storage::MaterializeJob, args: [ @board ] do
+      @card.image.attach(create_blob(size: 20))
+    end
+
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_empty Storage::Entry.all
+    assert_equal 20, Storage::Total.find_by!(owner: @board).bytes
+    assert_equal 20, Storage::Total.find_by!(owner: @account).bytes
+  end
+
+  private
+    def assert_bytes_used(expected, *owners)
+      perform_enqueued_jobs only: Storage::MaterializeJob
+
+      owners.each do |owner|
+        assert_equal expected, owner.bytes_used, "Expected #{owner.class.name} to use #{expected} bytes"
+      end
+    end
+
+    def create_blob(size: 1234)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * size), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
