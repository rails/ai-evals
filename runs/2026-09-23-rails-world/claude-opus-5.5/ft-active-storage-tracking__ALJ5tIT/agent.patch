diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
new file mode 100644
index 0000000..63d0165
--- /dev/null
+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,84 @@
+# Gives an Account or Board a #bytes_used figure, backed by a materialized
+# Storage::Total plus whatever Storage::Entry deltas are still pending.
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  MATERIALIZATION_BATCH_SIZE = 1_000
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total"
+    has_many :storage_entries, as: :owner, class_name: "Storage::Entry"
+
+    after_destroy :delete_storage_records
+  end
+
+  # Read in a single statement so that a concurrent materialization, which moves bytes
+  # from pending entries into the total, can't make us count them twice or not at all.
+  def bytes_used
+    total = Storage::Total.where(owner: self).select(:bytes)
+    pending = Storage::Entry.where(owner: self).select(Arel.sql("SUM(delta)"))
+
+    Storage::Total.with_connection do |connection|
+      connection.select_value("SELECT COALESCE((#{total.to_sql}), 0) + COALESCE((#{pending.to_sql}), 0)").to_i
+    end
+  end
+
+  def materialize_storage_later
+    Storage::MaterializeJob.perform_later(self)
+  end
+
+  def materialize_storage
+    total = find_or_create_storage_total
+
+    loop do
+      break unless materialize_storage_batch(total)
+    end
+  end
+
+  def recalculate_storage_later
+    Storage::RecalculateJob.perform_later(self)
+  end
+
+  # Recomputes the total from scratch. Meant for backfills and for data that bypasses
+  # callbacks (like imports), not for routine updates.
+  def recalculate_storage
+    total = find_or_create_storage_total
+
+    Storage::Total.transaction do
+      total.lock!
+
+      # Both reads below share the same transaction snapshot, so the discarded entries
+      # are exactly those whose attachments are reflected in the recalculated bytes.
+      entry_ids = Storage::Entry.where(owner: self).pluck(:id)
+      bytes = Storage::Attachments.byte_size(storage_attachments)
+
+      entry_ids.each_slice(MATERIALIZATION_BATCH_SIZE) { |ids| Storage::Entry.where(id: ids).delete_all }
+      total.update!(bytes: bytes)
+    end
+  end
+
+  private
+    def find_or_create_storage_total
+      Storage::Total.create_or_find_by!(owner: self) { it.account = account }
+    end
+
+    def materialize_storage_batch(total)
+      Storage::Total.transaction do
+        total.lock!
+
+        entries = Storage::Entry.where(owner: self).order(:id).limit(MATERIALIZATION_BATCH_SIZE).pluck(:id, :delta)
+
+        if entries.any?
+          Storage::Entry.where(id: entries.map(&:first)).delete_all
+          total.update!(bytes: total.bytes + entries.sum(&:last))
+        end
+
+        entries.size == MATERIALIZATION_BATCH_SIZE
+      end
+    end
+
+    def delete_storage_records
+      Storage::Entry.where(owner: self).delete_all
+      Storage::Total.where(owner: self).delete_all
+    end
+end
diff --git a/app/models/storage/tracked.rb b/app/models/storage/tracked.rb
new file mode 100644
index 0000000..fd5eb98
--- /dev/null
+++ b/app/models/storage/tracked.rb
@@ -0,0 +1,42 @@
+# Included into ActiveStorage::Attachment to record storage deltas for the
+# attachments that count towards usage. Entries are written in the same
+# transaction as the attachment change so the ledger can't drift from it.
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  included do
+    after_create  -> { record_storage_change(+1) }
+    after_destroy -> { record_storage_change(-1) }
+  end
+
+  # Active Storage deletes attachments without callbacks when purging or detaching them.
+  def delete
+    transaction do
+      record_storage_change(-1) if persisted?
+      super
+    end
+  end
+
+  private
+    def record_storage_change(direction)
+      if blob && (board = storage_board)
+        Storage::Entry.record(board: board, delta: direction * blob.byte_size)
+      end
+    end
+
+    def storage_board
+      case record
+      when Card
+        record.board if name == "image"
+      when ActionText::RichText
+        board_for_rich_text_record(record.record) if name == "embeds"
+      end
+    end
+
+    def board_for_rich_text_record(rich_text_record)
+      case rich_text_record
+      when Board then rich_text_record
+      when Card, Comment then rich_text_record.board
+      end
+    end
+end
