+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @account = @board.account
+  end
+
+  test "bytes used is zero without any tracked files" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "bytes used combines the materialized total with pending entries" do
+    Storage::Total.create!(owner: @board, account: @account, bytes: 100)
+    Storage::Entry.record_for(@board, delta: 20)
+    Storage::Entry.record_for(@board, delta: -5)
+
+    assert_equal 115, @board.bytes_used
+  end
+
+  test "materializing folds pending entries into the total in batches" do
+    Storage::Total.create!(owner: @board, account: @account, bytes: 100)
+    3.times { Storage::Entry.record_for(@board, delta: 10) }
+
+    stub_const(Storage::Totaled, :MATERIALIZATION_BATCH_SIZE, 2) do
+      @board.materialize_storage
+    end
+
+    assert_empty Storage::Entry.where(owner: @board)
+    assert_equal 130, Storage::Total.find_by!(owner: @board).bytes
+    assert_equal 130, @board.bytes_used
+  end
+
+  test "materializing only touches the owner's own entries" do
+    Storage::Entry.record(board: @board, delta: 10)
+
+    @board.materialize_storage
+
+    assert_empty Storage::Entry.where(owner: @board)
+    assert_equal 1, Storage::Entry.where(owner: @account).count
+    assert_equal 10, @account.bytes_used
+  end
+
+  test "recalculating rebuilds the total from the tracked files" do
+    card = cards(:logo)
+    card.image.attach(create_blob(size: 20))
+    card.comments.create!(body: embed(create_blob(size: 40)))
+    @board.update!(public_description: embed(create_blob(size: 10)))
+    Storage::Entry.record(board: @board, delta: 999)
+
+    @board.recalculate_storage
+    @account.recalculate_storage
+
+    assert_empty Storage::Entry.all
+    assert_equal 70, @board.bytes_used
+    assert_equal 70, @account.bytes_used
+  end
+
+  test "destroying an account cleans up its storage records" do
+    cards(:logo).image.attach(create_blob(size: 20))
+    @account.materialize_storage
+
+    @account.destroy!
+
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Storage::Total.where(account_id: @account.id)
+  end
+
+  test "materializing everything pending" do
+    Storage::Entry.record(board: @board, delta: 10)
+
+    assert_enqueued_jobs 2, only: Storage::MaterializeJob do
+      Storage.materialize_all_later
+    end
+  end
+
+  private
+    def create_blob(size:)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * size), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
