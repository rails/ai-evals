@@ -0,0 +1,19 @@
+# Moves a card's storage usage along with it when it changes boards.
+module Card::StorageTransferable
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :transfer_storage_usage, if: :saved_change_to_board_id?
+  end
+
+  private
+    def transfer_storage_usage
+      bytes = Storage::Attachments.byte_size(Storage::Attachments.for_cards(Card.where(id: id)))
+
+      if old_board = Board.find_by(id: board_id_before_last_save)
+        Storage::Entry.record_for(old_board, delta: -bytes)
+      end
+
+      Storage::Entry.record_for(board, delta: bytes)
+    end
+end
diff --git a/app/models/storage.rb b/app/models/storage.rb
new file mode 100644
index 0000000..0d521ab
--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,18 @@
+# Storage usage is tracked with an insert-only ledger of byte deltas (Storage::Entry)
+# that background jobs periodically fold into a materialized total (Storage::Total)
+# for each owner (Account or Board).
+#
+# Recording a change never updates a shared row, so busy accounts with many active
+# users don't contend on locks, and materializing only touches pending entries, so
+# the cost doesn't grow with the number of stored attachments.
+module Storage
+  def self.table_name_prefix
+    "storage_"
+  end
+
+  def self.materialize_all_later
+    Storage::Entry.pending_owners.each do |owner|
+      Current.with_account(owner.account) { owner.materialize_storage_later }
+    end
+  end
+end
diff --git a/app/models/storage/attachments.rb b/app/models/storage/attachments.rb
new file mode 100644
index 0000000..90e3f1f
--- /dev/null
+++ b/app/models/storage/attachments.rb
@@ -0,0 +1,45 @@
+# Queries for the attachments that count towards storage usage: card images and
+# files embedded in board descriptions, card descriptions, and comments.
+module Storage::Attachments
+  extend self
+
+  def for_account(account)
+    ActiveStorage::Attachment.where(account_id: account.id).and(
+      card_images(Card.where(account: account)).or(embeds(rich_texts_for_account(account)))
+    )
+  end
+
+  def for_board(board)
+    for_cards(board.cards).or(embeds(ActionText::RichText.where(record: board, name: "public_description")))
+  end
+
+  def for_cards(cards)
+    card_images(cards).or(embeds(rich_texts_for_cards(cards)))
+  end
+
+  def byte_size(attachments)
+    attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+  end
+
+  private
+    def card_images(cards)
+      ActiveStorage::Attachment.where(record_type: "Card", record_id: cards.select(:id), name: "image")
+    end
+
+    def embeds(rich_texts)
+      ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id), name: "embeds")
+    end
+
+    def rich_texts_for_account(account)
+      ActionText::RichText.where(account_id: account.id).and(
+        ActionText::RichText.where(record_type: "Board", name: "public_description")
+          .or(ActionText::RichText.where(record_type: "Card", name: "description"))
+          .or(ActionText::RichText.where(record_type: "Comment", name: "body"))
+      )
+    end
+
+    def rich_texts_for_cards(cards)
+      ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description")
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards.select(:id)).select(:id), name: "body"))
+    end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..ff0186d
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,31 @@
+class Storage::Entry < ApplicationRecord
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  after_create_commit :materialize_owner_storage_later
+
+  class << self
+    def record(board:, delta:)
+      [ board, board.account ].each do |owner|
+        record_for(owner, delta: delta)
+      end
+    end
+
+    def record_for(owner, delta:)
+      unless delta.zero?
+        create!(account: owner.account, owner: owner, delta: delta)
+      end
+    end
+
+    def pending_owners
+      distinct.pluck(:owner_type, :owner_id).filter_map do |owner_type, owner_id|
+        owner_type.constantize.find_by(id: owner_id)
+      end
+    end
+  end
+
+  private
+    def materialize_owner_storage_later
+      Storage::MaterializeJob.perform_later(owner)
+    end
+end
