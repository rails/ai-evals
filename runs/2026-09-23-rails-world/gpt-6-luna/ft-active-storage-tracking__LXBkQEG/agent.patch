@@ -0,0 +1,13 @@
+class Account::RefreshBytesUsedJob < ApplicationJob
+  def perform(account_id)
+    Account.transaction do
+      account = Account.lock.find_by(id: account_id)
+      if account
+        account.update_columns(
+          bytes_used: StorageUsage.bytes_used(account_id: account_id),
+          bytes_used_calculation_pending: false
+        )
+      end
+    end
+  end
+end
