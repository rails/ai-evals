diff --git a/app/models/concerns/storage_usage/attachment_tracking.rb b/app/models/concerns/storage_usage/attachment_tracking.rb
new file mode 100644
index 0000000..59b3655
--- /dev/null
+++ b/app/models/concerns/storage_usage/attachment_tracking.rb
@@ -0,0 +1,16 @@
+module StorageUsage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :refresh_storage_usage_later
+    after_destroy_commit :refresh_storage_usage_later
+  end
+
+  private
+    def refresh_storage_usage_later
+      return unless (record_type == Card.name && name == "image") ||
+        (record_type == ActionText::RichText.name && name == "embeds")
+
+      StorageUsage.refresh_later(account_id: account_id, board_id: StorageUsage.board_id_for(self))
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..6851413
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,59 @@
+module StorageUsage
+  class << self
+    def refresh_later(account_id:, board_id: nil)
+      if Account.where(id: account_id, bytes_used_calculation_pending: false)
+          .update_all(bytes_used_calculation_pending: true) > 0
+        Account::RefreshBytesUsedJob.perform_later(account_id)
+      end
+
+      if board_id && Board.where(id: board_id, bytes_used_calculation_pending: false)
+          .update_all(bytes_used_calculation_pending: true) > 0
+        Board::RefreshBytesUsedJob.perform_later(board_id)
+      end
+    end
+
+    def bytes_used(account_id:, board_id: nil)
+      boards = Board.where(account_id: account_id)
+      boards = boards.where(id: board_id) if board_id
+      cards = Card.where(account_id: account_id, board_id: boards.select(:id))
+      comments = Comment.where(account_id: account_id, card_id: cards.select(:id))
+
+      rich_text_sql = [
+        rich_texts_for(Board.name, "public_description", boards),
+        rich_texts_for(Card.name, "description", cards),
+        rich_texts_for(Comment.name, "body", comments)
+      ].join(" UNION ")
+
+      image_blobs = ActiveStorage::Attachment.where(
+        account_id: account_id, record_type: Card.name, name: "image", record_id: cards.select(:id)
+      ).select(:blob_id).to_sql
+
+      embed_blobs = ActiveStorage::Attachment.where(
+        account_id: account_id, record_type: ActionText::RichText.name, name: "embeds"
+      ).where("record_id IN (#{rich_text_sql})").select(:blob_id).to_sql
+
+      ActiveStorage::Blob.where(account_id: account_id)
+        .where("id IN (#{image_blobs} UNION #{embed_blobs})")
+        .sum(:byte_size)
+    end
+
+    def board_id_for(attachment)
+      if attachment.record_type == Card.name && attachment.name == "image"
+        Card.where(id: attachment.record_id).pick(:board_id)
+      elsif attachment.record_type == ActionText::RichText.name && attachment.name == "embeds"
+        rich_text = ActionText::RichText.find_by(id: attachment.record_id)
+        record = rich_text&.record
+        case record
+        when Board then record.id
+        when Card then record.board_id
+        when Comment then record.card.board_id
+        end
+      end
+    end
+
+    private
+      def rich_texts_for(record_type, name, records)
+        ActionText::RichText.where(record_type: record_type, name: name, record_id: records.select(:id)).select(:id).to_sql
+      end
+  end
+end
