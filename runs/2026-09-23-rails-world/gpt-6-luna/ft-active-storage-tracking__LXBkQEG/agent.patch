diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..4d2455c
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  test "counts images and embedded files on a board and throughout its account" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    account = board.account
+
+    image = blob(100)
+    board_file = blob(200)
+    description_file = blob(300)
+
+    card.image.attach(image)
+    board.public_description.body = ActionText::Content.new("").append_attachables(board_file)
+    board.save!
+    card.description.body = ActionText::Content.new("").append_attachables(description_file)
+    card.save!
+    comment = card.comments.create!(creator: users(:david), body: "A file in a comment")
+    comment.body.body = ActionText::Content.new("").append_attachables(blob(400))
+    comment.save!
+
+    assert_equal 1000, StorageUsage.bytes_used(account_id: account.id, board_id: board.id)
+    assert_equal 1000, StorageUsage.bytes_used(account_id: account.id)
+  end
+
+  test "does not count unrelated attachments and does not double count a shared blob" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    account = board.account
+    image = blob(128)
+    unrelated = blob(512)
+
+    card.image.attach(image)
+    card.description.body = ActionText::Content.new("").append_attachables(image)
+    card.save!
+    ActiveStorage::Attachment.create!(account: account, record: users(:david), name: "avatar", blob: unrelated)
+
+    assert_equal 128, StorageUsage.bytes_used(account_id: account.id, board_id: board.id)
+    assert_equal 128, StorageUsage.bytes_used(account_id: account.id)
+  end
+
+  test "moving a card refreshes usage on both boards" do
+    Current.session = sessions(:david)
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    account = old_board.account
+    card.image.attach(blob(64))
+    Board::RefreshBytesUsedJob.perform_now(old_board.id)
+
+    card.move_to(new_board)
+    Board::RefreshBytesUsedJob.perform_now(old_board.id)
+    Board::RefreshBytesUsedJob.perform_now(new_board.id)
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal 64, new_board.reload.bytes_used
+    Account::RefreshBytesUsedJob.perform_now(account.id)
+    assert_equal 64, account.reload.bytes_used
+  end
+
+  test "background jobs refresh board and account values" do
+    board = boards(:writebook)
+    account = board.account
+    card = cards(:logo)
+    card.image.attach(blob(256))
+
+    Board::RefreshBytesUsedJob.perform_now(board.id)
+    Account::RefreshBytesUsedJob.perform_now(account.id)
+
+    assert_equal 256, board.reload.bytes_used
+    assert_equal 256, account.reload.bytes_used
+    assert_not board.bytes_used_calculation_pending?
+    assert_not account.bytes_used_calculation_pending?
+  end
+
+  test "bytes_used coalesces initial refreshes until the cache is populated" do
+    account = accounts("37s")
+    account.update_columns(bytes_used: nil, bytes_used_calculation_pending: false)
+
+    assert_enqueued_jobs 1, only: Account::RefreshBytesUsedJob do
+      assert_equal 0, account.bytes_used
+      assert_equal 0, account.bytes_used
+    end
+  end
+
+  private
+    def blob(byte_size)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * byte_size),
+        filename: "usage-test.pdf",
+        content_type: "application/pdf",
+        identify: false
+      )
+    end
+end
