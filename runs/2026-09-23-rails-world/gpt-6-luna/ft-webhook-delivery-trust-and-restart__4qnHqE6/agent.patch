diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..7de43fb
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,23 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def record_failure
+    with_lock do
+      if first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+        update!(consecutive_failures_count: 1, first_failure_at: Time.current)
+      else
+        increment!(:consecutive_failures_count)
+      end
+
+      webhook.deactivate if consecutive_failures_count >= FAILURE_LIMIT
+    end
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..bfc658d 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -10,6 +10,23 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliverJob.perform_later(self)
+  end
+
+  def deliver_now
+    claimed = self.class.where(id:, state: :pending).update_all(state: :in_progress, updated_at: Time.current)
+
+    if claimed == 1
+      reload
+      perform_delivery
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +44,70 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def perform_delivery
+      body = payload.to_json
+      timestamp = Time.current.utc.iso8601(3)
+      signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      headers = {
+        "Content-Type" => "application/json",
+        "User-Agent" => "Fizzy Webhook",
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Delivery" => id
+      }
+
+      update!(request: { headers: })
+
+      uri = URI.parse(webhook.url)
+      http_request = Net::HTTP::Post.new(uri.request_uri, headers)
+      http_request.body = body
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+      http.write_timeout = 10 if http.respond_to?(:write_timeout=)
+      http_response = http.start { |connection| connection.request(http_request) }
+
+      status = http_response.code.to_i
+      update!(state: :completed, response: { code: status })
+
+      if status.between?(200, 299)
+        webhook.delinquency_tracker&.record_success
+      else
+        tracker.record_failure
+      end
+    rescue StandardError => error
+      update!(state: :errored, response: { error: error.class.name })
+      tracker.record_failure
+    end
+
+    def payload
+      {
+        id: event.id,
+        action: event.action,
+        created_at: event.created_at.utc.iso8601(3),
+        board: { id: event.board_id, name: event.board.name },
+        creator: { id: event.creator_id, name: event.creator.name },
+        eventable: { type: event.eventable_type, id: event.eventable_id, url: eventable_url }
+      }
+    end
+
+    def eventable_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+      base_options.merge(script_name: account.slug)
+    end
+
+    def tracker
+      webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+    end
 end
