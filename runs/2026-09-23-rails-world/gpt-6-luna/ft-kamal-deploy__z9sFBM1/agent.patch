+++ b/config/deploy.yml
@@ -0,0 +1,40 @@
+service: fizzy
+image: <%= ENV.fetch("KAMAL_REGISTRY_USERNAME") %>/fizzy
+asset_path: /rails/public/assets
+
+servers:
+  web:
+    - <%= ENV.fetch("FIZZY_SERVER_IP") %>
+
+proxy:
+  ssl: true
+  host: <%= ENV.fetch("FIZZY_HOST") %>
+
+# SQLite databases, Solid Queue data, and Active Storage uploads all live here.
+# Docker named volumes survive container replacement during deploys.
+volumes:
+  - fizzy-storage:/rails/storage
+
+registry:
+  username: <%= ENV.fetch("KAMAL_REGISTRY_USERNAME") %>
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    RAILS_ENV: production
+    FIZZY_HOST: <%= ENV.fetch("FIZZY_HOST") %>
+    MAILER_FROM_ADDRESS: <%= ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <no-reply@#{ENV.fetch('FIZZY_HOST')}>") %>
+    SMTP_ADDRESS: <%= ENV.fetch("SMTP_ADDRESS") %>
+    SMTP_PORT: <%= ENV.fetch("SMTP_PORT", "587") %>
+    SMTP_DOMAIN: <%= ENV.fetch("SMTP_DOMAIN", ENV.fetch("FIZZY_HOST")) %>
+    SMTP_AUTHENTICATION: <%= ENV.fetch("SMTP_AUTHENTICATION", "plain") %>
+    SMTP_ENABLE_STARTTLS_AUTO: <%= ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") %>
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
