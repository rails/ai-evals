diff --git a/test/helpers/local_time_helper_test.rb b/test/helpers/local_time_helper_test.rb
new file mode 100644
index 0000000..f9397b1
--- /dev/null
+++ b/test/helpers/local_time_helper_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class LocalTimeHelperTest < ActionView::TestCase
+  test "renders timestamp as raw UTC ISO data for browser formatting" do
+    timestamp = Time.utc(2025, 9, 12, 13, 42)
+
+    html = local_time_tag(timestamp)
+    time = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+    assert_equal "2025-09-12T13:42:00Z", time["datetime"]
+    assert_equal "2025-09-12T13:42:00Z", time.text
+    assert_equal "local-time", time["data-controller"]
+    assert_equal "smart", time["data-local-time-format-value"]
+  end
+
+  test "supports a format specific to future dates" do
+    html = local_time_tag(Time.utc(2025, 9, 12), format: "future")
+
+    assert_match 'data-local-time-format-value="future"', html
+  end
+end
