diff --git a/test/controllers/accounts/exports_controller_test.rb b/test/controllers/accounts/exports_controller_test.rb
new file mode 100644
index 0000000..a6577eb
--- /dev/null
+++ b/test/controllers/accounts/exports_controller_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "admin can start account export" do
+    sign_in_as :kevin
+
+    assert_enqueued_with(job: Account::ExportJob) do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "member cannot start account export" do
+    sign_in_as :david
+
+    post account_exports_path
+
+    assert_response :forbidden
+  end
+
+  test "expired download links are rejected without authentication" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin))
+    expired_token = export.signed_id(purpose: :download, expires_in: -1.second)
+
+    get account_export_download_path(token: expired_token)
+
+    assert_response :not_found
+  end
+end
