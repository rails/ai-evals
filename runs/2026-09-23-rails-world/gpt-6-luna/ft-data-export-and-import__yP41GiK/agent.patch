diff --git a/app/jobs/account/export_job.rb b/app/jobs/account/export_job.rb
new file mode 100644
index 0000000..d640ac6
--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,90 @@
+class Account::ExportJob < ApplicationJob
+  def perform(export)
+    export.update!(status: :processing)
+
+    ZipFile.create_for(export.file, filename: filename_for(export)) do |zip|
+      if export.kind == "account"
+        write_account(export.account, zip)
+      else
+        write_profile_cards(export, zip)
+      end
+    end
+
+    export.update!(status: :completed)
+    AccountMailer.data_export(export).deliver_later
+  rescue => error
+    export.update(status: :failed) if export.persisted?
+    raise error
+  end
+
+  private
+    def filename_for(export)
+      export.kind == "account" ? "#{export.account.name.parameterize}-export.zip" : "fizzy-cards.zip"
+    end
+
+    def write_account(account, zip)
+      Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+        record_set.write_to(zip)
+      end
+
+      write_card_documents(account.cards, zip)
+      write_blob_files(account, zip)
+    end
+
+    def write_profile_cards(export, zip)
+      cards = Card.published.joins(board: :accesses)
+        .where(accesses: { user_id: export.user_id })
+        .distinct
+      write_card_documents(cards, zip)
+      cards.find_each do |card|
+        card_attachments(card).each do |attachment|
+          blob = attachment.blob
+          filename = blob.filename.to_s.gsub(/[^a-zA-Z0-9._-]/, "_")
+          zip.add_file("files/#{blob.id}-#{filename}", compress: false) do |sink|
+            blob.download { |chunk| sink.write(chunk) }
+          end
+        end
+      end
+    end
+
+    def write_card_documents(cards, zip)
+      cards.with_rich_text_description_and_embeds.includes(:comments).find_each do |card|
+        payload = {
+          card: card.attributes,
+          description: card.description.body&.to_html
+        }
+        prefix = JSON.generate(payload).chomp("}") + ',"comments":['
+
+        zip.add_file("cards/#{card.number}.json") do |sink|
+          sink.write(prefix)
+          first_comment = true
+          card.comments.includes(:creator, :rich_text_body).find_each do |comment|
+            sink.write(",") unless first_comment
+            sink.write(JSON.generate(
+              id: comment.id,
+              creator: comment.creator.name,
+              body: comment.body.body&.to_html,
+              created_at: comment.created_at
+            ))
+            first_comment = false
+          end
+          sink.write("]}")
+        end
+      end
+    end
+
+    def write_blob_files(account, zip)
+      internal_types = Account::DataTransfer::RecordSet::INTERNAL_RECORD_TYPES + [ "Identity" ]
+      excluded_blobs = ActiveStorage::Attachment.where(account_id: account.id, record_type: internal_types).select(:blob_id)
+
+      ActiveStorage::Blob.where(account_id: account.id).where.not(id: excluded_blobs).find_each do |blob|
+        zip.add_file("files/#{blob.id}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+
+    def card_attachments(card)
+      [ card.image_attachment, *card.description.embeds, *card.comments.flat_map(&:attachments) ].compact
+    end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..2258fbc
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,148 @@
+class Account::ImportJob < ApplicationJob
+  BATCH_SIZE = 500
+
+  def perform(import)
+    import.update!(status: :processing)
+    destination = nil
+    @uploaded_files = []
+
+    import.file.blob.open do |archive|
+      entries = ZipKit::FileReader.new.read_zip_structure(io: archive)
+      names = entries.map(&:filename)
+      raise ArgumentError, "Archive does not contain an account export" unless names.include?("records/accounts.jsonl")
+      raise ArgumentError, "Unsafe archive path" if names.any? { |name| name.start_with?("/") || name.split("/").include?("..") }
+
+      ActiveRecord::Base.transaction do
+        entries_by_name = entries.index_by(&:filename)
+        account_data = nil
+        each_jsonl(entries_by_name.fetch("records/accounts.jsonl"), archive) { |record| account_data ||= record }
+        raise ArgumentError, "Account record is empty" unless account_data
+
+        destination = Account.create!(name: account_data.fetch("name"))
+        Current.account = destination
+        destination.entropy&.destroy!
+
+        Account::DataTransfer::Manifest.new(destination).each_record_set do |record_set|
+          next if record_set.model == Account
+          entry = entries_by_name[record_set.path]
+          import_record_set(record_set, entry, archive, destination) if entry
+        end
+
+        destination.update_column(:cards_count, account_data["cards_count"] || 0)
+        import_files(destination, entries, archive)
+      end
+    end
+
+    import.update!(status: :completed)
+    AccountMailer.data_import(import, destination).deliver_later
+    @uploaded_files.clear
+  rescue => error
+    @uploaded_files.to_a.each do |service, key|
+      begin
+        service.delete(key)
+      rescue
+        nil
+      end
+    end
+    destination&.destroy if destination&.persisted?
+    import.update(status: :failed, error_message: error.message.truncate(2000))
+    AccountMailer.data_import_failed(import, error.message).deliver_later
+  ensure
+    import.file.purge_later if import&.file&.attached?
+  end
+
+  private
+    def import_record_set(record_set, entry, archive, account)
+      model = record_set.model
+      batch = []
+
+      each_jsonl(entry, archive) do |attributes|
+        source_blob_id = attributes["id"] if model == ActiveStorage::Blob
+        attributes.each do |key, value|
+          if key == "id" || (key.end_with?("_id") && !%w[ account_id identity_id ].include?(key))
+            attributes[key] = remapped_id(value, account) if value.present?
+          end
+        end
+        attributes["account_id"] = account.id if model.column_names.include?("account_id")
+
+        if model == User
+          email = attributes.delete("identity_email")
+          attributes["identity_id"] = email && Identity.find_or_create_by!(email_address: email).id
+        end
+
+        if model == Board::Publication
+          attributes["key"] = SecureRandom.base58(24)
+        end
+
+        if model == ActiveStorage::Blob
+          attributes["service_name"] = ActiveStorage::Blob.service.name
+          attributes["key"] = SecureRandom.base36(28)
+          attributes["metadata"] = (attributes["metadata"] || {}).merge("fizzy_data_transfer_source_id" => source_blob_id)
+        end
+
+        if model == Entropy && attributes["container_type"] == "Account"
+          attributes["container_id"] = account.id
+        end
+
+        batch << attributes.slice(*model.column_names)
+        if batch.length >= BATCH_SIZE
+          model.insert_all!(batch)
+          batch.clear
+        end
+      end
+
+      model.insert_all!(batch) if batch.any?
+    end
+
+    def import_files(account, entries, archive)
+      entries_by_name = entries.index_by(&:filename)
+      ActiveStorage::Blob.where(account_id: account.id).find_each do |blob|
+        source_id = blob.metadata["fizzy_data_transfer_source_id"]
+        entry = entries_by_name["files/#{source_id}"]
+        raise ArgumentError, "Archive is missing file data for blob #{source_id}" unless entry
+
+        tempfile = Tempfile.new([ "fizzy-import", ".bin" ])
+        tempfile.binmode
+        extractor = entry.extractor_from(archive)
+        tempfile.write(extractor.extract(1024 * 1024)) until extractor.eof?
+        tempfile.rewind
+        blob.upload_without_unfurling(tempfile)
+        @uploaded_files << [ blob.service, blob.key ]
+        blob.update!(metadata: blob.metadata.except("fizzy_data_transfer_source_id"))
+      ensure
+        tempfile&.close!
+      end
+    end
+
+    def remapped_id(value, account)
+      value = value.to_s
+      base36 = value.match?(/\A[0-9a-z]{25}\z/i)
+      uuid = value.match?(/\A[0-9a-f-]{36}\z/i)
+      return value unless base36 || uuid
+
+      source_hex = base36 ? ActiveRecord::Type::Uuid.base36_to_hex(value) : value.delete("-")
+      hex = Digest::SHA256.hexdigest("#{account.id}:#{source_hex}")[0, 32]
+      hex[12] = "5"
+      hex[16] = ((hex[16].to_i(16) & 3) | 8).to_s(16)
+
+      if base36
+        ActiveRecord::Type::Uuid.hex_to_base36(hex)
+      else
+        [ hex[0, 8], hex[8, 4], hex[12, 4], hex[16, 4], hex[20, 12] ].join("-")
+      end
+    end
+
+    def each_jsonl(entry, archive)
+      return enum_for(:each_jsonl, entry, archive) unless block_given?
+
+      extractor = entry.extractor_from(archive)
+      buffer = +""
+      until extractor.eof?
+        buffer << extractor.extract(1024 * 1024)
+        while (line = buffer.slice!(/\A.*?\n/))
+          yield JSON.parse(line) unless line.strip.empty?
+        end
+      end
+      yield JSON.parse(buffer) unless buffer.strip.empty?
+    end
+end
