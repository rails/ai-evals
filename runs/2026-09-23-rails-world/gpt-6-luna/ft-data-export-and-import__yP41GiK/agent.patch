new file mode 100644
index 0000000..932c990
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,26 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :download
+
+  def create
+    return head :forbidden unless Current.user.admin?
+
+    export = Current.account.exports.create!(user: Current.user)
+    Account::ExportJob.perform_later(export)
+    redirect_to account_settings_path, notice: "Your export is being prepared. We’ll email you when it’s ready."
+  end
+
+  def download
+    export = Export.find_signed!(params[:token], purpose: :download)
+    return head :not_found unless export.account_id == Current.account.id && export.completed? && export.file.attached?
+
+    response.headers["Content-Type"] = "application/zip"
+    response.headers["Content-Disposition"] = ActionDispatch::Http::ContentDisposition.format(
+      disposition: "attachment", filename: export.file.filename.to_s
+    )
+    self.response_body = Enumerator.new do |stream|
+      export.file.blob.download { |chunk| stream << chunk }
+    end
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    head :not_found
+  end
+end
