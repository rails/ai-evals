+require "test_helper"
+
+class Users::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "a user can export their visible cards" do
+    sign_in_as :david
+
+    assert_enqueued_with(job: Account::ExportJob) do
+      post user_export_path(users(:david))
+    end
+
+    assert_redirected_to user_path(users(:david))
+  end
+
+  test "a user cannot export another person's cards" do
+    sign_in_as :david
+
+    post user_export_path(users(:kevin))
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/jobs/account/data_transfer_job_test.rb b/test/jobs/account/data_transfer_job_test.rb
new file mode 100644
index 0000000..1478b56
--- /dev/null
+++ b/test/jobs/account/data_transfer_job_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::DataTransferJobTest < ActiveJob::TestCase
+  test "account exports contain record files and attached blob data" do
+    user = users(:david)
+    export = Current.account.exports.create!(user: user)
+
+    Account::ExportJob.perform_now(export)
+
+    assert_predicate export, :completed?
+    export.file.blob.open do |archive|
+      paths = ZipKit::FileReader.new.read_zip_structure(io: archive).map(&:filename)
+      assert_includes paths, "records/accounts.jsonl"
+      assert_includes paths, "records/cards.jsonl"
+      assert_includes paths, "records/comments.jsonl"
+    end
+  end
+
+  test "profile export writes visible cards as JSON with comments and attached files" do
+    user = users(:david)
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("profile picture"), filename: "picture.txt", content_type: "text/plain")
+    export = Current.account.exports.create!(user: user, kind: :cards)
+
+    Account::ExportJob.perform_now(export)
+
+    export.file.blob.open do |archive|
+      entries = ZipKit::FileReader.new.read_zip_structure(io: archive)
+      card_entry = entries.find { |entry| entry.filename == "cards/#{card.number}.json" }
+      assert card_entry
+      data = +""
+      extractor = card_entry.extractor_from(archive)
+      data << extractor.extract(1024) until extractor.eof?
+      assert JSON.parse(data).key?("comments")
+      assert entries.any? { |entry| entry.filename.start_with?("files/") }
+    end
+  end
+
+  test "an account export can be imported as a separate account, including its files" do
+    source = Current.account
+    board = boards(:writebook)
+    publication = board.create_publication!
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("sample picture bytes"), filename: "picture.txt", content_type: "text/plain")
+    export = source.exports.create!(user: users(:jason))
+    Account::ExportJob.perform_now(export)
+
+    tempfile = export.file.blob.open
+    imported = source.imports.new(user: users(:jason))
+    imported.file.attach(io: tempfile, filename: "account.zip", content_type: "application/zip")
+    imported.save!
+    Account::ImportJob.perform_now(imported)
+
+    assert_predicate imported, :completed?, imported.error_message
+    destination = Account.where(name: source.name).where.not(id: source.id).first!
+    assert_equal source.boards.count, destination.boards.count
+    assert_equal source.cards.count, destination.cards.count
+    assert_equal source.users.count, destination.users.count
+    imported_publication = destination.boards.find_by!(name: board.name).publication
+    assert_not_equal publication.key, imported_publication.key
+    imported_card = destination.cards.find_by!(title: card.title)
+    assert_equal "sample picture bytes", imported_card.image.download
+  ensure
+    tempfile&.close!
+  end
+
+  test "an invalid import fails without creating a destination account" do
+    original_count = Account.count
+    user = users(:david)
+    import = Current.account.imports.new(user: user)
+    import.file.attach(io: StringIO.new("not a zip file"), filename: "broken.zip", content_type: "application/zip")
+    import.save!
+
+    Account::ImportJob.perform_now(import)
+
+    assert_predicate import, :failed?
+    assert_equal original_count, Account.count
+    assert import.error_message.present?
+  end
+end
