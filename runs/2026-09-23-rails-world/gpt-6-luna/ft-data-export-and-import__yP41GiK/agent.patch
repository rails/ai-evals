+class Account::ImportsController < ApplicationController
+  def new
+    @import = Current.account.imports.new
+  end
+
+  def create
+    @import = Current.account.imports.new(user: Current.user)
+    @import.file.attach(params.require(:import).fetch(:file))
+    @import.save!
+    Account::ImportJob.perform_later(@import)
+    redirect_to new_account_import_path, notice: "Your import is being processed. We’ll email you when it’s done."
+  rescue ActiveRecord::RecordInvalid, ActionController::ParameterMissing, KeyError
+    @import ||= Current.account.imports.new
+    @import.errors.add(:file, "must be a ZIP archive")
+    render :new, status: :unprocessable_entity
+  end
+end
