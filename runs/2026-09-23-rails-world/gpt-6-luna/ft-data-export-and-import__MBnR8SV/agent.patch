diff --git a/test/models/account/data_transfer/manifest_test.rb b/test/models/account/data_transfer/manifest_test.rb
new file mode 100644
index 0000000..f779b30
--- /dev/null
+++ b/test/models/account/data_transfer/manifest_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  test "card export contains cards visible to the requesting user" do
+    user = users("jz")
+    Current.set(account: user.account, user: user) do
+      cards = user.accessible_cards.to_a
+      assert cards.any?
+
+      export = user.account.exports.create!(user: user, kind: :cards)
+      export.generate_now
+      export.file.blob.open do |archive_file|
+        archive = Zip::File.open(archive_file.path)
+        card_entry = archive.glob("cards/*.json").first
+        assert card_entry
+        payload = JSON.parse(card_entry.get_input_stream(&:read))
+        assert payload.key?("comments")
+        archive.close
+      end
+    end
+  end
+
+  test "export download token expires after one day" do
+    user = users("jason")
+    export = user.account.exports.create!(user: user, kind: :account)
+    token = export.download_id
+
+    assert_equal export, Export.find_signed(token, purpose: :download)
+
+    travel 2.days do
+      assert_nil Export.find_signed(token, purpose: :download)
+    end
+  end
+
+  test "invalid archive rolls back account creation" do
+    user = users("jason")
+    Current.set(account: user.account, user: user) do
+      import = Import.create!(account: user.account, identity: user.identity)
+      import.file.attach(io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip")
+      account_count = Account.count
+
+      import.process_now
+
+      assert import.failed?
+      assert_not import.error.blank?
+      assert_equal account_count, Account.count
+    end
+  end
+
+  test "account export can be restored as a separate account" do
+    source = accounts("37s")
+    owner = users("jason")
+    Current.set(account: source, user: owner) do
+      card = source.cards.first
+      card.image.attach(io: StringIO.new("image payload"), filename: "card-image.png", content_type: "image/png")
+      comment = card.comments.create!(creator: owner)
+      comment.update!(body: "Comment with an attachment")
+      comment_blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("comment file"), filename: "comment.txt", content_type: "text/plain", identify: false
+      )
+      comment.rich_text_body.embeds.attach(comment_blob)
+      comment.update!(body: ActionText::Attachment.from_attachable(comment_blob).to_html)
+      export = source.exports.create!(user: owner, kind: :account)
+      export.generate_now
+
+      import = Import.create!(account: source, identity: owner.identity)
+      import.file.attach(export.file.blob)
+      import.process_now
+
+      assert import.completed?, import.error
+      restored = Account.order(:created_at).last
+      assert_equal source.name, restored.name
+      assert_equal source.boards.count, restored.boards.count
+      assert_equal source.cards.count, restored.cards.count
+      assert restored.users.exists?(identity_id: owner.identity_id, role: :owner)
+      imported_image = restored.cards.find_by!(number: source.cards.first.number).image
+      assert_equal "image payload", imported_image.download
+      imported_comment = restored.cards.find_by!(number: card.number).comments.find(&:has_attachments?)
+      assert_equal "comment file", imported_comment.attachments.first.download
+    end
+  end
+end
