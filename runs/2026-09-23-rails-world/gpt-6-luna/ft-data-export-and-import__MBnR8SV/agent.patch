diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..168ee3a
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,73 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file
+
+  enum :kind, %i[ account cards ].index_by(&:itself), prefix: true
+
+  def generate_later
+    Export::GenerateJob.perform_later(self)
+  end
+
+  def download_id
+    signed_id(purpose: :download, expires_in: 1.day)
+  end
+
+  def generate_now
+    begin
+      ZipFile.create_for(file, filename: "#{kind_account? ? account.name.parameterize : 'cards'}-export.zip") do |zip|
+        if kind_account?
+          write_account_data(zip)
+        else
+          write_cards_data(zip)
+        end
+      end
+    rescue => error
+      update!(error: error.message.truncate(1000))
+      file.purge if file.attached?
+      ExportMailer.failed(self).deliver_later
+      raise
+    end
+
+    update!(completed_at: Time.current)
+    ExportMailer.ready(self).deliver_later
+  end
+
+  private
+    def write_account_data(zip)
+      Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+        record_set.write_to(zip)
+      end
+    end
+
+    def write_cards_data(zip)
+      cards = user.accessible_cards.includes(:comments, :image_attachment, comments: [ :creator, :rich_text_body ]).find_each
+      cards.each do |card|
+        zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_export(card)))
+        card.image.blob&.then { |blob| write_blob(zip, blob, "files/#{blob.id}/#{blob.filename}") }
+        card.comments.each do |comment|
+          comment.attachments.each do |attachment|
+            write_blob(zip, attachment, "files/#{attachment.id}/#{attachment.filename}")
+          end
+        end
+      end
+    end
+
+    def card_export(card)
+      card.attributes.merge(
+        "description" => card.description.to_s,
+        "comments" => card.comments.chronologically.map do |comment|
+          comment.attributes.merge("body" => comment.body.to_s, "creator_name" => comment.creator.name)
+        end
+      )
+    end
+
+    def write_blob(zip, blob, path)
+      @written_blob_ids ||= Set.new
+      return unless @written_blob_ids.add?(blob.id)
+
+      zip.add_file(path) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+end
