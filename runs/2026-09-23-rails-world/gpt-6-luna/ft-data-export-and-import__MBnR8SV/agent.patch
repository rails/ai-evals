diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..7a545fd
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,160 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  has_one_attached :file
+
+  enum :status, %i[ pending processing completed failed ].index_by(&:itself)
+
+  def process_later
+    Import::ProcessJob.perform_later(self)
+  end
+
+  def process_now
+    update!(status: :processing)
+
+    begin
+      restore_account!
+    rescue => error
+      update!(status: :failed, error: error.message.truncate(2000))
+      ImportMailer.failed(self).deliver_later
+    else
+      update!(status: :completed, completed_at: Time.current)
+      ImportMailer.completed(self).deliver_later
+    end
+  end
+
+  private
+    def restore_account!
+      raise ArgumentError, "Please upload a ZIP archive" unless file.attached?
+
+      @uploaded_file_objects = []
+      Current.set(account: nil, identity: identity) do
+        ActiveRecord::Base.transaction do
+          ZipFile.open_reader_for(file.blob) do |archive|
+            account_data = JSON.parse(archive.read_entry("accounts.jsonl").lines.first)
+            account = Account.create!(name: account_data.fetch("name"))
+            account.entropy.destroy!
+            @id_map = { account_data.fetch("id") => account.id }
+            build_id_map(archive)
+            importable_models = []
+            Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+              importable_models << record_set.model
+            end
+            @importable_model_names = importable_models.map(&:name)
+
+            archive.each do |entry|
+              next unless entry.filename.end_with?(".jsonl") && entry.filename != "accounts.jsonl"
+
+              import_record_set(account, archive, entry)
+            end
+
+            ensure_importer_is_owner(account)
+            account.update!(cards_count: account.cards.maximum(:number) || 0)
+            restore_files(account, archive)
+          end
+        end
+      end
+    rescue => error
+      @uploaded_file_objects.each do |service, key|
+        service.delete(key)
+      end
+      raise error
+    ensure
+      @uploaded_file_objects = nil
+    end
+
+    def build_id_map(archive)
+      archive.each do |entry|
+        next unless entry.filename.start_with?("records/") && entry.filename.end_with?(".jsonl")
+
+        archive.open_entry(entry) do |stream|
+          stream.each_line do |line|
+            id = JSON.parse(line)["id"]
+            @id_map[id] ||= SecureRandom.uuid if id
+          end
+        end
+      end
+    end
+
+    def import_record_set(account, archive, entry)
+      model_name = entry.filename.delete_prefix("records/").delete_suffix(".jsonl")
+      model = model_name.safe_constantize
+      unless @importable_model_names.include?(model_name) && model
+        raise ArgumentError, "Unrecognized data file: #{entry.filename}"
+      end
+
+      archive.open_entry(entry) do |stream|
+        stream.each_line do |line|
+          attributes = JSON.parse(line)
+          attributes.each do |key, value|
+            attributes[key] = @id_map[value] if value.is_a?(String) && @id_map.key?(value)
+          end
+          attributes["account_id"] = account.id if model.column_names.include?("account_id")
+
+          if model == User
+            email_address = attributes.delete("identity_email_address")
+            attributes["identity_id"] = Identity.find_or_create_by!(email_address: email_address).id if email_address.present?
+          end
+
+          if model == ActiveStorage::Blob
+            attributes["service_name"] = ActiveStorage::Blob.service.name
+            attributes["key"] = SecureRandom.base36(28)
+          end
+
+          if model == Board::Publication
+            attributes["key"] = SecureRandom.base58(24) if attributes["key"].present?
+          end
+
+          if model == ActionText::RichText
+            attributes["body"] = import_rich_text_body(attributes["body"])
+          end
+
+          model.insert_all!([ attributes ])
+        end
+      end
+    end
+
+    def import_rich_text_body(body)
+      content = ActionText::Content.new(body, canonicalize: false)
+      content.fragment.find_all("action-text-attachment[data-fizzy-blob-id]").each do |node|
+        original_blob_id = node["data-fizzy-blob-id"]
+        node.remove_attribute("data-fizzy-blob-id")
+        blob = ActiveStorage::Blob.find(@id_map.fetch(original_blob_id))
+        node["sgid"] = blob.attachable_sgid
+      end
+      content.to_html
+    end
+
+    def ensure_importer_is_owner(account)
+      Current.set(account: account, user: nil) do
+        matching_user = account.users.where.not(role: :system).find_by(identity_id: identity.id)
+        if matching_user
+          matching_user.update!(role: :owner)
+        else
+          account.users.create!(identity: identity, name: identity.email_address, role: :owner, verified_at: Time.current)
+        end
+      end
+    end
+
+    def restore_files(account, archive)
+      archive.each do |entry|
+        next unless entry.filename.start_with?("files/")
+
+        original_blob_id = entry.filename.split("/")[1]
+        blob = ActiveStorage::Blob.find_by!(id: @id_map.fetch(original_blob_id), account_id: account.id)
+
+        archive.open_entry(entry) do |stream|
+          raise ArgumentError, "Attachment #{entry.filename} is #{stream.size} bytes; expected #{blob.byte_size}" unless stream.size == blob.byte_size
+
+          upload_stream = ZipFile::ChecksumStream.new(stream, size: stream.size)
+          blob.service.upload(blob.key, upload_stream, checksum: nil, **blob.service_metadata)
+          @uploaded_file_objects << [ blob.service, blob.key ]
+          unless upload_stream.checksum == blob.checksum
+            blob.service.delete(blob.key)
+            @uploaded_file_objects.pop
+            raise ActiveStorage::IntegrityError, "Attachment checksum did not match the archive"
+          end
+        end
+      end
+    end
+end
