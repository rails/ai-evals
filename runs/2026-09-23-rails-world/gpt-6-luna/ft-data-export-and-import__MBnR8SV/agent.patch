+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+    @import = Import.new
+  end
+
+  def create
+    importing_user = Current.identity.users.active.first!
+    Current.set(account: importing_user.account, user: importing_user) do
+      @import = Import.new(account: importing_user.account, identity: Current.identity, file: params.require(:import).fetch(:file))
+      @import.save!
+      @import.process_later
+    end
+    redirect_to new_account_import_path, notice: "Your import is being processed. We’ll email you when it’s finished."
+  rescue ActionController::ParameterMissing, KeyError
+    @import ||= Import.new
+    @import.errors.add(:file, "must be selected")
+    render :new, status: :unprocessable_entity
+  end
+end
