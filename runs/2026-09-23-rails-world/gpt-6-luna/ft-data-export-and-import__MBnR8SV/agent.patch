--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,39 @@
+class ZipFile::RemoteIO < ZipKit::RemoteIO
+  protected
+    def request_range(range)
+      request = Net::HTTP::Get.new(@uri)
+      request.range = range
+
+      with_http(request) do |response|
+        case response.code
+        when "206", "200"
+          response.body
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+    def request_object_size
+      request = Net::HTTP::Get.new(@uri)
+      request.range = 0..0
+
+      with_http(request) do |response|
+        case response.code
+        when "206"
+          response["Content-Range"].split("/").last.to_i
+        when "200"
+          response["Content-Length"].to_i
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+  private
+    def with_http(request)
+      Net::HTTP.start(@uri.hostname, @uri.port, use_ssl: @uri.scheme == "https") do |http|
+        yield http.request(request)
+      end
+    end
+end
