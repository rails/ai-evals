@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "registers and updates a device subscription" do
+    params = { push_subscription: { endpoint: "https://push.example/device", p256dh_key: "public-key", auth_key: "secret" } }
+
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: params, as: :json
+    end
+
+    assert_response :created
+    subscription_id = response.parsed_body.fetch("id")
+    assert_equal "public-key", @user.push_subscriptions.find(subscription_id).p256dh_key
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: params[:push_subscription].merge(p256dh_key: "rotated-key") }, as: :json
+    end
+
+    assert_equal "rotated-key", @user.push_subscriptions.find(subscription_id).p256dh_key
+  end
+
+  test "does not permit registering subscriptions for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: { endpoint: "https://push.example/device", p256dh_key: "public-key", auth_key: "secret" }
+    }, as: :json
+
+    assert_response :forbidden
+    assert_empty PushSubscription.all
+  end
+
+  test "deletes only the signed in user's subscription" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example/device", p256dh_key: "public-key", auth_key: "secret")
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/jobs/push_notification_job_test.rb b/test/jobs/push_notification_job_test.rb
new file mode 100644
index 0000000..1a44084
--- /dev/null
+++ b/test/jobs/push_notification_job_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class PushNotificationJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example/device", p256dh_key: "p256dh", auth_key: "auth"
+    )
+    ENV["VAPID_PUBLIC_KEY"] = "public-vapid-key"
+    ENV["VAPID_PRIVATE_KEY"] = "private-vapid-key"
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "sends tray content and the card path to every subscribed device" do
+    WebPush.expects(:payload_send).with do |options|
+      payload = JSON.parse(options[:message])
+      options[:endpoint] == @subscription.endpoint &&
+        options[:p256dh] == @subscription.p256dh_key &&
+        options[:auth] == @subscription.auth_key &&
+        payload["title"].present? && payload["body"].present? &&
+        payload["url"] == Rails.application.routes.url_helpers.card_path(@notification.card, script_name: @notification.account.slug)
+    end
+
+    PushNotificationJob.perform_now(@notification.id)
+  end
+
+  test "does not send read notifications" do
+    @notification.update!(read_at: Time.current)
+    WebPush.expects(:payload_send).never
+
+    PushNotificationJob.perform_now(@notification.id)
+  end
+end
