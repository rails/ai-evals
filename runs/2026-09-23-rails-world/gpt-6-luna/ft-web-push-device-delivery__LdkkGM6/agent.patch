diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..78e2980
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,31 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    subscription = Current.user.push_subscriptions.find_or_initialize_by(endpoint_digest: endpoint_digest)
+    subscription.assign_attributes(subscription_params)
+    subscription.save!
+
+    render json: { id: subscription.id }, status: :created
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless params[:user_id] == Current.user.to_param
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ]).tap do |attributes|
+        attributes[:endpoint] = attributes[:endpoint].to_s
+      end
+    end
+
+    def endpoint_digest
+      Digest::SHA256.hexdigest(params.expect(push_subscription: :endpoint)[:endpoint])
+    end
+end
diff --git a/app/javascript/controllers/push_notifications_controller.js b/app/javascript/controllers/push_notifications_controller.js
new file mode 100644
index 0000000..34a872a
--- /dev/null
+++ b/app/javascript/controllers/push_notifications_controller.js
@@ -0,0 +1,129 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["message", "enableButton", "disableButton", "error", "details"]
+  static values = { publicKey: String, subscriptionsUrl: String, subscriptionId: String }
+
+  async connect() {
+    this.setState(false)
+
+    if ("serviceWorker" in navigator && "PushManager" in window && "Notification" in window && Notification.permission === "granted") {
+      try {
+        const registration = await navigator.serviceWorker.register("/service-worker.js")
+        const subscription = await registration.pushManager.getSubscription()
+        if (subscription) await this.saveSubscription(subscription)
+        else this.setState(false)
+      } catch (error) {
+        this.showError(error)
+      }
+    } else if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
+      this.showHelp("Push notifications aren’t supported by this browser.")
+    } else if (Notification.permission === "denied") {
+      this.showHelp("Notifications are blocked for this website. Allow them in your browser settings, then try again.")
+    }
+  }
+
+  async enable() {
+    this.clearError()
+
+    if (!this.publicKeyValue) {
+      this.showError(new Error("Push notifications aren’t configured on this server."))
+      return
+    }
+
+    if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
+      this.showHelp("Push notifications aren’t supported by this browser.")
+      return
+    }
+
+    try {
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") {
+        this.showHelp("Notifications are blocked for this website. Allow them in your browser settings, then try again.")
+        return
+      }
+
+      const registration = await navigator.serviceWorker.register("/service-worker.js")
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.decodeKey(this.publicKeyValue)
+      })
+      await this.saveSubscription(subscription)
+      this.setState(true)
+    } catch (error) {
+      this.showError(error)
+    }
+  }
+
+  async disable() {
+    this.clearError()
+
+    try {
+      const registration = await navigator.serviceWorker.getRegistration("/")
+      const subscription = await registration?.pushManager.getSubscription()
+      if (subscription) await subscription.unsubscribe()
+
+      if (this.subscriptionIdValue) {
+        await this.request(this.subscriptionsUrlValue + "/" + this.subscriptionIdValue, { method: "DELETE" })
+      }
+      this.subscriptionIdValue = ""
+      this.setState(false)
+    } catch (error) {
+      this.showError(error)
+    }
+  }
+
+  async saveSubscription(subscription) {
+    const data = subscription.toJSON()
+    const response = await this.request(this.subscriptionsUrlValue, {
+      method: "POST",
+      body: JSON.stringify({ push_subscription: {
+        endpoint: data.endpoint,
+        p256dh_key: data.keys.p256dh,
+        auth_key: data.keys.auth
+      } })
+    })
+    const result = await response.json()
+    this.subscriptionIdValue = result.id
+    this.setState(true)
+  }
+
+  async request(url, options) {
+    const token = document.querySelector('meta[name="csrf-token"]')?.content
+    const response = await fetch(url, {
+      credentials: "same-origin",
+      headers: { "Content-Type": "application/json", "X-CSRF-Token": token, "Accept": "application/json" },
+      ...options
+    })
+    if (!response.ok) throw new Error("Could not update push notification settings.")
+    return response
+  }
+
+  setState(enabled) {
+    this.element.classList.toggle("notifications--on", Boolean(enabled))
+    this.enableButtonTarget.hidden = Boolean(enabled)
+    this.disableButtonTarget.hidden = !enabled
+  }
+
+  showHelp(message) {
+    this.messageTarget.textContent = message
+    this.detailsTarget.hidden = false
+  }
+
+  showError(error) {
+    this.errorTarget.textContent = error.message || "Could not enable push notifications."
+    this.errorTarget.hidden = false
+    this.detailsTarget.hidden = false
+  }
+
+  clearError() {
+    this.errorTarget.hidden = true
+    this.errorTarget.textContent = ""
+  }
+
+  decodeKey(value) {
+    const padding = "=".repeat((4 - value.length % 4) % 4)
+    const base64 = (value + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push_notification_job.rb b/app/jobs/push_notification_job.rb
