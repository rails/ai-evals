@@ -0,0 +1,50 @@
+class PushNotificationJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  def perform(notification_id)
+    return unless ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    notification = Notification.find_by(id: notification_id)
+    return unless notification
+
+    return if notification.read? || !notification.user.active?
+
+    notification.user.push_subscriptions.find_each do |subscription|
+      deliver(notification, subscription)
+    end
+  end
+
+  private
+    def deliver(notification, subscription)
+      WebPush.payload_send(
+        endpoint: subscription.endpoint,
+        message: JSON.generate(payload_for(notification)),
+        p256dh: subscription.p256dh_key,
+        auth: subscription.auth_key,
+        vapid: {
+          subject: "mailto:#{ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")}",
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        }
+      )
+    rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+      subscription.destroy!
+    end
+
+    def payload_for(notification)
+      source = notification.source
+      helpers = ApplicationController.helpers
+
+      if source.is_a?(Event)
+        title = helpers.event_notification_title(source)
+        body = helpers.event_notification_body(source)
+      else
+        title = "#{source.mentioner.first_name} @mentioned you"
+        body = source.source.mentionable_content.truncate(200)
+      end
+
+      {
+        title: title,
+        body: body,
+        url: Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug)
+      }
+    end
+end
