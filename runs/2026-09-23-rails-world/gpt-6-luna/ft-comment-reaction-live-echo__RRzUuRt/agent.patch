diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..b2f8d70
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create reaction" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_includes response.body, "🎉"
+    assert_includes response.body, "reactions__trigger"
+  end
+
+  test "reject reaction longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "12345678901234567" } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "creator can remove their reaction" do
+    reaction = @comment.reactions.create!(content: "👍", creator: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "cannot remove another user's reaction" do
+    reaction = @comment.reactions.create!(content: "👍", creator: users(:jz))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..4d014b2
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,17 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "limits reaction content to 16 characters" do
+    reaction = Reaction.new(comment: comments(:logo_agreement_kevin), creator: users(:kevin), content: "12345678901234567")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "requires reaction content" do
+    reaction = Reaction.new(comment: comments(:logo_agreement_kevin), creator: users(:kevin), content: " ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+end
