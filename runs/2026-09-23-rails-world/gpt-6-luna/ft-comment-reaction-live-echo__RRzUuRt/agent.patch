diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..dffaa84
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,37 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:creator).order(:created_at, :id).each do |reaction| %>
+      <div class="reaction" title="<%= reaction.creator.name %>" aria-label="<%= reaction.content %> by <%= reaction.creator.name %>"
+           data-reactions-target="reaction" data-creator-id="<%= reaction.creator_id %>"
+           data-action="click->reactions#toggleReaction keydown->reactions#toggleReactionWithKeyboard">
+        <span class="reaction__avatar"><%= avatar_tag reaction.creator, hidden_for_screen_reader: true %></span>
+        <span class="txt-small txt-medium"><%= reaction.content %></span>
+        <span class="for-screen-reader">by <%= reaction.creator.name %></span>
+        <%= form_with model: [ comment.card, comment, reaction ], method: :delete,
+              class: "reaction__delete", data: { action: "click->reactions#stopPropagation" } do %>
+          <button type="submit" class="btn btn--circle borderless" aria-label="Remove your reaction">
+            <%= icon_tag "x" %>
+          </button>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction"
+          data-reactions-target="trigger" data-action="click->reactions#openForm">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ], class: "reaction reaction__form", hidden: true,
+        data: { reactions_target: "form" } do |form| %>
+    <%= form.text_field :content, class: "input reaction__input", maxlength: 16, required: true,
+          autocomplete: "off", aria: { label: "Your reaction" }, data: { reactions_target: "input" } %>
+    <button type="submit" class="reaction__submit-btn btn btn--circle" aria-label="Confirm reaction">
+      <%= icon_tag "check" %>
+    </button>
+    <button type="button" class="reaction__cancel-btn btn btn--circle" aria-label="Cancel reaction"
+            data-action="click->reactions#cancelForm">
+      <%= icon_tag "x" %>
+    </button>
+  <% end %>
+</div>
