--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,31 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params.merge(creator: Current.user))
+  end
+
+  def destroy
+    if @reaction.creator == Current.user
+      @reaction.destroy
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..74428b4
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,50 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "reaction", "trigger" ]
+
+  connect() {
+    this.reactionTargets.forEach(reaction => {
+      if (reaction.dataset.creatorId === window.Current?.user?.id) {
+        reaction.classList.add("reaction--deleteable")
+        reaction.setAttribute("role", "button")
+        reaction.setAttribute("tabindex", "0")
+        reaction.setAttribute("aria-expanded", "false")
+      }
+    })
+  }
+
+  openForm() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancelForm() {
+    this.formTarget.reset()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  toggleReaction(event) {
+    const reaction = event.currentTarget
+
+    if (reaction.dataset.creatorId === window.Current?.user?.id) {
+      reaction.classList.toggle("expanded")
+      reaction.setAttribute("aria-expanded", reaction.classList.contains("expanded"))
+    }
+  }
+
+  toggleReactionWithKeyboard(event) {
+    if (["Enter", " "].includes(event.key)) {
+      event.preventDefault()
+      this.toggleReaction(event)
+    }
+  }
+
+  stopPropagation(event) {
+    event.stopPropagation()
+  }
+}
