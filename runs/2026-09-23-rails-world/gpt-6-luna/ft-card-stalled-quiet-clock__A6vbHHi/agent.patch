diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..71a907d
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from at least two people within a third of the auto-close period create a burst" do
+    card = cards(:logo)
+
+    card.comments.create!(creator: users(:david), body: "First comment")
+    travel 1.hour do
+      card.comments.create!(creator: users(:kevin), body: "Second comment")
+      card.comments.create!(creator: users(:david), body: "Third comment")
+    end
+
+    assert_not_nil card.reload.burst_at
+    assert_not card.stalled?
+  end
+
+  test "comments from one person do not create a burst" do
+    card = cards(:logo)
+
+    3.times { |n| card.comments.create!(creator: users(:david), body: "Comment #{n}") }
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "comments outside the burst window do not count" do
+    card = cards(:logo)
+
+    travel_to 31.days.ago do
+      card.comments.create!(creator: users(:david), body: "Old comment")
+    end
+    card.comments.create!(creator: users(:david), body: "Recent comment")
+    card.comments.create!(creator: users(:kevin), body: "Another recent comment")
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "assignment creates a burst and later activity clears it" do
+    card = cards(:shipping)
+    card.toggle_assignment users(:kevin)
+    assert_not_nil card.reload.burst_at
+
+    card.touch_last_active_at
+    assert_nil card.reload.burst_at
+  end
+
+  test "reopening creates a burst" do
+    card = cards(:shipping)
+    card.close
+    card.reopen
+
+    assert_not_nil card.reload.burst_at
+  end
+
+  test "cached cards get a new cache version when they become stalled" do
+    card = cards(:logo)
+    thirteen_days_ago = 13.days.ago
+    card.update_columns(burst_at: thirteen_days_ago, last_active_at: thirteen_days_ago)
+    cache_version_before_stalling = card.reload.cache_version
+
+    travel 2.days + 1.second do
+      assert_not_equal cache_version_before_stalling, card.reload.cache_version
+    end
+  end
+
+  test "a burst is stalled after two quiet weeks" do
+    card = cards(:logo)
+    three_weeks_ago = 3.weeks.ago
+    card.update_columns(burst_at: three_weeks_ago, last_active_at: three_weeks_ago)
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+
+    card.touch_last_active_at
+    assert_not card.reload.stalled?
+  end
+end
