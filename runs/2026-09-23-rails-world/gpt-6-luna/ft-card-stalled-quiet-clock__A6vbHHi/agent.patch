new file mode 100644
index 0000000..61bb63a
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,43 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..(STALLED_AFTER.ago)) }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def register_activity(event: nil)
+    at = Time.current
+    update!(last_active_at: at, burst_at: activity_burst?(event, at) ? at : nil)
+  end
+
+  def cache_version
+    "#{super}-#{stalled?}"
+  end
+
+  private
+    def activity_burst?(event, at)
+      if event&.action&.in?(BURST_ACTIONS)
+        true
+      elsif event&.action == "comment_created" && !event.creator.system?
+        comment_burst?(event, at)
+      else
+        false
+      end
+    end
+
+    def comment_burst?(event, at)
+      window_start = event.created_at - board.auto_postpone_period / 3.0
+      comment_events = Event.where(action: "comment_created", eventable_type: "Comment")
+        .where(eventable_id: comments.select(:id))
+        .where(created_at: window_start..event.created_at)
+
+      comment_events.count >= 3 && comment_events.distinct.count(:creator_id) >= 2
+    end
+end
