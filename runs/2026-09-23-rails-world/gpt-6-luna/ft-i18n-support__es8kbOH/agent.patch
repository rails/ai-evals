diff --git a/app/controllers/concerns/locale_selection.rb b/app/controllers/concerns/locale_selection.rb
new file mode 100644
index 0000000..23c64bc
--- /dev/null
+++ b/app/controllers/concerns/locale_selection.rb
@@ -0,0 +1,39 @@
+module LocaleSelection
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[en ja].freeze
+
+  included do
+    before_action :select_locale
+    after_action :reset_locale
+  end
+
+  private
+    def select_locale
+      requested_locale = params[:locale].to_s
+
+      if SUPPORTED_LOCALES.include?(requested_locale)
+        session[:locale] = requested_locale
+      end
+
+      locale = if SUPPORTED_LOCALES.include?(requested_locale)
+        requested_locale
+      elsif SUPPORTED_LOCALES.include?(session[:locale].to_s)
+        session[:locale]
+      elsif SUPPORTED_LOCALES.include?(Current.identity&.locale.to_s)
+        Current.identity.locale
+      else
+        I18n.default_locale
+      end
+
+      if Current.identity && Current.identity.locale != locale
+        Current.identity.update_column(:locale, locale)
+      end
+
+      I18n.locale = locale
+    end
+
+    def reset_locale
+      I18n.locale = I18n.default_locale
+    end
+end
