diff --git a/test/controllers/locale_selection_test.rb b/test/controllers/locale_selection_test.rb
new file mode 100644
index 0000000..21bd42e
--- /dev/null
+++ b/test/controllers/locale_selection_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class LocaleSelectionTest < ActionDispatch::IntegrationTest
+  test "supported locale query selects Japanese and persists in the session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyをはじめましょう"
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "unsupported locale does not change the current selection" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=ja]"
+
+      reset!
+      integration_session.default_url_options[:script_name] = ""
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "magic-link mail uses the identity locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = identity.magic_links.create!(code: "ABC123", expires_at: 10.minutes.from_now)
+
+    message = MagicLinkMailer.sign_in_instructions(magic_link).message
+
+    assert_includes message.subject, "確認コード"
+    assert_includes message.text_part.body.decoded, "ログイン画面"
+    assert_not_includes message.text_part.body.decoded, "Fizzy verification code"
+  end
+
+  test "locale is restored from the identity in a clean browser" do
+    sign_in_as :kevin
+    get landing_path(locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+    sign_in_as :kevin
+    get landing_path
+
+    follow_redirect! while response.redirect?
+    assert_select "html[lang=ja]"
+  end
+end
