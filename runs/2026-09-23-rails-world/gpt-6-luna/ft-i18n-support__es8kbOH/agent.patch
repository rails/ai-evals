@@ -5,7 +5,29 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  def process(method_name, *arguments, **kwargs)
+    identity = identity_from(arguments + kwargs.values)
+    locale = identity.locale if identity.is_a?(Identity)
+    locale ||= Current.identity.locale if Current.identity.is_a?(Identity)
+    locale = "en" unless LocaleSelection::SUPPORTED_LOCALES.include?(locale)
+
+    I18n.with_locale(locale) { super }
+  end
+
   private
+    def identity_from(arguments)
+      Array(arguments).flatten.each do |argument|
+        identity = if argument.is_a?(Identity)
+          argument
+        elsif argument.respond_to?(:identity)
+          argument.identity
+        elsif argument.respond_to?(:user)
+          argument.user&.identity
+        end
+        return identity if identity.is_a?(Identity)
+      end
+    end
+
     def default_url_options
       if Current.account
         super.merge(script_name: Current.account.slug)
