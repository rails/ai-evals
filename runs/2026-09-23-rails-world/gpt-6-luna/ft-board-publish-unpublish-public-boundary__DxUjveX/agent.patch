diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..880a722
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins can publish and unpublish a board" do
+    board = boards(:writebook)
+    assert_nil board.public_key
+
+    post board_publication_path(board), as: :json
+    assert_response :created
+
+    key = board.reload.public_key
+    assert key.present?
+    assert_equal 43, key.length
+
+    delete board_publication_path(board), as: :json
+    assert_response :no_content
+    assert_nil board.reload.public_key
+  end
+
+  test "non-admins cannot publish or unpublish a board" do
+    board = boards(:writebook)
+    logout_and_sign_in_as :david
+
+    post board_publication_path(board), as: :json
+    assert_response :forbidden
+    assert_nil board.reload.public_key
+
+    board.update!(public_key: "a" * 43)
+    delete board_publication_path(board), as: :json
+    assert_response :forbidden
+    assert_equal "a" * 43, board.reload.public_key
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..a732fe2
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  test "public board and column list published cards and direct card opens" do
+    board = boards(:writebook)
+    board.publish
+    column = columns(:writebook_triage)
+    published_card = cards(:logo)
+    drafted_card = board.cards.create!(title: "Drafted private card", status: :drafted, column: column, creator: users(:kevin))
+
+    untenanted do
+      get "/public/boards/#{board.public_key}"
+      assert_response :success
+      assert_select "a", text: published_card.title, count: 2
+      assert_select "a", text: drafted_card.title, count: 0
+
+      get "/public/boards/#{board.public_key}/columns/#{column.id}"
+      assert_response :success
+      assert_select "a", text: published_card.title, count: 1
+      assert_select "a", text: drafted_card.title, count: 0
+
+      get "/public/boards/#{board.public_key}/cards/#{published_card.number}"
+      assert_response :success
+      assert_select "h1", text: published_card.title
+
+      get "/public/boards/#{board.public_key}/cards/#{drafted_card.number}"
+      assert_response :not_found
+
+      other_column = Column.create!(board: boards(:miltons_wish_list), account: accounts("initech"), name: "Private column", color: "var(--color-card-1)")
+      get "/public/boards/#{board.public_key}/columns/#{other_column.id}"
+      assert_response :not_found
+    end
+  end
+
+  test "unpublished or unknown boards are not accessible" do
+    board = boards(:writebook)
+
+    untenanted do
+      get "/public/boards/not-a-valid-key"
+      assert_response :not_found
+
+      board.publish
+      get "/public/boards/#{board.public_key}"
+      assert_response :success
+
+      old_key = board.public_key
+      board.unpublish
+      get "/public/boards/#{old_key}"
+      assert_response :not_found
+    end
+  end
+
+  test "board JSON includes nil or published public URL" do
+    board = boards(:writebook)
+    sign_in_as :kevin
+
+    get board_path(board), as: :json
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+
+    board.publish
+    get board_path(board), as: :json
+    assert_response :success
+    assert_equal public_board_url(board.public_key, script_name: ""), response.parsed_body["public_url"]
+  end
+end
