@@ -0,0 +1,17 @@
+class Public::BoardsController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+
+  before_action :set_board
+
+  def show
+    @columns = @board.columns.sorted
+    @cards = @board.cards.published.latest.to_a
+    @cards_by_column = @cards.group_by(&:column_id)
+  end
+
+  private
+    def set_board
+      @board = Board.find_by!(public_key: params[:key])
+    end
+end
