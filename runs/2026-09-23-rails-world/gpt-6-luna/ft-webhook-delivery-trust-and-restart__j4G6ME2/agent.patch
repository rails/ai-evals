diff --git a/test/jobs/webhook/deliver_job_test.rb b/test/jobs/webhook/deliver_job_test.rb
new file mode 100644
index 0000000..79f9808
--- /dev/null
+++ b/test/jobs/webhook/deliver_job_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Webhook::DeliverJobTest < ActiveJob::TestCase
+  test "posts a signed payload once and logs the response" do
+    webhook = webhooks(:active)
+    event = events(:text_published)
+    delivery = webhook.deliveries.create!(event: event)
+    stub_request(:post, webhook.url).to_return(status: 202)
+
+    Webhook::DeliverJob.perform_now(delivery)
+    Webhook::DeliverJob.perform_now(delivery)
+
+    delivery.reload
+    assert delivery.completed?
+    assert_equal 202, delivery.response[:code]
+    assert_requested :post, webhook.url, times: 1
+    request = WebMock::RequestRegistry.instance.requested_signatures.hash.keys.first
+    assert_equal delivery.id, request.headers["X-Webhook-Delivery"]
+    assert_equal "sha256=#{OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request.body)}", request.headers["X-Webhook-Signature"]
+  end
+
+  test "does not send deliveries after a webhook is deactivated" do
+    webhook = webhooks(:active)
+    delivery = webhook.deliveries.create!(event: events(:text_published))
+    webhook.deactivate
+    stub_request(:post, webhook.url)
+
+    Webhook::DeliverJob.perform_now(delivery)
+
+    assert delivery.reload.errored?
+    assert_equal "webhook_inactive", delivery.response[:error]
+    assert_not_requested :post, webhook.url
+  end
+
+  test "logs a failed response and updates delinquency" do
+    webhook = webhooks(:active)
+    delivery = webhook.deliveries.create!(event: events(:text_published))
+    stub_request(:post, webhook.url).to_return(status: 503)
+
+    Webhook::DeliverJob.perform_now(delivery)
+
+    assert_equal 503, delivery.reload.response[:code]
+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..33cab41
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "deactivates a webhook after ten failures in an hour" do
+    webhook = webhooks(:active)
+    tracker = Webhook::DelinquencyTracker.create!(webhook: webhook)
+    delivery = Webhook::Delivery.new(state: :completed, response: { code: 503 })
+
+    9.times { tracker.record_delivery(delivery) }
+    assert webhook.reload.active?
+    tracker.record_delivery(delivery)
+
+    assert_not webhook.reload.active?
+    assert_equal 10, tracker.reload.consecutive_failures_count
+  end
+
+  test "success resets the failure streak" do
+    webhook = webhooks(:active)
+    tracker = Webhook::DelinquencyTracker.create!(webhook: webhook, consecutive_failures_count: 4, first_failure_at: 10.minutes.ago)
+    delivery = Webhook::Delivery.new(state: :completed, response: { code: 204 })
+
+    tracker.record_delivery(delivery)
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "failure outside the one hour window starts a new streak" do
+    webhook = webhooks(:active)
+    tracker = Webhook::DelinquencyTracker.create!(webhook: webhook, consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+    delivery = Webhook::Delivery.new(state: :completed, response: { code: 503 })
+
+    tracker.record_delivery(delivery)
+
+    assert_equal 1, tracker.reload.consecutive_failures_count
+    assert webhook.reload.active?
+  end
+end
diff --git a/test/models/webhook/delivery_cleanup_test.rb b/test/models/webhook/delivery_cleanup_test.rb
