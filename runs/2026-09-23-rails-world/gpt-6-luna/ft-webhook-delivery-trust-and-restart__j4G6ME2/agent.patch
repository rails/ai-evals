--- /dev/null
+++ b/test/models/webhook/delivery_cleanup_test.rb
@@ -0,0 +1,15 @@
+require "test_helper"
+
+class Webhook::DeliveryCleanupTest < ActiveSupport::TestCase
+  test "retains deliveries for a week" do
+    old_delivery = webhook_deliveries(:pending)
+    old_delivery.update_columns(created_at: 8.days.ago)
+    recent_delivery = webhook_deliveries(:in_progress)
+    recent_delivery.update_columns(created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+end
