+++ b/test/models/webhook/delivery_fanout_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Webhook::DeliveryFanoutTest < ActiveSupport::TestCase
+  test "event creation creates one delivery per subscribed webhook" do
+    webhook = webhooks(:active)
+    board = webhook.board
+    creator = users(:david)
+    card = cards(:logo)
+    card.stubs(:event_was_created)
+    event = nil
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      event = Event.create!(action: "card_closed", board: board, creator: creator, eventable: card)
+    end
+
+    delivery = webhook.deliveries.find_by!(event: event)
+    assert delivery.pending?
+  end
+
+  test "repeated fanout does not create duplicate deliveries" do
+    webhook = webhooks(:active)
+    event = events(:text_published)
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      event.deliver_to_webhooks_later
+    end
+
+    assert_no_difference "Webhook::Delivery.count" do
+      event.deliver_to_webhooks_later
+    end
+  end
+end
