@@ -0,0 +1,47 @@
+class Webhook::DeliverJob < ApplicationJob
+  queue_as :default
+
+  def perform(delivery)
+    if delivery.pending?
+      if delivery.webhook.active?
+        claimed = Webhook::Delivery.where(id: delivery.id, state: :pending).update_all(state: :in_progress, updated_at: Time.current)
+        deliver(delivery) if claimed == 1
+      else
+        delivery.update!(state: :errored, response: { error: "webhook_inactive" })
+      end
+    end
+  end
+
+  private
+    def deliver(delivery)
+      webhook = delivery.webhook
+      event = delivery.event
+      body = ApplicationController.renderer.render(
+        template: "webhooks/event",
+        formats: [ :json ],
+        assigns: { event: event }
+      )
+      uri = URI.parse(webhook.url)
+      headers = {
+        "User-Agent" => "Fizzy Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Delivery" => delivery.id,
+        "X-Webhook-Signature" => "sha256=#{OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)}"
+      }
+      request = Net::HTTP::Post.new(uri, headers)
+      request.body = body
+      delivery.update!(request: { headers: headers })
+
+      response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https", open_timeout: 5, read_timeout: 10) do |http|
+        http.request(request)
+      end
+      delivery.update!(state: :completed, response: { code: response.code.to_i, headers: response.each_header.to_h })
+    rescue StandardError => error
+      delivery.update!(state: :errored, response: { error: error.class.name, message: error.message })
+    ensure
+      if delivery.completed? || delivery.errored?
+        tracker = Webhook::DelinquencyTracker.create_or_find_by!(webhook: delivery.webhook)
+        tracker.record_delivery(delivery)
+      end
+    end
+end
