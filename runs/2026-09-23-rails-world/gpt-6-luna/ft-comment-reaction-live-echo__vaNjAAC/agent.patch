diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..72330a0
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,46 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.build(content: reaction_params[:content], user: Current.user)
+
+    if @reaction.save
+      render_reactions
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    if @reaction.user == Current.user
+      @reaction.destroy!
+      render_reactions
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions
+      render turbo_stream: turbo_stream.replace(
+        ActionView::RecordIdentifier.dom_id(@comment, :reactions),
+        partial: "cards/comments/reactions",
+        locals: { comment: @comment }
+      )
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..95e38ee
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,16 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger" ]
+
+  connect() {
+    const currentUserId = document.querySelector('meta[name="current-user-id"]')?.content
+    this.owned = currentUserId === this.element.dataset.reactionUserId
+
+    if (this.owned) this.element.classList.add("reaction--deleteable")
+  }
+
+  toggle() {
+    if (this.owned) this.element.classList.toggle("expanded")
+  }
+}
