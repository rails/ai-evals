new file mode 100644
index 0000000..44aacf8
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,18 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :user, default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validates :content, uniqueness: { scope: [ :comment_id, :user_id ] }
+
+  after_commit :broadcast_reactions, on: %i[ create destroy ]
+
+  private
+    def broadcast_reactions
+      broadcast_replace_later_to comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reaction_list),
+        partial: "cards/comments/reaction_list",
+        locals: { comment: comment }
+    end
+end
