+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="toggle-class" data-toggle-class-toggle-class-value="expanded">
+  <%= render "cards/comments/reaction_list", comment: comment %>
+
+  <div class="reactions__add">
+    <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction" data-action="toggle-class#toggle">
+      <%= image_tag "boost-color.svg", alt: "" %>
+    </button>
+    <%= form_with model: [ comment.card, comment, Reaction.new ], url: card_comment_reactions_path(comment.card, comment),
+          class: "reaction__form", data: { turbo_stream: true } do |form| %>
+      <%= form.text_field :content, class: "input reaction__input", maxlength: 16, required: true,
+            aria: { label: "Your reaction (16 characters maximum)" }, autocomplete: "off" %>
+      <%= form.button class: "reaction__submit-btn btn btn--circle borderless", aria: { label: "Confirm reaction" } do %>
+        <%= icon_tag "check" %>
+      <% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" aria-label="Cancel" data-action="toggle-class#toggle">
+        <%= icon_tag "close" %>
+      </button>
+    <% end %>
+  </div>
+</div>
