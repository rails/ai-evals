diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..3b94709
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,86 @@
+import { Controller } from "@hotwired/stimulus"
+
+const timeOptions = { hour: "numeric", minute: "2-digit" }
+const dateOptions = { month: "short", day: "numeric" }
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    const date = new Date(this.element.dateTime)
+    if (Number.isNaN(date.getTime())) return
+
+    this.element.textContent = this.format(date)
+    this.element.title = new Intl.DateTimeFormat(undefined, {
+      dateStyle: "full", timeStyle: "short"
+    }).format(date)
+  }
+
+  format(date) {
+    switch (this.formatValue) {
+      case "time":
+        return new Intl.DateTimeFormat(undefined, timeOptions).format(date)
+      case "date":
+        return new Intl.DateTimeFormat(undefined, { ...dateOptions, year: "numeric" }).format(date)
+      case "short-date":
+        return new Intl.DateTimeFormat(undefined, dateOptions).format(date)
+      case "weekday-date":
+        return new Intl.DateTimeFormat(undefined, { weekday: "long", month: "long", day: "numeric" }).format(date)
+      case "date-time":
+        return new Intl.DateTimeFormat(undefined, { ...dateOptions, year: "numeric", ...timeOptions }).format(date)
+      case "comment":
+        return this.formatCommentDate(date)
+      case "relative":
+        return this.formatRelative(date)
+      case "countdown":
+        return this.formatCountdown(date)
+      default:
+        return new Intl.DateTimeFormat(undefined, {
+          weekday: "long", month: "long", day: "numeric", year: "numeric", ...timeOptions
+        }).format(date)
+    }
+  }
+
+  formatCommentDate(date) {
+    const days = this.calendarDaysFromToday(date)
+    if (days === 0) return new Intl.DateTimeFormat(undefined, timeOptions).format(date)
+    if (days === -1) return "yesterday"
+    if (days < -1 && days >= -6) return `${Math.abs(days)} days ago`
+    if (days === 1) return "tomorrow"
+    if (days > 1 && days < 7) return `in ${days} days`
+    return new Intl.DateTimeFormat(undefined, {
+      ...dateOptions,
+      ...(date.getFullYear() === new Date().getFullYear() ? {} : { year: "numeric" })
+    }).format(date)
+  }
+
+  formatRelative(date) {
+    const seconds = Math.floor((Date.now() - date.getTime()) / 1000)
+    const minutes = Math.floor(Math.abs(seconds) / 60)
+    const hours = Math.floor(minutes / 60)
+    const days = Math.floor(hours / 24)
+    let phrase
+
+    if (minutes < 1) phrase = "less than a minute"
+    else if (minutes < 60) phrase = `${minutes} minute${minutes === 1 ? "" : "s"}`
+    else if (hours < 24) phrase = `${hours} hour${hours === 1 ? "" : "s"}`
+    else if (days < 30) phrase = `${days} day${days === 1 ? "" : "s"}`
+    else if (days < 365) phrase = `${Math.floor(days / 30)} month${Math.floor(days / 30) === 1 ? "" : "s"}`
+    else phrase = `${Math.floor(days / 365)} year${Math.floor(days / 365) === 1 ? "" : "s"}`
+
+    return seconds < 0 ? `in ${phrase}` : `${phrase} ago`
+  }
+
+  formatCountdown(date) {
+    const days = this.calendarDaysFromToday(date)
+    if (days <= 0) return "today"
+    if (days === 1) return "tomorrow"
+    return `in ${days} days`
+  }
+
+  calendarDaysFromToday(date) {
+    const now = new Date()
+    const startOfDay = value => Date.UTC(value.getFullYear(), value.getMonth(), value.getDate())
+    return Math.round((startOfDay(date) - startOfDay(now)) / 86400000)
+  }
+}
