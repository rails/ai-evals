new file mode 100644
index 0000000..fd74607
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  test "account admins see plan details and both upgrade offers" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_includes response.body, "Upgrade to Unlimited (\$20/month)"
+    assert_includes response.body, "Upgrade to Unlimited+ (\$25/month)"
+  end
+
+  test "checkout creates a Stripe-hosted subscription session" do
+    sign_in_as :mike
+    ENV["STRIPE_PRICE_UNLIMITED"] = "price_unlimited"
+    ENV["STRIPE_SECRET_KEY"] = "sk_test_local"
+    session = Struct.new(:url).new("https://checkout.stripe.test/session")
+
+    Stripe::Checkout::Session.expects(:create).with do |options|
+      options[:mode] == "subscription" && options[:line_items].first[:price] == "price_unlimited" &&
+        options[:subscription_data][:metadata][:account_id] == accounts(:initech).id
+    end.returns(session)
+
+    post saas.account_subscription_path(plan: "unlimited", script_name: accounts(:initech).slug)
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  ensure
+    ENV.delete("STRIPE_PRICE_UNLIMITED")
+    ENV.delete("STRIPE_SECRET_KEY")
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
