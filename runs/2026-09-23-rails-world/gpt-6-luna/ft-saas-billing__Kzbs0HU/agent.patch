diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..5467fb6
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,29 @@
+module Stripe
+  class WebhooksController < ActionController::Base
+    skip_forgery_protection
+
+    def create
+      event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+      process_event(event)
+      head :ok
+    rescue JSON::ParserError, Stripe::SignatureVerificationError, KeyError
+      head :bad_request
+    end
+
+    private
+      def process_event(event)
+        object = event.data.object
+
+        case event.type
+        when "checkout.session.completed"
+          account = ::Account.find_by(id: object.client_reference_id || object.metadata.account_id)
+          if account
+            subscription = account.billing_subscription || account.build_billing_subscription
+            subscription.update!(stripe_customer_id: object.customer, status: subscription.status.presence || "incomplete")
+          end
+        when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+          ::Account::BillingSubscription.update_from_stripe!(object)
+        end
+      end
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..1c96bee
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,79 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :billing_subscription, class_name: "Account::BillingSubscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+
+  def plan_name
+    if comped?
+      "Comped"
+    elsif billing_subscription&.active?
+      billing_subscription.plan_name
+    else
+      "Free"
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def card_limit
+    if overridden_limit&.card_count.present?
+      overridden_limit.card_count
+    elsif comped? || (billing_subscription&.active? && billing_subscription.plan_key.in?(Account::BillingSubscription::PLANS.keys))
+      Float::INFINITY
+    else
+      FREE_CARD_LIMIT
+    end
+  end
+
+  def cards_remaining
+    [ card_limit - cards.count, 0 ].max
+  end
+
+  def card_limit_reached?
+    cards_remaining.zero?
+  end
+
+  def nearing_card_limit?
+    card_limit != Float::INFINITY && cards_remaining.positive? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def billing_storage_limit
+    limit = if comped?
+      Float::INFINITY
+    elsif billing_subscription&.active?
+      billing_subscription.storage_limit
+    else
+      Account::StorageLimited::DEFAULT_STORAGE_LIMIT
+    end
+    overridden_limit&.bytes_used || limit
+  end
+
+  def apply_limit_override(attributes)
+    override = overridden_limit || build_overridden_limit
+    override.update!(attributes)
+  end
+
+  def reset_limit_override
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  def comp_billing
+    create_billing_waiver! unless comped?
+    association(:billing_waiver).reset
+  end
+
+  def uncomp_billing
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+end
diff --git a/saas/app/models/account/billing_subscription.rb b/saas/app/models/account/billing_subscription.rb
new file mode 100644
index 0000000..91a2f4a
--- /dev/null
+++ b/saas/app/models/account/billing_subscription.rb
@@ -0,0 +1,48 @@
+class Account::BillingSubscription < SaasRecord
+  self.table_name = "account_subscriptions"
+
+  belongs_to :account
+
+  PLANS = {
+    "unlimited" => { name: "Unlimited", price: "$20/month", storage: 5.gigabytes, stripe_price: "STRIPE_PRICE_UNLIMITED", legacy_price: "STRIPE_MONTHLY_V1_PRICE_ID" },
+    "unlimited_plus" => { name: "Unlimited+", price: "$25/month", storage: 500.gigabytes, stripe_price: "STRIPE_PRICE_UNLIMITED_PLUS", legacy_price: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" }
+  }.freeze
+
+  def active?
+    status.in?(%w[active trialing])
+  end
+
+  def plan_name
+    PLANS.dig(plan_key, :name) || "Free"
+  end
+
+  def storage_limit
+    if active?
+      PLANS.dig(plan_key, :storage) || Account::StorageLimited::DEFAULT_STORAGE_LIMIT
+    else
+      Account::StorageLimited::DEFAULT_STORAGE_LIMIT
+    end
+  end
+
+  def self.update_from_stripe!(stripe_subscription)
+    customer_id = stripe_subscription.customer
+    record = find_by(stripe_customer_id: customer_id)
+    record ||= Account.find_by(id: stripe_subscription.metadata.account_id)&.then do |account|
+      account.billing_subscription || account.build_billing_subscription
+    end
+    raise ActiveRecord::RecordNotFound, "Subscription account not found" unless record
+
+    price_id = stripe_subscription.items.data.first&.price&.id
+    plan_key = PLANS.find do |_key, plan|
+      [ ENV[plan[:stripe_price]], ENV[plan[:legacy_price]] ].compact.include?(price_id)
+    end&.first || stripe_subscription.metadata.plan_key
+
+    record.update!(
+      stripe_customer_id: customer_id,
+      plan_key: plan_key,
+      stripe_subscription_id: stripe_subscription.id,
+      status: stripe_subscription.status,
+      current_period_end: stripe_subscription.current_period_end && Time.at(stripe_subscription.current_period_end)
+    )
+  end
+end
