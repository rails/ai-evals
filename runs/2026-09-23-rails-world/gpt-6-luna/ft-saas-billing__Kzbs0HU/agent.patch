@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open an account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(accounts(:initech))}']", text: accounts(:initech).name
+
+      get saas.admin_account_path(accounts(:initech))
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "non-staff cannot access account tools" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can change comp status and custom limits" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.admin_account_path(accounts(:initech)), params: { operation: "comp" }
+      assert accounts(:initech).reload.comped?
+
+      patch saas.admin_account_path(accounts(:initech)), params: { operation: "override", override: { card_count: 12, bytes_used: 2_000_000_000 } }
+      assert_equal 12, accounts(:initech).reload.card_limit
+
+      patch saas.admin_account_path(accounts(:initech)), params: { operation: "reset" }
+      assert_nil accounts(:initech).reload.overridden_limit
+    end
+  end
+end
