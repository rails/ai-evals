diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..05446a9
--- /dev/null
+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,47 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan_key = params.require(:plan)
+    plan = Account::BillingSubscription::PLANS.fetch(plan_key)
+    Stripe.api_key = ENV.fetch("STRIPE_SECRET_KEY")
+
+    checkout_options = {
+      mode: "subscription",
+      line_items: [ { price: stripe_price_for(plan), quantity: 1 } ],
+      success_url: account_settings_url,
+      cancel_url: account_settings_url,
+      client_reference_id: Current.account.id,
+      subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan_key } }
+    }
+
+    if Current.account.billing_subscription&.stripe_customer_id
+      checkout_options[:customer] = Current.account.billing_subscription.stripe_customer_id
+    elsif Current.account.owner_email.present?
+      checkout_options[:customer_email] = Current.account.owner_email
+    end
+
+    session = Stripe::Checkout::Session.create(checkout_options)
+    redirect_to session.url, allow_other_host: true
+  end
+
+  def show
+    subscription = Current.account.billing_subscription
+
+    if subscription&.stripe_customer_id
+      Stripe.api_key = ENV.fetch("STRIPE_SECRET_KEY")
+      session = Stripe::BillingPortal::Session.create(
+        customer: subscription.stripe_customer_id,
+        return_url: account_settings_url
+      )
+      redirect_to session.url, allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def stripe_price_for(plan)
+      ENV[plan[:stripe_price]].presence || ENV.fetch(plan[:legacy_price])
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..47e74e7
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,36 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.includes(:billing_subscription, :billing_waiver).order(created_at: :desc)
+  end
+
+  def show
+    @account = Account.includes(:billing_subscription, :billing_waiver, :overridden_limit).find(params[:id])
+  end
+
+  def update
+    @account = Account.find(params[:id])
+
+    case params[:operation]
+    when "comp"
+      @account.comp_billing
+    when "uncomp"
+      @account.uncomp_billing
+    when "override"
+      @account.apply_limit_override(override_params)
+    when "reset"
+      @account.reset_limit_override
+    else
+      head :unprocessable_entity
+      return
+    end
+
+    redirect_to saas.admin_account_path(@account), notice: "Account billing updated"
+  end
+
+  private
+    def override_params
+      params.expect(override: [ :card_count, :bytes_used ]).to_h.compact_blank
+    end
+end
