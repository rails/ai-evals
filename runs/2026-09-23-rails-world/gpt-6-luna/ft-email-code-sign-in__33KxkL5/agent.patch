diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..94d6566
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,33 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  def self.issue(email_address)
+    email_address = Identity.new(email_address: email_address).email_address
+    code = SecureRandom.random_number(1_000_000).to_s.rjust(CODE_LENGTH, "0")
+
+    transaction do
+      where(email_address: email_address).delete_all
+      create!(email_address: email_address, code_digest: digest(email_address, code), expires_at: LIFETIME.from_now)
+    end
+
+    EmailCodeMailer.sign_in(email_address: email_address, code: code).deliver_later
+  end
+
+  def self.digest(email_address, code)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, "#{email_address}:#{code}")
+  end
+
+  def consume(code)
+    with_lock do
+      if consumed_at.nil? && expires_at.future? && ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest(email_address, code))
+        update!(consumed_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+end
