+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+  <p>We sent a six-character code to <strong><%= @email_address %></strong>. It expires in 15 minutes.</p>
+
+  <%= form_with url: email_code_verification_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", minlength: 6, maxlength: 6, class: "input txt-large full-width", placeholder: "Enter your code" %>
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
