@@ -0,0 +1,90 @@
+require "test_helper"
+
+class EmailCodeVerificationsControllerTest < ActionDispatch::IntegrationTest
+  test "signs in with a code emailed to an existing identity" do
+    identity = identities(:kevin)
+    code = nil
+
+    perform_enqueued_jobs do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+      end
+      assert_response :redirect
+      code = ActionMailer::Base.deliveries.last.subject[/\d{6}/]
+    end
+
+    assert code
+    assert_equal "Your Fizzy sign-in code is #{code}", ActionMailer::Base.deliveries.last.subject
+    assert_equal code, ActionMailer::Base.deliveries.last.body.to_s[/\d{6}/]
+
+    untenanted do
+      get email_code_path
+      assert_response :success
+      post email_code_verification_path, params: { code: code }
+      assert_response :redirect
+    end
+
+    assert cookies[:session_token].present?
+  end
+
+  test "signs up after verifying the email code" do
+    email_address = "new-person@example.com"
+    code = nil
+
+    perform_enqueued_jobs do
+      untenanted do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+      assert_response :redirect
+      code = ActionMailer::Base.deliveries.last.subject[/\d{6}/]
+    end
+
+    assert_difference -> { Identity.count }, 1 do
+      untenanted do
+        post email_code_verification_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_signup_completion_url(script_name: "")
+    assert cookies[:session_token].present?
+  end
+
+  test "joins an account after verifying the email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "new-member@example.com"
+    code = nil
+
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+      assert_response :redirect
+      code = ActionMailer::Base.deliveries.last.subject[/\d{6}/]
+    end
+
+    assert_difference -> { User.count }, 1 do
+      post email_code_verification_path(script_name: account.slug), params: { code: code }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert User.exists?(account: account, identity: Identity.find_by!(email_address: email_address))
+  end
+
+  test "wrong code does not create an identity" do
+    actual_code = nil
+    perform_enqueued_jobs do
+      untenanted do
+        post signup_path, params: { signup: { email_address: "new-person@example.com" } }
+      end
+      actual_code = ActionMailer::Base.deliveries.last.subject[/\d{6}/]
+    end
+    wrong_code = actual_code == "000000" ? "111111" : "000000"
+
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        post email_code_verification_path, params: { code: wrong_code }
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..ff68bf9
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "consumes a valid code once" do
+    code = "012345"
+    email_code = EmailCode.create!(
+      email_address: "person@example.com",
+      code_digest: EmailCode.digest("person@example.com", code),
+      expires_at: 15.minutes.from_now
+    )
+
+    assert email_code.consume(code)
+    assert_not email_code.consume(code)
+  end
+
+  test "does not consume an incorrect code" do
+    email_code = EmailCode.create!(
+      email_address: "person@example.com",
+      code_digest: EmailCode.digest("person@example.com", "012345"),
+      expires_at: 15.minutes.from_now
+    )
+
+    assert_not email_code.consume("543210")
+    assert_nil email_code.reload.consumed_at
+  end
+
+  test "does not consume an expired code" do
+    email_code = EmailCode.create!(
+      email_address: "person@example.com",
+      code_digest: EmailCode.digest("person@example.com", "012345"),
+      expires_at: 1.second.ago
+    )
+
+    assert_not email_code.consume("012345")
+    assert_nil email_code.reload.consumed_at
+  end
+end
