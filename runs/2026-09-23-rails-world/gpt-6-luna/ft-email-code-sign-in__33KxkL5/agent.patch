+class EmailCodeVerificationsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def create
+    @flow = session[:email_code_flow]
+
+    if @flow && (email_code = EmailCode.where(email_address: @flow["email_address"], consumed_at: nil).order(created_at: :desc).first) && email_code.consume(code_param)
+      complete_email_code_flow
+    else
+      @email_address = @flow&.dig("email_address") || ""
+      flash.now[:alert] = "That code didn't work. Check it and try again."
+      render "email_codes/show", status: :unprocessable_entity
+    end
+  end
+
+  private
+    def code_param
+      params.expect(:code).to_s
+    end
+
+    def complete_email_code_flow
+      session.delete(:email_code_flow)
+      identity = Identity.find_or_create_by!(email_address: @flow.fetch("email_address")) if @flow.fetch("purpose") != "sign_in"
+      identity ||= Identity.find_by(email_address: @flow.fetch("email_address"))
+
+      if identity.nil?
+        redirect_to new_session_path, alert: "We couldn't find an account for that email address."
+      else
+        start_new_session_for(identity)
+        continue_email_code_flow(identity)
+      end
+    end
+
+    def continue_email_code_flow(identity)
+      case @flow.fetch("purpose")
+      when "sign_up"
+        redirect_to new_signup_completion_path
+      when "join"
+        join_account(identity)
+      else
+        redirect_to after_authentication_url
+      end
+    end
+
+    def join_account(identity)
+      join_code = Account::JoinCode.find_by(code: @flow["join_code"], account: Current.account)
+
+      if join_code&.active?
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: join_code.account, identity: identity)
+        if user.setup?
+          redirect_to landing_url(script_name: join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        terminate_session
+        redirect_to new_session_url, alert: "That join code is no longer active."
+      end
+    end
+end
