diff --git a/app/models/concerns/card_activity_tracking.rb b/app/models/concerns/card_activity_tracking.rb
new file mode 100644
index 0000000..802d6e2
--- /dev/null
+++ b/app/models/concerns/card_activity_tracking.rb
@@ -0,0 +1,24 @@
+module CardActivityTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :touch_card_activity
+    after_update :touch_card_activity
+    before_destroy :touch_card_activity
+  end
+
+  private
+    def touch_card_activity
+      if card = activity_card
+        card.update_columns(last_active_at: Time.current) if card.persisted?
+      end
+    end
+
+    def activity_card
+      if respond_to?(:card)
+        card
+      else
+        reactable.card
+      end
+    end
+end
