diff --git a/test/models/card/burst_test.rb b/test/models/card/burst_test.rb
new file mode 100644
index 0000000..35e96b9
--- /dev/null
+++ b/test/models/card/burst_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Card::BurstTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "A burst of attention", status: :published)
+  end
+
+  test "three comments by at least two people within a third of the auto-close period cause a burst" do
+    board = @card.board
+    board.update! auto_postpone_period: 30.days
+
+    travel_to Time.current do
+      @card.comments.create!(body: "One", creator: users(:david))
+      travel 1.day
+      @card.comments.create!(body: "Two", creator: users(:kevin))
+      travel 1.day
+      @card.comments.create!(body: "Three", creator: users(:david))
+    end
+
+    assert @card.reload.burst_at
+  end
+
+  test "three comments by one person do not cause a burst" do
+    3.times { @card.comments.create!(body: "Still just one person", creator: users(:david)) }
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "comments outside the board burst window do not cause a burst" do
+    @card.board.update! auto_postpone_period: 30.days
+
+    travel_to Time.current do
+      @card.comments.create!(body: "Old one", creator: users(:david))
+      travel 11.days
+      @card.comments.create!(body: "Recent one", creator: users(:kevin))
+      @card.comments.create!(body: "Another recent one", creator: users(:david))
+    end
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "assignment causes a burst" do
+    @card.send(:assign, users(:kevin))
+
+    assert @card.reload.burst_at
+  end
+
+  test "editing the card counts as activity and restarts the stalled timer" do
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: 15.days.ago
+    assert @card.reload.stalled?
+
+    @card.update!(title: "Recently updated")
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "a burst card is stalled after two inactive weeks and activity resets the timer" do
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: 15.days.ago
+
+    assert @card.reload.stalled?
+    assert_includes users(:david).filters.new(indexed_by: "stalled").cards, @card
+
+    @card.comments.create!(body: "We're back", creator: users(:david))
+
+    assert_not @card.reload.stalled?
+    assert_not_includes users(:david).filters.new(indexed_by: "stalled").cards, @card
+  end
+
+  test "editing or removing a comment resets the stalled timer" do
+    comment = @card.comments.create!(body: "First version", creator: users(:david))
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: 15.days.ago
+
+    comment.update!(body: "Edited version")
+    assert_not @card.reload.stalled?
+
+    @card.update_columns last_active_at: 15.days.ago
+    comment.destroy!
+    assert_not @card.reload.stalled?
+  end
+
+  test "assignment and reopening are burst triggers" do
+    @card.send(:assign, users(:kevin))
+    assert @card.reload.burst_at
+
+    closed_card = boards(:writebook).cards.create!(title: "Reopen me", status: :published)
+    closed_card.close
+    closed_card.update_column :burst_at, nil
+    closed_card.reopen
+
+    assert closed_card.reload.burst_at
+  end
+end
