+    mail to: email_address, subject: "Your Fizzy sign-in code is #{@code}"
+  end
+end
diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..39915e5
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,44 @@
+class EmailCode < ApplicationRecord
+  LIFETIME = 15.minutes
+  PURPOSES = %w[ session signup join ].freeze
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :join_code, presence: true, if: -> { purpose == "join" }
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    where("expires_at <= ?", Time.current).delete_all
+    code = format("%06d", SecureRandom.random_number(1_000_000))
+    challenge = create!(email_address: email_address, purpose: purpose, join_code: join_code,
+      code_digest: digest(code), expires_at: LIFETIME.from_now)
+
+    IdentityMailer.email_code(email_address: challenge.email_address, code: code).deliver_now
+    challenge
+  end
+
+  def self.digest(code)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.key_generator.generate_key("email-code"), code)
+  end
+
+  def verify(code)
+    with_lock do
+      if expired?
+        destroy!
+        false
+      elsif code.to_s.match?(/\A\d{6}\z/) && ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest(code))
+        destroy!
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+end
diff --git a/app/views/email_codes/show.html.erb b/app/views/email_codes/show.html.erb
new file mode 100644
index 0000000..2827f64
--- /dev/null
+++ b/app/views/email_codes/show.html.erb
@@ -0,0 +1,22 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+  <p>We sent a six-digit code to <strong><%= @email_code.email_address %></strong>. It expires in 15 minutes.</p>
+
+  <%= form_with url: email_code_path(@email_code), method: :patch, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex flex-column gap-half">
+      <strong><%= form.label :code, "Your code" %></strong>
+      <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", pattern: "[0-9]{6}", maxlength: 6, class: "input txt-large", placeholder: "123456" %>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
