diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..e55e036
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  test "board and account usage sums eligible card and rich text attachments" do
+    board = boards(:writebook)
+    other_board = boards(:private)
+    card = cards(:logo)
+    comment = comments(:logo_1)
+
+    attach_blob(card.image, "card image")
+    attach_blob(rich_text_for(board, :public_description).embeds, "board description file")
+    attach_blob(rich_text_for(card, :description).embeds, "card description file")
+    attach_blob(rich_text_for(comment, :body).embeds, "comment file")
+    attach_blob(rich_text_for(other_board, :public_description).embeds, "other board file")
+
+    board.recalculate_storage_usage_now
+    other_board.recalculate_storage_usage_now
+    board.account.recalculate_storage_usage_now
+
+    assert_equal "card imageboard description filecard description filecomment file".bytesize, board.bytes_used
+    assert_equal "other board file".bytesize, other_board.bytes_used
+    assert_equal board.bytes_used + other_board.bytes_used, board.account.bytes_used
+  end
+
+  test "attachment updates recalculate board and account totals in the background" do
+    card = cards(:logo)
+    attach_blob(card.image, "an uploaded image")
+
+    Board::RecalculateStorageUsageJob.perform_now(card.board.id, card.account_id)
+    Account::RecalculateStorageUsageJob.perform_now(card.account_id)
+
+    assert_equal "an uploaded image".bytesize, card.board.reload.bytes_used
+    assert_equal card.board.bytes_used, card.account.reload.bytes_used
+  end
+
+  test "board and account totals decrease after an attachment is removed" do
+    card = cards(:logo)
+    attach_blob(card.image, "an image")
+
+    board = card.board
+    board.recalculate_storage_usage_now
+    board.account.recalculate_storage_usage_now
+    assert_equal "an image".bytesize, board.bytes_used
+
+    card.image.purge
+    board.recalculate_storage_usage_now
+    board.account.recalculate_storage_usage_now
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, board.account.bytes_used
+  end
+
+  private
+    def attach_blob(attachment, contents)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: "file.txt",
+        content_type: "text/plain",
+        identify: false
+      )
+      attachment.attach(blob)
+    end
+
+    def rich_text_for(record, name)
+      ActionText::RichText.find_or_create_by!(record: record, name: name) do |rich_text|
+        rich_text.body = ""
+      end
+    end
+end
