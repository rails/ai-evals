index 0000000..b1bc26b
--- /dev/null
+++ b/app/jobs/board/recalculate_storage_usage_job.rb
@@ -0,0 +1,11 @@
+class Board::RecalculateStorageUsageJob < ApplicationJob
+  def perform(board_id, account_id)
+    if board = Board.find_by(id: board_id)
+      if board.recalculate_storage_usage_now
+        Current.without_account { Account::RecalculateStorageUsageJob.perform_later(account_id) }
+      end
+    else
+      Current.without_account { Account::RecalculateStorageUsageJob.perform_later(account_id) }
+    end
+  end
+end
diff --git a/app/jobs/storage_usage/recalculate_all_job.rb b/app/jobs/storage_usage/recalculate_all_job.rb
new file mode 100644
index 0000000..b8bbe31
--- /dev/null
+++ b/app/jobs/storage_usage/recalculate_all_job.rb
@@ -0,0 +1,17 @@
+class StorageUsage::RecalculateAllJob < ApplicationJob
+  BATCH_SIZE = 500
+
+  def perform(after_board_id = nil)
+    boards = Board.order(:id)
+    boards = boards.where("id > ?", after_board_id) if after_board_id
+
+    board_ids = boards.limit(BATCH_SIZE).pluck(:id, :account_id)
+    board_ids.each do |board_id, account_id|
+      StorageUsage::Recalculatable.recalculate_board_later(board_id, account_id)
+    end
+
+    if board_ids.size == BATCH_SIZE
+      StorageUsage::RecalculateAllJob.perform_later(board_ids.last.first)
+    end
+  end
+end
