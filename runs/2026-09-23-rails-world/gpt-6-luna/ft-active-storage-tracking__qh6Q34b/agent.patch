+    StorageUsage::Recalculatable.recalculate_board_later(id, account_id)
+  end
+
+  def recalculate_storage_usage_now
+    with_lock do
+      cards = Card.where(board_id: id)
+      comments = Comment.where(card_id: cards.select(:id))
+
+      rich_texts = ActionText::RichText.where(record_type: "Board", record_id: id, name: "public_description")
+        .or(ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description"))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id), name: "body"))
+
+      image_bytes = ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .sum("active_storage_blobs.byte_size")
+      embedded_file_bytes = ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id))
+        .sum("active_storage_blobs.byte_size")
+
+      updated_bytes = image_bytes + embedded_file_bytes
+      if bytes_used != updated_bytes
+        update_column(:bytes_used, updated_bytes)
+        true
+      else
+        false
+      end
+    end
+  end
 end
