diff --git a/app/models/storage_usage/recalculatable.rb b/app/models/storage_usage/recalculatable.rb
new file mode 100644
index 0000000..a8d8fd9
--- /dev/null
+++ b/app/models/storage_usage/recalculatable.rb
@@ -0,0 +1,36 @@
+module StorageUsage::Recalculatable
+  extend ActiveSupport::Concern
+
+  def recalculate_storage_usage_later
+    if board = storage_usage_board
+      StorageUsage::Recalculatable.recalculate_board_later(board.id, board.account_id)
+    end
+  end
+
+  def self.recalculate_board_later(board_id, account_id)
+    Current.without_account do
+      Board::RecalculateStorageUsageJob.perform_later(board_id, account_id)
+    end
+  end
+
+  private
+    def storage_usage_board
+      case self
+      when Board
+        self
+      when Card, Comment
+        board
+      when ActionText::RichText
+        record&.then { |parent| StorageUsage::Recalculatable.board_for(parent) }
+      end
+    end
+
+    def self.board_for(record)
+      case record
+      when Board
+        record
+      when Card, Comment
+        record.board
+      end
+    end
+end
