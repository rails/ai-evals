diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..af0b697
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "create card reaction" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "👍" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "only the reacter can delete a card reaction" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+
+  test "card reactions support the JSON API" do
+    get card_reactions_path(@card), as: :json
+    assert_response :success
+    assert_equal 0, @response.parsed_body.size
+
+    post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    assert_response :created
+    reaction_id = @response.parsed_body.fetch("id")
+
+    get card_reactions_path(@card), as: :json
+    assert_equal 1, @response.parsed_body.size
+
+    delete card_reaction_path(@card, reaction_id), as: :json
+    assert_response :no_content
+  end
+
+  test "new card reaction form" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+    assert_select "form"
+  end
+
+  test "card reactions appear in detail view and preview only when nonzero" do
+    get card_path(@card)
+    assert_response :success
+    assert_select ".card-perma .reactions .reaction", false
+    assert_select ".card__boosts", false
+
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+    get card_path(@card)
+    assert_select ".card-perma .reactions .reaction"
+    get board_column_path(@card.board, @card.column)
+    assert_select ".card__boosts", text: /1/
+  end
+end
