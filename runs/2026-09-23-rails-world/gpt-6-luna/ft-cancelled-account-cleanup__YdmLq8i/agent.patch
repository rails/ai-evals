diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..e3993b5
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago" do
+    travel_to Time.current do
+      due_account = account_with_cancellation(created_at: 31.days.ago)
+      recent_account = account_with_cancellation(created_at: 29.days.ago)
+      storage_entry = Storage::Entry.create!(account: due_account, delta: 1, operation: "upload")
+      active_account = Account.create!(name: "Still active")
+
+      Account::IncinerateDueJob.perform_now
+
+      assert_not Account.exists?(due_account.id)
+      assert_not Storage::Entry.exists?(storage_entry.id)
+      assert Account.exists?(recent_account.id)
+      assert Account.exists?(active_account.id)
+    end
+  end
+
+  test "does not incinerate an account canceled exactly at the grace period boundary" do
+    travel_to Time.current do
+      account = account_with_cancellation(created_at: 30.days.ago)
+
+      Account::IncinerateDueJob.perform_now
+
+      assert Account.exists?(account.id)
+    end
+  end
+
+  private
+    def account_with_cancellation(created_at:)
+      account = Account.create!(name: "Canceled account")
+      account.create_cancellation!(initiated_by: users(:david), created_at: created_at)
+      account
+    end
+end
