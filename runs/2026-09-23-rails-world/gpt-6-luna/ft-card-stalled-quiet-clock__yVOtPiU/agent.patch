index 9454465..64c17ed 100644
--- a/app/models/card/eventable.rb
+++ b/app/models/card/eventable.rb
@@ -12,10 +12,28 @@ module Card::Eventable
   def event_was_created(event)
     transaction do
       create_system_comment_for(event)
+      register_burst if event.action.in?(%w[card_assigned card_reopened])
       touch_last_active_at unless was_just_published?
     end
   end
 
+  def register_burst(at: Time.current)
+    update!(burst_at: at)
+  end
+
+  def stalled?(as_of: Time.current)
+    !!(burst_at.present? && last_active_at <= as_of - 14.days)
+  end
+
+  def register_comment_activity(comment)
+    window = auto_postpone_period / 3.0
+    recent_comments = comments.by_user.where(created_at: (comment.created_at - window)..comment.created_at)
+
+    if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+      register_burst(at: comment.created_at)
+    end
+  end
+
   def touch_last_active_at
     # Not using touch so that we can detect attribute change on callbacks
     update!(last_active_at: Time.current)
