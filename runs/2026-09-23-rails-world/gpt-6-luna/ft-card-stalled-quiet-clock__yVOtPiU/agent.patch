diff --git a/test/models/card/burst_test.rb b/test/models/card/burst_test.rb
new file mode 100644
index 0000000..658f966
--- /dev/null
+++ b/test/models/card/burst_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Card::BurstTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments by at least two people within a third of auto-close period cause a burst" do
+    card = create_card
+    freeze_time
+
+    card.comments.create!(body: "First", creator: users(:david))
+    card.comments.create!(body: "Second", creator: users(:david))
+    card.comments.create!(body: "Third", creator: users(:kevin))
+
+    assert_equal Time.current, card.reload.burst_at
+    assert_not card.stalled?
+  end
+
+  test "comments by only one person do not cause a burst" do
+    card = create_card
+    freeze_time
+
+    3.times { |i| card.comments.create!(body: "Comment #{i}", creator: users(:david)) }
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "comments outside one third of auto-close period do not cause a burst" do
+    card = create_card
+    card.board.entropy.update!(auto_postpone_period: 3.days.to_i)
+
+    travel_to 2.days.ago do
+      card.comments.create!(body: "First", creator: users(:david))
+      card.comments.create!(body: "Second", creator: users(:kevin))
+    end
+    travel_to Time.current do
+      card.comments.create!(body: "Third", creator: users(:david))
+    end
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "assignment and reopening cause a burst" do
+    assigned_card = create_card
+    with_current_user(:david) { assigned_card.toggle_assignment(users(:kevin)) }
+    assert assigned_card.reload.burst_at
+
+    reopened_card = cards(:shipping)
+    reopened_card.reopen
+    assert reopened_card.reload.burst_at
+  end
+
+  test "a burst card stalls after two weeks without activity and activity resets the timer" do
+    card = create_card
+    now = Time.current
+    card.update_columns(burst_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    assert card.stalled?(as_of: now)
+    assert_includes Card.stalled(as_of: now), card
+
+    card.comments.create!(body: "A fresh comment", creator: users(:david))
+    assert_not card.reload.stalled?(as_of: now)
+    assert_not_includes Card.stalled(as_of: now), card
+
+    card.update_columns(burst_at: 15.days.ago, last_active_at: 15.days.ago)
+    card.steps.create!(content: "A fresh step")
+    assert_not card.reload.stalled?(as_of: now)
+  end
+
+  private
+    def create_card
+      boards(:writebook).cards.create!(title: "Burst test card", status: :published, creator: users(:david))
+    end
+end
