index 0000000..c269463
--- /dev/null
+++ b/app/models/concerns/card_activity.rb
@@ -0,0 +1,17 @@
+module CardActivity
+  extend ActiveSupport::Concern
+
+  included do
+    after_save :register_card_activity
+    after_destroy :register_card_activity
+  end
+
+  private
+    def register_card_activity
+      card.update_column(:last_active_at, Time.current) unless card.destroyed? || system_activity?
+    end
+
+    def system_activity?
+      respond_to?(:user) && user&.system?
+    end
+end
