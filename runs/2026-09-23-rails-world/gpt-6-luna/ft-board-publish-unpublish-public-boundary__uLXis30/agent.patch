diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..c0413da
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admin can publish and unpublish a board" do
+    board = boards(:writebook)
+    assert_nil board.public_key
+
+    post board_publication_path(board)
+    assert_redirected_to edit_board_path(board)
+    key = board.reload.public_key
+    assert key.present?
+    assert_equal 43, key.length
+
+    post board_publication_path(board)
+    assert_equal key, board.reload.public_key
+
+    delete board_publication_path(board)
+    assert_redirected_to edit_board_path(board)
+    assert_nil board.reload.public_key
+  end
+
+  test "non-admin cannot publish or unpublish a board" do
+    logout_and_sign_in_as :jz
+    board = boards(:writebook)
+
+    post board_publication_path(board)
+    assert_response :forbidden
+    assert_nil board.reload.public_key
+
+    board.update!(public_key: "secret-key")
+    delete board_publication_path(board)
+    assert_response :forbidden
+    assert_equal "secret-key", board.reload.public_key
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..4fea695
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    boards(:writebook).update!(public_key: "secret-board-key")
+  end
+
+  test "anyone can view a published board and its published cards" do
+    get public_board_path("secret-board-key", script_name: nil)
+    assert_response :success
+    assert_includes response.body, "Writebook"
+    assert_select "li", text: cards(:logo).title
+    assert_no_match "unfinished", response.body
+  end
+
+  test "board JSON includes public URL and published columns/cards" do
+    get public_board_path("secret-board-key", format: :json, script_name: nil)
+    assert_response :success
+
+    body = response.parsed_body
+    assert_equal "Writebook", body["name"]
+    assert_equal "http://www.example.com/public/boards/secret-board-key", body["public_url"]
+    assert body["columns"].any? { |column| column["cards"].any? }
+  end
+
+  test "public URL is nil when the board is unpublished" do
+    sign_in_as :kevin
+    boards(:writebook).update!(public_key: nil)
+    get board_path(boards(:writebook), format: :json)
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "board JSON includes public URL when published" do
+    sign_in_as :kevin
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+
+    get board_path(board, format: :json)
+    assert_response :success
+    assert_equal "http://www.example.com/public/boards/secret-board-key", response.parsed_body["public_url"]
+  end
+
+  test "published board columns and cards can be opened directly" do
+    column = columns(:writebook_triage)
+    get public_board_column_path("secret-board-key", column, script_name: nil)
+    assert_response :success
+    assert_select "li", text: cards(:logo).title
+
+    get public_board_card_path("secret-board-key", cards(:logo).number, script_name: nil)
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+  end
+
+  test "unknown boards, unrelated columns, and unpublished cards are not exposed" do
+    get public_board_path("invalid-key", script_name: nil)
+    assert_response :not_found
+
+    boards(:miltons_wish_list).update!(public_key: "other-secret-key")
+    other_column = Current.set(account: accounts("initech"), user: users(:mike)) do
+      boards(:miltons_wish_list).columns.create!(name: "Private column")
+    end
+    get public_board_column_path("secret-board-key", other_column, script_name: nil)
+    assert_response :not_found
+
+    get public_board_card_path("other-secret-key", cards(:shipping).number, script_name: nil)
+    assert_response :not_found
+
+    get public_board_card_path("other-secret-key", cards(:unfinished_thoughts).number, script_name: nil)
+    assert_response :not_found
+  end
+
+  test "unpublishing revokes the public URL" do
+    board = boards(:writebook)
+    board.unpublish_publicly
+
+    get public_board_path("secret-board-key", script_name: nil)
+    assert_response :not_found
+  end
+end
