index 0000000..12b23e1
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,27 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :set_board
+  before_action :ensure_admin
+
+  def create
+    @board.publish_publicly
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.json { render "boards/show" }
+    end
+  end
+
+  def destroy
+    @board.unpublish_publicly
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.json { render "boards/show" }
+    end
+  end
+
+  private
+    def set_board
+      @board = Current.account.boards.find(params[:board_id])
+    end
+end
diff --git a/app/controllers/public/boards_controller.rb b/app/controllers/public/boards_controller.rb
new file mode 100644
index 0000000..9f2b43c
--- /dev/null
+++ b/app/controllers/public/boards_controller.rb
@@ -0,0 +1,45 @@
+class Public::BoardsController < ApplicationController
+  layout false
+
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  before_action :set_board
+  before_action :set_column, only: :column
+  before_action :set_card, only: :card
+
+  def show
+    respond_to do |format|
+      format.html
+      format.json
+    end
+  end
+
+  def column
+    respond_to do |format|
+      format.html { render :column }
+      format.json { render :column }
+    end
+  end
+
+  def card
+    respond_to do |format|
+      format.html { render :card }
+      format.json { render :card }
+    end
+  end
+
+  private
+    def set_board
+      @board = Board.find_by!(public_key: params[:board_key] || params[:key])
+    end
+
+    def set_column
+      @column = @board.columns.find(params[:column_id])
+      @cards = @column.cards.published.latest
+    end
+
+    def set_card
+      @card = @board.cards.published.find_by!(number: params[:card_number])
+    end
+end
