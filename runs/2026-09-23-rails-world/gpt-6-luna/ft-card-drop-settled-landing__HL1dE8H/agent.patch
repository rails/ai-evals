diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..93c352f
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,163 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  initialize() {
+    this.pendingRequests = new WeakMap()
+  }
+
+  start(event) {
+    const card = event.target.closest(".card[draggable='true']")
+
+    if (!card) return
+
+    this.card = card
+    this.sourceColumn = card.closest(".cards")
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add("drag-and-drop__dragged-item")
+  }
+
+  end() {
+    this.#clearDragState()
+  }
+
+  over(event) {
+    const column = this.#columnFor(event.target)
+
+    if (!this.#canDropIn(column)) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.#setHoveredColumn(column)
+  }
+
+  leave(event) {
+    const column = this.#columnFor(event.target)
+
+    if (column && !column.contains(event.relatedTarget)) {
+      column.classList.remove("drag-and-drop__hover-container")
+    }
+  }
+
+  drop(event) {
+    const column = this.#columnFor(event.target)
+
+    if (!this.#canDropIn(column)) return
+
+    event.preventDefault()
+
+    const card = this.card
+    const previousParent = card.parentElement
+    const previousSibling = card.nextElementSibling
+    const destination = this.#destinationFor(column)
+
+    if (!destination) return
+
+    column.querySelectorAll(".blank-slate").forEach(blankSlate => blankSlate.remove())
+    this.#placeCard(card, destination, column.dataset.dragAndDropColumnId || column.id === "maybe")
+    this.#clearDragState()
+
+    this.#saveMove(card, column, destination, previousParent, previousSibling)
+  }
+
+  #columnFor(element) {
+    return element instanceof Element ? element.closest(".cards") : null
+  }
+
+  #canDropIn(column) {
+    return this.card && column && this.element.contains(column) && column !== this.sourceColumn
+  }
+
+  #setHoveredColumn(column) {
+    this.element.querySelectorAll(".drag-and-drop__hover-container").forEach(hoveredColumn => {
+      if (hoveredColumn !== column) hoveredColumn.classList.remove("drag-and-drop__hover-container")
+    })
+    column.classList.add("drag-and-drop__hover-container")
+  }
+
+  #placeCard(card, destination, withGoldenFirst) {
+    if (withGoldenFirst && !card.classList.contains("golden-effect")) {
+      const firstNonGoldenCard = Array.from(destination.querySelectorAll(".card")).find(existingCard => {
+        return !existingCard.classList.contains("golden-effect")
+      })
+
+      if (firstNonGoldenCard) {
+        firstNonGoldenCard.before(card)
+      } else {
+        const lastCard = destination.querySelector(".card:last-of-type")
+        lastCard ? lastCard.after(card) : destination.prepend(card)
+      }
+    } else {
+      destination.prepend(card)
+    }
+  }
+
+  #destinationFor(column) {
+    const list = column.querySelector(".cards__list")
+
+    if (list) return list
+
+    const frame = column.querySelector("turbo-frame")
+
+    if (frame) {
+      const newList = document.createElement("div")
+      newList.className = "cards__list hide-scrollbar"
+      frame.append(newList)
+      return newList
+    }
+
+    return column.querySelector(".cards__transition-container")
+  }
+
+  #saveMove(card, column, destination, previousParent, previousSibling) {
+    let url
+    let method
+    const columnId = column.dataset.dragAndDropColumnId
+
+    if (columnId) {
+      url = new URL(card.dataset.cardDragTriageUrl, window.location.origin)
+      url.searchParams.set("column_id", columnId)
+      method = "POST"
+    } else if (column.id === "closed-cards") {
+      url = card.dataset.cardClosureUrl
+      method = "POST"
+    } else if (column.id === "not-now") {
+      url = card.dataset.cardNotNowUrl
+      method = "POST"
+    } else if (column.id === "maybe") {
+      url = card.dataset.cardDragTriageUrl
+      method = "DELETE"
+    }
+
+    if (!url) return
+
+    const previousRequest = this.pendingRequests.get(card) || Promise.resolve()
+    const request = previousRequest.catch(() => {}).then(() => fetch(url, {
+      method,
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']")?.content
+      }
+    })).then(response => {
+      if (!response.ok) throw new Error(`Unable to move card (${response.status})`)
+    }).catch(error => {
+      console.error(error)
+
+      if (card.parentElement === destination) {
+        previousParent.insertBefore(card, previousSibling?.parentElement === previousParent ? previousSibling : null)
+      }
+    })
+
+    this.pendingRequests.set(card, request)
+  }
+
+  #clearDragState() {
+    this.card?.classList.remove("drag-and-drop__dragged-item")
+    this.element.querySelectorAll(".drag-and-drop__hover-container").forEach(column => {
+      column.classList.remove("drag-and-drop__hover-container")
+    })
+    this.card = null
+    this.sourceColumn = null
+  }
+}
