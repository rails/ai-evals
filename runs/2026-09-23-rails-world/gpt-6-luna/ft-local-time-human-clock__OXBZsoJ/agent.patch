diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..852fce0
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,89 @@
+const relativeFormatter = new Intl.RelativeTimeFormat(undefined, { numeric: "auto" })
+
+export function formatLocalTime(timestamp, format) {
+  switch (format) {
+    case "relative":
+      return formatRelativeTime(timestamp)
+    case "comment":
+      return formatCommentTime(timestamp)
+    case "deadline":
+      return formatDeadline(timestamp)
+    case "time":
+      return new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(timestamp)
+    case "weekday-date":
+      return new Intl.DateTimeFormat(undefined, { weekday: "long", month: "long", day: "numeric" }).format(timestamp)
+    case "full-date":
+      return new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", year: "numeric" }).format(timestamp)
+    case "date":
+      return formatDate(timestamp)
+    case "datetime":
+      return new Intl.DateTimeFormat(undefined, { dateStyle: "short", timeStyle: "short" }).format(timestamp)
+    default:
+      return formatDate(timestamp)
+  }
+}
+
+function formatCommentTime(timestamp) {
+  const daysFromToday = calendarDayDifference(new Date(), timestamp)
+
+  if (daysFromToday === 0) {
+    return formatLocalTime(timestamp, "time")
+  } else if (daysFromToday === -1) {
+    return "yesterday"
+  } else if (daysFromToday < 0 && daysFromToday >= -6) {
+    return relativeFormatter.format(daysFromToday, "day")
+  } else if (daysFromToday === 1) {
+    return "tomorrow"
+  } else if (daysFromToday > 1 && daysFromToday <= 6) {
+    return relativeFormatter.format(daysFromToday, "day")
+  } else {
+    return formatDate(timestamp)
+  }
+}
+
+function formatDeadline(timestamp) {
+  const daysFromToday = calendarDayDifference(new Date(), timestamp)
+
+  if (daysFromToday === 0) {
+    return "today"
+  } else if (daysFromToday === 1) {
+    return "tomorrow"
+  } else if (daysFromToday > 1 && daysFromToday <= 6) {
+    return relativeFormatter.format(daysFromToday, "day")
+  } else {
+    return formatDate(timestamp)
+  }
+}
+
+function formatRelativeTime(timestamp) {
+  const seconds = (timestamp.getTime() - Date.now()) / 1000
+  const units = [
+    [ 60, "second" ],
+    [ 60, "minute" ],
+    [ 24, "hour" ],
+    [ 7, "day" ],
+    [ 4.34524, "week" ],
+    [ 12, "month" ],
+    [ Infinity, "year" ]
+  ]
+
+  let value = seconds
+  for (const [ threshold, unit ] of units) {
+    if (Math.abs(value) < threshold) {
+      return relativeFormatter.format(Math.round(value), unit)
+    }
+    value /= threshold
+  }
+}
+
+function formatDate(timestamp) {
+  const options = { month: "short", day: "numeric" }
+  if (timestamp.getFullYear() !== new Date().getFullYear()) options.year = "numeric"
+  return new Intl.DateTimeFormat(undefined, options).format(timestamp)
+}
+
+function calendarDayDifference(fromDate, toDate) {
+  const from = Date.UTC(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const to = Date.UTC(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return Math.round((to - from) / 86_400_000)
+}
