diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..71babcc
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+function parseLocalDate(value) {
+  const [ year, month, day ] = value.split("-").map(Number)
+  return new Date(year, month - 1, day)
+}
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    const timestamp = this.element.dateTime.match(/^\d{4}-\d{2}-\d{2}$/)
+      ? parseLocalDate(this.element.dateTime)
+      : new Date(this.element.dateTime)
+
+    if (!Number.isNaN(timestamp.getTime())) {
+      const rendered = formatLocalTime(timestamp, this.formatValue)
+      this.element.textContent = rendered
+      this.element.setAttribute("aria-label", rendered)
+    }
+  }
+}
