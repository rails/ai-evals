diff --git a/test/models/notification/email_window_test.rb b/test/models/notification/email_window_test.rb
new file mode 100644
index 0000000..9971da6
--- /dev/null
+++ b/test/models/notification/email_window_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Notification::EmailWindowTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "notifications arriving after the window deadline still join its open window" do
+    first_notification = create_notification(cards(:layout), events(:layout_published))
+    window = first_notification.email_window
+
+    travel 5.hours do
+      second_notification = create_notification(cards(:buy_domain), events(:buy_domain_sent_back_to_triage))
+      assert_equal window, second_notification.email_window
+    end
+
+    assert_equal 2, window.notifications.count
+    assert_equal 1, enqueued_jobs.count { |job| job[:job] == Notification::EmailWindowDeliveryJob }
+  end
+
+  test "delivery sends one digest and future notifications open a new window" do
+    first_notification = create_notification(cards(:layout), events(:layout_published))
+    first_window = first_notification.email_window
+    create_notification(cards(:buy_domain), events(:buy_domain_sent_back_to_triage))
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      first_window.deliver_now
+    end
+
+    assert first_window.reload.sent_at
+    assert_equal 2, ActionMailer::Base.deliveries.last.body.encoded.scan(/href=/).length
+
+    later_notification = create_notification(cards(:text), events(:text_published))
+    assert_not_equal first_window, later_notification.email_window
+    assert_nil later_notification.email_window.sent_at
+  end
+
+  test "never does not create an email window" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    notification = create_notification(cards(:layout), events(:layout_published))
+
+    assert_nil notification.email_window
+  end
+
+test "turning email off closes the open window" do
+  notification = create_notification(cards(:layout), events(:layout_published))
+  window = notification.email_window
+
+  @user.settings.update_bundle_email_frequency("never")
+
+  assert window.reload.sent_at
+  assert_no_difference -> { Notification::EmailWindow.where(user: @user, sent_at: nil).count } do
+    create_notification(cards(:buy_domain), events(:buy_domain_sent_back_to_triage))
+  end
+end
+
+  test "frequency only accepts supported choices" do
+    [ "never", "every_few_hours", "daily", "weekly" ].each do |frequency|
+      @user.settings.bundle_email_frequency = frequency
+      assert_predicate @user.settings, :valid?
+    end
+
+    @user.settings.bundle_email_frequency = "hourly"
+    assert_not_predicate @user.settings, :valid?
+  end
+
+  private
+    def create_notification(card, source)
+      Notification.create!(user: @user, source: source, creator: users(:jason), card: card)
+    end
+end
