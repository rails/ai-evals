   private
+    def bundle_email
+      if (settings = user.settings) && user.active? && account.active? && !creator.system?
+        window_to_schedule = nil
+
+        settings.with_lock do
+          settings.reload
+          interval = User::Settings::BUNDLE_EMAIL_INTERVALS[settings.bundle_email_frequency]
+
+          if interval
+            window = Notification::EmailWindow.where(user: user, sent_at: nil).order(:started_at).first
+
+            unless window
+              started_at = Time.current
+              window = Notification::EmailWindow.create!(
+                account: account,
+                user: user,
+                started_at: started_at,
+                deliver_at: started_at + interval
+              )
+              window_to_schedule = window
+            end
+
+            update!(email_window: window)
+          end
+        end
+
+        if window_to_schedule
+          Current.with_account(account) do
+            Notification::EmailWindowDeliveryJob.set(wait_until: window_to_schedule.deliver_at).perform_later(window_to_schedule)
+          end
+        end
+      end
+    end
+
     def set_card
       self.card = source.card
     end
diff --git a/app/models/notification/email_window.rb b/app/models/notification/email_window.rb
new file mode 100644
index 0000000..277d127
--- /dev/null
+++ b/app/models/notification/email_window.rb
@@ -0,0 +1,21 @@
+class Notification::EmailWindow < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", foreign_key: :email_window_id
+
+  def deliver_now
+    user.settings.with_lock do
+      reload
+
+      if sent_at.nil?
+        notifications_to_deliver = notifications.preloaded.to_a
+
+        if notifications_to_deliver.any? && user.settings.bundle_email_frequency != "never" && user.active? && account.active? && user.identity
+          NotificationMailer.digest(user: user, notifications: notifications_to_deliver).deliver_now
+        end
+
+        update!(sent_at: Time.current)
+      end
+    end
+  end
+end
