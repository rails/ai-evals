diff --git a/test/models/notification/email_digest_window_test.rb b/test/models/notification/email_digest_window_test.rb
new file mode 100644
index 0000000..63f5e28
--- /dev/null
+++ b/test/models/notification/email_digest_window_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Notification::EmailDigestWindowTest < ActiveSupport::TestCase
+  test "first notification opens a window and following notifications share its fixed deadline" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    first_notification = notifications(:logo_assignment_kevin)
+    second_notification = notifications(:layout_commented_kevin)
+    now = Time.zone.parse("2026-06-01 12:00:00")
+
+    travel_to now do
+      Notification::EmailDigestWindow.capture(first_notification)
+      window = first_notification.reload.email_digest_window
+
+      travel 30.minutes
+      Notification::EmailDigestWindow.capture(second_notification)
+
+      assert_equal window, second_notification.reload.email_digest_window
+      assert_equal now, window.opened_at
+      assert_equal now + 1.day, window.closes_at
+    end
+  end
+
+  test "late notifications join a still-open window and a new window starts only after it is sent" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+    first_notification = notifications(:logo_assignment_kevin)
+    late_notification = notifications(:layout_commented_kevin)
+    next_notification = notifications(:buy_domain_sent_back_to_triage_kevin)
+    now = Time.zone.parse("2026-06-01 12:00:00")
+
+    travel_to now do
+      Notification::EmailDigestWindow.capture(first_notification)
+      window = first_notification.reload.email_digest_window
+
+      travel 5.hours
+      Notification::EmailDigestWindow.capture(late_notification)
+      assert_equal window, late_notification.reload.email_digest_window
+
+      window.update_column(:sent_at, Time.current)
+      Notification::EmailDigestWindow.capture(next_notification)
+      refute_equal window, next_notification.reload.email_digest_window
+    end
+  end
+
+  test "due window sends one email containing its notifications" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:logo_assignment_kevin)
+    now = Time.zone.parse("2026-06-01 12:00:00")
+
+    travel_to now do
+      Notification::EmailDigestWindow.capture(notification)
+      window = notification.reload.email_digest_window
+
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        travel 1.day
+        window.deliver_now
+      end
+
+      assert window.reload.sent_at
+      assert_equal 1, ActionMailer::Base.deliveries.last.to.length
+      assert_includes ActionMailer::Base.deliveries.last.body.encoded, notification.card.title
+    end
+  end
+
+  test "creating a notification captures it in the user's enabled digest" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "weekly")
+    notifications(:layout_commented_kevin).destroy
+
+    notification = Notification.create!(user: user, source: events(:layout_commented), creator: users(:david))
+
+    assert notification.reload.email_digest_window
+    assert_equal 1.week, notification.email_digest_window.closes_at - notification.email_digest_window.opened_at
+  end
+
+  test "turning email off before delivery prevents sending" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:logo_assignment_kevin)
+
+    Notification::EmailDigestWindow.capture(notification)
+    window = notification.reload.email_digest_window
+    user.settings.update!(bundle_email_frequency: "never")
+
+    travel_to window.closes_at + 1.second do
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        window.deliver_now
+      end
+    end
+    assert window.reload.sent_at
+  end
+
+  test "never does not create a digest window" do
+    notification = notifications(:logo_assignment_kevin)
+
+    Notification::EmailDigestWindow.capture(notification)
+
+    assert_nil notification.reload.email_digest_window
+    assert_empty Notification::EmailDigestWindow.where(user: notification.user)
+  end
+end
