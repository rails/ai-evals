diff --git a/app/models/notification/email_digest_window.rb b/app/models/notification/email_digest_window.rb
new file mode 100644
index 0000000..f956105
--- /dev/null
+++ b/app/models/notification/email_digest_window.rb
@@ -0,0 +1,55 @@
+class Notification::EmailDigestWindow < ApplicationRecord
+  FREQUENCIES = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, foreign_key: :email_digest_window_id, dependent: :nullify
+
+  after_create_commit :deliver_later
+
+  def self.capture(notification)
+    notification.user.with_lock do
+      frequency = notification.user.settings&.bundle_email_frequency
+
+      if FREQUENCIES.key?(frequency)
+        window = notification.user.notification_email_digest_windows.where(sent_at: nil).order(:opened_at).first
+        if window.nil?
+          opened_at = Time.current
+          window = notification.user.notification_email_digest_windows.create!(
+            account: notification.account,
+            opened_at: opened_at,
+            closes_at: opened_at + FREQUENCIES.fetch(frequency)
+          )
+        end
+        notification.update_column(:email_digest_window_id, window.id)
+      end
+    end
+  end
+
+  def deliver_now
+    user.with_lock do
+      reload
+      if sent_at.nil?
+        if closes_at <= Time.current
+          Current.set(account: account) do
+            if user.active? && user.identity.present? && FREQUENCIES.key?(user.settings&.bundle_email_frequency) && notifications.exists?
+              NotificationDigestMailer.digest(self).deliver_now
+            end
+            update!(sent_at: Time.current)
+          end
+        else
+          Notification::EmailDigestJob.set(wait: closes_at - Time.current + 1.second).perform_later(self)
+        end
+      end
+    end
+  end
+
+  private
+    def deliver_later
+      Notification::EmailDigestJob.set(wait_until: closes_at).perform_later(self)
+    end
+end
