diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..1070259
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  test "refreshes the account and board with only counted attachments" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    attach(board, "embeds", 30, "Board", "public_description")
+    attach(card, "image", 40)
+    attach(card, "embeds", 60, "Card", "description")
+    attach(comments(:logo_1), "embeds", 20, "Comment", "body")
+    attach(card, "unrelated", 100)
+    attach(identities(:david), "avatar", 200)
+
+    StorageUsage::RefreshJob.perform_now(account.id, board.id)
+
+    assert_equal 150, board.reload.bytes_used
+    assert_equal 150, account.reload.bytes_used
+  end
+
+  test "the first read schedules an initial background calculation" do
+    account = accounts(:"37s")
+
+    assert_enqueued_jobs 1, only: StorageUsage::RefreshJob do
+      assert_equal 0, account.bytes_used
+      assert_equal 0, account.bytes_used
+    end
+  end
+
+  test "attachment changes schedule a background refresh" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+
+    assert_enqueued_with(job: StorageUsage::RefreshJob, args: [ account.id, board.id ]) do
+      attach(cards(:logo), "image", 17)
+    end
+  end
+
+  test "removing an attachment schedules a refresh" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    attachment = attach(cards(:logo), "image", 17)
+
+    StorageUsage::RefreshJob.perform_now(account.id, board.id)
+    assert_equal 17, account.reload.bytes_used
+
+    assert_enqueued_with(job: StorageUsage::RefreshJob, args: [ account.id, board.id ]) do
+      attachment.destroy!
+    end
+
+    StorageUsage::RefreshJob.perform_now(account.id, board.id)
+    assert_equal 0, account.reload.bytes_used
+  end
+
+test "moving a card refreshes usage on both boards" do
+  account = accounts(:"37s")
+  card = cards(:logo)
+  old_board = card.board
+  new_board = boards(:private)
+  attach(card, "image", 17)
+  StorageUsage::RefreshJob.perform_now(account.id, old_board.id)
+  StorageUsage::RefreshJob.perform_now(account.id, new_board.id)
+  clear_enqueued_jobs
+
+  assert_enqueued_jobs 2, only: StorageUsage::RefreshJob do
+    Current.with(account: account, user: users(:david)) do
+      card.update!(board: new_board)
+    end
+  end
+
+  StorageUsage::RefreshJob.perform_now(account.id, old_board.id)
+  StorageUsage::RefreshJob.perform_now(account.id, new_board.id)
+  assert_equal 0, old_board.reload.bytes_used
+  assert_equal 17, new_board.reload.bytes_used
+end
+  test "account usage includes attachments from all boards while board usage remains scoped" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    another_board = boards(:private)
+    other_board_card = cards(:logo).dup
+    other_board_card.id = ActiveRecord::Type::Uuid.generate
+    other_board_card.creator = cards(:logo).creator
+    other_board_card.status = :drafted
+    other_board_card.board = another_board
+    other_board_card.number = nil
+    other_board_card.save!
+
+    attach(cards(:logo), "image", 17)
+    attach(other_board_card, "image", 23)
+
+    StorageUsage::RefreshJob.perform_now(account.id, board.id)
+
+    assert_equal 17, board.reload.bytes_used
+    assert_equal 40, account.reload.bytes_used
+  end
+
+  private
+    def attach(record, name, byte_size, rich_text_record_type = nil, rich_text_name = nil)
+      if rich_text_record_type
+        record = ActionText::RichText.create!(
+          account: accounts(:"37s"), record: record, record_type: rich_text_record_type,
+          name: rich_text_name, body: ""
+        )
+      end
+
+      blob = ActiveStorage::Blob.create!(
+        account: accounts(:"37s"), key: SecureRandom.hex(16), filename: "file.txt",
+        byte_size: byte_size, checksum: "checksum", service_name: "local"
+      )
+
+      ActiveStorage::Attachment.create!(
+        account: accounts(:"37s"), record: record, name: name, blob: blob
+      )
+    end
+end
