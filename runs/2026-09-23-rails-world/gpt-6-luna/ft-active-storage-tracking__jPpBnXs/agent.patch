diff --git a/app/jobs/storage_usage/refresh_job.rb b/app/jobs/storage_usage/refresh_job.rb
new file mode 100644
index 0000000..2067264
--- /dev/null
+++ b/app/jobs/storage_usage/refresh_job.rb
@@ -0,0 +1,25 @@
+class StorageUsage::RefreshJob < ApplicationJob
+  queue_as :backend
+
+  def perform(account_id, board_id = nil)
+    if account = Account.find_by(id: account_id)
+      account.with_lock do
+        account.update_columns(
+          bytes_used: StorageUsage.bytes_used_for_account(account),
+          bytes_used_calculated_at: Time.current,
+          bytes_used_refresh_requested_at: nil
+        )
+      end
+    end
+
+    if board_id && (board = Board.find_by(id: board_id))
+      board.with_lock do
+        board.update_columns(
+          bytes_used: StorageUsage.bytes_used_for_board(board),
+          bytes_used_calculated_at: Time.current,
+          bytes_used_refresh_requested_at: nil
+        )
+      end
+    end
+  end
+end
