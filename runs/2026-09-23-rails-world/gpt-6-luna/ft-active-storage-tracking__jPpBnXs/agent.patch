diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..5ccf8e8
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,66 @@
+module StorageUsage
+  def self.bytes_used_for_account(account)
+    attachments_for_account(account).sum("active_storage_blobs.byte_size")
+  end
+
+  def self.bytes_used_for_board(board)
+    board_id = Board.connection.quote(Board.type_for_attribute("id").serialize(board.id))
+    condition = <<~SQL.squish.gsub(":board_id", board_id)
+      (active_storage_attachments.record_type = 'Card'
+        AND active_storage_attachments.name = 'image'
+        AND cards.board_id = :board_id)
+      OR
+      (active_storage_attachments.record_type = 'ActionText::RichText'
+        AND active_storage_attachments.name = 'embeds'
+        AND ((action_text_rich_texts.record_type = 'Board'
+              AND action_text_rich_texts.record_id = :board_id)
+          OR (action_text_rich_texts.record_type IN ('Card', 'Comment')
+              AND cards.board_id = :board_id)))
+    SQL
+
+    attachments_for_account(board.account).where(condition).sum("active_storage_blobs.byte_size")
+  end
+
+  def self.request_initial_refresh(record)
+    return unless record.bytes_used_calculated_at.nil?
+
+    requested_at = Time.current
+    claimed = record.class.where(id: record.id, bytes_used_calculated_at: nil)
+      .where("bytes_used_refresh_requested_at IS NULL OR bytes_used_refresh_requested_at < ?", 5.minutes.ago)
+      .update_all(bytes_used_refresh_requested_at: requested_at)
+
+    if claimed.positive?
+      account_id, board_id = if record.is_a?(Account)
+        [ record.id, nil ]
+      else
+        [ record.account_id, record.id ]
+      end
+      refresh_later(account_id, board_id)
+    end
+  end
+
+  def self.refresh_later(account_id, board_id = nil)
+    Current.without_account { StorageUsage::RefreshJob.perform_later(account_id, board_id) }
+  end
+
+  def self.attachments_for_account(account)
+    ActiveStorage::Attachment
+      .joins(:blob)
+      .joins("LEFT JOIN action_text_rich_texts ON active_storage_attachments.record_type = 'ActionText::RichText' AND active_storage_attachments.record_id = action_text_rich_texts.id")
+      .joins("LEFT JOIN comments ON action_text_rich_texts.record_type = 'Comment' AND action_text_rich_texts.record_id = comments.id")
+      .joins(<<~SQL.squish)
+        LEFT JOIN cards ON
+          (active_storage_attachments.record_type = 'Card' AND active_storage_attachments.record_id = cards.id)
+          OR (action_text_rich_texts.record_type = 'Card' AND action_text_rich_texts.record_id = cards.id)
+          OR comments.card_id = cards.id
+      SQL
+      .where(active_storage_attachments: { account_id: account.id })
+      .where(<<~SQL.squish)
+        (active_storage_attachments.record_type = 'Card' AND active_storage_attachments.name = 'image')
+        OR (active_storage_attachments.record_type = 'ActionText::RichText'
+          AND active_storage_attachments.name = 'embeds'
+          AND action_text_rich_texts.record_type IN ('Board', 'Card', 'Comment'))
+      SQL
+  end
+  private_class_method :attachments_for_account
+end
diff --git a/app/models/storage_usage/trackable_attachment.rb b/app/models/storage_usage/trackable_attachment.rb
new file mode 100644
index 0000000..1004a09
--- /dev/null
+++ b/app/models/storage_usage/trackable_attachment.rb
@@ -0,0 +1,39 @@
+module StorageUsage::TrackableAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_usage_targets
+    before_update :remember_storage_usage_targets, if: :will_save_change_to_blob_id?
+    after_commit :refresh_storage_usage_later, on: %i[ create update destroy ]
+  end
+
+  private
+    def remember_storage_usage_targets
+      @previous_storage_usage_targets = storage_usage_targets
+    end
+
+    def refresh_storage_usage_later
+      targets = [ @previous_storage_usage_targets, storage_usage_targets ].compact.uniq
+      targets.each do |account_id, board_id|
+        StorageUsage.refresh_later(account_id, board_id)
+      end
+    end
+
+    def storage_usage_targets
+      target = case [ record_type, name ]
+      when [ "Card", "image" ] then record
+      when [ "ActionText::RichText", "embeds" ]
+        rich_text = record
+        rich_text.record if %w[Board Card Comment].include?(rich_text.record_type)
+      end
+
+      if target
+        board = case target
+        when Board then target
+        when Card then target.board
+        when Comment then target.card.board
+        end
+        [ account_id, board&.id ]
+      end
+    end
+end
