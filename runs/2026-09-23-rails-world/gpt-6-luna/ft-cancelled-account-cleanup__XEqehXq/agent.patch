diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..640c7c0
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently destroys accounts canceled more than 30 days ago" do
+    account = accounts("37s")
+    Account::Cancellation.create!(account:, initiated_by: users("jason"), created_at: 31.days.ago, updated_at: 31.days.ago)
+    entry = Storage::Entry.create!(account:, delta: 100, operation: "upload")
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+    assert_not Storage::Entry.exists?(entry.id)
+    assert_not User.exists?(users("jason").id)
+    assert_equal 0, Board.where(account_id: account.id).count
+    assert_equal 0, Card.where(account_id: account.id).count
+    assert Identity.exists?(identities("jason").id), "Deleting the account must not delete its members' global identities"
+  end
+
+  test "does not destroy accounts canceled within the grace period or not canceled" do
+    account = accounts("37s")
+    Account::Cancellation.create!(account:, initiated_by: users("david"))
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+    assert Account.exists?(accounts("acme").id)
+  end
+
+  test "does not destroy an account canceled exactly 30 days ago" do
+    account = accounts("initech")
+
+    travel_to Time.current do
+      cutoff = Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+      Account::Cancellation.create!(account:, initiated_by: users("mike"), created_at: cutoff, updated_at: cutoff)
+
+      Account::IncinerateDueJob.perform_now
+
+      assert Account.exists?(account.id)
+    end
+  end
+end
