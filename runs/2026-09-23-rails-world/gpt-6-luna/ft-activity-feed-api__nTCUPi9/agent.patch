diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..e3fe411
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,32 @@
+json.array! @page.records do |event|
+  json.id event.id
+  json.action event.action
+  json.created_at event.created_at.utc
+  json.description CGI.unescapeHTML(event.description_for(Current.user).to_plain_text)
+
+  particulars = case event.action
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: event.assignee_ids || [] }
+  when "card_board_changed"
+    {
+      old_board: event.particulars.dig("particulars", "old_board").presence || "",
+      new_board: event.particulars.dig("particulars", "new_board").presence || ""
+    }
+  when "card_title_changed"
+    {
+      old_title: event.particulars.dig("particulars", "old_title").presence || "",
+      new_title: event.particulars.dig("particulars", "new_title").presence || ""
+    }
+  when "card_triaged"
+    { column: event.particulars.dig("particulars", "column").presence || "" }
+  else
+    {}
+  end
+  json.particulars particulars
+
+  json.url event.eventable_type == "Comment" ? card_url(event.eventable.card, anchor: dom_id(event.eventable)) : card_url(event.eventable)
+  json.eventable_type event.eventable_type
+  json.eventable event.eventable, partial: event.eventable.to_partial_path, as: event.eventable_type.demodulize.underscore.to_sym
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
