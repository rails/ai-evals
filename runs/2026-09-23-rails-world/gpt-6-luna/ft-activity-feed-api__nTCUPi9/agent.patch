+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events
+        .where(action: TIMELINEABLE_ACTIONS)
+        .preloaded
+        .order(created_at: :desc, id: :desc)
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+
+      events
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).reject(&:blank?)
+    end
+
+    def board_ids
+      Array(params[:board_ids]).reject(&:blank?)
+    end
+
+    TIMELINEABLE_ACTIONS = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_triaged
+      card_sent_back_to_triage
+      card_title_changed
+      comment_created
+    ]
+end
