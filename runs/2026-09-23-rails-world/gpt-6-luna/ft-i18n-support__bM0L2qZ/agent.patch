diff --git a/test/controllers/locale_selection_test.rb b/test/controllers/locale_selection_test.rb
new file mode 100644
index 0000000..4bb39c1
--- /dev/null
+++ b/test/controllers/locale_selection_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class LocaleSelectionTest < ActionDispatch::IntegrationTest
+  test "a supported query locale changes the screen and is retained in the session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_includes response.body, '<html lang="ja">'
+      assert_includes response.body, "Fizzyにログイン"
+
+      get new_session_path
+      assert_response :success
+      assert_includes response.body, '<html lang="ja">'
+      assert_includes response.body, "メールアドレスを入力"
+    end
+  end
+
+  test "an unsupported locale does not change the default English screen" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_includes response.body, '<html lang="en">'
+      assert_includes response.body, "Get into Fizzy"
+    end
+  end
+
+  test "a locale selected before authentication is saved to the identity" do
+    identity = identities(:kevin)
+
+    untenanted do
+      get new_session_path(locale: "ja")
+      post session_path, params: { email_address: identity.email_address }
+      assert_redirected_to session_magic_link_path
+      assert_equal "ja", identity.reload.locale
+    end
+  end
+
+  test "a saved identity locale is restored in a clean sign-in session" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    sign_in_as identity
+    get root_url
+
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_includes response.body, "メインコンテンツへスキップ"
+  end
+
+  test "an unsupported locale does not overwrite a saved preference" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    sign_in_as identity
+
+    get root_url(locale: "xx")
+
+    assert_response :success
+    assert_includes response.body, '<html lang="ja">'
+    assert_equal "ja", identity.reload.locale
+  end
+end
diff --git a/test/helpers/locale_helper_test.rb b/test/helpers/locale_helper_test.rb
new file mode 100644
index 0000000..78d9e33
--- /dev/null
+++ b/test/helpers/locale_helper_test.rb
@@ -0,0 +1,17 @@
+require "test_helper"
+
+class LocaleHelperTest < ActionView::TestCase
+  include ColumnsHelper, ApplicationHelper
+  test "system column names and titles are localized without changing English" do
+    I18n.with_locale(:en) do
+      assert_equal "Done", column_display_name("Done")
+      assert_equal "Column: Not Now", localized_column_page_title("Not Now")
+    end
+
+    I18n.with_locale(:ja) do
+      assert_equal "完了", column_display_name("Done")
+      assert_equal "カラム：今はしない", localized_column_page_title("Not Now")
+      assert_equal "Custom column", column_display_name("Custom column")
+    end
+  end
+end
diff --git a/test/mailers/japanese_locale_test.rb b/test/mailers/japanese_locale_test.rb
new file mode 100644
index 0000000..fed91c0
--- /dev/null
+++ b/test/mailers/japanese_locale_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class JapaneseLocaleTest < ActiveSupport::TestCase
+  test "dates use Japanese ordering and Japanese characters" do
+    date = Date.new(2024, 5, 3)
+
+    assert_equal "2024年5月3日", I18n.l(date, locale: :ja, format: :stamp)
+  end
+
+  test "magic link email subject and content use the identity locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = identity.magic_links.create!
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link).deliver_now
+
+    assert_equal "Fizzyの認証コードは#{magic_link.code}です", email.subject
+    assert_includes email.text_part.body.decoded, "認証コードを入力してください"
+    assert_includes email.text_part.body.decoded, "15分有効です"
+    assert_includes email.html_part.body.decoded, '<html lang="ja">'
+  end
+end
