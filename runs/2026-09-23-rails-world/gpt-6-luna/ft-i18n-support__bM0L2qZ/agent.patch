diff --git a/app/controllers/concerns/locale_selection.rb b/app/controllers/concerns/locale_selection.rb
new file mode 100644
index 0000000..07898e5
--- /dev/null
+++ b/app/controllers/concerns/locale_selection.rb
@@ -0,0 +1,36 @@
+module LocaleSelection
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_locale
+    before_action :apply_identity_locale
+  end
+
+  private
+    def with_locale
+      requested_locale = offered_locale(params[:locale])
+      if requested_locale
+        session[:locale] = requested_locale.to_s
+        @locale_explicitly_selected = true
+      end
+
+      locale = requested_locale || offered_locale(session[:locale]) || I18n.default_locale
+      I18n.with_locale(locale) { yield }
+    end
+
+    def apply_identity_locale
+      if @locale_explicitly_selected
+        if Current.identity
+          Current.identity.update!(locale: I18n.locale.to_s) unless Current.identity.locale == I18n.locale.to_s
+        end
+      elsif offered_locale(session[:locale]).nil? && Current.identity && offered_locale(Current.identity.locale)
+        I18n.locale = Current.identity.locale
+        session[:locale] = Current.identity.locale
+      end
+    end
+
+    def offered_locale(locale)
+      value = locale.to_s.downcase
+      I18n.available_locales.find { |available| available.to_s == value }
+    end
+end
