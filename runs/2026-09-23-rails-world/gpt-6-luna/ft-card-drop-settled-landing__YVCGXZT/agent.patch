index 54a69f0..37e6196 100644
--- a/app/controllers/cards/columns_controller.rb
+++ b/app/controllers/cards/columns_controller.rb
@@ -1,4 +1,25 @@
 class Cards::ColumnsController < ApplicationController
+  def update
+    @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
+    @board = @card.board
+    destination = params.expect(:destination)
+
+    case destination
+    when "maybe"
+      @card.send_back_to_triage
+    when "not_now"
+      @card.postpone
+    when "closed"
+      @card.close
+    else
+      column = @board.columns.find(destination)
+      @card.reopen if @card.closed?
+      @card.triage_into(column)
+    end
+
+    head :no_content
+  end
+
   def edit
     @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
     @columns = @card.board.columns.sorted
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..e72e755
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,100 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "column" ]
+
+  start(event) {
+    const card = event.target.closest(".card[draggable='true']")
+
+    if (card) {
+      this.draggedCard = card
+      this.sourceContainer = card.parentElement
+      this.sourceNextSibling = card.nextElementSibling
+      card.classList.add("drag-and-drop__dragged-item")
+
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  end() {
+    this.clearDragStyles()
+    this.draggedCard = null
+    this.sourceContainer = null
+    this.sourceNextSibling = null
+  }
+
+  over(event) {
+    if (this.draggedCard && this.columnFor(event.target)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  enter(event) {
+    const column = this.columnFor(event.target)
+
+    if (this.draggedCard && column) {
+      column.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  leave(event) {
+    const column = this.columnFor(event.target)
+
+    if (column && !column.contains(event.relatedTarget)) {
+      column.classList.remove("drag-and-drop__hover-container")
+    }
+  }
+
+  drop(event) {
+    const column = this.columnFor(event.target)
+    const card = this.draggedCard
+
+    if (!card || !column) return
+
+    event.preventDefault()
+    column.classList.remove("drag-and-drop__hover-container")
+
+    const destination = column.dataset.dragAndDropDestination
+    const sourceColumn = card.closest("[data-drag-and-drop-destination]")
+
+    if (sourceColumn?.dataset.dragAndDropDestination === destination) return
+
+    const sourceContainer = this.sourceContainer
+    const sourceNextSibling = this.sourceNextSibling
+    const container = column.querySelector(".cards__list") || column.querySelector("turbo-frame")
+
+    if (!container) return
+
+    container.append(card)
+
+    fetch(card.dataset.dragAndDropUrl, {
+      method: "PATCH",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']")?.content
+      },
+      body: JSON.stringify({ destination })
+    }).then(response => {
+      if (!response.ok) throw new Error("Could not move card")
+    }).catch(() => {
+      if (sourceContainer) sourceContainer.insertBefore(card, sourceNextSibling)
+    })
+  }
+
+  columnFor(element) {
+    const column = element.closest("[data-drag-and-drop-target~='column']")
+    return this.columnTargets.includes(column) ? column : null
+  }
+
+  clearDragStyles() {
+    this.element.querySelectorAll(".drag-and-drop__hover-container").forEach(column => {
+      column.classList.remove("drag-and-drop__hover-container")
+    })
+    this.element.querySelectorAll(".drag-and-drop__dragged-item").forEach(card => {
+      card.classList.remove("drag-and-drop__dragged-item")
+    })
+  }
+}
