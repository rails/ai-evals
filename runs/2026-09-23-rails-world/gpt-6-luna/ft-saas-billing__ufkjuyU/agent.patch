diff --git a/saas/app/controllers/account/billings_controller.rb b/saas/app/controllers/account/billings_controller.rb
new file mode 100644
index 0000000..b23d8ba
--- /dev/null
+++ b/saas/app/controllers/account/billings_controller.rb
@@ -0,0 +1,50 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin
+
+  def checkout
+    plan_key = params.require(:plan).to_s
+    price_id = stripe_price_id(plan_key)
+    head :unprocessable_entity and return if price_id.blank?
+
+    Stripe.api_key = ENV.fetch("STRIPE_SECRET_KEY")
+    session = Stripe::Checkout::Session.create(
+      mode: "subscription",
+      line_items: [ { price: price_id, quantity: 1 } ],
+      success_url: billing_return_url,
+      cancel_url: billing_return_url,
+      customer: Current.account.account_subscription&.stripe_customer_id,
+      customer_email: Current.account.account_subscription&.stripe_customer_id ? nil : Current.identity.email_address,
+      client_reference_id: Current.account.id,
+      metadata: { account_id: Current.account.id, plan_key: plan_key },
+      subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan_key } }
+    )
+    redirect_to session.url, allow_other_host: true
+  rescue Stripe::StripeError => error
+    Rails.logger.error("Stripe checkout failed: #{error.message}")
+    head :bad_gateway
+  end
+
+  def portal
+    subscription = Current.account.account_subscription
+    head :unprocessable_entity and return if subscription&.stripe_customer_id.blank?
+
+    Stripe.api_key = ENV.fetch("STRIPE_SECRET_KEY")
+    session = Stripe::BillingPortal::Session.create(customer: subscription.stripe_customer_id, return_url: billing_return_url)
+    redirect_to session.url, allow_other_host: true
+  rescue Stripe::StripeError => error
+    Rails.logger.error("Stripe portal failed: #{error.message}")
+    head :bad_gateway
+  end
+
+  private
+    def stripe_price_id(plan_key)
+      case plan_key
+      when "unlimited" then ENV["STRIPE_UNLIMITED_PRICE_ID"] || ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      when "unlimited_plus" then ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] || ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      end
+    end
+
+    def billing_return_url
+      "#{request.base_url}#{Current.account.slug}#{account_settings_path}"
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..5e92498
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,43 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[show comp uncomp override reset]
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    @account.apply_limit_override!(**override_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to saas.admin_account_path(@account), alert: error.record.errors.full_messages.to_sentence
+  end
+
+  def reset
+    @account.reset_limit_override!
+    redirect_to saas.admin_account_path(@account), notice: "Limits reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+
+    def override_params
+      params.expect(account_overridden_limit: [ :card_count, :bytes_used ]).to_h.symbolize_keys
+    end
+end
