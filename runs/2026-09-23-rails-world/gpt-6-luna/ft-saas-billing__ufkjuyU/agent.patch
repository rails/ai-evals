diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..89e267f
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,80 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+
+    case event.type
+    when "checkout.session.completed"
+      update_from_checkout(event.data.object)
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+      update_from_subscription(event.data.object)
+    end
+
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError, KeyError
+    head :bad_request
+  end
+
+  private
+    def update_from_checkout(session)
+      account = Account.find_by(id: session.metadata&.account_id || session.client_reference_id)
+      if account
+        subscription = AccountSubscription.find_or_initialize_by(account_id: account.id)
+        subscription.update!(
+          stripe_customer_id: stripe_id(session.customer),
+          stripe_subscription_id: stripe_id(session.subscription),
+          plan_key: safe_plan_key(session.metadata&.plan_key),
+          status: "active"
+        )
+      end
+    end
+
+    def update_from_subscription(object)
+      account_id = object.metadata&.account_id
+      subscription = AccountSubscription.find_by(account_id: account_id) if account_id.present?
+      subscription ||= AccountSubscription.find_by(stripe_customer_id: stripe_id(object.customer))
+
+      if subscription.nil? && account_id.present? && (account = Account.find_by(id: account_id))
+        subscription = AccountSubscription.new(account_id: account.id)
+      end
+
+      if subscription
+        canceled = object.status == "canceled"
+        subscription.update!(
+          plan_key: canceled ? "free" : plan_key_for(object),
+          stripe_customer_id: stripe_id(object.customer),
+          stripe_subscription_id: canceled ? nil : stripe_id(object.id),
+          status: object.status,
+          current_period_end: time_value(object.current_period_end),
+          cancel_at: time_value(object.cancel_at)
+        )
+      end
+    end
+
+    def plan_key_for(subscription)
+      price_id = subscription.items&.data&.first&.price&.id
+      if price_id.present? && price_id == (ENV["STRIPE_UNLIMITED_PRICE_ID"] || ENV["STRIPE_MONTHLY_V1_PRICE_ID"])
+        "unlimited"
+      elsif price_id.present? && price_id == (ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] || ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"])
+        "unlimited_plus"
+      else
+        safe_plan_key(subscription.metadata&.plan_key)
+      end
+    end
+
+    def safe_plan_key(value)
+      AccountSubscription::PLANS.key?(value.to_s) && value.to_s != "free" ? value.to_s : "free"
+    end
+
+    def stripe_id(value)
+      value.respond_to?(:id) ? value.id : value
+    end
+
+    def time_value(value)
+      Time.at(value).utc if value.present?
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..b9e1e09
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,66 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :account_subscription, class_name: "AccountSubscription", dependent: :delete
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :delete
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :delete
+  end
+
+  def current_limit_override
+    Account::OverriddenLimit.find_by(account_id: id)
+  end
+
+  def plan_key
+    account_subscription&.plan_key || "free"
+  end
+
+  def billing_plan
+    AccountSubscription::PLANS.fetch(plan_key, AccountSubscription::PLANS.fetch("free"))
+  end
+
+  def plan_name
+    billing_plan.fetch(:name)
+  end
+
+  def card_limit
+    billing_plan.fetch(:card_limit)
+  end
+
+  def billable_card_count
+    current_limit_override&.card_count || cards_count
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && billable_card_count >= card_limit
+  end
+
+  def cards_remaining
+    card_limit.present? ? [ card_limit - billable_card_count, 0 ].max : nil
+  end
+
+  def comped?
+    Account::BillingWaiver.exists?(account_id: id)
+  end
+
+  def comp!
+    Account::BillingWaiver.create_or_find_by!(account_id: id)
+    association(:billing_waiver).reset
+  end
+
+  def uncomp!
+    billing_waiver&.destroy
+    association(:billing_waiver).reset
+  end
+
+  def apply_limit_override!(card_count:, bytes_used:)
+    record = current_limit_override || Account::OverriddenLimit.new(account_id: id)
+    record.update!(card_count: card_count.presence, bytes_used: bytes_used.presence)
+    association(:overridden_limit).reset
+  end
+
+  def reset_limit_override!
+    current_limit_override&.destroy
+    association(:overridden_limit).reset
+  end
+end
