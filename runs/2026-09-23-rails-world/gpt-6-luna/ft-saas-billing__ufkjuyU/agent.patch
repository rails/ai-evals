+require "test_helper"
+require "ostruct"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  test "account settings show the plan and upgrade buttons to admins" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "button", text: /Upgrade to Unlimited — \$20\/month/
+    assert_select "button", text: /Upgrade to Unlimited\+ — \$25\/month/
+  end
+
+  test "admin checkout redirects to Stripe hosted checkout" do
+    sign_in_as :mike
+    old_price = ENV["STRIPE_UNLIMITED_PRICE_ID"]
+    old_secret = ENV["STRIPE_SECRET_KEY"]
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_SECRET_KEY"] = "sk_test"
+    Stripe::Checkout::Session.stubs(:create).returns(OpenStruct.new(url: "https://checkout.stripe.test/session"))
+
+    post saas.checkout_account_billing_path(plan: "unlimited", script_name: accounts(:initech).slug)
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  ensure
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = old_price
+    ENV["STRIPE_SECRET_KEY"] = old_secret
+  end
+end
