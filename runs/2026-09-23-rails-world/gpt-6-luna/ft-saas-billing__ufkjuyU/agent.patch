@@ -0,0 +1,32 @@
+require "test_helper"
+require "ostruct"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription webhook applies the account plan" do
+    account = accounts(:initech)
+    object = OpenStruct.new(
+      metadata: OpenStruct.new(account_id: account.id, plan_key: "unlimited_plus"),
+      customer: "cus_test",
+      id: "sub_test",
+      status: "active",
+      current_period_end: nil,
+      cancel_at: nil,
+      items: OpenStruct.new(data: [])
+    )
+    event = OpenStruct.new(type: "customer.subscription.updated", data: OpenStruct.new(object: object))
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+
+    post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "signed" }
+
+    assert_response :success
+    assert_equal "unlimited_plus", AccountSubscription.find_by!(account_id: account.id).plan_key
+  end
+
+  test "invalid webhook signatures are rejected" do
+    Stripe::Webhook.stubs(:construct_event).raises(Stripe::SignatureVerificationError.new("bad signature", "signature"))
+
+    post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "invalid" }
+
+    assert_response :bad_request
+  end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..d054e09
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  test "free plan limits cards and storage" do
+    account = accounts(:initech)
+
+    assert_equal "Free", account.plan_name
+    assert_equal 1_000, account.card_limit
+    assert_equal 1.gigabyte, account.storage_limit
+    assert_equal 1_000 - account.cards_count, account.cards_remaining
+  end
+
+  test "paid plans provide their own allowances" do
+    account = accounts(:initech)
+    account.create_account_subscription!(plan_key: "unlimited")
+
+    assert_equal "Unlimited", account.plan_name
+    assert_nil account.card_limit
+    assert_equal 5.gigabytes, account.storage_limit
+
+    account.account_subscription.update!(plan_key: "unlimited_plus")
+
+    assert_equal "Unlimited+", account.plan_name
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "overrides affect usage and reset restores the actual usage" do
+    account = accounts(:initech)
+    account.apply_limit_override!(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert_equal 1_000, account.billable_card_count
+    assert account.exceeding_card_limit?
+    assert_equal 2.gigabytes, account.bytes_used
+    assert account.exceeding_storage_limit?
+
+    account.reset_limit_override!
+
+    assert_equal account.cards_count, account.billable_card_count
+    assert_equal 0, account.bytes_used
+  end
+
+  test "comp and uncomp are reversible" do
+    account = accounts(:initech)
+
+    assert_not account.comped?
+    account.comp!
+    assert account.comped?
+    account.uncomp!
+    assert_not account.comped?
+  end
+end
