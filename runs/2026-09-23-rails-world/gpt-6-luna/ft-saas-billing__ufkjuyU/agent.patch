diff --git a/saas/app/models/account_subscription.rb b/saas/app/models/account_subscription.rb
new file mode 100644
index 0000000..7c6ce75
--- /dev/null
+++ b/saas/app/models/account_subscription.rb
@@ -0,0 +1,19 @@
+class AccountSubscription < SaasRecord
+  PLANS = {
+    "free" => { name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte },
+    "unlimited" => { name: "Unlimited", price: 20, card_limit: nil, storage_limit: 5.gigabytes },
+    "unlimited_plus" => { name: "Unlimited+", price: 25, card_limit: nil, storage_limit: 500.gigabytes }
+  }.freeze
+
+  belongs_to :account
+
+  validates :plan_key, inclusion: { in: PLANS.keys }
+
+  def plan
+    PLANS.fetch(plan_key, PLANS.fetch("free"))
+  end
+
+  def paid?
+    plan_key != "free"
+  end
+end
