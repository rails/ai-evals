+++ b/app/jobs/webhook/deliver_job.rb
@@ -0,0 +1,79 @@
+require "net/http"
+require "openssl"
+
+class Webhook::DeliverJob < ApplicationJob
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  def perform(delivery)
+    return unless claim_delivery(delivery)
+
+    webhook = delivery.webhook
+    unless webhook.active?
+      finish_delivery(delivery, :errored, error: "webhook_inactive")
+      return
+    end
+
+    uri = URI.parse(webhook.url)
+    body = payload_for(delivery.event).to_json
+    timestamp = delivery.event.created_at.utc.iso8601(3)
+    signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => timestamp,
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Delivery" => delivery.id
+    }
+
+    delivery.update!(request: { headers: headers, body: body })
+    response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+      http.post(uri.request_uri, body, headers)
+    end
+
+    response_details = {
+      code: response.code.to_i,
+      headers: response.each_header.to_h,
+      body: response.body.to_s.byteslice(0, 1000)
+    }
+    finish_delivery(delivery, :completed, response_details)
+  rescue StandardError => error
+    finish_delivery(delivery, :errored, error: error.class.name)
+  end
+
+  private
+    def claim_delivery(delivery)
+      delivery.with_lock do
+        if delivery.pending?
+          delivery.update!(state: :in_progress)
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def payload_for(event)
+      eventable = event.eventable
+      {
+        id: event.id,
+        action: event.action,
+        created_at: event.created_at.utc.iso8601(3),
+        eventable: eventable && { type: event.eventable_type, id: event.eventable_id },
+        board: { id: event.board_id, name: event.board.name },
+        creator: { id: event.creator_id, name: event.creator.name },
+        particulars: event.api_particulars
+      }
+    end
+
+    def finish_delivery(delivery, state, response)
+      delivery.update!(state: state, response: response)
+
+      if delivery.succeeded?
+        delivery.webhook.delinquency_tracker&.reset!
+      elsif delivery.failed?
+        tracker = delivery.webhook.delinquency_tracker || delivery.webhook.create_delinquency_tracker!
+        tracker.record_failure!
+      end
+    end
+end
