@@ -0,0 +1,20 @@
+module Event::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :trigger_webhooks_later
+  end
+
+  def trigger_webhooks_later
+    webhooks_to_trigger.each do |webhook|
+      delivery = webhook.deliveries.create_or_find_by!(event: self)
+      Webhook::DeliverJob.perform_later(delivery) if delivery.previously_new_record?
+    end
+  end
+
+  private
+    def webhooks_to_trigger
+      board.webhooks.active.where("subscribed_actions LIKE ?", "%#{action}%")
+        .select { |webhook| webhook.subscribed_actions.include?(action) }
+    end
+end
