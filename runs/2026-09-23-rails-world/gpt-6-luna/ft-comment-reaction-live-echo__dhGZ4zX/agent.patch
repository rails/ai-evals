diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..4ecca2f
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create a reaction" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, 1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "🙌" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_includes response.body, "🙌"
+    assert_includes response.body, "Remove your reaction"
+  end
+
+  test "accept 16 emoji characters" do
+    comment = comments(:logo_agreement_jz)
+    content = "🙌" * 16
+
+    assert_difference -> { comment.reactions.count }, 1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: content } }, as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "comments display the add reaction control" do
+    get card_path(cards(:logo))
+
+    assert_response :success
+    assert_select ".reactions__trigger[aria-label='Add a reaction']"
+    assert_select "img[src*='boost-color']"
+  end
+
+  test "reject reactions longer than 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "12345678901234567" } }, as: :turbo_stream
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "delete your reaction" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍", user: users(:kevin))
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "cannot delete someone else's reaction" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍", user: users(:jz))
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+end
