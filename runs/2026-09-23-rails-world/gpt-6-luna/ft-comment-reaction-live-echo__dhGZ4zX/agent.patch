+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :user, default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  after_create_commit :refresh_card
+  after_destroy_commit :refresh_card
+
+  private
+    def refresh_card
+      broadcast_refresh_to comment.card if Comment.exists?(comment_id)
+    end
+end
