diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..1c114ce
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,39 @@
+<% reactions =
+    if comment.association(:reactions).loaded?
+      comment.reactions.sort_by { |reaction| [ reaction.created_at, reaction.id ] }
+    else
+      comment.reactions.includes(user: [ :avatar_attachment, :account ]).order(:created_at, :id)
+    end
+%>
+
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction-form">
+  <div class="reactions__list">
+    <% reactions.each do |reaction| %>
+      <div class="reaction<%= ' reaction--deleteable' if reaction.user == Current.user %>"<% if reaction.user == Current.user %> data-controller="toggle-class" data-toggle-class-toggle-class="expanded"<% end %>>
+        <% if reaction.user == Current.user %>
+          <button type="button" class="reaction__form-label btn btn--plain" aria-label="Remove your reaction: <%= reaction.content %>" data-action="toggle-class#toggle">
+            <span class="reaction__avatar" title="<%= reaction.user.name %>"><%= avatar_tag reaction.user, hidden_for_screen_reader: true %></span>
+            <span class="txt-small txt-medium"><%= reaction.content %></span>
+          </button>
+          <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete, class: "reaction__delete btn btn--circle borderless", aria: { label: "Remove reaction" } do %>
+            <%= icon_tag "close" %>
+          <% end %>
+        <% else %>
+          <span class="reaction__avatar" title="<%= reaction.user.name %>"><%= avatar_tag reaction.user, hidden_for_screen_reader: true %></span>
+          <span class="txt-small txt-medium" title="<%= reaction.user.name %>"><%= reaction.content %></span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction" data-reaction-form-target="trigger" data-action="reaction-form#open">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ], class: "reaction__form", data: { reaction_form_target: "form" }, hidden: true do |form| %>
+    <%= form.label :content, class: "for-screen-reader" do %>Your reaction<% end %>
+    <%= form.text_field :content, class: "reaction__input input", maxlength: 32, autocomplete: "off", data: { reaction_form_target: "input", action: "input->reaction-form#limit" } %>
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless" aria-label="Confirm reaction"><%= icon_tag "check" %></button>
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" aria-label="Cancel" data-action="reaction-form#close"><%= icon_tag "close" %></button>
+  <% end %>
+</div>
