diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..e6e39aa
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,44 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reaction_ownership, only: :destroy
+
+  def create
+    @comment.reactions.create!(reaction_params.merge(user: Current.user))
+
+    render_reactions
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    render_reactions
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reaction_ownership
+      head :forbidden unless @reaction.user == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions
+      render turbo_stream: turbo_stream.replace(
+        [ @comment, :reactions ],
+        partial: "cards/comments/reactions",
+        locals: { comment: @comment }
+      )
+    end
+end
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..e691bf1
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  limit() {
+    const characters = Array.from(this.inputTarget.value)
+    if (characters.length > 16) this.inputTarget.value = characters.slice(0, 16).join("")
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  close() {
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+  }
+}
