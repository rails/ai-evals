+    else
+      my_export_url(blob.signed_id(expires_in: 24.hours, purpose: :data_export))
+    end
+
+    mail(to: recipient.identity.email_address, subject: "Your Fizzy data export is ready")
+  end
+
+  def data_import_completed(data_import, account)
+    @account_url = root_url(script_name: account.slug)
+    mail(to: data_import.user.identity.email_address, subject: "Your Fizzy account import is complete")
+  end
+
+  def data_import_failed(data_import)
+    @error_message = data_import.error_message
+    mail(to: data_import.user.identity.email_address, subject: "Your Fizzy account import failed")
+  end
 end
