+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  def create
+    if Current.user.admin?
+      Account::DataTransfer::ExportJob.perform_later(Current.account, Current.user)
+      redirect_to account_settings_path, notice: "Your account export is being prepared. We’ll email you when it’s ready."
+    else
+      head :forbidden
+    end
+  end
+
+  def show
+    blob = ActiveStorage::Blob.find_signed!(params[:id], purpose: :data_export)
+    head :not_found and return unless blob.attachments.exists?(record: Current.account, name: "data_export")
+
+    redirect_to rails_blob_url(blob, disposition: :attachment)
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    head :not_found
+  end
+end
