new file mode 100644
index 0000000..63a5203
--- /dev/null
+++ b/test/controllers/account/data_transfer_exports_controller_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::DataTransferExportsControllerTest < ActionDispatch::IntegrationTest
+  test "account export download links work without signing in" do
+    account = accounts("37s")
+    account.data_export.attach(io: StringIO.new("archive"), filename: "account.zip", content_type: "application/zip")
+    token = account.data_export.blob.signed_id(expires_in: 24.hours, purpose: :data_export)
+
+    get account_export_path(token)
+
+    assert_response :redirect
+    assert_redirected_to rails_blob_url(account.data_export.blob, disposition: :attachment)
+  end
+
+  test "personal export links work without signing in but stay scoped to the account" do
+    user = users("david")
+    user.data_export.attach(io: StringIO.new("archive"), filename: "cards.zip", content_type: "application/zip")
+    token = user.data_export.blob.signed_id(expires_in: 24.hours, purpose: :data_export)
+
+    get my_export_path(token)
+
+    assert_response :redirect
+    assert_redirected_to rails_blob_url(user.data_export.blob, disposition: :attachment)
+  end
+end
diff --git a/test/models/account/data_transfer/exporter_importer_test.rb b/test/models/account/data_transfer/exporter_importer_test.rb
new file mode 100644
index 0000000..dee888b
--- /dev/null
+++ b/test/models/account/data_transfer/exporter_importer_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::DataTransfer::ExporterImporterTest < ActiveSupport::TestCase
+  test "account archive imports its boards cards comments and users into a fresh account" do
+    source = accounts("37s")
+    Current.account = source
+    source_card = source.cards.first
+    source_card.image.attach(io: StringIO.new("image data"), filename: "card.png", content_type: "image/png")
+    tempfile = Tempfile.new([ "account-export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Manifest.new(source).each_record_set { |set| set.write_to(writer) }
+    writer.close
+    tempfile.rewind
+
+    data_import = source.imports.build(user: users("jason"))
+    data_import.file.attach(io: tempfile, filename: "account.zip", content_type: "application/zip")
+    data_import.save!
+
+    imported = Account::DataTransfer::Importer.new(data_import).import
+
+    assert_not_equal source.id, imported.id
+    assert_equal source.name, imported.name
+    assert_equal source.boards.count, imported.boards.count
+    assert_equal source.cards.count, imported.cards.count
+    assert_equal source.users.count, imported.users.count
+    assert imported.users.exists?(identity: identities("jason"))
+    imported_card = imported.cards.find_by!(number: source_card.number)
+    assert_equal "image data", imported_card.image.blob.download
+  ensure
+    tempfile&.close!
+  end
+
+  test "malformed archive leaves no new account behind" do
+    source = accounts("37s")
+    tempfile = Tempfile.new([ "broken-export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("not-account-data.json", "bad")
+    writer.close
+    tempfile.rewind
+
+    data_import = source.imports.build(user: users("jason"))
+    data_import.file.attach(io: tempfile, filename: "broken.zip", content_type: "application/zip")
+    data_import.save!
+    account_count = Account.count
+
+    assert_raises(ArgumentError) { Account::DataTransfer::Importer.new(data_import).import }
+    assert_equal account_count, Account.count
+  ensure
+    tempfile&.close!
+  end
+end
