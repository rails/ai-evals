diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..685c575
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,124 @@
+class Account::DataTransfer::Importer
+  def initialize(data_import)
+    @data_import = data_import
+    @uploaded_blobs = []
+  end
+
+  def import
+    data_import.file.blob.open do |archive|
+      Zip::File.open(archive.path) do |zip|
+        import_records(zip)
+      end
+    end
+  rescue StandardError
+    cleanup_uploaded_blobs
+    raise
+  end
+
+  private
+    attr_reader :data_import
+
+    def import_records(zip)
+      entries = zip.entries.index_by(&:name)
+      account_entry = entries["accounts.jsonl"] || raise(ArgumentError, "The archive is missing account data")
+      source_account = account_data_from(account_entry)
+
+      ActiveRecord::Base.transaction do
+        account = Account.create!(name: source_account.fetch("name"))
+        account.update_column(:cards_count, source_account["cards_count"] || 0)
+        @id_map = Account::DataTransfer::Identity.new(account, source_account_id: source_account.fetch("id"))
+
+        Current.with_account(account) do
+          Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+            next if record_set.is_a?(Account::DataTransfer::AccountRecordSet)
+
+            if record_set.is_a?(Account::DataTransfer::ActiveStorage::BlobRecordSet)
+              import_files(entries)
+            elsif record_set.model == ::ActiveStorage::Blob
+              next
+            else
+              import_record_set(record_set, entries)
+            end
+          end
+        end
+
+        account
+      end
+    end
+
+    def account_data_from(entry)
+      entry.get_input_stream do |stream|
+        JSON.parse(stream.readline)
+      end
+    rescue EOFError, JSON::ParserError
+      raise ArgumentError, "The archive contains invalid account data"
+    end
+
+    def import_record_set(record_set, entries)
+      entry = entries["#{record_set.model.table_name}.jsonl"]
+      return unless entry
+
+      entry.get_input_stream do |stream|
+        stream.each_line do |line|
+          insert_record(record_set.model, JSON.parse(line))
+        end
+      end
+    end
+
+    def insert_record(model, data)
+      attributes = data.slice(*model.column_names)
+      attributes["id"] = @id_map.id_for(attributes["id"]) if attributes["id"]
+
+      if model == User && data["identity_email_address"].present?
+        attributes["identity_id"] = @id_map.identity_id_for(attributes["identity_id"], data["identity_email_address"])
+      end
+
+      attributes.each do |key, value|
+        if key == "account_id"
+          attributes[key] = @id_map.account_id
+        elsif key.end_with?("_id") && value.present? && key != "identity_id"
+          attributes[key] = @id_map.id_for(value)
+        end
+      end
+
+      if model == Entropy && (existing = Entropy.find_by(container_type: attributes["container_type"], container_id: attributes["container_id"]))
+        existing.update_columns(attributes.except("id", "created_at"))
+      else
+        model.insert_all!([ attributes ]) unless attributes.empty?
+      end
+    end
+
+    def import_files(entries)
+      entry = entries["active_storage_blobs.jsonl"]
+      return unless entry
+
+      entry.get_input_stream do |stream|
+        stream.each_line do |line|
+          attributes = JSON.parse(line)
+          file_entry = entries["files/#{attributes.fetch("key")}"]
+          raise ArgumentError, "An attachment file is missing from the archive" unless file_entry
+
+          source_id = attributes.fetch("id")
+          blob = file_entry.get_input_stream do |file|
+            ActiveStorage::Blob.create_and_upload!(
+              io: file,
+              filename: attributes.fetch("filename"),
+              content_type: attributes["content_type"],
+              identify: false
+            )
+          end
+          blob.update_columns(metadata: attributes["metadata"], created_at: attributes["created_at"])
+          @uploaded_blobs << blob
+          @id_map.map(source_id, blob.id)
+        end
+      end
+    end
+
+    def cleanup_uploaded_blobs
+      @uploaded_blobs.each do |blob|
+        blob.service.delete(blob.key)
+      rescue StandardError
+        nil
+      end
+    end
+end
