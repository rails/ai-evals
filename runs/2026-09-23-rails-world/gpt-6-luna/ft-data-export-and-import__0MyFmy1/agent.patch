+class Account::DataTransfer::Identity
+  def initialize(account, source_account_id:)
+    @account = account
+    @ids = { source_account_id => account.id }
+  end
+
+  def id_for(source_id)
+    @ids[source_id] ||= ActiveRecord::Type::Uuid.generate
+  end
+
+  def identity_id_for(source_id, email)
+    if email.present?
+      ::Identity.find_or_create_by!(email_address: email).id
+    elsif source_id.present?
+      id_for(source_id)
+    end
+  end
+
+  def map(source_id, target_id)
+    @ids[source_id] = target_id
+  end
+
+  def account_id
+    @account.id
+  end
+end
