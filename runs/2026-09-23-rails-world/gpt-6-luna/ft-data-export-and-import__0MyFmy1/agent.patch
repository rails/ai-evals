diff --git a/app/jobs/account/data_transfer/import_job.rb b/app/jobs/account/data_transfer/import_job.rb
new file mode 100644
index 0000000..f59a335
--- /dev/null
+++ b/app/jobs/account/data_transfer/import_job.rb
@@ -0,0 +1,16 @@
+class Account::DataTransfer::ImportJob < ApplicationJob
+  def perform(data_import)
+    data_import.update!(status: :processing)
+
+    begin
+      account = Account::DataTransfer::Importer.new(data_import).import
+    rescue StandardError => error
+      data_import.update!(status: :failed, error_message: error.message.truncate(1000))
+      AccountMailer.data_import_failed(data_import).deliver_now
+      return
+    end
+
+    data_import.update!(status: :completed)
+    AccountMailer.data_import_completed(data_import, account).deliver_now
+  end
+end
