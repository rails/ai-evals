diff --git a/app/models/account/data_transfer/exporter.rb b/app/models/account/data_transfer/exporter.rb
new file mode 100644
index 0000000..32782b3
--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,58 @@
+class Account::DataTransfer::Exporter
+  def initialize(record)
+    @record = record
+  end
+
+  def export
+    ZipFile.create_for(record.data_export, filename: filename) do |zip|
+      if record.is_a?(Account)
+        Account::DataTransfer::Manifest.new(record).each_record_set do |record_set|
+          record_set.write_to(zip)
+        end
+      else
+        write_cards(zip)
+      end
+    end
+  end
+
+  private
+    attr_reader :record
+
+    def filename
+      "#{record.is_a?(Account) ? "account" : "cards"}-#{Date.current}.zip"
+    end
+
+    def write_cards(zip)
+      record.accessible_cards.includes(:comments, :image_attachment).find_each do |card|
+        attachments = attachments_for(card).to_a
+        card_json = card.attributes.merge(
+          "description" => card.description.body.to_html,
+          "comments" => card.comments.includes(:rich_text_body).map do |comment|
+            comment.attributes.merge("body" => comment.body.body.to_html)
+          end,
+          "attachments" => attachments.map do |attachment|
+            { name: attachment.name, filename: attachment.blob.filename.to_s,
+              content_type: attachment.blob.content_type, archive_path: "files/#{attachment.blob.key}" }
+          end
+        )
+
+        zip.add_file("cards/#{card.number}.json", JSON.generate(card_json))
+        attachments.uniq(&:blob_id).each do |attachment|
+          blob = attachment.blob
+          zip.add_file("files/#{blob.key}", compress: false) do |sink|
+            blob.open { |file| IO.copy_stream(file, sink) }
+          end
+        end
+      end
+    end
+
+    def attachments_for(card)
+      comment_ids = card.comments.select(:id)
+      rich_text_ids = ActionText::RichText.where(record_type: "Comment", record_id: comment_ids)
+        .or(ActionText::RichText.where(record_type: "Card", record_id: card.id)).select(:id)
+      ActiveStorage::Attachment.where(record_type: "Card", record_id: card.id)
+        .or(ActiveStorage::Attachment.where(record_type: "Comment", record_id: comment_ids))
+        .or(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids))
+        .includes(:blob).distinct
+    end
+end
