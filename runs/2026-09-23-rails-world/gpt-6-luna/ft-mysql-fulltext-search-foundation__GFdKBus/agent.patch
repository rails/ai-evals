@@ -0,0 +1,16 @@
+module SearchHelper
+  def highlighted_search_text(text, query)
+    highlight(text.to_s, query, highlighter: "<mark>\\1</mark>")
+  end
+
+  def search_excerpt(text, query, length: 280)
+    text = text.to_s
+    match_position = text.downcase.index(query.downcase) || 0
+    start_position = [ match_position - length / 3, 0 ].max
+    excerpt = text[start_position, length]
+    excerpt = "…#{excerpt}" if start_position.positive?
+    excerpt = "#{excerpt}…" if start_position + length < text.length
+
+    highlighted_search_text(excerpt, query)
+  end
+end
