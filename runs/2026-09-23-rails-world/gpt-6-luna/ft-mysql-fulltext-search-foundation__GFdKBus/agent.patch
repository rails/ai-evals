diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..665203e
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "searches card titles and descriptions" do
+    title_match = boards(:writebook).cards.create!(creator: users(:kevin), title: "Needle in title", status: :published)
+    description_match = boards(:writebook).cards.create!(creator: users(:kevin), title: "Description result", description: "A needle is here", status: :published)
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "a[href='#{card_path(title_match)}'] mark", text: "Needle"
+    assert_select "a[href='#{card_path(description_match)}']"
+    assert_select "article p mark", text: "needle"
+  end
+
+  test "searches comment bodies and orders results newest first" do
+    first = boards(:writebook).cards.create!(creator: users(:kevin), title: "Older comment result", status: :published, created_at: 2.days.ago)
+    first.comments.create!(creator: users(:kevin), body: "Comment has a needle")
+    second = boards(:writebook).cards.create!(creator: users(:kevin), title: "Newer comment result", status: :published, created_at: 1.day.ago)
+    second.comments.create!(creator: users(:kevin), body: "Another needle comment")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "article h2 a", text: /Newer comment result/ do |links|
+      assert_equal card_path(second), links.first["href"]
+    end
+    assert_select "article blockquote mark", text: "needle"
+  end
+
+  test "does not return drafts or draft comments" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), title: "Hidden needle", status: :published)
+    draft.comments.create!(creator: users(:kevin), body: "Hidden comment needle")
+    draft.update_column :status, "drafted"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_no_match "Hidden needle", response.body
+    assert_no_match "Hidden comment needle", response.body
+    assert_select ".blank-slate", text: "No cards match this search"
+  end
+
+  test "only returns cards from boards the user currently can access" do
+    card = boards(:writebook).cards.create!(creator: users(:kevin), title: "Private needle", status: :published)
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "Private needle" }
+
+    assert_response :success
+    assert_select "article a[href=?]", card_path(card), count: 0
+  end
+
+  test "treats SQL wildcard characters literally and escapes highlighted HTML" do
+    matching = boards(:writebook).cards.create!(creator: users(:kevin), title: "100% <script>needle</script>", status: :published)
+    boards(:writebook).cards.create!(creator: users(:kevin), title: "100x unrelated", status: :published)
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "article a[href='#{card_path(matching)}']"
+    assert_no_match "100x unrelated", response.body
+    assert_no_match "<script>needle</script>", response.body
+  end
+
+  test "blank query has no results" do
+    get search_path
+
+    assert_response :success
+    assert_select "article", count: 0
+  end
+end
