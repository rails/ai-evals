diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..5e0a2bf
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,29 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(term) do
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+
+      where(<<~SQL.squish, pattern: pattern)
+        cards.title LIKE :pattern ESCAPE '!'
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Card'
+            AND action_text_rich_texts.record_id = cards.id
+            AND action_text_rich_texts.name = 'description'
+            AND action_text_rich_texts.body LIKE :pattern ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts
+            ON action_text_rich_texts.record_type = 'Comment'
+            AND action_text_rich_texts.record_id = comments.id
+            AND action_text_rich_texts.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND action_text_rich_texts.body LIKE :pattern ESCAPE '!'
+        )
+      SQL
+    end
+  end
+end
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..c2bfe74
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,34 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search</h1>
+<% end %>
+
+<main class="pad-inline pad-block">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <section class="search-results">
+      <% @page.records.each do |card| %>
+        <article class="search-result pad-block border-block-end">
+          <h2 class="txt-large"><%= link_to highlighted_search_text(card.title, @query), card_path(card) %></h2>
+          <p class="txt-x-small translucent"><%= card.board.name %> · <%= card.created_at.to_date %></p>
+
+          <% description = card.description.to_plain_text %>
+          <% if description.downcase.include?(@query.downcase) %>
+            <p><%= search_excerpt(description, @query) %></p>
+          <% end %>
+
+          <% @matching_comments_by_card.fetch(card.id, []).each do |comment| %>
+            <blockquote><%= search_excerpt(comment.body.to_plain_text, @query) %></blockquote>
+          <% end %>
+        </article>
+      <% end %>
+      <%= link_to_next_page :search_results, @page %>
+      <% if @page.records.empty? %><div class="blank-slate">No cards match this search</div><% end %>
+    </section>
+  <% end %>
+</main>
