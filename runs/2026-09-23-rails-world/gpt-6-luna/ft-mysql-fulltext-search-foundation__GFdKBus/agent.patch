@@ -0,0 +1,34 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    results = if @query.present?
+      Current.user.accessible_cards.published.search(@query).reverse_chronologically
+    else
+      Current.user.accessible_cards.none
+    end
+
+    set_page_and_extract_portion_from results
+    load_matching_comments
+  end
+
+  private
+    def load_matching_comments
+      card_ids = @page.records.map(&:id)
+      if @query.present? && card_ids.any?
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(@query, "!")}%"
+        @matching_comments_by_card = Comment
+          .joins(<<~SQL.squish)
+            INNER JOIN action_text_rich_texts
+              ON action_text_rich_texts.record_type = 'Comment'
+              AND action_text_rich_texts.record_id = comments.id
+              AND action_text_rich_texts.name = 'body'
+          SQL
+          .where(card_id: card_ids)
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", pattern)
+          .with_rich_text_body
+          .group_by(&:card_id)
+      else
+        @matching_comments_by_card = {}
+      end
+    end
+end
