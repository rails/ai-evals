@@ -0,0 +1,26 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    subscription = PushSubscription.find_or_initialize_by(user: @user, endpoint: subscription_params[:endpoint])
+    subscription.assign_attributes(subscription_params.except(:endpoint))
+    subscription.save!
+
+    render json: { id: subscription.id }, status: :created
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/push_notifications_controller.js b/app/javascript/controllers/push_notifications_controller.js
new file mode 100644
index 0000000..8690698
--- /dev/null
+++ b/app/javascript/controllers/push_notifications_controller.js
@@ -0,0 +1,122 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "browserHelp", "systemHelp" ]
+  static values = { publicKey: String, createUrl: String }
+
+  async connect() {
+    if (!this.browserSupportsPush) {
+      this.buttonTarget.disabled = true
+      this.statusTarget.textContent = "Push notifications are not available in this browser."
+      return
+    }
+
+    if (!this.publicKeyValue) {
+      this.buttonTarget.disabled = true
+      this.statusTarget.textContent = "Push notifications are not configured for this app yet."
+      return
+    }
+
+    this.permissionChanged()
+    const subscription = await this.currentSubscription()
+    if (subscription) await this.saveSubscription(subscription)
+    this.updateButton(subscription)
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+
+    try {
+      if (await this.currentSubscription()) {
+        await this.disable()
+      } else {
+        await this.enable()
+      }
+    } catch (error) {
+      this.statusTarget.textContent = error.message || "Could not update push notification settings."
+    } finally {
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  async enable() {
+    const permission = await Notification.requestPermission()
+    this.permissionChanged()
+
+    if (permission !== "granted") {
+      this.statusTarget.textContent = "Allow notifications in your browser to turn on push notifications."
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.applicationServerKey
+    })
+    await this.saveSubscription(subscription)
+    this.updateButton(subscription)
+    this.statusTarget.textContent = "Push notifications are on for this device."
+  }
+
+  async disable() {
+    const subscription = await this.currentSubscription()
+    if (this.subscriptionId) {
+      await fetch(`${this.createUrlValue}/${this.subscriptionId}`, {
+        method: "DELETE",
+        headers: { "X-CSRF-Token": this.csrfToken }
+      })
+    }
+    if (subscription) await subscription.unsubscribe()
+
+    this.subscriptionId = null
+    this.updateButton(null)
+    this.statusTarget.textContent = "Push notifications are off for this device."
+  }
+
+  async saveSubscription(subscription) {
+    const response = await fetch(this.createUrlValue, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "X-CSRF-Token": this.csrfToken
+      },
+      body: JSON.stringify({ push_subscription: {
+        endpoint: subscription.endpoint,
+        p256dh_key: subscription.toJSON().keys.p256dh,
+        auth_key: subscription.toJSON().keys.auth
+      } })
+    })
+
+    if (!response.ok) throw new Error("Could not save this device's push subscription.")
+    this.subscriptionId = (await response.json()).id
+  }
+
+  async currentSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  updateButton(subscription) {
+    this.buttonTarget.textContent = subscription ? "Turn off on this device" : "Turn on on this device"
+    this.buttonTarget.setAttribute("aria-pressed", subscription ? "true" : "false")
+  }
+
+  permissionChanged() {
+    if (this.hasBrowserHelpTarget) this.browserHelpTarget.hidden = Notification.permission !== "denied"
+    if (this.hasSystemHelpTarget) this.systemHelpTarget.hidden = Notification.permission !== "granted"
+  }
+
+  get browserSupportsPush() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+
+  get csrfToken() {
+    return document.querySelector("meta[name='csrf-token']")?.content
+  }
+}
diff --git a/app/jobs/send_push_notification_job.rb b/app/jobs/send_push_notification_job.rb
