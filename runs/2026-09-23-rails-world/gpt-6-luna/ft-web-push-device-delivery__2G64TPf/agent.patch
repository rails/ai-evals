@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "creates a push subscription for the signed in user" do
+    assert_difference "PushSubscription.count", 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscription/123",
+          p256dh_key: "public-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal @user, PushSubscription.last.user
+    assert_equal "public-key", PushSubscription.last.p256dh_key
+    assert_equal PushSubscription.last.id, @response.parsed_body["id"]
+  end
+
+  test "updates the key material for an existing endpoint" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.test/123", p256dh_key: "old", auth_key: "old")
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new",
+          auth_key: "new"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new", subscription.reload.p256dh_key
+  end
+
+  test "does not allow registering for another user" do
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/private",
+          p256dh_key: "public-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+
+      assert_response :forbidden
+    end
+  end
+
+  test "removes a subscription belonging to the signed in user" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.test/123", p256dh_key: "public-key", auth_key: "auth-key")
+
+    assert_difference "PushSubscription.count", -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/jobs/send_push_notification_job_test.rb b/test/jobs/send_push_notification_job_test.rb
new file mode 100644
index 0000000..78b794b
--- /dev/null
+++ b/test/jobs/send_push_notification_job_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class SendPushNotificationJobTest < ActiveSupport::TestCase
+test "push payload matches the tray notification and opens its card" do
+  [ notifications(:layout_commented_kevin), notifications(:logo_mentioned_david) ].each do |notification|
+    user = notification.user
+
+    payload, tray_payload = Current.with(account: user.account) do
+      renderer = ApplicationController.renderer
+      payload = JSON.parse(renderer.render(
+        template: "notifications/notification/push",
+        locals: { notification: notification },
+        formats: [ :json ]
+      ))
+      tray_payload = JSON.parse(renderer.render(
+        partial: "notifications/notification",
+        locals: { notification: notification },
+        formats: [ :json ]
+      ))
+      [ payload, tray_payload ]
+    end
+
+    assert_equal tray_payload["title"], payload["title"]
+    assert_equal tray_payload["body"], payload["body"]
+    assert_includes payload["url"], user.account.slug
+    assert_includes payload["url"], notification.card.to_param
+  end
+end
+
+  test "sends the rendered notification with the user's VAPID subscription" do
+    notification = notifications(:layout_commented_kevin)
+    subscription = notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/123",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+    arguments = nil
+
+    with_vapid_keys do
+      Current.with(account: notification.account) do
+        with_stubbed_web_push(->(**options) { arguments = options }) do
+          SendPushNotificationJob.new.perform(notification)
+        end
+      end
+    end
+
+    assert_equal subscription.endpoint, arguments[:endpoint]
+    assert_equal "p256dh", arguments[:p256dh]
+    assert_equal "auth", arguments[:auth]
+    assert_equal "public-vapid-key", arguments.dig(:vapid, :public_key)
+    assert_equal "private-vapid-key", arguments.dig(:vapid, :private_key)
+    assert_equal tray_title(notification), JSON.parse(arguments[:message])["title"]
+  end
+
+  private
+    def tray_title(notification)
+      JSON.parse(ApplicationController.renderer.render(
+        partial: "notifications/notification",
+        locals: { notification: notification },
+        formats: [ :json ]
+      ))["title"]
+    end
+
+    def with_stubbed_web_push(callback)
+      original_method = WebPush.method(:payload_send)
+      WebPush.singleton_class.define_method(:payload_send, callback)
+      yield
+    ensure
+      WebPush.singleton_class.define_method(:payload_send, original_method)
+    end
+
+    def with_vapid_keys
+      previous_public_key = ENV["VAPID_PUBLIC_KEY"]
+      previous_private_key = ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "public-vapid-key"
+      ENV["VAPID_PRIVATE_KEY"] = "private-vapid-key"
+
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = previous_public_key
+      ENV["VAPID_PRIVATE_KEY"] = previous_private_key
+    end
+end
