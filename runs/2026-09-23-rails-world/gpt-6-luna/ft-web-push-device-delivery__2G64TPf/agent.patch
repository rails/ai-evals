+++ b/app/jobs/send_push_notification_job.rb
@@ -0,0 +1,20 @@
+class SendPushNotificationJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification)
+    return if notification.read?
+    return unless ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+
+    payload = ApplicationController.renderer.render(
+      template: "notifications/notification/push",
+      locals: { notification: notification },
+      formats: [ :json ]
+    )
+
+    notification.user.push_subscriptions.find_each do |subscription|
+      subscription.send_notification(payload)
+    rescue WebPush::Error => error
+      Rails.logger.warn("Push notification delivery failed: #{error.message}")
+    end
+  end
+end
