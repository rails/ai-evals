@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admin can publish and unpublish a board" do
+    board = boards(:writebook)
+    assert_nil board.public_key
+
+    post board_publication_path(board)
+
+    assert_response :success
+    board.reload
+    assert board.published?
+    assert_equal public_board_url(board.public_key, script_name: ""), response.parsed_body["public_url"]
+
+    delete board_publication_path(board)
+
+    assert_response :no_content
+    assert_nil board.reload.public_key
+  end
+
+  test "non-admin cannot publish a board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(boards(:writebook))
+
+    assert_response :forbidden
+    assert_nil boards(:writebook).reload.public_key
+  end
+end
