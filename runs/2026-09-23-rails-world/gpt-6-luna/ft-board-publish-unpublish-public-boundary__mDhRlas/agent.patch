--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,23 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :set_board
+  before_action :ensure_permission_to_publish
+
+  def create
+    @board.publish
+    render json: { public_url: public_board_url(@board.public_key, script_name: "") }
+  end
+
+  def destroy
+    @board.unpublish
+    head :no_content
+  end
+
+  private
+    def set_board
+      @board = Current.user.boards.find(params[:board_id])
+    end
+
+    def ensure_permission_to_publish
+      head :forbidden unless Current.user.can_administer_board?(@board)
+    end
+end
