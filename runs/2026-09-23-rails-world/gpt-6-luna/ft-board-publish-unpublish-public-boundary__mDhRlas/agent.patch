+module Public
+  class BoardsController < ApplicationController
+    allow_unauthenticated_access
+    skip_before_action :require_account
+
+    before_action :set_board
+
+    def show
+      @columns = @board.columns.sorted
+      @cards_without_column = @board.cards.published.where(column_id: nil).latest
+    end
+
+    private
+      def set_board
+        @board = Board.find_by!(public_key: params[:board_key] || params[:key])
+        Current.account = @board.account
+      end
+  end
+end
