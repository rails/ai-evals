diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..ed5ea49
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  test "published board and its published cards can be viewed without authentication" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-key")
+
+    get public_board_path(board.public_key, script_name: "")
+
+    assert_response :success
+    assert_select "h1", board.name
+    assert_select "a", text: cards(:logo).title
+    assert_select "a", text: cards(:unfinished_thoughts).title, count: 0
+  end
+
+  test "public column only shows published cards belonging to that board" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-key")
+
+    get public_board_column_path(board.public_key, columns(:writebook_triage), script_name: "")
+
+    assert_response :success
+    assert_select "a", text: cards(:logo).title
+    assert_select "a", text: cards(:unfinished_thoughts).title, count: 0
+  end
+
+  test "published card can be viewed directly but drafts cannot" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-key")
+    draft = board.cards.create!(creator: board.creator, status: :drafted, title: "Secret draft")
+
+    get public_board_card_path(board.public_key, cards(:logo).number, script_name: "")
+    assert_response :success
+    assert_select "h1", cards(:logo).title
+
+    get public_board_card_path(board.public_key, draft.number, script_name: "")
+    assert_response :not_found
+  end
+
+  test "unknown and unpublished keys are not found" do
+    get public_board_path("unknown-key", script_name: "")
+    assert_response :not_found
+
+    board = boards(:writebook)
+    board.update!(public_key: "revoked-key")
+    board.update!(public_key: nil)
+
+    get public_board_path("revoked-key", script_name: "")
+    assert_response :not_found
+  end
+end
