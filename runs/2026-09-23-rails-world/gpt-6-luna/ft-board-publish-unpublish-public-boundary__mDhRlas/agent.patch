+<% @page_title = @board.name %>
+
+<h1><%= @board.name %></h1>
+
+<% @columns.each do |column| %>
+  <section>
+    <h2><%= link_to column.name, public_board_column_path(@board.public_key, column, script_name: "") %></h2>
+    <ul>
+      <% column.cards.published.latest.each do |card| %>
+        <li><%= link_to card.title, public_board_card_path(@board.public_key, card.number, script_name: "") %></li>
+      <% end %>
+    </ul>
+  </section>
+<% end %>
+
+<% if @cards_without_column.any? %>
+  <section>
+    <h2>Other cards</h2>
+    <ul>
+      <% @cards_without_column.each do |card| %>
+        <li><%= link_to card.title, public_board_card_path(@board.public_key, card.number, script_name: "") %></li>
+      <% end %>
+    </ul>
+  </section>
+<% end %>
