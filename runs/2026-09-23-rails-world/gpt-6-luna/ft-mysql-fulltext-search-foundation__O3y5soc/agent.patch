@@ -0,0 +1,36 @@
+class SearchesController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @cards = if @query.present?
+      Current.user.accessible_cards.published
+        .where(search_conditions, query: @query)
+        .includes(:rich_text_description, comments: :rich_text_body)
+        .order(created_at: :desc, id: :desc)
+    else
+      Card.none
+    end
+  end
+
+  private
+    def search_conditions
+      <<~SQL.squish
+        INSTR(LOWER(cards.title), LOWER(:query)) > 0
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts descriptions
+          WHERE descriptions.record_type = 'Card'
+            AND descriptions.record_id = cards.id
+            AND descriptions.name = 'description'
+            AND INSTR(LOWER(descriptions.body), LOWER(:query)) > 0
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND INSTR(LOWER(comment_bodies.body), LOWER(:query)) > 0
+        )
+      SQL
+    end
+end
