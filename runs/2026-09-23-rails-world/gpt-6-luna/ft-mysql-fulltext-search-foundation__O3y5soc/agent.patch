diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..396c2da
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "searches card titles, descriptions, and comment bodies newest first" do
+    title_match = create_search_card(title: "Needle title")
+    description_match = create_search_card(title: "Description match", description: "A hidden needle in here")
+    comment_match = create_search_card(title: "Comment match")
+    comment_match.comments.create!(creator: users(:kevin), body: "A comment with needle inside")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "ol.search-results__list > li", count: 3
+    ids = css_select("ol.search-results__list > li h3 a").map { |link| link["href"] }
+    assert_equal [ comment_match, description_match, title_match ].map { |card| card_path(card) }, ids
+    assert_select "mark", text: "Needle"
+    assert_select "mark", text: "needle", minimum: 2
+  end
+
+  test "does not return inaccessible or draft cards" do
+    hidden = boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Needle hidden")
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Needle draft")
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_no_match "Needle hidden", response.body
+    assert_no_match "Needle draft", response.body
+  end
+
+  test "highlights matching terms without rendering card content as HTML" do
+    card = create_search_card(title: "<script>alert(1)</script> Rocket")
+
+    get search_path, params: { q: "rocket" }
+
+    assert_response :success
+    assert_select "h3 a[href=?] mark", card_path(card), text: "Rocket"
+    assert_no_match "<script>", response.body
+  end
+
+  test "search treats wildcard characters literally" do
+    wildcard = create_search_card(title: "A 100% complete task")
+    unrelated = create_search_card(title: "A 100 percent complete task")
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "ol.search-results__list > li", count: 1
+    assert_includes response.body, card_path(wildcard)
+    assert_not_includes response.body, card_path(unrelated)
+  end
+
+
+  test "blank query renders without results" do
+    get search_path
+
+    assert_response :success
+    assert_select "ol.search-results__list", count: 0
+  end
+
+  private
+    def create_search_card(title:, description: nil)
+      board = boards(:writebook)
+      board.cards.create!(
+        creator: users(:kevin), status: :published, title: title,
+        description: description, created_at: Time.current + Card.count.seconds
+      )
+    end
+end
