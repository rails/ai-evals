diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..258fddf
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search</h1>
+<% end %>
+
+<section class="search-results">
+  <%= form_with url: search_path, method: :get, class: "search-results__form" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input full-width" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <h2>Results for <%= @query %></h2>
+
+    <% if @cards.any? %>
+      <ol class="search-results__list">
+        <% @cards.each do |card| %>
+          <li class="search-results__item">
+            <h3><%= link_to highlight_search_text(card.title, @query), card_path(card) %></h3>
+            <p><%= link_to card.board.name, board_path(card.board) %></p>
+
+            <% description = card.description.to_plain_text %>
+            <% if search_text_matches?(description, @query) %>
+              <p><%= highlight_search_text(description, @query) %></p>
+            <% end %>
+
+            <% card.comments.each do |comment| %>
+              <% body = comment.body.to_plain_text %>
+              <% if search_text_matches?(body, @query) %>
+                <p><%= highlight_search_text(body, @query) %></p>
+              <% end %>
+            <% end %>
+          </li>
+        <% end %>
+      </ol>
+    <% else %>
+      <p>No cards found.</p>
+    <% end %>
+  <% end %>
+</section>
