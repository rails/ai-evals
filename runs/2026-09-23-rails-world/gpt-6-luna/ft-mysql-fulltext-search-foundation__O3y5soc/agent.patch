@@ -0,0 +1,20 @@
+module SearchesHelper
+  def search_text_matches?(text, query)
+    text.to_s.match?(Regexp.new(Regexp.escape(query), Regexp::IGNORECASE))
+  end
+
+  def highlight_search_text(text, query)
+    pattern = Regexp.new(Regexp.escape(query), Regexp::IGNORECASE)
+    highlighted = ActiveSupport::SafeBuffer.new
+    offset = 0
+
+    text.to_s.to_enum(:scan, pattern).each do
+      match = Regexp.last_match
+      highlighted << ERB::Util.html_escape(text.to_s[offset...match.begin(0)])
+      highlighted << tag.mark(ERB::Util.html_escape(match[0]))
+      offset = match.end(0)
+    end
+
+    highlighted << ERB::Util.html_escape(text.to_s[offset..])
+  end
+end
