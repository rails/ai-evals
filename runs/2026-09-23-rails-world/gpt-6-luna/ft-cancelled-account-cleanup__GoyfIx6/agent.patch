diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..f4e17df
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago" do
+    account = accounts(:initech)
+    account.cancel(initiated_by: account.users.first)
+    account.cancellation.update_column(:created_at, 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    account_scoped_tables = ActiveRecord::Base.connection.tables.select do |table|
+      ActiveRecord::Base.connection.columns(table).any? { |column| column.name == "account_id" }
+    end
+    remaining_tables = account_scoped_tables.select do |table|
+      ActiveRecord::Base.connection.select_value(
+        "SELECT COUNT(*) FROM #{table} WHERE account_id = #{ActiveRecord::Base.connection.quote(account.id)}"
+      ).to_i.positive?
+    end
+    assert_empty remaining_tables, "account-scoped records remain in: #{remaining_tables.join(', ')}"
+  end
+
+  test "does not incinerate accounts canceled within the 30 day grace period" do
+    account = accounts(:initech)
+    account.cancel(initiated_by: account.users.first)
+    account.cancellation.update_column(:created_at, 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+end
