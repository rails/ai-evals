diff --git a/app/jobs/deliver_notification_email_digest_job.rb b/app/jobs/deliver_notification_email_digest_job.rb
new file mode 100644
index 0000000..db18b5c
--- /dev/null
+++ b/app/jobs/deliver_notification_email_digest_job.rb
@@ -0,0 +1,17 @@
+class DeliverNotificationEmailDigestJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(digest)
+    settings = digest.user.settings
+
+    settings.with_lock do
+      current_digest = settings.current_notification_email_digest
+
+      if current_digest == digest && digest.sent_at.nil?
+        digest.update!(sent_at: Time.current)
+        settings.update!(current_notification_email_digest: nil)
+        NotificationEmailDigestMailer.digest(digest).deliver_later if digest.notifications.exists? && digest.user.identity.present?
+      end
+    end
+  end
+end
diff --git a/app/mailers/notification_email_digest_mailer.rb b/app/mailers/notification_email_digest_mailer.rb
new file mode 100644
index 0000000..f14b1dd
--- /dev/null
+++ b/app/mailers/notification_email_digest_mailer.rb
@@ -0,0 +1,9 @@
+class NotificationEmailDigestMailer < ApplicationMailer
+  def digest(digest)
+    @digest = digest
+    @user = @digest.user
+    @notifications = @digest.notifications.preloaded.ordered
+
+    mail to: @user.identity.email_address, subject: "Your Fizzy notification digest"
+  end
+end
diff --git a/app/models/notification_email_digest.rb b/app/models/notification_email_digest.rb
