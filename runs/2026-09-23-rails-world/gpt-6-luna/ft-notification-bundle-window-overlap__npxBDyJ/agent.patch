+++ b/app/models/notification_email_digest.rb
@@ -0,0 +1,17 @@
+class NotificationEmailDigest < ApplicationRecord
+  FREQUENCIES = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :user
+  has_many :notification_email_digest_notifications, dependent: :destroy
+  has_many :notifications, through: :notification_email_digest_notifications
+
+  validates :frequency, inclusion: { in: FREQUENCIES.keys }
+
+  def deliver_later
+    DeliverNotificationEmailDigestJob.set(wait_until: deliver_at).perform_later(self)
+  end
+end
