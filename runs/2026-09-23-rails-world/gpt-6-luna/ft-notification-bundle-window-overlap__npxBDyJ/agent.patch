@@ -0,0 +1,17 @@
+require "test_helper"
+
+class NotificationEmailDigestMailerTest < ActionMailer::TestCase
+  test "digest email includes notifications and is addressed to the recipient" do
+    user = users(:kevin)
+    digest = NotificationEmailDigest.create!(
+      user: user, frequency: "daily", opened_at: Time.current, deliver_at: 1.day.from_now
+    )
+    digest.notifications << notifications(:logo_assignment_kevin)
+
+    email = NotificationEmailDigestMailer.digest(digest)
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_includes email.subject, "notification digest"
+    assert_includes email.text_part.body.to_s, cards(:logo).title
+  end
+end
diff --git a/test/models/notification_email_digest_test.rb b/test/models/notification_email_digest_test.rb
new file mode 100644
index 0000000..9925950
--- /dev/null
+++ b/test/models/notification_email_digest_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class NotificationEmailDigestTest < ActiveSupport::TestCase
+  test "starts a four hour window with the first notification" do
+    settings = users(:kevin).settings
+    settings.update!(bundle_email_frequency: "every_few_hours")
+    notification = notifications(:logo_assignment_kevin)
+
+    travel_to Time.zone.parse("2026-01-01 12:00:00") do
+      settings.add_notification_to_email_digest(notification)
+
+      digest = settings.reload.current_notification_email_digest
+      assert_equal Time.current, digest.opened_at
+      assert_equal 4.hours.from_now, digest.deliver_at
+      assert_equal [ notification ], digest.notifications
+      assert_enqueued_with(job: DeliverNotificationEmailDigestJob, at: digest.deliver_at)
+    end
+  end
+
+  test "late notifications join the already-open window even after its target delivery time" do
+    settings = users(:kevin).settings
+    settings.update!(bundle_email_frequency: "every_few_hours")
+    first_notification = notifications(:logo_assignment_kevin)
+    late_notification = notifications(:layout_commented_kevin)
+
+    travel_to Time.zone.parse("2026-01-01 12:00:00") do
+      settings.add_notification_to_email_digest(first_notification)
+      digest_id = settings.current_notification_email_digest.id
+
+      travel 5.hours
+      settings.add_notification_to_email_digest(late_notification)
+
+      digest = settings.reload.current_notification_email_digest
+      assert_equal digest_id, digest.id
+      assert_equal [ first_notification, late_notification ].sort_by(&:id), digest.notifications.sort_by(&:id)
+      assert_equal 12, digest.opened_at.hour
+    end
+  end
+
+  test "delivery closes a window once so subsequent notifications open a new one" do
+    settings = users(:kevin).settings
+    settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:logo_assignment_kevin)
+    settings.add_notification_to_email_digest(notification)
+    digest = settings.current_notification_email_digest
+
+    perform_enqueued_jobs do
+      DeliverNotificationEmailDigestJob.perform_now(digest)
+    end
+
+    assert digest.reload.sent_at
+    assert_nil settings.reload.current_notification_email_digest
+
+    new_notification = notifications(:layout_commented_kevin)
+    settings.add_notification_to_email_digest(new_notification)
+    assert_not_equal digest, settings.reload.current_notification_email_digest
+  end
+
+  test "never does not make a digest" do
+    settings = users(:kevin).settings
+    settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference "NotificationEmailDigest.count" do
+      settings.add_notification_to_email_digest(notifications(:logo_assignment_kevin))
+    end
+  end
+
+  test "turning email digests off cancels an open window" do
+    settings = users(:kevin).settings
+    settings.update!(bundle_email_frequency: "daily")
+    settings.add_notification_to_email_digest(notifications(:logo_assignment_kevin))
+
+    settings.update!(bundle_email_frequency: "never")
+
+    assert_nil settings.reload.current_notification_email_digest
+  end
+
+  test "frequency has only supported values" do
+    settings = users(:david).settings
+    settings.bundle_email_frequency = "hourly"
+
+    assert_not settings.valid?
+    assert_includes settings.errors[:bundle_email_frequency], "is not included in the list"
+  end
+end
