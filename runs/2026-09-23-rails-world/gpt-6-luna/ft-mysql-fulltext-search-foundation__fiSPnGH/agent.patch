diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..4c99528
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles, descriptions, and comments" do
+    title_card = cards(:logo)
+    title_card.update_column :title, "Find the Quasar"
+
+    description_card = cards(:layout)
+    description_card.update! description: "A quasar is hiding in this description"
+
+    comment_card = cards(:text)
+    comments(:text_1).update! body: "Someone mentioned a quasar here"
+
+    get search_path, params: { q: "quasar" }
+
+    assert_response :success
+    assert_select "a[href=?] mark", card_path(title_card), text: "Quasar"
+    assert_select "article.search__result a[href=?]", card_path(description_card)
+    assert_select "article.search__result a[href=?]", card_path(comment_card)
+    assert_select ".search__comment mark", text: "quasar"
+    assert_select "article.search__result p mark", text: "quasar", count: 2
+  end
+
+  test "orders matching cards newest first" do
+    older_card = cards(:logo)
+    newer_card = cards(:layout)
+    older_card.update_columns title: "Search order token", created_at: 2.hours.ago
+    newer_card.update_columns title: "Search order token", created_at: 1.hour.ago
+
+    get search_path, params: { q: "Search order token" }
+
+    assert_response :success
+    assert_select "article.search__result h2 a", text: /Search order token/
+    assert_operator response.body.index(card_path(newer_card)), :<, response.body.index(card_path(older_card))
+  end
+
+  test "does not return drafted cards" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Quasar hidden draft")
+
+    get search_path, params: { q: "Quasar" }
+
+    assert_response :success
+    assert_no_match card_path(draft), response.body
+  end
+
+  test "only returns cards on boards the user can currently access" do
+    card = cards(:logo)
+    card.update_column :title, "Quasar access test"
+    board = card.board
+    board.update! all_access: false
+    board.accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "Quasar access test" }
+
+    assert_response :success
+    assert_no_match card_path(card), response.body
+  end
+
+  test "highlights matches while escaping card content" do
+    card = cards(:logo)
+    card.update_column :title, "Quasar <script>alert(1)</script>"
+
+    get search_path, params: { q: "Quasar" }
+
+    assert_response :success
+    assert_select "a[href=?] mark", card_path(card), text: "Quasar"
+    assert_no_match "<script>alert(1)</script>", response.body
+  end
+
+  test "treats SQL wildcard characters in the query literally" do
+    matching_card = cards(:logo)
+    matching_card.update_column :title, "A 100% reliable card"
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "article.search__result a[href=?]", card_path(matching_card)
+    assert_select "article.search__result", count: 1
+  end
+
+  test "shows no results until a query is provided" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?]", search_path
+    assert_select "article.search__result", count: 0
+  end
+end
