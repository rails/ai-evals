+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = if @query.present?
+      Current.user.accessible_cards.published.matching(@query).reverse_chronologically
+        .with_rich_text_description.includes(:board)
+    else
+      Current.user.accessible_cards.none
+    end
+
+    set_page_and_extract_portion_from cards
+    @comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def matching_comments_by_card
+      if @query.present? && @page.records.any?
+        pattern = "%#{Card.sanitize_sql_like(@query, "!")}%"
+
+        Comment.where(card_id: @page.records.map(&:id))
+          .joins(:rich_text_body)
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", pattern)
+          .includes(:rich_text_body)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..e69a79e 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -19,6 +19,30 @@ class Card < ApplicationRecord
   after_touch  -> { board.touch }, if: :published?
   after_update :handle_board_change, if: :saved_change_to_board_id?
 
+  scope :matching, ->(term) do
+    pattern = "%#{sanitize_sql_like(term, "!")}%"
+
+    where(<<~SQL.squish, pattern: pattern)
+      cards.title LIKE :pattern ESCAPE '!' OR
+      EXISTS (
+        SELECT 1 FROM action_text_rich_texts AS searched_descriptions
+        WHERE searched_descriptions.record_type = 'Card'
+          AND searched_descriptions.record_id = cards.id
+          AND searched_descriptions.name = 'description'
+          AND searched_descriptions.body LIKE :pattern ESCAPE '!'
+      ) OR
+      EXISTS (
+        SELECT 1 FROM comments AS searched_comments
+        INNER JOIN action_text_rich_texts AS searched_comment_bodies
+          ON searched_comment_bodies.record_type = 'Comment'
+          AND searched_comment_bodies.record_id = searched_comments.id
+          AND searched_comment_bodies.name = 'body'
+        WHERE searched_comments.card_id = cards.id
+          AND searched_comment_bodies.body LIKE :pattern ESCAPE '!'
+      )
+    SQL
+  end
+
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..5740370
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search</h1>
+<% end %>
+
+<section class="search pad-inline">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <%= form.label :q, "Search cards" %>
+    <%= form.search_field :q, value: @query, autofocus: true %>
+    <%= form.submit "Search" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <div class="search__results">
+      <% @page.records.each do |card| %>
+        <article class="search__result">
+          <h2><%= link_to highlight(card.title, @query, highlighter: '<mark>\1</mark>'), card %></h2>
+          <p class="txt-subtle"><%= link_to card.board.name, card.board %></p>
+
+          <% if card.description.present? %>
+            <p><%= highlight(card.description.to_plain_text, @query, highlighter: '<mark>\1</mark>') %></p>
+          <% end %>
+
+          <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+            <p class="search__comment"><%= highlight(comment.body.to_plain_text, @query, highlighter: '<mark>\1</mark>') %></p>
+          <% end %>
+        </article>
+      <% end %>
+      </div>
+    <% end %>
+    <% if @page.records.empty? %>
+      <p class="blank-slate">No cards match your search</p>
+    <% end %>
+  <% end %>
+</section>
