diff --git a/app/models/email_sign_in_code.rb b/app/models/email_sign_in_code.rb
new file mode 100644
index 0000000..11223f0
--- /dev/null
+++ b/app/models/email_sign_in_code.rb
@@ -0,0 +1,65 @@
+class EmailSignInCode < ApplicationRecord
+  EXPIRY_DURATION = 15.minutes
+  CODE_LENGTH = 6
+  MAX_ATTEMPTS = 10
+  PURPOSES = %w[ session signup join ].freeze
+
+  attr_reader :code
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :join_code, presence: true, if: -> { purpose == "join" }
+
+  def self.issue!(email_address:, purpose:, join_code: nil)
+    code = format("%06d", SecureRandom.random_number(1_000_000))
+    challenge = create!(
+      email_address: email_address,
+      code_digest: digest(code),
+      purpose: purpose,
+      join_code: join_code,
+      expires_at: EXPIRY_DURATION.from_now
+    )
+    challenge.instance_variable_set(:@code, code)
+    EmailSignInCodeMailer.with(email_address: challenge.email_address, code: code).code.deliver_later
+    challenge
+  end
+
+  def consume(code)
+    return false unless persisted?
+
+    with_lock do
+      if expired? || attempts >= MAX_ATTEMPTS
+        destroy!
+        false
+      else
+        increment!(:attempts)
+
+        if secure_code_match?(code)
+          destroy!
+          true
+        elsif attempts >= MAX_ATTEMPTS
+          destroy!
+          false
+        else
+          false
+        end
+      end
+    end
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  private
+    def secure_code_match?(code)
+      return false unless code.to_s.match?(/\A\d{#{CODE_LENGTH}}\z/)
+
+      ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.send(:digest, code))
+    end
+
+    def self.digest(code)
+      OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code)
+    end
+end
