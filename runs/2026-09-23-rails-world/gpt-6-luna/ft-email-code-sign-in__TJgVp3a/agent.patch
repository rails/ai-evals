diff --git a/test/controllers/email_sign_in_codes_controller_test.rb b/test/controllers/email_sign_in_codes_controller_test.rb
new file mode 100644
index 0000000..f0cba67
--- /dev/null
+++ b/test/controllers/email_sign_in_codes_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class EmailSignInCodesControllerTest < ActionDispatch::IntegrationTest
+  test "signs in an existing identity with a code from the email subject" do
+    challenge = nil
+    perform_enqueued_jobs do
+      untenanted do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+        assert_response :redirect
+        challenge = EmailSignInCode.order(:created_at).last
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject.match(/\b\d{6}\b/).to_s
+    assert_equal identities(:kevin).email_address, email.to.first
+    assert_equal 6, code.length
+    assert_equal "session", challenge.purpose
+    assert_in_delta 15.minutes.from_now, challenge.expires_at, 2.seconds
+
+    untenanted do
+      patch email_sign_in_code_path(challenge), params: { code: code }
+      assert_response :redirect
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "signs up only after valid code verification" do
+    challenge = nil
+    perform_enqueued_jobs do
+      untenanted do
+        post signup_path, params: { signup: { email_address: "newuser@example.com" } }
+        assert_response :redirect
+        challenge = EmailSignInCode.order(:created_at).last
+      end
+    end
+
+    assert_no_difference -> { Identity.count } do
+      untenanted do
+        patch email_sign_in_code_path(challenge), params: { code: "000000" }
+        assert_response :redirect
+      end
+    end
+
+    code = ActionMailer::Base.deliveries.last.subject.match(/\b\d{6}\b/).to_s
+    untenanted do
+      patch email_sign_in_code_path(challenge), params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+    assert Identity.exists?(email_address: "newuser@example.com")
+    assert_not EmailSignInCode.exists?(challenge.id)
+  end
+
+  test "rejects expired codes" do
+    challenge = EmailSignInCode.create!(
+      email_address: identities(:kevin).email_address,
+      code_digest: "not-a-valid-digest",
+      purpose: "session",
+      expires_at: 1.second.ago
+    )
+
+    untenanted do
+      get email_sign_in_code_path(challenge)
+      assert_redirected_to new_session_path
+    end
+
+    assert_not EmailSignInCode.exists?(challenge.id)
+  end
+
+  test "a successful join code joins the account after email verification" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email = "joiner@example.com"
+    challenge = nil
+
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email }
+      assert_response :redirect
+      challenge = EmailSignInCode.order(:created_at).last
+    end
+
+    code = ActionMailer::Base.deliveries.last.subject.match(/\b\d{6}\b/).to_s
+    assert_difference -> { User.where(account: account).count }, 1 do
+      patch email_sign_in_code_path(challenge, script_name: nil), params: { code: code }
+      assert_response :redirect
+    end
+    assert Identity.find_by!(email_address: email).users.exists?(account: account)
+  end
+test "limits incorrect attempts and consumes a code only once" do
+  challenge = EmailSignInCode.issue!(email_address: identities(:kevin).email_address, purpose: "session")
+  code = challenge.code
+  10.times { assert_not challenge.consume("wrong!") }
+  assert_not EmailSignInCode.exists?(challenge.id)
+
+  replacement = EmailSignInCode.issue!(email_address: identities(:kevin).email_address, purpose: "session")
+  assert replacement.consume(replacement.code)
+  assert_not replacement.consume(replacement.code)
+end
+
+test "a sign-in code for an unknown email does not create an identity" do
+  perform_enqueued_jobs do
+    untenanted do
+      post session_path, params: { email_address: "unknown@example.com" }
+      assert_response :redirect
+    end
+  end
+
+  challenge = EmailSignInCode.order(:created_at).last
+  code = ActionMailer::Base.deliveries.last.subject.match(/\b\d{6}\b/).to_s
+  assert_no_difference -> { Identity.count } do
+    untenanted do
+      patch email_sign_in_code_path(challenge), params: { code: code }
+      assert_redirected_to new_session_path
+    end
+  end
+end
+end
