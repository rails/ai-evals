+class EmailSignInCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :update, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def show
+    @email_sign_in_code = EmailSignInCode.find(params[:id])
+
+    if @email_sign_in_code.expired?
+      @email_sign_in_code.destroy!
+      redirect_to new_session_path, alert: "That code has expired. Please request a new one."
+    end
+  end
+
+  def update
+    @email_sign_in_code = EmailSignInCode.find_by(id: params[:id])
+
+    if @email_sign_in_code&.consume(params.expect(:code))
+      complete_sign_in
+    else
+      redirect_to email_sign_in_code_path(id: params[:id]), alert: "That code is incorrect or expired. Please try again."
+    end
+  end
+
+  private
+    def complete_sign_in
+      if @email_sign_in_code.purpose == "session"
+        identity = Identity.find_by(email_address: @email_sign_in_code.email_address)
+
+        if identity&.users_with_active_accounts&.exists?
+          start_new_session_for identity
+          redirect_to after_authentication_url
+        else
+          redirect_to new_session_path, alert: "We couldn’t find an account for that email address. Sign up to create one."
+        end
+      else
+        identity = Identity.find_or_create_by!(email_address: @email_sign_in_code.email_address)
+
+        case @email_sign_in_code.purpose
+        when "signup"
+          start_new_session_for identity
+          redirect_to new_signup_completion_path
+        when "join"
+          complete_join(identity)
+        end
+      end
+    end
+
+    def complete_join(identity)
+      join_code = Account::JoinCode.find_by(code: @email_sign_in_code.join_code)
+
+      if join_code&.active?
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by(account: join_code.account, identity: identity)
+
+        if user
+          start_new_session_for identity
+
+          if user.setup?
+            redirect_to landing_url(script_name: join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: join_code.account.slug)
+          end
+        else
+          redirect_to new_session_path, alert: "That join code is no longer available."
+        end
+      else
+        redirect_to new_session_path, alert: "That join code is no longer available."
+      end
+    end
+
+    def rate_limit_exceeded
+      redirect_to email_sign_in_code_path(id: params[:id]), alert: "Try again later."
+    end
+end
