diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..5ca14c1
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns newest accessible timeline activity as flat JSON" do
+    get activities_path
+
+    assert_response :success
+    activity = response.parsed_body.first
+    assert_kind_of Array, response.parsed_body
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], activity.keys.sort
+    assert_equal "card_assigned", activity["action"]
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+    assert activity["description"].present?
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal({}, response.parsed_body.find { |item| item["action"] == "card_published" }["particulars"])
+    assert_equal card_url(cards(:layout)), activity["url"]
+    timestamps = response.parsed_body.map { |item| Time.parse(item["created_at"]) }
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  test "includes title changes and excludes collection changes" do
+    events(:text_published).update!(action: "card_title_changed", particulars: { particulars: { old_title: "Old", new_title: "New" } })
+    events(:shipping_closed).update!(action: "card_collection_changed")
+
+    get activities_path
+
+    actions = response.parsed_body.map { |activity| activity["action"] }
+    title_change = response.parsed_body.find { |item| item["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, title_change["particulars"])
+    assert_includes actions, "card_title_changed"
+    assert_not_includes actions, "card_collection_changed"
+  end
+
+  test "missing particulars values are empty strings" do
+    events(:logo_published).update!(action: "card_board_changed", particulars: { particulars: {} })
+    events(:buy_domain_sent_back_to_triage).update!(action: "card_triaged", particulars: { particulars: {} })
+
+    get activities_path
+
+    board_change = response.parsed_body.find { |item| item["action"] == "card_board_changed" }
+    triage = response.parsed_body.find { |item| item["action"] == "card_triaged" }
+    assert_equal({ "old_board" => "", "new_board" => "" }, board_change["particulars"])
+    assert_equal({ "column" => "" }, triage["particulars"])
+  end
+
+  test "comment activity links to its card and comment anchor" do
+    get activities_path
+
+    activity = response.parsed_body.find { |item| item["action"] == "comment_created" }
+    assert_equal card_url(cards(:layout), anchor: dom_id(comments(:layout_overflowing_david))), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+  end
+
+  test "filters by creator and accessible board" do
+    get activities_path, params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    assert response.parsed_body.any?
+    assert response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+    assert response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+end
