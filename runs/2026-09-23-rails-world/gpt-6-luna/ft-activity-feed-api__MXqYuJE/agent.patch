new file mode 100644
index 0000000..fdd10bb
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,33 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    events = Current.user.accessible_events
+      .preloaded
+      .where(action: TIMELINEABLE_ACTIONS)
+      .includes(creator: :identity, board: { creator: :identity })
+
+    events = events.where(creator_id: activity_params[:creator_ids]) if activity_params[:creator_ids].present?
+    events = events.where(board_id: Current.user.boards.where(id: activity_params[:board_ids])) if activity_params[:board_ids].present?
+
+    set_page_and_extract_portion_from events.order(created_at: :desc, id: :desc)
+  end
+
+  private
+    def activity_params
+      params.permit(creator_ids: [], board_ids: [])
+    end
+end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..251886f
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,36 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action, :eventable_type)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.url polymorphic_url(event.eventable)
+
+  particulars = case event.action
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: event.assignee_ids || [] }
+  when "card_board_changed"
+    {
+      old_board: event.particulars&.dig("particulars", "old_board").presence || "",
+      new_board: event.particulars&.dig("particulars", "new_board").presence || ""
+    }
+  when "card_title_changed"
+    {
+      old_title: event.particulars&.dig("particulars", "old_title").presence || "",
+      new_title: event.particulars&.dig("particulars", "new_title").presence || ""
+    }
+  when "card_triaged"
+    { column: event.particulars&.dig("particulars", "column").presence || "" }
+  else
+    {}
+  end
+  json.particulars particulars
+
+  json.eventable do
+    case event.eventable
+    when Card then json.partial! "cards/card", card: event.eventable
+    when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
