@@ -0,0 +1,36 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ]
+
+  def index
+    events = Current.user.accessible_events
+      .where(action: TIMELINEABLE_ACTIONS)
+      .preloaded.includes(eventable: [ :card, :creator ])
+
+    events = events.where(creator_id: creator_ids) if creator_ids.present?
+    events = events.where(board_id: board_ids) if board_ids.present?
+
+    set_page_and_extract_portion_from events.order(created_at: :desc, id: :desc)
+  end
+
+  private
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..3d766da
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,35 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  details = event.particulars.dig("particulars") || {}
+  particulars = case event.action
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: event.assignee_ids || [] }
+  when "card_board_changed"
+    { old_board: details["old_board"] || "", new_board: details["new_board"] || "" }
+  when "card_title_changed"
+    { old_title: details["old_title"] || "", new_title: details["new_title"] || "" }
+  when "card_triaged"
+    { column: details["column"] || "" }
+  else
+    {}
+  end
+  json.particulars particulars
+
+  if event.action.comment_created?
+    json.url card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable))
+  else
+    json.url card_url(event.eventable)
+  end
+
+  json.eventable_type event.eventable_type
+  json.eventable do
+    case event.eventable
+    when Card then json.partial! "cards/card", card: event.eventable
+    when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
