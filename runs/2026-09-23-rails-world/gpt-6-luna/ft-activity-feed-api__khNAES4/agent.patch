diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..91c9b7a
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @token = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+  end
+
+  test "returns newest accessible timeline activity with API representations" do
+    get activities_path(format: :json), headers: @token
+
+    assert_response :success
+    activities = response.parsed_body
+    assert_kind_of Array, activities
+    assert_equal activities.sort_by { |activity| [ activity["created_at"], activity["id"] ] }.reverse.map { |activity| activity["id"] }, activities.map { |activity| activity["id"] }
+
+    activity = activities.find { |item| item["id"] == events(:logo_assignment_jz).id }
+    assert_equal %w[id action created_at description particulars url eventable_type eventable board creator], activity.keys
+    assert_equal "card_assigned", activity["action"]
+    assert_equal events(:logo_assignment_jz).assignee_ids, activity.dig("particulars", "assignee_ids")
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal card_url(cards(:logo)), activity["url"]
+  end
+
+  test "filters activity by creator and board" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ]), headers: @token
+
+    assert_response :success
+    assert response.parsed_body.any?
+    assert response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id && activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "comments link to the card and comment anchor" do
+    get activities_path(format: :json), headers: @token
+
+    comment_activity = response.parsed_body.find { |activity| activity["id"] == events(:layout_commented).id }
+    assert_equal "Comment", comment_activity["eventable_type"]
+    assert_equal card_url(cards(:layout), anchor: ActionView::RecordIdentifier.dom_id(comments(:layout_overflowing_david))), comment_activity["url"]
+  end
+
+  test "omits collection changes and includes title changes" do
+    title_event = events(:logo_published)
+    title_event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } })
+    collection_event = events(:logo_assignment_jz)
+    collection_event.update_column(:action, "card_collection_changed")
+
+    get activities_path(format: :json), headers: @token
+
+    actions_by_id = response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal "card_title_changed", actions_by_id.dig(title_event.id, "action")
+    assert_not actions_by_id.key?(collection_event.id)
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, actions_by_id.dig(title_event.id, "particulars"))
+  end
+
+  test "returns empty strings for missing change particulars" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => {} })
+
+    get activities_path(format: :json), headers: @token
+
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "returns empty particulars for other event types" do
+    get activities_path(format: :json), headers: @token
+
+    activity = response.parsed_body.find { |item| item["id"] == events(:logo_published).id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "returns empty strings for missing title and triage particulars" do
+    title_event = events(:logo_published)
+    title_event.update_columns(action: "card_title_changed", particulars: { "particulars" => {} })
+    triage_event = events(:logo_assignment_jz)
+    triage_event.update_columns(action: "card_triaged", particulars: { "particulars" => {} })
+
+    get activities_path(format: :json), headers: @token
+
+    activities = response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.dig(title_event.id, "particulars"))
+    assert_equal({ "column" => "" }, activities.dig(triage_event.id, "particulars"))
+  end
+end
