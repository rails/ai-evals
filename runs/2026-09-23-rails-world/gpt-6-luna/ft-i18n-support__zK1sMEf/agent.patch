diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
index 87c3ab8..72e2642 100644
--- a/app/controllers/application_controller.rb
+++ b/app/controllers/application_controller.rb
@@ -10,4 +10,28 @@ class ApplicationController < ActionController::Base
   etag { "v1" }
   stale_when_importmap_changes
   allow_browser versions: :modern
+
+  around_action :with_locale
+
+  private
+    def with_locale(&action)
+      requested_locale = params[:locale].to_s
+      requested_locale = nil unless I18n.available_locales.map(&:to_s).include?(requested_locale)
+      session[:locale] = requested_locale if requested_locale.present?
+
+      identity = Current.identity || identity_from_session
+      locale = requested_locale || identity&.preferred_locale || session[:locale] || I18n.default_locale
+      I18n.with_locale(locale) do
+        action.call
+        if Current.identity && (requested_locale.present? || session[:locale].present?)
+          Current.identity.update_column(:preferred_locale, locale) unless Current.identity.preferred_locale == locale
+        end
+      end
+    end
+
+    def identity_from_session
+      if signed_session = cookies.signed[:session_token]
+        Session.find_signed(signed_session)&.identity
+      end
+    end
 end
