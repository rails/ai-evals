diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..34be4e0
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,114 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  start(event) {
+    const card = event.target.closest("[data-drag-and-drop-card]")
+
+    if (card) {
+      this.draggedCard = card
+      this.draggedCard.classList.add(this.draggedItemClass)
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  end() {
+    this.#clearDragState()
+  }
+
+  over(event) {
+    if (this.#columnFor(event.target)) event.preventDefault()
+  }
+
+  enter(event) {
+    const column = this.#columnFor(event.target)
+
+    if (column && this.draggedCard && column !== this.draggedCard.closest(".cards")) {
+      column.classList.add(this.hoverContainerClass)
+    }
+  }
+
+  leave(event) {
+    const column = this.#columnFor(event.target)
+
+    if (column && !column.contains(event.relatedTarget)) {
+      column.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  async drop(event) {
+    const column = this.#columnFor(event.target)
+
+    if (!column || !this.draggedCard) return
+
+    event.preventDefault()
+    column.classList.remove(this.hoverContainerClass)
+
+    const source = this.draggedCard.closest(".cards")
+    if (!source || source === column) return
+
+    const card = this.draggedCard
+    const originalParent = card.parentElement
+    const originalNextSibling = card.nextElementSibling
+    const destination = column.querySelector(".cards__list, turbo-frame")
+
+    if (!destination) return
+
+    const goldenFirst = column.id !== "not-now" && column.id !== "closed-cards"
+    const firstCard = Array.from(destination.querySelectorAll(":scope > .card")).find(existing => {
+      return !goldenFirst || card.classList.contains("golden-effect") || !existing.classList.contains("golden-effect")
+    })
+    destination.insertBefore(card, firstCard || null)
+
+    try {
+      await this.#saveMove(card, column)
+    } catch (error) {
+      if (originalNextSibling?.parentElement === originalParent) {
+        originalParent.insertBefore(card, originalNextSibling)
+      } else {
+        originalParent.append(card)
+      }
+      console.error("Could not move card", error)
+    }
+  }
+
+  #columnFor(element) {
+    return element instanceof Element ? element.closest(".cards") : null
+  }
+
+  async #saveMove(card, column) {
+    const headers = {
+      "Accept": "application/json",
+      "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content
+    }
+    let url
+    let method = "POST"
+
+    if (column.id === "maybe") {
+      url = card.dataset.cardTriageUrl
+      method = "DELETE"
+    } else if (column.id === "not-now") {
+      url = card.dataset.cardNotNowUrl
+    } else if (column.id === "closed-cards") {
+      url = card.dataset.cardClosureUrl
+    } else {
+      url = new URL(card.dataset.cardTriageUrl, window.location.href)
+      url.searchParams.set("column_id", column.dataset.columnId)
+    }
+
+    const response = await fetch(url, { method, headers, credentials: "same-origin" })
+
+    if (!response.ok) throw new Error(`Card move failed: ${response.status}`)
+  }
+
+  #clearDragState() {
+    this.element.querySelectorAll(`.${this.hoverContainerClass}`).forEach(column => {
+      column.classList.remove(this.hoverContainerClass)
+    })
+
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+  }
+}
