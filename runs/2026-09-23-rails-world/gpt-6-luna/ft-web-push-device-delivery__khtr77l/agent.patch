--- /dev/null
+++ b/app/models/notification/push_payload.rb
@@ -0,0 +1,36 @@
+class Notification::PushPayload
+  include NotificationsHelper
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def as_json
+    {
+      title: title,
+      body: body,
+      url: card_url
+    }
+  end
+
+  private
+    attr_reader :notification
+
+    def title
+      notification.card.title.presence || "Card #{notification.card.number}"
+    end
+
+    def body
+      message = if notification.source_type == "Mention"
+        notification.source.source.mentionable_content.truncate(200)
+      else
+        event_notification_body(notification.source)
+      end
+
+      "#{notification.creator.familiar_name}: #{message}"
+    end
+
+    def card_url
+      "#{notification.account.slug}/cards/#{notification.card.id}"
+    end
+end
