--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,29 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.assign_attributes(subscription_params)
+
+    if subscription.save
+      render json: { id: subscription.id }, status: :created
+    else
+      render json: { errors: subscription.errors.full_messages }, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..3ebd1fd
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,123 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["button", "status", "help", "helpMessage"]
+  static values = { publicKey: String, subscriptionUrl: String, serviceWorkerUrl: String }
+
+  async connect() {
+    if (!this.#supported) {
+      const message = this.publicKeyValue ? "Push notifications are not supported by this browser or device." : "Push notifications are not configured for this app yet."
+      this.#showHelp(message)
+      this.buttonTarget.disabled = true
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showHelp("Notifications are blocked by your browser. Allow notifications for this website in your browser settings, then try again.")
+    }
+
+    try {
+      const registration = await this.#registration
+      const subscription = await registration.pushManager.getSubscription()
+      if (subscription) await this.#save(subscription)
+    } catch (_error) {
+      this.#showHelp("Push notifications could not be set up on this device.")
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+
+    try {
+      const registration = await this.#registration
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#remove(subscription)
+        await subscription.unsubscribe()
+        this.#setEnabled(false)
+      } else {
+        const permission = await Notification.requestPermission()
+        if (permission !== "granted") {
+          this.#showHelp("Notifications are blocked by your browser. Allow notifications for this website in your browser settings, then try again.")
+        } else {
+          const subscription = await registration.pushManager.subscribe({
+            userVisibleOnly: true,
+            applicationServerKey: this.#decodeKey(this.publicKeyValue)
+          })
+          await this.#save(subscription)
+          this.#setEnabled(true)
+        }
+      }
+    } catch (_error) {
+      this.#showHelp("Push notifications could not be set up on this device. Check your browser settings and try again.")
+    } finally {
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  get #supported() {
+    return Boolean(this.publicKeyValue && "Notification" in window && "serviceWorker" in navigator && "PushManager" in window)
+  }
+
+  get #registration() {
+    return navigator.serviceWorker.register(this.serviceWorkerUrlValue)
+  }
+
+  async #save(subscription) {
+    const json = subscription.toJSON()
+    const response = await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      credentials: "same-origin",
+      headers: this.#headers,
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      })
+    })
+
+    if (!response.ok) throw new Error("Could not save push subscription")
+    this.subscriptionId = (await response.json()).id
+    this.#setEnabled(true)
+  }
+
+  async #remove(subscription) {
+    if (!this.subscriptionId) await this.#save(subscription)
+
+    const response = await fetch(`${this.subscriptionUrlValue}/${this.subscriptionId}`, {
+      method: "DELETE",
+      credentials: "same-origin",
+      headers: this.#headers
+    })
+
+    if (!response.ok) throw new Error("Could not remove push subscription")
+    this.subscriptionId = null
+  }
+
+  get #headers() {
+    return {
+      "Content-Type": "application/json",
+      "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content
+    }
+  }
+
+  #decodeKey(key) {
+    const padded = key + "=".repeat((4 - key.length % 4) % 4)
+    const raw = atob(padded.replace(/-/g, "+").replace(/_/g, "/"))
+    return Uint8Array.from(raw, character => character.charCodeAt(0))
+  }
+
+  #setEnabled(enabled) {
+    this.statusTarget.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.textContent = enabled ? "Turn off push notifications" : "Turn on push notifications"
+    this.helpTarget.hidden = true
+  }
+
+  #showHelp(message) {
+    this.helpMessageTarget.textContent = message
+    this.helpTarget.hidden = false
+  }
+}
diff --git a/app/jobs/notification/deliver_push_job.rb b/app/jobs/notification/deliver_push_job.rb
new file mode 100644
index 0000000..7ff3202
--- /dev/null
+++ b/app/jobs/notification/deliver_push_job.rb
@@ -0,0 +1,35 @@
+class Notification::DeliverPushJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification)
+    return if notification.read?
+    return unless vapid_configured?
+
+    notification.user.push_subscriptions.find_each do |subscription|
+      deliver(subscription, notification)
+    end
+  end
+
+  private
+    def deliver(subscription, notification)
+      WebPush.payload_send(
+        message: Notification::PushPayload.new(notification).as_json.to_json,
+        endpoint: subscription.endpoint,
+        p256dh: subscription.p256dh_key,
+        auth: subscription.auth_key,
+        vapid: {
+          subject: "mailto:notifications@fizzy.do",
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        }
+      )
+    rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+      subscription.destroy
+    end
+
+    def vapid_configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+end
