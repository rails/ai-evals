@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "creates and returns a push subscription for the current user" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://push.example/subscription/123",
+        p256dh_key: "public-key",
+        auth_key: "auth-key"
+      }
+    }, as: :json
+
+    assert_response :created
+    assert_equal "public-key", @user.push_subscriptions.sole.p256dh_key
+    assert_equal "auth-key", @user.push_subscriptions.sole.auth_key
+    assert_equal "https://push.example/subscription/123", @user.push_subscriptions.sole.endpoint
+    assert @response.parsed_body["id"].present?
+  end
+
+  test "updates an existing subscription for the same endpoint" do
+    endpoint = "https://push.example/subscription/123"
+    attributes = { endpoint: endpoint, p256dh_key: "first-key", auth_key: "first-auth" }
+    @user.push_subscriptions.create!(attributes)
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: attributes.merge(p256dh_key: "rotated-key")
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "rotated-key", @user.push_subscriptions.sole.p256dh_key
+  end
+
+  test "cannot create subscriptions for another user" do
+    other_user = users(:kevin)
+
+    post user_push_subscriptions_path(other_user), params: {
+      push_subscription: { endpoint: "https://push.example/elsewhere", p256dh_key: "key", auth_key: "auth" }
+    }, as: :json
+
+    assert_response :forbidden
+    assert_empty other_user.push_subscriptions
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
