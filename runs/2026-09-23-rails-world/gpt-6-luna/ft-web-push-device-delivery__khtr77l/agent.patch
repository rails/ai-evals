index 0000000..0c0d2fb
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "removes expired subscriptions while delivering pushes" do
+    notification = notifications(:layout_commented_kevin)
+    subscription = notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example/subscription/expired",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    )
+
+    ENV["VAPID_PUBLIC_KEY"] = "public-key"
+    ENV["VAPID_PRIVATE_KEY"] = "private-key"
+    WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(Struct.new(:body).new("gone"), "push.example"))
+
+    Notification::DeliverPushJob.new.perform(notification)
+
+    assert_not PushSubscription.exists?(subscription.id)
+  ensure
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "push payload uses the tray message and opens its card" do
+    notification = notifications(:layout_commented_kevin)
+    payload = Notification::PushPayload.new(notification).as_json
+
+    assert_equal notification.card.title, payload[:title]
+    assert_includes payload[:body], notification.creator.familiar_name
+    assert_includes payload[:url], "/cards/#{notification.card.id}"
+    assert_includes payload[:url], notification.account.slug
+  end
+end
