diff --git a/saas/app/controllers/account/checkouts_controller.rb b/saas/app/controllers/account/checkouts_controller.rb
new file mode 100644
index 0000000..762976e
--- /dev/null
+++ b/saas/app/controllers/account/checkouts_controller.rb
@@ -0,0 +1,47 @@
+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan_key = params[:plan].presence_in(%w[ unlimited unlimited_plus ])
+    if plan_key
+      redirect_to stripe_checkout_session(plan_key).url, allow_other_host: true
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def stripe_checkout_session(plan_key)
+      customer_id = Current.account.account_subscription&.stripe_customer_id
+      attributes = {
+        mode: "subscription",
+        line_items: [ { price_data: price_data_for(plan_key), quantity: 1 } ],
+        success_url: billing_return_url("success"),
+        cancel_url: billing_return_url("cancelled"),
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: plan_key },
+        subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan_key } }
+      }
+      if customer_id.present?
+        attributes[:customer] = customer_id
+      elsif Current.account.owner_email.present?
+        attributes[:customer_email] = Current.account.owner_email
+      end
+
+      Stripe::Checkout::Session.create(attributes)
+    end
+
+    def price_data_for(plan_key)
+      plan = Subscription::PLANS.fetch(plan_key)
+      {
+        currency: "usd",
+        product_data: { name: "Fizzy #{plan.fetch(:name)}" },
+        unit_amount: plan.fetch(:price) * 100,
+        recurring: { interval: "month" }
+      }
+    end
+
+    def billing_return_url(result)
+      "#{request.base_url}#{Current.account.slug}/account/settings?billing=#{result}"
+    end
+end
