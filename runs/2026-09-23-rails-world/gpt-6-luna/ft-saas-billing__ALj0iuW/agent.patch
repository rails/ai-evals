+require "test_helper"
+
+class Account::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  test "admin checkout creates a Stripe subscription session at the selected approved price" do
+    sign_in_as :kevin
+    checkout_url = "https://checkout.stripe.test/session"
+    Stripe::Checkout::Session.stubs(:create).with do |attributes|
+      price = attributes[:line_items].first[:price_data]
+      attributes[:mode] == "subscription" &&
+        price[:unit_amount] == 2_500 && price[:currency] == "usd" &&
+        price[:recurring][:interval] == "month" &&
+        price[:product_data][:name] == "Fizzy Unlimited+" &&
+        attributes[:metadata][:account_id] == Current.account.id &&
+        attributes[:metadata][:plan_key] == "unlimited_plus"
+    end.returns(Struct.new(:url).new(checkout_url))
+
+    post saas.account_checkout_path, params: { plan: "unlimited_plus" }
+
+    assert_redirected_to checkout_url
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..fd1e5af
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "staff can browse accounts and set/reset usage overrides and comp status" do
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(account)}']", text: account.name
+
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "input[name='account[card_count]']"
+      assert_select "input[name='account[bytes_used]']"
+
+      post saas.admin_account_compensation_path(account)
+      assert account.reload.comped?
+      delete saas.admin_account_compensation_path(account)
+      assert_not account.reload.comped?
+
+      patch saas.admin_account_override_path(account), params: { account: { card_count: "777", bytes_used: "98765" } }
+      assert_equal 777, account.reload.cards_used
+      assert_equal 98_765, account.bytes_used_for_billing
+
+      delete saas.admin_account_override_path(account)
+      assert_nil account.reload.overridden_limit
+    end
+  end
+
+  test "non-staff cannot access account support tools" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/card/storage_limited/card_limit_test.rb b/saas/test/controllers/card/storage_limited/card_limit_test.rb
new file mode 100644
index 0000000..f917a28
--- /dev/null
+++ b/saas/test/controllers/card/storage_limited/card_limit_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Card::StorageLimited::CardLimitTest < ActionDispatch::IntegrationTest
+  test "free account cannot create a published card through the API at its limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "No more published cards" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "free account can still draft but cannot publish after reaching the limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    assert_response :redirect
+    draft = Card.order(created_at: :desc).first
+    assert draft.drafted?
+
+    post card_publish_path(draft, script_name: accounts(:initech).slug)
+    assert_response :forbidden
+  end
+
+test "draft warning counts down the final hundred free cards" do
+  sign_in_as :mike
+  accounts(:initech).update_column(:cards_count, 950)
+
+  get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+  assert_response :success
+  assert_select "strong", text: "50 cards left"
+end
+
+test "card creation buttons become an upgrade pitch at the free limit" do
+  sign_in_as :mike
+  accounts(:initech).update_column(:cards_count, 1_000)
+
+  get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+  assert_response :success
+  assert_select ".card-perma__notch-new-card-buttons", count: 0
+  assert_select "a", text: "Upgrade"
+end
+
+  test "paid subscription removes the card limit" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+    accounts(:initech).create_account_subscription!(
+      plan_key: "unlimited", stripe_customer_id: "cus_paid_test", status: "active"
+    )
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Paid card" } }, as: :json
+    end
+    assert_response :created
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
new file mode 100644
index 0000000..26be6fd
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  EventData = Struct.new(:object)
+  Event = Struct.new(:type, :data)
+  Price = Struct.new(:id, :unit_amount, :currency, :recurring)
+  Items = Struct.new(:data)
+  SubscriptionPayload = Struct.new(:id, :customer, :status, :metadata, :items, :current_period_end, :cancel_at)
+
+  test "subscription webhook assigns the matching paid plan" do
+    account = accounts(:initech)
+    price = Price.new("price_plus", 2_500, "usd", Struct.new(:interval).new("month"))
+    subscription = SubscriptionPayload.new(
+      "sub_test", "cus_webhook_test", "active", { account_id: account.id, plan_key: "unlimited" },
+      Items.new([ Struct.new(:price).new(price) ]), nil, nil
+    )
+    event = Event.new("customer.subscription.created", EventData.new(subscription))
+
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+    with_env("STRIPE_WEBHOOK_SECRET" => "whsec_test") do
+      post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "test" }
+    end
+
+    assert_response :success
+    assert_equal "unlimited_plus", account.reload.plan_key
+    assert_equal "cus_webhook_test", account.account_subscription.stripe_customer_id
+  end
+
+  private
+    def with_env(values)
+      previous = values.keys.to_h { |key| [ key, ENV[key] ] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..5ee8289
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan has 1000 cards and 1 GB of storage" do
+    assert_equal "free", @account.plan_key
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid plans are unlimited in cards and include their storage allowance" do
+    @account.create_account_subscription!(
+      plan_key: "unlimited_plus", stripe_customer_id: "cus_test", status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "usage overrides affect card and byte usage and can be reset" do
+    @account.create_overridden_limit!(card_count: 999, bytes_used: 1234)
+
+    assert_equal 999, @account.cards_used
+    assert_equal 1234, @account.bytes_used_for_billing
+
+    @account.overridden_limit.destroy!
+    @account.reload
+    assert_equal @account.cards_count, @account.cards_used
+  end
+
+  test "comp bypasses card and storage limits" do
+    @account.update_column(:cards_count, 1_000)
+    @account.create_billing_waiver!
+
+    assert @account.comped?
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "free plan warns for the final 100 cards and blocks at the limit" do
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.card_limit - @account.cards_used
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.exceeding_card_limit?
+  end
+end
