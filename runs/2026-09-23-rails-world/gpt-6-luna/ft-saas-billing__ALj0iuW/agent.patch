@@ -0,0 +1,25 @@
+class Admin::Accounts::OverridesController < AdminController
+  before_action :set_account
+
+  def update
+    attributes = params.expect(account: [ :card_count, :bytes_used ]).to_h.transform_values { |value| value.presence }
+    if attributes.values.all?(&:nil?)
+      @account.overridden_limit&.destroy!
+    elsif @account.overridden_limit
+      @account.overridden_limit.update!(attributes)
+    else
+      @account.create_overridden_limit!(attributes)
+    end
+    redirect_to saas.admin_account_path(@account), notice: "Usage override updated"
+  end
+
+  def destroy
+    @account.overridden_limit&.destroy!
+    redirect_to saas.admin_account_path(@account), notice: "Usage override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+end
