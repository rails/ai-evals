diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..010c5bf
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,84 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.body.read, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    process_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError, KeyError, ArgumentError
+    head :bad_request
+  end
+
+  private
+    def process_event(event)
+      object = event.data.object
+      case event.type
+      when "checkout.session.completed"
+        complete_checkout(object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        update_subscription(object)
+      end
+    end
+
+    def complete_checkout(session)
+      account_id = metadata_value(session.metadata, :account_id) || session.client_reference_id
+      account = Account.find_by(id: account_id)
+      return unless account && session.customer
+
+      plan_key = metadata_value(session.metadata, :plan_key) || "unlimited"
+      attributes = {
+        stripe_customer_id: session.customer,
+        stripe_subscription_id: session.subscription,
+        plan_key: plan_key,
+        status: session.payment_status == "paid" ? "active" : "incomplete"
+      }
+      account.account_subscription ? account.account_subscription.update!(attributes) : account.create_account_subscription!(attributes)
+    end
+
+    def update_subscription(subscription)
+      account_subscription = AccountSubscription.find_by(stripe_customer_id: subscription.customer) ||
+        AccountSubscription.find_by(stripe_subscription_id: subscription.id)
+      account_id = metadata_value(subscription.metadata, :account_id)
+      account = account_subscription&.account || Account.find_by(id: account_id)
+      return unless account
+
+      price = subscription.items.data.first&.price
+      plan_key = plan_key_for(price&.id) || plan_key_for_amount(price) || metadata_value(subscription.metadata, :plan_key) || account_subscription&.plan_key || "unlimited"
+      attributes = {
+        stripe_customer_id: subscription.customer,
+        stripe_subscription_id: subscription.id,
+        plan_key: plan_key,
+        status: subscription.status,
+        current_period_end: subscription.current_period_end && Time.at(subscription.current_period_end),
+        cancel_at: subscription.cancel_at && Time.at(subscription.cancel_at)
+      }
+      account_subscription ? account_subscription.update!(attributes) : account.create_account_subscription!(attributes)
+    end
+
+    def metadata_value(metadata, key)
+      if metadata.respond_to?(key)
+        metadata.public_send(key)
+      elsif metadata.respond_to?(:[])
+        metadata[key.to_s] || metadata[key]
+      end
+    end
+
+    def plan_key_for_amount(price)
+      return unless price&.currency == "usd" && price.recurring&.interval == "month"
+
+      case price.unit_amount
+      when 2_000 then "unlimited"
+      when 2_500 then "unlimited_plus"
+      end
+    end
+
+    def plan_key_for(price_id)
+      return if price_id.blank?
+
+      if price_id == ENV["STRIPE_UNLIMITED_PRICE_ID"] || price_id == ENV["STRIPE_PRICE_UNLIMITED"]
+        "unlimited"
+      elsif price_id == ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] || price_id == ENV["STRIPE_PRICE_UNLIMITED_PLUS"]
+        "unlimited_plus"
+      end
+    end
+end
