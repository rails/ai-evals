diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..a9c9309
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,38 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :with_current_locale
+    prepend_before_action :remember_locale_choice
+    before_action :restore_identity_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_current_locale(&block)
+      I18n.with_locale(supported_locale(session[:locale]) || I18n.default_locale, &block)
+    end
+
+    def remember_locale_choice
+      if choice = supported_locale(params[:locale])
+        session[:locale] = choice.to_s
+        session[:locale_changed] = true
+      end
+    end
+
+    def restore_identity_locale
+      if Current.identity
+        if session.delete(:locale_changed) && supported_locale(session[:locale])
+          Current.identity.update!(locale: session[:locale]) if Current.identity.locale != session[:locale]
+        elsif supported_locale(Current.identity.locale)
+          session[:locale] = Current.identity.locale
+        end
+      end
+
+      I18n.locale = supported_locale(session[:locale]) || I18n.default_locale
+    end
+
+    def supported_locale(value)
+      value.to_sym if value.is_a?(String) && I18n.available_locales.include?(value.to_sym)
+    end
+end
