diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..c3515d9
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "unsupported locale on a fresh browser remains English" do
+    untenanted { get new_session_path, params: { locale: "xx" } }
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "saved locale returns in a clean browser after sign in" do
+    identities(:kevin).update!(locale: "ja")
+    reset!
+    sign_in_as :kevin
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "choosing Japanese on a protected page survives redirect to sign in" do
+    get root_path, params: { locale: "ja" }
+    assert_response :redirect
+    untenanted { get new_session_path }
+    assert_select "html[lang=ja]"
+  end
+
+  test "Japanese board form translates input hints and validation" do
+    sign_in_as :kevin
+    get new_board_path, params: { locale: "ja" }
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "input[placeholder=名前を入力…]"
+    assert_select "button", text: "ボードを作成"
+  end
+
+  test "a choice before sign in is saved on the identity" do
+    untenanted { get new_session_path, params: { locale: "ja" } }
+    assert_select "html[lang=ja]"
+    sign_in_as :kevin
+    get root_path
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    reset!
+    sign_in_as :kevin
+    get root_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "main menu labels render in Japanese" do
+    sign_in_as :kevin
+    get my_menu_path, params: { locale: "ja" }
+    assert_response :success
+    assert_includes response.body, "アカウント設定"
+    assert_includes response.body, "メンバー"
+  end
+
+  test "switches locale, ignores unsupported locales and persists on identity" do
+    sign_in_as :kevin
+    get root_path, params: { locale: "ja" }
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get root_path, params: { locale: "xx" }
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+end
diff --git a/test/mailers/magic_link_mailer_test.rb b/test/mailers/magic_link_mailer_test.rb
index 2c8d692..2f72ce3 100644
--- a/test/mailers/magic_link_mailer_test.rb
+++ b/test/mailers/magic_link_mailer_test.rb
@@ -14,3 +14,17 @@ class MagicLinkMailerTest < ActionMailer::TestCase
     assert_match magic_link.code, email.body.encoded
   end
 end
+
+class JapaneseMagicLinkMailerTest < ActionMailer::TestCase
+  test "renders Japanese for a recipient who selected Japanese" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_includes email.subject, "認証コード"
+    assert_includes email.html_part.body.decoded, "認証コード"
+    assert_includes email.text_part.body.decoded, "認証コード"
+    assert_equal :en, I18n.locale
+  end
+end
diff --git a/test/mailers/notification/bundle_mailer_test.rb b/test/mailers/notification/bundle_mailer_test.rb
index d37ecae..2d5a5eb 100644
--- a/test/mailers/notification/bundle_mailer_test.rb
+++ b/test/mailers/notification/bundle_mailer_test.rb
@@ -124,3 +124,19 @@ class Notification::BundleMailerTest < ActionMailer::TestCase
       Notification.create!(user: user, creator: user, source: source, created_at: 30.minutes.ago)
     end
 end
+
+class JapaneseNotificationMailerTest < ActionMailer::TestCase
+  test "notification uses the recipient locale for date and event" do
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+    assert_includes email.subject, "新しい通知"
+    assert_includes email.html_part.body.decoded, "年"
+    assert_includes email.html_part.body.decoded, "が追加しました"
+    assert_includes email.text_part.body.decoded, "新しい通知"
+  end
+end
