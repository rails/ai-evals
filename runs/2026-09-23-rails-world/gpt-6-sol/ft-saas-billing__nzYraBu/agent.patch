@@ -0,0 +1,38 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+    @account = Account.find(params[:id])
+  end
+
+  def comp
+    account.comped = true
+    redirect_to saas.admin_account_path(account)
+  end
+
+  def uncomp
+    account.comped = false
+    redirect_to saas.admin_account_path(account)
+  end
+
+  def override
+    values = params.expect(billing_override: [ :card_count, :bytes_used ])
+    account.create_billing_override! unless account.billing_override
+    account.billing_override.update!(values)
+    redirect_to saas.admin_account_path(account)
+  end
+
+  def reset
+    account.billing_override&.destroy!
+    redirect_to saas.admin_account_path(account)
+  end
+
+  private
+    def account
+      @account ||= Account.find(params[:id])
+    end
+end
