diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..66ac0c9
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,46 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+
+    StripeWebhookEvent.transaction do
+      unless StripeWebhookEvent.exists?(stripe_id: event.id)
+        apply_event(event)
+        StripeWebhookEvent.create!(stripe_id: event.id)
+      end
+    end
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def apply_event(event)
+      object = event.data.object
+      case event.type
+      when "checkout.session.completed"
+        if object.mode == "subscription"
+          if account = Account.find_by(id: object.client_reference_id)
+            subscription = BillingSubscription.find_or_initialize_by(account_id: account.id)
+            subscription.update!(stripe_customer_id: object.customer, stripe_subscription_id: object.subscription)
+          end
+        end
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        subscription = BillingSubscription.find_by(stripe_subscription_id: object.id) || BillingSubscription.find_by(stripe_customer_id: object.customer) || (Account.exists?(id: object.metadata&.account_id) && BillingSubscription.find_or_initialize_by(account_id: object.metadata.account_id))
+        if subscription
+          price_ids = object.items&.data&.map { |item| item.price&.id } || []
+          plan = if event.type == "customer.subscription.deleted" || !%w[ active trialing ].include?(object.status)
+            "free"
+          else
+            if price_ids.include?(ENV["STRIPE_MONTHLY_V1_PRICE_ID"])
+              price_ids.include?(ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]) ? "unlimited_plus" : "unlimited"
+            else
+              "free"
+            end
+          end
+          subscription.update!(plan: plan, stripe_customer_id: object.customer, stripe_subscription_id: object.id)
+        end
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..e972736
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,44 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :billing_subscription, class_name: "BillingSubscription"
+    has_one :billing_override, class_name: "BillingOverride"
+  end
+
+  def billing_plan
+    billing_subscription&.plan || "free"
+  end
+
+  def card_limit
+    BillingSubscription::PLANS.fetch(billing_plan).fetch(:cards) unless comped?
+  end
+
+  def cards_used
+    billing_override&.card_count || cards_count
+  end
+
+  def cards_left
+    [ card_limit - cards_used, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    cards_left && cards_left.positive? && cards_left <= 100
+  end
+
+  def billed_bytes_used
+    billing_override&.bytes_used || bytes_used
+  end
+
+  def comped?
+    billing_subscription&.comped? || false
+  end
+
+  def comped=(value)
+    (billing_subscription || build_billing_subscription).update!(comped: ActiveModel::Type::Boolean.new.cast(value))
+  end
+end
