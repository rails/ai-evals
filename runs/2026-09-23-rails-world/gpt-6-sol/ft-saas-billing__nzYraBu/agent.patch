@@ -0,0 +1,24 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  test "free cards warn at 100 left and stop at the limit" do
+    account = accounts(:initech)
+    account.stubs(:cards_count).returns(900)
+    assert_equal 100, account.cards_left
+    assert account.nearing_card_limit?
+    account.stubs(:cards_count).returns(950)
+    assert_equal 50, account.cards_left
+    assert account.nearing_card_limit?
+    account.stubs(:cards_count).returns(1000)
+    assert account.exceeding_card_limit?
+  end
+
+  test "paid plans have unlimited cards and their own storage allowances" do
+    account = accounts(:initech)
+    (account.billing_subscription || account.build_billing_subscription).update!(plan: "unlimited")
+    assert_nil account.card_limit
+    assert_equal 5.gigabytes, account.storage_limit
+    account.billing_subscription.update!(plan: "unlimited_plus")
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+end
