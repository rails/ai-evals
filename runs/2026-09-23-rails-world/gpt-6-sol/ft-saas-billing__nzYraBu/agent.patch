+require "test_helper"
+
+class AccountBillingTest < ActionDispatch::IntegrationTest
+  test "admin can open hosted checkout" do
+    sign_in_as :jason
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_test"
+    Stripe::Checkout::Session.expects(:create).with(has_entries(mode: "subscription", line_items: [ { price: "price_test", quantity: 1 } ])).returns(Struct.new(:url).new("https://checkout.stripe.com/test"))
+    post saas.account_billing_checkout_path, params: { plan: "unlimited" }
+    assert_redirected_to "https://checkout.stripe.com/test"
+  ensure
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+  end
+
+  test "paid accounts manage their plan in the portal instead of creating another subscription" do
+    sign_in_as :jason
+    accounts(:"37s").create_billing_subscription!(plan: "unlimited", stripe_customer_id: "cus_test")
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_base"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+    Stripe::Checkout::Session.expects(:create).never
+    post saas.account_billing_checkout_path, params: { plan: "unlimited_plus" }
+    assert_redirected_to saas.account_billing_portal_path
+  ensure
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "Unlimited+ checks out with both monthly prices" do
+    sign_in_as :jason
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_base"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_extra"
+    Stripe::Checkout::Session.expects(:create).with(has_entry(:line_items, [ { price: "price_base", quantity: 1 }, { price: "price_extra", quantity: 1 } ])).returns(Struct.new(:url).new("https://checkout.stripe.com/plus"))
+    post saas.account_billing_checkout_path, params: { plan: "unlimited_plus" }
+    assert_redirected_to "https://checkout.stripe.com/plus"
+  ensure
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "unknown plan cannot open checkout" do
+    sign_in_as :jason
+    post saas.account_billing_checkout_path, params: { plan: "invalid" }
+    assert_response :unprocessable_entity
+  end
+
+  test "webhook rejects unsigned payload" do
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+      assert_response :bad_request
+    end
+  ensure
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+  end
+end
+
+class AccountBillingSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see plan and upgrade in settings" do
+    sign_in_as :jason
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: /Plan: Free/
+    assert_select "p", text: "Upgrade"
+  end
+
+  test "members do not see billing actions" do
+    sign_in_as :jz
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: /Plan:/, count: 0
+  end
+end
