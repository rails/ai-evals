diff --git a/saas/app/controllers/account/billing/checkouts_controller.rb b/saas/app/controllers/account/billing/checkouts_controller.rb
new file mode 100644
index 0000000..00fc1a8
--- /dev/null
+++ b/saas/app/controllers/account/billing/checkouts_controller.rb
@@ -0,0 +1,28 @@
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    prices = case params[:plan]
+    when "unlimited" then [ ENV["STRIPE_MONTHLY_V1_PRICE_ID"] ]
+    when "unlimited_plus" then [ ENV["STRIPE_MONTHLY_V1_PRICE_ID"], ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ]
+    end
+
+    if prices.blank? || prices.any?(&:blank?)
+      head :unprocessable_entity
+    else
+      account = Current.account
+      if account.billing_plan != "free" && account.billing_subscription&.stripe_customer_id.present?
+        redirect_to saas.account_billing_portal_path, status: :see_other
+      else
+        options = {
+          mode: "subscription", line_items: prices.map { |price| { price: price, quantity: 1 } },
+          client_reference_id: account.id, subscription_data: { metadata: { account_id: account.id } },
+          success_url: account_settings_url, cancel_url: account_settings_url
+        }
+        options[:customer] = account.billing_subscription.stripe_customer_id if account.billing_subscription&.stripe_customer_id.present?
+        session = Stripe::Checkout::Session.create(**options)
+        redirect_to session.url, allow_other_host: true
+      end
+    end
+  end
+end
