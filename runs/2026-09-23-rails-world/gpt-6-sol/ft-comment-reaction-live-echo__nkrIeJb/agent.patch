diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..11b7507
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,33 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+    if @reaction.save
+      render turbo_stream: turbo_stream.replace([ @comment, :reactions ], partial: "cards/reactions/strip", locals: { comment: @comment })
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    reaction = @comment.reactions.find(params[:id])
+    if reaction.creator == Current.user
+      reaction.destroy!
+      render turbo_stream: turbo_stream.remove(reaction)
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..accd64f
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  show() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  toggleRemove(event) {
+    if (event.target.closest("form") || getComputedStyle(this.element.querySelector(".reaction__menu-btn")).display === "none") return
+
+    const expanded = this.element.classList.toggle("expanded")
+    this.element.querySelector(".reaction__menu-btn").setAttribute("aria-expanded", expanded)
+  }
+}
