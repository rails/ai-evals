new file mode 100644
index 0000000..8ebd157
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,32 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def index
+    render json: { subscribed: Current.user.push_subscriptions.exists?(endpoint_digest: Digest::SHA256.hexdigest(params.require(:endpoint))) }
+  end
+
+  def create
+    subscription = Current.user.push_subscriptions.find_or_initialize_by(endpoint_digest: Digest::SHA256.hexdigest(subscription_params[:endpoint].to_s))
+    subscription.assign_attributes(subscription_params)
+
+    if subscription.save
+      head :created
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find_by!(endpoint: params.require(:endpoint)).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless Current.user.id == params[:user_id]
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b4d51e8
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,78 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "toggle", "status", "message", "details" ]
+  static values = { url: String, key: String }
+
+  async connect() {
+    if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
+      this.showError("Push notifications aren't supported on this browser.")
+      return
+    }
+
+    try {
+      this.registration = await navigator.serviceWorker.ready
+      await this.refresh()
+    } catch (_) {
+      this.showError("Push notifications aren't available on this device.")
+    }
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+    try {
+      if (this.enabled) {
+        const response = await destroy(this.urlValue, { body: JSON.stringify({ endpoint: this.subscription.endpoint }), contentType: "application/json" })
+        if (!response.ok) throw new Error("Unable to remove this device")
+      } else {
+        if (Notification.permission !== "granted" && await Notification.requestPermission() !== "granted") {
+          this.showError("Notifications are blocked for this site.", Notification.permission === "denied")
+          return
+        }
+        const subscription = this.subscription || await this.registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.decodeKey(this.keyValue) })
+        const response = await post(this.urlValue, { body: JSON.stringify({ push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: subscription.toJSON().keys.p256dh,
+          auth_key: subscription.toJSON().keys.auth
+        } }), contentType: "application/json" })
+        if (!response.ok) throw new Error("Unable to save this device")
+      }
+      await this.refresh()
+    } catch (_) {
+      this.showError("Couldn't update notifications. Please try again.", false)
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async refresh() {
+    this.subscription = await this.registration.pushManager.getSubscription()
+    if (this.subscription) {
+      const response = await get(this.urlValue, { query: { endpoint: this.subscription.endpoint }, responseKind: "json" })
+      if (!response.ok) throw new Error("Unable to check this device")
+      this.enabled = (await response.json).subscribed
+    } else {
+      this.enabled = false
+    }
+    this.toggleTarget.textContent = this.enabled ? "Turn off notifications on this device" : "Turn on notifications on this device"
+    this.toggleTarget.hidden = false
+    this.statusTarget.hidden = true
+    if (Notification.permission === "denied") {
+      this.showError("Notifications are blocked for this site.")
+    }
+  }
+
+  showError(message, blocked = true) {
+    this.messageTarget.textContent = message
+    this.statusTarget.hidden = false
+    this.detailsTarget.hidden = !("Notification" in window) || Notification.permission !== "denied"
+    this.toggleTarget.hidden = blocked && !this.enabled
+  }
+
+  decodeKey(key) {
+    const padding = "=".repeat((4 - key.length % 4) % 4)
+    const binary = atob((key + padding).replace(/-/g, "+").replace(/_/g, "/"))
+    return Uint8Array.from(binary, character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
index 0000000..a0db419
--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,43 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification)
+    return unless ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+
+    notification.user.push_subscriptions.find_each do |subscription|
+      deliver(notification, subscription)
+    end
+  end
+
+  private
+    def deliver(notification, subscription)
+      WebPush.payload_send(
+        message: payload(notification).to_json,
+        endpoint: subscription.endpoint,
+        p256dh: subscription.p256dh_key,
+        auth: subscription.auth_key,
+        vapid: { public_key: ENV.fetch("VAPID_PUBLIC_KEY"), private_key: ENV.fetch("VAPID_PRIVATE_KEY") }
+      )
+    rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+      subscription.destroy!
+    end
+
+    def payload(notification)
+      copy = notification_copy(notification)
+      {
+        title: copy[:title], body: copy[:body],
+        url: Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug)
+      }
+    end
+
+    def notification_copy(notification)
+      helper = ApplicationController.helpers
+      if notification.source.is_a?(Mention)
+        mention = notification.source
+        { title: "#{mention.mentioner.first_name} @mentioned you", body: mention.source.mentionable_content.truncate(200) }
+      else
+        event = notification.source
+        { title: helper.event_notification_title(event), body: helper.event_notification_body(event) }
+      end
+    end
+end
