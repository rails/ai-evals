diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..8babdca
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.user = users(:david)
+  end
+
+  test "searches titles descriptions and comments once per card newest first" do
+    title = cards(:logo)
+    description = cards(:layout)
+    comment = cards(:shipping)
+    title.update!(title: "Meteor title")
+    description.update!(description: "A meteor in the description")
+    comment.comments.create!(body: "Meteor in a comment, meteor again", creator: users(:david))
+    comment.comments.create!(body: "Another meteor", creator: users(:david))
+    title.update_columns(created_at: 3.days.ago)
+    description.update_columns(created_at: 2.days.ago)
+    comment.update_columns(created_at: 1.day.ago)
+
+    get search_path, params: { q: "meteor" }
+
+    assert_response :success
+    assert_equal [ comment, description, title ].map(&:title), css_select(".search-result__title").map(&:text)
+    assert_select "mark", minimum: 3
+    assert_select "a[href=?]", card_path(comment)
+  end
+
+  test "never includes inaccessible boards or drafts even through comments" do
+    private_card = boards(:private).cards.create!(title: "Secret meteor", status: :published, creator: users(:kevin))
+    draft = boards(:writebook).cards.create!(title: "Draft meteor", status: :drafted, creator: users(:david))
+    private_card.comments.create!(body: "Hidden comet", creator: users(:kevin))
+    draft_comment = draft.comments.new(creator: users(:david), account: draft.account)
+    draft_comment.save!(validate: false)
+    ActionText::RichText.create!(record: draft_comment, name: "body", body: "Draft comet", account: draft.account)
+    cards(:logo).update!(title: "Visible meteor")
+
+    get search_path, params: { q: "meteor" }
+    assert_select ".search-result__title", text: /Visible meteor/
+    assert_select ".search-result__title", text: /Secret meteor|Draft meteor/, count: 0
+
+    boards(:private).accesses.create!(user: users(:david))
+    get search_path, params: { q: "comet" }
+    assert_select ".search-result__title", text: /Secret meteor/
+    boards(:private).accesses.find_by!(user: users(:david)).destroy!
+
+    get search_path, params: { q: "comet" }
+    assert_select ".search-result", count: 0
+
+    boards(:writebook).accesses.find_by!(user: users(:david)).destroy!
+    get search_path, params: { q: "meteor" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "escapes html and literal wildcard characters in search and highlights" do
+    cards(:logo).update!(title: "100% <script>alert(1)</script> meteor")
+    get search_path, params: { q: "%" }
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title mark", text: "%"
+    assert_select ".search-result__title script", count: 0
+    assert_select ".search-result__title", text: /<script>alert/
+    get search_path, params: { q: " " }
+    assert_select ".search-result", count: 0
+  end
+
+  test "requires authentication" do
+    sign_out
+    Current.clear_all
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+  end
+end
