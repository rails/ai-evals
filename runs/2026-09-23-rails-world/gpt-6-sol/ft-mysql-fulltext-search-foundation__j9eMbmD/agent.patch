+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,10 @@
+module SearchHelper
+  def highlight_search_text(text, query)
+    plain_text = text.to_s
+    return plain_text if query.blank?
+
+    safe_join(plain_text.split(/(#{Regexp.escape(query)})/i).map do |part|
+      part.casecmp?(query) ? tag.mark(part) : part
+    end)
+  end
+end
diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..7f98f4b
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,31 @@
+class Card::Search
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def cards
+    return Card.none if query.blank?
+
+    pattern = "%#{ActiveRecord::Base.sanitize_sql_like(query, '!')}%"
+    @user.accessible_cards.published.where(
+      <<~SQL, pattern: pattern
+        cards.title LIKE :pattern ESCAPE '!' OR
+        EXISTS (
+          SELECT 1 FROM action_text_rich_texts descriptions
+          WHERE descriptions.record_type = 'Card' AND descriptions.record_id = cards.id
+            AND descriptions.name = 'description' AND descriptions.body LIKE :pattern ESCAPE '!'
+        ) OR
+        EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts bodies
+            ON bodies.record_type = 'Comment' AND bodies.record_id = comments.id AND bodies.name = 'body'
+          WHERE comments.card_id = cards.id AND bodies.body LIKE :pattern ESCAPE '!'
+        )
+      SQL
+    ).distinct.reverse_chronologically
+  end
+
+  private
+    attr_reader :query
+end
