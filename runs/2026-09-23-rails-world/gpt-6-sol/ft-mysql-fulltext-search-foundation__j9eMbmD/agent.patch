diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..7480900
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Search cards</h1>
+<% end %>
+
+<div class="panel margin-inline-auto padding">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards", aria: { label: "Search cards" }, autofocus: true %>
+    <%= form.submit "Search" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div class="search-results">
+        <% @cards.each do |card| %>
+          <article class="search-result">
+            <h2><%= link_to card_path(card), class: "search-result__title" do %><%= highlight_search_text(card.title, @query) %><% end %></h2>
+            <p><%= card.board.name %></p>
+            <% if card.description.present? && strip_tags(card.description.body.to_s).downcase.include?(@query.downcase) %>
+              <p><%= highlight_search_text(strip_tags(card.description.body.to_s), @query) %></p>
+            <% end %>
+            <% card.comments.each do |comment| %>
+              <% if comment.body.present? && strip_tags(comment.body.body.to_s).downcase.include?(@query.downcase) %>
+                <p><%= highlight_search_text(strip_tags(comment.body.body.to_s), @query) %></p>
+              <% end %>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate">No cards found</p>
+    <% end %>
+  <% end %>
+</div>
