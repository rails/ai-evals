diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..b78941a
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "assignment and reopening produce a burst, but unassignment does not" do
+    @card.toggle_assignment(users(:kevin))
+    assert @card.reload.burst_at
+
+    @card.update_columns(last_active_at: 15.days.ago)
+    assert @card.reload.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.toggle_assignment(users(:kevin))
+    assert_not @card.reload.stalled?
+    assert @card.burst_at
+
+    @card.close
+    @card.reopen
+    assert_in_delta Time.current, @card.reload.burst_at, 5.seconds
+  end
+
+  test "three comments by two people within a third of the auto-close period produce a burst" do
+    @card.comments.create!(creator: users(:david), body: "One")
+    @card.comments.create!(creator: users(:david), body: "Two")
+    assert_nil @card.reload.burst_at
+    @card.comments.create!(creator: users(:kevin), body: "Three")
+    assert @card.reload.burst_at
+
+    @card.update_columns(last_active_at: 14.days.ago - 1.second)
+    assert @card.reload.stalled?
+    @card.comments.create!(creator: users(:david), body: "Four")
+    assert_not @card.reload.stalled?
+  end
+  test "comments outside the window or by just one person do not count" do
+    start = 15.days.ago
+    @card.comments.create!(creator: users(:david), body: "Early", created_at: start)
+    @card.comments.create!(creator: users(:david), body: "Middle", created_at: start + 1.minute)
+    @card.comments.create!(creator: users(:david), body: "Late", created_at: start + 2.minutes)
+    assert_nil @card.reload.burst_at
+
+    @card.comments.create!(creator: users(:kevin), body: "Too late", created_at: start + @card.auto_postpone_period / 3.0 + 3.minutes)
+    assert_nil @card.reload.burst_at
+  end
+
+  test "an earlier second participant in the window still counts after three comments by one person" do
+    @card.comments.create!(creator: users(:kevin), body: "First")
+    3.times { |i| @card.comments.create!(creator: users(:david), body: "Comment #{i}") }
+    assert @card.reload.burst_at
+  end
+end
