+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,35 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      render turbo_stream: turbo_stream.append([ @comment, :reactions_list ], partial: "cards/reactions/reaction", locals: { reaction: @reaction })
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    reaction = @comment.reactions.find(params[:id])
+
+    if reaction.creator == Current.user
+      reaction.destroy!
+      render turbo_stream: turbo_stream.remove(reaction)
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e7e21fc
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,60 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+  static values = { userId: String }
+
+  connect() {
+    this.markOwnReactions()
+    this.observer = new MutationObserver(() => this.markOwnReactions())
+    this.observer.observe(this.element, { childList: true, subtree: true })
+  }
+
+  disconnect() {
+    this.observer.disconnect()
+  }
+
+  markOwnReactions() {
+    this.element.querySelectorAll(".reaction[data-creator-id]").forEach(reaction => {
+      if (reaction.dataset.creatorId === this.userIdValue) {
+        reaction.classList.add("reaction--deleteable")
+        reaction.tabIndex = 0
+        reaction.setAttribute("role", "button")
+        reaction.setAttribute("aria-label", `Your reaction: ${reaction.querySelector(".txt-medium").textContent}. Click to remove`)
+      }
+    })
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded", "reaction")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded", "reaction")
+    this.triggerTarget.hidden = false
+    this.inputTarget.value = ""
+    this.triggerTarget.focus()
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  toggleOwnReaction(event) {
+    const reaction = event.target.closest(".reaction[data-creator-id]")
+    if (reaction && reaction.dataset.creatorId === this.userIdValue && !event.target.closest("button, form")) {
+      if (event.type === "click" || event.target === reaction) {
+        if (event.type === "keydown") event.preventDefault()
+        reaction.classList.toggle("expanded")
+      }
+    }
+  }
+
+  stopPropagation(event) {
+    event.stopPropagation()
+  }
+}
