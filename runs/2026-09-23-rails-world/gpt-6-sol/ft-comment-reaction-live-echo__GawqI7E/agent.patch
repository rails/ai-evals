diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..c317ffb
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "comment renders an empty reaction strip and existing reactions" do
+    get card_comment_path(@comment.card, @comment)
+    assert_response :success
+    assert_select ".reactions__list .reaction", count: 0
+    assert_select ".reactions__trigger"
+    assert_select "input[maxlength=16]"
+
+    @comment.reactions.create!(content: "Nice", creator: users(:jz))
+    get card_comment_path(@comment.card, @comment)
+    assert_select ".reactions__list .reaction", text: /Nice/
+    assert_select ".reaction__avatar"
+  end
+
+  test "post and remove a reaction" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+    assert_response :success
+    assert_includes response.body, "👍"
+    assert_includes response.body, "reactions_list"
+
+    reaction = @comment.reactions.last
+    assert_broadcasts @comment.card.to_gid_param, 1 do
+      assert_difference -> { @comment.reactions.count }, -1 do
+        delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+      end
+    end
+    assert_response :success
+  end
+
+  test "creation broadcasts to card viewers" do
+    assert_broadcasts @comment.card.to_gid_param, 1 do
+      perform_enqueued_jobs do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "Live" } }, as: :turbo_stream
+      end
+    end
+  end
+
+  test "reaction content must be present and at most 16 characters" do
+    [ "", " ", "a" * 17 ].each do |content|
+      assert_no_difference -> { @comment.reactions.count } do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "cannot remove a reaction through a different comment" do
+    reaction = @comment.reactions.create!(content: "Hi", creator: users(:kevin))
+    other_comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(other_comment.card, other_comment, reaction), as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "cannot remove another user's reaction" do
+    reaction = @comment.reactions.create!(content: "Hi", creator: users(:jz))
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :forbidden
+  end
+end
