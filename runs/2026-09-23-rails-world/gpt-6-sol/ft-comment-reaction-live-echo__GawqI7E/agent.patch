new file mode 100644
index 0000000..003e850
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :content_is_not_blank
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal
+
+  private
+    def content_is_not_blank
+      errors.add(:content, :blank) if content.blank? || content.strip.empty?
+    end
+
+    def broadcast_creation
+      broadcast_append_to comment.card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+        partial: "cards/reactions/reaction", locals: { reaction: self }
+    end
+
+    def broadcast_removal
+      broadcast_remove_to comment.card
+    end
+end
