@@ -0,0 +1,14 @@
+class DataExport::CreateJob < ApplicationJob
+  def perform(export)
+    require "tempfile"
+    Tempfile.create([ "fizzy-export", ".zip" ]) do |file|
+      file.binmode
+      Account::DataTransfer::Archive.new(export.account, user: export.scope == "cards" ? export.user : nil).write(file)
+      file.rewind
+      export.archive.attach(io: file, filename: "fizzy-#{export.scope}.zip", content_type: "application/zip")
+    end
+    export.update!(expires_at: 1.day.from_now)
+    DataExport::ExpireJob.set(wait_until: export.expires_at).perform_later(export)
+    DataTransferMailer.export_ready(export).deliver_later
+  end
+end
