diff --git a/app/models/account/data_transfer/restore.rb b/app/models/account/data_transfer/restore.rb
new file mode 100644
index 0000000..7335f09
--- /dev/null
+++ b/app/models/account/data_transfer/restore.rb
@@ -0,0 +1,134 @@
+class Account::DataTransfer::Restore
+  class InvalidArchive < StandardError; end
+
+  def initialize(io, identity:, import_id:)
+    @io, @identity, @import_id = io, identity, import_id
+    @uploaded_keys = []
+  end
+
+  def run
+    require "zip"
+    Zip::File.open(io.path) do |zip|
+      validate!(zip)
+      Account.transaction do
+        original = JSON.parse(zip.read("records/accounts.jsonl").lines.first)
+        @account = Account.create!(name: original.fetch("name"), cards_count: original.fetch("cards_count", 0))
+        @old_account_id = original.fetch("id")
+        @owner_id = nil
+        sets.each do |set|
+          next if [ Account, ActiveStorage::VariantRecord, ActiveStorage::Blob, ActiveStorage::Attachment, ActionText::RichText ].include?(set.model)
+
+          entry = zip.find_entry("records/#{set.model.table_name}.jsonl")
+          next unless entry
+          entry.get_input_stream.each_line do |line|
+            row = JSON.parse(line)
+            email = row.delete("identity_email_address")
+            attrs = remap(row, set.model)
+            if set.model == User && attrs["role"] == "owner" && @owner_id.nil?
+              attrs["identity_id"] = identity.id
+              attrs["active"] = true
+              attrs["verified_at"] = Time.current
+              @owner_id = attrs["id"]
+            elsif set.model == User && email.present?
+              attrs["identity_id"] = Identity.find_or_create_by!(email_address: email).id
+            end
+            attrs["key"] = SecureRandom.base58(24) if set.model == Board::Publication && attrs["key"].present?
+            if set.model == Entropy && attrs["container_type"] == "Account"
+              @account.entropies.first&.update!(auto_postpone_period: attrs["auto_postpone_period"])
+              next
+            end
+            set.model.insert!(attrs)
+          end
+        end
+        raise InvalidArchive, "No owner found in account archive" unless @owner_id
+
+        restore_blobs(zip)
+        restore_rich_texts(zip)
+        restore_attachments(zip)
+        yield @account if block_given?
+      end
+      @account
+    end
+  rescue StandardError
+    @uploaded_keys.each { |key| ActiveStorage::Blob.service.delete(key) }
+    raise
+  end
+
+  private
+    attr_reader :io, :identity, :import_id
+
+    def sets
+      @sets ||= begin
+        result = []
+        Account::DataTransfer::Manifest.new(nil).each_record_set { |set| result << set }
+        result
+      end
+    end
+
+    def validate!(zip)
+      names = zip.entries.map(&:name)
+      raise InvalidArchive, "Not a Fizzy account archive" unless names.include?("records/accounts.jsonl") && names.include?("records/users.jsonl")
+      required = sets.reject { |set| set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet) || set.model == ActiveStorage::VariantRecord }
+        .map { |set| "records/#{set.model.table_name}.jsonl" }
+      raise InvalidArchive, "Incomplete account archive" unless (required - names).empty?
+      raise InvalidArchive, "Duplicate archive entries" unless names.uniq.size == names.size
+      raise InvalidArchive, "Unsafe archive path" if names.any? { |name| name.start_with?("/") || name.split("/").include?("..") }
+    end
+
+    def remap(attrs, model)
+      attrs.slice!(*model.column_names)
+      attrs.each do |key, value|
+        next if value.nil?
+        if key == "account_id"
+          attrs[key] = @account.id
+        elsif key == "identity_id"
+          attrs[key] = nil # Memberships on another instance must not gain access here.
+        elsif model.columns_hash[key].type == :uuid
+          attrs[key] = mapped(value)
+        end
+      end
+      attrs
+    end
+
+    def mapped(value)
+      return @account.id if value == @old_account_id
+      # Stable for all references, without building an account-sized ID map in memory.
+      Digest::SHA256.hexdigest("#{import_id}:#{value}")[0, 32].to_i(16).to_s(36).rjust(25, "0")
+    end
+
+    def restore_blobs(zip)
+      entry = zip.find_entry("records/active_storage_blobs.jsonl")
+      return unless entry
+
+      entry.get_input_stream.each_line do |line|
+        attrs = remap(JSON.parse(line), ActiveStorage::Blob)
+        old_id = JSON.parse(line).fetch("id")
+        file = zip.find_entry("files/#{old_id}") || raise(InvalidArchive, "Missing file #{old_id}")
+        attrs["service_name"] = ActiveStorage::Blob.service.name
+        attrs["key"] = SecureRandom.base58(28)
+        ActiveStorage::Blob.insert!(attrs)
+        @uploaded_keys << attrs["key"]
+        file.get_input_stream do |stream|
+          ActiveStorage::Blob.service.upload(attrs["key"], stream)
+        end
+      end
+    end
+    def restore_rich_texts(zip)
+      entry = zip.find_entry("records/action_text_rich_texts.jsonl")
+      entry.get_input_stream.each_line do |line|
+        attrs = remap(JSON.parse(line), ActionText::RichText)
+        attrs["body"] = attrs["body"].to_s.gsub(/data-fizzy-blob-id="([^"]+)"/) do
+          blob = ActiveStorage::Blob.find(mapped(Regexp.last_match(1)))
+          "sgid=\"#{blob.attachable_sgid}\""
+        end
+        ActionText::RichText.insert!(attrs)
+      end
+    end
+
+    def restore_attachments(zip)
+      entry = zip.find_entry("records/active_storage_attachments.jsonl")
+      entry&.get_input_stream&.each_line do |line|
+        ActiveStorage::Attachment.insert!(remap(JSON.parse(line), ActiveStorage::Attachment))
+      end
+    end
+end
