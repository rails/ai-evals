@@ -0,0 +1,18 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = DataExport.create!(account: Current.account, user: Current.user, scope: "account")
+    DataExport::CreateJob.perform_later(export)
+    redirect_to account_settings_path, notice: "We'll email you a download link when your export is ready."
+  end
+
+  def show
+    export = DataExport.find(params[:id])
+    if export.account == Current.account && export.user == Current.user && export.available?
+      redirect_to rails_service_blob_path(export.archive.blob.signed_id(expires_in: export.expires_at - Time.current), filename: export.archive.filename, disposition: "attachment"), allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+end
