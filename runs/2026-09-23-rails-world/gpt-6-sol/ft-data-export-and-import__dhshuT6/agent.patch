index 0000000..a027eb6
--- /dev/null
+++ b/test/controllers/account/data_transfers_controller_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Account::DataTransfersControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as users(:jason)
+  end
+
+  test "only admins can request an account export" do
+    assert_difference "DataExport.count", 1 do
+      post account_exports_path
+    end
+    assert_equal "account", DataExport.last.scope
+
+    logout_and_sign_in_as users(:david)
+    assert_no_difference "DataExport.count" do
+      post account_exports_path
+    end
+    assert_response :forbidden
+  end
+
+  test "a member can request their own cards but not someone else's" do
+    logout_and_sign_in_as users(:david)
+    assert_difference "DataExport.count", 1 do
+      post user_exports_path(users(:david))
+    end
+    assert_equal "cards", DataExport.last.scope
+    assert_no_difference "DataExport.count" do
+      post user_exports_path(users(:jason))
+    end
+    assert_response :forbidden
+  end
+
+  test "a signed in identity can upload outside an account" do
+    file = Tempfile.new([ "account", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    writer.add_file("records/accounts.jsonl", "{}\n")
+    writer.close
+    file.rewind
+    assert_difference "DataImport.count", 1 do
+      post account_imports_path(script_name: nil), params: { archive: Rack::Test::UploadedFile.new(file.path, "application/zip", true) }
+    end
+    assert_redirected_to new_account_import_path(script_name: nil)
+  ensure
+    file&.close!
+  end
+
+  test "a signed in identity can open import outside an account" do
+    get new_account_import_path(script_name: nil)
+    assert_response :success
+  end
+end
+
+class Account::ExportsDownloadControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as users(:jason)
+  end
+
+  test "a download must belong to the user and expire after a day" do
+    export = DataExport.create!(account: accounts(:"37s"), user: users(:jason), scope: "account")
+    export.archive.attach(io: StringIO.new("archive"), filename: "fizzy.zip", content_type: "application/zip")
+    export.update!(expires_at: 1.day.from_now)
+    get account_export_path(export)
+    assert_response :redirect
+    download_url = response.location
+    get download_url
+    assert_response :redirect
+
+    travel 2.days do
+      get download_url
+      assert_response :not_found
+      get account_export_path(export)
+      assert_response :not_found
+    end
+
+    export.update!(expires_at: 1.day.from_now)
+    logout_and_sign_in_as users(:david)
+    get account_export_path(export)
+    assert_response :not_found
+  end
+end
