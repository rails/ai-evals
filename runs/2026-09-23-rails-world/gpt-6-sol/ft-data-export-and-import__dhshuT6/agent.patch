+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  skip_before_action :ensure_can_access_account
+  def new
+  end
+
+  def create
+    file = params.require(:archive)
+    unless file.respond_to?(:original_filename) && File.extname(file.original_filename).downcase == ".zip"
+      redirect_to new_account_import_path(script_name: nil), alert: "Choose a .zip account archive." and return
+    end
+
+    import = DataImport.create!(identity: Current.identity)
+    Current.with_account(import.account) { import.archive.attach(file) }
+    DataImport::RestoreJob.perform_later(import)
+    redirect_to new_account_import_path(script_name: nil), notice: "We'll email you when the import finishes."
+  end
+end
