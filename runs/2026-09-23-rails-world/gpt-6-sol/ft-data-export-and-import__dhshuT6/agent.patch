+      export.archive.purge
+    end
+  end
+end
diff --git a/app/jobs/data_import/restore_job.rb b/app/jobs/data_import/restore_job.rb
new file mode 100644
index 0000000..38438c3
--- /dev/null
+++ b/app/jobs/data_import/restore_job.rb
@@ -0,0 +1,24 @@
+class DataImport::RestoreJob < ApplicationJob
+  def perform(import)
+    require "tempfile"
+    account = nil
+    begin
+      Tempfile.create([ "fizzy-import", ".zip" ]) do |file|
+        file.binmode
+        import.archive.blob.download { |chunk| file.write(chunk) }
+        file.flush
+        account = Account::DataTransfer::Restore.new(file, identity: import.identity, import_id: import.id).run do
+          import.update!(status: "completed")
+        end
+      end
+    rescue StandardError => error
+      import.update!(status: "failed", error: error.message)
+      DataTransferMailer.import_failed(import).deliver_later
+      return
+    ensure
+      import.archive.purge if import.archive.attached?
+    end
+    DataTransferMailer.import_completed(import, account).deliver_later
+    Account::DataTransfer::ReindexJob.perform_later(account)
+  end
+end
