+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def import_completed(import, account)
+    @account = account
+    mail to: import.identity.email_address, subject: "Your Fizzy import is complete"
+  end
+
+  def import_failed(import)
+    @import = import
+    mail to: import.identity.email_address, subject: "Your Fizzy import failed"
+  end
+end
