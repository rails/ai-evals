diff --git a/app/models/account/data_transfer/archive.rb b/app/models/account/data_transfer/archive.rb
new file mode 100644
index 0000000..fdeb734
--- /dev/null
+++ b/app/models/account/data_transfer/archive.rb
@@ -0,0 +1,96 @@
+# A portable archive of account records. Records are written a row at a time so large
+# accounts do not need to fit in memory. The ZIP writer can target a disk or S3 upload.
+class Account::DataTransfer::Archive
+  def initialize(account, user: nil)
+    @account, @user = account, user
+  end
+
+  def write(io)
+    io.binmode
+    zip = ZipFile::Writer.new(io)
+    sets.each do |set|
+      next if set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet) || set.model == ActiveStorage::VariantRecord # Derived images can be regenerated.
+
+      zip.add_file("records/#{set.model.table_name}.jsonl") do |sink|
+        rows(set).find_each do |row|
+          attributes = row.attributes.slice(*set.attributes)
+          attributes["identity_email_address"] = row.identity&.email_address if set.model == User && !user
+          attributes["body"] = portable_body(attributes["body"]) if set.model == ActionText::RichText && attributes["body"]
+          sink.write(attributes.to_json + "\n")
+        end
+      end
+    end
+
+    write_card_documents(zip)
+
+    blobs.find_each do |blob|
+      zip.add_file("files/#{blob.id}", compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+    zip.close
+  end
+
+  private
+    attr_reader :account, :user
+
+    def sets
+      list = []
+      Account::DataTransfer::Manifest.new(account).each_record_set { |set| list << set }
+      if user
+        list.select { |set| [ Card, Comment, ActionText::RichText, ActiveStorage::Blob, ActiveStorage::Attachment ].include?(set.model) }
+      else
+        list
+      end
+    end
+
+    def rows(set)
+      if user
+        cards = user.accessible_cards.select(:id)
+        case set.model.name
+        when "Card" then account.cards.where(id: cards)
+        when "Comment" then Comment.where(card_id: cards)
+        when "ActionText::RichText" then ActionText::RichText.where(record_type: "Card", record_id: cards).or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards).select(:id)))
+        when "ActiveStorage::Attachment" then attachments(cards)
+        when "ActiveStorage::Blob" then ActiveStorage::Blob.where(id: attachments(cards).select(:blob_id))
+        end
+      else
+        set.send(:records)
+      end
+    end
+
+    def attachments(cards)
+      rich_texts = ActionText::RichText.where(record_type: "Card", record_id: cards).or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards).select(:id)))
+      ActiveStorage::Attachment.where(record_type: "Card", record_id: cards).or(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id)))
+    end
+
+    def portable_body(body)
+      body.to_html.gsub(/sgid="([^"]+)"/) do |match|
+        blob = GlobalID::Locator.locate_signed(Regexp.last_match(1), for: "attachable")
+        blob.is_a?(ActiveStorage::Blob) ? "data-fizzy-blob-id=\"#{blob.id}\"" : match
+      end
+    end
+
+    def write_card_documents(zip)
+      cards = user ? user.accessible_cards.distinct : account.cards
+      cards.find_each do |card|
+        comments = card.comments.chronologically.map do |comment|
+          comment.attributes.merge("body" => comment.body.to_s)
+        end
+        files = attachments(Card.where(id: card.id).select(:id)).includes(:blob).map do |attachment|
+          { "path" => "files/#{attachment.blob_id}", "filename" => attachment.blob.filename.to_s,
+            "content_type" => attachment.blob.content_type }
+        end
+        document = card.attributes.merge("description" => card.description.to_s, "comments" => comments, "files" => files)
+        zip.add_file("cards/#{card.id}.json", document.to_json)
+      end
+    end
+
+    def blobs
+      if user
+        ActiveStorage::Blob.where(id: attachments(user.accessible_cards.select(:id)).select(:blob_id))
+      else
+        Account::DataTransfer::ActiveStorage::BlobRecordSet.new(account).send(:records)
+      end
+    end
+end
