+class EmailBundleMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @entries = bundle.entries.order(:created_at, :id)
+    mail to: bundle.user.identity.email_address, subject: "Your Fizzy notifications"
+  end
+end
diff --git a/app/models/email_bundle.rb b/app/models/email_bundle.rb
new file mode 100644
index 0000000..4aea8ec
--- /dev/null
+++ b/app/models/email_bundle.rb
@@ -0,0 +1,35 @@
+class EmailBundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :entries, class_name: "EmailBundleEntry", dependent: :destroy
+
+  # Lock the person, not the bundle: there may not be a bundle to lock yet.
+  # This serializes competing notifications as well as the deadline job.
+  def self.record(notification)
+    user = notification.user
+    user.with_lock do
+      if (duration = user.settings.bundle_email_duration) && user.active? && user.account.active?
+        now = Time.current
+        bundle = user.email_bundles.where(sent_at: nil).where("ends_at > ?", now).order(starts_at: :desc).first
+        unless bundle
+          bundle = user.email_bundles.create!(starts_at: now, ends_at: now + duration)
+          EmailBundle::SendJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+        end
+
+        payload = notification.payload
+        bundle.entries.create!(title: payload.title, body: payload.body, url: payload.url)
+      end
+    end
+  end
+
+  def send_email
+    user.with_lock do
+      if sent_at.nil? && ends_at <= Time.current
+        update!(sent_at: Time.current)
+        if entries.exists? && user.active? && account.active? && user.identity && user.settings.bundle_email_duration
+          EmailBundleMailer.digest(self).deliver_later
+        end
+      end
+    end
+  end
+end
