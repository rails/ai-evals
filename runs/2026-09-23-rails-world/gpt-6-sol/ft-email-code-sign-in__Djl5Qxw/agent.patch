diff --git a/test/controllers/email_codes_controller_test.rb b/test/controllers/email_codes_controller_test.rb
new file mode 100644
index 0000000..27b3f1f
--- /dev/null
+++ b/test/controllers/email_codes_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "sign in by emailed code only once" do
+    untenanted do
+      assert_enqueued_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      assert_redirected_to new_session_email_code_path
+      code = EmailCode.last
+      email = capture_email_code
+      assert_equal identities(:kevin).email_address, code.email_address
+      assert_equal 6, email.length
+
+      post session_email_code_path, params: { code: "WRONG1" }
+      assert_response :unprocessable_entity
+      post session_email_code_path, params: { code: email }
+      assert_response :redirect
+      assert cookies[:session_token].present?
+      assert code.reload.used_at.present?
+      post session_email_code_path, params: { code: email }
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "signup starts completion after verifying email" do
+    untenanted do
+      post signup_path, params: { signup: { email_address: "new-code@example.com" } }
+      assert_redirected_to new_signup_email_code_path
+      post signup_email_code_path, params: { code: capture_email_code }
+      assert_redirected_to new_signup_completion_path
+      assert Identity.exists?(email_address: "new-code@example.com")
+    end
+  end
+
+  test "expired code cannot be used" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      EmailCode.last.update!(expires_at: 1.second.ago)
+      post session_email_code_path, params: { code: capture_email_code }
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "join by email code creates a member" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    address = "new-join@example.com"
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: address }
+    assert_redirected_to new_join_email_code_path(join_code: join_code.code, script_name: account.slug)
+    post join_email_code_path(join_code: join_code.code, script_name: account.slug), params: { code: capture_email_code }
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert account.users.exists?(identity: Identity.find_by!(email_address: address))
+  end
+
+  test "signup code cannot be used to sign in" do
+    untenanted do
+      post signup_path, params: { signup: { email_address: "other@example.com" } }
+      code = capture_email_code
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to new_session_path
+      assert_nil EmailCode.last.used_at
+      post signup_email_code_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  private
+    def capture_email_code
+      ActionMailer::Base.deliveries.clear
+      perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob)
+      mail = ActionMailer::Base.deliveries.last
+      mail.subject[/\b[A-Z2-9]{6}\b/]
+    end
+end
