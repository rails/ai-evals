@@ -0,0 +1,16 @@
+module EmailCodeIssuance
+  extend ActiveSupport::Concern
+
+  private
+    def send_email_code(email_address, purpose, destination)
+      identity = Identity.new(email_address: email_address)
+      if identity.valid?
+        record, code = EmailCode.issue(email_address: identity.email_address, purpose: purpose)
+        session[:email_code_id] = record.id
+        EmailCodeMailer.verification(email_address: record.email_address, code: code).deliver_later
+        redirect_to destination
+      else
+        head :unprocessable_entity
+      end
+    end
+end
diff --git a/app/controllers/email_codes_controller.rb b/app/controllers/email_codes_controller.rb
