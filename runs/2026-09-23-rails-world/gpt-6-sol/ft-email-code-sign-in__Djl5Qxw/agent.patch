@@ -0,0 +1,69 @@
+class EmailCodesController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope if: -> { params[:flow] != "join" }
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def new
+    load_pending_code
+  end
+
+  def create
+    load_pending_code
+    return if performed?
+
+    if @email_code.redeem(params.expect(:code).to_s.upcase)
+      session.delete(:email_code_id)
+      finish_authentication
+    else
+      flash.now[:alert] = "That code didn't work. Request a new one if it has expired."
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def load_pending_code
+      @join_code = Account::JoinCode.find_by(code: params[:join_code], account: Current.account) if params[:flow] == "join"
+      purpose = @join_code ? "join:#{@join_code.id}" : params[:flow]
+      @email_code = EmailCode.find_by(id: session[:email_code_id], purpose: purpose)
+
+      unless @email_code && @email_code.used_at.nil? && @email_code.expires_at.future? && (params[:flow] != "join" || @join_code.active?)
+        redirect_to_start
+      end
+    end
+
+    def redirect_to_start
+      case params[:flow]
+      when "session" then redirect_to new_session_path, alert: "Request a new code."
+      when "signup" then redirect_to new_signup_path, alert: "Request a new code."
+      when "join" then redirect_to join_path(code: params[:join_code]), alert: "Request a new code."
+      end
+    end
+
+    def finish_authentication
+      case params[:flow]
+      when "session"
+        if identity = Identity.find_by(email_address: @email_code.email_address)
+          start_new_session_for identity
+          redirect_to after_authentication_url
+        else
+          redirect_to new_signup_path, alert: "Create an account with this email first."
+        end
+      when "signup"
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        start_new_session_for identity
+        redirect_to new_signup_completion_path
+      when "join"
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        @join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: @join_code.account, identity: identity)
+        start_new_session_for identity
+        if user.setup?
+          redirect_to landing_url(script_name: @join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+        end
+      end
+    end
+end
