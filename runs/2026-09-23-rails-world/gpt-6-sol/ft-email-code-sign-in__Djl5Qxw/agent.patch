@@ -0,0 +1,26 @@
+<% @page_title = "Enter your email code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+  <p>Enter the six-character code we sent to <%= @email_code.email_address %>. It expires in 15 minutes.</p>
+
+  <% destination = case params[:flow]
+    when "session" then session_email_code_path
+    when "signup" then signup_email_code_path
+    when "join" then join_email_code_path(join_code: params[:join_code])
+  end %>
+  <%= form_with url: destination, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.text_field :code, required: true, minlength: 6, maxlength: 6, autocomplete: "one-time-code", autofocus: true, class: "input txt-large", placeholder: "Email code" %>
+    <button type="submit" class="btn btn--link center txt-medium">Continue</button>
+  <% end %>
+
+  <p><%= link_to "Request a new code", case params[:flow]
+    when "session" then new_session_path
+    when "signup" then new_signup_path
+    when "join" then join_path(code: params[:join_code])
+  end %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
