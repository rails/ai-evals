diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..9e7c11f
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,27 @@
+class EmailCode < ApplicationRecord
+  LIFETIME = 15.minutes
+  ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789".freeze
+
+  def self.issue(email_address:, purpose:)
+    code = Array.new(6) { ALPHABET[SecureRandom.random_number(ALPHABET.length)] }.join
+    record = create!(email_address: email_address, purpose: purpose,
+      code_digest: digest(code), expires_at: LIFETIME.from_now)
+    [ record, code ]
+  end
+
+  def redeem(code)
+    with_lock do
+      if used_at.nil? && expires_at.future? && code.to_s.match?(/\A[A-Z2-9]{6}\z/) &&
+          ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest(code))
+        update!(used_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def self.digest(code)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code)
+  end
+end
