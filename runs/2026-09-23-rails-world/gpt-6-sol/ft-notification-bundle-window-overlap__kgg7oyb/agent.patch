diff --git a/test/models/notification/email_digest_test.rb b/test/models/notification/email_digest_test.rb
new file mode 100644
index 0000000..5f4c6eb
--- /dev/null
+++ b/test/models/notification/email_digest_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Notification::EmailDigestTest < ActiveSupport::TestCase
+  test "notifications share a window anchored to the first arrival and send one email" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    travel_to Time.utc(2026, 3, 1, 10)
+    Notification::EmailDigest.record(notifications(:logo_assignment_kevin))
+    digest = user.email_digests.sole
+    assert_equal 4.hours.from_now, digest.ends_at
+
+    travel 3.hours
+    Notification::EmailDigest.record(notifications(:layout_commented_kevin))
+    assert_equal digest, user.email_digests.sole
+
+    travel 1.hour
+    Notification::EmailDigest.deliver_due
+    assert_equal 1, enqueued_jobs.count { |job| job[:job] == ActionMailer::MailDeliveryJob }
+    assert digest.reload.sent_at
+    assert_no_difference -> { enqueued_jobs.count { |job| job[:job] == ActionMailer::MailDeliveryJob } } do
+      Notification::EmailDigest.deliver_due
+    end
+    mail = NotificationDigestMailer.digest(digest).message
+    assert_includes mail.text_part.body.decoded, "Your Fizzy notifications"
+    assert_equal 2, digest.notifications.count
+    Notification::EmailDigest.record(notifications(:buy_domain_sent_back_to_triage_kevin))
+    assert_equal 2, user.email_digests.count
+    assert_operator user.email_digests.order(:starts_at).last.starts_at, :>=, digest.ends_at
+  end
+    test "saving a notification records each event even when the card notification is reused" do
+      user = users(:kevin)
+      user.settings.update!(bundle_email_frequency: :daily)
+      notifications(:layout_commented_kevin).destroy!
+
+      notification = Notification.create!(user: user, source: events(:layout_published), creator: users(:david))
+      notification.update!(source: events(:layout_commented))
+      notification.read
+
+      digest = user.email_digests.sole
+      assert_equal 2, digest.items.count
+      assert_equal 2, digest.items.distinct.count(:source_id)
+    end
+
+    test "turning email off prevents a pending digest from being sent" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :daily)
+    Notification::EmailDigest.record(notifications(:logo_assignment_kevin))
+    user.settings.update!(bundle_email_frequency: :never)
+
+    travel 1.day + 1.minute
+    Notification::EmailDigest.deliver_due
+
+    assert user.email_digests.sole.sent_at
+    assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob
+  end
+
+  test "disabled email never opens a window" do
+      Notification::EmailDigest.record(notifications(:logo_assignment_kevin))
+      assert_empty users(:kevin).email_digests
+    end
+
+    test "daily and weekly windows start at the arrival, and duplicate arrivals do not duplicate items" do
+      user = users(:kevin)
+      { daily: 1.day, weekly: 1.week }.each do |frequency, duration|
+        user.settings.update!(bundle_email_frequency: frequency)
+        notification = notifications(:logo_assignment_kevin)
+        Notification::EmailDigest.record(notification)
+        Notification::EmailDigest.record(notification)
+        digest = user.email_digests.where(sent_at: nil).sole
+        assert_equal duration, digest.ends_at - digest.starts_at
+        assert_equal 1, digest.items.count
+        digest.deliver
+      end
+    end
+  end
