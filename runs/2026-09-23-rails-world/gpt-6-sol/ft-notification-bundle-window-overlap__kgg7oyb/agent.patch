diff --git a/app/models/notification/email_digest.rb b/app/models/notification/email_digest.rb
new file mode 100644
index 0000000..69c678e
--- /dev/null
+++ b/app/models/notification/email_digest.rb
@@ -0,0 +1,45 @@
+class Notification::EmailDigest < ApplicationRecord
+  FREQUENCIES = { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.freeze
+
+  belongs_to :user
+  has_many :items, class_name: "Notification::EmailDigestItem", foreign_key: :email_digest_id, dependent: :destroy
+  has_many :notifications, through: :items
+
+  scope :due, -> { where(sent_at: nil).where(ends_at: ..Time.current) }
+
+  def self.record(notification)
+    user = notification.user
+    user.with_lock do
+      if (duration = FREQUENCIES[user.settings&.bundle_email_frequency]) && user.active? && notification.account.active?
+        now = Time.current
+        digest = user.email_digests.where(sent_at: nil).order(:starts_at).last
+        if digest && digest.ends_at <= now
+          digest.deliver
+          digest = nil
+        end
+
+        digest ||= user.email_digests.create!(starts_at: now, ends_at: now + duration)
+        digest.items.find_or_create_by!(notification: notification, source_type: notification.source_type, source_id: notification.source_id) do |item|
+          item.assign_attributes(notification.payload.to_h)
+        end
+      end
+    end
+  end
+
+  def self.deliver_due
+    due.find_each do |digest|
+      digest.user.with_lock do
+        digest.reload.deliver if digest.sent_at.nil? && digest.ends_at <= Time.current
+      end
+    end
+  end
+
+  def deliver
+    if user.settings&.never? || !user.active? || !user.account.active? || items.empty?
+      update!(sent_at: Time.current)
+    else
+      NotificationDigestMailer.digest(self).deliver_later
+      update!(sent_at: Time.current)
+    end
+  end
+end
