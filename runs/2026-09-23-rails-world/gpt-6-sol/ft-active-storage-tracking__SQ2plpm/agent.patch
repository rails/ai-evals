+++ b/app/models/board/storage_usage.rb
@@ -0,0 +1,42 @@
+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :refresh_account_storage_usage_later
+  end
+
+  def refresh_storage_usage_later
+    if self.class.where(id: id, storage_usage_pending: false).update_all(storage_usage_pending: true) == 1
+      # Coalesce bursts of uploads and edits before scanning a large board.
+      Board::RefreshStorageUsageJob.set(wait: 5.seconds).perform_later(id)
+    end
+  end
+
+  def refresh_storage_usage_now
+    with_lock do
+      update_columns(storage_usage_pending: false, bytes_used: image_bytes_used + embed_bytes_used("Board", id, "public_description") +
+        embed_bytes_used("Card", Card.where(board_id: id).select(:id), "description") +
+        embed_bytes_used("Comment", Comment.where(card_id: Card.where(board_id: id).select(:id)).select(:id), "body"))
+    end
+
+    account.refresh_storage_usage_later
+  end
+
+  private
+    def image_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: Card.where(board_id: id).select(:id))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def embed_bytes_used(type, record_ids, field)
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id:
+          ActionText::RichText.where(record_type: type, record_id: record_ids, name: field).select(:id))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def refresh_account_storage_usage_later
+      account.refresh_storage_usage_later
+    end
+end
