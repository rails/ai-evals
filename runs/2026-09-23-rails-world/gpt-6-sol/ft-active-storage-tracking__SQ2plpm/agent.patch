--- /dev/null
+++ b/app/jobs/board/backfill_storage_usage_job.rb
@@ -0,0 +1,15 @@
+class Board::BackfillStorageUsageJob < StorageUsageJob
+  BATCH_SIZE = 25
+
+  def perform(after_id = nil)
+    boards = Board.order(:id)
+    boards = boards.where("id > ?", after_id) if after_id
+    ids = boards.limit(BATCH_SIZE).pluck(:id)
+
+    ids.each do |id|
+      Board.find_by(id: id)&.refresh_storage_usage_now
+    end
+
+    self.class.perform_later(ids.last) if ids.size == BATCH_SIZE
+  end
+end
