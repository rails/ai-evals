+# Usage jobs operate on explicit IDs, including during account deletion and backfills.
+# They must not depend on the account that happened to enqueue them still existing.
+class StorageUsageJob < ApplicationJob
+  def serialize
+    super.merge("account" => nil)
+  end
+end
