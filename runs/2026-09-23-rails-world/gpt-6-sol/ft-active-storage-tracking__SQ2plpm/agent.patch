diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..e80817e
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+  end
+
+  test "counts only card images and board card and comment embeds" do
+    board = boards(:writebook)
+    account = board.account
+    card = cards(:logo)
+    comment = comments(:logo_1)
+
+    card.image.attach(file("image", 5))
+    board.update!(public_description: embed(7))
+    card.update!(description: embed(11))
+    comment.update!(body: embed(13))
+
+    refresh_usage(board)
+    assert_equal 36, board.reload.bytes_used
+    assert_equal 36, account.reload.bytes_used
+
+    comment.update!(body: "Removed attachment")
+    refresh_usage(board)
+    assert_equal 23, board.reload.bytes_used
+
+    card.image.purge
+    refresh_usage(board)
+    assert_equal 18, board.reload.bytes_used
+    assert_equal 18, account.reload.bytes_used
+  end
+
+  test "moves and deletes update both boards and account" do
+    card = cards(:logo)
+    source = card.board
+    destination = boards(:private)
+    card.image.attach(file("image", 5))
+    refresh_usage(source)
+
+    card.move_to(destination)
+    assert source.reload.storage_usage_pending?
+    assert destination.reload.storage_usage_pending?
+    refresh_usage(source)
+    refresh_usage(destination)
+    assert_equal 0, source.reload.bytes_used
+    assert_equal 5, destination.reload.bytes_used
+    assert_equal 5, source.account.reload.bytes_used
+
+    card.destroy!
+    assert destination.reload.storage_usage_pending?
+    refresh_usage(destination)
+    assert_equal 0, destination.reload.bytes_used
+    assert_equal 0, source.account.reload.bytes_used
+  end
+
+  test "coalesces repeated recount requests and ignores unrelated files" do
+    board = boards(:writebook)
+    account = board.account
+    users(:david).avatar.attach(file("avatar", 20))
+
+    board.refresh_storage_usage_later
+    board.refresh_storage_usage_later
+    assert board.reload.storage_usage_pending?
+    refresh_usage(board)
+    assert_not board.reload.storage_usage_pending?
+    assert_equal 0, board.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "rich text changes request a recount, including removal" do
+    board = boards(:private)
+    board.update!(public_description: "Plain text")
+    assert_not board.reload.storage_usage_pending?
+
+    board.update!(public_description: embed(7))
+    assert board.reload.storage_usage_pending?
+    refresh_usage(board)
+    assert_equal 7, board.reload.bytes_used
+
+    board.update!(public_description: "Removed")
+    assert board.reload.storage_usage_pending?
+    refresh_usage(board)
+    assert_equal 0, board.reload.bytes_used
+  end
+
+  test "deleting a board removes its usage from the account" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    card.image.attach(file("image", 5))
+    refresh_usage(board)
+    account = board.account
+
+    board.destroy!
+    account.refresh_storage_usage_now
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  def refresh_usage(board)
+    board.refresh_storage_usage_now
+    board.account.refresh_storage_usage_now
+  end
+
+  private
+    def file(name, size)
+      { io: StringIO.new("x" * size), filename: "#{name}.txt", content_type: "text/plain" }
+    end
+
+    def embed(size)
+      blob = ActiveStorage::Blob.create_and_upload!(**file("embed", size))
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
