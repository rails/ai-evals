@@ -0,0 +1,22 @@
+module RichTextStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :refresh_embeds_storage_usage, if: :storage_embeds_changed?
+  end
+
+  private
+    def storage_embeds_changed?
+      saved_change_to_body? && (body.to_s.include?("action-text-attachment") || body_before_last_save.to_s.include?("action-text-attachment"))
+    end
+
+    def refresh_embeds_storage_usage
+      board_id = case [ record_type, name ]
+      when [ "Board", "public_description" ] then record_id
+      when [ "Card", "description" ] then record&.board_id
+      when [ "Comment", "body" ] then record&.card&.board_id
+      end
+
+      Board.find_by(id: board_id)&.refresh_storage_usage_later if board_id
+    end
+end
