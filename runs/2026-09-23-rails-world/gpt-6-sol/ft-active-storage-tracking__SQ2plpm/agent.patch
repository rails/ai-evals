@@ -0,0 +1,35 @@
+module AttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :refresh_board_storage_usage
+    before_destroy :remember_storage_board
+    after_destroy_commit :refresh_board_storage_usage
+  end
+
+  private
+    def remember_storage_board
+      @storage_board_id = storage_board_id
+    end
+
+    def refresh_board_storage_usage
+      if board_id = @storage_board_id || storage_board_id
+        Board.find_by(id: board_id)&.refresh_storage_usage_later
+      end
+    end
+
+    def storage_board_id
+      case record_type
+      when "Card"
+        record&.board_id if name == "image"
+      when "ActionText::RichText"
+        if name == "embeds" && (rich_text = record)
+          case [ rich_text.record_type, rich_text.name ]
+          when [ "Board", "public_description" ] then rich_text.record_id
+          when [ "Card", "description" ] then rich_text.record&.board_id
+          when [ "Comment", "body" ] then rich_text.record&.card&.board_id
+          end
+        end
+      end
+    end
+end
diff --git a/app/models/concerns/rich_text_storage_usage.rb b/app/models/concerns/rich_text_storage_usage.rb
