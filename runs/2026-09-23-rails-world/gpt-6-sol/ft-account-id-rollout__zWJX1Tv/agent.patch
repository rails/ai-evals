diff --git a/test/models/account_id_rollout_test.rb b/test/models/account_id_rollout_test.rb
new file mode 100644
index 0000000..8c8edac
--- /dev/null
+++ b/test/models/account_id_rollout_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class AccountIdRolloutTest < ActiveSupport::TestCase
+  GLOBAL_TABLES = %w[
+    accounts account_external_id_sequences identities identity_access_tokens
+    magic_links sessions action_pack_passkeys ar_internal_metadata schema_migrations
+  ].freeze
+
+  test "tenant tables have required indexed account ids" do
+    connection = ActiveRecord::Base.connection
+
+    (connection.tables - GLOBAL_TABLES).each do |table|
+      column = connection.columns(table).find { |candidate| candidate.name == "account_id" }
+      assert column, "#{table} is missing account_id"
+      assert_not column.null, "#{table}.account_id must be required"
+      assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table}.account_id must be indexed"
+    end
+  end
+
+  test "child rows inherit the account of their owner" do
+    card = cards(:logo)
+    assert_equal card.account_id, card.pins.create!(user: users(:david)).account_id
+  end
+end
