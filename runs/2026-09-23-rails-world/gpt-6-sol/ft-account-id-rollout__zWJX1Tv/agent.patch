new file mode 100644
index 0000000..d7d4790
--- /dev/null
+++ b/config/initializers/account_id_on_owned_records.rb
@@ -0,0 +1,44 @@
+# Child records inherit tenancy from their owner, not from the request context.
+# This also covers framework-owned rows (Action Text and Active Storage), which
+# do not inherit from ApplicationRecord.
+module AccountIdOnOwnedRecords
+  OWNERS = {
+    "accesses" => :board, "assignees_filters" => :filter,
+    "assigners_filters" => :filter, "assignments" => :card,
+    "board_publications" => :board, "boards_filters" => :board,
+    "card_activity_spikes" => :card, "card_goldnesses" => :card,
+    "card_not_nows" => :card, "closers_filters" => :filter,
+    "closures" => :card, "creators_filters" => :filter,
+    "filters_tags" => :filter, "pins" => :card,
+    "search_queries" => :user, "taggings" => :card,
+    "user_settings" => :user, "watches" => :card,
+    "webhook_delinquency_trackers" => :webhook,
+    "webhook_deliveries" => :webhook,
+    "steps" => :card, "comments" => :card, "columns" => :board,
+    "cards" => :board, "events" => :board,
+    "notifications" => :user, "notification_bundles" => :user,
+    "push_subscriptions" => :user, "webhooks" => :board,
+    "entropies" => :container, "storage_totals" => :owner,
+    "mentions" => :source, "reactions" => :reactable,
+    "action_text_rich_texts" => :record,
+    "active_storage_attachments" => :record,
+    "active_storage_variant_records" => :blob
+  }.freeze
+
+  def assign_account_id_from_owner
+    if has_attribute?(:account_id) && account_id.nil?
+      owner = public_send(OWNERS.fetch(self.class.table_name)) if OWNERS.key?(self.class.table_name) && respond_to?(OWNERS.fetch(self.class.table_name))
+      owner ||= Filter.find_by(id: filter_id) if self.class.table_name.end_with?("_filters", "filters_tags") && has_attribute?(:filter_id) && filter_id
+      self.account_id = if owner.is_a?(Account)
+        owner.id
+      else
+        owner&.account_id || Current.account&.id
+      end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_record) do
+  include AccountIdOnOwnedRecords
+  before_validation :assign_account_id_from_owner, on: :create
+end
