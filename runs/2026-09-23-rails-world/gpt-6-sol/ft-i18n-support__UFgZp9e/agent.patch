diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..6ca3f8d
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "a selected locale persists on the identity and across browser sessions" do
+    identity = identities(:david)
+    sign_in_as identity
+
+    get root_path, params: { locale: "ja" }
+    assert_equal "ja", identity.reload.locale
+    assert_select "html[lang=ja]"
+
+    get root_path, params: { locale: "xx" }
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identity.reload.locale
+
+    reset!
+    sign_in_as identity
+    get root_path
+    assert_select "html[lang=ja]"
+  end
+end
+
+class AnonymousLocaleTest < ActionDispatch::IntegrationTest
+  test "anonymous locale choice carries into sign in" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_select "html[lang=ja]"
+      get new_session_path, params: { locale: "xx" }
+      assert_select "html[lang=ja]"
+    end
+
+    identity = identities(:kevin)
+    sign_in_as identity
+    get root_path
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identity.reload.locale
+  end
+
+  test "an invalid locale leaves the default unchanged" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+      assert_select "html[lang=en]"
+    end
+  end
+end
+
+class LocaleBeforeSignInTest < ActionDispatch::IntegrationTest
+  test "choosing Japanese before requesting a magic link saves the recipient's locale" do
+    identity = identities(:kevin)
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      post session_path, params: { email_address: identity.email_address }
+    end
+
+    assert_response :redirect
+    assert_equal "ja", identity.reload.locale
+    assert_match(/認証コード/, MagicLinkMailer.sign_in_instructions(identity.magic_links.last).message.subject)
+  end
+end
diff --git a/test/mailers/japanese_mail_test.rb b/test/mailers/japanese_mail_test.rb
new file mode 100644
index 0000000..ace3202
--- /dev/null
+++ b/test/mailers/japanese_mail_test.rb
@@ -0,0 +1,17 @@
+require "test_helper"
+
+class JapaneseMailTest < ActionMailer::TestCase
+  test "magic link uses the recipient's language for both parts and subject" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(link).message
+
+    assert_match(/認証コード/, email.subject)
+    assert_match(/認証コード/, email.html_part.decoded)
+    assert_match(/認証コード/, email.text_part.decoded)
+    assert_match(/分/, email.text_part.decoded)
+    assert_equal :en, I18n.locale
+  end
+end
