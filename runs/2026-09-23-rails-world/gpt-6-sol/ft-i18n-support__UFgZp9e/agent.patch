diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..869d752
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,21 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :use_current_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def use_current_locale(&block)
+      selected = params[:locale] if params[:locale].is_a?(String) && I18n.available_locales.map(&:to_s).include?(params[:locale])
+      session[:locale] = selected if selected
+
+      identity = Current.identity || find_session_by_cookie&.identity
+      identity.update!(locale: session[:locale]) if identity && session[:locale].present? && identity.locale != session[:locale]
+
+      locale = session[:locale].presence || identity&.locale.presence
+      locale = I18n.default_locale unless I18n.available_locales.map(&:to_s).include?(locale.to_s)
+      I18n.with_locale(locale, &block)
+    end
+end
