+++ b/config/deploy.yml
@@ -0,0 +1,38 @@
+# Single-server OSS deployment. Replace the two example.com values with your DNS name.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - example.com
+
+proxy:
+  ssl: true
+  host: example.com
+  app_port: 80
+
+# Kamal sets up a local registry for image transfer; no external registry account is needed.
+registry:
+  server: localhost:5555
+
+# Includes SQLite (primary, cable, cache, queue) and local file uploads.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    APP_HOST: example.com
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+    WEB_CONCURRENCY: 2
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+# Change this to arm64 when building for an ARM server.
+builder:
+  arch: amd64
