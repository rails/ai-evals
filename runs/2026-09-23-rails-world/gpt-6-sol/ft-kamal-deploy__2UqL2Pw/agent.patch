diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..82c571c
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,30 @@
+# Deploy on one server with Kamal
+
+This is the standalone (non-SaaS) deployment: one Linux host running Docker,
+with the web server and Solid Queue jobs in the same container. SQLite and local
+uploads live in the `fizzy_storage` Docker volume, mounted at `/rails/storage`.
+Back up that volume regularly (including the SQLite database files); replacing
+or removing the volume **deletes your data**.
+
+1. Point a DNS A/AAAA record at the server. Allow inbound ports 80 and 443 for
+   Kamal's proxy and Let's Encrypt. Ensure you can SSH to the server (Kamal
+   defaults to root; configure `ssh.user` in `config/deploy.yml` if needed).
+2. In `config/deploy.yml`, replace `example.com` in `servers.web`, `proxy.host`,
+   and `env.clear.APP_HOST` with your hostname. Set `MAILER_FROM_ADDRESS` to a
+   sender authorized by your mail provider and fill in `SMTP_ADDRESS`,
+   `SMTP_PORT`, and `SMTP_USERNAME`. SMTP uses STARTTLS and plain authentication.
+   Set `SMTP_USERNAME` to an empty string if your server requires no auth.
+3. Copy `.kamal/secrets.example` to `.kamal/secrets`. Replace the placeholders:
+   generate `SECRET_KEY_BASE` with `bin/rails secret`, and enter your SMTP
+   password. Keep `.kamal/secrets` private; it is gitignored. If your SMTP
+   provider requires no password, set `SMTP_PASSWORD=`.
+4. From your machine with Docker and Ruby/Bundler installed, run `bin/kamal setup`
+   (or `bundle exec kamal setup`). Visit `https://your-hostname` and sign in
+   using an email your SMTP provider can deliver to.
+
+Subsequent releases use `bin/kamal deploy`. The image's entrypoint prepares the
+SQLite databases on boot. Puma runs Solid Queue in-process by default; do not
+set `SOLID_QUEUE_IN_PUMA=false` unless you deploy a separate worker. The proxy
+terminates TLS and forwards requests to Thruster on port 80. Do not deploy this
+single-volume configuration across multiple hosts. Keep the secret key stable
+across deploys so existing signed sessions and data remain usable.
diff --git a/script/check_single_server_deploy.sh b/script/check_single_server_deploy.sh
new file mode 100755
index 0000000..8fff6f8
--- /dev/null
+++ b/script/check_single_server_deploy.sh
@@ -0,0 +1,26 @@
+#!/bin/bash -e
+# Smoke-check the standalone Kamal deployment without contacting a server.
+cd "$(dirname "$0")/.."
+
+bundle exec kamal config > /dev/null
+ruby -ryaml -e '
+  config = YAML.load_file("config/deploy.yml")
+  abort "Expected one web container" unless config.fetch("servers").keys == ["web"] && config.dig("servers", "web").size == 1
+  abort "Expected proxy TLS on Thruster port 80" unless config.dig("proxy", "ssl") && config.dig("proxy", "app_port") == 80
+  abort "Expected persistent storage" unless config.fetch("volumes").include?("fizzy_storage:/rails/storage")
+  abort "Proxy and app hosts differ" unless config.dig("proxy", "host") == config.dig("env", "clear", "APP_HOST")
+  abort "Secrets may enter Docker build" unless File.read(".dockerignore").include?("/.kamal/")
+'
+
+RAILS_ENV=production SECRET_KEY_BASE=test APP_HOST=example.com SMTP_ADDRESS=smtp.example.com SMTP_USERNAME=user SMTP_PASSWORD=password \
+  bundle exec rails runner '
+    abort "Email URLs must use HTTPS" unless Rails.application.config.action_mailer.default_url_options == { host: "example.com", protocol: "https" }
+    abort "Job URLs must use HTTPS" unless Rails.application.routes.default_url_options == { host: "example.com", protocol: "https" }
+    settings = Rails.application.config.action_mailer.smtp_settings
+    abort "SMTP auth not configured" unless settings[:address] == "smtp.example.com" && settings[:authentication] == :plain && settings[:password] == "password"
+  '
+
+RAILS_ENV=production SECRET_KEY_BASE=test APP_HOST=example.com SMTP_ADDRESS=smtp.example.com SMTP_USERNAME= SMTP_PASSWORD= \
+  bundle exec rails runner 'abort "Unauthenticated SMTP not supported" unless Rails.application.config.action_mailer.smtp_settings[:authentication].nil?'
+
+echo 'Single-server deployment configuration OK'
