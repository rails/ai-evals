diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..db05ae4
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Search" %>
+<% content_for :header do %>
+  <h1 class="header__title">Search</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards", aria: { label: "Search cards" } %>
+    <%= form.submit "Search" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% @cards.each do |card| %>
+      <article class="search-result">
+        <h2><%= link_to marked_search_text(card.title, @query), card_path(card) %></h2>
+        <% if card.description.present? && card.description.to_plain_text.match?(/#{Regexp.escape(@query)}/i) %>
+          <p><%= marked_search_text(card.description.to_plain_text, @query) %></p>
+        <% end %>
+        <% card.comments.each do |comment| %>
+          <% if comment.body.present? && comment.body.to_plain_text.match?(/#{Regexp.escape(@query)}/i) %>
+            <p><%= marked_search_text(comment.body.to_plain_text, @query) %></p>
+          <% end %>
+        <% end %>
+      </article>
+    <% end %>
+    <% if @cards.empty? %><p>No cards found</p><% end %>
+  <% end %>
+</section>
