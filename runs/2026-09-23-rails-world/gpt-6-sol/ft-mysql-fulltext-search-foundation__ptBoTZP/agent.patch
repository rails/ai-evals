@@ -0,0 +1,11 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = if @query.present?
+      Current.user.accessible_cards.published.matching_text(@query).reverse_chronologically
+        .preload(:rich_text_description, comments: :rich_text_body)
+    else
+      Card.none
+    end
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..6d92bd4
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,6 @@
+module SearchesHelper
+  def marked_search_text(text, query)
+    parts = text.to_s.split(/(#{Regexp.escape(query)})/i)
+    safe_join(parts.map { |part| part.casecmp?(query) ? content_tag(:mark, part) : ERB::Util.html_escape(part) })
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..003d1ef 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -19,6 +19,24 @@ class Card < ApplicationRecord
   after_touch  -> { board.touch }, if: :published?
   after_update :handle_board_change, if: :saved_change_to_board_id?
 
+  scope :matching_text, ->(query) do
+    term = "%#{query.downcase.gsub('!', '!!').gsub('%', '!%').gsub('_', '!_')}%"
+    where(<<~SQL, term: term)
+      LOWER(cards.title) LIKE :term ESCAPE '!'
+      OR EXISTS (
+        SELECT 1 FROM action_text_rich_texts descriptions
+        WHERE descriptions.record_type = 'Card' AND descriptions.record_id = cards.id
+          AND descriptions.name = 'description' AND LOWER(descriptions.body) LIKE :term ESCAPE '!'
+      )
+      OR EXISTS (
+        SELECT 1 FROM comments
+        INNER JOIN action_text_rich_texts bodies
+          ON bodies.record_type = 'Comment' AND bodies.record_id = comments.id AND bodies.name = 'body'
+        WHERE comments.card_id = cards.id AND LOWER(bodies.body) LIKE :term ESCAPE '!'
+      )
+    SQL
+  end
+
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
