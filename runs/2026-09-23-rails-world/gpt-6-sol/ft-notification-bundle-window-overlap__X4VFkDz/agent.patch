diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..7f6d4d1
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,34 @@
+class Notification::EmailBundle < ApplicationRecord
+  DURATIONS = { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.freeze
+
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, foreign_key: :email_bundle_id, dependent: :nullify
+
+  def self.collect(notification)
+    user = notification.user
+    user.with_lock do
+      if (notification.reload.email_bundle.nil? || notification.email_bundle.sent_at?) && (duration = DURATIONS[user.settings.reload.bundle_email_frequency])
+        now = Time.current
+        bundle = user.email_bundles.where(sent_at: nil).where("created_at <= ? AND ends_at > ?", notification.created_at, notification.created_at).order(:ends_at).last
+        bundle ||= user.email_bundles.where(sent_at: nil).where("ends_at > ?", now).order(:ends_at).last
+        unless bundle
+          bundle = user.email_bundles.create!(account: user.account, frequency: user.settings.bundle_email_frequency, ends_at: now + duration)
+          Notification::EmailBundle::DeliveryJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+        end
+        notification.update!(email_bundle: bundle)
+      end
+    end
+  end
+
+  def deliver
+    with_lock do
+      if sent_at.nil? && Time.current >= ends_at
+        if notifications.exists? && user.active? && account.active? && user.settings.bundle_email_frequency != "never" && user.identity
+          Notification::EmailBundleMailer.digest(self).deliver_now
+        end
+        update!(sent_at: Time.current)
+      end
+    end
+  end
+end
