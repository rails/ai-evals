diff --git a/test/controllers/sessions/email_codes_controller_test.rb b/test/controllers/sessions/email_codes_controller_test.rb
new file mode 100644
index 0000000..50ab5e7
--- /dev/null
+++ b/test/controllers/sessions/email_codes_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "signs in with a six-character emailed code" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      assert_redirected_to new_session_email_code_path
+
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      assert code
+      post session_email_code_path, params: { code: "WRONG1" }
+      assert_redirected_to new_session_email_code_path
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_email_code_path
+    end
+  end
+
+  test "requesting another code replaces the previous one" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      old_code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      new_code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      post session_email_code_path, params: { code: old_code }
+      assert_not_equal old_code, new_code
+      assert_redirected_to new_session_email_code_path
+      post session_email_code_path, params: { code: new_code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "code expires after fifteen minutes" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      travel 15.minutes do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "signs up after verifying email" do
+    untenanted do
+      perform_enqueued_jobs do
+        post signup_path, params: { signup: { email_address: "newperson@example.com" } }
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_nil Identity.find_by(email_address: "newperson@example.com")
+      post session_email_code_path, params: { code: ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/] }
+      assert_redirected_to new_signup_completion_path
+      assert Identity.find_by(email_address: "newperson@example.com")
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      assert_response :redirect
+    end
+  end
+
+  test "joining as another identity requires the emailed code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    sign_in_as :kevin
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "switch@example.com" }
+    end
+    assert_redirected_to new_session_email_code_path(script_name: nil)
+    post "/session/email_code", params: { code: ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/] }
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert account.users.joins(:identity).exists?(identities: { email_address: "switch@example.com" })
+  end
+
+  test "an expired join invitation cannot be redeemed with an email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "late@example.com" }
+    end
+    code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    join_code.update!(usage_count: join_code.usage_limit)
+    assert_no_difference -> { User.count } do
+      post "/session/email_code", params: { code: code }
+    end
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "joins after verifying email" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joiner@example.com" }
+    end
+    assert_redirected_to new_session_email_code_path(script_name: nil)
+    untenanted do
+      post "/session/email_code", params: { code: ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/] }
+    end
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert account.users.joins(:identity).exists?(identities: { email_address: "joiner@example.com" })
+  end
+end
