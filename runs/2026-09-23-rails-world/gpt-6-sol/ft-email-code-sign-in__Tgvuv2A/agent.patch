@@ -0,0 +1,22 @@
+module EmailCodeChallenge
+  extend ActiveSupport::Concern
+
+  EXPIRY = 15.minutes
+  ALPHABET = ("A".."Z").to_a + ("0".."9").to_a
+
+  private
+    def send_email_code(email_address, purpose:, join_code_id: nil)
+      code = loop do
+        candidate = Array.new(6) { ALPHABET[SecureRandom.random_number(ALPHABET.length)] }.join
+        break candidate unless Digest::SHA256.hexdigest(candidate) == session.dig(:email_code_challenge, "digest")
+      end
+      session[:email_code_challenge] = {
+        "email_address" => email_address,
+        "purpose" => purpose,
+        "join_code_id" => join_code_id,
+        "digest" => Digest::SHA256.hexdigest(code),
+        "expires_at" => EXPIRY.from_now.to_i
+      }
+      IdentityMailer.authentication_code(email_address, code).deliver_later
+    end
+end
