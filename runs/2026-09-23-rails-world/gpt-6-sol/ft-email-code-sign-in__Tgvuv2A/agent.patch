diff --git a/app/controllers/sessions/email_codes_controller.rb b/app/controllers/sessions/email_codes_controller.rb
new file mode 100644
index 0000000..c19c611
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,82 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def new
+    if challenge = session[:email_code_challenge]
+      @email_address = challenge["email_address"]
+    else
+      redirect_to new_session_path
+    end
+  end
+
+  def create
+    challenge = session[:email_code_challenge]
+    submitted = params[:code].to_s.strip.upcase
+
+    if challenge && challenge["expires_at"].to_i > Time.current.to_i && submitted.match?(/\A[A-Z0-9]{6}\z/) &&
+        ActiveSupport::SecurityUtils.secure_compare(challenge["digest"], Digest::SHA256.hexdigest(submitted))
+      session.delete(:email_code_challenge)
+      complete_challenge(challenge)
+    else
+      if challenge && challenge["expires_at"].to_i <= Time.current.to_i
+        session.delete(:email_code_challenge)
+        redirect_to retry_path(challenge), alert: "That code expired. Please request a new one."
+      else
+        redirect_to new_session_email_code_path, alert: "That code didn't work. Please try again."
+      end
+    end
+  end
+
+  private
+    def retry_path(challenge)
+      case challenge["purpose"]
+      when "signup" then new_signup_path
+      when "join"
+        if join_code = Account::JoinCode.find_by(id: challenge["join_code_id"])
+          join_path(code: join_code.code, script_name: join_code.account.slug)
+        else
+          new_session_path
+        end
+      else new_session_path
+      end
+    end
+
+    def complete_challenge(challenge)
+      case challenge["purpose"]
+      when "signin"
+        if identity = Identity.find_by(email_address: challenge["email_address"])
+          start_new_session_for identity
+          redirect_to after_authentication_url
+        else
+          redirect_to new_session_path, alert: "That email address doesn't have an account."
+        end
+      when "signup"
+        identity = Signup.new(email_address: challenge["email_address"]).create_identity
+        start_new_session_for identity
+        redirect_to new_signup_completion_path
+      when "join"
+        join_code = Account::JoinCode.find_by(id: challenge["join_code_id"])
+        if join_code&.active?
+          identity = Identity.find_or_create_by!(email_address: challenge["email_address"])
+          join_code.redeem_if { |account| identity.join(account) }
+          if user = User.active.find_by(account: join_code.account, identity: identity)
+            start_new_session_for identity
+          else
+            redirect_to new_session_path, alert: "That join code is no longer available."
+            return
+          end
+          if user.setup?
+            redirect_to landing_url(script_name: join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: join_code.account.slug)
+          end
+        else
+          redirect_to new_session_path, alert: "That join code is no longer available."
+        end
+      end
+    end
+end
