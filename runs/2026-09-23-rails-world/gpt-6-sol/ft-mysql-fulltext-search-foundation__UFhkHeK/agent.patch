diff --git a/app/views/search/show.html.erb b/app/views/search/show.html.erb
new file mode 100644
index 0000000..6c7905c
--- /dev/null
+++ b/app/views/search/show.html.erb
@@ -0,0 +1,32 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="container">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards", autofocus: true, aria: { label: "Search cards" } %>
+    <%= form.submit "Search" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <ul>
+        <% @cards.each do |card| %>
+          <li>
+            <%= link_to card_path(card) do %>
+              <%= marked_matches(card.title, @query) %>
+            <% end %>
+            <span><%= card.board.name %></span>
+            <% if excerpt = search_excerpt(card, @query) %>
+              <p><%= marked_matches(excerpt, @query) %></p>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <p>No cards found.</p>
+    <% end %>
+  <% end %>
+</section>
