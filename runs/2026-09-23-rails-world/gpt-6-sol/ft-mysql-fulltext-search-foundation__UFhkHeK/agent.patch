@@ -0,0 +1,11 @@
+class SearchController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip.first(200)
+    @cards = if @query.present?
+      Current.user.accessible_cards.where(account: Current.account).published.search(@query).reverse_chronologically
+        .preload(:board, :rich_text_description, comments: :rich_text_body)
+    else
+      Card.none
+    end
+  end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..3f0f498
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,15 @@
+module SearchHelper
+  def marked_matches(text, query)
+    parts = text.to_s.split(/(#{Regexp.escape(query)})/i)
+    safe_join(parts.map { |part| part.casecmp?(query) ? tag.mark(part) : part })
+  end
+
+  def search_excerpt(card, query)
+    texts = [ card.description&.to_plain_text, *card.comments.map { |comment| comment.body&.to_plain_text } ]
+    match = texts.compact.find { |text| text.match?(/#{Regexp.escape(query)}/i) }
+    if match
+      index = match.downcase.index(query.downcase)
+      format_excerpt(match[[ index - 60, 0 ].max, 200])
+    end
+  end
+end
