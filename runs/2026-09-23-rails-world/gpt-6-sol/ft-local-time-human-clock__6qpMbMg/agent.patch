diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..d763c87
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,14 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "client time renders only a machine-readable timestamp" do
+    timestamp = Time.utc(2025, 9, 12, 13, 42)
+
+    html = client_time_tag(timestamp, format: :relative)
+
+    assert_includes html, 'datetime="2025-09-12T13:42:00Z"'
+    assert_includes html, 'data-controller="local-time"'
+    assert_includes html, 'data-local-time-format-value="relative"'
+    assert_no_match(/ago|Sep 12|1:42/, html)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..44ed0b6
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,42 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "relative dates follow the viewer's calendar day" do
+    visit root_path
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+
+    results = page.driver.browser.execute_async_script <<~JS
+      const done = arguments[0]
+      import("helpers/local_time").then(({ formatLocalTime }) => {
+        const now = new Date("2025-03-10T07:30:00Z") // March 10, 12:30 AM in LA
+        done([
+          formatLocalTime("2025-03-10T06:30:00Z", "relative", now), // yesterday, one hour ago
+          formatLocalTime("2025-03-11T07:00:00Z", "relative", now), // tomorrow
+          formatLocalTime("2025-03-05T12:00:00Z", "relative", now),
+          formatLocalTime("2025-03-13T12:00:00Z", "relative", now),
+          formatLocalTime("2025-02-20T12:00:00Z", "relative", now),
+          formatLocalTime("2025-03-10T20:42:00Z", "relative", now),
+          formatLocalTime("2025-01-01T07:30:00Z", "relative", new Date("2025-01-01T08:30:00Z")),
+          formatLocalTime("2024-09-12T20:42:00Z", "relative", now)
+        ])
+      }).catch(error => done(error.message))
+    JS
+
+    assert_equal [ "yesterday", "tomorrow", "5 days ago", "in 3 days", "Feb 20", "1:42 PM", "yesterday", "Sep 12, 2024" ], results
+  end
+
+  test "time elements render from raw timestamps" do
+    visit root_path
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+
+    page.execute_script <<~JS
+      const time = document.createElement("time")
+      time.dateTime = "2025-09-12T20:42:00Z"
+      time.dataset.controller = "local-time"
+      time.dataset.localTimeFormatValue = "time"
+      document.body.append(time)
+    JS
+
+    assert_selector "time[data-controller='local-time']", text: "1:42 PM"
+  end
+end
