diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..8931154
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+
+// A <time datetime="…"> carries an instant, never a server-local display string.
+export default class extends Controller {
+  connect() {
+    this.render()
+    this.timer = setInterval(() => this.render(), 60_000)
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const date = new Date(this.element.dateTime)
+    if (Number.isNaN(date.getTime())) return
+
+    const now = new Date()
+    const mode = this.element.dataset.localTimeModeValue || "relative"
+    this.element.textContent = formatTime(date, now, mode)
+    this.element.title = date.toLocaleString()
+  }
+}
+
+function calendarDay(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / 86_400_000
+}
+
+export function formatTime(date, now, mode) {
+  const days = calendarDay(date) - calendarDay(now)
+  const clock = () => date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })
+  const shortDate = () => date.toLocaleDateString("en-US", { month: "short", day: "numeric" })
+
+  if (mode === "clock") return clock()
+  if (mode === "date") return shortDate()
+  if (mode === "long-date") return date.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" })
+  if (mode === "full") return `${date.toLocaleDateString("en-US", { month: "numeric", day: "numeric", year: "2-digit" })}, ${clock()}`
+  if (mode === "stamp") return date.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
+
+  if (days === 0) return clock()
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days < 0 && days >= -6) return `${-days} days ago`
+  if (days > 0 && days <= 6) return `in ${days} days`
+  return date.getFullYear() === now.getFullYear() ? shortDate() : date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
+}
