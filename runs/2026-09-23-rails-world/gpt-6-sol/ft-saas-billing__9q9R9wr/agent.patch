diff --git a/saas/test/controllers/stripe_webhooks_test.rb b/saas/test/controllers/stripe_webhooks_test.rb
new file mode 100644
index 0000000..de6aa21
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+require "openssl"
+
+class StripeWebhooksTest < ActionDispatch::IntegrationTest
+  test "rejects unsigned deliveries" do
+    with_secret do
+      untenanted do
+        post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: "{}", headers: { "Content-Type" => "application/json" }
+        assert_response :bad_request
+      end
+    end
+  end
+
+  test "subscription events activate, change and cancel plans without a Stripe request" do
+    account = accounts(:initech)
+    with_secret do
+      deliver(subscription_event(account, "unlimited", 100, "active"))
+      assert_equal "unlimited", account.reload.plan_key
+      assert_equal 5.gigabytes, account.storage_limit
+      deliver(subscription_event(account, "unlimited_plus", 200, "active"))
+      assert_equal 500.gigabytes, account.reload.storage_limit
+      deliver(subscription_event(account, "unlimited", 100, "active"))
+      assert_equal "unlimited_plus", account.reload.plan_key
+      deliver(subscription_event(account, "unlimited_plus", 300, "canceled", "customer.subscription.deleted"))
+      assert_equal "free", account.reload.plan_key
+    end
+  end
+
+  private
+    def with_secret(&block)
+      old = ENV.to_h.slice("STRIPE_WEBHOOK_SECRET", "STRIPE_UNLIMITED_PRICE_ID", "STRIPE_UNLIMITED_PLUS_PRICE_ID")
+      ENV.update("STRIPE_WEBHOOK_SECRET" => "whsec_test", "STRIPE_UNLIMITED_PRICE_ID" => "price_20", "STRIPE_UNLIMITED_PLUS_PRICE_ID" => "price_25")
+      block.call
+    ensure
+      %w[ STRIPE_WEBHOOK_SECRET STRIPE_UNLIMITED_PRICE_ID STRIPE_UNLIMITED_PLUS_PRICE_ID ].each { |key| old.key?(key) ? ENV[key] = old[key] : ENV.delete(key) }
+    end
+
+    def deliver(event)
+      payload = event.to_json
+      time = Time.now.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", ENV.fetch("STRIPE_WEBHOOK_SECRET"), "#{time}.#{payload}")
+      untenanted do
+        post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: payload, headers: { "Content-Type" => "application/json", "Stripe-Signature" => "t=#{time},v1=#{signature}" }
+        assert_response :ok
+      end
+    end
+
+    def subscription_event(account, plan, timestamp, status, type = "customer.subscription.updated")
+      { id: "evt_#{timestamp}", object: "event", type: type, created: timestamp,
+        data: { object: { id: "sub_test", object: "subscription", customer: "cus_test", status: status,
+          metadata: { account_id: account.id }, items: { data: [ { price: { id: plan == "unlimited" ? "price_20" : "price_25" } } ] } } } }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..3c2d782
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  test "free accounts can publish 999 cards but not 1000" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 999)
+    assert_not account.exceeding_card_limit?
+    assert_equal 1, account.cards_left
+    account.update_column(:cards_count, 1000)
+    assert account.exceeding_card_limit?
+    assert_equal 0, account.cards_left
+  end
+
+  test "paid plans have their own storage limits and unlimited cards" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 2000)
+    account.create_billing_subscription!(stripe_customer_id: "cus_test", plan_key: "unlimited", status: "active")
+    assert_not account.exceeding_card_limit?
+    assert_equal 5.gigabytes, account.storage_limit
+    account.billing_subscription.update!(plan_key: "unlimited_plus")
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+end
