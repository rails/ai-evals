diff --git a/saas/test/controllers/billing_test.rb b/saas/test/controllers/billing_test.rb
new file mode 100644
index 0000000..e2c86e1
--- /dev/null
+++ b/saas/test/controllers/billing_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class BillingTest < ActionDispatch::IntegrationTest
+  test "staff can comp and override then reset an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a", text: account.name
+      get saas.admin_account_path(account)
+      assert_response :success
+      post saas.admin_account_comp_path(account)
+      assert account.reload.comped?
+      post saas.admin_account_override_path(account), params: { override: { card_count: 1000, bytes_used: 1234 } }
+      assert_equal 1000, account.reload.card_count_for_billing
+      assert_equal 1234, account.bytes_used_for_billing
+      delete saas.admin_account_override_path(account)
+      assert_nil account.reload.overridden_limit
+      delete saas.admin_account_comp_path(account)
+      assert_not account.reload.comped?
+    end
+  end
+
+  test "non staff cannot use support tools" do
+    sign_in_as :jz
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+    end
+  end
+
+  test "admin sees upgrade and checkout requires configured price" do
+    sign_in_as :mike
+    get account_settings_path(script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    post saas.billing_checkout_path(script_name: accounts(:initech).slug), params: { plan: "unlimited" }
+    assert_response :unprocessable_entity unless ENV["STRIPE_UNLIMITED_PRICE_ID"].present?
+  end
+
+  test "free account at 1000 cards can draft but cannot publish or create through the API" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.update_column(:cards_count, 1000)
+    board = boards(:miltons_wish_list)
+    get account_settings_path(script_name: account.slug)
+    assert_response :success
+
+    assert_no_difference -> { Card.published.count } do
+      post board_cards_path(board, script_name: account.slug), params: { card: { title: "Not published" } }, as: :json
+    end
+    assert_response :forbidden
+
+    board.cards.drafted.where(creator: users(:mike)).destroy_all
+    post board_cards_path(board, script_name: account.slug)
+    assert_response :redirect
+    assert Card.last.drafted?
+    post card_publish_path(Card.last, script_name: account.slug)
+    assert_response :forbidden
+  end
+
+  test "checkout uses Stripe hosted session and portal reuses its customer" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    old = ENV["STRIPE_UNLIMITED_PRICE_ID"]
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_20"
+    Stripe::Checkout::Session.expects(:create).with(has_entries(mode: "subscription", client_reference_id: account.id,
+      line_items: [ { price: "price_20", quantity: 1 } ])).returns(stub(url: "https://checkout.stripe.com/test"))
+    post saas.billing_checkout_path(script_name: account.slug), params: { plan: "unlimited" }
+    assert_redirected_to "https://checkout.stripe.com/test"
+
+    account.create_billing_subscription!(stripe_customer_id: "cus_test", plan_key: "unlimited", status: "active")
+    Stripe::BillingPortal::Session.expects(:create).with(has_entries(customer: "cus_test")).returns(stub(url: "https://billing.stripe.com/test"))
+    post saas.billing_portal_path(script_name: account.slug)
+    assert_redirected_to "https://billing.stripe.com/test"
+  ensure
