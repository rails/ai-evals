+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,25 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+  end
+
+  def create
+    price = { "unlimited" => ENV["STRIPE_UNLIMITED_PRICE_ID"], "unlimited_plus" => ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] }.fetch(params[:plan], nil)
+    if price.blank?
+      head :unprocessable_entity
+    else
+      options = {
+        mode: "subscription", line_items: [ { price: price, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        subscription_data: { metadata: { account_id: Current.account.id } },
+        success_url: account_settings_url, cancel_url: saas.new_billing_checkout_url
+      }
+      if customer = Current.account.billing_subscription&.stripe_customer_id
+        options[:customer] = customer
+      end
+      session = ::Stripe::Checkout::Session.create(options)
+      redirect_to session.url, allow_other_host: true
+    end
+  end
+end
