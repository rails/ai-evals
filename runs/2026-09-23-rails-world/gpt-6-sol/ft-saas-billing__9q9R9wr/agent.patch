+<% @page_title = @account.name %>
+<% content_for :header do %><h1 class="header__title"><%= @account.name %></h1><% end %>
+<section class="settings"><div class="settings__panel panel shadow">
+  <p>Plan: <%= @account.plan_name %> · Cards: <%= @account.card_count_for_billing %> · Bytes used: <%= @account.bytes_used_for_billing %></p>
+  <% if @account.comped? %>
+    <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete %>
+  <% else %>
+    <%= button_to "Comp", saas.admin_account_comp_path(@account) %>
+  <% end %>
+  <%= form_with url: saas.admin_account_override_path(@account), scope: :override do |form| %>
+    <%= form.label :card_count, "Card count" %>
+    <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0 %>
+    <%= form.label :bytes_used, "Bytes used" %>
+    <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0 %>
+    <%= form.submit "Override" %>
+  <% end %>
+  <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete %>
+</div></section>
