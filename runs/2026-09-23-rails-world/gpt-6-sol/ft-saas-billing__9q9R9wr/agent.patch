diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..0028bce
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,16 @@
+class Stripe::WebhooksController < ActionController::API
+  def create
+    event = ::Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+
+    case event.type
+    when "checkout.session.completed"
+      Account::BillingSubscription.record_checkout(event.data.object)
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+      Account::BillingSubscription.record_subscription(event.data.object, event_time: Time.at(event.created))
+    end
+
+    head :ok
+  rescue ::Stripe::SignatureVerificationError, JSON::ParserError, KeyError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..cf84fb9
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,47 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT = 1000
+
+  included do
+    has_one :billing_subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+  end
+
+  def plan_key
+    if billing_waiver || billing_subscription&.paid?
+      billing_subscription&.paid? ? billing_subscription.plan_key : "unlimited"
+    else
+      "free"
+    end
+  end
+
+  def plan_name
+    { "free" => "Free", "unlimited" => "Unlimited", "unlimited_plus" => "Unlimited+" }.fetch(plan_key)
+  end
+
+  def card_count_for_billing
+    overridden_limit&.card_count || cards_count
+  end
+
+  def bytes_used_for_billing
+    overridden_limit&.bytes_used || bytes_used
+  end
+
+  def cards_left
+    [ CARD_LIMIT - card_count_for_billing, 0 ].max
+  end
+
+  def nearing_card_limit?
+    plan_key == "free" && cards_left.between?(1, 100)
+  end
+
+  def exceeding_card_limit?
+    plan_key == "free" && cards_left.zero?
+  end
+
+  def exceeding_publication_limit?
+    exceeding_card_limit? || exceeding_storage_limit?
+  end
+end
diff --git a/saas/app/models/account/billing_subscription.rb b/saas/app/models/account/billing_subscription.rb
new file mode 100644
index 0000000..90a2ca8
--- /dev/null
+++ b/saas/app/models/account/billing_subscription.rb
@@ -0,0 +1,36 @@
+class Account::BillingSubscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+
+  def paid?
+    status.in?(%w[ active trialing ]) && plan_key.in?(%w[ unlimited unlimited_plus ])
+  end
+
+  def self.record_checkout(session)
+    return unless session.mode == "subscription"
+
+    account = Account.find_by(id: session.client_reference_id)
+    return unless account && session.customer.present?
+
+    record = find_or_initialize_by(account: account)
+    if record.stripe_customer_id.blank? || record.stripe_customer_id == session.customer
+      record.update!(stripe_customer_id: session.customer, stripe_subscription_id: record.stripe_subscription_id || session.subscription)
+    end
+  end
+
+  def self.record_subscription(subscription, event_time:)
+    record = find_by(stripe_customer_id: subscription.customer)
+    unless record
+      account = Account.find_by(id: subscription.metadata&.[]("account_id"))
+      record = find_or_initialize_by(account: account) if account && !exists?(account: account)
+    end
+    return unless record && (record.last_event_at.nil? || event_time >= record.last_event_at)
+    return if record.stripe_customer_id.present? && record.stripe_customer_id != subscription.customer
+
+    price = subscription.items&.data&.first&.price&.id
+    plan = { ENV["STRIPE_UNLIMITED_PRICE_ID"] => "unlimited", ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] => "unlimited_plus" }.fetch(price, nil) if price.present?
+    record.update!(stripe_customer_id: subscription.customer, stripe_subscription_id: subscription.id,
+      plan_key: plan, status: subscription.status, last_event_at: event_time)
+  end
+end
