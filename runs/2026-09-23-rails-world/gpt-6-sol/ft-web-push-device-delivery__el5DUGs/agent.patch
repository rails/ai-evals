--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,27 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    subscription = User::PushSubscription.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+
+    if subscription.update(**subscription_params.to_h.symbolize_keys, user: Current.user)
+      render json: { id: subscription.id }
+    else
+      render json: { errors: subscription.errors.full_messages }, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless params[:user_id] == Current.user.id
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..c82a3cb
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,82 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle", "help", "status" ]
+  static values = { publicKey: String, url: String }
+
+  async connect() {
+    if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
+      this.toggleTarget.disabled = true
+      this.statusTarget.textContent = "Push notifications aren't supported on this device."
+      return
+    }
+
+    this.registration = await navigator.serviceWorker.ready
+    const subscription = await this.registration.pushManager.getSubscription()
+    if (subscription) {
+      try {
+        await this.save(subscription)
+        this.toggleTarget.checked = true
+      } catch (error) {
+        this.statusTarget.textContent = "Could not connect notifications. Please try again."
+      }
+    }
+    this.showHelp()
+  }
+
+  async change() {
+    this.toggleTarget.disabled = true
+    try {
+      if (this.toggleTarget.checked) {
+        const permission = await Notification.requestPermission()
+        if (permission !== "granted") {
+          this.toggleTarget.checked = false
+        } else {
+          const subscription = await this.registration.pushManager.subscribe({
+            userVisibleOnly: true,
+            applicationServerKey: this.decodeKey(this.publicKeyValue)
+          })
+          await this.save(subscription)
+        }
+      } else {
+        const subscription = await this.registration.pushManager.getSubscription()
+        if (this.subscriptionId) await this.request(`${this.urlValue}/${this.subscriptionId}`, "DELETE")
+        if (subscription) await subscription.unsubscribe()
+        this.subscriptionId = null
+      }
+    } catch (error) {
+      this.toggleTarget.checked = !this.toggleTarget.checked
+      this.statusTarget.textContent = "Could not update notifications. Please try again."
+    } finally {
+      this.toggleTarget.disabled = false
+      this.showHelp()
+    }
+  }
+
+  async save(subscription) {
+    const keys = subscription.toJSON().keys
+    const response = await this.request(this.urlValue, "POST", {
+      push_subscription: { endpoint: subscription.endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+    })
+    this.subscriptionId = (await response.json()).id
+  }
+
+  async request(url, method, body) {
+    const response = await fetch(url, {
+      method,
+      headers: { "Content-Type": "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
+      body: body && JSON.stringify(body)
+    })
+    if (!response.ok) throw new Error(`Push subscription request failed: ${response.status}`)
+    return response
+  }
+
+  decodeKey(key) {
+    const base64 = key.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")), character => character.charCodeAt(0))
+  }
+
+  showHelp() {
+    this.element.classList.toggle("notifications--on", this.toggleTarget.checked)\n    this.helpTarget.hidden = Notification.permission !== "denied"
+  }
+}
