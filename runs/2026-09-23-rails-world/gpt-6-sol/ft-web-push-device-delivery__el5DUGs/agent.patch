+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = { endpoint: "https://push.example.com/123", p256dh_key: "public", auth_key: "secret" }
+  end
+
+  test "registers and removes a device" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }
+    end
+    assert_response :success
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }
+    end
+
+    delete user_push_subscription_path(@user, @user.push_subscriptions.last)
+    assert_response :no_content
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "rejects invalid subscription data" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(endpoint: "http://insecure.example.com") }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "registration transfers a shared browser away from its previous user" do
+    previous = users(:kevin).push_subscriptions.create!(@subscription)
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }
+
+    assert_response :success
+    assert_equal @user, previous.reload.user
+  end
+
+  test "cannot delete another user's subscription" do
+    subscription = users(:kevin).push_subscriptions.create!(@subscription)
+
+    delete user_push_subscription_path(@user, subscription)
+
+    assert_response :not_found
+    assert subscription.reload.persisted?
+  end
+
+  test "cannot manage another user's devices" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/notification/push_delivery_test.rb b/test/models/notification/push_delivery_test.rb
new file mode 100644
index 0000000..0dd377d
--- /dev/null
+++ b/test/models/notification/push_delivery_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Notification::PushDeliveryTest < ActiveSupport::TestCase
+  test "sends tray content and account-scoped card URL to each device" do
+    notification = notifications(:layout_commented_kevin)
+    user = notification.user
+    user.push_subscriptions.create!(endpoint: "https://push.example.com/1", p256dh_key: "public", auth_key: "secret")
+    user.push_subscriptions.create!(endpoint: "https://push.example.com/2", p256dh_key: "public", auth_key: "secret")
+
+    original = ENV.to_hash.slice("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+    ENV["VAPID_PUBLIC_KEY"] = "public"
+    ENV["VAPID_PRIVATE_KEY"] = "private"
+    WebPush.expects(:payload_send).twice
+    notification.deliver_push
+    payload = notification.send(:push_payload)
+    assert_equal "RE: #{notification.card.title}", payload[:title]
+    assert_includes payload[:url], "#{user.account.slug}/cards/#{notification.card.number}"
+  ensure
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+    ENV.update(original)
+  end
+
+  test "creating a tray notification enqueues push but reading it does not" do
+    user = users(:kevin)
+    user.push_subscriptions.create!(endpoint: "https://push.example.com/1", p256dh_key: "public", auth_key: "secret")
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_with job: Notification::DeliverPushJob do
+      Notification.create!(user: user, source: events(:layout_commented), creator: users(:david))
+    end
+
+    notification = user.notifications.find_by!(source: events(:layout_commented))
+    assert_no_enqueued_jobs only: Notification::DeliverPushJob do
+      notification.read
+    end
+  end
+
+  test "expired endpoints are removed" do
+    subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/expired", p256dh_key: "public", auth_key: "secret")
+    response = Struct.new(:body).new("expired")
+    ENV["VAPID_PUBLIC_KEY"] = "public"
+    ENV["VAPID_PRIVATE_KEY"] = "private"
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+    assert_difference -> { User::PushSubscription.count }, -1 do
+      subscription.deliver("test")
+    end
+  ensure
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+end
