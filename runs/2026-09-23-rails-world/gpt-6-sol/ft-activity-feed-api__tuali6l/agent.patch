diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..d1294a5
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "returns accessible activity in newest-first order with API resources" do
+    get activities_path, as: :json
+
+    assert_response :success
+    activities = response.parsed_body
+    assert_kind_of Array, activities
+    assert_equal activities.map { |event| event["created_at"] }.sort.reverse, activities.map { |event| event["created_at"] }
+    assert activities.any? { |event| event["action"] == "comment_created" }
+    assert activities.all? { |event| event.keys.sort == %w[action board created_at creator description eventable eventable_type id particulars url] }
+
+    comment = activities.find { |event| event["id"] == events(:layout_commented).id }
+    assert_equal card_url(cards(:layout), anchor: "comment_#{comments(:layout_overflowing_david).id}"), comment["url"]
+    assert_equal comments(:layout_overflowing_david).id, comment.dig("eventable", "id")
+    assert_equal boards(:writebook).id, comment.dig("board", "id")
+    assert_equal users(:david).id, comment.dig("creator", "id")
+  end
+  test "exposes action-specific particulars and plain-text descriptions" do
+    card = cards(:layout)
+    assignment = events(:layout_assignment_jz)
+    assignment.update!(particulars: { assignee_ids: [ users(:jz).id ] })
+    title = events(:layout_published)
+    title.update!(action: "card_title_changed", particulars: { particulars: { old_title: "Old & title", new_title: nil } })
+    board_change = events(:text_published)
+    board_change.update!(action: "card_board_changed", particulars: { particulars: { old_board: nil, new_board: "Writebook" } })
+    triage = events(:shipping_published)
+    triage.update!(action: "card_triaged", particulars: { particulars: { column: nil } })
+    deprecated = events(:shipping_closed)
+    deprecated.update!(action: "card_collection_changed")
+
+    get activities_path, as: :json
+    assert_response :success
+    by_id = response.parsed_body.index_by { |event| event["id"] }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id.fetch(assignment.id)["particulars"])
+    assert_equal({ "old_title" => "Old & title", "new_title" => "" }, by_id.fetch(title.id)["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "Writebook" }, by_id.fetch(board_change.id)["particulars"])
+    assert_equal({ "column" => "" }, by_id.fetch(triage.id)["particulars"])
+    assert_equal({}, by_id.fetch(events(:layout_commented).id)["particulars"])
+    assert_nil by_id[deprecated.id]
+    assert_equal card_url(card), by_id.fetch(title.id)["url"]
+    assert_includes by_id.fetch(title.id)["description"], card.title
+    assert_not_includes by_id.fetch(title.id)["description"], "&amp;"
+  end
+
+  test "filters by creator and accessible board" do
+    sign_in_as :david
+    get activities_path, params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+    assert_response :success
+    assert response.parsed_body.any?
+    assert response.parsed_body.all? { |event| event.dig("creator", "id") == users(:kevin).id && event.dig("board", "id") == boards(:writebook).id }
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_equal [], response.parsed_body
+
+    get activities_path, as: :json
+    assert response.parsed_body.none? { |event| event.dig("board", "id") == boards(:private).id }
+  end
+
+  test "paginates activity with link headers" do
+    card = cards(:layout)
+    now = Time.current
+    110.times do |index|
+      Event.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: card.account_id,
+        board_id: card.board_id, creator_id: users(:kevin).id, eventable_type: "Card",
+        eventable_id: card.id, action: "card_closed", created_at: now + index.seconds,
+        updated_at: now + index.seconds, particulars: {} } ])
+    end
+
+    expected_ids = Event.where(board_id: card.board_id, action: Event::ACTIVITY_ACTIONS).order(created_at: :desc, id: :desc).pluck(:id)
+    ids = []
+    next_page = activities_path(format: :json, board_ids: [ card.board_id ])
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      ids.concat response.parsed_body.map { |event| event["id"] }
+      next_page = next_page_from_link_header(response.headers["Link"])
+    end
+    assert_equal expected_ids, ids
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
