+class ActivitiesController < ApplicationController
+  def index
+    events = Current.user.accessible_events.where(action: Event::ACTIVITY_ACTIONS)
+    events = events.where(board_id: params[:board_ids]) if params[:board_ids].present?
+    events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+
+    set_page_and_extract_portion_from events.order(created_at: :desc, id: :desc).preloaded
+  end
+end
