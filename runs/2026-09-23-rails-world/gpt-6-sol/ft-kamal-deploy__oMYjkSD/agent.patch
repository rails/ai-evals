--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,37 @@
+# One-box self-hosted deployment. See docs/deployment.md before running kamal setup.
+service: fizzy
+image: your-dockerhub-user/fizzy
+
+servers:
+  web:
+    - &host fizzy.example.com
+
+proxy:
+  ssl: true
+  host: *host
+  app_port: 80 # Thruster listens on port 80 inside the container.
+
+builder:
+  arch: amd64 # Change to arm64 for an ARM server and compatible build machine.
+
+registry:
+  username: your-dockerhub-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# All four SQLite databases (primary, cable, cache, queue) and uploaded files
+# live under /rails/storage. Keep this volume when deploying new images.
+volumes:
+  - fizzy_storage:/rails/storage
+
+env:
+  clear:
+    APP_HOST: *host
+    SMTP_HOST: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-user
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    WEB_CONCURRENCY: 2
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
