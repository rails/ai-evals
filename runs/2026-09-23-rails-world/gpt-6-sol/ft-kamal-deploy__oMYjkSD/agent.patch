+# Copy to .kamal/secrets and replace these values. Never commit that file.
+# Use a Docker Hub access token with permission to push/pull your image.
+KAMAL_REGISTRY_PASSWORD=replace-with-docker-hub-access-token
+# Generate once with `bin/rails secret` (or `openssl rand -hex 64`). Keep it
+# unchanged across deploys or existing signed sessions/tokens will be invalid.
+SECRET_KEY_BASE=replace-with-a-random-secret
+SMTP_PASSWORD=replace-with-your-smtp-password
