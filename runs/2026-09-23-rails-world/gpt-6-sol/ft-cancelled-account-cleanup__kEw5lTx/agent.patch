diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..74da3ad
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveSupport::TestCase
+  test "incinerates all tenant data for accounts cancelled more than 30 days ago" do
+    due = accounts(:"37s")
+    recent = accounts(:initech)
+    identity = users(:david).identity
+    recent.users.create!(name: "David", role: :member, identity: identity)
+    filter_id = filters(:jz_assignments).id
+    database = Account.connection
+    database.execute("INSERT INTO assignees_filters (assignee_id, filter_id) VALUES (#{database.quote(users(:jz).id)}, #{database.quote(filter_id)})")
+
+    due.cancel(initiated_by: users(:david))
+    recent.cancel(initiated_by: users(:mike))
+    due.cancellation.update_column(:created_at, 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due.id)
+    assert Account.exists?(recent.id)
+    assert Identity.exists?(identity.id)
+    assert recent.users.exists?(identity: identity)
+    assert_equal 0, database.select_value("SELECT COUNT(*) FROM assignees_filters WHERE filter_id = #{database.quote(filter_id)}").to_i
+
+    database.tables.each do |table|
+      if database.columns(table).any? { |column| column.name == "account_id" }
+        assert_equal 0, database.select_value("SELECT COUNT(*) FROM #{database.quote_table_name(table)} WHERE account_id = #{database.quote(due.id)}").to_i, table
+      end
+    end
+  end
+
+  test "does not incinerate an account at the grace period boundary or after reactivation" do
+    account = accounts(:"37s")
+    travel_to Time.current.change(usec: 0) do
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update_column(:created_at, 30.days.ago)
+      Account::IncinerateDueJob.perform_now
+      assert Account.exists?(account.id)
+
+      account.reactivate
+      travel 1.day
+      Account::IncinerateDueJob.perform_now
+      assert Account.exists?(account.id)
+    end
+  end
+end
