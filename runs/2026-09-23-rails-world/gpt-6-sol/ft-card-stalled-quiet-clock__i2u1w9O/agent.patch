diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..0cfcff4
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,23 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..2.weeks.ago) }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= 2.weeks.ago
+  end
+
+  def mark_burst(at: Time.current)
+    update!(burst_at: at)
+  end
+
+  def mark_comment_burst(comment)
+    return if comment.creator.system?
+
+    window_start = comment.created_at - auto_postpone_period / 3.0
+    recent = comments.by_user.where(created_at: window_start..comment.created_at)
+    mark_burst(at: comment.created_at) if recent.count >= 3 && recent.distinct.count(:creator_id) >= 2
+  end
+end
