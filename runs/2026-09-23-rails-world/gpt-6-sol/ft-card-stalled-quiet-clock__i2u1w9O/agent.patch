diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..591875c
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "comments by two people within a third of the auto-close period create a burst" do
+    @card.comments.create!(creator: users(:david), body: "First")
+    @card.comments.create!(creator: users(:david), body: "Second")
+    assert_nil @card.reload.burst_at
+
+    @card.comments.create!(creator: users(:kevin), body: "Third")
+    assert @card.reload.burst_at
+
+    @card.update!(last_active_at: 2.weeks.ago)
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.touch_last_active_at
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "comments outside the window or by one person do not create a burst" do
+    @card.comments.create!(creator: users(:kevin), body: "Old", created_at: (@card.auto_postpone_period / 3.0 + 1.day).seconds.ago)
+    3.times { @card.comments.create!(creator: users(:david), body: "New") }
+    assert_nil @card.reload.burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    @card.comments.create!(creator: users(:david), body: "One")
+    @card.comments.create!(creator: users(:david), body: "Two")
+    @card.comments.create!(creator: @card.account.system_user, body: "System")
+    assert_nil @card.reload.burst_at
+  end
+
+  test "stalled index only includes cards with a burst and two weeks of inactivity" do
+    @card.update!(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+    assert @card.stalled?
+    assert_includes users(:david).filters.new(indexed_by: "stalled").cards, @card
+
+    @card.update!(last_active_at: 13.days.ago)
+    assert_not @card.stalled?
+    assert_not_includes users(:david).filters.new(indexed_by: "stalled").cards, @card
+  end
+
+  test "assignment and reopening create bursts" do
+    @card.toggle_assignment(users(:kevin))
+    assert @card.reload.burst_at
+
+    @card.update!(burst_at: nil)
+    @card.close
+    @card.reopen
+    assert @card.reload.burst_at
+  end
+end
