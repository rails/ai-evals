diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..9625ef7
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "lists accessible activity with API representations and comment links" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = response.parsed_body
+    assert_kind_of Array, activities
+    comment = activities.find { |activity| activity["id"] == events(:layout_commented).id }
+    assert_equal %(David commented on "#{cards(:layout).title}"), comment["description"]
+    assert_equal cards(:layout).id, comment.dig("eventable", "card", "id")
+    assert_equal card_url(cards(:layout), anchor: ActionView::RecordIdentifier.dom_id(comments(:layout_overflowing_david))), comment["url"]
+    assert_equal({}, comment["particulars"])
+    assert_equal users(:david).id, comment.dig("creator", "id")
+    assert_equal boards(:writebook).id, comment.dig("board", "id")
+    assert_equal events(:logo_assignment_jz).assignee_ids, activities.find { |activity| activity["id"] == events(:logo_assignment_jz).id }.dig("particulars", "assignee_ids")
+    assert_equal activities.map { |activity| activity["created_at"] }, activities.map { |activity| activity["created_at"] }.sort.reverse
+    assert_not_includes activities.map { |activity| activity["board"]["id"] }, boards(:private).id
+  end
+  test "event details, excluded actions, and missing fields" do
+    card = cards(:logo)
+    title = Event.create!(board: card.board, creator: users(:david), eventable: card,
+      action: "card_title_changed", particulars: { particulars: { old_title: "Old & <title>", new_title: "New title" } })
+    board_change = Event.create!(board: card.board, creator: users(:david), eventable: card,
+      action: "card_board_changed", particulars: { particulars: { old_board: nil, new_board: "Writebook" } })
+    triage = Event.create!(board: card.board, creator: users(:david), eventable: card,
+      action: "card_triaged", particulars: { particulars: { column: nil } })
+    deprecated = Event.create!(board: card.board, creator: users(:david), eventable: card,
+      action: "card_collection_changed")
+
+    get activities_path(format: :json)
+    assert_response :success
+    activities = response.parsed_body.index_by { |activity| activity["id"] }
+    assert_not activities.key?(deprecated.id)
+    assert_equal({ "old_title" => "Old & <title>", "new_title" => "New title" }, activities[title.id]["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "Writebook" }, activities[board_change.id]["particulars"])
+    assert_equal({ "column" => "" }, activities[triage.id]["particulars"])
+    assert_equal card_url(card), activities[title.id]["url"]
+    assert_equal card.id, activities[title.id].dig("eventable", "id")
+    assert_includes activities[title.id]["description"], "Old & <title>"
+  end
+
+  test "filters by creator and accessible boards" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id, boards(:private).id ] }
+    assert_response :success
+    assert response.parsed_body.present?
+    assert response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id && activity.dig("board", "id") == boards(:writebook).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+  test "paginates activity newest first with link headers" do
+    card = cards(:logo)
+    70.times do |index|
+      Event.insert_all!([ {
+        id: ActiveRecord::Type::Uuid.generate, account_id: card.account_id,
+        board_id: card.board_id, creator_id: users(:david).id,
+        eventable_type: "Card", eventable_id: card.id,
+        action: "card_reopened", created_at: Time.current + index.seconds,
+        updated_at: Time.current
+      } ])
+    end
+
+    expected_ids = users(:david).accessible_events.activity.order(created_at: :desc, id: :desc).pluck(:id)
+    ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      ids.concat(response.parsed_body.map { |activity| activity["id"] })
+      page_count += 1
+      next_url = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      next_page = URI.parse(next_url).request_uri if next_url
+      next_page = nil unless next_url
+    end
+
+    assert_equal expected_ids, ids
+    assert_operator page_count, :>, 1
+  end
+end
