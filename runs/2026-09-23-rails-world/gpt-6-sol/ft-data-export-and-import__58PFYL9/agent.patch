diff --git a/app/jobs/account/import/create_job.rb b/app/jobs/account/import/create_job.rb
new file mode 100644
index 0000000..1b1798c
--- /dev/null
+++ b/app/jobs/account/import/create_job.rb
@@ -0,0 +1,16 @@
+class Account::Import::CreateJob < ApplicationJob
+  def perform(blob, identity)
+    begin
+      blob.open do |file|
+        account = Account::DataTransfer::Restore.new(file.path, identity: identity).call
+      end
+    rescue => error
+      Account::ImportMailer.failed(identity, error.message).deliver_later
+      return
+    end
+
+    Account::ImportMailer.completed(identity, account).deliver_later
+  ensure
+    blob.purge if blob&.persisted?
+  end
+end
