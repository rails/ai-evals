+require "test_helper"
+require "zip"
+
+class Account::DataTransfer::ArchiveTest < ActiveSupport::TestCase
+  test "exports account records and restores them into a new account" do
+    account = accounts(:"37s")
+    cards(:logo).image.attach(io: StringIO.new("picture data"), filename: "picture.png", content_type: "image/png")
+    tempfile = Tempfile.new([ "account", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::Archive.new(account).write(writer)
+    writer.close
+    tempfile.flush
+
+    imported = Account::DataTransfer::Restore.new(tempfile.path, identity: users(:david).identity).call
+    assert_not_equal account.id, imported.id
+    assert_equal account.boards.count, imported.boards.count
+    assert_equal account.cards.count, imported.cards.count
+    assert_equal Comment.where(account: account).count, Comment.where(account: imported).count
+    assert_equal account.users.count, imported.users.count
+    assert_equal account.cards.find_by!(number: cards(:logo).number).image.blob.download,
+      imported.cards.find_by!(number: cards(:logo).number).image.blob.download
+  ensure
+    tempfile&.close!
+  end
+
+  test "card export only includes accessible cards" do
+    file = Tempfile.new([ "cards", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    user = users(:david)
+    Account::DataTransfer::Archive.new(user.account, cards: user.accessible_cards.distinct).write(writer)
+    writer.close
+    file.flush
+  
+    Zip::File.open(file.path) do |zip|
+      titles = zip.read("cards.jsonl").lines.map { |line| JSON.parse(line).fetch("card").fetch("title") }
+      assert_includes titles, cards(:logo).title
+      refute_includes titles, cards(:buy_domain).title if cards(:buy_domain).board == boards(:private)
+    end
+  ensure
+    file&.close!
+  end
+  
+
+  test "invalid archive does not create an account" do
+    file = Tempfile.new([ "invalid", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    writer.add_file("other.txt", "not an account")
+    writer.close
+    file.flush
+
+    assert_no_difference "Account.count" do
+      assert_raises(Account::DataTransfer::Restore::InvalidArchive) do
+        Account::DataTransfer::Restore.new(file.path, identity: users(:david).identity).call
+      end
+    end
+  ensure
+    file&.close!
+  end
+  test "a missing file rolls back the account" do
+    account = accounts(:"37s")
+    cards(:logo).image.attach(io: StringIO.new("image bytes"), filename: "image.png", content_type: "image/png")
+    file = Tempfile.new([ "missing-file", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    Account::DataTransfer::Manifest.new(account).each_record_set do |set|
+      next if set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+      writer.add_file("records/#{set.model.table_name}.jsonl") do |sink|
+        set.send(:records).each do |record|
+          sink.write(JSON.generate(record.attributes.slice(*set.attributes)) << "\n")
+        end
+      end
+    end
+    writer.add_file("people.jsonl") do |sink|
+      account.users.each { |user| sink.write(JSON.generate(id: user.id, email: user.identity&.email_address) << "\n") }
+    end
+    writer.close
+    file.flush
+
+    assert_no_difference "Account.count" do
+      assert_raises(Account::DataTransfer::Restore::InvalidArchive) do
+        Account::DataTransfer::Restore.new(file.path, identity: users(:david).identity).call
+      end
+    end
+  ensure
+    file&.close!
+  end
+end
