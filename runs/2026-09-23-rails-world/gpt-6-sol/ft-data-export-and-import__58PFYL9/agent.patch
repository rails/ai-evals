+class DataExport < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive
+
+  validates :scope, inclusion: { in: %w[account cards] }
+
+  def accessible_to?(viewer)
+    viewer == user && viewer.account_id == account_id && available?
+  end
+
+  def available?
+    archive.attached? && expires_at.future?
+  end
+end
