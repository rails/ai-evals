+class DataExport::CleanupJob < ApplicationJob
+  def perform
+    DataExport.where(expires_at: ...Time.current).find_each do |export|
+      export.archive.purge if export.archive.attached?
+      export.destroy!
+    end
+  end
+end
diff --git a/app/jobs/data_export/create_job.rb b/app/jobs/data_export/create_job.rb
new file mode 100644
index 0000000..2285e9c
--- /dev/null
+++ b/app/jobs/data_export/create_job.rb
@@ -0,0 +1,10 @@
+class DataExport::CreateJob < ApplicationJob
+  def perform(export)
+    cards = export.scope == "cards" ? export.user.accessible_cards.where(account_id: export.account_id).distinct : nil
+    ZipFile.create_for(export.archive, filename: "fizzy-#{export.scope}.zip") do |zip|
+      Account::DataTransfer::Archive.new(export.account, cards: cards).write(zip)
+    end
+    export.update!(expires_at: 1.day.from_now)
+    DataExportMailer.ready(export).deliver_later
+  end
+end
