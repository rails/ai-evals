diff --git a/app/models/account/data_transfer/restore.rb b/app/models/account/data_transfer/restore.rb
new file mode 100644
index 0000000..c1e68ef
--- /dev/null
+++ b/app/models/account/data_transfer/restore.rb
@@ -0,0 +1,112 @@
+require "zip"
+
+class Account::DataTransfer::Restore
+  class InvalidArchive < StandardError; end
+
+  def initialize(path, identity:)
+    @path, @identity = path, identity
+    @ids = {}
+    @uploaded_keys = []
+  end
+
+  def call
+    Zip::File.open(@path) do |zip|
+      validate!(zip)
+      ApplicationRecord.transaction do
+        build_id_map(zip)
+        create_account(zip)
+        import_people(zip)
+        import_records(zip)
+        import_files(zip)
+      end
+    end
+    @account
+  rescue Exception
+    @uploaded_keys.each { |key| ActiveStorage::Blob.service.delete(key) }
+    raise
+  end
+
+  private
+    def validate!(zip)
+      unless zip.find_entry("records/accounts.jsonl") && zip.find_entry("records/users.jsonl") && zip.find_entry("people.jsonl")
+        raise InvalidArchive, "Not a Fizzy account export"
+      end
+      if zip.entries.any? { |entry| entry.name.start_with?("/") || entry.name.split("/").include?("..") }
+        raise InvalidArchive, "Unsafe archive path"
+      end
+    end
+
+    def lines(zip, path)
+      if entry = zip.find_entry(path)
+        entry.get_input_stream.each_line do |line|
+          yield JSON.parse(line)
+        end
+      end
+    end
+
+    def build_id_map(zip)
+      zip.entries.each do |entry|
+        next unless entry.name.start_with?("records/")
+        lines(zip, entry.name) do |row|
+          raise InvalidArchive, "Duplicate record ID" if @ids.key?(row.fetch("id"))
+          @ids[row.fetch("id")] = ActiveRecord::Type::Uuid.generate
+        end
+      end
+    end
+
+    def create_account(zip)
+      row = nil
+      lines(zip, "records/accounts.jsonl") { |data| row = data }
+      raise InvalidArchive, "Missing account" unless row
+      @account = Account.create!(name: row.fetch("name"))
+      @account.entropy.delete
+      @ids[row.fetch("id")] = @account.id
+    end
+
+    def import_people(zip)
+      @people = {}
+      lines(zip, "people.jsonl") do |row|
+        @people[row.fetch("id")] = Identity.find_or_create_by!(email_address: row.fetch("email")) if row["email"].present?
+      end
+    end
+
+    def import_records(zip)
+      # The manifest orders parents before children.
+      Account::DataTransfer::Manifest.new(@account).each_record_set do |set|
+        next if set.model == Account || set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+        model = set.model
+        lines(zip, "records/#{model.table_name}.jsonl") do |original|
+          row = original.slice(*set.attributes)
+          row.each do |key, value|
+            row[key] = @ids.fetch(value, value) if key == "id" || key.end_with?("_id")
+          end
+          row["account_id"] = @account.id if row.key?("account_id")
+          row["identity_id"] = @people[original["id"]]&.id if model == User
+          row["service_name"] = ActiveStorage::Blob.service.name if model == ActiveStorage::Blob
+          row["key"] = ActiveStorage::Blob.generate_unique_secure_token if model == ActiveStorage::Blob
+          row["key"] = nil if model == Board::Publication
+          model.insert_all!([ row ])
+        end
+      end
+      if importer = @account.users.find_by(identity: @identity)
+        importer.update_columns(role: "owner", verified_at: importer.verified_at || Time.current)
+      else
+        @account.users.create!(name: @identity.email_address, identity: @identity, role: :owner, verified_at: Time.current)
+      end
+    end
+
+    def import_files(zip)
+      originals = @ids.invert
+      ActiveStorage::Blob.where(account_id: @account.id).find_each do |blob|
+        original_id = originals.fetch(blob.id)
+        entry = zip.find_entry("files/#{original_id}")
+        raise InvalidArchive, "Missing file #{original_id}" unless entry
+        raise InvalidArchive, "File size mismatch for #{original_id}" unless entry.size == blob.byte_size
+
+        entry.get_input_stream do |stream|
+          @uploaded_keys << blob.key
+          ActiveStorage::Blob.service.upload(blob.key, stream, checksum: blob.checksum)
+        end
+      end
+    end
+end
