diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..8bd5f6d
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "only an admin can request a full account export" do
+    sign_in_as :david
+    assert_no_difference "DataExport.count" do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    logout_and_sign_in_as users(:kevin)
+    assert_difference "DataExport.count", 1 do
+      post account_exports_path
+    end
+    assert_equal "account", DataExport.last.scope
+  end
+
+  test "any member can request their visible cards" do
+    sign_in_as :david
+    assert_difference "DataExport.count", 1 do
+      post user_exports_path(users(:jason))
+    end
+    assert_equal users(:david), DataExport.last.user
+    assert_equal "cards", DataExport.last.scope
+  end
+
+  test "expired and other users' links are inaccessible" do
+    sign_in_as :david
+    export = DataExport.create!(account: accounts(:"37s"), user: users(:david), scope: "cards", expires_at: 1.day.from_now)
+    export.archive.attach(io: StringIO.new("archive"), filename: "export.zip")
+
+    get account_export_path(export)
+    assert_response :redirect
+
+    export.update!(expires_at: 1.second.ago)
+    get account_export_path(export)
+    assert_response :not_found
+
+    logout_and_sign_in_as users(:jason)
+    get account_export_path(export)
+    assert_response :not_found
+  end
+end
