diff --git a/app/models/account/data_transfer/archive.rb b/app/models/account/data_transfer/archive.rb
new file mode 100644
index 0000000..9796023
--- /dev/null
+++ b/app/models/account/data_transfer/archive.rb
@@ -0,0 +1,73 @@
+class Account::DataTransfer::Archive
+  class InvalidArchive < StandardError; end
+
+  def initialize(account, cards: nil)
+    @account, @cards = account, cards
+  end
+
+  def write(zip)
+    if @cards
+      write_cards(zip)
+    else
+      Account::DataTransfer::Manifest.new(@account).each_record_set do |set|
+        next if set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+
+        write_records(zip, set)
+      end
+      zip.add_file("people.jsonl") do |sink|
+        @account.users.includes(:identity).find_each do |user|
+          sink.write(JSON.generate(id: user.id, email: user.identity&.email_address) << "\n")
+        end
+      end
+      write_files(zip, ActiveStorage::Blob.where(account_id: @account.id).where.not(id: internal_blob_ids))
+    end
+  end
+
+  private
+    def write_records(zip, set)
+      zip.add_file("records/#{set.model.table_name}.jsonl") do |sink|
+        records = set.send(:records)
+        records = records.find_each if records.respond_to?(:find_each)
+        records.each do |record|
+          sink.write(JSON.generate(record.attributes.slice(*set.attributes)) << "\n")
+        end
+      end
+    end
+
+    def write_cards(zip)
+      cards = @cards
+      zip.add_file("cards.jsonl") do |sink|
+        cards.find_each do |card|
+          sink.write(JSON.generate(card: card.attributes, comments: card.comments.map(&:attributes),
+            description: card.description&.body&.to_html,
+            comment_bodies: card.comments.map { |comment| { id: comment.id, body: comment.body&.body&.to_html } }) << "\n")
+        end
+      end
+    
+      ids = cards.pluck(:id)
+      comment_ids = Comment.where(account_id: @account.id, card_id: ids).select(:id)
+      rich_texts = ActionText::RichText.where(account_id: @account.id, record_type: "Card", record_id: ids)
+        .or(ActionText::RichText.where(account_id: @account.id, record_type: "Comment", record_id: comment_ids))
+      attachments = ActiveStorage::Attachment.where(account_id: @account.id, record_type: "Card", record_id: ids)
+        .or(ActiveStorage::Attachment.where(account_id: @account.id, record_type: "Comment", record_id: comment_ids))
+        .or(ActiveStorage::Attachment.where(account_id: @account.id, record_type: "ActionText::RichText", record_id: rich_texts.select(:id)))
+      zip.add_file("attachments.jsonl") do |sink|
+        attachments.includes(:blob).find_each do |attachment|
+          sink.write(JSON.generate(attachment: attachment.attributes, blob: attachment.blob.attributes.except("key", "service_name")) << "\n")
+        end
+      end
+      write_files(zip, ActiveStorage::Blob.where(id: attachments.select(:blob_id)))
+    end
+    
+    def write_files(zip, blobs)
+      blobs.find_each do |blob|
+        zip.add_file("files/#{blob.id}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+
+    def internal_blob_ids
+      ActiveStorage::Attachment.where(account_id: @account.id, record_type: "DataExport").select(:blob_id)
+    end
+end
