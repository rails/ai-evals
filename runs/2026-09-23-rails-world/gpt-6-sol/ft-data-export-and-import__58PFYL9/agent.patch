@@ -0,0 +1,19 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+  end
+
+  def create
+    upload = params.require(:file)
+    unless upload.original_filename.downcase.end_with?(".zip")
+      return redirect_to new_account_import_path, alert: "Please select a ZIP file."
+    end
+
+    blob = ActiveStorage::Blob.new(account_id: ActiveRecord::Type::Uuid.generate,
+      filename: upload.original_filename, content_type: "application/zip")
+    blob.upload(upload.tempfile)
+    Account::Import::CreateJob.perform_later(blob, Current.identity)
+    redirect_to session_menu_path, notice: "We'll email you when your import is finished."
+  end
+end
