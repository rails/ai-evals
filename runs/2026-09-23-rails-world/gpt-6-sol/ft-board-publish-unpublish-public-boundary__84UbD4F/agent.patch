diff --git a/test/controllers/public_boards_test.rb b/test/controllers/public_boards_test.rb
new file mode 100644
index 0000000..d1ee827
--- /dev/null
+++ b/test/controllers/public_boards_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class PublicBoardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "only administrators can publish and unpublish" do
+    get board_path(@board, format: :json)
+    assert_nil response.parsed_body["public_url"]
+
+    post board_publication_path(@board)
+    assert_redirected_to board_path(@board)
+    key = @board.reload.publication_key
+    assert key.present?
+
+    get board_path(@board, format: :json)
+    assert_equal public_board_url(key), response.parsed_body["public_url"]
+
+    delete board_publication_path(@board)
+    assert_nil @board.reload.publication_key
+    get public_board_path(key)
+    assert_response :not_found
+
+    post board_publication_path(@board)
+    assert_not_equal key, @board.reload.publication_key
+    get public_board_path(@board.publication_key)
+    assert_response :success
+  end
+
+  test "members cannot publish or unpublish" do
+    sign_out
+    sign_in_as :jz
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_nil @board.reload.publication_key
+
+    @board.update!(publication_key: SecureRandom.urlsafe_base64(32))
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert @board.reload.publication_key.present?
+  end
+
+  test "anonymous visitors can only read published cards on the right board" do
+    post board_publication_path(@board)
+    key = @board.reload.publication_key
+    column = @board.columns.first
+    published = @board.cards.published.first
+    draft = @board.cards.drafted.first
+    sign_out
+
+    get public_board_path(key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_column_path(key, column)
+    assert_not_includes response.body, draft.title if draft
+
+    get public_board_path(key, format: :json)
+    assert_response :success
+    get public_board_column_path(key, column, format: :json)
+    assert_response :success
+    get public_board_card_path(key, published.number)
+    assert_response :success
+    get public_board_card_path(key, published.number, format: :json)
+    assert_response :success
+
+    if draft
+      get public_board_card_path(key, draft.number, format: :json)
+      assert_response :not_found
+    end
+    foreign_column = boards(:private).columns.create!(name: "Private column")
+    get public_board_column_path(key, foreign_column, format: :json)
+    assert_response :not_found
+    get public_board_path("wrong-key", format: :json)
+    assert_response :not_found
+
+    original_prefix = integration_session.default_url_options[:script_name]
+    integration_session.default_url_options[:script_name] = accounts(:initech).slug
+    get public_board_path(key, format: :json)
+    assert_response :not_found
+  ensure
+    integration_session.default_url_options[:script_name] = original_prefix
+  end
+end
