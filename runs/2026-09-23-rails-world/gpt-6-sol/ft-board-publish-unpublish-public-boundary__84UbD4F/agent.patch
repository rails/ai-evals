+class Public::BoardsController < ApplicationController
+  allow_unauthenticated_access
+  layout false
+
+  before_action :set_board
+
+  def show
+    @columns = @board.columns.sorted
+    @cards = @board.cards.published.where(column_id: nil).latest
+  end
+
+  private
+    def set_board
+      @board = Current.account.boards.find_by!(publication_key: params[:board_key] || params[:key])
+    end
+end
