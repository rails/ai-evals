diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..d6d8b1b 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,34 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  def incinerate
+    with_lock do
+      if cancellation && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+        Current.with_account(self) do
+          destroy!
+          remove_remaining_tenant_records
+        end
+      end
+    end
+  end
+
+  private
+    # Not every account-scoped record is reachable through an Account association
+    # (e.g. search records, events and Action Text records). Remove those as well.
+    def remove_remaining_tenant_records
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:purge)
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+
+      connection = self.class.connection
+      connection.tables.each do |table|
+        if connection.column_exists?(table, :account_id)
+          connection.execute(
+            "DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(id)}"
+          )
+        end
+      end
+    end
 end
