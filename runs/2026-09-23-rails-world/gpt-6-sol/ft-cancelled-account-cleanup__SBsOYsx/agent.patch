diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..737fabc
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+test "does not incinerate an account reactivated after becoming due" do
+  account = accounts(:initech)
+  account.create_cancellation!(initiated_by: account.users.create!(name: "Owner", role: :owner))
+  account.cancellation.update_columns(created_at: 31.days.ago)
+  account.reactivate
+
+  account.incinerate
+
+  assert Account.exists?(account.id)
+end
+
+  test "incinerates only accounts cancelled more than 30 days ago" do
+    travel_to Time.current.change(usec: 0) do
+      due = accounts(:"37s")
+      recent = accounts(:initech)
+      reactivated = accounts(:acme)
+
+      [ due, recent, reactivated ].each do |account|
+        account.create_cancellation!(initiated_by: account.users.first || account.users.create!(name: "Owner", role: :owner))
+      end
+      due.cancellation.update_columns(created_at: 31.days.ago)
+      recent.cancellation.update_columns(created_at: 30.days.ago)
+      reactivated.cancellation.destroy!
+
+      card_id = due.cards.first.id
+      board_id = due.boards.first.id
+      user = due.users.where.not(identity_id: nil).first
+
+      Account::IncinerateDueJob.perform_now
+
+      assert_not Account.exists?(due.id)
+      assert_not Board.exists?(board_id)
+      assert_not Card.exists?(card_id)
+      assert_not User.exists?(user.id)
+      assert Identity.exists?(user.identity_id)
+      assert Account.exists?(recent.id)
+      assert Account.exists?(reactivated.id)
+
+      Account.connection.tables.each do |table|
+        if Account.connection.column_exists?(table, :account_id)
+          count = Account.connection.select_value("SELECT COUNT(*) FROM #{Account.connection.quote_table_name(table)} WHERE account_id = #{Account.connection.quote(due.id)}")
+          assert_equal 0, count, "#{table} still contains account data"
+        end
+      end
+    end
+  end
+end
