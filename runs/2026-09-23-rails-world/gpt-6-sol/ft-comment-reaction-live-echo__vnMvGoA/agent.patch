diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..fa9a97d
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,42 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable, only: :create
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      render turbo_stream: [
+        turbo_stream.replace(ActionView::RecordIdentifier.dom_id(@comment, :reactions_list), partial: "cards/comments/reactions/list", locals: { comment: @comment }),
+        turbo_stream.replace(ActionView::RecordIdentifier.dom_id(@comment, :reactions_composer), partial: "cards/comments/reactions/composer", locals: { comment: @comment })
+      ]
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    reaction = @comment.reactions.find(params[:id])
+    if reaction.creator == Current.user
+      reaction.destroy!
+      render turbo_stream: turbo_stream.replace(ActionView::RecordIdentifier.dom_id(@comment, :reactions_list), partial: "cards/comments/reactions/list", locals: { comment: @comment })
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_composer_controller.js b/app/javascript/controllers/reaction_composer_controller.js
new file mode 100644
index 0000000..9f785af
--- /dev/null
+++ b/app/javascript/controllers/reaction_composer_controller.js
@@ -0,0 +1,18 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "editor", "input" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.editorTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.inputTarget.value = ""
+    this.editorTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+}
