@@ -0,0 +1,16 @@
+class Reaction < ApplicationRecord
+  include Turbo::Broadcastable
+
+  belongs_to :comment
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  after_commit :broadcast_reactions, on: %i[ create destroy ]
+
+  private
+    def broadcast_reactions
+      broadcast_replace_to comment.card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+        partial: "cards/comments/reactions/list", locals: { comment: comment }
+    end
+end
