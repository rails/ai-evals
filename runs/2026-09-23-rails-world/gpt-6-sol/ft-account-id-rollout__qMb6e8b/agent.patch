diff --git a/app/models/concerns/tenant_owned.rb b/app/models/concerns/tenant_owned.rb
new file mode 100644
index 0000000..cbc7b73
--- /dev/null
+++ b/app/models/concerns/tenant_owned.rb
@@ -0,0 +1,24 @@
+module TenantOwned
+  extend ActiveSupport::Concern
+
+  included do
+    before_validation :assign_account_from_owner, on: :create
+  end
+
+  private
+    def assign_account_from_owner
+      return unless has_attribute?(:account_id) && account_id.nil?
+
+      # Prefer the containing resource over secondary associations (e.g. the
+      # assignee of a card or the user watching it).
+      %i[board card filter webhook user creator reactable source mentioner reacter container owner].each do |name|
+        next unless self.class.reflect_on_association(name)&.macro == :belongs_to
+
+        parent = public_send(name)
+        next unless parent
+
+        self.account_id = parent.is_a?(Account) ? parent.id : parent.account_id if parent.is_a?(Account) || parent.respond_to?(:account_id)
+        break if account_id
+      end
+    end
+end
