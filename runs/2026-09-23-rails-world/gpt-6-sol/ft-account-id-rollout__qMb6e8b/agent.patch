diff --git a/script/check-tenant-columns.rb b/script/check-tenant-columns.rb
new file mode 100644
index 0000000..d9f21fa
--- /dev/null
+++ b/script/check-tenant-columns.rb
@@ -0,0 +1,15 @@
+# Run with: bin/rails runner script/check-tenant-columns.rb
+excluded = %w[accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys ]
+abort "No tenant schema loaded" unless ActiveRecord::Base.connection.table_exists?("boards")
+missing = ActiveRecord::Base.connection.tables.reject { |table| table.start_with?("schema_", "ar_internal_", "solid_") || excluded.include?(table) }.filter_map do |table|
+  columns = ActiveRecord::Base.connection.columns(table)
+  column = columns.find { |c| c.name == "account_id" }
+  indexes = ActiveRecord::Base.connection.indexes(table)
+  problems = []
+  problems << "missing" unless column
+  problems << "nullable" if column&.null
+  problems << "unindexed" if column && indexes.none? { |i| i.columns.first == "account_id" }
+  "#{table}: #{problems.join(', ')}" if problems.any?
+end
+abort missing.join("\n") if missing.any?
+puts "All tenant tables have required, indexed account_id"
diff --git a/script/verify-tenant-backfill.rb b/script/verify-tenant-backfill.rb
new file mode 100644
index 0000000..ffda8f0
--- /dev/null
+++ b/script/verify-tenant-backfill.rb
@@ -0,0 +1,45 @@
+# Run with: bin/rails runner script/verify-tenant-backfill.rb
+# Use a separate, minimal legacy database; never modify the application's DB.
+ActiveRecord::Base.establish_connection(adapter: "sqlite3", database: ":memory:")
+connection = ActiveRecord::Base.connection
+connection.create_table(:accounts, id: :uuid) { |t| t.string :name }
+connection.create_table(:boards, id: :uuid) { |t| t.uuid :account_id }
+connection.create_table(:cards, id: :uuid) { |t| t.uuid :account_id; t.uuid :board_id }
+connection.create_table(:users, id: :uuid) { |t| t.uuid :account_id }
+connection.create_table(:comments, id: :uuid) { |t| t.uuid :account_id; t.uuid :card_id }
+connection.create_table(:exports, id: :uuid) { |t| t.uuid :account_id }
+connection.create_table(:account_imports, id: :uuid) { |t| t.uuid :account_id }
+connection.create_table(:action_text_rich_texts, id: :uuid) { |t| t.string :record_type; t.uuid :record_id }
+connection.create_table(:active_storage_blobs, id: :uuid) { |t| t.string :key }
+connection.create_table(:active_storage_attachments, id: :uuid) { |t| t.uuid :blob_id; t.string :record_type; t.uuid :record_id }
+connection.create_table(:active_storage_variant_records, id: :uuid) { |t| t.uuid :blob_id }
+connection.create_table(:tags, id: :uuid) { |t| t.uuid :account_id; t.string :title; t.index :title, unique: true }
+connection.create_table(:accesses, id: :uuid) { |t| t.uuid :board_id }
+connection.create_table(:entropies, id: :uuid) { |t| t.string :container_type; t.uuid :container_id }
+connection.execute("INSERT INTO accounts (id, name) VALUES ('a', 'Tenant'), ('other', 'Other tenant')")
+connection.execute("INSERT INTO boards (id, account_id) VALUES ('b', 'a'), ('other_board', 'other'), ('orphan', NULL)")
+connection.execute("INSERT INTO cards (id, board_id) VALUES ('c', 'b'), ('other_card', 'other_board'), ('lost', 'orphan')")
+connection.execute("INSERT INTO accesses (id, board_id) VALUES ('access', 'b'), ('lost', 'orphan')")
+connection.execute("INSERT INTO action_text_rich_texts (id, record_type, record_id) VALUES ('rt', 'Card', 'c'), ('lost_rt', 'Card', 'lost')")
+connection.execute("INSERT INTO active_storage_blobs (id, key) VALUES ('blob', 'one'), ('lost_blob', 'two')")
+connection.execute("INSERT INTO active_storage_attachments (id, blob_id, record_type, record_id) VALUES ('global', 'blob', 'Identity', 'nobody'), ('valid', 'blob', 'Card', 'c'), ('cross_tenant', 'blob', 'Card', 'other_card'), ('orphan', 'lost_blob', 'Card', 'lost')")
+connection.execute("INSERT INTO active_storage_variant_records (id, blob_id) VALUES ('variant', 'blob'), ('lost_variant', 'lost_blob')")
+connection.execute("INSERT INTO entropies (id, container_type, container_id) VALUES ('e', 'Account', 'a'), ('be', 'Board', 'b'), ('lost', 'Board', 'orphan')")
+require Rails.root.join('db/migrate/20260710120000_require_account_on_tenant_data')
+RequireAccountOnTenantData.new.up
+%w[boards cards accesses entropies].each do |table|
+  rows = connection.select_values("SELECT account_id FROM #{table}")
+  raise "Incorrect backfill for #{table}: #{rows.inspect}" unless rows.count('a') == (table == 'boards' || table == 'cards' ? 1 : rows.size) && rows.all? { |id| %w[a other].include?(id) } && rows.size == { 'boards' => 2, 'cards' => 2, 'accesses' => 1, 'entropies' => 2 }.fetch(table)
+  raise "Nullable account on #{table}" if connection.columns(table).find { |column| column.name == 'account_id' }.null
+  raise "No tenant index on #{table}" unless connection.indexes(table).any? { |index| index.columns.first == 'account_id' }
+end
+{
+  'action_text_rich_texts' => { 'rt' => 'a' },
+  'active_storage_blobs' => { 'blob' => 'a' },
+  'active_storage_attachments' => { 'valid' => 'a' },
+  'active_storage_variant_records' => { 'variant' => 'a' }
+}.each do |table, expected|
+  actual = connection.select_rows("SELECT id, account_id FROM #{table}").to_h
+  raise "Incorrect ownership for #{table}: #{actual.inspect}" unless actual == expected
+end
+puts 'Tenant backfill and orphan removal passed'
