diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..3afbea9
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+    @card.comments.delete_all
+    @card.update_column(:burst_at, nil)
+  end
+
+  test "three comments from two people within a third of the board period cause a burst" do
+    @card.comments.create!(body: "One")
+    @card.comments.create!(body: "Two")
+    assert_nil @card.reload.burst_at
+
+    with_current_user(:jz) { @card.comments.create!(body: "Three") }
+    assert_not_nil @card.reload.burst_at
+
+    @card.update_columns(last_active_at: 2.weeks.ago)
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.touch_last_active_at
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "one person or comments outside the burst window do not qualify" do
+    3.times { @card.comments.create!(body: "Only me") }
+    assert_nil @card.reload.burst_at
+
+    @card.comments.delete_all
+    @card.comments.create!(body: "Old", created_at: @card.auto_postpone_period.seconds.ago)
+    @card.comments.create!(body: "Recent")
+    with_current_user(:jz) { @card.comments.create!(body: "New") }
+    assert_nil @card.reload.burst_at
+  end
+
+  test "stalled begins at exactly two weeks and is available through the cards filter" do
+    travel_to Time.zone.local(2026, 2, 1, 12) do
+      @card.record_burst
+      @card.touch_last_active_at
+    end
+
+    travel_to Time.zone.local(2026, 2, 15, 11, 59) do
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+
+    travel_to Time.zone.local(2026, 2, 15, 12) do
+      assert @card.reload.stalled?
+      filter = users(:david).filters.new(indexed_by: "stalled")
+      assert_includes filter.cards, @card
+      @card.touch_last_active_at
+      assert_not @card.reload.stalled?
+      assert_not_includes filter.cards, @card
+    end
+  end
+
+  test "assignment and reopening are bursts" do
+    @card.toggle_assignment(users(:david))
+    assert_not_nil @card.reload.burst_at
+
+    @card.update_column(:burst_at, nil)
+    @card.close
+    @card.reopen
+    assert_not_nil @card.reload.burst_at
+  end
+end
