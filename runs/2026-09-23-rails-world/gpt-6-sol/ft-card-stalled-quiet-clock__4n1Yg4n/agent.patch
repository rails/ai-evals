diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..32fdb15
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,26 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def record_comment_burst(comment)
+    window_start = comment.created_at - auto_postpone_period / 3.0
+    recent = comments.by_user.where(created_at: window_start..comment.created_at)
+
+    if recent.count >= 3 && recent.distinct.count(:creator_id) >= 2
+      record_burst(comment.created_at)
+    end
+  end
+
+  def record_burst(at = Time.current)
+    update!(burst_at: at)
+  end
+end
