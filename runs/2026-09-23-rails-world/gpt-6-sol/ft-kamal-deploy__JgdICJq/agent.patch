@@ -0,0 +1,41 @@
+# Single-server, self-hosted Fizzy. See docs/deployment.md before running kamal setup.
+service: fizzy
+image: fizzy
+
+servers:
+  - 203.0.113.10 # Replace with your Docker server's public IP or SSH hostname
+
+proxy:
+  ssl: true
+  host: fizzy.example.com # Replace with your public DNS name (must point to the server)
+  app_port: 80 # Thruster listens on 80 and forwards to Puma
+
+# Kamal starts this registry on the server; no external registry account is needed.
+registry:
+  server: localhost:5555
+
+# Change to arm64 for an ARM server and matching build machine.
+builder:
+  arch: amd64
+
+# Keep SQLite (including queue, cache and cable) and uploaded files between releases.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    APP_HOST: fizzy.example.com # Same name as proxy.host, without https://
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>" # Use an address your SMTP server can send from
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+    # Solid Queue runs inside Puma in the web container; do not disable it.
+    SOLID_QUEUE_IN_PUMA: "true"
+    # One small server doesn't need a worker per CPU for web and jobs.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
