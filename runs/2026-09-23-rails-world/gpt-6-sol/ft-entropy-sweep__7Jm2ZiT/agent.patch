+      now = Time.current
+      system_users = {}
+
+      Board.includes(:entropy, account: :entropy).find_each do |board|
+        due_at = now - board.auto_postpone_period
+        system_user = system_users[board.account_id] ||= board.account.system_user
+
+        active.where(board_id: board.id, last_active_at: ..due_at).find_each(cursor: [ :last_active_at, :id ]) do |card|
+          card.auto_postpone(user: system_user)
+        end
       end
     end
   end
