diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..0a1af64
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,88 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+    visit board_url(boards(:writebook))
+  end
+
+  test "dragging a card to another column moves it without reordering that column" do
+    source = "##{dom_id(columns(:writebook_triage))}"
+    destination = "##{dom_id(columns(:writebook_in_progress))}"
+    card = "##{dom_id(@card, :article)}"
+
+    find("#{source} .cards__expander").click
+    assert_selector "#{source} #{card}"
+    assert_selector "#{destination} .card", visible: :all
+    page.execute_script <<~JS
+      const originalFetch = window.fetch.bind(window)
+      window.fetch = (...args) => {
+        if (String(args[0]).includes("/triage")) {
+          return new Promise(resolve => { window.releaseDrop = () => resolve(originalFetch(...args)) })
+        }
+        return originalFetch(...args)
+      }
+    JS
+    find(card).drag_to(find(destination))
+
+    assert_selector "#{destination} #{card}", visible: :all
+    assert_no_selector "#{source} #{card}"
+    assert_equal columns(:writebook_triage), @card.reload.column
+    assert_equal card.delete_prefix("#"), page.evaluate_script(%Q{document.querySelector("#{destination} .cards__list article.card").id})
+    page.execute_script("window.releaseDrop()")
+    assert_no_selector "#{destination} #{card}[data-drop-pending]", visible: :all
+    assert_equal columns(:writebook_in_progress), @card.reload.column
+    assert_equal card.delete_prefix("#"), page.evaluate_script(%Q{document.querySelector("#{destination} .cards__list article.card").id})
+  end
+
+  test "dragging a card to Maybe returns it to triage" do
+    source = "##{dom_id(columns(:writebook_triage))}"
+    card = "##{dom_id(@card, :article)}"
+    find("#{source} .cards__expander").click
+    assert_selector "#{source} #{card}"
+
+    find(card).drag_to(find("#maybe"))
+
+    assert_selector "#maybe #{card}", visible: :all
+    assert_nil @card.reload.column
+  end
+
+  test "dropping on the current column does nothing" do
+    source = "##{dom_id(columns(:writebook_triage))}"
+    card = "##{dom_id(@card, :article)}"
+    find("#{source} .cards__expander").click
+    assert_selector "#{source} #{card}"
+
+    find(card).drag_to(find(source))
+
+    assert_selector "#{source} #{card}"
+    assert_equal columns(:writebook_triage), @card.reload.column
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    source = "##{dom_id(columns(:writebook_triage))}"
+    card = "##{dom_id(@card, :article)}"
+    find("#{source} .cards__expander").click
+    assert_selector "#{source} #{card}"
+
+    find(card).drag_to(find("#not-now"))
+
+    assert_selector "#not-now #{card}", visible: :all
+    assert_predicate @card.reload, :postponed?
+  end
+
+  test "dragging a card to Done closes it" do
+    source = "##{dom_id(columns(:writebook_triage))}"
+    card = "##{dom_id(@card, :article)}"
+    find("#{source} .cards__expander").click
+    assert_selector "#{source} #{card}"
+
+    find(card).drag_to(find("#closed-cards"))
+
+    assert_selector "#closed-cards #{card}", visible: :all
+    assert_predicate @card.reload, :closed?
+  end
+end
