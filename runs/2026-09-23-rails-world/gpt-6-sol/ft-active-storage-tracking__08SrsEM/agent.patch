diff --git a/app/models/board/storage_usage.rb b/app/models/board/storage_usage.rb
new file mode 100644
index 0000000..d96d984
--- /dev/null
+++ b/app/models/board/storage_usage.rb
@@ -0,0 +1,30 @@
+class Board::StorageUsage
+  def initialize(board)
+    @board = board
+  end
+
+  def bytes_used
+    image_bytes + embed_bytes("Board", "public_description", @board.id) +
+      embed_bytes("Card", "description", card_ids) +
+      embed_bytes("Comment", "body", Comment.where(card_id: card_ids).select(:id))
+  end
+
+  private
+    def card_ids
+      @card_ids ||= Card.where(board_id: @board.id).select(:id)
+    end
+
+    def image_bytes
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: card_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def embed_bytes(type, name, ids)
+      ActiveStorage::Attachment.joins(:blob)
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .where(record_type: "ActionText::RichText", name: "embeds")
+        .where(action_text_rich_texts: { record_type: type, name: name, record_id: ids })
+        .sum("active_storage_blobs.byte_size")
+    end
+end
