diff --git a/test/models/board/storage_usage_test.rb b/test/models/board/storage_usage_test.rb
new file mode 100644
index 0000000..1adaca9
--- /dev/null
+++ b/test/models/board/storage_usage_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Board::StorageUsageTest < ActiveSupport::TestCase
+  test "counts only board content and sums it for the account" do
+    board = boards(:writebook)
+    other_board = boards(:private)
+    card = cards(:logo)
+    other_card = cards(:layout)
+    other_card.update_columns(board_id: other_board.id)
+    comment = comments(:logo_1)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("12345"), filename: "file.txt")
+
+    board.update!(public_description: ActionText::Content.new("<action-text-attachment sgid='#{blob.attachable_sgid}'></action-text-attachment>"))
+    card.update!(description: ActionText::Content.new("<action-text-attachment sgid='#{blob.attachable_sgid}'></action-text-attachment>"))
+    comment.update!(body: ActionText::Content.new("<action-text-attachment sgid='#{blob.attachable_sgid}'></action-text-attachment>"))
+    card.image.attach(blob)
+    other_card.image.attach(blob)
+
+    Board::StorageUsageJob.perform_now(board)
+    Board::StorageUsageJob.perform_now(other_board)
+
+    assert_equal 20, board.reload.bytes_used
+    assert_equal 5, other_board.reload.bytes_used
+    assert_equal 25, board.account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+
+    card.image.purge
+    Board::StorageUsageJob.perform_now(board)
+    assert_equal 15, board.reload.bytes_used
+    assert_equal 20, board.account.bytes_used
+  end
+
+  test "refresh accounts for card moves and removed embeds" do
+    board = boards(:writebook)
+    destination = boards(:private)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("123"), filename: "file.txt")
+    card.image.attach(blob)
+    card.update!(description: ActionText::Content.new("<action-text-attachment sgid='#{blob.attachable_sgid}'></action-text-attachment>"))
+
+    Board::StorageUsageJob.perform_now(board)
+    assert_equal 6, board.reload.bytes_used
+
+    Current.user = users(:david)
+    card.update!(board: destination)
+    Board::StorageUsageJob.perform_now(board)
+    Board::StorageUsageJob.perform_now(destination)
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 6, destination.reload.bytes_used
+
+    card.update!(description: "No attachment")
+    Board::StorageUsageJob.perform_now(destination)
+    assert_equal 3, destination.reload.bytes_used
+  end
+
+  test "refresh enqueues work for each board" do
+    assert_enqueued_with(job: Board::StorageUsageJob, args: [ boards(:writebook) ]) do
+      Board::RefreshStorageUsagesJob.perform_now
+    end
+  end
+end
