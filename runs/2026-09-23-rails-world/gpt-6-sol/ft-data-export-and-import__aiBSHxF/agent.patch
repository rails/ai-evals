--- /dev/null
+++ b/app/jobs/account/data_transfer/import_job.rb
@@ -0,0 +1,10 @@
+class Account::DataTransfer::ImportJob < ApplicationJob
+  def perform(blob, identity)
+    account = Account::DataTransfer::Importer.new(blob, identity: identity).import
+    Account::DataTransferMailer.import_finished(identity, account).deliver_later
+  rescue => error
+    Account::DataTransferMailer.import_failed(identity, error.message).deliver_later
+  ensure
+    blob.purge
+  end
+end
