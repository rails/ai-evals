@@ -0,0 +1,18 @@
+class Account::DataTransferImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+  end
+
+  def create
+    upload = params.require(:file)
+    staging_account = Current.identity.users.active.first&.account
+    head :forbidden and return unless staging_account
+
+    blob = Current.with_account(staging_account) do
+      ActiveStorage::Blob.create_and_upload!(io: upload, filename: upload.original_filename, content_type: "application/zip")
+    end
+    Account::DataTransfer::ImportJob.perform_later(blob, Current.identity)
+    redirect_to new_account_data_transfer_import_path, notice: "We'll email you when the import finishes."
+  end
+end
