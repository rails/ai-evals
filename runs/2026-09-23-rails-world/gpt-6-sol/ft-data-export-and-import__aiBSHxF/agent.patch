+require "test_helper"
+
+class Account::DataTransferExportsControllerTest < ActionDispatch::IntegrationTest
+  test "download uses an expiring signed blob link" do
+    export = Account::DataTransfer::Export.create!(account: accounts(:"37s"), user: users(:david), scope: "cards")
+    export.generate
+    blob = export.file.blob
+    signed_id = blob.signed_id(expires_at: export.expires_at)
+    link = Rails.application.routes.url_helpers.rails_blob_path(blob, signed_id: signed_id, only_path: true)
+    assert_includes link, signed_id
+    travel 2.days do
+      assert_nil ActiveStorage::Blob.find_signed(signed_id)
+    end
+  end
+end
+
+class Account::DataTransferExportAuthorizationTest < ActionDispatch::IntegrationTest
+  setup { sign_in_as users(:david) }
+
+  test "members cannot request the entire account" do
+    assert_no_difference "Account::DataTransfer::Export.count" do
+      post account_data_transfer_exports_path
+    end
+    assert_response :forbidden
+  end
+
+  test "members can request cards they can access" do
+    assert_difference "Account::DataTransfer::Export.count", 1 do
+      post account_data_transfer_exports_path(scope: "cards")
+    end
+    assert_equal "cards", Account::DataTransfer::Export.last.scope
+  end
+end
