diff --git a/app/models/account/data_transfer/export.rb b/app/models/account/data_transfer/export.rb
new file mode 100644
index 0000000..9b4bb38
--- /dev/null
+++ b/app/models/account/data_transfer/export.rb
@@ -0,0 +1,89 @@
+class Account::DataTransfer::Export < ApplicationRecord
+  self.table_name = "account_data_transfer_exports"
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file
+
+  validates :scope, inclusion: { in: %w[account cards] }
+
+  def generate_later
+    Account::DataTransfer::ExportJob.perform_later(self)
+  end
+
+  def generate
+    ZipFile.create_for(file, filename: "fizzy-#{scope}-#{account.external_account_id}.zip") do |zip|
+      if scope == "account"
+        manifest.each_record_set do |set|
+          next if set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+
+          zip.add_file("records/#{set.model.table_name}.jsonl") do |sink|
+            records = set.send(:records)
+            (records.is_a?(ActiveRecord::Relation) ? records.find_each : records).each do |record|
+              attributes = record.attributes.slice(*set.attributes)
+              attributes["email_address"] = record.identity&.email_address if record.is_a?(User)
+              attributes["body"] = portable_body(attributes["body"]) if record.is_a?(ActionText::RichText)
+              sink.write(JSON.generate(attributes) + "\n")
+            end
+          end
+        end
+        blobs = Account::DataTransfer::ActiveStorage::FileRecordSet.new(account).send(:records)
+      else
+        cards = Card.where(account: account, board_id: Access.where(user: user).select(:board_id))
+        zip.add_file("cards.jsonl") do |sink|
+          cards.find_each do |card|
+            sink.write(JSON.generate(card: card.attributes,
+              description: card.description&.body&.to_html,
+              files: file_details_for(card),
+              comments: card.comments.map { |comment| { attributes: comment.attributes, body: comment.body&.body&.to_html, files: file_details_for(comment) } }) + "\n")
+          end
+        end
+        card_ids = cards.select(:id)
+        comment_ids = Comment.where(card_id: card_ids).select(:id)
+        rich_text_ids = ActionText::RichText.where(record_type: "Card", record_id: card_ids).or(
+          ActionText::RichText.where(record_type: "Comment", record_id: comment_ids)).select(:id)
+        attachments = ActiveStorage::Attachment.where(record_type: "Card", record_id: card_ids).or(
+          ActiveStorage::Attachment.where(record_type: "Comment", record_id: comment_ids)).or(
+          ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids))
+        blobs = ActiveStorage::Blob.where(id: attachments.select(:blob_id))
+      end
+
+      blobs.find_each do |blob|
+        zip.add_file("files/#{blob.id}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+    update!(expires_at: 1.day.from_now)
+    Account::DataTransfer::ExpireJob.set(wait_until: expires_at).perform_later(self)
+  end
+
+  def available?
+    file.attached? && expires_at&.future?
+  end
+
+  private
+    def portable_body(body)
+      body.to_s.gsub(/sgid="([^"]+)"/) do |match|
+        attachable = GlobalID::Locator.locate_signed(Regexp.last_match(1), for: "attachable")
+        if attachable.is_a?(ActiveStorage::Blob) || attachable.is_a?(User)
+          %(data-fizzy-reference="#{attachable.class.name}:#{attachable.id}")
+        else
+          match
+        end
+      end
+    end
+
+    def file_details_for(record)
+      direct = ActiveStorage::Attachment.where(record_type: record.class.name, record_id: record.id)
+      rich_text = ActionText::RichText.where(record_type: record.class.name, record_id: record.id).select(:id)
+      embedded = ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text)
+      direct.or(embedded).includes(:blob).map do |attachment|
+        { id: attachment.blob.id, filename: attachment.blob.filename.to_s, content_type: attachment.blob.content_type }
+      end
+    end
+
+    def manifest
+      Account::DataTransfer::Manifest.new(account)
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..fa4ad34
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,124 @@
+require "zip"
+# The archive contains newline-delimited records, so neither the data nor the files
+# need to be loaded into memory at once. IDs are remapped to permit same-site restores.
+class Account::DataTransfer::Importer
+  def initialize(blob, identity:)
+    @blob, @identity = blob, identity
+    @ids = {}
+    @uploaded_keys = []
+  end
+
+  def import
+    @blob.open do |file|
+      Zip::File.open(file.path) do |zip|
+        raise ArgumentError, "Not a Fizzy account archive" unless zip.find_entry("records/accounts.jsonl")
+
+        ApplicationRecord.transaction do
+          build_ids(zip)
+          restore_records(zip)
+          restore_files(zip)
+        end
+      end
+    end
+    @account
+  rescue => error
+    @uploaded_keys.each { |key| ActiveStorage::Blob.service.delete(key) }
+    raise error
+  end
+
+  private
+    def sets
+      @sets ||= Enumerator.new { |y| Account::DataTransfer::Manifest.new(Account.new).each_record_set { |set| y << set } }.to_a.reject do |set|
+        set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+      end
+    end
+
+    def each_row(zip, set)
+      entry = zip.find_entry("records/#{set.model.table_name}.jsonl")
+      raise ArgumentError, "Missing #{set.model.table_name}" unless entry
+
+      entry.get_input_stream.each_line do |line|
+        yield JSON.parse(line)
+      end
+    end
+
+    def build_ids(zip)
+      sets.each do |set|
+        each_row(zip, set) do |row|
+          raise ArgumentError, "Missing record ID" unless row["id"].present?
+          raise ArgumentError, "Duplicate record ID" if @ids.key?(row["id"])
+          @ids[row["id"]] = ActiveRecord::Type::Uuid.generate
+        end
+      end
+    end
+
+    def restore_records(zip)
+      sets.each do |set|
+        each_row(zip, set) do |row|
+          if set.model == Account
+            raise ArgumentError, "Multiple accounts" if @account
+            @account = Account.create!(name: row.fetch("name"))
+            @account.update_columns(cards_count: row.fetch("cards_count"))
+            @account.entropy.destroy!
+            @ids[row.fetch("id")] = @account.id
+          else
+            restore_row(set, row)
+          end
+        end
+      end
+      raise ArgumentError, "Missing account" unless @account
+      unless @account.users.exists?(identity: @identity)
+        @account.users.create!(identity: @identity, name: @identity.email_address, role: :owner, verified_at: Time.current)
+      end
+    end
+
+    def restore_row(set, row)
+      old_id = row.fetch("id")
+      email = row.delete("email_address") if set.model == User
+      row = row.slice(*set.attributes)
+      row["id"] = @ids.fetch(row.fetch("id"))
+      row["account_id"] = @account.id if row.key?("account_id")
+      row.each do |key, value|
+        if key.end_with?("_id") && !%w[id account_id identity_id].include?(key) && value.present?
+          row[key] = @ids.fetch(value) { raise ArgumentError, "Missing reference #{key}" }
+        end
+      end
+      if set.model == Board::Publication && row["key"].present? && Board::Publication.exists?(key: row["key"])
+        row["key"] = SecureRandom.base58(24)
+      end
+      if set.model == ActionText::RichText
+        row["body"] = restore_body(row["body"])
+      end
+      if set.model == User
+        row["identity_id"] = email.present? ? Identity.find_or_create_by!(email_address: email).id : nil
+      elsif set.model == ActiveStorage::Blob
+        row["service_name"] = ActiveStorage::Blob.service.name
+        row["key"] = SecureRandom.base58(28)
+      end
+      set.model.insert_all!([ row ])
+      @blob_keys ||= {}
+      @blob_keys[old_id] = row["key"] if set.model == ActiveStorage::Blob
+    end
+
+    def restore_body(body)
+      body.to_s.gsub(/data-fizzy-reference="(ActiveStorage::Blob|User):([^"]+)"/) do
+        type, old_id = Regexp.last_match(1), Regexp.last_match(2)
+        klass = { "User" => User, "ActiveStorage::Blob" => ActiveStorage::Blob }.fetch(type)
+        record = klass.find(@ids.fetch(old_id))
+        %(sgid="#{record.attachable_sgid}")
+      end
+    end
+
+    def restore_files(zip)
+      # File names refer to the IDs in the source archive, not the new IDs.
+      @blob_keys&.each do |old_id, key|
+        entry = zip.find_entry("files/#{old_id}")
+        raise ArgumentError, "Missing file #{old_id}" unless entry
+
+        entry.get_input_stream do |stream|
+          @uploaded_keys << key
+          ActiveStorage::Blob.service.upload(key, stream)
+        end
+      end
+    end
+end
