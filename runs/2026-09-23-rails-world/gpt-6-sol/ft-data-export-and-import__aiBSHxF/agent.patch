+class Account::DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    mail to: export.user.identity.email_address, subject: "Your Fizzy download is ready"
+  end
+
+  def import_finished(identity, account)
+    @account = account
+    mail to: identity.email_address, subject: "Your Fizzy import is complete"
+  end
+
+  def import_failed(identity, reason)
+    @reason = reason
+    mail to: identity.email_address, subject: "Your Fizzy import failed"
+  end
+end
