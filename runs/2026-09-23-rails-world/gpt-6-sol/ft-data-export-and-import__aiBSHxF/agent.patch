@@ -0,0 +1,18 @@
+class Account::DataTransferExportsController < ApplicationController
+  before_action :ensure_admin, only: :create, if: -> { params[:scope] != "cards" }
+
+  def create
+    scope = params[:scope] == "cards" ? "cards" : "account"
+    export = Account::DataTransfer::Export.create!(account: Current.account, user: Current.user, scope: scope)
+    export.generate_later
+    redirect_back fallback_location: root_path, notice: "We'll email you a link when your download is ready."
+  end
+
+  def show
+    export = Current.account.data_transfer_exports.find(params[:id])
+    head :forbidden and return unless export.user == Current.user || Current.user.admin?
+    head :not_found and return unless export.available?
+
+    redirect_to rails_blob_url(export.file.blob, signed_id: export.file.blob.signed_id(expires_at: export.expires_at), disposition: :attachment), allow_other_host: true
+  end
+end
