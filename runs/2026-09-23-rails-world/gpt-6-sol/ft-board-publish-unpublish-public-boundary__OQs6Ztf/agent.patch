diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..ef2fbc7
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,17 @@
+module Board::Publication
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def publish
+    with_lock do
+      update!(publication_key: SecureRandom.urlsafe_base64(32)) if publication_key.nil?
+    end
+  end
+
+  def unpublish
+    update!(publication_key: nil)
+  end
+end
