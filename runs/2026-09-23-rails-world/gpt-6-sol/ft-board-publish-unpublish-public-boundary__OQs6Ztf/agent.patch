+++ b/app/views/public/boards/show.html.erb
@@ -0,0 +1,22 @@
+<% @page_title = @board.name %>
+<h1><%= @board.name %></h1>
+<% @columns.each do |column| %>
+  <section>
+    <h2><%= link_to column.name, public_board_column_path(@board.publication_key, column) %></h2>
+    <ul>
+      <% @cards.select { |card| card.column_id == column.id }.each do |card| %>
+        <li><%= link_to card.title, public_board_card_path(@board.publication_key, card.number) %></li>
+      <% end %>
+    </ul>
+  </section>
+<% end %>
+<% if @cards.any? { |card| card.column_id.nil? } %>
+  <section>
+    <h2>Unsorted</h2>
+    <ul>
+      <% @cards.select { |card| card.column_id.nil? }.each do |card| %>
+        <li><%= link_to card.title, public_board_card_path(@board.publication_key, card.number) %></li>
+      <% end %>
+    </ul>
+  </section>
+<% end %>
