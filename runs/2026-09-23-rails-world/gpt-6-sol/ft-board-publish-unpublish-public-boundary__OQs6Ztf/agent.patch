diff --git a/test/controllers/board_publications_controller_test.rb b/test/controllers/board_publications_controller_test.rb
new file mode 100644
index 0000000..0c46010
--- /dev/null
+++ b/test/controllers/board_publications_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class BoardPublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "only administrators can publish and revoke a board" do
+    logout_and_sign_in_as :jz
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_nil @board.reload.publication_key
+
+    cookies.delete :session_token
+    Session.delete_all
+    post board_publication_path(@board)
+    assert_response :redirect
+
+    sign_in_as :kevin
+    post board_publication_path(@board)
+    assert_response :redirect
+    key = @board.reload.publication_key
+    assert key.present?
+
+    post board_publication_path(@board)
+    assert_equal key, @board.reload.publication_key
+
+    delete board_publication_path(@board)
+    assert_nil @board.reload.publication_key
+  end
+
+  test "anonymous readers can only see published content at the secret URL" do
+    get board_path(@board, format: :json)
+    assert_nil response.parsed_body["public_url"]
+
+    post board_publication_path(@board)
+    url = public_board_path(@board.reload.publication_key)
+    get board_path(@board, format: :json)
+    assert_equal public_board_url(@board.publication_key), response.parsed_body["public_url"]
+
+    card = @board.cards.published.first
+    draft = @board.cards.create!(title: "Hidden draft", status: :drafted, creator: users(:kevin))
+    foreign_column = boards(:private).columns.create!(name: "Foreign")
+    foreign_card = Current.set(user: users(:kevin)) { boards(:private).cards.create!(title: "Foreign card", status: :published, creator: users(:kevin)) }
+    column = @board.columns.first
+    cookies.delete :session_token
+    Session.delete_all
+
+    get url
+    assert_response :success
+    get public_board_path("wrong")
+    assert_response :not_found
+    get public_board_path(@board.publication_key, format: :json)
+    assert_response :success
+    assert_equal @board.name, response.parsed_body["name"]
+    assert_not_includes response.parsed_body["cards"].map { |entry| entry["number"] }, draft.number
+    get public_board_column_path(@board.publication_key, column, format: :json)
+    assert_response :success
+    get public_board_card_path(@board.publication_key, card.number, format: :json)
+    assert_response :success
+    get public_board_column_path(@board.publication_key, column)
+    assert_response :success
+    get public_board_card_path(@board.publication_key, card.number)
+    assert_response :success
+    get public_board_card_path(@board.publication_key, draft.number)
+    assert_response :not_found
+    get public_board_column_path(@board.publication_key, foreign_column)
+    assert_response :not_found
+    get public_board_card_path(@board.publication_key, foreign_card.number)
+    assert_response :not_found
+    get public_board_card_path(@board.publication_key, 99999999)
+    assert_response :not_found
+
+    sign_in_as :kevin
+    delete board_publication_path(@board)
+    cookies.delete :session_token
+    Session.delete_all
+    get url
+    assert_response :not_found
+  end
+end
