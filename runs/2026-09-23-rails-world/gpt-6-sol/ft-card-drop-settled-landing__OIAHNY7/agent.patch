diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3e62682
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,147 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+// Cards have no position within a column. A drop changes status, placing the card
+// at the head of the destination (after its golden cards, where applicable).
+export default class extends Controller {
+  start(event) {
+    const card = event.target.closest(".cards__list .card")
+    if (!card || this.pending?.has(card)) return
+
+    this.card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    requestAnimationFrame(() => card.classList.add("drag-and-drop__dragged-item"))
+  }
+
+  over(event) {
+    const column = this.#destination(event)
+    if (!column) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    if (this.hovered !== column) {
+      this.#clearHover()
+      this.hovered = column
+      column.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  leave(event) {
+    if (this.hovered && !this.hovered.contains(event.relatedTarget)) this.#clearHover()
+  }
+
+  drop(event) {
+    const column = this.#destination(event)
+    if (!column) return
+
+    event.preventDefault()
+    this.#clearHover()
+
+    const card = this.card
+    const source = card.closest(".cards")
+    const list = column.querySelector(".cards__list")
+    if (!list) return
+
+    const originalParent = card.parentElement
+    const nextSibling = card.nextSibling
+    const oldCount = this.#changeCount(source, -1)
+    const newCount = this.#changeCount(column, 1)
+    const oldState = { className: card.className, columnName: card.querySelector(".card__column-name--current")?.textContent }
+
+    // Do not append after pagination links: server ordering puts the latest card first.
+    const firstCard = list.querySelector(".card")
+    const firstRegularCard = [...list.querySelectorAll(".card")].find(item => !item.classList.contains("golden-effect"))
+    const goldenFirst = !["closed", "not_now"].includes(column.dataset.dragAndDropStatus)
+    const insertBefore = !goldenFirst || card.classList.contains("golden-effect") ? list.querySelector(".card") : firstRegularCard
+    if (insertBefore) insertBefore.before(card)
+    else if (list.querySelector(".card")) [...list.querySelectorAll(".card")].at(-1).after(card)
+    else list.prepend(card)
+
+    this.#showStatus(card, column)
+    this.pending ||= new WeakSet()
+    this.pending.add(card)
+    this.#save(card, column).then(response => {
+      if (!response.ok) throw new Error("Card move failed")
+    }).catch(() => {
+      originalParent.insertBefore(card, nextSibling)
+      card.className = oldState.className
+      card.classList.remove("drag-and-drop__dragged-item")
+      this.#restoreColumnName(card, oldState.columnName)
+      this.#setCount(source, oldCount)
+      this.#setCount(column, newCount)
+    }).finally(() => this.pending.delete(card))
+  }
+
+  end() {
+    this.card?.classList.remove("drag-and-drop__dragged-item")
+    this.card = null
+    this.#clearHover()
+  }
+
+  #destination(event) {
+    const column = event.target.closest(".cards[data-drag-and-drop-status]")
+    if (this.card && column && this.element.contains(column) && column !== this.card.closest(".cards")) return column
+  }
+
+  #clearHover() {
+    this.hovered?.classList.remove("drag-and-drop__hover-container")
+    this.hovered = null
+  }
+
+  #save(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    let method = "post"
+    let url
+
+    if (status === "closed") url = card.dataset.cardClosureUrl
+    else if (status === "not_now") url = card.dataset.cardNotNowUrl
+    else if (status === "maybe") {
+      method = "delete"
+      url = card.dataset.cardTriageUrl
+    } else {
+      url = `${card.dataset.cardTriageUrl}?${new URLSearchParams({ column_id: status })}`
+    }
+
+    return new FetchRequest(method, url, { responseKind: "json" }).perform()
+  }
+
+  #showStatus(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    card.classList.toggle("card--postponed", status === "not_now")
+    card.classList.toggle("card--active", status !== "closed" && status !== "not_now")
+    this.#restoreColumnName(card, status !== "closed" && status !== "not_now" && status !== "maybe" ? column.dataset.columnName : null)
+  }
+
+  #restoreColumnName(card, name) {
+    card.querySelector(".card__header > .card__column-name--current")?.remove()
+    card.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.textContent.trim() === name?.trim())
+    })
+    if (name) {
+      const label = document.createElement("span")
+      label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      label.textContent = name
+      card.querySelector(".card__header").append(label)
+    }
+  }
+
+  #changeCount(column, change) {
+    const count = this.#count(column)
+    if (count !== null) this.#setCount(column, count + change)
+    return count
+  }
+
+  #count(column) {
+    const label = column.querySelector(".cards__expander-count")?.textContent.trim()
+    return label === "99+" ? null : Number(label) || 0
+  }
+
+  #setCount(column, count) {
+    if (count === null) return
+
+    const expander = column.querySelector(".cards__expander")
+    expander.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+    expander.style.setProperty("--card-count", Math.min(count, 15))
+  }
+}
