diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..c2b9cb3
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,89 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+    visit board_url(@card.board)
+    find("#column_#{@card.column.id} .cards__expander").click
+    assert_selector "#article_card_#{@card.id}"
+  end
+
+  test "dropping a card changes its column without waiting for the save" do
+    destination = columns(:writebook_in_progress)
+    drag_to "#column_#{destination.id}"
+
+    assert_selector "#column_#{destination.id} #article_card_#{@card.id}", visible: :all
+    assert_equal destination, @card.reload.column
+  end
+
+  test "the card moves before the server responds" do
+    destination = columns(:writebook_in_progress)
+    page.execute_script <<~JS
+      const fetchOriginal = window.fetch
+      window.fetch = (...args) => new Promise(resolve => {
+        window.releaseCardMove = () => resolve(fetchOriginal(...args))
+      })
+    JS
+
+    drag_to "#column_#{destination.id}"
+    assert_selector "#column_#{destination.id} #article_card_#{@card.id}", visible: :all
+    assert_equal columns(:writebook_triage), @card.reload.column
+
+    page.execute_script "window.releaseCardMove()"
+    Timeout.timeout(5) { sleep 0.05 until @card.reload.column == destination }
+    assert_equal destination, @card.reload.column
+  end
+
+  test "a failed save restores the original column" do
+    page.execute_script <<~JS
+      window.fetch = () => Promise.resolve(new Response("", { status: 500 }))
+    JS
+
+    drag_to "#column_#{columns(:writebook_in_progress).id}"
+    assert_selector "#column_#{@card.column.id} #article_card_#{@card.id}"
+    assert_equal columns(:writebook_triage), @card.reload.column
+  end
+
+  test "dropping on the same column does nothing" do
+    original_events = @card.events.count
+    drag_to "#column_#{@card.column.id}"
+
+    assert_equal @card.column, @card.reload.column
+    assert_equal original_events, @card.events.count
+  end
+
+  test "dropping into Not Now postpones the card" do
+    drag_to "#not-now"
+
+    assert_selector "#not-now #article_card_#{@card.id}", visible: :all
+    assert @card.reload.postponed?
+  end
+
+  test "dropping into Done closes the card" do
+    drag_to "#closed-cards"
+
+    assert_selector "#closed-cards #article_card_#{@card.id}", visible: :all
+    assert @card.reload.closed?
+  end
+
+  test "dropping into Maybe sends a card back to triage" do
+    drag_to "#maybe"
+
+    assert_selector "#maybe #article_card_#{@card.id}", visible: :all
+    assert @card.reload.awaiting_triage?
+  end
+
+  private
+    def drag_to(destination)
+      page.execute_script <<~JS
+        const card = document.querySelector(#{"#article_card_#{@card.id}".to_json})
+        const target = document.querySelector(#{destination.to_json})
+        const transfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: transfer }))
+        target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        target.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: transfer }))
+      JS
+    end
+end
