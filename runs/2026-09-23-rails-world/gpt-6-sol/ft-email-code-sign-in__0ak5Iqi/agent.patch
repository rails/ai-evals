+module EmailCodeRequest
+  private
+    def send_email_code(identity, intent:, join_code: nil)
+      code = Identity::EmailCode.issue_for(identity)
+      session[:pending_email_code] = { "identity_id" => identity.id, "intent" => intent, "join_code_id" => join_code&.id }
+      UserMailer.sign_in_code(identity, code).deliver_later
+      redirect_to email_code_path(script_name: nil)
+    end
+end
diff --git a/app/controllers/email_codes_controller.rb b/app/controllers/email_codes_controller.rb
new file mode 100644
index 0000000..8fbe653
--- /dev/null
+++ b/app/controllers/email_codes_controller.rb
@@ -0,0 +1,52 @@
+class EmailCodesController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def show
+    redirect_to new_session_path(script_name: nil) unless pending_identity
+  end
+
+  def create
+    if (identity = pending_identity) && identity.email_code&.redeem(params.expect(:code))
+      pending = session.delete(:pending_email_code)
+      terminate_session if Current.session
+      start_new_session_for identity
+
+      case pending["intent"]
+      when "signup"
+        redirect_to new_signup_completion_path(script_name: nil)
+      when "join"
+        join_account(identity, pending["join_code_id"])
+      else
+        redirect_to after_authentication_url
+      end
+    else
+      render :show, status: :unprocessable_entity, locals: { invalid_code: true }
+    end
+  end
+
+  private
+    def pending_identity
+      if id = session.dig(:pending_email_code, "identity_id")
+        Identity.find_by(id: id)
+      end
+    end
+
+    def join_account(identity, id)
+      join_code = Account::JoinCode.find_by(id: id)
+      if join_code && join_code.active?
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: join_code.account, identity: identity)
+        if user.setup?
+          redirect_to landing_url(script_name: join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        redirect_to new_session_path(script_name: nil), alert: "That join code is no longer available."
+      end
+    end
+end
