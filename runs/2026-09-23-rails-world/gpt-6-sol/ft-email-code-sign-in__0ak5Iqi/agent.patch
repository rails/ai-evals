diff --git a/app/models/identity/email_code.rb b/app/models/identity/email_code.rb
new file mode 100644
index 0000000..aae4bf0
--- /dev/null
+++ b/app/models/identity/email_code.rb
@@ -0,0 +1,28 @@
+class Identity::EmailCode < ApplicationRecord
+  EXPIRY = 15.minutes
+
+  belongs_to :identity
+
+  def self.issue_for(identity)
+    code = SecureRandom.alphanumeric(6).upcase
+    record = identity.email_code || identity.build_email_code
+    record.update!(code_digest: digest(code), expires_at: EXPIRY.from_now)
+    code
+  end
+
+  def redeem(code)
+    with_lock do
+      if expires_at.future? && code.to_s.match?(/\A[A-Z0-9]{6}\z/) &&
+          ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest(code))
+        destroy!
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def self.digest(code)
+    OpenSSL::Digest::SHA256.hexdigest(code)
+  end
+end
