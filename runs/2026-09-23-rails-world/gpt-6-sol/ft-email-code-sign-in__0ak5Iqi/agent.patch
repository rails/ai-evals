+<% @page_title = "Enter your email code" %>
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black">Check your email</h1>
+  <p>Enter the six-character code we emailed you. It expires in 15 minutes.</p>
+  <% if local_assigns[:invalid_code] %>
+    <p class="txt-negative">That code is invalid or has expired. Please try again.</p>
+  <% end %>
+  <%= form_with url: email_code_path(script_name: nil), class: "flex flex-column gap" do |form| %>
+    <%= form.text_field :code, required: true, maxlength: 6, minlength: 6, autocomplete: "one-time-code", autofocus: true, class: "input txt-large", placeholder: "Your code" %>
+    <%= form.submit "Continue", class: "btn btn--link center" %>
+  <% end %>
+</div>
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
