diff --git a/test/controllers/email_codes_controller_test.rb b/test/controllers/email_codes_controller_test.rb
new file mode 100644
index 0000000..d89252a
--- /dev/null
+++ b/test/controllers/email_codes_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "signup verifies email and continues to account creation" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        post signup_path, params: { signup: { email_address: "new-email-code@example.com" } }
+      end
+      assert_redirected_to email_code_path
+      perform_enqueued_jobs
+      code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+      post email_code_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "joining via email redeems the join code after verification" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    assert_difference -> { User.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "new-joiner@example.com" }
+      assert_redirected_to email_code_path(script_name: nil)
+      perform_enqueued_jobs
+      code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+      post email_code_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+
+  test "rejects incorrect and expired codes" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      post email_code_path, params: { code: "XXXXXX" }
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+
+      travel 16.minutes do
+        perform_enqueued_jobs
+        code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+        post email_code_path, params: { code: code }
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+end
+
+class EmailCodeJoinExpiryTest < ActionDispatch::IntegrationTest
+  test "does not join when the invitation has been used up before verification" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "late-joiner@example.com" }
+    perform_enqueued_jobs
+    code = ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    assert_no_difference -> { User.count } do
+      post email_code_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
