diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..0e73d31
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = { endpoint: "https://push.example.test/one", p256dh_key: "public", auth_key: "secret" }
+  end
+
+  test "registering the same device twice updates rather than duplicating it" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      2.times do
+        post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+        assert_response :success
+      end
+    end
+    assert_equal "secret", @user.push_subscriptions.first.auth_key
+  end
+
+  test "turning off one device leaves other devices subscribed" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    other = @user.push_subscriptions.create!(endpoint: "https://push.example.test/other", p256dh_key: "key", auth_key: "auth")
+
+    delete user_push_subscriptions_path(@user), params: { endpoint: @subscription[:endpoint] }, as: :json
+
+    assert_response :no_content
+    assert_equal [ other ], @user.push_subscriptions.reload.to_a
+  end
+
+test "another member can subscribe to the same browser endpoint" do
+  users(:kevin).push_subscriptions.create!(**@subscription)
+
+  post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+  assert_response :success
+  assert_equal 2, PushSubscription.where(endpoint: @subscription[:endpoint]).count
+end
+
+test "cannot remove another member's subscription" do
+  other = users(:kevin).push_subscriptions.create!(**@subscription)
+
+  delete user_push_subscriptions_path(@user), params: { endpoint: @subscription[:endpoint] }, as: :json
+
+  assert_response :no_content
+  assert PushSubscription.exists?(other.id)
+end
+
+  test "cannot register a device for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }, as: :json
+    assert_response :not_found
+  end
+end
diff --git a/test/jobs/notification/push_job_test.rb b/test/jobs/notification/push_job_test.rb
new file mode 100644
index 0000000..50f0b8a
--- /dev/null
+++ b/test/jobs/notification/push_job_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveSupport::TestCase
+  test "sends the tray text and card link to each device" do
+    notification = notifications(:layout_commented_kevin)
+    2.times do |index|
+      notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/#{index}", p256dh_key: "key", auth_key: "auth")
+    end
+
+    with_vapid_keys do
+      messages = []
+      WebPush.expects(:payload_send).twice.with { |**options| messages << options; true }
+      Notification::PushJob.perform_now(notification)
+
+      assert_equal 2, messages.size
+      messages.each do |message|
+        payload = JSON.parse(message[:message])
+        assert_equal notification.push_title, payload["title"]
+        assert_equal notification.push_body, payload["body"]
+        assert_includes payload["url"], "#{notification.account.slug}/cards/"
+      end
+    end
+  end
+
+  test "mentions use the same text as the tray" do
+    notification = notifications(:logo_mentioned_david)
+    notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/mention", p256dh_key: "key", auth_key: "auth")
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |**options|
+        payload = JSON.parse(options[:message])
+        payload["title"] == "#{notification.source.mentioner.first_name} @mentioned you" &&
+          payload["body"] == notification.source.source.mentionable_content.truncate(200) &&
+          payload["url"].include?(notification.account.slug)
+      end
+      Notification::PushJob.perform_now(notification)
+    end
+  end
+
+  test "removes expired devices" do
+    notification = notifications(:layout_commented_kevin)
+    subscription = notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/expired", p256dh_key: "key", auth_key: "auth")
+
+    with_vapid_keys do
+      response = stub(body: "Gone")
+      WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+      Notification::PushJob.perform_now(notification)
+    end
+
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+
+  test "does not send without VAPID keys" do
+    notification = notifications(:layout_commented_kevin)
+    notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/unused", p256dh_key: "key", auth_key: "auth")
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+
+    WebPush.expects(:payload_send).never
+    Notification::PushJob.perform_now(notification)
+  end
+
+  private
+    def with_vapid_keys
+      ENV["VAPID_PUBLIC_KEY"] = "public"
+      ENV["VAPID_PRIVATE_KEY"] = "private"
+      yield
+    ensure
+      ENV.delete("VAPID_PUBLIC_KEY")
+      ENV.delete("VAPID_PRIVATE_KEY")
+    end
+end
