diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..ac057fa
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,129 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// The board owns the drag, rather than the individual card: cards in lazy-loaded
+// column frames are draggable as soon as they arrive.
+export default class extends Controller {
+  static targets = [ "item" ]
+
+  connect() {
+    this.dragStart = this.dragStart.bind(this)
+    this.dragOver = this.dragOver.bind(this)
+    this.drop = this.drop.bind(this)
+    this.dragEnd = this.dragEnd.bind(this)
+
+    this.element.addEventListener("dragstart", this.dragStart)
+    this.element.addEventListener("dragover", this.dragOver)
+    this.element.addEventListener("drop", this.drop)
+    this.element.addEventListener("dragend", this.dragEnd)
+  }
+
+  disconnect() {
+    this.element.removeEventListener("dragstart", this.dragStart)
+    this.element.removeEventListener("dragover", this.dragOver)
+    this.element.removeEventListener("drop", this.drop)
+    this.element.removeEventListener("dragend", this.dragEnd)
+    this.dragEnd()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.removeAttribute("draggable")
+  }
+
+  dragStart(event) {
+    const card = event.target.closest(".card[data-drag-and-drop-target~='item']")
+    if (!card || !this.element.contains(card) || card.dataset.dragSavePending) return
+
+    this.card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    // Don't hide the card in the browser's drag image.
+    requestAnimationFrame(() => {
+      if (this.card === card) card.classList.add("drag-and-drop__dragged-item")
+    })
+  }
+
+  dragOver(event) {
+    if (!this.card) return
+
+    const column = event.target.closest(".cards")
+    const destination = column && this.element.contains(column) && column !== this.card.closest(".cards") ? column : null
+    this.hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+    this.hoveredColumn = destination
+
+    if (destination) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      destination.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  drop(event) {
+    if (!this.card || !this.hoveredColumn || !this.hoveredColumn.contains(event.target)) return
+    event.preventDefault()
+
+    const card = this.card
+    const column = this.hoveredColumn
+    const list = column.querySelector(".cards__list")
+    if (!list) {
+      this.dragEnd()
+      return
+    }
+
+    const source = card.parentElement
+    const next = card.nextSibling
+    const destination = list.querySelector("turbo-frame[role='presentation']") || list
+    const { url, method } = this.requestFor(card, column)
+    this.dragEnd()
+    if (!url) return
+
+    // Do the visual move before issuing the request. Never use a Turbo Stream
+    // response here: its column replacements would move the card a second time.
+    const wasPostponed = card.classList.contains("card--postponed")
+    const wasActive = card.classList.contains("card--active")
+    destination.prepend(card)
+    card.classList.toggle("card--postponed", column.id === "not-now")
+    card.classList.toggle("card--active", column.id !== "not-now" && column.id !== "closed-cards")
+    card.dataset.dragSavePending = "true"
+    const save = method === "delete" ? destroy(url, { responseKind: "json" }) : post(url, { responseKind: "json" })
+    save.then(response => {
+      if (!response.ok) this.restore(card, source, next, wasPostponed, wasActive)
+    }).catch(() => this.restore(card, source, next, wasPostponed, wasActive)).finally(() => {
+      delete card.dataset.dragSavePending
+    })
+  }
+
+  dragEnd() {
+    this.card?.classList.remove("drag-and-drop__dragged-item")
+    this.hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+    this.card = null
+    this.hoveredColumn = null
+  }
+
+  requestFor(card, column) {
+    if (column.id === "not-now") return { url: card.dataset.cardNotNowUrl, method: "post" }
+    if (column.id === "closed-cards") return { url: card.dataset.cardClosureUrl, method: "post" }
+    if (column.id === "maybe") return { url: card.dataset.cardTriageUrl, method: "delete" }
+    if (column.dataset.dragAndDropColumnId && card.dataset.cardTriageUrl) {
+      const url = new URL(card.dataset.cardTriageUrl, window.location.href)
+      url.searchParams.set("column_id", column.dataset.dragAndDropColumnId)
+      return { url: url.toString(), method: "post" }
+    }
+    return {}
+  }
+
+  restore(card, source, next, wasPostponed, wasActive) {
+    card.classList.toggle("card--postponed", wasPostponed)
+    card.classList.toggle("card--active", wasActive)
+    if (source.isConnected && card.isConnected) {
+      source.insertBefore(card, next?.parentNode === source ? next : null)
+    } else {
+      // A refresh may have replaced the original list while saving failed.
+      window.location.reload()
+    }
+  }
+}
