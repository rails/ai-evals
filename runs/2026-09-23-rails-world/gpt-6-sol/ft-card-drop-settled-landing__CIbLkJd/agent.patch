diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..032a1ac
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,77 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:buy_domain)
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+  end
+
+  test "moves cards immediately between statuses and columns without reordering within a column" do
+    move_card from: "maybe", to: dom_id(columns(:writebook_in_progress))
+    assert_equal columns(:writebook_in_progress), @card.reload.column
+
+    move_card from: dom_id(columns(:writebook_in_progress)), to: "not-now"
+    assert @card.reload.postponed?
+
+    move_card from: "not-now", to: "closed-cards"
+    assert @card.reload.closed?
+
+    move_card from: "closed-cards", to: "maybe"
+    assert @card.reload.awaiting_triage?
+  end
+
+  test "dropping in the same column does not reorder cards" do
+    before = page.evaluate_script('Array.from(document.querySelectorAll("#maybe .card")).map(card => card.id)')
+    page.execute_script <<~JS
+      const card = document.querySelector("#maybe ##{dom_id(@card, :article)}")
+      const target = document.querySelector("#maybe")
+      const dataTransfer = new DataTransfer()
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+      target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      target.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+      card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+    JS
+    assert_equal before, page.evaluate_script('Array.from(document.querySelectorAll("#maybe .card")).map(card => card.id)')
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+    assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+    assert @card.reload.awaiting_triage?
+  end
+
+  test "failed saves return the card to its original position" do
+    page.execute_script("window.originalFetch = window.fetch; window.fetch = () => Promise.resolve(new Response('', { status: 422 }))")
+    before = page.evaluate_script('Array.from(document.querySelectorAll("#maybe .card")).map(card => card.id)')
+    move_card from: "maybe", to: dom_id(columns(:writebook_in_progress)), saved: false
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_equal before, page.evaluate_script('Array.from(document.querySelectorAll("#maybe .card")).map(card => card.id)')
+    assert @card.reload.awaiting_triage?
+  end
+
+  private
+    def move_card(from:, to:, saved: true)
+      card_selector = "##{from} ##{dom_id(@card, :article)}"
+      destination_selector = "##{to}"
+      assert_selector card_selector, visible: :all
+      assert_selector "#{destination_selector} .cards__list", visible: :all
+
+      # The result is read in the same JS turn as drop, before the save can finish.
+      moved = page.evaluate_script <<~JS
+        (() => {
+          const card = document.querySelector(#{card_selector.to_json})
+          const target = document.querySelector(#{destination_selector.to_json})
+          const dataTransfer = new DataTransfer()
+          card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+          target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+          target.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+          card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+          return target.contains(card)
+        })()
+      JS
+      assert moved, "the card should already be in the destination at drop"
+      assert_selector "#{destination_selector} ##{dom_id(@card, :article)}", visible: :all if saved
+      assert_no_selector "#{destination_selector} ##{dom_id(@card, :article)}[data-drag-save-pending]", visible: :all, wait: 5
+    end
+end
