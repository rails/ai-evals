+class ActivitiesController < ApplicationController
+  def index
+    activity = Current.user.accessible_events.activity.preloaded
+    activity = activity.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+    activity = activity.where(board_id: params[:board_ids]) if params[:board_ids].present?
+
+    set_page_and_extract_portion_from activity
+  end
+end
