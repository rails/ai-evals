diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..184c29a
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    travel_to Time.utc(2025, 1, 22, 17, 30, 0)
+    events(:layout_assignment_jz).update!(created_at: Time.current.beginning_of_day + 8.hours)
+  end
+
+  test "activity JSON includes accessible timeline events, descriptions and event representations" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = response.parsed_body
+    assert_kind_of Array, activity
+    assert activity.any?
+    assert_equal activity.pluck("created_at").sort.reverse, activity.pluck("created_at")
+    assert_not_includes activity.pluck("action"), "card_collection_changed"
+    assert activity.all? { |event| Event::ACTIVITY_ACTIONS.include?(event.fetch("action")) }
+
+    assignment = activity.find { |event| event["id"] == events(:layout_assignment_jz).id }
+    assert_equal CGI.unescapeHTML(events(:layout_assignment_jz).description_for(users(:kevin)).to_plain_text), assignment["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, assignment["particulars"])
+    assert_equal "Card", assignment["eventable_type"]
+    assert_equal cards(:layout).id, assignment.dig("eventable", "id")
+    assert_equal boards(:writebook).id, assignment.dig("board", "id")
+    assert_equal users(:david).id, assignment.dig("creator", "id")
+    assert_equal card_url(cards(:layout)), assignment["url"]
+
+    comment = activity.find { |event| event["id"] == events(:layout_commented).id }
+    assert_equal "Comment", comment["eventable_type"]
+    assert_equal({}, comment["particulars"])
+    assert_equal card_url(comments(:layout_overflowing_david).card, anchor: "comment_#{comments(:layout_overflowing_david).id}"), comment["url"]
+  end
+
+  test "activity JSON filters by creator and board without leaking inaccessible boards" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ] }
+    assert_response :success
+    assert response.parsed_body.any?
+    assert response.parsed_body.all? { |event| event.dig("creator", "id") == users(:kevin).id && event.dig("board", "id") == boards(:writebook).id }
+
+    private_card = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Secret", status: :published)
+    end
+    private_event = Event.create!(creator: users(:kevin), board: boards(:private), eventable: private_card, action: "card_closed")
+    accesses(:private_kevin).destroy!
+    
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, boards(:private).id ] }
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), private_event.id
+    assert response.parsed_body.all? { |event| event.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "activity particulars handle missing values" do
+    card = cards(:layout)
+    %w[card_board_changed card_title_changed card_triaged card_unassigned].each do |action|
+      Event.create!(creator: users(:kevin), board: card.board, eventable: card, action: action)
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_equal({ "old_board" => "", "new_board" => "" }, response.parsed_body.find { |event| event["action"] == "card_board_changed" }["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, response.parsed_body.find { |event| event["action"] == "card_title_changed" }["particulars"])
+    assert_equal({ "column" => "" }, response.parsed_body.find { |event| event["action"] == "card_triaged" }["particulars"])
+  end
+
+  test "activity includes title changes but excludes deprecated changes and returns plain text" do
+    card = cards(:layout)
+    old_title = card.title
+    Current.set(user: users(:kevin)) { card.update!(title: "Layout <new> & improved") }
+    renamed = card.events.where(action: "card_title_changed").last
+    deprecated = Event.create!(creator: users(:kevin), board: card.board, eventable: card, action: "card_collection_changed")
+
+    get activities_path(format: :json)
+    assert_response :success
+    activity = response.parsed_body
+    assert_not_includes activity.pluck("id"), deprecated.id
+    title_change = activity.find { |event| event["id"] == renamed.id }
+    assert_equal({ "old_title" => old_title, "new_title" => "Layout <new> & improved" }, title_change["particulars"])
+    assert_includes title_change["description"], "<new> & improved"
+    assert_equal card_url(card), title_change["url"]
+  end
+
+  test "activity is paginated with API headers" do
+    card = cards(:layout)
+    18.times do |n|
+      Event.create!(creator: users(:kevin), board: card.board, eventable: card, action: "card_published", created_at: Time.current + n.seconds)
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_equal 15, response.parsed_body.length
+    assert_operator response.headers["X-Total-Count"].to_i, :>, 15
+    assert_includes response.headers["Link"], 'rel="next"'
+
+    get activities_path(format: :json), params: { page: 2 }
+    assert_response :success
+    assert response.parsed_body.any?
+  end
+
+  test "activity exposes board moves and triage details" do
+    card = cards(:layout)
+    moved = Event.create!(creator: users(:kevin), board: card.board, eventable: card, action: "card_board_changed",
+      particulars: { particulars: { old_board: "Old board", new_board: "Writebook" } })
+    triaged = Event.create!(creator: users(:kevin), board: card.board, eventable: card, action: "card_triaged",
+      particulars: { particulars: { column: "In progress" } })
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert_equal({ "old_board" => "Old board", "new_board" => "Writebook" }, response.parsed_body.find { |event| event["id"] == moved.id }["particulars"])
+    assert_equal({ "column" => "In progress" }, response.parsed_body.find { |event| event["id"] == triaged.id }["particulars"])
+  end
+end
