+  test "auto postpone all due at the shortest period" do
+    freeze_time
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    cards(:logo).update!(last_active_at: 3.days.ago - 1.second)
+    cards(:layout).update!(last_active_at: 3.days.ago + 1.second)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:layout).reload.postponed?
+  end
+
+  test "batching due cards with the same activity time" do
+    freeze_time
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    cards(:logo, :layout).each { |card| card.update!(last_active_at: 31.days.ago) }
+
+    due_cards = Card.due_to_be_postponed
+      .where(last_active_at: ..Entropy::AUTO_POSTPONE_PERIODS_IN_DAYS.min.days.ago)
+      .find_each(cursor: [ :last_active_at, :id ], batch_size: 1).to_a
+
+    assert_includes due_cards, cards(:logo)
+    assert_includes due_cards, cards(:layout)
+    assert_equal due_cards.size, due_cards.map(&:id).uniq.size
+  end
