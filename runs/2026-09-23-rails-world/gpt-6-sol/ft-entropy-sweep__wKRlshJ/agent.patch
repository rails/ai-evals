+      # No card can be due before the shortest configurable period has elapsed.
+      # Scan by activity time so the sweep can use the global activity index.
+      due_to_be_postponed
+        .where(last_active_at: ..Entropy::AUTO_POSTPONE_PERIODS_IN_DAYS.min.days.ago)
+        .find_each(cursor: [ :last_active_at, :id ]) do |card|
+          card.auto_postpone(user: card.account.system_user)
+        end
     end
   end
 
