diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..48c2d46 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -59,6 +59,43 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "due scope uses the shortest allowed period only as a prefilter" do
+    freeze_time
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    cards(:logo, :shipping).each(&:published!)
+
+    cards(:logo).update!(last_active_at: 3.days.ago - 1.second)
+    cards(:shipping).update!(last_active_at: 3.days.ago + 1.second)
+
+    assert_includes Card.due_to_be_postponed, cards(:logo)
+    assert_not_includes Card.due_to_be_postponed, cards(:shipping)
+
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+  end
+
+  test "due sweep batches cards with identical activity times" do
+    activity_time = 1.year.ago
+    cards(:logo, :shipping).each do |card|
+      card.published!
+      card.resume
+      card.update!(last_active_at: activity_time)
+    end
+
+    due_ids = Card.due_to_be_postponed.where(id: cards(:logo, :shipping).map(&:id))
+      .find_each(batch_size: 1, cursor: [ :last_active_at, :id ]).map(&:id)
+
+    assert_equal cards(:logo, :shipping).map(&:id).sort, due_ids.sort
+  end
+
+  test "SQLite due sweep searches the global activity index" do
+    if Card.connection.adapter_name == "SQLite"
+      plan = Card.connection.exec_query("EXPLAIN QUERY PLAN #{Card.due_to_be_postponed.limit(1000).order(:last_active_at, :id).to_sql}")
+
+      assert plan.rows.any? { |row| row.last.include?("SEARCH cards USING INDEX index_cards_on_status_and_last_active_at") }
+    end
+  end
+
   test "postponing soon scope" do
     cards(:logo, :shipping).each(&:published!)
 
