@@ -0,0 +1,38 @@
+<% @page_title = "メールアドレスを入力" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Fizzyにログイン</h1>
+
+  <%= form_with url: session_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.email_field :email_address, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "username webauthn", placeholder: "メールアドレスを入力 address…" %>
+      </label>
+    </div>
+
+    <% if Account.accepting_signups? %>
+      <p><strong>初めての方ですか？</strong> <%= link_to "新規登録", new_signup_path %> してアカウントを作成できます。 <strong>アカウントをお持ちですか？</strong> メールアドレスを入力 and we’ll get you signed in.</p>
+    <% else %>
+      <p>メールアドレスを入力 and we’ll get you signed in.</p>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>続ける</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= passkey_sign_in_button "パスキーでログイン", session_passkey_path,
+          options: @authentication_options,
+          mediation: "conditional",
+          error: { class: "txt-negative margin-block-half" },
+          cancellation: { class: "txt-subtle margin-block-half" },
+          class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
