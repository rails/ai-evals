diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..f9a9f8a
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,29 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  SUPPORTED = %w[ en ja ].freeze
+
+  included do
+    around_action :with_locale
+    before_action :select_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_locale(&block)
+      I18n.with_locale(:en, &block)
+    end
+
+    def select_locale
+      requested = params[:locale] if params[:locale].is_a?(String)
+      if SUPPORTED.include?(requested)
+        cookies[:locale] = { value: requested, same_site: :lax }
+        Current.identity&.update!(locale: requested) if Current.identity&.locale != requested
+      end
+
+      preference = requested if SUPPORTED.include?(requested)
+      preference ||= cookies[:locale] if SUPPORTED.include?(cookies[:locale])
+      preference ||= Current.identity&.locale if SUPPORTED.include?(Current.identity&.locale)
+      I18n.locale = preference || :en
+    end
+end
