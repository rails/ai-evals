diff --git a/app/views/mailers/notification/bundle_mailer/notification.ja.html.erb b/app/views/mailers/notification/bundle_mailer/notification.ja.html.erb
new file mode 100644
index 0000000..91bb331
--- /dev/null
+++ b/app/views/mailers/notification/bundle_mailer/notification.ja.html.erb
@@ -0,0 +1,22 @@
+<tr>
+  <td>
+    <h1 class="title">新着通知：<%= l(@bundle.starts_at, format: :long) %></h1>
+    <p class="subtitle margin-block-end-double">
+      通知が<%= link_to "#{@notifications.count}件", notifications_url %><%= "（#{ Current.account.name }）" if @user.identity.accounts.many? %>。
+    </p>
+
+    <% @notifications.group_by { |n| n.card.board }.sort_by { |board, _| board.name.downcase }.each do |board, board_notifications| %>
+      <hr class="notification__board-separator">
+      <h2 class="notification__board"><%= link_to board.name, board %></h2>
+      <% board_notifications.group_by(&:card).each do |card, notifications| %>
+        <%= link_to card, class: "card__title" do %>#<%= card.number %> <%= card_html_title(card) %><% end %>
+        <%= render partial: "notification/bundle_mailer/notification", collection: notifications, as: :notification %>
+      <% end %>
+    <% end %>
+
+    <p class="footer">Fizzyは数時間ごとに新着通知をメールでお知らせします。 <br>
+      <%= link_to "通知メールの頻度を変更", notifications_settings_url %>
+      または <%= link_to "すべての通知メールを停止", new_notifications_unsubscribe_url(access_token: @unsubscribe_token) %>。
+    </p>
+  </td>
+</tr>
diff --git a/app/views/mailers/notification/bundle_mailer/notification.ja.text.erb b/app/views/mailers/notification/bundle_mailer/notification.ja.text.erb
new file mode 100644
index 0000000..c56c763
--- /dev/null
+++ b/app/views/mailers/notification/bundle_mailer/notification.ja.text.erb
@@ -0,0 +1,22 @@
+新着通知：<%= l(@bundle.starts_at, format: :long) %>
+通知が<%= "#{@notifications.count}件あります" %><%= "（#{ Current.account.name }）" if @user.identity.accounts.many? %>。
+
+<% @notifications.group_by { |n| n.card.board }.sort_by { |board, _| board.name.downcase }.each do |board, board_notifications| %>
+<%= board.name %>
+<%= "-" * board.name.length %>
+
+<% board_notifications.group_by(&:card).each do |card, notifications| %>
+<%= "##{ card.number } #{ card.title }" %>
+<%= render partial: "notification/bundle_mailer/notification", collection: notifications, as: :notification %>
+<% end %>
+<% end %>
+
+--------------------------------------------------------------------------------
+
+Fizzyは数時間ごとに新着通知をメールでお知らせします。
+
+通知メールの頻度を変更：
+<%= notifications_settings_url %>
+
+すべての通知メールを停止：
+<%= new_notifications_unsubscribe_url(access_token: @unsubscribe_token) %>
