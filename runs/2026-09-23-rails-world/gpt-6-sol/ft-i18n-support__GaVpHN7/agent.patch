diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..04b1ede
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "a query choice sticks and an unsupported locale does not replace it" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select 'html[lang="ja"]'
+      assert_select ".header__skip-navigation", text: "メインコンテンツへ移動"
+      assert_equal :en, I18n.locale
+      assert_select "h1", text: "Fizzyにログイン"
+
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select 'html[lang="ja"]'
+    end
+  end
+
+  test "default remains English and a signed-in choice survives a fresh browser" do
+    untenanted do
+      get new_session_path
+      assert_select 'html[lang="en"]'
+    end
+
+    sign_in_as :kevin
+    get root_path, params: { locale: "ja" }
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    reset!
+    sign_in_as :kevin
+    get root_path
+    assert_select 'html[lang="ja"]'
+  end
+  test "a pre-sign-in English choice updates the recipient before queuing the code" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+  
+    untenanted do
+      get new_session_path, params: { locale: "en" }
+      post session_path, params: { email_address: identity.email_address }
+    end
+  
+    assert_equal "en", identity.reload.locale
+  end
+  test "a Japanese choice renders the localized board form" do
+    sign_in_as :kevin
+    get new_board_path, params: { locale: "ja" }
+  
+    assert_response :success
+    assert_select 'html[lang="ja"]'
+    assert_select 'h1', text: '新しいボードを作成'
+  end
+end
diff --git a/test/mailers/japanese_mailer_test.rb b/test/mailers/japanese_mailer_test.rb
new file mode 100644
index 0000000..a16117d
--- /dev/null
+++ b/test/mailers/japanese_mailer_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class JapaneseMailerTest < ActionMailer::TestCase
+  test "magic link uses the identity locale for subject and both bodies" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    message = MagicLinkMailer.sign_in_instructions(MagicLink.create!(identity: identity)).message
+
+    assert_match(/認証コード/, message.subject)
+    assert_match(/ログイン画面/, message.html_part.body.decoded)
+    assert_match(/ログイン画面/, message.text_part.body.decoded)
+  end
+  test "cancellation is Japanese in both parts" do
+    account = accounts(:"37s")
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    account.cancel(initiated_by: user)
+    message = AccountMailer.cancellation(account.cancellation).message
+  
+    assert_match(/解約/, message.subject)
+    assert_match(/削除/, message.html_part.body.decoded)
+    assert_match(/削除/, message.text_part.body.decoded)
+    refute_match(/deleted/, message.text_part.body.decoded)
+  end
+end
