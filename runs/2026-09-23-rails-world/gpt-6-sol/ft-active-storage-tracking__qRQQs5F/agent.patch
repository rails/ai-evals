new file mode 100644
index 0000000..ca973e3
--- /dev/null
+++ b/app/jobs/board/storage_usage_backfill_job.rb
@@ -0,0 +1,17 @@
+# Run after adding the counters to populate boards that already have attachments.
+# Can be restarted safely: the per-board job applies only the difference.
+class Board::StorageUsageBackfillJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform(account_id = nil)
+    step :boards do |step|
+      boards = account_id ? Board.where(account_id: account_id) : Board.all
+      boards.find_each(start: step.cursor) do |board|
+        Board::StorageUsageJob.perform_now(board.id)
+        step.advance! from: board.id
+      end
+    end
+  end
+end
diff --git a/app/jobs/board/storage_usage_job.rb b/app/jobs/board/storage_usage_job.rb
new file mode 100644
index 0000000..4f5f8b6
--- /dev/null
+++ b/app/jobs/board/storage_usage_job.rb
@@ -0,0 +1,37 @@
+class Board::StorageUsageJob < ApplicationJob
+  queue_as :backend
+
+  # The board (or its account) may be gone before this job runs. The board id
+  # is sufficient; do not serialize the account as job context.
+  def initialize(...)
+    super
+    @account = nil
+  end
+
+  def perform(board_id)
+    board = Board.find_by(id: board_id)
+    return unless board
+
+    board.with_lock do
+      total = bytes_for("Card", "image", Card.where(board_id: board.id)) +
+        bytes_for("ActionText::RichText", "embeds", rich_texts_for("Board", "public_description", Board.where(id: board.id))) +
+        bytes_for("ActionText::RichText", "embeds", rich_texts_for("Card", "description", Card.where(board_id: board.id))) +
+        bytes_for("ActionText::RichText", "embeds", rich_texts_for("Comment", "body", Comment.where(card_id: Card.where(board_id: board.id).select(:id))))
+
+      difference = total - board.bytes_used
+      if difference != 0
+        board.update_columns(bytes_used: total)
+        Account.update_counters(board.account_id, bytes_used: difference)
+      end
+    end
+  end
+
+  private
+    def rich_texts_for(type, name, records)
+      ActionText::RichText.where(record_type: type, name: name, record_id: records.select(:id)).select(:id)
+    end
+
+    def bytes_for(type, name, records)
+      ActiveStorage::Attachment.joins(:blob).where(record_type: type, name: name, record_id: records.select(:id)).sum("active_storage_blobs.byte_size")
+    end
+end
