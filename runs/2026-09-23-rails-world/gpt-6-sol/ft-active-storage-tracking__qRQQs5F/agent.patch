diff --git a/app/models/concerns/storage_usage_tracking.rb b/app/models/concerns/storage_usage_tracking.rb
new file mode 100644
index 0000000..89f170a
--- /dev/null
+++ b/app/models/concerns/storage_usage_tracking.rb
@@ -0,0 +1,31 @@
+# Attachment records can disappear before their jobs run. Capture the board before
+# destruction so removals (including rich text removal) still invalidate its total.
+module StorageUsageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_board
+    after_create_commit :recalculate_storage_usage
+    after_destroy_commit :recalculate_storage_usage
+  end
+
+  private
+    def remember_storage_board
+      @storage_board_id = storage_board_id
+    end
+
+    def recalculate_storage_usage
+      if board_id = @storage_board_id || storage_board_id
+        Board::StorageUsageJob.perform_later(board_id)
+      end
+    end
+
+    def storage_board_id
+      case record
+      when Board then record.id if record.persisted?
+      when Card then record.board_id
+      when Comment then record.card&.board_id
+      when ActionText::RichText then record.storage_board_id
+      end
+    end
+end
