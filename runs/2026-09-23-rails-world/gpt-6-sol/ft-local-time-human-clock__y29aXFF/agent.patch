index 0000000..5e35ec0
--- /dev/null
+++ b/test/helpers/local_time_helper_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class LocalTimeHelperTest < ActionView::TestCase
+  test "renders a raw timestamp for the browser instead of server-formatted text" do
+    timestamp = Time.iso8601("2025-09-17T23:42:00+02:00")
+
+    html = local_time_tag(timestamp)
