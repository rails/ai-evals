diff --git a/script/check_local_times.html b/script/check_local_times.html
new file mode 100644
index 0000000..b83201c
--- /dev/null
+++ b/script/check_local_times.html
@@ -0,0 +1,33 @@
+<!doctype html>
+<meta charset="utf-8">
+<div id="result">waiting</div>
+<script type="module">
+  import { formatLocalTime } from "../app/javascript/helpers/local_time.js"
+  const now = new Date(2025, 8, 17, 0, 30)
+  const cases = [
+    [new Date(2025, 8, 16, 23, 30), "yesterday"],
+    [new Date(2025, 8, 18, 0, 15), "tomorrow"],
+    [new Date(2025, 8, 14), "3 days ago"],
+    [new Date(2025, 8, 20), "in 3 days"],
+    [new Date(2025, 8, 12), "5 days ago"],
+    [new Date(2025, 8, 9), "Sep 9"],
+    [new Date(2024, 8, 12), "Sep 12, 2024"],
+    [new Date(2025, 8, 17, 0, 15), "12:15 AM"]
+  ]
+  const localMidnight = new Date("2025-09-17T06:30:00Z")
+  if (localMidnight.getHours() !== 23 || localMidnight.getDate() !== 16) {
+    document.querySelector("#result").textContent = "Timezone setup failed"
+    throw new Error("Run this check with TZ=America/Los_Angeles")
+  }
+  cases.push([new Date("2025-09-17T06:30:00Z"), "yesterday"])
+  const dstCases = [
+    [new Date(2025, 2, 8, 23, 30), new Date(2025, 2, 9, 3, 30), "yesterday"],
+    [new Date(2025, 10, 2, 0, 30), new Date(2025, 10, 1, 23, 30), "tomorrow"],
+    [new Date(2026, 0, 1, 0, 30), new Date(2025, 11, 31, 23, 30), "tomorrow"]
+  ]
+  const dstFailures = dstCases.map(([date, current, expected]) => [formatLocalTime(date, "relative", current), expected])
+    .filter(([actual, expected]) => actual !== expected)
+  const failures = cases.map(([date, expected]) => [formatLocalTime(date, "relative", now), expected])
+    .filter(([actual, expected]) => actual !== expected)
+  document.querySelector("#result").textContent = failures.length || dstFailures.length ? JSON.stringify([...failures, ...dstFailures]) : "PASS"
+</script>
diff --git a/script/check_local_times.rb b/script/check_local_times.rb
new file mode 100644
index 0000000..8e9dba0
--- /dev/null
+++ b/script/check_local_times.rb
@@ -0,0 +1,12 @@
+# Run with: ruby script/check_local_times.rb
+# Pagination dates are URL parameters, not rendered dates.
+views = Dir['app/views/**/*.erb'].reject { |path| path.include?('/mailers/') }
+views += %w[app/models/user/day_timeline/column.rb app/helpers/bridge_helper.rb]
+server_formatting = views.filter_map do |path|
+  text = File.read(path)
+  text = text.gsub(/strftime\("%Y-%m-%d"\)/, '')
+  path if text.match?(/strftime\(|time_ago_in_words\(/)
+end
+abort "Server-rendered times remain in: #{server_formatting.join(', ')}" if server_formatting.any?
+abort 'Missing browser time controller' unless File.exist?('app/javascript/controllers/local_time_controller.js')
+puts 'All page templates use browser-rendered timestamps'
