diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..799b0b1
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    // Relative labels can change while a cached page remains open.
+    if (this.formatValue === "relative") {
+      this.timer = setInterval(() => this.render(), 60_000)
+    }
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const date = parseLocalTime(this.element.dateTime)
+    if (Number.isNaN(date.getTime())) return
+
+    this.element.textContent = formatLocalTime(date, this.formatValue)
+    this.element.title = new Intl.DateTimeFormat(undefined, { dateStyle: "full", timeStyle: "short" }).format(date)
+  }
+}
+
+function parseLocalTime(value) {
+  // A date without a time is a calendar date, not UTC midnight.
+  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  }
+
+  return new Date(value)
+}
diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..0b5ef2b
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,27 @@
+export function formatLocalTime(date, format = "relative", now = new Date()) {
+  const time = () => new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(date)
+  const dateLabel = (options) => new Intl.DateTimeFormat(undefined, options).format(date)
+  const shortDate = () => dateLabel({ month: "short", day: "numeric", ...(date.getFullYear() !== now.getFullYear() ? { year: "numeric" } : {}) })
+
+  switch (format) {
+    case "time": return time()
+    case "date": return shortDate()
+    case "stamp": return dateLabel({ month: "short", day: "numeric", year: "numeric" })
+    case "long-date": return dateLabel({ weekday: "long", month: "long", day: "numeric" })
+    case "full": return dateLabel({ weekday: "long", month: "long", day: "numeric" }) + ", " + time()
+    case "numeric": return dateLabel({ month: "numeric", day: "numeric", year: "2-digit" }) + ", " + time()
+    default: {
+      // Compare local calendar days rather than elapsed 24-hour periods. This also
+      // works across DST changes and around midnight in the viewer's timezone.
+      const dayNumber = (value) => Date.UTC(value.getFullYear(), value.getMonth(), value.getDate()) / 86_400_000
+      const days = dayNumber(date) - dayNumber(now)
+
+      if (days === 0) return date <= now ? time() : "today"
+      if (days === -1) return "yesterday"
+      if (days === 1) return "tomorrow"
+      if (days > -7 && days < 0) return `${-days} days ago`
+      if (days < 7 && days > 0) return `in ${days} days`
+      return shortDate()
+    }
+  }
+}
