diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..e766709
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates only accounts canceled more than 30 days ago" do
+    freeze_time
+    overdue = accounts(:"37s")
+    at_boundary = accounts(:initech)
+    active = accounts(:acme)
+    identity = users(:david).identity
+    shared_member = at_boundary.users.create!(name: "Shared member", identity: identity)
+
+    blob = File.open(Rails.root.join("test/fixtures/files/avatar.png")) do |file|
+      users(:david).avatar.attach(io: file, filename: "avatar.png", content_type: "image/png").blob
+    end
+    Storage::Entry.create!(account: overdue, delta: 1, operation: "upload")
+
+    overdue.cancel(initiated_by: users(:david))
+    at_boundary.cancel(initiated_by: at_boundary.users.first)
+    overdue.cancellation.update_column(:created_at, 30.days.ago - 1.second)
+    at_boundary.cancellation.update_column(:created_at, 30.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(overdue.id)
+    assert Account.exists?(at_boundary.id)
+    assert Account.exists?(active.id)
+    assert at_boundary.users.exists?
+    assert Identity.exists?(identity.id)
+    assert User.exists?(shared_member.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+
+    Account::IncinerateDueJob.perform_now
+    assert Account.exists?(at_boundary.id)
+
+    tables = ActiveRecord::Base.connection.tables.select do |table|
+      ActiveRecord::Base.connection.column_exists?(table, :account_id)
+    end
+    tables.each do |table|
+      count = ActiveRecord::Base.connection.select_value(
+        ActiveRecord::Base.sanitize_sql_array([ "SELECT COUNT(*) FROM #{ActiveRecord::Base.connection.quote_table_name(table)} WHERE account_id = ?", overdue.id ])
+      )
+      assert_equal 0, count.to_i, "#{table} still contains data for the canceled account"
+    end
+  end
+
+  test "does not incinerate an account reactivated after being due" do
+    freeze_time
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update_column(:created_at, 31.days.ago)
+    assert_includes Account.due_for_incineration, account
+
+    account.reactivate
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+    assert account.reload.active?
+  end
+end
