diff --git a/test/controllers/public_boards_test.rb b/test/controllers/public_boards_test.rb
new file mode 100644
index 0000000..d7d9f87
--- /dev/null
+++ b/test/controllers/public_boards_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class PublicBoardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "only admins can publish and unpublish" do
+    get board_path(@board, format: :json)
+    assert_nil response.parsed_body["public_url"]
+
+    logout_and_sign_in_as :jz
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_nil @board.reload.publication_key
+
+    logout_and_sign_in_as :kevin
+    post board_publication_path(@board)
+    assert_response :redirect
+    key = @board.reload.publication_key
+    assert key.present?
+
+    post board_publication_path(@board)
+    assert_equal key, @board.reload.publication_key
+
+    get board_path(@board, format: :json)
+    assert_equal public_board_url(key), response.parsed_body["public_url"]
+
+    delete board_publication_path(@board)
+    assert_response :redirect
+    assert_nil @board.reload.publication_key
+  end
+
+  test "non-admin cannot unpublish" do
+    post board_publication_path(@board)
+    key = @board.reload.publication_key
+    logout_and_sign_in_as :jz
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert_equal key, @board.reload.publication_key
+  end
+
+  test "anonymous public board and direct child URLs exclude drafts and foreign records" do
+    post board_publication_path(@board)
+    key = @board.reload.publication_key
+    card = @board.cards.published.first
+    column = @board.columns.first
+    draft = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:kevin))
+    foreign_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Foreign card", status: :published, creator: users(:kevin))
+    end
+    sign_out
+
+    get public_board_path(key)
+    assert_response :success
+    assert_not_includes response.body, draft.title
+    get public_board_path(key, format: :json)
+    assert_response :success
+    assert_not_includes response.body, draft.title
+    get public_board_column_path(key, column)
+    assert_response :success
+    get public_board_column_path(key, column, format: :json)
+    assert_response :success
+    get public_board_card_path(key, card.number)
+    assert_response :success
+    get public_board_card_path(key, card.number, format: :json)
+    assert_response :success
+    assert_equal card.title, response.parsed_body["title"]
+
+    get public_board_card_path(key, draft.number)
+    assert_response :not_found
+
+    get public_board_card_path(key, foreign_card.number)
+    assert_response :not_found
+    get public_board_card_path(key, 99999999)
+    assert_response :not_found
+    get public_board_column_path(key, "nonexistent-column")
+    assert_response :not_found
+    get public_board_path("wrong-key")
+    assert_response :not_found
+    untenanted do
+      get "/#{accounts(:initech).external_account_id}/public/boards/#{key}"
+      assert_response :not_found
+    end
+
+    sign_in_as :kevin
+    delete board_publication_path(@board)
+    sign_out
+    get public_board_path(key)
+    assert_response :not_found
+  end
+end
