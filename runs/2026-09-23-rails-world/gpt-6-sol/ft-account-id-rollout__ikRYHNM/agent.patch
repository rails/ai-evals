+# Active Storage and Action Text inherit from ActiveRecord::Base rather than
+# ApplicationRecord. Give their tenant data the same account ownership.
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, optional: true
+  before_validation(on: :create) do
+    self.account_id ||= record.respond_to?(:account_id) ? record.account_id : Current.account&.id
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, optional: true
+  before_validation(on: :create) { self.account_id ||= Current.account&.id }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, optional: true
+  before_validation(on: :create) do
+    self.account_id ||= record.respond_to?(:account_id) ? record.account_id : Current.account&.id
+  end
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, optional: true
+  before_validation(on: :create) { self.account_id ||= blob.account_id }
+end
