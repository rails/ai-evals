diff --git a/script/check-tenant-columns.rb b/script/check-tenant-columns.rb
new file mode 100644
index 0000000..6f2e34e
--- /dev/null
+++ b/script/check-tenant-columns.rb
@@ -0,0 +1,11 @@
+# Run with bin/rails runner script/check-tenant-columns.rb
+excluded = %w[accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys]
+connection = ActiveRecord::Base.connection
+abort "Load the primary schema first" unless connection.data_source_exists?("accounts")
+missing = connection.tables.grep_v(/\A(?:sqlite_|schema_migrations|ar_internal_metadata|search_records_fts)/).reject { |table| excluded.include?(table) }.filter_map do |table|
+  column = connection.columns(table).find { |c| c.name == "account_id" }
+  next if column && !column.null && connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+  table
+end
+abort "Missing required indexed account_id: #{missing.join(', ')}" if missing.any?
+puts "Tenant columns present"
