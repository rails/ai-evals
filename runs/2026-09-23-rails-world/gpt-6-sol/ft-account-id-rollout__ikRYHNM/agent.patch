--- /dev/null
+++ b/app/models/concerns/tenant_account_assignment.rb
@@ -0,0 +1,39 @@
+module TenantAccountAssignment
+  extend ActiveSupport::Concern
+
+  # Satellite records don't all have an account association. Set the tenant
+  # from their owner when creating through an association (including while
+  # creating a new account, when Current.account may be a different tenant).
+  OWNER_ASSOCIATIONS = {
+    "entropies" => :container,
+    "storage_totals" => :owner,
+    "reactions" => :reactable,
+    "mentions" => :mentioner,
+    "assignees_filters" => :filter,
+    "assigners_filters" => :filter,
+    "boards_filters" => :filter,
+    "closers_filters" => :filter,
+    "creators_filters" => :filter,
+    "filters_tags" => :filter
+  }.freeze
+
+  included do
+    before_validation :assign_tenant_account_id, on: :create
+  end
+
+  private
+    def assign_tenant_account_id
+      return unless has_attribute?(:account_id) && account_id.nil?
+
+      association = OWNER_ASSOCIATIONS[self.class.table_name] ||
+        %i[board card user creator filter webhook account].find { |name| self.class.reflect_on_association(name) }
+      owner = public_send(association) if association && respond_to?(association)
+      self.account_id = if owner.is_a?(Account)
+        owner.id
+      elsif owner.respond_to?(:account_id)
+        owner.account_id
+      else
+        Current.account&.id
+      end
+    end
+end
