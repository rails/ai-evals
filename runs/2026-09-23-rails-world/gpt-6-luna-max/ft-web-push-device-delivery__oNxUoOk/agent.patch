diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..f112c6d 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,46 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+self.addEventListener("push", (event) => {
+  let payload = {}
+
+  if (event.data) {
+    try {
+      payload = event.data.json()
+    } catch (error) {
+      payload = { body: event.data.text() }
+    }
+  }
+
+  event.waitUntil(self.registration.showNotification(payload.title || "Fizzy", {
+    body: payload.body || "",
+    icon: "/app-icon.png",
+    badge: "/app-icon-192.png",
+    tag: payload.tag,
+    data: { url: payload.url || "/" }
+  }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const destination = event.notification.data && event.notification.data.url
+  if (!destination) return
+
+  event.waitUntil((async () => {
+    const url = new URL(destination, self.location.origin)
+    if (url.origin !== self.location.origin) return
+
+    const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+    for (const client of clients) {
+      if (new URL(client.url).origin === self.location.origin) {
+        if (typeof client.navigate === "function") await client.navigate(url.href)
+        return client.focus()
+      }
+    }
+
+    return self.clients.openWindow(url.href)
+  })())
+})
+
 TurboOffline.start()
