diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..f037bd0
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create stores a subscription for this user and account" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+    subscription = PushSubscription.sole
+    assert_equal @user, subscription.user
+    assert_equal Current.account, subscription.account
+    assert_equal subscription_params.dig(:push_subscription, :endpoint), subscription.endpoint
+    assert_equal subscription.id, response.parsed_body["id"]
+  end
+
+  test "create updates keys instead of duplicating the same device" do
+    post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    subscription = PushSubscription.sole
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: subscription_params(p256dh_key: "rotated-public-key", auth_key: "rotated-auth-key"),
+        as: :json
+    end
+
+    assert_response :ok
+    assert_equal "rotated-public-key", subscription.reload.p256dh_key
+    assert_equal "rotated-auth-key", subscription.auth_key
+    assert_equal subscription.id, response.parsed_body["id"]
+  end
+
+  test "create rejects an insecure endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: subscription_params(endpoint: "http://push.example.test/subscription"),
+        as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert response.parsed_body["endpoint"].present?
+  end
+
+  test "cannot create a subscription for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: subscription_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot create a subscription for a user in another account" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:mike)), params: subscription_params, as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy removes one device subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscription/one",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy can remove the current device by endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscription/two",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscriptions_path(@user),
+        params: { push_subscription: { endpoint: subscription.endpoint } },
+        as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  private
+    def subscription_params(endpoint: "https://push.example.test/subscription/device", p256dh_key: "public-key", auth_key: "auth-key")
+      {
+        push_subscription: {
+          endpoint: endpoint,
+          p256dh_key: p256dh_key,
+          auth_key: auth_key
+        }
+      }
+    end
+end
diff --git a/test/jobs/notification/push_job_test.rb b/test/jobs/notification/push_job_test.rb
new file mode 100644
index 0000000..1263107
--- /dev/null
+++ b/test/jobs/notification/push_job_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  test "push content matches the tray and opens its card" do
+    notification_records = [ notifications(:logo_assignment_kevin), notifications(:logo_mentioned_david) ]
+    subscriptions = notification_records.map do |notification|
+      notification.user.push_subscriptions.create!(
+        endpoint: "https://push.example.test/subscription/#{notification.id}",
+        p256dh_key: "public-key",
+        auth_key: "auth-key"
+      )
+    end
+
+    with_vapid_keys do
+      notification_records.zip(subscriptions).each do |notification, subscription|
+        source = notification.source
+        helpers = ApplicationController.helpers
+        title, body = if source.is_a?(Mention)
+          [ helpers.mention_notification_title(source), helpers.mention_notification_body(source) ]
+        else
+          [ helpers.event_notification_title(source), helpers.event_notification_body(source) ]
+        end
+        payload = {
+          title: title,
+          body: body,
+          url: Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug),
+          tag: notification.id
+        }
+
+        WebPush.expects(:payload_send).with(
+          endpoint: subscription.endpoint,
+          p256dh: subscription.p256dh_key,
+          auth: subscription.auth_key,
+          message: payload.to_json,
+          vapid: PushSubscription.vapid_options,
+          ttl: 1.day.to_i
+        ).returns(:ok)
+
+        Notification::PushJob.new.perform(notification, subscription)
+      end
+    end
+  end
+
+  test "does not send a read notification" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.read
+    subscription = notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscription/read",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    )
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).never
+      Notification::PushJob.new.perform(notification, subscription)
+    end
+  end
+
+  test "expired subscriptions are removed" do
+    subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscription/expired",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    )
+    response = Object.new
+    response.define_singleton_method(:inspect) { "410 Gone" }
+    response.define_singleton_method(:body) { "" }
+    error = WebPush::ExpiredSubscription.new(response, "push.example.test")
+    WebPush.expects(:payload_send).raises(error)
+
+    subscription.deliver(title: "Card", body: "Updated", url: "/cards/1")
+
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+
+  private
+    def with_vapid_keys
+      old_public_key, ENV["VAPID_PUBLIC_KEY"] = ENV["VAPID_PUBLIC_KEY"], "public-vapid-key"
+      old_private_key, ENV["VAPID_PRIVATE_KEY"] = ENV["VAPID_PRIVATE_KEY"], "private-vapid-key"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_public_key
+      ENV["VAPID_PRIVATE_KEY"] = old_private_key
+    end
+end
