diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..de90464
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "requires an HTTPS endpoint and both browser keys" do
+    subscription = users(:david).push_subscriptions.new(
+      endpoint: "http://push.example.test/subscription",
+      p256dh_key: "",
+      auth_key: ""
+    )
+
+    assert_not subscription.valid?
+    assert subscription.errors[:endpoint].present?
+    assert subscription.errors[:p256dh_key].present?
+    assert subscription.errors[:auth_key].present?
+  end
+
+  test "configured requires both VAPID keys" do
+    with_env("VAPID_PUBLIC_KEY" => "public", "VAPID_PRIVATE_KEY" => nil) do
+      assert_not PushSubscription.configured?
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => "public", "VAPID_PRIVATE_KEY" => "private") do
+      assert PushSubscription.configured?
+      assert_equal "public", PushSubscription.vapid_public_key
+    end
+  end
+
+  private
+    def with_env(values)
+      previous_values = values.to_h { |key, _value| [ key, ENV[key] ] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous_values.each { |key, value| ENV[key] = value }
+    end
+end
