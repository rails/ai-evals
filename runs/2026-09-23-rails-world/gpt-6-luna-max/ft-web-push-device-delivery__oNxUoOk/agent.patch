diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..d78a4c2
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,63 @@
+require "digest"
+require "uri"
+
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, presence: true, length: { maximum: 4096 }
+  validates :endpoint_digest, presence: true
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 255 }
+  validate :endpoint_must_use_https
+
+  class << self
+    def configured?
+      vapid_public_key.present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_options
+      {
+        subject: ENV["BASE_URL"].presence || "mailto:#{ENV["MAILER_FROM_ADDRESS"].presence || "sender@example.com"}",
+        public_key: vapid_public_key,
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    end
+
+    def digest(endpoint)
+      Digest::SHA256.hexdigest(endpoint)
+    end
+  end
+
+  def deliver(payload)
+    WebPush.payload_send(
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      message: payload.to_json,
+      vapid: self.class.vapid_options,
+      ttl: 1.day.to_i
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = self.class.digest(endpoint) if endpoint.present?
+    end
+
+    def endpoint_must_use_https
+      if endpoint.present?
+        uri = URI.parse(endpoint)
+        errors.add(:endpoint, "must be a secure URL") unless uri.scheme == "https" && uri.host.present? && uri.userinfo.blank?
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be a secure URL")
+    end
+end
