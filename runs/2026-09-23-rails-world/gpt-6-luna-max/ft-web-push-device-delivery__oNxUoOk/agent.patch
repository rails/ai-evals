@@ -0,0 +1,35 @@
+class Notification::PushJob < ApplicationJob
+  include NotificationsHelper
+
+  queue_as :backend
+
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, Net::OpenTimeout, Net::ReadTimeout,
+    wait: :polynomially_longer, attempts: 5
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification, subscription)
+    if PushSubscription.configured? && notification.unread? &&
+        notification.user_id == subscription.user_id && notification.account.active? && subscription.user.active?
+      subscription.deliver(push_payload(notification))
+    end
+  end
+
+  private
+    def push_payload(notification)
+      source = notification.source
+      title, body = case source
+      when Mention
+        [ mention_notification_title(source), mention_notification_body(source) ]
+      when Event
+        [ event_notification_title(source), event_notification_body(source) ]
+      end
+
+      {
+        title: title,
+        body: body,
+        url: Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug),
+        tag: notification.id
+      }
+    end
+end
