diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..1e44753
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,44 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    attributes = push_subscription_params
+    digest = PushSubscription.digest(attributes.fetch(:endpoint))
+    @push_subscription = @user.push_subscriptions.create_or_find_by!(endpoint_digest: digest) do |subscription|
+      subscription.assign_attributes(attributes)
+    end
+    created = @push_subscription.previously_new_record?
+    @push_subscription.assign_attributes(attributes)
+    @push_subscription.save! if @push_subscription.changed?
+
+    render json: { id: @push_subscription.id }, status: created ? :created : :ok
+  rescue ActiveRecord::RecordInvalid => error
+    render json: error.record.errors, status: :unprocessable_entity
+  end
+
+  def destroy
+    @push_subscription = if params[:id].present?
+      @user.push_subscriptions.find(params[:id])
+    else
+      endpoint = params.expect(push_subscription: :endpoint).fetch(:endpoint)
+      @user.push_subscriptions.find_by!(endpoint_digest: PushSubscription.digest(endpoint))
+    end
+
+    @push_subscription.destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
