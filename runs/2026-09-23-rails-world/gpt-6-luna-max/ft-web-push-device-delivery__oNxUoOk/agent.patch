diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..a12bf02
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,218 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "button", "details", "installation", "error" ]
+
+  static values = {
+    configured: Boolean,
+    publicKey: String,
+    subscriptionUrl: String
+  }
+
+  connect() {
+    this.subscription = null
+    this.subscriptionId = null
+    this.registration = null
+    this.buttonTarget.disabled = true
+    this.setOn(false)
+    this.initialize()
+  }
+
+  async initialize() {
+    if (!this.supported()) {
+      this.showError("Push notifications are not available in this browser. Follow the instructions below to enable them.")
+      this.showDetails()
+      this.showInstallation()
+      return
+    }
+
+    try {
+      this.registration = await navigator.serviceWorker.ready
+      this.subscription = await this.registration.pushManager.getSubscription()
+
+      if (this.subscription) {
+        this.setOn(true)
+        if (this.configuredValue) {
+          try {
+            await this.saveSubscription(this.subscription)
+          } catch (error) {
+            this.showError("Couldn't save this device's push subscription. Check your connection and try again.")
+          }
+        }
+      }
+
+      if (!this.configuredValue) {
+        this.showError("Push notifications are not configured on this server.")
+      } else if (Notification.permission === "denied") {
+        this.showPermissionHelp()
+      }
+    } catch (error) {
+      this.showError("Couldn't set up push notifications in this browser.")
+      this.showDetails()
+      this.showInstallation()
+    }
+
+    this.updateButton()
+  }
+
+  async toggle(event) {
+    event.preventDefault()
+
+    if (this.buttonTarget.disabled) return
+
+    this.buttonTarget.disabled = true
+    this.hideError()
+
+    try {
+      if (this.subscription) {
+        await this.unsubscribe()
+      } else {
+        await this.subscribe()
+      }
+    } catch (error) {
+      this.showError("Couldn't update push notifications. Check your browser settings and try again.")
+      this.showDetails()
+    }
+
+    this.updateButton()
+  }
+
+  async subscribe() {
+    let permission = Notification.permission
+    if (permission !== "granted") {
+      permission = await Notification.requestPermission()
+    }
+
+    if (permission !== "granted") {
+      this.showPermissionHelp()
+      return
+    }
+
+    if (!this.registration) {
+      this.registration = await navigator.serviceWorker.ready
+    }
+
+    this.subscription = await this.registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.applicationServerKey()
+    })
+    this.setOn(true)
+    this.hideDetails()
+    if (this.hasInstallationTarget) this.installationTarget.hidden = true
+
+    try {
+      await this.saveSubscription(this.subscription)
+    } catch (error) {
+      this.showError("Couldn't save this device's push subscription. Check your connection and try again.")
+    }
+  }
+
+  async unsubscribe() {
+    const endpoint = this.subscription.endpoint
+    const subscriptionId = this.subscriptionId
+
+    await this.subscription.unsubscribe()
+    this.subscription = null
+    this.subscriptionId = null
+    this.setOn(false)
+
+    if (subscriptionId) {
+      await this.request("DELETE", `${this.subscriptionUrlValue}/${encodeURIComponent(subscriptionId)}`)
+    } else {
+      await this.request("DELETE", this.subscriptionUrlValue, {
+        push_subscription: { endpoint }
+      })
+    }
+  }
+
+  async saveSubscription(subscription) {
+    const keys = subscription.toJSON().keys
+    if (!keys || !keys.p256dh || !keys.auth) {
+      throw new Error("Missing push subscription keys")
+    }
+
+    const result = await this.request("POST", this.subscriptionUrlValue, {
+      push_subscription: {
+        endpoint: subscription.endpoint,
+        p256dh_key: keys.p256dh,
+        auth_key: keys.auth
+      }
+    })
+    this.subscriptionId = result.id
+  }
+
+  async request(method, url, body) {
+    const headers = { Accept: "application/json" }
+    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content
+
+    if (csrfToken) headers["X-CSRF-Token"] = csrfToken
+    if (body) headers["Content-Type"] = "application/json"
+
+    const response = await fetch(url, {
+      method,
+      headers,
+      credentials: "same-origin",
+      body: body ? JSON.stringify(body) : undefined
+    })
+
+    if (!response.ok) {
+      throw new Error(`Push subscription request failed (${response.status})`)
+    }
+
+    return response.status === 204 ? null : response.json()
+  }
+
+  applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = window.atob(base64)
+
+    return Uint8Array.from(raw, character => character.charCodeAt(0))
+  }
+
+  supported() {
+    return window.isSecureContext && "serviceWorker" in navigator &&
+      "PushManager" in window && "Notification" in window
+  }
+
+  showPermissionHelp() {
+    this.showDetails()
+    this.showError("Notifications are blocked for this site. Change your browser or device settings to receive them here.")
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+  }
+
+  showInstallation() {
+    if (this.hasInstallationTarget) this.installationTarget.hidden = false
+  }
+
+  showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+
+  hideError() {
+    this.errorTarget.hidden = true
+    this.errorTarget.textContent = ""
+  }
+
+  setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+    this.buttonTarget.textContent = on ? "Turn off on this device" : "Turn on for this device"
+    this.buttonTarget.setAttribute("aria-pressed", on.toString())
+  }
+
+  updateButton() {
+    if (!this.supported() || (!this.configuredValue && !this.subscription)) {
+      this.buttonTarget.disabled = true
+    } else {
+      this.buttonTarget.disabled = Notification.permission === "denied" && !this.subscription
+    }
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
