diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..ec13edf
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,44 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where(burst_at: ..(STALLED_AFTER.ago)) }
+
+    before_update :reset_burst_on_activity
+  end
+
+  def stalled?(as_of: Time.current)
+    burst_at.present? && burst_at <= as_of - STALLED_AFTER
+  end
+
+  def cache_version
+    version = super
+    "#{version}-#{stalled?}" if version
+  end
+
+  def record_burst
+    update! burst_at: Time.current
+  end
+
+  def record_comment_activity(comment)
+    touch_last_active_at
+    record_burst if comment_burst?(comment)
+  end
+
+  private
+    def comment_burst?(comment)
+      window = board.auto_postpone_period.seconds / 3
+      recent_comments_by_person = comments.by_user
+        .where(created_at: (comment.created_at - window)..comment.created_at)
+        .group(:creator_id)
+        .count
+
+      recent_comments_by_person.size >= 2 && recent_comments_by_person.values.sum >= 3
+    end
+
+    def reset_burst_on_activity
+      self.burst_at = nil if (changes_to_save.keys - %w[burst_at updated_at]).any?
+    end
+end
