diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..307ceee
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people within a third of the board period create a stalled timer" do
+    freeze_time do
+      card = create_published_card
+      now = Time.current
+
+      with_current_user(:david) do
+        card.comments.create! creator: users(:david), body: "First", created_at: now - 20.days
+        card.comments.create! creator: users(:kevin), body: "Second", created_at: now - 10.days
+        card.comments.create! creator: users(:jz), body: "Third", created_at: now
+      end
+
+      assert_equal now, card.reload.burst_at
+      assert_not card.stalled?
+
+      travel 13.days
+      assert_not card.reload.stalled?
+
+      travel 1.day
+      assert card.reload.stalled?
+    end
+  end
+
+  test "comments by only one person do not create a burst" do
+    freeze_time do
+      card = create_published_card
+
+      with_current_user(:david) do
+        3.times { card.comments.create! creator: users(:david), body: "Still discussing" }
+      end
+
+      assert_nil card.reload.burst_at
+    end
+  end
+
+  test "comments outside the board-specific burst window do not create a burst" do
+    freeze_time do
+      card = create_published_card
+      now = Time.current
+
+      with_current_user(:david) do
+        card.comments.create! creator: users(:david), body: "Too early", created_at: now - 31.days
+        card.comments.create! creator: users(:kevin), body: "Second", created_at: now - 10.days
+        card.comments.create! creator: users(:jz), body: "Third", created_at: now
+      end
+
+      assert_nil card.reload.burst_at
+    end
+  end
+
+  test "assignment and reopening create bursts" do
+    freeze_time do
+      assigned_card = create_published_card
+      with_current_user(:david) do
+        assigned_card.toggle_assignment(users(:kevin))
+      end
+      assert_equal Time.current, assigned_card.reload.burst_at
+
+      reopened_card = cards(:shipping)
+      reopened_card.reopen
+      assert_equal Time.current, reopened_card.reload.burst_at
+    end
+  end
+
+  test "card cache version changes when it becomes stalled" do
+    freeze_time do
+      card = create_published_card
+      card.update_column(:burst_at, 13.days.ago)
+      cache_version = card.cache_version
+
+      travel 1.day
+      assert_not_equal cache_version, card.cache_version
+    end
+  end
+
+  test "a tracked card update resets the burst" do
+    freeze_time do
+      card = create_published_card
+      card.update_column(:burst_at, 3.weeks.ago)
+
+      card.update!(title: "Updated card")
+
+      assert_nil card.reload.burst_at
+      assert_not card.stalled?
+    end
+  end
+
+  test "any later activity resets the burst" do
+    freeze_time do
+      card = create_published_card
+      with_current_user(:david) do
+        card.toggle_assignment(users(:kevin))
+      end
+      assert card.reload.burst_at
+
+      travel 15.days
+      card.comments.create!(creator: users(:david), body: "A follow-up")
+
+      assert_nil card.reload.burst_at
+      assert_not card.stalled?
+    end
+  end
+
+  private
+    def create_published_card
+      boards(:writebook).cards.create!(
+        title: "Card for stall detection",
+        creator: users(:david),
+        status: :published
+      )
+    end
+end
