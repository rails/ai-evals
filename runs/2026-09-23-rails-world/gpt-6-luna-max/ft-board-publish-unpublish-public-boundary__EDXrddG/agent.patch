--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -10,4 +10,22 @@ class Board < ApplicationRecord
 
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+
+  def publish
+    with_lock do
+      update!(public_key: generate_public_key) unless public_key.present?
+    end
+  end
+
+  def unpublish
+    update!(public_key: nil) if public_key.present?
+  end
+
+  private
+    def generate_public_key
+      loop do
+        key = SecureRandom.urlsafe_base64(24)
+        break key unless self.class.exists?(public_key: key)
+      end
+    end
 end
