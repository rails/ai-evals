diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..52d23b2
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  test "shows a published board without authentication and excludes drafts" do
+    board = boards(:writebook)
+    board.publish
+    board.cards.create!(creator: users(:david), last_active_at: Time.current, status: :drafted, title: "A private draft")
+
+    get public_board_path(board.public_key, script_name: nil)
+
+    assert_response :success
+    assert_select "h1", board.name
+    assert_select "a", text: cards(:logo).title
+    assert_no_match "A private draft", response.body
+    get public_board_path(board.public_key, format: :json, script_name: nil), as: :json
+    assert_response :success
+    assert_equal board.name, response.parsed_body["name"]
+    assert_equal public_board_url(board.public_key, script_name: nil), response.parsed_body["public_url"]
+    column_card_numbers = response.parsed_body["columns"].flat_map { |column_json| column_json["cards"].map { |card_json| card_json["number"] } }
+    assert_equal cards(:logo, :layout, :text, :shipping).map(&:number).sort, column_card_numbers.sort
+    assert_equal [ cards(:buy_domain).number ], response.parsed_body["unassigned_cards"].map { |card_json| card_json["number"] }
+  end
+
+  test "opens columns and published cards directly" do
+    board = boards(:writebook)
+    board.publish
+    column = columns(:writebook_triage)
+    card = cards(:logo)
+
+    get public_board_column_path(board.public_key, column, script_name: nil)
+    assert_response :success
+    assert_select "h1", column.name
+    assert_select "a", text: card.title
+    get public_board_column_path(board.public_key, column, format: :json, script_name: nil), as: :json
+    assert_response :success
+    assert_equal column.name, response.parsed_body["name"]
+
+    get public_board_card_path(board.public_key, card.number, format: :json, script_name: nil), as: :json
+    assert_response :success
+    assert_equal card.title, response.parsed_body["title"]
+
+    get public_board_card_path(board.public_key, card.number, script_name: nil)
+    assert_response :success
+    assert_select "h1", card.title
+  end
+
+  test "does not expose unpublished or unrelated records" do
+    board = boards(:writebook)
+    board.publish
+    draft = board.cards.create!(creator: users(:david), last_active_at: Time.current, status: :drafted, title: "A private draft")
+    other_column = boards(:miltons_wish_list).columns.create!(name: "Other column")
+
+    get public_board_card_path(board.public_key, draft.number, script_name: nil)
+    assert_response :not_found
+
+    get public_board_column_path(board.public_key, other_column, script_name: nil)
+    assert_response :not_found
+
+    get public_board_path("not-a-public-key", script_name: nil)
+    assert_response :not_found
+  end
+end
