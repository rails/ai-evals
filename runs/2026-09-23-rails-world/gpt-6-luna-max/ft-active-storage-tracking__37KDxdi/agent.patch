diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..df324e6
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "an account and its boards count images and embedded files" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    private_board = boards(:private)
+
+    card.image.attach(blob_with_size(3))
+    card.update!(description: attachment_html(blob_with_size(5)))
+    card.comments.create!(body: attachment_html(blob_with_size(7)), creator: users(:david))
+    board.update!(public_description: attachment_html(blob_with_size(11)))
+    private_board.update!(public_description: attachment_html(blob_with_size(13)))
+
+    # Attachments unrelated to boards are not included in storage usage.
+    users(:david).avatar.attach(blob_with_size(17))
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 26, board.reload.bytes_used
+    assert_equal 13, private_board.reload.bytes_used
+    assert_equal 39, accounts("37s").reload.bytes_used
+  end
+
+  test "first access schedules a calculation in the background" do
+    board = boards(:writebook)
+
+    assert_equal 0, board.bytes_used
+    assert_equal 1, enqueued_jobs.count { |job| job[:job] == StorageUsage::RecalculateJob }
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 0, board.reload.bytes_used
+    assert board.bytes_used_calculated_at
+  end
+
+  test "removing embedded files recalculates usage" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = card.comments.create!(body: attachment_html(blob_with_size(31)), creator: users(:david))
+    card.update!(description: attachment_html(blob_with_size(37)))
+    board.update!(public_description: attachment_html(blob_with_size(41)))
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 109, board.reload.bytes_used
+
+    comment.destroy!
+    card.update!(description: "No attachment")
+    board.update!(public_description: "No attachment")
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "an attachment shared within a board is counted once" do
+    blob = blob_with_size(19)
+    board = boards(:writebook)
+    cards(:logo).image.attach(blob)
+    cards(:layout).image.attach(blob)
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 19, board.reload.bytes_used
+    assert_equal 19, accounts("37s").reload.bytes_used
+  end
+
+  test "removing an image recalculates its board and account" do
+    card = cards(:logo)
+    card.image.attach(blob_with_size(23))
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 23, card.board.reload.bytes_used
+
+    card.image.purge_later
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "moving a card recalculates both boards" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    card.image.attach(blob_with_size(29))
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    card.move_to(new_board)
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal 29, new_board.reload.bytes_used
+    assert_equal 29, accounts("37s").reload.bytes_used
+  end
+
+  test "attachments outside boards don't enqueue usage calculations" do
+    assert_no_enqueued_jobs only: StorageUsage::RecalculateJob do
+      users(:david).avatar.attach(blob_with_size(43))
+    end
+  end
+
+  test "a change during a calculation schedules another pass" do
+    board = boards(:writebook)
+    board.recalculate_bytes_used_later
+
+    board.define_singleton_method(:calculate_bytes_used) do
+      board.recalculate_bytes_used_later
+      47
+    end
+    board.recalculate_bytes_used_now
+
+    assert board.reload.bytes_used_recalculation_queued?
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 2, enqueued_jobs.count { |job| job[:job] == StorageUsage::RecalculateJob }
+  end
+
+  test "multiple recalculation requests are coalesced while a job is queued" do
+    board = boards(:writebook)
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+      board.recalculate_bytes_used_later
+      board.recalculate_bytes_used_later
+    end
+  end
+
+  private
+    def blob_with_size(size)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * size),
+        filename: "file.txt",
+        content_type: "text/plain",
+        identify: false
+      )
+    end
+
+    def attachment_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
