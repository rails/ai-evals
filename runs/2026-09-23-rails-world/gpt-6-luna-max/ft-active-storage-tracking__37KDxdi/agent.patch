diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..57ed00d
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,100 @@
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  INTERNAL_ATTRIBUTES = %w[
+    bytes_used
+    bytes_used_calculated_at
+    bytes_used_recalculation_queued
+    bytes_used_recalculation_version
+  ].freeze
+
+  def self.calculate_bytes_used(account_id:, board_ids:, card_ids:, comment_ids:)
+    rich_text_ids = ActionText::RichText.where(account_id: account_id).where(
+      "(record_type = ? AND name = ? AND record_id IN (?)) OR " \
+      "(record_type = ? AND name = ? AND record_id IN (?)) OR " \
+      "(record_type = ? AND name = ? AND record_id IN (?))",
+      "Board", "public_description", board_ids,
+      "Card", "description", card_ids,
+      "Comment", "body", comment_ids
+    ).select(:id)
+
+    image_blob_ids = ActiveStorage::Attachment.where(
+      account_id: account_id,
+      record_type: "Card",
+      name: "image",
+      record_id: card_ids
+    ).select(:blob_id)
+
+    embedded_blob_ids = ActiveStorage::Attachment.where(
+      account_id: account_id,
+      record_type: "ActionText::RichText",
+      name: "embeds",
+      record_id: rich_text_ids
+    ).select(:blob_id)
+
+    blob_ids = image_blob_ids.or(embedded_blob_ids)
+
+    ActiveStorage::Blob.where(account_id: account_id, id: blob_ids).sum(:byte_size)
+  end
+
+  def bytes_used
+    if persisted? && self[:bytes_used_calculated_at].nil? && !@bytes_used_calculation_requested
+      recalculate_bytes_used_later(only_if_uncalculated: true)
+      @bytes_used_calculation_requested = true
+    end
+
+    self[:bytes_used] || 0
+  end
+
+  def recalculate_bytes_used_later(only_if_uncalculated: false)
+    return unless persisted?
+
+    # Only the first request needs to enqueue a job. Increment the version for
+    # every change so a running calculation can detect that it needs another pass.
+    should_enqueue = self.class.transaction do
+      record = self.class.lock.find_by(id: id)
+
+      if record && (!only_if_uncalculated || (record[:bytes_used_calculated_at].nil? && !record[:bytes_used_recalculation_queued]))
+        should_enqueue = !record[:bytes_used_recalculation_queued]
+        record.update_columns(
+          bytes_used_recalculation_version: record[:bytes_used_recalculation_version] + 1,
+          bytes_used_recalculation_queued: true
+        )
+        should_enqueue
+      else
+        false
+      end
+    end
+
+    StorageUsage::RecalculateJob.perform_later(self) if should_enqueue
+  end
+
+  def recalculate_bytes_used_now
+    version = self.class.where(id: id).pick(:bytes_used_recalculation_version)
+
+    if version
+      bytes_used = calculate_bytes_used
+      recalculate_bytes_used_if_unchanged(version, bytes_used)
+    end
+  end
+
+  private
+    def recalculate_bytes_used_if_unchanged(version, bytes_used)
+      should_enqueue = self.class.transaction do
+        record = self.class.lock.find_by(id: id)
+
+        if record && record[:bytes_used_recalculation_version] == version
+          record.update_columns(
+            bytes_used: bytes_used,
+            bytes_used_calculated_at: Time.current,
+            bytes_used_recalculation_queued: false
+          )
+          false
+        else
+          record.present?
+        end
+      end
+
+      StorageUsage::RecalculateJob.perform_later(self) if should_enqueue
+    end
+end
diff --git a/app/models/concerns/storage_usage/active_storage_attachment.rb b/app/models/concerns/storage_usage/active_storage_attachment.rb
new file mode 100644
index 0000000..1f09a4d
--- /dev/null
+++ b/app/models/concerns/storage_usage/active_storage_attachment.rb
@@ -0,0 +1,59 @@
+module StorageUsage::ActiveStorageAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :recalculate_storage_usage_later
+    after_destroy :recalculate_storage_usage_later
+  end
+
+  def delete
+    targets = storage_usage_targets
+    super.tap { recalculate_storage_usage_later_for(targets) }
+  end
+
+  private
+    def recalculate_storage_usage_later
+      recalculate_storage_usage_later_for(storage_usage_targets)
+    end
+
+    def recalculate_storage_usage_later_for(targets)
+      targets.each(&:recalculate_bytes_used_later)
+    end
+
+    def storage_usage_targets
+      owner = storage_usage_owner
+
+      if owner
+        board = storage_usage_board(owner)
+        account = Account.find_by(id: account_id)
+
+        [ board, account ].compact.uniq
+      else
+        []
+      end
+    end
+
+    def storage_usage_owner
+      if record_type == "Card" && name == "image"
+        record if record.is_a?(Card)
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text = record
+        if rich_text.is_a?(ActionText::RichText)
+          case [ rich_text.record_type, rich_text.name ]
+          when [ "Board", "public_description" ], [ "Card", "description" ], [ "Comment", "body" ]
+            rich_text.record
+          end
+        end
+      end
+    end
+
+    def storage_usage_board(owner)
+      if owner.is_a?(Board)
+        owner
+      elsif owner.is_a?(Card)
+        owner.board
+      elsif owner.is_a?(Comment)
+        owner.card&.board
+      end
+    end
+end
