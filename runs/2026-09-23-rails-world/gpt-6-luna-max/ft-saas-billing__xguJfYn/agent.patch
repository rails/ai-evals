+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open an account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(accounts(:initech))}']", text: "Initech LLC"
+
+      get saas.admin_account_path(accounts(:initech))
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value=Override]"
+    assert_select "button", text: "Reset"
+  end
+
+  test "non-staff cannot view account tools" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(account)
+    end
+
+    assert_response :redirect
+    assert account.reload.comped?
+    assert_equal "Unlimited", account.billing_plan.name
+
+    untenanted do
+      delete saas.admin_account_billing_waiver_path(account)
+    end
+
+    assert_response :redirect
+    assert_not account.reload.comped?
+    assert_equal "Free", account.billing_plan.name
+  end
+
+  test "staff can override usage and reset it" do
+    sign_in_as :david
+    account = accounts(:initech)
+    account.update_column(:cards_count, 10)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account), params: {
+        overridden_limit: { card_count: 1_000, bytes_used: 2.gigabytes }
+      }
+    end
+
+    assert_response :redirect
+    assert_equal 1_000, account.reload.card_count
+    assert_equal 2.gigabytes, account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account)
+    end
+
+    assert_response :redirect
+    assert_nil account.reload.overridden_limit
+    assert_equal 10, account.card_count
+    assert_equal 0, account.bytes_used
+  end
+end
