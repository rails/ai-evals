diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..5ab6497
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,47 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+    <p>
+      Plan: <strong><%= @account.billing_plan.name %></strong>
+      <% if @account.comped? %>(comped)<% end %>
+    </p>
+    <div class="flex gap-half">
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Usage</h2>
+    </header>
+    <p>Card count: <strong><%= number_with_delimiter(@account.card_count) %></strong></p>
+    <p>Bytes used: <strong><%= number_with_delimiter(@account.bytes_used) %></strong> (<%= number_to_human_size(@account.bytes_used) %>)</p>
+
+    <%= form_with model: @overridden_limit,
+          url: saas.admin_account_overridden_limit_path(@account),
+          scope: :overridden_limit,
+          method: :post,
+          class: "flex flex-column gap-half" do |form| %>
+      <div>
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, min: 0, class: "input" %>
+      </div>
+      <div>
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, min: 0, class: "input" %>
+      </div>
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn" %>
+  </div>
+</section>
