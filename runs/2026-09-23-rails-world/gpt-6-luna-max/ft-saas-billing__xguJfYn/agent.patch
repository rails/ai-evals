diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..cca7e28
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+require "ostruct"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription webhook grants the matching plan and storage allowance" do
+    account = accounts(:initech)
+    subscription = stripe_subscription(account, "active", [ "price_monthly", "price_extra" ])
+    event = OpenStruct.new(type: "customer.subscription.created", data: OpenStruct.new(object: subscription))
+
+    with_env("STRIPE_WEBHOOK_SECRET" => "whsec_test", "STRIPE_MONTHLY_V1_PRICE_ID" => "price_monthly", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_extra") do
+      Stripe::Webhook.expects(:construct_event).with(anything, "signature", "whsec_test").returns(event)
+
+      untenanted do
+        post "/stripe/webhooks", params: {}, headers: { "Stripe-Signature" => "signature" }, as: :json
+      end
+    end
+
+    assert_response :success
+    assert_equal "unlimited_plus", account.reload.subscription.plan_key
+    assert_equal "Unlimited+", account.billing_plan.name
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "checkout completion associates the new Stripe customer and plan" do
+    account = accounts(:initech)
+    checkout = OpenStruct.new(
+      client_reference_id: account.id,
+      customer: "cus_checkout",
+      subscription: "sub_checkout",
+      metadata: { account_id: account.id, plan_key: "unlimited" }
+    )
+    event = OpenStruct.new(type: "checkout.session.completed", data: OpenStruct.new(object: checkout))
+
+    with_env("STRIPE_WEBHOOK_SECRET" => "whsec_test") do
+      Stripe::Webhook.expects(:construct_event).returns(event)
+
+      untenanted do
+        post "/stripe/webhooks", params: {}, headers: { "Stripe-Signature" => "signature" }, as: :json
+      end
+    end
+
+    assert_response :success
+    assert_equal "cus_checkout", account.reload.subscription.stripe_customer_id
+    assert_equal "sub_checkout", account.subscription.stripe_subscription_id
+    assert_equal "unlimited", account.subscription.plan_key
+  end
+
+  test "subscription deletion returns the account to Free" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_existing",
+      stripe_subscription_id: "sub_existing",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    subscription = stripe_subscription(account, "canceled", [ "price_monthly" ])
+    event = OpenStruct.new(type: "customer.subscription.deleted", data: OpenStruct.new(object: subscription))
+
+    with_env("STRIPE_WEBHOOK_SECRET" => "whsec_test", "STRIPE_MONTHLY_V1_PRICE_ID" => "price_monthly") do
+      Stripe::Webhook.expects(:construct_event).returns(event)
+
+      untenanted do
+        post "/stripe/webhooks", params: {}, headers: { "Stripe-Signature" => "signature" }, as: :json
+      end
+    end
+
+    assert_response :success
+    assert_equal "Free", account.reload.billing_plan.name
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "invalid Stripe signatures are rejected" do
+    with_env("STRIPE_WEBHOOK_SECRET" => "whsec_test") do
+      Stripe::Webhook.expects(:construct_event).raises(Stripe::SignatureVerificationError.new("invalid signature", "bad"))
+
+      untenanted do
+        post "/stripe/webhooks", params: {}, headers: { "Stripe-Signature" => "bad" }, as: :json
+      end
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def stripe_subscription(account, status, price_ids)
+      OpenStruct.new(
+        id: "sub_#{account.id}",
+        customer: "cus_#{account.id}",
+        status: status,
+        current_period_end: 1.month.from_now.to_i,
+        cancel_at: nil,
+        metadata: { account_id: account.id, plan_key: "unlimited" },
+        items: OpenStruct.new(data: price_ids.map { |price_id| OpenStruct.new(price: OpenStruct.new(id: price_id)) })
+      )
+    end
+
+    def with_env(values)
+      previous_values = values.keys.to_h { |key| [ key, ENV[key] ] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous_values.each { |key, value| ENV[key] = value }
+    end
+end
