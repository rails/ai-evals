diff --git a/saas/test/controllers/account/billing_test.rb b/saas/test/controllers/account/billing_test.rb
new file mode 100644
index 0000000..723b459
--- /dev/null
+++ b/saas/test/controllers/account/billing_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+require "ostruct"
+
+class Account::BillingSettingsTest < ActionDispatch::IntegrationTest
+  test "account admins see their current plan and Upgrade in settings" do
+    sign_in_as :mike
+    account = accounts(:initech)
+
+    get account_settings_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_select "strong", text: "Free"
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "non-admins can read the Upgrade pitch but cannot start checkout" do
+    sign_in_as :jz
+    account = accounts(:"37s")
+
+    get saas.account_subscription_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select "body", text: /Ask an account admin to upgrade/
+    assert_select "form[action$='/account/checkout']", count: 0
+  end
+
+  test "the plan page shows the approved paid options" do
+    sign_in_as :mike
+    account = accounts(:initech)
+
+    get saas.account_subscription_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_select "strong", text: "Unlimited+"
+    assert_select "body", text: /\$20\/month/
+    assert_select "body", text: /\$25\/month/
+    assert_select "body", text: /5 GB storage/
+    assert_select "body", text: /500 GB storage/
+  end
+
+  test "an active subscriber is sent to the customer portal to change plans" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.create_subscription!(stripe_customer_id: "cus_active", plan_key: "unlimited", status: "active")
+
+    get saas.account_subscription_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select "form[action$='/account/portal']"
+    assert_select "form[action$='/account/checkout']", count: 0
+  end
+
+  test "an account admin starts hosted Stripe Checkout for their selected plan" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    with_env("STRIPE_MONTHLY_V1_PRICE_ID" => "price_monthly", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_extra") do
+      Stripe::Checkout::Session.expects(:create).with do |params|
+        params[:mode] == "subscription" &&
+          params[:line_items] == [
+            { price: "price_monthly", quantity: 1 },
+            { price: "price_extra", quantity: 1 }
+          ] &&
+          params[:client_reference_id] == account.id &&
+          params[:metadata] == { account_id: account.id, plan_key: "unlimited_plus" } &&
+          params[:subscription_data][:metadata][:plan_key] == "unlimited_plus" &&
+          params[:customer_email] == identities(:mike).email_address &&
+          params[:success_url].include?(account.slug) &&
+          params[:cancel_url].include?(account.slug)
+      end.returns(OpenStruct.new(url: "https://checkout.stripe.com/session"))
+
+      post saas.account_checkout_path(script_name: account.slug), params: { plan: "unlimited_plus" }
+    end
+
+    assert_redirected_to "https://checkout.stripe.com/session"
+  end
+
+  test "an account admin can open the Stripe customer portal" do
