diff --git a/saas/app/views/account/subscriptions/show.html.erb b/saas/app/views/account/subscriptions/show.html.erb
new file mode 100644
index 0000000..31f8f68
--- /dev/null
+++ b/saas/app/views/account/subscriptions/show.html.erb
@@ -0,0 +1,61 @@
+<% @page_title = "Plan and billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Your plan</h2>
+    </header>
+    <p>
+      <strong><%= Current.account.billing_plan.name %></strong>
+      <% if Current.account.comped? %>
+        (comped)
+      <% else %>
+        — <%= Current.account.billing_plan.price_description %>
+      <% end %>
+      <br>
+      <span class="txt-small txt-ink-medium">
+        <%= Current.account.billing_plan.card_limit ? "#{number_with_delimiter(Current.account.billing_plan.card_limit)} cards" : "Unlimited cards" %>,
+        <%= number_to_human_size(Current.account.billing_plan.storage_limit) %> storage
+      </span>
+    </p>
+    <% if Current.user.admin? && Current.account.subscription&.stripe_customer_id %>
+      <%= button_to "Manage billing", saas.account_portal_path, class: "btn" %>
+    <% end %>
+  </div>
+
+  <% if Current.account.active_subscription && !Current.user.admin? %>
+    <p>Billing is managed by account admins.</p>
+  <% end %>
+
+  <% unless Current.account.active_subscription %>
+    <div class="settings__panel panel shadow">
+      <header>
+        <h2 class="divider txt-medium margin-block-start">Choose a plan</h2>
+      </header>
+      <div class="flex flex-column gap">
+        <% @plans.each do |plan| %>
+          <div class="flex align-center justify-space-between gap-half">
+            <div>
+              <strong><%= plan.name %></strong> — <%= plan.price_description %>
+              <div class="txt-small txt-ink-medium">
+                Unlimited cards, <%= number_to_human_size(plan.storage_limit) %> storage
+              </div>
+            </div>
+            <% if Current.user.admin? %>
+              <%= button_to "Upgrade", saas.account_checkout_path, params: { plan: plan.key }, class: "btn" %>
+            <% end %>
+          </div>
+        <% end %>
+      </div>
+      <% unless Current.user.admin? %>
