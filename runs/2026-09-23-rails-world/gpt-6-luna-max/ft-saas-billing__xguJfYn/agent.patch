diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..3e087de
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  test "accounts start on the Free plan with the approved limits" do
+    account = accounts(:initech)
+
+    assert_equal "Free", account.billing_plan.name
+    assert_equal "Free", account.plan
+    assert_equal 1_000, account.card_limit
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "the Free card warning counts down from 100 cards remaining" do
+    account = accounts(:initech)
+
+    account.update_column(:cards_count, 900)
+    assert account.nearing_card_limit?
+    assert_equal 100, account.cards_remaining
+
+    account.update_column(:cards_count, 950)
+    assert account.nearing_card_limit?
+    assert_equal 50, account.cards_remaining
+
+    account.update_column(:cards_count, 899)
+    assert_not account.nearing_card_limit?
+  end
+
+  test "the Free limit is reached at 1,000 cards" do
+    account = accounts(:initech)
+
+    account.update_column(:cards_count, 999)
+    assert_not account.exceeding_card_limit?
+    assert_equal 1, account.cards_remaining
+
+    account.update_column(:cards_count, 1_000)
+    assert account.exceeding_card_limit?
+    assert_equal 0, account.cards_remaining
+  end
+
+  test "the Unlimited plan has unlimited cards and 5 GB storage" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    assert_equal "Unlimited", account.billing_plan.name
+    assert_equal 20, account.billing_plan.monthly_price
+    assert_nil account.card_limit
+    assert_not account.exceeding_card_limit?
+    assert_equal 5.gigabytes, account.storage_limit
+  end
+
+  test "the Unlimited+ plan has 500 GB storage" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_unlimited_plus",
+      stripe_subscription_id: "sub_unlimited_plus",
+      plan_key: "unlimited_plus",
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", account.billing_plan.name
+    assert_equal 25, account.billing_plan.monthly_price
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "an inactive subscription returns to Free" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_cancelled",
+      plan_key: "unlimited",
+      status: "canceled"
+    )
+
+    assert_equal "Free", account.billing_plan.name
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "a billing waiver comps an account onto Unlimited" do
+    account = accounts(:initech)
+
+    account.create_billing_waiver!
+
+    assert account.comped?
+    assert_equal "Unlimited", account.billing_plan.name
+    assert_nil account.card_limit
+    assert_equal 5.gigabytes, account.storage_limit
+
+    account.billing_waiver.destroy!
+    assert_not account.comped?
+    assert_equal "Free", account.billing_plan.name
+  end
+
+  test "comping an existing account does not change its paid plan" do
+    account = accounts(:initech)
+    account.create_subscription!(stripe_customer_id: "cus_comped_plus", plan_key: "unlimited_plus", status: "active")
+    account.create_billing_waiver!
+
+    assert account.comped?
+    assert_equal "Unlimited+", account.billing_plan.name
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "usage overrides can independently change card count and bytes used" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 950)
+
+    account.create_overridden_limit!(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert_equal 1_000, account.card_count
+    assert account.exceeding_card_limit?
+    assert_equal 2.gigabytes, account.bytes_used
+    assert account.exceeding_storage_limit?
+
+    account.overridden_limit.destroy!
+
+    assert_equal 950, account.card_count
+    assert_equal 0, account.bytes_used
+  end
+
+  test "the legacy storage exception still overrides the plan allowance" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_storage_exception",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    account.add_storage_exception(2.gigabytes)
+
+    assert_equal 2.gigabytes, account.storage_limit
+  end
+end
