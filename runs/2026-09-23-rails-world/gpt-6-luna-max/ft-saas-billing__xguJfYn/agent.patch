diff --git a/saas/app/controllers/account/checkouts_controller.rb b/saas/app/controllers/account/checkouts_controller.rb
new file mode 100644
index 0000000..c58ec69
--- /dev/null
+++ b/saas/app/controllers/account/checkouts_controller.rb
@@ -0,0 +1,42 @@
+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if plan = Account.plan_for(params[:plan])
+      if plan.paid? && (price_ids = Account.stripe_price_ids_for(plan.key)).any?
+        create_checkout_session(plan, price_ids)
+      else
+        redirect_to saas.account_subscription_path, alert: "That plan isn’t available right now."
+      end
+    else
+      head :unprocessable_entity
+    end
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, severity: :error)
+    redirect_to saas.account_subscription_path, alert: "We couldn’t start checkout. Please try again."
+  end
+
+  private
+    def create_checkout_session(plan, price_ids)
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+
+      checkout_params = {
+        mode: "subscription",
+        line_items: price_ids.map { |price_id| { price: price_id, quantity: 1 } },
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan.key } },
+        success_url: main_app.account_settings_url,
+        cancel_url: saas.account_subscription_url
+      }
+
+      if customer_id = Current.account.subscription&.stripe_customer_id
+        checkout_params[:customer] = customer_id
+      else
+        checkout_params[:customer_email] = Current.identity.email_address
+      end
+
+      checkout = Stripe::Checkout::Session.create(checkout_params)
+      redirect_to checkout.url, allow_other_host: true
+    end
+end
