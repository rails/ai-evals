diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..7aca4eb
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,98 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.body.read,
+      request.headers["Stripe-Signature"],
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    )
+
+    process_event(event)
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError, ArgumentError
+    head :bad_request
+  end
+
+  private
+    def process_event(event)
+      case event.type
+      when "checkout.session.completed"
+        record_checkout(event.data.object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        record_subscription(event.data.object)
+      end
+    end
+
+    def record_checkout(checkout)
+      account = find_account(checkout.client_reference_id || metadata_value(checkout, :account_id))
+      customer_id = stripe_id(checkout.customer)
+      plan_key = metadata_value(checkout, :plan_key)
+
+      if account && customer_id.present?
+        subscription = account.subscription || account.build_subscription
+        attributes = {
+          stripe_customer_id: customer_id,
+          stripe_subscription_id: stripe_id(checkout.subscription)
+        }
+        attributes[:plan_key] = plan_key if Account::Billing::PAID_PLAN_KEYS.include?(plan_key)
+        subscription.update!(attributes)
+      end
+    end
+
+    def record_subscription(stripe_subscription)
+      customer_id = stripe_id(stripe_subscription.customer)
+      account = find_account(metadata_value(stripe_subscription, :account_id)) ||
+        Account::Subscription.find_by(stripe_customer_id: customer_id)&.account
+
+      if account && customer_id.present?
+        subscription = account.subscription || account.build_subscription
+        price_ids = subscription_price_ids(stripe_subscription)
+        plan_key = Account.plan_key_for_stripe_price_ids(price_ids) ||
+          metadata_value(stripe_subscription, :plan_key) || subscription.plan_key
+        plan_key = nil unless Account::Billing::PAID_PLAN_KEYS.include?(plan_key)
+
+        subscription.update!(
+          stripe_customer_id: customer_id,
+          stripe_subscription_id: stripe_id(stripe_subscription.id),
+          plan_key: plan_key,
+          status: stripe_subscription.status,
+          current_period_end: stripe_time(stripe_subscription.current_period_end),
+          cancel_at: stripe_time(stripe_subscription.cancel_at)
+        )
+      end
+    end
+
+    def find_account(id)
+      if id.present?
+        Account.find_by(id: id) || Account.find_by(external_account_id: id.to_i)
+      end
+    end
+
+    def metadata_value(object, key)
+      metadata = object.respond_to?(:metadata) ? object.metadata : nil
+      if metadata.respond_to?(:[])
+        metadata[key.to_s] || metadata[key.to_sym]
+      end
+    end
+
+    def subscription_price_ids(stripe_subscription)
+      items = stripe_subscription.items&.data || []
+      items.filter_map do |item|
+        price = item.respond_to?(:price) ? item.price : nil
+        stripe_id(price)
+      end
+    end
+
+    def stripe_id(value)
+      value.respond_to?(:id) ? value.id : value
+    end
+
+    def stripe_time(value)
+      if value.present?
+        value.respond_to?(:utc) ? value.utc : Time.at(value.to_i).utc
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..4c08502
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,149 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  Plan = Struct.new(:key, :name, :monthly_price, :card_limit, :storage_limit, keyword_init: true) do
+    def paid?
+      monthly_price.positive?
+    end
+
+    def price_description
+      if paid?
+        "$#{monthly_price}/month"
+      else
+        "Free"
+      end
+    end
+  end
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  PLANS = {
+    "free" => Plan.new(key: "free", name: "Free", monthly_price: 0, card_limit: 1_000, storage_limit: 1.gigabyte).freeze,
+    "unlimited" => Plan.new(key: "unlimited", name: "Unlimited", monthly_price: 20, card_limit: nil, storage_limit: 5.gigabytes).freeze,
+    "unlimited_plus" => Plan.new(key: "unlimited_plus", name: "Unlimited+", monthly_price: 25, card_limit: nil, storage_limit: 500.gigabytes).freeze
+  }.freeze
+
+  PAID_PLAN_KEYS = PLANS.keys.excluding("free").freeze
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_active_subscription
+  end
+
+  class_methods do
+    def plan_for(key)
+      PLANS[key.to_s]
+    end
+
+    def stripe_price_ids_for(key)
+      base_price_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"] || ENV["STRIPE_PRICE_UNLIMITED"]
+      extra_storage_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      standalone_plus_price_id = ENV["STRIPE_PRICE_UNLIMITED_PLUS"]
+
+      case key.to_s
+      when "unlimited"
+        [ base_price_id ].compact
+      when "unlimited_plus"
+        if base_price_id.present? && extra_storage_price_id.present?
+          [ base_price_id, extra_storage_price_id ]
+        elsif standalone_plus_price_id.present?
+          [ standalone_plus_price_id ]
+        else
+          []
+        end
+      else
+        []
+      end
+    end
+
+    def plan_key_for_stripe_price_ids(price_ids)
+      price_ids = Array(price_ids).compact
+      extra_storage_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      standalone_plus_price_id = ENV["STRIPE_PRICE_UNLIMITED_PLUS"]
+      base_price_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"] || ENV["STRIPE_PRICE_UNLIMITED"]
+
+      if price_ids.include?(extra_storage_price_id) || price_ids.include?(standalone_plus_price_id)
+        "unlimited_plus"
+      elsif price_ids.include?(base_price_id)
+        "unlimited"
+      end
+    end
+  end
+
+  def billing_plan
+    if active_subscription && (plan = self.class.plan_for(active_subscription.plan_key))
+      plan
+    elsif comped?
+      PLANS.fetch("unlimited")
+    else
+      PLANS.fetch("free")
+    end
+  end
+
+  def plan
+    billing_plan.name
+  end
+
+  def plan_key
+    billing_plan.key
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def paid?
+    comped? || active_subscription.present?
+  end
+
+  def comped?
+    billing_waiver&.persisted? || false
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless comped?
+    else
+      billing_waiver&.destroy!
+    end
+  end
+
+  def card_count
+    if overridden_limit&.persisted? && overridden_limit.card_count
+      overridden_limit.card_count
+    else
+      cards_count
+    end
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_remaining
+    card_limit && [ card_limit - card_count, 0 ].max
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    remaining = cards_remaining
+    remaining.present? && remaining.positive? && remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  private
+    def cancel_active_subscription
+      if active_subscription&.stripe_subscription_id
+        Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+        Stripe::Subscription.cancel(active_subscription.stripe_subscription_id)
+        subscription.update!(status: "canceled")
+      end
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, severity: :error)
+    end
+end
