diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..b46b668
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admin can publish and unpublish a board" do
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert board.reload.public_key.present?
+    public_key = board.public_key
+
+    get board_path(board, format: :json), as: :json
+
+    assert_response :success
+    assert_equal public_board_url(public_key, script_name: ""), response.parsed_body["public_url"]
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :no_content
+    assert_nil board.reload.public_key
+
+    get public_board_path(public_key, script_name: "")
+
+    assert_response :not_found
+
+    get board_path(board, format: :json), as: :json
+
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "only account admins can publish or unpublish a board" do
+    board = boards(:writebook)
+    logout_and_sign_in_as :david
+
+    post board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_nil board.reload.public_key
+
+    board.publish
+    logout_and_sign_in_as :david
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert board.reload.public_key.present?
+  end
+
+  test "publishing preserves an active URL and creates a new URL after revocation" do
+    board = boards(:writebook)
+    board.publish
+    public_key = board.public_key
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert_equal public_key, board.reload.public_key
+
+    delete board_publication_path(board), as: :json
+    assert_response :no_content
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert_not_equal public_key, board.reload.public_key
+  end
+
+  test "account admins can publish boards they do not have direct access to" do
+    board = Current.set(account: accounts("37s"), user: users(:david)) do
+      Board.create!(name: "David's private board", creator: users(:david), all_access: false)
+    end
+
+    assert_not board.accessible_to?(users(:kevin))
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert board.reload.public_key.present?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..b2c550c
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  test "anonymous visitors can see a published board and its published cards" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.public_key, script_name: "")
+
+    assert_response :success
+    assert_select "h1", board.name
+    assert_select "a[href=?]", public_board_column_path(board.public_key, columns(:writebook_in_progress), script_name: "")
+    assert_select "a[href=?]", public_board_card_path(board.public_key, cards(:text).number, script_name: "")
+    assert_select "a", text: cards(:text).title
+  end
+
+  test "an unpublished board is not publicly accessible" do
+    board = boards(:writebook)
+    board.publish
+    public_key = board.public_key
+    board.unpublish
+
+    get public_board_path(public_key, script_name: "")
+
+    assert_response :not_found
+  end
+
+  test "public board JSON contains public columns and published cards" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.public_key, format: :json, script_name: ""), as: :json
+
+    assert_response :success
+    assert_equal board.name, response.parsed_body["name"]
+    assert_equal public_board_url(board.public_key, script_name: ""), response.parsed_body["public_url"]
+    assert_includes response.parsed_body["cards"].map { |card| card["number"] }, cards(:text).number
+  end
+
+  test "public board does not list drafted cards" do
+    board = boards(:writebook)
+    board.cards.create!(creator: users(:kevin), title: "Not published", status: :drafted)
+    board.publish
+
+    get public_board_path(board.public_key, script_name: "")
+
+    assert_response :success
+    assert_select "a", text: "Not published", count: 0
+  end
+
+  test "board JSON includes a nil public_url until the board is published" do
+    sign_in_as :kevin
+    board = boards(:writebook)
+
+    get board_path(board, format: :json), as: :json
+
+    assert_response :success
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+  end
+end
diff --git a/test/controllers/public/cards_controller_test.rb b/test/controllers/public/cards_controller_test.rb
