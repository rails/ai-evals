@@ -0,0 +1,49 @@
+require "test_helper"
+
+class PublicCardsControllerTest < ActionDispatch::IntegrationTest
+  test "published cards on a public board can be opened directly" do
+    board = boards(:writebook)
+    card = cards(:text)
+    board.publish
+
+    get public_board_card_path(board.public_key, card.number, script_name: "")
+
+    assert_response :success
+    assert_select "h1", card.title
+  end
+
+  test "published cards return public JSON" do
+    board = boards(:writebook)
+    card = cards(:text)
+    board.publish
+
+    get public_board_card_path(board.public_key, card.number, format: :json, script_name: ""), as: :json
+
+    assert_response :success
+    assert_equal card.number, response.parsed_body["number"]
+    assert_equal public_board_card_url(board.public_key, card.number, script_name: ""), response.parsed_body["url"]
+  end
+
+  test "draft cards are not available through a public board" do
+    board = boards(:writebook)
+    draft = board.cards.create!(creator: users(:kevin), status: :drafted)
+    board.publish
+
+    get public_board_card_path(board.public_key, draft.number, script_name: "")
+
+    assert_response :not_found
+  end
+
+  test "a card from another board cannot be opened through a public board URL" do
+    board = boards(:writebook)
+    other_board = Board.create!(name: "Another board", creator: users(:kevin), account: board.account)
+    foreign_card = Current.set(account: board.account, user: users(:kevin)) do
+      other_board.cards.create!(creator: users(:kevin), title: "Another card", status: :published)
+    end
+    board.publish
+
+    get public_board_card_path(board.public_key, foreign_card.number, script_name: "")
+
+    assert_response :not_found
+  end
+end
