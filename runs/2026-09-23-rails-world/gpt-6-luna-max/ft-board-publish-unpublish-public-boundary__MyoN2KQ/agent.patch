+require "test_helper"
+
+class PublicColumnsControllerTest < ActionDispatch::IntegrationTest
+  test "a published board column and its published cards can be opened directly" do
+    board = boards(:writebook)
+    column = columns(:writebook_in_progress)
+    board.publish
+
+    get public_board_column_path(board.public_key, column, script_name: "")
+
+    assert_response :success
+    assert_select "h1", column.name
+    assert_select "a[href=?]", public_board_card_path(board.public_key, cards(:text).number, script_name: "")
+  end
+
+  test "a column from another board cannot be opened through a public board URL" do
+    board = boards(:writebook)
+    other_board = boards(:miltons_wish_list)
+    foreign_column = other_board.columns.create!(name: "Private column")
+    board.publish
+
+    get public_board_column_path(board.public_key, foreign_column, script_name: "")
+
+    assert_response :not_found
+  end
+
+  test "public column JSON only lists published cards and uses public URLs" do
+    board = boards(:writebook)
+    column = columns(:writebook_in_progress)
+    board.publish
+
+    get public_board_column_path(board.public_key, column, format: :json, script_name: ""), as: :json
+
+    assert_response :success
+    assert_equal column.id, response.parsed_body["id"]
+    assert_equal [ cards(:text).number ], response.parsed_body["cards"].map { |card| card["number"] }
+    assert_equal public_board_column_url(board.public_key, column, script_name: ""), response.parsed_body["url"]
+  end
+end
