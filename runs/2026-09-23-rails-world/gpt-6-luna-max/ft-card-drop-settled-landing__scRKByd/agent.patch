diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..eefb72c
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,98 @@
+require "application_system_test_case"
+require "timeout"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "moving a card between custom columns is immediate and does not reorder within a column" do
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    destination_column = columns(:writebook_review)
+
+    visit board_url(boards(:writebook))
+    card_id = dom_id(card, :article)
+    source_id = dom_id(source_column)
+    destination_id = dom_id(destination_column)
+
+    assert_selector "##{card_id}[draggable='true']", visible: :all
+    assert_selector "##{source_id} .cards__list", visible: :all
+    assert_selector "##{destination_id} .cards__list", visible: :all
+
+    original_order = page.evaluate_script("Array.from(document.querySelectorAll('##{source_id} .cards__list .card')).map(card => card.id)")
+    same_column_drag = drag_card_to(card_id, source_id)
+    assert_equal [ true, false ], same_column_drag
+    assert_equal original_order, page.evaluate_script("Array.from(document.querySelectorAll('##{source_id} .cards__list .card')).map(card => card.id)")
+
+    cross_column_drag = drag_card_to(card_id, destination_id)
+    assert_equal [ true, true ], cross_column_drag
+
+    assert_selector "##{destination_id} ##{card_id}", visible: :all
+    assert_no_selector "##{source_id} ##{card_id}", visible: :all
+    assert_equal destination_id, page.evaluate_script("document.getElementById('#{card_id}').closest('.cards').id")
+    assert_equal "1", page.evaluate_script("document.querySelector('##{source_id} .cards__expander-count').dataset.dragAndDropCount")
+    assert_equal "1", page.evaluate_script("document.querySelector('##{destination_id} .cards__expander-count').dataset.dragAndDropCount")
+    wait_for_card_state { card.reload.column_id == destination_column.id }
+
+    # The board's own Turbo refresh broadcast must not undo the immediate placement.
+    sleep 0.3
+    assert_equal destination_id, page.evaluate_script("document.getElementById('#{card_id}').closest('.cards').id")
+  end
+
+  test "dragging between columns changes card status as well as its destination" do
+    card = cards(:text)
+    done_column = "closed-cards"
+    maybe_column = "maybe"
+    not_now_column = "not-now"
+    destination_column = columns(:writebook_review)
+
+    visit board_url(boards(:writebook))
+    card_id = dom_id(card, :article)
+
+    drag_card_to(card_id, done_column)
+    assert_selector "##{done_column} ##{card_id}", visible: :all
+    wait_for_card_state { card.reload.closed? }
+
+    drag_card_to(card_id, maybe_column)
+    assert_selector "##{maybe_column} ##{card_id}", visible: :all
+    wait_for_card_state { card.reload.awaiting_triage? }
+
+    drag_card_to(card_id, not_now_column)
+    assert_selector "##{not_now_column} ##{card_id}", visible: :all
+    wait_for_card_state { card.reload.postponed? }
+
+    drag_card_to(card_id, dom_id(destination_column))
+    assert_selector "##{dom_id(destination_column)} ##{card_id}", visible: :all
+    wait_for_card_state { card.reload.column_id == destination_column.id && card.reload.active? }
+  end
+
+  private
+    def drag_card_to(card_id, column_id)
+      page.execute_script(<<~JAVASCRIPT)
+        const card = document.getElementById(#{card_id.to_json});
+        const column = document.getElementById(#{column_id.to_json});
+        const dataTransfer = new DataTransfer();
+        const dragEvent = (name) => new DragEvent(name, { bubbles: true, cancelable: true, dataTransfer });
+
+        card.dispatchEvent(dragEvent("dragstart"));
+        column.dispatchEvent(dragEvent("dragenter"));
+        column.dispatchEvent(dragEvent("dragover"));
+        const dragStyles = [
+          card.classList.contains("drag-and-drop__dragged-item"),
+          column.classList.contains("drag-and-drop__hover-container")
+        ];
+        column.dispatchEvent(dragEvent("drop"));
+        card.dispatchEvent(dragEvent("dragend"));
+        return dragStyles;
+      JAVASCRIPT
+    end
+
+    def wait_for_card_state
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.025 until yield
+      end
+    end
+end
