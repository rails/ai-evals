diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..fc80b43
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,339 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const CARD_SELECTOR = '[data-drag-and-drop-target~="card"]'
+const COLUMN_SELECTOR = '[data-drag-and-drop-target~="column"]'
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+
+  initialize() {
+    this.draggedCard = null
+    this.hoveredColumn = null
+    this.desktopMediaQuery = window.matchMedia("(min-width: 640px)")
+    this.pendingSaves = new WeakMap()
+    this.persistedLocations = new WeakMap()
+    this.moveVersions = new WeakMap()
+    this.handleScreenSizeChange = this.updateDraggable.bind(this)
+  }
+
+  connect() {
+    this.desktopMediaQuery.addEventListener("change", this.handleScreenSizeChange)
+    this.updateDraggable()
+  }
+
+  disconnect() {
+    this.desktopMediaQuery.removeEventListener("change", this.handleScreenSizeChange)
+    this.#clearDragState()
+  }
+
+  cardTargetConnected(card) {
+    card.draggable = this.desktopMediaQuery.matches
+
+    if (!this.persistedLocations.has(card)) {
+      const column = this.#columnForCard(card)
+      if (column) this.persistedLocations.set(card, this.#locationFor(column))
+    }
+
+    if (!this.moveVersions.has(card)) this.moveVersions.set(card, 0)
+  }
+
+  cardTargetDisconnected(card) {
+    card.classList.remove(DRAGGED_CLASS)
+  }
+
+  updateDraggable() {
+    this.cardTargets.forEach(card => card.draggable = this.desktopMediaQuery.matches)
+  }
+
+  dragstart(event) {
+    const card = this.#cardFor(event.target)
+    if (!card || !this.desktopMediaQuery.matches) return
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_CLASS)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  dragend() {
+    this.#clearDragState()
+  }
+
+  dragenter(event) {
+    const column = this.#columnForTarget(event.target)
+    if (this.#canDropInto(column)) this.#setHoveredColumn(column)
+  }
+
+  dragover(event) {
+    const column = this.#columnForTarget(event.target)
+
+    if (this.#canDropInto(column)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#setHoveredColumn(column)
+    } else {
+      this.#setHoveredColumn(null)
+    }
+  }
+
+  dragleave(event) {
+    const column = this.#columnForTarget(event.target)
+
+    if (column && column === this.hoveredColumn && !column.contains(event.relatedTarget)) {
+      this.#setHoveredColumn(null)
+    } else if (!column) {
+      this.#setHoveredColumn(null)
+    }
+  }
+
+  drop(event) {
+    const destination = this.#columnForTarget(event.target)
+    const card = this.draggedCard
+
+    if (this.#canDropInto(destination)) {
+      event.preventDefault()
+      this.#moveCard(card, destination)
+    }
+
+    this.#setHoveredColumn(null)
+  }
+
+  #canDropInto(destination) {
+    if (!this.draggedCard || !destination || !this.columnTargets.includes(destination)) return false
+    if (this.#columnForCard(this.draggedCard) === destination) return false
+    if (!this.#cardListFor(destination)) return false
+
+    return this.#requestFor(this.draggedCard, this.#locationFor(destination)) !== null
+  }
+
+  #cardFor(element) {
+    return element instanceof Element ? element.closest(CARD_SELECTOR) : null
+  }
+
+  #columnForTarget(element) {
+    if (!(element instanceof Element)) return null
+
+    const column = element.closest(COLUMN_SELECTOR)
+    return this.columnTargets.includes(column) ? column : null
+  }
+
+  #columnForCard(card) {
+    return card?.closest(COLUMN_SELECTOR) || null
+  }
+
+  #cardListFor(column) {
+    return column?.querySelector(".cards__list") || null
+  }
+
+  #locationFor(column) {
+    return {
+      kind: column.dataset.dragAndDropKind,
+      columnId: column.dataset.dragAndDropColumnId,
+      name: column.dataset.dragAndDropColumnName,
+      color: column.dataset.dragAndDropColor
+    }
+  }
+
+  #sameLocation(first, second) {
+    if (!first || !second || first.kind !== second.kind) return false
+
+    return first.kind !== "column" || first.columnId === second.columnId
+  }
+
+  #findColumn(location) {
+    return this.columnTargets.find(column => this.#sameLocation(this.#locationFor(column), location))
+  }
+
+  #setHoveredColumn(column) {
+    if (this.hoveredColumn === column) return
+
+    this.columnTargets.forEach(target => target.classList.toggle(HOVER_CLASS, target === column))
+    this.hoveredColumn = column
+  }
+
+  #clearDragState() {
+    this.draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.draggedCard = null
+    this.#setHoveredColumn(null)
+  }
+
+  #moveCard(card, destination) {
+    const source = this.#columnForCard(card)
+    const sourceList = this.#cardListFor(source)
+    const destinationList = this.#cardListFor(destination)
+    const location = this.#locationFor(destination)
+
+    if (!source || !sourceList || !destinationList) return
+
+    const version = (this.moveVersions.get(card) || 0) + 1
+    this.moveVersions.set(card, version)
+
+    this.#adjustCount(source, -1)
+    this.#adjustCount(destination, 1)
+    // The transition makes this the newest card in the destination's existing sort.
+    destinationList.prepend(card)
+    this.#updateEmptyState(sourceList)
+    this.#updateCardPresentation(card, location)
+    this.#saveMove(card, location, version)
+  }
+
+  #adjustCount(column, amount) {
+    const count = column.querySelector(".cards__expander-count")
+    if (!count) return
+
+    const currentCount = Number.parseInt(count.dataset.dragAndDropCount, 10) || 0
+    const nextCount = Math.max(0, currentCount + amount)
+
+    count.dataset.dragAndDropCount = nextCount
+    count.textContent = nextCount > 99 ? "99+" : nextCount
+  }
+
+  #updateEmptyState(list) {
+    if (list.querySelector(CARD_SELECTOR) || list.querySelector(".pagination-link")) return
+
+    if (!list.querySelector(".blank-slate--default")) {
+      const blankSlate = document.createElement("div")
+      blankSlate.className = "blank-slate blank-slate--default"
+      blankSlate.textContent = "No cards here"
+      list.append(blankSlate)
+    }
+
+    if (!list.querySelector(".blank-slate--drag")) {
+      const blankSlate = document.createElement("div")
+      blankSlate.className = "blank-slate blank-slate--drag overflow-ellipsis"
+      blankSlate.textContent = "Drag cards here"
+      list.append(blankSlate)
+    }
+  }
+
+  #updateCardPresentation(card, destination) {
+    const isActive = destination.kind === "maybe" || destination.kind === "column"
+    const isPostponed = destination.kind === "not-now"
+
+    card.classList.toggle("card--active", isActive)
+    card.classList.toggle("card--postponed", isPostponed)
+
+    if (isActive && destination.color) card.style.setProperty("--card-color", destination.color)
+
+    this.#updateColumnName(card, destination)
+    this.#updateStatusStamp(card, destination.kind)
+  }
+
+  #updateColumnName(card, destination) {
+    let name = card.querySelector("[data-drag-and-drop-column-name]")
+
+    if (destination.kind === "column") {
+      if (!name) {
+        name = document.createElement("span")
+        name.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        name.dataset.dragAndDropColumnName = ""
+
+        const label = document.createElement("span")
+        label.className = "overflow-ellipsis"
+        name.append(label)
+        card.querySelector(".card__header")?.append(name)
+      }
+
+      const label = name.querySelector(".overflow-ellipsis")
+      if (label) label.textContent = destination.name
+    } else {
+      name?.remove()
+    }
+  }
+
+  #updateStatusStamp(card, kind) {
+    const title = kind === "done" ? "Done" : kind === "not-now" ? "Not Now" : null
+    let stamp = card.querySelector(".card__closed")
+
+    if (!title) {
+      stamp?.remove()
+      return
+    }
+
+    if (!stamp) {
+      stamp = document.createElement("div")
+      stamp.className = "card__closed"
+      card.append(stamp)
+    } else {
+      stamp.querySelectorAll(".card__closed-date, .card__closed-by-line").forEach(element => element.remove())
+      stamp.classList.remove("card__closed--system")
+    }
+
+    let stampTitle = stamp.querySelector(".card__closed-title")
+    if (!stampTitle) {
+      stampTitle = document.createElement("span")
+      stampTitle.className = "card__closed-title"
+      stamp.append(stampTitle)
+    }
+
+    stampTitle.dataset.text = title
+    stampTitle.textContent = title
+  }
+
+  #saveMove(card, destination, version) {
+    const previousSave = this.pendingSaves.get(card) || Promise.resolve()
+    const save = previousSave.catch(() => {}).then(async () => {
+      const operation = this.#requestFor(card, destination)
+      if (!operation) throw new Error("Card move has no matching endpoint")
+
+      // request.js uses Turbo.fetch, so this session ignores the model's refresh broadcast.
+      const response = await operation()
+
+      if (!response.ok) throw new Error(`Card move failed: ${response.statusCode}`)
+
+      this.persistedLocations.set(card, destination)
+    }).catch(error => {
+      console.error(error)
+
+      if (this.moveVersions.get(card) === version) this.#restorePersistedLocation(card)
+    })
+
+    this.pendingSaves.set(card, save)
+    save.then(() => {
+      if (this.pendingSaves.get(card) === save) this.pendingSaves.delete(card)
+    })
+  }
+
+  #restorePersistedLocation(card) {
+    const location = this.persistedLocations.get(card)
+    const currentColumn = this.#columnForCard(card)
+    const destination = this.#findColumn(location)
+
+    if (destination && currentColumn !== destination) {
+      this.#placeCard(card, destination)
+    }
+  }
+
+  #placeCard(card, destination) {
+    const source = this.#columnForCard(card)
+    const sourceList = this.#cardListFor(source)
+    const destinationList = this.#cardListFor(destination)
+
+    if (!source || !sourceList || !destinationList || source === destination) return
+
+    this.#adjustCount(source, -1)
+    this.#adjustCount(destination, 1)
+    destinationList.prepend(card)
+    this.#updateEmptyState(sourceList)
+    this.#updateCardPresentation(card, this.#locationFor(destination))
+  }
+
+  #requestFor(card, destination) {
+    switch (destination.kind) {
+      case "maybe":
+        return card.dataset.dragAndDropTriageUrl ? () => destroy(card.dataset.dragAndDropTriageUrl, { responseKind: "json" }) : null
+      case "not-now":
+        return card.dataset.dragAndDropNotNowUrl ? () => post(card.dataset.dragAndDropNotNowUrl, { responseKind: "json" }) : null
+      case "done":
+        return card.dataset.dragAndDropClosureUrl ? () => post(card.dataset.dragAndDropClosureUrl, { responseKind: "json" }) : null
+      case "column":
+        return card.dataset.dragAndDropTriageUrl && destination.columnId ?
+          () => post(card.dataset.dragAndDropTriageUrl, { query: { column_id: destination.columnId }, responseKind: "json" }) : null
+      default:
+        return null
+    }
+  }
+}
