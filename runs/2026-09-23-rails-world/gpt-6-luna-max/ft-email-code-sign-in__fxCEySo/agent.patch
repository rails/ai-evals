diff --git a/test/controllers/email_codes_controller_test.rb b/test/controllers/email_codes_controller_test.rb
new file mode 100644
index 0000000..03212d1
--- /dev/null
+++ b/test/controllers/email_codes_controller_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "sign in by email code" do
+    identity = identities(:jz)
+
+    untenanted do
+      assert_emails 1 do
+        perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob) do
+          post session_path, params: { email_address: identity.email_address }
+        end
+      end
+    end
+
+    email_code = EmailCode.order(:created_at).last
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject[/[A-Z0-9]{#{EmailCode::CODE_LENGTH}}/]
+
+    assert_redirected_to email_code_path(email_code, script_name: nil)
+    assert_equal identity.email_address, email_code.email_address
+    assert_equal "sign_in", email_code.purpose
+    assert_equal [ identity.email_address ], email.to
+    assert_match(/\A[A-Z0-9]{#{EmailCode::CODE_LENGTH}}\z/, code)
+    assert_includes email.subject, code
+    assert_includes email.body.encoded, code
+
+    get email_code_path(email_code, script_name: nil)
+
+    assert_response :success
+    assert_select "input[name='code'][maxlength='#{EmailCode::CODE_LENGTH}']"
+
+    assert_difference -> { Session.count }, 1 do
+      post email_code_path(email_code, script_name: nil), params: { code: code }
+    end
+
+    assert_response :redirect
+    assert cookies[:session_token].present?
+    assert_equal identity.id, Session.order(:created_at).last.identity_id
+    assert email_code.reload.consumed_at.present?
+  end
+
+  test "wrong and expired codes cannot sign in" do
+    email_code, code = issue_sign_in_code
+
+    post email_code_path(email_code, script_name: nil), params: { code: "WRONG1" }
+
+    assert_response :unprocessable_entity
+    assert_select "[role='alert']", text: "That code didn’t work. Check it and try again."
+    assert_nil email_code.reload.consumed_at
+    assert_not cookies[:session_token].present?
+
+    travel_to email_code.expires_at + 1.second do
+      post email_code_path(email_code, script_name: nil), params: { code: code }
+    end
+
+    assert_response :unprocessable_entity
+    assert_in_body "This code has expired or has already been used"
+    assert_nil email_code.reload.consumed_at
+    assert_not cookies[:session_token].present?
+  end
+
+  test "requesting a new code invalidates the earlier code" do
+    first_code, first_value = issue_sign_in_code
+    second_code = issue_sign_in_code.first
+
+    assert first_code.reload.consumed_at.present?
+    assert second_code.usable?
+
+    post email_code_path(first_code, script_name: nil), params: { code: first_value }
+
+    assert_response :unprocessable_entity
+    assert_in_body "This code has expired or has already been used"
+    assert_not cookies[:session_token].present?
+  end
+
+  test "a valid code for an unknown email does not create an identity" do
+    email_code, code = issue_sign_in_code("unknown@example.com")
+
+    assert_no_difference -> { Identity.count } do
+      post email_code_path(email_code, script_name: nil), params: { code: code }
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_equal "No account was found for that email address. Sign up to create an account.", flash[:alert]
+    assert email_code.reload.consumed_at.present?
+  end
+
+  test "a code can only be used once" do
+    email_code, code = issue_sign_in_code
+
+    post email_code_path(email_code, script_name: nil), params: { code: code }
+
+    assert_response :redirect
+    assert email_code.reload.consumed_at.present?
+
+    assert_no_difference -> { Session.count } do
+      post email_code_path(email_code, script_name: nil), params: { code: code }
+    end
+
+    assert_response :unprocessable_entity
+    assert_in_body "This code has expired or has already been used"
+  end
+
+  private
+    def issue_sign_in_code(email_address = identities(:jz).email_address)
+      untenanted do
+        perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob) do
+          post session_path, params: { email_address: email_address }
+        end
+      end
+
+      email_code = EmailCode.order(:created_at).last
+      [ email_code, ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{#{EmailCode::CODE_LENGTH}}/] ]
+    end
+end
