+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "sign in code is included in the subject and email body" do
+    code = "AB12CD"
+    email = IdentityMailer.sign_in_code(email_address: "person@example.com", code: code)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_includes email.subject, code
+    assert_match code, email.body.encoded
+    assert_match "15 minutes", email.body.encoded
+  end
+end
