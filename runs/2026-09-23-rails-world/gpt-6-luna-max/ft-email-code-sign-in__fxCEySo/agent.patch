@@ -0,0 +1,79 @@
+class EmailCodesController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def show
+    @email_code = EmailCode.find(params.expect(:id))
+  end
+
+  def create
+    @email_code = EmailCode.find(params.expect(:id))
+
+    if @email_code.purpose_join? && (@join_code = @email_code.join_code).nil?
+      head :not_found
+    elsif @email_code.purpose_join? && !@join_code.active?
+      redirect_to_join_code
+    elsif @email_code.consume_if_valid(params.expect(:code))
+      complete_authentication
+    else
+      @invalid_code = true
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def complete_authentication
+      if @email_code.purpose_sign_in?
+        sign_in
+      else
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        start_new_session_for identity
+
+        if @email_code.purpose_signup?
+          redirect_to new_signup_completion_path
+        else
+          join_account(identity)
+        end
+      end
+    end
+
+    def sign_in
+      if identity = Identity.find_by(email_address: @email_code.email_address)
+        start_new_session_for identity
+        redirect_to after_authentication_url
+      else
+        redirect_to new_session_path, alert: "No account was found for that email address. Sign up to create an account."
+      end
+    end
+
+    def join_account(identity)
+      @join_code.redeem_if { |account| identity.join(account) }
+
+      if user = User.active.find_by(account: @join_code.account, identity: identity)
+        if user.setup?
+          redirect_to landing_url(script_name: @join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+        end
+      elsif @join_code.reload.active?
+        head :unprocessable_entity
+      else
+        redirect_to_join_code
+      end
+    end
+
+    def redirect_to_join_code
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug)
+    end
+
+    def rate_limit_exceeded
+      if @email_code = EmailCode.find_by(id: params[:id])
+        redirect_to email_code_path(@email_code, script_name: nil), alert: "Try again later."
+      else
+        head :too_many_requests
+      end
+    end
+end
