diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..6604932
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,80 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+
+  enum :purpose, { sign_in: "sign_in", signup: "signup", join: "join" }, prefix: true, validate: true
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  normalizes :email_address, with: ->(email_address) { email_address.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code_digest, :expires_at, presence: true
+  validate :join_code_matches_purpose
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    email_code = new(
+      email_address: email_address,
+      purpose: purpose,
+      join_code: join_code,
+      code_digest: digest_code(code),
+      expires_at: LIFETIME.from_now
+    )
+
+    if email_code.valid?
+      transaction do
+        previous_codes = where(
+          email_address: email_code.email_address,
+          purpose: email_code.purpose,
+          join_code_id: email_code.join_code_id,
+          consumed_at: nil
+        )
+        previous_codes.update_all(consumed_at: Time.current, updated_at: Time.current)
+        where("expires_at <= ?", Time.current).delete_all
+        email_code.save!
+      end
+
+      IdentityMailer.sign_in_code(email_address: email_code.email_address, code: code).deliver_later
+    end
+
+    email_code
+  end
+
+  def self.digest_code(code)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code.to_s.strip.upcase)
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def usable?
+    consumed_at.nil? && !expired?
+  end
+
+  def consume_if_valid(code)
+    with_lock do
+      if usable? && matching_code?(code)
+        update!(consumed_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+
+  private
+    def matching_code?(code)
+      candidate_digest = self.class.digest_code(code)
+      ActiveSupport::SecurityUtils.secure_compare(code_digest, candidate_digest)
+    end
+
+    def join_code_matches_purpose
+      if purpose_join?
+        errors.add(:join_code, :blank) if join_code.nil?
+      elsif join_code.present?
+        errors.add(:join_code, "can only be supplied for a join code")
+      end
+    end
+end
