@@ -0,0 +1,36 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if @invalid_code %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <% if @email_code.usable? %>
+    <p>We sent a six-character code to <strong><%= @email_code.email_address %></strong>. Enter it below within 15 minutes to continue.</p>
+
+    <% if @invalid_code %>
+      <p class="txt-negative" role="alert">That code didn’t work. Check it and try again.</p>
+    <% end %>
+
+    <%= form_with url: email_code_path(@email_code, script_name: nil), method: :post, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+      <%= form.text_field :code, class: "input txt-large", required: true, autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, inputmode: "text", minlength: EmailCode::CODE_LENGTH, maxlength: EmailCode::CODE_LENGTH, pattern: "[A-Za-z0-9]{#{EmailCode::CODE_LENGTH}}", placeholder: "Enter your code…" %>
+
+      <button type="submit" class="btn btn--link center" data-form-target="submit">
+        <span>Continue</span>
+        <%= icon_tag "arrow-right" %>
+      </button>
+    <% end %>
+  <% else %>
+    <p class="txt-medium">This code has expired or has already been used. Please request a new one.</p>
+
+    <% if @email_code.purpose_join? && @email_code.join_code.present? %>
+      <%= link_to "Try again", join_path(code: @email_code.join_code.code, script_name: @email_code.join_code.account.slug), class: "btn btn--link center" %>
+    <% elsif @email_code.purpose_signup? %>
+      <%= link_to "Try again", new_signup_path, class: "btn btn--link center" %>
+    <% else %>
+      <%= link_to "Try again", new_session_path, class: "btn btn--link center" %>
+    <% end %>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
