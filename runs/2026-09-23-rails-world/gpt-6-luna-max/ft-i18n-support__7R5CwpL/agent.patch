diff --git a/app/javascript/helpers/translation_helpers.js b/app/javascript/helpers/translation_helpers.js
new file mode 100644
index 0000000..c526e4b
--- /dev/null
+++ b/app/javascript/helpers/translation_helpers.js
@@ -0,0 +1,27 @@
+const japaneseTranslations = {
+  "Are you sure?": "よろしいですか？",
+  "Back to": "戻る：",
+  "Closes": "クローズ予定",
+  "No selection": "選択なし",
+  "Please fill out this field": "この項目を入力してください",
+  "Stalled": "停滞中"
+
+}
+
+export function translate(key) {
+  if (isJapanese()) {
+    return japaneseTranslations[key] || key
+  }
+
+  return key
+}
+
+export function isJapanese() {
+  return (document.body?.dataset.locale || document.documentElement.lang) === "ja"
+}
+
+document.addEventListener("turbo:load", () => {
+  if (document.body?.dataset.locale) {
+    document.documentElement.lang = document.body.dataset.locale
+  }
+})
