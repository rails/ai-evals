+require "test_helper"
+
+class PublicErrorPagesTest < ActiveSupport::TestCase
+  test "static error pages show English and Japanese messages" do
+    Dir[Rails.root.join("public", "{400,404,406-unsupported-browser,422,500}.html")].each do |path|
+      page = Nokogiri::HTML(File.read(path))
+
+      assert_equal "en", page.at_css("html")["lang"]
+      assert page.at_css("h2[lang='en']")
+      assert page.at_css("h2[lang='ja']")
+      assert page.at_css("div[lang='en']")
+      assert page.at_css("div[lang='ja']")
+      assert_match(/Back home/, page.at_css("span[lang='en']").text)
+      assert_equal "ホームに戻る", page.at_css("span[lang='ja']").text
+    end
+  end
+end
diff --git a/test/system/locales_test.rb b/test/system/locales_test.rb
new file mode 100644
index 0000000..cbaff40
--- /dev/null
+++ b/test/system/locales_test.rb
@@ -0,0 +1,30 @@
+require "application_system_test_case"
+
+class LocalesSystemTest < ApplicationSystemTestCase
+  setup do
+    identities(:kevin).update!(locale: nil)
+  end
+
+  teardown do
+    identities(:kevin).update!(locale: nil)
+  end
+
+  test "Turbo locale changes update document language and relative timestamps" do
+    sign_in_as users(:kevin)
+    visit root_path
+
+    page.execute_script("Turbo.visit(arguments[0])", root_path(locale: "ja"))
+
+    assert_selector "html[lang='ja']", wait: 10
+    assert_selector "body[data-locale='ja']", wait: 10
+
+    execute_script <<~JAVASCRIPT
+      const time = document.createElement("time")
+      time.dataset.localTimeTarget = "daysago"
+      time.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      document.querySelector("main").append(time)
+    JAVASCRIPT
+
+    assert_selector "time .local-time-value", text: "今日"
+  end
+end
