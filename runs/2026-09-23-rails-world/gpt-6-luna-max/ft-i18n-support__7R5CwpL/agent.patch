diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..4ba8cc1
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,33 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :remember_locale_preference
+    around_action :set_locale
+  end
+
+  private
+    def remember_locale_preference
+      if Identity::AVAILABLE_LOCALES.include?(params[:locale])
+        session[:locale] = params[:locale]
+      end
+    end
+
+    def set_locale(&action)
+      if locale = available_session_locale
+        Current.identity.update!(locale: locale) if Current.identity && Current.identity.locale != locale
+      end
+
+      locale ||= Current.identity&.locale
+      locale ||= I18n.default_locale
+
+      session[:locale] = locale.to_s if Current.identity&.locale.present? && available_session_locale.nil?
+
+      I18n.with_locale(locale, &action)
+    end
+
+    def available_session_locale
+      locale = session[:locale]
+      locale if Identity::AVAILABLE_LOCALES.include?(locale)
+    end
+end
