index 0000000..4c60e17
--- /dev/null
+++ b/lib/japanese_translations.rb
@@ -0,0 +1,184 @@
+# Provides a translation layer for the application's existing server-rendered
+# text while gradually moving strings into keyed Rails translations. It only
+# visits rendered UI text and accessibility attributes, never rich-text content
+# authored by users or the editor's own package strings.
+module JapaneseTranslations
+  TRANSLATABLE_ATTRIBUTES = %w[
+    alt aria-description aria-label aria-valuetext placeholder title value
+    aria-roledescription data-confirm data-turbo-confirm data-validation-message data-bridge-title data-bridge-description
+    data-bridge-share-description data-text
+  ].freeze
+  TRANSLATABLE_DATA_ATTRIBUTE = /\Adata-.*(?:label|title|placeholder|description|confirm|message).*?-value\z/
+  EXCLUDED_ELEMENTS = %w[code lexxy-editor pre script style].freeze
+  INTERACTIVE_ELEMENTS = %w[button input label select textarea].freeze
+  EXCLUDED_CLASS_NAMES = %w[card__description card__title card__title-link card__board-name card__column-name card__closed-by card__link notification__board search__excerpt search__title step__content tag comment__body lexxy-content user-content notification__mention-content].freeze
+
+  class << self
+    def translate_html(html)
+      document = if html.match?(/\A\s*(?:<!doctype\s+html|<html\b)/i)
+        Nokogiri::HTML5.parse(html)
+      else
+        Nokogiri::HTML5.fragment(html)
+      end
+
+      document.traverse do |node|
+        if node.text?
+          unless inside_excluded_element?(node) || node.ancestors.any? { |ancestor| ancestor.name == "textarea" }
+            node.content = translate_text(node.content)
+          end
+        elsif node.element?
+          translate_attributes(node)
+        end
+      end
+
+      document.to_html
+    end
+
+    def translate_text(text)
+      return text unless text.present?
+
+      normalized = text.tr("\u00a0", " ")
+      leading = normalized[/\A\s*/]
+      trailing = normalized[/\s*\z/]
+      content = normalized.strip
+      translation = (translations[content] || translate_dynamic_text(content) || content).dup
+      translations_by_length.each do |source, japanese|
+        pattern = /(?<![A-Za-z0-9_])#{Regexp.escape(source)}(?![A-Za-z0-9_])/i
+        translation.gsub!(pattern, japanese)
+      end
+
+      "#{leading}#{translation}#{trailing}"
+    end
+
+    private
+      def translate_attributes(node)
+        return if inside_excluded_element?(node)
+
+        node.attribute_nodes.each do |attribute|
+          if attribute.name == "value" && node.name == "input" && !%w[button reset submit].include?(node["type"])
+            next
+          end
+
+          if TRANSLATABLE_ATTRIBUTES.include?(attribute.name) || attribute.name.match?(TRANSLATABLE_DATA_ATTRIBUTE)
+            attribute.value = translate_text(attribute.value)
+          end
+        end
+      end
+
+      def inside_excluded_element?(node)
+        ancestors = node.ancestors.to_a
+        ancestors.unshift(node) if node.element?
+
+        return true if ancestors.any? { |ancestor| EXCLUDED_ELEMENTS.include?(ancestor.name) }
+
+        excluded_container = ancestors.find do |ancestor|
+          (ancestor["class"].to_s.split & EXCLUDED_CLASS_NAMES).any?
+        end
+
+        if excluded_container
+          ancestors.take_while { |ancestor| ancestor != excluded_container }
+            .none? { |ancestor| INTERACTIVE_ELEMENTS.include?(ancestor.name) }
+        else
+          false
+        end
+      end
+
+      def translate_dynamic_text(text)
+        if text.start_with?("Completed by ") && text.end_with?(".")
+          person, date = text.delete_prefix("Completed by ").delete_suffix(".").split(" on ", 2)
+          "#{person}が#{date}に完了"
+        elsif text.start_with?("Ask someone from ") && text.end_with?(" to send you a new link or increase the limit.")
+          account = text.delete_prefix("Ask someone from ").delete_suffix(" to send you a new link or increase the limit.")
+          "#{account}のメンバーに新しいリンクを送ってもらうか、上限を増やしてもらってください。"
+        elsif text.start_with?("This code has been used ") && text.include?(" times (") && text.end_with?(" remaining)")
+          used, remaining = text.delete_prefix("This code has been used ").delete_suffix(" remaining)").split(" times (", 2)
+          "このコードは#{used}回使用されました（残り#{remaining}回）。"
+        elsif text.start_with?("Just a sec while we sign you in with ") && text.end_with?(".")
+          email = text.delete_prefix("Just a sec while we sign you in with ").delete_suffix(".")
+          "#{email}でサインインしています。しばらくお待ちください。"
+        elsif text.start_with?("No activity for ") && text.end_with?(" days")
+          days = text.delete_prefix("No activity for ").delete_suffix(" days")
+          "アクティビティがない期間：#{days}日"
+        elsif text.start_with?("Scan this code to join ") && text.end_with?(":")
+          account = text.delete_prefix("Scan this code to join ").delete_suffix(":")
+          "このコードを読み取って#{account}に参加："
+        elsif text.start_with?("Showing the 100 most recent (") && text.end_with?(" are hidden)")
+          count = text.delete_prefix("Showing the 100 most recent (").delete_suffix(" are hidden)")
+          "最新100件を表示中（#{count}件は非表示）"
+        elsif text.start_with?("Showing the most recent (") && text.end_with?(" are hidden)")
+          count = text.delete_prefix("Showing the most recent (").delete_suffix(" are hidden)")
+          "最新の項目を表示中（#{count}件は非表示）"
+        elsif text.start_with?("This code will work for ") && text.end_with?(".")
+          duration = text.delete_prefix("This code will work for ").delete_suffix(".")
+          "このコードの有効期限は#{duration}です。"
+        elsif text.start_with?("To receive push notifications in ") && text.include?(" for ") && text.end_with?(", you must first install Fizzy as a web app.")
+          platform, account = text.delete_prefix("To receive push notifications in ").delete_suffix(", you must first install Fizzy as a web app.").split(" for ", 2)
+          "#{account}でプッシュ通知を受け取るには、まずFizzyをWebアプリとしてインストールしてください（#{platform}）。"
+        elsif text.start_with?("Check your ") && text.end_with?(" settings")
+          platform = text.delete_prefix("Check your ").delete_suffix(" settings")
+          "#{platform}の設定を確認してください"
+        elsif text.start_with?("Ensure notifications are allowed for ") && text.end_with?(" in your system settings.")
+          browser = text.delete_prefix("Ensure notifications are allowed for ").delete_suffix(" in your system settings.")
+          "システム設定で#{browser}の通知を許可してください。"
+        elsif text.start_with?("Turn on notifications for ")
+
+          platform = text.delete_prefix("Turn on notifications for ").delete_suffix(".")
+          "#{platform}の通知を有効にしてください。"
+        elsif text.start_with?("Unsubscribing from all email notifications as ")
+          email = text.delete_prefix("Unsubscribing from all email notifications as ").delete_suffix("…")
+          "#{email}のすべてのメール通知の配信を停止します…"
+        elsif text.start_with?("Your import of ") && text.end_with?(" is complete!")
+          account = text.delete_prefix("Your import of ").delete_suffix(" is complete!")
+          "#{account}のインポートが完了しました！"
+        elsif text == "@mentioned you"
+          "あなたにメンションしました"
+        elsif text == "Moved to Not Now due to inactivity"
+          "アクティビティがなかったため「あとで」に移動しました"
+        elsif text.start_with?("Assigned to you by ")
+          name = text.delete_prefix("Assigned to you by ")
+          "#{name}さんがあなたを担当者に設定しました"
+        elsif text.start_with?("Added by ")
+          name = text.delete_prefix("Added by ")
+          "#{name}さんが追加しました"
+        elsif text.start_with?("Moved to Done by ")
+          name = text.delete_prefix("Moved to Done by ")
+          "#{name}さんが「完了」に移動しました"
+        elsif text.start_with?("Closed by ")
+          name = text.delete_prefix("Closed by ")
+          "#{name}さんがクローズしました"
+        elsif text.start_with?("Reopened by ")
+          name = text.delete_prefix("Reopened by ")
+          "#{name}さんが再開しました"
+        elsif text.start_with?("Moved to Not Now by ")
+          name = text.delete_prefix("Moved to Not Now by ")
+          "#{name}さんが「あとで」に移動しました"
+        elsif text.start_with?("Moved back to Maybe? by ")
+          name = text.delete_prefix("Moved back to Maybe? by ")
+          "#{name}さんが「たぶん？」に戻しました"
+        elsif text.start_with?("Moved to ") && text.include?(" by ")
+          destination, name = text.delete_prefix("Moved to ").split(" by ", 2)
+          "#{name}さんが「#{destination}」に移動しました"
+        elsif text.start_with?("Moved by ")
+          name = text.delete_prefix("Moved by ")
+          "#{name}さんが移動しました"
+        elsif text.start_with?("Renamed to ") && text.include?(" by ")
+          title, name = text.delete_prefix("Renamed to ").split(" by ", 2)
+          "#{name}さんがタイトルを「#{title}」に変更しました"
+        elsif text.start_with?("Renamed by ")
+          name = text.delete_prefix("Renamed by ")
+          "#{name}さんがタイトルを変更しました"
+        elsif text.start_with?("Updated by ")
+          name = text.delete_prefix("Updated by ")
+          "#{name}さんが更新しました"
+        end
+      end
+
+      def translations
+        @translations ||= I18n.t("fizzy.phrases", locale: :ja, default: {}).stringify_keys
+      end
+
+      def translations_by_length
+        @translations_by_length ||= translations.select { |source, _| source.length >= 4 }.sort_by { |source, _| -source.length }
+      end
+  end
+end
