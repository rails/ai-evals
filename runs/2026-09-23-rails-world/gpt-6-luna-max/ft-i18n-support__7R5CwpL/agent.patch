diff --git a/test/lib/japanese_translations_test.rb b/test/lib/japanese_translations_test.rb
new file mode 100644
index 0000000..699ecc0
--- /dev/null
+++ b/test/lib/japanese_translations_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class JapaneseTranslationsTest < ActiveSupport::TestCase
+  test "translates visible UI and accessibility text but preserves user content and editor strings" do
+    html = <<~HTML
+      <!doctype html>
+      <html lang="ja">
+        <body>
+          <a aria-label="Toggle pins stack">Latest Activity</a>
+          <div class="card__content">
+            <input placeholder="Name it…" value="Today">
+            <textarea placeholder="Name it…">Today</textarea>
+            <button>Save changes</button>
+            <p class="card__description">Today</p>
+          </div>
+
+          <p class="comment__body">Save changes</p>
+          <lexxy-editor placeholder="Search Fizzy">Rich-text editor label</lexxy-editor>
+          <script>const label = "Search Fizzy"</script>
+        </body>
+      </html>
+    HTML
+
+    translated = I18n.with_locale(:ja) { JapaneseTranslations.translate_html(html) }
+    page = Nokogiri::HTML5(translated)
+
+    assert_equal "ピン留めカード一覧を切り替え", page.at_css("a")["aria-label"]
+    assert_equal "最新のアクティビティ", page.at_css("a").text.strip
+    assert_equal "名前を入力…", page.at_css("input")["placeholder"]
+    assert_equal "Today", page.at_css("input")["value"]
+    assert_equal "名前を入力…", page.at_css("textarea")["placeholder"]
+    assert_equal "Today", page.at_css("textarea").text
+    assert_equal "変更を保存", page.at_css("button").text
+    assert_equal "Today", page.at_css(".card__description").text.strip
+
+    assert_equal "Save changes", page.at_css(".comment__body").text.strip
+    assert_equal "Search Fizzy", page.at_css("lexxy-editor")["placeholder"]
+    assert_includes page.at_css("script").text, "Search Fizzy"
+  end
+
+  test "preserves top-level Turbo Stream markup while translating its fragment" do
+    html = '<turbo-stream action="update" target="flash"><template><p>Settings updated</p></template></turbo-stream>'
+
+    translated = I18n.with_locale(:ja) { JapaneseTranslations.translate_html(html) }
+
+    assert_match(/\A<turbo-stream/, translated)
+    assert_includes translated, "設定を更新しました"
+  end
+
+  test "translates dynamic system event phrases without translating authored names" do
+    I18n.with_locale(:ja) do
+      assert_equal "Davidさんがあなたを担当者に設定しました", JapaneseTranslations.translate_text("Assigned to you by David")
+      assert_equal "Davidが月曜日に完了", JapaneseTranslations.translate_text("Completed by David on Monday.")
+    end
+  end
+end
