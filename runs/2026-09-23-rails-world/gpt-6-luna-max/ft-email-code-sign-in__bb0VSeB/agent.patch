diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..abadc1e
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,114 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+  MAX_ATTEMPTS = 10
+  PURPOSES = %w[ sign_in sign_up join ].freeze
+
+  belongs_to :identity, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :code_digest, :expires_at, presence: true
+  validates :join_code, presence: true, if: :join?
+  validates :join_code, absence: true, unless: :join?
+  validate :identity_email_address_matches
+
+  def self.issue(email_address:, purpose:, identity: nil, join_code: nil)
+    email_address = Identity.new(email_address: email_address).email_address
+    purpose = purpose.to_s
+    code = generate_code
+
+    email_code = transaction do
+      where("expires_at <= ?", Time.current).delete_all
+      where(email_address: email_address, purpose: purpose, join_code_id: join_code&.id).delete_all
+      create!(
+        email_address: email_address,
+        purpose: purpose,
+        identity: identity,
+        join_code: join_code,
+        code_digest: digest(code),
+        expires_at: LIFETIME.from_now
+      )
+    end
+
+    if purpose != "sign_in" || identity.present?
+      UserMailer.email_code(email_address: email_address, code: code).deliver_later
+    end
+
+    email_code
+  end
+
+  def active?
+    expires_at > Time.current && attempts < MAX_ATTEMPTS
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def locked?
+    attempts >= MAX_ATTEMPTS
+  end
+
+  def sign_in?
+    purpose == "sign_in"
+  end
+
+  def sign_up?
+    purpose == "sign_up"
+  end
+
+  def join?
+    purpose == "join"
+  end
+
+  def in_context_of?(account)
+    if join?
+      join_code.present? && join_code.account_id == account&.id
+    else
+      account.nil? && join_code_id.nil?
+    end
+  end
+
+  def consume(code)
+    with_lock do
+      if valid_code?(code)
+        destroy!
+        true
+      else
+        increment!(:attempts) if expires_at > Time.current && !locked?
+        false
+      end
+    end
+  end
+
+  private
+    def valid_code?(code)
+      code = code.to_s
+
+      if active? && code.match?(/\A[0-9]{#{CODE_LENGTH}}\z/)
+        ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.send(:digest, code))
+      else
+        false
+      end
+    end
+
+    def identity_email_address_matches
+      if identity.present? && identity.email_address != email_address
+        errors.add(:identity, "must match the email address")
+      end
+    end
+
+    def self.generate_code
+      SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+    end
+
+    def self.digest(code)
+      OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code)
+    end
+
+    private_class_method :generate_code, :digest
+end
