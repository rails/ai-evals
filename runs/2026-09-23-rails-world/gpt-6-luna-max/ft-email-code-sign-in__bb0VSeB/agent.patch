+class EmailCodesController < ApplicationController
+  skip_before_action :require_account
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_email_code
+  before_action :ensure_email_code_context
+
+  layout "public"
+
+  def show
+    set_error_message unless @email_code.active?
+    set_start_over_path
+  end
+
+  def create
+    @join_code = @email_code.join_code if @email_code.join?
+
+    if @join_code.present? && !@join_code.active?
+      render_join_code_inactive
+    elsif @email_code.consume(params[:code])
+      complete_email_code
+    else
+      set_error_message
+      set_start_over_path
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_by(id: params[:id])
+      head :not_found unless @email_code
+    end
+
+    def ensure_email_code_context
+      head :not_found unless @email_code.in_context_of?(Current.account)
+    end
+
+    def complete_email_code
+      if @email_code.sign_in?
+        complete_sign_in
+      elsif @email_code.sign_up?
+        complete_sign_up
+      else
+        complete_join
+      end
+    end
+
+    def complete_sign_in
+      if @email_code.identity.present? && @email_code.identity.email_address == @email_code.email_address
+        start_new_session_for @email_code.identity
+        redirect_to after_authentication_url
+      else
+        redirect_to new_session_path, alert: "That code couldn't sign you in. Request a new one."
+      end
+    end
+
+    def complete_sign_up
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      start_new_session_for identity
+      redirect_to new_signup_completion_path
+    end
+
+    def complete_join
+      identity = nil
+      @join_code.redeem_if do |account|
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        identity.join(account)
+      end
+
+      if identity && (user = User.active.find_by(account: @join_code.account, identity: identity))
+        start_new_session_for identity
+
+        if user.setup?
+          redirect_to landing_url(script_name: @join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+        end
+      else
+        render_join_code_inactive
+      end
+    end
+
+    def render_join_code_inactive
+      @join_code ||= @email_code.join_code
+      render "join_codes/inactive", status: :gone
+    end
+
+    def set_error_message
+      @error_message = if @email_code.expired?
+        "That code has expired. Request a new one."
+      elsif @email_code.locked?
+        "Too many attempts. Request a new code."
+      else
+        "That code didn't work. Try again."
+      end
+    end
+
+    def set_start_over_path
+      @start_over_path = if @email_code.sign_in?
+        new_session_path
+      elsif @email_code.sign_up?
+        new_signup_path
+      elsif @email_code.join_code.present?
+        join_path(code: @email_code.join_code.code, script_name: @email_code.join_code.account.slug)
+      end
+    end
+end
