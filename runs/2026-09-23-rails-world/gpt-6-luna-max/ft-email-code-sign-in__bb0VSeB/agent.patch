+++ b/test/controllers/email_codes_controller_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "sign in with an email code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      email_code = EmailCode.find_by!(email_address: identity.email_address, purpose: "sign_in")
+      code = code_from_last_email
+
+      assert_in_delta 15.minutes, email_code.expires_at - email_code.created_at, 1
+      assert_not_equal code, email_code.code_digest
+      assert_redirected_to email_code_path(email_code)
+      get email_code_path(email_code)
+      assert_response :success
+      assert_select 'input[name="code"]'
+
+      assert_difference -> { identity.sessions.count }, 1 do
+        post email_code_path(email_code), params: { code: code }
+      end
+
+      assert_response :redirect
+      assert_not EmailCode.exists?(email_code.id)
+    end
+  end
+
+  test "an incorrect code can be retried but a code can only be used once" do
+    identity = identities(:kevin)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      email_code = EmailCode.find_by!(email_address: identity.email_address, purpose: "sign_in")
+      code = code_from_last_email
+
+      post email_code_path(email_code), params: { code: "00000" }
+      assert_response :unprocessable_entity
+      assert_select 'input[name="code"]'
+
+      post email_code_path(email_code), params: { code: code }
+      assert_response :redirect
+
+      post email_code_path(email_code), params: { code: code }
+      assert_response :redirect
+      assert_not EmailCode.exists?(email_code.id)
+    end
+  end
+
+  test "expired codes cannot be used" do
+    identity = identities(:kevin)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      email_code = EmailCode.find_by!(email_address: identity.email_address, purpose: "sign_in")
+      code = code_from_last_email
+
+      travel_to email_code.expires_at + 1.second do
+        post email_code_path(email_code), params: { code: code }
+      end
+
+      assert_response :unprocessable_entity
+      assert_in_body "That code has expired"
+      assert_not identity.sessions.where("created_at > ?", email_code.created_at).exists?
+    end
+  end
+
+  test "sign up with an email code and complete signup" do
+    email_address = "new-signup@example.com"
+
+    untenanted do
+      perform_enqueued_jobs do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+
+      email_code = EmailCode.find_by!(email_address: email_address, purpose: "sign_up")
+      code = code_from_last_email
+
+      assert_redirected_to email_code_path(email_code)
+      post email_code_path(email_code), params: { code: code }
+      assert_redirected_to new_signup_completion_path
+
+      post signup_completion_path, params: { signup: { full_name: "New Signup" } }
+      assert_response :redirect
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    assert identity.users.exists?(name: "New Signup")
+  end
+
+  test "join with an email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "new-joiner@example.com"
+
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+    end
+
+    email_code = EmailCode.find_by!(email_address: email_address, purpose: "join", join_code: join_code)
+    code = code_from_last_email
+    assert_redirected_to email_code_path(email_code, script_name: account.slug)
+
+    get email_code_path(email_code, script_name: account.slug)
+    assert_response :success
+    assert_in_body account.name
+
+    post email_code_path(email_code, script_name: account.slug), params: { code: code }
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+
+    identity = Identity.find_by!(email_address: email_address)
+    assert account.users.exists?(identity: identity)
+  end
+
+  test "invalid sign-in email addresses do not receive codes" do
+    untenanted do
+      assert_no_difference -> { EmailCode.count } do
+        post session_path, params: { email_address: "not-an-email" }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "sign in does not reveal whether an email address has an account" do
+    email_address = "unknown@example.com"
+
+    untenanted do
+      assert_no_enqueued_emails do
+        post session_path, params: { email_address: email_address }
+      end
+
+      email_code = EmailCode.find_by!(email_address: email_address, purpose: "sign_in")
+      assert_redirected_to email_code_path(email_code)
+    end
+  end
+
+  private
+    def code_from_last_email
+      subject = ActionMailer::Base.deliveries.last.subject
+      subject.match(/\b([0-9]{6})\b/)[1]
+    end
+end
