@@ -0,0 +1,38 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <% if @email_code.sign_in? %>
+    <p class="margin-none">If there’s an account for <strong><%= @email_code.email_address %></strong>, we’ve sent a six-character sign-in code. It expires in 15 minutes.</p>
+  <% elsif @email_code.sign_up? %>
+    <p class="margin-none">We’ve sent a six-character code to <strong><%= @email_code.email_address %></strong>. It expires in 15 minutes.</p>
+  <% else %>
+    <p class="margin-none">We’ve sent a six-character code to <strong><%= @email_code.email_address %></strong>. Enter it to join <%= @email_code.join_code.account.name %>. It expires in 15 minutes.</p>
+  <% end %>
+
+  <% if @error_message.present? %>
+    <p class="txt-negative margin-none"><%= @error_message %></p>
+  <% end %>
+
+  <% if @email_code.active? %>
+    <%= form_with url: email_code_path(@email_code), method: :post, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, class: "input txt-large full-width", required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", pattern: "[0-9]{6}", minlength: 6, maxlength: 6, placeholder: "Enter your code", aria: { label: "Six-character code" } %>
+      </label>
+
+      <button type="submit" class="btn btn--link center" data-form-target="submit">
+        <span>Continue</span>
+        <%= icon_tag "arrow-right" %>
+      </button>
+    <% end %>
+  <% end %>
+
+  <% if @start_over_path.present? %>
+    <p class="margin-none txt-small"><%= link_to "Use a different email address or request a new code", @start_over_path %></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
