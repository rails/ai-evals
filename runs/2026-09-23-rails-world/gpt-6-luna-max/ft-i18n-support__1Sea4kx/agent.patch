+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/invite-link.gif" alt="招待リンクをコピー" caption="リンクを共有してメンバーを招待" content-type="image/*" filename="invite-link.gif" presentation="gallery"></action-text-attachment>
