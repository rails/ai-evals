+    <% if card.description.present? %>
+      <% if description_excerpt = excerpt(card.description.to_plain_text, query, radius: 100) %>
+        <p class="margin-none"><%= highlight(description_excerpt, query) %></p>
+      <% end %>
+    <% end %>
+
+    <% matching_comments.each do |comment| %>
