diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c45f61c
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles and highlights matches" do
+    get search_path(q: "LOGO")
+    assert_response :success
+
+    assert_select ".search_results a[href=?]", card_path(cards(:logo))
+    assert_select ".search_results mark", text: "logo"
+  end
+
+  test "blank search shows the form without returning cards" do
+    get search_path
+    assert_response :success
+
+    assert_select "form[action=?]", search_path
+    assert_select "input[type=search][name=q]"
+    assert_select ".search_results", false
+  end
+
+  test "searches card descriptions and comment bodies" do
+    card = cards(:layout)
+    card.update!(description: "A description needle to find")
+
+    get search_path(q: "description needle")
+    assert_response :success
+
+    assert_select ".search_results a[href=?]", card_path(card)
+    assert_select ".search_results mark", text: "description needle"
+
+    comments(:layout_overflowing_david).update!(body: "A comment needle to find")
+
+    get search_path(q: "comment needle")
+    assert_response :success
+
+    assert_select ".search_results a[href=?]", card_path(card)
+    assert_select ".search_results mark", text: "comment needle"
+  end
+
+  test "returns the newest matching cards first" do
+    older = cards(:logo)
+    newer = cards(:layout)
+    older.update_columns(title: "ordering needle older", created_at: 2.days.ago)
+    newer.update_columns(title: "ordering needle newer", created_at: 1.day.ago)
+
+    get search_path(q: "ordering needle")
+    assert_response :success
+
+    result_links = css_select(".search_results a").map { |link| link["href"] }
+    assert_operator result_links.index(card_path(newer)), :<, result_links.index(card_path(older))
+  end
+
+  test "does not return cards or comments from drafts" do
+    draft = boards(:writebook).cards.create!(
+      creator: users(:kevin), title: "draft title needle", status: :drafted, last_active_at: Time.current
+    )
+    draft_comment = Comment.new(card: draft, account: accounts("37s"), creator: users(:kevin))
+    draft_comment.save!(validate: false)
+    ActionText::RichText.create!(record: draft_comment, account: accounts("37s"), name: "body", body: "draft comment needle")
+
+    get search_path(q: "draft title needle")
+    assert_response :success
+    assert_select ".search_results a[href=?]", card_path(draft), 0
+
+    get search_path(q: "draft comment needle")
+    assert_response :success
+    assert_select ".search_results a[href=?]", card_path(draft), 0
+  end
+
+  test "search results reflect current board access" do
+    board = boards(:writebook)
+    board.update!(all_access: false)
+    board.accesses.revoke_from users(:kevin)
+
+    get search_path(q: "ship the app")
+    assert_response :success
+    assert_select ".search_results a[href=?]", card_path(cards(:shipping)), 0
+  end
+
+  test "search term wildcards are treated literally" do
+    card = cards(:logo)
+    card.update_columns(title: "A card that is 100% committed")
+
+    get search_path(q: "%")
+    assert_response :success
+
+    assert_select ".search_results a[href=?]", card_path(card)
+    assert_select ".search_results mark", text: "%"
+  end
+end
