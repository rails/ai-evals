+<li>
+  <article class="flex flex-column gap-half">
+    <h2 class="txt-normal margin-none">
+      <%= link_to highlight(card.title.presence || "Untitled", query), card_path(card) %>
+    </h2>
+
+    <p class="txt-small margin-none"><%= link_to card.board.name, board_path(card.board) %></p>
