+        <p class="txt-small margin-none"><%= highlight(comment_excerpt, query) %></p>
+      <% end %>
+    <% end %>
+  </article>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..5e8cead
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,27 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.search_field :q, value: @query, class: "input full-width", placeholder: "Search cards…", autofocus: true, aria: { label: "Search cards" } %>
+    <%= form.button class: "btn btn--link" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p class="blank-slate">Search card titles, descriptions, and comments on boards you can access.</p>
+  <% elsif @page.records.any? %>
+    <%= with_automatic_pagination :search_results, @page, tag_element: :ol, class: "unpad margin-none-block-start flex flex-column gap" do %>
+      <% @page.records.each do |card| %>
+        <%= render "searches/result", card: card, query: @query, matching_comments: @matching_comments.fetch(card.id, []) %>
+      <% end %>
+    <% end %>
+  <% else %>
+    <p class="blank-slate">No cards match “<%= @query %>”.</p>
+  <% end %>
+</section>
