+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,25 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    if @query.present?
+      cards = Current.user.accessible_cards.published.search_for(@query)
+        .reverse_chronologically
+        .preload(:board, :rich_text_description)
+    else
+      cards = Current.user.accessible_cards.none
+    end
+
+    set_page_and_extract_portion_from cards
+
+    if @query.present?
+      @matching_comments = Comment.search_for(@query)
+        .where(card_id: @page.records.map(&:id))
+        .preload(:rich_text_body)
+        .chronologically
+        .group_by(&:card_id)
+    else
+      @matching_comments = {}
+    end
+  end
+end
