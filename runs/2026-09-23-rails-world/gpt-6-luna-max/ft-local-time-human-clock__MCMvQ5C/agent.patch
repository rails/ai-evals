diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..f79d44a
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,92 @@
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+
+export function formatLocalDate(date, style = "short") {
+  const currentYear = new Date().getFullYear()
+  const options = { month: style === "long" ? "long" : "short", day: "numeric" }
+
+  if (style === "long") options.weekday = "long"
+  if (style === "full" || date.getFullYear() !== currentYear) options.year = "numeric"
+
+  return new Intl.DateTimeFormat(undefined, options).format(date)
+}
+
+export function formatLocalTime(date) {
+  return new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+export function formatTimestamp(date, format = "calendar", now = new Date()) {
+  switch (format) {
+    case "time":
+      return formatLocalTime(date)
+    case "date":
+      return formatLocalDate(date)
+    case "date_full":
+      return formatLocalDate(date, "full")
+    case "long_date":
+    case "weekday":
+      return formatLocalDate(date, "long")
+    case "date_time":
+      return new Intl.DateTimeFormat(undefined, {
+        year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit"
+      }).format(date)
+    case "relative":
+      return formatRelativeTime(date, now)
+    case "day":
+      return formatRelativeDay(date, now, false)
+    case "calendar":
+    default:
+      return formatRelativeDay(date, now, true)
+  }
+}
+
+function formatRelativeDay(date, now, showTimeToday) {
+  const daysFromNow = calendarDay(date) - calendarDay(now)
+
+  if (daysFromNow === 0) {
+    return showTimeToday ? formatLocalTime(date) : new Intl.RelativeTimeFormat(undefined, { numeric: "auto" }).format(0, "day")
+  }
+
+  if (Math.abs(daysFromNow) === 1) {
+    return new Intl.RelativeTimeFormat(undefined, { numeric: "auto" }).format(daysFromNow, "day")
+  }
+
+  if (Math.abs(daysFromNow) < 7) {
+    return new Intl.RelativeTimeFormat(undefined, { numeric: "always" }).format(daysFromNow, "day")
+  }
+
+  return formatLocalDate(date)
+}
+
+function formatRelativeTime(date, now) {
+  const secondsFromNow = (date.getTime() - now.getTime()) / 1000
+  const absoluteSeconds = Math.abs(secondsFromNow)
+  let unit
+  let secondsPerUnit
+
+  if (absoluteSeconds < 60) {
+    unit = "second"
+    secondsPerUnit = 1
+  } else if (absoluteSeconds < 60 * 60) {
+    unit = "minute"
+    secondsPerUnit = 60
+  } else if (absoluteSeconds < 24 * 60 * 60) {
+    unit = "hour"
+    secondsPerUnit = 60 * 60
+  } else if (absoluteSeconds < 30 * 24 * 60 * 60) {
+    unit = "day"
+    secondsPerUnit = 24 * 60 * 60
+  } else if (absoluteSeconds < 365 * 24 * 60 * 60) {
+    unit = "month"
+    secondsPerUnit = 30.4375 * 24 * 60 * 60
+  } else {
+    unit = "year"
+    secondsPerUnit = 365.25 * 24 * 60 * 60
+  }
+
+  const amount = Math.round(secondsFromNow / secondsPerUnit)
+  return new Intl.RelativeTimeFormat(undefined, { numeric: "auto" }).format(amount, unit)
+}
+
+function calendarDay(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / DAY_IN_MILLISECONDS
+}
