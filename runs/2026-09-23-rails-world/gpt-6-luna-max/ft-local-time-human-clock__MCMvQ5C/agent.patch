@@ -0,0 +1,20 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "browser_time_tag outputs the same raw UTC timestamp in every server timezone" do
+    timestamp = Time.utc(2025, 9, 12, 0, 42)
+    rendered = [ "America/Los_Angeles", "Asia/Tokyo" ].map do |timezone|
+      Time.use_zone(timezone) do
+        browser_time_tag(timestamp.in_time_zone, format: :calendar).to_s
+      end
+    end
+
+    assert_equal rendered.first, rendered.last
+    assert_select parse(rendered.first), "time[datetime='2025-09-12T00:42:00.000Z'][data-controller='local-time'][data-local-time-format-value='calendar']",
+      text: "2025-09-12T00:42:00.000Z"
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..79fa6cf
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,88 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders a comment timestamp in the browser timezone" do
+    sign_in_as(users(:kevin))
+
+    comment = comments(:logo_agreement_kevin)
+    visit card_url(comment.card)
+
+    server_timezone = page.evaluate_script("new Date().getTimezoneOffset() > 0 ? 'Asia/Tokyo' : 'America/Los_Angeles'")
+    timestamp = page.evaluate_script(<<~JS)
+      (() => {
+        const now = new Date()
+        return new Date(now.getFullYear(), now.getMonth(), now.getDate(), 13, 42).toISOString()
+      })()
+    JS
+    comment.update!(created_at: Time.iso8601(timestamp))
+
+    page.driver.browser.manage.add_cookie(name: "timezone", value: server_timezone)
+    visit card_url(comment.card)
+
+    expected = page.evaluate_script(<<~JS)
+      (() => {
+        const timestamp = #{timestamp.to_json}
+        return new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(new Date(timestamp))
+      })()
+    JS
+    assert_selector "a.comment__permalink-title time", text: expected
+    time = find("a.comment__permalink-title time[datetime='#{timestamp}']")
+
+    assert_equal timestamp, time["datetime"]
+    assert_equal expected, time.text
+  end
+
+  test "formats calendar and relative labels in the viewer's timezone" do
+    sign_in_as(users(:kevin))
+    visit card_url(cards(:logo))
+
+    expected = page.evaluate_script(<<~JS)
+      (() => {
+        const now = new Date()
+        const makeDate = (days) => new Date(now.getFullYear(), now.getMonth(), now.getDate() + days, 13, 42)
+        const relative = new Intl.RelativeTimeFormat(undefined, { numeric: "auto" })
+        const exactRelative = new Intl.RelativeTimeFormat(undefined, { numeric: "always" })
+        const shortDate = (date) => {
+          const options = { month: "short", day: "numeric" }
+          if (date.getFullYear() !== now.getFullYear()) options.year = "numeric"
+          return new Intl.DateTimeFormat(undefined, options).format(date)
+        }
+        const dates = {
+          today: [ makeDate(0), "calendar" ],
+          yesterday: [ makeDate(-1), "calendar" ],
+          fiveDaysAgo: [ makeDate(-5), "calendar" ],
+          older: [ makeDate(-8), "calendar" ],
+          tomorrow: [ makeDate(1), "day" ],
+          threeDays: [ makeDate(3), "day" ],
+          twoHoursAgo: [ new Date(Date.now() - 2 * 60 * 60 * 1000), "relative" ]
+        }
+        const expected = {
+          today: new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(dates.today[0]),
+          yesterday: relative.format(-1, "day"),
+          fiveDaysAgo: exactRelative.format(-5, "day"),
+          older: shortDate(dates.older[0]),
+          tomorrow: relative.format(1, "day"),
+          threeDays: exactRelative.format(3, "day"),
+          twoHoursAgo: exactRelative.format(-2, "hour")
+        }
+        const container = document.createElement("div")
+        container.id = "local-time-test"
+        for (const [name, [date, format]] of Object.entries(dates)) {
+          const time = document.createElement("time")
+          time.id = `local-time-${name}`
+          time.dateTime = date.toISOString()
+          time.dataset.controller = "local-time"
+          time.dataset.localTimeFormatValue = format
+          time.textContent = time.dateTime
+          container.append(time)
+        }
+        document.body.append(container)
+        return expected
+      })()
+    JS
+
+    expected.each do |name, text|
+      assert_selector "#local-time-#{name}", text: text
+    end
+  end
+end
