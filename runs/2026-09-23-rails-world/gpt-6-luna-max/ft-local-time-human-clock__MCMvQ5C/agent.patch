diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..bc9403c
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "calendar" } }
+
+  connect() {
+    this.observer = new MutationObserver(() => this.render())
+    this.observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-format-value" ],
+      childList: true,
+      characterData: true,
+      subtree: true
+    })
+
+    this.render()
+  }
+
+  disconnect() {
+    this.observer.disconnect()
+  }
+
+  render() {
+    const date = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(date.getTime())) {
+      const text = formatTimestamp(date, this.formatValue)
+      if (this.element.textContent !== text) this.element.textContent = text
+    }
+  }
+}
