+++ b/.kamal/secrets.example
@@ -0,0 +1,15 @@
+# Copy this file to .kamal/secrets and replace the values below.
+# Keep .kamal/secrets private; it is excluded from git and Docker builds.
+# Generate SECRET_KEY_BASE once with `bin/rails secret` and keep it unchanged
+# across deployments so existing sessions and signed data remain valid.
+SECRET_KEY_BASE=replace-with-output-of-bin-rails-secret
+
+# Use credentials from your SMTP provider. Leave both blank if the server does
+# not require SMTP authentication.
+SMTP_USERNAME=replace-with-your-smtp-username
+SMTP_PASSWORD=replace-with-your-smtp-password
+
+# Generate this pair once with the command in docs/deployment.md. Keep the
+# same pair so existing browser push subscriptions continue to work.
+VAPID_PUBLIC_KEY=replace-with-generated-public-key
+VAPID_PRIVATE_KEY=replace-with-generated-private-key
