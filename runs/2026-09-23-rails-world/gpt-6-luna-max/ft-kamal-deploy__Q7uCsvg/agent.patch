new file mode 100644
index 0000000..ca5fa2e
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,46 @@
+# Change this hostname once; DNS must reach the server for SSH and HTTPS.
+<% app_host = "fizzy.example.com" %>
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - <%= app_host %>
+
+proxy:
+  ssl: true
+  host: <%= app_host %>
+
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    APP_HOST: <%= app_host %>
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    SOLID_QUEUE_IN_PUMA: true
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: <%= app_host %>
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    SMTP_SSL: false
+    MAILER_FROM_ADDRESS: "Fizzy <no-reply@<%= app_host %>>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
