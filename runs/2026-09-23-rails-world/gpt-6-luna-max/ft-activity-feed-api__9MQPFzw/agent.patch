new file mode 100644
index 0000000..26cec4f
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,69 @@
+# Activities
+
+Account activity reports card and comment events from boards the current user can access.
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat, paginated array of activity, newest first. The response includes card and comment events shown in the HTML timeline, omits deprecated `card_collection_changed` events, and includes `card_title_changed` events. Events are limited to boards the authenticated user can access.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by event creator ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+Filters can be combined. List parameters can be repeated, for example `?creator_ids[]=user1&creator_ids[]=user2`.
+
+__Response:__
+
+Each activity has `id`, `action`, `created_at`, `description`, `particulars`, `url`, `eventable_type`, `eventable`, `board`, and `creator`. The `eventable`, `board`, and `creator` fields use the same representations as their respective API resources. `description` is plain text.
+
+`url` opens the card for card events. For a comment event, it opens the card and anchors to the comment.
+
+`particulars` contains event-specific data:
+
+- `card_assigned` and `card_unassigned`: `assignee_ids`
+- `card_board_changed`: `old_board` and `new_board`
+- `card_title_changed`: `old_title` and `new_title`
+- `card_triaged` and `card_sent_back_to_triage`: `column`
+- Other actions: an empty object (`{}`)
+
+Missing board, title, or column values are represented by empty strings.
+
+The nested resource objects in this example are abbreviated; each uses the full representation from its corresponding API endpoint.
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_title_changed",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David renamed \"First!\" (was: \"Old title\")",
+    "particulars": {
+      "old_title": "Old title",
+      "new_title": "First!"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srr3",
+      "number": 4,
+      "title": "First!",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner"
+    }
+  }
+]
+```
+
+If another page is available, the response includes a `Link` header with a `rel="next"` URL, following the standard [pagination conventions](../README.md#pagination).
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..fddfd7d
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,162 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index authenticates API clients with a bearer token" do
+    cookies.delete :session_token
+    token = identity_access_tokens(:davids_api_token).token
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token}" }
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+  end
+
+  test "index returns a flat array of the current user's accessible activity, newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+
+    expected_ids = users(:kevin).accessible_events.api_activity.order(created_at: :desc, id: :desc).pluck(:id)
+    assert_equal expected_ids, response.parsed_body.map { |activity| activity["id"] }
+  end
+
+  test "activity includes descriptions, API representations, and card and comment URLs" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = response.parsed_body.index_by { |activity| activity["id"] }
+
+    card_event = events(:logo_published)
+    card_activity = activities.fetch(card_event.id)
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url].sort, card_activity.keys.sort
+    assert_equal card_event.description_for(users(:kevin)).to_plain_text, card_activity["description"]
+    assert_equal "Card", card_activity["eventable_type"]
+    assert_equal card_event.eventable.id, card_activity.dig("eventable", "id")
+    assert_equal card_url(card_event.eventable), card_activity["url"]
+    assert_equal card_event.board.id, card_activity.dig("board", "id")
+    assert_equal card_event.creator.id, card_activity.dig("creator", "id")
+
+    comment_event = events(:layout_commented)
+    comment_activity = activities.fetch(comment_event.id)
+    assert_equal "Comment", comment_activity["eventable_type"]
+    assert_equal comment_event.eventable.id, comment_activity.dig("eventable", "id")
+    assert_equal comment_event.eventable.card.id, comment_activity.dig("eventable", "card", "id")
+    assert_equal card_url(comment_event.eventable.card, anchor: dom_id(comment_event.eventable)), comment_activity["url"]
+  end
+
+  test "omits collection changes and includes card title changes" do
+    events(:logo_published).update_columns(action: "card_collection_changed")
+    events(:layout_published).update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = response.parsed_body
+    actions = activities.map { |activity| activity["action"] }
+    assert_includes actions, "card_title_changed"
+    assert_not_includes actions, "card_collection_changed"
+  end
+
+  test "returns event-specific particulars and empty strings for missing values" do
+    events(:layout_published).update_columns(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "new_board" => "New board" } }
+    )
+    events(:text_published).update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title" } }
+    )
+    events(:shipping_published).update_columns(action: "card_triaged", particulars: {})
+    events(:logo_assignment_km).update_columns(action: "card_unassigned", particulars: { assignee_ids: [ users(:kevin).id ] })
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = response.parsed_body.index_by { |activity| activity["id"] }
+
+    assert_equal [ users(:jz).id ], activities.fetch(events(:logo_assignment_jz).id).dig("particulars", "assignee_ids")
+    assert_equal [ users(:kevin).id ], activities.fetch(events(:logo_assignment_km).id).dig("particulars", "assignee_ids")
+    assert_equal({ "old_board" => "", "new_board" => "New board" }, activities.fetch(events(:layout_published).id)["particulars"])
+    assert_equal({ "old_title" => "Old title", "new_title" => "" }, activities.fetch(events(:text_published).id)["particulars"])
+    assert_equal({ "column" => "" }, activities.fetch(events(:shipping_published).id)["particulars"])
+    assert_equal({ "column" => "" }, activities.fetch(events(:buy_domain_sent_back_to_triage).id)["particulars"])
+    assert_equal({}, activities.fetch(events(:logo_published).id)["particulars"])
+  end
+
+  test "filters by creator and board IDs" do
+    get activities_path(format: :json, creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ])
+
+    assert_response :success
+    activities = response.parsed_body
+    assert_predicate activities, :present?
+    assert activities.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+    assert activities.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "does not return events on boards the current user cannot access" do
+    private_card = Card.create!(
+      board: boards(:private),
+      creator: users(:kevin),
+      title: "Private activity card",
+      status: "drafted"
+    )
+    private_event = Event.create!(
+      board: boards(:private),
+      creator: users(:kevin),
+      eventable: private_card,
+      action: "card_published"
+    )
+
+    logout_and_sign_in_as :jz
+    get activities_path(format: :json)
+
+    assert_response :success
+    returned_ids = response.parsed_body.map { |activity| activity["id"] }
+    assert_not_includes returned_ids, private_event.id
+    assert_equal users(:jz).accessible_events.api_activity.order(created_at: :desc, id: :desc).pluck(:id), returned_ids
+  end
+
+  test "uses the standard API pagination headers and ordering" do
+    6.times do |index|
+      Event.create!(
+        board: boards(:writebook),
+        creator: users(:kevin),
+        eventable: cards(:logo),
+        action: "card_published",
+        created_at: Time.current + index.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.api_activity.order(created_at: :desc, id: :desc).pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(response.parsed_body.map { |activity| activity["id"] })
+      next_page = next_page_from_link_header(response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+    assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
