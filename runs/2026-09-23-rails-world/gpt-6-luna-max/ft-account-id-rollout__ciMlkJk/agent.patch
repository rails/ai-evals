+        id_column: "owner_id",
+        types: { "Account" => "accounts", "Board" => "boards" }
+      )
+    end
+
+    def polymorphic_account_expression(table:, type_column:, id_column:, types:)
+      cases = types.map do |type, owner_table|
+        account_column = owner_table == "accounts" ? "id" : "account_id"
+        "WHEN '#{type}' THEN (SELECT #{owner_table}.#{account_column} FROM #{owner_table} WHERE #{owner_table}.id = #{table}.#{id_column})"
+      end
+
+      "CASE #{table}.#{type_column} #{cases.join(' ')} END"
+    end
+
+    def backfill_account_id(table, expression, only_missing: false)
+      where = "WHERE account_id IS NULL" if only_missing
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (#{expression})
+        #{where}
+      SQL
+    end
+
+    def drop_orphaned_account_rows
+      %i[users tags account_cancellations account_imports account_join_codes exports].each do |table|
+        drop_unowned_rows table
+      end
+
+      delete_if_orphaned :account_cancellations, <<~SQL
+        NOT EXISTS (SELECT 1 FROM users WHERE users.id = account_cancellations.initiated_by_id)
+      SQL
+      delete_if_orphaned :account_imports, <<~SQL
+        NOT EXISTS (SELECT 1 FROM identities WHERE identities.id = account_imports.identity_id)
+      SQL
+      delete_if_orphaned :exports, <<~SQL
+        NOT EXISTS (SELECT 1 FROM users WHERE users.id = exports.user_id)
+      SQL
+    end
+
+    def drop_orphaned_application_rows
+      %i[boards columns cards comments filters webhooks].each do |table|
+        drop_unowned_rows table
+      end
+
+      delete_if_orphaned :boards, <<~SQL
+        NOT EXISTS (SELECT 1 FROM users WHERE users.id = boards.creator_id)
+      SQL
+      delete_if_orphaned :columns, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM boards
+          WHERE boards.id = columns.board_id AND boards.account_id = columns.account_id
+        )
+      SQL
+      delete_if_orphaned :cards, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM boards
+          WHERE boards.id = cards.board_id AND boards.account_id = cards.account_id
+        ) OR NOT EXISTS (SELECT 1 FROM users WHERE users.id = cards.creator_id)
+      SQL
+      execute <<~SQL
+        UPDATE cards
+        SET column_id = NULL
+        WHERE column_id IS NOT NULL AND NOT EXISTS (
+          SELECT 1 FROM columns
+          WHERE columns.id = cards.column_id
+            AND columns.board_id = cards.board_id
+            AND columns.account_id = cards.account_id
+        )
+      SQL
+      delete_if_orphaned :comments, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM cards
+          WHERE cards.id = comments.card_id AND cards.account_id = comments.account_id
+        ) OR NOT EXISTS (SELECT 1 FROM users WHERE users.id = comments.creator_id)
+      SQL
+      delete_if_orphaned :filters, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM users
+          WHERE users.id = filters.creator_id AND users.account_id = filters.account_id
+        )
+      SQL
+      delete_if_orphaned :webhooks, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM boards
+          WHERE boards.id = webhooks.board_id AND boards.account_id = webhooks.account_id
+        )
+      SQL
+
+      drop_orphaned_child_rows
+      drop_orphaned_event_rows
+      drop_orphaned_filter_links
+      drop_orphaned_notifications
+      drop_orphaned_storage_rows
+    end
+
+    def drop_orphaned_child_rows
+      delete_if_orphaned :accesses, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM boards
+          WHERE boards.id = accesses.board_id AND boards.account_id = accesses.account_id
+        ) OR NOT EXISTS (SELECT 1 FROM users WHERE users.id = accesses.user_id)
+      SQL
+      delete_if_orphaned :assignments, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM cards
+          WHERE cards.id = assignments.card_id AND cards.account_id = assignments.account_id
+        ) OR NOT EXISTS (SELECT 1 FROM users WHERE users.id = assignments.assignee_id)
+          OR NOT EXISTS (SELECT 1 FROM users WHERE users.id = assignments.assigner_id)
+      SQL
+
+      %i[card_activity_spikes card_goldnesses card_not_nows closures steps pins watches taggings].each do |table|
+        delete_if_orphaned table, <<~SQL.squish
+          NOT EXISTS (
+            SELECT 1 FROM cards
+            WHERE cards.id = #{table}.card_id AND cards.account_id = #{table}.account_id
+          )
+        SQL
+      end
+      delete_if_orphaned :card_not_nows, <<~SQL
+        user_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM users WHERE users.id = card_not_nows.user_id)
+      SQL
+      delete_if_orphaned :closures, <<~SQL
+        user_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM users WHERE users.id = closures.user_id)
+      SQL
+      %i[pins watches].each do |table|
+        delete_if_orphaned table, "NOT EXISTS (SELECT 1 FROM users WHERE users.id = #{table}.user_id)"
+      end
+      delete_if_orphaned :taggings, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM tags
+          WHERE tags.id = taggings.tag_id AND tags.account_id = taggings.account_id
+        )
+      SQL
+      delete_if_orphaned :board_publications, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM boards
+          WHERE boards.id = board_publications.board_id
+            AND boards.account_id = board_publications.account_id
+        )
+      SQL
+      delete_if_orphaned :webhook_delinquency_trackers, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM webhooks
+          WHERE webhooks.id = webhook_delinquency_trackers.webhook_id
+            AND webhooks.account_id = webhook_delinquency_trackers.account_id
+        )
+      SQL
+      delete_if_orphaned :webhook_deliveries, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM webhooks
+          WHERE webhooks.id = webhook_deliveries.webhook_id
+            AND webhooks.account_id = webhook_deliveries.account_id
+        ) OR NOT EXISTS (
+          SELECT 1 FROM events
+          WHERE events.id = webhook_deliveries.event_id
+            AND events.account_id = webhook_deliveries.account_id
+        )
+      SQL
+    end
+
+    def drop_orphaned_filter_links
+      {
+        assignees_filters: [ :assignee_id, "users" ],
+        assigners_filters: [ :assigner_id, "users" ],
+        closers_filters: [ :closer_id, "users" ],
+        creators_filters: [ :creator_id, "users" ],
+        boards_filters: [ :board_id, "boards" ],
+        filters_tags: [ :tag_id, "tags" ]
+      }.each do |table, (foreign_key, parent_table)|
+        delete_if_orphaned table, <<~SQL.squish
+          NOT EXISTS (
+            SELECT 1 FROM filters
+            WHERE filters.id = #{table}.filter_id AND filters.account_id = #{table}.account_id
+          ) OR NOT EXISTS (
+            SELECT 1 FROM #{parent_table}
+            WHERE #{parent_table}.id = #{table}.#{foreign_key}
+          )
+        SQL
+      end
+    end
+
+    def drop_orphaned_event_rows
+      delete_if_orphaned :events, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM boards
+          WHERE boards.id = events.board_id AND boards.account_id = events.account_id
+        ) OR NOT EXISTS (SELECT 1 FROM users WHERE users.id = events.creator_id)
+          OR NOT (
+            (events.eventable_type = 'Card' AND EXISTS (
+              SELECT 1 FROM cards
+              WHERE cards.id = events.eventable_id AND cards.account_id = events.account_id
+            )) OR (events.eventable_type = 'Comment' AND EXISTS (
+              SELECT 1 FROM comments
+              WHERE comments.id = events.eventable_id AND comments.account_id = events.account_id
+            ))
+          )
+      SQL
+      delete_if_orphaned :mentions, <<~SQL
+        NOT EXISTS (SELECT 1 FROM users WHERE users.id = mentions.mentionee_id)
+          OR NOT EXISTS (SELECT 1 FROM users WHERE users.id = mentions.mentioner_id)
+          OR NOT (
+            (mentions.source_type = 'Card' AND EXISTS (
+              SELECT 1 FROM cards
+              WHERE cards.id = mentions.source_id AND cards.account_id = mentions.account_id
+            )) OR (mentions.source_type = 'Comment' AND EXISTS (
+              SELECT 1 FROM comments
+              WHERE comments.id = mentions.source_id AND comments.account_id = mentions.account_id
+            ))
+          )
+      SQL
+      delete_if_orphaned :reactions, <<~SQL
+        NOT EXISTS (SELECT 1 FROM users WHERE users.id = reactions.reacter_id)
+          OR NOT (
+            (reactions.reactable_type = 'Card' AND EXISTS (
+              SELECT 1 FROM cards
+              WHERE cards.id = reactions.reactable_id AND cards.account_id = reactions.account_id
+            )) OR (reactions.reactable_type = 'Comment' AND EXISTS (
+              SELECT 1 FROM comments
+              WHERE comments.id = reactions.reactable_id AND comments.account_id = reactions.account_id
+            ))
+          )
+      SQL
+    end
+
+    def drop_orphaned_notifications
+      delete_if_orphaned :notification_bundles, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM users
+          WHERE users.id = notification_bundles.user_id
+            AND users.account_id = notification_bundles.account_id
+        )
+      SQL
+      delete_if_orphaned :notifications, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM users
+          WHERE users.id = notifications.user_id
+            AND users.account_id = notifications.account_id
+        ) OR NOT EXISTS (SELECT 1 FROM cards WHERE cards.id = notifications.card_id)
+          OR (creator_id IS NOT NULL AND NOT EXISTS (
+            SELECT 1 FROM users WHERE users.id = notifications.creator_id
+          )) OR NOT (
+            (notifications.source_type = 'Event' AND EXISTS (
+              SELECT 1 FROM events WHERE events.id = notifications.source_id
+            )) OR (notifications.source_type = 'Mention' AND EXISTS (
+              SELECT 1 FROM mentions WHERE mentions.id = notifications.source_id
+            ))
+          )
+      SQL
+      %i[push_subscriptions user_settings search_queries].each do |table|
+        delete_if_orphaned table, <<~SQL.squish
+          NOT EXISTS (
+            SELECT 1 FROM users
+            WHERE users.id = #{table}.user_id AND users.account_id = #{table}.account_id
+          )
+        SQL
+      end
+    end
+
+    def drop_orphaned_storage_rows
+      delete_if_orphaned :storage_entries, <<~SQL
+        NOT EXISTS (SELECT 1 FROM accounts WHERE accounts.id = storage_entries.account_id)
+          OR (board_id IS NOT NULL AND NOT EXISTS (
+            SELECT 1 FROM boards
+            WHERE boards.id = storage_entries.board_id
+              AND boards.account_id = storage_entries.account_id
+          )) OR (user_id IS NOT NULL AND NOT EXISTS (
+            SELECT 1 FROM users WHERE users.id = storage_entries.user_id
+          ))
+      SQL
+      delete_if_orphaned :storage_totals, <<~SQL
+        NOT (
+          (storage_totals.owner_type = 'Account' AND EXISTS (
+            SELECT 1 FROM accounts
+            WHERE accounts.id = storage_totals.owner_id AND accounts.id = storage_totals.account_id
+          )) OR (storage_totals.owner_type = 'Board' AND EXISTS (
+            SELECT 1 FROM boards
+            WHERE boards.id = storage_totals.owner_id AND boards.account_id = storage_totals.account_id
+          ))
+        )
+      SQL
+      delete_if_orphaned :entropies, <<~SQL
+        NOT (
+          (entropies.container_type = 'Account' AND EXISTS (
+            SELECT 1 FROM accounts
+            WHERE accounts.id = entropies.container_id AND accounts.id = entropies.account_id
+          )) OR (entropies.container_type = 'Board' AND EXISTS (
+            SELECT 1 FROM boards
+            WHERE boards.id = entropies.container_id AND boards.account_id = entropies.account_id
+          )) OR (entropies.container_type = 'Card' AND EXISTS (
+            SELECT 1 FROM cards
+            WHERE cards.id = entropies.container_id AND cards.account_id = entropies.account_id
+          ))
+        )
+      SQL
+    end
