+        id_column: "record_id",
+        types: { "Board" => "boards", "Card" => "cards", "Comment" => "comments" }
+      )
+      drop_unowned_rows :action_text_rich_texts
+      delete_if_orphaned :action_text_rich_texts, <<~SQL
+        NOT (
+          (record_type = 'Board' AND EXISTS (
+            SELECT 1 FROM boards
+            WHERE boards.id = action_text_rich_texts.record_id
+              AND boards.account_id = action_text_rich_texts.account_id
+          )) OR (record_type = 'Card' AND EXISTS (
+            SELECT 1 FROM cards
+            WHERE cards.id = action_text_rich_texts.record_id
+              AND cards.account_id = action_text_rich_texts.account_id
+          )) OR (record_type = 'Comment' AND EXISTS (
+            SELECT 1 FROM comments
+            WHERE comments.id = action_text_rich_texts.record_id
+              AND comments.account_id = action_text_rich_texts.account_id
+          ))
+        )
+      SQL
+
+      # Global identity avatars do not have a single tenant owner and are discarded here.
+      backfill_account_id :active_storage_attachments, polymorphic_account_expression(
+        table: "active_storage_attachments",
+        type_column: "record_type",
+        id_column: "record_id",
+        types: {
+          "Card" => "cards",
+          "User" => "users",
+          "Account::Import" => "account_imports",
+          "Export" => "exports",
+          "ActionText::RichText" => "action_text_rich_texts"
+        }
+      )
+      drop_unowned_rows :active_storage_attachments
+      delete_if_orphaned :active_storage_attachments, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_attachments.blob_id
+        ) OR NOT (
+          (record_type = 'Card' AND EXISTS (
+            SELECT 1 FROM cards
+            WHERE cards.id = active_storage_attachments.record_id
+              AND cards.account_id = active_storage_attachments.account_id
+          )) OR (record_type = 'User' AND EXISTS (
+            SELECT 1 FROM users
+            WHERE users.id = active_storage_attachments.record_id
+              AND users.account_id = active_storage_attachments.account_id
+          )) OR (record_type = 'Account::Import' AND EXISTS (
+            SELECT 1 FROM account_imports
+            WHERE account_imports.id = active_storage_attachments.record_id
+              AND account_imports.account_id = active_storage_attachments.account_id
+          )) OR (record_type = 'Export' AND EXISTS (
+            SELECT 1 FROM exports
+            WHERE exports.id = active_storage_attachments.record_id
+              AND exports.account_id = active_storage_attachments.account_id
+          )) OR (record_type = 'ActionText::RichText' AND EXISTS (
+            SELECT 1 FROM action_text_rich_texts
+            WHERE action_text_rich_texts.id = active_storage_attachments.record_id
+              AND action_text_rich_texts.account_id = active_storage_attachments.account_id
+          ))
+        )
+      SQL
+      drop_cross_account_blob_attachments
+
+      backfill_account_id :active_storage_blobs, <<~SQL.squish
+        SELECT active_storage_attachments.account_id
+        FROM active_storage_attachments
+        WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+          AND active_storage_attachments.account_id IS NOT NULL
+        LIMIT 1
+      SQL
+      drop_unowned_rows :active_storage_blobs
+      delete_if_orphaned :active_storage_blobs, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id = active_storage_blobs.account_id
+        )
+      SQL
+
+      backfill_account_id :active_storage_variant_records, <<~SQL.squish
+        SELECT active_storage_blobs.account_id
+        FROM active_storage_blobs
+        WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+      SQL
+      drop_unowned_rows :active_storage_variant_records
+      delete_if_orphaned :active_storage_variant_records, <<~SQL
+        NOT EXISTS (
+          SELECT 1 FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+            AND active_storage_blobs.account_id = active_storage_variant_records.account_id
+        )
+      SQL
+    end
+
+    def drop_cross_account_blob_attachments
+      # Never assign a shared blob to an arbitrary account.
+      execute <<~SQL
+        DELETE FROM active_storage_attachments
+        WHERE blob_id IN (
+          SELECT cross_account_blobs.blob_id
+          FROM (
+            SELECT blob_id
+            FROM active_storage_attachments
+            GROUP BY blob_id
+            HAVING COUNT(DISTINCT account_id) > 1
+          ) AS cross_account_blobs
+        )
+      SQL
+    end
+
+    def drop_unowned_rows(table)
+      execute <<~SQL
+        DELETE FROM #{table}
+        WHERE account_id IS NULL
+          OR NOT EXISTS (SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id)
+      SQL
+    end
+
+    def delete_if_orphaned(table, condition)
+      execute "DELETE FROM #{table} WHERE #{condition}"
+    end
+
+    def enforce_account_id_constraints
+      ACCOUNT_ID_TABLES.each do |table|
+        change_column_null table, :account_id, false
+        add_index table, :account_id unless index_exists?(table, :account_id)
+      end
+
+      remove_index :tags, name: "index_tags_on_title"
+      add_index :tags, [ :account_id, :title ], unique: true
+    end
+end
