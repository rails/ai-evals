diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..bf3b934
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,334 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "card", "column" ]
+
+  cardTargetConnected(card) {
+    if (card.dataset.dragAndDropPending !== "true") card.draggable = true
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    if (!card || card.dataset.dragAndDropPending === "true") return
+
+    this.draggedCard = card
+    card.classList.add(this.draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event.target)
+    this.#setHoveredColumn(column)
+
+    if (column) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.element.contains(event.relatedTarget)) this.#setHoveredColumn(null)
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event.target)
+    if (column) {
+      event.preventDefault()
+      this.#moveCard(this.draggedCard, column)
+    }
+
+    this.#finishDrag()
+  }
+
+  end() {
+    this.#finishDrag()
+  }
+
+  disconnect() {
+    this.#finishDrag()
+  }
+
+  #moveCard(card, column) {
+    const currentState = this.#cardState(card)
+    const destinationState = this.#destinationState(column, currentState)
+
+    if (!destinationState || this.#isAlreadyThere(currentState, destinationState)) return
+
+    const sourceColumn = this.#columnFor(card)
+    const cardsList = this.#cardsListFor(column)
+    if (!sourceColumn || !cardsList || !card.parentElement) return
+
+    const snapshot = {
+      parent: card.parentElement,
+      nextSibling: card.nextSibling,
+      sourceColumn,
+      state: currentState,
+      stamp: card.querySelector(".card__closed")?.cloneNode(true),
+      counts: this.#countSnapshots(sourceColumn, column)
+    }
+
+    card.dataset.dragAndDropPending = "true"
+    card.draggable = false
+    cardsList.prepend(card)
+    this.#applyCardState(card, destinationState)
+    this.#updateCounts(sourceColumn, currentState, column, destinationState)
+
+    this.#saveMove(card, destinationState, snapshot)
+  }
+
+  async #saveMove(card, destinationState, snapshot) {
+    try {
+      const response = await this.#requestMove(card, destinationState)
+      if (!response.ok) throw new Error(`Card move failed with status ${response.statusCode}`)
+    } catch (error) {
+      this.#restoreMove(card, snapshot)
+      console.error(error)
+    } finally {
+      delete card.dataset.dragAndDropPending
+      if (card.isConnected) card.draggable = true
+    }
+  }
+
+  async #requestMove(card, state) {
+    let response
+
+    if (state.status === "active") {
+      if (state.columnId) {
+        response = await post(card.dataset.dragAndDropTriageUrl, {
+          body: { column_id: state.columnId },
+          responseKind: "json"
+        })
+      } else {
+        response = await destroy(card.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+      }
+    } else if (state.status === "not_now") {
+      response = await post(card.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+    } else if (state.status === "closed") {
+      response = await post(card.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+    }
+
+    return response
+  }
+
+  #restoreMove(card, snapshot) {
+    if (snapshot.parent.isConnected) {
+      const nextSibling = snapshot.nextSibling?.parentNode === snapshot.parent ? snapshot.nextSibling : null
+      snapshot.parent.insertBefore(card, nextSibling)
+    } else if (snapshot.sourceColumn.isConnected) {
+      this.#cardsListFor(snapshot.sourceColumn)?.prepend(card)
+    }
+
+    this.#applyCardState(card, snapshot.state, snapshot.stamp)
+    this.#restoreCounts(snapshot.counts)
+  }
+
+  #applyCardState(card, state, stamp = null) {
+    card.dataset.dragAndDropStatus = state.status
+
+    if (state.columnId) {
+      card.dataset.dragAndDropColumnId = state.columnId
+    } else {
+      delete card.dataset.dragAndDropColumnId
+    }
+
+    card.classList.toggle("card--active", state.status === "active")
+    card.classList.toggle("card--postponed", state.status === "not_now")
+
+    const currentStamp = card.querySelector(".card__closed")
+    if (state.status === "active") {
+      currentStamp?.remove()
+    } else if (stamp) {
+      if (currentStamp) {
+        currentStamp.replaceWith(stamp)
+      } else {
+        card.append(stamp)
+      }
+    } else {
+      currentStamp?.remove()
+      card.append(this.#stampFor(state.status))
+    }
+
+    this.#updateColumnIndicators(card, state)
+  }
+
+  #updateColumnIndicators(card, state) {
+    let currentColumn = card.querySelector(".card__header .card__column-name--current")
+
+    if (state.status === "active" && state.columnId && state.columnName) {
+      if (!currentColumn) {
+        currentColumn = document.createElement("span")
+        currentColumn.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        const name = document.createElement("span")
+        name.className = "overflow-ellipsis"
+        currentColumn.append(name)
+        card.querySelector(".card__header")?.append(currentColumn)
+      }
+
+      currentColumn.querySelector(".overflow-ellipsis").textContent = state.columnName
+    } else {
+      currentColumn?.remove()
+    }
+
+    card.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.columnId === state.columnId)
+    })
+  }
+
+  #stampFor(status) {
+    const title = status === "closed" ? "Done" : "Not Now"
+    const stamp = document.createElement("div")
+    stamp.className = "card__closed"
+    stamp.dataset.controller = "bridge--stamp"
+    stamp.dataset.bridgeStampScopeSelectorValue = ".card-perma"
+    stamp.dataset.bridgeTitle = title
+
+    const label = document.createElement("span")
+    label.className = "card__closed-title"
+    label.dataset.text = title
+    label.textContent = title
+    stamp.append(label)
+
+    return stamp
+  }
+
+  #updateCounts(sourceColumn, sourceState, destinationColumn, destinationState) {
+    if (this.#includesCard(sourceColumn, sourceState)) this.#changeCount(sourceColumn, -1)
+    if (this.#includesCard(destinationColumn, destinationState)) this.#changeCount(destinationColumn, 1)
+  }
+
+  #countSnapshots(...columns) {
+    return [ ...new Set(columns) ].map(column => {
+      const expander = column.querySelector(".cards__expander")
+      const counter = expander?.querySelector(".cards__expander-count")
+
+      if (counter) {
+        return {
+          column,
+          text: counter.textContent,
+          cardCount: expander.style.getPropertyValue("--card-count")
+        }
+      }
+    }).filter(Boolean)
+  }
+
+  #changeCount(column, adjustment) {
+    const expander = column.querySelector(".cards__expander")
+    const counter = expander?.querySelector(".cards__expander-count")
+    if (!counter || counter.textContent.trim().endsWith("+")) return
+
+    const count = Number.parseInt(counter.textContent, 10)
+    if (Number.isNaN(count)) return
+
+    const newCount = Math.max(count + adjustment, 0)
+    counter.textContent = newCount > 99 ? "99+" : String(newCount)
+    expander.style.setProperty("--card-count", Math.min(newCount, 15))
+  }
+
+  #restoreCounts(snapshots) {
+    snapshots.forEach(({ column, text, cardCount }) => {
+      const expander = column.querySelector(".cards__expander")
+      const counter = expander?.querySelector(".cards__expander-count")
+      if (!expander || !counter) return
+
+      counter.textContent = text
+      if (cardCount) {
+        expander.style.setProperty("--card-count", cardCount)
+      } else {
+        expander.style.removeProperty("--card-count")
+      }
+    })
+  }
+
+  #includesCard(column, state) {
+    if (column.dataset.dragAndDropStatus === "active") {
+      const columnId = column.dataset.dragAndDropColumnId || null
+      return state.status === "active" && state.columnId === columnId
+    }
+
+    return column.dataset.dragAndDropStatus === state.status
+  }
+
+  #isAlreadyThere(currentState, destinationState) {
+    if (destinationState.status === "active") {
+      return currentState.status === "active" && currentState.columnId === destinationState.columnId
+    }
+
+    return currentState.status === destinationState.status
+  }
+
+  #cardState(card) {
+    const columnId = card.dataset.dragAndDropColumnId || null
+
+    return {
+      status: card.dataset.dragAndDropStatus,
+      columnId,
+      columnName: this.#columnNameFor(card, columnId)
+    }
+  }
+
+  #columnNameFor(card, columnId) {
+    if (!columnId) return null
+
+    const stage = [ ...card.querySelectorAll(".card__stages [data-column-id]") ].find(element => element.dataset.columnId === columnId)
+    return stage?.textContent.trim() || card.querySelector(".card__header .card__column-name--current")?.textContent.trim() || null
+  }
+
+  #destinationState(column, currentState) {
+    const status = column.dataset.dragAndDropStatus
+
+    if (status === "active") {
+      const columnId = column.dataset.dragAndDropColumnId || null
+      return { status, columnId, columnName: column.dataset.columnName || null }
+    } else if (status === "not_now") {
+      return { status, columnId: null, columnName: null }
+    } else if (status === "closed") {
+      return { status, columnId: currentState.columnId, columnName: currentState.columnName }
+    }
+  }
+
+  #cardsListFor(column) {
+    const cardsList = column.querySelector(".cards__list")
+    if (cardsList) return cardsList.querySelector("turbo-frame") || cardsList
+
+    const frame = column.querySelector("turbo-frame")
+    if (frame) {
+      const newCardsList = document.createElement("div")
+      newCardsList.className = "cards__list hide-scrollbar"
+      frame.append(newCardsList)
+      return newCardsList
+    }
+
+    return column.querySelector(".cards__transition-container")
+  }
+
+  #columnFor(element) {
+    if (!(element instanceof Element)) return null
+
+    const column = element.closest('[data-drag-and-drop-target~="column"]')
+    return column && this.element.contains(column) ? column : null
+  }
+
+  #setHoveredColumn(column) {
+    if (this.hoveredColumn === column) return
+
+    this.hoveredColumn?.classList.remove(this.hoverContainerClass)
+    this.hoveredColumn = column
+    this.hoveredColumn?.classList.add(this.hoverContainerClass)
+  }
+
+  #finishDrag() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#setHoveredColumn(null)
+  }
+}
