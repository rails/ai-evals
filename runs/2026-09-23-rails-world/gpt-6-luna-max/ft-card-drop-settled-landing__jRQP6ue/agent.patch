diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..ccd66c6
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,109 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "dragging a card moves it immediately without reordering columns or same-column cards" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    card_in_destination = cards(:text)
+    destination = columns(:writebook_in_progress)
+
+    visit board_url(card.board)
+
+    assert_selector '[data-controller~="drag-and-drop"]'
+
+    card_element = find("##{dom_id(card, :article)}", visible: :all)
+    assert_equal "true", card_element["draggable"]
+    original_column_order = column_order
+
+    drag_result = drag_card_to(card, destination)
+
+    assert_equal true, drag_result["columnHighlighted"]
+    assert_equal true, drag_result["cardDimmed"]
+    assert_equal true, drag_result["movedImmediately"]
+    assert_equal "true", drag_result["pending"]
+    assert_selector "##{dom_id(destination)} .cards__list ##{dom_id(card, :article)}", visible: :all
+    order_before_save_completes = card_order(destination)
+    wait_for_move(card)
+    assert_equal order_before_save_completes, card_order(destination)
+    assert_equal destination, card.reload.column
+
+    order_before_same_column_drop = card_order(destination)
+    drag_card_to(card_in_destination, destination)
+
+    assert_equal order_before_same_column_drop, card_order(destination)
+    assert_equal original_column_order, column_order
+  end
+
+  test "dragging a card to Maybe, Not Now, and Done changes its status" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    visit board_url(card.board)
+
+    drag_card_to(card, "maybe")
+    assert_selector "#maybe .cards__list ##{dom_id(card, :article)}[data-drag-and-drop-status='active']", visible: :all
+    wait_for_move(card)
+    assert_nil card.reload.column
+
+    drag_card_to(card, "not-now")
+    assert_selector "#not-now .cards__list ##{dom_id(card, :article)}[data-drag-and-drop-status='not_now']", visible: :all
+    wait_for_move(card)
+    assert_predicate card.reload, :postponed?
+
+    drag_card_to(card, "closed-cards")
+    assert_selector "#closed-cards .cards__list ##{dom_id(card, :article)}[data-drag-and-drop-status='closed']", visible: :all
+    wait_for_move(card)
+    assert_predicate card.reload, :closed?
+
+    destination = columns(:writebook_on_hold)
+    drag_card_to(card, destination)
+    assert_selector "##{dom_id(destination)} .cards__list ##{dom_id(card, :article)}[data-drag-and-drop-status='active']", visible: :all
+    wait_for_move(card)
+    assert_equal destination, card.reload.column
+    assert_predicate card, :active?
+  end
+
+  private
+    def drag_card_to(card, destination)
+      card_element = find("##{dom_id(card, :article)}", visible: :all)
+      destination_id = destination.is_a?(String) ? destination : dom_id(destination)
+      destination_element = find("##{destination_id}", visible: :all)
+
+      page.execute_script(<<~JS, card_element.native, destination_element.native)
+        const [ card, column ] = arguments
+        const dataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, dataTransfer }))
+        const dragStyles = {
+          columnHighlighted: column.classList.contains("drag-and-drop__hover-container"),
+          cardDimmed: card.classList.contains("drag-and-drop__dragged-item")
+        }
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+
+        return {
+          ...dragStyles,
+          movedImmediately: column.querySelector(".cards__list")?.contains(card),
+          pending: card.dataset.dragAndDropPending
+        }
+      JS
+    end
+
+    def wait_for_move(card)
+      assert_no_selector "##{dom_id(card, :article)}[data-drag-and-drop-pending='true']", visible: :all
+    end
+
+    def column_order
+      page.evaluate_script(<<~JS)
+        Array.from(document.querySelectorAll('[data-drag-and-drop-target~="column"]')).map(column => column.id)
+      JS
+    end
+
+    def card_order(column)
+      page.evaluate_script("Array.from(document.querySelectorAll(\"##{dom_id(column)} .cards__list .card\")).map(card => card.id)")
+    end
+end
