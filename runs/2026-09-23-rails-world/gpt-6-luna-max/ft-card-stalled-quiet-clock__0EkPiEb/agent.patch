diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..eefcb05
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,63 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLING_PERIOD_IN_SECONDS = 2.weeks.to_i
+  COMMENTS_FOR_BURST = 3
+  PEOPLE_FOR_BURST = 2
+
+  included do
+    scope :stalled, -> { where(burst_at: ..(Time.current - STALLING_PERIOD_IN_SECONDS)) }
+
+    before_update :clear_burst_after_card_activity, if: :card_activity_update?
+    before_save :clear_burst_after_description_activity, if: :description_activity?
+    before_save :clear_burst_after_attachment_activity, if: :attachment_activity?
+  end
+
+  def stalled?(at: Time.current)
+    burst_at.present? && burst_at <= at - STALLING_PERIOD_IN_SECONDS
+  end
+
+  def register_comment_burst
+    comment_counts = comments.by_user
+      .where(created_at: (Time.current - auto_postpone_period / 3)..Time.current)
+      .group(:creator_id)
+      .count
+
+    if comment_counts.size >= PEOPLE_FOR_BURST && comment_counts.values.sum >= COMMENTS_FOR_BURST
+      register_burst
+    end
+  end
+
+  def register_burst
+    update!(burst_at: Time.current)
+  end
+
+  def reset_burst
+    update_column(:burst_at, nil) if burst_at.present?
+  end
+
+  private
+    def card_activity_update?
+      (changes_to_save.keys - %w[ burst_at updated_at ]).any?
+    end
+
+    def clear_burst_after_card_activity
+      self.burst_at = nil
+    end
+
+    def description_activity?
+      association(:rich_text_description).loaded? && rich_text_description&.will_save_change_to_body?
+    end
+
+    def attachment_activity?
+      attachment_changes.any?
+    end
+
+    def clear_burst_after_description_activity
+      self.burst_at = nil
+    end
+
+    def clear_burst_after_attachment_activity
+      self.burst_at = nil
+    end
+end
diff --git a/app/models/card/watchable.rb b/app/models/card/watchable.rb
index 1723552..addc051 100644
--- a/app/models/card/watchable.rb
+++ b/app/models/card/watchable.rb
@@ -16,19 +16,32 @@ module Card::Watchable
     watches.find_by(user: user)
   end
 
-  def watch_by(user)
-    watches.where(user: user).first_or_create.update!(watching: true)
+  def watch_by(user, activity: true)
+    watch = watches.find_by(user: user)
+    was_watching = watch&.watching?
+    watch ||= watches.build(user: user)
+    watch.update! watching: true
+
+    reset_burst if activity && !was_watching
+    watch
   end
 
-  def unwatch_by(user)
-    watches.where(user: user).first_or_create.update!(watching: false)
+  def unwatch_by(user, activity: true)
+    watch = watches.find_by(user: user)
+    was_watching = watch&.watching?
+    was_new = watch.nil?
+    watch ||= watches.build(user: user)
+    watch.update! watching: false
+
+    reset_burst if activity && (was_new || was_watching)
+    watch
   end
 
   private
     def subscribe_creator
       # Avoid touching to not interfere with the abandon card detection system
       Card.no_touching do
-        watch_by creator
+        watch_by creator, activity: false
       end
     end
 end
