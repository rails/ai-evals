diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..3b0ae0d
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from one person do not make a burst, but another person does" do
+    card = new_card
+
+    3.times do |number|
+      card.comments.create!(body: "Comment #{number}", creator: users(:david))
+    end
+    assert_nil card.reload.burst_at
+
+    card.comments.create!(body: "A different person", creator: users(:kevin))
+    assert card.reload.burst_at
+  end
+
+  test "comment burst uses one third of the board auto-close period" do
+    board = boards(:writebook)
+    board.auto_postpone_period = 3.days.to_i
+    now = Time.current
+
+    outside_window = new_card
+    travel_to now - 2.days do
+      outside_window.comments.create!(body: "First", creator: users(:david))
+      outside_window.comments.create!(body: "Second", creator: users(:kevin))
+    end
+    travel_to now do
+      outside_window.comments.create!(body: "Too late", creator: users(:david))
+    end
+    assert_nil outside_window.reload.burst_at
+
+    inside_window = new_card
+    travel_to now - 1.day do
+      inside_window.comments.create!(body: "At the boundary", creator: users(:david))
+    end
+    travel_to now do
+      inside_window.comments.create!(body: "Second", creator: users(:kevin))
+      inside_window.comments.create!(body: "Third", creator: users(:david))
+    end
+    assert inside_window.reload.burst_at
+  end
+
+  test "a burst of comments becomes stalled after two weeks without activity" do
+    card = new_card
+
+    card.comments.create!(body: "First", creator: users(:david))
+    card.comments.create!(body: "Second", creator: users(:kevin))
+    card.comments.create!(body: "Third", creator: users(:david))
+    burst_at = card.reload.burst_at
+    assert burst_at
+
+    travel_to burst_at + 2.weeks - 1.second, with_usec: true do
+      assert_not card.reload.stalled?
+    end
+
+    travel_to burst_at + 2.weeks, with_usec: true do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "editing or removing a comment resets a burst" do
+    card = new_card
+    comment = card.comments.create!(body: "A comment", creator: users(:david))
+
+    card.register_burst
+    comment.update!(body: "An edited comment")
+    assert_nil card.reload.burst_at
+
+    card.register_burst
+    comment.destroy!
+    assert_nil card.reload.burst_at
+  end
+
+  test "assignment and reopening cause a burst" do
+    card = new_card
+    card.toggle_assignment(users(:kevin))
+    assert card.reload.burst_at
+
+    card.toggle_assignment(users(:kevin))
+    assert_nil card.reload.burst_at
+
+    card.toggle_assignment(users(:kevin))
+    assert card.reload.burst_at
+
+    card.close
+    assert_nil card.reload.burst_at
+
+    card.reopen
+    assert card.reload.burst_at
+  end
+
+  test "any follow-up activity resets the pending stalled period" do
+    card = new_card
+    card.register_burst
+    assert card.reload.burst_at
+
+    card.steps.create!(content: "A follow-up step")
+    assert_nil card.reload.burst_at
+
+    card.register_burst
+    card.comments.create!(body: "A follow-up comment", creator: users(:kevin))
+    assert_nil card.reload.burst_at
+
+    card.register_burst
+    card.update!(due_on: Date.tomorrow)
+    assert_nil card.reload.burst_at
+
+    card.register_burst
+    card.update!(description: "An updated description")
+    assert_nil card.reload.burst_at
+
+    card.register_burst
+    card.pin_by(users(:kevin))
+    assert_nil card.reload.burst_at
+
+    card.register_burst
+    card.unpin_by(users(:kevin))
+    assert_nil card.reload.burst_at
+
+    travel 3.weeks
+    assert_not card.reload.stalled?
+  end
+
+  private
+    def new_card
+      boards(:writebook).cards.create!(title: "Busy card", creator: users(:david), status: :published)
+    end
+end
