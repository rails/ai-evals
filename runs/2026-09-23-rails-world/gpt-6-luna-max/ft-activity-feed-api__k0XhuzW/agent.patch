@@ -0,0 +1,16 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat, paginated array of the activity visible to the authenticated user, newest first. The endpoint follows the API's standard pagination conventions (`Link` and `X-Total-Count` headers).
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by activity creator ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+Activity is limited to boards the authenticated user can access. Card title changes are included; deprecated `card_collection_changed` events are not.
+
+Each activity includes `id`, `action`, `created_at`, a plain-text `description`, `particulars`, `url`, `eventable_type`, `eventable`, `board`, and `creator`. The `eventable`, `board`, and `creator` use their existing API representations. Card activity URLs open the card; comment activity URLs open the card and anchor to the comment.
+
+`particulars` contains `assignee_ids` for assignment changes, `old_board` and `new_board` for board changes, `old_title` and `new_title` for title changes, and `column` for triage events. Other events return an empty object. Missing board, title, or column values are empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..17f8ec1
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns a flat array of newest activity with the API fields" do
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+    assert_not_empty activities
+
+    expected_keys = %w[
+      id action created_at description particulars url eventable_type eventable board creator
+    ]
+    activities.each do |activity|
+      assert_equal expected_keys.sort, activity.keys.sort
+    end
+
+    timestamps = activities.map { |activity| Time.iso8601(activity["created_at"]) }
+    assert_equal timestamps.sort.reverse, timestamps
+    assert_equal activities.size.to_s, @response.headers["X-Total-Count"]
+  end
+
+  test "serializes the existing eventable, board, and creator representations" do
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    assignment = activities.find { |activity| activity["id"] == events(:logo_assignment_jz).id }
+    assert_equal [ users(:jz).id ], assignment.dig("particulars", "assignee_ids")
+    assert_equal "Card", assignment["eventable_type"]
+    assert_equal cards(:logo).id, assignment.dig("eventable", "id")
+    assert_equal boards(:writebook).id, assignment.dig("board", "id")
+    assert_equal users(:david).id, assignment.dig("creator", "id")
+    assert_includes assignment["url"], "/cards/#{cards(:logo).number}"
+    assert_not_includes assignment["url"], "#"
+
+    comment_event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+    comment_activity = activities.find { |activity| activity["id"] == comment_event.id }
+    assert_equal "Comment", comment_activity["eventable_type"]
+    assert_equal comment.id, comment_activity.dig("eventable", "id")
+    assert_equal comment.card.id, comment_activity.dig("eventable", "card", "id")
+    assert_equal comment_event.description_for(users(:kevin)).to_plain_text, comment_activity["description"]
+    assert_includes comment_activity["url"], "#comment_#{comment.id}"
+    assert_includes comment_activity["url"], "/cards/#{comment.card.number}"
+  end
+
+  test "includes card title changes and excludes deprecated collection changes" do
+    board_change = create_activity(
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Old board", new_board: "New board" } }
+    )
+    title_change = create_activity(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+    )
+    triage = create_activity(
+      action: "card_triaged",
+      particulars: { particulars: { column: "In progress" } }
+    )
+    sent_back_to_triage = create_activity(action: "card_sent_back_to_triage")
+    ordinary_event = create_activity(action: "card_closed")
+    missing_board_change = create_activity(action: "card_board_changed", particulars: nil)
+    missing_title_change = create_activity(action: "card_title_changed", particulars: nil)
+    collection_change = create_activity(action: "card_collection_changed")
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_includes activities, title_change.id
+    assert_not_includes activities, collection_change.id
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activities.dig(board_change.id, "particulars"))
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activities.dig(title_change.id, "particulars"))
+    assert_equal({ "column" => "In progress" }, activities.dig(triage.id, "particulars"))
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.dig(missing_board_change.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.dig(missing_title_change.id, "particulars"))
+    assert_equal({ "column" => "" }, activities.dig(sent_back_to_triage.id, "particulars"))
+    assert_equal({}, activities.dig(ordinary_event.id, "particulars"))
+  end
+
+  test "filters activity by creator and board IDs" do
+    matching_event = create_activity(action: "card_published", creator: users(:david), board: boards(:writebook))
+    other_creator_event = create_activity(action: "card_published", creator: users(:kevin), board: boards(:writebook))
+    other_board_event = create_activity(action: "card_published", creator: users(:david), board: boards(:private))
+
+    get activities_path(
+      format: :json,
+      creator_ids: [ users(:david).id ],
+      board_ids: [ boards(:writebook).id ]
+    ), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_includes activities.map { |activity| activity["id"] }, matching_event.id
+    assert activities.all? { |activity| activity["creator"]["id"] == users(:david).id }
+    assert activities.all? { |activity| activity["board"]["id"] == boards(:writebook).id }
+    assert_not_includes activities.map { |activity| activity["id"] }, other_creator_event.id
+    assert_not_includes activities.map { |activity| activity["id"] }, other_board_event.id
+  end
+
+  test "only returns activity from boards the current user can access" do
+    private_activity = create_activity(action: "card_published", board: boards(:private))
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |activity| activity["id"] }, private_activity.id
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "paginates newest activity using the standard API headers" do
+    20.times do |index|
+      create_activity(
+        action: "comment_created",
+        eventable: comments(:logo_agreement_kevin),
+        created_at: 1.hour.ago + index.minutes
+      )
+    end
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    first_page = @response.parsed_body
+    assert_equal 15, first_page.size
+    assert_operator @response.headers["X-Total-Count"].to_i, :>, first_page.size
+
+    next_page = next_page_from_link_header(@response.headers["Link"])
+    assert next_page.present?, "Expected a next-page Link header"
+
+    get next_page, as: :json
+
+    assert_response :success
+    second_page = @response.parsed_body
+    assert_operator Time.iso8601(first_page.last["created_at"]), :>=, Time.iso8601(second_page.first["created_at"])
+  end
+
+  private
+    def create_activity(action:, eventable: cards(:logo), board: boards(:writebook), creator: users(:kevin), particulars: {}, created_at: Time.current)
+      Event.create!(
+        action: action,
+        eventable: eventable,
+        board: board,
+        creator: creator,
+        particulars: particulars,
+        created_at: created_at
+      )
+    end
+
+    def next_page_from_link_header(link_header)
+      link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+    end
+end
