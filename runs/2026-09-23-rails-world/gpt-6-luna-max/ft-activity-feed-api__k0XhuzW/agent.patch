+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      accessible_boards = Current.user.boards
+      accessible_boards = accessible_boards.where(id: params[:board_ids]) if params[:board_ids].present?
+
+      events = Event.preloaded
+        .where(account: Current.account, board_id: accessible_boards.select(:id), action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events
+    end
+end
diff --git a/app/views/activities/_event.json.jbuilder b/app/views/activities/_event.json.jbuilder
new file mode 100644
index 0000000..60faadd
--- /dev/null
+++ b/app/views/activities/_event.json.jbuilder
@@ -0,0 +1,37 @@
+json.(event, :id)
+json.action event.action.to_s
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text
+
+particulars = case event.action
+when "card_assigned", "card_unassigned"
+  { assignee_ids: Array(event.assignee_ids) }
+when "card_board_changed"
+  {
+    old_board: event.particulars&.dig("particulars", "old_board").presence || "",
+    new_board: event.particulars&.dig("particulars", "new_board").presence || ""
+  }
+when "card_title_changed"
+  {
+    old_title: event.particulars&.dig("particulars", "old_title").presence || "",
+    new_title: event.particulars&.dig("particulars", "new_title").presence || ""
+  }
+when "card_triaged", "card_sent_back_to_triage"
+  { column: event.particulars&.dig("particulars", "column").presence || "" }
+else
+  {}
+end
+json.particulars particulars
+
+json.url polymorphic_url(event.eventable)
+json.eventable_type event.eventable_type
+json.eventable do
+  case event.eventable
+  when Card
+    json.partial! "cards/card", card: event.eventable
+  when Comment
+    json.partial! "cards/comments/comment", comment: event.eventable
+  end
+end
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
