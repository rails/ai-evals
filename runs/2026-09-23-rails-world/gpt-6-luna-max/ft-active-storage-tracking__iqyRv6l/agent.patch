diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..6e51c80
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,103 @@
+module StorageUsage
+  RICH_TEXT_NAMES = {
+    "Board" => "public_description",
+    "Card" => "description",
+    "Comment" => "body"
+  }.freeze
+
+  def self.calculate(record)
+    if record.is_a?(Account)
+      calculate_for_account(record.id)
+    else
+      calculate_for_board(record)
+    end
+  end
+
+  def self.attachment_context(attachment)
+    account_id = attachment.account_id
+
+    if attachment.record_type == Card.polymorphic_name && attachment.name == "image"
+      board_id = Card.where(id: attachment.record_id, account_id: account_id).pick(:board_id)
+      { account_id: account_id, board_id: board_id }
+    elsif attachment.record_type == ActionText::RichText.polymorphic_name && attachment.name == "embeds"
+      rich_text = ActionText::RichText.where(id: attachment.record_id, account_id: account_id).pick(:record_type, :record_id, :name)
+      return unless rich_text && RICH_TEXT_NAMES[rich_text[0]] == rich_text[2]
+
+      board_id = board_id_for_rich_text(rich_text[0], rich_text[1], account_id)
+      { account_id: account_id, board_id: board_id }
+    end
+  end
+
+  def self.calculate_for_account(account_id)
+    cards = Card.where(account_id: account_id)
+    boards = Board.where(account_id: account_id)
+    comments = Comment.where(account_id: account_id, card_id: cards.select(:id))
+
+    card_image_bytes(account_id, cards) + embedded_file_bytes(account_id, boards, cards, comments)
+  end
+
+  def self.calculate_for_board(board)
+    cards = Card.where(account_id: board.account_id, board_id: board.id)
+    boards = Board.where(account_id: board.account_id, id: board.id)
+    comments = Comment.where(account_id: board.account_id, card_id: cards.select(:id))
+
+    card_image_bytes(board.account_id, cards) + embedded_file_bytes(board.account_id, boards, cards, comments)
+  end
+
+  def self.card_image_bytes(account_id, cards)
+    ActiveStorage::Attachment
+      .joins(:blob)
+      .where(
+        account_id: account_id,
+        record_type: Card.polymorphic_name,
+        name: "image",
+        record_id: cards.select(:id)
+      )
+      .sum("active_storage_blobs.byte_size")
+  end
+
+  def self.embedded_file_bytes(account_id, boards, cards, comments)
+    texts = ActionText::RichText.where(account_id: account_id)
+
+    board_texts = texts.where(
+      record_type: Board.polymorphic_name,
+      name: "public_description",
+      record_id: boards.select(:id)
+    )
+    card_texts = texts.where(
+      record_type: Card.polymorphic_name,
+      name: "description",
+      record_id: cards.select(:id)
+    )
+    comment_texts = texts.where(
+      record_type: Comment.polymorphic_name,
+      name: "body",
+      record_id: comments.select(:id)
+    )
+    counted_texts = board_texts.or(card_texts).or(comment_texts)
+
+    ActiveStorage::Attachment
+      .joins(:blob)
+      .where(
+        account_id: account_id,
+        record_type: ActionText::RichText.polymorphic_name,
+        name: "embeds",
+        record_id: counted_texts.select(:id)
+      )
+      .sum("active_storage_blobs.byte_size")
+  end
+
+  def self.board_id_for_rich_text(record_type, record_id, account_id)
+    case record_type
+    when Board.polymorphic_name
+      Board.where(id: record_id, account_id: account_id).pick(:id)
+    when Card.polymorphic_name
+      Card.where(id: record_id, account_id: account_id).pick(:board_id)
+    when Comment.polymorphic_name
+      Comment.joins(:card)
+        .where(comments: { id: record_id, account_id: account_id }, cards: { account_id: account_id })
+        .pick("cards.board_id")
+    end
+  end
+  private_class_method :board_id_for_rich_text
+end
diff --git a/app/models/storage_usage/attachment.rb b/app/models/storage_usage/attachment.rb
new file mode 100644
index 0000000..7e0dc65
--- /dev/null
+++ b/app/models/storage_usage/attachment.rb
@@ -0,0 +1,52 @@
+module StorageUsage::Attachment
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_usage_context
+    before_update :remember_storage_usage_context
+    after_create_commit :recalculate_storage_usage_after_create
+    after_update_commit :recalculate_storage_usage_after_update
+    after_destroy_commit :recalculate_storage_usage_after_destroy
+  end
+
+  def delete
+    remember_storage_usage_context
+    super.tap do
+      ActiveRecord.after_all_transactions_commit { recalculate_storage_usage_later }
+    end
+  end
+
+  private
+    def recalculate_storage_usage_after_create
+      recalculate_storage_usage_later
+    end
+
+    def recalculate_storage_usage_after_update
+      recalculate_storage_usage_later
+    end
+
+    def recalculate_storage_usage_after_destroy
+      recalculate_storage_usage_later
+    end
+
+    def remember_storage_usage_context
+      @storage_usage_contexts ||= []
+      @storage_usage_contexts << StorageUsage.attachment_context(self)
+    end
+
+    def recalculate_storage_usage_later
+      contexts = (@storage_usage_contexts || []) + [ StorageUsage.attachment_context(self) ]
+
+      contexts.compact.uniq.each do |context|
+        board = Board.find_by(id: context[:board_id], account_id: context[:account_id]) if context[:board_id]
+
+        if board
+          board.recalculate_bytes_used_later
+        else
+          Account.find_by(id: context[:account_id])&.recalculate_bytes_used_later
+        end
+      end
+    ensure
+      @storage_usage_contexts = nil
+    end
+end
diff --git a/app/models/storage_usage/trackable.rb b/app/models/storage_usage/trackable.rb
new file mode 100644
index 0000000..dfc82eb
--- /dev/null
+++ b/app/models/storage_usage/trackable.rb
@@ -0,0 +1,79 @@
+module StorageUsage::Trackable
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    if persisted?
+      usage, calculated_at = self.class.where(id: id).pick(:bytes_used, :bytes_used_calculated_at)
+      ensure_bytes_used_calculation_later if usage && calculated_at.nil?
+      usage || 0
+    else
+      self[:bytes_used] || 0
+    end
+  end
+
+  def recalculate_bytes_used_later
+    if has_changes_to_save?
+      self.class.find_by(id: id)&.recalculate_bytes_used_later || false
+    else
+      enqueue = false
+
+      with_lock do
+        update_column(:bytes_used_calculation_version, bytes_used_calculation_version + 1)
+
+        unless bytes_used_recalculation_pending?
+          update_column(:bytes_used_recalculation_pending, true)
+          StorageUsage::RecalculateJob.perform_later(self)
+          enqueue = true
+        end
+      end
+
+      enqueue
+    end
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  def recalculate_bytes_used_now
+    version = with_lock { bytes_used_calculation_version }
+    usage = StorageUsage.calculate(self)
+
+    with_lock do
+      if bytes_used_calculation_version == version
+        update_columns(
+          bytes_used: usage,
+          bytes_used_calculated_at: Time.current,
+          bytes_used_recalculation_pending: false
+        )
+      else
+        StorageUsage::RecalculateJob.perform_later(self)
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  rescue StandardError
+    self.class.where(id: id).update_all(bytes_used_calculation_pending: false, bytes_used_calculated_at: nil)
+    raise
+  end
+
+  private
+    def ensure_bytes_used_calculation_later
+      if has_changes_to_save?
+        self.class.find_by(id: id)&.send(:ensure_bytes_used_calculation_later)
+      else
+        enqueue = false
+
+        with_lock do
+          if bytes_used_calculated_at.nil? && !bytes_used_recalculation_pending?
+            update_column(:bytes_used_calculation_version, bytes_used_calculation_version + 1)
+            update_column(:bytes_used_recalculation_pending, true)
+            StorageUsage::RecalculateJob.perform_later(self)
+            enqueue = true
+          end
+        end
+
+        enqueue
+      end
+    rescue ActiveRecord::RecordNotFound
+      false
+    end
+end
