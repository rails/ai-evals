diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..8f25e73
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "board and account totals count only card images and rich text embeds" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    attach_image(card, create_blob(2))
+    attach_embed(board, :public_description, create_blob(3))
+    attach_embed(card, :description, create_blob(5))
+
+    comment = card.comments.create!(body: "A comment")
+    attach_embed(comment, :body, create_blob(7))
+
+    other_board = boards(:private)
+    other_card = other_board.cards.create!(creator: users(:kevin))
+    attach_image(other_card, create_blob(11))
+
+    Current.with_account(accounts("initech")) do
+      attach_image(cards(:radio), create_blob(13))
+    end
+
+    create_attachment(users(:david), "avatar", create_blob(17))
+
+    perform_storage_usage_jobs
+
+    assert_equal 17, board.bytes_used
+    assert_equal 11, other_board.bytes_used
+    assert_equal 28, account.bytes_used
+    assert_equal 13, accounts("initech").bytes_used
+  end
+
+  test "large embed collections are summed in the background" do
+    comment = cards(:logo).comments.create!(body: "Many files")
+    rich_text = comment.body
+    rich_text.body = "Description"
+    comment.save!
+    blobs = 100.times.map { |index| create_blob(index + 1) }
+
+    blobs.each { |blob| create_attachment(rich_text, "embeds", blob) }
+    perform_storage_usage_jobs
+
+    assert_equal blobs.sum(&:byte_size), boards(:writebook).bytes_used
+    assert_equal blobs.sum(&:byte_size), accounts("37s").bytes_used
+  end
+
+  test "image removal and card board changes refresh the affected boards" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+
+    attach_image(card, create_blob(19))
+    perform_storage_usage_jobs
+
+    assert_equal 19, old_board.bytes_used
+    assert_equal 0, new_board.bytes_used
+
+    card.update!(board: new_board)
+    perform_storage_usage_jobs
+
+    assert_equal 0, old_board.bytes_used
+    assert_equal 19, new_board.bytes_used
+    assert_equal 19, card.account.bytes_used
+
+    card.image.purge_later
+    perform_storage_usage_jobs
+
+    assert_not card.reload.image.attached?
+    assert_equal 0, new_board.bytes_used
+    assert_equal 0, card.account.bytes_used
+  end
+
+  test "bytes_used schedules its initial calculation without doing it inline" do
+    board = boards(:writebook)
+    board.name = "Unsaved board change"
+
+    assert_enqueued_with job: StorageUsage::RecalculateJob, args: [ board ] do
+      assert_equal 0, board.bytes_used
+    end
+  end
+
+  test "a change during a calculation triggers a fresh calculation" do
+    board = boards(:writebook)
+    board.update_columns(bytes_used_calculation_version: 0, bytes_used_recalculation_pending: true)
+
+    calculate = StorageUsage.method(:calculate)
+    StorageUsage.define_singleton_method(:calculate) do |record|
+      record.recalculate_bytes_used_later
+      42
+    end
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+      board.recalculate_bytes_used_now
+    end
+
+    assert_equal 0, board.reload.bytes_used
+    assert_predicate board, :bytes_used_recalculation_pending?
+  ensure
+    StorageUsage.define_singleton_method(:calculate, calculate)
+  end
+
+  test "duplicate refresh requests for a board are coalesced" do
+    board = boards(:writebook)
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculateJob do
+      3.times { board.recalculate_bytes_used_later }
+    end
+  end
+
+  private
+    def perform_storage_usage_jobs
+      3.times { perform_enqueued_jobs only: StorageUsage::RecalculateJob }
+    end
+
+    def create_blob(byte_size)
+      content = "x" * byte_size
+
+      ActiveStorage::Blob.create_before_direct_upload!(
+        filename: "file-#{SecureRandom.hex}.bin",
+        byte_size: byte_size,
+        checksum: Base64.strict_encode64(Digest::MD5.digest(content)),
+        content_type: "application/octet-stream"
+      )
+    end
+
+    def attach_image(card, blob)
+      create_attachment(card, "image", blob)
+    end
+
+    def attach_embed(record, attribute, blob)
+      rich_text = record.public_send(attribute)
+      rich_text.body = "Description"
+      record.save!
+      create_attachment(rich_text, "embeds", blob)
+    end
+
+    def create_attachment(record, name, blob)
+      ActiveStorage::Attachment.create!(record: record, name: name, blob: blob)
+    end
+end
