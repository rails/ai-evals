--- /dev/null
+++ b/app/jobs/storage_usage/recalculate_job.rb
@@ -0,0 +1,10 @@
+class StorageUsage::RecalculateJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(record)
+    record.recalculate_bytes_used_now
+    Account.find_by(id: record.account_id)&.recalculate_bytes_used_later if record.is_a?(Board)
+  end
+end
