diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..8c34bdc
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admin can publish a board and retrieve its public URL" do
+    board = boards(:writebook)
+    assert_nil board.public_key
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert board.reload.published?
+    assert_equal public_board_url(board.public_key, script_name: nil), response.parsed_body["public_url"]
+  end
+
+  test "admin can publish and unpublish a board from HTML requests" do
+  board = boards(:writebook)
+
+  post board_publication_path(board)
+  assert_redirected_to board_path(board)
+  assert board.reload.published?
+
+  delete board_publication_path(board)
+  assert_redirected_to board_path(board)
+  assert_nil board.reload.public_key
+end
+
+test "publishing an already published board preserves its key" do
+    board = boards(:writebook)
+    board.publish
+    public_key = board.public_key
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert_equal public_key, board.reload.public_key
+  end
+
+  test "admin can publish a board they do not have board access to" do
+    board = boards(:private)
+    board.accesses.destroy_all
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert board.reload.published?
+  end
+
+  test "a non-admin cannot publish a board even if they created it" do
+    logout_and_sign_in_as :david
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_nil board.reload.public_key
+  end
+
+  test "admin can unpublish a board and revoke its public URL" do
+    board = boards(:writebook)
+    board.publish
+    old_key = board.public_key
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :no_content
+    assert_nil board.reload.public_key
+    get public_board_path(old_key, script_name: nil)
+    assert_response :not_found
+  end
+
+  test "a non-admin cannot unpublish a board" do
+    board = boards(:writebook)
+    board.publish
+    public_key = board.public_key
+    logout_and_sign_in_as :david
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_equal public_key, board.reload.public_key
+  end
+end
