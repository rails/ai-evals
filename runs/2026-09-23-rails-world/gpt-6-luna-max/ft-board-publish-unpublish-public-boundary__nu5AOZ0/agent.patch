new file mode 100644
index 0000000..a3365e7
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,23 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  def published?
+    public_key.present?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+
+  def publish
+    with_lock do
+      update!(public_key: SecureRandom.urlsafe_base64(32)) unless published?
+    end
+  end
+
+  def unpublish
+    with_lock do
+      update!(public_key: nil) if published?
+    end
+  end
+end
