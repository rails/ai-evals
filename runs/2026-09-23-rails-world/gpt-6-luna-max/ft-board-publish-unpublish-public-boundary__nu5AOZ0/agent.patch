@@ -0,0 +1,50 @@
+require "test_helper"
+
+class PublicBoardsCardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @public_key = @board.public_key
+    sign_out
+  end
+
+  test "anyone can open a published card on a public board" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@public_key, card.number)
+    end
+
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+
+  test "public card is available as JSON" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@public_key, card.number, format: :json), as: :json
+    end
+
+    assert_response :success
+    assert_equal card.title, response.parsed_body["title"]
+    assert_includes response.parsed_body["url"], "/public/boards/#{@public_key}/cards/#{card.number}"
+  end
+
+  test "draft and other-board cards are not exposed" do
+    drafted_card = @board.cards.create!(creator: users(:kevin), title: "Draft", status: :drafted)
+
+    untenanted do
+      get public_board_card_path(@public_key, drafted_card.number)
+    end
+    assert_response :not_found
+
+    other_board_card = Current.set(account: accounts("37s"), user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Private", status: :published)
+    end
+    untenanted do
+      get public_board_card_path(@public_key, other_board_card.number)
+    end
+    assert_response :not_found
+  end
+end
