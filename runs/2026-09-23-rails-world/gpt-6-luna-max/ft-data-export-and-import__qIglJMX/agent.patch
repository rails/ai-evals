+require "test_helper"
+
+class Account::DataTransfer::ExportImportTest < ActiveSupport::TestCase
+  test "account export and import restores records, people, comments, and files in a new account" do
+    source_account = accounts("37s")
+    source_user = users(:kevin)
+    card = cards(:logo)
+    image_data = File.binread(Rails.root.join("test/fixtures/files/moon.jpg"))
+    card.image.attach(io: StringIO.new(image_data), filename: "moon.jpg", content_type: "image/jpeg")
+    published_board = boards(:writebook)
+    Current.with_account(source_account) { published_board.publish }
+    source_publication_key = published_board.publication.key
+
+    export = Export.create!(account: source_account, user: source_user, kind: :account)
+    Current.with_account(source_account) { export.generate }
+
+    assert export.completed?
+    assert export.file.attached?
+
+    import = Account::Import.new(account: accounts(:initech), user: users(:mike))
+    Current.with_account(import.account) do
+      import.file.attach(
+        io: StringIO.new(export.file.download),
+        filename: "fizzy-account-export.zip",
+        content_type: "application/zip"
+      )
+      import.save!
+    end
+
+    imported_account = nil
+    Current.with_account(import.account) do
+      imported_account = import.process
+    end
+
+    assert import.reload.completed?
+    assert_equal source_account.name, imported_account.name
+    assert_not_equal source_account.id, imported_account.id
+    assert_equal source_account.boards.count, imported_account.boards.count
+    imported_board = imported_account.boards.find_by!(name: published_board.name)
+    assert imported_board.published?
+    assert_not_equal source_publication_key, imported_board.publication.key
+    assert_equal source_account.cards.count, imported_account.cards.count
+    assert_equal Comment.where(account_id: source_account.id).count, Comment.where(account_id: imported_account.id).count
+
+    source_filter = Filter.find_by!(account_id: source_account.id, creator: users(:david))
+    imported_david = imported_account.users.find_by!(identity: users(:david).identity)
+    imported_filter = Filter.find_by!(account_id: imported_account.id, creator: imported_david)
+    assert_equal source_filter.tags.map(&:title), imported_filter.tags.map(&:title)
+    assert_equal source_filter.assignees.map { |assignee| assignee.identity.email_address },
+      imported_filter.assignees.map { |assignee| assignee.identity.email_address }
+
+    imported_owner = imported_account.users.find_by!(identity: users(:mike).identity)
+    assert imported_owner.owner?
+    assert imported_owner.active?
+    assert_equal imported_account.boards.count, imported_owner.boards.count
+
+    imported_card = imported_account.cards.find_by!(number: card.number)
+    assert_not_equal card.id, imported_card.id
+    assert_equal card.title, imported_card.title
+    assert_equal card.comments.count, imported_card.comments.count
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+    assert_equal image_data, imported_card.image.download
+    assert_equal image_data.bytesize, imported_account.bytes_used_exact
+    assert Search::Record.where(account_id: imported_account.id, searchable_type: "Card", searchable_id: imported_card.id).exists?
+    assert_not_equal card.image.blob.id, imported_card.image.blob.id
+    assert_not_equal card.image.blob.key, imported_card.image.blob.key
+  end
+
+  test "card export includes only visible cards with nested comments and attachments" do
+    user = users(:david)
+    card = cards(:logo)
+    inaccessible_card = Current.with(user: users(:kevin), account: user.account) do
+      Card.create!(account: user.account, board: boards(:private), creator: users(:kevin), title: "Private card", status: "published")
+    end
+    image_data = File.binread(Rails.root.join("test/fixtures/files/moon.jpg"))
+    card.image.attach(io: StringIO.new(image_data), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: user.account, user: user, kind: :cards)
+    Current.with_account(user.account) { export.generate }
+
+    archive = read_zip(export.file.blob)
+    cards_json = JSON.parse(archive.fetch("cards.json"))
+    exported_ids = cards_json.fetch("cards").map { |exported_card| exported_card.fetch("id") }
+
+    assert_equal user.accessible_cards.ids.sort, exported_ids.sort
+    assert_not_includes exported_ids, inaccessible_card.id
+    exported_card = cards_json.fetch("cards").find { |item| item["id"] == card.id }
+    assert_equal card.comments.count, exported_card.fetch("comments").size
+    assert_equal "moon.jpg", exported_card.fetch("attachments").first.fetch("filename")
+    assert_equal "files/#{card.image.blob.id}", exported_card.fetch("attachments").first.fetch("path")
+    assert_equal image_data, archive.fetch("files/#{card.image.blob.id}")
+  end
+
+  test "corrupt file rolls back the account and removes any destination blob" do
+    source_account = accounts("37s")
+    image_data = File.binread(Rails.root.join("test/fixtures/files/moon.jpg"))
+    cards(:logo).image.attach(io: StringIO.new(image_data), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: source_account, user: users(:kevin), kind: :account)
+    Current.with_account(source_account) { export.generate }
+
+    archive_file = Tempfile.new([ "broken-account", ".zip" ])
+    archive_file.binmode
+    export.file.blob.download { |chunk| archive_file.write(chunk) }
+    archive_file.flush
+    archive_file.rewind
+
+    entry = ZipKit::FileReader.read_zip_structure(io: archive_file).find do |zip_entry|
+      zip_entry.filename == "files/#{cards(:logo).image.blob.id}"
+    end
+    refute_nil entry
+    archive_file.seek(entry.compressed_data_offset)
+    first_byte = archive_file.read(1).getbyte(0)
+    archive_file.seek(entry.compressed_data_offset)
+    archive_file.write((first_byte ^ 0xff).chr)
+    archive_file.rewind
+
+    destination = accounts(:initech)
+    initial_account_count = Account.count
+    initial_blob_count = ActiveStorage::Blob.where(account_id: destination.id).count
+    import = Account::Import.new(account: destination, user: users(:mike))
+    Current.with_account(destination) do
+      import.file.attach(io: archive_file, filename: "broken-account.zip", content_type: "application/zip")
+      import.save!
+    end
+
+    assert_no_difference "Account.count" do
+      Current.with_account(destination) { Account::ImportJob.perform_now(import) }
+    end
+
+    assert_equal initial_account_count, Account.count
+    assert_equal initial_blob_count, ActiveStorage::Blob.where(account_id: destination.id).count
+    assert import.reload.failed?
+    assert_match(/corrupt|checksum|incomplete/i, import.error)
+    assert_not import.file.attached?
+  ensure
+    archive_file&.close!
+  end
+
+  test "failed import leaves no account behind and removes the uploaded archive" do
+    import = Account::Import.new(account: accounts(:initech), user: users(:mike))
+    Current.with_account(import.account) do
+      import.file.attach(
+        io: StringIO.new("not a zip file"),
+        filename: "broken.zip",
+        content_type: "application/zip"
+      )
+      import.save!
+    end
+
+    assert_no_difference "Account.count" do
+      Current.with_account(import.account) { Account::ImportJob.perform_now(import) }
+    end
+
+    assert import.reload.failed?
+    assert_match(/valid Fizzy account export/i, import.error)
+    assert_not import.file.attached?
+  end
+
+  private
+    def read_zip(blob)
+      tempfile = Tempfile.new([ "fizzy-export", ".zip" ])
+      tempfile.binmode
+      blob.download { |chunk| tempfile.write(chunk) }
+      tempfile.close
+
+      Zip::File.open(tempfile.path) do |zip|
+        zip.entries.to_h { |entry| [ entry.name, entry.get_input_stream.read ] }
+      end
+    ensure
+      tempfile&.unlink
+    end
+end
