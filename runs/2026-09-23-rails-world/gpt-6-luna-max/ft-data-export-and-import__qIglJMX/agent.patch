+class Account::Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :imported_account, class_name: "Account", optional: true
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %i[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  validates :status, presence: true
+  validate :file_must_be_attached, on: :create
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process
+    return imported_account if completed?
+
+    update!(status: :processing, error: nil)
+    Account::DataTransfer::Importer.new(self).import
+  end
+
+  def fail!(reason)
+    update!(status: :failed, error: reason.to_s.truncate(2_000))
+  end
+
+  private
+    def file_must_be_attached
+      errors.add(:file, "must be attached") unless file.attached?
+    end
+end
