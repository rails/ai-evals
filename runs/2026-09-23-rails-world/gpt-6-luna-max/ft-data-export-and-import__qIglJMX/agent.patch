+class Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %i[ account cards ].index_by(&:itself), scopes: false
+  enum :status, %i[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  validates :kind, :status, presence: true
+
+  def generate_later
+    ExportJob.perform_later(self)
+  end
+
+  def generate
+    update!(status: :processing, error: nil)
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account?
+        Account::DataTransfer::Exporter.new(account).export_to(zip)
+      else
+        Account::DataTransfer::CardArchive.new(user).export_to(zip)
+      end
+    end
+
+    update!(status: :completed)
+  rescue StandardError
+    file.purge if file.attached?
+    raise
+  end
+
+  def download_token
+    signed_id(purpose: :export_download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+
+  def filename
+    if account?
+      "#{account.name.parameterize.presence || "account"}-export.zip"
+    else
+      "cards-export.zip"
+    end
+  end
+end
