+    @table_name
+  end
+
+  def each_record(&block)
+    records.each(&block)
+  end
+
+  private
+    def model_for(table_name)
+      Class.new(ApplicationRecord).tap do |model|
+        model.table_name = table_name
+        model.primary_key = nil
+      end
+    end
+
+    def records
+      model.where(filter_id: Filter.where(account_id: account.id).select(:id))
+    end
+end
