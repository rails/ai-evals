diff --git a/test/controllers/accounts/data_transfers_controller_test.rb b/test/controllers/accounts/data_transfers_controller_test.rb
new file mode 100644
index 0000000..7d8695f
--- /dev/null
+++ b/test/controllers/accounts/data_transfers_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class AccountDataTransfersControllerTest < ActionDispatch::IntegrationTest
+  test "account export can only be requested by an admin" do
+    sign_in_as :kevin
+
+    assert_difference "Export.count" do
+      assert_enqueued_with(job: ExportJob) do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.kind
+  end
+
+  test "a non-admin cannot request an account export" do
+    sign_in_as :david
+
+    assert_no_difference "Export.count" do
+      post account_exports_path
+    end
+    assert_response :forbidden
+  end
+
+  test "a signed-in member can request an export of their visible cards" do
+    sign_in_as :david
+
+    assert_difference "Export.count" do
+      assert_enqueued_with(job: ExportJob) do
+        post cards_export_path
+      end
+    end
+
+    assert_redirected_to user_path(users(:david))
+    assert_equal "cards", Export.last.kind
+    assert_equal users(:david), Export.last.user
+  end
+
+  test "any account member can open the import form" do
+    sign_in_as :david
+
+    get new_account_import_path
+
+    assert_response :success
+    assert_select "input[type=file][name='account_import[file]']"
+  end
+
+  test "a ready export link works without signing in and expires after a day" do
+    sign_in_as :kevin
+    account = accounts("37s")
+    export = Export.create!(account: account, user: users(:kevin), kind: :cards)
+    Current.with_account(account) { export.generate }
+    download_token = export.download_token
+
+    sign_out
+    untenanted do
+      get export_path(download_token)
+      assert_response :redirect
+      assert_includes response.location, "/rails/active_storage/"
+      service_url = response.location
+      get service_url
+      assert_response :success
+
+      travel_to 2.hours.from_now do
+        get service_url
+        assert_response :not_found
+      end
+
+      travel_to 2.days.from_now do
+        get export_path(download_token)
+        assert_response :not_found
+      end
+    end
+  end
+end
diff --git a/test/mailers/data_transfer_mailer_test.rb b/test/mailers/data_transfer_mailer_test.rb
new file mode 100644
index 0000000..2e8e3be
--- /dev/null
+++ b/test/mailers/data_transfer_mailer_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class DataTransferMailerTest < ActionMailer::TestCase
+  test "export ready email links to a one-day download" do
+    export = Export.create!(account: accounts("37s"), user: users(:kevin), kind: :account)
+
+    email = DataTransferMailer.export_ready(export)
+
+    assert_equal [ users(:kevin).identity.email_address ], email.to
+    assert_equal "Your Fizzy export is ready", email.subject
+    assert_match %r{https?://example\.com/exports/}, email.body.encoded
+    assert_match(/expires in 24 hours/i, email.body.encoded)
+  end
+
+  test "import completion email points to the new account" do
+    account_import = Account::Import.new(
+      account: accounts("37s"),
+      user: users(:kevin),
+      imported_account: accounts(:initech)
+    )
+
+    email = DataTransferMailer.import_completed(account_import)
+
+    assert_equal [ users(:kevin).identity.email_address ], email.to
+    assert_match(/Open your new account/, email.body.encoded)
+    assert_includes email.body.encoded, accounts(:initech).slug
+  end
+
+  test "failed import email explains why and confirms no account was created" do
+    account_import = Account::Import.new(account: accounts("37s"), user: users(:kevin), error: "Missing manifest")
+
+    email = DataTransferMailer.import_failed(account_import)
+
+    assert_match(/Missing manifest/, email.body.encoded)
+    assert_match(/No new account was created/, email.body.encoded)
+  end
+end
