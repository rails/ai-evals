diff --git a/app/models/account/data_transfer/archive_reader.rb b/app/models/account/data_transfer/archive_reader.rb
new file mode 100644
index 0000000..edb4a73
--- /dev/null
+++ b/app/models/account/data_transfer/archive_reader.rb
@@ -0,0 +1,284 @@
+class Account::DataTransfer::ArchiveReader
+  MAX_ENTRY_COUNT = 1_000_000
+  MAX_MANIFEST_SIZE = 1.megabyte
+  MAX_TABLE_ENTRY_SIZE = 10.gigabytes
+  ALLOWED_FILE_NAME = /\Afiles\/(?:[0-9a-z]{25}|[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12})\z/i
+
+  attr_reader :manifest, :entries
+
+  def initialize(blob)
+    @io = BlobIO.new(blob)
+    @entries = ZipKit::FileReader.read_zip_structure(io: @io)
+    raise InvalidArchive, "The ZIP archive contains too many entries." if entries.size > MAX_ENTRY_COUNT
+
+    @entries_by_name = build_entry_index
+    @manifest = read_manifest
+  rescue InvalidArchive
+    raise
+  rescue StandardError => error
+    raise InvalidArchive, "The uploaded file isn't a valid Fizzy account export (#{error.message})."
+  end
+
+  def entry_for(name)
+    @entries_by_name[name]
+  end
+
+  def entry_reader(name)
+    entry = entry_for(name)
+    raise InvalidArchive, "The archive is missing #{name}." unless entry
+
+    entry_reader_for(entry)
+  end
+
+  def entry_reader_for(entry)
+    EntryReader.new(entry, @io)
+  end
+
+  def each_json_record(table_name)
+    return enum_for(__method__, table_name) unless block_given?
+
+    reader = entry_reader("data/#{table_name}.jsonl")
+    reader.each_line do |line|
+      next if line.blank?
+
+      record = JSON.parse(line)
+      raise InvalidArchive, "Invalid record in #{table_name}." unless record.is_a?(Hash)
+
+      yield record
+    rescue JSON::ParserError
+      raise InvalidArchive, "The #{table_name} data in this export is invalid."
+    end
+  end
+
+  def each_file_entry
+    return enum_for(__method__) unless block_given?
+
+    entries.each do |entry|
+      yield entry if entry.filename.start_with?("files/")
+    end
+  end
+
+  def validate_table_entries!(table_names)
+    expected_names = [ "manifest.json", *table_names.map { |table_name| "data/#{table_name}.jsonl" } ]
+    entries.each do |entry|
+      next if expected_names.include?(entry.filename)
+      next if entry.filename.match?(ALLOWED_FILE_NAME)
+
+      raise InvalidArchive, "The archive contains an unsupported entry: #{entry.filename}."
+    end
+
+    missing = expected_names - entries.map(&:filename)
+    if missing.any?
+      raise InvalidArchive, "The archive is missing #{missing.first}."
+    end
+  end
+
+  private
+    attr_reader :io
+
+    def build_entry_index
+      entries_by_name = {}
+
+      entries.each do |entry|
+        name = entry.filename.to_s.force_encoding(Encoding::UTF_8)
+        unless name.valid_encoding? && name.present? && !name.include?("\\") && !name.include?("\0")
+          raise InvalidArchive, "The ZIP archive contains an invalid file name."
+        end
+        raise InvalidArchive, "The ZIP archive contains duplicate entries." if entries_by_name.key?(name)
+
+        entry.filename = name
+        entries_by_name[name] = entry
+      end
+
+      entries_by_name
+    end
+
+    def read_manifest
+      manifest_entry = @entries_by_name["manifest.json"]
+      raise InvalidArchive, "This isn't a Fizzy account export." unless manifest_entry
+      if manifest_entry.uncompressed_size > MAX_MANIFEST_SIZE
+        raise InvalidArchive, "The export manifest is too large."
+      end
+
+      data = EntryReader.new(manifest_entry, io).read
+      document = JSON.parse(data)
+      unless document.is_a?(Hash) && document["format"] == Account::DataTransfer::Manifest::FORMAT &&
+          document["version"] == Account::DataTransfer::Manifest::VERSION && document["tables"].is_a?(Array)
+        raise InvalidArchive, "This isn't a supported Fizzy account export."
+      end
+
+      document
+    rescue JSON::ParserError
+      raise InvalidArchive, "The export manifest is invalid."
+    end
+
+  class InvalidArchive < StandardError; end
+
+  class BlobIO
+    def initialize(blob)
+      @blob = blob
+      @service = blob.service
+      @position = 0
+      @size = blob.byte_size
+    end
+
+    def size
+      @size
+    end
+
+    def tell
+      @position
+    end
+
+    def seek(offset, whence = IO::SEEK_SET)
+      target = case whence
+      when IO::SEEK_SET then offset
+      when IO::SEEK_CUR then @position + offset
+      when IO::SEEK_END then @size + offset
+      else raise ArgumentError, "Unsupported seek mode #{whence}."
+      end
+
+      raise Errno::EINVAL if target.negative?
+      @position = [ target, @size ].min
+      0
+    end
+
+    def read(length = nil, out_buffer = nil)
+      length = @size - @position if length.nil?
+      raise ArgumentError, "Negative length #{length}." if length.negative?
+
+      if length.zero?
+        result = "".b
+      elsif @position >= @size
+        result = nil
+      else
+        amount = [ length, @size - @position ].min
+        result = @service.download_chunk(@blob.key, @position...(@position + amount))
+        unless result && result.bytesize == amount
+          raise InvalidArchive, "The uploaded ZIP file couldn't be read completely."
+        end
+        @position += result.bytesize
+      end
+
+      if out_buffer
+        out_buffer.replace(result || "".b)
+        result = out_buffer if result
+      end
+
+      result
+    end
+  end
+
+  class EntryReader
+    INPUT_CHUNK_SIZE = 16.kilobytes
+
+    def initialize(entry, io)
+      @entry = entry
+      @extractor = entry.extractor_from(io)
+      @buffer = "".b
+      @read_size = 0
+      @crc = 0
+      @digest = Digest::MD5.new
+      @sha256 = Digest::SHA256.new
+      @finished = false
+      @verified = false
+    end
+
+    def size
+      @entry.uncompressed_size
+    end
+
+    def tell
+      @read_size - @buffer.bytesize
+    end
+
+    def read(length = nil, out_buffer = nil)
+      if length.nil?
+        result = "".b
+        while chunk = read(INPUT_CHUNK_SIZE)
+          result << chunk
+        end
+      else
+        raise ArgumentError, "Negative length #{length}." if length.negative?
+
+        if length.zero?
+          result = "".b
+        else
+          fill_buffer(length)
+          result = @buffer.slice!(0, length) || "".b
+          result = nil if result.empty? && @finished
+        end
+      end
+
+      if out_buffer
+        out_buffer.replace(result || "".b)
+        result = out_buffer if result
+      end
+
+      result
+    end
+
+    def each_line
+      return enum_for(__method__) unless block_given?
+
+      buffer = "".b
+      while chunk = read(64.kilobytes)
+        buffer << chunk
+        while newline = buffer.index("\n")
+          yield buffer.slice!(0, newline + 1).force_encoding(Encoding::UTF_8)
+        end
+      end
+
+      yield buffer.force_encoding(Encoding::UTF_8) if buffer.present?
+    end
+
+    def checksum_for(service)
+      digest_type = service.respond_to?(:default_digest_type) ? service.default_digest_type : :md5
+      digest = digest_type.to_sym == :sha256 ? @sha256 : @digest
+      checksum = Base64.strict_encode64(digest.clone.digest)
+      digest_type.to_sym == :md5 ? checksum : "#{digest_type}:#{checksum}"
+    end
+
+    def finish!
+      while read(64.kilobytes)
+      end
+
+      raise InvalidArchive, "An archive entry has an invalid checksum." unless @verified
+    end
+
+    private
+      def fill_buffer(length)
+        while @buffer.bytesize < length && !@finished
+          if @extractor.eof?
+            verify_integrity
+          else
+            chunk = @extractor.extract(INPUT_CHUNK_SIZE)
+            raise InvalidArchive, "The ZIP archive contains truncated data." if chunk.nil?
+
+            unless chunk.empty?
+              @read_size += chunk.bytesize
+              if @read_size > @entry.uncompressed_size
+                raise InvalidArchive, "The ZIP archive contains invalid data."
+              end
+
+              @crc = Zlib.crc32(chunk, @crc)
+              @digest.update(chunk)
+              @sha256.update(chunk)
+              @buffer << chunk
+            end
+
+            verify_integrity if @extractor.eof?
+          end
+        end
+      end
+
+      def verify_integrity
+        unless @read_size == @entry.uncompressed_size && @crc == @entry.crc32
+          raise InvalidArchive, "The ZIP archive contains an incomplete or corrupt entry."
+        end
+
+        @finished = true
+        @verified = true
+      end
+  end
+end
diff --git a/app/models/account/data_transfer/card_archive.rb b/app/models/account/data_transfer/card_archive.rb
new file mode 100644
index 0000000..a81c765
--- /dev/null
+++ b/app/models/account/data_transfer/card_archive.rb
@@ -0,0 +1,94 @@
+class Account::DataTransfer::CardArchive
+  BATCH_SIZE = 100
+  ARCHIVE_FORMAT = "fizzy-cards-export".freeze
+
+  def initialize(user)
+    @user = user
+    @blob_ids = Set.new
+  end
+
+  def export_to(zip)
+    zip.add_file("cards.json") do |sink|
+      sink.write(%({"format":#{JSON.generate(ARCHIVE_FORMAT)},"version":1,"cards":[))
+      first_card = true
+
+      cards.find_each(batch_size: BATCH_SIZE) do |card|
+        sink.write(",") unless first_card
+        sink.write(JSON.generate(card_attributes(card)))
+        first_card = false
+      end
+
+      sink.write("]}\n")
+    end
+
+    blob_ids.to_a.each_slice(500) do |batch|
+      ActiveStorage::Blob.where(id: batch).find_each(batch_size: BATCH_SIZE) do |blob|
+        zip.add_file("files/#{blob.id}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+  end
+
+  private
+    attr_reader :user, :blob_ids
+
+    def cards
+      user.accessible_cards.distinct
+    end
+
+    def card_attributes(card)
+      attachments = attachments_for(card)
+
+      card.attributes.merge(
+        "description" => rich_text_html(card),
+        "attachments" => attachment_attributes(attachments),
+        "comments" => card.comments.chronologically.includes(:creator).map do |comment|
+          comment_attachments = attachments_for(comment)
+
+          comment.attributes.merge(
+            "body" => rich_text_html(comment),
+            "attachments" => attachment_attributes(comment_attachments)
+          )
+        end
+      )
+    end
+
+    def attachments_for(record)
+      attachments = ActiveStorage::Attachment.where(record: record).includes(:blob).to_a
+      if rich_text = rich_text_for(record)
+        attachments.concat ActiveStorage::Attachment.where(record: rich_text).includes(:blob).to_a
+      end
+
+      attachments.uniq(&:id).sort_by(&:created_at)
+    end
+
+    def attachment_attributes(attachments)
+      attachments.map do |attachment|
+        blob = attachment.blob
+        blob_ids.add(blob.id)
+
+        {
+          id: attachment.id,
+          name: attachment.name,
+          record_type: attachment.record_type,
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          byte_size: blob.byte_size,
+          path: "files/#{blob.id}"
+        }
+      end
+    end
+
+    def rich_text_for(record)
+      association = record.class.reflect_on_all_associations(:has_one).find do |reflection|
+        reflection.klass == ActionText::RichText
+      end
+
+      record.public_send(association.name) if association
+    end
+
+    def rich_text_html(record)
+      rich_text_for(record)&.body&.to_html
+    end
+end
