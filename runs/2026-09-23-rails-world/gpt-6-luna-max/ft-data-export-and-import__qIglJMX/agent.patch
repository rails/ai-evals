@@ -0,0 +1,329 @@
+class Account::DataTransfer::Importer
+  INSERT_BATCH_SIZE = 500
+  UUID_FORMAT = /\A(?:[0-9a-z]{25}|[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12})\z/i
+
+  def initialize(account_import)
+    @account_import = account_import
+    @uploaded_files = []
+    @identities_by_email = {}
+  end
+
+  def import
+    archive = Account::DataTransfer::ArchiveReader.new(account_import.file.blob)
+    manifest = Account::DataTransfer::Manifest.new(account_import.account)
+    validate_archive!(archive, manifest)
+
+    account_record = read_account_record(archive)
+    @source_account_id = account_record.fetch("id")
+    @importer_identity = account_import.user.identity
+
+    imported_account = nil
+
+    Account.transaction do
+      imported_account = Account.create!(
+        name: account_record.fetch("name"),
+        cards_count: account_record["cards_count"].to_i
+      )
+      @imported_account = imported_account
+
+      manifest.each_record_set do |record_set|
+        if record_set.file_records?
+          import_files!(archive)
+        elsif record_set.table_name != "accounts"
+          remove_default_entropy if record_set.table_name == "entropies" && account_entropy_is_present?(archive)
+          import_table!(archive, record_set)
+        end
+      end
+
+      ensure_importing_user!
+      ensure_system_user!
+      update_card_counter!(account_record)
+      rebuild_derived_data!
+
+      account_import.update!(
+        imported_account: imported_account,
+        status: :completed,
+        error: nil
+      )
+    end
+
+    imported_account
+  rescue StandardError
+    cleanup_uploaded_files
+    raise
+  end
+
+  private
+    attr_reader :account_import, :imported_account, :source_account_id, :importer_identity
+
+    def validate_archive!(archive, manifest)
+      unless archive.manifest["tables"].sort == manifest.table_names.sort
+        raise Account::DataTransfer::ArchiveReader::InvalidArchive, "This account export was created by an incompatible version of Fizzy."
+      end
+
+      archive.validate_table_entries!(manifest.table_names)
+
+      manifest.table_names.each do |table_name|
+        entry = archive.entry_for("data/#{table_name}.jsonl")
+        if entry.uncompressed_size > Account::DataTransfer::ArchiveReader::MAX_TABLE_ENTRY_SIZE
+          raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The #{table_name} data in this export is too large."
+        end
+      end
+    end
+
+    def read_account_record(archive)
+      account_record = nil
+      count = 0
+      archive.each_json_record("accounts") do |record|
+        count += 1
+        account_record = record
+      end
+
+      unless count == 1 && account_record["id"].present? && account_record["name"].present?
+        raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The export must contain exactly one account."
+      end
+
+      unless account_record["id"].to_s.match?(UUID_FORMAT)
+        raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The account in this export has an invalid ID."
+      end
+
+      account_record
+    end
+
+    def import_table!(archive, record_set)
+      batch = []
+
+      archive.each_json_record(record_set.table_name) do |record|
+        batch << import_attributes(record_set, record)
+        if batch.size >= INSERT_BATCH_SIZE
+          insert_records!(record_set.model, batch)
+          batch.clear
+        end
+      end
+
+      insert_records!(record_set.model, batch) if batch.any?
+    end
+
+    def import_attributes(record_set, source_attributes)
+      allowed_attributes = record_set.attributes
+      extra_attributes = source_attributes.keys - allowed_attributes
+      allowed_extras = record_set.is_a?(Account::DataTransfer::UserRecordSet) ? %w[email_address] : []
+      if (extra_attributes - allowed_extras).any?
+        raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The #{record_set.table_name} data contains unsupported fields."
+      end
+
+      attributes = source_attributes.slice(*allowed_attributes)
+      if record_set.model.primary_key
+        source_id = attributes["id"]
+        unless source_id.present? && source_id.to_s.match?(UUID_FORMAT)
+          raise Account::DataTransfer::ArchiveReader::InvalidArchive, "A record in #{record_set.table_name} has an invalid ID."
+        end
+
+        attributes["id"] = remap_id(source_id)
+      end
+
+      attributes.each do |name, value|
+        if name == "account_id"
+          attributes[name] = imported_account.id
+        elsif name == "identity_id" && record_set.is_a?(Account::DataTransfer::UserRecordSet)
+          attributes[name] = identity_for(source_attributes)&.id
+        elsif name.end_with?("_id") && value.present?
+          attributes[name] = remap_id(value)
+        end
+      end
+
+      if record_set.model == ActiveStorage::Blob
+        attributes["service_name"] = ActiveStorage::Blob.service.name
+        attributes["key"] = ActiveStorage::Blob.generate_unique_secure_token
+      elsif record_set.model == Board::Publication
+        attributes["key"] = SecureRandom.base58(24)
+      end
+
+      make_importer_owner!(attributes, source_attributes) if record_set.is_a?(Account::DataTransfer::UserRecordSet)
+      attributes
+    end
+
+    def make_importer_owner!(attributes, source_attributes)
+      identity = identity_for(source_attributes)
+      if identity && importer_identity && identity.id == importer_identity.id
+        attributes["role"] = "owner"
+        attributes["active"] = true
+        attributes["verified_at"] ||= Time.current
+      end
+    end
+
+    def identity_for(source_attributes)
+      return unless source_attributes["identity_id"].present? || source_attributes["email_address"].present?
+
+      email_address = source_attributes["email_address"].presence
+      if email_address.blank? && source_attributes["identity_id"].present?
+        email_address = Identity.find_by(id: source_attributes["identity_id"])&.email_address
+      end
+      return if email_address.blank?
+
+      normalized_email = email_address.strip.downcase
+      @identities_by_email[normalized_email] ||= Identity.find_or_create_by!(email_address: normalized_email)
+    rescue ActiveRecord::RecordInvalid => error
+      raise Account::DataTransfer::ArchiveReader::InvalidArchive, "A person in this export has an invalid email address: #{error.message}."
+    end
+
+    def insert_records!(model, records)
+      model.insert_all!(records)
+      @imported_blob_count = @imported_blob_count.to_i + records.size if model == ActiveStorage::Blob
+    end
+
+    def import_files!(archive)
+      file_entries = archive.each_file_entry.to_a
+      unless file_entries.size == @imported_blob_count.to_i
+        raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The export is missing one or more attached files."
+      end
+
+      file_entries.each do |entry|
+        source_blob_id = entry.filename.delete_prefix("files/")
+        unless source_blob_id.match?(UUID_FORMAT)
+          raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The export contains a file with an invalid ID."
+        end
+
+        blob = ActiveStorage::Blob.find_by!(id: remap_id(source_blob_id), account_id: imported_account.id)
+        unless entry.uncompressed_size == blob.byte_size
+          raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The file #{blob.filename} is incomplete."
+        end
+
+        service = blob.service
+        reader = archive.entry_reader_for(entry)
+        @uploaded_files << [ service, blob.key ]
+        service.upload(blob.key, reader, **blob.service_metadata)
+        reader.finish!
+        blob.update_columns(checksum: reader.checksum_for(service))
+      rescue ActiveRecord::RecordNotFound
+        raise Account::DataTransfer::ArchiveReader::InvalidArchive, "The export contains an unrecognized attached file."
+      end
+    end
+
+    def account_entropy_is_present?(archive)
+      archive.each_json_record("entropies").any? { |record| record["container_type"] == "Account" }
+    end
+
+    def remove_default_entropy
+      Entropy.where(account_id: imported_account.id, container_type: "Account", container_id: imported_account.id).delete_all
+    end
+
+    def ensure_importing_user!
+      return unless importer_identity
+
+      user = imported_account.users.find_by(identity_id: importer_identity.id)
+      if user
+        user.update_columns(role: "owner", active: true, verified_at: user.verified_at || Time.current)
+      else
+        user_id = ActiveRecord::Type::Uuid.generate
+        now = Time.current
+        User.insert_all! [ {
+          id: user_id,
+          account_id: imported_account.id,
+          identity_id: importer_identity.id,
+          name: account_import.user.name,
+          role: "owner",
+          active: true,
+          verified_at: now,
+          created_at: now,
+          updated_at: now
+        } ]
+
+        User::Settings.insert_all! [ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: imported_account.id,
+          user_id: user_id,
+          bundle_email_frequency: User::Settings.bundle_email_frequencies.fetch("every_few_hours"),
+          created_at: now,
+          updated_at: now
+        } ]
+        user = imported_account.users.find(user_id)
+      end
+
+      ensure_importing_user_settings!(user)
+      grant_access_to_all_boards!(user)
+    end
+
+    def ensure_importing_user_settings!(user)
+      unless User::Settings.exists?(account_id: imported_account.id, user_id: user.id)
+        now = Time.current
+        User::Settings.insert_all! [ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: imported_account.id,
+          user_id: user.id,
+          bundle_email_frequency: User::Settings.bundle_email_frequencies.fetch("every_few_hours"),
+          created_at: now,
+          updated_at: now
+        } ]
+      end
+    end
+
+    def grant_access_to_all_boards!(user)
+      existing_board_ids = Access.where(account_id: imported_account.id, user_id: user.id).pluck(:board_id)
+      board_ids = imported_account.boards.where.not(id: existing_board_ids).pluck(:id)
+      now = Time.current
+
+      if board_ids.any?
+        accesses = board_ids.map do |board_id|
+          {
+            id: ActiveRecord::Type::Uuid.generate,
+            account_id: imported_account.id,
+            board_id: board_id,
+            user_id: user.id,
+            involvement: "access_only",
+            created_at: now,
+            updated_at: now
+          }
+        end
+        Access.insert_all!(accesses)
+      end
+    end
+
+    def ensure_system_user!
+      unless imported_account.users.where(role: :system).exists?
+        now = Time.current
+        User.insert_all! [ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: imported_account.id,
+          name: "System",
+          role: "system",
+          active: true,
+          created_at: now,
+          updated_at: now
+        } ]
+      end
+    end
+
+    def rebuild_derived_data!
+      imported_account.boards.find_each(&:reconcile_storage)
+      imported_account.reconcile_storage
+
+      imported_account.cards.published.with_rich_text_description.find_each(&:reindex)
+      Comment.where(account_id: imported_account.id, card_id: imported_account.cards.published.select(:id))
+        .with_rich_text_body.includes(:card).find_each(&:reindex)
+    end
+
+    def update_card_counter!(account_record)
+      highest_number = Card.where(account_id: imported_account.id).maximum(:number).to_i
+      cards_count = [ account_record["cards_count"].to_i, highest_number ].max
+      imported_account.update_columns(cards_count: cards_count)
+    end
+
+    def remap_id(value)
+      return imported_account.id if value.to_s == source_account_id.to_s
+
+      hex = Digest::SHA256.hexdigest("#{account_import.id}:#{value}").first(32)
+      hex[12] = "7"
+      hex[16] = (8 + (hex[16].to_i(16) & 3)).to_s(16)
+      hex.to_i(16).to_s(36).rjust(ActiveRecord::Type::Uuid::BASE36_LENGTH, "0")
+    end
+
+    def cleanup_uploaded_files
+      @uploaded_files.each do |service, key|
+        service.delete(key)
+      rescue StandardError => error
+        Rails.error.report(error, severity: :error, context: { transfer_id: account_import.id, storage_key: key })
+      end
+      @uploaded_files.clear
+    end
+end
