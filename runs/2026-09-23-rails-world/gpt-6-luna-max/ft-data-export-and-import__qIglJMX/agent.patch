diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..44ce29c
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,28 @@
+class Account::ImportJob < ApplicationJob
+  def perform(account_import)
+    if account_import.completed?
+      DataTransferMailer.import_completed(account_import).deliver_later
+    elsif account_import.failed?
+      DataTransferMailer.import_failed(account_import).deliver_later
+    else
+      perform_import(account_import)
+    end
+  end
+
+  private
+    def perform_import(account_import)
+      begin
+        account_import.process
+      rescue StandardError => error
+        account_import.fail!(error.message)
+        Rails.error.report(error, severity: :error, context: { import_id: account_import.id })
+        DataTransferMailer.import_failed(account_import).deliver_later
+      ensure
+        account_import.file.purge if account_import.file.attached?
+      end
+
+      if account_import.completed?
+        DataTransferMailer.import_completed(account_import).deliver_later
+      end
+    end
+end
diff --git a/app/jobs/export_job.rb b/app/jobs/export_job.rb
new file mode 100644
index 0000000..ebb7320
--- /dev/null
+++ b/app/jobs/export_job.rb
@@ -0,0 +1,24 @@
+class ExportJob < ApplicationJob
+  def perform(export)
+    if export.completed?
+      DataTransferMailer.export_ready(export).deliver_later
+    elsif export.failed?
+      DataTransferMailer.export_failed(export).deliver_later
+    else
+      perform_export(export)
+    end
+  end
+
+  private
+    def perform_export(export)
+      begin
+        export.generate
+      rescue StandardError => error
+        export.update!(status: :failed, error: error.message.truncate(2_000))
+        Rails.error.report(error, severity: :error, context: { export_id: export.id })
+        DataTransferMailer.export_failed(export).deliver_later
+      else
+        DataTransferMailer.export_ready(export).deliver_later
+      end
+    end
+end
diff --git a/app/mailers/data_transfer_mailer.rb b/app/mailers/data_transfer_mailer.rb
new file mode 100644
index 0000000..3174f4f
--- /dev/null
+++ b/app/mailers/data_transfer_mailer.rb
@@ -0,0 +1,28 @@
+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @download_url = export_url(export.download_token, script_name: nil)
+
+    mail(to: export.user.identity.email_address, subject: "Your Fizzy export is ready")
+  end
+
+  def export_failed(export)
+    @export = export
+
+    mail(to: export.user.identity.email_address, subject: "Your Fizzy export couldn't be prepared")
+  end
+
+  def import_completed(account_import)
+    @account_import = account_import
+    @account = account_import.imported_account
+    @account_url = root_url(script_name: @account.slug)
+
+    mail(to: account_import.user.identity.email_address, subject: "Your Fizzy account import is complete")
+  end
+
+  def import_failed(account_import)
+    @account_import = account_import
+
+    mail(to: account_import.user.identity.email_address, subject: "Your Fizzy account import couldn't be completed")
+  end
+end
