+<section id="billing" class="settings__section">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      <strong><%= account.billing_plan.name %></strong>
+      <% if account.comped? %>
+        <span>(comped)</span>
+      <% else %>
+        <span>· <%= account.billing_plan.price_label %></span>
+      <% end %>
+    </div>
+    <div><%= account.billing_plan.card_allowance %> · <%= number_to_human_size(account.billing_plan.storage_limit) %> storage</div>
+  </header>
+
+  <% if account.comped? %>
+    <p>This account has complimentary access.</p>
+  <% elsif account.stripe_customer_id.present? %>
+    <%= button_to "Upgrade", saas.account_billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn",
+          title: "Upgrade or manage your plan in Stripe" %>
+  <% else %>
+    <div class="flex flex-column gap-half">
+      <% Billing::Plan.paid.each do |plan| %>
+        <div class="flex align-center justify-space-between gap-half">
+          <div><strong><%= plan.name %></strong> · <%= plan.price_label %> · <%= plan.card_allowance %> · <%= number_to_human_size(plan.storage_limit) %></div>
+          <%= button_to "Upgrade", saas.account_billing_checkout_path(script_name: Current.account.slug), method: :post,
+                params: { plan: plan.key }, class: "btn" %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
