diff --git a/saas/test/controllers/account/billing_test.rb b/saas/test/controllers/account/billing_test.rb
new file mode 100644
index 0000000..5bcdb09
--- /dev/null
+++ b/saas/test/controllers/account/billing_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+require "ostruct"
+
+class Account::BillingControllerTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade choices in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "#billing" do
+      assert_select "strong", text: "Free"
+      assert_select "button", text: "Upgrade", count: 2
+      assert_select "form[action=?]", "#{accounts(:initech).slug}/account/billing/checkout", count: 2
+      assert_select "div", text: /Unlimited.*\$20\/month/
+      assert_select "div", text: /Unlimited\+.*\$25\/month/
+    end
+  end
+
+  test "checkout creates a Stripe subscription session for a selected plan" do
+    sign_in_as :mike
+    Billing::Plan.any_instance.stubs(:stripe_line_items).returns([ { price: "price_unlimited", quantity: 1 } ])
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:mode] == "subscription" &&
+        attributes[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        attributes[:metadata][:account_id] == accounts(:initech).id &&
+        attributes[:metadata][:plan_key] == "unlimited"
+    end.returns(OpenStruct.new(url: "https://checkout.stripe.com/cs_test_session"))
+
+    post saas.account_billing_checkout_path(script_name: accounts(:initech).slug), params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.com/cs_test_session"
+  end
+
+  test "billing portal redirects admins to Stripe" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(
+      plan_key: "unlimited", status: "active", stripe_customer_id: "cus_portal"
+    )
+    Stripe::BillingPortal::Session.expects(:create).with do |attributes|
+      attributes[:customer] == "cus_portal" && attributes[:return_url].include?("account/settings")
+    end.returns(OpenStruct.new(url: "https://billing.stripe.com/session"))
+
+    post saas.account_billing_portal_path(script_name: accounts(:initech).slug)
+
+    assert_redirected_to "https://billing.stripe.com/session"
+  end
+end
