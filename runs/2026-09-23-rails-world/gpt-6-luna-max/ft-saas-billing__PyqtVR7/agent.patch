diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..f090fd4
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+require "ostruct"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "rejects an invalid webhook signature" do
+    post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :bad_request
+  end
+
+  test "subscription webhook updates an account plan and storage allowance" do
+    account = accounts(:initech)
+    event = OpenStruct.new(
+      type: "customer.subscription.updated",
+      data: OpenStruct.new(object: {
+        id: "sub_unlimited_plus",
+        customer: "cus_initech",
+        status: "active",
+        current_period_end: 1.day.from_now.to_i,
+        metadata: { account_id: account.id, plan_key: "unlimited_plus" },
+        items: { data: [] }
+      })
+    )
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+
+    post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :success
+    assert_equal "unlimited_plus", account.reload.billing_plan.key
+    assert_equal "cus_initech", account.subscription.stripe_customer_id
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "deleted subscription returns the account to the free plan" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      plan_key: "unlimited", status: "active", stripe_customer_id: "cus_initech", stripe_subscription_id: "sub_initech"
+    )
+    event = OpenStruct.new(
+      type: "customer.subscription.deleted",
+      data: OpenStruct.new(object: {
+        id: "sub_initech",
+        customer: "cus_initech",
+        status: "canceled",
+        metadata: { account_id: account.id, plan_key: "unlimited" },
+        items: { data: [] }
+      })
+    )
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+
+    post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :success
+    assert_equal "free", account.reload.billing_plan.key
+    assert_equal "canceled", account.subscription.status
+  end
+
+  test "completed checkout stores the Stripe customer and selected plan" do
+    account = accounts(:initech)
+    event = OpenStruct.new(
+      type: "checkout.session.completed",
+      data: OpenStruct.new(object: {
+        mode: "subscription",
+        customer: "cus_checkout",
+        subscription: "sub_checkout",
+        metadata: { account_id: account.id, plan_key: "unlimited" }
+      })
+    )
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+
+    post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :success
+    assert_equal "unlimited", account.reload.billing_plan.key
+    assert_equal "cus_checkout", account.subscription.stripe_customer_id
+    assert_equal "sub_checkout", account.subscription.stripe_subscription_id
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..667f19d
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  test "new accounts start on the free plan and its allowances" do
+    account = accounts(:initech)
+
+    assert_equal "free", account.billing_plan.key
+    assert_equal 1_000, account.card_limit
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "paid subscriptions supply their own card and storage allowances" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", status: "active")
+
+    assert_equal "unlimited", account.billing_plan.key
+    assert_nil account.card_limit
+    assert_equal 5.gigabytes, account.storage_limit
+
+    account.subscription.update!(plan_key: "unlimited_plus")
+    assert_equal "unlimited_plus", account.billing_plan.key
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "card allowance counts down from 100 cards and then blocks publishing" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 950)
+
+    assert account.nearing_card_limit?
+    assert_equal 50, account.cards_left
+
+    account.update_column(:cards_count, 1_000)
+    assert account.out_of_cards?
+    assert_equal 0, account.cards_left
+    assert_not account.nearing_card_limit?
+  end
+
+  test "support overrides card and storage usage until reset" do
+    account = accounts(:initech)
+    account.update_column(:cards_count, 950)
+    account.add_overridden_limit(card_count: 990, bytes_used: 2.gigabytes)
+
+    assert_equal 990, account.card_count
+    assert_equal 10, account.cards_left
+    assert_equal 2.gigabytes, account.bytes_used
+
+    account.reset_overridden_limit!
+    assert_equal 950, account.card_count
+  end
+
+  test "comping an account removes its plan limits" do
+    account = accounts(:initech)
+    account.comp!
+
+    assert account.comped?
+    assert account.billing_plan.unlimited_cards?
+
+    account.uncomp!
+    assert_not account.comped?
+    assert_equal "free", account.billing_plan.key
+  end
+end
