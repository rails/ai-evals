diff --git a/saas/app/controllers/account/billing/checkouts_controller.rb b/saas/app/controllers/account/billing/checkouts_controller.rb
new file mode 100644
index 0000000..8f02dbc
--- /dev/null
+++ b/saas/app/controllers/account/billing/checkouts_controller.rb
@@ -0,0 +1,41 @@
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    @plan = Billing::Plan.find(params[:plan] || params[:plan_key])
+
+    if @plan&.paid? && @plan.stripe_line_items.any?
+      session = Stripe::Checkout::Session.create(checkout_session_params)
+      redirect_to session.url, allow_other_host: true
+    else
+      redirect_to main_app.account_settings_path(script_name: Current.account.slug),
+        alert: "That plan is not available right now."
+    end
+  rescue Stripe::StripeError
+    redirect_to main_app.account_settings_path(script_name: Current.account.slug),
+      alert: "We couldn’t start checkout. Please try again."
+  end
+
+  private
+    def checkout_session_params
+      settings_url = main_app.account_settings_url(script_name: Current.account.slug)
+      metadata = { account_id: Current.account.id, plan_key: @plan.key }
+      attributes = {
+        mode: "subscription",
+        line_items: @plan.stripe_line_items,
+        success_url: "#{settings_url}?billing=success",
+        cancel_url: settings_url,
+        client_reference_id: Current.account.id,
+        metadata: metadata,
+        subscription_data: { metadata: metadata }
+      }
+
+      if Current.account.stripe_customer_id.present?
+        attributes[:customer] = Current.account.stripe_customer_id
+      else
+        attributes[:customer_email] = Current.identity.email_address
+      end
+
+      attributes
+    end
+end
