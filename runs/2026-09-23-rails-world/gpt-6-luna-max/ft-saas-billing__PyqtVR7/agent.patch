+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= link_to "Accounts", saas.admin_accounts_path %> / <%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="settings__section">
+      <header>
+        <h2 class="divider txt-medium">Account</h2>
+      </header>
+      <p>Plan: <strong><%= @account.billing_plan.name %></strong><% if @account.comped? %> (comped)<% end %></p>
+      <p>Card count: <strong><%= number_with_delimiter(@account.card_count) %></strong></p>
+      <p>Bytes used: <strong><%= number_with_delimiter(@account.bytes_used) %></strong></p>
+
+      <div class="flex gap-half">
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+        <% else %>
+          <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+        <% end %>
+      </div>
+    </div>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider txt-medium">Usage override</h2>
+      </header>
+      <%= form_with model: @overridden_limit, url: saas.admin_account_overridden_limit_path(@account), scope: :overridden_limit, method: :post do |form| %>
+        <div class="flex flex-column gap-half">
+          <label>
+            Card count
+            <%= form.number_field :card_count, min: 0, step: 1, class: "input full-width" %>
+          </label>
+          <label>
+            Bytes used
+            <%= form.number_field :bytes_used, min: 0, step: 1, class: "input full-width" %>
+          </label>
+          <div class="flex gap-half">
+            <%= form.button "Override", class: "btn" %>
+          </div>
+        </div>
+      <% end %>
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn" %>
+    </section>
+  </div>
+</section>
