+class Admin::AccountOverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def create
+    @account.add_overridden_limit(**overridden_limit_params.to_h.symbolize_keys)
+    redirect_to saas.admin_account_path(@account), notice: "Usage overridden"
+  rescue ActiveRecord::RecordInvalid
+    @overridden_limit = @account.overridden_limit || @account.build_overridden_limit
+    @overridden_limit.assign_attributes(overridden_limit_params)
+    render "admin/accounts/show", status: :unprocessable_entity
+  end
+
+  def destroy
+    @account.reset_overridden_limit!
+    redirect_to saas.admin_account_path(@account), notice: "Usage override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def overridden_limit_params
+      params.expect(overridden_limit: [ :card_count, :bytes_used ])
+    end
+end
