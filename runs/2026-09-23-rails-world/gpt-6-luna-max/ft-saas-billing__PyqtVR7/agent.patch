diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..f70d32f
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,67 @@
+class Stripe::WebhooksController < ActionController::Base
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.raw_post,
+      request.headers["Stripe-Signature"],
+      ENV.fetch("STRIPE_WEBHOOK_SECRET", "")
+    )
+
+    process_event(event)
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def process_event(event)
+      case event.type
+      when "checkout.session.completed"
+        sync_checkout_session(event.data.object)
+      when "checkout.session.async_payment_succeeded"
+        sync_checkout_session(event.data.object)
+      else
+        sync_subscription(event.data.object) if event.type.to_s.start_with?("customer.subscription.")
+      end
+    end
+
+    def sync_checkout_session(checkout_session)
+      return unless value_of(checkout_session, :mode) == "subscription"
+
+      metadata = value_of(checkout_session, :metadata)
+      account_id = value_of(metadata, :account_id) || value_of(checkout_session, :client_reference_id)
+      account = Account.find_by(id: account_id)
+      subscription_id = value_of(checkout_session, :subscription)
+      plan_key = value_of(metadata, :plan_key)
+
+      if account && subscription_id.present?
+        Account::Subscription.sync_from_checkout_session!(
+          account: account,
+          checkout_session: checkout_session,
+          plan_key: plan_key
+        )
+      end
+    end
+
+    def sync_subscription(stripe_subscription)
+      stripe_subscription_id = stripe_id(value_of(stripe_subscription, :id))
+      customer_id = stripe_id(value_of(stripe_subscription, :customer))
+      metadata = value_of(stripe_subscription, :metadata)
+      account_id = value_of(metadata, :account_id)
+
+      account = Account.find_by(id: account_id)
+      account ||= Account::Subscription.find_by(stripe_subscription_id: stripe_subscription_id)&.account
+      account ||= Account::Subscription.find_by(stripe_customer_id: customer_id)&.account
+
+      if account
+        Account::Subscription.sync_from_stripe!(account: account, stripe_subscription: stripe_subscription)
+      end
+    end
+
+    def value_of(object, key)
+      Billing::Plan.value_of(object, key)
+    end
+
+    def stripe_id(value)
+      value.is_a?(String) ? value : value_of(value, :id) || value
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..68e36db
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,78 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def billing_plan
+    if comped?
+      Billing::Plan.unlimited_plus
+    elsif active_subscription
+      active_subscription.plan
+    else
+      Billing::Plan.free
+    end
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def out_of_cards?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def exceeding_card_limit?
+    out_of_cards?
+  end
+
+  def cards_left
+    if card_limit
+      [ card_limit - card_count, 0 ].max
+    end
+  end
+
+  def nearing_card_limit?
+    cards_left.present? && cards_left.positive? && cards_left <= 100
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    waiver = billing_waiver || create_billing_waiver!
+    association(:billing_waiver).reset
+    waiver
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def add_overridden_limit(card_count: nil, bytes_used: nil)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def reset_overridden_limit!
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+end
