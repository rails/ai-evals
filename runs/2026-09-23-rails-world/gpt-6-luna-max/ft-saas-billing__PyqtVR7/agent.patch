diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..b943d93
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,72 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :account_id, uniqueness: true
+  validates :stripe_customer_id, uniqueness: true, allow_nil: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  ACTIVE_STATUSES = %w[ active trialing ].freeze
+
+  def self.sync_from_stripe!(account:, stripe_subscription:, plan_key: nil)
+    record = account.subscription || account.build_subscription
+    record.sync_from_stripe!(stripe_subscription, plan_key: plan_key)
+    record
+  end
+
+  def self.sync_from_checkout_session!(account:, checkout_session:, plan_key:)
+    record = account.subscription || account.build_subscription
+    record.update!(
+      plan_key: Billing::Plan.find(plan_key)&.key || "free",
+      stripe_customer_id: stripe_id(value_of(checkout_session, :customer)) || record.stripe_customer_id,
+      stripe_subscription_id: stripe_id(value_of(checkout_session, :subscription)) || record.stripe_subscription_id,
+      status: "active"
+    )
+    record
+  end
+
+  def plan
+    Billing::Plan.find(plan_key) || Billing::Plan.free
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES) && plan.paid?
+  end
+
+  def sync_from_stripe!(stripe_subscription, plan_key: nil)
+    metadata = value_of(stripe_subscription, :metadata)
+    stripe_plan_key = Billing::Plan.key_for_stripe_subscription(stripe_subscription) ||
+      plan_key || value_of(metadata, :plan_key) || self.plan_key || "free"
+
+    update!(
+      plan_key: Billing::Plan.find(stripe_plan_key)&.key || "free",
+      stripe_customer_id: stripe_id(value_of(stripe_subscription, :customer)) || stripe_customer_id,
+      stripe_subscription_id: stripe_id(value_of(stripe_subscription, :id)) || stripe_subscription_id,
+      status: value_of(stripe_subscription, :status) || status || "incomplete",
+      current_period_end: timestamp(value_of(stripe_subscription, :current_period_end)),
+      cancel_at: timestamp(value_of(stripe_subscription, :cancel_at))
+    )
+  end
+
+  private
+    def self.value_of(object, key)
+      Billing::Plan.value_of(object, key)
+    end
+
+    def self.stripe_id(value)
+      value.is_a?(String) ? value : Billing::Plan.value_of(value, :id) || value
+    end
+
+    def value_of(object, key)
+      self.class.value_of(object, key)
+    end
+
+    def stripe_id(value)
+      self.class.stripe_id(value)
+    end
+
+    def timestamp(value)
+      if value.present?
+        value.is_a?(Numeric) ? Time.zone.at(value) : Time.zone.parse(value.to_s)
+      end
+    end
+end
diff --git a/saas/app/models/billing/plan.rb b/saas/app/models/billing/plan.rb
new file mode 100644
index 0000000..9125bfb
--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,125 @@
+module Billing
+  class Plan
+    CATALOG = {
+      "free" => { name: "Free", card_limit: 1_000, storage_limit: 1.gigabyte, price_in_cents: 0 },
+      "unlimited" => { name: "Unlimited", card_limit: nil, storage_limit: 5.gigabytes, price_in_cents: 2_000 },
+      "unlimited_plus" => { name: "Unlimited+", card_limit: nil, storage_limit: 500.gigabytes, price_in_cents: 2_500 }
+    }.freeze
+
+    attr_reader :key, :name, :card_limit, :storage_limit, :price_in_cents
+
+    def initialize(key)
+      @key = key.to_s
+      attributes = CATALOG.fetch(@key)
+      @name = attributes.fetch(:name)
+      @card_limit = attributes.fetch(:card_limit)
+      @storage_limit = attributes.fetch(:storage_limit)
+      @price_in_cents = attributes.fetch(:price_in_cents)
+    end
+
+    def self.all
+      CATALOG.keys.map { |key| new(key) }
+    end
+
+    def self.paid
+      all.reject(&:free?)
+    end
+
+    def self.find(key)
+      new(key) if CATALOG.key?(key.to_s)
+    end
+
+    def self.fetch(key)
+      find(key) || raise(KeyError, "Unknown billing plan: #{key}")
+    end
+
+    def self.free
+      fetch("free")
+    end
+
+    def self.unlimited
+      fetch("unlimited")
+    end
+
+    def self.unlimited_plus
+      fetch("unlimited_plus")
+    end
+
+    def self.key_for_price_ids(price_ids)
+      price_ids = Array(price_ids).compact
+
+      plus_price_id = ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"].presence
+      extra_storage_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].presence
+      unlimited_plus_ids = [ plus_price_id, extra_storage_price_id ].compact
+      return "unlimited_plus" if (price_ids & unlimited_plus_ids).any?
+
+      unlimited_price_id = ENV["STRIPE_UNLIMITED_PRICE_ID"].presence || ENV["STRIPE_MONTHLY_V1_PRICE_ID"].presence
+      return "unlimited" if unlimited_price_id && price_ids.include?(unlimited_price_id)
+
+      nil
+    end
+
+    def self.key_for_stripe_subscription(stripe_subscription)
+      items = value_of(stripe_subscription, :items)
+      items = value_of(items, :data) || []
+      price_ids = items.filter_map do |item|
+        price = value_of(item, :price) || value_of(item, :plan)
+        price.is_a?(String) ? price : value_of(price, :id)
+      end
+
+      key_for_price_ids(price_ids)
+    end
+
+    def self.value_of(object, key)
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[])
+        object[key] || object[key.to_s]
+      end
+    end
+
+    def free?
+      key == "free"
+    end
+
+    def paid?
+      !free?
+    end
+
+    def unlimited_cards?
+      card_limit.nil?
+    end
+
+    def price_label
+      if free?
+        "Free"
+      else
+        "$#{price_in_cents / 100}/month"
+      end
+    end
+
+    def card_allowance
+      unlimited_cards? ? "Unlimited cards" : "#{ActiveSupport::NumberHelper.number_to_delimited(card_limit)} cards"
+    end
+
+    def stripe_price_ids
+      case key
+      when "unlimited"
+        [ ENV["STRIPE_UNLIMITED_PRICE_ID"].presence || ENV["STRIPE_MONTHLY_V1_PRICE_ID"].presence ].compact
+      when "unlimited_plus"
+        if ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"].present?
+          [ ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] ]
+        else
+          price_ids = [ ENV["STRIPE_MONTHLY_V1_PRICE_ID"], ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ]
+          price_ids.all?(&:present?) ? price_ids : []
+        end
+      else
+        []
+      end
+    end
+
+    def stripe_line_items
+      stripe_price_ids.map { |price_id| { price: price_id, quantity: 1 } }
+    end
+  end
+end
