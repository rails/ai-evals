+  test "auto postpone sweep continues through batches as it updates last-active timestamps" do
+    freeze_time
+    cards(:logo, :layout).each { |card| card.update!(last_active_at: 90.days.ago) }
+
+    assert_difference -> { Card.postponed.count }, +2 do
+      Card.auto_postpone_all_due(batch_size: 1)
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+  end
+
+  test "due sweep uses the account and last-active index on SQLite" do
+    skip unless ActiveRecord::Base.connection.adapter_name == "SQLite"
+
+    relation = Card.due_to_be_postponed_for(accounts("37s"), 90.days.to_i, Time.current)
+    plan = ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{relation.to_sql}").map { |row| row.fetch("detail") }
+
+    assert_includes plan.join(" "), "index_cards_on_account_id_and_last_active_at_and_status"
+  end
