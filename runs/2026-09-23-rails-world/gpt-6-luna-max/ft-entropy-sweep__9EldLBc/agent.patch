@@ -2,12 +2,11 @@ module Card::Entropic
   extend ActiveSupport::Concern
 
   included do
-    scope :due_to_be_postponed, -> do
-      active
-        .joins(board: :account)
+    scope :due_to_be_postponed_for, ->(account, period, now = Time.current) do
+      account.cards.active
         .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+        .where("COALESCE(entropies.auto_postpone_period, ?) = ?", account.entropy&.auto_postpone_period, period)
+        .where("cards.last_active_at <= ?", now - period.seconds)
     end
 
     scope :postponing_soon, -> do
@@ -24,9 +23,17 @@ module Card::Entropic
   end
 
   class_methods do
-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+    def auto_postpone_all_due(batch_size: 1000)
+      Account.preload(:entropy).find_each do |account|
+        system_user = nil
+
+        account.entropies.distinct.pluck(:auto_postpone_period).each do |period|
+          # Postpone events update last_active_at; find_each captures each batch cursor before yielding records.
+          due_to_be_postponed_for(account, period).find_each(cursor: [ :last_active_at, :id ], batch_size:) do |card|
+            system_user ||= account.system_user
+            card.auto_postpone(user: system_user)
+          end
+        end
       end
     end
   end
