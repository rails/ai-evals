@@ -76,6 +76,33 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Self-hosted OSS deployments provide their public hostname and SMTP settings
+  # through the Kamal configuration. Keep SaaS's environment-specific settings
+  # independent of these defaults.
+  unless Fizzy.saas?
+    app_host = ENV.fetch("APP_HOST", "localhost")
+    app_url_options = { host: app_host, protocol: "https" }
+
+    config.action_controller.default_url_options = app_url_options
+    config.action_mailer.default_url_options = app_url_options
+    config.after_initialize do
+      Rails.application.routes.default_url_options = app_url_options
+    end
+
+    if ENV["SMTP_ADDRESS"].present?
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: ENV["SMTP_ADDRESS"],
+        port: Integer(ENV.fetch("SMTP_PORT", "587")),
+        domain: ENV.fetch("SMTP_DOMAIN", app_host),
+        user_name: ENV["SMTP_USERNAME"],
+        password: ENV["SMTP_PASSWORD"],
+        authentication: ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym,
+        enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+      }.compact
+    end
+  end
+
