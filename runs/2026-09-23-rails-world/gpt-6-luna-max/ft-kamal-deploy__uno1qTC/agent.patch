--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,46 @@
+<%
+  # Point DNS for this hostname at the server. Kamal also uses it for SSH.
+  app_host = "fizzy.example.com"
+%>
+
+service: fizzy
+asset_path: /rails/public/assets
+
+servers:
+  web:
+    - <%= app_host %>
+
+proxy:
+  ssl: true
+  host: <%= app_host %>
+  forward_headers: true
+
+# Kamal runs a local registry and forwards the image to this single server.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    APP_HOST: <%= app_host %>
+    MAILER_FROM_ADDRESS: "Fizzy <support@<%= app_host %>>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: <%= app_host %>
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    SOLID_QUEUE_IN_PUMA: true
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+volumes:
+  - fizzy:/rails/storage
