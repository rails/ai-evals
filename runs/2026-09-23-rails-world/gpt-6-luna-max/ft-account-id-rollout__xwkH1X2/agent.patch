diff --git a/config/initializers/account_id_associations.rb b/config/initializers/account_id_associations.rb
new file mode 100644
index 0000000..1ca5237
--- /dev/null
+++ b/config/initializers/account_id_associations.rb
@@ -0,0 +1,18 @@
+# These records are owned by an account through their parent record. Keeping the
+# association on the framework models makes account scoping available to imports,
+# exports, and ordinary Active Storage/Action Text writes alike.
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) }
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.account }
+end
