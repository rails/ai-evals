+class AddAccountIdToAccountData < ActiveRecord::Migration[8.2]
+  ACCOUNT_DATA_TABLES = %w[
+    account_cancellations
+    account_imports
+    account_join_codes
+    accesses
+    action_text_rich_texts
+    active_storage_attachments
