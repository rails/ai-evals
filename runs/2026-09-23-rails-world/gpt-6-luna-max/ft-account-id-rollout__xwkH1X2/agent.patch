diff --git a/test/models/account/account_id_schema_test.rb b/test/models/account/account_id_schema_test.rb
new file mode 100644
index 0000000..e3050d0
--- /dev/null
+++ b/test/models/account/account_id_schema_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Account::AccountIdSchemaTest < ActiveSupport::TestCase
+  GLOBAL_TABLES = %w[
+    account_external_id_sequences
+    accounts
+    action_pack_passkeys
+    identity_access_tokens
+    identities
+    magic_links
+    sessions
+    ar_internal_metadata
+    schema_migrations
+  ].freeze
+
+  test "all account-owned tables have a required indexed account_id" do
+    tables = ActiveRecord::Base.connection.tables - GLOBAL_TABLES
+
+    missing_columns = tables.reject do |table|
+      ActiveRecord::Base.connection.column_exists?(table, :account_id)
+    end
+
+    nullable_columns = tables.select do |table|
+      ActiveRecord::Base.connection.column_exists?(table, :account_id) &&
+        ActiveRecord::Base.connection.columns(table).find { |column| column.name == "account_id" }.null
+    end
+
+    unindexed_columns = tables.select do |table|
+      ActiveRecord::Base.connection.column_exists?(table, :account_id) &&
+        ActiveRecord::Base.connection.indexes(table).none? { |index| index.columns.include?("account_id") }
+    end
+
+    assert_empty missing_columns, "Missing account_id on: #{missing_columns.join(', ')}"
+    assert_empty nullable_columns, "Nullable account_id on: #{nullable_columns.join(', ')}"
+    assert_empty unindexed_columns, "Unindexed account_id on: #{unindexed_columns.join(', ')}"
+  end
+end
