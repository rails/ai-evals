+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Current.with_account(account) do
+      Event::RelayJob.perform_later(self)
+    end
+  end
+
+  def relay_now
+    Webhook.active.where(board_id: board_id).find_each do |webhook|
+      if webhook.subscribed_actions.include?(action.to_s)
+        delivery = webhook.deliveries.create_or_find_by!(event_id: id)
+        delivery.deliver_later if delivery.previously_new_record?
+      end
+    end
+  end
+end
