--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,80 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "posts a signed event once and records its response" do
+    stub_dns_resolution("93.184.216.34")
+
+    webhook = webhooks(:active)
+    event = events(:text_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    request = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver_now
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert_equal "completed", delivery.reload.state
+    assert delivery.succeeded?
+    assert_equal({ code: 200, error: nil }, delivery.response_summary)
+    assert_equal event.created_at.utc.iso8601, delivery.request.dig("headers", "X-Webhook-Timestamp")
+    assert_equal Webhook::Delivery::USER_AGENT, delivery.request.dig("headers", "User-Agent")
+    assert_equal "application/json", delivery.request.dig("headers", "Content-Type")
+    assert_not delivery.sanitized_request.dig(:headers).key?("X-Webhook-Signature")
+
+    request_data = WebMock::RequestRegistry.instance.requested_signatures.hash.keys.find { |signature| signature.method == :post }
+    payload = JSON.parse(request_data.body)
+    assert_equal event.id, payload.fetch("id")
+    assert_equal event.action.to_s, payload.fetch("action")
+    eventable_path = URI.parse(payload.dig("eventable", "url")).path
+    assert eventable_path.start_with?(event.account.slug)
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request_data.body),
+      delivery.request.dig("headers", "X-Webhook-Signature")
+  end
+
+  test "records an unsuccessful HTTP response as a failure" do
+    stub_dns_resolution("93.184.216.34")
+
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_request(:post, webhook.url).to_return(status: 503)
+
+    delivery.deliver_now
+
+    assert_equal "completed", delivery.reload.state
+    assert delivery.failed?
+    assert_equal 503, delivery.response_summary[:code]
+    assert_equal 1, webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "records network errors without retrying the POST" do
+    stub_dns_resolution("93.184.216.34")
+
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    request = stub_request(:post, webhook.url).to_timeout
+
+    delivery.deliver_now
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert_equal "errored", delivery.reload.state
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+    assert_equal 1, webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "cleanup removes deliveries older than one week and keeps recent deliveries" do
+    webhook = webhooks(:active)
+    old_delivery = Webhook::Delivery.create!(
+      webhook: webhook, event: events(:text_published), created_at: 8.days.ago
+    )
+    recent_delivery = Webhook::Delivery.create!(
+      webhook: webhook, event: events(:shipping_published), created_at: 6.days.ago
+    )
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
 end
