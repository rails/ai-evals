@@ -1,4 +1,12 @@
+require "net/http"
+require "openssl"
+
 class Webhook::Delivery < ApplicationRecord
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +18,34 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).delete_all
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Webhook::DeliveryJob.perform_later(self)
+    end
+  end
+
+  def deliver_now
+    return unless claim_for_delivery
+
+    result =
+      if webhook.active?
+        begin
+          { code: post_event }
+        rescue StandardError => error
+          Rails.error.report(error, context: { webhook_delivery_id: id })
+          { state: :errored, error: "destination_unreachable" }
+        end
+      else
+        { state: :errored, error: "webhook_inactive", record_result: false }
+      end
+
+    finish_delivery(**result)
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +63,63 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    code = response&.[](:code).to_i
+    completed? && response&.[](:error).blank? && code.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        if pending?
+          update!(state: :in_progress)
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def post_event
+      uri = URI.parse(webhook.url)
+      endpoint_ip = SsrfProtection.resolve_public_ip(uri.host)
+      raise SocketError, "Webhook URL does not resolve to a public IP" if endpoint_ip.nil?
+
+      body = ApplicationController.renderer.new(script_name: event.account.slug).render(
+        template: "webhooks/event",
+        formats: :json,
+        assigns: { event: event }
+      )
+      timestamp = event.created_at.utc.iso8601
+      headers = {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+
+      self.request = { headers: headers }
+      save!
+
+      http_request = Net::HTTP::Post.new(uri.request_uri)
+      headers.each { |name, value| http_request[name] = value }
+      http_request.body = body
+
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.use_ssl = uri.scheme == "https"
+      http.ipaddr = endpoint_ip
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.write_timeout = WRITE_TIMEOUT
+      http.max_retries = 0
+
+      http.start { |connection| connection.request(http_request) }.code.to_i
+    end
+
+    def finish_delivery(code: nil, error: nil, state: :completed, record_result: true)
+      update!(state: state, response: { code: code, error: error })
+
+      if record_result
+        webhook.record_delivery_result!(success: succeeded?)
+      end
+    end
 end
