+    assert_response :success
+    assert_select "h2", text: "Free"
+    assert_select "h2", text: "Unlimited"
+    assert_select "h2", text: "Unlimited+"
+    assert_select "strong", text: "$20/month"
+    assert_select "strong", text: "$25/month"
+    assert_select "p", text: /1,000 cards, 1 GB/
+    assert_select "p", text: /Unlimited cards, 5 GB/
+    assert_select "p", text: /Unlimited cards, 500 GB/
+    assert_select "form button", text: "Upgrade", minimum: 2
+  end
+end
diff --git a/saas/test/controllers/account/checkouts_controller_test.rb b/saas/test/controllers/account/checkouts_controller_test.rb
new file mode 100644
index 0000000..04b4be5
--- /dev/null
+++ b/saas/test/controllers/account/checkouts_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_stripe_env = %w[
+      STRIPE_PRICE_ID_UNLIMITED
+      STRIPE_PRICE_ID_UNLIMITED_PLUS
+      STRIPE_MONTHLY_V1_PRICE_ID
+      STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID
+      STRIPE_SECRET_KEY
+    ].index_with { |key| ENV[key] }
+    @original_stripe_api_key = Stripe.api_key
+  end
+
+  teardown do
+    @original_stripe_env.each do |key, value|
+      ENV[key] = value
+    end
+    Stripe.api_key = @original_stripe_api_key
+  end
+
+  test "checkout redirects to Stripe with the selected paid plan" do
+    sign_in_as :mike
+    ENV["STRIPE_PRICE_ID_UNLIMITED"] = "price_unlimited_test"
+    ENV["STRIPE_SECRET_KEY"] = "sk_test"
+
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      assert_equal "subscription", attributes[:mode]
+      assert_equal [ { price: "price_unlimited_test", quantity: 1 } ], attributes[:line_items]
+      assert_equal accounts(:initech).id, attributes[:metadata][:account_id]
+      assert_equal "unlimited", attributes[:subscription_data][:metadata][:plan_key]
+      true
+    end.returns(Struct.new(:url).new("https://checkout.stripe.test/session"))
+
+    post saas.account_checkout_path(script_name: accounts(:initech).slug), params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  end
+
+  test "Unlimited+ checkout adds the extra storage price to the monthly plan" do
+    sign_in_as :mike
+    ENV.delete("STRIPE_PRICE_ID_UNLIMITED")
+    ENV.delete("STRIPE_PRICE_ID_UNLIMITED_PLUS")
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly_test"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_storage_test"
+    ENV["STRIPE_SECRET_KEY"] = "sk_test"
+
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      assert_equal [
+        { price: "price_monthly_test", quantity: 1 },
+        { price: "price_storage_test", quantity: 1 }
+      ], attributes[:line_items]
+      assert_equal "unlimited_plus", attributes[:metadata][:plan_key]
+      true
+    end.returns(Struct.new(:url).new("https://checkout.stripe.test/unlimited-plus"))
+
+    post saas.account_checkout_path(script_name: accounts(:initech).slug), params: { plan: "unlimited_plus" }
+
+    assert_redirected_to "https://checkout.stripe.test/unlimited-plus"
