+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  test "admins can see the plans and their current plan" do
+    sign_in_as :mike
+
+    get saas.account_billing_path(script_name: accounts(:initech).slug)
