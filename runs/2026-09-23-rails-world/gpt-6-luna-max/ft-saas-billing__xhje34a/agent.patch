diff --git a/saas/app/models/billing/plan.rb b/saas/app/models/billing/plan.rb
new file mode 100644
index 0000000..57ce133
--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,129 @@
+module Billing
+  class Plan
+    DEFINITIONS = {
+      "free" => {
+        name: "Free",
+        monthly_price_cents: 0,
+        card_limit: 1_000,
+        storage_limit: 1.gigabyte
+      },
+      "unlimited" => {
+        name: "Unlimited",
+        monthly_price_cents: 2_000,
+        card_limit: nil,
+        storage_limit: 5.gigabytes
+      },
+      "unlimited_plus" => {
+        name: "Unlimited+",
+        monthly_price_cents: 2_500,
+        card_limit: nil,
+        storage_limit: 500.gigabytes
+      }
+    }.freeze
+
+    attr_reader :key, :name, :monthly_price_cents, :card_limit, :storage_limit
+
+    def self.all
+      DEFINITIONS.keys.map { |key| new(key) }
+    end
+
+    def self.paid
+      all.reject(&:free?)
+    end
+
+    def self.fetch(key)
+      new(key) if DEFINITIONS.key?(key.to_s)
+    end
+
+    def self.free
+      fetch("free")
+    end
+
+    def self.for_stripe_price_id(price_id)
+      for_stripe_price_ids([ price_id ])
+    end
+
+    def self.for_stripe_price_ids(price_ids)
+      ids = Array(price_ids).compact
+      paid.reverse_each.find { |plan| (plan.stripe_marker_price_ids & ids).any? }
+    end
+
+    def initialize(key)
+      @key = key.to_s
+      definition = DEFINITIONS.fetch(@key)
+      @name = definition.fetch(:name)
+      @monthly_price_cents = definition.fetch(:monthly_price_cents)
+      @card_limit = definition.fetch(:card_limit)
+      @storage_limit = definition.fetch(:storage_limit)
+    end
+
+    def free?
+      key == "free"
+    end
+
+    def paid?
+      !free?
+    end
+
+    def unlimited_cards?
+      card_limit.nil?
+    end
+
+    def stripe_price_ids
+      if key == "unlimited"
+        [ unlimited_price_id ].compact
+      elsif key == "unlimited_plus"
+        if standalone_unlimited_plus_price_id.present?
+          [ standalone_unlimited_plus_price_id ]
+        else
+          [ unlimited_price_id, ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ].compact
+        end
+      else
+        []
+      end
+    end
+
+    def stripe_marker_price_ids
+      if key == "unlimited"
+        [ unlimited_price_id ].compact
+      elsif key == "unlimited_plus"
+        [ standalone_unlimited_plus_price_id || ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ].compact
+      else
+        []
+      end
+    end
+
+    def checkout_line_items
+      stripe_price_ids.map { |price_id| { price: price_id, quantity: 1 } }
+    end
+
+    def checkout_available?
+      if key == "unlimited_plus" && standalone_unlimited_plus_price_id.blank?
+        unlimited_price_id.present? && ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].present?
+      else
+        stripe_price_ids.one?
+      end
+    end
+
+    def stripe_price_id
+      stripe_price_ids.first
+    end
+
+    def monthly_price
+      monthly_price_cents / 100.0
+    end
+
+    def to_param
+      key
+    end
+
+    private
+      def unlimited_price_id
+        ENV["STRIPE_PRICE_ID_UNLIMITED"].presence || ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      end
+
+      def standalone_unlimited_plus_price_id
+        ENV["STRIPE_PRICE_ID_UNLIMITED_PLUS"]
+      end
+  end
+end
diff --git a/saas/app/views/account/billings/show.html.erb b/saas/app/views/account/billings/show.html.erb
