diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..84ed7a2
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_stripe_env = %w[
+      STRIPE_WEBHOOK_SECRET
+      STRIPE_PRICE_ID_UNLIMITED_PLUS
+      STRIPE_MONTHLY_V1_PRICE_ID
+      STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID
+    ].index_with { |key| ENV[key] }
+  end
+
+  teardown do
+    @original_stripe_env.each do |key, value|
+      ENV[key] = value
+    end
+  end
+
+  test "subscription webhooks update the account plan and storage allowance" do
+    account = accounts(:initech)
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    ENV["STRIPE_PRICE_ID_UNLIMITED_PLUS"] = "price_plus_test"
+
+    event = {
+      type: "customer.subscription.updated",
+      data: { object: {
+        id: "sub_test",
+        customer: "cus_test",
+        status: "active",
+        current_period_end: 1.hour.from_now.to_i,
+        cancel_at: nil,
+        metadata: { account_id: account.id, plan_key: "unlimited" },
+        items: { data: [ { price: { id: "price_plus_test" } } ] }
+      } }
+    }
+    Stripe::Webhook.expects(:construct_event).with(anything, "sig_test", "whsec_test").returns(event)
+
+    post_webhook
+
+    assert_response :ok
+    assert_equal "Unlimited+", account.reload.plan
+    assert_equal "sub_test", account.subscription.stripe_subscription_id
+    assert_equal "cus_test", account.subscription.stripe_customer_id
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "legacy base and extra storage prices identify Unlimited+" do
+    account = accounts(:initech)
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly_test"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_storage_test"
+    event = {
+      type: "customer.subscription.updated",
+      data: { object: {
+        id: "sub_legacy",
+        customer: "cus_legacy",
+        status: "active",
+        metadata: { account_id: account.id },
+        items: { data: [
+          { price: { id: "price_monthly_test" } },
+          { price: { id: "price_storage_test" } }
+        ] }
+      } }
+    }
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+
+    post_webhook
+
+    assert_response :ok
+    assert_equal "Unlimited+", account.reload.plan
+  end
+
+  test "checkout completion associates the Stripe customer and chosen plan" do
+    account = accounts(:initech)
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    event = {
+      type: "checkout.session.completed",
+      data: { object: {
+        client_reference_id: account.id,
+        customer: "cus_checkout",
+        subscription: "sub_checkout",
+        payment_status: "paid",
+        metadata: { plan_key: "unlimited" }
+      } }
+    }
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+
+    post_webhook
+
+    assert_response :ok
+    assert_equal "Unlimited", account.reload.plan
+    assert_equal "cus_checkout", account.subscription.stripe_customer_id
+    assert_equal "sub_checkout", account.subscription.stripe_subscription_id
+  end
+
+  test "a deleted Stripe subscription returns the account to Free" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_test", stripe_subscription_id: "sub_test")
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    event = {
+      type: "customer.subscription.deleted",
+      data: { object: {
+        id: "sub_test",
+        customer: "cus_test",
+        status: "canceled",
+        metadata: { account_id: account.id, plan_key: "unlimited" }
+      } }
+    }
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+
+    post_webhook
+
+    assert_response :ok
+    assert_equal "Free", account.reload.plan
+    assert_equal "canceled", account.subscription.status
+  end
+
+  test "invalid webhook signatures are rejected" do
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    Stripe::Webhook.stubs(:construct_event).raises(Stripe::SignatureVerificationError)
+
+    post_webhook
+
+    assert_response :bad_request
+  end
+
+  test "an unknown webhook event is acknowledged without changing the account" do
+    account = accounts(:initech)
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    Stripe::Webhook.stubs(:construct_event).returns(type: "customer.created", data: { object: {} })
+
+    post_webhook
+
+    assert_response :ok
+    assert_equal "Free", account.reload.plan
+  end
+
+  private
+    def post_webhook
+      untenanted do
+        post saas.stripe_webhooks_path, params: "{}", headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => "sig_test"
+        }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..4d0bcec
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "the published plans have the approved prices and allowances" do
+    free, unlimited, unlimited_plus = Billing::Plan.all
+
+    assert_equal [ "Free", 0, 1_000, 1.gigabyte ], [ free.name, free.monthly_price_cents, free.card_limit, free.storage_limit ]
+    assert_equal [ "Unlimited", 2_000, nil, 5.gigabytes ], [ unlimited.name, unlimited.monthly_price_cents, unlimited.card_limit, unlimited.storage_limit ]
+    assert_equal [ "Unlimited+", 2_500, nil, 500.gigabytes ], [ unlimited_plus.name, unlimited_plus.monthly_price_cents, unlimited_plus.card_limit, unlimited_plus.storage_limit ]
+  end
+
+  test "accounts start on Free" do
+    assert_equal "Free", @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "an active subscription sets the account plan and storage allowance" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_unlimited")
+
+    assert_equal "Unlimited", @account.plan
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "Unlimited+ has its own storage allowance" do
+    @account.create_subscription!(plan_key: "unlimited_plus", status: "trialing", stripe_customer_id: "cus_plus")
+
+    assert_equal "Unlimited+", @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "an inactive subscription falls back to Free" do
+    @account.create_subscription!(plan_key: "unlimited", status: "canceled", stripe_customer_id: "cus_canceled")
+
+    assert_equal "Free", @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comping grants Unlimited+ until the waiver is removed" do
+    assert_difference -> { Account::BillingWaiver.count } do
+      @account.comped = true
+    end
+
+    assert @account.comped?
+    assert_equal "Unlimited+", @account.plan
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp!
+    end
+
+    @account.comped = false
+
+    assert_not @account.comped?
+    assert_equal "Free", @account.plan
+  end
+
+  test "usage overrides affect card and storage usage and reset cleanly" do
+    cards_used = @account.cards.published.count
+    @account.create_overridden_limit!(card_count: 950, bytes_used: 123_456)
+
+    assert_equal 950, @account.cards_used
+    assert_equal 50, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+    assert @account.nearing_card_limit?
+    assert_equal 123_456, @account.bytes_used
+
+    @account.overridden_limit.destroy!
+
+    assert_equal cards_used, @account.cards_used
+    assert_equal 0, @account.bytes_used
+    assert_equal @account.cards.published.count >= 1_000, @account.exceeding_card_limit?
+  end
+
+  test "a zero usage override is honored" do
+    @account.create_overridden_limit!(card_count: 0, bytes_used: 0)
+
+    assert_equal 0, @account.cards_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "draft cards don't use the Free card allowance until published" do
+    board = boards(:miltons_wish_list)
+    @account.update_column(:cards_count, 100)
+    published_before = @account.cards.published.count
+
+    Current.set(account: @account, user: users(:mike)) do
+      card = board.cards.create!(creator: users(:mike), title: "A draft", status: "drafted")
+      assert_equal published_before, @account.cards_used
+
+      card.update_column(:status, "published")
+      assert_equal published_before + 1, @account.cards_used
+    end
+  end
+
+  test "Free accounts receive a warning for the final 100 cards" do
+    override = @account.create_overridden_limit!(card_count: 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    override.update!(card_count: 899)
+    assert_not @account.nearing_card_limit?
+
+    override.update!(card_count: 1_000)
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+  end
+end
