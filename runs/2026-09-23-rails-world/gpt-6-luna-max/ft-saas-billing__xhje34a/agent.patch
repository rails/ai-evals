diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..ab64405
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,111 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthorized_access
+  skip_before_action :require_authentication
+  skip_forgery_protection
+
+  def create
+    return head :bad_request if webhook_secret.blank?
+
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], webhook_secret)
+  rescue Stripe::SignatureVerificationError, JSON::ParserError, ArgumentError
+    head :bad_request
+  else
+    process_event(event)
+    head :ok
+  end
+
+  private
+    def process_event(event)
+      type = value(event, :type)
+      object = value(value(event, :data), :object)
+
+      case type
+      when "checkout.session.completed"
+        synchronize_checkout(object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        synchronize_subscription(object)
+      end
+    end
+
+    def synchronize_checkout(object)
+      payment_status = value(object, :payment_status)
+      return if payment_status.present? && !payment_status.in?(%w[ paid no_payment_required ])
+
+      account = account_for(object)
+      return unless account
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_customer_id = value(object, :customer) if value(object, :customer).present?
+      subscription.stripe_subscription_id = value(object, :subscription) if value(object, :subscription).present?
+
+      if plan = plan_for(object)
+        subscription.plan_key = plan.key
+      end
+
+      subscription.status = "active" if payment_status.in?(%w[ paid no_payment_required ])
+      subscription.save!
+    end
+
+    def synchronize_subscription(object)
+      account = account_for(object)
+      return unless account
+
+      subscription_id = value(object, :id)
+      subscription = account.subscription || account.build_subscription
+
+      if subscription.stripe_subscription_id.present? && subscription.stripe_subscription_id != subscription_id
+        return if value(object, :status) == "canceled"
+      end
+
+      subscription.stripe_customer_id = value(object, :customer) if value(object, :customer).present?
+      subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+
+      if plan = plan_for(object)
+        subscription.plan_key = plan.key
+      end
+
+      subscription.status = value(object, :status) if value(object, :status).present?
+      subscription.current_period_end = timestamp(value(object, :current_period_end))
+      subscription.cancel_at = timestamp(value(object, :cancel_at))
+      subscription.save!
+    end
+
+    def account_for(object)
+      metadata = value(object, :metadata)
+      account_id = value(metadata, :account_id) || value(object, :client_reference_id)
+      account = Account.find_by(id: account_id) if account_id.present?
+
+      if account.nil? && (customer_id = value(object, :customer)).present?
+        account = Account::Subscription.find_by(stripe_customer_id: customer_id)&.account
+      end
+
+      account
+    end
+
+    def plan_for(object)
+      plan = Billing::Plan.for_stripe_price_ids(stripe_price_ids(object))
+      plan || Billing::Plan.fetch(value(value(object, :metadata), :plan_key))
+    end
+
+    def stripe_price_ids(object)
+      items = value(value(object, :items), :data)
+      Array(items).filter_map { |item| value(value(item, :price), :id) }
+    end
+
+    def timestamp(value)
+      Time.zone.at(value.to_i) if value.present?
+    end
+
+    def value(object, key)
+      if object.respond_to?(:[])
+        object[key.to_s] || object[key.to_sym]
+      elsif object.respond_to?(key)
+        object.public_send(key)
+      end
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..a8bad51
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,85 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active?
+      Billing::Plan.fetch(subscription.plan_key) || Billing::Plan.free
+    elsif comped?
+      Billing::Plan.fetch("unlimited_plus")
+    else
+      Billing::Plan.free
+    end
+  end
+
+  def plan
+    billing_plan.name
+  end
+
+  def plan_key
+    billing_plan.key
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present? && !billing_waiver.destroyed?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      comp!
+    else
+      uncomp!
+    end
+  end
+
+  def comp!
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp!
+    if billing_waiver
+      billing_waiver.destroy!
+      association(:billing_waiver).reset
+    end
+  end
+
+  def reset_overridden_limit!
+    if overridden_limit
+      overridden_limit.destroy!
+      association(:overridden_limit).reset
+    end
+  end
+
+  def cards_used
+    if overridden_limit && !overridden_limit.destroyed? && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      cards.published.count
+    end
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_remaining
+    card_limit ? [ card_limit - cards_used, 0 ].max : nil
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    cards_remaining.present? && cards_remaining.between?(1, 100)
+  end
+end
