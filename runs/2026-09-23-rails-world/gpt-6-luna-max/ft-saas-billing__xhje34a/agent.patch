index 0000000..6bfd2ac
--- /dev/null
+++ b/saas/app/controllers/account/checkouts_controller.rb
@@ -0,0 +1,47 @@
+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    @plan = Billing::Plan.fetch(params[:plan])
+
+    if @plan.nil? || !@plan.paid?
+      redirect_to Fizzy::Saas::Engine.routes.url_helpers.account_billing_path(script_name: request.script_name), alert: "Choose a paid plan to continue."
+    elsif Current.account.active_subscription
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+      session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.subscription.stripe_customer_id,
+        return_url: main_app.account_settings_url(host: request.host, protocol: request.protocol)
+      )
+      redirect_to session.url, allow_other_host: true
+    elsif !@plan.checkout_available?
+      redirect_to Fizzy::Saas::Engine.routes.url_helpers.account_billing_path(script_name: request.script_name), alert: "This plan is not available for checkout yet."
+    else
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+      session = Stripe::Checkout::Session.create(checkout_session_attributes)
+      redirect_to session.url, allow_other_host: true
+    end
+  rescue Stripe::StripeError
+    redirect_to Fizzy::Saas::Engine.routes.url_helpers.account_billing_path(script_name: request.script_name), alert: "We couldn't start checkout. Please try again."
+  end
+
+  private
+    def checkout_session_attributes
+      attributes = {
+        mode: "subscription",
+        line_items: @plan.checkout_line_items,
+        success_url: main_app.account_settings_url(host: request.host, protocol: request.protocol),
+        cancel_url: Fizzy::Saas::Engine.routes.url_helpers.account_billing_url(script_name: request.script_name, host: request.host, protocol: request.protocol),
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: @plan.key },
+        subscription_data: { metadata: { account_id: Current.account.id, plan_key: @plan.key } }
+      }
+
+      if customer_id = Current.account.subscription&.stripe_customer_id
+        attributes[:customer] = customer_id
+      elsif Current.account.owner_email.present?
+        attributes[:customer_email] = Current.account.owner_email
+      end
+
+      attributes
+    end
+end
