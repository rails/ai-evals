+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list account links and open an account" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(accounts(:initech))}']", text: "Initech LLC"
+
+      get saas.admin_account_path(accounts(:initech))
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value='Override']"
+    assert_select "button", text: "Reset"
+  end
+
+  test "support can comp and uncomp an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(account)
+      assert_response :redirect
+      assert account.reload.comped?
+
+      get saas.admin_account_path(account)
+      assert_response :success
+      assert_select "button", text: "Uncomp"
+
+      delete saas.admin_account_billing_waiver_path(account)
+    end
+
+    assert_response :redirect
+    assert_not account.reload.comped?
+  end
+
+  test "support can override and reset card and storage usage" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account), params: {
+        account_overridden_limit: { card_count: "950", bytes_used: "123456" }
+      }
+    end
+
+    assert_response :redirect
+    assert_equal 950, account.reload.cards_used
+    assert_equal 123_456, account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account)
+    end
+
+    assert_response :redirect
+    assert_nil account.reload.overridden_limit
+  end
+
+  test "invalid usage overrides are rejected" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account), params: {
+        account_overridden_limit: { card_count: "-1", bytes_used: "-1" }
+      }
+    end
+
+    assert_response :unprocessable_entity
+    assert_select ".txt-negative", text: /greater than or equal to 0/
+    assert_nil account.reload.overridden_limit
+  end
+
+  test "non-staff cannot access account support tools" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..9e42ca3
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  test "drafts can still be created through HTML after the Free card limit" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.update_column(:cards_count, 100)
+    account.create_overridden_limit!(card_count: 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "creating a published card through the API is refused at the Free limit" do
+    sign_in_as :mike
+    accounts(:initech).create_overridden_limit!(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Over the limit" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "creating a published card is allowed while one Free card remains" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.update_column(:cards_count, 100)
+    account.create_overridden_limit!(card_count: 999)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: account.slug),
+        params: { card: { title: "The 1,000th card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "publishing a draft is refused at the Free limit" do
+    sign_in_as :mike
+    accounts(:initech).create_overridden_limit!(card_count: 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "a paid plan can publish beyond the Free card limit" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.create_overridden_limit!(card_count: 1_000)
+    account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_paid")
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "staff can publish beyond the Free card limit" do
+    sign_in_as :mike
+    accounts(:initech).create_overridden_limit!(card_count: 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "the card draft warning counts down for the final 100 Free cards" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.create_overridden_limit!(card_count: 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "50 cards left"
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "card creation buttons become an Upgrade pitch at the Free limit" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.create_overridden_limit!(card_count: 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "admins see their current plan and Upgrade in account settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings__section--billing" do
+      assert_select "strong", text: "Free"
+      assert_select "a", text: "Upgrade"
+    end
+  end
+end
