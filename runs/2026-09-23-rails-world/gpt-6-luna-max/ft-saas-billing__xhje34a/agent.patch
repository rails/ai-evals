+<% @page_title = "Billing" %>
+
+<h1><%= @page_title %></h1>
+<p>Current plan: <strong><%= @account.plan %></strong></p>
+
+<% if @account.comped? %>
+  <p>This account has a billing waiver.</p>
+<% end %>
+
+<% if @account.active_subscription %>
+  <div class="margin-block-end">
+    <%= button_to "Upgrade", saas.account_customer_portal_path, class: "btn" %>
+  </div>
+<% end %>
+
+<div class="flex flex-column gap">
+  <% @plans.each do |plan| %>
+    <section class="panel shadow padding">
+      <h2><%= plan.name %></h2>
+      <p>
+        <strong><%= plan.free? ? "Free" : "$#{plan.monthly_price_cents / 100}/month" %></strong>
+      </p>
+      <p>
+        <%= plan.card_limit ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards" %>,
+        <%= number_to_human_size(plan.storage_limit) %>
+      </p>
+
+      <% if @account.billing_plan.key == plan.key %>
+        <p>Current plan</p>
+      <% elsif plan.paid? && !@account.comped? && !@account.active_subscription %>
+        <%= button_to "Upgrade", saas.account_checkout_path(plan: plan.key), class: "btn" %>
+      <% end %>
+    </section>
+  <% end %>
+</div>
