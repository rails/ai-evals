new file mode 100644
index 0000000..feb694e
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,35 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  before_validation :strip_content
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  def emoji?
+    content.present? && content.match?(/\A(?:[\p{Extended_Pictographic}\p{Regional_Indicator}\p{Emoji_Presentation}\p{Emoji_Modifier}\uFE0E\uFE0F\u200D\u20E3]|[0-9#*]\uFE0F?\u20E3)+\z/)
+  end
+
+  private
+    def strip_content
+      self.content = content.strip if content
+    end
+
+    def broadcast_creation
+      broadcast_append_later_to comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+        partial: "cards/comments/reaction",
+        locals: { reaction: self }
+    end
+
+    def broadcast_removal
+      if Comment.exists?(comment_id)
+        broadcast_remove_to comment.card, target: ActionView::RecordIdentifier.dom_id(self)
+      end
+    end
+end
