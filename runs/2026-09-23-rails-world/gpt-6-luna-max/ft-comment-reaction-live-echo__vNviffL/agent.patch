+++ b/test/models/reaction_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "strips whitespace from reaction content" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "  Looks good  ", creator: users(:kevin))
+
+    assert_equal "Looks good", reaction.content
+  end
+
+  test "reaction content is limited to 16 characters" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "x" * 17, creator: users(:kevin))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "does not save blank reaction content" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "   ", creator: users(:kevin))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "broadcasts a new reaction to viewers of its card" do
+    comment = comments(:logo_agreement_jz)
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts comment.card, count: 1 do
+        comment.reactions.create!(content: "🙌", creator: users(:kevin))
+      end
+    end
+  end
+
+  test "broadcasts reaction removal to viewers of its card" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "Nice", creator: users(:kevin))
+
+    assert_turbo_stream_broadcasts comment.card, count: 1 do
+      reaction.destroy!
+    end
+  end
+
+  test "identifies emoji-only reactions for styling" do
+    assert Reaction.new(content: "❤️").emoji?
+    assert Reaction.new(content: "🇺🇸").emoji?
+    assert_not Reaction.new(content: "Looks good").emoji?
+    assert_not Reaction.new(content: "1").emoji?
+  end
+end
