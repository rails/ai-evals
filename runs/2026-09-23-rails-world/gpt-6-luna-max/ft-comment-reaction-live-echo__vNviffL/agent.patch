diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..a122c52
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,49 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, script_name: @card.account.slug) }
+      format.json { render json: { id: @reaction.id, content: @reaction.content }, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream { render turbo_stream: turbo_stream.remove(@reaction) }
+      format.html { redirect_to card_path(@card, script_name: @card.account.slug) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_creatorship
+      head :forbidden unless Current.user == @reaction.creator
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..8335fce
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,28 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    this.owned = this.element.dataset.creatorId === window.Current?.user?.id
+
+    if (this.owned) {
+      this.element.classList.add("reaction--deleteable")
+      this.toggleTarget.tabIndex = 0
+      this.toggleTarget.setAttribute("aria-disabled", "false")
+      this.toggleTarget.setAttribute("aria-label", `Your reaction: ${this.toggleTarget.dataset.reactionContent}. Show removal option`)
+    } else {
+      this.toggleTarget.tabIndex = -1
+      this.element.querySelector(".reaction__delete-form")?.remove()
+    }
+  }
+
+  toggle(event) {
+    if (this.owned) {
+      const expanded = this.element.classList.toggle("expanded")
+      event.currentTarget.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  get toggleTarget() {
+    return this.element.querySelector(".reaction__form-label")
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..3d5d410
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,25 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  close(event) {
+    event?.preventDefault()
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  submitEnd(event) {
+    if (event.detail.success) this.close()
+  }
+}
