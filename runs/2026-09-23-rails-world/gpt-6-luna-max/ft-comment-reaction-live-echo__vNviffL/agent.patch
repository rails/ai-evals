+class CommentReactionsTest < ApplicationSystemTestCase
+  test "adding, cancelling, and removing reactions" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "Nice", creator: users(:kevin))
+
+    sign_in_as users(:kevin)
+    visit card_path(comment.card)
+
+    within "#reactions_comment_#{comment.id}" do
+      find(".reactions__trigger").click
+      find("input.reaction__input", visible: true).set("draft")
+      find("button.reaction__cancel-btn", visible: true).click
+      assert_no_selector "input.reaction__input", visible: true
+      assert_selector ".reactions__trigger", visible: true
+
+      find("button.reaction__form-label").click
+      assert_selector "form.reaction__delete-form button.reaction__delete", visible: true
+    end
+
+    assert_selector "#reaction_#{reaction.id}.reaction--deleteable"
+
+    within "#reactions_comment_#{comment.id}" do
