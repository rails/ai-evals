+      find("input.reaction__input", visible: true).set("Great")
+      find("button.reaction__submit-btn", visible: true).click
+      assert_text "Great"
+      assert_selector ".reactions__trigger", visible: true
+    end
+
+    within "#reactions_comment_#{comment.id} .reaction", text: "Great" do
+      find("button.reaction__form-label").click
+      find("button.reaction__delete", visible: true).click
+    end
+
+    assert_no_text "Great"
+  end
