index 0000000..df2bcc8
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class CardsCommentReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "creates a reaction as the signed-in user" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "🙌" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal "🙌", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.creator
+  end
+
+  test "deletes your own reaction" do
+    reaction = @comment.reactions.create!(content: "Nice", creator: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "cannot delete someone else's reaction" do
+    reaction = @comment.reactions.create!(content: "Nice", creator: users(:jz))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "reaction forms are rendered with the shipped icon and character limit" do
+    emoji_reaction = @comment.reactions.create!(content: "❤️", creator: users(:jz))
+    get card_path(@comment.card)
+
+    assert_response :success
+    assert_select "#reactions_comment_#{@comment.id}"
+    assert_select "#reactions_list_comment_#{@comment.id}[role=list]"
+    assert_select ".reactions__trigger img[src*=boost-color]"
+    assert_select "#reaction_#{emoji_reaction.id} span.txt-small.txt-medium", text: "❤️"
+    assert_select "form[action*=reactions] input[name=\"reaction[content]\"][maxlength=16][required]"
+  end
+
+  test "does not accept reactions longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "x" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
