diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..0a67f52
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,60 @@
+module Cards
+  module Comments
+    class ReactionsController < ApplicationController
+      include CardScoped
+
+      before_action :set_comment
+      before_action :set_reaction, only: :destroy
+      before_action :ensure_reactership, only: :destroy
+
+      def index
+        @reactions = @comment.reactions
+
+        respond_to do |format|
+          format.json
+        end
+      end
+
+      def create
+        @reaction = @comment.reactions.new(reaction_params)
+        @reaction.reacter = Current.user
+
+        respond_to do |format|
+          if @reaction.save
+            format.turbo_stream { render :create, status: :created }
+            format.json { render :show, status: :created, location: card_comment_reaction_url(@card, @comment, @reaction, format: :json) }
+          else
+            format.turbo_stream { render :create, status: :unprocessable_entity }
+            format.json { render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity }
+          end
+        end
+      end
+
+      def destroy
+        @reaction.destroy
+
+        respond_to do |format|
+          format.turbo_stream
+          format.json { head :no_content }
+        end
+      end
+
+      private
+        def set_comment
+          @comment = @card.comments.find(params[:comment_id])
+        end
+
+        def set_reaction
+          @reaction = @comment.reactions.find(params[:id])
+        end
+
+        def ensure_reactership
+          head :forbidden unless @reaction.reacter_id == Current.user.id
+        end
+
+        def reaction_params
+          params.expect(reaction: [ :content ])
+        end
+    end
+  end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..a52deb9
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,51 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "reaction", "trigger" ]
+  static values = { currentUserId: String }
+
+  reactionTargetConnected(reaction) {
+    const isMine = reaction.dataset.reacterId === this.currentUserIdValue
+    const toggle = reaction.querySelector(".reaction__toggle")
+    const removeForm = reaction.querySelector("form")
+
+    reaction.classList.toggle("reaction--deleteable", isMine)
+    toggle.disabled = !isMine
+    removeForm.hidden = !isMine
+  }
+
+  open(event) {
+    event.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event.preventDefault()
+    this.closeForm()
+  }
+
+  toggle(event) {
+    const reaction = event.currentTarget.closest(".reaction")
+
+    if (reaction.classList.contains("reaction--deleteable")) {
+      const expanded = reaction.classList.toggle("expanded")
+      event.currentTarget.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  afterSubmit(event) {
+    if (event.detail.success) this.closeForm()
+  }
+
+  closeForm() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+    this.inputTarget.value = ""
+    this.element.querySelector(".reactions__error").textContent = ""
+  }
+}
