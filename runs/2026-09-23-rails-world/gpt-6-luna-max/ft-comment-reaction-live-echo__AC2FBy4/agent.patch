+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "reaction content is limited to 16 characters" do
+    assert @comment.reactions.new(content: "x" * 16, reacter: users(:kevin)).valid?
+    assert @comment.reactions.new(content: "👍" * 16, reacter: users(:kevin)).valid?
+    assert_not @comment.reactions.new(content: "x" * 17, reacter: users(:kevin)).valid?
+  end
+
+  test "reaction content cannot be blank" do
+    assert_not @comment.reactions.new(content: " ", reacter: users(:kevin)).valid?
+  end
+
+  test "a reaction must belong to the same account as the comment" do
+    reaction = @comment.reactions.new(content: "👍", reacter: users(:mike))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:reacter], "must belong to the same account as the comment"
+  end
+
+  test "creating a reaction broadcasts the updated list to card viewers" do
+    perform_enqueued_jobs do
+      @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    end
+
+    assert_turbo_stream_broadcasts cards(:logo)
+  end
+
+  test "destroying a reaction broadcasts the updated list to card viewers" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+      reaction.destroy!
+    end
+
+    assert_turbo_stream_broadcasts cards(:logo)
+  end
+end
