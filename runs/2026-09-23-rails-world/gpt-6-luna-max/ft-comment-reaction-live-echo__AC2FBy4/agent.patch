--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,35 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :reacter_belongs_to_comment_account
+  validate :comment_is_reactable
+
+  after_commit :broadcast_reaction_list_later, on: [ :create, :destroy ]
+
+  def to_partial_path
+    "cards/comments/reaction"
+  end
+
+  private
+    def reacter_belongs_to_comment_account
+      if reacter && comment && reacter.account_id != comment.account_id
+        errors.add(:reacter, "must belong to the same account as the comment")
+      end
+    end
+
+    def comment_is_reactable
+      errors.add(:comment, "does not allow reactions") unless comment&.card&.commentable?
+    end
+
+    def broadcast_reaction_list_later
+      if comment&.persisted?
+        broadcast_replace_later_to comment.card,
+          target: ActionView::RecordIdentifier.dom_id(comment, :reaction_list),
+          partial: "cards/comments/reaction_list",
+          locals: { comment: comment, reaction: nil }
+      end
+    end
+end
