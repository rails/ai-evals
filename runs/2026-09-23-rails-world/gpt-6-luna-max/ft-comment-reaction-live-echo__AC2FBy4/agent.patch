+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "add and remove a reaction from a comment" do
+    visit card_url(@comment.card)
+
+    within "##{dom_id(@comment, :container)}" do
+      click_button "Add a reaction"
+      find(".reaction__input").set "Great 👍"
+      find(".reaction__submit-btn").click
+
+      assert_text "Great 👍", wait: 5
+      find(".reaction__toggle", text: "Great 👍").click
+      click_button "Remove your reaction"
+      assert_no_text "Great 👍", wait: 5
+    end
+  end
+
+  test "canceling a reaction returns to the add button" do
+    reaction_count = @comment.reactions.count
+    visit card_url(@comment.card)
+
+    within "##{dom_id(@comment, :container)}" do
+      click_button "Add a reaction"
+      find(".reaction__input").set "Never mind"
+      find(".reaction__cancel-btn").click
+
+      assert_selector ".reactions__trigger", visible: true
+      assert_no_selector ".reaction__form:not([hidden])"
+      assert_no_text "Never mind"
+    end
+
+    assert_equal reaction_count, @comment.reactions.count
+  end
+
+  test "reaction broadcasts appear without reloading the card" do
+    visit card_url(@comment.card)
+    wait_for_cable_subscriptions
+
+    @comment.reactions.create!(content: "Landed 🎉", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+
+    within "##{dom_id(@comment, :container)}" do
+      assert_text "Landed 🎉", wait: 5
+      assert find(".reaction", text: "Landed 🎉").find(".reaction__toggle").disabled?
+      assert_selector ".reaction form[hidden]", visible: :all
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
