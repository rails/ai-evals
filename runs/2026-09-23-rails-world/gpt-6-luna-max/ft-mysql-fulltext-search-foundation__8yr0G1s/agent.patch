diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..797c056
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "finds cards by title, description, or comment body, newest first, with highlighted matches" do
+    title_card = create_search_card(title: "A needle in the title", created_at: 3.hours.ago)
+    description_card = create_search_card(title: "Description match", description: "A needle in the description", created_at: 2.hours.ago)
+    comment_card = create_search_card(title: "Comment match", created_at: 1.hour.ago)
+    comment_card.comments.create!(creator: users(:kevin), body: "A needle in a comment")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title" do |links|
+      assert_equal [ comment_card, description_card, title_card ].map { card_path(it) }, links.map { it["href"] }
+    end
+    assert_select ".search-result__title mark", text: "needle", count: 1
+    assert_select ".search-result__description mark", text: "needle", count: 1
+    assert_select ".search-result__comment mark", text: "needle", count: 1
+  end
+
+  test "search results immediately respect current board access" do
+    card = create_search_card(title: "A private needle")
+    board = card.board
+    board.update!(all_access: false)
+    board.accesses.revoke_from users(:jz)
+
+    logout_and_sign_in_as :jz
+    Current.user = users(:jz)
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title", count: 0
+  end
+
+  test "draft cards and their comments are excluded" do
+    card = create_search_card(title: "A private draft")
+    card.comments.create!(creator: users(:kevin), body: "A private needle comment")
+    card.update_column(:status, "drafted")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title", count: 0
+    assert_no_match "private needle comment", response.body
+  end
+
+  test "blank searches do not return all cards" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result__title", count: 0
+  end
+
+  test "wildcard characters in the query are searched literally" do
+    literal_match = create_search_card(title: "A 100% match")
+    create_search_card(title: "A 100 percent match")
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search-result__title" do |links|
+      assert_equal [ card_path(literal_match) ], links.map { it["href"] }
+    end
+    assert_select ".search-result__title mark", text: "%"
+  end
+
+  test "highlighting does not render user text as HTML" do
+    card = create_search_card(title: "needle <script>alert('xss')</script>")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title[href=?] script", card_path(card), count: 0
+    assert_select ".search-result__title[href=?] mark", card_path(card), text: "needle"
+  end
+
+  private
+    def create_search_card(title:, description: nil, created_at: Time.current)
+      boards(:writebook).cards.create!(
+        creator: users(:kevin),
+        title: title,
+        description: description,
+        status: :published,
+        created_at: created_at
+      )
+    end
+end
