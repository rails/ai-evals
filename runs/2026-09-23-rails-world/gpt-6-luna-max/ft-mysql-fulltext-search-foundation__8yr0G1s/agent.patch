@@ -0,0 +1,27 @@
+class SearchController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    set_page_and_extract_portion_from search_results
+    @matching_comments = matching_comments
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards
+        .where(cards: { account_id: Current.account.id })
+        .published
+        .search(@query)
+        .distinct
+        .reverse_chronologically
+        .preload(:board, :rich_text_description)
+    end
+
+    def matching_comments
+      Comment.search(@query)
+        .where(card_id: @page.records.map(&:id))
+        .preload(:rich_text_body)
+        .order(created_at: :desc, id: :desc)
+        .group_by(&:card_id)
+    end
+end
