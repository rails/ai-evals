diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..a2c05c3
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_time_tag sends an ISO 8601 UTC timestamp for client formatting" do
+    timestamp = ActiveSupport::TimeZone["America/Los_Angeles"].parse("2025-09-12 13:42:00")
+    raw_timestamp = timestamp.utc.iso8601
+
+    assert_select parse(local_time_tag(timestamp, format: :friendly)),
+      "time[datetime='#{raw_timestamp}'][data-controller='local-time'][data-local-time-format-value='friendly']",
+      text: raw_timestamp
+  end
+
+  test "local_date_tag sends the calendar date without a server-formatted label" do
+    raw_date = "2025-09-12"
+
+    assert_select parse(local_date_tag(Date.iso8601(raw_date))),
+      "time[datetime='#{raw_date}'][data-controller='local-time'][data-local-time-format-value='long_date']",
+      text: raw_date
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..f0b7b1d
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,38 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "formats raw timestamps in the browser's local calendar" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:layout))
+
+    page.execute_script <<~JS
+      function addLocalTime(id, daysFromToday, hour, minute) {
+        const timestamp = new Date()
+        timestamp.setDate(timestamp.getDate() + daysFromToday)
+        timestamp.setHours(hour, minute, 0, 0)
+
+        const time = document.createElement("time")
+        time.id = id
+        time.dateTime = timestamp.toISOString()
+        time.dataset.controller = "local-time"
+        time.dataset.localTimeFormatValue = "friendly"
+        time.textContent = time.dateTime
+        document.body.append(time)
+      }
+
+      addLocalTime("local-time-today", 0, 13, 42)
+      addLocalTime("local-time-yesterday", -1, 23, 42)
+      addLocalTime("local-time-five-days-ago", -5, 12, 0)
+      addLocalTime("local-time-older-date", -8, 12, 0)
+      addLocalTime("local-time-tomorrow", 1, 12, 0)
+      addLocalTime("local-time-three-days", 3, 12, 0)
+    JS
+
+    assert_selector "#local-time-today", text: "1:42 PM"
+    assert_selector "#local-time-yesterday", text: "yesterday"
+    assert_selector "#local-time-five-days-ago", text: "5 days ago"
+    assert_selector "#local-time-older-date", text: /\A[A-Z][a-z]{2} \d{1,2}(?:, \d{4})?\z/
+    assert_selector "#local-time-tomorrow", text: "tomorrow"
+    assert_selector "#local-time-three-days", text: "in 3 days"
+  end
+end
