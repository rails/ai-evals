diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..c0d0035 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,19 @@
 module TimeHelper
+  def local_time_tag(time, format: :friendly, **options)
+    time_tag_with_value(time.utc.iso8601, format:, **options)
+  end
+
+  def local_date_tag(date, format: :long_date, **options)
+    time_tag_with_value(date.to_date.iso8601, format:, **options)
+  end
+
+  private
+    def time_tag_with_value(value, format:, **options)
+      data = options.delete(:data) || {}
+      controllers = [ data[:controller], "local-time" ].compact.flat_map { it.to_s.split }
+      data[:controller] = controllers.uniq.join(" ")
+      data[:local_time_format_value] = format
+
+      tag.time(value, **options.merge(datetime: value, data: data))
+    end
 end
