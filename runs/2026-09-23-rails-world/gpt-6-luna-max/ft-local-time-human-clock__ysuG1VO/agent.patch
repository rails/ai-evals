diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..3546b95
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,121 @@
+const dayInMilliseconds = 24 * 60 * 60 * 1000
+const minuteInSeconds = 60
+const hourInSeconds = 60 * minuteInSeconds
+const dayInSeconds = 24 * hourInSeconds
+const monthInSeconds = 30 * dayInSeconds
+const yearInSeconds = 365 * dayInSeconds
+const dateFormatters = new Map()
+const relativeTimeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "always" })
+
+export function formatLocalTimestamp(value, format, now = new Date()) {
+  const date = parseTimestamp(value)
+
+  if (Number.isNaN(date.getTime())) return ""
+
+  switch (format) {
+    case "friendly":
+      return formatFriendly(date, now)
+    case "relative":
+      return formatRelative(date, now)
+    case "future":
+      return formatCalendarRelative(date, now)
+    case "time":
+      return dateFormatter({ hour: "numeric", minute: "2-digit" }).format(date)
+    case "date":
+      return dateFormatter({ month: "short", day: "numeric" }).format(date)
+    case "long_date":
+      return dateFormatter({ weekday: "long", month: "long", day: "numeric" }).format(date)
+    case "full_date":
+      return dateFormatter({ month: "short", day: "numeric", year: "numeric" }).format(date)
+    case "date_time":
+      return dateFormatter({ month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }).format(date)
+    default:
+      return date.toLocaleString()
+  }
+}
+
+function parseTimestamp(value) {
+  if (value instanceof Date) return value
+
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+  if (dateOnly) {
+    return new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
+  }
+
+  return new Date(value)
+}
+
+function formatFriendly(date, now) {
+  const days = calendarDayDifference(date, now)
+
+  if (days === 0) {
+    return formatLocalTimestamp(date, "time", now)
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days < 0 && days >= -6) {
+    return `${Math.abs(days)} days ago`
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else {
+    const options = { month: "short", day: "numeric" }
+    if (date.getFullYear() !== now.getFullYear()) options.year = "numeric"
+    return dateFormatter(options).format(date)
+  }
+}
+
+function formatRelative(date, now) {
+  const differenceInSeconds = (date.getTime() - now.getTime()) / 1000
+  const absoluteDifference = Math.abs(differenceInSeconds)
+
+  if (absoluteDifference < minuteInSeconds) {
+    return differenceInSeconds > 0 ? "in less than a minute" : "less than a minute ago"
+  }
+
+  const units = [
+    [ "year", yearInSeconds ],
+    [ "month", monthInSeconds ],
+    [ "day", dayInSeconds ],
+    [ "hour", hourInSeconds ],
+    [ "minute", minuteInSeconds ]
+  ]
+  const [unit, unitInSeconds] = units.find(([, seconds]) => absoluteDifference >= seconds)
+  const value = Math.round(differenceInSeconds / unitInSeconds)
+
+  return relativeTimeFormatter.format(value, unit)
+}
+
+function formatCalendarRelative(date, now) {
+  const days = calendarDayDifference(date, now)
+
+  if (days === 0) {
+    return "today"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else if (days === -1) {
+    return "yesterday"
+  } else {
+    return `${Math.abs(days)} days ago`
+  }
+}
+
+function calendarDayDifference(date, now) {
+  const dateDay = Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+  const nowDay = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())
+
+  return Math.round((dateDay - nowDay) / dayInMilliseconds)
+}
+
+function dateFormatter(options) {
+  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+  const key = `${timezone}-${JSON.stringify(options)}`
+
+  if (!dateFormatters.has(key)) {
+    dateFormatters.set(key, new Intl.DateTimeFormat("en-US", { ...options, timeZone: timezone }))
+  }
+
+  return dateFormatters.get(key)
+}
