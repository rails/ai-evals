+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  test "notification digest assignment is not included in account transfers" do
+    record_sets = []
+    Account::DataTransfer::Manifest.new(accounts("37s")).each_record_set do |record_set|
+      record_sets << record_set
+    end
+
+    notification_set = record_sets.find { |record_set| record_set.model == Notification }
+    settings_set = record_sets.find { |record_set| record_set.model == User::Settings }
+
+    assert_not_includes notification_set.attributes, "email_digest_id"
+    assert_includes settings_set.attributes, "bundle_email_frequency"
+  end
+end
diff --git a/test/models/notification/email_digest_test.rb b/test/models/notification/email_digest_test.rb
new file mode 100644
index 0000000..0423733
--- /dev/null
+++ b/test/models/notification/email_digest_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Notification::EmailDigestTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "notifications open a single rolling window and late notifications join it" do
+    start = Time.zone.parse("2026-01-01 09:00:00")
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    first_digest = nil
+
+    travel_to start do
+      first_notification = create_notification(source: events(:layout_published))
+      first_digest = first_notification.reload.email_digest
+
+      assert_equal start, first_digest.opened_at
+      assert_equal start + 4.hours, first_digest.closes_at
+    end
+
+    travel_to start + 5.hours do
+      late_notification = create_notification(source: events(:buy_domain_sent_back_to_triage))
+
+      assert_equal first_digest, late_notification.reload.email_digest
+      assert_equal 1, Notification::EmailDigest.open.where(user: @user).count
+
+      assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+        first_digest.deliver
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_match "Layout is broken", email.body.encoded
+      assert_match "Buy domain", email.body.encoded
+      assert_not_nil first_digest.reload.sent_at
+
+      assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+        first_digest.deliver
+      end
+    end
+  end
+
+  test "never does not schedule an email digest" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::EmailDigest.count } do
+      create_notification(source: events(:layout_published))
+    end
+  end
+
+  test "disabling email digests cancels the open window" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    digest = create_notification(source: events(:layout_published)).reload.email_digest
+
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_not digest.reload.open?
+    assert_not_nil digest.cancelled_at
+  end
+
+  test "notification updates are included in the currently open window" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    notification = create_notification(source: events(:layout_published))
+    digest = notification.reload.email_digest
+
+    notification.update!(source: events(:layout_commented))
+
+    assert_equal digest, notification.reload.email_digest
+    assert_equal 1, Notification::EmailDigest.open.where(user: @user).count
+  end
+
+  test "a new window starts only after the previous digest has been sent" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    start = Time.zone.parse("2026-01-01 09:00:00")
+    first_digest = nil
+
+    travel_to start do
+      first_digest = create_notification(source: events(:layout_published)).reload.email_digest
+    end
+
+    travel_to start + 4.hours do
+      first_digest.deliver
+      second_digest = create_notification(source: events(:buy_domain_sent_back_to_triage)).reload.email_digest
+
+      assert_not_equal first_digest, second_digest
+      assert_operator second_digest.opened_at, :>=, first_digest.closed_at
+      assert_equal 4.hours, second_digest.closes_at - second_digest.opened_at
+    end
+  end
+
+  test "frequency is stored per person and daily windows last 24 hours" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    users(:kevin).settings.update!(bundle_email_frequency: "weekly")
+
+    start = Time.zone.parse("2026-01-01 09:00:00")
+
+    travel_to start do
+      daily_digest = create_notification(source: events(:layout_published)).reload.email_digest
+      weekly_digest = create_notification(user: users(:kevin), source: events(:text_published)).reload.email_digest
+
+      assert_equal 24.hours, daily_digest.closes_at - daily_digest.opened_at
+      assert_equal 7 * 24.hours, weekly_digest.closes_at - weekly_digest.opened_at
+    end
+  end
+
+  private
+    def create_notification(user: @user, source:)
+      Notification.create!(user: user, creator: users(:kevin), source: source, account: user.account, unread_count: 1)
+    end
+end
