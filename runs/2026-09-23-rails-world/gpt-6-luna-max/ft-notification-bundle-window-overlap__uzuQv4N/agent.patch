diff --git a/app/models/notification/email_digest.rb b/app/models/notification/email_digest.rb
new file mode 100644
index 0000000..be24ba6
--- /dev/null
+++ b/app/models/notification/email_digest.rb
@@ -0,0 +1,110 @@
+class Notification::EmailDigest < ApplicationRecord
+  # The unique (user_id, active_slot) index permits history but only one open window per user.
+  ACTIVE_SLOT = 1
+
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :open, -> { where(active_slot: ACTIVE_SLOT) }
+
+  validates :frequency, inclusion: { in: User::Settings::BUNDLE_EMAIL_FREQUENCIES }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add_notification(notification)
+      if settings = notification.user.settings
+        settings.with_lock do
+          if settings.bundle_email_frequency != "never"
+            digest = open.find_by(user: notification.user)
+
+            unless digest
+              opened_at = Time.current
+              digest = create_or_find_by!(user: notification.user, active_slot: ACTIVE_SLOT) do |new_digest|
+                new_digest.account = notification.account
+                new_digest.frequency = settings.bundle_email_frequency
+                new_digest.opened_at = opened_at
+                new_digest.closes_at = opened_at + settings.bundle_email_frequency_duration
+              end
+            end
+
+            unless notification.email_digest_id == digest.id
+              notification.update_column(:email_digest_id, digest.id)
+              notification.email_digest = digest
+            end
+          end
+        end
+      end
+    end
+  end
+
+  def deliver
+    if settings = user.settings
+      # Serialize arrivals with delivery so each notification belongs to this window or the next.
+      settings.with_lock do
+        reload
+        deliver_if_due(settings)
+      end
+    elsif open? && due?
+      cancel
+    end
+  end
+
+  def cancel
+    if open?
+      update!(active_slot: nil, closed_at: Time.current, cancelled_at: Time.current)
+    end
+  end
+
+  def open?
+    active_slot == ACTIVE_SLOT
+  end
+
+  def due?(at: Time.current)
+    closes_at <= at
+  end
+
+  private
+    def deliver_if_due(settings)
+      if open? && due?
+        digest_notifications = notifications.preloaded.ordered.to_a
+
+        if should_send?(settings, digest_notifications)
+          deliver_email(digest_notifications)
+        else
+          cancel
+        end
+      end
+    end
+
+    def should_send?(settings, digest_notifications)
+      settings.bundle_email_frequency != "never" &&
+        user.active? && user.identity.present? && account.active? &&
+        digest_notifications.any?
+    end
+
+    def deliver_email(digest_notifications)
+      NotificationMailer.email_digest(self, digest_notifications).deliver_now
+      update!(active_slot: nil, closed_at: Time.current, sent_at: Time.current)
+    rescue Net::SMTPSyntaxError, Net::SMTPFatalError => error
+      if undeliverable_email?(error)
+        cancel
+      else
+        raise
+      end
+    end
+
+    def undeliverable_email?(error)
+      case error
+      when Net::SMTPSyntaxError
+        error.message.start_with?("501 5.1.3")
+      when Net::SMTPFatalError
+        error.message.match?(/\A(?:550 5\.1\.1|552 5\.6\.0|555 5\.5\.4)/)
+      end
+    end
+
+    def deliver_later
+      Notification::EmailDigestJob.set(wait_until: closes_at).perform_later(self)
+    end
+end
