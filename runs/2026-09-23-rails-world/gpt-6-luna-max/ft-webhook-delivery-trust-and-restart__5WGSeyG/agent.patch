+require "net/http"
+require "openssl"
+
 class Webhook::Delivery < ApplicationRecord
+  class << self
+    def cleanup
+      where(created_at: ...1.week.ago).delete_all
+    end
+  end
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +19,23 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    if claim_for_delivery
+      result = perform_request
+      update!(state: result.key?(:code) ? :completed : :errored, response: result)
+
+      if succeeded?
+        delinquency_tracker.record_success
+      else
+        delinquency_tracker.record_failure
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +53,49 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def perform_request
+      body = ApplicationController.renderer.new(script_name: event.account.slug).render(
+        template: "webhooks/event",
+        formats: [ :json ],
+        assigns: { event: event }
+      )
+      headers = request_headers(body)
+      update! request: { headers: headers }
+
+      uri = URI.parse(webhook.url)
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+      http.write_timeout = 10
+
+      response = http.start { |connection| connection.request(request) }
+      { code: response.code.to_i, error: nil }
+    rescue StandardError => error
+      { error: error.message.presence || error.class.name }
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def delinquency_tracker
+      webhook.delinquency_tracker || Webhook::DelinquencyTracker.create_or_find_by!(webhook: webhook)
+    end
 end
