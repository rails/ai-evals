diff --git a/docs/api/sections/webhooks.md b/docs/api/sections/webhooks.md
index a4f48b5..8de1d26 100644
--- a/docs/api/sections/webhooks.md
+++ b/docs/api/sections/webhooks.md
@@ -159,3 +159,16 @@ __Response:__
 ```
 
 `request` and `response` can be `null` for deliveries that have not started yet or are still in progress. The delivery request headers omit the `X-Webhook-Signature` header.
+
+## Delivery behavior
+
+When an event matches an active board webhook's `subscribed_actions`, Fizzy creates a delivery-log entry and makes one `POST` to the payload URL. Each event/webhook pair is attempted once; failed requests are not automatically retried.
+
+The request body is JSON describing the event, including its `id`, `action`, `created_at`, `eventable`, `board`, and `creator`. Requests include:
+
+- `Content-Type: application/json`
+- `User-Agent: fizzy/1.0.0 Webhook`
+- `X-Webhook-Timestamp`, set to the event's creation time in UTC
+- `X-Webhook-Signature`, the lowercase hexadecimal HMAC-SHA256 of the exact request body using the webhook's signing secret
+
+A `2xx` response is successful. Non-`2xx` responses and network errors count as failures; a successful delivery resets the consecutive-failure count. Ten consecutive failures within one hour automatically deactivate the webhook. Reactivating it resets that count. Delivery history is retained for one week.
diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
new file mode 100644
index 0000000..077d77c
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:layout_commented)
+    @delivery = @webhook.deliveries.create!(event: @event)
+  end
+
+  test "posts a signed event and logs the response exactly once" do
+    posted_request = nil
+    request = stub_request(:post, @webhook.url).to_return do |request|
+      posted_request = request
+      { status: 201 }
+    end
+
+    perform_enqueued_jobs do
+      @delivery.deliver_later
+    end
+
+    @delivery.reload
+    payload = JSON.parse(posted_request.body)
+    headers = posted_request.headers
+
+    assert_equal "comment_created", payload["action"]
+    assert_equal "application/json", headers["Content-Type"]
+    assert_equal "fizzy/1.0.0 Webhook", headers["User-Agent"]
+    assert_includes payload.dig("board", "url"), @event.account.slug
+    assert_equal @event.created_at.utc.iso8601(3), headers["X-Webhook-Timestamp"]
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, posted_request.body), headers["X-Webhook-Signature"]
+    assert_equal "completed", @delivery.state
+    assert @delivery.succeeded?
+    assert_equal 201, @delivery.response_summary[:code]
+    assert_nil @delivery.response_summary[:error]
+    assert_equal @event.created_at.utc.iso8601(3), @delivery.request.dig("headers", "X-Webhook-Timestamp")
+    assert_not @delivery.sanitized_request.dig(:headers).key?("X-Webhook-Signature")
+    assert_requested request, times: 1
+
+    @delivery.deliver_now
+
+    assert_requested request, times: 1
+  end
+
+  test "a non-success response counts as a failed delivery" do
+    stub_request(:post, @webhook.url).to_return(status: 503)
+
+    @delivery.deliver_now
+    @delivery.reload
+
+    assert_equal "completed", @delivery.state
+    assert_equal 503, @delivery.response_summary[:code]
+    assert @delivery.failed?
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "a network error is recorded and not retried" do
+    request = stub_request(:post, @webhook.url).to_raise(SocketError.new("destination unreachable"))
+
+    @delivery.deliver_now
+    @delivery.reload
+
+    assert_equal "errored", @delivery.state
+    assert_match "destination unreachable", @delivery.response_summary[:error]
+    assert @delivery.failed?
+    assert_requested request, times: 1
+
+    @delivery.deliver_now
+
+    assert_requested request, times: 1
+  end
+end
