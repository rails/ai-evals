diff --git a/app/views/account/imports/new.html.erb b/app/views/account/imports/new.html.erb
new file mode 100644
index 0000000..706349e
--- /dev/null
+++ b/app/views/account/imports/new.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account Settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<div class="panel panel--wide shadow center flex flex-column gap">
+  <header>
+    <h1 class="txt-large margin-none font-weight-black"><%= @page_title %></h1>
+    <p class="txt-medium margin-none">Restore an account from a Fizzy account export. This creates a new account and keeps the account you’re using now.</p>
+  </header>
+
+  <%= form_with model: @import, url: account_imports_path, scope: :import, html: { multipart: true }, class: "flex flex-column gap" do |form| %>
+    <label class="flex flex-column gap-half txt-align-start">
+      <strong>Account export (.zip)</strong>
+      <%= form.file_field :archive, accept: ".zip,application/zip", required: true, class: "input" %>
+    </label>
+
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small" role="alert">
+        <% @import.errors.full_messages.each do |message| %>
+          <p class="margin-block-none"><%= message %></p>
+        <% end %>
+      </div>
+    <% end %>
+
+    <%= form.button "Import account", class: "btn btn--primary" %>
