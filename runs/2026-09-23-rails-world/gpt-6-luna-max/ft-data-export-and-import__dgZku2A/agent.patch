+class ExportMailer < ApplicationMailer
+  def ready(export)
+    @export = export
+    blob = export.archive.blob
+    @download_url = rails_blob_url(
+      blob, filename: blob.filename, disposition: "attachment", expires_at: export.expires_at
+    )
+
+    mail to: export.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def failed(export)
+    @export = export
+    mail to: export.email_address, subject: "Your Fizzy export could not be created"
+  end
+end
