diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..d5c3d31
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,31 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  COMMENT_BURST_SIZE = 3
+  COMMENT_BURST_PEOPLE = 2
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..(STALLED_AFTER.ago)) }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def mark_burst
+    update!(burst_at: Time.current) unless burst_at
+  end
+
+  def mark_burst_from_comment(comment)
+    burst_window = board.auto_postpone_period.seconds / 3
+    comments_by_person = comments.by_user
+      .where(created_at: (comment.created_at - burst_window)..comment.created_at)
+      .group(:creator_id)
+      .count
+
+    if comments_by_person.values.sum >= COMMENT_BURST_SIZE && comments_by_person.size >= COMMENT_BURST_PEOPLE
+      mark_burst
+    end
+  end
+end
