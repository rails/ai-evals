diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..c15e0ea
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "comment burst needs three comments from two people within a third of the board period" do
+    card = create_published_card
+    reference_time = Time.current
+
+    card.comments.create! creator: users(:david), body: "First", created_at: reference_time - 30.days
+    card.comments.create! creator: users(:kevin), body: "Second", created_at: reference_time - 1.day
+    assert_nil card.reload.burst_at
+
+    card.comments.create! creator: users(:david), body: "Third", created_at: reference_time
+
+    assert card.reload.burst_at.present?
+  end
+
+  test "comments outside the board burst window do not count" do
+    card = create_published_card
+    reference_time = Time.current
+
+    card.comments.create! creator: users(:david), body: "Too old", created_at: reference_time - 30.days - 1.second
+    card.comments.create! creator: users(:kevin), body: "Recent", created_at: reference_time - 1.hour
+    card.comments.create! creator: users(:david), body: "Also recent", created_at: reference_time
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "comments by one person or by the system do not count as a people burst" do
+    reference_time = Time.current
+    single_author_card = create_published_card
+
+    3.times do |index|
+      single_author_card.comments.create! \
+        creator: users(:david), body: "Comment #{index}", created_at: reference_time - index.hours
+    end
+
+    assert_nil single_author_card.reload.burst_at
+
+    mixed_card = create_published_card
+    mixed_card.comments.create! creator: users(:david), body: "First", created_at: reference_time - 2.hours
+    mixed_card.comments.create! creator: users(:kevin), body: "Second", created_at: reference_time - 1.hour
+    mixed_card.comments.create! creator: accounts("37s").system_user, body: "System note", created_at: reference_time
+
+    assert_nil mixed_card.reload.burst_at
+  end
+
+  test "assigning a just-published card resets its previous activity time" do
+    old_activity = 3.weeks.ago
+    card = boards(:writebook).cards.create!(
+      title: "Recently assigned",
+      creator: users(:david),
+      status: :published,
+      created_at: old_activity,
+      last_active_at: old_activity
+    )
+
+    card.toggle_assignment users(:kevin)
+
+    assert card.reload.burst_at.present?
+    assert_not card.stalled?
+    assert_operator card.last_active_at, :>, old_activity
+  end
+
+  test "assignment and reopening create a burst" do
+    assigned_card = create_published_card
+    assigned_card.toggle_assignment users(:kevin)
+
+    assert assigned_card.reload.burst_at.present?
+
+    reopened_card = create_published_card
+    reopened_card.close(user: users(:david))
+    assert_nil reopened_card.reload.burst_at
+
+    reopened_card.reopen(user: users(:david))
+    assert reopened_card.reload.burst_at.present?
+  end
+
+  test "a burst becomes stalled after two inactive weeks and activity resets the timer" do
+    card = create_published_card
+    now = Time.current
+    unbursted_card = create_published_card
+    unbursted_card.update_column(:last_active_at, now - 3.weeks)
+
+    assert_not unbursted_card.reload.stalled?
+
+    card.update_columns(burst_at: now - 3.weeks, last_active_at: now - 2.weeks + 1.second)
+    assert_not card.reload.stalled?
+
+    card.update_column(:last_active_at, now - 2.weeks)
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+
+    travel_to(now + 1.hour) do
+      card.comments.create! creator: users(:kevin), body: "I'm back"
+
+      assert_not card.reload.stalled?
+      assert card.burst_at.present?
+    end
+  end
+
+  private
+    def create_published_card(board: boards(:writebook))
+      board.cards.create!(title: "Burst test", creator: users(:david), status: :published)
+    end
+end
