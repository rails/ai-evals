@@ -0,0 +1,27 @@
+require "application_system_test_case"
+
+class NotificationsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "push settings explain when VAPID keys are not configured" do
+    switch_env("VAPID_PUBLIC_KEY", nil) do
+      switch_env("VAPID_PRIVATE_KEY", nil) do
+        visit notifications_settings_url
+
+        assert_selector "[data-controller=notifications]"
+        assert_text "Push notifications aren't configured on this server yet."
+        assert_no_selector "button[data-notifications-target=button]", visible: true
+      end
+    end
+  end
+
+  private
+    def switch_env(key, value)
+      previous_value, ENV[key] = ENV[key], value
+      yield
+    ensure
+      ENV[key] = previous_value
+    end
+end
