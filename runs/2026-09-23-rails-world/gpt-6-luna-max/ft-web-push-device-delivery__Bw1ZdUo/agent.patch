diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..a485f4f
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,32 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    created = @push_subscription.new_record?
+
+    if @push_subscription.update(push_subscription_params)
+      render json: { id: @push_subscription.id }, status: created ? :created : :ok
+    else
+      render json: @push_subscription.errors, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      if params[:user_id] == Current.user&.id
+        @user = Current.user
+      else
+        head :forbidden
+      end
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..81e705d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,179 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "details", "error", "unavailable" ]
+  static values = { vapidPublicKey: String, pushSubscriptionUrl: String }
+
+  async connect() {
+    this.#clearError()
+
+    if (!this.#supportsPush()) {
+      this.#setUnavailable("Push notifications aren't supported by this browser.")
+      return
+    }
+
+    if (!this.vapidPublicKeyValue) {
+      this.#setUnavailable("Push notifications aren't configured on this server yet.")
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showDetails(true)
+      this.buttonTarget.hidden = true
+      return
+    }
+
+    this.buttonTarget.hidden = false
+    this.buttonTarget.disabled = true
+
+    try {
+      this.registration = await navigator.serviceWorker.ready
+      const subscription = await this.registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#saveSubscription(subscription)
+        this.#setEnabled(true)
+      } else if (Notification.permission === "denied") {
+        this.#showDetails(true)
+        this.buttonTarget.hidden = true
+      }
+    } catch (error) {
+      this.#showError("We couldn't check push notifications for this device. Please try again.")
+    } finally {
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  async toggle(event) {
+    event.preventDefault()
+    this.buttonTarget.disabled = true
+    this.#clearError()
+
+    try {
+      if (this.element.classList.contains("notifications--on")) {
+        const subscription = await this.registration.pushManager.getSubscription()
+
+        if (subscription) {
+          await this.#unsubscribe(subscription)
+        } else {
+          this.#setEnabled(false)
+        }
+      } else {
+        await this.#subscribe()
+      }
+    } catch (error) {
+      if (error.name === "NotAllowedError" || Notification.permission === "denied") {
+        this.#showDetails(true)
+        this.buttonTarget.hidden = true
+        this.#showError("Allow notifications for this site in your browser and system settings, then try again.")
+      } else {
+        this.#showError("We couldn't update push notifications for this device. Please try again.")
+      }
+    } finally {
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  async #subscribe() {
+    let permission = Notification.permission
+
+    if (permission !== "granted") {
+      permission = await Notification.requestPermission()
+    }
+
+    if (permission !== "granted") {
+      if (permission === "denied") {
+        this.#showDetails(true)
+        this.buttonTarget.hidden = true
+      }
+      return
+    }
+
+    let subscription = await this.registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey()
+      })
+    }
+
+    await this.#saveSubscription(subscription)
+    this.#setEnabled(true)
+  }
+
+  async #saveSubscription(subscription) {
+    const data = subscription.toJSON()
+    const response = await post(this.pushSubscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: data.keys.p256dh,
+          auth_key: data.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (!response.ok) {
+      throw new Error("Unable to save the push subscription")
+    }
+
+    this.subscriptionId = (await response.json).id
+  }
+
+  async #unsubscribe(subscription) {
+    if (this.subscriptionId) {
+      const response = await destroy(`${this.pushSubscriptionUrlValue}/${this.subscriptionId}`, { responseKind: "json" })
+      if (!response.ok && response.statusCode !== 404) {
+        throw new Error("Unable to remove the push subscription")
+      }
+    }
+
+    await subscription.unsubscribe()
+    this.subscriptionId = null
+    this.#setEnabled(false)
+  }
+
+  #supportsPush() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawKey = window.atob(base64)
+
+    return Uint8Array.from(rawKey, character => character.charCodeAt(0))
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.hidden = false
+    this.buttonTarget.textContent = enabled ? "Turn off push notifications" : "Turn on push notifications"
+    this.#showDetails(false)
+  }
+
+  #setUnavailable(message) {
+    this.buttonTarget.hidden = true
+    this.unavailableTarget.textContent = message
+    this.unavailableTarget.hidden = false
+  }
+
+  #showDetails(visible) {
+    this.detailsTargets.forEach(details => { details.hidden = !visible })
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+
+  #clearError() {
+    if (this.hasErrorTarget) {
+      this.errorTarget.textContent = ""
+      this.errorTarget.hidden = true
+    }
+  }
+}
