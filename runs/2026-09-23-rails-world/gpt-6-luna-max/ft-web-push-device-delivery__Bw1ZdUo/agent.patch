diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..25c3b07
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,58 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+  validate :endpoint_uses_https
+
+  class << self
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+  end
+
+  def deliver_later(notification)
+    PushSubscription::DeliverJob.perform_later(self, notification)
+  end
+
+  def deliver(notification)
+    return unless self.class.configured? && deliverable?(notification)
+
+    WebPush.payload_send(
+      endpoint: endpoint,
+      message: push_payload(notification),
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: "mailto:support@fizzy.do",
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def deliverable?(notification)
+      notification.user_id == user_id && !notification.read? && user.active? && account.active?
+    end
+
+    def endpoint_uses_https
+      if endpoint.present?
+        uri = URI.parse(endpoint)
+        errors.add(:endpoint, "must use HTTPS") unless uri.is_a?(URI::HTTPS) && uri.host.present?
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be a valid URL")
+    end
+
+    def push_payload(notification)
+      ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "notifications/push",
+        formats: :json,
+        locals: { notification: notification }
+      )
+    end
+end
