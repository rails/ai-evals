@@ -0,0 +1,11 @@
+class PushSubscription::DeliverJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, Net::OpenTimeout, Net::ReadTimeout,
+    wait: 1.minute, attempts: 5
+
+  def perform(push_subscription, notification)
+    push_subscription.deliver(notification)
+  end
+end
