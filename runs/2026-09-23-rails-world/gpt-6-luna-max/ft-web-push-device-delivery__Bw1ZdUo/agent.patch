diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..f61123e
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create stores the browser subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.sole
+    assert_equal subscription_params[:endpoint], subscription.endpoint
+    assert_equal subscription_params[:p256dh_key], subscription.p256dh_key
+    assert_equal subscription_params[:auth_key], subscription.auth_key
+    assert_equal subscription.id, @response.parsed_body["id"]
+  end
+
+  test "create updates an existing endpoint instead of duplicating it" do
+    @user.push_subscriptions.create!(subscription_params)
+    updated_params = subscription_params.merge(p256dh_key: "updated-public-key", auth_key: "updated-auth-key")
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: updated_params }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal "updated-public-key", @user.push_subscriptions.sole.p256dh_key
+    assert_equal "updated-auth-key", @user.push_subscriptions.sole.auth_key
+  end
+
+  test "rejects endpoints that aren't secure push URLs" do
+    params = subscription_params.merge(endpoint: "http://push.example.test/subscriptions/device-1")
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: params }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy removes the current user's device subscription" do
+    subscription = @user.push_subscriptions.create!(subscription_params)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot subscribe a different user" do
+    assert_no_difference -> { users(:kevin).push_subscriptions.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://push.example.test/subscriptions/device-1",
+        p256dh_key: "browser-public-key",
+        auth_key: "browser-auth-key"
+      }
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..38110ec
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "sends the tray title and body and opens its card" do
+    user = users(:kevin)
+    notification = notifications(:logo_assignment_kevin)
+    subscription = user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-1",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-key"
+    )
+
+    keys = WebPush.generate_key
+    switch_env("VAPID_PUBLIC_KEY", keys.public_key) do
+      switch_env("VAPID_PRIVATE_KEY", keys.private_key) do
+        WebPush.expects(:payload_send).with do |**arguments|
+          payload = JSON.parse(arguments.fetch(:message))
+
+          assert_equal subscription.endpoint, arguments.fetch(:endpoint)
+          assert_equal subscription.p256dh_key, arguments.fetch(:p256dh)
+          assert_equal subscription.auth_key, arguments.fetch(:auth)
+          assert_equal keys.public_key, arguments.dig(:vapid, :public_key)
+          assert_equal keys.private_key, arguments.dig(:vapid, :private_key)
+          assert_equal "The logo isn't big enough", payload.fetch("title")
+          assert_equal "Assigned to Kevin", payload.fetch("body")
+          assert_equal Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug), payload.fetch("url")
+
+          true
+        end
+
+        subscription.deliver(notification)
+      end
+    end
+  end
+
+  test "removes subscriptions that have expired" do
+    subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/expired",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-key"
+    )
+    notification = notifications(:logo_assignment_kevin)
+    response = Struct.new(:body).new("")
+
+    switch_env("VAPID_PUBLIC_KEY", "public-key") do
+      switch_env("VAPID_PRIVATE_KEY", "private-key") do
+        WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+
+        assert_difference -> { PushSubscription.count }, -1 do
+          subscription.deliver(notification)
+        end
+      end
+    end
+  end
+
+  test "updated notifications queue a new push" do
+    user = users(:kevin)
+    subscription = user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-3",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-key"
+    )
+    notification = notifications(:logo_assignment_kevin)
+
+    with_vapid_keys do
+      assert_enqueued_with job: PushSubscription::DeliverJob, args: [ subscription, notification ] do
+        notification.update!(source: events(:logo_published), read_at: nil, unread_count: 3)
+      end
+    end
+  end
+
+  test "each device gets its own queued delivery" do
+    user = users(:kevin)
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/phone",
+      p256dh_key: "phone-public-key",
+      auth_key: "phone-auth-key"
+    )
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/desktop",
+      p256dh_key: "desktop-public-key",
+      auth_key: "desktop-auth-key"
+    )
+    notifications(:layout_commented_kevin).destroy
+    notification = Notification.new(user: user, source: events(:layout_commented), creator: users(:david))
+
+    with_vapid_keys do
+      assert_enqueued_jobs 2, only: PushSubscription::DeliverJob do
+        notification.save!
+      end
+    end
+  end
+
+  test "notifications don't queue push jobs until VAPID keys are configured" do
+    user = users(:kevin)
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-5",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-key"
+    )
+    notifications(:layout_commented_kevin).destroy
+    notification = Notification.new(user: user, source: events(:layout_commented), creator: users(:david))
+
+    switch_env("VAPID_PUBLIC_KEY", nil) do
+      switch_env("VAPID_PRIVATE_KEY", nil) do
+        assert_no_enqueued_jobs only: PushSubscription::DeliverJob do
+          notification.save!
+        end
+      end
+    end
+  end
+
+  test "reading a notification does not queue a push" do
+    user = users(:kevin)
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-4",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-key"
+    )
+
+    assert_no_enqueued_jobs only: PushSubscription::DeliverJob do
+      notifications(:logo_assignment_kevin).read
+    end
+  end
+
+  test "notification creation queues a delivery for each subscription" do
+    user = users(:kevin)
+    subscription = user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-2",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-key"
+    )
+    notifications(:layout_commented_kevin).destroy
+    notification = Notification.new(user: user, source: events(:layout_commented), creator: users(:david))
+
+    with_vapid_keys do
+      assert_enqueued_with job: PushSubscription::DeliverJob, args: [ subscription, notification ] do
+        notification.save!
+      end
+    end
+  end
+
+  private
+    def switch_env(key, value)
+      previous_value, ENV[key] = ENV[key], value
+      yield
+    ensure
+      ENV[key] = previous_value
+    end
+
+    def with_vapid_keys(&block)
+      switch_env("VAPID_PUBLIC_KEY", "public-key") do
+        switch_env("VAPID_PRIVATE_KEY", "private-key", &block)
+      end
+    end
+end
