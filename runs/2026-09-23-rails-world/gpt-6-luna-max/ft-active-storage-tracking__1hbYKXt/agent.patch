new file mode 100644
index 0000000..20baa2f
--- /dev/null
+++ b/lib/rails_ext/storage_usage_tracking.rb
@@ -0,0 +1,52 @@
+module StorageUsageTracking
+  module Attachment
+    extend ActiveSupport::Concern
+
+    included do
+      after_commit :recalculate_storage_usage_later, on: [ :create, :destroy ]
+    end
+
+    def delete
+      track_storage_usage = (record_type == "Card" && name == "image") ||
+        (record_type == "ActionText::RichText" && name == "embeds")
+
+      super.tap do
+        recalculate_storage_usage_later if track_storage_usage
+      end
+    end
+
+    private
+      def recalculate_storage_usage_later
+        if record_type == "Card" && name == "image"
+          StorageUsage.recalculate_for_card_later(card_id: record_id, account_id: account_id)
+        elsif record_type == "ActionText::RichText" && name == "embeds"
+          if rich_text = ActionText::RichText.where(id: record_id).pick(:record_type, :record_id, :name, :account_id)
+            StorageUsage.recalculate_for_rich_text_later(
+              record_type: rich_text[0],
+              record_id: rich_text[1],
+              name: rich_text[2],
+              account_id: rich_text[3]
+            )
+          end
+        end
+      end
+  end
+
+  module RichText
+    extend ActiveSupport::Concern
+
+    included do
+      after_destroy_commit :recalculate_storage_usage_later
+    end
+
+    private
+      def recalculate_storage_usage_later
+        StorageUsage.recalculate_for_rich_text_later(
+          record_type: record_type,
+          record_id: record_id,
+          name: name,
+          account_id: account_id
+        )
+      end
+  end
+end
