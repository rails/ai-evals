+class AddBytesUsedToAccountsAndBoards < ActiveRecord::Migration[8.2]
+  def up
+    add_column :accounts, :bytes_used, :bigint, default: 0, null: false
+    add_column :boards, :bytes_used, :bigint, default: 0, null: false
+    add_index :active_storage_attachments, [ :account_id, :record_type, :name ], name: "index_storage_attachments_on_account_type_name"
+
+    backfill_account_bytes_used
+    backfill_board_bytes_used
+  end
+
+  def down
+    remove_index :active_storage_attachments, name: "index_storage_attachments_on_account_type_name"
+    remove_column :boards, :bytes_used
+    remove_column :accounts, :bytes_used
+  end
+
+  private
+    def backfill_account_bytes_used
+      execute <<~SQL
+        UPDATE accounts
+        SET bytes_used = COALESCE((
+          SELECT SUM(usage_blobs.byte_size)
+          FROM active_storage_attachments AS usage_attachments
+          INNER JOIN active_storage_blobs AS usage_blobs ON usage_blobs.id = usage_attachments.blob_id
+          INNER JOIN cards AS usage_cards ON usage_cards.id = usage_attachments.record_id
+          WHERE usage_attachments.account_id = accounts.id
+            AND usage_attachments.record_type = 'Card'
+            AND usage_attachments.name = 'image'
+            AND usage_cards.account_id = accounts.id
+        ), 0) + COALESCE((
+          SELECT SUM(usage_blobs.byte_size)
+          FROM active_storage_attachments AS usage_attachments
+          INNER JOIN active_storage_blobs AS usage_blobs ON usage_blobs.id = usage_attachments.blob_id
+          INNER JOIN action_text_rich_texts AS usage_rich_texts ON usage_rich_texts.id = usage_attachments.record_id
+          WHERE usage_attachments.account_id = accounts.id
+            AND usage_attachments.record_type = 'ActionText::RichText'
+            AND usage_attachments.name = 'embeds'
+            AND usage_rich_texts.account_id = accounts.id
+            AND (
+              (
+                usage_rich_texts.record_type = 'Board'
+                AND usage_rich_texts.name = 'public_description'
+                AND EXISTS (
+                  SELECT 1 FROM boards AS usage_boards
+                  WHERE usage_boards.id = usage_rich_texts.record_id
+                    AND usage_boards.account_id = accounts.id
+                )
+              ) OR (
+                usage_rich_texts.record_type = 'Card'
+                AND usage_rich_texts.name = 'description'
+                AND EXISTS (
+                  SELECT 1 FROM cards AS usage_cards
+                  WHERE usage_cards.id = usage_rich_texts.record_id
+                    AND usage_cards.account_id = accounts.id
+                )
+              ) OR (
+                usage_rich_texts.record_type = 'Comment'
+                AND usage_rich_texts.name = 'body'
+                AND EXISTS (
+                  SELECT 1
+                  FROM comments AS usage_comments
+                  INNER JOIN cards AS usage_comment_cards ON usage_comment_cards.id = usage_comments.card_id
+                  WHERE usage_comments.id = usage_rich_texts.record_id
+                    AND usage_comments.account_id = accounts.id
+                    AND usage_comment_cards.account_id = accounts.id
+                )
+              )
+            )
+        ), 0)
+      SQL
+    end
+
+    def backfill_board_bytes_used
+      execute <<~SQL
+        UPDATE boards
+        SET bytes_used = COALESCE((
+          SELECT SUM(usage_blobs.byte_size)
+          FROM active_storage_attachments AS usage_attachments
+          INNER JOIN active_storage_blobs AS usage_blobs ON usage_blobs.id = usage_attachments.blob_id
+          INNER JOIN cards AS usage_cards ON usage_cards.id = usage_attachments.record_id
+          WHERE usage_attachments.account_id = boards.account_id
+            AND usage_attachments.record_type = 'Card'
+            AND usage_attachments.name = 'image'
+            AND usage_cards.account_id = boards.account_id
+            AND usage_cards.board_id = boards.id
+        ), 0) + COALESCE((
+          SELECT SUM(usage_blobs.byte_size)
+          FROM active_storage_attachments AS usage_attachments
+          INNER JOIN active_storage_blobs AS usage_blobs ON usage_blobs.id = usage_attachments.blob_id
+          INNER JOIN action_text_rich_texts AS usage_rich_texts ON usage_rich_texts.id = usage_attachments.record_id
+          WHERE usage_attachments.account_id = boards.account_id
+            AND usage_attachments.record_type = 'ActionText::RichText'
+            AND usage_attachments.name = 'embeds'
+            AND usage_rich_texts.account_id = boards.account_id
+            AND (
+              (
+                usage_rich_texts.record_type = 'Board'
+                AND usage_rich_texts.name = 'public_description'
+                AND usage_rich_texts.record_id = boards.id
+              ) OR (
+                usage_rich_texts.record_type = 'Card'
+                AND usage_rich_texts.name = 'description'
+                AND EXISTS (
+                  SELECT 1 FROM cards AS usage_cards
+                  WHERE usage_cards.id = usage_rich_texts.record_id
+                    AND usage_cards.account_id = boards.account_id
+                    AND usage_cards.board_id = boards.id
+                )
+              ) OR (
+                usage_rich_texts.record_type = 'Comment'
+                AND usage_rich_texts.name = 'body'
+                AND EXISTS (
+                  SELECT 1
+                  FROM comments AS usage_comments
+                  INNER JOIN cards AS usage_comment_cards ON usage_comment_cards.id = usage_comments.card_id
+                  WHERE usage_comments.id = usage_rich_texts.record_id
+                    AND usage_comments.account_id = boards.account_id
+                    AND usage_comment_cards.account_id = boards.account_id
+                    AND usage_comment_cards.board_id = boards.id
+                )
+              )
+            )
+        ), 0)
+      SQL
+    end
+end
