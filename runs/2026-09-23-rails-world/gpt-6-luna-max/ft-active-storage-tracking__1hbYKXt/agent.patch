diff --git a/app/jobs/storage_usage/recalculate_job.rb b/app/jobs/storage_usage/recalculate_job.rb
new file mode 100644
index 0000000..5bb37fa
--- /dev/null
+++ b/app/jobs/storage_usage/recalculate_job.rb
@@ -0,0 +1,45 @@
+class StorageUsage::RecalculateJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  limits_concurrency to: 1,
+    key: ->(*arguments) { Array(arguments.last&.fetch(:account_ids, [])).sort.join(":") },
+    duration: 10.minutes
+
+  def perform(board_ids: [], account_ids: [], all_boards_for_account: false)
+    account_ids = Array(account_ids).compact.uniq
+    all_boards_account_ids = account_ids if all_boards_for_account
+
+    if all_boards_for_account
+      account_ids.each do |account_id|
+        Board.where(account_id: account_id).find_each do |board|
+          recalculate_board(board.id, board.account_id)
+        end
+      end
+    end
+
+    Array(board_ids).compact.uniq.each do |board_id|
+      if board = Board.where(id: board_id).pick(:id, :account_id)
+        unless all_boards_account_ids&.include?(board.last)
+          recalculate_board(board.first, board.last)
+        end
+      end
+    end
+
+    account_ids.each do |account_id|
+      recalculate_account(account_id)
+    end
+  end
+
+  private
+    def recalculate_board(board_id, account_id)
+      bytes_used = StorageUsage.bytes_used_for_board(board_id: board_id, account_id: account_id)
+      Board.where(id: board_id).update_all(bytes_used: bytes_used)
+    end
+
+    def recalculate_account(account_id)
+      bytes_used = StorageUsage.bytes_used_for_account(account_id)
+      Account.where(id: account_id).update_all(bytes_used: bytes_used)
+    end
+end
