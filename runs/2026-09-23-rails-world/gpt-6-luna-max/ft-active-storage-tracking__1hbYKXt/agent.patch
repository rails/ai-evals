diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..0e97ffa
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,130 @@
+module StorageUsage
+  COUNTED_RICH_TEXT_NAMES = {
+    "Board" => "public_description",
+    "Card" => "description",
+    "Comment" => "body"
+  }.freeze
+
+  class << self
+    def recalculate_later(board_ids: [], account_ids: [], all_boards_for_account: false)
+      board_ids = Array(board_ids).compact.uniq
+      account_ids = Array(account_ids).compact.uniq
+
+      if board_ids.any? || account_ids.any?
+        StorageUsage::RecalculateJob.perform_later(
+          board_ids: board_ids,
+          account_ids: account_ids,
+          all_boards_for_account: all_boards_for_account
+        )
+      end
+    end
+
+    def recalculate_for_card_later(card_id:, account_id:)
+      if location = Card.where(id: card_id).pick(:board_id, :account_id)
+        recalculate_later(board_ids: [ location.first ], account_ids: [ location.last ])
+      elsif account_id
+        recalculate_later(account_ids: [ account_id ])
+      end
+    end
+
+    def recalculate_for_rich_text_later(record_type:, record_id:, name:, account_id:)
+      if COUNTED_RICH_TEXT_NAMES[record_type] == name
+        location = rich_text_owner_location(record_type, record_id)
+
+        recalculate_later(
+          board_ids: [ location&.first ],
+          account_ids: [ location&.last || account_id ]
+        )
+      end
+    end
+
+    def bytes_used_for_account(account_id)
+      card_image_attachments(account_id: account_id).sum("active_storage_blobs.byte_size") +
+        embedded_file_attachments(account_id: account_id).sum("active_storage_blobs.byte_size")
+    end
+
+    def bytes_used_for_board(board_id:, account_id:)
+      card_image_attachments(account_id: account_id, board_id: board_id).sum("active_storage_blobs.byte_size") +
+        embedded_file_attachments(account_id: account_id, board_id: board_id).sum("active_storage_blobs.byte_size")
+    end
+
+    private
+      def rich_text_owner_location(record_type, record_id)
+        case record_type
+        when "Board"
+          Board.where(id: record_id).pick(:id, :account_id)
+        when "Card"
+          Card.where(id: record_id).pick(:board_id, :account_id)
+        when "Comment"
+          Comment.joins(:card).where(comments: { id: record_id }).pick("cards.board_id", "comments.account_id")
+        end
+      end
+
+      def card_image_attachments(account_id:, board_id: nil)
+        attachments = ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id")
+          .where(active_storage_attachments: {
+            account_id: account_id,
+            record_type: "Card",
+            name: "image"
+          })
+          .where(cards: { account_id: account_id })
+
+        attachments = attachments.where(cards: { board_id: board_id }) if board_id
+        attachments
+      end
+
+      def embedded_file_attachments(account_id:, board_id: nil)
+        attachments = ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .where(active_storage_attachments: {
+            account_id: account_id,
+            record_type: "ActionText::RichText",
+            name: "embeds"
+          })
+          .where(action_text_rich_texts: { account_id: account_id })
+
+        if board_id
+          board_description = attachments.where(action_text_rich_texts: {
+            record_type: "Board",
+            name: "public_description",
+            record_id: Board.where(id: board_id, account_id: account_id).select(:id)
+          })
+          card_descriptions = attachments.where(action_text_rich_texts: {
+            record_type: "Card",
+            name: "description",
+            record_id: Card.where(board_id: board_id, account_id: account_id).select(:id)
+          })
+          comment_bodies = attachments.where(action_text_rich_texts: {
+            record_type: "Comment",
+            name: "body",
+            record_id: Comment.joins(:card)
+              .where(account_id: account_id, cards: { board_id: board_id, account_id: account_id })
+              .select(:id)
+          })
+        else
+          board_description = attachments.where(action_text_rich_texts: {
+            record_type: "Board",
+            name: "public_description",
+            record_id: Board.where(account_id: account_id).select(:id)
+          })
+          card_descriptions = attachments.where(action_text_rich_texts: {
+            record_type: "Card",
+            name: "description",
+            record_id: Card.where(account_id: account_id).select(:id)
+          })
+          comment_bodies = attachments.where(action_text_rich_texts: {
+            record_type: "Comment",
+            name: "body",
+            record_id: Comment.joins(:card)
+              .where(account_id: account_id, cards: { account_id: account_id })
+              .select(:id)
+          })
+        end
+
+        board_description.or(card_descriptions).or(comment_bodies)
+      end
+  end
+end
