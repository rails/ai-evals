+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  test "account and board usage counts only card images and rich text embeds" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    other_board = boards(:private)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    other_card = create_card_on(other_board, account: account)
+
+    sizes = { image: 2, board: 3, description: 5, comment: 7, other_board: 11, avatar: 13, unattached: 17 }
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      card.image.attach(blob_of_size(sizes[:image], account: account))
+      attach_rich_text(board, :public_description, blob_of_size(sizes[:board], account: account))
+      attach_rich_text(card, :description, blob_of_size(sizes[:description], account: account))
+      attach_rich_text(comment, :body, blob_of_size(sizes[:comment], account: account))
+      other_card.image.attach(blob_of_size(sizes[:other_board], account: account))
+      users(:david).avatar.attach(blob_of_size(sizes[:avatar], account: account))
+      blob_of_size(sizes[:unattached], account: account)
+    end
+
+    board_bytes = sizes.values_at(:image, :board, :description, :comment).sum
+    assert_equal board_bytes, board.reload.bytes_used
+    assert_equal board_bytes + sizes[:other_board], account.reload.bytes_used
+    assert_equal sizes[:other_board], other_board.reload.bytes_used
+  end
+
+  test "removing counted attachments refreshes usage" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      card.image.attach(blob_of_size(19, account: account))
+    end
+    assert_equal 19, board.reload.bytes_used
+    assert_equal 19, account.reload.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      card.image.purge
+    end
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "deleting comments and removing rich text embeds refreshes usage" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      attach_rich_text(card, :description, blob_of_size(29, account: account))
+      attach_rich_text(comment, :body, blob_of_size(31, account: account))
+    end
+    assert_equal 60, board.reload.bytes_used
+    assert_equal 60, account.reload.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      comment.destroy!
+    end
+    assert_equal 29, board.reload.bytes_used
+    assert_equal 29, account.reload.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      card.update!(description: "No attachment")
+    end
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "destroying a board removes its usage from the account" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    other_board = boards(:private)
+    card = cards(:logo)
+    other_card = create_card_on(other_board, account: account)
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      card.image.attach(blob_of_size(37, account: account))
+      other_card.image.attach(blob_of_size(41, account: account))
+    end
+    assert_equal 78, account.reload.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      board.destroy!
+    end
+
+    assert_equal 41, account.reload.bytes_used
+    assert_equal 41, other_board.reload.bytes_used
+  end
+
+  test "moving a card refreshes both boards without changing account usage" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    other_board = boards(:private)
+    card = cards(:logo)
+    Current.user = users(:david)
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      card.image.attach(blob_of_size(23, account: account))
+    end
+
+    assert_equal 23, board.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob do
+      card.move_to(other_board)
+    end
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 23, other_board.reload.bytes_used
+    assert_equal 23, account.reload.bytes_used
+  end
+
+  private
+    def blob_of_size(size, account:)
+      Current.with_account(account) do
+        ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new("x" * size),
+          filename: "file.bin",
+          content_type: "application/octet-stream"
+        )
+      end
+    end
+
+    def attach_rich_text(record, attribute, blob)
+      content = ActionText::Attachment.from_attachable(blob).to_html
+      record.update!(attribute => content)
+    end
+
+    def create_card_on(board, account:)
+      Card.create!(
+        account: account,
+        board: board,
+        creator: users(:david),
+        number: 6,
+        status: :drafted,
+        title: "Storage usage test",
+        last_active_at: Time.current
+      )
+    end
+end
