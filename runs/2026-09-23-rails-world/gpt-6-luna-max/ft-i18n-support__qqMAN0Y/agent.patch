+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class LocalizationMailerTest < ActionMailer::TestCase
+  test "magic link email uses the identity locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzy の確認コードは #{magic_link.code} です", email.subject
+    assert_includes email.html_part.body.decoded, "Fizzyの確認コード"
+    assert_includes email.html_part.body.decoded, "6文字の確認コード"
+    assert_includes email.text_part.body.decoded, "Fizzyのログイン画面"
+    assert_includes email.text_part.body.decoded, "15分"
+    assert_not_includes email.text_part.body.decoded, "Please enter"
+    assert_not_includes email.html_part.body.decoded, "Translation missing"
+  end
+end
