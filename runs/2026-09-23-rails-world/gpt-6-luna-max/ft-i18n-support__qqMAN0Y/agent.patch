diff --git a/script/audit_localizable_copy.rb b/script/audit_localizable_copy.rb
new file mode 100644
index 0000000..adbb30d
--- /dev/null
+++ b/script/audit_localizable_copy.rb
@@ -0,0 +1,26 @@
+#!/usr/bin/env ruby
+# Lists likely user-facing literals in ERB and application JavaScript so locale coverage
+# can be reviewed without mistaking code, CSS, or editor-package strings for copy.
+require "pathname"
+
+ROOT = Pathname.new(__dir__).parent
+
+PATTERNS = {
+  "erb text" => />([^<%=][^<]*)</,
+  "erb attribute" => /\b(?:aria-label|title|placeholder|alt|label|value)\s*=\s*["']([^"']+)["']/i,
+  "javascript string" => /(?:textContent|innerHTML|ariaLabel|title|placeholder|confirm\s*\(|alert\s*\()\s*(?:=|\()\s*["'`]([^"'`]+)["'`]/
+}
+
+paths = (ROOT.glob("app/views/**/*.erb") + ROOT.glob("app/javascript/**/*.js")).uniq.sort
+paths.each do |path|
+  content = path.read
+  PATTERNS.each do |kind, pattern|
+    content.to_enum(:scan, pattern).each do
+      match = Regexp.last_match
+      text = match[1].to_s.strip
+      next if text.empty? || text.match?(/\A(?:https?:|data:|#|\$|\{|<|%|\w+\(|[\d\W]+\z)/)
+      line = content[0...match.begin(0)].count("\n") + 1
+      puts "#{path.relative_path_from(ROOT)}:#{line}: #{kind}: #{text}"
+    end
+  end
+end
diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..92c5f90
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "a valid locale query selects and persists the locale for the browser session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyにログイン"
+
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "an unsupported locale does not switch a visitor away from English" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+
+  test "a selected locale is saved to the identity and used on later requests" do
+    sign_in_as :kevin
+
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_select "html[lang=ja]"
+
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "メインコンテンツへスキップ"
+  end
+
+  test "a locale selected before authentication is saved when the person requests a magic link" do
+    identity = identities(:kevin)
+
+    untenanted do
+      get new_session_path(locale: "ja")
+      post session_path, params: { email_address: identity.email_address }
+    end
+
+    assert_response :redirect
+    assert_equal "ja", identity.reload.locale
+  end
+
+  test "a saved identity locale is loaded by a clean browser after sign in" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    sign_in_as identity
+    get root_path
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "メインコンテンツへスキップ"
+    assert_not_includes response.body, "Translation missing"
+  end
+
+  test "the browser translation payload includes accessible Japanese strings" do
+    untenanted do
+      get new_session_path(locale: "ja")
+    end
+
+    payload = Nokogiri::HTML(response.body).at_css("body")["data-i18n"]
+
+    assert_equal "本当によろしいですか？", JSON.parse(payload).fetch("are_you_sure")
+    assert_equal "未選択", JSON.parse(payload).fetch("no_selection")
+  end
+
+  test "static error pages contain English and Japanese" do
+    [ "400.html", "404.html", "406-unsupported-browser.html", "422.html", "500.html" ].each do |filename|
+      page = Rails.root.join("public", filename).read
+
+      assert_includes page, 'lang="en"'
+      assert_includes page, 'lang="ja"'
+    end
+  end
+
+  test "identities without a locale keep the existing English page" do
+    sign_in_as :kevin
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_includes response.body, "Skip to main content"
+  end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
