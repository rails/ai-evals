+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,16 @@
+export function currentLocale() {
+  return document.documentElement.lang === "ja" ? "ja-JP" : "en-US"
+}
+
+export function translate(key) {
+  const translations = document.body?.dataset.i18n
+  if (translations) {
+    try {
+      return JSON.parse(translations)[key] || ""
+    } catch {
+      return ""
+    }
+  }
+
+  return ""
+}
