diff --git a/app/controllers/concerns/locale_selection.rb b/app/controllers/concerns/locale_selection.rb
new file mode 100644
index 0000000..289007d
--- /dev/null
+++ b/app/controllers/concerns/locale_selection.rb
@@ -0,0 +1,48 @@
+module LocaleSelection
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_locale
+    before_action :apply_identity_locale
+  end
+
+  private
+    def with_locale
+      @requested_locale = supported_locale(params[:locale])
+      session[:locale] = @requested_locale.to_s if @requested_locale
+
+      locale = @requested_locale || supported_locale(session[:locale]) || I18n.default_locale
+      I18n.with_locale(locale) { yield }
+    end
+
+    def apply_identity_locale
+      if Current.identity
+        locale = locale_preference || supported_locale(Current.identity.locale) || I18n.default_locale
+
+        if locale_preference
+          Current.identity.update!(locale: locale.to_s) unless Current.identity.locale == locale.to_s
+          session[:locale] = locale.to_s
+        elsif Current.identity.locale.present?
+          session[:locale] = locale.to_s
+        end
+
+        I18n.locale = locale
+      end
+    end
+
+    def supported_locale(value)
+      if value.is_a?(String) && I18n.available_locales.map(&:to_s).include?(value)
+        value.to_sym
+      end
+    end
+
+    def locale_preference
+      @requested_locale || supported_locale(session[:locale])
+    end
+
+    def persist_locale_preference(identity)
+      if locale = locale_preference
+        identity.update!(locale: locale.to_s) unless identity.locale == locale.to_s
+      end
+    end
+end
