diff --git a/test/controllers/timestamp_rendering_test.rb b/test/controllers/timestamp_rendering_test.rb
new file mode 100644
index 0000000..2b07ee0
--- /dev/null
+++ b/test/controllers/timestamp_rendering_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class TimestampRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "card and comment timestamps are sent to the browser unformatted" do
+    timestamp = Time.utc(2025, 9, 12, 17, 42)
+    card = cards(:logo)
+    card.update_columns(created_at: timestamp, last_active_at: timestamp, updated_at: timestamp)
+
+    comment = card.comments.create!(creator: users(:kevin), body: "A timestamp to format")
+    comment.update_columns(created_at: timestamp, updated_at: timestamp)
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select ".card__meta-text--added time[datetime=?][data-timestamp-format-value=?]", timestamp.iso8601, "relative"
+    assert_select ".comment__permalink-title time[datetime=?][data-timestamp-format-value=?]", timestamp.iso8601, "comment"
+    assert_select "button[data-bridge-share-created-at=?]", timestamp.iso8601
+    assert_select "button[data-bridge-share-last-active-at]"
+    assert_select "meta[name=timezone]", count: 0
+  end
+end
diff --git a/test/system/timestamp_rendering_test.rb b/test/system/timestamp_rendering_test.rb
new file mode 100644
index 0000000..b6aec3d
--- /dev/null
+++ b/test/system/timestamp_rendering_test.rb
@@ -0,0 +1,62 @@
+require "application_system_test_case"
+
+class TimestampRenderingSystemTest < ApplicationSystemTestCase
+  setup do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as(users(:kevin))
+    users(:kevin).settings.update!(timezone_name: "UTC")
+    page.execute_script("document.cookie = \"timezone=UTC; path=/\"")
+  end
+
+  test "comments render in the browser's timezone" do
+    zone = ActiveSupport::TimeZone["America/Los_Angeles"]
+    now = Time.now.in_time_zone(zone)
+    card = cards(:logo)
+    timestamps = {
+      "today" => now.change(hour: 13, min: 42, sec: 0, usec: 0).utc,
+      "yesterday" => now.yesterday.change(hour: 23, min: 10, sec: 0, usec: 0).utc,
+      "five days ago" => now.days_ago(5).change(hour: 12, min: 0, sec: 0, usec: 0).utc,
+      "older" => now.days_ago(10).change(hour: 12, min: 0, sec: 0, usec: 0).utc
+    }
+
+    timestamps.each do |body, timestamp|
+      card.comments.create!(creator: users(:kevin), body: body, created_at: timestamp, updated_at: timestamp)
+    end
+
+    visit card_url(card)
+
+    assert_selector ".comment__permalink-title time[datetime='#{timestamps['today'].iso8601}']", text: "1:42 PM"
+    assert_selector ".comment__permalink-title time[datetime='#{timestamps['yesterday'].iso8601}']", text: "yesterday"
+    assert_selector ".comment__permalink-title time[datetime='#{timestamps['five days ago'].iso8601}']", text: "5 days ago"
+    assert_selector ".comment__permalink-title time[datetime='#{timestamps['older'].iso8601}']", text: timestamps["older"].in_time_zone(zone).strftime("%b %-d")
+  end
+
+  test "automatic card closing uses calendar words in the browser timezone" do
+    zone = ActiveSupport::TimeZone["America/Los_Angeles"]
+    now = Time.now.in_time_zone(zone)
+    card = cards(:logo)
+    card.board.auto_postpone_period = 3.days
+    card.update_columns(last_active_at: now - 2.days)
+
+    visit card_url(card)
+
+    assert_selector "time[data-timestamp-format-value='future']", text: "tomorrow"
+
+    card.board.auto_postpone_period = 7.days
+    card.update_columns(last_active_at: now - 4.days)
+
+    visit card_url(card)
+
+    assert_selector "time[data-timestamp-format-value='future']", text: "in 3 days"
+  end
+
+  test "rerenders a connected timestamp when its raw value changes" do
+    visit card_url(cards(:logo))
+    timestamp = Time.now.utc - 3.days
+    element = find(".card__meta-text--added time")
+
+    page.execute_script("arguments[0].setAttribute('datetime', arguments[1])", element, timestamp.iso8601)
+
+    assert_equal "3 days ago", page.evaluate_script("arguments[0].textContent", element)
+  end
+end
