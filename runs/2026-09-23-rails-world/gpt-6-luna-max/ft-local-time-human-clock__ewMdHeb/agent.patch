diff --git a/app/helpers/timestamp_helper.rb b/app/helpers/timestamp_helper.rb
new file mode 100644
index 0000000..be12ca6
--- /dev/null
+++ b/app/helpers/timestamp_helper.rb
@@ -0,0 +1,21 @@
+module TimestampHelper
+  def timestamp_tag(timestamp, format:, **attributes)
+    data = (attributes.delete(:data) || {}).dup
+    data[:controller] = [ data[:controller], "timestamp" ].compact.join(" ")
+    data[:timestamp_format_value] = format
+
+    tag.time nil,
+      datetime: timestamp_datetime(timestamp),
+      data: data,
+      **attributes
+  end
+
+  private
+    def timestamp_datetime(timestamp)
+      if timestamp.respond_to?(:utc)
+        timestamp.utc.iso8601
+      else
+        timestamp.iso8601
+      end
+    end
+end
