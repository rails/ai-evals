diff --git a/app/javascript/controllers/timestamp_controller.js b/app/javascript/controllers/timestamp_controller.js
new file mode 100644
index 0000000..f331c2c
--- /dev/null
+++ b/app/javascript/controllers/timestamp_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/timestamp_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.timestampObserver = new MutationObserver(() => this.update())
+    this.timestampObserver.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-timestamp-format-value" ]
+    })
+
+    this.update()
+  }
+
+  disconnect() {
+    this.timestampObserver.disconnect()
+  }
+
+  update() {
+    this.element.textContent = formatTimestamp(this.element.dateTime, this.formatValue)
+  }
+}
