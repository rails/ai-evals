diff --git a/app/javascript/helpers/timestamp_helpers.js b/app/javascript/helpers/timestamp_helpers.js
new file mode 100644
index 0000000..24153cf
--- /dev/null
+++ b/app/javascript/helpers/timestamp_helpers.js
@@ -0,0 +1,107 @@
+const dayInMilliseconds = 24 * 60 * 60 * 1000
+const locale = document.documentElement.lang || navigator.language || "en"
+
+const relativeTimeFormatter = new Intl.RelativeTimeFormat(locale, { numeric: "always" })
+const calendarRelativeTimeFormatter = new Intl.RelativeTimeFormat(locale, { numeric: "auto" })
+
+export function formatTimestamp(value, format, now = new Date()) {
+  const timestamp = parseTimestamp(value, format)
+
+  if (Number.isNaN(timestamp.getTime())) return ""
+
+  switch (format) {
+    case "time":
+      return dateTimeFormatter({ hour: "numeric", minute: "2-digit" }).format(timestamp)
+
+    case "short-date":
+      return shortDate(timestamp, now)
+
+    case "date-with-year":
+      return dateTimeFormatter({ month: "short", day: "numeric", year: "numeric" }).format(timestamp)
+
+    case "numeric-date-time":
+      return dateTimeFormatter({ month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }).format(timestamp)
+
+    case "weekday-date":
+      return dateTimeFormatter({ weekday: "long", month: "long", day: "numeric", timeZone: "UTC" }).format(timestamp)
+
+    case "comment":
+      return formatCommentTimestamp(timestamp, now)
+
+    case "future":
+      return calendarRelativeTimeFormatter.format(calendarDayDifference(timestamp, now), "day")
+
+    case "relative":
+      return formatRelativeTimestamp(timestamp, now)
+
+    default:
+      return dateTimeFormatter({ dateStyle: "medium", timeStyle: "short" }).format(timestamp)
+  }
+}
+
+function parseTimestamp(value, format) {
+  if (value instanceof Date) return value
+
+  if (format === "weekday-date" && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return new Date(Date.UTC(year, month - 1, day))
+  }
+
+  return new Date(value)
+}
+
+function formatCommentTimestamp(timestamp, now) {
+  const days = calendarDayDifference(timestamp, now)
+
+  if (days === 0) return dateTimeFormatter({ hour: "numeric", minute: "2-digit" }).format(timestamp)
+  if (Math.abs(days) <= 6) return calendarRelativeTimeFormatter.format(days, "day")
+
+  return shortDate(timestamp, now)
+}
+
+function formatRelativeTimestamp(timestamp, now) {
+  const seconds = (timestamp - now) / 1000
+  const distance = Math.abs(seconds)
+  const direction = Math.sign(seconds)
+
+  if (distance < 45) return seconds < 0 ? "just now" : "in a moment"
+  if (distance < 90) return relativeTimeFormatter.format(direction, "minute")
+  if (distance < 45 * 60) return relativeTimeFormatter.format(Math.round(seconds / 60), "minute")
+  if (distance < 90 * 60) return relativeTimeFormatter.format(direction, "hour")
+  if (distance < 22 * 60 * 60) return relativeTimeFormatter.format(Math.round(seconds / (60 * 60)), "hour")
+  if (distance < 36 * 60 * 60) return relativeTimeFormatter.format(direction, "day")
+
+  const days = Math.round(seconds / (dayInMilliseconds / 1000))
+
+  if (Math.abs(days) < 26) return relativeTimeFormatter.format(days, "day")
+  if (Math.abs(days) < 45) return relativeTimeFormatter.format(Math.round(days / 7), "week")
+  if (Math.abs(days) < 320) return relativeTimeFormatter.format(Math.round(days / 30.44), "month")
+
+  return relativeTimeFormatter.format(Math.round(days / 365.24), "year")
+}
+
+function calendarDayDifference(timestamp, now) {
+  return localDay(timestamp) - localDay(now)
+}
+
+function localDay(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / dayInMilliseconds
+}
+
+function shortDate(timestamp, now) {
+  const options = { month: "short", day: "numeric" }
+  if (timestamp.getFullYear() !== now.getFullYear()) options.year = "numeric"
+  return dateTimeFormatter(options).format(timestamp)
+}
+
+const formatters = new Map()
+
+function dateTimeFormatter(options) {
+  const key = JSON.stringify(options)
+
+  if (!formatters.has(key)) {
+    formatters.set(key, new Intl.DateTimeFormat(locale, options))
+  }
+
+  return formatters.get(key)
+}
