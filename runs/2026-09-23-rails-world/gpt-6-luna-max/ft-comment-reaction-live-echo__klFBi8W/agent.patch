diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..4f97db9
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,49 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_comment_is_reactable, only: :create
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+    @reaction.creator = Current.user
+    @reaction.save
+
+    respond_to do |format|
+      format.turbo_stream { render :create, status: @reaction.persisted? ? :ok : :unprocessable_entity }
+      format.html { redirect_to card_path(@card, anchor: ActionView::RecordIdentifier.dom_id(@comment)) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, anchor: ActionView::RecordIdentifier.dom_id(@comment)) }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_comment_is_reactable
+      head :forbidden unless @comment.reactable?
+    end
+
+    def ensure_creatorship
+      head :forbidden unless Current.user == @reaction.creator
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..bf2bb9b
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,53 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger", "submit", "cancel", "reaction" ]
+  static values = { currentUserId: String }
+
+  reactionTargetConnected(reaction) {
+    if (reaction.dataset.creatorId === this.currentUserIdValue) {
+      reaction.classList.add("reaction--deleteable")
+    }
+  }
+
+  open() {
+    this.formTarget.classList.add("expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.hidden = false
+    this.submitTarget.hidden = false
+    this.cancelTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.inputTarget.value = ""
+    this.reset()
+  }
+
+  submitEnd({ detail: { success } }) {
+    if (success) this.reset()
+  }
+
+  toggleReaction({ currentTarget }) {
+    const reaction = currentTarget.closest(".reaction")
+
+    if (reaction.classList.contains("reaction--deleteable")) {
+      // Broadcast markup is rendered outside the recipient's session.
+      const authenticityToken = document.querySelector("meta[name='csrf-token']")?.content
+      const tokenField = reaction.querySelector("input[name='authenticity_token']")
+      if (tokenField && authenticityToken) tokenField.value = authenticityToken
+
+      const expanded = reaction.classList.toggle("expanded")
+      currentTarget.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  reset() {
+    this.inputTarget.value = ""
+    this.formTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+    this.inputTarget.hidden = true
+    this.submitTarget.hidden = true
+    this.cancelTarget.hidden = true
+  }
+}
