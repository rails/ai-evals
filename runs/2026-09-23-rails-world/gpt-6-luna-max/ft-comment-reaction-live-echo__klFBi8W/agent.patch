diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..0061267
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,37 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  before_validation :trim_content
+  before_validation :set_creator
+  validate :comment_is_reactable
+  validates :content, presence: true, length: { maximum: 16 }
+
+  after_commit :broadcast_reactions, on: [ :create, :destroy ]
+
+  scope :chronologically, -> { order created_at: :asc, id: :desc }
+  scope :preloaded, -> { preload(creator: [ :avatar_attachment, :account ]) }
+
+  private
+    def set_creator
+      self.creator ||= Current.user
+    end
+
+    def trim_content
+      self.content = content.strip if content
+    end
+
+    def comment_is_reactable
+      errors.add(:comment, "does not allow reactions") unless comment&.reactable?
+    end
+
+    def broadcast_reactions
+      if comment.persisted?
+        comment.broadcast_replace_to comment.card,
+          target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+          partial: "cards/comments/reactions/list",
+          locals: { comment: comment }
+      end
+    end
+end
