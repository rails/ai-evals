+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "add reaction input can be canceled, submitted, and used again to remove a reaction" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_button "Add a reaction"
+      assert_selector "input[aria-label='Your reaction']", visible: true
+      find("input[aria-label='Your reaction']", visible: true).set("Looks great")
+      find("button.reaction__cancel-btn", visible: true).click
+      assert_no_selector "input[aria-label='Your reaction']", visible: true
+
+      click_button "Add a reaction"
+      find("input[aria-label='Your reaction']", visible: true).set("🎉")
+      find("button.reaction__submit-btn", visible: true).click
+
+      assert_selector ".reaction", text: "🎉", wait: 5
+      assert_selector "button[aria-label='Add a reaction']"
+      assert_selector "input[aria-label='Your reaction'][hidden]", visible: :all
+
+      click_button "Add a reaction"
+      assert_equal "", find("input[aria-label='Your reaction']", visible: true).value
+      find("button.reaction__cancel-btn", visible: true).click
+
+      @comment.reactions.create!(content: "👀", creator: users(:david))
+      own_reaction = @comment.reactions.find_by!(content: "🎉")
+
+      within "##{dom_id(own_reaction)}" do
+        find("button.reaction__form-label").click
+        find("button.reaction__delete", visible: true).click
+      end
+
+      assert_no_selector ".reaction", text: "🎉", wait: 5
+      assert_selector "button[aria-label='Add a reaction']"
+    end
+  end
+
+  test "reaction broadcasts reach other open card views" do
+    visit card_url(@comment.card)
+    wait_for_cable_subscriptions
+
+    second_window = open_new_window
+    within_window second_window do
+      visit card_url(@comment.card)
+      wait_for_cable_subscriptions
+    end
+
+    reaction = @comment.reactions.create!(content: "👀", creator: users(:david))
+
+    within_window second_window do
+      within_reactions do
+        assert_selector ".reaction", text: "👀", wait: 5
+      end
+    end
+
+    reaction.destroy
+
+    within_window second_window do
+      within_reactions do
+        assert_no_selector ".reaction", text: "👀", wait: 5
+      end
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
