+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "defaults the creator and account from the current user and comment" do
+    reaction = @comment.reactions.new(content: "🎉")
+    reaction.valid?
+
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "accepts emoji and short text up to 16 characters" do
+    reaction = @comment.reactions.new(content: "Looks great!", creator: users(:kevin))
+
+    assert_predicate reaction, :valid?
+
+    reaction.content = "x" * 16
+    assert_predicate reaction, :valid?
+
+    reaction.content = "x" * 17
+    assert_not_predicate reaction, :valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "does not accept a blank reaction" do
+    reaction = @comment.reactions.new(content: "   ", creator: users(:kevin))
+
+    assert_not_predicate reaction, :valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "broadcasts the updated comment reactions to card viewers" do
+    assert_turbo_stream_broadcasts @comment.card do
+      @comment.reactions.create!(content: "🎉", creator: users(:kevin))
+    end
+  end
+
+  test "broadcasts reaction removals to card viewers" do
+    reaction = @comment.reactions.create!(content: "🎉", creator: users(:kevin))
+
+    assert_turbo_stream_broadcasts @comment.card do
+      reaction.destroy
+    end
+  end
+
+  test "system comments cannot be reacted to" do
+    reaction = comments(:logo_1).reactions.new(content: "🎉", creator: users(:kevin))
+
+    assert_not_predicate reaction, :valid?
+    assert_includes reaction.errors[:comment], "does not allow reactions"
+  end
+end
