@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  test "incinerates accounts canceled more than 30 days ago and their associated data" do
+    now = Time.current
+    account, user = create_account_with_user("Due for incineration")
+    account.create_cancellation!(initiated_by: user, created_at: now - 30.days - 1.second)
+    board = account.boards.create!(name: "Private board", creator: user)
+    card = board.cards.create!(title: "A card", creator: user)
+    storage_entry = Storage::Entry.create!(account: account, delta: 42, operation: "attach")
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(id: account.id)
+    assert_not User.exists?(id: user.id)
+    assert_not Board.exists?(id: board.id)
+    assert_not Card.exists?(id: card.id)
+    assert_not Account::Cancellation.exists?(account_id: account.id)
+    assert_not Storage::Entry.exists?(id: storage_entry.id)
+  end
+
+  test "does not incinerate accounts within the grace period or active accounts" do
+    travel_to Time.current do
+      now = Time.current
+      recent_account, recent_user = create_account_with_user("Recently canceled")
+      recent_account.create_cancellation!(initiated_by: recent_user, created_at: now - 30.days + 1.second)
+      boundary_account, boundary_user = create_account_with_user("Exactly 30 days")
+      boundary_account.create_cancellation!(initiated_by: boundary_user, created_at: now - 30.days)
+      reactivated_account, reactivated_user = create_account_with_user("Reactivated")
+      reactivated_account.create_cancellation!(initiated_by: reactivated_user, created_at: now - 60.days)
+      reactivated_account.reactivate
+      active_account, = create_account_with_user("Still active")
+
+      Current.without_account do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(id: recent_account.id)
+      assert Account.exists?(id: boundary_account.id)
+      assert Account.exists?(id: reactivated_account.id)
+      assert Account.exists?(id: active_account.id)
+    end
+  end
+
+  private
+    def create_account_with_user(name)
+      account = Account.create!(name: name)
+      user = account.users.create!(name: "Owner", role: :owner)
+      [ account, user ]
+    end
+end
