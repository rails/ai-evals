diff --git a/test/controllers/email_code_authentication_test.rb b/test/controllers/email_code_authentication_test.rb
new file mode 100644
index 0000000..e11cbd4
--- /dev/null
+++ b/test/controllers/email_code_authentication_test.rb
@@ -0,0 +1,183 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @join_code = account_join_codes(:"37s")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "sign in sends and verifies an email code" do
+    identity = identities(:kevin)
+    sessions_before = identity.sessions.count
+
+    assert_enqueued_emails 1 do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_redirected_to new_session_email_code_url(script_name: "")
+    code = delivered_code
+
+    untenanted do
+      get new_session_email_code_path(script_name: "")
+    end
+
+    assert_response :success
+    assert_select 'input[name="code"][autocomplete="one-time-code"]'
+
+    untenanted do
+      post session_email_code_path, params: { code: code }
+    end
+
+    assert_redirected_to landing_url(script_name: "")
+    assert_equal sessions_before + 1, identity.sessions.count
+    assert cookies[:session_token].present?
+  end
+
+  test "JSON sign in returns a session token after code verification" do
+  identity = identities(:kevin)
+
+  assert_enqueued_emails 1 do
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+    end
+  end
+
+  assert_response :accepted
+  code = delivered_code
+
+  untenanted do
+    post session_email_code_path(format: :json), params: { code: code }
+  end
+
+  assert_response :success
+  assert @response.parsed_body["session_token"].present?
+end
+
+test "sign up verifies an email code before account completion" do
+    email_address = "newuser-#{SecureRandom.hex(4)}@example.com"
+
+    assert_enqueued_emails 1 do
+      untenanted do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+    end
+
+    assert_redirected_to new_signup_email_code_url(script_name: "")
+    code = delivered_code
+
+    untenanted do
+      get new_signup_email_code_path(script_name: "")
+    end
+
+    assert_response :success
+    assert_select 'input[name="code"][autocomplete="one-time-code"]'
+
+    assert_difference -> { Identity.count }, 1 do
+      untenanted do
+        post signup_email_code_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_signup_completion_url(script_name: "")
+    assert cookies[:session_token].present?
+    identity = Identity.find_by!(email_address: email_address)
+
+    assert_difference -> { Account.count }, 1 do
+      untenanted do
+        post signup_completion_path(script_name: ""), params: { signup: { full_name: "New User" } }
+      end
+    end
+
+    assert_response :redirect
+    assert User.exists?(identity: identity, name: "New User")
+  end
+
+  test "joining sends and verifies an email code" do
+    email_address = identities(:mike).email_address
+
+    assert_enqueued_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug),
+        params: { email_address: email_address }
+    end
+
+    assert_redirected_to new_join_email_code_url(join_code: @join_code.code, script_name: @account.slug)
+    code = delivered_code
+
+    get new_join_email_code_path(join_code: @join_code.code, script_name: @account.slug)
+
+    assert_response :success
+    assert_select 'input[name="code"][autocomplete="one-time-code"]'
+
+    assert_difference -> { User.count }, 1 do
+      post join_email_code_path(join_code: @join_code.code, script_name: @account.slug),
+        params: { code: code }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert_equal 1, @join_code.reload.usage_count
+    assert User.exists?(account: @account, identity: identities(:mike))
+  end
+
+  test "joining a new email creates the identity and membership after code verification" do
+  email_address = "joiner-#{SecureRandom.hex(4)}@example.com"
+  identities_before = Identity.count
+  users_before = User.count
+
+  assert_enqueued_emails 1 do
+    post join_path(code: @join_code.code, script_name: @account.slug),
+      params: { email_address: email_address }
+  end
+
+  assert_equal identities_before, Identity.count
+  code = delivered_code
+
+  post join_email_code_path(join_code: @join_code.code, script_name: @account.slug),
+    params: { code: code }
+
+  assert_response :redirect
+  assert_equal identities_before + 1, Identity.count
+  assert_equal users_before + 1, User.count
+
+  identity = Identity.find_by!(email_address: email_address)
+  assert User.exists?(account: @account, identity: identity)
+end
+
+test "incorrect and expired sign-in codes do not create a session" do
+    identity = identities(:kevin)
+
+    assert_enqueued_emails 1 do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    code = delivered_code
+
+    untenanted do
+      post session_email_code_path, params: { code: "999999" }
+    end
+
+    assert_response :unprocessable_entity
+    assert_not cookies[:session_token].present?
+
+    travel_to 16.minutes.from_now do
+      untenanted do
+        post session_email_code_path, params: { code: code }
+      end
+    end
+
+    assert_response :unprocessable_entity
+    assert_not cookies[:session_token].present?
+  end
+
+  private
+    def delivered_code
+      perform_enqueued_jobs
+      email = ActionMailer::Base.deliveries.last
+      assert_match(/\b\d{6}\b/, email.subject)
+      email.subject[/\b\d{6}\b/]
+    end
+end
