+require "test_helper"
+
+class EmailCodeMailerTest < ActionMailer::TestCase
+  test "includes the authentication code in the subject and message" do
+    email = EmailCodeMailer.authentication_code("person@example.com", "012345")
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_equal "Your Fizzy code is 012345", email.subject
+    assert_match "012345", email.text_part.body.to_s
+    assert_match "15 minutes", email.text_part.body.to_s
+  end
+end
diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..fe3fef3
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "creates, authenticates, and consumes a six-digit code once" do
+    email_code, code = create_email_code
+
+    assert_match(/\A[0-9]{6}\z/, code)
+    assert_not_equal code, email_code.code_digest
+    wrong_code = code == "000000" ? "000001" : "000000"
+    assert_not email_code.consume_if_valid(wrong_code)
+    assert email_code.reload.consume_if_valid(code)
+    assert_not email_code.consume_if_valid(code)
+    assert_not EmailCode.exists?(email_code.id)
+  end
+
+  test "code is valid until its expiration time" do
+  email_code, code = create_email_code
+
+  travel_to email_code.expires_at - 1.second do
+    assert email_code.reload.active?
+    assert email_code.consume_if_valid(code)
+  end
+end
+
+test "code expires after fifteen minutes" do
+    email_code, code = create_email_code
+
+    travel_to email_code.expires_at + 1.second do
+      assert_not email_code.reload.active?
+      assert_not email_code.consume_if_valid(code)
+    end
+  end
+
+  private
+    def create_email_code
+      email_code = EmailCode.create_and_deliver(
+        email_address: "person@example.com",
+        purpose: :sign_in
+      )
+      perform_enqueued_jobs
+      code = ActionMailer::Base.deliveries.last.subject[/\b\d{6}\b/]
+      [ email_code, code ]
+    end
+end
