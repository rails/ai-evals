+class Sessions::EmailCodesController < ApplicationController
+  include EmailCodeAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+  before_action -> { set_email_code(purpose: :sign_in) }
+
+  def new
+    if @email_code&.active?
+      @email_address = @email_code.email_address
+    else
+      clear_email_code
+      redirect_to new_session_path, alert: "That code has expired. Enter your email to get a new one."
+    end
+  end
+
+  def create
+    if @email_code&.consume_if_valid(params[:code])
+      if identity = Identity.find_by(email_address: @email_code.email_address)
+        clear_email_code
+        start_new_session_for(identity)
+
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        clear_email_code
+        message = "That account could no longer be found. Sign up to create one."
+
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: message }
+          format.json { render json: { message: message }, status: :not_found }
+        end
+      end
+    else
+      message = "That code is incorrect or has expired."
+
+      respond_to do |format|
+        format.html do
+          @email_address = @email_code&.email_address
+          flash.now[:alert] = message
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
