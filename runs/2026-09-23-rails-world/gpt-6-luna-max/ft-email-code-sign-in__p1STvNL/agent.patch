@@ -0,0 +1,37 @@
+class JoinCodes::EmailCodesController < ApplicationController
+  include EmailCodeAuthentication
+  include JoinCodeFlow
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to join_path(code: params[:join_code], script_name: Current.account.slug), alert: "Try again later." }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+  before_action -> { set_email_code(purpose: :join, join_code: @join_code) }
+
+  layout "public"
+
+  def new
+    if @email_code&.active?
+      @email_address = @email_code.email_address
+    else
+      clear_email_code
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug),
+        alert: "That code has expired. Enter your email to get a new one."
+    end
+  end
+
+  def create
+    if @email_code&.consume_if_valid(params[:code])
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      clear_email_code
+      terminate_session if Current.session
+      start_new_session_for(identity)
+      join_identity(identity)
+    else
+      @email_address = @email_code&.email_address
+      flash.now[:alert] = "That code is incorrect or has expired."
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
