--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,27 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  EMAIL_CODE_SESSION_KEY = :email_code_id
+
+  private
+    def send_email_code(email_address:, purpose:, join_code: nil)
+      @email_code = EmailCode.create_and_deliver(
+        email_address: email_address,
+        purpose: purpose,
+        join_code: join_code
+      )
+      session[EMAIL_CODE_SESSION_KEY] = @email_code.id
+    end
+
+    def set_email_code(purpose:, join_code: nil)
+      @email_code = EmailCode.find_by(
+        id: session[EMAIL_CODE_SESSION_KEY],
+        purpose: purpose,
+        join_code: join_code
+      )
+    end
+
+    def clear_email_code
+      session.delete(EMAIL_CODE_SESSION_KEY)
+    end
+end
