diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..e00d75c
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,64 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_PERIOD = 15.minutes
+  PURPOSES = %w[ sign_in sign_up join ].freeze
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  normalizes :email_address, with: ->(email_address) { email_address&.strip&.downcase.presence }
+
+  validates :email_address, presence: true, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :expires_at, presence: true
+  validates :join_code, presence: true, if: -> { purpose == "join" }
+  validates :join_code, absence: true, unless: -> { purpose == "join" }
+
+  def self.create_and_deliver(email_address:, purpose:, join_code: nil)
+    where("expires_at <= ?", Time.current).delete_all
+
+    code = SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+    email_code = create!(
+      email_address: email_address,
+      code_digest: digest(code),
+      purpose: purpose,
+      join_code: join_code,
+      expires_at: EXPIRATION_PERIOD.from_now
+    )
+
+    EmailCodeMailer.authentication_code(email_code.email_address, code).deliver_later
+    email_code
+  end
+
+  def self.digest(code)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code)
+  end
+
+  def active?
+    expires_at > Time.current
+  end
+
+  def consume_if_valid(code)
+    consumed = false
+
+    self.class.transaction do
+      if current_code = self.class.lock.find_by(id: id)
+        if current_code.active? && current_code.matches_code?(code)
+          current_code.destroy!
+          consumed = true
+        end
+      end
+    end
+
+    consumed
+  end
+
+  def matches_code?(code)
+    code = code.to_s.strip
+
+    if code.match?(/\A[0-9]{#{CODE_LENGTH}}\z/)
+      ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest(code))
+    else
+      false
+    end
+  end
+end
