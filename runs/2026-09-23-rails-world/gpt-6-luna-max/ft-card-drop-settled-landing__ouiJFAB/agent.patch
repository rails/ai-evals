diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..94f061c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,317 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "zone", "card" ]
+
+  cardTargetConnected(card) {
+    this.#makeDraggable(card)
+  }
+
+  refresh() {
+    this.cardTargets.forEach(card => this.#makeDraggable(card))
+  }
+
+  connect() {
+    this.draggedCard = null
+    this.sourceZone = null
+    this.hoveredZone = null
+    this.pendingMoves = new Map()
+  }
+
+  disconnect() {
+    this.#finishDrag()
+  }
+
+  start(event) {
+    const card = event.target.closest(".card[draggable='true']")
+    const zone = card && this.#zoneFor(card)
+
+    if (!zone) return
+
+    this.draggedCard = card
+    this.sourceZone = zone
+    card.classList.add(this.draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.clearData()
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  end() {
+    this.#finishDrag()
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    const zone = this.#zoneFor(event.target)
+    if (!zone) {
+      this.#clearHoveredZone()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    if (zone === this.sourceZone) {
+      this.#clearHoveredZone()
+    } else {
+      this.#hover(zone)
+    }
+  }
+
+  leave(event) {
+    if (!event.relatedTarget || this.element.contains(event.relatedTarget)) return
+
+    this.#clearHoveredZone()
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const zone = this.#zoneFor(event.target)
+
+    if (!card || !zone) {
+      this.#finishDrag()
+      return
+    }
+
+    event.preventDefault()
+
+    if (zone !== this.sourceZone && this.#canDropOn(zone)) {
+      const previousState = this.#snapshot(card)
+      const destination = this.#stateFor(card, zone)
+      const savedState = this.#placeCard(card, destination)
+
+      if (savedState) this.#saveMove(card, zone, savedState, previousState)
+    }
+
+    this.#finishDrag()
+  }
+
+  #makeDraggable(card) {
+    card.draggable = true
+    card.querySelector(".card__link")?.setAttribute("draggable", "true")
+  }
+
+  #canDropOn(zone) {
+    const destination = zone.dataset.dragAndDropDestination
+
+    if (destination === "column") {
+      return Boolean(zone.dataset.dragAndDropColumnId)
+    } else {
+      return [ "triage", "not-now", "closed" ].includes(destination)
+    }
+  }
+
+  #zoneFor(element) {
+    const zone = element.closest('[data-drag-and-drop-target~="zone"]')
+
+    if (this.zoneTargets.includes(zone)) {
+      return zone
+    } else {
+      return null
+    }
+  }
+
+  #hover(zone) {
+    if (this.hoveredZone !== zone) {
+      this.#clearHoveredZone()
+      zone.classList.add(this.hoverContainerClass)
+      this.hoveredZone = zone
+    }
+  }
+
+  #clearHoveredZone() {
+    this.hoveredZone?.classList.remove(this.hoverContainerClass)
+    this.hoveredZone = null
+  }
+
+  #finishDrag() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.sourceZone = null
+    this.#clearHoveredZone()
+  }
+
+  #stateFor(card, zone) {
+    const destination = zone.dataset.dragAndDropDestination
+    let columnId = null
+
+    if (destination === "column") {
+      columnId = zone.dataset.dragAndDropColumnId
+    } else if (destination === "closed") {
+      columnId = card.dataset.cardColumnId || null
+    }
+
+    return { zone, destination, columnId }
+  }
+
+  #snapshot(card) {
+    const zone = this.#zoneFor(card)
+    const state = this.#stateFor(card, zone)
+
+    return {
+      ...state,
+      position: {
+        parent: card.parentElement,
+        nextSibling: card.nextSibling
+      }
+    }
+  }
+
+  #placeCard(card, state) {
+    const list = state.zone.querySelector(".cards__list")
+    if (!list) return null
+
+    const previousZone = this.#zoneFor(card)
+    this.#insertCard(card, list, state)
+    this.#updateCard(card, state)
+
+    if (previousZone && previousZone !== state.zone) {
+      this.#adjustCount(previousZone, -1)
+      this.#adjustCount(state.zone, 1)
+    }
+
+    return this.#snapshot(card)
+  }
+
+  #insertCard(card, list, state) {
+    // Newly moved cards sort first; active lists retain their golden-first grouping.
+    const otherCards = Array.from(list.querySelectorAll(".card")).filter(otherCard => otherCard !== card)
+    let referenceCard
+
+    if (state.destination === "column" || state.destination === "triage") {
+      if (card.classList.contains("golden-effect")) {
+        referenceCard = otherCards[0]
+      } else {
+        referenceCard = otherCards.filter(otherCard => otherCard.classList.contains("golden-effect")).at(-1) || otherCards[0]
+        if (referenceCard?.classList.contains("golden-effect")) {
+          referenceCard.after(card)
+          return
+        }
+      }
+    } else {
+      referenceCard = otherCards[0]
+    }
+
+    if (referenceCard) {
+      referenceCard.before(card)
+    } else {
+      list.prepend(card)
+    }
+  }
+
+  #updateCard(card, state) {
+    card.dataset.cardColumnId = state.columnId || ""
+    card.classList.toggle("card--active", [ "column", "triage" ].includes(state.destination))
+    card.classList.toggle("card--postponed", state.destination === "not-now")
+
+    card.querySelectorAll(".card__stages [data-column-id]").forEach(columnName => {
+      columnName.classList.toggle("card__column-name--current", columnName.dataset.columnId === state.columnId)
+    })
+
+    let columnLabel = card.querySelector(".card__header .card__column-name--current")
+
+    if (state.destination === "column") {
+      if (!columnLabel) {
+        columnLabel = document.createElement("span")
+        columnLabel.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+        const columnName = document.createElement("span")
+        columnName.className = "overflow-ellipsis"
+        columnLabel.append(columnName)
+        card.querySelector(".card__header")?.append(columnLabel)
+      }
+
+      const columnName = columnLabel.querySelector(".overflow-ellipsis") || columnLabel
+      columnName.textContent = state.zone.dataset.columnName
+    } else {
+      columnLabel?.remove()
+    }
+  }
+
+  #adjustCount(zone, adjustment) {
+    const count = Number(zone.dataset.dragAndDropCount)
+    if (!Number.isFinite(count)) return
+
+    const updatedCount = Math.max(count + adjustment, 0)
+    zone.dataset.dragAndDropCount = updatedCount
+
+    const countLabel = zone.querySelector(".cards__expander-count")
+    if (countLabel) countLabel.textContent = updatedCount > 99 ? "99+" : updatedCount
+  }
+
+  #restoreCard(card, state) {
+    if (!this.element.contains(card)) return
+
+    const previousZone = this.#zoneFor(card)
+    const { parent, nextSibling } = state.position || {}
+
+    if (parent?.isConnected && state.zone.contains(parent)) {
+      parent.insertBefore(card, nextSibling?.parentNode === parent ? nextSibling : null)
+      this.#updateCard(card, state)
+
+      if (previousZone && previousZone !== state.zone) {
+        this.#adjustCount(previousZone, -1)
+        this.#adjustCount(state.zone, 1)
+      }
+    } else {
+      this.#placeCard(card, state)
+    }
+  }
+
+  #saveMove(card, zone, savedState, previousState) {
+    const key = card.id
+    const move = this.pendingMoves.get(key) || {
+      promise: Promise.resolve(),
+      savedState: previousState,
+      version: 0
+    }
+    const version = ++move.version
+
+    const request = move.promise.then(() => this.#requestMove(card, zone))
+    const settled = request.then(
+      () => { move.savedState = savedState },
+      error => {
+        console.error("Could not move card", error)
+
+        if (move.version === version) {
+          this.#restoreCard(card, move.savedState)
+        }
+      }
+    )
+
+    move.promise = settled
+    this.pendingMoves.set(key, move)
+
+    settled.then(() => {
+      if (move.version === version) this.pendingMoves.delete(key)
+    })
+  }
+
+  async #requestMove(card, zone) {
+    const destination = zone.dataset.dragAndDropDestination
+    let response
+
+    if (destination === "column") {
+      response = await post(card.dataset.cardTriageUrl, {
+        query: { column_id: zone.dataset.dragAndDropColumnId },
+        responseKind: "json"
+      })
+    } else if (destination === "triage") {
+      response = await destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+    } else if (destination === "not-now") {
+      response = await post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+    } else if (destination === "closed") {
+      response = await post(card.dataset.cardClosureUrl, { responseKind: "json" })
+    }
+
+    if (!response?.ok || response.redirected) {
+      throw new Error(`Request failed with status ${response?.statusCode || "unknown"}`)
+    }
+  }
+}
