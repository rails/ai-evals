diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..a8a9c83
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,116 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "dragging a card moves it immediately and saves its new column" do
+    sign_in_as(users(:kevin))
+
+    board = boards(:writebook)
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(board)
+    assert_selector "##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(card, :article)}[draggable='true'] .card__link[draggable='true']", visible: :all
+
+    page.execute_script <<~JAVASCRIPT
+      const card = document.getElementById(#{dom_id(card, :article).to_json})
+      const link = card.querySelector(".card__link")
+      const column = document.getElementById(#{dom_id(column).to_json})
+      const dataTransfer = new DataTransfer()
+
+      link.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+      column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      window.dragAndDropStylesApplied = card.classList.contains("drag-and-drop__dragged-item") && column.classList.contains("drag-and-drop__hover-container")
+      column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+      window.dragAndDropMovedImmediately = column.contains(card)
+      link.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+    JAVASCRIPT
+
+    assert page.evaluate_script("window.dragAndDropStylesApplied")
+    assert page.evaluate_script("window.dragAndDropMovedImmediately")
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+
+    assert_equal column, wait_for { card.reload.column }
+  end
+
+  test "dragging between status areas updates a card's status immediately" do
+    sign_in_as(users(:kevin))
+
+    board = boards(:writebook)
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(board)
+    assert_selector "##{dom_id(card, :article)}"
+    assert_selector "#not-now .cards__list", visible: :all
+    assert_selector "#closed-cards .cards__list", visible: :all
+
+    not_now_count = page.evaluate_script("Number(document.getElementById('not-now').dataset.dragAndDropCount)")
+    drag_to(card, "not-now")
+    assert page.evaluate_script("document.getElementById(#{dom_id(card, :article).to_json}).classList.contains('card--postponed')")
+    assert_equal not_now_count + 1, page.evaluate_script("Number(document.getElementById('not-now').dataset.dragAndDropCount)")
+    assert wait_for { card.reload.postponed? }
+
+    drag_to(card, "closed-cards")
+    assert page.evaluate_script("!document.getElementById(#{dom_id(card, :article).to_json}).classList.contains('card--active')")
+    assert wait_for { card.reload.closed? }
+
+    drag_to(card, "maybe")
+    assert page.evaluate_script("document.getElementById(#{dom_id(card, :article).to_json}).classList.contains('card--active')")
+    assert wait_for { card.reload.awaiting_triage? }
+
+    drag_to(card, dom_id(column))
+    assert_equal column, wait_for { card.reload.column }
+  end
+
+  test "dropping a card in its current column does not reorder cards" do
+    sign_in_as(users(:kevin))
+
+    board = boards(:writebook)
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    visit board_url(board)
+    assert_selector "##{dom_id(card, :article)}"
+
+    page.execute_script <<~JAVASCRIPT
+      const column = document.getElementById(#{dom_id(column).to_json})
+      window.cardOrderBeforeDrop = Array.from(column.querySelectorAll(".card"), card => card.id).join(",")
+    JAVASCRIPT
+
+    drag_to(card, dom_id(column))
+
+    assert_equal page.evaluate_script("window.cardOrderBeforeDrop"), page.evaluate_script("Array.from(document.getElementById(#{dom_id(column).to_json}).querySelectorAll('.card'), card => card.id).join(',')")
+    assert_equal column, card.reload.column
+  end
+
+  private
+    def drag_to(card, destination_id)
+      page.execute_script <<~JAVASCRIPT
+        const card = document.getElementById(#{dom_id(card, :article).to_json})
+      const link = card.querySelector(".card__link")
+        const destination = document.getElementById(#{destination_id.to_json})
+        const dataTransfer = new DataTransfer()
+
+        link.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        window.dragAndDropMovedImmediately = destination.contains(card)
+        link.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JAVASCRIPT
+
+      assert page.evaluate_script("window.dragAndDropMovedImmediately")
+    end
+
+    def wait_for
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        loop do
+          value = yield
+          return value if value
+          sleep 0.05
+        end
+      end
+    end
+end
