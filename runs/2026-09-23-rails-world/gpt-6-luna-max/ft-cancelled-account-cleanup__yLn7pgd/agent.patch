diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..e07d93d 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,36 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where("account_cancellations.created_at < ?", INCINERATION_GRACE_PERIOD.ago)
+    }
+
+    after_destroy :delete_account_scoped_data
+  end
+
+  def incinerate
+    with_lock do
+      destroy! if incineration_due?
+    end
+  end
+
+  private
+    def incineration_due?
+      cancellation.present? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+    end
+
+    def delete_account_scoped_data
+      Search::Record.for(id).where(account_id: id).destroy_all
+      ActionText::RichText.where(account_id: id).destroy_all
+      # Identity avatars are global, even if their blobs were created in an account context.
+      identity_blob_ids = ActiveStorage::Attachment.where(record_type: "Identity").select(:blob_id)
+
+      ActiveStorage::Attachment.where(account_id: id).where.not(record_type: "Identity").find_each(&:purge)
+      ActiveStorage::Blob.where(account_id: id).where.not(id: identity_blob_ids).find_each(&:purge)
+      ActiveStorage::VariantRecord.where(account_id: id).where.not(blob_id: identity_blob_ids).delete_all
+      Storage::Entry.where(account_id: id).delete_all
+    end
 end
