diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..1cbcde0
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago" do
+    due_account = create_canceled_account("Due", 31.days.ago)
+    recent_account = create_canceled_account("Recent", 29.days.ago)
+    active_account = Account.create!(name: "Active")
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+    assert_not Account::Cancellation.exists?(account_id: due_account.id)
+    assert Account::Cancellation.exists?(account_id: recent_account.id)
+  end
+
+  test "deletes account data but preserves shared identities" do
+    account = Account.create!(name: "Incineration Data")
+    identity = identities(:jason)
+    account_id = account.id
+    user = nil
+    board = nil
+    card = nil
+    identity_attachment = nil
+    identity_blob = nil
+    identity_variant = nil
+
+    Current.with_account(account) do
+      user = account.users.create!(identity: identity, name: "Account User", role: :owner)
+      mentionee = account.users.create!(identity: identities(:david), name: "Mentionee")
+      board = account.boards.create!(creator: user, name: "Account Board")
+      card = board.cards.create!(creator: user, title: "Account Card")
+      card.update!(description: ActionText::Content.new("Account description"))
+      Mention.create!(source: card, mentioner: user, mentionee: mentionee)
+      Card::NotNow.create!(card: card, user: user)
+
+      identity_blob = ActiveStorage::Blob.create_before_direct_upload!(
+        filename: "identity-avatar.png", content_type: "image/png", byte_size: 0, checksum: "pending"
+      )
+      identity_attachment = ActiveStorage::Attachment.create!(
+        record: identity, name: "avatar", blob: identity_blob, account: account
+      )
+      identity_variant = ActiveStorage::VariantRecord.create!(
+        blob: identity_blob, account: account, variation_digest: "identity-avatar-variant"
+      )
+      Search::Record.for(account_id).create!(
+        account_id: account_id, searchable_type: "Card", searchable_id: card.id,
+        card_id: card.id, board_id: board.id, title: card.title, content: "Account description", created_at: card.created_at
+      )
+
+      File.open(file_fixture("avatar.png")) do |file|
+        user.avatar.attach(io: file, filename: "avatar.png", content_type: "image/png")
+      end
+
+      Storage::Entry.record(account: account, board: board, delta: 1024, operation: "attach")
+
+      cancellation = account.create_cancellation!(initiated_by: user)
+      cancellation.update_column(:created_at, 31.days.ago)
+    end
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account_id)
+    assert_not User.exists?(user.id)
+    assert_not Board.exists?(board.id)
+    assert_not Card.exists?(card.id)
+    assert_not Mention.exists?(account_id: account_id)
+    assert_not Card::NotNow.exists?(account_id: account_id)
+    assert_not Search::Record.for(account_id).where(account_id: account_id).exists?
+    assert_not ActionText::RichText.where(account_id: account_id).exists?
+    assert_not ActiveStorage::Attachment.where(account_id: account_id).where.not(record_type: "Identity").exists?
+    assert_not ActiveStorage::Blob.where(account_id: account_id).where.not(id: identity_blob.id).exists?
+    assert ActiveStorage::Attachment.exists?(identity_attachment.id)
+    assert ActiveStorage::Blob.exists?(identity_blob.id)
+    assert ActiveStorage::VariantRecord.exists?(identity_variant.id)
+    assert_not ActiveStorage::VariantRecord.where(account_id: account_id).where.not(blob_id: identity_blob.id).exists?
+    assert_not Storage::Entry.where(account_id: account_id).exists?
+    assert Identity.exists?(identity.id)
+  end
+
+  test "uses the latest cancellation after reactivation" do
+    account = create_canceled_account("Reactivated", 31.days.ago)
+    account.reactivate
+    account.create_cancellation!(initiated_by: users(:jason))
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+    assert account.reload.cancelled?
+  end
+
+  test "does not incinerate an account canceled exactly 30 days ago" do
+    travel_to Time.current do
+      account = create_canceled_account("Exactly 30 days", 30.days.ago)
+
+      Current.without_account do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(account.id)
+    end
+  end
+
+  private
+    def create_canceled_account(name, canceled_at)
+      Account.create!(name: name).tap do |account|
+        cancellation = account.create_cancellation!(initiated_by: users(:jason))
+        cancellation.update_column(:created_at, canceled_at)
+      end
+    end
+end
