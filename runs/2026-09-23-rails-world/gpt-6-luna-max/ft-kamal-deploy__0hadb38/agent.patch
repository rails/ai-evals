diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..3e4067e
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,46 @@
+# Point this DNS name at the server. It is used for SSH, proxy TLS, and app links.
+x-hostname: &hostname fizzy.example.com
+
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - *hostname
+
+proxy:
+  ssl: true
+  host: *hostname
+
+# Kamal runs a local registry and tunnels it to the server over SSH.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    RAILS_ENV: production
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+    APP_HOST: *hostname
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    SOLID_QUEUE_IN_PUMA: "true"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *hostname
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    MAILER_FROM_ADDRESS: "Fizzy <support@fizzy.example.com>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# SQLite databases and local Active Storage uploads all live under /rails/storage.
+volumes:
+  - fizzy-storage:/rails/storage
+
+asset_path: /rails/public/assets
