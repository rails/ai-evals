+# Copy this file to .kamal/secrets and fill in the values before deploying.
+# Keep .kamal/secrets private; it is ignored by git.
+
+# Generate once with `bin/rails secret` and keep it stable across deploys.
+SECRET_KEY_BASE=
+
+# Leave the SMTP credentials empty only if your relay does not require auth.
+SMTP_USERNAME=
+SMTP_PASSWORD=
