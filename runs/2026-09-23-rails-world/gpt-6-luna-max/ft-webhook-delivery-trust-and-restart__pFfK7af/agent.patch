@@ -1,4 +1,9 @@
 class Webhook::Delivery < ApplicationRecord
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +15,29 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  class << self
+    def cleanup
+      where(arel_table[:created_at].lt(1.week.ago)).delete_all
+    end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      DeliverJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    return unless claim_for_delivery
+
+    if webhook.active?
+      attempt_delivery
+      track_result
+    else
+      update!(state: :errored, response: { error: "webhook_inactive" })
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +55,82 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    code = response&.dig("code")
+    completed? && response&.dig("error").blank? && code.present? && code.to_i.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      claimed = self.class
+        .where(id: id, state: :pending)
+        .update_all(state: :in_progress, updated_at: Time.current)
+
+      reload if claimed == 1
+      claimed == 1
+    end
+
+    def attempt_delivery
+      body = payload
+      uri = URI.parse(webhook.url)
+      timestamp = event.created_at.utc.iso8601(3)
+      headers = {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+      http_request = Net::HTTP::Post.new(uri.request_uri, headers)
+      http_request.body = body
+
+      update!(request: { headers: headers })
+
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.write_timeout = WRITE_TIMEOUT if http.respond_to?(:write_timeout=)
+      http.max_retries = 0 if http.respond_to?(:max_retries=)
+
+      http_response = http.start { |connection| connection.request(http_request) }
+
+      update!(
+        state: :completed,
+        response: { code: http_response.code.to_i, error: nil }
+      )
+    rescue StandardError
+      update!(state: :errored, response: { error: "destination_unreachable" })
+    end
+
+    def track_result
+      tracker = webhook.ensure_delinquency_tracker
+
+      if succeeded?
+        tracker.record_success
+      else
+        tracker.record_failure
+      end
+    end
+
+    def payload
+      if webhook.for_slack? || webhook.for_campfire? || webhook.for_basecamp?
+        message = render_event(:html)
+
+        if webhook.for_slack?
+          { text: message }.to_json
+        elsif webhook.for_campfire?
+          { message: { body: message } }.to_json
+        else
+          { content: message }.to_json
+        end
+      else
+        render_event(:json)
+      end
+    end
+
+    def render_event(format)
+      url_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      renderer = ApplicationController.renderer.new(**url_options.merge(script_name: account.slug))
+      renderer.render(template: "webhooks/event", formats: [ format ], assigns: { event: event })
+    end
 end
