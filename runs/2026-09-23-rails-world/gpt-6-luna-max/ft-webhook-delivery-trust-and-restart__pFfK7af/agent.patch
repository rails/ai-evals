+++ b/test/models/event_webhook_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class EventWebhookTest < ActiveSupport::TestCase
+  test "creates one delivery for each active subscribed board webhook" do
+    webhook = webhooks(:active)
+    webhook.update!(subscribed_actions: [ "card_published" ])
+
+    event = Event.new(
+      board: webhook.board,
+      creator: users(:david),
+      eventable: cards(:buy_domain),
+      action: "card_published"
+    )
+
+    assert_enqueued_jobs 1, only: Webhook::Delivery::DeliverJob do
+      assert_difference -> { Webhook::Delivery.where(webhook: webhook).count }, 1 do
+        event.save!
+      end
+    end
+
+    delivery = Webhook::Delivery.find_by!(webhook: webhook, event: event)
+    assert_equal "pending", delivery.state
+
+    assert_no_enqueued_jobs only: Webhook::Delivery::DeliverJob do
+      event.send(:deliver_to_webhooks_later)
+    end
+  end
+
+  test "delivers the event in the queued job" do
+    webhook = webhooks(:active)
+    webhook.update!(url: "https://receiver.example.com/events", subscribed_actions: [ "card_published" ])
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+    event = Event.new(
+      board: webhook.board,
+      creator: users(:david),
+      eventable: cards(:buy_domain),
+      action: "card_published"
+    )
+
+    perform_enqueued_jobs only: Webhook::Delivery::DeliverJob do
+      event.save!
+    end
+
+    delivery = Webhook::Delivery.find_by!(webhook: webhook, event: event)
+    assert_equal "completed", delivery.state
+    assert_requested stub, times: 1
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..dd8395c
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "deactivates a webhook after ten failures within an hour" do
+    webhook = webhooks(:active)
+    tracker = webhook.ensure_delinquency_tracker
+    first_failure = Time.current
+
+    9.times do |minute|
+      tracker.record_failure(at: first_failure + minute.minutes)
+    end
+
+    assert webhook.reload.active?
+
+    tracker.record_failure(at: first_failure + 59.minutes)
+
+    assert_not webhook.reload.active?
+    assert_equal 10, tracker.reload.consecutive_failures_count
+  end
+
+  test "starts a new failure window after an hour" do
+    webhook = webhooks(:active)
+    tracker = webhook.ensure_delinquency_tracker
+    first_failure = Time.current
+
+    9.times do |minute|
+      tracker.record_failure(at: first_failure + minute.minutes)
+    end
+
+    tracker.record_failure(at: first_failure + 1.hour + 1.second)
+
+    assert webhook.reload.active?
+    assert_equal 1, tracker.reload.consecutive_failures_count
+    assert_in_delta (first_failure + 1.hour + 1.second).to_f, tracker.first_failure_at.to_f, 0.000001
+  end
+
+  test "a successful delivery resets consecutive failures" do
+    tracker = webhooks(:active).ensure_delinquency_tracker
+    9.times { tracker.record_failure }
+
+    tracker.record_success
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..f145801 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,72 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "posts a signed event and records the result exactly once" do
+    webhook = webhooks(:active)
+    webhook.update!(url: "https://receiver.example.com/events")
+    event = events(:buy_domain_sent_back_to_triage)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    request_body = nil
+    stub = stub_request(:post, webhook.url).with do |request|
+      request_body = request.body
+      true
+    end.to_return(status: 202)
+
+    delivery.deliver
+    delivery.deliver
+
+    assert_requested stub, times: 1
+    assert_equal event.id, JSON.parse(request_body).fetch("id")
+    assert_equal "completed", delivery.reload.state
+    assert delivery.succeeded?
+    assert_equal 202, delivery.response_summary[:code]
+
+    headers = delivery.request.fetch("headers")
+    assert_equal "fizzy/1.0.0 Webhook", headers.fetch("User-Agent")
+    assert_equal "application/json", headers.fetch("Content-Type")
+    assert_equal event.created_at.utc.iso8601(3), headers.fetch("X-Webhook-Timestamp")
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request_body),
+      headers.fetch("X-Webhook-Signature")
+    assert_not delivery.sanitized_request.dig(:headers).key?("X-Webhook-Signature")
+  end
+
+  test "logs an unsuccessful HTTP response as a delivery failure" do
+    webhook = webhooks(:active)
+    webhook.update!(url: "https://receiver.example.com/events")
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:buy_domain_sent_back_to_triage))
+    stub_request(:post, webhook.url).to_return(status: 503)
+
+    delivery.deliver
+
+    assert_equal "completed", delivery.reload.state
+    assert delivery.failed?
+    assert_equal 503, delivery.response_summary[:code]
+    assert_equal 1, webhook.ensure_delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "logs a connection error and does not retry the delivery" do
+    webhook = webhooks(:active)
+    webhook.update!(url: "https://receiver.example.com/events")
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:buy_domain_sent_back_to_triage))
+    stub = stub_request(:post, webhook.url).to_raise(SocketError)
+
+    delivery.deliver
+    delivery.deliver
+
+    assert_requested stub, times: 1
+    assert_equal "errored", delivery.reload.state
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+  end
+
+  test "cleanup removes delivery records older than one week" do
+    old_delivery = webhook_deliveries(:successfully_completed)
+    recent_delivery = webhook_deliveries(:pending)
+    old_delivery.update_columns(created_at: 8.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
 end
