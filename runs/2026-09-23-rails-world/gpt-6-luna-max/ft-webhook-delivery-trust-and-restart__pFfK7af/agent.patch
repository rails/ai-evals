diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..e757d70
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,29 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure(at: Time.current)
+    with_lock do
+      if first_failure_at.nil? || first_failure_at < at - FAILURE_WINDOW
+        update!(consecutive_failures_count: 1, first_failure_at: at)
+      else
+        increment!(:consecutive_failures_count)
+      end
+
+      webhook.deactivate if consecutive_failures_count >= FAILURE_LIMIT && webhook.active?
+    end
+  end
+
+  def record_success
+    with_lock do
+      reset_failures if consecutive_failures_count.positive? || first_failure_at.present?
+    end
+  end
+
+  def reset_failures
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+end
