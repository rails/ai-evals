diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..331efc1
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = @query.present? ? "Search results for #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide flex flex-column align-start gap">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap-half full-width" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input full-width", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= form.button "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page, class: "flex flex-column gap full-width" do %>
+        <% @page.records.each do |card| %>
+          <article class="search-result">
+            <h2 class="txt-large margin-none">
+              <%= link_to highlight(card.title, @query), card_path(card), class: "search-result__title" %>
+            </h2>
+            <p class="txt-small margin-none">
+              <%= link_to card.board.name, board_path(card.board) %>
+            </p>
+
+            <% if excerpt = search_result_excerpt(card.description, @query) %>
+              <p class="search-result__excerpt margin-none"><%= excerpt %></p>
+            <% end %>
+
+            <% if comment = @matching_comments_by_card_id[card.id]&.first %>
+              <blockquote class="search-result__comment margin-none">
+                <%= search_result_excerpt(comment.body, @query) %>
+              </blockquote>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate full-width">No cards found for “<%= @query %>”</p>
+    <% end %>
+  <% end %>
+</section>
