diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..2fefdfb
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+    Current.account = accounts("37s")
+  end
+
+  test "searches card titles, descriptions, and comment bodies with highlighted matches" do
+    card = cards(:logo)
+    card.update! title: "A searchable needle in the title", description: "A needle in the description"
+    card.comments.create! creator: users(:kevin), body: "There is a needle in this comment"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "needle"
+    assert_select ".search-result__excerpt mark", text: "needle"
+    assert_select ".search-result__comment mark", text: "needle"
+  end
+
+  test "searches description content when the title does not match" do
+    card = cards(:logo)
+    card.update! title: "Title without descriptionsearchterm", description: "The searchable descriptionsearchterm"
+
+    get search_path, params: { q: "descriptionsearchterm" }
+
+    assert_response :success
+    assert_select ".search-result__title", text: card.title
+    assert_select ".search-result__excerpt mark", text: "descriptionsearchterm"
+  end
+
+  test "escapes card titles while highlighting matches" do
+    card = cards(:logo)
+    card.update! title: "<script>searchsafeterm</script>"
+
+    get search_path, params: { q: "searchsafeterm" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "searchsafeterm"
+    assert_no_match "<script>searchsafeterm", response.body
+  end
+  test "finds a card by a comment even when the title and description do not match" do
+    card = cards(:logo)
+    card.update! title: "A title without the query", description: "A description without the query"
+    card.comments.create! creator: users(:kevin), body: "A distinctcommentterm appears here"
+
+    get search_path, params: { q: "distinctcommentterm" }
+
+    assert_response :success
+    assert_select ".search-result__title", text: card.title
+    assert_select ".search-result__comment mark", text: "distinctcommentterm"
+  end
+
+  test "shows newest matching cards first" do
+    older, newer = cards(:logo), cards(:layout)
+    older.update! title: "Old chronosearchtoken"
+    newer.update! title: "New chronosearchtoken"
+    older.update_column :created_at, 2.days.ago
+    newer.update_column :created_at, 1.day.ago
+
+    get search_path, params: { q: "chronosearchtoken" }
+
+    assert_response :success
+    assert_select ".search-result__title" do |titles|
+      assert_equal [ newer.title, older.title ], titles.map(&:text)
+    end
+  end
+
+  test "excludes inaccessible boards and draft cards and comments" do
+    visible_card = cards(:logo)
+    visible_card.update! title: "visible privacysearchtoken"
+
+    inaccessible_card = boards(:private).cards.create!(
+      creator: users(:kevin), title: "inaccessible privacysearchtoken", status: "published", last_active_at: Time.current
+    )
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    draft = boards(:writebook).cards.create!(
+      creator: users(:kevin), title: "draft privacysearchtoken", status: "drafted", last_active_at: Time.current
+    )
+    draft_comment = draft.comments.new(account: accounts("37s"), creator: users(:kevin))
+    draft_comment.save!(validate: false)
+    ActionText::RichText.create!(
+      record: draft_comment, name: "body", body: "draft comment privacysearchtoken", account: accounts("37s")
+    )
+
+    get search_path, params: { q: "privacysearchtoken" }
+
+    assert_response :success
+    assert_select ".search-result__title", text: visible_card.title
+    assert_no_match "inaccessible privacysearchtoken", response.body
+    assert_no_match "draft privacysearchtoken", response.body
+    assert_no_match "draft comment privacysearchtoken", response.body
+
+    assert_not users(:kevin).accessible_cards.exists?(inaccessible_card.id)
+  end
+
+  test "treats SQL wildcard characters in the query literally" do
+    literal_match, wildcard_match = cards(:logo), cards(:layout)
+    literal_match.update! title: "specialmarker%token"
+    wildcard_match.update! title: "specialmarkerXtoken"
+
+    get search_path, params: { q: "specialmarker%token" }
+
+    assert_response :success
+    assert_select ".search-result__title", text: literal_match.title
+    assert_no_match wildcard_match.title, response.body
+  end
+
+  test "refreshes search results after board access is revoked" do
+    card = cards(:logo)
+    card.update! title: "revocationsearchtoken"
+
+    get search_path, params: { q: "revocationsearchtoken" }
+    assert_response :success
+    etag = response.headers.fetch("ETag")
+
+    board = card.board
+    board.update! all_access: false
+    board.accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "revocationsearchtoken" }, headers: { "If-None-Match" => etag }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "an empty search does not return cards" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+end
