@@ -0,0 +1,22 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = Current.user.accessible_cards.search(@query).reverse_chronologically.preload(:board, :rich_text_description)
+    set_page_and_extract_portion_from cards
+    @matching_comments_by_card_id = matching_comments_by_card_id
+    fresh_when etag: [ @query, @page.records, Current.user ]
+  end
+
+  private
+    def matching_comments_by_card_id
+      if @query.present? && @page.records.any?
+        Comment.search(@query)
+          .where(card_id: @page.records.map(&:id))
+          .preload(:rich_text_body)
+          .order(created_at: :desc, id: :desc)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
