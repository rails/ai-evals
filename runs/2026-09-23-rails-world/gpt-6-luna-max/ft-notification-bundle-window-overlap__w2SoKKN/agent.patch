       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -11,6 +32,17 @@ class User::Settings < ApplicationRecord
   end
 
   private
+    def synchronize_open_email_bundles
+      user.with_lock do
+        bundles = user.notification_email_bundles.open
+        if never?
+          bundles.find_each(&:cancel)
+        else
+          bundles.find_each { |bundle| bundle.reschedule_for(bundle_email_frequency_interval) }
+        end
+      end
+    end
