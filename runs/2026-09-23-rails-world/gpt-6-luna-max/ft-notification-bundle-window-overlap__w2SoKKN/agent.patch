diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..c30162d
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "notifications arriving late join the open window and a later notification opens the next one" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    first_arrival = Time.current
+    first_notification = nil
+    assert_enqueued_with(job: Notification::EmailBundle::DeliveryJob, at: first_arrival + 4.hours) do
+      first_notification = travel_to(first_arrival) { create_notification(events(:layout_commented)) }
+    end
+    first_bundle = Notification::EmailBundle.open.find_by!(user: @user)
+
+    travel_to(first_arrival + 1.hour) do
+      create_notification(events(:buy_domain_sent_back_to_triage))
+    end
+
+    # Simulate recipient work arriving after the scheduled close but before the
+    # delivery job runs. It must stay with the window that has already opened.
+    travel_to(first_bundle.ends_at + 1.hour) do
+      late_notification = create_notification(events(:logo_assignment_km))
+
+      assert_equal first_bundle.id, late_notification.email_bundles.sole.id
+      assert_equal first_bundle.ends_at, first_bundle.reload.ends_at
+      assert_equal 1, Notification::EmailBundle.open.where(user: @user).count
+
+      first_bundle.deliver
+      first_bundle.deliver
+
+      assert_equal 1, ActionMailer::Base.deliveries.size
+      assert_equal "3 new Fizzy notifications", ActionMailer::Base.deliveries.last.subject
+      assert_includes ActionMailer::Base.deliveries.last.body.encoded, "3 new notification"
+      assert first_bundle.reload.sent?
+
+      next_notification = create_notification(events(:layout_published))
+      next_bundle = Notification::EmailBundle.open.find_by!(user: @user)
+
+      assert_not_equal first_bundle.id, next_bundle.id
+      assert_includes next_notification.email_bundles.map(&:id), next_bundle.id
+      assert_operator next_bundle.starts_at, :>=, first_bundle.ends_at
+      assert_equal 1, Notification::EmailBundle.open.where(user: @user).count
+    end
+
+    assert_includes first_notification.email_bundles.map(&:id), first_bundle.id
+  end
+
+  test "changing frequency adjusts the open window without resetting its start" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    notification = create_notification(events(:layout_commented))
+    bundle = notification.email_bundles.sole
+    starts_at = bundle.starts_at
+
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    assert_equal starts_at, bundle.reload.starts_at
+    assert_equal starts_at + 1.day, bundle.ends_at
+    assert_equal 1, Notification::EmailBundle.open.where(user: @user).count
+
+    travel_to(bundle.ends_at + 1.second) { bundle.deliver }
+
+    assert bundle.reload.sent?
+    assert_equal 1, ActionMailer::Base.deliveries.size
+  end
+
+  test "never does not create a bundle and disabling email cancels an open bundle" do
+    @user.settings.update!(bundle_email_frequency: :never)
+    create_notification(events(:layout_commented))
+    assert_empty Notification::EmailBundle.open.where(user: @user)
+
+    @user.settings.update!(bundle_email_frequency: :daily)
+    create_notification(events(:buy_domain_sent_back_to_triage))
+    bundle = Notification::EmailBundle.open.find_by!(user: @user)
+
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert bundle.reload.cancelled?
+    assert_empty Notification::EmailBundle.open.where(user: @user)
+    bundle.deliver
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "frequency durations start at the first arrival" do
+    settings = @user.settings
+
+    {
+      every_few_hours: 4.hours,
+      daily: 1.day,
+      weekly: 1.week
+    }.each do |frequency, interval|
+      settings.update!(bundle_email_frequency: frequency)
+      assert_equal interval, settings.bundle_email_frequency_interval
+    end
+  end
+
+  private
+    def create_notification(source)
+      if notification = @user.notifications.find_by(card_id: source.card.id)
+        notification.source_type_will_change!
+        notification.update!(source: source, creator: source.creator, read_at: nil, unread_count: notification.unread_count + 1)
+        notification
+      else
+        Notification.create!(user: @user, source: source, creator: source.creator, unread_count: 1)
+      end
+    end
+end
