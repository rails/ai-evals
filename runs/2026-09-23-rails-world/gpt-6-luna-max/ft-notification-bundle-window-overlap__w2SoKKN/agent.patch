diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..ca9fe33
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,96 @@
+class Notification::EmailBundle < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_many :entries, class_name: "Notification::EmailBundleEntry", foreign_key: :notification_email_bundle_id, dependent: :destroy
+  has_many :notifications, through: :entries
+
+  enum :state, %w[ pending sent cancelled ].index_by(&:itself), default: :pending
+
+  scope :open, -> { pending.where.not(open_user_id: nil) }
+
+  class << self
+    def add_notification(notification, at: Time.current)
+      return if notification.creator.system?
+
+      user = notification.user
+      frequency = User::Settings.where(user_id: user.id).pick(:bundle_email_frequency)
+      return if frequency.nil? || frequency == "never"
+
+      user.with_lock do
+        settings = user.settings
+        if email_enabled_for?(user, settings)
+          add_notification_to_open_bundle(notification, user, settings, at)
+        end
+      end
+    end
+
+    private
+      def email_enabled_for?(user, settings)
+        settings && !settings.never? && user.active? && user.identity.present? && user.account.active?
+      end
+
+      def add_notification_to_open_bundle(notification, user, settings, at)
+        if (bundle = open.find_by(open_user_id: user.id))
+          bundle.add_notification(notification)
+        elsif interval = settings.bundle_email_frequency_interval
+          bundle = create_or_find_by!(open_user_id: user.id) do |new_bundle|
+            new_bundle.account = user.account
+            new_bundle.user = user
+            new_bundle.starts_at = at
+            new_bundle.ends_at = at + interval
+          end
+
+          bundle.add_notification(notification)
+          bundle.deliver_later if bundle.previously_new_record?
+          bundle
+        end
+      end
+  end
+
+  def add_notification(notification)
+    entries.find_or_create_by!(notification: notification) if pending?
+  end
+
+  def deliver_later
+    Notification::EmailBundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    recipient = user
+    recipient.with_lock do
+      reload
+      if pending? && open_user_id == recipient.id
+        if ends_at > Time.current
+          deliver_later
+        elsif delivery_enabled_for?(recipient) && notifications.exists?
+          NotificationMailer.email_bundle(self).deliver_now
+          update!(state: :sent, sent_at: Time.current, open_user_id: nil)
+        else
+          cancel
+        end
+      end
+    end
+  end
+
+  def reschedule_for(interval)
+    new_ends_at = starts_at + interval
+    if pending? && ends_at != new_ends_at
+      update!(ends_at: new_ends_at)
+      deliver_later
+    end
+  end
+
+  def cancel
+    if pending?
+      cancelled_at = Time.current
+      update!(state: :cancelled, cancelled_at: cancelled_at, ends_at: cancelled_at, open_user_id: nil)
+    end
+  end
+
+  private
+    def delivery_enabled_for?(recipient)
+      settings = recipient.settings
+      recipient.active? && recipient.identity.present? && recipient.account.active? && settings && !settings.never?
+    end
+end
