diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..ff8566c
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns the most recent activity first with existing API representations" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+    assert_equal events(:layout_assignment_jz).id, activities.first["id"]
+
+    assignment = activities.find { |activity| activity["id"] == events(:layout_assignment_jz).id }
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], assignment.keys.sort
+    assert_equal "card_assigned", assignment["action"]
+    assert_equal "Card", assignment["eventable_type"]
+    assert_equal cards(:layout).id, assignment.dig("eventable", "id")
+    assert_equal boards(:writebook).id, assignment.dig("board", "id")
+    assert_equal users(:david).id, assignment.dig("creator", "id")
+    assert_equal [ users(:jz).id ], assignment.dig("particulars", "assignee_ids")
+    assert_equal card_url(cards(:layout)), assignment["url"]
+
+    comment_event = activities.find { |activity| activity["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+    assert_equal "Comment", comment_event["eventable_type"]
+    assert_equal comment.id, comment_event.dig("eventable", "id")
+    assert_equal %(David commented on &quot;Layout is broken&quot;), comment_event["description"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), comment_event["url"]
+  end
+
+  test "omits deprecated collection changes and includes title changes" do
+    collection_event = events(:logo_published)
+    collection_event.update_column(:action, "card_collection_changed")
+
+    title_event = events(:layout_published)
+    title_event.update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_not_includes activities.pluck("id"), collection_event.id
+
+    title_activity = activities.find { |activity| activity["id"] == title_event.id }
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, title_activity["particulars"])
+    assert_includes title_activity["description"], %(was: "Old title")
+  end
+
+  test "returns event-specific particulars and empty strings for missing values" do
+    board_event = events(:buy_domain_sent_back_to_triage)
+    board_event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "new_board" => "New board" } })
+
+    title_event = events(:layout_published)
+    title_event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "new_title" => "New title" } })
+
+    triage_event = events(:shipping_closed)
+    triage_event.update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "old_board" => "", "new_board" => "New board" }, activities.fetch(board_event.id)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "New title" }, activities.fetch(title_event.id)["particulars"])
+    assert_equal({ "column" => "" }, activities.fetch(triage_event.id)["particulars"])
+    assert_equal({}, activities.fetch(events(:shipping_published).id)["particulars"])
+  end
+
+  test "filters by creator and board" do
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:kevin).id ],
+      board_ids: [ boards(:writebook).id ]
+    }
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert activities.any?
+    assert_equal [ users(:kevin).id ], activities.pluck("creator").pluck("id").uniq
+    assert_equal [ boards(:writebook).id ], activities.pluck("board").pluck("id").uniq
+  end
+
+  test "does not return activity from boards the current user cannot access" do
+    private_event = Current.set(account: accounts("37s"), session: sessions(:kevin), user: users(:kevin)) do
+      private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Private activity", status: "published")
+      private_card.events.find_by!(action: "card_published")
+    end
+
+    logout_and_sign_in_as :jz
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "uses the API pagination conventions" do
+    now = Time.current
+    events = (1..18).map do |index|
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: accounts("37s").id,
+        action: "card_published",
+        board_id: boards(:writebook).id,
+        creator_id: users(:kevin).id,
+        eventable_id: cards(:shipping).id,
+        eventable_type: "Card",
+        particulars: {},
+        created_at: now + index.seconds,
+        updated_at: now + index.seconds
+      }
+    end
+    Event.insert_all! events
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_equal Event.where(account: accounts("37s"), board: boards(:writebook), action: ActivitiesController::ACTIVITY_ACTIONS).count.to_s,
+      @response.headers["X-Total-Count"]
+    assert @response.headers["Link"].present?
+
+    get activities_path(format: :json, page: 2)
+
+    assert_response :success
+    assert_equal 14, @response.parsed_body.size
+  end
+end
