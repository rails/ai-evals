@@ -0,0 +1,37 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from filtered_activities.order(created_at: :desc, id: :desc)
+  end
+
+  private
+    def filtered_activities
+      filters = activity_filter_params
+      events = Current.user.accessible_events
+        .preloaded
+        .where(account: Current.account, action: ACTIVITY_ACTIONS)
+
+      events = events.where(creator_id: filters[:creator_ids]) if filters[:creator_ids].present?
+      events = events.where(board_id: filters[:board_ids]) if filters[:board_ids].present?
+
+      events
+    end
+
+    def activity_filter_params
+      params.permit(creator_ids: [], board_ids: [])
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..56fb25a
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,35 @@
+json.(activity, :id, :eventable_type)
+json.action activity.action.to_s
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+json.url polymorphic_url(activity.eventable)
+
+particulars = case activity.action
+when "card_assigned", "card_unassigned"
+  { assignee_ids: activity.assignee_ids || [] }
+when "card_board_changed"
+  {
+    old_board: activity.particulars&.dig("particulars", "old_board").to_s,
+    new_board: activity.particulars&.dig("particulars", "new_board").to_s
+  }
+when "card_title_changed"
+  {
+    old_title: activity.particulars&.dig("particulars", "old_title").to_s,
+    new_title: activity.particulars&.dig("particulars", "new_title").to_s
+  }
+when "card_triaged"
+  { column: activity.particulars&.dig("particulars", "column").to_s }
+else
+  {}
+end
+json.particulars particulars
+
+json.eventable do
+  case activity.eventable
+  when Card then json.partial! "cards/card", card: activity.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
