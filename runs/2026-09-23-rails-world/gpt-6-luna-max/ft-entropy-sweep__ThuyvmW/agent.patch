@@ -59,6 +59,51 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone all due batches cards by their board" do
+    skip unless Card.connection.adapter_name == "SQLite"
+
+    board = boards(:writebook)
+    last_active_at = 100.days.ago
+    cards = (1..1_001).map do |number|
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: board.account_id,
+        board_id: board.id,
+        creator_id: board.creator_id,
+        number: 10_000 + number,
+        status: "published",
+        last_active_at: last_active_at,
+        created_at: last_active_at,
+        updated_at: last_active_at
+      }
+    end
+    Card.insert_all!(cards)
+
+    cutoff = Time.now.change(usec: 0) - board.auto_postpone_period
+    relation = board.cards.active.where(last_active_at: ..cutoff).order(last_active_at: :asc, id: :asc).limit(1_000)
+    plan = Card.connection.execute("EXPLAIN QUERY PLAN #{relation.to_sql}").map { |row| row["detail"] }.join("\n")
+    assert_includes plan, "index_cards_for_entropy_sweep"
+
+    Card.any_instance.expects(:auto_postpone).with(user: board.account.system_user).times(cards.size)
+    Card.auto_postpone_all_due
+  end
+
+  test "SQLite entropy sweep preserves the whole-second cutoff" do
+    skip unless Card.connection.adapter_name == "SQLite"
+
+    now = Time.current.change(usec: 750_000)
+    travel_to(now, with_usec: true) do
+      cutoff = now.change(usec: 0) - boards(:writebook).auto_postpone_period
+      cards(:logo).update!(last_active_at: cutoff + 0.5.seconds)
+      cards(:text).update!(last_active_at: cutoff)
+
+      Card.auto_postpone_all_due
+
+      assert_not cards(:logo).reload.postponed?
+      assert cards(:text).reload.postponed?
+    end
+  end
+
