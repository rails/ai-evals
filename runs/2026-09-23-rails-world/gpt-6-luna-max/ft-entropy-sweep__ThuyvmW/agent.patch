+  AUTO_POSTPONE_BATCH_SIZE = 1_000
+
   included do
     scope :due_to_be_postponed, -> do
       active
@@ -25,10 +27,57 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      if connection.adapter_name == "SQLite"
+        # SQLite can't use an index for the per-row COALESCE cutoff in due_to_be_postponed.
+        auto_postpone_all_due_by_board
+      else
+        due_to_be_postponed.find_each do |card|
+          card.auto_postpone(user: card.account.system_user)
+        end
       end
     end
+
+    private
+      def auto_postpone_all_due_by_board
+        now = Time.now
+        system_users = {}
+
+        Board.preload(:entropy, account: :entropy).find_each do |board|
+          if period = board.auto_postpone_period
+            # SQLite's datetime() truncates fractional seconds when applying the interval.
+            cutoff = (now - period).change(usec: 0)
+
+            each_due_card_for(board, cutoff) do |card|
+              system_user = system_users[board.account_id] ||= board.account.system_user
+              card.auto_postpone(user: system_user)
+            end
+          end
+        end
+      end
+
+      def each_due_card_for(board, cutoff)
+        due_cards = board.cards.active.where(last_active_at: ..cutoff)
+        cursor = nil
+        uuid_type = type_for_attribute("id")
+
+        # A tuple cursor keeps pages ordered by the composite index; serialize UUIDs for the raw SQL bind.
+        loop do
+          batch = due_cards
+          if cursor
+            batch = batch.where("(cards.last_active_at, cards.id) > (?, ?)", *cursor)
+          end
+
+          cards = batch.order(last_active_at: :asc, id: :asc).limit(AUTO_POSTPONE_BATCH_SIZE).to_a
+          if cards.any?
+            last_card = cards.last
+            # Postponing updates last_active_at, so preserve the cursor before yielding the batch.
+            cursor = [ last_card.last_active_at, uuid_type.serialize(last_card.id) ]
+            cards.each { |card| yield card }
+          else
+            break
+          end
+        end
+      end
   end
 
   def entropy
