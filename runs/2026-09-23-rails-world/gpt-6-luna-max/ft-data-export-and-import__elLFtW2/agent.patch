diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..26b6bc0
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,49 @@
+class Export < ApplicationRecord
+  DOWNLOAD_LINK_LIFETIME = 1.day
+
+  belongs_to :account
+  belongs_to :requested_by, class_name: "User"
+  has_one_attached :archive, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself)
+  enum :status, %w[ queued processing ready failed ].index_by(&:itself), default: :queued
+
+  def generate_later
+    ExportJob.perform_later(self)
+  end
+
+  def generate_now
+    Current.with_account(account) do
+      update!(status: :processing, error_message: nil)
+      archive.purge if archive.attached?
+
+      ZipFile.create_for(archive, filename: filename) do |zip|
+        if account?
+          Account::DataTransfer::Manifest.new(account).export_to(zip)
+        else
+          Account::DataTransfer::CardArchive.new(requested_by).export_to(zip)
+        end
+      end
+
+      update!(status: :ready, completed_at: Time.current)
+      DataTransferMailer.export_ready(self).deliver_later
+    end
+  end
+
+  def fail_with(error)
+    update!(status: :failed, error_message: error.message.to_s.truncate(4000))
+    DataTransferMailer.export_failed(self).deliver_later
+  end
+
+  def download_id
+    signed_id(expires_in: DOWNLOAD_LINK_LIFETIME, purpose: :download)
+  end
+
+  def filename
+    if account?
+      "fizzy-account-export.zip"
+    else
+      "fizzy-cards-export.zip"
+    end
+  end
+end
