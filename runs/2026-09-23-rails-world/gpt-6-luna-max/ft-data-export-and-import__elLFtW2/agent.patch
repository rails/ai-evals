+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @download_url = export_url(export.download_id, script_name: export.account.slug)
+
+    mail(to: export.recipient_email, subject: "Your Fizzy export is ready")
+  end
+
+  def export_failed(export)
+    @export = export
+
+    mail(to: export.recipient_email, subject: "Your Fizzy export could not be completed")
+  end
+
+  def import_ready(import)
+    @import = import
+    @account = import.imported_account
+    @account_url = root_url(script_name: @account.slug)
+
+    mail(to: import.recipient_email, subject: "Your Fizzy account import is complete")
+  end
+
+  def import_failed(import)
+    @import = import
+
+    mail(to: import.recipient_email, subject: "Your Fizzy account import could not be completed")
+  end
+end
