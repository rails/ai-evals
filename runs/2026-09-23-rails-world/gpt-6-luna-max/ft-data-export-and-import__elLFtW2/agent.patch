diff --git a/app/models/account/data_transfer/archive_entry_io.rb b/app/models/account/data_transfer/archive_entry_io.rb
new file mode 100644
index 0000000..03537ac
--- /dev/null
+++ b/app/models/account/data_transfer/archive_entry_io.rb
@@ -0,0 +1,88 @@
+class Account::DataTransfer::ArchiveEntryIO
+  READ_CHUNK_SIZE = 128.kilobytes
+
+  def initialize(entry:)
+    @entry = entry
+    rewind
+  end
+
+  def size
+    entry.size
+  end
+
+  def rewind
+    close
+    @stream = entry.get_input_stream
+    @bytes_read = 0
+    @crc = 0
+    @verified = false
+    @finished = false
+    0
+  end
+
+  def read(length = nil, output = nil)
+    if length.nil?
+      data = +"".b
+      while chunk = read(READ_CHUNK_SIZE)
+        data << chunk
+      end
+    elsif length.negative?
+      raise ArgumentError, "Negative length #{length}"
+    elsif length.zero?
+      data = +"".b
+    elsif @finished
+      data = nil
+    else
+      data = stream.read(length)
+      if data.nil? || data.empty?
+        verify_entry
+        @finished = true
+        close
+        data = nil
+      else
+        append(data)
+        if stream.eof?
+          verify_entry
+          @finished = true
+          close
+        end
+      end
+    end
+
+    if output && data
+      output.replace(data)
+    else
+      data
+    end
+  rescue StandardError
+    close
+    raise
+  end
+
+  def close
+    stream&.close
+    @stream = nil
+  end
+
+  private
+    attr_reader :entry, :stream
+
+    def append(chunk)
+      @bytes_read += chunk.bytesize
+      if @bytes_read > entry.size
+        raise Account::DataTransfer::Importer::InvalidArchive, "A ZIP entry is larger than its declared size"
+      end
+
+      @crc = Zlib.crc32(chunk, @crc)
+    end
+
+    def verify_entry
+      return if @verified
+
+      unless @bytes_read == entry.size && @crc == entry.crc
+        raise Account::DataTransfer::Importer::InvalidArchive, "A ZIP entry is incomplete or corrupted"
+      end
+
+      @verified = true
+    end
+end
diff --git a/app/models/account/data_transfer/archive_io.rb b/app/models/account/data_transfer/archive_io.rb
new file mode 100644
index 0000000..8aea0a2
--- /dev/null
+++ b/app/models/account/data_transfer/archive_io.rb
@@ -0,0 +1,83 @@
+class Account::DataTransfer::ArchiveIO
+  READ_BUFFER_SIZE = 8.megabytes
+
+  def initialize(blob)
+    @blob = blob
+    @position = 0
+    @buffer = +"".b
+    @buffer_start = 0
+    @closed = false
+  end
+
+  def size
+    @blob.byte_size
+  end
+
+  def tell
+    @position
+  end
+
+  def eof?
+    @position >= size
+  end
+
+  alias eof eof?
+
+  def seek(offset, whence = IO::SEEK_SET)
+    @position = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then @position + offset
+    when IO::SEEK_END then size + offset
+    else raise ArgumentError, "Invalid seek mode"
+    end
+
+    raise Errno::EINVAL, "Invalid seek offset" if @position.negative?
+
+    0
+  end
+
+  def read(length = nil, output = nil)
+    raise IOError, "closed stream" if @closed
+    raise ArgumentError, "Negative length #{length}" if length&.negative?
+
+    length ||= size - @position
+    return output ? output.clear : "".b if length.zero?
+    return output ? nil : nil if eof?
+
+    length = [ length, size - @position ].min
+    data = +"".b
+
+    while data.bytesize < length
+      fill_buffer unless buffered_position?
+      offset = @position - @buffer_start
+      bytes_to_copy = [ length - data.bytesize, @buffer.bytesize - offset ].min
+      data << @buffer.byteslice(offset, bytes_to_copy)
+      @position += bytes_to_copy
+    end
+
+    if output
+      output.replace(data)
+    else
+      data
+    end
+  end
+
+  def close
+    @closed = true
+    @buffer = +"".b
+  end
+
+  private
+    def buffered_position?
+      @position >= @buffer_start && @position < @buffer_start + @buffer.bytesize
+    end
+
+    def fill_buffer
+      @buffer_start = @position
+      bytes_to_read = [ READ_BUFFER_SIZE, size - @position ].min
+      @buffer = @blob.download_chunk(@position...(@position + bytes_to_read))
+      unless @buffer.bytesize == bytes_to_read
+        raise EOFError, "The ZIP archive ended before the requested range"
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/card_archive.rb b/app/models/account/data_transfer/card_archive.rb
new file mode 100644
index 0000000..4874a95
--- /dev/null
+++ b/app/models/account/data_transfer/card_archive.rb
@@ -0,0 +1,122 @@
+class Account::DataTransfer::CardArchive
+  FORMAT = "fizzy-cards-export"
+  VERSION = 1
+  CARD_BATCH_SIZE = 250
+
+  def initialize(user)
+    @user = user
+    @written_files = Set.new
+    @card_count = 0
+  end
+
+  def export_to(zip)
+    @zip = zip
+    cards.find_each(batch_size: CARD_BATCH_SIZE) do |card|
+      zip.add_file("cards/#{card.number}.json", JSON.generate(card_attributes(card)))
+      @card_count += 1
+    end
+
+    zip.add_file("manifest.json", JSON.generate(
+      format: FORMAT,
+      version: VERSION,
+      card_count: @card_count
+    ))
+  end
+
+  private
+    def cards
+      @user.accessible_cards
+        .where(account_id: @user.account_id)
+        .published
+        .includes(
+          :board, :column, :creator, :tags, :steps, :image_attachment,
+          :assignees,
+          { rich_text_description: { embeds_attachments: :blob } },
+          { comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ] }
+        )
+    end
+
+    def card_attributes(card)
+      {
+        card: {
+          id: card.id,
+          number: card.number,
+          title: card.title,
+          status: card.status,
+          due_on: card.due_on&.iso8601,
+          description: card.description.to_s,
+          created_at: card.created_at&.iso8601,
+          updated_at: card.updated_at&.iso8601,
+          last_active_at: card.last_active_at&.iso8601
+        },
+        board: { id: card.board.id, name: card.board.name },
+        column: card.column && { id: card.column.id, name: card.column.name },
+        creator: person_attributes(card.creator),
+        assignees: card.assignees.map { |user| person_attributes(user) },
+        tags: card.tags.map { |tag| { id: tag.id, title: tag.title } },
+        steps: card.steps.map do |step|
+          { id: step.id, content: step.content, completed: step.completed, created_at: step.created_at&.iso8601 }
+        end,
+        attachments: attachments_for(card).map { |attachment| attachment_attributes(attachment) },
+        comments: card.comments.sort_by { |comment| [ comment.created_at, comment.id ] }.map do |comment|
+          {
+            id: comment.id,
+            creator: person_attributes(comment.creator),
+            body: comment.body.to_s,
+            created_at: comment.created_at&.iso8601,
+            updated_at: comment.updated_at&.iso8601,
+            attachments: attachments_for(comment).map { |attachment| attachment_attributes(attachment) }
+          }
+        end
+      }
+    end
+
+    def person_attributes(user)
+      { id: user.id, name: user.name }
+    end
+
+    def attachments_for(record)
+      attachments = []
+      attachments << record.image_attachment if record.is_a?(Card) && record.image_attachment
+
+      rich_text_name = if record.is_a?(Card)
+        :rich_text_description
+      else
+        :rich_text_body
+      end
+      rich_text = record.public_send(rich_text_name)
+      attachments.concat(rich_text.embeds_attachments.includes(:blob).to_a) if rich_text
+
+      attachments
+    end
+
+    def attachment_attributes(attachment)
+      blob = attachment.blob
+      path = write_file(blob)
+
+      {
+        name: attachment.name,
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size,
+        path: path
+      }
+    end
+
+    def write_file(blob)
+      path = "files/#{blob.id}/#{safe_filename(blob.filename.to_s)}"
+      unless @written_files.include?(path)
+        @zip.add_file(path, compress: false) do |sink|
+          blob.download do |chunk|
+            sink.write(chunk)
+          end
+        end
+        @written_files << path
+      end
+      path
+    end
+
+    def safe_filename(filename)
+      File.basename(filename).gsub(/[^a-zA-Z0-9._-]/, "_").presence || "attachment"
+    end
+end
