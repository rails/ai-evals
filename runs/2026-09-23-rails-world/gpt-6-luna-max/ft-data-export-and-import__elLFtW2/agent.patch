@@ -0,0 +1,39 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :requested_by, class_name: "User"
+  belongs_to :requester_identity, class_name: "Identity"
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :archive, dependent: :purge_later
+
+  enum :status, %w[ queued processing completed failed ].index_by(&:itself), default: :queued
+
+  validates :archive, presence: true
+  validates :recipient_email, presence: true
+
+  def process_later
+    ImportJob.perform_later(self)
+  end
+
+  def process_now
+    begin
+      update!(status: :processing, error_message: nil)
+      Account::DataTransfer::Importer.new(self).import
+    rescue StandardError => error
+      Rails.error.report(error, context: { import_id: id }, severity: :error)
+      update!(status: :failed, error_message: error.message.to_s.truncate(4000))
+      purge_uploaded_archive
+      DataTransferMailer.import_failed(self).deliver_later
+    else
+      purge_uploaded_archive
+      DataTransferMailer.import_ready(self).deliver_later
+    end
+  end
+
+  private
+    def purge_uploaded_archive
+      archive.purge if archive.attached?
+    rescue StandardError => error
+      Rails.error.report(error, context: { import_id: id }, severity: :warning)
+    end
+end
