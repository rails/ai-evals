@@ -65,3 +65,48 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  let message = {}
+
+  if (event.data) {
+    try {
+      message = event.data.json()
+    } catch (_error) {
+      message = { body: event.data.text() }
+    }
+  }
+
+  const target = new URL(message.url || "/", self.location.origin)
+  const notificationOptions = {
+    body: message.body || "",
+    icon: "/app-icon.png",
+    data: { url: target.href }
+  }
+
+  if (message.tag) notificationOptions.tag = message.tag
+
+  event.waitUntil(self.registration.showNotification(message.title || "Fizzy", notificationOptions))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const target = new URL(event.notification.data?.url || "/", self.location.origin)
+  if (target.origin !== self.location.origin) target.href = self.location.origin + "/"
+
+  event.waitUntil((async () => {
+    const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+    const existingClient = clients.find((client) => client.url === target.href)
+
+    if (existingClient) return existingClient.focus()
+
+    const appClient = clients.find((client) => new URL(client.url).origin === target.origin)
+    if (appClient && "navigate" in appClient) {
+      const navigatedClient = await appClient.navigate(target.href)
+      return navigatedClient?.focus()
+    }
+
+    return self.clients.openWindow(target.href)
+  })())
+})
