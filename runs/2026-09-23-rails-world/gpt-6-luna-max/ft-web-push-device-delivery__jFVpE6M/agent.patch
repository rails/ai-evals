+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "sends the stored subscription and VAPID keys to the push service" do
+    subscription = users(:kevin).push_subscriptions.create!(subscription_attributes)
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with(
+        message: "notification payload",
+        endpoint: subscription.endpoint,
+        p256dh: subscription.p256dh_key,
+        auth: subscription.auth_key,
+        vapid: {
+          subject: "mailto:support@fizzy.do",
+          public_key: "public-key",
+          private_key: "private-key"
+        },
+        ssl_timeout: 5,
+        open_timeout: 5,
+        read_timeout: 5,
+        ttl: 1.day.to_i
+      ).returns(:delivered)
+
+      assert_equal :delivered, subscription.deliver("notification payload")
+    end
+  end
+
+  test "removes a subscription rejected as expired by the push service" do
+    subscription = users(:kevin).push_subscriptions.create!(subscription_attributes)
+    response = Struct.new(:body).new("")
+    error = WebPush::ExpiredSubscription.new(response, "push.example.test")
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(error)
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.deliver("notification payload")
+      end
+    end
+  end
+
+  private
+    def subscription_attributes
+      {
+        endpoint: "https://push.example.test/subscriptions/device-1",
+        p256dh_key: "public-key",
+        auth_key: "auth-key"
+      }
+    end
+
+    def with_vapid_keys
+      original_public_key = ENV["VAPID_PUBLIC_KEY"]
+      original_private_key = ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "public-key"
+      ENV["VAPID_PRIVATE_KEY"] = "private-key"
+
+      yield
+    ensure
+      original_public_key ? ENV["VAPID_PUBLIC_KEY"] = original_public_key : ENV.delete("VAPID_PUBLIC_KEY")
+      original_private_key ? ENV["VAPID_PRIVATE_KEY"] = original_private_key : ENV.delete("VAPID_PRIVATE_KEY")
+    end
+end
