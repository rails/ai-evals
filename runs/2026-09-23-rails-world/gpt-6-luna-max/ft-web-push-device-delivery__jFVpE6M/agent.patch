diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..6987e79
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,166 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["status", "enableButton", "disableButton", "message", "details"]
+  static values = {
+    publicKey: String,
+    subscriptionsUrl: String,
+    serviceWorkerUrl: String
+  }
+
+  connect() {
+    this.subscription = null
+    this.subscriptionId = null
+    this.working = false
+    this.supported = this.#supportsPushNotifications()
+
+    this.#updateView()
+    this.#syncSubscription()
+  }
+
+  async enable() {
+    if (this.working || !this.supported) return
+
+    this.working = true
+    this.#updateView()
+
+    try {
+      if (Notification.permission !== "granted") {
+        const permission = await Notification.requestPermission()
+        if (permission !== "granted") {
+          this.messageTarget.textContent = "Allow notifications in your browser settings to turn them on."
+          return
+        }
+      }
+
+      const registration = await navigator.serviceWorker.register(this.serviceWorkerUrlValue)
+      let subscription = await registration.pushManager.getSubscription()
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey()
+        })
+      }
+
+      this.subscriptionId = await this.#saveSubscription(subscription)
+      this.subscription = subscription
+      this.messageTarget.textContent = ""
+    } catch (_error) {
+      this.messageTarget.textContent = "Push notifications could not be turned on. Please try again."
+    } finally {
+      this.working = false
+      this.#updateView()
+    }
+  }
+
+  async disable() {
+    if (this.working || !this.subscription || !this.subscriptionId) return
+
+    this.working = true
+    this.#updateView()
+
+    try {
+      const url = `${this.subscriptionsUrlValue}/${encodeURIComponent(this.subscriptionId)}`
+      await this.#request("DELETE", url)
+      await this.subscription.unsubscribe()
+      this.subscription = null
+      this.subscriptionId = null
+      this.messageTarget.textContent = ""
+    } catch (_error) {
+      this.messageTarget.textContent = "Push notifications could not be turned off. Please try again."
+    } finally {
+      this.working = false
+      this.#updateView()
+    }
+  }
+
+  async #syncSubscription() {
+    if (!this.supported) return
+
+    try {
+      const registration = await navigator.serviceWorker.register(this.serviceWorkerUrlValue)
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        this.subscriptionId = await this.#saveSubscription(subscription)
+        this.subscription = subscription
+      }
+    } catch (_error) {
+      this.messageTarget.textContent = "This device's push subscription could not be checked."
+    }
+
+    this.#updateView()
+  }
+
+  #supportsPushNotifications() {
+    return this.publicKeyValue &&
+      "Notification" in window &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window
+  }
+
+  #applicationServerKey() {
+    const key = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const paddedKey = key + "=".repeat((4 - key.length % 4) % 4)
+    const decodedKey = window.atob(paddedKey)
+
+    return Uint8Array.from(decodedKey, character => character.charCodeAt(0))
+  }
+
+  async #saveSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    if (!endpoint || !keys?.p256dh || !keys?.auth) throw new Error("Incomplete push subscription")
+
+    const response = await this.#request("POST", this.subscriptionsUrlValue, {
+      push_subscription: {
+        endpoint,
+        p256dh_key: keys.p256dh,
+        auth_key: keys.auth
+      }
+    })
+
+    if (!response?.id) throw new Error("Push subscription was not saved")
+    return response.id
+  }
+
+  async #request(method, url, body) {
+    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content
+    const response = await fetch(url, {
+      method,
+      credentials: "same-origin",
+      headers: {
+        Accept: "application/json",
+        "Content-Type": "application/json",
+        ...(csrfToken ? { "X-CSRF-Token": csrfToken } : {})
+      },
+      body: body ? JSON.stringify(body) : undefined
+    })
+
+    if (!response.ok && !(method === "DELETE" && response.status === 404)) {
+      throw new Error(`Push subscription request failed (${response.status})`)
+    }
+
+    return response.status === 204 || response.status === 404 ? null : response.json()
+  }
+
+  #updateView() {
+    const enabled = !!this.subscription
+    const permissionDenied = this.supported && Notification.permission === "denied"
+
+    this.statusTarget.classList.toggle("notifications--on", enabled)
+    this.enableButtonTarget.hidden = !this.supported || enabled || permissionDenied
+    this.disableButtonTarget.hidden = !enabled
+    this.enableButtonTarget.disabled = this.working
+    this.disableButtonTarget.disabled = this.working
+
+    this.detailsTargets.forEach((details) => {
+      details.hidden = this.supported && !permissionDenied
+    })
+
+    if (!this.supported) {
+      this.messageTarget.textContent = "Push notifications aren't supported by this browser."
+    }
+
+    this.messageTarget.hidden = !this.messageTarget.textContent
+  }
+}
diff --git a/app/jobs/push_notification_job.rb b/app/jobs/push_notification_job.rb
new file mode 100644
index 0000000..4dad33c
--- /dev/null
+++ b/app/jobs/push_notification_job.rb
@@ -0,0 +1,26 @@
+class PushNotificationJob < ApplicationJob
+  include NotificationsHelper
+  include ActionView::Helpers::TextHelper
+  include Rails.application.routes.url_helpers
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification)
+    if PushSubscription.configured? && !notification.read? && notification.user.active?
+      message = payload_for(notification)
+      notification.user.push_subscriptions.find_each do |subscription|
+        subscription.deliver(message)
+      end
+    end
+  end
+
+  private
+    def payload_for(notification)
+      {
+        title: notification_title(notification),
+        body: notification_body(notification),
+        url: card_path(notification.card, script_name: notification.account.slug),
+        tag: notification.id
+      }.to_json
+    end
+end
