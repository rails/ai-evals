diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..be60ded
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,60 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 4096 }
+  validates :p256dh_key, :auth_key, length: { maximum: 255 }
+  validate :endpoint_uses_https
+
+  class << self
+    def configured?
+      vapid_public_key.present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+  end
+
+  def deliver(message)
+    if self.class.configured?
+      WebPush.payload_send(
+        message: message,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: {
+          subject: "mailto:support@fizzy.do",
+          public_key: self.class.vapid_public_key,
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        },
+        ssl_timeout: 5,
+        open_timeout: 5,
+        read_timeout: 5,
+        ttl: 1.day.to_i
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, SocketError,
+    OpenSSL::SSL::SSLError, Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ETIMEDOUT => error
+    Rails.logger.warn "Web push delivery failed for subscription #{id} (#{error.class})"
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint) if endpoint.present?
+    end
+
+    def endpoint_uses_https
+      if endpoint.present?
+        uri = URI.parse(endpoint)
+        errors.add(:endpoint, "must be a valid HTTPS URL") unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.blank?
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be a valid HTTPS URL")
+    end
+end
