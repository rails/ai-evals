index 0000000..6a017bf
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled beyond the grace period" do
+    travel_to Time.current do
+      due_account = accounts(:"37s")
+      due_account.create_cancellation!(initiated_by: users(:jason), created_at: 31.days.ago)
+      Storage::Entry.create!(account: due_account, delta: 1, operation: "attach")
+
+      recently_cancelled_account = accounts(:initech)
+      recently_cancelled_account.create_cancellation!(initiated_by: users(:mike), created_at: 1.day.ago)
+
+      boundary_account = Account.create!(name: "Account at the grace period boundary")
+      boundary_initiator = boundary_account.users.create!(name: "Boundary account owner")
+      boundary_account.create_cancellation!(initiated_by: boundary_initiator, created_at: 30.days.ago)
+
+      reactivated_account = Account.create!(name: "Reactivated account")
+      reactivation_initiator = reactivated_account.users.create!(name: "Reactivated account owner")
+      reactivated_account.create_cancellation!(initiated_by: reactivation_initiator, created_at: 31.days.ago)
+      reactivated_account.reactivate
+
+      Account::IncinerateDueJob.perform_now
+
+      assert_not Account.exists?(due_account.id)
+      assert Account.exists?(recently_cancelled_account.id)
+      assert Account.exists?(boundary_account.id)
+      assert Account.exists?(reactivated_account.id)
+      assert_empty account_scoped_tables_with_records(due_account.id)
+    end
+  end
+
+  private
+    def account_scoped_tables_with_records(account_id)
+      connection = ActiveRecord::Base.connection
+      quoted_account_id = connection.quote(Account.type_for_attribute("id").serialize(account_id))
+
+      connection.tables.filter_map do |table|
+        if connection.column_exists?(table, :account_id)
+          sql = "SELECT 1 FROM #{connection.quote_table_name(table)} WHERE account_id = #{quoted_account_id} LIMIT 1"
+          table if connection.select_value(sql)
+        end
+      end
+    end
+end
