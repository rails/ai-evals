diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..645a4f9
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,80 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[ en ja ].freeze
+
+  included do
+    around_action :set_locale
+    etag { I18n.locale.to_s }
+    after_action :persist_locale_choice
+  end
+
+  private
+    def set_locale(&block)
+      requested = requested_locale
+      session[:locale] = requested if requested
+
+      locale = requested || session[:locale].to_s.presence || persisted_locale || I18n.default_locale.to_s
+      locale = I18n.default_locale.to_s unless SUPPORTED_LOCALES.include?(locale.to_s)
+
+      Current.locale = locale.to_s if Current.respond_to?(:locale=)
+
+      I18n.with_locale(locale.to_sym, &block)
+    end
+
+    def requested_locale
+      locale = params[:locale].to_s
+      locale if SUPPORTED_LOCALES.include?(locale)
+    rescue => _e
+      nil
+    end
+
+    def persisted_locale
+      identity = identity_from_session_cookie || identity_from_bearer_token
+      return unless identity
+
+      locale = identity.locale.to_s if identity.respond_to?(:locale)
+      locale = identity.users.first&.locale.to_s if locale.blank? && identity.respond_to?(:users)
+      locale if SUPPORTED_LOCALES.include?(locale)
+    rescue => _e
+      nil
+    end
+
+    def identity_from_session_cookie
+      token = cookies.signed[:session_token] rescue nil
+      return unless token.present?
+
+      session_record = Session.find_signed(token) rescue nil
+      session_record&.identity
+    end
+
+    def identity_from_bearer_token
+      header = request.authorization.to_s
+      return unless header.include?("Bearer")
+
+      token = header.split(" ").last
+      return unless token.present?
+
+      Identity.find_by_permissable_access_token(token, method: request.method)
+    rescue => _e
+      nil
+    end
+
+    def persist_locale_choice
+      locale = (requested_locale || session[:locale].to_s.presence)
+      return unless locale && SUPPORTED_LOCALES.include?(locale.to_s)
+
+      identity = Current.identity rescue nil
+      user = Current.user rescue nil
+
+      if identity&.respond_to?(:locale) && identity.locale.to_s != locale.to_s
+        identity.update_column(:locale, locale.to_s)
+      end
+
+      if user&.respond_to?(:locale) && user.locale.to_s != locale.to_s
+        user.update_column(:locale, locale.to_s)
+      end
+    rescue => _e
+      nil
+    end
+end
