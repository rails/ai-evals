diff --git a/app/jobs/concerns/locale_context.rb b/app/jobs/concerns/locale_context.rb
new file mode 100644
index 0000000..3b4ad94
--- /dev/null
+++ b/app/jobs/concerns/locale_context.rb
@@ -0,0 +1,35 @@
+# Serializes the current locale into job data so jobs run in the same
+# language as the request that enqueued them. Mailers additionally resolve
+# the recipient's persisted locale, which takes precedence there.
+module LocaleContext
+  extend ActiveSupport::Concern
+
+  prepended do
+    attr_reader :job_locale
+    around_perform :with_locale_context
+  end
+
+  def initialize(...)
+    super
+    @job_locale = I18n.locale.to_s
+  end
+
+  def serialize
+    super.merge({ "locale" => @job_locale })
+  end
+
+  def deserialize(job_data)
+    super
+    @job_locale = job_data["locale"]
+  end
+
+  private
+    def with_locale_context(&block)
+      if %w[ en ja ].include?(@job_locale.to_s)
+        Current.locale = @job_locale.to_s if Current.respond_to?(:locale=)
+        I18n.with_locale(@job_locale.to_sym, &block)
+      else
+        yield
+      end
+    end
+end
