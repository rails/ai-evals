+    doc = Nokogiri::HTML(response.body); doc.css("script, style, svg").remove
+    texts=[]
+    doc.traverse do |node|
+      if node.text?; s=node.text.strip; texts<<s if s.present?
+      elsif node.element?; %w[title aria-label placeholder alt].each{|a| v=node[a]; texts<<"@#{a}=#{v.strip}" if v.present?}; end
+    end
+    texts.uniq.each{|s| puts "TEXT: #{s}" if s =~ /[A-Za-z]{3,}/}
+  end
+  test "public" do
