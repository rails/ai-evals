+      # public paths are tenanted? They use script_name account slug? published_board_url uses ... Check routes: public boards under account slug? get with script?
+    end
+    get public_board_path(key); dump("public_board_tenanted")
+    get public_board_card_path(key, card); dump("public_card")
+    get public_board_columns_closed_path(key); dump("public_closed")
+    get public_board_columns_not_now_path(key); dump("public_notnow")
+    get public_board_columns_stream_path(key); dump("public_stream")
+    get public_board_column_path(key, board.columns.first); dump("public_column")
+  end
+end
diff --git a/test/integration/locale_crawl_test.rb b/test/integration/locale_crawl_test.rb
new file mode 100644
index 0000000..84ab1a8
--- /dev/null
+++ b/test/integration/locale_crawl_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class LocaleCrawlTest < ActionDispatch::IntegrationTest
+  test "crawl japanese" do
+    sign_in_as :kevin
+    board = boards(:writebook)
+    card = cards(:logo)
+    user = users(:kevin)
+    paths = {
+      "root" => root_path(locale: "ja"),
+      "board" => board_path(board),
+      "board_edit" => edit_board_path(board),
+      "new_board" => new_board_path,
+      "card" => card_path(card),
+      "cards" => cards_path,
+      "account_settings" => account_settings_path,
+      "join_code" => account_join_code_path,
+      "notifications" => notifications_path,
+      "notification_settings" => notifications_settings_path,
+      "search" => search_path,
+      "user" => user_path(user),
+      "edit_user" => edit_user_path(user),
+      "access_tokens" => my_access_tokens_path,
+      "new_access_token" => new_my_access_token_path,
+      "passkeys" => my_passkeys_path,
+      "pins" => my_pins_path,
+      "webhooks" => board_webhooks_path(board),
+      "new_webhook" => new_board_webhook_path(board),
+      "events_board_column" => board_column_path(board, board.columns.first),
+      "closed_column" => board_columns_closed_path(board),
+      "not_now_column" => board_columns_not_now_path(board),
+      "stream_column" => board_columns_stream_path(board),
+      "my_menu" => my_menu_path,
+    }
+    paths.each do |name, path|
+      next unless path
+      begin
+        get path
+      rescue => e
+        puts "\n=== #{name} ERROR #{e.class}: #{e.message} ==="
+        next
+      end
+      puts "\n=== #{name} #{path} status=#{response.status} ==="
+      doc = Nokogiri::HTML(response.body)
+      doc.css("script, style, svg").remove
+      texts = []
+      doc.traverse do |node|
+        if node.text?
+          s = node.text.strip
+          texts << s if s.present?
+        elsif node.element?
+          %w[title aria-label placeholder alt value].each do |attr|
+            v = node[attr]
+            texts << "@#{attr}=#{v.strip}" if v.present? && v.strip =~ /[A-Za-z]/
+          end
+        end
+      end
+      texts.uniq.each do |s|
+        # ignore user data, emails, urls, board/card names, known fixtures
+        next if s =~ /\A(@\w+=)?(https?:|www\.|[^\s]+@[^\s]+|Writebook|37signals|Fizzy|Kevin|David|JZ|Mike|The |Layout|Buy|We need|In progress|Triage|Review|On Hold|Logo|Playground)/
+        puts "TEXT: #{s}" if s =~ /[A-Za-z]{3,}/
+      end
+    end
+  end
+end
diff --git a/test/integration/locale_mailer_test.rb b/test/integration/locale_mailer_test.rb
new file mode 100644
index 0000000..d210d74
--- /dev/null
+++ b/test/integration/locale_mailer_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class LocaleMailerTest < ActionDispatch::IntegrationTest
+  test "mailers in japanese for japanese identity" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    user = users(:kevin)
+    user.update!(locale: "ja")
+
+    magic = identity.magic_links.create!
+    mail = MagicLinkMailer.sign_in_instructions(magic)
+    puts "MAGIC subject=#{mail.subject}"
+    puts mail.body.to_s[0..1000]
+
+    mail2 = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "tok", user: user)
+    puts "USER subject=#{mail2.subject}"
+    puts mail2.body.to_s[0..1000]
+
+    export = User::DataExport.create!(account: user.account, user: user)
+    mail3 = ExportMailer.completed(export)
+    puts "EXPORT subject=#{mail3.subject}"
+    puts mail3.body.to_s[0..1000]
+
+    mail4 = ImportMailer.completed(identity, user.account)
+    puts "IMPORT subject=#{mail4.subject}"
+    puts mail4.body.to_s[0..1000]
+
+    # bundle
+    user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+    mail5 = Notification::BundleMailer.notification(bundle)
+    puts "BUNDLE subject=#{mail5.subject}"
+    puts mail5.html_part.body.to_s[0..2000] rescue puts mail5.body.to_s[0..2000]
+    puts "BUNDLE TEXT #{mail5.text_part.body.to_s[0..2000]}" rescue nil
+  end
+end
diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..938dff5
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "switching to japanese via param and persisting in session" do
+    untenanted { get new_session_path(locale: "ja") }
+    assert_response :success
+    assert_match "ログイン", response.body
+
+    untenanted { get new_session_path }
+    assert_match "ログイン", response.body
+  end
+
+  test "unknown locale does not switch" do
+    untenanted { get new_session_path(locale: "xx") }
+    assert_response :success
+    assert_match "Get into Fizzy", response.body
+  end
+
+  test "english by default" do
+    untenanted { get new_session_path }
+    assert_response :success
+    assert_match "Get into Fizzy", response.body
+  end
+  test "locale persists for signed in user after signing in again" do
+    sign_in_as :kevin
+    get account_settings_path(locale: "ja")
+    assert_response :success
+    assert_match "アカウント設定", response.body
+
+    sign_out
+    sign_in_as :kevin
+    get account_settings_path
+    assert_response :success
+    assert_match "アカウント設定", response.body
+  end
+end
