diff --git a/test/integration/locale_crawl2_test.rb b/test/integration/locale_crawl2_test.rb
new file mode 100644
index 0000000..7295da4
--- /dev/null
+++ b/test/integration/locale_crawl2_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class LocaleCrawl2Test < ActionDispatch::IntegrationTest
+  def dump(name)
+    puts "\n=== #{name} status=#{response.status} ==="
+    doc = Nokogiri::HTML(response.body)
+    doc.css("script, style, svg").remove
+    texts=[]
+    doc.traverse do |node|
+      if node.text?
+        s=node.text.strip; texts << s if s.present?
+      elsif node.element?
+        %w[title aria-label placeholder alt].each do |attr|
+          v=node[attr]; texts << "@#{attr}=#{v.strip}" if v.present?
+        end
+      end
+    end
+    texts.uniq.each { |s| puts "TEXT: #{s}" if s =~ /[A-Za-z]{3,}/ }
+  end
+
+  test "crawl2" do
+    untenanted { get new_session_path(locale: "ja"); dump("session_new") }
+    untenanted { get new_signup_path; dump("signup_new") }
+    # magic link page requires pending - do session post
+    untenanted { post session_path, params: { email_address: identities(:kevin).email_address } }
+    untenanted { get session_magic_link_path; dump("magic_link") }
+
+    sign_in_as :kevin
+    board = boards(:writebook)
+    card = cards(:logo)
+    user = users(:kevin)
+    get new_account_import_path; dump("import_new")
+    get edit_account_join_code_path; dump("join_edit")
+    get new_user_email_address_path(user_id: user.id); dump("email_new")
+    # public board
+    # Use publication?
+    begin
+      pub = board.publication
+      get public_board_path(pub.key); dump("public_board")
+      get public_board_card_path(pub.key, card); dump("public_card")
+    rescue => e
+      puts "public err #{e.class} #{e.message}"
+    end
+    get card_path(card, locale: "ja"); dump("card_ja_again")
+    get edit_card_path(card); dump("card_edit_frame")
+    get new_card_assignment_path(card); dump("assign")
+    get edit_card_board_path(card); dump("card_board_edit")
+    get edit_card_column_path(card); dump("card_column_edit")
+    get new_card_tagging_path(card); dump("tagging")
+    get search_path(q: "logo"); dump("search_logo")
+    get events_path; dump("events")
+    get user_events_path(user); dump("user_events")
+    get notifications_path; dump("notifications2")
+    # settings pages for other users?
+    get edit_board_path(board); dump("board_edit2")
+    webhook = webhooks(:active) rescue nil
+    if webhook
+      get board_webhook_path(board, webhook); dump("webhook_show")
+      get edit_board_webhook_path(board, webhook); dump("webhook_edit")
+    end
+  end
+end
