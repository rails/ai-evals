+    def mailer_locale(args, kwargs, seen = {})
+      values = Array(args) + Array(kwargs.values)
+      values.each do |value|
+        next if value.nil? || seen[value.object_id]
+        seen[value.object_id] = true
+
+        locale = locale_from_value(value, seen)
+        return locale if locale.present?
+      end
+      nil
+    end
+
+    def locale_from_value(value, seen)
+      case value
+      when Identity
+        locale_candidate(value.locale) || locale_candidate(value.users.first&.locale)
+      when User
+        locale_candidate(value.locale) || (value.identity && locale_candidate(value.identity.locale))
+      when Hash
+        mailer_locale(value.values, {}, seen)
+      when Array
+        mailer_locale(value, {}, seen)
+      else
+        if value.respond_to?(:identity) && value.identity
+          locale_from_value(value.identity, seen)
+        elsif value.respond_to?(:user) && value.user
+          locale_from_value(value.user, seen)
+        elsif value.respond_to?(:initiated_by) && value.initiated_by
+          locale_from_value(value.initiated_by, seen)
+        elsif value.respond_to?(:creator) && value.creator.is_a?(User)
+          locale_from_value(value.creator, seen)
+        end
+      end
+    rescue => _e
+      nil
+    end
+
+    def locale_candidate(locale)
+      locale.to_s if %w[ en ja ].include?(locale.to_s)
+    end
 end
