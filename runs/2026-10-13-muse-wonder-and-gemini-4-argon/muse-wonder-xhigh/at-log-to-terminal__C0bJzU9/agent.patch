-books = Book.order(:id).to_a
+# Show the report on the terminal as well as keeping it in the log file.
+#
+# Rails.logger already writes to the environment's log file
+# (log/development.log in development). Broadcast it to $stdout for the
+# duration of the report so that every report line, with its original
+# severity, is written to both places, and the runbook command above
+# actually displays the report it produces.
+#
+# The console logger mirrors the Rails log level, so raising LOG_LEVEL
+# filters the terminal exactly as it filters the log file. It is never
+# chattier than INFO, however, so debug-level noise such as SQL query
+# logging stays out of the report shown on the terminal (the report
+# itself only uses info/warn).
+console_logger = ActiveSupport::Logger.new($stdout)
+console_logger.formatter = ActiveSupport::Logger::SimpleFormatter.new
+console_logger.level = [ Rails.logger.level, ActiveSupport::Logger::INFO ].max
 
-Rails.logger.info "Library report: #{books.size} books"
+added_loggers = []
 
-books.each do |book|
-  pages = book.leaves.count
+if Rails.logger.respond_to?(:broadcast_to)
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout, STDOUT)
+    Rails.logger.broadcast_to(console_logger)
+    added_loggers << console_logger
+  end
 
-  if pages.zero?
-    Rails.logger.warn "Library report: #{book.title} has no pages"
-  else
-    Rails.logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+  # Keep the record in the environment's log file even in environments
+  # whose default logger does not write to one.
+  log_file = Rails.root.join("log/#{Rails.env}.log").to_s
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, log_file)
+    file_logger = ActiveSupport::Logger.new(log_file)
+    file_logger.formatter = ActiveSupport::Logger::SimpleFormatter.new
+    file_logger.level = Rails.logger.level
+    Rails.logger.broadcast_to(file_logger)
+    added_loggers << file_logger
   end
 end
 
-Rails.logger.info "Library report: done"
+begin
+  books = Book.order(:id).to_a
+
+  Rails.logger.info "Library report: #{books.size} books"
+
+  books.each do |book|
+    pages = book.leaves.count
+
+    if pages.zero?
+      Rails.logger.warn "Library report: #{book.title} has no pages"
+    else
+      Rails.logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+    end
+  end
+
+  Rails.logger.info "Library report: done"
+ensure
+  if Rails.logger.respond_to?(:stop_broadcasting_to)
+    added_loggers.each { |logger| Rails.logger.stop_broadcasting_to(logger) }
+  end
+end
