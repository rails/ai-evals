diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..078cdea
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "a comment can be reacted to" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_equal comment, reaction.reactable
+    assert_equal cards(:logo), reaction.card
+    assert_equal comment, reaction.comment
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal accounts("37s"), reaction.account
+    assert_includes comment.reactions, reaction
+    assert_includes users(:kevin).reactions, reaction
+  end
+
+  test "a card can be reacted to" do
+    card = cards(:logo)
+    reaction = card.reactions.create!(content: "🚀", reacter: users(:kevin))
+
+    assert_equal card, reaction.reactable
+    assert_equal card, reaction.card
+    assert_nil reaction.comment
+  end
+
+  test "content is required and limited to 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_not comment.reactions.build(content: nil, reacter: users(:kevin)).valid?
+    assert_not comment.reactions.build(content: "a" * 17, reacter: users(:kevin)).valid?
+    assert comment.reactions.build(content: "a" * 16, reacter: users(:kevin)).valid?
+  end
+
+  test "reacting touches the card so watchers are refreshed" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    assert_changes -> { card.reload.updated_at } do
+      comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..0f65220
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding and removing a reaction to a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      assert_no_selector ".reaction"
+
+      find(".reactions__trigger").click
+      fill_in "Add a reaction", with: "👍"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "👍"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      # The strip is ready for the next reaction
+      find(".reactions__trigger").click
+      fill_in "Add a reaction", with: "Nice!"
+      find(".reaction__cancel-btn").click
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction", text: "Nice!"
+
+      find(".reaction", text: "👍").click
+      find(".reaction__delete").click
+      assert_no_selector ".reaction"
+    end
+
+    assert_not @comment.reactions.exists?(content: "👍")
+  end
+
+  test "reactions made elsewhere appear without reloading" do
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+    @comment.reactions.create!(content: "🎉", reacter: users(:jz))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment)}" do
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+end
