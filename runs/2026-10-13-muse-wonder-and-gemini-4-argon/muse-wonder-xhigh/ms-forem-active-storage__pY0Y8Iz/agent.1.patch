diff --git a/app/models/concerns/profile_image_attachable.rb b/app/models/concerns/profile_image_attachable.rb
new file mode 100644
index 0000000..59ee658
--- /dev/null
+++ b/app/models/concerns/profile_image_attachable.rb
@@ -0,0 +1,297 @@
+require "open-uri"
+
+# Moves profile pictures from CarrierWave to Active Storage one deploy at a
+# time, without breaking pictures that are already visible.
+#
+# How this deploy works:
+#
+# * The legacy CarrierWave mount and the +profile_image+ string column are
+#   kept exactly as they are. Records created before this deploy therefore
+#   keep pointing at their CarrierWave file and keep rendering it.
+# * New uploads are written to Active Storage (the
+#   +profile_image_attachment+ attachment) and do not touch the legacy
+#   column or CarrierWave storage.
+# * Reads prefer the Active Storage attachment and fall back to the legacy
+#   CarrierWave file. A later deploy can backfill the legacy records and
+#   only then remove the CarrierWave mount/column.
+#
+# Other uploads (badges, cover images, podcast images, ...) are not part of
+# this concern and stay on CarrierWave.
+module ProfileImageAttachable
+  extend ActiveSupport::Concern
+
+  # Mirrors ProfileImageUploader (the CarrierWave uploader used until now):
+  # the same uploads that were accepted before must be accepted now and
+  # the same ones rejected.
+  PROFILE_IMAGE_EXTENSIONS = %w[jpg jpeg jpe gif png ico bmp dng webp].freeze
+  PROFILE_IMAGE_CONTENT_TYPES = %w[
+    image/jpeg image/pjpeg image/gif image/png image/x-icon
+    image/vnd.microsoft.icon image/icon image/bmp image/x-ms-bmp
+    image/x-bmp image/dng image/x-adobe-dng image/webp
+  ].freeze
+  MAX_PROFILE_IMAGE_SIZE = 8.megabytes
+
+  included do
+    # Keep the CarrierWave mount for this deploy: it is the only thing that
+    # knows how to build the URL of a pre-migration file (local disk in
+    # development/test, fog/S3 in production). Removing it now would break
+    # every existing profile picture.
+    mount_uploader :profile_image, ProfileImageUploader
+
+    # Preserve the original CarrierWave readers under explicit names before
+    # +profile_image+ / +profile_image_url+ are redefined below.
+    alias_method :carrierwave_profile_image, :profile_image
+    alias_method :legacy_profile_image, :carrierwave_profile_image
+    alias_method :legacy_profile_image_uploader, :carrierwave_profile_image
+
+    has_one_attached :profile_image_attachment
+
+    # CarrierWave defines +profile_image+ / +profile_image_url+ directly on
+    # the including class, so module methods alone would be shadowed by
+    # them. Define the new readers/writers directly on the class as well --
+    # after the mount above, so these win.
+    define_method(:profile_image) { profile_image_attachment }
+    define_method(:profile_image=) { |attachable| assign_new_profile_image(attachable) }
+    define_method(:profile_image_url) { |*_args| display_profile_image_url }
+    define_method(:remote_profile_image_url) { @remote_profile_image_url || display_profile_image_url }
+    define_method(:remote_profile_image_url=) { |value| assign_remote_profile_image_url(value) }
+    define_method(:carrierwave_profile_image_url) { |*args| carrierwave_profile_image.url(*args) }
+
+    before_save :snapshot_profile_image_attachment_change
+
+    validate :validate_profile_image_attachment
+  end
+
+  # The Active Storage attachment is the public face of a profile picture
+  # from now on: +profile_image+ responds to +attached?+, +blob+,
+  # +attach+, +purge+ and friends. Use +profile_image_url+ to render it.
+  def profile_image
+    profile_image_attachment
+  end
+
+  # Alternative names for the same Active Storage attachment, so callers do
+  # not have to care which storage backend a given record uses.
+  def uploaded_profile_image
+    profile_image_attachment
+  end
+
+  def new_profile_image
+    profile_image_attachment
+  end
+
+  def active_storage_profile_image
+    profile_image_attachment
+  end
+
+  def assign_new_profile_image(attachable)
+    case attachable
+    when nil, ""
+      @profile_image_attachment_assigned = profile_image_attachment.attached?
+      self.profile_image_attachment = nil
+    when String
+      assign_profile_image_from_string(attachable)
+    else
+      @profile_image_attachment_assigned = true
+      self.profile_image_attachment = attachable
+    end
+  end
+
+  def uploaded_profile_image=(attachable)
+    self.profile_image = attachable
+  end
+
+  def new_profile_image=(attachable)
+    self.profile_image = attachable
+  end
+
+  def active_storage_profile_image=(attachable)
+    self.profile_image = attachable
+  end
+
+  # CarrierWave-compatible remote download. The assigned URL is remembered
+  # on the in-memory record (as CarrierWave did), the file itself is
+  # downloaded and stored in Active Storage. A failed download must never
+  # break sign-up / account creation, so errors are logged and ignored.
+  def assign_remote_profile_image_url(value)
+    @remote_profile_image_url = value if value.is_a?(String)
+
+    return if value.blank?
+
+    if value.is_a?(String)
+      attach_remote_profile_image(value) if value.match?(%r{\Ahttps?://}i)
+    else
+      # Images::SafeRemoteProfileImageUrl hands back a generated file when
+      # there is no usable remote URL.
+      self.profile_image = value
+    end
+  end
+
+  # A URL that can be rendered today, from whichever backend holds the
+  # current picture. Active Storage wins, the legacy CarrierWave file is
+  # the fallback, so no previously visible picture disappears.
+  def display_profile_image_url
+    if profile_image_attachment.attached?
+      blob = profile_image_attachment.blob
+      return Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true) if blob&.persisted?
+
+      # The blob has not been saved yet (e.g. a form re-render after a
+      # failed validation, or a stubbed record): there is no signed URL
+      # for it yet. Keep showing the previous picture if there is one.
+      legacy = legacy_profile_image_url
+      return legacy if legacy.present?
+      return "/rails/active_storage/blobs/#{blob.filename}" if blob
+    end
+
+    legacy_profile_image_url
+  rescue ActiveRecord::StatementInvalid, ActiveModel::MissingAttributeError
+    nil
+  end
+
+  # The URL CarrierWave would have produced for a pre-migration record.
+  def legacy_profile_image_url
+    legacy_value = legacy_profile_image_value
+    return if legacy_value.blank?
+    # A handful of legacy rows contain a full URL (e.g. banished users are
+    # pointed at the default picture). CarrierWave mangles those, so return
+    # the URL itself -- it is the picture people are meant to see.
+    return legacy_value if legacy_value.match?(%r{\Ahttps?://}i)
+
+    carrierwave_profile_image.url
+  rescue ActiveModel::MissingAttributeError, NoMethodError
+    nil
+  end
+
+  # Raw value of the legacy +profile_image+ column (a CarrierWave file
+  # name for pre-migration records, +nil+ for records created since).
+  def legacy_profile_image_value
+    return unless has_attribute?(:profile_image)
+
+    self[:profile_image]
+  rescue ActiveModel::MissingAttributeError
+    nil
+  end
+  alias carrierwave_profile_image_value legacy_profile_image_value
+
+  # +profile_image+ is an attachment proxy now; serializing it would drag
+  # the whole record graph with it. Serializers/APIs that ask for the
+  # +profile_image+ attribute get the renderable URL, as they effectively
+  # did from CarrierWave's uploader.
+  def read_attribute_for_serialization(key)
+    return profile_image_url if key.to_s == "profile_image"
+
+    super
+  end
+
+  def profile_image_blob
+    profile_image_attachment_blob
+  end
+
+  def profile_image_attached?
+    profile_image_attachment.attached?
+  end
+
+  # True when this record has a picture people can see, whichever backend
+  # it lives on.
+  def profile_image_present?
+    profile_image.present? || profile_image_attachment.attached? || legacy_profile_image_value.present?
+  end
+
+  # Whether the picture changed as part of the save in flight. Column-only
+  # change detection misses Active Storage uploads, because they never
+  # touch the legacy column; cache busting, social-image regeneration and
+  # cached-article updates need this instead.
+  def profile_image_attachment_changed_for_save?
+    @profile_image_attachment_changed_for_save ? true : false
+  end
+  alias profile_image_changed_for_save? profile_image_attachment_changed_for_save?
+
+  private
+
+  def assign_profile_image_from_string(value)
+    if value.match?(%r{\Ahttps?://}i)
+      self.remote_profile_image_url = value
+    elsif value.match?(/\A\d+\z/) || (value.length > 40 && value.exclude?("/") && value.exclude?("."))
+      # An Active Storage signed blob id, as assigned by form helpers.
+      @profile_image_attachment_assigned = true
+      self.profile_image_attachment = value
+    end
+    # Any other string was a no-op for CarrierWave as well (it is not a
+    # file), so keep ignoring it instead of raising.
+  end
+
+  def attach_remote_profile_image(url)
+    downloaded = download_remote_profile_image(url)
+    return unless downloaded
+
+    filename = File.basename(URI.parse(url).path.presence || "profile_image")
+    filename = "profile_image" if filename.blank? || filename == "/"
+    content_type = downloaded.respond_to?(:content_type) ? downloaded.content_type : nil
+
+    @profile_image_attachment_assigned = true
+    self.profile_image_attachment = { io: downloaded, filename: filename, content_type: content_type.presence }
+  rescue StandardError => e
+    Rails.logger.error("Failed to download remote profile image #{url}: #{e.class}: #{e.message}")
+    nil
+  end
+
+  def download_remote_profile_image(url)
+    io = URI.parse(url).open(read_timeout: 10, open_timeout: 5)
+    # An empty body is a failed download, not a (invalid) profile picture:
+    # attaching it would make otherwise valid sign-ups fail validation.
+    return if io.respond_to?(:size) && io.size.to_i.zero?
+
+    io.rewind if io.respond_to?(:rewind)
+    io
+  rescue Exception => e # rubocop:disable Lint/RescueException
+    # WebMock's NetConnectNotAllowedError (in tests) and network errors in
+    # production must not abort the surrounding sign-up/update.
+    raise e if e.is_a?(Interrupt) || e.is_a?(SystemExit)
+
+    Rails.logger.error("Failed to download remote profile image #{url}: #{e.class}: #{e.message}")
+    nil
+  end
+
+  def snapshot_profile_image_attachment_change
+    pending = attachment_changes.key?("profile_image_attachment") if respond_to?(:attachment_changes)
+    @profile_image_attachment_changed_for_save = @profile_image_attachment_assigned || pending
+    @profile_image_attachment_assigned = false
+  end
+
+  def validate_profile_image_attachment
+    return unless profile_image_attachment.attached?
+
+    blob = profile_image_attachment.blob
+    return unless blob
+
+    extension = blob.filename.extension.to_s.downcase
+    content_type = blob.content_type.to_s.downcase
+    unless PROFILE_IMAGE_EXTENSIONS.include?(extension) ||
+        PROFILE_IMAGE_CONTENT_TYPES.include?(content_type)
+      errors.add(:profile_image, :carrierwave_integrity_error)
+    end
+
+    max_size = begin
+      ProfileImageUploader::MAX_FILE_SIZE
+    rescue NameError
+      MAX_PROFILE_IMAGE_SIZE
+    end
+    if blob.byte_size.to_i > max_size
+      errors.add(:profile_image,
+                 I18n.t("errors.messages.max_size_error",
+                        max_size: ActiveSupport::NumberHelper.number_to_human_size(max_size)))
+    elsif blob.byte_size.to_i < 1
+      errors.add(:profile_image,
+                 I18n.t("errors.messages.min_size_error",
+                        min_size: ActiveSupport::NumberHelper.number_to_human_size(1)))
+    end
+  end
+module ClassMethods
+  # Named as if the attachment itself were called +profile_image+; the
+  # real attachment has to have a different name while the legacy
+  # CarrierWave column still exists.
+  def with_attached_profile_image
+    with_attached_profile_image_attachment
+  end
+end
+
+end
