diff --git a/spec/models/concerns/profile_image_attachable_spec.rb b/spec/models/concerns/profile_image_attachable_spec.rb
new file mode 100644
index 0000000..a074b1f
--- /dev/null
+++ b/spec/models/concerns/profile_image_attachable_spec.rb
@@ -0,0 +1,117 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageAttachable do
+  let(:image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+
+  describe "a record created before the migration (CarrierWave only)" do
+    let!(:user) { create(:user) }
+
+    before do
+      user.profile_image.purge
+      user.update_columns(profile_image: "legacy-picture.jpg")
+      user.reload
+    end
+
+    it "still renders the legacy CarrierWave picture" do
+      expect(user.profile_image_url).to include("uploads/user/profile_image/#{user.id}/legacy-picture.jpg")
+      expect(user.profile_image_90).to be_present
+    end
+
+    it "is still valid" do
+      expect(user).to be_valid
+    end
+
+    it "keeps showing the legacy picture until a new one is uploaded, then prefers Active Storage" do
+      user.profile_image = File.open(image_path)
+      user.save!
+      user.reload
+
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+      expect(user[:profile_image]).to eq("legacy-picture.jpg")
+    end
+  end
+
+  describe "a new upload" do
+    it "stores a user's picture in Active Storage and not in the legacy column" do
+      user = create(:user, profile_image: Rack::Test::UploadedFile.new(image_path, "image/jpeg"))
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_attachment).to be_attached
+      expect(user[:profile_image]).to be_blank
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+      expect(user.profile_image.blob.download).to eq(File.binread(image_path))
+    end
+
+    it "stores an organization's picture in Active Storage and not in the legacy column" do
+      organization = create(:organization,
+                            profile_image: Rails.root.join("app/assets/images/android-icon-36x36.png").open)
+
+      expect(organization.profile_image).to be_attached
+      expect(organization[:profile_image]).to be_blank
+      expect(organization.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "rejects files CarrierWave would have rejected" do
+      pdf = Rack::Test::UploadedFile.new(Rails.root.join("spec/fixtures/files/800x600.pdf"), "application/pdf")
+      user = build(:user, profile_image: pdf)
+
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to be_present
+    end
+  end
+
+  describe "an organization created before the migration" do
+    let!(:organization) { create(:organization) }
+
+    before do
+      organization.profile_image.purge
+      organization.update_columns(profile_image: "legacy-org.png")
+      organization.reload
+    end
+
+    it "still renders the legacy picture and stays valid" do
+      expected = "uploads/organization/profile_image/#{organization.id}/legacy-org.png"
+      expect(organization.profile_image_url).to include(expected)
+      expect(organization).to be_valid
+    end
+  end
+
+  describe "remote profile pictures" do
+    it "downloads the remote file into Active Storage" do
+      stub_request(:get, "https://example.com/avatar.jpg")
+        .to_return(status: 200, body: File.binread(image_path), headers: { "Content-Type" => "image/jpeg" })
+
+      user = create(:user, profile_image: nil)
+      user.remote_profile_image_url = "https://example.com/avatar.jpg"
+      user.save!
+      user.reload
+
+      expect(user.profile_image).to be_attached
+      expect(user.profile_image_url).to include("/rails/active_storage/")
+    end
+
+    it "does not fail the record when the remote file cannot be downloaded" do
+      stub_request(:get, "https://example.com/missing.jpg").to_return(status: 404, body: "")
+
+      user = build(:user, profile_image: nil)
+      user.remote_profile_image_url = "https://example.com/missing.jpg"
+
+      expect(user.save).to be(true)
+    end
+  end
+
+describe "cache busting" do
+  it "enqueues a profile image cache bust when a user uploads a new picture" do
+    user = create(:user)
+
+    sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+      user.update!(profile_image: File.open(image_path))
+    end
+  end
+end
+
+  it "leaves other CarrierWave uploads alone" do
+    expect(Tag.uploaders[:profile_image]).to eq(ProfileImageUploader)
+    expect(Podcast.uploaders[:image]).to eq(ProfileImageUploader)
+  end
+end
