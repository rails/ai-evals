@@ -0,0 +1,35 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    events = Event.preloaded
+      .where(board: Current.user.boards, action: ACTIVITY_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+    events = events.where(creator_id: creator_ids) if creator_ids.any?
+    events = events.where(board_id: board_ids) if board_ids.any?
+
+    set_page_and_extract_portion_from events
+  end
+
+  private
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..2f306aa
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,48 @@
+particulars = activity.particulars || {}
+nested_particulars = particulars["particulars"] || particulars[:particulars] || {}
+event_particulars = particulars.merge(nested_particulars)
+particulars_data = case activity.action.to_s
+when "card_assigned", "card_unassigned"
+  { assignee_ids: Array(activity.assignee_ids || event_particulars["assignee_ids"] || event_particulars[:assignee_ids]) }
+when "card_board_changed"
+  {
+    old_board: event_particulars["old_board"] || event_particulars[:old_board] || "",
+    new_board: event_particulars["new_board"] || event_particulars[:new_board] || ""
+  }
+when "card_title_changed"
+  {
+    old_title: event_particulars["old_title"] || event_particulars[:old_title] || "",
+    new_title: event_particulars["new_title"] || event_particulars[:new_title] || ""
+  }
+when "card_triaged"
+  { column: event_particulars["column"] || event_particulars[:column] || "" }
+else
+  {}
+end
+activity_url = case activity.eventable
+when Comment
+  card_url(activity.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(activity.eventable))
+when Card
+  card_url(activity.eventable)
+else
+  polymorphic_url(activity.eventable)
+end
+
+json.(activity, :id, :action)
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+json.particulars particulars_data
+json.url activity_url
+json.eventable_type activity.eventable_type
+
+json.eventable do
+  case activity.eventable
+  when Card
+    json.partial! "cards/card", card: activity.eventable
+  when Comment
+    json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
