@@ -0,0 +1,62 @@
+# Activities
+
+Activities are events in the account, such as cards being added, assigned, moved, or commented on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of account activity you have access to, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by event creator user ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David assigned JZ to \"Layout is broken\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjysoy0fqs9yg0ei3hq"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 2,
+      "title": "Layout is broken",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Writebook",
+      "all_access": true
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true
+    }
+  }
+]
+```
+
+The `eventable` object uses the same representation as the corresponding card or comment API endpoint, `board` uses the board representation, and `creator` uses the user representation. For comment events, `url` opens the card where the comment was posted and jumps to that comment.
+
+The `particulars` object contains event-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other events return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..adffbb0
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array newest first" do
+    get activities_path(format: :json)
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index as JSON includes event attributes" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:layout_commented).id }
+    assert_not_nil activity
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal events(:layout_commented).eventable_id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_includes activity["description"], "commented on"
+    assert_equal({}, activity["particulars"])
+
+    expected_url = card_url(cards(:layout), anchor: ActionView::RecordIdentifier.dom_id(comments(:layout_overflowing_david)))
+    assert_equal expected_url, activity["url"]
+  end
+
+  test "index as JSON returns card url for card events" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_published).id }
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+  end
+
+  test "index as JSON includes assignment particulars" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_assignment_jz).id }
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON omits card_collection_changed and includes card_title_changed" do
+    events(:logo_published).update_columns(action: "card_collection_changed")
+    events(:layout_published).update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path(format: :json)
+    ids = @response.parsed_body.pluck("id")
+    assert_not_includes ids, events(:logo_published).id
+    assert_includes ids, events(:layout_published).id
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:layout_published).id }
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "index as JSON includes board and triage particulars with empty string fallbacks" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old Board" } })
+    events(:layout_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path(format: :json)
+
+    board_activity = @response.parsed_body.find { |a| a["id"] == events(:logo_published).id }
+    assert_equal({ "old_board" => "Old Board", "new_board" => "" }, board_activity["particulars"])
+
+    triage_activity = @response.parsed_body.find { |a| a["id"] == events(:layout_published).id }
+    assert_equal({ "column" => "" }, triage_activity["particulars"])
+  end
+
+  test "index as JSON filters by creator_ids and board_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert @response.parsed_body.all? { |a| a.dig("creator", "id") == users(:kevin).id }
+    assert @response.parsed_body.any?
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index as JSON only returns activity from accessible boards" do
+    events(:logo_published).update_columns(board_id: boards(:private).id)
+
+    logout_and_sign_in_as :jz
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+end
