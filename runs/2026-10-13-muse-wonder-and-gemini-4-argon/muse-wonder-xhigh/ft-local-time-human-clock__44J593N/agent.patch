+    if (hasTime && hasWeekday) return "full_datetime"
+    if (hasTime) return rawFormat.includes("%B") || rawFormat.includes("%b") ? "datetime" : "time"
+    if (hasWeekday) return "long_date"
+    if (hasYear) return "date_with_year"
+    return "date"
+  }
