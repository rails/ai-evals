diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..f694466 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,76 @@
 module TimeHelper
+  # Renders a raw timestamp for the browser to format in the viewer's own
+  # timezone, instead of baking a server-timezone string into HTML that we
+  # would like to cache and share between people.
+  #
+  # The server only sends the timestamp (in the +datetime+ attribute); the
+  # +local-time+ Stimulus controller fills in the text on the client. See
+  # +formatLocalTime+ in +app/javascript/helpers/date_helpers.js+ for the
+  # formats. Supported +format+ values include:
+  #
+  # * +:time+ -- "1:42 PM"
+  # * +:date+ -- "Sep 12" (with a year when it isn't the current one)
+  # * +:date_with_year+ -- "Sep 12, 2025"
+  # * +:long_date+ -- "Monday, September 12"
+  # * +:datetime+ -- "Sep 12, 1:42 PM"
+  # * +:numeric_datetime+ -- "9/12/25, 1:42 PM"
+  # * +:relative+ -- "1:42 PM" today, "yesterday", "5 days ago", or "Sep 12";
+  #   "tomorrow" or "in 3 days" for near-future timestamps
+  # * +:relative_future+ -- "today", "tomorrow", or "in 3 days"
+  def local_time_tag(time, *args, format: nil, type: nil, **options)
+    if time.present?
+      format = (format || type || args.first || :relative).to_s
+      data = options.delete(:data) || {}
+      classes = options.delete(:class)
+
+      tag.time(
+        datetime: timestamp_for_local_time_tag(time),
+        data: data.merge(
+          controller: [ data[:controller], "local-time" ].compact.join(" "),
+          local_time_format_value: format,
+          local_time: format
+        ),
+        class: [ "local-time-value", classes ].flatten.compact.join(" "),
+        **options
+      )
+    end
+  end
+
+  # Aliases that read naturally at different call sites.
+  def local_time(time, *args, **options)
+    local_time_tag(time, *args, **options)
+  end
+
+  def local_date(time, **options)
+    local_time_tag(time, format: :date, **options)
+  end
+
+  def local_datetime(time, **options)
+    local_time_tag(time, format: :datetime, **options)
+  end
+
+  def local_time_ago(time, **options)
+    local_time_tag(time, format: :relative, **options)
+  end
+
+  def local_relative_time(time, **options)
+    local_time_tag(time, format: :relative, **options)
+  end
+
+  def local_relative_future_time(time, **options)
+    local_time_tag(time, format: :relative_future, **options)
+  end
+
+  alias local_time_ago_tag local_time_ago
+  alias relative_time_tag local_relative_time
+  alias time_ago_tag local_time_ago
+
+  private
+    def timestamp_for_local_time_tag(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        time.iso8601
+      end
+    end
 end
