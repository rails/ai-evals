+    case "short_date":
+      return "date"
+    case "long":
+    case "weekday_date":
+    case "full_date":
+      return "long_date"
+    case "date_time":
+      return "datetime"
+    case "time_ago":
+    case "relative_time":
+    case "time_or_date":
+    case "relative_date":
+      return "relative"
+    case "future":
+    case "time_until":
+    case "days_until":
+      return "relative_future"
+    default:
+      return (format || "relative").toString().replaceAll("-", "_")
