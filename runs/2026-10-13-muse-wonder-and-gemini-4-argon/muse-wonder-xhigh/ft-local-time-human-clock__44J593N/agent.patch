+// "1:42 PM" today, "yesterday" last night, "5 days ago" earlier in the
+// week, and "Sep 12" before that -- with "tomorrow" / "in 3 days" for the
+// near future. Distances are counted in calendar days in the viewer's
+// timezone, so a comment posted late last night reads "yesterday" even
+// when it is only a few hours old.
+function formatRelative(date, now) {
+  const daysAgo = signedDifferenceInDays(date, now)
+
+  if (daysAgo === 0) {
+    return formatTime(date)
+  } else if (daysAgo === 1) {
+    return "yesterday"
+  } else if (daysAgo > 1 && daysAgo < 7) {
+    return `${daysAgo} days ago`
+  } else if (daysAgo === -1) {
+    return "tomorrow"
+  } else if (daysAgo < -1 && daysAgo > -7) {
