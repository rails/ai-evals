diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..da6718f
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag sends the raw timestamp for the browser to format" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    tag = local_time_tag(time)
+
+    assert_select_in tag, "time[datetime='2025-09-12T13:42:00Z']"
+    assert_select_in tag, "time[data-controller='local-time']"
+    assert_select_in tag, "time[data-local-time-format-value='relative']"
+    assert_select_in tag, "time[data-local-time='relative']"
+    assert_select_in tag, "time.local-time-value"
+    # No server-rendered, server-timezone words are baked into the HTML.
+    assert_equal "", Nokogiri::HTML.fragment(tag).text
+  end
+
+  test "local_time_tag accepts a format" do
+    tag = local_time_tag(Time.utc(2025, 9, 12, 13, 42), format: :time)
+
+    assert_select_in tag, "time[data-local-time-format-value='time']"
+  end
+
+  test "local_time_tag converts timestamps to UTC" do
+    tag = local_time_tag(Time.find_zone!("America/New_York").local(2025, 9, 12, 13, 42))
+
+    assert_select_in tag, "time[datetime='2025-09-12T17:42:00Z']"
+  end
+
+  test "local_time_tag renders nothing without a time" do
+    assert_nil local_time_tag(nil)
+  end
+
+  private
+    def assert_select_in(html, selector)
+      assert_select Nokogiri::HTML.fragment(html), selector, 1
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..99bed04
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,29 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comment timestamps are rendered by the browser" do
+    sign_in_as users(:david)
+
+    visit card_url(cards(:logo))
+
+    comment = comments(:logo_agreement_kevin)
+    within "##{ActionView::RecordIdentifier.dom_id(comment)}" do
+      assert_selector "time[data-controller='local-time'][datetime]", wait: 5
+      assert_match(/\A(\d{1,2}:\d{2} [AP]M|yesterday)\z/i, find("time[data-controller='local-time']").text)
+    end
+
+    two_days_old_comment = comments(:logo_agreement_jz)
+    within "##{ActionView::RecordIdentifier.dom_id(two_days_old_comment)}" do
+      assert_selector "time[data-controller='local-time']", text: /\A(2 days ago|yesterday)\z/i, wait: 5
+    end
+  end
+
+  test "card auto-close time is rendered by the browser" do
+    sign_in_as users(:david)
+
+    visit card_url(cards(:logo))
+
+    assert_selector ".card-perma__closure-message time[data-local-time-format-value='relative_future']", wait: 5
+    assert_match(/\A(today|tomorrow|in \d+ days)\z/i, find(".card-perma__closure-message time").text)
+  end
+end
