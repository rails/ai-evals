diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..bd34f9a
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, formatFullDateTime } from "helpers/date_helpers"
+
+// Turns the raw timestamp the server sent (the <time> element's +datetime+
+// attribute) into words in the viewer's own timezone, e.g. "1:42 PM",
+// "yesterday", "5 days ago", "Sep 12", "tomorrow", or "in 3 days".
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #observer
+  #titleFromController = false
+
+  connect() {
+    this.#render()
+    this.#observer = new MutationObserver(() => this.#render())
+    this.#observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-format-value" ]
+    })
+  }
+
+  disconnect() {
+    this.#observer?.disconnect()
+  }
+
+  formatValueChanged() {
+    this.#render()
+  }
+
+  #render() {
+    const date = new Date(this.element.dateTime)
+    if (Number.isNaN(date.getTime())) return
+
+    this.element.textContent = formatLocalTime(date, this.formatValue)
+    if (!this.element.title || this.#titleFromController) {
+      this.element.title = formatFullDateTime(date)
+      this.#titleFromController = true
+    }
+  }
+}
