new file mode 100644
index 0000000..749eaff
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,128 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def start_magic_link_authentication(identity, flow:, join_code: nil, account: nil)
+      magic_link = MagicLink.create(
+        email_address: identity.email_address,
+        flow: flow,
+        join_code: join_code&.code,
+        account_id: account&.id
+      )
+
+      cookies[:pending_authentication_token] = {
+        value: magic_link.token,
+        httponly: true,
+        same_site: :lax,
+        expires: MagicLink::EXPIRY.from_now
+      }
+
+      IdentityMailer.magic_link(identity, magic_link.code).deliver_now
+
+      magic_link
+    end
+
+    def pending_magic_link
+      if defined?(@pending_magic_link)
+        @pending_magic_link
+      else
+        @pending_magic_link = MagicLink.from_token(pending_authentication_token)
+      end
+    end
+
+    def pending_authentication_token
+      params[:pending_authentication_token].presence || cookies[:pending_authentication_token].presence
+    end
+
+    def magic_link_code
+      code = params[:code].presence
+      code ||= params.dig(:magic_link, :code).presence if params[:magic_link].present?
+      code ||= params.dig(:signup, :code).presence if params[:signup].present?
+      code ||= params.dig(:session, :code).presence if params[:session].present?
+      code
+    end
+
+    def complete_magic_link_authentication(candidate_code = magic_link_code)
+      if pending_magic_link&.authenticate?(candidate_code)
+        magic_link = pending_magic_link
+        cookies.delete(:pending_authentication_token)
+
+        identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+        start_new_session_for(identity)
+
+        respond_to_magic_link_success(magic_link, identity)
+        true
+      else
+        respond_to_magic_link_failure
+        false
+      end
+    end
+
+    def respond_to_magic_link_success(magic_link, identity)
+      case magic_link.flow
+      when "sign_up"
+        respond_to do |format|
+          format.html { redirect_to new_signup_completion_url(script_name: nil) }
+          format.json { render json: { session_token: session_token } }
+        end
+      when "join"
+        respond_to_magic_link_join(magic_link, identity)
+      else
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    end
+
+    def respond_to_magic_link_join(magic_link, identity)
+      account = magic_link.account
+      join_code = magic_link.join_code_record
+
+      if account.blank? || join_code.blank?
+        respond_to do |format|
+          format.html { head :not_found }
+          format.json { render json: { message: "That join code wasn't found." }, status: :not_found }
+        end
+      else
+        @join_code = join_code
+        join_code.redeem_if { |join_account| identity.join(join_account) }
+        user = User.active.find_by(account: account, identity: identity)
+
+        if user.present?
+          respond_to do |format|
+            format.html do
+              if user.setup?
+                redirect_to landing_url(script_name: account.slug)
+              else
+                redirect_to new_users_verification_url(script_name: account.slug)
+              end
+            end
+            format.json { render json: { session_token: session_token } }
+          end
+        else
+          respond_to do |format|
+            format.html { render "join_codes/inactive", status: :gone, layout: "public" }
+            format.json { render json: { message: "That join code is no longer active." }, status: :gone }
+          end
+        end
+      end
+    end
+
+    def respond_to_magic_link_failure
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to magic_link_failure_url, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def magic_link_failure_url
+      if pending_magic_link.present?
+        new_session_magic_link_url(script_name: nil)
+      else
+        new_session_url(script_name: nil)
+      end
+    end
+end
