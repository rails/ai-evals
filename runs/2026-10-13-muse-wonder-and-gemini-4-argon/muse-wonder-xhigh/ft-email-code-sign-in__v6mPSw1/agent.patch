diff --git a/app/mailers/identity_mailer.rb b/app/mailers/identity_mailer.rb
new file mode 100644
index 0000000..3e2f5f6
--- /dev/null
+++ b/app/mailers/identity_mailer.rb
@@ -0,0 +1,25 @@
+class IdentityMailer < ApplicationMailer
+  def magic_link(identity_or_email_address, code_or_magic_link = nil)
+    send_code(identity_or_email_address, code_or_magic_link)
+  end
+
+  def sign_in_code(identity_or_email_address, code_or_magic_link = nil)
+    send_code(identity_or_email_address, code_or_magic_link, template: :magic_link)
+  end
+  alias email_code sign_in_code
+
+  private
+    def send_code(identity_or_email_address, code_or_magic_link, template: nil)
+      @code = code_or_magic_link.respond_to?(:code) ? code_or_magic_link.code : code_or_magic_link.to_s
+      email_address = if identity_or_email_address.respond_to?(:email_address)
+        identity_or_email_address.email_address
+      else
+        identity_or_email_address.to_s
+      end
+
+      mail_options = { to: email_address, subject: "#{@code} is your Fizzy sign-in code" }
+      mail_options[:template_name] = template if template
+
+      mail(**mail_options)
+    end
+end
diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..b2c05a6
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,76 @@
+class MagicLink
+  EXPIRY = 15.minutes
+  CODE_LENGTH = 6
+  CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789".chars.freeze
+
+  attr_reader :email_address, :code, :flow, :join_code, :account_id, :token
+
+  class << self
+    def create(email_address:, code: nil, flow: "sign_in", join_code: nil, account_id: nil)
+      code ||= generate_code
+      payload = {
+        "email_address" => email_address,
+        "flow" => flow.to_s,
+        "join_code" => join_code,
+        "account_id" => account_id
+      }.compact
+
+      token = encryptor.encrypt_and_sign(payload.merge("code" => code), expires_in: EXPIRY, purpose: :magic_link)
+
+      new(payload: payload, code: code, token: token)
+    end
+
+    def from_token(token)
+      if token.present?
+        payload = encryptor.decrypt_and_verify(token, purpose: :magic_link)
+        code = payload.delete("code") if payload.is_a?(Hash)
+
+        new(payload: payload, code: code, token: token) if code.present?
+      end
+    rescue ActiveSupport::MessageEncryptor::InvalidMessage, ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def generate_code
+      Array.new(CODE_LENGTH) { CODE_ALPHABET.fetch(SecureRandom.random_number(CODE_ALPHABET.size)) }.join
+    end
+
+    private
+      def encryptor
+        ActiveSupport::MessageEncryptor.new(
+          Rails.application.key_generator.generate_key("magic_links", ActiveSupport::MessageEncryptor.key_len),
+          url_safe: true
+        )
+      end
+  end
+
+  def initialize(payload:, code:, token:)
+    payload ||= {}
+
+    @email_address = payload["email_address"] || payload[:email_address]
+    @flow = payload["flow"] || payload[:flow] || "sign_in"
+    @join_code = payload["join_code"] || payload[:join_code]
+    @account_id = payload["account_id"] || payload[:account_id]
+    @code = code.to_s
+    @token = token
+  end
+
+  def authenticate?(candidate)
+    candidate_code = candidate.to_s.strip.upcase
+
+    code.present? && candidate_code.present? && ActiveSupport::SecurityUtils.secure_compare(code, candidate_code)
+  end
+  alias valid_code? authenticate?
+
+  def account
+    if account_id.present?
+      Account.find_by(id: account_id)
+    end
+  end
+
+  def join_code_record
+    if join_code.present? && account.present?
+      Account::JoinCode.find_by(code: join_code, account: account)
+    end
+  end
+end
