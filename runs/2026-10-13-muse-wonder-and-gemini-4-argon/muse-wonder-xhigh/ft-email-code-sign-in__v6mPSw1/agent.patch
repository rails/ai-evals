+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @pending_magic_link&.email_address.present? %>
+    <p>We sent a six-character code to <%= @pending_magic_link.email_address %>. Enter it below to continue. It works for 15 minutes.</p>
+  <% else %>
+    <p>Enter the six-character code we sent to your email address. It works for 15 minutes.</p>
+  <% end %>
+
+  <%= form_with url: session_magic_link_path(script_name: nil), class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if Rails.env.development? && @pending_magic_link&.code.present? %>
+    <p class="txt-small txt-subtle">Psst, here's your code: <strong><%= @pending_magic_link.code %></strong></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
