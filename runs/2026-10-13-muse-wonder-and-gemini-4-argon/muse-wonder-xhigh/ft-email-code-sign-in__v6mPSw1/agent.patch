index 0000000..022e373
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signing in by email code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+
+      assert_redirected_to new_session_magic_link_path
+
+      mail = ActionMailer::Base.deliveries.last
+      assert mail
+      assert_equal [ identities(:kevin).email_address ], mail.to
+
+      code = mail.subject[/\A[A-Z0-9]{6}/]
+      assert code, "expected the code to start the email subject"
+      assert_match code, mail.body.encoded
+
+      get new_session_magic_link_path
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+      assert_redirected_to landing_path
+    end
+  end
+
+  test "signing in by email code via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: identities(:kevin).email_address }
+
+      assert_response :created
+      pending_token = response.parsed_body["pending_authentication_token"]
+      assert pending_token.present?
+      assert cookies[:pending_authentication_token].present?
+
+      code = ActionMailer::Base.deliveries.last.subject[/\A[A-Z0-9]{6}/]
+
+      post session_magic_link_path(format: :json), params: { code: code, pending_authentication_token: pending_token }
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "signing in with a wrong code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+
+      post session_magic_link_path, params: { code: "ZZZZZZ" }
+
+      assert_redirected_to new_session_magic_link_url(script_name: nil)
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "signing in with an expired code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      code = ActionMailer::Base.deliveries.last.subject[/\A[A-Z0-9]{6}/]
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "signing in with an invalid email address" do
+    untenanted do
+      assert_no_emails do
+        post session_path, params: { email_address: "not-a-valid-email" }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "signing up by email code" do
+    untenanted do
+      post signup_path, params: { signup: { email_address: "new.user@example.com" } }
+
+      assert_redirected_to new_session_magic_link_path
+
+      code = ActionMailer::Base.deliveries.last.subject[/\A[A-Z0-9]{6}/]
+      post session_magic_link_path, params: { code: code }
+
+      assert cookies[:session_token].present?
+      assert_redirected_to new_signup_completion_url(script_name: nil)
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New User" } }
+      end
+    end
+  end
+
+  test "joining by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_difference -> { User.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joining.user@example.com" }
+
+      assert_redirected_to new_session_magic_link_url(script_name: nil)
+
+      code = ActionMailer::Base.deliveries.last.subject[/\A[A-Z0-9]{6}/]
+
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert cookies[:session_token].present?
+  end
+end
