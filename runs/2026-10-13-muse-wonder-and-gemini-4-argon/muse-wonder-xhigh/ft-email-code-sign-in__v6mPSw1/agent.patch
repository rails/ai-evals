+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "codes are six characters and authenticate case-insensitively" do
+    magic_link = MagicLink.create(email_address: "user@example.com")
+
+    assert_equal 6, magic_link.code.length
+    assert magic_link.authenticate?(magic_link.code)
+    assert magic_link.authenticate?(magic_link.code.downcase)
+    assert_not magic_link.authenticate?("ZZZZZZ")
+  end
+
+  test "tokens round-trip through from_token" do
+    magic_link = MagicLink.create(email_address: "user@example.com", flow: "sign_up")
+
+    restored = MagicLink.from_token(magic_link.token)
+
+    assert_equal "user@example.com", restored.email_address
+    assert_equal "sign_up", restored.flow
+    assert_equal magic_link.code, restored.code
+  end
+
+  test "tokens expire after fifteen minutes" do
+    magic_link = MagicLink.create(email_address: "user@example.com")
+
+    travel 16.minutes do
+      assert_nil MagicLink.from_token(magic_link.token)
+    end
+  end
+
+  test "tampered tokens are rejected" do
+    magic_link = MagicLink.create(email_address: "user@example.com")
+
+    assert_nil MagicLink.from_token("#{magic_link.token}tampered")
+  end
+end
