diff --git a/app/views/play/_player.html.erb b/app/views/play/_player.html.erb
new file mode 100644
index 0000000..aadf164
--- /dev/null
+++ b/app/views/play/_player.html.erb
@@ -0,0 +1,69 @@
+<% quiz = game.quiz %>
+<% current_question = game.current_question %>
+<div data-live-root data-signature="<%= player_signature(game, player) %>">
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= quiz.title %></span>
+    </div>
+    <div class="play__body play__body--top">
+      <% if game.finished? %>
+        <h1 class="play-title">The quiz is over</h1>
+        <% if player %>
+          <p>Hi, <%= player.name %>!</p>
+        <% end %>
+        <p class="play-lead">Thanks for playing.</p>
+      <% elsif player.nil? %>
+        <h1 class="play-title"><%= quiz.title %></h1>
+        <p class="play-lead">Enter your name to join the quiz.</p>
+        <% if @join_error.present? %>
+          <div class="errors"><%= @join_error %></div>
+        <% end %>
+        <%= form_with url: play_join_path(game.join_code), method: :post, data: { turbo: false } do %>
+          <div class="field">
+            <label for="player_name">Your name</label>
+            <input class="input" type="text" name="name" id="player_name" placeholder="Your name" autocomplete="name" value="<%= @join_name %>">
+          </div>
+          <button type="submit" class="btn btn--pink">Join</button>
+        <% end %>
+      <% else %>
+        <p>Hi, <%= player.name %>!</p>
+        <% if game.lobby? %>
+          <h1 class="play-title"><%= quiz.title %></h1>
+          <p class="play-lead">Waiting for the quiz to start&hellip;</p>
+        <% elsif game.open? && current_question %>
+          <div class="play-question__num">Question <%= game.current_number %> of <%= game.total_questions %></div>
+          <div class="play-question__body"><%= current_question.text %></div>
+          <% picked = game.answers.find_by(player_id: player.id, question_id: current_question.id) %>
+          <%= form_with url: play_answer_path(game.join_code), method: :post, class: "play-options", data: { turbo: false } do %>
+            <% current_question.options.each_with_index do |option, option_index| %>
+              <% is_picked = picked && picked.option_id == option.id %>
+              <button type="submit" name="option_id" value="<%= option.id %>" class="play-option <%= "is-picked" if is_picked %>" aria-label="<%= option.text %>">
+                <span class="play-option__letter"><%= option_letter(option_index) %></span>
+                <span class="play-option__title"><%= option.text %></span>
+                <% if is_picked %><span class="play-option__mark">Your answer</span><% end %>
+              </button>
+            <% end %>
+          <% end %>
+        <% elsif game.closed? && current_question %>
+          <div class="play-question__num">Question <%= game.current_number %> of <%= game.total_questions %></div>
+          <div class="play-question__body"><%= current_question.text %></div>
+          <% picked = game.answers.find_by(player_id: player.id, question_id: current_question.id) %>
+          <% if picked.nil? %>
+            <div class="play-status play-status--neutral">No answer</div>
+          <% elsif picked.option.correct? %>
+            <div class="play-status play-status--right">Correct!</div>
+          <% else %>
+            <div class="play-status play-status--wrong">Wrong!</div>
+          <% end %>
+          <% if picked %>
+            <p class="play-lead" style="margin-top: 16px">Your answer: <%= picked.option.text %></p>
+          <% end %>
+        <% else %>
+          <h1 class="play-title"><%= quiz.title %></h1>
+          <p class="play-lead">Waiting for the quiz to start&hellip;</p>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</div>
