diff --git a/app/controllers/moderate/games_controller.rb b/app/controllers/moderate/games_controller.rb
new file mode 100644
index 0000000..ffca3a7
--- /dev/null
+++ b/app/controllers/moderate/games_controller.rb
@@ -0,0 +1,65 @@
+module Moderate
+  class GamesController < BaseController
+    before_action :set_quiz
+    before_action :set_game, only: %i[show start finish_question advance live]
+
+    def create
+      game = nil
+      Game.transaction do
+        game = @quiz.games.create!(join_code: Game.generate_join_code, status: "lobby")
+        game.snapshot_questions!
+      end
+      redirect_to moderate_quiz_game_path(@quiz, game)
+    end
+
+    def show
+      prepare_screen
+    end
+
+    def live
+      prepare_screen
+      render partial: "moderate/games/screen",
+             locals: { quiz: @quiz, game: @game, current_question: @current_question },
+             layout: false
+    end
+
+    def start
+      @game.start! if @game.lobby?
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    def finish_question
+      @game.finish_question! if @game.open?
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    def advance
+      if @game.closed?
+        if @game.last_question?
+          @game.end!
+        else
+          @game.advance!
+        end
+      end
+      redirect_to moderate_quiz_game_path(@quiz, @game)
+    end
+
+    private
+
+    def set_quiz
+      @quiz = Quiz.find(params[:quiz_id])
+    end
+
+    def set_game
+      @game = @quiz.games
+                   .includes(game_questions: { question: :options }, players: [], answers: [])
+                   .find(params[:id])
+      # includes above may leave association caches; ensure fresh counts by
+      # using the game itself (queries still hit DB for counts).
+    end
+
+    def prepare_screen
+      @current_question = @game.current_question
+    end
+  end
+end
diff --git a/app/controllers/play_controller.rb b/app/controllers/play_controller.rb
new file mode 100644
index 0000000..02391f2
--- /dev/null
+++ b/app/controllers/play_controller.rb
@@ -0,0 +1,95 @@
+class PlayController < ApplicationController
+  before_action :set_game
+
+  def show
+    @player = current_player
+    @join_error = nil
+  end
+
+  def live
+    @player = current_player
+    @join_error = nil
+    render partial: "play/player",
+           locals: { game: @game, player: @player, quiz: @game.quiz },
+           layout: false
+  end
+
+  def join
+    if @game.finished?
+      redirect_to play_path(@game.join_code)
+      return
+    end
+
+    if (existing = current_player)
+      redirect_to play_path(@game.join_code)
+      return
+    end
+
+    name = extract_name
+    @player = @game.players.build(name: name)
+
+    if name.present? && @player.save
+      cookies.permanent.signed[cookie_key] = @player.id
+      redirect_to play_path(@game.join_code)
+    else
+      @player = nil
+      @join_error = "Please enter your name."
+      @join_name = name
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  def answer
+    player = current_player
+
+    unless player && @game.open? && @game.current_question
+      redirect_to play_path(@game.join_code)
+      return
+    end
+
+    question = @game.current_question
+    option_id = params[:option_id] || params[:option] || params[:picked] || params[:answer]
+    option_id = option_id[:option_id] || option_id[:id] if option_id.respond_to?(:key?)
+    option = question.options.find_by(id: option_id.to_i)
+
+    if option
+      record = Answer.find_or_initialize_by(game_id: @game.id, player_id: player.id, question_id: question.id)
+      record.option = option
+      # find_or_initialize_by with game/player/question also satisfies the
+      # unique (player, question) index; assignment + save updates in place.
+      begin
+        record.save!
+      rescue ActiveRecord::RecordNotUnique
+        existing = Answer.find_by!(player_id: player.id, question_id: question.id)
+        existing.update!(game: @game, option: option)
+      end
+    end
+
+    redirect_to play_path(@game.join_code)
+  end
+
+  private
+
+  def set_game
+    code = params[:code].to_s.strip.upcase
+    @game = Game.includes(:quiz, game_questions: { question: :options }).find_by!(join_code: code)
+  end
+
+  def cookie_key
+    "quizzy_player_#{@game.id}"
+  end
+
+  def current_player
+    player_id = cookies.signed[cookie_key]
+    return nil if player_id.blank?
+
+    @game.players.find_by(id: player_id)
+  end
+
+  def extract_name
+    raw = params[:name]
+    raw = params[:player][:name] if raw.nil? && params[:player].respond_to?(:key?)
+    raw = raw.to_s.strip
+    raw
+  end
+end
diff --git a/app/helpers/games_helper.rb b/app/helpers/games_helper.rb
new file mode 100644
index 0000000..fb16a10
--- /dev/null
+++ b/app/helpers/games_helper.rb
@@ -0,0 +1,43 @@
+require "rqrcode"
+require "digest"
+
+module GamesHelper
+  def join_link_text(game, request)
+    "#{request.host_with_port}/play/#{game.join_code}"
+  end
+
+  def join_link_url(game, request)
+    "#{request.scheme}://#{request.host_with_port}/play/#{game.join_code}"
+  end
+
+  def qr_code_svg(url)
+    qr = RQRCode::QRCode.new(url)
+    qr.as_svg(viewbox: true, module_size: 5, offset: 10, color: "2a12c9", fill: "ffffff").html_safe
+  rescue StandardError
+    "".html_safe
+  end
+
+  # A digest of everything that should trigger a live DOM swap. Kept
+  # deliberately free of CSRF tokens / timestamps so identical states
+  # compare equal on the client.
+  def moderator_signature(game)
+    question = game.current_question
+    counts = question ? game.answer_counts_by_option(question).sort.to_h : {}
+    Digest::SHA256.hexdigest([
+      game.id, game.status, game.current_position, game.total_questions,
+      game.players.count, question&.id, counts.to_json
+    ].join(":"))
+  end
+
+  def player_signature(game, player)
+    question = game.current_question
+    answer = nil
+    if player && question
+      answer = game.answers.find_by(player_id: player.id, question_id: question.id)
+    end
+    Digest::SHA256.hexdigest([
+      game.id, game.status, game.current_position, game.total_questions,
+      player&.id, player&.name, question&.id, answer&.option_id
+    ].join(":"))
+  end
+end
diff --git a/app/javascript/application.js b/app/javascript/application.js
index adc108b..301599f 100644
--- a/app/javascript/application.js
+++ b/app/javascript/application.js
@@ -32,3 +32,70 @@ document.addEventListener("click", function(event) {
   rowsContainer.appendChild(row);
   textInput.focus();
 });
+
+// Quizzy live updates: deliberately simple short polling instead of a
+// websocket, so that crowded conference Wi-Fi (dropped sockets, captive
+// portals, reconnect storms) cannot leave a screen stale. Every ~1s we
+// fetch an HTML fragment and swap it in only when its state signature
+// changed, so forms being typed in / buttons about to be tapped are
+// never disturbed by an identical re-render. No full page reload occurs.
+(function() {
+  var timer = null;
+  var inFlight = false;
+
+  function poll(container) {
+    if (inFlight || !document.body.contains(container)) return;
+    var url = container.getAttribute("data-live-url");
+    if (!url) return;
+    inFlight = true;
+    var controller = (typeof AbortController !== "undefined") ? new AbortController() : null;
+    var timeoutId = null;
+    if (controller) timeoutId = setTimeout(function() { controller.abort(); }, 4000);
+    fetch(url, {
+      headers: { "Accept": "text/html", "X-Requested-With": "XMLHttpRequest" },
+      cache: "no-store",
+      credentials: "same-origin",
+      signal: controller ? controller.signal : undefined
+    }).then(function(response) {
+      if (!response.ok) throw new Error("live poll failed");
+      return response.text();
+    }).then(function(html) {
+      if (!document.body.contains(container)) return;
+      var temp = document.createElement("div");
+      temp.innerHTML = html;
+      var fresh = temp.querySelector("[data-live-root]");
+      var current = container.querySelector("[data-live-root]");
+      if (!fresh || !current) return;
+      if (fresh.getAttribute("data-signature") === current.getAttribute("data-signature")) return;
+      // Don't yank a join form out from under someone typing their name
+      // unless the game is actually over (signature change caused by a
+      // state transition while anonymous still matters, but an in-progress
+      // keystroke wins; the next transition will be picked up, and a
+      // finished state is re-checked below).
+      var active = document.activeElement;
+      var typingName = active && active.id === "player_name" && container.contains(active) && active.value;
+      var freshText = fresh.textContent || "";
+      if (typingName && freshText.indexOf("The quiz is over") === -1) return;
+      current.replaceWith(fresh);
+    }).catch(function() {
+      // Transient network failure: the next tick retries.
+    }).finally(function() {
+      inFlight = false;
+      if (timeoutId) clearTimeout(timeoutId);
+    });
+  }
+
+  function start() {
+    var container = document.querySelector("[data-live-url]");
+    if (timer) { clearInterval(timer); timer = null; }
+    if (!container) return;
+    timer = setInterval(function() { poll(container); }, 1000);
+    // A first quick check catches changes that happened during page load.
+    setTimeout(function() { poll(container); }, 350);
+  }
+
+  document.addEventListener("DOMContentLoaded", start);
+  document.addEventListener("turbo:load", start);
+  // If the script was already loaded after DOMContentLoaded (Turbo), start now.
+  if (document.readyState !== "loading") start();
+})();
