diff --git a/app/views/moderate/games/_screen.html.erb b/app/views/moderate/games/_screen.html.erb
new file mode 100644
index 0000000..c7286e0
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,86 @@
+<% quiz = local_assigns[:quiz] || @quiz %>
+<% game = local_assigns[:game] || @game %>
+<% current_question = game.current_question %>
+<div data-live-root data-signature="<%= moderator_signature(game) %>">
+  <section class="cover cover--blue">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= quiz.title %></span>
+      </div>
+      <div class="screen__body">
+        <% if game.lobby? %>
+          <div class="lobby">
+            <div>
+              <h1 class="lobby__title"><%= quiz.title %></h1>
+              <div class="lobby__join">Join at</div>
+              <div class="lobby__url"><%= join_link_text(game, request) %></div>
+              <div class="counter-pill">Players: <%= game.players.count %></div>
+            </div>
+            <div class="qr" role="img" aria-label="QR code for the join link"><%= qr_code_svg(join_link_url(game, request)) %></div>
+          </div>
+        <% elsif game.finished? %>
+          <h1 class="lobby__title">The quiz is over</h1>
+          <p class="lobby__join"><%= quiz.title %></p>
+        <% elsif current_question %>
+          <div class="stage-question__num">Question <%= game.current_number %> of <%= game.total_questions %></div>
+          <div class="stage-question__body"><%= current_question.text %></div>
+          <% if game.closed? %>
+            <% counts = game.answer_counts_by_option(current_question) %>
+            <% total_answered = counts.values.sum %>
+            <ol class="stage-options stage-options--results">
+              <% current_question.options.each_with_index do |option, option_index| %>
+                <% count = counts[option.id] || 0 %>
+                <% share = total_answered.positive? ? (count * 100.0 / total_answered) : 0 %>
+                <li class="stage-option <%= "is-correct" if option.correct? %>">
+                  <span class="stage-option__bar" style="--share: <%= share %>%"></span>
+                  <span class="stage-option__letter"><%= option_letter(option_index) %></span>
+                  <span class="stage-option__title"><%= option.text %></span>
+                  <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+                  <span class="stage-option__count"><%= count %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% else %>
+            <ol class="stage-options">
+              <% current_question.options.each_with_index do |option, option_index| %>
+                <li class="stage-option">
+                  <span class="stage-option__letter"><%= option_letter(option_index) %></span>
+                  <span class="stage-option__title"><%= option.text %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        <% else %>
+          <h1 class="lobby__title"><%= quiz.title %></h1>
+        <% end %>
+      </div>
+    </div>
+  </section>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(quiz) %>
+      <% if game.open? && current_question %>
+        <span class="answers-counter">Answers: <%= game.answered_count(current_question) %> / <%= game.players.count %></span>
+      <% elsif game.closed? && current_question %>
+        <span class="answers-counter">Answers: <%= game.answered_count(current_question) %> / <%= game.players.count %></span>
+      <% elsif game.lobby? %>
+        <span>Players: <%= game.players.count %></span>
+      <% end %>
+    </div>
+    <div>
+      <% if game.lobby? %>
+        <%= button_to "Start", start_moderate_quiz_game_path(quiz, game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+      <% elsif game.open? %>
+        <%= button_to "Finish", finish_question_moderate_quiz_game_path(quiz, game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+      <% elsif game.closed? %>
+        <% if game.last_question? %>
+          <%= button_to "End quiz", advance_moderate_quiz_game_path(quiz, game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+        <% else %>
+          <%= button_to "Next", advance_moderate_quiz_game_path(quiz, game), method: :post, class: "btn btn--pink btn--lg", form: { data: { turbo: false } } %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</div>
