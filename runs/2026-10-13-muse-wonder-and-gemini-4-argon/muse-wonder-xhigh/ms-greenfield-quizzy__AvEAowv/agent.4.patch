diff --git a/app/javascript/application.js b/app/javascript/application.js
index 301599f..fe362d3 100644
--- a/app/javascript/application.js
+++ b/app/javascript/application.js
@@ -33,15 +33,23 @@ document.addEventListener("click", function(event) {
   textInput.focus();
 });
 
-// Quizzy live updates: deliberately simple short polling instead of a
-// websocket, so that crowded conference Wi-Fi (dropped sockets, captive
-// portals, reconnect storms) cannot leave a screen stale. Every ~1s we
-// fetch an HTML fragment and swap it in only when its state signature
-// changed, so forms being typed in / buttons about to be tapped are
-// never disturbed by an identical re-render. No full page reload occurs.
+// Quizzy live updates: all screens must follow the moderator close to
+// instantly (speed decides ties, so a question has to appear on every
+// phone at the same moment). We therefore push a change nudge over
+// ActionCable (Solid Cable in production, polling its database every
+// 0.1s) as soon as the moderator or a player changes the game, and the
+// receiving page immediately re-fetches its live fragment. As a safety
+// net for dropped sockets / conference Wi-Fi, the same fragment is also
+// polled every 250ms. Fragments are swapped in only when their state
+// signature changed, so forms being typed in / buttons about to be
+// tapped are never disturbed by an identical re-render, and no full
+// page reload occurs.
 (function() {
   var timer = null;
   var inFlight = false;
+  var cableSocket = null;
+  var cableGameId = null;
+  var cableRetryTimer = null;
 
   function poll(container) {
     if (inFlight || !document.body.contains(container)) return;
@@ -85,13 +93,60 @@ document.addEventListener("click", function(event) {
     });
   }
 
+  function connectCable(container) {
+    var gameId = container.getAttribute("data-live-game-id");
+    if (!gameId || typeof WebSocket === "undefined") return;
+    if (cableSocket && cableGameId === gameId) return;
+    if (cableSocket) {
+      try { cableSocket.close(); } catch (e) {}
+      cableSocket = null;
+    }
+    cableGameId = gameId;
+    try {
+      var protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
+      var socket = new WebSocket(protocol + "//" + window.location.host + "/cable");
+      cableSocket = socket;
+      socket.onopen = function() {
+        try {
+          socket.send(JSON.stringify({
+            command: "subscribe",
+            identifier: JSON.stringify({ channel: "GameChannel", game_id: gameId })
+          }));
+        } catch (e) {}
+      };
+      socket.onmessage = function(event) {
+        try {
+          var data = JSON.parse(event.data);
+          if (data && data.type === "ping") return;
+          if (data && (data.message || data.type === "confirm_subscription")) {
+            // A change nudge (or a fresh subscription): check right now,
+            // without waiting for the next polling tick.
+            poll(container);
+          }
+        } catch (e) {}
+      };
+      socket.onclose = function() {
+        if (cableSocket === socket) cableSocket = null;
+        if (!document.body.contains(container)) return;
+        if (cableRetryTimer) clearTimeout(cableRetryTimer);
+        cableRetryTimer = setTimeout(function() { connectCable(container); }, 1000);
+      };
+      socket.onerror = function() {
+        try { socket.close(); } catch (e) {}
+      };
+    } catch (e) {
+      // WebSocket unavailable: the 250ms polling below still applies.
+    }
+  }
+
   function start() {
     var container = document.querySelector("[data-live-url]");
     if (timer) { clearInterval(timer); timer = null; }
     if (!container) return;
-    timer = setInterval(function() { poll(container); }, 1000);
+    connectCable(container);
+    timer = setInterval(function() { poll(container); }, 250);
     // A first quick check catches changes that happened during page load.
-    setTimeout(function() { poll(container); }, 350);
+    setTimeout(function() { poll(container); }, 50);
   }
 
   document.addEventListener("DOMContentLoaded", start);
