@@ -0,0 +1,8 @@
+module ApplicationCable
+  class Connection < ActionCable::Connection::Base
+    # No per-user authentication: Quizzy players are anonymous and the
+    # moderator area is protected by HTTP Basic on the fragment endpoints.
+    # The cable only carries a "something changed" nudge for a game id;
+    # clients re-fetch their own authorised fragment afterwards.
+  end
+end
