diff --git a/app/javascript/application.js b/app/javascript/application.js
index fe362d3..8038b45 100644
--- a/app/javascript/application.js
+++ b/app/javascript/application.js
@@ -33,6 +33,76 @@ document.addEventListener("click", function(event) {
   textInput.focus();
 });
 
+
+// Quizzy per-question timer (moderator big screen only; the timer element
+// is never rendered for players). The deadline is stamped on the server
+// when the question opens (GameQuestion#opened_at + the quiz's timer), so
+// reloading the page re-renders the same deadline instead of restarting
+// the countdown. This loop only updates the visible M:SS text from that
+// deadline; at 0:00 it asks the server to finish the question (the
+// server's live/player polls also finish it lazily at the deadline, so
+// the question closes even if this POST races or fails).
+(function() {
+  function format(totalSeconds) {
+    var total = Math.max(0, Math.floor(totalSeconds));
+    var minutes = Math.floor(total / 60);
+    var seconds = total % 60;
+    return minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
+  }
+
+  function triggerFinish(el) {
+    if (el.getAttribute("data-timer-finish-triggered") === "1") return;
+    el.setAttribute("data-timer-finish-triggered", "1");
+    var url = el.getAttribute("data-timer-finish-url");
+    if (!url) return;
+    try {
+      var tokenEl = document.querySelector('meta[name="csrf-token"]');
+      var token = tokenEl ? tokenEl.getAttribute("content") : null;
+      var headers = { "X-Requested-With": "XMLHttpRequest" };
+      if (token) headers["X-CSRF-Token"] = token;
+      // Fire and forget: the moderator live poll will swap in the closed
+      // state (correct answers / counts / Next) once the server closes it.
+      fetch(url, {
+        method: "POST",
+        headers: headers,
+        credentials: "same-origin",
+        cache: "no-store",
+        redirect: "follow"
+      }).catch(function() {});
+    } catch (e) {}
+  }
+
+  function tick() {
+    var nodes = document.querySelectorAll("[data-timer]");
+    for (var i = 0; i < nodes.length; i++) {
+      var el = nodes[i];
+      var deadlineMs = parseInt(el.getAttribute("data-timer-deadline-ms"), 10);
+      if (isNaN(deadlineMs)) continue;
+      // Correct the server epoch deadline for any client clock skew using
+      // the server time rendered alongside it (computed once per element,
+      // so live DOM swaps get a fresh correction but ticks never drift).
+      if (!el._quizzyTimerDeadlineMs) {
+        var serverNowMs = parseInt(el.getAttribute("data-timer-server-now-ms"), 10);
+        var offsetMs = isNaN(serverNowMs) ? 0 : (serverNowMs - Date.now());
+        el._quizzyTimerDeadlineMs = deadlineMs - offsetMs;
+      }
+      var remainingMs = el._quizzyTimerDeadlineMs - Date.now();
+      if (remainingMs <= 0) {
+        if (el.textContent !== "0:00") el.textContent = "0:00";
+        triggerFinish(el);
+      } else {
+        var text = format(Math.ceil(remainingMs / 1000));
+        if (el.textContent !== text) el.textContent = text;
+      }
+    }
+  }
+
+  setInterval(tick, 200);
+  document.addEventListener("DOMContentLoaded", tick);
+  document.addEventListener("turbo:load", tick);
+  if (document.readyState !== "loading") tick();
+})();
+
 // Quizzy live updates: all screens must follow the moderator close to
 // instantly (speed decides ties, so a question has to appear on every
 // phone at the same moment). We therefore push a change nudge over
diff --git a/app/models/game.rb b/app/models/game.rb
index 753d87d..1561f9e 100644
--- a/app/models/game.rb
+++ b/app/models/game.rb
@@ -107,6 +107,78 @@ class Game < ApplicationRecord
     update!(status: "finished")
   end
 
+
+  # --- Per-question timer ----------------------------------------------------
+  #
+  # The timer is a quiz setting (Quiz#timer_total_seconds). It starts when a
+  # question opens: GameQuestion#opened_at is stamped by start!/advance! and
+  # never re-stamped on reload, so the deadline survives page reloads. The
+  # moderator big screen counts down to that deadline; at the deadline the
+  # question finishes exactly as if the moderator clicked "Finish".
+
+  def timer_total_seconds
+    return 0 if quiz.nil?
+    return quiz.timer_total_seconds if quiz.respond_to?(:timer_total_seconds)
+
+    minutes = quiz.respond_to?(:timer_minutes) ? quiz.timer_minutes.to_i : 0
+    seconds = quiz.respond_to?(:timer_seconds) ? quiz.timer_seconds.to_i : 0
+    total = (minutes * 60) + seconds
+    total.positive? ? total : 0
+  end
+
+  def timer_enabled?
+    timer_total_seconds.positive?
+  end
+
+  def timer_opened_at
+    gq = current_game_question
+    gq&.opened_at if gq&.respond_to?(:opened_at)
+  end
+
+  def timer_deadline
+    return nil unless timer_enabled?
+    return nil unless open?
+
+    opened = timer_opened_at
+    return nil if opened.nil?
+
+    opened + timer_total_seconds.seconds
+  end
+
+  # Epoch milliseconds for the client-side countdown (nil without a timer).
+  def timer_deadline_ms
+    deadline = timer_deadline
+    deadline ? (deadline.to_f * 1000).round : nil
+  end
+
+  # Whole seconds left to display, rounding up so a freshly opened 1:30
+  # question shows "1:30" (not "1:29") and the last second shows "0:01"
+  # until the deadline is actually reached.
+  def timer_remaining_seconds(now = Time.current)
+    deadline = timer_deadline
+    return nil if deadline.nil?
+
+    remaining = deadline - now
+    return 0 if remaining <= 0
+
+    remaining.ceil
+  end
+
+  def timer_expired?(now = Time.current)
+    deadline = timer_deadline
+    !deadline.nil? && now >= deadline
+  end
+
+  # Finish the open question if its timer has run out. Safe to call on
+  # every request/poll: it is a no-op unless the question is open and the
+  # deadline has passed. Returns true when it closed the question.
+  def finish_if_timer_expired!(now = Time.current)
+    return false unless timer_expired?(now)
+
+    finish_question!
+    closed?
+  end
+
   def answers_for(question)
     return Answer.none if question.nil?
 
