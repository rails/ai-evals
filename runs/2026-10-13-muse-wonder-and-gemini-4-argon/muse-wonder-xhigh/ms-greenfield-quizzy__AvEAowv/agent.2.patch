+<%= render "moderate/shared/header" %>
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head">
+    <div>
+      <h1>Import quiz</h1>
+    </div>
+  </div>
+  <div class="card">
+    <% if @import_errors.present? %>
+      <div class="errors">
+        <p>Import failed. Please fix the following errors:</p>
+        <ul>
+          <% @import_errors.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <%= form_with url: moderate_import_path, method: :post do |form| %>
+      <div class="field">
+        <%= form.label :quiz_json, "Quiz JSON" %>
+        <%= form.text_area :quiz_json, value: @quiz_json, class: "input", rows: 14 %>
+      </div>
+      <div class="buttons">
+        <%= form.submit "Import", class: "btn btn--pink" %>
+        <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
