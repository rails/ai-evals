diff --git a/docs/bots.md b/docs/bots.md
index f1671fc..d4a724a 100644
--- a/docs/bots.md
+++ b/docs/bots.md
@@ -173,3 +173,49 @@ settings (`/account/edit`) with the “Bots per member” number field
 - Lowering the limit never removes existing bots, and editing or
   deleting an existing bot is always allowed; it only blocks creating
   another one while the member is at or over the new limit.
+
+## Automatic suspension of misbehaving bots
+
+The limits below are fixed in code (`User::BotEnforcement`); there are no
+settings for them.
+
+### Flooding
+
+- A bot may post at most 10 messages in any 10 seconds. Messages posted
+  through the API and synchronous webhook replies both count, because both
+  are measured from the bot's actual messages.
+- The message that goes over the limit is rejected and starts a 30-second
+  cooldown (`bot_cooldown_until`). The posting endpoint then responds
+  `429 Too Many Requests` with a `Retry-After` header (seconds left), and
+  webhook replies are not posted during the cooldown.
+- Five more attempts to post during the same cooldown
+  (`bot_cooldown_attempts`) suspend the bot for flooding. The fifth attempt
+  is still a `429`; subsequent posting attempts get `403 Forbidden`.
+
+### Failing webhooks
+
+- A failed delivery is any response other than `2xx`, a timeout, or a
+  connection error. `BotWebhookJob` records each outcome on the bot
+  (`bot_consecutive_webhook_failures`): a successful delivery resets the
+  count to zero, and ten failed deliveries in a row suspend the bot for
+  repeated webhook failures. Both `mention` and `joined` deliveries count.
+
+### Suspended bots
+
+Suspension is stored on the bot (`bot_suspended_at` /
+`bot_suspension_reason`), not in the human `status`, so a suspended bot:
+
+- gets `403 Forbidden` from the posting endpoint and receives no webhooks
+  (neither enqueued nor delivered);
+- keeps its rooms and messages, and still counts towards its owner's
+  bots-per-member limit;
+- stays listed on `/bots`, showing “Suspended” with the reason (flooding
+  or repeated webhook failures).
+
+Only administrators can bring a bot back: the bots page shows a
+“Reactivate” button (with a confirmation) on suspended bots only to
+administrators (`BotsController#reactivate`). Reactivation is a clean
+slate: suspension, cooldown, in-cooldown attempts and the consecutive
+webhook failure count are cleared, and messages posted before
+reactivation no longer count towards the rate-limit window
+(`bot_rate_limit_reset_at`).
diff --git a/test/controllers/bots/suspension_test.rb b/test/controllers/bots/suspension_test.rb
new file mode 100644
index 0000000..59c6f3b
--- /dev/null
+++ b/test/controllers/bots/suspension_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Bots::SuspensionTest < ActionDispatch::IntegrationTest
+  setup do
+    @bot = users(:david).bots.create!(name: "Flood Bot")
+    @room = rooms(:pets)
+    @room.memberships.grant_to(@bot)
+  end
+
+  def post_bot(body = "hello")
+    post bot_room_messages_url(@room, @bot.bot_code), params: body, headers: { "CONTENT_TYPE" => "text/plain" }
+  end
+
+  test "flooding starts a cooldown, five more attempts in it suspend, and an administrator can reactivate" do
+    10.times do |i|
+      post_bot("msg #{i}")
+      assert_response :created
+    end
+
+    post_bot("too many")
+    assert_response :too_many_requests
+    assert response.headers["Retry-After"].to_i.between?(1, 30), response.headers["Retry-After"]
+    assert_equal 10, @room.messages.where(creator: @bot).count
+
+    4.times do
+      post_bot("cool")
+      assert_response :too_many_requests
+    end
+    assert_not @bot.reload.bot_suspended?
+
+    post_bot("cool5")
+    assert_response :too_many_requests
+    assert @bot.reload.bot_suspended?
+    assert_match(/Flood/i, @bot.bot_suspension_reason)
+
+    post_bot("after")
+    assert_response :forbidden
+    assert_equal 10, @room.messages.where(creator: @bot).count
+
+    sign_in :jz
+    post reactivate_bot_url(@bot)
+    assert_response :forbidden
+    assert @bot.reload.bot_suspended?
+
+    sign_in :david
+    get bots_url
+    assert_response :success
+    assert_match "Suspended", response.body
+    assert_match(/Flood/i, response.body)
+    assert_match "Reactivate", response.body
+
+    post reactivate_bot_url(@bot)
+    assert_redirected_to bots_url
+    assert_not @bot.reload.bot_suspended?
+
+    post_bot("back again")
+    assert_response :created
+  end
+
+  test "suspended bot stays listed, keeps its rooms and messages, and still counts towards the owner's limit" do
+    post_bot("kept")
+    assert_response :created
+    @bot.suspend_bot!("Flooding (message rate limit exceeded)")
+
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    jz_bot = users(:jz).bots.create!(name: "JZ Bot")
+    jz_bot.suspend_bot!("Flooding (message rate limit exceeded)")
+    assert users(:jz).bot_limit_reached?
+
+    sign_in :david
+    get bots_url
+    assert_response :success
+    assert_select "li", text: /Flood Bot/
+    assert_select "li", text: /Suspended/
+    assert_select "li", text: /Flooding/
+
+    assert_includes @bot.reload.rooms, @room
+    assert_equal 1, @room.messages.where(creator: @bot).count
+  end
+
+  test "non-administrator owner sees Suspended but no Reactivate button" do
+    bot = users(:jz).bots.create!(name: "JZ Bot")
+    bot.suspend_bot!("Repeated webhook failures (10 consecutive failed deliveries)")
+
+    sign_in :jz
+    get bots_url
+    assert_response :success
+    assert_match "Suspended", response.body
+    assert_match "Repeated webhook failures", response.body
+    assert_no_match "Reactivate", response.body
+
+    post reactivate_bot_url(bot)
+    assert_response :forbidden
+    assert bot.reload.bot_suspended?
+  end
+
+  test "cooldown expires after 30 seconds" do
+    10.times { |i| post_bot("msg #{i}") }
+    post_bot("too many")
+    assert_response :too_many_requests
+
+    travel 31.seconds do
+      post_bot("after cooldown")
+      assert_response :created
+    end
+  end
+
+  test "window slides after 10 seconds" do
+    10.times { |i| post_bot("msg #{i}") }
+
+    travel 11.seconds do
+      post_bot("after window")
+      assert_response :created
+    end
+  end
+end
