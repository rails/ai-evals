diff --git a/test/jobs/bot_webhook_job_test.rb b/test/jobs/bot_webhook_job_test.rb
new file mode 100644
index 0000000..2d7f713
--- /dev/null
+++ b/test/jobs/bot_webhook_job_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class BotWebhookJobTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:pets)
+    @author = users(:jason)
+    @bot = users(:david).bots.create!(name: "Deploy Bot", webhook_url: "https://example.com/hook")
+    @captured_request = nil
+  end
+
+  test "mentioning a bot enqueues, then delivers, the webhook without posting synchronously" do
+    stub_webhook(to_return: { status: 204 })
+
+    message = nil
+    assert_enqueued_jobs 1, only: BotWebhookJob do
+      message = create_message_mentioning(@bot, "restart the build please")
+    end
+    assert_not_requested :post, "https://example.com/hook"
+
+    perform_enqueued_jobs(only: BotWebhookJob)
+
+    assert_requested :post, "https://example.com/hook"
+    payload = JSON.parse(@captured_request.body)
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => @author.id, "name" => "Jason" }, payload["author"])
+    assert_equal @room.id, payload.dig("room", "id")
+    assert_equal @room.name, payload.dig("room", "name")
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", payload.dig("room", "reply_to")
+    assert_equal message.id, payload.dig("message", "id")
+    assert_equal "restart the build please", payload.dig("message", "body", "text")
+    assert_includes payload.dig("message", "body", "html"), "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload.dig("message", "link")
+    assert_equal "application/json", @captured_request.headers["Content-Type"]
+  end
+
+  test "a 200 text reply is posted into the room as the bot" do
+    stub_webhook(to_return: {
+      status: 200, body: "Restarting the build!",
+      headers: { "Content-Type" => "text/plain" }
+    })
+
+    create_message_mentioning(@bot, "restart the build please")
+    perform_enqueued_jobs(only: BotWebhookJob)
+
+    reply = @room.messages.where(creator: @bot).last
+    assert reply
+    assert_equal "Restarting the build!", reply.plain_text_body
+  end
+
+  test "a 200 HTML reply is posted into the room as the bot" do
+    stub_webhook(to_return: {
+      status: 200, body: "<div>Build <strong>restarted</strong></div>",
+      headers: { "Content-Type" => "text/html" }
+    })
+
+    create_message_mentioning(@bot, "restart the build please")
+    perform_enqueued_jobs(only: BotWebhookJob)
+
+    reply = @room.messages.where(creator: @bot).last
+    assert reply
+    assert_equal "Build restarted", reply.plain_text_body
+    assert_includes reply.body.body.to_html, "<strong>restarted</strong>"
+  end
+
+  test "a 204 reply posts nothing" do
+    stub_webhook(to_return: { status: 204 })
+
+    create_message_mentioning(@bot, "restart the build please")
+
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      perform_enqueued_jobs(only: BotWebhookJob)
+    end
+  end
+
+  test "a failing webhook posts nothing and does not raise" do
+    stub_webhook(to_return: { status: 500, body: "oops", headers: { "Content-Type" => "text/plain" } })
+
+    create_message_mentioning(@bot, "restart the build please")
+
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      perform_enqueued_jobs(only: BotWebhookJob)
+    end
+  end
+
+  test "an unreachable webhook does not raise" do
+    WebMock.stub_request(:post, "https://example.com/hook").to_raise(Errno::ECONNREFUSED)
+
+    create_message_mentioning(@bot, "restart the build please")
+
+    assert_no_difference -> { @room.messages.where(creator: @bot).count } do
+      perform_enqueued_jobs(only: BotWebhookJob)
+    end
+  end
+
+  test "only the mentioned bot's own mention is stripped from the text" do
+    stub_webhook(to_return: { status: 204 })
+
+    message = Message.create!(
+      room: @room, creator: @author,
+      body: "<div>Hey #{mention_attachment_for(users(:david))}, ask #{mention_attachment_for(@bot)} to restart please</div>"
+    )
+    perform_enqueued_jobs(only: BotWebhookJob)
+
+    payload = JSON.parse(@captured_request.body)
+    assert_equal message.id, payload.dig("message", "id")
+    assert_equal "Hey @David, ask to restart please", payload.dig("message", "body", "text")
+  end
+
+  test "messages mentioning a bot without a webhook enqueue no webhook job" do
+    bot_without_webhook = users(:david).bots.create!(name: "Quiet Bot")
+
+    assert_no_enqueued_jobs(only: BotWebhookJob) do
+      create_message_mentioning(bot_without_webhook, "hello")
+    end
+  end
+
+  test "messages mentioning only people enqueue no webhook job" do
+    assert_no_enqueued_jobs(only: BotWebhookJob) do
+      Message.create!(room: @room, creator: @author, body: "<div>Hey #{mention_attachment_for(:david)}</div>")
+    end
+  end
+
+  test "each mentioned bot with a webhook gets its own delivery" do
+    other_bot = users(:david).bots.create!(name: "Other Bot", webhook_url: "https://example.com/other-hook")
+    stub_webhook(to_return: { status: 204 })
+    WebMock.stub_request(:post, "https://example.com/other-hook").to_return(status: 204)
+
+    Message.create!(
+      room: @room, creator: @author,
+      body: "<div>#{mention_attachment_for(@bot)} #{mention_attachment_for(other_bot)} go</div>"
+    )
+    perform_enqueued_jobs(only: BotWebhookJob)
+
+    assert_requested :post, "https://example.com/hook"
+    assert_requested :post, "https://example.com/other-hook"
+  end
+
+  private
+    def stub_webhook(to_return:)
+      WebMock.stub_request(:post, "https://example.com/hook").to_return do |request|
+        @captured_request = request
+        to_return
+      end
+    end
+
+    def create_message_mentioning(bot, text)
+      Message.create!(
+        room: @room, creator: @author,
+        body: "<div>#{mention_attachment_for(bot)} #{text}</div>"
+      )
+    end
+end
