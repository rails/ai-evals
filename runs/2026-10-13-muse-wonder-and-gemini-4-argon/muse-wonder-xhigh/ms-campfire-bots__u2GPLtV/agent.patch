diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..c02dd5d
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,13 @@
+# A bot is a special kind of user; this subclass exists as a convenient way
+# to find and create bots. The table is shared with User (a bot is a user
+# with `bot: true`), so this is deliberately not single-table inheritance:
+# every other part of the app should keep treating bots as users.
+class Bot < User
+  self.inheritance_column = :_type_disabled
+
+  default_scope { where(bot: true) }
+
+  alias_attribute :token, :bot_code
+
+  before_create { self.bot = true }
+end
