diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..ea5d2a3
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,44 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+
+    scope :published, -> { joins(:publication) }
+    scope :unpublished, -> { where.missing(:publication) }
+  end
+
+  def publish
+    if published?
+      publication
+    else
+      create_publication!
+    end
+  end
+
+  def unpublish
+    if published?
+      publication.destroy!
+      touch
+    end
+  end
+
+  def published?
+    publication.present? && !publication.destroyed?
+  end
+
+  def public?
+    published?
+  end
+
+  def public_key
+    publication.key if published?
+  end
+  alias_method :publication_key, :public_key
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_path(publication, script_name: account.slug)
+    end
+  end
+end
