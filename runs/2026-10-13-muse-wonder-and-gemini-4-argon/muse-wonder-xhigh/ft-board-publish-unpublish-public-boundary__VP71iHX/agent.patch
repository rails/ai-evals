new file mode 100644
index 0000000..dc4fb17
--- /dev/null
+++ b/app/views/public/boards/show.html.erb
@@ -0,0 +1,69 @@
+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="public-board">
+  <h1><%= @board.name %></h1>
+
+  <% if @board.cards.awaiting_triage.any? %>
+    <section class="public-board__column">
+      <h2>Maybe?</h2>
+
+      <ul class="public-board__cards">
+        <% @board.cards.awaiting_triage.latest.each do |card| %>
+          <li>
+            <%= link_to card.title, public_board_card_path(@publication, card) %>
+          </li>
+        <% end %>
+      </ul>
+    </section>
+  <% end %>
+
+  <% @columns.each do |column| %>
+    <section class="public-board__column" id="<%= dom_id(column) %>">
+      <h2>
+        <%= link_to column.name, public_board_column_path(@publication, column) %>
+      </h2>
+
+      <ul class="public-board__cards">
+        <% column.cards.active.latest.each do |card| %>
+          <li>
+            <%= link_to card.title, public_board_card_path(@publication, card) %>
+          </li>
+        <% end %>
+      </ul>
+    </section>
+  <% end %>
+
+  <% if @board.cards.published.postponed.any? %>
+    <section class="public-board__column">
+      <h2>Not now</h2>
+
+      <ul class="public-board__cards">
+        <% @board.cards.published.postponed.latest.each do |card| %>
+          <li>
+            <%= link_to card.title, public_board_card_path(@publication, card) %>
+          </li>
+        <% end %>
+      </ul>
+    </section>
+  <% end %>
+
+  <% if @board.cards.published.closed.any? %>
+    <section class="public-board__column">
+      <h2>Closed</h2>
+
+      <ul class="public-board__cards">
+        <% @board.cards.published.closed.each do |card| %>
+          <li>
+            <%= link_to card.title, public_board_card_path(@publication, card) %>
+          </li>
+        <% end %>
+      </ul>
+    </section>
+  <% end %>
+</section>
