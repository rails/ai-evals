@@ -0,0 +1,20 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_public_board
+  end
+
+  private
+    def set_public_board
+      @publication = find_publication
+      @board = @publication.board
+      Current.account ||= @board.account
+    end
+
+    def find_publication
+      key = params[:board_key] || params[:key]
+      publications = Current.account ? Board::Publication.where(account_id: Current.account.id) : Board::Publication.all
+      publications.find_by!(key: key)
+    end
+end
