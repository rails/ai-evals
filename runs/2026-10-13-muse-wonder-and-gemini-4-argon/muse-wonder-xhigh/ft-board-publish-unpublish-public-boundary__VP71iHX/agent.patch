diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..5737095
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,64 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@publication) %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="public-card">
+  <p>
+    <%= link_to @board.name, public_board_path(@publication) %>
+    <% if @card.column %>
+      &rsaquo;
+      <%= link_to @card.column.name, public_board_column_path(@publication, @card.column) %>
+    <% end %>
+  </p>
+
+  <h1><%= @card.title %></h1>
+
+  <% unless @card.description.blank? %>
+    <div class="card__description lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <p>
+    Added by <%= @card.creator.name %>
+    on <%= @card.created_at.to_date %>
+  </p>
+
+  <% if @card.tags.any? %>
+    <p>
+      Tags:
+      <%= @card.tags.map(&:title).join(", ") %>
+    </p>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ol class="steps">
+      <% @card.steps.each do |step| %>
+        <li><%= step.content %></li>
+      <% end %>
+    </ol>
+  <% end %>
+
+  <% if @card.comments.any? %>
+    <section class="public-card__comments">
+      <h2>Comments</h2>
+
+      <% @card.comments.chronologically.each do |comment| %>
+        <article class="comment">
+          <p><strong><%= comment.creator.name %></strong></p>
+          <div class="lexxy-content">
+            <%= comment.body %>
+          </div>
+        </article>
+      <% end %>
+    </section>
+  <% end %>
+</article>
