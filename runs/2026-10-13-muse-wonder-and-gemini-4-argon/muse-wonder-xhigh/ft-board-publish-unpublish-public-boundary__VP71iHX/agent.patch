+class Public::Boards::CardsController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  include PublicBoardScoped
+
+  layout "public"
+
+  before_action :set_card
+
+  def show
+  end
+
+  private
+    def set_card
+      @card = find_published_card
+    end
+
+    def find_published_card
+      cards = @board.cards.published
+
+      if params[:id].to_s.match?(/\A\d+\z/)
+        cards.find_by!(number: params[:id])
+      else
+        cards.find_by!(id: params[:id])
+      end
+    end
+end
