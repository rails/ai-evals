@@ -0,0 +1,7 @@
+namespace :profile_images do
+  desc "Copy legacy (CarrierWave) user/organization profile pictures into Active Storage. " \
+       "Safe to re-run: records already in Active Storage are skipped."
+  task copy: :environment do
+    ProfileImages::Copy.call(out: $stdout)
+  end
+end
