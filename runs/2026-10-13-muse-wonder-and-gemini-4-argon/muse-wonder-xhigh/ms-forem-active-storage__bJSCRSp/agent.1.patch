diff --git a/app/uploaders/legacy_profile_image_uploader.rb b/app/uploaders/legacy_profile_image_uploader.rb
new file mode 100644
index 0000000..064c129
--- /dev/null
+++ b/app/uploaders/legacy_profile_image_uploader.rb
@@ -0,0 +1,12 @@
+# CarrierWave uploader used only to read profile pictures that were
+# uploaded before the Active Storage migration.
+#
+# It is mounted as +legacy_profile_image+ (backed by the existing
+# +profile_image+ column), but the files were originally stored under
+# +profile_image+, so the store directory must keep the original name or
+# every pre-migration URL would point at a directory that does not exist.
+class LegacyProfileImageUploader < ProfileImageUploader
+  def store_dir
+    "uploads/#{model.class.to_s.underscore}/profile_image/#{model.id}"
+  end
+end
