+class AddTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    # Sweep every pre-existing user and book into a single tenant so that
+    # existing installs upgrade in place and keep working as one tenant.
+    existing_records = select_value("SELECT COUNT(*) FROM users").to_i +
+      select_value("SELECT COUNT(*) FROM books").to_i
+
+    if existing_records.positive?
+      now = Time.current.to_fs(:db)
+      tenant_id = connection.insert(
+        "INSERT INTO tenants (name, created_at, updated_at) " \
+        "VALUES (#{connection.quote('Default')}, #{connection.quote(now)}, #{connection.quote(now)})"
+      )
+
+      execute "UPDATE users SET tenant_id = #{tenant_id.to_i} WHERE tenant_id IS NULL"
+      execute "UPDATE books SET tenant_id = #{tenant_id.to_i} WHERE tenant_id IS NULL"
+    end
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+end
