diff --git a/lib/rails_ext/active_storage_storage_tracking.rb b/lib/rails_ext/active_storage_storage_tracking.rb
new file mode 100644
index 0000000..9949ade
--- /dev/null
+++ b/lib/rails_ext/active_storage_storage_tracking.rb
@@ -0,0 +1,114 @@
+# Keeps Account#bytes_used and Board#bytes_used up to date when counted
+# attachments change.
+#
+# Only attachments that the storage calculation counts schedule work:
+# card images and files embedded in board descriptions, card
+# descriptions, and comments. Avatars, exports, imports, and other
+# attachments are ignored. Where an attachment belongs is captured
+# before it is destroyed, as the record it was attached to may already
+# have been destroyed by the time the attachment itself is purged.
+module ActiveStorageStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit { recalculate_storage_usage_later }
+    before_update :capture_storage_usage_targets_before_update, if: :storage_usage_target_may_change?
+    after_update_commit(if: :storage_usage_target_changed?) { recalculate_storage_usage_later }
+    before_destroy :capture_storage_usage_targets
+    after_destroy_commit { recalculate_storage_usage_later }
+  end
+
+  # Active Storage removes attachments with #delete in some places
+  # (notably purging and detaching a file through an attachment proxy),
+  # bypassing destroy callbacks entirely. Schedule from here as well so
+  # those removals are counted too.
+  def delete
+    capture_storage_usage_targets
+    super.tap { recalculate_storage_usage_later }
+  end
+
+  def recalculate_storage_usage_later
+    @storage_usage_target_changed = false
+    capture_storage_usage_targets
+    targets = @storage_usage_targets || []
+    @storage_usage_targets = nil
+
+    targets.each do |board_id, account_id|
+      Board.find_by(id: board_id)&.recalculate_bytes_used_later if board_id
+      Account.find_by(id: account_id)&.recalculate_bytes_used_later if account_id
+    end
+  end
+
+  private
+    def storage_usage_target_may_change?
+      will_save_change_to_blob_id? || will_save_change_to_record_id? || will_save_change_to_record_type? || will_save_change_to_name?
+    end
+
+    def capture_storage_usage_targets_before_update
+      @storage_usage_target_changed = true
+      capture_storage_usage_targets
+    end
+
+    def storage_usage_target_changed?
+      !!@storage_usage_target_changed
+    end
+
+    def capture_storage_usage_targets
+      if target = storage_usage_target
+        @storage_usage_targets = (@storage_usage_targets || []) | [ target ]
+      end
+    end
+
+    # Returns the [ board_id, account_id ] whose storage this attachment
+    # counts towards, or nil when the attachment is not counted at all.
+    def storage_usage_target
+      case record_type
+      when "Card"
+        if name == "image"
+          card = Card.find_by(id: record_id)
+          [ card&.board_id, account_id || card&.account_id ]
+        end
+      when "ActionText::RichText"
+        if name == "embeds"
+          storage_usage_target_for_rich_text
+        end
+      end
+    end
+
+    def storage_usage_target_for_rich_text
+      rich_text = ActionText::RichText.find_by(id: record_id)
+
+      if rich_text
+        case rich_text.record_type
+        when "Board"
+          if rich_text.name == "public_description"
+            board = Board.find_by(id: rich_text.record_id)
+            [ board&.id, account_id || board&.account_id ]
+          end
+        when "Card"
+          if rich_text.name == "description"
+            card = Card.find_by(id: rich_text.record_id)
+            [ card&.board_id, account_id || card&.account_id ]
+          end
+        when "Comment"
+          if rich_text.name == "body"
+            comment = Comment.find_by(id: rich_text.record_id)
+            card = Card.find_by(id: comment.card_id) if comment
+            [ card&.board_id, account_id || comment&.account_id || card&.account_id ]
+          end
+        end
+      end
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageStorageTracking
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  before_update { @storage_byte_size_changed = will_save_change_to_byte_size? }
+  after_update_commit(if: -> { @storage_byte_size_changed }) do
+    @storage_byte_size_changed = false
+    attachments.find_each(&:recalculate_storage_usage_later)
+  end
+end
diff --git a/test/models/storage_trackable_test.rb b/test/models/storage_trackable_test.rb
new file mode 100644
index 0000000..6933c45
--- /dev/null
+++ b/test/models/storage_trackable_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class StorageTrackableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "bytes_used is zero without counted attachments" do
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts card images and rich text embeds on cards, boards, and comments" do
+    @card.image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+    attach_embed_to @card, 50
+    attach_embed_to @board, 70
+    comment = @card.comments.create!(body: "A comment")
+    attach_embed_to comment, 30
+
+    perform_enqueued_jobs
+
+    assert_equal 250, @board.reload.bytes_used
+    assert_equal 250, @account.reload.bytes_used
+  end
+
+  test "does not count avatars or card images on other boards" do
+    users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg"
+    other_card = cards(:radio)
+    other_card.image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+    assert_equal 100, boards(:miltons_wish_list).reload.bytes_used
+    assert_equal 100, accounts("initech").reload.bytes_used
+  end
+
+  test "account usage is the sum of its boards" do
+    @card.image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+    cards(:shipping).image.attach io: StringIO.new("x" * 50), filename: "image.png", content_type: "image/png"
+    boards(:private).cards.create!(title: "Private card", creator: users(:david)).tap do |card|
+      card.image.attach io: StringIO.new("x" * 30), filename: "image.png", content_type: "image/png"
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal 150, @board.reload.bytes_used
+    assert_equal 30, boards(:private).reload.bytes_used
+    assert_equal 180, @account.reload.bytes_used
+  end
+
+  test "updates when attachments are removed and rich text is edited" do
+    @card.image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+    attach_embed_to @card, 50
+    comment = @card.comments.create!(body: "A comment")
+    attach_embed_to comment, 30
+
+    perform_enqueued_jobs
+    assert_equal 180, @board.reload.bytes_used
+
+    @card.image.purge
+    perform_enqueued_jobs
+    assert_equal 80, @board.reload.bytes_used
+    assert_equal 80, @account.reload.bytes_used
+
+    comment.update!(body: "No more file")
+    perform_enqueued_jobs
+    assert_equal 50, @board.reload.bytes_used
+
+    @card.update!(description: "No more file")
+    perform_enqueued_jobs
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "updates when attachments are replaced or detached" do
+    @card.image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+    perform_enqueued_jobs
+    assert_equal 100, @board.reload.bytes_used
+
+    @card.image.attach io: StringIO.new("y" * 40), filename: "other.png", content_type: "image/png"
+    perform_enqueued_jobs
+    assert_equal 40, @board.reload.bytes_used
+
+    @card.image.detach
+    perform_enqueued_jobs
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates when comments and cards are destroyed and cards move boards" do
+    attach_embed_to @card, 50
+    comment = @card.comments.create!(body: "A comment")
+    attach_embed_to comment, 30
+
+    perform_enqueued_jobs
+    assert_equal 80, @board.reload.bytes_used
+
+    comment.destroy!
+    perform_enqueued_jobs only: CalculateBytesUsedJob
+    assert_equal 50, @board.reload.bytes_used
+
+    @card.move_to boards(:private)
+    perform_enqueued_jobs only: CalculateBytesUsedJob
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 50, boards(:private).reload.bytes_used
+    assert_equal 50, @account.reload.bytes_used
+
+    @card.destroy!
+    perform_enqueued_jobs only: CalculateBytesUsedJob
+    assert_equal 0, boards(:private).reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "updates when a board is destroyed" do
+    attach_embed_to @board, 70
+    @card.image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+
+    perform_enqueued_jobs
+    assert_equal 170, @account.reload.bytes_used
+
+    @board.destroy!
+    perform_enqueued_jobs only: CalculateBytesUsedJob
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "updates when a blob's byte size changes" do
+    @card.image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+    perform_enqueued_jobs
+    assert_equal 100, @board.reload.bytes_used
+
+    @card.image.blob.update!(byte_size: 123)
+    perform_enqueued_jobs
+    assert_equal 123, @board.reload.bytes_used
+    assert_equal 123, @account.reload.bytes_used
+  end
+
+  test "coalesces many attachment changes into one calculation per board and account" do
+    clear_enqueued_jobs
+
+    @card.image.attach io: StringIO.new("x" * 10), filename: "image.png", content_type: "image/png"
+    5.times { attach_embed_to @card, 10 }
+
+    assert_equal 2, enqueued_jobs.count { |job| job[:job] == CalculateBytesUsedJob }
+
+    perform_enqueued_jobs
+    assert_equal 60, @board.reload.bytes_used
+    assert_equal 60, @account.reload.bytes_used
+  end
+
+  private
+    def attach_embed_to(record, byte_size)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * byte_size),
+        filename: "embed.txt",
+        content_type: "text/plain"
+      )
+      html = ActionText::Attachment.from_attachable(blob).to_html
+
+      case record
+      when Board
+        record.update!(public_description: "#{record.public_description} #{html}")
+      when Card
+        record.update!(description: "#{record.description} #{html}")
+      when Comment
+        record.update!(body: "#{record.body} #{html}")
+      end
+    end
+end
