diff --git a/app/models/concerns/storage_trackable.rb b/app/models/concerns/storage_trackable.rb
new file mode 100644
index 0000000..da1261e
--- /dev/null
+++ b/app/models/concerns/storage_trackable.rb
@@ -0,0 +1,77 @@
+module StorageTrackable
+  extend ActiveSupport::Concern
+
+  # Returns the most recently calculated storage usage, in bytes.
+  #
+  # The value stored in +bytes_used+ is maintained by
+  # CalculateBytesUsedJob (see #recalculate_bytes_used_later), so this
+  # reader never has to scan attachments itself. It therefore stays a
+  # cheap attribute read no matter how many attachments an account or
+  # board has, and callers can invoke it freely.
+  def bytes_used
+    super.to_i
+  end
+
+  # Schedules a background recalculation, coalescing concurrent requests.
+  #
+  # Many users can add or remove attachments at the same time. The
+  # +bytes_used_recalculation_scheduled+ flag is claimed with a single
+  # atomic update, so only the first request enqueues a job; the job
+  # that eventually runs calculates from the state at that time and so
+  # covers every change that arrived while it was pending.
+  def recalculate_bytes_used_later
+    if persisted? && !destroyed?
+      if self.class.where(id: id, bytes_used_recalculation_scheduled: false).update_all(bytes_used_recalculation_scheduled: true) == 1
+        CalculateBytesUsedJob.perform_later(self)
+      end
+    end
+  end
+
+  def recalculate_bytes_used_now
+    with_lock do
+      # Clear the flag before calculating. A change that arrives while
+      # the calculation is running will then be able to schedule a
+      # follow-up job instead of being lost, while a change that
+      # arrived before this point is already visible to the
+      # calculation below.
+      update_columns(bytes_used_recalculation_scheduled: false)
+      update_columns(bytes_used: calculate_bytes_used)
+    end
+  end
+
+  # Calculates the current usage directly from the counted attachments.
+  #
+  # This is deliberately a single set-based aggregate: the database
+  # sums +byte_size+ over matching attachments without loading any
+  # attachment or blob records into memory, so its cost in Ruby is the
+  # same for an account with ten attachments as for one with a million.
+  def calculate_bytes_used
+    counted_storage_attachments.sum("active_storage_blobs.byte_size").to_i
+  end
+
+  private
+    def counted_storage_attachments
+      board_ids = storage_board_ids
+      card_ids = Card.where(board_id: board_ids).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Board", name: "public_description", record_id: board_ids)
+        .or(ActionText::RichText.where(record_type: "Card", name: "description", record_id: card_ids))
+        .or(ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comment_ids))
+        .select(:id)
+
+      ActiveStorage::Attachment
+        .where(record_type: "Card", name: "image", record_id: card_ids)
+        .or(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids))
+        .joins(:blob)
+    end
+
+    def storage_board_ids
+      if is_a?(Board)
+        Board.where(id: id).select(:id)
+      else
+        boards.select(:id)
+      end
+    end
+end
