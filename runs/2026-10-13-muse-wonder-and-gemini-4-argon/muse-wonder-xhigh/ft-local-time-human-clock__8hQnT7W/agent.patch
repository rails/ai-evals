diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..b7cfab3 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,43 @@
 module TimeHelper
+  # Renders a <time> element that carries only the raw timestamp. The
+  # local-time Stimulus controller fills in the text in the browser, in the
+  # viewer's own timezone, so the HTML itself can be cached and shared
+  # between viewers in different timezones.
+  #
+  # Formats:
+  #   relative:     "1:42 PM" today, "yesterday"/"tomorrow", "5 days ago"/
+  #                 "in 3 days" within a week, "Sep 12" further out
+  #   time:         "1:42 PM"
+  #   date:         "Sep 12" ("Sep 12, 2024" in a different year)
+  #   date_with_year: "Sep 12, 2025"
+  #   full_date:    "Monday, September 12"
+  #   datetime:     "Sep 12, 1:42 PM"
+  def local_time_tag(time, format = nil, **options)
+    return if time.blank?
+
+    format ||= options.delete(:format) || :relative
+    data = options.delete(:data).to_h
+
+    tag.time "",
+      datetime: local_time_datetime(time),
+      data: { controller: "local-time", local_time_format_value: format.to_s.tr("_", "-") }.merge(data),
+      **options
+  end
+  alias_method :local_time, :local_time_tag
+
+  def relative_time_tag(time, **options)
+    local_time_tag(time, format: :relative, **options)
+  end
+
+  private
+    def local_time_datetime(time)
+      case time
+      when Time, DateTime
+        time.to_time.utc.iso8601
+      when Date
+        time.iso8601
+      else
+        time.to_s
+      end
+    end
 end
