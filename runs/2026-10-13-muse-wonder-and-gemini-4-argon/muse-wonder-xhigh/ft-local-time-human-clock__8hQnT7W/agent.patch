diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..930e9bb
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalDateTime, formatLocalTimeByFormat, parseLocalTime } from "helpers/date_helpers"
+
+// Renders the raw timestamp in the element's `datetime` attribute as text, in
+// the viewer's own timezone. The server sends no formatted time at all, so
+// the same HTML can be cached and shared between viewers anywhere.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.#render()
+  }
+
+  #render() {
+    const date = parseLocalTime(this.element.getAttribute("datetime") ?? "")
+    if (Number.isNaN(date.getTime())) return
+
+    this.element.textContent = formatLocalTimeByFormat(date, this.formatValue)
+
+    if (!this.element.title) {
+      this.element.title = formatLocalDateTime(date)
+    }
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..4892851 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -9,6 +9,101 @@ export function beginningOfDay(date) {
   return new Date(Date.UTC(year, month - 1, day))
 }
 
+// Local (browser timezone) formatting ----------------------------------------
+//
+// Everything below renders a timestamp in the viewer's own timezone, using
+// the browser's locale machinery. The server only sends the raw timestamp.
+
+export function parseLocalTime(value) {
+  if (value instanceof Date) return value
+
+  // A date-only string would be parsed as UTC midnight by `new Date`, which
+  // is the previous local day for much of the world. Treat it as a local date.
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+  if (dateOnly) return new Date(+dateOnly[1], +dateOnly[2] - 1, +dateOnly[3])
+
+  return new Date(value)
+}
+
+export function formatLocalTime(date) {
+  return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+export function formatLocalDate(date, referenceDate = new Date()) {
+  const options = { month: "short", day: "numeric" }
+  if (date.getFullYear() !== referenceDate.getFullYear()) options.year = "numeric"
+
+  return new Intl.DateTimeFormat("en-US", options).format(date)
+}
+
+export function formatLocalDateWithYear(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(date)
+}
+
+export function formatLocalFullDate(date) {
+  return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+export function formatLocalDateTime(date, referenceDate = new Date()) {
+  return `${formatLocalDate(date, referenceDate)}, ${formatLocalTime(date)}`
+}
+
+// "1:42 PM" today, "yesterday"/"tomorrow" for the neighbouring calendar
+// days, "5 days ago"/"in 3 days" within a week, and "Sep 12" further out --
+// always by calendar day in the viewer's timezone, not by elapsed hours, so
+// something from last night reads "yesterday" rather than "11 hours ago".
+export function formatRelativeTime(date, referenceDate = new Date()) {
+  const dayDifference = localDayDifference(date, referenceDate)
+
+  if (dayDifference === 0) {
+    return formatLocalTime(date)
+  } else if (dayDifference > -7 && dayDifference < 7) {
+    return new Intl.RelativeTimeFormat("en-US", { numeric: "auto" }).format(dayDifference, "day")
+  } else {
+    return formatLocalDate(date, referenceDate)
+  }
+}
+
+export function formatLocalTimeByFormat(date, format, referenceDate = new Date()) {
+  switch (format?.replaceAll("_", "-")) {
+    case "time":
+      return formatLocalTime(date)
+    case "date":
+      return formatLocalDate(date, referenceDate)
+    case "date-with-year":
+    case "full-date-with-year":
+      return formatLocalDateWithYear(date)
+    case "full-date":
+      return formatLocalFullDate(date)
+    case "datetime":
+    case "date-time":
+      return formatLocalDateTime(date, referenceDate)
+    case "full-datetime":
+      return `${formatLocalFullDate(date)}, ${formatLocalTime(date)}`
+    default:
+      return formatRelativeTime(date, referenceDate)
+  }
+}
+
+// Whole calendar days from referenceDate to date, in the browser's timezone.
+export function localDayDifference(date, referenceDate = new Date()) {
+  return Math.round((beginningOfLocalDay(date) - beginningOfLocalDay(referenceDate)) / (1000 * 60 * 60 * 24))
+}
+
+function beginningOfLocalDay(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+// Aliases with shorter names
+export const formatTime = formatLocalTime
+export const formatDate = formatLocalDate
+export const formatDateWithYear = formatLocalDateWithYear
+export const formatFullDate = formatLocalFullDate
+export const formatDateTime = formatLocalDateTime
+export const formatRelativeDate = formatRelativeTime
+export const formatRelativeDateTime = formatRelativeTime
+export const formatTimeAgo = formatRelativeTime
+
 // Snap a timestamp to midnight using the timezone the server rendered with (the
 // `timezone` meta tag), so client day boundaries match the server's instead of
 // following the browser's resolved timezone, which can differ in a PWA.
