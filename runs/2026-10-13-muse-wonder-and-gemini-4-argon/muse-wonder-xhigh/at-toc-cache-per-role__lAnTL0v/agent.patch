diff --git a/test/controllers/books_toc_caching_test.rb b/test/controllers/books_toc_caching_test.rb
new file mode 100644
index 0000000..4fe2b6d
--- /dev/null
+++ b/test/controllers/books_toc_caching_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class BooksTocCachingTest < ActionDispatch::IntegrationTest
+  test "reader does not receive editor controls cached by an editor" do
+    with_fragment_caching do
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Edit Welcome to The Handbook!"
+
+      sign_out
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_not_in_body "Edit Welcome to The Handbook!"
+      assert_in_body "Open Welcome to The Handbook!"
+    end
+  end
+
+  test "editor receives editor controls even when a reader cached the table of contents first" do
+    with_fragment_caching do
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_not_in_body "Edit Welcome to The Handbook!"
+
+      sign_out
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Edit Welcome to The Handbook!"
+    end
+  end
+
+  test "renamed entry shows its new title to the next reader" do
+    with_fragment_caching do
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Welcome to The Handbook!"
+
+      leaves(:welcome_page).update!(title: "Renamed Welcome Page")
+
+      sign_out
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Renamed Welcome Page"
+      assert_not_in_body "Welcome to The Handbook!"
+    end
+  end
+
+  private
+    def with_fragment_caching
+      cache = ActiveSupport::Cache::MemoryStore.new
+      original_cache = Rails.cache
+      original_perform_caching = ActionController::Base.perform_caching
+      original_cache_store = ActionController::Base.cache_store
+      original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+      Rails.cache = cache
+      ActionController::Base.perform_caching = true
+      ActionController::Base.cache_store = cache
+      ActionView::PartialRenderer.collection_cache = cache
+
+      yield
+    ensure
+      Rails.cache = original_cache
+      ActionController::Base.perform_caching = original_perform_caching
+      ActionController::Base.cache_store = original_cache_store
+      ActionView::PartialRenderer.collection_cache = original_collection_cache
+    end
+end
