diff --git a/test/controllers/leafables_being_edited_test.rb b/test/controllers/leafables_being_edited_test.rb
new file mode 100644
index 0000000..8895805
--- /dev/null
+++ b/test/controllers/leafables_being_edited_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+require "turbo/broadcastable/test_helper"
+
+class LeafablesBeingEditedTest < ActionDispatch::IntegrationTest
+  include Turbo::Broadcastable::TestHelper
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+    @leaf = leaves(:welcome_page)
+    @book = books(:handbook)
+  end
+
+  test "update does not broadcast being-edited presence on the shared leaf stream" do
+    @book.access_for(user: users(:jason)).destroy!
+
+    perform_update
+    payloads = capture_turbo_stream_broadcasts([ @leaf, :being_edited ])
+
+    assert_empty payloads
+  end
+
+  test "update does not broadcast being-edited presence to a removed collaborator" do
+    sign_out
+    sign_in :david
+    removed = users(:kevin)
+    @book.access_for(user: removed).destroy!
+
+    perform_update
+    payloads = capture_turbo_stream_broadcasts([ removed, @leaf, :being_edited ])
+
+    assert_empty payloads
+  end
+
+  test "update does not broadcast being-edited presence to a collaborator downgraded to reader" do
+    sign_out
+    sign_in :david
+    downgraded = users(:kevin)
+    @book.access_for(user: downgraded).update!(level: :reader)
+
+    perform_update
+    payloads = capture_turbo_stream_broadcasts([ downgraded, @leaf, :being_edited ])
+
+    assert_empty payloads
+  end
+
+  test "update broadcasts being-edited presence to a remaining editor on their own stream" do
+    @book.access_for(user: users(:jason)).destroy!
+
+    perform_update
+    payloads = capture_turbo_stream_broadcasts([ users(:david), @leaf, :being_edited ])
+
+    assert_equal 1, payloads.count
+    assert_includes payloads.first.to_html, users(:kevin).name
+  end
+
+  test "edit page subscribes the current user to their own being-edited stream" do
+    get edit_leafable_path(@leaf)
+
+    assert_response :success
+    signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ users(:kevin), @leaf, :being_edited ])
+    assert_in_body signed_stream_name
+  end
+
+  private
+    def perform_update
+      perform_enqueued_jobs do
+        put leafable_path(@leaf), params: { leaf: { title: "Better welcome" }, page: { body: "With even more interesting words." } }
+      end
+      assert_response :no_content
+    end
+end
