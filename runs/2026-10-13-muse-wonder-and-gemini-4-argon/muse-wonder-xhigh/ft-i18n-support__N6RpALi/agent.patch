diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..0a68bb5
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  teardown do
+    I18n.locale = I18n.default_locale
+  end
+
+  test "switching to Japanese via locale param sticks in session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_includes response.body, "Fizzyにサインイン"
+      assert_includes response.body, 'lang="ja"'
+
+      get new_session_path
+      assert_response :success
+      assert_includes response.body, "Fizzyにサインイン"
+    end
+  end
+
+  test "unknown locale does not switch or break the page" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_includes response.body, "Get into Fizzy"
+    end
+  end
+
+  test "Japanese choice is remembered for the identity on a clean browser sign in" do
+    identity = identities(:david)
+
+    sign_in_as identity
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_includes response.body, "メインコンテンツへスキップ"
+    assert_equal "ja", identity.reload.locale
+
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+
+    sign_in_as identity
+    get root_path
+    assert_response :success
+    assert_includes response.body, "最新のアクティビティ"
+
+    get root_path(locale: "en")
+    assert_includes response.body, "Latest Activity"
+    assert_equal "en", identity.reload.locale
+  end
+
+  test "mail is sent in the recipient's Japanese locale" do
+    identity = identities(:david)
+    identity.update!(locale: "ja")
+    magic_link = identity.magic_links.create!(code: "ABC123", expires_at: 15.minutes.from_now, purpose: "sign_in")
+
+    mail = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "FizzyのコードはABC123です", mail.subject
+    body = mail.text_part ? mail.text_part.body.to_s : mail.body.to_s
+    assert_includes body, "Fizzyのサインインページで"
+    assert_equal :en, I18n.locale
+  end
+
+  test "mail defaults to English when recipient has not chosen a locale" do
+    identity = identities(:david)
+    magic_link = identity.magic_links.create!(code: "ABC123", expires_at: 15.minutes.from_now, purpose: "sign_in")
+
+    mail = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is ABC123", mail.subject
+  end
+end
