diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..415a261
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,58 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  AVAILABLE_LOCALES = %w[en ja].freeze
+
+  included do
+    around_action :set_locale
+    helper_method :current_locale
+  end
+
+  private
+    def current_locale
+      I18n.locale.to_s
+    end
+
+    def set_locale(&block)
+      locale = resolve_locale
+      persist_locale_preference(locale) if locale_preference_explicit?(locale)
+      I18n.with_locale(locale, &block)
+    end
+
+    def resolve_locale
+      requested = params[:locale].to_s if params[:locale].present?
+      if requested && AVAILABLE_LOCALES.include?(requested)
+        session[:locale] = requested
+        requested
+      elsif session[:locale].present? && AVAILABLE_LOCALES.include?(session[:locale].to_s)
+        session[:locale].to_s
+      elsif identity_locale.present?
+        session[:locale] = identity_locale
+        identity_locale
+      else
+        I18n.default_locale.to_s
+      end
+    end
+
+    def identity_locale
+      locale = Current.identity&.locale if Current.identity && Current.identity.respond_to?(:locale)
+      locale.presence_in(AVAILABLE_LOCALES)
+    rescue => _e
+      nil
+    end
+
+    def locale_preference_explicit?(locale)
+      params[:locale].to_s == locale.to_s || session[:locale].to_s == locale.to_s
+    end
+
+    def persist_locale_preference(locale)
+      identity = Current.identity if defined?(Current) && Current.identity
+      return unless identity && identity.respond_to?(:locale)
+      return if identity.locale == locale.to_s
+
+      identity.update_column(:locale, locale.to_s)
+    rescue => _e
+      # Locale persistence must never break a request (e.g. read-only, stale object)
+      nil
+    end
+end
