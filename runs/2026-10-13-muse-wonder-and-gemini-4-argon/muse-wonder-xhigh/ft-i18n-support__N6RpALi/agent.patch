+require "application_system_test_case"
+class LocaleProbeSystemTest < ApplicationSystemTestCase
+  test "ja board with js dates" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook), locale: "ja")
+    assert_selector "h1", text: "Writebook"
+    # card meta daysago should be Japanese via JS (fixtures 1 week ago)
+    puts page.text[0,2000]
+    assert_text "日前"
+  end
+  test "ja create card flow" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook), locale: "ja")
+    click_on "カードを追加"
+    fill_in "card_title", with: "こんにちは"
+    click_on "カードを作成"
+    assert_selector "h3", text: "こんにちは"
+  end
+end
