diff --git a/app/javascript/helpers/locale_helpers.js b/app/javascript/helpers/locale_helpers.js
new file mode 100644
index 0000000..0aa72a7
--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,62 @@
+export function currentLocale() {
+  const lang = document.documentElement?.lang || "en"
+  return lang.startsWith("ja") ? "ja-JP" : "en-US"
+}
+
+export function isJapanese() {
+  return currentLocale().startsWith("ja")
+}
+
+const STRINGS = {
+  "en-US": {
+    lessThanMinuteAgo: "Less than a minute ago",
+    today: "today",
+    yesterday: "yesterday",
+    tomorrow: "tomorrow",
+    day: "day",
+    days: "days",
+    stalledFor: "Stalled for",
+    backTo: (label) => `Back to ${label}`,
+    areYouSure: "Are you sure?",
+    pleaseFillOut: "Please fill out this field",
+    noSelection: "No selection",
+  },
+  "ja-JP": {
+    lessThanMinuteAgo: "1分未満前",
+    today: "今日",
+    yesterday: "昨日",
+    tomorrow: "明日",
+    day: "日",
+    days: "日",
+    stalledFor: "停滞期間",
+    backTo: (label) => `${label}に戻る`,
+    areYouSure: "本当によろしいですか？",
+    pleaseFillOut: "このフィールドに入力してください",
+    noSelection: "選択なし",
+  }
+}
+
+export function localizedString(key, ...args) {
+  const value = STRINGS[currentLocale()][key] ?? STRINGS["en-US"][key]
+  return typeof value === "function" ? value(...args) : value
+}
+
+export function agoString(unit, quantity) {
+  quantity = Math.floor(quantity)
+  if (isJapanese()) {
+    const units = { year: "年前", month: "か月前", week: "週間前", day: "日前", hour: "時間前", minute: "分前" }
+    return `${quantity}${units[unit]}`
+  }
+  const suffix = quantity === 1 ? "" : "s"
+  return `${quantity} ${unit}${suffix} ago`
+}
+
+export function daysAgoString(days) {
+  if (isJapanese()) return `${days}日前`
+  return `${days} days ago`
+}
+
+export function inDaysString(days) {
+  if (isJapanese()) return `あと${days}日`
+  return `in ${days} days`
+}
