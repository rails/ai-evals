@@ -22,6 +22,26 @@ class SessionsController < ApplicationController
   end
 
   private
+    # Only allow redirects back to this application: relative paths and
+    # absolute http(s) URLs on this host (which is how deep links generated
+    # by Authentication#request_authentication arrive). Anything else --
+    # external hosts, protocol-relative URLs to other hosts, non-http(s)
+    # schemes such as javascript:/ftp: (even on this host), backslash or
+    # control-character tricks, and non-String values -- is ignored, so
+    # sign-in falls back to the default post-authenticating URL instead
+    # of sending the user off-site or raising.
+    def safe_return_to_url
+      return unless params[:return_to].is_a?(String)
+
+      url = url_from(params[:return_to])
+      return unless url
+
+      scheme = URI(url).scheme
+      url if scheme.nil? || scheme.downcase.in?(%w[ http https ])
+    rescue ArgumentError, URI::Error
+      nil
+    end
+
     def ensure_user_exists
       redirect_to first_run_url if User.none?
     end
