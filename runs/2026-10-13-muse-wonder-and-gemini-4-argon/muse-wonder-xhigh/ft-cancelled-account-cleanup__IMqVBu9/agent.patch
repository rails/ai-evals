diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..236a85a
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "does not incinerate accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerating removes associated data but keeps other accounts and identities" do
+    other_account = accounts(:initech)
+    identity_ids = @account.users.where.not(identity_id: nil).pluck(:identity_id)
+    board_ids = @account.board_ids
+    card_ids = @account.card_ids
+
+    Current.set(account: @account, user: @user) do
+      Storage::Entry.create!(account: @account, board: @account.boards.first, recordable: @account.cards.first, delta: 100, operation: "attach")
+      Storage::Total.create!(owner: @account, bytes_stored: 100)
+      Search::Query.create!(user: @user, terms: "logo")
+      cards(:logo).image.attach(io: StringIO.new("hello image"), filename: "test.txt", content_type: "text/plain")
+    end
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert_equal 0, User.where(account_id: @account.id).count
+    assert_equal 0, Board.where(account_id: @account.id).count
+    assert_equal 0, Card.where(account_id: @account.id).count
+    assert_equal 0, Comment.where(account_id: @account.id).count
+    assert_equal 0, Event.where(account_id: @account.id).count
+    assert_equal 0, Access.where(account_id: @account.id).count
+    assert_equal 0, Storage::Entry.where(account_id: @account.id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: @account.id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: board_ids).count
+    assert_equal 0, Search::Query.where(account_id: @account.id).count
+    assert_equal 0, Search::Record.where(account_id: @account.id).count
+    assert_equal 0, ActionText::RichText.where(account_id: @account.id).count
+    assert_equal 0, ActiveStorage::Attachment.where(account_id: @account.id).count
+    assert_equal 0, ActiveStorage::Blob.where(account_id: @account.id).count
+    assert_equal 0, ActiveStorage::VariantRecord.where(account_id: @account.id).count
+    assert_equal 0, Account::Cancellation.where(account_id: @account.id).count
+assert_equal 0, Filter.where(account_id: @account.id).count
+assert_equal 0, Export.where(account_id: @account.id).count
+assert_equal 0, Tag.where(account_id: @account.id).count
+assert_equal 0, Notification.where(account_id: @account.id).count
+assert_equal 0, Mention.where(account_id: @account.id).count
+assert_equal 0, Webhook.where(account_id: @account.id).count
+assert_equal 0, Entropy.where(account_id: @account.id).count
+assert_equal 0, Account::JoinCode.where(account_id: @account.id).count
+
+    assert Account.exists?(other_account.id)
+    assert Board.where(account_id: other_account.id).exists?
+    assert Card.where(account_id: other_account.id).exists?
+    identity_ids.each do |identity_id|
+      assert Identity.exists?(identity_id), "global identities should be kept"
+    end
+    assert card_ids.any?
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..754f05c
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration only includes accounts cancelled more than 30 days ago" do
+    recent = accounts(:initech)
+    recent.cancel(initiated_by: users(:mike))
+    recent.cancellation.update!(created_at: 29.days.ago)
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+    assert_not_includes Account.due_for_incineration, recent
+    assert_not_includes Account.due_for_incineration, accounts(:acme)
+  end
+
+  test "incinerate removes the account and its associated data" do
+    @account.cancel(initiated_by: @user)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_equal 0, Board.where(account_id: @account.id).count
+    assert_equal 0, Card.where(account_id: @account.id).count
+    assert_equal 0, User.where(account_id: @account.id).count
+    assert Identity.exists?(@user.identity_id)
+  end
+
+  test "incinerate purges attached files" do
+    card = cards(:logo)
+    Current.set(account: @account, user: @user) do
+      card.image.attach(io: StringIO.new("hello image"), filename: "test.txt", content_type: "text/plain")
+    end
+    blob = card.image.blob
+    assert blob.service.exist?(blob.key)
+
+    @account.incinerate
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+end
