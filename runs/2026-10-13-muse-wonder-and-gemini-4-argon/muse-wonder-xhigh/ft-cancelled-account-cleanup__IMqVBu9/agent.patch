diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..62c67c6 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,118 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    board_ids = boards.ids
+
+    purge_attached_files
+    remove_search_records
+    destroy!
+    remove_remaining_account_data(board_ids)
+  end
+  alias_method :incinerate!, :incinerate
+
+  private
+    # Purging (rather than purge_later) removes attachment and blob rows
+    # synchronously, along with the stored files and variant records.
+    # Doing this while the account still exists also means the storage
+    # ledger detach callbacks that run when tracked attachments are
+    # destroyed can still record their entries; those entries are swept
+    # up below once the account itself is gone.
+    def purge_attached_files
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:purge)
+      purge_remaining_blobs
+    end
+
+    def purge_remaining_blobs
+      ActiveStorage::Blob.where(account_id: id).find_each do |blob|
+        if blob.attachments.none?
+          blob.purge
+        end
+      end
+    end
+
+    def remove_search_records
+      Search::Record.for(id).where(account_id: id).destroy_all
+    end
+
+    def remove_remaining_account_data(board_ids)
+      remove_search_records
+
+      # Attachments are deleted directly here rather than purged: the
+      # account is already gone, so the storage ledger callbacks that run
+      # when tracked attachments are destroyed must not run again. Their
+      # blobs are purged once they no longer have any attachments.
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      purge_remaining_blobs
+
+      account_scoped_models.each do |model|
+        model.where(account_id: id).delete_all
+      end
+
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      if board_ids.any?
+        Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+      end
+    end
+
+    # Models that carry an account_id but are not guaranteed to be removed
+    # by the dependent: :destroy chain rooted at Account. Incineration
+    # sweeps these up explicitly so that no tenant data is left behind,
+    # including records whose owning record was already destroyed through
+    # another path (e.g. assignments kept via the assigner, board events,
+    # or storage ledger entries, which intentionally have no dependent
+    # cleanup).
+    def account_scoped_models
+      [
+        Access,
+        Account::Cancellation,
+        Account::Import,
+        Account::JoinCode,
+        ActionText::RichText,
+        ActiveStorage::VariantRecord,
+        Assignment,
+        Board,
+        Board::Publication,
+        Card,
+        Card::ActivitySpike,
+        Card::Goldness,
+        Card::NotNow,
+        Closure,
+        Column,
+        Comment,
+        Entropy,
+        Event,
+        Export,
+        Filter,
+        Mention,
+        Notification,
+        Notification::Bundle,
+        Pin,
+        Push::Subscription,
+        Reaction,
+        Search::Query,
+        Step,
+        Storage::Entry,
+        Tag,
+        Tagging,
+        User,
+        User::Settings,
+        Watch,
+        Webhook,
+        Webhook::DelinquencyTracker,
+        Webhook::Delivery
+      ]
+    end
 end
