diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..2c5982a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,270 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.removeAttribute("draggable")
+  }
+
+  dragStart(event) {
+    const item = event.currentTarget
+
+    this.draggedItem = item
+    this.sourceContainer = item.closest('[data-drag-and-drop-target="container"]')
+
+    item.classList.add(this.#draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+
+      try {
+        event.dataTransfer.setData("text/plain", item.id)
+      } catch {
+        // Some synthetic drag events use a read-only data transfer.
+      }
+    }
+  }
+
+  dragEnd(event) {
+    event.currentTarget.classList.remove(this.#draggedItemClass)
+    this.#clearHoverContainers()
+
+    if (this.draggedItem === event.currentTarget) {
+      this.draggedItem = null
+      this.sourceContainer = null
+    }
+  }
+
+  dragEnter(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+    this.#highlightContainer(event.currentTarget)
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlightContainer(event.currentTarget)
+  }
+
+  dragLeave(event) {
+    const container = event.currentTarget
+
+    if (!container.contains(event.relatedTarget)) {
+      container.classList.remove(this.#hoverContainerClass)
+    }
+  }
+
+  async drop(event) {
+    event.preventDefault()
+
+    const container = event.currentTarget
+    const item = this.draggedItem || this.#itemFromDataTransfer(event)
+
+    this.#clearHoverContainers()
+
+    if (!item) return
+
+    item.classList.remove(this.#draggedItemClass)
+
+    const sourceContainer = this.sourceContainer || item.closest('[data-drag-and-drop-target="container"]')
+
+    this.draggedItem = null
+    this.sourceContainer = null
+
+    if (!container || container === sourceContainer) return
+
+    const originalParent = item.parentNode
+    const originalNextSibling = item.nextElementSibling
+    const originalContent = { html: item.innerHTML, className: item.className, style: item.getAttribute("style") }
+
+    // Move the card right away so the board reflects the drop without
+    // waiting for the server. Columns order their own cards, so a drop
+    // only chooses the destination; it does not pick a position within it.
+    this.#moveItemToContainer(item, container)
+    this.#refreshItemForContainer(item, container)
+
+    const response = await this.#saveDrop(item, container)
+
+    if (!response || !response.ok) {
+      this.#restoreItem(item, originalParent, originalNextSibling, sourceContainer, originalContent)
+    }
+  }
+
+  // Private
+
+  async #saveDrop(item, container) {
+    try {
+      switch (container.dataset.dragAndDropDropKind) {
+        case "column":
+          return await post(item.dataset.dragAndDropTriageUrl, {
+            body: { column_id: container.dataset.dragAndDropColumnId },
+            responseKind: "json"
+          })
+        case "maybe":
+          return await destroy(item.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+        case "not_now":
+          return await post(item.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+        case "closed":
+          return await post(item.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+      }
+    } catch {
+      return { ok: false }
+    }
+  }
+
+  #moveItemToContainer(item, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (!list) {
+      (container.querySelector(".cards__transition-container") || container).append(item)
+      return
+    }
+
+    const firstCard = this.#firstCardFor(item, container, list)
+
+    if (firstCard && firstCard !== item) {
+      firstCard.before(item)
+      return
+    }
+
+    const blankSlate = list.querySelector(".blank-slate")
+
+    if (blankSlate) {
+      blankSlate.before(item)
+      return
+    }
+
+    const paginationLink = list.querySelector(".pagination-link")
+
+    if (paginationLink) {
+      paginationLink.before(item)
+    } else {
+      list.append(item)
+    }
+  }
+
+  // Columns list golden cards first, then the most recently active cards.
+  // A card that has just moved is the most recently active of its kind, so
+  // it belongs ahead of the other cards like it -- and nowhere else. That
+  // way the position it lands in on drop is the position the column's own
+  // ordering will keep it in when the save is reflected back.
+  #firstCardFor(item, container, list) {
+    const cards = [ ...list.querySelectorAll(".card") ].filter(card => card !== item)
+
+    if (!cards.length) return null
+
+    const ordersGoldenFirst = [ "column", "maybe" ].includes(container.dataset.dragAndDropDropKind)
+
+    if (!ordersGoldenFirst || item.classList.contains("golden-effect")) {
+      return cards[0]
+    }
+
+    return cards.find(card => !card.classList.contains("golden-effect")) || null
+  }
+
+  // The save's broadcast will re-render the card, but the card should
+  // already look like it belongs where it was dropped: its column label
+  // and colour come from the new column, and a stamp from its previous
+  // status no longer applies.
+  #refreshItemForContainer(item, container) {
+    const kind = container.dataset.dragAndDropDropKind
+    const columnName = container.dataset.columnName
+    const header = item.querySelector(".card__header")
+    let columnLabel = header?.querySelector(".card__column-name--current")
+
+    if (kind === "column") {
+      if (!columnLabel && header) {
+        columnLabel = document.createElement("span")
+        columnLabel.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        columnLabel.innerHTML = '<span class="overflow-ellipsis"></span>'
+        header.append(columnLabel)
+      }
+
+      if (columnLabel) {
+        (columnLabel.querySelector("span") || columnLabel).textContent = columnName
+      }
+
+      const color = container.style.getPropertyValue("--card-color")
+      if (color) item.style.setProperty("--card-color", color)
+    } else {
+      columnLabel?.remove()
+
+      if (kind === "maybe" || kind === "not_now") {
+        item.style.setProperty("--card-color", "var(--color-card-default)")
+      }
+    }
+
+    if (kind !== "closed") {
+      item.querySelectorAll(".card__stages .card__column-name").forEach(label => {
+        label.classList.toggle("card__column-name--current", kind === "column" && label.textContent.trim() === columnName)
+      })
+    }
+
+    item.classList.toggle("card--active", kind === "column" || kind === "maybe")
+    item.classList.toggle("card--postponed", kind === "not_now")
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+  }
+
+  #restoreItem(item, originalParent, originalNextSibling, sourceContainer, originalContent) {
+    if (originalContent) {
+      item.innerHTML = originalContent.html
+      item.className = originalContent.className
+      if (originalContent.style) { item.setAttribute("style", originalContent.style) } else { item.removeAttribute("style") }
+    }
+
+
+    if (originalNextSibling?.parentNode === originalParent) {
+      originalParent.insertBefore(item, originalNextSibling)
+    } else if (originalParent?.isConnected) {
+      originalParent.append(item)
+    } else if (sourceContainer) {
+      this.#moveItemToContainer(item, sourceContainer)
+    }
+  }
+
+  #itemFromDataTransfer(event) {
+    try {
+      const id = event.dataTransfer?.getData("text/plain")
+      const item = id && document.getElementById(id)
+
+      return item?.matches('[data-drag-and-drop-target="item"]') ? item : null
+    } catch {
+      return null
+    }
+  }
+
+  #highlightContainer(container) {
+    this.containerTargets.forEach(target => {
+      target.classList.toggle(this.#hoverContainerClass, target === container)
+    })
+  }
+
+  #clearHoverContainers() {
+    this.containerTargets.forEach(target => {
+      target.classList.remove(this.#hoverContainerClass)
+    })
+  }
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+}
