diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..a215470
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,168 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActiveJob::TestHelper
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card to another column moves it instantly and persists" do
+    card = cards(:logo)
+    target_column = columns(:writebook_in_progress)
+    visit board_url(@board)
+
+    assert drag_card_to(card, "##{dom_id(target_column)}"), "card should move as soon as it is dropped, before the save completes"
+    assert_eventually("card to be triaged into the target column") { card.reload.column == target_column }
+    assert_stays_in(card, "##{dom_id(target_column)}")
+  end
+
+  test "a dragged card stays put when the board refresh is broadcast" do
+    card = cards(:logo)
+    target_column = columns(:writebook_in_progress)
+    visit board_url(@board)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+    assert drag_card_to(card, "##{dom_id(target_column)}")
+    assert_eventually("card to be triaged into the target column") { card.reload.column == target_column }
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_stays_in(card, "##{dom_id(target_column)}")
+  end
+
+
+  test "dragging a card to Done closes it" do
+    card = cards(:logo)
+    visit board_url(@board)
+
+    assert drag_card_to(card, "#closed-cards")
+    assert_eventually("card to be closed") { card.reload.closed? }
+    assert_stays_in(card, "#closed-cards")
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    card = cards(:logo)
+    visit board_url(@board)
+
+    assert drag_card_to(card, "#not-now")
+    assert_eventually("card to be postponed") { card.reload.postponed? }
+    assert_stays_in(card, "#not-now")
+  end
+
+  test "dragging a card back to Maybe sends it back to triage" do
+    card = cards(:logo)
+    visit board_url(@board)
+
+    assert drag_card_to(card, "#maybe")
+    assert_eventually("card to be awaiting triage") { card.reload.awaiting_triage? }
+    assert_stays_in(card, "#maybe")
+  end
+
+  test "dragging a card out of Maybe into a column triages it" do
+    card = cards(:buy_domain)
+    target_column = columns(:writebook_in_progress)
+    visit board_url(@board)
+
+    assert drag_card_to(card, "##{dom_id(target_column)}")
+    assert_eventually("card to be triaged into the target column") { card.reload.column == target_column }
+    assert_stays_in(card, "##{dom_id(target_column)}")
+  end
+
+  test "dragging a closed card into a column reopens and triages it" do
+    card = cards(:shipping)
+    target_column = columns(:writebook_in_progress)
+    visit board_url(@board)
+
+    assert drag_card_to(card, "##{dom_id(target_column)}")
+    assert_eventually("card to be reopened and triaged") { card.reload.open? && card.column == target_column }
+    assert_stays_in(card, "##{dom_id(target_column)}")
+  end
+
+  test "dragging a card within its own column does not move or save it" do
+    card = cards(:logo)
+    original_column = card.column
+    visit board_url(@board)
+
+    assert drag_card_to(card, "##{dom_id(original_column)}")
+    assert_equal original_column, card.reload.column
+    assert_stays_in(card, "##{dom_id(original_column)}")
+  end
+
+  test "a card returns to where it was when the save fails" do
+    card = cards(:logo)
+    original_column = card.column
+    target_column = columns(:writebook_in_progress)
+    visit board_url(@board)
+
+    source = find("##{dom_id(card, :article)}", visible: :all)
+    page.execute_script("arguments[0].dataset.dragAndDropTriageUrl = '/missing'", source)
+
+    assert drag_card_to(card, "##{dom_id(target_column)}")
+
+    assert_eventually("card to return to its original column in the browser") do
+      page.evaluate_script("document.querySelector('##{dom_id(original_column)}').contains(document.querySelector('##{dom_id(card, :article)}'))")
+    end
+    assert_equal original_column, card.reload.column
+  end
+
+  test "dragging highlights the column under the pointer and dims the card" do
+    card = cards(:logo)
+    target_column = columns(:writebook_in_progress)
+    visit board_url(@board)
+
+    source = find("##{dom_id(card, :article)}", visible: :all)
+    target = find("##{dom_id(target_column)}", visible: :all)
+
+    page.execute_script(<<~JS, source, target)
+      const dataTransfer = new DataTransfer()
+      const options = { bubbles: true, cancelable: true, dataTransfer }
+      arguments[0].dispatchEvent(new DragEvent("dragstart", options))
+      arguments[1].dispatchEvent(new DragEvent("dragenter", options))
+    JS
+
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(target_column)}.drag-and-drop__hover-container", visible: :all
+
+    page.execute_script(<<~JS, source)
+      arguments[0].dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }))
+    JS
+
+    assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+  end
+
+  private
+    # Dispatches the HTML5 drag events and returns whether the card was
+    # already inside the target in the same instant the drop happened,
+    # before the asynchronous save could have completed.
+    def drag_card_to(card, target_selector)
+      source = find("##{dom_id(card, :article)}", visible: :all)
+      target = find(target_selector, visible: :all)
+
+      page.execute_script(<<~JS, source, target)
+        const dataTransfer = new DataTransfer()
+        const options = { bubbles: true, cancelable: true, dataTransfer }
+        arguments[0].dispatchEvent(new DragEvent("dragstart", options))
+        arguments[1].dispatchEvent(new DragEvent("dragenter", options))
+        arguments[1].dispatchEvent(new DragEvent("dragover", options))
+        arguments[1].dispatchEvent(new DragEvent("drop", options))
+        return arguments[1].contains(arguments[0])
+      JS
+    end
+
+    def assert_stays_in(card, target_selector)
+      within(target_selector, visible: :all) do
+        assert_selector "##{dom_id(card, :article)}", visible: :all
+      end
+      assert_selector "##{dom_id(card, :article)}", count: 1, visible: :all
+    end
+
+    def assert_eventually(message)
+      deadline = 5.seconds.from_now
+      sleep 0.05 until yield || Time.current > deadline
+      assert yield, "expected #{message}"
+    end
+end
