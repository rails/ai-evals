@@ -30,4 +30,64 @@ class SessionsController < ApplicationController
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
     end
+
+    # Only allow +return_to+ values that are unambiguously internal:
+    # either a local path ("/books/1") or an absolute http(s) URL on
+    # this application's own host (as generated by
+    # Authentication#request_authentication, which passes +request.url+).
+    # Anything else -- external hosts, protocol-relative URLs,
+    # backslash/whitespace/control-character tricks, percent-encoded
+    # host separators, non-http(s) schemes, embedded credentials, or
+    # non-String values -- is ignored, so sign-in falls back to
+    # +post_authenticating_url+ instead of redirecting off-site or
+    # raising an error.
+    def safe_return_to_url
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.present?
+      return if return_to.match?(/[\x00-\x20\x7f\\]/)
+
+      uri = URI.parse(return_to)
+
+      if uri.scheme.present?
+        return unless return_to.match?(%r{\Ahttps?://}i)
+        return unless %w[ http https ].include?(uri.scheme.downcase)
+        return if uri.userinfo.present?
+        return unless uri.host.present? && uri.host.casecmp(request.host.to_s).zero?
+      elsif uri.host.present? || return_to.start_with?("//")
+        # Protocol-relative URLs (//host/...) are never generated by
+        # the app, so don't trust them even for our own host.
+        return
+      else
+        return unless return_to.start_with?("/")
+      end
+
+      return unless safe_return_to_path?(uri.path)
+
+      return_to
+    rescue URI::Error, ArgumentError
+      nil
+    end
+
+    def safe_return_to_path?(path)
+      return true if path.blank?
+      return false unless path.start_with?("/")
+      return false if path.start_with?("//")
+
+      decoded = path
+      5.times do
+        unescaped = URI::DEFAULT_PARSER.unescape(decoded)
+        break if unescaped == decoded
+
+        decoded = unescaped
+        # Reject paths that only reveal a second host separator
+        # (//, /\, a tab/newline, ...) after percent-decoding, e.g.
+        # "/%2fevil.example", "/%5cevil.example" or "/%252fevil.example".
+        return false if decoded.start_with?("//", "/\\")
+        return false if decoded.match?(%r{\A/[\x00-\x20\x7f\\]})
+      end
+
+      true
+    rescue URI::Error, ArgumentError
+      false
+    end
 end
