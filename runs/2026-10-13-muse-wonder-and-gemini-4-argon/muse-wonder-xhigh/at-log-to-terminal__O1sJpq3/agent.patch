+# Show the report on the terminal as well as in the environment log file.
+# Use a dedicated broadcast logger for the report itself, rather than
+# broadcasting all of Rails.logger, so that unrelated log lines (such as
+# SQL queries) are not also sent to the terminal. Any destination that
+# Rails.logger already writes to is not added again, so each report line
+# is written exactly once to each destination. New destinations inherit
+# Rails.logger's formatter and level, so filtering by severity (for
+# example via LOG_LEVEL) applies in the same way on the terminal and
+# in the log file.
+report_logger = ActiveSupport::BroadcastLogger.new(Rails.logger)
+
+unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+  stdout_logger = ActiveSupport::Logger.new($stdout)
+  stdout_logger.formatter = Rails.logger.formatter
+  stdout_logger.level = Rails.logger.level
+  report_logger.broadcast_to(stdout_logger)
+end
+
+log_file = Rails.root.join("log/#{Rails.env}.log")
+
+unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, log_file.to_s)
+  file_logger = ActiveSupport::Logger.new(log_file)
+  file_logger.formatter = Rails.logger.formatter
+  file_logger.level = Rails.logger.level
+  report_logger.broadcast_to(file_logger)
+end
+
 books = Book.order(:id).to_a
 
-Rails.logger.info "Library report: #{books.size} books"
+report_logger.info "Library report: #{books.size} books"
 
 books.each do |book|
   pages = book.leaves.count
 
   if pages.zero?
-    Rails.logger.warn "Library report: #{book.title} has no pages"
+    report_logger.warn "Library report: #{book.title} has no pages"
   else
-    Rails.logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
+    report_logger.info "Library report: #{book.title} has #{pages} #{"page".pluralize(pages)}"
   end
 end
 
-Rails.logger.info "Library report: done"
+report_logger.info "Library report: done"
