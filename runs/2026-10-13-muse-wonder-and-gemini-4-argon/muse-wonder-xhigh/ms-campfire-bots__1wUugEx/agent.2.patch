diff --git a/app/jobs/bots/webhook_delivery_job.rb b/app/jobs/bots/webhook_delivery_job.rb
new file mode 100644
index 0000000..e500296
--- /dev/null
+++ b/app/jobs/bots/webhook_delivery_job.rb
@@ -0,0 +1,84 @@
+require "net/http"
+
+class Bots::WebhookDeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
+  def perform(bot, message)
+    return unless bot.bot? && bot.active? && bot.webhook_url.present?
+    return if message.creator_id == bot.id
+    return unless message.room.memberships.exists?(user: bot)
+
+    response = deliver(bot, message)
+    post_reply(bot, message, response) if response
+  rescue => error
+    Rails.logger.warn "Bot webhook delivery failed for bot #{bot&.id} and message #{message&.id}: #{error.class}: #{error.message}"
+  end
+
+  private
+    def deliver(bot, message)
+      uri = URI.parse(bot.webhook_url.to_s)
+      return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https",
+                      open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT, write_timeout: OPEN_TIMEOUT) do |http|
+        http.post(uri.request_uri, payload(bot, message), "Content-Type" => "application/json")
+      end
+    rescue URI::InvalidURIError => error
+      Rails.logger.warn "Bot webhook delivery failed for bot #{bot.id}: #{error.message}"
+      nil
+    end
+
+    def payload(bot, message)
+      room = message.room
+
+      {
+        event: "mention",
+        author: { id: message.creator_id, name: message.creator.name },
+        room: {
+          id: room.id,
+          name: room.name,
+          reply_to: Rails.application.routes.url_helpers.room_bot_messages_path(room_id: room.id, bot_code: bot.bot_code)
+        },
+        message: {
+          id: message.id,
+          body: { text: text_without_own_mention(bot, message), html: html_body(message) },
+          link: Rails.application.routes.url_helpers.room_at_message_path(room, message)
+        }
+      }.to_json
+    end
+
+    def text_without_own_mention(bot, message)
+      plain_text = message.body.body ? message.body.to_plain_text : message.plain_text_body
+
+      # The bot's own @mention reads as "@Bot name" in plain text; removing it
+      # (and tidying the spaces it leaves behind) leaves the command itself.
+      plain_text.gsub("@#{bot.name}", "").squeeze(" ").strip
+    end
+
+    def html_body(message)
+      message.body.body ? message.body.body.to_html : ""
+    end
+
+    def post_reply(bot, message, response)
+      return unless response.is_a?(Net::HTTPOK)
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8)
+      return if body.blank?
+
+      formatted_body = case response.content_type
+      when "text/html"
+        body
+      when "text/plain", nil
+        ERB::Util.html_escape(body).gsub("\n", "<br>")
+      else
+        return
+      end
+
+      Current.user = bot
+      reply = message.room.messages.create!(body: formatted_body, creator: bot)
+      reply.broadcast_create
+    end
+end
