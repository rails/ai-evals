diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..611a14d 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -1,6 +1,7 @@
 require "test_helper"
 
 class LeafablesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
   setup do
     sign_in :kevin
   end
@@ -117,4 +118,61 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "being edited indicator is not sent to a removed collaborator but is sent to current editors" do
+    leaf = leaves(:welcome_page)
+    book = books(:handbook)
+
+    # Both editors open the page (and subscribe) while both still have access.
+    removed_stream = being_edited_stream_for(users(:kevin), leaf)
+    remaining_stream = being_edited_stream_for(users(:david), leaf)
+
+    # Kevin is removed from the book; his already-open editor stays subscribed.
+    book.accesses.where(user: users(:kevin)).delete_all
+
+    sign_out
+    sign_in :jason
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "With even more interesting words." } }
+    end
+    assert_response :no_content
+
+    assert_empty cable_broadcasts(removed_stream), "removed collaborator should not receive the being edited payload"
+    remaining_broadcasts = cable_broadcasts(remaining_stream)
+    assert_not_empty remaining_broadcasts, "current editor should still receive the being edited payload"
+    assert remaining_broadcasts.join.include?("Jason"), "current editor should see who is editing"
+  end
+
+  test "being edited indicator is not sent to a collaborator downgraded to reader" do
+    leaf = leaves(:welcome_page)
+    book = books(:handbook)
+
+    downgraded_stream = being_edited_stream_for(users(:kevin), leaf)
+    book.access_for(user: users(:kevin)).update!(level: :reader)
+
+    sign_out
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "With even more interesting words." } }
+    end
+    assert_response :no_content
+
+    assert_empty cable_broadcasts(downgraded_stream)
+  end
+
+  private
+    def being_edited_stream_for(user, leaf)
+      sign_out if cookies[:session_token].present?
+      sign_in user
+
+      get edit_leafable_path(leaf)
+      assert_response :ok
+
+      signed_stream_name = Nokogiri::HTML(response.body).at_css("turbo-cable-stream-source")["signed-stream-name"]
+      Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+    end
+
+    def cable_broadcasts(stream_name)
+      ActionCable.server.pubsub.broadcasts(stream_name)
+    end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..a8700dc 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,23 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors are current editor accesses and administrators" do
+    book = books(:handbook)
+
+    assert_includes book.editors, users(:kevin)
+    assert_includes book.editors, users(:david)
+    assert_not_includes book.editors, users(:jz)
+
+    book.accesses.where(user: users(:kevin)).delete_all
+    assert_not_includes book.editors.reload, users(:kevin)
+
+    # Administrators can edit a published book even without an editor
+    # access grant, but not an unpublished book they cannot reach.
+    book.accesses.where(user: users(:david)).delete_all
+    assert_not_includes book.editors.reload, users(:david)
+
+    book.update!(published: true)
+    assert_includes book.editors.reload, users(:david)
+  end
 end
