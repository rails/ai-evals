diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..2a3a9a7
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,70 @@
+class EmailCode < ApplicationRecord
+  EXPIRY_DURATION = 15.minutes
+  CODE_LENGTH = 6
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, :expires_at, presence: true
+
+  normalizes :email_address, with: ->(value) { value.to_s.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.delete(" -").presence }
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+
+  def self.issue(email_address)
+    email_code = transaction do
+      where(email_address: email_address.to_s.strip.downcase).delete_all
+
+      create!(
+        email_address: email_address,
+        code: generate_code,
+        expires_at: EXPIRY_DURATION.from_now
+      )
+    end
+
+    email_code.deliver
+    email_code
+  end
+
+  def self.redeem(code, email_address: nil)
+    normalized_code = code.to_s.strip.upcase.delete(" -")
+
+    if normalized_code.present?
+      record = find_redeemable_record(normalized_code, email_address)
+
+      if record
+        record.destroy
+        record.email_address
+      end
+    end
+  end
+
+  def deliver
+    IdentityMailer.email_code(email_address: email_address, code: code).deliver_later
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def active?
+    !expired?
+  end
+
+  def self.generate_code
+    SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+  end
+  private_class_method :generate_code
+
+  def self.find_redeemable_record(code, email_address)
+    if email_address.present?
+      record = active.where(email_address: email_address.to_s.strip.downcase).order(created_at: :desc).first
+
+      if record && record.code == code
+        record
+      end
+    else
+      active.where(code: code).order(created_at: :desc).first
+    end
+  end
+  private_class_method :find_redeemable_record
+end
