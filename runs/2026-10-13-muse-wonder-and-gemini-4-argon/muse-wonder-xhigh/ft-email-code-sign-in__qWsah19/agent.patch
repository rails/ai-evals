diff --git a/test/controllers/email_codes_controller_test.rb b/test/controllers/email_codes_controller_test.rb
new file mode 100644
index 0000000..a410596
--- /dev/null
+++ b/test/controllers/email_codes_controller_test.rb
@@ -0,0 +1,199 @@
+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "sign in by email code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      assert_redirected_to new_session_email_code_path
+
+      get new_session_email_code_path
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_email_code_path, params: { code: emailed_code }
+
+      assert cookies[:session_token].present?
+      assert_redirected_to landing_path
+    end
+  end
+
+  test "sign in by email code posted to session" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      post session_path, params: { code: emailed_code }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "sign in by magic link code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+
+      get new_session_magic_link_path
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_magic_link_path, params: { code: emailed_code }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "sign in by email code via the API" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }, as: :json
+
+      assert_response :created
+      assert cookies[:pending_authentication_token].present?
+
+      pending_authentication_token = response.parsed_body["pending_authentication_token"]
+      assert pending_authentication_token.present?
+
+      post session_magic_link_path,
+        params: { code: emailed_code },
+        headers: { "Cookie" => "pending_authentication_token=#{pending_authentication_token}" },
+        as: :json
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "magic link code with an invalid pending authentication token via the API" do
+    untenanted do
+      post session_magic_link_path,
+        params: { code: "123456" },
+        headers: { "Cookie" => "pending_authentication_token=invalid" },
+        as: :json
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "sign in with a wrong code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      post session_email_code_path, params: { code: wrong_code }
+
+      assert_not cookies[:session_token].present?
+      assert_redirected_to new_session_email_code_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+  end
+
+  test "sign in with an expired code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      code = emailed_code
+
+      travel 16.minutes do
+        post session_email_code_path, params: { code: code }
+      end
+
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "sign up by email code" do
+    email_address = "newperson@example.com"
+
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+
+      assert_redirected_to new_signup_email_code_path
+
+      get new_signup_email_code_path
+      assert_response :success
+      assert_select "input[name=code]"
+
+      assert_difference -> { Identity.count }, 1 do
+        post signup_email_code_path, params: { code: emailed_code }
+      end
+
+      assert cookies[:session_token].present?
+      assert_redirected_to new_signup_completion_path
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+
+      assert Identity.find_by!(email_address: email_address).accounts.any?
+    end
+  end
+
+  test "join by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "joiner@example.com"
+
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+    assert_redirected_to new_join_email_code_path(join_code: join_code.code, script_name: account.slug)
+
+    get new_join_email_code_path(join_code: join_code.code, script_name: account.slug)
+    assert_response :success
+    assert_select "input[name=code]"
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        post join_email_code_path(join_code: join_code.code, script_name: account.slug), params: { code: emailed_code }
+      end
+    end
+
+    assert cookies[:session_token].present?
+    assert Identity.find_by!(email_address: email_address).users.exists?(account: account)
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+
+  test "join by email code for an existing identity" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    identity = identities(:mike)
+
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identity.email_address }
+
+    assert_no_difference -> { Identity.count } do
+      assert_difference -> { User.count }, 1 do
+        post join_email_code_path(join_code: join_code.code, script_name: account.slug), params: { code: emailed_code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+
+  private
+    def emailed_code
+      perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob)
+      email = ActionMailer::Base.deliveries.last
+      email.subject[/(\d{6})/, 1] || email.body.encoded[/(\d{6})/, 1]
+    end
+
+    def wrong_code
+      emailed_code == "000000" ? "111111" : "000000"
+    end
+end
diff --git a/test/mailers/identity_mailer_test.rb b/test/mailers/identity_mailer_test.rb
