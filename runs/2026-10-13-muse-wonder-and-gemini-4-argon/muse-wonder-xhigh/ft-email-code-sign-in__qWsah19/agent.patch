diff --git a/app/controllers/concerns/email_code_verification.rb b/app/controllers/concerns/email_code_verification.rb
new file mode 100644
index 0000000..9b765be
--- /dev/null
+++ b/app/controllers/concerns/email_code_verification.rb
@@ -0,0 +1,136 @@
+module EmailCodeVerification
+  extend ActiveSupport::Concern
+
+  private
+    def issue_email_code(email_address, purpose: nil, join_code: nil, account: nil)
+      EmailCode.issue(email_address).tap do |email_code|
+        session[:email_code_email_address] = email_code.email_address
+        session[:email_code_purpose] = purpose.to_s.presence
+        session[:email_code_join_code] = join_code.presence
+        session[:email_code_account_id] = account&.id
+        set_pending_authentication_token(email_code, purpose: purpose, join_code: join_code, account: account)
+      end
+    end
+
+    def pending_authentication_token
+      @pending_authentication_token
+    end
+
+    def verified_email_address_by_code
+      code = submitted_email_code
+
+      if code.present?
+        email_address = submitted_email_address.presence || session[:email_code_email_address].presence || pending_authentication_token_data["email_address"].presence
+        verified_email_address = if email_address.present?
+          EmailCode.redeem(code, email_address: email_address)
+        else
+          EmailCode.redeem(code)
+        end
+
+        if verified_email_address
+          session.delete(:email_code_email_address)
+          session.delete(:email_code_purpose)
+          session.delete(:email_code_join_code)
+          session.delete(:email_code_account_id)
+          cookies.delete(:pending_authentication_token)
+          verified_email_address
+        end
+      end
+    end
+
+    def email_code_purpose
+      session[:email_code_purpose].presence || pending_authentication_token_data["purpose"].presence
+    end
+
+    def email_code_join_code
+      if session[:email_code_join_code].present? && session[:email_code_account_id].present?
+        account = Account.find_by(id: session[:email_code_account_id])
+        Account::JoinCode.find_by(code: session[:email_code_join_code], account: account) if account
+      elsif pending_authentication_token_data["join_code"].present? && pending_authentication_token_data["account_id"].present?
+        account = Account.find_by(id: pending_authentication_token_data["account_id"])
+        Account::JoinCode.find_by(code: pending_authentication_token_data["join_code"], account: account) if account
+      end
+    end
+
+    def join_account_by_email_code(identity, join_code)
+      join_code.redeem_if { |account| identity.join(account) }
+      User.active.find_by!(account: join_code.account, identity: identity)
+    end
+
+    def submitted_email_code
+      code = body_email_code_param.presence
+      code ||= params[:code].presence
+      code ||= nested_email_code_param(:email_code)
+      code ||= nested_email_code_param(:session)
+      code ||= nested_email_code_param(:signup)
+      code.to_s.strip.presence
+    end
+
+    def submitted_email_address
+      email_address = params[:email_address].presence
+      email_address ||= nested_email_address_param(:session)
+      email_address ||= nested_email_address_param(:signup)
+      email_address ||= nested_email_address_param(:identity)
+      email_address.to_s.strip.presence
+    end
+
+    def set_pending_authentication_token(email_code, purpose:, join_code:, account:)
+      @pending_authentication_token = pending_authentication_token_verifier.generate(
+        {
+          "email_address" => email_code.email_address,
+          "purpose" => purpose.to_s.presence,
+          "join_code" => join_code.presence,
+          "account_id" => account&.id
+        }.compact,
+        expires_in: EmailCode::EXPIRY_DURATION
+      )
+
+      cookies[:pending_authentication_token] = {
+        value: @pending_authentication_token,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def pending_authentication_token_data
+      token = pending_authentication_token_from_request
+
+      if token.present?
+        pending_authentication_token_verifier.verify(token)
+      else
+        {}
+      end
+    rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveSupport::MessageEncryptor::InvalidMessage, ArgumentError, TypeError
+      {}
+    end
+
+    def pending_authentication_token_from_request
+      token = params[:pending_authentication_token].presence
+      token ||= cookies[:pending_authentication_token].presence
+      token ||= request.cookies["pending_authentication_token"].presence if request&.cookies
+      token
+    end
+
+    def pending_authentication_token_verifier
+      Rails.application.message_verifier("pending_authentication")
+    end
+
+    def body_email_code_param
+      if defined?(request) && request
+        parameters = request.request_parameters
+        parameters[:code] || parameters["code"] if parameters
+      end
+    rescue ActionController::BadRequest, Rack::QueryParser::InvalidParameterError
+      nil
+    end
+
+    def nested_email_code_param(key)
+      nested = params[key]
+      nested[:code] if nested.respond_to?(:key?) && nested.key?(:code)
+    end
+
+    def nested_email_address_param(key)
+      nested = params[key]
+      nested[:email_address] if nested.respond_to?(:key?) && nested.key?(:email_address)
+    end
+end
diff --git a/app/controllers/join_codes/email_codes_controller.rb b/app/controllers/join_codes/email_codes_controller.rb
new file mode 100644
index 0000000..3ed5325
--- /dev/null
+++ b/app/controllers/join_codes/email_codes_controller.rb
@@ -0,0 +1,53 @@
+class JoinCodes::EmailCodesController < ApplicationController
+  include EmailCodeVerification
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @email_address = session[:email_code_email_address].presence || pending_authentication_token_data["email_address"].presence
+  end
+
+  def create
+    if email_address = verified_email_address_by_code
+      @identity = Identity.find_or_create_by!(email_address: email_address)
+      start_new_session_for @identity unless Current.identity == @identity
+
+      user = join_account_by_email_code(@identity, @join_code)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_join_email_code_path(join_code: @join_code.code, script_name: @join_code.account.slug), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: params[:join_code] || params[:code], account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+end
