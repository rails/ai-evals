+++ b/test/mailers/identity_mailer_test.rb
@@ -0,0 +1,15 @@
+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "email_code includes the code in the subject and body" do
+    email = IdentityMailer.email_code(email_address: "person@example.com", code: "123456")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_includes email.subject, "123456"
+    assert_match "123456", email.body.encoded
+  end
+end
diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..bb46f72
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "issue sends a six character code in the email subject" do
+    email_code = nil
+
+    assert_emails 1 do
+      email_code = EmailCode.issue("person@example.com")
+    end
+
+    assert_match(/\A\d{6}\z/, email_code.code)
+    assert_includes ActionMailer::Base.deliveries.last.subject, email_code.code
+    assert_equal "person@example.com", ActionMailer::Base.deliveries.last.to.first
+  end
+
+  test "issue replaces previous codes for the same email address" do
+    first = EmailCode.issue("person@example.com")
+    second = EmailCode.issue("person@example.com")
+
+    assert_nil EmailCode.redeem(first.code, email_address: "person@example.com")
+    assert_equal "person@example.com", EmailCode.redeem(second.code, email_address: "person@example.com")
+  end
+
+  test "redeem consumes the code" do
+    email_code = EmailCode.issue("person@example.com")
+
+    assert_equal "person@example.com", EmailCode.redeem(email_code.code, email_address: "person@example.com")
+    assert_nil EmailCode.redeem(email_code.code, email_address: "person@example.com")
+  end
+
+  test "redeem rejects a wrong code" do
+    EmailCode.issue("person@example.com")
+
+    assert_nil EmailCode.redeem("000000", email_address: "person@example.com") unless EmailCode.exists?(code: "000000")
+  end
+
+  test "a code works for fifteen minutes" do
+    email_code = EmailCode.issue("person@example.com")
+
+    travel 14.minutes do
+      assert_equal "person@example.com", EmailCode.redeem(email_code.code, email_address: "person@example.com")
+    end
+
+    email_code = EmailCode.issue("person@example.com")
+
+    travel 16.minutes do
+      assert_nil EmailCode.redeem(email_code.code, email_address: "person@example.com")
+    end
+  end
+end
