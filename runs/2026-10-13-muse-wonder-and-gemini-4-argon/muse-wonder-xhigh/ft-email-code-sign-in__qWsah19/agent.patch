+class Sessions::EmailCodesController < ApplicationController
+  include EmailCodeVerification
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @email_address = session[:email_code_email_address].presence || pending_authentication_token_data["email_address"].presence
+  end
+
+  def create
+    purpose = email_code_purpose
+    join_code = email_code_join_code
+
+    if email_address = verified_email_address_by_code
+      identity = Identity.find_or_create_by!(email_address: email_address)
+      start_new_session_for identity
+      verification_url = after_email_code_verification_url(purpose, join_code, identity)
+
+      respond_to do |format|
+        format.html { redirect_to verification_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def after_email_code_verification_url(purpose, join_code, identity)
+      if purpose == "sign_up"
+        new_signup_completion_url
+      elsif purpose == "join" && join_code&.active?
+        user = join_account_by_email_code(identity, join_code)
+
+        if user.setup?
+          landing_url(script_name: join_code.account.slug)
+        else
+          new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        after_authentication_url
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
