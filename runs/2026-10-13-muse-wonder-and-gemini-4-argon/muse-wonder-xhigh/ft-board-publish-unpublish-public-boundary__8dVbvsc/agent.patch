diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..3286b71
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish a board" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to board_path(@board)
+    assert @board.reload.published?
+    assert @board.public_key.present?
+  end
+
+  test "admin can publish a board as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @response.parsed_body["public_url"].present?
+    assert_includes @response.parsed_body["public_url"], "/public/boards/#{@board.reload.public_key}"
+  end
+
+  test "publishing twice does not create another publication or change the key" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.public_key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+    assert_equal key, @board.reload.public_key
+  end
+
+  test "admin can unpublish a board" do
+    @board.publish
+    key = @board.public_key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to board_path(@board)
+    assert_not @board.reload.published?
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+
+  test "admin can unpublish a board as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot publish a board" do
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot unpublish a board" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board)
+    end
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "board JSON includes public_url nil by default and URL when published" do
+    get board_path(@board), as: :json
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+
+    @board.publish
+
+    get board_path(@board), as: :json
+    assert_response :success
+    assert_includes @response.parsed_body["public_url"], "/public/boards/#{@board.public_key}"
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
