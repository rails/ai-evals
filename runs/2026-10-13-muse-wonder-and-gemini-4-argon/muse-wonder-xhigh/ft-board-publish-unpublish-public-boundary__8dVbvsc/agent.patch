+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @column = columns(:writebook_in_progress)
+    @card = cards(:text)
+  end
+
+  test "show public board without authentication" do
+    @board.publish
+
+    get public_board_path(@board.public_key)
+    assert_response :success
+    assert_in_body @board.name
+    assert_in_body @card.title
+  end
+
+  test "show public board without account prefix" do
+    @board.publish
+
+    untenanted do
+      get public_board_path(@board.public_key, script_name: "")
+    end
+    assert_response :success
+    assert_in_body @board.name
+  end
+
+  test "show public board as JSON" do
+    @board.publish
+
+    get public_board_path(@board.public_key), as: :json
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+  end
+
+  test "show unpublished board returns not found" do
+    get public_board_path("some-secret-key")
+    assert_response :not_found
+  end
+
+  test "show public column without authentication" do
+    @board.publish
+
+    get public_board_column_path(@board.public_key, @column)
+    assert_response :success
+    assert_in_body @column.name
+    assert_in_body @card.title
+  end
+
+  test "show public card without authentication" do
+    @board.publish
+
+    get public_board_card_path(@board.public_key, @card)
+    assert_response :success
+    assert_in_body @card.title
+  end
+
+  test "show drafted card returns not found" do
+    @board.publish
+    drafted = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:david))
+
+    get public_board_card_path(@board.public_key, drafted)
+    assert_response :not_found
+  end
+
+  test "show card from another board returns not found" do
+    @board.publish
+    get public_board_card_path(@board.public_key, 999_999)
+    assert_response :not_found
+  end
+
+  test "show column from another board returns not found" do
+    @board.publish
+
+    get public_board_column_path(@board.public_key, "nonexistent")
+    assert_response :not_found
+  end
+end
