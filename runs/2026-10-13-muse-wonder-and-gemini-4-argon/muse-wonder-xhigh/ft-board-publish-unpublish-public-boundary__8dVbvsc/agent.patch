diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..cb5f118
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,69 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy, inverse_of: :board
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  def published?
+    publication.present? && !publication.destroyed?
+  end
+
+  def public?
+    published?
+  end
+
+  def publicly_available?
+    published?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+
+  def publish
+    if published?
+      publication
+    else
+      create_publication!
+    end
+  end
+  alias_method :publish!, :publish
+
+  def unpublish
+    publication&.destroy
+  end
+  alias_method :unpublish!, :unpublish
+
+  def public_key
+    publication.key if published?
+  end
+  alias_method :publication_key, :public_key
+  alias_method :public_token, :public_key
+
+  def public_path
+    if published?
+      Rails.application.routes.url_helpers.public_board_path(public_key, script_name: account.slug)
+    end
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_url(public_key, **public_url_options)
+    end
+  end
+  alias_method :publication_url, :public_url
+
+  private
+    def public_url_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+
+      options = options.symbolize_keys
+      options[:host] ||= "example.com"
+      options.merge(script_name: account.slug)
+    end
+end
