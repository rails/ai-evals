+  # Boards grouped by the entropy period that effectively applies to them:
+  # a board's own entropy when it has one, otherwise its account's entropy.
+  #
+  # Entropy periods are resolved in Ruby -- against the (small) boards and
+  # entropies tables -- so that the card queries below can compare
+  # +last_active_at+ against a constant cutoff per group. Comparing it
+  # against a period taken from a joined entropies row instead, e.g.
+  # <tt>last_active_at <= now - COALESCE(board_period, account_period)</tt>,
+  # makes the cutoff different for every row. No index on +last_active_at+
+  # can then be used, and SQLite (and MySQL) resort to scanning every card
+  # and probing boards, accounts and entropies for each one -- which is
+  # what made the hourly auto-postpone sweep outgrow its hour once an
+  # install passed a hundred thousand cards. With constant cutoffs, each
+  # group below is served by +index_cards_on_account_id_and_last_active_at_and_status+
+  # and only cards at least as old as the shortest period are ever read.
+  def self.effective_entropy_groups
+    board_periods = Entropy.where(container_type: "Board").pluck(:container_id, :auto_postpone_period).to_h
+
+    account_periods = {}
+    Entropy.where(container_type: "Account").pluck(:container_id, :account_id, :auto_postpone_period).each do |container_id, account_id, period|
+      account_periods[container_id] = period if container_id == account_id
     end
 
-    scope :postponing_soon, -> do
-      now = Time.now
-      active
-        .joins(board: :account)
-        .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at > #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) * 0.75')}", now)
+    Board.joins(:account).pluck(:id, :account_id).each_with_object({}) do |(board_id, account_id), groups|
+      period = board_periods[board_id] || account_periods[account_id]
+      (groups[[ account_id, period ]] ||= []) << board_id if period
+    end
+  end
+
+  def self.entropic_condition
+    conditions = effective_entropy_groups.map do |(account_id, period), board_ids|
+      cards = Card.arel_table
+      condition = cards[:account_id].eq(account_id).and(cards[:board_id].in(board_ids))
+      yield(period, condition)
     end
 
+    if conditions.any?
+      conditions.reduce { |combined, condition| combined.or(condition) }
+    end
+  end
+
+  included do
+    scope :due_to_be_postponed, -> {
+      now = Time.now
+      condition = Card::Entropic.entropic_condition do |period, group|
+        group.and(arel_table[:last_active_at].lteq(now - period))
+      end
+
+      if condition
+        active.where(condition)
+      else
+        active.where(id: nil)
+      end
+    }
+
+    scope :postponing_soon, -> {
+      now = Time.now
+      condition = Card::Entropic.entropic_condition do |period, group|
+        group
+          .and(arel_table[:last_active_at].gt(now - period))
+          .and(arel_table[:last_active_at].lteq(now - period * 0.75))
+      end
+
+      if condition
+        active.where(condition)
+      else
+        active.where(id: nil)
+      end
+    }
+
     delegate :auto_postpone_period, to: :board
   end
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.now
+
+      # One query per entropy group rather than find_each over every due
+      # card at once, so each batch can use the last_active_at index with
+      # that group's constant cutoff (see note above).
+      Card::Entropic.effective_entropy_groups.each do |(account_id, period), board_ids|
+        active
+          .where(account_id: account_id, board_id: board_ids, last_active_at: ..(now - period))
+          .find_each do |card|
+            card.auto_postpone(user: card.account.system_user)
+          end
       end
     end
   end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..cb5436c 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,40 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due to be postponed uses a shorter board entropy over the account entropy" do
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+    entropies("37s_account").reload.update! auto_postpone_period: 365.days
+
+    cards(:logo).update!(last_active_at: 4.days.ago)
+
+    assert_includes Card.due_to_be_postponed, cards(:logo)
+  end
+
+  test "cards are not entropic when neither board nor account has entropy" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+
+    cards(:logo).update!(last_active_at: 10.years.ago)
+
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+    assert_not_includes Card.postponing_soon, cards(:logo)
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "due and postponing soon boundaries" do
+    freeze_time
+    period = entropies(:writebook_board).auto_postpone_period
+
+    cards(:logo).update!(last_active_at: Time.now - period)
+    cards(:layout).update!(last_active_at: Time.now - period * 0.75)
+
+    assert_includes Card.due_to_be_postponed, cards(:logo)
+    assert_not_includes Card.due_to_be_postponed, cards(:layout)
+    assert_not_includes Card.postponing_soon, cards(:logo)
+    assert_includes Card.postponing_soon, cards(:layout)
+  end
 end
