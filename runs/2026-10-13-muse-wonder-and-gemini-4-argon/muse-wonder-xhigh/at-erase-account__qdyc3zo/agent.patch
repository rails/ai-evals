diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..cfe6910 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -24,7 +24,69 @@ class User < ApplicationRecord
     end
   end
 
+  # Permanently erase the user and everything that identifies them.
+  #
+  # Books shared with everyone are the only exception: they stay so
+  # everyone else can keep reading them, but they are detached from
+  # their creator and bylined. Every other created book is
+  # destroyed with the user (which also destroys its leaves and
+  # removes them from the search index).
+  def destroy
+    return super unless persisted?
+
+    result = nil
+
+    transaction do
+      anonymize_books_shared_with_everyone
+      destroy_books_not_shared_with_everyone
+      erase_sessions_and_sign_in_events
+
+      result = super
+      raise ActiveRecord::Rollback unless result
+    end
+
+    result
+  end
+
   private
+    def anonymize_books_shared_with_everyone
+      created_books.with_everyone_access.find_each do |book|
+        # Use update_columns so the creator association's default
+        # (Current.user) doesn't re-attach the book to whoever is
+        # performing the erasure.
+        book.update_columns creator_id: nil, author: "Deleted author", updated_at: Time.current
+      end
+    end
+
+    def destroy_books_not_shared_with_everyone
+      created_books.where(everyone_access: false).find_each(&:destroy!)
+    end
+
+    def erase_sessions_and_sign_in_events
+      addresses = email_addresses_used_to_sign_in
+
+      # Delete sessions directly rather than destroying them: Session's
+      # sign-in auditing would otherwise create a brand new
+      # SignInEvent for every session being erased.
+      sessions.delete_all
+      SignInEvent.where(email_address: addresses).delete_all if addresses.present?
+    end
+
+    # Sign-in events are keyed by the address the person actually
+    # signed in with. For somebody who was previously deactivated
+    # that is not the address now stored on the user: deactivation
+    # rewrites it to "<original>-deactivated-<uuid>@<domain>", so
+    # recover the original address from that rewritten form too.
+    def email_addresses_used_to_sign_in
+      addresses = [ email_address ]
+
+      if email_address&.include?("-deactivated-")
+        addresses << email_address.sub(/-deactivated-[^@]+@/, "@")
+      end
+
+      addresses.compact_blank.uniq
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
