diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..a7ce0b5 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,50 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases them and their private books but anonymizes books shared with everyone" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "Test", ip_address: "127.0.0.1")
+
+    private_book = Book.create!(title: "Kevin's private book", author: "Kevin", everyone_access: false, creator: user)
+    private_leaf = private_book.press Page.new(body: "Kevin's private words"), title: "Private words"
+    shared_book = Book.create!(title: "Kevin's shared book", author: "Kevin", everyone_access: true, creator: user)
+    shared_leaf = shared_book.press Page.new(body: "Words for everyone"), title: "Shared words"
+    ReadingMark.remember leaves(:welcome_page), user: user
+    ReadingMark.remember shared_leaf, user: user
+    Leaf.reindex_all
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Leaf.search("private words")
+    assert_equal 0, Session.where(user_id: user.id).count
+    assert_equal 0, Access.where(user_id: user.id).count
+    assert_equal 0, ReadingMark.where(user_id: user.id).count
+    assert_equal 0, SignInEvent.where(email_address: user.email_address).count
+
+    assert Book.exists?(shared_book.id)
+    shared_book.reload
+    assert_equal "Deleted author", shared_book.author
+    assert_nil shared_book.creator_id
+    assert Leaf.exists?(shared_leaf.id)
+    assert_includes Leaf.search("Words for everyone"), shared_leaf
+  end
+
+  test "destroying a previously deactivated user erases sign-in events under their original email address" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "Test", ip_address: "127.0.0.1")
+    user.deactivate
+
+    assert_not user.active?
+    assert_includes user.email_address, "-deactivated-"
+
+    user.destroy!
+
+    assert_not User.exists?(user.id)
+    assert_equal 0, SignInEvent.where(email_address: "kevin@example.com").count
+    assert_equal 0, SignInEvent.where(email_address: user.email_address).count
+  end
 end
