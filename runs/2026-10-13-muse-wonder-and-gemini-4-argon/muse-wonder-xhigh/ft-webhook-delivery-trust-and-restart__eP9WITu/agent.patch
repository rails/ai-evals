diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
new file mode 100644
index 0000000..0fb5f0f
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  test "an event posts to active webhooks subscribed to its action, exactly once" do
+    webhook = webhooks(:active)
+    request = stub_request(:post, webhook.url).to_return(status: 200)
+
+    event = nil
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:layout), action: "card_published")
+    end
+
+    assert_requested request, times: 1
+
+    deliveries = webhook.deliveries.where(event: event)
+    assert_equal 1, deliveries.count
+    assert deliveries.first.completed?
+    assert deliveries.first.succeeded?
+
+    # Re-dispatching the same event and re-performing must not POST again.
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      event.dispatch_webhooks
+      Webhook::DeliveryJob.perform_now(deliveries.first)
+    end
+
+    assert_requested request, times: 1
+    assert_equal 1, webhook.deliveries.where(event: event).count
+  end
+
+  test "an event does not post to inactive webhooks or webhooks subscribed to other actions" do
+    webhook = webhooks(:active)
+    webhook.update!(subscribed_actions: %w[ card_closed ])
+    request = stub_request(:post, webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:layout), action: "card_published")
+    end
+
+    assert_not_requested request
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
