     assert_nil delivery.response_summary
   end
+
+  test "deliver posts the event as JSON and records the outcome" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+
+    captured = nil
+    request = stub_request(:post, webhook.url)
+      .with { |http_request| captured = http_request; true }
+      .to_return(status: 200, headers: { "Content-Type" => "application/json" })
+
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    assert delivery.deliver
+
+    assert_requested request, times: 1
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+
+    body = JSON.parse(captured.body)
+    assert_equal event.id, body["id"]
+    assert_equal "comment_created", body["action"]
+
+    expected_signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, captured.body)
+    assert_equal expected_signature, captured.headers["X-Webhook-Signature"]
+    assert_equal "fizzy/1.0.0 Webhook", captured.headers["User-Agent"]
+    assert_equal "application/json", captured.headers["Content-Type"]
+
+    # The log keeps the headers that were sent, signature included, and
+    # the API-facing sanitized copy strips the signature back out.
+    assert_equal expected_signature, delivery.reload.request.dig("headers", "X-Webhook-Signature")
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+  end
+
+  test "deliver posts a chat message to Slack, Campfire and Basecamp receivers" do
+    event = events(:layout_commented)
+
+    {
+      "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" => "text",
+      "https://example.com/rooms/123/456-room-name/messages" => "body",
+      "https://basecamp.com/999/integrations/some-token/buckets/111/chats/222/lines" => "content"
+    }.each do |url, field|
+      webhook = Webhook.create!(name: "Chat", url: url, board: boards(:writebook), subscribed_actions: %w[ comment_created ])
+
+      captured = nil
+      stub_request(:post, url)
+        .with { |http_request| captured = http_request; true }
+        .to_return(status: 200)
+
+      delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+      assert delivery.deliver, "expected delivery to #{url} to be attempted"
+
+      message = JSON.parse(captured.body)[field]
+      assert message.present?, "expected #{field} in payload for #{url}"
+      assert_includes message, "commented on"
+      assert_includes message, %(\"Layout is broken\") if field == "text"
+    end
+  end
+
+  test "deliver only posts exactly once, however many times it is run" do
+    webhook = webhooks(:active)
+    request = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+
+    assert delivery.deliver
+    assert_not delivery.deliver
+    assert_not Webhook::Delivery.find(delivery.id).deliver
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested request, times: 1
+  end
+
+  test "deliver records a non-2xx response as a completed, failed delivery" do
+    webhook = webhooks(:active)
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    assert delivery.deliver
+
+    assert delivery.completed?
+    assert delivery.failed?
+    assert_not delivery.succeeded?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, webhook.ensure_delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver records an unreachable receiver as errored" do
+    webhook = webhooks(:active)
+    stub_request(:post, webhook.url).to_timeout
+
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    assert delivery.deliver
+
+    assert delivery.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, webhook.ensure_delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a successful delivery clears previously recorded failures" do
+    webhook = webhooks(:active)
+    tracker = webhook.ensure_delinquency_tracker
+    tracker.record_failure
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
