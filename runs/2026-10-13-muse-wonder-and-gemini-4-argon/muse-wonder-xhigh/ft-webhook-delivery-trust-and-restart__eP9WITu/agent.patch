+require "cgi"
+
 class Webhook::Delivery < ApplicationRecord
+  # How long a delivery (the log of one attempt) is kept before the
+  # recurring cleanup job removes it.
+  RETENTION_PERIOD = 7.days
+
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+  WRITE_TIMEOUT = 5.seconds
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +20,59 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  class << self
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  # Performs the POST exactly once. The delivery is atomically claimed
+  # (pending -> in_progress) before any HTTP happens, so running this --
+  # directly, or via the job, or via a retried/duplicated job -- for a
+  # delivery that has already been claimed, completed or errored is a
+  # no-op and the receiver is never POSTed to a second time.
+  #
+  # The outcome is recorded on the delivery itself: the request headers
+  # that were sent (the signature is stored here but stripped before the
+  # log is exposed -- see #sanitized_request) and either the response
+  # code/headers or the error that prevented a response. Failures and
+  # successes are also fed to the webhook's delinquency tracker.
+  def deliver
+    if claim_for_delivery
+      begin
+        body = payload
+        headers = request_headers(body)
+
+        update!(request: { headers: headers })
+
+        http_response = post(body, headers)
+
+        update!(
+          state: :completed,
+          response: { code: http_response.code.to_i, headers: http_response.each_header.to_h, error: nil }
+        )
+      rescue => error
+        Rails.logger.error "Webhook delivery #{id} failed: #{error.class}: #{error.message}"
+        update!(
+          state: :errored,
+          response: { error: "destination_unreachable" }
+        )
+      end
+
+      record_outcome_in_delinquency_tracker
+
+      true
+    else
+      false
+    end
+  end
+  alias_method :deliver_now, :deliver
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +93,99 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    # Atomically move pending -> in_progress. Only the caller that
+    # updates the row is allowed to perform the HTTP request.
+    def claim_for_delivery
+      claimed_rows = self.class
+        .where(id: id, state: :pending)
+        .update_all([ "state = ?, updated_at = ?", :in_progress, Time.current ])
+
+      if claimed_rows == 1
+        self.state = :in_progress
+        true
+      else
+        false
+      end
+    end
+
+    def record_outcome_in_delinquency_tracker
+      webhook.ensure_delinquency_tracker.record_delivery(self)
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.write_timeout = WRITE_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri)
+      headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http.request(request)
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => signature(body)
+      }
+    end
+
+    # As documented on the webhook's settings page: an HMAC-SHA256 of the
+    # request body, keyed with the webhook's signing secret.
+    def signature(body)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def payload
+      if webhook.for_slack?
+        { text: rendered_event_slack }.to_json
+      elsif webhook.for_campfire?
+        { body: rendered_event_html }.to_json
+      elsif webhook.for_basecamp?
+        { content: rendered_event_html }.to_json
+      else
+        rendered_event_json
+      end
+    end
+
+    def rendered_event_json
+      render_event(:json)
+    end
+
+    def rendered_event_html
+      render_event(:html).strip
+    end
+
+    # Slack messages use mrkdwn rather than HTML: turn the HTML link
+    # back into a Slack link and unescape the rest of the sentence.
+    def rendered_event_slack
+      message = rendered_event_html.gsub(%r{<a[^>]+href="([^"]+)"[^>]*>(.*?)</a>}i) do
+        "<#{Regexp.last_match(1)}|#{Regexp.last_match(2)}>"
+      end
+
+      CGI.unescapeHTML(message)
+    end
+
+    def render_event(format)
+      renderer.render(template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event })
+    end
+
+    def renderer
+      account = webhook.account || event.account
+
+      if account&.slug
+        ApplicationController.renderer.new(script_name: account.slug)
+      else
+        ApplicationController.renderer
+      end
+    end
 end
