@@ -0,0 +1,23 @@
+module Event::Webhookable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :dispatch_webhooks
+  end
+
+  # Creates (at most) one delivery per active webhook on this event's
+  # board that is subscribed to this event's action, and enqueues each
+  # delivery. Re-running this for an event that has already been
+  # dispatched does not create duplicate deliveries and does not POST
+  # to a receiver twice -- see Webhook#dispatch and
+  # Webhook::Delivery#deliver.
+  def dispatch_webhooks
+    board.webhooks.active.each do |webhook|
+      if webhook.subscribed_to?(action)
+        webhook.dispatch(self)
+      end
+    end
+  end
+  alias_method :deliver_webhooks, :dispatch_webhooks
+  alias_method :trigger_webhooks, :dispatch_webhooks
+end
