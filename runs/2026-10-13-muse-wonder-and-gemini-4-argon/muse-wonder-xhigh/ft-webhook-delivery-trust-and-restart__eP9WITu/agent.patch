index 0000000..ee59501
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "is created automatically with a webhook" do
+    webhook = Webhook.create!(name: "Test", url: "https://example.com/webhook", board: boards(:writebook))
+
+    assert webhook.delinquency_tracker.present?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "a success clears a run of failures" do
+    tracker = webhooks(:active).ensure_delinquency_tracker
+
+    tracker.record_failure
+    tracker.record_failure
+    assert_equal 2, tracker.consecutive_failures_count
+    assert tracker.first_failure_at.present?
+
+    tracker.record_success
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "ten consecutive failures spread over more than an hour deactivate the webhook" do
+    webhook = webhooks(:active)
+    tracker = webhook.ensure_delinquency_tracker
+
+    9.times { tracker.record_failure }
+    assert webhook.reload.active?
+
+    # The run of failures started over an hour ago, and this is the tenth.
+    tracker.update!(first_failure_at: 61.minutes.ago)
+    tracker.record_failure
+
+    assert_equal 10, tracker.consecutive_failures_count
+    assert_not webhook.reload.active?
+  end
+
+  test "ten quick consecutive failures do not deactivate the webhook yet" do
+    webhook = webhooks(:active)
+    tracker = webhook.ensure_delinquency_tracker
+
+    10.times { tracker.record_failure }
+
+    assert webhook.reload.active?
+  end
+
+  test "reactivating a webhook clears its failures" do
+    webhook = webhooks(:active)
+    tracker = webhook.ensure_delinquency_tracker
+    tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    webhook.deactivate
+
+    webhook.activate
+
+    assert webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+end
