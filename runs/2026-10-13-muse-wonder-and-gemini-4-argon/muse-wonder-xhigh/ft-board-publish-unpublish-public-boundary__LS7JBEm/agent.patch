+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@board.public_key) %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="public-card">
+  <h1><%= @card.title %></h1>
+
+  <p class="public-card__board"><%= link_to @board.name, public_board_path(@board.public_key) %></p>
+
+  <% if @card.column %>
+    <p class="public-card__column"><%= link_to @card.column.name, public_board_column_path(@board.public_key, @card.column) %></p>
+  <% end %>
+
+  <p class="public-card__creator"><%= @card.creator.name %></p>
+
+  <% if @card.description.present? %>
+    <div class="public-card__description">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ul class="public-card__steps">
+      <% @card.steps.each do |step| %>
+        <li><%= step.content %></li>
+      <% end %>
+    </ul>
+  <% end %>
+
+  <% if @card.tags.any? %>
+    <ul class="public-card__tags">
+      <% @card.tags.each do |tag| %>
+        <li><%= tag.title %></li>
+      <% end %>
+    </ul>
+  <% end %>
+
+  <% if @card.comments.any? %>
+    <section class="public-card__comments">
+      <% @card.comments.chronologically.each do |comment| %>
+        <article class="public-card__comment">
+          <p class="public-card__comment-creator"><%= comment.creator.name %></p>
+          <div class="public-card__comment-body"><%= comment.body %></div>
+        </article>
+      <% end %>
+    </section>
+  <% end %>
+</article>
