diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..dac3513
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "publishing a board generates a public key" do
+    board = boards(:writebook)
+
+    assert_not board.public?
+    assert_nil board.public_key
+
+    board.publish
+
+    assert board.public?
+    assert board.published?
+    assert board.public_key.present?
+    assert_equal board, Board.find_by_public_key(board.public_key)
+  end
+
+  test "publishing is idempotent" do
+    board = boards(:writebook)
+    board.publish
+    key = board.public_key
+
+    board.publish
+
+    assert_equal key, board.public_key
+  end
+
+  test "unpublishing removes the public key" do
+    board = boards(:writebook)
+    board.publish
+    key = board.public_key
+
+    board.unpublish
+
+    assert_not board.public?
+    assert_nil board.public_key
+    assert_nil Board.find_by_public_key(key)
+  end
+
+  test "republishing generates a new key" do
+    board = boards(:writebook)
+    board.publish
+    old_key = board.public_key
+    board.unpublish
+    board.publish
+
+    assert board.public_key.present?
+    assert_not_equal old_key, board.public_key
+  end
+end
