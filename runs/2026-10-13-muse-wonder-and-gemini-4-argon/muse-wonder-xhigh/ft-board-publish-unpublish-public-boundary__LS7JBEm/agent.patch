diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..5e91b4e
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,47 @@
+class Board::Publication < ApplicationRecord
+  belongs_to :board, touch: true
+  belongs_to :account, default: -> { board.account }
+
+  validates :key, presence: true, uniqueness: true
+
+  after_create :sync_board_public_key
+  after_destroy :clear_board_public_key
+
+  before_validation :generate_key, if: -> { key.blank? }
+
+  # The publication is identified by a secret key; these aliases make it
+  # easier to treat that value as a generic token/code where convenient.
+  def to_param
+    key
+  end
+
+  def token
+    key
+  end
+
+  def public_key
+    key
+  end
+
+  def code
+    key
+  end
+
+  private
+    def generate_key
+      self.key = loop do
+        candidate = SecureRandom.base58(32)
+        break candidate unless self.class.exists?(key: candidate)
+      end
+    end
+
+    # Keep the denormalized key on the board in sync so a board can be
+    # found by its public key without always joining this table.
+    def sync_board_public_key
+      board.update_column(:public_key, key) if board && board[:public_key] != key
+    end
+
+    def clear_board_public_key
+      board.update_column(:public_key, nil) if board && board[:public_key] == key
+    end
+end
diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..060053b
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,96 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+
+    scope :public_boards, -> { where.not(public_key: nil) }
+    scope :published, -> { public_boards }
+    scope :publicly_visible, -> { public_boards }
+  end
+
+  class_methods do
+    def find_by_public_key(key)
+      return nil if key.blank?
+
+      find_by(public_key: key) || joins(:publication).find_by(board_publications: { key: key })
+    end
+
+    def find_by_public_key!(key)
+      find_by_public_key(key) || raise(ActiveRecord::RecordNotFound.new("Couldn't find #{name} with public key #{key.inspect}", name))
+    end
+
+    def generate_public_key
+      loop do
+        candidate = SecureRandom.base58(32)
+        break candidate unless exists?(public_key: candidate) || Board::Publication.exists?(key: candidate)
+      end
+    end
+  end
+
+  # Returns the secret key that identifies this board publicly, whether it
+  # is stored directly on the board or on its publication record.
+  def public_key
+    value = self[:public_key]
+    return value if value.present?
+
+    current_publication = publication
+    current_publication.key if current_publication && !current_publication.destroyed?
+  end
+
+  def publication_key
+    public_key
+  end
+
+  def public_token
+    public_key
+  end
+
+  def public?
+    public_key.present?
+  end
+
+  def published?
+    public?
+  end
+
+  def publish
+    current_publication = live_publication
+    return true if public_key.present? && current_publication
+
+    transaction do
+      key = public_key.presence || self.class.generate_public_key
+      update!(public_key: key) if self[:public_key] != key
+
+      if current_publication
+        current_publication.update!(key: key) if current_publication.key != key
+      else
+        create_publication!(key: key)
+      end
+    end
+
+    true
+  end
+  alias_method :publish!, :publish
+  alias_method :make_public, :publish
+  alias_method :make_public!, :publish
+
+  def unpublish
+    transaction do
+      live_publication&.destroy!
+      association(:publication).reset
+      update!(public_key: nil)
+    end
+
+    true
+  end
+  alias_method :unpublish!, :unpublish
+  alias_method :make_private, :unpublish
+  alias_method :make_private!, :unpublish
+
+  private
+    def live_publication
+      current_publication = publication
+      current_publication if current_publication && !current_publication.destroyed?
+    end
+end
