diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
new file mode 100644
index 0000000..89e8479
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,30 @@
+class TicketMailer < ApplicationMailer
+  # Email a staff member's public reply to the requester of an
+  # email-origin ticket. The From / Reply-To is the ticket's private
+  # reply address so a reply from the customer's mail client comes
+  # straight back to this conversation.
+  def public_reply(ticket, comment)
+    @ticket = ticket
+    @comment = comment
+    @account = ticket.account
+    @requester = ticket.requester
+    @author = comment.author
+
+    @ticket.ensure_reply_token! if @ticket.reply_token.blank?
+    reply_address = @ticket.reply_address
+    # Fall back to the business' plain support address if for some
+    # reason a reply address cannot be built.
+    reply_address ||= Ticket.support_address_for(@account)
+    @reply_address = reply_address
+
+    subject_line = @ticket.subject.to_s.strip
+    subject_line = "Re: #{subject_line}" unless subject_line.match?(/\A\s*re\s*:/i)
+
+    mail(
+      to: @requester.email,
+      from: reply_address,
+      reply_to: reply_address,
+      subject: subject_line
+    )
+  end
+end
diff --git a/app/mailers/user_mailer.rb b/app/mailers/user_mailer.rb
new file mode 100644
index 0000000..8ca1762
--- /dev/null
+++ b/app/mailers/user_mailer.rb
@@ -0,0 +1,35 @@
+class UserMailer < ApplicationMailer
+  def verification_email(user, token)
+    @user = user
+    @account = user.account
+    @token = token
+    @url = "#{frontend_url}/verify-email?account=#{@account.subdomain}&token=#{token}"
+    mail(to: @user.email, from: mail_from, subject: "Verify your email")
+  end
+
+  def invitation_email(invitation, token)
+    @invitation = invitation
+    @account = invitation.account
+    @token = token
+    @url = "#{frontend_url}/accept-invitation?account=#{@account.subdomain}&token=#{token}"
+    mail(to: @invitation.email, from: mail_from, subject: "You've been invited")
+  end
+
+  def password_reset_email(user, token)
+    @user = user
+    @account = user.account
+    @token = token
+    @url = "#{frontend_url}/reset-password?account=#{@account.subdomain}&token=#{token}"
+    mail(to: @user.email, from: mail_from, subject: "Reset your password")
+  end
+
+  private
+
+  def frontend_url
+    ENV.fetch("HELPDESK_FRONTEND_URL", "http://localhost:3001").to_s.sub(%r{/+\z}, "")
+  end
+
+  def mail_from
+    ENV.fetch("HELPDESK_MAIL_FROM", "support@example.test")
+  end
+end
