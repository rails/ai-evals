diff --git a/app/models/group.rb b/app/models/group.rb
new file mode 100644
index 0000000..4a98ddb
--- /dev/null
+++ b/app/models/group.rb
@@ -0,0 +1,28 @@
+class Group < ApplicationRecord
+  belongs_to :account
+  has_many :group_memberships, dependent: :destroy
+  has_many :users, through: :group_memberships
+  has_many :members, through: :group_memberships, source: :user
+  has_many :tickets, dependent: :nullify
+
+  before_validation :normalize_name
+  validates :name, presence: true
+
+  # Deleting a group is like clearing the group from its tickets:
+  # those tickets lose both their group and their (now invalid) assignee.
+  # Memberships being destroyed also clear assignments and promote
+  # defaults, but do this first (prepend) so ticket group_id is still
+  # present when we look them up, regardless of dependent-destroy order.
+  before_destroy :clear_ticket_assignments, prepend: true
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.strip if name
+  end
+
+  def clear_ticket_assignments
+    return if id.blank?
+    Ticket.where(group_id: id).update_all(assignee_id: nil, group_id: nil)
+  end
+end
