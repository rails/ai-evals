+class AddCursorPaginationIndexes < ActiveRecord::Migration[8.1]
+  def change
+    # Keyset (cursor) pagination filters and orders by these tuples, so a
+    # page deep in a collection can be found with an index seek instead
+    # of scanning/discarding all preceding rows (OFFSET).
+    add_index :tickets, [:account_id, :updated_at, :id], name: "index_tickets_cursor", if_not_exists: true
+    add_index :tickets, [:account_id, :requester_id, :updated_at, :id], name: "index_tickets_requester_cursor", if_not_exists: true
+    add_index :ticket_comments, [:ticket_id, :created_at, :id], name: "index_ticket_comments_cursor", if_not_exists: true
+    add_index :users, [:account_id, :id], name: "index_users_cursor", if_not_exists: true
+    add_index :invitations, [:account_id, :id], name: "index_invitations_cursor", if_not_exists: true
+    add_index :groups, [:account_id, :id], name: "index_groups_cursor", if_not_exists: true
+    add_index :group_memberships, [:account_id, :id], name: "index_group_memberships_cursor", if_not_exists: true
+  end
+end
