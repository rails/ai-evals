diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..ea576cc 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -2,22 +2,37 @@ module Card::Entropic
   extend ActiveSupport::Concern
 
   included do
+    # The previous form evaluated per-row date arithmetic over the joined
+    # board/account entropy tables for every card:
+    #
+    #   last_active_at <= now - COALESCE(board_period, account_period)
+    #
+    # Because the cutoff depends on each row, no index on +last_active_at+
+    # can satisfy it, so finding the handful of due cards forced a full
+    # scan of the cards table (plus join probes per card) on every sweep.
+    # There are only a handful of distinct periods in use, so instead
+    # branch on each period with its now-constant cutoff, resolving which
+    # boards use that period in a subquery. Each branch can then be
+    # satisfied with the (board_id, status, last_active_at) index.
     scope :due_to_be_postponed, -> do
-      active
-        .joins(board: :account)
-        .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+      now = Time.now
+
+      auto_postpone_periods
+        .map { |period| active.where(board_id: boards_with_auto_postpone_period(period), last_active_at: ..now - period.seconds) }
+        .reduce { |combined, branch| combined.or(branch) }
     end
 
     scope :postponing_soon, -> do
       now = Time.now
-      active
-        .joins(board: :account)
-        .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at > #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) * 0.75')}", now)
+
+      auto_postpone_periods
+        .map do |period|
+          active
+            .where(board_id: boards_with_auto_postpone_period(period))
+            .where("last_active_at > ?", now - period.seconds)
+            .where("last_active_at <= ?", now - (period * 0.75).seconds)
+        end
+        .reduce { |combined, branch| combined.or(branch) }
     end
 
     delegate :auto_postpone_period, to: :board
@@ -25,10 +40,38 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      # Materialize the due ids in a single indexed pass, then load cards
+      # in batches by id. Re-running the due query for every find_each
+      # batch would repeat the multi-branch scan/sort for each batch, and
+      # loading by id keeps each batch to primary-key lookups. The active
+      # check guards against cards postponed by another overlapping run
+      # since the ids were collected.
+      due_to_be_postponed.pluck(:id).each_slice(1000) do |card_ids|
+        active.where(id: card_ids).each do |card|
+          card.auto_postpone(user: card.account.system_user)
+        end
       end
     end
+
+    # Every period that can currently apply to a card. The validated
+    # periods are the only ones reachable through the UI, but include any
+    # other period already stored (e.g. legacy rows written before the
+    # validation, or with it bypassed) so such boards keep working.
+    def auto_postpone_periods
+      Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS | Entropy.distinct.pluck(:auto_postpone_period)
+    end
+
+    # Boards whose effective auto-postpone period is the given one: the
+    # board's own entropy when present, otherwise its account's. Boards
+    # with no applicable entropy match no period, matching the previous
+    # behaviour where a NULL period never made a card due.
+    def boards_with_auto_postpone_period(period)
+      Board
+        .left_outer_joins(:entropy)
+        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.container_type = 'Account' AND account_entropies.container_id = boards.account_id")
+        .where("COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) = ?", period)
+        .select(:id)
+    end
   end
 
   def entropy
