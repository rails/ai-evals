diff --git a/app/models/ticket.rb b/app/models/ticket.rb
index 0ed628e..853f2fd 100644
--- a/app/models/ticket.rb
+++ b/app/models/ticket.rb
@@ -1,5 +1,6 @@
 class Ticket < ApplicationRecord
   STATUSES = %w[open pending solved].freeze
+  PRIORITIES = %w[normal high].freeze
 
   belongs_to :account
   belongs_to :requester, class_name: "User"
@@ -8,6 +9,16 @@ class Ticket < ApplicationRecord
   # Convenient alias used by serialisers / callers that speak of "comments".
   has_many :comments, class_name: "TicketComment"
 
+  before_validation :normalize_priority
+
   validates :subject, presence: true
   validates :status, presence: true, inclusion: { in: STATUSES }
+  validates :priority, presence: true, inclusion: { in: PRIORITIES }
+
+  private
+
+  def normalize_priority
+    self.priority = "normal" if priority.blank?
+    self.priority = priority.to_s.strip.downcase if priority.present?
+  end
 end
