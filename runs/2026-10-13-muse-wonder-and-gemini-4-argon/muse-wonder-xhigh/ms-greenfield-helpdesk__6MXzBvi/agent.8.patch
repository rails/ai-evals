+          if records.empty?
+            meta = build_pagination_result(records, count, page_number, per_page, false, false, false, ordering, nil, (page_number > 1 ? page_number - 1 : nil))
+          else
+            meta = build_pagination_result(records, count, page_number, per_page, has_next, has_prev, has_more, ordering, next_page_val, previous_page_val)
+          end
+          [ records, meta ]
+        else
+          records = all_records.slice((page_number - 1) * per_page, per_page) || []
+          has_next = page_number * per_page < count
+          has_prev = page_number > 1
+          next_page_val = has_next ? page_number + 1 : nil
+          previous_page_val = has_prev ? page_number - 1 : nil
+          meta = build_pagination_result(records, count, page_number, per_page, has_next, has_prev, has_next, ordering, next_page_val, previous_page_val)
+          [ records, meta ]
+        end
       end
 
     end
