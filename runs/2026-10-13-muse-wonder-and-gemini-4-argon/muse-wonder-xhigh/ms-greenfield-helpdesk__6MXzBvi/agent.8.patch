diff --git a/db/migrate/20261013180005_add_cursor_pagination_indexes.rb b/db/migrate/20261013180005_add_cursor_pagination_indexes.rb
new file mode 100644
index 0000000..6339b95
--- /dev/null
+++ b/db/migrate/20261013180005_add_cursor_pagination_indexes.rb
@@ -0,0 +1,24 @@
+class AddCursorPaginationIndexes < ActiveRecord::Migration[8.1]
+  def change
+    # Cursor pagination locates the next window by the ordering columns
+    # instead of scanning past OFFSET rows.  Composite indexes matching
+    # each collection's ordering (with `id` as the tie-breaker) keep
+    # that lookup fast no matter how deep the client has browsed.
+    add_index :tickets, [ :account_id, :updated_at, :id ],
+              order: { updated_at: :desc, id: :desc },
+              name: "index_tickets_on_account_cursor"
+    add_index :tickets, [ :account_id, :requester_id, :updated_at, :id ],
+              order: { updated_at: :desc, id: :desc },
+              name: "index_tickets_on_requester_cursor"
+    add_index :ticket_comments, [ :ticket_id, :created_at, :id ],
+              name: "index_ticket_comments_on_ticket_cursor"
+    add_index :users, [ :account_id, :id ],
+              name: "index_users_on_account_cursor"
+    add_index :groups, [ :account_id, :id ],
+              name: "index_groups_on_account_cursor"
+    add_index :invitations, [ :account_id, :id ],
+              name: "index_invitations_on_account_cursor"
+    add_index :group_memberships, [ :account_id, :id ],
+              name: "index_group_memberships_on_account_cursor"
+  end
+end
