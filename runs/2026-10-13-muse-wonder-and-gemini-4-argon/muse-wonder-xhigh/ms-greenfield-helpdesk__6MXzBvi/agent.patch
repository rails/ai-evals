+      def cursor_ordering_for(context, original_order_values = nil)
+        ordering = []
+        values = original_order_values
+        if values.nil? && context.respond_to?(:order_values)
+          begin
+            values = context.order_values
+          rescue StandardError
+            values = nil
+          end
+        end
+        Array(values).each do |ord|
