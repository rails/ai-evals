+      end
+
+      def record_cursor_value(record, column)
+        raw = nil
+        begin
+          raw = record.public_send(column)
+        rescue StandardError
+          begin
+            raw = record[column]
+          rescue StandardError
+            raw = nil
+          end
+        end
+        raw
+      end
+
+      def encode_cursor_for_record(record, ordering)
+        values = ordering.map do |col, _dir|
+          cursor_serialized_value(record_cursor_value(record, col))
+        end
+        payload = { "v" => 1, "k" => values }
+        begin
+          payload["id"] = record.id if record.respond_to?(:id) && record.id.present?
+        rescue StandardError
+          nil
+        end
+        Base64.urlsafe_encode64(JSON.generate(payload), padding: false)
+      end
+
+      def resolve_id_only_cursor(id_value, ordering, context)
+        model = cursor_model_for(context)
+        if ordering.length == 1 && ordering[0][0] == "id"
+          return [ cast_cursor_value(model, "id", id_value) ]
+        end
+        record = nil
+        begin
+          record = model.find_by(id: id_value) if model
+        rescue StandardError
+          record = nil
+        end
+        if record
+          return ordering.map do |col, _dir|
+            cast_cursor_value(model, col, cursor_serialized_value(record_cursor_value(record, col)))
+          end
+        end
+        { "id_only" => id_value }
+      end
+
+      def decode_cursor(cursor_str, ordering, context = nil)
+        str = cursor_str.to_s.strip
+        raise InvalidCursorError, "Invalid cursor" if str.empty?
+
+        if str.match?(/\A-?\d+\z/)
+          return resolve_id_only_cursor(str.to_i, ordering, context)
+        end
+
+        texts = []
+        texts << str if str.start_with?("{", "[")
+        begin
+          padded = str + ("=" * ((4 - str.length % 4) % 4))
+          decoded = Base64.urlsafe_decode64(padded)
+          texts << decoded if decoded && decoded.valid_encoding?
+        rescue StandardError
+          nil
+        end
+        begin
+          decoded = Base64.decode64(str)
+          texts << decoded if decoded && decoded.valid_encoding?
+        rescue StandardError
+          nil
+        end
+
+        parsed = nil
+        texts.each do |txt|
+          t = txt.to_s.strip
+          next if t.empty?
+          if t.match?(/\A-?\d+\z/)
+            return resolve_id_only_cursor(t.to_i, ordering, context)
+          end
+          next unless t.start_with?("{", "[")
+          begin
+            parsed = JSON.parse(t)
+            break
+          rescue StandardError
+            next
+          end
+        end
+
+        raise InvalidCursorError, "Invalid cursor" if parsed.nil?
+
+        model = cursor_model_for(context)
+        values = nil
+        if parsed.is_a?(Array)
+          values = parsed
+        elsif parsed.is_a?(Hash)
+          if parsed["k"].is_a?(Array)
+            values = parsed["k"]
+          elsif parsed["keys"].is_a?(Array)
+            values = parsed["keys"]
+          elsif parsed["values"].is_a?(Array)
+            values = parsed["values"]
+          elsif ordering.all? { |col, _dir| parsed.key?(col) }
+            values = ordering.map { |col, _dir| parsed[col] }
+          elsif parsed.key?("id")
+            return resolve_id_only_cursor(parsed["id"], ordering, context)
+          else
+            raise InvalidCursorError, "Invalid cursor"
+          end
+        else
+          raise InvalidCursorError, "Invalid cursor"
+        end
+
+        unless values.is_a?(Array)
+          raise InvalidCursorError, "Invalid cursor"
+        end
+
+        if values.length != ordering.length
+          if values.length == 1 && ordering.any? { |col, _dir| col == "id" }
+            return resolve_id_only_cursor(values[0], ordering, context)
+          end
+          raise InvalidCursorError, "Invalid cursor"
+        end
+
+        if values.any? { |v| v.nil? || (v.is_a?(String) && v.empty?) }
+          raise InvalidCursorError, "Invalid cursor"
+        end
+
+        casted = values.each_with_index.map do |raw, idx|
+          cast_cursor_value(model, ordering[idx][0], raw)
+        end
+        raise InvalidCursorError, "Invalid cursor" if casted.any?(&:nil?)
+        casted
+      rescue InvalidCursorError
+        raise
+      rescue StandardError
+        raise InvalidCursorError, "Invalid cursor"
+      end
+
+      def cursor_operator(direction_in_order, browsing_direction)
+        if browsing_direction == :after
+          direction_in_order == :desc ? :lt : :gt
+        else
+          direction_in_order == :desc ? :gt : :lt
+        end
+      end
+
+      def apply_cursor_filter(scope, ordering, decoded, browsing_direction)
+        model = cursor_model_for(scope)
+        if decoded.is_a?(Hash) && decoded.key?("id_only")
+          id_value = decoded["id_only"]
+          pair = ordering.find { |col, _dir| col == "id" } || [ "id", :asc ]
+          op = cursor_operator(pair[1], browsing_direction) == :gt ? ">" : "<"
+          return scope.where("#{model ? model.table_name : scope.klass.table_name}.id #{op} ?", id_value)
+        end
+
+        raise InvalidCursorError, "Invalid cursor" unless model
+
+        table = model.arel_table
+        or_nodes = []
+        ordering.each_with_index do |(col, dir), idx|
+          op = cursor_operator(dir, browsing_direction)
+          node = table[col].public_send(op, decoded[idx])
+          idx.times do |j|
+            prev_col = ordering[j][0]
+            node = table[prev_col].eq(decoded[j]).and(node)
+          end
+          or_nodes << node
+        end
+        combined = or_nodes.reduce { |acc, node| acc.or(node) }
+        scope.where(combined)
+      end
+
+      def cursor_position_exists?(scope, ordering, record, browsing_direction)
+        return false unless record
+        model = cursor_model_for(scope)
+        values = ordering.map do |col, _dir|
+          cast_cursor_value(model, col, cursor_serialized_value(record_cursor_value(record, col)))
+        end
+        filtered = apply_cursor_filter(scope, ordering, values, browsing_direction)
+        begin
+          filtered.limit(1).exists?
+        rescue StandardError
+          filtered.limit(1).to_a.any?
+        end
+      rescue StandardError
+        false
+      end
+
+      def reorder_scope_by(scope, ordering)
+        order_hash = {}
+        ordering.each { |col, dir| order_hash[col.to_sym] = dir }
+        scope.reorder(order_hash)
+      end
+
+      def pagination_link_url(cursor, kind, per_page)
+        return nil if cursor.blank?
+        return nil unless respond_to?(:request) && request
+
+        qp = {}
+        begin
+          if request.respond_to?(:query_parameters) && request.query_parameters
+            request.query_parameters.each do |k, v|
+              next if %w[page per_page page_size limit after before after_cursor before_cursor cursor].include?(k.to_s)
+              qp[k.to_s] = v
+            end
+          end
+        rescue StandardError
+          qp = {}
+        end
+        qp["page"] = { kind.to_s => cursor, "size" => per_page.to_s }
+        query = qp.to_query
+        query.present? ? "#{request.path}?#{query}" : request.path
+      rescue StandardError
+        nil
+      end
+
+      def build_pagination_result(records, count, page_number, per_page, has_next, has_prev, has_more, ordering, next_page_val, previous_page_val)
+        after_cursor = nil
+        before_cursor = nil
+        if records.any?
+          after_cursor = encode_cursor_for_record(records.last, ordering)
+          before_cursor = encode_cursor_for_record(records.first, ordering)
+        else
+          has_more = false
+          has_next = false
+          has_prev = false
+        end
+
+        next_link = records.any? && has_next ? pagination_link_url(after_cursor, "after", per_page) : nil
+        prev_link = records.any? && has_prev ? pagination_link_url(before_cursor, "before", per_page) : nil
+
+        {
+          count: count,
+          page: page_number,
+          per_page: per_page,
+          next_page: next_page_val,
+          previous_page: previous_page_val,
+          meta: {
+            has_more: has_more,
+            after_cursor: after_cursor,
+            before_cursor: before_cursor
+          },
+          links: {
+            next: next_link,
+            prev: prev_link
+          }
+        }
+      end
+
+      def normalise_count(scope)
+        count = scope.count
+        count = count.size if count.is_a?(Hash)
+        count
+      rescue StandardError
+        begin
+          scope.to_a.size
+        rescue StandardError
+          0
+        end
+      end
+
+      def paginate_scope(scope)
+        parsed = parsed_pagination
+        page_number = parsed[:page]
+        per_page = parsed[:per_page]
+        after_str = parsed[:after]
+        before_str = parsed[:before]
+
+        original_order_values = nil
+        begin
+          original_order_values = scope.order_values if scope.respond_to?(:order_values)
+        rescue StandardError
+          original_order_values = nil
+        end
+        ordering = cursor_ordering_for(scope, original_order_values)
+
+        # Ensure the SQL ordering has the unique `id` tie-breaker that
+        # cursor comparisons rely on.
+        original_cols = []
+        Array(original_order_values).each do |ord|
+          begin
+            expr = ord.respond_to?(:expr) ? ord.expr : (ord.respond_to?(:value) ? ord.value : nil)
+            original_cols << expr.name.to_s.split(".").last if expr && expr.respond_to?(:name)
+          rescue StandardError
+            nil
+          end
+        end
+        if original_cols.any? && !original_cols.include?("id")
+          id_dir = ordering.find { |col, _dir| col == "id" }&.last || :asc
+          begin
+            scope = scope.order(id: id_dir)
+          rescue StandardError
+            nil
+          end
+        end
+
+        count = normalise_count(scope)
+
+        if after_str.present? || before_str.present?
+          browsing = (before_str.present? && after_str.blank?) ? :before : :after
+          cursor_str = browsing == :before ? before_str : after_str
+          decoded = decode_cursor(cursor_str, ordering, scope)
+          filtered = apply_cursor_filter(scope, ordering, decoded, browsing)
+
+          if browsing == :after
+            fetched = filtered.limit(per_page + 1).to_a
+            has_next = fetched.length > per_page
+            records = fetched.first(per_page)
+            has_prev = records.any? ? cursor_position_exists?(scope, ordering, records.first, :before) : false
+            has_more = has_next
+            next_page_val = has_next ? page_number + 1 : nil
+            previous_page_val = has_prev ? [ page_number - 1, 1 ].max : nil
+          else
+            reversed = ordering.map { |col, dir| [ col, dir == :desc ? :asc : :desc ] }
+            fetched = reorder_scope_by(filtered, reversed).limit(per_page + 1).to_a
+            has_prev = fetched.length > per_page
+            records = fetched.first(per_page).reverse
+            has_next = records.any? ? cursor_position_exists?(scope, ordering, records.last, :after) : false
+            has_more = has_prev
+            next_page_val = has_next ? page_number + 1 : nil
+            previous_page_val = has_prev ? [ page_number - 1, 1 ].max : nil
+          end
+
+          if records.empty?
+            meta = build_pagination_result(records, count, page_number, per_page, false, false, false, ordering, nil, (page_number > 1 ? page_number - 1 : nil))
+          else
+            meta = build_pagination_result(records, count, page_number, per_page, has_next, has_prev, has_more, ordering, next_page_val, previous_page_val)
+          end
+          [ records, meta ]
+        else
+          records = scope.offset((page_number - 1) * per_page).limit(per_page).to_a
+          has_next = page_number * per_page < count
+          has_prev = page_number > 1
+          next_page_val = has_next ? page_number + 1 : nil
+          previous_page_val = has_prev ? page_number - 1 : nil
+          meta = build_pagination_result(records, count, page_number, per_page, has_next, has_prev, has_next, ordering, next_page_val, previous_page_val)
+          [ records, meta ]
+        end
+      end
+
+      # Cursor / offset pagination for collections that have already been
+      # materialised as an Array (e.g. staff, filtered in Ruby).  Those
+      # collections are ordered by ID ascending.
+      def paginate_array(all_records)
+        parsed = parsed_pagination
+        page_number = parsed[:page]
+        per_page = parsed[:per_page]
+        after_str = parsed[:after]
+        before_str = parsed[:before]
+        ordering = [ [ "id", :asc ] ]
+        count = all_records.size
+        model = all_records.first ? all_records.first.class : nil
+
+        record_id = lambda do |record|
+          begin
+            record.id
+          rescue StandardError
+            record[:id] || record["id"]
+          end
+        end
+
+        if after_str.present? || before_str.present?
+          browsing = (before_str.present? && after_str.blank?) ? :before : :after
+          cursor_str = browsing == :before ? before_str : after_str
+          decoded = decode_cursor(cursor_str, ordering, model)
+          cursor_id = nil
+          if decoded.is_a?(Hash) && decoded.key?("id_only")
+            cursor_id = decoded["id_only"].to_i
+          elsif decoded.is_a?(Array)
+            cursor_id = decoded[0].to_i
+          else
+            raise InvalidCursorError, "Invalid cursor"
+          end
+
+          if browsing == :after
+            filtered = all_records.select { |r| (record_id.call(r) || 0).to_i > cursor_id }
+            records = filtered.first(per_page)
+            has_next = filtered.length > per_page
+            has_prev = records.any? ? all_records.any? { |r| (record_id.call(r) || 0).to_i < record_id.call(records.first).to_i } : false
+            has_more = has_next
+          else
+            filtered = all_records.select { |r| (record_id.call(r) || 0).to_i < cursor_id }
+            records = filtered.last(per_page)
+            has_prev = filtered.length > per_page
+            has_next = records.any? ? all_records.any? { |r| (record_id.call(r) || 0).to_i > record_id.call(records.last).to_i } : false
+            has_more = has_prev
+          end
+          next_page_val = has_next ? page_number + 1 : nil
+          previous_page_val = has_prev ? [ page_number - 1, 1 ].max : nil
+          if records.empty?
+            meta = build_pagination_result(records, count, page_number, per_page, false, false, false, ordering, nil, (page_number > 1 ? page_number - 1 : nil))
+          else
+            meta = build_pagination_result(records, count, page_number, per_page, has_next, has_prev, has_more, ordering, next_page_val, previous_page_val)
+          end
+          [ records, meta ]
+        else
+          records = all_records.slice((page_number - 1) * per_page, per_page) || []
+          has_next = page_number * per_page < count
+          has_prev = page_number > 1
+          next_page_val = has_next ? page_number + 1 : nil
+          previous_page_val = has_prev ? page_number - 1 : nil
+          meta = build_pagination_result(records, count, page_number, per_page, has_next, has_prev, has_next, ordering, next_page_val, previous_page_val)
+          [ records, meta ]
+        end
+      end
+
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..b26793a
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,52 @@
+module Api
+  module V1
+    class EmailVerificationsController < BaseController
+      # POST /api/v1/email_verifications  (request / resend)
+      def create
+        verification_params = params.require(:email_verification)
+        email = verification_params[:email].to_s.strip.downcase
+        if email.blank?
+          render_error("Email is required", :unprocessable_entity)
+          return
+        end
+
+        account = resolve_account_for_email(email)
+        unless account
+          # If a tenant header was supplied, resolve_account_for_email already rendered 404.
+          return if performed?
+          render_error("Account not found", :not_found)
+          return
+        end
+
+        user = account.users.find_by(email: email)
+        unless user
+          render_error("User not found", :not_found)
+          return
+        end
+
+        if user.verified?
+          render_error("Email is already verified", :unprocessable_entity)
+          return
+        end
+
+        token = user.generate_email_verification_token!
+        UserMailer.verification_email(user, token).deliver_now
+        render json: { message: "Verification email sent", user: user_json(user), account: account_json(account) }, status: :ok
+      end
+
+      # POST /api/v1/email_verifications/confirm
+      def confirm
+        verification_params = params.require(:email_verification)
+        token = verification_params[:token].to_s
+        user = User.find_by_email_verification_token(token)
+        unless user
+          render json: { error: "Invalid verification token", errors: ["Invalid verification token"] }, status: :unprocessable_entity
+          return
+        end
+
+        user.update!(verified_at: Time.current, email_verification_token_digest: nil)
+        render json: { user: user_json(user), account: account_json(user.account) }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/group_memberships_controller.rb b/app/controllers/api/v1/group_memberships_controller.rb
new file mode 100644
index 0000000..176a37f
--- /dev/null
+++ b/app/controllers/api/v1/group_memberships_controller.rb
@@ -0,0 +1,171 @@
+module Api
+  module V1
+    class GroupMembershipsController < BaseController
+      # POST /api/v1/group_memberships (admin only)
+      def create
+        return unless authenticate_and_require_active!
+        return unless require_admin!
+
+        membership_params = group_membership_params
+
+        group_id_raw = nil
+        user_id_raw = nil
+        if membership_params.respond_to?(:key?)
+          group_id_raw = membership_params[:group_id] if membership_params.key?(:group_id) || membership_params.key?("group_id")
+          group_id_raw = extract_id(membership_params[:group]) if group_id_raw.blank? && (membership_params.key?(:group) || membership_params.key?("group"))
+          user_id_raw = membership_params[:user_id] if membership_params.key?(:user_id) || membership_params.key?("user_id")
+          user_id_raw = extract_id(membership_params[:user]) if user_id_raw.blank? && (membership_params.key?(:user) || membership_params.key?("user"))
+          user_id_raw = membership_params[:member_id] if user_id_raw.blank? && (membership_params.key?(:member_id) || membership_params.key?("member_id"))
+        end
+
+        if group_id_raw.blank? || user_id_raw.blank?
+          errors = []
+          errors << "Group can't be blank" if group_id_raw.blank?
+          errors << "User can't be blank" if user_id_raw.blank?
+          details = {}
+          details[:group] = ["can't be blank"] if group_id_raw.blank?
+          details[:group_id] = ["can't be blank"] if group_id_raw.blank?
+          details[:user] = ["can't be blank"] if user_id_raw.blank?
+          details[:user_id] = ["can't be blank"] if user_id_raw.blank?
+          render json: { error: "Validation failed", errors: errors, details: details }, status: :unprocessable_entity
+          return
+        end
+
+        group = current_user.account.groups.find_by(id: group_id_raw)
+        unless group
+          render_error("Not found", :not_found)
+          return
+        end
+
+        user = current_user.account.users.find_by(id: user_id_raw)
+        unless user
+          render_error("Not found", :not_found)
+          return
+        end
+
+        if user.respond_to?(:customer?) && user.customer? || (user.respond_to?(:staff?) && !user.staff?)
+          render json: { error: "Validation failed", errors: ["User is not a staff member", "User must be a staff member"], details: { user: ["is not a staff member"], user_id: ["is not a staff member"] } }, status: :unprocessable_entity
+          return
+        end
+
+        # default flag: accept `default` or `is_default`
+        default_val = false
+        default_supplied = false
+        if membership_params.respond_to?(:key?)
+          if membership_params.key?(:default) || membership_params.key?("default")
+            default_val = ActiveModel::Type::Boolean.new.cast(membership_params[:default])
+            default_supplied = true
+          elsif membership_params.key?(:is_default) || membership_params.key?("is_default")
+            default_val = ActiveModel::Type::Boolean.new.cast(membership_params[:is_default])
+            default_supplied = true
+          end
+        end
+        default_val = false if default_val.nil?
+
+        membership = GroupMembership.new(
+          account: current_user.account,
+          group: group,
+          user: user,
+          default: default_val
+        )
+
+        unless membership.save
+          validation_error(membership)
+          return
+        end
+
+        render json: { group_membership: group_membership_json(membership.reload) }, status: :created
+      end
+
+      # GET /api/v1/group_memberships (staff)
+      def index
+        return unless authenticate_and_require_active!
+        return unless require_staff!
+
+        scope = GroupMembership.where(account_id: current_user.account_id).order(id: :asc)
+        # Fallback if any membership lacks account_id (created via group only): also include via groups
+        # The where above is primary; memberships are always backfilled from group, so this is sufficient.
+        if params[:group_id].present?
+          scope = scope.where(group_id: params[:group_id].to_s.strip)
+        end
+        if params[:user_id].present?
+          scope = scope.where(user_id: params[:user_id].to_s.strip)
+        end
+        records, meta = paginate_scope(scope.includes(:group, :user))
+        render json: { group_memberships: records.map { |m| group_membership_json(m) } }.merge(meta), status: :ok
+      end
+
+      # GET /api/v1/group_memberships/:id (staff)
+      def show
+        return unless authenticate_and_require_active!
+        return unless require_staff!
+
+        membership = find_account_membership
+        return unless membership
+        render json: { group_membership: group_membership_json(membership) }, status: :ok
+      end
+
+      # DELETE /api/v1/group_memberships/:id (admin only)
+      def destroy
+        return unless authenticate_and_require_active!
+        return unless require_admin!
+
+        membership = find_account_membership
+        return unless membership
+
+        rendered = group_membership_json(membership)
+        # Model callbacks clear invalid ticket assignments and promote
+        # another default if needed.
+        membership.destroy
+        render json: { group_membership: rendered }, status: :ok
+      end
+
+      # PUT/PATCH /api/v1/group_memberships/:id/make_default (admin only)
+      def make_default
+        return unless authenticate_and_require_active!
+        return unless require_admin!
+
+        membership = find_account_membership
+        return unless membership
+
+        begin
+          membership.make_default!
+        rescue ActiveRecord::RecordInvalid => e
+          validation_error(e.record)
+          return
+        end
+
+        render json: { group_membership: group_membership_json(membership.reload) }, status: :ok
+      end
+
+      private
+
+      def extract_id(value)
+        return value if value.is_a?(Integer) || value.is_a?(String) || value.is_a?(Numeric)
+        if value.respond_to?(:key?)
+          return value[:id] if value.key?(:id) || value.key?("id")
+        end
+        nil
+      end
+
+      def group_membership_params
+        raw = params[:group_membership] || params[:membership]
+        unless raw.present?
+          raise ActionController::ParameterMissing.new(:group_membership, :group_membership)
+        end
+        raw
+      end
+
+      def find_account_membership
+        membership = GroupMembership.where(account_id: current_user.account_id).find_by(id: params[:id])
+        # Fallback via group account in case account_id was not backfilled
+        membership ||= GroupMembership.joins(:group).where(groups: { account_id: current_user.account_id }).find_by(id: params[:id])
+        unless membership
+          render_error("Not found", :not_found)
+          return nil
+        end
+        membership
+      end
+    end
+  end
+end
