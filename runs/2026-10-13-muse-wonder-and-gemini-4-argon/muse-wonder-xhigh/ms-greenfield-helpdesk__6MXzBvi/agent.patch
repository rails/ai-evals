+          rescue StandardError
+            %w[size per_page limit count number page after before after_cursor before_cursor cursor].each do |k|
+              begin
+                page_hash[k] = raw_page[k] if raw_page.key?(k)
+              rescue StandardError
+                nil
+              end
+            end
+          end
+        end
+
+        top = lambda do |key|
+          begin
+            params[key]
+          rescue StandardError
+            nil
+          end
+        end
+
+        first_present = lambda do |values|
+          found = nil
+          values.each do |v|
+            if v.present?
+              found = v
+              break
+            end
+          end
+          found
+        end
+
+        after_val = first_present.call([
+          page_hash["after"], page_hash["after_cursor"],
+          top.call(:after), top.call(:after_cursor),
+          page_hash["cursor"], top.call(:cursor)
+        ])
+        before_val = first_present.call([
+          page_hash["before"], page_hash["before_cursor"],
+          top.call(:before), top.call(:before_cursor)
+        ])
+        size_val = first_present.call([
+          page_hash["size"], page_hash["per_page"], page_hash["limit"],
+          top.call(:per_page), top.call(:page_size), top.call(:limit),
+          page_hash["count"]
+        ])
+
+        page_number = 1
+        if raw_page.respond_to?(:key?)
+          if page_hash["number"].present?
+            page_number = page_hash["number"].to_i
+          elsif page_hash["page"].present?
+            page_number = page_hash["page"].to_i
+          end
+        elsif raw_page.present?
+          page_number = raw_page.to_i
+        end
+        page_number = 1 if page_number < 1
+
+        per_page = 25
+        if size_val.present?
+          per_page = size_val.to_i
+          per_page = 25 if per_page < 1
+          per_page = 1000 if per_page > 1000
+        end
