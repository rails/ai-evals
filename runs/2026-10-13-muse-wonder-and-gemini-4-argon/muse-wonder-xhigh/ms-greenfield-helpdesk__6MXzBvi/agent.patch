+          rescue StandardError
+            col = nil
+          end
+          next if col.blank?
+          # Strip any table prefix, keep bare column name.
+          col = col.split(".").last.to_s
+          ordering << [ col, dir ]
+        end
+        model = cursor_model_for(context)
+        if model && model.respond_to?(:column_names)
+          ordering = ordering.select { |col, _dir| model.column_names.include?(col) }
+        end
+        ordering = [ [ "id", :asc ] ] if ordering.empty?
+        unless ordering.any? { |col, _dir| col == "id" }
