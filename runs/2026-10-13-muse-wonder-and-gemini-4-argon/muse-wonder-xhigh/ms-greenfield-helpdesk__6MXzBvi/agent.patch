diff --git a/app/mailers/ticket_mailer.rb b/app/mailers/ticket_mailer.rb
new file mode 100644
index 0000000..4ee8f18
--- /dev/null
+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,25 @@
+class TicketMailer < ApplicationMailer
+  # Email a staff member's public reply on an email-origin ticket to the
+  # requester. The per-ticket reply address is used as both From and
+  # Reply-To so a reply from the customer's mail client comes back to
+  # this conversation (and to no other ticket / business).
+  def reply_email(ticket, comment)
+    @ticket = ticket
+    @comment = comment
+    @account = ticket.account
+    @requester = ticket.requester
+    @reply_address = ticket.reply_address
+    @support_address = @reply_address
+
+    subject = ticket.subject.to_s.strip
+    subject = "Ticket" if subject.blank?
+    email_subject = subject.match?(/\A\s*re\s*:/i) ? subject : "Re: #{subject}"
+
+    mail(
+      to: @requester.email,
+      from: @reply_address,
+      reply_to: @reply_address,
+      subject: email_subject
+    )
+  end
+end
diff --git a/app/mailers/user_mailer.rb b/app/mailers/user_mailer.rb
new file mode 100644
index 0000000..deffb42
--- /dev/null
+++ b/app/mailers/user_mailer.rb
@@ -0,0 +1,33 @@
+class UserMailer < ApplicationMailer
+  def verification_email(user, token)
+    @user = user
+    @account = user.account
+    @token = token
+    @url = "#{frontend_url}/verify-email?account=#{@account.subdomain}&token=#{token}"
+    @verification_url = @url
+    mail(to: @user.email, from: mail_from, subject: "Verify your email")
+  end
+
+  def invitation_email(invitation, token)
+    @invitation = invitation
+    @account = invitation.account
+    @email = invitation.email
+    @role = invitation.role
+    @token = token
+    @url = "#{frontend_url}/accept-invitation?account=#{@account.subdomain}&token=#{token}"
+    @invitation_url = @url
+    @accept_url = @url
+    @accept_invitation_url = @url
+    mail(to: @invitation.email, from: mail_from, subject: "You've been invited to join #{@account.name}")
+  end
+
+  def password_reset_email(user, token)
+    @user = user
+    @account = user.account
+    @token = token
+    @url = "#{frontend_url}/reset-password?account=#{@account.subdomain}&token=#{token}"
+    @reset_url = @url
+    @password_reset_url = @url
+    mail(to: @user.email, from: mail_from, subject: "Reset your password")
+  end
+end
diff --git a/app/models/account.rb b/app/models/account.rb
new file mode 100644
index 0000000..bc86ab0
--- /dev/null
+++ b/app/models/account.rb
@@ -0,0 +1,73 @@
+class Account < ApplicationRecord
+  has_many :users, dependent: :destroy
+  has_many :tickets, dependent: :destroy
+  has_many :invitations, dependent: :destroy
+  has_many :groups, dependent: :destroy
+  has_many :group_memberships, dependent: :destroy
+
+  before_validation :normalize_subdomain
+
+  validates :name, presence: true
+  validates :subdomain, presence: true,
+            format: { with: /\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/, message: "is invalid" },
+            uniqueness: { case_sensitive: false }
+
+  scope :cancelled_expired, ->(cutoff = 90.days.ago) { where.not(cancelled_at: nil).where(cancelled_at: ..cutoff) }
+
+  def support_email_address
+    Ticket.support_address_for_account(self)
+  end
+  alias support_address support_email_address
+
+  def cancelled?
+    cancelled_at.present?
+  end
+  alias canceled? cancelled?
+
+  def active?
+    !cancelled?
+  end
+
+  def status
+    cancelled? ? "cancelled" : "active"
+  end
+
+  # Compatibility setters so the record can also be built with
+  # `status: "cancelled"`, `cancelled: true` or the US spelling `canceled_at:`.
+  def status=(value)
+    case value.to_s
+    when "cancelled", "canceled"
+      self.cancelled_at ||= Time.current
+    when "active"
+      self.cancelled_at = nil
+    end
+  end
+
+  def cancelled=(value)
+    bool = ActiveModel::Type::Boolean.new.cast(value)
+    self.cancelled_at = bool ? (cancelled_at || Time.current) : nil
+  end
+  alias canceled= cancelled=
+
+  def canceled_at
+    cancelled_at
+  end
+
+  def canceled_at=(value)
+    self.cancelled_at = value
+  end
+
+  def cancel!
+    update!(cancelled_at: Time.current)
+  end
+
+  def reactivate!
+    update!(cancelled_at: nil)
+  end
+
+  private
+
+  def normalize_subdomain
+    self.subdomain = subdomain.to_s.strip.downcase if subdomain
+  end
+end
