diff --git a/app/controllers/api/v1/invitation_acceptances_controller.rb b/app/controllers/api/v1/invitation_acceptances_controller.rb
new file mode 100644
index 0000000..5325a04
--- /dev/null
+++ b/app/controllers/api/v1/invitation_acceptances_controller.rb
@@ -0,0 +1,73 @@
+module Api
+  module V1
+    class InvitationAcceptancesController < BaseController
+      # POST /api/v1/invitation_acceptances
+      def create
+        accept_params = params[:invitation_acceptance] || params[:invitation] || params[:acceptance]
+        accept_params = params if accept_params.blank? && params[:token].present?
+        unless accept_params.present?
+          raise ActionController::ParameterMissing.new(:invitation_acceptance, :invitation_acceptance)
+        end
+        token = accept_params[:token].to_s
+        invitation = Invitation.find_by_token(token)
+        unless invitation
+          render json: { error: "Invalid invitation token", errors: ["Invalid invitation token"] }, status: :unprocessable_entity
+          return
+        end
+
+        if invitation.status == "revoked"
+          render json: { error: "Invitation has been revoked", errors: ["Invitation has been revoked"] }, status: :unprocessable_entity
+          return
+        end
+        if invitation.status == "accepted"
+          render json: { error: "Invitation has already been accepted", errors: ["Invitation has already been accepted"] }, status: :unprocessable_entity
+          return
+        end
+        if invitation.effective_status == "expired"
+          invitation.update!(status: "expired") if invitation.status != "expired"
+          render json: { error: "Invitation has expired", errors: ["Invitation has expired"] }, status: :unprocessable_entity
+          return
+        end
+
+        account = invitation.account
+        if account.cancelled?
+          render_error("Account is cancelled", :forbidden)
+          return
+        end
+
+        # If a user with that email already exists, cannot accept again
+        if account.users.where("LOWER(email) = ?", invitation.email.to_s.downcase).exists?
+          render json: { error: "Validation failed", errors: ["Email has already been taken"], details: { email: ["has already been taken"] } }, status: :unprocessable_entity
+          return
+        end
+
+        user = nil
+        begin
+          Invitation.transaction do
+            user = account.users.build(
+              name: accept_params[:name]&.to_s,
+              email: invitation.email,
+              password: accept_params[:password].to_s,
+              password_confirmation: (accept_params[:password_confirmation] if accept_params.respond_to?(:key?) && (accept_params.key?(:password_confirmation) || accept_params.key?("password_confirmation"))),
+              role: invitation.role,
+              owner: false,
+              verified_at: Time.current
+            )
+            # has_secure_password: if password_confirmation was nil we should not force mismatch
+            if accept_params.respond_to?(:key?) && !(accept_params.key?(:password_confirmation) || accept_params.key?("password_confirmation"))
+              user.password_confirmation = nil
+            end
+            user.suspended = false if user.respond_to?(:suspended=)
+            user.save!
+            invitation.update!(status: "accepted", accepted_at: Time.current, accepted_user: user, token_digest: nil)
+          end
+        rescue ActiveRecord::RecordInvalid => e
+          validation_error(e.record)
+          return
+        end
+
+        render json: { user: user_json(user), account: account_json(account), invitation: invitation_json(invitation.reload) }, status: :created
+      end
+    end
+  end
+end
