diff --git a/app/views/moderate/games/_screen.html.erb b/app/views/moderate/games/_screen.html.erb
new file mode 100644
index 0000000..4e3e627
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,53 @@
+<% if @game.finished? %>
+  <div class="screen__body">
+    <div class="screen__kicker"><%= @quiz.title %></div>
+    <h1>The quiz is over</h1>
+  </div>
+<% elsif @game.lobby? %>
+  <div class="screen__body">
+    <div class="lobby">
+      <div>
+        <h1 class="lobby__title"><%= @quiz.title %></h1>
+        <div class="lobby__join">Join at</div>
+        <div class="lobby__url"><%= @join_link_text %></div>
+        <div><span class="counter-pill">Players: <%= @players_count %></span></div>
+      </div>
+      <div class="qr" aria-label="QR code for the join link"><%= qr_code_svg(@join_url) %></div>
+    </div>
+  </div>
+<% elsif @current_question %>
+  <div class="screen__body screen__body--top">
+    <div class="stage-question__num">Question <%= @game.current_index + 1 %> of <%= @total %></div>
+    <div class="stage-question__body"><%= @current_question.body %></div>
+
+    <% if @game.question_open? %>
+      <ul class="stage-options">
+        <% @current_options.each_with_index do |option, oi| %>
+          <li class="stage-option">
+            <span class="stage-option__letter"><%= ("A".ord + oi).chr %></span>
+            <span class="stage-option__title"><%= option.body %></span>
+          </li>
+        <% end %>
+      </ul>
+      <p class="answers-counter mt-2">Answers: <%= @answered_count %> / <%= @players_count %></p>
+    <% else %>
+      <ul class="stage-options stage-options--results">
+        <% @current_options.each_with_index do |option, oi| %>
+          <% count = @answer_counts[option.id] || 0 %>
+          <li class="stage-option <%= 'is-correct' if option.correct? %>">
+            <span class="stage-option__letter"><%= ("A".ord + oi).chr %></span>
+            <span class="stage-option__title"><%= option.body %></span>
+            <span class="stage-option__count"><%= count %></span>
+            <% if option.correct? %><span class="stage-option__mark">Correct</span><% end %>
+          </li>
+        <% end %>
+      </ul>
+      <p class="answers-counter mt-2">Answers: <%= @answered_count %> / <%= @players_count %></p>
+    <% end %>
+  </div>
+<% else %>
+  <div class="screen__body">
+    <h1><%= @quiz.title %></h1>
+    <p>No active questions</p>
+  </div>
+<% end %>
diff --git a/app/views/moderate/games/show.html.erb b/app/views/moderate/games/show.html.erb
