+<% if @game.finished? %>
+  <div class="play__body">
+    <div class="result-card">
+      <h1 class="play-title">The quiz is over</h1>
+      <p class="play-lead"><%= @quiz.title %></p>
+    </div>
+  </div>
+<% elsif @current_player.nil? %>
+  <div class="play__body">
+    <h1 class="play-title"><%= @quiz.title %></h1>
+    <% if @join_error.present? %>
+      <div class="errors"><%= @join_error %></div>
+    <% end %>
+    <%= form_with url: join_play_path(code: @game.code), method: :post, data: { turbo: false }, class: "join-form" do %>
+      <div class="field">
+        <label for="player_name">Your name</label>
+        <input type="text" name="player[name]" id="player_name" class="input" placeholder="Your name" value="<%= @entered_name %>" autocomplete="name" required>
+      </div>
+      <button type="submit" class="btn btn--pink">Join</button>
+    <% end %>
+  </div>
+<% else %>
+  <div class="play__body play__body--top">
+    <p class="play-lead">Hi, <%= @current_player.name %>!</p>
+
+    <% if @game.lobby? %>
+      <div class="waiting mt-2">
+        <div class="waiting__gem">?</div>
+        <p>Waiting for the quiz to start</p>
+      </div>
+    <% elsif @game.question_open? && @current_question %>
+      <div class="play-question__num">Question <%= @game.current_index + 1 %> of <%= @total %></div>
+      <div class="play-question__body"><%= @current_question.body %></div>
+      <%= form_with url: answer_play_path(code: @game.code), method: :post, data: { turbo: false } do %>
+        <div class="play-options">
+          <% @current_options.each_with_index do |option, oi| %>
+            <% picked = @my_answer && @my_answer.option_id == option.id %>
+            <button type="submit" name="option_id" value="<%= option.id %>" class="play-option <%= 'is-picked' if picked %>" aria-label="<%= option.body %>">
+              <span class="play-option__letter"><%= ("A".ord + oi).chr %></span>
+              <span class="play-option__title"><%= option.body %></span>
+              <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+            </button>
+          <% end %>
+        </div>
+      <% end %>
+    <% elsif @game.question_closed? && @current_question %>
+      <% if @my_answer.nil? %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% elsif @my_answer.option.correct? %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% else %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% end %>
+
+      <div class="play-question__num mt-2">Question <%= @game.current_index + 1 %> of <%= @total %></div>
+      <div class="play-question__body"><%= @current_question.body %></div>
+      <div class="play-options">
+        <% @current_options.each_with_index do |option, oi| %>
+          <% picked = @my_answer && @my_answer.option_id == option.id %>
+          <div class="play-option <%= 'is-correct' if option.correct? %> <%= 'is-picked' if picked %>">
+            <span class="play-option__letter"><%= ("A".ord + oi).chr %></span>
+            <span class="play-option__title"><%= option.body %></span>
+            <% if option.correct? %><span class="play-option__mark">Correct</span><% end %>
+            <% if picked %><span class="play-option__mark">Your answer</span><% end %>
+          </div>
+        <% end %>
+      </div>
+    <% else %>
+      <p>Waiting for the quiz to start</p>
+    <% end %>
+  </div>
+<% end %>
