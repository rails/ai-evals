+<main class="screen">
+  <div class="screen__top">
+    <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+    <span><%= @quiz.title %></span>
+  </div>
+
+  <% screen_html = render(partial: "moderate/games/screen") %>
+  <div id="live-content" data-live-url="<%= live_moderate_game_path(@game) %>" data-live-version="<%= @live_version %>"><%= screen_html %></div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "Back to quiz", moderate_quiz_path(@quiz) %>
+    </div>
+    <div class="buttons">
+      <% if @game.lobby? %>
+        <%= form_with url: start_moderate_game_path(@game), method: :post, data: { turbo: false } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Start</button>
+        <% end %>
+      <% elsif @game.question_open? %>
+        <%= form_with url: finish_moderate_game_path(@game), method: :post, data: { turbo: false } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Finish</button>
+        <% end %>
+      <% elsif @game.question_closed? %>
+        <%= form_with url: next_moderate_game_path(@game), method: :post, data: { turbo: false } do %>
+          <% if @game.last_question? %>
+            <button type="submit" class="btn btn--pink btn--lg">End quiz</button>
+          <% else %>
+            <button type="submit" class="btn btn--pink btn--lg">Next</button>
+          <% end %>
+        <% end %>
+      <% elsif @game.finished? %>
+        <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn btn--ghost btn--lg" %>
+      <% end %>
+    </div>
+  </div>
+</main>
+<script><%= live_poll_script %></script>
