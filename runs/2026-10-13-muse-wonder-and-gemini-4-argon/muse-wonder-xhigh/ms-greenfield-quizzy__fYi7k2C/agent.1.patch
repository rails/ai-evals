diff --git a/app/views/moderate/questions/_form.html.erb b/app/views/moderate/questions/_form.html.erb
new file mode 100644
index 0000000..b9032d1
--- /dev/null
+++ b/app/views/moderate/questions/_form.html.erb
@@ -0,0 +1,89 @@
+<% if @question.errors.any? %>
+  <div class="errors">
+    <ul>
+      <% @question.errors.full_messages.each do |msg| %>
+        <li><%= msg %></li>
+      <% end %>
+    </ul>
+  </div>
+<% end %>
+
+<%= form_with model: [:moderate, @quiz, @question], id: "question-form" do |f| %>
+  <div class="field">
+    <%= f.label :body, "Question" %>
+    <%= f.text_area :body, class: "input", rows: 3 %>
+  </div>
+
+  <div class="field">
+    <span class="field-label">Options</span>
+    <span class="field-hint">Mark the correct options, at least one. Empty rows are skipped.</span>
+  </div>
+
+  <% rows = (@form_option_rows || []).dup %>
+  <% rows << { "body" => "", "correct" => false } while rows.size < 4 %>
+  <div class="option-rows" id="option-rows">
+    <% rows.each_with_index do |row, i| %>
+      <% num = i + 1 %>
+      <% body_val = row.is_a?(Hash) ? (row["body"] || row[:body]) : "" %>
+      <% correct_val = row.is_a?(Hash) ? (row["correct"] || row[:correct]) : false %>
+      <% correct_checked = %w[1 true on].include?(correct_val.to_s) || correct_val == true %>
+      <div class="option-row">
+        <div class="field" style="margin-bottom:0">
+          <label for="option-<%= num %>-text">Option <%= num %></label>
+          <input class="input" type="text" id="option-<%= num %>-text" name="question[options][<%= i %>][body]" value="<%= ERB::Util.html_escape(body_val.to_s) %>">
+        </div>
+        <label class="checkbox" for="option-<%= num %>-correct">
+          <input type="hidden" name="question[options][<%= i %>][correct]" value="0">
+          <input type="checkbox" id="option-<%= num %>-correct" name="question[options][<%= i %>][correct]" value="1" <%= 'checked' if correct_checked %>>
+          Option <%= num %> is correct
+        </label>
+      </div>
+    <% end %>
+  </div>
+
+  <div class="buttons" style="margin-bottom: 28px">
+    <button type="button" class="btn btn--ghost btn--sm" id="add-option-button">Add option</button>
+  </div>
+
+  <div class="field">
+    <label class="checkbox" for="question_active">
+      <%= f.check_box :active, id: "question_active" %>
+      Active
+    </label>
+    <span class="field-hint">Only active questions are played.</span>
+  </div>
+
+  <div class="buttons">
+    <%= f.submit "Save question", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+  </div>
+<% end %>
+
+<script>
+  (function() {
+    var addButton = document.getElementById('add-option-button');
+    var container = document.getElementById('option-rows');
+    if (!addButton || !container) return;
+    addButton.addEventListener('click', function() {
+      var count = container.querySelectorAll('.option-row').length;
+      var num = count + 1;
+      var index = count; // 0-based index for param name, next after existing rows
+      // If existing rows use non-sequential indexes (should not happen), using count keeps it sequential in practice
+      var row = document.createElement('div');
+      row.className = 'option-row';
+      row.innerHTML =
+        '<div class="field" style="margin-bottom:0">' +
+          '<label for="option-' + num + '-text">Option ' + num + '</label>' +
+          '<input class="input" type="text" id="option-' + num + '-text" name="question[options][' + index + '][body]" value="">' +
+        '</div>' +
+        '<label class="checkbox" for="option-' + num + '-correct">' +
+          '<input type="hidden" name="question[options][' + index + '][correct]" value="0">' +
+          '<input type="checkbox" id="option-' + num + '-correct" name="question[options][' + index + '][correct]" value="1">' +
+          ' Option ' + num + ' is correct' +
+        '</label>';
+      container.appendChild(row);
+      var input = row.querySelector('input[type="text"]');
+      if (input) input.focus();
+    });
+  })();
+</script>
