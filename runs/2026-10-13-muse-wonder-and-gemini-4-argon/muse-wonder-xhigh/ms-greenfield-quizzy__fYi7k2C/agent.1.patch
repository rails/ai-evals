diff --git a/test/models/quiz_test.rb b/test/models/quiz_test.rb
new file mode 100644
index 0000000..87ba0d1
--- /dev/null
+++ b/test/models/quiz_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class QuizTest < ActiveSupport::TestCase
+  test "title is required" do
+    assert_not Quiz.new(title: "").valid?
+  end
+
+  test "question needs two options and a correct one" do
+    quiz = Quiz.create!(title: "Q")
+    question = quiz.questions.new(body: "Pick?", active: true)
+    question.options.build(body: "Only", correct: true)
+    assert_not question.valid?
+    assert_includes question.errors.full_messages, "Add at least two options"
+
+    question.options.build(body: "Second", correct: false)
+    assert question.valid?
+
+    question.options.each { |o| o.correct = false }
+    assert_not question.valid?
+    assert_includes question.errors.full_messages, "Mark at least one option as correct"
+  end
+end
