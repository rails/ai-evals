+
+  <section class="section mt-0">
+    <div class="section-head">
+      <h2>Questions</h2>
+      <%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %>
+    </div>
+
+    <% if @questions.any? %>
+      <ul class="question-list">
+        <% @questions.each_with_index do |question, idx| %>
+          <li class="card question-item <%= 'question-item--inactive' unless question.active? %>" id="question-<%= question.id %>">
+            <div class="question-item__num"><%= question.active? ? (@questions.select(&:active?).index(question) + 1 rescue idx + 1) : "—" %></div>
+            <div>
+              <div class="question-item__body"><%= question.body %></div>
+              <ul class="question-item__options">
+                <% question.options.each_with_index do |option, oi| %>
+                  <li class="<%= 'is-correct' if option.correct? %>"><%= ("A".ord + oi).chr %>. <%= option.body %></li>
+                <% end %>
+              </ul>
+            </div>
+            <div class="question-item__actions">
+              <div class="buttons">
+                <%= form_with url: move_up_moderate_quiz_question_path(@quiz, question), method: :post, html: { class: "inline-form" } do %>
+                  <button type="submit" class="btn btn--ghost btn--sm">Move up</button>
+                <% end %>
+                <%= form_with url: move_down_moderate_quiz_question_path(@quiz, question), method: :post, html: { class: "inline-form" } do %>
+                  <button type="submit" class="btn btn--ghost btn--sm">Move down</button>
+                <% end %>
+              </div>
+
+              <%= form_with url: toggle_active_moderate_quiz_question_path(@quiz, question), method: :patch, html: { class: "inline-form active-toggle-form", data: { question_id: question.id } } do %>
+                <input type="hidden" name="question[active]" value="0">
+                <label class="checkbox" for="question-<%= question.id %>-active">
+                  <input type="checkbox" id="question-<%= question.id %>-active" name="question[active]" value="1" <%= 'checked' if question.active? %>>
+                  Active
+                </label>
+              <% end %>
+
+              <div class="buttons">
+                <%= link_to "Edit", edit_moderate_quiz_question_path(@quiz, question), class: "btn btn--sm" %>
+                <%= form_with url: moderate_quiz_question_path(@quiz, question), method: :delete, html: { class: "inline-form", onsubmit: "return confirm('Delete this question?')" } do %>
+                  <button type="submit" class="btn btn--sm btn--danger">Delete</button>
+                <% end %>
+              </div>
+            </div>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <div class="empty">No questions yet.</div>
+    <% end %>
+  </section>
+</main>
+<script>
+  document.querySelectorAll('.active-toggle-form input[type="checkbox"]').forEach(function(cb) {
+    cb.addEventListener('change', function() {
+      cb.form.requestSubmit ? cb.form.requestSubmit() : cb.form.submit();
+    });
+  });
+</script>
