diff --git a/app/views/moderate/quizzes/preview.html.erb b/app/views/moderate/quizzes/preview.html.erb
new file mode 100644
index 0000000..d161409
--- /dev/null
+++ b/app/views/moderate/quizzes/preview.html.erb
@@ -0,0 +1,94 @@
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← #{@quiz.title}", moderate_quiz_path(@quiz) %></div>
+
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= @quiz.title %></span>
+    </div>
+
+    <% if @total.zero? %>
+      <div class="play__body">
+        <div class="play-question__body">No active questions</div>
+        <p class="muted">Add or activate questions to preview this quiz.</p>
+        <div class="buttons mt-2">
+          <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+        </div>
+      </div>
+    <% elsif @finished %>
+      <div class="play__body">
+        <div class="result-card">
+          <div class="result-card__score">Score: <%= @score %>/<%= @total %></div>
+          <div class="buttons mt-2" style="justify-content:center">
+            <%= form_with url: preview_moderate_quiz_path(@quiz), method: :get, html: { class: "inline-form" } do %>
+              <button type="submit" class="btn btn--pink">Start over</button>
+            <% end %>
+            <%= link_to "Back to quiz", moderate_quiz_path(@quiz), class: "btn btn--ghost" %>
+          </div>
+        </div>
+      </div>
+    <% else %>
+      <div class="play__body play__body--top">
+        <div class="play-question__num">Question <%= @index + 1 %> of <%= @total %></div>
+        <div class="play-question__body"><%= @question.body %></div>
+
+        <% if @picked_option %>
+          <div class="play-options is-revealed">
+            <% @question.options.each_with_index do |option, oi| %>
+              <div class="play-option <%= 'is-correct' if option.correct? %> <%= 'is-picked' if option.id == @picked_option.id %>">
+                <span class="play-option__letter"><%= ("A".ord + oi).chr %></span>
+                <span class="play-option__title"><%= option.body %></span>
+                <% if option.correct? %><span class="play-option__mark">Correct</span><% end %>
+              </div>
+            <% end %>
+          </div>
+
+          <% if @picked_correct %>
+            <div class="play-status play-status--right">Correct!</div>
+          <% else %>
+            <div class="play-status play-status--wrong">Wrong!</div>
+          <% end %>
+
+          <div class="buttons mt-2">
+            <% if @index + 1 < @total %>
+              <%= form_with url: preview_moderate_quiz_path(@quiz), method: :get, html: { class: "inline-form" } do %>
+                <input type="hidden" name="index" value="<%= @index + 1 %>">
+                <input type="hidden" name="score" value="<%= @score %>">
+                <button type="submit" class="btn btn--pink">Next question</button>
+              <% end %>
+            <% else %>
+              <%= form_with url: preview_moderate_quiz_path(@quiz), method: :get, html: { class: "inline-form" } do %>
+                <input type="hidden" name="finished" value="1">
+                <input type="hidden" name="score" value="<%= @score %>">
+                <button type="submit" class="btn btn--pink">See score</button>
+              <% end %>
+            <% end %>
+
+            <%= form_with url: preview_moderate_quiz_path(@quiz), method: :get, html: { class: "inline-form" } do %>
+              <button type="submit" class="btn btn--ghost">Start over</button>
+            <% end %>
+          </div>
+        <% else %>
+          <%= form_with url: preview_moderate_quiz_path(@quiz), method: :get do %>
+            <input type="hidden" name="index" value="<%= @index %>">
+            <input type="hidden" name="score" value="<%= @score_before %>">
+            <div class="play-options">
+              <% @question.options.each_with_index do |option, oi| %>
+                <button type="submit" name="picked" value="<%= option.id %>" class="play-option" aria-label="<%= option.body %>">
+                  <span class="play-option__letter"><%= ("A".ord + oi).chr %></span>
+                  <span class="play-option__title"><%= option.body %></span>
+                </button>
+              <% end %>
+            </div>
+          <% end %>
+
+          <div class="buttons mt-2">
+            <%= form_with url: preview_moderate_quiz_path(@quiz), method: :get, html: { class: "inline-form" } do %>
+              <button type="submit" class="btn btn--ghost">Start over</button>
+            <% end %>
+          </div>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+</main>
