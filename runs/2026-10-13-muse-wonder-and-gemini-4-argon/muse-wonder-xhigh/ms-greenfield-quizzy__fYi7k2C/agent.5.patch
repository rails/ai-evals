@@ -44,3 +44,64 @@
   </div>
 </main>
 <script><%= live_poll_script %></script>
+<script>
+(function() {
+  // Countdown for the moderator's big screen only. The deadline is
+  // supplied by the server (opened_at + timer duration), so reloading
+  // the page re-reads the same deadline and never restarts the timer.
+  // This script sits outside #live-content, therefore it survives the
+  // polling swaps of the screen fragment and remembers a deadline even
+  // after the server has already closed the question in the fragment.
+  var submitted = false;
+  var deadlineMs = null;
+  var sawTimer = false;
+
+  function format(totalSeconds) {
+    var s = Math.max(0, totalSeconds);
+    var m = Math.floor(s / 60);
+    var r = s % 60;
+    return m + ":" + (r < 10 ? "0" : "") + r;
+  }
+
+  function finishQuestion() {
+    if (submitted) return;
+    submitted = true;
+    var form = document.getElementById("finish-question-form") ||
+      document.querySelector('form[action$="/finish"]');
+    if (form) {
+      if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
+      return;
+    }
+    // Fallback (controls were swapped away): POST Finish directly,
+    // with the page's CSRF token, then reload to the closed state.
+    var tokenMeta = document.querySelector('meta[name="csrf-token"]');
+    var headers = { "X-Requested-With": "XMLHttpRequest" };
+    if (tokenMeta) headers["X-CSRF-Token"] = tokenMeta.getAttribute("content");
+    fetch("<%= finish_moderate_game_path(@game) %>", {
+      method: "POST", headers: headers, credentials: "same-origin", cache: "no-store"
+    }).then(function() { window.location.reload(); }, function() { window.location.reload(); });
+  }
+
+  function tick() {
+    var el = document.querySelector("[data-timer-deadline-ms]");
+    if (el) {
+      var parsed = parseInt(el.getAttribute("data-timer-deadline-ms"), 10);
+      if (!isNaN(parsed)) {
+        deadlineMs = parsed;
+        sawTimer = true;
+      }
+      if (deadlineMs) {
+        el.textContent = format(Math.ceil((deadlineMs - Date.now()) / 1000));
+      }
+    }
+    if (sawTimer && deadlineMs && Date.now() >= deadlineMs) {
+      var timerEl = document.querySelector("[data-timer-deadline-ms]");
+      if (timerEl) timerEl.textContent = "0:00";
+      finishQuestion();
+    }
+  }
+
+  tick();
+  setInterval(tick, 100);
+})();
+</script>
