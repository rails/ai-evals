+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/123",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "deliver sends the payload via WebPush with the VAPID keys from the environment" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with(
+        message: { title: "Title", body: "Body", url: "/cards/123" }.to_json,
+        endpoint: "https://push.example.com/subscriptions/123",
+        p256dh: "p256dh-key",
+        auth: "auth-key",
+        vapid: {
+          subject: "mailto:support@fizzy.do",
+          public_key: "vapid-public-key",
+          private_key: "vapid-private-key"
+        }
+      )
+
+      assert @subscription.deliver(title: "Title", body: "Body", url: "/cards/123")
+    end
+  end
+
+  test "deliver destroys the subscription when the push service says it has expired" do
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: ""), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      assert_not @subscription.deliver(title: "Title", body: "Body", url: "/cards/123")
+    end
+  end
+
+  test "creating a notification pushes to the user's subscriptions" do
+    user = users(:kevin)
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/456",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    notifications(:layout_commented_kevin).destroy
+
+    Push::Subscription.any_instance.expects(:deliver).with { |payload|
+      payload[:title].present? && payload[:body].present? &&
+        payload[:url] == "/#{user.account.slug.delete_prefix("/")}/cards/#{cards(:layout).number}"
+    }
+
+    perform_enqueued_jobs do
+      Notification.create!(user: user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "push payload says what the tray says and opens the card" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert notification.push_payload[:title].present?
+    assert notification.push_payload[:body].present?
+    assert_equal "/#{notification.account.slug.delete_prefix("/")}/cards/#{notification.card.number}", notification.push_payload[:url]
+  end
+
+test "updating a notification with a new source pushes again, reading it does not" do
+  user = users(:kevin)
+  user.push_subscriptions.create!(
+    endpoint: "https://push.example.com/subscriptions/789",
+    p256dh_key: "p256dh-key",
+    auth_key: "auth-key"
+  )
+  notification = notifications(:layout_commented_kevin)
+
+  Push::Subscription.any_instance.expects(:deliver).once
+
+  perform_enqueued_jobs do
+    notification.update!(source: events(:layout_assignment_jz), creator: users(:david), read_at: nil)
+  end
+
+  Push::Subscription.any_instance.expects(:deliver).never
+
+  perform_enqueued_jobs do
+    notification.read
+  end
+end
+
+test "mention notifications push what the tray says" do
+  notification = notifications(:logo_mentioned_david)
+
+  assert_equal "JZ @mentioned you", notification.push_payload[:title]
+  assert_equal notification.push_payload[:body], "I agree."
+end
+
+  private
+    def with_vapid_keys
+      original_public_key, ENV["VAPID_PUBLIC_KEY"] = ENV["VAPID_PUBLIC_KEY"], "vapid-public-key"
+      original_private_key, ENV["VAPID_PRIVATE_KEY"] = ENV["VAPID_PRIVATE_KEY"], "vapid-private-key"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = original_public_key
+      ENV["VAPID_PRIVATE_KEY"] = original_private_key
+    end
+end
