diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..5452faa
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { Push::Subscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/123",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+
+    subscription = Push::Subscription.last
+    assert_equal @user, subscription.user
+    assert_equal @user.account, subscription.account
+    assert_equal "https://push.example.com/subscriptions/123", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+  end
+
+  test "create as JSON returns the subscription id" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://push.example.com/subscriptions/123",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    }, as: :json
+
+    assert_response :created
+    assert_equal Push::Subscription.last.id, @response.parsed_body["id"]
+  end
+
+  test "create for another user is forbidden" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/123",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/123",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+end
