diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..2644933
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,53 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @push_subscription.assign_attributes(subscription_params)
+    @push_subscription.user_agent = request.user_agent
+
+    if @push_subscription.save
+      respond_to do |format|
+        format.html { head :created }
+        format.json { render json: { id: @push_subscription.id }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { head :unprocessable_entity }
+        format.json { render json: @push_subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @push_subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:endpoint]) ||
+      @user.push_subscriptions.find_by(endpoint: subscription_endpoint_param)
+    @push_subscription&.destroy
+
+    respond_to do |format|
+      format.html { head :no_content }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+
+    def subscription_endpoint_param
+      params.dig(:push_subscription, :endpoint)
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b90bce1
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,155 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "toggle", "details" ]
+  static values = {
+    vapidPublicKey: String,
+    url: String
+  }
+
+  async connect() {
+    this.#hideDetails()
+    await this.#refresh()
+  }
+
+  async toggle() {
+    if (this.hasToggleTarget && this.toggleTarget.checked) {
+      await this.#subscribe()
+    } else {
+      await this.#unsubscribe()
+    }
+  }
+
+  async #refresh() {
+    const subscription = await this.#currentSubscription()
+
+    if (subscription && window.Notification?.permission === "granted") {
+      await this.#register(subscription)
+      this.#showOn()
+    } else {
+      this.#showOff(window.Notification?.permission === "denied")
+    }
+  }
+
+  async #subscribe() {
+    if (!this.#supported) {
+      this.#showOff(true)
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#showOff(permission === "denied")
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      await this.#register(subscription)
+      this.#showOn()
+    } catch {
+      this.#showOff(true)
+    }
+  }
+
+  async #unsubscribe() {
+    const subscription = await this.#currentSubscription()
+
+    if (subscription) {
+      await this.#remove(subscription)
+      await subscription.unsubscribe()
+    }
+
+    this.#showOff(false)
+  }
+
+  async #currentSubscription() {
+    if (!this.#supported) return null
+
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #register(subscription) {
+    const subscriptionData = subscription.toJSON()
+    const body = new FormData()
+    body.append("push_subscription[endpoint]", subscriptionData.endpoint)
+    body.append("push_subscription[p256dh_key]", subscriptionData.keys.p256dh)
+    body.append("push_subscription[auth_key]", subscriptionData.keys.auth)
+
+    const response = await fetch(this.urlValue, {
+      method: "POST",
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      },
+      body
+    })
+
+    if (response.ok) {
+      const data = await response.json().catch(() => ({}))
+      this.subscriptionId = data.id
+    }
+  }
+
+  async #remove(subscription) {
+    const id = this.subscriptionId
+    if (!id) return
+
+    await fetch(`${this.urlValue}/${id}`, {
+      method: "DELETE",
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      }
+    }).catch(() => {})
+  }
+
+  #showOn() {
+    this.element.classList.add(this.onClass)
+    if (this.hasToggleTarget) this.toggleTarget.checked = true
+    this.#hideDetails()
+  }
+
+  #showOff(showDetails) {
+    this.element.classList.remove(this.onClass)
+    if (this.hasToggleTarget) this.toggleTarget.checked = false
+
+    if (showDetails) {
+      this.#showDetails()
+    } else {
+      this.#hideDetails()
+    }
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = (this.vapidPublicKeyValue || "").replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+    const raw = window.atob(padded)
+
+    return Uint8Array.from([...raw].map(character => character.charCodeAt(0)))
+  }
+
+  get #csrfToken() {
+    return document.querySelector("meta[name='csrf-token']")?.content
+  }
+}
