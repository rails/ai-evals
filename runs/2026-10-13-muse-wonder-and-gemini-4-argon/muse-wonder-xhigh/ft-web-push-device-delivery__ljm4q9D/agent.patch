diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..5e33dc0 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,32 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  if (!event.data) return
+
+  let payload = {}
+
+  try {
+    payload = event.data.json()
+  } catch {
+    payload = { body: event.data.text() }
+  }
+
+  const title = payload.title || "Fizzy"
+  const options = {
+    body: payload.body || "",
+    icon: "/app-icon-192.png",
+    data: { url: payload.url || payload.path || "/" }
+  }
+
+  event.waitUntil(self.registration.showNotification(title, options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url || "/"
+
+  event.waitUntil(self.clients.openWindow(url))
+})
