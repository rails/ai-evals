diff --git a/test/jobs/notification/bundle_delivery_job_test.rb b/test/jobs/notification/bundle_delivery_job_test.rb
new file mode 100644
index 0000000..e7b4076
--- /dev/null
+++ b/test/jobs/notification/bundle_delivery_job_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Notification::BundleDeliveryJobTest < ActiveJob::TestCase
+  test "delivers a bundle only when its window has closed" do
+    user = users(:kevin)
+    user.notifications.destroy_all
+    user.notification_bundles.destroy_all
+    user.settings.update!(bundle_email_frequency: "daily")
+    starts = Time.zone.parse("2026-01-05 09:00")
+    Notification.create!(user: user, source: events(:text_published), creator: users(:david), created_at: starts, updated_at: starts)
+    bundle = user.notification_bundles.reload.first
+    ActionMailer::Base.deliveries.clear
+
+    travel_to starts + 1.hour do
+      Notification::BundleDeliveryJob.perform_now(bundle)
+    end
+    assert_empty ActionMailer::Base.deliveries
+
+    travel_to starts + 1.day do
+      Notification::BundleDeliveryJob.perform_now(bundle)
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.count
+    assert bundle.reload.delivered?
+  end
+
+  test "without a bundle it delivers all due bundles" do
+    user = users(:kevin)
+    user.notifications.destroy_all
+    user.notification_bundles.destroy_all
+    user.settings.update!(bundle_email_frequency: "daily")
+    starts = Time.zone.parse("2026-01-05 09:00")
+    Notification.create!(user: user, source: events(:text_published), creator: users(:david), created_at: starts, updated_at: starts)
+    ActionMailer::Base.deliveries.clear
+
+    travel_to starts + 1.day do
+      Notification::BundleDeliveryJob.perform_now
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.count
+  end
+end
