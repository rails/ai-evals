@@ -0,0 +1,7 @@
+# Recurring sweep that delivers every bundle whose window has closed.
+# It is a safety net for the per-bundle delivery scheduled at window end.
+class Notification::DeliverDueBundlesJob < ApplicationJob
+  def perform
+    Notification::Bundle.deliver_due
+  end
+end
diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..675d597
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,31 @@
+class NotificationMailer < ApplicationMailer
+  def bundle_email(bundle)
+    prepare_bundle(bundle)
+    mail(to: @bundle.email_recipient, subject: bundle_subject, template_name: "bundle_email")
+  end
+
+  def bundle(bundle)
+    prepare_bundle(bundle)
+    mail(to: @bundle.email_recipient, subject: bundle_subject, template_name: "bundle_email")
+  end
+
+  def digest(bundle)
+    prepare_bundle(bundle)
+    mail(to: @bundle.email_recipient, subject: bundle_subject, template_name: "bundle_email")
+  end
+  alias_method :digest_email, :digest
+  alias_method :bundled_notifications, :bundle
+
+  private
+    def prepare_bundle(bundle)
+      @bundle = bundle
+      @user = bundle.user
+      @account = bundle.account
+      @notifications = (bundle.persisted? ? bundle.notifications.reload : bundle.notifications).to_a
+    end
+
+    def bundle_subject
+      count = @notifications.size
+      "#{count} new #{'notification'.pluralize(count)} in Fizzy"
+    end
+end
