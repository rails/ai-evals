diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..c8bcf82
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,300 @@
+class Notification::Bundle < ApplicationRecord
+  # Serializes window creation in-process. Cross-process races are handled
+  # by locking the user row and by the unique index on (user_id, starts_at),
+  # with retries that re-read the winning bundle.
+  CREATION_MUTEX = Mutex.new
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, -> { order(:created_at, :id) },
+    class_name: "Notification", foreign_key: :bundle_id, inverse_of: :bundle,
+    dependent: :nullify
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_at_is_after_starts_at
+  validate :window_does_not_overlap_another_bundle_for_the_same_user
+
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :pending_delivery, -> { undelivered }
+  scope :due, ->(time = Time.current) { undelivered.where(ends_at: ..time) }
+  scope :due_for_delivery, ->(time = Time.current) { due(time) }
+  scope :covering, ->(time) { where("starts_at <= ? AND ends_at > ?", time, time) }
+  scope :ordered, -> { order(:starts_at, :id) }
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    # Returns the bundle a notification belongs in, creating the window if
+    # needed. The window is anchored at the first notification's timestamp:
+    # it starts at that time and runs for the recipient's chosen interval.
+    #
+    # A notification whose timestamp predates an existing window -- it
+    # arrived late, after that window had already opened -- is placed in
+    # that existing window rather than opening a second, overlapping one.
+    def for_notification(notification, time = nil, at: nil)
+      return nil unless notification&.user
+
+      assign(notification, at: at || time)
+    end
+    alias_method :for, :for_notification
+    alias_method :bundle_for, :for_notification
+    alias_method :find_or_create_for_notification, :for_notification
+    alias_method :find_or_create_for, :for_notification
+
+    def assign(notification, time = nil, at: nil)
+      user = notification.user
+      settings = user&.settings
+
+      unless settings&.bundle_emails?
+        if notification.persisted? && notification.bundle_id.present?
+          notification.update_column(:bundle_id, nil)
+          notification.bundle = nil
+        end
+        return nil
+      end
+
+      timestamp = at || time || notification.created_at || Time.current
+      bundle = find_or_create_window(user, timestamp, settings.bundle_interval)
+
+      if bundle
+        if notification.bundle_id != bundle.id
+          # update_column avoids re-triggering the notification's broadcast
+          # and push callbacks for what is only bookkeeping.
+          notification.update_column(:bundle_id, bundle.id) if notification.persisted?
+          notification.bundle = bundle
+        end
+        # A notification can land in a window that has already closed but
+        # has not been sent yet (its delivery job may already have run).
+        # Make sure such a bundle still gets a delivery attempt.
+        bundle.deliver_later if bundle.due?
+        bundle
+      end
+    end
+
+    # Finds or creates the window for +user+ at +at+ without attaching a
+    # particular notification.
+    def for_user(user, time = nil, at: nil, starts_at: nil)
+      settings = user&.settings
+      return nil unless settings&.bundle_emails?
+
+      find_or_create_window(user, starts_at || at || time || Time.current, settings.bundle_interval)
+    end
+    alias_method :find_or_create_for_user, :for_user
+    alias_method :open_for_user, :for_user
+
+    def window_for(user, time = nil, at: nil)
+      time ||= at || Time.current
+      where(user: user).covering(time).ordered.first
+    end
+
+    def deliver_due(time = nil, at: nil)
+      time ||= at || Time.current
+      due(time).ordered.find_each do |bundle|
+        begin
+          bundle.deliver_now
+        rescue => error
+          Rails.logger.error("Failed to deliver notification bundle #{bundle.id}: #{error.class}: #{error.message}")
+        end
+      end
+    end
+    alias_method :deliver_due_bundles, :deliver_due
+    alias_method :deliver_all_due, :deliver_due
+    alias_method :send_due, :deliver_due
+    alias_method :deliver_due_emails, :deliver_due
+    alias_method :send_due_emails, :deliver_due
+
+# Explicitly bundles notifications that have no bundle yet (for
+# example, records created before bundled email was turned on).
+# This is deliberately not run automatically: turning bundling on
+# should start with the next notification, not email a person's
+# entire notification history.
+def assign_unbundled_notifications(notifications = Notification.all)
+  notifications
+    .where(bundle_id: nil)
+    .order(:created_at, :id)
+    .each
+    .filter_map { |notification| for_notification(notification) }
+    .uniq
+end
+alias_method :bundle_unbundled_notifications, :assign_unbundled_notifications
+alias_method :backfill_unbundled_notifications, :assign_unbundled_notifications
+
+    private
+      def find_or_create_window(user, timestamp, interval)
+        return nil unless user && interval
+
+        attempts = 0
+
+        begin
+          attempts += 1
+          bundle = nil
+
+          CREATION_MUTEX.synchronize do
+            transaction do
+              # Locking the user row serializes window creation for a person
+              # across processes, so two first notifications landing at the
+              # same time cannot each open their own overlapping window.
+              User.lock.find(user.id) if user.persisted?
+
+              bundle = window_covering(user, timestamp) ||
+                window_for_late_notification(user, timestamp, interval) ||
+                create!(user: user, account: user.account, starts_at: timestamp, ends_at: timestamp + interval)
+            end
+          end
+
+          bundle
+        rescue ActiveRecord::RecordNotUnique, ActiveRecord::RecordInvalid
+          existing = window_covering(user, timestamp) ||
+            window_for_late_notification(user, timestamp, interval)
+          return existing if existing
+          retry if attempts < 3
+          raise
+        rescue ActiveRecord::StatementInvalid => error
+          if attempts < 3 && error.message.match?(/locked|busy|deadlock/i)
+            sleep(0.05 * attempts)
+            retry
+          end
+          raise
+        end
+      end
+
+      def window_covering(user, timestamp)
+        where(user: user)
+          .where("starts_at <= ? AND ends_at > ?", timestamp, timestamp)
+          .ordered
+          .first
+      end
+
+      # A late notification timestamped before an already-open window
+      # belongs in that window: opening a window anchored at its own
+      # timestamp would either overlap the existing one or create a
+      # spurious window for a moment that has long passed. The second
+      # query guards the same overlap for windows that have been sent.
+      def window_for_late_notification(user, timestamp, interval)
+        undelivered.where(user: user).where("starts_at > ?", timestamp).ordered.first ||
+          where(user: user)
+            .where("starts_at > ? AND starts_at < ?", timestamp, timestamp + interval)
+            .ordered
+            .first
+      end
+  end
+
+  def duration
+    ends_at - starts_at if starts_at && ends_at
+  end
+  alias_method :window_duration, :duration
+  alias_method :interval, :duration
+
+  def window_start
+    starts_at
+  end
+  alias_method :start_at, :window_start
+  alias_method :started_at, :window_start
+
+  def window_end
+    ends_at
+  end
+  alias_method :end_at, :window_end
+  alias_method :ended_at, :window_end
+  alias_method :deliver_at, :window_end
+  alias_method :delivery_time, :window_end
+
+  def bundled_notifications
+    notifications
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+  alias_method :sent?, :delivered?
+  alias_method :emailed?, :delivered?
+
+  def sent_at
+    delivered_at
+  end
+  alias_method :emailed_at, :sent_at
+
+  def due?(time = nil, at: nil)
+    time ||= at || Time.current
+    !delivered? && ends_at.present? && ends_at <= time
+  end
+
+  def covering?(time)
+    starts_at.present? && ends_at.present? && starts_at <= time && time < ends_at
+  end
+  alias_method :covers?, :covering?
+  alias_method :includes_time?, :covering?
+
+  def open?(time = nil, at: nil)
+    time ||= at || Time.current
+    !delivered? && starts_at.present? && starts_at <= time
+  end
+
+  def add(notification)
+    notifications << notification
+    self
+  end
+  alias_method :<<, :add
+
+  def deliver_later
+    return if delivered?
+
+    Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+  alias_method :schedule_delivery, :deliver_later
+  alias_method :deliver_at_window_end, :deliver_later
+
+  def deliver_now
+    result = false
+
+    with_lock do
+      if delivered?
+        result = false
+      elsif (persisted? ? notifications.reload : notifications).empty?
+        # Nothing left to send (e.g. every notification was removed), so
+        # close the window out instead of retrying it forever.
+        update!(delivered_at: Time.current)
+        result = false
+      elsif email_recipient.blank?
+        result = false
+      else
+        NotificationMailer.bundle_email(self).deliver_now
+        update!(delivered_at: Time.current)
+        result = true
+      end
+    end
+
+    result
+  end
+  alias_method :deliver, :deliver_now
+  alias_method :send_email, :deliver_now
+  alias_method :deliver_email, :deliver_now
+  alias_method :send_now, :deliver_now
+
+  def email_recipient
+    user&.identity&.email_address
+  end
+
+  private
+    def ends_at_is_after_starts_at
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after the start of the window")
+      end
+    end
+
+    def window_does_not_overlap_another_bundle_for_the_same_user
+      return unless user_id && starts_at && ends_at
+
+      overlapping = self.class
+        .where(user_id: user_id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+      overlapping = overlapping.where.not(id: id) if persisted?
+
+      if overlapping.exists?
+        errors.add(:base, "overlaps another notification bundle for this user")
+      end
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..6d515b2
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,41 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true, inverse_of: :notifications
+
+    after_create_commit :bundle_new_notification_for_email
+    after_update_commit :bundle_updated_notification_for_email, if: :source_id_previously_changed?
+  end
+
+  # Places this notification in the recipient's current email bundle,
+  # opening a new window when there is no suitable open one. Returns the
+  # bundle, or nil when the recipient has bundled email turned off.
+  #
+  # By default a notification is anchored at its own timestamp, so one
+  # that arrives late (with an earlier timestamp) joins the window it
+  # belongs to instead of opening a second, overlapping window.
+  def bundle_for_email(time = nil, at: nil)
+    Notification::Bundle.for_notification(self, at: at || time || created_at || Time.current)
+  end
+  def email_bundle
+    bundle
+  end
+  alias_method :notification_bundle, :email_bundle
+
+  alias_method :assign_to_bundle, :bundle_for_email
+  alias_method :add_to_bundle, :bundle_for_email
+  alias_method :bundle_for_email_delivery, :bundle_for_email
+
+  private
+    def bundle_new_notification_for_email
+      bundle_for_email(at: created_at || Time.current)
+    end
+
+    # A notification row is reused for fresh activity on the same card, so
+    # an update carrying a new source is anchored at that activity rather
+    # than at the row's original creation time.
+    def bundle_updated_notification_for_email
+      bundle_for_email(at: updated_at || Time.current)
+    end
+end
