@@ -0,0 +1,9 @@
+class Notification::BundleDeliveryJob < ApplicationJob
+  def perform(bundle = nil)
+    if bundle
+      bundle.deliver_now if bundle.due?
+    else
+      Notification::Bundle.deliver_due
+    end
+  end
+end
