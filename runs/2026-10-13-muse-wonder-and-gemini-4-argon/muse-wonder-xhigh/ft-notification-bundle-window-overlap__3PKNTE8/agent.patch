+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "bundle_email sends one email listing the bundled notifications" do
+    user = users(:kevin)
+    user.notifications.destroy_all
+    user.settings.update!(bundle_email_frequency: "daily")
+    starts = Time.zone.parse("2026-01-05 09:00")
+    Notification.create!(user: user, source: events(:text_published), creator: users(:david), created_at: starts, updated_at: starts)
+    bundle = user.notification_bundles.reload.first
+
+    email = NotificationMailer.bundle_email(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "1 new notification in Fizzy", email.subject
+    assert_match "Your Fizzy notifications", email.body.encoded
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..659d43d
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: "daily")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "settings expose the bundle interval for each frequency" do
+    assert_nil settings_for("never").bundle_interval
+    assert_equal 4.hours, settings_for("every_few_hours").bundle_interval
+    assert_equal 1.day, settings_for("daily").bundle_interval
+    assert_equal 1.week, settings_for("weekly").bundle_interval
+  end
+
+  test "invalid frequency is rejected" do
+    assert_raises(ArgumentError) { @user.settings.update!(bundle_email_frequency: "hourly") }
+  end
+
+  test "never does not create a bundle" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(events(:text_published), at: Time.zone.parse("2026-01-05 09:00"))
+    end
+  end
+
+  test "first notification opens a window and later ones in the window join it" do
+    starts = Time.zone.parse("2026-01-05 09:00")
+
+    first = create_notification(events(:text_published), at: starts)
+    second = create_notification(events(:shipping_published), at: starts + 3.hours)
+
+    assert_equal 1, @user.notification_bundles.count
+    bundle = @user.notification_bundles.reload.first
+    assert_equal starts, bundle.starts_at
+    assert_equal starts + 1.day, bundle.ends_at
+    assert_equal bundle, first.reload.bundle
+    assert_equal bundle, second.reload.bundle
+  end
+
+  test "notification after the window opens a new window" do
+    starts = Time.zone.parse("2026-01-05 09:00")
+
+    create_notification(events(:text_published), at: starts)
+    later = create_notification(events(:shipping_published), at: starts + 1.day)
+
+    assert_equal 2, @user.notification_bundles.count
+    assert_equal starts + 1.day, later.reload.bundle.starts_at
+    assert_equal starts + 2.days, later.reload.bundle.ends_at
+  end
+
+  test "late notification with an earlier timestamp joins the window that already opened" do
+    starts = Time.zone.parse("2026-01-05 09:00")
+
+    create_notification(events(:text_published), at: starts)
+    late = create_notification(events(:shipping_published), at: starts - 1.hour)
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal @user.notification_bundles.reload.first, late.reload.bundle
+
+    much_later = create_notification(events(:layout_published), at: starts - 7.days)
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal @user.notification_bundles.reload.first, much_later.reload.bundle
+  end
+
+  test "windows for a user never overlap" do
+    starts = Time.zone.parse("2026-01-05 09:00")
+    bundle = @user.notification_bundles.create!(starts_at: starts, ends_at: starts + 1.day)
+
+    overlapping = @user.notification_bundles.build(starts_at: starts + 1.hour, ends_at: starts + 2.days)
+
+    assert_not overlapping.valid?
+    assert_raises(ActiveRecord::RecordInvalid) { overlapping.save! }
+    assert_equal bundle, @user.notification_bundles.reload.first
+  end
+
+  test "different people have separate windows" do
+    starts = Time.zone.parse("2026-01-05 09:00")
+    david = users(:david)
+    david.notifications.destroy_all
+    david.notification_bundles.destroy_all
+    david.settings.update!(bundle_email_frequency: "daily")
+
+    mine = create_notification(events(:text_published), at: starts)
+    theirs = create_notification(events(:shipping_published), at: starts, user: david)
+
+    assert_equal 2, Notification::Bundle.count
+    assert_not_equal mine.reload.bundle, theirs.reload.bundle
+    assert_equal @user, mine.reload.bundle.user
+    assert_equal david, theirs.reload.bundle.user
+  end
+
+  test "every few hours uses a four hour window" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    starts = Time.zone.parse("2026-01-05 09:00")
+
+    notification = create_notification(events(:text_published), at: starts)
+
+    assert_equal starts + 4.hours, notification.reload.bundle.ends_at
+  end
+
+  test "delivering a due bundle sends one email for the whole window and only once" do
+    starts = Time.zone.parse("2026-01-05 09:00")
+    create_notification(events(:text_published), at: starts)
+    create_notification(events(:shipping_published), at: starts + 1.hour)
+    bundle = @user.notification_bundles.reload.first
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+      Notification::Bundle.deliver_due(starts + 23.hours)
+    end
+
+    assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+      Notification::Bundle.deliver_due(starts + 1.day)
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], mail.to
+    assert_match /2 new notifications/, mail.subject
+
+    assert bundle.reload.delivered?
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+      Notification::Bundle.deliver_due(starts + 2.days)
+      bundle.deliver_now
+    end
+  end
+
+  test "deliver_due sends separate emails for separate windows" do
+    starts = Time.zone.parse("2026-01-05 09:00")
+    create_notification(events(:text_published), at: starts)
+    create_notification(events(:shipping_published), at: starts + 2.days)
+
+    assert_difference -> { ActionMailer::Base.deliveries.count }, 2 do
+      Notification::Bundle.deliver_due(starts + 3.days)
+    end
+  end
+
+  private
+    def settings_for(frequency)
+      User::Settings.new(bundle_email_frequency: frequency)
+    end
+
+    def create_notification(source, at:, user: @user)
+      Notification.create!(user: user, source: source, creator: users(:david), created_at: at, updated_at: at)
+    end
+end
