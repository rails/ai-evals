diff --git a/spec/fabricators/user_fabricator.rb b/spec/fabricators/user_fabricator.rb
index c82a3c9..58c0d0c 100644
--- a/spec/fabricators/user_fabricator.rb
+++ b/spec/fabricators/user_fabricator.rb
@@ -8,13 +8,18 @@ Fabricator(:user) do
     )
   end
   email        { sequence(:email) { |i| "#{i}#{Faker::Internet.email}" } }
-  password     '123456789'
+  # Pre-computed BCrypt hash (minimum cost, as in test) of the usual test
+  # password `123456789`. Hashing that password on every fabricated user
+  # (and on every user built for a local account) was measurable across
+  # the suite; the plaintext is restored below so `user.password` and
+  # sign-in with `123456789` keep working exactly as before.
+  encrypted_password '$2a$04$dJGLWpusevN/9Y.4cOd92ujSBRLkngXBVinW1FhrccfwnY5dPrCz.'
   confirmed_at { Time.zone.now }
   current_sign_in_at { Time.zone.now }
   agreement true
 
-  after_create do |user|
-    2.times { Fabricate(:login_activity, user: user) }
+  after_build do |user|
+    user.instance_variable_set(:@password, '123456789') if user.password.blank?
   end
 end
 
