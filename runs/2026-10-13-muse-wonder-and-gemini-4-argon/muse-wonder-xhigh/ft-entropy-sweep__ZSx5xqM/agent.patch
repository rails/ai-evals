diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..3a901cf 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -1,34 +1,68 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  # Selects the boards whose effective auto-postpone period -- their own
+  # entropy when they have one, otherwise their account's -- equals the
+  # bound period. Keeping this as a subquery per period lets the cards
+  # side of the condition compare last_active_at against a constant
+  # cutoff (one per period in use), instead of against a value computed
+  # from joined entropy rows for every card.
+  BOARD_IDS_WITH_AUTO_POSTPONE_PERIOD_SQL = <<~SQL.squish.freeze
+    SELECT boards.id FROM boards
+    LEFT OUTER JOIN entropies ON entropies.container_type = 'Board' AND entropies.container_id = boards.id
+    LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.container_type = 'Account' AND account_entropies.container_id = boards.account_id AND account_entropies.account_id = boards.account_id
+    WHERE COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) = ?
+  SQL
+
   included do
     scope :due_to_be_postponed, -> do
-      active
-        .joins(board: :account)
-        .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+      now = Time.current
+      conditions = []
+      bindings = []
+
+      auto_postpone_periods_in_use.each do |period|
+        conditions << "(cards.board_id IN (#{BOARD_IDS_WITH_AUTO_POSTPONE_PERIOD_SQL}) AND cards.last_active_at <= ?)"
+        bindings << period << now - period.seconds
+      end
+
+      active.where(conditions.join(" OR ").presence || "1 = 0", *bindings)
     end
 
     scope :postponing_soon, -> do
-      now = Time.now
-      active
-        .joins(board: :account)
-        .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at > #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) * 0.75')}", now)
+      now = Time.current
+      conditions = []
+      bindings = []
+
+      auto_postpone_periods_in_use.each do |period|
+        conditions << "(cards.board_id IN (#{BOARD_IDS_WITH_AUTO_POSTPONE_PERIOD_SQL}) AND cards.last_active_at > ? AND cards.last_active_at <= ?)"
+        bindings << period << now - period.seconds << now - (period * 0.75).seconds
+      end
+
+      active.where(conditions.join(" OR ").presence || "1 = 0", *bindings)
     end
 
     delegate :auto_postpone_period, to: :board
   end
 
   class_methods do
+    # Take the ids in a single indexed pass, then load and postpone in
+    # batches. find_each would instead re-run the due condition --
+    # ordered by id, in batches bounded by id -- against the whole
+    # cards table for every batch.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      due_to_be_postponed.pluck(:id).each_slice(1000) do |due_card_ids|
+        where(id: due_card_ids).each do |card|
+          card.auto_postpone(user: card.account.system_user)
+        end
       end
     end
+
+    # Every period that can govern a card: the ones handed out by the
+    # UI plus any other period already stored (e.g. legacy values set
+    # outside the validated list).
+    def auto_postpone_periods_in_use
+      Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS | Entropy.distinct.pluck(:auto_postpone_period).compact
+    end
   end
 
   def entropy
