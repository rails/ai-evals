       end
     end
   end
+
+  # Rails 7.0's FileSystemResolver parses template file names with
+  # Resolver::PathParser, which only recognises formats listed in
+  # ActionView::Template::Types.symbols. :api is not a MIME type (API
+  # templates render either XML or JSON, decided at render time), so
+  # issues/index.api.rsb was parsed as an action named "index.api" and
+  # its virtual path never matched a lookup for "index". Strip the
+  # .api segment when parsing template file names on Rails >= 7.0,
+  # leaving the template's format nil exactly as on Rails 6.1 (whose
+  # parser also left it nil). :api is deliberately NOT registered as
+  # a MIME type or template type: doing so would make ActionView
+  # validate/assign :api as a response format and label API responses
+  # with a single MIME type instead of the requested XML/JSON.
+  if Rails.gem_version >= Gem::Version.new('7.0')
+    class Resolver
+      class PathParser
+        module ApiTemplate
+          def parse(path)
+            result = super
+            template_path = result.path
+            stripped_name = template_path.name.delete_suffix('.api')
+            if stripped_name != template_path.name
+              new_path = ActionView::TemplatePath.build(stripped_name, template_path.prefix, template_path.partial)
+              result = ParsedPath.new(new_path, result.details)
+            end
+            result
+          end
+        end
