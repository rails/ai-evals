+class AddTenancy < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_records_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      has_users = select_value("SELECT COUNT(*) FROM users").to_i.positive?
+      has_books = select_value("SELECT COUNT(*) FROM books").to_i.positive?
+      return unless has_users || has_books
+
+      now = connection.quote(Time.current)
+      name = connection.quote("Default")
+      execute("INSERT INTO tenants (name, created_at, updated_at) VALUES (#{name}, #{now}, #{now})")
+
+      tenant_id = select_value("SELECT MAX(id) FROM tenants").to_i
+      execute("UPDATE users SET tenant_id = #{tenant_id}")
+      execute("UPDATE books SET tenant_id = #{tenant_id}")
+    end
+end
