+require "test_helper"
+
+class WithRaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "raises only inside the block, whatever ran before" do
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_path(books(:manual))
+      end
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+
+  test "renders error pages again when the block itself raises" do
+    assert_raises RuntimeError do
+      with_raised_exceptions { raise "boom" }
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+end
