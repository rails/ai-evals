+# Support for +with_raised_exceptions+ (see ActiveSupport::TestCase below).
+#
+# The exception-rendering middlewares do not read
+# +Rails.application.config.action_dispatch.show_exceptions+ on each
+# request. That setting is copied, exactly once, into the memoized
+# +Rails.application.env_config+ hash (as
+# <tt>"action_dispatch.show_exceptions"</tt>), and every request merges
+# that memoized hash into its Rack env. Mutating the config therefore
+# has two order-dependent failure modes in a long-lived test process:
+#
+# * if no request has run yet, the mutated value is the one memoized,
+#   so it leaks into every later request in the process, even after
+#   the config is "restored"; and
+# * if a request has already run, the memoized value is used and
+#   mutating the config does nothing at all.
+#
+# Instead of mutating any global state, this module makes
+# +env_config+ -- the single place the setting is read from when a
+# request is built (by the application itself, by
+# ActionDispatch::TestRequest, and by controller test requests) --
+# report <tt>:none</tt> only while the current thread/fiber is inside
+# a +with_raised_exceptions+ block. Outside the block the original,
+# memoized config is returned untouched, so other tests (including
+# ones running concurrently in the same process) keep rendering
+# error pages exactly as configured, whatever ran before them.
+module WithRaisedExceptions
+  THREAD_KEY = :with_raised_exceptions
+
+  def self.active?
+    Thread.current[THREAD_KEY]
+  end
+
+  def self.scoped
+    previous = Thread.current[THREAD_KEY]
+    Thread.current[THREAD_KEY] = true
+    yield
+  ensure
+    Thread.current[THREAD_KEY] = previous
+  end
+
+  def env_config
+    if WithRaisedExceptions.active?
+      # +super+ is the memoized hash; merge into a copy so the shared
+      # hash (and hence every other request) is never modified.
+      super.merge("action_dispatch.show_exceptions" => :none)
+    else
+      super
+    end
+  end
+end
+
+Rails.application.singleton_class.prepend(WithRaisedExceptions)
+
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
