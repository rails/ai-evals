+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @email_address.present? %>
+    <p class="margin-none">We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to continue.</p>
+  <% else %>
+    <p class="margin-none">We sent a six-character code to your email address. Enter it below to continue.</p>
+  <% end %>
+
+  <p class="margin-none txt-small txt-subtle">Your code expires in 15 minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", maxlength: 6, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle"><%= link_to "Back to sign in", new_session_path, class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
