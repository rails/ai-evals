new file mode 100644
index 0000000..30089e5
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,143 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def issue_email_code(email_address, purpose:, join_code: nil)
+      EmailCode.issue(email_address: email_address, purpose: purpose.to_s, join_code: join_code).tap do |email_code|
+        session[:email_code_id] = email_code.id
+        session[:email_code_email_address] = email_code.email_address
+        session[:email_code_purpose] = email_code.purpose
+
+        IdentityMailer.sign_in_code(email_code).deliver_now
+      end
+    end
+
+    def respond_to_email_code_sent
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path(script_name: nil) }
+        format.json { render json: { message: "Check your email for a sign-in code." }, status: :created }
+      end
+    end
+
+    def authenticate_with_submitted_email_code(join_code: nil)
+      if email_code = find_submitted_email_code
+        email_code.destroy!
+        clear_pending_email_code
+
+        complete_email_code_authentication(email_code, join_code: join_code)
+      else
+        reject_email_code_authentication
+      end
+    end
+
+    def find_submitted_email_code
+      submitted_code = submitted_email_code
+      return nil if submitted_code.blank?
+
+      email_address = email_address_param.presence || session[:email_code_email_address]
+
+      if email_address.present?
+        EmailCode.authenticate(email_address, submitted_code)
+      else
+        EmailCode.find_by_code(submitted_code)
+      end
+    end
+
+    def complete_email_code_authentication(email_code, join_code: nil)
+      identity = Identity.find_or_create_by!(email_address: email_code.email_address)
+      start_new_session_for identity
+
+      purpose = join_code ? "join" : email_code.purpose
+      effective_join_code = join_code || email_code.join_code
+      alert = nil
+
+      redirect_url =
+        case purpose
+        when "join"
+          if effective_join_code
+            effective_join_code.redeem_if { |account| identity.join(account) }
+            user = User.active.find_by(account: effective_join_code.account, identity: identity)
+
+            if user.nil?
+              alert = "That join code is all used up."
+              join_url(code: effective_join_code.code, script_name: effective_join_code.account.slug)
+            elsif user.setup?
+              landing_url(script_name: effective_join_code.account.slug)
+            else
+              new_users_verification_url(script_name: effective_join_code.account.slug)
+            end
+          else
+            after_authentication_url
+          end
+        when "sign_up"
+          new_signup_completion_url(script_name: nil)
+        else
+          after_authentication_url
+        end
+
+      respond_to do |format|
+        format.html do
+          if alert
+            redirect_to redirect_url, alert: alert
+          else
+            redirect_to redirect_url
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def reject_email_code_authentication
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def clear_pending_email_code
+      session.delete(:email_code_id)
+      session.delete(:email_code_email_address)
+      session.delete(:email_code_purpose)
+    end
+
+    def submitted_email_code
+      value = raw_code_param.presence || nested_code_param(:session).presence ||
+        nested_code_param(:signup).presence || nested_code_param(:email_code).presence ||
+        nested_code_param(:identity).presence
+
+      value.to_s.presence
+    end
+
+    def email_code_submitted?
+      submitted_email_code.present?
+    end
+
+    def raw_code_param
+      parameters = request.request_parameters.merge(request.query_parameters)
+      parameters["code"] || parameters[:code]
+    rescue
+      nil
+    end
+
+    def nested_code_param(key)
+      nested_param(key, :code)
+    end
+
+    def email_address_param
+      value = params[:email_address].presence || nested_param(:session, :email_address).presence ||
+        nested_param(:signup, :email_address).presence || nested_param(:identity, :email_address).presence ||
+        nested_param(:email_code, :email_address).presence
+
+      value.to_s.strip.presence
+    end
+
+    def nested_param(key, field)
+      value = params[key]
+
+      if value.is_a?(ActionController::Parameters) || value.is_a?(Hash)
+        value[field] || value[field.to_s]
+      end
+    end
+end
