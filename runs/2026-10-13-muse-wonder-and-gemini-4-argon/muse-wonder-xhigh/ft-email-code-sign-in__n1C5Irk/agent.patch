+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "codes are six characters and expire after fifteen minutes" do
+    email_code = EmailCode.issue(email_address: "person@example.com")
+
+    assert_equal 6, email_code.code.length
+    assert_in_delta 15.minutes.from_now, email_code.expires_at, 2.seconds
+  end
+
+  test "issuing a new code invalidates the previous one" do
+    previous = EmailCode.issue(email_address: "person@example.com")
+    current = EmailCode.issue(email_address: "person@example.com")
+
+    assert_nil EmailCode.authenticate("person@example.com", previous.code)
+    assert_equal current, EmailCode.authenticate("person@example.com", current.code)
+  end
+
+  test "expired codes do not authenticate" do
+    email_code = EmailCode.issue(email_address: "person@example.com")
+    email_code.update!(expires_at: 1.minute.ago)
+
+    assert_nil EmailCode.authenticate("person@example.com", email_code.code)
+  end
+end
