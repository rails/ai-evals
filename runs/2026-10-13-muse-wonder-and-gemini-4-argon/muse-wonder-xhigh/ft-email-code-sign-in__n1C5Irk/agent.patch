@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signing in by email code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+
+      assert_redirected_to new_session_email_code_path
+      assert_emails_delivered
+
+      get new_session_email_code_path
+
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_email_code_path, params: { code: emailed_code }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "signing in by email code posted back to the session" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      post session_path, params: { code: emailed_code }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "rejecting an incorrect code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      post session_email_code_path, params: { code: "000000" }
+
+      assert_redirected_to new_session_email_code_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "rejecting an expired code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      code = emailed_code
+
+      travel 16.minutes do
+        post session_email_code_path, params: { code: code }
+
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "signing up by email code" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        post signup_path, params: { signup: { email_address: "newperson@example.com" } }
+      end
+
+      assert_redirected_to new_session_email_code_path
+
+      assert_difference -> { Identity.count }, 1 do
+        post session_email_code_path, params: { code: emailed_code }
+      end
+
+      assert cookies[:session_token].present?
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  test "joining by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_difference -> { User.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joiner@example.com" }
+
+      assert_redirected_to new_session_email_code_path(script_name: nil)
+
+      untenanted do
+        post session_email_code_path, params: { code: emailed_code }
+      end
+    end
+
+    assert cookies[:session_token].present?
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+
+  private
+    def emailed_code
+      email = ActionMailer::Base.deliveries.last
+
+      assert email, "Expected a sign-in code email to be delivered"
+      assert_includes email.subject, email.subject[/\d{6}/, 0].to_s
+
+      email.subject[/\d{6}/, 0]
+    end
+
+    def assert_emails_delivered
+      assert_equal 1, ActionMailer::Base.deliveries.size
+    end
+end
