+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "sign-in code is in the subject and body" do
+    email_code = EmailCode.issue(email_address: "person@example.com")
+
+    email = IdentityMailer.sign_in_code(email_code)
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_includes email.subject, email_code.code
+    assert_includes email.html_part.body.decoded, email_code.code
+    assert_includes email.text_part.body.decoded, email_code.code
+  end
+end
