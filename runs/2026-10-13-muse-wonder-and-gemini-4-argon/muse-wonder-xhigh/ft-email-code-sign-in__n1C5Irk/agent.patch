diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..0d6d214
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,58 @@
+class EmailCode < ApplicationRecord
+  EXPIRY_DURATION = 15.minutes
+  CODE_LENGTH = 6
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, :expires_at, presence: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+
+  scope :unexpired, -> { where(expires_at: Time.current..) }
+
+  def self.issue(email_address:, purpose: "sign_in", join_code: nil)
+    transaction do
+      where(email_address: email_address.to_s.strip.downcase).delete_all
+
+      create!(
+        email_address: email_address,
+        purpose: purpose,
+        join_code: join_code,
+        code: generate_code,
+        expires_at: EXPIRY_DURATION.from_now
+      )
+    end
+  end
+
+  def self.generate_code
+    (SecureRandom.random_number(900_000) + 100_000).to_s
+  end
+
+  def self.authenticate(email_address, submitted_code)
+    code = find_by(email_address: email_address.to_s.strip.downcase, code: normalize_code(submitted_code))
+
+    code if code&.active?
+  end
+
+  def self.find_by_code(submitted_code)
+    unexpired.where(code: normalize_code(submitted_code)).order(created_at: :desc).first
+  end
+
+  def self.normalize_code(submitted_code)
+    submitted_code.to_s.strip.upcase.gsub(/[\s-]/, "")
+  end
+
+  def active?
+    expires_at&.future?
+  end
+
+  def expired?
+    !active?
+  end
+
+  def matches?(submitted_code)
+    active? && code == self.class.normalize_code(submitted_code)
+  end
+end
