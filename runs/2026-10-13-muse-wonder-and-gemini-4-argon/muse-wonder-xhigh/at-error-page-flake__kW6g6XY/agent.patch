diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..7549f40 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -13,11 +13,29 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
+      # Rails.application.env_config is memoized (@app_env_config ||= ...) the
+      # first time a request is made, capturing whatever
+      # config.action_dispatch.show_exceptions was at that moment. Changing
+      # the config alone afterwards therefore has no effect on requests in a
+      # process that has already served one (it keeps using the captured
+      # value), and the first value captured wins for the rest of the process.
+      # That makes the outcome depend on which test happened to run first.
+      #
+      # To keep this helper's promise regardless of test order, change the
+      # effective value -- the one ShowExceptions actually reads from each
+      # request's env -- as well as the config, and restore both afterwards.
+      # Restoring the previous *effective* value (rather than assuming the
+      # configured default) also makes nested calls behave correctly.
+      previous_config = Rails.application.config.action_dispatch.show_exceptions
+      previous_env_config = Rails.application.env_config["action_dispatch.show_exceptions"]
+
       Rails.application.config.action_dispatch.show_exceptions = :none
+      Rails.application.env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      Rails.application.config.action_dispatch.show_exceptions = previous_config
+      Rails.application.env_config["action_dispatch.show_exceptions"] = previous_env_config
     end
   end
 end
