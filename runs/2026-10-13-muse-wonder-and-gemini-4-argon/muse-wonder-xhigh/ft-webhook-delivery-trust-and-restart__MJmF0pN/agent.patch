--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,97 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+  test "deliver posts the signed event payload and records the response" do
+    webhook = webhooks(:active)
+    event = events(:text_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 201, headers: { "X-Reply" => "ok" })
+
+    assert delivery.deliver
+    assert delivery.succeeded?
+    assert_equal 201, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig("headers", "User-Agent")
+    assert_equal event.created_at.utc.iso8601(3), delivery.request.dig("headers", "X-Webhook-Timestamp")
+    assert_requested(:post, webhook.url) do |request|
+      signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request.body)
+      payload = JSON.parse(request.body)
+
+      request.headers["X-Webhook-Signature"] == signature &&
+        payload["id"] == event.id &&
+        payload["action"] == event.action.to_s
+    end
+  end
+
+  test "deliver records non-2xx responses as failed deliveries" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    assert delivery.deliver
+    assert delivery.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver records unreachable destinations as errored" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+
+    stub_request(:post, webhook.url).to_raise(SocketError.new("unreachable"))
+
+    assert delivery.deliver
+    assert delivery.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver delivers exactly once, including through the job" do
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert delivery.deliver
+    assert_not delivery.deliver
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested :post, webhook.url, times: 1
+  end
+
+  test "deliver does not post for an inactive webhook" do
+    webhook = webhooks(:inactive)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_not delivery.deliver
+    assert delivery.pending?
+    assert_not_requested :post, webhook.url
+  end
+
+  test "cleanup deletes deliveries older than a week" do
+    webhook = webhooks(:active)
+    old_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published), created_at: 8.days.ago)
+    recent_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:shipping_published), created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+  test "duplicate deliveries for the same event deliver exactly once" do
+    webhook = webhooks(:active)
+    event = events(:text_published)
+    first = Webhook::Delivery.create!(webhook: webhook, event: event)
+    duplicate = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert first.deliver
+    assert_not duplicate.deliver
+    assert_requested :post, webhook.url, times: 1
+  end
 end
