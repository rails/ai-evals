diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..f3fa135
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago and all their data" do
+    board_ids = @account.boards.pluck(:id)
+    card_ids = @account.cards.pluck(:id)
+    user_ids = @account.users.pluck(:id)
+
+    cancel_account(@account, initiated_by: @user, cancelled_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_equal 0, Account::Cancellation.where(account_id: @account.id).count
+    assert_equal 0, Account::JoinCode.where(account_id: @account.id).count
+    assert_equal 0, Board.where(id: board_ids).count
+    assert_equal 0, Card.where(id: card_ids).count
+    assert_equal 0, User.where(id: user_ids).count
+    assert_equal 0, Comment.where(account_id: @account.id).count
+    assert_equal 0, Event.where(account_id: @account.id).count
+  end
+
+  test "does not incinerate accounts cancelled within the last 30 days" do
+    cancel_account(@account, initiated_by: @user, cancelled_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate accounts that were never cancelled" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate accounts that were cancelled and then reactivated" do
+    cancel_account(@account, initiated_by: @user, cancelled_at: 31.days.ago)
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate other accounts" do
+    other_account = accounts(:initech)
+    cancel_account(@account, initiated_by: @user, cancelled_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(other_account.id)
+    assert other_account.boards.exists?
+    assert other_account.users.exists?
+  end
+
+  test "incinerates accounts with attached files and storage records" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(Rails.root.join("test/fixtures/files/moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    Storage::Entry.create!(account: @account, board: card.board, recordable: card, delta: 10, operation: "attach")
+
+    cancel_account(@account, initiated_by: @user, cancelled_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert_equal 0, ActiveStorage::Attachment.where(account_id: @account.id).count
+    assert_equal 0, ActiveStorage::Blob.where(account_id: @account.id).count
+    assert_equal 0, Storage::Entry.where(account_id: @account.id).count
+    assert_equal 0, Search::Record.where(account_id: @account.id).count
+  end
+
+  private
+    def cancel_account(account, initiated_by:, cancelled_at:)
+      account.cancel(initiated_by: initiated_by)
+      account.cancellation.update!(created_at: cancelled_at)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..8b8445e
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incineration_due includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_includes Account.incineration_due, @account
+    assert @account.incineration_due?
+  end
+
+  test "incineration_due excludes recently cancelled accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_not_includes Account.incineration_due, @account
+    assert_not @account.incineration_due?
+  end
+
+  test "incineration_due excludes accounts that are not cancelled" do
+    assert_not_includes Account.incineration_due, @account
+    assert_not @account.incineration_due?
+  end
+end
