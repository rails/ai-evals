diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..9eec32b 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,60 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+  end
+
+  def incineration_due?
+    cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+  end
+
+  def incinerate
+    board_ids = boards.pluck(:id)
+
+    purge_attached_files
+    destroy!
+    remove_remaining_data(board_ids)
+  end
+
+  private
+    # Purging attachments while the account still exists is important:
+    # destroying a tracked attachment records a storage-ledger entry, and
+    # that entry can't be created once the account itself is gone. Purging
+    # first also removes the underlying files and blobs, rather than only
+    # removing the attachment rows that point at them.
+    def purge_attached_files
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:purge)
+      orphaned_blobs.find_each(&:purge)
+    end
+
+    # Most account data is removed by the dependent associations when the
+    # account is destroyed. A few kinds of records are tied to the account
+    # without such an association (or are only removed by callbacks that a
+    # cascading destroy may have already passed), so sweep them up here to
+    # make sure nothing for the account is left behind.
+    def remove_remaining_data(board_ids)
+      Storage::Entry.where(account_id: id).delete_all
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+
+      Search::Record.for(id).where(account_id: id).destroy_all
+
+      ActionText::RichText.where(account_id: id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: id).delete_all
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      orphaned_blobs.find_each(&:purge)
+    end
+
+    def orphaned_blobs
+      ActiveStorage::Blob.where(account_id: id).left_joins(:attachments).where(active_storage_attachments: { id: nil })
+    end
 end
