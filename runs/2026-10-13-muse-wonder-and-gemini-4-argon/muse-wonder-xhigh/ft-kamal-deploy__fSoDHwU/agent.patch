new file mode 100644
index 0000000..32316fd
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,101 @@
+# Kamal deployment for a single, self-hosted Fizzy server.
+#
+# This is the configuration for developers who fork Fizzy and want to run
+# it on one Linux box: one server, one container (web + background jobs),
+# SQLite on a persistent volume, and SSL terminated by kamal-proxy.
+#
+# Before the first deploy, replace the example values below:
+#
+#   1. `192.168.0.1`       — the IP address (or hostname) of your server
+#   2. `fizzy.example.com` — the hostname that points at that server
+#                            (proxy host, APP_HOST, SMTP_DOMAIN and the
+#                            MAILER_FROM_ADDRESS domain must all match it)
+#   3. `smtp.example.com`  — your outgoing mail server
+#
+# Then export the secrets named in `.kamal/secrets` (see docs/deployment.md)
+# and run:
+#
+#   bin/kamal setup
+#
+# Subsequent deploys are just `bin/kamal deploy`.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. With the local registry below this does not
+# need a Docker Hub / GHCR account: Kamal runs a registry on your own
+# machine during the deploy and the server pulls the image from it over
+# the SSH connection.
+image: fizzy
+
+# Deploy to a single server. Everything runs in this one container:
+# Solid Queue runs inside Puma (see config/puma.rb), so background jobs
+# (mail delivery, notifications, recurring tasks from config/recurring.yml)
+# run on this box without a separate job container.
+servers:
+  web:
+    - 192.168.0.1
+
+# SSL from the proxy: kamal-proxy obtains a Let's Encrypt certificate for
+# this host and terminates SSL, forwarding plain HTTP to the app on
+# port 80 (Thruster). Point the DNS record for this hostname at the
+# server above before running `kamal setup`.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+
+# A local registry is all a one-box deployment needs — no external
+# container registry (or registry password) is required.
+registry:
+  server: localhost:5555
+
+# Configure the builder. A single amd64 Linux server is the expected
+# target; change this to arm64 if your server is ARM-based.
+builder:
+  arch: amd64
+
+# Persistent storage: this volume is what makes data survive deploys.
+# The SQLite databases live in /rails/storage (production, cable, cache
+# and queue databases, see config/database.sqlite.yml) and local Active
+# Storage files live in /rails/storage/production/files, so mounting one
+# volume at /rails/storage preserves all of them.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between the old and new containers during
+# a deploy so in-flight requests don't 404.
+asset_path: /rails/public/assets
+
+# Environment variables injected into the container. Secrets are pulled
+# from `.kamal/secrets` — never put real secret values in this file.
+env:
+  clear:
+    RAILS_ENV: production
+    # Jobs run in the same container/process as the web server.
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Public hostname of this installation. Must match `proxy.host`
+    # above; Rails uses it for links in emails (e.g. sign-in magic links).
+    APP_HOST: fizzy.example.com
+    # Outgoing mail (SMTP). Replace with your mail server. The user name
+    # and password are secrets (below); leave them unset in your
+    # environment if your mail server does not require authentication.
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@fizzy.example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: fizzy.example.com
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Web Push (VAPID) keys — generate them as described in
+    # docs/deployment.md. Optional, but push notifications won't be
+    # delivered without them.
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs --follow
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..a919159 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,35 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Self-hosted (single-server) deployments describe themselves through the
+  # environment — see config/deploy.yml and docs/deployment.md. The public
+  # host is used to build absolute URLs, most importantly the sign-in
+  # (magic link) emails Fizzy's passwordless login depends on. SaaS
+  # deployments override these in their own environment config.
+  app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence
+  if app_host.present?
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+  end
+
+  # Outgoing mail via the operator's own SMTP server. Only configured when
+  # an address is given, so deployments without one keep Rails' defaults.
+  smtp_address = ENV["SMTP_ADDRESS"].presence || ENV["SMTP_HOST"].presence || ENV["SMTP_SERVER"].presence
+  if smtp_address.present?
+    smtp_user_name = ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV["SMTP_DOMAIN"].presence || app_host,
+      user_name: smtp_user_name,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: (ENV.fetch("SMTP_AUTHENTICATION", "plain") if smtp_user_name.present?),
+      enable_starttls_auto: ENV["SMTP_ENABLE_STARTTLS_AUTO"] != "false"
+    }.compact
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
