@@ -0,0 +1,21 @@
+# Secrets for the single-server deployment in config/deploy.yml.
+#
+# Every secret referenced from config/deploy.yml (env/secret and any
+# registry password) must be defined here. Values are read from the
+# environment of the machine you deploy *from*, so this file is safe to
+# commit: DO NOT ENTER RAW CREDENTIALS HERE.
+#
+# Export the variables (or put them in your shell / CI environment)
+# before running `bin/kamal setup`, e.g.:
+#
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#   export SMTP_USERNAME=...
+#   export SMTP_PASSWORD=...
+#
+# See docs/deployment.md for how to generate each value.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
