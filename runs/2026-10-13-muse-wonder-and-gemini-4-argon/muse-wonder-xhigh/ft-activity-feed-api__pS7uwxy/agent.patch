+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,38 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ]
+
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Event.preloaded
+        .where(board: boards, action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events
+    end
+
+    def boards
+      if params[:board_ids].present?
+        Current.user.boards.where(id: params[:board_ids])
+      else
+        Current.user.boards
+      end
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..3f76c7c
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,44 @@
+stored_particulars = event.particulars
+stored_particulars = stored_particulars.transform_keys(&:to_s) if stored_particulars.is_a?(Hash)
+stored_particulars = {} unless stored_particulars.is_a?(Hash)
+nested_particulars = stored_particulars["particulars"]
+nested_particulars = nested_particulars.transform_keys(&:to_s) if nested_particulars.is_a?(Hash)
+nested_particulars = {} unless nested_particulars.is_a?(Hash)
+event_particulars = stored_particulars.merge(nested_particulars)
+
+activity_particulars =
+  case event.action.to_s
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: Array(event_particulars["assignee_ids"] || event.assignee_ids) }
+  when "card_board_changed"
+    { old_board: event_particulars["old_board"] || "", new_board: event_particulars["new_board"] || event_particulars["new_collection"] || "" }
+  when "card_title_changed"
+    { old_title: event_particulars["old_title"] || "", new_title: event_particulars["new_title"] || "" }
+  when "card_triaged"
+    { column: event_particulars["column"] || "" }
+  else
+    {}
+  end
+
+json.(event, :id, :action)
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text
+json.particulars activity_particulars
+
+if event.eventable_type == "Comment"
+  json.url card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable))
+else
+  json.url card_url(event.eventable)
+end
+
+json.eventable_type event.eventable_type
+
+json.eventable do
+  case event.eventable
+  when Card then json.partial! "cards/card", card: event.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+  end
+end
+
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
