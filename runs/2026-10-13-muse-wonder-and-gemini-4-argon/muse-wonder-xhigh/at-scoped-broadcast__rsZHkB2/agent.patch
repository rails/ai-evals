diff --git a/test/controllers/being_edited_indicator_test.rb b/test/controllers/being_edited_indicator_test.rb
new file mode 100644
index 0000000..50625cc
--- /dev/null
+++ b/test/controllers/being_edited_indicator_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class BeingEditedIndicatorTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "update broadcasts being edited indicator only on current editors' streams" do
+    leaf = leaves(:welcome_page)
+    book = books(:handbook)
+    removed_editor = users(:kevin)
+    remaining_editor = users(:david)
+
+    get edit_book_page_path(book, leaf)
+    assert_response :success
+    removed_stream = subscribed_stream_name
+
+    sign_in remaining_editor
+    get edit_book_page_path(book, leaf)
+    assert_response :success
+    remaining_stream = subscribed_stream_name
+
+    assert_not_equal removed_stream, remaining_stream
+
+    book.access_for(user: removed_editor).destroy!
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "With even more interesting words." } }
+    end
+    assert_response :no_content
+
+    shared_stream = Turbo::StreamsChannel.verified_stream_name(Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited ]))
+
+    assert_empty broadcasts(shared_stream)
+    assert_empty broadcasts(removed_stream)
+    assert_not_empty broadcasts(remaining_stream)
+    assert_includes broadcasts(remaining_stream).join, remaining_editor.name
+  end
+
+  private
+    def subscribed_stream_name
+      signed_stream_name = response.body[/signed-stream-name="([^"]+)"/, 1]
+      Turbo::StreamsChannel.verified_stream_name(CGI.unescapeHTML(signed_stream_name))
+    end
+end
