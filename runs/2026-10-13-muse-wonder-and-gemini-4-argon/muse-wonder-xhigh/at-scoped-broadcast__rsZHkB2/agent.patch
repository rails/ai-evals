diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..21c279c 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -24,6 +24,18 @@ module Book::Accessable
     accesses.exists?(user: user)
   end
 
+  # Users who can currently open the editor: editors assigned to the book,
+  # administrators assigned to the book (who can always edit), and -- since
+  # a published book is reachable without an assignment -- administrators
+  # of a published book.
+  def editors
+    editor_ids = accesses.includes(:user).filter_map do |access|
+      access.user_id if access.editor? || access.user.administrator?
+    end
+    editor_ids |= User.active.administrator.ids if published?
+    User.active.where(id: editor_ids)
+  end
+
   def editable?(user: Current.user)
     access_for(user: user)&.editor? || user&.administrator?
   end
