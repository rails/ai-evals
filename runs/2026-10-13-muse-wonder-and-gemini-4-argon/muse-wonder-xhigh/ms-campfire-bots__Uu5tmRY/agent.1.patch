diff --git a/app/models/bot.rb b/app/models/bot.rb
new file mode 100644
index 0000000..e92843a
--- /dev/null
+++ b/app/models/bot.rb
@@ -0,0 +1,25 @@
+# A chat bot. Bots are users (STI) so they can hold memberships, own an
+# avatar and author messages exactly like people, but they cannot sign in:
+# they authenticate to the posting API with their bot code instead.
+class Bot < User
+  belongs_to :creator, class_name: "User", optional: true
+
+  has_secure_token :bot_code
+
+  validates :name, presence: true
+
+  before_create :set_random_password
+
+  # Convenience aliases for the credential, which is described as a
+  # "bot code" in the UI.
+  alias_attribute :code, :bot_code
+
+  def bot?
+    true
+  end
+
+  private
+    def set_random_password
+      self.password = SecureRandom.hex(32) if password_digest.blank?
+    end
+end
