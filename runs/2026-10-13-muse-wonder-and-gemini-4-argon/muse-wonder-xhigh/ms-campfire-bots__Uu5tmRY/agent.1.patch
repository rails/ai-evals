diff --git a/docs/bots.md b/docs/bots.md
new file mode 100644
index 0000000..2294f62
--- /dev/null
+++ b/docs/bots.md
@@ -0,0 +1,39 @@
+# Bots
+
+Design notes for the bot feature:
+
+- A bot is a `Bot`, a single-table-inheritance subclass of `User` (`users.type`).
+  Reusing `User` gives bots, for free and exactly like people: an avatar,
+  memberships, room access rules, message authorship (`Message#creator`),
+  mentions, unread handling, broadcasts and web-push fan-out.
+- `users.creator_id` records the person who created the bot. Regular users
+  manage only their own bots; administrators manage every bot
+  (`User#can_administer?(bot)` already covers creator/administrator).
+- `users.bot_code` is the bot's unique credential, generated with
+  `has_secure_token`. It is a sensitive credential: it is only shown (in the
+  read-only "Bot code" field) to the bot's creator and administrators on
+  `/bots`, and `bot_code` is added to filtered parameters. Anyone holding it
+  can post as the bot, so treat it like a password.
+- Creating a bot runs the normal `User` creation hook, so a new bot joins all
+  open rooms. It can be added to closed rooms from the room settings member
+  list, which already lists `User.active` (bots included).
+- Bots are excluded from the account-settings people list; they are managed
+  from `/bots` instead. They remain in room member lists.
+
+## Posting as a bot
+
+```
+curl -d "Deploy of v1.2.3 finished" \
+  https://chat.example.com/rooms/<room-id>/<bot-code>/messages
+```
+
+- No session or CSRF token: the bot code in the path is the credential.
+- The raw request body is the message body (no JSON envelope / field names).
+- Responses: `201` (+ `Location: /messages/:id`), `422` for an empty body,
+  `404` for an unknown room (or a room the bot is not a member of, mirroring
+  how people only reach rooms through a membership), and `401` for an
+  invalid/deleted bot code.
+- The message is created with the bot as creator, then
+  `Message#broadcast_create` is called and the model's
+  `after_create_commit -> room.receive` hook enqueues push notifications,
+  exactly as for a human-authored message.
diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..1e22126
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "account settings page links to the bots page" do
+    get edit_account_url
+    assert_response :success
+    assert_select "a[href='#{bots_path}']", text: /Set up chat bots/
+  end
+
+  test "index lists bots created by the current user and all bots for administrators" do
+    mine = Bot.create!(name: "My Bot", creator: users(:david))
+    Bot.create!(name: "Other Bot", creator: users(:jz))
+
+    get bots_url
+    assert_response :success
+    assert_select "a[href='#{new_bot_path}']", text: /Add a chat bot/
+    assert_select "li", text: /My Bot/
+    assert_select "li" do |items|
+      item = items.find { |element| element.text.include?("My Bot") }
+      assert item
+      assert_select item, "input[value='#{mine.bot_code}'][readonly]"
+      assert_select item, "label", text: "Bot code"
+      assert_select item, "a[href='#{edit_bot_path(mine)}']", text: /Edit My Bot/
+    end
+
+    sign_in :jz
+    get bots_url
+    assert_response :success
+    assert_select "li", text: /Other Bot/
+    assert_select "li", text: /My Bot/, count: 0
+  end
+
+  test "new form is labelled" do
+    get new_bot_url
+    assert_response :success
+    assert_select "label", text: "Name the bot"
+    assert_select "input[type=file][name='bot[avatar]']"
+    assert_select "button", text: /Save changes/
+  end
+
+  test "create creates a bot that joins open rooms and redirects to index" do
+    assert_difference -> { Bot.count }, 1 do
+      post bots_url, params: { bot: { name: "Deploy Bot", avatar: fixture_file_upload("earth.png", "image/png") } }
+    end
+
+    assert_redirected_to bots_url
+    bot = Bot.find_by(name: "Deploy Bot")
+    assert bot.bot_code.present?
+    assert bot.avatar.attached?
+    assert_equal users(:david), bot.creator
+    assert_equal Rooms::Open.all.sort, bot.rooms.opens.sort
+  end
+
+  test "update and destroy" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    get edit_bot_url(bot)
+    assert_response :success
+    assert_select "button", text: "Delete this chat bot"
+
+    put bot_url(bot), params: { bot: { name: "Release Bot" } }
+    assert_redirected_to bots_url
+    assert_equal "Release Bot", bot.reload.name
+
+    assert_difference -> { Bot.count }, -1 do
+      delete bot_url(bot)
+    end
+    assert_redirected_to bots_url
+  end
+
+  test "non-creator non-administrator cannot edit another user's bot" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    sign_in :jz
+    get edit_bot_url(bot)
+    assert_response :forbidden
+
+    put bot_url(bot), params: { bot: { name: "Hacked" } }
+    assert_response :forbidden
+    assert_equal "Deploy Bot", bot.reload.name
+
+    delete bot_url(bot)
+    assert_response :forbidden
+    assert Bot.exists?(bot.id)
+  end
+end
diff --git a/test/controllers/rooms/bot_messages_controller_test.rb b/test/controllers/rooms/bot_messages_controller_test.rb
new file mode 100644
index 0000000..b4545f7
--- /dev/null
+++ b/test/controllers/rooms/bot_messages_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Rooms::BotMessagesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @room = rooms(:hq)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+  end
+
+  test "posting with a valid bot code creates a message authored by the bot" do
+    assert_difference -> { Message.count }, 1 do
+      post room_bot_messages_url(@room, @bot.bot_code),
+        params: "Deploy of v1.2.3 finished",
+        headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+
+    assert_response :created
+    message = Message.last
+    assert_equal @bot, message.creator
+    assert_equal @bot.name, message.creator.name
+    assert_equal "Deploy of v1.2.3 finished", message.plain_text_body
+    assert_equal "/messages/#{message.id}", response.headers["Location"].to_s.sub(%r{\Ahttps?://[^/]+}, "")
+  end
+
+  test "posting broadcasts the message and enqueues push notifications like a human message" do
+    assert_enqueued_with(job: Room::PushMessageJob) do
+      post room_bot_messages_url(@room, @bot.bot_code),
+        params: "Deploy of v1.2.3 finished ✅",
+        headers: { "CONTENT_TYPE" => "application/x-www-form-urlencoded" }
+    end
+
+    assert_response :created
+    assert_equal "Deploy of v1.2.3 finished ✅", Message.last.plain_text_body
+    assert_rendered_turbo_stream_broadcast @room, :messages, action: "append", target: [ @room, :messages ] do
+      assert_select ".message__body", text: /Deploy of v1.2.3 finished/
+    end
+  end
+
+  test "bot can post to a closed room once added to it, but not before" do
+    closed_room = rooms(:watercooler)
+
+    post room_bot_messages_url(closed_room, @bot.bot_code), params: "hi", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :not_found
+
+    closed_room.memberships.grant_to(@bot)
+
+    post room_bot_messages_url(closed_room, @bot.bot_code), params: "hi", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :created
+  end
+
+  test "empty body is unprocessable" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, @bot.bot_code), params: "   ", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "bad room id is not found" do
+    post room_bot_messages_url(0, @bot.bot_code), params: "hi", headers: { "CONTENT_TYPE" => "text/plain" }
+    assert_response :not_found
+  end
+
+  test "invalid bot code is unauthorized" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "invalid-code"), params: "hi", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :unauthorized
+  end
+
+  test "deleted bot can no longer post" do
+    code = @bot.bot_code
+    @bot.destroy!
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, code), params: "hi", headers: { "CONTENT_TYPE" => "text/plain" }
+    end
+    assert_response :unauthorized
+  end
+end
