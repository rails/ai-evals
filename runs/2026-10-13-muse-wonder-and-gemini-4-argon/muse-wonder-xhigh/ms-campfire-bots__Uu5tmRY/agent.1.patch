+++ b/test/models/bot_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class BotTest < ActiveSupport::TestCase
+  test "creating a bot generates a unique bot code and joins open rooms" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+    other = Bot.create!(name: "Other Bot", creator: users(:david))
+
+    assert bot.bot_code.present?
+    assert_not_equal bot.bot_code, other.bot_code
+    assert bot.bot?
+    assert_not users(:david).bot?
+    assert_equal Rooms::Open.all.sort, bot.rooms.opens.sort
+  end
+
+  test "bots are not people" do
+    bot = Bot.create!(name: "Deploy Bot", creator: users(:david))
+
+    assert_includes User.people, users(:david)
+    assert_not_includes User.people, bot
+    assert_includes users(:david).bots, bot
+  end
+end
