diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..f098804
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,64 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+  before_action :ensure_can_administer_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = visible_bots.ordered.with_attached_avatar
+  end
+
+  def new
+    @bot = Bot.new
+  end
+
+  def create
+    @bot = Bot.new(bot_params)
+    @bot.creator = Current.user
+
+    if @bot.save
+      redirect_to bots_url
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def edit
+  end
+
+  def update
+    if @bot.update(bot_params)
+      redirect_to bots_url
+    else
+      render :edit, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @bot.destroy!
+    redirect_to bots_url
+  end
+
+  private
+    def set_bot
+      @bot = Bot.find(params[:id])
+    rescue ActiveRecord::RecordNotFound
+      head :not_found
+    end
+
+    def ensure_can_administer_bot
+      head :forbidden if @bot && !Current.user.can_administer?(@bot)
+    end
+
+    def visible_bots
+      if Current.user.administrator?
+        Bot.all
+      else
+        Current.user.bots
+      end
+    end
+
+    def bot_params
+      params.require(:bot).permit(:name, :avatar).tap do |permitted|
+        permitted.delete(:avatar) if permitted[:avatar].blank?
+      end
+    end
+end
diff --git a/app/controllers/rooms/bot_messages_controller.rb b/app/controllers/rooms/bot_messages_controller.rb
new file mode 100644
index 0000000..23c7871
--- /dev/null
+++ b/app/controllers/rooms/bot_messages_controller.rb
@@ -0,0 +1,31 @@
+# HTTP API for bots to post messages. Authenticated by the bot code in the
+# URL rather than by a session, so it can be called from shell scripts and
+# CI jobs with e.g. `curl -d "Deploy finished" /rooms/:id/:bot_code/messages`.
+class Rooms::BotMessagesController < ApplicationController
+  allow_unauthenticated_access only: :create
+  skip_forgery_protection only: :create
+
+  def create
+    room = Room.find_by(id: params[:room_id])
+    return head :not_found unless room
+
+    bot = Bot.active.find_by(bot_code: params[:bot_code])
+    return head :unauthorized unless bot
+
+    # Bots post to rooms they belong to, exactly like people do.
+    return head :not_found unless room.memberships.exists?(user: bot)
+
+    body = request.raw_post.to_s.dup.force_encoding(Encoding::UTF_8)
+    body = body.scrub unless body.valid_encoding?
+    return head :unprocessable_entity if body.blank?
+
+    Current.user = bot
+    message = room.messages.create!(body: body, creator: bot)
+    message.broadcast_create
+
+    response.headers["Location"] = message_path(message)
+    head :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+end
