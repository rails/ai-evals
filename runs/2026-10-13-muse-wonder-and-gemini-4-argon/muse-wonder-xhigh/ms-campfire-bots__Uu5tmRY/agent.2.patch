diff --git a/app/models/message/bot_mentions.rb b/app/models/message/bot_mentions.rb
new file mode 100644
index 0000000..9ff759a
--- /dev/null
+++ b/app/models/message/bot_mentions.rb
@@ -0,0 +1,26 @@
+module Message::BotMentions
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :deliver_webhooks_to_mentioned_bots
+  end
+
+  # Bots mentioned in this message that can be notified over HTTP.
+  # Like people, bots are only mentionees when they belong to the room
+  # (see Message::Mentionee); a webhook URL is what makes a bot reachable.
+  def mentioned_bots
+    mentionees.active.where(type: "Bot").where.not(webhook_url: [ nil, "" ])
+  end
+
+  private
+    def deliver_webhooks_to_mentioned_bots
+      # A bot's own messages never trigger webhooks: a webhook reply is
+      # authored by the bot, and letting it re-trigger webhooks (its own
+      # or another bot's, which might reply in kind) could loop forever.
+      return if creator&.bot?
+
+      mentioned_bots.find_each do |bot|
+        BotWebhookDeliveryJob.perform_later(bot, self)
+      end
+    end
+end
