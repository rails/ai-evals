diff --git a/test/jobs/bot_webhook_delivery_job_test.rb b/test/jobs/bot_webhook_delivery_job_test.rb
new file mode 100644
index 0000000..831c2e2
--- /dev/null
+++ b/test/jobs/bot_webhook_delivery_job_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class BotWebhookDeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    @room = rooms(:hq)
+    @bot = Bot.create!(name: "Deploy Bot", creator: users(:david), webhook_url: "https://example.com/webhook")
+  end
+
+  test "mentioning a bot enqueues delivery without calling the webhook, then posts a plain text reply" do
+    captured = nil
+    stub_request(:post, "https://example.com/webhook")
+      .with { |request| captured = request; true }
+      .to_return(status: 200, body: "Build restarted!", headers: { "Content-Type" => "text/plain" })
+
+
+    message = nil
+    assert_enqueued_jobs 1, only: BotWebhookDeliveryJob do
+      assert_no_difference -> { Message.where(creator: @bot).count } do
+        message = create_mention_message
+      end
+    end
+    assert_not_requested :post, "https://example.com/webhook"
+
+    assert_difference -> { Message.where(creator: @bot).count }, 1 do
+      perform_enqueued_jobs
+    end
+
+    assert_requested :post, "https://example.com/webhook"
+    assert_equal "application/json", captured.headers["Content-Type"]
+
+    payload = JSON.parse(captured.body)
+    assert_equal "mention", payload["event"]
+    assert_equal({ "id" => users(:david).id, "name" => "David" }, payload["author"])
+    assert_equal @room.id, payload["room"]["id"]
+    assert_equal @room.name, payload["room"]["name"]
+    assert_equal "/rooms/#{@room.id}/#{@bot.bot_code}/messages", payload["room"]["reply_to"]
+    assert_equal message.id, payload["message"]["id"]
+    assert_equal "restart the build please", payload["message"]["body"]["text"]
+    assert_includes payload["message"]["body"]["html"], "restart the build please"
+    assert_equal "/rooms/#{@room.id}/@#{message.id}", payload["message"]["link"]
+
+    reply = Message.where(creator: @bot).last
+    assert_equal @room, reply.room
+    assert_equal "Build restarted!", reply.plain_text_body
+  end
+
+  test "a 204 response posts no message" do
+    stub_request(:post, "https://example.com/webhook").to_return(status: 204)
+
+    create_mention_message
+
+    assert_no_difference -> { Message.where(creator: @bot).count } do
+      perform_enqueued_jobs
+    end
+    assert_requested :post, "https://example.com/webhook"
+  end
+
+  test "an HTML reply is posted as the bot's message" do
+    stub_request(:post, "https://example.com/webhook")
+      .to_return(status: 200, body: "<p>Build <strong>restarted</strong></p>", headers: { "Content-Type" => "text/html" })
+
+    create_mention_message
+    perform_enqueued_jobs
+
+    reply = Message.where(creator: @bot).last
+    assert reply
+    assert_equal "Build restarted", reply.plain_text_body
+  end
+
+  test "a non-text 200 response and an error response post no message" do
+    stub_request(:post, "https://example.com/webhook")
+      .to_return(status: 200, body: "{\"ok\":true}", headers: { "Content-Type" => "application/json" })
+
+    create_mention_message
+
+    assert_no_difference -> { Message.where(creator: @bot).count } do
+      perform_enqueued_jobs
+    end
+
+    stub_request(:post, "https://example.com/webhook").to_return(status: 500, body: "boom", headers: { "Content-Type" => "text/plain" })
+    create_mention_message(body_text: "try again")
+
+    assert_no_difference -> { Message.where(creator: @bot).count } do
+      perform_enqueued_jobs
+    end
+  end
+
+  test "a failing webhook does not raise" do
+    stub_request(:post, "https://example.com/webhook").to_raise(Errno::ECONNREFUSED)
+
+    create_mention_message
+
+    assert_no_difference -> { Message.where(creator: @bot).count } do
+      perform_enqueued_jobs
+    end
+  end
+
+  test "mentioning a person or a bot without a webhook enqueues no webhook delivery" do
+    assert_no_enqueued_jobs(only: BotWebhookDeliveryJob) do
+      @room.messages.create!(creator: users(:david), body: "<div>Hey #{mention_attachment_for(:kevin)}</div>", client_message_id: "person-mention")
+    end
+
+    webhookless = Bot.create!(name: "Quiet Bot", creator: users(:david))
+    assert_no_enqueued_jobs(only: BotWebhookDeliveryJob) do
+      @room.messages.create!(creator: users(:david), body: "<div>Hey #{mention_attachment_for(webhookless)} hi</div>", client_message_id: "webhookless-mention")
+    end
+  end
+
+  test "a bot's own message mentioning itself enqueues no webhook delivery" do
+    assert_no_enqueued_jobs(only: BotWebhookDeliveryJob) do
+      @room.messages.create!(creator: @bot, body: "<div>#{mention_attachment_for(@bot)} hi</div>", client_message_id: "self-mention")
+    end
+  end
+
+  private
+    def create_mention_message(body_text: "restart the build please")
+      @room.messages.create!(
+        creator: users(:david),
+        body: "<div>#{mention_attachment_for(@bot)} #{body_text}</div>",
+        client_message_id: SecureRandom.uuid
+      )
+    end
+end
