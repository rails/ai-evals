diff --git a/app/jobs/bot_webhook_delivery_job.rb b/app/jobs/bot_webhook_delivery_job.rb
new file mode 100644
index 0000000..2824e45
--- /dev/null
+++ b/app/jobs/bot_webhook_delivery_job.rb
@@ -0,0 +1,105 @@
+require "net/http"
+
+# Delivers a "mention" event to a bot's webhook and posts a synchronous
+# reply back into the room, if the bot sends one.
+#
+# This runs in a background job so that talking to a bot's webhook never
+# slows down the person who posted the message mentioning the bot. The
+# bot can also reply asynchronously at any later time by posting to the
+# +reply_to+ URL handed to it in the payload (see Rooms::BotMessagesController).
+class BotWebhookDeliveryJob < ApplicationJob
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+  WRITE_TIMEOUT = 5.seconds
+
+  REPLY_CONTENT_TYPES = %w[ text/plain text/html ].freeze
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bot, message)
+    return unless bot.is_a?(Bot) && bot.active? && bot.webhook_url.present?
+    return if message.creator_id == bot.id
+
+    response = post_webhook(bot, message)
+    post_reply(bot, message, response) if response
+  rescue => error
+    # A bot's webhook being unreachable, slow, or broken must never
+    # affect the room's messages, so failures are logged, not raised.
+    Rails.logger.error "Bot webhook delivery failed for bot #{bot&.id} and message #{message&.id}: #{error.class}: #{error.message}"
+  end
+
+  private
+    def post_webhook(bot, message)
+      uri = URI.parse(bot.webhook_url.to_s)
+      return unless uri.is_a?(URI::HTTP) && uri.host.present?
+
+      request = Net::HTTP::Post.new(uri)
+      request.content_type = "application/json"
+      request.body = webhook_payload(bot, message).to_json
+
+      Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT, write_timeout: WRITE_TIMEOUT) do |http|
+        http.request(request)
+      end
+    end
+
+    def post_reply(bot, message, response)
+      return unless response.is_a?(Net::HTTPOK)
+      return unless reply_content_type?(response)
+
+      body = response.body.to_s.dup.force_encoding(Encoding::UTF_8)
+      body = body.scrub unless body.valid_encoding?
+      return if body.blank?
+
+      Current.set(user: bot) do
+        reply = message.room.messages.create!(body: body, creator: bot)
+        reply.broadcast_create
+      end
+    rescue ActiveRecord::RecordInvalid => error
+      Rails.logger.error "Bot webhook reply could not be posted for bot #{bot.id} and message #{message.id}: #{error.message}"
+    end
+
+    def reply_content_type?(response)
+      content_type = response.content_type.to_s.downcase.strip
+      # A reply with no declared Content-Type can only sensibly be text.
+      content_type.blank? || REPLY_CONTENT_TYPES.include?(content_type)
+    end
+
+    def webhook_payload(bot, message)
+      room = message.room
+      author = message.creator
+      url_helpers = Rails.application.routes.url_helpers
+
+      {
+        event: "mention",
+        author: { id: author.id, name: author.name },
+        room: {
+          id: room.id,
+          name: room.name,
+          reply_to: url_helpers.room_bot_messages_path(room_id: room.id, bot_code: bot.bot_code)
+        },
+        message: {
+          id: message.id,
+          body: {
+            text: message_text_without_bot_mention(bot, message),
+            html: message_html(message)
+          },
+          link: url_helpers.room_at_message_path(room, message)
+        }
+      }
+    end
+
+    def message_html(message)
+      message.body&.body&.to_html
+    end
+
+    # The bot's own @-mention reads as addressing in the room, but to the
+    # bot the remaining text is the command, so strip the mention (and
+    # tidy up the whitespace/punctuation it leaves behind).
+    def message_text_without_bot_mention(bot, message)
+      text = message.plain_text_body.gsub("@#{bot.name}", "")
+      text = text.gsub(/[ \t]+/, " ")
+      text = text.gsub(/ +([,.;:!?])/, '\1')
+      text.strip.sub(/\A[,;:]\s*/, "").strip
+    end
+end
