--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,12 @@
+module SearchesHelper
+  def search_matches?(text, search_terms)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    downcased_text = plain_text.downcase
+
+    Array(search_terms).any? { |term| downcased_text.include?(term.to_s.downcase) }
+  end
+
+  def matching_comments(card, search_terms)
+    card.comments.select { |comment| search_matches?(comment.body, search_terms) }
+  end
+end
