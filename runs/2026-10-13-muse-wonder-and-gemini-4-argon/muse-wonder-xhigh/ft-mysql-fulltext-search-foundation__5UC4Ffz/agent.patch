diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..da05504
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,29 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(term) {
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term.to_s.downcase)}%"
+
+      where(<<~SQL.squish, pattern: pattern, escape: "\\")
+        LOWER(cards.title) LIKE :pattern ESCAPE :escape
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Card'
+            AND action_text_rich_texts.name = 'description'
+            AND action_text_rich_texts.record_id = cards.id
+            AND LOWER(action_text_rich_texts.body) LIKE :pattern ESCAPE :escape
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts AS comment_rich_texts
+            ON comment_rich_texts.record_type = 'Comment'
+            AND comment_rich_texts.name = 'body'
+            AND comment_rich_texts.record_id = comments.id
+          WHERE comments.card_id = cards.id
+            AND LOWER(comment_rich_texts.body) LIKE :pattern ESCAPE :escape
+        )
+      SQL
+    }
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..fd50c06
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel borderless center margin pad flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex gap" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input flex-item-grow", autofocus: true, autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <ul class="search-results flex flex-column gap txt-align-start">
+        <% @cards.each do |card| %>
+          <li class="search-result pad" style="border-block-end: 1px solid var(--color-ink-lighter)">
+            <div class="flex flex-column gap-half">
+              <div>
+                <%= link_to card_path(card), class: "txt-large" do %><%= highlight(card.title.to_s, @search_terms) %><% end %>
+                <span class="txt-small translucent">in <%= card.board.name %></span>
+              </div>
+
+              <% if card.description.present? %>
+                <p><%= highlight(card.description.to_plain_text, @search_terms) %></p>
+              <% end %>
+
+              <% matching_comments(card, @search_terms).each do |comment| %>
+                <div class="search-result__comment">
+                  <span class="txt-small translucent">Comment:</span>
+                  <p><%= highlight(comment.body.to_plain_text, @search_terms) %></p>
+                </div>
+              <% end %>
+            </div>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <p class="blank-slate">No cards found for “<%= @query %>”</p>
+    <% end %>
+  <% end %>
+</section>
