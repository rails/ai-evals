@@ -0,0 +1,23 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @search_terms = @query.split(/\s+/)
+    @cards = search_cards
+  end
+
+  private
+    def search_cards
+      if @search_terms.any?
+        @search_terms.reduce(accessible_published_cards) do |cards, term|
+          cards.matching(term)
+        end
+      else
+        Card.none
+      end
+    end
+
+    def accessible_published_cards
+      Current.user.accessible_cards.published.reverse_chronologically
+        .includes(:board, :rich_text_description, comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
