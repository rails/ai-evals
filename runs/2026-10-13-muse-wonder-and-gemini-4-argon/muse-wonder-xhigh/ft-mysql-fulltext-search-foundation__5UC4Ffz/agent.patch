diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..8433e30
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "finds cards by title" do
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "mark", text: "logo"
+    assert_includes response.body, cards(:logo).title.sub("logo", "<mark>logo</mark>")
+  end
+
+  test "finds cards by description" do
+    card = boards(:writebook).cards.create!(title: "Plain title", description: "A zebracorn appears here", status: "published", creator: users(:kevin))
+
+    get search_path(q: "zebracorn")
+    assert_response :success
+    assert_includes response.body, card_path(card)
+    assert_includes response.body, "<mark>zebracorn</mark>"
+  end
+
+  test "finds cards by comment body" do
+    card = boards(:writebook).cards.create!(title: "Another plain title", status: "published", creator: users(:kevin))
+    card.comments.create!(body: "Notes about the zebracorn", creator: users(:kevin))
+
+    get search_path(q: "zebracorn")
+    assert_response :success
+    assert_includes response.body, card_path(card)
+    assert_includes response.body, "<mark>zebracorn</mark>"
+  end
+
+  test "finds cards by fixture comment bodies" do
+    get search_path(q: "overflowing")
+    assert_response :success
+    assert_includes response.body, "<mark>overflowing</mark>"
+    assert_includes response.body, card_path(cards(:layout))
+  end
+
+  test "returns results newest first" do
+    older = boards(:writebook).cards.create!(title: "Older quixotic card", status: "published", creator: users(:kevin), created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Newer quixotic card", status: "published", creator: users(:kevin), created_at: 1.day.ago)
+
+    get search_path(q: "quixotic")
+    assert_response :success
+    assert response.body.index("Newer") < response.body.index("Older"), "expected newest card first"
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    inaccessible_board = Board.create!(name: "Inaccessible search board", creator: users(:david))
+    inaccessible_board.cards.create!(title: "Secret zebracorn card", status: "published", creator: users(:david))
+
+    get search_path(q: "zebracorn")
+    assert_response :success
+    assert_not_includes response.body, "Secret zebracorn card"
+  end
+
+  test "does not return cards from a board after access is revoked" do
+    private_card = boards(:private).cards.create!(title: "Private zebracorn card", status: "published", creator: users(:kevin))
+
+    get search_path(q: "zebracorn")
+    assert_includes response.body, "Private"
+
+    logout_and_sign_in_as :david
+    get search_path(q: "zebracorn")
+    assert_response :success
+    assert_not_includes response.body, "Private zebracorn card"
+    assert_not_includes response.body, card_path(private_card)
+  end
+
+  test "does not return draft cards or cards matched only by comments on drafts" do
+    boards(:writebook).cards.create!(title: "Draft zebracorn card", status: "drafted", creator: users(:kevin))
+
+    formerly_published = boards(:writebook).cards.create!(title: "Plain draft container", status: "published", creator: users(:kevin))
+    formerly_published.comments.create!(body: "zebracorn draft comment", creator: users(:kevin))
+    formerly_published.update!(status: "drafted")
+
+    get search_path(q: "zebracorn")
+    assert_response :success
+    assert_not_includes response.body, "Draft zebracorn card"
+    assert_not_includes response.body, "Plain draft container"
+    assert_not_includes response.body, "zebracorn draft comment"
+  end
+
+  test "matching is case-insensitive and highlighting preserves the original case" do
+    get search_path(q: "LOGO")
+    assert_response :success
+    assert_includes response.body, "<mark>logo</mark>"
+  end
+
+  test "blank query returns no results" do
+    get search_path(q: "")
+    assert_response :success
+    assert_not_includes response.body, cards(:logo).title
+
+    get search_path
+    assert_response :success
+    assert_not_includes response.body, cards(:logo).title
+  end
+
+  test "search terms are not treated as SQL wildcards" do
+    get search_path(q: "%")
+    assert_response :success
+    assert_not_includes response.body, cards(:logo).title
+  end
+
+  test "underscores in search terms are matched literally" do
+    literal = boards(:writebook).cards.create!(title: "hello_world zeb", status: "published", creator: users(:kevin))
+    other = boards(:writebook).cards.create!(title: "helloXworld zeb", status: "published", creator: users(:kevin))
+
+    get search_path(q: "hello_world")
+    assert_response :success
+    assert_includes response.body, card_path(literal)
+    assert_not_includes response.body, card_path(other)
+  end
+
+  test "escapes HTML in titles and queries while highlighting" do
+    card = boards(:writebook).cards.create!(title: "<script>alert(1)</script> Magic Needle", status: "published", creator: users(:kevin))
+
+    get search_path(q: "magic needle")
+    assert_response :success
+    assert_includes response.body, card_path(card)
+    assert_includes response.body, "<mark>Magic</mark>"
+    assert_not_includes response.body, "<script>alert"
+
+    get search_path(q: "<script>alert(1)</script>")
+    assert_response :success
+    assert_not_includes response.body, "<script>alert"
+  end
+
+  test "returns a card only once when it matches in several places" do
+    card = boards(:writebook).cards.create!(title: "Unicorn title", description: "Unicorn description", status: "published", creator: users(:kevin))
+    card.comments.create!(body: "Unicorn comment", creator: users(:kevin))
+
+    get search_path(q: "unicorn")
+    assert_response :success
+    assert_select ".search-result", count: 1
+  end
+end
