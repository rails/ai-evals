diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..6c10556 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,39 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Make controller errors raise inside the block, and render error
+    # pages again outside it.
+    #
+    # Changing +config.action_dispatch.show_exceptions+ alone does not
+    # work: Rails memoizes that setting into
+    # +Rails.application.env_config+ the first time a request is built
+    # in a process, and every later request reads the memoized copy
+    # (see Rails::Application#env_config). Toggling only the config
+    # therefore either does nothing at all (if a request has already
+    # run, so env_config is frozen at :rescuable) or poisons the rest
+    # of the process (if this runs first, so env_config is frozen at
+    # :none even after the config is restored). Which failure you got
+    # depended on which test happened to run first in each parallel
+    # worker.
+    #
+    # Toggle the memoized env_config entry -- the value requests
+    # actually see -- alongside the config, and restore both to
+    # exactly their previous values, whatever they were. Capturing
+    # env_config first also forces its memoization with the
+    # pre-block value, so restoring it can never leave :none behind.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config = Rails.application.env_config
+      previous_config = Rails.application.config.action_dispatch.show_exceptions
+      previous_env_config = env_config["action_dispatch.show_exceptions"]
+
+      begin
+        Rails.application.config.action_dispatch.show_exceptions = :none
+        env_config["action_dispatch.show_exceptions"] = :none
+        yield
+      ensure
+        Rails.application.config.action_dispatch.show_exceptions = previous_config
+        env_config["action_dispatch.show_exceptions"] = previous_env_config
+      end
     end
   end
 end
