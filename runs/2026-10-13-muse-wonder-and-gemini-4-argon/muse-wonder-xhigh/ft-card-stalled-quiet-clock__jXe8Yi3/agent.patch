@@ -0,0 +1,27 @@
+require "test_helper"
+
+class CardsStalledIndexTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index can list stalled cards and cards show they are stalled" do
+    Current.session = sessions(:kevin)
+    card = cards(:layout)
+    card.toggle_assignment(users(:david))
+    card.update!(last_active_at: 15.days.ago)
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ card.number ], @response.parsed_body.pluck("number")
+    assert_equal true, @response.parsed_body.first["stalled"]
+
+    get card_path(card)
+    assert_response :success
+    assert_match "Stalled", @response.body
+
+    get cards_path, params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_match "Stalled", @response.body
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..fc5603b
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from at least two people within a third of the auto-close period is a burst that stalls after two weeks without activity" do
+    card = cards(:layout)
+
+    card.comments.create!(creator: users(:david), body: "First")
+    card.comments.create!(creator: users(:kevin), body: "Second")
+    card.comments.create!(creator: users(:david), body: "Third")
+
+    assert card.reload.burst?
+    assert_not card.stalled?
+
+    card.update!(last_active_at: 15.days.ago)
+
+    assert card.stalled?
+    assert_includes Card.stalled, card
+    assert_includes Card.indexed_by("stalled"), card
+  end
+
+  test "three comments from a single person is not a burst" do
+    card = cards(:layout)
+
+    3.times { |i| card.comments.create!(creator: users(:david), body: "Comment #{i}") }
+    card.update!(last_active_at: 15.days.ago)
+
+    assert_not card.reload.burst?
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "three comments spread over more than a third of the auto-close period is not a burst" do
+    card = cards(:layout)
+    start = Time.utc(2026, 1, 1, 12, 0, 0)
+
+    travel_to start do
+      card.comments.create!(creator: users(:david), body: "First")
+    end
+    travel_to start + 20.days do
+      card.comments.create!(creator: users(:kevin), body: "Second")
+    end
+    travel_to start + 40.days do
+      card.comments.create!(creator: users(:david), body: "Third")
+    end
+
+    travel_to start + 55.days do
+      assert_not card.reload.burst?
+      assert_not card.stalled?
+    end
+  end
+
+  test "being assigned is a burst" do
+    card = cards(:layout)
+
+    card.toggle_assignment(users(:kevin))
+    card.update!(last_active_at: 15.days.ago)
+
+    assert card.reload.stalled?
+    assert_includes Card.indexed_by("stalled"), card
+  end
+
+  test "being reopened is a burst" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    card.reopen
+    card.update!(last_active_at: 15.days.ago)
+
+    assert card.reload.stalled?
+  end
+
+  test "a card without a burst does not stall" do
+    card = cards(:buy_domain)
+
+    card.update!(last_active_at: 15.days.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "activity resets a stalled card" do
+    card = cards(:layout)
+
+    card.toggle_assignment(users(:kevin))
+    card.update!(last_active_at: 15.days.ago)
+    assert card.reload.stalled?
+
+    card.comments.create!(creator: users(:kevin), body: "Any update?")
+
+    assert_not card.reload.stalled?
+    assert_not card.burst?
+
+    card.update!(last_active_at: 15.days.ago)
+    assert_not card.reload.stalled?
+  end
+
+  test "activity before a card stalls resets the burst" do
+    card = cards(:layout)
+
+    card.toggle_assignment(users(:kevin))
+    card.comments.create!(creator: users(:kevin), body: "Looking at this")
+    card.update!(last_active_at: 15.days.ago)
+
+    assert_not card.reload.stalled?
+  end
+end
