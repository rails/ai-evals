diff --git a/app/jobs/title_cleanup_job.rb b/app/jobs/title_cleanup_job.rb
index 13721ed..083fda5 100644
--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,7 +1,24 @@
 class TitleCleanupJob < ApplicationJob
+  include ActiveJob::Continuable
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    step :clean_titles do |step|
+      # Only leaves that have not been cleaned yet are eligible. Cleaning a
+      # leaf and recording that it has been cleaned happen in the same
+      # update, so an interruption can never leave a leaf cleaned but
+      # unrecorded (or vice versa): on a restart it is either skipped
+      # because it was already done, or it still holds its original title
+      # and is cleaned then -- exactly once either way.
+      Leaf.where(title_cleaned_at: nil).find_each(start: step.cursor, order: :asc) do |leaf|
+        leaf.update!(title: cleaned(leaf.title), title_cleaned_at: Time.current)
+
+        # Advance (and checkpoint) only after the leaf has been cleaned.
+        # If the job is interrupted here it resumes at the next leaf; if
+        # it is interrupted before this point, at most this one leaf is
+        # visited again, and -- having not been marked cleaned yet -- it
+        # is still holding its original title when it is.
+        step.advance! from: leaf.id
+      end
     end
   end
 
diff --git a/app/models/leaf.rb b/app/models/leaf.rb
index fb7e68b..6287eda 100644
--- a/app/models/leaf.rb
+++ b/app/models/leaf.rb
@@ -11,7 +11,19 @@ class Leaf < ApplicationRecord
 
   scope :with_leafables, -> { includes(:leafable) }
 
+  # A title that is replaced after TitleCleanupJob has cleaned it has not
+  # itself been cleaned yet. The job cleans a leaf and stamps
+  # title_cleaned_at in the same update, so a change to title_cleaned_at
+  # alongside the title means the stamp belongs to this title and must
+  # be kept; any other title change clears it.
+  before_save :clear_title_cleaned_at, if: -> { will_save_change_to_title? && !will_save_change_to_title_cleaned_at? }
+
   def slug
     title.parameterize.presence || "-"
   end
+
+  private
+    def clear_title_cleaned_at
+      self.title_cleaned_at = nil
+    end
 end
