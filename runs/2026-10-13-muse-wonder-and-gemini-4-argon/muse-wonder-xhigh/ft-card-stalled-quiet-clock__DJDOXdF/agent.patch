@@ -0,0 +1,39 @@
+require "test_helper"
+
+class CardsStalledControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    @card = cards(:text)
+    @card.comments.delete_all
+    @card.assignments.delete_all
+    @card.events.delete_all
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:kevin))
+    @card.comments.create!(body: "Three", creator: users(:david))
+    @card.update!(last_active_at: 15.days.ago)
+  end
+
+  test "index with indexed_by=stalled lists stalled cards as JSON" do
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("number"), @card.number
+    assert @response.parsed_body.find { |entry| entry["number"] == @card.number }["stalled"]
+  end
+
+  test "index with indexed_by=stalled shows stalled cards in HTML" do
+    get cards_path, params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_match "Stalled", @response.body
+    assert_match @card.title, @response.body
+  end
+
+  test "show displays stalled on the card" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_match "Stalled", @response.body
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..2721da2
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,183 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+    @card.comments.delete_all
+    @card.assignments.delete_all
+    @card.events.delete_all
+  end
+
+  test "three comments from at least two people within a third of the auto-close period is a burst" do
+    add_comments
+
+    assert @card.burst?
+    assert @card.had_burst?
+  end
+
+  test "three comments from a single person is not a burst" do
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:david))
+    @card.comments.create!(body: "Three", creator: users(:david))
+
+    assert_not @card.burst?
+  end
+
+  test "comments spread over more than a third of the auto-close period is not a burst" do
+    # The writebook board auto-closes after 90 days, so the burst window is 30 days.
+    travel_to 60.days.ago do
+      @card.comments.create!(body: "One", creator: users(:david))
+    end
+
+    travel_to 40.days.ago do
+      @card.comments.create!(body: "Two", creator: users(:kevin))
+    end
+
+    travel_to 20.days.ago do
+      @card.comments.create!(body: "Three", creator: users(:david))
+    end
+
+    assert_not @card.burst?
+  end
+
+  test "a later cluster of comments can form a burst even if earlier comments are outside the window" do
+    travel_to 60.days.ago do
+      @card.comments.create!(body: "Early", creator: users(:david))
+    end
+
+    add_comments
+
+    assert @card.burst?
+  end
+
+  test "system comments do not count towards a burst" do
+    @card.comments.create!(body: "One", creator: @card.account.system_user)
+    @card.comments.create!(body: "Two", creator: @card.account.system_user)
+    @card.comments.create!(body: "Three", creator: users(:david))
+
+    assert_not @card.burst?
+  end
+
+  test "being assigned is a burst" do
+    assert_not @card.burst?
+
+    with_current_user(:david) do
+      @card.toggle_assignment(users(:kevin))
+    end
+
+    assert @card.burst?
+  end
+
+  test "assignment records count as a burst even without an event" do
+    @card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+
+    assert @card.burst?
+  end
+
+  test "reopening is a burst" do
+    shipped = cards(:shipping)
+    shipped.comments.delete_all
+
+    assert_not shipped.burst?
+
+    shipped.reopen
+
+    assert shipped.burst?
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    add_comments
+
+    travel 13.days do
+      assert_not @card.stalled?
+    end
+
+    travel 15.days do
+      assert @card.stalled?
+      assert_includes Card.stalled, @card
+      assert_includes Card.indexed_by("stalled"), @card
+    end
+  end
+
+
+test "an assigned card is stalled after two weeks without activity" do
+  with_current_user(:david) do
+    @card.toggle_assignment(users(:kevin))
+  end
+
+  travel 15.days do
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+end
+
+test "a reopened card is stalled after two weeks without activity" do
+  shipped = cards(:shipping)
+  shipped.reopen
+
+  travel 15.days do
+    assert shipped.stalled?
+    assert_includes Card.stalled, shipped
+  end
+end
+
+  test "a card without a burst is not stalled even after two weeks without activity" do
+    @card.comments.create!(body: "Only one", creator: users(:david))
+
+    travel 30.days do
+      assert_not @card.stalled?
+      assert_not_includes Card.stalled, @card
+      assert_not_includes Card.indexed_by("stalled"), @card
+    end
+  end
+
+  test "a card with a burst but recent activity is not stalled" do
+    add_comments
+
+    travel 15.days do
+      assert @card.stalled?
+
+      @card.comments.create!(body: "Back again", creator: users(:david))
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "any activity resets a stalled card" do
+    add_comments
+
+    travel 15.days do
+      assert @card.stalled?
+
+      @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+      assert_not @card.reload.stalled?
+    end
+  end
+
+  test "stalled scope respects the board auto-close period for the burst window" do
+    # A board with a 30-day auto-close period has a 10-day burst window.
+    boards(:writebook).entropy.update!(auto_postpone_period: 30.days.to_i)
+
+    travel_to 20.days.ago do
+      @card.comments.create!(body: "One", creator: users(:david))
+    end
+
+    travel_to 12.days.ago do
+      @card.comments.create!(body: "Two", creator: users(:kevin))
+    end
+
+    @card.comments.create!(body: "Three", creator: users(:david))
+
+    assert_not @card.burst?
+  end
+
+  private
+    def add_comments
+      @card.comments.create!(body: "One", creator: users(:david))
+      @card.comments.create!(body: "Two", creator: users(:kevin))
+      @card.comments.create!(body: "Three", creator: users(:david))
+    end
+end
