diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..dd1a905
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,143 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+  BURST_COMMENT_THRESHOLD = 3
+  BURST_CREATOR_THRESHOLD = 2
+
+  included do
+    scope :stalled, -> {
+      inactive = where(last_active_at: ..STALLED_AFTER.ago)
+      inactive.where(id: burst_card_ids(inactive))
+    }
+  end
+
+  class_methods do
+    def burst_card_ids(cards)
+      card_ids = cards.reorder(nil).distinct.pluck(:id)
+
+      if card_ids.any?
+        burst_card_ids = []
+        burst_card_ids.concat Assignment.where(card_id: card_ids).distinct.pluck(:card_id)
+        burst_card_ids.concat Event.where(eventable_type: "Card", eventable_id: card_ids, action: BURST_ACTIONS).distinct.pluck(:eventable_id)
+
+        remaining_card_ids = card_ids - burst_card_ids
+
+        if remaining_card_ids.any?
+          burst_card_ids.concat comment_burst_card_ids(remaining_card_ids)
+        end
+
+        burst_card_ids
+      else
+        []
+      end
+    end
+
+    def comment_burst?(entries, window)
+      sorted_entries = entries.sort_by(&:first)
+      creators = Hash.new(0)
+      window_start = 0
+      burst = false
+
+      sorted_entries.each_with_index do |(created_at, creator_id), index|
+        creators[creator_id] += 1
+
+        while created_at - sorted_entries[window_start].first > window
+          expired_creator_id = sorted_entries[window_start].last
+          creators[expired_creator_id] -= 1
+          creators.delete(expired_creator_id) if creators[expired_creator_id].zero?
+          window_start += 1
+        end
+
+        if index - window_start + 1 >= BURST_COMMENT_THRESHOLD && creators.size >= BURST_CREATOR_THRESHOLD
+          burst = true
+          break
+        end
+      end
+
+      burst
+    end
+
+    private
+      def comment_burst_card_ids(card_ids)
+        periods = burst_periods_by_card_id(card_ids)
+        comments_by_card = Comment.where(card_id: card_ids).by_user.order(:created_at).pluck(:card_id, :created_at, :creator_id).group_by(&:first)
+
+        card_ids.select do |card_id|
+          entries = Array(comments_by_card[card_id]).map { |_, created_at, creator_id| [ created_at, creator_id ] }
+          comment_burst?(entries, periods.fetch(card_id, Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i) / 3.0)
+        end
+      end
+
+      def burst_periods_by_card_id(card_ids)
+        Card.where(id: card_ids).includes(board: [ :entropy, { account: :entropy } ]).each_with_object({}) do |card, periods|
+          begin
+            period = card.auto_postpone_period
+            periods[card.id] = period.present? && period.to_i.positive? ? period.to_i : Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i
+          rescue StandardError
+            periods[card.id] = Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i
+          end
+        end
+      end
+  end
+
+  def stalled?
+    if last_active_at.present?
+      last_active_at <= STALLED_AFTER.ago && burst?
+    else
+      false
+    end
+  end
+
+  def burst?
+    burst_activity? || comment_burst?
+  end
+  alias_method :had_burst?, :burst?
+  alias_method :has_burst?, :burst?
+  alias_method :bursted?, :burst?
+
+  def burst_window
+    period = begin
+      auto_postpone_period if respond_to?(:auto_postpone_period)
+    rescue StandardError
+      nil
+    end
+    period = Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i unless period.present? && period.to_i.positive?
+    period.to_i / 3.0
+  end
+
+  private
+    def burst_activity?
+      burst_event? || assignment_present? || reopened_event?
+    end
+
+    def assignment_present?
+      if assignments.loaded?
+        assignments.any?
+      else
+        assignments.exists?
+      end
+    end
+
+    def reopened_event?
+      if events.loaded?
+        events.any? { |event| event.action.to_s == "card_reopened" }
+      else
+        events.where(action: "card_reopened").exists?
+      end
+    end
+
+    def burst_event?
+      if events.loaded?
+        events.any? { |event| BURST_ACTIONS.include?(event.action.to_s) }
+      else
+        events.where(action: BURST_ACTIONS).exists?
+      end
+    end
+
+    def comment_burst?
+      entries = comments.by_user.chronologically.pluck(:created_at, :creator_id)
+      self.class.comment_burst?(entries, burst_window)
+    end
+end
