diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..00a5008 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,61 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  def incinerate
+    destroy!
+    remove_remaining_data
+  end
+
+  private
+    # dependent: :destroy associations cover most account data, but some
+    # records are only loosely tied to an account (storage ledger entries,
+    # search index records, uploaded files) and would otherwise be left
+    # behind pointing at an account that no longer exists.
+    def remove_remaining_data
+      Storage::Entry.where(account_id: id).delete_all
+      Search::Record.for(id).where(account_id: id).destroy_all
+
+      ActionText::RichText.where(account_id: id).destroy_all
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:purge)
+      ActiveStorage::Blob.where(account_id: id).left_joins(:attachments).where(active_storage_attachments: { id: nil }).find_each(&:purge)
+
+      remove_remaining_account_scoped_records
+    end
+
+    def remove_remaining_account_scoped_records
+      account_scoped_models.each do |model|
+        model.where(account_id: id).delete_all
+      end
+    end
+
+    def account_scoped_models
+      Rails.application.eager_load! unless Rails.application.config.eager_load
+
+      # ActiveStorage blobs and variants are handled above: a blob can be
+      # shared with records outside the account (e.g. an identity avatar), so
+      # only blobs left without any attachments are purged.
+      models = ApplicationRecord.descendants + [ ActionText::RichText, ActiveStorage::Attachment ]
+
+      models.uniq.reject do |model|
+        model.abstract_class? || model == Account || !model.table_exists? || !model.column_names.include?("account_id")
+      rescue StandardError
+        true
+      end
+    end
 end
