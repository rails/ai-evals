diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8e35b7d
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago and their data" do
+    card = @account.cards.first
+    card.image.attach io: StringIO.new("x" * 1024), filename: "test.png", content_type: "image/png"
+
+    board_ids = @account.boards.pluck(:id)
+    card_ids = @account.cards.pluck(:id)
+    user_ids = @account.users.pluck(:id)
+    identity_ids = @account.users.pluck(:identity_id).compact
+    blob_ids = ActiveStorage::Blob.where(account_id: @account.id).pluck(:id)
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty Board.where(id: board_ids)
+    assert_empty Card.where(id: card_ids)
+    assert_empty User.where(id: user_ids)
+    assert_empty Comment.where(account_id: @account.id)
+    assert_empty Event.where(account_id: @account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty ActiveStorage::Blob.where(id: blob_ids)
+    assert_empty Search::Record.for(@account.id).where(account_id: @account.id)
+
+    # Identities are global and can belong to other accounts, so they remain.
+    assert_equal identity_ids.count, Identity.where(id: identity_ids).count
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps accounts that have not been cancelled" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps other accounts when incinerating a due account" do
+    other_account = accounts(:initech)
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(other_account.id)
+    assert User.exists?(users(:mike).id)
+  end
+end
