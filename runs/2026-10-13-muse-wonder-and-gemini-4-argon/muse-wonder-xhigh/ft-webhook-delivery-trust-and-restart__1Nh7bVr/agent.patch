@@ -0,0 +1,26 @@
+class Webhook::DeliveryJob < ApplicationJob
+  queue_as :webhooks
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(delivery = nil, event = nil)
+    if event.is_a?(Event) && delivery.is_a?(Webhook)
+      delivery_for(delivery, event)&.deliver
+    elsif delivery.is_a?(Event)
+      delivery.board.webhooks.active.each do |webhook|
+        delivery_for(webhook, delivery)&.deliver
+      end
+    elsif delivery.is_a?(String) || delivery.is_a?(Integer)
+      Webhook::Delivery.find_by(id: delivery)&.deliver
+    else
+      delivery&.deliver
+    end
+  end
+
+  private
+    def delivery_for(webhook, event)
+      if webhook.active? && webhook.subscribed_to?(event.action)
+        webhook.deliveries.find_or_create_by!(event: event)
+      end
+    end
+end
