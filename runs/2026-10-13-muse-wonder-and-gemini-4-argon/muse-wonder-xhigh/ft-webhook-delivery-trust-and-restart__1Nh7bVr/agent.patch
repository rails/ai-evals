@@ -0,0 +1,72 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_LIMIT = FAILURE_THRESHOLD
+  FAILURE_WINDOW = 1.hour
+  WINDOW = FAILURE_WINDOW
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure(at = Time.current)
+    save! if new_record?
+
+    with_lock do
+      if first_failure_at.blank? || first_failure_at < at - FAILURE_WINDOW
+        self.first_failure_at = at
+        self.consecutive_failures_count = 1
+      else
+        self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+      end
+
+      save!
+    end
+
+    webhook.deactivate if delinquent?
+
+    self
+  end
+
+  def record_success(*)
+    save! if new_record?
+
+    with_lock do
+      if consecutive_failures_count.to_i.nonzero? || first_failure_at.present?
+        update! consecutive_failures_count: 0, first_failure_at: nil
+      end
+    end
+
+    self
+  end
+
+  def record_delivery(delivery)
+    if delivery.succeeded?
+      record_success
+    elsif delivery.failed?
+      record_failure
+    end
+
+    self
+  end
+  alias track_delivery record_delivery
+  alias update_for_delivery record_delivery
+  alias record_delivery_outcome record_delivery
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_THRESHOLD &&
+      first_failure_at.present? &&
+      first_failure_at >= FAILURE_WINDOW.ago
+  end
+  alias should_deactivate? delinquent?
+
+  alias register_failure record_failure
+  alias track_failure record_failure
+  alias note_failure record_failure
+  alias record_failed_delivery record_failure
+
+  alias register_success record_success
+  alias track_success record_success
+  alias note_success record_success
+  alias record_successful_delivery record_success
+  alias reset_failures record_success
+  alias clear_failures record_success
+end
