+  <% if board.present? %>
+    <hr class="notification__board-separator">
+    <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+  <% end %>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload.to_h %>
+    <div class="notification">
+      <p class="notification__author"><%= notification.creator&.name %></p>
+      <div class="notification__details">
+        <div class="card__title"><%= payload[:title] %></div>
+        <div><%= payload[:body] %></div>
+        <p><%= link_to "View", payload[:url] %></p>
+      </div>
+    </div>
+  <% end %>
+<% end %>
+
+<p><%= link_to "See all your notifications", notifications_url %></p>
+
+<p class="footer">You're receiving this email because you chose to receive your Fizzy notifications in bundles.</p>
