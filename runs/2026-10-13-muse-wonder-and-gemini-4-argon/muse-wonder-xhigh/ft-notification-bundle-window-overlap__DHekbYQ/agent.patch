@@ -0,0 +1,19 @@
+<section class="settings__section">
+  <h2 class="divider">Email</h2>
+
+  <p>Get your notifications in a single bundled email instead of one email per notification.</p>
+
+  <%= form_with model: Current.user.settings, url: notifications_settings_path, method: :patch, scope: :user_settings, data: { controller: "form" } do |form| %>
+    <%= form.label :bundle_email_frequency, "Bundle my notifications by email" %>
+    <%= form.select :bundle_email_frequency,
+          options_for_select({
+            "Never" => "never",
+            "Every four hours" => "every_few_hours",
+            "Daily" => "daily",
+            "Weekly" => "weekly"
+          }, Current.user.settings.bundle_email_frequency),
+          {},
+          class: "input input--select",
+          data: { action: "change->form#submit" } %>
+  <% end %>
+</section>
