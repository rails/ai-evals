diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..d69ffa7
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,44 @@
+class NotificationMailer < ApplicationMailer
+  def bundle_email(bundle)
+    build_bundle_email(bundle)
+  end
+
+  def bundle(bundle)
+    build_bundle_email(bundle)
+  end
+
+  def digest(bundle)
+    build_bundle_email(bundle)
+  end
+
+  def notification_digest(bundle)
+    build_bundle_email(bundle)
+  end
+
+  def bundled_notifications(bundle)
+    build_bundle_email(bundle)
+  end
+
+  private
+    def build_bundle_email(bundle)
+      @bundle = bundle
+      @user = bundle.user
+      @notifications = bundle.notifications.preloaded
+
+      mail(
+        to: @user.identity.email_address,
+        subject: bundle_email_subject,
+        template_name: "bundle_email"
+      )
+    end
+
+    def bundle_email_subject
+      count = @notifications.size
+
+      if count == 1
+        "You have 1 new notification in Fizzy"
+      else
+        "You have #{count} new notifications in Fizzy"
+      end
+    end
+end
