diff --git a/test/jobs/notification/bundle_delivery_job_test.rb b/test/jobs/notification/bundle_delivery_job_test.rb
new file mode 100644
index 0000000..5514fe8
--- /dev/null
+++ b/test/jobs/notification/bundle_delivery_job_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Notification::BundleDeliveryJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @user.notifications.destroy_all
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "delivers the bundle when its window has ended" do
+    bundle = Notification.create!(user: @user, creator: users(:david), source: events(:text_published)).bundle
+
+    travel_to bundle.ends_at do
+      assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+        Notification::BundleDeliveryJob.perform_now(bundle)
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "scheduled delivery sends the email after the window ends" do
+    bundle = Notification.create!(user: @user, creator: users(:david), source: events(:text_published)).bundle
+
+    assert_no_enqueued_jobs only: Notification::BundleDeliveryJob do
+      Notification.create!(user: @user, creator: users(:david), source: events(:shipping_published))
+    end
+
+    travel_to bundle.ends_at + 1.minute do
+      perform_enqueued_jobs
+
+      assert_equal 1, ActionMailer::Base.deliveries.count { |mail| mail.to == [ @user.identity.email_address ] }
+      assert bundle.reload.delivered?
+    end
+  end
+
+  test "does not deliver before the window ends and only delivers once" do
+    bundle = Notification.create!(user: @user, creator: users(:david), source: events(:text_published)).bundle
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.count } do
+      Notification::BundleDeliveryJob.perform_now(bundle)
+    end
+    assert_not bundle.reload.delivered?
+
+    travel_to bundle.ends_at do
+      Notification::DeliverDueBundlesJob.perform_now
+      Notification::DeliverDueBundlesJob.perform_now
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.count { |mail| mail.to == [ @user.identity.email_address ] }
+    assert bundle.reload.delivered?
+  end
+end
diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..91b895e
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "bundle_email sends one email containing all bundled notifications" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    user.notifications.destroy_all
+
+    Notification.create!(user: user, creator: users(:david), source: events(:text_published))
+    Notification.create!(user: user, creator: users(:david), source: events(:shipping_published))
+    bundle = Notification::Bundle.open_bundle_for(user)
+
+    email = NotificationMailer.bundle_email(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_match cards(:text).title, email.body.encoded
+    assert_match cards(:shipping).title, email.body.encoded
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..99b0cfb
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.settings.update!(bundle_email_frequency: "daily")
+  end
+
+  test "first notification opens a window starting at its creation time" do
+    notification = create_notification(card: cards(:text), source: events(:text_published))
+
+    bundle = notification.bundle
+    assert bundle.present?
+    assert_equal @user, bundle.user
+    assert_in_delta notification.created_at, bundle.starts_at, 1.second
+    assert_equal bundle.starts_at + 1.day, bundle.ends_at
+    assert_not bundle.delivered?
+  end
+
+  test "subsequent notifications join the open window instead of creating a new one" do
+    first = create_notification(card: cards(:text), source: events(:text_published))
+    second = create_notification(card: cards(:shipping), source: events(:shipping_published))
+
+    assert_equal first.bundle, second.bundle
+    assert_equal 1, Notification::Bundle.where(user: @user).count
+    assert_equal [ first, second ].sort_by(&:id), first.bundle.notifications.sort_by(&:id)
+  end
+
+  test "late notifications join the window that has already opened" do
+    first = create_notification(card: cards(:text), source: events(:text_published))
+    bundle = first.bundle
+
+    late = nil
+    travel_to bundle.starts_at + 2.hours do
+      late = Notification.create!(user: @user, creator: users(:david), source: events(:shipping_published), created_at: bundle.starts_at - 3.days)
+    end
+
+    assert_equal bundle, late.bundle
+    assert_equal 1, Notification::Bundle.where(user: @user).count
+  end
+
+  test "no bundle is created when frequency is never" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(card: cards(:text), source: events(:text_published))
+    end
+  end
+
+  test "window length follows the user's frequency" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    bundle = create_notification(card: cards(:text), source: events(:text_published)).bundle
+    assert_equal bundle.starts_at + 4.hours, bundle.ends_at
+  end
+
+  test "delivering a due bundle sends one email and marks it delivered" do
+    bundle = create_notification(card: cards(:text), source: events(:text_published)).bundle
+    create_notification(card: cards(:shipping), source: events(:shipping_published))
+
+    assert bundle.due?(at: bundle.ends_at)
+
+    assert_difference -> { ActionMailer::Base.deliveries.count }, 1 do
+      Notification::Bundle.deliver_all_due(at: bundle.ends_at)
+    end
+
+    assert bundle.reload.delivered?
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "a notification after delivery opens a new window" do
+    bundle = create_notification(card: cards(:text), source: events(:text_published)).bundle
+    bundle.deliver
+
+    new_notification = create_notification(card: cards(:shipping), source: events(:shipping_published))
+
+    assert_not_equal bundle, new_notification.bundle
+    assert_equal 2, Notification::Bundle.where(user: @user).count
+  end
+
+  test "overlapping windows for the same user are rejected" do
+    bundle = create_notification(card: cards(:text), source: events(:text_published)).bundle
+
+    overlapping = Notification::Bundle.new(user: @user, starts_at: bundle.starts_at + 1.hour, ends_at: bundle.ends_at + 1.hour)
+
+    assert_not overlapping.valid?
+  end
+
+test "weekly frequency opens a one week window" do
+  @user.settings.update!(bundle_email_frequency: "weekly")
+  bundle = create_notification(card: cards(:text), source: events(:text_published)).bundle
+  assert_equal bundle.starts_at + 1.week, bundle.ends_at
+end
+
+test "an updated notification is bundled again after its previous bundle was delivered" do
+  notification = create_notification(card: cards(:text), source: events(:text_published))
+  first_bundle = notification.bundle
+  first_bundle.deliver
+
+  travel_to first_bundle.ends_at + 1.day do
+    notification.update!(source: events(:shipping_published))
+
+    assert_not_equal first_bundle, notification.bundle
+    assert_in_delta Time.current, notification.bundle.starts_at, 1.second
+  end
+end
+
+test "reading a notification does not move it to a new bundle" do
+  notification = create_notification(card: cards(:text), source: events(:text_published))
+  bundle = notification.bundle
+  bundle.deliver
+
+  notification.read
+
+  assert_equal bundle, notification.reload.bundle
+end
+
+  test "opening a window twice returns the same bundle instead of overlapping windows" do
+    first = Notification::Bundle.open_for(@user, starts_at: Time.current)
+
+    assert_no_difference -> { Notification::Bundle.where(user: @user).count } do
+      assert_equal first, Notification::Bundle.open_for(@user, starts_at: 1.hour.from_now)
+    end
+  end
+
+test "notifications created through the notifier are bundled" do
+  notifications = Notifier.for(events(:layout_commented)).notify
+
+  assert notifications.all? { |notification| notification.bundle.present? }
+  assert_equal 1, Notification::Bundle.where(user: @user).count
+end
+
+  test "windows are per person" do
+    other = users(:david)
+    other.settings.update!(bundle_email_frequency: "daily")
+    other.notifications.destroy_all
+
+    mine = create_notification(card: cards(:text), source: events(:text_published)).bundle
+    theirs = Notification.create!(user: other, creator: users(:jz), source: events(:shipping_published)).bundle
+
+    assert_not_equal mine, theirs
+    assert_equal @user, mine.user
+    assert_equal other, theirs.user
+  end
+
+  private
+    def create_notification(card:, source:)
+      Notification.create!(user: @user, creator: users(:david), source: source)
+    end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
new file mode 100644
index 0000000..66d5359
--- /dev/null
+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle_email_frequency defaults to never" do
+    assert_equal "never", users(:kevin).settings.bundle_email_frequency
+    assert_nil users(:kevin).settings.bundle_interval
+    assert_not users(:kevin).settings.bundle_emails_enabled?
+  end
+
+  test "bundle interval follows bundle_email_frequency" do
+    settings = users(:kevin).settings
+
+    settings.bundle_email_frequency = "every_few_hours"
+    assert_equal 4.hours, settings.bundle_interval
+
+    settings.bundle_email_frequency = "daily"
+    assert_equal 1.day, settings.bundle_interval
+
+    settings.bundle_email_frequency = "weekly"
+    assert_equal 1.week, settings.bundle_interval
+  end
+
+  test "bundle_email_frequency only allows known values" do
+    assert_raises(ArgumentError) do
+      users(:kevin).settings.update!(bundle_email_frequency: "hourly")
+    end
+  end
+end
