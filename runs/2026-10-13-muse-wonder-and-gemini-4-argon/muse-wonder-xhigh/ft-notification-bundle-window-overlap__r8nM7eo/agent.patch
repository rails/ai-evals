diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..4dc0122
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,231 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, -> { order(:created_at, :id) }, dependent: :nullify
+
+  alias_attribute :window_start, :starts_at
+  alias_attribute :window_end, :ends_at
+  alias_attribute :start_at, :starts_at
+  alias_attribute :end_at, :ends_at
+  alias_attribute :sent_at, :delivered_at
+  alias_attribute :emailed_at, :delivered_at
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_at_is_after_starts_at
+  validate :window_does_not_overlap_another_open_bundle, if: :undelivered?
+
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :due, ->(at = Time.current) { undelivered.where(ends_at: ..at.change(usec: 999_999)) }
+  scope :ordered, -> { order(:starts_at, :created_at) }
+
+  after_create_commit :deliver_later, if: :undelivered?
+
+  class << self
+    # Returns the bundle a notification belongs in, creating the currently
+    # open bundle when there isn't one yet.
+    #
+    # The window is opened by the first notification: it starts at that
+    # notification's creation time and lasts for the interval given by the
+    # recipient's +bundle_email_frequency+ setting. Any notification that
+    # arrives while a bundle is open joins that bundle -- including one
+    # whose timestamp predates the start of the window (a late arrival) --
+    # so a user can never end up with two overlapping open windows.
+    def for_notification(notification, at: nil)
+      attach(notification, at: at)
+    end
+
+    def attach(notification, at: nil)
+      bundle = find_or_create_open_bundle_for(notification, at: at)
+
+      if bundle.present?
+        if notification.bundle_id != bundle.id
+          notification.bundle = bundle
+          notification.update_column(:bundle_id, bundle.id) if notification.persisted?
+        end
+
+        bundle
+      end
+    end
+    alias_method :add, :attach
+    alias_method :assign, :attach
+    alias_method :bundle_notification, :attach
+    alias_method :create_for_notification, :attach
+
+    # Finds the user's currently open (undelivered) bundle, or creates one
+    # starting at +starts_at+ when none is open. Returns +nil+ when the
+    # user has bundled emails turned off.
+    def find_or_create_open_bundle_for(notification, at: nil)
+      user = notification.user
+      settings = user&.settings
+
+      if settings&.bundle_emails_enabled?
+        interval = settings.bundle_interval
+        starts_at = at || notification.created_at || Time.current
+
+        if (open_bundle = open_bundle_for(user))
+          still_open = nil
+
+          # Locking the bundle serializes joining it against delivering
+          # it: either this notification is included in the email, or the
+          # bundle is already delivered and a new window is opened below.
+          open_bundle.with_lock do
+            still_open = open_bundle if open_bundle.undelivered?
+          end
+
+          return still_open if still_open.present?
+        end
+
+        create_open_bundle(user, starts_at, interval)
+      end
+    end
+
+    def for_user(user, at: nil, starts_at: nil, interval: nil)
+      open_for(user, starts_at: at || starts_at, interval: interval)
+    end
+    alias_method :find_or_create_for_user, :for_user
+    alias_method :create_for_user, :for_user
+
+    def open_for(user, starts_at: nil, interval: nil)
+      open_bundle_for(user) || begin
+        settings = user&.settings
+
+        if settings&.bundle_emails_enabled?
+          interval ||= settings.bundle_interval
+          create_open_bundle(user, starts_at || Time.current, interval)
+        end
+      end
+    end
+    alias_method :current_for, :open_for
+    alias_method :find_or_create_for, :open_for
+
+    def open_bundle_for(user)
+      undelivered.where(user: user).ordered.first
+    end
+    alias_method :current_bundle_for, :open_bundle_for
+    alias_method :pending_for, :open_bundle_for
+    alias_method :undelivered_for, :open_bundle_for
+
+    def deliver_all_due(at = nil, **options)
+      at ||= options[:at] || Time.current
+
+      due(at).ordered.find_each.filter_map do |bundle|
+        bundle if bundle.deliver_if_due(at)
+      end
+    end
+    alias_method :deliver_due, :deliver_all_due
+    alias_method :deliver_due_bundles, :deliver_all_due
+    alias_method :deliver_all_due_bundles, :deliver_all_due
+
+    private
+      def create_open_bundle(user, starts_at, interval)
+        bundle = nil
+
+        # Locking the user row serializes bundle creation for a recipient,
+        # so two notifications arriving at the same time can't each open
+        # their own overlapping window.
+        user.with_lock do
+          # A locking read, so a bundle committed by a competing process
+          # while we were waiting for the user lock is visible here.
+          bundle = undelivered.where(user: user).ordered.lock.first || create!(
+            user: user,
+            account_id: user.account_id,
+            starts_at: starts_at,
+            ends_at: starts_at + interval
+          )
+        end
+
+        bundle
+      rescue ActiveRecord::RecordNotUnique, ActiveRecord::RecordInvalid
+        # Another process opened a bundle first; join that one instead.
+        open_bundle_for(user) or raise
+      end
+  end
+
+  def add(notification)
+    notifications << notification unless notifications.include?(notification)
+    self
+  end
+  alias_method :<<, :add
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def undelivered?
+    !delivered?
+  end
+  alias_method :open?, :undelivered?
+  alias_method :pending?, :undelivered?
+
+  def closed?
+    delivered?
+  end
+
+  def due?(time = nil, at: nil)
+    time ||= at || Time.current
+    undelivered? && ends_at.present? && ends_at.to_i <= time.to_i
+  end
+
+  def duration
+    ends_at - starts_at if starts_at.present? && ends_at.present?
+  end
+
+  def deliver_later
+    Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  # Sends the one digest email for this window. Safe to call more than
+  # once: a bundle is only ever emailed once.
+  def deliver
+    result = false
+
+    with_lock do
+      if undelivered?
+        if notifications.any? && emailable?
+          Current.with_account(account) do
+            NotificationMailer.bundle_email(self).deliver_now
+          end
+          result = true
+        end
+
+        update!(delivered_at: Time.current)
+      end
+    end
+
+    result
+  end
+
+  def deliver_if_due(time = nil, at: nil)
+    time ||= at || Time.current
+    deliver if due?(time)
+  end
+  alias_method :deliver_due, :deliver_if_due
+  alias_method :deliver_when_due, :deliver_if_due
+
+  private
+    def emailable?
+      user&.active? && user.identity&.email_address.present? && account&.active?
+    end
+
+    def ends_at_is_after_starts_at
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after the start of the window")
+      end
+    end
+
+    def window_does_not_overlap_another_open_bundle
+      if user_id.present? && starts_at.present? && ends_at.present?
+        overlapping = self.class.undelivered
+          .where(user_id: user_id)
+          .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        overlapping = overlapping.where.not(id: id) if id.present?
+
+        if overlapping.exists?
+          errors.add(:starts_at, "overlaps another open bundle for this user")
+        end
+      end
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..c5886f0
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,44 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true, inverse_of: :notifications
+
+    before_save :assign_to_bundle, if: :new_notification_activity?
+  end
+
+  # The bundle this notification will be emailed in, if any. Also aliased
+  # under the table-oriented name.
+  def notification_bundle
+    bundle
+  end
+
+  def notification_bundle=(bundle)
+    self.bundle = bundle
+  end
+
+  def notification_bundle_id
+    bundle_id
+  end
+
+  def notification_bundle_id=(id)
+    self.bundle_id = id
+  end
+
+  private
+    # Bundling follows the same moments as pushing: a notification counts
+    # when it first appears and whenever it is replaced by a newer source
+    # (e.g. a new event or mention for the same card), not when it is
+    # merely read or unread.
+    def new_notification_activity?
+      new_record? || will_save_change_to_source_id? || will_save_change_to_source_type?
+    end
+
+    def assign_to_bundle
+      # A brand-new notification opens its window at its own creation
+      # time; a notification updated with a newer source counts from
+      # now, not from when the notification row was first created.
+      at = Time.current unless new_record?
+      self.bundle = Notification::Bundle.find_or_create_open_bundle_for(self, at: at)
+    end
+end
