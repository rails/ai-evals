diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..af073c5
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,89 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :capture_locale_preference
+    around_action :with_locale
+    etag { I18n.locale.to_s }
+    helper_method :current_locale
+  end
+
+  private
+    def current_locale
+      I18n.locale
+    end
+
+    # Runs before authentication, so that a ?locale= choice is honoured
+    # (and stored in the session) even when the request is redirected,
+    # e.g. to the sign-in page. Restores the previous locale afterwards
+    # so the choice does not leak into the next request on this thread.
+    def capture_locale_preference
+      previous_locale = I18n.locale
+
+      if requested_locale.present?
+        session[:locale] = requested_locale.to_s
+        Current.explicit_locale = requested_locale.to_s
+        I18n.locale = requested_locale
+      elsif session[:locale].present? && available_locale?(session[:locale])
+        Current.explicit_locale = session[:locale].to_s
+        I18n.locale = session[:locale].to_sym
+      else
+        I18n.locale = I18n.default_locale
+      end
+
+      yield
+    ensure
+      I18n.locale = previous_locale
+    end
+
+    def with_locale(&block)
+      locale = resolve_locale
+      if locale_persistable?
+        Current.explicit_locale = locale.to_s
+        persist_locale(locale)
+      end
+
+      I18n.with_locale(locale, &block)
+    end
+
+    def resolve_locale
+      if requested_locale.present?
+        session[:locale] = requested_locale.to_s
+        requested_locale
+      elsif session[:locale].present? && available_locale?(session[:locale])
+        session[:locale].to_sym
+      elsif Current.identity&.locale.present? && available_locale?(Current.identity.locale)
+        Current.identity.locale.to_sym
+      else
+        I18n.default_locale
+      end
+    end
+
+    def requested_locale
+      @requested_locale ||= begin
+        candidate = params[:locale].to_s
+        candidate.to_sym if candidate.present? && available_locale?(candidate)
+      end
+    end
+
+    def available_locale?(candidate)
+      I18n.available_locales.map(&:to_s).include?(candidate.to_s)
+    end
+
+    # A choice made explicitly (via ?locale=) or carried in the session
+    # (e.g. chosen before signing in) sticks to the signed-in identity so
+    # it is remembered on the next sign-in from a clean browser.
+    def locale_persistable?
+      requested_locale.present? || session[:locale].present?
+    end
+
+    def persist_locale(locale)
+      identity = Current.identity
+      return if identity.blank? || !identity.persisted?
+      return if identity.locale == locale.to_s
+
+      identity.update_column(:locale, locale.to_s)
+    rescue => error
+      Rails.logger.warn("Failed to persist locale: #{error.message}")
+    end
+end
