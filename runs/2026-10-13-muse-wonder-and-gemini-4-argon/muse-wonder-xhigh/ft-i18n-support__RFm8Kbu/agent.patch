diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..ca9b1bd
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "choosing Japanese via query param sticks for the session on unauthenticated pages" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_match "メールアドレスを入力", response.body
+
+      get new_session_path
+      assert_response :success
+      assert_match "メールアドレスを入力", response.body
+    end
+  end
+
+  test "unsupported locale does not break the page or switch language" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_match "Enter your email", response.body
+    end
+  end
+
+  test "default rendering remains English" do
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_match "Enter your email", response.body
+    end
+  end
+
+  test "Japanese choice sticks after sign-in and on a clean browser sign-in" do
+    sign_in_as :kevin
+
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    # Simulate a clean browser: drop every cookie, then sign in again.
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+    sign_in_as :kevin
+
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "switching back to English via query param persists" do
+    sign_in_as :kevin
+
+    get board_path(boards(:writebook), locale: "ja")
+    assert_select "html[lang=ja]"
+
+    get board_path(boards(:writebook), locale: "en")
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+end
+
+class LocalizationMailerTest < ActionMailer::TestCase
+  test "magic link email is Japanese for Japanese recipients" do
+    identities(:kevin).update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyのコードは #{magic_link.code} です", email.subject
+    assert_match "確認コードを入力してください", email.text_part.decoded
+  end
+
+  test "magic link email remains English by default" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_match "verification code on the Fizzy sign-in page", email.text_part.decoded
+  end
+end
+
+class LocalizationRedirectTest < ActionDispatch::IntegrationTest
+  test "choosing Japanese on a protected page carries through the sign-in redirect" do
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :redirect
+
+    follow_redirect!
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+end
