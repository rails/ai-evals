@@ -0,0 +1,15 @@
+export function currentLocale() {
+  return document.documentElement.lang || "en"
+}
+
+export function isJapanese() {
+  return currentLocale().startsWith("ja")
+}
+
+export function intlLocale() {
+  return isJapanese() ? "ja-JP" : "en-US"
+}
+
+export function localizedString(english, japanese) {
+  return isJapanese() ? japanese : english
+}
