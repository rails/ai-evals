@@ -0,0 +1,89 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageAttachment do
+  # Simulates a record whose picture was uploaded before the move to
+  # Active Storage: the file identifier is in the legacy column and
+  # there is no Active Storage attachment.
+  def make_legacy(record, filename)
+    record.profile_image_attachment.purge if record.profile_image_attachment.attached?
+    record.update_columns(profile_image: filename)
+    record.reload
+  end
+
+  describe "existing (CarrierWave) pictures" do
+    it "keeps rendering a user's legacy picture" do
+      user = make_legacy(create(:user), "legacy-user.png")
+
+      expect(user.profile_image_attachment).not_to be_attached
+      expect(user.profile_image_url).to eq("/uploads/user/profile_image/#{user.id}/legacy-user.png")
+      expect(user.profile_image_url_for(length: 90)).to include("legacy-user.png")
+    end
+
+    it "keeps rendering an organization's legacy picture" do
+      organization = make_legacy(create(:organization), "legacy-org.png")
+
+      expect(organization.profile_image_url)
+        .to eq("/uploads/organization/profile_image/#{organization.id}/legacy-org.png")
+    end
+
+    it "keeps a full URL stored in the legacy column (e.g. banished users)" do
+      user = make_legacy(create(:user), "https://example.com/default.png")
+
+      expect(user.profile_image_url).to eq("https://example.com/default.png")
+    end
+  end
+
+  describe "new pictures" do
+    it "stores a user's new picture in Active Storage, not CarrierWave" do
+      user = create(:user, profile_image: nil)
+      user.profile_image = Rack::Test::UploadedFile.new(Rails.root.join("spec/support/fixtures/images/image1.jpeg"),
+                                                        "image/jpeg")
+      user.save!
+
+      expect(user.profile_image_attachment).to be_attached
+      expect(user.profile_image_url).to include("active_storage")
+      expect(user.profile_image_url).to include("image1.jpeg")
+      expect(user[:profile_image]).to be_blank
+    end
+
+    it "stores an organization's new picture in Active Storage, not CarrierWave" do
+      organization = create(:organization)
+
+      expect(organization.profile_image_attachment).to be_attached
+      expect(organization.profile_image_url).to include("active_storage")
+      expect(organization[:profile_image]).to be_blank
+    end
+
+    it "prefers the Active Storage picture once a legacy record uploads a new one" do
+      user = make_legacy(create(:user), "legacy-user.png")
+
+      user.profile_image = Rack::Test::UploadedFile.new(Rails.root.join("spec/support/fixtures/images/image1.jpeg"),
+                                                        "image/jpeg")
+      user.save!
+
+      expect(user.profile_image_url).to include("active_storage")
+      # The legacy picture is left where it was for now.
+      expect(user[:profile_image]).to eq("legacy-user.png")
+    end
+
+    it "downloads remote pictures into Active Storage" do
+      body = Rails.root.join("spec/support/fixtures/images/image1.jpeg").binread
+      stub_request(:get, "https://example.com/avatar.jpeg")
+        .to_return(status: 200, body: body, headers: { "Content-Type" => "image/jpeg" })
+
+      user = create(:user, profile_image: nil)
+      user.remote_profile_image_url = "https://example.com/avatar.jpeg"
+      user.save!
+
+      expect(user.remote_profile_image_url).to eq("https://example.com/avatar.jpeg")
+      expect(user.reload.profile_image_url).to include("active_storage")
+    end
+  end
+
+  describe "other uploads" do
+    it "leaves non-profile CarrierWave uploads alone" do
+      expect(Tag.new.profile_image).to be_a(ProfileImageUploader)
+      expect(Organization.new.cover_image).to be_a(CoverImageUploader)
+    end
+  end
+end
