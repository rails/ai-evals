diff --git a/app/models/concerns/profile_image_attachment.rb b/app/models/concerns/profile_image_attachment.rb
new file mode 100644
index 0000000..98624c5
--- /dev/null
+++ b/app/models/concerns/profile_image_attachment.rb
@@ -0,0 +1,347 @@
+require "open-uri"
+
+# Moves profile pictures from CarrierWave to Active Storage without
+# breaking any picture that is already visible.
+#
+# This is deliberately a dual-read / single-write ("expand") step:
+#
+# * The legacy CarrierWave column (+profile_image+) and the files it
+#   points at are left exactly where they are.  Nothing is copied,
+#   renamed or deleted, so records created before this change (and
+#   code from the previous deploy, should this deploy be rolled back)
+#   keep working.
+# * Every *new* assignment through {#profile_image=} is stored in
+#   Active Storage instead of CarrierWave.
+# * {#profile_image_url} prefers the Active Storage attachment and
+#   falls back to the legacy CarrierWave file, so old pictures keep
+#   rendering and new ones render from Active Storage.
+#
+# Only models including this concern are migrated; every other
+# CarrierWave upload in the app is untouched.
+module ProfileImageAttachment
+  extend ActiveSupport::Concern
+
+  # Content types/extensions accepted by ProfileImageUploader, which
+  # new uploads bypass now that they go to Active Storage.
+  ALLOWED_CONTENT_TYPES = %w[
+    image/jpeg image/jpg image/pjpeg image/png image/gif image/webp
+    image/bmp image/x-bmp image/x-ms-bmp image/x-icon
+    image/vnd.microsoft.icon image/x-adobe-dng image/dng
+  ].freeze
+  ALLOWED_EXTENSIONS = ProfileImageUploader::EXTENSION_ALLOWLIST
+
+  # String-like view of a profile picture.
+  #
+  # Historically +profile_image+ returned a CarrierWave uploader,
+  # which interpolates/serializes as its URL and is compared against
+  # URL strings throughout the codebase (views, serializers, JSON
+  # rendering of the records themselves).  Returning a plain Active
+  # Storage proxy from +profile_image+ would break all of that (it
+  # even recurses through +as_json+).  This value is therefore the
+  # picture's URL as a String, while still answering the Active
+  # Storage questions callers may ask of a newly uploaded picture.
+  class ImageValue < String
+    attr_reader :record
+
+    def initialize(record)
+      @record = record
+      super(record.profile_image_url.to_s)
+    end
+
+    def attached?
+      record.profile_image_attachment.attached?
+    end
+
+    def blank?
+      # A picture assigned but not yet saved has no servable URL yet,
+      # but it is still present.
+      return false if attached?
+
+      super
+    end
+
+    def attachment
+      record.profile_image_attachment.attachment if attached?
+    end
+
+    def blob
+      record.profile_image_attachment.blob if attached?
+    end
+
+    def filename
+      return blob.filename.to_s if blob
+
+      record[:profile_image].to_s
+    end
+
+    def url
+      record.profile_image_url
+    end
+
+    def path
+      if blob
+        begin
+          blob.service.path_for(blob.key) if blob.service.respond_to?(:path_for)
+        rescue StandardError
+          nil
+        end
+      else
+        record.legacy_profile_image.path
+      end
+    end
+
+    def file
+      file_path = path
+      return if file_path.blank?
+
+      Struct.new(:file, :path).new(file_path, file_path)
+    end
+
+    def attach(attachable)
+      record.profile_image_attachment.attach(attachable)
+    end
+
+    def purge
+      record.profile_image_attachment.purge
+    end
+  end
+
+  included do
+    has_one_attached :profile_image_attachment
+
+    # Read-only (in practice) CarrierWave mount backed by the legacy
+    # column.  Mounting it under a different name leaves +profile_image+
+    # free for the Active Storage backed accessors below while keeping
+    # the original URL generation for pre-migration files.
+    mount_uploader :legacy_profile_image, LegacyProfileImageUploader, mount_on: :profile_image
+
+    validate :validate_profile_image_attachment
+
+    before_save :capture_profile_image_attachment_change
+  end
+
+  # The attachment itself, under a couple of descriptive aliases.  The
+  # canonical accessor is {#profile_image_attachment} (defined by
+  # +has_one_attached+); these simply point at the same attachment.
+  def profile_image_file
+    profile_image_attachment
+  end
+
+  def profile_image_file=(attachable)
+    self.profile_image = attachable
+  end
+
+  def profile_image_blob
+    profile_image_attachment.blob if profile_image_attachment.attached?
+  end
+
+  # Backwards compatible reader: a String-like URL value (see
+  # ImageValue) for the current picture, whether that picture lives
+  # in Active Storage (new uploads) or in the legacy CarrierWave
+  # column (pre-migration uploads).  Use +profile_image_attachment+
+  # for the raw Active Storage attachment and +legacy_profile_image+
+  # for the raw legacy uploader.
+  def profile_image
+    ImageValue.new(self)
+  end
+
+  # New profile pictures are written to Active Storage.  The legacy
+  # column is intentionally not updated: existing pictures stay where
+  # they are, and assigning a new picture does not destroy the old
+  # file (a later step can clean it up once nothing reads it).
+  def profile_image=(attachable)
+    case attachable
+    when nil, ""
+      # Mirror CarrierWave: assigning nothing clears the (new) image.
+      # The legacy column is left alone so a stray blank assignment
+      # cannot erase a pre-migration picture.
+      self.profile_image_attachment = attachable if profile_image_attachment.attached?
+    when String
+      assign_profile_image_from_string(attachable)
+    when Pathname
+      attach_profile_image_file(attachable.open("rb"))
+    else
+      attach_profile_image(attachable)
+    end
+  end
+
+  def profile_image_url
+    if profile_image_attachment.attached?
+      active_storage_profile_image_url
+    elsif self[:profile_image].present?
+      legacy_profile_image_url_value
+    end
+  end
+
+  # CarrierWave exposed a +remote_<mounted>_url+ pair for downloading
+  # a picture from a URL (OAuth providers, organization creation via
+  # the API, generated avatars, ...).  Keep that interface: the getter
+  # returns what was assigned, the setter downloads and stores the
+  # picture in Active Storage.
+  def remote_profile_image_url
+    @remote_profile_image_url
+  end
+
+  def remote_profile_image_url=(value)
+    @remote_profile_image_url = value
+
+    case value
+    when nil, ""
+      nil
+    when String
+      download_remote_profile_image(value) if value.match?(%r{\Ahttps?://}i)
+    else
+      # SafeRemoteProfileImageUrl hands back an opened file when it is
+      # given something that is not a URL; store that file instead.
+      self.profile_image = value
+    end
+  end
+
+  def profile_image_changed?
+    profile_image_attachment_change_pending? || @profile_image_attachment_replaced.present? ||
+      (respond_to?(:saved_change_to_profile_image?) && saved_change_to_profile_image?)
+  end
+
+  # True when the most recent save replaced the profile picture with
+  # an Active Storage upload.  Used by callbacks that previously
+  # relied on the CarrierWave column changing (cache busting, article
+  # re-caching, social image generation, ...).
+  def profile_image_changed_in_last_save?
+    !!@profile_image_changed_in_last_save
+  end
+
+  private
+
+  def assign_profile_image_from_string(value)
+    # A bare string is not an upload.  Historically assigning one to
+    # the CarrierWave mount stored nothing (callers that want a
+    # remote file use +remote_profile_image_url=+, e.g. OAuth sign-up
+    # and the organizations API, and callers that pass a URL string
+    # such as the mascot account simply end up with the fallback
+    # picture).  Preserve that instead of issuing an HTTP request --
+    # let alone failing the save -- from a plain attribute assignment.
+    # A string that is a path to a real file on disk is an upload.
+    attach_profile_image_file(File.open(value, "rb")) if File.file?(value)
+  end
+
+  def attach_profile_image_file(file)
+    attach_profile_image(file)
+  end
+
+  def attach_profile_image(attachable)
+    mark_profile_image_as_changed
+    profile_image_attachment.attach(prepare_profile_image_attachable(attachable))
+  end
+
+  # New uploads no longer pass through CarrierWave, so reproduce the
+  # processing it applied to profile pictures (auto-orient and strip
+  # EXIF/metadata, including GPS) when processing is enabled -- as it
+  # is outside the test environment, and as specs that verify this
+  # behaviour explicitly enable it.  When processing is disabled the
+  # original bytes are stored untouched, also as before.
+  def prepare_profile_image_attachable(attachable)
+    return attachable unless ProfileImageUploader.enable_processing
+
+    source_path = attachable.path if attachable.respond_to?(:path)
+    return attachable if source_path.blank? || !File.file?(source_path)
+    return attachable if attachable.respond_to?(:content_type) &&
+      attachable.content_type.to_s.include?("svg")
+
+    filename = if attachable.respond_to?(:original_filename) && attachable.original_filename.present?
+                 attachable.original_filename
+               else
+                 File.basename(source_path)
+               end
+    tempfile = Tempfile.new(["profile_image", File.extname(filename.to_s)])
+    tempfile.binmode
+
+    image = MiniMagick::Image.open(source_path)
+    image.auto_orient
+    image.strip unless image.frames.count > ProfileImageUploader::FRAME_STRIP_MAX
+    image.write(tempfile.path)
+    tempfile.rewind
+
+    content_type = attachable.content_type if attachable.respond_to?(:content_type)
+    { io: tempfile, filename: filename, content_type: content_type.presence }
+  rescue StandardError => e
+    Rails.logger.error("Error stripping EXIF data from profile image: #{e.message}")
+    attachable
+  end
+
+  def download_remote_profile_image(url)
+    URI.parse(url).open(read_timeout: 10, open_timeout: 5) do |io|
+      data = io.read(ProfileImageUploader::MAX_FILE_SIZE + 1)
+      next if data.blank?
+
+      filename = File.basename(URI.parse(url).path.presence || "profile_image")
+      filename = "profile_image" if filename.blank? || filename == "/"
+      mark_profile_image_as_changed
+      profile_image_attachment.attach(io: StringIO.new(data), filename: filename,
+                                      content_type: io.content_type.presence)
+    end
+  rescue StandardError => e
+    # A picture we cannot fetch (provider outage, stubbed/empty
+    # response in tests, ...) must not fail account creation; the
+    # record simply keeps whatever picture (if any) it already had,
+    # and profile_image_url falls back as usual.
+    Rails.logger.warn("Failed to download remote profile image #{url}: #{e.class}: #{e.message}")
+    nil
+  end
+
+  def active_storage_profile_image_url
+    Rails.application.routes.url_helpers.url_for(profile_image_attachment)
+  rescue StandardError
+    # An attachment on an unsaved (or stubbed) record has no blob to
+    # sign yet, so there is no servable URL until the record is saved.
+    # Fall back to a deterministic, filename based path rather than
+    # raising (callers routinely build unsaved records with a picture
+    # assigned, e.g. form objects and factory stubs).
+    blob = profile_image_attachment.blob
+    return if blob.nil?
+
+    "/rails/active_storage/blobs/pending/#{ERB::Util.url_encode(blob.filename.to_s)}"
+  end
+
+  def legacy_profile_image_url_value
+    legacy = self[:profile_image].to_s
+
+    # Banished/mascot style records store a full URL (or an absolute
+    # path) in the column; that value *is* the picture's address.
+    return legacy if legacy.start_with?("http://", "https://", "/")
+
+    legacy_profile_image_url
+  end
+
+  def profile_image_attachment_change_pending?
+    attachment_changes["profile_image_attachment"].present?
+  end
+
+  def mark_profile_image_as_changed
+    @profile_image_attachment_replaced = true
+  end
+
+  def capture_profile_image_attachment_change
+    @profile_image_changed_in_last_save =
+      @profile_image_attachment_replaced.present? || profile_image_attachment_change_pending?
+    @profile_image_attachment_replaced = false
+  end
+
+  def validate_profile_image_attachment
+    return unless profile_image_attachment.attached?
+
+    blob = profile_image_attachment.blob
+    return if blob.nil?
+
+    max_size = ProfileImageUploader::MAX_FILE_SIZE
+    if blob.byte_size.to_i > max_size
+      errors.add(:profile_image, "File size should be less than #{max_size / 1.megabyte} MB")
+      return
+    end
+
+    extension = File.extname(blob.filename.to_s).delete(".").downcase
+    return if ALLOWED_CONTENT_TYPES.include?(blob.content_type.to_s.downcase) ||
+      ALLOWED_EXTENSIONS.include?(extension)
+
+    errors.add(:profile_image, "is not a valid image")
+  end
+end
