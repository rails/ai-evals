diff --git a/db/migrate/20261013165453_create_active_storage_tables.active_storage.rb b/db/migrate/20261013165453_create_active_storage_tables.active_storage.rb
new file mode 100644
index 0000000..6bd8bd0
--- /dev/null
+++ b/db/migrate/20261013165453_create_active_storage_tables.active_storage.rb
