diff --git a/app/uploaders/legacy_profile_image_uploader.rb b/app/uploaders/legacy_profile_image_uploader.rb
new file mode 100644
index 0000000..b846b10
--- /dev/null
+++ b/app/uploaders/legacy_profile_image_uploader.rb
@@ -0,0 +1,14 @@
+# CarrierWave uploader used *only* to read profile pictures that were
+# uploaded before the move to Active Storage.
+#
+# It is mounted (see ProfileImageAttachment) on the legacy
+# +profile_image+ column under a different mounted name, so it has to
+# reproduce the store directory the original ProfileImageUploader
+# (mounted as :profile_image) generated for those files.  Without this,
+# URLs for pre-migration pictures would point at a directory that
+# never contained them.
+class LegacyProfileImageUploader < ProfileImageUploader
+  def store_dir
+    "uploads/#{model.class.to_s.underscore}/profile_image/#{model.id}"
+  end
+end
