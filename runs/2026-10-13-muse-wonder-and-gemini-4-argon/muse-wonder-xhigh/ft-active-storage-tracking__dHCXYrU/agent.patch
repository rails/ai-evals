+class StorageTrackableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card images count towards board and account" do
+    board = boards(:writebook)
+    account = accounts("37s")
+
+    cards(:logo).image.attach(io: StringIO.new("x" * 1234), filename: "image.png", content_type: "image/png")
+    perform_calculation_jobs
+
+    assert_equal 1234, board.bytes_used
+    assert_equal 1234, account.bytes_used
+  end
+
+  test "embeds in board, card, and comment rich text count, other attachments do not" do
+    board = boards(:writebook)
+    account = accounts("37s")
+    card = cards(:logo)
+
+    attach_embed(board.public_description, 100, "board.txt")
+    attach_embed(card.description, 200, "card.txt")
+
+    comment = card.comments.create!(body: "Hello")
+    attach_embed(comment.body, 300, "comment.txt")
+
+    users(:david).avatar.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    perform_calculation_jobs
+
+    assert_equal 600, board.bytes_used
+    assert_equal 600, account.bytes_used
+  end
+
+  test "board usage is scoped to its cards and account usage spans boards" do
+    board = boards(:writebook)
+    other_board = boards(:private)
+    account = accounts("37s")
+
+    cards(:logo).image.attach(io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png")
+    other_card = other_board.cards.create!(title: "Other", creator: users(:kevin), status: "published")
+    other_card.image.attach(io: StringIO.new("x" * 250), filename: "other.png", content_type: "image/png")
+
+    perform_calculation_jobs
+
+    assert_equal 100, board.bytes_used
+    assert_equal 250, other_board.bytes_used
+    assert_equal 350, account.bytes_used
+  end
+
+  test "usage is recalculated when content is removed, cards move, and cards are destroyed" do
+    board = boards(:writebook)
+    other_board = boards(:private)
+    account = accounts("37s")
+    card = cards(:logo)
+
+    card.image.attach(io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png")
+    comment = card.comments.create!(body: "Hello")
+    attach_embed(comment.body, 50, "comment.txt")
+    perform_calculation_jobs
+    assert_equal 150, board.bytes_used
+
+    comment.destroy!
+    perform_calculation_jobs
+    assert_equal 100, board.bytes_used
+
+    card.move_to(other_board)
+    perform_calculation_jobs
+    assert_equal 0, board.bytes_used
+    assert_equal 100, other_board.bytes_used
+    assert_equal 100, account.bytes_used
+
+    card.destroy!
+    perform_calculation_jobs
+    assert_equal 0, other_board.bytes_used
+    assert_equal 0, account.bytes_used
+  end
+
+  test "the same blob embedded more than once is only counted once" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * 80), filename: "shared.txt", content_type: "text/plain")
+
+    card.description.body = ActionText::Content.new("Hello").append_attachables(blob).append_attachables(blob)
+    card.save!
+    perform_calculation_jobs
+
+    assert_equal 80, board.bytes_used
+  end
+
+  test "reading bytes_used only schedules one background calculation" do
+    board = Board.create!(name: "Fresh board", creator: users(:david))
+
+    assert_enqueued_with(job: CalculateBytesUsedJob) do
+      3.times { board.bytes_used }
+      Board.find(board.id).bytes_used
+    end
+
+    perform_calculation_jobs
+
+    assert_no_enqueued_jobs(only: CalculateBytesUsedJob) do
+      board.bytes_used
+    end
+  end
+
+  private
+    def attach_embed(rich_text, byte_size, filename)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * byte_size), filename: filename, content_type: "text/plain"
+      )
+
+      rich_text.body = ActionText::Content.new(rich_text.body&.to_html || "").append_attachables(blob)
+      rich_text.record.save!
+    end
+
+    def perform_calculation_jobs
+      perform_enqueued_jobs(only: [ CalculateBytesUsedJob, ActiveStorage::PurgeJob ])
+    end
+end
