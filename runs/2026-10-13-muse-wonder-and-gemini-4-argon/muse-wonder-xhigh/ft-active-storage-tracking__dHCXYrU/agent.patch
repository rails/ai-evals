diff --git a/lib/rails_ext/active_storage_storage_usage.rb b/lib/rails_ext/active_storage_storage_usage.rb
new file mode 100644
index 0000000..2719a04
--- /dev/null
+++ b/lib/rails_ext/active_storage_storage_usage.rb
@@ -0,0 +1,139 @@
+# Keeps Account/Board storage totals in step with the attachments that
+# count towards them. Only card images and Action Text embeds on boards,
+# cards, and comments count; avatars, exports, imports, and other
+# attachments are ignored.
+#
+# Scheduling is deduplicated per account/board (see StorageTrackable),
+# so creating many attachments at once -- an import, a rich text paste
+# with several files, simultaneous uploads by many users -- enqueues at
+# most one pending recalculation per account/board rather than one per
+# attachment.
+module ActiveStorageAttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    # A single commit callback for all actions: registering separate
+    # create/update/destroy commit callbacks for the same method would
+    # be collapsed into one callback whose conditions never all match.
+    after_commit :schedule_storage_usage_recalculation, on: %i[create update destroy]
+  end
+
+  # Active Storage removes attachments with #delete in several places
+  # (purging and detaching a file, for example), which skips destroy
+  # callbacks. Schedule before those removals too, while the owning
+  # record can still be found.
+  def delete
+    schedule_storage_usage_recalculation
+    super
+  end
+
+  def purge
+    schedule_storage_usage_recalculation
+    super
+  end
+
+  def purge_later
+    schedule_storage_usage_recalculation
+    super
+  end
+
+  def schedule_storage_usage_recalculation
+    storage_usage_targets.each(&:recalculate_bytes_used_later)
+  rescue ActiveRecord::RecordNotFound, ActiveJob::DeserializationError
+    # The owning record is already gone; its destruction schedules a
+    # recalculation for anything that remains.
+    nil
+  end
+
+  private
+    def storage_usage_targets
+      case record_type
+      when "Card"
+        if name == "image"
+          card = Card.find_by(id: record_id)
+          if card
+            [ card.board, card.account ]
+          else
+            storage_usage_account_fallback
+          end
+        else
+          []
+        end
+      when "ActionText::RichText"
+        if name == "embeds"
+          rich_text = ActionText::RichText.find_by(id: record_id)
+
+          if rich_text
+            storage_usage_targets_for_rich_text(rich_text)
+          else
+            storage_usage_account_fallback
+          end
+        else
+          []
+        end
+      else
+        []
+      end.compact.uniq
+    end
+
+    def storage_usage_targets_for_rich_text(rich_text)
+      case rich_text.record
+      when Board
+        if rich_text.name == "public_description"
+          board = rich_text.record
+          [ board, board.account ]
+        else
+          []
+        end
+      when Card
+        if rich_text.name == "description"
+          card = rich_text.record
+          [ card.board, card.account ]
+        else
+          []
+        end
+      when Comment
+        if rich_text.name == "body"
+          comment = rich_text.record
+          [ comment.card&.board, comment.account ]
+        else
+          []
+        end
+      else
+        []
+      end
+    end
+
+    def storage_usage_account_fallback
+      if account_id.present?
+        [ Account.find_by(id: account_id) ]
+      else
+        []
+      end
+    end
+end
+
+module ActiveStorageBlobStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :schedule_storage_usage_recalculation_for_attachments, on: %i[update destroy]
+  end
+
+  private
+    def schedule_storage_usage_recalculation_for_attachments
+      return if transaction_include_any_action?([ :update ]) && !saved_change_to_byte_size?
+
+      attachments.find_each(&:schedule_storage_usage_recalculation)
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageAttachmentStorageUsage
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  include ActiveStorageBlobStorageUsage
+end
diff --git a/test/jobs/calculate_bytes_used_job_test.rb b/test/jobs/calculate_bytes_used_job_test.rb
new file mode 100644
index 0000000..b46a013
--- /dev/null
+++ b/test/jobs/calculate_bytes_used_job_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class CalculateBytesUsedJobTest < ActiveJob::TestCase
+  test "calculates and stores bytes used for a board" do
+    board = boards(:writebook)
+    cards(:logo).image.attach(io: StringIO.new("x" * 42), filename: "image.png", content_type: "image/png")
+
+    CalculateBytesUsedJob.perform_now(board)
+
+    assert_equal 42, board.reload.bytes_used
+    assert board.bytes_used_calculated_at.present?
+  end
+
+  test "calculates and stores bytes used for an account" do
+    account = accounts("37s")
+    cards(:logo).image.attach(io: StringIO.new("x" * 42), filename: "image.png", content_type: "image/png")
+
+    CalculateBytesUsedJob.perform_now(account)
+
+    assert_equal 42, account.reload.bytes_used
+  end
+end
