diff --git a/app/models/concerns/storage_trackable.rb b/app/models/concerns/storage_trackable.rb
new file mode 100644
index 0000000..5ea81e5
--- /dev/null
+++ b/app/models/concerns/storage_trackable.rb
@@ -0,0 +1,113 @@
+module StorageTrackable
+  extend ActiveSupport::Concern
+
+  # Returns the most recently calculated value and, when that value has
+  # never been calculated, schedules a background calculation.
+  #
+  # Storage changes are normally tracked as they happen (see the
+  # Active Storage extensions), so a fresh value is returned straight
+  # from the +bytes_used+ column without summing any blobs. This keeps
+  # reads cheap for accounts and boards of every size.
+  def bytes_used
+    refresh_bytes_used
+    recalculate_bytes_used_later if bytes_used_recalculation_needed?
+
+    read_attribute(:bytes_used).to_i
+  end
+
+  # Schedules a recalculation, but only if one is not already pending.
+  #
+  # The pending flag is claimed with a single atomic UPDATE, so any
+  # number of concurrent callers -- many active users uploading files,
+  # for example -- enqueue just one job per account/board. Subsequent
+  # changes that arrive while that job is still pending are picked up
+  # because the job only calculates once it runs.
+  def recalculate_bytes_used_later
+    if persisted? && !destroyed? && !readonly?
+      claimed = self.class.where(id: id, bytes_used_calculation_pending: false)
+        .update_all(bytes_used_calculation_pending: true)
+
+      if claimed == 1
+        write_bytes_used_calculation_attributes(bytes_used_calculation_pending: true)
+        CalculateBytesUsedJob.perform_later(self)
+        true
+      else
+        false
+      end
+    else
+      false
+    end
+  end
+  alias_method :schedule_bytes_used_recalculation, :recalculate_bytes_used_later
+
+  # Runs in CalculateBytesUsedJob. The pending flag is released before
+  # calculating so that a change arriving while the (potentially large)
+  # calculation is running can schedule a follow-up calculation instead
+  # of being lost.
+  def recalculate_bytes_used
+    if persisted? && !destroyed? && !readonly?
+      self.class.where(id: id, bytes_used_calculation_pending: true)
+        .update_all(bytes_used_calculation_pending: false)
+      write_bytes_used_calculation_attributes(bytes_used_calculation_pending: false)
+
+      calculated_bytes_used = calculate_bytes_used
+
+      update_columns(bytes_used: calculated_bytes_used, bytes_used_calculated_at: Time.current)
+      calculated_bytes_used
+    end
+  end
+
+  # Implemented by Account and Board. Must return the total byte size
+  # of the distinct blobs in scope, calculated in the database.
+  def calculate_bytes_used
+    raise NotImplementedError, "#{self.class} must implement #calculate_bytes_used"
+  end
+
+  private
+    def bytes_used_recalculation_needed?
+      persisted? && !destroyed? &&
+        !read_attribute(:bytes_used_calculation_pending) &&
+        read_attribute(:bytes_used_calculated_at).blank?
+    end
+
+    # Another instance -- usually the background job -- may have stored
+    # a newer value since this instance was loaded. Pick up just the
+    # storage columns with one primary-key lookup rather than returning
+    # a stale in-memory value or reloading the whole record.
+    def refresh_bytes_used
+      if persisted? && !destroyed? && !frozen? && !has_changes_to_save?
+        values = self.class.where(id: id).pick(:bytes_used, :bytes_used_calculated_at, :bytes_used_calculation_pending)
+
+        if values
+          write_bytes_used_calculation_attributes(
+            bytes_used: values[0],
+            bytes_used_calculated_at: values[1],
+            bytes_used_calculation_pending: values[2]
+          )
+        end
+      end
+    end
+
+    def write_bytes_used_calculation_attributes(attributes)
+      attributes.each do |name, value|
+        self[name] = value
+      end
+      clear_attribute_changes(attributes.keys.map(&:to_s))
+    end
+
+    # Sums the byte sizes of the distinct blobs returned by the given
+    # attachment queries entirely in the database. The UNION collapses
+    # blobs that are referenced more than once (or via more than one
+    # kind of content) so their storage is only counted once, and no
+    # blob or attachment records are loaded into Ruby, however many
+    # attachments there are.
+    def sum_bytes_used_for(attachment_queries)
+      union_sql = Array(attachment_queries).map { |query| query.select(:blob_id).to_sql }.join(" UNION ")
+
+      if union_sql.present?
+        ActiveStorage::Blob.where("id IN (#{union_sql})").sum(:byte_size).to_i
+      else
+        0
+      end
+    end
+end
