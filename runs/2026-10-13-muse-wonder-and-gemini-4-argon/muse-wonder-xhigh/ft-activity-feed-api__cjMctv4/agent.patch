+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    activities = Current.user.accessible_events
+      .preloaded
+      .where(action: ACTIVITY_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+
+    activities = activities.where(creator_id: creator_ids) if creator_ids.present?
+    activities = activities.where(board_id: board_ids) if board_ids.present?
+
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def creator_ids
+      filter_ids(:creator_ids)
+    end
+
+    def board_ids
+      filter_ids(:board_ids)
+    end
+
+    def filter_ids(key)
+      Array(params[key]).flat_map { |value| value.to_s.split(",") }.map(&:strip).reject(&:blank?)
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..520dae8
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,57 @@
+raw_particulars = event.particulars
+raw_particulars = {} unless raw_particulars.is_a?(Hash)
+nested_particulars = raw_particulars["particulars"] || raw_particulars[:particulars]
+nested_particulars = {} unless nested_particulars.is_a?(Hash)
+
+particular_value = lambda do |key|
+  if nested_particulars.key?(key)
+    nested_particulars[key]
+  elsif nested_particulars.key?(key.to_sym)
+    nested_particulars[key.to_sym]
+  else
+    raw_particulars[key] || raw_particulars[key.to_sym]
+  end
+end
+
+json.(event, :id, :action, :eventable_type)
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text
+
+case event.action.to_s
+when "card_assigned", "card_unassigned"
+  json.particulars do
+    json.assignee_ids Array(particular_value.call("assignee_ids") || event.assignee_ids)
+  end
+when "card_board_changed"
+  json.particulars do
+    json.old_board particular_value.call("old_board") || particular_value.call("old_collection") || ""
+    json.new_board particular_value.call("new_board") || particular_value.call("new_collection") || ""
+  end
+when "card_title_changed"
+  json.particulars do
+    json.old_title particular_value.call("old_title") || ""
+    json.new_title particular_value.call("new_title") || ""
+  end
+when "card_triaged"
+  json.particulars do
+    json.column particular_value.call("column") || ""
+  end
+else
+  json.particulars({})
+end
+
+if event.eventable.is_a?(Comment)
+  json.url card_url(event.eventable.card, anchor: dom_id(event.eventable))
+else
+  json.url card_url(event.eventable)
+end
+
+json.eventable do
+  case event.eventable
+  when Card then json.partial! "cards/card", card: event.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+  end
+end
+
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
