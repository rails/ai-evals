@@ -0,0 +1,51 @@
+# Activities
+
+Activities represent events that happened in the account, such as cards being created, comments being posted, and cards moving between boards or columns.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of account activity that you can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by event creator user ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_published",
+    "eventable_type": "Card",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David Heinemeier Hansson added \"First!\"",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 1,
+      "title": "First!",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true
+    }
+  }
+]
+```
+
+The `eventable` field contains the card or comment the activity relates to, using the same representation as the Cards and Comments endpoints. For comment activity, `url` opens the card where the comment was posted and jumps to that comment.
+
+The `particulars` field contains event-specific details. Assignment changes include `assignee_ids`, board changes include `old_board` and `new_board`, title changes include `old_title` and `new_title`, and triage events include `column`. Other events return an empty object.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..e1f16fc
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activities newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any?
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:layout_assignment_jz).id }
+    assert_not_nil activity
+    assert_equal "card_assigned", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal events(:layout_assignment_jz).eventable.id, activity.dig("eventable", "id")
+    assert_equal events(:layout_assignment_jz).board.id, activity.dig("board", "id")
+    assert_equal events(:layout_assignment_jz).creator.id, activity.dig("creator", "id")
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+    assert_equal card_url(events(:layout_assignment_jz).eventable), activity["url"]
+    assert activity["description"].present?
+  end
+
+  test "index as JSON returns comment activity with card url anchored to comment" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:layout_commented).id }
+    assert_not_nil activity
+    assert_equal "Comment", activity["eventable_type"]
+    comment = events(:layout_commented).eventable
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index as JSON omits card_collection_changed and includes card_title_changed" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    creator = users(:kevin)
+
+    collection_event = Event.create!(board: board, creator: creator, eventable: card, action: "card_collection_changed", account: Current.account)
+    title_event = Event.create!(board: board, creator: creator, eventable: card, action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }, account: Current.account)
+
+    get activities_path, as: :json
+
+    ids = @response.parsed_body.pluck("id")
+    assert_not_includes ids, collection_event.id
+    assert_includes ids, title_event.id
+
+    activity = @response.parsed_body.find { |a| a["id"] == title_event.id }
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity["particulars"])
+  end
+
+  test "index as JSON returns particulars for board and triage events with empty strings for missing values" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    creator = users(:kevin)
+
+    board_event = Event.create!(board: board, creator: creator, eventable: card, action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "New board" } }, account: Current.account)
+    triage_event = Event.create!(board: board, creator: creator, eventable: card, action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In progress" } }, account: Current.account)
+    missing_board_event = Event.create!(board: board, creator: creator, eventable: card, action: "card_board_changed", account: Current.account)
+
+    get activities_path, as: :json
+
+    board_activity = @response.parsed_body.find { |a| a["id"] == board_event.id }
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, board_activity["particulars"])
+
+    triage_activity = @response.parsed_body.find { |a| a["id"] == triage_event.id }
+    assert_equal({ "column" => "In progress" }, triage_activity["particulars"])
+
+    missing_activity = @response.parsed_body.find { |a| a["id"] == missing_board_event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, missing_activity["particulars"])
+  end
+
+  test "index as JSON filters by creator_ids and board_ids" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |a| a.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.all? { |a| a.dig("board", "id") == boards(:private).id }
+  end
+
+test "index as JSON does not return activities from boards the user cannot access" do
+  restricted_event = Event.create!(board: boards(:private), creator: users(:kevin), eventable: cards(:logo), action: "card_published", account: Current.account)
+
+  get activities_path, as: :json
+  assert_includes @response.parsed_body.pluck("id"), restricted_event.id
+
+  logout_and_sign_in_as :jz
+
+  get activities_path, as: :json
+  assert_not_includes @response.parsed_body.pluck("id"), restricted_event.id
+
+  get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+  assert_equal [], @response.parsed_body
+end
+end
