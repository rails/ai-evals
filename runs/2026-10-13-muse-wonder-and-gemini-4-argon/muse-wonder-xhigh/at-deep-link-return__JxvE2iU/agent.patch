   private
+    # Only allow +return_to+ values that unambiguously point back at this
+    # application: a local path, or an http(s)/protocol-relative URL on the
+    # request's own host. Anything else (another host, another scheme, a
+    # protocol-relative or backslash/whitespace/control-character trick, a
+    # URL with credentials, or a non-String value) is ignored, so signing in
+    # falls back to the usual post-authentication destination instead of
+    # sending the user to an attacker-controlled site.
+    def safe_return_to_url
+      return_to = params[:return_to]
+      return unless return_to.is_a?(String) && return_to.present?
+      return if return_to.match?(/[\x00-\x20\x7f\\]/)
+
+      uri = URI.parse(return_to)
+
+      if uri.host.present?
+        return unless uri.userinfo.blank? && uri.host.casecmp?(request.host.to_s) &&
+          (uri.scheme.blank? || %w[ http https ].include?(uri.scheme.downcase))
+
+        # Rails' own redirect protection compares hosts case-sensitively, so
+        # a differently-cased spelling of this host would raise there. Keep
+        # such deep links working by reducing them to their local path.
+        return return_to if uri.host == request.host
+
+        local_path_from(uri)
+      elsif uri.scheme.blank?
+        return_to if return_to.start_with?("/") && !return_to.start_with?("//")
+      end
+    rescue URI::Error, ArgumentError
+      nil
+    end
+
+    def local_path_from(uri)
+      path = uri.path.presence || "/"
+      return unless path.start_with?("/") && !path.start_with?("//")
+
+      path = path.dup
+      path << "?#{uri.query}" if uri.query.present?
+      path << "##{uri.fragment}" if uri.fragment.present?
+      path
+    end
+
     def ensure_user_exists
       redirect_to first_run_url if User.none?
     end
