--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,81 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  ASSOCIATIONS = {
+    "tag_ids" => :tags,
+    "board_ids" => :boards,
+    "assignee_ids" => :assignees,
+    "creator_ids" => :creators,
+    "closer_ids" => :closers
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    # Filters reference tags, boards and users through join tables,
+    # which have no models of their own, so their IDs are exported
+    # alongside the filter itself.
+    def export_record_data(record)
+      super.merge(join_ids_for(record))
+    end
+
+    def join_ids_for(record)
+      ASSOCIATIONS.to_h do |key, association|
+        [ key, record.association(association).scope.distinct.pluck(:id) ]
+      end
+    end
+
+    def before_import_transform(data, context)
+      fields = data["fields"]
+
+      if fields.is_a?(Hash)
+        fields = fields.deep_dup
+
+        if fields["card_ids"].is_a?(Array)
+          fields["card_ids"] = map_ids(fields["card_ids"], "Card", context)
+        end
+
+        if fields["column_ids"].is_a?(Array)
+          fields["column_ids"] = map_ids(fields["column_ids"], "Column", context)
+        end
+
+        data["fields"] = fields
+      end
+    end
+
+    def after_import_record(row, data, context)
+      associations = {
+        "tag_ids" => :tag,
+        "board_ids" => :board,
+        "assignee_ids" => :assignee,
+        "creator_ids" => :creator,
+        "closer_ids" => :closer
+      }
+      types = {
+        "tag_ids" => "Tag",
+        "board_ids" => "Board",
+        "assignee_ids" => "User",
+        "creator_ids" => "User",
+        "closer_ids" => "User"
+      }
+
+      return unless associations.keys.any? { |key| data[key].is_a?(Array) }
+
+      filter = model.find_by(id: row["id"])
+      return unless filter
+
+      associations.each do |key, association|
+        old_ids = data[key]
+        next unless old_ids.is_a?(Array)
+
+        filter.public_send("#{association}_ids=", map_ids(old_ids, types[key], context))
+      end
+    end
+
+    def map_ids(ids, type, context)
+      ids.filter_map do |old_id|
+        context.mapped_id(type, old_id) ||
+          (type.safe_constantize&.exists?(old_id) ? old_id : nil)
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/import_context.rb b/app/models/account/data_transfer/import_context.rb
new file mode 100644
index 0000000..d15269d
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,59 @@
+# Carries the shared state for a single account import: the map from the
+# IDs used inside the exported ZIP file ("old" IDs) to the freshly
+# generated IDs used for the imported records, the account being
+# created, and the list of storage keys that have been written so they
+# can be cleaned up if the import fails and is rolled back.
+class Account::DataTransfer::ImportContext
+  attr_accessor :account, :source_account_id
+  attr_reader :id_map, :uploaded_blob_keys, :importing_identity, :blob_keys_by_old_key
+
+  def initialize(importing_identity: nil)
+    @importing_identity = importing_identity
+    @id_map = {}
+    @uploaded_blob_keys = []
+    @blob_keys_by_old_key = {}
+  end
+
+  def register(model_name, old_id, new_id)
+    return new_id if old_id.blank?
+
+    @id_map[[ model_name.to_s, old_id.to_s ]] = new_id
+  end
+
+  def mapped_id(model_name, old_id)
+    return if old_id.blank?
+
+    @id_map[[ model_name.to_s, old_id.to_s ]]
+  end
+
+  # Returns the new ID registered for an old ID, generating and
+  # registering one when this is the first time we've seen it.
+  def new_id_for(model_name, old_id)
+    mapped_id(model_name, old_id) ||
+      register(model_name, old_id, ActiveRecord::Type::Uuid.generate)
+  end
+
+  def account_id
+    account&.id || mapped_id("Account", source_account_id)
+  end
+
+  def track_uploaded_blob(blob)
+    @uploaded_blob_keys << blob.key if blob&.key.present?
+    @uploaded_blob_keys.uniq!
+  end
+
+  # Remove any files that were written to the storage service before a
+  # failed import was rolled back, so a failed import leaves no trace in
+  # storage either.
+  def cleanup_uploaded_files
+    uploaded_blob_keys.each do |key|
+      blob = ActiveStorage::Blob.find_by(key: key)
+      service = blob&.service || ActiveStorage::Blob.service
+      begin
+        service.delete(key)
+      rescue => _error
+        nil
+      end
+    end
+  end
+end
