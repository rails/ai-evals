@@ -0,0 +1,150 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "importing an account export creates a new account with everything in it" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    boards(:writebook).publish
+    publication_key = boards(:writebook).publication.key
+
+    export = build_account_export
+
+    assert_difference "Account.count", 1 do
+      @import = build_import(export)
+      assert @import.import_now, @import.failure_reason
+    end
+
+    imported_account = @import.imported_account
+
+    assert imported_account
+    assert_not_equal @account.id, imported_account.id
+    assert_not_equal @account.external_account_id, imported_account.external_account_id
+    assert_equal @account.name, imported_account.name
+    assert_equal @account.boards.count, imported_account.boards.count
+    assert_equal @account.cards.count, imported_account.cards.count
+    assert_equal @account.users.active.count, imported_account.users.active.count
+    assert_equal @account.users.active.map { |it| it.identity.email_address }.compact.sort,
+      imported_account.users.active.map { |it| it.identity.email_address }.compact.sort
+
+    imported_card = imported_account.cards.find_by!(title: card.title)
+    assert_not_equal card.id, imported_card.id
+    assert imported_card.comments.any?
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+    assert_equal card.image.blob.download, imported_card.image.blob.download
+
+    imported_filter = Filter.where(account_id: imported_account.id).first
+    assert imported_filter
+    assert_equal 1, imported_filter.tags.count if Filter.where(account_id: @account.id).joins(:tags).any?
+
+    imported_board = imported_account.boards.find_by!(name: boards(:writebook).name)
+    assert imported_board.publication
+    assert_not_equal publication_key, imported_board.publication.key
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy import is complete", email.subject
+    assert_match imported_account.name, email.body.encoded
+  end
+
+  test "rich text embeds point at the imported files" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "embed.jpg", content_type: "image/jpeg")
+    attachment_html = ActionText::Attachment.from_attachable(blob).to_html
+    card.update!(description: "<p>Description #{attachment_html}</p>")
+
+    @import = build_import(build_account_export)
+    assert @import.import_now, @import.failure_reason
+
+    imported_card = @import.imported_account.cards.find_by!(title: card.title)
+    imported_blob = imported_card.description.embeds.first.blob
+
+    assert imported_blob
+    assert_not_equal blob.id, imported_blob.id
+    assert_equal @import.imported_account.id, imported_blob.account_id
+    assert_equal blob.byte_size, imported_blob.byte_size
+  end
+
+test "an imported account can be exported and imported again" do
+  card = cards(:logo)
+  blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "embed.jpg", content_type: "image/jpeg")
+  card.update!(description: "<p>Description #{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+
+  first_import = build_import(build_account_export)
+  assert first_import.import_now, first_import.failure_reason
+
+    second_export = Current.with_account(first_import.imported_account) do
+      export = Export.create!(account: first_import.imported_account, user: first_import.imported_account.users.active.first, kind: "account")
+      assert export.export_now, export.failure_reason
+      export
+    end
+
+    second_import = Import.create!(account: @account, user: @user, identity: @user.identity)
+    second_import.file.attach(io: StringIO.new(second_export.file.download), filename: "export.zip", content_type: "application/zip")
+    assert second_import.import_now, second_import.failure_reason
+
+    imported_card = second_import.imported_account.cards.find_by!(title: card.title)
+    assert_equal 1, imported_card.description.embeds.count
+    assert_match "Description", imported_card.description.to_plain_text
+  end
+
+  test "failed import leaves nothing behind and emails the reason" do
+    import = Import.create!(account: @account, user: @user, identity: @user.identity)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip")
+
+    assert_no_difference [ "Account.count", "Board.count", "Card.count" ] do
+      assert_not import.import_now
+    end
+
+    assert import.failed?
+    assert import.failure_reason.present?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal "Your Fizzy import failed", email.subject
+    assert_match import.failure_reason, email.body.encoded
+  end
+
+  test "a cards export cannot be imported as an account" do
+    export = Export.create!(account: @account, user: @user, kind: "user")
+    assert export.export_now, export.failure_reason
+
+    import = build_import(export)
+
+    assert_no_difference "Account.count" do
+      assert_not import.import_now
+    end
+
+    assert import.failed?
+    assert_match(/account/i, import.failure_reason)
+  end
+
+  test "the same export can be imported twice, creating two accounts" do
+    export = build_account_export
+
+    first = build_import(export)
+    second = build_import(export)
+
+    assert first.import_now, first.failure_reason
+    assert second.import_now, second.failure_reason
+    assert_not_equal first.imported_account.id, second.imported_account.id
+  end
+
+  private
+    def build_account_export
+      Export.create!(account: @account, user: @user, kind: "account").tap do |export|
+        assert export.export_now, export.failure_reason
+      end
+    end
+
+    def build_import(export)
+      Import.create!(account: @account, user: @user, identity: @user.identity).tap do |import|
+        import.file.attach(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+      end
+    end
+end
diff --git a/test/models/zip_file_reader_test.rb b/test/models/zip_file_reader_test.rb
new file mode 100644
index 0000000..3c32eaf
--- /dev/null
+++ b/test/models/zip_file_reader_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "reads entries written by the writer" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("hello.txt", "Hello, World! " * 100)
+    writer.add_file("docs/readme.txt", "Readme")
+    writer.add_file("data.bin", (0..255).map(&:chr).join * 10, compress: false)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert_equal [ "data.bin", "docs/readme.txt", "hello.txt" ], reader.filenames.sort
+    assert reader.exists?("hello.txt")
+    assert_not reader.exists?("missing.txt")
+    assert_equal [ "docs/readme.txt" ], reader.glob("docs/*.txt")
+    assert_equal "Readme", reader.read("docs/readme.txt")
+    assert_equal 2560, reader.read("data.bin").bytesize
+    assert_raises(ZipFile::Reader::Error) { reader.read("missing.txt") }
+  end
+
+  test "rejects files that are not zip archives" do
+    assert_raises(ZipFile::Reader::Error) do
+      ZipFile::Reader.new(StringIO.new("not a zip"))
+    end
+  end
+
+  test "reads a zip stored as an active storage blob via ranged service reads" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("hello.txt", "Hello from a blob")
+    writer.close
+    tempfile.rewind
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: tempfile, filename: "test.zip", content_type: "application/zip")
+
+    service_reader = ZipFile::Reader.new(ZipFile::Reader::ServiceIO.new(blob))
+    assert_equal "Hello from a blob", service_reader.read("hello.txt")
+
+    blob_reader = ZipFile::Reader.for_blob(blob)
+    assert_equal "Hello from a blob", blob_reader.read("hello.txt")
+  end
+end
