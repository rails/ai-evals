diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..ebc7e30
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "account export contains account data, cards as JSON with comments, and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: @account, user: @user, kind: "account")
+
+    assert export.export_now, export.failure_reason
+    assert export.completed?
+    assert export.file.attached?
+
+    reader = reader_for(export)
+
+    assert reader.exists?("manifest.json")
+    assert reader.exists?("accounts/#{@account.id}.json")
+    assert reader.exists?("boards/#{boards(:writebook).id}.json")
+    assert reader.exists?("cards/#{card.id}.json")
+
+    cards = JSON.parse(reader.read("cards.json"))
+    exported_card = cards.find { |it| it["title"] == card.title }
+
+    assert exported_card
+    assert exported_card["comments"].any? { |comment| comment["body"].to_s.include?("I agree") }
+
+    attachment = exported_card["attachments"].find { |it| it["filename"] == "moon.jpg" }
+    assert attachment
+    assert_equal card.image.blob.byte_size, reader.read(attachment["path"]).bytesize
+  end
+
+  test "user export only contains cards the user can see, with their files" do
+    secret_card = boards(:private).cards.create!(title: "Secret card", creator: @user, status: "published")
+    visible_card = cards(:logo)
+    visible_card.image.attach(io: StringIO.new("visible image"), filename: "visible.txt", content_type: "text/plain")
+
+    export = Export.create!(account: @account, user: users(:david), kind: "user")
+
+    assert export.export_now, export.failure_reason
+
+    reader = reader_for(export)
+    cards = JSON.parse(reader.read("cards.json"))
+    titles = cards.map { |it| it["title"] }
+
+    assert_includes titles, visible_card.title
+    assert_not_includes titles, secret_card.title
+
+    attachment = cards.find { |it| it["title"] == visible_card.title }["attachments"].first
+    assert_equal "visible image", reader.read(attachment["path"])
+  end
+
+  test "download link is signed and expires after a day" do
+    export = Export.create!(account: @account, user: @user, kind: "account")
+    token = export.download_signed_id
+
+    travel 23.hours do
+      assert_equal export, Export.find_by_download_token(token)
+    end
+
+    travel 25.hours do
+      assert_nil Export.find_by_download_token(token)
+    end
+  end
+
+  private
+    def reader_for(export)
+      tempfile = Tempfile.new([ "export", ".zip" ])
+      tempfile.binmode
+      export.file.download { |chunk| tempfile.write(chunk) }
+      tempfile.rewind
+      ZipFile::Reader.new(tempfile)
+    end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
