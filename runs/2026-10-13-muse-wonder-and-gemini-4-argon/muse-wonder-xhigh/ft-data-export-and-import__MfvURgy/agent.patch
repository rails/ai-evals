+class Account::DataTransfer::BoardPublicationRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: ::Board::Publication)
+  end
+
+  private
+    # Publication keys are global URL tokens and are unique across
+    # accounts, so an imported publication gets a fresh key instead of
+    # colliding with (or hijacking) the original board's public link.
+    def before_import_transform(data, context)
