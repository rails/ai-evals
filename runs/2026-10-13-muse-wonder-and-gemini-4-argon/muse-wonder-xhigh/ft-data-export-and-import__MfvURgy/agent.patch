diff --git a/app/models/account/data_transfer/active_storage/file_record_set.rb b/app/models/account/data_transfer/active_storage/file_record_set.rb
index 1367a49..9843153 100644
--- a/app/models/account/data_transfer/active_storage/file_record_set.rb
+++ b/app/models/account/data_transfer/active_storage/file_record_set.rb
@@ -1,15 +1,174 @@
+require "digest"
+
 class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfer::RecordSet
   def initialize(account)
     super(account: account, model: ::ActiveStorage::Blob)
   end
 
+  # This set writes file contents, not JSON records, so there is
+  # nothing to pre-register.
+  def register_import_ids(zip, context)
+    context
+  end
+
   private
     def records
-      ::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids)
+      ::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids).where("active_storage_blobs.checksum IS NULL OR active_storage_blobs.checksum != 'pending'")
     end
 
     def excluded_blob_ids
       ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
     end
 
+    def model_dir
+      "files"
+    end
+
+    # -- Export ------------------------------------------------------
+
+    def export_record(record)
+      zip.add_file(entry_path_for(record), compress: false) do |sink|
+        record.download do |chunk|
+          sink.write(chunk)
+        end
+      end
+    end
+
+    def entry_path_for(blob)
+      filename = blob.filename.to_s.gsub("/", "_").gsub("\\", "_")
+      filename = blob.key if filename.blank?
+      File.join(model_dir, blob.key, filename)
+    end
+
+    # -- Import ------------------------------------------------------
+
+    def import_records(context)
+      blob_data = blob_metadata_entries
+
+      if blob_data.empty?
+        return if zip.filenames.none? { |filename| filename.include?("files/") }
+        raise Error, "Import file does not contain any file metadata"
+      end
+
+      blob_data.each do |data|
+        old_key = data["key"]
+        old_id = data["id"]
+
+        new_id = context.mapped_id("ActiveStorage::Blob", old_id)
+        blob = new_id && ::ActiveStorage::Blob.find_by(id: new_id)
+
+        unless blob
+          raise Error, "Import file contains a file for a missing blob (#{old_id})"
+        end
+
+        file_path = find_file_path(data)
+
+        unless file_path
+          raise Error, "Import file is missing the file for #{data['filename'] || old_key}"
+        end
+
+        upload_blob_file(blob, file_path, context)
+      end
+    end
+
+    def blob_metadata_entries
+      paths = zip.filenames.select do |filename|
+        filename.match?(%r{(?:\A|/)active_storage_blobs/[^/]+\.json\z})
+      end.sort
+
+      if paths.any?
+        paths.map { |path| parse_json_entry(path) }
+      else
+        aggregate = zip.filenames.find do |filename|
+          filename == "active_storage_blobs.json" || filename.end_with?("/active_storage_blobs.json")
+        end
+
+        if aggregate
+          parsed = JSON.parse(zip.read(aggregate))
+          parsed.is_a?(Array) ? parsed : parsed["active_storage_blobs"] || []
+        else
+          []
+        end
+      end
+    rescue JSON::ParserError => error
+      raise Error, "Invalid blob metadata in import file: #{error.message}"
+    end
+
+    def find_file_path(data)
+      old_key = data["key"].to_s
+      old_id = data["id"].to_s
+      filename = data["filename"].to_s
+
+      candidates = [
+        File.join(model_dir, old_key),
+        File.join(model_dir, old_id),
+        File.join("data", model_dir, old_key),
+        File.join("active_storage", "files", old_key),
+        File.join("blobs", old_key),
+        File.join("attachments", old_id, filename)
+      ]
+
+      candidates.find { |candidate| zip.exists?(candidate) } ||
+        zip.filenames.find { |entry| entry.end_with?("/#{old_key}") && old_key.present? } ||
+        zip.filenames.find { |entry| entry.include?(File.join(model_dir, old_key, "")) } ||
+        zip.filenames.find { |entry| entry.start_with?(File.join(model_dir, old_key, "")) } ||
+        zip.filenames.find { |entry| entry.start_with?(File.join(model_dir, old_id, "")) } ||
+        zip.filenames.find { |entry| entry.include?("/#{old_id}/") && filename.present? && entry.end_with?(filename) }
+    end
+
+    # Stream the ZIP entry to the blob's service, verifying the MD5
+    # checksum recorded for the blob as we go, rather than loading the
+    # whole file into memory.
+    def upload_blob_file(blob, file_path, context)
+      digest = Digest::MD5.new
+      entry_io = zip.open_entry(file_path)
+      digesting_io = DigestingIO.new(entry_io, digest)
+
+      context.track_uploaded_blob(blob)
+
+      if defined?(ActiveStorage::Service::S3Service) && blob.service.is_a?(ActiveStorage::Service::S3Service)
+        blob.service.send(:upload_stream, key: blob.key, content_type: blob.content_type, part_size: 100.megabytes) do |write_stream|
+          write_stream.binmode if write_stream.respond_to?(:binmode)
+
+          while (chunk = digesting_io.read(ZipFile::Reader::CHUNK_SIZE))
+            write_stream.write(chunk)
+          end
+        end
+      else
+        blob.service.upload(blob.key, digesting_io)
+      end
+
+      if blob.checksum.present?
+        actual_checksum = Base64.strict_encode64(digest.digest)
+
+        unless actual_checksum == blob.checksum
+          raise Error, "Checksum mismatch for file #{blob.filename}"
+        end
+      end
+    end
+
+    class DigestingIO
+      def initialize(io, digest)
+        @io = io
+        @digest = digest
+      end
+
+      def read(length = nil, outbuf = nil)
+        chunk = @io.read(length, outbuf)
+
+        if chunk && !chunk.empty?
+          @digest.update(chunk)
+        end
+
+        chunk
+      end
