diff --git a/app/mailers/import_mailer.rb b/app/mailers/import_mailer.rb
new file mode 100644
index 0000000..9fd4944
--- /dev/null
+++ b/app/mailers/import_mailer.rb
@@ -0,0 +1,33 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.imported_account
+    @identity = import.notifiable_identity
+    @account_url = if @account
+      landing_url(script_name: @account.slug, host: default_url_host)
+    end
+
+    mail(
+      to: @identity&.email_address,
+      subject: "Your Fizzy import is complete"
+    )
+  end
+
+  def failed(import)
+    @import = import
+    @identity = import.notifiable_identity
+    @failure_reason = import.failure_reason.presence || "The file could not be imported."
+    @filename = import.source_filename
+
+    mail(
+      to: @identity&.email_address,
+      subject: "Your Fizzy import failed"
+    )
+  end
+
+  private
+    def default_url_host
+      Rails.application.config.action_mailer.default_url_options&.dig(:host) ||
+        Rails.application.routes.default_url_options&.dig(:host)
+    end
+end
