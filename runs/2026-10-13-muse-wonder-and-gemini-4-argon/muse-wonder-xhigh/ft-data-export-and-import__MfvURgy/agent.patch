@@ -1,3 +1,7 @@
+require "base64"
+require "cgi"
+require "json"
+
 class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransfer::RecordSet
   def initialize(account)
     super(account: account, model: ::ActionText::RichText)
@@ -8,4 +12,70 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    # #attributes renders rich text (expanding attachments into
+    # figures with signed URLs for the old records), so export the
+    # raw stored body instead: it is the portable form that only
+    # references attachables by SGID.
+    def export_record_data(record)
+      super.merge("body" => record.read_attribute_before_type_cast("body"))
+    end
+
+    # Rich text bodies reference attachables (files, mentioned users,
+    # ...) by signed global ID. Those SGIDs mention the old record IDs,
+    # so rewrite them to point at the imported copies.
+    def before_import_transform(data, context)
+      if data["body"].is_a?(String)
+        data["body"] = rewrite_signed_global_ids(data["body"], context)
+      end
+    end
+
+    def rewrite_signed_global_ids(body, context)
+      body.gsub(/sgid="([^"]+)"/) do
+        original = Regexp.last_match(1)
+        replacement = rewritten_sgid(original, context)
+        %(sgid="#{replacement || original}")
+      end
+    end
+
+    def rewritten_sgid(sgid, context)
+      decoded = decode_signed_global_id(sgid)
+      return unless decoded
+
+      model_name, old_id = decoded
+      new_id = context.mapped_id(model_name, old_id)
+      return unless new_id
+
+      klass = model_name.safe_constantize
+      return unless klass && klass < ActiveRecord::Base
+
+      record = klass.find_by(id: new_id)
+      return unless record
+
+      if record.respond_to?(:attachable_sgid)
+        record.attachable_sgid.to_s
+      elsif record.respond_to?(:to_sgid)
+        record.to_sgid(for: :attachable).to_s
+      end
+    rescue ActiveRecord::RecordNotFound, NameError
+      nil
+    end
+
+    # A signed global ID is `<base64 payload>--<signature>`; the payload
+    # is JSON containing the plain global ID, which we can read without
+    # verifying the signature (we only use it to look the ID up in the
+    # import map, never to locate a record in this instance).
+    def decode_signed_global_id(sgid)
+      payload = sgid.to_s.split("--", 2).first
+      return unless payload
+
+      parsed = JSON.parse(Base64.decode64(payload))
+      gid = parsed.dig("_rails", "data") || parsed["data"] || parsed.dig("_rails", "message")
+      return unless gid.is_a?(String)
+
+      if (match = gid.match(%r{\Agid://[^/]+/(.+)/([^/?]+)}))
+        [ CGI.unescape(match[1]), CGI.unescape(match[2]) ]
+      end
+    rescue JSON::ParserError, ArgumentError
+      nil
+    end
 end
