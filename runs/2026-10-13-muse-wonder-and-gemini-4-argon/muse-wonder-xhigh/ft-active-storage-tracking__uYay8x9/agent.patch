diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..5709257
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,51 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :schedule_account_bytes_used_recalculation
+  end
+
+  private
+    # Count, in a handful of aggregate queries, the blobs attached as:
+    #
+    # * this board's description embeds
+    # * images on this board's cards
+    # * embeds in this board's card descriptions
+    # * embeds in comments on this board's cards
+    #
+    # Each query is a SQL SUM over an indexed subquery, so no
+    # attachment or blob records are loaded into Ruby.
+    def calculate_bytes_used
+      card_ids = cards.select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+      card_images = ActiveStorage::Attachment.where(record_type: "Card", record_id: card_ids, name: "image")
+
+      bytes_used_for(card_images) +
+        bytes_used_for_rich_texts("Board", id, "public_description") +
+        bytes_used_for_rich_texts("Card", card_ids, "description") +
+        bytes_used_for_rich_texts("Comment", comment_ids, "body")
+    end
+
+    # Update the account in the same job, rather than enqueueing a
+    # second job for it: an account total is just the (cheap) sum of
+    # its boards' cached totals, and doing it here keeps the account
+    # up to date as soon as this board's job has run.
+    def after_bytes_used_recalculated
+      Account.find_by(id: account_id)&.recalculate_bytes_used
+    end
+
+    def schedule_account_bytes_used_recalculation
+      Account.find_by(id: account_id)&.schedule_bytes_used_recalculation
+    end
+
+    def bytes_used_for_rich_texts(record_type, record_ids, name)
+      rich_text_ids = ActionText::RichText.where(record_type: record_type, record_id: record_ids, name: name).select(:id)
+      embeds = ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+
+      bytes_used_for(embeds)
+    end
+
+    def bytes_used_for(attachments)
+      attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+end
