diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..c6c3d03
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,90 @@
+# Tracks a cached storage total that is recalculated in the background.
+#
+# Reading +bytes_used+ never scans attachments: it returns the cached
+# column. Changes to relevant attachments (see
+# ActiveStorageAttachmentStorageUsage) claim a single pending
+# recalculation via +bytes_used_recalculation_scheduled_at+, so a burst
+# of uploads from many users enqueues at most one job per record. The
+# job clears that claim *before* it calculates, so any change committed
+# while the calculation is running can claim (and enqueue) the next one
+# instead of being lost.
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  # Returns the most recently calculated value. This is a single
+  # primary-key lookup for the cached column -- never a scan of
+  # attachments -- so it stays cheap, and so that a long-lived
+  # in-memory instance sees totals calculated in the background
+  # instead of whatever value it happened to be loaded with. Records
+  # that have never been calculated (e.g. ones that predate storage
+  # tracking, or whose attachments bypassed callbacks) schedule a
+  # calculation so their value becomes up to date.
+  def bytes_used
+    if persisted? && !destroyed?
+      row = self.class.where(id: id).pick(:bytes_used, :bytes_used_calculated_at, :bytes_used_recalculation_scheduled_at)
+
+      if row
+        value, calculated_at, scheduled_at = row
+
+        if calculated_at.nil? && scheduled_at.nil?
+          schedule_bytes_used_recalculation
+        end
+
+        value.to_i
+      else
+        super
+      end
+    else
+      super
+    end
+  end
+
+  # Atomically claim the pending recalculation, enqueueing a job only
+  # for the caller that wins the claim. Returns true when a job was
+  # enqueued.
+  def schedule_bytes_used_recalculation
+    if persisted? && !destroyed?
+      now = Time.current
+
+      if self.class.where(id: id, bytes_used_recalculation_scheduled_at: nil).update_all(bytes_used_recalculation_scheduled_at: now) == 1
+        self.bytes_used_recalculation_scheduled_at = now
+        bytes_used_recalculation_job_class.perform_later(self)
+        true
+      else
+        false
+      end
+    else
+      false
+    end
+  end
+
+  def recalculate_bytes_used
+    clear_bytes_used_recalculation_schedule
+
+    total = calculate_bytes_used
+
+    update_columns(bytes_used: total, bytes_used_calculated_at: Time.current)
+    after_bytes_used_recalculated
+    total
+  end
+
+  private
+    def clear_bytes_used_recalculation_schedule
+      self.class.where(id: id).update_all(bytes_used_recalculation_scheduled_at: nil)
+      self.bytes_used_recalculation_scheduled_at = nil
+    end
+
+    def bytes_used_recalculation_job_class
+      "#{self.class}::RecalculateBytesUsedJob".constantize
+    end
+
+    # Implemented by each including model: a set-based aggregate that
+    # returns the current total without loading attachments into Ruby.
+    def calculate_bytes_used
+      raise NotImplementedError
+    end
+
+    # Hook for follow-up work (e.g. a board schedules its account).
+    def after_bytes_used_recalculated
+    end
+end
