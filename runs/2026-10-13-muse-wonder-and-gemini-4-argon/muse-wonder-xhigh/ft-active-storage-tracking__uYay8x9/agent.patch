--- /dev/null
+++ b/app/models/card/storage.rb
@@ -0,0 +1,28 @@
+# Keeps the containing board's cached storage total up to date when
+# this card's own lifecycle affects it without any attachment changing:
+# destroying the card (its image and rich-text embeds are purged
+# later) and moving it to another board.
+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :schedule_board_bytes_used_recalculation
+    # +after_update+ rather than the commit variant: moving a card
+    # triggers a further update (clearing its column) in the same
+    # transaction, after which +saved_change_to_board_id?+ no longer
+    # reflects the move. Scheduling is transactional -- the claim is
+    # rolled back and the job discarded if the move is -- so it is
+    # safe to schedule here.
+    after_update :schedule_boards_bytes_used_recalculation, if: :saved_change_to_board_id?
+  end
+
+  private
+    def schedule_board_bytes_used_recalculation(board_id = self.board_id)
+      Board.find_by(id: board_id)&.schedule_bytes_used_recalculation
+    end
+
+    def schedule_boards_bytes_used_recalculation
+      schedule_board_bytes_used_recalculation(board_id_before_last_save)
+      schedule_board_bytes_used_recalculation
+    end
+end
