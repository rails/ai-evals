diff --git a/lib/rails_ext/active_storage_attachment_storage_usage.rb b/lib/rails_ext/active_storage_attachment_storage_usage.rb
new file mode 100644
index 0000000..35f5ba5
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage_usage.rb
@@ -0,0 +1,119 @@
+# Schedules storage recalculation whenever a countable attachment is
+# created or destroyed.
+#
+# Countable attachments are only:
+#
+# * +image+ attachments on Cards
+# * +embeds+ attachments on ActionText rich texts belonging to a
+#   Board (+public_description+), a Card (+description+), or a
+#   Comment (+body+)
+#
+# Everything else (avatars, exports, imports, ...) is ignored.
+#
+# Resolution is a few indexed lookups per attachment change, and the
+# recalculation itself is claimed atomically by the board/account (see
+# StorageUsage), so bursts of changes collapse into a single job.
+module ActiveStorageAttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :capture_storage_usage_container_ids
+    after_create_commit :schedule_storage_usage_recalculation
+    after_create :schedule_storage_usage_recalculation
+    after_destroy_commit :schedule_storage_usage_recalculation
+    after_destroy :schedule_storage_usage_recalculation
+  end
+
+  # Attachment#purge, #purge_later and detach remove the record with
+  # +delete+, which skips destroy callbacks entirely, so removal has
+  # to be intercepted here as well as in the callbacks above.
+  def delete
+    capture_storage_usage_container_ids
+
+    super.tap do
+      schedule_storage_usage_recalculation
+    end
+  end
+
+  # Public so a blob whose byte size changes can reschedule the
+  # containers of all of its attachments.
+  def schedule_storage_usage_recalculation
+    board_id, account_id = storage_usage_container_ids
+
+    if board_id.present?
+      Board.find_by(id: board_id)&.schedule_bytes_used_recalculation
+    elsif account_id.present?
+      Account.find_by(id: account_id)&.schedule_bytes_used_recalculation
+    end
+  rescue => error
+    Rails.error.report(error, context: { attachment_id: id, record_type: record_type, record_id: record_id })
+  end
+
+  private
+    def capture_storage_usage_container_ids
+      @storage_usage_container_ids = storage_usage_container_ids
+    rescue
+      @storage_usage_container_ids = nil
+    end
+
+    def storage_usage_container_ids
+      @storage_usage_container_ids || compute_storage_usage_container_ids
+    end
+
+    def compute_storage_usage_container_ids
+      case record_type
+      when "Card"
+        if name == "image"
+          [ Card.where(id: record_id).pick(:board_id), account_id ]
+        end
+      when "ActionText::RichText"
+        if name == "embeds"
+          rich_text_container_ids
+        end
+      end
+    end
+
+    def rich_text_container_ids
+      rich_text = ActionText::RichText.where(id: record_id).pick(:record_type, :record_id, :name)
+
+      if rich_text
+        owner_type, owner_id, rich_text_name = rich_text
+
+        case owner_type
+        when "Board"
+          [ owner_id, account_id ] if rich_text_name == "public_description"
+        when "Card"
+          [ Card.where(id: owner_id).pick(:board_id), account_id ] if rich_text_name == "description"
+        when "Comment"
+          if rich_text_name == "body"
+            card_id = Comment.where(id: owner_id).pick(:card_id)
+            [ Card.where(id: card_id).pick(:board_id), account_id ] if card_id
+          end
+        end
+      end
+    end
+end
+
+module ActiveStorageBlobStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_update_commit :schedule_storage_usage_recalculation, if: :saved_change_to_byte_size?
+    after_update :schedule_storage_usage_recalculation, if: :saved_change_to_byte_size?
+  end
+
+  private
+    def schedule_storage_usage_recalculation
+      attachments.each(&:schedule_storage_usage_recalculation)
+    rescue => error
+      Rails.error.report(error, context: { blob_id: id })
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorageAttachmentStorageUsage
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  include ActiveStorageBlobStorageUsage
+end
diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..a1a8c17
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,233 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "board and account count card images" do
+    attach_card_image(@card, "hello")
+
+    perform_enqueued_jobs
+
+    assert_equal 5, @board.reload.bytes_used
+    assert_equal 5, @account.reload.bytes_used
+  end
+
+  test "board and account count embeds in board, card and comment rich text" do
+    attach_embed(@board, :public_description, "board")
+    attach_embed(@card, :description, "card!")
+    comment = @card.comments.create!(body: "hi")
+    attach_embed(comment, :body, "comment")
+
+    perform_enqueued_jobs
+
+    assert_equal 5 + 5 + 7, @board.reload.bytes_used
+    assert_equal 5 + 5 + 7, @account.reload.bytes_used
+  end
+
+  test "avatars and other attachments do not count" do
+    users(:david).avatar.attach(io: StringIO.new("avatar-bytes"), filename: "avatar.txt", content_type: "text/plain")
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "counting embeds on newly created records" do
+    blob1 = make_blob("aaa")
+    new_card = @board.cards.create!(title: "New", creator: users(:david), status: :published, description: embed_html(blob1))
+    blob2 = make_blob("bbbb")
+    new_card.comments.create!(body: embed_html(blob2))
+
+    perform_enqueued_jobs
+
+    assert_equal 7, @board.reload.bytes_used
+    assert_equal 7, @account.reload.bytes_used
+  end
+
+  test "bytes_used reflects background calculations without reloading" do
+    attach_card_image(@card, "hello")
+
+    perform_enqueued_jobs
+
+    assert_equal 5, @board.bytes_used
+    assert_equal 5, @account.bytes_used
+  end
+
+  test "account sums boards and boards only count their own cards" do
+    other_board = boards(:private)
+    other_card = other_board.cards.create!(title: "Other", creator: users(:david), status: :published)
+
+    attach_card_image(@card, "12345")
+    attach_card_image(other_card, "1234567")
+
+    perform_enqueued_jobs
+
+    assert_equal 5, @board.reload.bytes_used
+    assert_equal 7, other_board.reload.bytes_used
+    assert_equal 12, @account.reload.bytes_used
+    assert_equal 0, accounts("initech").reload.bytes_used
+  end
+
+  test "removing a card image reduces usage" do
+    attach_card_image(@card, "hello world")
+    perform_enqueued_jobs
+    assert_equal 11, @board.reload.bytes_used
+
+    @card.image.purge
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "purging a card image via purge_later reduces usage" do
+    attach_card_image(@card, "hello world")
+    perform_enqueued_jobs
+
+    @card.image.purge_later
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "replacing a card image replaces its contribution" do
+    attach_card_image(@card, "12345")
+    perform_enqueued_jobs
+
+    attach_card_image(@card, "123456789")
+    perform_enqueued_jobs
+
+    assert_equal 9, @board.reload.bytes_used
+    assert_equal 9, @account.reload.bytes_used
+  end
+
+  test "removing an embed from rich text reduces usage" do
+    attach_embed(@card, :description, "1234567")
+    perform_enqueued_jobs
+    assert_equal 7, @board.reload.bytes_used
+
+    @card.update!(description: "no files here")
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "destroying a card reduces usage" do
+    attach_card_image(@card, "12345")
+    comment = @card.comments.create!(body: "hi")
+    attach_embed(comment, :body, "123")
+    perform_enqueued_jobs
+    assert_equal 8, @board.reload.bytes_used
+
+    clear_enqueued_jobs
+    @card.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "destroying a comment reduces usage" do
+    comment = @card.comments.create!(body: "hi")
+    attach_embed(comment, :body, "123456")
+    perform_enqueued_jobs
+    assert_equal 6, @board.reload.bytes_used
+
+    clear_enqueued_jobs
+    comment.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "destroying a board reduces account usage" do
+    attach_card_image(@card, "12345")
+    perform_enqueued_jobs
+    assert_equal 5, @account.reload.bytes_used
+
+    clear_enqueued_jobs
+    @board.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card moves its usage between boards" do
+    other_board = boards(:private)
+    attach_card_image(@card, "12345678")
+    perform_enqueued_jobs
+
+    @card.move_to(other_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 8, other_board.reload.bytes_used
+    assert_equal 8, @account.reload.bytes_used
+  end
+
+  test "many changes enqueue a single board recalculation" do
+    assert_enqueued_jobs 1, only: Board::RecalculateBytesUsedJob do
+      10.times do |i|
+        card = @board.cards.create!(title: "Card #{i}", creator: users(:david), status: :published)
+        attach_card_image(card, "x" * (i + 1))
+      end
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal (1..10).sum, @board.reload.bytes_used
+    assert_equal (1..10).sum, @account.reload.bytes_used
+  end
+
+  test "reading bytes_used schedules a calculation when one has never run" do
+    @board.update_columns(bytes_used_calculated_at: nil, bytes_used_recalculation_scheduled_at: nil)
+    attach_card_image(@card, "1234")
+    # Simulate an attachment change that bypassed callbacks.
+    @board.update_columns(bytes_used_recalculation_scheduled_at: nil)
+    clear_enqueued_jobs
+
+    assert_enqueued_jobs 1, only: Board::RecalculateBytesUsedJob do
+      assert_equal 0, @board.bytes_used
+    end
+
+    perform_enqueued_jobs
+    assert_equal 4, @board.reload.bytes_used
+  end
+
+  private
+    # Only the jobs involved in storage accounting (plus the purge
+    # jobs that remove a destroyed record attachments), ignoring
+    # unrelated jobs enqueued by creating cards and comments.
+    def perform_storage_jobs
+      jobs = [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob, ActiveStorage::PurgeJob ]
+      3.times { perform_enqueued_jobs(only: jobs) }
+    end
+
+    def make_blob(content)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new(content), filename: "embed.txt", content_type: "text/plain")
+    end
+
+    def embed_html(blob)
+      "<p>#{ActionText::Attachment.from_attachable(blob).to_html}</p>"
+    end
+
+    def attach_card_image(card, content)
+      card.image.attach(io: StringIO.new(content), filename: "image.txt", content_type: "text/plain")
+    end
+
+    def attach_embed(record, field, content)
+      blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new(content), filename: "embed.txt", content_type: "text/plain")
+      html = ActionText::Attachment.from_attachable(blob).to_html
+      record.update!(field => "<p>#{html}</p>")
+      blob
+    end
+end
