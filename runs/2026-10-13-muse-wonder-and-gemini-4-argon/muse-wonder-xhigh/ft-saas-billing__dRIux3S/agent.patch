+    session = stub(url: "https://billing.stripe.com/session/bps_1")
+    Stripe::BillingPortal::Session.stubs(:create).returns(session)
+
+    post saas.billing_portal_path(script_name: accounts(:initech).slug)
+    assert_redirected_to "https://billing.stripe.com/session/bps_1"
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
