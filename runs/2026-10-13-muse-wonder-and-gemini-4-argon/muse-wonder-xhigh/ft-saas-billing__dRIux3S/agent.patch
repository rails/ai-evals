diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..0dccf35
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,23 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  scope :active, -> { where(status: ACTIVE_STATUSES).or(where(status: nil)) }
+
+  def active?
+    status.blank? || ACTIVE_STATUSES.include?(status.to_s)
+  end
+
+  def canceled?
+    status.to_s == "canceled" || status.to_s == "cancelled"
+  end
+
+  def plan
+    Account::Plan.find(plan_key)
+  end
+
+  def normalized_plan_key
+    plan.key
+  end
+end
