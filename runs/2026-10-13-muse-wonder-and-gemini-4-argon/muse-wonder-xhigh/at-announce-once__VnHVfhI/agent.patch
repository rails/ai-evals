diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..f824e5b 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,39 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_publication_change
+    after_update_commit :announce_publication, if: :became_published_in_transaction?
+    after_rollback :forget_publication_change
   end
 
   private
+    # `saved_change_to_published?` only reflects the most recent save of
+    # this instance. Saving anything else in the same transaction -- for
+    # example, adding a leaf, which touches the book -- overwrites
+    # `saved_changes` before the commit callbacks run, losing the
+    # publication change. Remember the transition as it happens instead,
+    # and let the commit callback consume the memory. That way a
+    # transition to live is still announced (exactly once) no matter what
+    # else is saved afterwards in the same transaction, a transition
+    # away from live cancels a pending announcement, and a rolled-back
+    # transaction (which never reaches the commit callback) announces
+    # nothing.
+    def remember_publication_change
+      if saved_change_to_published?
+        @became_published_in_transaction = published?
+      end
+    end
+
+    def became_published_in_transaction?
+      !!@became_published_in_transaction
+    end
+
     def announce_publication
+      @became_published_in_transaction = false
       AnnouncePublicationJob.perform_later self
     end
+
+    def forget_publication_change
+      @became_published_in_transaction = false
+    end
 end
