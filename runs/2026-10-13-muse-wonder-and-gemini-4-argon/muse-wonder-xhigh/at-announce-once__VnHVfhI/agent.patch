diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..2c2fbd6
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "announces publication once when a leaf is added in the same transaction" do
+    book = books(:manual)
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      book.transaction do
+        book.update! published: true
+        book.press Page.new(body: ""), title: "A brand new page"
+      end
+    end
+
+    assert book.reload.published?
+  end
+
+  test "does not announce unpublication" do
+    book = books(:manual)
+    book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.update! published: false
+    end
+  end
+
+  test "does not announce a publication that is undone in the same transaction" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      book.transaction do
+        book.update! published: true
+        book.press Page.new(body: ""), title: "A brand new page"
+        book.update! published: false
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+
+  test "does not announce a publication rolled back with its transaction" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises(RuntimeError) do
+        book.transaction(requires_new: true) do
+          book.update! published: true
+          raise "boom"
+        end
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+end
