diff --git a/app/models/book/recap.rb b/app/models/book/recap.rb
index 64e5e28..7a42018 100644
--- a/app/models/book/recap.rb
+++ b/app/models/book/recap.rb
@@ -15,8 +15,15 @@ module Book::Recap
 
   private
     def write_recap
+      # This callback can fire for a stale instance of the same book:
+      # e.g. during release one instance updates the title while another
+      # instance (still holding the old working title) publishes it.
+      # Whichever callback runs last would otherwise cache its stale
+      # in-memory attributes. Always cache the persisted values instead.
+      persisted = self.class.find_by(id: id)
+
       Rails.cache.write recap_cache_key,
-        { title: title, published: published },
+        { title: persisted&.title || title, published: persisted ? persisted.published : published },
         expires_in: Rails.application.config.x.recap.expires_in
     end
 end
