diff --git a/app/models/release_marker.rb b/app/models/release_marker.rb
index eae0429..b873038 100644
--- a/app/models/release_marker.rb
+++ b/app/models/release_marker.rb
@@ -4,6 +4,14 @@ class ReleaseMarker
     new(book) if book
   end
 
+  # Build a marker that publishes the given instance, rather than a
+  # separately loaded copy of the same book. Sharing one instance avoids
+  # the stale copy overwriting the fresh title (e.g. in cached recaps)
+  # when both updates commit.
+  def self.for_book(book)
+    new(book) if book && !book.published?
+  end
+
   def initialize(book)
     @book = book
   end
