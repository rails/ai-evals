diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..307585e 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,35 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    # `saved_change_to_published?` cannot be trusted in an
+    # `after_update_commit` callback here: anything else saved in the
+    # same transaction can overwrite or clear the last saved changes
+    # before the transaction commits. Adding a page, for example,
+    # touches the book and reloads it (to lock it for positioning),
+    # which wipes out the recorded change to `published`. Remember
+    # whether the book started the transaction unpublished as soon as
+    # the change is saved, and act on that memory once it commits.
+    after_save :remember_publication_transition, if: :saved_change_to_published?
+    after_commit :announce_publication, on: %i[ create update ]
+    after_rollback :forget_publication_transition, on: %i[ create update ]
   end
 
   private
+    def remember_publication_transition
+      # Only the first change in a transaction establishes where the
+      # book started; later changes in the same transaction (publishing,
+      # unpublishing, touching, ...) must not overwrite it.
+      @published_before_transaction = saved_change_to_published.first if @published_before_transaction.nil?
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      became_published = @published_before_transaction == false && published?
+      forget_publication_transition
+
+      AnnouncePublicationJob.perform_later self if became_published
+    end
+
+    def forget_publication_transition
+      @published_before_transaction = nil
     end
 end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
index 8761ea8..e2536b9 100644
--- a/test/controllers/books/publications_controller_test.rb
+++ b/test/controllers/books/publications_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class Books::PublicationsTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     @book = books(:manual)
 
@@ -29,4 +31,40 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_redirected_to book_slug_url(@book)
     assert_equal "new-slug", @book.slug
   end
+
+  test "publishing a book with an added page announces the publication exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" }, added_pages: [ "New page" ] }
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "unpublishing a book does not announce the publication" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs do
+      patch book_publication_path(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "saving an already published book does not announce the publication again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs do
+      patch book_publication_path(@book), params: { book: { published: "1" }, added_pages: [ "Another page" ] }
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "a failed update does not publish or announce the book" do
+    assert_no_enqueued_jobs do
+      patch book_publication_path(@book), params: { book: { published: "1" }, trashed_page_ids: [ -1 ] }
+    end
+
+    assert_not @book.reload.published?
+  end
 end
