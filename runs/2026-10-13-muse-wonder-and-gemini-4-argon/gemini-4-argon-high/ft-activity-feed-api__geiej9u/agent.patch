+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,25 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from events
+  end
+
+  private
+    def events
+      if params[:filter_id].present?
+        Current.user.filters.find(params[:filter_id]).events
+      else
+        events = Current.user.accessible_events.timelineable.preloaded.reverse_chronologically
+        events = events.where(creator_id: creator_ids) if creator_ids.present?
+        events = events.where(board_id: board_ids) if board_ids.present?
+        events
+      end
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
