diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..ca0c76c
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,284 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible events newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected_ids = users(:kevin).accessible_events.timelineable.reverse_chronologically.pluck(:id)
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index as JSON event structure for card event" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    entry = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil entry
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], entry.keys
+    assert_equal event.id, entry["id"]
+    assert_equal "card_published", entry["action"]
+    assert_equal event.created_at.utc.iso8601(3), entry["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, entry["description"]
+    assert_equal({}, entry["particulars"])
+    assert_equal card_url(event.eventable), entry["url"]
+    assert_equal "Card", entry["eventable_type"]
+
+    assert_equal event.eventable.id, entry.dig("eventable", "id")
+    assert_equal event.eventable.number, entry.dig("eventable", "number")
+    assert_equal event.eventable.title, entry.dig("eventable", "title")
+    assert_equal card_url(event.eventable), entry.dig("eventable", "url")
+
+    assert_equal event.board.id, entry.dig("board", "id")
+    assert_equal event.board.name, entry.dig("board", "name")
+    assert_equal board_url(event.board), entry.dig("board", "url")
+
+    assert_equal event.creator.id, entry.dig("creator", "id")
+    assert_equal event.creator.name, entry.dig("creator", "name")
+    assert_equal user_url(event.creator), entry.dig("creator", "url")
+  end
+
+  test "index as JSON event structure for comment event" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    entry = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_not_nil entry
+
+    assert_equal "comment_created", entry["action"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, entry["description"]
+    assert_equal({}, entry["particulars"])
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), entry["url"]
+    assert_equal "Comment", entry["eventable_type"]
+
+    assert_equal comment.id, entry.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, entry.dig("eventable", "body", "plain_text")
+    assert_equal comment.body.to_s, entry.dig("eventable", "body", "html")
+    assert_equal card_comment_url(comment.card, comment), entry.dig("eventable", "url")
+  end
+
+  test "index as JSON includes timelineable events, includes card_title_changed, and omits card_collection_changed" do
+    card = cards(:logo)
+    board = boards(:writebook)
+
+    with_current_user(:kevin) do
+      card.update!(title: "Updated logo title")
+      card.postpone
+      card.auto_postpone
+      card.reopen
+    end
+
+    collection_changed_event = board.events.create!(
+      action: "card_collection_changed",
+      creator: users(:david),
+      eventable: card,
+      particulars: { particulars: { new_collection: "New Collection" } }
+    )
+    resumed_event = board.events.create!(
+      action: "card_resumed",
+      creator: users(:david),
+      eventable: card
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+    returned_actions = @response.parsed_body.pluck("action")
+
+    assert_includes returned_actions, "card_title_changed"
+    assert_includes returned_actions, "card_postponed"
+    assert_includes returned_actions, "card_auto_postponed"
+    assert_not_includes returned_ids, collection_changed_event.id
+    assert_not_includes returned_ids, resumed_event.id
+    assert_not_includes returned_actions, "card_collection_changed"
+  end
+
+  test "particulars for assignment changes" do
+    card = cards(:logo)
+    with_current_user(:kevin) { card.toggle_assignment(users(:kevin)) }
+    unassign_event = card.events.where(action: "card_unassigned").last
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assign_entry = @response.parsed_body.find { |item| item["id"] == events(:logo_assignment_jz).id }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, assign_entry["particulars"])
+
+    unassign_entry = @response.parsed_body.find { |item| item["id"] == unassign_event.id }
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, unassign_entry["particulars"])
+  end
+
+  test "particulars for board changes" do
+    card = cards(:logo)
+    with_current_user(:kevin) { card.move_to(boards(:private)) }
+    board_changed_event = card.events.where(action: "card_board_changed").last
+
+    missing_board_event = boards(:writebook).events.create!(
+      action: "card_board_changed",
+      creator: users(:kevin),
+      eventable: cards(:layout),
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    entry = @response.parsed_body.find { |item| item["id"] == board_changed_event.id }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, entry["particulars"])
+
+    missing_entry = @response.parsed_body.find { |item| item["id"] == missing_board_event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, missing_entry["particulars"])
+  end
+
+  test "particulars for title changes" do
+    card = cards(:logo)
+    old_title = card.title
+    with_current_user(:kevin) { card.update!(title: "Brand new title") }
+    title_changed_event = card.events.where(action: "card_title_changed").last
+
+    missing_title_event = boards(:writebook).events.create!(
+      action: "card_title_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    entry = @response.parsed_body.find { |item| item["id"] == title_changed_event.id }
+    assert_equal({ "old_title" => old_title, "new_title" => "Brand new title" }, entry["particulars"])
+
+    missing_entry = @response.parsed_body.find { |item| item["id"] == missing_title_event.id }
+    assert_equal({ "old_title" => "", "new_title" => "" }, missing_entry["particulars"])
+  end
+
+  test "particulars for triage events" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+    with_current_user(:kevin) { card.triage_into(column) }
+    triaged_event = card.events.where(action: "card_triaged").last
+
+    missing_column_event = boards(:writebook).events.create!(
+      action: "card_triaged",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    entry = @response.parsed_body.find { |item| item["id"] == triaged_event.id }
+    assert_equal({ "column" => column.name }, entry["particulars"])
+
+    missing_entry = @response.parsed_body.find { |item| item["id"] == missing_column_event.id }
+    assert_equal({ "column" => "" }, missing_entry["particulars"])
+
+    sent_back_entry = @response.parsed_body.find { |item| item["id"] == events(:buy_domain_sent_back_to_triage).id }
+    assert_equal({}, sent_back_entry["particulars"])
+  end
+
+  test "filters by creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+
+    assert_not_empty @response.parsed_body
+    @response.parsed_body.each do |event|
+      assert_equal users(:kevin).id, event.dig("creator", "id")
+    end
+  end
+
+  test "filters by board_ids" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret card", creator: users(:kevin), status: "published")
+    end
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "filters by both creator_ids and board_ids" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret card", creator: users(:kevin), status: "published")
+    end
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_empty @response.parsed_body
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ private_card.events.find_by!(action: "card_published").id ], @response.parsed_body.pluck("id")
+  end
+
+  test "only returns activity the current user can access" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret card", creator: users(:kevin), status: "published")
+    end
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "paginates results" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    20.times do |i|
+      board.events.create!(
+        action: "card_reopened",
+        creator: users(:kevin),
+        eventable: card,
+        created_at: Time.current + i.seconds
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.timelineable.reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
