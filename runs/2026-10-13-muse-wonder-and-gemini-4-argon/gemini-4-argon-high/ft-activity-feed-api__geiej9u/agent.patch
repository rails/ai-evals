diff --git a/app/views/events/_event.json.jbuilder b/app/views/events/_event.json.jbuilder
new file mode 100644
index 0000000..88e76ca
--- /dev/null
+++ b/app/views/events/_event.json.jbuilder
@@ -0,0 +1,33 @@
+json.cache! [ event, Current.user, event.creator, event.board, event.eventable, event.card ] do
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+
+  json.particulars(
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(event.assignee_ids || event.particulars&.dig("particulars", "assignee_ids")) }
+    when "card_board_changed"
+      { old_board: event.old_board, new_board: event.new_board }
+    when "card_title_changed"
+      { old_title: event.old_title, new_title: event.new_title }
+    when "card_triaged"
+      { column: event.column }
+    else
+      {}
+    end
+  )
+
+  json.url polymorphic_url(event)
+  json.eventable_type event.eventable_type
+
+  json.eventable do
+    case event.eventable
+    when Card then json.partial! "cards/card", card: event.eventable
+    when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
