diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d279474
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,227 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  dragStart(event) {
+    this.draggedItem = event.target.closest("[data-drag-and-drop-target~='item']") || event.currentTarget
+    if (!this.draggedItem) return
+
+    this.sourceContainer = this.draggedItem.closest("[data-drag-and-drop-target~='container']")
+    this.draggedItem.removeAttribute("aria-selected")
+    this.draggedItem.classList.add(this.#draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", this.draggedItem.dataset.id || this.draggedItem.id)
+    }
+  }
+
+  dragOver(event) {
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlightContainer(event.currentTarget)
+  }
+
+  dragEnter(event) {
+    event.preventDefault()
+    this.#highlightContainer(event.currentTarget)
+  }
+
+  dragLeave(event) {
+    const container = event.currentTarget
+    if (event.relatedTarget && container.contains(event.relatedTarget)) return
+
+    container.classList.remove(this.#hoverContainerClass)
+  }
+
+  async drop(event) {
+    event.preventDefault()
+
+    const targetContainer = event.currentTarget
+    const draggedItem = this.draggedItem || this.#findItemFromDataTransfer(event.dataTransfer)
+    const sourceContainer = this.sourceContainer || draggedItem?.closest("[data-drag-and-drop-target~='container']")
+
+    this.#cleanup()
+
+    if (!draggedItem || !targetContainer || sourceContainer === targetContainer) return
+
+    this.#moveItem(draggedItem, sourceContainer, targetContainer)
+    await this.#saveDrop(draggedItem, targetContainer)
+  }
+
+  dragEnd(event) {
+    const item = event?.currentTarget || this.draggedItem
+    this.#suppressNextClick(item)
+    this.#cleanup()
+  }
+
+  // Private
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  #findItemFromDataTransfer(dataTransfer) {
+    const id = dataTransfer?.getData("text/plain")
+    if (!id) return null
+
+    return this.itemTargets.find(item => item.dataset.id === id || item.id === id)
+  }
+
+  #highlightContainer(container) {
+    this.containerTargets.forEach(target => {
+      target.classList.toggle(this.#hoverContainerClass, target === container)
+    })
+  }
+
+  #clearHoverClasses() {
+    this.containerTargets.forEach(container => {
+      container.classList.remove(this.#hoverContainerClass)
+    })
+  }
+
+  #cleanup() {
+    this.draggedItem?.classList.remove(this.#draggedItemClass)
+    this.#clearHoverClasses()
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    const targetFrame = targetContainer.querySelector("turbo-frame[src]")
+    const wasLoading = targetFrame && (targetFrame.hasAttribute("busy") || !targetFrame.complete)
+
+    this.#insertItemInto(item, targetContainer)
+    this.#updateItemAppearance(item, targetContainer)
+    this.#updateContainerCount(sourceContainer, -1)
+    this.#updateContainerCount(targetContainer, 1)
+
+    if (wasLoading && targetFrame.loaded) {
+      targetFrame.loaded.then(() => {
+        if (!targetContainer.contains(item)) {
+          this.#insertItemInto(item, targetContainer)
+        }
+      })
+    }
+  }
+
+  #insertItemInto(item, container) {
+    let list = container.querySelector(".cards__list")
+    if (!list) {
+      const frame = container.querySelector("turbo-frame") || container.querySelector(".cards__transition-container") || container
+      list = document.createElement("div")
+      list.className = "cards__list hide-scrollbar"
+      frame.appendChild(list)
+    }
+
+    const isGolden = item.classList.contains("golden-effect")
+    const goldenFirst = container.matches(".cards--maybe, .cards--doing")
+
+    if (!isGolden && goldenFirst) {
+      const goldenCards = list.querySelectorAll(".card.golden-effect")
+      if (goldenCards.length > 0) {
+        goldenCards[goldenCards.length - 1].after(item)
+        return
+      }
+    }
+
+    const firstCard = list.querySelector(".card")
+    if (firstCard) {
+      firstCard.before(item)
+    } else {
+      const target = list.querySelector("turbo-frame") || list
+      target.prepend(item)
+    }
+  }
+
+  #updateItemAppearance(item, targetContainer) {
+    if (targetContainer.dataset.cardColor) {
+      item.style.setProperty("--card-color", targetContainer.dataset.cardColor)
+    }
+
+    const isNotNow = targetContainer.classList.contains("cards--on-deck")
+    const isClosed = targetContainer.classList.contains("cards--closed")
+
+    item.classList.toggle("card--postponed", isNotNow)
+    item.classList.toggle("card--active", !isNotNow && !isClosed)
+    item.querySelector(".card__closed")?.remove()
+
+    const assignees = item.querySelector('[id^="assignees_card_"]')
+    if (assignees) {
+      assignees.hidden = isClosed
+    }
+
+    const bubble = item.querySelector(".bubble")
+    if (bubble) {
+      bubble.hidden = true
+    }
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      updatedTime.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+    }
+  }
+
+  #updateContainerCount(container, delta) {
+    if (!container) return
+
+    const countElement = container.querySelector(".cards__expander-count")
+    if (countElement) {
+      const currentCount = parseInt(countElement.textContent, 10)
+      if (!isNaN(currentCount) && countElement.textContent.trim() !== "99+") {
+        const newCount = Math.max(0, currentCount + delta)
+        countElement.textContent = newCount > 99 ? "99+" : newCount
+      }
+    }
+
+    const counterButton = container.querySelector("[data-css-variable-counter-target~='counter']")
+    if (counterButton) {
+      const itemsCount = container.querySelectorAll("[data-css-variable-counter-target~='item']").length
+      counterButton.style.setProperty("--card-count", Math.min(itemsCount, 15))
+    }
+  }
+
+  async #saveDrop(item, targetContainer) {
+    const urlTemplate = targetContainer.dataset.dragAndDropUrl
+    const itemId = item.dataset.id
+    if (!urlTemplate || !itemId) return
+
+    const url = urlTemplate.replace("__id__", itemId)
+    const method = targetContainer.dataset.dragAndDropMethod || "post"
+
+    const request = new FetchRequest(method, url, { responseKind: "json" })
+    await request.perform()
+  }
+
+  #suppressNextClick(element) {
+    if (!element) return
+
+    const clickHandler = event => {
+      event.preventDefault()
+      event.stopImmediatePropagation()
+    }
+
+    const mousedownHandler = () => {
+      element.removeEventListener("click", clickHandler, { capture: true })
+    }
+
+    element.addEventListener("click", clickHandler, { capture: true, once: true })
+    element.addEventListener("mousedown", mousedownHandler, { capture: true, once: true })
+    setTimeout(() => {
+      element.removeEventListener("click", clickHandler, { capture: true })
+      element.removeEventListener("mousedown", mousedownHandler, { capture: true })
+    }, 300)
+  }
+}
