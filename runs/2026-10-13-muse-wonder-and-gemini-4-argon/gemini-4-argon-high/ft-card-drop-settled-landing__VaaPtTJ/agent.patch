diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..a621876
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,198 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "dragging a card between columns and statuses" do
+    board = boards(:writebook)
+    card = cards(:buy_domain)
+    in_progress = columns(:writebook_in_progress)
+
+    visit board_url(board)
+
+    within("#maybe") do
+      assert_selector "##{dom_id(card, :article)}"
+    end
+
+    # Drag from Maybe? to In progress
+    find("##{dom_id(card, :article)}").drag_to(find("##{dom_id(in_progress)}"))
+
+    within("##{dom_id(in_progress)}") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+    within("#maybe") do
+      assert_no_selector "##{dom_id(card, :article)}", visible: :all
+    end
+    assert_wait_for_save { card.reload.column == in_progress }
+
+    # Expand In progress to drag the card to Not Now
+    find("##{dom_id(in_progress)} .cards__expander").click
+    find("##{dom_id(card, :article)}").drag_to(find("#not-now"))
+
+    within("#not-now") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+    assert_wait_for_save { card.reload.postponed? }
+
+    # Expand Not Now to drag the card to Done
+    find("#not-now .cards__expander").click
+    find("##{dom_id(card, :article)}").drag_to(find("#closed-cards"))
+
+    within("#closed-cards") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+    assert_wait_for_save { card.reload.closed? }
+
+    # Expand Done to drag the card back to Maybe?
+    find("#closed-cards .cards__expander").click
+    find("##{dom_id(card, :article)}").drag_to(find("#maybe"))
+
+    within("#maybe") do
+      assert_selector "##{dom_id(card, :article)}"
+    end
+    assert_wait_for_save { card.reload.awaiting_triage? }
+  end
+
+  test "styles are applied while dragging and hovering" do
+    board = boards(:writebook)
+    card = cards(:buy_domain)
+    in_progress = columns(:writebook_in_progress)
+    on_hold = columns(:writebook_on_hold)
+
+    visit board_url(board)
+
+    card_id = dom_id(card, :article)
+    column_id = dom_id(in_progress)
+    other_column_id = dom_id(on_hold)
+
+    page.execute_script(<<~JS)
+      const card = document.getElementById("#{card_id}")
+      const dt = new DataTransfer()
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: dt }))
+    JS
+
+    assert_selector "##{card_id}.drag-and-drop__dragged-item"
+
+    page.execute_script(<<~JS)
+      const column = document.getElementById("#{column_id}")
+      const dt = new DataTransfer()
+      column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: dt }))
+    JS
+
+    assert_selector "##{column_id}.drag-and-drop__hover-container"
+
+    # Moving to another column switches the hover class
+    page.execute_script(<<~JS)
+      const otherColumn = document.getElementById("#{other_column_id}")
+      const dt = new DataTransfer()
+      otherColumn.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: dt }))
+    JS
+
+    assert_no_selector "##{column_id}.drag-and-drop__hover-container"
+    assert_selector "##{other_column_id}.drag-and-drop__hover-container"
+
+    page.execute_script(<<~JS)
+      const otherColumn = document.getElementById("#{other_column_id}")
+      otherColumn.dispatchEvent(new DragEvent("dragleave", { bubbles: true, cancelable: true }))
+    JS
+
+    assert_no_selector "##{other_column_id}.drag-and-drop__hover-container"
+
+    page.execute_script(<<~JS)
+      const card = document.getElementById("#{card_id}")
+      card.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true }))
+    JS
+
+    assert_no_selector "##{card_id}.drag-and-drop__dragged-item"
+  end
+
+  test "columns keep their own order when dropping a card" do
+    board = boards(:writebook)
+    card = cards(:buy_domain)
+    triage_column = columns(:writebook_triage)
+    golden_card = cards(:logo)
+    normal_card = cards(:layout)
+
+    visit board_url(board)
+
+    # Expand Triage column which has golden_card (:logo) and normal_card (:layout)
+    find("##{dom_id(triage_column)} .cards__expander").click
+
+    within("##{dom_id(triage_column)}") do
+      assert_selector ".card", count: 2
+    end
+
+    # Drag buy_domain (non-golden) into Triage column
+    find("##{dom_id(card, :article)}").drag_to(find("##{dom_id(triage_column)}"))
+
+    within("##{dom_id(triage_column)}") do
+      card_ids = all(".card").map { |el| el[:id] }
+      assert_equal [ dom_id(golden_card, :article), dom_id(card, :article), dom_id(normal_card, :article) ], card_ids
+    end
+
+    # Dropping within the same column does not reorder
+    find("##{dom_id(normal_card, :article)}").drag_to(find("##{dom_id(triage_column)}"))
+
+    within("##{dom_id(triage_column)}") do
+      card_ids = all(".card").map { |el| el[:id] }
+      assert_equal [ dom_id(golden_card, :article), dom_id(card, :article), dom_id(normal_card, :article) ], card_ids
+    end
+  end
+
+  test "drop updates the board instantly without waiting on save" do
+    board = boards(:writebook)
+    card = cards(:buy_domain)
+    on_hold = columns(:writebook_on_hold)
+
+    visit board_url(board)
+
+    find("##{dom_id(on_hold)} .cards__expander").click
+
+    within("##{dom_id(on_hold)}") do
+      assert_selector ".blank-slate--drag", text: "Drag cards here"
+    end
+
+    card_id = dom_id(card, :article)
+    column_id = dom_id(on_hold)
+
+    # Block fetch so the save never resolves yet, and dispatch dragstart + drop
+    moved_instantly = page.evaluate_script(<<~JS)
+      (() => {
+        window.originalFetch = window.fetch
+        window.fetchCalled = false
+        window.fetch = () => {
+          window.fetchCalled = true
+          return new Promise(() => {})
+        }
+
+        const card = document.getElementById("#{card_id}")
+        const column = document.getElementById("#{column_id}")
+        const dt = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: dt }))
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: dt }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: dt }))
+
+        return column.contains(card) && window.fetchCalled
+      })()
+    JS
+
+    assert moved_instantly
+    within("##{column_id}") do
+      assert_selector "##{card_id}"
+      assert_no_selector ".blank-slate--drag"
+    end
+  end
+
+  private
+    def assert_wait_for_save
+      Timeout.timeout(5) do
+        sleep 0.05 until yield
+      end
+      assert yield
+    end
+end
