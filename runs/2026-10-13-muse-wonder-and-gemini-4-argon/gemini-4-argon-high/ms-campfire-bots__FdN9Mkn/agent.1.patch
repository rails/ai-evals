+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:jz)
+  end
+
+  test "create_bot! creates an active bot with a bot_key and creator" do
+    bot = User.create_bot!(name: "Deploy Bot")
+
+    assert bot.bot?
+    assert bot.active?
+    assert_equal users(:jz), bot.creator
+    assert_predicate bot.bot_token, :present?
+    assert_equal "#{bot.id}-#{bot.bot_token}", bot.bot_key
+  end
+
+  test "creating a bot grants membership to all open rooms" do
+    assert_difference -> { Membership.count }, +Rooms::Open.count do
+      bot = User.create_bot!(name: "Deploy Bot")
+      assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+    end
+  end
+
+  test "authenticate_bot returns active bot for valid bot_key" do
+    bot = User.create_bot!(name: "Deploy Bot")
+
+    assert_equal bot, User.authenticate_bot(bot.bot_key)
+    assert_nil User.authenticate_bot("#{bot.id}-wrongtoken")
+    assert_nil User.authenticate_bot("999999-#{bot.bot_token}")
+    assert_nil User.authenticate_bot("invalid")
+    assert_nil User.authenticate_bot("")
+    assert_nil User.authenticate_bot(nil)
+  end
+
+  test "deactivating a bot prevents authentication and removes room memberships" do
+    bot = User.create_bot!(name: "Deploy Bot")
+    bot_key = bot.bot_key
+
+    bot.deactivate
+
+    assert bot.reload.deactivated?
+    assert_nil bot.bot_token
+    assert_empty bot.memberships
+    assert_nil User.authenticate_bot(bot_key)
+  end
+
+  test "scopes bots and without_bots" do
+    bot = User.create_bot!(name: "Deploy Bot")
+
+    assert_includes User.bots, bot
+    assert_not_includes User.without_bots, bot
+    assert_includes User.without_bots, users(:david)
+    assert_not_includes User.bots, users(:david)
+  end
+end
