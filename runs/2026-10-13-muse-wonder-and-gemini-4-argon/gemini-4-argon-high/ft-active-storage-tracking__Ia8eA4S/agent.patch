diff --git a/test/models/storage_test.rb b/test/models/storage_test.rb
new file mode 100644
index 0000000..e6d3445
--- /dev/null
+++ b/test/models/storage_test.rb
@@ -0,0 +1,418 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "initial bytes_used is zero" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "attaching, replacing, and removing card image" do
+    blob1 = create_blob(size: 1024, filename: "image1.png")
+    blob2 = create_blob(size: 2048, filename: "image2.png")
+
+    board_change = capture_change -> { @board.bytes_used } do
+      account_change = capture_change -> { @account.bytes_used } do
+        @card.image.attach(blob1)
+      end
+      assert_equal 1024, account_change
+    end
+    assert_equal 1024, board_change
+
+    perform_enqueued_jobs
+    assert_equal 1024, @board.bytes_used
+    assert_equal 1024, @account.bytes_used
+    assert_equal 0, @board.storage_total.pending_bytes
+    assert_equal 0, @account.storage_total.pending_bytes
+
+    # Replace with larger image inside perform_enqueued_jobs block
+    perform_enqueued_jobs do
+      @card.image.attach(blob2)
+    end
+    assert_equal 2048, @board.bytes_used
+    assert_equal 2048, @account.bytes_used
+
