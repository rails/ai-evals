--- /dev/null
+++ b/app/models/card/storage.rb
@@ -0,0 +1,42 @@
+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :transfer_storage_to_new_board, if: :board_id_changed?
+  end
+
+  def storage_bytes
+    rich_text_ids = ActionText::RichText
+      .where(record_type: "Card", record_id: id, name: "description")
+      .or(ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id), name: "body"))
+      .select(:id)
+
+    ActiveStorage::Attachment
+      .where(record_type: "Card", record_id: id, name: "image")
+      .or(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds"))
+      .joins(:blob)
+      .sum("active_storage_blobs.byte_size")
+  end
+
+  private
+    def transfer_storage_to_new_board
+      bytes = storage_bytes
+      if bytes > 0
+        old_board = Board.find_by(id: board_id_was)
+        Storage::Entry.record(
+          account_id: old_board&.account_id || account_id_was || account_id,
+          board_id: board_id_was,
+          record: self,
+          delta: -bytes,
+          operation: "transfer_out"
+        )
+        Storage::Entry.record(
+          account_id: board&.account_id || account_id,
+          board_id: board_id,
+          record: self,
+          delta: bytes,
+          operation: "transfer_in"
+        )
+      end
+    end
+end
