+      @card.comments.create!(body: "<p>#{embed_html(comment_blob)}</p>")
+      @other_board.update!(public_description: "<p>#{embed_html(other_board_blob)}</p>")
+    end
+
+    assert_equal 600, @board.bytes_used
+    assert_equal 50, @other_board.bytes_used
+    assert_equal 650, @account.bytes_used
+
+    perform_enqueued_jobs do
