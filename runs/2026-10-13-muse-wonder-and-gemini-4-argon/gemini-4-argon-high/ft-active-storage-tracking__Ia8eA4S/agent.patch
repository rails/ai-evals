+    assert_equal 650, @other_board.bytes_used
+    assert_equal 650, @account.bytes_used
+
+    # Destroying the moved card on the new board subtracts from the new board
+    perform_enqueued_jobs do
+      @card.destroy!
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 50, @other_board.bytes_used
+    assert_equal 50, @account.bytes_used
