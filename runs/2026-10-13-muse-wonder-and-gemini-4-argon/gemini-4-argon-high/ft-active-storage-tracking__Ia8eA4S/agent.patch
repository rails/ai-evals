diff --git a/app/models/storage/attachment.rb b/app/models/storage/attachment.rb
new file mode 100644
index 0000000..32cbecc
--- /dev/null
+++ b/app/models/storage/attachment.rb
@@ -0,0 +1,59 @@
+module Storage::Attachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :track_storage_addition, if: :storage_tracked?
+    after_destroy :track_storage_removal, if: :storage_tracked?
+  end
+
+  def delete
+    track_storage_removal if persisted? && storage_tracked?
+    super
+  end
+
+  private
+    def track_storage_addition
+      if bytes = blob&.byte_size
+        record_storage_delta(bytes, "attach")
+      end
+    end
+
+    def track_storage_removal
+      if bytes = blob&.byte_size
+        record_storage_delta(-bytes, "detach")
+      end
+    end
+
+    def record_storage_delta(delta, operation)
+      Storage::Entry.record(
+        account_id: account_id || record&.account_id,
+        board_id: storage_board_id,
+        record: storage_record,
+        blob_id: blob_id,
+        delta: delta,
+        operation: operation
+      )
+    end
+
+    def storage_tracked?
+      storage_board_id.present?
+    end
+
+    def storage_board_id
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        record&.board_id
+      when [ "ActionText::RichText", "embeds" ]
+        record&.board_id
+      end
+    end
+
+    def storage_record
+      case record_type
+      when "Card"
+        record
+      when "ActionText::RichText"
+        record&.record
+      end
+    end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..1ef72a3
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,45 @@
+class Storage::Entry < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :board, optional: true
+  belongs_to :record, polymorphic: true, optional: true
+  belongs_to :blob, class_name: "ActiveStorage::Blob", optional: true
+  belongs_to :user, optional: true, default: -> { Current.user }
+
+  before_create { self.request_id ||= Current.request_id }
+  after_create_commit :materialize_later
+
+  scope :pending, ->(after_entry_id = nil) do
+    if after_entry_id.present?
+      where(arel_table[:id].gt(after_entry_id))
+    else
+      all
+    end
+  end
+
+  class << self
+    def record(delta:, operation:, account_id:, board_id: nil, record: nil, blob_id: nil)
+      return if delta.zero? || account_id.blank?
+
+      create!(
+        account_id: account_id,
+        board_id: board_id,
+        record_type: record&.class&.polymorphic_name,
+        record_id: record&.id,
+        blob_id: blob_id,
+        delta: delta,
+        operation: operation
+      )
+    end
+  end
+
+  private
+    def materialize_later
+      if board_id.present? && id == Storage::Entry.where(board_id: board_id).order(id: :desc).pick(:id)
+        board&.materialize_storage_later
+      end
+
+      if account_id.present? && id == Storage::Entry.where(account_id: account_id).order(id: :desc).pick(:id)
+        account&.materialize_storage_later
+      end
+    end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..95a0f12
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,25 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :owner, polymorphic: true
+
+  def materialize
+    with_lock do
+      if latest_entry_id = pending_entries.order(id: :desc).pick(:id)
+        delta = pending_entries.where(id: ..latest_entry_id).sum(:delta)
+        update!(bytes_stored: [ bytes_stored + delta, 0 ].max, last_entry_id: latest_entry_id)
+      end
+    end
+  end
+
+  def bytes_used
+    [ bytes_stored + pending_bytes, 0 ].max
+  end
+
+  def pending_bytes
+    pending_entries.sum(:delta)
+  end
+
+  private
+    def pending_entries
+      owner.storage_entries.pending(last_entry_id)
+    end
+end
diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
new file mode 100644
index 0000000..4a071f8
--- /dev/null
+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,71 @@
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, class_name: "Storage::Total", as: :owner, dependent: :destroy
+    has_many :storage_entries, class_name: "Storage::Entry"
+  end
+
+  def bytes_used
+    if total = Storage::Total.find_by(owner: self)
+      total.bytes_used
+    else
+      [ storage_entries.sum(:delta), 0 ].max
+    end
+  end
+
+  def materialize_storage_later
+    if pending_storage_entries?
+      Current.with_account(account) do
+        Storage::MaterializeJob.perform_later(self)
+      end
+    end
+  end
+
+  def materialize_storage
+    find_or_create_storage_total.materialize
+  end
+
+  def reconcile_storage
+    total = find_or_create_storage_total
+    total.with_lock do
+      latest_entry_id = storage_entries.order(id: :desc).pick(:id)
+      real_bytes = calculate_real_storage_bytes
+      if total.bytes_stored != real_bytes || total.last_entry_id != latest_entry_id
+        total.update!(bytes_stored: real_bytes, last_entry_id: latest_entry_id)
+      end
+    end
+  end
+
+  private
+    def pending_storage_entries?
+      last_entry_id = Storage::Total.where(owner: self).pick(:last_entry_id)
+      storage_entries.pending(last_entry_id).exists?
+    end
+
+    def find_or_create_storage_total
+      Storage::Total.find_by(owner: self) || Storage::Total.transaction(requires_new: true) do
+        Storage::Total.create!(owner: self)
+      end
+    rescue ActiveRecord::RecordNotUnique
+      Storage::Total.find_by!(owner: self)
+    end
+
+    def calculate_real_storage_bytes
+      board_ids = is_a?(Board) ? id : boards.select(:id)
+      card_ids = cards.select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Board", record_id: board_ids, name: "public_description")
+        .or(ActionText::RichText.where(record_type: "Card", record_id: card_ids, name: "description"))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids, name: "body"))
+        .select(:id)
+
+      ActiveStorage::Attachment
+        .where(record_type: "Card", record_id: card_ids, name: "image")
+        .or(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds"))
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
