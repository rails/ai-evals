+  test "concurrent materialization does not duplicate or lose storage totals" do
+    blobs = Array.new(5) { |i| create_blob(size: (i + 1) * 100, filename: "f#{i}.bin") }
+    cards = @board.cards.limit(5).to_a
+
+    cards.zip(blobs).each do |card, blob|
+      card.image.attach(blob)
+    end
+
+    5.times.map do
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          Board.find(@board.id).materialize_storage
+          Account.find(@account.id).materialize_storage
+        end
+      end
+    end.each(&:join)
+
+    assert_equal 1500, @board.bytes_used
+    assert_equal 1500, @account.bytes_used
+    assert_equal 1500, @board.storage_total.reload.bytes_stored
+    assert_equal 1500, @account.storage_total.reload.bytes_stored
+    assert_equal 1, Storage::Total.where(owner: @board).count
+    assert_equal 1, Storage::Total.where(owner: @account).count
+  end
