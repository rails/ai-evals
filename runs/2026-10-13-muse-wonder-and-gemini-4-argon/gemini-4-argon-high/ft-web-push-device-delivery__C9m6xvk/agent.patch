new file mode 100644
index 0000000..d7026be
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,20 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  def notification(**params)
+    WebPush::Notification.new(**params, endpoint: endpoint, p256dh_key: p256dh_key, auth_key: auth_key)
+  end
+
+  def push(notification)
+    self.notification(
+      title: notification.title,
+      body: notification.body,
+      path: notification.path
+    ).deliver
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription, WebPush::Unauthorized, OpenSSL::OpenSSLError
+    destroy
+  end
+end
