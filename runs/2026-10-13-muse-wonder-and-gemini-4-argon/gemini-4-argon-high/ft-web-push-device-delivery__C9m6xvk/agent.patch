@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    client_curve = OpenSSL::PKey::EC.generate("prime256v1")
+    @p256dh_key = WebPush.encode64(client_curve.public_key.to_bn.to_s(2)).delete("=")
+    @auth_key = WebPush.encode64(Random.urandom(16)).delete("=")
+    @endpoint = "https://fcm.googleapis.com/fcm/send/test-subscription-123"
+  end
+
+  test "validates presence of endpoint, p256dh_key, and auth_key" do
+    subscription = @user.push_subscriptions.new
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "defaults account to user account" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+
+    assert_equal @user.account, subscription.account
+  end
+
+  test "delivers web push notification with VAPID keys" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+    notification = notifications(:logo_mentioned_david)
+
+    stub = stub_request(:post, @endpoint).to_return(status: 201)
+
+    subscription.push(notification)
+
+    assert_requested stub
+  end
+
+  test "destroys subscription when push service returns 410 Gone" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+    notification = notifications(:logo_mentioned_david)
+
+    stub_request(:post, @endpoint).to_return(status: 410)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.push(notification)
+    end
+  end
+
+  test "destroys subscription when push service returns 404 Not Found" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: @p256dh_key,
+      auth_key: @auth_key
+    )
+    notification = notifications(:logo_mentioned_david)
+
+    stub_request(:post, @endpoint).to_return(status: 404)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.push(notification)
+    end
+  end
+end
