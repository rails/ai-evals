diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..06302ac
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,141 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static values = { subscriptionsUrl: String }
+  static targets = [ "bell", "details", "notAllowedNotice" ]
+  static classes = [ "enabled" ]
+
+  async connect() {
+    if (this.#isPushNotificationSupported) {
+      switch (window.Notification.permission) {
+        case "default":
+          this.#revealBell()
+          break
+        case "granted":
+          await this.#setUpPushSubscription()
+          this.#enable()
+          break
+        case "denied":
+          this.#revealNotAllowedNotice()
+          this.#revealBell()
+          break
+      }
+    } else {
+      this.#revealNotAllowedNotice()
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (this.#isPushNotificationSupported) {
+      const permission = window.Notification.permission === "granted"
+        ? "granted"
+        : await Notification.requestPermission()
+
+      if (permission === "granted") {
+        await this.#setUpPushSubscription()
+        this.#enable()
+      } else {
+        this.#revealNotAllowedNotice()
+        this.#openDetails()
+      }
+    }
+  }
+
+  get #isPushNotificationSupported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async #setUpPushSubscription() {
+    const registration = await this.#serviceWorkerRegistration || await this.#registerServiceWorker()
+    await this.#subscribe(registration)
+  }
+
+  get #serviceWorkerRegistration() {
+    return navigator.serviceWorker.getRegistration()
+  }
+
+  #registerServiceWorker() {
+    return navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+  }
+
+  async #subscribe(registration) {
+    await navigator.serviceWorker.ready
+
+    const subscription = await registration.pushManager.getSubscription() || await this.#createPushSubscription(registration)
+
+    if (subscription) {
+      await this.#syncPushSubscription(subscription)
+    }
+  }
+
+  async #createPushSubscription(registration) {
+    if (!this.#vapidPublicKey) return null
+
+    try {
+      return await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#vapidPublicKey })
+    } catch (error) {
+      console.error("Failed to subscribe to push notifications:", error)
+      return null
+    }
+  }
+
+  async #syncPushSubscription(subscription) {
+    const response = await post(this.subscriptionsUrlValue, {
+      body: this.#extractJsonPayloadAsString(subscription),
+      contentType: "application/json"
+    })
+    if (!response.ok) {
+      await subscription.unsubscribe()
+    }
+  }
+
+  #extractJsonPayloadAsString(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON ? subscription.toJSON() : subscription
+    return JSON.stringify({ push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } })
+  }
+
+  #enable() {
+    this.bellTarget.hidden = true
+    if (this.hasNotAllowedNoticeTarget) {
+      this.notAllowedNoticeTarget.hidden = true
+    }
+    this.element.classList.add(this.hasEnabledClass ? this.enabledClass : "notifications--on")
+  }
+
+  #revealBell() {
+    this.bellTarget.hidden = false
+  }
+
+  #revealNotAllowedNotice() {
+    this.notAllowedNoticeTarget.hidden = false
+  }
+
+  #openDetails() {
+    if (this.hasDetailsTarget) {
+      this.detailsTargets.forEach(detail => detail.setAttribute("open", ""))
+    }
+  }
+
+  get #vapidPublicKey() {
+    const encodedVapidPublicKey = getMetaContent("vapid-public-key")
+    if (encodedVapidPublicKey) {
+      return this.#urlBase64ToUint8Array(encodedVapidPublicKey)
+    }
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
