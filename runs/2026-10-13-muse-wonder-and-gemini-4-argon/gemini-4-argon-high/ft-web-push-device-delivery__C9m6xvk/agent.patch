+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,61 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  test "enabling push notifications shows help when browser blocks notifications" do
+    sign_in_as(users(:david))
+
+    visit notifications_settings_url
+
+    assert_text "Push Notifications"
+    assert_text "Notifications are off for this device."
+    assert_button "Turn on notifications"
+
+    click_on "Turn on notifications"
+
+    assert_text "Turn on notifications for this website."
+  end
+
+  test "enabling push notifications subscribes and posts subscription to server" do
+    user = users(:david)
+    sign_in_as(user)
+
+    visit notifications_settings_url
+    assert_button "Turn on notifications"
+
+    page.execute_script(<<~JS)
+      Object.defineProperty(window.Notification, "permission", {
+        get: () => "default",
+        configurable: true
+      })
+      window.Notification.requestPermission = async () => "granted"
+      const mockRegistration = {
+        pushManager: {
+          getSubscription: async () => null,
+          subscribe: async () => ({
+            toJSON: () => ({
+              endpoint: "https://fcm.googleapis.com/fcm/send/system-test-sub",
+              keys: { p256dh: "system-test-p256dh", auth: "system-test-auth" }
+            })
+          })
+        }
+      }
+      navigator.serviceWorker.getRegistration = async () => mockRegistration
+      Object.defineProperty(navigator.serviceWorker, "ready", {
+        get: () => Promise.resolve(mockRegistration),
+        configurable: true
+      })
+    JS
+
+    assert_difference -> { user.push_subscriptions.count }, 1 do
+      click_on "Turn on notifications"
+      assert_text "Notifications are on for this device."
+    end
+
+    assert_no_button "Turn on notifications"
+
+    subscription = user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/system-test-sub", subscription.endpoint
+    assert_equal "system-test-p256dh", subscription.p256dh_key
+    assert_equal "system-test-auth", subscription.auth_key
+  end
+end
