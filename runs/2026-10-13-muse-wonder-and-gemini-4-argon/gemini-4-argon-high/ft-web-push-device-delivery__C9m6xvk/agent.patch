+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create new push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/123",
+          p256dh_key: "test-p256dh-key",
+          auth_key: "test-auth-key"
+        }
+      }, headers: { "HTTP_USER_AGENT" => "Mozilla/5.0 Test Browser" }, as: :json
+    end
+
+    assert_response :ok
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/123", subscription.endpoint
+    assert_equal "test-p256dh-key", subscription.p256dh_key
+    assert_equal "test-auth-key", subscription.auth_key
+    assert_equal "Mozilla/5.0 Test Browser", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create touches existing subscription instead of duplicating" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/123",
+      p256dh_key: "test-p256dh-key",
+      auth_key: "test-auth-key",
+      updated_at: 1.day.ago
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/123",
+          p256dh_key: "test-p256dh-key",
+          auth_key: "test-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :ok
+    assert_operator subscription.reload.updated_at, :>, 1.hour.ago
+  end
+
+  test "create is forbidden for other users" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/123",
+          p256dh_key: "test-p256dh-key",
+          auth_key: "test-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy push subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/fcm/send/123",
+      p256dh_key: "test-p256dh-key",
+      auth_key: "test-auth-key"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_redirected_to notifications_settings_url
+  end
+end
