diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..0554a71
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,44 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+  before_action :set_push_subscriptions
+
+  def create
+    if subscription = @push_subscriptions.find_by(endpoint: push_subscription_params[:endpoint])
+      subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+      subscription.touch
+    else
+      @push_subscriptions.create!(push_subscription_params.merge(user_agent: request.user_agent))
+    end
+
+    head :ok
+  end
+
+  def destroy
+    @push_subscriptions.destroy_by(id: params[:id])
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_url }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def set_push_subscriptions
+      @push_subscriptions = @user.push_subscriptions
+    end
+
+    def push_subscription_params
+      params.require(:push_subscription).permit(:endpoint, :p256dh_key, :auth_key)
+    end
+end
