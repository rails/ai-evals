@@ -0,0 +1,40 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthorized_access
+  before_action :enforce_tenant_limit, only: %i[ new create ]
+  before_action :set_import, only: :show
+
+  layout "public"
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    if file_param.present?
+      @import = Account::Import.create!(identity: Current.identity, file: file_param)
+      @import.process_later
+
+      redirect_to account_import_path(@import, script_name: @import.account.slug)
+    else
+      redirect_to new_account_import_path, alert: "Please select a file to import."
+    end
+  end
+
+  def show
+  end
+
+  private
+    def enforce_tenant_limit
+      redirect_to root_path unless Account.accepting_signups?
+    end
+
+    def set_import
+      @import = Account::Import.find(params[:id])
+      head :forbidden unless @import.identity == Current.identity
+    end
+
+    def file_param
+      params[:file] || params.dig(:import, :file) || params.dig(:account_import, :file)
+    end
+end
