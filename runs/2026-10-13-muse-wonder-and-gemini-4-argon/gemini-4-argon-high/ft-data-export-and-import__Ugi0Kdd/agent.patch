@@ -0,0 +1,209 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+    @user = users(:kevin)
+    Current.user = @user
+  end
+
+  test "full round-trip export and import creates new account with all data" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "embed.png",
+      content_type: "image/png"
+    )
+    mention_html = ActionText::Attachment.from_attachable(users(:jz)).to_html
+    embed_html = ActionText::Attachment.from_attachable(embed_blob, caption: "Embedded").to_html
+    card.update!(description: "<p>Card with #{mention_html} and #{embed_html}</p>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "comment_moon.jpg",
+      content_type: "image/jpeg"
+    )
+    comment = card.comments.create!(
+      creator: @user,
+      body: "<p>Comment with #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    @user.avatar.attach(io: file_fixture("avatar.png").open, filename: "kevin_avatar.png", content_type: "image/png")
+
+    expected_account_name = @account.name
+    expected_cards_count = @account.cards_count
+    expected_boards_count = @account.boards.count
+    expected_users_count = @account.users.count
+    expected_cards_total = @account.cards.count
+    expected_comments_total = Comment.where(account: @account).count
+    expected_tags_total = @account.tags.count
+    expected_columns_total = @account.columns.count
+    card_id = card.id
+    comment_id = comment.id
+
+    export = @account.exports.create!(user: @user)
+    export.build
+
+    zip_tempfile = Tempfile.new([ "account_export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    enqueued_jobs.clear
+    @account.incinerate
+    enqueued_jobs.clear
+
+    assert_not Account.exists?(@account.id)
+
+    identity = identities(:kevin)
+    import = nil
+    Current.without_account do
+      import = Account::Import.create!(
+        identity: identity,
+        file: { io: zip_tempfile, filename: "export.zip", content_type: "application/zip" }
+      )
+    end
+
+    assert_enqueued_emails 1 do
+      import.process
+    end
+
+    assert import.reload.completed?
+    new_account = import.account.reload
+
+    assert_equal expected_account_name, new_account.name
+    assert_equal expected_cards_count, new_account.cards_count
+    assert_equal expected_boards_count, new_account.boards.count
+    assert_equal expected_users_count, new_account.users.count
+    assert_equal expected_cards_total, new_account.cards.count
+    assert_equal expected_comments_total, Comment.where(account: new_account).count
+    assert_equal expected_tags_total, new_account.tags.count
+    assert_equal expected_columns_total, new_account.columns.count
+
+    imported_card = new_account.cards.find(card_id)
+    assert imported_card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+    assert_includes imported_card.description.body.attachables, users(:jz)
+    assert_includes imported_card.description.body.attachables, embed_blob.reload
+
+    imported_comment = Comment.find(comment_id)
+    assert_equal new_account.id, imported_comment.account_id
+    assert_includes imported_comment.body.body.attachables, comment_blob.reload
+
+    imported_kevin = new_account.users.find_by!(identity: identity)
+    assert imported_kevin.avatar.attached?
+    assert_equal file_fixture("avatar.png").binread, imported_kevin.avatar.download
+
+    # Search index works in the new account
+    search_results = imported_kevin.search("logo")
+    assert search_results.any?
+
+    # Storage is reconciled
+    assert new_account.bytes_used > 0
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "import fails with conflict when data already exists and leaves nothing behind" do
+    export = @account.exports.create!(user: @user)
+    export.build
+
+    zip_tempfile = Tempfile.new([ "conflict_export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    # Do NOT incinerate @account so its record UUIDs still exist in the DB
+    identity = identities(:kevin)
+
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count }, -> { User.count } ] do
+      import = Current.without_account do
+        Account::Import.create!(
+          identity: identity,
+          file: { io: zip_tempfile, filename: "export.zip", content_type: "application/zip" }
+        )
+      end
+
+      assert_enqueued_emails 1 do
+        import.process
+      end
+
+      assert import.reload.failed?
+      assert_equal "conflict", import.failure_reason
+      assert_nil import.account_id
+    end
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "import fails on invalid zip file and leaves nothing behind" do
+    identity = identities(:kevin)
+
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count }, -> { User.count } ] do
+      import = Current.without_account do
+        Account::Import.create!(
+          identity: identity,
+          file: { io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip" }
+        )
+      end
+
+      assert_enqueued_emails 1 do
+        import.process
+      end
+
+      assert import.reload.failed?
+      assert_equal "invalid_file", import.failure_reason
+      assert_nil import.account_id
+    end
+  end
+
+  test "import fails when blob file is missing from storage directory in zip and leaves nothing behind" do
+    tempfile = Tempfile.new([ "incomplete", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::AccountRecordSet.new(@account).export(to: writer)
+    blob_id = ActiveRecord::Type::Uuid.generate
+    writer.add_file("data/active_storage_blobs/#{blob_id}.json", {
+      id: blob_id,
+      account_id: @account.id,
+      key: "missing_storage_key",
+      filename: "missing.png",
+      content_type: "image/png",
+      metadata: "{}",
+      byte_size: 100,
+      checksum: "abc",
+      created_at: Time.current.iso8601
+    }.to_json)
+    writer.close
+    tempfile.rewind
+
+    identity = identities(:kevin)
+
+    assert_no_difference [ -> { Account.count }, -> { ActiveStorage::Blob.count } ] do
+      import = Current.without_account do
+        Account::Import.create!(
+          identity: identity,
+          file: { io: tempfile, filename: "incomplete.zip", content_type: "application/zip" }
+        )
+      end
+
+      assert_enqueued_emails 1 do
+        import.process
+      end
+
+      assert import.reload.failed?
+      assert_equal "invalid_file", import.failure_reason
+      assert_nil import.account_id
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
