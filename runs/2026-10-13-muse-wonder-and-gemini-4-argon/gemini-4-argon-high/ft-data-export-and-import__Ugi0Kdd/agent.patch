diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..000b532
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:kevin)
+    @member = users(:jz)
+    sign_in_as @admin
+  end
+
+  test "account settings page shows export section to admin" do
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "account settings page hides export section from non-admin" do
+    logout_and_sign_in_as @member
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+
+  test "admin can create an account export" do
+    assert_difference -> { @account.exports.count }, +1 do
+      assert_enqueued_with(job: ExportJob) do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "non-admin cannot create an account export" do
+    logout_and_sign_in_as @member
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "admin can view completed current export and download it" do
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a#download-link[href*='rails/active_storage']"
+  end
+
+  test "expired export does not show download link" do
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :success
+      assert_select "a#download-link", count: 0
+      assert_in_body "expired"
+    end
+  end
+
+  test "another admin cannot download someone else's export" do
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    logout_and_sign_in_as users(:jason)
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a#download-link", count: 0
+  end
+
+  test "non-admin cannot view account export" do
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    logout_and_sign_in_as @member
+
+    get account_export_path(export)
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..66d6af7
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    @identity = identities(:kevin)
+    sign_in_as @user
+  end
+
+  test "new renders upload form untenanted and tenanted" do
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      assert_select "input[type=file]"
+    end
+
+    get new_account_import_path
+    assert_response :success
+    assert_select "input[type=file]"
+  end
+
+  test "unauthenticated user is redirected to login" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+    end
+  end
+
+  test "create enqueues import job and redirects to import show page" do
+    export = @account.exports.create!(user: @user)
+    export.build
+
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+
+    uploaded_file = Rack::Test::UploadedFile.new(tempfile.path, "application/zip")
+
+    untenanted do
+      assert_difference -> { Account::Import.count }, +1 do
+        assert_enqueued_with(job: Account::ImportJob) do
+          post account_imports_path, params: { file: uploaded_file }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_redirected_to account_import_path(import, script_name: import.account.slug)
+
+    get account_import_path(import, script_name: import.account.slug)
+    assert_response :success
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "other identity cannot view someone else's import" do
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    tempfile.write("dummy")
+    tempfile.rewind
+
+    import = Account::Import.create!(
+      identity: @identity,
+      file: { io: tempfile, filename: "export.zip", content_type: "application/zip" }
+    )
+
+    logout_and_sign_in_as :david
+
+    get account_import_path(import, script_name: import.account.slug)
+    assert_response :forbidden
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
