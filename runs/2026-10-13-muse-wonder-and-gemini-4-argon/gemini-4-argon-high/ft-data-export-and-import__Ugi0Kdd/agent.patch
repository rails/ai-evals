diff --git a/app/mailers/import_mailer.rb b/app/mailers/import_mailer.rb
new file mode 100644
index 0000000..fbf75fe
--- /dev/null
+++ b/app/mailers/import_mailer.rb
@@ -0,0 +1,33 @@
+class ImportMailer < ApplicationMailer
+  def completed(identity_or_import, account = nil)
+    if identity_or_import.is_a?(Account::Import)
+      @import = identity_or_import
+      @identity = @import.identity
+      @account = account || @import.account
+    else
+      @identity = identity_or_import
+      @account = account
+    end
+
+    mail(
+      to: @identity.email_address,
+      subject: "Your Fizzy account import is complete"
+    )
+  end
+
+  def failed(identity_or_import, failure_reason = nil)
+    if identity_or_import.is_a?(Account::Import)
+      @import = identity_or_import
+      @identity = @import.identity
+      @failure_reason = failure_reason || @import.failure_reason
+    else
+      @identity = identity_or_import
+      @failure_reason = failure_reason
+    end
+
+    mail(
+      to: @identity.email_address,
+      subject: "Your Fizzy account import failed"
+    )
+  end
+end
