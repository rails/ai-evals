@@ -0,0 +1,115 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+    @user = users(:kevin)
+    Current.user = @user
+  end
+
+  test "account export builds zip with all account records and files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    card.update!(description: "<p>Logo description #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+
+    export = @account.exports.create!(user: @user)
+    assert export.pending?
+
+    assert_enqueued_emails 1 do
+      export.build
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("data/accounts/#{@account.id}.json")
+      assert zip.exists?("data/users/#{@user.id}.json")
+      assert zip.exists?("data/boards/#{boards(:writebook).id}.json")
+      assert zip.exists?("data/cards/#{card.id}.json")
+      assert zip.exists?("data/comments/#{comments(:logo_1).id}.json")
+      assert zip.exists?("storage/#{card.image.blob.key}")
+      assert zip.exists?("storage/#{embed_blob.key}")
+
+      # Does not include the export's own zip blob
+      assert_not zip.exists?("data/active_storage_blobs/#{export.file.blob.id}.json")
+      assert_not zip.exists?("storage/#{export.file.blob.key}")
+    end
+  end
+
+  test "user data export builds zip with accessible cards as JSON, comments, and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "comment_file.png",
+      content_type: "image/png"
+    )
+    comment = card.comments.create!(
+      creator: @user,
+      body: "<p>Attached file: #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    # Create a private board that david does NOT have access to
+    private_board = @account.boards.create!(name: "Secret Board", creator: @user, all_access: false)
+    secret_card = private_board.cards.create!(title: "Secret card", creator: @user, status: "published")
+
+    david = users(:david)
+    assert_not private_board.accessible_to?(david)
+
+    export = david.data_exports.create!(account: @account)
+    assert export.pending?
+
+    assert_enqueued_emails 1 do
+      export.build
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("#{card.number}.json")
+      assert zip.exists?("#{card.number}/moon.jpg")
+      assert zip.exists?("#{card.number}/comment_file.png")
+
+      # Secret card on inaccessible board is not included
+      assert_not zip.exists?("#{secret_card.number}.json")
+
+      card_json = JSON.parse(zip.read("#{card.number}.json"))
+      assert_equal card.number, card_json["number"]
+      assert_equal card.title, card_json["title"]
+      assert_equal card.board.name, card_json["board"]
+      assert card_json["comments"].any? { |c| c["id"] == comment.id }
+
+      assert_equal file_fixture("moon.jpg").binread, zip.read("#{card.number}/moon.jpg")
+      assert_equal file_fixture("avatar.png").binread, zip.read("#{card.number}/comment_file.png")
+    end
+  end
+
+  test "cleanup destroys expired exports older than a day" do
+    recent_export = @account.exports.create!(user: @user)
+    old_export = @account.exports.create!(user: @user, created_at: 25.hours.ago)
+
+    Export.cleanup
+
+    assert Export.exists?(recent_export.id)
+    assert_not Export.exists?(old_export.id)
+  end
+
+  test "accessible_to? only allows the user who requested the export" do
+    export = @account.exports.create!(user: @user)
+
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users(:david))
+    assert_not export.accessible_to?(nil)
+  end
+end
