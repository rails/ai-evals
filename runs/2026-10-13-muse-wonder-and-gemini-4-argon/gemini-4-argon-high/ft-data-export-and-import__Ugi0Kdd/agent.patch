 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+    @user = users(:david)
+    Current.user = @user
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "exports rich text with sgid replaced by gid and imports restoring sgid and updating blob url" do
+    mentioned_user = users(:jz)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    mention_html = ActionText::Attachment.from_attachable(mentioned_user).to_html
+    blob_html = ActionText::Attachment.from_attachable(blob, caption: "Moon photo").to_html
+    @card.update!(description: "<p>Hello #{mention_html} check out #{blob_html}</p>")
+    rich_text = @card.rich_text_description
+
+    tempfile = Tempfile.new([ "rich_text_test", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export(to: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    exported_path = "data/action_text_rich_texts/#{rich_text.id}.json"
+    assert reader.exists?(exported_path)
+
+    exported_data = JSON.parse(reader.read(exported_path))
+    exported_fragment = Nokogiri::HTML.fragment(exported_data["body"])
+    attachments = exported_fragment.css("action-text-attachment")
+    assert_equal 2, attachments.size
+    assert_nil attachments[0]["sgid"]
+    assert_equal mentioned_user.to_gid.to_s, attachments[0]["gid"]
+    assert_nil attachments[1]["sgid"]
+    assert_equal blob.to_gid.to_s, attachments[1]["gid"]
+
+    new_account = Account.create!(name: "New Account")
+    ActionText::RichText.where(account: @account).delete_all
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(new_account).import(from: reader)
+
+    imported_rich_text = ActionText::RichText.find(rich_text.id)
+    assert_equal new_account.id, imported_rich_text.account_id
+
+    imported_fragment = Nokogiri::HTML.fragment(imported_rich_text.body.to_html)
+    imported_attachments = imported_fragment.css("action-text-attachment")
+    assert_equal 2, imported_attachments.size
+
+    assert_nil imported_attachments[0]["gid"]
+    assert_equal mentioned_user.attachable_sgid, imported_attachments[0]["sgid"]
+
+    assert_nil imported_attachments[1]["gid"]
+    assert_equal blob.attachable_sgid, imported_attachments[1]["sgid"]
+    assert_match %r{\A#{new_account.slug}/rails/active_storage/blobs/redirect/.*/moon\.jpg\z}, imported_attachments[1]["url"]
+    assert_equal [ mentioned_user, blob ], imported_rich_text.body.attachables
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
 end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
