+<section class="settings__section settings-subscription">
+  <header>
+    <h2 class="divider">Subscription</h2>
+    <div>
+      You’re on the <strong><%= account.plan.name %></strong> plan
+      <% if account.comped? %>
+        (comped — <%= number_to_human_size(account.storage_limit) %> storage).
+      <% elsif account.plan.paid? %>
+        ($<%= account.plan.price %>/month, <%= number_to_human_size(account.storage_limit) %>).
+      <% else %>
+        (<%= number_with_delimiter(account.plan.card_limit) %> cards, <%= number_to_human_size(account.storage_limit) %>).
+      <% end %>
+    </div>
+  </header>
+
+  <% if account.subscribed? %>
+    <div class="flex flex-column gap-half">
+      <% if account.plan.key == :monthly_v1 %>
+        <div>Need more space? <strong>Unlimited+</strong> is $25/month for 500 GB.</div>
+        <div class="flex gap-half">
+          <%= button_to "Upgrade", account_billing_portal_path, method: :post, class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+          <%= button_to "Manage billing", account_billing_portal_path, method: :post, class: "btn", form: { data: { turbo: false } } %>
+        </div>
+      <% else %>
+        <div>
+          <%= button_to "Manage billing", account_billing_portal_path, method: :post, class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+        </div>
+      <% end %>
+    </div>
+  <% else %>
+    <%= form_with url: account_subscription_path, method: :post, data: { turbo: false }, class: "flex flex-column gap-half" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <label class="flex align-center gap-half">
+          <%= form.radio_button :plan_key, :monthly_v1, checked: true %>
+          <span><strong>Unlimited</strong> — $20/month, 5 GB</span>
+        </label>
+        <label class="flex align-center gap-half">
+          <%= form.radio_button :plan_key, :monthly_extra_storage_v1 %>
+          <span><strong>Unlimited+</strong> — $25/month, 500 GB</span>
+        </label>
+      </div>
+
+      <div>
+        <%= form.button "Upgrade", type: "submit", class: "btn settings-subscription__button" %>
+      </div>
+    <% end %>
+  <% end %>
+</section>
