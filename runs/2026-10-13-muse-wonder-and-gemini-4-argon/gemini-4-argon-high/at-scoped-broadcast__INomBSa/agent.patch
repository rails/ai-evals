diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..c5a6e26 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -79,8 +79,53 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts being edited indicator to current editors" do
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    kevin_stream = being_edited_stream_name
+
+    sign_in :david
+    broadcasts = capture_turbo_stream_broadcasts kevin_stream do
+      perform_enqueued_jobs do
+        put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Updated body" } }
+      end
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "append", broadcasts.first["action"]
+    assert_equal dom_id(leaves(:welcome_page), :being_edited), broadcasts.first["target"]
+    assert_includes broadcasts.first.to_html, users(:david).name
+  end
+
+  test "update does not broadcast being edited indicator to removed collaborators" do
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    kevin_stream = being_edited_stream_name
+
+    sign_in :jason
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :ok
+    jason_stream = being_edited_stream_name
+
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Better welcome" }, page: { body: "Updated body" } }
+    end
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+    assert_no_turbo_stream_broadcasts [ leaves(:welcome_page), :being_edited ]
+    assert_turbo_stream_broadcasts jason_stream, count: 1
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
+
+    def being_edited_stream_name
+      signed_stream_name = css_select("turbo-cable-stream-source").first["signed-stream-name"]
+      Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+    end
 end
