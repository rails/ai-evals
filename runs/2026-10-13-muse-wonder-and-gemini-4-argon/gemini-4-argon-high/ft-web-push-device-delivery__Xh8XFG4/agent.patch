diff --git a/app/models/web_push/notification.rb b/app/models/web_push/notification.rb
new file mode 100644
index 0000000..f90bb64
--- /dev/null
+++ b/app/models/web_push/notification.rb
@@ -0,0 +1,50 @@
+class WebPush::Notification
+  def initialize(title:, body:, path:, endpoint:, p256dh_key:, auth_key:, badge: nil)
+    @title, @body, @path, @badge = title, body, path, badge
+    @endpoint, @p256dh_key, @auth_key = endpoint, p256dh_key, auth_key
+  end
+
+  def deliver(connection: nil)
+    return unless vapid_configured?
+
+    options = {
+      message: encoded_message,
+      endpoint: @endpoint,
+      p256dh: @p256dh_key,
+      auth: @auth_key,
+      vapid: vapid_identification
+    }
+    options[:connection] = connection if connection
+
+    WebPush.payload_send(**options)
+  end
+
+  private
+    def vapid_configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_identification
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    def vapid_subject
+      ENV["MAILER_FROM_ADDRESS"] ? "mailto:#{ENV["MAILER_FROM_ADDRESS"]}" : "mailto:support@example.com"
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence || Rails.configuration.x.vapid.public_key
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence || Rails.configuration.x.vapid.private_key
+    end
+
+    def encoded_message
+      JSON.generate title: @title, options: { body: @body, data: { path: @path, badge: @badge }.compact }
+    end
+end
