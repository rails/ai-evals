diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..f09f8d9
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,159 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static values = { subscriptionsUrl: String }
+  static targets = [ "bell", "details" ]
+  static classes = [ "enabled" ]
+
+  async connect() {
+    if (this.isSupported) {
+      if (await this.isEnabled) {
+        await this.#subscribe()
+        this.#showEnabled()
+      } else {
+        this.#showBell()
+        if (this.permissionDenied) {
+          this.#showBellAlert()
+          this.#revealDetails()
+        } else {
+          this.#hideDetails()
+        }
+      }
+    } else {
+      this.#hideDetails()
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (this.isSupported) {
+      if (await this.#allowedToNotify) {
+        await this.#subscribe()
+        this.#showEnabled()
+      } else {
+        this.#showBellAlert()
+        this.#revealDetails()
+      }
+    } else {
+      this.#revealDetails()
+    }
+  }
+
+  get isSupported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get isEnabled() {
+    if (this.isSupported && Notification.permission === "granted") {
+      return this.#hasSubscription
+    } else {
+      return false
+    }
+  }
+
+  get permissionDenied() {
+    return Notification.permission === "denied"
+  }
+
+  get #hasSubscription() {
+    return this.#serviceWorkerRegistration
+      .then(registration => registration?.pushManager.getSubscription())
+      .then(Boolean)
+  }
+
+  async #subscribe() {
+    const registration = await this.#serviceWorkerRegistration
+    const subscription = await registration?.pushManager.getSubscription() || await registration?.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#vapidPublicKey
+    })
+
+    if (subscription) {
+      await this.#createPushSubscription(subscription)
+    }
+  }
+
+  async #createPushSubscription(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON ? subscription.toJSON() : subscription
+
+    const body = new FormData()
+    body.append("push_subscription[endpoint]", endpoint)
+    body.append("push_subscription[p256dh_key]", p256dh)
+    body.append("push_subscription[auth_key]", auth)
+
+    await post(this.subscriptionsUrlValue, { body })
+  }
+
+  get #serviceWorkerRegistration() {
+    return this.#getServiceWorkerRegistration()
+  }
+
+  async #getServiceWorkerRegistration() {
+    const registration = await navigator.serviceWorker.getRegistration() || await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    if (registration && !registration.active && (registration.installing || registration.waiting) && navigator.serviceWorker.ready) {
+      return await navigator.serviceWorker.ready
+    }
+    return registration
+  }
+
+  get #allowedToNotify() {
+    switch (Notification.permission) {
+      case "denied":  return false
+      case "granted": return true
+      default:        return Notification.requestPermission().then(permission => permission === "granted")
+    }
+  }
+
+  get #vapidPublicKey() {
+    const encodedKey = document.querySelector('meta[name="vapid-public-key"]')?.content
+    return encodedKey ? this.#urlBase64ToUint8Array(encodedKey) : null
+  }
+
+  #showBell() {
+    if (this.hasBellTarget) {
+      this.bellTarget.removeAttribute("hidden")
+    }
+  }
+
+  #showBellAlert() {
+    if (this.hasBellTarget) {
+      this.bellTarget.querySelector(".icon--bell, .icon--bell-off")?.classList.replace("icon--bell", "icon--bell-alert")
+      this.bellTarget.querySelector(".icon--bell-off")?.classList.replace("icon--bell-off", "icon--bell-alert")
+    }
+  }
+
+  #revealDetails() {
+    this.detailsTargets.forEach(details => {
+      details.removeAttribute("hidden")
+      if (details.tagName === "DETAILS") details.open = true
+    })
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => {
+      details.setAttribute("hidden", true)
+      if (details.tagName === "DETAILS") details.open = false
+    })
+  }
+
+  #showEnabled() {
+    if (this.hasEnabledClass) {
+      this.element.classList.add(this.enabledClass)
+    }
+    this.#hideDetails()
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
