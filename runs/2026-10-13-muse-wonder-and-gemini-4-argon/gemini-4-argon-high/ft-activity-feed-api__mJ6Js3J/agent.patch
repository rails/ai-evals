diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..7b855aa
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,280 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activity newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected_ids = users(:kevin).accessible_events.timelineable.reverse_chronologically.pluck(:id)
+    assert_equal expected_ids, @response.parsed_body.pluck("id")
+  end
+
+  test "card event representation" do
+    event = events(:logo_published)
+
+    get activities_path, as: :json
+    assert_response :success
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_not_nil activity
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.id, activity["id"]
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+    assert_equal event.eventable.number, activity.dig("eventable", "number")
+    assert_equal event.eventable.title, activity.dig("eventable", "title")
+    assert_equal card_url(event.eventable), activity.dig("eventable", "url")
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.board.name, activity.dig("board", "name")
+    assert_equal board_url(event.board), activity.dig("board", "url")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+    assert_equal event.creator.name, activity.dig("creator", "name")
+    assert_equal user_url(event.creator), activity.dig("creator", "url")
+  end
+
+  test "comment event representation" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path, as: :json
+    assert_response :success
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_not_nil activity
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal card_comment_url(comment.card, comment), activity.dig("eventable", "url")
+  end
+
+  test "includes all timeline event kinds with card_title_changed and omits card_collection_changed" do
+    card = cards(:logo)
+    board = card.board
+    comment = comments(:layout_overflowing_david)
+
+    included_card_actions = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_title_changed
+      card_triaged
+      card_sent_back_to_triage
+    ]
+
+    created_events = included_card_actions.index_with do |action|
+      board.events.create!(action: action, creator: users(:kevin), eventable: card)
+    end
+    comment_event = board.events.create!(action: "comment_created", creator: users(:kevin), eventable: comment)
+
+    collection_changed_event = board.events.create!(
+      action: "card_collection_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: { particulars: { new_collection: "Other" } }
+    )
+    resumed_event = board.events.create!(
+      action: "card_resumed",
+      creator: users(:kevin),
+      eventable: card
+    )
+
+    get activities_path, as: :json
+    assert_response :success
+
+    ids = @response.parsed_body.pluck("id")
+    created_events.each_value do |event|
+      assert_includes ids, event.id
+    end
+    assert_includes ids, comment_event.id
+    assert_not_includes ids, collection_changed_event.id
+    assert_not_includes ids, resumed_event.id
+  end
+
+  test "particulars for assignment changes" do
+    card = cards(:logo)
+
+    with_current_user(:kevin) do
+      card.toggle_assignment(users(:jz))
+      card.reload.toggle_assignment(users(:jz))
+    end
+
+    unassigned_event = card.events.where(action: "card_unassigned").last
+    assigned_event = card.events.where(action: "card_assigned").last
+
+    get activities_path, as: :json
+    assert_response :success
+
+    assigned_activity = @response.parsed_body.find { |record| record["id"] == assigned_event.id }
+    unassigned_activity = @response.parsed_body.find { |record| record["id"] == unassigned_event.id }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, assigned_activity["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, unassigned_activity["particulars"])
+  end
+
+  test "particulars for board changes, title changes, and triage events" do
+    card = cards(:buy_domain)
+
+    with_current_user(:kevin) do
+      card.update!(title: "Register domain")
+      card.triage_into(columns(:writebook_in_progress))
+      card.move_to(boards(:private))
+    end
+
+    title_changed_event = card.events.where(action: "card_title_changed").last
+    triaged_event = card.events.where(action: "card_triaged").last
+    board_changed_event = card.events.where(action: "card_board_changed").last
+
+    get activities_path, as: :json
+    assert_response :success
+
+    board_activity = @response.parsed_body.find { |record| record["id"] == board_changed_event.id }
+    title_activity = @response.parsed_body.find { |record| record["id"] == title_changed_event.id }
+    triaged_activity = @response.parsed_body.find { |record| record["id"] == triaged_event.id }
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, board_activity["particulars"])
+    assert_equal({ "old_title" => "Buy domain", "new_title" => "Register domain" }, title_activity["particulars"])
+    assert_equal({ "column" => "In progress" }, triaged_activity["particulars"])
+  end
+
+  test "missing board, title, or column values in particulars are returned as empty strings" do
+    card = cards(:logo)
+    board = card.board
+
+    board_changed_event = board.events.create!(
+      action: "card_board_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+    title_changed_event = board.events.create!(
+      action: "card_title_changed",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+    triaged_event = board.events.create!(
+      action: "card_triaged",
+      creator: users(:kevin),
+      eventable: card,
+      particulars: {}
+    )
+
+    get activities_path, as: :json
+    assert_response :success
+
+    board_activity = @response.parsed_body.find { |record| record["id"] == board_changed_event.id }
+    title_activity = @response.parsed_body.find { |record| record["id"] == title_changed_event.id }
+    triaged_activity = @response.parsed_body.find { |record| record["id"] == triaged_event.id }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, board_activity["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, title_activity["particulars"])
+    assert_equal({ "column" => "" }, triaged_activity["particulars"])
+  end
+
+  test "filters by creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |activity|
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+    end
+  end
+
+  test "filters by board_ids" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret card", status: "published") }
+    private_event = private_card.events.last
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "filters by creator_ids and board_ids together" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret card", status: "published") }
+    private_event = private_card.events.last
+
+    get activities_path, params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path, params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "only returns activity the current user can access" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret card", status: "published") }
+    private_event = private_card.events.last
+
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "paginates results" do
+    card = cards(:logo)
+    board = card.board
+
+    20.times do |i|
+      board.events.create!(
+        action: "card_closed",
+        creator: users(:kevin),
+        eventable: card,
+        created_at: i.minutes.ago
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.timelineable.reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
