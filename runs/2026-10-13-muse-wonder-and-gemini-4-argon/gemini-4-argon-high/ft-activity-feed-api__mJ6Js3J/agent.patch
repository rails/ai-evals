diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..35837b1 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,24 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def particular_details
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(particular_value("assignee_ids")) }
+    when "card_board_changed"
+      { old_board: particular_value("old_board").to_s, new_board: particular_value("new_board").to_s }
+    when "card_title_changed"
+      { old_title: particular_value("old_title").to_s, new_title: particular_value("new_title").to_s }
+    when "card_triaged"
+      { column: particular_value("column").to_s }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_value(key)
+      particulars&.dig("particulars", key) || particulars&.[](key)
+    end
 end
