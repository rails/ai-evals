   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  if config.action_mailer.default_url_options.blank?
+    deploy_host = begin
+      deploy_config_path = Rails.root.join("config/deploy.yml")
+      if deploy_config_path.exist?
+        deploy_config = YAML.safe_load(ERB.new(deploy_config_path.read, trim_mode: "-").result, aliases: true)
+        deploy_config.dig("proxy", "host") || deploy_config.dig("proxy", "hosts")&.first
+      end
+    rescue
+      nil
+    end
+
+    custom_deploy_host = deploy_host unless deploy_host.in?([ "fizzy.example.com", "app.example.com", "example.com" ])
+    base_url_host = URI.parse(ENV["BASE_URL"]).host || ENV["BASE_URL"] if ENV["BASE_URL"].present?
+
+    app_host = ENV["APP_HOST"].presence ||
+      ENV["APP_FQDN"].presence ||
+      ENV["HOST"].presence ||
+      base_url_host.presence ||
+      custom_deploy_host.presence ||
+      ENV["KAMAL_HOST"].presence ||
+      deploy_host.presence ||
+      "example.com"
+
+    url_options = { host: app_host, protocol: ssl_enabled ? "https" : "http" }
+    config.action_mailer.default_url_options = url_options
+    routes.default_url_options = url_options
+  end
+
+  if config.action_mailer.smtp_settings.blank? && ENV["SMTP_ADDRESS"].present?
+    smtp_user_name = ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence
+
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: (ENV["SMTP_PORT"].presence || 587).to_i,
+      domain: ENV["SMTP_DOMAIN"].presence || config.action_mailer.default_url_options&.dig(:host),
+      user_name: smtp_user_name,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: (ENV["SMTP_AUTHENTICATION"].presence || "plain").to_sym,
+      enable_starttls_auto: (ENV["SMTP_ENABLE_STARTTLS_AUTO"].presence || "true") == "true",
+      openssl_verify_mode: ENV["SMTP_OPENSSL_VERIFY_MODE"].presence
+    }.tap { |settings| settings.delete(:authentication) unless smtp_user_name }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/test/lib/kamal_deploy_config_test.rb b/test/lib/kamal_deploy_config_test.rb
new file mode 100644
index 0000000..6d0c696
--- /dev/null
+++ b/test/lib/kamal_deploy_config_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+require "kamal"
+
+class KamalDeployConfigTest < ActiveSupport::TestCase
+  class FakeApp
+    attr_reader :config, :routes
+
+    def initialize(root)
+      @config = ActiveSupport::OrderedOptions.new
+      @config.root = root
+      %i[ action_controller public_file_server active_storage active_job solid_queue action_mailer i18n active_support active_record ].each do |section|
+        @config[section] = ActiveSupport::OrderedOptions.new
+      end
+      @routes = ActiveSupport::OrderedOptions.new
+    end
+
+    def configure(&block)
+      instance_eval(&block)
+    end
+  end
+
+  test "deploy.yml is a valid one-box Kamal configuration" do
+    config = Kamal::Configuration.create_from(config_file: Rails.root.join("config/deploy.yml"))
+
+    assert_equal "fizzy", config.service
+    assert_equal [ "web" ], config.roles.map(&:name)
+    assert_empty config.accessories
+
+    web_role = config.role(:web)
+    assert web_role.running_proxy?
+    assert web_role.ssl?
+    assert_not_empty web_role.proxy.hosts
+
+    assert_includes config.volume_args, "fizzy_storage:/rails/storage"
+
+    env = web_role.env(config.primary_host)
+    assert_equal "true", env.clear["SOLID_QUEUE_IN_PUMA"].to_s
+    assert env.clear.key?("SMTP_ADDRESS")
+    assert env.clear.key?("SMTP_PORT")
+    assert env.clear.key?("MAILER_FROM_ADDRESS")
+
+    %w[ SECRET_KEY_BASE VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY SMTP_USERNAME SMTP_PASSWORD ].each do |secret|
+      assert_includes env.secret_keys, secret
+    end
+  end
+
+  test "production environment configures mailer URLs and SMTP from Kamal env" do
+    fake_app = FakeApp.new(Rails.root)
+
+    with_env(
+      "KAMAL_HOST" => "fizzy.my-domain.test",
+      "SMTP_ADDRESS" => "mail.my-domain.test",
+      "SMTP_PORT" => "2525",
+      "SMTP_USERNAME" => "mailer-user",
+      "SMTP_PASSWORD" => "mailer-pass"
+    ) do
+      Rails.stubs(:application).returns(fake_app)
+      load Rails.root.join("config/environments/production.rb")
+    end
+
+    assert_equal({ host: "fizzy.my-domain.test", protocol: "https" }, fake_app.config.action_mailer.default_url_options)
+    assert_equal({ host: "fizzy.my-domain.test", protocol: "https" }, fake_app.routes.default_url_options)
+    assert_equal(
+      {
+        address: "mail.my-domain.test",
+        port: 2525,
+        domain: "fizzy.my-domain.test",
+        user_name: "mailer-user",
+        password: "mailer-pass",
+        authentication: :plain,
+        enable_starttls_auto: true
+      },
+      fake_app.config.action_mailer.smtp_settings
+    )
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
