diff --git a/.kamal/secrets b/.kamal/secrets
new file mode 100644
index 0000000..a8891a9
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,17 @@
+# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
+# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
+# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
+
+# Generate a secret key base with: bin/rails secret
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Generate VAPID keys with: bin/rails runner "vapid = WebPush.generate_key; puts \"VAPID_PUBLIC_KEY=#{vapid.public_key}\nVAPID_PRIVATE_KEY=#{vapid.private_key}\""
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Mail server credentials
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Container registry password (when using a remote registry)
+# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..27230e5
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,98 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (use your-user/app-name on external registries).
+image: fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - fizzy.example.com
+
+# Enable SSL auto certification via Let's Encrypt and allow for multiple apps on a single web server.
+# If used with Cloudflare, set encryption mode in SSL/TLS setting to "Full" to enable CF-to-app encryption.
+#
+# Using an SSL proxy like this requires turning on config.assume_ssl and config.force_ssl in production.rb!
+#
+# Don't use this when deploying to multiple web servers (then you have to terminate SSL at your load balancer).
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Where you keep your container images.
+registry:
+  # Alternatives: hub.docker.com / registry.digitalocean.com / ghcr.io / ...
+  server: localhost:5555
+
+  # Needed for authenticated registries.
+  # username: your-user
+
+  # Always use an access token rather than real password when possible.
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run the Solid Queue Supervisor inside the web server's Puma process to do jobs.
+    # When you start using multiple servers, you should split out job processing to a dedicated machine.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Set the outgoing email sender address and SMTP server.
+    MAILER_FROM_ADDRESS: "Fizzy <support@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS_AUTO: true
+
+    # Set number of processes dedicated to Solid Queue (default: number of CPU cores)
+    # JOB_CONCURRENCY: 3
+
+    # Set number of cores available to the application on each server (default: number of CPU cores).
+    # WEB_CONCURRENCY: 2
+
+    # Log everything from Rails
+    # RAILS_LOG_LEVEL: debug
+  secret:
+    - SECRET_KEY_BASE
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# Aliases are triggered with "bin/kamal <alias>". You can overwrite arguments on invocation:
+# "bin/kamal logs -r job" will tail logs from the first server in the job section.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Use a persistent storage volume for sqlite database files and local Active Storage files.
+# Recommended to change this to a mounted volume path that is backed up off server.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64
+
+  # # Build image via remote server (useful for faster amd64 builds on arm64 computers)
+  # remote: ssh://docker@docker-builder-server
+  #
+  # # Pass arguments and secrets to the Docker build process
+  # args:
+  #   RUBY_VERSION: 3.4.8
+  # secrets:
+  #   - GITHUB_TOKEN
+  #   - RAILS_MASTER_KEY
+
+# Use a different ssh user than root
+# ssh:
+#   user: app
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..0399e1a 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,64 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Set default URL options from environment or deploy configuration.
+  # Don't overwrite if they've already been set (e.g. by fizzy-saas)
+  if config.action_mailer.default_url_options.blank? || config.action_controller.default_url_options.blank?
+    deploy_host = begin
+      YAML.load_file(Rails.root.join("config/deploy.yml")).dig("proxy", "host")
+    rescue
+      nil
+    end
+
+    kamal_host = ENV["KAMAL_HOST"].presence
+    default_hosts = %w[ fizzy.example.com app.example.com example.com 192.168.0.1 ]
+
+    app_host = ENV["APP_HOST"].presence ||
+      ENV["HOST"].presence ||
+      ENV["APP_FQDN"].presence ||
+      (deploy_host if deploy_host.present? && !default_hosts.include?(deploy_host)) ||
+      (kamal_host if kamal_host.present? && !(IPAddr.new(kamal_host) rescue nil)) ||
+      kamal_host ||
+      deploy_host ||
+      "example.com"
+
+    url_options = { host: app_host, protocol: ssl_enabled ? "https" : "http" }
+    config.action_mailer.default_url_options ||= url_options
+    config.action_controller.default_url_options ||= url_options
+    routes.default_url_options = url_options if routes.default_url_options.blank?
+  end
+
+  # Configure outgoing SMTP server via env vars.
+  # Don't overwrite if it's already been set (e.g. by fizzy-saas)
+  if config.action_mailer.smtp_settings.blank?
+    deploy_env = begin
+      YAML.load_file(Rails.root.join("config/deploy.yml")).dig("env", "clear") || {}
+    rescue
+      {}
+    end
+
+    smtp_address = ENV["SMTP_ADDRESS"].presence || deploy_env["SMTP_ADDRESS"].presence
+
+    if smtp_address.present?
+      smtp_username = (ENV["SMTP_USERNAME"] || ENV["SMTP_USER_NAME"]).presence
+      smtp_port = ENV["SMTP_PORT"].presence || deploy_env["SMTP_PORT"] || 587
+      smtp_domain = ENV["SMTP_DOMAIN"].presence || deploy_env["SMTP_DOMAIN"].presence || config.action_mailer.default_url_options&.dig(:host)
+      smtp_auth = (ENV["SMTP_AUTHENTICATION"] || deploy_env["SMTP_AUTHENTICATION"]).presence&.to_sym || (:plain if smtp_username.present?)
+      smtp_starttls = ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", deploy_env.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true")).to_s == "true"
+
+      config.action_mailer.smtp_settings = {
+        address: smtp_address,
+        port: smtp_port.to_i,
+        domain: smtp_domain,
+        user_name: smtp_username,
+        password: ENV["SMTP_PASSWORD"].presence,
+        authentication: smtp_auth,
+        enable_starttls_auto: smtp_starttls,
+        openssl_verify_mode: ENV["SMTP_OPENSSL_VERIFY_MODE"].presence
+      }.compact
+    end
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/test/lib/kamal_deploy_config_test.rb b/test/lib/kamal_deploy_config_test.rb
new file mode 100644
index 0000000..ae0c1f4
--- /dev/null
+++ b/test/lib/kamal_deploy_config_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+require "kamal"
+
+class KamalDeployConfigTest < ActiveSupport::TestCase
+  setup do
+    @config_file = Rails.root.join("config/deploy.yml")
+    @config = Kamal::Configuration.create_from(config_file: @config_file)
+  end
+
+  test "deploy.yml is a valid Kamal configuration for one box" do
+    assert_equal "fizzy", @config.service
+    assert_equal [ "web" ], @config.roles.map(&:name)
+    assert_equal 1, @config.all_hosts.size
+    assert_empty @config.accessories
+  end
+
+  test "proxy enables SSL for the configured host" do
+    role = @config.primary_role
+
+    assert role.running_proxy?
+    assert role.ssl?
+    assert_not_empty role.proxy.hosts
+  end
+
+  test "storage volume is mounted at /rails/storage so data survives deploys" do
+    assert_includes @config.volume_args, "fizzy_storage:/rails/storage"
+  end
+
+  test "background jobs run in Puma inside the container" do
+    assert_equal true, @config.env.clear["SOLID_QUEUE_IN_PUMA"]
+  end
+
+  test "mail server and required secrets are wired into env and .kamal/secrets" do
+    assert_includes @config.env.clear.keys, "SMTP_ADDRESS"
+    assert_includes @config.env.clear.keys, "SMTP_PORT"
+    assert_includes @config.env.clear.keys, "MAILER_FROM_ADDRESS"
+
+    %w[ SECRET_KEY_BASE VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY SMTP_USERNAME SMTP_PASSWORD ].each do |secret|
+      assert_includes @config.env.secret_keys, secret
+      assert_nothing_raised { @config.secrets[secret] }
+    end
+  end
+
+  test "filling in hostname, mail server, and secrets configures Kamal" do
+    Dir.mktmpdir do |dir|
+      deploy_path = Pathname.new(File.join(dir, "deploy.yml"))
+      secrets_dir = File.join(dir, ".kamal")
+      FileUtils.mkdir_p(secrets_dir)
+      secrets_path = File.join(secrets_dir, "secrets")
+
+      deploy_content = File.read(@config_file)
+        .gsub("fizzy.example.com", "fizzy.their-host.com")
+        .gsub("smtp.example.com", "mail.their-host.com")
+      File.write(deploy_path, "secrets_path: #{secrets_path}\n" + deploy_content)
+
+      File.write(secrets_path, <<~SECRETS)
+        SECRET_KEY_BASE=test_secret_key_base_value
+        VAPID_PUBLIC_KEY=test_vapid_public_key
+        VAPID_PRIVATE_KEY=test_vapid_private_key
+        SMTP_USERNAME=smtp_user
+        SMTP_PASSWORD=smtp_pass
+      SECRETS
+
+      custom_config = Kamal::Configuration.create_from(config_file: deploy_path)
+
+      assert_equal [ "fizzy.their-host.com" ], custom_config.all_hosts
+      assert_equal [ "fizzy.their-host.com" ], custom_config.primary_role.proxy.hosts
+      assert custom_config.primary_role.ssl?
+      assert_equal "mail.their-host.com", custom_config.env.clear["SMTP_ADDRESS"]
+      assert_equal "test_secret_key_base_value", custom_config.secrets["SECRET_KEY_BASE"]
+      assert_equal "smtp_user", custom_config.secrets["SMTP_USERNAME"]
+      assert_equal "smtp_pass", custom_config.secrets["SMTP_PASSWORD"]
+    end
+  end
+end
