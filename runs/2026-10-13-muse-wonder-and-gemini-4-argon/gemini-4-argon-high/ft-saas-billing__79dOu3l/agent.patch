diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..c9c153e
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :mike
+  end
+
+  test "admin sees plan and Upgrade in settings on free plan" do
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#subscription", text: /Free/
+    assert_select "#subscription button", text: "Upgrade"
+  end
+
+  test "admin sees paid plan in settings" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#subscription", text: /Unlimited/
+    assert_select "#subscription button", text: "Upgrade", count: 0
+  end
+
+  test "non-admin does not see subscription or Upgrade in settings" do
+    logout_and_sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "#subscription", count: 0
+  end
+
+  test "create creates stripe customer and checkout session and redirects" do
+    Stripe::Customer.expects(:create).returns(stub(id: "cus_new_123"))
+    Stripe::Checkout::Session.expects(:create).with(
+      has_entries(
+        customer: "cus_new_123",
+        mode: "subscription",
+        line_items: [ { price: Plan.paid.stripe_price_id, quantity: 1 } ]
+      )
+    ).returns(stub(url: "https://checkout.stripe.com/pay/cs_test_123"))
+
+    assert_difference -> { Account::Subscription.count }, 1 do
+      post saas.account_subscription_path(script_name: @account.slug)
+    end
+
+    assert_redirected_to "https://checkout.stripe.com/pay/cs_test_123"
+    assert_equal "cus_new_123", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "create with specific plan_key uses that plan's price" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing")
+
+    Stripe::Checkout::Session.expects(:create).with(
+      has_entries(
+        customer: "cus_existing",
+        mode: "subscription",
+        line_items: [ { price: Plan.unlimited_plus.stripe_price_id, quantity: 1 } ]
+      )
+    ).returns(stub(url: "https://checkout.stripe.com/pay/cs_plus"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/pay/cs_plus"
+  end
+
+  test "billing portal redirects to stripe customer portal" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_existing",
+      stripe_subscription_id: "sub_existing",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::BillingPortal::Session.expects(:create).with(
+      has_entries(customer: "cus_existing")
+    ).returns(stub(url: "https://billing.stripe.com/p/session/test_123"))
+
+    post saas.account_subscription_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/test_123"
+  end
+
+  test "non-admin cannot create checkout session" do
+    logout_and_sign_in_as :jz
+
+    post saas.account_subscription_path(script_name: accounts(:"37s").slug)
+
+    assert_response :forbidden
+  end
+
+  test "show renders confirmation page" do
+    Stripe::Checkout::Session.stubs(:retrieve).returns(stub(id: "cs_123"))
+
+    get saas.account_subscription_path(script_name: @account.slug, session_id: "cs_123")
+
+    assert_response :success
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..657f168
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "non-staff cannot access admin accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can list accounts and open account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "h1", text: @account.name
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "staff can override and reset account limits" do
+    sign_in_as :david
+
+    untenanted do
+      put saas.admin_account_overridden_limits_path(@account), params: {
+        overridden_limits: { card_count: 950, bytes_used: 500_000_000 }
+      }
+      assert_redirected_to saas.admin_account_path(@account)
+
+      @account.reload
+      assert_equal 950, @account.card_count
+      assert_equal 500_000_000, @account.bytes_used
+
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+
+      @account.reload
+      assert_nil @account.overridden_limits
+      assert_equal 0, @account.card_count
+      assert_equal 0, @account.bytes_used
+    end
+  end
+end
diff --git a/saas/test/controllers/card/limited/creation_test.rb b/saas/test/controllers/card/limited/creation_test.rb
new file mode 100644
index 0000000..3876a1b
--- /dev/null
+++ b/saas/test/controllers/card/limited/creation_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Card::Limited::CreationTest < ActionDispatch::IntegrationTest
+  test "cannot create cards via JSON when card limit exceeded" do
+    sign_in_as :mike
+
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can create cards via HTML when card limit exceeded since they become drafts" do
+    sign_in_as :mike
+
+    accounts(:initech).update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "can create cards via JSON when under card limit" do
+    sign_in_as :mike
+
+    accounts(:initech).update_column(:cards_count, 100)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Allowed card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "staff can create cards via JSON even when card limit exceeded" do
+    sign_in_as :mike
+
+    accounts(:initech).update_column(:cards_count, 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Staff card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+end
