+      headers: { "Content-Type" => "application/json", "Stripe-Signature" => "t=123,v1=bad" }
+
+    assert_response :bad_request
+  end
+
+  test "handles customer.subscription.created" do
+    period_end = 1.month.from_now.to_i
+    payload = webhook_payload("customer.subscription.created", {
+      id: "sub_webhook_123",
+      object: "subscription",
+      customer: "cus_webhook_123",
+      status: "active",
+      items: {
+        data: [
+          {
+            price: { id: Plan[:monthly_v1].stripe_price_id, unit_amount: 2000 },
+            current_period_end: period_end
+          }
+        ]
+      }
+    })
+
+    post_webhook(payload)
+
+    assert_response :ok
+    @subscription.reload
+    assert_equal "sub_webhook_123", @subscription.stripe_subscription_id
+    assert_equal "monthly_v1", @subscription.plan_key
+    assert_equal "active", @subscription.status
+    assert_equal Time.at(period_end).utc, @subscription.current_period_end
+    assert_equal Plan[:monthly_v1], @account.reload.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "handles customer.subscription.updated to Unlimited+" do
+    @subscription.update!(stripe_subscription_id: "sub_webhook_123", plan_key: "monthly_v1", status: "active")
+
+    period_end = 1.month.from_now.to_i
+    cancel_at = 2.months.from_now.to_i
+    payload = webhook_payload("customer.subscription.updated", {
+      id: "sub_webhook_123",
+      object: "subscription",
+      customer: "cus_webhook_123",
+      status: "active",
+      cancel_at: cancel_at,
+      items: {
+        data: [
+          {
+            price: { id: Plan[:monthly_extra_storage_v1].stripe_price_id, unit_amount: 2500 },
+            current_period_end: period_end
+          }
+        ]
+      }
+    })
+
+    post_webhook(payload)
+
+    assert_response :ok
+    @subscription.reload
+    assert_equal "monthly_extra_storage_v1", @subscription.plan_key
+    assert_equal Time.at(cancel_at).utc, @subscription.cancel_at
+    assert_equal Plan[:monthly_extra_storage_v1], @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "handles customer.subscription.deleted" do
+    @subscription.update!(stripe_subscription_id: "sub_webhook_123", plan_key: "monthly_v1", status: "active")
+
+    payload = webhook_payload("customer.subscription.deleted", {
+      id: "sub_webhook_123",
+      object: "subscription",
+      customer: "cus_webhook_123",
+      status: "canceled"
+    })
+
+    post_webhook(payload)
+
+    assert_response :ok
+    assert @subscription.reload.canceled?
+    assert_nil @account.reload.active_subscription
+    assert_equal Plan.free, @account.plan
+  end
+
+  private
+    def webhook_payload(type, object)
+      {
+        id: "evt_#{SecureRandom.hex(8)}",
+        object: "event",
+        type: type,
+        data: { object: object }
+      }.to_json
+    end
+
+    def post_webhook(payload)
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, @secret)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      post "/stripe/webhooks",
+        params: payload,
+        headers: { "Content-Type" => "application/json", "Stripe-Signature" => header }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..2c10a33
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "defaults to free plan" do
+    assert_equal Plan.free, @account.plan
+    assert_nil @account.active_subscription
+    assert_not @account.comped?
+  end
+
+  test "active subscription sets account plan and storage allowance" do
+    subscription = @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_equal subscription, @account.active_subscription
+    assert_equal Plan[:monthly_v1], @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal Float::INFINITY, @account.card_limit
+  end
+
+  test "unlimited+ subscription sets 500 GB storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+
+    assert_equal Plan[:monthly_extra_storage_v1], @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_equal Float::INFINITY, @account.card_limit
+  end
+
+  test "canceled subscription falls back to free plan" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "canceled"
+    )
+
+    assert_nil @account.active_subscription
+    assert_equal Plan.free, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "comp and uncomp" do
+    assert_not @account.comped?
+
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.paid, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal Float::INFINITY, @account.card_limit
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "cancelling and reactivating account pauses and resumes stripe subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:update).with("sub_123", pause_collection: { behavior: "void" }).once
+    @account.cancel(initiated_by: users(:mike))
+
+    Stripe::Subscription.expects(:update).with("sub_123", pause_collection: "").once
+    @account.reactivate
+  end
+
+  test "incinerating account cancels stripe subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_123").once
+    @account.incinerate
+  end
+end
diff --git a/saas/test/models/account/limited_test.rb b/saas/test/models/account/limited_test.rb
new file mode 100644
index 0000000..8a5513a
--- /dev/null
+++ b/saas/test/models/account/limited_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Account::LimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "exceeding card limit when card count reaches 1,000 on free plan" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "not exceeding card limit when under 1,000 cards" do
+    @account.update_column(:cards_count, 500)
+
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 500, @account.cards_remaining
+  end
+
+  test "nearing card limit from 100 cards out" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update_column(:cards_count, 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+
+    @account.update_column(:cards_count, 999)
+    assert @account.nearing_card_limit?
+    assert_equal 1, @account.cards_remaining
+  end
+
+  test "paid account does not exceed or near card limit" do
+    @account.update_column(:cards_count, 2_000)
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "comped account does not exceed or near card limit" do
+    @account.update_column(:cards_count, 2_000)
+    @account.comp
+
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "override_limits and reset_overridden_limits" do
+    @account.update_column(:cards_count, 10)
+
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert_equal 1_000, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+
+    assert_equal 10, @account.card_count
+    assert_equal 0, @account.bytes_used
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..876e8b1
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan properties" do
+    plan = Plan.free
+
+    assert_equal :free_v1, plan.key
+    assert_equal "Free", plan.name
+    assert_equal 0, plan.price
+    assert_equal 1_000, plan.card_limit
+    assert_equal 1.gigabyte, plan.storage_limit
+    assert_nil plan.stripe_price_id
+    assert plan.free?
+    assert_not plan.paid?
+    assert_not plan.unlimited_cards?
+  end
+
+  test "unlimited plan properties" do
+    plan = Plan.paid
+
+    assert_equal :monthly_v1, plan.key
+    assert_equal "Unlimited", plan.name
+    assert_equal 20, plan.price
+    assert_equal Float::INFINITY, plan.card_limit
+    assert_equal 5.gigabytes, plan.storage_limit
+    assert_not plan.free?
+    assert plan.paid?
+    assert plan.unlimited_cards?
+  end
+
+  test "unlimited+ plan properties" do
+    plan = Plan[:monthly_extra_storage_v1]
+
+    assert_equal :monthly_extra_storage_v1, plan.key
+    assert_equal "Unlimited+", plan.name
+    assert_equal 25, plan.price
+    assert_equal Float::INFINITY, plan.card_limit
+    assert_equal 500.gigabytes, plan.storage_limit
+    assert_not plan.free?
+    assert plan.paid?
+    assert plan.unlimited_cards?
+  end
+
+  test "lookup by key and stripe price id" do
+    assert_equal Plan.free, Plan[:free_v1]
+    assert_equal Plan.free, Plan["free_v1"]
+    assert_equal Plan.paid, Plan[:monthly_v1]
+    assert_equal Plan.unlimited_plus, Plan[:monthly_extra_storage_v1]
+
+    assert_equal Plan.paid, Plan.find_by_price_id(Plan.paid.stripe_price_id)
+    assert_equal Plan.unlimited_plus, Plan.find_by_price_id(Plan.unlimited_plus.stripe_price_id)
+    assert_nil Plan.find_by_price_id("price_unknown")
+    assert_nil Plan.find_by_price_id(nil)
+  end
+end
