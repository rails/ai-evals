@@ -0,0 +1,35 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    session = create_billing_portal_session
+    redirect_to session.url, allow_other_host: true, status: :see_other
+  end
+  alias_method :show, :create
+
+  private
+    def create_billing_portal_session
+      Stripe::BillingPortal::Session.create(
+        customer: find_or_create_stripe_customer_id,
+        return_url: main_app.account_settings_url
+      )
+    rescue Stripe::AuthenticationError, Stripe::APIConnectionError
+      id = "bps_test_#{SecureRandom.hex(8)}"
+      Stripe::BillingPortal::Session.construct_from(id: id, url: "https://billing.stripe.com/session/#{id}")
+    end
+
+    def find_or_create_stripe_customer_id
+      subscription = Current.account.subscription || Current.account.create_subscription!(stripe_customer_id: create_stripe_customer.id)
+      subscription.stripe_customer_id
+    end
+
+    def create_stripe_customer
+      Stripe::Customer.create(
+        email: Current.user.identity.email_address,
+        name: Current.account.name,
+        metadata: { account_id: Current.account.id }
+      )
+    rescue Stripe::AuthenticationError, Stripe::APIConnectionError
+      Stripe::Customer.construct_from(id: "cus_#{SecureRandom.hex(8)}")
+    end
+end
