new file mode 100644
index 0000000..0f29262
--- /dev/null
+++ b/saas/app/models/account/limited.rb
@@ -0,0 +1,47 @@
+module Account::Limited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+    alias_method :overridden_limit, :overridden_limits
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards_count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def cards_remaining
+    [ card_limit - card_count, 0 ].max
+  end
+  alias_method :cards_left, :cards_remaining
+
+  def exceeding_card_limit?
+    card_count >= card_limit
+  end
+  alias_method :out_of_cards?, :exceeding_card_limit?
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+
+  def nearing_card_limit?
+    !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    limits = overridden_limits || build_overridden_limits
+    limits.update!(card_count: card_count.presence, bytes_used: bytes_used.presence)
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy
+    self.overridden_limits = nil
+  end
+end
