+          <% if @account.comped? %>
+            (Comped)
+          <% end %>
+        </div>
+      </header>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account, script_name: request.script_name.presence), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account, script_name: request.script_name.presence), method: :delete, class: "btn" %>
