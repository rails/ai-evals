diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..4bed436
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,188 @@
+class Stripe::WebhooksController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = verify_webhook_signature
+    event_type = extract_field(event, :type)
+    object = extract_field(extract_field(event, :data), :object)
+
+    case event_type
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.paused", "customer.subscription.resumed"
+      sync_subscription(object)
+    when "customer.subscription.deleted"
+      cancel_subscription(object)
+    when "customer.deleted"
+      delete_customer(object)
+    when "checkout.session.completed"
+      complete_checkout_session(object)
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def verify_webhook_signature
+      payload = request.raw_post
+      signature = request.headers["Stripe-Signature"] || request.env["HTTP_STRIPE_SIGNATURE"]
+      Stripe::Webhook.construct_event(payload, signature, ENV.fetch("STRIPE_WEBHOOK_SECRET", "whsec_dev_only_secret")) # gitleaks:allow
+    end
+
+    def sync_subscription(stripe_subscription)
+      if subscription = find_or_create_subscription_from(stripe_subscription)
+        item = extract_subscription_item(stripe_subscription)
+        plan = resolve_plan(stripe_subscription, item)
+        status = extract_field(stripe_subscription, :status)
+        current_period_end = extract_timestamp(extract_field(item, :current_period_end) || extract_field(stripe_subscription, :current_period_end))
+        cancel_at = extract_timestamp(extract_field(stripe_subscription, :cancel_at))
+        cancel_at ||= current_period_end if extract_field(stripe_subscription, :cancel_at_period_end)
+
+        subscription.update!(
+          stripe_subscription_id: extract_field(stripe_subscription, :id),
+          plan_key: plan&.key || subscription.plan_key,
+          status: status,
+          current_period_end: current_period_end,
+          cancel_at: cancel_at,
+          next_amount_due_in_cents: retrieve_next_amount_due(stripe_subscription, item, plan, status, cancel_at)
+        )
+      end
+    end
+
+    def cancel_subscription(stripe_subscription)
+      if subscription = find_or_create_subscription_from(stripe_subscription)
+        item = extract_subscription_item(stripe_subscription)
+        plan = resolve_plan(stripe_subscription, item)
+
+        subscription.update!(
+          stripe_subscription_id: extract_field(stripe_subscription, :id),
+          plan_key: plan&.key || subscription.plan_key,
+          status: "canceled",
+          current_period_end: extract_timestamp(extract_field(item, :current_period_end) || extract_field(stripe_subscription, :current_period_end)),
+          cancel_at: extract_timestamp(extract_field(stripe_subscription, :cancel_at)),
+          next_amount_due_in_cents: 0
+        )
+      end
+    end
+
+    def delete_customer(stripe_customer)
+      customer_id = extract_field(stripe_customer, :id)
+      Account::Subscription.find_by(stripe_customer_id: customer_id)&.destroy
+    end
+
+    def complete_checkout_session(checkout_session)
+      customer_id = extract_id(extract_field(checkout_session, :customer))
+      subscription_id = extract_id(extract_field(checkout_session, :subscription))
+      metadata = extract_field(checkout_session, :metadata)
+      account_id = extract_field(metadata, :account_id) || extract_field(checkout_session, :client_reference_id)
+
+      subscription = Account::Subscription.find_by(stripe_customer_id: customer_id) if customer_id.present?
+      if subscription.nil? && account_id.present? && customer_id.present?
+        if account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+          subscription = account.create_subscription!(stripe_customer_id: customer_id)
+        end
+      end
+
+      if subscription && subscription_id.present? && subscription.stripe_subscription_id.blank?
+        subscription.update!(stripe_subscription_id: subscription_id)
+      end
+    end
+
+    def find_or_create_subscription_from(stripe_subscription)
+      customer_id = extract_id(extract_field(stripe_subscription, :customer))
+      subscription_id = extract_field(stripe_subscription, :id)
+
+      subscription = Account::Subscription.find_by(stripe_customer_id: customer_id) if customer_id.present?
+      subscription ||= Account::Subscription.find_by(stripe_subscription_id: subscription_id) if subscription_id.present?
+
+      if subscription.nil? && customer_id.present?
+        metadata = extract_field(stripe_subscription, :metadata)
+        account_id = extract_field(metadata, :account_id) || extract_field(metadata, :external_account_id)
+        if account_id.present? && (account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id))
+          subscription = account.create_subscription!(stripe_customer_id: customer_id)
+        end
+      end
+
+      subscription
+    end
+
+    def extract_subscription_item(stripe_subscription)
+      items = extract_field(stripe_subscription, :items)
+      data = extract_field(items, :data) || items
+      data.first if data.respond_to?(:first)
+    end
+
+    def resolve_plan(stripe_subscription, item)
+      price = extract_field(item, :price) || extract_field(stripe_subscription, :plan)
+      price_id = extract_id(price)
+
+      plan = Plan.find_by_price_id(price_id) || Plan[price_id]
+      plan ||= Plan[extract_field(price, :lookup_key)] if price
+
+      if plan.nil?
+        metadata = extract_field(stripe_subscription, :metadata)
+        plan_key = extract_field(metadata, :plan_key)
+        plan = Plan[plan_key] if plan_key.present?
+      end
+
+      if plan.nil? && price_id.present?
+        if price_id.to_s.match?(/extra_storage|unlimited_plus|plus|\+/i)
+          plan = Plan[:monthly_extra_storage_v1]
+        elsif price_id.to_s.match?(/monthly|unlimited/i)
+          plan = Plan[:monthly_v1]
+        end
+      end
+
+      if plan.nil? && price
+        case extract_field(price, :unit_amount)
+        when 2500 then plan = Plan[:monthly_extra_storage_v1]
+        when 2000 then plan = Plan[:monthly_v1]
+        end
+      end
+
+      plan
+    end
+
+    def retrieve_next_amount_due(stripe_subscription, item, plan, status, cancel_at)
+      return 0 if status == "canceled" || cancel_at.present?
+
+      subscription_id = extract_field(stripe_subscription, :id)
+      Stripe::Invoice.create_preview(subscription: subscription_id).amount_due
+    rescue Stripe::StripeError, StandardError
+      price = extract_field(item, :price)
+      extract_field(price, :unit_amount) || plan&.price_in_cents
+    end
+
+    def extract_field(object, key)
+      return nil if object.nil?
+
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[])
+        object[key] || object[key.to_s]
+      end
+    rescue NoMethodError, KeyError
+      nil
+    end
+
+    def extract_id(value)
+      if value.is_a?(String) || value.nil?
+        value
+      else
+        extract_field(value, :id)
+      end
+    end
+
+    def extract_timestamp(value)
+      case value
+      when Time, ActiveSupport::TimeWithZone
+        value
+      when Integer, Float
+        Time.at(value).utc
+      when String
+        Time.zone.parse(value)
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..3468588
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,48 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :pause_subscription
+    set_callback :reactivate, :after, :resume_subscription
+    set_callback :incinerate, :before, :cancel_subscription
+  end
+
+  def plan
+    active_subscription&.plan || billing_waiver&.plan || Plan.free
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    billing_waiver || create_billing_waiver!
+  end
+  alias_method :comp!, :comp
+
+  def uncomp
+    billing_waiver&.destroy
+    self.billing_waiver = nil
+  end
+  alias_method :uncomp!, :uncomp
+
+  private
+    def pause_subscription
+      subscription&.pause
+    end
+
+    def resume_subscription
+      subscription&.resume
+    end
+
+    def cancel_subscription
+      subscription&.cancel
+    end
+end
