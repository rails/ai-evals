diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..edf1aa1
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,49 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  enum :status, %w[
+    active past_due unpaid canceled incomplete incomplete_expired trialing paused
+  ].index_by(&:itself)
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  delegate :name, :price, :card_limit, :storage_limit, to: :plan, prefix: true
+
+  def plan
+    Plan[plan_key] || Plan.free
+  end
+
+  def plan=(plan)
+    self.plan_key = plan&.key
+  end
+
+  def to_be_canceled?
+    active? && cancel_at.present?
+  end
+  alias_method :canceling?, :to_be_canceled?
+
+  def pause
+    if stripe_subscription_id.present?
+      Stripe::Subscription.update(stripe_subscription_id, pause_collection: { behavior: "void" })
+    end
+  rescue Stripe::AuthenticationError
+    nil
+  end
+
+  def resume
+    if stripe_subscription_id.present?
+      Stripe::Subscription.update(stripe_subscription_id, pause_collection: "")
+    end
+  rescue Stripe::AuthenticationError
+    nil
+  end
+
+  def cancel
+    if stripe_subscription_id.present?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+    end
+  rescue Stripe::AuthenticationError
+    nil
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..8b3ec70
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,112 @@
+class Plan
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  class << self
+    def all
+      PLANS.values
+    end
+
+    def free
+      PLANS[:free_v1]
+    end
+
+    def paid
+      PLANS[:monthly_v1]
+    end
+    alias_method :unlimited, :paid
+
+    def unlimited_plus
+      PLANS[:monthly_extra_storage_v1]
+    end
+    alias_method :extra_storage, :unlimited_plus
+
+    def [](key)
+      return nil if key.blank?
+
+      PLANS[key] || PLANS[ALIASES[key]]
+    end
+    alias_method :find, :[]
+
+    def find_by_price_id(price_id)
+      if price_id.present?
+        all.find { |plan| plan.stripe_price_id == price_id }
+      end
+    end
+    alias_method :by_stripe_price_id, :find_by_price_id
+    alias_method :find_by_stripe_price_id, :find_by_price_id
+  end
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, stripe_price_id: nil, env_keys: [])
+    @key = key.to_sym
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_id = stripe_price_id
+    @env_keys = env_keys
+  end
+
+  def stripe_price_id
+    @env_keys.lazy.filter_map { |env_key| ENV[env_key].presence }.first || @stripe_price_id
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit == Float::INFINITY
+  end
+
+  def price_in_cents
+    price * 100
+  end
+
+  def to_param
+    key.to_s
+  end
+
+  PLANS = {
+    free_v1: new(
+      key: :free_v1,
+      name: "Free",
+      price: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte
+    ),
+    monthly_v1: new(
+      key: :monthly_v1,
+      name: "Unlimited",
+      price: 20,
+      card_limit: Float::INFINITY,
+      storage_limit: 5.gigabytes,
+      stripe_price_id: ENV.fetch("STRIPE_MONTHLY_V1_PRICE_ID", "price_monthly_v1"),
+      env_keys: %w[ STRIPE_MONTHLY_V1_PRICE_ID STRIPE_UNLIMITED_PRICE_ID STRIPE_UNLIMITED_V1_PRICE_ID ]
+    ),
+    monthly_extra_storage_v1: new(
+      key: :monthly_extra_storage_v1,
+      name: "Unlimited+",
+      price: 25,
+      card_limit: Float::INFINITY,
+      storage_limit: 500.gigabytes,
+      stripe_price_id: ENV.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID", "price_monthly_extra_storage_v1"),
+      env_keys: %w[ STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID STRIPE_UNLIMITED_PLUS_PRICE_ID STRIPE_UNLIMITED_PLUS_V1_PRICE_ID ]
+    )
+  }.with_indifferent_access.freeze
+
+  ALIASES = {
+    free: :free_v1,
+    "Free" => :free_v1,
+    unlimited: :monthly_v1,
+    unlimited_v1: :monthly_v1,
+    "Unlimited" => :monthly_v1,
+    unlimited_plus: :monthly_extra_storage_v1,
+    unlimited_plus_v1: :monthly_extra_storage_v1,
+    extra_storage: :monthly_extra_storage_v1,
+    "Unlimited+" => :monthly_extra_storage_v1
+  }.with_indifferent_access.freeze
+end
