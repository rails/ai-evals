@@ -0,0 +1,27 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  def change
+    reversible do |dir|
+      dir.down do
+        User.reset_column_information
+        Book.reset_column_information
+      end
+    end
+
+    create_table :tenants, if_not_exists: true do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, if_not_exists: true
+    add_reference :books, :tenant, if_not_exists: true
+
+    up_only do
+      User.reset_column_information
+      Book.reset_column_information
+
+      tenant = Tenant.first || Tenant.create!(name: Account.pick(:name) || "Default")
+      User.update_all(tenant_id: tenant.id)
+      Book.update_all(tenant_id: tenant.id)
+    end
+  end
+end
