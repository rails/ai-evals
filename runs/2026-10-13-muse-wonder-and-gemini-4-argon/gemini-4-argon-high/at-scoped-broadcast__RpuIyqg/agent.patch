diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..ac982de 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,31 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "update broadcasts being edited indicator only to current editors" do
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :success
+    kevin_stream = verified_stream_name(css_select("turbo-cable-stream-source").first["signed-stream-name"])
+
+    sign_in :jason
+    get edit_leafable_path(leaves(:welcome_page))
+    assert_response :success
+    jason_stream = verified_stream_name(css_select("turbo-cable-stream-source").first["signed-stream-name"])
+
+    books(:handbook).update_access(editors: [ users(:david).id, users(:jason).id ], readers: [])
+
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:welcome_page)), params: { page: { body: "Updated by David." } }
+    end
+    assert_response :no_content
+
+    assert_no_turbo_stream_broadcasts kevin_stream
+
+    streams = capture_turbo_stream_broadcasts jason_stream
+    assert_equal 1, streams.size
+    assert_equal "append", streams.first["action"]
+    assert_equal dom_id(leaves(:welcome_page), :being_edited), streams.first["target"]
+    assert_includes streams.first.to_html, users(:david).name
+  end
 end
