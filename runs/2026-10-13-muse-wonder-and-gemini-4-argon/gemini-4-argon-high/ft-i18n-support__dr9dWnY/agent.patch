diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 53fa055..09ee0f3 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,6 +1,64 @@
 module TimeHelper
   def local_datetime_tag(datetime, style: :time, **attributes)
-    # Render empty space to ensure it takes height until the local time is loaded via JS
-    tag.time "&nbsp;".html_safe, **attributes, datetime: datetime.to_i, data: { local_time_target: style, action: "turbo:morph-element->local-time#refreshTarget" }
+    content = if I18n.locale == :en
+      "&nbsp;".html_safe
+    else
+      localized_datetime_content(datetime, style)
+    end
+
+    tag.time content, **attributes, datetime: datetime.to_i, data: { local_time_target: style, action: "turbo:morph-element->local-time#refreshTarget" }
   end
+
+  private
+    def localized_datetime_content(datetime, style)
+      time = datetime.in_time_zone
+      today = Time.zone.today
+
+      case style.to_sym
+      when :time
+        I18n.l(time, format: :time, default: "%H:%M")
+      when :date
+        I18n.l(time.to_date, format: :long)
+      when :datetime
+        I18n.l(time, format: :short)
+      when :shortdate
+        I18n.l(time.to_date, format: :short)
+      when :ago
+        "#{time_ago_in_words(time)}#{I18n.t("datetime.relative.past_suffix", default: "前")}"
+      when :daysago
+        days = (today - time.to_date).to_i
+        if days <= 0
+          tag.span(I18n.t("datetime.relative.today", default: "今日"), class: "local-time-value")
+        elsif days == 1
+          tag.span(I18n.t("datetime.relative.yesterday", default: "昨日"), class: "local-time-value")
+        else
+          safe_join([ tag.span(days, class: "local-time-value"), I18n.t("datetime.relative.days_ago_suffix", default: "日前") ])
+        end
+      when :agoorweekday
+        days = (today - time.to_date).to_i
+        if days <= 1
+          localized_datetime_content(datetime, :daysago)
+        else
+          I18n.l(time.to_date, format: :with_weekday, default: "%-m月%-d日(%a)")
+        end
+      when :indays
+        days = (time.to_date - today).to_i
+        if days <= 0
+          tag.span(I18n.t("datetime.relative.today", default: "今日"), class: "local-time-value")
+        elsif days == 1
+          tag.span(I18n.t("datetime.relative.tomorrow", default: "明日"), class: "local-time-value")
+        else
+          safe_join([ tag.span(days, class: "local-time-value"), I18n.t("datetime.relative.in_days_suffix", default: "日後") ])
+        end
+      when :timeordate
+        days = (today - time.to_date).to_i
+        if days >= 1
+          I18n.l(time.to_date, format: :short)
+        else
+          I18n.l(time, format: :time, default: "%H:%M")
+        end
+      else
+        I18n.l(time, format: :short)
+      end
+    end
 end
