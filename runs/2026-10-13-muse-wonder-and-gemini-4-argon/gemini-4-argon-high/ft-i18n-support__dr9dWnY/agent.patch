diff --git a/test/integration/internationalization_test.rb b/test/integration/internationalization_test.rb
new file mode 100644
index 0000000..2682905
--- /dev/null
+++ b/test/integration/internationalization_test.rb
@@ -0,0 +1,410 @@
+require "test_helper"
+
+class InternationalizationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @identity = identities(:david)
+    @user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @column = columns(:writebook_triage)
+    @comment = @card.comments.create!(creator: @user, body: "Test comment")
+  end
+
+  test "default locale is English and pages render English as before" do
+    sign_in_as :david
+
+    get board_path(@board)
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "a.header__skip-navigation", text: "Skip to main content"
+    assert_select "span", text: "Add a card"
+  end
+
+  test "switching to Japanese with ?locale=ja persists across session and clean browser sign-in" do
+    sign_in_as :david
+
+    get board_path(@board, locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+    assert_select "span", text: "カードを追加"
+    assert_equal "ja", @identity.reload.locale
+
+    # Subsequent request in the same session without ?locale param stays in Japanese
+    get card_path(@card)
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "span", text: "完了にする"
+
+    # Signing in from a clean browser (new session) remembers Japanese
+    open_session do |clean_browser|
+      clean_browser.post session_path(script_name: nil), params: { email_address: @identity.email_address }
+      magic_link = @identity.magic_links.order(id: :desc).first
+      clean_browser.post session_magic_link_url(script_name: nil), params: { code: magic_link.code }
+
+      clean_browser.get board_path(@board, script_name: @account.slug)
+      clean_browser.assert_response :success
+      clean_browser.assert_select "html[lang='ja']"
+      clean_browser.assert_select "span", text: "カードを追加"
+    end
+  end
+
+  test "choosing ?locale=ja before signing in persists for session and after sign-in" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", text: "Fizzyにサインイン"
+
+      post session_path, params: { email_address: @identity.email_address }
+      follow_redirect!
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", text: "メールを確認してください"
+
+      magic_link = @identity.magic_links.order(id: :desc).first
+      post session_magic_link_url, params: { code: magic_link.code }
+    end
+
+    assert_equal "ja", @identity.reload.locale
+
+    get board_path(@board)
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "unsupported locale ?locale=xx never breaks a page and does not switch locale" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang='en']"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+
+    @controller = nil
+    sign_in_as :david
+    get board_path(@board, locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+
+    get board_path(@board, locale: "xx")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", @identity.reload.locale
+  end
+
+  test "every screen renders in Japanese with no leftover English UI or screen reader text" do
+    @user.update!(role: :owner)
+    @board.publish unless @board.published?
+    second_account = Account.create!(name: "Tokyo Account")
+    second_account.users.create!(identity: @identity, role: :member, name: @user.name)
