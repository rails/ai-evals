+    def locale_from_args(args, kwargs = {})
+      all_args = kwargs.any? ? [ *args, kwargs ] : args
+
+      all_args.each do |arg|
+        recipient = case arg
+        when Identity, User then arg
+        when Hash then arg[:user] || arg[:identity]
+        else
+          if arg.respond_to?(:user)
+            arg.user
+          elsif arg.respond_to?(:identity)
