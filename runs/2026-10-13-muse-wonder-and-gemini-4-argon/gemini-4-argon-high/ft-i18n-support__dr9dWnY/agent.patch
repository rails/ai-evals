diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..eac2fb8
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,42 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :set_current_locale
+
+    etag { I18n.locale }
+    view_cache_dependency { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&)
+      I18n.with_locale(resolve_locale, &)
+    end
+
+    def resolve_locale
+      identity = Current.identity || Session.find_signed(cookies.signed[:session_token])&.identity
+
+      if locale = available_locale(params[:locale])
+        session[:locale] = locale
+        if identity
+          identity.update!(locale: locale) if identity.locale != locale
+          session.delete(:unauthenticated_locale)
+        else
+          session[:unauthenticated_locale] = locale
+        end
+        locale
+      elsif locale = available_locale(identity&.locale)
+        session[:locale] = locale
+        locale
+      elsif locale = available_locale(session[:locale])
+        locale
+      else
+        I18n.default_locale
+      end
+    end
+
+    def available_locale(locale)
+      locale_str = locale.to_s
+      locale_str if locale_str.present? && I18n.locale_available?(locale_str)
+    end
+end
