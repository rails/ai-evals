index 0000000..bdc2b09
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    due_account = accounts(:"37s")
+    recent_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    due_account.cancel(initiated_by: users(:david))
+    due_account.cancellation.update!(created_at: 31.days.ago)
+
+    recent_account.cancel(initiated_by: users(:mike))
+    recent_account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_changes -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..b583b3b
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration scope includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel_to 31.days.from_now do
+      assert_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "due_for_incineration scope excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes recently cancelled accounts" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel_to 29.days.from_now do
+      assert_not_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "due_for_incineration? returns true only when cancelled before grace period" do
+    freeze_time do
+      assert_not @account.due_for_incineration?
+
+      @account.cancel(initiated_by: @user)
+      assert_not @account.due_for_incineration?
+
+      travel Account::Incineratable::INCINERATION_GRACE_PERIOD
+      assert_not @account.due_for_incineration?
+
+      travel 1.second
+      assert @account.due_for_incineration?
+    end
+  end
+
+  test "incinerate destroys account and all associated data" do
+    account_id = @account.id
+    other_account = accounts(:initech)
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_1)
+
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    card.steps.create!(content: "Step 1")
+    Card::ActivitySpike.find_or_create_by!(card: card, account: @account)
+    cards(:layout).postpone(user: @user)
+    board.publish
+    @user.remember_search("logo")
+    @user.notification_bundles.create!(starts_at: 2.days.ago, ends_at: 2.days.ago + 1.hour)
+    card.reindex
+    comment.reindex
+    @account.materialize_storage
+    board.materialize_storage
+    @account.cancel(initiated_by: @user)
+
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+    assert_empty Account::Cancellation.where(account_id: account_id)
+    assert_empty Account::JoinCode.where(account_id: account_id)
+    assert_empty User.where(account_id: account_id)
+    assert_empty User::Settings.where(account_id: account_id)
+    assert_empty Board.where(account_id: account_id)
+    assert_empty Board::Publication.where(account_id: account_id)
+    assert_empty Column.where(account_id: account_id)
+    assert_empty Card.where(account_id: account_id)
+    assert_empty Card::Goldness.where(account_id: account_id)
+    assert_empty Card::NotNow.where(account_id: account_id)
+    assert_empty Card::ActivitySpike.where(account_id: account_id)
+    assert_empty Comment.where(account_id: account_id)
+    assert_empty Step.where(account_id: account_id)
+    assert_empty Assignment.where(account_id: account_id)
+    assert_empty Closure.where(account_id: account_id)
+    assert_empty Tag.where(account_id: account_id)
+    assert_empty Tagging.where(account_id: account_id)
+    assert_empty Watch.where(account_id: account_id)
+    assert_empty Pin.where(account_id: account_id)
+    assert_empty Reaction.where(account_id: account_id)
+    assert_empty Mention.where(account_id: account_id)
+    assert_empty Event.where(account_id: account_id)
+    assert_empty Notification.where(account_id: account_id)
+    assert_empty Notification::Bundle.where(account_id: account_id)
+    assert_empty Filter.where(account_id: account_id)
+    assert_empty Access.where(account_id: account_id)
+    assert_empty Entropy.where(account_id: account_id)
+    assert_empty Export.where(account_id: account_id)
+    assert_empty Webhook.where(account_id: account_id)
+    assert_empty Webhook::Delivery.where(account_id: account_id)
+    assert_empty Webhook::DelinquencyTracker.where(account_id: account_id)
+    assert_empty Search::Query.where(account_id: account_id)
+    assert_empty Search::Record.for(account_id).where(account_id: account_id)
+    assert_empty ActionText::RichText.where(account_id: account_id)
+    assert_empty ActiveStorage::Attachment.where(account_id: account_id)
+    assert_empty Storage::Entry.where(account_id: account_id)
+    assert_empty Storage::Total.where(owner_id: account_id)
+
+    assert Account.exists?(other_account.id)
+    assert Identity.exists?(@user.identity_id)
+  end
+end
