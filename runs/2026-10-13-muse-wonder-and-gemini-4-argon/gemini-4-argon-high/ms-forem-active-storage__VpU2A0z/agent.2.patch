@@ -103,8 +112,140 @@ def legacy_profile_image_uploader
     uploader
   end
 
+  def copy_legacy_profile_image_to_active_storage!
+    if profile_image_already_copied?
+      refresh_cached_profile_image_on_articles
+      return false
+    end
+
+    return false unless legacy_profile_image_present?
+    return false unless attach_from_legacy_profile_image
+
+    ProfileImageAttachable.bump_copy_generation!
+    refresh_cached_profile_image_on_articles
+    true
+  end
+
   private
 
+  def sync_profile_image_attachment_after_copy
+    current_gen = ProfileImageAttachable.copy_generation
+    return if @profile_image_copy_generation == current_gen
+
+    if persisted? && attachment_changes["profile_image"].blank? && association(:profile_image_attachment).loaded?
+      association(:profile_image_attachment).reset
+      association(:profile_image_blob).reset
+    end
+    @profile_image_copy_generation = current_gen
+  end
+
+  def profile_image_already_copied?
+    return false unless profile_image.attached?
+
+    blob = profile_image.blob
+    blob.present? && blob.service.exist?(blob.key)
+  end
+
+  def attach_from_legacy_profile_image
+    uploader = legacy_profile_image_uploader
+    local_path = resolve_legacy_profile_image_local_path(uploader)
+
+    if local_path
+      attach_legacy_profile_image_from_path(local_path, uploader)
+    elsif legacy_uploader_file_exists?(uploader)
+      attach_legacy_profile_image_from_uploader_file(uploader)
+    else
+      false
+    end
+  end
+
+  def resolve_legacy_profile_image_local_path(uploader)
+    raw_value = self[:profile_image].to_s
+    candidates = [
+      uploader.path,
+      File.join(CarrierWave.root.to_s, uploader.store_dir, File.basename(raw_value)),
+      Rails.public_path.join(raw_value.delete_prefix("/")).to_s,
+    ].compact.uniq
+
+    candidates.detect { |candidate| candidate.present? && File.file?(candidate) }
+  end
+
+  def legacy_uploader_file_exists?(uploader)
+    uploader.file.present? && uploader.file.respond_to?(:exists?) && uploader.file.exists?
+  end
+
+  def attach_legacy_profile_image_from_path(local_path, uploader)
+    filename = File.basename(local_path)
+    content_type = uploader.content_type.presence || Marcel::MimeType.for(Pathname.new(local_path), name: filename)
+    File.open(local_path, "rb") do |io|
+      attach_legacy_profile_image_io(io, filename: filename, content_type: content_type)
+    end
+    true
+  end
+
+  def attach_legacy_profile_image_from_uploader_file(uploader)
+    data = uploader.file.read
+    return false if data.nil?
+
+    filename = if uploader.file.respond_to?(:filename) && uploader.file.filename.present?
+                 uploader.file.filename
+               else
+                 File.basename(self[:profile_image].to_s)
+               end
+    content_type = uploader.content_type.presence || Marcel::MimeType.for(StringIO.new(data), name: filename)
+    attach_legacy_profile_image_io(StringIO.new(data), filename: filename, content_type: content_type)
+    true
+  end
+
+  def attach_legacy_profile_image_io(io, filename:, content_type:)
+    attached = profile_image.attach(
+      io: io,
+      filename: filename,
+      content_type: content_type,
+    )
+
+    if attached && profile_image.attached?
+      ensure_blob_uploaded(io)
+    else
+      force_attach_legacy_profile_image_io(io, filename: filename, content_type: content_type)
+    end
+  end
+
+  def ensure_blob_uploaded(io)
+    return unless profile_image.blob.present? && !profile_image.blob.service.exist?(profile_image.blob.key)
+
+    io.rewind
+    profile_image.blob.upload_without_unfurling(io)
+    attachment_changes.delete("profile_image")
+  end
+
+  def force_attach_legacy_profile_image_io(io, filename:, content_type:)
+    io.rewind
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: io,
+      filename: filename,
+      content_type: content_type,
+    )
+    errors.clear
+    attachment_changes.delete("profile_image")
+    if profile_image_attachment.present?
+      profile_image_attachment.update!(blob: blob)
+    else
+      ActiveStorage::Attachment.create!(name: "profile_image", record: self, blob: blob)
+    end
+    reload
+  end
+
+  def refresh_cached_profile_image_on_articles
+    return unless defined?(Article) && defined?(Articles::CachedEntity) && respond_to?(:articles)
+
+    column = is_a?(Organization) ? :cached_organization : :cached_user
+    articles.find_each do |article|
+      cached = Articles::CachedEntity.from_object(self)
+      article.update_column(column, cached) if article.public_send(column) != cached
+    end
+  end
+
   def active_storage_profile_image_url
     if profile_image.blob.persisted?
       Rails.application.routes.url_helpers.rails_blob_path(profile_image, only_path: true)
diff --git a/lib/tasks/profile_images.rake b/lib/tasks/profile_images.rake
new file mode 100644
index 0000000..32d3716
--- /dev/null
+++ b/lib/tasks/profile_images.rake
@@ -0,0 +1,12 @@
+namespace :profile_images do
+  desc "Copy existing CarrierWave profile pictures of users and organizations into Active Storage"
+  task copy: :environment do |task|
+    [User, Organization].each do |model|
+      next unless model.column_names.include?("profile_image")
+
+      model.unscoped.where.not(profile_image: [nil, ""]).find_each(&:copy_legacy_profile_image_to_active_storage!)
+    end
+  ensure
+    task.reenable
+  end
+end
