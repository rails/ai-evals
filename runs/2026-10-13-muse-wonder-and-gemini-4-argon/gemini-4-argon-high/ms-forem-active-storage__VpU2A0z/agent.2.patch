diff --git a/spec/tasks/profile_images_spec.rb b/spec/tasks/profile_images_spec.rb
new file mode 100644
index 0000000..c82ae64
--- /dev/null
+++ b/spec/tasks/profile_images_spec.rb
@@ -0,0 +1,120 @@
+require "rails_helper"
+
+RSpec.describe "profile_images:copy", type: :task do
+  let(:user_image_path) { Rails.root.join("spec/support/fixtures/images/image1.jpeg") }
+  let(:org_image_path) { Rails.root.join("app/assets/images/android-icon-36x36.png") }
+
+  def store_legacy_carrierwave_image(record, source_path, content_type)
+    record.profile_image.purge if record.profile_image.attached?
+    uploader = ProfileImageUploader.new(record, :profile_image)
+    uploader.store!(Rack::Test::UploadedFile.new(source_path, content_type))
+    record.update_column(:profile_image, uploader.filename)
+    uploader
+  end
+
+  before do
+    Rake::Task["profile_images:copy"].reenable
+  end
+
+  it "copies existing user and organization CarrierWave profile images into Active Storage", :aggregate_failures do
+    legacy_user = create(:user, profile_image: nil)
+    user_uploader = store_legacy_carrierwave_image(legacy_user, user_image_path, "image/jpeg")
+
+    legacy_org = create(
+      :organization,
+      cover_image: fixture_file_upload("800x600.jpg", "image/jpeg"),
+    )
+    org_uploader = store_legacy_carrierwave_image(legacy_org, org_image_path, "image/png")
+
+    article = create(:article, user: legacy_user, organization: legacy_org)
+    expect(article.cached_user.profile_image_url).to eq(user_uploader.url)
+    expect(article.cached_organization.profile_image_url).to eq(org_uploader.url)
+
+    expect(legacy_user.profile_image).not_to be_attached
+    expect(legacy_user.profile_image_url).to eq(user_uploader.url)
+    expect(legacy_org.profile_image).not_to be_attached
+    expect(legacy_org.profile_image_url).to eq(org_uploader.url)
+
+    Rake::Task["profile_images:copy"].invoke
+
+    expect(legacy_user.profile_image).to be_attached
+    expect(legacy_user.profile_image_url).to start_with("/rails/active_storage/blobs/")
+    expect(legacy_user.profile_image.download).to eq(File.binread(user_image_path))
+
+    expect(legacy_org.profile_image).to be_attached
+    expect(legacy_org.profile_image_url).to start_with("/rails/active_storage/blobs/")
+    expect(legacy_org.profile_image.download).to eq(File.binread(org_image_path))
+    expect(legacy_org.cover_image_url).to start_with("/uploads/organization/cover_image/#{legacy_org.id}/")
+
+    article.reload
+    expect(article.cached_user.profile_image_url).to eq(legacy_user.profile_image_url)
+    expect(article.cached_organization.profile_image_url).to eq(legacy_org.profile_image_url)
+  ensure
+    user_uploader&.remove!
+    org_uploader&.remove!
+  end
+
+  it "resumes cleanly after being interrupted without duplicating already-copied images", :aggregate_failures do
+    user_one = create(:user, profile_image: nil)
+    uploader_one = store_legacy_carrierwave_image(user_one, user_image_path, "image/jpeg")
+
+    user_two = create(:user, profile_image: nil)
+    uploader_two = store_legacy_carrierwave_image(user_two, org_image_path, "image/png")
+
+    legacy_org = create(:organization)
+    org_uploader = store_legacy_carrierwave_image(legacy_org, org_image_path, "image/png")
+
+    call_count = 0
+    allow(ProfileImageAttachable).to receive(:bump_copy_generation!).and_wrap_original do |method, *args|
+      call_count += 1
+      method.call(*args)
+      raise StandardError, "Simulated interruption" if call_count == 1
+    end
+
+    expect { Rake::Task["profile_images:copy"].invoke }.to raise_error(StandardError, "Simulated interruption")
+
+    # While interrupted, the copied user is served from Active Storage and uncopied records remain visible
+    expect(user_one.reload.profile_image).to be_attached
+    expect(user_one.profile_image_url).to start_with("/rails/active_storage/blobs/")
+    first_blob_id = user_one.profile_image.blob.id
+
+    expect(user_two.reload.profile_image).not_to be_attached
+    expect(user_two.profile_image_url).to eq(uploader_two.url)
+    expect(legacy_org.reload.profile_image).not_to be_attached
+    expect(legacy_org.profile_image_url).to eq(org_uploader.url)
+
+    allow(ProfileImageAttachable).to receive(:bump_copy_generation!).and_call_original
+
+    Rake::Task["profile_images:copy"].invoke
+
+    expect(user_one.reload.profile_image.blob.id).to eq(first_blob_id)
+    expect(user_two.reload.profile_image).to be_attached
+    expect(user_two.profile_image_url).to start_with("/rails/active_storage/blobs/")
+    expect(user_two.profile_image.download).to eq(File.binread(org_image_path))
+
+    expect(legacy_org.reload.profile_image).to be_attached
+    expect(legacy_org.profile_image_url).to start_with("/rails/active_storage/blobs/")
+    expect(legacy_org.profile_image.download).to eq(File.binread(org_image_path))
+  ensure
+    uploader_one&.remove!
+    uploader_two&.remove!
+    org_uploader&.remove!
+  end
+
+  it "does not overwrite a newer Active Storage profile image on a record with a legacy column", :aggregate_failures do
+    user = create(:user, profile_image: nil)
+    uploader = store_legacy_carrierwave_image(user, user_image_path, "image/jpeg")
+
+    user.update!(profile_image: fixture_file_upload("800x600.png", "image/png"))
+    expected_bytes = user.profile_image.download
+    expected_blob_id = user.profile_image.blob.id
+
+    Rake::Task["profile_images:copy"].invoke
+
+    user.reload
+    expect(user.profile_image.blob.id).to eq(expected_blob_id)
+    expect(user.profile_image.download).to eq(expected_bytes)
+  ensure
+    uploader&.remove!
+  end
+end
