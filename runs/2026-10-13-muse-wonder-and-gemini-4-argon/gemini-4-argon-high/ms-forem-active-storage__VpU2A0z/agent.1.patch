+++ b/spec/models/organization_spec.rb
@@ -618,4 +618,48 @@
       expect(organization.baseline_score).to eq(45)
     end
   end
+
+  describe "profile_image storage" do
+    it "stores new profile images in Active Storage while keeping cover_image on CarrierWave", :aggregate_failures do
+      org = create(
+        :organization,
+        profile_image: fixture_file_upload("800x600.png", "image/png"),
+        cover_image: fixture_file_upload("800x600.jpg", "image/jpeg"),
+      )
+
+      expect(org.profile_image).to be_attached
+      expect(org[:profile_image]).to be_nil
+      expect(org.profile_image_url).to start_with("/rails/active_storage/blobs/")
+      expect(org.cover_image).to be_a(CoverImageUploader)
+      expect(org.cover_image_url).to start_with("/uploads/organization/cover_image/#{org.id}/")
+    end
+
+    it "serves existing CarrierWave profile images and remains valid on update", :aggregate_failures do
+      legacy_org = create(:organization)
+      legacy_org.profile_image.purge
+      legacy_org.update_column(:profile_image, "legacy-org.png")
+      legacy_org.reload
+
+      expect(legacy_org.profile_image).not_to be_attached
+      expect(legacy_org.profile_image).to be_present
+      expect(legacy_org.profile_image_url).to eq("/uploads/organization/profile_image/#{legacy_org.id}/legacy-org.png")
+
+      legacy_org.update!(summary: "Updated summary")
+      expected_url = "/uploads/organization/profile_image/#{legacy_org.id}/legacy-org.png"
+      expect(legacy_org.reload.profile_image_url).to eq(expected_url)
+    end
+
+    it "uses Active Storage when an existing CarrierWave org uploads a new image", :aggregate_failures do
+      legacy_org = create(:organization)
+      legacy_org.profile_image.purge
+      legacy_org.update_column(:profile_image, "legacy-org.png")
+      legacy_org.reload
+
+      legacy_org.update!(profile_image: fixture_file_upload("800x600.png", "image/png"))
+
+      expect(legacy_org.profile_image).to be_attached
+      expect(legacy_org[:profile_image]).to eq("legacy-org.png")
+      expect(legacy_org.profile_image_url).to start_with("/rails/active_storage/blobs/")
+    end
