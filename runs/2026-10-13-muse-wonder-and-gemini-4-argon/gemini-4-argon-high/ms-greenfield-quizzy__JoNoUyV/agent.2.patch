@@ -0,0 +1,37 @@
+<% content_for :title, "Quizzy · Import quiz" %>
+<%= render "moderate/shared/header" %>
+
+<main class="admin-main">
+  <div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+  <div class="page-head">
+    <h1>Import quiz</h1>
+  </div>
+
+  <div class="card">
+    <%= form_with url: import_moderate_quizzes_path, method: :post, local: true do %>
+      <div class="field">
+        <label class="field-label" for="quiz_json">Quiz JSON</label>
+        <textarea class="input input--code" id="quiz_json" name="quiz_json" rows="12" aria-label="Quiz JSON" autofocus><%= @quiz_json %></textarea>
+      </div>
+
+      <% if @errors.present? %>
+        <div class="errors" role="alert">
+          <% if @errors.size == 1 %>
+            <%= @errors.first %>
+          <% else %>
+            <ul>
+              <% @errors.each do |msg| %>
+                <li><%= msg %></li>
+              <% end %>
+            </ul>
+          <% end %>
+        </div>
+      <% end %>
+
+      <div class="buttons">
+        <button type="submit" class="btn btn--pink">Import</button>
+        <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+      </div>
+    <% end %>
+  </div>
+</main>
