diff --git a/app/views/moderate/games/_screen.html.erb b/app/views/moderate/games/_screen.html.erb
new file mode 100644
index 0000000..d982741
--- /dev/null
+++ b/app/views/moderate/games/_screen.html.erb
@@ -0,0 +1,74 @@
+<section class="cover <%= game.waiting? ? '' : (game.finished? ? 'cover--night' : 'cover--blue cover--calm') %>">
+  <div class="screen">
+    <div class="screen__top">
+      <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= quiz.title %></span>
+    </div>
+
+    <div class="screen__body">
+      <% if game.waiting? %>
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= quiz.title %></h1>
+            <div class="lobby__join">Join at</div>
+            <div class="lobby__url"><%= join_url %></div>
+            <div class="counter-pill" id="players-counter"><span>Players: <strong><%= players_count %></strong></span></div>
+          </div>
+          <div class="qr" role="img" aria-label="QR code for <%= join_url %>" data-url="<%= join_url %>">
+            <%= qr_svg.html_safe %>
+          </div>
+        </div>
+      <% elsif game.question_open? || game.question_closed? %>
+        <div class="stage-question__num">Question <%= question_number %> of <%= total_questions %></div>
+        <div class="stage-question__body"><%= current_question.body %></div>
+        <ol class="stage-options <%= 'stage-options--results' if game.question_closed? %>">
+          <% options.each_with_index do |option, idx| %>
+            <% count = option_counts[option.id] || 0 %>
+            <% share = total_answers > 0 ? ((count.to_f / total_answers) * 100).round : 0 %>
+            <li class="stage-option <%= 'is-correct' if game.question_closed? && option.correct? %>">
+              <% if game.question_closed? %>
+                <span class="stage-option__bar" style="--share: <%= share %>%"></span>
+              <% end %>
+              <span class="stage-option__letter"><%= ("A".ord + idx).chr %></span>
+              <span class="stage-option__title"><%= option.text %></span>
+              <% if game.question_closed? %>
+                <% if option.correct? %>
+                  <span class="stage-option__mark">Correct</span>
+                <% end %>
+                <span class="stage-option__count"><%= count %></span>
+              <% end %>
+            </li>
+          <% end %>
+        </ol>
+      <% elsif game.finished? %>
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title">The quiz is over</h1>
+          </div>
+        </div>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(quiz) %>
+      <% if game.question_open? %>
+        <div class="answers-counter" id="answers-counter">Answers: <%= answers_count %> / <%= players_count %></div>
+      <% end %>
+    </div>
+    <div class="buttons">
+      <% if game.waiting? %>
+        <%= button_to "Start", start_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg", form: { data: { game_action: true } } %>
+      <% elsif game.question_open? %>
+        <%= button_to "Finish", finish_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg", form: { data: { game_action: true } } %>
+      <% elsif game.question_closed? %>
+        <% if has_next_question %>
+          <%= button_to "Next", next_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg", form: { data: { game_action: true } } %>
+        <% else %>
+          <%= button_to "End quiz", end_quiz_moderate_game_path(game), method: :post, class: "btn btn--pink btn--lg", form: { data: { game_action: true } } %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+</section>
