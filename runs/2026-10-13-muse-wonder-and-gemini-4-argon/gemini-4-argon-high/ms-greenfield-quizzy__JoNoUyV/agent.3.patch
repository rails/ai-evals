diff --git a/app/channels/game_channel.rb b/app/channels/game_channel.rb
new file mode 100644
index 0000000..439627c
--- /dev/null
+++ b/app/channels/game_channel.rb
@@ -0,0 +1,11 @@
+class GameChannel < ApplicationCable::Channel
+  def subscribed
+    if params[:role] == "moderator" && params[:game_id].present?
+      stream_from "game_moderator_#{params[:game_id]}"
+    elsif params[:role] == "player" && params[:game_code].present?
+      stream_from "game_play_#{params[:game_code]}"
+    else
+      reject
+    end
+  end
+end
