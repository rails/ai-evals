+    <div class="play__body">
+      <h1 class="play-title"><%= @quiz.title %></h1>
+      <% if @error.present? %>
+        <div class="errors"><%= @error %></div>
+      <% end %>
+      <%= form_with url: join_play_game_path(@game.code), method: :post, local: true, class: "join-form", data: { join_form: true } do %>
