diff --git a/test/lib/kamal_deploy_config_test.rb b/test/lib/kamal_deploy_config_test.rb
new file mode 100644
index 0000000..5f51ad0
--- /dev/null
+++ b/test/lib/kamal_deploy_config_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+require "kamal"
+
+class KamalDeployConfigTest < ActiveSupport::TestCase
+  setup do
+    @config_file = Rails.root.join("config/deploy.yml")
+    @config = Kamal::Configuration.create_from(config_file: @config_file)
+    @web_role = @config.role(:web)
+  end
+
+  test "validates kamal deploy config for one box with ssl proxy and persistent storage" do
+    assert_equal "fizzy", @config.service
+    assert_equal [ "web" ], @config.roles.map(&:name)
+    assert_empty @config.accessories
+
+    assert @web_role.running_proxy?
+    assert @web_role.ssl?
+    assert_equal 80, @web_role.proxy.app_port
+    assert_equal 1, @web_role.hosts.size
+    assert_equal @web_role.hosts, @web_role.proxy.hosts
+
+    assert_includes @config.volume_args, "fizzy_storage:/rails/storage"
+    assert_equal "/rails/public/assets", @config.asset_path
+  end
+
+  test "runs background jobs in puma and configures mail server and secrets" do
+    env = @web_role.env(@web_role.primary_host)
+
+    assert_equal true, env.clear["SOLID_QUEUE_IN_PUMA"]
+    assert env.clear["SMTP_ADDRESS"].present?
+    assert env.clear["MAILER_FROM_ADDRESS"].present?
+
+    %w[ SECRET_KEY_BASE VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY SMTP_USERNAME SMTP_PASSWORD ].each do |secret|
+      assert_includes env.secret_keys, secret
+    end
+  end
+end
