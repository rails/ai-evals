diff --git a/app/models/user/authoring.rb b/app/models/user/authoring.rb
index bc70db7..b9fbbec 100644
--- a/app/models/user/authoring.rb
+++ b/app/models/user/authoring.rb
@@ -1,10 +1,22 @@
 module User::Authoring
   extend ActiveSupport::Concern
 
+  DELETED_AUTHOR_NAME = "Deleted author"
+
   included do
+    before_destroy :anonymize_shared_books
+
     has_many :created_books, class_name: "Book", foreign_key: :creator_id,
       inverse_of: :creator, dependent: :destroy
 
-    has_many :reading_marks
+    has_many :reading_marks, dependent: :destroy
   end
+
+  private
+    def anonymize_shared_books
+      created_books.with_everyone_access.find_each do |book|
+        book.update!(creator: nil, author: DELETED_AUTHOR_NAME)
+      end
+      created_books.reset
+    end
 end
diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..5ff3e15 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -64,12 +64,59 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
   test "destroy" do
     sign_in :david
 
-    assert_difference -> { User.active.count }, -1 do
-      delete user_url(users(:kevin))
+    assert_difference -> { User.count }, -1 do
+      delete user_path(users(:kevin))
     end
 
     assert_redirected_to users_url
-    assert_nil User.active.find_by(id: users(:kevin).id)
+    assert_nil User.find_by(id: users(:kevin).id)
+  end
+
+  test "destroy erases a previously deactivated user and their sign-in events" do
+    kevin = users(:kevin)
+    original_email = kevin.email_address
+
+    sign_in kevin
+    get leafable_slug_path(leaves(:welcome_page))
+    sign_out
+
+    shared_book = Book.create!(title: "Shared Guide", author: kevin.name, creator: kevin, everyone_access: true)
+    shared_book.update_access(editors: [ kevin.id ], readers: [])
+
+    private_book = Book.create!(title: "Kevin Private Notes", author: kevin.name, creator: kevin, everyone_access: false)
+    private_book.update_access(editors: [ kevin.id ], readers: [])
+    private_leaf = private_book.press(Page.new(body: "Uniqueprivatesecret"), title: "Private Leaf")
+
+    kevin.deactivate
+    assert_not kevin.active?
+    assert_not_equal original_email, kevin.email_address
+    assert SignInEvent.for_address(original_email).exists?
+
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_path(kevin)
+    end
+
+    assert_redirected_to users_url
+    assert_nil User.find_by(id: kevin.id)
+    assert_empty SignInEvent.for_address(original_email)
+    assert_empty SignInEvent.for_address(kevin.email_address)
+    assert_empty ReadingMark.where(user_id: kevin.id)
+    assert_empty Access.where(user_id: kevin.id)
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Leaf.search("Uniqueprivatesecret")
+
+    shared_book.reload
+    assert_nil shared_book.creator
+    assert_equal "Deleted author", shared_book.author
+
+    get book_slug_path(shared_book)
+    assert_response :success
+    assert_in_body "Deleted author"
+    assert_not_in_body kevin.name
   end
 
   test "destroy is not allowed to non-admins" do
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..05ed69e 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,44 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases all their data while anonymizing shared books" do
+    kevin = users(:kevin)
+    kevin.sessions.start!(user_agent: "TestAgent", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+
+    shared_book = Book.create!(title: "Everyone Book", author: kevin.name, creator: kevin, everyone_access: true)
+    shared_leaf = shared_book.press(Page.new(body: "Sharedsearchterm"), title: "Shared Page")
+
+    private_book = Book.create!(title: "Private Book", author: kevin.name, creator: kevin, everyone_access: false)
+    private_leaf = private_book.press(Page.new(body: "Firstprivatesearchterm"), title: "Private Page")
+    private_leaf.edit(leafable_params: { body: "Secondprivatesearchterm" }, leaf_params: { title: "Private Page v2" })
+
+    revision_page_id = private_leaf.edits.last.leafable_id
+    current_page_id = private_leaf.reload.leafable_id
+
+    kevin.destroy!
+
+    assert_not User.exists?(kevin.id)
+    assert_empty Session.where(user_id: kevin.id)
+    assert_empty SignInEvent.for_address(kevin.email_address)
+    assert_empty Access.where(user_id: kevin.id)
+    assert_empty ReadingMark.where(user_id: kevin.id)
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Edit.where(leaf_id: private_leaf.id)
+    assert_not Page.exists?(revision_page_id)
+    assert_not Page.exists?(current_page_id)
+    assert_empty ActionText::Markdown.where(record_type: "Page", record_id: [ revision_page_id, current_page_id ])
+    assert_empty Leaf.search("Firstprivatesearchterm")
+    assert_empty Leaf.search("Secondprivatesearchterm")
+    assert_equal 0, ActiveRecord::Base.connection.select_value("select count(*) from leaf_search_index where rowid = #{private_leaf.id}")
+
+    assert Book.exists?(shared_book.id)
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+    assert_includes Leaf.search("Sharedsearchterm"), shared_leaf
+  end
 end
