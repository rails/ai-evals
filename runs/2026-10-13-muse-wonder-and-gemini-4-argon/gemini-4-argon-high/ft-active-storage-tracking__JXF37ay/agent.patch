+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "bytes_used is zero when there are no attachments" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "card image attachment updates board and account bytes_used" do
+    blob = create_blob("a" * 1024, filename: "image1.png", content_type: "image/png")
+
+    assert_enqueued_with(job: Storage::MaterializeJob, args: [ @account ]) do
+      @card.image.attach(blob)
+    end
+
+    assert_equal 1024, @board.bytes_used
+    assert_equal 1024, @account.bytes_used
+    assert_equal 0, @other_board.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_equal 1024, @board.storage_total.reload.bytes_used
+    assert_equal 1024, @account.storage_total.reload.bytes_used
+    assert_equal 1024, @board.bytes_used
+    assert_equal 1024, @account.bytes_used
+  end
+
+  test "replacing and removing card image updates bytes_used" do
+    blob1 = create_blob("a" * 1000)
+    blob2 = create_blob("b" * 2500)
+
+    perform_enqueued_jobs do
+      @card.image.attach(blob1)
+    end
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.update!(image: blob2)
+    end
+    assert_equal 2500, @board.bytes_used
+    assert_equal 2500, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.image.purge_later
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "purging, detaching, or nil-ing card image updates bytes_used" do
+    blob1 = create_blob("a" * 400)
+    blob2 = create_blob("b" * 600)
+    blob3 = create_blob("c" * 800)
+
+    @card.image.attach(blob1)
+    assert_equal 400, @board.bytes_used
+    @card.image.purge
+    assert_equal 0, @board.bytes_used
+
+    @card.image.attach(blob2)
+    assert_equal 600, @board.bytes_used
+    @card.image.detach
+    assert_equal 0, @board.bytes_used
+
+    @card.image.attach(blob3)
+    assert_equal 800, @board.bytes_used
+    @card.update!(image: nil)
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "files embedded in board public_description are counted without counting variants" do
+    image_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    file_blob = create_blob("x" * 500, filename: "notes.txt", content_type: "text/plain")
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: "<p>Board info #{embed_html_for(image_blob)} #{embed_html_for(file_blob)}</p>")
+    end
+
+    expected_bytes = image_blob.byte_size + 500
+    assert_equal expected_bytes, @board.bytes_used
+    assert_equal expected_bytes, @account.bytes_used
+
+    # Removing one embed updates usage
+    perform_enqueued_jobs do
+      @board.update!(public_description: "<p>Board info #{embed_html_for(file_blob)}</p>")
+    end
+    assert_equal 500, @board.bytes_used
+    assert_equal 500, @account.bytes_used
+
+    # Clearing description to empty string removes remaining embeds
+    perform_enqueued_jobs do
+      @board.update!(public_description: "")
+    end
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "files embedded in card description are counted" do
+    blob1 = create_blob("a" * 300)
+    blob2 = create_blob("b" * 700)
+
+    perform_enqueued_jobs do
+      @card.update!(description: "<p>Desc #{embed_html_for(blob1)} #{embed_html_for(blob2)}</p>")
+    end
+
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.update!(description: "<p>Only second #{embed_html_for(blob2)}</p>")
+    end
+
+    assert_equal 700, @board.bytes_used
+    assert_equal 700, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.update!(description: nil)
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "detaching and purging rich text embeds updates bytes_used" do
+    blob1 = create_blob("a" * 350)
+    blob2 = create_blob("b" * 650)
+
+    @card.update!(description: embed_html_for(blob1))
+    assert_equal 350, @board.bytes_used
+    @card.description.embeds.detach
+    assert_equal 0, @board.bytes_used
+
+    @card.update!(description: embed_html_for(blob2))
+    assert_equal 650, @board.bytes_used
+    @card.description.embeds.purge_later
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "files embedded in comments are counted" do
+    blob1 = create_blob("a" * 450)
+    blob2 = create_blob("b" * 550)
+
+    comment = nil
+    perform_enqueued_jobs do
+      comment = @card.comments.create!(body: "<p>Comment #{embed_html_for(blob1)}</p>")
+    end
+
+    assert_equal 450, @board.bytes_used
+    assert_equal 450, @account.bytes_used
+
+    perform_enqueued_jobs do
+      comment.update!(body: "<p>Updated #{embed_html_for(blob1)} #{embed_html_for(blob2)}</p>")
+    end
+
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+
+    perform_enqueued_jobs do
+      comment.destroy!
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "destroying a card subtracts its image, description embeds, and comment embeds" do
+    img_blob = create_blob("i" * 100)
+    desc_blob = create_blob("d" * 200)
+    comm_blob = create_blob("c" * 300)
+
+    perform_enqueued_jobs do
+      @card.update!(image: img_blob, description: embed_html_for(desc_blob))
+      @card.comments.create!(body: embed_html_for(comm_blob))
+    end
+
+    assert_equal 600, @board.bytes_used
+    assert_equal 600, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.destroy!
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "moving a card between boards transfers all of its storage usage" do
+    board_blob = create_blob("b" * 50)
+    img_blob = create_blob("i" * 100)
+    desc_blob = create_blob("d" * 200)
+    comm_blob = create_blob("c" * 300)
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed_html_for(board_blob))
+      @card.update!(image: img_blob, description: embed_html_for(desc_blob))
+      @card.comments.create!(body: embed_html_for(comm_blob))
+    end
+
+    assert_equal 650, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 650, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.move_to(@other_board)
+    end
+
+    assert_equal 50, @board.bytes_used
+    assert_equal 600, @other_board.bytes_used
+    assert_equal 650, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.destroy!
+    end
+
+    assert_equal 50, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 50, @account.bytes_used
+  end
+
+  test "updating card board and attachments simultaneously updates both boards accurately" do
+    img1 = create_blob("1" * 100)
+    desc1 = create_blob("2" * 200)
+    img2 = create_blob("3" * 400)
+    desc2 = create_blob("4" * 500)
+
+    perform_enqueued_jobs do
+      @card.update!(image: img1, description: embed_html_for(desc1))
+    end
+
+    assert_equal 300, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 300, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @card.update!(board: @other_board, image: img2, description: embed_html_for(desc2))
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 900, @other_board.bytes_used
+    assert_equal 900, @account.bytes_used
+  end
+
+  test "account usage sums across all of its boards and deleting a board updates account usage" do
+    b1 = create_blob("1" * 1000)
+    b2 = create_blob("2" * 2000)
+    b3 = create_blob("3" * 3000)
+
+    other_card = @other_board.cards.create!(title: "Private card", creator: users(:kevin), status: "published")
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed_html_for(b1))
+      @card.update!(image: b2)
+      other_card.update!(image: b3)
+    end
+
+    assert_equal 3000, @board.bytes_used
+    assert_equal 3000, @other_board.bytes_used
+    assert_equal 6000, @account.bytes_used
+
+    perform_enqueued_jobs do
+      @board.destroy!
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 3000, @other_board.bytes_used
+    assert_equal 3000, @account.bytes_used
+  end
+
+  test "draft, closed, and postponed cards are counted in board and account usage" do
+    draft_blob = create_blob("d" * 100)
+    closed_blob = create_blob("c" * 200)
+    postponed_blob = create_blob("p" * 300)
+
+    draft_card = @board.cards.create!(creator: users(:david), status: "drafted", image: draft_blob)
+    @card.update!(image: closed_blob)
+    @card.close
+    cards(:layout).update!(image: postponed_blob)
+    cards(:layout).postpone
+
+    perform_enqueued_jobs
+
+    assert draft_card.drafted?
+    assert @card.closed?
+    assert cards(:layout).postponed?
+
+    assert_equal 600, @board.bytes_used
+    assert_equal 600, @account.bytes_used
+  end
+
+  test "storage usage is isolated between accounts" do
+    other_account = accounts(:initech)
+    other_account_board = boards(:miltons_wish_list)
+
+    blob_37s = create_blob("a" * 500)
+    @card.update!(image: blob_37s)
+
+    Current.with_account(other_account) do
+      blob_initech = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("b" * 1200),
+        filename: "initech.txt",
+        content_type: "text/plain"
+      )
+      cards(:radio).update!(image: blob_initech)
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal 500, @board.bytes_used
+    assert_equal 500, @account.bytes_used
+    assert_equal 1200, other_account_board.bytes_used
+    assert_equal 1200, other_account.bytes_used
+  end
+
+  test "non-board/card/comment attachments are not counted" do
+    perform_enqueued_jobs do
+      # User avatar
+      users(:david).avatar.attach(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+
+      # Export file
+      export = Account::Export.create!(account: @account, user: users(:david))
+      export.file.attach(io: StringIO.new("zipdata"), filename: "export.zip", content_type: "application/zip")
+
+      # Import file
+      import = Account::Import.create!(account: @account, identity: identities(:david))
+      import.file.attach(io: StringIO.new("zipdata"), filename: "import.zip", content_type: "application/zip")
+
+      # Unattached blob
+      create_blob("unattached" * 100)
+
+      # Mentions and remote images in rich text
+      @card.update!(
+        description: <<~HTML
+          <p>Hello #{ActionText::Attachment.from_attachable(users(:kevin)).to_html}</p>
+          <action-text-attachment url="https://example.com/image.png" content-type="image/png"></action-text-attachment>
+        HTML
+      )
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "export and import round-trip reconciles storage usage on imported account and boards" do
+    b1 = create_blob("1" * 400)
+    b2 = create_blob("2" * 600)
+    @board.update!(public_description: embed_html_for(b1))
+    @card.update!(image: b2)
+    perform_enqueued_jobs
+
+    assert_equal 1000, @board.bytes_used
+    assert_equal 1000, @account.bytes_used
+
+    exporter = users(:david)
+    identity = exporter.identity
+    board_id = @board.id
+
+    export = Account::Export.create!(account: @account, user: exporter)
+    export.build
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |f| FileUtils.cp(f.path, export_tempfile.path) }
+
+    ActiveStorage::Blob.where(account: @account).delete_all
+    @account.destroy!
+
+    target_account = Account.create_with_owner(account: { name: "Imported Account" }, owner: { identity: identity, name: exporter.name })
+    import = Account::Import.create!(identity: identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    import.check
+    import.process
+
+    imported_board = target_account.boards.find(board_id)
+    assert_equal 1000, imported_board.bytes_used
+    assert_equal 1000, target_account.bytes_used
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
+  test "concurrent attachment additions and materializations do not lose updates" do
+    cards = 5.times.map do |i|
+      @board.cards.create!(title: "Concurrent Card #{i}", creator: users(:david), status: "published")
+    end
+    blobs = 5.times.map do |i|
+      create_blob("x" * ((i + 1) * 100), filename: "file_#{i}.txt")
+    end
+
+    threads = cards.zip(blobs).map do |card, blob|
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          Current.with_account(@account) do
+            card.image.attach(blob)
+            @account.materialize_storage
+          end
+        end
+      end
+    end
+    threads.each(&:join)
+
+    @account.materialize_storage
+
+    expected_total = (1..5).sum { |i| i * 100 }
+    assert_equal expected_total, @board.bytes_used
+    assert_equal expected_total, @account.bytes_used
+    assert_equal expected_total, @board.storage_total.reload.bytes_used
+    assert_equal expected_total, @account.storage_total.reload.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  private
+    def create_blob(content, filename: "file.txt", content_type: "text/plain")
+      Current.with_account(@account) do
+        ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new(content),
+          filename: filename,
+          content_type: content_type
+        )
+      end
+    end
+
+    def embed_html_for(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
