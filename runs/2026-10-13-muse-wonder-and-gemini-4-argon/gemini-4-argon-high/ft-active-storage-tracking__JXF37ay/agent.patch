diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
new file mode 100644
index 0000000..5c76950
--- /dev/null
+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,131 @@
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  MATERIALIZE_BATCH_SIZE = 1_000
+
+  included do
+    has_many :storage_entries, class_name: "Storage::Entry"
+    has_one :storage_total, as: :owner, class_name: "Storage::Total", dependent: :destroy
+
+    if self == Account
+      after_destroy :cleanup_storage_records
+    end
+  end
+
+  def bytes_used
+    return 0 if destroyed?
+
+    materialized_bytes = Storage::Total.where(owner: self).pick(:bytes_used) || 0
+    [ materialized_bytes + storage_entries.sum(:delta), 0 ].max
+  end
+
+  def materialize_storage
+    return if destroyed?
+    return account.materialize_storage if is_a?(Board)
+
+    while materialize_storage_batch
+    end
+  end
+  alias_method :materialize_storage_now, :materialize_storage
+
+  def materialize_storage_later
+    Storage::MaterializeJob.perform_later(self) unless destroyed?
+  end
+
+  def reconcile_storage
+    if is_a?(Account)
+      boards.find_each(&:reconcile_storage)
+      materialize_storage
+    else
+      reconcile_board_storage
+    end
+  end
+
+  def find_or_create_storage_total
+    Storage::Total.find_or_create_by!(owner: self)
+  rescue ActiveRecord::RecordNotUnique
+    Storage::Total.find_by!(owner: self)
+  end
+
+  private
+    def materialize_storage_batch
+      return false unless storage_entries.exists?
+
+      account_total = find_or_create_storage_total
+      account_total.with_lock do
+        entries = storage_entries.limit(MATERIALIZE_BATCH_SIZE).select(:id, :board_id, :delta).to_a
+        return false if entries.empty?
+
+        entries.group_by(&:board_id).each do |board_id, board_entries|
+          if board_id && (board = boards.find_by(id: board_id))
+            board_total = board.find_or_create_storage_total
+            board_total.with_lock do
+              board_delta = board_entries.sum(&:delta)
+              board_total.update!(bytes_used: [ board_total.bytes_used + board_delta, 0 ].max)
+            end
+          end
+        end
+
+        account_delta = entries.sum(&:delta)
+        account_total.update!(bytes_used: [ account_total.bytes_used + account_delta, 0 ].max)
+
+        Storage::Entry.where(id: entries.map(&:id)).delete_all
+        entries.size == MATERIALIZE_BATCH_SIZE
+      end
+    end
+
+    def reconcile_board_storage
+      diff = real_bytes_used - bytes_used
+      if diff.nonzero?
+        Storage::Entry.record(
+          account_id: account_id,
+          board_id: id,
+          recordable: self,
+          delta: diff,
+          operation: "reconcile"
+        )
+      end
+      materialize_storage
+    end
+
+    def real_bytes_used
+      board_description_embed_bytes + cards_image_bytes + cards_description_embed_bytes + cards_comment_embed_bytes
+    end
+
+    def board_description_embed_bytes
+      rich_text_ids = ActionText::RichText.where(record_type: "Board", record_id: id, name: "public_description").select(:id)
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def cards_image_bytes
+      ActiveStorage::Attachment
+        .where(record_type: "Card", record_id: cards.select(:id), name: "image")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def cards_description_embed_bytes
+      rich_text_ids = ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description").select(:id)
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def cards_comment_embed_bytes
+      comment_ids = Comment.where(card_id: cards.select(:id)).select(:id)
+      rich_text_ids = ActionText::RichText.where(record_type: "Comment", record_id: comment_ids, name: "body").select(:id)
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def cleanup_storage_records
+      Storage::Entry.where(account_id: id).delete_all
+      Storage::Total.where(account_id: id).delete_all
+    end
+end
diff --git a/app/models/storage/trackable.rb b/app/models/storage/trackable.rb
new file mode 100644
index 0000000..6d695a5
--- /dev/null
+++ b/app/models/storage/trackable.rb
@@ -0,0 +1,114 @@
+module Storage::Trackable
+  extend ActiveSupport::Concern
+
+  included do
+    if self == Card
+      before_update :transfer_storage_to_new_board, if: :will_save_change_to_board_id?
+    elsif self == Comment
+      before_update :transfer_comment_storage_to_new_board, if: :will_save_change_to_card_id?
+    end
+  end
+
+  def track_storage_change(delta, operation, blob_id: nil)
+    if board_id = storage_board_id
+      Storage::Entry.record(
+        account_id: account_id,
+        board_id: board_id,
+        recordable: self,
+        blob_id: blob_id,
+        delta: delta,
+        operation: operation
+      )
+    end
+  end
+
+  private
+    def storage_board_id
+      if is_a?(Board)
+        id
+      elsif respond_to?(:board_id)
+        board_id
+      else
+        card&.board_id
+      end
+    end
+
+    def transfer_storage_to_new_board
+      bytes = persisted_card_storage_bytes
+      if bytes.positive?
+        old_board = Board.find_by(id: board_id_was)
+        Storage::Entry.record(
+          account_id: old_board&.account_id || account_id,
+          board_id: board_id_was,
+          recordable: self,
+          delta: -bytes,
+          operation: "transfer_out"
+        )
+        Storage::Entry.record(
+          account_id: board&.account_id || account_id,
+          board_id: board_id,
+          recordable: self,
+          delta: +bytes,
+          operation: "transfer_in"
+        )
+      end
+    end
+
+    def persisted_card_storage_bytes
+      card_image_bytes + card_description_embed_bytes + card_comment_embed_bytes
+    end
+
+    def card_image_bytes
+      ActiveStorage::Attachment
+        .where(record_type: "Card", record_id: id, name: "image")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_embed_bytes
+      rich_text_ids = ActionText::RichText.where(record_type: "Card", record_id: id, name: "description").select(:id)
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_comment_embed_bytes
+      comment_rich_text_ids = ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id), name: "body").select(:id)
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", record_id: comment_rich_text_ids, name: "embeds")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def transfer_comment_storage_to_new_board
+      old_card = Card.find_by(id: card_id_was)
+      if old_card && card && old_card.board_id != card.board_id
+        bytes = persisted_comment_storage_bytes
+        if bytes.positive?
+          Storage::Entry.record(
+            account_id: old_card.account_id,
+            board_id: old_card.board_id,
+            recordable: self,
+            delta: -bytes,
+            operation: "transfer_out"
+          )
+          Storage::Entry.record(
+            account_id: card.account_id,
+            board_id: card.board_id,
+            recordable: self,
+            delta: +bytes,
+            operation: "transfer_in"
+          )
+        end
+      end
+    end
+
+    def persisted_comment_storage_bytes
+      rich_text_ids = ActionText::RichText.where(record_type: "Comment", record_id: id, name: "body").select(:id)
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
