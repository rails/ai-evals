@@ -0,0 +1,30 @@
+class Storage::Entry < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :board, optional: true
+  belongs_to :blob, class_name: "ActiveStorage::Blob", optional: true
+  belongs_to :recordable, polymorphic: true, optional: true
+  belongs_to :user, default: -> { Current.user }, optional: true
+
+  before_create { self.request_id ||= Current.request_id }
+  after_create_commit :materialize_storage_later
+
+  class << self
+    def record(delta:, operation:, account_id:, board_id: nil, recordable: nil, blob_id: nil)
+      if delta.nonzero?
+        create!(
+          account_id: account_id,
+          board_id: board_id,
+          recordable: recordable,
+          blob_id: blob_id,
+          delta: delta,
+          operation: operation
+        )
+      end
+    end
+  end
+
+  private
+    def materialize_storage_later
+      account&.materialize_storage_later
+    end
+end
