index 0000000..866fe2c
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,61 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_validation { blob.account ||= account if blob }
+    after_create :track_storage_addition
+    after_destroy :track_storage_removal
+  end
+
+  def uploaded(...)
+    if Current.account.nil? && account
+      Current.with_account(account) { super }
+    else
+      super
+    end
+  end
+
+  def delete
+    if persisted?
+      deleted = self.class.where(id: id).delete_all > 0
+      track_storage_removal if deleted
+      @destroyed = true
+    end
+    super
+  end
+
+  private
+    def create_variants
+      if Current.account.nil? && account
+        Current.with_account(account) { super }
+      else
+        super
+      end
+    end
+
+    def track_storage_addition
+      track_storage_change(+blob.byte_size, "attach") if blob
+    end
+
+    def track_storage_removal
+      return if @_storage_removal_tracked
+      @_storage_removal_tracked = true
+
+      track_storage_change(-blob.byte_size, "detach") if blob
+    end
+
+    def track_storage_change(delta, operation)
+      if tracked_record = storage_tracked_record
+        tracked_record.track_storage_change(delta, operation, blob_id: blob_id)
+      end
+    end
+
+    def storage_tracked_record
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        record
+      when [ "ActionText::RichText", "embeds" ]
+        record&.record if record&.record_type.in?(%w[ Board Card Comment ])
+      end
+    end
+end
