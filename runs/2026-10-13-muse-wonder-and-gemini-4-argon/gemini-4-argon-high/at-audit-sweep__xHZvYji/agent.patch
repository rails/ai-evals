diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..6d4c414
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show finds matching pages in readable books" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "show does not return pages from unreadable books or allow SQL injection" do
+    books(:manual).press Page.new(body: "Secret"), title: "Secret Manual Page"
+
+    get library_search_path, params: { q: "Secret" }
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+
+    get library_search_path, params: { q: "%' OR 1=1 --" }
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "show handles apostrophes and punctuation without error" do
+    leaves(:welcome_page).update!(title: "Reader's Guide")
+
+    get library_search_path, params: { q: "Reader's" }
+
+    assert_response :success
+    assert_in_body "Reader&#39;s Guide"
+  end
+
+  test "show treats percent sign and underscore as literal characters" do
+    leaves(:summary_page).update!(title: "Save 50% off")
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_not_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
