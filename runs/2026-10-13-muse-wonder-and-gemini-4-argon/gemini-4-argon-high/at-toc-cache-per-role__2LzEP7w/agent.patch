diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..47a98aa 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,69 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show does not leak cached editor controls to readers or reader view to editors" do
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body edit_leafable_path(leaves(:welcome_page))
+
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_not_in_body edit_leafable_path(leaves(:welcome_page))
+
+      Rails.cache.clear
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_not_in_body edit_leafable_path(leaves(:welcome_page))
+
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body edit_leafable_path(leaves(:welcome_page))
+    end
+  end
+
+  test "show reflects renamed entry when cached and fetches entries in one go" do
+    with_caching do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+
+      leaves(:welcome_page).update!(title: "Renamed Welcome Page")
+
+      sign_in :jz
+      assert_notifications_count("cache_read_multi.active_support", 1) do
+        assert_notifications_count("cache_read.active_support", 1) do
+          get book_slug_path(books(:handbook))
+        end
+      end
+
+      assert_response :success
+      assert_in_body "Renamed Welcome Page"
+      assert_not_in_body edit_leafable_path(leaves(:welcome_page))
+    end
+  end
+
+  private
+    def with_caching
+      original_perform_caching = ActionController::Base.perform_caching
+      original_cache_store = ActionController::Base.cache_store
+      original_collection_cache = ActionView::PartialRenderer.collection_cache
+      original_rails_cache = Rails.cache
+
+      store = ActiveSupport::Cache::MemoryStore.new
+      ActionController::Base.perform_caching = true
+      ActionController::Base.cache_store = store
+      ActionView::PartialRenderer.collection_cache = store
+      Rails.cache = store
+
+      yield
+    ensure
+      ActionController::Base.perform_caching = original_perform_caching
+      ActionController::Base.cache_store = original_cache_store
+      ActionView::PartialRenderer.collection_cache = original_collection_cache
+      Rails.cache = original_rails_cache
+    end
 end
