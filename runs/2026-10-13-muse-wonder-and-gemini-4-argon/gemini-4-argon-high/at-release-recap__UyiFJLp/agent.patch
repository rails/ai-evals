diff --git a/test/controllers/books/releases_controller_test.rb b/test/controllers/books/releases_controller_test.rb
new file mode 100644
index 0000000..3fa5c80
--- /dev/null
+++ b/test/controllers/books/releases_controller_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Books::ReleasesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    @book = books(:handbook)
+    sign_in :kevin
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "releasing a book shows the new title as published in recently updated" do
+    patch book_release_path(@book), params: { book: { title: "Released Handbook", subtitle: "Final Edition" } }
+    assert_redirected_to root_path
+
+    follow_redirect!
+    assert_response :success
+    assert_select ".library__recents", text: /Released Handbook/
+    assert_select ".library__recents", text: /Published/
+    assert_not_in_body "Handbook\n"
+
+    get book_slug_path(@book.reload)
+    assert_response :success
+    assert_in_body "Released Handbook"
+  end
+end
diff --git a/test/models/book/recap_test.rb b/test/models/book/recap_test.rb
new file mode 100644
index 0000000..8c8eca9
--- /dev/null
+++ b/test/models/book/recap_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Book::RecapTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "updating a book writes its recap to the cache" do
+    book = books(:handbook)
+    book.update!(title: "Updated Handbook")
+
+    assert_equal({ title: "Updated Handbook", published: false }, book.cached_recap)
+  end
+
+  test "saving one book does not overwrite another book's recap" do
+    handbook = books(:handbook)
+    manual = books(:manual)
+
+    handbook.update!(title: "Updated Handbook")
+    manual.update!(title: "Updated Manual")
+
+    assert_equal({ title: "Updated Handbook", published: false }, handbook.cached_recap)
+    assert_equal({ title: "Updated Manual", published: false }, manual.cached_recap)
+  end
+
+  test "recap expires on the configured schedule" do
+    book = books(:handbook)
+    book.update!(title: "Updated Handbook")
+
+    assert_not_nil book.cached_recap
+
+    travel Rails.application.config.x.recap.expires_in + 1.second do
+      assert_nil book.cached_recap
+    end
+  end
+
+  test "finalizing release writes the released title and published status to the recap" do
+    book = books(:handbook)
+
+    assert Book.finalize_release(book.id, title: "Released Handbook", subtitle: "First Edition")
+
+    book.reload
+    assert_equal "Released Handbook", book.title
+    assert_equal "First Edition", book.subtitle
+    assert book.published?
+    assert_equal({ title: "Released Handbook", published: true }, book.cached_recap)
+  end
+
+  test "finalizing release of an already published book returns false" do
+    book = books(:handbook)
+    book.update!(published: true)
+
+    assert_not Book.finalize_release(book.id, title: "Another Title")
+    assert_equal "Handbook", book.reload.title
+    assert_equal({ title: "Handbook", published: true }, book.cached_recap)
+  end
+end
