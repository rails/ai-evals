diff --git a/test/controllers/concerns/current_locale_test.rb b/test/controllers/concerns/current_locale_test.rb
new file mode 100644
index 0000000..942882c
--- /dev/null
+++ b/test/controllers/concerns/current_locale_test.rb
@@ -0,0 +1,340 @@
+require "test_helper"
+
+class CurrentLocaleTest < ActionDispatch::IntegrationTest
+  test "defaults to English when no locale is chosen" do
+    sign_in_as :kevin
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "title", /Home \| Fizzy/
+    assert_select "a.header__skip-navigation", text: "Skip to main content"
+  end
+
+  test "switching to Japanese with ?locale=ja persists in session and across clean browser sign-in" do
+    sign_in_as :kevin
+
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "title", /ホーム \| Fizzy/
+    assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    # Subsequent request in the same session without ?locale param stays in Japanese
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "カードを追加"
+    assert_includes response.body, "検討中？"
+    assert_includes response.body, "あとで"
+    assert_includes response.body, "完了"
+
+    # Signing in from a clean browser preserves Japanese
+    open_session do |clean_browser|
+      clean_browser.default_url_options[:script_name] = integration_session.default_url_options[:script_name]
+      clean_browser.sign_in_as :kevin
+
+      clean_browser.get root_path
+      clean_browser.assert_response :success
+      clean_browser.assert_select "html[lang='ja']"
+      clean_browser.assert_select "title", /ホーム \| Fizzy/
+    end
+  end
+
+  test "switching to Japanese before signing in sticks for the session and after signing in" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_includes response.body, "Fizzyにサインイン"
+
+      # Next page in same session without ?locale param stays in Japanese
+      get new_signup_path
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_includes response.body, "新規登録"
+    end
+
+    sign_in_as :david
+    assert_equal "ja", identities(:david).reload.locale
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "unsupported locale parameter does not break page or switch locale" do
+    sign_in_as :kevin
+
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "title", /Home \| Fizzy/
+    assert_nil identities(:kevin).reload.locale
+
+    # Switch to Japanese, then pass unsupported locale: stays in Japanese
+    get root_path(locale: "ja")
+    assert_select "html[lang='ja']"
+
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "title", /ホーム \| Fizzy/
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "includes locale in ETag" do
+    sign_in_as :kevin
+
+    get user_avatar_path(users(:kevin))
+    etag = response.headers.fetch("ETag")
+
+    get user_avatar_path(users(:kevin)), headers: { "If-None-Match" => etag }
+    assert_equal 304, response.status
+
+    get user_avatar_path(users(:kevin), locale: "ja"), headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_not_equal etag, response.headers.fetch("ETag")
+  end
+
+  test "renders screens, dates, and screen reader labels in Japanese" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+
+    # Card show page (with closed stamp date and screen reader text)
+    closed_card = cards(:shipping)
+    get card_path(closed_card)
+    assert_response :success
+    assert_select ".for-screen-reader", text: "カード番号"
+    assert_includes response.body, closed_card.closed_at.strftime("%Y年%-m月%-d日")
+
+    # Open card show page
+    open_card = cards(:logo)
+    get card_path(open_card)
+    assert_response :success
+    assert_select ".for-screen-reader", text: "通常カードに戻す (shift+g)"
+    assert_select ".for-screen-reader", text: "背景画像を追加"
+    assert_select ".for-screen-reader", text: "タグを追加"
+    assert_select ".for-screen-reader", text: "担当者を設定"
+
+    # Card sub-screens
+    get edit_card_path(open_card)
+    assert_response :success
+    assert_includes response.body, "変更を保存"
+
+    get new_card_assignment_path(open_card)
+    assert_response :success
+    assert_includes response.body, "担当者を設定…"
+
+    get new_card_tagging_path(open_card)
+    assert_response :success
+    assert_includes response.body, "タグを設定…"
+
+    get edit_card_board_path(open_card)
+    assert_response :success
+    assert_includes response.body, "このカードを移動…"
+
+    get edit_card_column_path(open_card)
+    assert_response :success
+    assert_select ".for-screen-reader", text: "このカードのカラムを選択"
+
+    get new_card_reaction_path(open_card)
+    assert_response :success
+    assert_select ".for-screen-reader", text: "送信"
+
+    # Cards index & search
+    get cards_path
+    assert_response :success
+    assert_includes response.body, "フィルターを切り替え"
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_includes response.body, "「logo」の検索結果"
+
+    # My Menu, Pins, Access Tokens, Passkeys
+    get my_menu_path
+    assert_response :success
+    assert_select ".for-screen-reader", text: "メニューを閉じる"
+    assert_includes response.body, "自分の担当"
+    assert_includes response.body, "自分が追加"
+    assert_includes response.body, "アカウント設定"
+
+    get my_pins_path
+    assert_response :success
+    assert_includes response.body, "ピン留め"
+
+    get my_access_tokens_path
+    assert_response :success
+    assert_includes response.body, "個人用アクセストークン"
+
+    get new_my_access_token_path
+    assert_response :success
+    assert_includes response.body, "アクセストークンを発行"
+
+    get my_passkeys_path
+    assert_response :success
+    assert_includes response.body, "パスキーを登録"
+
+    # Account settings & join code & import
+    get account_settings_path
+    assert_response :success
+    assert_includes response.body, "アカウント設定"
+    assert_includes response.body, "このアカウントのメンバー"
+    assert_includes response.body, "自動クローズ"
+
+    get account_join_code_path
+    assert_response :success
+    assert_includes response.body, "招待リンクをコピー"
+
+    get edit_account_join_code_path
+    assert_response :success
+    assert_includes response.body, "使用上限の変更"
+
+    # Notifications & Notification settings
+    get notifications_path
+    assert_response :success
+    assert_select ".for-screen-reader", text: "通知設定"
+
+    get tray_notifications_path
+    assert_response :success
+
+    get notifications_settings_path
+    assert_response :success
+    assert_includes response.body, "メール通知"
+
+    # User profile & edit & email change
+    get user_path(users(:kevin))
+    assert_response :success
+    assert_select ".for-screen-reader", text: "プロフィールを編集"
+
+    get edit_user_path(users(:kevin))
+    assert_response :success
+    assert_includes response.body, "プロフィールを編集"
+
+    get new_user_email_address_path(users(:kevin))
+    assert_response :success
+    assert_includes response.body, "メールアドレスの変更"
+
+    # Board new, settings, columns & Webhooks
+    get new_board_path
+    assert_response :success
+    assert_includes response.body, "新しいボードを作成"
+
+    get edit_board_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, "ボード設定"
+    assert_includes response.body, "公開リンク"
+
+    get board_columns_closed_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, "カラム：完了"
+
+    get board_columns_not_now_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, "カラム：あとで"
+
+    get board_columns_stream_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, "カラム：検討中？"
+
+    get board_webhooks_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, "新しいWebhookを設定"
+
+    get new_board_webhook_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, "Webhookを作成"
+  end
+
+  test "sends all emails in Japanese for a user who chose Japanese" do
+    kevin_identity = identities(:kevin)
+    kevin_identity.update!(locale: "ja")
+    kevin_user = users(:kevin)
+
+    # 1. MagicLinkMailer
+    magic_link = MagicLink.create!(identity: kevin_identity)
+    mail = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_equal "Fizzyの認証コードは #{magic_link.code} です", mail.subject
+    assert_includes mail.html_part.body.decoded, "15分"
+    assert_includes mail.text_part.body.decoded, "15分"
+
+    # 2. ExportMailer
+    export = Account::Export.create!(account: accounts("37s"), user: kevin_user)
+    mail = ExportMailer.completed(export)
+    assert_equal "Fizzyのデータエクスポートのダウンロード準備ができました", mail.subject
+    assert_includes mail.html_part.body.decoded, "データをダウンロード"
+
+    # 3. ImportMailer
+    mail = ImportMailer.completed(kevin_identity, accounts("37s"))
+    assert_equal "Fizzyアカウントのインポートが完了しました", mail.subject
+    assert_includes mail.html_part.body.decoded, "アカウントへ移動"
+
+    import = Account::Import.create!(account: accounts("37s"), identity: kevin_identity, status: :failed)
+    mail = ImportMailer.failed(import)
+    assert_equal "Fizzyアカウントのインポートに失敗しました", mail.subject
+    assert_includes mail.html_part.body.decoded, "残念ながら、Fizzyアカウントをインポートできませんでした。"
+
+    # 4. UserMailer
+    mail = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "tok", user: kevin_user)
+    assert_equal "新しいメールアドレスの確認", mail.subject
+    assert_includes mail.body.decoded, "メールアドレス変更の確認"
+
+    # 5. Notification::BundleMailer (including Japanese date)
+    bundle = kevin_user.notification_bundles.create!(starts_at: 2.years.ago, ends_at: 1.minute.from_now)
+    mail = Notification::BundleMailer.notification(bundle)
+    assert_includes mail.subject, "新しい通知"
+    assert_includes mail.html_part.body.decoded, "以降の通知"
+    assert_includes mail.html_part.body.decoded, "月"
+    assert_includes mail.html_part.body.decoded, "日("
+
+    # 6. AccountMailer
+    cancellation = Account::Cancellation.create!(account: accounts("37s"), initiated_by: kevin_user)
+    mail = AccountMailer.cancellation(cancellation)
+    assert_equal "Fizzyアカウントが解約されました", mail.subject
+    assert_includes mail.html_part.body.decoded, "今後の流れ"
+  end
+
+  test "renders event descriptions, system comments, notification payloads, and filters in Japanese" do
+    I18n.with_locale(:ja) do
+      user = users(:kevin)
+      card = cards(:logo)
+
+      Event.find_each do |event|
+        assert_predicate event.description_for(user).to_html, :present?
+        assert_predicate event.description_for(user).to_plain_text, :present?
+      end
+
+      %w[card_assigned card_unassigned card_closed card_reopened card_postponed card_auto_postponed card_title_changed card_board_changed card_triaged card_sent_back_to_triage].each do |action|
+        event = Event.new(
+          action: action,
+          creator: user,
+          eventable: card,
+          particulars: { "particulars" => { "old_title" => "A", "new_title" => "B", "old_board" => "B1", "new_board" => "B2", "column" => "C1" } }
+        )
+        commenter = Card::Eventable::SystemCommenter.new(card, event)
+        assert_predicate commenter.send(:comment_body), :present?
+      end
+
+      %w[comment_created card_assigned card_published card_closed card_reopened card_triaged card_sent_back_to_triage card_board_changed card_title_changed card_postponed card_auto_postponed].each do |action|
+        eventable = action == "comment_created" ? comments(:logo_agreement_jz) : card
+        event = Event.new(action: action, creator: user, eventable: eventable, particulars: { "particulars" => { "column" => "C1", "new_board" => "B1", "new_title" => "T1" } })
+        notification = Notification.new(user: user, creator: user, source: event, card: card, account: accounts("37s"))
+        payload = Notification::EventPayload.new(notification)
+        assert_predicate payload.title, :present?
+        assert_predicate payload.body, :present?
+      end
+
+      filter = user.filters.new(indexed_by: "stalled", sorted_by: "newest", assignment_status: "unassigned", terms: [ "foo" ])
+      assert_equal "停滞中、新しい順、担当者なし、「foo」に一致", filter.summary
+    end
+  end
+
+  test "static error pages render in both English and Japanese" do
+    %w[400.html 404.html 406-unsupported-browser.html 422.html 500.html].each do |filename|
+      content = File.read(Rails.root.join("public", filename))
+      assert_includes content, "Back home", "#{filename} should include English text"
+      assert_includes content, "ホームに戻る", "#{filename} should include Japanese text"
+    end
+  end
+end
