@@ -13,4 +20,27 @@ class ApplicationMailer < ActionMailer::Base
         super
       end
     end
+
+    def recipient_locale(*args, **kwargs)
+      candidates = args + kwargs.values
+      identity = candidates.filter_map { |arg| extract_identity(arg) }.first
+      identity&.locale&.presence_in(I18n.available_locales.map(&:to_s))
+    end
+
+    def extract_identity(object)
+      case object
+      when Identity
+        object
+      when User
+        object.identity
+      else
+        if object.respond_to?(:identity) && object.identity.is_a?(Identity)
+          object.identity
+        elsif object.respond_to?(:user) && object.user.is_a?(User)
+          object.user.identity
+        elsif object.respond_to?(:initiated_by) && object.initiated_by.is_a?(User)
+          object.initiated_by.identity
+        end
+      end
+    end
 end
