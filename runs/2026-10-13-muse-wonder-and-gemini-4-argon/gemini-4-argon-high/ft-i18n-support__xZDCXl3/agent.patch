diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..429caf6
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,54 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :set_locale
+    before_action :sync_locale
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def set_locale(&)
+      if locale = locale_from_params
+        session[:locale] = locale
+        session.delete(:locale_identity_id)
+      end
+
+      I18n.with_locale(resolved_locale, &)
+    end
+
+    def sync_locale
+      if Current.identity.present?
+        if locale = locale_from_params
+          Current.identity.update!(locale: locale) if Current.identity.locale != locale
+          session[:locale_identity_id] = Current.identity.id
+        elsif session[:locale].present? && session[:locale_identity_id].nil? && available_locale(session[:locale])
+          Current.identity.update!(locale: session[:locale]) if Current.identity.locale != session[:locale]
+          session[:locale_identity_id] = Current.identity.id
+        elsif session[:locale_identity_id].present? && session[:locale_identity_id] != Current.identity.id
+          session.delete(:locale)
+          session.delete(:locale_identity_id)
+        end
+      end
+
+      I18n.locale = resolved_locale
+    end
+
+    def resolved_locale
+      locale_from_params ||
+        available_locale(Current.identity&.locale) ||
+        available_locale(session[:locale]) ||
+        I18n.default_locale
+    end
+
+    def locale_from_params
+      available_locale(params[:locale])
+    end
+
+    def available_locale(locale)
+      locale_str = locale.to_s.presence
+      locale_str if locale_str && I18n.locale_available?(locale_str)
+    end
+end
