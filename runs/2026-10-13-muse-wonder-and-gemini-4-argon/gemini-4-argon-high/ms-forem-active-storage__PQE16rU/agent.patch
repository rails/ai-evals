diff --git a/spec/models/concerns/profile_image_attachable_spec.rb b/spec/models/concerns/profile_image_attachable_spec.rb
new file mode 100644
index 0000000..7a1aaba
--- /dev/null
+++ b/spec/models/concerns/profile_image_attachable_spec.rb
@@ -0,0 +1,96 @@
+require "rails_helper"
+require "exifr/jpeg"
+
+RSpec.describe ProfileImageAttachable do
+  let(:image_file) { fixture_file_upload("800x600.png", "image/png") }
+  let(:second_image_file) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+
+  describe "User profile_image" do
+    it "takes CarrierWave off user profile pictures and stores them in Active Storage" do
+      user = create(:user, profile_image: image_file)
+
+      expect(User.uploaders[:profile_image]).to be_nil
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/redirect/")
+      expect(user.profile_image_url).to end_with("/800x600.png")
+      expect(user.profile_image_90).to eq(user.profile_image_url_for(length: 90))
+    end
+
+    it "does not fall back to retired CarrierWave profile picture uploads" do
+      user = create(:user, profile_image: nil)
+      user.update_column(:profile_image, "legacy-avatar.png")
+
+      reloaded_user = User.find(user.id)
+
+      expect(reloaded_user.profile_image).not_to be_attached
+      expect(reloaded_user.profile_image).to be_blank
+      expect(reloaded_user.profile_image_url).to be_nil
+      expect(reloaded_user.profile_image.url).to be_nil
+      expect(reloaded_user.profile_image.to_s).to eq("")
+      expect(reloaded_user.profile_image_90).to include(Images::Profile::BACKUP_LINK)
+    end
+
+    it "enqueues BustProfileImageCacheWorker when profile_image is updated via Active Storage" do
+      user = create(:user)
+
+      sidekiq_assert_enqueued_with(job: Users::BustProfileImageCacheWorker, args: [user.id]) do
+        user.update!(profile_image: second_image_file)
+      end
+    end
+
+    it "rejects unsupported file extensions" do
+      pdf_file = fixture_file_upload("800x600.pdf", "application/pdf")
+      user = build(:user, profile_image: pdf_file)
+
+      expect(user).not_to be_valid
+      expect(user.errors[:profile_image]).to be_present
+    end
+
+    it "removes EXIF and GPS data when processing is enabled" do
+      image_with_gps = fixture_file_upload("image_gps_data.jpg", "image/jpeg")
+      described_class.enable_processing = true
+
+      user = create(:user, profile_image: image_with_gps)
+
+      expect(EXIFR::JPEG.new(user.profile_image.path).exif?).to be(false)
+      expect(EXIFR::JPEG.new(user.profile_image.path).gps.present?).to be(false)
+    ensure
+      described_class.enable_processing = false
+    end
+  end
+
+  describe "Organization profile_image" do
+    it "takes CarrierWave off organization profile pictures and stores them in Active Storage" do
+      organization = create(:organization, profile_image: image_file)
+
+      expect(Organization.uploaders[:profile_image]).to be_nil
+      expect(organization.profile_image).to be_attached
+      expect(organization.read_attribute(:profile_image)).to be_nil
+      expect(organization.profile_image_url).to start_with("/rails/active_storage/blobs/redirect/")
+      expect(organization.profile_image_url).to end_with("/800x600.png")
+      expect(organization.profile_image_90).to eq(organization.profile_image_url_for(length: 90))
+    end
+
+    it "does not fall back to retired CarrierWave profile picture uploads" do
+      organization = create(:organization, profile_image: image_file)
+      organization.profile_image.purge
+      organization.update_column(:profile_image, "legacy-org-logo.png")
+
+      reloaded_org = Organization.find(organization.id)
+
+      expect(reloaded_org.profile_image).not_to be_attached
+      expect(reloaded_org.profile_image).to be_blank
+      expect(reloaded_org).not_to be_valid
+      expect(reloaded_org.profile_image_url).to be_nil
+    end
+
+    it "keeps other uploads on CarrierWave" do
+      organization = create(:organization, cover_image: image_file)
+
+      expect(organization.cover_image).to be_a(CoverImageUploader)
+      expect(Tag.uploaders[:profile_image]).to eq(ProfileImageUploader)
+      expect(Badge.uploaders[:badge_image]).to eq(BadgeUploader)
+    end
+  end
+end
