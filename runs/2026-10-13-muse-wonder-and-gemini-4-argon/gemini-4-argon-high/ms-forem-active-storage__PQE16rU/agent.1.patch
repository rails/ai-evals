diff --git a/spec/models/concerns/profile_image_attachable_spec.rb b/spec/models/concerns/profile_image_attachable_spec.rb
new file mode 100644
index 0000000..5a4e38e
--- /dev/null
+++ b/spec/models/concerns/profile_image_attachable_spec.rb
@@ -0,0 +1,128 @@
+require "rails_helper"
+
+RSpec.describe ProfileImageAttachable do
+  let(:image_file) { fixture_file_upload("800x600.png", "image/png") }
+  let(:second_image_file) { fixture_file_upload("800x600.jpg", "image/jpeg") }
+
+  describe "User profile_image" do
+    it "stores new profile pictures in Active Storage without writing to the CarrierWave column" do
+      user = create(:user, profile_image: image_file)
+
+      expect(user.profile_image).to be_attached
+      expect(user.read_attribute(:profile_image)).to be_nil
+      expect(user.profile_image_url).to start_with("/rails/active_storage/blobs/redirect/")
+      expect(user.profile_image_url).to end_with("/800x600.png")
+      expect(user.profile_image_90).to eq(user.profile_image_url_for(length: 90))
+    end
+
+    it "continues serving existing CarrierWave profile pictures when no Active Storage attachment exists" do
+      user = create(:user, profile_image: nil)
+      uploader = ProfileImageUploader.new(user, :profile_image)
+      uploader.store!(image_file)
