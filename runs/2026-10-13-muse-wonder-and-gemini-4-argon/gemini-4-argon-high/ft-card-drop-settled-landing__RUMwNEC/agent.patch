diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..0c5bda6
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,150 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card between columns" do
+    visit board_url(@board)
+
+    maybe_column = find("#maybe")
+    in_progress_column = find("##{dom_id(columns(:writebook_in_progress))}")
+    card = cards(:buy_domain)
+    card_element = find("##{dom_id(card, :article)}")
+
+    card_element.drag_to(in_progress_column)
+
+    within(in_progress_column) do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+    within(maybe_column) do
+      assert_no_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    assert_equal columns(:writebook_in_progress), card.reload.column
+  end
+
+  test "dragging a card from a column back to Maybe" do
+    visit board_url(@board)
+
+    maybe_column = find("#maybe")
+    in_progress_column = find("##{dom_id(columns(:writebook_in_progress))}")
+    within(in_progress_column) { find(".cards__expander").click }
+
+    card = cards(:text)
+    card_element = find("##{dom_id(card, :article)}")
+
+    card_element.drag_to(maybe_column)
+
+    within(maybe_column) do
+      assert_selector "##{dom_id(card, :article)}"
+    end
+    within(in_progress_column) do
+      assert_no_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dragging a card to Not Now and Done" do
+    visit board_url(@board)
+
+    not_now_column = find("#not-now")
+    done_column = find("#closed-cards")
+    card = cards(:buy_domain)
+    card_element = find("##{dom_id(card, :article)}")
+
+    card_element.drag_to(not_now_column)
+
+    within(not_now_column) do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+    assert card.reload.postponed?
+
+    within(not_now_column) { find(".cards__expander").click }
+    card_element = find("##{dom_id(card, :article)}")
+    card_element.drag_to(done_column)
+
+    within(done_column) do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+    assert card.reload.closed?
+  end
+
+  test "dragging a card within the same column keeps column order" do
+    visit board_url(@board)
+
+    triage_column = find("##{dom_id(columns(:writebook_triage))}")
+    within(triage_column) { find(".cards__expander").click }
+
+    logo_card = find("##{dom_id(cards(:logo), :article)}")
+    layout_card = find("##{dom_id(cards(:layout), :article)}")
+
+    card_ids_before = triage_column.all(".cards__list .card").map { |el| el[:id] }
+    assert_equal [ dom_id(cards(:logo), :article), dom_id(cards(:layout), :article) ], card_ids_before
+
+    layout_card.drag_to(logo_card)
+
+    card_ids_after = triage_column.all(".cards__list .card").map { |el| el[:id] }
+    assert_equal card_ids_before, card_ids_after
+  end
+
+  test "dragging a non-golden card into a column with a golden card places it after the golden card without shifting" do
+    visit board_url(@board)
+
+    triage_column = find("##{dom_id(columns(:writebook_triage))}")
+    within(triage_column) { find(".cards__expander").click }
+
+    card = cards(:buy_domain)
+    card_element = find("##{dom_id(card, :article)}")
+
+    card_element.drag_to(triage_column)
+
+    expected_order = [
+      dom_id(cards(:logo), :article),
+      dom_id(cards(:buy_domain), :article),
+      dom_id(cards(:layout), :article)
+    ]
+
+    assert_equal expected_order, triage_column.all(".cards__list .card").map { |el| el[:id] }
+    assert_equal columns(:writebook_triage), card.reload.column
+    assert_equal expected_order, triage_column.all(".cards__list .card").map { |el| el[:id] }
+  end
+
+  test "drag and drop visual classes during drag" do
+    visit board_url(@board)
+
+    card = cards(:buy_domain)
+    card_id = dom_id(card, :article)
+    target_id = dom_id(columns(:writebook_in_progress))
+
+    page.execute_script(<<~JS)
+      const card = document.getElementById("#{card_id}")
+      const target = document.getElementById("#{target_id}")
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true }))
+      target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true }))
+    JS
+
+    assert_selector "##{card_id}.drag-and-drop__dragged-item"
+    assert_selector "##{target_id}.drag-and-drop__hover-container"
+
+    page.execute_script(<<~JS)
+      const target = document.getElementById("#{target_id}")
+      target.dispatchEvent(new DragEvent("dragleave", { bubbles: true }))
+    JS
+
+    assert_no_selector "##{target_id}.drag-and-drop__hover-container"
+    assert_selector "##{card_id}.drag-and-drop__dragged-item"
+
+    page.execute_script(<<~JS)
+      const card = document.getElementById("#{card_id}")
+      card.dispatchEvent(new DragEvent("dragend", { bubbles: true }))
+    JS
+
+    assert_no_selector "##{card_id}.drag-and-drop__dragged-item"
+  end
+end
