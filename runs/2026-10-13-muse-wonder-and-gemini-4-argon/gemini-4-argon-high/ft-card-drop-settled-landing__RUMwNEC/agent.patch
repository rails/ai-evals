diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..2ad372e
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,209 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  dragStart(event) {
+    this.draggedItem = this.#itemFor(event.currentTarget) || this.#itemFor(event.target)
+    if (!this.draggedItem) return
+
+    this.sourceContainer = this.#containerFor(this.draggedItem)
+    this.draggedItem.classList.add(this.#draggedItemClass)
+    this.draggedItem.removeAttribute("aria-selected")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", this.draggedItem.dataset.id || this.draggedItem.id)
+    }
+  }
+
+  dragEnd() {
+    this.#preventClickAfterDrag(this.draggedItem)
+    this.#cleanup()
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#updateHoverContainer(event)
+  }
+
+  dragEnter(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+    this.dragEnterTarget = event.target
+    this.#updateHoverContainer(event)
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFor(event.currentTarget) || this.#containerFor(event.target)
+    if (!container) return
+
+    if (event.relatedTarget && container.contains(event.relatedTarget)) return
+    if (this.dragEnterTarget && this.dragEnterTarget !== event.target && container.contains(this.dragEnterTarget)) return
+
+    container.classList.remove(this.#hoverContainerClass)
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+
+    const targetContainer = this.#containerFor(event.currentTarget) || this.#containerFor(event.target)
+    const sourceContainer = this.sourceContainer || this.#containerFor(this.draggedItem)
+    const draggedItem = this.draggedItem
+
+    this.#preventClickAfterDrag(draggedItem)
+    this.#cleanup()
+
+    if (targetContainer && targetContainer !== sourceContainer) {
+      this.#moveItemToContainer(draggedItem, sourceContainer, targetContainer)
+      this.#submitDrop(draggedItem, targetContainer)
+    }
+  }
+
+  // Private
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  #itemFor(element) {
+    return element?.closest?.('[data-drag-and-drop-target~="item"]')
+  }
+
+  #containerFor(element) {
+    return element?.closest?.('[data-drag-and-drop-target~="container"]')
+  }
+
+  #updateHoverContainer(event) {
+    const container = this.#containerFor(event.currentTarget) || this.#containerFor(event.target)
+    if (!container) return
+
+    this.containerTargets.forEach(target => {
+      target.classList.toggle(this.#hoverContainerClass, target === container)
+    })
+  }
+
+  #preventClickAfterDrag(item) {
+    if (!item) return
+
+    const preventClick = event => {
+      event.preventDefault()
+      event.stopImmediatePropagation()
+    }
+    const cleanup = () => item.removeEventListener("click", preventClick, { capture: true })
+
+    item.addEventListener("click", preventClick, { capture: true, once: true })
+    item.addEventListener("mousedown", cleanup, { capture: true, once: true })
+    setTimeout(cleanup, 100)
+  }
+
+  #cleanup() {
+    this.draggedItem?.classList.remove(this.#draggedItemClass)
+    this.containerTargets.forEach(container => {
+      container.classList.remove(this.#hoverContainerClass)
+    })
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.dragEnterTarget = null
+  }
+
+  #moveItemToContainer(item, sourceContainer, targetContainer) {
+    const keepsGoldenFirst = !targetContainer.classList.contains("cards--on-deck") && !targetContainer.classList.contains("cards--closed")
+    const isGolden = item.classList.contains("golden-effect")
+
+    if (keepsGoldenFirst && !isGolden) {
+      const firstRegularCard = targetContainer.querySelector(".cards__list .card:not(.golden-effect)")
+      if (firstRegularCard) {
+        firstRegularCard.before(item)
+      } else {
+        const goldenCards = targetContainer.querySelectorAll(".cards__list .card.golden-effect")
+        if (goldenCards.length > 0) {
+          goldenCards[goldenCards.length - 1].after(item)
+        } else {
+          this.#prependToCardsList(targetContainer, item)
+        }
+      }
+    } else {
+      const firstCard = targetContainer.querySelector(".cards__list .card")
+      if (firstCard) {
+        firstCard.before(item)
+      } else {
+        this.#prependToCardsList(targetContainer, item)
+      }
+    }
+
+    const cardColor = targetContainer.dataset.dragAndDropCardColor
+    if (cardColor) {
+      item.style.setProperty("--card-color", cardColor)
+    }
+
+    const isPostponed = targetContainer.classList.contains("cards--on-deck")
+    const isClosed = targetContainer.classList.contains("cards--closed")
+    item.classList.toggle("card--postponed", isPostponed)
+    item.classList.toggle("card--active", !isPostponed && !isClosed)
+    item.querySelector(".card__closed")?.remove()
+    item.querySelector(".card__meta-avatars--assignees > [id^='assignees_']")?.toggleAttribute("hidden", isClosed)
+    item.querySelector(".bubble")?.toggleAttribute("hidden", true)
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time[datetime]")
+    if (updatedTime) {
+      updatedTime.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      updatedTime.dispatchEvent(new CustomEvent("turbo:morph-element"))
+    }
+
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, 1)
+  }
+
+  #prependToCardsList(container, item) {
+    const list = container.querySelector("turbo-frame[id*='-pagination-contents-']") || container.querySelector(".cards__list") || container.querySelector("turbo-frame")
+    list?.prepend(item)
+  }
+
+  #adjustCount(container, delta) {
+    const countElement = container?.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentCount = parseInt(countElement.textContent, 10)
+    if (!isNaN(currentCount)) {
+      const newCount = Math.max(0, currentCount + delta)
+      countElement.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+
+  #submitDrop(item, targetContainer) {
+    const urlTemplate = targetContainer.dataset.dragAndDropUrl
+    const itemId = item.dataset.id
+    if (!urlTemplate || !itemId) return
+
+    const url = urlTemplate.replace("__id__", itemId)
+    const method = (
+      targetContainer.dataset.dragAndDropMethod ||
+      new URL(url, window.location.origin).searchParams.get("_method") ||
+      (targetContainer.id === "maybe" ? "delete" : "post")
+    ).toLowerCase()
+
+    if (method === "delete") {
+      destroy(url, { responseKind: "json" })
+    } else {
+      post(url, { responseKind: "json" })
+    }
+  }
+}
