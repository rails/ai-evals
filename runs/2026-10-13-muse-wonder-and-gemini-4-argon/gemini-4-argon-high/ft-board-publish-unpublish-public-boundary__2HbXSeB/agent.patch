+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+    <div class="flex align-center gap">
+      <p class="margin-none">Turn on the public link to share this board with anyone on the web. They won’t need a Fizzy account to see it.</p>
+
+      <%= form_with url: board_publication_path(board), method: board.published? ? :delete : :post, data: { controller: "form" } do %>
+        <label class="switch">
+          <%= check_box_tag :published, 1, board.published?, class: "switch__input", disabled: !Current.user.can_administer_board?(board), data: { action: "change->form#submit" } %>
+          <span class="switch__btn round"></span>
+          <span class="for-screen-reader">Publish this board</span>
+        </label>
+      <% end %>
+    </div>
+
+    <% if board.published? %>
+      <% url = published_board_url(board) %>
+      <div class="flex flex-column gap margin-block-start">
+        <input type="text" class="input fill-white" value="<%= url %>" readonly>
+
+        <div class="flex justify-center gap">
+          <%= button_to_copy_to_clipboard(url) do %>
+            <%= icon_tag "copy-paste" %>
+            <span class="txt-nowrap">Copy public link</span>
+          <% end %>
+
+          <div data-controller="dialog" data-dialog-modal-value="true" class="flex-inline">
+            <%= tag.button class: "btn", data: { action: "dialog#open", controller: "tooltip" } do %>
+              <%= icon_tag "qr-code" %>
+              <span class="for-screen-reader">Display public link QR code</span>
+            <% end %>
+
+            <dialog class="dialog panel shadow" data-dialog-target="dialog" style="--panel-size: 50ch;">
+              <p class="margin-none-block-start txt-balance">
+                <strong>Scan this code to open <%= board.name %>:</strong>
+              </p>
+
+              <%= qr_code_image(url) %>
+
+              <form method="dialog" class="margin-block-start flex justify-center">
+                <button class="btn">
+                  <span>Done</span>
+                </button>
+              </form>
+            </dialog>
+          </div>
+        </div>
+      </div>
+    <% end %>
+  </div>
+<% end %>
