index 0000000..951ce19
--- /dev/null
+++ b/test/controllers/public/boards/cards_controller_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "show published card of published board" do
+    @board.publish
+
+    get public_board_card_path(@board.public_key, @card)
+    assert_response :success
+    assert_select "h1", text: @card.title
+  end
+
+  test "show published card with comments, steps, and reactions" do
+    @board.publish
+    @card.steps.create!(content: "First step", completed: true)
+
+    get public_board_card_path(@board.public_key, @card)
+    assert_response :success
+    assert_select ".step__content", text: "First step"
+    assert_select ".comment", minimum: 1
+  end
+
+  test "cannot show drafted card of published board" do
+    @board.publish
+    draft_card = @board.cards.create!(creator: users(:kevin), title: "Draft card", status: :drafted)
+
+    get public_board_card_path(@board.public_key, draft_card)
+    assert_response :not_found
+  end
+
+  test "cannot show card of unpublished board" do
+    get public_board_card_path("invalid-key", @card)
+    assert_response :not_found
+  end
+
+  test "cannot show card belonging to another board" do
+    @board.publish
+    other_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret card", status: :published)
+    end
+
+    get public_board_card_path(@board.public_key, other_card)
+    assert_response :not_found
+  end
+end
