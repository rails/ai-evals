+require "application_system_test_case"
+
+class EmailAuthenticationTest < ApplicationSystemTestCase
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signing in with an email code" do
+    visit new_session_url(script_name: nil)
+    fill_in "email_address", with: identities(:kevin).email_address
+    click_on "Let’s go"
+
+    assert_selector "h1", text: "Check your email"
+
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject[/\b[A-Z0-9]{6}\b/]
+    assert_not_nil code
+
+    fill_in "code", with: code
+    click_on "Continue"
+
+    assert_current_path root_path
+  end
+
+  test "signing up with an email code" do
+    visit new_signup_url(script_name: nil)
+    fill_in "signup_email_address", with: "newsignup@example.com"
+    click_on "Let’s go"
+
+    assert_selector "h1", text: "Check your email"
+
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject[/\b[A-Z0-9]{6}\b/]
+    assert_not_nil code
+
+    fill_in "code", with: code
+    click_on "Continue"
+
+    assert_selector "h1", text: "Complete your sign-up"
+    fill_in "signup_full_name", with: "Jane Doe"
+    click_on "Continue"
+    assert_no_selector "h1", text: "Complete your sign-up"
+
+    account = Identity.find_by!(email_address: "newsignup@example.com").accounts.first
+    assert_not_nil account
+    assert_equal "Jane Doe", account.users.find_by!(role: :owner).name
+  end
+
+  test "joining with a join code and an email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    visit join_url(code: join_code.code, script_name: account.slug)
+    fill_in "email_address", with: "newjoiner@example.com"
+    click_on "Continue"
+
+    assert_selector "h1", text: "Check your email"
+
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject[/\b[A-Z0-9]{6}\b/]
+    assert_not_nil code
+
+    fill_in "code", with: code
+    click_on "Continue"
+
+    assert_selector "h1", text: "Great! Now enter your name"
+    fill_in "user_name", with: "New Joiner"
+    click_on "Continue"
+    assert_no_selector "h1", text: "Great! Now enter your name"
+
+    user = account.users.joins(:identity).find_by!(identities: { email_address: "newjoiner@example.com" })
+    assert_equal "New Joiner", user.name
+    assert_predicate user, :verified?
+  end
+end
