+require "test_helper"
+
+class MagicLink::CodeTest < ActiveSupport::TestCase
+  test "generate creates code of requested length without ambiguous characters" do
+    100.times do
+      code = MagicLink::Code.generate(6)
+      assert_equal 6, code.length
+      assert_match(/\A[A-Z0-9]{6}\z/, code)
+      assert_no_match(/[OIL]/, code)
+    end
+  end
+
+  test "sanitize normalizes input" do
+    assert_equal "ABC123", MagicLink::Code.sanitize("abc-123")
+    assert_equal "011123", MagicLink::Code.sanitize("oil 123")
+    assert_nil MagicLink::Code.sanitize(nil)
+    assert_nil MagicLink::Code.sanitize("")
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..4bc2e31
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates a 6-character code and sets 15 minute expiration on create" do
+    freeze_time do
+      magic_link = identities(:kevin).magic_links.create!
+
+      assert_equal 6, magic_link.code.length
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert_predicate magic_link, :for_sign_in?
+    end
+  end
+
+  test "consume returns and destroys active magic link" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    consumed = MagicLink.consume(magic_link.code)
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume is case-insensitive and strips whitespace" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    consumed = MagicLink.consume("  #{magic_link.code.downcase} ")
+    assert_equal magic_link, consumed
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume returns nil for expired magic link after 15 minutes" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume works within 15 minutes" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    travel 14.minutes do
+      consumed = MagicLink.consume(magic_link.code)
+      assert_equal magic_link, consumed
+    end
+  end
+
+  test "consume returns nil for invalid or blank code" do
+    assert_nil MagicLink.consume("INVALID")
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume(nil)
+  end
+
+  test "cleanup removes stale magic links" do
+    active_link = identities(:kevin).magic_links.create!
+    stale_link = identities(:david).magic_links.create!(expires_at: 1.minute.ago)
+
+    assert_difference -> { MagicLink.count }, -1 do
+      MagicLink.cleanup
+    end
+
+    assert MagicLink.exists?(active_link.id)
+    assert_not MagicLink.exists?(stale_link.id)
+  end
+end
