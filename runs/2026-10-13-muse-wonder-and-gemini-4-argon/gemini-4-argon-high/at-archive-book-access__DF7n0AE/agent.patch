diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..63e2f22 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,45 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives its access list" do
+    book = books(:manual)
+    expected = book.accesses.map { |a| [ a.user_id, a.user.name, a.level ] }.sort
+
+    assert_difference -> { AccessArchive.count }, +3 do
+      assert_difference -> { Access.count }, -3 do
+        book.destroy!
+      end
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 3, archives.count
+    assert_equal [ "Manual" ], archives.pluck(:book_title).uniq
+    assert_equal expected, archives.pluck(:user_id, :user_name, :level).sort
+  end
+
+  test "destroying a book with no accesses writes no archive rows" do
+    book = Book.create!(title: "Unshared")
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+  end
+
+  test "destroying a book only archives current accesses" do
+    book = Book.create!(title: "Shared Book", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    book.update_access(editors: [], readers: [ users(:kevin).id ])
+
+    assert_equal 0, AccessArchive.where(book_id: book.id).count
+
+    assert_difference -> { AccessArchive.count }, +1 do
+      book.destroy!
+    end
+
+    archive = AccessArchive.find_by!(book_id: book.id)
+    assert_equal users(:kevin).id, archive.user_id
+    assert_equal users(:kevin).name, archive.user_name
+    assert_equal "reader", archive.level
+  end
 end
