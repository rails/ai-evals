diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..d596194
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,64 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div>
+    <h2 class="divider txt-large">Public link</h2>
+    <p class="margin-none-block-start">Turn on the public link to share this board with anyone on the internet. They won’t need to log in, and they won’t be able to make changes — they’ll just see the board and cards.</p>
+
+    <div class="flex align-center justify-center gap">
+      <strong>Publish to the web</strong>
+      <% if board.published? %>
+        <%= form_with url: board_publication_path(board), method: :delete, data: { controller: "form" } do %>
+          <label class="switch">
+            <%= check_box_tag :published, 1, true, class: "switch__input", disabled: !Current.user.can_administer_board?(board), data: { action: "change->form#submit" } %>
+            <span class="switch__btn round"></span>
+            <span class="for-screen-reader">Turn off public link for this board</span>
+          </label>
+        <% end %>
+      <% else %>
+        <%= form_with url: board_publication_path(board), method: :post, data: { controller: "form" } do %>
+          <label class="switch">
+            <%= check_box_tag :published, 1, false, class: "switch__input", disabled: !Current.user.can_administer_board?(board), data: { action: "change->form#submit" } %>
+            <span class="switch__btn round"></span>
+            <span class="for-screen-reader">Turn on public link for this board</span>
+          </label>
+        <% end %>
+      <% end %>
+    </div>
+
+    <% if board.published? %>
+      <% url = published_board_url(board) %>
+      <div class="flex flex-column gap margin-block-start">
+        <div class="flex align-center gap-half">
+          <%= text_field_tag :publication_url, url, readonly: true, class: "input full-width fill-selected", aria: { label: "Public link URL" }, data: { controller: "form", action: "focus->form#select" } %>
+        </div>
+
+        <div class="flex flex-wrap justify-center align-center gap">
+          <%= button_to_copy_to_clipboard(url) do %>
+            <%= icon_tag "copy-paste" %>
+            <span class="txt-nowrap">Copy public link</span>
+          <% end %>
+
+          <div data-controller="dialog" data-dialog-modal-value="true" class="flex-inline">
+            <%= tag.button class: "btn", data: { action: "dialog#open", controller: "tooltip" } do %>
+              <%= icon_tag "qr-code" %>
+              <span>QR code</span>
+            <% end %>
+
+            <dialog class="dialog panel shadow" data-dialog-target="dialog" style="--panel-size: 50ch;">
+              <p class="margin-none-block-start txt-balance">
+                <strong>Scan this code to view <%= board.name %>:</strong>
+              </p>
+
+              <%= qr_code_image(url) %>
+
+              <form method="dialog" class="margin-block-start flex justify-center">
+                <button class="btn">
+                  <span>Done</span>
+                </button>
+              </form>
+            </dialog>
+          </div>
+        </div>
+      </div>
+    <% end %>
+  </div>
+<% end %>
