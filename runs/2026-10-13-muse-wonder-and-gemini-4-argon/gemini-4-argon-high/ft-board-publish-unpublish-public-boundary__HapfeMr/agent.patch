+
   resources :columns, only: [] do
     resource :left_position, module: :columns
     resource :right_position, module: :columns
@@ -235,3 +251,38 @@ Rails.application.routes.draw do
     mount MissionControl::Jobs::Engine, at: "/jobs"
   end
 end
+
+module PublicBoardRouteHelpers
+  %i[
+    public_board
+    public_board_column
+    public_board_card
+    public_board_columns_not_now
+    public_board_columns_stream
+    public_board_columns_closed
+  ].each do |route_name|
+    %i[ path url ].each do |suffix|
+      method_name = :"#{route_name}_#{suffix}"
+      published_method_name = :"#{route_name.to_s.sub(/\Apublic_/, "published_")}_#{suffix}"
+
+      define_method(method_name) do |*args, **options|
+        args = args.map { |arg| arg.is_a?(Board) ? arg.public_key : arg }
+        options[:key] = options[:key].public_key if options[:key].is_a?(Board)
+        options[:board_key] = options[:board_key].public_key if options[:board_key].is_a?(Board)
+        options[:id] = options.delete(:number) if route_name == :public_board_card && options.key?(:number) && !options.key?(:id)
+        super(*args, **options)
+      end
+
+      define_method(published_method_name) do |*args, **options|
+        if route_name == :public_board && args.first.is_a?(Board) && !args.first.published?
+          nil
+        else
+          public_send(method_name, *args, **options)
+        end
+      end
+    end
+  end
+end
+
+Rails.application.routes.named_routes.path_helpers_module.prepend(PublicBoardRouteHelpers)
+Rails.application.routes.named_routes.url_helpers_module.prepend(PublicBoardRouteHelpers)
