diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..17510f7
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "publish board" do
+    board = boards(:writebook)
+    assert_not board.published?
+
+    assert_changes -> { board.reload.published? }, from: false, to: true do
+      post board_publication_path(board), as: :turbo_stream
+      assert_response :success
+    end
+  end
+
+  test "unpublish board" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_changes -> { board.reload.published? }, from: true, to: false do
+      delete board_publication_path(board), as: :turbo_stream
+      assert_response :success
+    end
+  end
+
+  test "publish board as JSON" do
+    board = boards(:writebook)
+
+    assert_changes -> { board.reload.published? }, from: false, to: true do
+      post board_publication_path(board), as: :json
+      assert_response :created
+    end
+
+    assert_equal published_board_url(board), @response.parsed_body["public_url"]
+  end
+
+  test "unpublish board as JSON" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_changes -> { board.reload.published? }, from: true, to: false do
+      delete board_publication_path(board), as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "non-admin cannot publish or unpublish board" do
+    logout_and_sign_in_as :jz
+    board = boards(:writebook)
+
+    assert_no_changes -> { board.reload.published? } do
+      post board_publication_path(board), as: :turbo_stream
+      assert_response :forbidden
+    end
+
+    board.publish
+
+    assert_no_changes -> { board.reload.published? } do
+      delete board_publication_path(board), as: :turbo_stream
+      assert_response :forbidden
+    end
+  end
+
+  test "non-admin cannot publish or unpublish board as JSON" do
+    logout_and_sign_in_as :jz
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+    assert_response :forbidden
+
+    board.publish
+
+    delete board_publication_path(board), as: :json
+    assert_response :forbidden
+  end
+end
