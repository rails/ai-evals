diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..a886521
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,36 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  class_methods do
+    def find_by_published_key(key)
+      published.find_by!(publication: { key: key })
+    end
+  end
+
+  def published?
+    publication.present? && !publication.destroyed?
+  end
+  alias_method :publicly_accessible?, :published?
+
+  def public_key
+    publication.key if published?
+  end
+
+  def publish
+    if published?
+      publication
+    else
+      create_publication!
+    end
+  end
+
+  def unpublish
+    publication&.destroy
+  end
+end
