diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..1399a37
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,28 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.turbo_stream { render_publication_partial }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.turbo_stream { render_publication_partial }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def render_publication_partial
+      render turbo_stream: turbo_stream.replace([ @board, :publication ], partial: "boards/edit/publication", locals: { board: @board })
+    end
+end
