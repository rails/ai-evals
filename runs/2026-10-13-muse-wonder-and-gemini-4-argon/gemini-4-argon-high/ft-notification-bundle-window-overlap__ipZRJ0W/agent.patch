@@ -0,0 +1,30 @@
+class Notification::BundleMailer < ApplicationMailer
+  include ActionView::Helpers::TextHelper
+  helper NotificationsHelper
+
+  def notification(bundle)
+    @user = bundle.user
+    @bundle = bundle
+    @notifications = bundle.notifications
+    @unsubscribe_token = @user.signed_id(purpose: :unsubscribe, expires_in: 1.month)
+
+    headers \
+      "List-Unsubscribe-Post" => "List-Unsubscribe=One-Click",
+      "List-Unsubscribe" => "<#{notifications_unsubscribe_url(access_token: @unsubscribe_token)}>"
+
+    @user.in_time_zone do
+      mail \
+        to: @user.identity.email_address,
+        subject: "#{@bundle.account.name}: #{pluralize(@notifications.count, "new notification")}"
+    end
+  end
+
+  private
+    def default_url_options
+      if @bundle&.account
+        super.merge(script_name: @bundle.account.slug)
+      else
+        super
+      end
+    end
+end
