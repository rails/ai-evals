+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :reset_created_at_on_source_change
+    after_save :bundle, if: :saved_change_to_source_id?
+  end
+
+  def bundle
+    user.bundle(self) if bundlable?
+  end
+
+  private
+    def bundlable?
+      !creator.system? && user.active? && account.active? && user.bundling_emails?
+    end
+
+    def reset_created_at_on_source_change
+      self.created_at = Time.current if source_id_changed? && !created_at_changed?
+    end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..03db0f6
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,92 @@
+class Notification::Bundle < ApplicationRecord
+  DEFAULT_WINDOW_DURATION = 4.hours
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  enum :status, %i[ pending processing delivered ].index_by(&:itself), default: :pending
+
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+  scope :containing, ->(notification) { where(starts_at: ..notification.created_at, ends_at: notification.created_at..) }
+  scope :overlapping_with, ->(bundle) {
+    where(user: bundle.user)
+      .where.not(id: bundle.id)
+      .where(
+        "(status = 'pending' AND starts_at <= :ends_at AND ends_at >= :starts_at) OR (starts_at < :ends_at AND ends_at > :starts_at)",
+        starts_at: bundle.starts_at,
+        ends_at: bundle.ends_at
+      )
+  }
+
+  before_validation :set_default_window, on: :create
+
+  validates :starts_at, :ends_at, presence: true
+  validate :validate_ends_at_after_starts_at
+  validate :validate_no_overlapping_bundles
+
+  class << self
+    def deliver_all
+      due.find_each(&:deliver_later)
+    end
+    alias_method :deliver_all_later, :deliver_all
+
+    def deliver_all_now
+      due.find_each(&:deliver)
+    end
+
+    def bundle(notification)
+      notification.bundle
+    end
+  end
+
+  def notifications
+    user.notifications.unread.where(created_at: window)
+  end
+
+  def window
+    starts_at..ends_at
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Notification::Bundle::DeliverJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    Current.with_account(account) do
+      user.in_time_zone do
+        processing!
+        Notification::BundleMailer.notification(self).deliver_now if should_deliver?
+        delivered!
+      end
+    end
+  end
+  alias_method :deliver_now, :deliver
+
+  private
+    def set_default_window
+      self.starts_at ||= Time.current
+      self.ends_at ||= starts_at + window_duration
+    end
+
+    def window_duration
+      user&.bundle_email_period || DEFAULT_WINDOW_DURATION
+    end
+
+    def validate_ends_at_after_starts_at
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after start time")
+      end
+    end
+
+    def validate_no_overlapping_bundles
+      if starts_at.present? && ends_at.present? && self.class.overlapping_with(self).exists?
+        errors.add(:base, "Window cannot overlap with another bundle")
+      end
+    end
+
+    def should_deliver?
+      notifications.any? && !user.system? && user.active? && account.active? && user.identity&.email_address.present?
+    end
+end
