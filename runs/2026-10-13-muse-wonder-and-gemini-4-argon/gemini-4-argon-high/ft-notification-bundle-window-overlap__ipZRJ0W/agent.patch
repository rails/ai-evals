diff --git a/app/models/user/configurable.rb b/app/models/user/configurable.rb
index c9c5adf..6b42f1d 100644
--- a/app/models/user/configurable.rb
+++ b/app/models/user/configurable.rb
@@ -7,10 +7,34 @@ module User::Configurable
 
     after_create :create_settings, unless: :system?
 
-    delegate :timezone, to: :settings, allow_nil: true
+    delegate :timezone, :bundling_emails?, :bundle_email_frequency, :bundle_email_period, to: :settings, allow_nil: true
   end
 
   def in_time_zone(&block)
     Time.use_zone(timezone, &block)
   end
+
+  def bundle(notification)
+    if bundling_emails?
+      notification_bundles.pending.containing(notification).first ||
+        include_in_pending_bundle(notification) ||
+        create_bundle_for(notification)
+    end
+  end
+
+  private
+    def include_in_pending_bundle(notification)
+      if pending_bundle = notification_bundles.pending.where(ends_at: notification.created_at..).order(:starts_at).first
+        earliest_start = notification_bundles.where.not(id: pending_bundle.id).where(ends_at: ..pending_bundle.starts_at).maximum(:ends_at)
+        new_starts_at = [ notification.created_at, earliest_start ].compact.max
+        pending_bundle.update!(starts_at: new_starts_at) if new_starts_at < pending_bundle.starts_at
+        pending_bundle
+      end
+    end
+
+    def create_bundle_for(notification)
+      earliest_start = notification_bundles.where("ends_at > ?", notification.created_at).maximum(:ends_at)
+      starts_at = [ notification.created_at, earliest_start ].compact.max
+      notification_bundles.create!(starts_at: starts_at)
+    end
 end
