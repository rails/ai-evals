+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card from maybe to a column" do
+    visit board_url(@board)
+
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+
+    find("#maybe ##{dom_id(card, :article)}").drag_to(find("##{dom_id(column)}"))
+
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(column)} .cards__expander-count", text: "2"
+
+    find("##{dom_id(column)} .cards__expander").click
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}"
+    assert_equal column, card.reload.column
+  end
+
+  test "dragging a card between columns and back to maybe" do
+    visit board_url(@board)
+
+    card = cards(:text)
+    source_column = columns(:writebook_in_progress)
+    target_column = columns(:writebook_on_hold)
+
+    find("##{dom_id(source_column)} .cards__expander").click
+    assert_selector "##{dom_id(source_column)} ##{dom_id(card, :article)}"
+
+    find("##{dom_id(source_column)} ##{dom_id(card, :article)}").drag_to(find("##{dom_id(target_column)}"))
+
+    assert_no_selector "##{dom_id(source_column)} ##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(target_column)} .cards__expander-count", text: "1"
+
+    find("##{dom_id(target_column)} .cards__expander").click
+    assert_selector "##{dom_id(target_column)} ##{dom_id(card, :article)}"
+    assert_equal target_column, card.reload.column
+
+    find("##{dom_id(target_column)} ##{dom_id(card, :article)}").drag_to(find("#maybe"))
+
+    assert_no_selector "##{dom_id(target_column)} ##{dom_id(card, :article)}"
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dragging a card to not now and done" do
+    visit board_url(@board)
+
+    card = cards(:buy_domain)
+
+    find("#maybe ##{dom_id(card, :article)}").drag_to(find("#not-now"))
+
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    assert_selector "#not-now .cards__expander-count", text: "1"
+
+    find("#not-now .cards__expander").click
+    assert_selector "#not-now ##{dom_id(card, :article)}"
+    assert card.reload.postponed?
+
+    find("#not-now ##{dom_id(card, :article)}").drag_to(find("#closed-cards"))
+
+    assert_no_selector "#not-now ##{dom_id(card, :article)}"
+    assert_selector "#closed-cards .cards__expander-count", text: "2"
+
+    find("#closed-cards .cards__expander").click
+    assert_selector "#closed-cards ##{dom_id(card, :article)}"
+    assert card.reload.closed?
+  end
+
+  test "columns keep their own order when dropping a card" do
+    visit board_url(@board)
+
+    card = cards(:buy_domain)
+    logo = cards(:logo)
+    layout = cards(:layout)
+    triage = columns(:writebook_triage)
+
+    find("##{dom_id(triage)} .cards__expander").click
+    assert_selector "##{dom_id(triage)}.is-expanded"
+
+    # Dropping within the same column does not reorder cards
+    find("##{dom_id(triage)} ##{dom_id(layout, :article)}").drag_to(find("##{dom_id(triage)} ##{dom_id(logo, :article)}"))
+    card_ids = all("##{dom_id(triage)} .cards__list .card").map { |el| el[:id] }
+    assert_equal [ dom_id(logo, :article), dom_id(layout, :article) ], card_ids
+
+    # Dropping a non-golden card from another column places it after golden cards
+    find("#maybe ##{dom_id(card, :article)}").drag_to(find("##{dom_id(triage)}"))
+    card_ids = all("##{dom_id(triage)} .cards__list .card").map { |el| el[:id] }
+    assert_equal [ dom_id(logo, :article), dom_id(card, :article), dom_id(layout, :article) ], card_ids
+  end
+
+  test "drag styles apply to dragged card and hovered column" do
+    visit board_url(@board)
+
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+    card_id = dom_id(card, :article)
+    column_id = dom_id(column)
+
+    page.execute_script(<<~JS)
+      const card = document.getElementById("#{card_id}");
+      const dt = new DataTransfer();
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: dt }));
+    JS
+
+    assert_selector "##{card_id}.drag-and-drop__dragged-item"
+
+    page.execute_script(<<~JS)
+      const column = document.getElementById("#{column_id}");
+      const dt = new DataTransfer();
+      column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: dt }));
+    JS
+
+    assert_selector "##{column_id}.drag-and-drop__hover-container"
+
+    page.execute_script(<<~JS)
+      const column = document.getElementById("#{column_id}");
+      column.dispatchEvent(new DragEvent("dragleave", { bubbles: true, cancelable: true }));
+    JS
+
+    assert_no_selector "##{column_id}.drag-and-drop__hover-container"
+
+    page.execute_script(<<~JS)
+      const card = document.getElementById("#{card_id}");
+      card.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true }));
+    JS
+
+    assert_no_selector "##{card_id}.drag-and-drop__dragged-item"
+  end
+end
