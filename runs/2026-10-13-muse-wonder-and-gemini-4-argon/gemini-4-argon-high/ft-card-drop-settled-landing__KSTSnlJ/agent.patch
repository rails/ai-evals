diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..b95f3d4
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,193 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const ID_PLACEHOLDER = "__id__"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  dragStart(event) {
+    if (event.target.closest("dialog")) {
+      event.preventDefault()
+      return
+    }
+
+    this.draggedItem = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!this.draggedItem) return
+
+    this.sourceContainer = this.#containerFor(this.draggedItem)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", this.draggedItem.dataset.id || this.draggedItem.id)
+    }
+
+    this.draggedItem.classList.add(this.#draggedItemClass)
+  }
+
+  dragEnd() {
+    this.#cleanup()
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    const container = this.#containerFor(event.target)
+    if (container) {
+      this.#highlightContainer(container)
+    }
+  }
+
+  dragEnter(event) {
+    this.dragOver(event)
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFor(event.target)
+    if (container && !container.contains(event.relatedTarget)) {
+      container.classList.remove(this.#hoverContainerClass)
+    }
+  }
+
+  async drop(event) {
+    if (!this.draggedItem) return
+    event.preventDefault()
+
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer || this.#containerFor(item)
+    const targetContainer = this.#containerFor(event.target)
+
+    this.#cleanup()
+
+    if (!targetContainer || targetContainer === sourceContainer) return
+
+    this.#moveItem(item, sourceContainer, targetContainer)
+    await this.#saveDrop(item, targetContainer)
+  }
+
+  #containerFor(element) {
+    return element?.closest('[data-drag-and-drop-target~="container"]')
+  }
+
+  #highlightContainer(activeContainer) {
+    this.containerTargets.forEach(container => {
+      container.classList.toggle(this.#hoverContainerClass, container === activeContainer)
+    })
+  }
+
+  #cleanup() {
+    if (this.draggedItem) {
+      const item = this.draggedItem
+      const cleanupClick = () => item.removeEventListener("click", this.#preventClick, { capture: true })
+
+      item.classList.remove(this.#draggedItemClass)
+      item.addEventListener("click", this.#preventClick, { capture: true, once: true })
+      item.addEventListener("mousedown", cleanupClick, { capture: true, once: true })
+      setTimeout(cleanupClick, 150)
+    }
+
+    this.itemTargets.forEach(item => item.classList.remove(this.#draggedItemClass))
+    this.containerTargets.forEach(container => container.classList.remove(this.#hoverContainerClass))
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  #preventClick = (event) => {
+    event.preventDefault()
+    event.stopPropagation()
+  }
+
+  #moveItem(item, sourceContainer, targetContainer) {
+    this.#insertItemIntoContainer(item, targetContainer)
+    this.#updateItemAppearance(item, targetContainer)
+    this.#adjustContainerCount(sourceContainer, -1)
+    this.#adjustContainerCount(targetContainer, 1)
+  }
+
+  #insertItemIntoContainer(item, targetContainer) {
+    const cardsList = targetContainer.querySelector(".cards__list")
+    if (!cardsList) return
+
+    const isGolden = item.classList.contains("golden-effect")
+    const goldenFirst = !targetContainer.classList.contains("cards--on-deck") && !targetContainer.classList.contains("cards--closed")
+
+    const targetCard = (!isGolden && goldenFirst)
+      ? cardsList.querySelector(".card:not(.golden-effect)")
+      : cardsList.querySelector(".card")
+
+    if (targetCard) {
+      targetCard.before(item)
+    } else {
+      const goldenCards = cardsList.querySelectorAll(".card.golden-effect")
+      if (!isGolden && goldenFirst && goldenCards.length > 0) {
+        goldenCards[goldenCards.length - 1].after(item)
+      } else {
+        const paginationFrame = cardsList.querySelector("turbo-frame")
+        if (paginationFrame) {
+          paginationFrame.prepend(item)
+        } else {
+          cardsList.prepend(item)
+        }
+      }
+    }
+  }
+
+  #updateItemAppearance(item, targetContainer) {
+    if (targetContainer.dataset.cardColor) {
+      item.style.setProperty("--card-color", targetContainer.dataset.cardColor)
+    }
+
+    if (targetContainer.classList.contains("cards--on-deck")) {
+      item.classList.add("card--postponed")
+      item.classList.remove("card--active")
+    } else if (targetContainer.classList.contains("cards--closed")) {
+      item.classList.remove("card--postponed", "card--active")
+    } else {
+      item.classList.remove("card--postponed")
+      item.classList.add("card--active")
+      item.querySelector(".card__closed")?.remove()
+    }
+
+    item.querySelector(".bubble")?.setAttribute("hidden", "")
+    item.removeAttribute("aria-selected")
+  }
+
+  #adjustContainerCount(container, delta) {
+    const countElement = container?.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentCount = parseInt(countElement.textContent, 10)
+    if (!isNaN(currentCount)) {
+      const newCount = Math.max(0, currentCount + delta)
+      countElement.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+
+  async #saveDrop(item, targetContainer) {
+    const urlTemplate = targetContainer.dataset.dragAndDropUrl
+    const cardId = item.dataset.id
+    if (!urlTemplate || !cardId) return
+
+    const url = urlTemplate.replace(ID_PLACEHOLDER, cardId)
+    const method = targetContainer.dataset.dragAndDropMethod || "post"
+    const request = new FetchRequest(method, url, { responseKind: "turbo-stream" })
+
+    await request.perform()
+  }
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+}
