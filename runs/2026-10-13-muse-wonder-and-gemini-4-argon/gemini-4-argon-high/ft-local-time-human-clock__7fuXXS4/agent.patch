@@ -1,2 +1,10 @@
 module TimeHelper
+  def local_datetime_tag(datetime, style: :time, **attributes)
+    return if datetime.blank?
+
+    tag.time **attributes,
+      class: [ "local-time-value", attributes[:class] ],
+      datetime: datetime.iso8601,
+      data: { local_time_target: style, **(attributes[:data] || {}) }
+  end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..ecc468d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,175 @@
+import { Controller } from "@hotwired/stimulus"
+import { currentTimezone, signedDifferenceInDays } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 3_600_000 // 1 hour (in milliseconds)
+
+export default class extends Controller {
+  static targets = [ "time", "date", "datetime", "shortdate", "ago", "indays", "daysago", "agoorweekday" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.#refreshRelativeTimes(), REFRESH_INTERVAL)
+    this.element.addEventListener("turbo:morph-element", this.#handleMorphElement)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.element.removeEventListener("turbo:morph-element", this.#handleMorphElement)
+  }
+
+  refreshAll() {
+    this.timeTargets.forEach(element => this.timeTargetConnected(element))
+    this.dateTargets.forEach(element => this.dateTargetConnected(element))
+    this.datetimeTargets.forEach(element => this.datetimeTargetConnected(element))
+    this.shortdateTargets.forEach(element => this.shortdateTargetConnected(element))
+    this.#refreshRelativeTimes()
+  }
+
+  timeTargetConnected(element) {
+    this.#formatTime(this.#timeFormat, element)
+  }
+
+  dateTargetConnected(element) {
+    this.#formatTime(this.#dateFormat, element)
+  }
+
+  datetimeTargetConnected(element) {
+    this.#formatTime(this.#datetimeFormat, element)
+  }
+
+  shortdateTargetConnected(element) {
+    this.#formatTime(this.#shortdateFormat, element)
+  }
+
+  agoTargetConnected(element) {
+    this.#formatAgo(element)
+  }
+
+  indaysTargetConnected(element) {
+    this.#formatIndays(element)
+  }
+
+  daysagoTargetConnected(element) {
+    this.#formatDaysago(element)
+  }
+
+  agoorweekdayTargetConnected(element) {
+    this.#formatAgoorweekday(element)
+  }
+
+  #refreshRelativeTimes() {
+    this.agoTargets.forEach(element => this.#formatAgo(element))
+    this.indaysTargets.forEach(element => this.#formatIndays(element))
+    this.daysagoTargets.forEach(element => this.#formatDaysago(element))
+    this.agoorweekdayTargets.forEach(element => this.#formatAgoorweekday(element))
+  }
+
+  #handleMorphElement = ({ target }) => {
+    const style = target.dataset?.localTimeTarget
+    if (style) {
+      this[`${style}TargetConnected`]?.(target)
+    }
+  }
+
+  #formatTime(formatter, element) {
+    const date = this.#parseDate(element)
+    if (!date) return
+
+    element.textContent = this.#normalizeSpaces(formatter.format(date))
+    element.title = this.#normalizeSpaces(this.#datetimeFormat.format(date))
+  }
+
+  #formatAgo(element) {
+    const date = this.#parseDate(element)
+    if (!date) return
+
+    const days = signedDifferenceInDays(date, new Date())
+
+    if (days <= 0) {
+      this.#formatTime(this.#timeFormat, element)
+    } else if (days === 1) {
+      element.textContent = this.#agoFormat.format(-1, "day")
+      element.title = this.#normalizeSpaces(this.#datetimeFormat.format(date))
+    } else {
+      this.#formatTime(this.#shortdateFormat, element)
+    }
+  }
+
+  #formatIndays(element) {
+    const date = this.#parseDate(element)
+    if (!date) return
+
+    const days = Math.max(0, signedDifferenceInDays(new Date(), date))
+    element.textContent = this.#agoFormat.format(days, "day")
+    element.title = this.#normalizeSpaces(this.#datetimeFormat.format(date))
+  }
+
+  #formatDaysago(element) {
+    const date = this.#parseDate(element)
+    if (!date) return
+
+    const days = Math.max(0, signedDifferenceInDays(date, new Date()))
+    element.textContent = this.#agoFormat.format(-days, "day")
+    element.title = this.#normalizeSpaces(this.#datetimeFormat.format(date))
+  }
+
+  #formatAgoorweekday(element) {
+    const date = this.#parseDate(element)
+    if (!date) return
+
+    const days = signedDifferenceInDays(date, new Date())
+
+    if (days < 7) {
+      this.#formatDaysago(element)
+    } else {
+      this.#formatTime(this.#weekdayFormat, element)
+    }
+  }
+
+  #parseDate(element) {
+    const value = element.getAttribute("datetime")
+    if (!value) return null
+
+    const date = /^\d+$/.test(value) ? new Date(parseInt(value, 10) * 1000) : new Date(value)
+    return isNaN(date) ? null : date
+  }
+
+  #normalizeSpaces(string) {
+    return string.replace(/\s+/g, " ")
+  }
+
+  get #timeFormat() {
+    return this.#buildDateTimeFormat({ timeStyle: "short" })
+  }
+
+  get #dateFormat() {
+    return this.#buildDateTimeFormat({ dateStyle: "medium" })
+  }
+
+  get #datetimeFormat() {
+    return this.#buildDateTimeFormat({ dateStyle: "short", timeStyle: "short" })
+  }
+
+  get #shortdateFormat() {
+    return this.#buildDateTimeFormat({ month: "short", day: "numeric" })
+  }
+
+  get #weekdayFormat() {
+    return this.#buildDateTimeFormat({ weekday: "long", month: "long", day: "numeric" })
+  }
+
+  get #agoFormat() {
+    return new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+  }
+
+  #buildDateTimeFormat(options) {
+    const timeZone = currentTimezone()
+
+    try {
+      return new Intl.DateTimeFormat("en-US", { ...options, timeZone })
+    } catch {
+      return new Intl.DateTimeFormat("en-US", options)
+    }
+  }
+}
