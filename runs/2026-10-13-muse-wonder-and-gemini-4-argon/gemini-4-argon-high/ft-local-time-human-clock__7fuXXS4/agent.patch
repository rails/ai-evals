+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders comments and card times in the viewer's timezone" do
+    card = cards(:logo)
+    card.comments.destroy_all
+
+    ny_zone = ActiveSupport::TimeZone["America/New_York"]
+    ny_today = Time.current.in_time_zone(ny_zone)
+
+    # Today at 1:42 PM in New York (17:42 UTC or 18:42 UTC depending on DST)
+    comment_today = card.comments.create!(
+      creator: users(:kevin),
+      body: "Comment from today",
+      created_at: ny_today.change(hour: 13, min: 42, sec: 0)
+    )
+
+    # Last night in New York (10:30 PM yesterday in NY, which is already 02:30/03:30 UTC today!)
+    comment_last_night = card.comments.create!(
+      creator: users(:jz),
+      body: "Comment from last night",
+      created_at: (ny_today - 1.day).change(hour: 22, min: 30, sec: 0)
+    )
+
+    # Earlier in the week (5 days ago at 10:00 AM in NY)
+    comment_earlier_in_week = card.comments.create!(
+      creator: users(:david),
+      body: "Comment from earlier in the week",
+      created_at: (ny_today - 5.days).change(hour: 10, min: 0, sec: 0)
+    )
+
+    # Older comment (Sep 12, 2025 at 1:42 PM in NY)
+    comment_older = card.comments.create!(
+      creator: users(:david),
+      body: "Older comment",
+      created_at: ny_zone.local(2025, 9, 12, 13, 42, 0)
+    )
+
+    # Card auto-closing overnight in NY (1:00 AM tomorrow in NY)
+    entropy_period = card.board.entropy.auto_postpone_period
+    card.update!(
+      created_at: (ny_today - 5.days).change(hour: 10, min: 0, sec: 0),
+      last_active_at: (ny_today + 1.day).change(hour: 1, min: 0, sec: 0) - entropy_period
+    )
+
+    sign_in_as(users(:david))
+    set_browser_timezone("America/New_York")
+    visit card_url(card)
+
+    within("##{dom_id(card, :meta)}") do
+      assert_selector ".card__meta-text--added time[data-local-time-target='daysago']", text: /\A5 days ago\z/i
+    end
+
+    within("##{dom_id(comment_today)}") do
+      assert_selector "time[data-local-time-target='agoorweekday']", text: /\Atoday\z/i
+      assert_selector "time[data-local-time-target='time']", text: "1:42 PM"
+    end
+
+    within("##{dom_id(comment_last_night)}") do
+      assert_selector "time[data-local-time-target='agoorweekday']", text: /\Ayesterday\z/i
+      assert_selector "time[data-local-time-target='time']", text: "10:30 PM"
+    end
+
+    within("##{dom_id(comment_earlier_in_week)}") do
+      assert_selector "time[data-local-time-target='agoorweekday']", text: /\A5 days ago\z/i
+      assert_selector "time[data-local-time-target='time']", text: "10:00 AM"
+    end
+
+    within("##{dom_id(comment_older)}") do
+      assert_selector "time[data-local-time-target='agoorweekday']", text: "Friday, September 12"
+      assert_selector "time[data-local-time-target='time']", text: "1:42 PM"
+    end
+
+    within("##{dom_id(card, :closure_notice)}") do
+      assert_selector "time[data-local-time-target='indays']", text: "tomorrow"
+    end
+
+    # Card auto-closing in 3 days
+    card.update!(last_active_at: (ny_today + 3.days).change(hour: 13, min: 0, sec: 0) - entropy_period)
+    visit card_url(card)
+
+    within("##{dom_id(card, :closure_notice)}") do
+      assert_selector "time[data-local-time-target='indays']", text: "in 3 days"
+    end
+
+    # Closed card stamp and closure message
+    card.close(user: users(:david))
+    card.closure.update!(created_at: ny_zone.local(2025, 9, 12, 13, 42, 0))
+    visit card_url(card)
+
+    within("##{dom_id(card, :card_closure_toggle)}") do
+      assert_selector "time[data-local-time-target='shortdate']", text: "Sep 12"
+    end
+
+    assert_selector ".card__closed-date time[data-local-time-target='date']", text: /\ASep 12, 2025\z/i
+  ensure
+    set_browser_timezone("UTC")
+  end
+
+  private
+    def set_browser_timezone(timezone_id)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone_id)
+    end
+end
