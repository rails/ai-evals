+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag renders a time element with default style" do
+    timestamp = Time.utc(2025, 9, 12, 13, 42, 0)
+
+    assert_dom_equal \
+      %(<time class="local-time-value" datetime="2025-09-12T13:42:00Z" data-local-time-target="time"></time>),
+      local_datetime_tag(timestamp)
+  end
+
+  test "local_datetime_tag renders custom style and attributes" do
+    timestamp = Time.utc(2025, 9, 12, 13, 42, 0)
+
+    assert_dom_equal \
+      %(<time class="local-time-value custom-class" id="my-time" datetime="2025-09-12T13:42:00Z" data-local-time-target="daysago" data-extra="true"></time>),
+      local_datetime_tag(timestamp, style: :daysago, id: "my-time", class: "custom-class", data: { extra: true })
+  end
+
+  test "local_datetime_tag returns nil when datetime is blank" do
+    assert_nil local_datetime_tag(nil)
+  end
+end
