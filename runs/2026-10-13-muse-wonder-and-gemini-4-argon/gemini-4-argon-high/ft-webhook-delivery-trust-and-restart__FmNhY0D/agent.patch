index 0000000..4de86dd
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "records failure and sets first_failure_at on first failure" do
+    freeze_time
+
+    @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert_equal Time.current, @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "resets when a delivery succeeds" do
+    @tracker.update!(consecutive_failures_count: 5, first_failure_at: 30.minutes.ago)
+
+    @tracker.record_delivery_of(webhook_deliveries(:successfully_completed))
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "does not deactivate webhook before 10 consecutive failures" do
+    freeze_time
+
+    @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+
+    travel 2.hours
+
+    8.times do
+      @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+    end
+
+    assert_equal 9, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "does not deactivate webhook when 10 failures happen in less than an hour" do
+    freeze_time
+
+    @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+
+    travel 59.minutes
+
+    9.times do
+      @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+    end
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "deactivates webhook after 10 consecutive failures over an hour" do
+    freeze_time
+
+    @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+
+    travel 1.hour + 1.second
+
+    9.times do
+      @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+    end
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert_not @webhook.reload.active?
+  end
+end
