@@ -0,0 +1,19 @@
+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :triggered_by, ->(event) { active.where(board: event.board).for_actions(event.action) }
+    scope :for_actions, ->(*actions) do
+      actions = actions.flatten.map(&:to_s).uniq & Webhook::PERMITTED_ACTIONS
+      if actions.any?
+        where(actions.map { "subscribed_actions LIKE ?" }.join(" OR "), *actions.map { "%\"#{it}\"%" })
+      else
+        none
+      end
+    end
+  end
+
+  def trigger(event)
+    deliveries.create!(event: event)
+  end
+end
