@@ -29,4 +59,91 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      else
+        "application/json"
+      end
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest(OpenSSL::Digest.new("sha256"), webhook.signing_secret, payload)
+    end
+
+    def payload
+      @payload ||= if webhook.for_basecamp?
+        { content: render_payload(formats: :html) }.to_json
+      elsif webhook.for_slack?
+        { text: convert_html_to_mrkdwn(render_payload(formats: :html)) }.to_json
+      elsif webhook.for_campfire?
+        render_payload(formats: :html)
+      else
+        render_payload(formats: :json)
+      end
+    end
+
+    def render_payload(formats:)
+      webhook.renderer.render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: formats,
+        layout: false
+      ).strip
+    end
+
+    def convert_html_to_mrkdwn(html)
+      CGI.unescapeHTML(html).gsub(/<a\s+href="([^"]+)">([^<]+)<\/a>/i, '<\1|\2>')
+    end
+
+    def perform_request
+      if resolved_ip
+        response = http.request(http_request)
+        { code: response.code.to_i }
+      else
+        { error: :destination_unreachable }
+      end
+    rescue OpenSSL::SSL::SSLError
+      { error: :tls_error }
+    rescue Net::OpenTimeout, Net::ReadTimeout
+      { error: :connection_timeout }
+    rescue Resolv::ResolvError, Resolv::ResolvTimeout, SocketError, SystemCallError, IOError, Net::ProtocolError
+      { error: :destination_unreachable }
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+      @resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = (uri.scheme == "https")
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def http_request
+      Net::HTTP::Post.new(uri.request_uri, headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
 end
