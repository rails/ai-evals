--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "creating an event enqueues RelayJob" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      boards(:writebook).events.create!(
+        action: "card_published",
+        creator: users(:david),
+        eventable: cards(:logo)
+      )
+    end
+  end
+
+  test "relay_now triggers active subscribed webhooks on the same board" do
+    event = events(:logo_published)
+    webhook = webhooks(:active)
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      assert_enqueued_with(job: Webhook::DeliveryJob) do
+        event.relay_now
+      end
+    end
+
+    delivery = webhook.deliveries.ordered.first
+    assert_equal event, delivery.event
+    assert_equal "pending", delivery.state
+  end
+
+  test "relay_now does not trigger webhooks for unsubscribed actions" do
+    event = events(:layout_commented)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs(only: Webhook::DeliveryJob) do
+        event.relay_now
+      end
+    end
+  end
+
+  test "relay_now does not trigger inactive webhooks" do
+    webhook = webhooks(:active)
+    webhook.deactivate
+    event = events(:logo_published)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs(only: Webhook::DeliveryJob) do
+        event.relay_now
+      end
+    end
+  end
+
+  test "end-to-end event creation relays and delivers webhook exactly once" do
+    webhook = webhooks(:active)
+    received_request = nil
+
+    stub = stub_request(:post, webhook.url).to_return do |request|
+      received_request = request
+      { status: 200, headers: { "Content-Type" => "application/json" } }
+    end
+
+    event = nil
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs do
+        event = boards(:writebook).events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo)
+        )
+      end
+    end
+
+    assert_requested stub, times: 1
+    expected_signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, received_request.body)
+    assert_equal expected_signature, received_request.headers["X-Webhook-Signature"]
+    assert_equal event.created_at.utc.iso8601, received_request.headers["X-Webhook-Timestamp"]
+
+    payload = JSON.parse(received_request.body)
+    assert_equal event.id, payload["id"]
+    assert_equal "card_published", payload["action"]
+    assert_equal cards(:logo).id, payload.dig("eventable", "id")
+
+    delivery = webhook.deliveries.ordered.first
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+  end
+end
