diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..2618cff
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,46 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  DELINQUENCY_THRESHOLD = 10
+  DELINQUENCY_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_delivery_of(delivery)
+    if delivery.succeeded?
+      reset
+    elsif delivery.failed?
+      record_failure
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def delinquent?
+    failing_for_too_long? && too_many_consecutive_failures?
+  end
+
+  private
+    def record_failure
+      transaction do
+        self.first_failure_at = Time.current if consecutive_failures_count.to_i.zero? || first_failure_at.nil?
+        self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+        save!
+
+        webhook.deactivate if delinquent?
+      end
+    end
+
+    def failing_for_too_long?
+      if first_failure_at
+        first_failure_at <= DELINQUENCY_DURATION.ago
+      else
+        false
+      end
+    end
+
+    def too_many_consecutive_failures?
+      consecutive_failures_count.to_i >= DELINQUENCY_THRESHOLD
+    end
+end
