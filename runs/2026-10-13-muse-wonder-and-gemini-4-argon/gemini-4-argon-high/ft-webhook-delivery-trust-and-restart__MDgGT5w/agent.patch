@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "recording a failed delivery increments consecutive failures and sets first failure timestamp" do
+    freeze_time
+
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    delivery = webhook_deliveries(:unsuccessfully_completed)
+
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+
+    tracker.record_delivery_of(delivery)
+
+    assert_equal 1, tracker.consecutive_failures_count
+    assert_equal Time.current, tracker.first_failure_at
+    assert webhook.reload.active?
+  end
+
+  test "recording a succeeded delivery resets failures" do
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    tracker.update!(consecutive_failures_count: 5, first_failure_at: 30.minutes.ago)
+
+    delivery = webhook_deliveries(:successfully_completed)
+    tracker.record_delivery_of(delivery)
+
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "deactivates webhook after 10 consecutive failures over an hour" do
+    freeze_time
+
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    failed_delivery = webhook_deliveries(:unsuccessfully_completed)
+
+    tracker.record_delivery_of(failed_delivery)
+    assert_equal 1, tracker.consecutive_failures_count
+    assert_equal Time.current, tracker.first_failure_at
+
+    travel 59.minutes
+    9.times { tracker.record_delivery_of(failed_delivery) }
+
+    assert_equal 10, tracker.consecutive_failures_count
+    assert webhook.reload.active?, "Should not deactivate before 1 hour has elapsed since first failure"
+
+    travel 2.minutes
+    tracker.record_delivery_of(failed_delivery)
+
+    assert_equal 11, tracker.consecutive_failures_count
+    assert_not webhook.reload.active?, "Should deactivate after 10+ consecutive failures over an hour"
+  end
+
+  test "does not deactivate webhook if fewer than 10 failures over an hour" do
+    freeze_time
+
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    failed_delivery = webhook_deliveries(:unsuccessfully_completed)
+
+    tracker.record_delivery_of(failed_delivery)
+
+    travel 2.hours
+    8.times { tracker.record_delivery_of(failed_delivery) }
+
+    assert_equal 9, tracker.consecutive_failures_count
+    assert webhook.reload.active?
+
+    tracker.record_delivery_of(failed_delivery)
+    assert_equal 10, tracker.consecutive_failures_count
+    assert_not webhook.reload.active?
+  end
+
+  test "success in the middle of failures resets the consecutive failure streak" do
+    freeze_time
+
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    failed_delivery = webhook_deliveries(:unsuccessfully_completed)
+    succeeded_delivery = webhook_deliveries(:successfully_completed)
+
+    9.times { tracker.record_delivery_of(failed_delivery) }
+    travel 2.hours
+
+    tracker.record_delivery_of(succeeded_delivery)
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+
+    tracker.record_delivery_of(failed_delivery)
+    assert_equal 1, tracker.consecutive_failures_count
+    assert_equal Time.current, tracker.first_failure_at
+    assert webhook.reload.active?
+  end
+end
