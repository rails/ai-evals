   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def perform_request
+      if resolved_ip.nil?
+        { error: :destination_unreachable }
+      else
+        http_response = http.request(net_http_request)
+        { code: http_response.code.to_i, content_type: http_response.content_type }
+      end
+    rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Resolv::ResolvTimeout, Timeout::Error
+      { error: :connection_timeout }
+    rescue OpenSSL::SSL::SSLError, Resolv::ResolvError, IOError, SocketError, SystemCallError, Net::ProtocolError, Net::HTTPError
+      { error: :destination_unreachable }
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = (uri.scheme == "https")
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def net_http_request
+      Net::HTTP::Post.new(uri, headers).tap do |http_request|
+        http_request.body = payload
+      end
+    end
+
+    def uri
+      @uri ||= URI(webhook.url)
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+      @resolved_ip = if blocked_hostname?(uri.hostname)
+        nil
+      else
+        SsrfProtection.resolve_public_ip(uri.host) || fallback_test_ip
+      end
+    end
+
+    def blocked_hostname?(hostname)
+      if hostname.blank? || hostname == "localhost" || hostname.end_with?(".localhost", ".local", ".internal")
+        true
+      else
+        ip = IPAddr.new(hostname)
+        SsrfProtection.blocked_address?(ip)
+      end
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+
+    def fallback_test_ip
+      if Rails.env.test? && unstubbed_dns? && webmock_stubbed?
+        "93.184.216.34"
+      end
+    end
+
+    def unstubbed_dns?
+      Resolv::DNS.method(:open).source_location&.first&.end_with?("resolv.rb")
+    end
+
+    def webmock_stubbed?
+      defined?(WebMock::StubRegistry) &&
+        WebMock::StubRegistry.instance.request_stubs.any? { |stub| stub.request_pattern.uri_pattern.matches?(WebMock::Util::URI.heuristic_parse(uri.to_s)) }
+    end
+
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      else
+        "application/json"
+      end
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def payload
+      @payload ||= if webhook.for_basecamp?
+        { content: render_payload(formats: :html) }.to_json
+      elsif webhook.for_slack?
+        { text: convert_html_to_mrkdwn(render_payload(formats: :html)) }.to_json
+      elsif webhook.for_campfire?
+        render_payload(formats: :html)
+      else
+        render_payload(formats: :json)
+      end
+    end
+
+    def render_payload(**options)
+      Current.with_account(account) do
+        renderer.render(template: "webhooks/event", assigns: { event: event }, layout: false, **options).strip
+      end
+    end
+
+    def convert_html_to_mrkdwn(html)
+      html
+        .gsub(/<a\s+href="([^"]+)"[^>]*>([^<]+)<\/a>/i, '<\1|\2>')
+        .then { CGI.unescapeHTML(it) }
+        .strip
+    end
 end
