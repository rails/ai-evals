diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..075eec2
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_datetime_tag renders time element with UTC iso8601 datetime and default time style" do
+    timestamp = Time.utc(2025, 9, 12, 13, 42, 0)
+
+    html = local_datetime_tag(timestamp)
+
+    assert_select parse(html), "time.local-time-value[datetime='2025-09-12T13:42:00Z'][data-local-time-target='time']", text: ""
+  end
+
+  test "local_datetime_tag converts zoned time to UTC iso8601" do
+    timestamp = ActiveSupport::TimeZone["America/New_York"].local(2025, 9, 12, 9, 42, 0)
+
+    html = local_datetime_tag(timestamp, style: :ago, class: "custom-class", data: { extra: "1" })
+
+    assert_select parse(html), "time.local-time-value.custom-class[datetime='2025-09-12T13:42:00Z'][data-local-time-target='ago'][data-extra='1']"
+  end
+
+  test "local_datetime_tag returns nil for blank datetime" do
+    assert_nil local_datetime_tag(nil)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..935e749
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,72 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders comment and card times in the viewer timezone" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    card.comments.destroy_all
+
+    # Set browser timezone to America/New_York (EDT, UTC-4 in September)
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+
+    travel_to Time.utc(2025, 9, 17, 19, 42, 0) do
+      # 2 hours ago in EDT: 1:42 PM EDT (17:42 UTC)
+      c_two_hours = card.comments.create!(creator: users(:kevin), body: "Two hours ago comment", created_at: 2.hours.ago)
+      # Last night in EDT: 2025-09-16 22:00 EDT = 2025-09-17 02:00 UTC (same UTC day as now, but yesterday in EDT!)
+      c_last_night = card.comments.create!(creator: users(:kevin), body: "Last night comment", created_at: Time.utc(2025, 9, 17, 2, 0, 0))
+      # 5 days ago: 2025-09-12 14:00 UTC
+      c_five_days = card.comments.create!(creator: users(:kevin), body: "Five days ago comment", created_at: 5.days.ago)
+      # Older (Sep 1): 2025-09-01 14:00 UTC
+      c_older = card.comments.create!(creator: users(:kevin), body: "Older comment", created_at: Time.utc(2025, 9, 1, 14, 0, 0))
+
+      # Card auto-closing overnight in EDT: 2025-09-18 01:00 EDT = 2025-09-18 05:00 UTC
+      card.update_columns(last_active_at: Time.utc(2025, 9, 18, 5, 0, 0) - card.auto_postpone_period)
+
+      visit card_url(card)
+
+      within("##{dom_id(c_two_hours)}") do
+        assert_selector "time", text: "1:42 PM"
+      end
+
+      within("##{dom_id(c_last_night)}") do
+        assert_selector "time", text: "yesterday"
+      end
+
+      within("##{dom_id(c_five_days)}") do
+        assert_selector "time", text: "5 days ago"
+      end
+
+      within("##{dom_id(c_older)}") do
+        assert_selector "time", text: "Sep 1"
+      end
+
+      within("##{dom_id(card, :closure_notice)}") do
+        assert_selector "time", text: "tomorrow"
+      end
+
+      # Update card so auto_clean_at is in 3 days (2025-09-20 15:00 EDT = 19:00 UTC)
+      card.update_columns(last_active_at: 3.days.from_now - card.auto_postpone_period)
+      visit card_url(card)
+
+      within("##{dom_id(card, :closure_notice)}") do
+        assert_selector "time", text: "in 3 days"
+      end
+
+      # Close card on Sep 12 in EDT (2025-09-13 01:00 UTC = 2025-09-12 21:00 EDT)
+      card.close(user: users(:kevin))
+      card.closure.update_columns(created_at: Time.utc(2025, 9, 13, 1, 0, 0))
+      visit card_url(card)
+
+      within("##{dom_id(card, :card_closure_toggle)}") do
+        assert_text "Completed by Kevin on Sep 12."
+      end
+
+      within(".card__closed-date") do
+        assert_selector "time", text: /Sep 12, 2025/i
+      end
+    end
+  ensure
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "UTC")
+  end
+end
