diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..0cafd80
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,170 @@
+import { Controller } from "@hotwired/stimulus"
+import { currentTimezone, signedDifferenceInDays } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 30_000
+
+export default class extends Controller {
+  static targets = [ "time", "date", "datetime", "shortdate", "ago", "indays", "agoday", "daysago", "relative" ]
+
+  #timer
+  #boundHandleMorphElement
+
+  connect() {
+    this.#timer = setInterval(this.refreshAll.bind(this), REFRESH_INTERVAL)
+    this.#boundHandleMorphElement = this.#handleMorphElement.bind(this)
+    this.element.addEventListener("turbo:morph-element", this.#boundHandleMorphElement)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.element.removeEventListener("turbo:morph-element", this.#boundHandleMorphElement)
+  }
+
+  refreshAll() {
+    this.timeTargets.forEach(target => this.timeTargetConnected(target))
+    this.dateTargets.forEach(target => this.dateTargetConnected(target))
+    this.datetimeTargets.forEach(target => this.datetimeTargetConnected(target))
+    this.shortdateTargets.forEach(target => this.shortdateTargetConnected(target))
+    this.agoTargets.forEach(target => this.agoTargetConnected(target))
+    this.indaysTargets.forEach(target => this.indaysTargetConnected(target))
+    this.agodayTargets.forEach(target => this.agodayTargetConnected(target))
+    this.daysagoTargets.forEach(target => this.daysagoTargetConnected(target))
+    this.relativeTargets.forEach(target => this.relativeTargetConnected(target))
+  }
+
+  timeTargetConnected(target) {
+    this.#render(target, date => this.#formatTime(date))
+  }
+
+  dateTargetConnected(target) {
+    this.#render(target, date => this.#formatDate(date))
+  }
+
+  datetimeTargetConnected(target) {
+    this.#render(target, date => this.#formatDatetime(date))
+  }
+
+  shortdateTargetConnected(target) {
+    this.#render(target, date => this.#formatShortdate(date))
+  }
+
+  agoTargetConnected(target) {
+    this.#render(target, date => this.#formatAgo(date))
+  }
+
+  indaysTargetConnected(target) {
+    this.#render(target, date => this.#formatIndays(date))
+  }
+
+  agodayTargetConnected(target) {
+    this.#render(target, date => this.#formatAgoday(date))
+  }
+
+  daysagoTargetConnected(target) {
+    this.#render(target, date => this.#formatDaysago(date))
+  }
+
+  relativeTargetConnected(target) {
+    this.#render(target, date => this.#formatAgo(date))
+  }
+
+  #handleMorphElement(event) {
+    const target = event.target
+    const style = target?.dataset?.localTimeTarget
+
+    if (style && typeof this[`${style}TargetConnected`] === "function") {
+      this[`${style}TargetConnected`](target)
+    }
+  }
+
+  #render(target, formatFn) {
+    const datetime = target.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date)) return
+
+    target.textContent = formatFn(date)
+    target.title = this.#formatDatetime(date)
+  }
+
+  #formatTime(date) {
+    return this.#formatter({ timeStyle: "short" }).format(date)
+  }
+
+  #formatDate(date) {
+    return this.#formatter({ dateStyle: "medium" }).format(date)
+  }
+
+  #formatDatetime(date) {
+    return this.#formatter({ dateStyle: "short", timeStyle: "short" }).format(date)
+  }
+
+  #formatShortdate(date) {
+    return this.#formatter({ month: "short", day: "numeric" }).format(date)
+  }
+
+  #formatWeekdayDate(date) {
+    return this.#formatter({ weekday: "long", month: "long", day: "numeric" }).format(date)
+  }
+
+  #formatAgo(date) {
+    const days = signedDifferenceInDays(date, new Date())
+
+    if (days <= 0) {
+      return this.#formatTime(date)
+    } else if (days === 1) {
+      return "yesterday"
+    } else if (days < 7) {
+      return `${days} days ago`
+    } else {
+      return this.#formatShortdate(date)
+    }
+  }
+
+  #formatDaysago(date) {
+    const days = signedDifferenceInDays(date, new Date())
+
+    if (days <= 0) {
+      return "today"
+    } else if (days === 1) {
+      return "yesterday"
+    } else {
+      return `${days} days ago`
+    }
+  }
+
+  #formatAgoday(date) {
+    const days = signedDifferenceInDays(date, new Date())
+
+    if (days <= 0) {
+      return "today"
+    } else if (days === 1) {
+      return "yesterday"
+    } else {
+      return this.#formatWeekdayDate(date)
+    }
+  }
+
+  #formatIndays(date) {
+    const days = signedDifferenceInDays(new Date(), date)
+
+    if (days <= 0) {
+      return "today"
+    } else if (days === 1) {
+      return "tomorrow"
+    } else {
+      return `in ${days} days`
+    }
+  }
+
+  #formatter(options) {
+    const timezone = currentTimezone()
+
+    try {
+      return new Intl.DateTimeFormat("en-US", { ...options, timeZone: timezone })
+    } catch {
+      return new Intl.DateTimeFormat("en-US", options)
+    }
+  }
+}
