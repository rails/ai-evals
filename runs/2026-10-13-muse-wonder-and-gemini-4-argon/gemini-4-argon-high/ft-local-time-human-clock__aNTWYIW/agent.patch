 end
+
+ActiveSupport.on_load(:action_dispatch_system_test_case) do
+  prepend(Module.new do
+    def travel_to(date_or_time, **options, &block)
+      if block_given?
+        super(date_or_time, **options) do
+          sync_browser_clock_with_travel_to(force: true)
+          yield
+        ensure
+          clear_browser_clock_sync
+        end
+      else
+        super(date_or_time, **options).tap do
+          sync_browser_clock_with_travel_to(force: true)
+        end
+      end
+    end
+
+    def travel_back
+      super.tap do
+        clear_browser_clock_sync
+      end
+    end
+
+    def visit(...)
+      sync_browser_clock_with_travel_to
+      super
+    end
+
+    def teardown
+      clear_browser_clock_sync
+      super
+    end
+
+    private
+      def sync_browser_clock_with_travel_to(force: false)
+        return unless page.driver.respond_to?(:browser) && page.driver.browser.respond_to?(:execute_cdp)
+
+        clear_browser_clock_sync
+
+        if force || (Time.now.to_f - Process.clock_gettime(Process::CLOCK_REALTIME)).abs > 2
+          target_ms = (Time.now.to_f * 1000).to_i
+          script = <<~JS
+            (() => {
+              const OriginalDate = window.__OriginalDate || Date;
+              window.__OriginalDate = OriginalDate;
+              const baseRealMs = OriginalDate.now();
+              const targetMs = #{target_ms};
+              class TravelDate extends OriginalDate {
+                constructor(...args) {
+                  if (args.length === 0) {
+                    super(targetMs + (OriginalDate.now() - baseRealMs));
+                  } else {
+                    super(...args);
+                  }
+                }
+                static now() {
+                  return targetMs + (OriginalDate.now() - baseRealMs);
+                }
+              }
+              window.Date = TravelDate;
+            })();
+          JS
+          result = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: script)
+          @__travel_to_cdp_script_id = result["identifier"]
+          page.execute_script(script)
+        end
+      rescue StandardError
+        nil
+      end
+
+      def clear_browser_clock_sync
+        if defined?(@__travel_to_cdp_script_id) && @__travel_to_cdp_script_id
+          page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @__travel_to_cdp_script_id)
+          @__travel_to_cdp_script_id = nil
+          page.execute_script("if (window.__OriginalDate) { window.Date = window.__OriginalDate; }")
+        end
+      rescue StandardError
+        @__travel_to_cdp_script_id = nil
+      end
+  end)
+end
