+<%= turbo_frame_tag @comment, :reacting do %>
+  <%= form_with model: [ @card, @comment, Reaction.new ],
+        class: "reaction reaction__form expanded",
+        data: { controller: "form reaction-emoji morph-guard", action: "keydown.esc->form#cancel:stop submit->form#preventEmptySubmit submit->form#preventComposingSubmit" } do |form| %>
