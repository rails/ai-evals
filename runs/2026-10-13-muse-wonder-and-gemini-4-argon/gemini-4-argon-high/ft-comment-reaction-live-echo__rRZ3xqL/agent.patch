new file mode 100644
index 0000000..d9e72b2
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "create reaction on comment" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal comment.account, reaction.account
+    assert_equal "👍", reaction.content
+    assert reaction.all_emoji?
+  end
+
+  test "content validation" do
+    comment = comments(:logo_agreement_jz)
+
+    blank_reaction = comment.reactions.build(content: "")
+    assert_not blank_reaction.valid?
+
+    whitespace_reaction = comment.reactions.build(content: "   ")
+    assert_not whitespace_reaction.valid?
+
+    max_length_reaction = comment.reactions.build(content: "a" * 16)
+    assert max_length_reaction.valid?
+
+    too_long_reaction = comment.reactions.build(content: "a" * 17)
+    assert_not too_long_reaction.valid?
+  end
+
+  test "all_emoji? delegates to content" do
+    comment = comments(:logo_agreement_jz)
+
+    emoji_reaction = comment.reactions.build(content: "🎉🔥")
+    assert emoji_reaction.all_emoji?
+
+    text_reaction = comment.reactions.build(content: "Great 👍")
+    assert_not text_reaction.all_emoji?
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..41d3637
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,157 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding, canceling, and removing reactions on a comment" do
+    @comment.reactions.create!(content: "Nice!", reacter: users(:jz))
+
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment, :reactions)}") do
+      # Existing reaction is displayed with who left it
+      assert_selector ".reaction", text: "Nice!"
+      assert_selector ".reaction img[title='#{users(:jz).name}']"
+      assert_selector "a.reactions__trigger"
+
+      # Clicking someone else's reaction does not reveal delete button
+      find(".reaction", text: "Nice!").click
+      assert_no_selector ".reaction__delete"
+
+      # Clicking trigger turns into input with confirm and cancel
+      find(".reactions__trigger").click
+      assert_no_selector ".reactions__trigger"
+      assert_selector "form.reaction__form"
+      assert_selector "input.reaction__input"
+      assert_selector ".reaction__submit-btn"
+      assert_selector ".reaction__cancel-btn"
+
+      # Canceling restores the trigger button
+      find(".reaction__cancel-btn").click
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Canceling with Escape key also restores the trigger button
+      find(".reactions__trigger").click
+      assert_selector "form.reaction__form"
+      find("input.reaction__input").send_keys(:escape)
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Adding a text reaction
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "Agreed 100%"
+      find(".reaction__submit-btn").click
+
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction span.txt-small:not(.txt-medium)", text: "Agreed 100%"
+      assert_selector ".reaction img[title='#{users(:david).name}']"
+
+      # Adding a second reaction using emoji menu
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      within(".reaction__emoji-list") do
+        click_on "Thumbs up"
+      end
+      find(".reaction__submit-btn").click
+
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction span.txt-small.txt-medium", text: "👍"
+
+      # Clicking own reaction reveals delete button and removes it
+      own_reaction = find(".reaction.reaction--deleteable", text: "Agreed 100%")
+      assert_no_selector ".reaction__delete"
+      own_reaction.click
+      within(own_reaction) do
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector ".reaction", text: "Agreed 100%"
+      assert_selector ".reaction", text: "👍"
+    end
+  end
+
+  test "reactions land in real time for everyone looking at the card" do
+    @comment.reactions.create!(content: "Mine", reacter: users(:david))
+
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    wait_for_cable_subscriptions
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_selector ".reaction.reaction--deleteable", text: "Mine"
+    end
+
+    # Another user adds a reaction
+    reaction = @comment.reactions.create!(content: "Ship it 🚀", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_selector ".reaction", text: "Ship it 🚀", wait: 5
+      assert_selector ".reaction img[title='#{users(:kevin).name}']"
+      # Own reaction remains deleteable after morph
+      assert_selector ".reaction.reaction--deleteable", text: "Mine"
+    end
+
+    # The other user removes their reaction
+    reaction.destroy!
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_no_selector ".reaction", text: "Ship it 🚀", wait: 5
+      assert_selector ".reaction.reaction--deleteable", text: "Mine"
+    end
+  end
+
+  test "broadcast refresh preserves open reaction form and works after submit or cancel" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    wait_for_cable_subscriptions
+
+    within("##{dom_id(@comment, :reactions)}") do
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "Typing..."
+    end
+
+    # Another user's reaction lands while form is open
+    @comment.reactions.create!(content: "First!", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_selector ".reaction", text: "First!", wait: 5
+      assert_selector "form.reaction__form"
+      assert_field "Reaction", with: "Typing..."
+
+      # Now submit the open form
+      find(".reaction__submit-btn").click
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction", text: "Typing..."
+    end
+
+    # Flush the broadcast from our own submission
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_selector ".reaction", text: "First!"
+      assert_selector ".reaction.reaction--deleteable", text: "Typing..."
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
