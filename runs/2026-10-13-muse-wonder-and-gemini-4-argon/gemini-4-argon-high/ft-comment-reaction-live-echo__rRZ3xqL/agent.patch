+        <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true, class: "btn btn--circle" %>
+      </figure>
+
+      <span class="visually-hidden">Reaction</span>
+
+      <%= form.text_field :content, autofocus: true, autocomplete: "off", autocorrect: "off", maxlength: 16,
+            required: true, class: "input reaction__input txt-small",
+            data: { form_target: "input", reaction_emoji_target: "input", "1p-ignore": "true", action: "compositionstart->form#compositionStart compositionend->form#compositionEnd" },
+            aria: { label: "Reaction" } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <%= tag.button type: :button, class: "btn borderless reaction__menu-btn", data: { action: "dialog#toggle" } do %>
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Reaction menu</span>
+      <% end %>
+
+      <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= tag.button type: :button, class: "btn btn--circle borderless",
+                  data: { action: "dialog#close reaction-emoji#insert", emoji: emoji } do %>
+              <span aria-hidden="true"><%= emoji %></span>
+              <span class="for-screen-reader"><%= label %></span>
+            <% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "btn borderless reaction__submit-btn", type: :submit do %>
+      <%= icon_tag "check-circle" %>
+      <span class="for-screen-reader">Submit reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@comment.card, @comment), role: "button",
+          class: "btn borderless reaction__cancel-btn", data: { form_target: "cancel" } do %>
+      <%= icon_tag "close-circle" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    <% end %>
+  <% end %>
+<% end %>
