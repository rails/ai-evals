--- /dev/null
+++ b/app/javascript/controllers/reaction_emoji_controller.js
@@ -0,0 +1,19 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input" ]
+
+  insert(event) {
+    const emoji = event.params.emoji || event.currentTarget.dataset.emoji
+    const start = this.inputTarget.selectionStart
+    const end = this.inputTarget.selectionEnd
+    const before = this.inputTarget.value.slice(0, start)
+    const after = this.inputTarget.value.slice(end)
+
+    if (Array.from(before + emoji + after).length <= 16) {
+      this.inputTarget.setRangeText(emoji, start, end, "end")
+    }
+
+    this.inputTarget.focus()
+  }
+}
