+    assert_equal "Updated Kevin Bot", @kevin_bot.reload.name
+    assert_equal "https://example.com/updated-hook", @kevin_bot.webhook_url
+    assert @kevin_bot.avatar.attached?
+  end
+
+  test "update with empty webhook URL removes the bot's webhook" do
+    assert_not_nil @kevin_bot.webhook
+
+    assert_difference -> { Webhook.count }, -1 do
+      patch bot_url(@kevin_bot), params: {
+        bot: {
+          name: "Kevin Bot",
+          webhook_url: ""
+        }
+      }
+    end
+
+    assert_redirected_to bots_url
+    assert_nil @kevin_bot.reload.webhook
+    assert_nil @kevin_bot.webhook_url
+  end
+
+  test "update without avatar preserves existing avatar" do
+    @kevin_bot.update!(avatar: fixture_file_upload("moon.jpg", "image/jpeg"))
+    assert @kevin_bot.avatar.attached?
+
+    patch bot_url(@kevin_bot), params: {
