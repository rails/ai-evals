+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+    @kevin_bot = User.create_bot!(name: "Kevin Bot", creator: users(:kevin), webhook_url: "https://example.com/kevin-hook")
