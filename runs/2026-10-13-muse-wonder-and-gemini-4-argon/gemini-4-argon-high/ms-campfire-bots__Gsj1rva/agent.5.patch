+    assert_select "*", text: /failing webhooks/i
+    assert_select "form[action='#{reactivate_bot_path(@david_bot)}'] button[data-turbo-confirm]", text: /Reactivate/
+  end
+
+  # Administrator can reactivate a suspended bot
+  post reactivate_bot_url(@kevin_bot)
