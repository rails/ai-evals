+  assert @kevin_bot.reload.active?
+  assert_nil @kevin_bot.suspension_reason
+
+  get bots_url
+  assert_select "li##{dom_id(@kevin_bot)}" do
+    assert_select "*", text: /Suspended/, count: 0
+    assert_select "button", text: /Reactivate/, count: 0
+  end
+end
