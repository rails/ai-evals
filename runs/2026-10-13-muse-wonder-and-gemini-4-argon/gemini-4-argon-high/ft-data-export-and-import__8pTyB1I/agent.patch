+module Account::DataTransfer
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :exports, class_name: "Account::Export", dependent: :destroy
+    has_many :data_exports, class_name: "Export", dependent: :destroy
+    has_many :imports, class_name: "Account::Import", dependent: :nullify
+  end
+
+  def export_to(zip)
+    Manifest.new(self).each_record_set do |record_set|
+      record_set.export(to: zip)
+    end
+  end
+
+  def check_import_from(zip)
+    Manifest.new(self).each_record_set do |record_set|
+      record_set.check(from: zip)
+    end
+  end
+
+  def import_from(zip)
+    Manifest.new(self).each_record_set do |record_set|
+      record_set.import(from: zip)
+    end
+  end
+end
