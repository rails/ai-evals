diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..05893b0
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,43 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthorized_access
+  before_action :enforce_tenant_limit, only: %i[ new create ]
+  before_action :set_import, only: :show
+
+  layout "public"
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def show
+    if @import.completed? && @import.account.present?
+      redirect_to landing_url(script_name: @import.account.slug)
+    end
+  end
+
+  def create
+    if file = import_file_param
+      @import = Current.identity.imports.create!(file: file)
+      @import.process_later
+      redirect_to account_import_path(@import, script_name: @import.account&.slug)
+    else
+      @import = Account::Import.new
+      @import.errors.add(:file, "must be provided")
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def enforce_tenant_limit
+      redirect_to new_session_url(script_name: nil) unless Account.accepting_signups?
+    end
+
+    def set_import
+      @import = Current.identity.imports.find(params[:id])
+    end
+
+    def import_file_param
+      params[:file] || params.dig(:import, :file) || params.dig(:account_import, :file)
+    end
+end
