+require "test_helper"
+
+class Users::DataExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "user sees export button on their own profile page" do
+    sign_in_as @user
+
+    get user_path(@user)
+    assert_response :success
+    assert_select "form[action='#{user_data_exports_path(@user)}']"
+  end
+
+  test "user does not see export button on another user's profile page" do
+    sign_in_as @user
+
+    get user_path(users(:kevin))
+    assert_response :success
+    assert_select "form[action='#{user_data_exports_path(users(:kevin))}']", count: 0
+  end
+
+  test "user can create a data export and download it via link from email" do
+    sign_in_as @user
+
+    assert_difference -> { User::DataExport.count }, +1 do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post user_data_exports_path(@user)
+        end
+      end
+    end
+
+    assert_redirected_to user_path(@user)
+
+    export = @user.data_exports.last
+    assert export.completed?
+    assert export.file.attached?
+
+    get user_data_export_path(@user, export)
+    assert_response :success
+    assert_select "a#download-link[href='#{rails_blob_path(export.file, disposition: "attachment")}']"
+  end
+
+  test "user cannot create or view data export for another user" do
+    sign_in_as @user
+    other_user = users(:kevin)
+
+    assert_no_difference -> { Export.count } do
+      post user_data_exports_path(other_user)
+    end
+    assert_response :forbidden
+
+    other_export = other_user.data_exports.create!(account: @account, user: other_user)
+    other_export.build
+
+    get user_data_export_path(other_user, other_export)
+    assert_response :forbidden
+  end
+
+  test "expired user data export link does not show download link" do
+    sign_in_as @user
+
+    export = @user.data_exports.create!(account: @account, user: @user)
+    export.build
+
+    travel 2.days do
+      get user_data_export_path(@user, export)
+      assert_response :success
+      assert_select "a#download-link", count: 0
+      assert_in_body "expired"
+    end
+  end
+end
