new file mode 100644
index 0000000..e2db7a7
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+  end
+
+  test "build creates a zip archive with account data and files and sends email" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @user)
+    assert export.pending?
+
+    assert_enqueued_emails 1 do
+      export.build
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    ZipFile.read_from(export.file) do |zip|
+      assert_equal 1, zip.glob("data/accounts/*.json").size
+      assert zip.glob("data/users/*.json").any?
+      assert zip.glob("data/boards/*.json").any?
+      assert zip.glob("data/cards/*.json").any?
+      assert zip.glob("data/comments/*.json").any?
+      assert zip.exists?("storage/#{card.image.blob.key}")
+    end
+  end
+
+  test "export excludes internal Export blobs and attachments" do
+    first_export = @account.exports.create!(user: @user)
+    first_export.build
+    first_export_blob_id = first_export.file.blob.id
+    first_export_blob_key = first_export.file.blob.key
+
+    second_export = @account.exports.create!(user: @user)
+    second_export.build
+
+    ZipFile.read_from(second_export.file) do |zip|
+      assert_not zip.exists?("data/active_storage_blobs/#{first_export_blob_id}.json")
+      assert_not zip.exists?("storage/#{first_export_blob_key}")
+    end
+  end
+
+  test "cleanup destroys expired exports" do
+    recent = @account.exports.create!(user: @user)
+    expired = @account.exports.create!(user: @user, created_at: 2.days.ago)
+
+    Export.cleanup
+
+    assert Export.exists?(recent.id)
+    assert_not Export.exists?(expired.id)
+  end
+
+  test "accessible_to? only allows requesting user" do
+    export = @account.exports.create!(user: @user)
+
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users(:david))
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..988e1a8
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,223 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    @identity = identities(:kevin)
+    Current.session = sessions(:kevin)
+  end
+
+  test "imports an exported account into a new account with all boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+    mention_html = ActionText::Attachment.from_attachable(users(:david)).to_html
+    card.update!(description: "<p>See #{embed_html} by #{mention_html}</p>")
+
+    export = @account.exports.create!(user: @user)
+    export.build
+
+    zip_tempfile = Tempfile.new([ "account-export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    original_boards_count = @account.boards.count
+    original_cards_count = @account.cards.count
+    original_comments_count = Comment.where(account: @account).count
+    original_users_count = @account.users.count
+    original_name = @account.name
+
+    perform_enqueued_jobs
+    @account.incinerate
+    perform_enqueued_jobs
+
+    uploaded_file = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip")
+    import = nil
+
+    Current.without_account do
+      import = Account::Import.create!(identity: @identity, file: uploaded_file)
+      assert_enqueued_emails 1 do
+        import.process
+      end
+    end
+
+    assert import.completed?
+    new_account = import.account.reload
+    assert_equal original_name, new_account.name
+    assert_equal original_boards_count, new_account.boards.count
+    assert_equal original_cards_count, new_account.cards.count
+    assert_equal original_comments_count, Comment.where(account: new_account).count
+    assert_equal original_users_count, new_account.users.count
+
+    imported_card = new_account.cards.find_by!(number: card.number)
+    assert_equal card.title, imported_card.title
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+    assert_includes imported_card.description.body.attachables, users(:david)
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "import that conflicts with existing data fails, sends failure email, and leaves nothing behind" do
+    export = @account.exports.create!(user: @user)
+    export.build
+
+    zip_tempfile = Tempfile.new([ "account-export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    uploaded_file = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip")
+    import = nil
+
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { Board.count } do
+        assert_no_difference -> { Card.count } do
+          import = Account::Import.create!(identity: @identity, file: uploaded_file)
+          assert_enqueued_emails 1 do
+            import.process
+          end
+        end
+      end
+    end
+
+    assert import.reload.failed?
+    assert import.conflict?
+    assert_nil import.account_id
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "import with invalid zip file fails, sends failure email, and leaves nothing behind" do
+    bad_tempfile = Tempfile.new([ "corrupt", ".zip" ])
+    bad_tempfile.write("not a valid zip file")
+    bad_tempfile.rewind
+
+    uploaded_file = Rack::Test::UploadedFile.new(bad_tempfile.path, "application/zip")
+    import = nil
+
+    assert_no_difference -> { Account.count } do
+      import = Account::Import.create!(identity: @identity, file: uploaded_file)
+      assert_enqueued_emails 1 do
+        import.process
+      end
+    end
+
+    assert import.reload.failed?
+    assert import.invalid_export?
+    assert_nil import.account_id
+  ensure
+    bad_tempfile&.close
+    bad_tempfile&.unlink
+  end
+
+  test "imports account for an identity that was not in the exported account" do
+    export = @account.exports.create!(user: @user)
+    export.build
+
+    zip_tempfile = Tempfile.new([ "account-export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    perform_enqueued_jobs
+    @account.incinerate
+    perform_enqueued_jobs
+
+    outsider_identity = Identity.create!(email_address: "outsider@example.com")
+    uploaded_file = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip")
+
+    import = Account::Import.create!(identity: outsider_identity, file: uploaded_file)
+    import.process
+
+    assert import.completed?
+    new_account = import.account.reload
+    outsider_user = new_account.users.find_by(identity: outsider_identity)
+    assert_not_nil outsider_user
+    assert outsider_user.owner?
+    assert outsider_user.active?
+    assert outsider_user.verified?
+    assert_equal new_account.boards.count, outsider_user.boards.count
+
+    # Search index works in imported account
+    results = outsider_user.search("logo")
+    assert results.any?
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "import fails when user card export zip (missing account data) is uploaded" do
+    user_export = @user.data_exports.create!(account: @account, user: @user)
+    user_export.build
+
+    zip_tempfile = Tempfile.new([ "user-export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(user_export.file.download)
+    zip_tempfile.rewind
+
+    uploaded_file = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip")
+    import = nil
+
+    assert_no_difference -> { Account.count } do
+      import = Account::Import.create!(identity: @identity, file: uploaded_file)
+      import.process
+    end
+
+    assert import.reload.failed?
+    assert import.invalid_export?
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "import fails when a referenced blob file is missing from storage directory in zip" do
+    zip_tempfile = Tempfile.new([ "incomplete-export", ".zip" ])
+    zip_tempfile.binmode
+
+    writer = ZipFile::Writer.new(zip_tempfile)
+    Account::DataTransfer::AccountRecordSet.new(@account).export(to: writer)
+    writer.add_file(
+      "data/active_storage_blobs/123.json",
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @account.id,
+        key: "missing_blob_key",
+        filename: "missing.png",
+        content_type: "image/png",
+        metadata: "{}",
+        byte_size: 100,
+        checksum: "abc",
+        created_at: Time.current
+      }.to_json
+    )
+    writer.close
+    zip_tempfile.rewind
+
+    uploaded_file = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip")
+    import = nil
+
+    assert_no_difference -> { Account.count } do
+      import = Account::Import.create!(identity: @identity, file: uploaded_file)
+      import.process
+    end
+
+    assert import.reload.failed?
+    assert import.invalid_export?
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+end
