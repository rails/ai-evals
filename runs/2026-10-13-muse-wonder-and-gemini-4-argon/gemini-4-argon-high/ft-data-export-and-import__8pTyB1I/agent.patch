@@ -0,0 +1,50 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    Current.session = sessions(:kevin)
+  end
+
+  test "build exports accessible cards as JSON with comments and attachments" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    embed_html = ActionText::Attachment.from_attachable(embed_blob).to_html
+    card.comments.create!(creator: @user, body: "<p>Comment with attachment #{embed_html}</p>")
+
+    inaccessible_board = Board.create!(name: "Secret Board", creator: users(:david), account: @account, all_access: false)
+    inaccessible_card = inaccessible_board.cards.create!(title: "Secret Card", creator: users(:david), status: :published)
+
+    export = @user.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("#{card.number}.json")
+      assert_not zip.exists?("#{inaccessible_card.number}.json")
+
+      card_data = JSON.parse(zip.read("#{card.number}.json"))
+      assert_equal card.id, card_data["id"]
+      assert_equal card.number, card_data["number"]
+      assert_equal card.title, card_data["title"]
+      assert card_data["comments"].any?
+      assert_includes card_data["comments"].map { |c| c["body"] }, "I agree."
+
+      assert zip.exists?("#{card.number}/moon.jpg")
+      assert zip.exists?("#{card.number}/avatar.png")
+    end
+  end
+end
