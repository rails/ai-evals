diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..a3116cd
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+  end
+
+  test "admin sees export button in account settings" do
+    sign_in_as @admin
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "non-admin does not see export button in account settings" do
+    sign_in_as @member
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+
+  test "admin can create an account export and receive an email" do
+    sign_in_as @admin
+
+    assert_difference -> { Account::Export.count }, +1 do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post account_exports_path
+        end
+      end
+    end
+
+    assert_redirected_to account_settings_path
+
+    export = Account::Export.last
+    assert export.completed?
+    assert export.file.attached?
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a#download-link[href='#{rails_blob_path(export.file, disposition: "attachment")}']"
+  end
+
+  test "non-admin cannot create an account export" do
+    sign_in_as @member
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "expired export link shows expired message" do
+    sign_in_as @admin
+
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    travel 2.days do
+      get account_export_path(export)
+      assert_response :success
+      assert_select "a#download-link", count: 0
+      assert_in_body "expired"
+    end
+  end
+
+  test "admin cannot view another admin's export" do
+    sign_in_as @admin
+
+    other_admin = users(:jason)
+    export = @account.exports.create!(user: other_admin)
+    export.build
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a#download-link", count: 0
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..28ff983
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    @identity = identities(:kevin)
+  end
+
+  test "signed in user can visit /account/imports/new" do
+    sign_in_as @identity
+
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+    end
+  end
+
+  test "unauthenticated user is redirected to sign in" do
+    untenanted do
+      get new_account_import_path
+      assert_redirected_to new_session_path(script_name: nil)
+    end
+  end
+
+  test "signed in user can import an account export zip and get a new account and email" do
+    export = @account.exports.create!(user: @user)
+    export.build
+
+    zip_tempfile = Tempfile.new([ "account-export", ".zip" ])
+    zip_tempfile.binmode
+    zip_tempfile.write(export.file.download)
+    zip_tempfile.rewind
+
+    perform_enqueued_jobs
+    @account.incinerate
+    perform_enqueued_jobs
+
+    sign_in_as @identity
+
+    uploaded_file = Rack::Test::UploadedFile.new(zip_tempfile.path, "application/zip")
+
+    assert_difference -> { Account.count }, +1 do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          untenanted do
+            post account_imports_path, params: { file: uploaded_file }
+          end
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert import.completed?
+    assert_equal "37signals", import.account.name
+
+    untenanted do
+      get account_import_path(import)
+      assert_redirected_to landing_url(script_name: import.account.slug)
+    end
+  ensure
+    zip_tempfile&.close
+    zip_tempfile&.unlink
+  end
+
+  test "failed import sends failure email and leaves no account behind" do
+    sign_in_as @identity
+
+    bad_tempfile = Tempfile.new([ "invalid", ".zip" ])
+    bad_tempfile.write("not a zip")
+    bad_tempfile.rewind
+    uploaded_file = Rack::Test::UploadedFile.new(bad_tempfile.path, "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          untenanted do
+            post account_imports_path, params: { file: uploaded_file }
+          end
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert import.failed?
+
+    untenanted do
+      get account_import_path(import)
+      assert_response :success
+      assert_in_body "Import failed"
+    end
+  ensure
+    bad_tempfile&.close
+    bad_tempfile&.unlink
+  end
+end
