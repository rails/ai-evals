+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @account = accounts("37s")
+    @identity = identities(:kevin)
+  end
+
+  test "completed" do
+    import = Account::Import.create!(account: @account, identity: @identity, status: :completed)
+    email = ImportMailer.completed(import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @identity.email_address ], email.to
