index 90020f0..2631719 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,16 @@
 module TimeHelper
+  def local_datetime_tag(datetime, style: :time, **attributes)
+    if datetime.present?
+      seconds = datetime.in_time_zone("UTC").to_i
+
+      tag.time **attributes,
+        class: [ "local-time-value", attributes[:class] ],
+        datetime: datetime.in_time_zone("UTC").iso8601,
+        data: {
+          local_time_target: style,
+          local_time_value: seconds,
+          **(attributes[:data] || {})
+        }
+    end
+  end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..9eb408a
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,163 @@
+import { Controller } from "@hotwired/stimulus"
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 30_000
+
+export default class extends Controller {
+  static targets = [ "time", "datetime", "shortdate", "ago", "indays", "daysago", "agoorweekday" ]
+
+  #timer
+
+  #agoFormatter = {
+    format: (date) => {
+      const days = signedDifferenceInDays(new Date(), date)
+
+      if (days >= -7 && days <= 0) {
+        if (days === 0) {
+          const now = new Date()
+          const seconds = (now - date) / 1000
+          const minutes = seconds / 60
+          const hours = minutes / 60
+
+          if (hours >= 1) {
+            return this.#pluralize("hour", hours)
+          } else if (minutes >= 1) {
+            return this.#pluralize("minute", minutes)
+          } else {
+            return "Less than a minute ago"
+          }
+        } else {
+          return this.#daysFormatter.format(date)
+        }
+      } else {
+        const now = new Date()
+        const daysCount = (now - date) / (1000 * 60 * 60 * 24)
+        const weeks = daysCount / 7
+        const months = daysCount / 30
+        const years = daysCount / 365
+
+        if (years >= 1) {
+          return this.#pluralize("year", years)
+        } else if (months >= 1) {
+          return this.#pluralize("month", months)
+        } else if (weeks >= 1) {
+          return this.#pluralize("week", weeks)
+        } else {
+          return this.#daysFormatter.format(date)
+        }
+      }
+    }
+  }
+
+  #daysFormatter = {
+    format: (date) => {
+      return this.#relativeTimeFormatter.format(signedDifferenceInDays(new Date(), date), "day")
+    }
+  }
+
+  #agoorweekdayFormatter = {
+    format: (date) => {
+      const days = signedDifferenceInDays(new Date(), date)
+
+      if (days >= -7 && days <= 0) {
+        return this.#daysFormatter.format(date)
+      } else {
+        return this.#weekdayFormatter.format(date)
+      }
+    }
+  }
+
+  connect() {
+    this.#timer = setInterval(() => this.#refreshRelativeTimes(), REFRESH_INTERVAL)
+    this.boundHandleMorph = this.#handleMorph.bind(this)
+    this.element.addEventListener("turbo:morph-element", this.boundHandleMorph)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.element.removeEventListener("turbo:morph-element", this.boundHandleMorph)
+  }
+
+  timeTargetConnected(target) {
+    this.#formatTime(this.#timeFormatter, target)
+  }
+
+  datetimeTargetConnected(target) {
+    this.#formatTime(this.#datetimeFormatter, target)
+  }
+
+  shortdateTargetConnected(target) {
+    this.#formatTime(this.#shortdateFormatter, target)
+  }
+
+  agoTargetConnected(target) {
+    this.#formatTime(this.#agoFormatter, target)
+  }
+
+  indaysTargetConnected(target) {
+    this.#formatTime(this.#daysFormatter, target)
+  }
+
+  daysagoTargetConnected(target) {
+    this.#formatTime(this.#daysFormatter, target)
+  }
+
+  agoorweekdayTargetConnected(target) {
+    this.#formatTime(this.#agoorweekdayFormatter, target)
+  }
+
+  get #timeFormatter() {
+    return new Intl.DateTimeFormat("en-US", { timeStyle: "short" })
+  }
+
+  get #datetimeFormatter() {
+    return new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" })
+  }
+
+  get #shortdateFormatter() {
+    return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+  }
+
+  get #weekdayFormatter() {
+    return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+  }
+
+  get #relativeTimeFormatter() {
+    return new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+  }
+
+  #handleMorph(event) {
+    const target = event.target
+    const style = target.dataset?.localTimeTarget
+    if (style) {
+      this[`${style}TargetConnected`]?.(target)
+    }
+  }
+
+  #refreshRelativeTimes() {
+    this.agoTargets.forEach(target => this.agoTargetConnected(target))
+    this.indaysTargets.forEach(target => this.indaysTargetConnected(target))
+    this.daysagoTargets.forEach(target => this.daysagoTargetConnected(target))
+    this.agoorweekdayTargets.forEach(target => this.agoorweekdayTargetConnected(target))
+  }
+
+  #formatTime(formatter, target) {
+    const date = this.#extractDate(target)
+    target.innerHTML = formatter.format(date)
+    target.title = this.#datetimeFormatter.format(date)
+  }
+
+  #extractDate(target) {
+    if (target.dataset.localTimeValue) {
+      return new Date(parseInt(target.dataset.localTimeValue) * 1000)
+    } else {
+      return new Date(target.getAttribute("datetime"))
+    }
+  }
+
+  #pluralize(word, quantity) {
+    quantity = Math.floor(quantity)
+    const suffix = (quantity === 1) ? "" : "s"
+    return `${quantity} ${word}${suffix} ago`
+  }
+}
