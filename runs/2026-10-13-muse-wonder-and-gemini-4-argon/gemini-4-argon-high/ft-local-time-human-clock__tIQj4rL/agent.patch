diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..568f99a
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag renders time element with UTC iso8601 and unix timestamp" do
+    time = Time.utc(2025, 9, 12, 13, 42, 0)
+
+    html = local_datetime_tag(time)
+    fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+    element = fragment.at_css("time")
+
+    assert_not_nil element
+    assert_includes element["class"].split, "local-time-value"
+    assert_equal "2025-09-12T13:42:00Z", element["datetime"]
+    assert_equal "time", element["data-local-time-target"]
+    assert_equal time.to_i.to_s, element["data-local-time-value"]
+    assert_empty element.text
+  end
+
+  test "local_datetime_tag supports custom style and attributes" do
+    time = Time.utc(2025, 9, 12, 13, 42, 0)
+
+    html = local_datetime_tag(time, style: :daysago, class: "custom-class", data: { extra: "1" }, id: "custom-id")
+    fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+    element = fragment.at_css("time#custom-id")
+
+    assert_not_nil element
+    assert_includes element["class"].split, "local-time-value"
+    assert_includes element["class"].split, "custom-class"
+    assert_equal "daysago", element["data-local-time-target"]
+    assert_equal "1", element["data-extra"]
+  end
+
+  test "local_datetime_tag is independent of server timezone" do
+    time = Time.utc(2025, 9, 12, 13, 42, 0)
+
+    utc_html = Time.use_zone("UTC") { local_datetime_tag(time.in_time_zone, style: :agoorweekday) }
+    ny_html = Time.use_zone("America/New_York") { local_datetime_tag(time.in_time_zone, style: :agoorweekday) }
+    tokyo_html = Time.use_zone("Asia/Tokyo") { local_datetime_tag(time.in_time_zone, style: :agoorweekday) }
+
+    assert_equal utc_html, ny_html
+    assert_equal utc_html, tokyo_html
+  end
+
+  test "local_datetime_tag returns nil for blank datetime" do
+    assert_nil local_datetime_tag(nil)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..4f9d88c
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,92 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+  end
+
+  test "renders comment and card times in the viewer's own timezone" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+
+    now = Time.current.in_time_zone("America/New_York")
+    today_1_42_pm = now.change(hour: 13, min: 42, sec: 0)
+    last_night = (now - 1.day).change(hour: 23, min: 15, sec: 0)
+    five_days_ago = (now - 5.days).change(hour: 10, min: 0, sec: 0)
+    older_date = (now - 14.days).change(hour: 9, min: 30, sec: 0)
+
+    comment_today = @card.comments.create!(creator: users(:kevin), body: "Comment from today", created_at: today_1_42_pm)
+    comment_yesterday = @card.comments.create!(creator: users(:kevin), body: "Comment from last night", created_at: last_night)
+    comment_earlier = @card.comments.create!(creator: users(:kevin), body: "Comment from earlier", created_at: five_days_ago)
+    comment_older = @card.comments.create!(creator: users(:kevin), body: "Comment from two weeks ago", created_at: older_date)
+
+    period = @card.entropy.auto_clean_period
+    @card.update_columns(
+      created_at: five_days_ago,
+      last_active_at: (now + 1.day).change(hour: 1, min: 0, sec: 0) - period
+    )
+
+    visit card_url(@card)
+
+    within "##{dom_id(comment_today)}" do
+      assert_selector "time[data-local-time-target='agoorweekday']", text: /today/i
+      assert_selector "time[data-local-time-target='time']", text: "1:42 PM"
+    end
+
+    within "##{dom_id(comment_yesterday)}" do
+      assert_selector "time[data-local-time-target='agoorweekday']", text: /yesterday/i
+      assert_selector "time[data-local-time-target='time']", text: "11:15 PM"
+    end
+
+    within "##{dom_id(comment_earlier)}" do
+      assert_selector "time[data-local-time-target='agoorweekday']", text: /5 days ago/i
+      assert_selector "time[data-local-time-target='time']", text: "10:00 AM"
+    end
+
+    within "##{dom_id(comment_older)}" do
+      expected_weekday = older_date.strftime("%A, %B %-d")
+      assert_selector "time[data-local-time-target='agoorweekday']", text: /#{Regexp.escape(expected_weekday)}/i
+      assert_selector "time[data-local-time-target='time']", text: "9:30 AM"
+    end
+
+    within "##{dom_id(@card, :meta)}" do
+      assert_selector ".card__meta-text--added time[data-local-time-target='daysago']", text: /5 days ago/i
+    end
+
+    within "##{dom_id(@card, :closure_notice)}" do
+      assert_text "Moves to “Not Now” tomorrow if there’s no activity."
+    end
+
+    @card.update_columns(last_active_at: (now + 3.days).change(hour: 12, min: 0, sec: 0) - period)
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :closure_notice)}" do
+      assert_text "Moves to “Not Now” in 3 days if there’s no activity."
+    end
+  ensure
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "UTC")
+  end
+
+  test "renders closed card date in viewer's timezone" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+
+    # Sept 13 02:00 UTC is Sept 12 19:00 PDT in America/Los_Angeles
+    closed_time = Time.utc(2025, 9, 13, 2, 0, 0)
+    @card.close(user: users(:david))
+    @card.closure.update_columns(created_at: closed_time)
+
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :card_closure_toggle)}" do
+      assert_text "Completed by David on Sep 12."
+    end
+
+    within ".card__closed-date" do
+      assert_selector "time[data-local-time-target='shortdate']", text: /Sep 12/i
+    end
+  ensure
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "UTC")
+  end
+end
