+
+  test "deliver_webhook does not post a message when webhook responds with 204" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:david))
+    room = rooms(:hq)
+    room.memberships.grant_to(bot)
+    bot.update!(webhook_url: "http://example.com/webhook")
+
