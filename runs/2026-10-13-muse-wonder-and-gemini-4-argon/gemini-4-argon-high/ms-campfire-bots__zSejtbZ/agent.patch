+      assert_difference -> { room.messages.count }, 1 do
+        room.messages.create!(creator: users(:kevin), body: "<div>#{mention_attachment_for(bot)} status</div>")
+      end
+    ensure
+      Bot::WebhookJob.queue_adapter.immediate = false
