+      <span>Reactivate</span>
+    <% end %>
+  <% end %>
+
+  <%= link_to edit_bot_path(bot), class: "btn txt-small flex-item-no-shrink" do %>
+    <%= image_tag "pencil.svg", size: 20, aria: { hidden: "true" } %>
+    <span class="for-screen-reader">Edit <%= bot.name %></span>
