+    assert_equal message.body.body.to_html, received_body.dig("message", "body", "html")
+    assert_equal "/rooms/#{room.id}/@#{message.id}", received_body.dig("message", "link")
+
+    reply = room.messages.last
+    assert_equal bot, reply.creator
+    assert_equal "Restarting the build now!", reply.plain_text_body
+  end
+
+  test "deliver_webhook posts HTML 200 response as rich text bot message" do
+    bot = User.create_bot!(name: "Deploy Bot", creator: users(:david))
