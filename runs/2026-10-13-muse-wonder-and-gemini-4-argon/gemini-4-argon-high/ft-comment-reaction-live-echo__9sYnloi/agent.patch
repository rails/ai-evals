+
+  test "create reaction on comment" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍")
+
+    assert_equal "👍", reaction.content
+    assert_equal users(:david), reaction.reacter
+    assert_equal comment.account, reaction.account
+    assert_equal comment, reaction.comment
+  end
+
+  test "validates content presence and maximum length of 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    blank_reaction = comment.reactions.build(content: "")
+    assert_not blank_reaction.valid?
+
+    valid_reaction = comment.reactions.build(content: "a" * 16)
+    assert valid_reaction.valid?
+
+    emoji_reaction = comment.reactions.build(content: "🎉" * 16)
+    assert emoji_reaction.valid?
+
+    too_long_reaction = comment.reactions.build(content: "a" * 17)
+    assert_not too_long_reaction.valid?
+
+    too_long_emoji = comment.reactions.build(content: "🎉" * 17)
+    assert_not too_long_emoji.valid?
+  end
+
+  test "all_emoji?" do
+    comment = comments(:logo_agreement_jz)
+
+    assert comment.reactions.build(content: "👍").all_emoji?
+    assert comment.reactions.build(content: "🎉🔥").all_emoji?
+    assert_not comment.reactions.build(content: "Great 👍").all_emoji?
+    assert_not comment.reactions.build(content: "Nice!").all_emoji?
+  end
+
+  test "creating and destroying reaction touches comment and card" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    travel 5.minutes do
+      assert_changes -> { [ comment.reload.updated_at, card.reload.updated_at ] } do
+        @reaction = comment.reactions.create!(content: "👍")
+      end
+    end
+
+    travel 10.minutes do
+      assert_changes -> { [ comment.reload.updated_at, card.reload.updated_at ] } do
+        @reaction.destroy!
+      end
+    end
+  end
+
+  test "destroying comment destroys its reactions" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍")
+
+    comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroying user destroys their reactions" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
