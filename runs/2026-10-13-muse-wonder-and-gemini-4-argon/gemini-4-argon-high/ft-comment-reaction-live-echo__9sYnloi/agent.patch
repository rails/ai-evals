+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding, canceling, and removing comment reactions" do
+    @comment.reactions.create!(content: "👏", reacter: users(:jz))
+
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment, :reactions)}") do
+      # Existing reaction from JZ is shown with who left it
+      assert_selector ".reaction span.txt-small.txt-medium", text: "👏"
+      assert_selector ".reaction img[title='#{users(:jz).name}']"
+      assert_no_selector ".reaction.reaction--deleteable"
+
+      # Clicking JZ's reaction does not reveal delete button
+      find(".reaction", text: "👏").click
+      assert_no_selector ".reaction__delete"
+
+      # Clicking trigger opens input with confirm and cancel
+      find(".reactions__trigger").click
+      assert_selector "form.reaction__form"
+      assert_selector "input.reaction__input[maxlength='16']"
+      assert_selector ".reaction__submit-btn"
+      assert_selector ".reaction__cancel-btn"
+      assert_no_selector ".reactions__trigger"
+
+      # Canceling closes input and brings back trigger button
+      find(".reaction__cancel-btn").click
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Adding a text reaction
+      find(".reactions__trigger").click
+      fill_in "Add a reaction", with: "So good!"
+      find(".reaction__submit-btn").click
+
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction.reaction--deleteable span.txt-small:not(.txt-medium)", text: "So good!"
+      assert_selector ".reaction img[title='#{users(:david).name}']"
+
+      # Button is back for the next one - add an emoji via emoji picker
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      within(".reaction__emoji-list") do
+        click_on "Fire"
+      end
+      find(".reaction__submit-btn").click
+
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction.reaction--deleteable span.txt-small.txt-medium", text: "🔥"
+
+      # Clicking own reaction reveals delete button and removes it
+      own_reaction = find(".reaction.reaction--deleteable", text: "So good!")
+      own_reaction.click
+      within(own_reaction) do
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector ".reaction", text: "So good!"
+      assert_selector ".reaction", text: "🔥"
+      assert_selector ".reaction", text: "👏"
+    end
+  end
+
+  test "everyone looking at the card sees reactions land as they happen without reloading" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_no_selector ".reaction"
+    end
+
+    # Another user adds a reaction elsewhere
+    Current.set(account: accounts("37s"), user: users(:kevin)) do
+      @reaction = @comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+    end
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_selector ".reaction", text: "🎉", wait: 5
+      assert_selector ".reaction img[title='#{users(:kevin).name}']"
+      assert_no_selector ".reaction.reaction--deleteable"
+    end
+
+    # Another user removes their reaction elsewhere
+    Current.set(account: accounts("37s"), user: users(:kevin)) do
+      @reaction.destroy!
+    end
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_no_selector ".reaction", wait: 5
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
