+<%= turbo_frame_tag @comment, :reacting do %>
+  <%= form_with model: [ @comment.card, @comment, Reaction.new ],
+        class: "reaction reaction__form expanded gap-half",
+        data: { controller: "form reaction-emoji morph-guard", action: "keydown.esc->form#cancel submit->form#preventEmptySubmit" } do |form| %>
+    <label class="reaction__form-label" for="<%= dom_id(@comment, :reaction_content) %>">
+      <figure class="reaction__avatar margin-none">
+        <%= avatar_tag Current.user, class: "non-clickable", hidden_for_screen_reader: true %>
+      </figure>
+      <span class="for-screen-reader">Add a reaction</span>
+    </label>
+
+    <%= form.text_field :content, id: dom_id(@comment, :reaction_content), autofocus: true, autocomplete: "off", autocorrect: "off", maxlength: 16,
+          required: true, class: "input reaction__input txt-small",
+          data: { form_target: "input", reaction_emoji_target: "input", "1p-ignore": "true" } %>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <%= button_tag type: :button, class: "btn btn--circle borderless reaction__menu-btn", data: { action: "dialog#toggle" } do %>
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Reaction menu</span>
+      <% end %>
+
+      <dialog class="popup panel reaction__popup fill-white shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= button_tag type: :button, class: "btn btn--circle borderless",
+                  title: label,
+                  data: { emoji: emoji, action: "dialog#close reaction-emoji#insert" } do %>
+              <%= emoji %>
+              <span class="for-screen-reader"><%= label %></span>
+            <% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "btn btn--circle borderless reaction__submit-btn", data: { form_target: "submit" } do %>
+      <%= icon_tag "check-circle" %>
+      <span class="for-screen-reader">Submit new reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@comment.card, @comment), role: "button",
+          class: "btn btn--circle borderless reaction__cancel-btn",
+          data: { form_target: "cancel" } do %>
+      <%= icon_tag "close-circle" %>
+      <span class="for-screen-reader">Cancel new reaction</span>
+    <% end %>
+  <% end %>
+<% end %>
