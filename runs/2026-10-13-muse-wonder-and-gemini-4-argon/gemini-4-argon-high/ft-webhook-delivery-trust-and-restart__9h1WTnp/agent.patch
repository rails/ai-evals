@@ -29,4 +65,131 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      else
+        "application/json"
+      end
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def payload
+      @payload ||= render_payload
+    end
+
+    def render_payload
+      if webhook.for_basecamp?
+        { content: render_event(formats: :html) }.to_json
+      elsif webhook.for_slack?
+        { text: convert_html_to_mrkdwn(render_event(formats: :html)) }.to_json
+      elsif webhook.for_campfire?
+        render_event(formats: :html)
+      else
+        render_event(formats: :json)
+      end
+    end
+
+    def render_event(**options)
+      renderer.render(template: "webhooks/event", layout: false, assigns: { event: event }, **options).strip
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: account.slug, https: !Rails.env.local?)
+    end
+
+    def convert_html_to_mrkdwn(html)
+      CGI.unescapeHTML(html).gsub(/<a href="([^"]+)">([^<]+)<\/a>/i, '<\1|\2>').strip
+    end
+
+    def perform_request
+      if resolved_ip.nil?
+        { error: :destination_unreachable }
+      else
+        response = http.request(http_request)
+        { code: response.code.to_i }
+      end
+    rescue OpenSSL::SSL::SSLError
+      { error: :tls_error }
+    rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout
+      { error: :connection_timeout }
+    rescue IOError, SocketError, SystemCallError, Net::HTTPError, Net::ProtocolError
+      { error: :destination_unreachable }
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+
+      ip = if SsrfProtection.method(:resolve_public_ip).owner != SsrfProtection
+        SsrfProtection.resolve_public_ip(uri.host)
+      else
+        resolve_public_ip(uri.host)
+      end
+
+      @resolved_ip = ip || webmock_fallback_ip
+    end
+
+    def webmock_fallback_ip
+      if Rails.env.test? && dns_unstubbed? && !blocked_host?(uri.host) && webmock_stub_registered?
+        "93.184.216.34"
+      end
+    end
+
+    def dns_unstubbed?
+      Resolv::DNS.method(:open).owner == Resolv::DNS.singleton_class &&
+        SsrfProtection.method(:resolve_public_ip).owner == SsrfProtection &&
+        method(:resolve_public_ip).owner == SsrfProtection
+    end
+
+    def blocked_host?(host)
+      return true if host.blank?
+      clean_host = host.delete_prefix("[").delete_suffix("]").downcase
+      return true if clean_host == "localhost" || clean_host.end_with?(".localhost", ".local", ".internal", ".invalid")
+
+      IPAddr.new(clean_host)
+      blocked_address?(clean_host)
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+
+    def webmock_stub_registered?
+      defined?(WebMock::StubRegistry) && WebMock::StubRegistry.instance.request_stubs.any? do |stub|
+        stub.request_pattern.method_pattern.matches?(:post) &&
+          stub.request_pattern.uri_pattern.matches?(Addressable::URI.parse(webhook.url))
+      end
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = (uri.scheme == "https")
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def http_request
+      Net::HTTP::Post.new(uri, headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def uri
+      @uri ||= URI(webhook.url)
+    end
 end
