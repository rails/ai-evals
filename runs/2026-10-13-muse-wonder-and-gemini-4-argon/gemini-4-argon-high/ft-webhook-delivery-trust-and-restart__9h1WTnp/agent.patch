diff --git a/test/models/event/relaying_test.rb b/test/models/event/relaying_test.rb
new file mode 100644
index 0000000..406bfff
--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    stub_dns_resolution(PUBLIC_IP)
+  end
+
+  test "creating an event enqueues RelayJob" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      boards(:writebook).events.create!(
+        action: "card_published",
+        creator: users(:david),
+        eventable: cards(:logo)
+      )
+    end
+  end
+
+  test "relay_now triggers active subscribed webhooks on the same board" do
+    webhook = webhooks(:active)
+    event = events(:logo_published)
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      assert_enqueued_with(job: Webhook::DeliveryJob) do
+        event.relay_now
+      end
+    end
+  end
+
+  test "relay_now ignores inactive webhooks" do
+    webhook = webhooks(:active)
+    webhook.deactivate
+    event = events(:logo_published)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now ignores webhooks not subscribed to the event action" do
+    event = events(:layout_commented)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "end-to-end event creation relays and delivers webhook" do
+    webhook = webhooks(:active)
+    request_stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        boards(:writebook).events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo)
+        )
+      end
+    end
+
+    assert_requested request_stub, times: 1
+    delivery = webhook.deliveries.ordered.first
+    assert_equal "completed", delivery.state
+    assert delivery.succeeded?
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
