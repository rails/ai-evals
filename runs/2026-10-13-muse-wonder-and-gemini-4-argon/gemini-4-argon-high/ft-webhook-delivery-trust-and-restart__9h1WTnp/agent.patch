+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    webhooks.find_each do |webhook|
+      webhook.trigger(self)
+    end
+  end
+
+  private
+    def webhooks
+      Webhook.active.triggered_by(self)
+    end
+end
