index 0000000..1c994d8
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+    @succeeded_delivery = webhook_deliveries(:successfully_completed)
+    @failed_delivery = webhook_deliveries(:unsuccessfully_completed)
+  end
+
+  test "records first failure and increments count" do
+    freeze_time do
+      @tracker.record_delivery_of(@failed_delivery)
+
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "preserves first_failure_at across consecutive failures" do
+    first_failure_time = 10.minutes.ago.change(usec: 0)
+
+    travel_to first_failure_time do
+      @tracker.record_delivery_of(@failed_delivery)
+    end
+
+    @tracker.record_delivery_of(@failed_delivery)
+
+    assert_equal 2, @tracker.consecutive_failures_count
+    assert_equal first_failure_time, @tracker.first_failure_at
+  end
+
+  test "resets when delivery succeeds" do
+    @tracker.update!(consecutive_failures_count: 5, first_failure_at: 30.minutes.ago)
+
+    @tracker.record_delivery_of(@succeeded_delivery)
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "does not deactivate webhook when 10 failures occur in less than an hour" do
+    @tracker.record_delivery_of(@failed_delivery)
+
+    travel 59.minutes do
+      9.times { @tracker.record_delivery_of(@failed_delivery) }
+
+      assert_equal 10, @tracker.consecutive_failures_count
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "does not deactivate webhook when fewer than 10 failures occur over an hour" do
+    @tracker.record_delivery_of(@failed_delivery)
+
+    travel 2.hours do
+      8.times { @tracker.record_delivery_of(@failed_delivery) }
+
+      assert_equal 9, @tracker.consecutive_failures_count
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "deactivates webhook when 10 consecutive failures occur over an hour" do
+    @tracker.record_delivery_of(@failed_delivery)
+
+    travel 1.hour + 1.second do
+      9.times { @tracker.record_delivery_of(@failed_delivery) }
+
+      assert_equal 10, @tracker.consecutive_failures_count
+      assert_not @webhook.reload.active?
+    end
+  end
+end
