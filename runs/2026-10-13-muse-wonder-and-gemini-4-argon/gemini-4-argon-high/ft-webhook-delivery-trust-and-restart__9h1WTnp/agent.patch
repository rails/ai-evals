+++ b/app/models/webhook/triggerable.rb
@@ -0,0 +1,19 @@
+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :delinquency_tracker, dependent: :delete
+
+    scope :triggered_by, ->(event) { where(board: event.board).where("subscribed_actions LIKE ?", "%\"#{event.action}\"%") }
+
+    after_create :create_delinquency_tracker!
+  end
+
+  def trigger(event)
+    deliveries.create!(event: event)
+  end
+
+  def triggered_by?(event)
+    board == event.board && subscribed_actions.include?(event.action.to_s)
+  end
+end
