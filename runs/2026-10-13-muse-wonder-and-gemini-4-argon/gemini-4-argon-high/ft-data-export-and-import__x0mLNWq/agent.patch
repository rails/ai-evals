@@ -0,0 +1,71 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.session = sessions(:david)
+  end
+
+  test "build exports accessible cards as JSON with comments and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("attached file content"),
+      filename: "notes.txt",
+      content_type: "text/plain"
+    )
+    card.update!(description: "<p>Card description #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+
+    comment_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment file content"),
+      filename: "comment_doc.txt",
+      content_type: "text/plain"
+    )
+    comment = card.comments.create!(
+      creator: @user,
+      body: "<p>Comment with file #{ActionText::Attachment.from_attachable(comment_blob).to_html}</p>"
+    )
+
+    # Create a card on a private board that David cannot access
+    private_board = boards(:private)
+    assert_not private_board.accessible_to?(@user)
+    private_card = Current.set(user: users(:kevin)) { private_board.cards.create!(title: "Secret card", creator: users(:kevin), status: "published") }
+
+    export = @user.data_exports.create!(account: @account)
+
+    assert_enqueued_emails 1 do
+      export.build
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("#{card.number}.json")
+      assert_not zip.exists?("#{private_card.number}.json")
+
+      card_json = JSON.parse(zip.read("#{card.number}.json"))
+      assert_equal card.id, card_json["id"]
+      assert_equal card.number, card_json["number"]
+      assert_equal card.title, card_json["title"]
+      assert_includes card_json["description"], "Card description"
+
+      comment_ids = card_json["comments"].map { |c| c["id"] }
+      assert_includes comment_ids, comment.id
+      exported_comment = card_json["comments"].find { |c| c["id"] == comment.id }
+      assert_includes exported_comment["body"], "Comment with file"
+
+      # Attached pictures and files are included in the zip
+      assert zip.exists?("#{card.number}/moon.jpg")
+      assert zip.exists?("#{card.number}/notes.txt")
+      assert zip.exists?("#{card.number}/comment_doc.txt")
+      assert_equal "attached file content", zip.read("#{card.number}/notes.txt")
+      assert_equal "comment file content", zip.read("#{card.number}/comment_doc.txt")
+    end
+  end
+end
