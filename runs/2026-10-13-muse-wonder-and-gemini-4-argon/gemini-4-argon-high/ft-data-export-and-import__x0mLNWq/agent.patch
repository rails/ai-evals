@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.account = @account
+  end
+
+  test "build creates a zip archive with account data and sends email" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Account::Export.create!(account: @account, user: @user)
+
+    assert_enqueued_emails 1 do
+      export.build
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file) do |zip|
+      assert zip.exists?("data/accounts/#{@account.id}.json")
+      assert zip.exists?("data/boards/#{boards(:writebook).id}.json")
+      assert zip.exists?("data/cards/#{cards(:logo).id}.json")
+      assert zip.exists?("data/users/#{@user.id}.json")
+      assert zip.exists?("storage/#{cards(:logo).image.blob.key}")
+
+      # Does not include the export's own attachment or blob
+      assert_not zip.exists?("data/active_storage_blobs/#{export.file.blob.id}.json")
+      assert_not zip.exists?("storage/#{export.file.blob.key}")
+    end
+  end
+
+  test "cleanup destroys expired exports" do
+    recent_export = Account::Export.create!(account: @account, user: @user)
+    old_export = travel_to 2.days.ago do
+      Account::Export.create!(account: @account, user: @user)
+    end
+
+    assert_difference -> { Export.count }, -1 do
+      Export.cleanup
+    end
+
+    assert Export.exists?(recent_export.id)
+    assert_not Export.exists?(old_export.id)
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..cfc6134
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    @identity = identities(:kevin)
+    Current.account = @account
+    Current.session = sessions(:kevin)
+  end
+
+  test "exports an account and imports it into a new account with everything" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    embed_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("spec document"),
+      filename: "spec.txt",
+      content_type: "text/plain"
+    )
+    cards(:logo).update!(description: "<p>See #{ActionText::Attachment.from_attachable(embed_blob).to_html}</p>")
+
+    export = Account::Export.create!(account: @account, user: @user)
+    export.build
+
+    zip_bytes = export.file.download
+
+    expected_name = @account.name
+    expected_users_count = @account.users.count
+    expected_boards_count = @account.boards.count
+    expected_columns_count = @account.columns.count
+    expected_cards_count = @account.cards.count
+    expected_comments_count = Comment.where(account: @account).count
+    expected_tags_count = @account.tags.count
+
+    # Destroy the original account so record IDs don't conflict on the same database
+    perform_enqueued_jobs
+    @account.incinerate
+    perform_enqueued_jobs
+
+    new_account = Account.create!(name: "Importing...")
+    import = Current.with_account(new_account) do
+      Account::Import.create!(
+        account: new_account,
+        identity: @identity,
+        file: { io: StringIO.new(zip_bytes), filename: "export.zip", content_type: "application/zip" }
+      )
+    end
+
+    assert_enqueued_emails 1 do
+      import.process
+    end
+
+    assert import.reload.completed?
+    new_account.reload
+
+    assert_equal expected_name, new_account.name
+    assert_equal expected_users_count, new_account.users.count
+    assert_equal expected_boards_count, new_account.boards.count
+    assert_equal expected_columns_count, new_account.columns.count
+    assert_equal expected_cards_count, new_account.cards.count
+    assert_equal expected_comments_count, Comment.where(account: new_account).count
+    assert_equal expected_tags_count, new_account.tags.count
+
+    imported_card = new_account.cards.find_by!(number: 1)
+    assert_equal "The logo isn't big enough", imported_card.title
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+    assert_includes imported_card.description.to_plain_text, "See"
+    assert_equal 1, imported_card.attachments.count
+    assert_equal "spec document", imported_card.attachments.first.download
+  end
+
+  test "failed import due to invalid zip leaves nothing behind and sends failure email" do
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count }, -> { Comment.count }, -> { User.count }, -> { ActiveStorage::Blob.count }, -> { ActiveStorage::Attachment.count } ] do
+      new_account = Account.create!(name: "Importing...")
+      import = Current.with_account(new_account) do
+        Account::Import.create!(
+          account: new_account,
+          identity: @identity,
+          file: { io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip" }
+        )
+      end
+
+      assert_enqueued_emails 1 do
+        import.process
+      end
+
+      assert import.reload.failed?
+      assert_equal "invalid_file", import.failure_reason
+      assert_nil import.account_id
+      assert_not Account.exists?(new_account.id)
+    end
+  end
+
+  test "failed import due to conflict with existing account leaves nothing behind and sends failure email" do
+    export = Account::Export.create!(account: @account, user: @user)
+    export.build
+    perform_enqueued_jobs
+    zip_bytes = export.file.download
+
+    # Importing without deleting @account causes a primary key conflict on existing records
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count }, -> { Comment.count }, -> { User.count } ] do
+      new_account = Account.create!(name: "Importing...")
+      import = Current.with_account(new_account) do
+        Account::Import.create!(
+          account: new_account,
+          identity: @identity,
+          file: { io: StringIO.new(zip_bytes), filename: "export.zip", content_type: "application/zip" }
+        )
+      end
+
+      assert_enqueued_emails 1 do
+        import.process
+      end
+
+      assert import.reload.failed?
+      assert_equal "conflict", import.failure_reason
+      assert_nil import.account_id
+      assert_not Account.exists?(new_account.id)
+      assert Account.exists?(@account.id)
+    end
+  end
+end
