diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..33d4085
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,39 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthorized_access
+
+  layout "public"
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    if import_file.present?
+      account = Account.create!(name: "Importing...")
+      Current.with_account(account) do
+        @import = Account::Import.create!(account: account, identity: Current.identity, file: import_file)
+        @import.process_later
+      end
+
+      redirect_to account_import_path(@import, script_name: nil), notice: "Import started. You'll receive an email when it's done."
+    else
+      @import = Account::Import.new
+      flash.now[:alert] = "Please select an export file to import."
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+    @import = Current.identity.imports.find(params[:id])
+
+    if @import.completed? && @import.account.present?
+      redirect_to landing_url(script_name: @import.account.slug)
+    end
+  end
+
+  private
+    def import_file
+      params[:file] || params.dig(:account_import, :file) || params.dig(:import, :file)
+    end
+end
