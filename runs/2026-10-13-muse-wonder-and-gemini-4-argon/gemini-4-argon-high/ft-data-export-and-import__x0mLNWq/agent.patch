 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+    @user = users(:david)
+    @card = cards(:logo)
+  end
+
+  test "export converts attachment sgid to gid and import restores sgid and updates blob url" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    mention_html = ActionText::Attachment.from_attachable(@user).to_html
+    blob_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    @card.update!(description: "<p>Hello #{mention_html} check #{blob_html}</p>")
+    rich_text = @card.rich_text_description
+
+    tempfile = Tempfile.new([ "rich_text", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export(to: writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    exported_file = "data/action_text_rich_texts/#{rich_text.id}.json"
+    assert reader.exists?(exported_file)
+
+    exported_data = JSON.parse(reader.read(exported_file))
+    assert_includes exported_data["body"], @user.to_gid.to_s
+    assert_includes exported_data["body"], blob.to_gid.to_s
+    assert_not_includes exported_data["body"], @user.attachable_sgid
+    assert_not_includes exported_data["body"], blob.attachable_sgid
+
+    # Delete original rich texts and import into a new account
+    rich_text_id = rich_text.id
+    ActionText::RichText.where(account: @account).delete_all
+
+    new_account = Account.create!(name: "New Account")
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(new_account).import(from: reader)
+
+    imported_rich_text = ActionText::RichText.find(rich_text_id)
+    assert_equal new_account.id, imported_rich_text.account_id
+
+    imported_html = imported_rich_text.body.to_html
+    assert_includes imported_html, @user.attachable_sgid
+    assert_includes imported_html, blob.attachable_sgid
+    assert_includes imported_html, "#{new_account.slug}/rails/active_storage/blobs/redirect/"
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
 end
