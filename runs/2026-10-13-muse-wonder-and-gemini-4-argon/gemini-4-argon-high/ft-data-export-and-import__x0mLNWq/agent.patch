diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..c6749ad
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,75 @@
+class ZipFile::Reader
+  InvalidFileError = Class.new(StandardError)
+
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+  end
+
+  def read(path)
+    entry = entries_by_path[path]
+    return nil unless entry
+
+    ensure_offset(entry)
+    extractor = entry.extractor_from(@io)
+
+    if block_given?
+      read_to_tempfile(extractor) { |tempfile| yield tempfile }
+    else
+      read_to_string(extractor)
+    end
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::LocalHeaderPending => e
+    raise InvalidFileError, e.message
+  end
+
+  def glob(pattern)
+    entries_by_path.keys.select { |e| File.fnmatch(pattern, e) }.sort
+  end
+
+  def exists?(path)
+    entries_by_path.key?(path)
+  end
+
+  def close
+    @io.close if @io.respond_to?(:close)
+  end
+
+  private
+    def entries_by_path
+      @entries_by_path ||= read_entries.index_by(&:filename)
+    end
+
+    def read_entries
+      @file_reader.read_zip_structure(io: @io, read_local_headers: false)
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::MissingEOCD => e
+      raise InvalidFileError, e.message
+    end
+
+    def ensure_offset(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @file_reader.get_compressed_data_offset(
+          io: @io,
+          local_file_header_offset: entry.local_file_header_offset
+        )
+      end
+    end
+
+    def read_to_string(extractor)
+      result = +""
+      result << extractor.extract(CHUNK_SIZE) until extractor.eof?
+      result
+    end
+
+    def read_to_tempfile(extractor)
+      tempfile = Tempfile.new("zip-entry")
+      tempfile.binmode
+      tempfile.write(extractor.extract(CHUNK_SIZE)) until extractor.eof?
+      tempfile.rewind
+      yield tempfile
+    ensure
+      tempfile&.close
+      tempfile&.unlink
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..931c476
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,50 @@
+class ZipFile::RemoteIO < ZipKit::RemoteIO
+  def initialize(url, verify_ssl: true)
+    super(url)
+    @verify_ssl = verify_ssl
+  end
+
+  protected
+    def request_range(range)
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = range
+        response = http.request(request)
+
+        case response.code
+        when "206", "200"
+          response.body
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+    def request_object_size
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = 0..0
+        response = http.request(request)
+
+        case response.code
+        when "206"
+          content_range_header_value = response["Content-Range"]
+          content_range_header_value.split("/").last.to_i
+        when "200"
+          response["Content-Length"].to_i
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+  private
+    def with_http
+      http = Net::HTTP.new(@uri.hostname, @uri.port)
+      if @uri.scheme == "https"
+        http.use_ssl = true
+        http.verify_mode = OpenSSL::SSL::VERIFY_NONE unless @verify_ssl
+      end
+      http.start { |h| yield h }
+    end
+end
