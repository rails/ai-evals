diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..d8a0e2f
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users(:kevin)
+    @member = users(:jz)
+    sign_in_as @admin
+  end
+
+  test "admin sees export option on account settings" do
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "non-admin does not see export option on account settings" do
+    logout_and_sign_in_as @member
+
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+
+  test "admin can create an account export and receive an email when ready" do
+    assert_difference -> { Account::Export.count }, +1 do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post account_exports_path
+        end
+      end
+    end
+
+    assert_redirected_to account_settings_path
+
+    export = Account::Export.last
+    assert export.completed?
+    assert export.file.attached?
+  end
+
+  test "non-admin cannot create an account export" do
+    logout_and_sign_in_as @member
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "admin can view and download completed export within a day" do
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a#download-export-link"
+
+    get rails_blob_path(export.file, disposition: "attachment")
+    assert_response :redirect
+  end
+
+  test "export download link expires after a day" do
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    travel 2.days do
+      get account_export_path(export)
+      assert_response :success
+      assert_select "a#download-export-link", count: 0
+      assert_in_body "expired"
+
+      get rails_blob_path(export.file, disposition: "attachment")
+      assert_response :forbidden
+    end
+  end
+
+  test "another admin cannot download someone else's account export" do
+    export = @account.exports.create!(user: @admin)
+    export.build
+
+    logout_and_sign_in_as users(:jason)
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a#download-export-link", count: 0
+
+    get rails_blob_path(export.file, disposition: "attachment")
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..4b3a9ca
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    @identity = identities(:kevin)
+    sign_in_as @identity
+  end
+
+  test "new renders import form at /account/imports/new" do
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      assert_select "form[action='#{account_imports_path(script_name: nil)}']"
+    end
+  end
+
+  test "unauthenticated user is redirected to login" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+      assert_redirected_to new_session_path(script_name: nil)
+    end
+  end
+
+  test "signed in user can upload an account export zip and get a new account with everything" do
+    export = nil
+    perform_enqueued_jobs do
+      export = Current.with_account(@account) do
+        Account::Export.create!(account: @account, user: @user).tap(&:build)
+      end
+    end
+
+    tempfile = Tempfile.new([ "account_export", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+
+    perform_enqueued_jobs do
+      @account.incinerate
+    end
+
+    uploaded_file = Rack::Test::UploadedFile.new(tempfile.path, "application/zip")
+
+    untenanted do
+      assert_difference -> { Account::Import.count }, +1 do
+        assert_emails 1 do
+          perform_enqueued_jobs do
+            post account_imports_path, params: { file: uploaded_file }
+          end
+        end
+      end
+
+      import = Account::Import.last
+      assert_redirected_to account_import_path(import, script_name: nil)
+
+      assert import.completed?
+      assert_not_nil import.account
+      assert_equal "37signals", import.account.name
+
+      get account_import_path(import)
+      assert_redirected_to landing_url(script_name: import.account.slug)
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "failed import sends email and shows failure page while leaving nothing behind" do
+    tempfile = Tempfile.new([ "invalid", ".zip" ])
+    tempfile.write("not a zip")
+    tempfile.rewind
+
+    uploaded_file = Rack::Test::UploadedFile.new(tempfile.path, "application/zip")
+
+    untenanted do
+      assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count } ] do
+        assert_emails 1 do
+          perform_enqueued_jobs do
+            post account_imports_path, params: { file: uploaded_file }
+          end
+        end
+      end
+
+      import = Account::Import.last
+      assert import.failed?
+      assert_nil import.account
+
+      get account_import_path(import)
+      assert_response :success
+      assert_in_body "Import failed"
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
