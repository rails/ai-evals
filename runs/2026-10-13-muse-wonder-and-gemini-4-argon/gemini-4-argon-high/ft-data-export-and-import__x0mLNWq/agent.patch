+require "test_helper"
+
+class ExportMailerTest < ActionMailer::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    Current.account = @account
+  end
+
+  test "completed for account export" do
+    export = Account::Export.create!(account: @account, user: @user, status: :completed)
+    email = ExportMailer.completed(export)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy data export is ready for download", email.subject
+    assert_match account_export_url(export, script_name: @account.slug, host: "example.com"), email.body.encoded
+    assert_match /24 hours|1 day|about 24 hours/i, email.body.encoded
+  end
+
+  test "completed for user data export" do
