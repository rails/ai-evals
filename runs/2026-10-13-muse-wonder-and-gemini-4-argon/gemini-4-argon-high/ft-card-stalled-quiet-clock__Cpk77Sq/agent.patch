@@ -0,0 +1,20 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER_LAST_SPIKE_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { active.doing.where(last_active_at: ..STALLED_AFTER_LAST_SPIKE_PERIOD.ago) }
+  end
+
+  def stalled?
+    active? && doing? && last_active_at <= STALLED_AFTER_LAST_SPIKE_PERIOD.ago
+  end
+
+  def stalled_for_days
+    if stalled?
+      ((Time.current - last_active_at) / 1.day).to_i
+    end
+  end
+  alias_method :stalled_days, :stalled_for_days
+end
