diff --git a/test/models/card/engageable_test.rb b/test/models/card/engageable_test.rb
new file mode 100644
index 0000000..1d6ea1f
--- /dev/null
+++ b/test/models/card/engageable_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Card::EngageableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card gets a burst when three or more comments from at least two people land within a third of board auto-close period" do
+    card = cards(:text)
+    card.board.update!(auto_postpone_period: 30.days)
+
+    assert_not card.doing?
+
+    card.comments.create!(creator: users(:david), body: "First comment", created_at: 8.days.ago)
+    assert_not card.doing?
+
+    card.comments.create!(creator: users(:kevin), body: "Second comment", created_at: 4.days.ago)
+    assert_not card.doing?
+
+    card.comments.create!(creator: users(:david), body: "Third comment", created_at: 1.day.ago)
+    assert card.doing?
+    assert card.engaged?
+    assert_includes Card.doing, card
+  end
+
+  test "three comments from the same person do not trigger a burst" do
+    card = cards(:text)
+    card.board.update!(auto_postpone_period: 30.days)
+
+    card.comments.create!(creator: users(:david), body: "First comment", created_at: 2.hours.ago)
+    card.comments.create!(creator: users(:david), body: "Second comment", created_at: 1.hour.ago)
+    card.comments.create!(creator: users(:david), body: "Third comment", created_at: Time.current)
+
+    assert_not card.doing?
+  end
+
+  test "three comments from two people outside a third of the board auto-close period do not trigger a burst" do
+    card = cards(:text)
+    card.board.update!(auto_postpone_period: 30.days)
+
+    card.comments.create!(creator: users(:david), body: "First comment", created_at: 12.days.ago)
+    card.comments.create!(creator: users(:kevin), body: "Second comment", created_at: 6.days.ago)
+    card.comments.create!(creator: users(:david), body: "Third comment", created_at: Time.current)
+
+    assert_not card.doing?
+  end
+
+  test "system comments do not count toward comment burst" do
+    card = cards(:text)
+    card.board.update!(auto_postpone_period: 30.days)
+
+    card.comments.create!(creator: users(:david), body: "First user comment")
+    card.comments.create!(creator: users(:kevin), body: "Second user comment")
+    card.comments.create!(creator: card.account.system_user, body: "System comment")
+
+    assert_not card.doing?
+  end
+
+  test "uses account default auto-close period when board has no custom entropy" do
+    card = cards(:text)
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update!(auto_postpone_period: 30.days)
+
+    card.comments.create!(creator: users(:david), body: "First comment", created_at: 9.days.ago)
+    card.comments.create!(creator: users(:kevin), body: "Second comment", created_at: 5.days.ago)
+    card.comments.create!(creator: users(:david), body: "Third comment", created_at: Time.current)
+
+    assert card.doing?
+  end
+
+  test "card gets a burst when someone is assigned to it" do
+    card = cards(:text)
+    assert_not card.doing?
+
+    card.toggle_assignment(users(:david))
+    assert card.doing?
+  end
+
+  test "card gets a burst when reopened" do
+    card = cards(:shipping)
+    assert card.closed?
+    assert_not card.doing?
+
+    card.reopen
+    assert card.doing?
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..41c890c
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card with a burst from comments is stalled after two weeks of no activity" do
+    freeze_time
+
+    card = cards(:logo)
+    assert_not card.stalled?
+
+    card.comments.create!(creator: users(:david), body: "Third user comment")
+    assert card.doing?
+    assert_not card.stalled?
+
+    travel 13.days
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 1.day
+    assert card.stalled?
+    assert_includes Card.stalled, card
+    assert_includes Card.indexed_by("stalled"), card
+  end
+
+  test "card with a burst from assignment is stalled after two weeks of no activity" do
+    freeze_time
+
+    card = cards(:text)
+    card.toggle_assignment(users(:david))
+    assert_not card.stalled?
+
+    travel 2.weeks
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "card with a burst from reopening is stalled after two weeks of no activity" do
+    freeze_time
+
+    card = cards(:shipping)
+    card.reopen
+    assert_not card.stalled?
+
+    travel 2.weeks
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "card without a burst is not stalled after two weeks of no activity" do
+    card = cards(:text)
+    card.update!(last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "closed or postponed cards are not stalled" do
+    card = cards(:text)
+    card.toggle_assignment(users(:david))
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+
+    card.close
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    card.reopen
+    card.postpone
+    card.update!(last_active_at: 3.weeks.ago)
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "any activity on a stalled card resets it" do
+    card = cards(:text)
+    card.toggle_assignment(users(:david))
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+
+    # Comment activity resets stalled
+    card.comments.create!(creator: users(:david), body: "Activity")
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    # Reaction activity resets stalled
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    card.reactions.create!(content: "👍", reacter: users(:kevin))
+    assert_not card.reload.stalled?
+
+    # Title change resets stalled
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    card.update!(title: "Updated title")
+    assert_not card.reload.stalled?
+
+    # Description change resets stalled
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    card.update!(description: "Updated description")
+    assert_not card.reload.stalled?
+
+    # Step activity resets stalled
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    step = card.steps.create!(content: "Do something")
+    assert_not card.reload.stalled?
+
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    step.update!(completed: true)
+    assert_not card.reload.stalled?
+
+    # Tagging activity resets stalled
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    card.toggle_tag_with("urgent")
+    assert_not card.reload.stalled?
+
+    # Triage activity resets stalled
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    card.triage_into(columns(:writebook_review))
+    assert_not card.reload.stalled?
+  end
+end
