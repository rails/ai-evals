diff --git a/app/models/card/engageable.rb b/app/models/card/engageable.rb
new file mode 100644
index 0000000..07a6873
--- /dev/null
+++ b/app/models/card/engageable.rb
@@ -0,0 +1,54 @@
+module Card::Engageable
+  extend ActiveSupport::Concern
+
+  COMMENTS_FOR_SPIKE = 3
+  COMMENTERS_FOR_SPIKE = 2
+
+  included do
+    has_one :engagement, dependent: :destroy
+
+    scope :doing, -> { active.joins(:engagement).where(card_engagements: { status: :doing }) }
+    scope :engaged, -> { doing }
+
+    after_save :check_for_engagement, if: :saved_change_to_last_active_at?
+  end
+
+  def doing?
+    active? && engagement.present? && !engagement.destroyed? && engagement.doing?
+  end
+  alias_method :engaged?, :doing?
+  alias_method :burst?, :doing?
+
+  def engage
+    if engagement && !engagement.destroyed?
+      engagement.doing! unless engagement.doing?
+    else
+      create_engagement!(status: :doing)
+    end
+  end
+
+  private
+    def check_for_engagement
+      if active? && !doing? && spike_of_comments?
+        engage
+      end
+    end
+
+    def spike_of_comments?
+      return false unless board&.entropy
+
+      window = (auto_postpone_period / 3.0).seconds
+      user_comments = comments.by_user.order(:created_at).pluck(:created_at, :creator_id)
+
+      if user_comments.size >= COMMENTS_FOR_SPIKE
+        user_comments.each_with_index.any? do |(start_time, _), index|
+          end_time = start_time + window
+          window_comments = user_comments[index..].take_while { |created_at, _| created_at <= end_time }
+          window_comments.size >= COMMENTS_FOR_SPIKE && window_comments.map(&:last).uniq.size >= COMMENTERS_FOR_SPIKE
+        end
+      else
+        false
+      end
+    end
+    alias_method :burst_of_comments?, :spike_of_comments?
+end
