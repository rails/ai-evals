diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..8dd999c
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "search page without query" do
+    get search_path
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "search page with blank query" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "finds cards by title with matched words wrapped in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:logo))}" do
+      assert_select "mark", text: "logo"
+    end
+    assert_includes response.body, "The <mark>logo</mark> isn't big enough"
+    assert_select "##{dom_id(cards(:layout))}", count: 0
+  end
+
+  test "finds cards by description with matched words wrapped in mark" do
+    cards(:buy_domain).update!(description: "Register the domain with Cloudflare soon")
+
+    get search_path(q: "Cloudflare")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:buy_domain))}" do
+      assert_select "mark", text: "Cloudflare"
+    end
+    assert_includes response.body, "Register the domain with <mark>Cloudflare</mark> soon"
+  end
+
+  test "finds cards by comment body with matched words wrapped in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))}" do
+      assert_select "mark", text: "overflowing"
+    end
+    assert_includes response.body, "The text is <mark>overflowing</mark> the container."
+    assert_select "##{dom_id(cards(:logo))}", count: 0
+  end
+
+  test "case-insensitive matching preserves original word casing in mark" do
+    get search_path(q: "broken")
+    assert_response :success
+    assert_includes response.body, "Layout is <mark>broken</mark>"
+
+    get search_path(q: "layout")
+    assert_response :success
+    assert_includes response.body, "<mark>Layout</mark> is broken"
+  end
+
+  test "highlights multiple matched words" do
+    get search_path(q: "logo big")
+    assert_response :success
+
+    assert_includes response.body, "The <mark>logo</mark> isn't <mark>big</mark> enough"
+  end
+
+  test "orders results newest first" do
+    older_card, middle_card, newer_card = with_current_user(:david) do
+      [
+        boards(:writebook).cards.create!(title: "Older search target", status: "published", created_at: 3.days.ago),
+        boards(:writebook).cards.create!(title: "Middle search target", status: "published", created_at: 2.days.ago),
+        boards(:writebook).cards.create!(title: "Newer search target", status: "published", created_at: 1.day.ago)
+      ]
+    end
+
+    get search_path(q: "target")
+    assert_response :success
+
+    card_ids = css_select("article.card").map { |node| node["id"] }
+    expected_ids = [
+      dom_id(newer_card, :article),
+      dom_id(middle_card, :article),
+      dom_id(older_card, :article)
+    ]
+    assert_equal expected_ids, card_ids
+  end
+
+  test "only shows results from boards the user currently has access to" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(
+        title: "Secret roadmap item",
+        description: "Confidential details",
+        status: "published"
+      ).tap do |card|
+        card.comments.create!(body: "Secret comment")
+      end
+    end
+
+    # David does not have access to boards(:private)
+    get search_path(q: "Secret")
+    assert_response :success
+    assert_select "##{dom_id(private_card)}", count: 0
+    assert_no_match "Secret", response.body.gsub(/value="Secret"/, "")
+
+    # Kevin has access to boards(:private)
+    logout_and_sign_in_as :kevin
+    get search_path(q: "Secret")
+    assert_response :success
+    assert_select "##{dom_id(private_card)}"
+
+    # Revoking David's access to writebook hides writebook cards from David
+    logout_and_sign_in_as :david
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:david))
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "##{dom_id(cards(:logo))}", count: 0
+  end
+
+  test "never shows results from other accounts" do
+    get search_path(q: "radio")
+    assert_response :success
+    assert_select "##{dom_id(cards(:radio))}", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft_card = boards(:writebook).cards.create!(
+      title: "Unpublished zeppelin idea",
+      description: "Draft description with zeppelin",
+      creator: users(:david),
+      status: "drafted"
+    )
+    draft_comment = draft_card.comments.build(body: "Draft comment about zeppelin", creator: users(:david), account: draft_card.account)
+    draft_comment.tap(&:valid?).save!(validate: false)
+
+    get search_path(q: "zeppelin")
+    assert_response :success
+    assert_select "##{dom_id(draft_card)}", count: 0
+    assert_no_match "Unpublished zeppelin idea", response.body
+    assert_no_match "Draft comment about zeppelin", response.body
+  end
+
+  test "card that becomes drafted after having comments does not turn up" do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(
+        title: "Temporary published card",
+        status: "published"
+      ).tap do |c|
+        c.comments.create!(body: "Unique word platypus in comment")
+        c.update!(status: "drafted")
+      end
+    end
+
+    get search_path(q: "platypus")
+    assert_response :success
+    assert_select "##{dom_id(card)}", count: 0
+    assert_no_match "platypus", response.body.gsub(/value="platypus"/, "")
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..3c69a9b
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "search finds cards by title, description, or comment body" do
+    cards(:buy_domain).update!(description: "Check availability for example.org")
+
+    assert_includes users(:david).accessible_cards.search("logo"), cards(:logo)
+    assert_includes users(:david).accessible_cards.search("availability"), cards(:buy_domain)
+    assert_includes users(:david).accessible_cards.search("overflowing"), cards(:layout)
+  end
+
+  test "search orders newest first" do
+    older = boards(:writebook).cards.create!(title: "Matching alpha", status: "published", created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Matching beta", status: "published", created_at: 1.day.ago)
+
+    results = users(:david).accessible_cards.search("Matching")
+    assert_equal [ newer, older ], results.to_a
+  end
+
+  test "search excludes draft cards and their comments" do
+    draft = boards(:writebook).cards.create!(
+      title: "Draft card marsupial",
+      description: "Marsupial description",
+      status: "drafted"
+    )
+    draft.comments.build(body: "Marsupial comment", creator: users(:david), account: draft.account).tap(&:valid?).save!(validate: false)
+
+    assert_empty users(:david).accessible_cards.search("marsupial")
+  end
+
+  test "search does not match HTML tag names in rich text" do
+    card = boards(:writebook).cards.create!(
+      title: "Plain title",
+      description: "<p><strong>Hello</strong> world</p>",
+      status: "published"
+    )
+
+    assert_not_includes users(:david).accessible_cards.search("strong"), card
+    assert_includes users(:david).accessible_cards.search("Hello"), card
+  end
+end
