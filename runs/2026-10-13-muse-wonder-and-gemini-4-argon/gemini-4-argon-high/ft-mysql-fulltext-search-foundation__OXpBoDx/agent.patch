+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="cards cards--grid">
+  <%= form_with url: search_path, method: :get, class: "flex justify-center margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search…", class: "input filter__terms", autofocus: true, autocomplete: "off", autocorrect: "off" %>
+  <% end %>
+
+  <div class="cards__list hide-scrollbar">
+    <%= with_automatic_pagination :search_paginated_container, @page do %>
+      <%= render partial: "searches/card", collection: @page.records, as: :card, locals: { query: @query } %>
+    <% end %>
+
+    <% if @query.present? && @page.records.empty? %>
+      <div class="blank-slate">No cards match that search</div>
+    <% end %>
+  </div>
+</section>
