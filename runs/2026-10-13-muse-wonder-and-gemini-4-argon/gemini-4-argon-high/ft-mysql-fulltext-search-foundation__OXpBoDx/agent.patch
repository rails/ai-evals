diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..67931c4
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,78 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(query) do
+      terms = search_terms_for(query)
+
+      if terms.empty?
+        none
+      else
+        candidates = terms.reduce(published) { |relation, term| relation.matching_term(term) }
+        matching_ids = candidates.preload(:rich_text_description, comments: :rich_text_body).select { |card| card.matches_search_terms?(terms) }.map(&:id)
+        where(id: matching_ids)
+      end
+    end
+
+    scope :matching_term, ->(term) do
+      pattern = "%#{sanitize_sql_like(term)}%"
+      escaped_pattern = "%#{sanitize_sql_like(CGI.escapeHTML(term))}%"
+
+      where(
+        <<~SQL, pattern: pattern, escaped_pattern: escaped_pattern
+          LOWER(cards.title) LIKE LOWER(:pattern)
+          OR EXISTS (
+            SELECT 1 FROM action_text_rich_texts
+            WHERE action_text_rich_texts.record_type = 'Card'
+              AND action_text_rich_texts.name = 'description'
+              AND action_text_rich_texts.record_id = cards.id
+              AND (LOWER(action_text_rich_texts.body) LIKE LOWER(:pattern) OR LOWER(action_text_rich_texts.body) LIKE LOWER(:escaped_pattern))
+          )
+          OR EXISTS (
+            SELECT 1 FROM comments
+            INNER JOIN action_text_rich_texts
+              ON action_text_rich_texts.record_type = 'Comment'
+              AND action_text_rich_texts.name = 'body'
+              AND action_text_rich_texts.record_id = comments.id
+            WHERE comments.card_id = cards.id
+              AND (LOWER(action_text_rich_texts.body) LIKE LOWER(:pattern) OR LOWER(action_text_rich_texts.body) LIKE LOWER(:escaped_pattern))
+          )
+        SQL
+      )
+    end
+
+    scope :search, ->(query) { published.matching(query).reverse_chronologically }
+  end
+
+  class_methods do
+    def search_terms_for(query)
+      query.to_s.strip.split.uniq
+    end
+  end
+
+  def matches_search_terms?(terms)
+    return false if drafted?
+
+    texts = searchable_texts
+    terms.all? do |term|
+      regex = /#{Regexp.escape(term)}/i
+      texts.any? { |text| text.match?(regex) }
+    end
+  end
+
+  def matching_comments(query)
+    terms = self.class.search_terms_for(query)
+
+    if terms.empty? || drafted?
+      []
+    else
+      pattern = /#{terms.map { Regexp.escape(it) }.join("|")}/i
+      comments.select { |comment| comment.body.to_plain_text.match?(pattern) }
+    end
+  end
+
+  private
+    def searchable_texts
+      [ title.to_s, description.to_plain_text, *comments.map { |comment| comment.body.to_plain_text } ]
+    end
+end
diff --git a/app/views/searches/_card.html.erb b/app/views/searches/_card.html.erb
