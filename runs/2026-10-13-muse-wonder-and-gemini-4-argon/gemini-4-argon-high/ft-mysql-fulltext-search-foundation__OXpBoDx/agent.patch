+module SearchesHelper
+  def highlight_terms(text, query)
+    text = text.to_plain_text if text.respond_to?(:to_plain_text)
+    text = text.to_s
+    return "" if text.blank?
+
+    terms = Card.search_terms_for(query).sort_by { -it.length }
+
+    if terms.empty?
+      escape_search_text(text).html_safe
+    else
+      pattern = /(#{terms.map { Regexp.escape(it) }.join("|")})/i
+      text.split(pattern).map.with_index do |part, index|
+        if index.odd?
+          "<mark>#{escape_search_text(part)}</mark>"
+        else
+          escape_search_text(part)
+        end
+      end.join.html_safe
+    end
+  end
+
+  private
+    def escape_search_text(text)
+      text.to_s.gsub(/[&<>"]/, "&" => "&amp;", "<" => "&lt;", ">" => "&gt;", "\"" => "&quot;")
+    end
+end
