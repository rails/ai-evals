+  def test_unwatch_with_a_rails_7_0_legacy_marshal_metadata_envelope_token_removes_the_watcher
+    assert Issue.find(2).watched_by?(User.find(3))
+
+    secret = OpenSSL::PKCS5.pbkdf2_hmac(
+      Rails.application.secret_key_base, 'mail_links', 1000, 64, OpenSSL::Digest.new('SHA256')
+    )
+    envelope = ActiveSupport::JSON.encode(
+      '_rails' => {
+        'message' => Base64.strict_encode64(Marshal.dump({'user_id' => 3, 'issue_id' => 2})),
+        'exp' => 30.days.from_now.utc.iso8601(3),
+        'pur' => 'unwatch'
+      }
+    )
+    data = Base64.strict_encode64(envelope)
+    token = "#{data}--#{OpenSSL::HMAC.hexdigest('SHA1', secret, data)}"
+
+    get :unwatch, :params => {:token => token}
+
+    assert_response :success
+    assert_not Issue.find(2).watched_by?(User.find(3))
+  end
+
