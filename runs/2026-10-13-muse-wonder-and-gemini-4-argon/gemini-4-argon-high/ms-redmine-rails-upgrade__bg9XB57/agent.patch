+  def test_session_cookie_from_rails_7_2_sha256_is_accepted
+    user = User.find(2)
+    tk = user.generate_session_token
+    auth_salt = Rails.application.config.action_dispatch.authenticated_encrypted_cookie_salt
+    sha256_key = OpenSSL::PKCS5.pbkdf2_hmac(
+      Rails.application.secret_key_base, auth_salt, 1000, 32, OpenSSL::Digest.new('SHA256')
+    )
+    encryptor = ActiveSupport::MessageEncryptor.new(
+      sha256_key, :cipher => "aes-256-gcm", :serializer => ActiveSupport::MessageEncryptor::NullSerializer
+    )
+    payload = ActiveSupport::JSON.encode({"session_id" => "sha256session", "user_id" => user.id, "tk" => tk})
+    cookies["_redmine_session"] = encryptor.encrypt_and_sign(payload, :purpose => "cookie._redmine_session")
+
+    get "/my/account"
+    assert_response :success
+  end
 end
