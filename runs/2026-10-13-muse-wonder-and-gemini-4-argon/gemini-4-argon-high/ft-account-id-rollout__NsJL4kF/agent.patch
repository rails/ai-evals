diff --git a/test/models/account_test.rb b/test/models/account_test.rb
index 75da41f..15d587c 100644
--- a/test/models/account_test.rb
+++ b/test/models/account_test.rb
@@ -81,4 +81,118 @@ class AccountTest < ActiveSupport::TestCase
     assert_equal custom_id, account.external_account_id
     assert_equal sequence_value_before, Account::ExternalIdSequence.value
   end
+
+  test "every table that holds an account's data has a required and indexed account_id column" do
+    non_account_tables = %w[
+      accounts
+      account_external_id_sequences
+      action_pack_passkeys
+      assignees_filters
+      assigners_filters
+      boards_filters
+      closers_filters
+      creators_filters
+      filters_tags
+      identities
+      identity_access_tokens
+      magic_links
+      schema_migrations
+      ar_internal_metadata
+      search_records_fts
+      search_records_fts_colsize
+      search_records_fts_config
+      search_records_fts_content
+      search_records_fts_data
+      search_records_fts_docsize
+      search_records_fts_idx
+      sessions
+      storage_totals
+    ]
+
+    connection = ActiveRecord::Base.connection
+    account_tables = connection.tables - non_account_tables
+
+    assert_not_empty account_tables
+
+    account_tables.each do |table|
+      column = connection.columns(table).find { |c| c.name == "account_id" }
+      assert_not_nil column, "Expected #{table} to have an account_id column"
+      assert_not column.null, "Expected #{table}.account_id to be NOT NULL"
+      assert connection.index_exists?(table, :account_id), "Expected #{table} to have an index on account_id"
+    end
+  end
+
+  test "migration backfills account_id and drops orphaned rows" do
+    require Rails.root.join("db/migrate/20260710000000_add_account_id_to_all_tables")
+
+    conn = ActiveRecord::Base.connection
+    migration = AddAccountIdToAllTables.new
+
+    migration.suppress_messages do
+      migration.migrate(:down)
+    end
+
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    user = users(:david)
+    webhook = webhooks(:active)
+
+    missing_uuid = ActiveRecord::Type::Uuid.generate
+    uuid_type = ActiveRecord::Type.lookup(:uuid, adapter: conn.adapter_name == "SQLite" ? :sqlite3 : :trilogy)
+    missing_bin = conn.quote(uuid_type.serialize(missing_uuid))
+    now = conn.quote(Time.current)
+
+    orphan_access_id = ActiveRecord::Type::Uuid.generate
+    conn.execute("INSERT INTO accesses (id, board_id, user_id, involvement, created_at, updated_at) VALUES (#{conn.quote(uuid_type.serialize(orphan_access_id))}, #{missing_bin}, #{missing_bin}, 'access_only', #{now}, #{now})")
+
+    orphan_pin_id = ActiveRecord::Type::Uuid.generate
+    conn.execute("INSERT INTO pins (id, card_id, user_id, created_at, updated_at) VALUES (#{conn.quote(uuid_type.serialize(orphan_pin_id))}, #{missing_bin}, #{missing_bin}, #{now}, #{now})")
+
+    orphan_rich_text_id = ActiveRecord::Type::Uuid.generate
+    conn.execute("INSERT INTO action_text_rich_texts (id, record_type, record_id, name, body, created_at, updated_at) VALUES (#{conn.quote(uuid_type.serialize(orphan_rich_text_id))}, 'Conversation::Message', #{missing_bin}, 'content', 'hello', #{now}, #{now})")
+
+    orphan_blob_id = ActiveRecord::Type::Uuid.generate
+    conn.execute("INSERT INTO active_storage_blobs (id, key, filename, byte_size, service_name, created_at) VALUES (#{conn.quote(uuid_type.serialize(orphan_blob_id))}, 'orphan-key', 'orphan.txt', 10, 'local', #{now})")
+
+    valid_blob_id = ActiveRecord::Type::Uuid.generate
+    valid_att_id = ActiveRecord::Type::Uuid.generate
+    valid_var_id = ActiveRecord::Type::Uuid.generate
+    valid_var_blob_id = ActiveRecord::Type::Uuid.generate
+    valid_var_att_id = ActiveRecord::Type::Uuid.generate
+
+    conn.execute("INSERT INTO active_storage_blobs (id, key, filename, byte_size, service_name, created_at) VALUES (#{conn.quote(uuid_type.serialize(valid_blob_id))}, 'valid-key', 'valid.jpg', 100, 'local', #{now})")
+    conn.execute("INSERT INTO active_storage_attachments (id, name, record_type, record_id, blob_id, created_at) VALUES (#{conn.quote(uuid_type.serialize(valid_att_id))}, 'image', 'Card', #{conn.quote(uuid_type.serialize(card.id))}, #{conn.quote(uuid_type.serialize(valid_blob_id))}, #{now})")
+    conn.execute("INSERT INTO active_storage_variant_records (id, blob_id, variation_digest) VALUES (#{conn.quote(uuid_type.serialize(valid_var_id))}, #{conn.quote(uuid_type.serialize(valid_blob_id))}, 'digest1')")
+    conn.execute("INSERT INTO active_storage_blobs (id, key, filename, byte_size, service_name, created_at) VALUES (#{conn.quote(uuid_type.serialize(valid_var_blob_id))}, 'valid-var-key', 'valid_var.jpg', 50, 'local', #{now})")
+    conn.execute("INSERT INTO active_storage_attachments (id, name, record_type, record_id, blob_id, created_at) VALUES (#{conn.quote(uuid_type.serialize(valid_var_att_id))}, 'image', 'ActiveStorage::VariantRecord', #{conn.quote(uuid_type.serialize(valid_var_id))}, #{conn.quote(uuid_type.serialize(valid_var_blob_id))}, #{now})")
+
+    migration.suppress_messages do
+      migration.migrate(:up)
+    end
+
+    assert_not Access.exists?(orphan_access_id)
+    assert_not Pin.exists?(orphan_pin_id)
+    assert_not ActionText::RichText.exists?(orphan_rich_text_id)
+    assert_not ActiveStorage::Blob.exists?(orphan_blob_id)
+
+    assert_equal account.id, ActiveStorage::Blob.find(valid_blob_id).account_id
+    assert_equal account.id, ActiveStorage::Attachment.find(valid_att_id).account_id
+    assert_equal account.id, ActiveStorage::VariantRecord.find(valid_var_id).account_id
+    assert_equal account.id, ActiveStorage::Attachment.find(valid_var_att_id).account_id
+    assert_equal account.id, ActiveStorage::Blob.find(valid_var_blob_id).account_id
+
+    assert_equal account.id, Access.find_by!(board_id: board.id, user_id: user.id).account_id
+    assert_equal account.id, Entropy.find_by!(container_type: "Account", container_id: account.id).account_id
+    assert_equal account.id, Entropy.find_by!(container_type: "Board", container_id: board.id).account_id
+    assert_equal account.id, Mention.find_by!(source_type: "Card", source_id: card.id).account_id
+    assert_equal account.id, Mention.find_by!(source_type: "Comment", source_id: comment.id).account_id
+    assert_equal account.id, Reaction.where(reactable_type: "Card", reactable_id: card.id).first!.account_id
+    assert_equal account.id, Reaction.where(reactable_type: "Comment", reactable_id: comment.id).first!.account_id
+    assert_equal account.id, ActionText::RichText.find_by!(record_type: "Comment", record_id: comment.id).account_id
+    assert_equal account.id, User::Settings.find_by!(user_id: user.id).account_id
+    assert_equal account.id, Webhook::DelinquencyTracker.find_by!(webhook_id: webhook.id).account_id
+    assert_equal account.id, Webhook::Delivery.where(webhook_id: webhook.id).first!.account_id
+  end
 end
