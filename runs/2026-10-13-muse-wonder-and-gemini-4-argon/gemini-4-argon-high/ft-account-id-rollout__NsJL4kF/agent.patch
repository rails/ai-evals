+          WHERE #{parent_table}.id = #{table}.#{foreign_key}
+        )
+        WHERE #{table}.account_id IS NULL
+          OR NOT EXISTS (
+            SELECT 1
+            FROM #{parent_table}
+            WHERE #{parent_table}.id = #{table}.#{foreign_key}
+              AND #{parent_table}.account_id IS NOT NULL
