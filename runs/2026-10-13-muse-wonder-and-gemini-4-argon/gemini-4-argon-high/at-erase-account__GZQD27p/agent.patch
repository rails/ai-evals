diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..374a23d 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,44 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases all their data and anonymizes shared books" do
+    kevin = users(:kevin)
+    kevin.sessions.start!(user_agent: "Browser", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+
+    books(:handbook).update!(creator: kevin, author: kevin.name, everyone_access: true)
+
+    books(:manual).update!(creator: kevin, author: kevin.name, everyone_access: false)
+    leaf = books(:manual).press(Page.new(body: "uniquepageword"), title: "Secret Page")
+    old_page_id = leaf.leafable_id
+    leaf.edit(leafable_params: { body: "uniquepageword2" }, leaf_params: { title: "Secret Page v2" })
+    new_page_id = leaf.leafable_id
+    edit_id = leaf.edits.last.id
+
+    Leaf.reindex_all
+    assert_not_empty Leaf.search("uniquepageword2")
+
+    kevin.destroy!
+
+    assert_nil User.find_by(id: kevin.id)
+    assert_empty Session.where(user_id: kevin.id)
+    assert_empty Access.where(user_id: kevin.id)
+    assert_empty ReadingMark.where(user_id: kevin.id)
+    assert_empty SignInEvent.for_address(kevin.email_address)
+
+    assert_nil Book.find_by(id: books(:manual).id)
+    assert_nil Leaf.find_by(id: leaf.id)
+    assert_nil Edit.find_by(id: edit_id)
+    assert_nil Page.find_by(id: old_page_id)
+    assert_nil Page.find_by(id: new_page_id)
+    assert_empty ActionText::Markdown.where(record_type: "Page", record_id: [ old_page_id, new_page_id ])
+    assert_empty Leaf.search("uniquepageword2")
+    assert_equal 0, ActiveRecord::Base.connection.select_value("SELECT count(*) FROM leaf_search_index WHERE rowid = #{leaf.id}")
+
+    books(:handbook).reload
+    assert_nil books(:handbook).creator
+    assert_equal "Deleted author", books(:handbook).author
+    assert_not_empty Leaf.search("great handbook")
+  end
 end
