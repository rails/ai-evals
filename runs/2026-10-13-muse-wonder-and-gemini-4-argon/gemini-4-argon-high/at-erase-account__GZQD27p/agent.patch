   test "destroy" do
+    kevin = users(:kevin)
+    kevin.sessions.start!(user_agent: "TestAgent", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+
+    books(:handbook).update!(creator: kevin, author: kevin.name, everyone_access: true)
+    books(:manual).update!(creator: kevin, author: kevin.name, everyone_access: false)
+    private_leaf = books(:manual).press(Page.new(body: "xylophone"), title: "Private Notes")
+    private_leaf.edit(leafable_params: { body: "xylophone updated" }, leaf_params: { title: "Private Notes v2" })
+    Leaf.reindex_all
+
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
