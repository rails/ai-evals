diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..01285f4 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,58 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :track_publication_change, if: :saved_change_to_published?
+    after_destroy :mark_publication_destroyed
+  end
+
+  def self.publication_states
+    ActiveSupport::IsolatedExecutionState[:book_publication_states] ||= {}
   end
 
   private
+    def track_publication_change
+      states = Book::Announceable.publication_states
+
+      if state = states[id]
+        previous_is_published = state[:is_published]
+        state[:is_published] = published?
+
+        Book.current_transaction.after_rollback do
+          if states.key?(id)
+            state[:is_published] = previous_is_published
+            restore_published_to(previous_is_published)
+          else
+            restore_published_to(state[:was_published])
+          end
+        end
+      else
+        state = states[id] = { was_published: published_before_last_save, is_published: published? }
+
+        Book.current_transaction.after_commit do
+          if states.delete(id) && !state[:was_published] && state[:is_published] && !state[:destroyed]
+            announce_publication
+          end
+        end
+
+        Book.current_transaction.after_rollback do
+          states.delete(id)
+          restore_published_to(state[:was_published])
+        end
+      end
+    end
+
+    def mark_publication_destroyed
+      if state = Book::Announceable.publication_states[id]
+        state[:destroyed] = true
+        Book.current_transaction.after_rollback { state[:destroyed] = false }
+      end
+    end
+
+    def restore_published_to(value)
+      self.published = value
+      clear_attribute_change(:published)
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
