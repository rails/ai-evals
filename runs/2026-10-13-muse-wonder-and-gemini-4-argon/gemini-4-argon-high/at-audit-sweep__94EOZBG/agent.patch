diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..cdb54da
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search returns matching leaves from readable books" do
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "search does not return leaves from unreadable books" do
+    books(:manual).press Page.new(body: "Secret"), title: "Secret Manual Page"
+
+    get library_search_path(q: "Secret")
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  test "search resists SQL injection and does not leak unreadable books" do
+    books(:manual).press Page.new(body: "Secret"), title: "Secret Manual Page"
+
+    get library_search_path(q: "' OR 1=1 --")
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search handles apostrophes and punctuation without error" do
+    books(:handbook).press Page.new(body: "Body"), title: "What's New!"
+
+    get library_search_path(q: "'")
+
+    assert_response :success
+    assert_in_body "What&#39;s New!"
+    assert_not_in_body "Summary"
+  end
+
+  test "search treats percent sign literally rather than as a wildcard" do
+    books(:handbook).press Page.new(body: "Body"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "Body"), title: "Save 500 off"
+
+    get library_search_path(q: "Save 50% off")
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path(q: "%")
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 500 off"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search treats underscore literally rather than as a wildcard" do
+    books(:handbook).press Page.new(body: "Body"), title: "snake_case"
+    books(:handbook).press Page.new(body: "Body"), title: "snakexcase"
+
+    get library_search_path(q: "_")
+    assert_response :success
+    assert_in_body "snake_case"
+    assert_not_in_body "snakexcase"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path(q: "snake_case")
+    assert_response :success
+    assert_in_body "snake_case"
+    assert_not_in_body "snakexcase"
+  end
+end
