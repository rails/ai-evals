diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..d0f57bc
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,127 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      terms = extract_search_terms(query)
+      if terms.empty?
+        none
+      else
+        candidates = published.preload(:rich_text_description, comments: [ :creator, :rich_text_body ])
+        sql_tokens = terms.flat_map { |term| term.scan(/\p{Word}+/).presence || [ term ] }.uniq
+        sql_tokens.each do |token|
+          candidates = candidates.merge(matching_search_token(token))
+        end
+
+        matched_ids = candidates.select { |card| card.matches_search_terms?(terms) }.map(&:id)
+        if matched_ids.empty?
+          none
+        else
+          published.where(id: matched_ids).reverse_chronologically
+        end
+      end
+    end
+
+    scope :matching, ->(query) { search(query) }
+  end
+
+  class_methods do
+    def extract_search_terms(query)
+      query.to_s.strip.split.filter_map do |raw|
+        cleaned = raw.gsub(/\A[.,!?;:"()\[\]{}]+|[.,!?;:"()\[\]{}]+\z/, "")
+        cleaned.presence
+      end.uniq
+    end
+
+    def search_term_pattern(term)
+      escaped = Regexp.escape(term)
+      prefix = if term.match?(/\A\p{Alpha}/) && term.length <= 3
+        "(?<!\\p{Word})"
+      elsif term.match?(/\A\p{Word}/)
+        "\\p{Word}*"
+      else
+        ""
+      end
+      suffix = if term.match?(/\p{Alpha}\z/) && term.length <= 2
+        "(?!['’]?\\p{Word})"
+      elsif term.match?(/\p{Word}\z/)
+        "(?:['’]\\p{Word}+|\\p{Word})*"
+      else
+        ""
+      end
+      "#{prefix}#{escaped}#{suffix}"
+    end
+
+    def search_term_regex(term)
+      /#{search_term_pattern(term)}/i
+    end
+
+    def matching_search_token(token)
+      variants = token.ascii_only? ? [ token ] : [ token, token.downcase, token.upcase, token.capitalize ].uniq
+      patterns = variants.map { |variant| "%#{sanitize_sql_like(variant)}%" }
+
+      title_condition = patterns.map { "cards.title LIKE ?" }.join(" OR ")
+      body_condition = (patterns.map { "action_text_rich_texts.body LIKE ?" } + [ "action_text_rich_texts.body LIKE '%<action-text-attachment%'" ]).join(" OR ")
+
+      matching_descriptions = ActionText::RichText
+        .where(record_type: "Card", name: "description")
+        .where(body_condition, *patterns)
+        .select(:record_id)
+
+      matching_comments = Comment.by_user
+        .joins(:rich_text_body)
+        .where(body_condition, *patterns)
+        .select(:card_id)
+
+      unscoped
+        .where(title_condition, *patterns)
+        .or(unscoped.where(id: matching_descriptions))
+        .or(unscoped.where(id: matching_comments))
+    end
+  end
+
+  def matches_search_terms?(terms)
+    searchable_texts = [
+      title.to_s,
+      description&.to_plain_text.to_s,
+      *user_comments.map { |comment| comment.body&.to_plain_text.to_s }
+    ]
+
+    terms.all? do |term|
+      regex = self.class.search_term_regex(term)
+      searchable_texts.any? { |text| text.match?(regex) }
+    end
+  end
+
+  def matching_description?(query)
+    plain_text = description&.to_plain_text.to_s
+    if plain_text.blank?
+      false
+    else
+      terms = self.class.extract_search_terms(query)
+      terms.any? { |term| plain_text.match?(self.class.search_term_regex(term)) }
+    end
+  end
+
+  def matching_comments(query)
+    terms = self.class.extract_search_terms(query)
+    if terms.empty?
+      []
+    else
+      regexes = terms.map { |term| self.class.search_term_regex(term) }
+      user_comments.select do |comment|
+        plain_text = comment.body&.to_plain_text.to_s
+        regexes.any? { |regex| plain_text.match?(regex) }
+      end
+    end
+  end
+
+  private
+    def user_comments
+      if comments.loaded?
+        comments.reject { |comment| comment.creator&.system? }.sort_by { |comment| [ comment.created_at, comment.id ] }
+      else
+        comments.by_user.preload(:rich_text_body).chronologically
+      end
+    end
+end
