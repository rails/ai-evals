@@ -0,0 +1,23 @@
+module SearchesHelper
+  def highlight_search_terms(text, query)
+    return "" if text.blank?
+
+    terms = Card.extract_search_terms(query)
+    if terms.empty?
+      escape_search_html(text).html_safe
+    else
+      patterns = terms.map { |term| Card.search_term_pattern(term) }
+      regex = /(#{patterns.join("|")})/i
+
+      text.to_s.split(regex, -1).each_with_index.map do |part, index|
+        escaped = escape_search_html(part)
+        index.odd? ? "<mark>#{escaped}</mark>" : escaped
+      end.join.html_safe
+    end
+  end
+
+  private
+    def escape_search_html(text)
+      text.to_s.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
+    end
+end
