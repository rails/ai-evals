diff --git a/app/views/searches/_card.html.erb b/app/views/searches/_card.html.erb
new file mode 100644
index 0000000..920ab80
--- /dev/null
+++ b/app/views/searches/_card.html.erb
@@ -0,0 +1,30 @@
+<%= card_article_tag card, id: dom_id(card), class: "card search-result", data: { id: card.number } do %>
+  <header class="card__header">
+    <div class="card__board">
+      <span class="card__id"><%= card.number %></span>
+      <span class="card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </span>
+    </div>
+  </header>
+
+  <div class="card__body">
+    <div class="card__content">
+      <h3 class="card__title">
+        <%= link_to highlight_search_terms(card.title, @query), card_path(card), class: "txt-ink", data: { turbo_frame: "_top" } %>
+      </h3>
+
+      <% if card.matching_description?(@query) %>
+        <div class="card__description txt-small margin-block-start-half">
+          <%= highlight_search_terms(card.description.to_plain_text, @query) %>
+        </div>
+      <% end %>
+
+      <% card.matching_comments(@query).each do |comment| %>
+        <div class="card__comment txt-small margin-block-start-half">
+          <%= highlight_search_terms(comment.body.to_plain_text, @query) %>
+        </div>
+      <% end %>
+    </div>
+  </div>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
