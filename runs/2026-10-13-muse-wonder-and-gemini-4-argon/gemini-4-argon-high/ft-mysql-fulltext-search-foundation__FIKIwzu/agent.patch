diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..86bfcf9
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @user = users(:kevin)
+  end
+
+  test "finds cards by title, description, or comment body" do
+    cards(:buy_domain).update!(description: "Check the registrar pricing")
+
+    assert_includes @user.accessible_cards.search("logo"), cards(:logo)
+    assert_includes @user.accessible_cards.search("registrar"), cards(:buy_domain)
+    assert_includes @user.accessible_cards.search("overflowing"), cards(:layout)
+  end
+
+  test "returns results newest first" do
+    results = @user.accessible_cards.search("text").to_a
+    assert_equal [ cards(:text), cards(:layout) ], results
+  end
+
+  test "excludes drafted cards and comments on drafted cards" do
+    draft = boards(:writebook).cards.create!(
+      title: "Drafted zeppelin",
+      description: "Zeppelin description",
+      creator: @user,
+      status: :drafted
+    )
+
+    commented_draft = boards(:writebook).cards.create!(
+      title: "Temporary published",
+      creator: @user,
+      status: :published
+    )
+    commented_draft.comments.create!(body: "Zeppelin comment", creator: @user)
+    commented_draft.update_column(:status, "drafted")
+
+    assert_empty @user.accessible_cards.search("zeppelin")
+    assert_not_includes Card.search("zeppelin"), draft
+    assert_not_includes Card.search("zeppelin"), commented_draft
+  end
+
+  test "excludes cards from inaccessible boards" do
+    private_card = boards(:private).cards.create!(
+      title: "Private flamingo card",
+      creator: users(:kevin),
+      status: :published
+    )
+
+    assert_includes users(:kevin).accessible_cards.search("flamingo"), private_card
+    assert_empty users(:david).accessible_cards.search("flamingo")
+  end
+
+  test "does not match old title in system comments after title change" do
+    card = cards(:buy_domain)
+    card.update!(title: "Purchase website")
+
+    assert_empty @user.accessible_cards.search("Buy")
+    assert_includes @user.accessible_cards.search("Purchase"), card
+  end
+end
