diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..476d327
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without query" do
+    get search_path
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "show with blank query" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "finds cards by title with matched words wrapped in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "article##{dom_id(cards(:logo))}" do
+      assert_select "a[href=?]", card_path(cards(:logo))
+      assert_select "mark", text: "logo"
+    end
+    assert_includes response.body, "The <mark>logo</mark> isn't big enough"
+  end
+
+  test "finds cards by description with matched words wrapped in mark" do
+    card = cards(:buy_domain)
+    card.update!(description: "We should register the domain name with Cloudflare")
+
+    get search_path(q: "Cloudflare")
+    assert_response :success
+
+    assert_select "article##{dom_id(card)}" do
+      assert_select "a[href=?]", card_path(card)
+      assert_select ".card__description mark", text: "Cloudflare"
+    end
+    assert_includes response.body, "We should register the domain name with <mark>Cloudflare</mark>"
+  end
+
+  test "finds cards by comment body with matched words wrapped in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "article##{dom_id(cards(:layout))}" do
+      assert_select "a[href=?]", card_path(cards(:layout))
+      assert_select ".card__comment mark", text: "overflowing"
+    end
+    assert_includes response.body, "The text is <mark>overflowing</mark> the container."
+  end
+
+  test "orders results newest first" do
+    board = boards(:writebook)
+    older_card, middle_card, newer_card = nil
+
+    with_current_user(:kevin) do
+      older_card = board.cards.create!(title: "Older elephant card", status: :published, created_at: 3.days.ago)
+      middle_card = board.cards.create!(title: "Middle card", description: "Contains an elephant in description", status: :published, created_at: 2.days.ago)
+      newer_card = board.cards.create!(title: "Newer card", status: :published, created_at: 1.day.ago)
+      newer_card.comments.create!(body: "Saw an elephant in the room")
+    end
+
+    get search_path(q: "elephant")
+    assert_response :success
+
+    card_ids = css_select("article.card").map { |el| el["id"] }
+    assert_equal [ dom_id(newer_card), dom_id(middle_card), dom_id(older_card) ], card_ids
+  end
+
+  test "only returns results from boards the user currently has access to" do
+    private_card = nil
+    with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(
+        title: "Top secret roadmap",
+        description: "Confidential strategy",
+        status: :published
+      )
+      private_card.comments.create!(body: "Secret comment detail")
+    end
+
+    # Kevin has access to private board
+    get search_path(q: "secret")
+    assert_response :success
+    assert_select "article##{dom_id(private_card)}", count: 1
+
+    # David does not have access to private board
+    logout_and_sign_in_as :david
+
+    get search_path(q: "secret")
+    assert_response :success
+    assert_select "article##{dom_id(private_card)}", count: 0
+
+    get search_path(q: "Confidential")
+    assert_response :success
+    assert_select "article##{dom_id(private_card)}", count: 0
+
+    # When access to writebook is revoked from David, results from it no longer appear
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "article##{dom_id(cards(:logo))}", count: 1
+
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:david))
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "article##{dom_id(cards(:logo))}", count: 0
+  end
+
+  test "never returns cards from other accounts" do
+    get search_path(q: "paycheck")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    with_current_user(:kevin) do
+      boards(:writebook).cards.create!(
+        title: "Drafted unicorn idea",
+        description: "Unicorn description in draft",
+        status: :drafted
+      )
+
+      card_with_comment = boards(:writebook).cards.create!(
+        title: "Published card",
+        status: :published
+      )
+      card_with_comment.comments.create!(body: "Unicorn comment on draft")
+      card_with_comment.update_column(:status, "drafted")
+    end
+
+    get search_path(q: "unicorn")
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_no_match "unicorn", response.body.scan(/<article.*?<\/article>/m).join
+  end
+
+  test "highlights multiple matched words in query" do
+    get search_path(q: "logo big")
+    assert_response :success
+
+    assert_includes response.body, "The <mark>logo</mark> isn't <mark>big</mark> enough"
+  end
+
+  test "case-insensitive matching preserves original word case inside mark" do
+    get search_path(q: "layout")
+    assert_response :success
+
+    assert_includes response.body, "<mark>Layout</mark> is broken"
+  end
+end
