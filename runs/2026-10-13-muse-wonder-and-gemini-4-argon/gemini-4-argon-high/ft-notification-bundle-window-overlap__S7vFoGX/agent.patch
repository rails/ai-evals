@@ -0,0 +1,29 @@
+<h1 class="title">New notifications</h1>
+<p class="subtitle margin-block-end-double">You have <%= pluralize @notifications.count, "new notification" %></p>
+
+<% @notifications.group_by { |notification| notification.card.board }.sort_by { |board, _| board.name }.each_with_index do |(board, notifications), index| %>
+  <% if index > 0 %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.sort_by(&:created_at).reverse_each do |notification| %>
+    <table class="notification">
+      <tbody>
+        <tr>
+          <td class="avatar__container">
+            <%= mail_avatar_tag notification.creator %>
+          </td>
+          <td>
+            <%= render "notification/bundle_mailer/#{notification.source_type.underscore}/body", notification: notification %>
+          </td>
+        </tr>
+      </tbody>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "Change how often you receive these emails", notifications_settings_url %>
+</p>
