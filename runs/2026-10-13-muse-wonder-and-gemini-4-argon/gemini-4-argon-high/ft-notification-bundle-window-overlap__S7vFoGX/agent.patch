+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.every_few_hours!
+    @bundle = @user.notification_bundles.create!(starts_at: 2.weeks.ago, ends_at: Time.current)
+  end
+
+  test "notification with event notifications" do
+    email = Notification::BundleMailer.notification(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Fizzy notifications", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert_match CGI.escapeHTML(cards(:logo).title), email.html_part.body.to_s
+    assert_match cards(:logo).title, email.text_part.body.to_s
+    assert_match cards(:layout).title, email.html_part.body.to_s
+    assert_match boards(:writebook).name, email.html_part.body.to_s
+    assert_match @user.account.slug, email.html_part.body.to_s
+  end
+
+  test "notification with mention notification" do
+    david = users(:david)
+    david.settings.every_few_hours!
+    bundle = david.notification_bundles.create!(starts_at: 2.weeks.ago, ends_at: Time.current)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ david.identity.email_address ], email.to
+    assert_match "@mentioned you", email.html_part.body.to_s
+    assert_match "@mentioned you", email.text_part.body.to_s
+  end
+end
