diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..14fada5
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,94 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  enum :status, %i[ pending delivering delivered ], default: :pending
+
+  scope :containing, ->(notification) { where(starts_at: ..notification.created_at, ends_at: notification.created_at..) }
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+  scope :overlapping_with, ->(bundle) {
+    bundle.send(:set_window)
+    where(user: bundle.user).where.not(id: bundle.id).where(
+      "(status = ? AND starts_at <= ? AND ends_at >= ?) OR (starts_at < ? AND ends_at > ?)",
+      statuses[:pending], bundle.ends_at, bundle.starts_at, bundle.ends_at, bundle.starts_at
+    )
+  }
+
+  before_validation :set_window, on: :create
+  validate :validate_window_order
+  validate :validate_no_overlapping_bundles
+
+  class << self
+    def deliver_all
+      due.find_each(&:deliver)
+    end
+
+    def deliver_all_later
+      due.find_each(&:deliver_later)
+    end
+
+    def bundle(notification)
+      notification.user.bundle(notification)
+    end
+  end
+
+  def notifications
+    refresh_window_if_persisted
+    user.notifications.unread.where(created_at: window)
+  end
+
+  def window
+    starts_at..ends_at
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Notification::Bundle::DeliverJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    if self.class.exists?(id: id)
+      Current.with_account(account) do
+        delivering!
+        Notification::BundleMailer.notification(self).deliver_later if should_deliver?
+        delivered!
+      end
+    end
+  end
+
+  private
+    def set_window
+      self.starts_at ||= Time.current
+      self.ends_at ||= starts_at + window_duration
+    end
+
+    def window_duration
+      user&.settings&.bundle_aggregation_period || 4.hours
+    end
+
+    def validate_window_order
+      if starts_at && ends_at && ends_at < starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def validate_no_overlapping_bundles
+      if user && starts_at && ends_at && user.notification_bundles.overlapping_with(self).exists?
+        errors.add(:base, "Bundle window cannot overlap with another bundle")
+      end
+    end
+
+    def refresh_window_if_persisted
+      if persisted? && !changed?
+        if current_window = self.class.where(id: id).pick(:starts_at, :ends_at)
+          self.starts_at, self.ends_at = current_window
+          clear_attribute_changes(%i[ starts_at ends_at ])
+        end
+      end
+    end
+
+    def should_deliver?
+      notifications.any? && user.active? && account.active? && user.identity.present?
+    end
+end
