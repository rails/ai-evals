diff --git a/app/models/user/configurable.rb b/app/models/user/configurable.rb
index c9c5adf..fd167e9 100644
--- a/app/models/user/configurable.rb
+++ b/app/models/user/configurable.rb
@@ -7,10 +7,39 @@ module User::Configurable
 
     after_create :create_settings, unless: :system?
 
-    delegate :timezone, to: :settings, allow_nil: true
+    delegate :timezone, :bundling_emails?, :bundle_email_frequency, to: :settings, allow_nil: true
+  end
+
+  def bundle(notification)
+    if bundling_emails?
+      notification_bundles.pending.containing(notification).first ||
+        find_or_create_bundle_for(notification)
+    else
+      notification_bundles.containing(notification).first
+    end
   end
 
   def in_time_zone(&block)
     Time.use_zone(timezone, &block)
   end
+
+  private
+    def find_or_create_bundle_for(notification)
+      if existing = notification_bundles.where("starts_at <= ? AND ends_at > ?", notification.created_at, notification.created_at).first
+        return existing
+      end
+
+      if open_bundle = notification_bundles.pending.where(ends_at: notification.created_at..).order(:starts_at).first
+        if notification.created_at < open_bundle.starts_at
+          min_starts_at = notification_bundles.where.not(id: open_bundle.id).where(ends_at: ..open_bundle.starts_at).maximum(:ends_at)
+          new_starts_at = [ notification.created_at, min_starts_at ].compact.max
+          open_bundle.update!(starts_at: new_starts_at) if new_starts_at < open_bundle.starts_at
+        end
+        open_bundle
+      else
+        min_starts_at = notification_bundles.maximum(:ends_at)
+        starts_at = [ notification.created_at, min_starts_at ].compact.max
+        notification_bundles.create!(starts_at: starts_at)
+      end
+    end
 end
