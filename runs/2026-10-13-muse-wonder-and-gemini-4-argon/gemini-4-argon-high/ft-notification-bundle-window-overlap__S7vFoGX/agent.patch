diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..977264c
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,316 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+  end
+
+  test "does not create bundle when frequency is never" do
+    @user.settings.never!
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+      assert_nil notification.bundle
+    end
+  end
+
+  test "creates a 4-hour window starting when first notification lands for every_few_hours" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    assert_difference -> { @user.notification_bundles.count }, +1 do
+      @notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    end
+
+    bundle = @user.notification_bundles.last
+    assert_equal @notification.created_at, bundle.starts_at
+    assert_equal @notification.created_at + 4.hours, bundle.ends_at
+    assert bundle.pending?
+    assert_equal bundle, @notification.bundle
+    assert_equal [ @notification ], bundle.notifications.to_a
+  end
+
+  test "creates a daily window for daily frequency" do
+    freeze_time
+    @user.settings.daily!
+
+    notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = notification.bundle
+
+    assert_equal notification.created_at, bundle.starts_at
+    assert_equal notification.created_at + 1.day, bundle.ends_at
+  end
+
+  test "creates a weekly window for weekly frequency" do
+    freeze_time
+    @user.settings.weekly!
+
+    notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = notification.bundle
+
+    assert_equal notification.created_at, bundle.starts_at
+    assert_equal notification.created_at + 1.week, bundle.ends_at
+  end
+
+  test "batches notifications within the same window" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    first = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = first.bundle
+    original_ends_at = bundle.ends_at
+
+    travel 1.hour
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      second = @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+      assert_equal bundle, second.bundle
+      assert_equal original_ends_at, bundle.reload.ends_at
+      assert_equal [ first, second ].to_set, bundle.notifications.to_set
+    end
+  end
+
+  test "late-arriving notifications belong in the window that has already opened" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    first = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = first.bundle
+    original_ends_at = bundle.ends_at
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      late = @user.notifications.create!(
+        source: events(:layout_published),
+        creator: users(:david),
+        created_at: 10.minutes.ago
+      )
+
+      assert_equal bundle, late.bundle
+      assert_includes bundle.notifications, first
+      assert_includes bundle.notifications, late
+      assert_equal late.created_at, bundle.reload.starts_at
+      assert_equal original_ends_at, bundle.ends_at
+    end
+  end
+
+  test "late-arriving notification after a previous delivered bundle does not overlap with it" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    first = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    first_bundle = first.bundle
+
+    travel 4.hours
+    Notification::Bundle.deliver_all
+    assert first_bundle.reload.delivered?
+
+    travel 10.minutes
+    second = @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    second_bundle = second.bundle
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      late = @user.notifications.create!(
+        source: events(:buy_domain_sent_back_to_triage),
+        creator: users(:david),
+        created_at: 5.minutes.ago
+      )
+
+      assert_equal second_bundle, late.bundle
+      assert_includes second_bundle.notifications, second
+      assert_includes second_bundle.notifications, late
+      assert_not_includes first_bundle.notifications, late
+    end
+  end
+
+  test "opens a new window after the previous window has ended" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    first = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    first_bundle = first.bundle
+
+    travel 4.hours + 1.second
+
+    assert_difference -> { @user.notification_bundles.count }, +1 do
+      second = @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+      second_bundle = second.bundle
+
+      assert_not_equal first_bundle, second_bundle
+      assert_equal [ first ], first_bundle.notifications.to_a
+      assert_equal [ second ], second_bundle.notifications.to_a
+    end
+  end
+
+  test "opens a new window at exact end time of a delivered bundle" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    first = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    first_bundle = first.bundle
+
+    travel 4.hours
+    first_bundle.deliver
+
+    assert_difference -> { @user.notification_bundles.count }, +1 do
+      second = @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+      assert_not_equal first_bundle, second.bundle
+    end
+  end
+
+  test "validates against overlapping windows for the same user" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    @user.notification_bundles.create!(starts_at: Time.current, ends_at: 4.hours.from_now)
+
+    # Identical window
+    duplicate = @user.notification_bundles.build(starts_at: Time.current, ends_at: 4.hours.from_now)
+    assert_not duplicate.valid?
+
+    # Starts inside existing window
+    overlapping_end = @user.notification_bundles.build(starts_at: 2.hours.from_now, ends_at: 6.hours.from_now)
+    assert_not overlapping_end.valid?
+
+    # Ends inside existing window
+    overlapping_start = @user.notification_bundles.build(starts_at: 2.hours.ago, ends_at: 2.hours.from_now)
+    assert_not overlapping_start.valid?
+
+    # Contained within existing window
+    contained = @user.notification_bundles.build(starts_at: 1.hour.from_now, ends_at: 3.hours.from_now)
+    assert_not contained.valid?
+
+    # Enclosing existing window
+    enclosing = @user.notification_bundles.build(starts_at: 1.hour.ago, ends_at: 5.hours.from_now)
+    assert_not enclosing.valid?
+
+    # Inverted window
+    inverted = @user.notification_bundles.build(starts_at: 6.hours.from_now, ends_at: 5.hours.from_now)
+    assert_not inverted.valid?
+
+    # Different user can have the same window
+    other_user_bundle = users(:david).notification_bundles.build(starts_at: Time.current, ends_at: 4.hours.from_now)
+    assert other_user_bundle.valid?
+  end
+
+  test "deliver sends one email for the window and marks bundle as delivered" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    bundle = @user.notification_bundles.last
+
+    travel 4.hours
+
+    assert_emails 1 do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver_later enqueues DeliverJob" do
+    @user.settings.every_few_hours!
+    notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = notification.bundle
+
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, args: [ bundle ]) do
+      bundle.deliver_later
+    end
+  end
+
+  test "deliver does not send email when all notifications in the window have been read" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = notification.bundle
+    notification.read
+
+    travel 4.hours
+
+    assert_no_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver does not send email when user is deactivated" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = notification.bundle
+    @user.deactivate
+
+    travel 4.hours
+
+    assert_no_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver does not send email when account is cancelled" do
+    freeze_time
+    @user.settings.every_few_hours!
+
+    notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = notification.bundle
+    @user.account.cancel(initiated_by: @user)
+
+    travel 4.hours
+
+    assert_no_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver_all only delivers due pending bundles" do
+    freeze_time
+    @user.settings.every_few_hours!
+    users(:david).settings.daily!
+    users(:david).notifications.destroy_all
+
+    @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    users(:david).notifications.create!(source: events(:layout_published), creator: users(:jz))
+
+    kevin_bundle = @user.notification_bundles.last
+    david_bundle = users(:david).notification_bundles.last
+
+    travel 5.hours
+
+    assert_includes Notification::Bundle.due, kevin_bundle
+    assert_not_includes Notification::Bundle.due, david_bundle
+
+    assert_emails 1 do
+      Notification::Bundle.deliver_all
+    end
+
+    assert kevin_bundle.reload.delivered?
+    assert david_bundle.reload.pending?
+
+    # Calling deliver_all again does not re-send already delivered bundle
+    assert_no_emails do
+      Notification::Bundle.deliver_all
+    end
+  end
+
+  test "switching frequency to never cancels pending bundles" do
+    @user.settings.every_few_hours!
+    @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+
+    assert_equal 1, @user.notification_bundles.pending.count
+
+    @user.settings.never!
+
+    assert_equal 0, @user.notification_bundles.pending.count
+  end
+end
