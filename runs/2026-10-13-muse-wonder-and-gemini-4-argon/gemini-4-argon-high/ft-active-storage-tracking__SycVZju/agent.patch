+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total", dependent: :destroy
+    has_many :storage_entries, class_name: "Storage::Entry", dependent: :delete_all
+  end
+
+  def bytes_used
+    Storage::Total.where(owner: self).pick(:bytes_stored) || 0
+  end
+
+  def materialize_storage_later
+    Current.with_account(account) do
+      Storage::MaterializeJob.perform_later(self)
+    end
+  end
+
+  private
+    def find_or_create_storage_total
+      Storage::Total.find_by(owner: self) || Storage::Total.create_or_find_by!(owner: self)
+    end
+end
