diff --git a/app/models/account/storage_trackable.rb b/app/models/account/storage_trackable.rb
new file mode 100644
index 0000000..c6c60ab
--- /dev/null
+++ b/app/models/account/storage_trackable.rb
@@ -0,0 +1,38 @@
+module Account::StorageTrackable
+  extend ActiveSupport::Concern
+
+  include Storage::Totaled
+
+  included do
+    around_destroy :suppress_storage_tracking, prepend: true
+  end
+
+  def materialize_storage_now
+    boards.where(id: storage_entries.select(:board_id)).find_each(&:rollup_storage_entries)
+    storage_entries.where.not(board_id: boards.select(:id)).delete_all
+    update_storage_total
+  end
+
+  def reconcile_storage_now
+    boards.find_each(&:reconcile_storage_now)
+    storage_entries.delete_all
+    update_storage_total
+  end
+
+  def update_storage_total
+    total_bytes = Storage::Total.where(owner_type: "Board", owner_id: boards.select(:id)).sum(:bytes_stored)
+
+    if total_bytes.positive? || Storage::Total.exists?(owner: self)
+      total = find_or_create_storage_total
+      total.with_lock do
+        total_bytes = Storage::Total.where(owner_type: "Board", owner_id: boards.select(:id)).sum(:bytes_stored)
+        total.update!(bytes_stored: [ total_bytes, 0 ].max)
+      end
+    end
+  end
+
+  private
+    def suppress_storage_tracking(&block)
+      Storage.suppressing_tracking(&block)
+    end
+end
