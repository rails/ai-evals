new file mode 100644
index 0000000..38a13e4
--- /dev/null
+++ b/app/models/card/storage_trackable.rb
@@ -0,0 +1,76 @@
+module Card::StorageTrackable
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_storage_before_board_change, if: :board_id_changed?
+    after_update :transfer_storage_to_new_board
+    around_destroy :track_storage_on_destroy, prepend: true
+  end
+
+  def calculate_storage_bytes
+    image_bytes + description_embed_bytes + comment_embed_bytes
+  end
+
+  private
+    def image_bytes
+      ActiveStorage::Attachment
+        .where(record: self, name: "image")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def description_embed_bytes
+      ActiveStorage::Attachment
+        .where(
+          record_type: "ActionText::RichText",
+          record_id: ActionText::RichText.where(record: self, name: "description").select(:id),
+          name: "embeds"
+        )
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comment_embed_bytes
+      ActiveStorage::Attachment
+        .where(
+          record_type: "ActionText::RichText",
+          record_id: ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id), name: "body").select(:id),
+          name: "embeds"
+        )
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def remember_storage_before_board_change
+      @old_board_for_storage = Board.find_by(id: board_id_was)
+      @bytes_before_board_change = calculate_storage_bytes
+    end
+
+    def transfer_storage_to_new_board
+      if @old_board_for_storage
+        old_board, bytes = @old_board_for_storage, @bytes_before_board_change
+        @old_board_for_storage = nil
+        @bytes_before_board_change = nil
+
+        new_board = Board.find_by(id: board_id) || board
+        if bytes.positive? && new_board && old_board != new_board
+          old_board.record_storage_entry(delta: -bytes, operation: "transfer_out", record_type: "Card", record_id: id)
+          new_board.record_storage_entry(delta: bytes, operation: "transfer_in", record_type: "Card", record_id: id)
+        end
+      end
+    end
+
+    def track_storage_on_destroy(&block)
+      if Storage.tracking_suppressed?
+        yield
+      else
+        current_board = Board.find_by(id: Card.where(id: id).select(:board_id)) || board
+        bytes = calculate_storage_bytes
+        Storage.suppressing_tracking(&block)
+
+        if bytes.positive?
+          current_board&.record_storage_entry(delta: -bytes, operation: "destroy", record_type: "Card", record_id: id)
+        end
+      end
+    end
+end
