+++ b/lib/rails_ext/active_storage_storage_tracking.rb
@@ -0,0 +1,107 @@
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create :track_storage_on_create
+    before_update :remember_storage_before_blob_change, if: :blob_id_changed?
+    after_update :track_storage_on_blob_change
+    after_destroy :track_storage_on_destroy
+  end
+
+  def delete
+    return super unless persisted?
+
+    transaction do
+      track_storage_on_destroy
+      super
+    end
+  end
+
+  private
+    def track_storage_on_create
+      return if Storage.tracking_suppressed?
+
+      if board = tracked_storage_board
+        board.record_storage_entry(delta: blob_byte_size, operation: "attach", record_type: record_type, record_id: record_id, blob_id: blob_id)
+      end
+    end
+
+    def remember_storage_before_blob_change
+      @old_blob_byte_size_for_storage = ActiveStorage::Blob.where(id: blob_id_was).pick(:byte_size).to_i
+      @old_blob_id_for_storage = blob_id_was
+    end
+
+    def track_storage_on_blob_change
+      if @old_blob_id_for_storage
+        old_size = @old_blob_byte_size_for_storage
+        @old_blob_byte_size_for_storage = nil
+        @old_blob_id_for_storage = nil
+
+        if !Storage.tracking_suppressed? && (board = tracked_storage_board)
+          board.record_storage_entry(delta: blob_byte_size - old_size, operation: "replace", record_type: record_type, record_id: record_id, blob_id: blob_id)
+        end
+      end
+    end
+
+    def track_storage_on_destroy
+      return if Storage.tracking_suppressed?
+
+      if board = tracked_storage_board
+        board.record_storage_entry(delta: -blob_byte_size, operation: "detach", record_type: record_type, record_id: record_id, blob_id: blob_id)
+      end
+    end
+
+    def blob_byte_size
+      if association(:blob).loaded?
+        blob&.byte_size.to_i
+      else
+        ActiveStorage::Blob.where(id: blob_id).pick(:byte_size).to_i
+      end
+    end
+
+    def tracked_storage_board
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        Board.find_by(id: Card.where(id: record_id).select(:board_id))
+      when [ "ActionText::RichText", "embeds" ]
+        tracked_rich_text_storage_board
+      end
+    end
+
+    def tracked_rich_text_storage_board
+      case [ record&.record_type, record&.name ]
+      when [ "Board", "public_description" ]
+        Board.find_by(id: record.record_id)
+      when [ "Card", "description" ]
+        Board.find_by(id: Card.where(id: record.record_id).select(:board_id))
+      when [ "Comment", "body" ]
+        Board.find_by(id: Card.where(id: Comment.where(id: record.record_id).select(:card_id)).select(:board_id))
+      end
+    end
+end
+
+module ActiveStorageDetachManyStorageTracking
+  def detach
+    if attachments.any?
+      attachments.each(&:delete)
+      record.attachment_changes.delete(name)
+    end
+  end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  prepend ActiveStorageAttachmentStorageTracking
+  ActiveStorage::Attached::Changes::DetachMany.prepend ActiveStorageDetachManyStorageTracking
+end
+
+module ActiveStorageBlobAccountDefault
+  def build_after_unfurling(record: nil, **options)
+    super(record: record, **options).tap do |blob|
+      blob.account ||= record.try(:account) || record.try(:blob)&.try(:account)
+    end
+  end
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  singleton_class.prepend ActiveStorageBlobAccountDefault
+end
