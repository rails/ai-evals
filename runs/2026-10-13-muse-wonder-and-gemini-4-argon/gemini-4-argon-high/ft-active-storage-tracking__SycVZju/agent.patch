new file mode 100644
index 0000000..81319e8
--- /dev/null
+++ b/app/models/board/storage_trackable.rb
@@ -0,0 +1,124 @@
+module Board::StorageTrackable
+  extend ActiveSupport::Concern
+
+  include Storage::Totaled
+
+  included do
+    around_destroy :suppress_storage_tracking_on_destroy, prepend: true
+    after_destroy_commit :materialize_account_storage_later, unless: :storage_tracking_suppressed_on_destroy?
+  end
+
+  def record_storage_entry(delta:, operation:, record_type: nil, record_id: nil, blob_id: nil)
+    if !Storage.tracking_suppressed? && !delta.zero?
+      storage_entries.create!(
+        account: account,
+        delta: delta,
+        operation: operation,
+        record_type: record_type,
+        record_id: record_id,
+        blob_id: blob_id
+      )
+    end
+  end
+
+  def materialize_storage_now
+    if rollup_storage_entries
+      account.update_storage_total
+    end
+  end
+
+  def rollup_storage_entries
+    return false unless storage_entries.exists?
+
+    processed = false
+    total = find_or_create_storage_total
+
+    total.with_lock do
+      delta = 0
+
+      storage_entries.in_batches do |batch|
+        batch_delta = batch.sum(:delta)
+        if batch.delete_all > 0
+          delta += batch_delta
+          processed = true
+        end
+      end
+
+      if processed
+        total.update!(bytes_stored: [ total.bytes_stored + delta, 0 ].max)
+      end
+    end
+
+    processed
+  end
+
+  def reconcile_storage_now
+    total = find_or_create_storage_total
+    total.with_lock do
+      storage_entries.delete_all
+      total.update!(bytes_stored: calculate_storage_bytes)
+    end
+  end
+
+  def calculate_storage_bytes
+    description_embed_bytes + card_image_bytes + card_description_embed_bytes + comment_embed_bytes
+  end
+
+  private
+    def description_embed_bytes
+      ActiveStorage::Attachment
+        .where(
+          record_type: "ActionText::RichText",
+          record_id: ActionText::RichText.where(record: self, name: "public_description").select(:id),
+          name: "embeds"
+        )
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_image_bytes
+      ActiveStorage::Attachment
+        .where(record_type: "Card", record_id: cards.select(:id), name: "image")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_embed_bytes
+      ActiveStorage::Attachment
+        .where(
+          record_type: "ActionText::RichText",
+          record_id: ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description").select(:id),
+          name: "embeds"
+        )
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comment_embed_bytes
+      ActiveStorage::Attachment
+        .where(
+          record_type: "ActionText::RichText",
+          record_id: ActionText::RichText.where(
+            record_type: "Comment",
+            record_id: Comment.where(card_id: cards.select(:id)).select(:id),
+            name: "body"
+          ).select(:id),
+          name: "embeds"
+        )
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def suppress_storage_tracking_on_destroy(&block)
+      @storage_tracking_suppressed_on_destroy = Storage.tracking_suppressed?
+      Storage.suppressing_tracking(&block)
+    end
+
+    def storage_tracking_suppressed_on_destroy?
+      @storage_tracking_suppressed_on_destroy
+    end
+
+    def materialize_account_storage_later
+      account.materialize_storage_later
+    end
+end
