diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..79d9fc1
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,205 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without query renders empty search page" do
+    get search_path
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "show with blank query renders empty search page" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "finds cards by title with matched words wrapped in mark" do
+    get "/search?q=logo"
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:logo))}" do
+      assert_select "mark", text: "logo"
+    end
+    assert_includes response.body, "The <mark>logo</mark> isn't big enough"
+    assert_select "##{dom_id(cards(:layout))}", count: 0
+  end
+
+  test "finds cards by description with matched words wrapped in mark" do
+    cards(:buy_domain).update!(description: "Register the domain on Cloudflare today")
+
+    get "/search?q=Cloudflare"
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:buy_domain))}" do
+      assert_select "mark", text: "Cloudflare"
+    end
+    assert_includes response.body, "Register the domain on <mark>Cloudflare</mark> today"
+  end
+
+  test "finds cards by comment body with matched words wrapped in mark" do
+    get "/search?q=overflowing"
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))}" do
+      assert_select "mark", text: "overflowing"
+    end
+    assert_includes response.body, "The text is <mark>overflowing</mark> the container."
+  end
+
+  test "orders results newest first" do
+    older_card = boards(:writebook).cards.create!(
+      title: "Older needle card",
+      creator: users(:kevin),
+      status: :published,
+      created_at: 3.days.ago
+    )
+    middle_card = boards(:writebook).cards.create!(
+      title: "Middle card",
+      description: "Contains the needle in description",
+      creator: users(:kevin),
+      status: :published,
+      created_at: 2.days.ago
+    )
+    newest_card = boards(:writebook).cards.create!(
+      title: "Newest card",
+      creator: users(:kevin),
+      status: :published,
+      created_at: 1.day.ago
+    )
+    newest_card.comments.create!(body: "Comment with needle", creator: users(:kevin))
+
+    get "/search?q=needle"
+    assert_response :success
+
+    card_ids = css_select(".card").map { it["id"] }
+    assert_equal [ dom_id(newest_card), dom_id(middle_card), dom_id(older_card) ], card_ids
+  end
+
+  test "people only see results from boards they currently have access to" do
+    private_card = boards(:private).cards.create!(
+      title: "Topsecret project roadmap",
+      description: "Topsecret details",
+      creator: users(:kevin),
+      status: :published
+    )
+    private_card.comments.create!(body: "Topsecret comment", creator: users(:kevin))
+
+    # Kevin has access to private board
+    get "/search?q=Topsecret"
+    assert_response :success
+    assert_select "##{dom_id(private_card)}", count: 1
+
+    # David does not have access to private board
+    logout_and_sign_in_as :david
+    get "/search?q=Topsecret"
+    assert_response :success
+    assert_select "##{dom_id(private_card)}", count: 0
+    assert_no_match(/Topsecret project roadmap/, response.body)
+
+    # Grant David access; now it shows up
+    boards(:private).accesses.grant_to(users(:david))
+    get "/search?q=Topsecret"
+    assert_response :success
+    assert_select "##{dom_id(private_card)}", count: 1
+
+    # Revoke David's access; now it disappears again
+    boards(:private).accesses.revoke_from(users(:david))
+    get "/search?q=Topsecret"
+    assert_response :success
+    assert_select "##{dom_id(private_card)}", count: 0
+  end
+
+  test "card moved to inaccessible board no longer turns up" do
+    logout_and_sign_in_as :david
+
+    get "/search?q=logo"
+    assert_response :success
+    assert_select "##{dom_id(cards(:logo))}", count: 1
+
+    with_current_user(:kevin) do
+      cards(:logo).move_to(boards(:private))
+    end
+
+    get "/search?q=logo"
+    assert_response :success
+    assert_select "##{dom_id(cards(:logo))}", count: 0
+  end
+
+  test "does not return cards from other accounts" do
+    get "/search?q=paycheck"
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft_card = boards(:writebook).cards.create!(
+      title: "Unpublished unicorn draft",
+      description: "Unicorn draft description",
+      creator: users(:kevin),
+      status: :drafted
+    )
+    draft_comment = draft_card.comments.build(account: draft_card.account, creator: users(:kevin), body: "Unicorn comment on draft")
+    draft_comment.save!(validate: false)
+
+    get "/search?q=unicorn"
+    assert_response :success
+    assert_select ".card", count: 0
+    assert_no_match(/Unpublished unicorn draft/, response.body)
+    assert_no_match(/Unicorn comment on draft/, response.body)
+  end
+
+  test "case-insensitive matching preserves original word casing inside mark" do
+    get "/search?q=layout"
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))} mark", text: "Layout"
+  end
+
+  test "wraps full matched word in mark when searching partial word" do
+    get "/search?q=overflow"
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))} mark", text: "overflowing"
+  end
+
+  test "does not match system comments from title changes" do
+    card = boards(:writebook).cards.create!(
+      title: "Xylophone feature",
+      creator: users(:kevin),
+      status: :published
+    )
+    with_current_user(:kevin) do
+      card.update!(title: "Piano feature")
+    end
+
+    get "/search?q=Xylophone"
+    assert_response :success
+    assert_select "##{dom_id(card)}", count: 0
+
+    get "/search?q=Piano"
+    assert_response :success
+    assert_select "##{dom_id(card)}", count: 1
+  end
+
+  test "does not match HTML tag names in rich text body" do
+    cards(:buy_domain).update!(description: "<p>Simple <strong>plain</strong> description</p>")
+
+    get "/search?q=strong"
+    assert_response :success
+    assert_select "##{dom_id(cards(:buy_domain))}", count: 0
+  end
+
+  test "returns each card once even when multiple comments and fields match" do
+    cards(:logo).update!(description: "The logo needs work")
+    cards(:logo).comments.create!(body: "First comment about the logo", creator: users(:kevin))
+    cards(:logo).comments.create!(body: "Second comment about the logo", creator: users(:david))
+
+    get "/search?q=logo"
+    assert_response :success
+    assert_select "##{dom_id(cards(:logo))}", count: 1
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
