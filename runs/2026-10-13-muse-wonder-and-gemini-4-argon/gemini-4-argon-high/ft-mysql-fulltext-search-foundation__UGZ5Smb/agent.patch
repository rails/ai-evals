+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights matched words with mark" do
+    assert_equal "The <mark>logo</mark> isn't big enough", highlight_search_terms("The logo isn't big enough", [ "logo" ])
+    assert_equal "<mark>Layout</mark> is <mark>broken</mark>", highlight_search_terms("Layout is broken", [ "layout", "broken" ])
+    assert_equal "The text is <mark>overflowing</mark> the container.", highlight_search_terms("The text is overflowing the container.", [ "overflow" ])
+  end
+
+  test "escapes HTML in text while highlighting" do
+    assert_equal "&lt;script&gt;alert(1)&lt;/script&gt; <mark>logo</mark>", highlight_search_terms("<script>alert(1)</script> logo", [ "logo" ])
