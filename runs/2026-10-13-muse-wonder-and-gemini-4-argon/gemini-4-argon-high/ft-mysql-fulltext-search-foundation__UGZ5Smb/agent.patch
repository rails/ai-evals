+<%= card_article_tag card, id: dom_id(card), class: "card", data: { id: card.number, navigable_list_target: "item" } do %>
+  <div class="flex flex-column flex-item-grow max-inline-size">
+    <header class="card__header">
+      <%= render "cards/display/preview/board", card: card %>
+    </header>
+
+    <div class="card__body justify-space-between">
+      <div class="card__content">
+        <h3 class="card__title overflow-line-clamp">
+          <%= link_to highlight_search_terms(card.title, terms), card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } %>
+        </h3>
+
+        <% if card.description.present? %>
+          <div class="card__description">
+            <%= highlight_search_terms(card.description.to_plain_text, terms) %>
+          </div>
+        <% end %>
+
+        <% card.matching_comments_for(terms).each do |comment| %>
+          <div id="<%= dom_id(comment) %>" class="card__comment">
+            <%= highlight_search_terms(comment.body.to_plain_text, terms) %>
+          </div>
+        <% end %>
+      </div>
+    </div>
+  </div>
+<% end %>
