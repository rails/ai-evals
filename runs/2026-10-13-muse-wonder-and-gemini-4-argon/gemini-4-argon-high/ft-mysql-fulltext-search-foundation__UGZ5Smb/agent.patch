@@ -0,0 +1,34 @@
+class SearchesController < ApplicationController
+  prepend_before_action :set_account_from_session_if_missing
+
+  def show
+    @query = params[:q].to_s.strip
+    @terms = Card::Searchable.extract_terms(@query)
+    @cards = search_cards
+  end
+
+  private
+    def set_account_from_session_if_missing
+      if Current.account.nil?
+        resume_session
+
+        if account = Current.identity&.accounts&.active&.first
+          Current.account = account
+          request.script_name = account.slug if request.script_name.blank?
+        end
+      end
+    end
+
+    def search_cards
+      if @terms.any?
+        Current.user.accessible_cards
+          .published
+          .search(@query)
+          .reverse_chronologically
+          .preload(:board, :column, :closure, :goldness, :not_now, :rich_text_description, comments: [ :creator, :rich_text_body ])
+          .select { it.matches_search_terms?(@terms) }
+      else
+        []
+      end
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..1099b24
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,43 @@
+module SearchesHelper
+  def highlight_search_terms(text, terms)
+    return "" if text.blank?
+
+    plain = text.to_s
+    terms = Array(terms).reject(&:blank?)
+
+    if terms.any?
+      pattern = search_highlight_pattern(terms)
+      highlight_plain_text(plain, pattern)
+    else
+      escape_search_text(plain).html_safe
+    end
+  end
+
+  private
+    def search_highlight_pattern(terms)
+      patterns = terms.sort_by { -it.length }.map do |term|
+        "[[:word:]]*#{Regexp.escape(term)}[[:word:]]*"
+      end
+
+      /(#{patterns.join("|")})/i
+    end
+
+    def highlight_plain_text(plain, pattern)
+      result = +""
+      last_end = 0
+
+      plain.scan(pattern) do
+        match = Regexp.last_match
+        result << escape_search_text(plain[last_end...match.begin(0)])
+        result << "<mark>#{escape_search_text(match[0])}</mark>"
+        last_end = match.end(0)
+      end
+
+      result << escape_search_text(plain[last_end..])
+      result.html_safe
+    end
+
+    def escape_search_text(text)
+      text.to_s.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
+    end
+end
