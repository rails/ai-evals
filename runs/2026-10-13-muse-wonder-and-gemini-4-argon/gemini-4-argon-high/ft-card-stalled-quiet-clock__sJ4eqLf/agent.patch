diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..cfae7bc
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "detect activity spikes when multiple people comment within a third of the board auto-close period" do
+    card = cards(:logo)
+    assert_nil card.activity_spike
+
+    assert_difference -> { Card::ActivitySpike.count }, +1 do
+      card.comments.create!(creator: users(:david), body: "I agree too")
+    end
+
+    assert_not_nil card.reload.activity_spike
+  end
+
+  test "system comments do not count towards activity spikes" do
+    card = cards(:logo)
+
+    assert_no_difference -> { Card::ActivitySpike.count } do
+      card.comments.create!(creator: users(:system), body: "System note")
+    end
+
+    assert_nil card.reload.activity_spike
+  end
+
+  test "comments from a single person do not trigger an activity spike" do
+    card = cards(:layout)
+
+    assert_no_difference -> { Card::ActivitySpike.count } do
+      card.comments.create!(creator: users(:david), body: "Second comment by David")
+      card.comments.create!(creator: users(:david), body: "Third comment by David")
+    end
+
+    assert_nil card.reload.activity_spike
+  end
+
+  test "fewer than three comments from two people do not trigger an activity spike" do
+    card = cards(:text)
+
+    assert_no_difference -> { Card::ActivitySpike.count } do
+      card.comments.create!(creator: users(:david), body: "First comment")
+      card.comments.create!(creator: users(:kevin), body: "Second comment")
+    end
+
+    assert_nil card.reload.activity_spike
+  end
+
+  test "comments outside a third of the board auto-close period do not trigger an activity spike" do
+    boards(:writebook).update!(auto_postpone_period: 3.days)
+    card = cards(:logo)
+
+    assert_no_difference -> { Card::ActivitySpike.count } do
+      card.comments.create!(creator: users(:david), body: "Too late for a spike")
+    end
+
+    assert_nil card.reload.activity_spike
+  end
+
+  test "assigning someone to a card triggers an activity spike" do
+    card = cards(:text)
+    assert_nil card.activity_spike
+
+    assert_difference -> { Card::ActivitySpike.count }, +1 do
+      card.toggle_assignment(users(:kevin))
+    end
+
+    assert_not_nil card.reload.activity_spike
+  end
+
+  test "reopening a card triggers an activity spike" do
+    card = cards(:shipping)
+    assert card.closed?
+    assert_nil card.activity_spike
+
+    assert_difference -> { Card::ActivitySpike.count }, +1 do
+      card.reopen
+    end
+
+    assert_not_nil card.reload.activity_spike
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    freeze_time
+
+    card = cards(:text)
+    card.toggle_assignment(users(:kevin))
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 2.weeks - 1.second
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 1.second
+    assert card.stalled?
+    assert_includes Card.stalled, card
+    assert_includes Card.indexed_by("stalled"), card
+  end
+
+  test "a card without a burst is not stalled after two weeks of inactivity" do
+    card = cards(:text)
+    card.update!(last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "closed, postponed, and drafted cards are not stalled" do
+    card = cards(:text)
+    card.toggle_assignment(users(:kevin))
+
+    travel 3.weeks
+    assert card.stalled?
+
+    card.close
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    card.reopen
+    card.reload
+    travel 3.weeks
+    assert card.stalled?
+
+    card.postpone
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "any activity on a stalled card resets it" do
+    card = cards(:text)
+    card.toggle_assignment(users(:kevin))
+
+    travel 3.weeks
+    assert card.stalled?
+    assert_includes Card.stalled, card
+
+    card.comments.create!(creator: users(:david), body: "Back to work")
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 3.weeks
+    assert card.stalled?
+
+    card.reactions.create!(content: "👍")
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 3.weeks
+    assert card.stalled?
+
+    card.update!(title: "Updated title")
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+end
