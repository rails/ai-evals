diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..996384d
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,74 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER_LAST_SPIKE_PERIOD = 2.weeks
+  ACTIVITY_SPIKE_COMMENTS_MIN_COUNT = 3
+  ACTIVITY_SPIKE_COMMENTS_MIN_USERS = 2
+
+  included do
+    has_one :activity_spike, dependent: :destroy
+
+    after_save :detect_activity_spikes, if: :saved_change_to_last_active_at?
+
+    scope :stalled, -> { active.joins(:activity_spike).where(last_active_at: ..STALLED_AFTER_LAST_SPIKE_PERIOD.ago) }
+  end
+
+  def stalled?
+    active? && activity_spike.present? && last_active_at <= STALLED_AFTER_LAST_SPIKE_PERIOD.ago
+  end
+
+  def cache_key
+    if stalled?
+      "#{super}-stalled-#{(Time.current - last_active_at).seconds.in_days.round}"
+    else
+      super
+    end
+  end
+
+  def event_was_created(event)
+    @last_event = event
+    super
+  ensure
+    @last_event = nil
+  end
+
+  private
+    def detect_activity_spikes
+      if should_create_activity_spike?
+        create_or_touch_activity_spike
+      elsif activity_spike.present? && last_active_at > STALLED_AFTER_LAST_SPIKE_PERIOD.ago
+        activity_spike.touch
+      end
+    end
+
+    def should_create_activity_spike?
+      assigned_or_reopened_just_now? || multiple_people_commented?
+    end
+
+    def assigned_or_reopened_just_now?
+      if @last_event
+        @last_event.action.in?(%w[ card_assigned card_reopened ])
+      else
+        events.where(action: %w[ card_assigned card_reopened ], created_at: 1.second.ago..).exists?
+      end
+    end
+
+    def multiple_people_commented?
+      recent_comments = comments.by_user.where(created_at: activity_spike_window)
+      recent_comments.count >= ACTIVITY_SPIKE_COMMENTS_MIN_COUNT &&
+        recent_comments.distinct.count(:creator_id) >= ACTIVITY_SPIKE_COMMENTS_MIN_USERS
+    end
+
+    def activity_spike_window
+      end_time = comments.by_user.maximum(:created_at) || Time.current
+      (end_time - (auto_postpone_period / 3).seconds)..end_time
+    end
+
+    def create_or_touch_activity_spike
+      if activity_spike.present?
+        activity_spike.touch
+      else
+        create_activity_spike!
+      end
+    end
+end
