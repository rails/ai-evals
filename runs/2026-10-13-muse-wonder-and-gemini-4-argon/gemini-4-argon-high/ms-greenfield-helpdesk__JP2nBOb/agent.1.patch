diff --git a/app/models/user.rb b/app/models/user.rb
new file mode 100644
index 0000000..264a272
--- /dev/null
+++ b/app/models/user.rb
@@ -0,0 +1,71 @@
+class User < ApplicationRecord
+  has_secure_password
+
+  belongs_to :account
+  has_many :sessions, dependent: :destroy
+  has_many :email_verification_tokens, dependent: :destroy
+  has_many :password_reset_tokens, dependent: :destroy
+
+  before_validation :normalize_attributes
+  after_create :assign_account_owner
+
+  validates :name, presence: true
+  validates :email,
+            presence: true,
+            uniqueness: { scope: :account_id, case_sensitive: false },
+            format: { with: /\A[^@\s]+@[^@\s]+\z/ }
+  validates :role, presence: true
+
+  def owner?
+    if account.owner_id.present?
+      account.owner_id == id
+    else
+      role.in?(["admin", "owner"])
+    end
+  end
+
+  def verify_email!
+    update!(verified: true, email_verified_at: Time.current)
+  end
+
+  def issue_email_verification_token!
+    transaction do
+      email_verification_tokens.delete_all
+      email_verification_tokens.create!(account: account)
+    end
+  end
+
+  def issue_password_reset_token!
+    transaction do
+      password_reset_tokens.delete_all
+      password_reset_tokens.create!(account: account)
+    end
+  end
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      name: name,
+      email: email,
+      role: role,
+      verified: verified,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def normalize_attributes
+    self.name = name.to_s.strip if !name.nil?
+    self.email = email.to_s.strip.downcase if !email.nil?
+    self.role = role.to_s.strip.presence || "admin"
+  end
+
+  def assign_account_owner
+    if account.owner_id.nil? && role.in?(["admin", "owner"])
+      account.update_column(:owner_id, id)
+    end
+  end
+end
