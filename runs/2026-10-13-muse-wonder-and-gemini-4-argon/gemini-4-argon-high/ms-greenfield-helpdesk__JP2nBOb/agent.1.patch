diff --git a/app/controllers/api/v1/accounts_controller.rb b/app/controllers/api/v1/accounts_controller.rb
new file mode 100644
index 0000000..979725e
--- /dev/null
+++ b/app/controllers/api/v1/accounts_controller.rb
@@ -0,0 +1,91 @@
+module Api
+  module V1
+    class AccountsController < ApplicationController
+      before_action :require_account!, only: [:show, :cancel, :reactivate]
+      before_action :authenticate_user!, only: [:show, :cancel, :reactivate]
+      before_action :require_active_account!, only: [:show, :cancel]
+      before_action :require_owner!, only: [:cancel, :reactivate]
+
+      def create
+        account_hash = params[:account].is_a?(ActionController::Parameters) ? params[:account] : ActionController::Parameters.new
+        admin_hash = if account_hash[:admin].is_a?(ActionController::Parameters)
+          account_hash[:admin]
+        elsif account_hash[:owner].is_a?(ActionController::Parameters)
+          account_hash[:owner]
+        elsif params[:admin].is_a?(ActionController::Parameters)
+          params[:admin]
+        else
+          ActionController::Parameters.new
+        end
+
+        account = Account.new(
+          name: account_hash[:name],
+          subdomain: account_hash[:subdomain]
+        )
+
+        user = User.new(
+          account: account,
+          name: admin_hash[:name],
+          email: admin_hash[:email],
+          password: admin_hash[:password],
+          role: "admin",
+          verified: false
+        )
+
+        account_valid = account.valid?
+        user_valid = user.valid?
+
+        unless account_valid && user_valid
+          errors = {}
+          account.errors.each { |e| (errors[:"account.#{e.attribute}"] ||= []) << e.message }
+          user.errors.each { |e| (errors[:"admin.#{e.attribute}"] ||= []) << e.message }
+          messages = (account.errors.full_messages + user.errors.full_messages).uniq
+          render json: { error: messages.to_sentence, errors: errors }, status: :unprocessable_entity
+          return
+        end
+
+        token_record = nil
+        ActiveRecord::Base.transaction do
+          account.save!
+          user.account = account
+          user.save!
+          account.update_column(:owner_id, user.id)
+          token_record = user.issue_email_verification_token!
+        end
+
+        HelpdeskMailer.email_verification(user, token_record.token).deliver_now
+
+        render json: {
+          account: account.as_api_json,
+          user: user.as_api_json
+        }, status: :created
+      rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotUnique => e
+        render json: { error: e.message }, status: :unprocessable_entity
+      end
+
+      def show
+        render json: { account: current_account.as_api_json }, status: :ok
+      end
+
+      def cancel
+        current_account.cancel!
+        render json: { account: current_account.reload.as_api_json }, status: :ok
+      end
+
+      def reactivate
+        unless current_account.cancelled?
+          render json: { error: "Account is not cancelled" }, status: :unprocessable_entity
+          return
+        end
+
+        unless current_account.reactivable?
+          render json: { error: "Reactivation period has expired" }, status: :forbidden
+          return
+        end
+
+        current_account.reactivate!
+        render json: { account: current_account.reload.as_api_json }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/email_verifications_controller.rb b/app/controllers/api/v1/email_verifications_controller.rb
new file mode 100644
index 0000000..d2d2d66
--- /dev/null
+++ b/app/controllers/api/v1/email_verifications_controller.rb
@@ -0,0 +1,67 @@
+module Api
+  module V1
+    class EmailVerificationsController < ApplicationController
+      before_action :require_account!, only: [:create]
+      before_action :require_active_account!, only: [:create]
+
+      def create
+        ev_params = params[:email_verification].is_a?(ActionController::Parameters) ? params[:email_verification] : params
+        email = ev_params[:email].to_s.strip.downcase
+
+        if email.blank?
+          render json: { error: "Email is required" }, status: :unprocessable_entity
+          return
+        end
+
+        user = current_account.users.find_by(email: email)
+        if user.present? && !user.verified?
+          token_record = user.issue_email_verification_token!
+          HelpdeskMailer.email_verification(user, token_record.token).deliver_now
+        end
+
+        render json: { email_verification: { email: email } }, status: :ok
+      end
+
+      def confirm
+        if request.headers["X-Helpdesk-Account"].present?
+          require_account!
+          return if performed?
+          require_active_account!
+          return if performed?
+        end
+
+        ev_params = params[:email_verification].is_a?(ActionController::Parameters) ? params[:email_verification] : params
+        token = ev_params[:token].to_s.strip
+
+        if token.blank?
+          render json: { error: "Token is required" }, status: :unprocessable_entity
+          return
+        end
+
+        scope = current_account ? current_account.email_verification_tokens : EmailVerificationToken
+        token_record = scope.includes(:user, :account).find_by(token: token)
+        if token_record.nil? || token_record.user.nil? || token_record.account.nil?
+          render json: { error: "Invalid or expired verification token" }, status: :unprocessable_entity
+          return
+        end
+
+        @current_account ||= token_record.account
+        if current_account.cancelled?
+          render json: { error: "Account is cancelled" }, status: :forbidden
+          return
+        end
+
+        user = token_record.user
+        ActiveRecord::Base.transaction do
+          user.verify_email!
+          user.email_verification_tokens.delete_all
+        end
+
+        render json: {
+          user: user.as_api_json,
+          account: current_account.as_api_json
+        }, status: :ok
+      end
+    end
+  end
+end
diff --git a/app/controllers/api/v1/password_resets_controller.rb b/app/controllers/api/v1/password_resets_controller.rb
