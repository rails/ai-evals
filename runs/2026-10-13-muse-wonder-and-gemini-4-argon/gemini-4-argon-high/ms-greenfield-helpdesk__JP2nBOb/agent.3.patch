+  test "private notes and ticket assignments do not change customer-facing request" do
+    owner_login = create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", admin_email: "jo@acme.test")
+    jo_id = owner_login.dig("user", "id")
