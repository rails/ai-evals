--- /dev/null
+++ b/test/integration/ticket_merges_test.rb
@@ -0,0 +1,893 @@
+require "test_helper"
+
+class TicketMergesTest < ActionDispatch::IntegrationTest
+  RELAY_PATH = "/rails/action_mailbox/relay/inbound_emails"
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @original_inbound_password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"]
+    @original_support_domain = ENV["HELPDESK_SUPPORT_DOMAIN"]
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = "test-relay-secret"
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+  end
+
+  teardown do
+    if @original_inbound_password.nil?
+      ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    else
+      ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = @original_inbound_password
+    end
+
+    if @original_support_domain.nil?
+      ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    else
+      ENV["HELPDESK_SUPPORT_DOMAIN"] = @original_support_domain
+    end
+  end
+
+  def relay_auth_header(password = ENV["RAILS_INBOUND_EMAIL_PASSWORD"], username: "actionmailbox")
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def post_inbound_email(raw_email, password: ENV["RAILS_INBOUND_EMAIL_PASSWORD"], username: "actionmailbox", content_type: "message/rfc822")
+    headers = { "Content-Type" => content_type }
+    headers["Authorization"] = relay_auth_header(password, username: username) unless password == :none
+    post RELAY_PATH, params: raw_email, headers: headers
+  end
+
+  def build_raw_email(from:, to: nil, cc: nil, subject: "Help needed", body: "Plain text body", message_id: nil, headers: {})
+    mail = Mail.new do
+      self.from = from if from
+      self.to = to if to
+      self.cc = cc if cc
+      self.subject = subject unless subject.nil?
+      self.message_id = message_id if message_id
+    end
+    headers.each { |k, v| mail[k] = v }
+    mail.body = body unless body.nil?
+    mail.to_s
+  end
+
+  def extract_token_from_last_email(path_prefix)
+    mail = ActionMailer::Base.deliveries.last
+    assert_not_nil mail, "Expected an email to be delivered"
+    body = mail.body.to_s
+    match = body.match(/#{Regexp.escape(path_prefix)}\?account=([^&\s]+)&token=([A-Za-z0-9]+)/)
+    assert_not_nil match, "Expected link matching #{path_prefix} in email body: #{body}"
+    [match[1], match[2], mail]
+  end
+
+  def create_verified_account(name: "Acme", subdomain: "acme", admin_name: "Jo", admin_email: "jo@acme.test", admin_password: "admin-password")
+    post "/api/v1/account/create", params: {
+      account: {
+        name: name,
+        subdomain: subdomain,
+        admin: { name: admin_name, email: admin_email, password: admin_password }
+      }
+    }, as: :json
+    assert_response :created
+    _, verify_token, _ = extract_token_from_last_email("http://localhost:3001/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: admin_email, password: admin_password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    response.parsed_body
+  end
+
+  def invite_and_login_staff(subdomain:, admin_headers:, name:, email:, role: "agent", password: "staff-password")
+    post "/api/v1/invitations",
+      params: { invitation: { email: email, role: role } },
+      headers: admin_headers,
+      as: :json
+    assert_response :created
+    _, inv_token, _ = extract_token_from_last_email("http://localhost:3001/accept-invitation")
+
+    post "/api/v1/invitation_acceptances",
+      params: { invitation_acceptance: { token: inv_token, name: name, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    response.parsed_body
+  end
+
+  def register_and_login_customer(subdomain:, name:, email:, password: "customer-password")
+    post "/api/v1/registrations",
+      params: { user: { name: name, email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    _, verify_token, _ = extract_token_from_last_email("http://localhost:3001/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: email, password: password } },
+      headers: { "X-Helpdesk-Account" => subdomain },
+      as: :json
+    assert_response :created
+    ActionMailer::Base.deliveries.clear
+    response.parsed_body
+  end
+
+  test "default merge closes source, sets merged_into_id, leaves private notes, keeps old comments and target state, and allows filtering closed" do
+    admin_login = create_verified_account
+    admin_headers = {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{admin_login.dig("session", "token")}"
+    }
+
+    sam_login = invite_and_login_staff(
+      subdomain: "acme",
+      admin_headers: admin_headers,
+      name: "Sam Agent",
+      email: "sam@acme.test",
+      role: "agent"
+    )
+    sam_id = sam_login.dig("user", "id")
+    sam_headers = {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{sam_login.dig("session", "token")}"
+    }
+
+    post "/api/v1/groups", params: { group: { name: "Billing" } }, headers: admin_headers, as: :json
+    assert_response :created
+    billing_group_id = response.parsed_body.dig("group", "id")
+
+    post "/api/v1/group_memberships",
+      params: { group_membership: { group_id: billing_group_id, user_id: sam_id } },
+      headers: admin_headers,
+      as: :json
+    assert_response :created
+
+    avery_login = register_and_login_customer(subdomain: "acme", name: "Avery", email: "avery@example.test")
+    avery_headers = {
+      "X-Helpdesk-Account" => "acme",
+      "Authorization" => "Bearer #{avery_login.dig("session", "token")}"
+    }
+
+    # Unmerged requests and tickets include merged_into_id: nil
+    post "/api/v1/requests",
+      params: { request: { subject: "Charged twice on invoice", comment: { body: "I see two charges on my card." } } },
+      headers: avery_headers,
+      as: :json
+    assert_response :created
+    source_req = response.parsed_body["request"]
+    source_id = source_req["id"]
+    assert source_req.key?("merged_into_id")
+    assert_nil source_req["merged_into_id"]
+
+    post "/api/v1/requests",
+      params: { request: { subject: "Duplicate charge #2", comment: { body: "Following up with the receipt ID." } } },
+      headers: avery_headers,
+      as: :json
+    assert_response :created
+    target_req = response.parsed_body["request"]
+    target_id = target_req["id"]
+    assert target_req.key?("merged_into_id")
+    assert_nil target_req["merged_into_id"]
+
+    get "/api/v1/tickets/#{target_id}", headers: sam_headers
+    assert_response :ok
+    assert response.parsed_body["ticket"].key?("merged_into_id")
+    assert_nil response.parsed_body.dig("ticket", "merged_into_id")
+
+    # Configure target ticket with status pending, priority high, and assigned to Sam in Billing
+    patch "/api/v1/tickets/#{target_id}",
+      params: {
+        ticket: {
+          status: "pending",
+          priority: "high",
+          group_id: billing_group_id,
+          assignee_id: sam_id,
+          comment: { body: "Looking into your receipt now.", public: true }
+        }
+      },
+      headers: sam_headers,
+      as: :json
+    assert_response :ok
+
+    # Merge source into target with default options
+    post "/api/v1/tickets/#{source_id}/merge",
+      params: { merge: { target_id: target_id } },
+      headers: sam_headers,
+      as: :json
+    assert_response :ok
+    merge_body = response.parsed_body
+
+    assert_not_nil merge_body["source"]
+    assert_not_nil merge_body["target"]
+
+    assert_equal source_id, merge_body.dig("source", "id")
+    assert_equal "closed", merge_body.dig("source", "status")
+    assert_equal target_id, merge_body.dig("source", "merged_into_id")
+
