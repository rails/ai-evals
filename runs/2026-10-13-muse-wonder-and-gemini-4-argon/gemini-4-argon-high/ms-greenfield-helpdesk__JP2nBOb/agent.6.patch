+++ b/app/controllers/api/v1/groups_controller.rb
@@ -0,0 +1,98 @@
+module Api
+  module V1
+    class GroupsController < ApplicationController
+      before_action :require_account!
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_staff!, only: [:index, :show]
+      before_action :require_admin!, only: [:create, :update, :destroy]
+      before_action :set_group, only: [:show, :update, :destroy]
+
+      def index
+        scope = current_account.groups.order(id: :asc)
+        render json: paginate(scope, key: :groups) { |records| records.map(&:as_api_json) }, status: :ok
+      end
+
+      def show
+        render json: { group: @group.as_api_json }, status: :ok
+      end
+
+      def create
+        group_params = params[:group].is_a?(ActionController::Parameters) ? params[:group] : params
+        group = current_account.groups.new(name: group_params[:name])
+
+        unless group.valid?
+          render json: {
+            error: group.errors.full_messages.to_sentence,
+            errors: group.errors.to_hash
+          }, status: :unprocessable_entity
+          return
+        end
+
+        group.save!
+        render json: { group: group.as_api_json }, status: :created
+      rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotUnique => e
+        render json: { error: e.message }, status: :unprocessable_entity
+      end
+
+      def update
+        group_params = params[:group].is_a?(ActionController::Parameters) ? params[:group] : params
+        unless group_params.key?(:name)
+          render json: { error: "Name is required" }, status: :unprocessable_entity
+          return
+        end
+
+        @group.name = group_params[:name]
+        unless @group.valid?
+          render json: {
+            error: @group.errors.full_messages.to_sentence,
+            errors: @group.errors.to_hash
+          }, status: :unprocessable_entity
+          return
+        end
+
+        @group.save!
+        render json: { group: @group.as_api_json }, status: :ok
+      rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotUnique => e
+        render json: { error: e.message }, status: :unprocessable_entity
+      end
+
+      def destroy
+        ActiveRecord::Base.transaction do
+          affected_user_ids = current_account.group_memberships
+            .where(group_id: @group.id)
+            .pluck(:user_id)
+            .uniq
+
+          current_account.tickets
+            .where(group_id: @group.id)
+            .update_all(group_id: nil, assignee_id: nil)
+
+          current_account.group_memberships
+            .where(group_id: @group.id)
+            .delete_all
+
+          @group.destroy!
+
+          affected_user_ids.each do |user_id|
+            remaining = current_account.group_memberships.where(user_id: user_id).order(id: :asc)
+            if remaining.exists? && !remaining.where(default: true).exists?
+              remaining.first.update!(default: true)
+            end
+          end
+        end
+
+        head :no_content
+      end
+
+      private
+
+      def set_group
+        @group = current_account.groups.find_by(id: params[:id])
+        if @group.nil?
+          render json: { error: "Group not found" }, status: :not_found
+        end
+      end
+    end
+  end
+end
