diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
new file mode 100644
index 0000000..edd8fbe
--- /dev/null
+++ b/app/models/group_membership.rb
@@ -0,0 +1,43 @@
+class GroupMembership < ApplicationRecord
+  belongs_to :account
+  belongs_to :group
+  belongs_to :user
+
+  before_validation :normalize_attributes
+
+  validates :user_id, uniqueness: { scope: :group_id }
+  validate :group_belongs_to_account
+  validate :user_is_staff_in_account
+
+  def as_api_json
+    {
+      id: id,
+      account_id: account_id,
+      group_id: group_id,
+      user_id: user_id,
+      default: self.default,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def normalize_attributes
+    self.account_id ||= group&.account_id || user&.account_id
+  end
+
+  def group_belongs_to_account
+    return if group.nil? || account_id.nil?
+    if group.account_id != account_id
+      errors.add(:group, "is invalid")
+    end
+  end
+
+  def user_is_staff_in_account
+    return if user.nil? || account_id.nil?
+    if user.account_id != account_id || !user.staff?
+      errors.add(:user, "must be a staff member")
+    end
+  end
+end
