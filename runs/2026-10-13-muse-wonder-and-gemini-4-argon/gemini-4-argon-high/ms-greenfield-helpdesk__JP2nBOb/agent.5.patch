+    assert_response :no_content
+    assert_equal 0, Ticket.count
+    assert_nil User.find_by(email: "avery@example.test")
+
+    # 2. Invalid delivery (blank subject) with same Message-ID <msg-retry-1@example.test>
+    invalid_blank_subject = build_raw_email(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
+      subject: "   ",
