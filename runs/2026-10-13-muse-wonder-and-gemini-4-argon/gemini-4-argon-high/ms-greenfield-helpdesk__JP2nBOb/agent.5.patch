+    )
+    post_inbound_email(invalid_blank_subject)
+    assert_response :no_content
+    assert_equal 0, Ticket.count
+
+    # 3. Valid retry with same Message-ID <msg-retry-1@example.test> succeeds!
+    valid_retry = build_raw_email(
+      from: "Avery <avery@example.test>",
+      to: "acme@support.example.test",
