+    assert_equal "Retryable ticket", Ticket.last.subject
+    assert_equal "Now this delivery is valid!", Ticket.last.comments.first.body
+
+    # 4. Duplicate delivery with exact same raw email is deduplicated
+    post_inbound_email(valid_retry)
+    assert_response :no_content
+    assert_equal 1, Ticket.count
+    assert_equal 1, Comment.count
+
+    # 5. Duplicate delivery with same Message-ID but different body/headers is also deduplicated
+    duplicate_different_checksum = build_raw_email(
