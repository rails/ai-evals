+      <%= form_with url: join_play_path(@game.code), method: :post, class: "join-form", data: { turbo: false } do %>
+        <label for="player_name" class="field-label">Your name</label>
+        <input
+          type="text"
+          id="player_name"
+          name="name"
+          class="input"
+          placeholder="Your name"
+          aria-label="Your name"
+          required
+          autofocus
+        >
+        <button type="submit" class="btn btn--pink">Join</button>
+      <% end %>
+    </div>
+  </div>
+<% elsif @game.waiting? %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= @quiz.title %></span>
+    </div>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">Waiting for the start…</p>
+      </div>
+    </div>
+  </div>
+<% elsif @game.question_open? %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span>Hi, <%= @player.name %>!</span>
+    </div>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+      <div class="play-options">
+        <% @options.each_with_index do |option, idx| %>
+          <% letter = ("A".ord + idx).chr %>
+          <% picked = (@picked_option_id == option.id) %>
+          <%= form_with url: answer_play_path(@game.code), method: :post, data: { turbo: false, answer_form: true } do %>
+            <input type="hidden" name="question_id" value="<%= @question.id %>">
+            <input type="hidden" name="option_id" value="<%= option.id %>">
+            <button type="submit" class="play-option <%= 'is-picked' if picked %>" data-option-id="<%= option.id %>" title="<%= option.text %>">
+              <span class="play-option__letter"><%= letter %></span>
+              <span class="play-option__title"><%= option.text %></span>
+              <% if picked %>
+                <span class="play-option__mark">Your answer</span>
+              <% end %>
+            </button>
+          <% end %>
+        <% end %>
+      </div>
+    </div>
+  </div>
+<% elsif @game.question_closed? %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span>Hi, <%= @player.name %>!</span>
+    </div>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+      <div class="play-options is-locked is-revealed">
+        <% @options.each_with_index do |option, idx| %>
+          <% letter = ("A".ord + idx).chr %>
+          <% picked = (@picked_option_id == option.id) %>
+          <% classes = [ "play-option" ] %>
+          <% classes << "is-picked" if picked %>
+          <% classes << "is-correct" if option.correct? %>
+          <div class="<%= classes.join(' ') %>">
+            <span class="play-option__letter"><%= letter %></span>
+            <span class="play-option__title"><%= option.text %></span>
+            <% if picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          </div>
+        <% end %>
+      </div>
+
+      <% if @picked_option.nil? %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% elsif @picked_option.correct? %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% else %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% end %>
+    </div>
+  </div>
+<% end %>
