diff --git a/app/views/moderate/games/_screen_content.html.erb b/app/views/moderate/games/_screen_content.html.erb
new file mode 100644
index 0000000..0a28f34
--- /dev/null
+++ b/app/views/moderate/games/_screen_content.html.erb
@@ -0,0 +1,139 @@
+<% if @game.waiting? %>
+  <section class="cover cover--blue">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+      </div>
+
+      <div class="screen__body">
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= @quiz.title %></h1>
+            <div class="lobby__join">Join at</div>
+            <div class="lobby__url"><%= @join_url %></div>
+            <div class="counter-pill" id="players-counter">
+              <span>Players: <strong id="players-count-value"><%= @active_players_count %></strong></span>
+            </div>
+          </div>
+          <div class="qr" role="img" aria-label="QR code for <%= @join_url %>" data-url="<%= @join_url %>">
+            <%= raw @qr_svg %>
+          </div>
+        </div>
+      </div>
+    </div>
+
+    <div class="screen-controls">
+      <div class="screen-controls__info">
+        <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+      </div>
+      <div class="buttons">
+        <%= form_with url: start_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false, game_action: true } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Start</button>
+        <% end %>
+      </div>
+    </div>
+  </section>
+<% elsif @game.question_open? %>
+  <section class="cover cover--blue cover--calm">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+
+      <div class="screen__body">
+        <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+        <div class="stage-question__body"><%= @question.body %></div>
+        <ol class="stage-options">
+          <% @options.each_with_index do |option, idx| %>
+            <% letter = ("A".ord + idx).chr %>
+            <li class="stage-option">
+              <span class="stage-option__letter"><%= letter %></span>
+              <span class="stage-option__title"><%= option.text %></span>
+            </li>
+          <% end %>
+        </ol>
+      </div>
+    </div>
+
+    <div class="screen-controls">
+      <div class="screen-controls__info">
+        <div class="answers-counter" id="answers-counter">Answers: <%= @answered_count %> / <%= @active_players_count %></div>
+      </div>
+      <div class="buttons">
+        <%= form_with url: finish_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false, game_action: true } do %>
+          <button type="submit" class="btn btn--pink btn--lg">Finish</button>
+        <% end %>
+      </div>
+    </div>
+  </section>
+<% elsif @game.question_closed? %>
+  <section class="cover cover--blue cover--calm">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+
+      <div class="screen__body">
+        <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+        <div class="stage-question__body"><%= @question.body %></div>
+        <ol class="stage-options stage-options--results">
+          <% total_answers = @option_counts.values.sum %>
+          <% @options.each_with_index do |option, idx| %>
+            <% letter = ("A".ord + idx).chr %>
+            <% count = @option_counts[option.id] || 0 %>
+            <% share = total_answers > 0 ? ((count.to_f / total_answers) * 100).round : 0 %>
+            <li class="stage-option <%= 'is-correct' if option.correct? %>">
+              <span class="stage-option__bar" style="--share: <%= share %>%"></span>
+              <span class="stage-option__letter"><%= letter %></span>
+              <span class="stage-option__title"><%= option.text %></span>
+              <% if option.correct? %>
+                <span class="stage-option__mark">Correct</span>
+              <% end %>
+              <span class="stage-option__count"><%= count %></span>
+            </li>
+          <% end %>
+        </ol>
+      </div>
+    </div>
+
+    <div class="screen-controls">
+      <div class="screen-controls__info">
+        <div class="answers-counter" id="answers-counter">Answers: <%= @answered_count %> / <%= @active_players_count %></div>
+      </div>
+      <div class="buttons">
+        <% if @game.last_question? %>
+          <%= form_with url: end_quiz_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false, game_action: true } do %>
+            <button type="submit" class="btn btn--pink btn--lg">End quiz</button>
+          <% end %>
+        <% else %>
+          <%= form_with url: next_question_moderate_quiz_game_path(@quiz, @game), method: :post, data: { turbo: false, game_action: true } do %>
+            <button type="submit" class="btn btn--pink btn--lg">Next</button>
+          <% end %>
+        <% end %>
+      </div>
+    </div>
+  </section>
+<% else %>
+  <section class="cover cover--night">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+
+      <div class="screen__body">
+        <div class="screen__kicker"><%= @quiz.title %></div>
+        <h1 class="lobby__title">The quiz is over</h1>
+      </div>
+    </div>
+
+    <div class="screen-controls">
+      <div class="screen-controls__info">
+        <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+      </div>
+      <div class="buttons"></div>
+    </div>
+  </section>
+<% end %>
