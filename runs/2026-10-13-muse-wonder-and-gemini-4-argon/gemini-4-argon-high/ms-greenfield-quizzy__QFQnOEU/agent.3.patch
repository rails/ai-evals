diff --git a/app/channels/game_play_channel.rb b/app/channels/game_play_channel.rb
new file mode 100644
index 0000000..edbe94f
--- /dev/null
+++ b/app/channels/game_play_channel.rb
@@ -0,0 +1,22 @@
+class GamePlayChannel < ApplicationCable::Channel
+  def subscribed
+    @game = Game.find_by(code: params[:code])
+    return reject unless @game
+
+    stream_from "game_play_#{@game.id}"
+
+    if params[:player_token].present?
+      @player = @game.players.find_by(token: params[:player_token])
+      if @player
+        stream_from "game_play_#{@game.id}_player_#{@player.id}"
+        GamePresence.connect(@player)
+      end
+    end
+  end
+
+  def unsubscribed
+    if @player
+      GamePresence.disconnect(@player)
+    end
+  end
+end
