+  end
+
+  test "question timer display formats M:SS and expires at 0:00" do
+    @quiz.update!(timer_minutes: 1, timer_seconds: 30)
+    game = @quiz.games.create!
+    game.start!
+
+    opened_at = game.question_opened_at
+    assert_equal "1:30", game.question_timer_display(opened_at)
+    assert_equal "1:30", game.question_timer_display(opened_at + 0.4.seconds)
+    assert_equal "1:29", game.question_timer_display(opened_at + 1.1.seconds)
+    assert_equal "0:05", game.question_timer_display(opened_at + 85.2.seconds)
+    assert_equal "0:00", game.question_timer_display(opened_at + 90.0.seconds)
+
+    assert_not game.question_timer_expired?(opened_at + 89.9.seconds)
+    assert game.question_timer_expired?(opened_at + 90.0.seconds)
+
+    assert_not game.finish_if_timer_expired!(opened_at + 10.seconds)
+    assert game.question_open?
+
+    assert game.finish_if_timer_expired!(opened_at + 90.seconds)
+    assert game.question_closed?
+  ensure
+    GameTimer.cancel(game.id) if game
+  end
 end
