diff --git a/app/models/game_timer.rb b/app/models/game_timer.rb
new file mode 100644
index 0000000..7442a86
--- /dev/null
+++ b/app/models/game_timer.rb
@@ -0,0 +1,70 @@
+module GameTimer
+  MUTEX = Mutex.new
+  TIMERS = {}
+
+  def self.schedule(game)
+    return cancel(game.id) unless game.question_open? && game.quiz.timer_enabled?
+
+    game_id = game.id
+    question_id = game.current_question_id
+    deadline = game.question_timer_deadline
+    deadline_ms = game.question_timer_deadline_ms
+    return cancel(game_id) unless deadline
+
+    thread = Thread.new do
+      loop do
+        remaining = deadline.to_f - Time.current.to_f
+        break if remaining <= 0
+
+        sleep([ remaining, 0.05 ].min)
+      end
+
+      Rails.application.executor.wrap do
+        MUTEX.synchronize do
+          entry = TIMERS[game_id]
+          TIMERS.delete(game_id) if entry && entry[:thread] == Thread.current
+        end
+
+        g = Game.find_by(id: game_id)
+        if g && g.question_open? && g.current_question_id == question_id
+          g.finish_if_timer_expired!
+        end
+      end
+    rescue => _e
+      # Ignore errors during shutdown
+    end
+
+    MUTEX.synchronize do
+      if (old = TIMERS.delete(game_id))
+        old[:thread].kill if old[:thread]&.alive?
+      end
+      TIMERS[game_id] = {
+        thread: thread,
+        question_id: question_id,
+        deadline_ms: deadline_ms
+      }
+    end
+  end
+
+  def self.ensure_scheduled(game)
+    return cancel(game.id) unless game.question_open? && game.quiz.timer_enabled?
+
+    needs_schedule = MUTEX.synchronize do
+      entry = TIMERS[game.id]
+      !entry ||
+        !entry[:thread]&.alive? ||
+        entry[:question_id] != game.current_question_id ||
+        entry[:deadline_ms] != game.question_timer_deadline_ms
+    end
+
+    schedule(game) if needs_schedule
+  end
+
+  def self.cancel(game_id)
+    MUTEX.synchronize do
+      if (old = TIMERS.delete(game_id))
+        old[:thread].kill if old[:thread]&.alive?
+      end
+    end
+  end
+end
