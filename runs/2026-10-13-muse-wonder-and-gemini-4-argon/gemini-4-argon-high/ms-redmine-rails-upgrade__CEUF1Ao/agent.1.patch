+# Configure cookie and message verifier key rotations between SHA1 (Rails 6.1)
+# and SHA256 (Rails 7.0) so upgrades and rollbacks preserve sessions and mail links.
+Rails.application.config.after_initialize do |app|
+  secret =
+    begin
+      app.secret_key_base
+    rescue ArgumentError
+      nil
+    end
+
+  if secret.present?
+    ad = app.config.action_dispatch
+    encrypted_cipher = ad.encrypted_cookie_cipher || "aes-256-gcm"
+    encrypted_key_len = ActiveSupport::MessageEncryptor.key_len(encrypted_cipher)
+
+    %w[SHA256 SHA1].each do |digest_name|
+      if ad.authenticated_encrypted_cookie_salt.present?
+        encrypted_secret = OpenSSL::PKCS5.pbkdf2_hmac(
+          secret,
+          ad.authenticated_encrypted_cookie_salt,
+          1000,
+          encrypted_key_len,
+          OpenSSL::Digest.new(digest_name)
+        )
+        ad.cookies_rotations.rotate(:encrypted, encrypted_secret, cipher: encrypted_cipher)
+      end
+
+      if ad.signed_cookie_salt.present?
+        signed_secret = OpenSSL::PKCS5.pbkdf2_hmac(
+          secret,
+          ad.signed_cookie_salt,
+          1000,
+          64,
+          OpenSSL::Digest.new(digest_name)
+        )
+        ad.cookies_rotations.rotate(
+          :signed,
+          signed_secret,
+          digest: ad.signed_cookie_digest || "SHA1"
+        )
+      end
+    end
+
+    if ad.encrypted_cookie_salt.present? && ad.encrypted_signed_cookie_salt.present?
+      legacy_cipher = "aes-256-cbc"
+      legacy_key_len = ActiveSupport::MessageEncryptor.key_len(legacy_cipher)
+      legacy_secret = OpenSSL::PKCS5.pbkdf2_hmac(
+        secret,
+        ad.encrypted_cookie_salt,
+        1000,
+        legacy_key_len,
+        OpenSSL::Digest.new("SHA1")
+      )
+      legacy_sign_secret = OpenSSL::PKCS5.pbkdf2_hmac(
+        secret,
+        ad.encrypted_signed_cookie_salt,
+        1000,
+        64,
+        OpenSSL::Digest.new("SHA1")
+      )
+      ad.cookies_rotations.rotate(
+        :encrypted,
+        legacy_secret,
+        legacy_sign_secret,
+        cipher: legacy_cipher,
+        digest: ad.cookies_digest || "SHA1"
+      )
+    end
+
+    app.message_verifier(:mail_links)
+  end
