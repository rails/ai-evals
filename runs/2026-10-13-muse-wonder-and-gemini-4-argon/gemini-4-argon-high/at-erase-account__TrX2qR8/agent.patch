   test "destroy is not allowed to non-admins" do
diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..69cba45 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,52 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "destroying a user erases all their data and anonymizes everyone books" do
+    kevin = users(:kevin)
+    kevin.sessions.start!(user_agent: "TestBrowser", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+
+    everyone_book = books(:handbook)
+    everyone_book.update!(creator: kevin, author: kevin.name, everyone_access: true)
+
+    private_book = books(:manual)
+    private_book.update!(creator: kevin, author: kevin.name, everyone_access: false)
+    leaf = private_book.press(Page.new(body: "initialsecretcontent"), title: "Secret Title")
+    old_page_id = leaf.leafable_id
+    old_markdown_id = leaf.page.markdown_body.id
+
+    leaf.edit(leafable_params: { body: "revisedsecretcontent" })
+    new_page_id = leaf.leafable_id
+    new_markdown_id = leaf.page.markdown_body.id
+    edit_id = leaf.edits.last.id
+
+    trashed_leaf = private_book.press(Section.new(body: "trashedsecretsection"), title: "Trashed Section")
+    trashed_section_id = trashed_leaf.leafable_id
+    trashed_leaf.trashed!
+
+    kevin.destroy!
+
+    assert_not User.exists?(kevin.id)
+    assert_empty Session.where(user_id: kevin.id)
+    assert_empty Access.where(user_id: kevin.id)
+    assert_empty ReadingMark.where(user_id: kevin.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+
+    assert Book.exists?(everyone_book.id)
+    assert_nil everyone_book.reload.creator
+    assert_equal "Deleted author", everyone_book.author
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_not Leaf.exists?(trashed_leaf.id)
+    assert_not Edit.exists?(edit_id)
+    assert_not Page.exists?(old_page_id)
+    assert_not Page.exists?(new_page_id)
+    assert_not Section.exists?(trashed_section_id)
+    assert_not ActionText::Markdown.exists?(old_markdown_id)
+    assert_not ActionText::Markdown.exists?(new_markdown_id)
+
+    assert_equal 0, Leaf.connection.select_value("select count(*) from leaf_search_index where rowid in (#{leaf.id}, #{trashed_leaf.id})")
+  end
 end
