   end
 
   test "destroy" do
+    kevin = users(:kevin)
+    sign_in :kevin
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+    books(:handbook).update!(creator: kevin, author: kevin.name, everyone_access: true)
+    books(:manual).update!(creator: kevin, author: kevin.name, everyone_access: false)
+    private_leaf = books(:manual).press(Page.new(body: "uniquelysearchableprivateword"), title: "Private Page")
+    private_leaf.edit(leafable_params: { body: "updatedsearchableprivateword" })
+    sign_out
+
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_path(kevin)
+    end
+
+    assert_redirected_to users_url
+    assert_not User.exists?(kevin.id)
+    assert_empty Session.where(user_id: kevin.id)
+    assert_empty Access.where(user_id: kevin.id)
+    assert_empty ReadingMark.where(user_id: kevin.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+
+    assert Book.exists?(books(:handbook).id)
+    assert_nil books(:handbook).reload.creator
+    assert_equal "Deleted author", books(:handbook).author
+
+    assert_not Book.exists?(books(:manual).id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_empty Leaf.search("updatedsearchableprivateword")
+    assert_equal 0, Leaf.connection.select_value("select count(*) from leaf_search_index where rowid = #{private_leaf.id}")
+  end
+
+  test "destroy works for already deactivated users and removes original sign-in events" do
+    kevin = users(:kevin)
+    original_email = kevin.email_address
+    sign_in :kevin
