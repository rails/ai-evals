@@ -0,0 +1,67 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Accounts", saas.admin_accounts_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account details</h2>
+      </header>
+
+      <div class="flex flex-column gap-half txt-align-start">
+        <div><strong>Name:</strong> <%= @account.name %></div>
+        <div><strong>ID:</strong> #<%= @account.external_account_id %> (<%= @account.id %>)</div>
+        <div><strong>Owner:</strong> <%= @account.owner_name %> (<%= @account.owner_email || "No admin" %>)</div>
+        <div><strong>Plan:</strong> <%= @account.plan.name %><%= " (Comped)" if @account.comped? %></div>
+        <div><strong>Cards:</strong> <%= number_with_delimiter(@account.card_count) %></div>
+        <div><strong>Storage:</strong> <%= number_to_human_size(@account.bytes_used) %> / <%= number_to_human_size(@account.storage_limit) %></div>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing waiver</h2>
+      </header>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Overridden limits</h2>
+      </header>
+
+      <%= form_with model: @account.overridden_limits || @account.build_overridden_limits,
+            url: saas.admin_account_overridden_limits_path(@account),
+            method: :put,
+            class: "flex flex-column gap-half txt-align-start" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, class: "input" %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, class: "input" %>
+        </div>
+
+        <div class="flex gap-half">
+          <%= form.button "Override", type: "submit", class: "btn btn--link" %>
+        </div>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+  </div>
+</section>
