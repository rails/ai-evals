diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..edb1d98
--- /dev/null
+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,44 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    if params[:session_id].present?
+      @session = Stripe::Checkout::Session.retrieve(params[:session_id])
+    end
+  rescue Stripe::StripeError
+    redirect_to account_settings_path
+  end
+
+  def create
+    if Current.account.active_subscription && params[:plan_key].blank? && params[:plan].blank? && params[:price_id].blank?
+      session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.subscription.stripe_customer_id,
+        return_url: account_settings_url
+      )
+      redirect_to session.url, allow_other_host: true, status: :see_other
+    elsif selected_plan&.paid?
+      subscription = Current.account.find_or_create_subscription(email: Current.identity.email_address)
+      session = Stripe::Checkout::Session.create(
+        customer: subscription.stripe_customer_id,
+        mode: "subscription",
+        line_items: [ { price: selected_plan.stripe_price_id, quantity: 1 } ],
+        success_url: account_subscription_url(session_id: "{CHECKOUT_SESSION_ID}"),
+        cancel_url: account_settings_url
+      )
+      redirect_to session.url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def selected_plan
+      if key = params[:plan_key] || params[:plan]
+        Plan[key] || Plan.find_by_price_id(key)
+      elsif params[:price_id].present?
+        Plan.find_by_price_id(params[:price_id])
+      else
+        Plan.paid
+      end
+    end
+end
