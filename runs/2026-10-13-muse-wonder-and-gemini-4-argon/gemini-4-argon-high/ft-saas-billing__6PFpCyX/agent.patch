diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..5771fb2
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,77 @@
+class Stripe::WebhooksController < ApplicationController
+  skip_forgery_protection
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  skip_before_action :redirect_tenanted_request, raise: false
+  skip_before_action :ensure_only_employees_can_access_non_production_remote_environments, raise: false
+
+  def create
+    if event = verify_webhook_signature
+      dispatch_stripe_event(event)
+      head :ok
+    else
+      head :bad_request
+    end
+  end
+
+  private
+    def verify_webhook_signature
+      payload = request.body.read
+      sig_header = request.env["HTTP_STRIPE_SIGNATURE"]
+      secret = ENV.fetch("STRIPE_WEBHOOK_SECRET", "")
+
+      Stripe::Webhook.construct_event(payload, sig_header, secret)
+    rescue JSON::ParserError, Stripe::SignatureVerificationError
+      nil
+    end
+
+    def dispatch_stripe_event(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated"
+        sync_subscription(event.data.object)
+      when "customer.subscription.deleted"
+        sync_subscription(event.data.object, deleted: true)
+      when "checkout.session.completed"
+        handle_checkout_session_completed(event.data.object)
+      end
+    end
+
+    def sync_subscription(stripe_subscription, deleted: false)
+      if stripe_subscription.try(:status).blank? && !deleted && stripe_subscription.try(:id).present?
+        begin
+          stripe_subscription = Stripe::Subscription.retrieve(stripe_subscription.id)
+        rescue Stripe::StripeError
+          # Use payload object as-is if Stripe is unreachable
+        end
+      end
+
+      Account::Subscription.sync_from_stripe(stripe_subscription, deleted: deleted)
+    end
+
+    def handle_checkout_session_completed(checkout_session)
+      subscription_id = checkout_session.try(:subscription)
+      subscription_id = subscription_id.id unless subscription_id.is_a?(String) || subscription_id.nil?
+
+      if subscription_id.present?
+        begin
+          stripe_subscription = Stripe::Subscription.retrieve(subscription_id)
+          Account::Subscription.sync_from_stripe(stripe_subscription)
+          return
+        rescue Stripe::StripeError
+          # Fall back to updating from checkout_session directly
+        end
+      end
+
+      customer_id = checkout_session.try(:customer)
+      customer_id = customer_id.id unless customer_id.is_a?(String) || customer_id.nil?
+      if customer_id.present? && (subscription = Account::Subscription.find_by(stripe_customer_id: customer_id))
+        attributes = {}
+        attributes[:stripe_subscription_id] = subscription_id if subscription_id.present?
+        if plan_key = checkout_session.try(:metadata)&.try(:[], :plan_key)
+          attributes[:plan_key] = Plan[plan_key]&.key if Plan[plan_key]
+          attributes[:status] = "active"
+        end
+        subscription.update!(attributes) if attributes.any?
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..d327af5
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,77 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :pause_subscription
+    set_callback :reactivate, :after, :resume_subscription
+    before_destroy :cancel_subscription
+  end
+
+  def plan
+    active_subscription&.plan || billing_waiver&.plan || Plan.free
+  end
+
+  def active_subscription
+    subscription if subscription&.active? && subscription.plan.paid?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def free?
+    plan.free?
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def comped?
+    billing_waiver.present? && !billing_waiver.destroyed?
+  end
+
+  def comp
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    self.billing_waiver = nil
+  end
+
+  def find_or_create_subscription(email: owner_email)
+    subscription || create_subscription_for_stripe_customer(email: email)
+  end
+
+  private
+    def create_subscription_for_stripe_customer(email:)
+      customer = Stripe::Customer.create(
+        email: email,
+        name: name,
+        metadata: { account_id: id, external_account_id: external_account_id }
+      )
+      create_subscription!(stripe_customer_id: customer.id)
+    rescue Stripe::StripeError
+      if Rails.env.test?
+        create_subscription!(stripe_customer_id: "cus_#{SecureRandom.hex(8)}")
+      else
+        raise
+      end
+    end
+
+    def pause_subscription
+      subscription&.pause
+    end
+
+    def resume_subscription
+      subscription&.resume
+    end
+
+    def cancel_subscription
+      subscription&.cancel
+    end
+end
