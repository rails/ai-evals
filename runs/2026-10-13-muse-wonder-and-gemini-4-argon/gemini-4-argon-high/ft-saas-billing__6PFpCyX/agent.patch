diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..cdfad40
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,152 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  enum :status, %w[ active past_due unpaid canceled incomplete incomplete_expired trialing paused ].index_by(&:itself)
+
+  validates :stripe_customer_id, presence: true
+
+  delegate :name, :price, :card_limit, :storage_limit, to: :plan, prefix: true, allow_nil: true
+
+  class << self
+    def sync_from_stripe(stripe_subscription, deleted: false)
+      customer_id = extract_customer_id(stripe_subscription)
+      subscription_id = stripe_subscription.try(:id)
+
+      subscription = (find_by(stripe_subscription_id: subscription_id) if subscription_id.present?) ||
+        (find_by(stripe_customer_id: customer_id) if customer_id.present?)
+
+      if !subscription && (account_id = extract_account_id(stripe_subscription))
+        if account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+          subscription = account.subscription || account.build_subscription(stripe_customer_id: customer_id || "cus_#{account.id}")
+        end
+      end
+
+      subscription&.sync_from_stripe(stripe_subscription, deleted: deleted)
+    end
+
+    private
+      def extract_customer_id(stripe_object)
+        customer = stripe_object.try(:customer)
+        customer.is_a?(String) ? customer : customer&.try(:id)
+      end
+
+      def extract_account_id(stripe_object)
+        metadata = stripe_object.try(:metadata)
+        if metadata
+          metadata.try(:[], :account_id) || metadata.try(:[], "account_id") || metadata.try(:account_id)
+        end || stripe_object.try(:client_reference_id)
+      end
+  end
+
+  def plan
+    Plan[plan_key] || (active? ? Plan.paid : Plan.free)
+  end
+
+  def to_be_canceled?
+    cancel_at.present?
+  end
+
+  def next_amount_due
+    next_amount_due_in_cents / 100.0 if next_amount_due_in_cents
+  end
+
+  def pause
+    Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: true) if stripe_subscription_id.present?
+  end
+
+  def resume
+    Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: false) if stripe_subscription_id.present?
+  end
+
+  def cancel
+    Stripe::Subscription.cancel(stripe_subscription_id) if stripe_subscription_id.present?
+  end
+
+  def sync_from_stripe(stripe_subscription, deleted: false)
+    customer_id = self.class.send(:extract_customer_id, stripe_subscription)
+    price = extract_price(stripe_subscription)
+    price_id = price.is_a?(String) ? price : price&.try(:id)
+    resolved_plan = Plan.find_by_price_id(price_id) ||
+      Plan[extract_metadata(stripe_subscription, :plan_key)] ||
+      Plan[stripe_subscription.try(:plan_key)]
+
+    period_end = extract_period_end(stripe_subscription)
+    resolved_period_end = to_time(period_end)
+    resolved_status = deleted ? "canceled" : (stripe_subscription.try(:status) || status)
+    resolved_cancel_at = deleted ? nil : extract_cancel_at(stripe_subscription, resolved_period_end)
+    resolved_amount_due = deleted ? nil : extract_next_amount_due(stripe_subscription, price, resolved_plan, resolved_cancel_at)
+
+    attributes = {
+      stripe_subscription_id: stripe_subscription.try(:id) || stripe_subscription_id,
+      status: resolved_status,
+      current_period_end: resolved_period_end,
+      cancel_at: resolved_cancel_at,
+      next_amount_due_in_cents: resolved_amount_due
+    }
+    attributes[:stripe_customer_id] = customer_id if customer_id.present?
+    attributes[:plan_key] = resolved_plan.key if resolved_plan.present?
+
+    update!(attributes)
+    self
+  end
+
+  private
+    def extract_price(stripe_subscription)
+      first_item = extract_first_item(stripe_subscription)
+      first_item&.try(:price) ||
+        first_item&.try(:plan) ||
+        stripe_subscription.try(:price) ||
+        stripe_subscription.try(:plan)
+    end
+
+    def extract_first_item(stripe_subscription)
+      items = stripe_subscription.try(:items)
+      if items.respond_to?(:data)
+        items.data&.first
+      elsif items.is_a?(Array)
+        items.first
+      elsif items.is_a?(Hash)
+        (items[:data] || items["data"])&.first
+      end
+    end
+
+    def extract_period_end(stripe_subscription)
+      stripe_subscription.try(:current_period_end) ||
+        extract_first_item(stripe_subscription)&.try(:current_period_end)
+    end
+
+    def extract_cancel_at(stripe_subscription, resolved_period_end)
+      if cancel_at_val = stripe_subscription.try(:cancel_at)
+        to_time(cancel_at_val)
+      elsif stripe_subscription.try(:cancel_at_period_end)
+        resolved_period_end
+      end
+    end
+
+    def extract_next_amount_due(stripe_subscription, price, resolved_plan, resolved_cancel_at)
+      return 0 if resolved_cancel_at.present?
+
+      if amount = stripe_subscription.try(:next_amount_due_in_cents)
+        amount
+      elsif unit_amount = price&.try(:unit_amount) || price&.try(:amount)
+        unit_amount
+      elsif resolved_plan
+        resolved_plan.price * 100
+      end
+    end
+
+    def extract_metadata(stripe_object, key)
+      metadata = stripe_object.try(:metadata)
+      if metadata
+        metadata.try(:[], key) || metadata.try(:[], key.to_s) || metadata.try(key)
+      end
+    end
+
+    def to_time(value)
+      case value
+      when Numeric then Time.at(value).utc
+      when String then Time.zone.parse(value)
+      when Time, DateTime then value
+      end
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..edd133c
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,110 @@
+class Plan
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+  alias_method :cards_limit, :card_limit
+  alias_method :bytes_allowed, :storage_limit
+  alias_method :storage_allowance, :storage_limit
+
+  class << self
+    def all
+      PLANS.values
+    end
+
+    def free
+      PLANS[:free_v1]
+    end
+
+    def paid
+      PLANS[:monthly_v1]
+    end
+
+    def unlimited
+      PLANS[:monthly_v1]
+    end
+
+    def unlimited_plus
+      PLANS[:monthly_extra_storage_v1]
+    end
+
+    def find(key)
+      if key.is_a?(Plan)
+        key
+      elsif key.present?
+        normalized = ALIASES[key.to_s] || key.to_sym
+        PLANS[normalized]
+      end
+    end
+    alias_method :[], :find
+
+    def find_by_price_id(price_id)
+      if price_id.present?
+        all.find { |plan| plan.stripe_price_id == price_id } || find(price_id)
+      end
+    end
+  end
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, stripe_price_id: nil)
+    @key = key.to_s
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_id = stripe_price_id
+  end
+
+  def stripe_price_id
+    ENV["STRIPE_#{key.upcase}_PRICE_ID"] || @stripe_price_id
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit == Float::INFINITY
+  end
+
+  def to_param
+    key
+  end
+
+  PLANS = {
+    free_v1: new(
+      key: :free_v1,
+      name: "Free",
+      price: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte
+    ),
+    monthly_v1: new(
+      key: :monthly_v1,
+      name: "Unlimited",
+      price: 20,
+      card_limit: Float::INFINITY,
+      storage_limit: 5.gigabytes,
+      stripe_price_id: "price_monthly_v1_test"
+    ),
+    monthly_extra_storage_v1: new(
+      key: :monthly_extra_storage_v1,
+      name: "Unlimited+",
+      price: 25,
+      card_limit: Float::INFINITY,
+      storage_limit: 500.gigabytes,
+      stripe_price_id: "price_monthly_extra_storage_v1_test"
+    )
+  }.freeze
+
+  ALIASES = {
+    "free" => :free_v1,
+    "Free" => :free_v1,
+    "unlimited" => :monthly_v1,
+    "Unlimited" => :monthly_v1,
+    "unlimited_plus" => :monthly_extra_storage_v1,
+    "unlimited+" => :monthly_extra_storage_v1,
+    "Unlimited+" => :monthly_extra_storage_v1,
+    "extra_storage" => :monthly_extra_storage_v1
+  }.freeze
+end
diff --git a/saas/app/views/account/settings/_subscription.html.erb b/saas/app/views/account/settings/_subscription.html.erb
