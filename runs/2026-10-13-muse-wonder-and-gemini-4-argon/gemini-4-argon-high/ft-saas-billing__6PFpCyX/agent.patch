@@ -0,0 +1,34 @@
+<section id="subscription" class="settings__section settings-subscription">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      You’re on the <strong><%= Current.account.plan.name %></strong> plan
+      <% if Current.account.plan.free? %>
+        (<%= number_with_delimiter(Current.account.plan.card_limit) %> cards, <%= number_to_human_size(Current.account.plan.storage_limit) %>).
+      <% else %>
+        ($<%= Current.account.plan.price %>/month, <%= number_to_human_size(Current.account.plan.storage_limit) %>).
+      <% end %>
+    </div>
+  </header>
+
+  <% if Current.account.active_subscription %>
+    <% if Current.account.subscription.to_be_canceled? %>
+      <div class="txt-small txt-subtle">
+        Your subscription will end on <%= Current.account.subscription.cancel_at.strftime("%B %-d, %Y") %>.
+      </div>
+    <% end %>
+
+    <div class="flex gap-half flex-wrap justify-center">
+      <%= button_to "Manage subscription", saas.account_billing_portal_path, class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+
+      <% if Current.account.plan == Plan.unlimited %>
+        <%= button_to "Upgrade", saas.account_subscription_path(plan_key: Plan.unlimited_plus.key), class: "btn btn--link settings-subscription__button", form: { data: { turbo: false } } %>
+      <% end %>
+    </div>
+  <% else %>
+    <div class="flex gap-half flex-wrap justify-center">
+      <%= button_to "Upgrade", saas.account_subscription_path(plan_key: Plan.unlimited.key), class: "btn btn--link settings-subscription__button", form: { data: { turbo: false } } %>
+      <%= button_to "Upgrade to Unlimited+", saas.account_subscription_path(plan_key: Plan.unlimited_plus.key), class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+    </div>
+  <% end %>
+</section>
