new file mode 100644
index 0000000..27261a1
--- /dev/null
+++ b/saas/app/models/account/limited.rb
@@ -0,0 +1,49 @@
+module Account::Limited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+  alias_method :cards_limit, :card_limit
+
+  def card_count
+    overridden_limits&.card_count || cards_count
+  end
+
+  def cards_remaining
+    if plan.unlimited_cards?
+      Float::INFINITY
+    else
+      [ card_limit - card_count, 0 ].max
+    end
+  end
+  alias_method :cards_left, :cards_remaining
+
+  def exceeding_card_limit?
+    !comped? && card_count >= card_limit
+  end
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+
+  def nearing_card_limit?
+    !comped? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  def override_limits(**attributes)
+    if overridden_limits
+      overridden_limits.update!(**attributes)
+    else
+      create_overridden_limits!(**attributes)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy
+    self.overridden_limits = nil
+  end
+end
