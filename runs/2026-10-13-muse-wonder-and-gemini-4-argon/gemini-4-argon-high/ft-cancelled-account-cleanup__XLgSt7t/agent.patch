diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..edc1430
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    old_cancelled_account = accounts(:"37s")
+    recent_cancelled_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    old_cancelled_account.cancel(initiated_by: users(:david))
+    old_cancelled_account.cancellation.update!(created_at: 31.days.ago)
+
+    recent_cancelled_account.cancel(initiated_by: users(:mike))
+    recent_cancelled_account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_changes -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(old_cancelled_account.id)
+    assert Account.exists?(recent_cancelled_account.id)
+    assert Account.exists?(active_account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..a4f2fdd
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration finds accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel 2.days
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate destroys account and associated data" do
+    cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    @account.materialize_storage
+
+    account_id = @account.id
+    @account.cancel(initiated_by: @user)
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(account_id)
+    assert_not Account::Cancellation.exists?(account_id: account_id)
+    assert_not Account::JoinCode.exists?(account_id: account_id)
+    assert_not Board.exists?(account_id: account_id)
+    assert_not Card.exists?(account_id: account_id)
+    assert_not Comment.exists?(account_id: account_id)
+    assert_not User.exists?(account_id: account_id)
+    assert_not Webhook.exists?(account_id: account_id)
+    assert_not Tag.exists?(account_id: account_id)
+    assert_not Column.exists?(account_id: account_id)
+    assert_not Entropy.exists?(account_id: account_id)
+    assert_not Export.exists?(account_id: account_id)
+    assert_not Storage::Entry.exists?(account_id: account_id)
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: account_id)
+  end
+end
