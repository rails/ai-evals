+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    expired_mail = ActionMailer::Base.deliveries.last
+    assert_equal ["expired@example.test"], expired_mail.to
+    acct_sub, expired_token = extract_token_from_mail(expired_mail, "http://localhost:3001/accept-invitation")
+    assert_equal "acme", acct_sub
+
+    travel 8.days
+
+    # Expired invitation now shows status "expired"
+    get "/api/v1/invitations/#{expired_inv_id}", headers: owner_headers
+    assert_response :ok
