diff --git a/app/controllers/api/v1/invitations_controller.rb b/app/controllers/api/v1/invitations_controller.rb
new file mode 100644
index 0000000..2a728d7
--- /dev/null
+++ b/app/controllers/api/v1/invitations_controller.rb
@@ -0,0 +1,97 @@
+module Api
+  module V1
+    class InvitationsController < ApplicationController
+      before_action :authenticate_user!
+      before_action :require_active_account!
+      before_action :require_admin!
+      before_action :expire_overdue_invitations!
+      before_action :set_invitation, only: [:show, :resend, :destroy]
+
+      def index
+        scope = @current_account.invitations.order(id: :asc)
+
+        if params[:status].present?
+          status_filter = params[:status].to_s.strip.downcase
+          scope = case status_filter
+          when "pending"
+            scope.pending
+          when "accepted"
+            scope.accepted
+          when "revoked"
+            scope.revoked
+          when "expired"
+            scope.expired
+          else
+            scope.none
+          end
+        end
+
+        render json: paginate_collection(scope, key: :invitations, &:as_invitation_json), status: :ok
+      end
+
+      def show
+        render json: { invitation: @invitation.as_invitation_json }, status: :ok
+      end
+
+      def create
+        invitation_data = params[:invitation]
+        unless invitation_data.is_a?(ActionController::Parameters) || invitation_data.is_a?(Hash)
+          render_error("Invitation parameters are required", status: :unprocessable_entity)
+          return
+        end
+
+        invitation = @current_account.invitations.build(
+          invited_by: @current_user,
+          email: invitation_data[:email],
+          role: invitation_data[:role]
+        )
+
+        unless invitation.valid?
+          render_validation_errors(invitation)
+          return
+        end
+
+        invitation.save!
+        UserMailer.invitation(invitation, invitation.token).deliver_now
+
+        render json: { invitation: invitation.as_invitation_json }, status: :created
+      end
+
+      def resend
+        unless @invitation.pending?
+          render_error("Only pending invitations can be resent", status: :unprocessable_entity)
+          return
+        end
+
+        new_token = @invitation.resend!
+        UserMailer.invitation(@invitation, new_token).deliver_now
+
+        render json: { invitation: @invitation.as_invitation_json }, status: :ok
+      end
+
+      def destroy
+        unless @invitation.pending?
+          render_error("Only pending invitations can be revoked", status: :unprocessable_entity)
+          return
+        end
+
+        @invitation.revoke!
+
+        render json: { invitation: @invitation.as_invitation_json }, status: :ok
+      end
+
+      private
+
+      def expire_overdue_invitations!
+        @current_account.invitations.expire_overdue!
+      end
+
+      def set_invitation
+        @invitation = @current_account.invitations.find_by(id: params[:id])
+        unless @invitation
+          render_error("Invitation not found", status: :not_found)
+        end
+      end
+    end
+  end
+end
