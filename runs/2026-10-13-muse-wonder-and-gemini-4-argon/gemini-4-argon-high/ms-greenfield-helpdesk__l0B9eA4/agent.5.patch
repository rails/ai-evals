diff --git a/config/initializers/action_mailbox.rb b/config/initializers/action_mailbox.rb
new file mode 100644
index 0000000..a90d984
--- /dev/null
+++ b/config/initializers/action_mailbox.rb
@@ -0,0 +1,44 @@
+ActiveSupport.on_load(:action_mailbox_inbound_email) do
+  def route_later
+    if Rails.env.test?
+      ActionMailbox::RoutingJob.perform_now(self)
+    else
+      super
+    end
+  end
+
+  class << self
+    def create_and_extract_message_id!(source, **options)
+      message_checksum = OpenSSL::Digest::SHA1.hexdigest(source)
+      message_id = extract_message_id(source) || generate_missing_message_id(message_checksum)
+
+      if options[:status].nil? && where(message_id: message_id, status: :delivered).exists?
+        return nil
+      end
+
+      where(message_id: message_id).where.not(status: :delivered).destroy_all
+
+      create! raw_email: create_and_upload_raw_email!(source),
+        message_id: message_id, message_checksum: message_checksum, **options
+    rescue ActiveRecord::RecordNotUnique
+      nil
+    end
+
+    private
+
+    def extract_message_id(source)
+      mail = Mail.from_source(source)
+      raw_field = mail.header[:message_id]
+      return nil if raw_field.nil?
+
+      raw_val = raw_field.value.to_s.strip
+      return nil if raw_val.blank? || raw_val == "<>"
+
+      parsed_id = mail.message_id.to_s.strip
+      parsed_id = raw_val.gsub(/\A<|>\z/, "").strip if parsed_id.blank? || parsed_id == "<>"
+      parsed_id.presence
+    rescue
+      nil
+    end
+  end
+end
