diff --git a/test/integration/inbound_email_test.rb b/test/integration/inbound_email_test.rb
new file mode 100644
index 0000000..c6492e8
--- /dev/null
+++ b/test/integration/inbound_email_test.rb
@@ -0,0 +1,746 @@
+require "test_helper"
+
+class InboundEmailTest < ActionDispatch::IntegrationTest
+  INGRESS_PATH = "/rails/action_mailbox/relay/inbound_emails"
+  INGRESS_PASSWORD = "test-inbound-secret"
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+    ENV["RAILS_INBOUND_EMAIL_PASSWORD"] = INGRESS_PASSWORD
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  teardown do
+    ENV.delete("RAILS_INBOUND_EMAIL_PASSWORD")
+    ENV.delete("HELPDESK_SUPPORT_DOMAIN")
+    ENV.delete("HELPDESK_FRONTEND_URL")
+    ENV.delete("HELPDESK_MAIL_FROM")
+  end
+
+  def extract_token_from_mail(mail, path)
+    body = mail.body.decoded
+    match = body.match(%r{#{Regexp.escape(path)}\?account=([^&\s]+)&token=([^\s&]+)})
+    assert match, "Expected link matching #{path} in mail body: #{body.inspect}"
+    [match[1], match[2]]
+  end
+
+  def setup_business(name: "Acme", subdomain: "acme", admin_email: nil, password: "admin-password")
+    admin_email ||= "admin@#{subdomain}.test"
+    post "/api/v1/account/create",
+      params: {
+        account: {
+          name: name,
+          subdomain: subdomain,
+          admin: {
+            name: "#{name} Admin",
+            email: admin_email,
+            password: password
+          }
+        }
+      },
+      as: :json
+    assert_response :created
+    _, verify_token = extract_token_from_mail(ActionMailer::Base.deliveries.last, "http://localhost:3001/verify-email")
+
+    headers = { "X-Helpdesk-Account" => subdomain }
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: verify_token } },
+      headers: headers,
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/sessions",
+      params: { session: { email: admin_email, password: password } },
+      headers: headers,
+      as: :json
+    assert_response :ok
+    session_token = response.parsed_body.dig("session", "token")
+
+    ActionMailer::Base.deliveries.clear
+    {
+      account: Account.find_by!(subdomain: subdomain),
+      headers: headers.merge("Authorization" => "Bearer #{session_token}"),
+      public_headers: headers
+    }
+  end
+
+  def relay_auth_header(username: "actionmailbox", password: INGRESS_PASSWORD)
+    ActionController::HttpAuthentication::Basic.encode_credentials(username, password)
+  end
+
+  def post_inbound_raw(raw_email, auth: relay_auth_header, content_type: "message/rfc822")
+    headers = { "CONTENT_TYPE" => content_type }
+    headers["HTTP_AUTHORIZATION"] = auth if auth
+    post INGRESS_PATH, params: raw_email, headers: headers
+  end
+
+  def build_raw_email(from:, to: nil, cc: nil, subject: "Help needed", body: "Plain text body", message_id: nil, extra_headers: {}, &block)
+    mail = Mail.new do
+      self.from = from if from
+      self.to = to if to
+      self.cc = cc if cc
+      self.subject = subject unless subject.nil?
+      self.message_id = message_id if message_id
+    end
+    extra_headers.each do |k, v|
+      mail[k] = v
+    end
+    if block_given?
+      yield mail
+    elsif !body.nil?
+      mail.body = body
+    end
+    mail.to_s
+  end
+
+  test "relay ingress authentication and content type validation" do
+    setup_business(name: "Acme", subdomain: "acme")
+    raw = build_raw_email(from: "Avery <avery@example.test>", to: "acme@support.example.test", subject: "Auth test", body: "Hello")
+
+    # Missing auth -> 401
+    post_inbound_raw(raw, auth: nil)
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong password -> 401
+    post_inbound_raw(raw, auth: relay_auth_header(password: "wrong-password"))
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong username -> 401
+    post_inbound_raw(raw, auth: relay_auth_header(username: "wronguser"))
+    assert_response :unauthorized
+    assert_equal 0, Ticket.count
+
+    # Wrong content-type -> 415
+    post_inbound_raw(raw, content_type: "text/plain")
+    assert_response :unsupported_media_type
+    assert_equal 0, Ticket.count
+
+    # Valid auth and content-type -> 204 and processes synchronously
+    post_inbound_raw(raw)
+    assert_response :no_content
+    assert_equal 1, Ticket.count
+  end
+
+  test "incoming email opens ticket with subject and plain-text message, creates unverified customer, sends verification email, and allows later portal access" do
+    acme = setup_business(name: "Acme", subdomain: "acme")
+
+    raw = build_raw_email(
+      from: "Avery Customer <avery@example.test>",
+      to: "Acme Support <acme@support.example.test>",
+      subject: "Cannot export my data",
+      message_id: "<msg-101@example.test>"
+    ) do |mail|
+      mail.text_part do
+        body "When I click export, nothing happens.\r\nPlease advise."
+      end
+      mail.html_part do
+        content_type "text/html; charset=UTF-8"
+        body "<html><body><p>When I click <b>export</b>, nothing happens.</p></body></html>"
+      end
+    end
+
+    post_inbound_raw(raw)
+    assert_response :no_content
+
+    # Customer created as unverified and verification email sent
+    customer = acme[:account].users.find_by(email: "avery@example.test")
+    assert_not_nil customer
+    assert_equal "Avery Customer", customer.name
+    assert_equal "customer", customer.role
+    assert_equal false, customer.verified?
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    verify_mail = ActionMailer::Base.deliveries.last
+    assert_equal ["avery@example.test"], verify_mail.to
+    account_sub, verify_token = extract_token_from_mail(verify_mail, "http://localhost:3001/verify-email")
+    assert_equal "acme", account_sub
+
+    # Ticket and plain-text comment created
+    get "/api/v1/tickets", headers: acme[:headers]
+    assert_response :ok
+    assert_equal 1, response.parsed_body["count"]
+    ticket_json = response.parsed_body["tickets"].first
+    ticket_id = ticket_json["id"]
+    assert_equal "Cannot export my data", ticket_json["subject"]
+    assert_equal "open", ticket_json["status"]
+    assert_equal "normal", ticket_json["priority"]
+    assert_equal customer.id, ticket_json["requester_id"]
+
+    get "/api/v1/tickets/#{ticket_id}/comments", headers: acme[:headers]
+    assert_response :ok
+    comments = response.parsed_body["comments"]
+    assert_equal 1, comments.size
+    assert_equal "When I click export, nothing happens.\nPlease advise.", comments.first["body"]
+    assert_equal true, comments.first["public"]
+    assert_equal customer.id, comments.first.dig("author", "id")
+
+    # Receiving a second email does not verify the customer or send another verification email
+    ActionMailer::Base.deliveries.clear
