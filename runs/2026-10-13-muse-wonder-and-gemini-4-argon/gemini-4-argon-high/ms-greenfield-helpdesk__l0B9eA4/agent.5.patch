+++ b/app/mailers/ticket_mailer.rb
@@ -0,0 +1,19 @@
+class TicketMailer < ApplicationMailer
+  def staff_reply(ticket, comment)
+    @ticket = ticket
+    @comment = comment
+    @account = ticket.account
+    @requester = ticket.requester
+    reply_address = @ticket.reply_email_address
+    subject = @ticket.subject.match?(/\ARe:/i) ? @ticket.subject : "Re: #{@ticket.subject}"
+
+    mail(
+      from: reply_address,
+      reply_to: reply_address,
+      to: @requester.email,
+      subject: subject,
+      body: "#{@comment.body}\n",
+      content_type: "text/plain"
+    )
+  end
+end
