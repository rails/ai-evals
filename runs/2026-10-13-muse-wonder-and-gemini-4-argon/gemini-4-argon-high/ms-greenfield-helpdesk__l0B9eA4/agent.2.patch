+      as: :json
+    assert_response :created
+    _, beta_cust_verify = extract_token_from_mail(ActionMailer::Base.deliveries.last, "http://localhost:3001/verify-email")
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: acme_cust_verify } },
+      headers: acme_headers,
+      as: :json
+    assert_response :ok
+
+    post "/api/v1/email_verifications/confirm",
+      params: { email_verification: { token: beta_cust_verify } },
