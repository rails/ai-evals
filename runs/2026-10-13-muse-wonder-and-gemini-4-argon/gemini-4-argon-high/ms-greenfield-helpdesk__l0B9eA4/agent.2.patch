+      headers: acme_headers,
+      as: :json
+    assert_response :created
+    _, acme_cust_verify = extract_token_from_mail(ActionMailer::Base.deliveries.last, "http://localhost:3001/verify-email")
+
+    # Duplicate customer registration in same account fails
