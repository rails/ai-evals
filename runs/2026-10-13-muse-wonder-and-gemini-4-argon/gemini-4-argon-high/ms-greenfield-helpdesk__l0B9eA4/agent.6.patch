+
+    get "/api/v1/tickets", params: { group_id: tech_id }, headers: pat_headers
+    assert_response :ok
+    assert_equal [t2_id], response.parsed_body["tickets"].map { |t| t["id"] }
+
+    get "/api/v1/tickets", params: { group_id: "unassigned" }, headers: pat_headers
+    assert_response :ok
+    assert_equal [t3_id], response.parsed_body["tickets"].map { |t| t["id"] }
+
