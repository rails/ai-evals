+    assert_response :ok
+
+    # Assign Sam to ungrouped ticket t3 -> uses Sam's kept default group (Tech Support)
+    patch "/api/v1/tickets/#{t3_id}",
+      params: { ticket: { assignee_id: sam_id } },
+      headers: owner_headers,
+      as: :json
