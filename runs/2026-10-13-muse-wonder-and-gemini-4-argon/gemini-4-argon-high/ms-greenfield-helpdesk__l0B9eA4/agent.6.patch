+
+  before_validation :normalize_name
+  before_destroy :clear_ticket_assignments, prepend: true
+
+  validates :name,
+    presence: true,
+    uniqueness: { scope: :account_id, case_sensitive: false }
+
+  def as_group_json
+    {
+      id: id,
+      account_id: account_id,
+      name: name,
+      created_at: created_at,
+      updated_at: updated_at
+    }
+  end
+
+  private
+
+  def normalize_name
+    self.name = name.to_s.strip unless name.nil?
+  end
+
+  def clear_ticket_assignments
+    account.tickets.where(group_id: id).update_all(group_id: nil, assignee_id: nil)
+  end
+end
diff --git a/app/models/group_membership.rb b/app/models/group_membership.rb
