diff --git a/test/integration/inbound_email_test.rb b/test/integration/inbound_email_test.rb
index c6492e8..25325b3 100644
--- a/test/integration/inbound_email_test.rb
+++ b/test/integration/inbound_email_test.rb
@@ -743,4 +743,117 @@ class InboundEmailTest < ActionDispatch::IntegrationTest
     assert_equal 1, acme_ticket.comments.count
     assert_equal 1, beta[:account].tickets.count
   end
+
+  test "merged closed ticket rejects incoming email replies, merge notes do not send email, and surviving ticket keeps its email identity" do
+    acme = setup_business(name: "Acme", subdomain: "acme")
+
+    # Avery sends two emails opening Ticket 1 and Ticket 2
+    post_inbound_raw(
+      build_raw_email(
+        from: "Avery <avery@example.test>",
+        to: "acme@support.example.test",
+        subject: "Email duplicate 1",
+        body: "First email body",
+        message_id: "<merge-mail-1@example.test>"
+      )
+    )
+    assert_response :no_content
+
+    post_inbound_raw(
+      build_raw_email(
+        from: "Avery <avery@example.test>",
+        to: "acme@support.example.test",
+        subject: "Email duplicate 2",
+        body: "Second email body",
+        message_id: "<merge-mail-2@example.test>"
+      )
+    )
+    assert_response :no_content
+
+    tickets = acme[:account].tickets.order(id: :asc).to_a
+    assert_equal 2, tickets.size
+    t1, t2 = tickets
+    t1_reply_addr = t1.reply_email_address
+    t2_reply_addr = t2.reply_email_address
+    t2_reply_token = t2.reply_token
+
+    ActionMailer::Base.deliveries.clear
+
+    # Merge email-origin t1 into email-origin t2 with PUBLIC notes on both sides -> must NOT send any email!
+    post "/api/v1/tickets/#{t1.id}/merge",
+      params: {
+        merge: {
+          target_id: t2.id,
+          source_comment: { body: "Merged into #{t2.id}", public: true },
+          target_comment: { body: "Merged from #{t1.id}", public: true }
+        }
+      },
+      headers: acme[:headers],
+      as: :json
+    assert_response :ok
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    assert_equal "closed", t1.reload.status
+    assert_equal t2.id, t1.merged_into_id
+    assert_equal t2_reply_token, t2.reload.reply_token
+    assert_equal true, t2.email_origin?
+
+    # Incoming email reply to closed ticket t1's reply address is rejected (no comment added, stays closed, no new ticket)
+    post_inbound_raw(
+      build_raw_email(
+        from: "Avery <avery@example.test>",
+        to: t1_reply_addr,
+        subject: "Re: Email duplicate 1",
+        body: "Replying to closed ticket",
+        message_id: "<merge-mail-reply-closed@example.test>"
+      )
+    )
+    assert_response :no_content
+    assert_equal 2, acme[:account].tickets.count
+    assert_equal "closed", t1.reload.status
+    assert_equal 2, t1.comments.count
+
+    # Incoming email reply to surviving ticket t2's reply address succeeds
+    post_inbound_raw(
+      build_raw_email(
+        from: "Avery <avery@example.test>",
+        to: t2_reply_addr,
+        subject: "Re: Email duplicate 2",
+        body: "Replying to surviving ticket",
+        message_id: "<merge-mail-reply-surviving@example.test>"
+      )
+    )
+    assert_response :no_content
+    assert_equal 3, t2.reload.comments.count
+    assert_equal "Replying to surviving ticket", t2.comments.order(id: :asc).last.body
+
+    # Merging an email-origin ticket (t2) into a web-origin ticket (t3) does not change t3's email_origin (stays false)
+    avery = t1.requester
+    t3 = acme[:account].tickets.create!(
+      requester: avery,
+      subject: "Web portal ticket",
+      status: "open",
+      priority: "normal",
+      email_origin: false
+    )
+    t3.comments.create!(account: acme[:account], author: avery, body: "Opened via web", public: true)
+    t3_original_token = t3.reply_token
+
+    ActionMailer::Base.deliveries.clear
+    post "/api/v1/tickets/#{t2.id}/merge",
+      params: { merge: { target_id: t3.id } },
+      headers: acme[:headers],
+      as: :json
+    assert_response :ok
+    assert_equal 0, ActionMailer::Base.deliveries.size
+    assert_equal false, t3.reload.email_origin?
+    assert_equal t3_original_token, t3.reply_token
+
+    # Staff public reply on web-origin t3 still does NOT send email
+    patch "/api/v1/tickets/#{t3.id}",
+      params: { ticket: { comment: { body: "Staff reply on web ticket", public: true } } },
+      headers: acme[:headers],
+      as: :json
+    assert_response :ok
+    assert_equal 0, ActionMailer::Base.deliveries.size
+  end
 end
