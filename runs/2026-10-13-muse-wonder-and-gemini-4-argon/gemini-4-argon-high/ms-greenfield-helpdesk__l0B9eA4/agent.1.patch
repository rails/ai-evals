diff --git a/config/initializers/cors.rb b/config/initializers/cors.rb
new file mode 100644
index 0000000..63bf44d
--- /dev/null
+++ b/config/initializers/cors.rb
@@ -0,0 +1,26 @@
+require "uri"
+
+Rails.application.config.middleware.insert_before 0, Rack::Cors do
+  allow do
+    origins do |source, _env|
+      frontend_url = ENV["HELPDESK_FRONTEND_URL"].presence || "http://localhost:3001"
+      begin
+        uri = URI.parse(frontend_url)
+        allowed_origin = if uri.scheme && uri.host
+          port_part = (uri.port && uri.port != uri.default_port) ? ":#{uri.port}" : ""
+          "#{uri.scheme}://#{uri.host}#{port_part}"
+        else
+          frontend_url.sub(%r{/+\z}, "")
+        end
+      rescue URI::InvalidURIError
+        allowed_origin = frontend_url.sub(%r{/+\z}, "")
+      end
+      source == allowed_origin
+    end
+
+    resource "*",
+      headers: :any,
+      methods: [:get, :post, :put, :patch, :delete, :options, :head],
+      max_age: 600
+  end
+end
