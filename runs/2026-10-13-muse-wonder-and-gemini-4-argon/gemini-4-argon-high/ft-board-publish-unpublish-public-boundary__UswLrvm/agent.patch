diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..3f2fe42
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "publish and unpublish" do
+    board = boards(:writebook)
+    assert_not board.published?
+    assert_nil board.public_key
+
+    publication = board.publish
+    assert board.published?
+    assert_not_nil board.public_key
+    assert_equal publication.key, board.public_key
+    assert_equal board, Board.find_by_published_key(board.public_key)
+
+    board.unpublish
+    assert_not board.published?
+    assert_nil board.public_key
+    assert_raises(ActiveRecord::RecordNotFound) do
+      Board.find_by_published_key(publication.key)
+    end
+  end
+
+  test "publish is idempotent" do
+    board = boards(:writebook)
+    publication = board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      assert_equal publication, board.publish
+    end
+  end
+
+  test "publishing and unpublishing touches board" do
+    board = boards(:writebook)
+
+    travel 1.minute do
+      assert_changes -> { board.reload.updated_at } do
+        board.publish
+      end
+    end
+
+    travel 2.minutes do
+      assert_changes -> { board.reload.updated_at } do
+        board.unpublish
+      end
+    end
+  end
+
+  test "publicly_accessible?" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    draft_card = board.cards.create!(title: "Draft", status: :drafted, creator: users(:david))
+    comment = comments(:logo_agreement_kevin)
+
+    assert_not board.publicly_accessible?
+    assert_not card.publicly_accessible?
+    assert_not draft_card.publicly_accessible?
+    assert_not comment.publicly_accessible?
+
+    board.publish
+    card.reload
+    draft_card.reload
+    comment.reload
+
+    assert board.publicly_accessible?
+    assert card.publicly_accessible?
+    assert_not draft_card.publicly_accessible?
+    assert comment.publicly_accessible?
+  end
+end
