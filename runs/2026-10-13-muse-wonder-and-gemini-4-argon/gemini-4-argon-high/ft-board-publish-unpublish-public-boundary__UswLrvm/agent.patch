diff --git a/test/controllers/public/boards/cards_controller_test.rb b/test/controllers/public/boards/cards_controller_test.rb
new file mode 100644
index 0000000..87a580d
--- /dev/null
+++ b/test/controllers/public/boards/cards_controller_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "show published card of a published board" do
+    @board.publish
+
+    get public_board_card_path(@board.public_key, @card)
+    assert_response :success
+    assert_select "h1", text: @card.title
+  end
+
+  test "drafted card of a published board returns not found" do
+    @board.publish
+    draft_card = @board.cards.create!(title: "Draft card", status: :drafted, creator: users(:david))
+
+    get public_board_card_path(@board.public_key, draft_card)
+    assert_response :not_found
+  end
+
+  test "card from another board returns not found" do
+    @board.publish
+    other_card = Current.set(session: sessions(:kevin)) { boards(:private).cards.create!(title: "Private card", status: :published) }
+
+    get public_board_card_path(@board.public_key, other_card)
+    assert_response :not_found
+  end
+
+  test "card of an unpublished board returns not found" do
+    get public_board_card_path("invalid-key", @card)
+    assert_response :not_found
+  end
+
+  test "card image is publicly accessible when board is published" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    get rails_blob_path(@card.image, disposition: "inline")
+    assert_redirected_to new_session_path(script_name: nil)
+
+    @board.publish
+
+    get rails_blob_path(@card.image, disposition: "inline")
+    assert_response :redirect
+    assert_not_equal new_session_url(script_name: nil), response.location
