diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..297ccb7
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,50 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_permission_to_administer_reaction, only: :destroy
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_delete_controller.js b/app/javascript/controllers/reaction_delete_controller.js
new file mode 100644
index 0000000..98ce2e9
--- /dev/null
+++ b/app/javascript/controllers/reaction_delete_controller.js
@@ -0,0 +1,59 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "button" ]
+  static values = { reacterId: String }
+  static classes = [ "deleteable", "deleting", "expanded" ]
+
+  connect() {
+    this.#updateDeleteableState()
+  }
+
+  reacterIdValueChanged() {
+    this.#updateDeleteableState()
+  }
+
+  reveal(event) {
+    event.preventDefault()
+
+    if (this.#canDelete) {
+      this.element.classList.toggle(this.#expandedClass)
+    }
+  }
+
+  hide() {
+    this.element.classList.remove(this.#expandedClass)
+  }
+
+  hideOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.hide()
+    }
+  }
+
+  perform() {
+    if (this.#canDelete) {
+      this.element.classList.add(this.#deletingClass)
+    }
+  }
+
+  #updateDeleteableState() {
+    this.element.classList.toggle(this.#deleteableClass, this.#canDelete)
+  }
+
+  get #canDelete() {
+    return Boolean(Current.user && this.reacterIdValue === Current.user.id)
+  }
+
+  get #deleteableClass() {
+    return this.hasDeleteableClass ? this.deleteableClass : "reaction--deleteable"
+  }
+
+  get #deletingClass() {
+    return this.hasDeletingClass ? this.deletingClass : "reaction--deleting"
+  }
+
+  get #expandedClass() {
+    return this.hasExpandedClass ? this.expandedClass : "expanded"
+  }
+}
