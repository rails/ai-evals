+<%= turbo_frame_tag @comment, :reacting do %>
+  <%= form_with model: [ @comment.card, @comment, Reaction.new ],
+        class: "reaction reaction__form expanded",
+        data: {
+          controller: "form reaction-emoji morph-guard",
+          action: "keydown.esc->form#cancel:stop submit->form#preventEmptySubmit submit->form#preventComposingSubmit"
+        } do |form| %>
+    <label class="reaction__form-label flex align-center gap-half">
+      <figure class="reaction__avatar margin-none">
+        <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true, class: "btn btn--circle" %>
+      </figure>
+
+      <span class="for-screen-reader">Add a reaction</span>
+      <%= form.text_field :content, autofocus: true, autocomplete: "off", autocorrect: "off", maxlength: 16,
+            required: true, class: "input boost__input reaction__input txt-small",
+            data: {
+              form_target: "input",
+              reaction_emoji_target: "input",
+              "1p-ignore": "true",
+              action: "compositionstart->form#compositionStart compositionend->form#compositionEnd"
+            },
+            aria: { label: "Reaction" } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <%= button_tag type: :button, class: "btn btn--plain reaction__menu-btn", data: { action: "dialog#toggle" } do %>
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Reaction menu</span>
+      <% end %>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= button_tag type: :button, class: "btn btn--plain", value: emoji,
+                  data: { action: "dialog#close reaction-emoji#insert" } do %>
+              <span aria-hidden="true"><%= emoji %></span>
+              <span class="for-screen-reader"><%= label %></span>
+            <% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "btn btn--plain reaction__submit-btn", title: "Confirm" do %>
+      <%= icon_tag "check-circle" %>
+      <span class="for-screen-reader">Submit new reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@comment.card, @comment), class: "btn btn--plain reaction__cancel-btn",
+          title: "Cancel", data: { form_target: "cancel" } do %>
+      <%= icon_tag "close-circle" %>
+      <span class="for-screen-reader">Cancel new reaction</span>
+    <% end %>
+  <% end %>
+<% end %>
