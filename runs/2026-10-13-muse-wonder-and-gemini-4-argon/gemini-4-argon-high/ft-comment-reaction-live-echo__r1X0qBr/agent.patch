@@ -0,0 +1,22 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input" ]
+
+  connect() {
+    if (this.hasInputTarget) {
+      this.inputTarget.focus()
+    }
+  }
+
+  insert(event) {
+    const emoji = event.currentTarget.value
+    const start = this.inputTarget.selectionStart ?? this.inputTarget.value.length
+    const end = this.inputTarget.selectionEnd ?? this.inputTarget.value.length
+
+    if (this.inputTarget.value.length + emoji.length - (end - start) <= this.inputTarget.maxLength) {
+      this.inputTarget.setRangeText(emoji, start, end, "end")
+    }
+    this.inputTarget.focus()
+  }
+}
