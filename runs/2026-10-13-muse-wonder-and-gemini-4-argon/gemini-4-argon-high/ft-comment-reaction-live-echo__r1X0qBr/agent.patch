diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..9f30575
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "validates content presence and maximum length of 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    blank_reaction = comment.reactions.build(content: "")
+    assert_not blank_reaction.valid?
+
+    whitespace_reaction = comment.reactions.build(content: "   ")
+    assert_not whitespace_reaction.valid?
+
+    max_length_reaction = comment.reactions.build(content: "a" * 16)
+    assert max_length_reaction.valid?
+
+    too_long_reaction = comment.reactions.build(content: "a" * 17)
+    assert_not too_long_reaction.valid?
+  end
+
+  test "creating a reaction touches card last_active_at and comment" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    travel 1.hour do
+      assert_changes -> { card.reload.last_active_at } do
+        assert_changes -> { comment.reload.updated_at } do
+          comment.reactions.create!(content: "🎉")
+        end
+      end
+    end
+  end
+
+  test "all_emoji? delegates to content" do
+    comment = comments(:logo_agreement_jz)
+
+    emoji_reaction = comment.reactions.build(content: "👍🔥")
+    assert emoji_reaction.all_emoji?
+
+    text_reaction = comment.reactions.build(content: "Nice 👍")
+    assert_not text_reaction.all_emoji?
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..62ec321
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,124 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding, canceling, and removing reactions on a comment" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)}") do
+      # Existing reaction by Kevin is shown with who left it, and is not deleteable by David
+      within("##{dom_id(reactions(:kevin))}") do
+        assert_text "👍"
+        assert_selector ".reaction__avatar [aria-label='#{users(:kevin).name}']"
+      end
+      assert_no_selector "##{dom_id(reactions(:kevin))}.reaction--deleteable"
+
+      # Clicking another user's reaction does not reveal a delete button
+      find("##{dom_id(reactions(:kevin))}").click
+      assert_no_selector "##{dom_id(reactions(:kevin))} .reaction__delete"
+
+      # Click the trigger button to open the input, then cancel
+      find(".reactions__trigger").click
+      assert_selector "form.reaction__form"
+      assert_no_selector ".reactions__trigger"
+
+      find(".reaction__cancel-btn").click
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Click the trigger button, enter a reaction, and confirm
+      find(".reactions__trigger").click
+      assert_selector "input.reaction__input[maxlength='16']"
+      find("input.reaction__input").fill_in with: "Ship it! 🚀"
+      find(".reaction__submit-btn").click
+
+      # Reaction is in the strip, input is gone, and trigger button is back
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction.reaction--deleteable", text: "Ship it! 🚀"
+
+      # Add a second reaction right after
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "💯"
+      find(".reaction__submit-btn").click
+      assert_no_selector "form.reaction__form"
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction.reaction--deleteable", text: "💯"
+
+      # Clicking own reaction reveals a way to remove it
+      my_reaction = find(".reaction.reaction--deleteable", text: "Ship it! 🚀")
+      assert_no_selector ".reaction__delete"
+      my_reaction.click
+      assert_selector ".reaction__delete"
+
+      find(".reaction__delete").click
+      assert_no_selector ".reaction", text: "Ship it! 🚀"
+      assert_selector ".reaction.reaction--deleteable", text: "💯"
+    end
+  end
+
+  test "selecting an emoji from the emoji menu" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)}") do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      assert_selector "dialog.reaction__popup[open]"
+
+      within("dialog.reaction__popup") do
+        click_on "Party popper"
+      end
+
+      assert_no_selector "dialog.reaction__popup[open]"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction.reaction--deleteable span.txt-small.txt-medium", text: "🎉"
+    end
+  end
+
+  test "everyone looking at the card sees reactions land as they happen without reloading" do
+    using_session(:david) do
+      sign_in_as(users(:david))
+      visit card_url(@card)
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    within("##{dom_id(@comment)}") do
+      find(".reactions__trigger").click
+      find("input.reaction__input").fill_in with: "Live boost!"
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "Live boost!"
+    end
+
+    using_session(:david) do
+      within("##{dom_id(@comment)}") do
+        assert_selector ".reaction", text: "Live boost!", wait: 5
+        assert_no_selector ".reaction.reaction--deleteable", text: "Live boost!"
+      end
+    end
+
+    within("##{dom_id(@comment)}") do
+      find(".reaction.reaction--deleteable", text: "Live boost!").click
+      find(".reaction__delete").click
+      assert_no_selector ".reaction", text: "Live boost!"
+    end
+
+    using_session(:david) do
+      within("##{dom_id(@comment)}") do
+        assert_no_selector ".reaction", text: "Live boost!", wait: 5
+      end
+    end
+  end
+end
