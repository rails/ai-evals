diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6662713
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,271 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activities newest first" do
+    get activities_path, as: :json
+    assert_response :success
+
+    body = @response.parsed_body
+    assert_kind_of Array, body
+
+    expected_ids = users(:kevin).accessible_events.timelineable.reverse_chronologically.pluck(:id)
+    assert_equal expected_ids, body.pluck("id")
+    assert_equal expected_ids.count.to_s, response.headers["X-Total-Count"]
+  end
+
+  test "event structure for card and comment events" do
+    get activities_path, as: :json
+    assert_response :success
+
+    card_activity = @response.parsed_body.find { |e| e["id"] == events(:logo_published).id }
+    card_event = events(:logo_published)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, card_activity.keys.sort
+    assert_equal card_event.id, card_activity["id"]
+    assert_equal "card_published", card_activity["action"]
+    assert_equal card_event.created_at.utc.as_json, card_activity["created_at"]
+    assert_equal card_event.description_for(users(:kevin)).to_plain_text, card_activity["description"]
+    assert_equal({}, card_activity["particulars"])
+    assert_equal card_url(card_event.eventable), card_activity["url"]
+    assert_equal "Card", card_activity["eventable_type"]
+    assert_equal card_event.eventable.id, card_activity.dig("eventable", "id")
+    assert_equal card_event.eventable.number, card_activity.dig("eventable", "number")
+    assert_equal card_event.board.id, card_activity.dig("board", "id")
+    assert_equal card_event.board.name, card_activity.dig("board", "name")
+    assert_equal card_event.creator.id, card_activity.dig("creator", "id")
+    assert_equal card_event.creator.name, card_activity.dig("creator", "name")
+
+    comment_activity = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+    comment_event = events(:layout_commented)
+    comment = comment_event.eventable
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, comment_activity.keys.sort
+    assert_equal comment_event.id, comment_activity["id"]
+    assert_equal "comment_created", comment_activity["action"]
+    assert_equal comment_event.description_for(users(:kevin)).to_plain_text, comment_activity["description"]
+    assert_equal({}, comment_activity["particulars"])
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), comment_activity["url"]
+    assert_equal "Comment", comment_activity["eventable_type"]
+    assert_equal comment.id, comment_activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, comment_activity.dig("eventable", "body", "plain_text")
+    assert_equal comment_event.board.id, comment_activity.dig("board", "id")
+    assert_equal comment_event.creator.id, comment_activity.dig("creator", "id")
+  end
+
+  test "includes timelineable actions plus card_title_changed and omits card_collection_changed" do
+    card = cards(:logo)
+    comment = comments(:layout_overflowing_david)
+    board = boards(:writebook)
+    creator = users(:kevin)
+
+    included_card_actions = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_title_changed
+      card_triaged
+      card_sent_back_to_triage
+    ]
+
+    created_included = included_card_actions.map do |action|
+      board.events.create!(action: action, creator: creator, eventable: card)
+    end
+    created_included << board.events.create!(action: "comment_created", creator: creator, eventable: comment)
+
+    collection_event = board.events.create!(
+      action: "card_collection_changed",
+      creator: creator,
+      eventable: card,
+      particulars: { particulars: { new_collection: "New" } }
+    )
+    resumed_event = board.events.create!(
+      action: "card_resumed",
+      creator: creator,
+      eventable: card
+    )
+
+    get activities_path, as: :json
+    assert_response :success
+
+    ids = @response.parsed_body.pluck("id")
+    created_included.each do |event|
+      assert_includes ids, event.id, "Expected #{event.action} to be included"
+    end
+    assert_not_includes ids, collection_event.id
+    assert_not_includes ids, resumed_event.id
+  end
+
+  test "particulars for assignment, board, title, triage, and other events" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+
+    assigned_event = board.events.create!(
+      action: "card_assigned",
+      creator: creator,
+      eventable: card,
+      particulars: { assignee_ids: [ users(:jz).id ] }
+    )
+    unassigned_event = board.events.create!(
+      action: "card_unassigned",
+      creator: creator,
+      eventable: card,
+      particulars: { assignee_ids: [ users(:jz).id ] }
+    )
+    board_event = board.events.create!(
+      action: "card_board_changed",
+      creator: creator,
+      eventable: card,
+      particulars: { particulars: { old_board: "Old Board", new_board: "Writebook" } }
+    )
+    title_event = board.events.create!(
+      action: "card_title_changed",
+      creator: creator,
+      eventable: card,
+      particulars: { particulars: { old_title: "Old Title", new_title: "New Title" } }
+    )
+    triage_event = board.events.create!(
+      action: "card_triaged",
+      creator: creator,
+      eventable: card,
+      particulars: { particulars: { column: "In Progress" } }
+    )
+    sent_back_event = board.events.create!(
+      action: "card_sent_back_to_triage",
+      creator: creator,
+      eventable: card
+    )
+    closed_event = board.events.create!(
+      action: "card_closed",
+      creator: creator,
+      eventable: card
+    )
+
+    get activities_path, as: :json
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |e| e["id"] }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id[assigned_event.id]["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, by_id[unassigned_event.id]["particulars"])
+    assert_equal({ "old_board" => "Old Board", "new_board" => "Writebook" }, by_id[board_event.id]["particulars"])
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, by_id[title_event.id]["particulars"])
+    assert_equal({ "column" => "In Progress" }, by_id[triage_event.id]["particulars"])
+    assert_equal({}, by_id[sent_back_event.id]["particulars"])
+    assert_equal({}, by_id[closed_event.id]["particulars"])
+  end
+
+  test "missing board, title, or column values in particulars return empty strings" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+
+    board_event = board.events.create!(action: "card_board_changed", creator: creator, eventable: card, particulars: {})
+    partial_board_event = board.events.create!(action: "card_board_changed", creator: creator, eventable: card, particulars: { particulars: { new_board: "Writebook" } })
+    title_event = board.events.create!(action: "card_title_changed", creator: creator, eventable: card, particulars: {})
+    partial_title_event = board.events.create!(action: "card_title_changed", creator: creator, eventable: card, particulars: { particulars: { old_title: "Old Title" } })
+    triage_event = board.events.create!(action: "card_triaged", creator: creator, eventable: card, particulars: {})
+
+    get activities_path, as: :json
+    assert_response :success
+
+    by_id = @response.parsed_body.index_by { |e| e["id"] }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, by_id[board_event.id]["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "Writebook" }, by_id[partial_board_event.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, by_id[title_event.id]["particulars"])
+    assert_equal({ "old_title" => "Old Title", "new_title" => "" }, by_id[partial_title_event.id]["particulars"])
+    assert_equal({ "column" => "" }, by_id[triage_event.id]["particulars"])
+  end
+
+  test "filters by creator_ids and board_ids" do
+    private_card = boards(:private).cards.create!(title: "Secret card", creator: users(:kevin))
+    private_event = boards(:private).events.create!(action: "card_published", creator: users(:kevin), eventable: private_card)
+
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |activity|
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+    end
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ], creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |activity|
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+    end
+  end
+
+  test "excludes activity from boards the current user cannot access" do
+    private_card = boards(:private).cards.create!(title: "Secret card", creator: users(:kevin))
+    private_event = boards(:private).events.create!(action: "card_published", creator: users(:kevin), eventable: private_card)
+
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+
+    get activities_path, params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "paginates activities" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+
+    30.times do |index|
+      board.events.create!(
+        action: "card_closed",
+        creator: creator,
+        eventable: card,
+        created_at: index.minutes.from_now
+      )
+    end
+
+    expected_ids = users(:kevin).accessible_events.timelineable.reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
