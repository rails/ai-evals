diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..b18f4ab 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,56 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :remember_publication_transition, if: :saved_change_to_published?
+    after_destroy :forget_publication_transitions
   end
 
   private
+    def publication_transitions
+      ActiveSupport::IsolatedExecutionState[:book_publication_transitions] ||= []
+    end
+
+    def remember_publication_transition
+      transition = { book_id: id, from: published_before_last_save, to: published? }
+      publication_transitions << transition
+
+      self.class.current_transaction.after_rollback do
+        rollback_publication_transition(transition)
+      end
+
+      self.class.current_transaction.after_commit do
+        transitions = publication_transitions.extract! { it[:book_id] == id }
+
+        if transitions.any? && !transitions.first[:from] && transitions.last[:to]
+          announce_publication
+        end
+      end
+    end
+
+    def forget_publication_transitions
+      return unless publication_transitions.any? { it[:book_id] == id }
+
+      transition = { book_id: id, from: published?, to: false }
+      publication_transitions << transition
+
+      self.class.current_transaction.after_rollback do
+        rollback_publication_transition(transition)
+      end
+    end
+
+    def rollback_publication_transition(transition)
+      if index = publication_transitions.find_index { it.equal?(transition) }
+        publication_transitions.slice!(index..).each do |rolled_back|
+          publication_transitions << rolled_back unless rolled_back[:book_id] == id
+        end
+
+        unless frozen?
+          self.published = transition[:from]
+          clear_attribute_change(:published)
+        end
+      end
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
