+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "show with pending authentication token" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      get session_magic_link_path
+
+      assert_response :success
+      assert_in_body identities(:kevin).email_address
+    end
+  end
+
+  test "show without pending authentication token redirects to new session" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create with valid sign in code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      magic_link = identity.magic_links.last
+
+      assert_difference -> { Session.count }, 1 do
+        assert_difference -> { MagicLink.count }, -1 do
+          post session_magic_link_path, params: { code: magic_link.code }
+        end
+      end
+
+      assert_redirected_to landing_url
+      assert parsed_cookies.signed[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create with valid sign up code redirects to signup completion" do
+    untenanted do
+      post signup_path, params: { signup: { email_address: "newuser@example.com" } }
+      magic_link = MagicLink.last
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_signup_completion_path
+      assert parsed_cookies.signed[:session_token].present?
+    end
+  end
+
+  test "create with invalid code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "WRONGC" }
+      end
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with expired code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      magic_link = identity.magic_links.last
+
+      travel 15.minutes + 1.second do
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: { code: magic_link.code }
+        end
+
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create with code that belongs to another email address" do
+    kevins_magic_link = identities(:kevin).send_magic_link
+
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: kevins_magic_link.code }
+      end
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+      assert_response :created
+      assert @response.parsed_body["pending_authentication_token"].present?
+
+      magic_link = identity.magic_links.last
+      post session_magic_link_path(format: :json), params: { code: magic_link.code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create via JSON with invalid code" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: identities(:kevin).email_address }
+      post session_magic_link_path(format: :json), params: { code: "WRONGC" }
+
+      assert_response :unauthorized
+    end
+  end
+end
