diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..ea0fae9
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,43 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ], prefix: :for, default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ..Time.current) }
+
+  before_validation :generate_code, on: :create
+  before_validation :set_expires_at, on: :create
+
+  validates :code, uniqueness: true, presence: true
+
+  class << self
+    def consume(code)
+      active.find_by(code: Code.sanitize(code))&.consume
+    end
+
+    def cleanup
+      stale.in_batches.delete_all
+    end
+  end
+
+  def consume
+    destroy
+    self
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expires_at
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..a4fa3af
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,23 @@
+module MagicLink::Code
+  CODE_SUBSTITUTIONS = { "O" => "0", "I" => "1", "L" => "1" }.freeze
+
+  class << self
+    def generate(length)
+      SecureRandom.base36(length).upcase.then { |code| substitute(code) }
+    end
+
+    def sanitize(code)
+      if code.present?
+        code.to_s
+          .upcase
+          .then { |code| substitute(code) }
+          .gsub(/[^A-Z0-9]/, "")
+      end
+    end
+
+    private
+      def substitute(code)
+        CODE_SUBSTITUTIONS.reduce(code) { |result, (from, to)| result.gsub(from, to) }
+      end
+  end
+end
