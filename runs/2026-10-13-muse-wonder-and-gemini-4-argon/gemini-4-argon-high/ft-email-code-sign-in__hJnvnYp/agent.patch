@@ -0,0 +1,33 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] || flash[:shake] %>">
+  <header>
+    <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+    <p class="margin-block-start-half margin-none-block-end">Then enter the verification code included in the email we just sent you.</p>
+  </header>
+
+  <%= form_with url: session_magic_link_path, method: :post, class: "flex flex-column gap-half", data: { controller: "magic-link" } do |form| %>
+    <%= form.text_field :code, required: true, class: "input txt-large center",
+        autofocus: true, autocorrect: "off", autocapitalize: "characters", spellcheck: "false",
+        autocomplete: "one-time-code", maxlength: MagicLink::CODE_LENGTH, placeholder: "••••••", value: params[:code],
+        data: { "1p-ignore": true, action: "keydown.enter->magic-link#submitOnEnter input->magic-link#submitOnPaste" } %>
+
+    <p class="txt-small txt-subtle">The code sent to <strong><%= email_address_pending_authentication %></strong> will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% if Rails.env.development? && flash[:magic_link_code].present? %>
+  <div class="flex align-center justify-center gap fill-shade pad border-radius margin-block-start" style="max-inline-size: 42ch; margin-inline: auto;">
+    <span class="txt-small">Psst, here's your code:</span>
+    <code class="txt-medium font-weight-black"><%= flash[:magic_link_code] %></code>
+  </div>
+<% end %>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
