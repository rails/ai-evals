diff --git a/test/models/magic_link/code_test.rb b/test/models/magic_link/code_test.rb
new file mode 100644
index 0000000..5f6dca9
--- /dev/null
+++ b/test/models/magic_link/code_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class MagicLink::CodeTest < ActiveSupport::TestCase
+  test "generate returns uppercase code of given length without ambiguous characters" do
+    100.times do
+      code = MagicLink::Code.generate(6)
+      assert_equal 6, code.length
+      assert_match(/\A[A-Z0-9]{6}\z/, code)
+      assert_no_match(/[OIL]/, code)
+    end
+  end
+
+  test "sanitize normalizes case, substitutes ambiguous characters, and strips non-alphanumeric" do
+    assert_equal "ABC123", MagicLink::Code.sanitize("abc-123")
+    assert_equal "011234", MagicLink::Code.sanitize("o i l 2 3 4")
+    assert_nil MagicLink::Code.sanitize(nil)
+    assert_nil MagicLink::Code.sanitize("")
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..c954a7e
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "create generates code and sets expiration" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    assert_equal MagicLink::CODE_LENGTH, magic_link.code.length
+    assert_in_delta MagicLink::EXPIRATION_TIME.from_now, magic_link.expires_at, 5.seconds
+    assert magic_link.for_sign_in?
+  end
+
+  test "consume with valid code destroys and returns magic link" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    consumed = nil
+    assert_difference -> { MagicLink.count }, -1 do
+      consumed = MagicLink.consume(magic_link.code)
+    end
+
+    assert_equal magic_link, consumed
+    assert_predicate consumed, :destroyed?
+  end
+
+  test "consume sanitizes code" do
+    magic_link = MagicLink.create!(identity: identities(:kevin), code: "101234")
+
+    assert_difference -> { MagicLink.count }, -1 do
+      consumed = MagicLink.consume(" l-o-i 234 ")
+      assert_equal magic_link, consumed
+    end
+  end
+
+  test "consume with invalid code returns nil" do
+    MagicLink.create!(identity: identities(:kevin))
+
+    assert_no_difference -> { MagicLink.count } do
+      assert_nil MagicLink.consume("INVALID")
+    end
+  end
+
+  test "consume with expired code returns nil and does not destroy it" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    travel MagicLink::EXPIRATION_TIME + 1.second do
+      assert_no_difference -> { MagicLink.count } do
+        assert_nil MagicLink.consume(magic_link.code)
+      end
+    end
+  end
+
+  test "cannot reuse consumed code" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    assert_not_nil MagicLink.consume(magic_link.code)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "cleanup deletes stale magic links" do
+    active_link = MagicLink.create!(identity: identities(:kevin))
+    stale_link = MagicLink.create!(identity: identities(:david), expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active_link.id)
+    assert_not MagicLink.exists?(stale_link.id)
+  end
+end
