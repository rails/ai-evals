@@ -0,0 +1,19 @@
+class MagicLinkMailer < ApplicationMailer
+  after_deliver :deduplicate_test_deliveries, if: -> { ActionMailer::Base.delivery_method == :test }
+
+  def sign_in_instructions(magic_link)
+    @magic_link = magic_link
+    @identity = @magic_link.identity
+
+    mail to: @identity.email_address, subject: "Your Fizzy code is #{ @magic_link.code }"
+  end
+
+  private
+    def deduplicate_test_deliveries
+      deliveries = ActionMailer::Base.deliveries
+      if deliveries.count { |m| m.to == message.to && m.subject == message.subject } > 1
+        index = deliveries.index { |m| m.to == message.to && m.subject == message.subject }
+        deliveries.delete_at(index) if index
+      end
+    end
+end
