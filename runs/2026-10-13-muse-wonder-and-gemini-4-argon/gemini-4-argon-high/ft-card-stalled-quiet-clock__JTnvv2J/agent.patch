diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..55d4fee
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,63 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER_LAST_SPIKE_PERIOD = 2.weeks
+  SPIKE_COMMENTS_MIN_COUNT = 3
+  SPIKE_COMMENTS_MIN_USERS = 2
+
+  included do
+    has_one :activity_spike, dependent: :destroy, class_name: "Card::ActivitySpike"
+
+    after_update :detect_activity_spike, if: :saved_change_to_last_active_at?
+
+    scope :stalled, -> { active.joins(:activity_spike).where(last_active_at: ..STALLED_AFTER_LAST_SPIKE_PERIOD.ago) }
+  end
+
+  def stalled?
+    active? && activity_spike.present? && last_active_at <= STALLED_AFTER_LAST_SPIKE_PERIOD.ago
+  end
+
+  def last_activity_spike_at
+    activity_spike&.updated_at
+  end
+
+  def detect_activity_spike
+    if should_spike_activity?
+      create_or_update_activity_spike
+    elsif activity_spike.present?
+      activity_spike.update!(updated_at: last_active_at)
+    end
+  end
+
+  private
+    def should_spike_activity?
+      @just_spiked || last_event_spiked_activity? || multiple_people_commented?
+    ensure
+      @just_spiked = false
+    end
+
+    def last_event_spiked_activity?
+      events.exists?(action: %w[ card_assigned card_reopened ], created_at: 5.seconds.ago..)
+    end
+
+    def multiple_people_commented?
+      comments
+        .by_user
+        .where(created_at: comment_spike_window)
+        .group(:card_id)
+        .having("COUNT(DISTINCT creator_id) >= ? AND COUNT(*) >= ?", SPIKE_COMMENTS_MIN_USERS, SPIKE_COMMENTS_MIN_COUNT)
+        .exists?
+    end
+
+    def comment_spike_window
+      (auto_postpone_period / 3).seconds.ago..
+    end
+
+    def create_or_update_activity_spike
+      if activity_spike
+        activity_spike.update!(updated_at: last_active_at)
+      else
+        create_activity_spike!(created_at: last_active_at, updated_at: last_active_at)
+      end
+    end
+end
