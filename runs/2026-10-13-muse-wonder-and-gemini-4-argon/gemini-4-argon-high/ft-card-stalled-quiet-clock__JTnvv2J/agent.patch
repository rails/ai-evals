diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..c283438
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "detects activity spikes when multiple people comment within a third of auto-postpone period" do
+    # cards(:logo) already has 2 comments from jz (2 days ago) and kevin (2 hours ago)
+    assert_changes -> { cards(:logo).reload.last_activity_spike_at }, from: nil do
+      cards(:logo).comments.create!(body: "Agreed!")
+    end
+  end
+
+  test "does not detect activity spike when only one person comments multiple times" do
+    # cards(:layout) has 1 comment from david
+    assert_no_changes -> { cards(:layout).reload.last_activity_spike_at } do
+      cards(:layout).comments.create!(creator: users(:david), body: "Another comment from David")
+      cards(:layout).comments.create!(creator: users(:david), body: "A third comment from David")
+    end
+  end
+
+  test "system comments do not count towards activity spikes" do
+    # cards(:logo) has 3 system comments and 2 user comments
+    assert_no_changes -> { cards(:logo).reload.last_activity_spike_at } do
+      cards(:logo).comments.create!(creator: accounts("37s").system_user, body: "System comment")
+      cards(:logo).touch_last_active_at
+    end
+  end
+
+  test "comments outside a third of the board auto-close period do not count towards activity spikes" do
+    card = cards(:text)
+    period_third = (card.auto_postpone_period / 3).seconds
+
+    card.comments.create!(creator: users(:david), body: "First comment")
+    card.comments.create!(creator: users(:kevin), body: "Second comment")
+
+    travel period_third + 1.day
+
+    assert_no_changes -> { card.reload.last_activity_spike_at } do
+      card.comments.create!(creator: users(:david), body: "Too late for a burst")
+    end
+  end
+
+  test "detects activity spike when someone is assigned" do
+    assert_changes -> { cards(:text).reload.last_activity_spike_at }, from: nil do
+      cards(:text).toggle_assignment(users(:kevin))
+    end
+  end
+
+  test "does not detect activity spike when someone is unassigned" do
+    assert_no_changes -> { cards(:logo).reload.last_activity_spike_at } do
+      cards(:logo).toggle_assignment(users(:kevin))
+    end
+  end
+
+  test "detects activity spike when a card is reopened" do
+    assert cards(:shipping).closed?
+
+    assert_changes -> { cards(:shipping).reload.last_activity_spike_at }, from: nil do
+      cards(:shipping).reopen
+    end
+  end
+
+  test "a card with a spike and no activity for two weeks is stalled" do
+    card = cards(:text)
+    card.toggle_assignment(users(:kevin))
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 13.days
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 2.days
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "a card without a spike is not stalled even after two weeks of inactivity" do
+    card = cards(:text)
+
+    travel 3.weeks
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "any activity on a stalled card resets it" do
+    card = cards(:text)
+    card.toggle_assignment(users(:kevin))
+
+    travel 3.weeks
+    assert card.stalled?
+    assert_includes Card.stalled, card
+
+    card.comments.create!(body: "Back on this")
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "closed or postponed cards are not stalled" do
+    card = cards(:text)
+    card.toggle_assignment(users(:kevin))
+
+    travel 3.weeks
+    assert card.stalled?
+
+    card.close
+    travel 3.weeks
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    card.postpone
+    travel 3.weeks
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+end
