diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..7721a89
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    due_account = accounts("37s")
+    recent_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    travel_to 31.days.ago do
+      due_account.cancel(initiated_by: users(:david))
+    end
+
+    travel_to 29.days.ago do
+      recent_account.cancel(initiated_by: users(:mike))
+    end
+
+    assert_changes -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..fae7b0f
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration finds accounts cancelled before grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_empty Account.due_for_incineration
+    assert_not @account.due_for_incineration?
+
+    travel 31.days
+
+    assert_equal [ @account ], Account.due_for_incineration
+    assert @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days
+
+    @account.reactivate
+    @account.reload
+
+    assert_empty Account.due_for_incineration
+    assert_not @account.due_for_incineration?
+  end
+
+  test "incinerate destroys account and all associated data" do
+    cards(:logo).image.attach io: StringIO.new("x" * 1024), filename: "test.png", content_type: "image/png"
+    @account.materialize_storage
+    @account.cancel(initiated_by: @user)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+    assert_not Account::JoinCode.exists?(account_id: @account.id)
+    assert_not Board.exists?(account_id: @account.id)
+    assert_not Card.exists?(account_id: @account.id)
+    assert_not Comment.exists?(account_id: @account.id)
+    assert_not Event.exists?(account_id: @account.id)
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not Storage::Total.exists?(owner: @account)
+    assert_not Tag.exists?(account_id: @account.id)
+    assert_not User.exists?(account_id: @account.id)
+    assert_not Webhook.exists?(account_id: @account.id)
+  end
+end
