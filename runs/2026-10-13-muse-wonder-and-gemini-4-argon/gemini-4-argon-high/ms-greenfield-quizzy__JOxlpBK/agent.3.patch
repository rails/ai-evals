+<% if @game.finished? %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= @player ? "Hi, #{@player.name}!" : @quiz.title %></span>
+    </div>
+    <div class="play__body">
+      <div class="card result-card">
+        <h1 class="play-title">The quiz is over</h1>
+      </div>
+    </div>
+  </div>
+<% elsif @player.nil? %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= @quiz.title %></span>
+    </div>
+    <div class="play__body">
+      <h1 class="play-title"><%= @quiz.title %></h1>
+      <% if @join_error.present? %>
+        <div class="errors"><%= @join_error %></div>
+      <% end %>
+      <%= form_with url: play_join_path(@game.code), method: :post, class: "join-form", data: { join_form: true } do %>
+        <div class="field" style="margin-bottom: 0">
+          <label for="player_name" class="field-label">Your name</label>
+          <input type="text"
+                 name="name"
+                 id="player_name"
+                 class="input"
+                 placeholder="Your name"
+                 aria-label="Your name"
+                 required
+                 autofocus>
+        </div>
+        <button type="submit" class="btn btn--pink">Join</button>
+      <% end %>
+    </div>
+  </div>
+<% elsif @game.waiting? %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span><%= @quiz.title %></span>
+    </div>
+    <div class="play__body">
+      <div class="waiting">
+        <div class="waiting__gem">?</div>
+        <h1 class="play-title">Hi, <%= @player.name %>!</h1>
+        <p class="play-lead">Waiting for the quiz to start…</p>
+      </div>
+    </div>
+  </div>
+<% elsif @game.question_open? && @question %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span>Hi, <%= @player.name %>!</span>
+    </div>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+      <div class="play-options">
+        <% @options.each_with_index do |option, idx| %>
+          <% letter = ("A".ord + idx).chr %>
+          <% picked = (@selected_option_id == option.id) %>
+          <%= form_with url: play_answer_path(@game.code), method: :post, data: { answer_form: true } do %>
+            <input type="hidden" name="option_id" value="<%= option.id %>">
+            <button type="submit"
+                    class="play-option <%= 'is-picked' if picked %>"
+                    title="<%= option.title %>"
+                    data-option-id="<%= option.id %>">
+              <span class="play-option__letter"><%= letter %></span>
+              <span class="play-option__title"><%= option.title %></span>
+              <% if picked %>
+                <span class="play-option__mark">Your answer</span>
+              <% end %>
+            </button>
+          <% end %>
+        <% end %>
+      </div>
+    </div>
+  </div>
+<% elsif @game.question_closed? && @question %>
+  <div class="play">
+    <div class="play__top">
+      <span class="logo play__logo"><span class="logo__mark">?</span>Quizzy</span>
+      <span>Hi, <%= @player.name %>!</span>
+    </div>
+    <div class="play__body play__body--top">
+      <div class="play-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+      <div class="play-question__body"><%= @question.body %></div>
+      <div class="play-options is-locked is-revealed">
+        <% @options.each_with_index do |option, idx| %>
+          <% letter = ("A".ord + idx).chr %>
+          <% picked = (@selected_option_id == option.id) %>
+          <button type="button"
+                  disabled
+                  title="<%= option.title %>"
+                  class="play-option <%= 'is-picked' if picked %> <%= 'is-correct' if option.correct? %>">
+            <span class="play-option__letter"><%= letter %></span>
+            <span class="play-option__title"><%= option.title %></span>
+            <% if picked %>
+              <span class="play-option__mark">Your answer</span>
+            <% end %>
+          </button>
+        <% end %>
+      </div>
+      <% if @selected_option.nil? %>
+        <div class="play-status play-status--neutral">No answer</div>
+      <% elsif @selected_option.correct? %>
+        <div class="play-status play-status--right">Correct!</div>
+      <% else %>
+        <div class="play-status play-status--wrong">Wrong!</div>
+      <% end %>
+    </div>
+  </div>
+<% end %>
