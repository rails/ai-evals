+<% if @game.waiting? %>
+  <section class="cover cover--pink">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+      <div class="screen__body">
+        <div class="lobby">
+          <div>
+            <h1 class="lobby__title"><%= @quiz.title %></h1>
+            <div class="lobby__join">Join at</div>
+            <div class="lobby__url"><%= @join_url %></div>
+            <div class="counter-pill" data-role="players-counter">Players: <%= @players_count %></div>
+          </div>
+          <div class="qr">
+            <%= qr_code_svg(@join_url) %>
+          </div>
+        </div>
+      </div>
+    </div>
+  </section>
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+    </div>
+    <div class="buttons">
+      <%= button_to "Start", start_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg" %>
+    </div>
+  </div>
+<% elsif @game.question_open? && @question %>
+  <section class="cover cover--blue cover--calm">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+      <div class="screen__body">
+        <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+        <div class="stage-question__body"><%= @question.body %></div>
+        <ol class="stage-options">
+          <% @options.each_with_index do |option, idx| %>
+            <% letter = ("A".ord + idx).chr %>
+            <li class="stage-option">
+              <span class="stage-option__letter"><%= letter %></span>
+              <span class="stage-option__title"><%= option.title %></span>
+            </li>
+          <% end %>
+        </ol>
+      </div>
+    </div>
+  </section>
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+      <span class="answers-counter" data-role="answers-counter">Answers: <%= @answers_count %> / <%= @players_count %></span>
+    </div>
+    <div class="buttons">
+      <%= button_to "Finish", finish_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg" %>
+    </div>
+  </div>
+<% elsif @game.question_closed? && @question %>
+  <section class="cover cover--blue cover--calm">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+      <div class="screen__body">
+        <div class="stage-question__num">Question <%= @question_number %> of <%= @total_questions %></div>
+        <div class="stage-question__body"><%= @question.body %></div>
+        <ol class="stage-options stage-options--results">
+          <% @options.each_with_index do |option, idx| %>
+            <% letter = ("A".ord + idx).chr %>
+            <% count = @option_counts[option.id] || 0 %>
+            <% share = @answers_count > 0 ? ((count.to_f / @answers_count) * 100).round : 0 %>
+            <li class="stage-option <%= 'is-correct' if option.correct? %>">
+              <span class="stage-option__bar" style="--share: <%= share %>%"></span>
+              <span class="stage-option__letter"><%= letter %></span>
+              <span class="stage-option__title"><%= option.title %></span>
+              <% if option.correct? %>
+                <span class="stage-option__mark">Correct</span>
+              <% end %>
+              <span class="stage-option__count"><%= count %></span>
+            </li>
+          <% end %>
+        </ol>
+      </div>
+    </div>
+  </section>
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+      <span class="answers-counter" data-role="answers-counter">Answers: <%= @answers_count %> / <%= @players_count %></span>
+    </div>
+    <div class="buttons">
+      <% if @is_last_question %>
+        <%= button_to "End quiz", end_quiz_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg" %>
+      <% else %>
+        <%= button_to "Next", next_question_moderate_quiz_game_path(@quiz, @game), method: :post, class: "btn btn--pink btn--lg" %>
+      <% end %>
+    </div>
+  </div>
+<% else %>
+  <section class="cover cover--night">
+    <div class="screen">
+      <div class="screen__top">
+        <span class="logo screen__logo"><span class="logo__mark">?</span>Quizzy</span>
+        <span><%= @quiz.title %></span>
+      </div>
+      <div class="screen__body">
+        <h1 class="lobby__title">The quiz is over</h1>
+      </div>
+    </div>
+  </section>
+  <div class="screen-controls">
+    <div class="screen-controls__info">
+      <%= link_to "← Back to quiz", moderate_quiz_path(@quiz) %>
+    </div>
+    <div class="buttons"></div>
+  </div>
+<% end %>
