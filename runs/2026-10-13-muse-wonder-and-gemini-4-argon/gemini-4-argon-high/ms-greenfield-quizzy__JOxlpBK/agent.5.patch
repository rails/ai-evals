+  test "timer settings default to 0, are excluded from export, and 0:00 means no timer" do
+    visit "/moderate"
+    click_on "New quiz"
+
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+
+    fill_in "Title", with: "No Timer Talk"
+    click_on "Save quiz"
+
+    quiz = Quiz.find_by!(title: "No Timer Talk")
+    assert_equal 0, quiz.timer_minutes
+    assert_equal 0, quiz.timer_seconds
+    assert_not quiz.timer_enabled?
+
+    q1 = quiz.questions.create!(body: "Untimed question?", active: true, position: 1)
+    q1.options.create!(title: "Yes", correct: true, position: 1)
+    q1.options.create!(title: "No", correct: false, position: 2)
+
+    visit moderate_quiz_path(quiz)
+    click_on "Start a game"
+    click_on "Start"
+
+    assert_text "Question 1 of 1"
+    assert_text "Untimed question?"
+    assert_no_selector '[data-role="question-timer"]'
+    assert_no_match(/\b\d+:\d{2}\b/, page.text)
+
+    # Update timer in Settings to 1 minute 30 seconds
+    visit moderate_quiz_path(quiz)
+    click_on "Settings"
+
+    assert_field "Timer minutes", with: "0"
+    assert_field "Timer seconds", with: "0"
+
+    fill_in "Timer minutes", with: "-1"
+    click_on "Save quiz"
+    assert_text "Timer minutes"
+
+    fill_in "Timer minutes", with: "1"
+    fill_in "Timer seconds", with: "30"
+    click_on "Save quiz"
+
+    quiz.reload
+    assert_equal 1, quiz.timer_minutes
+    assert_equal 30, quiz.timer_seconds
+    assert quiz.timer_enabled?
+    assert_equal 90, quiz.timer_total_seconds
+
+    click_on "Settings"
+    assert_field "Timer minutes", with: "1"
+    assert_field "Timer seconds", with: "30"
+    click_on "Cancel"
+
+    # Export does NOT include timer settings
+    click_on "Export"
+    exported = JSON.parse(find("pre").text)
+    assert_equal [ "title", "questions" ], exported.keys
+    assert_nil exported["timer_minutes"]
+    assert_nil exported["timer_seconds"]
+  end
+
+  test "timer countdown on big screen, hidden from players, survives reload, allows early Finish, and auto-finishes at 0:00" do
+    quiz = Quiz.create!(title: "Lightning Talk Quiz", timer_minutes: 1, timer_seconds: 30)
+
+    q1 = quiz.questions.create!(body: "First timed question?", active: true, position: 1)
+    q1.options.create!(title: "Option 1A", correct: true, position: 1)
+    q1.options.create!(title: "Option 1B", correct: false, position: 2)
+
+    q2 = quiz.questions.create!(body: "Second timed question?", active: true, position: 2)
+    q2.options.create!(title: "Option 2A", correct: false, position: 1)
+    q2.options.create!(title: "Option 2B", correct: true, position: 2)
+
+    visit moderate_quiz_path(quiz)
+    click_on "Start a game"
+    join_url = page.find(".lobby__url").text.strip
+
+    Capybara.using_session(:alice) do
+      Capybara.current_driver = :cuprite_test
+      visit join_url
+      fill_in "Your name", with: "Alice"
+      click_on "Join"
+      assert_text "Hi, Alice!"
+    end
+
+    Capybara.using_session(:bob) do
+      Capybara.current_driver = :cuprite_test
+      visit join_url
+      fill_in "Your name", with: "Bob"
+      click_on "Join"
+      assert_text "Hi, Bob!"
+    end
+
+    assert_text "Players: 2"
+
+    # Question 1 opens with 1:30 timer
+    click_on "Start"
+    assert_text "Question 1 of 2"
+    assert_text "First timed question?"
+    assert_text "1:30"
+
+    # Players do NOT see the timer
+    Capybara.using_session(:alice) do
+      assert_text "First timed question?"
+      assert_no_text "1:30"
+      assert_no_text "1:29"
+      assert_no_selector '[data-role="question-timer"]'
+      click_on "Option 1A"
+    end
+
+    assert_text "Answers: 1 / 2"
+
+    # Moderator can click Finish earlier than 0:00
+    click_on "Finish"
+    assert_button "Next"
+    assert_no_button "Finish"
+    assert_no_selector '[data-role="question-timer"]'
+    within(find("li", text: "Option 1A")) do
+      assert_text "1"
+      assert_text "Correct"
+    end
+
+    Capybara.using_session(:alice) { assert_text "Correct!" }
+    Capybara.using_session(:bob) { assert_text "No answer" }
+
+    # Now set timer to 0 minutes, 3 seconds for Question 2 to test reload and auto-finish at 0:00
+    quiz.update!(timer_minutes: 0, timer_seconds: 3)
+
+    click_on "Next"
+    assert_text "Question 2 of 2"
+    assert_text "Second timed question?"
+    assert_text "0:03"
+
+    # Players do not see the timer on Question 2 either
+    Capybara.using_session(:alice) do
+      assert_text "Second timed question?"
+      assert_no_text "0:03"
+      assert_no_text "0:02"
+      click_on "Option 2B"
+    end
+    Capybara.using_session(:bob) do
+      assert_text "Second timed question?"
+      click_on "Option 2A"
+    end
+
+    # Wait ~1.2s so countdown ticks down, then reload moderator page -> does not restart at 0:03
+    sleep 1.2
+    visit current_path
+    assert_text "Second timed question?"
+    assert_no_text "0:03"
+    assert_match(/\b0:0[12]\b/, find('[data-role="question-timer"]').text)
+
+    # At 0:00, the question finishes by itself as if moderator clicked Finish
+    assert_button "End quiz", wait: 5
+    assert_no_button "Finish"
+    assert_no_selector '[data-role="question-timer"]'
+
+    within(find("li", text: "Option 2B")) do
+      assert_text "1"
+      assert_text "Correct"
+    end
+    within(find("li", text: "Option 2A")) do
+      assert_text "1"
+      assert_no_text "Correct"
+    end
+
+    # Players also see the closed question results live
+    Capybara.using_session(:alice) { assert_text "Correct!" }
+    Capybara.using_session(:bob) { assert_text "Wrong!" }
+  end
 end
