--- /dev/null
+++ b/spec/support/paperclip.rb
@@ -0,0 +1,53 @@
+# frozen_string_literal: true
+
+module PaperclipTestOptimization
+  mattr_accessor :skip_post_processing, default: false
+
+  def post_process(*style_args)
+    if PaperclipTestOptimization.skip_post_processing
+      return if @queued_for_write[:original].nil?
+
+      check_validity? if @options[:check_validity_before_processing]
+      return
+    end
+
+    super
+  end
+
+  def flush_writes
+    if PaperclipTestOptimization.skip_post_processing
+      @queued_for_write = {}
+      return
+    end
+
+    super
+  end
+end
+
+Paperclip::Attachment.prepend(PaperclipTestOptimization)
+
+module MediaAttachmentTestOptimization
+  private
+
+  def check_video_dimensions
+    return if PaperclipTestOptimization.skip_post_processing
+
+    super
+  end
+end
+
+MediaAttachment.prepend(MediaAttachmentTestOptimization)
+
+RSpec.configure do |config|
+  config.before(:context) do |context|
+    PaperclipTestOptimization.skip_post_processing = context.class.metadata[:type] == :model && !context.class.metadata[:paperclip_processing]
+  end
+
+  config.around do |example|
+    previous = PaperclipTestOptimization.skip_post_processing
+    PaperclipTestOptimization.skip_post_processing = example.metadata[:type] == :model && !example.metadata[:paperclip_processing]
+    example.run
+  ensure
+    PaperclipTestOptimization.skip_post_processing = previous
+  end
+end
