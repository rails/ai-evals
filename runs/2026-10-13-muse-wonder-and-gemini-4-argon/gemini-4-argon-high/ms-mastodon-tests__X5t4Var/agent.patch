+  PARSED_PRIVATE_RSA_TEST_KEY = OpenSSL::PKey.read(PRIVATE_RSA_TEST_KEY)
+
   def private_key_from_keypair(keypair)
     case keypair.public_key
     when PUBLIC_RSA_TEST_KEY
-      OpenSSL::PKey.read(PRIVATE_RSA_TEST_KEY)
