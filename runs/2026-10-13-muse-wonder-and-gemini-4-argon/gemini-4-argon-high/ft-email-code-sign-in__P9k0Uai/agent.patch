@@ -0,0 +1,32 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <header>
+    <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+    <p class="margin-block-start margin-block-end-half">Then enter the verification code included in the email below:</p>
+  </header>
+
+  <%= form_with url: session_magic_link_path(script_name: nil), method: :post, html: { class: "flex flex-column gap-half", data: { controller: "magic-link" } } do |form| %>
+    <%= form.text_field :code, required: true, class: "input center",
+        autofocus: true, autocorrect: "off", autocapitalize: "off", spellcheck: "false",
+        autocomplete: "one-time-code", maxlength: "6", placeholder: "••••••", value: params[:code],
+        data: { "1p-ignore": true, action: "keydown.enter->magic-link#submitOnEnter paste->magic-link#submitOnPaste" } %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle">The code sent to <strong><%= email_address_pending_authentication %></strong> will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+</div>
+
+<% if Rails.env.development? && flash[:magic_link_code].present? %>
+  <div class="flex align-center justify-center gap fill-shade pad border-radius" style="max-width: 42ch; margin-inline: auto;">
+    <span class="txt-small">Psst, here's your code: <code class="font-weight-bold"><%= flash[:magic_link_code] %></code></span>
+  </div>
+<% end %>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
