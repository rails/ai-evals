diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..09134ca
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates 6-character code and sets 15-minute expiration on create" do
+    freeze_time do
+      magic_link = MagicLink.create!(identity: identities(:kevin))
+
+      assert_equal 6, magic_link.code.length
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert_predicate magic_link, :for_sign_in?
+    end
+  end
+
+  test "consume returns and destroys active magic link" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    consumed = MagicLink.consume(magic_link.code)
+
+    assert_equal magic_link, consumed
+    assert_predicate consumed, :destroyed?
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume sanitizes code" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+    formatted_code = " #{magic_link.code.downcase.insert(3, "-")} "
+
+    consumed = MagicLink.consume(formatted_code)
+
+    assert_equal magic_link, consumed
+    assert_predicate consumed, :destroyed?
+  end
+
+  test "consume does not return expired magic link" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume works within 15 minutes" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    travel 14.minutes do
+      assert_equal magic_link, MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "cleanup deletes stale magic links" do
+    active_link = MagicLink.create!(identity: identities(:kevin))
+    stale_link = MagicLink.create!(identity: identities(:david), expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active_link.id)
+    assert_not MagicLink.exists?(stale_link.id)
+  end
+end
