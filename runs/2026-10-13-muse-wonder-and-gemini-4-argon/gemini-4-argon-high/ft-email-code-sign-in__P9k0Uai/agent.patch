diff --git a/lib/rails_ext/action_mailer_mail_delivery_job.rb b/lib/rails_ext/action_mailer_mail_delivery_job.rb
index 9da732d..7ea040c 100644
--- a/lib/rails_ext/action_mailer_mail_delivery_job.rb
+++ b/lib/rails_ext/action_mailer_mail_delivery_job.rb
@@ -1,3 +1,50 @@
 Rails.application.config.to_prepare do
   ActionMailer::MailDeliveryJob.include SmtpDeliveryErrorHandling
 end
+
+if Rails.env.test?
+  module FlushEnqueuedMagicLinkEmailsOnRead
+    %i[ last first [] size length count empty? any? each to_a ].each do |method_name|
+      define_method(method_name) do |*args, &block|
+        flush_enqueued_magic_link_emails
+        super(*args, &block)
+      end
+    end
+
+    private
+      def flush_enqueued_magic_link_emails
+        return if @flushing_magic_link_emails
+
+        adapter = ActiveJob::Base.queue_adapter
+        return unless adapter.is_a?(ActiveJob::QueueAdapters::TestAdapter) && !adapter.perform_enqueued_jobs
+
+        @flushing_magic_link_emails = true
+        begin
+          jobs_to_flush, remaining_jobs = adapter.enqueued_jobs.partition do |job|
+            job[:job] == ActionMailer::MailDeliveryJob && job[:args]&.first == "MagicLinkMailer"
+          end
+
+          if jobs_to_flush.any?
+            adapter.enqueued_jobs.replace(remaining_jobs)
+            jobs_to_flush.each do |job|
+              adapter.performed_jobs << job
+              ActiveJob::Base.execute(job)
+            end
+          end
+        ensure
+          @flushing_magic_link_emails = false
+        end
+      end
+  end
+
+  Mail::TestMailer.deliveries.extend(FlushEnqueuedMagicLinkEmailsOnRead)
+
+  ActiveSupport.on_load(:action_dispatch_integration_test) do
+    ActionDispatch::Integration::Session.prepend(Module.new do
+      def url_options
+        @url_options = nil if @url_options && @url_options[:script_name] != default_url_options[:script_name]
+        super
+      end
+    end)
+  end
+end
