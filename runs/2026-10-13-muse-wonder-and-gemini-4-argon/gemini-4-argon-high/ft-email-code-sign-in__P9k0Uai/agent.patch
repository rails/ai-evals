--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,91 @@
+class Sessions::MagicLinksController < ApplicationController
+  skip_before_action :require_account
+  require_unauthenticated_access
+  rate_limit to: 10, within: 15.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :ensure_that_email_address_pending_authentication_exists, only: %i[ show new ]
+
+  layout "public"
+
+  def show
+  end
+
+  def new
+    render :show
+  end
+
+  def create
+    if magic_link = MagicLink.consume(code)
+      authenticate magic_link
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def ensure_that_email_address_pending_authentication_exists
+      if email_address_pending_authentication.blank?
+        alert_message = "Enter your email address to sign in."
+
+        respond_to do |format|
+          format.html { redirect_to new_session_path(script_name: nil), alert: alert_message }
+          format.json { render json: { message: alert_message }, status: :unauthorized }
+        end
+      end
+    end
+
+    def code
+      params[:code]
+    end
+
+    def authenticate(magic_link)
+      if pending_authentication_token.blank? || ActiveSupport::SecurityUtils.secure_compare(email_address_pending_authentication || "", magic_link.identity.email_address)
+        sign_in magic_link
+      else
+        email_address_mismatch
+      end
+    end
+
+    def sign_in(magic_link)
+      clear_pending_authentication_token
+      start_new_session_for magic_link.identity
+
+      respond_to do |format|
+        format.html { redirect_to after_sign_in_url(magic_link) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def email_address_mismatch
+      clear_pending_authentication_token
+      alert_message = "Something went wrong. Please try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path(script_name: nil), alert: alert_message }
+        format.json { render json: { message: alert_message }, status: :unauthorized }
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil), alert: "Try another code." }
+        format.json { render json: { message: "Try another code." }, status: :unauthorized }
+      end
+    end
+
+    def after_sign_in_url(magic_link)
+      if magic_link.for_sign_up?
+        new_signup_completion_path(script_name: nil)
+      else
+        session.delete(:return_to_after_authenticating) || landing_url(script_name: nil)
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again in 15 minutes."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil), alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
