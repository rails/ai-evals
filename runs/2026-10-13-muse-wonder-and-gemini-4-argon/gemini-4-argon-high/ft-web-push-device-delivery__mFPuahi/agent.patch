diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..799d35c
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,148 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static values = { subscriptionsUrl: String }
+  static targets = [ "bell", "details" ]
+  static classes = [ "enabled" ]
+
+  async connect() {
+    this.#hideDetails()
+
+    if (this.#isSupported) {
+      if (await this.#isEnabled()) {
+        this.#enable()
+      } else {
+        this.#showBell()
+        if (this.#isPermissionDenied) {
+          this.#revealDetails()
+        }
+      }
+    } else {
+      this.#revealDetails()
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (this.#isSupported) {
+      if (!await this.#isEnabled()) {
+        await this.#requestPermission() || this.#revealDetails()
+      } else {
+        this.#enable()
+      }
+    } else {
+      this.#revealDetails()
+    }
+  }
+
+  get #isSupported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  async #isEnabled() {
+    if (this.#isSupported && Notification.permission === "granted") {
+      const registration = await this.#serviceWorkerRegistration
+      const existingSubscription = await registration?.pushManager?.getSubscription()
+      if (existingSubscription) {
+        await this.#syncPushSubscription(existingSubscription)
+        return true
+      } else {
+        return await this.#subscribe(registration)
+      }
+    }
+    return false
+  }
+
+  #enable() {
+    this.#hideDetails()
+    if (this.hasEnabledClass) {
+      this.element.classList.add(this.enabledClass)
+    }
+  }
+
+  #showBell() {
+    if (this.hasBellTarget) {
+      this.bellTarget.hidden = false
+    }
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => {
+      details.hidden = true
+      details.removeAttribute("open")
+    })
+  }
+
+  #revealDetails() {
+    this.detailsTargets.forEach(details => {
+      details.hidden = false
+      details.toggleAttribute("open", true)
+    })
+  }
+
+  async #requestPermission() {
+    const permission = await Notification.requestPermission()
+    if (permission === "granted") {
+      const registration = await this.#serviceWorkerRegistration
+      if (await this.#subscribe(registration)) {
+        this.#enable()
+        return true
+      }
+    }
+    return false
+  }
+
+  async #subscribe(registration) {
+    if (registration && this.#vapidPublicKey) {
+      try {
+        const subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#vapidPublicKey
+        })
+        await this.#syncPushSubscription(subscription)
+        return true
+      } catch {
+        return false
+      }
+    }
+    return false
+  }
+
+  async #syncPushSubscription(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON ? subscription.toJSON() : subscription
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } }
+    })
+    return response.ok
+  }
+
+  get #serviceWorkerRegistration() {
+    return navigator.serviceWorker.getRegistration().then(registration => {
+      return registration || navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    })
+  }
+
+  get #isPermissionDenied() {
+    return Notification.permission === "denied"
+  }
+
+  get #vapidPublicKey() {
+    const encodedKey = getMetaContent("vapid-public-key")
+    return encodedKey ? this.#urlBase64ToUint8Array(encodedKey) : null
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
