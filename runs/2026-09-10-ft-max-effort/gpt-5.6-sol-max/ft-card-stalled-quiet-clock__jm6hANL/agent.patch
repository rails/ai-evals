diff --git a/test/controllers/cards/stalled_test.rb b/test/controllers/cards/stalled_test.rb
new file mode 100644
index 0000000..6aaa1ba
--- /dev/null
+++ b/test/controllers/cards/stalled_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Cards::StalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:text)
+    @card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+  end
+
+  test "stalled index lists stalled cards and marks their previews" do
+    get cards_path(indexed_by: "stalled")
+
+    assert_response :success
+    assert_select "article.card--stalled .card__stalled", text: "Stalled", count: 1
+    assert_select "article.card--stalled .card__title", text: @card.title
+  end
+
+  test "stalled index is available as JSON" do
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_equal [ @card.number ], response.parsed_body.pluck("number")
+    assert_equal true, response.parsed_body.first["stalled"]
+  end
+
+  test "card detail marks a stalled card" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "article.card--stalled .card__stalled", text: "Stalled", count: 1
+  end
+
+  test "preview cache varies when a card becomes stalled" do
+    travel_to Time.zone.local(2026, 10, 1, 12) do
+      @card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago + 1.minute)
+
+      with_actionview_partial_caching do
+        get cards_path
+        assert_select ".card__stalled", count: 0
+
+        travel 2.minutes
+        get cards_path
+        assert_select "article.card--stalled .card__stalled", text: "Stalled", count: 1
+      end
+    end
+  end
+end
