diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..c038ad2
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(title: "A burst of attention", status: :published)
+    end
+    @card = Card.find(card.id)
+  end
+
+  test "three comments from two people within a third of the board auto-close period cause a burst" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      comment_as :david
+      travel 29.days
+      comment_as :kevin
+      comment_as :david
+
+      assert_equal Time.current, @card.reload.last_burst_at
+    end
+  end
+
+  test "comments outside a third of the board auto-close period do not cause a burst" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      comment_as :david
+      travel 31.days
+      comment_as :kevin
+      comment_as :david
+
+      assert_nil @card.reload.last_burst_at
+    end
+  end
+
+  test "three comments from only one person do not cause a burst" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      3.times { comment_as :david }
+
+      assert_nil @card.reload.last_burst_at
+    end
+  end
+
+  test "assignment causes a burst" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      with_current_user(:david) { @card.toggle_assignment(users(:kevin)) }
+
+      assert_equal Time.current, @card.reload.last_burst_at
+    end
+  end
+
+  test "reopening causes a burst" do
+    with_current_user(:david) { @card.close }
+
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      with_current_user(:david) { @card.reopen }
+
+      assert_equal Time.current, @card.reload.last_burst_at
+    end
+  end
+
+  test "a backdated burst does not replace a newer burst" do
+    @card.register_burst(at: 1.day.ago)
+    @card.register_burst(at: 2.days.ago)
+
+    assert_in_delta 1.day.ago, @card.reload.last_burst_at, 1.second
+  end
+
+  test "a card is stalled after a burst followed by two weeks without activity" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      with_current_user(:david) { @card.toggle_assignment(users(:kevin)) }
+      assert_not @card.reload.stalled?
+
+      travel 2.weeks
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "activity resets the stalled inactivity period" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      with_current_user(:david) { @card.toggle_assignment(users(:kevin)) }
+      travel 2.weeks
+      assert @card.reload.stalled?
+
+      comment_as :david
+      assert_not @card.reload.stalled?
+
+      travel 2.weeks
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "stalled index lists stalled cards" do
+    @card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_equal [ @card ], filter.cards.to_a
+  end
+
+  test "system comments do not count toward a burst" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      comment_as :david
+      comment_as :system
+      comment_as :kevin
+
+      assert_nil @card.reload.last_burst_at
+    end
+  end
+
+  test "the comment window includes exactly one third of the board auto-close period" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      comment_as :david
+      travel @card.auto_postpone_period / 3
+      comment_as :kevin
+      comment_as :david
+
+      assert_equal Time.current, @card.reload.last_burst_at
+    end
+  end
+
+  test "activity other than a comment resets the stalled inactivity period" do
+    travel_to Time.zone.local(2027, 1, 1, 12) do
+      with_current_user(:david) { @card.toggle_assignment(users(:kevin)) }
+      travel 2.weeks
+      assert @card.reload.stalled?
+
+      @card.reactions.create!(reacter: users(:david), content: "👍")
+
+      assert_not @card.reload.stalled?
+    end
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    assert @card.reload.stalled?
+
+    with_current_user(:david) { @card.close }
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert_not @card.reload.stalled?
+
+    with_current_user(:david) { @card.reopen }
+    with_current_user(:david) { @card.postpone }
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert_not @card.reload.stalled?
+  end
+
+  private
+    def comment_as(user)
+      @card.comments.create!(creator: users(user), body: "A comment")
+    end
+end
