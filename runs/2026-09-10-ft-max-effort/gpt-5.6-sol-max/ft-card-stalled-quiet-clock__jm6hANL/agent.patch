new file mode 100644
index 0000000..d0c5f58
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,32 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?(as_of: Time.current)
+    active? && last_burst_at.present? && last_active_at <= as_of - STALL_PERIOD
+  end
+
+  def register_burst(at: Time.current)
+    with_lock do
+      if last_burst_at.nil? || last_burst_at < at
+        update!(last_burst_at: at)
+      end
+    end
+  end
+
+  def detect_comment_burst(comment)
+    window = (comment.created_at - auto_postpone_period / 3)..comment.created_at
+    recent_comments = comments.by_user.where(created_at: window)
+
+    if recent_comments.count >= BURST_COMMENT_COUNT && recent_comments.distinct.count(:creator_id) >= BURST_COMMENTER_COUNT
+      register_burst(at: comment.created_at)
+    end
+  end
+end
