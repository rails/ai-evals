+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "requesting a code emails it and shows the code form" do
+    untenanted do
+      perform_enqueued_jobs do
+        assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      follow_redirect!
+    end
+
+    assert_response :success
+    assert_select "input[name=code][autocomplete=one-time-code][maxlength='6']"
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_match(/\b[A-Z0-9]{6}\b/, email.subject)
+  end
+
+  test "correct code signs in" do
+    code = request_sign_in_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_path
+    end
+
+    assert cookies[:session_token].present?
+    assert_nil parsed_cookies.encrypted[:pending_authentication_token]
+  end
+
+  test "incorrect code is rejected" do
+    request_sign_in_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: "WRONG!" }
+    end
+
+    assert_response :unauthorized
+    assert_not cookies[:session_token].present?
+    assert_select "input[name=code]"
+  end
+
+  test "code expires after fifteen minutes" do
+    code = request_sign_in_code
+    pending_authentication_token = cookies[:pending_authentication_token]
+
+    travel 15.minutes + 1.second do
+      cookies[:pending_authentication_token] = pending_authentication_token
+
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_response :unauthorized
+    assert_not cookies[:session_token].present?
+  end
+
+  test "code works until fifteen minutes have elapsed" do
+    code = request_sign_in_code
+
+    travel 14.minutes + 59.seconds do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to landing_path
+      end
+    end
+  end
+
+  test "JSON request and confirmation return authentication tokens" do
+    code = nil
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+      end
+
+      assert_response :created
+      assert @response.parsed_body["pending_authentication_token"].present?
+      assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+      code = code_from_last_email
+
+      post session_magic_link_path(format: :json), params: { code: code }, as: :json
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+      assert_equal cookies[:session_token], @response.parsed_body["session_token"]
+    end
+  end
+
+  test "JSON pending token authenticates from a fresh client" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+      end
+    end
+
+    pending_authentication_token = @response.parsed_body["pending_authentication_token"]
+    code = code_from_last_email
+    fresh_client = open_session
+    fresh_client.cookies[:pending_authentication_token] = pending_authentication_token
+
+    fresh_client.post session_magic_link_path(script_name: nil, format: :json), params: { code: code }, as: :json
+
+    assert_response :success
+    assert fresh_client.response.parsed_body["session_token"].present?
+  end
+
+  test "pending authentication cookie is protected and expires" do
+    freeze_time do
+      untenanted do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      set_cookie = Array(@response.headers["Set-Cookie"]).join("\n")
+      assert_match(/pending_authentication_token=/, set_cookie)
+      assert_match(/httponly/i, set_cookie)
+      assert_match(/samesite=lax/i, set_cookie)
+      assert_match(/expires=#{Regexp.escape(MagicLink::EXPIRATION.from_now.httpdate)}/i, set_cookie)
+    end
+  end
+
+  test "missing email is a bad request" do
+    untenanted do
+      post session_path
+    end
+
+    assert_response :bad_request
+  end
+
+  test "pending token does not expose the email or code" do
+    code = request_sign_in_code
+    token = cookies[:pending_authentication_token]
+
+    assert_not_includes token, @identity.email_address
+    assert_not_includes token, code
+  end
+
+  test "requesting another code replaces the first one" do
+    SecureRandom.stubs(:alphanumeric).with(MagicLink::CODE_LENGTH).returns("OLD123", "NEW456")
+
+    old_code = request_sign_in_code
+    new_code = request_sign_in_code
+
+    assert_equal "OLD123", old_code
+    assert_equal "NEW456", new_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: old_code }
+    end
+
+    assert_response :unauthorized
+    assert_not cookies[:session_token].present?
+  end
+
+  test "missing pending authentication is rejected" do
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_response :unauthorized
+
+    untenanted do
+      post session_magic_link_path, params: { code: "ABC123" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "invalid email is rejected without sending mail" do
+    untenanted do
+      assert_no_enqueued_emails do
+        post session_path, params: { email_address: "not-an-email" }
+      end
+    end
+
+    assert_response :unprocessable_entity
+    assert_not cookies[:pending_authentication_token].present?
+  end
+
+  test "code attempts are rate limited" do
+    request_sign_in_code
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "WRONG!" }, as: :json
+    end
+
+    assert_response :too_many_requests
+  end
+
+  test "invalid code via JSON returns unauthorized" do
+    request_sign_in_code
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "WRONG!" }, as: :json
+    end
+
+    assert_response :unauthorized
+    assert @response.parsed_body["message"].present?
+  end
+
+  test "unknown email does not disclose whether an identity exists" do
+    untenanted do
+      assert_no_enqueued_emails do
+        post session_path, params: { email_address: "unknown@example.com" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  private
+    def request_sign_in_code
+      untenanted do
+        perform_enqueued_jobs do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+      end
+
+      code_from_last_email
+    end
+
+    def code_from_last_email
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
