+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character uppercase alphanumeric code" do
+    magic_link = MagicLink.new(identity: @identity)
+
+    assert_match(/\A[A-Z0-9]{6}\z/, magic_link.code)
+  end
+
+  test "authenticates its identity with the correct code" do
+    magic_link = MagicLink.new(identity: @identity, code: "ABC123")
+
+    assert magic_link.authenticates?("ABC123")
+    assert magic_link.authenticates?("abc123")
+    assert magic_link.authenticates?(" ABC123 ")
+    assert_not magic_link.authenticates?("ABC124")
+    assert_not magic_link.authenticates?(nil)
+  end
+
+  test "does not authenticate if the identity email has changed" do
+    magic_link = MagicLink.new(identity: @identity, code: "ABC123")
+    @identity.update!(email_address: "changed@example.com")
+
+    assert_not magic_link.authenticates?("ABC123")
+  end
+
+  test "round trips through its cookie payload" do
+    magic_link = MagicLink.new(identity: @identity, code: "ABC123")
+    restored = MagicLink.from_cookie(magic_link.as_json.stringify_keys)
+
+    assert_nil restored.identity
+    assert_equal @identity.id, restored.identity_id
+    assert_equal @identity.email_address, restored.email_address
+
+    restored.identity = @identity
+    assert restored.authenticates?("ABC123")
+  end
+
+  test "rejects malformed cookie payloads" do
+    assert_nil MagicLink.from_cookie(nil)
+    assert_nil MagicLink.from_cookie("not a hash")
+    assert_nil MagicLink.from_cookie({ email_address: @identity.email_address })
+    assert_nil MagicLink.from_cookie({ email_address: @identity.email_address, code: "short" })
+  end
+end
