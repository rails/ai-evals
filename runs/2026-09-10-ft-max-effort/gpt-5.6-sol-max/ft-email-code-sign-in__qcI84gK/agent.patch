diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..66b8d0f
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,65 @@
+class MagicLink
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  attr_accessor :identity
+  attr_reader :identity_id, :email_address, :code
+
+  def self.from_cookie(payload)
+    if valid_payload?(payload)
+      attributes = payload.with_indifferent_access
+
+      new(
+        identity_id: attributes[:identity_id],
+        email_address: attributes[:email_address],
+        code: attributes[:code]
+      )
+    end
+  end
+
+  def self.valid_payload?(payload)
+    if payload.respond_to?(:with_indifferent_access)
+      attributes = payload.with_indifferent_access
+
+      attributes[:email_address].is_a?(String) &&
+        attributes[:code].is_a?(String) &&
+        attributes[:code].length == CODE_LENGTH
+    else
+      false
+    end
+  end
+  private_class_method :valid_payload?
+
+  def initialize(identity: nil, identity_id: identity&.id, email_address: identity&.email_address, code: nil)
+    @identity = identity
+    @identity_id = identity_id
+    @email_address = email_address
+    @code = code || generate_code
+  end
+
+  def authenticates?(submitted_code)
+    ActiveSupport::SecurityUtils.secure_compare(code, normalize_code(submitted_code)) &&
+      identity.present? && identity.id == identity_id && identity.email_address == email_address
+  end
+
+  def deliver_later
+    IdentityMailer.magic_link(email_address: email_address, code: code).deliver_later if identity.present?
+  end
+
+  def as_json(*)
+    {
+      identity_id: identity_id,
+      email_address: email_address,
+      code: code
+    }
+  end
+
+  private
+    def generate_code
+      SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def normalize_code(value)
+      value.to_s.strip.upcase
+    end
+end
