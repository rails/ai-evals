+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <label>
+      <span class="for-screen-reader">Six-character sign-in code</span>
+      <%= form.text_field :code,
+            required: true,
+            class: "input",
+            autofocus: true,
+            autocomplete: "one-time-code",
+            autocapitalize: "characters",
+            spellcheck: false,
+            minlength: MagicLink::CODE_LENGTH,
+            maxlength: MagicLink::CODE_LENGTH,
+            pattern: "[A-Za-z0-9]{#{MagicLink::CODE_LENGTH}}",
+            title: "Enter the #{MagicLink::CODE_LENGTH}-character code from your email" %>
+    </label>
+
+    <p>
+      We sent a six-character sign-in code<% if @magic_link&.email_address.present? %>
+        to <strong><%= @magic_link.email_address %></strong><% end %>.
+      It will work for 15 minutes.
+    </p>
+
+    <button type="submit" id="log_in" class="btn btn--link center" data-form-target="submit">
+      <span>Sign in</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <%= link_to "Use a different email address", new_session_path, class: "btn btn--plain txt-link center txt-small" %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
