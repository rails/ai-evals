--- /dev/null
+++ b/test/controllers/email_code_flows_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class EmailCodeFlowsTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "signup by email code signs in and continues to account completion" do
+    email_address = "new-signup@example.com"
+
+    untenanted do
+      perform_enqueued_jobs do
+        assert_difference -> { Identity.count }, 1 do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+
+      assert_redirected_to new_signup_completion_path
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Signup" } }
+      end
+    end
+
+    owner = Identity.find_by!(email_address: email_address).users.find_by!(role: :owner)
+    assert_equal "New Signup", owner.name
+    assert cookies[:session_token].present?
+  end
+
+  test "joining by email code signs in, redeems the join code, and continues setup" do
+    email_address = "new-joiner@example.com"
+
+    perform_enqueued_jobs do
+      assert_difference -> { Identity.count }, 1 do
+        assert_difference -> { User.count }, 1 do
+          assert_difference -> { @join_code.reload.usage_count }, 1 do
+            post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email_address }
+          end
+        end
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+
+    assert_no_difference -> { User.count } do
+      assert_no_difference -> { @join_code.reload.usage_count } do
+        untenanted do
+          post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+
+    post users_verifications_path(script_name: @account.slug)
+    assert_redirected_to new_users_join_path(script_name: @account.slug)
+
+    post users_joins_path(script_name: @account.slug), params: { user: { name: "New Joiner" } }
+    assert_redirected_to landing_path(script_name: @account.slug)
+
+    joined_user = Identity.find_by!(email_address: email_address).users.find_by!(account: @account)
+    assert joined_user.verified?
+    assert_equal "New Joiner", joined_user.name
+    assert cookies[:session_token].present?
+  end
+
+  test "joining with an existing membership does not consume the join code" do
+    identity = identities(:jz)
+
+    perform_enqueued_jobs do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+    end
+
+    assert_no_difference -> { User.count } do
+      assert_no_difference -> { @join_code.reload.usage_count } do
+        untenanted do
+          post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+        end
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+  end
+
+  test "signup code request via JSON returns a pending authentication token" do
+    untenanted do
+      post signup_path(format: :json), params: { signup: { email_address: "json-signup@example.com" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+  end
+
+  test "join code request via JSON returns a pending authentication token" do
+    post join_path(code: @join_code.code, script_name: @account.slug, format: :json),
+      params: { email_address: "json-joiner@example.com" }, as: :json
+
+    assert_response :created
+    assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+  end
+
+  test "joining while signed in as another identity switches to the verified identity" do
+    requested_identity = identities(:mike)
+    sign_in_as :kevin
+
+    perform_enqueued_jobs do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: requested_identity.email_address }
+    end
+
+    untenanted do
+      post session_magic_link_path(script_name: nil), params: { code: code_from_last_email }
+    end
+
+    signed_in_session = Session.find_signed(parsed_cookies.signed[:session_token])
+    assert_equal requested_identity, signed_in_session.identity
+    assert requested_identity.users.exists?(account: @account)
+  end
+
+  test "invalid join email creates neither an identity nor a user" do
+    assert_no_difference -> { Identity.count } do
+      assert_no_difference -> { User.count } do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "invalid" }
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  private
+    def code_from_last_email
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
