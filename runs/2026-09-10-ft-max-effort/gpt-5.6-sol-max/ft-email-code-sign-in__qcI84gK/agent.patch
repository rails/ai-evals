@@ -0,0 +1,58 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_magic_link
+
+  layout "public"
+
+  def new
+    render_invalid_magic_link unless @magic_link
+  end
+
+  def create
+    if @magic_link&.authenticates?(params[:code])
+      complete_authentication
+    else
+      render_invalid_magic_link
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = pending_magic_link
+      @magic_link.identity = Identity.find_by(id: @magic_link.identity_id) if @magic_link
+    end
+
+    def complete_authentication
+      start_new_session_for @magic_link.identity
+      clear_pending_magic_link
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def render_invalid_magic_link
+      message = "That code didn't work. Check the code and try again."
+
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = message
+          render :new, status: :unauthorized
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
