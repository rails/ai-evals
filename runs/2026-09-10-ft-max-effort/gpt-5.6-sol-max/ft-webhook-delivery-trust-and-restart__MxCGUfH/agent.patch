diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..3812dda
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,51 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      record_success
+    else
+      record_failure
+    end
+  end
+
+  def record_success
+    transaction do
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+  end
+
+  def record_failure
+    transaction do
+      record_failure_atomically
+      reload
+
+      webhook.deactivate if delinquent?
+    end
+  end
+
+  def reset
+    record_success
+  end
+
+  private
+    def record_failure_atomically
+      now = Time.current
+      self.class.where(id: id).update_all(
+        [
+          "consecutive_failures_count = COALESCE(consecutive_failures_count, 0) + 1, " \
+            "first_failure_at = COALESCE(first_failure_at, ?), updated_at = ?",
+          now,
+          now
+        ]
+      )
+    end
+
+    def delinquent?
+      consecutive_failures_count >= FAILURE_LIMIT && first_failure_at <= FAILURE_PERIOD.ago
+    end
+end
