+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,9 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +14,31 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      expired.in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    if claim
+      begin
+        post_payload
+      rescue => error
+        record_error(error)
+      ensure
+        record_result
+      end
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +57,75 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      claimed_at = Time.current
+      claimed = self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: claimed_at) == 1
+
+      if claimed
+        self.state = :in_progress
+        self.updated_at = claimed_at
+      else
+        reload
+      end
+
+      claimed
+    end
+
+    def post_payload
+      body = Webhook::Payload.new(webhook, event).body
+      headers = request_headers(body)
+      update!(request: { headers: headers })
+
+      http_response = perform_request(body, headers)
+      update!(
+        state: :completed,
+        response: { code: http_response.code.to_i, headers: http_response.to_hash }
+      )
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body),
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+      }
+    end
+
+    def perform_request(body, headers)
+      uri = URI.parse(webhook.url)
+      request = Net::HTTP::Post.new(uri, headers)
+      request.body = body
+
+      Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT
+      ) do |http|
+        http.request(request)
+      end
+    end
+
+    def record_error(error)
+      if in_progress?
+        update!(state: :errored, response: { error: "destination_unreachable" })
+        Rails.logger.warn "Webhook delivery #{id} failed: #{error.class}: #{error.message}"
+      end
+    end
+
+    def record_result
+      if completed? || errored?
+        tracker.record(self)
+      end
+    end
+
+    def tracker
+      webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+    end
 end
