diff --git a/test/models/webhook/runtime_test.rb b/test/models/webhook/runtime_test.rb
new file mode 100644
index 0000000..f17df02
--- /dev/null
+++ b/test/models/webhook/runtime_test.rb
@@ -0,0 +1,202 @@
+require "test_helper"
+
+class Webhook::RuntimeTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @webhook.deliveries.delete_all
+    @webhook.delinquency_tracker.reset
+    clear_enqueued_jobs
+  end
+
+  test "a subscribed board event creates one durable delivery" do
+    event = create_event(action: "card_closed")
+
+    assert_equal [ @webhook ], event.webhook_deliveries.map(&:webhook)
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob
+
+    event.send(:trigger_webhooks)
+
+    assert_equal 1, Webhook::Delivery.where(webhook: @webhook, event: event).count
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob
+  end
+
+  test "a card action triggers its subscribed webhook" do
+    card = cards(:logo)
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      card.close(user: users(:kevin))
+    end
+
+    assert @webhook.deliveries.joins(:event).exists?(events: { action: "card_closed" })
+  end
+
+  test "only active webhooks on the event board subscribed to its action trigger" do
+    unsubscribed = create_webhook(board: @webhook.board, subscribed_actions: %w[ comment_created ])
+    inactive = create_webhook(board: @webhook.board, active: false, subscribed_actions: %w[ card_closed ])
+    another_board = create_webhook(board: boards(:private), subscribed_actions: %w[ card_closed ])
+
+    event = create_event(action: "card_closed")
+
+    assert_equal [ @webhook ], event.webhook_deliveries.map(&:webhook)
+    assert_empty unsubscribed.deliveries
+    assert_empty inactive.deliveries
+    assert_empty another_board.deliveries
+  end
+
+  test "delivery posts a signed JSON payload and only attempts once" do
+    delivery = @webhook.deliveries.create!(event: events(:shipping_closed))
+    delivered_request = nil
+    request = stub_request(:post, @webhook.url).to_return do |actual_request|
+      delivered_request = actual_request
+      { status: 204, body: "" }
+    end
+
+    delivery.deliver_now
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert delivery.reload.succeeded?
+    assert_equal 204, delivery.response[:code]
+
+    payload = JSON.parse(delivered_request.body)
+    assert_equal delivery.event_id, payload.fetch("id")
+    assert_equal "card_closed", payload.fetch("action")
+    assert_includes payload.dig("eventable", "url"), delivery.account.slug
+
+    expected_signature = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, delivered_request.body)
+    assert_equal expected_signature, delivered_request.headers.fetch("X-Webhook-Signature")
+    assert_equal expected_signature, delivery.request.dig(:headers, "X-Webhook-Signature")
+    assert_equal "application/json", delivery.request.dig(:headers, "Content-Type")
+    assert_equal delivery.event.created_at.utc.iso8601(3), delivery.request.dig(:headers, "X-Webhook-Timestamp")
+  end
+
+  test "two stale instances cannot deliver the same row twice" do
+    delivery = @webhook.deliveries.create!(event: events(:shipping_closed))
+    stale_delivery = Webhook::Delivery.find(delivery.id)
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    delivery.deliver_now
+    stale_delivery.deliver_now
+
+    assert_requested request, times: 1
+  end
+
+  test "the delivery job restores account context" do
+    delivery = @webhook.deliveries.create!(event: events(:shipping_closed))
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested request, times: 1
+    assert delivery.reload.succeeded?
+  end
+
+  test "an unsuccessful HTTP response is completed, logged, and counted as a failure" do
+    delivery = @webhook.deliveries.create!(event: events(:shipping_closed))
+    stub_request(:post, @webhook.url).to_return(status: 503, headers: { "Retry-After" => "60" })
+
+    delivery.deliver_now
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 503, delivery.response[:code]
+    assert_equal [ "60" ], delivery.response.dig(:headers, "retry-after")
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a transport error is logged, counted, and never retried" do
+    delivery = @webhook.deliveries.create!(event: events(:shipping_closed))
+    request = stub_request(:post, @webhook.url).to_raise(SocketError.new("unreachable"))
+
+    delivery.deliver_now
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert delivery.reload.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "chat receivers get their expected JSON envelope" do
+    event = events(:shipping_closed)
+    message = Webhook::Payload.new(webhook_for("https://example.com/rooms/123/456-room/messages"), event).body
+    slack = Webhook::Payload.new(webhook_for("https://hooks.slack.com/services/T123/B123/token"), event).body
+    basecamp = Webhook::Payload.new(webhook_for("https://3.basecamp.com/1/integrations/token/buckets/2/chats/3/lines"), event).body
+
+    assert_match(/Kevin moved/, JSON.parse(message).dig("message", "body"))
+    assert_match(/Kevin moved/, JSON.parse(slack).fetch("text"))
+    assert_match(/Kevin moved/, JSON.parse(basecamp).fetch("content"))
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    tracker = @webhook.delinquency_tracker
+    travel_to Time.current.change(usec: 0) do
+      9.times { tracker.record_failure }
+      assert @webhook.reload.active?
+
+      travel 1.hour
+      tracker.record_failure
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "ten failures in less than an hour do not deactivate the webhook" do
+    10.times { @webhook.delinquency_tracker.record_failure }
+
+    assert @webhook.reload.active?
+  end
+
+  test "a successful delivery resets the failure streak" do
+    tracker = @webhook.delinquency_tracker
+    3.times { tracker.record_failure }
+
+    tracker.record_success
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "reactivating a webhook resets the failure streak" do
+    tracker = @webhook.delinquency_tracker
+    tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "cleanup retains one week of delivery history" do
+    recent = @webhook.deliveries.create!(event: events(:shipping_closed), created_at: 1.week.ago + 1.second)
+    expired = @webhook.deliveries.create!(event: events(:logo_published), created_at: 1.week.ago - 1.second)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(recent.id)
+    assert_not Webhook::Delivery.exists?(expired.id)
+  end
+
+  private
+    def create_event(action:)
+      card = cards(:shipping)
+      Event.create!(account: card.account, board: card.board, creator: card.creator, eventable: card, action: action)
+    end
+
+    def create_webhook(board:, active: true, subscribed_actions:)
+      board.webhooks.create!(
+        name: SecureRandom.hex,
+        url: "https://#{SecureRandom.hex}.example.com/webhook",
+        active: active,
+        subscribed_actions: subscribed_actions
+      )
+    end
+
+    def webhook_for(url)
+      Webhook.new(url: url)
+    end
+end
