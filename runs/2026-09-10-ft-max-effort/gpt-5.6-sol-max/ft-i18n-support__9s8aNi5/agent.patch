diff --git a/test/controllers/set_locale_test.rb b/test/controllers/set_locale_test.rb
new file mode 100644
index 0000000..ac83036
--- /dev/null
+++ b/test/controllers/set_locale_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class SetLocaleTest < ActionDispatch::IntegrationTest
+  test "a supported locale parameter changes the locale and sticks in the session" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyにログイン"
+      assert_select 'body[data-local-time-locale-value="ja-JP"]'
+      assert_select 'body[data-local-time-translations-value*="昨日"]'
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyにログイン"
+    end
+  end
+
+  test "an unsupported locale parameter is ignored" do
+    untenanted do
+      get new_session_path(locale: :xx)
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+
+  test "an unsupported locale does not replace an existing choice" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      get new_session_path(locale: :xx)
+
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyにログイン"
+    end
+  end
+
+  test "a locale choice is persisted on the signed in identity" do
+    identity = identities(:kevin)
+    sign_in_as identity
+
+    get root_path(locale: :ja)
+
+    assert_response :success
+    assert_equal "ja", identity.reload.locale
+  end
+
+  test "an identity locale is restored when signing in from a clean browser" do
+    identity = identities(:kevin)
+    identity.update!(locale: :ja)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      follow_redirect!
+
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "メールを確認してください"
+
+      magic_link = identity.magic_links.order(:created_at).last
+      post session_magic_link_path, params: { code: magic_link.code }
+      3.times { follow_redirect! if response.redirect? }
+
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "a new Japanese signup receives the first email in Japanese and persists the choice" do
+    email_address = "tokyo-#{SecureRandom.hex(6)}@example.com"
+
+    untenanted do
+      get new_session_path(locale: :ja)
+      post session_path, params: { email_address: email_address }
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    magic_link = identity.magic_links.order(:created_at).last
+    assert_equal "ja", identity.locale
+    assert_equal "ja", enqueued_jobs.last["locale"]
+    assert_equal "Fizzyのコードは#{magic_link.code}です", MagicLinkMailer.sign_in_instructions(magic_link).subject
+  end
+
+  test "a clean-browser query choice overrides the stored identity locale before email is sent" do
+    identity = identities(:kevin)
+    identity.update!(locale: :ja)
+
+    untenanted do
+      get new_session_path(locale: :en)
+
+      assert_difference -> { MagicLink.count }, 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_equal "en", enqueued_jobs.last["locale"]
+    assert_equal "en", identity.reload.locale
+    magic_link = identity.magic_links.order(:created_at).last
+    assert_equal "Your Fizzy code is #{magic_link.code}", MagicLinkMailer.sign_in_instructions(magic_link).subject
+  end
+
+  test "people without a preference retain the existing English rendering" do
+    identity = identities(:kevin)
+    assert_nil identity.locale
+
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+end
