diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..cec3dc8
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,52 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :switch_locale
+    before_action :restore_locale_from_identity
+
+    etag { I18n.locale }
+  end
+
+  private
+    def switch_locale(&action)
+      if requested_locale = supported_locale(params[:locale])
+        session[:locale] = requested_locale
+      end
+
+      locale = supported_locale(session[:locale]) || I18n.default_locale
+
+      I18n.with_locale(locale) do
+        action.call
+        persist_locale_on_identity
+      end
+    end
+
+    def restore_locale_from_identity
+      if session_locale = supported_locale(session[:locale])
+        I18n.locale = session_locale
+        persist_locale_on_identity
+      elsif identity_locale = supported_locale(Current.identity&.locale)
+        session[:locale] = identity_locale
+        I18n.locale = identity_locale
+      end
+    end
+
+    def adopt_locale_from(identity)
+      if locale = supported_locale(session[:locale]) || supported_locale(identity.locale)
+        session[:locale] = locale
+        I18n.locale = locale
+        identity.update!(locale: locale) if identity.locale != locale
+      end
+    end
+
+    def persist_locale_on_identity
+      if (identity = Current.identity) && (locale = supported_locale(session[:locale])) && identity.locale != locale
+        identity.update!(locale: locale)
+      end
+    end
+
+    def supported_locale(locale)
+      locale.to_s.presence_in(I18n.available_locales.map(&:to_s))
+    end
+end
