@@ -0,0 +1,53 @@
+require "test_helper"
+
+class JapaneseMailersTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+    @identity.update!(locale: :ja)
+    @user = users(:david)
+  end
+
+  test "account cancellation is entirely Japanese" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: @user)
+
+    email = AccountMailer.cancellation(account.cancellation)
+
+    assert_equal "Fizzyアカウントをキャンセルしました", email.subject
+    assert_includes email.html_part.body.to_s, "今後の動作"
+    assert_includes email.text_part.body.to_s, "誰もアクセスできません"
+  end
+
+  test "data export is entirely Japanese" do
+    email = ExportMailer.completed(exports(:completed_user_data_export))
+
+    assert_equal "Fizzyデータをダウンロードできます", email.subject
+    assert_includes email.html_part.body.to_s, "データをダウンロード"
+    assert_includes email.text_part.body.to_s, "エクスポート処理が完了"
+  end
+
+  test "successful import is entirely Japanese" do
+    email = ImportMailer.completed(@identity, accounts(:"37s"))
+
+    assert_equal "Fizzyアカウントのインポートが完了しました", email.subject
+    assert_includes email.html_part.body.to_s, "インポートが完了"
+    assert_includes email.text_part.body.to_s, "アカウントのURL"
+  end
+
+  test "failed import is entirely Japanese" do
+    import = Account::Import.create!(account: Current.account, identity: @identity, status: :failed)
+    email = ImportMailer.failed(import)
+
+    assert_equal "Fizzyアカウントをインポートできませんでした", email.subject
+    assert_includes email.html_part.body.to_s, "エクスポートデータの破損"
+    assert_includes email.text_part.body.to_s, "メールでお問い合わせ"
+  end
+
+  test "email change confirmation is entirely Japanese" do
+    email = UserMailer.email_change_confirmation(email_address: @identity.email_address, token: "token", user: @user)
+
+    assert_equal "新しいメールアドレスを確認してください", email.subject
+    assert_includes email.html_part.body.to_s, "メールアドレスの変更を確認"
+    assert_includes email.text_part.body.to_s, "以下のリンク"
+  end
+end
