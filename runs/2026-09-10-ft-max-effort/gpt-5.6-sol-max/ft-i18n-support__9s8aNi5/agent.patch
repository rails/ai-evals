+  create_notification(@user)
+
+  email = Notification::BundleMailer.notification(@bundle)
+
+  assert_equal "Fizzy：新しい通知", email.subject
+  assert_includes email.html_part.body.to_s, "新しい通知1件"
+  assert_match(/\d{4}年\d{1,2}月\d{1,2}日/, email.text_part.body.to_s)
+  assert_not_includes email.text_part.body.to_s, "Notifications since"
+end
+
   private
     def create_notification(user, source: events(:logo_published))
       Notification.create!(user: user, creator: user, source: source, created_at: 30.minutes.ago)
