+require "test_helper"
+
+class JapaneseRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "renders the main application screens in a sticky Japanese locale" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    user = users(:kevin)
+
+    paths = [
+      root_path(locale: :ja),
+      cards_path,
+      board_path(board),
+      edit_board_path(board),
+      card_path(card),
+      account_settings_path,
+      notifications_path,
+      notifications_settings_path,
+      user_path(user),
+      edit_user_path(user),
+      my_access_tokens_path,
+      my_passkeys_path,
+      board_webhooks_path(board),
+      search_path
+    ]
+
+    paths.each do |path|
+      get path
+      assert_response :success, path
+      assert_select "html[lang=ja]", 1, path
+      assert_no_match(/Translation missing/, response.body, path)
+    end
+  end
+
+  test "renders a published board in Japanese without authentication context" do
