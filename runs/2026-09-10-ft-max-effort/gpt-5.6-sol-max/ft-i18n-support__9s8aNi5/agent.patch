diff --git a/script/i18n-audit b/script/i18n-audit
new file mode 100755
index 0000000..70b23b9
--- /dev/null
+++ b/script/i18n-audit
@@ -0,0 +1,161 @@
+#!/usr/bin/env ruby
+# Audits application-owned, user-readable strings. Rich-text package strings are
+# intentionally excluded: they are maintained and shipped by that package.
+
+ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
+require "bundler/setup"
+require "nokogiri"
+require "yaml"
+
+ROOT = File.expand_path("..", __dir__)
+Findings = []
+
+module LocaleAudit
+  module_function
+
+  def deep_merge(left, right)
+    left.merge(right) { |_, a, b| a.is_a?(Hash) && b.is_a?(Hash) ? deep_merge(a, b) : b }
+  end
+
+  def flatten(value, prefix = nil, result = {})
+    case value
+    when Hash
+      value.each { |key, child| flatten(child, [ prefix, key ].compact.join("."), result) }
+    when Array
+      value.each_with_index { |child, index| flatten(child, "#{prefix}[#{index}]", result) }
+    else
+      result[prefix] = value
+    end
+    result
+  end
+
+  def placeholders(value)
+    value.to_s.scan(/%\{([^}]+)\}/).flatten.sort
+  end
+end
+
+# Every application English key, including every seed-array leaf, needs a
+# Japanese counterpart with the same interpolation contract.
+translations = Hash.new { |hash, locale| hash[locale] = {} }
+Dir[File.join(ROOT, "config/locales/*.yml")].each do |file|
+  YAML.load_file(file).each do |locale, values|
+    translations[locale] = LocaleAudit.deep_merge(translations[locale], values)
+  end
+rescue Psych::Exception => error
+  Findings << "#{file.delete_prefix("#{ROOT}/")}: invalid YAML: #{error.message}"
+end
+
+en = LocaleAudit.flatten(translations["en"])
+ja = LocaleAudit.flatten(translations["ja"])
+(en.keys - ja.keys).each { |key| Findings << "config/locales: Japanese translation missing for #{key}" }
+(en.keys & ja.keys).each do |key|
+  if LocaleAudit.placeholders(en[key]) != LocaleAudit.placeholders(ja[key])
+    Findings << "config/locales: interpolation mismatch for #{key}"
+  end
+end
+
+# Parse templates as HTML after removing ERB. This avoids mistaking CSS classes,
+# Stimulus actions, and Ruby code for text while still checking screen-reader
+# attributes. JSON/JS templates contain protocol keys and source code, not UI
+# text; their actual manifest labels are translation calls checked above.
+allowed_text = [
+  /\AFizzy(?:™| saas)?\z/, /\A37signals™\z/, /\ABasecamp™\z/, /\AHEY™\z/,
+  /\A(?:DEV|ESC|HMAC|SHA256|iOS|Android|Google Chrome)\z/,
+  /\A[A-Za-z]\z/
+]
+
+Dir[File.join(ROOT, "{app,saas/app}/views/**/*.erb")].sort.each do |file|
+  next if file.end_with?(".json.erb", ".js.erb")
+  next if file.end_with?("layouts/_theme_preference.html.erb")
+  next if file.include?("lexxy")
+
+  source = File.read(file).gsub(/<%#.*?%>/m, "").gsub(/<%.*?%>/m, "")
+  document = Nokogiri::HTML5.fragment(source)
+  document.css("style, script").remove
+
+  document.xpath(".//text()").each do |node|
+    text = node.text.gsub(/\s+/, " ").strip
+    next unless text.match?(/[A-Za-z]{2}/)
+    next if allowed_text.any? { _1.match?(text) }
+
+    Findings << "#{file.delete_prefix("#{ROOT}/")}: hard-coded text #{text.inspect}"
+  end
+
+  document.css("*").each do |node|
+    %w[ aria-label aria-description title placeholder alt data-bridge-title ].each do |attribute|
+      value = node[attribute].to_s.strip
+      next unless value.match?(/[A-Za-z]{2}/)
+      next if allowed_text.any? { _1.match?(value) }
+      next if value.match?(/\A(?:https?:|[.#]|--|var\()/)
+
+      Findings << "#{file.delete_prefix("#{ROOT}/")}: hard-coded #{attribute} #{value.inspect}"
+    end
+  end
+end
+
+# CSS generated content is visible and can be announced. It must come from an
+# element attribute/custom property populated by a translation, not an English
+# literal in a stylesheet.
+Dir[File.join(ROOT, "{app/assets,saas/app/assets}/**/*.{css,scss}")].sort.each do |file|
+  File.readlines(file).each_with_index do |line, index|
+    if match = line.match(/content:\s*["']([^"']*[A-Za-z]{2}[^"']*)["']/)
+      Findings << "#{file.delete_prefix("#{ROOT}/")}:#{index + 1}: hard-coded generated text #{match[1].inspect}"
+    end
+  end
+end
+
+# Controller feedback, model validation messages, and mail subjects are rendered
+# outside normal text nodes. Flag literal English at those call sites.
+ui_context = /(?:notice:|alert:|\bmessage:|\berror:|errors\.add|subject:|validation_message:|turbo_confirm:)/
+Dir[File.join(ROOT, "{app,saas/app}/**/*.rb")].sort.each do |file|
+  next if file.include?("lexxy")
+
+  File.readlines(file).each_with_index do |line, index|
+    next unless line.match?(ui_context)
+
+    line.scan(/(["'])(.*?)(?<!\\)\1/) do |_, value|
+      next unless value.match?(/[A-Za-z]{2}\s+[A-Za-z]{2}/)
+      next if value.match?(/\A(?:models|mailers|controllers|action_pack)\./)
+      next if line.lstrip.start_with?("#")
+
+      Findings << "#{file.delete_prefix("#{ROOT}/")}:#{index + 1}: hard-coded UI string #{value.inspect}"
+    end
+  end
+end
+
+# JavaScript phrases that can reach visible text must be server supplied. Keep
+# selectors, CSS, markup snippets, request headers, and developer-only passkey
+# diagnostics out of this UI audit.
+js_allowed = [
+  /\A[-$#.{\[]/, /(?:input|textarea|contenteditable|lexxy-editor)/,
+  /\A\((?:min|max|prefers)-/, /local-time-value/, /timezone=.*path=/,
+  /Accept: text\/html/,
+  /\A(?:Passkeys are not supported by this browser|Missing passkey options|Passkey ceremony failed|Passkey conditional mediation failed|Missing passkey challenge URL|Failed to refresh challenge)\z/
+]
+Dir[File.join(ROOT, "app/javascript/**/*.js")].sort.each do |file|
+  next if file.include?("lexxy")
+
+  File.readlines(file).each_with_index do |line, index|
+    line.scan(/(["'`])((?:\\.|(?!\1).)*?)\1/) do |_, value|
+      next unless value.match?(/[A-Za-z]{2}\s+[A-Za-z]{2}/)
+      next if js_allowed.any? { _1.match?(value) }
+
+      Findings << "#{file.delete_prefix("#{ROOT}/")}:#{index + 1}: hard-coded JavaScript UI string #{value.inspect}"
+    end
+  end
+end
+
+# Static error pages cannot know a locale, so each must carry both languages.
+Dir[File.join(ROOT, "public/{400,404,406-unsupported-browser,422,500}.html")].each do |file|
+  source = File.read(file)
+  Findings << "#{file.delete_prefix("#{ROOT}/")}: missing Japanese variant" unless source.include?('lang="ja"') && source.match?(/[ぁ-んァ-ヶ一-龠]/)
+  Findings << "#{file.delete_prefix("#{ROOT}/")}: missing English variant" unless source.match?(/[A-Za-z]{3}/)
+end
+
+if Findings.empty?
+  puts "I18n audit passed: Japanese key parity, templates, accessible text, UI messages, JavaScript, and static errors"
+else
+  warn Findings.join("\n")
+  warn "#{Findings.size} internationalization audit finding(s)"
+  exit 1
+end
