diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..c1cf592
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,24 @@
+<article class="search-result">
+  <header class="search-result__header">
+    <span class="search-result__board"><%= card.board.name %></span>
+    <span aria-hidden="true">·</span>
+    <%= time_tag card.created_at, time_ago_in_words(card.created_at), class: "search-result__date" %>
+  </header>
+
+  <h2 class="search-result__title">
+    <%= link_to search_highlight(card.title, query), card_path(card), data: { turbo_frame: "_top" } %>
+  </h2>
+
+  <% if description = search_matching_text(card.description, query) %>
+    <p class="search-result__match"><%= search_highlight description, query %></p>
+  <% end %>
+
+  <% card.comments.each do |comment| %>
+    <% if body = search_matching_text(comment.body, query) %>
+      <blockquote class="search-result__match search-result__comment">
+        <span class="for-screen-reader">Matching comment:</span>
+        <%= search_highlight body, query %>
+      </blockquote>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..ec13a08
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span>Search</span>
+  </h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form", data: { turbo_frame: "search_results", turbo_action: "advance" } do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, autocorrect: "off", autocomplete: "off", class: "input search__input" %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <%= turbo_frame_tag :search_results do %>
+    <% if @query.present? %>
+      <div class="search__results">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { query: @query } %>
+        <% end %>
+
+        <% unless @page.used? %>
+          <div class="blank-slate">No cards match “<%= @query %>”</div>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">Search card titles, descriptions, and comments</div>
+    <% end %>
+  <% end %>
+</section>
