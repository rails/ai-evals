diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..8f3a06a
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+
+    @older_card = create_published_card title: "A nebula in the title", created_at: 3.days.ago
+    @description_card = create_published_card title: "Description match", description: "A bright NEBULA overhead", created_at: 2.days.ago
+    @comment_card = create_published_card title: "Comment match", created_at: 1.day.ago
+    @comment_card.comments.create!(body: "I spotted the nebula here")
+    @comment_card.comments.create!(body: "Another nebula makes this card match twice")
+  end
+
+  test "shows a GET search form that advances browser history" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[method='get'][action='#{search_path}'][data-turbo-frame='search_results'][data-turbo-action='advance']"
+  end
+
+  test "finds published cards by title, description, or comments, newest first without duplicates" do
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_equal [ @comment_card, @description_card, @older_card ].map(&:title), result_titles
+    assert_select "article.search-result", count: 3
+  end
+
+  test "only finds cards on boards the current user can access" do
+    private_board = Board.create!(name: "Private", creator: users(:david), all_access: false)
+    inaccessible_card = create_published_card board: private_board, title: "Secret nebula"
+
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_not_includes result_titles, inaccessible_card.title
+  end
+
+  test "stops finding a card as soon as board access is revoked" do
+    private_board = Board.create!(name: "Revocable", creator: users(:david), all_access: false)
+    private_board.accesses.grant_to users(:kevin)
+    revocable_card = create_published_card board: private_board, title: "Revocable nebula"
+
+    get search_path, params: { q: "nebula" }
+    assert_includes result_titles, revocable_card.title
+    etag = response.headers["ETag"]
+
+    private_board.accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "nebula" }, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_not_includes result_titles, revocable_card.title
+  end
+
+  test "never finds drafts or comments on drafts" do
+    draft = create_published_card title: "Draft nebula"
+    draft.comments.create!(body: "A nebula in a draft comment")
+    draft.update!(status: :drafted)
+
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_not_includes result_titles, draft.title
+    assert_select "article.search-result", { text: /draft comment/i, count: 0 }
+  end
+
+  test "highlights case-insensitive matches in safe plain text" do
+    unsafe_card = create_published_card \
+      title: "<script>alert('title')</script> Nebula",
+      description: "<strong>NEBULA</strong> <script>alert('description')</script>"
+    unsafe_card.comments.create!(body: "A neBuLa beside <script>alert('comment')</script>")
+
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_select "mark", minimum: 3, text: /nebula/i
+    assert_no_match(/<script>/, response.body)
+    assert_match(/&lt;script&gt;/, response.body)
+  end
+
+  test "treats wildcard and punctuation characters literally" do
+    literal_card = create_published_card title: "Progress is 50%_done! (really)"
+
+    get search_path, params: { q: "%_done! (" }
+
+    assert_response :success
+    assert_equal [ literal_card.title ], result_titles
+    assert_select "mark", text: "%_done! ("
+  end
+
+  test "does not search for a blank query" do
+    get search_path, params: { q: "  " }
+
+    assert_response :success
+    assert_empty result_titles
+  end
+
+  private
+    def create_published_card(board: boards(:writebook), title:, description: nil, created_at: Time.current)
+      board.cards.create!(
+        creator: users(:kevin),
+        title: title,
+        description: description,
+        status: :published,
+        created_at: created_at,
+        last_active_at: created_at)
+    end
+
+    def result_titles
+      css_select("article.search-result h2").map { it.text.strip }
+    end
+end
