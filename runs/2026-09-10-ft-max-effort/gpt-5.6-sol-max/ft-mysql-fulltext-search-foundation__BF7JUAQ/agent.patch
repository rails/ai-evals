diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..0078ab9
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,22 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(term) do
+      if term = term.to_s.strip.presence
+        pattern = "%#{sanitize_sql_like(term.downcase, "!")}%"
+        matching_rich_texts = ActionText::RichText.where(
+          "LOWER(action_text_rich_texts.body) LIKE :pattern ESCAPE '!'", pattern: pattern)
+        matching_descriptions = matching_rich_texts.where(record_type: "Card", name: "description").select(:record_id)
+        matching_comments = matching_rich_texts.where(record_type: "Comment", name: "body").select(:record_id)
+        matching_comment_cards = Comment.where(id: matching_comments).select(:card_id)
+
+        where("LOWER(cards.title) LIKE :pattern ESCAPE '!'", pattern: pattern)
+          .or(where(id: matching_descriptions))
+          .or(where(id: matching_comment_cards))
+      else
+        none
+      end
+    end
+  end
+end
