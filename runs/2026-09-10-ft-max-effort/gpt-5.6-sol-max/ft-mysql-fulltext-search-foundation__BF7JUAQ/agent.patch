+@layer modules {
+  .search {
+    inline-size: min(100%, 70ch);
+    margin-inline: auto;
+    padding: var(--main-padding);
+  }
+
+  .search__form {
+    display: flex;
+    gap: var(--inline-space-half);
+  }
+
+  .search__input {
+    flex: 1;
+    min-inline-size: 0;
+  }
+
+  .search__results {
+    display: grid;
+    gap: var(--block-space);
+    margin-block-start: var(--block-space-double);
+  }
+
+  .search-result {
+    border-block-end: var(--border);
+    padding-block-end: var(--block-space);
+  }
+
+  .search-result__header {
+    color: var(--color-ink-dark);
+    display: flex;
+    font-size: var(--text-x-small);
+    gap: var(--inline-space-half);
+  }
+
+  .search-result__title {
+    font-size: var(--text-medium);
+    margin-block: var(--block-space-half);
+  }
+
+  .search-result__match {
+    color: var(--color-ink-darker);
+    line-height: 1.45;
+    margin-block: var(--block-space-half) 0;
+    overflow-wrap: anywhere;
+    white-space: pre-line;
+  }
+
+  .search-result__comment {
+    border-inline-start: 0.2em solid var(--color-ink-lighter);
+    padding-inline-start: var(--inline-space);
+  }
+
+  .search-result mark {
+    background: var(--color-highlight);
+    color: inherit;
+  }
+}
diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
