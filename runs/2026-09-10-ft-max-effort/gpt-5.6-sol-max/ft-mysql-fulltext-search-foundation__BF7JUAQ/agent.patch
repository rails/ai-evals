+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,15 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from search_results
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards
+        .published
+        .search(@query)
+        .reverse_chronologically
+        .preload(:board, :rich_text_description, comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..90cb702
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,18 @@
+module SearchesHelper
+  def search_highlight(text, query)
+    if query.present?
+      pattern = /(#{Regexp.escape(query)})/i
+
+      safe_join text.to_s.split(pattern).map.with_index { |part, index|
+        index.odd? ? tag.mark(part) : part
+      }
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_matching_text(text, query)
+    plain_text = text.to_plain_text.strip
+    plain_text if query.present? && plain_text.downcase.include?(query.downcase)
+  end
+end
