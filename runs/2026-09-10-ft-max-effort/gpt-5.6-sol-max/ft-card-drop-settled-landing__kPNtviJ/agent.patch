diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..b650731
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,167 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+    @card = cards(:buy_domain)
+
+    page.visit board_url(@card.board)
+    assert_selector "#{card_selector}[draggable='true']"
+    assert_no_selector "turbo-frame[busy]", visible: :all
+  end
+
+  test "dragging a card saves its new column" do
+    destination = columns(:writebook_in_progress)
+
+    drag card_selector, to: column_selector(destination)
+
+    assert_selector "#{column_selector(destination)} #{card_selector}", visible: :all
+    wait_until { @card.reload.column == destination }
+  end
+
+  test "dragging a card moves it before the save finishes" do
+    destination = columns(:writebook_in_progress)
+    stall_fetches
+
+    drag card_selector, to: column_selector(destination)
+
+    assert_selector "#{column_selector(destination)} #{card_selector}", visible: :all
+    assert_nil @card.reload.column
+  ensure
+    restore_fetches
+  end
+
+  test "dragging dims the card and highlights the destination" do
+    destination_selector = column_selector(columns(:writebook_in_progress))
+    source = find(card_selector)
+    destination = find(destination_selector)
+
+    page.execute_script(<<~JS, source, destination)
+      const [ source, destination ] = arguments
+      const dataTransfer = new DataTransfer()
+      window.dragDataTransfer = dataTransfer
+
+      source.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+      destination.dispatchEvent(new DragEvent("dragenter", { bubbles: true, dataTransfer }))
+    JS
+
+    assert_selector "#{card_selector}.drag-and-drop__dragged-item"
+    assert_selector "#{destination_selector}.drag-and-drop__hover-container"
+
+    page.execute_script(<<~JS, source)
+      arguments[0].dispatchEvent(new DragEvent("dragend", {
+        bubbles: true,
+        dataTransfer: window.dragDataTransfer
+      }))
+    JS
+
+    assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+  end
+
+  test "dragging changes a card between board statuses" do
+    drag card_selector, to: "#not-now"
+
+    assert_selector "#not-now #{card_selector}.card--postponed", visible: :all
+    assert_selector "#not-now #{card_selector} .card__closed-title", text: "Not Now", visible: :all
+    wait_until { @card.reload.postponed? }
+
+    drag card_selector, to: "#closed-cards"
+
+    assert_selector "#closed-cards #{card_selector}:not(.card--postponed)", visible: :all
+    assert_selector "#closed-cards #{card_selector} .card__closed-title", text: "Done", visible: :all
+    wait_until { @card.reload.closed? }
+
+    drag card_selector, to: "#maybe"
+
+    assert_selector "#maybe #{card_selector}:not(.card--postponed)", visible: :all
+    assert_no_selector "#{card_selector} .card__closed", visible: :all
+    wait_until { @card.reload.awaiting_triage? }
+  end
+
+  test "a column keeps golden cards first and ignores drops within itself" do
+    destination = columns(:writebook_triage)
+    destination_selector = column_selector(destination)
+
+    drag card_selector, to: destination_selector
+    wait_until { @card.reload.column == destination }
+
+    card_ids = all("#{destination_selector} article.card", visible: :all).map { |card| card[:id] }
+    assert_equal [ dom_id(cards(:logo), :article), dom_id(@card, :article) ], card_ids.first(2)
+
+    watch_card_requests do
+      drag card_selector, to: destination_selector
+      sleep 0.1
+
+      assert_equal 0, card_request_count
+      assert_equal card_ids, all("#{destination_selector} article.card", visible: :all).map { |card| card[:id] }
+    end
+  end
+
+  private
+    def card_selector
+      "##{dom_id(@card, :article)}"
+    end
+
+    def column_selector(column)
+      "##{dom_id(column)}"
+    end
+
+    def drag(source_selector, to:)
+      source = find(source_selector, visible: :all)
+      destination = find(to, visible: :all)
+
+      page.execute_script(<<~JS, source, destination)
+        const [ source, destination ] = arguments
+        const dataTransfer = new DataTransfer()
+        const options = { bubbles: true, cancelable: true, dataTransfer }
+
+        source.dispatchEvent(new DragEvent("dragstart", options))
+        destination.dispatchEvent(new DragEvent("dragenter", options))
+        destination.dispatchEvent(new DragEvent("dragover", options))
+        destination.dispatchEvent(new DragEvent("drop", options))
+        source.dispatchEvent(new DragEvent("dragend", options))
+      JS
+    end
+
+    def stall_fetches
+      page.execute_script(<<~JS)
+        window.fetchBeforeDrag = window.fetch
+        window.fetch = () => new Promise(() => {})
+      JS
+    end
+
+    def restore_fetches
+      page.execute_script("window.fetch = window.fetchBeforeDrag") if page.current_url
+    end
+
+    def watch_card_requests
+      page.execute_script(<<~JS, @card.to_param)
+        const cardParam = arguments[0]
+        window.fetchBeforeRequestWatch = window.fetch
+        window.cardRequestCount = 0
+        window.fetch = (...args) => {
+          const input = args[0]
+          const url = input instanceof Request ? input.url : input.toString()
+          if (url.includes(`/cards/${cardParam}/`)) window.cardRequestCount++
+          return window.fetchBeforeRequestWatch(...args)
+        }
+      JS
+
+      yield
+    ensure
+      page.execute_script("window.fetch = window.fetchBeforeRequestWatch")
+    end
+
+    def card_request_count
+      page.evaluate_script("window.cardRequestCount")
+    end
+
+    def wait_until
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.05 until yield
+      end
+    end
+end
