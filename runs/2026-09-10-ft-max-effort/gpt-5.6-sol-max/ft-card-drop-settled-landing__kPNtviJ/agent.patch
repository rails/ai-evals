diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..211157c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,280 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = { userName: String }
+
+  initialize() {
+    this.saveQueues = new WeakMap()
+  }
+
+  disconnect() {
+    this.dragEnd()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  dragStart(event) {
+    const item = this.#itemFrom(event.target)
+    if (!item) return
+
+    this.draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  dragEnter(event) {
+    this.#activateContainerFor(event)
+  }
+
+  dragOver(event) {
+    if (this.#activateContainerFor(event)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    const container = this.#containerFrom(event.target)
+
+    if (container && !container.contains(event.relatedTarget)) {
+      this.#deactivateContainer(container)
+    }
+  }
+
+  drop(event) {
+    const destinationContainer = this.#containerFrom(event.target)
+    const item = this.draggedItem
+
+    if (item && destinationContainer) {
+      event.preventDefault()
+
+      const sourceContainer = this.#containerFrom(item)
+      if (sourceContainer && sourceContainer !== destinationContainer) {
+        this.#move(item, sourceContainer, destinationContainer)
+        this.#save(item, destinationContainer)
+      }
+    }
+
+    this.#deactivateContainers()
+  }
+
+  dragEnd() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.draggedItem = null
+    this.#deactivateContainers()
+  }
+
+  #activateContainerFor(event) {
+    const container = this.#containerFrom(event.target)
+
+    if (this.draggedItem && container) {
+      if (this.hoveredContainer !== container) {
+        this.#deactivateContainers()
+        container.classList.add(this.hoverContainerClass)
+        this.hoveredContainer = container
+      }
+
+      return true
+    }
+  }
+
+  #deactivateContainer(container) {
+    container.classList.remove(this.hoverContainerClass)
+    if (this.hoveredContainer === container) this.hoveredContainer = null
+  }
+
+  #deactivateContainers() {
+    this.containerTargets.forEach(container => container.classList.remove(this.hoverContainerClass))
+    this.hoveredContainer = null
+  }
+
+  #move(item, sourceContainer, destinationContainer) {
+    this.#insertInOrder(item, destinationContainer)
+    this.#updateCard(item, destinationContainer)
+    this.#updateCount(sourceContainer, -1)
+    this.#updateCount(destinationContainer, 1)
+  }
+
+  #insertInOrder(item, container) {
+    const items = this.#itemsIn(container).filter(candidate => candidate !== item)
+    const firstItem = items[0]
+
+    if (container.dataset.dragAndDropGoldenFirst === "true" && !item.classList.contains("golden-effect")) {
+      const firstRegularItem = items.find(candidate => !candidate.classList.contains("golden-effect"))
+
+      if (firstRegularItem) {
+        firstRegularItem.before(item)
+      } else if (items.length > 0) {
+        items.at(-1).after(item)
+      } else {
+        this.#listIn(container)?.prepend(item)
+      }
+    } else if (firstItem) {
+      firstItem.before(item)
+    } else {
+      this.#listIn(container)?.prepend(item)
+    }
+  }
+
+  #updateCard(item, container) {
+    const destination = container.dataset.dragAndDropDestination
+
+    item.style.setProperty("--card-color", container.dataset.dragAndDropCardColor)
+    item.classList.toggle("card--active", destination === "column" || destination === "maybe")
+    item.classList.toggle("card--postponed", destination === "not-now")
+
+    this.#updateColumnIndicators(item, container)
+    this.#updateStatusStamp(item, destination)
+  }
+
+  #updateColumnIndicators(item, container) {
+    const inColumn = container.dataset.dragAndDropDestination === "column"
+    const columnId = container.dataset.dragAndDropColumnId
+
+    item.querySelectorAll(".card__stages .card__column-name").forEach(indicator => {
+      indicator.classList.toggle("card__column-name--current", inColumn && indicator.dataset.columnId === columnId)
+    })
+
+    const headerIndicator = item.querySelector(".card__header > .card__column-name")
+    if (inColumn) {
+      const indicator = headerIndicator || this.#buildHeaderColumnIndicator()
+      indicator.dataset.columnId = columnId
+      indicator.querySelector("span").textContent = container.dataset.columnName
+      if (!headerIndicator) item.querySelector(".card__header").append(indicator)
+    } else {
+      headerIndicator?.remove()
+    }
+  }
+
+  #buildHeaderColumnIndicator() {
+    const indicator = document.createElement("span")
+    const name = document.createElement("span")
+
+    indicator.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+    name.className = "overflow-ellipsis"
+    indicator.append(name)
+
+    return indicator
+  }
+
+  #updateStatusStamp(item, destination) {
+    item.querySelector(".card__closed")?.remove()
+
+    if (destination === "not-now") {
+      this.#cardBodyIn(item)?.append(this.#buildStatusStamp("Not Now"))
+    } else if (destination === "closed") {
+      this.#cardBodyIn(item)?.append(this.#buildStatusStamp("Done"))
+    }
+  }
+
+  #buildStatusStamp(title) {
+    const stamp = document.createElement("div")
+    const stampTitle = document.createElement("span")
+    const date = document.createElement("strong")
+    const byline = document.createElement("span")
+    const user = document.createElement("span")
+
+    stamp.className = "card__closed"
+    stampTitle.className = "card__closed-title"
+    stampTitle.dataset.text = title
+    stampTitle.textContent = title
+    date.className = "card__closed-date"
+    date.textContent = this.#formattedToday
+    byline.className = "card__closed-by-line"
+    user.className = "card__closed-by"
+    user.textContent = this.userNameValue
+    byline.append("by ", user)
+    stamp.append(stampTitle, date, byline)
+
+    return stamp
+  }
+
+  get #formattedToday() {
+    return new Intl.DateTimeFormat("en-US", {
+      day: "2-digit",
+      month: "short",
+      year: "numeric"
+    }).format(new Date())
+  }
+
+  #updateCount(container, change) {
+    const counter = container.querySelector(".cards__expander-count")
+    const displayedCount = counter?.textContent.trim()
+
+    if (displayedCount && !displayedCount.endsWith("+")) {
+      const count = Math.max(parseInt(displayedCount, 10) + change, 0)
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  #save(item, container) {
+    const save = () => this.#requestSave(item, container)
+    const previousSave = this.saveQueues.get(item) || Promise.resolve()
+    const queuedSave = previousSave.then(save, save)
+
+    this.saveQueues.set(item, queuedSave)
+    queuedSave.then(
+      () => this.#finishSave(item, queuedSave),
+      error => {
+        console.error(error)
+        this.#finishSave(item, queuedSave)
+      }
+    )
+  }
+
+  async #requestSave(item, container) {
+    const destination = container.dataset.dragAndDropDestination
+    const options = { responseKind: "json" }
+    let response
+
+    switch (destination) {
+      case "column":
+        response = await post(item.dataset.cardTriageUrl, {
+          ...options,
+          body: { column_id: container.dataset.dragAndDropColumnId }
+        })
+        break
+      case "maybe":
+        response = await destroy(item.dataset.cardTriageUrl, options)
+        break
+      case "not-now":
+        response = await post(item.dataset.cardNotNowUrl, options)
+        break
+      case "closed":
+        response = await post(item.dataset.cardClosureUrl, options)
+        break
+    }
+
+    if (!response?.ok) throw new Error(`Unable to move card to ${container.dataset.columnName}`)
+  }
+
+  #finishSave(item, save) {
+    if (this.saveQueues.get(item) === save) this.saveQueues.delete(item)
+  }
+
+  #itemFrom(element) {
+    return element instanceof Element ? element.closest('[data-drag-and-drop-target~="item"]') : null
+  }
+
+  #containerFrom(element) {
+    return element instanceof Element ? element.closest('[data-drag-and-drop-target~="container"]') : null
+  }
+
+  #itemsIn(container) {
+    return Array.from(container.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+  }
+
+  #listIn(container) {
+    return container.querySelector(".cards__list")
+  }
+
+  #cardBodyIn(item) {
+    return item.querySelector(".card__body")
+  }
+}
