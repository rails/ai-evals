diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..7dca840
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create registers this browser for the current user" do
+    assert_difference -> { users(:kevin).push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscriptions/kevin-phone",
+          p256dh_key: "browser-public-key",
+          auth_key: "browser-auth-secret"
+        }
+      }
+    end
+
+    assert_response :created
+
+    subscription = users(:kevin).push_subscriptions.last
+    assert_equal "https://push.example.test/subscriptions/kevin-phone", subscription.endpoint
+    assert_equal "browser-public-key", subscription.p256dh_key
+    assert_equal "browser-auth-secret", subscription.auth_key
+  end
+
+  test "create refreshes keys when the push service returns an existing endpoint" do
+    subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/existing",
+      p256dh_key: "old-public-key",
+      auth_key: "old-auth-secret"
+    )
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new-public-key",
+          auth_key: "new-auth-secret"
+        }
+      }
+    end
+
+    assert_response :created
+    assert_equal "new-public-key", subscription.reload.p256dh_key
+    assert_equal "new-auth-secret", subscription.auth_key
+  end
+
+  test "cannot register a push subscription for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscriptions/not-kevin",
+          p256dh_key: "public-key",
+          auth_key: "auth-secret"
+        }
+      }
+    end
+
+    assert_response :not_found
+  end
+  test "create rejects incomplete subscription credentials" do
+  assert_no_difference -> { PushSubscription.count } do
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: { endpoint: "https://push.example.test/subscriptions/incomplete" }
+    }
+  end
+
+  assert_response :unprocessable_entity
+  end
+
+  test "create requires authentication" do
+  sign_out
+
+  assert_no_difference -> { PushSubscription.count } do
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: {
+        endpoint: "https://push.example.test/subscriptions/anonymous",
+        p256dh_key: "public-key",
+        auth_key: "auth-secret"
+      }
+    }
+  end
+
+  assert_response :redirect
+  end
+
+test "create transfers an existing browser endpoint to the current user" do
+  endpoint = "https://push.example.test/subscriptions/shared-browser"
+  subscription = users(:david).push_subscriptions.create!(
+    endpoint: endpoint,
+    p256dh_key: "davids-public-key",
+    auth_key: "davids-auth-secret"
+  )
+
+  assert_no_difference -> { PushSubscription.count } do
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: {
+        endpoint: endpoint,
+        p256dh_key: "kevins-public-key",
+        auth_key: "kevins-auth-secret"
+      }
+    }
+  end
+
+  assert_response :created
+  assert_equal users(:kevin), subscription.reload.user
+  assert_equal "kevins-public-key", subscription.p256dh_key
+  assert_equal "kevins-auth-secret", subscription.auth_key
+end
+end
diff --git a/test/models/push_subscription/delivery_test.rb b/test/models/push_subscription/delivery_test.rb
new file mode 100644
index 0000000..5620b9c
--- /dev/null
+++ b/test/models/push_subscription/delivery_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class PushSubscription::DeliveryTest < ActiveSupport::TestCase
+  setup do
+    @subscription = PushSubscription.create!(
+      user: users(:kevin),
+      endpoint: "https://push.example.test/subscriptions/kevin-desktop",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-secret"
+    )
+    ENV.stubs(:fetch).with("VAPID_PUBLIC_KEY").returns("vapid-public")
+    ENV.stubs(:fetch).with("VAPID_PRIVATE_KEY").returns("vapid-private")
+  end
+
+  test "a new tray notification enqueues delivery to each registered device" do
+    PushSubscription.create!(
+      user: users(:kevin),
+      endpoint: "https://push.example.test/subscriptions/kevin-phone",
+      p256dh_key: "second-browser-public-key",
+      auth_key: "second-browser-auth-secret"
+    )
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: PushSubscription::DeliveryJob do
+      Notification.create!(user: users(:kevin), source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "a replacement tray notification also enqueues delivery" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_enqueued_with(job: PushSubscription::DeliveryJob, args: [ @subscription, notification ]) do
+      notification.source_type_will_change!
+      notification.update!(source: events(:layout_assignment_jz), creator: users(:david), unread_count: 2)
+    end
+  end
+
+  test "marking a notification read does not enqueue delivery" do
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notifications(:layout_commented_kevin).read
+    end
+  end
+
+  test "delivery sends tray copy and an account-scoped card URL using VAPID" do
+    notification = notifications(:layout_commented_kevin)
+
+    WebPush.expects(:payload_send).with do |arguments|
+      payload = JSON.parse(arguments.fetch(:message))
+
+      arguments[:endpoint] == @subscription.endpoint &&
+        arguments[:p256dh] == @subscription.p256dh_key &&
+        arguments[:auth] == @subscription.auth_key &&
+        arguments.dig(:vapid, :public_key) == "vapid-public" &&
+        arguments.dig(:vapid, :private_key) == "vapid-private" &&
+        payload == {
+          "title" => "RE: Layout is broken",
+          "body" => events(:layout_commented).eventable.body.to_plain_text.truncate(200),
+          "url" => "http://example.com#{notification.account.slug}/cards/#{notification.card.number}"
+        }
+    end
+
+    PushSubscription::DeliveryJob.perform_now(@subscription, notification)
+  end
+
+  test "delivery removes an expired subscription" do
+    response = Net::HTTPGone.new("1.1", "410", "Gone")
+    response.instance_variable_set(:@read, true)
+    response.body = "expired"
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      PushSubscription::DeliveryJob.perform_now(@subscription, notifications(:layout_commented_kevin))
+    end
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..86616f8
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "requires complete browser credentials" do
+    subscription = PushSubscription.new(user: users(:kevin))
+
+    assert_not subscription.valid?
+    assert subscription.errors.of_kind?(:endpoint, :blank)
+    assert subscription.errors.of_kind?(:p256dh_key, :blank)
+    assert subscription.errors.of_kind?(:auth_key, :blank)
+  end
+
+  test "endpoint is globally unique" do
+    existing = PushSubscription.create!(
+      user: users(:kevin), endpoint: "https://push.example.test/subscriptions/shared",
+      p256dh_key: "public-key", auth_key: "auth-secret"
+    )
+    duplicate = PushSubscription.new(
+      user: users(:david), endpoint: existing.endpoint,
+      p256dh_key: "another-public-key", auth_key: "another-auth-secret"
+    )
+
+    assert_not duplicate.valid?
+    assert duplicate.errors.of_kind?(:endpoint, :taken)
+  end
+
+  test "is removed with its user" do
+    user = users(:jz)
+    subscription = PushSubscription.create!(
+      user: user,
+      endpoint: "https://push.example.test/subscriptions/jz",
+      p256dh_key: "public-key",
+      auth_key: "auth-secret"
+    )
+
+    user.destroy!
+
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+end
