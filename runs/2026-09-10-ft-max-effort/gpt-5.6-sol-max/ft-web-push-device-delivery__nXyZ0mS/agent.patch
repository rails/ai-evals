diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..2798641
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,126 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "toggle", "details" ]
+  static values = {
+    publicKey: String,
+    subscriptionUrl: String
+  }
+
+  async connect() {
+    this.#hideDetails()
+
+    if (this.#supported) {
+      try {
+        const subscription = await this.#currentSubscription()
+
+        if (Notification.permission === "granted") {
+          this.#showState(subscription)
+          if (subscription) await this.#register(subscription)
+        } else {
+          this.#showState(null)
+        }
+
+        if (Notification.permission === "denied") this.#showDetails()
+        this.toggleTarget.disabled = Notification.permission === "denied"
+      } catch (error) {
+        console.error("Unable to load push notification settings", error)
+        this.#showState(null)
+      }
+    } else {
+      this.toggleTarget.disabled = true
+    }
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+
+    try {
+      if (this.toggleTarget.checked) {
+        await this.#turnOn()
+      } else {
+        await this.#turnOff()
+      }
+    } catch (error) {
+      console.error("Unable to update push notifications", error)
+      this.#showState(null)
+    } finally {
+      this.toggleTarget.disabled = !this.#supported || Notification.permission === "denied"
+    }
+  }
+
+  async #turnOn() {
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription() ||
+        await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+
+      await this.#register(subscription)
+      this.#showState(subscription)
+    } else {
+      this.#showState(null)
+      if (permission === "denied") this.#showDetails()
+    }
+  }
+
+  async #turnOff() {
+    const subscription = await this.#currentSubscription()
+    await subscription?.unsubscribe()
+    this.#showState(null)
+  }
+
+  async #currentSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const body = new FormData()
+
+    body.append("push_subscription[endpoint]", endpoint)
+    body.append("push_subscription[p256dh_key]", keys.p256dh)
+    body.append("push_subscription[auth_key]", keys.auth)
+
+    const response = await post(this.subscriptionUrlValue, { body })
+    if (!response.ok) throw new Error(`Push subscription registration failed (${response.statusCode})`)
+  }
+
+  #showState(subscription) {
+    const on = Boolean(subscription)
+
+    this.toggleTarget.checked = on
+    this.element.classList.toggle(this.onClass, on)
+    if (on) this.#hideDetails()
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(details => details.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => details.hidden = true)
+  }
+
+  get #supported() {
+    return this.publicKeyValue.length > 0 &&
+      "Notification" in window &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const bytes = atob(base64)
+
+    return Uint8Array.from(bytes, character => character.charCodeAt(0))
+  }
+}
