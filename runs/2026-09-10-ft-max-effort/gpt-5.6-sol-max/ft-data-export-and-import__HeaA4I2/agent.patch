+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "account settings show the export action to an admin" do
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_select "form[action='#{account_exports_path}']"
+  end
+
+  test "admin requests a complete account export" do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with(job: Export::GenerateJob) do
+        post account_exports_path
+      end
+    end
+
+    export = Export.order(:created_at).last
+    assert_predicate export, :account_kind?
+    assert_equal users(:kevin), export.user
+    assert_redirected_to account_settings_path
+  end
+
+  test "member cannot request a complete account export" do
+    sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+end
