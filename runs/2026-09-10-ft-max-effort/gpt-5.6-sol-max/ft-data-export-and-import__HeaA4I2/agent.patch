+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @download_url = export_download_url(export.download_id, script_name: nil)
+
+    mail to: export.identity.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def export_failed(export)
+    @export = export
+
+    mail to: export.identity.email_address, subject: "We couldn't export your Fizzy data"
+  end
+
+  def import_succeeded(account_import)
+    @import = account_import
+    @account = account_import.imported_account
+    @account_url = landing_url(script_name: @account.slug)
+
+    mail to: account_import.identity.email_address, subject: "Your Fizzy account import is ready"
+  end
+
+  def import_failed(account_import)
+    @import = account_import
+
+    mail to: account_import.identity.email_address, subject: "We couldn't import your Fizzy account"
+  end
+end
