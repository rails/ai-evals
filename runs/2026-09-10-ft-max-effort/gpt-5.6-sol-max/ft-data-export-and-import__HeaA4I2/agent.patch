@@ -0,0 +1,28 @@
+class Exports::DownloadsController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+
+  def show
+    if export = Export.find_by_download_id(params[:id])
+      if export.downloadable?
+        redirect_to service_url_for(export), allow_other_host: true
+      else
+        head :not_found
+      end
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def service_url_for(export)
+      ActiveStorage::Current.set(url_options: {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.optional_port,
+        script_name: ""
+      }) do
+        export.file.url(expires_in: 10.minutes, disposition: :attachment)
+      end
+    end
+end
