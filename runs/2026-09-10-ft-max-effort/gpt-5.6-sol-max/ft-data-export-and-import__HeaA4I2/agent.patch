diff --git a/saas/lib/fizzy/saas/account_data_transfer_importer.rb b/saas/lib/fizzy/saas/account_data_transfer_importer.rb
new file mode 100644
index 0000000..0a797ad
--- /dev/null
+++ b/saas/lib/fizzy/saas/account_data_transfer_importer.rb
@@ -0,0 +1,32 @@
+module Fizzy
+  module Saas
+    module AccountDataTransferImporter
+      private
+        def provision_external_account(account_attributes)
+          @queenbee_account = Queenbee::Remote::Account.create!(
+            product_name: "fizzy",
+            name: account_attributes.fetch("name"),
+            owner_name: importing_owner_name,
+            owner_email: identity.email_address,
+            trial: true,
+            subscription: {
+              name: FreeV1Subscription.to_param,
+              price: FreeV1Subscription.price
+            },
+            remote_request: {},
+            auto_allow: true,
+            skip_remote: true
+          )
+          @queenbee_account.id.to_s
+        end
+
+        def handle_import_failure
+          @queenbee_account&.cancel
+        end
+
+        def importing_owner_name
+          identity.users.active.first&.name || identity.email_address
+        end
+    end
+  end
+end
