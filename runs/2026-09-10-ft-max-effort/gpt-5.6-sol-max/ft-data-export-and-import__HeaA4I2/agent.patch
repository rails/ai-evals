@@ -0,0 +1,178 @@
+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.account = @account
+    Current.session = sessions(:david)
+  end
+
+  test "exports records, people, rich text references, and attachment bytes" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("card image"), filename: "picture.jpg", content_type: "image/jpeg")
+    embedded = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("embedded file"), filename: "notes.txt", content_type: "text/plain")
+    card.update!(description: "<p>Details</p>#{ActionText::Attachment.from_attachable(embedded).to_html}")
+
+    with_exported_account do |reader|
+      assert reader.exists?("manifest.json")
+      assert_equal "fizzy-account", JSON.parse(reader.read("manifest.json"))["format"]
+
+      card_json = JSON.parse(reader.read("cards/#{card.id}.json"))
+      assert_equal card.title, card_json["title"]
+
+      user_json = JSON.parse(reader.read("users/#{users(:david).id}.json"))
+      assert_equal users(:david).identity.email_address, user_json["email_address"]
+      assert_not user_json.key?("identity_id")
+
+      rich_text = card.reload.rich_text_description
+      rich_text_json = JSON.parse(reader.read("action_text_rich_texts/#{rich_text.id}.json"))
+      assert_includes rich_text_json["body"], "data-fizzy-attachable-type=\"ActiveStorage::Blob\""
+      assert_not_includes rich_text_json["body"], " sgid="
+
+      assert_equal "card image", reader.read("files/#{card.image.blob.id}")
+      assert_equal "embedded file", reader.read("files/#{embedded.id}")
+    end
+  end
+
+  test "round trips an account with remapped records and files" do
+    source_card = cards(:logo)
+    source_card.image.attach(io: StringIO.new("card image"), filename: "picture.jpg", content_type: "image/jpeg")
+    embedded = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("embedded file"), filename: "notes.txt", content_type: "text/plain")
+    source_card.update!(description: [ embedded, users(:kevin) ].map do |attachable|
+      ActionText::Attachment.from_attachable(attachable).to_html
+    end.join)
+    source_comment = source_card.comments.create!(body: "Imported comment", creator: users(:david))
+    source_counts = {
+      boards: @account.boards.count,
+      cards: @account.cards.count,
+      comments: Comment.where(account: @account).count,
+      users: @account.users.count
+    }
+
+    imported_account = nil
+    with_exported_account do |reader|
+      imported_account = Account::DataTransfer::Importer.new(identity: identities(:mike)).import(reader)
+    end
+
+    assert_not_equal @account.id, imported_account.id
+    assert_equal @account.name, imported_account.name
+    assert_equal source_counts[:boards], imported_account.boards.count
+    assert_equal source_counts[:cards], imported_account.cards.count
+    assert_equal source_counts[:comments], Comment.where(account: imported_account).count
+    assert_equal source_counts[:users] + 1, imported_account.users.count
+    assert_equal identities(:mike), imported_account.users.find_by!(role: :owner).identity
+    assert_equal imported_account.boards.count, imported_account.users.find_by!(role: :owner).boards.count
+    assert_equal imported_account.cards.count, imported_account.users.find_by!(role: :owner).accessible_cards.count
+    assert_equal "admin", imported_account.users.find_by!(identity: identities(:jason)).role
+
+    imported_filter = imported_account.users.find_by!(identity: identities(:david)).filters.sole
+    assert_equal [ "mobile" ], imported_filter.tags.pluck(:title)
+    assert_equal [ identities(:jz) ], imported_filter.assignees.map(&:identity)
+    assert_equal Filter.digest_params(imported_filter.as_params), imported_filter.params_digest
+
+    imported_card = imported_account.cards.find_by!(number: source_card.number)
+    imported_attachables = imported_card.description.body.attachables
+    imported_embed = imported_attachables.grep(ActiveStorage::Blob).sole
+    imported_mention = imported_attachables.grep(User).sole
+    imported_comment = imported_card.comments.find_by!(
+      creator: imported_account.users.find_by!(identity: identities(:david)))
+
+    assert_not_equal source_card.id, imported_card.id
+    assert_equal "card image", imported_card.image.download
+    assert_not_equal embedded.id, imported_embed.id
+    assert_equal "embedded file", imported_embed.download
+    assert_equal identities(:kevin), imported_mention.identity
+    assert_equal source_comment.body.to_plain_text, imported_comment.body.to_plain_text
+    assert_equal imported_card.storage_bytes, imported_account.reload.storage_total.bytes_stored
+  end
+
+  test "rolls back every record when an archive cannot be completed" do
+    tempfile = Tempfile.new([ "invalid-account", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    now = Time.current
+    source_account_id = ActiveRecord::Type::Uuid.generate
+    source_user_id = ActiveRecord::Type::Uuid.generate
+
+    writer.add_file("manifest.json", { format: "fizzy-account", version: 1 }.to_json)
+    writer.add_file("accounts/#{source_account_id}.json", {
+      id: source_account_id, name: "Broken", cards_count: 0, created_at: now, updated_at: now
+    }.to_json)
+    writer.add_file("users/#{source_user_id}.json", {
+      id: source_user_id, account_id: source_account_id, identity_id: nil,
+      email_address: identities(:mike).email_address, name: "Mike", role: "owner",
+      active: true, verified_at: now, created_at: now, updated_at: now
+    }.to_json)
+    writer.add_file("boards/#{ActiveRecord::Type::Uuid.generate}.json", {
+      id: ActiveRecord::Type::Uuid.generate, account_id: source_account_id,
+      creator_id: ActiveRecord::Type::Uuid.generate, name: "Missing creator",
+      all_access: false, created_at: now, updated_at: now
+    }.to_json)
+    writer.close
+    tempfile.rewind
+
+    assert_no_difference -> { Account.count } do
+      assert_raises ZipFile::Reader::InvalidArchive do
+        Account::DataTransfer::Importer.new(identity: identities(:mike)).import(tempfile)
+      end
+    end
+  ensure
+    tempfile&.close!
+  end
+
+  test "removes uploaded objects when a later file makes the import fail" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("first file"), filename: "first.txt", content_type: "text/plain")
+    embedded = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("second file"), filename: "second.txt", content_type: "text/plain")
+    card.update!(description: ActionText::Attachment.from_attachable(embedded).to_html)
+
+    invalid_zip = Tempfile.new([ "invalid-files", ".zip" ])
+    invalid_zip.binmode
+    with_exported_account do |reader|
+      file_paths = reader.glob("files/*")
+      compressed_path = file_paths.last
+      writer = ZipFile::Writer.new(invalid_zip)
+
+      reader.entries.each_key do |path|
+        compress = !path.start_with?("files/") || path == compressed_path
+        writer.add_file(path, compress: compress) do |sink|
+          IO.copy_stream(reader.io_for(path), sink)
+        end
+      end
+      writer.close
+    end
+    invalid_zip.rewind
+
+    storage_file_count = -> { Dir.glob(File.join(storage_root, "**", "*")).count { |entry| File.file?(entry) } }
+    files_before = storage_file_count.call
+
+    assert_no_difference -> { Account.count } do
+      assert_raises ZipFile::Reader::InvalidArchive do
+        Account::DataTransfer::Importer.new(identity: identities(:mike)).import(invalid_zip)
+      end
+    end
+    assert_equal files_before, storage_file_count.call
+  ensure
+    invalid_zip&.close!
+  end
+
+  private
+    def storage_root
+      ActiveStorage::Blob.service.instance_variable_get(:@root)
+    end
+
+    def with_exported_account
+      tempfile = Tempfile.new([ "account", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      Account::DataTransfer::Manifest.new(@account).export(writer)
+      writer.close
+      tempfile.rewind
+      yield ZipFile::Reader.new(tempfile)
+    ensure
+      tempfile&.close!
+    end
+end
