+require "test_helper"
+
+class Exports::DownloadsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.account = accounts(:"37s")
+    @export = Export.create!(
+      account: Current.account,
+      user: users(:kevin),
+      identity: identities(:kevin),
+      kind: :account,
+      status: :completed
+    )
+    @export.file.attach(io: StringIO.new("zip bytes"), filename: "account.zip", content_type: "application/zip")
+    @download_id = @export.download_id
+  end
+
+  test "valid bearer link redirects without authentication" do
+    untenanted do
+      get export_download_path(@download_id)
+    end
+
+    assert_response :redirect
+    assert_match(/account\.zip/, response.location)
+  end
+
+  test "expired bearer link is not found" do
+    travel 1.day + 1.second
