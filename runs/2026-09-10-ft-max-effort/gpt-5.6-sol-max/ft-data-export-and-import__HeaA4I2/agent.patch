--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,49 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  before_action :set_storage_account
+
+  def new
+  end
+
+  def create
+    Import.start(
+      account: @storage_account,
+      identity: Current.identity,
+      file: import_params.fetch(:file)
+    )
+
+    redirect_to session_menu_path(script_name: nil), notice: "We're importing your account. We'll email you when it's done."
+  rescue ActionController::ParameterMissing, ActiveRecord::RecordInvalid, ActiveRecord::RecordNotSaved => error
+    @error_message = error_message_for(error)
+    render :new, status: :unprocessable_entity
+  end
+
+  private
+    def set_storage_account
+      users = Current.identity.users_with_active_accounts.active
+      @storage_account = if params[:account_id].present?
+        users.find_by(account_id: params[:account_id])&.account
+      else
+        users.first&.account
+      end
+
+      unless @storage_account
+        redirect_to session_menu_path(script_name: nil), alert: "You need an active account before you can import one."
+      end
+    end
+
+    def import_params
+      params.expect(import: [ :file ])
+    end
+
+    def error_message_for(error)
+      if error.respond_to?(:record) && error.record.errors.any?
+        error.record.errors.full_messages.to_sentence
+      else
+        "Choose a Fizzy .zip account export to import."
+      end
+    end
+end
