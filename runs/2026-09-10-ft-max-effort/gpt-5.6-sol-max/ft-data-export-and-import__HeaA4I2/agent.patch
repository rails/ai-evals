+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    clear_enqueued_jobs
+  end
+
+  test "new is available outside an account URL" do
+    untenanted do
+      get new_account_import_path(account_id: accounts(:initech).id)
+    end
+
+    assert_response :success
+    assert_select "form[action='#{account_imports_path(script_name: nil)}']"
+    assert_select "input[data-direct-upload-url='#{rails_direct_uploads_path(script_name: accounts(:initech).slug)}']"
+  end
+
+  test "queues an account import" do
+    file = fixture_file_upload("avatar.png", "application/zip")
+    file.define_singleton_method(:original_filename) { "account.zip" }
+
+    assert_difference -> { Import.count }, 1 do
+      assert_enqueued_with(job: Import::ProcessJob) do
+        untenanted do
+          post account_imports_path, params: {
+            account_id: accounts(:initech).id,
+            import: { file: file }
+          }
+        end
+      end
+    end
+
+    assert_redirected_to session_menu_path(script_name: nil)
+  end
+
+  test "rejects a missing file" do
+    assert_no_difference -> { Import.count } do
+      untenanted do
+        post account_imports_path, params: { account_id: accounts(:initech).id, import: {} }
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
