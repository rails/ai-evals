new file mode 100644
index 0000000..6df45c4
--- /dev/null
+++ b/test/controllers/join_codes_email_code_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class JoinCodesEmailCodeTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "joins a new identity with an emailed code" do
+    email_address = "new-email-join@example.com"
+
+    assert_difference [ -> { Identity.count }, -> { User.count }, -> { @join_code.reload.usage_count } ], 1 do
+      assert_emails 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email_address }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_url(script_name: @account.slug)
+
+    identity = Identity.find_by!(email_address: email_address)
+    user = @account.users.find_by!(identity: identity)
+    assert_not user.verified?
+    assert_equal email_address, user.name
+
+    assert_difference -> { identity.sessions.count }, 1 do
+      post session_magic_link_path(script_name: @account.slug), params: { code: code_from_last_email }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+
+    post users_verifications_path(script_name: @account.slug)
+    assert_redirected_to new_users_join_path(script_name: @account.slug)
+    assert user.reload.verified?
+
+    post users_joins_path(script_name: @account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path(script_name: @account.slug)
+    assert_equal "New Member", user.reload.name
+  end
+
+  test "joins an existing identity that is not yet in the account" do
+    identity = identities(:mike)
+
+    assert_no_difference -> { Identity.count } do
+      assert_difference [ -> { User.count }, -> { @join_code.reload.usage_count } ], 1 do
+        assert_emails 1 do
+          post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+        end
+      end
+    end
+
+    post session_magic_link_path(script_name: @account.slug), params: { code: code_from_last_email }
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert_equal identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "signs an existing account member in without using the join code again" do
+    identity = identities(:jz)
+
+    assert_no_difference [ -> { Identity.count }, -> { User.count }, -> { @join_code.reload.usage_count } ] do
+      assert_emails 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+      end
+    end
+
+    post session_magic_link_path(script_name: @account.slug), params: { code: code_from_last_email }
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+    assert_equal identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "an expired join code authentication leaves the member unverified" do
+    email_address = "expired-email-join@example.com"
+
+    assert_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email_address }
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    user = @account.users.find_by!(identity: identity)
+    code = code_from_last_email
+    token = cookies[:pending_authentication_token]
+
+    travel MagicLink::EXPIRATION + 1.second do
+      cookies[:pending_authentication_token] = token
+
+      assert_no_difference -> { identity.sessions.count } do
+        post session_magic_link_path(script_name: @account.slug), params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not user.reload.verified?
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create via JSON returns a pending authentication token" do
+    email_address = "json-email-join@example.com"
+
+    assert_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email_address }, as: :json
+    end
+
+    assert_response :created
+    assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+  end
+
+  private
+    def code_from_last_email
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
