@@ -0,0 +1,58 @@
+class Sessions::MagicLinksController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  before_action :set_magic_link
+
+  def new
+    redirect_to new_session_path(script_name: nil) unless @magic_link
+  end
+
+  def create
+    if @magic_link&.authenticates?(params.expect(:code)) && (identity = Identity.find_by(id: @magic_link.identity_id, email_address: @magic_link.email_address))
+      complete_authentication identity
+    else
+      authentication_failed
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = pending_authentication
+    end
+
+    def complete_authentication(identity)
+      start_new_session_for identity
+      clear_pending_authentication
+
+      respond_to do |format|
+        format.html { redirect_to @magic_link.return_to.presence || after_authentication_url, allow_other_host: false }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def authentication_failed
+      respond_to do |format|
+        format.html { redirect_to retry_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+
+    def retry_path
+      if @magic_link
+        new_session_magic_link_path
+      else
+        new_session_path(script_name: nil)
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
