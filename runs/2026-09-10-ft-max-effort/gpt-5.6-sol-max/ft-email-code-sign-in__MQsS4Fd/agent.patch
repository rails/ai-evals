+    mail = MagicLinkMailer.magic_link(email_address: "david@example.com", code: "ABC123")
+
+    assert_equal [ "david@example.com" ], mail.to
+    assert_equal "ABC123 is your Fizzy sign-in code", mail.subject
+    assert_includes mail.text_part.body.decoded, "ABC123"
+    assert_includes mail.html_part.body.decoded, "ABC123"
+    assert_includes mail.text_part.body.decoded, "15 minutes"
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..71c4b5c
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity_id = identities(:david).id
+  end
+
+  test "generates a six-character code" do
+    magic_link = MagicLink.new(identity_id: @identity_id, email_address: "david@example.com")
+
+    assert_match(/\A[A-Z0-9]{6}\z/, magic_link.code)
+  end
+
+  test "round trips through an encrypted token" do
+    magic_link = MagicLink.new(
+      identity_id: @identity_id,
+      email_address: "david@example.com",
+      code: "ABC123",
+      return_to: "https://example.com/123/landing"
+    )
+
+    token = magic_link.token
+    parsed_magic_link = MagicLink.from_token(token)
+
+    assert_not_includes token, magic_link.code
+    assert_equal magic_link.identity_id, parsed_magic_link.identity_id
+    assert_equal magic_link.email_address, parsed_magic_link.email_address
+    assert_equal magic_link.code, parsed_magic_link.code
+    assert_equal magic_link.return_to, parsed_magic_link.return_to
+  end
+
+  test "authenticates a code without regard to case or surrounding whitespace" do
+    magic_link = MagicLink.new(identity_id: @identity_id, email_address: "david@example.com", code: "ABC123")
+
+    assert magic_link.authenticates?(" abc123 ")
+    assert_not magic_link.authenticates?("ABC124")
+    assert_not magic_link.authenticates?(nil)
+  end
+
+  test "rejects a tampered token" do
+    token = MagicLink.new(identity_id: @identity_id, email_address: "david@example.com").token
+
+    assert_nil MagicLink.from_token("#{token}tampered")
+  end
+
+  test "expires after fifteen minutes" do
+    freeze_time do
+      token = MagicLink.new(identity_id: @identity_id, email_address: "david@example.com").token
+
+      travel 15.minutes - 1.second
+      assert MagicLink.from_token(token)
+
+      travel 2.seconds
+      assert_nil MagicLink.from_token(token)
+    end
+  end
+end
