diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..b3e7c4e
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,51 @@
+class MagicLink
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  PURPOSE = :magic_link
+  ENCRYPTOR = ActiveSupport::MessageEncryptor.new(
+    Rails.application.key_generator.generate_key("magic_links", ActiveSupport::MessageEncryptor.key_len),
+    url_safe: true
+  )
+  private_constant :ENCRYPTOR
+
+  attr_reader :code, :email_address, :identity_id, :return_to
+
+  class << self
+    def from_token(token)
+      if token.present?
+        attributes = ENCRYPTOR.decrypt_and_verify(token, purpose: PURPOSE)
+        new(**attributes.symbolize_keys) if attributes
+      end
+    rescue ActiveSupport::MessageEncryptor::InvalidMessage
+      nil
+    end
+  end
+
+  def initialize(identity_id:, email_address:, code: generate_code, return_to: nil)
+    @email_address = email_address
+    @identity_id = identity_id
+    @code = code
+    @return_to = return_to
+  end
+
+  def authenticates?(candidate_code)
+    if candidate_code.present?
+      ActiveSupport::SecurityUtils.secure_compare(code, candidate_code.to_s.strip.upcase)
+    else
+      false
+    end
+  end
+
+  def token
+    ENCRYPTOR.encrypt_and_sign(
+      { identity_id: identity_id, email_address: email_address, code: code, return_to: return_to },
+      expires_in: EXPIRATION,
+      purpose: PURPOSE
+    )
+  end
+
+  private
+    def generate_code
+      SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+end
