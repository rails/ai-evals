+require "test_helper"
+
+class SignupsEmailCodeTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "signs up with an emailed code" do
+    email_address = "new-email-signup@example.com"
+
+    assert_difference -> { Identity.count }, 1 do
+      untenanted do
+        assert_emails 1 do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+
+        assert_redirected_to new_session_magic_link_path
+      end
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    code = code_from_last_email
+
+    assert_difference -> { identity.sessions.count }, 1 do
+      untenanted do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_signup_completion_url(script_name: nil)
+    assert cookies[:session_token].present?
+
+    assert_difference -> { Account.count }, 1 do
+      untenanted do
+        post signup_completion_path(script_name: nil), params: { signup: { full_name: "New Person" } }
+      end
+    end
+
+    account = identity.accounts.order(:created_at).last
+    assert_equal "New Person", account.users.find_by!(identity: identity).name
+    assert_response :redirect
+  end
+
+  test "sends a code when signing up an existing identity without creating another identity" do
+    identity = identities(:david)
+
+    assert_no_difference -> { Identity.count } do
+      untenanted do
+        assert_emails 1 do
+          post signup_path, params: { signup: { email_address: identity.email_address } }
+        end
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+  end
+
+  test "an expired signup code does not create an account or session" do
+    email_address = "expired-email-signup@example.com"
+
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    code = code_from_last_email
+    token = cookies[:pending_authentication_token]
+
+    travel MagicLink::EXPIRATION + 1.second do
+      cookies[:pending_authentication_token] = token
+
+      assert_no_difference [ -> { Account.count }, -> { identity.sessions.count } ] do
+        untenanted do
+          post session_magic_link_path(script_name: nil), params: { code: code }
+        end
+      end
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "create via JSON returns a pending authentication token" do
+    email_address = "json-email-signup@example.com"
+
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { email_address: email_address }, as: :json
+      end
+    end
+
+    assert_response :created
+    assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+    assert Identity.exists?(email_address: email_address)
+  end
+
+  private
+    def code_from_last_email
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
