+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:david)
+  end
+
+  test "new shows the code form for a pending authentication" do
+    request_magic_link
+
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "form[action='#{session_magic_link_path(script_name: nil)}']"
+    assert_select "input[name=code][autocomplete=one-time-code][maxlength=6]"
+    assert_in_body @identity.email_address
+  end
+
+  test "new redirects to sign in without a pending authentication" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to new_session_path(script_name: nil)
+    end
+  end
+
+  test "create starts a session with the emailed code" do
+    code = request_magic_link
+
+    assert_difference -> { @identity.sessions.count }, 1 do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to landing_path(script_name: nil)
+    assert cookies[:session_token].present?
+    assert_not cookies[:pending_authentication_token].present?
+  end
+
+  test "create accepts a lower-case code with surrounding whitespace" do
+    code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: " #{code.downcase} " }
+    end
+
+    assert_redirected_to landing_path(script_name: nil)
+    assert cookies[:session_token].present?
+  end
+
+  test "create rejects the wrong code and allows another attempt" do
+    request_magic_link
+
+    assert_no_difference -> { @identity.sessions.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: "WRONG1" }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+    assert cookies[:pending_authentication_token].present?
+  end
+
+  test "create rejects an expired code" do
+    code = request_magic_link
+    token = cookies[:pending_authentication_token]
+
+    travel MagicLink::EXPIRATION + 1.second do
+      cookies[:pending_authentication_token] = token
+
+      assert_no_difference -> { @identity.sessions.count } do
+        untenanted do
+          post session_magic_link_path, params: { code: code }
+        end
+      end
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create rejects a tampered pending authentication token" do
+    code = request_magic_link
+    cookies[:pending_authentication_token] = "#{cookies[:pending_authentication_token]}tampered"
+
+    assert_no_difference -> { @identity.sessions.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create does not authenticate a replacement identity with the same email address" do
+    code = request_magic_link
+    original_email_address = @identity.email_address
+    @identity.update!(email_address: "changed@example.com")
+    replacement_identity = Identity.create!(email_address: original_email_address)
+
+    assert_no_difference -> { replacement_identity.sessions.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create via JSON returns a session token" do
+    code = request_magic_link(as: :json)
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }, as: :json
+    end
+
+    assert_response :success
+    assert @response.parsed_body["session_token"].present?
+    assert cookies[:session_token].present?
+  end
+
+  test "create via JSON rejects the wrong code" do
+    request_magic_link(as: :json)
+
+    untenanted do
+      post session_magic_link_path, params: { code: "WRONG1" }, as: :json
+    end
+
+    assert_response :unauthorized
+    assert_equal "That code didn't work. Try again.", @response.parsed_body["message"]
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create is rate limited" do
+    code = request_magic_link
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert_equal "Try again later.", flash[:alert]
+    assert_not cookies[:session_token].present?
+  end
+
+  private
+    def request_magic_link(as: nil)
+      untenanted do
+        assert_emails 1 do
+          post session_path, params: { email_address: @identity.email_address }, as: as
+        end
+      end
+
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
