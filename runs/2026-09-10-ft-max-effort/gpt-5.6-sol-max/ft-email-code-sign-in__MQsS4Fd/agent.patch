+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <label class="input">
+      <span class="for-screen-reader">Sign-in code</span>
+      <%= form.text_field :code, required: true, class: "input txt-x-large full-width", autofocus: true, autocomplete: "one-time-code", inputmode: "text", maxlength: MagicLink::CODE_LENGTH, pattern: "[A-Za-z0-9]{#{MagicLink::CODE_LENGTH}}", placeholder: "Enter your code…" %>
+    </label>
+
+    <p>We sent a six-character code to <strong><%= @magic_link.email_address %></strong>. It works for 15 minutes.</p>
+
+    <% if Rails.env.development? %>
+      <p class="txt-small txt-subtle">Psst, here's your code: <strong><%= @magic_link.code %></strong></p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Sign in</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
