diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..2ec59ea
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,53 @@
+# Replace this with the hostname that points at your server.
+x-host: &host <%= ENV.fetch("FIZZY_HOST", "fizzy.example.com") %>
+
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - *host
+
+proxy:
+  ssl: true
+  host: *host
+  healthcheck:
+    path: /up
+
+# A local registry keeps this one-server setup independent of an external image registry.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: <%= ENV.fetch("KAMAL_ARCH", "amd64") %>
+
+# SQLite databases and uploaded files both live here.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: true
+    FIZZY_HOST: *host
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_USERNAME: fizzy
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
