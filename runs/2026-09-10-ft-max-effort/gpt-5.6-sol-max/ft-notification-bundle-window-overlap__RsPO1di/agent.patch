+require "test_helper"
+
+class Notification::Bundle::DeliveryJobTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @user = users(:jz)
+    @user.settings.every_few_hours!
+    @notification = travel_to(Time.zone.parse("2030-09-11 09:00:00")) do
+      @user.notifications.create!(source: events(:logo_assignment_jz), creator: users(:david))
+    end
+    @bundle = @notification.notification_bundles.sole
+  end
+
+  test "scheduled delivery sends one account-scoped digest" do
+    assert_emails 1 do
+      perform_enqueued_jobs only: Notification::Bundle::DeliveryJob, at: @bundle.ends_at
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match @bundle.account.slug, email.body.encoded
+    assert @bundle.reload.delivered_at.present?
+  end
+end
