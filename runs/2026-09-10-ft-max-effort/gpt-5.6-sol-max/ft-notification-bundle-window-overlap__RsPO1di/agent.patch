@@ -0,0 +1,23 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequencies are restricted to the supported choices" do
+    assert_equal %w[ never every_few_hours daily weekly ], User::Settings.bundle_email_frequencies.keys
+  end
+
+  test "bundle email intervals match their frequencies" do
+    settings = user_settings(:kevin_settings)
+
+    assert_nil settings.tap(&:never!).bundle_email_interval
+    assert_equal 4.hours, settings.tap(&:every_few_hours!).bundle_email_interval
+    assert_equal 1.day, settings.tap(&:daily!).bundle_email_interval
+    assert_equal 1.week, settings.tap(&:weekly!).bundle_email_interval
+  end
+
+  test "bundle emails are enabled for timed frequencies only" do
+    settings = user_settings(:kevin_settings)
+
+    refute settings.tap(&:never!).bundle_emails?
+    assert settings.tap(&:daily!).bundle_emails?
+  end
+end
