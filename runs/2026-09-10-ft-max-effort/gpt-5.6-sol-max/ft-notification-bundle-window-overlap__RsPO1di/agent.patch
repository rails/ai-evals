@@ -0,0 +1,43 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:jz)
+    @user.settings.daily!
+    @notification = travel_to(Time.zone.parse("2026-09-11 09:00:00")) do
+      @user.notifications.create!(source: events(:logo_assignment_jz), creator: users(:david))
+    end
+    @bundle = @notification.notification_bundles.sole
+  end
+
+  test "bundle is a multipart digest addressed to the user" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "1 new notification in #{@bundle.account.name}", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+
+  test "bundle includes its notification and account-scoped links" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_match @notification.card.title, email.body.encoded
+    assert_match @notification.card.board.name, email.body.encoded
+    assert_match @bundle.account.slug, email.body.encoded
+  end
+
+  test "bundle renders mentions" do
+    user = users(:david)
+    user.settings.daily!
+    notification = notifications(:logo_mentioned_david)
+    bundle = travel_to(Time.zone.parse("2030-09-12 09:00:00")) do
+      Notification::Bundle.record(notification)
+    end
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_match "mentioned you", email.body.encoded
+    assert_match "I agree.", email.body.encoded
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..b3919a1
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @user = users(:jz)
+    @user.settings.every_few_hours!
+    @start = Time.zone.parse("2030-09-11 09:00:00")
+    clear_enqueued_jobs
+  end
+
+  test "the first notification starts a window for the selected frequency" do
+    notification = nil
+
+    travel_to @start do
+      assert_enqueued_with job: Notification::Bundle::DeliveryJob, at: @start + 4.hours do
+        notification = create_notification(events(:logo_assignment_jz))
+      end
+    end
+
+    bundle = notification.notification_bundles.sole
+    assert_equal @start, bundle.starts_at
+    assert_equal @start + 4.hours, bundle.ends_at
+    assert_equal @start...(@start + 4.hours), bundle.window
+  end
+
+  test "notifications that land while a window is open reuse it" do
+    first = travel_to(@start) { create_notification(events(:logo_assignment_jz)) }
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      second = travel_to(@start + 2.hours) { create_notification(events(:layout_assignment_jz)) }
+      assert_equal first.notification_bundles.sole, second.notification_bundles.sole
+    end
+
+    assert_equal 2, first.notification_bundles.sole.entries.count
+  end
+
+  test "a delayed notification with an old source joins the open window" do
+    first = travel_to(@start) { create_notification(events(:logo_assignment_jz)) }
+    old_source = events(:layout_assignment_jz)
+    assert_operator old_source.created_at, :<, @start
+
+    delayed = travel_to(@start + 3.hours) { create_notification(old_source) }
+
+    assert_equal first.notification_bundles.sole, delayed.notification_bundles.sole
+    assert_equal @start + 3.hours, delayed.notification_bundle_entries.sole.landed_at
+  end
+
+  test "manual bundling anchors an old notification at the time it lands" do
+    @user.settings.never!
+    notification = @user.notifications.create!(
+      source: events(:logo_assignment_jz),
+      creator: users(:david),
+      created_at: 1.year.ago,
+      updated_at: 1.year.ago
+    )
+    @user.settings.every_few_hours!
+
+    bundle = travel_to(@start) { Notification::Bundle.record(notification) }
+
+    assert_equal @start, bundle.starts_at
+    assert_equal @start, bundle.entries.sole.landed_at
+  end
+
+  test "a notification at the end boundary starts a new non-overlapping window" do
+    first = travel_to(@start) { create_notification(events(:logo_assignment_jz)) }
+    first_bundle = first.notification_bundles.sole
+
+    second = travel_to(first_bundle.ends_at) { create_notification(events(:layout_assignment_jz)) }
+    second_bundle = second.notification_bundles.sole
+
+    assert_not_equal first_bundle, second_bundle
+    assert_equal first_bundle.ends_at, second_bundle.starts_at
+    assert_operator first_bundle.ends_at, :<=, second_bundle.starts_at
+  end
+
+  test "only a new window schedules a delivery" do
+    travel_to @start do
+      assert_enqueued_jobs 1, only: Notification::Bundle::DeliveryJob do
+        create_notification(events(:logo_assignment_jz))
+        travel 1.hour
+        create_notification(events(:layout_assignment_jz))
+      end
+    end
+  end
+
+  test "never does not create a bundle or schedule delivery" do
+    @user.settings.never!
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+        travel_to(@start) { create_notification(events(:logo_assignment_jz)) }
+      end
+    end
+  end
+
+  test "each timed frequency controls the window length" do
+    {
+      every_few_hours: 4.hours,
+      daily: 1.day,
+      weekly: 1.week
+    }.each_with_index do |(frequency, interval), index|
+      @user.settings.public_send("#{frequency}!")
+      landed_at = @start + index.months
+
+      notification = travel_to(landed_at) do
+        create_notification([ events(:logo_assignment_jz), events(:layout_assignment_jz), events(:buy_domain_sent_back_to_triage) ][index])
+      end
+
+      assert_equal interval, notification.notification_bundles.sole.ends_at - landed_at
+    end
+  end
+
+  test "a coalesced notification has one entry per window with its latest source" do
+    notification = travel_to(@start) { create_notification(events(:logo_published)) }
+    bundle = notification.notification_bundles.sole
+
+    travel_to @start + 1.hour do
+      notification.update!(source: events(:logo_assignment_jz), creator: users(:david))
+    end
+
+    assert_equal 1, bundle.entries.count
+    assert_equal events(:logo_assignment_jz), bundle.entries.sole.source
+    assert_equal @start + 1.hour, bundle.entries.sole.landed_at
+  end
+
+  test "the same coalesced notification can have entries in consecutive windows" do
+    notification = travel_to(@start) { create_notification(events(:logo_published)) }
+
+    travel_to @start + 5.hours do
+      notification.update!(source: events(:logo_assignment_jz), creator: users(:david))
+    end
+
+    assert_equal 2, notification.notification_bundles.count
+    assert_equal 2, notification.notification_bundle_entries.count
+    assert_equal [ events(:logo_published), events(:logo_assignment_jz) ],
+      notification.notification_bundle_entries.order(:landed_at).map(&:source)
+  end
+
+  test "deleting an old snapshotted source removes its bundle entry" do
+    old_source = events(:logo_published)
+    notification = travel_to(@start) { create_notification(old_source) }
+    old_entry = notification.notification_bundle_entries.sole
+
+    travel_to @start + 5.hours do
+      notification.update!(source: events(:logo_assignment_jz), creator: users(:david))
+    end
+
+    assert_difference -> { Notification::Bundle::Entry.count }, -1 do
+      old_source.destroy!
+    end
+    refute Notification::Bundle::Entry.exists?(old_entry.id)
+    assert_equal 1, notification.notification_bundle_entries.count
+  end
+
+  test "overlapping windows are rejected while adjacent windows are allowed" do
+    first = Notification::Bundle.create!(user: @user, starts_at: @start, ends_at: @start + 4.hours)
+
+    overlapping = Notification::Bundle.new(user: @user, starts_at: @start + 1.hour, ends_at: @start + 5.hours)
+    refute overlapping.valid?
+    assert_includes overlapping.errors[:base], "Notification bundle windows cannot overlap"
+
+    adjacent = Notification::Bundle.new(user: @user, starts_at: first.ends_at, ends_at: first.ends_at + 4.hours)
+    assert adjacent.valid?
+    assert adjacent.save
+  end
+
+  test "different users can have overlapping windows" do
+    Notification::Bundle.create!(user: @user, starts_at: @start, ends_at: @start + 4.hours)
+
+    other = Notification::Bundle.new(user: users(:kevin), starts_at: @start, ends_at: @start + 4.hours)
+    assert other.valid?
+  end
+
+  test "an entry must land inside its bundle window" do
+    notification = travel_to(@start) { create_notification(events(:logo_assignment_jz)) }
+    bundle = notification.notification_bundles.sole
+
+    entry = bundle.entries.build(notification:, landed_at: bundle.ends_at)
+    entry.assign_snapshot(notification, landed_at: bundle.ends_at)
+
+    refute entry.valid?
+    assert entry.errors[:landed_at].any?
+  end
+
+  test "delivery sends one email and is idempotent" do
+    notification = travel_to(@start) { create_notification(events(:logo_assignment_jz)) }
+    bundle = notification.notification_bundles.sole
+
+    assert_emails 1 do
+      bundle.deliver
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered_at.present?
+  end
+
+  test "turning email bundles off before delivery suppresses the email" do
+    notification = travel_to(@start) { create_notification(events(:logo_assignment_jz)) }
+    bundle = notification.notification_bundles.sole
+    @user.settings.never!
+
+    assert_no_emails { bundle.deliver }
+    assert bundle.reload.delivered_at.present?
+  end
+
+  private
+    def create_notification(source)
+      @user.notifications.create!(source:, creator: source.creator)
+    end
+end
