diff --git a/app/views/mailers/notification_mailer/bundle.html.erb b/app/views/mailers/notification_mailer/bundle.html.erb
new file mode 100644
index 0000000..b8be85d
--- /dev/null
+++ b/app/views/mailers/notification_mailer/bundle.html.erb
@@ -0,0 +1,27 @@
+<h1 class="title"><%= pluralize(@entries.size, "new notification") %> in <%= @bundle.account.name %></h1>
+<p class="subtitle">Here’s what happened while you were away.</p>
+
+<% @entries.group_by { |entry| entry.card.board }.each_with_index do |(board, entries), index| %>
+  <hr class="notification__board-separator" <%= "hidden" if index.zero? %>>
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% entries.each do |entry| %>
+    <table class="notification" role="presentation">
+      <tr>
+        <td class="avatar__container"><%= mail_avatar_tag(entry.creator) if entry.creator %></td>
+        <td>
+          <h3 class="card__title"><%= link_to entry.payload.title, entry.payload.url %></h3>
+          <p class="notification__details"><%= entry.payload.body %></p>
+          <% if entry.creator %>
+            <p class="notification__author"><%= entry.creator.name %></p>
+          <% end %>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "See all notifications", notifications_url %>
+  · <%= link_to "Change email frequency", notifications_settings_url %>
+</p>
