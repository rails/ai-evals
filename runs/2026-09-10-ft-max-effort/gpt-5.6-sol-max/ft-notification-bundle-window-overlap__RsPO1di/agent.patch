diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..9612c20
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,103 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :entries, -> { order(:landed_at, :id) },
+    class_name: "Notification::Bundle::Entry", dependent: :destroy, inverse_of: :bundle
+  has_many :notifications, through: :entries
+
+  scope :containing, ->(time) { where("starts_at <= ? AND ends_at > ?", time, time) }
+  scope :overlapping, ->(starts_at, ends_at) { where("starts_at < ? AND ends_at > ?", ends_at, starts_at) }
+
+  attr_readonly :account_id, :user_id, :starts_at, :ends_at
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_it_starts
+  validate :does_not_overlap
+
+  around_create :serialize_creation
+  after_create_commit :deliver_later
+
+  class << self
+    def record(notification, landed_at: Time.current)
+      user = notification.user
+
+      if user_can_receive_bundle_emails?(user)
+        user.with_lock do
+          settings = user.settings.reload
+
+          if settings.bundle_emails?
+            bundle = where(user:).containing(landed_at).first || create!(
+              user:,
+              starts_at: landed_at,
+              ends_at: landed_at + settings.bundle_email_interval
+            )
+            bundle.add(notification, landed_at:)
+            bundle
+          end
+        end
+      end
+    end
+
+    private
+      def user_can_receive_bundle_emails?(user)
+        user.active? && user.identity.present? && user.account.active? && user.settings.present?
+      end
+  end
+
+  def window
+    starts_at...ends_at
+  end
+
+  def add(notification, landed_at: Time.current)
+    entries.find_or_initialize_by(notification:).tap do |entry|
+      entry.assign_snapshot(notification, landed_at:)
+      entry.save! if entry.changed?
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    with_lock do
+      if delivered_at.nil?
+        NotificationMailer.bundle(self).deliver_now if deliverable?
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      entries.exists? && user.active? && user.identity.present? && account.active? && user.settings&.reload&.bundle_emails?
+    end
+
+    def ends_after_it_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after the start of the window")
+      end
+    end
+
+    def does_not_overlap
+      if user_id.present? && starts_at.present? && ends_at.present? && overlapping_windows.exists?
+        errors.add(:base, "Notification bundle windows cannot overlap")
+      end
+    end
+
+    def overlapping_windows
+      self.class.where(user_id:).where.not(id:).overlapping(starts_at, ends_at)
+    end
+
+    def serialize_creation
+      user.with_lock do
+        if overlapping_windows.lock.load.any?
+          errors.add(:base, "Notification bundle windows cannot overlap")
+          throw :abort
+        else
+          yield
+        end
+      end
+    end
+end
diff --git a/app/models/notification/bundle/entry.rb b/app/models/notification/bundle/entry.rb
new file mode 100644
index 0000000..a243033
--- /dev/null
+++ b/app/models/notification/bundle/entry.rb
@@ -0,0 +1,44 @@
+class Notification::Bundle::Entry < ApplicationRecord
+  belongs_to :account, default: -> { bundle.account }
+  belongs_to :bundle, class_name: "Notification::Bundle", foreign_key: :notification_bundle_id, inverse_of: :entries
+  belongs_to :notification
+  belongs_to :source, polymorphic: true
+  belongs_to :creator, class_name: "User", optional: true
+  belongs_to :card
+
+  delegate :user, to: :bundle
+
+  validates :notification_id, uniqueness: { scope: :notification_bundle_id }
+  validate :notification_belongs_to_bundle_user
+  validate :landed_inside_bundle_window
+
+  def payload
+    "Notification::#{payload_type}Payload".constantize.new(self)
+  end
+
+  def assign_snapshot(notification, landed_at: Time.current)
+    assign_attributes(
+      source: notification.source,
+      creator: notification.creator,
+      card: notification.card,
+      landed_at:
+    )
+  end
+
+  private
+    def payload_type
+      source_type.presence_in(%w[ Event Mention ]) || "Default"
+    end
+
+    def notification_belongs_to_bundle_user
+      if notification && bundle && notification.user_id != bundle.user_id
+        errors.add(:notification, "must belong to the bundle's user")
+      end
+    end
+
+    def landed_inside_bundle_window
+      if landed_at && bundle && !bundle.window.cover?(landed_at)
+        errors.add(:landed_at, "must be inside the bundle window")
+      end
+    end
+end
