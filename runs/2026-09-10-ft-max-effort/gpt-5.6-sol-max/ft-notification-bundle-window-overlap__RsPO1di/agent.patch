+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :notification_bundle_entries, class_name: "Notification::Bundle::Entry", dependent: :destroy
+    has_many :notification_bundles, through: :notification_bundle_entries, source: :bundle
+
+    after_save_commit :bundle_for_email, if: :notification_source_previously_changed?
+  end
+
+  private
+    def bundle_for_email
+      Notification::Bundle.record(self)
+    end
+
+    def notification_source_previously_changed?
+      source_id_previously_changed? || source_type_previously_changed?
+    end
+end
