index 0000000..2282a0d
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,19 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @entries = bundle.entries.chronologically.includes(:creator, :source, card: :board)
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      if @entries.one?
+        "A new notification in #{@account.name}"
+      else
+        "#{@entries.size} new notifications in #{@account.name}"
+      end
+    end
+end
