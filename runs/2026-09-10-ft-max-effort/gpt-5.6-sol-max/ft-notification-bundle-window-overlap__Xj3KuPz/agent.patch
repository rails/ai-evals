+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..36799ba
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,24 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_entries, class_name: "Notification::Bundle::Entry", dependent: :destroy
+    has_many :notification_bundles, through: :bundle_entries, source: :bundle
+
+    after_save_commit :bundle_for_email, if: :notification_source_previously_changed?
+  end
+
+  def bundle_for_email
+    Notification::Bundle.collect(self)
+  end
+
+  def bundle_email_eligible?
+    !creator.system? && user.active? && user.identity.present? && account.active? &&
+      !user.settings.never?
+  end
+
+  private
+    def notification_source_previously_changed?
+      source_id_previously_changed? || source_type_previously_changed?
+    end
+end
