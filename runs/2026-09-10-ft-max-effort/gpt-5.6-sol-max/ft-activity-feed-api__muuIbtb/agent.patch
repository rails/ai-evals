new file mode 100644
index 0000000..801a7c3
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,13 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.preloaded.where(action: Event::ACTIVITY_ACTIONS)
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events = events.where(board_id: params[:board_ids]) if params[:board_ids].present?
+      events.order(created_at: :desc, id: :desc)
+    end
+end
