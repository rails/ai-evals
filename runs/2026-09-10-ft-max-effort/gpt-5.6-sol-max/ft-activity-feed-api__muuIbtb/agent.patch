diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..7e9e100 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,33 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    details = activity_particulars_source
+
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(details["assignee_ids"]) }
+    when "card_board_changed"
+      {
+        old_board: details["old_board"].to_s,
+        new_board: details["new_board"].to_s
+      }
+    when "card_title_changed"
+      {
+        old_title: details["old_title"].to_s,
+        new_title: details["new_title"].to_s
+      }
+    when "card_triaged"
+      { column: details["column"].to_s }
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_particulars_source
+      details = particulars.to_h.with_indifferent_access
+      details["particulars"].is_a?(Hash) ? details["particulars"].with_indifferent_access : details
+    end
 end
