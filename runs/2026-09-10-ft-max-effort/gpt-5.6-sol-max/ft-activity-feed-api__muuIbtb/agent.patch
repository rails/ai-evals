@@ -0,0 +1,110 @@
+# Activities
+
+Activities describe changes to cards and comments across the boards the current user can access.
+
+## `GET /:account_slug/activities.json`
+
+Returns a paginated, flat array of activities, ordered newest first. Activities from boards the current user cannot access are omitted.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `creator_ids[]` | array | No | Only return activities created by these users |
+| `board_ids[]` | array | No | Only return activities from these boards |
+
+The response includes these activity types:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `card_title_changed`
+- `comment_created`
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "comment_created",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David commented on &quot;Plain text mentions&quot;",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3#comment_03f5v9zo9qlcwwpyc0ascnikz",
+    "eventable_type": "Comment",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "updated_at": "2025-12-05T19:36:35.534Z",
+      "body": {
+        "plain_text": "This looks great!",
+        "html": "<div class=\"action-text-content\">This looks great!</div>"
+      },
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7",
+        "avatar_url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7/avatar"
+      },
+      "card": {
+        "id": "03f5v9zo9qlcwwpyc0ascnilz",
+        "url": "http://app.fizzy.localhost:3006/897362094/cards/3"
+      },
+      "reactions_url": "http://app.fizzy.localhost:3006/897362094/cards/3/comments/03f5v9zo9qlcwwpyc0ascnikz/reactions",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/3/comments/03f5v9zo9qlcwwpyc0ascnikz"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm",
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7",
+        "avatar_url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7/avatar"
+      }
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7",
+      "avatar_url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7/avatar"
+    }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as their corresponding API endpoints. For card activities, `url` points to the card. For comment activities, it points to the comment's card with a comment anchor.
+
+The contents of `particulars` depend on the activity type:
+
+| Activity | Particulars |
+|----------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| All other activities | Empty object |
+
+Missing board, title, and column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..1dd2b45
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,240 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat list of timeline activities newest first" do
+    title_change = create_event(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } },
+      created_at: 1.minute.from_now
+    )
+    collection_change = create_event(action: "card_collection_changed", created_at: 2.minutes.from_now)
+    unrelated_event = create_event(action: "card_resumed", created_at: 3.minutes.from_now)
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal title_change.id, @response.parsed_body.first["id"]
+    assert_includes @response.parsed_body.pluck("id"), title_change.id
+    assert_not_includes @response.parsed_body.pluck("id"), collection_change.id
+    assert_not_includes @response.parsed_body.pluck("id"), unrelated_event.id
+    assert_empty @response.parsed_body.pluck("action").uniq - ACTIVITY_ACTIONS
+  end
+
+  test "index as JSON includes the event attributes and existing API representations" do
+    comment_event = events(:layout_commented)
+    comment_event.update!(created_at: 1.minute.from_now)
+
+    get card_comment_path(comment_event.eventable.card, comment_event.eventable), as: :json
+    expected_eventable = @response.parsed_body
+    get board_path(comment_event.board), as: :json
+    expected_board = @response.parsed_body
+    get user_path(comment_event.creator), as: :json
+    expected_creator = @response.parsed_body
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |candidate| candidate["id"] == comment_event.id }
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], activity.keys.sort
+    assert_equal comment_event.action, activity["action"]
+    assert_equal comment_event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal comment_event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal expected_eventable, activity["eventable"]
+    assert_equal expected_board, activity["board"]
+    assert_equal expected_creator, activity["creator"]
+    assert_equal card_url(comment_event.card, anchor: dom_id(comment_event.eventable)), activity["url"]
+  end
+
+  test "card activities use the card representation and URL" do
+    card_event = events(:logo_published)
+    card_event.update!(created_at: 1.minute.from_now)
+
+    get cards_path(format: :json), params: { card_ids: [ card_event.eventable_id ] }
+    expected_eventable = @response.parsed_body.find { |card| card["id"] == card_event.eventable_id }
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |candidate| candidate["id"] == card_event.id }
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal expected_eventable, activity["eventable"]
+    assert_equal card_url(card_event.card), activity["url"]
+  end
+
+  test "index exposes normalized event particulars" do
+    assignment = events(:logo_assignment_jz)
+    assignment.update!(created_at: 10.minutes.from_now)
+    nested_assignment = create_event(
+      action: "card_unassigned",
+      particulars: { particulars: { assignee_ids: [ users(:kevin).id ] } },
+      created_at: 9.minutes.from_now
+    )
+    board_change = create_event(
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Old board", new_board: "New board" } },
+      created_at: 8.minutes.from_now
+    )
+    title_change = create_event(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } },
+      created_at: 7.minutes.from_now
+    )
+    triage = create_event(
+      action: "card_triaged",
+      particulars: { particulars: { column: "In progress" } },
+      created_at: 6.minutes.from_now
+    )
+    missing_board_values = create_event(
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: nil } },
+      created_at: 5.minutes.from_now
+    )
+    missing_title_values = create_event(
+      action: "card_title_changed",
+      particulars: {},
+      created_at: 4.minutes.from_now
+    )
+    missing_column = create_event(
+      action: "card_triaged",
+      particulars: nil,
+      created_at: 3.minutes.from_now
+    )
+    other_event = events(:logo_published)
+    other_event.update!(created_at: 2.minutes.from_now)
+
+    get activities_path(format: :json)
+
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activities.dig(assignment.id, "particulars"))
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, activities.dig(nested_assignment.id, "particulars"))
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activities.dig(board_change.id, "particulars"))
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activities.dig(title_change.id, "particulars"))
+    assert_equal({ "column" => "In progress" }, activities.dig(triage.id, "particulars"))
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.dig(missing_board_values.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.dig(missing_title_values.id, "particulars"))
+    assert_equal({ "column" => "" }, activities.dig(missing_column.id, "particulars"))
+    assert_equal({}, activities.dig(other_event.id, "particulars"))
+  end
+
+  test "index filters by creators and boards" do
+    private_card = create_private_card
+    private_event = create_event(
+      action: "card_published",
+      board: boards(:private),
+      card: private_card,
+      creator: users(:kevin),
+      created_at: 1.minute.from_now
+    )
+    create_event(
+      action: "card_published",
+      board: boards(:private),
+      card: private_card,
+      creator: users(:david),
+      created_at: 2.minutes.from_now
+    )
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "index only returns activity on accessible boards" do
+    private_card = create_private_card
+    private_event = create_event(
+      action: "card_published",
+      board: boards(:private),
+      card: private_card,
+      creator: users(:kevin),
+      created_at: 1.minute.from_now
+    )
+    logout_and_sign_in_as :jz
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_empty @response.parsed_body
+  end
+
+  test "index paginates all activities in a stable newest-first order" do
+    timestamp = 10.minutes.from_now.change(usec: 0)
+    60.times do |index|
+      create_event(action: "card_published", created_at: timestamp + index.seconds)
+    end
+
+    expected_ids = users(:kevin).accessible_events
+      .where(action: ACTIVITY_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+      .pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      assert_includes @response.headers["Link"], "page=2" if page_count == 1
+      assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "index authenticates with an API access token" do
+    cookies.delete :session_token
+    bearer_token = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    get activities_path(format: :json), env: bearer_token
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  private
+    def create_private_card
+      boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :drafted).tap do |card|
+        card.update_column(:status, "published")
+      end
+    end
+
+    def create_event(action:, particulars: {}, board: boards(:writebook), card: cards(:logo), creator: users(:david), created_at: Time.current)
+      Event.create!(
+        action: action,
+        particulars: particulars,
+        board: board,
+        eventable: card,
+        creator: creator,
+        created_at: created_at
+      )
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
