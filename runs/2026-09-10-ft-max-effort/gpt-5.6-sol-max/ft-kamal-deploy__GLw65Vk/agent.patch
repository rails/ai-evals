diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..516d4f3
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,62 @@
+# Replace this with the DNS name pointing at your server.
+x-app-host: &app-host fizzy.example.com
+
+service: fizzy
+image: fizzy
+
+# Fizzy's web server, background jobs, SQLite databases, and uploaded files all
+# run in this one container.
+servers:
+  web:
+    - *app-host
+
+# kamal-proxy obtains and renews a Let's Encrypt certificate for the app host.
+proxy:
+  ssl: true
+  host: *app-host
+
+# Build locally and send the image through Kamal's local registry. This avoids
+# requiring an account with an external container registry.
+registry:
+  server: localhost:5555
+
+builder:
+  # Change to arm64 when the server uses a 64-bit ARM processor.
+  arch: amd64
+
+env:
+  clear:
+    APP_HOST: *app-host
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Replace these values with the settings for your SMTP server and sender.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@fizzy.example.com>
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+
+    # Keep resource usage and SQLite write contention modest on a single box.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    SOLID_QUEUE_IN_PUMA: true
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# This named volume holds every production SQLite database and local Active
+# Storage file, and remains in place when Kamal replaces the app container.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Make assets from the old and new containers available during a deployment.
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
