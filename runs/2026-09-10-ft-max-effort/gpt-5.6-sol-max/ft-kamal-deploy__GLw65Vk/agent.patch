diff --git a/.kamal/read-secret b/.kamal/read-secret
new file mode 100755
index 0000000..93eab6a
--- /dev/null
+++ b/.kamal/read-secret
@@ -0,0 +1,10 @@
+#!/usr/bin/env ruby
+
+# Dotenv expands variables after command substitutions. Escape dollar signs
+# that it would otherwise expand; dotenv removes these escapes when parsing.
+secret = File.binread(ARGV.fetch(0)).chomp
+
+secret.each_byte.with_index do |byte, index|
+  print "\\" if byte == "$".ord && secret.getbyte(index + 1) != "(".ord
+  print byte.chr
+end
