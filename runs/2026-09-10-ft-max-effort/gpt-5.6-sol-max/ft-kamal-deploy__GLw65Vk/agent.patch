new file mode 100644
index 0000000..27bf42f
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,5 @@
+# Keep the values in these gitignored files. read-secret protects characters
+# that dotenv would otherwise interpret after running a command substitution.
+SECRET_KEY_BASE=$(.kamal/read-secret .kamal/secret_key_base)
+SMTP_USERNAME=$(.kamal/read-secret .kamal/smtp_username)
+SMTP_PASSWORD=$(.kamal/read-secret .kamal/smtp_password)
