diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..2aba219
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,30 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    polymorphic_path(reaction_routing_records(reactable, Reaction))
+  end
+
+  def new_reaction_path_for(reactable)
+    new_polymorphic_path(reaction_routing_records(reactable, Reaction))
+  end
+
+  def reaction_path_for(reaction)
+    polymorphic_path(reaction_routing_records(reaction.reactable, reaction))
+  end
+
+  def reaction_url_for(reaction)
+    polymorphic_url(reaction_routing_records(reaction.reactable, reaction))
+  end
+
+  def reaction_form_model(reactable)
+    reaction_routing_records(reactable, Reaction.new)
+  end
+
+  private
+    def reaction_routing_records(reactable, endpoint)
+      if reactable.is_a?(Card)
+        [ reactable, endpoint ]
+      else
+        [ reactable.card, reactable, endpoint ]
+      end
+    end
+end
