+++ b/app/models/account/data_transfer/card_record_set.rb
@@ -0,0 +1,61 @@
+class Account::DataTransfer::CardRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, records: nil)
+    super(account: account, model: Card)
+    @provided_records = records
+  end
+
+  private
+    attr_reader :provided_records
+
+    def records
+      (provided_records || super).includes(
+        :board, :column, :tags, :steps, :rich_text_description,
+        creator: :identity,
+        assignees: :identity
+      )
+    end
+
+    def serialize_record(card)
+      super.merge(
+        "description" => card.description.body.to_s,
+        "board" => { "id" => card.board.id, "name" => card.board.name },
+        "column" => card.column && { "id" => card.column.id, "name" => card.column.name },
+        "creator" => serialize_creator(card.creator),
+        "assignees" => card.assignees.map { |user| serialize_creator(user) },
+        "tags" => card.tags.map { |tag| { "id" => tag.id, "title" => tag.title } },
+        "steps" => card.steps.map { |step| step.attributes.as_json },
+        "comments" => card.comments.chronologically.includes(:rich_text_body, creator: :identity).map { |comment| serialize_comment(comment) },
+        "attachments" => serialize_attachments_for(card)
+      )
+    end
+
+    def serialize_comment(comment)
+      comment.attributes.as_json.merge(
+        "body" => comment.body.body.to_s,
+        "creator" => serialize_creator(comment.creator),
+        "attachments" => serialize_attachments_for(comment)
+      )
+    end
+
+    def serialize_creator(user)
+      {
+        "id" => user.id,
+        "name" => user.name,
+        "email_address" => user.identity&.email_address
+      }
+    end
+
+    def serialize_attachments_for(record)
+      rich_texts = ActionText::RichText.where(record: record)
+      ActiveStorage::Attachment.where(record: [ record, *rich_texts ]).includes(:blob).map do |attachment|
+        {
+          "id" => attachment.id,
+          "name" => attachment.name,
+          "filename" => attachment.blob.filename.to_s,
+          "content_type" => attachment.blob.content_type,
+          "byte_size" => attachment.blob.byte_size,
+          "path" => Account::DataTransfer::ActiveStorage::FileRecordSet.path_for(attachment.blob)
+        }
+      end
+    end
+end
