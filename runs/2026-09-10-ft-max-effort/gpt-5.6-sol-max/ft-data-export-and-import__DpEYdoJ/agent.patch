@@ -0,0 +1,38 @@
+require "test_helper"
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  test "reads and globs streamed entries" do
+    Tempfile.create([ "reader", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      writer.add_file("records/one.json", '{"one":1}')
+      writer.add_file("files/data.bin", "\x00\x01".b, compress: false)
+      writer.close
+      file.rewind
+
+      reader = ZipFile::Reader.new(file)
+      assert_equal [ "records/one.json" ], reader.glob("records/*.json")
+      assert_equal '{"one":1}', reader.read("records/one.json")
+      assert_equal "\x00\x01".b, reader.read("files/data.bin")
+    end
+  end
+
+  test "rejects malformed archives" do
+    error = assert_raises ZipFile::Reader::InvalidArchive do
+      ZipFile::Reader.new(StringIO.new("not a zip"))
+    end
+
+    assert_match "valid ZIP", error.message
+  end
+
+  test "bounds entries read into memory" do
+    Tempfile.create([ "reader", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      writer.add_file("large.json", "12345")
+      writer.close
+      file.rewind
+
+      reader = ZipFile::Reader.new(file)
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader.read("large.json", max_size: 4) }
+    end
+  end
+end
