diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..345922a
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,130 @@
+class Import < ApplicationRecord
+  class InvalidArchive < StandardError; end
+
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  enum :status, pending: "pending", processing: "processing", completed: "completed", failed: "failed"
+
+  validates :status, :source_filename, :source_key, :source_service_name, presence: true
+  validates :source_byte_size, numericality: { greater_than: 0 }
+
+  class << self
+    def create_from!(identity:, io:, filename:)
+      service = ActiveStorage::Blob.service
+      source_key = "imports/#{ActiveStorage::Blob.generate_unique_secure_token}"
+      source_filename = File.basename(filename.to_s.delete("\0")).truncate(255)
+      source_byte_size = size_of(io)
+
+      io.rewind if io.respond_to?(:rewind)
+      service.upload(source_key, io, filename: source_filename, content_type: "application/zip")
+
+      create!(
+        identity: identity,
+        source_filename: source_filename,
+        source_key: source_key,
+        source_service_name: service.name,
+        source_byte_size: source_byte_size
+      )
+    rescue => error
+      begin
+        service&.delete(source_key) if source_key
+      rescue => cleanup_error
+        Rails.error.report(cleanup_error, severity: :error, context: { source: "import staging cleanup" })
+      end
+      raise error
+    end
+
+    private
+      def size_of(io)
+        if io.respond_to?(:size)
+          io.size
+        elsif io.respond_to?(:stat)
+          io.stat.size
+        else
+          raise ArgumentError, "Import file size is unavailable"
+        end
+      end
+  end
+
+  def restore_later
+    Import::RestorationJob.perform_later(self)
+  end
+
+  def restore_now
+    update!(status: :processing, error: nil)
+
+    begin
+      restoration = Account::DataTransfer::Restoration.new(archive_reader, requester: identity)
+      restoration.restore do |restored_account|
+        update!(account: restored_account, status: :completed, error: nil)
+      end
+    rescue => original_error
+      import_error = normalize_error(original_error)
+      mark_failed(import_error)
+      delete_source_file
+      deliver_failure_email
+      raise import_error
+    end
+
+    delete_source_file
+    deliver_completion_email
+    account
+  end
+
+  private
+    def archive_reader
+      ZipFile::Reader.new(
+        ZipFile::ServiceIO.new(
+          service: source_service,
+          key: source_key,
+          size: source_byte_size
+        )
+      )
+    end
+
+    def source_service
+      ActiveStorage::Blob.services.fetch(source_service_name)
+    end
+
+    def delete_source_file
+      source_service.delete(source_key)
+    rescue => cleanup_error
+      Rails.error.report(cleanup_error, severity: :error, context: { import_id: id })
+    end
+
+    def deliver_completion_email
+      ImportMailer.completed(self).deliver_later
+    rescue => delivery_error
+      Rails.error.report(delivery_error, severity: :error, context: { import_id: id })
+    end
+
+    def deliver_failure_email
+      ImportMailer.failed(self).deliver_later
+    rescue => delivery_error
+      Rails.error.report(delivery_error, severity: :error, context: { import_id: id })
+    end
+
+    def normalize_error(error)
+      if error.is_a?(InvalidArchive)
+        error
+      elsif error.is_a?(Account::DataTransfer::Restoration::InvalidArchive) ||
+          error.is_a?(ZipFile::Reader::InvalidArchive) ||
+          error.is_a?(ActiveStorage::FileNotFoundError)
+        InvalidArchive.new(error.message)
+      else
+        error
+      end
+    end
+
+    def mark_failed(error)
+      update_columns(
+        account_id: nil,
+        status: "failed",
+        error: error.message.to_s.presence&.truncate(10_000) || error.class.name,
+        updated_at: Time.current
+      )
+    rescue ActiveRecord::ActiveRecordError
+      # Preserve the original restoration exception if status persistence also fails.
+    end
+end
