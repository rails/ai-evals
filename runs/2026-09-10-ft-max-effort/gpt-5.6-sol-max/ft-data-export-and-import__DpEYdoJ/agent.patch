+require "test_helper"
+
+class ZipFile::ServiceIOTest < ActiveSupport::TestCase
+  setup do
+    @service = ActiveStorage::Blob.service
+    @key = "test-service-io-#{SecureRandom.hex}"
+    @service.upload(@key, StringIO.new("0123456789"))
+  end
+
+  teardown do
+    @service.delete(@key)
+  end
+
+  test "supports seekable reads over a storage service" do
+    io = ZipFile::ServiceIO.new(service: @service, key: @key, size: 10)
+
+    assert_equal "012", io.read(3)
+    assert_equal 3, io.pos
+    assert_equal 0, io.seek(-2, IO::SEEK_END)
+    assert_equal "89", io.read(10)
+    assert io.eof?
+    assert_nil io.read(1)
+  end
+end
