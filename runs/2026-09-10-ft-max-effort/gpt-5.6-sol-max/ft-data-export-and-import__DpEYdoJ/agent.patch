@@ -0,0 +1,29 @@
+require "test_helper"
+
+class ZipFile::EntryIOTest < ActiveSupport::TestCase
+  test "streams a stored entry into Active Storage" do
+    payload = SecureRandom.random_bytes(2.megabytes + 17)
+    source = Tempfile.new([ "entry", ".zip" ], binmode: true)
+    destination_key = "entry-io-test-#{SecureRandom.hex}"
+
+    writer = ZipFile::Writer.new(source)
+    writer.add_file("files/blob", payload, compress: false)
+    writer.close
+    source.rewind
+
+    checksum = Base64.strict_encode64(Digest::MD5.digest(payload))
+    reader = ZipFile::Reader.new(source)
+    entry_io = ZipFile::EntryIO.new(reader, "files/blob", checksum: checksum)
+    ActiveStorage::Blob.service.upload(destination_key, entry_io)
+
+    assert entry_io.verify!
+    assert_equal payload, ActiveStorage::Blob.service.download(destination_key)
+
+    mismatched = ZipFile::EntryIO.new(reader, "files/blob", checksum: Base64.strict_encode64(Digest::MD5.digest("wrong")))
+    mismatched.read
+    assert_raises(ZipFile::Reader::InvalidArchive) { mismatched.verify! }
+  ensure
+    ActiveStorage::Blob.service.delete(destination_key) if destination_key
+    source&.close!
+  end
+end
