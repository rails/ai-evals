+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  def new
+    @import = Import.new
+  end
+
+  def create
+    if uploaded_file
+      import = Import.create_from!(
+        identity: Current.identity,
+        io: uploaded_file,
+        filename: uploaded_file.original_filename
+      )
+      import.restore_later
+      redirect_to new_account_import_path, notice: "We’ll email you when your account import is finished."
+    else
+      @import = Import.new
+      @import.errors.add(:base, "Choose a Fizzy account ZIP file")
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def uploaded_file
+      params.dig(:import, :file)
+    end
+end
