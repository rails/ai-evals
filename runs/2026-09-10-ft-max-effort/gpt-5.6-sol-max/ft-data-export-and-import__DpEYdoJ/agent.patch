diff --git a/test/mailers/import_mailer_test.rb b/test/mailers/import_mailer_test.rb
new file mode 100644
index 0000000..97f63a0
--- /dev/null
+++ b/test/mailers/import_mailer_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  test "completion email links to the imported account" do
+    import = build_import(status: :completed, account: accounts("37s"))
+
+    email = ImportMailer.completed(import)
+    body = email.text_part.body.to_s
+
+    assert_equal [ identities(:jason).email_address ], email.to
+    assert_match accounts("37s").slug, body
+    assert_match accounts("37s").name, body
+  end
+
+  test "failure email explains why and confirms nothing was added" do
+    import = build_import(status: :failed, error: "The manifest is invalid")
+
+    email = ImportMailer.failed(import)
+    body = email.text_part.body.to_s
+
+    assert_equal [ identities(:jason).email_address ], email.to
+    assert_match "The manifest is invalid", body
+    assert_match "Nothing from it was added", body
+  end
+
+  private
+    def build_import(**attributes)
+      Import.create!({
+        identity: identities(:jason),
+        source_filename: "account.zip",
+        source_key: SecureRandom.hex,
+        source_service_name: ActiveStorage::Blob.service.name,
+        source_byte_size: 1
+      }.merge(attributes))
+    end
+end
diff --git a/test/models/account/data_transfer/export_import_test.rb b/test/models/account/data_transfer/export_import_test.rb
new file mode 100644
index 0000000..7b45e6c
--- /dev/null
+++ b/test/models/account/data_transfer/export_import_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::DataTransfer::ExportImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @requester = users(:jason)
+  end
+
+  test "account export writes records and attached files without including itself" do
+    card = cards(:logo)
+    card.description = "A description with a file"
+    card.save!
+    card.image.attach io: StringIO.new("attachment body"), filename: "notes.txt", content_type: "text/plain"
+
+    export = Export.create!(account: @account, user: @requester, kind: :account)
+    export.generate_now
+
+    assert export.reload.completed?
+    assert export.file.attached?
+
+    export.file.open do |file|
+      reader = ZipFile::Reader.new(file)
+      card_json = JSON.parse(reader.read("cards/#{card.id}.json"))
+
+      assert_equal card.title, card_json.fetch("title")
+      assert card_json.fetch("comments").any?
+      assert_equal "attachment body", reader.read(card_json.fetch("attachments").first.fetch("path"))
+      assert_not reader.glob("exports/*.json").any?
+      assert_not reader.exists?(Account::DataTransfer::ActiveStorage::FileRecordSet.path_for(export.file.blob))
+    end
+  end
+
+  test "an exported account can be imported into the same installation with remapped ids" do
+    export = Export.create!(account: @account, user: @requester, kind: :account)
+    export.generate_now
+
+    import = Import.create_from!(identity: @requester.identity, io: export.file.open, filename: export.file.filename.to_s)
+
+    assert_difference -> { Account.count }, +1 do
+      import.restore_now
+    end
+
+    imported = import.reload.account
+    assert import.completed?
+    assert_equal @account.name, imported.name
+    assert_equal @account.boards.count, imported.boards.count
+    assert_equal @account.cards.count, imported.cards.count
+    assert_equal @account.users.count, imported.users.count
+    assert_not_equal @account.id, imported.id
+    assert imported.users.exists?(identity: @requester.identity)
+  end
+
+  test "failed import leaves no account or uploaded blobs behind" do
+    import = Import.create_from!(identity: @requester.identity, io: StringIO.new("not a zip"), filename: "broken.zip")
+
+    assert_no_difference -> { Account.count } do
+      assert_raises Import::InvalidArchive do
+        import.restore_now
+      end
+    end
+
+    assert import.reload.failed?
+    assert_nil import.account
+  end
+end
diff --git a/test/models/account/data_transfer/manifest_test.rb b/test/models/account/data_transfer/manifest_test.rb
new file mode 100644
index 0000000..4796eae
--- /dev/null
+++ b/test/models/account/data_transfer/manifest_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  test "exports account records as individual JSON entries" do
+    Tempfile.create([ "manifest", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Manifest.new(accounts("37s")).export_to(writer)
+      writer.close
+      file.rewind
+
+      reader = ZipFile::Reader.new(file)
+      assert reader.exists?("manifest.json")
+      assert reader.exists?("accounts/#{accounts("37s").id}.json")
+      assert reader.exists?("cards/#{cards(:logo).id}.json")
+
+      user = JSON.parse(reader.read("users/#{users(:david).id}.json"))
+      assert_equal identities(:david).email_address, user.fetch("email_address")
+
+      card = JSON.parse(reader.read("cards/#{cards(:logo).id}.json"))
+      assert_kind_of Array, card.fetch("comments")
+      assert_kind_of Array, card.fetch("attachments")
+    end
+  end
+
+  test "card manifest only includes accessible cards" do
+    user = users(:david)
+    inaccessible = cards(:logo)
+    inaccessible.board.accesses.where(user: user).delete_all
+
+    Tempfile.create([ "cards", ".zip" ]) do |file|
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::CardManifest.new(user).export_to(writer)
+      writer.close
+      file.rewind
+
+      reader = ZipFile::Reader.new(file)
+      assert_not reader.exists?("cards/#{inaccessible.id}.json")
+      assert_equal user.accessible_cards.count, reader.glob("cards/*.json").count
+    end
+  end
+test "card manifest includes attachment bytes referenced by card JSON" do
+  user = users(:david)
+  card = user.accessible_cards.first
+  card.image.attach(
+    io: StringIO.new("visible picture"),
+    filename: "visible.png",
+    content_type: "image/png"
+  )
+
+  Tempfile.create([ "cards", ".zip" ]) do |file|
+    writer = ZipFile::Writer.new(file)
+    Account::DataTransfer::CardManifest.new(user).export_to(writer)
+    writer.close
+    file.rewind
+
+    reader = ZipFile::Reader.new(file)
+    card_json = JSON.parse(reader.read("cards/#{card.id}.json"))
+    attachment = card_json.fetch("attachments").find { |item| item["filename"] == "visible.png" }
+
+    assert_equal "visible picture", reader.read(attachment.fetch("path"))
+    assert_equal card.board.name, card_json.dig("board", "name")
+    assert_equal card.creator.name, card_json.dig("creator", "name")
+  end
+end
+end
diff --git a/test/models/account/data_transfer/restoration_test.rb b/test/models/account/data_transfer/restoration_test.rb
new file mode 100644
index 0000000..c781957
--- /dev/null
+++ b/test/models/account/data_transfer/restoration_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class Account::DataTransfer::RestorationTest < ActiveSupport::TestCase
+  setup do
+    @source = accounts("37s")
+  end
+
+  test "restores an account into the same installation with new ids" do
+    restored = restore_account(requester: identities(:jason))
+
+    assert_not_equal @source.id, restored.id
+    assert_equal @source.name, restored.name
+    assert_equal @source.boards.count, restored.boards.count
+    assert_equal @source.cards.count, restored.cards.count
+    assert_equal Comment.where(account: @source).count, Comment.where(account: restored).count
+    assert_equal @source.users.count, restored.users.count
+    assert restored.join_code.present?
+    assert_equal @source.cards.published.count + Comment.where(account: @source).count,
+      Search::Record.for(restored.id).where(account_id: restored.id).count
+  end
+
+  test "restores attached file bytes under a new storage key" do
+    source_card = cards(:logo)
+    source_card.image.attach(
+      io: StringIO.new("picture bytes"),
+      filename: "picture.jpg",
+      content_type: "image/jpeg"
+    )
+    source_key = source_card.image.blob.key
+
+    restored = restore_account(requester: identities(:jason))
+    restored_card = restored.cards.find_by!(number: source_card.number)
+    @restored_blob_key = restored_card.image.blob.key
+
+    assert restored_card.image.attached?
+    assert_equal "picture bytes", restored_card.image.download
+    assert_not_equal source_key, @restored_blob_key
+    assert_equal "picture bytes".bytesize, restored.bytes_used_exact
+    assert_equal "picture bytes".bytesize, restored_card.board.bytes_used_exact
+  ensure
+    ActiveStorage::Blob.service.delete(@restored_blob_key) if @restored_blob_key
+  end
+
+  test "regenerates portable rich-text attachments" do
+    source_card = cards(:logo)
+    source_blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("embedded bytes"),
+      filename: "embedded.txt",
+      content_type: "text/plain"
+    )
+    attachment = ActionText::Attachment.from_attachable(source_blob)
+    source_url = "#{@source.slug}/boards/#{source_card.board.id}"
+    source_card.update!(description: "A file: #{attachment.to_html} <a href=\"#{source_url}\">Board</a>")
+
+    restored = restore_account(requester: identities(:jason))
+    restored_card = restored.cards.find_by!(number: source_card.number)
+    restored_blob = restored_card.description.embeds.first.blob
+    @restored_blob_key = restored_blob.key
+
+    assert_equal "embedded bytes", restored_blob.download
+    assert_not_equal source_blob.id, restored_blob.id
+    assert_includes restored_card.description.body.to_s, restored_blob.attachable_sgid
+    assert_not_includes restored_card.description.body.to_s, source_blob.attachable_sgid
+    assert_includes restored_card.description.body.to_s, "#{restored.slug}/boards/#{restored_card.board.id}"
+    assert_not_includes restored_card.description.body.to_s, source_url
+  ensure
+    ActiveStorage::Blob.service.delete(@restored_blob_key) if @restored_blob_key
+  end
+
+  test "adds the requester as owner with access when absent from the source" do
+    restored = restore_account(requester: identities(:mike))
+    imported_requester = restored.users.find_by!(identity: identities(:mike))
+
+    assert_equal @source.users.count + 1, restored.users.count
+    assert imported_requester.owner?
+    assert imported_requester.active?
+    assert imported_requester.settings.present?
+    assert_equal restored.boards.order(:id).ids, imported_requester.boards.order(:id).ids
+  end
+
+  test "rolls back records and uploaded files when a later record is invalid" do
+    source_card = cards(:logo)
+    source_card.image.attach(
+      io: StringIO.new("temporary imported bytes"),
+      filename: "temporary.jpg",
+      content_type: "image/jpeg"
+    )
+
+    archive = Tempfile.new([ "invalid-account", ".zip" ], binmode: true)
+    writer = ZipFile::Writer.new(archive)
+    Account::DataTransfer::Manifest.new(@source).export_to(writer)
+    invalid_id = ActiveRecord::Type::Uuid.generate
+    invalid_user = users(:david).attributes.as_json.merge(
+      "id" => invalid_id,
+      "role" => "superuser",
+      "identity_id" => nil,
+      "email_address" => nil
+    )
+    writer.add_file("users/#{invalid_id}.json", JSON.generate(invalid_user))
+    writer.close
+    archive.rewind
+
+    files_before = storage_files
+    restoration = Account::DataTransfer::Restoration.new(
+      ZipFile::Reader.new(archive),
+      requester: identities(:jason)
+    )
+
+    assert_no_difference -> { Account.count } do
+      assert_raises(Account::DataTransfer::Restoration::InvalidArchive) { restoration.restore }
+    end
+    assert_equal files_before, storage_files
+  ensure
+    archive&.close!
+  end
+
+  test "uses the signup tenant provisioner external id" do
+    sequence_before = Account::ExternalIdSequence.value
+    Signup.any_instance.stubs(:create_tenant).returns(987_654)
+
+    restored = restore_account(requester: identities(:jason))
+
+    assert_equal 987_654, restored.external_account_id
+    assert_equal sequence_before, Account::ExternalIdSequence.value
+  end
+
+  test "notifies the tenant provisioner when local restoration fails" do
+    archive = Tempfile.new([ "account", ".zip" ], binmode: true)
+    writer = ZipFile::Writer.new(archive)
+    Account::DataTransfer::Manifest.new(@source).export_to(writer)
+    writer.close
+    archive.rewind
+
+    Signup.any_instance.stubs(:create_tenant).returns(987_654)
+    Signup.any_instance.expects(:handle_account_creation_error).with(instance_of(RuntimeError)).once
+    restoration = Account::DataTransfer::Restoration.new(
+      ZipFile::Reader.new(archive),
+      requester: identities(:jason)
+    )
+    restoration.stubs(:insert_account).raises(RuntimeError, "local restoration failed")
+
+    assert_no_difference -> { Account.count } do
+      assert_raises(RuntimeError) { restoration.restore }
+    end
+  ensure
+    archive&.close!
+  end
+
+  private
+    def restore_account(requester:)
+      archive = Tempfile.new([ "account", ".zip" ], binmode: true)
+      writer = ZipFile::Writer.new(archive)
+      Account::DataTransfer::Manifest.new(@source).export_to(writer)
+      writer.close
+      archive.rewind
+
+      restoration = Account::DataTransfer::Restoration.new(
+        ZipFile::Reader.new(archive),
+        requester: requester
+      )
+
+      assert_difference -> { Account.count }, +1 do
+        restoration.restore
+      end
+    ensure
+      archive&.close!
+    end
+
+    def storage_files
+      Dir.glob(File.join(ActiveStorage::Blob.service.root, "**", "*")).select { |path| File.file?(path) }.sort
+    end
+end
diff --git a/test/models/zip_file/entry_io_test.rb b/test/models/zip_file/entry_io_test.rb
