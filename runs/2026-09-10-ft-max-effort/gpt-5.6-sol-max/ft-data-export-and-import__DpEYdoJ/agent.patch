+++ b/test/controllers/exports_controller_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "only admins can request an account export" do
+    sign_in_as :david
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+
+    logout_and_sign_in_as :jason
+    assert_enqueued_with job: Export::GenerationJob do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+  end
+
+  test "a member can request an export of only their accessible cards" do
+    sign_in_as :david
+
+    assert_enqueued_with job: Export::GenerationJob do
+      post user_exports_path(users(:david))
+    end
+
+    export = Export.order(:created_at).last
+    assert export.cards?
+    assert_equal users(:david), export.user
+  end
+
+  test "download link expires after one day" do
+    export = Export.create!(account: accounts("37s"), user: users(:jason), kind: :account, status: :completed)
+    export.file.attach(io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip")
+    token = export.download_token
+
+    untenanted do
+      get export_path(token)
+      assert_response :redirect
+    end
+
+    travel 1.day + 1.second do
+      untenanted do
+        get export_path(token)
+        assert_response :not_found
+      end
+    end
+  end
+end
