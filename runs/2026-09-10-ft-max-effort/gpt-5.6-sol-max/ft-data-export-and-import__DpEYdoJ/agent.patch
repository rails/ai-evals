diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..6b025d4
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,73 @@
+class Export < ApplicationRecord
+  DOWNLOAD_EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, account: "account", cards: "cards"
+  enum :status, pending: "pending", processing: "processing", completed: "completed", failed: "failed"
+
+  validates :kind, :status, presence: true
+  validate :user_belongs_to_account
+
+  def generate_later
+    Export::GenerationJob.perform_later(self)
+  end
+
+  def generate_now
+    Current.with_account(account) do
+      begin
+        update!(status: :processing, error: nil)
+
+        ZipFile.create_for(file, filename: filename) do |zip|
+          manifest.export_to(zip)
+        end
+
+        update!(status: :completed)
+      rescue => error
+        mark_failed(error)
+        raise
+      end
+
+      deliver_ready_email
+    end
+  end
+
+  def download_token
+    signed_id(expires_in: DOWNLOAD_EXPIRATION, purpose: :download)
+  end
+
+  private
+    def manifest
+      if account?
+        Account::DataTransfer::Manifest.new(account)
+      else
+        Account::DataTransfer::CardManifest.new(user)
+      end
+    end
+
+    def filename
+      label = account? ? "account" : "cards"
+      "#{account.name.parameterize.presence || "fizzy"}-#{label}-#{Time.current.to_date.iso8601}.zip"
+    end
+
+    def mark_failed(error)
+      update_columns(status: "failed", error: error.message.to_s.truncate(10_000), updated_at: Time.current)
+    rescue ActiveRecord::ActiveRecordError
+      # Preserve the original generation exception if status persistence also fails.
+    end
+
+    def deliver_ready_email
+      ExportMailer.ready(self).deliver_later
+    rescue => delivery_error
+      Rails.error.report(delivery_error, severity: :error, context: { export_id: id })
+    end
+
+    def user_belongs_to_account
+      if user && account && user.account_id != account_id
+        errors.add(:user, "must belong to the exported account")
+      end
+    end
+end
