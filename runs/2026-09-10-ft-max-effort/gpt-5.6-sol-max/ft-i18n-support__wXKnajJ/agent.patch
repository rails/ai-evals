new file mode 100644
index 0000000..ddd91b3
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,12 @@
+const element = document.querySelector('meta[name="i18n"]')
+const messages = element ? JSON.parse(element.content) : {}
+
+export function translate(key, replacements = {}) {
+  let message = messages[key] || key
+
+  for (const [name, value] of Object.entries(replacements)) {
+    message = message.replaceAll(`%{${name}}`, value)
+  }
+
+  return message
+}
