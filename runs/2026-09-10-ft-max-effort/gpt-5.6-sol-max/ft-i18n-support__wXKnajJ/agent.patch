diff --git a/test/controllers/japanese_screens_test.rb b/test/controllers/japanese_screens_test.rb
new file mode 100644
index 0000000..5ff81f6
--- /dev/null
+++ b/test/controllers/japanese_screens_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class JapaneseScreensTest < ActionDispatch::IntegrationTest
+  setup do
+    identities(:kevin).update!(locale: :ja)
+    sign_in_as :kevin
+  end
+
+  test "major authenticated screens render completely localized" do
+    paths = [
+      root_path,
+      account_settings_path,
+      board_path(boards(:writebook)),
+      card_path(cards(:logo)),
+      user_path(users(:kevin)),
+      edit_user_path(users(:kevin)),
+      notifications_path,
+      notifications_settings_path,
+      my_access_tokens_path,
+      my_passkeys_path,
+      search_path,
+      board_webhooks_path(boards(:writebook))
+    ]
+
+    paths.each do |path|
+      get path
+
+      assert_response :success, path
+      assert_select "html[lang=ja]", 1, path
+      assert_no_match(/Translation missing/, response.body, path)
+    end
+  end
+
+  test "card status dates are Japanese" do
+    card = cards(:shipping)
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select ".card__closed-title", text: "完了"
+    assert_select ".card__closed-date", text: /\A\d{4}年\d{1,2}月\d{1,2}日\z/
+  end
+
+  test "a public board switches to Japanese without authentication" do
+    board = boards(:writebook)
+    board.publish
+    sign_out
+
+    get published_board_path(board, locale: :ja)
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "たぶん"
+    assert_no_match(/Translation missing/, response.body)
+  end
+
+  test "public caches vary safely by locale" do
+    board = boards(:writebook)
+    board.publish
+    sign_out
+
+    get published_board_path(board, locale: :en)
+    english_etag = response.headers["ETag"]
+    assert_includes response.headers["Cache-Control"], "public"
+
+    get published_board_path(board, locale: :ja)
+    japanese_etag = response.headers["ETag"]
+
+    assert_not_equal english_etag, japanese_etag
+    assert_includes response.headers["Cache-Control"], "private"
+    assert_includes response.headers["Vary"], "Cookie"
+  end
+
+  test "PWA manifest is Japanese" do
+    untenanted { get pwa_manifest_path(format: :json, locale: :ja) }
+
+    assert_response :success
+    assert_equal "通知", response.parsed_body.dig("shortcuts", 0, "name")
+    assert_equal "最新のアクティビティ", response.parsed_body.dig("shortcuts", 1, "name")
+  end
+end
diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..b1d21ab
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "Japanese locale is selected with a query parameter and sticks for the session" do
+    untenanted do
+      get new_session_path(locale: :ja)
+
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyに入る"
+      assert_includes response.body, "この項目を入力してください"
+
+      get new_session_path
+
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyに入る"
+    end
+  end
+
+  test "a supported locale can switch the session back to English" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      get new_session_path(locale: :en)
+      get new_session_path
+
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+
+  test "unsupported locale does not change the session locale" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      get new_session_path(locale: :xx)
+
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyに入る"
+    end
+  end
+
+  test "unsupported locale leaves English as the default" do
+    untenanted do
+      get new_session_path(locale: :xx)
+
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+
+  test "an authenticated query choice is persisted before the action" do
+    identity = identities(:kevin)
+    identity.update!(locale: :en)
+    sign_in_as identity
+
+    get root_path(locale: :ja)
+
+    assert_response :success
+    assert_equal "ja", identity.reload.locale
+    assert_select "html[lang=ja]"
+  end
+
+  test "selected locale is saved to the identity after signing in" do
+    identity = identities(:kevin)
+    magic_link = MagicLink.create!(identity: identity)
+
+    untenanted do
+      post session_path(locale: :ja), params: { email_address: identity.email_address }
+      post session_magic_link_path, params: { code: magic_link.code }
+    end
+
+    assert_equal "ja", identity.reload.locale
+  end
+
+  test "identity locale is restored after signing in from a clean browser" do
+    identity = identities(:kevin)
+    identity.update!(locale: :ja)
+    magic_link = MagicLink.create!(identity: identity)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      follow_redirect!
+      assert_select "h1", text: "メールを確認してください"
+
+      post session_magic_link_path, params: { code: magic_link.code }
+      get session_menu_path
+      follow_redirect!
+
+      assert_equal "ja", identity.reload.locale
