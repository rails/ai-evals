diff --git a/test/i18n_test.rb b/test/i18n_test.rb
new file mode 100644
index 0000000..9d8d610
--- /dev/null
+++ b/test/i18n_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+require "yaml"
+
+class I18nTest < ActiveSupport::TestCase
+  test "only offered locales are available" do
+    assert_equal %i[ en ja ], I18n.available_locales
+  end
+
+  test "every application English translation has a Japanese translation" do
+    english_keys.each do |key|
+      assert I18n.exists?(key, :ja), "Missing Japanese translation for #{key}"
+    end
+  end
+
+  test "literal translation calls resolve in both locales" do
+    missing = literal_translation_keys.flat_map do |key|
+      %i[ en ja ].reject { |locale| I18n.exists?(key, locale) }
+        .map { |locale| "#{locale}.#{key}" }
+    end
+
+    assert_empty missing
+  end
+
+  test "dynamic translation domains are complete" do
+    domains = {
+      "colors" => Color::COLORS.map { _1.name.downcase },
+      "reactions.emoji" => EmojiHelper::REACTIONS.values,
+      "filters.sorts" => Filter::SORTED_BY,
+      "filters.sort_summaries" => Filter::SORTED_BY,
+      "filters.indexes" => Filter::INDEXES,
+      "filters.time_windows" => TimeWindowParser::VALUES,
+      "users.roles" => User.roles.keys,
+      "webhooks.actions" => Webhook::PERMITTED_ACTIONS,
+      "webhooks.states" => Webhook::Delivery.states.keys,
+      "access_tokens" => Identity::AccessToken.permissions.keys
+    }
+
+    missing = domains.flat_map do |prefix, values|
+      values.reject { |value| I18n.exists?("#{prefix}.#{value}", :ja) }
+        .map { |value| "#{prefix}.#{value}" }
+    end
+
+    assert_empty missing
+  end
+
+  test "Japanese dates include localized year month and day" do
+    assert_equal "2026年7月10日", I18n.l(Date.new(2026, 7, 10), locale: :ja, format: :card_stamp)
+    assert_equal "7月10日", I18n.l(Date.new(2026, 7, 10), locale: :ja, format: :compact)
+  end
+
+  test "Japanese onboarding is complete" do
+    I18n.with_locale(:ja) do
+      assert_equal "プレイグラウンド", I18n.t("onboarding.board_name")
+      assert_equal 11, I18n.t("onboarding.cards").size
+      assert I18n.t("onboarding.cards").all? { |card| card[:title].match?(/[ぁ-んァ-ヶ一-龠]/) }
+    end
+  end
+
+  test "static errors contain English and Japanese" do
+    Dir[Rails.root.join("public/{400,404,406-unsupported-browser,422,500}.html")].each do |path|
+      document = File.read(path)
+      assert_includes document, 'lang="en"'
+      assert_includes document, 'lang="ja"'
+      assert_includes document, "Back home"
+      assert_includes document, "ホームへ戻る"
+    end
+  end
+
+  private
+    def literal_translation_keys
+      Dir[Rails.root.join("{app,lib}/**/*.{rb,erb}")].flat_map do |path|
+        source = File.read(path)
+        direct = source.scan(/(?<![\w.])t\(\s*["']([^"']+)["']/).flatten
+        explicit = source.scan(/I18n\.t\(\s*["']([^"']+)["']/).flatten
+        direct + explicit
+      end.reject { |key| key.include?('#{') }.uniq
+    end
+
+    def english_keys
+      Dir[Rails.root.join("config/locales/*.yml")].flat_map do |path|
+        locale = YAML.load_file(path, aliases: true)["en"]
+        locale ? flatten_keys(locale) : []
+      end.uniq
+    end
+
+    def flatten_keys(value, prefix = nil)
+      if value.is_a?(Hash)
+        value.flat_map { |key, child| flatten_keys(child, [ prefix, key ].compact.join(".")) }
+      else
+        [ prefix ]
+      end
+    end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..463285a
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.identity.update!(locale: :ja)
+  end
+
+  test "account cancellation is Japanese" do
+    cancellation = Account::Cancellation.create!(account: Current.account, initiated_by: @user)
+    email = AccountMailer.cancellation(cancellation)
+
+    assert_equal "Fizzyアカウントがキャンセルされました", email.subject
+    assert_includes email.html_part.decoded, "今後の流れ"
+    assert_includes email.text_part.decoded, "アカウント内のすべてのデータ"
+  end
+
+  test "data export is Japanese" do
+    export = Account::Export.create!(account: Current.account, user: @user)
+    email = ExportMailer.completed(export)
+
+    assert_equal "Fizzyデータのエクスポートをダウンロードできます", email.subject
+    assert_includes email.html_part.decoded, "Fizzyデータをダウンロード"
+    assert_includes email.text_part.decoded, "データをダウンロード"
+  end
+
+  test "account import is Japanese" do
+    completed = ImportMailer.completed(@user.identity, Current.account)
+    import = Account::Import.create!(account: Current.account, identity: @user.identity, status: :failed)
+    failed = ImportMailer.failed(import)
+
+    assert_equal "Fizzyアカウントのインポートが完了しました", completed.subject
+    assert_includes completed.html_part.decoded, "インポートが完了しました"
+    assert_equal "Fizzyアカウントをインポートできませんでした", failed.subject
+    assert_includes failed.text_part.decoded, "申し訳ありません"
+  end
+
+  test "magic link is Japanese" do
+    magic_link = MagicLink.create!(identity: @user.identity)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzy確認コード：#{magic_link.code}", email.subject
+    assert_includes email.html_part.decoded, "Fizzy確認コード"
+    assert_includes email.text_part.decoded, "この6文字の確認コード"
+  end
+
+  test "email change confirmation is Japanese" do
+    email = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user)
+
+    assert_equal "新しいメールアドレスを確認してください", email.subject
+    assert_includes email.body.decoded, "メールアドレスの変更を確認"
+  end
+
+  test "notification bundle is Japanese and has a Japanese date" do
+    @user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: @user, starts_at: Time.zone.local(2026, 7, 10, 9), ends_at: 1.hour.from_now)
+    event = events(:logo_published)
+    Notification.create!(user: @user, creator: event.creator, source: event)
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_equal "Fizzy：新しい通知", email.subject
+    assert_includes email.html_part.decoded, "7月10日"
+    assert_includes email.html_part.decoded, "新しい通知"
+    assert_includes email.text_part.decoded, "数時間おき"
+  end
+end
