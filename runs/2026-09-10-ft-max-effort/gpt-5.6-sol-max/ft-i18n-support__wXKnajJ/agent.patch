diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..cd14957
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,51 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :switch_locale, prepend: true
+  end
+
+  private
+    def switch_locale(&action)
+      requested_locale = supported_locale(params[:locale])
+      if requested_locale
+        session[:locale] = requested_locale
+        signed_in_identity&.update!(locale: requested_locale) unless signed_in_identity&.locale == requested_locale
+      end
+
+      chosen_locale = supported_locale(session[:locale]) || signed_in_identity&.locale || pending_identity_locale
+      Current.locale = chosen_locale
+
+      I18n.with_locale(chosen_locale || I18n.default_locale) do
+        action.call
+        remember_locale_for_current_identity(chosen_locale)
+      end
+    end
+
+    def supported_locale(locale)
+      locale.to_s.presence_in(I18n.available_locales.map(&:to_s))
+    end
+
+    def signed_in_identity
+      unless defined?(@signed_in_identity)
+        @signed_in_identity = find_session_by_cookie&.identity
+      end
+
+      @signed_in_identity
+    end
+
+    def pending_identity_locale
+      if respond_to?(:email_address_pending_authentication, true)
+        Identity.find_by(email_address: email_address_pending_authentication)&.locale
+      end
+    end
+
+    def remember_locale_for_current_identity(chosen_locale)
+      chosen_locale ||= Current.identity&.locale
+
+      if chosen_locale
+        session[:locale] = chosen_locale
+        Current.identity&.update!(locale: chosen_locale) unless Current.identity&.locale == chosen_locale
+      end
+    end
+end
