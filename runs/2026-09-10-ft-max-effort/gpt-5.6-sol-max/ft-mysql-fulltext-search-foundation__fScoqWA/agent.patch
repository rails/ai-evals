diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..69aeb53
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,35 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(query) do
+      if query.present?
+        pattern = "%#{sanitize_sql_like(query.downcase, "!")}%"
+
+        where(<<~SQL.squish, pattern: pattern)
+          LOWER(cards.title) LIKE :pattern ESCAPE '!'
+          OR EXISTS (
+            SELECT 1
+            FROM action_text_rich_texts descriptions
+            WHERE descriptions.record_type = 'Card'
+              AND descriptions.record_id = cards.id
+              AND descriptions.name = 'description'
+              AND LOWER(descriptions.body) LIKE :pattern ESCAPE '!'
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments
+            INNER JOIN action_text_rich_texts comment_bodies
+              ON comment_bodies.record_type = 'Comment'
+              AND comment_bodies.record_id = comments.id
+              AND comment_bodies.name = 'body'
+            WHERE comments.card_id = cards.id
+              AND LOWER(comment_bodies.body) LIKE :pattern ESCAPE '!'
+          )
+        SQL
+      else
+        none
+      end
+    end
+  end
+end
