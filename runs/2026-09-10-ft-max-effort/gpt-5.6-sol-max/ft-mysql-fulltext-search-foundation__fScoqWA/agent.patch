diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..0eae1a1
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles, descriptions, and comments newest first" do
+    older_title_match = description_match = newer_comment_match = nil
+
+    with_current_user users(:kevin) do
+      older_title_match = create_card(title: "Needle in the title", created_at: 3.days.ago)
+      description_match = create_card(title: "Description result", description: "A hidden NEEDLE", created_at: 2.days.ago)
+      newer_comment_match = create_card(title: "Comment result", created_at: 1.day.ago)
+      newer_comment_match.comments.create!(body: "Found the needle here", creator: users(:kevin))
+      create_card(title: "Unrelated card", description: "Nothing to see")
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "[data-card-id]", 3
+    assert_select "[data-card-id]" do |results|
+      assert_equal [ newer_comment_match, description_match, older_title_match ].map(&:id), results.map { |result| result["data-card-id"] }
+    end
+    assert_select "mark", { text: /needle/i, count: 3 }
+  end
+
+  test "only returns published cards on currently accessible boards" do
+    accessible = draft = inaccessible = nil
+
+    with_current_user users(:kevin) do
+      accessible = create_card(title: "Visible secret")
+      draft = create_card(title: "Draft without the term")
+      draft.comments.create!(body: "Secret draft comment", creator: users(:kevin))
+      draft.update!(status: :drafted)
+      inaccessible = create_card(title: "Hidden secret", board: boards(:private))
+      boards(:private).accesses.find_by!(user: users(:kevin)).destroy!
+    end
+
+    get search_path, params: { q: "secret" }
+
+    assert_response :success
+    assert_select "[data-card-id='#{accessible.id}']", 1
+    assert_select "[data-card-id='#{draft.id}']", 0
+    assert_select "[data-card-id='#{inaccessible.id}']", 0
+  end
+
+  test "treats SQL wildcard characters as literal search text" do
+    percent_match = underscore_match = wildcard_only = nil
+
+    with_current_user users(:kevin) do
+      percent_match = create_card(title: "Progress is 100% complete")
+      underscore_match = create_card(title: "Reference snake_case")
+      wildcard_only = create_card(title: "Ordinary words")
+    end
+
+    get search_path, params: { q: "%" }
+    assert_select "form[method=get] input[type=search][name=q][value=\"%\"]", 1
+    assert_select "[data-card-id='#{percent_match.id}']", 1
+    assert_select "[data-card-id=\"#{percent_match.id}\"] mark", text: "%"
+    assert_select "[data-card-id='#{wildcard_only.id}']", 0
+
+    get search_path, params: { q: "_" }
+    assert_select "[data-card-id='#{underscore_match.id}']", 1
+    assert_select "[data-card-id=\"#{underscore_match.id}\"] mark", text: "_"
+    assert_select "[data-card-id='#{wildcard_only.id}']", 0
+  end
+
+  test "returns each card once when several comments match" do
+    card = nil
+
+    with_current_user users(:kevin) do
+      card = create_card(title: "A card")
+      card.comments.create!(body: "Needle one", creator: users(:kevin))
+      card.comments.create!(body: "Needle two", creator: users(:kevin))
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_select "[data-card-id='#{card.id}']", 1
+    assert_select "[data-card-id='#{card.id}'] mark", 2
+  end
+
+  test "paginates results while preserving the query and order" do
+    cards = nil
+
+    with_current_user users(:kevin) do
+      cards = 16.times.map do |index|
+        create_card(title: "Paging result #{index}", created_at: index.minutes.ago)
+      end
+    end
+
+    get search_path, params: { q: "paging" }
+
+    assert_select "[data-card-id]" do |results|
+      assert_equal cards.first(15).map(&:id), results.map { |result| result["data-card-id"] }
+    end
+    assert_select "a.pagination-link[href*=?][href*=?]", "q=paging", "page=2", count: 1
+
+    get search_path, params: { q: "paging", page: 2 }
+
+    assert_select "[data-card-id]" do |results|
+      assert_equal [ cards.last.id ], results.map { |result| result["data-card-id"] }
+    end
+  end
+
+  test "handles blank and unsafe search text" do
+    with_current_user users(:kevin) do
+      create_card(title: %q{A <script>alert("unsafe")</script> needle})
+    end
+
+    get search_path, params: { q: "   " }
+    assert_response :success
+    assert_select "[data-card-id]", 0
+
+    get search_path, params: { q: %q(<script>) }
+    assert_response :success
+    assert_no_match(/<script>/, response.body)
+  end
+
+  private
+    def create_card(title:, description: nil, created_at: Time.current, board: boards(:writebook))
+      board.cards.create!(
+        title: title,
+        description: description,
+        created_at: created_at,
+        last_active_at: created_at,
+        status: :published,
+        creator: users(:kevin)
+      )
+    end
+end
