--- /dev/null
+++ b/app/models/comment/searchable.rb
@@ -0,0 +1,15 @@
+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(query) do
+      if query.present?
+        pattern = "%#{sanitize_sql_like(query.downcase, "!")}%"
+
+        joins(:rich_text_body).where("LOWER(action_text_rich_texts.body) LIKE :pattern ESCAPE '!'", pattern: pattern)
+      else
+        none
+      end
+    end
+  end
+end
