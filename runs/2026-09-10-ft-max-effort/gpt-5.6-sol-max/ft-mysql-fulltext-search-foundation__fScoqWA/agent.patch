diff --git a/app/views/searches/_card.html.erb b/app/views/searches/_card.html.erb
new file mode 100644
index 0000000..a7e28c9
--- /dev/null
+++ b/app/views/searches/_card.html.erb
@@ -0,0 +1,20 @@
+<%= tag.article class: "search-result", data: { card_id: card.id } do %>
+  <header class="search-result__header flex justify-space-between gap">
+    <h2 class="txt-large margin-none">
+      <%= link_to search_highlight(card.title, query), card_path(card), class: "search-result__title" %>
+    </h2>
+    <span class="txt-small txt-subtle txt-nowrap"><%= card.board.name %></span>
+  </header>
+
+  <% if search_match?(card.description.to_plain_text, query) %>
+    <p class="search-result__match"><%= search_highlight(card.description.to_plain_text, query) %></p>
+  <% end %>
+
+  <% matching_comments_by_card_id.fetch(card.id, []).each do |comment| %>
+    <% if search_match?(comment.body.to_plain_text, query) %>
+      <blockquote class="search-result__match search-result__comment">
+        <%= search_highlight(comment.body.to_plain_text, query) %>
+      </blockquote>
+    <% end %>
+  <% end %>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c99b443
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,30 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel panel--wide borderless center margin">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half", data: { turbo_action: "replace" } do |form| %>
+    <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards…", autofocus: true,
+          autocorrect: "off", autocomplete: "off", aria: { label: "Search cards" }, data: { "1p-ignore": "true" } %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p class="search__blank txt-align-center txt-subtle">Search card titles, descriptions, and comments.</p>
+  <% elsif @cards.any? %>
+    <div class="search-results">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "card", collection: @cards,
+              locals: { query: @query, matching_comments_by_card_id: @matching_comments_by_card_id } %>
+      <% end %>
+    </div>
+  <% else %>
+    <p class="search__blank blank-slate txt-align-center">No cards match “<%= @query %>”</p>
+  <% end %>
+</section>
