+module SearchesHelper
+  def search_highlight(text, query)
+    highlight(text.to_s, query, highlighter: "<mark>\\1</mark>")
+  end
+
+  def search_match?(text, query)
+    text.to_s.downcase.include? query.downcase
+  end
+end
