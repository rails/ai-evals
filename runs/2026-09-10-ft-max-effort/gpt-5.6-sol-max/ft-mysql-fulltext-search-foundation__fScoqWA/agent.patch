diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
new file mode 100644
index 0000000..a645f79
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,22 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = search_results
+    @matching_comments_by_card_id = matching_comments_by_card_id
+  end
+
+  private
+    def search_results
+      cards = Current.user.accessible_cards.published.matching(@query).reverse_chronologically
+      set_page_and_extract_portion_from(cards).preload(:board, :rich_text_description).load
+    end
+
+    def matching_comments_by_card_id
+      if @cards.any?
+        Comment.where(card_id: @cards.map(&:id)).matching(@query).chronologically
+          .with_rich_text_body.group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
