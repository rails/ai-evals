diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..c88effd 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,8 +25,21 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      # Resolve periods before selecting cards so SQLite can use the account/activity index.
+      Account.preload(:entropy).find_each do |account|
+        system_user = nil
+
+        account.boards.preload(:entropy).find_in_batches do |boards|
+          boards.group_by(&:auto_postpone_period).each do |period, boards_with_period|
+            account.cards.active
+              .where(board: boards_with_period, last_active_at: ..period.seconds.ago(now))
+              .find_each do |card|
+                card.auto_postpone(user: system_user ||= account.system_user)
+              end
+          end
+        end
       end
     end
   end
