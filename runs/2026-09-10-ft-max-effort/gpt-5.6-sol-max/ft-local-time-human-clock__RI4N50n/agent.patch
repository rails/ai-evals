diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..ee232ad
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time tag sends a canonical raw UTC timestamp to the browser" do
+    timestamp = Time.find_zone!("America/New_York").local(2025, 1, 2, 13, 42, 3)
+
+    html = local_time_tag(timestamp, format: :contextual)
+
+    assert_dom_equal <<~HTML.squish, html
+      <time datetime="2025-01-02T18:42:03Z" data-controller="local-time" data-local-time-format-value="contextual">2025-01-02T18:42:03Z</time>
+    HTML
+  end
+
+  test "local time tag does not mutate a plain Time" do
+    timestamp = Time.new(2025, 1, 2, 13, 42, 3, "-05:00")
+    original = timestamp.to_s
+
+    local_time_tag timestamp
+
+    assert_equal original, timestamp.to_s
+  end
+
+  test "local time tag markup does not vary with the server timezone" do
+    timestamp = Time.utc(2025, 1, 2, 18, 42, 3)
+
+    markup = [ "America/New_York", "Asia/Tokyo" ].map do |zone|
+      Time.use_zone(zone) { local_time_tag timestamp.in_time_zone }
+    end
+
+    assert_equal 1, markup.uniq.size
+  end
+
+  test "local time tag preserves additional attributes and controllers" do
+    html = local_time_tag(
+      Time.utc(2025, 1, 2, 18, 42, 3),
+      class: "timestamp",
+      data: { controller: "tooltip", local_time_target: "timestamp" }
+    )
+
+    assert_includes html, 'class="timestamp"'
+    assert_includes html, 'data-controller="tooltip local-time"'
+    assert_includes html, 'data-local-time-target="timestamp"'
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..b2a5f27
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,116 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as users(:kevin)
+  end
+
+  test "synchronizes the browser timezone without cookie-specific markup" do
+    user = users(:kevin)
+    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + Capybara.default_max_wait_time
+
+    until user.settings.reload.timezone_name == "America/Los_Angeles"
+      flunk "Browser timezone was not persisted" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
+      sleep 0.05
+    end
+
+    assert_no_selector "form[action='#{my_timezone_path}']", visible: :all
+  end
+
+  test "formats timestamps in the browser timezone" do
+    results = format_times_in_browser(
+      now: "2025-09-18T22:00:00Z",
+      timestamps: [
+        [ "2025-09-18T20:42:00Z", "contextual" ],
+        [ "2025-09-18T06:00:00Z", "contextual" ],
+        [ "2025-09-13T19:00:00Z", "contextual" ],
+        [ "2025-09-11T19:00:00Z", "contextual" ],
+        [ "2025-09-19T19:00:00Z", "relative" ],
+        [ "2025-09-21T19:00:00Z", "relative" ],
+        [ "2025-09-18T20:00:00Z", "time-ago" ]
+      ]
+    )
+
+    assert_equal [ "1:42 PM", "yesterday", "5 days ago", "Sep 11", "tomorrow", "in 3 days", "2 hours ago" ], results
+  end
+
+  test "localizes raw timestamps embedded in native bridge descriptions" do
+    description = localize_timestamps_in_browser(
+      "Added 2025-09-18T20:42:00Z. Updated 2025-09-11T19:00:00Z",
+      now: "2025-09-18T22:00:00Z"
+    )
+
+    assert_equal "Added Sep 18. Updated Sep 11", description
+  end
+
+  test "uses calendar boundaries across daylight saving and new year" do
+    spring_results = format_times_in_browser(
+      now: "2025-03-10T07:30:00Z",
+      timestamps: [
+        [ "2025-03-09T08:30:00Z", "contextual" ],
+        [ "2025-03-12T07:30:00Z", "relative" ]
+      ]
+    )
+    fallback_results = format_times_in_browser(
+      now: "2025-11-03T07:40:00Z",
+      timestamps: [ [ "2025-11-02T07:10:00Z", "time-ago" ] ]
+    )
+    new_year_results = format_times_in_browser(
+      now: "2025-01-02T20:00:00Z",
+      timestamps: [ [ "2024-12-20T20:00:00Z", "contextual" ] ]
+    )
+
+    assert_equal [ "yesterday", "in 2 days" ], spring_results
+    assert_equal [ "25 hours ago" ], fallback_results
+    assert_equal [ "Dec 20, 2024" ], new_year_results
+  end
+
+  test "event time controller positions an event at its local hour" do
+    page.execute_script <<~JS
+      const event = document.createElement("div")
+      event.dataset.controller = "event-time"
+      event.dataset.eventTimeTimestampValue = "2025-09-18T20:42:00Z"
+      event.dataset.eventTimeColumnValue = "2"
+      document.body.append(event)
+    JS
+
+    assert_selector "[data-controller='event-time'][style*='grid-area: 12 / 2']", visible: :all
+  end
+
+  test "local time controller replaces a raw timestamp" do
+    page.execute_script <<~JS
+      const time = document.createElement("time")
+      time.dateTime = "2025-09-18T20:42:00Z"
+      time.dataset.controller = "local-time"
+      time.dataset.localTimeFormatValue = "time"
+      time.textContent = time.dateTime
+      document.body.append(time)
+    JS
+
+    assert_selector "time[data-controller='local-time']", text: "1:42 PM"
+  end
+
+  private
+    def localize_timestamps_in_browser(description, now:)
+      page.driver.browser.execute_async_script <<~JS, description, now
+        const [ description, now, done ] = arguments
+
+        import("helpers/date_helpers").then(({ localizeTimestamps }) => {
+          done(localizeTimestamps(description, "date", new Date(now)))
+        }).catch(error => done({ error: error.message, stack: error.stack }))
+      JS
+    end
+
+    def format_times_in_browser(now:, timestamps:)
+      page.driver.browser.execute_async_script <<~JS, now, timestamps
+        const [ now, timestamps, done ] = arguments
+
+        import("helpers/date_helpers").then(({ formatLocalTime }) => {
+          done(timestamps.map(([ timestamp, format ]) => {
+            return formatLocalTime(new Date(timestamp), format, new Date(now))
+          }))
+        }).catch(error => done({ error: error.message, stack: error.stack }))
+      JS
+    end
+end
