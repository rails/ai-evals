diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..bed012a
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+const CALENDAR_FORMATS = [ "contextual", "date", "long-date", "relative" ]
+const MINUTE = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "date-time" } }
+
+  #refreshTimer
+
+  connect() {
+    this.#render()
+    this.#scheduleRefresh()
+  }
+
+  disconnect() {
+    clearTimeout(this.#refreshTimer)
+  }
+
+  #render() {
+    const date = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(date.valueOf())) {
+      this.element.textContent = formatLocalTime(date, this.formatValue)
+    }
+  }
+
+  #scheduleRefresh() {
+    const delay = this.#refreshDelay
+
+    if (delay) {
+      this.#refreshTimer = setTimeout(() => {
+        this.#render()
+        this.#scheduleRefresh()
+      }, delay)
+    }
+  }
+
+  get #refreshDelay() {
+    if (this.formatValue === "time-ago") {
+      return MINUTE
+    } else if (CALENDAR_FORMATS.includes(this.formatValue)) {
+      const now = new Date()
+      return new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1) - now
+    }
+  }
+}
