diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..09feae7
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,228 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  connect() {
+    this.pendingSaves = new Map()
+    this.optimisticMoves = new Map()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  start(event) {
+    const item = this.#itemFrom(event)
+
+    if (item) {
+      this.draggedItem = item
+      this.sourceContainer = this.#containerFor(item)
+      this.draggedItem.classList.add(this.draggedItemClass)
+
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = "move"
+        event.dataTransfer.setData("text/plain", item.id)
+      }
+    }
+  }
+
+  over(event) {
+    const container = this.#containerFrom(event)
+
+    if (this.draggedItem && container) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    }
+  }
+
+  enter(event) {
+    if (this.draggedItem) this.#highlight(this.#containerFrom(event))
+  }
+
+  leave(event) {
+    const container = this.#containerFrom(event)
+
+    if (container && !container.contains(event.relatedTarget)) {
+      container.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  drop(event) {
+    const container = this.#containerFrom(event)
+
+    if (this.draggedItem && container) {
+      event.preventDefault()
+
+      if (container !== this.sourceContainer) {
+        const item = this.draggedItem
+        this.#move(item, container)
+        this.#reflectDestinationOn(item, container)
+        this.optimisticMoves.set(item.id, { container, saved: false })
+        this.#save(item, container)
+      }
+    }
+
+    this.#finish()
+  }
+
+  end() {
+    this.#finish()
+  }
+
+  // A frame can finish loading with card locations from before a drop.
+  preserveOptimisticMoves(event) {
+    const container = this.#containerFor(event.target)
+    const newFrame = event.detail.newFrame
+
+    if (container && newFrame) {
+      this.optimisticMoves.forEach((move, id) => {
+        const item = this.#itemWithIdIn(id, this.element)
+        const incomingItem = this.#itemWithIdIn(id, newFrame)
+
+        if (move.saved && container === move.container && incomingItem) {
+          this.optimisticMoves.delete(id)
+        } else if (item && container === move.container && event.target.contains(item)) {
+          incomingItem?.remove()
+          this.#place(item.cloneNode(true), container, this.#insertionContainerIn(newFrame))
+        } else {
+          incomingItem?.remove()
+        }
+      })
+    }
+  }
+
+  disconnect() {
+    this.#finish()
+  }
+
+  #move(item, container) {
+    this.#place(item, container, this.#listFor(container))
+  }
+
+  #place(item, container, insertionContainer) {
+    const items = [ ...insertionContainer.querySelectorAll(this.#itemSelector) ].filter(candidate => candidate !== item)
+    const insertionPoint = this.#insertionPointFor(item, container, items)
+
+    if (insertionPoint) {
+      insertionPoint.before(item)
+    } else if (items.length > 0) {
+      items.at(-1).after(item)
+    } else {
+      insertionContainer.prepend(item)
+    }
+  }
+
+  #listFor(container) {
+    const existingList = container.querySelector(".cards__list")
+
+    if (existingList) {
+      return existingList
+    } else {
+      const list = document.createElement("div")
+      list.classList.add("cards__list", "hide-scrollbar")
+      const parent = container.querySelector("turbo-frame") || container.querySelector(".cards__transition-container") || container
+      parent.append(list)
+      return list
+    }
+  }
+
+  #insertionContainerIn(frame) {
+    return frame.querySelector(".cards__list") || frame
+  }
+
+  #insertionPointFor(item, container, items) {
+    if (this.#keepsGoldenItemsFirst(container) && !item.classList.contains("golden-effect")) {
+      return items.find(candidate => !candidate.classList.contains("golden-effect"))
+    } else {
+      return items[0]
+    }
+  }
+
+  #keepsGoldenItemsFirst(container) {
+    return [ "column", "maybe" ].includes(container.dataset.dragAndDropDestination)
+  }
+
+  #reflectDestinationOn(item, container) {
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+    item.classList.toggle("card--postponed", container.dataset.dragAndDropDestination === "not_now")
+    item.classList.toggle("card--active", ![ "closed", "not_now" ].includes(container.dataset.dragAndDropDestination))
+    item.style.setProperty("--card-color", container.dataset.dragAndDropCardColor)
+  }
+
+  // Keep rapid drops persisted in the same order they happened in the DOM.
+  #save(item, container) {
+    const previousSave = this.pendingSaves.get(item.id) || Promise.resolve()
+    const save = previousSave.catch(() => {}).then(() => this.#request(item, container))
+
+    this.pendingSaves.set(item.id, save)
+    save.then(
+      response => this.#markAsSaved(item, container, response),
+      error => console.error("Unable to move card", error)
+    )
+  }
+
+  #markAsSaved(item, container, response) {
+    const move = this.optimisticMoves.get(item.id)
+
+    if (response?.ok && move?.container === container) {
+      move.saved = true
+    }
+  }
+
+  #request(item, container) {
+    const options = { responseKind: "json" }
+
+    switch (container.dataset.dragAndDropDestination) {
+      case "closed":
+        return post(item.dataset.dragAndDropClosureUrl, options)
+      case "not_now":
+        return post(item.dataset.dragAndDropNotNowUrl, options)
+      case "maybe":
+        return destroy(item.dataset.dragAndDropTriageUrl, options)
+      case "column":
+        return post(item.dataset.dragAndDropTriageUrl, {
+          ...options,
+          body: { column_id: container.dataset.dragAndDropColumnId }
+        })
+    }
+  }
+
+  #itemWithIdIn(id, container) {
+    return [ ...container.querySelectorAll(this.#itemSelector) ].find(item => item.id === id)
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(candidate => candidate.classList.toggle(this.hoverContainerClass, candidate === container))
+  }
+
+  #finish() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  #itemFrom(event) {
+    return event.target.closest(this.#itemSelector)
+  }
+
+  #containerFrom(event) {
+    return event.target.closest(this.#containerSelector)
+  }
+
+  #containerFor(element) {
+    return element.closest(this.#containerSelector)
+  }
+
+  get #itemSelector() {
+    return '[data-drag-and-drop-target~="item"]'
+  }
+
+  get #containerSelector() {
+    return '[data-drag-and-drop-target~="container"]'
+  }
+}
