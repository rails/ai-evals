diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..ecfa279
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,132 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+  end
+
+  test "moves a card before saving and does not shift it afterwards" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+    card_selector = "##{dom_id(card, :article)}"
+    column_selector = "##{dom_id(column)}"
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe #{card_selector}"
+    assert_selector "#{column_selector} .cards__list", visible: :all
+    pause_fetch(card_triage_path(card))
+
+    find("#maybe #{card_selector}").drag_to(find(column_selector))
+
+    assert_selector "#{column_selector} #{card_selector}", visible: :all, wait: 0
+    assert_nil card.reload.column
+
+    resume_fetch
+    wait_until { card.reload.column == column }
+
+    assert_selector "#{column_selector} #{card_selector}", visible: :all, wait: 0
+  end
+
+  test "keeps the destination column's order" do
+    golden = cards(:logo)
+    regular = cards(:layout)
+    destination = columns(:writebook_in_progress)
+    source_selector = "##{dom_id(columns(:writebook_triage))}"
+    destination_selector = "##{dom_id(destination)}"
+
+    visit board_url(boards(:writebook))
+    expand(source_selector)
+
+    find("#{source_selector} ##{dom_id(golden, :article)}").drag_to(find(destination_selector))
+    find("#{source_selector} ##{dom_id(regular, :article)}").drag_to(find(destination_selector))
+    expand(destination_selector)
+
+    assert_equal expected_order(golden, regular), card_order_in(destination_selector)
+    wait_until { golden.reload.column == destination && regular.reload.column == destination }
+    assert_equal expected_order(golden, regular), card_order_in(destination_selector)
+  end
+
+  test "does not reorder a card within its column" do
+    card = cards(:layout)
+    column = columns(:writebook_triage)
+    column_selector = "##{dom_id(column)}"
+    last_active_at = card.last_active_at
+
+    visit board_url(boards(:writebook))
+    expand(column_selector)
+    original_order = card_order_in(column_selector)
+
+    find("#{column_selector} ##{dom_id(card, :article)}").drag_to(find(column_selector))
+
+    assert_equal original_order, card_order_in(column_selector)
+    assert_equal last_active_at, card.reload.last_active_at
+  end
+
+  test "moves a card through done, not now, and maybe" do
+    card = cards(:buy_domain)
+    card_selector = "##{dom_id(card, :article)}"
+
+    visit board_url(boards(:writebook))
+
+    find("#maybe #{card_selector}").drag_to(find("#closed-cards"))
+    assert_selector "#closed-cards #{card_selector}", visible: :all, wait: 0
+    expand("#closed-cards")
+
+    find("#closed-cards #{card_selector}").drag_to(find("#not-now"))
+    assert_selector "#not-now #{card_selector}", visible: :all, wait: 0
+    expand("#not-now")
+
+    find("#not-now #{card_selector}").drag_to(find("#maybe"))
+    assert_selector "#maybe #{card_selector}", wait: 0
+
+    wait_until { card.reload.awaiting_triage? }
+    assert_not card.closed?
+    assert_not card.postponed?
+    assert_selector "#maybe #{card_selector}", wait: 0
+  end
+
+  private
+    def pause_fetch(url)
+      page.execute_script <<~JS
+        const originalFetch = window.fetch
+        const delayedUrl = #{url.to_json}
+        window.fetch = (...args) => {
+          if (!args[0].toString().includes(delayedUrl)) return originalFetch(...args)
+
+          return new Promise((resolve, reject) => {
+            window.releaseCardMove = () => {
+              window.fetch = originalFetch
+              originalFetch(...args).then(resolve, reject)
+            }
+          })
+        }
+      JS
+    end
+
+    def resume_fetch
+      assert_equal "function", page.evaluate_script("typeof window.releaseCardMove")
+      page.execute_script("window.releaseCardMove()")
+    end
+
+    def expand(selector)
+      section = find(selector)
+      section.find(".cards__expander").click if section[:class].split.include?("is-collapsed")
+      assert_selector "#{selector}.is-expanded"
+    end
+
+    def expected_order(golden, regular)
+      [ golden, regular, cards(:text) ].map { |card| dom_id(card, :article) }
+    end
+
+    def card_order_in(selector)
+      all("#{selector} article.card", visible: :all, wait: 0).map { |card| card[:id] }
+    end
+
+    def wait_until
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.05 until yield
+      end
+    end
+end
