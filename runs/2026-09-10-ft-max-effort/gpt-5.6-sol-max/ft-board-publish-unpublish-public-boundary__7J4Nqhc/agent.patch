diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..b5d5ef7
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "an admin can publish and unpublish a board" do
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+
+    assert_difference "Board::Publication.count", +1 do
+      post board_publication_path(@board), as: :json
+      assert_response :success
+    end
+
+    publication = @board.reload.publication
+    assert publication.present?
+    assert_equal public_board_url(publication, script_name: nil), response.parsed_body["public_url"]
+
+    assert_difference "Board::Publication.count", -1 do
+      delete board_publication_path(@board), as: :json
+      assert_response :success
+    end
+
+    assert_nil @board.reload.publication
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "publication changes invalidate the cached board JSON" do
+    with_actionview_partial_caching do
+      get board_path(@board), as: :json
+      assert_nil response.parsed_body["public_url"]
+
+      post board_publication_path(@board), as: :json
+      assert_equal public_board_url(@board.reload.publication, script_name: nil), response.parsed_body["public_url"]
+
+      delete board_publication_path(@board), as: :json
+      assert_nil response.parsed_body["public_url"]
+    end
+  end
+
+  test "publishing and unpublishing are idempotent and republishing rotates the key" do
+    post board_publication_path(@board), as: :json
+    first_key = @board.reload.publication.key
+
+    assert_no_difference "Board::Publication.count" do
+      post board_publication_path(@board), as: :json
+      assert_response :success
+    end
+    assert_equal first_key, @board.reload.publication.key
+
+    delete board_publication_path(@board), as: :json
+
+    assert_no_difference "Board::Publication.count" do
+      delete board_publication_path(@board), as: :json
+      assert_response :success
+    end
+
+    post board_publication_path(@board), as: :json
+    assert_not_equal first_key, @board.reload.publication.key
+  end
+
+  test "a member cannot publish or unpublish a board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_nil @board.reload.publication
+
+    @board.create_publication!
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.publication.present?
+  end
+
+  test "a member cannot publish a board they created" do
+    logout_and_sign_in_as :jz
+    board = with_current_user(users(:jz)) { Board.create!(name: "Member board") }
+
+    post board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_not board.reload.published?
+  end
+end
