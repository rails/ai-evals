@@ -0,0 +1,17 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  test "has a unique secret key and is removed with its board" do
+    first = boards(:writebook).create_publication!
+    second = boards(:private).create_publication!
+
+    assert first.key.present?
+    assert_equal first.key, first.to_param
+    assert boards(:writebook).published?
+    assert_not_equal first.key, second.key
+
+    assert_difference "Board::Publication.count", -1 do
+      boards(:writebook).destroy!
+    end
+  end
+end
