diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..614ab2e
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,22 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    if publication
+      publication.destroy
+      association(:publication).reset
+    end
+  end
+end
