diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..9e77681
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.create_publication!
+  end
+
+  test "an anonymous visitor can open a published board without an account prefix" do
+    untenanted do
+      get public_board_path(@publication)
+    end
+
+    assert_response :success
+    assert_select "body.public"
+    assert_select "h1", text: @board.name
+    column = columns(:writebook_in_progress)
+    assert_select "a[href=?]", public_board_column_path(@publication, column, script_name: nil), text: column.name
+  end
+
+  test "the board response only contains published cards" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:kevin), status: :drafted)
+
+    untenanted do
+      get public_board_path(@publication)
+    end
+
+    assert_response :success
+    assert_select "h3", text: cards(:logo).title
+    assert_not_includes response.body, draft.title
+  end
+
+  test "show as JSON uses public URLs and excludes drafts" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:kevin), status: :drafted)
+
+    untenanted do
+      get public_board_path(@publication), as: :json
+    end
+
+    json = response.parsed_body
+    assert_response :success
+    assert_equal public_board_url(@publication, script_name: nil), json["public_url"]
+    assert_equal @board.cards.published.count, json["cards"].size
+    assert_not_includes json["cards"].pluck("id"), draft.id
+    assert json["cards"].all? { |card| URI.parse(card.fetch("url")).path.start_with?("/public/boards/#{@publication.key}/cards/") }
+  end
+
+  test "an invalid or revoked key is not found" do
+    untenanted do
+      get public_board_path("invalid-key")
+    end
+    assert_response :not_found
+
+    key = @publication.key
+    @publication.destroy!
+
+    untenanted do
+      get public_board_path(key)
+    end
+    assert_response :not_found
+  end
+end
