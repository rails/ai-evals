diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..58e12a6
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,74 @@
+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <meta property="og:title" content="<%= @card.title %> | <%= @board.name %>">
+  <meta property="og:description" content="<%= format_excerpt(@card.description, length: 200) %>">
+  <meta property="og:url" content="<%= public_board_card_url(@publication.key, @card.number, script_name: nil) %>">
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@publication.key), class: "btn btn--circle", aria: { label: "Back to #{@board.name}" } do %>
+      <%= icon_tag "arrow-left" %>
+    <% end %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <% if @card.image.attached? %>
+        <%= image_tag @card.image, class: "card__image", alt: "" %>
+      <% end %>
+
+      <header class="card__header flex-column align-start">
+        <% if @card.tags.any? %>
+          <div class="card__tags"><%= @card.tags.map(&:title).to_sentence %></div>
+        <% end %>
+        <% if @card.column %>
+          <div class="card__column-name card__column-name--current txt-uppercase"><%= @card.column.name %></div>
+        <% end %>
+      </header>
+
+      <div class="card__body">
+        <div class="card__content">
+          <h2 class="card__title"><%= @card.title %></h2>
+          <div class="card__description"><%= @card.description %></div>
+
+          <% if @card.steps.any? %>
+            <ul class="card__steps">
+              <% @card.steps.each do |step| %>
+                <li><%= "✓ " if step.completed? %><%= step.content %></li>
+              <% end %>
+            </ul>
+          <% end %>
+        </div>
+      </div>
+
+      <footer class="card__footer flex gap-half">
+        <span>Added by <%= @card.creator.familiar_name %></span>
+        <% if @card.assignees.any? %>
+          <span>Assigned to <%= @card.assignees.map(&:familiar_name).to_sentence %></span>
+        <% end %>
+      </footer>
+    <% end %>
+  </div>
+</section>
+
+<% comments = @card.comments.chronologically.preloaded.includes(:creator) %>
+<% if comments.any? %>
+  <section class="panel center-inline-size text-align-start">
+    <h2>Comments</h2>
+    <% comments.each do |comment| %>
+      <article id="<%= dom_id(comment) %>">
+        <strong><%= comment.creator.familiar_name %></strong>
+        <%= comment.body %>
+      </article>
+    <% end %>
+  </section>
+<% end %>
diff --git a/app/views/public/boards/cards/show.json.jbuilder b/app/views/public/boards/cards/show.json.jbuilder
