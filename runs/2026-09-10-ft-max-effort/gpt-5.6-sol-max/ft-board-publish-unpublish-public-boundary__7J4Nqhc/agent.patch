+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.create_publication!
+  end
+
+  test "an anonymous visitor can open a published card on a public board" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@publication, card.number)
+    end
+
+    assert_response :success
+    assert_select "h2", text: card.title
+  end
+
+  test "show as JSON" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@publication, card.number), as: :json
+    end
+
+    assert_response :success
+    assert_equal card.id, response.parsed_body["id"]
+    assert_equal card.steps.count, response.parsed_body["steps"].size
+  end
+
+  test "a draft or a card from another board is not exposed" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:kevin), status: :drafted)
+
+    untenanted do
+      get public_board_card_path(@publication, draft.number)
+    end
+    assert_response :not_found
+
+    other_card = with_current_user(users(:kevin)) do
+      boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :published)
+    end
+
+    untenanted do
+      get public_board_card_path(@publication, other_card.number)
+    end
+    assert_response :not_found
+  end
+end
