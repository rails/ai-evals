--- /dev/null
+++ b/app/models/comment/bursting.rb
@@ -0,0 +1,19 @@
+module Comment::Bursting
+  extend ActiveSupport::Concern
+
+  MINIMUM_COMMENTS = 3
+  MINIMUM_COMMENTERS = 2
+
+  def creates_burst?
+    recent_comments.count >= MINIMUM_COMMENTS && recent_comments.distinct.count(:creator_id) >= MINIMUM_COMMENTERS
+  end
+
+  private
+    def recent_comments
+      card.comments.by_user.where(created_at: burst_window)
+    end
+
+    def burst_window
+      (created_at - card.auto_postpone_period / 3)..created_at
+    end
+end
