@@ -0,0 +1,58 @@
+require "test_helper"
+
+class StalledCardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    boards(:writebook).publish
+    cards(:text).update_columns(burst_at: 3.weeks.ago, last_active_at: 15.days.ago)
+  end
+
+  test "index can list stalled cards" do
+    get cards_path(indexed_by: "stalled")
+
+    assert_response :success
+    assert_select "article##{dom_id(cards(:text), :article)}"
+    assert_select ".card__stalled", text: /Stalled/
+    assert_select "article##{dom_id(cards(:logo), :article)}", count: 0
+  end
+
+  test "index can list stalled cards as JSON" do
+    get cards_path(indexed_by: "stalled"), as: :json
+
+    assert_response :success
+    assert_equal [ cards(:text).id ], response.parsed_body.pluck("id")
+    assert response.parsed_body.first["stalled"]
+  end
+
+  test "card show identifies a stalled card" do
+    get card_path(cards(:text))
+
+    assert_response :success
+    assert_select ".card__stalled", text: /Stalled/
+  end
+
+  test "public card show identifies a stalled card" do
+    get public_board_card_path(boards(:writebook).publication.key, cards(:text))
+
+    assert_response :success
+    assert_select ".card__stalled", text: /Stalled/
+  end
+
+  test "cached card display changes when it becomes stalled" do
+    card = cards(:text)
+
+    freeze_time do
+      card.update_columns(burst_at: 2.weeks.ago, last_active_at: 2.weeks.ago + 1.second)
+
+      with_actionview_partial_caching do
+        get card_path(card)
+        assert_select ".card__stalled", count: 0
+
+        travel 1.second
+
+        get card_path(card)
+        assert_select ".card__stalled", text: /Stalled/
+      end
+    end
+  end
+end
diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..88b06cf
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+    @card.comments.by_user.delete_all
+  end
+
+  test "three comments by two people within a third of the board auto-close period create a burst" do
+    travel_to Time.current.change(usec: 0) do
+      create_comment_by :david, at: burst_window.ago
+      create_comment_by :kevin, at: (burst_window / 2).ago
+
+      assert_changes -> { @card.reload.burst_at }, from: nil, to: Time.current do
+        create_comment_by :david
+      end
+    end
+  end
+
+  test "comments outside a third of the board auto-close period do not create a burst" do
+    travel_to Time.current.change(usec: 0) do
+      create_comment_by :david, at: (burst_window + 1.second).ago
+      create_comment_by :kevin, at: (burst_window / 2).ago
+      create_comment_by :david
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "comments from only one person do not create a burst" do
+    travel_to Time.current.change(usec: 0) do
+      create_comment_by :david, at: 2.days.ago
+      create_comment_by :david, at: 1.day.ago
+      create_comment_by :david
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "system comments do not contribute to a burst" do
+    travel_to Time.current.change(usec: 0) do
+      create_comment_by :david, at: 2.days.ago
+      create_comment_by :kevin, at: 1.day.ago
+      create_comment_by :system
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "assignment creates a burst" do
+    travel_to Time.current.change(usec: 0) do
+      @card.toggle_assignment(users(:david))
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "unassignment does not create a burst" do
+    @card.toggle_assignment(users(:david))
+    @card.update_column(:burst_at, nil)
+
+    @card.toggle_assignment(users(:david))
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "reopening creates a burst" do
+    @card.close
+
+    travel_to Time.current.change(usec: 0) do
+      @card.reopen
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "an older burst does not replace a newer burst" do
+    @card.register_burst(at: 1.day.ago)
+
+    assert_no_changes -> { @card.reload.burst_at } do
+      @card.register_burst(at: 2.days.ago)
+    end
+  end
+
+  test "a card stalls exactly two weeks after its burst and latest activity" do
+    freeze_time do
+      @card.update_columns(burst_at: 2.weeks.ago, last_active_at: 2.weeks.ago)
+
+      assert_predicate @card.reload, :stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "a card without a burst does not stall" do
+    @card.update_columns(burst_at: nil, last_active_at: 1.year.ago)
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity resets a stalled card" do
+    travel_to 15.days.ago do
+      @card.toggle_assignment(users(:david))
+    end
+
+    assert_predicate @card.reload, :stalled?
+
+    @card.touch_last_active_at
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "card activity clears the stalled state" do
+    @card.update_columns(burst_at: 1.month.ago, last_active_at: 1.month.ago)
+
+    assert_changes -> { @card.reload.stalled? }, from: true, to: false do
+      @card.reactions.create!(content: "👍")
+    end
+  end
+
+  test "a reset card stalls again after another two weeks without activity" do
+    reset_at = Time.current.change(usec: 0)
+
+    travel_to reset_at do
+      @card.update_columns(burst_at: 1.month.ago, last_active_at: 1.month.ago)
+      @card.touch_last_active_at
+    end
+
+    travel_to reset_at + 2.weeks do
+      assert_predicate @card.reload, :stalled?
+    end
+  end
+
+  test "closed, postponed, and draft cards are not stalled" do
+    @card.update_columns(burst_at: 1.month.ago, last_active_at: 1.month.ago)
+    @card.close
+    @card.update_column(:last_active_at, 1.month.ago)
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    @card.update_columns(burst_at: 1.month.ago, last_active_at: 1.month.ago)
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.update!(status: :drafted)
+    @card.update_columns(burst_at: 1.month.ago, last_active_at: 1.month.ago)
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  private
+    def burst_window
+      (@card.auto_postpone_period / 3).seconds
+    end
+
+    def create_comment_by(user, at: Time.current)
+      @card.comments.create!(creator: users(user), body: "A comment", created_at: at)
+    end
+end
