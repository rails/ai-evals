diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..bd74b15
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,35 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      cutoff = as_of - STALL_PERIOD
+
+      active.where(last_active_at: ..cutoff, burst_at: ..cutoff)
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    active? && burst_at.present? && burst_at <= as_of - STALL_PERIOD && last_active_at <= as_of - STALL_PERIOD
+  end
+
+  def register_burst_from(event)
+    if event.action.card_assigned? || event.action.card_reopened?
+      register_burst(at: event.created_at)
+    end
+  end
+
+  def register_burst(at: Time.current)
+    with_lock do
+      if burst_at.nil? || burst_at < at
+        update!(burst_at: at)
+      end
+    end
+  end
+
+  def cache_key_with_version
+    [ super, ("stalled" if stalled?) ].compact.join("/")
+  end
+end
