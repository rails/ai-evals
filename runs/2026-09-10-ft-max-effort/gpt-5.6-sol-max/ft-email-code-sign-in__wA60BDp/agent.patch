--- /dev/null
+++ b/app/views/sessions/magic_links/new.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p class="margin-none">We sent a six-character code to <strong><%= @email_address %></strong>.</p>
+  <p class="margin-none-block-start margin-block-end-half">Enter it below within 15 minutes to continue.</p>
+
+  <%= form_with url: @verification_path, class: "flex flex-column align-center gap txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.text_field :code,
+          required: true,
+          autofocus: true,
+          autocomplete: "one-time-code",
+          autocapitalize: "characters",
+          spellcheck: false,
+          minlength: MagicLink::CODE_LENGTH,
+          maxlength: MagicLink::CODE_LENGTH,
+          pattern: "[A-Za-z0-9]{#{MagicLink::CODE_LENGTH}}",
+          class: "input",
+          placeholder: "••••••" %>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if @development_magic_link_code %>
+    <p class="txt-small txt-subtle margin-none">Psst, here’s your code: <strong><%= @development_magic_link_code %></strong></p>
+  <% end %>
+
+  <p class="txt-small margin-none"><%= link_to "Use a different email address", @restart_path %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
