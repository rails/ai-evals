diff --git a/app/controllers/concerns/magic_link_authentication.rb b/app/controllers/concerns/magic_link_authentication.rb
new file mode 100644
index 0000000..2cdac1d
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,70 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  PENDING_AUTHENTICATION_COOKIE = :pending_authentication_token
+
+  private
+    def create_pending_authentication_for(identity)
+      MagicLink.new(identity).tap do |magic_link|
+        set_pending_authentication_token magic_link.token
+        session[:development_magic_link_code] = magic_link.code if Rails.env.development?
+        magic_link.deliver_later
+      end
+    end
+
+    def pending_authentication_identity
+      MagicLink.identity_for(pending_authentication_token)
+    end
+
+    def authenticate_pending_identity
+      MagicLink.authenticate(pending_authentication_token, params.expect(:code))
+    end
+
+    def start_session_for_pending_identity
+      if identity = authenticate_pending_identity
+        terminate_session if Current.session
+        clear_pending_authentication
+        start_new_session_for identity
+        identity
+      end
+    end
+
+    def pending_authentication_token
+      cookies[PENDING_AUTHENTICATION_COOKIE]
+    end
+
+    def set_pending_authentication_token(token)
+      cookies[PENDING_AUTHENTICATION_COOKIE] = {
+        value: token,
+        expires: MagicLink::EXPIRATION.from_now,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def clear_pending_authentication
+      cookies.delete PENDING_AUTHENTICATION_COOKIE
+      session.delete :development_magic_link_code
+    end
+
+    def prepare_magic_link_form(verification_path:, restart_path:)
+      if identity = pending_authentication_identity
+        @email_address = identity.email_address
+        @verification_path = verification_path
+        @restart_path = restart_path
+        @development_magic_link_code = session[:development_magic_link_code] if Rails.env.development?
+        true
+      else
+        clear_pending_authentication
+        false
+      end
+    end
+
+    def pending_authentication_json(magic_link)
+      { pending_authentication_token: magic_link.token }
+    end
+
+    def magic_link_failure_message
+      "That code didn't work. Try again."
+    end
+end
diff --git a/app/controllers/join_codes/magic_links_controller.rb b/app/controllers/join_codes/magic_links_controller.rb
