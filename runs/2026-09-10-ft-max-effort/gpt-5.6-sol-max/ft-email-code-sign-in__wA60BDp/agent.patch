@@ -0,0 +1,82 @@
+class JoinCodes::MagicLinksController < ApplicationController
+  include MagicLinkAuthentication
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+  before_action :ensure_pending_authentication, only: :new
+
+  layout "public"
+
+  def new
+    render template: "sessions/magic_links/new"
+  end
+
+  def create
+    if identity = start_session_for_pending_identity
+      join_identity(identity)
+    else
+      authentication_failed
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code = Account::JoinCode.find_by(code: params.expect(:join_code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render template: "join_codes/inactive", status: :gone
+      end
+    end
+
+    def ensure_pending_authentication
+      unless prepare_magic_link_form(
+        verification_path: join_magic_link_path(join_code: @join_code.code),
+        restart_path: join_path(code: @join_code.code)
+      )
+        redirect_to join_path(code: @join_code.code), alert: "That sign-in code has expired. Try again."
+      end
+    end
+
+    def join_identity(identity)
+      if user = @join_code.redeem_for(identity)
+        respond_to do |format|
+          format.html { redirect_to after_join_url(user) }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        render template: "join_codes/inactive", status: :gone
+      end
+    end
+
+    def after_join_url(user)
+      if user.setup?
+        landing_url(script_name: @join_code.account.slug)
+      else
+        new_users_verification_url(script_name: @join_code.account.slug)
+      end
+    end
+
+    def authentication_failed
+      respond_to do |format|
+        format.html do
+          redirect_to pending_authentication_identity ? new_join_magic_link_path(join_code: @join_code.code) : join_path(code: @join_code.code),
+            alert: magic_link_failure_message
+        end
+        format.json { render json: { message: magic_link_failure_message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_join_magic_link_path(join_code: params[:join_code]), alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
