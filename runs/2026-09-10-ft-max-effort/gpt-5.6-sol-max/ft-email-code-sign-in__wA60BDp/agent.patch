+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+    @identity = identities(:mike)
+    @magic_link = MagicLink.new(@identity)
+    cookies[:pending_authentication_token] = @magic_link.token
+  end
+
+  test "new renders a top-level code field" do
+    get new_join_magic_link_path(join_code: @join_code.code, script_name: @account.slug)
+
+    assert_response :success
+    assert_select "form[action=?]", join_magic_link_path(join_code: @join_code.code, script_name: @account.slug) do
+      assert_select "input[name=code][maxlength=6]"
+    end
+  end
+
+  test "create signs in and joins the account" do
+    assert_difference -> { Session.count }, 1 do
+      assert_difference -> { @account.users.count }, 1 do
+        assert_difference -> { @join_code.reload.usage_count }, 1 do
+          post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+            params: { code: @magic_link.code }
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert @identity.users.exists?(account: @account)
+    assert cookies[:session_token].present?
+  end
+
+  test "create rejects an incorrect code without joining" do
+    assert_no_difference -> { Session.count } do
+      assert_no_difference -> { @account.users.count } do
+        assert_no_difference -> { @join_code.reload.usage_count } do
+          post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+            params: { code: "000000" }
+        end
+      end
+    end
+
+    assert_redirected_to new_join_magic_link_url(join_code: @join_code.code, script_name: @account.slug)
+  end
+
+  test "create rejects an expired code without joining" do
+    freeze_time
+    magic_link = MagicLink.new(@identity)
+    cookies[:pending_authentication_token] = magic_link.token
+    travel 15.minutes + 1.second
+
+    assert_no_difference -> { @account.users.count } do
+      post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+        params: { code: magic_link.code }
+    end
+
+    assert_redirected_to join_url(code: @join_code.code, script_name: @account.slug)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create via JSON returns a session token and joins" do
+    assert_difference -> { @account.users.count }, 1 do
+      post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug, format: :json),
+        params: { code: @magic_link.code }, as: :json
+    end
+
+    assert_response :success
+    assert response.parsed_body["session_token"].present?
+  end
+end
