+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+    @magic_link = MagicLink.new(@identity)
+    cookies[:pending_authentication_token] = @magic_link.token
+  end
+
+  test "new renders the code field" do
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "input[name=code][maxlength=6][autocomplete=one-time-code]"
+  end
+
+  test "new redirects without a pending authentication" do
+    cookies[:pending_authentication_token] = "invalid"
+
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_redirected_to new_session_url(script_name: nil)
+  end
+
+  test "create signs in with the emailed code" do
+    assert_difference -> { Session.count }, 1 do
+      untenanted do
+        post session_magic_link_path, params: { code: @magic_link.code }
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: nil)
+    assert cookies[:session_token].present?
+    assert_not cookies[:pending_authentication_token].present?
+  end
+
+  test "create accepts a lowercase code" do
+    assert_difference -> { Session.count }, 1 do
+      untenanted do
+        post session_magic_link_path, params: { code: @magic_link.code.downcase }
+      end
+    end
+  end
+
+  test "create rejects an incorrect code" do
+    assert_no_difference -> { Session.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: "000000" }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_url(script_name: nil)
+    assert cookies[:pending_authentication_token].present?
+  end
+
+  test "create rejects an expired code" do
+    freeze_time
+    cookies[:pending_authentication_token] = MagicLink.new(@identity).tap { |link| @code = link.code }.token
+    travel 15.minutes + 1.second
+
+    assert_no_difference -> { Session.count } do
+      untenanted do
+        post session_magic_link_path, params: { code: @code }
+      end
+    end
+
+    assert_redirected_to new_session_url(script_name: nil)
+  end
+
+  test "create via JSON returns a session token" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: @magic_link.code }, as: :json
+    end
+
+    assert_response :success
+    assert response.parsed_body["session_token"].present?
+  end
+
+  test "create via JSON rejects an incorrect code" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "000000" }, as: :json
+    end
+
+    assert_response :unauthorized
+    assert_equal "That code didn't work. Try again.", response.parsed_body["message"]
+  end
+end
