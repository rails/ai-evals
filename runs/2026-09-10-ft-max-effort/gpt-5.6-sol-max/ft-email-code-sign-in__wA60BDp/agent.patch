diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..61f43b9
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,69 @@
+class MagicLink
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  PURPOSE = :magic_link
+  CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+
+  attr_reader :code, :identity
+
+  class << self
+    def authenticate(token, code)
+      if signed_identity = parse(token)
+        if valid_code?(signed_identity, code)
+          signed_identity.find
+        end
+      end
+    end
+
+    def identity_for(token)
+      parse(token)&.find
+    end
+
+    private
+      def parse(token)
+        SignedGlobalID.parse(token, for: PURPOSE)
+      end
+
+      def valid_code?(signed_identity, code)
+        normalized_code = code.to_s.strip.upcase
+        code_digest = signed_identity.params["code_digest"]
+
+        normalized_code.match?(/\A[A-Z0-9]{#{CODE_LENGTH}}\z/) &&
+          code_digest.present? &&
+          BCrypt::Password.new(code_digest).is_password?(normalized_code)
+      rescue BCrypt::Errors::InvalidHash
+        false
+      end
+  end
+
+  def initialize(identity)
+    @identity = identity
+    @code = Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+  end
+
+  def token
+    @token ||= identity.to_sgid(
+      for: PURPOSE,
+      expires_in: EXPIRATION,
+      code_digest: code_digest
+    ).to_s
+  end
+
+  def deliver_later
+    MagicLinkMailer.magic_link(identity, code).deliver_later
+    log_code_without_email_delivery
+    self
+  end
+
+  private
+    def code_digest
+      cost = ActiveModel::SecurePassword.min_cost ? BCrypt::Engine::MIN_COST : BCrypt::Engine.cost
+      @code_digest ||= BCrypt::Password.create(code, cost: cost).to_s
+    end
+
+    def log_code_without_email_delivery
+      if Rails.env.production? && ENV["SMTP_ADDRESS"].blank?
+        Rails.logger.info "Fizzy sign-in code for #{identity.email_address}: #{code}"
+      end
+    end
+end
