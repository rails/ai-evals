+    end
+
+    assert_equal [ @identity.email_address ], @email.to
+    assert_includes @email.subject, @code
+  end
+
+  test "includes the code and expiration in the body" do
+    assert_match @code, @email.body.encoded
+    assert_match(/15 minutes/i, @email.body.encoded)
+  end
+
+  test "has both HTML and text parts" do
+    assert @email.html_part.present?
+    assert @email.text_part.present?
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..ade3469
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @magic_link = MagicLink.new(@identity)
+  end
+
+  test "generates a six-character code" do
+    assert_match(/\A[A-Z0-9]{6}\z/, @magic_link.code)
+  end
+
+  test "authenticates its identity" do
+    assert_equal @identity, MagicLink.authenticate(@magic_link.token, @magic_link.code)
+  end
+
+  test "accepts lowercase code with surrounding whitespace" do
+    assert_equal @identity, MagicLink.authenticate(@magic_link.token, " #{@magic_link.code.downcase} ")
+  end
+
+  test "rejects an incorrect code" do
+    assert_nil MagicLink.authenticate(@magic_link.token, "000000")
+  end
+
+  test "rejects an invalid token" do
+    assert_nil MagicLink.authenticate("invalid-token", @magic_link.code)
+    assert_nil MagicLink.identity_for("invalid-token")
+  end
+
+  test "rejects a tampered token" do
+    token = @magic_link.token.sub(/.$/, @magic_link.token.end_with?("a") ? "b" : "a")
+
+    assert_nil MagicLink.authenticate(token, @magic_link.code)
+  end
+
+  test "works for fifteen minutes" do
+    freeze_time
+    token = @magic_link.token
+
+    travel 15.minutes - 1.second
+    assert_equal @identity, MagicLink.authenticate(token, @magic_link.code)
+
+    travel 2.seconds
+    assert_nil MagicLink.authenticate(token, @magic_link.code)
+  end
+end
