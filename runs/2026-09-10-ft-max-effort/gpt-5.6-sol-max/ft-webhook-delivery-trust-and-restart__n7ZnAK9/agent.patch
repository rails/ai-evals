diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..29688d0
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,40 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAX_CONSECUTIVE_FAILURES = 10
+  MINIMUM_FAILURE_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      record_success
+    elsif delivery.failed?
+      record_failure
+    end
+  end
+
+  def record_success
+    with_lock do
+      if consecutive_failures_count != 0 || first_failure_at.present?
+        update!(consecutive_failures_count: 0, first_failure_at: nil)
+      end
+    end
+  end
+
+  def record_failure
+    with_lock do
+      failed_at = Time.current
+      self.first_failure_at ||= failed_at
+      self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+      save!
+
+      webhook.deactivate if delinquent_at?(failed_at)
+    end
+  end
+
+  private
+    def delinquent_at?(time)
+      consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES &&
+        first_failure_at <= time - MINIMUM_FAILURE_DURATION
+    end
+end
