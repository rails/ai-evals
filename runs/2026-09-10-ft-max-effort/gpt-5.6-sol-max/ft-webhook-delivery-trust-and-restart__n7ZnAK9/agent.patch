+class EnforceWebhookDeliveryUniqueness < ActiveRecord::Migration[8.2]
+  def up
+    remove_duplicate_rows :webhook_deliveries, %i[ webhook_id event_id ]
+    remove_duplicate_rows :webhook_delinquency_trackers, %i[ webhook_id ]
+
+    add_index :webhook_deliveries, %i[ webhook_id event_id ], unique: true
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id, unique: true
+  end
+
+  def down
+    remove_index :webhook_deliveries, %i[ webhook_id event_id ]
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id
+  end
+
+  private
+    def remove_duplicate_rows(table, columns)
+      record_class = Class.new(ActiveRecord::Base)
+      record_class.table_name = table
+
+      record_class.group(*columns).having("COUNT(*) > 1").pluck(*columns).each do |values|
+        duplicate_ids = record_class
+          .where(columns.zip(Array(values)).to_h)
+          .order(:created_at, :id)
+          .pluck(:id)
+          .drop(1)
+
+        record_class.where(id: duplicate_ids).delete_all
+      end
+    end
+end
