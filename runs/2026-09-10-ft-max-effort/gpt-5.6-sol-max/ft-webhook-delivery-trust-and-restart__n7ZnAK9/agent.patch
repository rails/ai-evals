+class Webhook::DeliveryRuntimeTest < ActiveSupport::TestCase
+  WEBHOOK_PUBLIC_TEST_IP = "93.184.216.34"
+
+  setup do
+    @event = events(:layout_commented)
+    @webhook = @event.board.webhooks.create!(
+      name: "Runtime receiver",
+      url: "https://receiver.example/events",
+      subscribed_actions: [ @event.action ]
+    )
+  end
+
+  test "new deliveries are enqueued" do
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      @webhook.deliveries.create!(event: @event)
+    end
+  end
+
+  test "posts signed event JSON and records a successful response exactly once" do
+    delivery = @webhook.deliveries.create!(event: @event)
+    stub_dns_resolution WEBHOOK_PUBLIC_TEST_IP
+    captured_request = nil
+    request_stub = stub_request(:post, @webhook.url)
+      .with(ipaddr: WEBHOOK_PUBLIC_TEST_IP) { |request| captured_request = request }
+      .to_return(status: 202, headers: { "X-Receiver" => "accepted" })
+
+    delivery.deliver_now
+    delivery.deliver_now
+
+    assert_requested request_stub, times: 1
+    assert_predicate delivery.reload, :succeeded?
+    assert_equal 202, delivery.response[:code]
+    assert_equal "accepted", delivery.response.dig(:headers, "x-receiver")
+
+    payload = JSON.parse(captured_request.body)
+    assert_equal @event.id, payload["id"]
+    assert_equal @event.action, payload["action"]
+    assert_equal @event.board_id, payload.dig("board", "id")
+    assert_equal @event.eventable_id, payload.dig("eventable", "id")
+
+    headers = delivery.request[:headers]
+    assert_equal Webhook::Delivery::USER_AGENT, headers["User-Agent"]
+    assert_equal "application/json", headers["Content-Type"]
+    assert_equal @event.created_at.utc.iso8601, headers["X-Webhook-Timestamp"]
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, captured_request.body), headers["X-Webhook-Signature"]
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "records a non-success response as a failure" do
+    delivery = @webhook.deliveries.create!(event: @event)
+    stub_dns_resolution WEBHOOK_PUBLIC_TEST_IP
+    stub_request(:post, @webhook.url).to_return(status: 503)
+
+    delivery.deliver_now
+
+    assert_predicate delivery.reload, :completed?
+    assert_predicate delivery, :failed?
+    assert_equal 503, delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "records an unreachable destination without retrying" do
+    delivery = @webhook.deliveries.create!(event: @event)
+    stub_dns_resolution WEBHOOK_PUBLIC_TEST_IP
+    request_stub = stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver_now
+    delivery.deliver_now
+
+    assert_requested request_stub, times: 1
+    assert_predicate delivery.reload, :errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "records DNS failures as an unreachable destination" do
+    delivery = @webhook.deliveries.create!(event: @event)
+    SsrfProtection.stubs(:resolve_public_ip).raises(Resolv::ResolvError)
+
+    delivery.deliver_now
+
+    assert_predicate delivery.reload, :errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "does not connect to a private destination" do
+    delivery = @webhook.deliveries.create!(event: @event)
+    stub_dns_resolution "127.0.0.1"
+    request_stub = stub_request(:post, @webhook.url)
+
+    delivery.deliver_now
+
+    assert_not_requested request_stub
+    assert_predicate delivery.reload, :errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "wraps event text for chat receivers" do
+    payload_shapes = {
+      "https://hooks.slack.com/services/T123/B123/token" => [ "text" ],
+      "https://campfire.example.com/rooms/123/456-room/messages" => [ "message", "body" ],
+      "https://basecamp.com/999/integrations/token/buckets/111/chats/222/lines" => [ "content" ]
+    }
+    stub_dns_resolution WEBHOOK_PUBLIC_TEST_IP
+
+    payload_shapes.each do |url, path|
+      webhook = @event.board.webhooks.create!(name: url, url: url)
+      delivery = webhook.deliveries.create!(event: @event)
+      payload = nil
+      stub_request(:post, url).with { |request| payload = JSON.parse(request.body) }.to_return(status: 200)
+
+      delivery.deliver_now
+
+      assert payload.dig(*path).present?, "unexpected payload for #{url}: #{payload.inspect}"
+    end
+  end
+
+  test "cleanup keeps one week of delivery history" do
+    travel_to Time.zone.local(2026, 1, 15, 12) do
+      expired = @webhook.deliveries.create!(event: @event, created_at: 1.week.ago - 1.second)
+      retained = @webhook.deliveries.create!(event: events(:logo_assignment_jz), created_at: 1.week.ago + 1.second)
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(expired.id)
+      assert Webhook::Delivery.exists?(retained.id)
+    end
+  end
+end
