+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  test "a success email enqueue failure does not turn a committed import into a failure" do
+    account_import = build_import
+    ImportMailer.stubs(:completed).raises("mail queue unavailable")
+
+    assert_difference -> { Account.count }, 1 do
+      assert_raises RuntimeError do
+        account_import.process_now
+      end
+    end
+
+    assert account_import.reload.completed?
+    assert account_import.imported_account.present?
+    imported_account_id = account_import.imported_account_id
+
+    ImportMailer.unstub(:completed)
+    assert_no_difference -> { Account.count } do
+      account_import.process_now
+    end
+    assert_equal imported_account_id, account_import.reload.imported_account_id
+  end
+
+  private
+    def build_import
+      account = accounts(:"37s")
+      user = users(:kevin)
+      export = Export.create!(account: account, user: user, kind: :account)
+      export.generate_now
+      export.reload
+
+      Account::Import.create!(identity: user.identity).tap do |account_import|
+        account_import.archive.attach(
+          io: StringIO.new(export.archive.download), filename: "account.zip", content_type: "application/zip"
+        )
+      end
+    end
+end
