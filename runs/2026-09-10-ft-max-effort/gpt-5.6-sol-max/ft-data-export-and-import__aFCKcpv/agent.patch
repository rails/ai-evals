diff --git a/test/models/account/data_transfer/importer_test.rb b/test/models/account/data_transfer/importer_test.rb
new file mode 100644
index 0000000..6da5351
--- /dev/null
+++ b/test/models/account/data_transfer/importer_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class Account::DataTransfer::ImporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "round trips direct and rich text attachments with their bytes" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    Current.set(account: @account, user: @user, identity: @user.identity) do
+      card.image.attach(io: StringIO.new("background bytes"), filename: "background.png", content_type: "image/png")
+      @user.avatar.attach(io: File.open(file_fixture("avatar.png"), "rb"), filename: "avatar.png", content_type: "image/png")
+      description_blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("card document"), filename: "card.txt", content_type: "text/plain"
+      )
+      comment_blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("comment document"), filename: "comment.txt", content_type: "text/plain"
+      )
+      card.update!(description: ActionText::Content.new(%(<a href="#{@account.slug}/cards/#{card.number}">Related card</a>)).append_attachables(description_blob))
+      comment.update!(body: ActionText::Content.new("Comment").append_attachables([ comment_blob, users(:david) ]))
+    end
+
+    imported = import_exported_account
+    imported_card = imported.cards.find_by!(number: card.number)
+    imported_comment = imported_card.comments.find_by!(created_at: comment.created_at)
+
+    assert_equal "background bytes", imported_card.image.download
+    assert imported.users.find_by!(name: @user.name).avatar.attached?
+    assert_equal "card document", imported_card.description.body.attachables.grep(ActiveStorage::Blob).sole.download
+    assert_includes imported_card.description.body.to_html, %(href="#{imported.slug}/cards/#{imported_card.number}")
+    assert_equal "comment document", imported_comment.body.body.attachables.grep(ActiveStorage::Blob).sole.download
+    assert_equal "David", imported_comment.body.body.attachables.grep(User).sole.name
+    filenames = ActiveStorage::Attachment.where(account: imported).includes(:blob).map { |attachment| attachment.blob.filename.to_s }
+    assert_includes filenames, "background.png"
+    assert_includes filenames, "card.txt"
+    assert_includes filenames, "comment.txt"
+    assert_equal 45, imported.bytes_used
+  end
+
+  test "failure after uploading files rolls back records and removes uploaded objects" do
+    Current.set(account: @account, user: @user, identity: @user.identity) do
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("important"), filename: "important.txt", content_type: "text/plain"
+      )
+      cards(:logo).update!(description: ActionText::Content.new("File").append_attachables(blob))
+    end
+
+    export = create_account_export
+    corrupted = corrupt_rich_text_attachable(export)
+    account_import = Account::Import.create!(identity: @user.identity)
+    account_import.archive.attach(io: File.open(corrupted.path, "rb"), filename: "corrupted.zip", content_type: "application/zip")
+
+    account_count = Account.count
+    blob_count = ActiveStorage::Blob.count
+    staging_blob_id = account_import.archive.blob.id
+    service = ActiveStorage::Blob.service
+    uploaded_keys = []
+    subscriber = ActiveSupport::Notifications.subscribe("service_upload.active_storage") do |event|
+      uploaded_keys << event.payload[:key]
+    end
+
+    begin
+      assert_raises Account::DataTransfer::InvalidArchive do
+        account_import.process_now
+      end
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    assert_equal account_count, Account.count
+    assert_equal blob_count - 1, ActiveStorage::Blob.count
+    assert_not ActiveStorage::Blob.exists?(staging_blob_id)
+    assert uploaded_keys.any?
+    assert uploaded_keys.none? { |key| service.exist?(key) }
+    assert account_import.reload.failed?
+    assert_match(/could not be imported|missing/i, account_import.error_message)
+  ensure
+    corrupted&.close!
+  end
+
+  test "a truncated archive with dangling card references leaves no account" do
+    export = create_account_export
+    omitted_board_id = boards(:writebook).id
+    truncated = copy_archive(export) do |path, content|
+      if path == "records/boards/#{omitted_board_id}.json"
+        :omit
+      else
+        content
+      end
+    end
+    account_import = Account::Import.create!(identity: @user.identity)
+    account_import.archive.attach(io: File.open(truncated.path, "rb"), filename: "truncated.zip", content_type: "application/zip")
+    account_count = Account.count
+
+    assert_raises Account::DataTransfer::InvalidArchive do
+      account_import.process_now
+    end
+
+    assert_equal account_count, Account.count
+    assert_match(/missing record reference/i, account_import.reload.error_message)
+  ensure
+    truncated&.close!
+  end
+
+  test "an identity with no existing accounts can import and become owner" do
+    export = create_account_export
+    importer_identity = Identity.create!(email_address: "new-importer@example.com")
+    account_import = Account::Import.create!(identity: importer_identity)
+    account_import.archive.attach(
+      io: StringIO.new(export.archive.download), filename: "account.zip", content_type: "application/zip"
+    )
+
+    imported = account_import.process_now
+
+    assert_equal importer_identity, imported.users.owner.sole.identity
+    assert_includes importer_identity.reload.accounts, imported
+  end
+
+  test "a different importer becomes owner and can access every board" do
+    export = create_account_export
+    importer_identity = identities(:mike)
+    account_import = Account::Import.create!(identity: importer_identity)
+    account_import.archive.attach(
+      io: StringIO.new(export.archive.download), filename: "account.zip", content_type: "application/zip"
+    )
+
+    imported = account_import.process_now
+    owner = imported.users.owner.sole
+
+    assert_equal importer_identity, owner.identity
+    assert_equal imported.boards.order(:id).ids, owner.boards.order(:id).ids
+    assert_equal @account.users.count + 1, imported.users.count
+  end
+
+  private
+    def create_account_export
+      Export.create!(account: @account, user: @user, kind: :account).tap(&:generate_now).reload
+    end
+
+    def import_exported_account
+      export = create_account_export
+      account_import = Account::Import.create!(identity: @user.identity)
+      account_import.archive.attach(
+        io: StringIO.new(export.archive.download), filename: "account.zip", content_type: "application/zip"
+      )
+      account_import.process_now
+    end
+
+    def copy_archive(export)
+      target = Tempfile.new([ "modified-account", ".zip" ])
+      target.binmode
+      writer = ZipFile::Writer.new(target)
+
+      ZipFile.open(export.archive) do |source|
+        source.entries.each do |path, entry|
+          content = source.read(path, limit: [ entry.uncompressed_size, 1 ].max)
+          replacement = yield(path, content)
+          writer.add_file(path, replacement, compress: entry.storage_mode != 0) unless replacement == :omit
+        end
+      end
+
+      writer.close
+      target.rewind
+      target
+    end
+
+    def corrupt_rich_text_attachable(export)
+      target = Tempfile.new([ "corrupted-account", ".zip" ])
+      target.binmode
+      writer = ZipFile::Writer.new(target)
+
+      ZipFile.open(export.archive) do |source|
+        source.entries.each do |path, entry|
+          if path.match?(%r{\Arecords/action_text_rich_texts/.+\.json\z})
+            content = source.read(path)
+            content = content.sub(/data-fizzy-attachable-id=\\?"[^"\\]+/, 'data-fizzy-attachable-id=\"missing-blob\"')
+            writer.add_file(path, content)
+          else
+            writer.add_file(path, compress: entry.storage_mode != 0) do |sink|
+              source.open(path) do |input|
+                while chunk = input.read(1.megabyte)
+                  sink.write(chunk)
+                end
+              end
+            end
+          end
+        end
+      end
+
+      writer.close
+      target.rewind
+      target
+    end
+end
