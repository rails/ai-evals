@@ -0,0 +1,26 @@
+class Exports::DownloadsController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+
+  def show
+    export = Export.find_signed!(params[:token], purpose: :export_download)
+
+    if export.downloadable?
+      ActiveStorage::Current.set(url_options: url_options) do
+        redirect_to export.archive.blob.url(
+          expires_in: [ export.expires_at - Time.current, 5.minutes ].min,
+          disposition: :attachment
+        ), allow_other_host: true
+      end
+    else
+      head :gone
+    end
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    head :not_found
+  end
+
+  private
+    def url_options
+      { protocol: request.protocol, host: request.host, port: request.optional_port }
+    end
+end
