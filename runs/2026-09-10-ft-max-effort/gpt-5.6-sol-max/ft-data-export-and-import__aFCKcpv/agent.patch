@@ -0,0 +1,27 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  def new
+    @account_import = Account::Import.new
+  end
+
+  def create
+    @account_import = Account::Import.new(identity: Current.identity)
+    @account_import.archive.attach(import_params[:archive])
+
+    if @account_import.save
+      @account_import.process_later
+      redirect_to session_menu_path, notice: "We’ll email you when your account import is finished."
+    else
+      @account_import.archive.purge if @account_import.archive.attached?
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def import_params
+      params.expect(account_import: [ :archive ])
+    end
+end
