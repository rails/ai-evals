@@ -0,0 +1,38 @@
+module Fizzy::Saas::AccountImport
+  private
+    def provision_external_account(account_name)
+      @queenbee_import_account = Queenbee::Remote::Account.create!(
+        product_name: "fizzy",
+        name: account_name,
+        owner_name: importing_owner_name,
+        owner_email: identity.email_address,
+        trial: true,
+        subscription: import_subscription_attributes,
+        remote_request: import_request_attributes,
+        auto_allow: true,
+        skip_remote: true
+      )
+      @queenbee_import_account.id.to_s
+    end
+
+    def rollback_external_account
+      @queenbee_import_account&.cancel
+    end
+
+    def importing_owner_name
+      identity.users.active.first&.name || identity.email_address
+    end
+
+    def import_subscription_attributes
+      subscription = FreeV1Subscription
+      { name: subscription.to_param, price: subscription.price }
+    end
+
+    def import_request_attributes
+      {
+        remote_address: Current.ip_address,
+        user_agent: Current.user_agent,
+        referrer: Current.referrer
+      }
+    end
+end
