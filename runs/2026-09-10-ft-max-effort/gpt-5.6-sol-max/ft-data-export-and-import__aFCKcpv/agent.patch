+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  test "completed export expires and is purged after one day" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:kevin), kind: :cards)
+    export.generate_now
+    assert export.reload.downloadable?
+    blob_id = export.archive.blob.id
+
+    travel 1.day + 1.second do
+      export.expire
+    end
+
+    assert_not export.reload.archive.attached?
+    assert_not ActiveStorage::Blob.exists?(blob_id)
+    assert_not export.downloadable?
+  end
+
+  test "non-admin cannot create an account export" do
+    export = Export.new(account: accounts(:"37s"), user: users(:david), kind: :account)
+
+    assert_not export.valid?
+    assert_includes export.errors[:user], "must be an admin to export the account"
+  end
+end
