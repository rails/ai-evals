+require "test_helper"
+
+class Card::ExportTest < ActiveSupport::TestCase
+  test "exports card and comment attachments with matching JSON paths" do
+    account = accounts(:"37s")
+    user = users(:kevin)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    Current.set(account: account, user: user, identity: user.identity) do
+      card.image.attach(io: StringIO.new("picture"), filename: "picture.png", content_type: "image/png")
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("report"), filename: "report.txt", content_type: "text/plain"
+      )
+      comment.update!(body: ActionText::Content.new("See report").append_attachables(blob))
+    end
+
+    export = Export.create!(account: account, user: user, kind: :cards)
+    export.generate_now
+    export.reload
+
+    ZipFile.open(export.archive) do |zip|
+      path = zip.glob("cards/#{card.number}-*.json").sole
+      document = JSON.parse(zip.read(path))
+      comment_document = document.fetch("comments").find { |item| item["id"] == comment.id }
+      attachment_paths = document.fetch("attachments").pluck("path") + comment_document.fetch("attachments").pluck("path")
+
+      assert_equal 2, attachment_paths.size
+      assert attachment_paths.all? { |attachment_path| zip.exists?(attachment_path) }
+      assert_equal "picture", zip.read(attachment_paths.find { |attachment_path| attachment_path.end_with?("picture.png") })
+      assert_equal "report", zip.read(attachment_paths.find { |attachment_path| attachment_path.end_with?("report.txt") })
+    end
+  end
+end
