diff --git a/app/views/account/imports/new.html.erb b/app/views/account/imports/new.html.erb
new file mode 100644
index 0000000..70dd7e4
--- /dev/null
+++ b/app/views/account/imports/new.html.erb
@@ -0,0 +1,23 @@
+<% @page_title = "Import a Fizzy account" %>
+
+<section class="panel panel--centered flex flex-column gap">
+  <header>
+    <h1 class="txt-x-large font-weight-black margin-none">Import an account</h1>
+    <p>Choose a Fizzy account export ZIP. We’ll create a new account with its boards, cards, comments, files, and people.</p>
+  </header>
+
+  <%= form_with model: @account_import, url: account_imports_path, class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <label class="input input--file">
+      <span class="font-weight-bold">Fizzy account file</span>
+      <%= form.file_field :archive, accept: ".zip,application/zip", required: true, direct_upload: true, class: "input", data: { direct_upload_url: account_import_direct_uploads_path } %>
+    </label>
+
+    <% if @account_import.errors.any? %>
+      <div class="txt-negative txt-small"><%= @account_import.errors.full_messages.to_sentence %></div>
+    <% end %>
+
+    <button type="submit" class="btn btn--reversed center">Import account</button>
+  <% end %>
+
+  <p class="txt-small txt-tinted margin-none">The import runs in the background. We’ll email you when it finishes, or explain why it couldn’t be completed. Failed imports add nothing to your accounts.</p>
+</section>
