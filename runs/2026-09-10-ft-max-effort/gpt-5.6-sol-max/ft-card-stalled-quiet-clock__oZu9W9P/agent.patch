diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..bd4deca
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+    @card.comments.delete_all
+    @card.update!(last_active_at: Time.current)
+  end
+
+  test "three comments from two people within a third of the board auto-close period cause a burst" do
+    freeze_time
+    @card.board.auto_postpone_period = 30.days
+
+    create_comment(users(:david), at: 10.days.ago)
+    create_comment(users(:david), at: 5.days.ago)
+    create_comment(users(:kevin), at: Time.current)
+
+    assert_predicate @card.reload, :burst?
+  end
+
+  test "comments use the board auto-close period" do
+    freeze_time
+    @card.board.auto_postpone_period = 3.days
+
+    create_comment(users(:david), at: 2.days.ago)
+    create_comment(users(:david), at: 12.hours.ago)
+    create_comment(users(:kevin), at: Time.current)
+
+    assert_not_predicate @card.reload, :burst?
+  end
+
+  test "three comments from one person do not cause a burst" do
+    freeze_time
+
+    3.times { create_comment(users(:david)) }
+
+    assert_not_predicate @card.reload, :burst?
+  end
+
+  test "system comments do not count toward a burst" do
+    freeze_time
+
+    create_comment(users(:david))
+    create_comment(users(:kevin))
+    create_comment(users(:system))
+
+    assert_not_predicate @card.reload, :burst?
+  end
+
+  test "assignment causes a burst" do
+    freeze_time
+
+    @card.toggle_assignment users(:kevin)
+
+    assert_predicate @card.reload, :burst?
+  end
+
+  test "reopening causes a burst" do
+    freeze_time
+    @card.close
+
+    @card.reopen
+
+    assert_predicate @card.reload, :burst?
+  end
+
+  test "an inactive card without a burst is not stalled" do
+    @card.update!(last_active_at: 2.weeks.ago)
+
+    assert_not_predicate @card, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a burst card stalls after two weeks without activity" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks
+
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a burst card is not stalled before two weeks" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks - 1.second
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity restarts the stall clock" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+
+    @card.track_event :triaged
+
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 2.weeks
+
+    assert_predicate @card.reload, :stalled?
+  end
+
+  test "closed and postponed cards are not stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    @card.close
+    travel 2.weeks
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    travel 2.weeks
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  private
+    def create_comment(creator, at: Time.current)
+      travel_to(at) { @card.comments.create!(creator:, body: "A comment") }
+    end
+end
