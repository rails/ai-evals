diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..a6a16ef
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,47 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  COMMENTS_FOR_BURST = 3
+  PEOPLE_FOR_BURST = 2
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def burst?
+    last_burst_at.present?
+  end
+
+  def stalled?
+    active? && stalled_by_inactivity?
+  end
+
+  def cache_version
+    "#{super}-stalled-#{stalled_by_inactivity?}"
+  end
+
+  def burst
+    now = Time.current
+    update!(last_burst_at: now, last_active_at: now)
+  end
+
+  def detect_comment_burst(comment)
+    unless comment.creator.system?
+      recent_comments = comments.by_user.where(created_at: comment_burst_window_ending_at(comment.created_at))
+
+      if recent_comments.count >= COMMENTS_FOR_BURST && recent_comments.distinct.count(:creator_id) >= PEOPLE_FOR_BURST
+        burst
+      end
+    end
+  end
+
+  private
+    def stalled_by_inactivity?
+      burst? && last_active_at.present? && last_active_at <= STALL_PERIOD.ago
+    end
+
+    def comment_burst_window_ending_at(time)
+      (time - auto_postpone_period.fdiv(3))..time
+    end
+end
