diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..256be80
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "  👍  ", creator_id: users(:jz).id } }, as: :turbo_stream
+    end
+
+    assert_response :success
+
+    reaction = @comment.reactions.reload.last
+    assert_equal "👍", reaction.content
+    assert_equal users(:kevin), reaction.creator
+    assert_select %(turbo-stream[action="append"][target="#{dom_id(@comment, :reactions)}"])
+    assert_select "##{dom_id(reaction)}", text: /👍/
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { content: "Ship it" }, as: :json
+    end
+
+    reaction = @comment.reactions.reload.last
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(@comment.card, @comment, reaction, format: :json), response.headers["Location"]
+    assert_equal reaction.id, response.parsed_body["id"]
+    assert_equal "Ship it", response.parsed_body["content"]
+    assert_equal users(:kevin).id, response.parsed_body.dig("creator", "id")
+  end
+
+  test "rejects blank and overlong content" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: " " } }, as: :turbo_stream
+    end
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "12345678901234567" } }, as: :turbo_stream
+    end
+    assert_response :unprocessable_entity
+  end
+
+  test "show as JSON" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Nice!")
+
+    get card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, response.parsed_body["id"]
+    assert_equal "Nice!", response.parsed_body["content"]
+    assert_equal users(:jz).id, response.parsed_body.dig("creator", "id")
+  end
+
+  test "destroy" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "👍")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select %(turbo-stream[action="remove"][target="#{dom_id(reaction)}"])
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "👍")
+
+    delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "cannot destroy another person's reaction" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "👍")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot destroy a reaction through another comment" do
+    other_comment = comments(:layout_overflowing_david)
