diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..c453a6e
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    Current.user = users(:kevin)
+  end
+
+  test "defaults creator and account" do
+    reaction = @comment.reactions.create!(content: "Looks good")
+
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "normalizes content" do
+    reaction = @comment.reactions.create!(content: "  👍  ")
+
+    assert_equal "👍", reaction.content
+  end
+
+  test "requires content of at most 16 characters" do
+    assert_predicate @comment.reactions.build(content: "1234567890123456"), :valid?
+
+    blank_reaction = @comment.reactions.build(content: "   ")
+    long_reaction = @comment.reactions.build(content: "12345678901234567")
+
+    assert_not blank_reaction.valid?
+    assert_not long_reaction.valid?
+    assert_includes blank_reaction.errors[:content], "can't be blank"
+    assert_includes long_reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "recognizes emoji-only content" do
+    assert @comment.reactions.build(content: "👨‍👩‍👧‍👦").emoji_only?
+    assert_not @comment.reactions.build(content: "Nice 👍").emoji_only?
+    assert_not @comment.reactions.build(content: "123").emoji_only?
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "broadcasts creation and removal to the card" do
+    clear_enqueued_jobs
+
+    messages = capture_broadcasts(@comment.card.to_gid_param) do
+      @reaction = @comment.reactions.create!(content: "🚀")
+      perform_enqueued_jobs
+    end
+
+    creation = messages.find { it.include?(%(action="append")) && it.include?(dom_id(@comment, :reactions)) }
+    assert creation
+    assert_includes creation, "🚀"
+    assert_includes creation, users(:kevin).name
+
+    messages = capture_broadcasts(@comment.card.to_gid_param) do
+      @reaction.destroy!
+    end
+
+    removal = messages.find { it.include?(%(action="remove")) && it.include?(dom_id(@reaction)) }
+    assert removal
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..91943eb
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,63 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  test "react to a comment and remove the reaction" do
+    sign_in_as(users(:kevin))
+    comment = comments(:logo_agreement_jz)
+    visit card_url(comment.card)
+
+    within "##{dom_id(comment)}" do
+      click_on "Add a reaction"
+      assert_selector "input.reaction__input"
+      fill_in "Reaction", with: "Never mind"
+      click_on "Cancel"
+      assert_no_selector "input.reaction__input"
+      assert_button "Add a reaction"
+
+      click_on "Add a reaction"
+      assert_field "Reaction", with: ""
+      fill_in "Reaction", with: "🚀"
+      click_on "Add this reaction"
+
+      assert_selector reaction_selector_for(users(:kevin)), text: /🚀/
+      assert_no_selector "input.reaction__input"
+      assert_button "Add a reaction"
+
+      find(reaction_selector_for(users(:kevin)), text: /🚀/).click
+      assert_selector "button.reaction__delete", visible: true
+      find("button.reaction__delete").click
+      assert_no_selector reaction_selector_for(users(:kevin)), text: /🚀/
+    end
+  end
+
+  test "a reaction from another person arrives live" do
+    sign_in_as(users(:kevin))
+    comment = comments(:logo_agreement_jz)
+    visit card_url(comment.card)
+    wait_for_cable_subscriptions
+
+    Current.user = users(:david)
+    comment.reactions.create!(content: "Live!")
+    perform_enqueued_jobs
+
+    within "##{dom_id(comment)}" do
+      reaction = find(reaction_selector_for(users(:david)), text: /Live!/, wait: 5)
+      reaction.click
+
+      within reaction do
+        assert_no_selector "button.reaction__delete", visible: true
+      end
+      assert_not_includes reaction[:class].split, "expanded"
+    end
+  end
+
+  private
+    def reaction_selector_for(user)
+      ".reaction[data-creator-id='#{user.id}']"
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
