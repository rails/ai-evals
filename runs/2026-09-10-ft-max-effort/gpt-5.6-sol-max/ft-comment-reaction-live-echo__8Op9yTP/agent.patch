diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..202d207
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "delete" ]
+
+  connect() {
+    if (this.#createdByCurrentUser) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("aria-expanded", "false")
+    }
+  }
+
+  toggle(event) {
+    if (this.#createdByCurrentUser && !event.target.closest("form")) {
+      if (event.type === "keydown") event.preventDefault()
+
+      const expanded = this.element.classList.toggle("expanded")
+      this.element.setAttribute("aria-expanded", expanded.toString())
+      this.deleteTarget.form.hidden = !expanded
+    }
+  }
+
+  deleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  deletionFinished({ detail: { success } }) {
+    if (!success) this.element.classList.remove("reaction--deleting")
+  }
+
+  get #createdByCurrentUser() {
+    return this.element.dataset.creatorId === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..bc08eac
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "composer", "input", "trigger" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.composerTarget.hidden = false
+    this.composerTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.composerTarget.querySelector("form").reset()
+    this.#close()
+  }
+
+  submitted({ detail: { success } }) {
+    if (success) {
+      this.composerTarget.querySelector("form").reset()
+      this.#close()
+    }
+  }
+
+  #close() {
+    this.composerTarget.classList.remove("expanded", "reaction")
+    this.composerTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+}
