@@ -0,0 +1,44 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from filtered_activities
+  end
+
+  private
+    def filtered_activities
+      activities = Current.user.accessible_events
+        .preloaded_for_api
+        .where(action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      activities = activities.where(creator_id: creator_ids) if creator_ids.present?
+      activities = activities.where(board_id: board_ids) if board_ids.present?
+      activities
+    end
+
+    def creator_ids
+      activity_filter_params.fetch(:creator_ids, []).compact_blank
+    end
+
+    def board_ids
+      activity_filter_params.fetch(:board_ids, []).compact_blank
+    end
+
+    def activity_filter_params
+      @activity_filter_params ||= params.permit(creator_ids: [], board_ids: [])
+    end
+end
