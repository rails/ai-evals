diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..a4cba19
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,173 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index is available at the account activities JSON path" do
+    untenanted do
+      get "/#{accounts("37s").external_account_id}/activities.json"
+    end
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+  end
+
+  test "index as JSON returns the activity representation" do
+    card_event = create_event(
+      action: "card_title_changed",
+      eventable: cards(:logo),
+      particulars: { particulars: { old_title: "Old logo", new_title: cards(:logo).title } },
+      created_at: 2.minutes.from_now
+    )
+    comment_event = events(:layout_commented)
+    comment_event.update_columns(created_at: 1.minute.from_now)
+
+    get card_path(card_event.card), as: :json
+    card_json = response.parsed_body
+    get card_comment_path(comment_event.card, comment_event.eventable), as: :json
+    comment_json = response.parsed_body
+    get board_path(card_event.board), as: :json
+    board_json = response.parsed_body
+    get user_path(card_event.creator), as: :json
+    creator_json = response.parsed_body
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+
+    card_activity = activity_json_for(card_event)
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], card_activity.keys.sort
+    assert_equal card_event.id, card_activity["id"]
+    assert_equal card_event.action, card_activity["action"]
+    assert_equal card_event.created_at.utc.change(usec: card_event.created_at.usec / 1000 * 1000), Time.zone.parse(card_activity["created_at"])
+    assert_equal card_event.description_for(users(:kevin)).to_plain_text, card_activity["description"]
+    assert_equal "Card", card_activity["eventable_type"]
+    assert_equal card_url(card_event.card), card_activity["url"]
+    assert_equal card_json.except("steps"), card_activity["eventable"]
+    assert_equal board_json, card_activity["board"]
+    assert_equal creator_json, card_activity["creator"]
+
+    comment_activity = activity_json_for(comment_event)
+    assert_equal "Comment", comment_activity["eventable_type"]
+    assert_equal card_url(comment_event.card, anchor: dom_id(comment_event.eventable)), comment_activity["url"]
+    assert_equal comment_json, comment_activity["eventable"]
+  end
+
+  test "returns timeline actions except collection changes and includes title changes" do
+    title_event = create_event(action: "card_title_changed", particulars: { particulars: { old_title: "Before", new_title: "After" } })
+    collection_event = create_event(action: "card_collection_changed")
+    unrelated_event = create_event(action: "card_resumed")
+
+    get activities_path, as: :json
+
+    assert_response :success
+    ids = response.parsed_body.pluck("id")
+    assert_includes ids, title_event.id
+    assert_not_includes ids, collection_event.id
+    assert_not_includes ids, unrelated_event.id
+  end
+
+  test "returns event-specific particulars" do
+    assignment = create_event(action: "card_assigned", particulars: { assignee_ids: [ users(:jz).id ] })
+    board_change = create_event(action: "card_board_changed", particulars: { particulars: { old_board: "Old board", new_board: "New board" } })
+    title_change = create_event(action: "card_title_changed", particulars: { particulars: { old_title: "Old title", new_title: "New title" } })
+    triage = create_event(action: "card_triaged", particulars: { particulars: { column: "In progress" } })
+    other = create_event(action: "card_closed", particulars: { ignored: "value" })
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_json_for(assignment)["particulars"])
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activity_json_for(board_change)["particulars"])
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity_json_for(title_change)["particulars"])
+    assert_equal({ "column" => "In progress" }, activity_json_for(triage)["particulars"])
+    assert_equal({}, activity_json_for(other)["particulars"])
+  end
+
+  test "returns empty strings for missing board title and column particulars" do
+    board_change = create_event(action: "card_board_changed", particulars: {})
+    title_change = create_event(action: "card_title_changed", particulars: {})
+    triage = create_event(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity_json_for(board_change)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity_json_for(title_change)["particulars"])
+    assert_equal({ "column" => "" }, activity_json_for(triage)["particulars"])
+  end
+
+  test "filters by creator IDs and board IDs" do
+    private_event = create_private_event
+
+    get activities_path, params: { creator_ids: [ users(:david).id ] }, as: :json
+
+    assert_response :success
+    assert response.parsed_body.any?
+    assert_equal [ users(:david).id ], response.parsed_body.pluck("creator").pluck("id").uniq
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_equal [ private_event.id ], response.parsed_body.pluck("id")
+  end
+
+  test "returns only activity on boards accessible to the current user" do
+    private_event = create_private_event
+    logout_and_sign_in_as :david
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id, boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), private_event.id
+    assert_equal [ boards(:writebook).id ], response.parsed_body.pluck("board").pluck("id").uniq
+  end
+
+  test "returns newest activity first and paginates using API conventions" do
+    travel_to Time.utc(2030, 2, 1, 12)
+    created_events = 20.times.map do |index|
+      create_event(action: "card_published", created_at: Time.current + index.seconds)
+    end
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal 15, response.parsed_body.size
+    assert_equal created_events.reverse.first(15).pluck(:id), response.parsed_body.pluck("id")
+    assert_equal users(:kevin).accessible_events.where(action: activity_actions).count.to_s, response.headers["X-Total-Count"]
+    assert_match(/rel="next"/, response.headers["Link"])
+
+    first_page_ids = response.parsed_body.pluck("id")
+    next_page = URI.parse(response.headers["Link"].match(/<([^>]+)>/)[1]).request_uri
+    get next_page, as: :json
+
+    assert_response :success
+    assert_empty first_page_ids & response.parsed_body.pluck("id")
+  end
+
+  private
+    def create_event(action:, eventable: cards(:logo), board: eventable.board, creator: users(:kevin), particulars: {}, created_at: Time.current)
+      Event.create!(action:, eventable:, board:, creator:, particulars:, created_at:, account: board.account)
+    end
+
+    def create_private_event
+      card = boards(:private).cards.create!(title: "Private activity", creator: users(:kevin), status: :drafted)
+      card.update_column(:status, "published")
+      create_event(action: "card_published", eventable: card, board: boards(:private))
+    end
+
+    def activity_json_for(event)
+      response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+
+    def activity_actions
+      %w[
+        card_assigned card_unassigned card_published card_closed card_reopened
+        card_board_changed card_postponed card_auto_postponed card_triaged
+        card_sent_back_to_triage comment_created card_title_changed
+      ]
+    end
+end
