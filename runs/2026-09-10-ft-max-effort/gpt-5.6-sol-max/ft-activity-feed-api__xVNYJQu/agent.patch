diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..d20ab9a
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,17 @@
+event = activity
+
+json.(event, :id, :action, :eventable_type)
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text
+json.partial! "activities/particulars", event: event
+json.url polymorphic_url(event.eventable)
+
+json.eventable do
+  case event.eventable
+  when Card then json.partial! "cards/card", card: event.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+  end
+end
+
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
diff --git a/app/views/activities/_particulars.json.jbuilder b/app/views/activities/_particulars.json.jbuilder
new file mode 100644
index 0000000..10b7660
--- /dev/null
+++ b/app/views/activities/_particulars.json.jbuilder
@@ -0,0 +1,24 @@
+details = event.particulars.to_h.fetch("particulars", {}) || {}
+
+case event.action
+when "card_assigned", "card_unassigned"
+  json.particulars do
+    json.assignee_ids event.assignee_ids || []
+  end
+when "card_board_changed"
+  json.particulars do
+    json.old_board details["old_board"].to_s
+    json.new_board details["new_board"].to_s
+  end
+when "card_title_changed"
+  json.particulars do
+    json.old_title details["old_title"].to_s
+    json.new_title details["new_title"].to_s
+  end
+when "card_triaged"
+  json.particulars do
+    json.column details["column"].to_s
+  end
+else
+  json.particulars({})
+end
