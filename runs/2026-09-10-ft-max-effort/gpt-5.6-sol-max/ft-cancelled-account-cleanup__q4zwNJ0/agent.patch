diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..c076a80 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,26 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      joins(:cancellation)
+        .where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+        .find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    incinerate_storage
+    destroy!
+  end
+
+  private
+    def incinerate_storage
+      # Bypass detach callbacks so they do not create ledger entries for data being deleted.
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+      Storage::Entry.where(account_id: id).delete_all
+    end
 end
