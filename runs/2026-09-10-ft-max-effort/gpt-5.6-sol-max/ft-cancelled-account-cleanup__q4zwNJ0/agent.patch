diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..e399908
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently destroys accounts cancelled more than the grace period ago" do
+    freeze_time do
+      due_account = create_cancelled_account(name: "Due", cancelled_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.second)
+      due_owner = due_account.users.owner.first
+      due_user_id = due_owner.id
+      due_board = due_account.boards.create!(name: "Due board", creator: due_owner)
+      due_card = due_board.cards.create!(title: "Due card", creator: due_owner)
+      identity_id = due_owner.identity_id
+      attachment_id, blob_id = Current.with_account(due_account) do
+        due_card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+        [ due_card.image.attachment.id, due_card.image.blob.id ]
+      end
+
+      assert_difference -> { Account.count }, -1 do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert_not Account.exists?(due_account.id)
+      assert_not User.exists?(due_user_id)
+      assert_not Card.exists?(due_card.id)
+      assert_not ActiveStorage::Attachment.exists?(attachment_id)
+      assert_not ActiveStorage::Blob.exists?(blob_id)
+      assert_empty Storage::Entry.where(account_id: due_account.id)
+      assert Identity.exists?(identity_id)
+    end
+  end
+
+  test "keeps accounts cancelled at or after the grace period cutoff" do
+    freeze_time do
+      at_cutoff = create_cancelled_account(name: "At cutoff", cancelled_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+      recent = create_cancelled_account(name: "Recent", cancelled_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.second)
+      active = create_account(name: "Active")
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(at_cutoff.id)
+      assert Account.exists?(recent.id)
+      assert Account.exists?(active.id)
+    end
+  end
+
+  private
+    def create_cancelled_account(name:, cancelled_at:)
+      create_account(name: name).tap do |account|
+        Account::Cancellation.create!(account: account, initiated_by: account.users.owner.first, created_at: cancelled_at)
+      end
+    end
+
+    def create_account(name:)
+      Account.create_with_owner(
+        account: { name: name },
+        owner: { name: "Owner", identity: identities(:david) }
+      )
+    end
+end
