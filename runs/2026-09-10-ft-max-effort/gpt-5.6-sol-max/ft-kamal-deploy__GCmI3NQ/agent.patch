diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..5df3a6a
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,59 @@
+# Replace these values with the hostname and SMTP server for your Fizzy install.
+# The hostname must point to the server before the first deploy so Let's Encrypt
+# can issue a certificate.
+x-fizzy-host: &fizzy_host fizzy.example.com
+x-smtp-address: &smtp_address smtp.example.com
+
+service: fizzy
+image: fizzy
+
+# This single role runs the web server and Solid Queue in the same container.
+servers:
+  web:
+    - *fizzy_host
+
+# Kamal Proxy terminates TLS and automatically provisions a Let's Encrypt
+# certificate for the hostname.
+proxy:
+  ssl: true
+  host: *fizzy_host
+
+# A local registry is tunneled to the server over SSH during deployment, so no
+# third-party container registry is required.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    FIZZY_HOST: *fizzy_host
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: true
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    SMTP_ADDRESS: *smtp_address
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *fizzy_host
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# SQLite databases and uploaded files all live under /rails/storage. Docker
+# keeps this named volume when replacing the application container on deploy.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep fingerprinted assets from the old container available during deploys.
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse "bash"
+  logs: app logs -f
