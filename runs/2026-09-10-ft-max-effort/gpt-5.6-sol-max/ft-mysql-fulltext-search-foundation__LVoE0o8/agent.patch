diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
new file mode 100644
index 0000000..dd17046
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,16 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = Current.user.accessible_cards.published.matching(@query).reverse_chronologically
+      .includes(:board, :rich_text_description)
+
+    page_cards = set_page_and_extract_portion_from cards
+    @matching_comments_by_card_id = matching_comments_by_card_id(page_cards.load)
+  end
+
+  private
+    def matching_comments_by_card_id(cards)
+      Comment.where(account: Current.account, card_id: cards.map(&:id))
+        .matching(@query).chronologically.includes(:rich_text_body).group_by(&:card_id)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..8b113f9
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,42 @@
+module SearchesHelper
+  def highlighted_search_text(content, query)
+    text = search_text(content)
+
+    if query.present?
+      pattern = Regexp.new("(#{Regexp.escape(query)})", Regexp::IGNORECASE)
+      safe_join text.split(pattern).map.with_index { |part, index| index.odd? ? tag.mark(part) : part }
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def highlighted_search_excerpt(content, query, length: 240)
+    highlighted_search_text search_excerpt(content, query, length: length), query
+  end
+
+  def search_text_matches?(content, query)
+    search_text(content).downcase.include?(query.downcase)
+  end
+
+  private
+    def search_excerpt(content, query, length:)
+      text = search_text(content)
+      length = [ length, query.length ].max
+      match_start = text.downcase.index(query.downcase)
+
+      if match_start && text.length > length
+        excerpt_start = [ match_start - length / 3, 0 ].max
+        excerpt = text.slice(excerpt_start, length)
+        excerpt = "…#{excerpt}" if excerpt_start.positive?
+        excerpt = "#{excerpt}…" if excerpt_start + length < text.length
+        excerpt
+      else
+        text
+      end
+    end
+
+    def search_text(content)
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text.gsub(/\s+/, " ").strip
+    end
+end
