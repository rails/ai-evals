diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..007aa44
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,20 @@
+<article class="search-result panel" data-search-result data-card-number="<%= card.number %>">
+  <header class="flex align-center justify-space-between gap-half">
+    <h2 class="txt-medium">
+      <%= link_to highlighted_search_text(card.title, query), card_path(card) %>
+    </h2>
+    <span class="txt-small translucent"><%= card.board.name %></span>
+  </header>
+
+  <% if search_text_matches?(card.description, query) %>
+    <p class="search-result__excerpt margin-block-start-half"><%= highlighted_search_excerpt(card.description, query) %></p>
+  <% end %>
+
+  <% @matching_comments_by_card_id.fetch(card.id, []).each do |comment| %>
+    <% if search_text_matches?(comment.body, query) %>
+      <blockquote class="search-result__excerpt margin-block-start-half">
+        <%= highlighted_search_excerpt(comment.body, query) %>
+      </blockquote>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..4ecfbb3
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="search-results center-block margin-block-double">
+  <%= form_with url: search_path, method: :get, class: "search-results__form flex gap-half", data: { turbo_frame: "_top" } do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards…", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= form.button "Search", class: "btn btn--primary" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <div class="search-results__list margin-block-start txt-align-start">
+      <% if @page.records.any? %>
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "result", collection: @page.records, as: :card, locals: { query: @query } %>
+        <% end %>
+      <% else %>
+        <div class="blank-slate">No cards match “<%= @query %>”</div>
+      <% end %>
+    </div>
+  <% else %>
+    <div class="blank-slate">Search card titles, descriptions, and comments</div>
+  <% end %>
+</section>
