diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..58b80cb
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "finds published cards by title, description, and comment newest first" do
+    title_match = create_card title: "Find the AuroraToken in this title", created_at: 3.days.ago
+    description_match = create_card title: "Description result", description: "The auroratoken is in the description", created_at: 2.days.ago
+    comment_match = create_card title: "Comment result", created_at: 1.day.ago
+    comment_match.comments.create!(creator: users(:kevin), body: "A comment mentions AURORATOKEN")
+
+    get search_path, params: { q: "auroratoken" }
+
+    assert_response :success
+    assert_equal \
+      [ comment_match, description_match, title_match ].map { |card| card.number.to_s },
+      css_select("[data-search-result]").map { |result| result["data-card-number"] }
+
+    assert_select "a[href=?]", card_path(title_match) do
+      assert_select "mark", text: "AuroraToken"
+    end
+    assert_select "[data-search-result][data-card-number=?]", description_match.number.to_s do
+      assert_select "mark", text: "auroratoken"
+    end
+    assert_select "[data-search-result][data-card-number=?]", comment_match.number.to_s do
+      assert_select "mark", text: "AURORATOKEN"
+    end
+  end
+
+  test "only includes cards on boards the user can currently access" do
+    accessible = create_card title: "Visible NebulaToken"
+    inaccessible_board = Board.create!(name: "Inaccessible", all_access: false, account: Current.account, creator: users(:jz))
+    inaccessible = create_card title: "Hidden NebulaToken", board: inaccessible_board, creator: users(:jz)
+
+    get search_path, params: { q: "nebulatoken" }
+
+    assert_select "a[href=?]", card_path(accessible)
+    assert_select "a[href=?]", card_path(inaccessible), count: 0
+  end
+
+  test "never includes drafts or comments on drafts" do
+    draft = create_card title: "Draft CometToken", status: :drafted
+    draft_comment = draft.comments.build(account: Current.account, creator: users(:kevin))
+    draft_comment.save!(validate: false)
+    ActionText::RichText.create!(account: Current.account, record: draft_comment, name: "body", body: "CometToken in a draft comment")
+
+    get search_path, params: { q: "comettoken" }
+
+    assert_select "a[href=?]", card_path(draft), count: 0
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "a blank query returns no cards" do
+    create_card title: "A card"
+
+    get search_path, params: { q: "  " }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "treats SQL wildcard and escape characters literally" do
+    literal_match = create_card title: "Take 50%_off! this price"
+    create_card title: "Take 50XXoff!! this price"
+
+    get search_path, params: { q: "50%_off!" }
+
+    assert_equal [ literal_match.number.to_s ], css_select("[data-search-result]").map { |result| result["data-card-number"] }
+    assert_select "mark", text: "50%_off!"
+  end
+
+  test "returns a card once when several comments match" do
+    card = create_card title: "Several comments"
+    2.times { card.comments.create!(creator: users(:kevin), body: "Repeated PulsarToken") }
+
+    get search_path, params: { q: "pulsartoken" }
+
+    assert_select "[data-search-result][data-card-number=?]", card.number.to_s, count: 1 do
+      assert_select "mark", text: "PulsarToken", count: 2
+    end
+  end
+
+  test "escapes user content while highlighting it" do
+    card = create_card title: '<script>alert("unsafe")</script> SafeToken'
+
+    get search_path, params: { q: "safetoken" }
+
+    assert_select "[data-search-result][data-card-number=?]", card.number.to_s do
+      assert_select "a[href=?] mark", card_path(card), text: "SafeToken"
+      assert_select "script", count: 0
+      assert_includes response.body, "&lt;script&gt;"
+    end
+  end
+
+  test "reflects access revocation immediately" do
+    card = create_card title: "Revoked OrbitToken", board: boards(:private)
+
+    get search_path, params: { q: "orbittoken" }
+    assert_select "a[href=?]", card_path(card)
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "orbittoken" }
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "renders the search form without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?][method=get]", search_path
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "links to search from the menu" do
+    get my_menu_path
+
+    assert_response :success
+    assert_select "a[href=?] span", search_path, text: "Search cards"
+  end
+
+  private
+    def create_card(title:, description: nil, created_at: Time.current, status: :published, board: boards(:writebook), creator: users(:kevin))
+      board.cards.create!(
+        account: board.account,
+        creator: creator,
+        title: title,
+        description: description,
+        status: status,
+        created_at: created_at,
+        last_active_at: created_at)
+    end
+end
