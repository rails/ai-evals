+    <strong><%= account.plan_name %></strong>
+    <% if account.comped? %>
+      <span class="txt-small">(comped)</span>
+    <% end %>
+  </p>
+
+  <% if account.billing_plan.paid? %>
+    <p class="txt-small margin-none">
+      Unlimited cards and <%= number_to_human_size(account.storage_limit) %> storage.
+    </p>
+    <%= button_to "Manage billing", saas.stripe_portal_path, class: "btn settings-subscription__button" %>
+  <% else %>
+    <p class="txt-small margin-none">
+      1,000 cards and 1 GB storage included.
+    </p>
+
+    <div class="flex flex-column gap-half">
+      <div>
+        <strong>Unlimited</strong> — $20/month<br>
