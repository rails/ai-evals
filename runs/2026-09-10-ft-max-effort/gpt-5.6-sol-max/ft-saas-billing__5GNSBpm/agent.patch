diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..286724b
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,52 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Accounts", saas.admin_accounts_path(script_name: nil), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <h2 class="divider">Account</h2>
+      <dl>
+        <dt class="txt-small txt-ink-medium">ID</dt>
+        <dd class="margin-none"><%= @account.external_account_id %></dd>
+        <dt class="txt-small txt-ink-medium margin-block-start-half">Plan</dt>
+        <dd class="margin-none"><%= @account.plan_name %><%= " (comped)" if @account.comped? %></dd>
+        <dt class="txt-small txt-ink-medium margin-block-start-half">Card count</dt>
+        <dd class="margin-none"><%= number_with_delimiter(@account.cards_count) %></dd>
+        <dt class="txt-small txt-ink-medium margin-block-start-half">Bytes used</dt>
+        <dd class="margin-none"><%= number_with_delimiter(@account.bytes_used) %></dd>
+      </dl>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account, script_name: nil),
+              class: "btn", disabled: @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account, script_name: nil),
+              method: :delete, class: "btn", disabled: !@account.comped? %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <h2 class="divider">Usage override</h2>
+
+      <%= form_with url: saas.admin_account_overridden_limit_path(@account, script_name: nil), scope: :account_overridden_limit,
+            class: "flex flex-column gap-half" do |form| %>
+        <%= form.label :card_count, "Card count", class: "txt-small font-weight-bold" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+
+        <%= form.label :bytes_used, "Bytes used", class: "txt-small font-weight-bold" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+
+        <%= form.submit "Override", class: "btn" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account, script_name: nil), method: :delete, class: "btn" %>
+    </section>
+  </div>
+</section>
