index 0000000..6b05ba5
--- /dev/null
+++ b/app/jobs/storage/refresh_stale_job.rb
@@ -0,0 +1,23 @@
+class Storage::RefreshStaleJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  limits_concurrency key: "storage_usage_sweeper", duration: 1.hour
+
+  def perform
+    step :boards do |step|
+      Board.awaiting_storage_usage_refresh.find_each(start: step.cursor) do |board|
+        Storage::RefreshJob.perform_later(board)
+        step.advance! from: board.id
+      end
+    end
+
+    step :accounts do |step|
+      Account.awaiting_storage_usage_refresh.find_each(start: step.cursor) do |account|
+        Storage::RefreshJob.perform_later(account)
+        step.advance! from: account.id
+      end
+    end
+  end
+end
