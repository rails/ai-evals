index 0000000..55f44e2
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,57 @@
+class Storage::Usage
+  def initialize(owner)
+    @owner = owner
+  end
+
+  # Selecting blobs through an IN subquery counts reused files once.
+  def bytes
+    ActiveStorage::Blob.where(id: counted_attachments.select(:blob_id)).sum(:byte_size)
+  end
+
+  private
+    attr_reader :owner
+
+    def counted_attachments
+      card_images.or(rich_text_embeds)
+    end
+
+    def card_images
+      ActiveStorage::Attachment.where(record_type: "Card", record_id: cards.select(:id), name: "image")
+    end
+
+    def rich_text_embeds
+      ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id), name: "embeds")
+    end
+
+    def rich_texts
+      board_descriptions.or(card_descriptions).or(comment_bodies)
+    end
+
+    def board_descriptions
+      ActionText::RichText.where(record_type: "Board", record_id: boards.select(:id), name: "public_description")
+    end
+
+    def card_descriptions
+      ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description")
+    end
+
+    def comment_bodies
+      ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id), name: "body")
+    end
+
+    def comments
+      Comment.where(card_id: cards.select(:id))
+    end
+
+    def cards
+      @cards ||= Card.where(board_id: boards.select(:id))
+    end
+
+    def boards
+      @boards ||= if owner.is_a?(Account)
+        Board.where(account_id: owner.id)
+      else
+        Board.where(id: owner.id)
+      end
+    end
+end
