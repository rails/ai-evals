+
+  test "refreshes account usage when a board is destroyed" do
+    account = accounts("37s")
+    board = account.boards.create!(name: "Temporary", creator: users(:david), all_access: true)
+    card = board.cards.create!(title: "Temporary card", creator: users(:david), status: :published)
+
+    card.image.attach(upload("temporary image", "temporary.bin"))
+    refresh_storage_usage
+    assert_equal "temporary image".bytesize, account.reload.bytes_used
+
+    board.destroy!
+    refresh_storage_usage
+
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "coalesces multiple attachment changes into one scheduled refresh" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    blobs = 3.times.map { |index| upload_blob("file #{index}", "file-#{index}.bin") }
+
+    assert_enqueued_jobs 1, only: Storage::RefreshJob do
+      card.description.body = ActionText::Content.new("").append_attachables(blobs)
+      card.description.save!
+    end
+
+    assert_equal [ 3, true ], Board.where(id: board.id)
+      .pick(:storage_usage_version, :storage_usage_refresh_scheduled)
+  end
+
+  test "does not let an obsolete calculation overwrite a newer generation" do
+    board = boards(:writebook)
+    board.update_columns(storage_usage_version: 1, storage_usage_calculated_version: 0, bytes_used: 0)
+
+    board.define_singleton_method(:calculate_storage_bytes) do
+      self.class.update_counters(id, storage_usage_version: 1)
+      123
+    end
+
+    board.refresh_storage_usage_now
+
+    assert_equal [ 0, 2, 0 ], Board.where(id: board.id)
+      .pick(:bytes_used, :storage_usage_version, :storage_usage_calculated_version)
+  end
+
+  test "a stale value schedules one refresh per loaded record" do
+    board = boards(:writebook)
+    board.update_columns(storage_usage_version: 1, storage_usage_calculated_version: 0)
+
+    assert_enqueued_jobs 1, only: Storage::RefreshJob do
+      2.times { board.bytes_used }
+    end
+  end
+
+  test "the stale usage sweeper schedules boards and accounts" do
+    board = boards(:writebook)
+    account = accounts("37s")
+    board.update_columns(storage_usage_version: 1, storage_usage_calculated_version: 0, storage_usage_refresh_scheduled: true)
+    account.update_columns(storage_usage_version: 1, storage_usage_calculated_version: 0, storage_usage_refresh_scheduled: true)
+
+    assert_enqueued_with(job: Storage::RefreshJob, args: [ board ]) do
+      assert_enqueued_with(job: Storage::RefreshJob, args: [ account ]) do
+        Storage::RefreshStaleJob.perform_now
+      end
+    end
+  end
+
+  private
+    def refresh_storage_usage
+      while enqueued_jobs.any? { |job| job[:job] == Storage::RefreshJob }
+        perform_enqueued_jobs only: Storage::RefreshJob
+      end
+    end
+
+    def upload(contents, filename)
+      { io: StringIO.new(contents), filename: filename, content_type: "application/octet-stream" }
+    end
+
+    def upload_blob(contents, filename)
+      ActiveStorage::Blob.create_and_upload!(**upload(contents, filename))
+    end
+
+    def embed(record, attribute, blob)
+      rich_text = record.public_send(attribute)
+      rich_text.body = ActionText::Content.new(rich_text.body&.to_html.to_s).append_attachables(blob)
+      rich_text.save!
+    end
+end
