@@ -0,0 +1,55 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :refresh_storage_usage_after_create
+    before_destroy :remember_storage_usage_owner
+    after_destroy_commit :refresh_storage_usage_after_destroy
+  end
+
+  def delete
+    remember_storage_usage_owner
+    super.tap { refresh_remembered_storage_usage }
+  end
+
+  private
+    def refresh_storage_usage_after_create
+      storage_usage_owner&.storage_usage_changed_later
+    end
+
+    def remember_storage_usage_owner
+      @storage_usage_owner = storage_usage_owner
+    end
+
+    def refresh_storage_usage_after_destroy
+      refresh_remembered_storage_usage
+    end
+
+    def refresh_remembered_storage_usage
+      @storage_usage_owner&.storage_usage_changed_later
+    end
+
+    def storage_usage_owner
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        record.board
+      when [ "ActionText::RichText", "embeds" ]
+        rich_text_storage_usage_owner
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def rich_text_storage_usage_owner
+      rich_text = record
+
+      case [ rich_text.record_type, rich_text.name ]
+      when [ "Board", "public_description" ]
+        rich_text.record
+      when [ "Card", "description" ]
+        rich_text.record.board
+      when [ "Comment", "body" ]
+        rich_text.record.card.board
+      end
+    end
+end
diff --git a/app/models/storage/trackable.rb b/app/models/storage/trackable.rb
new file mode 100644
index 0000000..d2dbe6d
--- /dev/null
+++ b/app/models/storage/trackable.rb
@@ -0,0 +1,79 @@
+module Storage::Trackable
+  # Mutations advance a generation and share one durable scheduled marker. Refreshes only
+  # publish a total for the generation they read, so concurrent changes cannot be lost.
+
+  extend ActiveSupport::Concern
+
+  included do
+    scope :awaiting_storage_usage_refresh, -> { where(storage_usage_refresh_scheduled: true) }
+  end
+
+  def bytes_used
+    if storage_usage_stale? && !defined?(@storage_usage_refresh_enqueued)
+      Storage::RefreshJob.perform_later(self)
+      @storage_usage_refresh_enqueued = true
+    end
+
+    self[:bytes_used]
+  end
+
+  def storage_usage_stale?
+    storage_usage_calculated_version < storage_usage_version
+  end
+
+  def storage_usage_changed_later(force: false)
+    if persisted?
+      changed = false
+      scheduled = self.class.transaction do
+        changed = self.class.update_counters(id, storage_usage_version: 1) == 1
+        changed && schedule_storage_usage_refresh
+      end
+
+      Storage::RefreshJob.perform_later(self) if scheduled || (force && changed)
+    end
+  end
+
+  def refresh_storage_usage_later
+    Storage::RefreshJob.perform_later(self) if schedule_storage_usage_refresh
+  end
+
+  def refresh_storage_usage_now
+    version, calculated_version = self.class.where(id: id).pick(:storage_usage_version, :storage_usage_calculated_version)
+
+    if version && calculated_version < version
+      bytes = calculate_storage_bytes
+      table = self.class.arel_table
+      refreshed = self.class.where(id: id, storage_usage_version: version)
+        .where(table[:storage_usage_calculated_version].lt(version))
+        .update_all(bytes_used: bytes, storage_usage_calculated_version: version)
+
+      if refreshed == 1 && respond_to?(:storage_usage_refreshed, true)
+        storage_usage_refreshed
+      end
+    end
+
+    Storage::RefreshJob.perform_later(self) unless storage_usage_refresh_finished?
+  end
+
+  private
+    def schedule_storage_usage_refresh
+      self.class.where(id: id, storage_usage_refresh_scheduled: false)
+        .update_all(storage_usage_refresh_scheduled: true) == 1
+    end
+
+    def storage_usage_refresh_finished?
+      table = self.class.arel_table
+      cleared = self.class.where(id: id, storage_usage_refresh_scheduled: true)
+        .where(table[:storage_usage_version].eq(table[:storage_usage_calculated_version]))
+        .update_all(storage_usage_refresh_scheduled: false)
+
+      if cleared == 1
+        true
+      else
+        version, calculated_version, scheduled = self.class.where(id: id)
+          .pick(:storage_usage_version, :storage_usage_calculated_version, :storage_usage_refresh_scheduled)
+
+        version.nil? || (!scheduled && version == calculated_version)
+      end
+    end
+end
diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
