diff --git a/script/reproduce-storage-usage.rb b/script/reproduce-storage-usage.rb
new file mode 100755
index 0000000..8bad55b
--- /dev/null
+++ b/script/reproduce-storage-usage.rb
@@ -0,0 +1,51 @@
+#!/usr/bin/env ruby
+
+ENV["RAILS_ENV"] = "test"
+require_relative "../test/test_helper"
+
+class ReproduceStorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "account and board storage usage includes only card content" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    card.image.attach(upload("card image", "card-image.bin"))
+    embed(board, :public_description, upload_blob("board file", "board.txt"))
+    embed(card, :description, upload_blob("card description file", "card.txt"))
+    embed(comment, :body, upload_blob("comment attachment", "comment.txt"))
+
+    users(:david).avatar.attach(upload("not board storage", "avatar.bin"))
+
+    while enqueued_jobs.any? { |job| job[:job] == Storage::RefreshJob }
+      perform_enqueued_jobs only: Storage::RefreshJob
+    end
+
+    expected = "card image".bytesize + "board file".bytesize +
+      "card description file".bytesize + "comment attachment".bytesize
+
+    assert_equal expected, board.reload.bytes_used
+    assert_equal expected, account.reload.bytes_used
+    assert_equal 0, boards(:private).reload.bytes_used
+    assert_equal 0, accounts(:initech).reload.bytes_used
+  end
+
+  private
+    def upload(contents, filename)
+      { io: StringIO.new(contents), filename: filename, content_type: "application/octet-stream" }
+    end
+
+    def upload_blob(contents, filename)
+      ActiveStorage::Blob.create_and_upload!(**upload(contents, filename))
+    end
+
+    def embed(record, attribute, blob)
+      rich_text = record.public_send(attribute)
+      rich_text.body = ActionText::Content.new(rich_text.body&.to_html.to_s).append_attachables(blob)
+      rich_text.save!
+    end
+end
diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..0efd0a9
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,233 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "counts card images and files embedded in board descriptions, card descriptions, and comments" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+
+    card.image.attach(upload("card image", "card-image.bin"))
+    embed(board, :public_description, upload_blob("board file", "board.txt"))
+    embed(card, :description, upload_blob("card description file", "card.txt"))
+    embed(comment, :body, upload_blob("comment attachment", "comment.txt"))
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+
+    refresh_storage_usage
+
+    expected = "card image".bytesize + "board file".bytesize +
+      "card description file".bytesize + "comment attachment".bytesize
+
+    assert_equal expected, board.reload.bytes_used
+    assert_equal expected, account.reload.bytes_used
+  end
+
+  test "excludes files outside board and card content" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    import = Account::Import.create!(account: account, identity: identities(:david))
+
+    users(:david).avatar.attach(upload("avatar", "avatar.bin"))
+    import.file.attach(upload("account import", "import.bin"))
+
+    refresh_storage_usage
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "excludes generated variants for embedded images" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    embed(card, :description, blob)
+    refresh_storage_usage
+
+    assert ActiveStorage::VariantRecord.exists?
+    assert_operator ActiveStorage::Blob.where(account: card.account).sum(:byte_size), :>, blob.byte_size
+    assert_equal blob.byte_size, card.board.reload.bytes_used
+    assert_equal blob.byte_size, card.account.reload.bytes_used
+  end
+
+  test "attributes usage to the correct boards and account" do
+    account = accounts("37s")
+    first_board = boards(:writebook)
+    second_board = boards(:private)
+
+    cards(:logo).image.attach(upload("first", "first.bin"))
+    embed(second_board, :public_description, upload_blob("second board", "second.bin"))
+
+    refresh_storage_usage
+
+    assert_equal "first".bytesize, first_board.reload.bytes_used
+    assert_equal "second board".bytesize, second_board.reload.bytes_used
+    assert_equal "first".bytesize + "second board".bytesize, account.reload.bytes_used
+    assert_equal 0, accounts(:initech).reload.bytes_used
+  end
+
+  test "counts a blob only once when it is reused" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    blob = upload_blob("shared file", "shared.bin")
+
+    cards(:logo).image.attach(blob)
+    embed(board, :public_description, blob)
+
+    refresh_storage_usage
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+    assert_equal blob.byte_size, account.reload.bytes_used
+  end
+
+  test "refreshes usage when a card image is purged" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    card.image.attach(upload("image", "image.bin"))
+    refresh_storage_usage
+    assert_equal "image".bytesize, board.reload.bytes_used
+
+    card.image.purge_later
+    refresh_storage_usage
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "refreshes usage when an embedded file is removed" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    embed(card, :description, upload_blob("attachment", "attachment.bin"))
+    refresh_storage_usage
+    assert_equal "attachment".bytesize, board.reload.bytes_used
+
+    card.description = "No attachment"
+    card.save!
+    refresh_storage_usage
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "moves a card's usage between boards" do
+    account = accounts("37s")
+    old_board = boards(:writebook)
+    new_board = boards(:private)
+    card = cards(:logo)
+
+    card.image.attach(upload("moving image", "moving.bin"))
+    embed(comments(:logo_agreement_jz), :body, upload_blob("moving comment file", "comment.bin"))
+    refresh_storage_usage
+
+    expected = "moving image".bytesize + "moving comment file".bytesize
+    assert_equal expected, old_board.reload.bytes_used
+    assert_equal 0, new_board.reload.bytes_used
+
+    card.move_to(new_board)
+    refresh_storage_usage
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal expected, new_board.reload.bytes_used
+    assert_equal expected, account.reload.bytes_used
