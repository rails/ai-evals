@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(
+      name: "Delinquency test",
+      url: "https://example.com/webhook",
+      board: boards(:writebook)
+    )
+    @tracker = @webhook.delinquency_tracker
+    @event = events(:layout_commented)
+  end
+
+  test "is created with the webhook" do
+    assert_predicate @tracker, :persisted?
+    assert_equal @webhook.account, @tracker.account
+    assert_equal 0, @tracker.consecutive_failures_count
+  end
+
+  test "deactivates after ten consecutive failures spanning at least an hour" do
+    travel_to 2.hours.ago do
+      9.times { @tracker.track failed_delivery }
+    end
+
+    assert @webhook.reload.active?
+
+    @tracker.track failed_delivery
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+  end
+
+  test "does not deactivate after ten failures in less than an hour" do
+    10.times { @tracker.track failed_delivery }
+
+    assert @webhook.reload.active?
+  end
+
+  test "a successful delivery resets the failure streak" do
+    @tracker.track failed_delivery
+    @tracker.track successful_delivery
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "reactivating resets the failure streak" do
+    @tracker.track failed_delivery
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new(
+        webhook: @webhook,
+        event: @event,
+        state: :completed,
+        response: { code: 500 }
+      )
+    end
+
+    def successful_delivery
+      Webhook::Delivery.new(
+        webhook: @webhook,
+        event: @event,
+        state: :completed,
+        response: { code: 204 }
+      )
+    end
+end
diff --git a/test/models/webhook/delivery_lifecycle_test.rb b/test/models/webhook/delivery_lifecycle_test.rb
new file mode 100644
index 0000000..fc90da8
--- /dev/null
+++ b/test/models/webhook/delivery_lifecycle_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class Webhook::DeliveryLifecycleTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(
+      name: "Delivery test",
+      url: "https://receiver.example.com/hooks/fizzy",
+      board: boards(:writebook),
+      subscribed_actions: []
+    )
+    @event = events(:layout_commented)
+  end
+
+  test "enqueues a delivery job after creation" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    end
+  end
+
+  test "posts a signed JSON event and logs a successful response" do
+    delivery = create_delivery
+    sent_request = nil
+    request = stub_request(:post, @webhook.url).with { |sent| sent_request = sent }.to_return(
+      status: 204, headers: { "X-Receiver" => "ok" }
+    )
+
+    delivery.deliver_now
+
+    assert_requested request
+    payload = JSON.parse(sent_request.body)
+    assert_equal @event.id, payload["id"]
+    assert_equal @event.action, payload["action"]
+    assert_equal @event.eventable_id, payload.dig("eventable", "id")
+    assert_includes payload.dig("eventable", "url"), @webhook.account.slug
+    assert_equal "application/json", sent_request.headers["Content-Type"]
+    assert_equal "fizzy/1.0.0 Webhook", sent_request.headers["User-Agent"]
+    assert_equal @event.created_at.utc.iso8601(3), sent_request.headers["X-Webhook-Timestamp"]
+    assert_equal signature_for(sent_request.body), sent_request.headers["X-Webhook-Signature"]
+
+    assert delivery.reload.succeeded?
+    assert_equal 204, delivery.response[:code]
+    assert_equal [ "ok" ], delivery.response.dig(:headers, "x-receiver")
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "will not post a second time when the same delivery job runs again" do
+    delivery = create_delivery
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    delivery.deliver_now
+    delivery.deliver_now
+    delivery.reload.deliver_now
+
+    assert_requested request, times: 1
+  end
+
+  test "logs a non-success HTTP response as a failed completed delivery" do
+    delivery = create_delivery
+    stub_request(:post, @webhook.url).to_return(status: 503)
+
+    delivery.deliver_now
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 503, delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "logs an unreachable receiver without retrying" do
+    delivery = create_delivery
+    request = stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob
+  end
+
+  test "database permits only one delivery for a webhook and event" do
+    create_delivery
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    end
+  end
+
+  test "cleanup deletes deliveries older than one week and retains newer ones" do
+    old_delivery = create_delivery
+    recent_delivery = Webhook::Delivery.create!(webhook: @webhook, event: events(:layout_published))
+    old_delivery.update_columns(created_at: 1.week.ago - 1.second)
+    recent_delivery.update_columns(created_at: 1.week.ago + 1.second)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+
+  test "uses the integration-specific chat payload envelopes" do
+    {
+      "https://hooks.slack.com/services/T123/B456/secret" => [ "text" ],
+      "https://chat.example.com/rooms/123/456-secret/messages" => [ "message", "body" ],
+      "https://3.basecamp.com/123/integrations/secret/buckets/456/chats/789/lines" => [ "content" ]
+    }.each do |url, key_path|
+      @webhook.update_columns(url: url)
+      payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, @event).to_json)
+
+      assert payload.dig(*key_path).present?, "expected #{key_path.join('.')} in payload for #{url}"
+    end
+  end
+
+  private
+    def create_delivery
+      Webhook::Delivery.create!(webhook: @webhook, event: @event).tap { clear_enqueued_jobs }
+    end
+
+    def signature_for(body)
+      OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, body)
+    end
+end
