@@ -0,0 +1,57 @@
+class Webhook::Delivery::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def to_json(*)
+    if webhook.for_slack?
+      { text: rendered_event(:html).strip }.to_json
+    elsif webhook.for_campfire?
+      { message: { body: rendered_event(:html).strip } }.to_json
+    elsif webhook.for_basecamp?
+      { content: rendered_event(:html).strip }.to_json
+    else
+      rendered_event(:json)
+    end
+  end
+
+  private
+    def rendered_event(format)
+      renderer.render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: [ format ],
+        layout: false
+      )
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(renderer_environment)
+    end
+
+    def renderer_environment
+      {
+        http_host: http_host,
+        https: default_url_options[:protocol].to_s.start_with?("https") || Rails.application.config.force_ssl,
+        script_name: webhook.account.slug
+      }
+    end
+
+    def http_host
+      host = default_url_options[:host] || "localhost"
+
+      if port = default_url_options[:port]
+        "#{host}:#{port}"
+      else
+        host
+      end
+    end
+
+    def default_url_options
+      @default_url_options ||= Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+    end
+end
