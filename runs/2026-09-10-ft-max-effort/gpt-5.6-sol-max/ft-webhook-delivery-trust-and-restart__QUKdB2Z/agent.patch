+class EnforceExactlyOnceWebhookDeliveries < ActiveRecord::Migration[8.2]
+  class Delivery < ActiveRecord::Base
+    self.table_name = "webhook_deliveries"
+  end
+
+  class DelinquencyTracker < ActiveRecord::Base
+    self.table_name = "webhook_delinquency_trackers"
+  end
+
+  def up
+    remove_duplicate_deliveries
+    remove_duplicate_delinquency_trackers
+
+    add_index :webhook_deliveries, [ :webhook_id, :event_id ], unique: true
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id, unique: true
+    change_column_null :webhook_delinquency_trackers, :consecutive_failures_count, false, 0
+  end
+
+  def down
+    change_column_null :webhook_delinquency_trackers, :consecutive_failures_count, true
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id
+    remove_index :webhook_deliveries, [ :webhook_id, :event_id ]
+  end
+
+  private
+    def remove_duplicate_deliveries
+      Delivery.group(:webhook_id, :event_id).having("COUNT(*) > 1").pluck(:webhook_id, :event_id).each do |webhook_id, event_id|
+        duplicate_ids = Delivery.where(webhook_id: webhook_id, event_id: event_id).order(:created_at, :id).offset(1).pluck(:id)
+        Delivery.where(id: duplicate_ids).delete_all
+      end
+    end
+
+    def remove_duplicate_delinquency_trackers
+      DelinquencyTracker.group(:webhook_id).having("COUNT(*) > 1").pluck(:webhook_id).each do |webhook_id|
+        duplicate_ids = DelinquencyTracker.where(webhook_id: webhook_id).order(updated_at: :desc, id: :desc).offset(1).pluck(:id)
+        DelinquencyTracker.where(id: duplicate_ids).delete_all
+      end
+    end
+end
