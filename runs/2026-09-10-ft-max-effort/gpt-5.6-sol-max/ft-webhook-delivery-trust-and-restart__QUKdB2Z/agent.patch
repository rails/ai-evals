+require "test_helper"
+
+class Event::TriggerableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @eventable = comments(:layout_overflowing_david)
+    @creator = users(:david)
+    @subscribed_webhook = create_webhook("Subscribed", active: true, actions: [ "comment_created" ])
+    @unsubscribed_webhook = create_webhook("Unsubscribed", active: true, actions: [ "card_closed" ])
+    @inactive_webhook = create_webhook("Inactive", active: false, actions: [ "comment_created" ])
+  end
+
+  test "creates one asynchronous delivery for each active subscribed board webhook" do
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+        @event = create_event
+      end
+    end
+
+    assert @subscribed_webhook.deliveries.exists?(event: @event)
+    assert_not @unsubscribed_webhook.deliveries.exists?(event: @event)
+    assert_not @inactive_webhook.deliveries.exists?(event: @event)
+  end
+
+  test "does not create another delivery when triggering the same event again" do
+    event = create_event
+    clear_enqueued_jobs
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        event.trigger_webhooks
+      end
+    end
+  end
+
+  test "does not trigger a subscribed webhook on another board" do
+    other_webhook = Webhook.create!(
+      name: "Other board",
+      url: "https://other.example.com/webhook",
+      board: boards(:private),
+      subscribed_actions: [ "comment_created" ]
+    )
+
+    event = create_event
+
+    assert_not other_webhook.deliveries.exists?(event: event)
+  end
+
+  private
+    def create_webhook(name, active:, actions:)
+      Webhook.create!(
+        name: name,
+        url: "https://#{name.parameterize}.example.com/webhook",
+        board: @board,
+        active: active,
+        subscribed_actions: actions
+      )
+    end
+
+    def create_event
+      Event.create!(
+        board: @board,
+        creator: @creator,
+        eventable: @eventable,
+        action: "comment_created"
+      )
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
