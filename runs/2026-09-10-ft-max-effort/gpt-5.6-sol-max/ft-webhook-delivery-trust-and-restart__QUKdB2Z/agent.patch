   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  def terminal?
+    completed? || errored?
+  end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        if pending?
+          update!(state: :in_progress)
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def transmit
+      body = Payload.new(webhook, event).to_json
+      headers = request_headers(body)
+      update!(request: { headers: headers })
+
+      http_response = post(body, headers)
+      update!(
+        state: :completed,
+        response: { code: http_response.code.to_i, headers: http_response.to_hash }
+      )
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body),
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http.start { http.request(request) }
+    end
+
+    def record_error(_error)
+      update!(state: :errored, response: { error: "destination_unreachable" }) if in_progress?
+    end
+
+    def track_result
+      webhook.track(self)
+    end
 end
diff --git a/app/models/webhook/delivery/payload.rb b/app/models/webhook/delivery/payload.rb
