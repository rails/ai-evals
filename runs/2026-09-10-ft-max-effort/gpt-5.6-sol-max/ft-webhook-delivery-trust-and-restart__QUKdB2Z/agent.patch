--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,39 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAX_CONSECUTIVE_FAILURES = 10
+  MINIMUM_FAILURE_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track(delivery)
+    with_lock do
+      if delivery.succeeded?
+        reset_failure_streak
+      else
+        record_failure
+      end
+    end
+  end
+
+  def reset
+    with_lock { reset_failure_streak }
+  end
+
+  def delinquent?
+    consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES &&
+      first_failure_at.present? && first_failure_at <= MINIMUM_FAILURE_DURATION.ago
+  end
+
+  private
+    def reset_failure_streak
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+
+    def record_failure
+      self.first_failure_at ||= Time.current
+      self.consecutive_failures_count += 1
+      save!
+
+      webhook.deactivate if delinquent?
+    end
+end
