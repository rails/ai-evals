--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time tag sends an unformatted timestamp to the browser" do
+    time = Time.utc(2025, 9, 12, 17, 42, 30)
+
+    assert_select parse(local_time_tag(time, format: :time_or_date)),
+      "time[data-controller='local-time'][data-local-time-format-value='time-or-date'][datetime='2025-09-12T17:42:30Z']",
+      text: "2025-09-12T17:42:30Z"
+    assert_select parse(local_time_tag(time)),
+      "time > span.local-time-value[data-local-time-target='value']",
+      text: "2025-09-12T17:42:30Z"
+  end
+
+  test "local time ago tag delegates elapsed-time wording to the browser" do
+    time = Time.utc(2025, 9, 12, 17, 42, 30)
+
+    assert_select parse(local_time_ago_tag(time)),
+      "time[data-controller='local-time'][data-local-time-format-value='time-ago'][datetime='2025-09-12T17:42:30Z']",
+      text: "2025-09-12T17:42:30Z"
+  end
+
+  test "local time until tag delegates future wording to the browser" do
+    time = Time.utc(2025, 9, 15, 17, 42, 30)
+
+    assert_select parse(local_time_until_tag(time)),
+      "time[data-controller='local-time'][data-local-time-format-value='time-until'][datetime='2025-09-15T17:42:30Z']",
+      text: "2025-09-15T17:42:30Z"
+  end
+
+  test "local time markup is identical in every server timezone" do
+    time = Time.utc(2025, 9, 12, 17, 42, 30)
+
+    pacific_markup = Time.use_zone("Pacific Time (US & Canada)") { local_time_tag(time) }
+    tokyo_markup = Time.use_zone("Tokyo") { local_time_tag(time) }
+
+    assert_equal pacific_markup, tokyo_markup
+    assert_includes pacific_markup, "2025-09-12T17:42:30Z"
+  end
+
+  test "local time tag keeps other controllers and data attributes" do
+    time = Time.utc(2025, 9, 12, 17, 42, 30)
+    html = local_time_tag time, data: { controller: "tooltip", foo: "bar" }
+
+    assert_select parse(html), "time[data-controller='tooltip local-time'][data-foo='bar']"
+  end
+
+  test "local time tag preserves HTML options" do
+    time = Time.utc(2025, 9, 12, 17, 42, 30)
+
+    assert_select parse(local_time_tag(time, format: :date, class: "stamp", data: { bridge_title: "Done" })),
+      "time.stamp[data-bridge-title='Done'][data-local-time-format-value='date']"
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..b03f984
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,45 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "times are rendered in the browser timezone" do
+    local_time = first("time[data-controller~='local-time']", visible: :all)
+
+    assert_no_selector ".local-time-value", text: local_time[:datetime], exact_text: true
+
+    timestamp = "2025-09-12T20:42:00Z"
+    expected = local_clock_for(timestamp)
+
+    page.execute_script(<<~JS, timestamp)
+      const time = document.createElement("time")
+      time.id = "dynamically-added-local-time"
+      time.dateTime = arguments[0]
+      time.dataset.controller = "local-time"
+      time.dataset.localTimeFormatValue = "time"
+      time.innerHTML = `<span class="local-time-value" data-local-time-target="value">${arguments[0]}</span>`
+      document.body.append(time)
+    JS
+
+    assert_selector "#dynamically-added-local-time", text: expected, exact_text: true
+
+    updated_timestamp = "2025-09-13T03:15:00Z"
+    updated_expected = local_clock_for(updated_timestamp)
+    page.execute_script(<<~JS, updated_timestamp)
+      const time = document.querySelector("#dynamically-added-local-time")
+      time.dateTime = arguments[0]
+      time.querySelector(".local-time-value").textContent = arguments[0]
+    JS
+
+    assert_selector "#dynamically-added-local-time", text: updated_expected, exact_text: true
+  end
+
+  private
+    def local_clock_for(timestamp)
+      page.evaluate_script(<<~JS, timestamp)
+        new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(new Date(arguments[0]))
+      JS
+    end
+end
