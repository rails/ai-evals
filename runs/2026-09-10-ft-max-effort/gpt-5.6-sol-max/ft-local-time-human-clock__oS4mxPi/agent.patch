diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..25414c1
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,56 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+const DYNAMIC_FORMATS = [ "time-or-date", "time-ago", "time-until", "date", "long-date" ]
+const FORMAT_ATTRIBUTE = "data-local-time-format-value"
+
+export default class extends Controller {
+  static targets = [ "value" ]
+  static values = { format: { type: String, default: "time-or-date" } }
+
+  #observer
+  #timer
+
+  connect() {
+    this.update()
+    this.#startTimer()
+    this.#observeChanges()
+  }
+
+  disconnect() {
+    this.#observer?.disconnect()
+    clearInterval(this.#timer)
+  }
+
+  update() {
+    const date = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(date.valueOf()) && this.hasValueTarget) {
+      const formattedTime = formatLocalTime(date, this.formatValue)
+      if (this.valueTarget.textContent !== formattedTime) this.valueTarget.textContent = formattedTime
+    }
+  }
+
+  #startTimer() {
+    clearInterval(this.#timer)
+
+    if (DYNAMIC_FORMATS.includes(this.formatValue)) {
+      this.#timer = setInterval(this.update.bind(this), REFRESH_INTERVAL)
+    }
+  }
+
+  #observeChanges() {
+    this.#observer = new MutationObserver(mutations => {
+      if (mutations.some(mutation => mutation.attributeName === FORMAT_ATTRIBUTE)) this.#startTimer()
+      this.update()
+    })
+    this.#observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", FORMAT_ATTRIBUTE ],
+      childList: true,
+      characterData: true,
+      subtree: true
+    })
+  }
+}
