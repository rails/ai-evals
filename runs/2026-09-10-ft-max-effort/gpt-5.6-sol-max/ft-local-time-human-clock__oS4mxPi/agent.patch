diff --git a/script/audit_client_rendered_times b/script/audit_client_rendered_times
new file mode 100755
index 0000000..238edca
--- /dev/null
+++ b/script/audit_client_rendered_times
@@ -0,0 +1,21 @@
+#!/usr/bin/env ruby
+
+paths = Dir["app/views/**/*.html.erb", "app/views/**/*.turbo_stream.erb", "saas/app/views/**/*.html.erb"]
+  .reject { |path| path.include?("/mailers/") }
+  .concat([ "app/helpers/bridge_helper.rb", "app/models/user/day_timeline/column.rb" ])
+
+server_rendering = /(?:strftime|time_ago_in_words|distance_of_time_in_words)/
+violations = paths.filter_map do |path|
+  File.readlines(path).each_with_index.filter_map do |line, index|
+    # Fixed durations do not depend on the server clock or timezone.
+    next if line.include?("MagicLink::EXPIRATION_TIME")
+
+    "#{path}:#{index + 1}: #{line.strip}" if line.match?(server_rendering)
+  end
+end.flatten
+
+if violations.any?
+  warn "Browser views still render times on the server:"
+  warn violations.join("\n")
+  exit 1
+end
diff --git a/script/test_local_times b/script/test_local_times
new file mode 100755
index 0000000..f77254a
--- /dev/null
+++ b/script/test_local_times
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+set -eu
+
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+TMPDIR=$(mktemp -d)
+trap 'rm -rf "$TMPDIR"' EXIT
+
+cat > "$TMPDIR/test.html" <<HTML
+<!doctype html>
+<output id="result">module failed to load</output>
+<script type="module">
+  import { formatLocalTime, formatTimestamps, signedDifferenceInDays } from "file://$ROOT/app/javascript/helpers/date_helpers.js"
+
+  const now = new Date("2025-09-12T22:42:00Z")
+  const values = [
+    formatLocalTime(new Date("2025-09-12T20:42:00Z"), "time-or-date", now),
+    formatLocalTime(new Date("2025-09-12T06:00:00Z"), "time-or-date", now),
+    formatLocalTime(new Date("2025-09-07T20:42:00Z"), "time-or-date", now),
+    formatLocalTime(new Date("2025-08-30T20:42:00Z"), "time-or-date", now),
+    formatLocalTime(new Date("2025-09-13T15:00:00Z"), "time-until", now),
+    formatLocalTime(new Date("2025-09-15T15:00:00Z"), "time-until", now),
+    formatLocalTime(new Date("2025-09-12T20:42:00Z"), "time-ago", now),
+    formatLocalTime(new Date("2025-09-12T06:30:00Z"), "time-or-date", new Date("2025-09-12T07:30:00Z")),
+    signedDifferenceInDays(new Date("2025-11-01T19:00:00Z"), new Date("2025-11-03T20:00:00Z")),
+    formatTimestamps("Added 2025-09-12T20:42:00Z", "date", now)
+  ]
+
+  document.querySelector("#result").textContent = values.join("|")
+</script>
+HTML
+
+render_in_timezone() {
+  TZ="$1" timeout 30 chromium \
+    --headless --no-sandbox --disable-gpu --allow-file-access-from-files \
+    --dump-dom "file://$TMPDIR/test.html" 2>/dev/null |
+    sed -n 's/.*<output id="result">\([^<]*\)<\/output>.*/\1/p'
+}
+
+los_angeles=$(render_in_timezone America/Los_Angeles)
+tokyo=$(render_in_timezone Asia/Tokyo)
+
+expected_los_angeles='1:42 PM|yesterday|5 days ago|Aug 30|tomorrow|in 3 days|2 hours ago|yesterday|2|Added Sep 12'
+expected_tokyo='5:42 AM|yesterday|5 days ago|Aug 31|tomorrow|in 3 days|2 hours ago|3:30 PM|2|Added Sep 13'
+
+if [[ "$los_angeles" != "$expected_los_angeles" ]]; then
+  printf 'Los Angeles mismatch\nexpected: %s\nactual:   %s\n' "$expected_los_angeles" "$los_angeles" >&2
+  exit 1
+fi
+
+if [[ "$tokyo" != "$expected_tokyo" ]]; then
+  printf 'Tokyo mismatch\nexpected: %s\nactual:   %s\n' "$expected_tokyo" "$tokyo" >&2
+  exit 1
+fi
+
+printf 'Local-time browser checks passed in America/Los_Angeles and Asia/Tokyo.\n'
