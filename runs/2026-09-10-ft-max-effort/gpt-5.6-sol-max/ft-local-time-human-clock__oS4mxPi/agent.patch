+  def local_time_tag(time, format: :time_or_date, **options)
+    timestamp = time.in_time_zone.utc.iso8601
+    data = options.delete(:data)&.dup || {}
+    controllers = data.delete(:controller) || data.delete("controller")
+    data[:controller] = token_list(controllers, "local-time")
+    data[:local_time_format_value] = format.to_s.dasherize
+
+    tag.time datetime: timestamp, data: data, **options do
+      tag.span timestamp, class: "local-time-value", data: { local_time_target: "value" }
+    end
+  end
+
+  def local_time_ago_tag(time, **options)
+    local_time_tag time, format: :time_ago, **options
+  end
+
+  def local_time_until_tag(time, **options)
+    local_time_tag time, format: :time_until, **options
+  end
 end
