+      execute <<~SQL.squish
+        UPDATE accounts
+          SET bytes_used = COALESCE((
+            SELECT SUM(storage_usages.byte_size)
+              FROM storage_usages
+              WHERE storage_usages.account_id = accounts.id
+          ), 0)
+      SQL
+    end
+end
