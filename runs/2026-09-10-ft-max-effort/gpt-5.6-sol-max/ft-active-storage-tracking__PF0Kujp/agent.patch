+class Storage::Usage::ReconcileJob < ApplicationJob
+  limits_concurrency key: ->(attachment_id) { attachment_id }, duration: 5.minutes
+
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::RecordNotUnique, attempts: 10, wait: :polynomially_longer
+
+  def perform(attachment_id)
+    Storage::Usage.reconcile_now(attachment_id)
+  end
+end
