+          FROM active_storage_attachments attachments
+          INNER JOIN active_storage_blobs blobs ON blobs.id = attachments.blob_id
+          INNER JOIN action_text_rich_texts rich_texts ON attachments.record_type = 'ActionText::RichText' AND rich_texts.id = attachments.record_id
+          INNER JOIN boards ON rich_texts.record_type = 'Board' AND boards.id = rich_texts.record_id
+          WHERE attachments.name = 'embeds' AND rich_texts.name = 'public_description'
+        UNION ALL
+        SELECT attachments.id, boards.account_id, boards.id, cards.id, blobs.byte_size
+          FROM active_storage_attachments attachments
+          INNER JOIN active_storage_blobs blobs ON blobs.id = attachments.blob_id
+          INNER JOIN action_text_rich_texts rich_texts ON attachments.record_type = 'ActionText::RichText' AND rich_texts.id = attachments.record_id
+          INNER JOIN cards ON rich_texts.record_type = 'Card' AND cards.id = rich_texts.record_id
+          INNER JOIN boards ON boards.id = cards.board_id
+          WHERE attachments.name = 'embeds' AND rich_texts.name = 'description'
+        UNION ALL
+        SELECT attachments.id, boards.account_id, boards.id, cards.id, blobs.byte_size
+          FROM active_storage_attachments attachments
+          INNER JOIN active_storage_blobs blobs ON blobs.id = attachments.blob_id
+          INNER JOIN action_text_rich_texts rich_texts ON attachments.record_type = 'ActionText::RichText' AND rich_texts.id = attachments.record_id
+          INNER JOIN comments ON rich_texts.record_type = 'Comment' AND comments.id = rich_texts.record_id
+          INNER JOIN cards ON cards.id = comments.card_id
+          INNER JOIN boards ON boards.id = cards.board_id
+          WHERE attachments.name = 'embeds' AND rich_texts.name = 'body'
+      SQL
+    end
+
+    def reset_bytes_used
+      execute <<~SQL.squish
+        UPDATE boards
+          SET bytes_used = COALESCE((
