index 0000000..3ad0f62
--- /dev/null
+++ b/app/jobs/storage/usage/reconcile_card_job.rb
@@ -0,0 +1,18 @@
+class Storage::Usage::ReconcileCardJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  limits_concurrency key: ->(card_id) { card_id }, duration: 5.minutes
+
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::RecordNotUnique, attempts: 10, wait: :polynomially_longer
+
+  def perform(card_id)
+    step :usages do |step|
+      Storage::Usage.reconcile_card_now(card_id, start: step.cursor) do |usage|
+        step.advance! from: usage.id
+      end
+    end
+  end
+end
