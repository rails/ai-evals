diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..89d2f2d
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,198 @@
+# Each row mirrors one counted Active Storage attachment and shares its id.
+class Storage::Usage < ApplicationRecord
+  self.table_name = "storage_usages"
+
+  belongs_to :account
+  belongs_to :board
+  belongs_to :card, optional: true
+
+  class << self
+    def reconcile_later(attachment_id)
+      Storage::Usage::ReconcileJob.perform_later(attachment_id)
+    end
+
+    def reconcile_now(attachment_id)
+      transaction do
+        usage = lock.find_or_initialize_by(id: attachment_id)
+        usage.reconcile_with(attributes_for(attachment_id))
+      end
+    rescue ActiveRecord::RecordNotUnique
+      retry
+    end
+
+    def reconcile_card_later(card_id)
+      Storage::Usage::ReconcileCardJob.perform_later(card_id)
+    end
+
+    def reconcile_card_now(card_id, start: nil)
+      where(card_id: card_id).find_each(start: start) do |usage|
+        reconcile_now(usage.id)
+        yield usage if block_given?
+      end
+    end
+
+    def rebuild(account)
+      where(account_id: account.id).delete_all
+      account.boards.update_all(bytes_used: 0)
+      account.update_column(:bytes_used, 0)
+
+      rebuild_from card_images_for(account)
+      rebuild_from board_embeds_for(account)
+      rebuild_from card_embeds_for(account)
+      rebuild_from comment_embeds_for(account)
+
+      reset_counters(account)
+    end
+
+    private
+      def attributes_for(attachment_id)
+        if attachment = ActiveStorage::Attachment.lock.includes(:blob).find_by(id: attachment_id)
+          case [ attachment.record_type, attachment.name ]
+          when [ "Card", "image" ]
+            attributes_for_card(Card.lock.find_by(id: attachment.record_id), attachment.byte_size)
+          when [ "ActionText::RichText", "embeds" ]
+            attributes_for_rich_text(ActionText::RichText.lock.find_by(id: attachment.record_id), attachment.byte_size)
+          end
+        end
+      end
+
+      def attributes_for_rich_text(rich_text, byte_size)
+        if rich_text
+          case [ rich_text.record_type, rich_text.name ]
+          when [ "Board", "public_description" ]
+            attributes_for_board(Board.lock.find_by(id: rich_text.record_id), byte_size)
+          when [ "Card", "description" ]
+            attributes_for_card(Card.lock.find_by(id: rich_text.record_id), byte_size)
+          when [ "Comment", "body" ]
+            attributes_for_comment(Comment.lock.find_by(id: rich_text.record_id), byte_size)
+          end
+        end
+      end
+
+      def attributes_for_board(board, byte_size, card_id: nil)
+        if board
+          { account_id: board.account_id, board_id: board.id, card_id: card_id, byte_size: byte_size }
+        end
+      end
+
+      def attributes_for_card(card, byte_size)
+        if card
+          attributes_for_board(Board.lock.find_by(id: card.board_id), byte_size, card_id: card.id)
+        end
+      end
+
+      def attributes_for_comment(comment, byte_size)
+        if comment
+          attributes_for_card(Card.lock.find_by(id: comment.card_id), byte_size)
+        end
+      end
+
+      def rebuild_from(scope)
+        scope.find_in_batches do |attachments|
+          insert_all!(attachments.map { rebuild_attributes_for(it) })
+        end
+      end
+
+      def rebuild_attributes_for(attachment)
+        {
+          id: attachment.id,
+          account_id: deserialize_uuid(:account_id, attachment[:storage_account_id]),
+          board_id: deserialize_uuid(:board_id, attachment[:storage_board_id]),
+          card_id: deserialize_uuid(:card_id, attachment[:storage_card_id]),
+          byte_size: attachment[:storage_byte_size]
+        }
+      end
+
+      def deserialize_uuid(attribute, value)
+        type_for_attribute(attribute.to_s).deserialize(value)
+      end
+
+      def card_images_for(account)
+        ActiveStorage::Attachment
+          .joins("INNER JOIN active_storage_blobs storage_blobs ON storage_blobs.id = active_storage_attachments.blob_id")
+          .joins("INNER JOIN cards storage_cards ON storage_cards.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN boards storage_boards ON storage_boards.id = storage_cards.board_id")
+          .where(account_id: account.id, record_type: "Card", name: "image")
+          .select(rebuild_select("storage_cards.id"))
+      end
+
+      def board_embeds_for(account)
+        rich_text_embeds_for(account, record_type: "Board", name: "public_description")
+          .joins("INNER JOIN boards storage_boards ON storage_boards.id = storage_rich_texts.record_id")
+          .select(rebuild_select("NULL"))
+      end
+
+      def card_embeds_for(account)
+        rich_text_embeds_for(account, record_type: "Card", name: "description")
+          .joins("INNER JOIN cards storage_cards ON storage_cards.id = storage_rich_texts.record_id")
+          .joins("INNER JOIN boards storage_boards ON storage_boards.id = storage_cards.board_id")
+          .select(rebuild_select("storage_cards.id"))
+      end
+
+      def comment_embeds_for(account)
+        rich_text_embeds_for(account, record_type: "Comment", name: "body")
+          .joins("INNER JOIN comments storage_comments ON storage_comments.id = storage_rich_texts.record_id")
+          .joins("INNER JOIN cards storage_cards ON storage_cards.id = storage_comments.card_id")
+          .joins("INNER JOIN boards storage_boards ON storage_boards.id = storage_cards.board_id")
+          .select(rebuild_select("storage_cards.id"))
+      end
+
+      def rich_text_embeds_for(account, record_type:, name:)
+        ActiveStorage::Attachment
+          .joins("INNER JOIN active_storage_blobs storage_blobs ON storage_blobs.id = active_storage_attachments.blob_id")
+          .joins("INNER JOIN action_text_rich_texts storage_rich_texts ON storage_rich_texts.id = active_storage_attachments.record_id")
+          .where(account_id: account.id, record_type: "ActionText::RichText", name: "embeds")
+          .where(storage_rich_texts: { record_type: record_type, name: name })
+      end
+
+      def rebuild_select(card_id)
+        <<~SQL.squish
+          active_storage_attachments.id,
+          storage_boards.account_id AS storage_account_id,
+          storage_boards.id AS storage_board_id,
+          #{card_id} AS storage_card_id,
+          storage_blobs.byte_size AS storage_byte_size
+        SQL
+      end
+
+      def reset_counters(account)
+        account.boards.update_all <<~SQL.squish
+          bytes_used = COALESCE((
+            SELECT SUM(storage_usages.byte_size)
+              FROM storage_usages
+              WHERE storage_usages.board_id = boards.id
+          ), 0)
+        SQL
+
+        account.update_column(:bytes_used, where(account_id: account.id).sum(:byte_size))
+      end
+  end
+
+  def reconcile_with(attributes)
+    account_deltas = counter_deltas_for(:account_id, attributes)
+    board_deltas = counter_deltas_for(:board_id, attributes)
+
+    update_counters(Account, account_deltas)
+    update_counters(Board, board_deltas)
+
+    if attributes
+      update!(attributes)
+    elsif persisted?
+      destroy!
+    end
+  end
+
+  private
+    def counter_deltas_for(owner_id, attributes)
+      Hash.new(0).tap do |deltas|
+        deltas[public_send(owner_id)] -= byte_size if persisted?
+        deltas[attributes[owner_id]] += attributes[:byte_size] if attributes
+      end
+    end
+
+    def update_counters(model, deltas)
+      deltas.compact.sort_by { |id, _| id.to_s }.each do |id, delta|
+        model.update_counters(id, bytes_used: delta) unless delta.zero?
+      end
+    end
+end
diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..5216bdc 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -52,7 +52,35 @@ module ActiveStorageDirectUploadsControllerExtensions
   end
 end
 
+module ActiveStorageAttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :reconcile_storage_usage_later, on: %i[ create destroy ], if: :storage_usage_trackable?
+  end
+
+  # Active Storage uses delete, rather than destroy, when an attachment is detached or purged.
+  def delete
+    track_storage_usage = storage_usage_trackable?
+
+    super.tap do
+      reconcile_storage_usage_later if track_storage_usage
+    end
+  end
+
+  private
+    def storage_usage_trackable?
+      (record_type == "Card" && name == "image") ||
+        (record_type == "ActionText::RichText" && name == "embeds")
+    end
+
+    def reconcile_storage_usage_later
+      Storage::Usage.reconcile_later(id)
+    end
+end
+
 Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
+  ActiveStorage::Attachment.include ActiveStorageAttachmentStorageUsage
 end
