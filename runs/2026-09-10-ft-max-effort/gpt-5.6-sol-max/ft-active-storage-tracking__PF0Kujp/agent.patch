@@ -0,0 +1,214 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = @account.boards.create!(name: "Storage usage", creator: users(:david))
+    @card = @board.cards.create!(title: "Attachments", creator: users(:david), status: :published)
+  end
+
+  test "counts card images and files embedded in board descriptions, card descriptions, and comments" do
+    image = attach_image(@card, "image bytes")
+    board_embed = embed(@board, :public_description, "board embed")
+    card_embed = embed(@card, :description, "card description embed")
+    comment = @card.comments.create!(body: "Comment", creator: users(:david))
+    comment_embed = embed(comment, :body, "comment embed bytes")
+
+    users(:david).avatar.attach(
+      io: StringIO.new("avatar bytes are excluded"),
+      filename: "avatar.txt",
+      content_type: "text/plain"
+    )
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+
+    perform_enqueued_jobs
+    byte_sizes = [ image, board_embed, card_embed, comment_embed ].sum(&:byte_size)
+
+    assert_equal byte_sizes, @board.reload.bytes_used
+    assert_equal byte_sizes, @account.reload.bytes_used
+  end
+
+  test "aggregates usage across an account's boards" do
+    another_board = @account.boards.create!(name: "Another board", creator: users(:david))
+    another_card = another_board.cards.create!(title: "Another card", creator: users(:david))
+    first_image = attach_image(@card, "first image")
+    second_image = attach_image(another_card, "second image")
+
+    perform_enqueued_jobs
+
+    assert_equal first_image.byte_size, @board.reload.bytes_used
+    assert_equal second_image.byte_size, another_board.reload.bytes_used
+    assert_equal first_image.byte_size + second_image.byte_size, @account.reload.bytes_used
+  end
+
+  test "tracks accounts independently in background jobs" do
+    other_account = accounts("initech")
+    other_board = boards(:miltons_wish_list)
+    other_card = cards(:radio)
+    first_image = attach_image(@card, "37signals image")
+    other_image_size = nil
+
+    Current.with_account(other_account) do
+      second_image = attach_image(other_card, "Initech image")
+      other_image_size = second_image.byte_size
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal first_image.byte_size, @board.reload.bytes_used
+    assert_equal first_image.byte_size, @account.reload.bytes_used
+    assert_equal other_image_size, other_board.reload.bytes_used
+    assert_equal other_image_size, other_account.reload.bytes_used
+  end
+
+  test "tracks byte counts larger than a signed 32-bit integer" do
+    byte_size = 5.gigabytes
+    blob = ActiveStorage::Blob.create_before_direct_upload!(
+      filename: "large.bin",
+      byte_size: byte_size,
+      checksum: "checksum",
+      content_type: "text/plain"
+    )
+    blob.update!(metadata: blob.metadata.merge(identified: true))
+    @card.image.attach(blob)
+
+    perform_enqueued_jobs only: Storage::Usage::ReconcileJob
+
+    assert_equal byte_size, @board.reload.bytes_used
+    assert_equal byte_size, @account.reload.bytes_used
+  end
+
+  test "updates usage after replacing and removing attachments" do
+    attach_image(@card, "old")
+    embed(@card, :description, "old embed")
+    perform_enqueued_jobs
+
+    image = attach_image(@card, "a much larger replacement image")
+    @card.update!(description: "No attachments")
+    perform_enqueued_jobs
+    expected = image.byte_size
+
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+  end
+
+  test "moves a card's usage between boards" do
+    destination = @account.boards.create!(name: "Destination", creator: users(:david))
+
+    image = attach_image(@card, "image")
+    embed = embed(@card, :description, "embed")
+    comment = @card.comments.create!(body: "Comment", creator: users(:david))
+    comment_embed = embed(comment, :body, "comment embed")
+    perform_enqueued_jobs
+    expected = image.byte_size + embed.byte_size + comment_embed.byte_size
+
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal 0, destination.reload.bytes_used
+
+    @card.move_to(destination)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal expected, destination.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+  end
+
+  test "updates usage when attachments are purged or their records are destroyed" do
+    image = attach_image(@card, "image")
+    comment = @card.comments.create!(body: "Comment", creator: users(:david))
+    embed(comment, :body, "comment embed")
+    perform_enqueued_jobs
+
+    assert_equal image.byte_size + "comment embed".bytesize, @board.reload.bytes_used
+
+    @card.image.purge_later
+    comment.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "updates account usage when a board is destroyed" do
+    image = attach_image(@card, "image")
+    embed(@board, :public_description, "board embed")
+    perform_enqueued_jobs
+
+    assert_difference -> { Board.count }, -1 do
+      @board.destroy!
+    end
+    perform_enqueued_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+    assert_empty Storage::Usage.where(board_id: @board.id)
+  end
+
+  test "reconciliation is idempotent" do
+    image = attach_image(@card, "image")
+    attachment_id = @card.image.attachment.id
+    perform_enqueued_jobs
+
+    2.times { Storage::Usage::ReconcileJob.perform_now(attachment_id) }
+
+    assert_equal image.byte_size, @board.reload.bytes_used
+    assert_equal image.byte_size, @account.reload.bytes_used
+    assert_equal 1, Storage::Usage.where(id: attachment_id).count
+  end
+
+  test "rebuilds usage from existing attachments in bounded batches" do
+    image = attach_image(@card, "image")
+    board_embed = embed(@board, :public_description, "board embed")
+    card_embed = embed(@card, :description, "card embed")
+    comment = @card.comments.create!(body: "Comment", creator: users(:david))
+    comment_embed = embed(comment, :body, "comment embed")
+    users(:david).avatar.attach(io: StringIO.new("excluded"), filename: "avatar.txt", content_type: "text/plain")
+    clear_enqueued_jobs
+
+    Storage::Usage.delete_all
+    @account.update_column(:bytes_used, 123)
+    @board.update_column(:bytes_used, 123)
+
+    Storage::Usage.rebuild(@account)
+
+    expected = [ image, board_embed, card_embed, comment_embed ].sum(&:byte_size)
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+    assert_equal 4, Storage::Usage.where(account: @account, board: @board).count
+  end
+
+  test "does not enqueue reconciliation for rolled back attachments" do
+    blob = create_blob("rolled back")
+    clear_enqueued_jobs
+
+    Card.transaction do
+      @card.image.attach(blob)
+      raise ActiveRecord::Rollback
+    end
+
+    assert_no_enqueued_jobs only: Storage::Usage::ReconcileJob
+  end
+
+  private
+    def attach_image(card, contents)
+      blob = create_blob(contents)
+      card.image.attach(blob)
+      blob
+    end
+
+    def embed(record, attribute, contents)
+      blob = create_blob(contents)
+      record.update!(attribute => %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>))
+      blob
+    end
+
+    def create_blob(contents)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: "attachment.txt",
+        content_type: "text/plain"
+      )
+    end
+end
