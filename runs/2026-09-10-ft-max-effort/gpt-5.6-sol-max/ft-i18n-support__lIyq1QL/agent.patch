@@ -0,0 +1,70 @@
+ja:
+  seed:
+    playground: "プレイグラウンド"
+    cards:
+      orientation:
+        title: "最後に、Fizzy の紹介動画を見る"
+        description: |
+          <p>Fizzy ではほかにもたくさんのことができます。下の動画では、37signals の創業者兼 CEO、Jason Fried が基本操作を17分でご案内します。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/videos/fizzyorientation-4k.mp4" caption="Fizzy の紹介" content-type="video/mp4" filename="fizzyorientation-4k.mp4"></action-text-attachment>
+      passkey:
+        title: "次に、パスキーを設定する"
+        description: |
+          <p>パスキーを使うと、パスワードやメールコードなしで安全にサインインできます。設定するには Fizzy メニューを開き、「<b><strong>自分のプロフィール ＞ パスキーを管理</strong></b>」へ進みます。パスキーは任意ですが、設定をおすすめします。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/videos/creating_a_passkey.mp4" alt="パスキーを追加するデモ" caption="パスキーを作成してパスワードやメールコードなしでサインイン" content-type="video/mp4" filename="creating_a_passkey.mp4"></action-text-attachment>
+      invite:
+        title: "招待リンクでメンバーを招待する"
+        description: |
+          <p>Fizzy メニューを開いて「<b><strong>＋ メンバーを追加</strong></b>」を選び、招待リンクをコピーします。このリンクを共有すると、相手はあなたのアカウントに自分のログインを作成できます。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/invite-link.gif" alt="招待リンクをコピーするデモ" caption="同僚を招待するリンクを取得" content-type="image/*" filename="invite-link.gif" presentation="gallery"></action-text-attachment>
+      activity:
+        title: "ホームに戻ってアクティビティを確認する"
+        description: |
+          <p>「1」キーを押すか、Fizzy メニューを開いて「ホーム」を選びます。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/back-to-home.gif" alt="ホームを開くデモ" caption="ホームに戻って最新のアクティビティを確認" content-type="image/*" filename="back-to-home.gif" presentation="gallery"></action-text-attachment>
+      assigned:
+        title: "自分が担当するすべてのカードを確認する"
+        description: |
+          <p>画面上部の Fizzy メニューを開いて「<b><strong>自分が担当</strong></b>」を選ぶか、いつでもキーボードの「2」キーを押します。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/all-assigned.gif" alt="「自分が担当」へ移動するデモ" caption="自分が担当するすべてのカードを表示" content-type="image/*" filename="all-assigned.gif" presentation="gallery"></action-text-attachment>
+      menu:
+        title: "Fizzy メニューを開く"
+        description: |
+          <p>Fizzy メニューからアプリ内の各画面へ移動できます。画面上部の「<b><strong>Fizzy</strong></b>」をクリックするか、キーボードの「J」キーを押して開きます。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/open-menu.gif" alt="メインメニューを開くデモ" caption="Fizzy メニューを開く" content-type="image/*" filename="open-menu.gif" presentation="gallery"></action-text-attachment>
+      assign:
+        title: "このカードを自分に割り当てる"
+        description: |
+          <p>「＋」付きの人型アイコンをクリックし、自分を選びます。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/assign-to-self.gif" alt="カードに担当者を設定するデモ" caption="このカードを自分に割り当てる" content-type="image/*" filename="assign-to-self.gif" presentation="gallery"></action-text-attachment>
+      tag:
+        title: "このカードに「デザイン」タグを付けて「はい」へ移動する"
+        description: |
+          <p>タグアイコンをクリックして「design」と入力し、「<b><strong>タグを作成</strong></b>」を選びます。その後、前の手順で作成した新しい「はい」列へカードを移動します。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/tag-design.gif" alt="カードにタグを付けるデモ" caption="#design タグを付ける" content-type="image/*" filename="tag-design.gif" presentation="gallery"></action-text-attachment>
+      columns:
+        title: "さらに2つの列を作る"
+        description: |
+          <ol>
+            <li>1つを「はい」という名前にします</li>
+            <li>もう1つを「作業中」という名前にします</li>
+          </ol>
+          <p>ボード画面へ戻り、「完了」列の右にある小さな「＋」をクリックします。列名と色を設定し、もう一度同じ操作をします。</p>
+          <p><br></p>
+          <p>その後、このカードを「完了」へドラッグするか、サイドバーで「完了」を選びます。</p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/make-columns.gif" alt="列を追加するデモ" caption="さらに2つの列を作る" content-type="image/*" filename="make-columns.gif" presentation="gallery"></action-text-attachment>
+      not_now:
+        title: "次に、このカードを「後で」へ移動する"
+        description: |
+          <p>サイドバーで「後で」を選ぶか、ボード画面へ戻ってこのカードを左側の「後で」列へドラッグします。</p>
+          <p><br></p>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/not-now.gif" alt="カードを「後で」へ移動するデモ" caption="「後で」へ移動" content-type="image/*" filename="not-now.gif" presentation="gallery"></action-text-attachment>
+      rename:
+        title: "最初に、このカードの名前を変更する"
+        description: |
+          <ol>
+            <li>タイトルをクリックすると、カード名や説明を変更したり、詳しい情報を追加したりできます。</li>
+            <li>次に、カード下部の「完了にする」を押します。</li>
+            <li>最後に、画面左上の「<b><strong>プレイグラウンドに戻る</strong></b>」を押してボードへ戻ります。</li>
+          </ol>
+          <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/rename.gif" alt="カード名を変更するデモ" caption="このカードの名前を変更" content-type="image/*" filename="rename.gif" presentation="gallery"></action-text-attachment>
