--- /dev/null
+++ b/test/models/localization_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class ModelLocalizationTest < ActiveSupport::TestCase
+  test "formats Japanese dates and durations" do
+    I18n.with_locale(:ja) do
+      assert_equal "2026年03月05日(木)", I18n.l(Date.new(2026, 3, 5), format: :long)
+      assert_equal "2026年3月5日", I18n.l(Date.new(2026, 3, 5), format: :card_stamp)
+      assert_equal "15分", ActionController::Base.helpers.distance_of_time_in_words(15.minutes)
+    end
+  end
+
+  test "seeds the complete onboarding board in Japanese" do
+    I18n.with_locale(:ja) do
+      Current.account.setup_customer_template
+    end
+
+    playground = Current.account.boards.find_by!(name: "プレイグラウンド")
+    assert_equal 11, playground.cards.count
+    assert_includes playground.cards.pluck(:title), "最初に、このカードの名前を変更する"
+    assert_includes playground.cards.pluck(:title), "最後に、Fizzy の紹介動画を見る"
+    assert_includes playground.cards.find_by!(title: "次に、パスキーを設定する").description.to_plain_text, "パスワードやメールコードなし"
+  end
+
+  test "localizes validation messages and attribute names" do
+    signup = Signup.new(full_name: "", identity: identities(:kevin))
+
+    I18n.with_locale(:ja) do
+      assert_not signup.valid?(:completion)
+      assert_includes signup.errors.full_messages, "氏名を入力してください"
+    end
+  end
+
+  test "localizes the system user display name" do
+    I18n.with_locale(:ja) do
+      assert_equal "システム", Current.account.system_user.name
+    end
+
+    assert_equal "System", Current.account.system_user.name
+  end
+end
+
+class PushLocalizationTest < ActiveSupport::TestCase
+  test "builds push text in the recipient locale" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.user.identity.update!(locale: "ja")
+    captured_body = nil
+    target = Object.new
+    target.define_singleton_method(:process) { |item| captured_body = item.payload.body }
+    original_targets = Notification.push_targets
+    Notification.push_targets = [ target ]
+
+    I18n.with_locale(:en) do
+      notification.push
+    end
+
+    assert_match "担当", captured_body
+  ensure
+    Notification.push_targets = original_targets
+  end
+end
