diff --git a/test/lib/i18n_completeness_test.rb b/test/lib/i18n_completeness_test.rb
new file mode 100644
index 0000000..6a87b56
--- /dev/null
+++ b/test/lib/i18n_completeness_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class I18nCompletenessTest < ActiveSupport::TestCase
+  test "every static application key exists in both locales" do
+    static_translation_keys.each do |key|
+      I18n.available_locales.each do |locale|
+        assert I18n.exists?(key, locale), "Missing #{locale}.#{key}"
+      end
+    end
+  end
+
+  test "every dynamic application key exists in both locales" do
+    dynamic_translation_keys.each do |key|
+      I18n.available_locales.each do |locale|
+        assert I18n.exists?(key, locale), "Missing #{locale}.#{key}"
+      end
+    end
+  end
+
+  test "literal catalogs have identical keys" do
+    english = I18n.t("literals", locale: :en).keys
+    japanese = I18n.t("literals", locale: :ja).keys
+
+    assert_equal english.sort, japanese.sort
+  end
+
+  private
+    def static_translation_keys
+      Dir[Rails.root.join("{app,saas/app,lib}/**/*.{rb,erb,jbuilder}")].flat_map do |file|
+        File.read(file).scan(/(?:\bI18n\.)?\bt\(\s*["']([\w.]+)["']/).flatten
+      end.uniq
+    end
+
+    def dynamic_translation_keys
+      {
+        "emoji" => EmojiHelper::REACTIONS.values,
+        "filters.indexes" => Filter::Fields::INDEXES,
+        "filters.index_summaries" => Filter::Fields::INDEXES.without("all"),
+        "filters.sorts" => Filter::Fields::SORTED_BY,
+        "filters.sort_labels" => Filter::Fields::SORTED_BY,
+        "time_windows" => TimeWindowParser::VALUES,
+        "users.roles" => User.roles.keys,
+        "webhooks.actions" => WebhooksHelper::ACTIONS
+      }.flat_map do |prefix, suffixes|
+        suffixes.map { |suffix| "#{prefix}.#{suffix}" }
+      end
+    end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..08559af
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  test "uses the recipient identity locale" do
+    identity = identities(:david)
+    identity.update!(locale: "ja")
+    magic_link = identity.magic_links.create!
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzy の確認コード：#{magic_link.code}", email.subject
+    assert_match "Fizzy のサインインページ", email.text_part.body.decoded
+  end
+
+  test "uses a selected locale for the first email before authentication" do
+    identity = identities(:david)
+    magic_link = identity.magic_links.create!
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link, locale: "ja")
+
+    assert_equal "Fizzy の確認コード：#{magic_link.code}", email.subject
+  end
+
+  test "does not leak a recipient locale into later mail" do
+    japanese_identity = identities(:david)
+    japanese_identity.update!(locale: "ja")
+    english_identity = identities(:kevin)
+    japanese_link = japanese_identity.magic_links.create!
+    english_link = english_identity.magic_links.create!
+
+    MagicLinkMailer.sign_in_instructions(japanese_link).message
+    english_email = MagicLinkMailer.sign_in_instructions(english_link).message
+
+    assert_equal "Your Fizzy code is #{english_link.code}", english_email.subject
+    assert_equal :en, I18n.locale
+  end
+end
+
+class CompleteJapaneseMailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+    @identity.update!(locale: "ja")
+    @user = users(:david)
+  end
+
+  test "account cancellation email is Japanese" do
+    Current.account.cancel(initiated_by: @user)
+    email = AccountMailer.cancellation(Current.account.cancellation)
+
+    assert_equal "Fizzy アカウントをキャンセルしました", email.subject
+    assert_match "今後の流れ", email.text_part.body.decoded
+    assert_match "約1ヶ月", email.text_part.body.decoded
+  end
+
+  test "export email is Japanese" do
+    export = Account::Export.create!(account: Current.account, user: @user)
+    email = ExportMailer.completed(export)
+
+    assert_equal "Fizzy データをダウンロードできます", email.subject
+    assert_match "データをダウンロード", email.text_part.body.decoded
+    assert_match "locale=ja", email.html_part.body.decoded
+  end
+
+  test "completed and failed import emails are Japanese" do
+    completed = ImportMailer.completed(@identity, Current.account)
+    import = Account::Import.create!(account: Current.account, identity: @identity, status: :failed)
+    failed = ImportMailer.failed(import)
+
+    assert_equal "Fizzy アカウントのインポートが完了しました", completed.subject
+    assert_match "インポート対象", completed.text_part.body.decoded
+    assert_equal "Fizzy アカウントのインポートに失敗しました", failed.subject
+    assert_match "インポートできませんでした", failed.text_part.body.decoded
+  end
+
+  test "email change confirmation is Japanese" do
+    email = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user)
+
+    assert_equal "新しいメールアドレスを確認してください", email.subject
+    assert_match "メールアドレスの変更を確認", email.body.decoded
+  end
+
+  test "notification bundle email and date are Japanese" do
+    @user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: @user, starts_at: Time.zone.local(2026, 3, 5, 15), ends_at: 1.hour.from_now)
+    Notification.create!(user: @user, creator: users(:kevin), source: events(:logo_published))
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_match "新しい通知", email.subject
+    assert_match "2026年3月5日", email.text_part.body.decoded
+    assert_match "以降の通知", email.text_part.body.decoded
+  end
+end
