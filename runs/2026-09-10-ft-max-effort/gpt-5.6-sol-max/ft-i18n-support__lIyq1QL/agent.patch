@@ -0,0 +1,23 @@
+require "application_system_test_case"
+
+class BrowserLocalizationTest < ApplicationSystemTestCase
+  test "restores Japanese and formats client-side dates" do
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    visit session_transfer_url(user.identity.transfer_id, script_name: nil)
+    assert_current_path root_path(locale: "ja")
+
+    assert_selector "html[lang='ja']"
+    assert_text "アクティビティ"
+
+    page.execute_script <<~JAVASCRIPT
+      const time = document.createElement("time")
+      time.id = "localized-relative-time"
+      time.setAttribute("datetime", Math.floor((Date.now() - 2 * 86_400_000) / 1000))
+      time.dataset.localTimeTarget = "daysago"
+      document.body.appendChild(time)
+    JAVASCRIPT
+
+    assert_selector "#localized-relative-time", text: "2日前"
+  end
+end
