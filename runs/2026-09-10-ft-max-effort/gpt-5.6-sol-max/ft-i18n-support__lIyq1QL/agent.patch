+
+class Signup::JapaneseAccountNameGeneratorTest < ActiveSupport::TestCase
+  test "generates Japanese account names and increments them" do
+    identity = Identity.create!(email_address: "tokyo@example.com", locale: "ja")
+
+    I18n.with_locale(:ja) do
+      generator = Signup::AccountNameGenerator.new(identity: identity, name: "山田 太郎")
+      assert_equal "山田のFizzy", generator.generate
+
+      account = Account.create!(external_account_id: "ja-first", name: generator.generate)
+      Current.without_account do
+        identity.users.create!(account: account, name: "山田 太郎")
+        identity.reload
+      end
+
+      assert_equal "山田のFizzy（2）", generator.generate
+    end
+  end
+end
