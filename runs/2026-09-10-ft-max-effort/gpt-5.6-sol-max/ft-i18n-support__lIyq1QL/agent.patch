diff --git a/script/i18n-audit b/script/i18n-audit
new file mode 100755
index 0000000..05951a4
--- /dev/null
+++ b/script/i18n-audit
@@ -0,0 +1,188 @@
+#!/usr/bin/env ruby
+# frozen_string_literal: true
+
+# Fails when likely user-facing English bypasses I18n. Rich-text editor package
+# strings are intentionally excluded: that package owns its own translations.
+
+require "pathname"
+
+ROOT = Pathname(__dir__).join("..").expand_path
+Findings = []
+
+ALLOWED_TEXT = [
+  /\A(?:Fizzy|Fizzy™|Basecamp|Basecamp™|HEY|HEY™|37signals™|Jason Fried|Google Chrome)\z/,
+  /\A(?:DEV|ESC|ON|OFF|OK|HMAC|SHA256)\z/,
+  /\A[\w.+-]+@[\w.-]+\z/,
+  /\Ahttps?:\/\//
+].freeze
+
+ATTRIBUTE_PATTERN = /\b(?:aria-label|aria-description|title|placeholder|alt)\s*=\s*["']([^"'<%]*[A-Za-z][^"'<%]*)["']/
+RUBY_OPTION_PATTERN = /\b(?:alert|notice|message|subject|placeholder|title|alt|validation_message|turbo_confirm|bridge_title):\s*["']([^"']*[A-Za-z][^"']*)["']/
+RUBY_ERROR_PATTERN = /errors\.add[^\n]*["']([^"']*[A-Za-z][^"']*)["']/
+RUBY_MESSAGE_CONSTANT_PATTERN = /\b\w*MESSAGE\w*\s*=\s*["']([^"']*[A-Za-z][^"']*)["']/
+
+def readable_english?(text)
+  normalized = text.gsub(/&(?:nbsp|amp|gt|lt|quot|middot);?/, " ").gsub(/\s+/, " ").strip
+  normalized.match?(/[A-Za-z]{2}/) && !normalized.match?(/\A\w+(?:\.\w+)+\z/) && ALLOWED_TEXT.none? { |pattern| pattern.match?(normalized) }
+end
+
+def report(path, line, kind, text)
+  Findings << "#{path.relative_path_from(ROOT)}:#{line}: #{kind}: #{text.gsub(/\s+/, ' ').strip}"
+end
+
+def raw_ranges(source)
+  source.to_enum(:scan, /<(style|script)\b.*?<\/\1>/mi).map do
+    match = Regexp.last_match
+    match.begin(0)...match.end(0)
+  end
+end
+
+def content_segments(source)
+  segments = []
+  index = 0
+
+  while index < source.length
+    previous_index = index
+    if source[index, 2] == "<%"
+      ending = source.index("%>", index + 2) || source.length - 2
+      index = ending + 2
+    elsif source[index, 4] == "<!--"
+      ending = source.index("-->", index + 4) || source.length - 3
+      index = ending + 3
+    elsif source[index] == "<"
+      ending = index + 1
+      erb = false
+      quote = nil
+      while ending < source.length
+        if erb
+          if source[ending, 2] == "%>"
+            erb = false
+            ending += 2
+          else
+            ending += 1
+          end
+        elsif source[ending, 2] == "<%"
+          erb = true
+          ending += 2
+        elsif quote
+          quote = nil if source[ending] == quote
+          ending += 1
+        elsif source[ending] == "\"" || source[ending] == "'"
+          quote = source[ending]
+          ending += 1
+        elsif source[ending] == ">"
+          ending += 1
+          break
+        else
+          ending += 1
+        end
+      end
+      index = ending
+    else
+      ending = source.index("<", index) || source.length
+      segments << (index...ending)
+      index = ending
+    end
+    raise "Tokenizer did not advance at #{index}" unless index > previous_index
+  end
+
+  segments
+end
+
+def scan_template(path)
+  source = path.read
+  ranges = raw_ranges(source)
+
+  unless path.to_s.end_with?("manifest.json.erb")
+    content_segments(source).each do |range|
+      next if ranges.any? { |raw_range| raw_range.cover?(range.begin) }
+
+      source[range].each_line.with_index do |line, offset|
+        if readable_english?(line)
+          line_number = source[0...range.begin].count("\n") + offset + 1
+          report(path, line_number, "visible text", line)
+        end
+      end
+    end
+  end
+
+  source.to_enum(:scan, ATTRIBUTE_PATTERN).each do
+    match = Regexp.last_match
+    next unless readable_english?(match[1])
+
+    line = source[0...match.begin(1)].count("\n") + 1
+    report(path, line, "readable attribute", match[1])
+  end
+
+  source.to_enum(:scan, /<%(?!#)(.*?)%>/m).each do
+    erb = Regexp.last_match
+    code = erb[1]
+    code.to_enum(:scan, RUBY_OPTION_PATTERN).each do
+      match = Regexp.last_match
+      next unless readable_english?(match[1])
+      next if match[1].start_with?("http://", "https://")
+
+      line = source[0...erb.begin(0)].count("\n") + code[0...match.begin(1)].count("\n") + 1
+      report(path, line, "readable option", match[1])
+    end
+  end
+end
+
+view_paths = %w[app/views saas/app/views].flat_map { |root| ROOT.join(root).glob("**/*.erb") }
+view_paths.reject { |path| path.to_s.include?("/action_text/") || path.to_s.end_with?("/pwa/service_worker.js.erb", "/layouts/_theme_preference.html.erb") }.sort.each { |path| scan_template(path) }
+
+jbuilder_paths = %w[app/views saas/app/views].flat_map { |root| ROOT.join(root).glob("**/*.jbuilder") }
+jbuilder_paths.sort.each do |path|
+  path.each_line.with_index(1) do |line, line_number|
+    line.scan(/json\.\w+\s+["']([^"']*[A-Za-z][^"']*\s+[^"']*)["']/) do |match|
+      report(path, line_number, "JSON text", match.first) if readable_english?(match.first)
+    end
+  end
+end
+
+ruby_paths = %w[app/controllers app/helpers app/mailers app/models saas/app/controllers saas/app/helpers saas/app/mailers saas/app/models]
+  .flat_map { |root| ROOT.join(root).glob("**/*.rb") }
+ruby_paths.concat ROOT.join("lib/action_pack/passkey").glob("**/*.rb")
+ruby_paths.sort.each do |path|
+  path.each_line.with_index(1) do |line, line_number|
+    next if line.lstrip.start_with?("#")
+
+    [ RUBY_OPTION_PATTERN, RUBY_ERROR_PATTERN, RUBY_MESSAGE_CONSTANT_PATTERN ].each do |pattern|
+      line.scan(pattern) do |match|
+        text = match.first
+        next if text.start_with?("#")
+        report(path, line_number, "Ruby message", text) if readable_english?(text)
+      end
+    end
+  end
+end
+
+css_paths = %w[app/assets saas/app/assets].flat_map { |root| ROOT.join(root).glob("**/*.{css,scss}") }
+css_paths.sort.each do |path|
+  path.each_line.with_index(1) do |line, line_number|
+    line.scan(/content:\s*["']([^"']*[A-Za-z][^"']*)["']/) do |match|
+      report(path, line_number, "CSS-generated text", match.first) if readable_english?(match.first)
+    end
+  end
+end
+
+js_paths = ROOT.join("app/javascript").glob("**/*.js").reject do |path|
+  path.to_s.include?("/helpers/i18n_helpers.js") || path.to_s.include?("/lexxy")
+end
+js_sink_pattern = /(?:setCustomValidity|confirm|alert|new Error)\(\s*["']([^"']*[A-Za-z][^"']*)["']|(?:innerHTML|textContent|innerText|title)\s*=\s*["']([^"']*[A-Za-z][^"']*)["']/
+js_paths.sort.each do |path|
+  path.each_line.with_index(1) do |line, line_number|
+    line.scan(js_sink_pattern) do |first, second|
+      text = first || second
+      report(path, line_number, "JavaScript text", text) if readable_english?(text)
+    end
+  end
+end
+
+if Findings.any?
+  warn Findings.join("\n")
+  warn "\n#{Findings.size} likely unlocalized user-facing string(s)"
+  exit 1
+else
+  puts "I18n audit passed"
+end
diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..4ac7477
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "defaults to the existing English experience" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "h1", text: "Get into Fizzy"
+    assert_nil identities(:kevin).reload.locale
+  end
+
+  test "a supported locale parameter switches locale and sticks in the browser session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", text: "Fizzy にログイン"
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", text: "Fizzy にログイン"
+    end
+  end
+
+  test "an unsupported locale does not switch a fresh session" do
+    untenanted do
+      get new_session_path(locale: "xx")
+    end
+
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "h1", text: "Get into Fizzy"
+  end
+
+  test "an unsupported locale does not replace an existing choice" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      get new_session_path(locale: "xx")
+    end
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "h1", text: "Fizzy にログイン"
+  end
+
+  test "an authenticated locale choice is saved on the identity" do
+    sign_in_as :kevin
+
+    get root_path(locale: "ja")
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "an identity locale is restored after sign in from a clean browser session" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    sign_in_as identity
+    get root_path
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+  end
+
+  test "explicitly choosing English replaces Japanese and persists" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    sign_in_as identity
+
+    get root_path(locale: "en")
+
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_equal "en", identity.reload.locale
+  end
+
+  test "locale participates in HTTP validators" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    japanese_etag = response.headers.fetch("ETag")
+
+    get root_path(locale: "en"), headers: { "If-None-Match" => japanese_etag }
+
+    assert_response :success
+    assert_not_equal japanese_etag, response.headers.fetch("ETag")
+  end
+end
+
+class SharedBrowserLocalizationTest < ActionDispatch::IntegrationTest
+  test "an explicit signed-out choice applies to the next identity" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    sign_out
+
+    untenanted { get new_session_path(locale: "en") }
+    sign_in_as :david
+
+    assert_equal "en", identities(:david).reload.locale
+  end
+end
+
+class LocalizedUrlTest < ActionDispatch::IntegrationTest
+  test "Japanese generated URLs carry locale while English URLs do not" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_select "form[action*='locale=ja']"
+      assert_select "link[rel='manifest'][href*='locale=ja']"
+    end
+
+    reset!
+    integration_session.default_url_options[:script_name] = ""
+    get new_session_path
+
+    assert_select "form[action='/session']"
+    assert_select "link[rel='manifest'][href='/manifest.json']"
+  end
+end
+
+class PendingAuthenticationLocalizationTest < ActionDispatch::IntegrationTest
+  test "restores an identity locale before showing the verification code screen" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      follow_redirect!
+    end
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select "h1", text: "メールを確認してください"
+  end
+end
