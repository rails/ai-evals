diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..03222a6
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,70 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[ en ja ].freeze
+
+  included do
+    prepend_around_action :switch_locale
+    before_action :apply_identity_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def switch_locale(&action)
+      remember_requested_locale
+      I18n.with_locale(session_locale || I18n.default_locale, &action)
+    end
+
+    def remember_requested_locale
+      if locale = supported_locale(params[:locale])
+        session[:locale] = locale
+        session.delete(:locale_identity_id)
+      end
+    end
+
+    def apply_identity_locale
+      apply_locale_for(Current.identity) if Current.identity
+    end
+
+    def restore_locale_from(identity)
+      if session_locale.blank? && (locale = supported_locale(identity.locale))
+        session[:locale] = locale
+        session[:locale_identity_id] = identity.id
+        I18n.locale = locale
+      end
+    end
+
+    def apply_locale_for(identity)
+      if session_locale && locale_choice_belongs_to?(identity)
+        locale = session_locale
+        identity.update_column(:locale, locale) unless identity.locale == locale
+      else
+        locale = supported_locale(identity.locale) || I18n.default_locale
+        remember_identity_locale locale, identity
+      end
+
+      session[:locale_identity_id] = identity.id
+      I18n.locale = locale
+    end
+
+    def locale_choice_belongs_to?(identity)
+      session[:locale_identity_id].blank? || session[:locale_identity_id] == identity.id
+    end
+
+    def remember_identity_locale(locale, identity)
+      if identity.locale.present?
+        session[:locale] = locale
+      else
+        session.delete(:locale)
+      end
+    end
+
+    def session_locale
+      supported_locale(session[:locale])
+    end
+
+    def supported_locale(locale)
+      locale.to_s if locale.to_s.in?(SUPPORTED_LOCALES)
+    end
+end
