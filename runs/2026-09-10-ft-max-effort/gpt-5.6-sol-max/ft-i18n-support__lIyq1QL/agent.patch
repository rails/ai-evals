+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,100 @@
+const MESSAGES = {
+  en: {
+    areYouSure: "Are you sure?",
+    fillOutField: "Please fill out this field",
+    noSelection: "No selection",
+    lessThanMinuteAgo: "Less than a minute ago",
+    agoYearOne: "%{count} year ago",
+    agoYearOther: "%{count} years ago",
+    agoMonthOne: "%{count} month ago",
+    agoMonthOther: "%{count} months ago",
+    agoWeekOne: "%{count} week ago",
+    agoWeekOther: "%{count} weeks ago",
+    agoDayOne: "%{count} day ago",
+    agoDayOther: "%{count} days ago",
+    agoHourOne: "%{count} hour ago",
+    agoHourOther: "%{count} hours ago",
+    agoMinuteOne: "%{count} minute ago",
+    agoMinuteOther: "%{count} minutes ago",
+    daysAgo: "%{days} days ago",
+    actionIn: "%{action} in",
+    today: "today",
+    todayCapitalized: "Today",
+    yesterday: "yesterday",
+    tomorrow: "tomorrow",
+    day: "day",
+    days: "days",
+    inDays: "in %{days} days",
+    stalledFor: "Stalled for",
+    passkeysUnsupported: "Passkeys are not supported by this browser",
+    missingPasskeyOptions: "Missing passkey options",
+    passkeyFailed: "Passkey ceremony failed",
+    conditionalPasskeyFailed: "Passkey conditional mediation failed",
+    missingPasskeyChallengeUrl: "Missing passkey challenge URL",
+    refreshChallengeFailed: "Failed to refresh challenge"
+  },
+  ja: {
+    areYouSure: "よろしいですか？",
+    fillOutField: "この項目を入力してください",
+    noSelection: "選択なし",
+    lessThanMinuteAgo: "たった今",
+    agoYearOne: "%{count}年前",
+    agoYearOther: "%{count}年前",
+    agoMonthOne: "%{count}か月前",
+    agoMonthOther: "%{count}か月前",
+    agoWeekOne: "%{count}週間前",
+    agoWeekOther: "%{count}週間前",
+    agoDayOne: "%{count}日前",
+    agoDayOther: "%{count}日前",
+    agoHourOne: "%{count}時間前",
+    agoHourOther: "%{count}時間前",
+    agoMinuteOne: "%{count}分前",
+    agoMinuteOther: "%{count}分前",
+    daysAgo: "%{days}日前",
+    actionIn: "%{action}まで",
+    today: "今日",
+    todayCapitalized: "今日",
+    yesterday: "昨日",
+    tomorrow: "明日",
+    day: "日",
+    days: "日",
+    inDays: "%{days}日後",
+    stalledFor: "停滞期間",
+    passkeysUnsupported: "このブラウザはパスキーに対応していません",
+    missingPasskeyOptions: "パスキーのオプションがありません",
+    passkeyFailed: "パスキーの処理に失敗しました",
+    conditionalPasskeyFailed: "パスキーの自動処理に失敗しました",
+    missingPasskeyChallengeUrl: "パスキーのチャレンジURLがありません",
+    refreshChallengeFailed: "チャレンジを更新できませんでした"
+  }
+}
+
+export function currentLocale() {
+  return (document.body?.lang || document.documentElement.lang) === "ja" ? "ja" : "en"
+}
+
+export function translate(key, variables = {}) {
+  let message = MESSAGES[currentLocale()][key] || MESSAGES.en[key] || key
+
+  for (const [name, value] of Object.entries(variables)) {
+    message = message.replace(`%{${name}}`, value)
+  }
+
+  return message
+}
+
+export function sentenceConnectors({ choice = false } = {}) {
+  if (currentLocale() === "ja") {
+    return {
+      words_connector: "、",
+      two_words_connector: choice ? "または" : "、",
+      last_word_connector: choice ? "、または" : "、"
+    }
+  } else {
+    return {
+      words_connector: ", ",
+      two_words_connector: choice ? " or " : " and ",
+      last_word_connector: choice ? ", or " : ", and "
+    }
+  }
+}
