--- /dev/null
+++ b/app/views/public/boards/show.html.erb
@@ -0,0 +1,46 @@
+<% @page_title = @board.name %>
+<% @body_class = "contained-scrolling" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<% cards = @cards.to_a %>
+<div class="card-columns hide-scrollbar">
+  <div class="card-columns__left">
+    <%= render "public/boards/column",
+          name: "Not Now",
+          color: "var(--color-card-complete)",
+          cards: cards.select(&:postponed?),
+          publication: @publication,
+          class_name: "cards--on-deck" %>
+  </div>
+
+  <%= render "public/boards/column",
+        name: "Maybe?",
+        color: "var(--color-card-default)",
+        cards: cards.select(&:awaiting_triage?),
+        publication: @publication,
+        class_name: "cards--maybe" %>
+
+  <div class="card-columns__right">
+    <% @board.columns.sorted.each do |column| %>
+      <%= render "public/boards/column",
+            name: column.name,
+            color: column.color,
+            cards: cards.select { |card| card.active? && card.column_id == column.id },
+            publication: @publication,
+            column: column,
+            class_name: "cards--doing" %>
+    <% end %>
+
+    <%= render "public/boards/column",
+          name: "Done",
+          color: "var(--color-card-complete)",
+          cards: cards.select(&:closed?),
+          publication: @publication,
+          class_name: "cards--closed" %>
+  </div>
+</div>
