diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..c4b5db6
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,100 @@
+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <meta property="og:title" content="<%= @card.title %> | <%= @board.name %>">
+  <meta property="og:description" content="<%= format_excerpt(@card.description, length: 200) %>">
+  <meta property="og:url" content="<%= public_board_card_url(@publication.key, @card.number) %>">
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, public_board_path(@publication.key), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<div data-controller="lightbox">
+  <section class="card-perma" style="--card-color: <%= @card.color %>;">
+    <div class="card-perma__bg">
+      <%= card_article_tag @card, class: "card" do %>
+        <header class="card__header">
+          <div class="card__board">
+            <div class="card__id">
+              <span class="for-screen-reader">Card number</span>
+              <%= @card.number %>
+            </div>
+            <div class="card__board-name">
+              <%= link_to @board.name, public_board_path(@publication.key), class: "btn btn--plain overflow-ellipsis" %>
+            </div>
+          </div>
+          <%= render "cards/display/preview/tags", card: @card %>
+        </header>
+
+        <div class="card__body justify-space-between">
+          <div class="card__content">
+            <h1 class="card__title"><%= card_html_title(@card) %></h1>
+
+            <% unless @card.description.blank? %>
+              <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+                <%= @card.description %>
+              </div>
+            <% end %>
+
+            <% if @card.steps.any? %>
+              <ol class="steps">
+                <% @card.steps.each do |step| %>
+                  <li class="step <%= "step--completed" if step.completed? %>">
+                    <span class="step__content"><%= step.content %></span>
+                  </li>
+                <% end %>
+              </ol>
+            <% end %>
+          </div>
+
+          <%= render "cards/display/common/stamp", card: @card %>
+        </div>
+
+        <footer class="card__footer">
+          <div class="card__meta">
+            <span class="card__meta-text card__meta-text--added">Added <%= local_datetime_tag(@card.created_at, style: :daysago) %></span>
+            <span class="card__meta-text card__meta-text--author">By <strong><%= @card.creator.familiar_name %></strong></span>
+            <% if @card.assignees.any? %>
+              <span class="card__meta-text card__meta-text--assignees">Assigned to <%= @card.assignees.map(&:familiar_name).to_sentence %></span>
+            <% end %>
+          </div>
+          <%= render "cards/display/common/background", card: @card %>
+        </footer>
+      <% end %>
+    </div>
+  </section>
+
+  <% if @card.comments.any? %>
+    <section class="comments gap center" role="group" aria-label="Messages">
+      <% @card.comments.preloaded.chronologically.each do |comment| %>
+        <article class="comment align-start full-width">
+          <figure class="comment__avatar flex-item-no-shrink" aria-hidden="true">
+            <%= avatar_preview_tag comment.creator, hidden_for_screen_reader: true %>
+          </figure>
+          <div class="comment__content flex flex-column flex-item-grow full-width">
+            <div class="comment__author txt-align-start">
+              <strong><%= comment.creator.name %></strong>
+              <%= local_datetime_tag comment.created_at, style: :agoorweekday %>
+            </div>
+            <div class="comment__body lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= comment.body %>
+            </div>
+            <% if comment.reactions.any? %>
+              <div class="reactions">
+                <% comment.reactions.each do |reaction| %>
+                  <span class="reaction" title="<%= reaction.reacter.name %>"><%= reaction.content %></span>
+                <% end %>
+              </div>
+            <% end %>
+          </div>
+        </article>
+      <% end %>
+    </section>
+  <% end %>
+
+  <%= render "layouts/lightbox" %>
+</div>
