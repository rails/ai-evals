@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show is available without authentication" do
+    get public_board_path(@board.publication.key)
+
+    assert_response :success
+    assert_includes response.body, @board.name
+  end
+
+  test "show only includes published cards" do
+    draft = @board.cards.create!(creator: users(:david), title: "Secret draft", status: :drafted)
+
+    get public_board_path(@board.publication.key)
+
+    assert_response :success
+    assert_includes response.body, cards(:buy_domain).title
+    assert_not_includes response.body, draft.title
+  end
+
+  test "show rejects an invalid publication key" do
+    get public_board_path("invalid")
+
+    assert_response :not_found
+  end
+
+  test "show rejects a key belonging to another account" do
+    other_board = boards(:miltons_wish_list)
+    other_board.publish
+
+    get public_board_path(other_board.publication.key)
+
+    assert_response :not_found
+  end
+
+  test "show is revoked after unpublishing" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_path(key)
+
+    assert_response :not_found
+  end
+
+  test "show as JSON includes only public resource URLs" do
+    get public_board_path(@board.publication.key), as: :json
+
+    assert_response :success
+    assert_equal @board.name, response.parsed_body["name"]
+    assert response.parsed_body["cards"].all? { |card| card["url"].include?(@board.publication.key) }
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..0d1c684
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publishing and unpublishing a board" do
+    assert_not @board.published?
+
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      @board.publish
+    end
+
+    key = @board.publication.key
+    assert_predicate key, :present?
+
+    assert_no_changes -> { @board.reload.publication.key } do
+      @board.publish
+    end
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      @board.unpublish
+    end
+
+    @board.publish
+    assert_not_equal key, @board.publication.key
+  end
+
+  test "publishing and unpublishing touch the board" do
+    updated_at = @board.updated_at
+
+    travel 1.minute do
+      @board.publish
+    end
+    assert_operator @board.reload.updated_at, :>, updated_at
+
+    updated_at = @board.updated_at
+    travel 2.minutes do
+      @board.unpublish
+    end
+    assert_operator @board.reload.updated_at, :>, updated_at
+  end
+end
