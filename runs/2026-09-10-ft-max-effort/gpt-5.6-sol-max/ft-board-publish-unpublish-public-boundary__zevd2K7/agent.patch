diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..b18209b
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :success
+  end
+
+  test "destroy" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :success
+  end
+
+  test "only admins can publish" do
+    logout_and_sign_in_as :david
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "only admins can unpublish" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    assert_no_changes -> { @board.reload.published? } do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "published link is shown to admins in board settings" do
+    @board.publish
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_select "input[aria-label='Public board link'][value=?]", public_board_url(@board.publication.key)
+  end
+
+  test "publication controls are hidden from members" do
+    logout_and_sign_in_as :david
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_select "form[action=?]", board_publication_path(@board), count: 0
+  end
+end
