+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show is available without authentication" do
+    card = cards(:logo)
+
+    get public_board_card_path(@board.publication.key, card.number)
+
+    assert_response :success
+    assert_includes response.body, ERB::Util.html_escape(card.title)
+  end
+
+  test "show rejects a draft" do
+    draft = @board.cards.create!(creator: users(:david), title: "Secret draft", status: :drafted)
+
+    get public_board_card_path(@board.publication.key, draft.number)
+
+    assert_response :not_found
+  end
+
+  test "show rejects a published card from another board" do
+    card = with_current_user(:kevin) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Private card", status: :published)
+    end
+
+    get public_board_card_path(@board.publication.key, card.number)
+
+    assert_response :not_found
+  end
+
+  test "show as JSON" do
+    card = cards(:logo)
+
+    get public_board_card_path(@board.publication.key, card.number), as: :json
+
+    assert_response :success
+    assert_equal card.title, response.parsed_body["title"]
+    assert_includes response.parsed_body["url"], @board.publication.key
+  end
+end
diff --git a/test/controllers/public/boards/columns_controller_test.rb b/test/controllers/public/boards/columns_controller_test.rb
