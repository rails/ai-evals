+require "test_helper"
+
+class BoardsPublicUrlTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    sign_in_as :kevin
+  end
+
+  test "board JSON includes a nil public_url by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.key?("public_url")
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "board JSON includes the secret URL after publication" do
+    @board.publish
+
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_equal public_board_url(@board.publication.key), @response.parsed_body["public_url"]
+  end
+end
