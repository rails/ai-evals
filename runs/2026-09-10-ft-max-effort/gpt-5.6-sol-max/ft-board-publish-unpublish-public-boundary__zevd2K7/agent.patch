@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Public::Boards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "show is available without authentication" do
+    get public_board_column_path(@board.publication.key, @column)
+
+    assert_response :success
+    assert_includes response.body, @column.name
+    assert_includes response.body, cards(:text).title
+  end
+
+  test "show rejects a column from another board" do
+    other_board = boards(:miltons_wish_list)
+    other_column = other_board.columns.create!(name: "Other", color: "var(--color-card-default)")
+
+    get public_board_column_path(@board.publication.key, other_column)
+
+    assert_response :not_found
+  end
+
+  test "show as JSON" do
+    get public_board_column_path(@board.publication.key, @column), as: :json
+
+    assert_response :success
+    assert_equal @column.name, response.parsed_body["name"]
+    assert response.parsed_body["cards"].all? { |card| card["url"].include?(@board.publication.key) }
+  end
+
+  test "show invalidates its ETag when an empty column changes" do
+    column = @board.columns.create!(name: "Empty", color: "var(--color-card-default)")
+
+    get public_board_column_path(@board.publication.key, column)
+    etag = response.headers["ETag"]
+    column.update!(name: "Renamed")
+    get public_board_column_path(@board.publication.key, column), headers: { "If-None-Match" => etag }
+
+    assert_response :success
+    assert_includes response.body, "Renamed"
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
