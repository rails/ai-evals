diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..b1ea388
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @initiator = users(:david)
+  end
+
+  test "incinerate due destroys only accounts cancelled more than the grace period ago" do
+    due_account = accounts(:initech)
+    boundary_account = accounts(:acme)
+    active_account = accounts("37s")
+
+    freeze_time do
+      due_account.create_cancellation!(
+        initiated_by: @initiator,
+        created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.second
+      )
+      boundary_account.create_cancellation!(
+        initiated_by: @initiator,
+        created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+      )
+
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(boundary_account.id)
+    assert Account.exists?(active_account.id)
+  end
+
+  test "incinerate removes associated records including stored files and storage entries" do
+    account = accounts("37s")
+    card = cards(:logo)
+    card.image.attach \
+      io: StringIO.new("private account data"),
+      filename: "private.txt",
+      content_type: "text/plain"
+    blob = card.image.blob
+
+    assert Storage::Entry.exists?(account: account)
+
+    account.incinerate
+
+    assert_not Account.exists?(account.id)
+    assert_not Card.exists?(card.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not Storage::Entry.exists?(account: account)
+  end
+end
