diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..c6ba39b
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,119 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+  STRIPE_SUBSCRIPTION_EVENTS = %w[
+    customer.subscription.created
+    customer.subscription.updated
+    customer.subscription.deleted
+    customer.subscription.paused
+    customer.subscription.resumed
+  ].freeze
+
+  belongs_to :account
+
+  validates :plan_key, inclusion: { in: ->(_) { Account::Plan.paid.map(&:key) } }
+  validates :stripe_customer_id, :stripe_subscription_id, :status, presence: true
+  validates :account_id, :stripe_customer_id, :stripe_subscription_id, uniqueness: true
+
+  class << self
+    def apply_stripe_event(event)
+      if event.type.in?(STRIPE_SUBSCRIPTION_EVENTS)
+        sync_from_stripe(event.data.object)
+      end
+    end
+
+    def sync_from_stripe(stripe_subscription)
+      attributes = stripe_attributes(stripe_subscription)
+      subscription = find_existing(attributes) || new
+      account = subscription.account || find_account(attributes)
+      plan = find_plan(attributes) || subscription.plan
+
+      subscription.update!(
+        account: account,
+        plan_key: plan.key,
+        stripe_customer_id: attributes.fetch("customer_id"),
+        stripe_subscription_id: attributes.fetch("id"),
+        status: attributes.fetch("status"),
+        current_period_end: timestamp(attributes["current_period_end"]),
+        cancel_at: timestamp(attributes["cancel_at"])
+      )
+      subscription
+    end
+
+    private
+      def stripe_attributes(stripe_subscription)
+        attributes = if stripe_subscription.respond_to?(:to_hash)
+          stripe_subscription.to_hash
+        else
+          stripe_subscription
+        end
+        attributes = attributes.with_indifferent_access
+        customer = attributes["customer"]
+        attributes["customer_id"] = if customer.respond_to?(:id)
+          customer.id
+        elsif customer.respond_to?(:with_indifferent_access)
+          customer.with_indifferent_access["id"] || customer
+        else
+          customer
+        end
+        attributes
+      end
+
+      def find_existing(attributes)
+        find_by(stripe_subscription_id: attributes["id"]) ||
+          find_by(stripe_customer_id: attributes["customer_id"])
+      end
+
+      def find_account(attributes)
+        metadata = attributes.fetch("metadata", {}).with_indifferent_access
+        Account.find_by(id: metadata["account_id"]) ||
+          Account.find_by(external_account_id: metadata["external_account_id"]) ||
+          Account.find_by(id: attributes["client_reference_id"]) ||
+          raise(ActiveRecord::RecordNotFound, "No Fizzy account matches this Stripe subscription")
+      end
+
+      def find_plan(attributes)
+        metadata = attributes.fetch("metadata", {}).with_indifferent_access
+        plan_from_line_items(attributes) || plan_from_key(metadata["plan_key"])
+      end
+
+      def plan_from_key(key)
+        Account::Plan.find(key) if key.present?
+      rescue KeyError
+        nil
+      end
+
+      def plan_from_line_items(attributes)
+        price_ids = attributes.dig("items", "data").to_a.filter_map do |item|
+          item = item.with_indifferent_access
+          price_id(item["price"])
+        end
+        Account::Plan.paid.find { |plan| plan.stripe_price_id.in?(price_ids) }
+      end
+
+      def price_id(price)
+        if price.respond_to?(:id)
+          price.id
+        elsif price.respond_to?(:with_indifferent_access)
+          price.with_indifferent_access["id"]
+        else
+          price
+        end
+      end
+
+      def timestamp(value)
+        Time.zone.at(value) if value.present?
+      end
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def plan
+    Account::Plan.find(plan_key)
+  end
+
+  def cancel
+    Stripe::Subscription.cancel(stripe_subscription_id)
+  end
+end
diff --git a/saas/app/views/account/settings/saas/_billing.html.erb b/saas/app/views/account/settings/saas/_billing.html.erb
