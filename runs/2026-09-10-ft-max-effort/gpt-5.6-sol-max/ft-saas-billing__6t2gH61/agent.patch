@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.billing_waiver&.destroy!
+    @account.overridden_limits&.destroy!
+    sign_in_as :david
+  end
+
+  test "staff can list accounts and open each account page" do
+    untenanted do
+      get saas.admin_accounts_path(script_name: "")
+    end
+
+    assert_response :success
+    assert_select "a[href='#{saas.admin_account_path(@account, script_name: "")}']", text: @account.name
+
+    untenanted do
+      get saas.admin_account_path(@account, script_name: "")
+    end
+
+    assert_response :success
+    assert_select "h1", text: @account.name
