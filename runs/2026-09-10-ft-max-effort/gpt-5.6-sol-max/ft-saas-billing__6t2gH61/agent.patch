diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..560a8af
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  WEBHOOK_SECRET = "whsec_test_fizzy"
+
+  setup do
+    @account = accounts(:initech)
+    Account::Subscription.delete_all
+    @old_webhook_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    @old_monthly_price = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    @old_plus_price = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = WEBHOOK_SECRET
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @old_webhook_secret
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @old_monthly_price
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = @old_plus_price
+  end
+
+  test "signed subscription changes create and update the account subscription" do
+    post_event "customer.subscription.created", subscription_payload
+
+    assert_response :success
+    subscription = @account.reload.subscription
+    assert_equal "sub_webhook", subscription.stripe_subscription_id
+    assert_equal "cus_webhook", subscription.stripe_customer_id
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal Time.zone.at(1_800_000_000), subscription.current_period_end
+
+    post_event "customer.subscription.updated", subscription_payload(
+      status: "past_due", price_id: "price_unlimited_plus", current_period_end: 1_900_000_000
+    )
+
+    assert_response :success
+    subscription.reload
+    assert_equal "unlimited_plus", subscription.plan_key
+    assert_equal "past_due", subscription.status
+    assert_equal Time.zone.at(1_900_000_000), subscription.current_period_end
+  end
+
+  test "subscription deletion returns the account to free while retaining its Stripe customer" do
+    post_event "customer.subscription.created", subscription_payload
+    post_event "customer.subscription.deleted", subscription_payload(status: "canceled")
+
+    assert_response :success
+    assert_equal "canceled", @account.reload.subscription.status
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal "cus_webhook", @account.subscription.stripe_customer_id
+  end
+
+  test "irrelevant signed events are accepted" do
+    post_event "invoice.paid", { id: "in_123" }
+
+    assert_response :success
+    assert_nil @account.reload.subscription
+  end
+
+  test "invalid signatures are rejected" do
+    payload = event_payload("customer.subscription.created", subscription_payload).to_json
+
+    untenanted do
+      post "/stripe/webhooks",
+        params: payload,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "invalid" }
+    end
+
+    assert_response :bad_request
+    assert_nil @account.reload.subscription
+  end
+
+  private
+    def post_event(type, object)
+      payload = event_payload(type, object).to_json
+      timestamp = Time.current
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, WEBHOOK_SECRET)
+      signature_header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      untenanted do
+        post "/stripe/webhooks",
+          params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => signature_header }
+      end
+    end
+
+    def event_payload(type, object)
+      {
+        id: "evt_#{SecureRandom.hex(6)}",
+        object: "event",
+        type: type,
+        data: { object: object }
+      }
+    end
+
+    def subscription_payload(status: "active", price_id: "price_unlimited", current_period_end: 1_800_000_000)
+      {
+        id: "sub_webhook",
+        object: "subscription",
+        customer: "cus_webhook",
+        status: status,
+        current_period_end: current_period_end,
+        cancel_at: nil,
+        metadata: { account_id: @account.id, plan_key: "unlimited" },
+        items: { data: [ { price: { id: price_id } } ] }
+      }
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..1177da6
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.subscription&.destroy!
+    @account.overridden_limits&.destroy!
+    @account.billing_waiver&.destroy!
+    @account.reload
+  end
+
+  test "free plan allowances and card countdown" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 0, @account.billing_plan.monthly_price_in_cents
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+
+    @account.update_column(:cards_count, 900)
+    assert_equal 100, @account.cards_remaining
+    assert @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert_equal 50, @account.cards_remaining
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.card_limit_reached?
+  end
+
+  test "active paid plans have unlimited cards and their own storage allowance" do
+    create_subscription(plan_key: "unlimited")
+
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_equal 2_000, @account.billing_plan.monthly_price_in_cents
+    assert_nil @account.card_limit
+    assert_nil @account.cards_remaining
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.subscription.update!(plan_key: "unlimited_plus")
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_equal 2_500, @account.billing_plan.monthly_price_in_cents
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "inactive subscriptions fall back to free" do
+    create_subscription(plan_key: "unlimited", status: "canceled")
+
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp grants the standard unlimited plan" do
+    @account.create_billing_waiver!
+
+    assert @account.comped?
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "support overrides measured usage and can reset it" do
+    @account.update_column(:cards_count, 12)
+    @account.stubs(:actual_bytes_used).returns(34)
+    @account.create_overridden_limits!(card_count: 950, bytes_used: 1234)
+
+    assert_equal 950, @account.card_count
+    assert_equal 50, @account.cards_remaining
+    assert_equal 1234, @account.bytes_used
+
+    @account.overridden_limits.destroy!
+    @account.reload
+    assert_equal 12, @account.card_count
+    assert_equal 34, @account.bytes_used
+  end
+
+  test "card warning starts exactly one hundred cards out" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update_column(:cards_count, 999)
+    assert_equal 1, @account.cards_remaining
+    assert_not @account.card_limit_reached?
+  end
+
+  test "zero usage overrides are honored and negative usage is rejected" do
+    override = @account.build_overridden_limits(card_count: 0, bytes_used: 0)
+    override.save!
+
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    override.assign_attributes(card_count: -1, bytes_used: -1)
+    assert_not override.valid?
+    assert override.errors.added?(:card_count, :greater_than_or_equal_to, value: -1, count: 0)
+    assert override.errors.added?(:bytes_used, :greater_than_or_equal_to, value: -1, count: 0)
+  end
+
+  test "canceling an account cancels its active Stripe subscription" do
+    subscription = create_subscription(plan_key: "unlimited")
+    Stripe::Subscription.expects(:cancel).with(subscription.stripe_subscription_id)
+
+    @account.cancel(initiated_by: users(:mike))
+
+    assert @account.cancelled?
+  end
+
+  test "canceling an account does not recancel an inactive Stripe subscription" do
+    create_subscription(plan_key: "unlimited", status: "canceled")
+    Stripe::Subscription.expects(:cancel).never
+
+    @account.cancel(initiated_by: users(:mike))
+
+    assert @account.cancelled?
+  end
+
+  private
+    def create_subscription(plan_key:, status: "active")
+      @account.create_subscription!(
+        plan_key: plan_key,
+        stripe_customer_id: "cus_billable_test",
+        stripe_subscription_id: "sub_billable_test",
+        status: status
+      )
+    end
+end
diff --git a/script/test-billing b/script/test-billing
