diff --git a/saas/app/controllers/stripe/checkouts_controller.rb b/saas/app/controllers/stripe/checkouts_controller.rb
new file mode 100644
index 0000000..c458a8d
--- /dev/null
+++ b/saas/app/controllers/stripe/checkouts_controller.rb
@@ -0,0 +1,49 @@
+class Stripe::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if Current.account.subscribed?
+      redirect_to main_app.account_settings_path(script_name: Current.account.slug, anchor: "billing"),
+        alert: "Manage billing to change your current plan."
+    elsif plan = paid_plan
+      session = Stripe::Checkout::Session.create(checkout_parameters(plan))
+      redirect_to session.url, allow_other_host: true
+    else
+      head :unprocessable_content
+    end
+  end
+
+  private
+    def paid_plan
+      Account::Plan.find(params.expect(:plan)).presence_in(Account::Plan.paid)
+    rescue KeyError
+      nil
+    end
+
+    def checkout_parameters(plan)
+      {
+        mode: "subscription",
+        line_items: [ { price: stripe_price_id_for(plan), quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        subscription_data: { metadata: account_metadata.merge(plan_key: plan.key) },
+        success_url: main_app.account_settings_url(script_name: Current.account.slug, billing: "success", anchor: "billing"),
+        cancel_url: main_app.account_settings_url(script_name: Current.account.slug, anchor: "billing")
+      }.merge(checkout_customer_parameters)
+    end
+
+    def stripe_price_id_for(plan)
+      plan.stripe_price_id.presence || raise(KeyError, "#{plan.name} Stripe price is not configured")
+    end
+
+    def checkout_customer_parameters
+      if stripe_customer_id = Current.account.subscription&.stripe_customer_id
+        { customer: stripe_customer_id }
+      else
+        { customer_email: Current.account.owner_email || Current.identity.email_address }
+      end
+    end
+
+    def account_metadata
+      { account_id: Current.account.id, external_account_id: Current.account.external_account_id.to_s }
+    end
+end
diff --git a/saas/app/controllers/stripe/customer_portals_controller.rb b/saas/app/controllers/stripe/customer_portals_controller.rb
