--- /dev/null
+++ b/script/test-billing
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+tests=(
+  saas/test/models/account/billable_test.rb
+  saas/test/controllers/card/billing_limited_test.rb
+  saas/test/controllers/account/settings/billing_test.rb
+  saas/test/controllers/stripe/webhooks_controller_test.rb
+  saas/test/controllers/stripe/checkouts_controller_test.rb
+  saas/test/controllers/stripe/customer_portals_controller_test.rb
+  saas/test/controllers/admin/accounts_controller_test.rb
+)
+existing_tests=()
+for test in "${tests[@]}"; do
+  if [[ -f "$test" ]]; then
+    existing_tests+=("$test")
+  fi
+done
+
+SAAS=true DATABASE_ADAPTER=sqlite CI_PROGRESS_BAR=false bin/rails test "${existing_tests[@]}"
