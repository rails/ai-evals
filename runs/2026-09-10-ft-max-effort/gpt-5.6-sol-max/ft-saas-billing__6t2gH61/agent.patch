diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..d94d416
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,102 @@
+class Account::Plan
+  attr_reader :key, :name, :monthly_price_in_cents, :card_limit, :storage_limit, :stripe_price_environment_key
+
+  def self.find(key)
+    plans.fetch(normalize_key(key))
+  end
+
+  def self.find_by_stripe_price_id(price_id)
+    paid.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id.to_s }
+  end
+
+  def self.all
+    plans.values
+  end
+
+  def self.paid
+    all.reject(&:free?)
+  end
+
+  def self.free
+    find(:free)
+  end
+
+  def self.unlimited
+    find(:unlimited)
+  end
+
+  def self.unlimited_plus
+    find(:unlimited_plus)
+  end
+
+  def initialize(key:, name:, monthly_price_in_cents:, card_limit:, storage_limit:, stripe_price_environment_key: nil)
+    @key = key.to_s
+    @name = name
+    @monthly_price_in_cents = monthly_price_in_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_environment_key = stripe_price_environment_key
+    freeze
+  end
+
+  def free?
+    key == "free"
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def monthly_price
+    monthly_price_in_cents / 100
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_environment_key] if stripe_price_environment_key
+  end
+
+  def to_param
+    key
+  end
+
+  class << self
+    private
+      def plans
+        @plans ||= [
+          new(key: :free, name: "Free", monthly_price_in_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte),
+          new(
+            key: :unlimited,
+            name: "Unlimited",
+            monthly_price_in_cents: 2_000,
+            card_limit: nil,
+            storage_limit: 5.gigabytes,
+            stripe_price_environment_key: "STRIPE_MONTHLY_V1_PRICE_ID"
+          ),
+          new(
+            key: :unlimited_plus,
+            name: "Unlimited+",
+            monthly_price_in_cents: 2_500,
+            card_limit: nil,
+            storage_limit: 500.gigabytes,
+            stripe_price_environment_key: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+          )
+        ].index_by(&:key).freeze
+      end
+
+      def normalize_key(key)
+        {
+          "free_v1" => "free",
+          "freev1" => "free",
+          "monthly_v1" => "unlimited",
+          "monthlyv1" => "unlimited",
+          "monthly_extra_storage_v1" => "unlimited_plus",
+          "monthlyextrastoragev1" => "unlimited_plus",
+          "unlimited+" => "unlimited_plus"
+        }.fetch(key.to_s.downcase, key.to_s.downcase)
+      end
+  end
+end
