@@ -0,0 +1,62 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+        <div class="txt-small txt-ink-medium">#<%= @account.external_account_id %></div>
+      </header>
+
+      <dl class="margin-block-start">
+        <dt class="txt-small txt-ink-medium">Plan</dt>
+        <dd><strong><%= @account.billing_plan.name %></strong><%= " (comped)" if @account.comped? %></dd>
+        <dt class="txt-small txt-ink-medium margin-block-start-half">Card count</dt>
+        <dd><%= number_with_delimiter(@account.card_count) %></dd>
+        <dt class="txt-small txt-ink-medium margin-block-start-half">Bytes used</dt>
+        <dd><%= number_with_delimiter(@account.bytes_used) %></dd>
+      </dl>
+
+      <div class="margin-block-start">
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+        <% else %>
+          <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn btn--reversed" %>
+        <% end %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage override</h2>
+      </header>
+
+      <%= form_with url: saas.admin_account_overridden_limits_path(@account), scope: :overridden_limits,
+            class: "flex flex-column gap margin-block-start" do |form| %>
+        <div class="flex flex-column gap-half txt-align-start">
+          <%= form.label :card_count, "Card count", class: "txt-small" %>
+          <%= form.number_field :card_count, value: @account.overridden_limits&.card_count,
+                min: 0, class: "input", placeholder: @account.cards_count %>
+        </div>
+        <div class="flex flex-column gap-half txt-align-start">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small" %>
+          <%= form.number_field :bytes_used, value: @account.overridden_limits&.bytes_used,
+                min: 0, class: "input", placeholder: @account.actual_bytes_used %>
+        </div>
+        <%= form.button "Override", class: "btn btn--reversed" %>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+  </div>
+
+  <div><%= link_to "← All accounts", saas.admin_accounts_path, class: "txt-link" %></div>
+</section>
