+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,21 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    Account::Subscription.apply_stripe_event(verified_event)
+    head :no_content
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def verified_event
+      Stripe::Webhook.construct_event(
+        request.raw_post,
+        request.headers["Stripe-Signature"],
+        ENV.fetch("STRIPE_WEBHOOK_SECRET")
+      )
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..a49f24c
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,92 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_active_subscription
+  end
+
+  def billing_plan
+    if active_subscription
+      active_subscription.plan
+    elsif comped?
+      Account::Plan.unlimited
+    else
+      Account::Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def paid?
+    subscribed? || comped?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards_count
+  end
+  alias_method :cards_used, :card_count
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - card_count, 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    card_limit.present? && card_count >= card_limit
+  end
+  alias_method :exceeding_card_limit?, :card_limit_reached?
+
+  def nearing_card_limit?
+    cards_remaining.present? && cards_remaining.between?(1, CARD_LIMIT_WARNING_THRESHOLD)
+  end
+
+  def bytes_used
+    if overridden_limits&.bytes_used
+      overridden_limits.bytes_used
+    else
+      actual_bytes_used
+    end
+  end
+
+  def actual_bytes_used
+    Storage::Totaled.instance_method(:bytes_used).bind_call(self)
+  end
+
+  def limits_reached?
+    card_limit_reached? || exceeding_storage_limit?
+  end
+
+  private
+    def cancel_active_subscription
+      active_subscription&.cancel
+    end
+end
