+require "test_helper"
+
+class Card::BillingLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.subscription&.destroy!
+    @account.billing_waiver&.destroy!
+    @account.overridden_limits&.destroy!
+    @account.update_column(:cards_count, 1_000)
+  end
