diff --git a/saas/test/controllers/account/settings/billing_test.rb b/saas/test/controllers/account/settings/billing_test.rb
new file mode 100644
index 0000000..6721447
--- /dev/null
+++ b/saas/test/controllers/account/settings/billing_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class AccountSettingsBillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @account.subscription&.destroy!
+    @account.billing_waiver&.destroy!
+  end
+
+  test "account admins see their plan and approved upgrade choices" do
+    sign_in_as :kevin
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#billing", count: 1
+    assert_match(/Plan/, response.body)
+    assert_match(/Free/, response.body)
+    assert_match(/1,000 cards/, response.body)
+    assert_match(/1 GB/, response.body)
+    assert_match(/Unlimited/, response.body)
+    assert_match(/\$20\/month/, response.body)
+    assert_match(/5 GB/, response.body)
+    assert_match(/Unlimited\+/, response.body)
+    assert_match(/\$25\/month/, response.body)
+    assert_match(/500 GB/, response.body)
+    assert_select "#billing button", text: "Upgrade to Unlimited"
+    assert_select "#billing button", text: "Upgrade to Unlimited+"
+    assert_select "form[action='#{saas.stripe_checkout_path(script_name: @account.slug)}']", count: 2
+  end
+
+  test "paid account admins can open customer portal" do
+    @account.create_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_settings",
+      stripe_subscription_id: "sub_settings",
+      status: "active"
+    )
+    sign_in_as :kevin
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#billing", text: /Unlimited/
+    assert_select "#billing button", text: "Manage billing"
+    assert_select "form[action='#{saas.stripe_customer_portal_path(script_name: @account.slug)}']", count: 1
+  end
+
+  test "members do not see billing controls" do
+    sign_in_as :david
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#billing", count: 0
+    assert_select "button", text: /Upgrade/, count: 0
+  end
+end
