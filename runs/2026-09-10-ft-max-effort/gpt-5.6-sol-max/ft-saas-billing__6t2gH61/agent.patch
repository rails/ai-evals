@@ -0,0 +1,42 @@
+<div id="billing" class="settings__panel panel shadow center">
+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Plan</h2>
+      <div class="txt-large"><strong><%= account.billing_plan.name %></strong></div>
+      <% if account.comped? %>
+        <div class="txt-small txt-ink-medium">Complimentary</div>
+      <% elsif account.billing_plan.free? %>
+        <div class="txt-small">1,000 cards and <%= number_to_human_size(account.storage_limit) %> storage</div>
+      <% else %>
+        <div class="txt-small">Unlimited cards and <%= number_to_human_size(account.storage_limit) %> storage</div>
+      <% end %>
+    </header>
+
+    <% if account.billing_plan.free? %>
+      <div class="margin-block-start">
+        <h3 class="txt-medium">Upgrade</h3>
+        <div class="flex flex-column gap margin-block-start-half">
+          <% Account::Plan.paid.each do |plan| %>
+            <div class="panel">
+              <div class="flex align-center justify-space-between gap">
+                <div class="txt-align-start">
+                  <strong><%= plan.name %></strong>
+                  <div><strong>$<%= plan.monthly_price %>/month</strong></div>
+                  <div class="txt-small txt-ink-medium">
+                    Unlimited cards and <%= number_to_human_size(plan.storage_limit) %> storage
+                  </div>
+                </div>
+                <%= button_to "Upgrade to #{plan.name}", saas.stripe_checkout_path(script_name: account.slug),
+                      params: { plan: plan.key }, class: "btn btn--reversed" %>
+              </div>
+            </div>
+          <% end %>
+        </div>
+      </div>
