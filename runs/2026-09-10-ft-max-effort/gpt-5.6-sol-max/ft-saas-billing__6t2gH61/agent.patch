+        parameters.dig(:subscription_data, :metadata, :account_id) == @account.id &&
+        parameters[:customer_email] == identities(:mike).email_address &&
+        parameters[:success_url].include?(@account.slug) &&
+        parameters[:cancel_url].include?(@account.slug)
+    end.returns(Struct.new(:url).new("https://checkout.stripe.test/session"))
+
+    post saas.stripe_checkout_path(script_name: @account.slug), params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  end
+
+  test "Unlimited+ checkout uses the extra storage price" do
+    Stripe::Checkout::Session.expects(:create).with do |parameters|
+      parameters[:line_items] == [ { price: "price_unlimited_plus", quantity: 1 } ] &&
+        parameters.dig(:subscription_data, :metadata, :plan_key) == "unlimited_plus"
+    end.returns(Struct.new(:url).new("https://checkout.stripe.test/plus"))
+
+    post saas.stripe_checkout_path(script_name: @account.slug), params: { plan: "unlimited_plus" }
+
+    assert_redirected_to "https://checkout.stripe.test/plus"
+  end
+
+  test "active subscribers are sent back to manage billing instead of creating a duplicate" do
+    @account.create_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_current",
+      stripe_subscription_id: "sub_current",
+      status: "active"
+    )
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.stripe_checkout_path(script_name: @account.slug), params: { plan: "unlimited_plus" }
+
+    assert_redirected_to account_settings_path(script_name: @account.slug, anchor: "billing")
+    assert_equal "Manage billing to change your current plan.", flash[:alert]
+  end
+
+  test "members cannot start checkout" do
+    logout_and_sign_in_as :david
+
+    post saas.stripe_checkout_path(script_name: accounts(:"37s").slug), params: { plan: "unlimited" }
+
+    assert_response :forbidden
+  end
