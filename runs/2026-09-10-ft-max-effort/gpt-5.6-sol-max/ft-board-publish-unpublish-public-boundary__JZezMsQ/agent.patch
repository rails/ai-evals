@@ -0,0 +1,51 @@
+<%= card_article_tag card, class: "card", tabindex: 0 do %>
+  <div class="flex flex-column flex-item-grow max-inline-size">
+    <%= link_to public_board_card_path(publication.key, card.number), class: "card__link", title: card_title_tag(card) do %>
+      <span class="for-screen-reader"><%= card.title %></span>
+    <% end %>
+
+    <header class="card__header">
+      <div class="card__board">
+        <div class="card__id">
+          <span class="for-screen-reader">Card number</span>
+          <%= card.number %>
+        </div>
+        <div class="card__board-name overflow-ellipsis"><%= card.board.name %></div>
+      </div>
+
+      <%= render "cards/display/preview/tags", card: card %>
+      <%= render "cards/display/preview/steps", card: card %>
+      <%= icon_tag "attachment", class: "card__attachments-indicator translucent" if card.has_attachments? %>
+    </header>
+
+    <div class="card__body justify-space-between">
+      <div class="card__content">
+        <h3 class="card__title overflow-line-clamp"><%= card_html_title(card) %></h3>
+      </div>
+
+      <%= render "cards/display/common/stamp", card: card %>
+    </div>
+  </div>
+
+  <footer class="card__footer flex gap-half">
+    <div class="card__meta">
+      <div class="card__meta-avatars card__meta-avatars--author">
+        <%= avatar_preview_tag card.creator, hidden_for_screen_reader: true %>
+      </div>
+      <span class="card__meta-text card__meta-text--added">
+        Added <%= local_datetime_tag(card.created_at, style: :daysago) %>
+      </span>
+      <span class="card__meta-text card__meta-text--author"><%= card.creator.familiar_name %></span>
+      <% if card.assignees.any? %>
+        <span class="card__meta-text card__meta-text--assignees overflow-ellipsis">
+          <%= icon_tag "arrow-right", aria: { label: "Assigned to" } %>
+          <%= safe_join card.assignees.map { |assignee| h assignee.familiar_name }, " / " %>
+        </span>
+      <% end %>
+    </div>
+
+    <% if card.image.present? %>
+      <div class="card__background"><%= image_tag card.image, size: 120 %></div>
+    <% end %>
+  </footer>
+<% end %>
