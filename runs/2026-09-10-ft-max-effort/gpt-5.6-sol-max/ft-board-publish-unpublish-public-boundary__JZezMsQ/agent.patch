+require "test_helper"
+
+class Public::Boards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @column = columns(:writebook_triage)
+  end
+
+  test "show is publicly accessible and only displays published cards" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:kevin), column: @column)
+
+    untenanted do
+      get public_board_column_path(@board.publication.key, @column)
+
+      assert_response :success
+      assert_select "h3", text: cards(:logo).title
+      assert_not_includes response.body, draft.title
+    end
+  end
+
+  test "show scopes the column to the published board" do
+    other_column = columns(:writebook_in_progress)
+    other_column.update_column :board_id, boards(:private).id
+
+    untenanted do
+      get public_board_column_path(@board.publication.key, other_column)
+      assert_response :not_found
+    end
+  ensure
+    other_column&.update_column :board_id, @board.id
+  end
+end
