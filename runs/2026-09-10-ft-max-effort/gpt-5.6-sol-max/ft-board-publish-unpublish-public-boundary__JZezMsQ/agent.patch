+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show is publicly accessible without an account or session" do
+    untenanted do
+      get public_board_path(@board.publication.key)
+
+      assert_response :success
+      assert_select "h1", text: @board.name
+      assert_select "h3", text: cards(:logo).title
+      assert_no_match(/action=["'][^"']*(?:closure|not_now|assignment|tagging)/, response.body)
+    end
+  end
+
+  test "show rejects an invalid publication key" do
+    untenanted do
+      get public_board_path("not-a-real-key")
+      assert_response :not_found
+    end
+  end
+
+  test "show rejects a board from a cancelled account" do
+    @board.account.cancel(initiated_by: users(:jason))
+
+    untenanted do
+      get public_board_path(@board.publication.key)
+      assert_response :not_found
+    end
+  end
+
+  test "show rejects a tenanted public URL" do
+    get public_board_path(@board.publication.key)
+    assert_response :redirect
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..eef4d88
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are private by default" do
+    assert_not @board.published?
+  end
+
+  test "publish creates one publication with an unguessable unique key" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert_operator @board.publication.key.length, :>=, 20
+    assert_not_equal @board.publication.key, boards(:private).tap(&:publish).publication.key
+  end
+
+  test "published scope only includes published boards" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_includes Board.published, @board
+    assert_not_includes Board.published, boards(:private)
+  end
+
+  test "unpublish removes the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+  end
+
+  test "destroying a board destroys its publication" do
+    publication = @board.publish
+
+    @board.destroy
+
+    assert_not Board::Publication.exists?(publication.id)
+  end
+
+  test "a board can be republished with a new key" do
+    old_key = @board.publish.key
+    @board.unpublish
+
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert_not_equal old_key, @board.publication.key
+  end
+end
