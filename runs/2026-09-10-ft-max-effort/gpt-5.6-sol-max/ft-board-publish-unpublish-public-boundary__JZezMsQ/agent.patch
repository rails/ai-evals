@@ -0,0 +1,25 @@
+<div class="margin-block-end">
+  <h2 class="divider txt-large">Public access</h2>
+  <p>Publish this board to let anyone with its secret public link view its columns and published cards.</p>
+
+  <% if board.published? %>
+    <% public_url = public_board_url(board.publication.key, script_name: nil) %>
+    <div class="flex align-center gap-half margin-block-end">
+      <%= text_field_tag :public_url, public_url, readonly: true, class: "input full-width", aria: { label: "Public board URL" } %>
+      <%= button_to_copy_to_clipboard(public_url) do %>
+        <%= icon_tag "clipboard" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <%= button_to "Stop publishing", board_publication_path(board), method: :delete,
+          class: "btn txt-negative", disabled: !Current.user.admin?,
+          form: { data: { turbo_confirm: "Stop publishing this board? Its public link will no longer work." } } %>
+  <% else %>
+    <%= button_to "Publish board", board_publication_path(board), class: "btn btn--reversed", disabled: !Current.user.admin? %>
+  <% end %>
+
+  <% unless Current.user.admin? %>
+    <p class="txt-small">Only account admins can change public access.</p>
+  <% end %>
+</div>
