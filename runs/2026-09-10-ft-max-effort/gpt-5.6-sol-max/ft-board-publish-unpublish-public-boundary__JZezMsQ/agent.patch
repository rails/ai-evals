diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..d2877ea
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "create publishes a board" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    public_url = public_board_url(@board.reload.publication.key, script_name: nil)
+    assert_match %r{\Ahttp://www\.example\.com/public/boards/[^/]+\z}, public_url
+  end
+
+  test "create as JSON publishes a board" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.publication.key, script_name: nil), response.parsed_body.fetch("public_url")
+  end
+
+  test "create is idempotent" do
+    @board.publish
+    original_key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+
+    assert_equal original_key, @board.reload.publication.key
+  end
+
+  test "destroy unpublishes a board and revokes its URL" do
+    @board.publish
+    public_url = public_board_url(@board.publication.key, script_name: nil)
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+
+    untenanted do
+      get public_url
+      assert_response :not_found
+    end
+  end
+
+  test "destroy as JSON unpublishes a board" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "only account admins can publish" do
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "only account admins can unpublish" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      delete board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "published board settings show the public URL and unpublish control" do
+    @board.publish
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_select "input[name=public_url][readonly][value=?]", public_board_url(@board.publication.key, script_name: nil)
+    assert_select "form[action=?]", board_publication_path(@board) do
+      assert_select "input[name=_method][value=delete]"
+    end
+  end
+
+  test "a member who created the board cannot publish" do
+    member = users(:jz)
+    board = Board.create!(name: "Member board", creator: member, account: member.account)
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { board.reload.published? } do
+      post board_publication_path(board)
+    end
+
+    assert_response :forbidden
+  end
+end
