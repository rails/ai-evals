+  <div class="cards__transition-container">
+    <header class="cards__header">
+      <h2 class="cards__title txt-uppercase overflow-ellipsis"><%= name %></h2>
+      <span class="txt-small"><%= cards.size %></span>
+
+      <% if column %>
+        <%= link_to public_board_column_path(publication.key, column), class: "cards__maximize-button btn btn--circle txt-x-small borderless" do %>
+          <%= icon_tag "grid", class: "translucent" %>
+          <span class="for-screen-reader">Open <%= column.name %></span>
+        <% end %>
+      <% end %>
+    </header>
+
+    <div class="cards__list hide-scrollbar">
+      <% if cards.any? %>
+        <%= render partial: "public/boards/card", collection: cards, as: :card, locals: { publication: publication } %>
+      <% else %>
+        <%= render "boards/columns/empty_placeholder" %>
+      <% end %>
+    </div>
+  </div>
+</section>
