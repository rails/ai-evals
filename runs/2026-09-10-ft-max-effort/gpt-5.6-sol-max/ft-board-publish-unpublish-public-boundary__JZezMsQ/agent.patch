@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show opens a published card by its account number" do
+    card = cards(:logo)
+
+    untenanted do
+      get public_board_card_path(@board.publication.key, card.number)
+
+      assert_response :success
+      assert_select "h1", text: card.title
+      assert_includes response.body, @board.name
+    end
+  end
+
+  test "show does not expose drafts" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:kevin))
+
+    untenanted do
+      get public_board_card_path(@board.publication.key, draft.number)
+      assert_response :not_found
+    end
+  end
+
+  test "show scopes the card to the published board" do
+    other_card = boards(:private).cards.create!(title: "Other board", creator: users(:kevin))
+    other_card.update_column :status, "published"
+
+    untenanted do
+      get public_board_card_path(@board.publication.key, other_card.number)
+      assert_response :not_found
+    end
+  end
+end
