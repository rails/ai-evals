index 0000000..6f085ac
--- /dev/null
+++ b/app/controllers/public/boards_controller.rb
@@ -0,0 +1,12 @@
+class Public::BoardsController < Public::ApplicationController
+  def show
+    @cards = @board.cards.published.latest.preloaded.to_a
+    @active_cards = @cards.select(&:active?)
+    @cards_by_column = @active_cards.group_by(&:column_id)
+    @maybe_cards = @cards_by_column[nil] || []
+    @postponed_cards = @cards.select(&:postponed?)
+    @closed_cards = @cards.select(&:closed?)
+
+    fresh_when etag: [ @board, @cards ], public: true
+  end
+end
