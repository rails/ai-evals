+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <%= tag.meta property: "og:title", content: "#{@card.title} | #{@board.name}" %>
+  <%= tag.meta property: "og:description", content: format_excerpt(@card.description, length: 200) %>
+  <%= tag.meta property: "og:url", content: public_board_card_url(@publication.key, @card.number) %>
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@publication.key), class: "btn btn--back btn--circle-mobile" do %>
+      <%= icon_tag "arrow-left" %>
+      <strong class="overflow-ellipsis">Back to <%= @board.name %></strong>
+    <% end %>
+  </div>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <header class="card__header">
+        <div class="card__board">
+          <div class="card__id"><span class="for-screen-reader">Card number</span><%= @card.number %></div>
+          <div class="card__board-name overflow-ellipsis"><%= @board.name %></div>
+        </div>
+        <%= render "cards/display/preview/tags", card: @card %>
+      </header>
+
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title flex align-start gap-half"><%= card_html_title(@card) %></h1>
+
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= @card.description %>
+            </div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ol class="steps txt-small margin-block-start-auto">
+              <% @card.steps.each do |step| %>
+                <li class="step">
+                  <%= check_box_tag nil, nil, step.completed?, class: "checkbox", disabled: true %>
+                  <span class="step__content"><%= step.content %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        </div>
+
+        <%= render "cards/display/common/stamp", card: @card %>
+      </div>
+
+      <footer class="card__footer flex gap-half">
+        <div class="card__meta">
+          <div class="card__meta-avatars card__meta-avatars--author">
+            <%= avatar_preview_tag @card.creator, hidden_for_screen_reader: true %>
+          </div>
+          <span class="card__meta-text card__meta-text--added">Added <%= local_datetime_tag(@card.created_at, style: :daysago) %></span>
+          <span class="card__meta-text card__meta-text--author"><%= @card.creator.familiar_name %></span>
+          <% if @card.assignees.any? %>
+            <span class="card__meta-text card__meta-text--assignees overflow-ellipsis">
+              Assigned to <%= safe_join @card.assignees.map { |assignee| h assignee.familiar_name }, " / " %>
+            </span>
+          <% end %>
+        </div>
+
+        <% if @card.image.present? %>
+          <div class="card__background"><%= image_tag @card.image %></div>
+        <% end %>
+      </footer>
+    <% end %>
+  </div>
+</section>
+
+<% if @comments.any? %>
+  <section class="messages">
+    <% @comments.each do |comment| %>
+      <article class="message panel shadow">
+        <header class="flex align-center gap-half">
+          <%= avatar_preview_tag comment.creator, hidden_for_screen_reader: true %>
+          <strong><%= comment.creator.name %></strong>
+          <%= local_datetime_tag comment.created_at, style: :datetime %>
+        </header>
+        <div class="lexxy-content txt-align-start"><%= comment.body %></div>
+      </article>
+    <% end %>
+  </section>
+<% end %>
