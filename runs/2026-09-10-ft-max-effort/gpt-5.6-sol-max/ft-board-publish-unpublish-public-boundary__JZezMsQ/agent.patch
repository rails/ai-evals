new file mode 100644
index 0000000..a4ce7e4
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,23 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board is no longer public" }
+      format.json { head :no_content }
+    end
+  end
+end
