diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..500c2c4
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,173 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+
+  initialize() {
+    this.mediaQuery = window.matchMedia("(min-width: 640px)")
+    this.updateDraggableItems = this.#updateDraggableItems.bind(this)
+  }
+
+  connect() {
+    this.mediaQuery.addEventListener("change", this.updateDraggableItems)
+    this.#updateDraggableItems()
+  }
+
+  disconnect() {
+    this.mediaQuery.removeEventListener("change", this.updateDraggableItems)
+    this.itemTargets.forEach(item => item.draggable = false)
+    this.#clearDragState()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.mediaQuery.matches
+  }
+
+  dragStart(event) {
+    this.draggedItem = event.target.closest(this.#itemSelector)
+
+    if (this.draggedItem) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", this.draggedItem.id)
+      this.draggedItem.classList.add(this.draggedItemClass)
+    }
+  }
+
+  dragEnter(event) {
+    if (this.draggedItem) {
+      this.#hover(event.target.closest(this.#containerSelector))
+    }
+  }
+
+  dragOver(event) {
+    if (this.draggedItem) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (this.hoveredContainer && !this.hoveredContainer.contains(event.relatedTarget)) {
+      this.#clearHoveredContainer()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+
+    const card = this.draggedItem
+    const destination = event.target.closest(this.#containerSelector)
+    const source = card.closest(this.#containerSelector)
+
+    if (destination && destination !== source && this.#listIn(destination)) {
+      const originalPosition = { parent: card.parentElement, nextSibling: card.nextElementSibling }
+      const moveId = card.dragAndDropMoveId = Symbol()
+
+      this.#moveCardTo(card, destination)
+      this.#saveCardIn(card, destination).then(response => {
+        if (!response.ok && card.dragAndDropMoveId === moveId) {
+          this.#restoreCardTo(card, originalPosition)
+        }
+      }).catch(() => {
+        if (card.dragAndDropMoveId === moveId) {
+          this.#restoreCardTo(card, originalPosition)
+        }
+      })
+    }
+
+    this.#clearDragState()
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+  }
+
+  // Private
+
+  #updateDraggableItems() {
+    this.itemTargets.forEach(item => item.draggable = this.mediaQuery.matches)
+  }
+
+  #hover(container) {
+    if (container !== this.hoveredContainer) {
+      this.#clearHoveredContainer()
+      this.hoveredContainer = container
+      this.hoveredContainer?.classList.add(this.hoverContainerClass)
+    }
+  }
+
+  #moveCardTo(card, container) {
+    const list = this.#listIn(container)
+    const cards = [ ...list.querySelectorAll(this.#itemSelector) ].filter(item => item !== card)
+
+    // A status change makes the card newest, but active lists still keep golden cards first.
+    if (container.dataset.dragAndDropGoldenCardsFirst === "true" && !card.classList.contains("golden-effect")) {
+      const firstCardAfterGoldenCards = cards.find(item => !item.classList.contains("golden-effect"))
+
+      if (firstCardAfterGoldenCards) {
+        firstCardAfterGoldenCards.before(card)
+      } else if (cards.length > 0) {
+        cards.at(-1).after(card)
+      } else {
+        list.prepend(card)
+      }
+    } else if (cards.length > 0) {
+      cards[0].before(card)
+    } else {
+      list.prepend(card)
+    }
+  }
+
+  #saveCardIn(card, container) {
+    const options = { responseKind: "json" }
+
+    switch (container.dataset.dragAndDropStatus) {
+      case "column":
+        return post(card.dataset.cardTriageUrl, {
+          ...options,
+          body: { column_id: container.dataset.dragAndDropColumnId }
+        })
+      case "maybe":
+        return destroy(card.dataset.cardTriageUrl, options)
+      case "not-now":
+        return post(card.dataset.cardNotNowUrl, options)
+      case "closed":
+        return post(card.dataset.cardClosureUrl, options)
+      default:
+        return Promise.reject()
+    }
+  }
+
+  #listIn(container) {
+    return container.querySelector(".cards__list")
+  }
+
+  #restoreCardTo(card, { parent, nextSibling }) {
+    if (parent.isConnected) {
+      parent.insertBefore(card, nextSibling?.parentElement === parent ? nextSibling : null)
+    }
+  }
+
+  #clearDragState() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.#clearHoveredContainer()
+    this.draggedItem = null
+  }
+
+  #clearHoveredContainer() {
+    this.hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.hoveredContainer = null
+  }
+
+  get #containerSelector() {
+    return '[data-drag-and-drop-target~="container"]'
+  }
+
+  get #itemSelector() {
+    return '[data-drag-and-drop-target~="item"]'
+  }
+}
