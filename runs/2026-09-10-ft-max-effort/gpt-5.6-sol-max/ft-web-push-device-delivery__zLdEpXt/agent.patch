--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,28 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    created = @push_subscription.new_record?
+
+    @push_subscription.update!(
+      push_subscription_params.merge(account: Current.account, user_agent: request.user_agent)
+    )
+
+    head created ? :created : :ok
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..484aa17
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,122 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "help", "toggle" ]
+  static values = { publicKey: String, subscriptionsUrl: String }
+
+  connect() {
+    this.#refresh()
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+
+    if (this.toggleTarget.checked) {
+      await this.#subscribe()
+    } else {
+      await this.#unsubscribe()
+    }
+
+    this.#displayState()
+  }
+
+  async #refresh() {
+    this.#displayPermissionHelp()
+
+    if (this.#supported) {
+      try {
+        this.registration = await navigator.serviceWorker.ready
+        this.subscription = await this.registration.pushManager.getSubscription()
+
+        if (this.subscription) {
+          await this.#register(this.subscription)
+        }
+      } catch (error) {
+        console.error("Unable to initialize push notifications", error)
+      }
+    }
+
+    this.#displayState()
+  }
+
+  async #subscribe() {
+    try {
+      this.subscription = await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      await this.#register(this.subscription)
+    } catch (error) {
+      await this.subscription?.unsubscribe()
+      this.subscription = null
+      console.error("Unable to enable push notifications", error)
+    }
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (!response.ok) {
+      throw new Error(`Push subscription registration failed (${response.statusCode})`)
+    }
+  }
+
+  async #unsubscribe() {
+    try {
+      await this.subscription?.unsubscribe()
+      this.subscription = null
+    } catch (error) {
+      console.error("Unable to disable push notifications", error)
+      this.subscription = await this.registration.pushManager.getSubscription()
+    }
+  }
+
+  #displayState() {
+    const enabled = Boolean(this.subscription)
+
+    this.element.classList.toggle("notifications--on", enabled)
+    this.toggleTarget.checked = enabled
+    this.toggleTarget.disabled = !this.#supported || this.#permissionDenied
+    this.#displayPermissionHelp()
+  }
+
+  #displayPermissionHelp() {
+    this.detailsTargets.forEach(details => details.hidden = !this.#permissionDenied)
+
+    if (this.hasHelpTarget) {
+      const visibleHelp = this.helpTarget.querySelector(".notifications-help:not([hidden])")
+      this.helpTarget.hidden = !visibleHelp
+    }
+  }
+
+  get #supported() {
+    return this.publicKeyValue.length > 0 &&
+      "Notification" in window &&
+      "PushManager" in window &&
+      "serviceWorker" in navigator
+  }
+
+  get #permissionDenied() {
+    return "Notification" in window && Notification.permission === "denied"
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const decoded = atob(base64)
+
+    return Uint8Array.from(decoded, character => character.charCodeAt(0))
+  }
+}
