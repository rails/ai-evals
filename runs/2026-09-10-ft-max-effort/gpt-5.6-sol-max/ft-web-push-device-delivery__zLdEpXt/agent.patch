diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..6d3eeaf
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers this browser for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscriptions/123",
+          p256dh_key: "browser-public-key",
+          auth_key: "browser-auth-secret"
+        }
+      }, headers: { "User-Agent" => "Fizzy Test Browser" }, as: :json
+    end
+
+    assert_response :created
+    assert_empty response.body
+
+    subscription = @user.push_subscriptions.find_by!(endpoint: "https://push.example.test/subscriptions/123")
+    assert_equal Current.account, subscription.account
+    assert_equal "browser-public-key", subscription.p256dh_key
+    assert_equal "browser-auth-secret", subscription.auth_key
+    assert_equal "Fizzy Test Browser", subscription.user_agent
+  end
+
+  test "create refreshes an existing browser subscription" do
+    subscription = Push::Subscription.create!(
+      account: @user.account, user: @user,
+      endpoint: "https://push.example.test/subscriptions/123",
+      p256dh_key: "old-public-key", auth_key: "old-auth-secret"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new-public-key",
+          auth_key: "new-auth-secret"
+        }
+      }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal "new-public-key", subscription.reload.p256dh_key
+    assert_equal "new-auth-secret", subscription.auth_key
+  end
+
+  test "rejects a subscription without its encryption keys" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscriptions/incomplete",
+          p256dh_key: "",
+          auth_key: ""
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "rejects a non-HTTPS push endpoint" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "http://push.example.test/subscriptions/insecure",
+          p256dh_key: "browser-public-key",
+          auth_key: "browser-auth-secret"
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "cannot register a subscription for another user" do
+    other_user = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscriptions/other",
+          p256dh_key: "browser-public-key",
+          auth_key: "browser-auth-secret"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
