diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..ee73fae
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @notification = notifications(:layout_commented_kevin)
+    @subscription = Push::Subscription.create!(
+      account: @notification.account,
+      user: @notification.user,
+      endpoint: "https://push.example.test/subscriptions/123",
+      p256dh_key: "browser-public-key",
+      auth_key: "browser-auth-secret"
+    )
+  end
+
+  test "delivers the tray copy with a link to its card using VAPID" do
+    with_env "VAPID_PUBLIC_KEY" => "vapid-public", "VAPID_PRIVATE_KEY" => "vapid-private" do
+      delivered_options = nil
+      WebPush.stubs(:payload_send).with { |options| delivered_options = options }.returns(:delivered)
+
+      assert_equal :delivered, @subscription.deliver(@notification)
+
+      payload = JSON.parse(delivered_options[:message])
+      assert_equal @subscription.endpoint, delivered_options[:endpoint]
+      assert_equal @subscription.p256dh_key, delivered_options[:p256dh]
+      assert_equal @subscription.auth_key, delivered_options[:auth]
+      assert_equal({
+        subject: "http://example.com/",
+        public_key: "vapid-public",
+        private_key: "vapid-private"
+      }, delivered_options[:vapid])
+      assert_equal({
+        "title" => "RE: Layout is broken",
+        "body" => @notification.source.eventable.body.to_plain_text.truncate(200)
+      }, payload.slice("title", "body"))
+      assert_equal "http://example.com#{@notification.account.slug}/cards/#{@notification.card.to_param}", payload["url"]
+    end
+  end
+
+  test "removes a subscription rejected as expired by the push service" do
+    with_env "VAPID_PUBLIC_KEY" => "vapid-public", "VAPID_PRIVATE_KEY" => "vapid-private" do
+      WebPush.stubs(:payload_send).raises(expired_subscription_error)
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "retains a subscription when its push service fails temporarily" do
+    with_env "VAPID_PUBLIC_KEY" => "vapid-public", "VAPID_PRIVATE_KEY" => "vapid-private" do
+      WebPush.stubs(:payload_send).raises(push_service_error)
+
+      assert_no_difference -> { Push::Subscription.count } do
+        assert_raises(WebPush::PushServiceError) do
+          @subscription.deliver(@notification)
+        end
+      end
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { ENV[it] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+
+    def push_service_error
+      web_push_error(Net::HTTPServiceUnavailable, WebPush::PushServiceError, "503", "Unavailable")
+    end
+
+    def expired_subscription_error
+      web_push_error(Net::HTTPGone, WebPush::ExpiredSubscription, "410", "Gone")
+    end
+
+    def web_push_error(response_class, error_class, code, message)
+      response = response_class.new("1.1", code, message)
+      response.instance_variable_set(:@body, "")
+      response.instance_variable_set(:@read, true)
+      error_class.new(response, "push.example.test")
+    end
+end
diff --git a/test/system/notification_settings_test.rb b/test/system/notification_settings_test.rb
new file mode 100644
index 0000000..c3ec71c
--- /dev/null
+++ b/test/system/notification_settings_test.rb
@@ -0,0 +1,50 @@
+require "application_system_test_case"
+
+class NotificationSettingsTest < ApplicationSystemTestCase
+  test "push notifications can be enabled for this browser" do
+    with_vapid_public_key do
+      sign_in_as(users(:david))
+      visit notifications_settings_url
+
+      assert_selector "h2", text: "Push Notifications"
+      assert_selector "input[data-notifications-target=toggle]:not([disabled])", visible: :all, wait: 5
+    end
+  end
+
+  test "shows help when notifications are blocked in the browser" do
+    with_vapid_public_key do
+      sign_in_as(users(:david))
+
+      with_notification_permission("denied") do
+        visit notifications_settings_url
+
+        assert_selector "input[data-notifications-target=toggle][disabled]", visible: :all, wait: 5
+        assert_selector "[data-notifications-target=details]:not([hidden])", text: "Turn on notifications"
+      end
+    end
+  end
+
+  private
+    def with_notification_permission(setting)
+      uri = URI.parse(page.current_url)
+      origin = "#{uri.scheme}://#{uri.host}:#{uri.port}"
+
+      page.driver.browser.execute_cdp(
+        "Browser.setPermission",
+        origin: origin,
+        permission: { name: "notifications" },
+        setting: setting
+      )
+      yield
+    ensure
+      page.driver.browser.execute_cdp("Browser.resetPermissions")
+    end
+
+    def with_vapid_public_key
+      original = ENV["VAPID_PUBLIC_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = WebPush.generate_key.public_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = original
+    end
+end
