diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..8cec6e5 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,37 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  if (event.data) {
+    const { title, body, url } = event.data.json()
+
+    event.waitUntil(self.registration.showNotification(title, {
+      body: body,
+      icon: "/app-icon-192.png",
+      badge: "/app-icon-192-maskable.png",
+      tag: url,
+      data: { url: url }
+    }))
+  }
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openNotificationCard(event.notification.data.url))
+})
+
+async function openNotificationCard(url) {
+  const cardUrl = new URL(url, self.location.origin)
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const cardWindow = windows.find(client => client.url === cardUrl.href)
+
+  if (cardWindow) {
+    return cardWindow.focus()
+  } else if (windows.length > 0 && "navigate" in windows[0]) {
+    const client = await windows[0].navigate(cardUrl.href)
+    return client?.focus()
+  } else {
+    return self.clients.openWindow(cardUrl.href)
+  }
+}
