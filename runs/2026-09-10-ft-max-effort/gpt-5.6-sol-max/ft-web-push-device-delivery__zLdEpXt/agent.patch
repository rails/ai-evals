diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..c551889
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,65 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 700 }, uniqueness: { scope: :user_id }
+  validate :endpoint_must_be_https
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: payload_for(notification),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def endpoint_must_be_https
+      uri = URI.parse(endpoint.to_s)
+      errors.add(:endpoint, "must be an HTTPS URL") unless uri.is_a?(URI::HTTPS) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be an HTTPS URL")
+    end
+
+    def payload_for(notification)
+      renderer.render(
+        template: "push/notifications/show",
+        formats: :json,
+        locals: { notification: notification, url: card_url(notification.card) }
+      )
+    end
+
+    def renderer
+      ApplicationController.renderer
+    end
+
+    def card_url(card)
+      Rails.application.routes.url_helpers.card_url(
+        card,
+        script_name: account.slug,
+        **url_options
+      )
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+
+    def vapid_options
+      {
+        subject: root_url(**url_options),
+        public_key: ENV.fetch("VAPID_PUBLIC_KEY"),
+        private_key: ENV.fetch("VAPID_PRIVATE_KEY")
+      }
+    end
+
+    def root_url(**options)
+      Rails.application.routes.url_helpers.root_url(**options)
+    end
+end
