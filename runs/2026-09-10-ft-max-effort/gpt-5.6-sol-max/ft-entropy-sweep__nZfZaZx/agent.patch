+  test "auto postpone includes cards exactly at their deadline" do
+    freeze_time
+    card = cards(:logo)
+    card.update!(last_active_at: Time.current - card.auto_postpone_period)
+
+    board_scoped_query = /FROM [`"]cards[`"].*[`"]cards[`"]\.[`"]board_id[`"] = .*ORDER BY [`"]cards[`"]\.[`"]last_active_at[`"] ASC, [`"]cards[`"]\.[`"]id[`"] ASC/
+
+    assert_no_queries_match(/FROM [`"]cards[`"] INNER JOIN [`"]boards[`"]/) do
+      assert_queries_match(board_scoped_query) do
+        Card.auto_postpone_all_due
+      end
+    end
+
+    assert card.reload.postponed?
+  end
+
+  test "auto postpone ignores inactive cards past their deadline" do
+    closed_card = cards(:shipping)
+    postponed_card = cards(:layout)
+    drafted_card = cards(:unfinished_thoughts)
+    not_now = postponed_card.create_not_now!(user: users(:david))
+
+    [ closed_card, postponed_card, drafted_card ].each do |card|
+      card.update!(last_active_at: 1.year.ago)
+    end
+
+    assert_no_difference -> { Event.where(action: "card_auto_postponed").count } do
+      Card.auto_postpone_all_due
+    end
+
+    assert_nil closed_card.reload.not_now
+    assert_equal not_now, postponed_card.reload.not_now
+    assert drafted_card.reload.drafted?
+  end
+
