diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..4a09a71
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time sends a canonical timestamp for the browser to format" do
+    timestamp = Time.iso8601("2025-09-12T17:42:00-04:00")
+    original_timestamp = timestamp.dup
+
+    html = local_time(timestamp, format: :time_or_relative_date)
+    element = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+    assert_equal "2025-09-12T21:42:00Z", element["datetime"]
+    assert_equal original_timestamp, timestamp
+    assert_equal "time", element["data-local-time-target"]
+    assert_equal "time-or-relative-date", element["data-local-time-format"]
+    assert_includes element["class"].split, "local-time-value"
+    assert_predicate element.text, :blank?
+  end
+
+  test "local time markup does not depend on the server time zone" do
+    timestamp = Time.iso8601("2025-09-12T21:42:00Z")
+
+    eastern_html = Time.use_zone("America/New_York") { local_time(timestamp) }
+    pacific_html = Time.use_zone("America/Los_Angeles") { local_time(timestamp) }
+
+    assert_equal eastern_html, pacific_html
+  end
+
+  test "local time preserves additional HTML options" do
+    html = local_time(
+      Time.iso8601("2025-09-12T21:42:00Z"),
+      format: :weekday_date,
+      class: "txt-small",
+      data: { test_id: "created-at" }
+    )
+    element = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+    assert_equal %w[ local-time-value txt-small ], element["class"].split.sort
+    assert_equal "created-at", element["data-test-id"]
+    assert_equal "weekday-date", element["data-local-time-format"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..5a87dc0
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,51 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders timestamps in the browser time zone" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+    sign_in_as(users(:david))
+
+    old_date = page.evaluate_script <<~JAVASCRIPT
+      (() => {
+        const atDayOffset = (offset, hour = 12, minute = 0) => {
+          const now = new Date()
+          return new Date(now.getFullYear(), now.getMonth(), now.getDate() + offset, hour, minute)
+        }
+        const addTime = (id, date, format = "time-or-relative-date") => {
+          const time = document.createElement("time")
+          time.id = id
+          time.dateTime = date.toISOString()
+          time.dataset.localTimeTarget = "time"
+          time.dataset.localTimeFormat = format
+          document.body.append(time)
+        }
+
+        addTime("local-today", atDayOffset(0, 13, 42))
+        addTime("local-yesterday", atDayOffset(-1))
+        addTime("local-five-days-ago", atDayOffset(-5))
+        addTime("local-seven-days-ago", atDayOffset(-7))
+        addTime("local-tomorrow", atDayOffset(1))
+        addTime("local-in-three-days", atDayOffset(3))
+        addTime("local-fixed-time", new Date("2025-09-13T01:42:00Z"), "time")
+        addTime("local-fixed-date", new Date("2025-09-13T01:42:00Z"), "date")
+        addTime("local-fixed-date-time", new Date("2025-09-13T01:42:00Z"), "date-time")
+        addTime("local-fixed-weekday-date", new Date("2025-09-13T01:42:00Z"), "weekday-date")
+        addTime("local-fixed-long-date", new Date("2025-09-10T01:42:00Z"), "long-date")
+
+        return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(atDayOffset(-7))
+      })()
+    JAVASCRIPT
+
+    assert_selector "#local-today", text: "1:42 PM"
+    assert_selector "#local-yesterday", text: "yesterday"
+    assert_selector "#local-five-days-ago", text: "5 days ago"
+    assert_selector "#local-seven-days-ago", text: old_date
+    assert_selector "#local-tomorrow", text: "tomorrow"
+    assert_selector "#local-in-three-days", text: "in 3 days"
+    assert_selector "#local-fixed-time", text: "9:42 PM"
+    assert_selector "#local-fixed-date", text: "Sep 12"
+    assert_selector "#local-fixed-date-time", text: "9/12/25, 9:42 PM"
+    assert_selector "#local-fixed-weekday-date", text: "Friday, September 12"
+    assert_selector "#local-fixed-long-date", text: "Sep 09, 2025"
+  end
+end
