diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..a101b02
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,52 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatDate,
+  formatDateTime,
+  formatLongDate,
+  formatTime,
+  formatTimeOrRelativeDate,
+  formatWeekdayDate
+} from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+const FORMATTERS = {
+  "date": formatDate,
+  "date-time": formatDateTime,
+  "datetime": formatDateTime,
+  "long-date": formatLongDate,
+  "time": formatTime,
+  "time-or-relative-date": formatTimeOrRelativeDate,
+  "weekday-date": formatWeekdayDate
+}
+
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.#renderAll(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  timeTargetConnected(time) {
+    this.#render(time)
+  }
+
+  #renderAll() {
+    this.timeTargets.forEach(time => this.#render(time))
+  }
+
+  #render(time) {
+    const date = new Date(time.dateTime)
+    const formatter = FORMATTERS[time.dataset.localTimeFormat] || formatTimeOrRelativeDate
+
+    if (!Number.isNaN(date.valueOf())) {
+      time.textContent = formatter(date)
+    }
+  }
+}
