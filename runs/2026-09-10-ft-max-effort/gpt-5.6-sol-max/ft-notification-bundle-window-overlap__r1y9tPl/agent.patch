+module Notification::Emailable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :bundle_for_email_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_for_email_later
+    if emailable?
+      Notification::Bundle::CollectionJob.perform_later(self, source, creator)
+    end
+  end
+
+  private
+    def emailable?
+      !creator.system? && user.active? && identity.present? && account.active? && user.settings&.bundle_email_interval
+    end
+end
