diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..7ff8f71
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,134 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :entries, class_name: "Notification::Bundle::Entry",
+    foreign_key: :notification_bundle_id, inverse_of: :bundle, dependent: :destroy
+  has_many :notifications, -> { distinct }, through: :entries
+
+  enum :frequency, %w[ every_few_hours daily weekly ].index_by(&:itself)
+
+  scope :collecting, -> { where(collecting: true) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_it_starts
+  validate :window_does_not_overlap
+
+  after_create_commit :deliver_later
+
+  class << self
+    def collect(notification, source: notification.source, creator: notification.creator, at: Time.current)
+      if collection_enabled_for?(notification, creator:)
+        collect_within_user_lock(notification, source:, creator:, at:)
+      end
+    end
+
+    private
+      def collection_enabled_for?(notification, creator:)
+        !creator.system? && notification.user.active? && notification.identity.present? &&
+          notification.account.active? && notification.user.settings&.bundle_email_interval
+      end
+
+      def collect_within_user_lock(notification, source:, creator:, at:)
+        notification.user.with_lock do
+          settings = notification.user.settings.reload
+
+          if interval = settings.bundle_email_interval
+            bundle = current_bundle_for(notification.user, at:)
+            bundle ||= notification.user.notification_bundles.create_or_find_by!(collecting: true) do |new_bundle|
+              new_bundle.account = notification.account
+              new_bundle.frequency = settings.bundle_email_frequency
+              new_bundle.starts_at = at
+              new_bundle.ends_at = at + interval
+            end
+
+            bundle.collect(notification, source:, creator:)
+            bundle
+          end
+        end
+      end
+
+      def current_bundle_for(user, at:)
+        user.notification_bundles.collecting.first&.then do |bundle|
+          if bundle.ended_by?(at)
+            bundle.close
+            nil
+          else
+            bundle
+          end
+        end
+      end
+  end
+
+  def collect(notification, source: notification.source, creator: notification.creator)
+    entries.create_or_find_by!(
+      notification: notification,
+      source: source
+    ) do |entry|
+      payload = payload_for(notification, source:, creator:)
+      entry.account = account
+      entry.title = payload.title
+      entry.body = payload.body
+      entry.url = payload.url
+      entry.occurred_at = source.created_at
+    end
+  end
+
+  def ended_by?(time)
+    ends_at <= time
+  end
+
+  def close
+    update!(collecting: nil)
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    user.with_lock do
+      reload
+
+      unless delivered?
+        NotificationMailer.bundle(self).deliver_now if deliverable?
+        update!(collecting: nil, delivered_at: Time.current)
+      end
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  private
+    def payload_for(notification, source:, creator:)
+      notification.dup.tap do |snapshot|
+        snapshot.source = source
+        snapshot.creator = creator
+        snapshot.card = source.card
+      end.payload
+    end
+
+    def deliverable?
+      entries.exists? && !user.settings.never? && user.active? && user.identity.present? && account.active?
+    end
+
+    def ends_after_it_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def window_does_not_overlap
+      if user_id.present? && starts_at.present? && ends_at.present? && overlapping_windows.exists?
+        errors.add(:base, "Window overlaps an existing notification bundle")
+      end
+    end
+
+    def overlapping_windows
+      user.notification_bundles
+        .where.not(id: id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+    end
+end
