+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequencies map to the requested windows" do
+    settings = user_settings(:kevin_settings)
+
+    assert_equal %w[ never every_few_hours daily weekly ], User::Settings.bundle_email_frequencies.keys
+
+    settings.every_few_hours!
+    assert_equal 4.hours, settings.bundle_email_interval
+
+    settings.daily!
+    assert_equal 1.day, settings.bundle_email_interval
+
+    settings.weekly!
+    assert_equal 1.week, settings.bundle_email_interval
+
+    settings.never!
+    assert_nil settings.bundle_email_interval
+  end
+end
