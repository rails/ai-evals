+    @first_notification = notifications(:logo_assignment_kevin)
+    @second_notification = notifications(:buy_domain_sent_back_to_triage_kevin)
+    @starts_at = Time.zone.parse("2026-03-10 09:30:00")
+  end
+
+  test "never does not open a bundle" do
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_nil Notification::Bundle.collect(@first_notification, at: @starts_at)
+    assert_empty @user.notification_bundles
+  end
+
+  test "the first notification starts a window based on the user's frequency" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+
+    assert_equal @starts_at, bundle.starts_at
+    assert_equal @starts_at + 4.hours, bundle.ends_at
+    assert_equal [ @first_notification ], bundle.notifications.to_a
+  end
+
+  test "a later notification joins the window that is already open" do
+    @settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+
+    same_bundle = Notification::Bundle.collect(@second_notification, at: @starts_at + 23.hours)
+
+    assert_equal bundle, same_bundle
+    assert_equal @starts_at + 1.day, same_bundle.ends_at
+    assert_equal [ @first_notification, @second_notification ].to_set, same_bundle.notifications.to_set
+  end
+
+  test "a notification at the boundary starts a non-overlapping window" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    first_bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+
+    second_bundle = Notification::Bundle.collect(@second_notification, at: first_bundle.ends_at)
+
+    assert_not_equal first_bundle, second_bundle
+    assert_equal first_bundle.ends_at, second_bundle.starts_at
+    assert_operator first_bundle.ends_at, :<=, second_bundle.starts_at
+  end
+
+  test "overlapping windows are invalid" do
+    first_bundle = Notification::Bundle.create!(
+      account: @user.account, user: @user, frequency: :daily,
+      starts_at: @starts_at, ends_at: @starts_at + 1.day
+    )
+
+    overlapping_bundle = Notification::Bundle.new(
+      account: @user.account, user: @user, frequency: :daily,
+      starts_at: first_bundle.starts_at + 1.hour, ends_at: first_bundle.ends_at + 1.hour
+    )
+
+    assert_not overlapping_bundle.valid?
+    assert_includes overlapping_bundle.errors[:base], "Window overlaps an existing notification bundle"
+  end
+
+  test "opening a bundle schedules one delivery at its deadline" do
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliveryJob do
+      bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+      Notification::Bundle.collect(@second_notification, at: @starts_at + 1.hour)
+
+      assert_enqueued_with job: Notification::Bundle::DeliveryJob, args: [ bundle ], at: bundle.ends_at
+    end
+  end
+
+  test "changing frequency does not move a window that is already open" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+
+    @settings.update!(bundle_email_frequency: :weekly)
+    same_bundle = Notification::Bundle.collect(@second_notification, at: @starts_at + 1.hour)
+
+    assert_equal bundle, same_bundle
+    assert_equal "every_few_hours", same_bundle.frequency
+    assert_equal @starts_at + 4.hours, same_bundle.ends_at
+  end
+
+  test "an out-of-order arrival still joins the current open window" do
+    @settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+
+    same_bundle = Notification::Bundle.collect(@second_notification, at: @starts_at - 1.hour)
+
+    assert_equal bundle, same_bundle
+  end
+
+  test "the database permits only one collecting window per user" do
+    Notification::Bundle.create!(
+      account: @user.account, user: @user, frequency: :every_few_hours,
+      starts_at: @starts_at, ends_at: @starts_at + 4.hours
+    )
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Notification::Bundle.create!(
+        account: @user.account, user: @user, frequency: :every_few_hours,
+        starts_at: @starts_at + 5.hours, ends_at: @starts_at + 9.hours
+      )
+    end
+  end
+
+  test "delivery sends one email with every entry and is idempotent" do
+    @settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+    Notification::Bundle.collect(@second_notification, at: @starts_at + 1.hour)
+
+    assert_emails 1 do
+      bundle.deliver_now
+      bundle.deliver_now
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications in Fizzy", email.subject
+    assert_includes email.text_part.body.decoded, @first_notification.payload.title
+    assert_includes email.text_part.body.decoded, @second_notification.payload.title
+    assert bundle.reload.delivered?
+    assert_not bundle.collecting
+  end
+
+  test "destroying a notification removes it from a pending email" do
+    @settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+
+    @first_notification.destroy!
+
+    assert_empty bundle.notifications.reload
+    assert_empty bundle.entries.reload
+    assert_no_emails { bundle.deliver_now }
+  end
+
+  test "turning email off prevents a pending bundle from being delivered" do
+    @settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.collect(@first_notification, at: @starts_at)
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_no_emails { bundle.deliver_now }
+    assert bundle.reload.delivered?
+  end
+end
diff --git a/test/models/notification/emailable_test.rb b/test/models/notification/emailable_test.rb
new file mode 100644
index 0000000..0f52475
--- /dev/null
+++ b/test/models/notification/emailable_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Notification::EmailableTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @settings = user_settings(:kevin_settings)
+    @first_source = events(:logo_published)
+    @second_source = events(:logo_assignment_jz)
+  end
+
+  test "source changes enqueue the occurrence for bundle collection" do
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert_enqueued_with(
+      job: Notification::Bundle::CollectionJob,
+      args: [ @notification, @first_source, @first_source.creator ]
+    ) do
+      @notification.update!(source: @first_source, creator: @first_source.creator)
+    end
+  end
+
+  test "source changes do not enqueue collection when emails are off" do
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_no_enqueued_jobs only: Notification::Bundle::CollectionJob do
+      @notification.update!(source: @first_source, creator: @first_source.creator)
+    end
+  end
+
+  test "late collection jobs retain each source from the time they were enqueued" do
+    @settings.update!(bundle_email_frequency: :daily)
+
+    @notification.update!(source: @first_source, creator: @first_source.creator)
+    @notification.update!(source: @second_source, creator: @second_source.creator)
+    clear_enqueued_jobs
+
+    Notification::Bundle::CollectionJob.perform_now(@notification, @second_source, @second_source.creator)
+    Notification::Bundle::CollectionJob.perform_now(@notification, @first_source, @first_source.creator)
+
+    entries = @notification.user.notification_bundles.sole.entries
+    assert_equal [ @first_source.id, @second_source.id ].to_set, entries.pluck(:source_id).to_set
+  end
+  test "collection and delivery jobs send one bundle at the window deadline" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification.update!(source: @first_source, creator: @first_source.creator)
+
+    perform_enqueued_jobs only: Notification::Bundle::CollectionJob
+    bundle = @notification.user.notification_bundles.sole
+
+    travel_to bundle.ends_at do
+      assert_emails 1 do
+        perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+  test "system-generated notifications do not enqueue collection" do
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert_no_enqueued_jobs only: Notification::Bundle::CollectionJob do
+      @notification.update!(source: @first_source, creator: users(:system))
+    end
+  end
+  test "a captured mention keeps its payload type after the notification advances to an event" do
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+    event = events(:logo_published)
+    user_settings(:david_settings).update!(bundle_email_frequency: :daily)
+    notification.update!(source: event, creator: event.creator)
+
+    bundle = Notification::Bundle.collect(notification, source: mention, creator: mention.mentioner)
+    entry = bundle.entries.sole
+
+    assert_equal "Mention", entry.source_type
+    assert_match(/mentioned you/, entry.title)
+  end
+end
