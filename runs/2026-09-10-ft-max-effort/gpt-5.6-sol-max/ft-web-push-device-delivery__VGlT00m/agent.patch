@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @params = {
+      push_subscription: {
+        endpoint: "https://push.example.test/subscriptions/device-1",
+        p256dh_key: "device-public-key",
+        auth_key: "device-auth-secret"
+      }
+    }
+
+    sign_in_as @user
+  end
+
+  test "create registers this browser for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @params
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.find_by!(endpoint: @params.dig(:push_subscription, :endpoint))
+    assert_equal Current.account, subscription.account
+    assert_equal "device-public-key", subscription.p256dh_key
+    assert_equal "device-auth-secret", subscription.auth_key
+  end
+
+  test "create refreshes keys for an existing browser subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: @params.dig(:push_subscription, :endpoint),
+      p256dh_key: "old-public-key",
+      auth_key: "old-auth-secret"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: @params
+    end
+
+    assert_response :created
+    assert_equal "device-public-key", subscription.reload.p256dh_key
+    assert_equal "device-auth-secret", subscription.auth_key
+  end
+
+  test "create cannot register a subscription for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: @params
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create rejects missing subscription parameters" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {}
+    end
+
+    assert_response :bad_request
+  end
+
+  test "create rejects blank subscription attributes" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "", p256dh_key: "", auth_key: "" }
+      }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires authentication" do
+    sign_out
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: @params
+    end
+
+    assert_response :redirect
+  end
+
+  test "destroy unregisters the current browser by endpoint" do
+    subscription = @user.push_subscriptions.create!(**@params.fetch(:push_subscription))
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy cannot unregister a different user's subscription through the current user" do
+    subscription = users(:kevin).push_subscriptions.create!(**@params.fetch(:push_subscription))
+
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy cannot unregister another user's subscription" do
+    subscription = users(:kevin).push_subscriptions.create!(**@params.fetch(:push_subscription))
+
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(users(:kevin), subscription)
+    end
+
+    assert_response :forbidden
+  end
+end
