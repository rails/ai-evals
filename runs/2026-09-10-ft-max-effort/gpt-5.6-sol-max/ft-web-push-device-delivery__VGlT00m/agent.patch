diff --git a/test/models/push_subscription/delivery_test.rb b/test/models/push_subscription/delivery_test.rb
new file mode 100644
index 0000000..b0f6f4a
--- /dev/null
+++ b/test/models/push_subscription/delivery_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class PushSubscription::DeliveryTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-1",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-secret"
+    )
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "delivers tray text and the tenant card URL using VAPID" do
+    switch_env "VAPID_PUBLIC_KEY", "application-public-key" do
+      switch_env "VAPID_PRIVATE_KEY", "application-private-key" do
+        WebPush.expects(:payload_send).with do |options|
+          payload = JSON.parse(options.fetch(:message))
+
+          payload.fetch("title") == @notification.title &&
+            payload.fetch("body") == @notification.body &&
+            payload.fetch("url") == "http://example.com#{@notification.account.slug}/cards/#{@notification.card.to_param}" &&
+            options.fetch(:endpoint) == @subscription.endpoint &&
+            options.fetch(:p256dh) == @subscription.p256dh_key &&
+            options.fetch(:auth) == @subscription.auth_key &&
+            options.dig(:vapid, :public_key) == "application-public-key" &&
+            options.dig(:vapid, :private_key) == "application-private-key"
+        end
+
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "removes an expired subscription" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.allocate)
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "does not hide transient delivery errors" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.allocate)
+
+      assert_raises WebPush::PushServiceError do
+        @subscription.deliver(@notification)
+      end
+    end
+
+    assert @subscription.persisted?
+  end
+
+  test "skips delivery when the recipient is inactive" do
+    @subscription.user.update_column(:active, false)
+    WebPush.expects(:payload_send).never
+
+    with_vapid_keys do
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "skips delivery when VAPID is not configured" do
+    WebPush.expects(:payload_send).never
+
+    switch_env "VAPID_PUBLIC_KEY", nil do
+      switch_env "VAPID_PRIVATE_KEY", nil do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "delivery jobs restore the notification account context" do
+    @subscription.deliver_later(@notification)
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |options|
+        Current.account == @notification.account &&
+          JSON.parse(options.fetch(:message)).fetch("url").include?(@notification.account.slug)
+      end
+
+      perform_enqueued_jobs only: PushSubscription::DeliveryJob
+    end
+  end
+
+  test "enqueues delivery for each device when a notification enters the tray" do
+    second_subscription = users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-2",
+      p256dh_key: "second-device-public-key",
+      auth_key: "second-device-auth-secret"
+    )
+
+    @notification.destroy!
+
+    assert_enqueued_jobs 2, only: PushSubscription::DeliveryJob do
+      Notification.create!(
+        user: users(:david),
+        source: mentions(:logo_card_david_mention_by_jz),
+        creator: users(:jz),
+        unread_count: 1
+      )
+    end
+
+    delivery_jobs = enqueued_jobs.select { it[:job] == PushSubscription::DeliveryJob }
+    assert_equal [ @subscription.id, second_subscription.id ].sort,
+      delivery_jobs.map { it[:args].first.fetch("_aj_globalid").split("/").last }.sort
+  end
+
+  test "enqueues delivery when a newer source replaces a tray notification" do
+    assert_enqueued_with(job: PushSubscription::DeliveryJob, args: [ @subscription, @notification ]) do
+      @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    end
+  end
+
+  test "does not enqueue delivery when a notification is marked as read" do
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      @notification.read
+    end
+  end
+
+  private
+    def with_vapid_keys(&block)
+      switch_env "VAPID_PUBLIC_KEY", "application-public-key" do
+        switch_env "VAPID_PRIVATE_KEY", "application-private-key", &block
+      end
+    end
+
+    def switch_env(key, value)
+      old, ENV[key] = ENV[key], value
+      yield
+    ensure
+      ENV[key] = old
+    end
+end
