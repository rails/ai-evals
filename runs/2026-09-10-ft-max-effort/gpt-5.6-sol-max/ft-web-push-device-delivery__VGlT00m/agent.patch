diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..99e5bc2
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,136 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "details", "status" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String
+  }
+
+  async connect() {
+    this.failed = false
+    this.#hideDetails()
+    this.#disableButtons()
+
+    if (this.#supported) {
+      try {
+        this.registration = await navigator.serviceWorker.ready
+        this.subscription = await this.registration.pushManager.getSubscription()
+
+        if (this.subscription) {
+          this.subscriptionId = await this.#register(this.subscription)
+        }
+      } catch (error) {
+        this.#handleError(error)
+      } finally {
+        this.#refresh()
+        this.#enableButtons()
+      }
+    } else {
+      this.statusTarget.hidden = true
+      this.#showDetails()
+    }
+  }
+
+  async turnOn() {
+    this.failed = false
+    this.#disableButtons()
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        this.subscription = await this.registration.pushManager.subscribe({
+          applicationServerKey: this.#applicationServerKey,
+          userVisibleOnly: true
+        })
+        this.subscriptionId = await this.#register(this.subscription)
+      }
+    } catch (error) {
+      this.#handleError(error)
+    } finally {
+      this.#refresh()
+      this.#enableButtons()
+    }
+  }
+
+  async turnOff() {
+    this.failed = false
+    this.#disableButtons()
+
+    try {
+      const subscriptionId = this.subscriptionId
+
+      await this.subscription?.unsubscribe()
+      this.subscription = null
+      this.subscriptionId = null
+
+      if (subscriptionId) {
+        const response = await destroy(`${this.subscriptionsUrlValue}/${subscriptionId}`)
+        if (!response.ok && response.statusCode !== 404) throw new Error("Unable to unregister push subscription")
+      }
+    } catch (error) {
+      this.#handleError(error)
+    } finally {
+      this.#refresh()
+      this.#enableButtons()
+    }
+  }
+
+  async #register(subscription) {
+    const json = subscription.toJSON()
+    const body = new FormData()
+    body.append("push_subscription[endpoint]", json.endpoint)
+    body.append("push_subscription[p256dh_key]", json.keys.p256dh)
+    body.append("push_subscription[auth_key]", json.keys.auth)
+
+    const response = await post(this.subscriptionsUrlValue, { body, responseKind: "json" })
+    if (!response.ok) throw new Error("Unable to register push subscription")
+
+    return (await response.json).id
+  }
+
+  #refresh() {
+    const enabled = this.subscription && this.subscriptionId && Notification.permission === "granted"
+    this.element.classList.toggle("notifications--on", enabled)
+
+    if (this.failed || Notification.permission === "denied") {
+      this.#showDetails()
+    } else {
+      this.#hideDetails()
+    }
+  }
+
+  #handleError(error) {
+    this.failed = true
+    console.error("Push notifications could not be configured", error)
+    this.#showDetails()
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(element => element.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(element => element.hidden = true)
+  }
+
+  #disableButtons() {
+    this.buttonTargets.forEach(button => button.disabled = true)
+  }
+
+  #enableButtons() {
+    this.buttonTargets.forEach(button => button.disabled = false)
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padding = "=".repeat((4 - base64.length % 4) % 4)
+    return Uint8Array.from(atob(base64 + padding), character => character.charCodeAt(0))
+  }
+}
