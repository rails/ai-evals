+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "belongs to a user and defaults to the user's account" do
+    subscription = users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-1",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-secret"
+    )
+
+    assert_equal users(:david).account, subscription.account
+  end
+
+  test "endpoint is unique for each user" do
+    attributes = {
+      endpoint: "https://push.example.test/subscriptions/device-1",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-secret"
+    }
+
+    users(:david).push_subscriptions.create!(attributes)
+
+    assert_raises ActiveRecord::RecordInvalid do
+      users(:david).push_subscriptions.create!(attributes)
+    end
+
+    assert users(:kevin).push_subscriptions.create!(attributes).persisted?
+  end
+
+  test "requires an HTTPS push service endpoint" do
+    subscription = users(:david).push_subscriptions.new(
+      endpoint: "http://127.0.0.1/latest/meta-data",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-secret"
+    )
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be an HTTPS URL"
+  end
+
+  test "is removed when the user is deactivated" do
+    user = users(:david)
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscriptions/device-1",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-secret"
+    )
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      user.deactivate
+    end
+  end
+
+  test "requires all browser subscription attributes" do
+    subscription = users(:david).push_subscriptions.new
+
+    assert_not subscription.valid?
+    assert subscription.errors.of_kind?(:endpoint, :blank)
+    assert subscription.errors.of_kind?(:p256dh_key, :blank)
+    assert subscription.errors.of_kind?(:auth_key, :blank)
+  end
+end
