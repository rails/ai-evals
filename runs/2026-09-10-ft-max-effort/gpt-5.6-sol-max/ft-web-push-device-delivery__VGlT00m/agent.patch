diff --git a/app/models/notification/message.rb b/app/models/notification/message.rb
new file mode 100644
index 0000000..1fdad02
--- /dev/null
+++ b/app/models/notification/message.rb
@@ -0,0 +1,58 @@
+module Notification::Message
+  extend ActiveSupport::Concern
+
+  def title
+    case source
+    when Event then event_title
+    when Mention then "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def body
+    case source
+    when Event then event_body
+    when Mention then source.source.mentionable_content.truncate(200)
+    end
+  end
+
+  private
+    def event_title
+      if event_action == "comment_created"
+        "RE: #{card_title(source.eventable.card)}"
+      else
+        card_title(source.eventable)
+      end
+    end
+
+    def event_body
+      creator = source.creator.name
+
+      case event_action
+      when "card_assigned" then "Assigned to #{source.assignees.none? ? "self" : source.assignees.pluck(:name).to_sentence}"
+      when "card_unassigned" then "Unassigned by #{creator}"
+      when "card_published" then "Added by #{creator}"
+      when "card_closed" then "Moved to Done by #{creator}"
+      when "card_reopened" then "Reopened by #{creator}"
+      when "card_postponed" then "Moved to Not Now by #{creator}"
+      when "card_auto_postponed" then "Moved to Not Now due to inactivity"
+      when "card_title_changed" then "Renamed by #{creator}"
+      when "card_board_changed" then "Moved by #{creator}"
+      when "card_triaged" then "Moved to #{source.particulars.dig("particulars", "column")} by #{creator}"
+      when "card_sent_back_to_triage" then "Moved back to Maybe? by #{creator}"
+      when "comment_created" then source.eventable.body.to_plain_text.truncate(200)
+      else creator
+      end
+    end
+
+    def event_action
+      if source.action.card_published? && source.eventable.assigned_to?(source.creator)
+        "card_assigned"
+      else
+        source.action
+      end
+    end
+
+    def card_title(card)
+      card.title.presence || "Card #{card.number}"
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..9ee04f7
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,36 @@
+class PushSubscription < ApplicationRecord
+  include Delivery
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+  validate :endpoint_is_https
+
+  class << self
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def vapid_subject
+      ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do")
+    end
+  end
+
+  private
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      errors.add(:endpoint, "must be an HTTPS URL") unless uri.is_a?(URI::HTTPS) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be an HTTPS URL")
+    end
+end
diff --git a/app/models/push_subscription/delivery.rb b/app/models/push_subscription/delivery.rb
new file mode 100644
index 0000000..b991b4b
--- /dev/null
+++ b/app/models/push_subscription/delivery.rb
@@ -0,0 +1,51 @@
+module PushSubscription::Delivery
+  extend ActiveSupport::Concern
+
+  included do
+    include Rails.application.routes.url_helpers
+  end
+
+  def deliver_later(notification)
+    PushSubscription::DeliveryJob.perform_later(self, notification)
+  end
+
+  def deliver(notification)
+    return unless deliverable?
+
+    WebPush.payload_send(
+      message: payload_for(notification).to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_keys
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def deliverable?
+      PushSubscription.configured? && user.active? && account.active?
+    end
+
+    def payload_for(notification)
+      {
+        title: notification.title,
+        body: notification.body,
+        url: card_url(notification.card, **base_url_options, script_name: notification.account.slug)
+      }
+    end
+
+    def vapid_keys
+      {
+        subject: PushSubscription.vapid_subject,
+        public_key: PushSubscription.vapid_public_key,
+        private_key: PushSubscription.vapid_private_key
+      }
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+end
