diff --git a/script/reproduce_storage_usage.rb b/script/reproduce_storage_usage.rb
new file mode 100644
index 0000000..590eda6
--- /dev/null
+++ b/script/reproduce_storage_usage.rb
@@ -0,0 +1,57 @@
+# Run with: bin/rails runner script/reproduce_storage_usage.rb
+ActiveJob::Base.queue_adapter = :test
+
+account = identity = nil
+account_id = nil
+begin
+  identity = Identity.create!(email_address: "storage-reproduction-#{SecureRandom.hex(4)}@example.com")
+  account = Account.create_with_owner(
+    account: { name: "Storage usage reproduction" },
+    owner: { name: "Storage Tester", identity: identity }
+  )
+  account_id = account.id
+  Current.account = account
+  user = account.users.find_by!(identity: identity)
+  Current.session = identity.sessions.create!
+  board = account.boards.create!(name: "Storage Board", creator: user)
+  card = board.cards.create!(title: "Storage Card", creator: user, status: :published)
+  comment = card.comments.create!(body: "Storage comment", creator: user)
+
+  upload = lambda do |contents|
+    ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new(contents), filename: "file.txt", content_type: "text/plain"
+    )
+  end
+
+  embed = lambda do |record, attribute, contents|
+    upload.call(contents).tap do |blob|
+      attachment = %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+      record.public_send(attribute).update!(body: ActionText::Content.new(attachment))
+    end
+  end
+
+  card.image.attach(io: StringIO.new("image"), filename: "image.txt", content_type: "text/plain")
+  counted_blobs = [
+    card.image.blob,
+    embed.call(board, :public_description, "board description"),
+    embed.call(card, :description, "card description"),
+    embed.call(comment, :body, "comment body")
+  ]
+
+  Board::StorageCalculationJob.perform_now(board.id)
+  Account::StorageCalculationJob.perform_now(account.id)
+  expected = counted_blobs.sum(&:byte_size)
+  board.reload
+  account.reload
+
+  raise "Board usage was #{board.bytes_used}, expected #{expected}" unless board.bytes_used == expected
+  raise "Account usage was #{account.bytes_used}, expected #{expected}" unless account.bytes_used == expected
+
+  puts "Board bytes_used: #{board.bytes_used}"
+  puts "Account bytes_used: #{account.bytes_used}"
+ensure
+  account&.destroy!
+  ActiveStorage::Blob.where(account_id: account_id).find_each(&:purge) if account_id
+  identity&.destroy!
+  Current.clear_all
+end
