+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_storage_boards, if: :will_save_change_to_board_id?
+    before_destroy :remember_storage_board
+
+    after_update_commit :update_storage_after_board_change
+    after_destroy_commit :update_storage_after_destroy
+    after_rollback :clear_remembered_storage_boards
+  end
+
+  private
+    def remember_storage_boards
+      old_board_id, = board_id_change_to_be_saved
+      boards = [ account.boards.find_by(id: old_board_id), board ].compact
+      @storage_boards = (@storage_boards.to_a + boards).uniq
+    end
+
+    def remember_storage_board
+      @storage_board = board
+    end
+
+    def update_storage_after_board_change
+      @storage_boards&.each(&:storage_usage_changed)
+      clear_remembered_storage_boards
+    end
+
+    def update_storage_after_destroy
+      @storage_board.storage_usage_changed if @storage_board&.persisted?
+    end
+
+    def clear_remembered_storage_boards
+      @storage_boards = nil
+    end
+end
