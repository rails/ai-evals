+module Storage::ActiveStorageAttachment
+  extend ActiveSupport::Concern
+
+  prepended do
+    before_destroy :remember_counted_storage_board
+    after_upload :update_counted_storage
+    after_destroy_commit :update_counted_storage
+  end
+
+  def delete
+    board = counted_storage_board if persisted?
+    super.tap { update_counted_storage(board) }
+  end
+
+  private
+    def remember_counted_storage_board
+      @counted_storage_board = counted_storage_board
+    end
+
+    def update_counted_storage(board = @counted_storage_board || counted_storage_board)
+      board.storage_usage_changed if board&.persisted?
+    end
+
+    def counted_storage_board
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        record&.board
+      when [ "ActionText::RichText", "embeds" ]
+        record&.storage_board
+      end
+    end
+end
