new file mode 100644
index 0000000..70b0c29
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,77 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    include ::Storage::Trackable
+
+    before_destroy :remember_storage_account
+    after_destroy_commit :update_account_storage_after_destroy
+  end
+
+  private
+    def calculate_storage_bytes
+      card_image_bytes + board_description_bytes + card_description_bytes + comment_body_bytes
+    end
+
+    def card_image_bytes
+      attachment_bytes_for "Card", storage_card_ids, "image"
+    end
+
+    def board_description_bytes
+      embedded_bytes_for storage_rich_texts.where(
+        record_type: "Board", record_id: id, name: "public_description"
+      )
+    end
+
+    def card_description_bytes
+      embedded_bytes_for storage_rich_texts.where(
+        record_type: "Card", record_id: storage_card_ids, name: "description"
+      )
+    end
+
+    def comment_body_bytes
+      embedded_bytes_for storage_rich_texts.where(
+        record_type: "Comment", record_id: storage_comment_ids, name: "body"
+      )
+    end
+
+    def embedded_bytes_for(rich_texts)
+      attachment_bytes_for "ActionText::RichText", rich_texts.select(:id), "embeds"
+    end
+
+    def attachment_bytes_for(record_type, record_ids, name)
+      ActiveStorage::Attachment
+        .where(record_type: record_type, record_id: record_ids, name: name)
+        .joins(:blob)
+        .merge(ActiveStorage::Blob.where(account_id: account_id))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def storage_rich_texts
+      ActionText::RichText.all
+    end
+
+    def storage_card_ids
+      Card.where(account_id: account_id, board_id: id).select(:id)
+    end
+
+    def storage_comment_ids
+      Comment.where(card_id: storage_card_ids).select(:id)
+    end
+
+    def enqueue_storage_calculation
+      Board::StorageCalculationJob.perform_later(id)
+    end
+
+    def storage_calculation_completed
+      account.storage_usage_changed
+    end
+
+    def remember_storage_account
+      @storage_account = account
+    end
+
+    def update_account_storage_after_destroy
+      @storage_account.storage_usage_changed if @storage_account&.persisted?
+    end
+end
