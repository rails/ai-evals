+module Account::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    include ::Storage::Trackable
+  end
+
+  def recalculate_storage_later
+    boards.update_all(
+      storage_calculated_revision: -1,
+      storage_calculation_pending: false
+    )
+    storage_usage_changed
+  end
+
+  private
+    def calculate_storage_bytes
+      boards.requiring_storage_calculation.find_each(&:calculate_storage_later)
+      boards.sum(:bytes_used)
+    end
+
+    def enqueue_storage_calculation
+      Account::StorageCalculationJob.perform_later(id)
+    end
+
+    def storage_calculation_completed
+    end
+end
