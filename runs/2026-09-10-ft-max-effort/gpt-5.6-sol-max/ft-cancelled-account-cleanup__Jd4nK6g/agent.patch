diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..7dffe51
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates only accounts cancelled more than thirty days ago" do
+    travel_to Time.zone.local(2026, 1, 31, 12) do
+      due_account = create_account("Due")
+      cancel due_account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.second
+
+      recently_cancelled_account = create_account("Recently cancelled")
+      cancel recently_cancelled_account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+
+      active_account = create_account("Active")
+
+      Current.clear_all
+      Account::IncinerateDueJob.perform_now
+
+      assert_not Account.exists?(due_account.id)
+      assert Account.exists?(recently_cancelled_account.id)
+      assert Account.exists?(active_account.id)
+    end
+  end
+
+  test "removes all of the account data from the database" do
+    account = create_account("Due with data", identity: identities(:david))
+    Current.account = account
+    Current.user = account.users.owner.first
+
+    board = account.boards.create!(name: "Board", creator: Current.user)
+    card = board.cards.create!(title: "Card", creator: Current.user)
+    card.image.attach io: StringIO.new("account data"), filename: "account-data.txt", content_type: "text/plain"
+    account.storage_entries.create!(delta: 12, operation: "test")
+    account.create_storage_total!(bytes_stored: 12)
+    board.create_storage_total!(bytes_stored: 12)
+
+    account_id = account.id
+    identity_id = Current.user.identity_id
+    blob_id = card.image.blob.id
+    cancel account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.second
+
+    Current.clear_all
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account_id)
+    assert_not ActiveStorage::Blob.exists?(blob_id)
+    assert Identity.exists?(identity_id)
+    assert_empty account_scoped_rows(account_id)
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: account_id)
+    assert_not Storage::Total.exists?(owner_type: "Board", owner_id: board.id)
+  end
+
+  private
+    def create_account(name, identity: nil)
+      Account.create!(name: name).tap do |account|
+        account.users.create!(name: "System", role: :system)
+        account.users.create!(name: "Owner", role: :owner, identity: identity)
+      end
+    end
+
+    def cancel(account, at:)
+      account.create_cancellation!(initiated_by: account.users.owner.first, created_at: at, updated_at: at)
+    end
+
+    def account_scoped_rows(account_id)
+      ApplicationRecord.connection.tables.filter_map do |table|
+        if ApplicationRecord.connection.column_exists?(table, :account_id)
+          model = Class.new(ApplicationRecord) { self.table_name = table }
+          count = model.where(account_id: account_id).count
+
+          [ table, count ] if count.positive?
+        end
+      end
+    end
+end
