diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..504a436
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "index as JSON" do
+    reaction = @comment.reactions.create!(reacter: users(:jz), content: "Exactly")
+
+    get card_comment_reactions_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ reaction.id ], @response.parsed_body.pluck("id")
+    assert_equal "Exactly", @response.parsed_body.first["content"]
+    assert_equal users(:jz).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "create as turbo stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "Love it 👍" } }, as: :turbo_stream
+    end
+
+    reaction = @comment.reactions.order(:created_at).last
+    assert_equal users(:kevin), reaction.reacter
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions)
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reaction_form)
+  end
+
+  test "create as JSON accepts wrapped and flat parameters" do
+    post card_comment_reactions_path(@comment.card, @comment),
+      params: { reaction: { content: "Wrapped" } }, as: :json
+
+    assert_response :created
+    reaction = @comment.reactions.order(:created_at).last
+    assert_equal "Wrapped", reaction.content
+    assert_equal card_comment_reaction_path(@comment.card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+
+    post card_comment_reactions_path(@comment.card, @comment), params: { content: "Flat" }, as: :json
+    assert_response :created
+    assert_equal "Flat", @comment.reactions.order(:created_at).last.content
+  end
+
+  test "rejects blank and overlong reactions" do
+    [ "  ", "a" * 17 ].each do |content|
+      assert_no_difference -> { @comment.reactions.count } do
+        post card_comment_reactions_path(@comment.card, @comment),
+          params: { reaction: { content: content } }, as: :json
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "destroy removes your own reaction" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "Mine")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroying another user's reaction is forbidden" do
+    reaction = @comment.reactions.create!(reacter: users(:jz), content: "Theirs")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "reaction is scoped through its card and comment" do
+    other_comment = comments(:layout_overflowing_david)
+    reaction = other_comment.reactions.create!(reacter: users(:kevin), content: "Other")
+
+    delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+    assert_response :not_found
+    assert Reaction.exists?(reaction.id)
+  end
+
+  test "comment renders the reactions strip and add form" do
+    reaction = @comment.reactions.create!(reacter: users(:jz), content: "Ship it 🚢")
+
+    get card_comment_path(@comment.card, @comment)
+
+    assert_response :success
+    assert_select ".reactions[data-controller='reaction-form']" do
+      assert_select ".reactions__list##{dom_id(@comment, :reactions)}"
+      assert_select ".reactions__trigger[aria-label='Add a reaction'] img[src*='boost-color']"
+      assert_select "form.reaction__form[hidden]" do
+        assert_select "input.reaction__input[maxlength='16'][required]"
+        assert_select ".reaction__submit-btn[aria-label='Add reaction']"
+        assert_select ".reaction__cancel-btn[aria-label='Cancel reaction']"
+      end
+    end
+    assert_select ".reaction##{dom_id(reaction)}[data-creator-id='#{users(:jz).id}']" do
+      assert_select ".reaction__avatar [aria-label='JZ']"
+      assert_select ".reaction__delete"
+      assert_select "[data-reaction-delete]"
+      assert_select "span", text: "Ship it 🚢"
+    end
+  end
+end
