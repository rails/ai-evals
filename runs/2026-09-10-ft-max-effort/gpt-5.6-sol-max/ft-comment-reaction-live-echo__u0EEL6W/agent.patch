+
+  test "belongs to a comment and defaults to the current user and account" do
+    Current.user = @reacter
+
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal @comment, reaction.comment
+    assert_equal @reacter, reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "requires non-blank content of at most 16 characters" do
+    reaction = @comment.reactions.new(reacter: @reacter)
+
+    assert_not reaction.valid?
+    assert reaction.errors.added?(:content, :blank)
+
+    reaction.content = "a" * 17
+    assert_not reaction.valid?
+    assert reaction.errors.added?(:content, :too_long, count: 16)
+
+    reaction.content = "👍" * 16
+    assert reaction.valid?
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(reacter: @reacter, content: "Nice")
+
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "broadcasts creations and removals to everyone viewing the card" do
+    reaction = nil
+
+    broadcasts = capture_turbo_stream_broadcasts [ @comment.card, :activity ] do
+      reaction = @comment.reactions.create!(reacter: @reacter, content: "Live")
+    end
+
+    append = broadcasts.find { |broadcast| broadcast["action"] == "append" }
+    assert append
+    assert_equal dom_id(@comment, :reactions), append["target"]
+    assert append.at_css("##{dom_id(reaction)}[data-creator-id='#{@reacter.id}']")
+    assert append.at_css("form[data-reaction-delete]")["action"].start_with?(@comment.account.slug)
+
+    broadcasts = capture_turbo_stream_broadcasts [ @comment.card, :activity ] do
+      reaction.destroy!
+    end
+
+    remove = broadcasts.find { |broadcast| broadcast["action"] == "remove" }
+    assert remove
+    assert_equal dom_id(reaction), remove["target"]
+  end
+end
