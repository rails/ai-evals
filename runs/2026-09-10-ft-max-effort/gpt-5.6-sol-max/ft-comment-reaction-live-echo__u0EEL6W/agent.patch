+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    sign_in_as users(:kevin)
+    visit card_url(@comment.card)
+  end
+
+  test "adding, canceling, and removing a reaction" do
+    within_comment do
+      find(".reactions__trigger").click
+      assert_selector "form.reaction__form:not([hidden])"
+      fill_in "Your reaction", with: "Not yet"
+      find(".reaction__cancel-btn").click
+
+      assert_selector ".reactions__trigger"
+      assert_no_selector "form.reaction__form:not([hidden])"
+
+      find(".reactions__trigger").click
+      fill_in "Your reaction", with: "Love it 👍"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "Love it 👍"
+      assert_selector ".reactions__trigger"
+
+      find(".reaction", text: "Love it 👍").click
+      within ".reaction", text: "Love it 👍" do
+        click_button "Remove this reaction"
+      end
+
+      assert_no_selector ".reaction", text: "Love it 👍"
+    end
+  end
+
+  test "receiving a reaction created by someone else" do
+    wait_for_cable_subscriptions
+
+    Current.set(account: @comment.account, user: users(:jz)) do
+      @comment.reactions.create!(content: "Live now 🚀")
+    end
+
+    within_comment do
+      reaction = find(".reaction", text: "Live now 🚀", wait: 5)
+      reaction.click
+      assert_no_button "Remove this reaction"
+    end
+  end
+
+  private
+    def within_comment(&block)
+      within "##{dom_id(@comment)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
