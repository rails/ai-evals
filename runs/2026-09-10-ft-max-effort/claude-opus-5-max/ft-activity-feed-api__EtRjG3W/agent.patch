@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignees" do
+    assert_equal [ users(:jz) ], events(:logo_assignment_jz).assignees.to_a
+  end
+
+  test "tracked particulars" do
+    event = events(:logo_published)
+    event.update! particulars: { particulars: {
+      old_title: "Old title", new_title: "New title",
+      old_board: "Writebook", new_board: "Fizzy", column: "In progress" } }
+
+    assert_equal "Old title", event.old_title
+    assert_equal "New title", event.new_title
+    assert_equal "Writebook", event.old_board
+    assert_equal "Fizzy", event.new_board
+    assert_equal "In progress", event.column_name
+  end
+
+  test "missing particulars are empty strings" do
+    event = events(:logo_published)
+
+    assert_equal "", event.old_title
+    assert_equal "", event.new_title
+    assert_equal "", event.old_board
+    assert_equal "", event.new_board
+    assert_equal "", event.column_name
