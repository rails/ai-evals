diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..4d17f23
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,117 @@
+# Activity
+
+Activity is the stream of everything that happened on the boards you can access: cards added, assigned, moved, renamed, closed, and comments posted. It's the same activity shown in the Fizzy timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity, newest first. Only activity from boards you have access to is returned.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the ID(s) of the people who caused the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to &quot;First!&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a8"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 4,
+      "title": "First!",
+      "status": "published",
+      "...": "See the cards section for the full card representation"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm",
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David Heinemeier Hansson",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+      }
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  },
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq3",
+    "action": "comment_created",
+    "created_at": "2025-12-05T19:39:12.114Z",
+    "description": "Jason Fried commented on &quot;First!&quot;",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4#comment_03f5vaeq985jlvwv3arl4srq9",
+    "eventable_type": "Comment",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq9",
+      "created_at": "2025-12-05T19:39:12.100Z",
+      "updated_at": "2025-12-05T19:39:12.100Z",
+      "body": {
+        "plain_text": "Agreed!",
+        "html": "<div class=\"action-text-content\"><p>Agreed!</p></div>"
+      },
+      "...": "See the comments section for the full comment representation"
+    },
+    "board": { "...": "The board the activity happened on" },
+    "creator": { "...": "The person who caused the activity" }
+  }
+]
+```
+
+The `eventable_type` is either `Card` or `Comment`, and it tells you the shape of `eventable`: a [card](cards.md) or a [comment](comments.md). The `url` opens the card in Fizzy, jumping to the comment for comment activity.
+
+__Actions:__
+
+| Action | Description |
+|--------|-------------|
+| `card_published` | A card was added |
+| `card_assigned` | A card was assigned |
+| `card_unassigned` | A card was unassigned |
+| `card_title_changed` | A card was renamed |
+| `card_board_changed` | A card was moved to another board |
+| `card_triaged` | A card was moved to a workflow column |
+| `card_sent_back_to_triage` | A card was moved back to "Maybe?" |
+| `card_postponed` | A card was moved to "Not Now" |
+| `card_auto_postponed` | A card was moved to "Not Now" after a period of inactivity |
+| `card_closed` | A card was moved to "Done" |
+| `card_reopened` | A card was reopened |
+| `comment_created` | A comment was posted on a card |
+
+__Particulars:__
+
+The `particulars` object carries the details specific to each action. Missing board, title, or column values are returned as empty strings.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| Everything else | `{}` |
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..181aa25
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,230 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index returns the accessible activity, newest first" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_equal users(:david).accessible_events.activity.reverse_chronologically.pluck(:id),
+      activity_ids
+  end
+
+  test "index returns every detail of an activity" do
+    event = events(:layout_assignment_jz)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.first
+    assert_equal event.id, activity["id"]
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.as_json, activity["created_at"]
+    assert_equal "David assigned JZ to &quot;Layout is broken&quot;", activity["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    assert_equal card_url(cards(:layout)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity["eventable"]["id"]
+    assert_equal boards(:writebook).id, activity["board"]["id"]
+    assert_equal users(:david).id, activity["creator"]["id"]
+  end
+
+  test "index describes the activity from the point of view of the current user" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_includes find_activity(events(:logo_assignment_david))["description"], "David will handle"
+    assert_includes find_activity(events(:logo_assignment_km))["description"], "David assigned Kevin to"
+  end
+
+  test "index returns comments as the eventable of comment activity" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = find_activity(event)
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity["eventable"]["id"]
+    assert_equal card_url(comment.card, anchor: "comment_#{comment.id}"), activity["url"]
+  end
+
+  test "index includes card title changes" do
+    event = rename_card cards(:logo), "The logo is too big"
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = find_activity(event)
+    assert_equal "card_title_changed", activity["action"]
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "The logo is too big" }, activity["particulars"])
+  end
+
+  test "index excludes deprecated card collection changes" do
+    event = Event.create! action: "card_collection_changed", board: boards(:writebook),
+      creator: users(:david), eventable: cards(:logo),
+      particulars: { particulars: { old_collection: "Writebook", new_collection: "Fizzy" } }
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_not_includes activity_ids, event.id
+  end
+
+  test "index returns the board particulars of board changes" do
+    event = move_card cards(:logo), to: other_board
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = find_activity(event)
+    assert_equal "card_board_changed", activity["action"]
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Fizzy" }, activity["particulars"])
+  end
+
+  test "index returns the column particulars of triage activity" do
+    event = triage_card cards(:layout), into: columns(:writebook_in_progress)
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = find_activity(event)
+    assert_equal "card_triaged", activity["action"]
+    assert_equal({ "column" => "In progress" }, activity["particulars"])
+  end
+
+  test "index returns missing particulars as empty strings" do
+    event = triage_card cards(:layout), into: columns(:writebook_in_progress)
+    event.update! particulars: {}
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_equal({ "column" => "" }, find_activity(event)["particulars"])
+  end
+
+  test "index returns empty particulars for activity without any" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_equal({}, find_activity(events(:layout_published))["particulars"])
+  end
+
+  test "index only returns activity from boards the user can access" do
+    event = publish_card_in boards(:private)
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes activity_ids, event.id
+
+    logout_and_sign_in_as :kevin
+    get activities_path(format: :json)
+    assert_response :success
+    assert_includes activity_ids, event.id
+  end
+
+  test "index filters activity by creator" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+    assert_response :success
+
+    assert_equal [ users(:kevin).id ], creator_ids.uniq
+    assert_equal events(:shipping_closed, :shipping_published, :text_published).collect(&:id).sort,
+      activity_ids.sort
+  end
+
+  test "index filters activity by several creators" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id, users(:david).id ])
+    assert_response :success
+
+    assert_equal [ users(:david).id, users(:kevin).id ].sort, creator_ids.uniq.sort
+  end
+
+  test "index filters activity by board" do
+    event = publish_card_in other_board
+
+    get activities_path(format: :json, board_ids: [ other_board.id ])
+    assert_response :success
+
+    assert_equal [ event.id ], activity_ids
+  end
+
+  test "index ignores boards the user can't access" do
+    publish_card_in boards(:private)
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+    assert_response :success
+
+    assert_empty activity_ids
+  end
+
+  test "index paginates" do
+    50.times { publish_card_in boards(:writebook) }
+
+    expected_ids = users(:david).accessible_events.activity.reverse_chronologically.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat @response.parsed_body.collect { it["id"] }
+      next_page = next_page_from_link_header @response.headers["Link"]
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def activity_ids
+      @response.parsed_body.collect { it["id"] }
+    end
+
+    def creator_ids
+      @response.parsed_body.collect { it.dig("creator", "id") }
+    end
+
+    def find_activity(event)
+      @response.parsed_body.find { it["id"] == event.id }
+    end
+
+    def rename_card(card, title)
+      as_david { card.update! title: title }
+      card.events.reverse_chronologically.first
+    end
+
+    def move_card(card, to:)
+      as_david { card.move_to to }
+      to.events.reverse_chronologically.first
+    end
+
+    def triage_card(card, into:)
+      as_david { card.triage_into into }
+      card.events.reverse_chronologically.first
+    end
+
+    def publish_card_in(board)
+      card = as_david { board.cards.create! title: "New card", creator: users(:david), status: "published" }
+      card.events.reverse_chronologically.first
+    end
+
+    def other_board
+      @other_board ||= as_david { Board.create! name: "Fizzy", all_access: true }
+    end
+
+    def as_david(&block)
+      Current.with(user: users(:david), account: accounts("37s"), &block)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
