@@ -0,0 +1,25 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      activities = Current.user.accessible_events.activity.fully_preloaded.reverse_chronologically
+      activities = activities.where(creator_id: creator_ids) if creator_ids.any?
+      activities = activities.where(board_id: board_ids) if board_ids.any?
+      activities
+    end
+
+    def creator_ids
+      @creator_ids ||= Array(filter_params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      @board_ids ||= Array(filter_params[:board_ids]).compact_blank
+    end
+
+    def filter_params
+      @filter_params ||= params.permit(creator_ids: [], board_ids: [])
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
