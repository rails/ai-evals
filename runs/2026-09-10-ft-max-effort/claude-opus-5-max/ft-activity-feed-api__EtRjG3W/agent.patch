+require "test_helper"
+
+class EventTest < ActiveSupport::TestCase
+  test "activity mirrors the day timeline, minus collection changes, plus title changes" do
+    assert_includes Event::ACTIVITY_ACTIONS, "card_title_changed"
+    assert_not_includes Event::ACTIVITY_ACTIONS, "card_collection_changed"
+  end
