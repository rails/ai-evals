@@ -0,0 +1,41 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlighting the matched terms" do
+    assert_equal "The <mark>logo</mark> isn&#39;t big enough",
+      highlight_terms("The logo isn't big enough", [ "logo" ])
+  end
+
+  test "highlighting is case insensitive" do
+    assert_equal "The <mark>Logo</mark> and the <mark>logo</mark>",
+      highlight_terms("The Logo and the logo", [ "LOGO" ])
+  end
+
+  test "highlighting every term" do
+    assert_equal "<mark>Buy</mark> a <mark>domain</mark>",
+      highlight_terms("Buy a domain", [ "buy", "domain" ])
+  end
+
+  test "highlighting escapes the text" do
+    assert_equal "&lt;script&gt; &amp; <mark>logo</mark>",
+      highlight_terms("<script> & logo", [ "logo" ])
+  end
+
+  test "highlighting without terms" do
+    assert_equal "Nothing to highlight", highlight_terms("Nothing to highlight", [])
+    assert_equal "", highlight_terms(nil, [ "logo" ])
+  end
+
+  test "excerpting around the match" do
+    content = ActionText::Content.new("<div>#{"filler " * 40}needle#{" filler" * 40}</div>")
+
+    excerpt = search_excerpt(content, [ "needle" ], radius: 10)
+    assert_equal "…er filler <mark>needle</mark> filler fi…", excerpt
+  end
+
+  test "excerpting content that doesn't match" do
+    assert_nil search_excerpt(ActionText::Content.new("Nothing here"), [ "needle" ])
+    assert_nil search_excerpt(nil, [ "needle" ])
+    assert_nil search_excerpt("Something", [])
+  end
+end
