+++ b/test/models/search_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @user = users(:david)
+  end
+
+  test "finds cards by title" do
+    assert_includes search("logo").cards, cards(:logo)
+  end
+
+  test "finds cards by description" do
+    cards(:shipping).update! description: "We should ship this before the holidays"
+
+    assert_equal [ cards(:shipping) ], search("holidays").cards.to_a
+  end
+
+  test "finds cards by comment body" do
+    assert_equal [ cards(:layout) ], search("overflowing").cards.to_a
+  end
+
+  test "matches regardless of case" do
+    assert_includes search("LoGo").cards, cards(:logo)
+  end
+
+  test "requires every term to match" do
+    assert_includes search("logo big").cards, cards(:logo)
+    assert_empty search("logo nonexistent").cards
+  end
+
+  test "matches terms across titles and comments" do
+    assert_includes search("logo agree").cards, cards(:logo)
+  end
+
+  test "returns the newest cards first" do
+    older = create_card title: "Older haggis", created_at: 2.days.ago
+    newer = create_card title: "Newer haggis", created_at: 1.hour.ago
+
+    assert_equal [ newer, older ], search("haggis").cards.to_a
+  end
+
+  test "ignores cards on boards the user can't access" do
+    secret = create_card title: "Secret haggis", board: boards(:private), creator: users(:kevin)
+
+    assert_empty search("haggis").cards
+    assert_includes search("haggis", user: users(:kevin)).cards, secret
+  end
+
+  test "ignores cards from other accounts" do
+    assert_empty search("paycheck").cards
+  end
+
+  test "ignores drafted cards" do
+    create_card title: "Drafted haggis", status: :drafted
+
+    assert_empty search("haggis").cards
+  end
+
+  test "ignores comments on drafted cards" do
+    card = create_card title: "Untitled"
+    card.comments.create! creator: @user, body: "Haggis for everyone"
+    card.update_column :status, "drafted"
+
+    assert_empty search("haggis").cards
+  end
+
+  test "an empty query finds nothing" do
+    assert_empty search("").cards
+    assert_empty search("   ").cards
+    assert_empty search(nil).cards
+  end
+
+  test "special characters don't blow up the query" do
+    assert_empty search("100%").cards
+    assert_empty search("_").cards
+  end
+
+  test "finds the comments that matched within a card" do
+    assert_equal [ comments(:layout_overflowing_david) ], search("overflowing").comments_in(cards(:layout)).to_a
+    assert_empty search("layout").comments_in(cards(:layout))
+  end
+
+  private
+    def search(query, user: @user)
+      Search.new(query, user: user)
+    end
+
+    def create_card(board: boards(:writebook), creator: @user, status: :published, **attributes)
+      board.cards.create! creator: creator, status: status, **attributes
+    end
+end
