+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+
+    assert_select "input[name=q]"
+    assert_select ".search-result", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "finds cards by title" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:logo))}" do
+      assert_select "a[href=?]", card_path(cards(:logo))
+      assert_select "mark", text: "logo"
+    end
+  end
+
+  test "finds cards by description" do
+    with_current_user(:david) { cards(:shipping).update! description: "Ship it before the holidays" }
+
+    get search_path(q: "holidays")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:shipping))}"
+    assert_select "mark", text: "holidays"
+  end
+
+  test "finds cards by comment body" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "##{dom_id(cards(:layout))}" do
+      assert_select "mark", text: "overflowing"
+    end
+  end
+
+  test "finds cards matching every term" do
+    get search_path(q: "logo agree")
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select "##{dom_id(cards(:logo))}"
+
+    get search_path(q: "logo haggis")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "lists the newest cards first" do
+    with_current_user(:david) do
+      boards(:writebook).cards.create! title: "Older haggis", creator: users(:david), status: :published, created_at: 2.days.ago
+      boards(:writebook).cards.create! title: "Newer haggis", creator: users(:david), status: :published, created_at: 1.minute.ago
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_equal [ "Newer haggis", "Older haggis" ], css_select(".search-result__title").collect { it.text.squish }
+  end
+
+  test "skips cards on boards the user can't access" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create! title: "Hidden haggis", creator: users(:kevin), status: :published
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select ".search-result__title", text: /Hidden haggis/, count: 0
+
+    logout_and_sign_in_as :kevin
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title", text: /Hidden haggis/, count: 1
+  end
+
+  test "skips cards on boards the user lost access to" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create! title: "Hidden haggis", creator: users(:kevin), status: :published
+      boards(:private).accesses.grant_to [ users(:david) ]
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select ".search-result", count: 1
+
+    boards(:private).accesses.find_by(user: users(:david)).destroy!
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "skips drafted cards and their comments" do
+    with_current_user(:david) do
+      draft = boards(:writebook).cards.create! title: "Drafted haggis", creator: users(:david), status: :published
+      draft.comments.create! creator: users(:david), body: "Neeps and tatties"
+      draft.update_column :status, "drafted"
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "tatties")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "show as JSON" do
+    get search_path(q: "logo"), as: :json
+    assert_response :success
+
+    assert_equal [ cards(:logo).number ], response.parsed_body.pluck("number")
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
