diff --git a/app/models/concerns/searchable.rb b/app/models/concerns/searchable.rb
new file mode 100644
index 0000000..f070c35
--- /dev/null
+++ b/app/models/concerns/searchable.rb
@@ -0,0 +1,33 @@
+# Finds records that contain every one of the given terms, matching them
+# against the columns and rich texts each model considers searchable.
+module Searchable
+  extend ActiveSupport::Concern
+
+  ESCAPE_CHARACTER = "\\"
+
+  class_methods do
+    def containing(terms)
+      Array(terms).reduce(all) { |records, term| records.where(matching(term)) }
+    end
+
+    private
+      def like_pattern_for(term)
+        "%#{sanitize_sql_like(term.to_s, ESCAPE_CHARACTER)}%"
+      end
+
+      def like_matching(attribute, pattern)
+        attribute.matches(pattern, ESCAPE_CHARACTER)
+      end
+
+      def rich_text_matching(name, pattern)
+        rich_texts = ActionText::RichText.arel_table
+
+        ActionText::RichText
+          .where(record_type: base_class.name, name: name)
+          .where(rich_texts[:record_id].eq(arel_table[:id]))
+          .where(like_matching(rich_texts[:body], pattern))
+          .select("1")
+          .arel.exists
+      end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..edb1672
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,40 @@
+# Searches the cards someone can see by what's written in them: their title,
+# their description, or the body of any of their comments.
+class Search
+  MAX_TERMS = 10
+  MAX_COMMENTS_PER_CARD = 3
+
+  attr_reader :query, :user
+
+  def initialize(query, user: Current.user)
+    @query, @user = query.to_s.strip, user
+  end
+
+  def terms
+    @terms ||= query.split.first(MAX_TERMS)
+  end
+
+  def present?
+    terms.any?
+  end
+
+  def blank?
+    !present?
+  end
+
+  def cards
+    if present?
+      user.accessible_cards.published.containing(terms).preloaded_for_search.reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  def comments_in(card)
+    if present?
+      card.comments.containing(terms).preloaded_for_search.chronologically.limit(MAX_COMMENTS_PER_CARD)
+    else
+      Comment.none
+    end
+  end
+end
