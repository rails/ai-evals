@@ -0,0 +1,29 @@
+module SearchesHelper
+  def highlight_terms(text, terms)
+    if pattern = terms_pattern(terms)
+      safe_join text.to_s.split(pattern).each_with_index.collect { |part, index| index.odd? ? tag.mark(part) : part }
+    else
+      text.to_s
+    end
+  end
+
+  def search_excerpt(content, terms, radius: 100)
+    if pattern = terms_pattern(terms)
+      if snippet = excerpt(plain_text_for(content), pattern, radius: radius, omission: "…")
+        highlight_terms snippet, terms
+      end
+    end
+  end
+
+  private
+    def terms_pattern(terms)
+      if terms.present?
+        Regexp.new "(#{Array(terms).collect { Regexp.escape(it) }.join("|")})", Regexp::IGNORECASE
+      end
+    end
+
+    def plain_text_for(content)
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text.gsub(/\s+/, " ").strip
+    end
+end
