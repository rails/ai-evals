--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,29 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  include Searchable
+
+  included do
+    scope :preloaded_for_search, -> { with_rich_text_description.preload(:board, :column) }
+  end
+
+  class_methods do
+    private
+      # A card matches a term when it's in its title, its description, or the body of any of its comments.
+      def matching(term)
+        pattern = like_pattern_for(term)
+
+        like_matching(arel_table[:title], pattern)
+          .or(rich_text_matching(:description, pattern))
+          .or(comments_containing(term))
+      end
+
+      def comments_containing(term)
+        Comment
+          .where(Comment.arel_table[:card_id].eq(arel_table[:id]))
+          .containing(term)
+          .select("1")
+          .arel.exists
+      end
+  end
+end
