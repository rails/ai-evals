diff --git a/test/models/account/usage_tracking_test.rb b/test/models/account/usage_tracking_test.rb
new file mode 100644
index 0000000..cddcd8a
--- /dev/null
+++ b/test/models/account/usage_tracking_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Account::UsageTrackingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts(:"37s")
+  end
+
+  test "an account uses everything its boards use" do
+    assert_difference -> { @account.bytes_used }, +3.kilobytes do
+      attach_image_to cards(:logo), bytes: 1.kilobyte
+      attach_image_to cards(:layout), bytes: 2.kilobytes
+      perform_usage_jobs
+    end
+
+    assert_equal boards(:writebook).bytes_used, @account.bytes_used
+  end
+
+  test "destroying a board stops counting what it used" do
+    attach_image_to cards(:logo), bytes: 1.kilobyte
+    perform_usage_jobs
+
+    assert_difference -> { @account.bytes_used }, -1.kilobyte do
+      boards(:writebook).destroy!
+    end
+  end
+
+  test "other accounts are left out of it" do
+    assert_no_difference -> { accounts(:initech).bytes_used } do
+      attach_image_to cards(:logo), bytes: 1.kilobyte
+      perform_usage_jobs
+    end
+  end
+
+  test "recalculating covers every board in the account" do
+    attach_image_to cards(:logo), bytes: 1.kilobyte
+    attach_image_to cards(:text), bytes: 2.kilobytes
+    perform_usage_jobs
+    @account.board_usages.update_all(bytes_used: 0)
+
+    assert_difference -> { @account.bytes_used }, +3.kilobytes do
+      @account.recalculate_usage_later
+      perform_usage_jobs
+    end
+  end
+
+  private
+    # Unrelated background work is left alone, so the assertions are about usage only.
+    def perform_usage_jobs
+      perform_enqueued_jobs only: [ Board::TrackUsageJob, Board::RecalculateUsageJob ]
+    end
+
+    def attach_image_to(card, bytes:)
+      card.image.attach io: StringIO.new("x" * bytes), filename: "image.png", content_type: "image/png"
+    end
+end
diff --git a/test/models/board/usage_tracking_test.rb b/test/models/board/usage_tracking_test.rb
new file mode 100644
index 0000000..efd2e31
--- /dev/null
+++ b/test/models/board/usage_tracking_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class Board::UsageTrackingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "card images count towards the board" do
+    assert_difference -> { @board.bytes_used }, +1.kilobyte do
+      attach_image_to @card, bytes: 1.kilobyte
+      perform_usage_jobs
+    end
+  end
+
+  test "replacing a card image only counts the new one" do
+    attach_image_to @card, bytes: 1.kilobyte
+    perform_usage_jobs
+
+    assert_difference -> { @board.bytes_used }, +1.kilobyte do
+      attach_image_to @card, bytes: 2.kilobytes
+      perform_usage_jobs
+    end
+  end
+
+  test "purging a card image stops counting it" do
+    attach_image_to @card, bytes: 1.kilobyte
+    perform_usage_jobs
+
+    assert_difference -> { @board.bytes_used }, -1.kilobyte do
+      @card.image.purge_later
+      perform_usage_jobs
+    end
+  end
+
+  test "purging a card image right away stops counting it" do
+    attach_image_to @card, bytes: 1.kilobyte
+    perform_usage_jobs
+
+    assert_difference -> { @board.bytes_used }, -1.kilobyte do
+      @card.image.purge
+      perform_usage_jobs
+    end
+  end
+
+  test "files embedded in card descriptions count towards the board" do
+    assert_difference -> { @board.bytes_used }, +1.kilobyte do
+      embed_file_in @card, :description, bytes: 1.kilobyte
+      perform_usage_jobs
+    end
+  end
+
+  test "files embedded in comments count towards the board" do
+    comment = @card.comments.create!(body: "Here you go")
+
+    assert_difference -> { @board.bytes_used }, +1.kilobyte do
+      embed_file_in comment, :body, bytes: 1.kilobyte
+      perform_usage_jobs
+    end
+  end
+
+  test "files embedded in the board description count towards the board" do
+    assert_difference -> { @board.bytes_used }, +1.kilobyte do
+      embed_file_in @board, :public_description, bytes: 1.kilobyte
+      perform_usage_jobs
+    end
+  end
+
+  test "removing an embed from a description stops counting it" do
+    embed_file_in @card, :description, bytes: 1.kilobyte
+    perform_usage_jobs
+
+    assert_difference -> { @board.bytes_used }, -1.kilobyte do
+      @card.update! description: "Never mind"
+      perform_usage_jobs
+    end
+  end
+
+  test "destroying a card stops counting everything on it" do
+    attach_image_to @card, bytes: 1.kilobyte
+    embed_file_in @card.comments.create!(body: "Here you go"), :body, bytes: 2.kilobytes
+    perform_usage_jobs
+
+    assert_difference -> { @board.bytes_used }, -3.kilobytes do
+      @card.destroy!
+      perform_usage_jobs
+    end
+  end
+
+  test "destroying a comment stops counting its embeds" do
+    comment = @card.comments.create!(body: "Here you go")
+    embed_file_in comment, :body, bytes: 1.kilobyte
+    perform_usage_jobs
+
+    assert_difference -> { @board.bytes_used }, -1.kilobyte do
+      comment.destroy!
+      perform_usage_jobs
+    end
+  end
+
+  test "moving a card moves its usage to the new board" do
+    attach_image_to @card, bytes: 1.kilobyte
+    perform_usage_jobs
+
+    assert_difference -> { boards(:private).bytes_used }, +1.kilobyte do
+      assert_difference -> { @board.bytes_used }, -1.kilobyte do
+        @card.move_to boards(:private)
+        perform_usage_jobs
+      end
+    end
+  end
+
+  test "destroying a card that moved stops counting it on the board it moved to" do
+    embed_file_in @card, :description, bytes: 1.kilobyte
+    @card.move_to boards(:private)
+    perform_usage_jobs
+
+    assert_difference -> { boards(:private).bytes_used }, -1.kilobyte do
+      @card.destroy!
+      perform_usage_jobs
+    end
+
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "image variants don't count" do
+    embed_image_in @card, :description
+    perform_usage_jobs
+
+    assert_equal file_fixture("moon.jpg").size, @board.bytes_used
+  end
+
+  test "avatars don't count" do
+    assert_no_difference -> { @board.bytes_used } do
+      users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+      perform_usage_jobs
+    end
+  end
+
+  test "usage is tracked in the background" do
+    attach_image_to @card, bytes: 1.kilobyte
+
+    assert_enqueued_with job: Board::TrackUsageJob, args: [ @board, 1.kilobyte ]
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "recalculating counts everything on the board and its cards" do
+    attach_image_to @card, bytes: 1.kilobyte
+    embed_file_in @card, :description, bytes: 2.kilobytes
+    embed_file_in @card.comments.create!(body: "Here you go"), :body, bytes: 4.kilobytes
+    embed_file_in @board, :public_description, bytes: 8.kilobytes
+    perform_usage_jobs
+
+    @board.usage.update! bytes_used: 42
+
