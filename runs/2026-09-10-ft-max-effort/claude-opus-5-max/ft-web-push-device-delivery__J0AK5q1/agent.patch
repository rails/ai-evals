+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "create subscribes the device that posted its subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://example.com/push/david", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal subscription.id, response.parsed_body["id"]
+  end
+
+  test "create records the browser that subscribed" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params },
+      headers: { "User-Agent" => "Firefox" }
+
+    assert_equal "Firefox", @user.push_subscriptions.last.user_agent
+  end
+
+  test "create accepts JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create refreshes a device that subscribes again" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params.merge(auth_key: "new-auth-key") }
+    end
+
+    assert_equal "new-auth-key", @user.push_subscriptions.last.auth_key
+  end
+
+  test "create requires a subscription" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "" } }
+
+    assert_response :bad_request
+  end
+
+  test "create is forbidden for someone else's devices" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy unsubscribes the device" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }
+    subscription = @user.push_subscriptions.last
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for someone else's devices" do
+    subscription = Push::Subscription.create!(user: users(:kevin), **subscription_params)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(users(:kevin), subscription)
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscription_params
+      { endpoint: "https://example.com/push/david", p256dh_key: "p256dh-key", auth_key: "auth-key" }
+    end
+end
