diff --git a/lib/tasks/push.rake b/lib/tasks/push.rake
new file mode 100644
index 0000000..902a3ad
--- /dev/null
+++ b/lib/tasks/push.rake
@@ -0,0 +1,11 @@
+namespace :push do
+  desc "Generate the VAPID key pair that signs push notifications"
+  task :vapid_keys do
+    require "web_push"
+
+    key = WebPush.generate_key
+
+    puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+    puts "VAPID_PRIVATE_KEY=#{key.private_key}"
+  end
+end
