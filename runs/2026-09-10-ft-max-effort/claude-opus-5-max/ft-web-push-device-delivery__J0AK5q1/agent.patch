diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b0588f6
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,115 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const SUBSCRIPTION_ID_KEY = "push-subscription-id"
+
+// Subscribes this device to push notifications, and keeps the settings panel in
+// sync with what the browser is actually willing to do.
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = { url: String, publicKey: String }
+  static classes = [ "on" ]
+
+  #subscription = undefined // Until the push manager tells us what it has
+
+  async connect() {
+    this.#render()
+
+    if (this.#supported) {
+      this.#subscription = await this.#pushSubscription()
+      if (this.#subscribed) await this.#register()
+
+      this.#render()
+    }
+  }
+
+  async subscribe() {
+    if (this.#supported && await this.#permitted()) {
+      this.#subscription = await this.#subscribeToPushService()
+      if (this.#subscription) await this.#register()
+    }
+
+    this.#render()
+  }
+
+  async unsubscribe() {
+    await this.#subscription?.unsubscribe()
+    this.#subscription = null
+    await this.#unregister()
+
+    this.#render()
+  }
+
+  // Private
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // Permission is enough to show the on state while we look the subscription up.
+  get #subscribed() {
+    return this.#supported && Notification.permission === "granted" && this.#subscription !== null
+  }
+
+  // Browsers that can't do push, or that have been told not to, need a hand.
+  get #blocked() {
+    return !this.#supported || Notification.permission === "denied"
+  }
+
+  async #permitted() {
+    return await Notification.requestPermission() === "granted"
+  }
+
+  async #pushSubscription() {
+    const registration = await navigator.serviceWorker.ready
+
+    return await registration.pushManager.getSubscription()
+  }
+
+  async #subscribeToPushService() {
+    const registration = await navigator.serviceWorker.ready
+
+    try {
+      return await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    } catch {
+      return null
+    }
+  }
+
+  async #register() {
+    const { endpoint, keys } = this.#subscription.toJSON()
+
+    const response = await post(this.urlValue, {
+      body: JSON.stringify({ push_subscription: { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } }),
+      contentType: "application/json",
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const { id } = await response.json
+      localStorage.setItem(SUBSCRIPTION_ID_KEY, id)
+    }
+  }
+
+  async #unregister() {
+    const id = localStorage.getItem(SUBSCRIPTION_ID_KEY)
+
+    if (id) {
+      await destroy(`${this.urlValue}/${id}`, { responseKind: "json" })
+      localStorage.removeItem(SUBSCRIPTION_ID_KEY)
+    }
+  }
+
+  // Some browsers only take the VAPID public key as bytes.
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+
+  #render() {
+    this.element.classList.toggle(this.onClass, this.#subscribed)
+    this.detailsTargets.forEach(details => details.hidden = !this.#blocked)
+  }
+}
