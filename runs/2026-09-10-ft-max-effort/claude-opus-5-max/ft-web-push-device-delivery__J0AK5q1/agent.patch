diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..8d9f3f0
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  ENDPOINT = "https://example.com/push"
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @subscription = subscribe(users(:david), endpoint: ENDPOINT)
+  end
+
+  test "register subscribes a device for the user" do
+    assert_difference -> { users(:kevin).push_subscriptions.count }, 1 do
+      Push::Subscription.register(user: users(:kevin), user_agent: "Firefox", **subscription_keys.merge(endpoint: "#{ENDPOINT}/kevin"))
+    end
+
+    subscription = users(:kevin).push_subscriptions.last
+    assert_equal "#{ENDPOINT}/kevin", subscription.endpoint
+    assert_equal "Firefox", subscription.user_agent
+    assert_equal users(:kevin).account, subscription.account
+  end
+
+  test "register refreshes the keys of a device that subscribes again" do
+    assert_no_difference -> { users(:david).push_subscriptions.count } do
+      Push::Subscription.register(user: users(:david), user_agent: "Safari", **subscription_keys.merge(endpoint: ENDPOINT))
+    end
+
+    assert_equal "Safari", @subscription.reload.user_agent
+  end
+
+  test "the same device can subscribe for more than one user" do
+    assert_difference -> { Push::Subscription.count }, 1 do
+      Push::Subscription.register(user: users(:kevin), **subscription_keys.merge(endpoint: ENDPOINT))
+    end
+  end
+
+  test "deliver posts the payload to the push service, pinned to the resolved address" do
+    stub_dns_resolution PUBLIC_IP
+    request = stub_request(:post, ENDPOINT).with(ipaddr: PUBLIC_IP).to_return(status: 201)
+
+    @subscription.deliver(payload)
+
+    assert_requested request
+  end
+
+  test "deliver signs the payload with the VAPID key pair" do
+    key = WebPush.generate_key
+
+    with_env "VAPID_PUBLIC_KEY" => key.public_key, "VAPID_PRIVATE_KEY" => key.private_key do
+      stub_dns_resolution PUBLIC_IP
+      request = stub_request(:post, ENDPOINT).with { |signed|
+        signed.headers["Authorization"].start_with?("vapid t=") && signed.headers["Content-Encoding"] == "aes128gcm"
+      }.to_return(status: 201)
+
+      @subscription.deliver(payload)
+
+      assert_requested request
+    end
+  end
+
+  test "deliver forgets subscriptions the push service has dropped" do
+    stub_dns_resolution PUBLIC_IP
+    stub_request(:post, ENDPOINT).to_return(status: 410)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(payload)
+    end
+  end
+
+  test "deliver keeps the subscription when the push service is having trouble" do
+    stub_dns_resolution PUBLIC_IP
+    stub_request(:post, ENDPOINT).to_return(status: 500)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      @subscription.deliver(payload)
+    end
+  end
+
+  test "deliver skips endpoints that resolve to a private address" do
+    stub_dns_resolution "127.0.0.1"
+    request = stub_request(:post, ENDPOINT)
+
+    @subscription.deliver(payload)
+
+    assert_not_requested request
+  end
+
+  test "deliver shrugs off push services that can't be reached" do
+    stub_dns_resolution PUBLIC_IP
+    stub_request(:post, ENDPOINT).to_timeout
+
+    assert_nothing_raised do
+      @subscription.deliver(payload)
+    end
+  end
+
+  test "deliver drops subscriptions whose keys can't encrypt a payload" do
+    @subscription.update! p256dh_key: "not-a-key"
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(payload)
+    end
+  end
+
+  test "an endpoint is required" do
+    assert_not Push::Subscription.new(user: users(:david), **subscription_keys).valid?
+  end
+
+  private
+    def payload
+      Push::Payload.new(title: "Layout is broken", body: "Assigned to you", path: "/1/cards/2")
+    end
+
+    def subscribe(user, endpoint:)
+      Push::Subscription.create! user: user, endpoint: endpoint, **subscription_keys
+    end
+
+    def with_env(variables)
+      original = ENV.to_h.slice(*variables.keys)
+      ENV.update(variables)
+      yield
+    ensure
+      variables.each_key { |key| ENV.delete(key) }
+      ENV.update(original)
+    end
+
+    def subscription_keys
+      key = OpenSSL::PKey::EC.generate("prime256v1")
+
+      { p256dh_key: Base64.urlsafe_encode64(key.public_key.to_bn.to_s(2)), auth_key: Base64.urlsafe_encode64(Random.bytes(16)) }
+    end
+end
