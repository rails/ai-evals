@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @user = users(:jz)
+    @subscription = subscribe(@user)
+  end
+
+  test "a notification reaches the devices someone subscribed" do
+    stub_dns_resolution PUBLIC_IP
+    request = stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+    perform_enqueued_jobs do
+      notify @user, source: events(:layout_commented)
+    end
+
+    assert_requested request
+  end
+
+  test "being notified again about the same card pushes again" do
+    notification = notify(@user, source: events(:layout_commented))
+
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      notification.update! source: events(:layout_published), creator: users(:david), read_at: nil
+    end
+  end
+
+  test "reading a notification doesn't push" do
+    notification = notify(@user, source: events(:layout_commented))
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+    end
+  end
+
+  test "notifications for someone without a subscribed device don't push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notify users(:kevin), source: events(:text_published)
+    end
+  end
+
+  private
+    def notify(user, source:)
+      Notification.create! user: user, source: source, creator: users(:david)
+    end
+
+    def subscribe(user)
+      key = OpenSSL::PKey::EC.generate("prime256v1")
+
+      Push::Subscription.create! user: user, endpoint: "https://example.com/push/#{user.id}",
+        p256dh_key: Base64.urlsafe_encode64(key.public_key.to_bn.to_s(2)),
+        auth_key: Base64.urlsafe_encode64(Random.bytes(16))
+    end
+end
