new file mode 100644
index 0000000..f482d25
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,22 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit -> { push_later }
+    after_update_commit -> { push_later if source_id_previously_changed? }
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if pushable?
+  end
+
+  def push_now
+    payload = Push::Payload.for(self)
+    user.push_subscriptions.each { |subscription| subscription.deliver(payload) }
+  end
+
+  private
+    def pushable?
+      Push.enabled? && user.push_subscriptions.exists?
+    end
+end
diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..1407d8a
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,42 @@
+# Web push delivery is signed with a VAPID key pair that identifies this
+# instance to the push services the browsers subscribe to. Ops provides the
+# pair as VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY, and local environments fall back
+# to a throwaway pair so push can be exercised without any setup.
+module Push
+  DEFAULT_SUBJECT = "https://fizzy.do"
+
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence || local_vapid_key&.public_key
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence || local_vapid_key&.private_key
+    end
+
+    def vapid_subject
+      ENV["VAPID_SUBJECT"].presence || ENV["BASE_URL"].presence || DEFAULT_SUBJECT
+    end
+
+    def vapid_credentials
+      if enabled?
+        { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+      else
+        {}
+      end
+    end
+
+    private
+      def local_vapid_key
+        @local_vapid_key ||= WebPush.generate_key if Rails.env.local?
+      end
+  end
+end
diff --git a/app/models/push/payload.rb b/app/models/push/payload.rb
new file mode 100644
index 0000000..950ee35
--- /dev/null
+++ b/app/models/push/payload.rb
@@ -0,0 +1,37 @@
+# What a push notification says, and where it takes you when you tap it. The
+# title and body are the ones the notification tray shows, so a push reads like
+# the tray does.
+class Push::Payload
+  attr_reader :title, :body, :path
+
+  class << self
+    def for(notification)
+      new \
+        title: helpers.notification_title(notification),
+        body: helpers.notification_body(notification),
+        path: path_for(notification)
+    end
+
+    private
+      def helpers
+        ApplicationController.helpers
+      end
+
+      def path_for(notification)
+        Rails.application.routes.url_helpers.polymorphic_path \
+          notification.notifiable_target, script_name: notification.account.slug, only_path: true
+      end
+  end
+
+  def initialize(title:, body:, path:)
+    @title, @body, @path = title, body, path
+  end
+
+  def to_h
+    { title: title, options: { body: body, data: { path: path } } }
+  end
+
+  def to_json(*args)
+    to_h.to_json(*args)
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..81ed7f8
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,100 @@
+# A browser's subscription to a push service, registered from the notification
+# settings of the device someone wants to hear about notifications on.
+class Push::Subscription < ApplicationRecord
+  ENDPOINT_TIMEOUT = 5.seconds
+  TIME_TO_LIVE = 24.hours
+  URGENCY = "high"
+
+  DELIVERY_ERRORS = [
+    Net::OpenTimeout, Net::ReadTimeout, Net::ProtocolError, Net::HTTPBadResponse,
+    Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH, Errno::EPERM, Errno::ETIMEDOUT,
+    EOFError, SocketError, OpenSSL::SSL::SSLError
+  ].freeze
+
+  # Keys that can't encrypt a payload will never work, so the subscription goes.
+  UNUSABLE_KEY_ERRORS = [ ArgumentError, OpenSSL::OpenSSLError ].freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  def self.register(user:, endpoint:, p256dh_key:, auth_key:, user_agent: nil)
+    user.push_subscriptions.find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+      subscription.update! p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent
+    end
+  end
+
+  def deliver(payload)
+    if endpoint_blocked?
+      logger.warn "Skipped a push notification to a private endpoint: #{uri.host}"
+    else
+      process post(payload)
+    end
+  rescue *DELIVERY_ERRORS => error
+    logger.warn "Push notification to #{uri.host} failed: #{error.class}"
+  rescue *UNUSABLE_KEY_ERRORS => error
+    logger.warn "Push subscription #{id} can't be encrypted for: #{error.class}"
+    destroy
+  end
+
+  private
+    def post(payload)
+      http.request request_for(payload)
+    end
+
+    def request_for(payload)
+      signed_request = WebPush::Request.new \
+        message: payload.to_json,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: Push.vapid_credentials,
+        ttl: TIME_TO_LIVE.to_i,
+        urgency: URGENCY
+
+      Net::HTTP::Post.new(uri, signed_request.headers).tap { |request| request.body = signed_request.body }
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = pinned_ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def uri
+      @uri ||= URI(endpoint)
+    end
+
+    def endpoint_blocked?
+      resolved_ip == :blocked
+    end
+
+    def pinned_ip
+      resolved_ip unless endpoint_blocked?
+    end
+
+    # Push services are third-party hosts, so their address is vetted once and
+    # then pinned for the request itself. A resolver that's down doesn't tell us
+    # the endpoint is private, so those deliveries go ahead with Net::HTTP's own
+    # lookup.
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+      @resolved_ip = SsrfProtection.resolve_public_ip(uri.host) || :blocked
+    rescue Resolv::ResolvError, Resolv::ResolvTimeout, SocketError, SystemCallError
+      @resolved_ip = nil
+    end
+
+    def process(response)
+      case response
+      when Net::HTTPSuccess
+        response
+      when Net::HTTPNotFound, Net::HTTPGone
+        destroy # The push service forgot this subscription, so stop pushing to it
+      else
+        logger.warn "Push notification to #{uri.host} was rejected: #{response.code}"
+      end
+    end
+end
