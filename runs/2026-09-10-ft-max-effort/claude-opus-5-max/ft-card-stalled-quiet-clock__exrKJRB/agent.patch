diff --git a/app/models/card/bursting.rb b/app/models/card/bursting.rb
new file mode 100644
index 0000000..23addce
--- /dev/null
+++ b/app/models/card/bursting.rb
@@ -0,0 +1,39 @@
+# Cards draw a burst of attention when several people pile comments on them in a
+# short time, or when someone puts their name on them by assigning or reopening
+# them. We remember the burst so we can tell when a card goes cold afterwards.
+# See Card::Stalling.
+module Card::Bursting
+  extend ActiveSupport::Concern
+
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  BURST_WINDOW_DIVISOR = 3 # Bursts are measured over a third of the board's auto-close period
+
+  included do
+    scope :bursted, -> { where.not(burst_at: nil) }
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def record_burst_from(event)
+    update! burst_at: event.created_at if bursting_event?(event)
+  end
+
+  private
+    def bursting_event?(event)
+      event.action.card_assigned? || event.action.card_reopened? ||
+        (event.action.comment_created? && flurry_of_comments?)
+    end
+
+    def flurry_of_comments?
+      comments_per_commenter = comments.by_user.where(created_at: burst_window.ago..).group(:creator_id).count
+
+      comments_per_commenter.values.sum >= BURST_COMMENTS && comments_per_commenter.size >= BURST_COMMENTERS
+    end
+
+    def burst_window
+      (auto_postpone_period / BURST_WINDOW_DIVISOR).seconds
+    end
+end
