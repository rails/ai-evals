diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..75a38b4
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,20 @@
+# A card that drew a burst of attention (see Card::Bursting) and then went quiet
+# for a fortnight has stalled. Any activity on the card resets the countdown.
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { active.bursted.where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    stalls_at.present? && stalls_at <= Time.current
+  end
+
+  # When a card that drew a burst of attention will stall, unless something happens to it first
+  def stalls_at
+    last_active_at + STALL_PERIOD if active? && burst?
+  end
+end
