diff --git a/test/models/card/bursting_test.rb b/test/models/card/bursting_test.rb
new file mode 100644
index 0000000..a7cc03e
--- /dev/null
+++ b/test/models/card/bursting_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Card::BurstingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "three comments from two people within a third of the auto-close period are a burst" do
+    comment_on @card, as: :david
+    comment_on @card, as: :david
+    assert_not @card.reload.burst?
+
+    comment_on @card, as: :kevin
+    assert @card.reload.burst?
+  end
+
+  test "comments from a single person are not a burst" do
+    3.times { comment_on @card, as: :david }
+
+    assert_not @card.reload.burst?
+  end
+
+  test "comments spread beyond a third of the auto-close period are not a burst" do
+    comment_on @card, as: :david
+    comment_on @card, as: :kevin
+
+    travel @card.board.auto_postpone_period.seconds / 3 + 1.day
+    comment_on @card, as: :david
+
+    assert_not @card.reload.burst?
+  end
+
+  test "system comments don't count towards a burst" do
+    comment_on @card, as: :david
+    comment_on @card, as: :kevin
+    @card.comments.create! body: "Kevin triaged this", creator: users(:system)
+
+    assert_not @card.reload.burst?
+  end
+
+  test "assigning someone is a burst" do
+    assert_changes -> { @card.reload.burst? }, to: true do
+      @card.toggle_assignment users(:kevin)
+    end
+  end
+
+  test "reopening is a burst, closing isn't" do
+    @card.close
+    assert_not @card.reload.burst?
+
+    @card.reopen
+    assert @card.reload.burst?
+  end
+
+  private
+    def comment_on(card, as:)
+      with_current_user(as) { card.comments.create! body: "Thoughts?" }
+    end
+end
diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..6076a7f
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+  end
+
+  test "a card that burst and then went quiet for two weeks has stalled" do
+    @card.toggle_assignment users(:kevin)
+    assert_not @card.stalled?
+
+    travel Card::Stalling::STALL_PERIOD
+    assert @card.reload.stalled?
+  end
+
+  test "a card that never burst doesn't stall" do
+    travel 1.year
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "activity resets a stalled card" do
+    @card.toggle_assignment users(:kevin)
+    travel Card::Stalling::STALL_PERIOD
+
+    assert_changes -> { @card.reload.stalled? }, to: false do
+      with_current_user(:kevin) { @card.comments.create! body: "Still on it" }
+    end
+
+    travel Card::Stalling::STALL_PERIOD
+    assert @card.reload.stalled?
+  end
+
+  test "closed and postponed cards don't stall" do
+    @card.toggle_assignment users(:kevin)
+    @card.close
+    travel Card::Stalling::STALL_PERIOD
+    assert_not @card.reload.stalled?
+
+    @card.postpone
+    travel Card::Stalling::STALL_PERIOD
+    assert_not @card.reload.stalled?
+  end
+
+  test "listing stalled cards" do
+    @card.toggle_assignment users(:kevin)
+    travel Card::Stalling::STALL_PERIOD
+
+    assert_equal [ @card ], Card.stalled.to_a
+    assert_equal [ @card ], Card.indexed_by("stalled").to_a
+  end
+end
