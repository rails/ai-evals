+class Admin::AccountsController < AdminController
+  include Admin::AccountScoped
+  skip_before_action :set_account, only: :index
+
+  layout "public"
+
+  ACCOUNTS_SHOWN = 100
+
+  def index
+    @accounts = filtered_accounts.includes(:subscription, :billing_waiver, :overridden_limits)
+      .order(created_at: :desc).limit(ACCOUNTS_SHOWN)
+  end
+
+  def show
+  end
+
+  private
+    def filtered_accounts
+      if query.present?
+        Account.where("name LIKE ?", "%#{Account.sanitize_sql_like(query)}%").or(Account.where(external_account_id: query.to_i))
+      else
+        Account.all
+      end
+    end
+
+    def query
+      params[:query].to_s.strip
+    end
+end
