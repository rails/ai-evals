diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..0710a22
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+require_relative "../../test_helpers/billing_test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  include BillingTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "a completed checkout records the Stripe customer" do
+    Account::Subscription.process stripe_event("checkout.session.completed",
+      object: { object: "checkout.session", client_reference_id: @account.id, customer: "cus_123", subscription: "sub_123" })
+
+    subscription = @account.reload_subscription
+
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+  end
+
+  test "a new subscription records the plan it bought" do
+    with_stripe_price_ids do
+      Account::Subscription.process stripe_event("customer.subscription.created",
+        object: stripe_subscription_object(account: @account, price_id: "price_monthly_v1",
+          current_period_end: 30.days.from_now.to_i))
+    end
+
+    subscription = @account.reload_subscription
+
+    assert_equal "monthly_v1", subscription.plan_key
+    assert_equal Subscription::MonthlyV1, subscription.plan
+    assert_equal "active", subscription.status
+    assert subscription.active?
+    assert_in_delta 30.days.from_now, subscription.current_period_end, 5
+    assert_equal Subscription::MonthlyV1, @account.reload.plan
+  end
+
+  test "an upgrade moves an account onto the new plan" do
+    with_stripe_price_ids do
+      subscription = subscribe_to "monthly_v1"
+
+      Account::Subscription.process stripe_event("customer.subscription.updated",
+        object: stripe_subscription_object(account: @account, price_id: "price_monthly_extra_storage_v1",
+          id: subscription.stripe_subscription_id, customer: subscription.stripe_customer_id))
+
+      assert_equal "monthly_extra_storage_v1", subscription.reload.plan_key
+      assert_equal 500.gigabytes, @account.reload.storage_limit
+    end
+  end
+
+  test "billing periods can arrive on the subscription item" do
+    with_stripe_price_ids do
+      object = stripe_subscription_object(account: @account, price_id: "price_monthly_v1")
+      object[:items][:data][0][:current_period_end] = 14.days.from_now.to_i
+
+      Account::Subscription.process stripe_event("customer.subscription.updated", object: object)
+    end
+
+    assert_in_delta 14.days.from_now, @account.reload_subscription.current_period_end, 5
+  end
+
+  test "a deleted subscription drops the account back to free" do
+    with_stripe_price_ids do
+      subscription = subscribe_to "monthly_v1"
+
+      Account::Subscription.process stripe_event("customer.subscription.deleted",
+        object: stripe_subscription_object(account: @account, price_id: "price_monthly_v1",
+          id: subscription.stripe_subscription_id, customer: subscription.stripe_customer_id,
+          status: "canceled", cancel_at: Time.current.to_i))
+
+      assert_equal "canceled", subscription.reload.status
+      assert_not subscription.active?
+      assert subscription.cancelling?
+      assert @account.reload.free?
+    end
+  end
+
+  test "subscriptions are found by their Stripe customer when metadata is missing" do
+    with_stripe_price_ids do
+      subscription = subscribe_to "monthly_v1"
+      object = stripe_subscription_object(account: @account, price_id: "price_monthly_extra_storage_v1",
+        id: subscription.stripe_subscription_id, customer: subscription.stripe_customer_id)
+      object.delete(:metadata)
+
+      Account::Subscription.process stripe_event("customer.subscription.updated", object: object)
+
+      assert_equal "monthly_extra_storage_v1", subscription.reload.plan_key
+    end
+  end
+
+  test "an upcoming invoice records what's due next" do
+    subscription = subscribe_to "monthly_v1"
+
+    Account::Subscription.process stripe_event("invoice.upcoming",
+      object: { object: "invoice", customer: subscription.stripe_customer_id, amount_due: 2_000 })
+
+    assert_equal 2_000, subscription.reload.next_amount_due_in_cents
+    assert_equal 20.0, subscription.next_amount_due
+  end
+
+  test "events for unknown accounts are ignored" do
+    assert_no_difference -> { Account::Subscription.count } do
+      Account::Subscription.process stripe_event("customer.subscription.created",
+        object: { object: "subscription", id: "sub_nobody", customer: "cus_nobody", status: "active" })
+    end
+  end
+
+  private
+    def stripe_event(type, object:)
+      Stripe::Event.construct_from(id: "evt_#{SecureRandom.hex(8)}", type: type, data: { object: object })
+    end
+end
diff --git a/saas/test/test_helpers/billing_test_helper.rb b/saas/test/test_helpers/billing_test_helper.rb
new file mode 100644
index 0000000..afcfae3
--- /dev/null
+++ b/saas/test/test_helpers/billing_test_helper.rb
@@ -0,0 +1,58 @@
+module BillingTestHelper
+  def subscribe_to(plan_key, account: @account, status: "active", **attributes)
+    account.subscription&.destroy
+    account.reload_subscription
+
+    account.create_subscription! \
+      plan_key: plan_key,
+      status: status,
+      stripe_customer_id: "cus_#{SecureRandom.hex(8)}",
+      stripe_subscription_id: "sub_#{SecureRandom.hex(8)}",
+      **attributes
+  end
+
+  def stripe_subscription_object(account:, price_id:, status: "active", **attributes)
+    {
+      id: "sub_#{SecureRandom.hex(8)}",
+      object: "subscription",
+      customer: "cus_#{SecureRandom.hex(8)}",
+      status: status,
+      metadata: { account_id: account.id },
+      items: { object: "list", data: [ { id: "si_#{SecureRandom.hex(8)}", price: { id: price_id } } ] },
+      **attributes
+    }
+  end
+
+  def post_stripe_webhook(type, object, secret: ENV["STRIPE_WEBHOOK_SECRET"])
+    payload = { id: "evt_#{SecureRandom.hex(8)}", type: type, data: { object: object } }.to_json
+
+    post "/stripe/webhooks", params: payload, headers: {
+      "CONTENT_TYPE" => "application/json",
+      "Stripe-Signature" => stripe_signature_header(payload, secret)
+    }
+  end
+
+  def stripe_signature_header(payload, secret)
+    timestamp = Time.current
+    signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret.to_s)
+    Stripe::Webhook::Signature.generate_header(timestamp, signature)
+  end
+
+  def with_stripe_webhook_secret(secret = "whsec_testing_secret")
+    previous = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = secret
+    yield secret
+  ensure
+    ENV["STRIPE_WEBHOOK_SECRET"] = previous
+  end
+
+  def with_stripe_price_ids(monthly: "price_monthly_v1", extra_storage: "price_monthly_extra_storage_v1")
+    previous = ENV.slice("STRIPE_MONTHLY_V1_PRICE_ID", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = monthly
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = extra_storage
+    yield
+  ensure
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = previous["STRIPE_MONTHLY_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = previous["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+  end
+end
