+require "test_helper"
+require_relative "../../test_helpers/billing_test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  include BillingTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :david
+  end
+
+  test "index lists the accounts by name" do
+    untenanted do
+      get saas.admin_accounts_path
+
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+      assert_select "a", text: accounts(:"37s").name
+    end
+  end
+
+  test "index searches by name and by account id" do
+    untenanted do
+      get saas.admin_accounts_path(query: "Initech")
+
+      assert_response :success
+      assert_select "a", text: @account.name
+      assert_select "a", text: accounts(:"37s").name, count: 0
+
+      get saas.admin_accounts_path(query: accounts(:"37s").external_account_id)
+
+      assert_select "a", text: accounts(:"37s").name
+      assert_select "a", text: @account.name, count: 0
+    end
+  end
+
+  test "index is only for support" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+
+      assert_response :forbidden
+    end
+  end
+
+  test "show has the account's plan and usage" do
+    @account.update_column :cards_count, 250
+    subscribe_to "monthly_v1"
+
+    untenanted do
+      get saas.admin_account_path(@account)
+
+      assert_response :success
+      assert_select "li", text: /Unlimited/
+      assert_select "li", text: /250/
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "show finds accounts by their queenbee id too" do
+    untenanted do
+      get saas.admin_account_path(@account.external_account_id)
+
+      assert_response :success
+      assert_select "h1", text: /#{@account.name}/
+    end
+  end
+
+  test "show is only for support" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_account_path(@account)
+
+      assert_response :forbidden
+    end
+  end
+
+  test "comping and uncomping an account" do
+    untenanted do
+      post saas.admin_account_comp_path(@account)
+
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+
+      delete saas.admin_account_comp_path(@account)
+
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "comping is only for support" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      post saas.admin_account_comp_path(@account)
+
+      assert_response :forbidden
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "overriding and resetting what an account counts as using" do
+    @account.update_column :cards_count, 1_200
+
+    untenanted do
+      post saas.admin_account_overridden_limits_path(@account), params: { card_count: 300, bytes_used: 2.gigabytes }
+
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_equal 300, @account.reload.card_count
+      assert_equal 2.gigabytes, @account.bytes_used
+      assert_not @account.exceeding_card_limit?
+
+      delete saas.admin_account_overridden_limits_path(@account)
+
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_nil @account.reload.overridden_limits
+      assert_equal 1_200, @account.card_count
+    end
+  end
+
+  test "overriding accepts nested params" do
+    untenanted do
+      post saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 42 } }
+
+      assert_equal 42, @account.reload.card_count
+    end
+  end
+
+  test "overriding is only for support" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      post saas.admin_account_overridden_limits_path(@account), params: { card_count: 1 }
+
+      assert_response :forbidden
+      assert_nil @account.reload.overridden_limits
+    end
+  end
+end
