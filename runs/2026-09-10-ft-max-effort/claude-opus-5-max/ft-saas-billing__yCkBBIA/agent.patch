diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..7b17464
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,97 @@
+# What Stripe knows about an account, mirrored here. Stripe is the source of truth:
+# checkout and the customer portal live over there, and every change comes back to
+# us as a webhook that lands in +process+.
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ]
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  class << self
+    def process(event)
+      case event.type
+      when "checkout.session.completed"
+        record_checkout event.data.object
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        record_subscription event.data.object
+      when "invoice.upcoming"
+        record_next_amount_due event.data.object
+      end
+    end
+
+    private
+      def record_checkout(session)
+        if account = Account.find_by(id: session[:client_reference_id])
+          for_account(account).update! stripe_customer_id: session[:customer],
+            stripe_subscription_id: session[:subscription]
+        end
+      end
+
+      def record_subscription(subscription)
+        if account = account_for(subscription)
+          for_account(account).update! stripe_customer_id: subscription[:customer],
+            stripe_subscription_id: subscription[:id],
+            plan_key: plan_key_for(subscription),
+            status: subscription[:status],
+            current_period_end: time_at(period_end_for(subscription)),
+            cancel_at: time_at(subscription[:cancel_at])
+        end
+      end
+
+      def record_next_amount_due(invoice)
+        find_by(stripe_customer_id: invoice[:customer])&.update! next_amount_due_in_cents: invoice[:amount_due]
+      end
+
+      def for_account(account)
+        account.subscription || account.build_subscription
+      end
+
+      def account_for(subscription)
+        Account.find_by(id: subscription[:metadata]&.[](:account_id)) ||
+          find_by(stripe_customer_id: subscription[:customer])&.account
+      end
+
+      def plan_key_for(subscription)
+        ::Subscription.find_by_stripe_price_id(price_id_for(subscription))&.key
+      end
+
+      def price_id_for(subscription)
+        first_item_of(subscription)&.[](:price)&.[](:id)
+      end
+
+      # Stripe moved the billing period onto the subscription's items, but older API
+      # versions still report it on the subscription itself.
+      def period_end_for(subscription)
+        subscription[:current_period_end] || first_item_of(subscription)&.[](:current_period_end)
+      end
+
+      def first_item_of(subscription)
+        subscription[:items]&.[](:data)&.first
+      end
+
+      def time_at(seconds)
+        Time.at(seconds).utc if seconds.present?
+      end
+  end
+
+  def plan
+    ::Subscription.find(plan_key) || ::Subscription.default
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def cancelling?
+    cancel_at.present?
+  end
+
+  def next_amount_due
+    next_amount_due_in_cents / 100.0 if next_amount_due_in_cents.present?
+  end
+
+  def cancel
+    ::Stripe::Subscription.cancel(stripe_subscription_id) if stripe_subscription_id.present?
+  end
+end
