diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..f0fa831
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,32 @@
+# Stripe hosts checkout and the customer portal, then tells us what happened here.
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  before_action :set_event
+
+  def create
+    Account::Subscription.process(@event)
+
+    head :ok
+  end
+
+  private
+    def set_event
+      @event = ::Stripe::Webhook.construct_event signature_payload, signature_header, signature_secret
+    rescue JSON::ParserError, ::Stripe::SignatureVerificationError => error
+      logger.warn "[Stripe] Rejected webhook: #{error.message}"
+      head :bad_request
+    end
+
+    def signature_payload
+      request.raw_post
+    end
+
+    def signature_header
+      request.headers["Stripe-Signature"].to_s
+    end
+
+    def signature_secret
+      ENV.fetch("STRIPE_WEBHOOK_SECRET", "")
+    end
+end
