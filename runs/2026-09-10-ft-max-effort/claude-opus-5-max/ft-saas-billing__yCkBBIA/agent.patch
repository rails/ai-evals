+            <strong><%= link_to account.name, saas.admin_account_path(account) %></strong>
+            <br>
+            <span class="txt-x-small txt-ink-medium">
+              #<%= account.external_account_id %> •
+              <%= account.owner_email || "No owner" %>
+            </span>
+          </div>
+
+          <div class="txt-medium txt-ink-medium" style="text-align: right">
+            <%= account.plan.proper_name %>
+            <span class="txt-x-small">
+              <%= number_with_delimiter(account.card_count) %> cards
+            </span>
+          </div>
+        </li>
+      <% end %>
+
+      <% if @accounts.none? %>
