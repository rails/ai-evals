diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..bb1fd20
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,108 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_subscription
+  end
+
+  def plan
+    if comped?
+      Subscription::MonthlyExtraStorageV1
+    else
+      active_subscription&.plan || Subscription.default
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def upgrades
+    comped? ? [] : Subscription.upgrades_from(plan)
+  end
+
+  def upgradable?
+    upgrades.any?
+  end
+
+  def paid?
+    active_subscription.present? || comped?
+  end
+
+  def free?
+    !paid?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(comped)
+    comped ? comp : uncomp
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    reload_billing_waiver
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attributes = { card_count: card_count.presence, bytes_used: bytes_used.presence }
+
+    if overridden_limits
+      overridden_limits.update!(attributes)
+    else
+      create_overridden_limits!(attributes)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy
+    reload_overridden_limits
+  end
+
+  # Checkout and the customer portal are hosted by Stripe: we hand people a URL and
+  # hear back about what they did through the webhooks.
+  def checkout_url(plan:, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create(
+      mode: "subscription",
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      client_reference_id: id,
+      success_url: success_url,
+      cancel_url: cancel_url,
+      subscription_data: { metadata: { account_id: id, queenbee_id: queenbee_id } },
+      **stripe_customer_params
+    ).url
+  end
+
+  def billing_portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  private
+    def stripe_customer_params
+      if stripe_customer_id.present?
+        { customer: stripe_customer_id }
+      else
+        { customer_email: owner_email, customer_creation: "always" }
+      end
+    end
+
+    def cancel_subscription
+      active_subscription&.cancel
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, handled: true)
+    end
+end
