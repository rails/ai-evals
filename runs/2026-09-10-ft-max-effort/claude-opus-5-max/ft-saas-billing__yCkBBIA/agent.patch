diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..321fbb2
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,66 @@
+#!/usr/bin/env ruby
+#
+# Fetches Stripe credentials from 1Password and starts a webhook tunnel for
+# development. The Stripe CLI prints the signing secret for the tunnel when it
+# starts, so we read it back out of the log and export it alongside the keys.
+#
+# Usage: eval "$(bundle exec stripe-dev)"
+
+require "fileutils"
+require "timeout"
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+
+FORWARD_TO = ENV.fetch("STRIPE_FORWARD_TO", "localhost:3006/stripe/webhooks")
+LOG_PATH = File.expand_path("../../log/stripe-listen.log", __dir__)
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/Development/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+def fail_with(message)
+  warn "Error: #{message}"
+  exit 1
+end
+
+secret_key = op_read("STRIPE_SECRET_KEY")
+monthly_price_id = op_read("STRIPE_MONTHLY_V1_PRICE_ID")
+extra_storage_price_id = op_read("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+
+if [ secret_key, monthly_price_id, extra_storage_price_id ].any?(&:empty?)
+  warn "Make sure you are signed in: op signin --account #{OP_ACCOUNT}"
+  fail_with "Could not fetch the Stripe credentials from 1Password"
+end
+
+fail_with "Could not find the Stripe CLI. Install it: https://stripe.com/docs/stripe-cli" unless system("which stripe > /dev/null 2>&1")
+
+FileUtils.mkdir_p File.dirname(LOG_PATH)
+File.write LOG_PATH, ""
+
+pid = Process.spawn "stripe", "listen", "--api-key", secret_key, "--forward-to", FORWARD_TO,
+  out: LOG_PATH, err: [ :child, :out ]
+Process.detach pid
+
+webhook_secret = begin
+  Timeout.timeout(20) do
+    loop do
+      break $1 if File.read(LOG_PATH)[/(whsec_\w+)/]
+      sleep 0.2
+    end
+  end
+rescue Timeout::Error
+  Process.kill "TERM", pid
+  fail_with "The Stripe CLI never reported a signing secret. See #{LOG_PATH}"
+end
+
+puts %Q(export STRIPE_SECRET_KEY="#{secret_key}")
+puts %Q(export STRIPE_WEBHOOK_SECRET="#{webhook_secret}")
+puts %Q(export STRIPE_MONTHLY_V1_PRICE_ID="#{monthly_price_id}")
+puts %Q(export STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID="#{extra_storage_price_id}")
+
+warn ""
+warn "Stripe credentials loaded for development"
+warn "  Webhooks: forwarding to #{FORWARD_TO} (pid #{pid}, logging to #{LOG_PATH})"
+warn "  Plans: Unlimited (#{monthly_price_id}), Unlimited+ (#{extra_storage_price_id})"
