@@ -0,0 +1,75 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+  <%= link_to "All accounts", saas.admin_accounts_path, class: "btn" %>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <ul class="margin-block-half">
+      <li>ID: <strong>#<%= @account.external_account_id %></strong></li>
+      <li>Owner: <strong><%= @account.owner_email || "No owner" %></strong></li>
+      <li>Created: <strong><%= @account.created_at.to_date.to_fs(:long) %></strong></li>
+      <li>Plan: <strong><%= @account.plan.proper_name %></strong><%= " (comped)" if @account.comped? %></li>
+      <li>Cards: <strong><%= number_with_delimiter(@account.card_count) %></strong> of <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %></li>
+      <li>Storage: <strong><%= number_to_human_size(@account.bytes_used) %></strong> of <%= number_to_human_size(@account.storage_limit) %></li>
+    </ul>
+
+    <% if subscription = @account.subscription %>
+      <header>
+        <h2 class="divider txt-medium margin-block-start">Subscription</h2>
+      </header>
+
+      <ul class="margin-block-half">
+        <li>Status: <strong><%= subscription.status %></strong></li>
+        <li>Customer: <strong><%= subscription.stripe_customer_id %></strong></li>
+        <li>Subscription: <strong><%= subscription.stripe_subscription_id %></strong></li>
+        <% if subscription.current_period_end %>
+          <li>Renews: <strong><%= subscription.current_period_end.to_date.to_fs(:long) %></strong></li>
+        <% end %>
+        <% if subscription.cancelling? %>
+          <li>Cancels: <strong><%= subscription.cancel_at.to_date.to_fs(:long) %></strong></li>
+        <% end %>
+        <% if subscription.next_amount_due %>
+          <li>Next amount due: <strong><%= number_to_currency(subscription.next_amount_due) %></strong></li>
+        <% end %>
+      </ul>
+    <% end %>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Comp</h2>
+      <div class="txt-small">Comped accounts are never charged and are never held to a limit.</div>
+    </header>
+
+    <div class="flex gap-half justify-center margin-block-half">
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Overridden limits</h2>
+      <div class="txt-small">What this account counts as using. Reset to go back to what we measured.</div>
+    </header>
+
+    <%= form_with url: saas.admin_account_overridden_limits_path(@account), method: :post, class: "flex flex-column gap-half margin-block-half" do %>
+      <label for="card_count">Card count</label>
+      <%= number_field_tag :card_count, @account.overridden_limits&.card_count, class: "input full-width", placeholder: number_with_delimiter(@account.cards_count) %>
+
+      <label for="bytes_used">Bytes used</label>
+      <%= number_field_tag :bytes_used, @account.overridden_limits&.bytes_used, class: "input full-width", placeholder: @account.storage_total&.bytes_stored || 0 %>
+
+      <%= submit_tag "Override", class: "btn" %>
+    <% end %>
+
+    <div class="flex gap-half justify-center margin-block-half">
+      <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+    </div>
+  </div>
+</section>
