+      FreeV1
+    end
+
+    def find(key)
+      all.find { |plan| plan.key == key.to_s } if key.present?
+    end
+
+    def upgrades_from(plan)
+      paid.select { |candidate| candidate.price > plan.price }
+    end
+
+    def find_by_stripe_price_id(price_id)
+      paid.find { |plan| plan.stripe_price_id == price_id } if price_id.present?
+    end
+
+    def short_name
+      name.demodulize
+    end
+
+    def key
+      short_name.underscore
+    end
+
+    def paid?
+      price.positive?
+    end
+
+    def unlimited_cards?
+      card_limit.nil?
+    end
+
+    def stripe_price_id
+      ENV["STRIPE_#{key.upcase}_PRICE_ID"] if paid?
+    end
+
+    def to_s
+      short_name
+    end
   end
 
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+    property :proper_name,   "Free"
+    property :price,         0
+    property :frequency,     "monthly"
+    property :card_limit,    1_000
+    property :storage_limit, 1.gigabyte
+  end
+
+  class MonthlyV1 < Subscription
+    property :proper_name,   "Unlimited"
+    property :price,         20
+    property :frequency,     "monthly"
+    property :card_limit,    nil
+    property :storage_limit, 5.gigabytes
+  end
+
+  class MonthlyExtraStorageV1 < Subscription
+    property :proper_name,   "Unlimited+"
+    property :price,         25
+    property :frequency,     "monthly"
+    property :card_limit,    nil
+    property :storage_limit, 500.gigabytes
   end
 end
