+        secret: "whsec_the_wrong_secret"
+    end
+
+    assert_response :bad_request
+    assert_nil @account.reload_subscription
+  end
+
+  test "a webhook without a signature is refused" do
+    with_stripe_webhook_secret do
+      post "/stripe/webhooks", params: { type: "customer.subscription.created" }.to_json,
+        headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "webhooks don't need a session" do
+    with_stripe_webhook_secret do
+      post_stripe_webhook "checkout.session.completed",
+        { object: "checkout.session", client_reference_id: @account.id, customer: "cus_42", subscription: "sub_42" }
+    end
+
+    assert_response :success
+    assert_equal "cus_42", @account.reload_subscription.stripe_customer_id
+  end
+
+  test "events we don't handle are acknowledged" do
+    with_stripe_webhook_secret do
+      post_stripe_webhook "customer.updated", { object: "customer", id: "cus_42" }
+    end
+
+    assert_response :success
+  end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..bee0a3c
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+require_relative "../../test_helpers/billing_test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  include BillingTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start free" do
+    assert @account.free?
+    assert_not @account.paid?
+    assert_equal Subscription::FreeV1, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "an active subscription brings its own plan and storage allowance" do
+    subscribe_to "monthly_v1"
+
+    assert @account.paid?
+    assert_equal Subscription::MonthlyV1, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+  end
+
+  test "the extra storage plan brings more storage" do
+    subscribe_to "monthly_extra_storage_v1"
+
+    assert_equal Subscription::MonthlyExtraStorageV1, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "a cancelled subscription falls back to free" do
+    subscribe_to "monthly_v1", status: "canceled"
+
+    assert @account.free?
+    assert_nil @account.active_subscription
+    assert_equal Subscription::FreeV1, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comping frees an account from every limit" do
+    @account.comp
+
+    assert @account.comped?
+    assert @account.paid?
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_empty @account.upgrades
+
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal Subscription::FreeV1, @account.plan
+  end
+
+  test "comping twice keeps a single waiver" do
+    @account.comp
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+  end
+
+  test "free accounts can upgrade to both paid plans" do
+    assert_equal [ Subscription::MonthlyV1, Subscription::MonthlyExtraStorageV1 ], @account.upgrades
+    assert @account.upgradable?
+  end
+
+  test "the top plan has nothing left to upgrade to" do
+    subscribe_to "monthly_extra_storage_v1"
+
+    assert_empty @account.upgrades
+    assert_not @account.upgradable?
+  end
+
+  test "overriding limits replaces what we measured" do
+    @account.update_column :cards_count, 750
+    Account.any_instance.stubs(:storage_total).returns(nil)
+
+    @account.override_limits card_count: 10, bytes_used: 2.gigabytes
+
+    assert_equal 10, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+
+    @account.override_limits card_count: 20, bytes_used: nil
+
+    assert_equal 20, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    @account.reset_overridden_limits
+
+    assert_equal 750, @account.card_count
+    assert_nil @account.overridden_limits
+  end
+  test "checkout hands Stripe the plan and the account" do
+    session = stub(url: "https://checkout.stripe.com/c/pay/cs_test_123")
+
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:mode] == "subscription" &&
+        params[:line_items] == [ { price: "price_monthly_v1", quantity: 1 } ] &&
+        params[:client_reference_id] == @account.id &&
+        params[:subscription_data][:metadata][:account_id] == @account.id &&
+        params[:customer_email] == @account.owner_email
+    end.returns(session)
+
+    with_stripe_price_ids do
+      assert_equal session.url, @account.checkout_url(plan: Subscription::MonthlyV1,
+        success_url: "https://app.fizzy.do/1/account/settings",
+        cancel_url: "https://app.fizzy.do/1/account/subscription")
+    end
+  end
+
+  test "checkout reuses the Stripe customer we already have" do
+    subscription = subscribe_to "monthly_v1"
+
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:customer] == subscription.stripe_customer_id
+    end.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test_123"))
+
+    with_stripe_price_ids do
+      @account.checkout_url plan: Subscription::MonthlyExtraStorageV1,
+        success_url: "https://app.fizzy.do/1/account/settings",
+        cancel_url: "https://app.fizzy.do/1/account/subscription"
+    end
+  end
+
+  test "the customer portal is opened for the Stripe customer" do
+    subscription = subscribe_to "monthly_v1"
+    session = stub(url: "https://billing.stripe.com/p/session/test_123")
+
+    Stripe::BillingPortal::Session.expects(:create)
+      .with(customer: subscription.stripe_customer_id, return_url: "https://app.fizzy.do/1/account/settings")
+      .returns(session)
+
+    assert_equal session.url, @account.billing_portal_url(return_url: "https://app.fizzy.do/1/account/settings")
+  end
+
+  test "cancelling an account cancels its subscription at Stripe" do
+    subscribe_to "monthly_v1"
+    Account::Subscription.any_instance.expects(:cancel)
+
+    @account.cancel(initiated_by: users(:mike))
+
+    assert @account.cancelled?
+  end
+
+  test "a subscription Stripe won't cancel doesn't stop the account from cancelling" do
+    subscribe_to "monthly_v1"
+    Account::Subscription.any_instance.stubs(:cancel).raises(Stripe::APIError.new("Stripe is down"))
+
+    @account.cancel(initiated_by: users(:mike))
+
+    assert @account.cancelled?
+  end
+end
