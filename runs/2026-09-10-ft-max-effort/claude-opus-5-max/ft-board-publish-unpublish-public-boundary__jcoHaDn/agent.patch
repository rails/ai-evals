+<div id="<%= dom_id(board, :publication) %>" class="margin-block-end">
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <% url = public_board_url(board.public_key) %>
+    <p class="margin-none-block-start">Anyone with this secret link can see this board, no sign-in required.</p>
+
+    <div class="flex align-center gap-half margin-block">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" aria-label="Public link to this board" readonly>
+
+      <%= button_to_copy_to_clipboard(url) do %>
+        <%= icon_tag "copy-paste" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative", data: {
+          turbo_confirm: "Are you sure? The current link will stop working for everyone." } do %>
+      <%= icon_tag "lock" %>
+      <span>Stop sharing publicly</span>
+    <% end %>
+  <% else %>
+    <p class="margin-none-block-start">Publish this board to get a secret link that anyone can use to see it, without signing in.</p>
+
+    <%= button_to board_publication_path(board), class: "btn margin-block" do %>
+      <%= icon_tag "globe" %>
+      <span>Share publicly</span>
+    <% end %>
+  <% end %>
+</div>
