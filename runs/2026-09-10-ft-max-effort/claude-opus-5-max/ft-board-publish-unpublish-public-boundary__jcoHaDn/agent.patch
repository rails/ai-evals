@@ -0,0 +1,21 @@
+class Board::Publication < ApplicationRecord
+  belongs_to :account, default: -> { board.account }
+  belongs_to :board, touch: true
+
+  has_secure_token :key
+
+  def url
+    Rails.application.routes.url_helpers.public_board_url(key, **url_options)
+  end
+
+  private
+    def url_options
+      base_url_options.merge(script_name: account.slug)
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..0741e7a
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,30 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+
+    scope :published, -> { where.associated(:publication) }
+  end
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    publication&.destroy
+    reload_publication
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def public_key
+    publication&.key
+  end
+
+  def public_url
+    publication&.url
+  end
+end
