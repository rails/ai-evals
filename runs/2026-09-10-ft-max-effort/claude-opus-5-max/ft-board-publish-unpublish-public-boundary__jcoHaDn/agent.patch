diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..b23ef80
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+  end
+
+  test "publish generates a secret key" do
+    publication = @board.publish
+
+    assert @board.published?
+    assert_equal publication.key, @board.public_key
+    assert_equal @board.account, publication.account
+  end
+
+  test "publish keeps the key of already published boards" do
+    key = @board.publish.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      assert_equal key, @board.publish.key
+    end
+  end
+
+  test "unpublish removes the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_nil @board.public_key
+  end
+
+  test "public url points at the public board" do
+    publication = @board.publish
+
+    assert_equal "http://example.com#{@board.account.slug}/public/boards/#{publication.key}", @board.public_url
+  end
+
+  test "published scope" do
+    @board.publish
+
+    assert_equal [ @board ], Board.published.to_a
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "publishing touches the board" do
+    assert_changes -> { @board.reload.updated_at } do
+      travel 1.second do
+        @board.publish
+      end
+    end
+  end
+end
