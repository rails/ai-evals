@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "create as JSON" do
+    post board_publication_path(@board), as: :json
+    assert_response :created
+
+    assert_equal public_board_url(@board.reload.public_key), response.parsed_body["public_url"]
+  end
+
+  test "create keeps the existing publication" do
+    publication = @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+
+    assert_equal publication.key, @board.reload.public_key
+  end
+
+  test "destroy" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "destroy as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+
+    assert_not @board.reload.published?
+  end
+
+  test "non-admins can't publish boards" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admins can't unpublish boards" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "boards from other accounts can't be published" do
+    assert_raises ActiveRecord::RecordNotFound do
+      without_action_dispatch_exception_handling do
+        post board_publication_path(boards(:miltons_wish_list))
+      end
+    end
+  end
+end
