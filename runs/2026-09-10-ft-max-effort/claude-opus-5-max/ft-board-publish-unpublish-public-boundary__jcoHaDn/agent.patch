diff --git a/app/controllers/public/base_controller.rb b/app/controllers/public/base_controller.rb
new file mode 100644
index 0000000..2c76901
--- /dev/null
+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,28 @@
+# Base controller for the read-only pages of published boards, which anyone with
+# their secret URL can see, signed in or not.
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+
+  # Public URLs are shared verbatim, so they can arrive without an account
+  # prefix. The published board tells us which account we are in.
+  skip_before_action :require_account
+
+  layout "public"
+
+  before_action :set_board, :ensure_account_is_active
+
+  private
+    def set_board
+      @publication = Board::Publication.find_by!(key: publication_key)
+      @board = @publication.board
+      Current.account = @board.account
+    end
+
+    def publication_key
+      params[:key] || params[:board_key]
+    end
+
+    def ensure_account_is_active
+      head :not_found unless Current.account.active?
+    end
+end
