+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "show a card of a published board without signing in" do
+    card = cards(:logo)
+
+    get public_board_card_path(@publication.key, card)
+
+    assert_response :success
+    assert_select "h1", text: /#{card.title}/
