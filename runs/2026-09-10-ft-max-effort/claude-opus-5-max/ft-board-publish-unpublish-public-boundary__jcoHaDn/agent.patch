diff --git a/app/controllers/public/boards_controller.rb b/app/controllers/public/boards_controller.rb
new file mode 100644
index 0000000..0c36096
--- /dev/null
+++ b/app/controllers/public/boards_controller.rb
@@ -0,0 +1,15 @@
+class Public::BoardsController < Public::BaseController
+  CARDS_PER_COLUMN = 15
+
+  def show
+    @columns = @board.columns.sorted.index_with { |column| cards_in(column) }
+    set_page_and_extract_portion_from @board.cards.awaiting_triage.latest.with_golden_first.preloaded
+
+    fresh_when etag: [ @publication, @board, @page.records ]
+  end
+
+  private
+    def cards_in(column)
+      column.cards.active.latest.with_golden_first.preloaded.limit(CARDS_PER_COLUMN)
+    end
+end
