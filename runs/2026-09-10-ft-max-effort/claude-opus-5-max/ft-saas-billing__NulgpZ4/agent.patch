+require "test_helper"
+
+class Card::CardLimited::CreationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+  end
+
+  test "cannot create cards through the API once the cards run out" do
+    @account.update! cards_count: 1_000
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "One too many" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can still draft cards once the cards run out" do
+    @account.update! cards_count: 1_000
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "can create cards through the API while there are cards left" do
+    @account.update! cards_count: 999
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "The last one" } }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "paid accounts create cards through the API without a limit" do
+    @account.update! cards_count: 10_000
+    @account.create_subscription! stripe_customer_id: "cus_123", plan_key: "monthly_v1", status: "active"
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Paid for" } }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "staff creates cards through the API even when the cards have run out" do
+    @account.update! cards_count: 1_000
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Staff card" } }, as: :json
+    end
+
+    assert_response :created
+  end
+end
