+# Stripe hosts the checkout, so all we do is send people there with the right plan in hand.
+class Billings::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_plan
+
+  def create
+    redirect_to checkout_session.url, allow_other_host: true, status: :see_other
+  end
+
+  private
+    def set_plan
+      unless @plan = Plan.find(params[:plan_key] || params[:plan])
+        redirect_to saas.billing_path, alert: "That plan doesn't exist"
+      end
+    end
+
+    def checkout_session
+      Current.account.checkout_session \
+        plan: @plan,
+        success_url: saas.billing_url,
+        cancel_url: saas.billing_url
+    end
+end
