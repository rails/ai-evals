+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider txt-medium margin-block-start">Account</h2>
+      </header>
+
+      <ul class="list-unindented txt-small margin-block-half">
+        <li>ID <strong>#<%= @account.external_account_id %></strong></li>
+        <li>Owner <strong><%= @account.owner_name || "None" %></strong> <%= @account.owner_email %></li>
+        <li>Signed up <strong><%= time_ago_in_words(@account.created_at) %> ago</strong></li>
+        <li>Status <strong><%= @account.cancelled? ? "Cancelled" : "Active" %></strong></li>
+      </ul>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider txt-medium margin-block-start">Plan</h2>
+      </header>
+
+      <ul class="list-unindented txt-small margin-block-half">
+        <li>Plan <strong><%= @account.plan.name %></strong></li>
+        <li>Comped <strong><%= @account.comped? ? "Yes" : "No" %></strong></li>
+        <% if subscription = @account.subscription %>
+          <li>Stripe customer <strong><%= subscription.stripe_customer_id %></strong></li>
+          <li>Stripe subscription <strong><%= subscription.stripe_subscription_id || "None" %></strong></li>
+          <li>Subscription status <strong><%= subscription.status || "Unknown" %></strong></li>
+          <% if subscription.current_period_end %>
+            <li>Current period ends <strong><%= subscription.current_period_end.to_fs(:long) %></strong></li>
+          <% end %>
+          <% if subscription.next_amount_due_in_cents %>
+            <li>Next amount due <strong><%= number_to_currency(subscription.next_amount_due_in_cents / 100.0) %></strong></li>
+          <% end %>
+        <% end %>
+      </ul>
+
+      <div class="flex gap-half margin-block-half">
+        <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider txt-medium margin-block-start">Usage</h2>
+        <div class="txt-x-small txt-ink-medium">Overriding usage pins these numbers until you reset them.</div>
+      </header>
+
+      <ul class="list-unindented txt-small margin-block-half">
+        <li>
+          Cards
+          <strong><%= number_with_delimiter(@account.card_count) %></strong>
+          of <strong><%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %></strong>
+        </li>
+        <li>
+          Storage
+          <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+          of <strong><%= number_to_human_size(@account.storage_limit) %></strong>
+        </li>
+        <li>Overridden <strong><%= @account.overridden_limits? ? "Yes" : "No" %></strong></li>
+      </ul>
+
+      <%= form_with url: saas.admin_account_overridden_limit_path(@account), scope: :overridden_limit, method: :post, class: "flex flex-column gap-half margin-block-half" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count", class: "txt-small" %>
+          <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small" %>
+          <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+        </div>
+
+        <%= form.submit "Override", class: "btn" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn" %>
+    </section>
+  </div>
+</section>
