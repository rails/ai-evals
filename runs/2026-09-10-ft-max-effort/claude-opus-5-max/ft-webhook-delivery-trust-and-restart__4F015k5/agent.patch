@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @webhook = webhooks(:active)
+  end
+
+  test "events are relayed after they happen" do
+    assert_enqueued_with job: Event::RelayJob, queue: "webhooks" do
+      create_event "card_published"
+    end
+  end
+
+  test "relaying queues a delivery for every subscribed webhook" do
+    event = create_event "card_published"
+
+    assert_enqueued_with job: Webhook::DeliveryJob, queue: "webhooks" do
+      event.relay_now
+    end
+
+    assert_equal [ @webhook ], event.webhook_deliveries.collect(&:webhook)
+    assert event.webhook_deliveries.sole.pending?
+  end
+
+  test "relaying skips webhooks that aren't subscribed to the action" do
+    event = create_event "card_triaged"
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relaying skips deactivated webhooks" do
+    @webhook.deactivate
+    event = create_event "card_published"
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relaying skips webhooks on other boards" do
+    elsewhere = Webhook.create! name: "Another board", url: "https://elsewhere.example.com/webhooks",
+      board: boards(:private), subscribed_actions: %w[ card_published ]
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      create_event("card_published").relay_now
+    end
+
+    assert_empty elsewhere.deliveries
+  end
+
+  test "relaying the same event twice only queues one delivery" do
+    event = create_event "card_published"
+
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      2.times { event.relay_now }
+    end
+  end
+
+  test "relaying events from boards without webhooks does nothing" do
+    event = boards(:miltons_wish_list).events.create! action: "card_published", creator: users(:mike), eventable: cards(:radio)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  private
+    def create_event(action, board: boards(:writebook), eventable: cards(:logo))
+      board.events.create! action: action, creator: users(:david), eventable: eventable
+    end
+end
