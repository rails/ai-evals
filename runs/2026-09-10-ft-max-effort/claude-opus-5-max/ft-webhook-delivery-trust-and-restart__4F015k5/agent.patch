+# Relays events to the webhooks that subscribe to them on the board where they
+# happened.
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later self
+  end
+
+  def relay_now
+    subscribed_webhooks.each { |webhook| webhook.deliver_later self }
+  end
+
+  private
+    def subscribed_webhooks
+      board.webhooks.active.subscribed_to(action)
+    end
+end
