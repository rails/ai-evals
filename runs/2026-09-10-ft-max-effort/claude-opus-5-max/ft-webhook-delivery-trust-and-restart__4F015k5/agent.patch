index 0000000..1645f2d
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "webhooks get a tracker when they are created" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "webhooks that lost their tracker get a new one" do
+    @tracker.destroy!
+
+    assert_difference -> { Webhook::DelinquencyTracker.count }, 1 do
+      @webhook.reload.delinquency_tracker.record_failure
+    end
+
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "record_failure counts failures in a row" do
+    assert_changes -> { @tracker.reload.consecutive_failures_count }, from: 0, to: 2 do
+      2.times { @tracker.record_failure }
+    end
+
+    assert @tracker.first_failure_at.present?
+    assert @webhook.reload.active?
+  end
+
+  test "deactivates the webhook after ten failures in a row within an hour" do
+    9.times { @tracker.record_failure at: 50.minutes.ago }
+
+    assert @webhook.reload.active?
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      @tracker.record_failure
+    end
+
+    assert @tracker.delinquent?
+  end
+
+  test "failures spread over more than an hour start a new streak" do
+    9.times { @tracker.record_failure at: 2.hours.ago }
+
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert_equal @tracker.first_failure_at, @tracker.reload.first_failure_at
+  end
+
+  test "a success clears the streak" do
+    9.times { @tracker.record_failure }
+
+    @tracker.track webhook_deliveries(:successfully_completed)
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "track counts failed deliveries" do
+    assert_changes -> { @tracker.reload.consecutive_failures_count }, from: 0, to: 1 do
+      @tracker.track webhook_deliveries(:unsuccessfully_completed)
+    end
+
+    assert_changes -> { @tracker.reload.consecutive_failures_count }, from: 1, to: 2 do
+      @tracker.track webhook_deliveries(:errored)
+    end
+  end
+
+  test "reactivating a webhook wipes the slate clean" do
+    webhook = webhooks(:inactive)
+
+    assert_changes -> { webhook.delinquency_tracker.reload.consecutive_failures_count }, to: 0 do
+      webhook.activate
+    end
+
+    assert webhook.active?
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+end
