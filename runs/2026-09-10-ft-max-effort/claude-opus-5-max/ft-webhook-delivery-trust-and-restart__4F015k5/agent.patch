diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..8eb013a
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,68 @@
+# The body we post to a webhook endpoint. Chat destinations get a ready to post
+# message, everyone else gets the full event as JSON.
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def content_type
+    if webhook.for_campfire?
+      "text/html; charset=utf-8"
+    else
+      "application/json"
+    end
+  end
+
+  def body
+    @body ||= if webhook.for_slack?
+      { text: message }.to_json
+    elsif webhook.for_basecamp?
+      { content: message }.to_json
+    elsif webhook.for_campfire?
+      message
+    else
+      event_as_json
+    end
+  end
+
+  def signature(secret)
+    OpenSSL::HMAC.hexdigest "SHA256", secret, body
+  end
+
+  private
+    def message
+      render(formats: :html, layout: false).strip
+    end
+
+    def event_as_json
+      render(formats: :json)
+    end
+
+    def render(**options)
+      renderer.render(template: "webhooks/event", assigns: { event: event }, **options)
+    end
+
+    def renderer
+      ApplicationController.renderer.new(script_name: event.account.slug, **request_options)
+    end
+
+    # Payloads are rendered from a job, without a request to take the links in
+    # them from, so they use the base URL configured for the instance instead.
+    def request_options
+      options = base_url_options
+
+      if host = options[:host].presence
+        { http_host: [ host, options[:port] ].compact.join(":"), https: options[:protocol].to_s == "https" }
+      else
+        {}
+      end
+    end
+
+    def base_url_options
+      (Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}).symbolize_keys
+    end
+end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..0426c5b
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,62 @@
+# The HTTP request we post to a webhook endpoint when an event it subscribes to
+# happens. Network trouble is reported as an errored response rather than
+# raised: a broken endpoint is the endpoint's problem, not ours.
+class Webhook::Request
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
+  UNREACHABLE_ERRORS = [ SocketError, SystemCallError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError, IOError, URI::Error ].freeze
+
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def post
+    Webhook::Response.from perform
+  rescue Timeout::Error
+    Webhook::Response.errored :timeout
+  rescue *UNREACHABLE_ERRORS
+    Webhook::Response.errored :destination_unreachable
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => payload.content_type,
+      "X-Webhook-Signature" => payload.signature(webhook.signing_secret),
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+    }
+  end
+
+  def body
+    payload.body
+  end
+
+  def to_h
+    { headers: headers }
+  end
+
+  private
+    def perform
+      Net::HTTP.start(uri.host, uri.port, **connection_options) do |http|
+        http.post uri.request_uri, body, headers
+      end
+    end
+
+    def connection_options
+      { use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT }
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def payload
+      @payload ||= Webhook::Payload.new(webhook, event)
+    end
+end
diff --git a/app/models/webhook/response.rb b/app/models/webhook/response.rb
new file mode 100644
index 0000000..2d6eba5
--- /dev/null
+++ b/app/models/webhook/response.rb
@@ -0,0 +1,29 @@
+# What came back from a webhook endpoint: either a status code, or the reason
+# why we never got one. Recorded in the delivery log as is.
+class Webhook::Response
+  attr_reader :code, :error, :headers
+
+  class << self
+    def from(http_response)
+      new code: http_response.code.to_i, headers: http_response.each_header.to_h
+    end
+
+    def errored(error)
+      new error: error
+    end
+  end
+
+  def initialize(code: nil, error: nil, headers: {})
+    @code = code
+    @error = error
+    @headers = headers
+  end
+
+  def completed?
+    code.present?
+  end
+
+  def to_h
+    { code: code, error: error, headers: headers }.compact
+  end
+end
