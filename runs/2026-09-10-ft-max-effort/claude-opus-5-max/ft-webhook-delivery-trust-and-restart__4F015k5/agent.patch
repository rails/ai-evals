+++ b/test/integration/webhook_deliveries_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class WebhookDeliveriesTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @webhook = webhooks(:active)
+    @endpoint = stub_request(:post, @webhook.url).to_return(status: 200)
+  end
+
+  test "publishing a card posts to the webhooks subscribed to the board" do
+    perform_enqueued_jobs do
+      boards(:writebook).cards.create! title: "Webhooks, please", creator: users(:david), status: :published
+    end
+
+    assert_requested @endpoint, times: 1
+
+    delivery = @webhook.deliveries.ordered.first
+    assert delivery.succeeded?
+    assert_equal "card_published", delivery.event.action
+    assert_equal 200, delivery.response[:code]
+  end
+
+  test "an endpoint that keeps failing gets switched off" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    perform_enqueued_jobs do
+      9.times { |index| boards(:writebook).cards.create! title: "Card #{index}", creator: users(:david), status: :published }
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 9, @webhook.delinquency_tracker.reload.consecutive_failures_count
+
+    perform_enqueued_jobs do
+      boards(:writebook).cards.create! title: "The last straw", creator: users(:david), status: :published
+    end
+
+    assert_not @webhook.reload.active?
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      perform_enqueued_jobs do
+        boards(:writebook).cards.create! title: "Nobody is listening", creator: users(:david), status: :published
+      end
+    end
+
+    assert_requested :post, @webhook.url, times: 10
+  end
+end
