diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..b5394e6
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,49 @@
+# Keeps score of the deliveries a webhook fails in a row so endpoints that keep
+# failing get deactivated instead of being posted to forever. Ten failures in a
+# row within an hour is our definition of a hopeless endpoint. A single
+# successful delivery in between wipes the slate clean.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAX_CONSECUTIVE_FAILURES = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track(delivery)
+    if delivery.succeeded?
+      reset
+    else
+      record_failure at: delivery.updated_at || Time.current
+    end
+  end
+
+  def record_failure(at: Time.current)
+    with_lock do
+      forget_failures_before at - FAILURE_WINDOW
+
+      self.first_failure_at ||= at
+      self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+      save!
+    end
+
+    webhook.deactivate if delinquent?
+  end
+
+  def reset
+    if consecutive_failures_count.to_i > 0 || first_failure_at.present?
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= MAX_CONSECUTIVE_FAILURES
+  end
+
+  private
+    def forget_failures_before(time)
+      if first_failure_at.present? && first_failure_at < time
+        self.consecutive_failures_count = 0
+        self.first_failure_at = nil
+      end
+    end
+end
