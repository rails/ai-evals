+    sign_in_as :kevin
+    @webhook = webhooks(:active)
+  end
+
+  test "the delivery log shows how each delivery went" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    webhook_deliveries(:pending).deliver_now
+
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    webhook_deliveries(:in_progress).update! state: :pending
+    webhook_deliveries(:in_progress).deliver_now
+
+    get board_webhook_path(@webhook.board, @webhook)
