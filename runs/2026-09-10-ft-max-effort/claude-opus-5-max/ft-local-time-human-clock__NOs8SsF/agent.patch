diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..db5b810 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,26 @@
 module TimeHelper
+  # Renders a timestamp as a <time> element the browser turns into words, in the
+  # viewer's own timezone. The server only sends the raw instant, so the markup
+  # reads right for everyone — and stays cacheable.
+  def local_time_tag(time, format: :relative, **options)
+    local_time_element_tag time.getutc.iso8601, format: format, **options if time
+  end
+
+  # Renders a calendar day, which has no time of its own, so browsers read it
+  # verbatim instead of shifting it into another day.
+  def local_date_tag(date, format: :weekday, **options)
+    local_time_element_tag date.to_date.iso8601, format: format, **options if date
+  end
+
+  private
+    def local_time_element_tag(datetime, format:, data: {}, **options)
+      classes = class_names("local-time-value", options.delete(:class))
+      local_time_data = {
+        controller: "local-time",
+        local_time_format_value: format,
+        action: "turbo:morph-element->local-time#render"
+      }
+
+      tag.time datetime: datetime, class: classes, data: local_time_data.merge(data), **options
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..eb3d033
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,49 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime, formatFullDateTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Puts the instant the server sent into words, on the viewer's own clock, so the
+// same HTML reads right everywhere. Renders into the element itself, or into one
+// of its attributes when something else reads the date from there — like the
+// description the card stamp hands to the native app.
+export default class extends Controller {
+  static values = {
+    datetime: String,
+    format: { type: String, default: "relative" },
+    attribute: String
+  }
+
+  #timer
+
+  connect() {
+    this.render()
+    if (this.#drifts) this.#timer = setInterval(this.render.bind(this), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  render() {
+    if (this.hasAttributeValue) {
+      this.element.setAttribute(this.attributeValue, this.#words)
+    } else {
+      this.element.textContent = this.#words
+      this.element.title = formatFullDateTime(this.#datetime)
+    }
+  }
+
+  get #words() {
+    return formatDateTime(this.#datetime, this.formatValue)
+  }
+
+  get #datetime() {
+    return this.hasDatetimeValue ? this.datetimeValue : this.element.getAttribute("datetime")
+  }
+
+  // Only relative times drift as the clock moves on: "Sep 12" always reads "Sep 12".
+  get #drifts() {
+    return this.formatValue === "relative"
+  }
+}
