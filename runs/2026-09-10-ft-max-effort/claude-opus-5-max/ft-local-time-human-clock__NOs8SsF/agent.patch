diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..48d3f0d
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag sends the raw timestamp for the browser to put into words" do
+    element = parse local_time_tag(Time.utc(2025, 9, 12, 17, 42))
+
+    assert_equal "2025-09-12T17:42:00Z", element["datetime"]
+    assert_equal "local-time", element["data-controller"]
+    assert_equal "relative", element["data-local-time-format-value"]
+    assert_empty element.text
+  end
+
+  test "local_time_tag renders the same markup in every timezone" do
+    time = Time.utc(2025, 9, 12, 17, 42)
+
+    in_honolulu = Time.use_zone("Pacific/Honolulu") { local_time_tag(time.in_time_zone) }
+    in_amsterdam = Time.use_zone("Europe/Amsterdam") { local_time_tag(time.in_time_zone) }
+
+    assert_equal in_honolulu, in_amsterdam
+  end
+
+  test "local_time_tag takes a format" do
+    element = parse local_time_tag(Time.utc(2025, 9, 12, 17, 42), format: :date_with_year)
+
+    assert_equal "date_with_year", element["data-local-time-format-value"]
+  end
+
+  test "local_time_tag keeps the classes and attributes it's given" do
+    element = parse local_time_tag(Time.utc(2025, 9, 12, 17, 42), class: "card__timestamp", id: "posted_at")
+
+    assert_equal "local-time-value card__timestamp", element["class"]
+    assert_equal "posted_at", element["id"]
+  end
+
+  test "local_time_tag renders nothing without a time" do
+    assert_nil local_time_tag(nil)
+  end
+
+  test "local_date_tag renders a calendar day, which no timezone can shift" do
+    element = parse local_date_tag(Time.utc(2025, 9, 12, 23, 30))
+
+    assert_equal "2025-09-12", element["datetime"]
+    assert_equal "weekday", element["data-local-time-format-value"]
+  end
+
+  test "local_date_tag renders nothing without a date" do
+    assert_nil local_date_tag(nil)
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html).at("time")
+    end
+end
