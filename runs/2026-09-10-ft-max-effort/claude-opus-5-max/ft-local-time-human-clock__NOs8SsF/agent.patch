@@ -0,0 +1,93 @@
+require "application_system_test_case"
+
+class LocalTimesTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+    @card = cards(:layout)
+  end
+
+  test "comments read on the viewer's own clock" do
+    earlier_today = comment_posted_at([ Time.current.beginning_of_day, 1.hour.ago ].max)
+    last_night = comment_posted_at(1.day.ago.midday)
+    earlier_this_week = comment_posted_at(5.days.ago.midday)
+    long_ago = comment_posted_at(Time.utc(2020, 9, 12, 17, 42))
+
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(earlier_today)} time", text: /\A\d{1,2}:\d{2} (AM|PM)\z/i
+    assert_selector "##{dom_id(last_night)} time", text: /\Ayesterday\z/i
+    assert_selector "##{dom_id(earlier_this_week)} time", text: /\A5 days ago\z/i
+    assert_selector "##{dom_id(long_ago)} time", text: /\ASep 12, 2020\z/i
+  end
+
+  test "a card's meta reads on the viewer's own clock" do
+    @card.update!(created_at: 3.days.ago.midday, last_active_at: 1.day.ago.midday)
+
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :meta)}" do
+      assert_text(/Added 3 days ago/i)
+      assert_text(/Updated yesterday/i)
+    end
+  end
+
+  test "a card auto-closing overnight reads tomorrow" do
+    @card.update!(last_active_at: 1.day.from_now.midday - @card.auto_postpone_period)
+
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: /Moves to “Not Now” tomorrow if there’s no activity\./i
+  end
+
+  test "a done card's stamp reads on the viewer's own clock" do
+    @card.close(user: users(:david))
+    today = Time.current.strftime("%b %-d, %Y")
+
+    visit card_url(@card)
+
+    assert_selector ".card__closed-date", text: /\A#{Regexp.escape(today)}\z/i
+    # The native app reads the same date from the stamp itself.
+    assert_selector ".card__closed[data-bridge-description='#{today}']"
+  end
+
+  test "the activity timeline reads on the viewer's own clock" do
+    events(:logo_published).update!(created_at: [ Time.current.beginning_of_day, 2.hours.ago ].max)
+
+    visit events_url
+
+    assert_selector ".events__column-header time", text: /\A#{Regexp.escape(Date.current.strftime("%A, %B %-d"))}\z/i
+    assert_selector ".event__timestamp time", text: /\A\d{1,2}:\d{2} (AM|PM)\z/i
+  end
+
+  test "times survive a broadcast page refresh" do
+    comment = comment_posted_at(1.day.ago.midday)
+
+    visit card_url(@card)
+    assert_selector "##{dom_id(comment)} time", text: /\Ayesterday\z/i
+
+    retitle_card_elsewhere
+
+    assert_selector "h1", text: "Retitled elsewhere", wait: 5
+    assert_selector "##{dom_id(comment)} time", text: /\Ayesterday\z/i
+  end
+
+  private
+    def comment_posted_at(time)
+      @card.comments.create!(creator: users(:david), body: "Posted at #{time}", created_at: time)
+    end
+
+    def retitle_card_elsewhere
+      wait_for_cable_subscriptions
+      @card.update!(title: "Retitled elsewhere")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
