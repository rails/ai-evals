+# Bundles are local bookkeeping for notification emails, so notifications travel
+# between instances without the window they were emailed in.
+class Account::DataTransfer::NotificationRecordSet < Account::DataTransfer::RecordSet
+  EXCLUDED_ATTRIBUTES = %w[ bundle_id ].freeze
+
+  def initialize(account)
+    super(account: account, model: ::Notification, attributes: ::Notification.column_names - EXCLUDED_ATTRIBUTES)
+  end
+end
