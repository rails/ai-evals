+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.unread_notifications.to_a
+
+    Current.with_account(bundle.account) do
+      mail to: @user.identity.email_address, subject: subject_for(@notifications)
+    end
+  end
+
+  private
+    def subject_for(notifications)
+      "#{notifications.size} new #{"notification".pluralize(notifications.size)}"
+    end
+end
