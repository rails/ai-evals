 class User::Settings < ApplicationRecord
+  # How often notification emails are bundled up and sent. Picking "never"
+  # turns bundled emails off entirely.
+  BUNDLE_EMAIL_PERIODS = {
+    never: nil,
+    every_few_hours: 4.hours,
+    daily: 1.day,
+    weekly: 1.week
+  }.freeze
+
+  BUNDLE_EMAIL_FREQUENCIES = BUNDLE_EMAIL_PERIODS.keys.map(&:to_s).freeze
+
   belongs_to :account, default: -> { user.account }
   belongs_to :user
 
+  enum :bundle_email_frequency, BUNDLE_EMAIL_FREQUENCIES.index_by(&:itself), default: :never, validate: true
+
+  # How long a bundle of notification emails is kept open before it's sent.
+  # Nil when bundled emails are turned off.
+  def bundle_email_period
+    BUNDLE_EMAIL_PERIODS[bundle_email_frequency&.to_sym]
+  end
+
+  def bundle_emails?
+    bundle_email_period.present?
+  end
+
   def timezone
     if timezone_name.present?
       ActiveSupport::TimeZone[timezone_name] || default_timezone
