diff --git a/app/jobs/card/auto_postpone_due_job.rb b/app/jobs/card/auto_postpone_due_job.rb
new file mode 100644
index 0000000..75e06bf
--- /dev/null
+++ b/app/jobs/card/auto_postpone_due_job.rb
@@ -0,0 +1,11 @@
+# Sweeps the cards that have been quiet for longer than their entropy period. The sweep is
+# idempotent, so when a big backlog keeps one run going past the hour, we drop the run that was
+# due to start rather than stacking a second sweep on top of it.
+class Card::AutoPostponeDueJob < ApplicationJob
+  queue_as :backend
+  limits_concurrency to: 1, key: :auto_postpone_due, duration: 1.hour, on_conflict: :discard
+
+  def perform
+    Card.auto_postpone_all_due
+  end
+end
