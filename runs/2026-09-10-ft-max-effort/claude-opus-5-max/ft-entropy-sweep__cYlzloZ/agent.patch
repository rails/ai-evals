diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..c4f8320 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,99 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "cards leave the sweep when they are closed and rejoin it when they are reopened" do
+    card = cards(:logo)
+    card.update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    assert_includes Card.due_to_be_postponed, card
+
+    card.close
+    assert_not card.reload.auto_postponable?
+    assert_not_includes Card.due_to_be_postponed, card
+
+    card.reopen
+    assert card.reload.auto_postponable?
+
+    # Reopening counts as activity, so the card only falls due again once it goes quiet.
+    card.update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    assert_includes Card.due_to_be_postponed, card
+  end
+
+  test "cards leave the sweep when they are postponed and rejoin it when they are resumed" do
+    card = cards(:logo)
+    card.update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    card.postpone
+    assert_not card.reload.auto_postponable?
+    assert_not_includes Card.due_to_be_postponed, card
+
+    card.resume
+    assert card.reload.auto_postponable?
+
+    card.update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    assert_includes Card.due_to_be_postponed, card
+  end
+
+  test "drafts stay out of the sweep until they are published" do
+    card = boards(:writebook).cards.create!(creator: users(:david), status: "drafted",
+      last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_not card.auto_postponable?
+    assert_not_includes Card.due_to_be_postponed, card
+
+    card.publish
+    assert card.reload.auto_postponable?
+    assert_includes Card.due_to_be_postponed, card
+  end
+
+  test "cards inserted in bulk are swept even though they skipped the callbacks" do
+    card = insert_card last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period
+
+    assert card.auto_postponable?
+    assert_includes Card.due_to_be_postponed, card
+
+    Card.auto_postpone_all_due
+    assert card.reload.postponed?
+  end
+
+  test "an out of date in play flag never hides a card from the sweep" do
+    card = insert_card last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period
+    insert_closure_for card
+
+    assert card.reload.auto_postponable?, "the flag is out of date after a bulk insert"
+    assert_not_includes Card.due_to_be_postponed, card
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "reconciling recomputes the in play flag for cards inserted in bulk" do
+    postponable = insert_card
+    closed = insert_card
+    insert_closure_for closed
+
+    accounts("37s").cards.reconcile_auto_postponability
+
+    assert postponable.reload.auto_postponable?
+    assert_not closed.reload.auto_postponable?
+    assert_not cards(:shipping).reload.auto_postponable?
+  end
+
+  private
+    def insert_card(**attributes)
+      id = ActiveRecord::Type::Uuid.generate
+
+      Card.insert_all! [ { id: id, account_id: accounts("37s").id, board_id: boards(:writebook).id,
+        creator_id: users(:david).id, number: Card.maximum(:number).to_i + 1, status: "published",
+        title: "Bulk inserted", created_at: 1.week.ago, updated_at: 1.week.ago,
+        last_active_at: 1.week.ago }.merge(attributes) ]
+
+      Card.find(id)
+    end
+
+    def insert_closure_for(card)
+      Closure.insert_all! [ { id: ActiveRecord::Type::Uuid.generate, account_id: card.account_id,
+        card_id: card.id, user_id: users(:david).id, created_at: Time.current, updated_at: Time.current } ]
+    end
 end
