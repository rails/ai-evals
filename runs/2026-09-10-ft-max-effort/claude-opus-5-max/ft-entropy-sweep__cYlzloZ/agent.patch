index 0000000..318a43f
--- /dev/null
+++ b/test/jobs/card/auto_postpone_due_job_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class Card::AutoPostponeDueJobTest < ActiveJob::TestCase
+  test "postpones the cards that are due" do
+    due = cards(:logo)
+    due.update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card::AutoPostponeDueJob.perform_now
+    end
+
+    assert due.reload.postponed?
+  end
+
+  test "a sweep that's still running discards the next one instead of stacking it" do
+    assert_equal 1, Card::AutoPostponeDueJob.concurrency_limit
+    assert_equal :discard, Card::AutoPostponeDueJob.concurrency_on_conflict
+  end
+end
