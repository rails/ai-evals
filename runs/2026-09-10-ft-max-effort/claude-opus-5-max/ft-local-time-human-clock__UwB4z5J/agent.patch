diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..065fdc1
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders the timestamp, and leaves the words to the browser" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12T18:42:13Z" class="local-time-value" data-controller="local-time" data-local-time-format-value="relative"></time>),
+      local_time_tag(Time.utc(2025, 9, 12, 18, 42, 13))
+  end
+
+  test "renders the same markup whatever timezone the server is in" do
+    time = Time.utc(2025, 9, 12, 18, 42, 13)
+
+    assert_equal Time.use_zone("America/New_York") { local_time_tag(time) },
+      Time.use_zone("Asia/Tokyo") { local_time_tag(time) }
+  end
+
+  test "sends dates as dates, so a day can't slide into the one before it" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12" class="local-time-value" data-controller="local-time" data-local-time-format-value="weekday_date"></time>),
+      local_time_tag(Date.new(2025, 9, 12), format: :weekday_date)
+  end
+
+  test "renders the format to use along with any other tag options" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-12T18:42:13Z" class="local-time-value card__timestamp" data-controller="local-time" data-local-time-format-value="date" data-turbo-permanent="true"></time>),
+      local_time_tag(Time.utc(2025, 9, 12, 18, 42, 13), format: :date, class: "card__timestamp", data: { turbo_permanent: true })
+  end
+
+  test "refuses formats the browser doesn't know" do
+    assert_raises(ArgumentError) { local_time_tag(Time.now, format: :whenever) }
+  end
+end
