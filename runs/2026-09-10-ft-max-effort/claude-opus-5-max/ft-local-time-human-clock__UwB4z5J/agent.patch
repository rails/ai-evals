+++ b/test/integration/local_times_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class LocalTimesTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :david
+  end
+
+  test "pages carry timestamps for the browser to turn into words" do
+    get card_path(cards(:logo))
+
+    assert_select "time.local-time-value[datetime][data-controller=?]", "local-time" do |times|
+      assert times.many?, "Expected the card to render its timestamps"
+      times.each { |time| assert_equal "", time.text, "Expected the browser, not the server, to say the time" }
+    end
+  end
+
+  test "public pages carry timestamps too" do
+    boards(:writebook).publish
+    sign_out
+
+    get public_board_card_path(boards(:writebook).publication.key, cards(:logo))
+
+    assert_select "time.local-time-value[datetime]"
+  end
+
+  test "cards render the same markup for every timezone" do
+    cookies[:timezone] = "America/New_York"
+    get card_path(cards(:logo))
+    in_new_york = card_markup
+
+    cookies[:timezone] = "Asia/Tokyo"
+    get card_path(cards(:logo))
+
+    assert_equal in_new_york, card_markup
+  end
+
+  private
+    def card_markup
+      css_select("##{dom_id(cards(:logo), :card_container)}").to_s
+    end
+end
diff --git a/test/system/local_times_test.rb b/test/system/local_times_test.rb
new file mode 100644
index 0000000..0b06341
--- /dev/null
+++ b/test/system/local_times_test.rb
@@ -0,0 +1,63 @@
+require "application_system_test_case"
+
+class LocalTimesTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "a comment from today reads as the time on the viewer's own clock" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update!(created_at: Time.current)
+
+    in_timezone "America/New_York" do
+      visit card_url(comment.card)
+      assert_selector timestamp_for(comment), text: clock_time(comment.created_at, "America/New_York")
+    end
+
+    in_timezone "Asia/Tokyo" do
+      visit card_url(comment.card)
+      assert_selector timestamp_for(comment), text: clock_time(comment.created_at, "Asia/Tokyo")
+    end
+  end
+
+  test "older comments read as words" do
+    last_nights, earlier = comments(:logo_agreement_kevin), comments(:logo_agreement_jz)
+    last_nights.update!(created_at: 1.day.ago)
+    earlier.update!(created_at: 5.days.ago)
+
+    visit card_url(last_nights.card)
+
+    assert_selector timestamp_for(last_nights), text: /\Ayesterday\z/i
+    assert_selector timestamp_for(earlier), text: /\A5 days ago\z/i
+  end
+
+  test "a card about to be postponed says how long it has left" do
+    card = cards(:logo)
+
+    card.update! last_active_at: 3.days.from_now - card.auto_postpone_period
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :closure_notice)}", text: /in 3 days/i
+
+    card.update! last_active_at: 1.day.from_now - card.auto_postpone_period
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :closure_notice)}", text: /tomorrow/i
+  end
+
+  private
+    def timestamp_for(comment)
+      "##{dom_id(comment)} .comment__permalink-title time"
+    end
+
+    def clock_time(time, timezone)
+      time.in_time_zone(timezone).strftime("%-l:%M %p")
+    end
+
+    def in_timezone(timezone)
+      page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: timezone
+      yield
+    ensure
+      page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: ""
+    end
+end
