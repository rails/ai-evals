diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..dd48259 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,29 @@
+# Times belong to the person reading them, not to the server that happens to render
+# them. We only ever send the raw timestamp and let the browser say it in the viewer's
+# own timezone — which also keeps the markup identical, and cacheable, for everyone.
+#
+# See app/javascript/controllers/local_time_controller.js for the words themselves.
 module TimeHelper
+  LOCAL_TIME_FORMATS = %i[ relative time date date_with_year weekday_date weekday_date_with_year date_and_time full ]
+
+  def local_time_tag(time, format: :relative, **options)
+    raise ArgumentError, "Unknown local time format: #{format}" unless format.to_sym.in?(LOCAL_TIME_FORMATS)
+
+    tag.time \
+      datetime: local_time_datetime(time),
+      class: class_names("local-time-value", options.delete(:class)),
+      data: { controller: "local-time", local_time_format_value: format, **options.delete(:data).to_h },
+      **options
+  end
+
+  private
+    # Timestamps travel as instants in UTC, which read the same in the markup whoever
+    # renders them. Dates travel as plain dates, so a day can't slide into the one before it.
+    def local_time_datetime(time)
+      if time.is_a?(Date) && !time.is_a?(DateTime)
+        time.iso8601
+      else
+        time.in_time_zone("UTC").iso8601
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..775573d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,73 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime, isDateOnly, parseDateTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Renders the timestamp the server sent as words in the viewer's own timezone. The
+// markup stays the same for everyone — and stays cacheable — while the words don't.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #observer
+
+  connect() {
+    this.render()
+    this.#renderAgainWhenChanged()
+    startRefreshing(this)
+  }
+
+  disconnect() {
+    stopRefreshing(this)
+    this.#observer?.disconnect()
+  }
+
+  render() {
+    if (this.#date) {
+      this.#write(formatDateTime(this.#date, this.formatValue), formatDateTime(this.#date, this.#titleFormat))
+    }
+  }
+
+  get #datetime() {
+    return this.element.getAttribute("datetime")
+  }
+
+  get #date() {
+    return parseDateTime(this.#datetime)
+  }
+
+  get #titleFormat() {
+    return isDateOnly(this.#datetime) ? "weekday_date_with_year" : "full"
+  }
+
+  #write(words, title) {
+    if (this.element.textContent !== words) this.element.textContent = words
+    if (this.element.getAttribute("title") !== title) this.element.setAttribute("title", title)
+  }
+
+  // Morphed page refreshes hand back the wordless markup the server rendered, so
+  // render again whenever the timestamp or the words we wrote change underneath us.
+  #renderAgainWhenChanged() {
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, {
+      attributeFilter: [ "datetime" ], characterData: true, childList: true, subtree: true
+    })
+  }
+}
+
+// One clock for the whole page: relative times go stale as the day turns over.
+const refreshables = new Set()
+let refreshTimer
+
+function startRefreshing(controller) {
+  refreshables.add(controller)
+  refreshTimer ||= setInterval(() => refreshables.forEach(refreshable => refreshable.render()), REFRESH_INTERVAL)
+}
+
+function stopRefreshing(controller) {
+  refreshables.delete(controller)
+
+  if (refreshables.size === 0) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+  }
+}
