diff --git a/test/i18n/translations_test.rb b/test/i18n/translations_test.rb
new file mode 100644
index 0000000..e0a5c92
--- /dev/null
+++ b/test/i18n/translations_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+# Every language Fizzy speaks has to say everything, so nobody falls back to English.
+class I18nTranslationsTest < ActiveSupport::TestCase
+  LOCALE_FILES = Rails.root.glob("config/locales/*.yml")
+
+  test "every locale knows every translation" do
+    missing = I18n.available_locales.flat_map do |locale|
+      (keys_for(I18n.default_locale) - keys_for(locale)).map { |key| "#{locale}.#{key}" }
+    end
+
+    assert_empty missing, "Missing translations: #{missing.join(", ")}"
+  end
+
+  test "every translation a template asks for exists" do
+    missing = templates.flat_map do |template|
+      keys_in(template).flat_map { |key| missing_locales_for(key).map { |locale| "#{locale}.#{key} (#{template})" } }
+    end
+
+    assert_empty missing, "Missing translations: #{missing.join(", ")}"
+  end
+
+  test "every translation the rest of the app asks for exists" do
+    missing = sources.flat_map do |source|
+      File.read(source).scan(/\bI18n\.t\(\s*"([.a-z0-9_]+)"/).flatten.flat_map do |key|
+        missing_locales_for(key).map { |locale| "#{locale}.#{key} (#{source})" }
+      end
+    end
+
+    assert_empty missing, "Missing translations: #{missing.join(", ")}"
+  end
+
+  private
+    def templates
+      Rails.root.glob("app/views/**/*.erb").map { |template| template.relative_path_from(Rails.root) }
+    end
+
+    def sources
+      Rails.root.glob("{app,lib}/**/*.rb").map { |source| source.relative_path_from(Rails.root) }
+    end
+
+    def missing_locales_for(key)
+      I18n.available_locales.reject { |locale| I18n.exists?(key, locale) }
+    end
+
+    def keys_in(template)
+      scope = scope_for(template)
+
+      File.read(template).scan(/\bt\(\s*"([.a-z0-9_]+)"/).flatten.map do |key|
+        key.start_with?(".") ? "#{scope}#{key}" : key
+      end
+    end
+
+    def scope_for(template)
+      template.relative_path_from("app/views").to_s.sub(/\..*\z/, "").delete_prefix("mailers/").gsub(%r{/_?}, ".")
+    end
+
+    def keys_for(locale)
+      flatten(translations_for(locale)).keys
+    end
+
+    def translations_for(locale)
+      @translations ||= {}
+      @translations[locale] ||= LOCALE_FILES.inject({}) { |all, file| all.deep_merge(YAML.safe_load_file(file, aliases: true)[locale.to_s] || {}) }
+    end
+
+    def flatten(tree, prefix = nil, flattened = {})
+      tree.each do |key, value|
+        scoped_key = [ prefix, key ].compact.join(".")
+
+        if value.is_a?(Hash) && !pluralization?(value)
+          flatten(value, scoped_key, flattened)
+        else
+          flattened[scoped_key] = value
+        end
+      end
+
+      flattened
+    end
+
+    # Languages count differently: Japanese only ever needs the :other form.
+    def pluralization?(tree)
+      tree.keys.all? { |key| key.in?(%w[ zero one two few many other ]) }
+    end
+end
diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..e29a161
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "pages render in English for people who never chose a language" do
+    get root_path
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_includes response.body, "Skip to main content"
+  end
+
+  test "choosing a locale switches the page" do
+    get root_path(locale: :ja)
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, I18n.t("shared.skip_to_main_content", locale: :ja)
+  end
+
+  test "the chosen locale sticks for the rest of the session" do
+    get root_path(locale: :ja)
+    get root_path
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "the chosen locale sticks for the next session from a clean browser" do
+    get root_path(locale: :ja)
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    logout_and_sign_in_as :kevin
+    get root_path
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "switching back to English" do
+    get root_path(locale: :ja)
+    get root_path(locale: :en)
+
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+
+  test "a locale we don't offer changes nothing" do
+    get root_path(locale: :xx)
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil identities(:kevin).reload.locale
+  end
+
+  test "a locale we don't offer leaves the chosen one alone" do
+    get root_path(locale: :ja)
+    get root_path(locale: :xx)
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "a nonsense locale never breaks a page" do
+    get root_path(locale: { sneaky: "ja" })
+    assert_response :success
+    assert_select "html[lang=en]"
+
+    get root_path(locale: [ "ja" ])
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "cached cards are rendered in the language of whoever is looking" do
+    with_actionview_partial_caching do
+      get cards_path
+      assert_includes response.body, I18n.t("cards.display.preview.meta.last_updated", locale: :en)
+
+      get cards_path(locale: :ja)
+      assert_includes response.body, I18n.t("cards.display.preview.meta.last_updated", locale: :ja)
+    end
+  end
+
+  test "emails are written in the language the recipient chose" do
+    get root_path(locale: :ja)
+
+    magic_link = identities(:kevin).reload.magic_links.create!(purpose: :sign_in)
+    mail = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal I18n.t("magic_link_mailer.sign_in_instructions.subject", code: magic_link.code, locale: :ja), mail.subject
+    assert_equal I18n.t("magic_link_mailer.sign_in_instructions.sign_in_title", locale: :ja), mail.html_part.body.to_s[/<h1 class="title">(.*)<\/h1>/, 1]
+  end
+
+  test "the static error pages speak every language" do
+    %w[ 400 404 422 500 406-unsupported-browser ].each do |page|
+      html = Rails.public_path.join("#{page}.html").read
+
+      assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, html, "#{page}.html is missing Japanese")
+      assert_match(/[A-Za-z]{3,}/, html, "#{page}.html is missing English")
+    end
+  end
+end
