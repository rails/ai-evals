diff --git a/app/javascript/helpers/translations.js b/app/javascript/helpers/translations.js
new file mode 100644
index 0000000..4e5fd2f
--- /dev/null
+++ b/app/javascript/helpers/translations.js
@@ -0,0 +1,42 @@
+// Strings rendered by the browser are translated on the server and shipped with
+// the page, so they speak the same language as everything else on it.
+
+let cache = { source: null, translations: {} }
+
+export function locale() {
+  return document.documentElement.lang || "en"
+}
+
+export function translate(key, interpolations = {}) {
+  return interpolate(pluralize(lookup(key), interpolations.count), interpolations)
+}
+
+function lookup(key) {
+  return key.split(".").reduce((translations, part) => translations?.[part], translations())
+}
+
+function translations() {
+  const source = document.getElementById("translations")?.textContent || "{}"
+
+  if (cache.source !== source) {
+    cache = { source, translations: JSON.parse(source) }
+  }
+
+  return cache.translations
+}
+
+function pluralize(translation, count) {
+  if (translation && typeof translation === "object") {
+    return (count === 1 && translation.one) ? translation.one : translation.other
+  } else {
+    return translation
+  }
+}
+
+function interpolate(translation, interpolations) {
+  if (typeof translation === "string") {
+    return translation.replace(/%\{(\w+)\}/g, (match, name) => interpolations[name] ?? match)
+  } else {
+    return ""
+  }
+}
