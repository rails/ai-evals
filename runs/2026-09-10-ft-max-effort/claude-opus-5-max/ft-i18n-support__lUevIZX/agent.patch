diff --git a/app/models/identity/localizable.rb b/app/models/identity/localizable.rb
new file mode 100644
index 0000000..96959a9
--- /dev/null
+++ b/app/models/identity/localizable.rb
@@ -0,0 +1,23 @@
+module Identity::Localizable
+  extend ActiveSupport::Concern
+
+  included do
+    normalizes :locale, with: ->(locale) { locale.to_s.presence }
+    validates :locale, inclusion: { in: ->(_identity) { available_locales } }, allow_nil: true
+  end
+
+  class_methods do
+    def available_locales
+      I18n.available_locales.map(&:to_s)
+    end
+  end
+
+  # Languages come and go, so never hand out one Fizzy no longer speaks.
+  def locale
+    super&.presence_in(self.class.available_locales)
+  end
+
+  def prefer_locale(locale)
+    update!(locale: locale) unless self.locale == locale.to_s
+  end
+end
