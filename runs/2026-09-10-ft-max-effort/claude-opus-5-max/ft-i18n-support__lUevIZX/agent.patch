diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..f4034cf
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,42 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :remember_locale_choice
+    around_action :set_current_locale
+
+    helper_method :current_locale
+
+    etag { current_locale }
+  end
+
+  private
+    # Runs before authentication, so a `?locale=` choice sticks even when the request
+    # is bounced to the sign-in screen. Locales we don't speak are ignored.
+    def remember_locale_choice
+      if locale = supported_locale(params[:locale])
+        session[:locale] = locale
+      end
+    end
+
+    def set_current_locale(&)
+      remember_locale_preference
+
+      I18n.with_locale(current_locale, &)
+    end
+
+    # Runs after authentication, so the choice outlives this browser session.
+    def remember_locale_preference
+      if locale = supported_locale(session[:locale])
+        Current.identity&.prefer_locale(locale)
+      end
+    end
+
+    def current_locale
+      @current_locale ||= supported_locale(session[:locale]) || supported_locale(Current.identity&.locale) || I18n.default_locale
+    end
+
+    def supported_locale(locale)
+      locale.to_s.to_sym if locale.present? && I18n.available_locales.include?(locale.to_s.to_sym)
+    end
+end
