@@ -3,9 +3,28 @@ class Account::DataTransfer::AccountRecordSet < Account::DataTransfer::RecordSet
     super(account: account, model: Account)
   end
 
+  # The account is already there: the import fills it in rather than creating a
+  # second one, and keeps its own id and external account id.
+  def import(zip, mapping)
+    with_zip(zip) do
+      attributes = read_attributes(exported_path)
+      mapping.map attributes["id"], account.id
+      account.update! name: attributes["name"], cards_count: attributes["cards_count"], created_at: attributes["created_at"]
+    end
+  end
+
+  def rollback(mapping)
+    # The account itself is destroyed by the import that created it.
+  end
+
   private
     def records
       [ account ]
     end
 
+    def exported_path
+      exported_paths.sole
+    rescue Enumerable::SoleItemExpectedError
+      raise Account::DataTransfer::Importer::InvalidFile, "This export doesn't hold an account"
+    end
 end
