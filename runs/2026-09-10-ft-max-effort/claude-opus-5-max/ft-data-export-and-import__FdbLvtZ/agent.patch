+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "an admin can ask for the whole account" do
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with job: Export::ProcessJob do
+        post account_exports_path
+      end
+    end
+
+    export = Export.last
+    assert export.account_export?
+    assert_equal users(:kevin), export.creator
+    assert_equal accounts(:"37s"), export.account
+    assert_redirected_to account_settings_path
+  end
+
+  test "everybody else can't" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..985d0d4
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include DataTransferTestHelper
+
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "new" do
+    untenanted do
+      get new_account_import_path
+
+      assert_response :success
+      assert_select "input[type=file]"
+    end
+  end
+
+  test "new needs a session" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+
+      assert_response :redirect
+    end
+  end
+
+  test "create starts an import of the file" do
+    untenanted do
+      assert_difference -> { Import.count }, 1 do
+        assert_enqueued_with job: Import::ProcessJob do
+          post account_imports_path, params: { import: { file: export_upload } }
+        end
+      end
+
+      import = Import.last
+      assert_equal identities(:kevin), import.identity
+      assert import.pending?
+      assert import.file.attached?
+      assert_redirected_to account_import_path(import)
+    end
+  end
+
+  test "create without a file comes back with an error" do
+    untenanted do
+      assert_no_difference [ -> { Import.count }, -> { Account.count } ] do
+        post account_imports_path, params: { import: { file: "" } }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "show follows along" do
+    import = import_now(export_now(accounts(:"37s"), creator: users(:kevin)), identity: identities(:kevin))
+
+    untenanted do
+      get account_import_path(import)
+
+      assert_response :success
+      assert_select "h1", text: /ready/i
+    end
+  end
+
+  test "show is only for whoever started the import" do
+    import = import_now(export_now(accounts(:"37s"), creator: users(:kevin)), identity: identities(:david))
+
+    untenanted do
+      get account_import_path(import)
+
+      assert_response :not_found
+    end
+  end
+
+  test "importing an account from start to finish" do
+    untenanted do
+      perform_enqueued_jobs do
+        post account_imports_path, params: { import: { file: export_upload } }
+      end
+    end
+
+    import = Import.last
+    assert import.completed?, import.error_message
+    assert_equal accounts(:"37s").cards.count, import.account.cards.count
+    assert import.account.users.find_by(identity: identities(:kevin)).owner?
+  end
+
+  private
+    def export_upload
+      export = export_now(accounts(:"37s"), creator: users(:kevin))
+      fixture_file_upload local_path_for(export.file), "application/zip"
+    end
+end
diff --git a/test/controllers/users/exports_controller_test.rb b/test/controllers/users/exports_controller_test.rb
new file mode 100644
index 0000000..2c94892
--- /dev/null
+++ b/test/controllers/users/exports_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Users::ExportsControllerTest < ActionDispatch::IntegrationTest
+  include DataTransferTestHelper
+
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "anyone can ask for the cards they can see" do
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with job: Export::ProcessJob do
+        post user_exports_path(@user)
+      end
+    end
+
+    export = Export.last
+    assert export.cards_export?
+    assert_equal @user, export.creator
+    assert_equal accounts(:"37s"), export.account
+    assert_redirected_to user_path(@user)
+  end
+
+  test "exports are nobody else's business" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post user_exports_path(@user)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "downloading an export" do
+    export = export_now(accounts(:"37s"), creator: @user)
+
+    get user_export_path(@user, export)
+
+    assert_redirected_to rails_blob_path(export.file, disposition: :attachment)
+  end
+
+  test "downloading the file behind an export" do
+    export = export_now(accounts(:"37s"), creator: @user)
+
+    get user_export_path(@user, export)
+    follow_redirect!
+
+    assert_response :redirect
+    assert_match export.filename, response.location
+  end
+
+  test "downloading someone else's export" do
+    export = export_now(accounts(:"37s"), creator: @user)
+    logout_and_sign_in_as :david
+
+    get user_export_path(@user, export)
+
+    assert_response :forbidden
+  end
+
+  test "a download link stops working after a day" do
+    export = export_now(accounts(:"37s"), creator: @user)
+
+    travel Export::DOWNLOAD_WINDOW + 1.minute do
+      get user_export_path(@user, export)
+
+      assert_redirected_to user_path(@user)
+      assert_match /expired/, flash[:alert]
+    end
+  end
+
+  test "downloading an export needs a session" do
+    export = export_now(accounts(:"37s"), creator: @user)
+    sign_out
+
+    get user_export_path(@user, export)
+
+    assert_response :redirect
+    assert_no_match user_export_path(@user, export), response.location
+  end
+end
