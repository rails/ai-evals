+++ b/test/models/import_test.rb
@@ -0,0 +1,240 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper, DataTransferTestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @identity = identities(:mike)
+  end
+
+  test "an account import brings back boards, cards, comments and people" do
+    export = export_now(@account, creator: @admin)
+
+    import = import_now(export, identity: @identity)
+    imported = import.account
+
+    assert import.completed?, import.error_message
+    assert_equal @account.name, imported.name
+    assert_equal @account.boards.count, imported.boards.count
+    assert_equal @account.cards.count, imported.cards.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: imported).count
+    assert_equal Event.where(account: @account).count, Event.where(account: imported).count
+    assert_equal @account.cards.pluck(:title).sort, imported.cards.pluck(:title).sort
+  end
+
+  test "people come back attached to the identities on this instance" do
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+
+    assert_equal @account.users.map { |user| user.identity&.email_address }.compact.sort,
+      (imported.users.map { |user| user.identity&.email_address }.compact - [ @identity.email_address ]).sort
+    assert_equal users(:david).name, imported.users.find_by(identity: identities(:david)).name
+  end
+
+  test "people who aren't on this instance yet get an identity of their own" do
+    export = export_now(account_with_a_stranger, creator: @admin)
+    Identity.find_by(email_address: "stranger@example.com").destroy
+
+    imported = import_now(export, identity: @identity).account
+
+    assert_equal "Stranger", imported.users.find_by(identity: Identity.find_by(email_address: "stranger@example.com")).name
+  end
+
+  test "whoever imports an account owns it" do
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+    user = imported.users.find_by(identity: @identity)
+
+    assert user.owner?
+    assert user.verified?
+    assert_includes @identity.reload.accounts, imported
+  end
+
+  test "files come back, stored again under keys of their own" do
+    card = attach_image(cards(:logo))
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+    imported_card = imported.cards.find_by!(number: card.number)
+
+    assert imported_card.image.attached?
+    assert_not_equal card.image.key, imported_card.image.key
+    assert_equal card.image.download, imported_card.image.download
+  end
+
+  test "the account the export came from is left alone" do
+    card = attach_image(cards(:logo))
+    export = export_now(@account, creator: @admin)
+    cards_before = @account.cards.pluck(:id).sort
+
+    import_now(export, identity: @identity)
+
+    assert_equal cards_before, @account.cards.reload.pluck(:id).sort
+    assert_equal card.image.key, cards(:logo).reload.image.key
+  end
+
+  test "imported cards can be searched for" do
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+    user = imported.users.find_by(identity: @identity)
+
+    assert_equal imported.cards.published.count,
+      Search::Record.for(imported.id).where(account_id: imported.id, searchable_type: "Card").count
+  end
+
+  test "a file that isn't a Fizzy export says so and leaves nothing behind" do
+    assert_no_difference -> { Account.count } do
+      import = import_file(uploaded_zip("hello.txt" => "Hello!"), identity: @identity)
+
+      assert import.failed?
+      assert_equal "This file isn't a Fizzy export", import.error_message
+      assert_nil import.account
+      assert_not import.file.attached?
+    end
+  end
+
+  test "an export of cards can't be imported as an account" do
+    export = export_now(@account, creator: users(:david), kind: :cards)
+
+    import = import_now(export, identity: @identity)
+
+    assert import.failed?
+    assert_match "whole account export", import.error_message
+  end
+
+  test "an import that can't be completed leaves nothing behind" do
+    export = export_now(account_with_a_stranger, creator: @admin)
+    Identity.find_by(email_address: "stranger@example.com").destroy
+
+    Account::DataTransfer::Importer.any_instance.stubs(:reindex).raises(RuntimeError, "Boom")
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Card.count },
+      -> { Comment.count }, -> { Identity.count }, -> { ActiveStorage::Blob.count } ] do
+      import = import_now(export, identity: @identity)
+
+      assert import.failed?
+      assert_equal "Boom", import.error_message
+      assert_nil import.account
+    end
+  end
+
+  test "the files of an import that can't be completed are deleted too" do
+    attach_image cards(:logo)
+    export = export_now(@account, creator: @admin)
+    Account::DataTransfer::Importer.any_instance.stubs(:reindex).raises(RuntimeError, "Boom")
+
+    keys = tracking_uploads { import_now(export, identity: @identity) }
+
+    assert keys.any?, "Expected the import to have stored something"
+    keys.each { |key| assert_not ActiveStorage::Blob.service.exist?(key), "#{key} was left behind" }
+  end
+
+  test "an import emails when it's done" do
+    export = export_now(@account, creator: @admin)
+
+    assert_emails 1 do
+      perform_enqueued_jobs { import_now(export, identity: @identity) }
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_equal "Your Fizzy import is done", email.subject
+  end
+
+  test "an import emails what went wrong" do
+    assert_emails 1 do
+      perform_enqueued_jobs { import_file(uploaded_zip("hello.txt" => "Hello!"), identity: @identity) }
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_equal "Your Fizzy import didn't work out", email.subject
+    assert_match "This file isn't a Fizzy export", email.body.encoded
+  end
+
+  test "an import needs a file" do
+    assert_no_difference -> { Account.count } do
+      assert_raises ActiveRecord::RecordInvalid do
+        Import.start file: nil, identity: @identity
+      end
+    end
+  end
+
+  test "a published board comes back published, under an address of its own" do
+    publication = boards(:writebook).create_publication!
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+    imported_publication = imported.boards.find_by!(name: boards(:writebook).name).publication
+
+    assert imported_publication.present?
+    assert_not_equal publication.key, imported_publication.key
+    assert_equal publication.key, publication.reload.key
+  end
+
+  test "image variants come back too" do
+    embed_image_in cards(:logo), :description
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+    embed = imported.cards.find_by!(number: cards(:logo).number).description.embeds.sole
+
+    assert_equal ActiveStorage::VariantRecord.where(account_id: @account.id).count,
+      ActiveStorage::VariantRecord.where(account_id: imported.id).count
+    assert embed.variant(:small).processed?
+  end
+
+  test "storage adds up again after an import" do
+    attach_image cards(:logo)
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+
+    assert_equal @account.bytes_used_exact, imported.bytes_used_exact
+    assert_equal boards(:writebook).bytes_used_exact,
+      imported.boards.find_by!(name: boards(:writebook).name).bytes_used_exact
+  end
+
+  test "titles and bodies come back in one piece, whatever they're written in" do
+    card = cards(:logo)
+    with_current_user(:david) do
+      card.update! title: "Café ☕ — ünïcode 🎉", description: "Håll dig lugn 😀"
+    end
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+    imported_card = imported.cards.find_by!(number: card.number)
+
+    assert_equal card.title, imported_card.title
+    assert_equal card.description.to_s, imported_card.description.to_s
+  end
+
+  test "the people an event names come back with it" do
+    with_current_user(:david) { cards(:logo).toggle_assignment(users(:jz)) }
+    export = export_now(@account, creator: @admin)
+
+    imported = import_now(export, identity: @identity).account
+    events = Event.where(account_id: imported.id, action: "card_assigned")
+
+    assert events.any?
+    assert_equal assignee_names_of(Event.where(account_id: @account.id, action: "card_assigned")),
+      assignee_names_of(events)
+    assert_equal [ imported.id ], events.flat_map { |event| event.assignees.map(&:account_id) }.uniq
+  end
+
+  private
+    def assignee_names_of(events)
+      events.flat_map { |event| event.assignees.map(&:name) }.sort
+    end
+
+    def account_with_a_stranger
+      Account.create_with_owner \
+        account: { name: "Newco" },
+        owner: { name: "Stranger", identity: Identity.create!(email_address: "stranger@example.com") }
+    end
+end
