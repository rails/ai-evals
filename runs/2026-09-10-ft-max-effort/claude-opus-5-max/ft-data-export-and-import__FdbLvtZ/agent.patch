diff --git a/app/models/account/data_transfer/mapping.rb b/app/models/account/data_transfer/mapping.rb
new file mode 100644
index 0000000..3152f4b
--- /dev/null
+++ b/app/models/account/data_transfer/mapping.rb
@@ -0,0 +1,78 @@
+# Translates the identifiers found in an export into the ones used by the account
+# the data is imported into. Records keep their shape, but never their ids: a Fizzy
+# instance may well hold the account the export came from, so everything that's
+# imported gets a brand new id, storage key, and, for people, a local identity.
+class Account::DataTransfer::Mapping
+  # Ids are UUIDv7s stored as 25 character base36 strings.
+  ID_FORMAT = /\A[0-9a-z]{25}\z/
+
+  # Identities are global, so they're resolved by email address instead of by id.
+  UNTRANSLATED_ATTRIBUTES = %w[ identity_id ].freeze
+
+  def initialize
+    @ids = {}
+    @keys = {}
+    @created_identity_ids = []
+  end
+
+  def translate(attributes)
+    attributes.to_h { |name, value| [ name, translated(name, value) ] }
+  end
+
+  def map(old_id, new_id)
+    @ids[old_id] = new_id
+  end
+
+  def id_for(old_id)
+    if old_id.is_a?(String) && old_id.match?(ID_FORMAT)
+      @ids[old_id] ||= ActiveRecord::Type::Uuid.generate
+    else
+      old_id
+    end
+  end
+
+  def key_for(old_key)
+    @keys[old_key] ||= ActiveStorage::Blob.generate_unique_secure_token
+  end
+
+  def keys
+    @keys.values
+  end
+
+  def identity_for(email_address)
+    Identity.find_by(email_address: email_address) || create_identity(email_address)
+  end
+
+  def created_identities
+    Identity.where(id: @created_identity_ids)
+  end
+
+  private
+    def translated(name, value)
+      case value
+      when Hash, Array then translated_json(value)
+      else identifier?(name) ? id_for(value) : value
+      end
+    end
+
+    # Ids also turn up inside JSON columns -- the people an assignment event names, say
+    # -- so they're translated wherever they're found.
+    def translated_json(value)
+      case value
+      when Hash then value.transform_values { |nested| translated_json(nested) }
+      when Array then value.map { |nested| translated_json(nested) }
+      when String then id_for(value)
+      else value
+      end
+    end
+
+    def identifier?(name)
+      (name == "id" || name.end_with?("_id")) && !name.in?(UNTRANSLATED_ATTRIBUTES)
+    end
+
+    def create_identity(email_address)
+      Identity.create!(email_address: email_address).tap do |identity|
+        @created_identity_ids << identity.id
+      end
+    end
+end
