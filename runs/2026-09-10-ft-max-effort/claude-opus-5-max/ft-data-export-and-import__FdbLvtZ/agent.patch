+      assert_equal [ "docs/readme.txt" ], reader.glob("docs/*.txt")
+      assert_equal "Readme", reader.read("docs/readme.txt")
+      assert_equal "PNG data", reader.read("images/logo.png")
+    end
+  end
+
+  test "reader streams an entry in chunks" do
+    content = SecureRandom.bytes(64.kilobytes)
+    zip = written_zip { |writer| writer.add_file "moon.jpg", content, compress: false }
+
+    File.open(zip, "rb") do |io|
+      chunks = []
+      ZipFile::Reader.new(io).extract("moon.jpg") { |chunk| chunks << chunk }
+
+      assert_equal content, chunks.join
+    end
+  end
+
+  test "reader complains about an entry that isn't there" do
+    zip = written_zip { |writer| writer.add_file "hello.txt", "Hello!" }
+
+    File.open(zip, "rb") do |io|
+      assert_raises ZipFile::MissingEntry do
+        ZipFile::Reader.new(io).read("missing.txt")
+      end
+    end
+  end
+
+  test "opening the zip attached to a record" do
+    export = Export.create! account: accounts(:"37s"), creator: users(:kevin), kind: :account
+    ZipFile.create_for(export.file, filename: "export.zip") { |zip| zip.add_file "hello.txt", "Hello!" }
+
+    ZipFile.open_for(export.file) do |zip|
+      assert_equal "Hello!", zip.read("hello.txt")
+    end
+  end
+
+  test "reading a zip from storage a range at a time" do
+    export = Export.create! account: accounts(:"37s"), creator: users(:kevin), kind: :account
+    ZipFile.create_for(export.file, filename: "export.zip") { |zip| zip.add_file "hello.txt", "Hello!" }
+
+    zip = ZipFile::Reader.new(ZipFile::BlobIO.new(export.file.blob))
+
+    assert_equal [ "hello.txt" ], zip.glob("*.txt")
+    assert_equal "Hello!", zip.read("hello.txt")
+  end
+
+  private
+    def written_zip
+      tempfile = Tempfile.new([ "test", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      yield writer
+      writer.close
+      tempfile.flush
+
+      tempfile.path
+    end
 end
