diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..a6571fa
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper, DataTransferTestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+  end
+
+  test "account export holds a json file for every record in the account" do
+    export = export_now(@account, creator: @admin)
+
+    assert export.completed?
+    assert export.file.attached?
+
+    read_export(export) do |zip|
+      assert_equal 1, zip.glob("accounts/*.json").size
+      assert_equal @account.users.count, zip.glob("users/*.json").size
+      assert_equal @account.boards.count, zip.glob("boards/*.json").size
+      assert_equal @account.cards.count, zip.glob("cards/*.json").size
+      assert_equal Comment.where(account: @account).count, zip.glob("comments/*.json").size
+    end
+  end
+
+  test "account export describes itself" do
+    export = export_now(@account, creator: @admin)
+
+    read_export(export) do |zip|
+      metadata = JSON.parse(zip.read("export.json"))
+
+      assert_equal "account", metadata["kind"]
+      assert_equal Account::DataTransfer::FORMAT_VERSION, metadata["format_version"]
+      assert_equal @account.name, metadata["account_name"]
+    end
+  end
+
+  test "account export leaves other accounts alone" do
+    export = export_now(@account, creator: @admin)
+
+    read_export(export) do |zip|
+      card_ids = zip.glob("cards/*.json").map { |path| File.basename(path, ".json") }
+
+      assert_equal @account.cards.ids.sort, card_ids.sort
+    end
+  end
+
+  test "account export carries every picture and file" do
+    card = attach_image(cards(:logo))
+    embedded = embed_image_in(cards(:layout), :description)
+
+    export = export_now(@account, creator: @admin)
+
+    read_export(export) do |zip|
+      assert zip.exists?("files/#{card.image.key}")
+      assert zip.exists?("files/#{embedded.key}")
+      assert_equal card.image.blob.byte_size, zip.read("files/#{card.image.key}").bytesize
+    end
+  end
+
+  test "account export leaves out the zips of other exports" do
+    export_now(@account, creator: @admin)
+    export = export_now(@account, creator: @admin)
+
+    read_export(export) do |zip|
+      assert_empty zip.glob("files/*")
+      assert_empty zip.glob("active_storage_blobs/*.json")
+    end
+  end
+
+  test "cards export holds the cards someone can see, with their comments" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    export = export_now(@account, creator: users(:david), kind: :cards)
+
+    read_export(export) do |zip|
+      assert zip.exists?("cards/#{card.number}.json")
+
+      exported = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, exported["title"]
+      assert_equal card.board.name, exported["board"]
+      assert_equal card.creator.name, exported["creator"]["name"]
+      assert_equal card.comments.count, exported["comments"].size
+
+      exported_comment = exported["comments"].find { |c| c["creator"]["name"] == comment.creator.name }
+      assert_equal comment.body.to_plain_text, exported_comment["body"]["text"]
+    end
+  end
+
+  test "cards export leaves out cards from boards someone can't see" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create! title: "Top secret", status: :published, last_active_at: Time.current
+    end
+    assert_not private_card.board.accessible_to?(users(:david))
+
+    export = export_now(@account, creator: users(:david), kind: :cards)
+
+    read_export(export) do |zip|
+      assert_not zip.exists?("cards/#{private_card.number}.json")
+    end
+  end
+
+  test "cards export carries the pictures and files attached to a card" do
+    card = attach_image(cards(:logo))
+    comment = cards(:logo).comments.create!(body: "Look", creator: users(:david))
+    embedded = embed_image_in(comment, :body)
+
+    export = export_now(@account, creator: users(:david), kind: :cards)
+
+    read_export(export) do |zip|
+      exported = JSON.parse(zip.read("cards/#{card.number}.json"))
+
+      assert_equal [ "files/#{card.number}/moon.jpg" ], exported["files"]
+      assert zip.exists?("files/#{card.number}/moon.jpg")
+      assert_equal embedded.byte_size, zip.read(exported["comments"].last["files"].sole).bytesize
+    end
+  end
+
+  test "two files with the same name on a card each get a place of their own" do
+    card = attach_image(cards(:logo))
+    embed_image_in card, :description
+
+    export = export_now(@account, creator: users(:david), kind: :cards)
+
+    read_export(export) do |zip|
+      exported = JSON.parse(zip.read("cards/#{card.number}.json"))
+
+      assert_equal [ "files/#{card.number}/moon.jpg", "files/#{card.number}/moon-1.jpg" ], exported["files"]
+      assert zip.exists?("files/#{card.number}/moon-1.jpg")
+    end
+  end
+
+  test "an export emails a download link when it's ready" do
+    export = nil
+
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        export = @account.exports.create!(creator: @admin, kind: :account)
+      end
+    end
+
+    assert export.reload.completed?
+    assert_equal [ @admin.identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert_match "#{@account.slug}/users/#{@admin.id}/exports/#{export.id}", ActionMailer::Base.deliveries.last.body.encoded
+  end
+
+  test "a download link works for a day" do
+    export = export_now(@account, creator: @admin)
+
+    assert export.downloadable?
+
+    travel Export::DOWNLOAD_WINDOW + 1.minute do
+      assert_not export.downloadable?
+      assert export.expired?
+    end
+  end
+
+  test "an export that can't be packed up says why" do
+    Account::DataTransfer::Exporter.any_instance.stubs(:export).raises(RuntimeError, "The zip broke")
+
+    export = export_now(@account, creator: @admin)
+
+    assert export.failed?
+    assert_equal "The zip broke", export.error_message
+    assert_not export.file.attached?
+    assert_not export.downloadable?
+  end
+
+  test "expired exports are purged" do
+    export = export_now(@account, creator: @admin)
+    blob = export.file.blob
+
+    travel Export::DOWNLOAD_WINDOW + 1.minute do
+      perform_enqueued_jobs { Export.purge_expired }
+    end
+
+    assert_not Export.exists?(export.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..e443de2
