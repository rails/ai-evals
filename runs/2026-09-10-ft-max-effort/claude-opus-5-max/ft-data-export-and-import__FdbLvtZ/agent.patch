diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..8718fed
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,20 @@
+# Reads a blob from its storage service as if it were a local IO, fetching only
+# the ranges that are asked for. That's what makes it possible to read a zip file
+# of any size straight from S3: the central directory sits at the end of the file,
+# so a handful of ranged reads replace a full download.
+class ZipFile::BlobIO < ZipKit::RemoteIO
+  def initialize(blob)
+    @blob = blob
+    @pos = 0
+    @remote_size = nil
+  end
+
+  private
+    def request_range(range)
+      @blob.service.download_chunk(@blob.key, range)
+    end
+
+    def request_object_size
+      @blob.byte_size
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..52e3363
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,43 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 5.megabytes
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def read(path)
+    +"".b.tap do |content|
+      extract(path) { |chunk| content << chunk }
+    end
+  end
+
+  def extract(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    extractor = extractor_for(path)
+
+    until extractor.eof?
+      if chunk = extractor.extract(CHUNK_SIZE)
+        yield chunk
+      end
+    end
+  end
+
+  private
+    def extractor_for(path)
+      entry_for(path).extractor_from(@io)
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise ZipFile::MissingEntry, "#{path} is not in this zip file" }
+    end
+end
