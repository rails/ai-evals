+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,21 @@
+# Moving an account, whole, between Fizzy instances: one zip holding a JSON file per
+# record, every file that was ever attached, and a small description of itself.
+module Account::DataTransfer
+  FORMAT_VERSION = 1
+
+  METADATA_PATH = "export.json"
+
+  ACCOUNT_KIND = "account"
+  CARDS_KIND = "cards"
+
+  class << self
+    def metadata_for(kind, **attributes)
+      {
+        "format_version" => FORMAT_VERSION,
+        "kind" => kind,
+        "exported_at" => Time.current.utc.iso8601,
+        **attributes.transform_keys(&:to_s)
+      }
+    end
+  end
+end
