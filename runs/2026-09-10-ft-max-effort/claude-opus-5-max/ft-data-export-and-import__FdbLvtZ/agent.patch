+<% @page_title = "Import an account" %>
+
+<section class="panel panel--centered flex flex-column gap">
+  <h1 class="txt-x-large font-weight-black txt-tight-lines margin-none">Import an account</h1>
+
+  <p class="margin-none">
+    Pick a Fizzy account export and we’ll build a new account out of it: boards, cards,
+    comments, files, and people, just as they were. We’ll email you when it’s done.
+  </p>
+
+  <%= form_with model: @import, url: account_imports_path, class: "flex flex-column gap" do |form| %>
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small">
+        <% @import.errors.full_messages.each do |message| %>
+          <div><%= message %></div>
+        <% end %>
+      </div>
+    <% end %>
+
+    <label class="flex flex-column gap-half txt-small">
+      <span>Account export (.zip)</span>
+      <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+    </label>
+
+    <button type="submit" class="btn btn--reversed center">
+      <span>Import account</span>
+    </button>
+  <% end %>
+</section>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
