+<% @page_title = "Import an account" %>
+
+<section class="panel panel--centered flex flex-column gap">
+  <% case @import.status %>
+  <% when "completed" %>
+    <h1 class="txt-x-large font-weight-black txt-tight-lines margin-none">Your account is ready</h1>
+    <p class="margin-none"><strong><%= @import.account.name %></strong> is back, with everything that was in it.</p>
+    <%= link_to "Open #{@import.account.name}", root_path(script_name: @import.account.slug), class: "btn btn--reversed center" %>
+  <% when "failed" %>
+    <h1 class="txt-x-large font-weight-black txt-tight-lines margin-none">That import didn’t work out</h1>
+    <p class="margin-none">
+      We couldn’t import that file, and nothing was created.
+      <% if @import.error_message.present? %>
+        Here’s what went wrong: <em><%= @import.error_message %></em>
+      <% end %>
+    </p>
+    <%= link_to "Try another file", new_account_import_path, class: "btn btn--reversed center" %>
+  <% else %>
+    <h1 class="txt-x-large font-weight-black txt-tight-lines margin-none">We’re importing your account</h1>
+    <p class="margin-none">This can take a while for a big account, so we’ll email you when it’s done. You can close this page.</p>
+    <%= link_to "Check again", account_import_path(@import), class: "btn center" %>
+  <% end %>
+</section>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
