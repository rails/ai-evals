+    email = ExportMailer.ready(@export)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy export is ready", email.subject
+  end
+
+  test "ready holds the download link" do
+    email = ExportMailer.ready(@export)
+
+    assert_match "#{@account.slug}/users/#{@user.id}/exports/#{@export.id}", email.body.encoded
+    assert_match "1 day", email.body.encoded
+  end
+
+  test "ready has both HTML and text parts" do
+    email = ExportMailer.ready(@export)
+
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+
+  test "failure says what went wrong" do
+    @export.update! status: :failed, error_message: "The zip broke"
+
+    email = ExportMailer.failure(@export)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy export didn't work out", email.subject
+    assert_match "The zip broke", email.body.encoded
+  end
+end
