diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..79a932b
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.user = users(:david)
+    sign_in_as :david
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+    assert_select "article.search-result", count: 0
+  end
+
+  test "finds cards by title" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "article.search-result", count: 1
+    assert_select "mark", text: "logo"
+    assert_select "a[href=?]", card_path(cards(:logo))
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update! description: "The kerning is atrocious"
+
+    get search_path(q: "kerning")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:layout))
+    assert_select "mark", text: "kerning"
+  end
+
+  test "finds cards by comment body" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:layout))
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "returns the newest matching cards first" do
+    older = boards(:writebook).cards.create! title: "Older sprocket", creator: users(:david), status: :published, created_at: 2.days.ago
+    newer = boards(:writebook).cards.create! title: "Newer sprocket", creator: users(:david), status: :published, created_at: 1.hour.ago
+
+    get search_path(q: "sprocket")
+
+    assert_response :success
+    assert_operator response.body.index(card_path(newer)), :<, response.body.index(card_path(older))
+  end
+
+  test "excludes cards from boards without access" do
+    boards(:private).cards.create! title: "Clandestine plans", creator: users(:kevin), status: :published
+
+    get search_path(q: "clandestine")
+
+    assert_response :success
+    assert_select "article.search-result", count: 0
+    assert_select "div.blank-slate"
+
+    logout_and_sign_in_as :kevin
+    get search_path(q: "clandestine")
+
+    assert_response :success
+    assert_select "article.search-result", count: 1
+  end
+
+  test "excludes drafted cards and their comments" do
+    card = boards(:writebook).cards.create! title: "Unpublished trinket", creator: users(:david), status: :published
+    card.comments.create! creator: users(:david), body: "A trinket comment"
+    card.update! status: :drafted
+
+    get search_path(q: "trinket")
+
+    assert_response :success
+    assert_select "article.search-result", count: 0
+  end
+
+  test "matches cards containing every word of the query" do
+    boards(:writebook).cards.create! title: "Ship the sprocket", creator: users(:david), status: :published
+    boards(:writebook).cards.create! title: "Ship the widget", creator: users(:david), status: :published
+
+    get search_path(q: "ship sprocket")
+
+    assert_response :success
+    assert_select "article.search-result", count: 1
+    assert_select "mark", text: "Ship"
+    assert_select "mark", text: "sprocket"
+  end
+
+  test "paginates results" do
+    20.times { |index| boards(:writebook).cards.create! title: "Sprocket #{index}", creator: users(:david), status: :published }
+
+    get search_path(q: "sprocket")
+
+    assert_response :success
+    assert_select "article.search-result", count: 15
+
+    get search_path(q: "sprocket", page: 2)
+
+    assert_response :success
+    assert_select "turbo-frame#search_results-pagination-contents-2 article.search-result", count: 5
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path
+    assert_redirected_to %r{/session}
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..ee9e16d
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+  end
+
+  test "finds cards by title" do
+    assert_equal [ cards(:logo) ], search("logo").cards.to_a
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update! description: "The kerning is atrocious"
+
+    assert_equal [ cards(:layout) ], search("kerning").cards.to_a
+  end
+
+  test "finds cards by the body of any of their comments" do
+    assert_equal [ cards(:layout) ], search("overflowing").cards.to_a
+  end
+
+  test "finds cards matching every term across titles, descriptions, and comments" do
+    cards(:layout).update! description: "The kerning is atrocious"
+
+    assert_equal [ cards(:layout) ], search("kerning overflowing").cards.to_a
+    assert_empty search("kerning logo").cards
+  end
+
+  test "finds cards regardless of case" do
+    assert_equal [ cards(:logo) ], search("LOGO").cards.to_a
+  end
+
+  test "returns the newest cards first" do
+    older = boards(:writebook).cards.create! title: "Older sprocket", creator: users(:david), status: :published, created_at: 2.days.ago
+    newer = boards(:writebook).cards.create! title: "Newer sprocket", creator: users(:david), status: :published, created_at: 1.hour.ago
+
+    assert_equal [ newer, older ], search("sprocket").cards.to_a
+  end
+
+  test "only finds cards on boards the user has access to" do
+    card = boards(:private).cards.create! title: "Clandestine plans", creator: users(:kevin), status: :published
+
+    assert_empty search("clandestine").cards
+    assert_equal [ card ], search("clandestine", user: users(:kevin)).cards.to_a
+  end
+
+  test "never finds drafted cards or their comments" do
+    card = boards(:writebook).cards.create! title: "Unpublished trinket", creator: users(:david), status: :published
+    card.comments.create! creator: users(:david), body: "A trinket of a comment"
+    card.update! status: :drafted
+
+    assert_empty search("trinket").cards
+  end
+
+  test "finds nothing without a query" do
+    assert_empty search("").cards
+    assert_empty search("   ").cards
+    assert_empty search(nil).cards
+  end
+
+  test "treats SQL wildcards as regular characters" do
+    card = boards(:writebook).cards.create! title: "100% done", creator: users(:david), status: :published
+
+    assert_includes search("100%").cards, card
+  end
+
+  test "collects the comments matching the search" do
+    search = search("agree")
+
+    assert_equal [ comments(:logo_agreement_jz) ], cards(:logo).comments_matching(search)
+    assert_empty cards(:layout).comments_matching(search)
+  end
+
+  test "is blank until it has terms" do
+    assert search("").blank?
+    assert search("   ").blank?
+    assert_not search("logo").blank?
+    assert search("logo").present?
+  end
+
+  private
+    def search(query, user: Current.user)
+      Search.new(query, user: user)
+    end
+end
