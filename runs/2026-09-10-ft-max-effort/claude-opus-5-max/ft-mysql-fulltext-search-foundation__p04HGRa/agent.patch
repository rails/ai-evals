index 0000000..c7255cb
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,30 @@
+# Finds the cards a user can see whose title, description, or comments contain every term of a query.
+class Search
+  attr_reader :query, :user
+
+  class << self
+    def terms_in(query)
+      query.to_s.split
+    end
+  end
+
+  def initialize(query, user: Current.user)
+    @query, @user = query.to_s.strip, user
+  end
+
+  def terms
+    @terms ||= Search.terms_in(query)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    user.accessible_cards.search(query).preload(:board, :column, :closure, :goldness, :not_now, :rich_text_description)
+  end
+
+  def pattern
+    @pattern ||= Regexp.new(terms.collect { |term| Regexp.escape(term) }.join("|"), Regexp::IGNORECASE)
+  end
+end
