@@ -2,4 +2,10 @@ class ApplicationRecord < ActiveRecord::Base
   primary_abstract_class
 
   configure_replica_connections
+
+  # Condition matching a term appearing anywhere in a column. The escape character is spelled
+  # out because SQLite, unlike MySQL, doesn't assume one for escaped `%` and `_` wildcards.
+  def self.containing_text(column, term)
+    sanitize_sql_array([ "#{column} LIKE ? ESCAPE ?", "%#{sanitize_sql_like(term)}%", "\\" ])
+  end
 end
