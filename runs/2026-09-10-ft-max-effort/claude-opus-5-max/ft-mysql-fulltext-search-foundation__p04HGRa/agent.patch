diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..bfbf3a2
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,30 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  MATCHING_COMMENTS_LIMIT = 3
+
+  included do
+    scope :containing, ->(term) do
+      where(containing_text("cards.title", term))
+        .or(where(id: Card.joins(:rich_text_description).where(containing_text("action_text_rich_texts.body", term)).select(:id)))
+        .or(where(id: Comment.containing(term).select(:card_id)))
+    end
+  end
+
+  class_methods do
+    # Drafts are only visible to their creator, so neither they nor their comments are ever searched.
+    def search(query)
+      terms = Search.terms_in(query)
+
+      if terms.any?
+        terms.reduce(published) { |cards, term| cards.containing(term) }.reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+
+  def comments_matching(search, limit: MATCHING_COMMENTS_LIMIT)
+    comments.containing_any(search.terms).preload(:creator, :rich_text_body).first(limit)
+  end
+end
