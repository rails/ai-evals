+module SearchesHelper
+  EXCERPT_RADIUS = 100
+  EXCERPTED_LENGTH = 1_000
+
+  def search_result_title(card, search)
+    highlight card.title, search.terms
+  end
+
+  def search_result_excerpt(content, search)
+    highlight excerpt_around_matches(content, search), search.terms
+  end
+
+  private
+    def excerpt_around_matches(content, search)
+      text = format_excerpt(content, length: EXCERPTED_LENGTH)
+      excerpt(text, search.pattern, radius: EXCERPT_RADIUS) || text.truncate(EXCERPT_RADIUS)
+    end
+end
