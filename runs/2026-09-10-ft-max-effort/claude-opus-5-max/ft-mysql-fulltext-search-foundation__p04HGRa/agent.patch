+<%= card_article_tag card, class: "card search-result" do %>
+  <header class="card__header">
+    <span class="card__id">
+      <span class="for-screen-reader">Card number</span>
+      <%= card.number %>
+    </span>
+    <span class="card__board-name">
+      <span class="overflow-ellipsis"><%= card.board.name %></span>
+    </span>
+    <span class="card__timestamp flex-item-grow txt-align-end">
+      <%= local_datetime_tag card.created_at, style: :timeordate %>
+    </span>
+  </header>
+
+  <h2 class="search-result__title">
+    <%= link_to search_result_title(card, search), card_path(card), class: "search-result__link", data: { turbo_frame: "_top" } %>
+  </h2>
+
+  <% if card.description.present? %>
+    <p class="search-result__excerpt txt-small"><%= search_result_excerpt(card.description, search) %></p>
+  <% end %>
+
+  <% card.comments_matching(search).each do |comment| %>
+    <p class="search-result__excerpt txt-small">
+      <span class="search-result__commenter"><%= comment.creator.familiar_name %>:</span>
+      <%= search_result_excerpt(comment.body, search) %>
+    </p>
+  <% end %>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..06c1d03
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form", data: { turbo_action: "advance" } do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", autofocus: true,
+          autocorrect: "off", autocomplete: "off", class: "input full-width",
+          aria: { label: "Search cards and comments" }, data: { "1p-ignore": "true" } %>
+  <% end %>
+
+  <% if @search.present? %>
+    <section class="search__results">
+      <% if @page.records.any? %>
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+        <% end %>
+      <% else %>
+        <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+      <% end %>
+    </section>
+  <% end %>
+</div>
