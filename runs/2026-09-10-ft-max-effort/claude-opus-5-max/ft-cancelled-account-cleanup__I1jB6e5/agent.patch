diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..1da65ce 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,40 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_all_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  # Wipes the account and everything it owns off the face of the database. There's
+  # no coming back from this, so it's only ever done for accounts that have been
+  # cancelled for longer than the grace period.
+  def incinerate
+    purge_attachments
+    destroy!
+    delete_leftovers
+  end
+
+  private
+    # Attachments go first: their rows are deleted without callbacks, so the storage
+    # ledger isn't updated for an account that's on its way out, and their blobs are
+    # then purged from both the database and the storage service.
+    def purge_attachments
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
+
+    # Records that don't hang off the account's associations, so they aren't
+    # destroyed along with it.
+    def delete_leftovers
+      Storage::Entry.where(account_id: id).delete_all
+      Search::Record.for(id).where(account_id: id).destroy_all
+    end
 end
