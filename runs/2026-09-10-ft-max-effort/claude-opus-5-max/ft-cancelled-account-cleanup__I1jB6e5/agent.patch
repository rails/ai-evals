diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8fb310d
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates every account cancelled before the grace period" do
+    due = cancel accounts(:"37s"), at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day
+    also_due = cancel accounts(:initech), at: 1.year.ago
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due.id)
+    assert_empty Card.where(account_id: due.id)
+    assert_not Account.exists?(also_due.id)
+    assert_empty Card.where(account_id: also_due.id)
+  end
+
+  test "leaves accounts that are still within the grace period alone" do
+    cancelled_today = cancel accounts(:"37s"), at: Time.current
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(cancelled_today.id)
+    assert_not_empty Card.where(account_id: cancelled_today.id)
+  end
+
+  test "leaves accounts that haven't been cancelled alone" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: account.users.first)
+      account.cancellation.update!(created_at: at)
+      account
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..44853e5
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "due for incineration once the grace period is over" do
+    cancel @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "not due for incineration during the grace period" do
+    cancel @account, at: 1.day.ago
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "not due for incineration when it hasn't been cancelled" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "not due for incineration once it's been reactivated" do
+    cancel @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate deletes the account and everything in it" do
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("x" * 1024), filename: "logo.png", content_type: "image/png"
+    card.reindex
+    Storage::Entry.record(account: @account, delta: 1024, operation: "attach")
+
+    key = card.image.key
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty Board.where(account_id: @account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_empty Comment.where(account_id: @account.id)
+    assert_empty Event.where(account_id: @account.id)
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+    assert_empty ActiveStorage::Attachment.where(account_id: @account.id)
+    assert_empty ActiveStorage::Blob.where(account_id: @account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Search::Record.for(@account.id).where(account_id: @account.id)
+    assert_not ActiveStorage::Blob.service.exist?(key)
+  end
+
+  test "incinerate leaves other accounts alone" do
+    other_account = accounts(:initech)
+
+    @account.incinerate
+
+    assert Account.exists?(other_account.id)
+    assert_not_empty User.where(account_id: other_account.id)
+    assert_not_empty Board.where(account_id: other_account.id)
+  end
+
+  test "incinerate_all_due only incinerates the accounts past the grace period" do
+    cancel @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day
+    cancel accounts(:initech), at: 1.day.ago
+
+    Account.incinerate_all_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: account.users.first)
+      account.cancellation.update!(created_at: at)
+      account
+    end
+end
