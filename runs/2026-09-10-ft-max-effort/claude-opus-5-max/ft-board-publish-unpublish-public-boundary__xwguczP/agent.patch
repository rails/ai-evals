@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "create" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "create as JSON returns the board with its public url" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.public_key), @response.parsed_body["public_url"]
+  end
+
+  test "create keeps the public url of an already published board" do
+    @board.publish
+
+    assert_no_changes -> { @board.reload.public_key } do
+      post board_publication_path(@board)
+    end
+  end
+
+  test "create requires board admin permission" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "destroy" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "destroy as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "destroy requires board admin permission" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "publishing a board is not possible without access to it" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(boards(:private))
+
+    assert_response :not_found
+    assert_not boards(:private).reload.published?
+  end
+end
