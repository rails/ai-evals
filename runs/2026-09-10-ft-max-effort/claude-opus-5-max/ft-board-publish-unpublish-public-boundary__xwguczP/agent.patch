diff --git a/app/controllers/public/boards_controller.rb b/app/controllers/public/boards_controller.rb
new file mode 100644
index 0000000..836829b
--- /dev/null
+++ b/app/controllers/public/boards_controller.rb
@@ -0,0 +1,19 @@
+class Public::BoardsController < ApplicationController
+  include PublicBoardScoped
+
+  CARDS_PER_COLUMN = 15
+
+  def show
+    @columns = @board.columns.sorted
+    @cards_by_column = cards_by_column
+
+    fresh_when etag: [ @board, @columns ]
+  end
+
+  private
+    def cards_by_column
+      @board.cards.triaged.latest.with_golden_first.preloaded.group_by(&:column_id).transform_values do |cards|
+        cards.take(CARDS_PER_COLUMN)
+      end
+    end
+end
