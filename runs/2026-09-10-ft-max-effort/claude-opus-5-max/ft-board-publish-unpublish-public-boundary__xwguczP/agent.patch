diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..8fdf68a
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,26 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def publish
+    update! public_key: generate_public_key unless published?
+  end
+
+  def unpublish
+    update! public_key: nil
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  private
+    def generate_public_key
+      self.class.generate_unique_secure_token length: PUBLIC_KEY_LENGTH
+    end
+end
