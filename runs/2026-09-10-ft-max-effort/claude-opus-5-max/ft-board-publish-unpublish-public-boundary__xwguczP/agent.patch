@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:text)
+  end
+
+  test "show without being signed in" do
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :success
+    assert_select "h1", text: /#{@card.title}/
+  end
+
+  test "show renders the comments on the card" do
+    card = cards(:logo)
+
+    get public_board_card_path(@board.public_key, card)
+
+    assert_response :success
+    assert_select ".comment", count: card.comments.by_user.count
+    assert_select ".comment", text: /#{card.comments.by_user.first.body.to_plain_text}/
+  end
+
+  test "show is not found when the board is not published" do
+    public_key = @board.public_key
+    @board.unpublish
+
+    get public_board_card_path(public_key, @card)
+
+    assert_response :not_found
+  end
+
+  test "show is not found for a drafted card" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:david), status: :drafted)
+
+    get public_board_card_path(@board.public_key, draft)
+
+    assert_response :not_found
+  end
+
+  test "show is not found for a card on another board" do
+    other_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: :published) }
+
+    get public_board_card_path(@board.public_key, other_card)
+
+    assert_response :not_found
+  end
+end
