@@ -0,0 +1,30 @@
+<div class="margin-block-end">
+  <h2 class="divider txt-large">Publish to the web</h2>
+
+  <% if board.published? %>
+    <p class="margin-none-block-start">Anyone with this secret link can see this board and the cards on it — no account needed.</p>
+
+    <% url = public_board_url(board.public_key) %>
+    <div class="flex align-center gap-half margin-block-start">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" aria-label="Public link to this board" readonly>
+
+      <%= button_to_copy_to_clipboard(url) do %>
+        <%= icon_tag "copy-paste" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <%= button_to board_publication_path(board), method: :delete, class: "btn btn--link center txt-small",
+          data: { turbo_confirm: "Are you sure? The link will stop working for everyone who has it." } do %>
+      <%= icon_tag "globe" %>
+      <span>Stop publishing this board</span>
+    <% end %>
+  <% else %>
+    <p class="margin-none-block-start">Publish this board to get a secret link that anyone can use to see it, without signing in.</p>
+
+    <%= button_to board_publication_path(board), class: "btn center margin-block-start" do %>
+      <%= icon_tag "globe" %>
+      <span>Publish this board</span>
+    <% end %>
+  <% end %>
+</div>
