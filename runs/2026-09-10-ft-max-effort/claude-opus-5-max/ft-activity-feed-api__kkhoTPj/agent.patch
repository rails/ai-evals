+require "test_helper"
+
+class User::ActivityTest < ActiveSupport::TestCase
+  test "returns the events from the boards the user can access, newest first" do
+    assert_equal users(:kevin).accessible_events.activity.reverse_chronologically.collect(&:id),
+      users(:kevin).activity.collect(&:id)
+  end
+
+  test "skips events from boards the user can't access" do
+    event = create_private_event
+
+    assert_includes users(:kevin).activity, event
+    assert_not_includes users(:david).activity, event
+  end
+
+  test "skips events that aren't part of the activity" do
+    events(:logo_published).update! action: "card_collection_changed"
+
+    assert_not_includes users(:kevin).activity, events(:logo_published)
+  end
+
+  test "filters by creator" do
+    assert_equal [ users(:david) ], users(:kevin).activity(creator_ids: [ users(:david).id ]).collect(&:creator).uniq
+  end
+
+  test "filters by board" do
+    event = create_private_event
+
+    assert_equal [ event ], users(:kevin).activity(board_ids: [ boards(:private).id ])
+  end
+
+  test "filters out boards the user can't access" do
+    create_private_event
+
+    assert_empty users(:david).activity(board_ids: [ boards(:private).id ])
+  end
+
+  private
+    def create_private_event
+      with_current_user(:kevin) do
+        boards(:private).cards.create!(creator: users(:kevin), title: "Top secret", status: "published").events.sole
+      end
+    end
+end
