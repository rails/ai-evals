@@ -0,0 +1,189 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns the account activity, newest first" do
+    get activities_path
+    assert_response :success
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:logo_assignment_km).id
+    assert_includes ids, events(:layout_commented).id
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index returns every attribute of an event" do
+    activity = activity_for(events(:logo_assignment_km))
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "card_assigned", activity["action"]
+    assert_equal events(:logo_assignment_km).created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+  end
+
+  test "index describes events in plain text" do
+    activity = activity_for(events(:logo_published))
+
+    assert_equal events(:logo_published).description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "David added"
+  end
+
+  test "index links card events to the card" do
+    activity = activity_for(events(:logo_published))
+
+    assert_equal card_url(cards(:logo)), activity["url"]
+  end
+
+  test "index links comment events to the comment on its card" do
+    activity = activity_for(events(:layout_commented))
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+    assert_equal card_url(cards(:layout), anchor: "comment_#{comments(:layout_overflowing_david).id}"), activity["url"]
+  end
+
+  test "index returns assignees for assignment events" do
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_for(events(:logo_assignment_jz))["particulars"])
+
+    events(:logo_assignment_jz).update! action: "card_unassigned"
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_for(events(:logo_assignment_jz))["particulars"])
+  end
+
+  test "index returns boards for board change events" do
+    events(:logo_published).update! action: "card_board_changed",
+      particulars: { particulars: { old_board: "Fizzy", new_board: "Writebook" } }
+
+    assert_equal({ "old_board" => "Fizzy", "new_board" => "Writebook" }, activity_for(events(:logo_published))["particulars"])
+  end
+
+  test "index returns titles for title change events" do
+    events(:logo_published).update! action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity_for(events(:logo_published))["particulars"])
+  end
+
+  test "index returns the column for triage events" do
+    events(:logo_published).update! action: "card_triaged", particulars: { particulars: { column: "In progress" } }
+
+    assert_equal({ "column" => "In progress" }, activity_for(events(:logo_published))["particulars"])
+  end
+
+  test "index returns empty particulars for events without any" do
+    assert_equal({}, activity_for(events(:logo_published))["particulars"])
+    assert_equal({}, activity_for(events(:layout_commented))["particulars"])
+  end
+
+  test "index returns empty strings for missing particulars" do
+    events(:logo_published).update! action: "card_triaged", particulars: {}
+
+    assert_equal({ "column" => "" }, activity_for(events(:logo_published))["particulars"])
+
+    events(:logo_published).update! action: "card_board_changed", particulars: {}
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity_for(events(:logo_published))["particulars"])
+  end
+
+  test "index skips deprecated card collection changed events" do
+    events(:logo_published).update! action: "card_collection_changed",
+      particulars: { particulars: { old_collection: "Fizzy", new_collection: "Writebook" } }
+
+    get activities_path
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "index includes card title changed events" do
+    events(:logo_published).update! action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+
+    get activities_path
+    assert_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "index only returns activity from boards the user can access" do
+    event = create_activity_on_private_board
+
+    get activities_path
+    assert_includes @response.parsed_body.pluck("id"), event.id
+
+    logout_and_sign_in_as :david
+
+    get activities_path
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+  end
+
+  test "index can be filtered by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ])
+    assert_response :success
+
+    assert_equal [ users(:kevin).id ], @response.parsed_body.collect { |activity| activity.dig("creator", "id") }.uniq
+  end
+
+  test "index can be filtered by board" do
+    create_activity_on_private_board
+
+    get activities_path(board_ids: [ boards(:private).id ])
+    assert_response :success
+
+    assert_equal [ boards(:private).id ], @response.parsed_body.collect { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "index ignores boards the user can't access when filtering" do
+    logout_and_sign_in_as :david
+
+    get activities_path(board_ids: [ boards(:private).id ])
+    assert_response :success
+
+    assert_empty @response.parsed_body
+  end
+
+  test "index is paginated" do
+    20.times { create_activity }
+
+    get activities_path
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+
+    next_page = @response.headers["Link"][/<(.*)>/, 1]
+    first_page_ids = @response.parsed_body.pluck("id")
+
+    get next_page
+    assert_response :success
+    assert_empty first_page_ids & @response.parsed_body.pluck("id")
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get activities_path
+    assert_redirected_to new_session_url(script_name: nil)
+  end
+
+  private
+    def activity_for(event)
+      get activities_path
+      assert_response :success
+
+      @response.parsed_body.find { |activity| activity["id"] == event.id }.tap do |activity|
+        assert_not_nil activity, "Expected the #{event.action} event to be part of the activity"
+      end
+    end
+
+    def create_activity(card: cards(:logo), creator: users(:kevin))
+      card.board.events.create! creator: creator, eventable: card, action: "card_published"
+    end
+
+    def create_activity_on_private_board
+      with_current_user(:kevin) do
+        boards(:private).cards.create!(creator: users(:kevin), title: "Top secret", status: "published").events.sole
+      end
+    end
+end
