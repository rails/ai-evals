@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment events detail their assignees" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).details)
+
+    events(:logo_assignment_jz).update! action: "card_unassigned"
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).details)
+  end
+
+  test "board change events detail their boards" do
+    event = events(:logo_published)
+    event.update! action: "card_board_changed", particulars: { particulars: { old_board: "Fizzy", new_board: "Writebook" } }
+
+    assert_equal({ old_board: "Fizzy", new_board: "Writebook" }, event.details)
+  end
+
+  test "title change events detail their titles" do
+    event = events(:logo_published)
+    event.update! action: "card_title_changed", particulars: { particulars: { old_title: "Old", new_title: "New" } }
+
+    assert_equal({ old_title: "Old", new_title: "New" }, event.details)
+  end
+
+  test "triage events detail their column" do
+    event = events(:logo_published)
+    event.update! action: "card_triaged", particulars: { particulars: { column: "In progress" } }
+
+    assert_equal({ column: "In progress" }, event.details)
+  end
+
+  test "missing details are empty strings" do
+    event = events(:logo_published)
+
+    event.update! action: "card_triaged", particulars: {}
+    assert_equal({ column: "" }, event.details)
+
+    event.update! action: "card_board_changed", particulars: {}
+    assert_equal({ old_board: "", new_board: "" }, event.details)
+
+    event.update! action: "card_title_changed", particulars: {}
+    assert_equal({ old_title: "", new_title: "" }, event.details)
+
+    event.update! action: "card_assigned", particulars: {}
+    assert_equal({ assignee_ids: [] }, event.details)
+  end
+
+  test "other events have no details" do
+    assert_equal({}, events(:logo_published).details)
+    assert_equal({}, events(:layout_commented).details)
+    assert_equal({}, events(:buy_domain_sent_back_to_triage).details)
+  end
+end
