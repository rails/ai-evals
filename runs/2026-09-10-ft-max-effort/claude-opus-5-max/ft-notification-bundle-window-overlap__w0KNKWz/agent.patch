@@ -0,0 +1,45 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:jz)
+    @user.settings.update! bundle_email_frequency: :daily
+  end
+
+  test "bundle is sent to the recipient with every notification in the window" do
+    bundle = bundle_with_notifications
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications in 37signals", email.subject
+
+    assert email.html_part.present?
+    assert email.text_part.present?
+
+    assert_match cards(:logo).title, email.body.encoded
+    assert_match cards(:layout).title, email.body.encoded
+    assert_match %r{/cards/#{cards(:logo).number}}, email.html_part.body.encoded
+  end
+
+  test "bundle subject is singular for a single notification" do
+    bundle = bundle_with_notifications(cards: [ cards(:logo) ])
+
+    assert_equal "1 new notification in 37signals", NotificationMailer.bundle(bundle).subject
+  end
+
+  private
+    def bundle_with_notifications(cards: [ cards(:logo), cards(:layout) ])
+      cards.each do |card|
+        event = Event.create!(board: card.board, creator: users(:david), eventable: card, action: "card_published")
+        @user.notifications.create!(source: event, creator: users(:david))
+      end
+
+      perform_enqueued_jobs only: Notification::BundleJob
+      @user.notification_bundles.sole
+    end
+end
