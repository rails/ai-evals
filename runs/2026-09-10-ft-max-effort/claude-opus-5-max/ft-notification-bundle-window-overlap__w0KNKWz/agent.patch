diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..ea08ef2
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,189 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+    @user.settings.update! bundle_email_frequency: :every_few_hours
+  end
+
+  test "the first notification opens a window that runs for the configured period" do
+    travel_to Time.current.change(usec: 0) do
+      notification = create_notification
+
+      bundle = notification.reload.bundle
+      assert_equal @user, bundle.user
+      assert_equal notification.created_at, bundle.starts_at
+      assert_equal notification.created_at + 4.hours, bundle.ends_at
+    end
+  end
+
+  test "notifications landing inside the window join it" do
+    first = create_notification(card: cards(:logo))
+    bundle = first.reload.bundle
+
+    travel 1.hour do
+      second = create_notification(card: cards(:layout))
+      assert_equal bundle, second.reload.bundle
+    end
+
+    assert_equal 1, Notification::Bundle.count
+    assert_equal 2, bundle.notifications.count
+  end
+
+  test "a notification that arrives late joins the window that has already opened" do
+    first = create_notification(card: cards(:logo))
+    bundle = first.reload.bundle
+
+    late = create_notification(card: cards(:layout), created_at: 10.minutes.ago)
+
+    assert_equal bundle, late.reload.bundle
+    assert_equal 1, Notification::Bundle.count
+  end
+
+  test "a new window opens after the previous one was delivered" do
+    first = create_notification(card: cards(:logo))
+    bundle = first.reload.bundle
+    bundle.deliver_now
+
+    travel 5.hours do
+      second = create_notification(card: cards(:layout))
+      assert_not_equal bundle, second.reload.bundle
+      assert_equal 2, Notification::Bundle.count
+    end
+  end
+
+  test "windows never overlap, even for notifications created before the last one closed" do
+    first = create_notification(card: cards(:logo))
+    bundle = first.reload.bundle
+    travel 4.hours
+    bundle.deliver_now
+
+    late = create_notification(card: cards(:layout), created_at: 10.minutes.ago)
+    new_bundle = late.reload.bundle
+
+    assert_not_equal bundle, new_bundle
+    assert new_bundle.starts_at >= bundle.ends_at
+    assert_not_overlapping Notification::Bundle.where(user: @user)
+  end
+
+  test "overlapping windows are invalid" do
+    create_notification
+
+    overlapping = Notification::Bundle.new(user: @user, starts_at: 1.hour.from_now, ends_at: 5.hours.from_now)
+    assert_not overlapping.valid?
+
+    adjacent = Notification::Bundle.new(user: @user, starts_at: @user.notification_bundles.first.ends_at, ends_at: 8.hours.from_now)
+    assert adjacent.valid?
+  end
+
+  test "no bundling when bundle emails are off" do
+    @user.settings.update! bundle_email_frequency: :never
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification = create_notification
+      assert_nil notification.reload.bundle
+    end
+  end
+
+  test "daily and weekly windows" do
+    @user.settings.update! bundle_email_frequency: :daily
+    notification = create_notification(card: cards(:logo))
+    assert_equal 1.day, notification.reload.bundle.ends_at - notification.bundle.starts_at
+
+    @user.notification_bundles.each(&:deliver_now)
+    @user.settings.update! bundle_email_frequency: :weekly
+
+    travel 2.days do
+      notification = create_notification(card: cards(:layout))
+      assert_equal 1.week, notification.reload.bundle.ends_at - notification.bundle.starts_at
+    end
+  end
+
+  test "deliver_now sends one email per window and closes it" do
+    create_notification(card: cards(:logo))
+    bundle = Notification::Bundle.sole
+    create_notification(card: cards(:layout))
+
+    assert_emails 1 do
+      perform_enqueued_jobs { bundle.deliver_now }
+    end
+
+    assert bundle.reload.delivered?
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver_now }
+    end
+  end
+
+  test "a delivery that runs before the window closes leaves it open" do
+    create_notification
+
+    assert_no_emails do
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+    end
+
+    assert Notification::Bundle.sole.open?
+
+    travel 5.hours do
+      assert_emails 1 do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+    end
+  end
+
+  test "deliver_all_due only delivers windows that have closed" do
+    create_notification
+
+    assert_no_emails do
+      perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+    end
+
+    travel 5.hours do
+      assert_emails 1 do
+        perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+      end
+    end
+
+    assert Notification::Bundle.sole.delivered?
+  end
+
+  test "delivery is scheduled for the end of the window" do
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob) do
+      create_notification
+    end
+
+    bundle = Notification::Bundle.sole
+    assert_equal bundle.ends_at.to_i, enqueued_jobs.find { |job| job["job_class"] == "Notification::Bundle::DeliverJob" }["scheduled_at"].to_time.to_i
+  end
+
+  test "cleanup removes long delivered windows" do
+    create_notification
+    bundle = Notification::Bundle.sole
+    bundle.deliver_now
+
+    Notification::Bundle.cleanup(pause: 0)
+    assert Notification::Bundle.exists?(bundle.id)
+
+    bundle.update! delivered_at: 31.days.ago
+    Notification::Bundle.cleanup(pause: 0)
+
+    assert_not Notification::Bundle.exists?(bundle.id)
+    assert_nil Notification.find_by(bundle_id: bundle.id)
+  end
+
+  private
+    def create_notification(card: cards(:logo), created_at: Time.current)
+      event = Event.create!(board: card.board, creator: users(:david), eventable: card, action: "card_published")
+      notification = @user.notifications.create!(source: event, creator: users(:david), created_at: created_at)
+      perform_enqueued_jobs only: Notification::BundleJob
+      notification
+    end
+
+    def assert_not_overlapping(bundles)
+      bundles.order(:starts_at).each_cons(2) do |earlier, later|
+        assert later.starts_at >= earlier.ends_at, "#{later.starts_at} overlaps window ending at #{earlier.ends_at}"
+      end
+    end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
new file mode 100644
index 0000000..382d227
--- /dev/null
+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jz)
+    @user.settings.update! bundle_email_frequency: :daily
+  end
+
+  test "bundle_later enqueues Notification::BundleJob" do
+    notification = create_notification
+
+    assert_enqueued_with(job: Notification::BundleJob, args: [ notification ]) do
+      notification.bundle_later
+    end
+  end
+
+  test "bundle_later is called after notification is created" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      create_notification
+    end
+  end
+
+  test "bundle_later is called when notification source changes" do
+    notification = create_notification
+
+    assert_enqueued_with(job: Notification::BundleJob) do
+      notification.update! source: events(:logo_published)
+    end
+  end
+
+  test "bundle_later is not called for other updates" do
+    notification = create_notification
+
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      notification.update! unread_count: 5
+    end
+  end
+
+  test "bundle_now files the notification in the user's open window" do
+    notification = create_notification
+    notification.bundle_now
+
+    assert_equal notification.reload.bundle, @user.notification_bundles.sole
+  end
+
+  test "a notification whose card gets new activity moves to the current window" do
+    notification = create_notification
+    notification.bundle_now
+    bundle = notification.reload.bundle
+    bundle.deliver_now
+
+    travel 2.days do
+      notification.update! source: events(:logo_published)
+      perform_enqueued_jobs only: Notification::BundleJob
+
+      assert_not_equal bundle, notification.reload.bundle
+      assert_equal 1, notification.bundle.notifications.count
+    end
+  end
+
+  test "not bundleable when bundle emails are off" do
+    @user.settings.update! bundle_email_frequency: :never
+
+    assert_not create_notification.bundleable?
+  end
+
+  test "not bundleable without settings" do
+    user = users(:jason)
+    assert_nil user.settings
+
+    assert_not create_notification(user: user).bundleable?
+  end
+
+  test "not bundleable when created by the system user" do
+    notification = create_notification(creator: users(:system))
+
+    assert_not notification.bundleable?
+  end
+
+  test "not bundleable for cancelled accounts" do
+    notification = create_notification
+    @user.account.cancel initiated_by: @user
+
+    assert_not notification.reload.bundleable?
+  end
+
+  test "not bundleable for deactivated users" do
+    notification = create_notification
+    @user.update! active: false
+
+    assert_not notification.bundleable?
+  end
+
+  private
+    def create_notification(user: @user, creator: users(:david), card: cards(:logo))
+      event = Event.create!(board: card.board, creator: creator, eventable: card, action: "card_published")
+      user.notifications.create!(source: event, creator: creator)
+    end
+end
