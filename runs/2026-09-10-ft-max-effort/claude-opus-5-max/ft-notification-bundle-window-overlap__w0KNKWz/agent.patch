diff --git a/test/integration/notification_bundle_emails_test.rb b/test/integration/notification_bundle_emails_test.rb
new file mode 100644
index 0000000..d2835fc
--- /dev/null
+++ b/test/integration/notification_bundle_emails_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class NotificationBundleEmailsTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @creator = users(:david)
+    @recipient = users(:kevin)
+    @recipient.notifications.destroy_all
+    cards(:logo).assignments.destroy_all
+    @recipient.settings.update! bundle_email_frequency: :every_few_hours
+
+    Current.user = @creator
+  end
+
+  test "everything that lands in one window arrives in a single email" do
+    perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::BundleJob ] do
+      cards(:logo).toggle_assignment(@recipient)
+
+      cards(:layout).watch_by(@recipient)
+      cards(:layout).comments.create!(body: "Take a look at this", creator: @creator)
+    end
+
+    bundle = @recipient.notification_bundles.sole
+    assert_equal 2, bundle.notifications.count
+    assert bundle.open?
+
+    travel 5.hours do
+      assert_emails 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @recipient.identity.email_address ], email.to
+    assert_match cards(:logo).title, email.body.encoded
+    assert_match "Take a look at this", email.body.encoded
+
+    assert bundle.reload.delivered?
+  end
+
+  test "no emails when bundle emails are off" do
+    @recipient.settings.update! bundle_email_frequency: :never
+
+    assert_no_emails do
+      travel 5.hours do
+        perform_enqueued_jobs do
+          cards(:logo).toggle_assignment(@recipient)
+        end
+      end
+    end
+
+    assert_empty @recipient.notification_bundles
+  end
+end
