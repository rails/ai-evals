+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @account = bundle.account
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.chronologically
+
+    Current.with_account(@account) do
+      mail to: @user.identity.email_address, subject: bundle_subject
+    end
+  end
+
+  private
+    def bundle_subject
+      "#{@notifications.size} new #{"notification".pluralize(@notifications.size)} in #{@account.name}"
+    end
+end
