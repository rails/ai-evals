+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "reacting to a comment" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment.card, reaction.card
+  end
+
+  test "content is required" do
+    assert_not @comment.reactions.new(content: "").valid?
+    assert_not @comment.reactions.new(content: nil).valid?
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.new(content: "a" * 16).valid?
+    assert_not @comment.reactions.new(content: "a" * 17).valid?
+  end
+
+  test "reactions are listed chronologically" do
+    first = @comment.reactions.create!(content: "👍", created_at: 2.minutes.ago)
+    second = @comment.reactions.create!(content: "🎉", created_at: 1.minute.ago)
+
+    assert_equal [ first, second ], @comment.reactions.reload.to_a.first(2)
+  end
+
+  test "emoji only reactions are flagged as such" do
+    assert @comment.reactions.new(content: "👍").emoji?
+    assert @comment.reactions.new(content: "🎉🎉").emoji?
+    assert_not @comment.reactions.new(content: "Ship it!").emoji?
+    assert_not @comment.reactions.new(content: "Yes 👍").emoji?
+  end
+
+  test "reacting registers activity on the card" do
+    assert_changes -> { @comment.card.reload.last_active_at } do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "reacting touches the comment so the card gets rerendered" do
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "reacting broadcasts a refresh so everyone looking at the card sees it land" do
+    assert_turbo_stream_broadcasts @comment.card do
+      perform_enqueued_jobs do
+        @comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "removing a reaction broadcasts a refresh too" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_turbo_stream_broadcasts @comment.card do
+      perform_enqueued_jobs do
+        reaction.destroy
+      end
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    @comment.destroy
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroying a user destroys their reactions" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    users(:kevin).destroy
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "by? tells the reacter apart from everyone else" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert reaction.by?(users(:david))
+    assert_not reaction.by?(users(:kevin))
+  end
+end
