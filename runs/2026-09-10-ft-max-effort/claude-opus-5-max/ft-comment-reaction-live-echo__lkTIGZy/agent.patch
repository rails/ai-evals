--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,48 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.chronologically.preloaded
+    fresh_when etag: @reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden unless @reaction.by?(Current.user)
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..71e0802
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,25 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reveals a way to remove the reactions you left yourself. Reactions are
+// rendered the same for everyone, so who left one is resolved on the client.
+export default class extends Controller {
+  connect() {
+    this.mark()
+  }
+
+  mark() {
+    this.element.classList.toggle("reaction--deleteable", this.#mine)
+  }
+
+  toggle() {
+    if (this.#mine) this.element.classList.toggle("expanded")
+  }
+
+  deleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #mine() {
+    return this.element.dataset.creatorId === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..b5cb0ba
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Turns the "react to this" button into a small form for leaving a reaction,
+// and turns it back into a button once the reaction has been left or cancelled.
+export default class extends Controller {
+  static targets = [ "template", "trigger" ]
+
+  open() {
+    if (this.#form) return
+
+    this.triggerTarget.before(this.templateTarget.content.cloneNode(true))
+    this.triggerTarget.hidden = true
+
+    this.#form.classList.add("expanded")
+    this.#input.focus()
+  }
+
+  close() {
+    this.#form?.remove()
+    this.triggerTarget.hidden = false
+  }
+
+  react({ params: { content } }) {
+    this.#input.value = content
+    this.#form.requestSubmit()
+  }
+
+  reacted(event) {
+    if (event.detail.success) this.close()
+  }
+
+  get #form() {
+    return this.element.querySelector(".reaction__form")
+  }
+
+  get #input() {
+    return this.#form?.querySelector(".reaction__input")
+  }
+}
