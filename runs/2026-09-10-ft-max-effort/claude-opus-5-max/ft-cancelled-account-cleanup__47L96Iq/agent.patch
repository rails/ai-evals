diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..ac63f1a
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled longer ago than the grace period" do
+    account = cancel accounts(:"37s"), at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_empty User.where(account_id: account.id)
+    assert_empty Board.where(account_id: account.id)
+    assert_empty Card.where(account_id: account.id)
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    account = cancel accounts(:"37s"), at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "keeps active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "incinerates without an account context, as it runs recurrently" do
+    account = cancel accounts(:"37s"), at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+    blob = attach_image_to cards(:logo)
+    perform_enqueued_jobs # Deliver the cancellation email while the account is still around
+
+    assert_difference -> { Account.count }, -1 do
+      perform_enqueued_jobs do
+        Account::IncinerateDueJob.perform_later
+      end
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: account.users.first)
+      account.cancellation.update!(created_at: at)
+      account
+    end
+
+    def attach_image_to(card)
+      Current.set(account: card.account, user: card.creator) do
+        card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+        card.image.blob
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..aeae8b6
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "due_for_incineration includes accounts cancelled longer ago than the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_includes Account.due_for_incineration, @account
+    assert @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes accounts cancelled within the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes accounts that were never cancelled" do
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "incinerate removes the account and everything in it" do
+    users = @account.users.to_a
+    boards = @account.boards.to_a
+    cards = @account.cards.to_a
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+    assert_empty User.where(id: users)
+    assert_empty Board.where(id: boards)
+    assert_empty Card.where(id: cards)
+  end
+
+  test "incinerate removes attached files and their storage tracking" do
+    card = create_card_with_image
+
+    assert_difference -> { ActiveStorage::Blob.count }, -1 do
+      assert_difference -> { Storage::Entry.count }, -Storage::Entry.where(account: @account).count do
+        @account.incinerate
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Storage::Total.where(owner_type: "Account", owner_id: @account.id)
+    assert_empty ActiveStorage::Attachment.where(record: card)
+  end
+
+  test "incinerate keeps the global identities its users belong to" do
+    identity = identities(:david)
+    other_user = accounts(:initech).users.create!(name: "David", identity: identity, role: :member)
+
+    @account.incinerate
+
+    assert Identity.exists?(identity.id)
+    assert User.exists?(other_user.id)
+    assert_empty identity.users.where(account_id: @account.id)
+  end
+
+  test "incinerate leaves other accounts alone" do
+    other_account = accounts(:initech)
+    users = other_account.users.count
+    boards = other_account.boards.count
+
+    @account.incinerate
+
+    assert Account.exists?(other_account.id)
+    assert_equal users, other_account.users.count
+    assert_equal boards, other_account.boards.count
+  end
+
+  test "incinerate_all_due only incinerates accounts past the grace period" do
+    due = cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+    pending = cancel accounts(:initech), at: 1.day.ago
+    active = accounts(:acme)
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_all_due
+    end
+
+    assert_not Account.exists?(due.id)
+    assert Account.exists?(pending.id)
+    assert Account.exists?(active.id)
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: account.users.first)
+      account.cancellation.update!(created_at: at)
+      account
+    end
+
+    def create_card_with_image
+      Current.set(account: @account, user: @account.users.first) do
+        cards(:logo).tap do |card|
+          card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+          @account.reconcile_storage
+          @account.materialize_storage
+        end
+      end
+    end
+end
