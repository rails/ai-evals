diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..413a499
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,51 @@
+# Keeps an eye on webhooks that keep failing. When a receiver fails
+# MAXIMUM_CONSECUTIVE_FAILURES times in a row within FAILURE_WINDOW, its webhook
+# is switched off and someone has to reactivate it by hand.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAXIMUM_CONSECUTIVE_FAILURES = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def register_success
+    reset if failing?
+  end
+
+  def register_failure
+    with_lock do
+      if within_window?
+        count_failure
+      else
+        restart_window
+      end
+
+      webhook.deactivate if delinquent?
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def failing?
+    consecutive_failures_count.to_i > 0
+  end
+
+  def delinquent?
+    consecutive_failures_count >= MAXIMUM_CONSECUTIVE_FAILURES && within_window?
+  end
+
+  private
+    def within_window?
+      first_failure_at.present? && first_failure_at > FAILURE_WINDOW.ago
+    end
+
+    def count_failure
+      update! consecutive_failures_count: consecutive_failures_count.to_i + 1
+    end
+
+    def restart_window
+      update! consecutive_failures_count: 1, first_failure_at: Time.current
+    end
+end
