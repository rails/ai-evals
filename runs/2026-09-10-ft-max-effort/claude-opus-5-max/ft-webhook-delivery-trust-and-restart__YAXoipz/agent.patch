diff --git a/app/models/webhook/delivery/delivering.rb b/app/models/webhook/delivery/delivering.rb
new file mode 100644
index 0000000..0c32b05
--- /dev/null
+++ b/app/models/webhook/delivery/delivering.rb
@@ -0,0 +1,60 @@
+module Webhook::Delivery::Delivering
+  extend ActiveSupport::Concern
+
+  # Receivers that never answered us, as opposed to ones that answered badly.
+  UNREACHABLE_ERRORS = [
+    EOFError, IOError, SocketError, SystemCallError, Timeout::Error,
+    Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, Net::ProtocolError, OpenSSL::SSL::SSLError
+  ].freeze
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self
+  end
+
+  # Claiming a delivery before posting it is what makes deliveries exactly-once:
+  # only the run that moves it out of "pending" gets to post, so a retried or
+  # duplicated job never notifies the receiver about the same event twice.
+  def deliver_now
+    if webhook.active? && claim
+      post
+    end
+  end
+
+  private
+    def claim
+      claimed = self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload if claimed
+      claimed
+    end
+
+    def post
+      request = Webhook::Delivery::Request.new(self)
+
+      record_request request
+      record_response request.post
+    rescue *UNREACHABLE_ERRORS
+      record_error :destination_unreachable
+    end
+
+    def record_request(request)
+      update! request: { headers: request.headers }
+    end
+
+    def record_response(response)
+      update! state: :completed, response: { code: response.code.to_i, headers: response.each_header.to_h }
+      track_delinquency
+    end
+
+    def record_error(error)
+      update! state: :errored, response: { error: error }
+      track_delinquency
+    end
+
+    def track_delinquency
+      if succeeded?
+        webhook.delinquency_tracker.register_success
+      else
+        webhook.delinquency_tracker.register_failure
+      end
+    end
+end
diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..c46d6f4
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,51 @@
+# The POST Fizzy makes to a webhook receiver. Every request is signed with the
+# webhook's secret so receivers can tell it really came from us.
+class Webhook::Delivery::Request
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5 # seconds
+  READ_TIMEOUT = 10 # seconds
+
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => payload.content_type,
+      "X-Webhook-Timestamp" => timestamp,
+      "X-Webhook-Signature" => signature
+    }
+  end
+
+  def body
+    @body ||= payload.body
+  end
+
+  def post
+    Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+      http.post uri.request_uri, body, headers
+    end
+  end
+
+  private
+    def payload
+      @payload ||= Webhook::Payload.new(webhook, event)
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def timestamp
+      event.created_at.utc.iso8601(3)
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest "SHA256", webhook.signing_secret, body
+    end
+end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..faf2a56
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,81 @@
+# What we post to a webhook receiver: chat receivers get a message they can
+# render right away, everyone else gets the event as JSON.
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  delegate :account, to: :event
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def content_type
+    if for_chat?
+      "text/html"
+    else
+      "application/json"
+    end
+  end
+
+  def body
+    if webhook.for_slack?
+      { text: message }.to_json
+    elsif for_chat?
+      chat_message
+    else
+      event_payload
+    end
+  end
+
+  private
+    def for_chat?
+      webhook.for_campfire? || webhook.for_basecamp?
+    end
+
+    def message
+      [ description, event_url ].compact_blank.join(" ")
+    end
+
+    # Descriptions are written for HTML, so unescape them for plain text chats.
+    def description
+      CGI.unescapeHTML event.description_for(Current.user).to_plain_text
+    end
+
+    def event_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options) if event.eventable
+    end
+
+    def chat_message
+      render :html
+    end
+
+    def event_payload
+      render :json
+    end
+
+    def render(format)
+      renderer.render template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event }
+    end
+
+    def renderer
+      ApplicationController.renderer.new script_name: account.slug, **host_options
+    end
+
+    def host_options
+      if host = url_options[:host].presence
+        { http_host: [ host, url_options[:port] ].compact.join(":"), https: url_options[:protocol].to_s == "https" }
+      else
+        {}
+      end
+    end
+
+    def url_options
+      @url_options ||= default_url_options.merge(script_name: account.slug)
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
