index 0000000..c678e64
--- /dev/null
+++ b/test/models/webhook/delivering_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class Webhook::DeliveringTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_published)
+    @delivery = @webhook.deliveries.create!(event: @event)
+  end
+
+  test "deliver_later enqueues a delivery job" do
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ @delivery ] do
+      @delivery.deliver_later
+    end
+  end
+
+  test "deliver_now posts the event to the receiver" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_requested request
+    assert_predicate @delivery, :completed?
+    assert_predicate @delivery, :succeeded?
+  end
+
+  test "deliver_now posts a signed json payload" do
+    request = stub_request(:post, @webhook.url).with do |request|
+      signature = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body)
+
+      assert_equal "fizzy/1.0.0 Webhook", request.headers["User-Agent"]
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal @event.created_at.utc.iso8601(3), request.headers["X-Webhook-Timestamp"]
+      assert_equal signature, request.headers["X-Webhook-Signature"]
+      assert_equal @event.id, JSON.parse(request.body)["id"]
+      assert_equal @event.action, JSON.parse(request.body)["action"]
+    end.to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_requested request
+  end
+
+  test "deliver_now logs the request and the response" do
+    stub_request(:post, @webhook.url).to_return(status: 201, headers: { "Content-Type" => "application/json" })
+
+    @delivery.deliver_now
+
+    assert_equal "fizzy/1.0.0 Webhook", @delivery.request.dig("headers", "User-Agent")
+    assert_equal 201, @delivery.response[:code]
+    assert_equal 201, @delivery.response_summary[:code]
+    assert_nil @delivery.response_summary[:error]
+    assert_not @delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+  end
+
+  test "deliver_now logs unsuccessful responses" do
+    stub_request(:post, @webhook.url).to_return(status: 422)
+
+    @delivery.deliver_now
+
+    assert_predicate @delivery, :completed?
+    assert_predicate @delivery, :failed?
+    assert_equal 422, @delivery.response[:code]
+  end
+
+  test "deliver_now logs unreachable receivers" do
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    @delivery.deliver_now
+
+    assert_predicate @delivery, :errored?
+    assert_predicate @delivery, :failed?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "deliver_now logs timeouts" do
+    stub_request(:post, @webhook.url).to_timeout
+
+    @delivery.deliver_now
+
+    assert_predicate @delivery, :errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "deliver_now delivers a given event exactly once" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    3.times { @delivery.deliver_now }
+
+    assert_requested request, times: 1
+  end
+
+  test "deliver_now delivers a given event exactly once across concurrent runs" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    [ @delivery, Webhook::Delivery.find(@delivery.id) ].map { |delivery| Thread.new { delivery.deliver_now } }.each(&:join)
+
+    assert_requested request, times: 1
+  end
+
+  test "deliver_now skips deactivated webhooks" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    @webhook.deactivate
+
+    @delivery.deliver_now
+
+    assert_not_requested request
+    assert_predicate @delivery.reload, :pending?
+  end
+
+  test "successful deliveries clear previous failures" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    @webhook.delinquency_tracker.update! consecutive_failures_count: 3, first_failure_at: Time.current
+
+    @delivery.deliver_now
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "failed deliveries are tracked" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    @delivery.deliver_now
+
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    stale = @webhook.deliveries.create!(event: events(:layout_published))
+    stale.update_columns created_at: (Webhook::Delivery::RETENTION_PERIOD + 1.day).ago
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(stale.id)
+    assert Webhook::Delivery.exists?(@delivery.id)
+    assert_empty Webhook::Delivery.expired
+  end
+
+  test "cleanup keeps deliveries from the last week" do
+    @delivery.update_columns created_at: (Webhook::Delivery::RETENTION_PERIOD - 1.hour).ago
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(@delivery.id)
+  end
+end
