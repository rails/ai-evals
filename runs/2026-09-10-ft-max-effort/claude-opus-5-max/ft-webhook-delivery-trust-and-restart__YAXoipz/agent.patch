+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @board = @webhook.board
+  end
+
+  test "events are relayed after they are created" do
+    assert_enqueued_with job: Event::RelayJob do
+      create_event "card_published"
+    end
+  end
+
+  test "relay_now creates a delivery for every subscribed webhook" do
+    event = create_event "card_published"
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        event.relay_now
+      end
+    end
+
+    assert_equal "pending", @webhook.deliveries.find_by(event: event).state
+  end
+
+  test "relay_now ignores unsubscribed actions" do
+    event = create_event "card_postponed"
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now ignores deactivated webhooks" do
+    @webhook.deactivate
+    event = create_event "card_published"
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now ignores webhooks on other boards" do
+    event = create_event "card_published", board: boards(:private)
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now only ever creates one delivery per webhook and event" do
+    event = create_event "card_published"
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      3.times { event.relay_now }
+    end
+  end
+
+  test "events are delivered to their receiver" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      create_event "card_published"
+    end
+
+    assert_requested request, times: 1
+  end
+
+test "relay_now relays to every subscribed webhook on the board" do
+  other = Webhook.create! name: "Another one", url: "https://other.example.com/webhooks", board: @board, subscribed_actions: %w[ card_published ]
+  event = create_event "card_published"
+
+  event.relay_now
+
+  assert @webhook.deliveries.exists?(event: event)
+  assert other.deliveries.exists?(event: event)
+end
+
+  private
+    def create_event(action, board: @board)
+      board.events.create! action: action, creator: users(:david), eventable: cards(:logo)
+    end
+end
