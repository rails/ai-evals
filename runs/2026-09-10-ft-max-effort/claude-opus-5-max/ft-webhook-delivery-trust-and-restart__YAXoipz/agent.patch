@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "webhooks get a tracker when they are created" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "register_failure counts failures" do
+    3.times { @tracker.register_failure }
+
+    assert_equal 3, @tracker.consecutive_failures_count
+    assert @tracker.first_failure_at.present?
+    assert_predicate @webhook.reload, :active?
+  end
+
+  test "ten failures in a row within an hour deactivate the webhook" do
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      Webhook::DelinquencyTracker::MAXIMUM_CONSECUTIVE_FAILURES.times { @tracker.register_failure }
+    end
+
+    assert_predicate @tracker, :delinquent?
+  end
+
+  test "failures spread over more than an hour don't deactivate the webhook" do
+    9.times { @tracker.register_failure }
+    @tracker.update! first_failure_at: (Webhook::DelinquencyTracker::FAILURE_WINDOW + 1.minute).ago
+
+    assert_no_changes -> { @webhook.reload.active? } do
+      @tracker.register_failure
+    end
+
+    assert_equal 1, @tracker.consecutive_failures_count, "a new window starts when the old one expired"
+    assert_not_predicate @tracker, :delinquent?
+  end
+
+  test "register_success resets the failure count" do
+    3.times { @tracker.register_failure }
+
+    @tracker.register_success
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "reactivating a webhook starts from a clean slate" do
+    Webhook::DelinquencyTracker::MAXIMUM_CONSECUTIVE_FAILURES.times { @tracker.register_failure }
+    assert_not_predicate @webhook.reload, :active?
+
+    @webhook.activate
+
+    assert_predicate @webhook, :active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_not_predicate @tracker, :delinquent?
+  end
+end
