diff --git a/test/integration/webhooks_test.rb b/test/integration/webhooks_test.rb
new file mode 100644
index 0000000..d1591ce
--- /dev/null
+++ b/test/integration/webhooks_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class WebhooksTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @board = @webhook.board
+    Current.user = users(:david)
+  end
+
+  test "publishing a card notifies the subscribed receiver and logs the delivery" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    card = nil
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        card = @board.cards.create! title: "Ship webhooks", creator: Current.user, status: :published
+      end
+    end
+
+    assert_requested request, times: 1
+
+    delivery = @webhook.deliveries.ordered.first
+    assert_equal "card_published", delivery.event.action
+    assert_equal card, delivery.event.eventable
+    assert_predicate delivery, :succeeded?
+    assert_equal "fizzy/1.0.0 Webhook", delivery.sanitized_request.dig(:headers, "User-Agent")
+    assert_equal 200, delivery.response_summary[:code]
+  end
+
+  test "receivers are notified once per event" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      card = @board.cards.create! title: "Ship webhooks", creator: Current.user, status: :published
+      card.events.each(&:relay_now)
+    end
+
+    assert_requested request, times: 1
+  end
+
+  test "receivers that keep failing are switched off" do
+    request = stub_request(:post, @webhook.url).to_return(status: 503)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      Webhook::DelinquencyTracker::MAXIMUM_CONSECUTIVE_FAILURES.times do |index|
+        @board.cards.create! title: "Card #{index}", creator: Current.user, status: :published
+      end
+    end
+
+    assert_requested request, times: Webhook::DelinquencyTracker::MAXIMUM_CONSECUTIVE_FAILURES
+    assert_not_predicate @webhook.reload, :active?
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        @board.cards.create! title: "One more", creator: Current.user, status: :published
+      end
+    end
+  end
+
+  test "unsubscribed events don't reach the receiver" do
+    request = stub_request(:post, @webhook.url)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).update! title: "A brand new title"
+    end
+
+    assert_not_requested request
+  end
+end
