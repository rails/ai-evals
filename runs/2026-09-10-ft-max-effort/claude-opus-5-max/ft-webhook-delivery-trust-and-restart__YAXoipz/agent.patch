+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @event = events(:logo_published)
+  end
+
+  test "regular receivers get the event as JSON" do
+    payload = Webhook::Payload.new(webhooks(:active), @event)
+
+    assert_equal "application/json", payload.content_type
+
+    body = JSON.parse(payload.body)
+    assert_equal @event.id, body["id"]
+    assert_equal @event.action, body["action"]
+    assert_equal @event.eventable.title, body.dig("eventable", "title")
+    assert_equal @board.id, body.dig("board", "id")
+    assert_equal @event.creator.id, body.dig("creator", "id")
+  end
+
+  test "Slack receivers get a text message" do
+    webhook = create_webhook "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" # gitleaks:allow
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "application/json", payload.content_type
+    assert_includes JSON.parse(payload.body)["text"], @event.eventable.title
+  end
+
+  test "Campfire receivers get an HTML message" do
+    webhook = create_webhook "https://chat.example.com/rooms/1/2-token/messages"
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "text/html", payload.content_type
+    assert_includes payload.body, ERB::Util.html_escape(@event.eventable.title)
+    assert_includes payload.body, "<a href"
+  end
+
+  test "Basecamp receivers get an HTML message" do
+    webhook = create_webhook "https://3.basecamp.com/999/integrations/token/buckets/111/chats/222/lines"
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "text/html", payload.content_type
+    assert_includes payload.body, ERB::Util.html_escape(@event.eventable.title)
+  end
+
+test "comment events carry the comment" do
+  event = events(:layout_commented)
+  body = JSON.parse(Webhook::Payload.new(webhooks(:active), event).body)
+
+  assert_equal event.id, body["id"]
+  assert_equal "comment_created", body["action"]
+  assert_equal event.eventable.id, body.dig("eventable", "id")
+  assert_equal event.eventable.body.to_plain_text, body.dig("eventable", "body", "plain_text")
+end
+
+  private
+    def create_webhook(url)
+      Webhook.create! name: "Chat", url: url, board: @board, subscribed_actions: %w[ card_published ]
+    end
+end
