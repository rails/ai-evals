@@ -0,0 +1,23 @@
+# Relays events to the webhooks subscribed to them on the event's board.
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later self
+  end
+
+  def relay_now
+    subscribed_webhooks.each do |webhook|
+      webhook.deliver_later self
+    end
+  end
+
+  private
+    def subscribed_webhooks
+      board.webhooks.active.subscribed_to(action)
+    end
+end
