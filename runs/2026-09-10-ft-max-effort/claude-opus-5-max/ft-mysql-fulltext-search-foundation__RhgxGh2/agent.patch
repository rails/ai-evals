diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..0a1271d
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select "input[type=search][name=q]"
+    assert_select ".card", count: 0
+  end
+
+  test "show finds cards by title" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select ".card__title", text: /The logo isn't big enough/
+    assert_select "a[href=?]", card_path(cards(:logo))
+  end
+
+  test "show finds cards by description" do
+    cards(:layout).update! description: "Everything overlaps on haggis screens"
+
+    get search_path(q: "haggis")
+
+    assert_response :success
+    assert_select ".card__title", text: /Layout is broken/
+    assert_select "mark", text: "haggis"
+  end
+
+  test "show finds cards by comment body" do
+    comment = cards(:text).comments.create! body: "This is pure haggis", creator: users(:kevin)
+
+    get search_path(q: "haggis")
+
+    assert_response :success
+    assert_select ".card__title", text: /The text is too small/
+    assert_select "mark", text: "haggis"
+    assert_select "a[href=?]", card_path(cards(:text), anchor: dom_id(comment))
+  end
+
+  test "show as JSON" do
+    get search_path(q: "logo"), as: :json
+
+    assert_response :success
+    assert_equal [ cards(:logo).number ], @response.parsed_body.pluck("number")
+  end
+
+  test "show highlights matched words" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select ".card__title mark", text: "logo"
+  end
+
+  test "show lists newest cards first" do
+    newest = create_card title: "Another logo problem"
+
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_equal [ newest.title, cards(:logo).title ], css_select(".card__title").collect { |title| title.text.strip }
+  end
+
+  test "show skips cards on boards the user can't access" do
+    create_card title: "A secret logo", board: boards(:private)
+
+    logout_and_sign_in_as :david
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select ".card__title", text: /A secret logo/, count: 0
+    assert_select ".card__title", text: /The logo isn't big enough/
+  end
+
+  test "show skips cards on boards the user just lost access to" do
+    card = create_card title: "A secret logo", board: boards(:private)
+
+    get search_path(q: "logo")
+    assert_select ".card__title", text: /A secret logo/
+
+    card.board.accesses.revoke_from users(:kevin)
+
+    get search_path(q: "logo")
+    assert_select ".card__title", text: /A secret logo/, count: 0
+  end
+
+  test "show skips drafted cards and their comments" do
+    draft = create_card title: "A drafted haggis"
+    draft.comments.create! body: "Secret haggis", creator: users(:kevin)
+    draft.update! status: "drafted"
+
+    get search_path(q: "haggis")
+
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "show requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+
+  private
+    def create_card(title:, board: boards(:writebook), creator: users(:kevin))
+      Current.set(account: creator.account, user: creator) do
+        board.cards.create! title: title, status: "published", creator: creator
+      end
+    end
+end
