@@ -0,0 +1,44 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  include ExcerptHelper
+
+  test "highlighting every matched word" do
+    assert_equal "The <mark>logo</mark> is not <mark>big</mark> enough",
+      highlight_search_terms("The logo is not big enough", search_for("logo big"))
+  end
+
+  test "highlighting regardless of case" do
+    assert_equal "The <mark>Logo</mark> is not big enough",
+      highlight_search_terms("The Logo is not big enough", search_for("logo"))
+  end
+
+  test "highlighting escapes markup in the text" do
+    assert_equal "&lt;b&gt;<mark>logo</mark>&lt;/b&gt;",
+      highlight_search_terms("<b>logo</b>", search_for("logo"))
+  end
+
+  test "highlighting without a query" do
+    assert_equal "The logo is not big enough",
+      highlight_search_terms("The logo is not big enough", search_for(""))
+  end
+
+  test "excerpting around the first matched word" do
+    content = ActionText::Content.new("#{"a" * 500} haggis #{"b" * 500}")
+
+    excerpt = highlight_search_excerpt(content, search_for("haggis"))
+
+    assert_match(/\A\.\.\.a+ <mark>haggis<\/mark> b+\.\.\.\z/, excerpt)
+  end
+
+  test "excerpting content without any matched word" do
+    content = ActionText::Content.new("Nothing to see here")
+
+    assert_equal "Nothing to see here", highlight_search_excerpt(content, search_for("haggis"))
+  end
+
+  private
+    def search_for(query)
+      Search.new(query, searcher: users(:david))
+    end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..b84dfac
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finding cards by title" do
+    assert_equal [ cards(:logo) ], Search.new("logo").cards
+  end
+
+  test "finding cards by description" do
+    cards(:layout).update! description: "The sidebar collapses on haggis screens"
+
+    assert_equal [ cards(:layout) ], Search.new("haggis").cards
+  end
+
+  test "finding cards by comment body" do
+    cards(:logo).comments.create! body: "I love haggis", creator: users(:david)
+
+    assert_equal [ cards(:logo) ], Search.new("haggis").cards
+  end
+
+  test "finding cards containing every term" do
+    cards(:logo).comments.create! body: "I love haggis", creator: users(:david)
+    cards(:layout).comments.create! body: "I hate haggis", creator: users(:david)
+
+    assert_equal [ cards(:logo) ], Search.new("haggis love").cards
+  end
+
+  test "matching regardless of case" do
+    assert_equal [ cards(:logo) ], Search.new("LOGO").cards
+  end
+
+  test "sorting newest first" do
+    newest = boards(:writebook).cards.create! title: "Another logo problem", status: "published", creator: users(:david)
+
+    assert_equal [ newest, cards(:logo) ], Search.new("logo").cards
+  end
+
+  test "skipping cards on boards the searcher can't access" do
+    inaccessible = boards(:private).cards.create! title: "A secret logo", status: "published", creator: users(:kevin)
+
+    assert_includes Search.new("logo", searcher: users(:kevin)).cards, inaccessible
+    assert_not_includes Search.new("logo").cards, inaccessible
+  end
+
+  test "skipping cards on boards the searcher just lost access to" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:david)
+
+    assert_empty Search.new("logo").cards
+  end
+
+  test "skipping cards in other accounts" do
+    assert_equal [ cards(:radio) ], Search.new("radio", searcher: users(:mike)).cards
+    assert_empty Search.new("radio").cards
+  end
+
+  test "skipping drafted cards" do
+    draft = boards(:writebook).cards.create! title: "A drafted logo", status: "drafted", creator: users(:david)
+
+    assert_not_includes Search.new("logo").cards, draft
+  end
+
+  test "skipping comments on drafted cards" do
+    card = boards(:writebook).cards.create! title: "Untitled", status: "published", creator: users(:david)
+    card.comments.create! body: "I love haggis", creator: users(:david)
+    card.update! status: "drafted"
+
+    assert_empty Search.new("haggis").cards
+  end
+
+  test "skipping blank queries" do
+    assert_empty Search.new("   ").cards
+    assert_empty Search.new(nil).cards
+  end
+
+  test "escaping like wildcards" do
+    assert_empty Search.new("%").cards
+  end
+
+  test "limiting the number of terms" do
+    assert_equal Search::MAXIMUM_TERMS, Search.new(([ "logo" ] * 20).join(" ")).terms.size
+  end
+
+  test "matching comments on the given cards" do
+    comment = cards(:logo).comments.create! body: "I love haggis", creator: users(:david)
+    cards(:logo).comments.create! body: "Nothing to see here", creator: users(:david)
+
+    search = Search.new("haggis")
+    assert_equal({ cards(:logo).id => comment }, search.comments_on(search.cards))
+  end
+end
