diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..c180d71
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,37 @@
+# Finds published cards by their title, their description, or the body of any of
+# their comments, restricted to the boards the searcher can currently access.
+class Search
+  MAXIMUM_TERMS = 10
+
+  attr_reader :query, :searcher
+
+  def initialize(query, searcher: Current.user)
+    @query, @searcher = query.to_s.strip, searcher
+  end
+
+  def terms
+    @terms ||= query.split.first(MAXIMUM_TERMS)
+  end
+
+  def performed?
+    terms.any?
+  end
+
+  def cards
+    if performed?
+      searcher.accessible_cards.published.containing(terms).reverse_chronologically.preloaded
+    else
+      Card.none
+    end
+  end
+
+  # The most recent matching comment on each of the given cards, keyed by card id.
+  def comments_on(cards)
+    if performed?
+      Comment.where(card: cards).containing(terms).chronologically
+        .with_rich_text_body.includes(:card, :creator).index_by(&:card_id)
+    else
+      {}
+    end
+  end
+end
