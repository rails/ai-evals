diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..6f23fee
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,73 @@
+class Sessions::MagicLinksController < ApplicationController
+  include JoinCodeRedemption, MagicLinkAuthentication
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_magic_link
+
+  layout "public"
+
+  def new
+    redirect_to new_session_path if @magic_link.nil?
+  end
+
+  def create
+    if @magic_link&.authenticate(params[:code])
+      terminate_session if Current.session
+      start_new_session_for @magic_link.identity
+      forget_pending_authentication
+
+      signed_in
+    else
+      incorrect_code
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = pending_magic_link
+    end
+
+    def signed_in
+      respond_to do |format|
+        format.html { redirect_to url_after_signing_in }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def url_after_signing_in
+      if join_code = @magic_link.join_code
+        url_after_redeeming(join_code)
+      else
+        @magic_link.return_to || after_authentication_url
+      end
+    end
+
+    def url_after_redeeming(join_code)
+      if user = redeem_join_code(join_code, @magic_link.identity)
+        url_after_joining(user)
+      else
+        join_url(code: join_code.code, script_name: join_code.account.slug)
+      end
+    end
+
+    def incorrect_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
