@@ -0,0 +1,81 @@
+require "test_helper"
+
+# Walks the three ways in: enter an email address, get a six-character code by email,
+# then enter that code on the next screen.
+class SigningInByEmailCodeTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "signing in" do
+    identity = identities(:david)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      follow_redirect!
+      post form_action, params: { code: emailed_code }
+
+      assert_redirected_to landing_url
+    end
+
+    assert_equal identity, signed_in_identity
+  end
+
+  test "signing up" do
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: "brand.new@example.com" } }
+      end
+
+      follow_redirect!
+      post form_action, params: { code: emailed_code }
+
+      assert_redirected_to new_signup_completion_url
+    end
+
+    assert_equal "brand.new@example.com", signed_in_identity.email_address
+  end
+
+  test "joining with a join code" do
+    join_code = account_join_codes(:"37s")
+    account = accounts("37s")
+
+    assert_emails 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "brand.new@example.com" }
+    end
+
+    follow_redirect!
+    untenanted { post form_action, params: { code: emailed_code } }
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert signed_in_identity.users.exists?(account: account), "Should have joined the account"
+  end
+
+  test "a code goes stale after fifteen minutes" do
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }
+      follow_redirect!
+      code = emailed_code
+
+      travel MagicLink::EXPIRES_IN + 1.minute
+
+      post form_action, params: { code: code }
+    end
+
+    assert_nil signed_in_identity
+  end
+
+  private
+    def form_action
+      css_select("form").first["action"]
+    end
+
+    def emailed_code
+      ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{#{MagicLink::CODE_LENGTH}}/]
+    end
+
+    def signed_in_identity
+      Session.find_signed(parsed_cookies.signed[:session_token])&.identity
+    end
+end
