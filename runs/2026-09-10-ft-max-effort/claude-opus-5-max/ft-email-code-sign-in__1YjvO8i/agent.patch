diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..65cdb2b
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "deliver_to emails a six-character code" do
+    magic_link = nil
+
+    assert_emails 1 do
+      magic_link = MagicLink.deliver_to(@identity.email_address)
+    end
+
+    assert_equal MagicLink::CODE_LENGTH, magic_link.code.length
+    assert_match(/\A[A-Z2-9]+\z/, magic_link.code)
+    assert_equal [ @identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert_includes ActionMailer::Base.deliveries.last.subject, magic_link.code
+  end
+
+  test "deliver_to an unknown email address doesn't email anyone" do
+    assert_no_emails do
+      MagicLink.deliver_to("nobody@example.com")
+    end
+  end
+
+  test "deliver_to normalizes the email address" do
+    assert_emails 1 do
+      MagicLink.deliver_to("  #{@identity.email_address.upcase}  ")
+    end
+
+    assert_equal @identity, MagicLink.deliver_to(@identity.email_address.upcase).identity
+  end
+
+  test "find_by_token returns the pending authentication" do
+    magic_link = MagicLink.deliver_to(@identity.email_address, return_to: "https://example.com/signup/completion/new")
+
+    found = MagicLink.find_by_token(magic_link.token)
+
+    assert_equal @identity, found.identity
+    assert_equal @identity.email_address, found.email_address
+    assert_equal "https://example.com/signup/completion/new", found.return_to
+    assert found.authenticate(magic_link.code)
+  end
+
+  test "find_by_token carries the join code" do
+    join_code = account_join_codes(:"37s")
+    magic_link = MagicLink.deliver_to(@identity.email_address, join_code: join_code)
+
+    assert_equal join_code, MagicLink.find_by_token(magic_link.token).join_code
+  end
+
+  test "find_by_token with a bogus token" do
+    assert_nil MagicLink.find_by_token("not-a-token")
+    assert_nil MagicLink.find_by_token(nil)
+    assert_nil MagicLink.find_by_token("")
+  end
+
+  test "find_by_token after the code has expired" do
+    token = MagicLink.deliver_to(@identity.email_address).token
+
+    travel MagicLink::EXPIRES_IN - 1.minute
+    assert MagicLink.find_by_token(token)
+
+    travel 2.minutes
+    assert_nil MagicLink.find_by_token(token)
+  end
+
+  test "authenticate only accepts the emailed code" do
+    magic_link = MagicLink.deliver_to(@identity.email_address)
+    found = MagicLink.find_by_token(magic_link.token)
+
+    assert found.authenticate(magic_link.code)
+    assert found.authenticate(magic_link.code.downcase)
+    assert found.authenticate(" #{magic_link.code} ")
+
+    assert_not found.authenticate("WRONG1")
+    assert_not found.authenticate("")
+    assert_not found.authenticate(nil)
+  end
+
+  test "authenticate without an identity" do
+    magic_link = MagicLink.deliver_to("nobody@example.com")
+
+    assert_not MagicLink.find_by_token(magic_link.token).authenticate(magic_link.code)
+  end
+
+  test "the token doesn't leak the code" do
+    magic_link = MagicLink.deliver_to(@identity.email_address)
+
+    payload = magic_link.token.split("--").first
+    assert_not_includes Base64.decode64(payload), magic_link.code
+  end
+end
