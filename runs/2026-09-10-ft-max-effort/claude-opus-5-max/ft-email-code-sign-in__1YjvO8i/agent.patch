+++ b/app/controllers/concerns/join_code_redemption.rb
@@ -0,0 +1,20 @@
+# Turns a join code into a user in the account it belongs to.
+module JoinCodeRedemption
+  extend ActiveSupport::Concern
+
+  private
+    def redeem_join_code(join_code, identity)
+      Current.with_account(join_code.account) do
+        join_code.redeem_if { |account| identity.join(account) }
+        User.active.find_by(account: join_code.account, identity: identity)
+      end
+    end
+
+    def url_after_joining(user)
+      if user.setup?
+        landing_url(script_name: user.account.slug)
+      else
+        new_users_verification_url(script_name: user.account.slug)
+      end
+    end
+end
diff --git a/app/controllers/concerns/magic_link_authentication.rb b/app/controllers/concerns/magic_link_authentication.rb
new file mode 100644
index 0000000..4a2ae69
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,24 @@
+# Emails a sign-in code and remembers the pending authentication in a cookie until
+# the person enters that code on the magic link screen.
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def request_magic_link(email_address, **options)
+      magic_link = MagicLink.deliver_to(email_address, **options)
+      cookies[:pending_authentication_token] = { value: magic_link.token, httponly: true, same_site: :lax }
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: magic_link.token }, status: :created }
+      end
+    end
+
+    def pending_magic_link
+      MagicLink.find_by_token(cookies[:pending_authentication_token])
+    end
+
+    def forget_pending_authentication
+      cookies.delete(:pending_authentication_token)
+    end
+end
