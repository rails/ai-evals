+
   setup do
     @account = accounts("37s")
     @join_code = account_join_codes(:"37s")
@@ -78,4 +80,93 @@ class JoinCodesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :too_many_requests
   end
+
+  test "create emails a code and joins the account after it is entered" do
+    assert_difference -> { Identity.count }, 1 do
+      assert_emails 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newbie@example.com" }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_url(script_name: nil)
+
+    untenanted do
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { @account.users.count }, 1 do
+        post session_magic_link_path, params: { code: emailed_code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert parsed_cookies.signed[:session_token]
+
+    identity = Identity.find_by(email_address: "newbie@example.com")
+    assert identity.users.exists?(account: @account), "Should have joined the account"
+    assert_equal 1, @join_code.reload.usage_count
+  end
+
+  test "create emails a code to someone who already has an identity" do
+    identity = identities(:mike)
+
+    assert_no_difference -> { Identity.count } do
+      assert_emails 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+      end
+    end
+
+    untenanted do
+      post session_magic_link_path, params: { code: emailed_code }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert identity.users.exists?(account: @account), "Mike should have joined 37signals"
+  end
+
+  test "create with the wrong code doesn't join the account" do
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newbie@example.com" }
+
+    untenanted do
+      assert_no_difference -> { @account.users.count } do
+        post session_magic_link_path, params: { code: "NOPE42" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with an invalid email address doesn't email a code" do
+    without_action_dispatch_exception_handling do
+      assert_no_emails do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "not-a-valid-email" }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "create when the join code is used up before the code is entered" do
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newbie@example.com" }
+
+    @join_code.update!(usage_count: @join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference -> { @account.users.count } do
+        post session_magic_link_path, params: { code: emailed_code }
+      end
