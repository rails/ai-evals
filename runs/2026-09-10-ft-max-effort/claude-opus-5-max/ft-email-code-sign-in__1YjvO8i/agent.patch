diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..a993f42
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,92 @@
+# A magic link is a pending authentication: a six-character code emailed to someone,
+# plus a signed token that remembers what to do once they enter that code.
+#
+# Nothing is stored server-side. The token carries a bcrypt digest of the code, so it's
+# safe to hand to the browser, and it stops working after MagicLink::EXPIRES_IN.
+class MagicLink
+  CODE_LENGTH = 6
+  CODE_ALPHABET = %w[ A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ] # No look-alikes: I, O, 0, 1
+  EXPIRES_IN = 15.minutes
+  TOKEN_PURPOSE = :pending_authentication
+
+  attr_reader :email_address, :code, :code_digest, :return_to, :join_code
+
+  class << self
+    def deliver_to(email_address, **options)
+      new(email_address: email_address, code: generate_code, **options).tap(&:deliver)
+    end
+
+    def find_by_token(token)
+      if payload = verifier.verified(token.to_s, purpose: TOKEN_PURPOSE)
+        new \
+          email_address: payload["email_address"],
+          code_digest: payload["code_digest"],
+          return_to: payload["return_to"],
+          join_code: Account::JoinCode.find_by(id: payload["join_code_id"])
+      end
+    end
+
+    def verifier
+      Rails.application.message_verifier(TOKEN_PURPOSE)
+    end
+
+    private
+      def generate_code
+        CODE_LENGTH.times.map { CODE_ALPHABET.sample(random: SecureRandom) }.join
+      end
+  end
+
+  def initialize(email_address:, code: nil, code_digest: nil, return_to: nil, join_code: nil)
+    @email_address = email_address.to_s.strip.downcase.presence
+    @code = code
+    @code_digest = code_digest || digest(code)
+    @return_to = return_to
+    @join_code = join_code
+  end
+
+  def identity
+    @identity ||= Identity.find_by(email_address: email_address) if email_address
+  end
+
+  def token
+    self.class.verifier.generate(payload, purpose: TOKEN_PURPOSE, expires_in: EXPIRES_IN)
+  end
+
+  def deliver
+    IdentityMailer.magic_link(identity: identity, code: code).deliver_now if identity
+  end
+
+  def authenticate(code)
+    identity.present? && correct_code?(code)
+  end
+
+  private
+    def payload
+      {
+        "email_address" => email_address,
+        "code_digest" => code_digest,
+        "return_to" => return_to,
+        "join_code_id" => join_code&.id
+      }
+    end
+
+    def correct_code?(submitted_code)
+      if code_digest.present? && (submitted_code = normalize(submitted_code)).present?
+        BCrypt::Password.new(code_digest).is_password?(submitted_code)
+      else
+        false
+      end
+    end
+
+    def digest(code)
+      BCrypt::Password.create(code, cost: cost) if code.present?
+    end
+
+    def cost
+      ActiveModel::SecurePassword.min_cost ? BCrypt::Engine::MIN_COST : BCrypt::Engine.cost
+    end
+
+    def normalize(submitted_code)
+      submitted_code.to_s.upcase.gsub(/[^A-Z0-9]/, "")
+    end
+end
