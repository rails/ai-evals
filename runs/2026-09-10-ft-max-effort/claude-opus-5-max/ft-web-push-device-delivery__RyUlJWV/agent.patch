diff --git a/lib/tasks/push.rake b/lib/tasks/push.rake
new file mode 100644
index 0000000..827bb54
--- /dev/null
+++ b/lib/tasks/push.rake
@@ -0,0 +1,9 @@
+namespace :push do
+  desc "Generate the VAPID key pair that identifies this instance to push services"
+  task vapid_keys: :environment do
+    key = WebPush.generate_key
+
+    puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+    puts "VAPID_PRIVATE_KEY=#{key.private_key}"
+  end
+end
