diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..61af94e
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,25 @@
+# Whatever lands in someone's tray also reaches the devices they turned pushes on for.
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    # Fresh news about a card renews its notification instead of creating another one,
+    # so a new source is as worth pushing as a new record.
+    after_commit :push_later, on: %i[ create update ], if: :source_id_previously_changed?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def push_now
+    if Push.enabled?
+      user.push_subscriptions.each { |subscription| subscription.deliver(push_payload) }
+    end
+  end
+
+  private
+    def push_payload
+      Push::Payload.new(self)
+    end
+end
diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..18f56d1
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,36 @@
+# Push services identify us by the VAPID key pair that ops provisions as VAPID_PUBLIC_KEY and
+# VAPID_PRIVATE_KEY. Without it browsers can't subscribe and we can't deliver, so an instance
+# that has no key pair simply doesn't offer push notifications.
+module Push
+  DEFAULT_SUBJECT = "https://fizzy.do"
+
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def enabled?
+      vapid_credentials.present?
+    end
+
+    def public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_credentials
+      if public_key.present? && private_key.present?
+        { subject: subject, public_key: public_key, private_key: private_key }
+      end
+    end
+
+    private
+      def private_key
+        ENV["VAPID_PRIVATE_KEY"].presence
+      end
+
+      # Push services want a way to reach whoever is pushing.
+      def subject
+        ENV["BASE_URL"].presence || DEFAULT_SUBJECT
+      end
+  end
+end
diff --git a/app/models/push/payload.rb b/app/models/push/payload.rb
new file mode 100644
index 0000000..28b15a8
--- /dev/null
+++ b/app/models/push/payload.rb
@@ -0,0 +1,41 @@
+# What a push says: the same words the tray shows, plus the path of the card it's
+# about so opening the notification opens the card.
+class Push::Payload
+  include Rails.application.routes.url_helpers
+
+  ICON = "/app-icon-192.png"
+
+  attr_reader :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def to_json(*)
+    { title: title, options: { body: body, icon: ICON, tag: tag, data: { path: path } } }.to_json
+  end
+
+  private
+    def title
+      helpers.notification_title(notification)
+    end
+
+    def body
+      helpers.notification_body(notification)
+    end
+
+    # Pushes about the same card replace each other instead of stacking up.
+    def tag
+      notification.card_id
+    end
+
+    # only_path since the routes that resolve cards and comments build full URLs,
+    # and script_name to land in the account the notification belongs to.
+    def path
+      polymorphic_path(notification.notifiable_target, script_name: notification.account.slug, only_path: true)
+    end
+
+    def helpers
+      ApplicationController.helpers
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..e75af97
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,23 @@
+# A device that asked to be pushed to, as handed to us by the browser's push service.
+class Push::Subscription < ApplicationRecord
+  TIMEOUT = 7.seconds
+
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  def deliver(payload)
+    WebPush.payload_send(message: payload.to_json, urgency: "high", **delivery_options)
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    # The push service has forgotten this device, so nothing will ever reach it again.
+    destroy
+  end
+
+  private
+    def delivery_options
+      {
+        endpoint: endpoint, p256dh: p256dh_key, auth: auth_key, vapid: Push.vapid_credentials,
+        ssl_timeout: TIMEOUT, open_timeout: TIMEOUT, read_timeout: TIMEOUT
+      }
+    end
+end
