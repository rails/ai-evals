index 0000000..b7f2d06
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  SUBSCRIPTION = {
+    endpoint: "https://push.example.com/subscriptions/kevins-laptop",
+    p256dh_key: "BM1G4fV50VfnsLAXOMZNPBAFs0i_tskQ0KXqPwBa60Vplpg4KMsbp9UU5E1gzs2ZB7iRzbr5aaK7EDgOcpOx6EM=",
+    auth_key: "auS8ybLqRjK_Anqh6eElJA=="
+  }
+
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "turn on notifications for this device" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: SUBSCRIPTION }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.sole
+    assert_equal SUBSCRIPTION[:endpoint], subscription.endpoint
+    assert_equal SUBSCRIPTION[:p256dh_key], subscription.p256dh_key
+    assert_equal SUBSCRIPTION[:auth_key], subscription.auth_key
+  end
+
+  test "subscribing again with the same endpoint refreshes its keys" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: SUBSCRIPTION }
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: SUBSCRIPTION.merge(auth_key: "iHwKIxoQrIAVJk2tJx3ERg==") }
+    end
+
+    assert_response :created
+    assert_equal "iHwKIxoQrIAVJk2tJx3ERg==", @user.push_subscriptions.sole.auth_key
+  end
+
+  test "subscribing for someone else is forbidden" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: { push_subscription: SUBSCRIPTION }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "subscribing requires signing in" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: SUBSCRIPTION }
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
