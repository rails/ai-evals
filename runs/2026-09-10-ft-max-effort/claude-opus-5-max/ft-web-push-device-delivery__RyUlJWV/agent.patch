diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..ec78494
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "a new notification gets pushed" do
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:kevin))
+    end
+  end
+
+  test "a notification that gets renewed gets pushed again" do
+    assert_enqueued_with job: Notification::PushJob do
+      @notification.update!(source: events(:logo_assignment_david), creator: users(:kevin))
+    end
+  end
+
+  test "reading a notification doesn't push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+    end
+  end
+
+  test "pushing reaches every device the user turned notifications on for" do
+    with_push_enabled do
+      requests = stub_push_requests_for(@user)
+
+      @notification.push_now
+
+      requests.each { |request| assert_requested request }
+    end
+  end
+
+  test "a new notification reaches the push service" do
+    with_push_enabled do
+      requests = stub_push_requests_for(@user)
+
+      perform_enqueued_jobs only: Notification::PushJob do
+        Notification.create!(user: @user, source: events(:layout_commented), creator: users(:kevin))
+      end
+
+      requests.each { |request| assert_requested request }
+    end
+  end
+
+  test "nothing is pushed without a VAPID key pair to identify us with" do
+    request = stub_request(:post, push_subscriptions(:davids_laptop).endpoint)
+
+    @notification.push_now
+
+    assert_not_requested request
+  end
+
+  private
+    def stub_push_requests_for(user)
+      user.push_subscriptions.map { |subscription| stub_request(:post, subscription.endpoint).to_return(status: 201) }
+    end
+end
