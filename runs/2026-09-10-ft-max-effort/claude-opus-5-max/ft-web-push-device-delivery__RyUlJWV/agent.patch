diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..16a3933
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,93 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns push notifications on for the device we're on: the browser hands us the
+// subscription it got from its push service, and we keep it so the server can
+// push to this device. When the browser or the system is blocking notifications
+// we show the instructions for turning them back on instead.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "details" ]
+  static values = { publicKey: String, url: String }
+
+  async connect() {
+    const subscription = await this.#subscription
+
+    if (subscription) await this.#save(subscription)
+
+    this.#display(subscription)
+  }
+
+  async turnOn() {
+    let subscription = null
+
+    if (await this.#permitted) {
+      subscription = await this.#subscribe()
+      await this.#save(subscription)
+    }
+
+    this.#display(subscription)
+  }
+
+  async turnOff() {
+    const subscription = await this.#subscription
+    await subscription?.unsubscribe()
+
+    this.#display(null)
+  }
+
+  #display(subscription) {
+    this.element.classList.toggle(this.onClass, !!subscription)
+    this.detailsTargets.forEach(details => details.hidden = !this.#blocked)
+  }
+
+  get #subscription() {
+    if (this.#granted) {
+      return navigator.serviceWorker.ready.then(registration => registration.pushManager.getSubscription())
+    } else {
+      return Promise.resolve(null)
+    }
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    const stale = await registration.pushManager.getSubscription()
+
+    // A subscription made with another public key can't be reused, so start over.
+    await stale?.unsubscribe()
+
+    return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+  }
+
+  async #save(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    await post(this.urlValue, {
+      body: { push_subscription: { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+  }
+
+  get #permitted() {
+    return this.#supported ? Notification.requestPermission().then(permission => permission === "granted") : false
+  }
+
+  get #granted() {
+    return this.#supported && Notification.permission === "granted"
+  }
+
+  get #blocked() {
+    return !this.#supported || Notification.permission === "denied"
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // Push services want the VAPID public key as bytes, not as the base64 we ship it in.
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
