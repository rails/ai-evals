@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Push::PayloadTest < ActiveSupport::TestCase
+  test "a push says what the tray says" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_equal "The logo isn't big enough", payload_for(notification)["title"]
+    assert_equal "Assigned to Kevin", payload_for(notification).dig("options", "body")
+  end
+
+  test "a push about a mention says who mentioned you" do
+    notification = notifications(:logo_mentioned_david)
+
+    assert_equal "JZ @mentioned you", payload_for(notification)["title"]
+  end
+
+  test "a push opens the card it's about" do
+    notification = notifications(:logo_assignment_kevin)
+    card = notification.card
+
+    assert_equal "#{card.account.slug}/cards/#{card.number}", payload_for(notification).dig("options", "data", "path")
+  end
+
+  test "pushes about the same card replace each other" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_equal notification.card_id, payload_for(notification).dig("options", "tag")
+  end
+
+  private
+    def payload_for(notification)
+      JSON.parse(Push::Payload.new(notification).to_json)
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..1343de8
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:davids_laptop)
+    @payload = Push::Payload.new(notifications(:logo_mentioned_david))
+  end
+
+  test "deliver sends the payload to the push service" do
+    with_push_enabled do
+      request = stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+      @subscription.deliver(@payload)
+
+      assert_requested request
+    end
+  end
+
+  test "deliver drops subscriptions the push service has forgotten" do
+    with_push_enabled do
+      stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver(@payload)
+      end
+    end
+  end
+
+  test "deliver raises when the push service is having trouble" do
+    with_push_enabled do
+      stub_request(:post, @subscription.endpoint).to_return(status: 502)
+
+      assert_raises WebPush::PushServiceError do
+        @subscription.deliver(@payload)
+      end
+    end
+  end
+
+  test "subscriptions require the keys the browser handed us" do
+    assert_not Push::Subscription.new(user: users(:david), endpoint: "https://push.example.com/x").valid?
+  end
+end
