+module PushTestHelper
+  VAPID_PUBLIC_KEY  = "BDDJzsOml5RPa2wM-YeIVQvVRttMFvN_hclHZcRdXCWfsiu5jcxxXxdMs3s4sft316c0pDdac2fcbFRtEru-zQA="
+  VAPID_PRIVATE_KEY = "RMZUUoNnhhleQGMreV3-5t6IvQEZDERew8UCT_AVQPI="
+
+  def with_push_enabled(&block)
+    with_env("VAPID_PUBLIC_KEY" => VAPID_PUBLIC_KEY, "VAPID_PRIVATE_KEY" => VAPID_PRIVATE_KEY, &block)
+  end
+
+  def with_env(variables)
+    originals = variables.keys.index_with { |name| ENV[name] }
+    variables.each { |name, value| ENV[name] = value }
+    yield
+  ensure
+    originals.each { |name, value| ENV[name] = value }
+  end
+end
