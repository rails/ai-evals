+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "reacting to a comment" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("👏")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction.reaction--deleteable", text: "👏"
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger", visible: true
+    end
+
+    assert_equal "👏", @comment.reactions.reload.last.content
+    assert_equal users(:david), @comment.reactions.last.reacter
+  end
+
+  test "reacting to a comment nobody has reacted to yet" do
+    comment = comments(:logo_agreement_kevin)
+
+    visit card_url(@card)
+
+    within "##{dom_id(comment, :reactions)}" do
+      assert_no_selector ".reaction"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").set("🙌")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "🙌"
+      assert_selector ".reactions__trigger", visible: true
+    end
+
+    assert_equal "🙌", comment.reactions.sole.content
+  end
+
+  test "reacting with the keyboard" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").send_keys("Ship it!", :enter)
+
+      assert_selector ".reaction", text: "Ship it!"
+    end
+
+    assert_equal "Ship it!", @comment.reactions.reload.last.content
+  end
+
+  test "changing your mind before reacting" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nope")
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger", visible: true
+    end
+
+    assert_no_difference -> { @comment.reactions.count } do
+      sleep 0.1
+    end
+  end
+
+  test "removing your own reaction" do
+    reaction = Current.set(user: users(:david)) { @comment.reactions.create!(content: "🔥") }
+
+    visit card_url(@card)
+
+    within_reactions do
+      assert_selector "##{dom_id(reaction)}.reaction--deleteable"
+
+      find("##{dom_id(reaction)}").click
+      find("##{dom_id(reaction)} .reaction__delete").click
+
+      assert_no_selector "##{dom_id(reaction)}"
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "reactions left by others can't be removed" do
+    reaction = reactions(:logo_agreement_jz_by_kevin)
+
+    visit card_url(@card)
+
+    within_reactions do
+      assert_selector "##{dom_id(reaction)}"
+      assert_no_selector "##{dom_id(reaction)}.reaction--deleteable"
+
+      find("##{dom_id(reaction)}").click
+      assert_no_selector "##{dom_id(reaction)} .reaction__delete", visible: true
+    end
+  end
+
+  test "reactions land as they happen" do
+    visit card_url(@card)
+    assert_selector "##{dom_id(@comment, :reactions)}"
+    wait_for_cable_subscriptions
+
+    react_elsewhere "🎉"
+
+    within_reactions do
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+
+  private
+    def within_reactions(&)
+      within "##{dom_id(@comment, :reactions)}", &
+    end
+
+    def react_elsewhere(content)
+      Current.set(user: users(:kevin)) { @comment.reactions.create!(content: content) }
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
