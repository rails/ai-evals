index 0000000..c8e3b2c
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+      assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+    end
+
+    assert_response :success
+    assert_equal "👍", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+    assert_match dom_id(@comment.reactions.last), @response.body
+  end
+
+  test "create with content over the limit" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on an inaccessible card" do
+    card, comment = Current.set(user: users(:kevin)) do
+      card = boards(:private).cards.create!(creator: users(:kevin), title: "Secret", status: :published)
+      [ card, card.comments.create!(creator: users(:kevin), body: "Secret") ]
+    end
+
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy your own reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "destroy someone else's reaction" do
+    reaction = reactions(:logo_agreement_jz_by_david)
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal [ "👍", "Agreed!" ], @response.parsed_body.map { |reaction| reaction["content"] }
+    assert_equal users(:kevin).name, @response.parsed_body.first["reacter"]["name"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal Reaction.last.id, @response.parsed_body["id"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "reactions are shown on the card" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)} .reactions__list .reaction", count: 2
+    assert_select "##{dom_id(reactions(:logo_agreement_jz_by_kevin))}", text: /👍/
+    assert_select "##{dom_id(@comment, :reactions)} .reactions__trigger"
+  end
+end
