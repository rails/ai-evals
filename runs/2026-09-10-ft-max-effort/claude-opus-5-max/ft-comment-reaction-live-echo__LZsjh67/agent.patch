diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..34921a3
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Turns the add-a-reaction button into an inline form, and reveals a way to
+// remove your own reactions when you click on them.
+export default class extends Controller {
+  static classes = [ "deleteable", "deleting", "expanded", "reaction" ]
+  static targets = [ "form", "input", "reaction", "trigger" ]
+
+  reactionTargetConnected(reaction) {
+    reaction.classList.toggle(this.deleteableClass, this.#leftByCurrentUser(reaction))
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add(this.reactionClass, this.expandedClass)
+    this.inputTarget.focus()
+  }
+
+  close() {
+    this.formTarget.classList.remove(this.reactionClass, this.expandedClass)
+    this.formTarget.hidden = true
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+  }
+
+  toggleRemoval({ currentTarget }) {
+    if (currentTarget.classList.contains(this.deleteableClass)) {
+      currentTarget.classList.toggle(this.expandedClass)
+    }
+  }
+
+  markAsDeleting({ currentTarget }) {
+    currentTarget.closest(`.${this.reactionClass}`)?.classList.add(this.deletingClass)
+  }
+
+  #leftByCurrentUser(reaction) {
+    return reaction.dataset.creatorId === Current.user?.id
+  }
+}
