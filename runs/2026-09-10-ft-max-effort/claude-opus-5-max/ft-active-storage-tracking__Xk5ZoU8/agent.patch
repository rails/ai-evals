diff --git a/test/models/account/storage_usage_test.rb b/test/models/account/storage_usage_test.rb
new file mode 100644
index 0000000..61cc594
--- /dev/null
+++ b/test/models/account/storage_usage_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::StorageUsageTest < ActiveSupport::TestCase
+  include StorageUsageTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+  end
+
+  test "accounts start out using no storage" do
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counting everything used across the account's boards" do
+    assert_difference -> { @account.bytes_used }, +(2 * moon_size) do
+      attach_image_to cards(:logo)
+      embed_file_in boards(:private), :public_description
+      perform_storage_usage_jobs
+    end
+  end
+
+  test "other accounts are counted separately" do
+    assert_no_difference -> { accounts(:initech).bytes_used } do
+      attach_image_to cards(:logo)
+      perform_storage_usage_jobs
+    end
+  end
+
+  test "destroying a board gives its storage back" do
+    attach_image_to cards(:logo)
+    perform_storage_usage_jobs
+
+    assert_difference -> { @account.bytes_used }, -moon_size do
+      boards(:writebook).destroy
+      perform_storage_usage_jobs
+    end
+  end
+
+  test "recalculating repairs totals that have drifted" do
+    attach_image_to cards(:logo)
+    perform_storage_usage_jobs
+    boards(:writebook).track_storage_usage(-500)
+
+    @account.recalculate_bytes_used
+
+    assert_equal moon_size, @account.bytes_used
+  end
+end
diff --git a/test/models/board/storage_usage_test.rb b/test/models/board/storage_usage_test.rb
