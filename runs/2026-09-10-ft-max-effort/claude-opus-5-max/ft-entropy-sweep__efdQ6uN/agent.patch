diff --git a/test/jobs/card/auto_postpone_due_job_test.rb b/test/jobs/card/auto_postpone_due_job_test.rb
new file mode 100644
index 0000000..c7b33ea
--- /dev/null
+++ b/test/jobs/card/auto_postpone_due_job_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Card::AutoPostponeDueJobTest < ActiveJob::TestCase
+  test "postpones the cards that have exhausted their entropy period" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    cards(:shipping).update!(last_active_at: 1.day.from_now - entropies(:writebook_board).auto_postpone_period)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card::AutoPostponeDueJob.perform_now
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "a sweep that is still running discards the next one" do
+    # limits_concurrency is a Solid Queue feature, so we can only check how it's configured here.
+    assert_equal 1, Card::AutoPostponeDueJob.concurrency_limit
+    assert_equal :discard, Card::AutoPostponeDueJob.concurrency_on_conflict
+    assert Card::AutoPostponeDueJob.new.concurrency_key.present?
+  end
+end
diff --git a/test/models/account/entropic_test.rb b/test/models/account/entropic_test.rb
new file mode 100644
index 0000000..ac1b031
--- /dev/null
+++ b/test/models/account/entropic_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Account::EntropicTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "postpones the cards that have exhausted their entropy period" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    cards(:shipping).update!(last_active_at: 1.day.from_now - entropies(:writebook_board).auto_postpone_period)
+
+    accounts("37s").auto_postpone_due_cards
+
+    assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "leaves the cards of other accounts alone" do
+    cards(:radio).update!(last_active_at: 1.day.ago - entropies(:miltons_wish_list_board).auto_postpone_period)
+
+    accounts("37s").auto_postpone_due_cards
+
+    assert_not cards(:radio).reload.postponed?
+  end
+
+  test "postpones nothing, and needs no system user, when no card is due" do
+    assert_no_difference -> { Card.postponed.count } do
+      accounts(:acme).auto_postpone_due_cards
+    end
+  end
+end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..e5ba2d9 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,41 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "cards are looked up without working out a deadline for every row" do
+    [ Card.due_to_be_postponed, Card.postponing_soon ].each do |scope|
+      assert_no_match(/datetime\(|DATE_SUB/, scope.to_sql, "Entropy deadlines should be worked out upfront, not per row")
+    end
+  end
+
+  test "auto postpone all due honors periods that are not one of the preset options" do
+    entropies(:writebook_board).update_column(:auto_postpone_period, 999.days.to_i)
+
+    cards(:logo).update!(last_active_at: 1000.days.ago)
+    cards(:shipping).update!(last_active_at: 998.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "no cards are due when no entropy is configured at all" do
+    Entropy.delete_all
+
+    assert_empty Card.due_to_be_postponed
+    assert_empty Card.postponing_soon
+  end
+
+  test "auto postpone all due looks the cards up once per account, however many it postpones" do
+    cards(:logo, :layout, :text).each do |card|
+      card.update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    end
+
+    assert_queries_match(/SELECT [`"]cards[`"].[`"]id[`"] FROM [`"]cards[`"]/, count: Account.joins(:entropies).distinct.count) do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo, :layout, :text).all? { |card| card.reload.postponed? }
+  end
 end
