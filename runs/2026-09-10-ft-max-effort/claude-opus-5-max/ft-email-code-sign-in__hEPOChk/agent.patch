diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..c7183d0
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:david)
+  end
+
+  test "codes are six characters long" do
+    code = MagicLink.new(email_address: @identity.email_address).code
+
+    assert_equal 6, code.length
+    assert_match /\A[A-Z2-9]+\z/, code
+  end
+
+  test "delivering a code emails it to the identity" do
+    magic_link = MagicLink.new(email_address: @identity.email_address)
+
+    email = capture_emails { magic_link.deliver }.sole
+
+    assert_equal [ @identity.email_address ], email.to
+    assert_match magic_link.code, email.subject
+  end
+
+  test "delivering a code to an email address we don't know sends nothing" do
+    assert_no_emails do
+      assert MagicLink.deliver_to("nobody@example.com").code.present?
+    end
+  end
+
+  test "authenticating with the code" do
+    magic_link = MagicLink.deliver_to(@identity.email_address)
+
+    assert_equal @identity, MagicLink.find_by_token(magic_link.token).authenticate(magic_link.code)
+  end
+
+  test "authenticating is case and whitespace insensitive" do
+    magic_link = MagicLink.deliver_to(@identity.email_address)
+
+    assert_equal @identity, magic_link.authenticate(" #{magic_link.code.downcase} ")
+  end
+
+  test "authenticating with the wrong code" do
+    magic_link = MagicLink.deliver_to(@identity.email_address)
+
+    assert_nil magic_link.authenticate("NOPE12")
+    assert_nil magic_link.authenticate("")
+    assert_nil magic_link.authenticate(nil)
+  end
+
+  test "authenticating an email address without an identity" do
+    magic_link = MagicLink.deliver_to("nobody@example.com")
+
+    assert_nil magic_link.authenticate(magic_link.code)
+  end
+
+  test "tokens expire" do
+    magic_link = MagicLink.deliver_to(@identity.email_address)
+    token = magic_link.token
+
+    travel MagicLink::EXPIRES_IN - 1.minute do
+      assert_equal @identity, MagicLink.find_by_token(token).authenticate(magic_link.code)
+    end
+
+    travel MagicLink::EXPIRES_IN + 1.minute do
+      assert_nil MagicLink.find_by_token(token)
+    end
+  end
+
+  test "tampered tokens are rejected" do
+    assert_nil MagicLink.find_by_token("not-a-token")
+    assert_nil MagicLink.find_by_token(nil)
+  end
+
+  test "tokens don't carry the code" do
+    magic_link = MagicLink.deliver_to(@identity.email_address)
+
+    assert_no_match /#{magic_link.code}/, Base64.decode64(magic_link.token)
+  end
+end
