+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex justify-center">
+      <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters",
+            spellcheck: false, maxlength: MagicLink::CODE_LENGTH, class: "input", placeholder: "Code", aria: { label: "Sign-in code" },
+            data: { "1p-ignore": true } %>
+    </div>
+
+    <p>We sent a <%= MagicLink::CODE_LENGTH %>-character code to <strong><%= @magic_link.email_address %></strong>. Enter it here, and we’ll get you in. It works for the next <%= distance_of_time_in_words(MagicLink::EXPIRES_IN) %>.</p>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= link_to "Use a different email address", new_session_path, class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
