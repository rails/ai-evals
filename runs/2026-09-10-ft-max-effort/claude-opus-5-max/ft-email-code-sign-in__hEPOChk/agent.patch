diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..5fc2aec
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,71 @@
+# A six-character sign-in code, emailed to someone who wants in.
+#
+# Codes are never stored. When we send one, we hand the browser a signed token — the
+# pending authentication token — carrying the email address we sent it to and a digest
+# of the code. Fifteen minutes later the token stops verifying, and so does the code.
+class MagicLink
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = ("A".."Z").to_a + ("2".."9").to_a - %w[ I O ]
+  EXPIRES_IN = 15.minutes
+  TOKEN_PURPOSE = :pending_authentication
+
+  attr_reader :email_address, :code, :code_digest
+
+  class << self
+    def deliver_to(email_address)
+      new(email_address: email_address).tap(&:deliver)
+    end
+
+    def find_by_token(token)
+      if attributes = verifier.verified(token.to_s)
+        new(**attributes.symbolize_keys)
+      end
+    end
+
+    def verifier
+      Rails.application.message_verifier(TOKEN_PURPOSE)
+    end
+  end
+
+  def initialize(email_address:, code_digest: nil)
+    @email_address = email_address.to_s
+
+    if code_digest.present?
+      @code_digest = code_digest
+    else
+      @code = generate_code
+      @code_digest = digest(@code)
+    end
+  end
+
+  # We only email people we know about, but every request gets a token back, so nobody
+  # can tell from the outside whether an email address has an identity behind it.
+  def deliver
+    IdentityMailer.magic_link(identity: identity, code: code).deliver_later if identity
+  end
+
+  def token
+    self.class.verifier.generate({ email_address: email_address, code_digest: code_digest }, expires_in: EXPIRES_IN)
+  end
+
+  def authenticate(entered_code)
+    identity if matches?(entered_code)
+  end
+
+  def identity
+    @identity ||= Identity.find_by(email_address: email_address)
+  end
+
+  private
+    def generate_code
+      Array.new(CODE_LENGTH) { CODE_CHARACTERS.sample(random: SecureRandom) }.join
+    end
+
+    def matches?(entered_code)
+      entered_code.present? && ActiveSupport::SecurityUtils.secure_compare(digest(entered_code), code_digest)
+    end
+
+    def digest(code)
+      OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code.to_s.strip.upcase)
+    end
+end
