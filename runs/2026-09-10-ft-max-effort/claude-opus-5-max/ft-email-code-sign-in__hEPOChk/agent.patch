+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+  end
+
+  test "magic link is addressed to the identity" do
+    email = IdentityMailer.magic_link(identity: @identity, code: "ABC234")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @identity.email_address ], email.to
+  end
+
+  test "magic link carries the code in the subject so it shows up in a notification" do
+    email = IdentityMailer.magic_link(identity: @identity, code: "ABC234")
+
+    assert_equal "ABC234 is your Fizzy sign-in code", email.subject
+  end
+
+  test "magic link has both HTML and text parts with the code" do
+    email = IdentityMailer.magic_link(identity: @identity, code: "ABC234")
+
+    assert_match "ABC234", email.html_part.body.encoded
+    assert_match "ABC234", email.text_part.body.encoded
+  end
+
+  test "magic link says how long the code lasts" do
+    email = IdentityMailer.magic_link(identity: @identity, code: "ABC234")
+
+    assert_match "15 minutes", email.text_part.body.encoded
+  end
+end
