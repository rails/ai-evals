@@ -0,0 +1,149 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "new" do
+    untenanted do
+      request_code_for @identity.email_address
+
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_in_body @identity.email_address
+    end
+  end
+
+  test "new without a pending authentication" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create" do
+    untenanted do
+      code = request_code_for @identity.email_address
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_url
+    end
+
+    assert_equal @identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "create with a lowercased code" do
+    untenanted do
+      code = request_code_for @identity.email_address
+
+      post session_magic_link_path, params: { code: code.downcase }
+
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "create returns to where the person was headed" do
+    get cards_path
+
+    untenanted do
+      code = request_code_for @identity.email_address
+
+      post session_magic_link_path, params: { code: code }
+    end
+
+    assert_redirected_to cards_url(script_name: accounts("37s").slug)
+  end
+
+  test "create with the wrong code" do
+    untenanted do
+      request_code_for @identity.email_address
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with an expired code" do
+    untenanted do
+      code = request_code_for @identity.email_address
+
+      travel MagicLink::EXPIRES_IN + 1.minute do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to new_session_path
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create without a pending authentication" do
+    untenanted do
+      post session_magic_link_path, params: { code: "ABC234" }
+
+      assert_redirected_to new_session_path
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create for an email address without an identity" do
+    magic_link = MagicLink.new(email_address: "nobody@example.com")
+
+    untenanted do
+      cookies[:pending_authentication_token] = magic_link.token
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create via JSON" do
+    untenanted do
