+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_magic_link
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if identity = @magic_link.authenticate(params[:code])
+      clear_pending_authentication_token
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      incorrect_code
+    end
+  end
+
+  private
+    def set_magic_link
+      unless @magic_link = pending_magic_link
+        expired_code
+      end
+    end
+
+    def expired_code
+      expired_code_message = "That code expired. Enter your email address to get a new one."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: expired_code_message }
+        format.json { render json: { message: expired_code_message }, status: :unauthorized }
+      end
+    end
+
+    def incorrect_code
+      incorrect_code_message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: incorrect_code_message }
+        format.json { render json: { message: incorrect_code_message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
