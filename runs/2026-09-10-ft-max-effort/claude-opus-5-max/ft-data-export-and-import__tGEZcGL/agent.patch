+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.created_account
+
+    mail(
+      to: import.user.identity.email_address,
+      subject: "#{@account.name} was imported into Fizzy"
+    )
+  end
+
+  def failed(import)
+    @import = import
+
+    mail(
+      to: import.user.identity.email_address,
+      subject: "Your Fizzy import couldn't be completed"
+    )
+  end
+end
