@@ -0,0 +1,15 @@
+module DragAndDropHelper
+  # Stands in for the id of the item being dropped. The drag-and-drop controller replaces it
+  # when saving a drop, so drop URLs are generated here instead of assembled in Javascript.
+  DRAGGED_ITEM_ID = "DRAGGED_ITEM_ID"
+
+  def draggable_item_data(id)
+    { drag_and_drop_target: "item", drag_and_drop_item_id: id }
+  end
+
+  # The block gets the placeholder for the item being dropped, so drop URLs can be built with
+  # the regular route helpers: <tt>drop_container_data { |card| card_not_now_path(card) }</tt>.
+  def drop_container_data(method: :post)
+    { drag_and_drop_target: "container", drag_and_drop_url: yield(DRAGGED_ITEM_ID), drag_and_drop_method: method }
+  end
+end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3971447
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,157 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { isMobile } from "helpers/platform_helpers"
+
+const DRAGGED_ITEM_ID = "DRAGGED_ITEM_ID" // Keep in sync with DragAndDropHelper::DRAGGED_ITEM_ID
+
+const ITEM_SELECTOR = "[data-drag-and-drop-target~='item']"
+const CONTAINER_SELECTOR = "[data-drag-and-drop-target~='container']"
+const LIST_SELECTOR = "[data-drag-and-drop-target~='list']"
+
+// Drags items from one container into another. Containers keep their own order, so dropping
+// moves an item between containers, never within one.
+//
+// Containers carry the URL a drop is saved to, with DRAGGED_ITEM_ID standing in for the item
+// that lands on them:
+//
+//   <div data-controller="drag-and-drop"
+//        data-drag-and-drop-dragged-item-class="drag-and-drop__dragged-item"
+//        data-drag-and-drop-hover-container-class="drag-and-drop__hover-container"
+//        data-action="dragstart->drag-and-drop#start dragover->drag-and-drop#over
+//                     dragleave->drag-and-drop#leave drop->drag-and-drop#drop
+//                     dragend->drag-and-drop#end">
+//     <section data-drag-and-drop-target="container"
+//              data-drag-and-drop-url="/cards/DRAGGED_ITEM_ID/triage?column_id=1"
+//              data-drag-and-drop-method="post">
+//       <div data-drag-and-drop-target="list">
+//         <article draggable="true" data-drag-and-drop-target="item" data-drag-and-drop-item-id="7">
+//
+// A drop moves the item in the DOM before it's saved, so letting go leaves everything right
+// where it was dropped. The save runs in the background through `Turbo.fetch`, so the page
+// refresh it broadcasts is ignored here — this page already shows the drop — and the move is
+// only undone when the server turns it down.
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item", "list" ]
+
+  // Dragging needs a pointer, so stay out of the way of touch scrolling
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  #draggedItem = null
+
+  start(event) {
+    const item = this.#itemFrom(event.target)
+
+    if (item) {
+      this.#draggedItem = item
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", this.#idFor(item))
+      this.#dimDraggedItem()
+    }
+  }
+
+  over(event) {
+    const container = this.#dropContainerFrom(event.target)
+
+    if (container) {
+      event.preventDefault() // Accept the drop
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    }
+  }
+
+  leave(event) {
+    const container = this.#dropContainerFrom(event.target)
+
+    if (container && !container.contains(event.relatedTarget)) {
+      container.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  drop(event) {
+    const container = this.#dropContainerFrom(event.target)
+
+    if (container) {
+      event.preventDefault()
+      this.#dropItem(this.#draggedItem, container)
+    }
+
+    this.end()
+  }
+
+  end() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#clearHighlights()
+  }
+
+  // Private
+
+  #itemFrom(element) {
+    return element.closest?.(ITEM_SELECTOR)
+  }
+
+  #dropContainerFrom(element) {
+    const container = element.closest?.(CONTAINER_SELECTOR)
+
+    if (this.#draggedItem && container && !container.contains(this.#draggedItem)) {
+      return container
+    }
+  }
+
+  #dimDraggedItem() {
+    const item = this.#draggedItem
+
+    // Let the browser snapshot the item for the drag image before dimming it
+    requestAnimationFrame(() => {
+      if (item === this.#draggedItem) item.classList.add(this.draggedItemClass)
+    })
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(target => target.classList.toggle(this.hoverContainerClass, target === container))
+  }
+
+  #clearHighlights() {
+    this.containerTargets.forEach(container => container.classList.remove(this.hoverContainerClass))
+  }
+
+  async #dropItem(item, container) {
+    const undoMove = this.#move(item, container)
+
+    if (!await this.#save(item, container)) {
+      undoMove()
+    }
+  }
+
+  #move(item, container) {
+    const originalList = item.parentElement
+    const originalSibling = item.nextElementSibling
+
+    this.#listFor(container).prepend(item)
+
+    return () => originalList.insertBefore(item, originalSibling)
+  }
+
+  #listFor(container) {
+    return container.querySelector(LIST_SELECTOR) ?? container
+  }
+
+  async #save(item, container) {
+    const { dragAndDropUrl, dragAndDropMethod } = container.dataset
+    const url = dragAndDropUrl.replace(DRAGGED_ITEM_ID, this.#idFor(item))
+
+    try {
+      const response = await Turbo.fetch(url, { method: dragAndDropMethod, headers: { Accept: "application/json" } })
+      return response.ok
+    } catch {
+      return false
+    }
+  }
+
+  #idFor(item) {
+    return item.dataset.dragAndDropItemId
+  }
+}
