diff --git a/test/helpers/drag_and_drop_helper_test.rb b/test/helpers/drag_and_drop_helper_test.rb
new file mode 100644
index 0000000..e9c4340
--- /dev/null
+++ b/test/helpers/drag_and_drop_helper_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class DragAndDropHelperTest < ActionView::TestCase
+  test "draggable_item_data names the item being dragged" do
+    assert_equal({ drag_and_drop_target: "item", drag_and_drop_item_id: "1" }, draggable_item_data("1"))
+  end
+
+  test "drop_container_data saves drops to the URL built for the dropped item" do
+    data = drop_container_data { |card| card_not_now_path(card) }
+
+    assert_equal "container", data[:drag_and_drop_target]
+    assert_equal "/cards/DRAGGED_ITEM_ID/not_now", data[:drag_and_drop_url]
+    assert_equal :post, data[:drag_and_drop_method]
+  end
+
+  test "drop_container_data saves drops with the given method" do
+    data = drop_container_data(method: :delete) { |card| card_triage_path(card) }
+
+    assert_equal "/cards/DRAGGED_ITEM_ID/triage", data[:drag_and_drop_url]
+    assert_equal :delete, data[:drag_and_drop_method]
+  end
+end
diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..aa65ad2
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,195 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card into a column triages it there" do
+    visit board_url(@board)
+    expand_column dom_id(@column)
+    drag @card, to: dom_id(@column)
+
+    assert_card_in @card, dom_id(@column)
+    assert_saved { @card.reload.column == @column }
+  end
+
+  test "dragging a card into Not Now postpones it" do
+    visit board_url(@board)
+    expand_column "not-now"
+    drag @card, to: "not-now"
+
+    assert_card_in @card, "not-now"
+    assert_saved { @card.reload.postponed? }
+  end
+
+  test "dragging a card into Done closes it" do
+    visit board_url(@board)
+    expand_column "closed-cards"
+    drag @card, to: "closed-cards"
+
+    assert_card_in @card, "closed-cards"
+    assert_saved { @card.reload.closed? }
+  end
+
+  test "dragging a card into Maybe? sends it back to triage" do
+    card = cards(:text)
+
+    visit board_url(@board)
+    expand_column dom_id(@column)
+    drag card, to: "maybe"
+
+    assert_card_in card, "maybe"
+    assert_saved { card.reload.awaiting_triage? }
+  end
+
+  test "dragging a closed card into a collapsed column reopens it there" do
+    card = cards(:shipping)
+
+    visit board_url(@board)
+    expand_column "closed-cards"
+    drag card, to: dom_id(@column)
+
+    assert_card_in card, dom_id(@column), visible: :all
+    assert_saved { card.reload.column == @column && card.open? }
+  end
+
+  test "dropping a card into the column it came from changes nothing" do
+    visit board_url(@board)
+    drag @card, to: "maybe"
+
+    assert_card_in @card, "maybe"
+    assert_predicate @card.reload, :awaiting_triage?
+  end
+
+  test "a dropped card lands before the move is saved" do
+    visit board_url(@board)
+    expand_column dom_id(@column)
+    drag @card, to: dom_id(@column)
+
+    assert_card_in @card, dom_id(@column), wait: 0
+  end
+
+  test "the column being dragged over lights up while the card dims" do
+    visit board_url(@board)
+    start_dragging @card, over: dom_id(@column)
+
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item"
+
+    stop_dragging @card
+
+    assert_no_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+    assert_no_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item"
+  end
+
+  test "the board stays put once the move is saved" do
+    visit board_url(@board)
+    wait_for_cable_subscriptions
+    expand_column dom_id(@column)
+    track_page_refreshes
+
+    drag @card, to: dom_id(@column)
+    assert_saved { @card.reload.column == @column }
+
+    deliver_broadcasts
+    wait_for_broadcasts
+
+    assert_no_page_refreshes
+    assert_card_in @card, dom_id(@column)
+  end
+
+  test "a drop the server turns down is put back" do
+    visit board_url(@board)
+    expand_column dom_id(@column)
+
+    @card.destroy # The card is gone by the time it's dropped
+
+    drag @card, to: dom_id(@column)
+
+    assert_card_in @card, "maybe"
+    assert_no_card_in @card, dom_id(@column)
+  end
+
+  private
+    def drag(card, to:)
+      find("##{dom_id(card, :article)}").drag_to find("##{to}"), html5: true
+    end
+
+    def start_dragging(card, over:)
+      page.execute_script <<~JS, find("##{dom_id(card, :article)}"), find("##{over}")
+        const [ card, column ] = arguments
+        const dataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+
+    def stop_dragging(card)
+      page.execute_script <<~JS, find("##{dom_id(card, :article)}")
+        arguments[0].dispatchEvent(new DragEvent("dragend", { bubbles: true }))
+      JS
+    end
+
+    def expand_column(id)
+      find("##{id} .cards__expander").click
+      assert_selector "##{id}.is-expanded"
+    end
+
+    def assert_card_in(card, column_id, **options)
+      assert_selector "##{column_id} ##{dom_id(card, :article)}", **options
+    end
+
+    def assert_no_card_in(card, column_id, **options)
+      assert_no_selector "##{column_id} ##{dom_id(card, :article)}", visible: :all, **options
+    end
+
+    # Drops are saved in the background, so the record catches up right after the card lands.
+    def assert_saved(timeout: Capybara.default_max_wait_time)
+      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
+
+      until (saved = yield) || Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+        sleep 0.05
+      end
+
+      assert saved, "Expected the drop to be saved within #{timeout} seconds"
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def track_page_refreshes
+      page.execute_script <<~JS
+        window.broadcasts = 0
+        window.pageRefreshes = 0
+
+        addEventListener("turbo:before-stream-render", () => window.broadcasts++)
+        addEventListener("turbo:visit", () => window.pageRefreshes++)
+      JS
+    end
+
+    def deliver_broadcasts
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    def wait_for_broadcasts
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.1 until page.evaluate_script("window.broadcasts") > 0
+      end
+    end
+
+    def assert_no_page_refreshes
+      assert_equal 0, page.evaluate_script("window.pageRefreshes"),
+        "Expected the board not to refresh after saving the drop"
+    end
+end
