index 0000000..ad2131c
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @other_account = accounts(:initech)
+  end
+
+  test "incinerates the accounts cancelled before the grace period was over" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty Board.where(account_id: @account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_empty Comment.where(account_id: @account.id)
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+  end
+
+  test "keeps the accounts cancelled within the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps the accounts that weren't cancelled" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerates every due account, leaving the rest alone" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+    cancel @other_account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago, by: users(:mike)
+
+    assert_difference -> { Account.count }, -2 do
+      perform_enqueued_jobs do
+        Account::IncinerateDueJob.perform_later
+      end
+    end
+
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "runs in the backend queue" do
+    assert_equal "backend", Account::IncinerateDueJob.new.queue_name
+  end
+
+  private
+    def cancel(account, at:, by: users(:jason))
+      account.cancel(initiated_by: by)
+      account.cancellation.update!(created_at: at)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..135ba04
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @other_account = accounts(:initech)
+  end
+
+  test "due for incineration when cancelled before the grace period was over" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "not due for incineration when cancelled within the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "not due for incineration when it wasn't cancelled" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate deletes the account and every record belonging to it" do
+    add_data_to @account
+    untouched_records = records_belonging_to(@other_account)
+
+    assert_not_empty Search::Record.where(account_id: @account.id)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty records_belonging_to(@account)
+    assert_empty Storage::Total.where(owner: @account)
+    assert_equal untouched_records, records_belonging_to(@other_account)
+  end
+
+  test "incinerate purges the files of the account" do
+    key = add_data_to(@account)
+    assert ActiveStorage::Blob.service.exist?(key)
+
+    @account.incinerate
+
+    assert_not ActiveStorage::Blob.service.exist?(key)
+  end
+
+  test "incinerate works outside of an account context" do
+    add_data_to @account
+    Current.account = nil
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "incinerate_all_due only incinerates the accounts past their grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+    cancel @other_account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago, by: users(:mike)
+
+    Account.incinerate_all_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(@other_account.id)
+  end
+
+  private
+    def cancel(account, at:, by: users(:jason))
+      account.cancel(initiated_by: by)
+      account.cancellation.update!(created_at: at)
+    end
+
+    # Creates a bit of everything — records, search index entries, files and storage
+    # ledger entries — and returns the key of the file attached to the account.
+    def add_data_to(account)
+      user = account.users.admin.first
+
+      Current.set(account: account, user: user) do
+        board = account.boards.create!(name: "Incineration", creator: user)
+        card = board.cards.create!(title: "A card", creator: user, status: :published, description: "<div>Doomed</div>")
+        card.comments.create!(creator: user, body: "A comment")
+        card.image.attach io: StringIO.new("A picture"), filename: "picture.png", content_type: "image/png"
+        account.materialize_storage
+
+        card.image.key
+      end
+    end
+
+    def records_belonging_to(account)
+      account_scoped_models.flat_map do |model|
+        model.where(account_id: account.id).ids.map { |id| [ model.name, id ] }
+      end.to_set
+    end
+
+    def account_scoped_models
+      Rails.application.eager_load!
+
+      ActiveRecord::Base.descendants.reject(&:abstract_class?).uniq(&:table_name).select do |model|
+        model.table_exists? && model.column_names.include?("account_id")
+      end
+    end
+end
