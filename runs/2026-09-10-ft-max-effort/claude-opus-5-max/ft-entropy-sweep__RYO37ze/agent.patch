diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..0a3c94b 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,63 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due handles entropy periods that came in from an import" do
+    entropies(:writebook_board).update_column :auto_postpone_period, 45.days.to_i
+    cards(:logo).update!(last_active_at: 46.days.ago)
+    cards(:shipping).update!(last_active_at: 44.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone all due ignores cards whose board and account have no entropy" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+    cards(:logo).update!(last_active_at: 10.years.ago)
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "entropy deadlines are resolved once instead of once per card" do
+    assert_no_match(/datetime\(|DATE_SUB/, Card.due_to_be_postponed.to_sql)
+    assert_no_match(/datetime\(|DATE_SUB/, Card.postponing_soon.to_sql)
+  end
+
+  test "auto postpone all due later hands the postponing over to batched jobs" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_enqueued_with job: Card::AutoPostponeJob, args: [ [ cards(:logo).id ] ] do
+      Card.auto_postpone_all_due_later
+    end
+
+    assert_not cards(:logo).reload.postponed?
+
+    perform_enqueued_jobs
+
+    assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+  end
+
+  test "auto postpone all due later enqueues one job per batch, not per card" do
+    cards(:logo, :shipping).each { |card| card.update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period) }
+
+    assert_enqueued_jobs 1, only: Card::AutoPostponeJob do
+      Card.auto_postpone_all_due_later
+    end
+  end
+
+  test "batched auto postponing skips cards that became active again in the meantime" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    Card.auto_postpone_all_due_later
+
+    cards(:logo).update!(last_active_at: Time.current)
+    perform_enqueued_jobs
+
+    assert_not cards(:logo).reload.postponed?
+  end
 end
