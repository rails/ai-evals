+class Card::AutoPostponeJob < ApplicationJob
+  queue_as :backend
+
+  # Cards are checked again here: they may well have come back to life between
+  # the sweep that queued them and this job getting around to them.
+  def perform(card_ids)
+    Card.auto_postpone_all_due Card.where(id: card_ids)
+  end
+end
