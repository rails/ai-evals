+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.imported_account
+
+    deliver_to import, subject: "Your Fizzy import is done"
+  end
+
+  def failed(import)
+    @import = import
+
+    deliver_to import, subject: "Your Fizzy import couldn’t be completed"
+  end
+
+  private
+    def deliver_to(import, subject:)
+      if email_address = import.user.identity&.email_address
+        mail to: email_address, subject: subject
+      end
+    end
+end
