diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..2b1b8d8
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "a flurry of comments from several people bursts the card" do
+    assert_changes -> { @card.reload.burst? }, to: true do
+      comment_from :david
+      comment_from :kevin
+      comment_from :jz
+    end
+  end
+
+  test "comments from a single person don't burst the card" do
+    3.times { comment_from :david }
+
+    assert_not @card.reload.burst?
+  end
+
+  test "a couple of comments don't burst the card" do
+    comment_from :david
+    comment_from :kevin
+
+    assert_not @card.reload.burst?
+  end
+
+  test "comments spread beyond a third of the auto-close period don't burst the card" do
+    bursting_window = @card.board.auto_postpone_period / 3
+
+    travel_to (bursting_window + 1.day).seconds.ago do
+      comment_from :david
+      comment_from :kevin
+    end
+
+    comment_from :jz
+
+    assert_not @card.reload.burst?
+  end
+
+  test "system comments don't count towards a burst" do
+    comment_from :david
+    comment_from :kevin
+    @card.comments.create! creator: @card.account.system_user, body: "<strong>Reopened</strong> by David"
+
+    assert_not @card.reload.burst?
+  end
+
+  test "assigning someone bursts the card" do
+    assert_changes -> { @card.reload.burst? }, to: true do
+      @card.toggle_assignment users(:kevin)
+    end
+  end
+
+  test "reopening bursts the card" do
+    @card.close
+
+    assert_changes -> { @card.reload.burst? }, to: true do
+      @card.reopen
+    end
+  end
+
+  test "closing a card doesn't burst it" do
+    assert_no_changes -> { @card.reload.burst? } do
+      @card.close
+    end
+  end
+
+  test "a card that burst and then went quiet is stalled" do
+    @card.record_burst
+
+    assert_not @card.stalled?
+
+    @card.update! last_active_at: (Card::STALL_PERIOD + 1.day).ago
+    assert @card.stalled?
+  end
+
+  test "cards that never burst don't stall" do
+    @card.update! last_active_at: 1.year.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity on a stalled card resets it" do
+    @card.record_burst
+    @card.update! last_active_at: (Card::STALL_PERIOD + 1.day).ago
+    assert @card.stalled?
+
+    comment_from :kevin
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel (Card::STALL_PERIOD + 1.day) do
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "closed and postponed cards don't stall" do
+    @card.record_burst
+    @card.update! last_active_at: (Card::STALL_PERIOD + 1.day).ago
+    assert @card.stalled?
+
+    @card.postpone
+    @card.update! last_active_at: (Card::STALL_PERIOD + 1.day).ago
+    assert_not @card.stalled?
+
+    @card.resume
+    @card.close
+    @card.update! last_active_at: (Card::STALL_PERIOD + 1.day).ago
+    assert_not @card.stalled?
+  end
+
+  test "stalls_at tracks the last activity on bursted cards" do
+    assert_nil @card.stalls_at
+
+    @card.record_burst
+    assert_equal @card.last_active_at + Card::STALL_PERIOD, @card.stalls_at
+  end
+
+  test "stalled scope" do
+    stalled, active = cards(:text), cards(:logo)
+
+    [ stalled, active ].each(&:record_burst)
+    stalled.update! last_active_at: (Card::STALL_PERIOD + 1.day).ago
+
+    assert_includes Card.stalled, stalled
+    assert_not_includes Card.stalled, active
+    assert_includes Card.indexed_by("stalled"), stalled
+    assert_not_includes Card.indexed_by("stalled"), active
+  end
+
+  private
+    def comment_from(user, card: @card)
+      with_current_user(user) do
+        card.comments.create! body: "Yes!"
+      end
+    end
+end
diff --git a/test/system/card_stalling_test.rb b/test/system/card_stalling_test.rb
new file mode 100644
index 0000000..48c87dd
--- /dev/null
+++ b/test/system/card_stalling_test.rb
@@ -0,0 +1,28 @@
+require "application_system_test_case"
+
+class CardStallingTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "a stalled card shows how long it has been quiet" do
+    card = stall(cards(:layout), inactive_for: 20.days)
+
+    visit card_url(card)
+
+    assert_selector ".bubble", text: "20"
+  end
+
+  test "a card that hasn't stalled shows no bubble" do
+    visit card_url(cards(:layout))
+
+    assert_no_selector ".bubble"
+  end
+
+  private
+    def stall(card, inactive_for:)
+      card.record_burst
+      card.update! last_active_at: inactive_for.ago
+      card
+    end
+end
