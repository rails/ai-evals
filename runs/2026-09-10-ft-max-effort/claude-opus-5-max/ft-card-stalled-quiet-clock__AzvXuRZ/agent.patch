diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..1b6188d
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,51 @@
+# Cards get a burst of attention when a flurry of comments lands on them, or when someone
+# is assigned to them or reopens them. Bursts that go quiet for a while are stalled cards:
+# they got everyone excited and then went nowhere. Any activity resets the stall.
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  BURSTING_COMMENTS = 3
+  BURSTING_COMMENTERS = 2
+  BURSTING_EVENTS = %w[ card_assigned card_reopened ]
+  BURSTING_WINDOW_FRACTION = 3 # of the board's auto-postpone period
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def track_burst_from(event)
+    record_burst if bursting_event?(event)
+  end
+
+  def record_burst(at: Time.current)
+    update! burst_at: at
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?
+    stalls_at.present? && stalls_at.past?
+  end
+
+  def stalls_at
+    last_active_at + STALL_PERIOD if burst? && active?
+  end
+
+  private
+    def bursting_event?(event)
+      event.action.in?(BURSTING_EVENTS) || (event.action.comment_created? && flurry_of_comments?)
+    end
+
+    def flurry_of_comments?
+      comments_per_commenter = comments.by_user.where(created_at: bursting_window).group(:creator_id).count
+
+      comments_per_commenter.length >= BURSTING_COMMENTERS && comments_per_commenter.values.sum >= BURSTING_COMMENTS
+    end
+
+    def bursting_window
+      (auto_postpone_period / BURSTING_WINDOW_FRACTION).seconds.ago..
+    end
+end
