diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..b2ffc76
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,46 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLICATION_KEY_LENGTH = 32
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  class_methods do
+    def find_published_by_key!(key)
+      published.find_by!(publication_key: key)
+    end
+  end
+
+  def publish
+    update! publication_key: new_publication_key unless published?
+  end
+
+  def unpublish
+    update! publication_key: nil if published?
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  def public_url(**options)
+    Rails.application.routes.url_helpers.public_board_url(publication_key, **url_options, **options) if published?
+  end
+
+  private
+    def new_publication_key
+      self.class.generate_unique_secure_token length: PUBLICATION_KEY_LENGTH
+    end
+
+    def url_options
+      default_url_options.merge(script_name: account.slug)
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
