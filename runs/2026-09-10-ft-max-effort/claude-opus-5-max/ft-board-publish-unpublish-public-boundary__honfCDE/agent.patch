+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show a card of a published board without being signed in" do
+    get public_board_card_path(@board.publication_key, @card)
+
+    assert_response :success
+    assert_select "h1", /#{@card.title}/
+  end
+
+  test "show a card without the account prefix" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card)
+    end
+
+    assert_response :success
+  end
+
+  test "show a card of a board that is not published" do
+    key = @board.publication_key
+    @board.unpublish
+
+    get public_board_card_path(key, @card)
+    assert_response :not_found
+  end
+
+  test "show a drafted card" do
+    @card.drafted!
+
+    get public_board_card_path(@board.publication_key, @card)
+    assert_response :not_found
+  end
+
+  test "show a card from another board" do
+    other_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Kept private", status: :published)
+    end
+
+    get public_board_card_path(@board.publication_key, other_card)
+    assert_response :not_found
+  end
+end
