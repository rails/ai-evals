diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..cb55592
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,23 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.json { render "boards/show", status: :created, location: board_url(@board, format: :json) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.json { head :no_content }
+    end
+  end
+end
diff --git a/app/controllers/public/base_controller.rb b/app/controllers/public/base_controller.rb
new file mode 100644
index 0000000..6958270
--- /dev/null
+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,24 @@
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  before_action :set_board, :set_current_account
+
+  private
+    def set_board
+      @board = Board.find_published_by_key!(publication_key)
+    end
+
+    def publication_key
+      params[:key] || params[:board_key]
+    end
+
+    # Public boards can be reached without the account prefix, but everything they link
+    # to (avatars, attachments…) is tenanted, so keep generating account scoped URLs.
+    def set_current_account
+      Current.account = @board.account
+      request.script_name = @board.account.slug
+    end
+end
