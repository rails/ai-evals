@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "create" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "create as JSON" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.publication_key), response.parsed_body["public_url"]
+  end
+
+  test "create keeps the existing public url" do
+    @board.publish
+
+    assert_no_changes -> { @board.reload.publication_key } do
+      post board_publication_path(@board)
+    end
+  end
+
+  test "destroy" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "destroy as JSON" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "non-admins cannot publish a board" do
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "non-admins cannot unpublish a board" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      delete board_publication_path(@board)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "boards outside of reach cannot be published" do
+    assert_no_changes -> { boards(:miltons_wish_list).reload.published? } do
+      post board_publication_path(boards(:miltons_wish_list))
+    end
+
+    assert_response :not_found
+  end
+end
