+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show a published board without being signed in" do
+    get public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_select "h1", /Writebook/
+  end
+
+  test "show a published board without the account prefix" do
+    untenanted do
+      get public_board_path(@board.publication_key)
+    end
+
+    assert_response :success
+  end
+
+  test "show links to the columns of the board" do
+    get public_board_path(@board.publication_key)
+
+    assert_response :success
+    @board.columns.each do |column|
+      assert_select "a[href=?]", public_board_column_path(@board.publication_key, column)
+    end
+  end
+
+  test "show renders the cards of each column" do
+    get public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@board.publication_key, cards(:logo))
+    assert_select "h3", /#{cards(:logo).title}/
+  end
+
+  test "show hides drafted cards" do
+    card = cards(:logo)
+    card.drafted!
+
+    get public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@board.publication_key, card), count: 0
+  end
+
+  test "show a board that is no longer published" do
+    key = @board.publication_key
+    @board.unpublish
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+
+  test "show with an unknown key" do
+    get public_board_path("nonexistent")
+    assert_response :not_found
+  end
+
+  test "show a published board the signed in user has no access to" do
+    board = boards(:private)
+    board.publish
+    sign_in_as :david
+
+    assert_not board.accessible_to?(users(:david))
+
+    get public_board_path(board.publication_key)
+    assert_response :success
+  end
+
+  test "show a published board while signed into another account" do
+    sign_in_as :mike
+
+    get public_board_path(@board.publication_key)
+    assert_response :success
+  end
+
+  test "show doesn't allow search engines to index the board" do
+    get public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..e15c640
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "publishing generates a publication key" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      @board.publish
+    end
+
+    assert @board.publication_key.present?
+    assert_includes Board.published, @board
+  end
+
+  test "publishing twice keeps the same key" do
+    @board.publish
+    key = @board.publication_key
+
+    @board.publish
+    assert_equal key, @board.reload.publication_key
+  end
+
+  test "unpublishing removes the publication key" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      @board.unpublish
+    end
+
+    assert_nil @board.publication_key
+    assert_not_includes Board.published, @board
+  end
+
+  test "publishing again generates a new key" do
+    @board.publish
+    key = @board.publication_key
+
+    @board.unpublish
+    @board.publish
+
+    assert_not_equal key, @board.publication_key
+  end
+
+  test "finding a published board by key" do
+    @board.publish
+
+    assert_equal @board, Board.find_published_by_key!(@board.publication_key)
+
+    @board.unpublish
+    assert_raises(ActiveRecord::RecordNotFound) { Board.find_published_by_key!(@board.publication_key) }
+    assert_raises(ActiveRecord::RecordNotFound) { Board.find_published_by_key!(nil) }
+  end
+
+  test "public url is scoped to the account" do
+    @board.publish
+
+    assert_includes @board.public_url, "#{@board.account.slug}/public/boards/#{@board.publication_key}"
+  end
+
+  test "cards are publicly accessible only when the board is published" do
+    assert_not cards(:logo).publicly_accessible?
+
+    @board.publish
+    assert cards(:logo).reload.publicly_accessible?
+  end
+end
