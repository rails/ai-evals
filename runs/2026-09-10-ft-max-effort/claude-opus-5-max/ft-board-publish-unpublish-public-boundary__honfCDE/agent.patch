index 0000000..ded58e5
--- /dev/null
+++ b/app/controllers/public/boards_controller.rb
@@ -0,0 +1,15 @@
+class Public::BoardsController < Public::BaseController
+  CARDS_PER_COLUMN = 10
+
+  def show
+    @columns = @board.columns.sorted
+    @cards_by_column = @columns.index_with { |column| cards_in(column) }
+
+    fresh_when etag: [ @board, @columns, @cards_by_column.values ]
+  end
+
+  private
+    def cards_in(column)
+      column.cards.active.latest.with_golden_first.preloaded.limit(CARDS_PER_COLUMN)
+    end
+end
