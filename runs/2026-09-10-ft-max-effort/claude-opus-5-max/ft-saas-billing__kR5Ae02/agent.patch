+      <li>Comped: <strong><%= @account.comped? ? "Yes" : "No" %></strong></li>
+      <% if subscription = @account.subscription %>
+        <li>Status: <strong><%= subscription.status %></strong></li>
+        <li>Stripe customer: <strong><%= subscription.stripe_customer_id %></strong></li>
+        <li>Stripe subscription: <strong><%= subscription.stripe_subscription_id %></strong></li>
+        <% if subscription.current_period_end %>
+          <li>Renews: <strong><%= l subscription.current_period_end.to_date %></strong></li>
+        <% end %>
+      <% end %>
+    </ul>
+
+    <div class="flex gap-half margin-block-half">
+      <%= button_to saas.admin_account_comp_path(@account), method: :post, class: "btn" do %>
