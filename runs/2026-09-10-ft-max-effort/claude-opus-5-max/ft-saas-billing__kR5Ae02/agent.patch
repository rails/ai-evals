+class Admin::Accounts::OverriddenLimitsController < AdminController
+  include Admin::AccountScoped
+
+  before_action :set_account
+
+  def create
+    @account.override_limits(**overridden_limit_params)
+    redirect_to saas.admin_account_path(@account), notice: "Overrode limits for #{@account.name}"
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Reset limits for #{@account.name}"
+  end
+
+  private
+    def overridden_limit_params
+      attributes = params.fetch(:overridden_limit, params).permit(:card_count, :bytes_used)
