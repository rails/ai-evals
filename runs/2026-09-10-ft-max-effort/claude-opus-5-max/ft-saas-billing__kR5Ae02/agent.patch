+    <%= form_with url: saas.admin_account_overridden_limit_path(@account), scope: :overridden_limit, method: :post, class: "flex flex-column gap-half margin-block-half" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count", class: "txt-small" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used", class: "txt-small" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+      </div>
+
+      <div class="flex gap-half">
+        <%= form.button class: "btn" do %>
+          <span>Override</span>
+        <% end %>
+      </div>
+    <% end %>
+
+    <%= button_to saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn" do %>
+      <span>Reset</span>
+    <% end %>
+  </div>
+</section>
