@@ -0,0 +1,61 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan includes 1,000 cards and 1 GB" do
+    assert_equal 1_000, Plan::FREE.card_limit
+    assert_equal 1.gigabyte, Plan::FREE.storage_limit
+    assert Plan::FREE.free?
+  end
+
+  test "paid plans are unlimited on cards and bring their own storage" do
+    assert_equal 20_00, Plan::UNLIMITED.price_in_cents
+    assert_equal 5.gigabytes, Plan::UNLIMITED.storage_limit
+    assert Plan::UNLIMITED.unlimited_cards?
+
+    assert_equal 25_00, Plan::UNLIMITED_PLUS.price_in_cents
+    assert_equal 500.gigabytes, Plan::UNLIMITED_PLUS.storage_limit
+    assert Plan::UNLIMITED_PLUS.unlimited_cards?
+  end
+
+  test "finding by key" do
+    assert_equal Plan::UNLIMITED, Plan.find("monthly_v1")
+    assert_equal Plan::UNLIMITED, Plan.find("MonthlyV1")
+    assert_equal Plan::UNLIMITED_PLUS, Plan.find("Unlimited+")
+    assert_nil Plan.find("nonesuch")
+    assert_nil Plan.find(nil)
+  end
+
+  test "finding by stripe price id" do
+    with_env "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited" do
+      assert_equal Plan::UNLIMITED, Plan.find_by_stripe_price_id("price_unlimited")
+    end
+
+    assert_nil Plan.find_by_stripe_price_id("price_unknown")
+  end
+
+  test "finding by price when price ids aren't configured" do
+    assert_equal Plan::UNLIMITED_PLUS, Plan.find_by_price_in_cents(25_00)
+    assert_nil Plan.find_by_price_in_cents(0)
+  end
+
+  test "plans identify themselves to queenbee by short name" do
+    assert_equal "FreeV1", Plan::FREE.to_s
+    assert_equal Plan::FREE, "FreeV1"
+    assert_equal "MonthlyExtraStorageV1", Plan::UNLIMITED_PLUS.to_s
+  end
+
+  test "upgrades are the more expensive plans" do
+    assert_equal [ Plan::UNLIMITED, Plan::UNLIMITED_PLUS ], Plan::FREE.upgrades
+    assert_equal [ Plan::UNLIMITED_PLUS ], Plan::UNLIMITED.upgrades
+    assert_empty Plan::UNLIMITED_PLUS.upgrades
+  end
+
+  private
+    def with_env(variables)
+      original = variables.transform_values { |_| nil }.merge(ENV.slice(*variables.keys))
+      ENV.update(variables)
+      yield
+    ensure
+      original.each { |name, value| value.nil? ? ENV.delete(name) : ENV[name] = value }
+    end
+end
