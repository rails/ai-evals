diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..c724409
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,27 @@
+# Stripe is the source of truth for billing, and this is how it tells us what
+# it decided: every subscription change arrives here.
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    Account::Subscription.record_stripe_event event
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def event
+      if signing_secret.present?
+        Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], signing_secret)
+      else
+        Stripe::Event.construct_from(JSON.parse(request.raw_post, symbolize_names: true))
+      end
+    end
+
+    def signing_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+end
