+<% @page_title = "Plans" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Your plan</h2>
+        <div>This account is on the <strong><%= @account.plan.name %></strong> plan: <%= plan_allowances(@account.plan) %>.</div>
+      </header>
+
+      <%= render "account/settings/saas/usage", account: @account %>
+    </section>
+
+    <% @plans.each do |plan| %>
+      <section class="settings__section">
+        <header>
+          <h2 class="divider"><%= plan.name %></h2>
+          <div><strong><%= plan_price(plan) %></strong> — <%= plan_allowances(plan) %>.</div>
+        </header>
+
+        <% if plan == @account.plan %>
+          <p class="txt-small">Your current plan.</p>
+        <% elsif plan.paid? && Current.user.admin? %>
+          <%= button_to account_billing_checkouts_path, params: { plan: plan.key }, class: "btn", form: { data: { turbo: false } } do %>
+            <span>Upgrade</span>
+          <% end %>
+        <% elsif plan.paid? %>
+          <p class="txt-small">Ask an account admin to upgrade.</p>
+        <% end %>
+      </section>
+    <% end %>
+  </div>
+</div>
