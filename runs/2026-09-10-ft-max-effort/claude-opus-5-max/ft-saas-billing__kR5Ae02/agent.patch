--- /dev/null
+++ b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "overriding an account's usage" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account),
+        params: { overridden_limit: { card_count: 950, bytes_used: 2.gigabytes } }
+
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+
+    assert_equal 950, @account.reload.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+  end
+
+  test "resetting the override" do
+    @account.override_limits card_count: 950, bytes_used: 2.gigabytes
+    sign_in_as :david
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(@account)
+
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+
+    assert_nil @account.reload.overridden_limit
+    assert_equal 0, @account.card_count
+  end
+
+  test "non-staff cannot override usage" do
+    sign_in_as :jz
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 950 } }
+    end
+
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limit
+  end
+end
