@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::Billing::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admins are handed over to stripe's checkout" do
+    sign_in_as :mike
+
+    Stripe::Checkout::Session.expects(:create).with { |options| options[:mode] == "subscription" }
+      .returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.test/c/pay/1"))
+
+    post account_billing_checkouts_path(script_name: @account.slug), params: { plan: Plan::UNLIMITED.key }
+
+    assert_redirected_to "https://checkout.stripe.test/c/pay/1"
+  end
+
+  test "unknown plans are refused" do
+    sign_in_as :mike
+
+    post account_billing_checkouts_path(script_name: @account.slug), params: { plan: "nonesuch" }
+
+    assert_response :not_found
+  end
+
+  test "members cannot check out" do
+    sign_in_as :jz
+
+    post account_billing_checkouts_path(script_name: accounts(:"37s").slug), params: { plan: Plan::UNLIMITED.key }
+
+    assert_response :forbidden
+  end
+end
