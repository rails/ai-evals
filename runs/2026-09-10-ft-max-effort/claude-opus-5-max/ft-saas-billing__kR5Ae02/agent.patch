diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..1790c28
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,144 @@
+# What Stripe knows about an account's billing, mirrored locally so that a
+# request never has to ask Stripe anything. Kept up to date by the webhooks
+# Stripe posts to /stripe/webhooks.
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  class << self
+    def record_stripe_event(event)
+      case event.type
+      when "checkout.session.completed"
+        record_checkout event.data.object
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        record_subscription event.data.object
+      when "invoice.upcoming", "invoice.created", "invoice.finalized", "invoice.paid", "invoice.payment_succeeded"
+        record_invoice event.data.object
+      end
+    end
+
+    private
+      # Checkout only tells us who bought: the plan and the period arrive right
+      # after, with the customer.subscription.created event.
+      def record_checkout(session)
+        if account = account_for(session)
+          subscription_for(account).update! \
+            stripe_customer_id: session[:customer],
+            stripe_subscription_id: session[:subscription]
+        end
+      end
+
+      def record_subscription(stripe_subscription)
+        if subscription = matching_subscription(stripe_subscription)
+          subscription.update! attributes_from(stripe_subscription)
+        end
+      end
+
+      def record_invoice(invoice)
+        if subscription = find_by(stripe_subscription_id: invoice[:subscription]) || find_by(stripe_customer_id: invoice[:customer])
+          subscription.update! next_amount_due_in_cents: invoice[:amount_due]
+        end
+      end
+
+      def matching_subscription(stripe_subscription)
+        find_by(stripe_subscription_id: stripe_subscription[:id]) ||
+          find_by(stripe_customer_id: stripe_subscription[:customer]) ||
+          account_for(stripe_subscription)&.then { |account| subscription_for(account) }
+      end
+
+      def subscription_for(account)
+        account.subscription || account.build_subscription
+      end
+
+      def account_for(stripe_object)
+        Account.find_by(id: metadata_from(stripe_object)[:account_id]) ||
+          Account.find_by(external_account_id: stripe_object[:client_reference_id])
+      end
+
+      def attributes_from(stripe_subscription)
+        item = item_from(stripe_subscription)
+        price = item&.[](:price)
+
+        {
+          stripe_subscription_id: stripe_subscription[:id],
+          stripe_customer_id: stripe_subscription[:customer],
+          status: stripe_subscription[:status],
+          plan_key: plan_from(stripe_subscription, price)&.key,
+          current_period_end: time_from(stripe_subscription[:current_period_end] || item&.[](:current_period_end)),
+          cancel_at: time_from(stripe_subscription[:cancel_at]),
+          next_amount_due_in_cents: amount_from(item, price)
+        }
+      end
+
+      def item_from(stripe_subscription)
+        stripe_subscription[:items]&.[](:data)&.first
+      end
+
+      # Price ids differ per Stripe environment, so fall back to what the price
+      # says about itself before giving up on recognizing the plan.
+      def plan_from(stripe_subscription, price)
+        Plan.find(metadata_from(stripe_subscription)[:plan_key]) ||
+          Plan.find_by_stripe_price_id(price&.[](:id)) ||
+          Plan.find(price&.[](:lookup_key)) ||
+          Plan.find_by_price_in_cents(price&.[](:unit_amount))
+      end
+
+      def amount_from(item, price)
+        price[:unit_amount] * (item[:quantity] || 1) if price&.[](:unit_amount)
+      end
+
+      def metadata_from(stripe_object)
+        stripe_object[:metadata] || {}
+      end
+
+      def time_from(timestamp)
+        Time.at(timestamp).utc if timestamp
+      end
+  end
+
+  def plan
+    Plan.find(plan_key) || Plan.free
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceling?
+    active? && cancel_at.present?
+  end
+
+  def next_amount_due_in_dollars
+    next_amount_due_in_cents / 100.0 if next_amount_due_in_cents
+  end
+
+  # Keep billing in step with the account: cancelling stops the renewal,
+  # reactivating resumes it, and incinerating ends the subscription for good.
+  def stop_renewal
+    update_in_stripe cancel_at_period_end: true
+  end
+
+  def resume_renewal
+    update_in_stripe cancel_at_period_end: false
+  end
+
+  def cancel_in_stripe
+    if stripe_subscription_id.present?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+    end
+  rescue Stripe::StripeError => error
+    Rails.error.report error, handled: true
+  end
+
+  private
+    def update_in_stripe(**attributes)
+      if stripe_subscription_id.present?
+        Stripe::Subscription.update(stripe_subscription_id, **attributes)
+      end
+    rescue Stripe::StripeError => error
+      Rails.error.report error, handled: true
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..a7ee897
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,112 @@
+# The plans we sell. Prices and allowances live here; Stripe only knows about
+# the price ids, and Queenbee only knows about the short names.
+class Plan
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit, :stripe_price_id_variable
+
+  class << self
+    def all
+      ALL
+    end
+
+    # Plans answer to their key, to their Queenbee short name, and to the name
+    # we show people, since all three are floating around.
+    def find(key)
+      ALL.find { |plan| plan.key == key.to_s.underscore || plan.name.casecmp?(key.to_s) } if key.present?
+    end
+
+    def find_by_stripe_price_id(price_id)
+      ALL.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id } if price_id.present?
+    end
+
+    # Stripe price ids are configured per environment, so recognizing a plan by
+    # what it costs is the fallback when they are not.
+    def find_by_price_in_cents(price_in_cents)
+      paid.find { |plan| plan.price_in_cents == price_in_cents } if price_in_cents.present?
+    end
+
+    def free
+      FREE
+    end
+
+    def paid
+      ALL.select(&:paid?)
+    end
+  end
+
+  def initialize(key:, name:, price_in_cents:, storage_limit:, card_limit: nil, stripe_price_id_variable: nil)
+    @key, @name, @price_in_cents, @storage_limit, @card_limit, @stripe_price_id_variable =
+      key, name, price_in_cents, storage_limit, card_limit, stripe_price_id_variable
+  end
+
+  def free?
+    price_in_cents.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def price
+    price_in_cents / 100.0
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_id_variable] if stripe_price_id_variable
+  end
+
+  # Plans people can move up to from this one, cheapest first.
+  def upgrades
+    ALL.select { |plan| plan.price_in_cents > price_in_cents }
+  end
+
+  def upgradable?
+    upgrades.any?
+  end
+
+  # Queenbee tracks subscriptions by short name, and so identifies a plan by
+  # the camelized version of its key. Being string-convertible keeps both
+  # sides talking about the same thing.
+  def queenbee_short_name
+    key.camelize
+  end
+
+  alias_method :to_s, :queenbee_short_name
+  alias_method :to_str, :queenbee_short_name
+  alias_method :to_param, :key
+
+  def ==(other)
+    other.is_a?(Plan) ? key == other.key : to_s == other.to_s
+  end
+  alias_method :eql?, :==
+
+  def hash
+    key.hash
+  end
+
+  FREE = new \
+    key: "free_v1",
+    name: "Free",
+    price_in_cents: 0,
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte
+
+  UNLIMITED = new \
+    key: "monthly_v1",
+    name: "Unlimited",
+    price_in_cents: 20_00,
+    storage_limit: 5.gigabytes,
+    stripe_price_id_variable: "STRIPE_MONTHLY_V1_PRICE_ID"
+
+  UNLIMITED_PLUS = new \
+    key: "monthly_extra_storage_v1",
+    name: "Unlimited+",
+    price_in_cents: 25_00,
+    storage_limit: 500.gigabytes,
+    stripe_price_id_variable: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+end
