+      <li>Owner: <strong><%= @account.owner_email || "No owner" %></strong></li>
+      <li>Created: <strong><%= time_ago_in_words(@account.created_at) %> ago</strong></li>
+      <li>Users: <strong><%= number_with_delimiter(@account.users.active.count) %></strong></li>
