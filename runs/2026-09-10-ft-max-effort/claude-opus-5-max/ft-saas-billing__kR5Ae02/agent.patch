diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..ac7f6de
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,63 @@
+#!/usr/bin/env ruby
+#
+# Fetches Stripe development credentials from 1Password and starts the Stripe
+# CLI listener that forwards webhooks to the local server.
+#
+# Usage: eval "$(bundle exec stripe-dev)"
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+
+PORT = ENV.fetch("PORT", "3006")
+WEBHOOKS_PATH = "/stripe/webhooks"
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/Development/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+def listen_for_webhooks(secret_key)
+  listener = IO.popen([ "stripe", "listen", "--api-key", secret_key,
+    "--forward-to", "localhost:#{PORT}#{WEBHOOKS_PATH}", err: [ :child, :out ] ])
+  Process.detach(listener.pid)
+
+  # The signing secret is announced on startup; the listener keeps running from
+  # there, forwarding events for as long as this shell session lives.
+  while line = listener.gets
+    return [ listener.pid, $1 ] if line =~ /(whsec_[A-Za-z0-9]+)/
+  end
+
+  [ listener.pid, nil ]
+end
+
+secret_key = op_read("STRIPE_SECRET_KEY")
+monthly_price_id = op_read("STRIPE_MONTHLY_V1_PRICE_ID")
+monthly_extra_storage_price_id = op_read("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+
+if [ secret_key, monthly_price_id, monthly_extra_storage_price_id ].any?(&:empty?)
+  warn "Error: Could not fetch Stripe credentials from 1Password"
+  warn "Make sure you're signed in: op signin --account #{OP_ACCOUNT}"
+  exit 1
+end
+
+unless system("command -v stripe > /dev/null 2>&1")
+  warn "Error: the Stripe CLI isn't installed. See https://stripe.com/docs/stripe-cli"
+  exit 1
+end
+
+pid, webhook_secret = listen_for_webhooks(secret_key)
+
+if webhook_secret.nil?
+  warn "Error: the Stripe CLI didn't report a webhook signing secret. Run `stripe login` and try again."
+  exit 1
+end
+
+puts %Q(export STRIPE_SECRET_KEY="#{secret_key}")
+puts %Q(export STRIPE_MONTHLY_V1_PRICE_ID="#{monthly_price_id}")
+puts %Q(export STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID="#{monthly_extra_storage_price_id}")
+puts %Q(export STRIPE_WEBHOOK_SECRET="#{webhook_secret}")
+
+warn ""
+warn "Stripe development credentials loaded"
+warn "  Plans: Unlimited (#{monthly_price_id}), Unlimited+ (#{monthly_extra_storage_price_id})"
+warn "  Webhooks: forwarding to localhost:#{PORT}#{WEBHOOKS_PATH} (stripe listen, pid #{pid})"
