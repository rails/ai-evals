+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts run out of cards at 1,000" do
+    @account.update! cards_count: 999
+    assert_not @account.exceeding_card_limit?
+
+    @account.update! cards_count: 1_000
+    assert @account.exceeding_card_limit?
+  end
+
+  test "counting down from 100 cards out" do
+    @account.update! cards_count: 899
+    assert_not @account.nearing_card_limit?
+
+    @account.update! cards_count: 900
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update! cards_count: 950
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "an account that has run out isn't also nearing the limit" do
+    @account.update! cards_count: 1_200
+
+    assert_not @account.nearing_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "paid accounts have no card limit" do
+    @account.create_subscription! plan_key: Plan::UNLIMITED.key, status: "active",
+      stripe_customer_id: "cus_initech", stripe_subscription_id: "sub_initech"
+    @account.update! cards_count: 5_000
+
+    assert_nil @account.card_limit
+    assert_nil @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+end
diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..7f29780
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "checkout records the customer and subscription" do
+    record "checkout.session.completed", {
+      client_reference_id: @account.external_account_id.to_s,
+      customer: "cus_1",
+      subscription: "sub_1",
+      metadata: { account_id: @account.id }
+    }
+
+    assert_equal "cus_1", @account.reload.subscription.stripe_customer_id
+    assert_equal "sub_1", @account.subscription.stripe_subscription_id
+  end
+
+  test "a new subscription puts the account on its plan" do
+    record "customer.subscription.created", stripe_subscription(unit_amount: 20_00)
+
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+    assert_equal "active", @account.subscription.status
+    assert_equal 20_00, @account.subscription.next_amount_due_in_cents
+    assert_equal Time.at(1_800_000_000).utc, @account.subscription.current_period_end
+  end
+
+  test "upgrading moves the account up" do
+    record "customer.subscription.created", stripe_subscription(unit_amount: 20_00)
+    record "customer.subscription.updated", stripe_subscription(unit_amount: 25_00)
+
+    assert_equal Plan::UNLIMITED_PLUS, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "a deleted subscription drops the account back to free" do
+    record "customer.subscription.created", stripe_subscription(unit_amount: 20_00)
+    record "customer.subscription.deleted", stripe_subscription(unit_amount: 20_00, status: "canceled")
+
+    assert_equal Plan::FREE, @account.reload.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "matching an unknown subscription by customer" do
+    record "customer.subscription.created", stripe_subscription(unit_amount: 20_00)
+    record "customer.subscription.updated", stripe_subscription(unit_amount: 25_00, metadata: {})
+
+    assert_equal Plan::UNLIMITED_PLUS, @account.reload.plan
+  end
+
+  test "ignoring events for unknown accounts" do
+    assert_no_difference -> { Account::Subscription.count } do
+      record "customer.subscription.created", stripe_subscription(unit_amount: 20_00, metadata: { account_id: "nonesuch" })
+    end
+  end
+
+  test "an upcoming invoice records what's next" do
+    record "customer.subscription.created", stripe_subscription(unit_amount: 20_00)
+    record "invoice.upcoming", { customer: "cus_1", subscription: "sub_1", amount_due: 40_00 }
+
+    assert_equal 40_00, @account.reload.subscription.next_amount_due_in_cents
+  end
+
+  test "ignoring events we don't care about" do
+    assert_nothing_raised do
+      record "payment_intent.succeeded", { id: "pi_1" }
+    end
+  end
+
+  private
+    def record(type, object)
+      Account::Subscription.record_stripe_event event(type, object)
+    end
+
+    def event(type, object)
+      Stripe::Event.construct_from JSON.parse({ type: type, data: { object: object } }.to_json, symbolize_names: true)
+    end
+
+    def stripe_subscription(unit_amount:, status: "active", metadata: nil)
+      {
+        id: "sub_1",
+        customer: "cus_1",
+        status: status,
+        metadata: metadata || { account_id: @account.id },
+        items: { data: [ { quantity: 1, current_period_end: 1_800_000_000, price: { id: "price_1", unit_amount: unit_amount } } ] }
+      }
+    end
+end
