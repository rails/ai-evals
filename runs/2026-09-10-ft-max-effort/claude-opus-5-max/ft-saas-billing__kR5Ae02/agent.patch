diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..e12c427
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @original_signing_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = @original_signing_secret.presence || "whsec_test"
+  end
+
+  teardown do
+    @original_signing_secret.nil? ? ENV.delete("STRIPE_WEBHOOK_SECRET") : ENV["STRIPE_WEBHOOK_SECRET"] = @original_signing_secret
+  end
+
+  test "a new subscription upgrades the account" do
+    untenanted { post_webhook "customer.subscription.created", stripe_subscription }
+
+    assert_response :success
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "a deleted subscription drops the account back to free" do
+    untenanted do
+      post_webhook "customer.subscription.created", stripe_subscription
+      post_webhook "customer.subscription.deleted", stripe_subscription(status: "canceled")
+    end
+
+    assert_response :success
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "events we don't handle are accepted" do
+    untenanted { post_webhook "payment_intent.succeeded", { id: "pi_1" } }
+
+    assert_response :success
+  end
+
+  test "payloads signed with the wrong secret are refused" do
+    untenanted { post_webhook "customer.subscription.created", stripe_subscription, secret: "whsec_nope" }
+
+    assert_response :bad_request
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "unsigned payloads are refused" do
+    untenanted do
+      post saas.stripe_webhooks_path, params: event_payload("customer.subscription.created", stripe_subscription),
+        headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :bad_request
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "malformed payloads are refused" do
+    untenanted { post_body "not json" }
+
+    assert_response :bad_request
+  end
+
+  private
+    def post_webhook(type, object, secret: signing_secret)
+      post_body event_payload(type, object), secret: secret
+    end
+
+    def post_body(payload, secret: signing_secret)
+      post saas.stripe_webhooks_path, params: payload, headers: {
+        "CONTENT_TYPE" => "application/json",
+        "Stripe-Signature" => signature_for(payload, secret)
+      }
+    end
+
+    def event_payload(type, object)
+      { id: "evt_1", type: type, data: { object: object } }.to_json
+    end
+
+    def stripe_subscription(status: "active")
+      {
+        id: "sub_1",
+        customer: "cus_1",
+        status: status,
+        metadata: { account_id: @account.id },
+        items: { data: [ { quantity: 1, current_period_end: 1_800_000_000, price: { id: "price_1", unit_amount: 20_00 } } ] }
+      }
+    end
+
+    def signature_for(payload, secret, timestamp: Time.now)
+      Stripe::Webhook::Signature.generate_header timestamp,
+        Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+    end
+
+    def signing_secret
+      ENV.fetch("STRIPE_WEBHOOK_SECRET")
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..53400c1
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start on the free plan" do
+    assert_equal Plan::FREE, @account.plan
+    assert_not @account.subscribed?
+  end
+
+  test "an active subscription sets the plan" do
+    subscribe_to Plan::UNLIMITED
+
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+    assert @account.subscribed?
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+  end
+
+  test "a cancelled subscription falls back to free" do
+    subscribe_to Plan::UNLIMITED, status: "canceled"
+
+    assert_equal Plan::FREE, @account.reload.plan
+    assert_not @account.subscribed?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comping an account lifts its limits" do
+    @account.comp
+
+    assert @account.comped?
+    assert_equal Plan::UNLIMITED_PLUS, @account.plan
+    assert_nil @account.card_limit
+  end
+
+  test "comping is idempotent" do
+    @account.comp
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+  end
+
+  test "uncomping puts an account back on its plan" do
+    @account.comp
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal Plan::FREE, @account.plan
+  end
+
+  test "overriding usage" do
+    @account.override_limits card_count: 950, bytes_used: 2.gigabytes
+
+    assert_equal 950, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.nearing_card_limit?
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "overriding usage twice replaces the override" do
+    @account.override_limits card_count: 950
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      @account.override_limits card_count: 1_000
+    end
+
+    assert_equal 1_000, @account.card_count
+  end
+
+  test "resetting the override restores real usage" do
+    @account.update! cards_count: 12
+    @account.override_limits card_count: 950, bytes_used: 2.gigabytes
+    @account.reset_overridden_limits
+
+    assert_equal 12, @account.card_count
+    assert_equal 0, @account.bytes_used
+    assert_nil @account.overridden_limit
+  end
+
+  test "cancelling the account stops the subscription from renewing" do
+    subscribe_to Plan::UNLIMITED
+
+    Stripe::Subscription.expects(:update).with("sub_initech", cancel_at_period_end: true)
+
+    @account.cancel initiated_by: users(:mike)
+  end
+
+  test "incinerating the account cancels the subscription outright" do
+    subscribe_to Plan::UNLIMITED
+
+    Stripe::Subscription.expects(:cancel).with("sub_initech")
+
+    @account.incinerate
+  end
+
+  private
+    def subscribe_to(plan, status: "active")
+      @account.create_subscription! plan_key: plan.key, status: status,
+        stripe_customer_id: "cus_initech", stripe_subscription_id: "sub_initech"
+    end
+end
diff --git a/saas/test/models/account/card_limited_test.rb b/saas/test/models/account/card_limited_test.rb
