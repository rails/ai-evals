diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..5bfc5d6
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,109 @@
+# An account pays us through Stripe, unless support has comped it. Whatever the
+# arrangement, it always has a plan, and the plan sets the allowances.
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, -> { order(created_at: :desc) }, class_name: "Account::Subscription", dependent: :destroy
+    has_one :active_subscription, -> { active.order(created_at: :desc) }, class_name: "Account::Subscription"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+
+    set_callback :cancel,     :after,  :stop_subscription_renewal
+    set_callback :reactivate, :after,  :resume_subscription_renewal
+    set_callback :incinerate, :before, :cancel_subscription_in_stripe
+  end
+
+  def plan
+    if active_subscription
+      active_subscription.plan
+    elsif comped?
+      Plan::UNLIMITED_PLUS
+    else
+      Plan.free
+    end
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    reload_billing_waiver
+  end
+
+  # Support stand-ins for the account's real usage, so we can see what someone
+  # else is seeing without waiting for them to fill an account up.
+  def override_limits(card_count: nil, bytes_used: nil)
+    if overridden_limit
+      overridden_limit.update! card_count: card_count, bytes_used: bytes_used
+    else
+      create_overridden_limit! card_count: card_count, bytes_used: bytes_used
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+    reload_overridden_limit
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  # Stripe hosts both checkout and the customer portal: we only hand people over.
+  def checkout_url_for(plan, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create(**checkout_options_for(plan, success_url: success_url, cancel_url: cancel_url)).url
+  end
+
+  def billing_portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(customer: subscription.stripe_customer_id, return_url: return_url).url
+  end
+
+  private
+    def stop_subscription_renewal
+      subscription&.stop_renewal
+    end
+
+    def resume_subscription_renewal
+      subscription&.resume_renewal
+    end
+
+    def cancel_subscription_in_stripe
+      subscription&.cancel_in_stripe
+    end
+
+    def checkout_options_for(plan, success_url:, cancel_url:)
+      {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: external_account_id.to_s,
+        metadata: { account_id: id, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: id, plan_key: plan.key } },
+        success_url: success_url,
+        cancel_url: cancel_url,
+        **stripe_customer_options
+      }
+    end
+
+    def stripe_customer_options
+      if subscription&.stripe_customer_id.present?
+        { customer: subscription.stripe_customer_id }
+      else
+        { customer_email: owner_email }
+      end
+    end
+end
