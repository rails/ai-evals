@@ -0,0 +1,63 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "reacting to a comment" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment.card, reaction.card
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.new(content: "a" * 16).valid?
+    assert_not @comment.reactions.new(content: "a" * 17).valid?
+  end
+
+  test "content is required" do
+    assert_not @comment.reactions.new(content: "").valid?
+    assert_not @comment.reactions.new(content: "   ").valid?
+  end
+
+  test "reacting registers activity on the card" do
+    @comment.card.update!(last_active_at: 1.week.ago)
+
+    assert_changes -> { @comment.card.reload.last_active_at } do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "reacting touches the comment so cached renderings are refreshed" do
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "only the reacter can delete their reaction" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert reaction.deleteable_by?(users(:david))
+    assert_not reaction.deleteable_by?(users(:jz))
+  end
+
+  test "reactions are destroyed along with their comment" do
+    @comment.reactions.create!(content: "👍")
+
+    assert_difference -> { Reaction.count }, -1 do
+      @comment.destroy
+    end
+  end
+
+  test "reactions are destroyed along with their reacter" do
+    @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { Reaction.count }, -1 do
+      users(:kevin).destroy
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..24d077d
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,145 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+
+    sign_in_as(users(:david))
+  end
+
+  test "reacting to a comment" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("👍")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "👍"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal "👍", @comment.reactions.sole.content
+    assert_equal users(:david), @comment.reactions.sole.reacter
+  end
+
+  test "reacting with a short bit of text" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nicely done!")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "Nicely done!"
+    end
+
+    assert_equal "Nicely done!", @comment.reactions.sole.content
+  end
+
+  test "reacting with an emoji from the menu" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[title='Party popper']").click
+
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    assert_equal "🎉", @comment.reactions.sole.content
+  end
+
+  test "canceling a reaction" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nope")
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_empty @comment.reactions.reload
+  end
+
+  test "removing your own reaction" do
+    @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    visit card_url(@card)
+
+    within_reactions do
+      assert_no_selector ".reaction__delete"
+
+      find(".reaction", text: "👍").click
+      find(".reaction__delete").click
+
+      assert_no_selector ".reaction"
+    end
+
+    assert_empty @comment.reactions.reload
+  end
+
+  test "someone else's reaction can't be removed" do
+    @comment.reactions.create!(content: "👍", reacter: users(:jz))
+
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reaction", text: "👍").click
+
+      assert_no_selector ".reaction__delete"
+    end
+
+    assert_equal 1, @comment.reactions.reload.count
+  end
+
+  test "reactions left elsewhere land without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    react_elsewhere_with "🎉"
+
+    within_reactions do
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+
+test "a reaction in progress survives reactions landing from elsewhere" do
+  visit card_url(@card)
+  wait_for_cable_subscriptions
+
+  within_reactions { find(".reactions__trigger").click }
+  within_reactions { find(".reaction__input").set("Still typing") }
+
+  react_elsewhere_with "🎉"
+
+  within_reactions do
+    assert_selector ".reaction", text: "🎉", wait: 5
+    assert_equal "Still typing", find(".reaction__input").value
+  end
+end
+
+  private
+    def within_reactions(&)
+      within "##{dom_id(@comment, :reactions)}", &
+    end
+
+    def react_elsewhere_with(content)
+      @comment.reactions.create!(content: content, reacter: users(:kevin))
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
