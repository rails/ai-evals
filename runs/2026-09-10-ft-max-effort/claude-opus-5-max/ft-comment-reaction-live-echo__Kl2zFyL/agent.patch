+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,16 @@
+module ReactionsHelper
+  EMOJI_PATTERN = /\A(?:[\p{Emoji_Presentation}\p{Extended_Pictographic}]|\uFE0F|\u200D|\p{Space})+\z/
+
+  def reaction_content_tag(reaction)
+    tag.span reaction.content, class: class_names("txt-small", "txt-medium": emoji_only?(reaction.content))
+  end
+
+  def reaction_description(reaction)
+    "#{reaction.reacter.name} reacted with #{reaction.content}"
+  end
+
+  private
+    def emoji_only?(content)
+      content.match?(EMOJI_PATTERN)
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..2c0dd19
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reveals the button to remove a reaction when you click one of your own.
+// Ownership is decided here because comments are cached and shared by everyone.
+export default class extends Controller {
+  connect() {
+    this.markIfMine()
+  }
+
+  markIfMine() {
+    this.element.classList.toggle("reaction--deleteable", this.#mine)
+  }
+
+  toggle() {
+    if (this.#mine) this.element.classList.toggle("expanded")
+  }
+
+  collapse() {
+    this.element.classList.remove("expanded")
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  markAsDeleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #mine() {
+    return this.element.dataset.creatorId === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..01d7e3f
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,49 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the "add a reaction" button for a small input, and puts the button back
+// once the reaction has been left or abandoned.
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  expand() {
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    if (this.#expanded) {
+      this.formTarget.reset()
+      this.formTarget.hidden = true
+      this.formTarget.classList.remove("reaction", "expanded")
+      this.triggerTarget.hidden = false
+    }
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  collapseOnSuccess({ detail: { success } }) {
+    if (success) this.collapse()
+  }
+
+  react({ params: { content } }) {
+    this.inputTarget.value = content
+    this.formTarget.requestSubmit()
+  }
+
+  // Reactions landing from elsewhere refresh the page, so hold on to the
+  // reaction being written while the input is open.
+  preventCollapseOnMorphing(event) {
+    if (this.#expanded) {
+      event.preventDefault()
+      event.stopPropagation()
+    }
+  }
+
+  get #expanded() {
+    return !this.formTarget.hidden
+  }
+}
