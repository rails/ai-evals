+<button type="button" class="reactions__trigger btn btn--circle" title="React to this comment"
+        data-reactions-target="trigger" data-action="reactions#expand">
+  <%= image_tag "boost-color.svg", size: 24, alt: "", aria: { hidden: true } %>
+  <span class="for-screen-reader">Add a reaction</span>
+</button>
+
+<%= form_with url: card_comment_reactions_path(comment.card, comment), scope: :reaction, class: "reaction__form",
+      data: { reactions_target: "form" },
+      html: { hidden: true } do |form| %>
+  <label class="reaction__form-label flex align-center" for="<%= dom_id(comment, :reaction_content) %>">
+    <span class="for-screen-reader">Your reaction</span>
+    <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "input reaction__input",
+          maxlength: Reaction::MAXIMUM_CONTENT_LENGTH, required: true, autocomplete: "off", placeholder: "React…",
+          data: { reactions_target: "input", "1p-ignore": "true" } %>
+  </label>
+
+  <span class="reaction__menu" data-controller="dialog"
+        data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
+    <button type="button" class="reaction__menu-btn btn btn--plain" title="Pick an emoji" data-action="click->dialog#open:stop">
+      <%= icon_tag "reaction" %>
+      <span class="for-screen-reader">Pick an emoji</span>
+    </button>
+
+    <dialog class="reaction__popup popup panel fill-white shadow txt-small" data-dialog-target="dialog">
+      <div class="reaction__emoji-list">
+        <% EmojiHelper::REACTIONS.each do |emoji, description| %>
+          <button type="button" class="btn btn--plain" title="<%= description %>"
+                  data-action="reactions#react dialog#close" data-reactions-content-param="<%= emoji %>"><%= emoji %></button>
+        <% end %>
+      </div>
+    </dialog>
+  </span>
+
+  <%= form.button type: :submit, class: "reaction__submit-btn btn btn--plain", title: "Add this reaction" do %>
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Add reaction</span>
+  <% end %>
+
+  <button type="button" class="reaction__cancel-btn btn btn--plain" title="Cancel" data-action="reactions#collapse">
+    <%= icon_tag "close" %>
+    <span class="for-screen-reader">Cancel reaction</span>
+  </button>
+<% end %>
