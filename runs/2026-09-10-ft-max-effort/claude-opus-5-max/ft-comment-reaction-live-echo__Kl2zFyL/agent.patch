diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..5cf7e34
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+
+      assert_response :success
+      assert_turbo_stream action: :append, target: dom_id(@comment, :reactions_list)
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal "👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "create with text" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nicely done!" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal "Nicely done!", @comment.reactions.last.content
+  end
+
+test "create on an inaccessible card" do
+  comment = create_comment_on_private_board
+
+  logout_and_sign_in_as :david
+
+  assert_no_difference -> { Reaction.count } do
+    post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+  end
+
+  assert_response :not_found
+end
+
+  test "destroy" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+
+      assert_response :success
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "destroy someone else's reaction is forbidden" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ reaction.id ], @response.parsed_body.pluck("id")
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal users(:david).id, @response.parsed_body.first.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Great 👍", @comment.reactions.last.content
+    assert_equal @comment.reactions.last.id, @response.parsed_body["id"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "👏" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👏", @comment.reactions.last.content
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "comment JSON links to its reactions" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+
+  test "reactions show up on the card" do
+    @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}" do
+      assert_select ".reaction.reaction--deleteable", text: /👍/
+      assert_select ".reactions__trigger"
+    end
+  end
+  test "reactions show up on cached comments" do
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", 0
+
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", 1
+    end
+end
+
+  private
+    def create_comment_on_private_board
+      Current.with(user: users(:kevin)) do
+        card = boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Secret")
+        card.comments.create!(creator: users(:kevin), body: "Hush")
+      end
+    end
+end
