diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..4c78319
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:david)
+    @magic_link = @identity.magic_links.create!
+  end
+
+  test "generates a six character code" do
+    assert_equal MagicLink::CODE_LENGTH, @magic_link.code.length
+    assert_match /\A[A-Z2-9]+\z/, @magic_link.code
+  end
+
+  test "authenticating with the right code returns the identity" do
+    assert_equal @identity, @magic_link.authenticate(@magic_link.code)
+  end
+
+  test "authenticating ignores case and surrounding spaces" do
+    assert_equal @identity, @magic_link.authenticate(" #{@magic_link.code.downcase} ")
+  end
+
+  test "authenticating with the wrong code returns nothing" do
+    assert_nil @magic_link.authenticate("NOPE12")
+    assert_nil @magic_link.authenticate(nil)
+    assert_nil @magic_link.authenticate("")
+  end
+
+  test "authenticating with an expired code returns nothing" do
+    travel MagicLink::EXPIRES_IN + 1.minute
+
+    assert_not @magic_link.active?
+    assert_nil @magic_link.authenticate(@magic_link.code)
+  end
+
+  test "finding by token" do
+    assert_equal @magic_link, MagicLink.find_by_token(@magic_link.token)
+  end
+
+  test "finding by an expired token" do
+    token = @magic_link.token
+    travel MagicLink::EXPIRES_IN + 1.minute
+
+    assert_nil MagicLink.find_by_token(token)
+  end
+
+  test "finding by a bogus token" do
+    assert_nil MagicLink.find_by_token("bogus")
+    assert_nil MagicLink.find_by_token(nil)
+    assert_nil MagicLink.find_by_token(@magic_link.signed_id(purpose: :something_else))
+  end
+
+  test "cleanup removes expired codes" do
+    travel MagicLink::EXPIRES_IN + 1.minute
+    fresh = @identity.magic_links.create!
+
+    MagicLink.cleanup
+
+    assert_not MagicLink.exists?(@magic_link.id)
+    assert MagicLink.exists?(fresh.id)
+  end
+
+  test "deliver later emails the code" do
+    assert_emails 1 do
+      perform_enqueued_jobs { @magic_link.deliver_later }
+    end
+
+    assert_equal [ @identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+end
