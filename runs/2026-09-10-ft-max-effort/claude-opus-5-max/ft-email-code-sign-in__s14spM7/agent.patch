diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..3c47c23
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,57 @@
+# A short-lived code we email to someone so they can prove they own an email address and get signed in.
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_ALPHABET = %w[ A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ] # No look-alikes: I, O, 0, 1
+  EXPIRES_IN = 15.minutes
+
+  belongs_to :identity
+
+  scope :active, -> { where(created_at: EXPIRES_IN.ago..) }
+  scope :expired, -> { where(created_at: ...EXPIRES_IN.ago) }
+
+  before_create :generate_code
+
+  class << self
+    def find_by_token(token)
+      if magic_link = find_signed(token, purpose: :magic_link)
+        magic_link if magic_link.active?
+      end
+    end
+
+    def normalize_code(code)
+      code.to_s.strip.upcase
+    end
+
+    def cleanup
+      expired.in_batches.delete_all
+    end
+  end
+
+  def token
+    signed_id(purpose: :magic_link, expires_in: EXPIRES_IN)
+  end
+
+  def deliver_later
+    # Logged so self-hosted instances without email configured can still get their code.
+    logger.info "Emailing code #{code} to #{identity.email_address}"
+
+    IdentityMailer.magic_link(self).deliver_later
+  end
+
+  def authenticate(candidate_code)
+    identity if active? && matches?(candidate_code)
+  end
+
+  def active?
+    created_at > EXPIRES_IN.ago
+  end
+
+  private
+    def matches?(candidate_code)
+      ActiveSupport::SecurityUtils.secure_compare(code, self.class.normalize_code(candidate_code))
+    end
+
+    def generate_code
+      self.code = CODE_LENGTH.times.map { CODE_ALPHABET.sample(random: SecureRandom) }.join
+    end
+end
