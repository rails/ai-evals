diff --git a/app/views/sessions/magic_links/new.html.erb b/app/views/sessions/magic_links/new.html.erb
new file mode 100644
index 0000000..b8b5fc6
--- /dev/null
+++ b/app/views/sessions/magic_links/new.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap center">
+        <%= form.text_field :code, required: true, class: "input", autofocus: true, autocomplete: "one-time-code",
+              inputmode: "text", spellcheck: false, maxlength: MagicLink::CODE_LENGTH, placeholder: "Code" %>
+      </label>
+    </div>
+
+    <p>
+      We emailed <%= @magic_link ? tag.strong(@magic_link.identity.email_address) : "you" %>
+      a <%= MagicLink::CODE_LENGTH %>-character code. Enter it here to continue.
+      It expires in <%= distance_of_time_in_words(MagicLink::EXPIRES_IN) %>.
+    </p>
+
+    <button type="submit" id="verify_code" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if Rails.env.development? && @magic_link %>
+    <p class="txt-subtle txt-small">Psst, here’s your code: <strong><%= @magic_link.code %></strong></p>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= link_to "Use a different email address", new_session_path, class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
