+    untenanted do
+      get new_session_magic_link_path
+
+      assert_response :success
+    end
+  end
+
+  test "create signs in with the emailed code" do
+    code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+
+    assert_equal @identity, Session.last.identity
+  end
+
+  test "create accepts a lowercase code" do
+    code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: code.downcase }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with the wrong code" do
+    request_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create without a pending code" do
+    untenanted do
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with an expired code" do
+    code = request_magic_link
+
+    travel MagicLink::EXPIRES_IN + 1.minute
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "codes can only be used once" do
+    code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      delete session_path
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "asking for another code invalidates the first one" do
+    first_code = request_magic_link
+    second_code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: first_code }
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: second_code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create returns to where you were headed before signing in" do
+    get cards_path # Remembers where we were headed
+
+    code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+    end
+
+    assert_redirected_to cards_url(script_name: accounts("37s").slug)
+  end
+
+  test "create via JSON" do
+    code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create with the wrong code via JSON" do
+    request_magic_link
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "WRONG1" }
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  private
+    def request_magic_link(email_address: @identity.email_address)
+      untenanted { post session_path, params: { email_address: email_address } }
+      MagicLink.last.code
+    end
+end
