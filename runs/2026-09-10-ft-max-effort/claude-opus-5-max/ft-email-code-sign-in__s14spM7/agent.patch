new file mode 100644
index 0000000..2952b54
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,37 @@
+# Emails a short-lived code to an identity and keeps track of the pending authentication
+# it belongs to, so the code can be checked when it's entered on the next screen.
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  PENDING_AUTHENTICATION_COOKIE = :pending_authentication_token
+
+  private
+    def deliver_magic_link_to(identity)
+      identity.magic_links.create!.tap do |magic_link|
+        magic_link.deliver_later
+        self.pending_magic_link = magic_link
+      end
+    end
+
+    def pending_magic_link
+      @pending_magic_link ||= MagicLink.find_by_token(pending_authentication_token)
+    end
+
+    def pending_magic_link=(magic_link)
+      @pending_magic_link = magic_link
+
+      cookies[PENDING_AUTHENTICATION_COOKIE] = {
+        value: magic_link.token, httponly: true, same_site: :lax, expires: MagicLink::EXPIRES_IN.from_now
+      }
+    end
+
+    def pending_authentication_token
+      cookies[PENDING_AUTHENTICATION_COOKIE]
+    end
+
+    def consume_pending_magic_link
+      pending_magic_link&.destroy
+      cookies.delete PENDING_AUTHENTICATION_COOKIE
+      @pending_magic_link = nil
+    end
+end
