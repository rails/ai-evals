diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..5339dee
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,190 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain) # Awaiting triage, so it starts out in the "Maybe?" column
+  end
+
+  test "dragging a card onto a column moves it into that column" do
+    visit board_url(@board)
+    drag @card, onto: dom_id(columns(:writebook_in_progress))
+
+    assert_card_in_column @card, dom_id(columns(:writebook_in_progress))
+    assert_equal columns(:writebook_in_progress).color.to_s, card_color(@card)
+    assert_eventually("card was not triaged") { @card.reload.column == columns(:writebook_in_progress) }
+  end
+
+  test "dragging a card onto the Not Now column postpones it" do
+    visit board_url(@board)
+    drag @card, onto: "not-now"
+
+    assert_card_in_column @card, "not-now"
+    assert_eventually("card was not postponed") { @card.reload.postponed? }
+  end
+
+  test "dragging a card onto the Done column closes it" do
+    visit board_url(@board)
+    drag @card, onto: "closed-cards"
+
+    assert_card_in_column @card, "closed-cards"
+    assert_eventually("card was not closed") { @card.reload.closed? }
+  end
+
+  test "dragging a card onto the Maybe? column sends it back to triage" do
+    card = cards(:text)
+    visit board_url(@board)
+    expand_column dom_id(columns(:writebook_in_progress))
+
+    drag card, onto: "maybe"
+
+    assert_card_in_column card, "maybe"
+    assert_eventually("card was not sent back to triage") { card.reload.awaiting_triage? }
+  end
+
+  test "dragging a closed card onto a column reopens it there" do
+    card = cards(:shipping)
+    visit board_url(@board)
+    expand_column "closed-cards"
+
+    drag card, onto: dom_id(columns(:writebook_review))
+
+    assert_card_in_column card, dom_id(columns(:writebook_review))
+    assert_eventually("card was not reopened") { card.reload.open? && card.column == columns(:writebook_review) }
+  end
+
+  test "a card that cannot be moved goes back where it came from" do
+    visit board_url(@board)
+    break_drop_url_of dom_id(columns(:writebook_review))
+
+    drag @card, onto: dom_id(columns(:writebook_review))
+
+    assert_card_in_column @card, "maybe"
+    assert @card.reload.awaiting_triage?
+  end
+
+  test "a dropped card lands in its new column before the move is saved" do
+    visit board_url(@board)
+
+    assert drop(@card, onto: dom_id(columns(:writebook_review))), "card did not move on drop"
+    assert_eventually("card was not triaged") { @card.reload.column == columns(:writebook_review) }
+  end
+
+  test "the board stays put once the move is saved" do
+    visit board_url(@board)
+    wait_for_cable_subscriptions
+
+    drag @card, onto: dom_id(columns(:writebook_review))
+    assert_eventually("card was not triaged") { @card.reload.column == columns(:writebook_review) }
+
+    mark_dropped_card
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    sleep 1 # Give the refresh that shouldn't come a chance to render
+
+    assert_card_in_column @card, dom_id(columns(:writebook_review))
+    assert_selector "#{card_selector(@card)}[data-dropped]", visible: :all
+  end
+
+  test "the dragged card dims and the column under it lights up" do
+    visit board_url(@board)
+    start_dragging @card, over: dom_id(columns(:writebook_review))
+
+    assert_selector "#{card_selector(@card)}.drag-and-drop__dragged-item"
+    assert_selector "##{dom_id(columns(:writebook_review))}.drag-and-drop__hover-container"
+
+    stop_dragging @card
+
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+  end
+
+  test "dropping a card on the column it came from leaves it where it is" do
+    visit board_url(@board)
+    drag @card, onto: "maybe"
+
+    assert_card_in_column @card, "maybe"
+    assert_no_selector "#maybe.drag-and-drop__hover-container"
+    assert @card.reload.awaiting_triage?
+  end
+
+  private
+    DROP_SCRIPT = <<~JS
+      (function(card, column) {
+        const options = { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }
+
+        card.dispatchEvent(new DragEvent("dragstart", options))
+        column.dispatchEvent(new DragEvent("dragover", options))
+        column.dispatchEvent(new DragEvent("drop", options))
+
+        return column.contains(card)
+      })(arguments[0], arguments[1])
+    JS
+
+    START_DRAGGING_SCRIPT = <<~JS
+      const card = arguments[0], column = arguments[1]
+      const options = { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }
+
+      card.dispatchEvent(new DragEvent("dragstart", options))
+      column.dispatchEvent(new DragEvent("dragover", options))
+    JS
+
+    def drag(card, onto:)
+      find(card_selector(card)).drag_to(find("##{onto}"), html5: true)
+    end
+
+    # Drops a card without moving the mouse, answering whether it moved right away.
+    def drop(card, onto:)
+      page.evaluate_script(DROP_SCRIPT, find(card_selector(card)), find("##{onto}"))
+    end
+
+    def start_dragging(card, over:)
+      page.execute_script(START_DRAGGING_SCRIPT, find(card_selector(card)), find("##{over}"))
+    end
+
+    def stop_dragging(card)
+      page.execute_script(%(arguments[0].dispatchEvent(new DragEvent("dragend", { bubbles: true }))), find(card_selector(card)))
+    end
+
+    def expand_column(column_id)
+      find("##{column_id} .cards__expander").click
+      assert_selector "##{column_id}.is-expanded"
+    end
+
+    def break_drop_url_of(column_id)
+      page.execute_script(%(arguments[0].dataset.dragAndDropUrl = arguments[1]),
+        find("##{column_id}"), card_triage_path(0, column_id: columns(:writebook_review)))
+    end
+
+    # Re-rendering the board would wipe this attribute out.
+    def mark_dropped_card
+      page.execute_script(%(arguments[0].setAttribute("data-dropped", "")), find(card_selector(@card), visible: :all))
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def assert_card_in_column(card, column_id)
+      assert_selector "##{column_id} #{card_selector(card)}", visible: :all
+    end
+
+    def assert_eventually(message, timeout: Capybara.default_max_wait_time)
+      deadline = Time.now + timeout
+      sleep 0.05 until (result = yield) || Time.now > deadline
+
+      assert result, message
+    end
+
+    def card_color(card)
+      page.evaluate_script(%(arguments[0].style.getPropertyValue("--card-color")), find(card_selector(card), visible: :all))
+    end
+
+    def card_selector(card)
+      "##{dom_id(card, :article)}"
+    end
+end
