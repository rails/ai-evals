diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..97e5a0a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,134 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+const CARD_COLOR = "--card-color"
+
+// Moves cards between the columns of a board by dragging them.
+//
+// Columns keep their own order, so dropping a card only changes the column or the
+// status it belongs to. Dropped cards land in their new column right away and the
+// move is saved in the background, going back home when it can't be saved.
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "card", "column", "list" ]
+  static values = { cardIdPlaceholder: String }
+
+  connect() {
+    this.draggedCard = null
+    this.originColumn = null
+    this.hoveredColumn = null
+  }
+
+  async start(event) {
+    this.draggedCard = this.#cardContaining(event.target)
+    if (!this.draggedCard) return
+
+    this.originColumn = this.#columnContaining(this.draggedCard)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", this.draggedCard.id)
+
+    await nextFrame() // Dim the card only once the browser took its drag image
+    this.draggedCard?.classList.add(this.draggedItemClass)
+  }
+
+  hover(event) {
+    const column = this.#dropColumnFor(event.target)
+
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(column)
+    } else {
+      this.#stopHighlighting()
+    }
+  }
+
+  leave(event) {
+    if (!this.element.contains(event.relatedTarget)) this.#stopHighlighting()
+  }
+
+  drop(event) {
+    const column = this.#dropColumnFor(event.target)
+    if (!column) return
+
+    event.preventDefault()
+    this.#moveCard(this.draggedCard, column) // Deliberately not awaited: the card is already there
+  }
+
+  end() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.originColumn = null
+    this.#stopHighlighting()
+  }
+
+  // Private
+
+  #cardContaining(element) {
+    return this.cardTargets.find(card => card.contains(element))
+  }
+
+  #columnContaining(element) {
+    return this.columnTargets.find(column => column.contains(element))
+  }
+
+  // Cards can only be dropped on a column other than the one they came from:
+  // columns keep their own order, so dropping one back home means nothing.
+  #dropColumnFor(element) {
+    if (!this.draggedCard) return null
+
+    const column = this.#columnContaining(element)
+    return column === this.originColumn ? null : column
+  }
+
+  #highlight(column) {
+    if (this.hoveredColumn === column) return
+
+    this.#stopHighlighting()
+    this.hoveredColumn = column
+    column.classList.add(this.hoverContainerClass)
+  }
+
+  #stopHighlighting() {
+    this.hoveredColumn?.classList.remove(this.hoverContainerClass)
+    this.hoveredColumn = null
+  }
+
+  async #moveCard(card, column) {
+    const home = this.#homeOf(card)
+    this.#place(card, column)
+
+    if (!await this.#saveMove(card, column)) this.#returnHome(card, home)
+  }
+
+  #homeOf(card) {
+    return { list: card.parentElement, nextCard: card.nextElementSibling, color: card.style.getPropertyValue(CARD_COLOR) }
+  }
+
+  #place(card, column) {
+    card.style.setProperty(CARD_COLOR, column.dataset.cardColor)
+    this.#listIn(column)?.prepend(card)
+  }
+
+  #listIn(column) {
+    return this.listTargets.find(list => column.contains(list))
+  }
+
+  async #saveMove(card, column) {
+    const request = new FetchRequest(column.dataset.dragAndDropMethod, this.#dropUrlFor(card, column), { responseKind: "json" })
+    const response = await request.perform()
+
+    return response.ok
+  }
+
+  // Columns carry a placeholder where the id of the card dropped on them goes.
+  #dropUrlFor(card, column) {
+    return column.dataset.dragAndDropUrl.replace(this.cardIdPlaceholderValue, card.dataset.cardNumber)
+  }
+
+  #returnHome(card, { list, nextCard, color }) {
+    card.style.setProperty(CARD_COLOR, color)
+    list.insertBefore(card, nextCard)
+  }
+}
