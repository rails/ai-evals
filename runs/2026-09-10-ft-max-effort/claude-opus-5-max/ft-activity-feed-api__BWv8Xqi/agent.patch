diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..f922fa8
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,100 @@
+# Activities
+
+Activities are the events that make up an account's timeline: cards being added, assigned, renamed, moved, and closed, plus the comments posted on them. It's the same activity you see on the Fizzy home screen.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of the activity you have access to, newest first. Activity on boards you can't access is never returned.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the ID(s) of the users who created the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vb1q985jlvwv3arl4srq2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to &quot;First!&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a8"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 4,
+      "title": "First!",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/4"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm",
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David Heinemeier Hansson",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+      }
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+`description` is the plain-text version of the description shown in the timeline, and `url` opens the card the activity happened on. For comments, it opens the card the comment was posted on and jumps to the comment.
+
+`eventable_type` is either `Card` or `Comment`, and `eventable` is the card or comment itself, returned in full in the same shape as the [cards](cards.md) and [comments](comments.md) endpoints (abbreviated above).
+
+__Actions:__
+
+| Action | Description |
+|--------|-------------|
+| `card_published` | Card was added |
+| `card_assigned` | Card was assigned |
+| `card_unassigned` | Card was unassigned |
+| `card_title_changed` | Card was renamed |
+| `card_board_changed` | Card was moved to another board |
+| `card_triaged` | Card was moved to a column |
+| `card_sent_back_to_triage` | Card was moved back to "Maybe?" |
+| `card_closed` | Card was moved to "Done" |
+| `card_reopened` | Card was reopened |
+| `card_postponed` | Card was moved to "Not Now" |
+| `card_auto_postponed` | Card was moved to "Not Now" due to inactivity |
+| `comment_created` | Comment was added to a card |
+
+__Particulars:__
+
+`particulars` carries the details of what changed, and it varies by action:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| Everything else | `{}` |
+
+Board, title, and column values that weren't recorded are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..1f51fe1
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns activity as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    activity = find_activity events(:logo_published)
+    assert_equal "card_published", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal({}, activity["particulars"])
+    assert_match "David added", activity["description"]
+    assert_not_nil activity["created_at"]
+  end
+
+  test "index returns the newest activity first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index is available to API clients with an access token" do
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+
+  test "index only returns activity from accessible boards" do
+    private_activity = private_card.events.sole
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.pluck("id"), private_activity.id
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+    assert_not_includes @response.parsed_body.pluck("id"), private_activity.id
+  end
+
+  test "index doesn't return activity from other accounts" do
+    get activities_path, as: :json
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.none? { |activity| activity.dig("board", "id") == boards(:miltons_wish_list).id }
+  end
+
+  test "index filters by creator" do
+    get activities_path(creator_ids: [ users(:david).id ]), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+  end
+
+  test "index filters by board" do
+    private_activity = private_card.events.sole
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ private_activity.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "index includes title changes and excludes deprecated collection changes" do
+    title_change = track_event "card_title_changed", old_title: "Old title", new_title: "New title"
+    collection_change = track_event "card_collection_changed", old_collection: "Old board", new_collection: "New board"
+
+    get activities_path, as: :json
+
+    assert_includes @response.parsed_body.pluck("id"), title_change.id
+    assert_not_includes @response.parsed_body.pluck("id"), collection_change.id
+  end
+
+  test "index returns assignment particulars" do
+    get activities_path, as: :json
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, find_activity(events(:logo_assignment_jz))["particulars"])
+  end
+
+  test "index returns board change particulars" do
+    event = track_event "card_board_changed", old_board: "Writebook", new_board: "Fizzy"
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Fizzy" }, find_activity(event)["particulars"])
+  end
+
+  test "index returns title change particulars" do
+    event = track_event "card_title_changed", old_title: "Old title", new_title: "New title"
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, find_activity(event)["particulars"])
+  end
+
+  test "index returns triage particulars" do
+    event = track_event "card_triaged", column: "In progress"
+
+    get activities_path, as: :json
+
+    assert_equal({ "column" => "In progress" }, find_activity(event)["particulars"])
+  end
+
+  test "index returns missing particulars as empty strings" do
+    event = track_event "card_triaged"
+
+    get activities_path, as: :json
+
+    assert_equal({ "column" => "" }, find_activity(event)["particulars"])
+  end
+
+  test "index links comment activity to the comment on its card" do
+    get activities_path, as: :json
+
+    comment = comments(:layout_overflowing_david)
+    activity = find_activity events(:layout_commented)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_match "David commented on", activity["description"]
+  end
+
+  test "index paginates" do
+    get activities_path(page: 1), as: :json
+    assert_response :success
+
+    first_page = @response.parsed_body
+
+    get activities_path(page: 2), as: :json
+    assert_response :success
+
+    assert_empty first_page.pluck("id") & @response.parsed_body.pluck("id")
+  end
+
+  private
+    def private_card
+      @private_card ||= with_current_user(:kevin) do
+        boards(:private).cards.create! title: "Secret plans", status: "published"
+      end
+    end
+
+    def track_event(action, **particulars)
+      with_current_user :kevin do
+        cards(:logo).board.events.create! action: action, creator: users(:kevin), eventable: cards(:logo),
+          particulars: particulars.any? ? { particulars: particulars } : {}
+      end
+    end
+
+    def find_activity(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
