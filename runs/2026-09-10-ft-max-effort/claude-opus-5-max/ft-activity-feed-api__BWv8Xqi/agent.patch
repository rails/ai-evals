@@ -0,0 +1,35 @@
+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  test "activity returns accessible events, newest first" do
+    activity = users(:kevin).activity
+
+    assert_includes activity, events(:logo_published)
+    assert_equal activity.to_a, activity.sort_by { |event| -event.created_at.to_f }
+  end
+
+  test "activity excludes events from boards without access" do
+    event = create_event "card_published", board: boards(:private)
+
+    assert_includes users(:kevin).activity, event
+    assert_not_includes users(:david).activity, event
+  end
+
+  test "activity only includes the actions shown in the timeline" do
+    title_change = create_event "card_title_changed"
+    collection_change = create_event "card_collection_changed"
+
+    assert_includes users(:kevin).activity, title_change
+    assert_not_includes users(:kevin).activity, collection_change
+  end
+
+  test "activity can be filtered by creator and board" do
+    assert users(:kevin).activity(creator_ids: [ users(:david).id ]).all? { |event| event.creator == users(:david) }
+    assert_empty users(:kevin).activity(board_ids: [ boards(:private).id ])
+  end
+
+  private
+    def create_event(action, board: boards(:writebook), creator: users(:kevin))
+      board.events.create! action: action, creator: creator, eventable: cards(:logo)
+    end
+end
