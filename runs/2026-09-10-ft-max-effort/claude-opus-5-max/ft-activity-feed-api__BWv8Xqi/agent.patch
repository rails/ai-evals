+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "summarizes assignment particulars" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).summarized_particulars)
+  end
+
+  test "summarizes board change particulars" do
+    event = build_event "card_board_changed", old_board: "Writebook", new_board: "Fizzy"
+
+    assert_equal({ old_board: "Writebook", new_board: "Fizzy" }, event.summarized_particulars)
+  end
+
+  test "summarizes title change particulars" do
+    event = build_event "card_title_changed", old_title: "Old title", new_title: "New title"
+
+    assert_equal({ old_title: "Old title", new_title: "New title" }, event.summarized_particulars)
+  end
+
+  test "summarizes triage particulars" do
+    event = build_event "card_triaged", column: "In progress"
+
+    assert_equal({ column: "In progress" }, event.summarized_particulars)
+  end
+
+  test "summarizes unrecorded particulars as empty strings" do
+    assert_equal({ old_board: "", new_board: "" }, build_event("card_board_changed").summarized_particulars)
+    assert_equal({ old_title: "", new_title: "" }, build_event("card_title_changed").summarized_particulars)
+    assert_equal({ column: "" }, build_event("card_triaged").summarized_particulars)
+    assert_equal({ assignee_ids: [] }, build_event("card_assigned").summarized_particulars)
+  end
+
+  test "summarizes events without particulars of their own as empty" do
+    assert_equal({}, events(:logo_published).summarized_particulars)
+    assert_equal({}, events(:layout_commented).summarized_particulars)
+  end
+
+  private
+    def build_event(action, **particulars)
+      Event.new action: action, eventable: cards(:logo), board: boards(:writebook), creator: users(:david),
+        particulars: particulars.any? ? { particulars: particulars } : {}
+    end
+end
