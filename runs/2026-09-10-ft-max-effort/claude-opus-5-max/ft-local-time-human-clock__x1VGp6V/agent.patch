diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..82b69ed 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,20 @@
 module TimeHelper
+  # Renders a timestamp for the browser to put into words in the viewer's own
+  # timezone (see local_time_controller.js). Nothing about the clock of whoever
+  # asked for the page ends up in the HTML, so it stays shareable and cacheable.
+  #
+  # Formats: :relative (the default), :time, :date, :date_with_year, :weekday,
+  # and :date_and_time.
+  def local_time_tag(time, format: :relative, **options)
+    tag.time \
+      class: token_list("local-time-value", options.delete(:class)),
+      datetime: time.in_time_zone.utc.iso8601,
+      data: {
+        controller: "local-time",
+        action: "turbo:morph-element->local-time#render",
+        local_time_format_value: format,
+        **options.delete(:data).to_h
+      },
+      **options
+  end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..8ae97a9
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,55 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, formatLocalTimeInFull } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Renders the timestamp in a <time datetime> element as words in the viewer's
+// own timezone. The server ships the raw time and nothing else, so the same
+// HTML reads right for everyone, wherever they are, and stays cacheable.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    startRefreshing(this)
+  }
+
+  disconnect() {
+    stopRefreshing(this)
+  }
+
+  render() {
+    if (this.#time) {
+      this.element.textContent = formatLocalTime(this.#time, this.formatValue)
+      this.element.title = formatLocalTimeInFull(this.#time)
+    }
+  }
+
+  get #time() {
+    const time = new Date(this.element.getAttribute("datetime") || NaN)
+
+    return isNaN(time) ? null : time
+  }
+}
+
+// Relative times go stale as the clock ticks, so refresh them all from one timer.
+const renderers = new Set()
+let timer
+
+function startRefreshing(controller) {
+  renderers.add(controller)
+  timer ||= setInterval(refreshAll, REFRESH_INTERVAL)
+}
+
+function stopRefreshing(controller) {
+  renderers.delete(controller)
+
+  if (renderers.size === 0) {
+    clearInterval(timer)
+    timer = null
+  }
+}
+
+function refreshAll() {
+  renderers.forEach(controller => controller.render())
+}
