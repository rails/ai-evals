diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..141fa6d
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  setup do
+    @time = Time.utc(2026, 9, 12, 17, 42, 3)
+  end
+
+  test "local_time_tag leaves the rendering to the browser" do
+    assert_select parse(local_time_tag(@time)), "time[data-controller=?]", "local-time", text: ""
+  end
+
+  test "local_time_tag carries the raw timestamp in UTC" do
+    assert_select parse(local_time_tag(@time)), "time[datetime=?]", "2026-09-12T17:42:03Z"
+  end
+
+  test "local_time_tag carries the same timestamp whatever the server's timezone" do
+    in_new_york = Time.use_zone("America/New_York") { local_time_tag(@time) }
+    in_madrid = Time.use_zone("Europe/Madrid") { local_time_tag(@time) }
+
+    assert_equal in_new_york, in_madrid
+  end
+
+  test "local_time_tag reads a date as its first moment in the current timezone" do
+    in_madrid = Time.use_zone("Europe/Madrid") { local_time_tag(Date.new(2026, 9, 12)) }
+
+    assert_select parse(in_madrid), "time[datetime=?]", "2026-09-11T22:00:00Z"
+  end
+
+  test "local_time_tag renders relative times by default" do
+    assert_select parse(local_time_tag(@time)), "time[data-local-time-format-value=?]", "relative"
+  end
+
+  test "local_time_tag renders the requested format" do
+    assert_select parse(local_time_tag(@time, format: :date_and_time)), "time[data-local-time-format-value=?]", "date_and_time"
+  end
+
+  test "local_time_tag keeps the attributes it's given" do
+    html = parse(local_time_tag(@time, class: "card__timestamp", data: { turbo_permanent: true }))
+
+    assert_select html, "time.local-time-value.card__timestamp[data-turbo-permanent=?]", "true"
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
