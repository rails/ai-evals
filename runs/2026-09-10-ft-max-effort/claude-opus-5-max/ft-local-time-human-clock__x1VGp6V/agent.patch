+// Turn a timestamp into words in the viewer's own timezone: today reads as a
+// clock time ("1:42 PM"), the days around it read as "yesterday" or "in 3
+// days", and anything further out reads as a date ("Sep 12").
+export function formatLocalTime(date, format = "relative", now = new Date()) {
+  return (LOCAL_TIME_FORMATS[format] || LOCAL_TIME_FORMATS.relative)(date, now)
+}
+
+export function formatLocalTimeInFull(date) {
