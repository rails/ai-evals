+require "test_helper"
+
+class LocalTimeCachingTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "cards ship raw timestamps for the browser to render" do
+    get card_path(@card)
+
+    assert_select ".card__meta time[datetime=?]", @card.created_at.utc.iso8601
+    assert_select ".comment__permalink-title time[datetime=?]", @comment.created_at.utc.iso8601
+  end
+
+  test "cards read the same for viewers in different timezones" do
+    assert_equal card_rendered_in("America/New_York"), card_rendered_in("Australia/Sydney")
+  end
