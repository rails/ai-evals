--- /dev/null
+++ b/test/system/local_times_test.rb
@@ -0,0 +1,94 @@
+require "application_system_test_case"
+
+class LocalTimesTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+  end
+
+  teardown do
+    view_from_timezone ""
+  end
+
+  test "a comment from earlier today reads as a clock time in the viewer's own timezone" do
+    comment = comment_created_at(Time.current)
+
+    view_from_timezone "America/New_York"
+    assert_comment_reads comment.created_at.in_time_zone("America/New_York").strftime("%-I:%M %p")
+
+    view_from_timezone "Europe/Madrid"
+    assert_comment_reads comment.created_at.in_time_zone("Europe/Madrid").strftime("%-I:%M %p")
+  end
+
+  test "a comment from last night reads as yesterday" do
+    comment_created_at 1.day.ago
+
+    view_from_timezone "America/New_York"
+    assert_comment_reads(/yesterday/i)
+  end
+
+  test "a comment from earlier in the week reads as days ago" do
+    comment_created_at 5.days.ago
+
+    view_from_timezone "America/New_York"
+    assert_comment_reads(/5 days ago/i)
+  end
+
+  test "an older comment reads as a date" do
+    comment = comment_created_at(30.days.ago)
+
+    view_from_timezone "America/New_York"
+    assert_comment_reads comment.created_at.in_time_zone("America/New_York").strftime("%b %-d")
+  end
+
+  test "a card closing overnight reads as tomorrow, and further out as days from now" do
+    closes_at 1.day.from_now
+    view_from_timezone "America/New_York"
+    assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” tomorrow"
+
+    closes_at 3.days.from_now
+    view_from_timezone "America/New_York"
+    assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” in 3 days"
+  end
+
+  test "times stay in the viewer's words when a broadcast morphs the page" do
+    comment_created_at 5.days.ago
+    view_from_timezone "America/New_York"
+    assert_comment_reads(/5 days ago/i)
+
+    retitle_card_elsewhere
+
+    assert_comment_reads(/5 days ago/i)
+    assert_no_selector "time:empty", visible: :all
+  end
+
+  private
+    def comment_created_at(time)
+      @card.comments.create!(creator: users(:david), body: "Anytime now").tap do |comment|
+        comment.update_columns(created_at: time)
+      end
+    end
+
+    def closes_at(time)
+      @card.update_columns(last_active_at: time - @card.auto_postpone_period)
+    end
+
+    def view_from_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+      visit card_url(@card) if timezone.present?
+    end
+
+    def assert_comment_reads(time)
+      assert_selector ".comment__permalink-title time", text: time
+    end
+
+    def retitle_card_elsewhere
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+      Current.user = users(:kevin)
+      @card.update!(title: "Retitled elsewhere")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+      assert_selector "h1", text: "Retitled elsewhere", wait: 5
+    end
+end
