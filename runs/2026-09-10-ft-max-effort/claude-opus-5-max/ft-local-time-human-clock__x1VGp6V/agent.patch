 export function signedDifferenceInDays(fromDate, toDate) {
-  return Math.round((beginningOfDay(toDate) - beginningOfDay(fromDate)) / (1000 * 60 * 60 * 24))
+  return Math.round((beginningOfDay(toDate) - beginningOfDay(fromDate)) / MILLISECONDS_IN_A_DAY)
 }
 
 export function beginningOfDay(date) {
@@ -9,6 +23,82 @@ export function beginningOfDay(date) {
   return new Date(Date.UTC(year, month - 1, day))
 }
 
+const LOCAL_TIME_FORMATS = {
+  relative: relativeTime,        // "1:42 PM", "yesterday", "5 days ago", "in 3 days", "Sep 12"
+  time: timeOfDay,               // "1:42 PM"
+  date: shortDate,               // "Sep 12", and "Sep 12, 2024" in other years
+  date_with_year: dateWithYear,  // "Sep 12, 2025"
+  weekday: weekdayDate,          // "Friday, September 12"
+  date_and_time: dateAndTime     // "9/12/25, 1:42 PM"
+}
+
+function relativeTime(date, now) {
+  const days = signedDifferenceInLocalDays(now, date)
+
+  if (days === 0) {
+    return timeOfDay(date)
+  } else if (Math.abs(days) < DAYS_IN_A_WEEK) {
+    return relativeDays(days)
+  } else {
+    return shortDate(date, now)
+  }
+}
+
+function relativeDays(days) {
+  return relativeTimeFormatter().format(days, "day")
+}
+
+function timeOfDay(date) {
+  return localTimeFormatter({ hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+function shortDate(date, now = new Date()) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return localTimeFormatter({ month: "short", day: "numeric" }).format(date)
+  } else {
+    return dateWithYear(date)
+  }
+}
+
+function dateWithYear(date) {
+  return localTimeFormatter({ month: "short", day: "numeric", year: "numeric" }).format(date)
+}
+
+function weekdayDate(date) {
+  return localTimeFormatter({ weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+function dateAndTime(date) {
+  return localTimeFormatter({ dateStyle: "short", timeStyle: "short" }).format(date)
+}
+
+// Days apart in the viewer's own timezone, counting the midnights in between.
+function signedDifferenceInLocalDays(fromDate, toDate) {
+  return Math.round((beginningOfLocalDay(toDate) - beginningOfLocalDay(fromDate)) / MILLISECONDS_IN_A_DAY)
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+const localTimeFormatters = new Map()
+
+function localTimeFormatter(options) {
+  const key = JSON.stringify(options)
+
+  if (!localTimeFormatters.has(key)) {
+    localTimeFormatters.set(key, new Intl.DateTimeFormat("en-US", options))
+  }
+
+  return localTimeFormatters.get(key)
+}
+
+let relativeTimeFormatterCache
+
+function relativeTimeFormatter() {
+  return relativeTimeFormatterCache ||= new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+}
