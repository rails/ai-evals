+require "test_helper"
+
+class EntropyHelperTest < ActionView::TestCase
+  test "cards that haven't burst never stall" do
+    assert_nil stalled_bubble_options_for(cards(:layout))[:stallsAt]
+  end
+
+  test "bubble options tell when a card that burst starts stalling" do
+    card = cards(:layout)
+    with_current_user(:david) { card.toggle_assignment users(:kevin) }
+    card.reload
+
+    options = stalled_bubble_options_for(card)
+
+    assert_equal card.last_active_at.iso8601, options[:lastActiveAt]
+    assert_equal (card.last_active_at + 2.weeks).iso8601, options[:stallsAt]
+  end
+end
diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..16893ff
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "cards that never burst don't stall" do
+    cards(:layout).update! last_active_at: 1.year.ago
+
+    assert_not cards(:layout).burst?
+    assert_not cards(:layout).stalled?
+  end
+
+  test "assigning someone bursts the card" do
+    assert_changes -> { cards(:layout).reload.burst? }, from: false, to: true do
+      cards(:layout).toggle_assignment users(:kevin)
+    end
+  end
+
+  test "reopening a card bursts it" do
+    assert_changes -> { cards(:shipping).reload.burst? }, from: false, to: true do
+      cards(:shipping).reopen
+    end
+  end
+
+  test "three comments from two people within a third of the auto-close period burst the card" do
+    card = cards(:text)
+
+    card.comments.create! creator: users(:david), body: "One"
+    card.comments.create! creator: users(:david), body: "Two"
+    assert_not card.reload.burst?
+
+    card.comments.create! creator: users(:jz), body: "Three"
+    assert card.reload.burst?
+  end
+
+  test "comments from a single person don't burst the card" do
+    card = cards(:text)
+
+    3.times { |n| card.comments.create! creator: users(:david), body: "Comment #{n}" }
+
+    assert_not card.reload.burst?
+  end
+
+  test "system comments don't burst the card" do
+    card = cards(:text)
+
+    card.comments.create! creator: users(:david), body: "One"
+    2.times { |n| card.comments.create! creator: accounts("37s").system_user, body: "System #{n}" }
+
+    assert_not card.reload.burst?
+  end
+
+  test "comments spread beyond a third of the auto-close period don't burst the card" do
+    card = cards(:text)
+    burst_period = card.auto_postpone_period.seconds / 3
+
+    travel_to((burst_period + 1.day).ago) do
+      card.comments.create! creator: users(:david), body: "One"
+      card.comments.create! creator: users(:jz), body: "Two"
+    end
+
+    card.comments.create! creator: users(:david), body: "Three"
+
+    assert_not card.reload.burst?
+  end
+
+  test "backdated comments burst the card when they cluster together" do
+    card = cards(:text)
+
+    card.comments.create! creator: users(:david), body: "One", created_at: 3.months.ago
+    card.comments.create! creator: users(:jz), body: "Two", created_at: 3.months.ago + 1.day
+    assert_not card.reload.burst?
+
+    card.comments.create! creator: users(:david), body: "Three", created_at: 3.months.ago + 2.days
+    assert card.reload.burst?
+  end
+
+  test "a card that burst stalls after two weeks without activity" do
+    card = cards(:layout)
+    card.toggle_assignment users(:kevin)
+    assert_not card.reload.stalled?
+
+    travel 2.weeks - 1.hour
+    assert_not card.reload.stalled?
+
+    travel 2.hours
+    assert card.reload.stalled?
+  end
+
+  test "any activity resets the stall" do
+    card = cards(:layout)
+    card.toggle_assignment users(:kevin)
+
+    travel 2.weeks + 1.day
+    assert card.reload.stalled?
+
+    card.comments.create! creator: users(:jz), body: "Still relevant?"
+    assert_not card.reload.stalled?
+
+    travel 2.weeks + 1.day
+    assert card.reload.stalled?
+  end
+
+  test "stalled scope" do
+    stalled = cards(:layout)
+    stalled.toggle_assignment users(:kevin)
+    travel 2.weeks + 1.day
+
+    assert_equal [ stalled ], Card.stalled.to_a
+    assert_equal [ stalled ], Card.indexed_by("stalled").to_a
+  end
+
+  test "stalled cards are listed by the stalled index" do
+    cards(:layout).toggle_assignment users(:kevin)
