diff --git a/app/javascript/helpers/translations.js b/app/javascript/helpers/translations.js
new file mode 100644
index 0000000..8016536
--- /dev/null
+++ b/app/javascript/helpers/translations.js
@@ -0,0 +1,37 @@
+// Translations for strings that only exist in JavaScript. The server renders
+// them for the current locale into a JSON data block; see
+// ApplicationHelper#javascript_translations_tag.
+const ELEMENT_ID = "js-translations"
+
+let cache = { source: null, translations: {} }
+
+function translations() {
+  const source = document.getElementById(ELEMENT_ID)?.textContent || "{}"
+
+  if (source !== cache.source) {
+    cache = { source, translations: JSON.parse(source) }
+  }
+
+  return cache.translations
+}
+
+export function t(key, interpolations = {}) {
+  let translation = key.split(".").reduce((node, part) => node?.[part], translations())
+
+  if (translation && typeof translation === "object") {
+    translation = interpolations.count === 1 ? translation.one ?? translation.other : translation.other
+  }
+
+  if (typeof translation !== "string") return key
+
+  return translation.replace(/%\{(\w+)\}/g, (match, name) => name in interpolations ? interpolations[name] : match)
+}
+
+export function locale() {
+  return document.documentElement.lang || "en"
+}
+
+export function intlLocale() {
+  const current = locale()
+  return current === "en" ? "en-US" : current
+}
