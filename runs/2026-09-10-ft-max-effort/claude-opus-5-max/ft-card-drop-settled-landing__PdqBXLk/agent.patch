+++ b/app/helpers/drag_and_drop_helper.rb
@@ -0,0 +1,10 @@
+module DragAndDropHelper
+  # Columns are rendered before knowing which card will be dropped on them, so their drop
+  # URLs are built for this placeholder card. The drag-and-drop Stimulus controller replaces
+  # it with the id of the card being dropped.
+  DRAGGED_ITEM_ID = "DRAGGED_ITEM_ID"
+
+  def dragged_card
+    DRAGGED_ITEM_ID
+  end
+end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..aa3da34
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,173 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Drags items from one container into another.
+//
+// Dropped items move right away and are saved in the background, so the board is left exactly
+// as it was dropped: there is nothing to wait for and nothing shifts around once an item has
+// landed. Containers keep their own order, so items land on top of their new container instead
+// of wherever they were released. Items that can't be saved go back where they came from.
+//
+// Containers are rendered before knowing which item will be dropped on them, so they declare
+// where their items are saved with an URL carrying the DRAGGED_ITEM_ID placeholder, replaced
+// with the id of the item being dropped:
+//
+//   <section data-drag-and-drop-target="container"
+//            data-drag-and-drop-url="/cards/DRAGGED_ITEM_ID/triage?column_id=1"
+//            data-drag-and-drop-method="post">
+//     <span data-drag-and-drop-target="count">1</span>
+//     <div data-drag-and-drop-target="list">
+//       <article draggable="true" data-drag-and-drop-target="item" data-drag-and-drop-id="99">
+const DRAGGED_ITEM_ID = "DRAGGED_ITEM_ID"
+
+const ITEM_SELECTOR = "[data-drag-and-drop-target~='item']"
+const CONTAINER_SELECTOR = "[data-drag-and-drop-target~='container']"
+const LIST_SELECTOR = "[data-drag-and-drop-target~='list']"
+const COUNT_SELECTOR = "[data-drag-and-drop-target~='count']"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "item", "container", "list", "count" ]
+
+  initialize() {
+    this.draggedItem = null
+    this.draggedItemContainer = null
+  }
+
+  disconnect() {
+    this.#stopDragging()
+  }
+
+  start(event) {
+    const item = this.#itemFrom(event)
+
+    if (item) {
+      this.#startDragging(item, event.dataTransfer)
+    }
+  }
+
+  over(event) {
+    const container = this.#dropContainerFrom(event)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#hoverOver(container)
+  }
+
+  leave(event) {
+    if (!this.element.contains(event.relatedTarget)) {
+      this.#hoverOver(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.#dropContainerFrom(event)
+
+    if (container) {
+      event.preventDefault()
+      this.#dropItem(this.draggedItem, container)
+    }
+  }
+
+  end() {
+    this.#stopDragging()
+  }
+
+  // Private
+
+  #startDragging(item, dataTransfer) {
+    this.draggedItem = item
+    this.draggedItemContainer = this.#containerFor(item)
+
+    dataTransfer.clearData()
+    dataTransfer.setData("text/plain", item.id)
+    dataTransfer.effectAllowed = "move"
+
+    this.#dimDraggedItem(item)
+  }
+
+  async #dimDraggedItem(item) {
+    await nextFrame() // Let the browser take the drag image before dimming the item
+
+    if (this.draggedItem === item) {
+      item.classList.add(this.draggedItemClass)
+    }
+  }
+
+  async #dropItem(item, container) {
+    const previousContainer = this.#containerFor(item)
+    this.#moveItem(item, container)
+
+    if (!await this.#saveMove(item, container)) {
+      this.#moveItem(item, previousContainer)
+    }
+  }
+
+  #moveItem(item, container) {
+    const previousContainer = this.#containerFor(item)
+
+    this.#listIn(container).prepend(item)
+
+    this.#recount(previousContainer, -1)
+    this.#recount(container, +1)
+  }
+
+  #recount(container, difference) {
+    const count = container?.querySelector(COUNT_SELECTOR)
+
+    if (/^\d+$/.test(count?.textContent)) {
+      count.textContent = Number(count.textContent) + difference
+    }
+  }
+
+  async #saveMove(item, container) {
+    const { dragAndDropUrl: url, dragAndDropMethod: method } = container.dataset
+    const request = new FetchRequest(method, url.replace(DRAGGED_ITEM_ID, item.dataset.dragAndDropId), { responseKind: "json" })
+
+    try {
+      const response = await request.perform()
+      return response.ok
+    } catch {
+      return false
+    }
+  }
+
+  #stopDragging() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.draggedItem = null
+    this.draggedItemContainer = null
+
+    this.#hoverOver(null)
+  }
+
+  #hoverOver(container) {
+    this.containerTargets.forEach(target => target.classList.toggle(this.hoverContainerClass, target === container))
+  }
+
+  #itemFrom({ target }) {
+    const item = target.closest?.(ITEM_SELECTOR)
+    return this.itemTargets.includes(item) ? item : null
+  }
+
+  #dropContainerFrom({ target }) {
+    const container = target.closest?.(CONTAINER_SELECTOR)
+    return this.#canDrop(container) ? container : null
+  }
+
+  #canDrop(container) {
+    return this.draggedItem && this.containerTargets.includes(container) &&
+      container !== this.draggedItemContainer && this.#listIn(container)
+  }
+
+  #containerFor(item) {
+    return item.closest(CONTAINER_SELECTOR)
+  }
+
+  #listIn(container) {
+    return container.querySelector(LIST_SELECTOR)
+  }
+}
