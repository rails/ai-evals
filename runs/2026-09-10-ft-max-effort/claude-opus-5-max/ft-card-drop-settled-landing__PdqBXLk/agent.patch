diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..605fdc0
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,216 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @column = columns(:writebook_review)
+  end
+
+  test "dragging a card into a column triages it there" do
+    card = cards(:buy_domain)
+    visit board_url(@board)
+    assert_selector "#maybe article.card", text: card.title
+
+    assert_equal dom_id(@column), drag(card, to: column_selector(@column)),
+      "The card should be in its new column as soon as it's dropped"
+
+    assert_selector "#{column_selector(@column)} article.card", text: card.title, visible: :all
+    assert_no_selector "#maybe article.card", text: card.title
+    assert_saved { assert_equal @column, card.reload.column }
+  end
+
+  test "dragging a card between columns" do
+    card = cards(:text)
+    visit board_url(@board)
+    assert_selector "#{column_selector(card.column)} article.card", text: card.title, visible: :all
+
+    assert_equal dom_id(@column), drag(card, to: column_selector(@column))
+
+    assert_no_selector "#{column_selector(card.column)} article.card", text: card.title, visible: :all
+    assert_saved { assert_equal @column, card.reload.column }
+  end
+
+  test "dragging a card into Not Now postpones it" do
+    card = cards(:logo)
+    visit board_url(@board)
+    assert_selector "#{column_selector(card.column)} article.card", text: card.title, visible: :all
+
+    assert_equal "not-now", drag(card, to: "#not-now")
+
+    assert_saved { assert card.reload.postponed? }
+  end
+
+  test "dragging a card into Done closes it" do
+    card = cards(:logo)
+    visit board_url(@board)
+    assert_selector "#{column_selector(card.column)} article.card", text: card.title, visible: :all
+
+    assert_equal "closed-cards", drag(card, to: "#closed-cards")
+
+    assert_saved { assert card.reload.closed? }
+  end
+
+  test "dragging a card into Maybe? sends it back to triage" do
+    card = cards(:logo)
+    visit board_url(@board)
+    assert_selector "#{column_selector(card.column)} article.card", text: card.title, visible: :all
+
+    assert_equal "maybe", drag(card, to: "#maybe")
+
+    assert_selector "#maybe article.card", text: card.title
+    assert_saved { assert card.reload.awaiting_triage? }
+  end
+
+  test "dropping a card on the column it came from leaves it alone" do
+    card = cards(:buy_domain)
+    visit board_url(@board)
+    assert_selector "#maybe article.card", text: card.title
+
+    assert_equal "maybe", drag(card, to: "#maybe")
+
+    assert_selector "#maybe article.card", text: card.title
+    assert_no_changes -> { card.reload.updated_at } do
+      sleep 0.5
+    end
+  end
+
+  test "the columns count the card where it was dropped" do
+    card = cards(:layout)
+    visit board_url(@board)
+    assert_selector "#{column_selector(card.column)} .cards__expander-count", text: "2"
+    assert_selector "#{column_selector(@column)} .cards__expander-count", text: "0"
+
+    drag card, to: column_selector(@column)
+
+    assert_selector "#{column_selector(card.column)} .cards__expander-count", text: "1"
+    assert_selector "#{column_selector(@column)} .cards__expander-count", text: "1"
+  end
+
+  test "the board renders a dropped card right where it was left" do
+    card = cards(:buy_domain)
+    visit board_url(@board)
+    wait_for_cable_subscriptions
+
+    drag card, to: column_selector(@column)
+    assert_saved { assert_equal @column, card.reload.column }
+
+    refresh_board_from_elsewhere
+
+    assert_selector "#{column_selector(@column)} .cards__expander-count", text: "1"
+    assert_selector "#{column_selector(@column)} article.card", text: card.title, visible: :all
+    assert_no_selector "#maybe article.card", text: card.title
+  end
+
+  test "a card that can't be saved goes back where it came from" do
+    card = cards(:buy_domain)
+    visit board_url(@board)
+    assert_selector "#maybe article.card", text: card.title
+
+    break_saving_into @column
+    drag card, to: column_selector(@column)
+
+    assert_selector "#maybe article.card", text: card.title
+    assert_no_selector "#{column_selector(@column)} article.card", text: card.title, visible: :all
+    assert_nil card.reload.column
+  end
+
+  test "the column under the pointer lights up and the dragged card dims" do
+    card = cards(:buy_domain)
+    visit board_url(@board)
+    assert_selector "#maybe article.card", text: card.title
+
+    start_dragging card
+    assert_selector "#{card_selector(card)}.drag-and-drop__dragged-item"
+
+    drag_over column_selector(@column)
+    assert_selector "#{column_selector(@column)}.drag-and-drop__hover-container"
+
+    drag_over "#not-now"
+    assert_selector "#not-now.drag-and-drop__hover-container"
+    assert_no_selector "#{column_selector(@column)}.drag-and-drop__hover-container"
+
+    stop_dragging card
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_no_selector ".drag-and-drop__dragged-item"
+  end
+
+  private
+    def card_selector(card)
+      "##{dom_id(card, :article)}"
+    end
+
+    def column_selector(column)
+      "##{dom_id(column)}"
+    end
+
+    # Selenium can't perform native HTML5 drags, so we dispatch the drag events ourselves.
+    # Returns the column holding the card right after the drop, before anything was saved.
+    def drag(card, to:)
+      evaluate_script <<~JS, find(card_selector(card), visible: :all), find(to, visible: :all)
+        (function(card, container) {
+          const options = { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }
+
+          card.dispatchEvent(new DragEvent("dragstart", options))
+          container.dispatchEvent(new DragEvent("dragenter", options))
+          container.dispatchEvent(new DragEvent("dragover", options))
+          container.dispatchEvent(new DragEvent("dragleave", options))
+          container.dispatchEvent(new DragEvent("drop", options))
+
+          const column = card.closest("section.cards").id
+          card.dispatchEvent(new DragEvent("dragend", options))
+
+          return column
+        })(arguments[0], arguments[1])
+      JS
+    end
+
+    def start_dragging(card)
+      execute_script <<~JS, find(card_selector(card), visible: :all)
+        window.dragOptions = { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }
+        arguments[0].dispatchEvent(new DragEvent("dragstart", window.dragOptions))
+      JS
+    end
+
+    def drag_over(selector)
+      execute_script <<~JS, find(selector, visible: :all)
+        arguments[0].dispatchEvent(new DragEvent("dragover", window.dragOptions))
+      JS
+    end
+
+    def stop_dragging(card)
+      execute_script <<~JS, find(card_selector(card), visible: :all)
+        arguments[0].dispatchEvent(new DragEvent("dragend", window.dragOptions))
