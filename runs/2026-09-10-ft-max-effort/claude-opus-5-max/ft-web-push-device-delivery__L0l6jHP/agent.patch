--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,28 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :push_later, on: %i[ create update ], if: :landed_in_tray?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if Push.enabled?
+  end
+
+  def push_now
+    user.push_subscriptions.each { |subscription| subscription.deliver(push_payload) } if pushable?
+  end
+
+  private
+    def landed_in_tray?
+      previously_new_record? || source_id_previously_changed?
+    end
+
+    def pushable?
+      !read? && source.present?
+    end
+
+    def push_payload
+      Push::Payload.new(self)
+    end
+end
