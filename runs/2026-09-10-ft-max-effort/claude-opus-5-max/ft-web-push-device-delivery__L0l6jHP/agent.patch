@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @subscription = subscribe_device(@kevin)
+    @push = stub_request(:post, @subscription.endpoint).to_return(status: 201)
+  end
+
+  test "landing in the tray pushes to the devices subscribed" do
+    notifications(:layout_commented_kevin).destroy
+
+    perform_enqueued_jobs do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+
+    assert_requested @push
+  end
+
+  test "commenting on a card someone watches reaches their devices" do
+    Current.session = sessions(:david)
+
+    perform_enqueued_jobs do
+      cards(:layout).comments.create!(body: "Ship it")
+    end
+
+    assert_requested @push
+  end
+
+  test "pushes to every device someone subscribed" do
+    phone = subscribe_device(@kevin, endpoint: "https://push.example.com/kevin-phone")
+    push_to_phone = stub_request(:post, phone.endpoint).to_return(status: 201)
+
+    notifications(:layout_commented_kevin).push_now
+
+    assert_requested @push
+    assert_requested push_to_phone
+  end
+
+  test "a repeated notification pushes again" do
+    perform_enqueued_jobs do
+      notifications(:layout_commented_kevin).update!(source: events(:layout_published), read_at: nil)
+    end
+
+    assert_requested @push
+  end
+
+  test "nothing is pushed without a VAPID key pair" do
+    Push.stubs(:enabled?).returns(false)
+
+    perform_enqueued_jobs do
+      notifications(:layout_commented_kevin).update!(source: events(:layout_published), read_at: nil)
+    end
+
+    assert_not_requested @push
+  end
+
+  test "marking as read doesn't push" do
+    perform_enqueued_jobs do
+      notifications(:layout_commented_kevin).read
+    end
+
+    assert_not_requested @push
+  end
+
+  test "read notifications aren't pushed" do
+    notification = notifications(:layout_commented_kevin)
+    notification.read
+
+    notification.push_now
+
+    assert_not_requested @push
+  end
+
+  test "pushing without any subscribed device does nothing" do
+    @kevin.push_subscriptions.destroy_all
+
+    notifications(:layout_commented_kevin).push_now
+
+    assert_not_requested @push
+  end
+
+  private
+    def subscribe_device(user, endpoint: "https://push.example.com/#{user.name.downcase}-laptop")
+      user.push_subscriptions.create! \
+        endpoint: endpoint,
+        p256dh_key: "BK3j0ZKEXCdvq8MTNZkDVa1PLVsnONuFZEihBEVWV3Mg5cvWTLWp83idejoRnR2zk0nCs48lxidKD5uzHCD18T4=",
+        auth_key: "MrQd4LeEQjU-5H2sE3Fhog"
+    end
+end
