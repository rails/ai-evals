@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Push::PayloadTest < ActiveSupport::TestCase
+  test "says what the tray says about an event" do
+    notification = notifications(:layout_commented_kevin)
+    payload = Push::Payload.new(notification)
+
+    assert_equal helpers.event_notification_title(notification.source), payload.title
+    assert_equal helpers.event_notification_body(notification.source), payload.body
+  end
+
+  test "says what the tray says about a mention" do
+    notification = notifications(:logo_mentioned_david)
+    payload = Push::Payload.new(notification)
+
+    assert_equal "JZ @mentioned you", payload.title
+    assert_equal notification.source.source.mentionable_content.truncate(200), payload.body
+  end
+
+  test "opens the card the notification is about" do
+    notification = notifications(:layout_commented_kevin)
+    payload = Push::Payload.new(notification)
+
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}##{dom_id(notification.source.eventable)}", payload.path
+  end
+
+  test "replaces the notification a card already pushed" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_equal dom_id(notification.card), Push::Payload.new(notification).tag
+  end
+
+  test "serializes to JSON for the service worker" do
+    notification = notifications(:layout_commented_kevin)
+    payload = JSON.parse(Push::Payload.new(notification).to_json)
+
+    assert_equal %w[ title body tag path ], payload.keys
+  end
+
+  private
+    def helpers
+      ApplicationController.helpers
+    end
+
+    def dom_id(record)
+      ActionView::RecordIdentifier.dom_id(record)
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..01d460f
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = subscribe_device(users(:david))
+    @payload = Push::Payload.new(notifications(:layout_commented_kevin))
+  end
+
+  test "deliver pushes the payload to the push service" do
+    request = stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+    @subscription.deliver(@payload)
+
+    assert_requested request
+  end
+
+  test "deliver signs the push with the VAPID key pair" do
+    request = stub_request(:post, @subscription.endpoint)
+      .with { |request| request.headers["Authorization"].start_with?("vapid t=") }.to_return(status: 201)
+
+    @subscription.deliver(@payload)
+
+    assert_requested request
+  end
+
+  test "deliver forgets devices the push service has expired" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(@payload)
+    end
+  end
+
+  test "deliver forgets devices the push service doesn't know" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 404)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(@payload)
+    end
+  end
+
+  test "deliver keeps devices around when the push service is down" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 500)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      assert_raises(WebPush::PushServiceError) { @subscription.deliver(@payload) }
+    end
+  end
+
+  test "deliver does nothing without a VAPID key pair" do
+    request = stub_request(:post, @subscription.endpoint)
+    Push.stubs(:enabled?).returns(false)
+
+    @subscription.deliver(@payload)
+
+    assert_not_requested request
+  end
+
+  test "a device can only subscribe once per user" do
+    duplicate = users(:david).push_subscriptions.new(
+      endpoint: @subscription.endpoint, p256dh_key: "p256dh-key", auth_key: "auth-key")
+
+    assert_not duplicate.valid?
+  end
+
+  test "the same device can subscribe for different users" do
+    subscription = users(:kevin).push_subscriptions.new(
+      endpoint: @subscription.endpoint, p256dh_key: "p256dh-key", auth_key: "auth-key")
+
+    assert subscription.valid?
+  end
+
+  test "subscribing requires the keys the push service handed the browser" do
+    assert_not users(:david).push_subscriptions.new(endpoint: "https://push.example.com/new-device").valid?
+  end
+
+  test "account comes from the subscribing user" do
+    assert_equal users(:david).account, @subscription.account
+  end
+
+  private
+    def subscribe_device(user, endpoint: "https://push.example.com/#{user.name.downcase}-laptop")
+      user.push_subscriptions.create! \
+        endpoint: endpoint,
+        p256dh_key: "BK3j0ZKEXCdvq8MTNZkDVa1PLVsnONuFZEihBEVWV3Mg5cvWTLWp83idejoRnR2zk0nCs48lxidKD5uzHCD18T4=",
+        auth_key: "MrQd4LeEQjU-5H2sE3Fhog"
+    end
+end
