diff --git a/app/models/push/payload.rb b/app/models/push/payload.rb
new file mode 100644
index 0000000..5c1d1e1
--- /dev/null
+++ b/app/models/push/payload.rb
@@ -0,0 +1,45 @@
+# The message a push carries: it says what the tray says, and opens the card the
+# notification is about.
+class Push::Payload
+  attr_reader :notification
+
+  delegate :card, :account, to: :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def title
+    helpers.notification_title(notification)
+  end
+
+  def body
+    helpers.notification_body(notification)
+  end
+
+  # Cards replace their own notification on the device, rather than stacking up.
+  def tag
+    ActionView::RecordIdentifier.dom_id(card)
+  end
+
+  def path
+    routes.polymorphic_path(notification.notifiable_target, script_name: account.slug, only_path: true)
+  end
+
+  def to_h
+    { title: title, body: body, tag: tag, path: path }
+  end
+
+  def to_json(...)
+    to_h.to_json(...)
+  end
+
+  private
+    def helpers
+      ApplicationController.helpers
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..e24d7c7
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,30 @@
+# A device that agreed to receive push notifications, as handed to us by the
+# browser's push service.
+class Push::Subscription < ApplicationRecord
+  TIME_TO_LIVE = 1.day
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  before_validation :set_user_agent
+
+  def deliver(payload)
+    if Push.enabled?
+      WebPush.payload_send \
+        message: payload.to_json,
+        endpoint: endpoint, p256dh: p256dh_key, auth: auth_key,
+        vapid: Push.vapid.to_h,
+        urgency: "high", ttl: TIME_TO_LIVE.to_i
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy # The push service has forgotten this device, so we can forget it too.
+  end
+
+  private
+    def set_user_agent
+      self.user_agent = Current.user_agent if Current.user_agent.present?
+    end
+end
