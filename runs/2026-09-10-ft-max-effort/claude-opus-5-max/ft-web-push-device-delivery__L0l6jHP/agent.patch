diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..90f5b85
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,91 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Subscribes this device to push notifications, so whatever lands in the tray
+// also reaches the phone or the desktop it's read on.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "details", "enableButton" ]
+  static values = { url: String, publicKey: String }
+
+  connect() {
+    this.#refresh()
+  }
+
+  async enable() {
+    if (this.#supported && await this.#permissionGranted) {
+      await this.#subscribe()
+    }
+
+    this.#refresh()
+  }
+
+  // Handing the subscription over on every visit keeps the keys the push service
+  // gave this browser in sync with the ones we push with.
+  async #refresh() {
+    const subscription = await this.#subscription
+
+    if (subscription) {
+      await this.#remember(subscription)
+    }
+
+    this.#render(subscription)
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+
+    try {
+      await registration.pushManager.subscribe(this.#subscribeOptions)
+    } catch {
+      // The browser is holding a subscription made with another key: replace it.
+      await (await registration.pushManager.getSubscription())?.unsubscribe()
+      await registration.pushManager.subscribe(this.#subscribeOptions)
+    }
+  }
+
+  async #remember(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    await post(this.urlValue, {
+      body: { push_subscription: { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+  }
+
+  #render(on) {
+    this.element.classList.toggle(this.onClass, !!on)
+    this.detailsTargets.forEach(details => details.hidden = !!on)
+    this.enableButtonTargets.forEach(button => button.hidden = !!on || this.#blocked)
+  }
+
+  get #subscription() {
+    if (this.#supported && Notification.permission === "granted") {
+      return navigator.serviceWorker.ready.then(registration => registration.pushManager.getSubscription())
+    } else {
+      return Promise.resolve(null)
+    }
+  }
+
+  get #subscribeOptions() {
+    return { userVisibleOnly: true, applicationServerKey: this.#applicationServerKey }
+  }
+
+  get #permissionGranted() {
+    return Notification.requestPermission().then(permission => permission === "granted")
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #blocked() {
+    return !this.#supported || Notification.permission === "denied"
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replaceAll("-", "+").replaceAll("_", "/")
+
+    return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")), character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
index 0000000..4053290
--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,13 @@
+class Notification::PushJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  # Push services go down and rate limit us, so try again later.
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, wait: :polynomially_longer
+  retry_on Net::OpenTimeout, Net::ReadTimeout, SocketError, wait: :polynomially_longer
+
+  def perform(notification)
+    notification.push_now
+  end
+end
