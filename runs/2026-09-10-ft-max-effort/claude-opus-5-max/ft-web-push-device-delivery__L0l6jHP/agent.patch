diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..fcb2892
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,17 @@
+# Web push notifications are signed with a VAPID key pair that ops provides
+# through the VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY environment variables.
+#
+# When they are missing, we generate a throwaway pair for local development and
+# testing, so push works without any setup, and leave push turned off otherwise.
+Rails.application.configure do
+  config.x.vapid.public_key  = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+  config.x.vapid.subject     = ENV["VAPID_SUBJECT"].presence || ENV["BASE_URL"].presence || "https://fizzy.do"
+
+  if config.x.vapid.public_key.blank? && Rails.env.local?
+    WebPush.generate_key.then do |key|
+      config.x.vapid.public_key  = key.public_key
+      config.x.vapid.private_key = key.private_key
+    end
+  end
+end
