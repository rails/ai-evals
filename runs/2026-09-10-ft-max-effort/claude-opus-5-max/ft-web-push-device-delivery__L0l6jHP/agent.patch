--- /dev/null
+++ b/lib/tasks/push.rake
@@ -0,0 +1,9 @@
+namespace :push do
+  desc "Generate the VAPID key pair used to sign web push notifications"
+  task vapid_keys: :environment do
+    WebPush.generate_key.then do |key|
+      puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+      puts "VAPID_PRIVATE_KEY=#{key.private_key}"
+    end
+  end
+end
