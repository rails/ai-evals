diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..54bf3bf
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "create subscribes this device" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), headers: { "User-Agent" => "Firefox" },
+        params: { push_subscription: { endpoint: "https://push.example.com/new-device", p256dh_key: "p256dh-key", auth_key: "auth-key" } }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.order(:created_at).last
+    assert_equal "https://push.example.com/new-device", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal "Firefox", subscription.user_agent
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), as: :json,
+        params: { push_subscription: { endpoint: "https://push.example.com/new-device", p256dh_key: "p256dh-key", auth_key: "auth-key" } }
+    end
+
+    assert_response :created
+  end
+
+  test "create with flat JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), as: :json,
+        params: { endpoint: "https://push.example.com/new-device", p256dh_key: "p256dh-key", auth_key: "auth-key" }
+    end
+
+    assert_response :created
+  end
+
+  test "create refreshes the keys of a device we already know" do
+    subscription = subscribe_device(@user)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: { endpoint: subscription.endpoint, p256dh_key: "rotated-p256dh-key", auth_key: "rotated-auth-key" } }
+    end
+
+    assert_response :created
+    assert_equal "rotated-p256dh-key", subscription.reload.p256dh_key
+    assert_equal "rotated-auth-key", subscription.auth_key
+  end
+
+  test "create requires the subscription the push service handed us" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "" } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create for someone else is forbidden" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)),
+        params: { push_subscription: { endpoint: "https://push.example.com/new-device", p256dh_key: "p256dh-key", auth_key: "auth-key" } }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy unsubscribes this device" do
+    subscription = subscribe_device(@user)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy for someone else is forbidden" do
+    subscription = subscribe_device(users(:kevin))
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(users(:kevin), subscription)
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscribe_device(user)
+      user.push_subscriptions.create! \
+        endpoint: "https://push.example.com/#{user.name.downcase}-laptop",
+        p256dh_key: "BK3j0ZKEXCdvq8MTNZkDVa1PLVsnONuFZEihBEVWV3Mg5cvWTLWp83idejoRnR2zk0nCs48lxidKD5uzHCD18T4=",
+        auth_key: "MrQd4LeEQjU-5H2sE3Fhog"
+    end
+end
