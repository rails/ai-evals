new file mode 100644
index 0000000..5749f28
--- /dev/null
+++ b/test/integration/notification_bundles_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class NotificationBundlesTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @creator = users(:david)
+    @recipient = users(:kevin)
+    @recipient.notifications.destroy_all
+    @recipient.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    Current.user = @creator
+  end
+
+  test "a batch of notifications turns into a single email when the window closes" do
+    notify_about cards(:logo), cards(:layout)
+
+    assert_equal 1, Notification::Bundle.where(user: @recipient).count
+    assert_equal 2, @recipient.notifications.count
+
+    assert_emails 1 do
+      travel 4.hours
+      perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @recipient.identity.email_address ], email.to
+    assert_match ERB::Util.html_escape(cards(:logo).title), email.html_part.body.to_s
+    assert_match ERB::Util.html_escape(cards(:layout).title), email.html_part.body.to_s
+  end
+
+  test "the next notification opens a fresh window after the email went out" do
+    notify_about cards(:logo)
+    travel 4.hours
+    perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+
+    assert_empty Notification::Bundle.where(user: @recipient)
+
+    assert_emails 1 do
+      notify_about cards(:layout)
+
+      assert_equal 1, Notification::Bundle.where(user: @recipient).count
+
+      travel 4.hours
+      perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+    end
+  end
+
+  test "nothing is emailed to people who keep their notifications unbundled" do
+    @recipient.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_emails do
+      notify_about cards(:logo), cards(:layout)
+
+      perform_enqueued_jobs
+    end
+
+    assert_empty Notification::Bundle.where(user: @recipient)
+  end
+
+  private
+    def notify_about(*cards)
+      perform_enqueued_jobs only: [ NotifyRecipientsJob, Mention::CreateJob ] do
+        cards.each do |card|
+          card.watch_by(@recipient)
+          card.comments.create!(body: "Something happened on #{card.title}", creator: @creator)
+        end
+      end
+    end
+end
diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
