@@ -0,0 +1,45 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @bundle = Notification::Bundle.open_for(@user)
+    @user.notifications.each { |notification| @bundle.add(notification) }
+  end
+
+  test "bundle gathers every notification into one email" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "3 new notifications in 37signals", email.subject
+
+    @bundle.notifications.each do |notification|
+      assert_match notification.card.board.name, email.html_part.body.to_s
+      assert_match ERB::Util.html_escape(notification.payload.title), email.html_part.body.to_s
+      assert_match notification.card.board.name, email.text_part.body.to_s
+    end
+  end
+
+  test "bundle links to the cards and to the notification settings" do
+    email = NotificationMailer.bundle(@bundle)
+    body = email.html_part.body.to_s
+
+    @bundle.notifications.each do |notification|
+      assert_match notification.payload.url, body
+    end
+
+    assert_match "#{@user.account.slug}/notifications/settings", body
+  end
+
+  test "bundle groups notifications by board" do
+    email = NotificationMailer.bundle(@bundle)
+    boards = @bundle.notifications.map { |notification| notification.card.board }.uniq
+
+    assert_equal boards.size, email.html_part.body.to_s.scan("notification__board\"").size
+  end
+end
