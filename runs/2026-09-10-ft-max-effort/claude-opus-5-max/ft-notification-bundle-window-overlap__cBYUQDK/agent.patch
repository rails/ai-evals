@@ -0,0 +1,38 @@
+<h1 class="title">Your Fizzy notifications</h1>
+<p class="subtitle">Here's what you missed in <%= @account.name %>.</p>
+
+<% notifications_by_board.each_with_index do |(board, notifications), index| %>
+  <% if index.positive? %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board, script_name: @account.slug) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+
+    <table class="notification">
+      <tr>
+        <td class="avatar__container"><%= mail_avatar_tag notification.creator %></td>
+        <td>
+          <p class="card__title">
+            <%= link_to payload.url do %>
+              <% if notification.source.is_a?(Mention) %>
+                <span class="notificaton__mention"><%= payload.title %></span>
+              <% else %>
+                <%= payload.title %>
+              <% end %>
+            <% end %>
+          </p>
+          <p class="notification__author"><%= notification.creator.name %></p>
+          <p class="notification__details"><%= payload.body %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer margin-block-start-double">
+  You're getting these emails <%= User::Settings::BUNDLE_EMAIL_FREQUENCY_NAMES[@user.bundle_email_frequency].downcase %>.
+  <%= link_to "Change how often", notifications_settings_url(script_name: @account.slug) %>.
+</p>
