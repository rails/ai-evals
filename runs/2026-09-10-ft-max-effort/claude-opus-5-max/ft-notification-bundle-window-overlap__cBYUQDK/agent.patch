+
+  test "update rejects unknown frequencies" do
+    patch notifications_settings_path, params: { user_settings: { bundle_email_frequency: "hourly" } }
+
+    assert_response :unprocessable_entity
+    assert_equal "never", @user.settings.reload.bundle_email_frequency
+  end
 end
