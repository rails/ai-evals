@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Board::StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "card images count" do
+    assert_difference -> { bytes_used_of(@board) }, +file_size do
+      counting { @card.image.attach(image_file) }
+    end
+  end
+
+  test "files embedded in card descriptions count" do
+    assert_difference -> { bytes_used_of(@board) }, +file_size do
+      counting { @card.update! description: embedding("Look at this") }
+    end
+  end
+
+  test "files embedded in comments count" do
+    assert_difference -> { bytes_used_of(@board) }, +file_size do
+      counting { @card.comments.create! creator: users(:david), body: embedding("Here you go") }
+    end
+  end
+
+  test "files embedded in the board description count" do
+    assert_difference -> { bytes_used_of(@board) }, +file_size do
+      counting { @board.update! public_description: embedding("Welcome") }
+    end
+  end
+
+  test "avatars and image variants don't count" do
+    assert_no_difference -> { bytes_used_of(@board) } do
+      counting { users(:david).avatar.attach(image_file) }
+    end
+
+    counting { @card.update! description: embedding("Look at this") }
+
+    assert_equal file_size, bytes_used_of(@board), "only the embedded file itself counts"
+  end
+
+  test "removing a card image stops counting it" do
+    counting { @card.image.attach(image_file) }
+
+    assert_difference -> { bytes_used_of(@board) }, -file_size do
+      counting { @card.image.purge_later }
+    end
+  end
+
+  test "removing a file from a description stops counting it" do
+    counting { @card.update! description: embedding("Look at this") }
+
+    assert_difference -> { bytes_used_of(@board) }, -file_size do
+      counting { @card.update! description: "Never mind" }
+    end
+  end
+
+  test "destroying a card stops counting its files" do
+    counting do
+      @card.image.attach(image_file)
+      @card.comments.create! creator: users(:david), body: embedding("Here you go")
+    end
+
+    assert_difference -> { bytes_used_of(@board) }, -2 * file_size do
+      counting { @card.destroy }
+    end
+  end
+
+  test "destroying a comment stops counting its files" do
+    comment = nil
+    counting { comment = @card.comments.create!(creator: users(:david), body: embedding("Here you go")) }
+
+    assert_difference -> { bytes_used_of(@board) }, -file_size do
+      counting { comment.destroy }
+    end
+  end
+
+  test "moving a card moves its files to the other board" do
+    other_board = boards(:private)
+    counting { @card.image.attach(image_file) }
+
+    assert_difference -> { bytes_used_of(other_board) }, +file_size do
+      assert_difference -> { bytes_used_of(@board) }, -file_size do
+        counting { with_current_user(:david) { @card.move_to(other_board) } }
+      end
+    end
+  end
+
+  test "recalculating repairs a count that drifted" do
+    counting { @card.image.attach(image_file) }
+    @board.update_columns bytes_used: 42.megabytes, bytes_used_calculated_at: nil
+
+    @board.recalculate_bytes_used_now
+
+    assert_equal file_size, bytes_used_of(@board)
+  end
+
+  test "skipping recalculations that a later count already covered" do
+    counting { @card.image.attach(image_file) }
+
+    already_counted = Board::RecalculateBytesUsedJob.new(@board)
+    already_counted.enqueued_at = bytes_used_calculated_at_of(@board) - 1.second
+
+    Board.any_instance.expects(:recalculate_bytes_used_now).never
+    already_counted.perform_now
+  end
+
+  test "files on one board aren't counted on another" do
+    counting { @card.image.attach(image_file) }
+
+    assert_equal file_size, bytes_used_of(@board)
+    assert_equal 0, bytes_used_of(boards(:private))
+  end
+
+  test "counting a board with nothing stored" do
+    assert_equal 0, boards(:private).bytes_used
+
+    boards(:private).recalculate_bytes_used_now
+
+    assert_equal 0, bytes_used_of(boards(:private))
+  end
+
+  private
+    # Counts run in the background: make the changes, then let the jobs catch up.
+    def counting
+      yield
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+
+    def bytes_used_of(board)
+      board.reload.bytes_used
+    end
+
+    def bytes_used_calculated_at_of(board)
+      board.reload.bytes_used_calculated_at
+    end
+
+    def image_file
+      { io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg" }
+    end
