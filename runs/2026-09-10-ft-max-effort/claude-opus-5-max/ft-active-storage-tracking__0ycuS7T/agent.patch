diff --git a/app/models/board/storage_usage.rb b/app/models/board/storage_usage.rb
new file mode 100644
index 0000000..70ebdea
--- /dev/null
+++ b/app/models/board/storage_usage.rb
@@ -0,0 +1,45 @@
+# A board stores the images on its cards and the files embedded in its description, in its cards'
+# descriptions, and in their comments. Nothing else counts: not avatars, not exports, and not the
+# variants Active Storage derives from what people upload.
+#
+# Counting runs in the background, and the total is kept on the board, so uploads never wait on it
+# and reading a board's usage — or an account's — stays cheap however much is stored.
+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  # Note the time before counting, not after, so that a change committed while we count is never
+  # mistaken for one this count covered.
+  def recalculate_bytes_used_now
+    calculated_at = Time.current
+
+    update_columns bytes_used: calculate_bytes_used, bytes_used_calculated_at: calculated_at
+  end
+
+  def bytes_used_calculated_since?(time)
+    time.present? && bytes_used_calculated_at.present? && bytes_used_calculated_at > time
+  end
+
+  private
+    def calculate_bytes_used
+      stored_files.sum(:byte_size)
+    end
+
+    def stored_files
+      ActiveStorage::Blob.where(id: stored_attachments.select(:blob_id))
+    end
+
+    def stored_attachments
+      ActiveStorage::Attachment.card_images.where(record_id: cards.select(:id))
+        .or(ActiveStorage::Attachment.embedded_files.where(record_id: rich_texts.select(:id)))
+    end
+
+    def rich_texts
+      ActionText::RichText.where(record: self)
+        .or(ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id)))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id)))
+    end
+end
