+++ b/test/models/account/storage_usage_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Account::StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "an account counts what all of its boards store" do
+    counting do
+      cards(:logo).image.attach(image_file)
+      boards(:private).update! public_description: embedding("Welcome")
+    end
+
+    assert_equal 2 * file_size, @account.bytes_used
+    assert_equal file_size, boards(:writebook).reload.bytes_used
+    assert_equal file_size, boards(:private).reload.bytes_used
+  end
+
+  test "other accounts are unaffected" do
+    assert_no_difference -> { accounts(:initech).bytes_used } do
+      counting { cards(:logo).image.attach(image_file) }
+    end
+  end
+
+  test "destroying a board stops counting what it stored" do
+    counting { cards(:logo).image.attach(image_file) }
+
+    assert_difference -> { @account.bytes_used }, -file_size do
+      boards(:writebook).destroy
+    end
+  end
+
+  test "recounting every board repairs counts that drifted" do
+    counting { cards(:logo).image.attach(image_file) }
+    boards(:writebook).update_columns bytes_used: 42.megabytes, bytes_used_calculated_at: nil
+
+    counting { @account.recalculate_bytes_used_later }
+
+    assert_equal file_size, @account.bytes_used
+  end
+
+  private
+    # Counts run in the background: make the changes, then let the jobs catch up.
+    def counting
+      yield
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+
+    def image_file
+      { io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg" }
+    end
+
+    def file_size
+      file_fixture("moon.jpg").size
+    end
+
+    def embedding(text)
+      blob = ActiveStorage::Blob.create_and_upload!(**image_file)
+      %(#{text} <action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
