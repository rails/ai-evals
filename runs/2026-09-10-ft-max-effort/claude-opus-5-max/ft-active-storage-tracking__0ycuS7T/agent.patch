index 0000000..ee57210
--- /dev/null
+++ b/app/jobs/board/recalculate_bytes_used_job.rb
@@ -0,0 +1,11 @@
+class Board::RecalculateBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Files arrive in bursts on a busy board, one job apiece. Counting a board once at a time keeps
+  # those recalculations from stacking up on each other.
+  limits_concurrency to: 1, key: ->(board) { board }
+
+  def perform(board)
+    board.recalculate_bytes_used_now unless board.bytes_used_calculated_since?(enqueued_at)
+  end
+end
