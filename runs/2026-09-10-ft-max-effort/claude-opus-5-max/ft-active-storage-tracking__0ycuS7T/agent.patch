diff --git a/app/models/card/storage_usage.rb b/app/models/card/storage_usage.rb
new file mode 100644
index 0000000..821d44d
--- /dev/null
+++ b/app/models/card/storage_usage.rb
@@ -0,0 +1,25 @@
+module Card::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_previous_board, if: :board_id_changed?
+    after_update_commit :recalculate_bytes_used_of_both_boards_later, if: :moved_between_boards?
+  end
+
+  private
+    # Moving a card saves it more than once, so take note of where it came from while we still can.
+    def remember_previous_board
+      @previous_board = account.boards.find_by(id: board_id_was)
+    end
+
+    def moved_between_boards?
+      @previous_board.present?
+    end
+
+    # A card takes the files it stores along with it.
+    def recalculate_bytes_used_of_both_boards_later
+      board.recalculate_bytes_used_later
+      @previous_board.recalculate_bytes_used_later
+      @previous_board = nil
+    end
+end
diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..5d75a9f 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,54 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+# Card images and the files people embed in descriptions and comments are what we count toward a
+# board's and an account's storage usage. Everything else Active Storage stores for us — avatars,
+# exports, imports, and the variants derived from uploads — is on the house.
+module ActiveStorageAttachmentExtensions
+  extend ActiveSupport::Concern
+
+  CARD_IMAGE = { record_type: "Card", name: "image" }.freeze
+  EMBEDDED_FILE = { record_type: "ActionText::RichText", name: "embeds" }.freeze
+
+  included do
+    scope :card_images, -> { where(CARD_IMAGE) }
+    scope :embedded_files, -> { where(EMBEDDED_FILE) }
+
+    after_commit :recalculate_bytes_used_later, on: [ :create, :destroy ]
+  end
+
+  # The board storing this file, or nil when it's a file we don't count.
+  def board
+    if card_image?
+      record&.board
+    elsif embedded_file?
+      record&.record.try(:board)
+    end
+  end
+
+  # Purging and detaching delete attachments without running their callbacks.
+  def delete
+    super.tap { recalculate_bytes_used_later }
+  end
+
+  private
+    def card_image?
+      { record_type:, name: } == CARD_IMAGE
+    end
+
+    def embedded_file?
+      { record_type:, name: } == EMBEDDED_FILE
+    end
+
+    # Boards on their way out have nothing left to count.
+    def recalculate_bytes_used_later
+      ActiveRecord.after_all_transactions_commit do
+        board.recalculate_bytes_used_later if board&.persisted?
+      end
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorageAttachmentExtensions
+end
