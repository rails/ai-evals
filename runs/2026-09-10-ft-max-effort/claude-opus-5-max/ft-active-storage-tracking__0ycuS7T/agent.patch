new file mode 100644
index 0000000..08a9f12
--- /dev/null
+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,17 @@
+# An account stores whatever its boards store. See Board::StorageUsage for what counts.
+#
+# Adding the boards up on read is a single indexed sum over a handful of rows, and it keeps the
+# accounts row — which every request reads — out of the way of everyone's uploads.
+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    boards.sum(:bytes_used)
+  end
+
+  # Recounts every board from scratch. For imports, which write their records straight to the
+  # database, and for repairs.
+  def recalculate_bytes_used_later
+    boards.find_each(&:recalculate_bytes_used_later)
+  end
+end
