diff --git a/script/migrations/20260710-backfill-bytes-used.rb b/script/migrations/20260710-backfill-bytes-used.rb
new file mode 100755
index 0000000..d08bf53
--- /dev/null
+++ b/script/migrations/20260710-backfill-bytes-used.rb
@@ -0,0 +1,13 @@
+#!/usr/bin/env ruby
+
+# Counts what every board and account is already storing, for installations that predate storage
+# usage tracking. Idempotent: counting is a recalculation, so it's safe to re-run.
+
+require_relative "../../config/environment"
+
+Account.find_each do |account|
+  account.boards.find_each(&:recalculate_bytes_used_now)
+  account.recalculate_bytes_used_now
+
+  puts "#{account.name}: #{ActiveSupport::NumberHelper.number_to_human_size(account.bytes_used)}"
+end
