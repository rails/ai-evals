+require "test_helper"
+
+class Account::DataTransfer::BoardRecordSetTest < ActiveSupport::TestCase
+  test "storage usage stays behind, so exports taken before it was counted still import" do
+    board_id = ActiveRecord::Type::Uuid.generate
+    zip = build_zip_with_board(id: board_id)
+    record_set = Account::DataTransfer::BoardRecordSet.new(Current.account)
+
+    assert_nothing_raised { record_set.check(from: zip) }
+    record_set.import(from: zip)
+
+    assert_equal 0, Board.find(board_id).bytes_used
+  end
+
+  private
+    def build_zip_with_board(id:)
+      tempfile = Tempfile.new([ "test_export", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      writer.add_file("data/boards/#{id}.json", {
+        id: id,
+        account_id: ActiveRecord::Type::Uuid.generate,
+        all_access: true,
+        created_at: Time.current.iso8601,
+        creator_id: ActiveRecord::Type::Uuid.generate,
+        name: "Imported board",
+        updated_at: Time.current.iso8601
+      }.to_json)
+      writer.close
+
+      tempfile.rewind
+      ZipFile::Reader.new(tempfile)
+    end
+end
