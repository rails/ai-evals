@@ -0,0 +1,152 @@
+# Japanese locale for Fizzy.
+#
+# The rails-i18n gem is not part of the bundle, so the date, time, and
+# distance-in-words data that Rails needs is defined here.
+ja:
+  account_mailer:
+    cancellation:
+      subject: "Fizzy アカウントが削除されました"
+
+  export_mailer:
+    completed:
+      subject: "Fizzy データのエクスポートがダウンロード可能になりました"
+
+  import_mailer:
+    completed:
+      subject: "Fizzy アカウントのインポートが完了しました"
+    failed:
+      subject: "Fizzy アカウントのインポートに失敗しました"
+
+  magic_link_mailer:
+    sign_in_instructions:
+      subject: "Fizzy のコードは %{code} です"
+
+  user_mailer:
+    email_change_confirmation:
+      subject: "新しいメールアドレスの確認"
+
+  notification:
+    bundle_mailer:
+      notification:
+        subject: "Fizzy%{account}: 新しい通知"
+
+  date:
+    formats:
+      default: "%Y年%m月%d日"
+      short: "%m月%d日"
+      bridge: "%m月%d日"
+      stamp: "%Y年%m月%d日"
+      long: "%Y年%m月%d日"
+    day_names: [日曜日, 月曜日, 火曜日, 水曜日, 木曜日, 金曜日, 土曜日]
+    abbr_day_names: [日, 月, 火, 水, 木, 金, 土]
+    month_names: [~, 1月, 2月, 3月, 4月, 5月, 6月, 7月, 8月, 9月, 10月, 11月, 12月]
+    abbr_month_names: [~, 1月, 2月, 3月, 4月, 5月, 6月, 7月, 8月, 9月, 10月, 11月, 12月]
+    order:
+      - :year
+      - :month
+      - :day
+
+  time:
+    formats:
+      default: "%Y年%m月%d日 %H:%M"
+      short: "%m月%d日 %H:%M"
+      long: "%Y年%m月%d日 %H:%M"
+      notification: "%-m月%-d日(%a) %-H:%M"
+    am: "午前"
+    pm: "午後"
+
+  datetime:
+    distance_in_words:
+      half_a_minute: "30秒"
+      less_than_x_seconds:
+        one: "%{count}秒未満"
+        other: "%{count}秒未満"
+      x_seconds:
