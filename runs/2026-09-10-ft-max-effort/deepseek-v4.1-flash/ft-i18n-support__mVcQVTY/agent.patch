new file mode 100644
index 0000000..b8affa1
--- /dev/null
+++ b/test/integration/localization_smoke_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class LocalizationSmokeTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "representative pages render in Japanese without error" do
+    paths = [
+      root_path,
+      board_path(boards(:writebook)),
+      cards_path,
+      card_path(cards(:logo)),
+      events_path,
+      notifications_path,
+      notifications_settings_path,
+      search_path,
+      account_settings_path,
+      user_path(users(:kevin)),
+      my_access_tokens_path,
+      my_passkeys_path
+    ]
+
+    paths.each do |path|
+      get path, params: { locale: "ja" }
+      assert_response :success, "expected #{path} to succeed"
+      assert_match "メインコンテンツへスキップ", response.body, "expected #{path} to be in Japanese"
+    end
+  end
+
+  test "unoffered locale falls back to the current locale without error" do
+    get root_path, params: { locale: "ja" }
+    get root_path, params: { locale: "xx" }
+
+    assert_response :success
+    assert_match "メインコンテンツへスキップ", response.body
+  end
+end
diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..f58b1bc
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "?locale=ja switches the page to Japanese" do
+    untenanted do
+      get new_session_path(locale: "ja")
+    end
+
+    assert_response :success
+    assert_match "メインコンテンツへスキップ", response.body
+  end
+
+  test "locale choice sticks for the rest of the session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      get new_session_path
+    end
+
+    assert_match "メインコンテンツへスキップ", response.body
+  end
+
+  test "an unoffered locale is ignored and does not break the page" do
+    untenanted do
+      get new_session_path(locale: "xx")
+    end
+
+    assert_response :success
+    assert_match "Skip to main content", response.body
+    assert_no_match "メインコンテンツへスキップ", response.body
+  end
+
+  test "choosing a locale while signed in stores it on the identity and user" do
+    sign_in_as :kevin
+
+    get root_path(locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_equal "ja", users(:kevin).reload.locale
+  end
+
+  test "a clean browser sign-in uses the stored identity locale" do
+    identities(:kevin).update!(locale: "ja")
+
+    sign_in_as :kevin
+    get root_path
+
+    assert_match "メインコンテンツへスキップ", response.body
+  end
+  test "the main app renders in Japanese after switching" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+
+    assert_response :success
+    assert_match "ボード", response.body
+    assert_match "設定", response.body
+  end
+
+  test "English pages are unchanged for people who never chose a locale" do
+    sign_in_as :kevin
+    get root_path
+
+    assert_response :success
+    assert_match "Skip to main content", response.body
+    assert_no_match(/メインコンテンツへスキップ/, response.body)
+  end
+
+  test "sign-in emails are rendered in the recipient's locale" do
+    identities(:kevin).update!(locale: "ja")
+
+    perform_enqueued_jobs do
+      identities(:kevin).send_magic_link
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_includes mail.subject, "Fizzy"
+    assert_includes mail.subject, "コード"
+    assert_match(/確認コード/, mail.text_part.decoded)
+  end
+
+  test "static error pages include both languages" do
+    page = Rails.root.join("public/404.html").read
+
+    assert_match "Sorry, that page doesn’t exist!", page
+    assert_match "お探しのページは存在しません。", page
+  end
+  test "signing up with ?locale=ja stores it on the new identity" do
+    email = "new-#{SecureRandom.hex(4)}@example.com"
+
+    perform_enqueued_jobs do
+      untenanted do
+        post signup_path(locale: "ja"), params: { signup: { email_address: email } }
+      end
+    end
+
+    identity = Identity.find_by(email_address: email)
+    assert_equal "ja", identity.locale
+    mail = ActionMailer::Base.deliveries.last
+    assert_includes mail.subject, "コード"
+    assert_match(/確認コード/, mail.text_part.decoded)
+  end
+end
