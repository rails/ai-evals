diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..4a61ec8
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,70 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :switch_locale
+    after_action :remember_locale
+    helper_method :available_locale?
+
+    # Locale is part of the representation, so it must be part of the cache key.
+    etag { I18n.locale }
+  end
+
+  private
+    def switch_locale(&action)
+      I18n.with_locale(requested_locale, &action)
+    end
+
+    # An explicit `?locale=` wins, but only when we actually offer it. Anything
+    # else (e.g. `?locale=xx`) is ignored so it can never break a page.
+    def requested_locale
+      if locale_param.present?
+        if available_locale?(locale_param)
+          store_locale(locale_param)
+          locale_param.to_sym
+        else
+          preferred_locale
+        end
+      else
+        preferred_locale
+      end
+    end
+
+    def preferred_locale
+      session[:locale].presence ||
+        Current.user&.locale.presence ||
+        Current.identity&.locale.presence ||
+        cookies[:locale].presence ||
+        I18n.default_locale
+    end
+
+    def store_locale(locale)
+      value = locale.to_s
+      session[:locale] = value
+      cookies.permanent[:locale] = { value: value, same_site: :lax }
+      Current.user.update_column(:locale, value) if Current.user && Current.user.locale != value
+      Current.identity.update_column(:locale, value) if Current.identity && Current.identity.locale != value
+    end
+
+    # A person who picked a locale while signed out should keep it once they
+    # sign in, so carry the session choice over onto their identity.
+    def remember_locale
+      return unless session[:locale].present? && available_locale?(session[:locale])
+
+      if Current.user && Current.user.locale != session[:locale]
+        Current.user.update_column(:locale, session[:locale])
+      end
+
+      if Current.identity && Current.identity.locale != session[:locale]
+        Current.identity.update_column(:locale, session[:locale])
+      end
+    end
+
+    def available_locale?(locale)
+      locale.present? && I18n.available_locales.map(&:to_s).include?(locale.to_s)
+    end
+
+    def locale_param
+      params[:locale]
+    end
+end
