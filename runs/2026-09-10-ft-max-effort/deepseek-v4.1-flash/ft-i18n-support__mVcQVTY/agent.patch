diff --git a/lib/ui_translation.rb b/lib/ui_translation.rb
new file mode 100644
index 0000000..9c381e1
--- /dev/null
+++ b/lib/ui_translation.rb
@@ -0,0 +1,20 @@
+# UI strings are authored in English in the templates themselves and translated
+# by their English source text. Using the source text as the lookup key keeps
+# the English rendering byte-for-byte identical no matter what has or hasn't
+# been translated yet, while giving translators a flat, readable dictionary.
+#
+# English text often contains periods, so we look keys up with a separator that
+# can never appear in a string: I18n's default "." separator would otherwise
+# split the sentence into nested keys.
+module UiTranslation
+  SEPARATOR = "\u0000"
+
+  def self.tui(text, **options)
+    if text.is_a?(String)
+      translation = I18n.t(text, separator: SEPARATOR, default: text, **options)
+      translation.is_a?(String) ? translation.html_safe : translation
+    else
+      text
+    end
+  end
+end
