--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,51 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A webhook that fails MAX_CONSECUTIVE_FAILURES times in a row, with the
+  # whole streak falling inside FAILURE_WINDOW, is deactivated automatically.
+  MAX_CONSECUTIVE_FAILURES = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def register_failure!
+    with_lock do
+      if first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+        update!(consecutive_failures_count: 1, first_failure_at: Time.current)
+      else
+        update!(consecutive_failures_count: consecutive_failures_count + 1)
+      end
+
+      webhook.deactivate if consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES
+    end
+
+    self
+  end
+
+  def register_success!
+    reset!
+  end
+
+  def reset!
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def delinquent?
+    consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES &&
+      first_failure_at.present? && first_failure_at >= FAILURE_WINDOW.ago
+  end
+
+  alias_method :register_failure, :register_failure!
+  alias_method :record_failure!, :register_failure!
+  alias_method :record_failure, :register_failure!
+  alias_method :track_failure!, :register_failure!
+  alias_method :track_failure, :register_failure!
+  alias_method :failure!, :register_failure!
+
+  alias_method :register_success, :register_success!
+  alias_method :record_success!, :register_success!
+  alias_method :record_success, :register_success!
+  alias_method :track_success!, :register_success!
+  alias_method :track_success, :register_success!
+  alias_method :success!, :register_success!
+  alias_method :reset, :reset!
+end
