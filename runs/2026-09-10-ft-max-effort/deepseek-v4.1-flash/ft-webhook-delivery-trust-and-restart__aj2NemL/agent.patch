@@ -29,4 +102,93 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def perform_request
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      http.start { |connection| connection.request request_for(uri) }
+    end
+
+    def request_for(uri)
+      Net::HTTP::Post.new(uri.request_uri, request_headers).tap do |request|
+        request.body = body
+      end
+    end
+
+    def request_headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def timestamp
+      event.created_at.utc.iso8601(3)
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def record_response(http_response)
+      update! \
+        state: :completed,
+        request: { "headers" => request_headers, "body" => body },
+        response: { code: http_response.code.to_i, headers: response_headers(http_response) }
+    end
+
+    def record_error(error)
+      update! \
+        state: :errored,
+        request: { "headers" => request_headers, "body" => body },
+        response: { error: error_reason(error) }
+    end
+
+    def response_headers(http_response)
+      http_response.each_header.to_h
+    end
+
+    def error_reason(error)
+      case error
+      when *TIMEOUT_ERRORS then "timeout"
+      when *DESTINATION_UNREACHABLE_ERRORS then "destination_unreachable"
+      when OpenSSL::SSL::SSLError then "ssl_error"
+      else error.class.name.underscore
+      end
+    end
