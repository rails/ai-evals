diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..d55f22b 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,48 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def old_board
+    particular("old_board")
+  end
+
+  def new_board
+    particular("new_board")
+  end
+
+  def old_title
+    particular("old_title")
+  end
+
+  def new_title
+    particular("new_title")
+  end
+
+  def column
+    particular("column")
+  end
+
+  def particulars_for_api
+    case action
+    when "card_assigned", "card_unassigned"
+      { "assignee_ids" => assignee_ids || [] }
+    when "card_board_changed"
+      { "old_board" => old_board, "new_board" => new_board }
+    when "card_title_changed"
+      { "old_title" => old_title, "new_title" => new_title }
+    when "card_triaged", "card_sent_back_to_triage"
+      { "column" => column }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular(key)
+      value = if particulars.is_a?(Hash)
+        particulars.dig("particulars", key) || particulars[key]
+      end
+
+      value.presence || ""
+    end
 end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..73364c1
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,23 @@
+json.(activity, :id, :action, :eventable_type)
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+
+json.particulars activity.particulars_for_api
+
+if activity.eventable_type == "Comment"
+  json.url card_url(activity.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(activity.eventable))
+else
+  json.url card_url(activity.card)
+end
+
+json.eventable do
+  case activity.eventable
+  when Card
+    json.partial! "cards/card", card: activity.eventable
+  when Comment
+    json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
