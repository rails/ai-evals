diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..c6ccff0
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,37 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activities
+    fresh_when etag: @page.records
+  end
+
+  private
+    def activities
+      scope = Current.user.accessible_events.where(action: TIMELINEABLE_ACTIONS)
+      scope = scope.where(creator_id: creator_ids) if creator_ids.any?
+      scope = scope.where(board_id: board_ids) if board_ids.any?
+      scope.order(created_at: :desc, id: :desc).preloaded_for_api
+    end
+
+    def creator_ids
+      @creator_ids ||= Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      @board_ids ||= Array(params[:board_ids]).compact_blank
+    end
+end
