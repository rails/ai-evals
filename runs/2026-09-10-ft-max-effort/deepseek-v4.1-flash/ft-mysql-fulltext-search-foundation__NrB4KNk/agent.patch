diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..544b8ca
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,29 @@
+module SearchHelper
+  def search_highlight(text, query)
+    highlight text.to_s, search_terms(query)
+  end
+
+  def search_snippet(text, query, radius: 120)
+    if term = matching_search_term(text, query)
+      highlight excerpt(text.to_s, term, radius: radius), search_terms(query)
+    end
+  end
+
+  def matching_search_comment(card, query)
+    terms = search_terms(query)
+
+    card.comments.detect do |comment|
+      matching_search_term comment.body.to_plain_text, query
+    end if terms.any?
+  end
+
+  def matching_search_term(text, query)
+    if text.present? && (terms = search_terms(query)).any?
+      terms.find { |term| text.match?(/#{Regexp.escape(term)}/i) }
+    end
+  end
+
+  def search_terms(query)
+    query.to_s.split.uniq
+  end
+end
