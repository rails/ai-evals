diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..0f6785a
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,25 @@
+<%= card_article_tag card, class: "card", data: { search_result: card.number } do %>
+  <header class="card__header">
+    <span class="card__board-name overflow-ellipsis"><%= card.board.name %></span>
+    <span class="card__id"><%= card.number %></span>
+  </header>
+
+  <div class="card__body">
+    <div class="card__content">
+      <h3 class="card__title">
+        <%= link_to search_highlight(card.title, query), card_path(card), class: "card__title-link" %>
+      </h3>
+
+      <% if snippet = search_snippet(card.description&.to_plain_text, query) %>
+        <p class="card__search-excerpt"><%= snippet %></p>
+      <% end %>
+
+      <% if comment = matching_search_comment(card, query) %>
+        <div class="card__search-comment txt-small">
+          <strong><%= comment.creator.familiar_name %></strong>
+          <p><%= search_snippet(comment.body.to_plain_text, query) %></p>
+        </div>
+      <% end %>
+    </div>
+  </div>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c4ebf2c
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,32 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+<% @hide_footer_frames = true %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<div class="pad-inline pad-block-half">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half align-center" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width",
+          autofocus: true, autocorrect: "off", autocomplete: "off", data: { "1p-ignore": "true" } %>
+    <%= form.button "Search", class: "btn btn--reversed" %>
+  <% end %>
+</div>
+
+<% if @query.present? %>
+  <%= turbo_frame_tag :search_results do %>
+    <section class="cards cards--grid">
+      <div class="cards__list">
+        <% if @page.records.any? %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { query: @query } %>
+        <% else %>
+          <div class="blank-slate">No cards found matching “<%= @query %>”</div>
+        <% end %>
+      </div>
+    </section>
+  <% end %>
+<% end %>
