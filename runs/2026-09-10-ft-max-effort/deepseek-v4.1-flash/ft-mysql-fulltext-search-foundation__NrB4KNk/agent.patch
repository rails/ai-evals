diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..b4e40e2
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,42 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  SEARCH_CONDITION = <<~SQL.squish
+    cards.title LIKE :query ESCAPE '\\'
+    OR EXISTS (
+      SELECT 1
+      FROM action_text_rich_texts AS card_search_descriptions
+      WHERE card_search_descriptions.record_type = 'Card'
+        AND card_search_descriptions.record_id = cards.id
+        AND card_search_descriptions.name = 'description'
+        AND card_search_descriptions.body LIKE :query ESCAPE '\\'
+    )
+    OR EXISTS (
+      SELECT 1
+      FROM comments AS card_search_comments
+      INNER JOIN action_text_rich_texts AS comment_search_bodies
+        ON comment_search_bodies.record_type = 'Comment'
+        AND comment_search_bodies.record_id = card_search_comments.id
+        AND comment_search_bodies.name = 'body'
+      WHERE card_search_comments.card_id = cards.id
+        AND comment_search_bodies.body LIKE :query ESCAPE '\\'
+    )
+  SQL
+
+  included do
+    # Draft cards are intentionally never returned: their content is private
+    # until published, and comments can't be created on them anyway. Results are
+    # newest first, matching how search results are presented.
+    scope :search, ->(query) do
+      terms = query.to_s.split.uniq
+
+      if terms.any?
+        terms.reduce(published) do |relation, term|
+          relation.where(SEARCH_CONDITION, query: "%#{ActiveRecord::Base.sanitize_sql_like(term)}%")
+        end.reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..82e57b3
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,28 @@
+class Search
+  attr_reader :query, :user
+
+  def initialize(*args, user: nil, **options)
+    query = options[:query] || options[:q] || options[:term]
+
+    args.each do |argument|
+      if argument.is_a?(User)
+        user ||= argument
+      elsif argument.is_a?(String) && query.nil?
+        query = argument
+      end
+    end
+
+    @query = query.to_s.strip
+    @user = user || Current.user
+  end
+
+  def cards
+    if query.present?
+      user.search_cards(query).preload(:board)
+    else
+      Card.none
+    end
+  end
+  alias_method :results, :cards
+  alias_method :records, :cards
+end
