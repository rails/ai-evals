diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..cfeda4d
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,65 @@
+# Activities
+
+Activity is the account-wide timeline of what has happened across the boards you
+can access: cards added, moved, renamed, assigned, closed, commented on, and so on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user ID(s) who performed the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David Heinemeier Hansson assigned Kevin Clark to \"First!\"",
+    "particulars": {
+      "assignee_ids": [
+        "03f5v9zppzlksuj4mxba2nbzn"
+      ]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 4,
+      "title": "First!",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the other API
+endpoints. The `particulars` object contains event-specific details, and is empty
+for events that don't have any:
+
+| Event | `particulars` |
+|-------|---------------|
+| Assignment changed | `assignee_ids` |
+| Card moved to another board | `old_board`, `new_board` |
+| Card renamed | `old_title`, `new_title` |
+| Card triaged | `column` |
+
+Missing board, title, or column values are returned as empty strings.
+
+For card events, `url` opens the card. For comment events, `url` opens the card
+the comment was posted on and jumps to the comment.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..f70d4d1
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns activity as a JSON array" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_kind_of Array, body
+    assert body.any?
+
+    event = body.first
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url].sort, event.keys.sort
+  end
+
+  test "returns newest activity first" do
+    get activities_path(format: :json)
+
+    events = @response.parsed_body
+    created_ats = events.map { |e| Time.zone.parse(e["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "description is plain text" do
+    event = events(:layout_assignment_jz)
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "assigned"
+  end
+
+  test "omits card_collection_changed events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_collection_changed")
+
+    get activities_path(format: :json)
+
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+  end
+
+  test "includes card_title_changed events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert activity.present?
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "particulars for assignment" do
+    event = events(:logo_assignment_jz)
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal [ users(:jz).id ], activity["particulars"]["assignee_ids"]
+  end
+
+  test "particulars for board change fills in missing values with empty strings" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal({ "old_board" => "Old", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "particulars for triage" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In Progress" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal({ "column" => "In Progress" }, activity["particulars"])
+  end
+
+  test "particulars are empty for other events" do
+    event = events(:text_published)
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "card event url opens the card" do
+    event = events(:logo_published)
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal card_url(event.card), activity["url"]
+  end
+
+  test "comment event url opens the card and anchors the comment" do
+    event = events(:layout_commented)
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal card_url(event.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+  end
+
+  test "eventable uses API representations" do
+    event = events(:logo_published)
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.card.title, activity["eventable"]["title"]
+    assert_equal event.board.name, activity["board"]["name"]
+    assert_equal event.creator.name, activity["creator"]["name"]
+  end
+
+  test "filters by creator_ids" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_equal [ users(:kevin).id ], @response.parsed_body.pluck("creator").pluck("id").uniq
+  end
+
+  test "filters by board_ids" do
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ])
+    assert_response :success
+    assert @response.parsed_body.any?
+
+    assert_empty @response.parsed_body.reject { |e| e.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "does not return activity on inaccessible boards" do
+    logout_and_sign_in_as :jz
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    board_ids = @response.parsed_body.pluck("board").pluck("id").uniq
+    assert_equal [ boards(:writebook).id ], board_ids
+  end
+
+  test "paginates" do
+    30.times do |i|
+      events(:logo_published).dup.tap do |event|
+        event.id = ActiveRecord::Type::Uuid.generate
+        event.created_at = (i + 1).minutes.ago
+        event.save!
+      end
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert @response.headers["Link"].present?
+  end
+end
