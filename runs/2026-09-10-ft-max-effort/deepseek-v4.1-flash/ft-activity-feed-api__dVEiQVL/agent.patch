+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,26 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+        fresh_when etag: @page.records
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.where(action: Event::ACTIVITY_ACTIONS).preloaded
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events.order(created_at: :desc, id: :desc)
+    end
+
+    def creator_ids
+      params[:creator_ids]
+    end
+
+    def board_ids
+      params[:board_ids]
+    end
+end
diff --git a/app/models/event.rb b/app/models/event.rb
index bbbf2a6..ce59ef0 100644
--- a/app/models/event.rb
+++ b/app/models/event.rb
@@ -1,6 +1,24 @@
 class Event < ApplicationRecord
   include Notifiable, Particulars, Promptable
 
+  # Actions surfaced in the account activity feed. Mirrors the actions shown in
+  # the HTML timeline, minus the deprecated +card_collection_changed+ events and
+  # plus +card_title_changed+ events.
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
   belongs_to :account, default: -> { board.account }
   belongs_to :board
   belongs_to :creator, class_name: "User"
@@ -37,7 +55,28 @@ class Event < ApplicationRecord
     Event::Description.new(self, user)
   end
 
+  # Event-specific details exposed through the activities API. Missing board,
+  # title, or column values are returned as empty strings.
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: assignee_ids || [] }
+    when "card_board_changed"
+      { old_board: activity_particular("old_board"), new_board: activity_particular("new_board") }
+    when "card_title_changed"
+      { old_title: activity_particular("old_title"), new_title: activity_particular("new_title") }
+    when "card_triaged", "card_sent_back_to_triage"
+      { column: activity_particular("column") }
+    else
+      {}
+    end
+  end
+
   private
+    def activity_particular(key)
+      particulars.to_h.dig("particulars", key).to_s
+    end
+
     def dispatch_webhooks
       Event::WebhookDispatchJob.perform_later(self)
     end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..5cbb1fc
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,28 @@
+json.cache! [ event, Current.user ] do
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+
+  json.description event.description_for(Current.user).to_plain_text
+
+  json.particulars event.activity_particulars
+
+  if event.action.comment_created?
+    json.url card_url(event.card, anchor: dom_id(event.eventable))
+  else
+    json.url card_url(event.card)
+  end
+
+  json.eventable_type event.eventable_type
+
+  json.eventable do
+    case event.eventable
+    when Card
+      json.partial! "cards/card", card: event.eventable
+    when Comment
+      json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
