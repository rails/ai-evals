diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..f51f054
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,50 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_WINDOW_FRACTION = 1.0 / 3
+  BURST_COMMENTS = 3
+  BURST_PEOPLE = 2
+
+  included do
+    scope :stalled, -> { active.where.not(burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?
+    active? && burst? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def stalled_at
+    last_active_at + STALL_PERIOD if burst?
+  end
+
+  def stalled_days
+    stalled? ? (Time.current - stalled_at).seconds.in_days.to_i : 0
+  end
+  alias_method :days_stalled, :stalled_days
+
+  def register_burst
+    update!(burst_at: Time.current)
+  end
+
+  def register_burst_from_comments
+    register_burst if comments_show_burst?
+  end
+
+  private
+    def comments_show_burst?
+      recent_comments = comments.by_user.order(created_at: :desc, id: :desc).limit(BURST_COMMENTS).to_a
+
+      recent_comments.size >= BURST_COMMENTS &&
+        recent_comments.map(&:creator_id).uniq.size >= BURST_PEOPLE &&
+        recent_comments.first.created_at - recent_comments.last.created_at <= burst_window
+    end
+
+    def burst_window
+      (board.auto_postpone_period * BURST_WINDOW_FRACTION).seconds
+    end
+end
