diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..ae242f4 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,23 @@
 module TimeHelper
+  # Renders a <time> element whose text is filled in by the browser, using the
+  # viewer's own timezone. The server only sends the raw timestamp (in the
+  # `datetime` attribute), so the rendered HTML can be cached and shared
+  # between people regardless of where they are.
+  def local_time(time, format = nil, **options)
+    return if time.blank?
+
+    format = options.delete(:format) || format || :relative
+
+    tag.time(
+      nil,
+      class: class_names("local-time-value", options.delete(:class)),
+      datetime: time.iso8601,
+      data: {
+        controller: "local-time",
+        local_time_format_value: format
+      }.merge(options.delete(:data) || {}),
+      **options
+    )
+  end
+  alias_method :local_time_tag, :local_time
 end
