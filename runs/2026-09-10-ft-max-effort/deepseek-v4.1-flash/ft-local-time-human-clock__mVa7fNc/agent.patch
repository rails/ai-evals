@@ -42,3 +45,66 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+// Format a timestamp for display in the viewer's timezone. `format` selects an
+// absolute style; `relative` (the default) picks the most natural one: the time
+// of day for today, a relative phrase (yesterday, 5 days ago, tomorrow, in 3
+// days) during the surrounding week, and a short date further in the past.
+export function formatLocalTime(date, format = "relative") {
+  switch (format) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date)
+    case "date_with_year":
+      return formatDateWithYear(date)
+    case "full_date":
+      return formatFullDate(date)
+    case "date_time":
+      return formatDateTime(date)
+    default:
+      return formatRelative(date)
+  }
+}
+
+export function formatTime(date) {
+  return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+export function formatDate(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(date)
+}
+
+export function formatDateWithYear(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(date)
+}
+
+export function formatFullDate(date) {
+  return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+export function formatDateTime(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+export function formatRelative(date, now = new Date()) {
+  const days = differenceInDays(date, now)
+
+  if (days === 0) {
+    return formatTime(date)
+  } else if (days > 0 || Math.abs(days) < RELATIVE_WINDOW_IN_DAYS) {
+    return new Intl.RelativeTimeFormat("en-US", { numeric: "auto" }).format(days, "day")
+  } else {
+    return formatDate(date)
+  }
+}
+
+// Compare calendar days in the browser's timezone so the phrase matches the
+// clock the viewer actually sees.
+function differenceInDays(date, now) {
+  return Math.round((beginningOfLocalDay(date) - beginningOfLocalDay(now)) / DAY_IN_MILLISECONDS)
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
