diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..60e24bb
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime, formatLocalTime } from "helpers/date_helpers"
+
+// Fills a <time> element with a human-readable timestamp in the viewer's own
+// timezone. The server only renders the raw `datetime` value so the HTML can be
+// cached and shared.
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.boundRender = this.render.bind(this)
+    this.element.addEventListener("turbo:morph-element", this.boundRender)
+    this.render()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.boundRender)
+  }
+
+  render() {
+    if (this.datetime) {
+      this.element.textContent = formatLocalTime(this.datetime, this.formatValue)
+      this.element.title = formatDateTime(this.datetime)
+    }
+  }
+
+  get datetime() {
+    const value = this.element.getAttribute("datetime")
+    return value ? new Date(value) : null
+  }
+}
