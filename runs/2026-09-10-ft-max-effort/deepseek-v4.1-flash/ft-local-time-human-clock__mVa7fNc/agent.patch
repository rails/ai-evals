diff --git a/test/helpers/local_time_helper_test.rb b/test/helpers/local_time_helper_test.rb
new file mode 100644
index 0000000..976a7f3
--- /dev/null
+++ b/test/helpers/local_time_helper_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class LocalTimeHelperTest < ActionView::TestCase
+  include TimeHelper
+
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "renders a time element carrying the raw timestamp" do
+    node = parse(local_time(Time.utc(2025, 1, 22, 13, 42))).at_css("time")
+
+    assert_equal "2025-01-22T13:42:00Z", node["datetime"]
+    assert_equal "local-time-value", node["class"]
+    assert_equal "local-time", node["data-controller"]
+    assert_equal "relative", node["data-local-time-format-value"]
+  end
+
+  test "renders the requested format" do
+    node = parse(local_time(Time.utc(2025, 1, 22, 13, 42), format: :date)).at_css("time")
+
+    assert_equal "date", node["data-local-time-format-value"]
+  end
+
+  test "does not bake a server-rendered time into the element" do
+    html = local_time(Time.utc(2025, 1, 22, 13, 42))
+
+    assert_not_includes html, "1:42"
+    assert_not_includes html, "PM"
+    assert_not_includes html, "ago"
+  end
+
+  test "accepts a TimeWithZone" do
+    node = parse(local_time(Time.zone.parse("2025-01-22 13:42"))).at_css("time")
+
+    assert_equal "2025-01-22T13:42:00Z", node["datetime"]
+  end
+
+  test "returns nil for a blank timestamp" do
+    assert_nil local_time(nil)
+  end
+end
diff --git a/test/system/local_time_rendering_test.rb b/test/system/local_time_rendering_test.rb
new file mode 100644
index 0000000..89ad29e
--- /dev/null
+++ b/test/system/local_time_rendering_test.rb
@@ -0,0 +1,104 @@
+require "application_system_test_case"
+
+class LocalTimeRenderingTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "comment timestamps are rendered in the browser" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+
+    cases = {
+      "1:42 PM" => Time.current.change(hour: 13, min: 42, sec: 0),
+      "yesterday" => Time.current.yesterday.change(hour: 13, min: 42, sec: 0),
+      "5 days ago" => (Time.current - 5.days).change(hour: 13, min: 42, sec: 0),
+      "Sep 12" => Time.utc(2024, 9, 12, 12, 0, 0)
+    }
+
+    cases.each_with_index do |(expected, created_at), index|
+      comment.update_columns(created_at: created_at, updated_at: Time.current)
+
+      visit card_url(card, v: index)
+
+      within "##{dom_id(comment)}" do
+        assert_selector "time.local-time-value", text: expected
+      end
+    end
+  end
+
+  test "future card deadlines are rendered in the browser" do
+    card = cards(:logo)
+    period = card.auto_postpone_period
+
+    card.update_columns(last_active_at: Time.current + 1.day - period, updated_at: Time.current)
+    visit card_url(card, v: "tomorrow")
+    assert_equal "tomorrow", time_text("##{dom_id(card, :closure_notice)} time.local-time-value")
+
+    card.update_columns(last_active_at: Time.current + 3.days - period, updated_at: Time.current)
+    visit card_url(card, v: "in-3-days")
+    assert_equal "in 3 days", time_text("##{dom_id(card, :closure_notice)} time.local-time-value")
+  end
+
+  test "card timestamps are rendered in the browser" do
+    card = cards(:logo)
+    added_at = Time.utc(2024, 9, 12, 12, 0, 0)
+    updated_at = Time.current.change(hour: 9, min: 30, sec: 0)
+    card.update_columns(created_at: added_at, last_active_at: updated_at, updated_at: Time.current)
+
+    visit card_url(card)
+
+    assert_equal "Sep 12", time_text("##{dom_id(card, :meta)} .card__meta-text--added time.local-time-value")
+    assert_equal "9:30 AM", time_text("##{dom_id(card, :meta)} .card__meta-text--updated time.local-time-value")
+  end
+
+  test "re-renders after a Turbo morph empties the element" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update_columns(created_at: Time.current.change(hour: 13, min: 42, sec: 0), updated_at: Time.current)
+    visit card_url(comment.card)
+
+    selector = "##{dom_id(comment)} time.local-time-value"
+    assert_selector selector, text: "1:42 PM"
+
+    page.execute_script(<<~JS)
+      const element = document.querySelector(#{selector.to_json})
+      element.textContent = ""
+      element.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+    JS
+
+    assert_selector selector, text: "1:42 PM"
+  end
+
+test "time survives a broadcast morph refresh" do
+  comment = comments(:logo_agreement_kevin)
+  comment.update_columns(created_at: Time.current.change(hour: 13, min: 42, sec: 0), updated_at: Time.current)
+  card = comment.card
+  selector = "##{dom_id(comment)} time.local-time-value"
+
+  visit card_url(card)
+  assert_selector selector, text: "1:42 PM"
+  assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+  Current.user = users(:kevin)
+  card.update!(title: "Retitled for morph")
+  perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+  assert_selector "h1", text: "Retitled for morph", wait: 5
+  assert_selector selector, text: "1:42 PM"
+end
+
+  private
+    def time_text(selector)
+      assert_selector selector
+
+      20.times do
+        text = page.evaluate_script("document.querySelector(#{selector.to_json})?.textContent")
+        return text if text.present?
+        sleep 0.1
+      end
+
+      flunk "time in #{selector} was never rendered"
+    end
+end
