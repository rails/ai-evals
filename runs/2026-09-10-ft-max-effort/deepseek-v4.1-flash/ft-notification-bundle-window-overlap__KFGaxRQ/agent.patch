+<h1 class="title">Hi <%= @user.first_name %>,</h1>
+<p class="subtitle">Here's what happened while you were away.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each_with_index do |(board, notifications), index| %>
+  <h2 class="notification__board">
+    <%= link_to board.name, board_url(board, script_name: @bundle.account.slug) %>
+  </h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <div class="notification">
+      <p class="notification__author"><%= notification.creator.familiar_name %></p>
+      <p class="notification__details">
+        <%= link_to payload.title, payload.url %>
+        <br>
+        <%= payload.body %>
+      </p>
+    </div>
+  <% end %>
+
+  <% unless index == @notifications.group_by { |notification| notification.card.board }.size - 1 %>
+    <hr class="notification__board-separator">
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "View all notifications", notifications_url(script_name: @bundle.account.slug) %>.
+</p>
