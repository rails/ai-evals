+++ b/app/models/notification/bundling.rb
@@ -0,0 +1,27 @@
+module Notification::Bundling
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :bundle_for_email, if: :should_bundle?
+  end
+
+  def bundle_for_email
+    bundle_now
+    bundle_later
+  end
+
+  def bundle_now
+    Notification::Bundler.bundle(self)
+  end
+
+  def bundle_later
+    Notification::BundlingJob.perform_later(self)
+  end
+
+  private
+    def should_bundle?
+      source_id_previously_changed? && Notification::Bundle.bundling?(user.settings&.bundle_email_frequency)
+    end
+end
