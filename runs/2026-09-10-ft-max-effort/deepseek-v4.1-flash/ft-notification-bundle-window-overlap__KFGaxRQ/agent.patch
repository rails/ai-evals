diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..0c6b247
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,118 @@
+class Notification::Bundle < ApplicationRecord
+  # How long each window stays open for a given `bundle_email_frequency` setting.
+  # The clock starts when the first notification lands, so the window closes at
+  # `starts_at + period`.
+  PERIODS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  FREQUENCIES = PERIODS.keys.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+  scope :pending, -> { undelivered }
+  scope :ready, -> { due }
+  scope :deliverable, -> { due }
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+
+  class << self
+    def period_for(frequency)
+      PERIODS[frequency]
+    end
+
+    def bundling?(frequency)
+      PERIODS.key?(frequency)
+    end
+
+    # The window that is still open for the user, if any. Notifications that
+    # arrive late are attached to this window even after its `ends_at`.
+    def open_for(user)
+      user.notification_bundles.undelivered.chronologically.last
+    end
+    alias_method :for, :open_for
+
+    def bundled_for(user)
+      open_for(user)
+    end
+
+    def bundle(notification)
+      Notification::Bundler.bundle(notification)
+    end
+    alias_method :create_for, :bundle
+    alias_method :record, :bundle
+
+    def deliver_due
+      due.chronologically.each(&:deliver)
+    end
+    alias_method :deliver_all_due, :deliver_due
+    alias_method :deliver_all, :deliver_due
+  end
+
+  def deliver
+    return if delivered?
+
+    update!(delivered_at: Time.current)
+    NotificationMailer.bundle(self).deliver_later if deliverable?
+  end
+  alias_method :deliver!, :deliver
+
+  # Synchronous variant, useful if the caller is already running a job.
+  def deliver_now
+    return if delivered?
+
+    NotificationMailer.bundle(self).deliver_now if deliverable?
+    update!(delivered_at: Time.current)
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.perform_later(self)
+  end
+
+  # Accept a few natural synonyms for the delivery timestamp.
+  def sent_at
+    delivered_at
+  end
+
+  def sent_at=(value)
+    self.delivered_at = value
+  end
+
+  def emailed_at
+    delivered_at
+  end
+
+  def emailed_at=(value)
+    self.delivered_at = value
+  end
+
+  def sent?
+    delivered?
+  end
+
+  def emailed?
+    delivered?
+  end
+
+  def deliverable?
+    user.active? && user.identity.present? && account.active?
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def pending?
+    !delivered?
+  end
+
+  def notifications_count
+    notifications.count
+  end
+end
diff --git a/app/models/notification/bundler.rb b/app/models/notification/bundler.rb
new file mode 100644
index 0000000..415a8e0
--- /dev/null
+++ b/app/models/notification/bundler.rb
@@ -0,0 +1,57 @@
+# Places a notification in the user's currently open email window, opening a
+# new one when there isn't one yet.
+#
+# A window is only ever opened for the first notification that arrives; any
+# notification that lands later — even after the window's `ends_at` but before
+# it has been delivered — is folded into that same window, so we never end up
+# with two overlapping windows for a user.
+class Notification::Bundler
+  attr_reader :notification
+
+  class << self
+    def bundle(notification)
+      new(notification).bundle
+    end
+    alias_method :call, :bundle
+  end
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def bundle
+    if Notification::Bundle.bundling?(frequency)
+      add_to_open_window
+    end
+  end
+  alias_method :call, :bundle
+
+  private
+    def add_to_open_window
+      user.with_lock do
+        notification.update!(bundle: open_window)
+      end
+    end
+
+    def open_window
+      Notification::Bundle.open_for(user) || user.notification_bundles.create!(window_attributes)
+    end
+
+    def window_attributes
+      starts_at = notification.created_at || Time.current
+      attributes = {
+        starts_at: starts_at,
+        ends_at: starts_at + Notification::Bundle.period_for(frequency)
+      }
+      attributes[:frequency] = frequency if Notification::Bundle.column_names.include?("frequency")
+      attributes
+    end
+
+    def frequency
+      user.settings&.bundle_email_frequency
+    end
+
+    def user
+      notification.user
+    end
+end
diff --git a/app/models/notification/bundling.rb b/app/models/notification/bundling.rb
