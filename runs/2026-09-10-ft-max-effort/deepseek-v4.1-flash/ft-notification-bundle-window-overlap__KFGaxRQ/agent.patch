@@ -0,0 +1,13 @@
+class Notification::BundlingJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(record = nil)
+    if record.is_a?(Notification)
+      record.bundle_now
+    elsif record.is_a?(User)
+      record.notifications.where(bundle_id: nil).find_each(&:bundle_now)
+    else
+      Notification.where(bundle_id: nil).find_each(&:bundle_now)
+    end
+  end
+end
