diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..1e31843
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,116 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    if pending_authentication&.active?
+      @email_address = pending_authentication.email_address
+    else
+      redirect_to new_session_path, alert: expired_message
+    end
+  end
+
+  def create
+    if pending_authentication.nil? || !pending_authentication.active?
+      missing_pending_authentication
+    elsif pending_authentication.authenticate(params[:code])
+      complete_authentication pending_authentication
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def pending_authentication
+      @pending_authentication ||= PendingAuthentication.find_by_token(pending_authentication_token)
+    end
+
+    def pending_authentication_token
+      params[:pending_authentication_token].presence || cookies[:pending_authentication_token]
+    end
+
+    def complete_authentication(pending)
+      identity = Identity.find_or_create_by!(email_address: pending.email_address)
+
+      join_account identity, pending.account if pending.join?
+      redirect_path = redirect_path_after_authentication(pending, identity)
+
+      start_new_session_for identity
+
+      cookies.delete :pending_authentication_token
+      pending.destroy!
+
+      respond_to do |format|
+        format.html { redirect_to redirect_path }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def redirect_path_after_authentication(pending, identity)
+      case pending.purpose.to_sym
+      when :join
+        join_redirect_path identity, pending.account
+      when :sign_up
+        new_signup_completion_path
+      else
+        sign_in_redirect_path identity
+      end
+    end
+
+    def sign_in_redirect_path(identity)
+      return after_authentication_url if session[:return_to_after_authenticating].present?
+      return landing_url if identity.accounts.active.exists?
+
+      new_signup_completion_path
+    end
+
+    def join_account(identity, account)
+      return if account.blank?
+
+      account.join_code&.redeem_if { identity.join(account) }
+    end
+
+    def join_redirect_path(identity, account)
+      return new_signup_completion_path if account.blank?
+
+      if (user = User.active.find_by(account: account, identity: identity))&.setup?
+        landing_url script_name: account.slug
+      else
+        new_users_verification_url script_name: account.slug
+      end
+    end
+
+    def missing_pending_authentication
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: expired_message }
+        format.json { render json: { message: invalid_message }, status: :unauthorized }
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: invalid_message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+
+    def expired_message
+      "That sign-in attempt has expired. Please try again."
+    end
+
+    def invalid_message
+      "Invalid pending_authentication_token or code"
+    end
+end
