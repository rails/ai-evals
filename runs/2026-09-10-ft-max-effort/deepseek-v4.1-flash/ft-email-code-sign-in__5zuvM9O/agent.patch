new file mode 100644
index 0000000..a94ad95
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,36 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def start_pending_authentication(email_address:, purpose:, account: nil)
+      pending = PendingAuthentication.start(
+        email_address: normalized_email_address(email_address),
+        purpose: purpose,
+        account: account
+      )
+
+      token = pending.token
+
+      IdentityMailer.sign_in_code(email_address: pending.email_address, code: pending.code).deliver_later
+      log_pending_authentication pending
+
+      cookies[:pending_authentication_token] = {
+        value: token,
+        httponly: true,
+        same_site: :lax
+      }
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: token }, status: :created }
+      end
+    end
+
+    def normalized_email_address(value)
+      value.to_s.strip.downcase.presence
+    end
+
+    def log_pending_authentication(pending)
+      Rails.logger.info "[Fizzy] Sign-in code for #{pending.email_address}: #{pending.code}"
+    end
+end
