+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none">Check your email</h1>
+
+  <p class="margin-none-block-start">We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to continue.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", inputmode: "text", maxlength: 6, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if Rails.env.local? && @pending_authentication&.code.present? %>
+    <p class="txt-subtle txt-small margin-none">Psst, here's your code: <strong><%= @pending_authentication.code %></strong></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
