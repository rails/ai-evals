diff --git a/test/controllers/email_code_flow_test.rb b/test/controllers/email_code_flow_test.rb
new file mode 100644
index 0000000..937f8e1
--- /dev/null
+++ b/test/controllers/email_code_flow_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class EmailCodeFlowTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "sign in with a six character code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: "david@37signals.com" }
+      end
+
+      assert_response :redirect
+      assert_redirected_to new_session_magic_link_path
+
+      pending = PendingAuthentication.last
+      assert_equal 6, pending.code.length
+      assert pending.expires_at > 14.minutes.from_now
+      assert pending.expires_at <= 15.minutes.from_now
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ "david@37signals.com" ], email.to
+      assert_includes email.subject, pending.code
+      assert_includes email.body.encoded, pending.code
+
+      follow_redirect!
+      assert_response :success
+      assert_includes response.body, pending.code
+
+      post session_magic_link_path, params: { code: pending.code }
+      assert_response :redirect
+      assert cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].blank?
+      assert_equal 0, PendingAuthentication.count
+    end
+  end
+
+  test "sign in with a code accepts lowercase and surrounding whitespace" do
+    untenanted do
+      post session_path, params: { email_address: "david@37signals.com" }
+      pending = PendingAuthentication.last
+
+      post session_magic_link_path, params: { code: " #{pending.code.downcase} " }
+      assert_response :redirect
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "sign in with an invalid code is rejected" do
+    untenanted do
+      post session_path, params: { email_address: "david@37signals.com" }
+      pending = PendingAuthentication.last
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+      assert_response :redirect
+      assert_not cookies[:session_token].present?
+      assert PendingAuthentication.exists?(pending.id)
+    end
+  end
+
+  test "expired code is rejected" do
+    untenanted do
+      post session_path, params: { email_address: "david@37signals.com" }
+      pending = PendingAuthentication.last
+      pending.update!(expires_at: 1.minute.ago)
+
+      post session_magic_link_path, params: { code: pending.code }
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "expired token is rejected" do
+    untenanted do
+      post session_path, params: { email_address: "david@37signals.com" }
+      pending = PendingAuthentication.last
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: pending.code }
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "invalid email is rejected" do
+    untenanted do
+      assert_no_emails do
+        post session_path, params: { email_address: "not-an-email" }
+      end
+      assert_response :unprocessable_entity
+      assert_equal 0, PendingAuthentication.count
+    end
+  end
+
+  test "sign in as JSON returns the pending token and session token" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: "david@37signals.com" }, as: :json
+      end
+
+      assert_response :created
+      token = @response.parsed_body["pending_authentication_token"]
+      assert token.present?
+      assert_equal token, cookies[:pending_authentication_token]
+
+      pending = PendingAuthentication.last
+      post session_magic_link_path, params: { code: pending.code, pending_authentication_token: token }, as: :json
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
