diff --git a/app/models/pending_authentication.rb b/app/models/pending_authentication.rb
new file mode 100644
index 0000000..447634f
--- /dev/null
+++ b/app/models/pending_authentication.rb
@@ -0,0 +1,51 @@
+class PendingAuthentication < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_EXPIRATION = 15.minutes
+  CODE_ALPHABET = [ *"A".."Z", *"0".."9" ].freeze
+
+  belongs_to :identity, optional: true
+  belongs_to :account, optional: true
+
+  enum :purpose, { sign_in: "sign_in", sign_up: "sign_up", join: "join" }, default: :sign_in, scopes: false
+
+  before_validation :assign_code, :assign_expiration, on: :create
+
+  scope :active, -> { where(expires_at: Time.current..) }
+
+  class << self
+    def start(email_address:, purpose: :sign_in, identity: nil, account: nil)
+      create! email_address: email_address, purpose: purpose, identity: identity, account: account
+    end
+
+    def find_by_token(token)
+      find_signed(token, purpose: :pending_authentication) if token.present?
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+  end
+
+  def token
+    signed_id purpose: :pending_authentication, expires_in: CODE_EXPIRATION
+  end
+
+  def active?
+    expires_at.present? && expires_at.future?
+  end
+
+  def authenticate(code)
+    active? && code.present? && ActiveSupport::SecurityUtils.secure_compare(normalize(code), self.code)
+  end
+
+  private
+    def assign_code
+      self.code ||= Array.new(CODE_LENGTH) { CODE_ALPHABET[SecureRandom.random_number(CODE_ALPHABET.length)] }.join
+    end
+
+    def assign_expiration
+      self.expires_at ||= CODE_EXPIRATION.from_now
+    end
+
+    def normalize(value)
+      value.to_s.strip.upcase
+    end
+end
