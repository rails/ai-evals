new file mode 100644
index 0000000..1c9a529
--- /dev/null
+++ b/app/models/account/data_transfer/cards_exporter.rb
@@ -0,0 +1,118 @@
+class Account::DataTransfer::CardsExporter
+  FILENAME = "cards.json"
+  FILES_DIRECTORY = "files"
+
+  attr_reader :account, :user
+
+  def initialize(account, user:)
+    @account = account
+    @user = user
+  end
+
+  def export(zip)
+    blobs = []
+
+    zip.add_file(FILENAME) do |sink|
+      sink.write(header)
+
+      accessible_cards.find_each.with_index do |card, index|
+        sink.write(",") if index.positive?
+        sink.write(JSON.generate(card_data(card, blobs)))
+      end
+
+      sink.write(footer)
+    end
+
+    write_files(zip, blobs)
+  end
+
+  private
+    def accessible_cards
+      user.accessible_cards.includes(
+        :board, :column, :creator, :assignees, :tags, :image_attachment,
+        :rich_text_description,
+        comments: [ :creator, :rich_text_body ]
+      )
+    end
+
+    def header
+      %({"type":"cards","version":1,"exported_at":#{JSON.generate(Time.current.iso8601)},"account":#{JSON.generate({ "name" => account.name })},"cards":[)
+    end
+
+    def footer
+      "]}"
+    end
+
+    def card_data(card, blobs)
+      {
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "due_on" => card.due_on,
+        "created_at" => card.created_at,
+        "last_active_at" => card.last_active_at,
+        "board" => card.board.name,
+        "column" => card.column&.name,
+        "creator" => person_data(card.creator),
+        "assignees" => card.assignees.map { |assignee| person_data(assignee) },
+        "tags" => card.tags.map(&:title),
+        "description" => rich_text_body(card.rich_text_description),
+        "attachments" => attachment_data(card.image_attachment ? [ card.image_attachment ] : [], blobs),
+        "comments" => card.comments.map { |comment| comment_data(comment, blobs) }
+      }
+    end
+
+    def comment_data(comment, blobs)
+      {
+        "creator" => person_data(comment.creator),
+        "body" => rich_text_body(comment.rich_text_body),
+        "created_at" => comment.created_at,
+        "attachments" => attachment_data(comment.rich_text_body&.embeds || [], blobs)
+      }
+    end
+
+    def person_data(user)
+      return nil if user.nil?
+
+      {
+        "name" => user.name,
+        "email_address" => user.identity&.email_address
+      }
+    end
+
+    def rich_text_body(rich_text)
+      rich_text&.body&.to_s
+    end
+
+    def attachment_data(attachments, blobs)
+      attachments.filter_map do |attachment|
+        blob = attachment.blob
+        blobs << blob
+
+        {
+          "filename" => blob.filename.to_s,
+          "content_type" => blob.content_type,
+          "byte_size" => blob.byte_size,
+          "path" => file_path(blob)
+        }
+      end
+    end
+
+    def file_path(blob)
+      "#{FILES_DIRECTORY}/#{blob.id}/#{sanitized_filename(blob)}"
+    end
+
+    def sanitized_filename(blob)
+      filename = File.basename(blob.filename.to_s)
+      filename = "file" if filename.blank?
+      filename.gsub(/[^0-9A-Za-z.\-_]/, "_")
+    end
+
+    def write_files(zip, blobs)
+      blobs.uniq(&:id).each do |blob|
+        zip.add_file(file_path(blob)) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+end
