diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..516efce
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,44 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 64.kilobytes
+
+  class EntryNotFound < StandardError; end
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def entries
+    @entries.map(&:filename)
+  end
+
+  def glob(pattern)
+    entries.select { |entry| File.fnmatch(pattern, entry, File::FNM_PATHNAME | File::FNM_DOTMATCH) }.sort
+  end
+
+  def exists?(path)
+    entries.include?(path)
+  end
+
+  def read(path)
+    buffer = +""
+    each_chunk(path) { |chunk| buffer << chunk }
+    buffer
+  end
+
+  def each_chunk(path, chunk_size: CHUNK_SIZE)
+    entry = find_entry(path)
+    reader = entry.extractor_from(@io)
+
+    until reader.eof?
+      chunk = reader.extract(chunk_size)
+      yield chunk if chunk.present?
+    end
+  end
+
+  private
+    def find_entry(path)
+      @entries.find { |entry| entry.filename == path } ||
+        raise(EntryNotFound, "No such entry in zip: #{path.inspect}")
+    end
+end
