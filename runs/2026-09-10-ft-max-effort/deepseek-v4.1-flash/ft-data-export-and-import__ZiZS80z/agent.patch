@@ -0,0 +1,24 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    Current.with_account(import.account) do
+      import.processing!
+
+      account = import.file.blob.open do |file|
+        Account::DataTransfer::Importer.new(
+          zip: ZipFile::Reader.new(file),
+          importer: import.user
+        ).import
+      end
+
+      import.update!(status: :completed, new_account: account, completed_at: Time.current)
+      AccountMailer.import_completed(import).deliver_now
+    end
+  rescue StandardError => error
+    import.update!(status: :failed, error: error.message, completed_at: Time.current)
+    AccountMailer.import_failed(import).deliver_now
+  end
+end
