+class Account::ExportJobTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "exports the account and emails a download link" do
+    export = @account.exports.create!(user: @user, kind: "account")
+
+    assert_emails 1 do
+      Account::ExportJob.perform_now(export)
+    end
+
+    assert export.reload.completed?
+    assert export.file.attached?
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert_match "expire", ActionMailer::Base.deliveries.last.body.encoded
+  end
