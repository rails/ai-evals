+require "test_helper"
+
+class Account::DataTransfer::ExportImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+
+    @tempfile = Tempfile.new([ "export", ".zip" ])
+    @tempfile.binmode
+    @zip_path = @tempfile.path
+    export_to(@zip_path)
+  end
+
+  teardown do
+    @tempfile.close!
+  end
+
+  test "exports account data as a zip" do
+    reader = open_reader
+
+    assert reader.exists?("manifest.json")
+    assert_equal "account", JSON.parse(reader.read("manifest.json"))["type"]
+    assert reader.glob("boards/*.json").any?
+    assert reader.glob("cards/*.json").any?
+    assert reader.glob("comments/*.json").any?
+    assert reader.glob("users/*.json").any?
+  end
+
+  test "imports an exported account into a new account" do
+    reader = open_reader
+
+    new_account = Account::DataTransfer::Importer.new(zip: reader, importer: @user).import
+
+    assert new_account.persisted?
+    assert_equal @account.name, new_account.name
+    assert_equal @account.boards.count, new_account.boards.count
+    assert_equal @account.cards.count, new_account.cards.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: new_account).count
+    assert new_account.users.find_by(identity: @user.identity).owner?
+  end
+
+test "new cards in an imported account do not collide with imported numbers" do
+  reader = open_reader
+  new_account = Account::DataTransfer::Importer.new(zip: reader, importer: @user).import
+  owner = new_account.users.find_by(identity: @user.identity)
+  board = new_account.boards.first
+
+  Current.set(user: owner, account: new_account) do
+    card = board.cards.create!(title: "A brand new card", status: "published")
+    assert card.number > @account.cards.maximum(:number)
+  end
+end
+
+  private
+    def export_to(path)
+      File.open(path, "wb") do |file|
+        writer = ZipFile::Writer.new(file)
+        Account::DataTransfer::Exporter.new(@account).export(writer)
+        writer.close
+      end
+    end
+
+    def open_reader
+      @reader_io = File.open(@zip_path, "rb")
+      ZipFile::Reader.new(@reader_io)
+    end
+end
