diff --git a/app/jobs/account/export_job.rb b/app/jobs/account/export_job.rb
new file mode 100644
index 0000000..0889ff5
--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,34 @@
+class Account::ExportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(export)
+    Current.with_account(export.account) do
+      export.processing!
+
+      ZipFile.create_for(export.file, filename: filename(export)) do |zip|
+        export_data(export, zip)
+      end
+
+      export.update!(status: :completed, completed_at: Time.current)
+      AccountMailer.export_ready(export).deliver_now
+    end
+  rescue StandardError => error
+    export.update!(status: :failed, error: error.message, completed_at: Time.current)
+    AccountMailer.export_failed(export).deliver_now
+  end
+
+  private
+    def export_data(export, zip)
+      if export.cards?
+        Account::DataTransfer::CardsExporter.new(export.account, user: export.user).export(zip)
+      else
+        Account::DataTransfer::Exporter.new(export.account).export(zip)
+      end
+    end
+
+    def filename(export)
+      [ "fizzy", export.kind, export.account.name.parameterize.presence, export.id ].compact.join("-") + ".zip"
+    end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
