diff --git a/test/jobs/account/import_job_test.rb b/test/jobs/account/import_job_test.rb
new file mode 100644
index 0000000..d9ce506
--- /dev/null
+++ b/test/jobs/account/import_job_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Account::ImportJobTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "imports an account and emails the importer" do
+    import = create_import(account_export_zip)
+
+    assert_emails 1 do
+      Account::ImportJob.perform_now(import)
+    end
+
+    import.reload
+    assert import.completed?
+    assert import.new_account.present?
+    assert_equal @account.name, import.new_account.name
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "leaves nothing behind when the archive is invalid" do
+    import = create_import(invalid_zip)
+
+    assert_no_difference -> { Account.count } do
+      assert_emails 1 do
+        Account::ImportJob.perform_now(import)
+      end
+    end
+
+    import.reload
+    assert import.failed?
+    assert import.new_account.nil?
+    assert import.error.present?
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  private
+    def create_import(path)
+      file = File.open(path, "rb")
+      @account.imports.create!(user: @user, file: file)
+    end
+
+    def account_export_zip
+      export_zip do |zip|
+        Account::DataTransfer::Exporter.new(@account).export(zip)
+      end
+    end
+
+    def invalid_zip
+      export_zip do |zip|
+        zip.add_file("hello.txt", "not an export")
+      end
+    end
+
+    def export_zip
+      @tempfile = Tempfile.new([ "import", ".zip" ])
+      @tempfile.binmode
+      writer = ZipFile::Writer.new(@tempfile)
+      yield writer
+      writer.close
+      @tempfile.flush
+      @tempfile.path
+    end
+end
