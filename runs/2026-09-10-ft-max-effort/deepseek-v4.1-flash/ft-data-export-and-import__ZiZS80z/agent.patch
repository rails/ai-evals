+require "test_helper"
+
+class Account::DataTransfer::CardsExporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+
+    Current.set(user: users(:kevin), account: @account) do
+      boards(:private).cards.create!(title: "Secret project", creator: users(:kevin), status: "published")
