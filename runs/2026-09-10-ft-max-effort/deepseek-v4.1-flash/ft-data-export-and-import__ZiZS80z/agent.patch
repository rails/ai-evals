+    def rewrite_attachment_sgids(body, context)
+      return body if body.blank?
+
+      body.gsub(/sgid="([^"]+)"/) do |match|
+        sgid = $1
+        global_id = GlobalID.parse(sgid)
+
+        if global_id&.model_class == ::ActiveStorage::Blob
+          mapped_blob = ::ActiveStorage::Blob.find_by(id: context.mapped_id(global_id.model_id))
+          mapped_blob ? %(sgid="#{mapped_blob.attachable_sgid}") : match
+        else
+          match
+        end
+      rescue StandardError
+        match
+      end
+    end
 end
