+class Account::DataTransfer::AttachmentRoundTripTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+
+    @card = cards(:logo)
+    @card.image.attach(io: StringIO.new("fake-image-bytes"), filename: "logo.png", content_type: "image/png")
+
+    @tempfile = Tempfile.new([ "export", ".zip" ])
+    @tempfile.binmode
