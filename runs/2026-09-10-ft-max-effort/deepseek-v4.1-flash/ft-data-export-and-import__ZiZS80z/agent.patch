@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+  end
+
+  test "an admin can start an account export" do
+    sign_in_as @admin
+
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_jobs 1, only: Account::ExportJob do
+        post account_exports_url, params: { export: { kind: "account" } }
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.kind
+    assert_equal @account, Export.last.account
+    assert_equal @admin, Export.last.user
+  end
+
+  test "a member cannot start an account export" do
+    sign_in_as @member
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_url, params: { export: { kind: "account" } }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "anyone can start a cards export" do
+    sign_in_as @member
+
+    assert_difference -> { Export.count }, 1 do
+      post account_exports_url, params: { export: { kind: "cards" } }
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "cards", Export.last.kind
+  end
+
+  test "downloads a ready export with a signed token" do
+    export = create_ready_export
+
+    get account_export_url(export.download_token)
+
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+    assert_equal "zip-bytes", response.body
+  end
+
+  test "does not download an expired export" do
+    export = create_ready_export
+    token = export.download_token
+    export.update_column(:created_at, 2.days.ago)
+
+    get account_export_url(token)
+
+    assert_response :not_found
+  end
+
+  test "does not download with an invalid token" do
+    get account_export_url("garbage")
+
+    assert_response :not_found
+  end
+
+  private
+    def create_ready_export
+      @account.exports.create!(user: @admin, kind: "account", status: :completed).tap do |export|
+        export.file.attach(io: StringIO.new("zip-bytes"), filename: "export.zip", content_type: "application/zip")
+      end
+    end
+end
