+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,66 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  before_action :ensure_admin, only: :create, if: :account_export?
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, kind: export_kind)
+
+    Account::ExportJob.perform_later(export)
+
+    redirect_back fallback_location: account_settings_path,
+      notice: "#{export.kind == "cards" ? "Cards" : "Account"} export started. We'll email you a download link when it's ready."
+  end
+
+  def show
+    export = find_export
+
+    if export&.ready? && !export.expired?
+      send_export(export)
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def find_export
+      Export.find_by_download_token(params[:id]) || authenticated_export
+    end
+
+    def authenticated_export
+      Current.account.exports.find_by(id: params[:id]) if authenticated?
+    end
+
+    def account_export?
+      export_kind == "account"
+    end
+
+    def export_kind
+      kind = params.dig(:export, :kind).presence ||
+        params.dig(:export, :type).presence ||
+        params[:kind].presence ||
+        params[:type].presence ||
+        "account"
+      Export::KINDS.include?(kind) ? kind : "account"
+    end
+
+    def send_export(export)
+      blob = export.file.blob
+
+      response.headers["Content-Type"] = "application/zip"
+      response.headers["Content-Disposition"] = ActionDispatch::Http::ContentDisposition.format(
+        disposition: "attachment",
+        filename: export_filename(export)
+      )
+
+      self.response_body = Enumerator.new do |yielder|
+        blob.download do |chunk|
+          yielder << chunk
+        end
+      end
+    end
+
+    def export_filename(export)
+      [ "fizzy", export.kind, export.account.name.parameterize.presence, export.id ].compact.join("-") + ".zip"
+    end
+end
