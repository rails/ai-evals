@@ -0,0 +1,33 @@
+class Export < ApplicationRecord
+  KINDS = %w[ account cards ].freeze
+  EXPIRY = 1.day
+
+  belongs_to :account, default: -> { Current.account }
+  belongs_to :user, default: -> { Current.user }
+
+  has_one_attached :file
+
+  enum :kind, KINDS.index_by(&:itself)
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  validates :kind, presence: true
+
+  scope :completed, -> { where(status: :completed) }
+  scope :recent, -> { order(created_at: :desc) }
+
+  def ready?
+    completed? && file.attached?
+  end
+
+  def expired?
+    (completed_at || created_at) < EXPIRY.ago
+  end
+
+  def download_token
+    signed_id(expires_in: EXPIRY, purpose: :download)
+  end
+
+  def self.find_by_download_token(token)
+    find_signed(token, purpose: :download)
+  end
+end
