+  test "records a failure and emails the user" do
+    export = @account.exports.create!(user: @user, kind: "account")
+
+    Account::DataTransfer::Exporter.any_instance.stubs(:export).raises("boom")
+
+    assert_emails 1 do
+      Account::ExportJob.perform_now(export)
+    end
+
+    assert export.reload.failed?
