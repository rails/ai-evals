diff --git a/app/models/account/data_transfer/import_context.rb b/app/models/account/data_transfer/import_context.rb
new file mode 100644
index 0000000..cd886ff
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,40 @@
+class Account::DataTransfer::ImportContext
+  attr_reader :account, :importer, :manifest
+
+  def initialize(account:, importer: nil, manifest: nil)
+    @account = account
+    @importer = importer
+    @manifest = manifest
+    @id_map = {}
+    @uploads = []
+  end
+
+  def register(old_id, new_id)
+    return if old_id.blank? || new_id.blank?
+    @id_map[old_id.to_s] = new_id.to_s
+  end
+
+  def mapped_id(id)
+    return id if id.blank?
+    @id_map.fetch(id.to_s, id)
+  end
+
+  def remap?(id)
+    id.present? && @id_map.key?(id.to_s)
+  end
+
+  def record_upload(blob)
+    @uploads << blob
+  end
+
+  # Removes any files written to storage for a failed import. Blob records are
+  # rolled back with the transaction, but the underlying bytes are not.
+  def cleanup!
+    @uploads.each do |blob|
+      blob.service.delete(blob.key)
+    rescue StandardError => error
+      Rails.error.report(error, severity: :warning, context: { blob_id: blob.id })
+    end
+    @uploads.clear
+  end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
