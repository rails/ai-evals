--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,92 @@
+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  attr_reader :zip, :importer
+
+  def initialize(zip:, importer:)
+    @zip = zip
+    @importer = importer
+  end
+
+  def import
+    manifest = read_manifest
+
+    account = nil
+    context = nil
+
+    begin
+      Account.transaction do
+        account = Account.create!(name: account_name(manifest))
+
+        Current.with_account(account) do
+          context = Account::DataTransfer::ImportContext.new(account: account, importer: importer, manifest: manifest)
+
+          Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+            record_set.import(zip, context)
+          end
+
+          owner = ensure_owner(context)
+          restore_cards_count(account)
+          reconcile_storage(account, owner)
+        end
+      end
+    rescue StandardError
+      context&.cleanup!
+      raise
+    end
+
+    account
+  end
+
+  private
+    def read_manifest
+      raise InvalidArchive, "The uploaded file is not a Fizzy export" unless zip.exists?(Account::DataTransfer::Manifest::FILENAME)
+
+      JSON.parse(zip.read(Account::DataTransfer::Manifest::FILENAME)).tap do |manifest|
+        unless manifest.is_a?(Hash) && manifest["type"] == "account"
+          raise InvalidArchive, "The uploaded file is not a Fizzy account export"
+        end
+      end
+    rescue JSON::ParserError
+      raise InvalidArchive, "The uploaded file is not a valid Fizzy export"
+    end
+
+    def account_name(manifest)
+      manifest.dig("account", "name").presence || "Imported account"
+    end
+
+    def ensure_owner(context)
+      account = context.account
+      identity = importer.identity
+
+      if user = account.users.find_by(identity: identity)
+        user.update_columns(role: User.roles.fetch("owner"), active: true, verified_at: user.verified_at || Time.current)
+        user
+      else
+        now = Time.current
+        User.insert! \
+          "id" => ActiveRecord::Type::Uuid.generate,
+          "account_id" => account.id,
+          "identity_id" => identity.id,
+          "name" => importer.name,
+          "role" => User.roles.fetch("owner"),
+          "active" => true,
+          "verified_at" => now,
+          "created_at" => now,
+          "updated_at" => now
+        account.users.find_by(identity: identity)
+      end
+    end
+
+    def restore_cards_count(account)
+      account.update_column(:cards_count, account.cards.maximum(:number) || 0)
+    end
+
+    def reconcile_storage(account, owner)
+      Current.set(user: owner, account: account) do
+        account.reconcile_storage
+      end
+    rescue StandardError => error
+      Rails.error.report(error, severity: :warning, context: { account_id: account.id })
+    end
+end
