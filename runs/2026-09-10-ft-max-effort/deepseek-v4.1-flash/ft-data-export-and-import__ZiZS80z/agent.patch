@@ -0,0 +1,59 @@
+require "test_helper"
+
+class AccountDataTransferMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "export_ready sends the download link to the requester" do
+    export = @account.exports.create!(user: @user, kind: "account", status: :completed, completed_at: Time.current)
+    export.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+
+    email = AccountMailer.export_ready(export)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy export is ready", email.subject
+    assert_match "/#{@account.slug.delete_prefix("/")}/account/exports/", email.body.encoded
+    assert_match "24 hours", email.body.encoded
+  end
+
+  test "export_failed includes the reason" do
+    export = @account.exports.create!(user: @user, kind: "account", status: :failed, error: "disk on fire")
+
+    email = AccountMailer.export_failed(export)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "disk on fire", email.body.encoded
+  end
+
+  test "import_completed links to the new account" do
+    new_account = Account.create!(name: "Imported")
+    import = create_import(status: :completed, new_account: new_account)
+
+    email = AccountMailer.import_completed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "Imported", email.body.encoded
+    assert_match new_account.slug, email.body.encoded
+  end
+
+  test "import_failed includes the reason" do
+    import = create_import(status: :failed, error: "bad archive")
+
+    email = AccountMailer.import_failed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "bad archive", email.body.encoded
+  end
+
+  private
+    def create_import(**attributes)
+      @account.imports.new(user: @user, **attributes).tap do |import|
+        import.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+        import.save!
+      end
+    end
+end
