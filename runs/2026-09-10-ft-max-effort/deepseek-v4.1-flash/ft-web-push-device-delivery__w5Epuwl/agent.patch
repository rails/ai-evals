diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..4c1ca21
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,43 @@
+class PushSubscription < ApplicationRecord
+  VAPID_SUBJECT = "mailto:support@fizzy.do"
+
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def register(user:, endpoint:, p256dh_key:, auth_key:)
+      user.push_subscriptions.find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(p256dh_key: p256dh_key, auth_key: auth_key)
+      end
+    end
+  end
+
+  # Delivers a web push notification for the given +Notification+ using the
+  # message the tray would show for it.
+  def deliver(notification)
+    WebPush.payload_send \
+      endpoint: endpoint,
+      message: notification.push_payload.to_json,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: VAPID_SUBJECT,
+        public_key: self.class.vapid_public_key,
+        private_key: self.class.vapid_private_key
+      }
+  end
+end
