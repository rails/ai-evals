diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..7f06e31
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,29 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    PushSubscription.register(user: @user, **push_subscription_params.to_h.symbolize_keys)
+
+    head :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    subscription = @user.push_subscriptions.find_by(endpoint: params[:endpoint]) ||
+      @user.push_subscriptions.find_by(id: params[:id])
+
+    subscription&.destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.identity.users.find_by!(id: params[:user_id], account: Current.account)
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..d683248
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,141 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details", "unsupported" ]
+  static values = {
+    userId: String,
+    subscriptionUrl: String,
+    vapidPublicKey: String
+  }
+
+  connect() {
+    this.#updateState()
+  }
+
+  async enable() {
+    if (!this.#supported) {
+      this.#showUnsupported()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.#updateState()
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+      }
+
+      await this.#register(subscription)
+    } catch (error) {
+      console.error("Could not enable push notifications", error)
+    }
+
+    this.#updateState()
+  }
+
+  async disable() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#unregister(subscription)
+        await subscription.unsubscribe()
+      }
+    } catch (error) {
+      console.error("Could not disable push notifications", error)
+    }
+
+    this.#updateState()
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - (this.vapidPublicKeyValue.length % 4)) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const bytes = atob(base64)
+    return Uint8Array.from(bytes, (char) => char.charCodeAt(0))
+  }
+
+  get #csrfToken() {
+    return document.querySelector("meta[name='csrf-token']")?.getAttribute("content")
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      },
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      })
+    })
+  }
+
+  async #unregister(subscription) {
+    const url = new URL(this.subscriptionUrlValue, window.location.origin)
+    url.searchParams.set("endpoint", subscription.endpoint)
+
+    await fetch(url.toString(), {
+      method: "DELETE",
+      headers: { "X-CSRF-Token": this.#csrfToken }
+    })
+  }
+
+  async #subscription() {
+    if (!this.#supported) return null
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      return await registration.pushManager.getSubscription()
+    } catch {
+      return null
+    }
+  }
+
+  async #updateState() {
+    if (!this.#supported) {
+      this.#showUnsupported()
+      this.element.classList.remove("notifications--on")
+      return
+    }
+
+    const permission = Notification.permission
+    const subscription = await this.#subscription()
+
+    this.element.classList.toggle("notifications--on", Boolean(subscription) && permission === "granted")
+    this.#toggleDetails(permission === "denied")
+  }
+
+  #toggleDetails(show) {
+    this.detailsTargets.forEach((details) => {
+      details.hidden = !show
+    })
+  }
+
+  #showUnsupported() {
+    this.element.classList.remove("notifications--on")
+    if (this.hasUnsupportedTarget) this.unsupportedTarget.hidden = false
+  }
+}
