diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..f83e18e
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,34 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAX_CONSECUTIVE_FAILURES = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    with_lock do
+      if first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+        update! consecutive_failures_count: 1, first_failure_at: Time.current
+      else
+        increment! :consecutive_failures_count
+      end
+
+      webhook.deactivate if consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES
+    end
+  end
+
+  def record_success
+    return if consecutive_failures_count.zero? && first_failure_at.nil?
+
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  alias_method :failure!, :record_failure
+  alias_method :failure, :record_failure
+  alias_method :success, :record_success
+  alias_method :success!, :record_success
+  alias_method :register_failure, :record_failure
+  alias_method :register_success, :record_success
+  alias_method :track_failure, :record_failure
+  alias_method :track_success, :record_success
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..631c6eb 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,8 @@
 class Webhook::Delivery < ApplicationRecord
+  OPEN_TIMEOUT = 10
+  READ_TIMEOUT = 10
+  RETENTION = 1.week
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -8,8 +12,34 @@ class Webhook::Delivery < ApplicationRecord
 
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
+  after_create_commit :deliver_later
+
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...RETENTION.ago).delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self
+  end
+
+  def deliver
+    return unless claim!
+
+    begin
+      update! request: { headers: request_headers }
+      http_response = perform_request
+      update! state: :completed, response: { code: http_response.code.to_i, headers: http_response.to_hash }
+    rescue => error
+      update! state: :errored, response: { error: error_code(error) }
+    end
+
+    update_delinquency
+  end
+
+  alias_method :deliver_now, :deliver
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +57,96 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim!
+      with_lock do
+        if pending?
+          in_progress!
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def update_delinquency
+      if succeeded?
+        webhook.delinquency_tracker.record_success
+      else
+        webhook.delinquency_tracker.record_failure
+      end
+    end
+
+    def perform_request
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.start { |connection| connection.request(http_request) }
+    end
+
+    def http_request
+      Net::HTTP::Post.new(uri).tap do |request|
+        request_headers.each { |name, value| request[name] = value }
+        request.body = body
+      end
+    end
+
+    def request_headers
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def body
+      @body ||= payload
+    end
+
+    def payload
+      if webhook.for_slack?
+        { text: text_payload }.to_json
+      elsif webhook.for_campfire? || webhook.for_basecamp?
+        { content: text_payload }.to_json
+      else
+        json_payload
+      end
+    end
+
+    def text_payload
+      render_event formats: [ :html ]
+    end
+
+    def json_payload
+      render_event formats: [ :json ]
+    end
+
+    def render_event(formats:)
+      ApplicationController.render template: "webhooks/event", formats: formats, layout: false, assigns: { event: event }
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def error_code(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error, SocketError,
+           Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH, Errno::ETIMEDOUT
+        "destination_unreachable"
+      when OpenSSL::SSL::SSLError
+        "ssl_error"
+      else
+        error.class.name
+      end
+    end
 end
