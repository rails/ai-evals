diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..558205f
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,54 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_AUTHOR_COUNT = 2
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      active.where(
+        "stalled_at IS NOT NULL OR ((last_burst_at IS NOT NULL OR burst_at IS NOT NULL) AND last_active_at <= ?)",
+        STALLED_AFTER.ago
+      )
+    }
+  end
+
+  def stalled?
+    return false unless active?
+    stalled_at.present? || (burst? && last_active_at <= STALLED_AFTER.ago)
+  end
+
+  def burst?
+    last_burst_at.present? || burst_at.present?
+  end
+  alias_method :bursting?, :burst?
+
+  def record_burst(at: Time.current)
+    update! last_burst_at: at, burst_at: at
+  end
+
+  def reset_burst
+    update! last_burst_at: nil, burst_at: nil if burst?
+  end
+
+  def detect_burst(at: Time.current)
+    reset_burst
+
+    recent_comments = comments.by_user.where(created_at: (at - burst_window)..at)
+
+    if recent_comments.count >= BURST_COMMENT_COUNT && recent_comments.distinct.count(:creator_id) >= BURST_AUTHOR_COUNT
+      record_burst at: at
+    end
+  end
+
+  private
+    def burst_window
+      (auto_postpone_period || ::Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days).to_f / 3
+    end
+
+    def burst_action?(action)
+      action.to_s.in?(BURST_ACTIONS)
+    end
+end
