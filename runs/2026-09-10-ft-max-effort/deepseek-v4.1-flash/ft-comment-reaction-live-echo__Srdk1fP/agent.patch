+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:kevin)
+  end
+
+  test "adding, revealing and removing a reaction on a comment" do
+    comment = comments(:logo_agreement_jz)
+    visit card_path(comment.card)
+
+    within strip_for(comment) do
+      assert_no_selector ".reaction"
+
+      find("button[aria-label='Add a reaction']").click
+      assert_selector ".reaction__input", visible: true
+
+      find(".reaction__input").set("🎉")
+      find("button[aria-label='Add reaction']").click
+
+      assert_selector ".reaction .reaction__form-label", text: "🎉"
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector "button[aria-label='Add a reaction']", visible: true
+    end
+
+    within strip_for(comment) do
+      find(".reaction .reaction__form-label").click
+      assert_selector ".reaction.expanded .reaction__delete", visible: true
+
+      find("button[aria-label='Remove your reaction']").click
+      assert_no_selector ".reaction"
+    end
+  end
+
+  test "adding a reaction to a card" do
+    card = cards(:layout)
+    visit card_path(card)
+
+    within strip_for(card) do
+      assert_no_selector ".reaction"
+
+      find("button[aria-label='Add a reaction']").click
+      find(".reaction__input").set("🚀")
+      find("button[aria-label='Add reaction']").click
+
+      assert_selector ".reaction .reaction__form-label", text: "🚀"
+
+      find(".reaction .reaction__form-label").click
+      assert_selector ".reaction.expanded .reaction__delete", visible: true
+      find("button[aria-label='Remove your reaction']").click
+
+      assert_no_selector ".reaction"
+    end
+  end
+
+  test "the emoji picker fills the reaction input" do
+    comment = comments(:logo_agreement_jz)
+    visit card_path(comment.card)
+
+    within strip_for(comment) do
+      find("button[aria-label='Add a reaction']").click
+      find("button[aria-label='Choose an emoji']").click
+      find("button[data-emoji='👍']").click
+
+      assert_equal "👍", find(".reaction__input").value
+    end
+  end
+
+  test "reactions added elsewhere appear on the card without reloading" do
+    comment = comments(:logo_agreement_jz)
+    visit card_path(comment.card)
+
+    within strip_for(comment) do
+      assert_no_selector ".reaction"
+    end
+
+    wait_for_cable_subscriptions
+    Reaction.create!(reactable: comment, reacter: users(:jz), content: "🎉")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within strip_for(comment) do
+      assert_selector ".reaction .reaction__form-label", text: "🎉", wait: 5
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def strip_for(reactable)
+      "#reactions_#{reactable.model_name.singular}_#{reactable.id}"
+    end
+end
