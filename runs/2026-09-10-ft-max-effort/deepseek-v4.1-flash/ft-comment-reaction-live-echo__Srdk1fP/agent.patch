diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..11fc6e6
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,31 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    case reactable
+    when Card then card_reactions_path(reactable)
+    when Comment then card_comment_reactions_path(reactable.card, reactable)
+    end
+  end
+
+  def reactions_url_for(reactable)
+    case reactable
+    when Card then card_reactions_url(reactable)
+    when Comment then card_comment_reactions_url(reactable.card, reactable)
+    end
+  end
+
+  def reaction_path_for(reaction, reactable = nil)
+    reactable ||= reaction.reactable
+
+    case reactable
+    when Card then card_reaction_path(reactable, reaction)
+    when Comment then card_comment_reaction_path(reactable.card, reactable, reaction)
+    end
+  end
+
+  def reaction_url_for(reaction)
+    case reaction.reactable
+    when Card then card_reaction_url(reaction.reactable, reaction)
+    when Comment then card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction)
+    end
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..fb0f128
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,42 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger", "item" ]
+
+  itemTargetConnected(element) {
+    element.classList.toggle("reaction--deleteable", this.#isMine(element))
+  }
+
+  openForm(event) {
+    event.preventDefault()
+
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  closeForm() {
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.formTarget.reset()
+    this.triggerTarget.hidden = false
+  }
+
+  pickEmoji(event) {
+    this.inputTarget.value = event.currentTarget.dataset.emoji
+    this.inputTarget.focus()
+  }
+
+  toggle(event) {
+    const item = event.currentTarget.closest(".reaction")
+
+    if (item && this.#isMine(item)) {
+      item.classList.toggle("expanded")
+    }
+  }
+
+  #isMine(element) {
+    return element.dataset.creatorId === window.Current?.user?.id
+  }
+}
