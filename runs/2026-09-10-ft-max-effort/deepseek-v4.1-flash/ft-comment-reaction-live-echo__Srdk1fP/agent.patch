+        </div>
+      </dialog>
+    </div>
+
+    <button type="submit" class="reaction__submit-btn btn" title="Add reaction" aria-label="Add reaction">
+      <%= icon_tag "check" %>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn" title="Cancel" aria-label="Cancel"
+            data-action="reaction#closeForm">
+      <%= icon_tag "close" %>
+    </button>
+  <% end %>
+
+  <button type="button" class="reactions__trigger btn btn--circle" title="Add a reaction" aria-label="Add a reaction"
+          data-reaction-target="trigger" data-action="reaction#openForm">
+    <%= image_tag "boost-color.svg", alt: "", size: 24 %>
+  </button>
+</div>
