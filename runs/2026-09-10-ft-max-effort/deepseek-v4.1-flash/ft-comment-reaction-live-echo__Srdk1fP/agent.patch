new file mode 100644
index 0000000..5767dda
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(comment.card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.size
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal "👍", comment.reactions.last.content
+    assert_equal users(:kevin), comment.reactions.last.reacter
+  end
+
+  test "create with flat params" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { content: "Nice!" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Nice!", comment.reactions.last.content
+  end
+
+  test "create rejects blank content" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "  " } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create rejects content longer than 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on a draft card is forbidden" do
+    card = cards(:logo)
+    comment = card.comments.create!(creator: users(:kevin), body: "Draft comment")
+    card.update_columns(status: Card.statuses[:drafted])
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create broadcasts a card refresh" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_turbo_stream_broadcasts comment.card, count: 1 do
+      perform_enqueued_jobs do
+        post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+      end
+    end
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    comment = reaction.comment
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_heart)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    comment = reaction.comment
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
