new file mode 100644
index 0000000..5d7b316
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "valid with content" do
+    assert build_reaction(content: "👍").valid?
+  end
+
+  test "requires content" do
+    reaction = build_reaction(content: "   ")
+
+    assert_not reaction.valid?
+    assert reaction.errors[:content].any?
+  end
+
+  test "content is limited to 16 characters" do
+    assert build_reaction(content: "a" * 16).valid?
+
+    reaction = build_reaction(content: "a" * 17)
+    assert_not reaction.valid?
+    assert reaction.errors[:content].any?
+  end
+
+  test "strips surrounding whitespace" do
+    reaction = build_reaction(content: "  hi there  ")
+    reaction.save!
+
+    assert_equal "hi there", reaction.content
+  end
+
+  test "touches its reactable when created" do
+    before = @comment.updated_at
+
+    build_reaction(content: "🎉").save!
+
+    assert_operator @comment.reload.updated_at, :>, before
+  end
+
+  test "defaults its account and reacter to the current context" do
+    Current.user = users(:kevin)
+    reaction = @comment.reactions.create!(content: "🔥")
+
+    assert_equal @comment.account, reaction.account
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "can react to a card" do
+    card = cards(:logo)
+    before = card.updated_at
+
+    reaction = card.reactions.create!(reacter: users(:kevin), content: "🚀")
+
+    assert reaction.card?
+    assert_equal card, reaction.reactable
+    assert_operator card.reload.updated_at, :>, before
+  end
+
+  private
+    def build_reaction(content:)
+      @comment.reactions.new(reacter: users(:kevin), content: content)
+    end
+end
