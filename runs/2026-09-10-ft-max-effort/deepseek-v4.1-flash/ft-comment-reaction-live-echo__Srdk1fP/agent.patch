+<% input_id = dom_id(reactable, :reaction_input) %>
+<div id="<%= dom_id(reactable, :reactions) %>" class="reactions" data-controller="reaction">
+  <div class="reactions__list">
+    <%= render partial: "reactions/reaction", collection: reactable.reactions.chronologically, as: :reaction, locals: { reactable: reactable } %>
+  </div>
+
+  <%= form_with url: reactions_path_for(reactable), scope: :reaction, html: { hidden: true },
+        class: class_names("reaction__form", "flex", "align-center", "gap-half"),
+        data: { reaction_target: "form", action: "keydown.esc->reaction#closeForm" } do |form| %>
+    <%= form.label :content, "Add a reaction", for: input_id, class: "reaction__form-label for-screen-reader" %>
+    <%= form.text_field :content, id: input_id, class: "input reaction__input", maxlength: Reaction::MAX_LENGTH,
+          autocomplete: "off", placeholder: "React…", required: true,
+          data: { reaction_target: "input" } %>
+
+    <div class="reaction__menu" data-controller="dialog">
+      <button type="button" class="reaction__menu-btn btn" title="Choose an emoji" aria-label="Choose an emoji"
+              data-action="click->dialog#toggle">
+        <%= icon_tag "reaction" %>
+      </button>
+
+      <dialog class="reaction__popup popup panel" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, description| %>
