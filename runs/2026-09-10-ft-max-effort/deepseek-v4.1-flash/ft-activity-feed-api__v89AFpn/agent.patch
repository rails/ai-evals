@@ -1,6 +1,24 @@
 class Event < ApplicationRecord
   include Notifiable, Particulars, Promptable
 
+  # Events surfaced by the Activities API. Mirrors the HTML timeline, except
+  # deprecated card_collection_changed events are omitted and card_title_changed
+  # events are included.
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
   belongs_to :account, default: -> { board.account }
   belongs_to :board
   belongs_to :creator, class_name: "User"
@@ -37,6 +55,29 @@ class Event < ApplicationRecord
     Event::Description.new(self, user)
   end
 
+  # Event-specific details exposed by the Activities API. Values that are
+  # absent are returned as empty strings (or an empty array for assignments).
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { "assignee_ids" => Array(assignee_ids) }
+    when "card_board_changed"
+      {
+        "old_board" => particulars.dig("particulars", "old_board").to_s,
+        "new_board" => particulars.dig("particulars", "new_board").to_s
+      }
+    when "card_title_changed"
+      {
+        "old_title" => particulars.dig("particulars", "old_title").to_s,
+        "new_title" => particulars.dig("particulars", "new_title").to_s
+      }
+    when "card_triaged", "card_sent_back_to_triage"
+      { "column" => particulars.dig("particulars", "column").to_s }
+    else
+      {}
+    end
+  end
+
   private
     def dispatch_webhooks
       Event::WebhookDispatchJob.perform_later(self)
