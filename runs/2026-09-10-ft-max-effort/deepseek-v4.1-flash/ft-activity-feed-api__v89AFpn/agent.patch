+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+    fresh_when etag: @page.records
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events
+        .preloaded
+        .where(action: Event::ACTIVITY_ACTIONS)
+
+      events = events.where(events: { creator_id: creator_ids }) if creator_ids.any?
+      events = events.where(events: { board_id: board_ids }) if board_ids.any?
+
+      events.order(events: { created_at: :desc, id: :desc })
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
