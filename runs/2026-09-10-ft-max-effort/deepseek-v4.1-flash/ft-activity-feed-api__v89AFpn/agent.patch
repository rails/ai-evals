+# Activities
+
+Activities are the events that make up an account's timeline: cards being added, moved, renamed, closed, commented on, and so on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity the current user has access to, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user ID(s) who performed the action |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_published",
+    "created_at": "2025-12-05T19:38:48.540Z",
+    "description": "David added &quot;First!&quot;",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 4,
+      "title": "First!",
+      "status": "published",
+      "description": "Hello, World!",
+      "description_html": "<div class=\"action-text-content\"><p>Hello, World!</p></div>",
+      "image_url": null,
+      "has_attachments": false,
+      "tags": [],
+      "closed": false,
+      "postponed": false,
+      "golden": false,
+      "last_active_at": "2025-12-05T19:38:48.553Z",
+      "created_at": "2025-12-05T19:38:48.540Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+      "board": { "id": "03f5v9zkft4hj9qq0lsn9ohcm", "name": "Fizzy" },
+      "creator": { "id": "03f5v9zjw7pz8717a4no1h8a7", "name": "David Heinemeier Hansson" }
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+For card events, `url` opens the card. For comment events, `url` opens the card where the comment was posted and jumps to the comment. The `eventable` is the card or comment the event is about, using the same representation as the Cards and Comments endpoints.
+
+The `particulars` object exposes event-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged`, `card_sent_back_to_triage` | `column` |
+
+Other events return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..2df23ca
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "requires authentication" do
+    sign_out
+    get activities_path(format: :json)
+    assert_response :redirect
+  end
+
+  test "index returns a flat array of activity" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any?
+  end
+
+  test "index returns the expected fields" do
+    get activities_path(format: :json)
+
+    event = events(:logo_published)
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+
+    assert_equal %w[ action board created_at creator description eventable
+                     eventable_type id particulars url ].sort, activity.keys.sort
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+  end
+
+  test "index returns newest activity first" do
+    get activities_path(format: :json)
+
+    timestamps = @response.parsed_body.map { |a| Time.zone.parse(a["created_at"]) }
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  test "index omits deprecated card_collection_changed events" do
+    event = events(:logo_published)
+    event.update_column(:action, "card_collection_changed")
+
+    get activities_path(format: :json)
+
+    assert_not @response.parsed_body.any? { |a| a["id"] == event.id }
+  end
+
+  test "index includes card_title_changed events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_not_nil activity
+    assert_equal "card_title_changed", activity["action"]
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "index exposes assignment particulars" do
+    event = events(:logo_assignment_km)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal [ users(:kevin).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index exposes board change particulars" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old", "new_board" => "New" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, activity["particulars"])
+  end
+
+  test "index exposes triage particulars" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "column" => "In progress" }, activity["particulars"])
+  end
+
+  test "index returns empty strings for missing particular values" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: {})
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "index returns empty particulars for other events" do
+    get activities_path(format: :json)
+
+    event = events(:logo_published)
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index returns card url for card events" do
+    get activities_path(format: :json)
+
+    event = events(:logo_published)
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal card_url(event.eventable), activity["url"]
+  end
+
+  test "index returns card url with comment anchor for comment events" do
+    event = events(:layout_commented)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal card_url(event.eventable.card, anchor: dom_id(event.eventable)), activity["url"]
+  end
+
+  test "index returns plain text description" do
+    get activities_path(format: :json)
+
+    event = events(:layout_commented)
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+  end
+
+  test "index filters by creator_ids" do
+    get activities_path(format: :json, creator_ids: [ users(:david).id ])
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |a| a.dig("creator", "id") == users(:david).id }
+  end
+
+  test "index filters by board_ids" do
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ])
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |a| a.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index only returns activity for boards the user can access" do
+    private_event = with_current_user(users(:kevin)) do
+      boards(:private).cards.create!(title: "Private card", status: "published").events.sole
+    end
+
+    sign_out
+    sign_in_as :jz
+
+    get activities_path(format: :json)
+
+    assert_not @response.parsed_body.any? { |a| a["id"] == private_event.id }
+  end
+
+  test "index paginates" do
+    card = cards(:logo)
+    20.times do |i|
+      card.events.create!(action: "card_published", creator: users(:kevin), board: card.board, created_at: (i + 1).hours.ago)
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert @response.headers["Link"].present?
+
+    get activities_path(format: :json, page: 2)
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+
+  test "index works with a bearer token" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+end
