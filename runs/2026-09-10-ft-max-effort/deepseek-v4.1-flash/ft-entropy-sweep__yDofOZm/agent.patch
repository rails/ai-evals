diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..18f35f3 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,9 +24,25 @@ module Card::Entropic
   end
 
   class_methods do
+    # Postpones every card that has been inactive for longer than its effective
+    # entropy period. This can process a very large number of cards, so we do it
+    # in batches with as little per-card overhead as possible:
+    #
+    # * suppressing turbo broadcasts and touch callbacks, since nobody is
+    #   watching a background sweep in real time and the board's updated_at is
+    #   meaningless for a bulk move.
+    # * memoizing the account system user, which would otherwise be loaded once
+    #   per card.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      Card.suppressing_turbo_broadcasts do
+        Card.no_touching do
+          system_users = {}
+
+          due_to_be_postponed.find_each do |card|
+            system_users[card.account_id] ||= card.account.system_user
+            card.auto_postpone(user: system_users[card.account_id])
+          end
+        end
       end
     end
   end
