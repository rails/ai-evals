diff --git a/app/models/concerns/notifiable.rb b/app/models/concerns/notifiable.rb
index 4723229..11f49af 100644
--- a/app/models/concerns/notifiable.rb
+++ b/app/models/concerns/notifiable.rb
@@ -17,6 +17,13 @@ module Notifiable
 
   private
     def notify_recipients_later
-      NotifyRecipientsJob.perform_later self
+      NotifyRecipientsJob.perform_later self unless notifiable_creator&.system?
+    end
+
+    # Template method. Notifications triggered by a system user have no
+    # recipients (Notifier#should_notify? ignores them), so we avoid enqueueing
+    # a job that would immediately do nothing.
+    def notifiable_creator
+      nil
     end
 end
