diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..93dce51
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,140 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+const COLUMN_SELECTOR = "[data-drag-and-drop-target='column']"
+const CARD_SELECTOR = "[data-drag-and-drop-target='card']"
+
+// Cards can be dragged between columns (and to/from the Maybe?, Not Now and
+// Done columns) to change their column or status. The move is reflected in the
+// DOM as soon as the card is dropped and persisted in the background, so the
+// board never waits on (or re-renders after) the save.
+export default class extends Controller {
+  #draggedCard = null
+  #sourceColumn = null
+  #hoverColumn = null
+
+  dragstart(event) {
+    const card = this.#cardFor(event.target)
+    if (!card) return
+
+    this.#draggedCard = card
+    this.#sourceColumn = this.#columnFor(card)
+    card.classList.add(DRAGGED_CLASS)
+    card.setAttribute("aria-grabbed", "true")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragend() {
+    this.#draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.#draggedCard?.removeAttribute("aria-grabbed")
+    this.#clearHover()
+
+    this.#draggedCard = null
+    this.#sourceColumn = null
+  }
+
+  dragover(event) {
+    const column = this.#columnFor(event.target)
+
+    if (column) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      if (column !== this.#hoverColumn) this.#setHover(column)
+    } else {
+      this.#clearHover()
+    }
+  }
+
+  dragleave(event) {
+    if (!this.element.contains(event.relatedTarget)) this.#clearHover()
+  }
+
+  drop(event) {
+    const card = this.#draggedCard
+    const column = this.#columnFor(event.target)
+    const sourceColumn = this.#sourceColumn
+
+    this.#clearHover()
+
+    if (!card || !column) return
+
+    event.preventDefault()
+
+    // Columns keep their own order: only move cards between columns.
+    if (column === sourceColumn) return
+
+    const list = this.#insertCard(card, column)
+    if (!list) return
+
+    this.#persist(card, column).catch(() => this.#revert(card, sourceColumn))
+  }
+
+  // Private
+
+  #cardFor(node) {
+    return node.closest?.(CARD_SELECTOR)
+  }
+
+  #columnFor(node) {
+    return node.closest?.(COLUMN_SELECTOR)
+  }
+
+  #setHover(column) {
+    this.#clearHover()
+    column.classList.add(HOVER_CLASS)
+    this.#hoverColumn = column
+  }
+
+  #clearHover() {
+    this.#hoverColumn?.classList.remove(HOVER_CLASS)
+    this.#hoverColumn = null
+  }
+
+  #insertCard(card, column) {
+    const list = column.querySelector(".cards__list")
+    if (!list) return null
+
+    // Cards are ordered with golden ones first and then by recency, and moving
+    // a card makes it the most recent, so it belongs at the top of its new
+    // column (after any golden cards already pinned there).
+    const cards = Array.from(list.querySelectorAll(".card"))
+    const firstRegularCard = cards.find(card => !card.classList.contains("golden-effect"))
+
+    if (firstRegularCard) {
+      firstRegularCard.parentNode.insertBefore(card, firstRegularCard)
+    } else if (cards.length > 0) {
+      cards.at(-1).after(card)
+    } else {
+      list.prepend(card)
+    }
+
+    return list
+  }
+
+  async #persist(card, column) {
+    switch (column.dataset.dragAndDropKind) {
+      case "maybe":
+        return await destroy(card.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+      case "not_now":
+        return await post(card.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+      case "closed":
+        return await post(card.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+      default: {
+        const body = new FormData()
+        body.append("column_id", column.dataset.dragAndDropColumnId)
+        return await post(card.dataset.dragAndDropTriageUrl, { body, responseKind: "json" })
+      }
+    }
+  }
+
+  #revert(card, sourceColumn) {
+    sourceColumn?.querySelector(".cards__list")?.prepend(card)
+  }
+}
