diff --git a/app/views/mailers/notification_mailer/_bundle.html.erb b/app/views/mailers/notification_mailer/_bundle.html.erb
new file mode 100644
index 0000000..93db758
--- /dev/null
+++ b/app/views/mailers/notification_mailer/_bundle.html.erb
@@ -0,0 +1,36 @@
+<% script_name = @bundle.account.slug %>
+
+<h1 class="title">New notifications</h1>
+
+<p class="subtitle">
+  You have <%= pluralize @notifications.size, "new notification" %>.
+</p>
+
+<% @boards.each_with_index do |(board, notifications), index| %>
+  <% if index.positive? %>
+    <hr class="notification__board-separator" aria-hidden="true">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board, script_name: script_name) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <% source = notification.source %>
+    <% helper_body = source.is_a?(Event) ? event_notification_body(source) : nil %>
+    <div class="notification">
+      <p class="notification__author"><%= notification.creator.familiar_name %></p>
+
+      <div class="notification__details">
+        <p class="card__title"><%= link_to payload.title, payload.url %></p>
+        <p><%= payload.body %></p>
+        <% if helper_body.present? && helper_body != payload.body %>
+          <p><%= helper_body %></p>
+        <% end %>
+      </div>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="margin-block-start-double">
+  <%= link_to "Visit Fizzy", root_url(script_name: script_name) %>
+</p>
diff --git a/app/views/mailers/notification_mailer/_bundle.text.erb b/app/views/mailers/notification_mailer/_bundle.text.erb
