+<% script_name = @bundle.account.slug %>
+
+New notifications
+
+You have <%= pluralize @notifications.size, "new notification" %>.
+
+<% @boards.each do |board, notifications| %>
+<%= board.name %>
+<%= "-" * board.name.length %>
+
+<% notifications.each do |notification| %>
+<% payload = notification.payload %>
+<% source = notification.source %>
+<% helper_body = source.is_a?(Event) ? event_notification_body(source) : nil %>
+* <%= payload.title %>
+  <%= payload.body %>
+<% if helper_body.present? && helper_body != payload.body %>
+  <%= helper_body %>
+<% end %>
+  <%= payload.url %>
+
+<% end %>
+<% end %>
+
+Visit Fizzy: <%= root_url(script_name: script_name) %>
