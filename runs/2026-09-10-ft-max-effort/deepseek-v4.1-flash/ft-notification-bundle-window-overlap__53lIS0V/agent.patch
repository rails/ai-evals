--- /dev/null
+++ b/app/jobs/notification/bundle_job.rb
@@ -0,0 +1,12 @@
+class Notification::BundleJob < ApplicationJob
+  def perform(record = nil)
+    case record
+    when Notification
+      Notification::Bundle.add(record)
+    when Notification::Bundle
+      record.deliver
+    when nil
+      Notification::Bundle.deliver_due
+    end
+  end
+end
