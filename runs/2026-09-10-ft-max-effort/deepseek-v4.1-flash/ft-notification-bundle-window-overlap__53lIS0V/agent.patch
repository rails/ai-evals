diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..2e4c0ab
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,155 @@
+class Notification::Bundle < ApplicationRecord
+  INTERVALS = User::Settings::INTERVALS
+  FREQUENCIES = INTERVALS
+  EMAIL_FREQUENCIES = INTERVALS
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, -> { order(:created_at) },
+    class_name: "Notification",
+    foreign_key: :notification_bundle_id,
+    inverse_of: :bundle,
+    dependent: :nullify
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+  scope :ordered, -> { order(:starts_at, :created_at) }
+
+  before_validation :set_window, on: :create
+  validate :window_does_not_overlap
+
+  class << self
+    # Called when a notification lands. It either joins the window that has
+    # already opened or opens a new one. Returns nil when the person has
+    # turned digest emails off.
+    def add(notification)
+      if interval = interval_for(notification.user)
+        user = notification.user
+
+        user.with_lock do
+          bundle = pending.find_by(user_id: user.id)
+          bundle ||= create!(user: user, frequency: user.settings.bundle_email_frequency, starts_at: starts_at_for(notification))
+          bundle.assign(notification)
+          bundle
+        end
+      end
+    end
+
+    # Returns the open window for a person, or assigns a notification to the
+    # current window. Accepts either a User or a Notification.
+    def for(user_or_notification)
+      if user_or_notification.is_a?(Notification)
+        add(user_or_notification)
+      else
+        pending.find_by(user: user_or_notification)
+      end
+    end
+
+    def deliver_due
+      due.find_each(&:deliver)
+    end
+    alias_method :deliver_all, :deliver_due
+    alias_method :deliver_pending, :deliver_due
+
+    def create_for(user_or_notification)
+      if user_or_notification.is_a?(Notification)
+        add(user_or_notification)
+      else
+        find_or_create_for(user_or_notification)
+      end
+    end
+
+    def find_or_create_for(user)
+      if interval_for(user)
+        pending_for(user) || create!(user: user, starts_at: Time.current)
+      end
+    end
+
+    def pending_for(user)
+      pending.find_by(user: user)
+    end
+    alias_method :current_for, :pending_for
+    alias_method :open_for, :pending_for
+
+    def interval_for(user_or_frequency)
+      frequency = user_or_frequency.is_a?(User) ? user_or_frequency.settings&.bundle_email_frequency : user_or_frequency
+      INTERVALS[frequency]
+    end
+
+    private
+      def starts_at_for(notification)
+        lands_at = notification.created_at || Time.current
+        previous_ends_at = delivered.where(user_id: notification.user_id).maximum(:ends_at)
+        [ lands_at, previous_ends_at ].compact.max
+      end
+  end
+
+  def assign(notification)
+    unless notification.notification_bundle_id == id
+      notification.update_column(:notification_bundle_id, id)
+    end
+    notification
+  end
+  alias_method :add, :assign
+
+  def notification_ids
+    notifications.pluck(:id)
+  end
+
+  def notification_ids=(ids)
+    Notification.where(id: ids).update_all(notification_bundle_id: id)
+  end
+
+  def deliver
+    return false unless deliverable?
+
+    with_lock do
+      return false if delivered?
+      update!(delivered_at: Time.current)
+    end
+
+    NotificationMailer.bundle(self).deliver_now
+    true
+  end
+
+  def deliver_later
+    Notification::BundleJob.perform_later(self)
+  end
+  alias_method :deliver_now, :deliver
+
+  def pending?
+    delivered_at.nil?
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def due?
+    pending? && ends_at <= Time.current
+  end
+
+  def deliverable?
+    user.identity.present? && user.active? && account.active?
+  end
+
+  def interval
+    INTERVALS[frequency] || (ends_at - starts_at)
+  end
+
+  private
+    def window_does_not_overlap
+      if user_id.present? && starts_at.present? && ends_at.present?
+        overlapping = self.class.where(user_id: user_id).where.not(id: id)
+          .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        errors.add(:base, "can't overlap another window") if overlapping.exists?
+      end
+    end
+
+    def set_window
+      self.starts_at ||= Time.current
+      self.frequency ||= user&.settings&.bundle_email_frequency
+      self.ends_at ||= starts_at + (INTERVALS[frequency] || 0)
+    end
+end
