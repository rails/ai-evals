+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def bundle(bundle)
+    set_bundle(bundle)
+    mail to: @user.identity.email_address, subject: subject
+  end
+  alias_method :digest, :bundle
+
+  private
+    def set_bundle(bundle)
+      @bundle = bundle
+      @user = bundle.user
+      @notifications = bundle.notifications.preloaded
+      @boards = @notifications.group_by { |notification| notification.card.board }
+    end
+
+    def subject
+      "New notifications"
+    end
+end
