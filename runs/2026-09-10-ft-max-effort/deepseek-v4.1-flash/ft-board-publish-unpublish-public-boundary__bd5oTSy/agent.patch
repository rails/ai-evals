+class Board::Publication < ApplicationRecord
+  belongs_to :account, default: -> { board.account }
+  belongs_to :board, touch: true
+
+  has_secure_token :key
+
+  def to_param
+    key
+  end
+
+  def url
+    Rails.application.routes.url_helpers.public_board_url(self, **url_options)
+  end
+
+  private
+    def url_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence || {}
+      options.merge(script_name: account.slug)
+    end
+end
