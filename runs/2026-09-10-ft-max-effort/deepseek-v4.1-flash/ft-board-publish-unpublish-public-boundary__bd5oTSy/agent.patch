+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public sharing</h2>
+
+    <% if board.published? %>
+      <p class="margin-none-block-start">
+        Anyone with the secret link can view this board.
+        <%= link_to "View public board", public_board_path(board.publication), target: "_blank", rel: "noopener" %>
+      </p>
+
+      <%= button_to "Unpublish", board_publication_path(board), method: :delete, class: "btn btn--negative" %>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to share it with anyone who has the link.</p>
+
+      <%= button_to "Publish", board_publication_path(board), method: :post, class: "btn" %>
+    <% end %>
+  </div>
+<% end %>
