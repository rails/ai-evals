diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..fb9d4a6
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,68 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.body.read, signature, webhook_secret)
+    handle event
+
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def handle(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        sync_subscription event.data.object
+      when "checkout.session.completed"
+        sync_checkout_session event.data.object
+      end
+    end
+
+    def sync_subscription(stripe_subscription)
+      if account = account_for(stripe_subscription)
+        subscription = account.subscription || account.build_subscription
+        subscription.sync_from_stripe! stripe_subscription
+      end
+    end
+
+    def sync_checkout_session(session)
+      account = account_for_session(session)
+      return unless account
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_subscription_id = session.subscription if session.subscription
+      subscription.stripe_customer_id = customer_id_for(session)
+      subscription.plan_key = session.metadata[:plan_key] if session.metadata&.[](:plan_key)
+      subscription.status = "active"
+      subscription.save!
+    end
+
+    def account_for(stripe_subscription)
+      account_for_session(stripe_subscription) ||
+        Account::Subscription.find_by(stripe_subscription_id: stripe_subscription.id)&.account ||
+        Account::Subscription.find_by(stripe_customer_id: customer_id_for(stripe_subscription))&.account
+    end
+
+    def account_for_session(object)
+      metadata = object.try(:metadata)
+      account_id = metadata&.[](:account_id) || metadata&.[]("account_id") || object.try(:client_reference_id)
+      Account.find_by(id: account_id) if account_id.present?
+    end
+
+    def customer_id_for(object)
+      customer = object.try(:customer)
+      customer.respond_to?(:id) ? customer.id : customer
+    end
+
+    def signature
+      request.env["HTTP_STRIPE_SIGNATURE"]
+    end
+
+    def webhook_secret
+      ENV.fetch("STRIPE_WEBHOOK_SECRET") { Rails.application.credentials.stripe_webhook_secret }
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
