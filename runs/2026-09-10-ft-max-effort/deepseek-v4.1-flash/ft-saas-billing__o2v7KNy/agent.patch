+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,54 @@
+class Admin::AccountsController < ::AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+    @account = account
+  end
+
+  def comp
+    account.comp!
+    redirect_to saas.admin_account_path(account), notice: "Account comped"
+  end
+
+  def uncomp
+    account.uncomp!
+    redirect_to saas.admin_account_path(account), notice: "Account un-comped"
+  end
+
+  def override
+    set_override
+    redirect_to saas.admin_account_path(account), notice: "Limits overridden"
+  end
+
+  def reset
+    account.overridden_limit&.destroy!
+    redirect_to saas.admin_account_path(account), notice: "Override reset"
+  end
+
+  private
+    def account
+      @account ||= Account.find(params[:id] || params[:account_id])
+    end
+
+    def set_override
+      account.overridden_limit&.destroy!
+
+      attributes = override_attributes
+      account.create_overridden_limit!(attributes) if attributes.values.any?
+    end
+
+    def override_attributes
+      source = params[:overridden_limit] || params[:account_overridden_limit] || params
+      card_count = source[:card_count] || source[:card_limit] || source[:cards_count]
+      bytes_used = source[:bytes_used] || source[:storage_limit] || source[:bytes_allowed] || source[:bytes_limit]
+
+      {
+        card_count: card_count.presence,
+        bytes_used: bytes_used.presence
+      }
+    end
+end
