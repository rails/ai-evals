diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..85fbf07
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,65 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  def plan
+    Subscription.find(plan_key)
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def paid?
+    plan.key != Subscription.free.key
+  end
+
+  def comped?
+    false
+  end
+
+  def sync_from_stripe!(stripe_subscription)
+    status = stripe_subscription.status
+
+    update!(
+      plan_key: self.class.plan_key_for(stripe_subscription, status: status),
+      stripe_subscription_id: stripe_subscription.id,
+      stripe_customer_id: self.class.customer_id_for(stripe_subscription),
+      status: status,
+      current_period_end: self.class.timestamp_for(stripe_subscription, :current_period_end),
+      cancel_at: self.class.timestamp_for(stripe_subscription, :cancel_at),
+      next_amount_due_in_cents: self.class.next_amount_due_in_cents_for(stripe_subscription)
+    )
+  end
+
+  class << self
+    def plan_key_for(stripe_subscription, status: nil)
+      return Subscription.free.key if status.present? && !status.in?(ACTIVE_STATUSES)
+
+      price_ids = Array(stripe_subscription.try(:items)&.data).filter_map { |item| item.try(:price)&.id }
+      plan = Subscription.paid.find { |candidate| candidate.stripe_price_id.present? && price_ids.include?(candidate.stripe_price_id) }
+
+      plan&.key || stripe_subscription.try(:metadata).try(:[], :plan_key) || Subscription.free.key
+    end
+
+    def customer_id_for(stripe_subscription)
+      customer = stripe_subscription.try(:customer)
+      customer.respond_to?(:id) ? customer.id : customer
+    end
+
+    def timestamp_for(stripe_subscription, attribute)
+      value = stripe_subscription.try(attribute)
+      Time.zone.at(value) if value
+    end
+
+    def next_amount_due_in_cents_for(stripe_subscription)
+      amount = Array(stripe_subscription.try(:items)&.data).filter_map { |item|
+        item.try(:price).try(:unit_amount)
+      }.sum
+      amount.positive? ? amount : nil
+    end
+  end
+end
