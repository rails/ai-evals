diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..50b2aad
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,61 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <dl class="flex flex-column gap-half">
+      <div class="flex gap-half">
+        <dt class="txt-x-small txt-ink-medium flex-item-grow">Plan</dt>
+        <dd><%= @account.plan_name %></dd>
+      </div>
+      <div class="flex gap-half">
+        <dt class="txt-x-small txt-ink-medium flex-item-grow">Cards</dt>
+        <dd><%= number_with_delimiter(@account.cards_count) %></dd>
+      </div>
+      <div class="flex gap-half">
+        <dt class="txt-x-small txt-ink-medium flex-item-grow">Bytes used</dt>
+        <dd><%= number_to_human_size(@account.bytes_used) %></dd>
+      </div>
+    </dl>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <div class="flex gap-half">
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn", disabled: @account.comped? %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn", disabled: !@account.comped? %>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Limits</h2>
+    </header>
+
+    <%= form_with url: saas.admin_account_overridden_limit_path(@account), scope: :overridden_limit, method: :post, data: { controller: "form" }, class: "flex flex-column gap-half" do |form| %>
+      <label class="flex flex-column gap-quarter">
+        <span class="txt-x-small txt-ink-medium">Card count</span>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input", min: 0 %>
+      </label>
+
+      <label class="flex flex-column gap-quarter">
+        <span class="txt-x-small txt-ink-medium">Bytes used</span>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input", min: 0 %>
+      </label>
+
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <div class="flex gap-half">
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn btn--negative", disabled: @account.overridden_limit.nil? %>
+    </div>
+  </div>
+</section>
