+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    session = Stripe::Checkout::Session.create checkout_attributes(plan)
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def plan
+      requested = Subscription.find(params[:plan] || params[:plan_key])
+      Subscription.paid.include?(requested) ? requested : Subscription.paid.first
+    end
+
+    def checkout_attributes(plan)
+      {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        subscription_data: {
+          metadata: { account_id: Current.account.id, plan_key: plan.key }
+        },
+        metadata: { account_id: Current.account.id, plan_key: plan.key },
+        success_url: saas.billing_url(script_name: Current.account.slug, checkout: "success"),
+        cancel_url: saas.billing_url(script_name: Current.account.slug, checkout: "canceled")
+      }
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
