+    property :card_limit,    1_000
+    property :storage_limit, 1.gigabyte
+  end
+
+  class Unlimited < Subscription
+    property :proper_name,   "Unlimited"
+    property :price,         20
+    property :card_limit,    nil
+    property :storage_limit, 5.gigabytes
+
+    def self.stripe_price_env_keys = %w[ STRIPE_UNLIMITED_PRICE_ID STRIPE_UNLIMITED_V1_PRICE_ID STRIPE_MONTHLY_V1_PRICE_ID ]
+  end
+
+  class UnlimitedPlus < Subscription
+    property :proper_name,   "Unlimited+"
+    property :price,         25
+    property :card_limit,    nil
+    property :storage_limit, 500.gigabytes
+
+    def self.stripe_price_env_keys = %w[ STRIPE_UNLIMITED_PLUS_PRICE_ID STRIPE_UNLIMITED_PLUS_V1_PRICE_ID STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID ]
   end
+  # Convenience aliases so several spellings resolve to the same plan.
+  Free = FreeV1
+  FREE = FreeV1
+  UNLIMITED = Unlimited
+  UNLIMITED_PLUS = UnlimitedPlus
 end
