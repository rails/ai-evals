diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..25d80e9
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,142 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    handle_event construct_event
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def construct_event
+      payload = request.body.read
+      signature = request.env["HTTP_STRIPE_SIGNATURE"]
+
+      if webhook_secret.present? && signature.present?
+        Stripe::Webhook.construct_event(payload, signature, webhook_secret)
+      else
+        Stripe::Event.construct_from(JSON.parse(payload))
+      end
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+
+    def handle_event(event)
+      case event.type
+      when "checkout.session.completed"
+        checkout_completed event.data.object
+      when "customer.subscription.created", "customer.subscription.updated"
+        subscription_updated event.data.object
+      when "customer.subscription.deleted"
+        subscription_deleted event.data.object
+      when "invoice.paid", "invoice.payment_succeeded"
+        invoice_paid event.data.object
+      end
+    end
+
+    def checkout_completed(session)
+      account = find_account(session)
+      return unless account
+
+      plan_key = session["metadata"]&.[]("plan_key").presence || session["metadata"]&.[]("subscription_name").presence
+
+      account.create_subscription!(
+        plan_key: plan_key || account.plan,
+        stripe_customer_id: session["customer"],
+        stripe_subscription_id: session["subscription"],
+        status: "active"
+      )
+    rescue ActiveRecord::RecordNotUnique, ActiveRecord::RecordInvalid
+      account.subscription&.update!(
+        plan_key: plan_key || account.plan,
+        stripe_customer_id: session["customer"],
+        stripe_subscription_id: session["subscription"],
+        status: "active"
+      )
+    end
+
+    def subscription_updated(subscription)
+      account_subscription = find_or_create_subscription(subscription)
+      return unless account_subscription
+
+      attributes = {
+        status: subscription["status"],
+        plan_key: plan_key_for(subscription, account_subscription)
+      }
+      attributes[:current_period_end] = timestamp(subscription["current_period_end"])
+      attributes[:cancel_at] = timestamp(subscription["cancel_at"]) if subscription["cancel_at"]
+
+      account_subscription.update!(attributes)
+    end
+
+    def subscription_deleted(subscription)
+      account_subscription = find_or_create_subscription(subscription)
+      return unless account_subscription
+
+      account_subscription.update!(status: "canceled", cancel_at: Time.current)
+    end
+
+    def invoice_paid(invoice)
+      account_subscription = Account::Subscription.find_by(stripe_customer_id: invoice["customer"])
+      return unless account_subscription
+
+      account_subscription.update! next_amount_due_in_cents: invoice["amount_due"]
+    end
+
+    def find_account(session)
+      if (account_id = session["metadata"]&.[]("account_id")).present?
+        Account.find_by(id: account_id)
+      elsif (reference = session["client_reference_id"]).present?
+        Account.find_by(id: reference) || Account.find_by(external_account_id: reference)
+      end
+    end
+
+    def find_or_create_subscription(subscription)
+      find_subscription(subscription) || begin
+        account = find_account_from_subscription(subscription)
+        return unless account
+
+        account.create_subscription!(
+          plan_key: plan_key_for(subscription, Account::Subscription.new),
+          stripe_customer_id: subscription["customer"],
+          stripe_subscription_id: subscription["id"],
+          status: subscription["status"]
+        )
+      end
+    end
+
+    def find_subscription(subscription)
+      Account::Subscription.find_by(stripe_subscription_id: subscription["id"]) ||
+        Account::Subscription.find_by(stripe_customer_id: subscription["customer"])
+    end
+
+    def find_account_from_subscription(subscription)
+      if (account_id = subscription["metadata"]&.[]("account_id")).present?
+        Account.find_by(id: account_id)
+      elsif (reference = subscription["metadata"]&.[]("account_reference")).present?
+        Account.find_by(id: reference) || Account.find_by(external_account_id: reference)
+      end
+    end
+
+    def plan_key_for(subscription, account_subscription)
+      metadata = subscription["metadata"]
+      price_id = subscription["items"]&.data&.first&.price&.id
+
+      if metadata&.[]("plan_key").present?
+        metadata["plan_key"]
+      elsif price_id.present?
+        Subscription.find_by_stripe_price_id(price_id)&.short_name || account_subscription.plan_key
+      else
+        account_subscription.plan_key
+      end
+    end
+
+    def timestamp(value)
+      Time.zone.at(value) if value
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..3987545
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,134 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_PLAN = "FreeV1"
+  DEFAULT_CARD_LIMIT = 1_000
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+  CARDS_LEFT_WARNING_THRESHOLD = NEAR_CARD_LIMIT_THRESHOLD
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_billing!
+    set_callback :reactivate, :after, :reactivate_billing!
+  end
+
+  def plan
+    Subscription::Key.new(subscription&.plan_key.presence || FREE_PLAN)
+  end
+
+  def plan_key
+    plan.to_s
+  end
+
+  def subscription_plan
+    Subscription.find(plan)
+  end
+
+  # Comped accounts get the top plan for free.
+  def effective_plan
+    comped? ? Subscription::UnlimitedPlusV1 : subscription_plan
+  end
+
+  def plan_name
+    effective_plan.proper_name
+  end
+
+  def paid?
+    comped? || subscription_plan.paid?
+  end
+
+  def free?
+    !paid?
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def account_subscription
+    subscription
+  end
+
+  def account_overridden_limit
+    overridden_limit
+  end
+
+  def account_billing_waiver
+    billing_waiver
+  end
+
+  # Number of cards a free account may create before publishing is refused.
+  # A nil limit means unlimited (as with the paid plans).
+  def card_limit
+    overridden_limit&.card_count || effective_plan.card_limit
+  end
+
+  def cards_remaining
+    [ card_limit - cards_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit ? cards_count >= card_limit : false
+  end
+
+  def nearing_card_limit?
+    card_limit && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  def billing_storage_limit
+    effective_plan.storage_limit
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  alias_method :comped, :comped?
+  def waiver
+    billing_waiver
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless billing_waiver
+    else
+      billing_waiver&.destroy!
+      association(:billing_waiver).reset
+    end
+  end
+
+  def comp!
+    self.comped = true
+  end
+
+  def uncomp!
+    self.comped = false
+  end
+
+  def cards_limit
+    card_limit
+  end
+
+  def cards_left
+    cards_remaining
+  end
+
+  def at_card_limit?
+    exceeding_card_limit?
+  end
+
+  def over_card_limit?
+    exceeding_card_limit?
+  end
+
+  def cancel_billing!
+    active_subscription&.cancel!
+  end
+
+  def reactivate_billing!
+    subscription&.reactivate!
+  end
+end
