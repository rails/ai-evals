diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..3b0f72e
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,45 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_customer_id, uniqueness: true, allow_nil: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  scope :active, -> { where(status: %w[ active trialing ]) }
+
+  def plan
+    Subscription.find(plan_key)
+  end
+
+  def plan_name
+    plan.proper_name
+  end
+
+  def active?
+    status.in?(%w[ active trialing ])
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def cancel!
+    Stripe::Subscription.cancel(stripe_subscription_id) if stripe_subscription_id.present?
+    update!(status: "canceled", cancel_at: Time.current)
+  end
+
+  def reactivate!
+    if stripe_subscription_id.present?
+      Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: false)
+    end
+
+    update!(status: "active", cancel_at: nil)
+  end
+
+  def next_amount_due
+    next_amount_due_in_cents
+  end
+end
