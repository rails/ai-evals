@@ -0,0 +1,50 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <div class="flex flex-column gap-half">
+      <div><strong>#<%= @account.external_account_id %></strong></div>
+      <div>Plan: <strong><%= @account.plan_name %></strong></div>
+      <div>Cards: <%= number_with_delimiter(@account.cards_count) %><% if @account.card_limit %> of <%= number_with_delimiter(@account.card_limit) %><% end %></div>
+      <div>Bytes used: <%= number_to_human_size(@account.bytes_used) %></div>
+      <div>Comped: <%= @account.comped? ? "Yes" : "No" %></div>
+    </div>
+
+    <div class="flex gap-half margin-block-start">
+      <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn" %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), class: "btn" %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override</h2>
+    </header>
+
+    <%= form_with url: saas.override_admin_account_path(@account), scope: :overridden_limit, class: "flex flex-column gap-half" do |form| %>
+      <label>
+        <span class="txt-small">Card count</span>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input", min: 0 %>
+      </label>
+
+      <label>
+        <span class="txt-small">Bytes used</span>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input", min: 0 %>
+      </label>
+
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <div class="margin-block-start">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), class: "btn btn--negative" %>
+    </div>
+  </div>
+</section>
