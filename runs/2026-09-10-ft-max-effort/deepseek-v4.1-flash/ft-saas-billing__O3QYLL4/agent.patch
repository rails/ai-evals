@@ -0,0 +1,39 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Subscription.find(params[:plan].presence || "UnlimitedV1")
+
+    session = Stripe::Checkout::Session.create(
+      mode: "subscription",
+      line_items: line_items(plan),
+      success_url: account_settings_url,
+      cancel_url: account_settings_url,
+      client_reference_id: Current.account.external_account_id.to_s,
+      customer_email: Current.identity.email_address,
+      metadata: {
+        account_id: Current.account.id,
+        plan_key: plan.short_name
+      }
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def line_items(plan)
+      price_id = plan.stripe_price_id
+
+      if price_id.present?
+        [ { price: price_id, quantity: 1 } ]
+      else
+        [ { price_data: {
+              currency: "usd",
+              unit_amount: plan.price,
+              recurring: { interval: "month" },
+              product_data: { name: plan.proper_name }
+            },
+            quantity: 1 } ]
+      end
+    end
+end
