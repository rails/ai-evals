diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
index 5efb1a7..fbe3cdd 100644
--- a/saas/app/models/subscription.rb
+++ b/saas/app/models/subscription.rb
@@ -1,13 +1,128 @@
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  # Plan identifiers used as Queenbee short names and as account plan keys.
+  #
+  # The marketing names are Free / Unlimited / Unlimited+ per the approved
+  # pricing. Monthly* is the internal/Stripe naming that predates the launch,
+  # kept as aliases so Queenbee keeps recognizing existing subscriptions.
+  SHORT_NAMES = %w[FreeV1 MonthlyV1 MonthlyExtraStorageV1 UnlimitedV1 UnlimitedPlusV1]
 
   def self.short_name
     name.demodulize
   end
 
+  def self.all
+    SHORT_NAMES.map { |short_name| const_get(short_name, false) }
+  end
+
+  # Look up a plan by short name, proper name, or plan key, falling back to Free.
+  def self.find(key)
+    key = key.to_s
+    all.find { |plan| plan.short_name == key || plan.proper_name == key } || FreeV1
+  end
+
+  def self.find_by_stripe_price_id(price_id)
+    all.find { |plan| plan.stripe_price_id == price_id } if price_id.present?
+  end
+
+  def self.paid
+    all.reject { |plan| plan.price.zero? }
+  end
+
+  # Queenbee serializes plans by short name ("FreeV1", "MonthlyV1", ...).
+  def self.to_param
+    short_name
+  end
+
+  property :proper_name, nil
+  property :price, 0
+  property :frequency, "monthly"
+  property :card_limit, nil
+  property :storage_limit, nil
+  property :stripe_price_env, nil
+
+  def self.stripe_price_id
+    ENV[stripe_price_env] if stripe_price_env
+  end
+
+  def self.free?
+    price.to_i.zero?
+  end
+
+  def self.paid?
+    !free?
+  end
+
+  def self.price_in_dollars
+    price.to_i / 100.0
+  end
+
+  def self.display_price
+    free? ? "Free" : "$#{price.to_i / 100}/month"
+  end
+
+  def self.display_storage
+    ActiveSupport::NumberHelper.number_to_human_size(storage_limit)
+  end
+
+  # Aliases matching the overridden-usage column names.
+  def self.card_count = card_limit
+  def self.bytes_used = storage_limit
+  def card_count = card_limit
+  def bytes_used = storage_limit
+
+  # A String-like plan key that still exposes the plan's properties, so
+  # `account.plan` can be compared to "FreeV1" while also answering
+  # `account.plan.proper_name`.
+  class Key < String
+    def plan
+      Subscription.find(self)
+    end
+
+    def short_name = plan.short_name
+    def proper_name = plan.proper_name
+    def name = plan.proper_name
+    def price = plan.price
+    def card_limit = plan.card_limit
+    def storage_limit = plan.storage_limit
+    def free? = plan.free?
+    def paid? = plan.paid?
+  end
+
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+    property :proper_name, "Free"
+    property :price, 0
+    property :frequency, "yearly"
+    property :card_limit, 1_000
+    property :storage_limit, 1.gigabyte
   end
+
+  class MonthlyV1 < Subscription
+    property :proper_name, "Unlimited"
+    property :price, 2_000
+    property :frequency, "monthly"
+    property :card_limit, nil
+    property :storage_limit, 5.gigabytes
+    property :stripe_price_env, "STRIPE_MONTHLY_V1_PRICE_ID"
+  end
+
+  class MonthlyExtraStorageV1 < Subscription
+    property :proper_name, "Unlimited+"
+    property :price, 2_500
+    property :frequency, "monthly"
+    property :card_limit, nil
+    property :storage_limit, 500.gigabytes
+    property :stripe_price_env, "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+  end
+
+  # Approved-pricing aliases for the internal Monthly* plans.
+  class UnlimitedV1 < MonthlyV1
+  end
+
+  class UnlimitedPlusV1 < MonthlyExtraStorageV1
+  end
+
+  # Convenience aliases without the version suffix.
+  Free = FreeV1
+  Unlimited = UnlimitedV1
+  UnlimitedPlus = UnlimitedPlusV1
 end
