index 0000000..741bddf
--- /dev/null
+++ b/app/models/concerns/storable.rb
@@ -0,0 +1,16 @@
+# Adds storage usage tracking to an Account or a Board.
+#
+# +bytes_used+ reads the running total kept on the record. The total is updated
+# as attachments are created and destroyed, and a background job reconciles it
+# with the underlying attachments.
+module Storable
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    self[:bytes_used].to_i
+  end
+
+  def recalculate_bytes_used
+    update_column :bytes_used, StorageUsage.bytes_for(self)
+  end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..6fc76cc
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,132 @@
+# Tracks how many bytes each account and board is storing.
+#
+# Only two kinds of attachments count toward storage usage:
+#
+# * the +image+ attached to a Card, and
+# * files embedded (via ActionText) in a Board's public description, a Card's
+#   description, or a Comment's body.
+#
+# A board's usage is the sum of the above for the board itself and its cards.
+# An account's usage is the sum for all of its boards.
+#
+# The running totals live on +accounts.bytes_used+ and +boards.bytes_used+ and
+# are updated as attachments are created and destroyed. A background job
+# reconciles the counters with the underlying attachments so the values returned
+# by Account#bytes_used and Board#bytes_used stay up to date.
+class StorageUsage
+  Snapshot = Data.define(:account_id, :board_id, :bytes)
+
+  class << self
+    def bytes_for(record)
+      case record
+      when Board then bytes_for_board(record)
+      when Account then bytes_for_account(record)
+      else 0
+      end
+    end
+
+    def bytes_for_board(board)
+      card_image_bytes(board) + embed_bytes(board)
+    end
+
+    def bytes_for_account(account)
+      ActiveStorage::Attachment.joins(:blob)
+        .where(account_id: account.id)
+        .where(counted_conditions)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def track(attachment)
+      if snapshot = snapshot_for(attachment)
+        apply +snapshot.bytes, snapshot
+        enqueue_recalculation snapshot
+      end
+    end
+
+    def snapshot(attachment)
+      snapshot_for(attachment)
+    end
+
+    def release(snapshot)
+      if snapshot
+        apply -snapshot.bytes, snapshot
+        enqueue_recalculation snapshot
+      end
+    end
+
+    private
+      def apply(bytes, snapshot)
+        return if bytes.zero? || snapshot.account_id.blank?
+
+        Account.where(id: snapshot.account_id).update_all([ "bytes_used = COALESCE(bytes_used, 0) + ?", bytes ])
+
+        if snapshot.board_id.present?
+          Board.where(id: snapshot.board_id).update_all([ "bytes_used = COALESCE(bytes_used, 0) + ?", bytes ])
+        end
+      end
+
+      def enqueue_recalculation(snapshot)
+        RecalculateJob.perform_later account_id: snapshot.account_id, board_id: snapshot.board_id
+      end
+
+      def snapshot_for(attachment)
+        if board_id = board_id_for(attachment)
+          Snapshot.new account_id_for(attachment), board_id, blob_bytes(attachment)
+        end
+      end
+
+      def board_id_for(attachment)
+        case attachment.record_type
+        when "Card"
+          attachment.record.board_id if attachment.name == "image" && attachment.record
+        when "ActionText::RichText"
+          rich_text_owner_board_id(attachment.record) if attachment.name == "embeds"
+        end
+      end
+
+      def rich_text_owner_board_id(rich_text)
+        owner = rich_text&.record
+
+        case owner
+        when Board then owner.id
+        when Card then owner.board_id
+        when Comment then owner.card&.board_id
+        end
+      end
+
+      def account_id_for(attachment)
+        attachment.account_id.presence || attachment.record&.account_id
+      end
+
+      def blob_bytes(attachment)
+        attachment.blob&.byte_size.to_i
+      end
+
+      def card_image_bytes(board)
+        ActiveStorage::Attachment.joins(:blob)
+          .where(account_id: board.account_id, record_type: "Card", name: "image", record_id: board.cards.select(:id))
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def embed_bytes(board)
+        ActiveStorage::Attachment.joins(:blob)
+          .where(account_id: board.account_id, record_type: "ActionText::RichText", name: "embeds", record_id: rich_texts(board))
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def rich_texts(board)
+        card_ids = Card.where(board: board).select(:id)
+        comment_ids = Card.where(board: board).joins(:comments).select("comments.id")
+
+        ActionText::RichText.where(record_type: "Board", record_id: board.id)
+          .or(ActionText::RichText.where(record_type: "Card", record_id: card_ids))
+          .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids))
+          .select(:id)
+      end
+
+      def counted_conditions
+        "((active_storage_attachments.record_type = 'Card' AND active_storage_attachments.name = 'image')
+          OR (active_storage_attachments.record_type = 'ActionText::RichText' AND active_storage_attachments.name = 'embeds'))"
+      end
+  end
+end
diff --git a/app/models/storage_usage/trackable.rb b/app/models/storage_usage/trackable.rb
new file mode 100644
index 0000000..44e332a
--- /dev/null
+++ b/app/models/storage_usage/trackable.rb
@@ -0,0 +1,36 @@
+# Hooks ActiveStorage::Attachment so that storage usage counters follow
+# attachments as they are created and removed.
+#
+# Most removals go through +destroy+ (which runs the destroy callbacks), but
+# ActiveStorage's own +purge+ and +purge_later+ call +delete+ and skip them, so
+# we override +delete+ as well.
+module StorageUsage::Trackable
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create_commit :track_storage_usage
+    before_destroy :remember_storage_usage
+    after_destroy_commit :release_storage_usage
+  end
+
+  def delete
+    snapshot = StorageUsage.snapshot(self) if persisted?
+
+    super.tap do
+      StorageUsage.release(snapshot) if snapshot
+    end
+  end
+
+  private
+    def track_storage_usage
+      StorageUsage.track(self)
+    end
+
+    def remember_storage_usage
+      @storage_usage_snapshot = StorageUsage.snapshot(self)
+    end
+
+    def release_storage_usage
+      StorageUsage.release(@storage_usage_snapshot)
+    end
+end
