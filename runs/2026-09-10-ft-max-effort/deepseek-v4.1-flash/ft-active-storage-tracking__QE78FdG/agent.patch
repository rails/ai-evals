@@ -0,0 +1,17 @@
+# Reconciles the running +bytes_used+ counters for a board and its account with
+# the attachments that actually exist.
+class StorageUsage::RecalculateJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account_id:, board_id: nil)
+    if board = Board.find_by(id: board_id)
+      board.recalculate_bytes_used
+    end
+
+    if account = Account.find_by(id: account_id)
+      account.recalculate_bytes_used
+    end
+  end
+end
