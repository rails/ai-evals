new file mode 100644
index 0000000..49ba959
--- /dev/null
+++ b/lib/tasks/storage_usage.rake
@@ -0,0 +1,12 @@
+namespace :storage_usage do
+  desc "Recalculate bytes_used for every board and account"
+  task recalculate: :environment do
+    puts "Recalculating boards..."
+    Board.find_each(&:recalculate_bytes_used)
+
+    puts "Recalculating accounts..."
+    Account.find_each(&:recalculate_bytes_used)
+
+    puts "Done! Recalculated #{Board.count} boards and #{Account.count} accounts."
+  end
+end
diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..0209018
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,228 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @moon = file_fixture("moon.jpg")
+  end
+
+  test "a card image counts toward its board and account" do
+    assert_difference -> { @board.reload.bytes_used }, @moon.size do
+      @card.image.attach io: @moon.open, filename: "moon.jpg"
+    end
+
+    assert_equal @moon.size, @board.reload.bytes_used
+    assert_equal @moon.size, @account.reload.bytes_used
+    assert_equal 0, boards(:private).reload.bytes_used
+  end
+
+  test "an image on another board does not count" do
+    other_board = boards(:private)
+    other_card = other_board.cards.create! title: "Other", creator: users(:david), account: @account
+    other_card.image.attach io: @moon.open, filename: "moon.jpg"
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal @moon.size, other_board.reload.bytes_used
+  end
+
+  test "files embedded in a card description count" do
+    attach_embed_to @card, :description
+
+    assert_equal @moon.size, @board.reload.bytes_used
+    assert_equal @moon.size, @account.reload.bytes_used
+  end
+
+  test "files embedded in a board description count" do
+    attach_embed_to @board, :public_description
+
+    assert_equal @moon.size, @board.reload.bytes_used
+    assert_equal @moon.size, @account.reload.bytes_used
+  end
+
+  test "files embedded in a comment count" do
+    comment = @card.comments.create! body: "See this", creator: users(:david)
+    attach_embed_to comment, :body
+
+    assert_equal @moon.size, @board.reload.bytes_used
+    assert_equal @moon.size, @account.reload.bytes_used
+  end
+
+  test "removing a card image decrements usage" do
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+    assert_equal @moon.size, @board.reload.bytes_used
+
+    assert_difference -> { @board.reload.bytes_used }, -@moon.size do
+      @card.image.purge_later
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "synchronously purging a card image decrements usage" do
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+
+    assert_difference -> { @board.reload.bytes_used }, -@moon.size do
+      @card.image.purge
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "destroying a card removes its usage" do
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+    assert_equal @moon.size, @board.reload.bytes_used
+
+    assert_difference -> { @board.reload.bytes_used }, -@moon.size do
+      @card.destroy
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card moves its usage to the new board" do
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+    assert_equal @moon.size, @board.reload.bytes_used
+
+    private_board = boards(:private)
+    @card.update! board: private_board, column: nil
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal @moon.size, private_board.reload.bytes_used
+    assert_equal @moon.size, @account.reload.bytes_used
+  end
+
+  test "recalculating counts the same as incremental updates" do
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+    attach_embed_to @card, :description
+    comment = @card.comments.create! body: "See this", creator: users(:david)
+    attach_embed_to comment, :body
+
+    expected = @moon.size * 3
+    assert_equal expected, @board.reload.bytes_used
+
+    @board.update_column :bytes_used, 0
+    @board.recalculate_bytes_used
+    assert_equal expected, @board.bytes_used
+
+    @account.update_column :bytes_used, 0
+    @account.recalculate_bytes_used
+    assert_equal expected, @account.bytes_used
+  end
+
+  test "background jobs reconcile usage" do
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+    @board.update_column :bytes_used, 0
+    @account.update_column :bytes_used, 0
+
+    perform_enqueued_jobs
+
+    assert_equal @moon.size, @board.reload.bytes_used
+    assert_equal @moon.size, @account.reload.bytes_used
+  end
+
+  test "avatars and other attachments do not count" do
+    users(:david).avatar.attach io: @moon.open, filename: "moon.jpg"
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "account usage sums every board" do
+    private_board = boards(:private)
+    private_card = private_board.cards.create! title: "Other", creator: users(:david), account: @account
+
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+    private_card.image.attach io: @moon.open, filename: "moon.jpg"
+    attach_embed_to @board, :public_description
+
+    assert_equal @moon.size * 2, @board.reload.bytes_used
+    assert_equal @moon.size, private_board.reload.bytes_used
+    assert_equal @moon.size * 3, @account.reload.bytes_used
+  end
+
+  test "accounts are isolated" do
+    initech = accounts("initech")
+    assert_equal 0, initech.bytes_used
+
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+
+    assert_equal 0, initech.reload.bytes_used
+    assert_equal @moon.size, @account.reload.bytes_used
+  end
+
+  test "destroying a board removes its usage from the account" do
+    destroyable = @account.boards.create! name: "Temp", creator: users(:david)
+    destroyable_card = destroyable.cards.create! title: "Temp", creator: users(:david), account: @account
+    destroyable_card.image.attach io: @moon.open, filename: "moon.jpg"
+    assert_equal @moon.size, @account.reload.bytes_used
+
+    assert_difference -> { @account.reload.bytes_used }, -@moon.size do
+      destroyable.destroy
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "replacing a card image keeps usage accurate" do
+    @card.image.attach io: @moon.open, filename: "moon.jpg"
+    assert_equal @moon.size, @board.reload.bytes_used
+
+    @card.image.attach io: file_fixture("avatar.png").open, filename: "avatar.png"
+
+    assert_equal file_fixture("avatar.png").size, @board.reload.bytes_used
+    assert_equal file_fixture("avatar.png").size, @account.reload.bytes_used
+  end
+
+  test "removing an embed from a card description decrements usage" do
+    attach_embed_to @card, :description
+    assert_equal @moon.size, @board.reload.bytes_used
+
+    @card.description.body = "No embed here"
+    @card.save!
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "removing an embed from a comment decrements usage" do
+    comment = @card.comments.create! body: "See this", creator: users(:david)
+    attach_embed_to comment, :body
+    assert_equal @moon.size, @board.reload.bytes_used
+
