+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "new renders when there is a pending authentication" do
+    untenanted do
+      post session_url, params: { email_address: @identity.email_address }
+      get new_session_magic_link_url
+    end
+
+    assert_response :success
+  end
+
+  test "new redirects when there is no pending authentication" do
+    untenanted do
+      get new_session_magic_link_url
+    end
+
+    assert_redirected_to new_session_url(script_name: nil)
+  end
+
+  test "create signs in with a valid code" do
+    untenanted do
+      post session_url, params: { email_address: @identity.email_address }
+      pending = PendingAuthentication.from_token(cookies[:pending_authentication_token])
+
+      post session_magic_link_url, params: { code: pending.code }
+
+      assert_response :redirect
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects an invalid code" do
+    untenanted do
+      post session_url, params: { email_address: @identity.email_address }
+
+      post session_magic_link_url, params: { code: "NOPE12" }
+
+      assert_response :redirect
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create rejects a missing pending authentication" do
+    untenanted do
+      post session_magic_link_url, params: { code: "ABC123" }
+    end
+
+    assert_response :redirect
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create signs in via JSON" do
+    untenanted do
+      post session_url(format: :json), params: { email_address: @identity.email_address }
+      token = @response.parsed_body["pending_authentication_token"]
+      pending = PendingAuthentication.from_token(token)
+
+      post session_magic_link_url(format: :json), params: { code: pending.code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create rejects an invalid code via JSON" do
+    untenanted do
+      post session_url(format: :json), params: { email_address: @identity.email_address }
+
+      post session_magic_link_url(format: :json), params: { code: "NOPE12" }
+
+      assert_response :unauthorized
+    end
+  end
+end
+
