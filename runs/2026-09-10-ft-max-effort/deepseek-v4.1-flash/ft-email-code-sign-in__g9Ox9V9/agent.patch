@@ -0,0 +1,115 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @pending_authentication = find_pending_authentication
+
+    unless @pending_authentication
+      redirect_to new_session_url(script_name: nil), alert: "That sign-in has expired. Enter your email address to try again."
+    end
+  end
+
+  def create
+    if (pending_authentication = find_pending_authentication) && pending_authentication.authenticate(submitted_code)
+      complete_pending_authentication pending_authentication
+    else
+      reject_code
+    end
+  end
+
+  private
+    def submitted_code
+      params[:code].presence || params.dig(:magic_link, :code) || params.dig(:session, :code)
+    end
+
+    def complete_pending_authentication(pending_authentication)
+      case pending_authentication.action
+      when PendingAuthentication::JOIN
+        complete_join pending_authentication
+      when PendingAuthentication::SIGN_UP
+        complete_sign_up pending_authentication
+      else
+        complete_sign_in pending_authentication
+      end
+    end
+
+    def complete_sign_in(pending_authentication)
+      if identity = find_or_create_identity(pending_authentication.email_address)
+        clear_pending_authentication
+        start_new_session_for identity
+        respond_with_session redirect_to: after_authentication_url
+      else
+        reject_code
+      end
+    end
+
+    def complete_sign_up(pending_authentication)
+      if identity = find_or_create_identity(pending_authentication.email_address)
+        clear_pending_authentication
+        start_new_session_for identity
+        respond_with_session redirect_to: new_signup_completion_path(script_name: nil)
+      else
+        reject_code
+      end
+    end
+
+    def complete_join(pending_authentication)
+      join_code = Account::JoinCode.find_by(code: pending_authentication.join_code)
+
+      if join_code&.active?
+        identity = Identity.find_or_create_by!(email_address: pending_authentication.email_address)
+
+        clear_pending_authentication
+        start_new_session_for identity
+        join_code.redeem_if { |account| identity.join(account) }
+
+        respond_with_session redirect_to: join_destination_url(join_code.account, identity)
+      else
+        reject_code
+      end
+    end
+
+    def join_destination_url(account, identity)
+      user = User.active.find_by(account: account, identity: identity)
+
+      if user&.setup?
+        landing_url(script_name: account.slug)
+      else
+        new_users_verification_url(script_name: account.slug)
+      end
+    end
+
+    def find_or_create_identity(email_address)
+      Identity.find_by(email_address: email_address) ||
+        (Identity.create!(email_address: email_address) if Account.accepting_signups?)
+    end
+
+    def respond_with_session(redirect_to:)
+      respond_to do |format|
+        format.html { redirect_to redirect_to }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def reject_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
