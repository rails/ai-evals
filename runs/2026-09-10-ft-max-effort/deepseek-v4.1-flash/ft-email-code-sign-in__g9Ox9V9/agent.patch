diff --git a/app/models/pending_authentication.rb b/app/models/pending_authentication.rb
new file mode 100644
index 0000000..0aba1f2
--- /dev/null
+++ b/app/models/pending_authentication.rb
@@ -0,0 +1,51 @@
+# A short-lived, signed token that carries the state needed to finish an
+# authentication started by email: the address that requested it, the
+# six-character code that we emailed, and what we should do once the code is
+# confirmed (sign in, sign up, or join an account).
+class PendingAuthentication
+  EXPIRATION = 15.minutes
+  PURPOSE = :pending_authentication
+  CODE_LENGTH = 6
+
+  SIGN_IN = "sign_in"
+  SIGN_UP = "sign_up"
+  JOIN = "join"
+
+  attr_reader :email_address, :code, :action, :join_code
+
+  def initialize(email_address:, action: SIGN_IN, join_code: nil, code: nil)
+    @email_address = email_address.to_s.strip.downcase
+    @action = action.to_s
+    @join_code = join_code
+    @code = code.presence || generate_code
+  end
+
+  def self.from_token(token)
+    if token.present? && (payload = verifier.verify(token, purpose: PURPOSE))
+      new(**payload.symbolize_keys.slice(:email_address, :action, :join_code, :code))
+    end
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    nil
+  end
+
+  def self.verifier
+    Rails.application.message_verifier(:pending_authentication)
+  end
+
+  def token
+    self.class.verifier.generate(payload, purpose: PURPOSE, expires_in: EXPIRATION)
+  end
+
+  def authenticate(candidate)
+    candidate.present? && code.casecmp?(candidate.to_s.strip)
+  end
+
+  private
+    def payload
+      { "email_address" => email_address, "action" => action, "join_code" => join_code, "code" => code }.compact
+    end
+
+    def generate_code
+      SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+end
