diff --git a/test/models/pending_authentication_test.rb b/test/models/pending_authentication_test.rb
new file mode 100644
index 0000000..0132d0a
--- /dev/null
+++ b/test/models/pending_authentication_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class PendingAuthenticationTest < ActiveSupport::TestCase
+  test "generates a six-character code" do
+    pending = PendingAuthentication.new(email_address: "david@37signals.com")
+
+    assert_match(/\A[A-Z0-9]{6}\z/, pending.code)
+  end
+
+  test "round trips through a signed token" do
+    pending = PendingAuthentication.new(email_address: "david@37signals.com", action: PendingAuthentication::JOIN, join_code: "ABC")
+
+    restored = PendingAuthentication.from_token(pending.token)
+
+    assert_equal "david@37signals.com", restored.email_address
+    assert_equal pending.code, restored.code
+    assert_equal PendingAuthentication::JOIN, restored.action
+    assert_equal "ABC", restored.join_code
+  end
+
+  test "token expires after fifteen minutes" do
+    token = PendingAuthentication.new(email_address: "david@37signals.com").token
+
+    travel 16.minutes do
+      assert_nil PendingAuthentication.from_token(token)
+    end
+  end
+
+  test "rejects a tampered token" do
+    pending = PendingAuthentication.new(email_address: "david@37signals.com")
+
+    assert_nil PendingAuthentication.from_token("#{pending.token}tampered")
+  end
+
+  test "rejects a blank token" do
+    assert_nil PendingAuthentication.from_token(nil)
+  end
+
+  test "authenticate matches the code case insensitively" do
+    pending = PendingAuthentication.new(email_address: "david@37signals.com")
+
+    assert pending.authenticate(pending.code.downcase)
+    assert_not pending.authenticate("NOPE12")
+    assert_not pending.authenticate(nil)
+  end
+end
+
+class PendingAuthenticationMalformedTokenTest < ActiveSupport::TestCase
+  test "a malformed token returns nil" do
+    assert_nil PendingAuthentication.from_token("not-a-real-token")
+    assert_nil PendingAuthentication.from_token("")
+  end
+end
