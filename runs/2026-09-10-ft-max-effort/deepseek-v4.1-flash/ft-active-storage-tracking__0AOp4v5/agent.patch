diff --git a/app/models/account/storage.rb b/app/models/account/storage.rb
new file mode 100644
index 0000000..4428cf5
--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,32 @@
+module Account::Storage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    storage_blobs.sum(:byte_size)
+  end
+
+  private
+    def storage_blobs
+      ActiveStorage::Blob.where(id: card_image_blobs).or(ActiveStorage::Blob.where(id: rich_text_embed_blobs))
+    end
+
+    def card_image_blobs
+      ActiveStorage::Attachment
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .select(:blob_id)
+    end
+
+    def rich_text_embed_blobs
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .select(:blob_id)
+    end
+
+    def rich_text_ids
+      ActionText::RichText
+        .where(account_id: id, record_type: "Board", name: "public_description")
+        .or(ActionText::RichText.where(account_id: id, record_type: "Card", name: "description"))
+        .or(ActionText::RichText.where(account_id: id, record_type: "Comment", name: "body"))
+        .select(:id)
+    end
+end
