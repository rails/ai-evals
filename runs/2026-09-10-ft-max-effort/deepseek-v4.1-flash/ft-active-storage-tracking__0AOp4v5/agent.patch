@@ -0,0 +1,36 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    storage_blobs.sum(:byte_size)
+  end
+
+  private
+    def storage_blobs
+      ActiveStorage::Blob.where(id: card_image_blobs).or(ActiveStorage::Blob.where(id: rich_text_embed_blobs))
+    end
+
+    def card_image_blobs
+      ActiveStorage::Attachment
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .select(:blob_id)
+    end
+
+    def rich_text_embed_blobs
+      ActiveStorage::Attachment
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .select(:blob_id)
+    end
+
+    def rich_text_ids
+      ActionText::RichText
+        .where(record_type: "Board", record_id: id, name: "public_description")
+        .or(ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description"))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids, name: "body"))
+        .select(:id)
+    end
+
+    def comment_ids
+      Comment.where(card_id: cards.select(:id)).select(:id)
+    end
+end
