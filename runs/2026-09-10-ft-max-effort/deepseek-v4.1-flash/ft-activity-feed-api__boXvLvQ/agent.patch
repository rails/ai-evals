+++ b/docs/api/sections/activities.md
@@ -0,0 +1,71 @@
+# Activities
+
+Account activity is the same stream shown on the account's HTML Home page. It includes card updates, assignments, moves, comments, and other card events visible to the current user.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated, flat array of activity, newest first. Only events on boards the current user can access are included.
+
+Deprecated `card_collection_changed` events are omitted. `card_title_changed` events are included.
+
+### Parameters
+
+| Name | Type | Required | Description |
+|------|------|----------|-------------|
+| `creator_ids[]` | array | No | Return only activity by these user IDs |
+| `board_ids[]` | array | No | Return only activity on these board IDs |
+
+### Response
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohde",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David Heinemeier Hansson assigned Kevin Clark to \"Plain text mentions\"",
+    "particulars": {
+      "assignee_ids": [
+        "03f5v9zppzlksuj4mxba2nbzn"
+      ]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 3,
+      "title": "Plain text mentions",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/3"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+`particulars` contains event-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| All others | `{}` |
+
+Missing board, title, or column values are returned as empty strings.
+
+For card events, `url` opens the card. For comment events, `url` opens the card containing the comment and jumps to that comment.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..9f7ecb1
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns activity events" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    events = @response.parsed_body
+    assert_kind_of Array, events
+    assert events.any?
+
+    event = events.find { |e| e["id"] == events(:logo_published).id }
+    assert_equal "card_published", event["action"]
+    assert_equal events(:logo_published).created_at.utc.as_json, event["created_at"]
+    assert_equal events(:logo_published).creator_id, event["creator"]["id"]
+    assert_equal events(:logo_published).board_id, event["board"]["id"]
+    assert_equal "Card", event["eventable_type"]
+    assert_equal cards(:logo).id, event["eventable"]["id"]
+    assert_equal card_url(cards(:logo)), event["url"]
+    assert_equal({}, event["particulars"])
+    assert_includes event["description"], "David added"
+  end
+
+  test "comment events link to the comment on the card" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event["eventable"]["id"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+  end
+
+  test "includes card title changed events but excludes card collection changed events" do
+    title_event = events(:logo_published).tap do |event|
+      event.update!(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+    end
+    collection_event = events(:layout_published).tap do |event|
+      event.update!(action: "card_collection_changed")
+    end
+
+    get activities_path(format: :json)
+    ids = @response.parsed_body.map { |event| event["id"] }
+
+    assert_includes ids, title_event.id
+    assert_not_includes ids, collection_event.id
+  end
+
+  test "exposes event-specific particulars" do
+    events(:logo_published).update!(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old Board", "new_board" => "New Board" } })
+    events(:layout_published).update!(action: "card_triaged", particulars: { "particulars" => { "column" => "In Progress" } })
+
+    get activities_path(format: :json)
+    json = @response.parsed_body.index_by { |event| event["id"] }
+
+    assert_equal [ users(:jz).id ], json[events(:logo_assignment_jz).id]["particulars"]["assignee_ids"]
+    assert_equal({ "old_board" => "Old Board", "new_board" => "New Board" }, json[events(:logo_published).id]["particulars"])
+    assert_equal({ "column" => "In Progress" }, json[events(:layout_published).id]["particulars"])
+  end
+
+  test "returns empty strings for missing board, title, and column particulars" do
+    events(:logo_published).update!(action: "card_board_changed", particulars: {})
+    events(:layout_published).update!(action: "card_title_changed", particulars: {})
+    events(:shipping_published).update!(action: "card_triaged", particulars: {})
+
+    get activities_path(format: :json)
+    json = @response.parsed_body.index_by { |event| event["id"] }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, json[events(:logo_published).id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, json[events(:layout_published).id]["particulars"])
+    assert_equal({ "column" => "" }, json[events(:shipping_published).id]["particulars"])
+  end
+
+  test "filters by creator ids and board ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert @response.parsed_body.all? { |event| event["creator"]["id"] == users(:kevin).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }
+    assert @response.parsed_body.all? { |event| event["board"]["id"] == boards(:writebook).id }
+  end
+
+  test "returns only activity the current user can access" do
+    other_board = Board.create!(name: "Other", creator: users(:jason), account: accounts("37s"), all_access: false)
+    card = Card.create!(creator: users(:jason), board: other_board, title: "Secret", status: "drafted")
+    event = Event.create!(action: "card_published", creator: users(:jason), board: other_board, eventable: card)
+
+    get activities_path(format: :json)
+
+    assert_not_includes @response.parsed_body.map { |activity| activity["id"] }, event.id
+  end
+
+  test "returns events newest first" do
+    get activities_path(format: :json)
+
+    created_ats = @response.parsed_body.map { |event| event["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+end
