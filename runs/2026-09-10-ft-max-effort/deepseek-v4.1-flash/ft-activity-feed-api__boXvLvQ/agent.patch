diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..6515b3f 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -1,6 +1,11 @@
 module Event::Particulars
   extend ActiveSupport::Concern
 
+  ASSIGNMENT_ACTIONS = %w[ card_assigned card_unassigned ]
+  BOARD_ACTIONS = %w[ card_board_changed ]
+  TITLE_ACTIONS = %w[ card_title_changed ]
+  TRIAGE_ACTIONS = %w[ card_triaged ]
+
   included do
     store_accessor :particulars, :assignee_ids
   end
@@ -8,4 +13,31 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when *ASSIGNMENT_ACTIONS
+      { assignee_ids: Array(particular_value("assignee_ids")) }
+    when *BOARD_ACTIONS
+      { old_board: particular_string("old_board"), new_board: particular_string("new_board") }
+    when *TITLE_ACTIONS
+      { old_title: particular_string("old_title"), new_title: particular_string("new_title") }
+    when *TRIAGE_ACTIONS
+      { column: particular_string("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_value(key)
+      event_particulars = particulars.is_a?(Hash) ? particulars : {}
+      nested_particulars = event_particulars["particulars"]
+      nested_particulars = {} unless nested_particulars.is_a?(Hash)
+      nested_particulars[key] || event_particulars[key]
+    end
+
+    def particular_string(key)
+      particular_value(key).presence || ""
+    end
 end
