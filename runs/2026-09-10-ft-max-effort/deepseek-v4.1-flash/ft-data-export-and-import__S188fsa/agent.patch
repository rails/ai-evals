@@ -3,13 +3,68 @@ class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfe
     super(account: account, model: ::ActiveStorage::Blob)
   end
 
+  def export(zip)
+    records.find_each do |blob|
+      zip.add_file(file_path(blob), compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+  end
+
+  def import(zip)
+    processed_blob_ids = Set.new
+
+    file_entries(zip).each do |path|
+      next if path.end_with?(".json")
+
+      blob = [ File.basename(path), File.basename(path, ".*") ].uniq.lazy.map { |reference| find_blob(reference) }.find(&:itself)
+      next unless blob
+      next if processed_blob_ids.include?(blob.id)
+
+      processed_blob_ids << blob.id
+      context&.track_uploaded_blob(blob)
+
+      zip.open(path) do |io|
+        blob.service.upload(
+          blob.key,
+          io,
+          checksum: blob.checksum,
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          disposition: :attachment
+        )
+      end
+    end
+  end
+
   private
     def records
-      ::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids)
+      apply_scope(::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids))
     end
 
     def excluded_blob_ids
-      ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
+      ::ActiveStorage::Attachment.where(account: account, record_type: EXCLUDED_RECORD_TYPES).select(:blob_id)
+    end
+
+    def file_path(blob)
+      "#{model_dir}/#{blob.id}"
     end
 
+    def file_entries(zip)
+      paths = if zip.respond_to?(:entries)
+        zip.entries.map { |entry| entry.respond_to?(:name) ? entry.name : entry.to_s }
+      else
+        zip.glob("**/*")
+      end
+
+      paths.uniq.sort
+    end
+
+    def find_blob(reference)
+      if context
+        context.find_blob_for_file_reference(reference)
+      else
+        ::ActiveStorage::Blob.find_by(id: reference)
+      end
+    end
 end
