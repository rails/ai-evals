+require "test_helper"
+
+class Account::DataTransfer::RichTextEmbedImportTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    Current.account = accounts("37s")
+    @account = Current.account
+    @user = users(:kevin)
+  end
+
+  test "rich text attachment sgids are remapped during import" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "embed.jpg", content_type: "image/jpeg")
+    card = cards(:logo)
+    card.update!(description: "<p>See #{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+
+    export = @account.exports.create!(user: @user, scope: "account")
+    export.export_now
+
+    import = Import.new(identity: @user.identity, user: @user, account: @account)
+    Tempfile.create([ "export", ".zip" ]) do |tempfile|
+      tempfile.binmode
+      tempfile.write(export.file.download)
+      tempfile.rewind
+      import.file.attach(io: tempfile, filename: "export.zip", content_type: "application/zip")
+      import.save!
+
+      new_account = import.import_now
+      imported_card = new_account.cards.find_by(number: card.number)
+      body = imported_card.description.to_s
+
+      assert_includes body, "action-text-attachment"
+      sgid = Nokogiri::HTML5.fragment(body).at_css("action-text-attachment")["sgid"]
+      assert SignedGlobalID.parse(sgid, for: ActionText::Attachable::LOCATOR_NAME).present?
+      attachable = ActionText::Attachable.from_attachable_sgid(sgid)
+      assert_match %r{rails/active_storage}, attachable.to_rich_text_attributes[:url].to_s
+      assert_equal "embed.jpg", attachable.filename.to_s
+    end
+  end
+end
