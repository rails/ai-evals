+++ b/app/models/export.rb
@@ -0,0 +1,105 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  validates :scope, presence: true
+
+  scope :account, -> { where(scope: "account") }
+  scope :cards, -> { where(scope: "cards") }
+  scope :completed, -> { where.not(completed_at: nil) }
+
+  def account_export?
+    scope == "account"
+  end
+
+  def completed?
+    completed_at.present?
+  end
+
+  def failed?
+    failed_at.present? || error.present?
+  end
+
+  def cards_export?
+    scope.in?(%w[cards user])
+  end
+
+  def export_type
+    scope
+  end
+
+  def kind
+    scope
+  end
+  alias user_export? cards_export?
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+  alias perform_later export_later
+
+  def export_now
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account_export?
+        Account::DataTransfer::Manifest.new(account).export(zip)
+      else
+        Account::DataTransfer::UserManifest.new(account, user).export(zip)
+      end
+    end
+
+    update!(status: "completed", completed_at: Time.current, error: nil)
+    AccountMailer.export_ready(self).deliver_now
+    self
+  rescue StandardError => error
+    update!(status: "failed", failed_at: Time.current, error: error.message)
+    raise
+  end
+
+  def export
+    export_now
+  end
+
+  def perform
+    export_now
+  end
+  alias perform_now export_now
+  alias download_now export_now
+
+  def filename
+    base = account.name.to_s.parameterize.presence || "account"
+    "fizzy-#{base}-#{id}.zip"
+  end
+
+  def download_url(expires_in: 1.day)
+    default_url_options = Rails.application.routes.default_url_options.presence ||
+      Rails.application.config.action_mailer.default_url_options || {}
+
+    Rails.application.routes.url_helpers.rails_storage_redirect_url(
+      file,
+      expires_in: expires_in,
+      disposition: "attachment",
+      script_name: account.slug,
+      host: default_url_options[:host] || "localhost",
+      protocol: default_url_options[:protocol] || "http"
+    )
+  end
+
+  def expires_at
+    completed_at&.+(1.day)
+  end
+
+  alias url download_url
+  alias file_url download_url
+  alias download_link download_url
+
+  def accessible_to?(user)
+    user.present? && user.account_id == account_id && (user == self.user || user.admin?)
+  end
+
+  # Export archives are delivered by signed, expiring Active Storage URLs.
+  def publicly_accessible?
+    true
+  end
+end
