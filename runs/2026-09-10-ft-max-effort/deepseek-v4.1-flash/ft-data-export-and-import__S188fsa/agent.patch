+require "test_helper"
+
+class Account::DataTransfersControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+
+    @account = Current.account
+    @user = users(:kevin)
+  end
+
+  test "admin can request an account export" do
+    assert_enqueued_with job: ExportJob do
+      post account_export_path
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal 1, @account.exports.count
+  end
+
+  test "non-admin cannot request an account export" do
+    logout_and_sign_in_as :jz
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: ExportJob do
+      post account_export_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can open the import form" do
+    get new_account_import_path
+    assert_response :success
+    assert_select "form[action='#{account_imports_path}']"
+  end
+
+  test "can import an account export" do
+    export = @account.exports.create!(user: @user, scope: "account")
+    export.export_now
+
+    Tempfile.create([ "export", ".zip" ]) do |tempfile|
+      tempfile.binmode
+      tempfile.write(export.file.download)
+      tempfile.rewind
+
+      clear_enqueued_jobs
+      ActionMailer::Base.deliveries.clear
+
+      assert_enqueued_with job: ImportJob do
+        post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(tempfile.path, "application/zip") } }
+      end
+
+      assert_response :redirect
+    end
+
+    perform_enqueued_jobs
+    assert Import.last.completed?
+    assert Import.last.imported_account.present?
+    assert_emails 1
+  end
+
+  test "an invalid import does not create an account" do
+    Tempfile.create([ "invalid", ".zip" ]) do |tempfile|
+      tempfile.binmode
+      tempfile.write("not a zip")
+      tempfile.rewind
+
+      post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(tempfile.path, "application/zip") } }
+    end
+
+    assert_difference -> { Account.count }, 0 do
+      perform_enqueued_jobs
+    end
+
+    assert Import.last.failed?
+    assert_emails 1
+  end
+end
