@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::DataTransfer::RichTextRecordSetDirectTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    Current.account = accounts("37s")
+    @account = Current.account
+    @record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(@account)
+  end
+
+  test "record set exports and imports json entries" do
+    tempfile = Tempfile.new([ "rich-texts", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    @record_set.export(writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    paths = reader.glob("action_text_rich_texts/*.json")
+    assert_equal ActionText::RichText.where(account: @account).count, paths.size
+
+    rich_text = action_text_rich_texts(:logo_agreement_jz)
+    ActionText::RichText.where(account: @account).delete_all
+
+    @record_set.import(reader)
+
+    imported = ActionText::RichText.find(rich_text.id)
+    assert_includes imported.body.to_s, "I agree."
+    assert_equal @account.id, imported.account_id
+  ensure
+    tempfile&.close!
+  end
+end
