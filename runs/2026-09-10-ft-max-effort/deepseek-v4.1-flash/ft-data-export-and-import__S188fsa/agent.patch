diff --git a/app/models/account/data_transfer/import_context.rb b/app/models/account/data_transfer/import_context.rb
new file mode 100644
index 0000000..9694cfa
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,152 @@
+class Account::DataTransfer::ImportContext
+  attr_reader :importer, :account
+
+  def initialize(importer:, account:)
+    @importer = importer
+    @account = account
+    @id_map = {}
+    @records = {}
+  end
+
+  def register(model, old_id, new_id = nil)
+    return if old_id.blank?
+
+    @id_map[[ model.name, old_id.to_s ]] ||= new_id || ActiveRecord::Type::Uuid.generate
+  end
+
+  def new_id_for(model, old_id)
+    register(model, old_id)
+  end
+
+  def remember(model, old_id, record)
+    return if old_id.blank? || record.nil?
+
+    @records[[ model.name, old_id.to_s ]] = record
+  end
+
+  def record_for(model, old_id)
+    @records[[ model.name, old_id.to_s ]]
+  end
+
+  def remap_attributes(model, attributes)
+    attributes = attributes.stringify_keys.dup
+
+    if attributes["id"].present?
+      attributes["id"] = new_id_for(model, attributes["id"])
+    end
+
+    attributes["account_id"] = account.id if model.column_names.include?("account_id")
+    remap_foreign_keys(model, attributes)
+    remap_action_text_body(model, attributes)
+
+    attributes
+  end
+
+  def remember_blob_metadata(old_id, attributes)
+    return if old_id.blank?
+
+    @blob_metadata ||= {}
+    @blob_metadata[old_id.to_s] = {
+      key: attributes["key"]&.to_s,
+      filename: attributes["filename"]&.to_s
+    }
+  end
+
+  def find_blob_for_file_reference(reference)
+    reference = reference.to_s
+    return if reference.blank?
+
+    if record = record_for(ActiveStorage::Blob, reference)
+      record
+    elsif (old_id = blob_metadata_old_id(reference))
+      record_for(ActiveStorage::Blob, old_id)
+    end
+  end
+
+  def track_uploaded_blob(blob)
+    importer.track_uploaded_blob(blob)
+  end
+
+  private
+    def remap_foreign_keys(model, attributes)
+      model.column_names.each do |column|
+        next unless column.end_with?("_id")
+        next if column == "id" || column == "account_id"
+
+        old_value = attributes[column]
+        next if old_value.blank?
+
+        base = column.delete_suffix("_id")
+        if attributes["#{base}_type"].present?
+          attributes[column] = mapped_id_for_type(attributes["#{base}_type"], old_value) || old_value
+        else
+          reflection = model.reflect_on_all_associations(:belongs_to).find { |candidate| candidate.foreign_key.to_s == column }
+          attributes[column] = mapped_id_for_type(reflection.klass.name, old_value) || old_value if reflection
+        end
+      end
+    end
+
+    def blob_metadata_old_id(reference)
+      (@blob_metadata || {}).each do |old_id, metadata|
+        return old_id if metadata[:key] == reference || metadata[:filename] == reference
+      end
+
+      nil
+    end
+
+    def mapped_id_for_type(type, old_id)
+      @id_map[[ type.to_s, old_id.to_s ]]
+    end
+
+    def remap_action_text_body(model, attributes)
+      return unless model.name == "ActionText::RichText"
+      return if attributes["body"].blank?
+
+      body = attributes["body"]
+      return unless body.include?("action-text-attachment") || body.include?("trix-attachment")
+
+      attributes["body"] = remap_action_text_html(body)
+    end
+
+    def remap_action_text_html(body)
+      document = Nokogiri::HTML5.fragment(body)
+
+      document.css("action-text-attachment").each do |node|
+        next if node["sgid"].blank?
+
+        if new_blob = new_blob_for_sgid(node["sgid"])
+          node["sgid"] = new_blob.attachable_sgid
+          node["url"] = new_blob.to_rich_text_attributes[:url] if new_blob.respond_to?(:to_rich_text_attributes)
+        end
+      end
+
+      document.css("[data-trix-attachment]").each do |node|
+        attributes = JSON.parse(node["data-trix-attachment"])
+        next unless attributes["sgid"].present?
+
+        if new_blob = new_blob_for_sgid(attributes["sgid"])
+          attributes["sgid"] = new_blob.attachable_sgid
+          attributes["url"] = new_blob.to_rich_text_attributes[:url] if new_blob.respond_to?(:to_rich_text_attributes)
+          node["data-trix-attachment"] = JSON.generate(attributes)
+        end
+      rescue JSON::ParserError
+        next
+      end
+
+      document.to_html
+    end
+
+    def new_blob_for_sgid(sgid)
+      old_blob_id = old_blob_id_for_sgid(sgid)
+      record_for(ActiveStorage::Blob, old_blob_id) if old_blob_id.present?
+    end
+
+    def old_blob_id_for_sgid(sgid)
+      gid = SignedGlobalID.parse(sgid, for: ActionText::Attachable::LOCATOR_NAME)
+      return unless gid&.model_name == "ActiveStorage::Blob"
+
+      gid.model_id
+    rescue StandardError
+      nil
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..01691b3
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,120 @@
+class Account::DataTransfer::Importer
+  attr_reader :import, :account, :manifest, :context
+
+  def initialize(import)
+    import = import[:import] || import["import"] if import.is_a?(Hash)
+
+    @import = import
+    @uploaded_blob_keys = []
+  end
+
+  def import
+    with_zip do |zip|
+      ApplicationRecord.transaction do
+        account_attributes = account_attributes(zip)
+        @account = create_account(account_attributes)
+        @context = Account::DataTransfer::ImportContext.new(importer: self, account: account)
+        context.register(Account, account_attributes["id"], account.id) if account_attributes["id"].present?
+        @manifest = Account::DataTransfer::Manifest.new(account)
+
+        Current.with_account(account) do
+          manifest.prepare_import(zip, context)
+          manifest.import(zip, context: context)
+          finalize
+        end
+
+        account
+      end
+    end
+  rescue StandardError
+    cleanup_uploaded_files
+    raise
+  end
+
+  def track_uploaded_blob(blob)
+    @uploaded_blob_keys << [ blob.service, blob.key ]
+  end
+
+  private
+    def with_zip
+      raise "No import file attached" unless @import.file.attached?
+
+      @import.file.blob.open do |file|
+        reader = ZipFile::Reader.new(file)
+        yield reader
+      ensure
+        reader&.close
+      end
+    end
+
+    def create_account(attributes)
+      @imported_account_attributes = attributes
+      name = attributes["name"].to_s.strip.presence || "Imported account"
+
+      Account.create!(name: name.truncate(255, omission: "")).tap do |account|
+        timestamps = attributes.slice("created_at", "updated_at").compact
+        account.update_columns(timestamps) if timestamps.any?
+        account.entropy&.delete
+        account.association(:entropy).reset
+      end
+    end
+
+    def account_attributes(zip)
+      path = zip.glob("accounts/*.json").first || zip.glob("data/accounts/*.json").first
+      path ||= "account.json" if zip.exists?("account.json")
+      path ||= "manifest.json" if zip.exists?("manifest.json")
+      raise "This file doesn't contain a Fizzy account" unless path
+
+      JSON.parse(zip.read(path)).stringify_keys
+    end
+
+    def finalize
+      set_cards_count
+      ensure_owner_user
+      ensure_system_user
+    end
+
+    def set_cards_count
+      imported_count = @imported_account_attributes["cards_count"].to_i
+      cards_count = [ imported_count, account.cards.maximum(:number).to_i ].max
+      account.update_columns(cards_count: cards_count)
+    end
+
+    def ensure_owner_user
+      imported_user = account.users.find_by(identity_id: @import.identity_id)
+
+      if imported_user
+        imported_user.update_columns(active: true, verified_at: imported_user.verified_at || Time.current)
+      else
+        account.users.create!(
+          identity: @import.identity,
+          name: @import.user&.name.presence || @import.identity.email_address,
+          role: :owner,
+          active: true,
+          verified_at: Time.current
+        )
+      end
+    end
+
+    def ensure_system_user
+      return if account.users.exists?(role: "system")
+
+      account.users.insert!(
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: account.id,
+        name: "System",
+        role: "system",
+        active: true,
+        created_at: Time.current,
+        updated_at: Time.current
+      )
+    end
+
+    def cleanup_uploaded_files
+      @uploaded_blob_keys.each do |service, key|
+        service.delete(key)
+      rescue StandardError
+        nil
+      end
+    end
+end
