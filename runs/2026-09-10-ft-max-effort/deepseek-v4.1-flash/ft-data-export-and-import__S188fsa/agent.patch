+require "test_helper"
+
+class Account::ExportDownloadTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @account = Current.account
+    @user = users(:kevin)
+  end
+
+  test "export download URL is publicly accessible for a signed URL" do
+    export = @account.exports.create!(user: @user, scope: "account")
+    export.export_now
+
+    sign_out
+
+    url = export.download_url
+    get url
+    assert_response :redirect
+
+    follow_redirect!
+    assert_response :success
+    assert_match %r{application/zip}, response.headers["Content-Type"].to_s
+  end
+
+  test "export download URL expires after one day" do
+    export = @account.exports.create!(user: @user, scope: "account")
+    export.export_now
