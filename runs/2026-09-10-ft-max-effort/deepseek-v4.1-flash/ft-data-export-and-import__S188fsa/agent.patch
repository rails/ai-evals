--- /dev/null
+++ b/app/jobs/import_job.rb
@@ -0,0 +1,15 @@
+class ImportJob < ApplicationJob
+  def perform(import)
+    import.import_now
+    AccountMailer.import_completed(import).deliver_now
+  rescue StandardError => error
+    import.reload
+
+    unless import.completed?
+      import.update!(status: "failed", failed_at: Time.current, error: error.message)
+      AccountMailer.import_failed(import).deliver_now
+    end
+
+    Rails.error.report(error, severity: :error)
+  end
+end
