+class Account::ImportsController < ApplicationController
+  def new
+    @import = Import.new
+  end
+
+  def create
+    @import = Current.identity.imports.new(import_params.merge(account: Current.account, user: Current.user))
+
+    if @import.save
+      @import.import_later
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import), notice: "Your import is being processed. We'll email you when it's done." }
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
