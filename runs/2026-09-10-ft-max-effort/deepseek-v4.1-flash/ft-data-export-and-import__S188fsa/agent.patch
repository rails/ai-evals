+require "test_helper"
+
+class Account::DataTransfer::ExportImportTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    Current.account = accounts("37s")
+    @account = Current.account
+    @user = users(:kevin)
+  end
+
+  test "account export can be imported as a new account" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    blob_id = card.image.blob.id
+
+    export = @account.exports.create!(user: @user, scope: "account")
+    export.export_now
+    assert export.file.attached?
+
+    export.file.blob.open do |file|
+      reader = ZipFile::Reader.new(file)
+      assert reader.exists?("accounts/#{@account.id}.json")
+      assert reader.exists?("cards/#{card.id}.json")
+      assert reader.exists?("active_storage_blobs/#{blob_id}.json")
+      assert reader.exists?("active_storage_blobs/#{blob_id}")
+    end
+
+    import = Import.new(identity: @user.identity, user: @user, account: @account)
+    Tempfile.create([ "export", ".zip" ]) do |tempfile|
+      tempfile.binmode
+      tempfile.write(export.file.download)
+      tempfile.rewind
+      import.file.attach(io: tempfile, filename: "export.zip", content_type: "application/zip")
+      import.save!
+
+      new_account = import.import_now
+      assert new_account.persisted?
+      assert_equal "37signals", new_account.name
+      assert_equal Board.where(account: new_account).count, Board.where(account: @account).count
+      assert_equal Card.where(account: new_account).count, Card.where(account: @account).count
+      assert_equal Comment.where(account: new_account).count, Comment.where(account: @account).count
+      assert new_account.users.exists?(identity: @user.identity)
+
+      imported_card = new_account.cards.find_by(number: card.number)
+      assert imported_card.image.attached?
+      assert_equal "image/jpeg", imported_card.image.content_type
+
+      imported_comment = Comment.where(account: new_account, card: imported_card).joins(:rich_text_body).first
+      assert_match /(I agree|do it)/, imported_comment.rich_text_body.to_s
+    end
+  end
+end
+
+class Account::DataTransfer::UserExportTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:jz)
+    Current.account = accounts("37s")
+  end
+
+  test "cards export only includes cards the user can see" do
+    private_board = boards(:private)
+    private_card = private_board.cards.create!(title: "Private card", creator: users(:kevin))
+
+    export = Current.account.exports.create!(user: Current.user, scope: "cards")
+    export.export_now
+
+    export.file.blob.open do |file|
+      reader = ZipFile::Reader.new(file)
+      card_entries = reader.glob("cards/*.json")
+      assert_includes card_entries, "cards/#{cards(:logo).id}.json"
+      assert_not_includes card_entries, "cards/#{private_card.id}.json"
+      assert_empty reader.glob("cards/*.json").select { |entry| entry.include?(private_card.id) }
+    end
+  end
+end
diff --git a/test/models/account/data_transfer/full_record_set_import_test.rb b/test/models/account/data_transfer/full_record_set_import_test.rb
new file mode 100644
index 0000000..fc427a2
--- /dev/null
+++ b/test/models/account/data_transfer/full_record_set_import_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::DataTransfer::FullRecordSetImportTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    Current.account = accounts("37s")
+    @account = Current.account
+    @user = users(:kevin)
+  end
+
+  test "all manifest record sets round trip" do
+    boards(:writebook).publish
+
+    export = @account.exports.create!(user: @user, scope: "account")
+    export.export_now
+
+    import = Import.new(identity: @user.identity, user: @user, account: @account)
+    Tempfile.create([ "export", ".zip" ]) do |tempfile|
+      tempfile.binmode
+      tempfile.write(export.file.download)
+      tempfile.rewind
+      import.file.attach(io: tempfile, filename: "export.zip", content_type: "application/zip")
+      import.save!
+      new_account = import.import_now
+
+      models = [
+        User, User::Settings, Tag, Board, Column, Entropy, Board::Publication, Webhook, Access,
+        Card, Comment, Step, Assignment, Tagging, Closure, Card::Goldness, Card::NotNow,
+        Card::ActivitySpike, Watch, Pin, Reaction, Mention, Filter, Webhook::DelinquencyTracker,
+        Event, Notification, Notification::Bundle, Webhook::Delivery,
+        ActiveStorage::Blob, ActiveStorage::VariantRecord, ActiveStorage::Attachment,
+        ActionText::RichText
+      ]
+
+      imported_board = new_account.boards.find_by(name: boards(:writebook).name)
+      assert_not_equal boards(:writebook).publication.key, imported_board.publication.key
+
+      models.each do |model|
+        old_scope = model.where(account_id: @account.id)
+        new_scope = model.where(account_id: new_account.id)
+
+        if model == ActiveStorage::Blob
+          old_scope = old_scope.where.not(id: ActiveStorage::Attachment.where(account: @account, record_type: %w[Export Import]).select(:blob_id))
+          new_scope = new_scope.where.not(id: ActiveStorage::Attachment.where(account: new_account, record_type: %w[Export Import]).select(:blob_id))
+        elsif model == ActiveStorage::Attachment
+          old_scope = old_scope.where.not(record_type: %w[Export Import])
+          new_scope = new_scope.where.not(record_type: %w[Export Import])
+        end
+
+        assert_equal old_scope.count, new_scope.count, "#{model.name} count mismatch"
+      end
+    end
+  end
+end
