diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..9b8cbe3
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,98 @@
+class ZipFile::Reader
+  attr_reader :io
+
+  def initialize(file = nil, io: nil)
+    file ||= io
+    raise ArgumentError, "No file given" unless file
+
+    @tempfile = nil
+    file = file.blob if file.respond_to?(:blob) && file.blob.is_a?(ActiveStorage::Blob)
+
+    if file.is_a?(ActiveStorage::Blob)
+      @tempfile = Tempfile.new([ "zip", ".zip" ])
+      @tempfile.binmode
+      file.download { |chunk| @tempfile.write(chunk) }
+      @tempfile.rewind
+      file = @tempfile
+    end
+
+    file = file.to_s if file.is_a?(Pathname)
+    @io = file.is_a?(String) ? File.open(file, "rb") : file
+    @owns_io = file.is_a?(String)
+    @entries = ZipKit::FileReader.read_zip_structure(io: @io)
+    @entries_by_name = @entries.index_by(&:filename)
+  end
+
+  def entries
+    @entries.map(&:filename)
+  end
+  alias names entries
+  alias file_names entries
+
+  def glob(pattern)
+    @entries.map(&:filename).select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(path)
+    @entries_by_name.key?(path)
+  end
+
+  def read(path)
+    open(path) { |io| io.read }
+  end
+
+  def open(path)
+    entry = @entries_by_name.fetch(path) { raise Errno::ENOENT, path }
+    entry_io = EntryIO.new(self, entry)
+
+    if block_given?
+      begin
+        yield entry_io
+      ensure
+        entry_io.close
+      end
+    else
+      entry_io
+    end
+  end
+
+  def close
+    @io.close if @owns_io && !@io.closed?
+    @tempfile&.close!
+  end
+
+  class EntryIO
+    def initialize(reader, entry)
+      @reader = reader
+      @entry = entry
+      rewind
+    end
+
+    def size
+      @entry.uncompressed_size
+    end
+
+    def read(length = nil, outbuf = nil)
+      if length.nil?
+        data = +""
+        data << @extractor.extract(1.megabyte) until @extractor.eof?
+        outbuf ? outbuf.replace(data) : data
+      else
+        data = @extractor.extract(length) || ""
+        outbuf ? outbuf.replace(data) : data
+      end
+    end
+
+    def eof?
+      @extractor.eof?
+    end
+
+    def rewind
+      @extractor = @entry.extractor_from(@reader.io)
+    end
+
+    def close
+      @extractor = nil
+    end
+  end
+end
