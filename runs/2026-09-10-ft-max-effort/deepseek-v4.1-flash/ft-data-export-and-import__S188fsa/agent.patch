+  end
+
+  def completed?
+    completed_at.present?
+  end
+
+  def failed?
+    error.present?
+  end
+
+  def failure_message
+    error
+  end
+
+  def failure_reason
+    error
+  end
+
+  def error_message
+    error
+  end
