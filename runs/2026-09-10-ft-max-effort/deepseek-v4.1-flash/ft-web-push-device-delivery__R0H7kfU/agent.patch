@@ -0,0 +1,43 @@
+class Push::Notification
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def to_json(...)
+    { title: title, body: body, url: url }.to_json(...)
+  end
+
+  def title
+    payload["title"]
+  end
+
+  def body
+    payload["body"]
+  end
+
+  def url
+    payload.dig("card", "url") || payload["url"]
+  end
+
+  private
+    attr_reader :notification
+
+    def payload
+      @payload ||= JSON.parse(render)
+    end
+
+    def render
+      renderer.render(
+        partial: "notifications/notification",
+        formats: :json,
+        locals: { notification: notification }
+      )
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(
+        script_name: notification.account.slug,
+        https: !Rails.env.local?
+      )
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..5059634
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,41 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  normalizes :endpoint, with: -> { it.strip }
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, presence: true
+  validates :auth_key, presence: true
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: Push::Notification.new(notification).to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error => error
+    Rails.error.report error, handled: true, severity: :warning,
+      context: { push_subscription_id: id, user_id: user_id }
+  end
+  alias_method :push, :deliver
+
+  private
+    def vapid_options
+      if ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+        {
+          subject: ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do"),
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        }
+      else
+        {}
+      end
+    end
+end
