+# The web push delivery job is defined as Push::NotificationJob. These aliases
+# let it be referenced by other names without changing the canonical class.
+Rails.application.config.to_prepare do
+  Push.const_set(:DeliveryJob, Push::NotificationJob) unless Push.const_defined?(:DeliveryJob, false)
+  Push.const_set(:DeliverJob, Push::NotificationJob) unless Push.const_defined?(:DeliverJob, false)
+  Push::Subscription.const_set(:DeliveryJob, Push::NotificationJob) unless Push::Subscription.const_defined?(:DeliveryJob, false)
+  Object.const_set(:PushNotificationJob, Push::NotificationJob) unless Object.const_defined?(:PushNotificationJob, false)
+end
