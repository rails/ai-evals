diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..fab377d
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,50 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications turned on for this device" }
+      format.turbo_stream { head :no_content }
+      format.json { render json: { id: @push_subscription.id }, status: :created }
+    end
+  end
+
+  def destroy
+    @push_subscription = find_push_subscription
+    @push_subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications turned off for this device" }
+      format.turbo_stream { head :no_content }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def find_push_subscription
+      @user.push_subscriptions.find_by(id: params[:id]) ||
+        @user.push_subscriptions.find_by(endpoint: endpoint_param)
+    end
+
+    def endpoint_param
+      params[:endpoint].presence || params.dig(:push_subscription, :endpoint)
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..c4f6a6f
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,151 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "status" ]
+  static values = {
+    subscribeUrl: String,
+    vapidPublicKey: String
+  }
+
+  connect() {
+    this.supported = "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+    this.updateUI()
+
+    if (this.supported) {
+      this.#sync()
+    }
+  }
+
+  async subscribe(event) {
+    event.preventDefault()
+
+    if (!this.supported) return
+
+    try {
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") {
+        this.updateUI()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey()
+        })
+      }
+
+      await this.#save(subscription)
+      this.subscription = subscription
+      this.updateUI()
+      this.#status("Notifications are on for this device.")
+    } catch (error) {
+      console.error(error)
+      this.#status("Couldn't turn on notifications. Check your browser settings and try again.")
+    }
+  }
+
+  async unsubscribe(event) {
+    event.preventDefault()
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#remove(subscription)
+        await subscription.unsubscribe()
+      }
+
+      this.subscription = null
+      this.subscriptionId = null
+      this.updateUI()
+      this.#status("Notifications are off for this device.")
+    } catch (error) {
+      console.error(error)
+      this.#status("Couldn't turn off notifications. Try again.")
+    }
+  }
+
+  updateUI() {
+    const on = !!this.subscription
+    this.element.classList.toggle("notifications--on", on)
+
+    const blocked = this.supported && Notification.permission === "denied"
+    this.detailsTargets.forEach((element) => {
+      element.hidden = this.supported && !blocked
+    })
+
+    if (!this.supported) {
+      this.#status("This browser doesn't support push notifications.")
+    }
+  }
+
+  // Private
+
+  async #sync() {
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription) {
+      this.subscription = subscription
+      await this.#save(subscription)
+    }
+
+    this.updateUI()
+  }
+
+  async #save(subscription) {
+    const json = subscription.toJSON()
+
+    const response = await post(this.subscribeUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      contentType: "application/json",
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const data = await response.json
+      this.subscriptionId = data.id
+    }
+  }
+
+  async #remove(subscription) {
+    if (this.subscriptionId) {
+      await destroy(`${this.subscribeUrlValue}/${this.subscriptionId}`, { responseKind: "json" })
+    } else {
+      await destroy(this.subscribeUrlValue, {
+        body: { endpoint: subscription.endpoint },
+        contentType: "application/json",
+        responseKind: "json"
+      })
+    }
+  }
+
+  #applicationServerKey() {
+    const key = this.vapidPublicKeyValue || document.querySelector('meta[name="vapid-public-key"]')?.content
+    if (!key) return undefined
+
+    const padding = "=".repeat((4 - (key.length % 4)) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = window.atob(base64)
+    return Uint8Array.from([...raw].map((char) => char.charCodeAt(0)))
+  }
+
+  #status(message) {
+    if (this.hasStatusTarget) {
+      this.statusTarget.textContent = message
+      this.statusTarget.hidden = !message
+    }
+  }
+}
