diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..13a577c 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,33 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      where(id: Account::Cancellation.where(created_at: ...INCINERATION_GRACE_PERIOD.ago).select(:account_id))
+    }
+    scope :due_to_incinerate, -> { due_for_incineration }
+    scope :incineratable, -> { due_for_incineration }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    account_id = id
+
+    purge_attachments
+    destroy
+    Storage::Entry.where(account_id: account_id).delete_all
+  end
+  alias_method :incinerate!, :incinerate
+
+  def incineratable?
+    cancellation.present? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+  alias_method :due_for_incineration?, :incineratable?
 end
