+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex flex-column gap">
+      <div>
+        <h2 class="divider txt-medium">Account</h2>
+        <p>
+          <strong>Plan:</strong> <%= @account.plan.proper_name %>
+          <% if @account.comped? %><span class="txt-subtle">(comped)</span><% end %>
+        </p>
+        <p><strong>Cards:</strong> <%= number_with_delimiter(@account.cards_count) %></p>
+        <p><strong>Bytes used:</strong> <%= number_with_delimiter(@account.bytes_used) %></p>
+      </div>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn" %>
+        <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), class: "btn" %>
+      </div>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <h2 class="divider txt-medium">Override</h2>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :patch, class: "flex flex-column gap" do |form| %>
+      <label class="flex flex-column gap-quarter">
+        <span>Card count</span>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+      </label>
+
+      <label class="flex flex-column gap-quarter">
+        <span>Bytes used</span>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+      </label>
+
+      <div class="flex gap-half">
+        <%= form.submit "Override", class: "btn" %>
+      </div>
+    <% end %>
+
+    <div class="flex gap-half margin-block-start-half">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :delete, class: "btn btn--reversed" %>
+    </div>
+  </div>
+
+  <%= link_to "Back to accounts", saas.admin_accounts_path, class: "btn" %>
+</section>
