diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
index 5efb1a7..1493195 100644
--- a/saas/app/models/subscription.rb
+++ b/saas/app/models/subscription.rb
@@ -1,13 +1,122 @@
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  SHORT_NAMES = %w[ FreeV1 MonthlyV1 MonthlyV1Plus ].freeze
 
-  def self.short_name
-    name.demodulize
+  # Marketing/display names are provided by each plan. Paid plans are keyed by
+  # the Stripe price environment variable that represents them.
+  PLAN_ALIASES = {
+    "free" => "FreeV1",
+    "freev1" => "FreeV1",
+    "unlimited" => "MonthlyV1",
+    "unlimitedv1" => "MonthlyV1",
+    "monthly" => "MonthlyV1",
+    "monthlyv1" => "MonthlyV1",
+    "unlimited+" => "MonthlyV1Plus",
+    "unlimitedplus" => "MonthlyV1Plus",
+    "unlimitedplusv1" => "MonthlyV1Plus",
+    "monthlyv1plus" => "MonthlyV1Plus",
+    "monthlyplusv1" => "MonthlyV1Plus",
+    "monthlyv1extrastorage" => "MonthlyV1Plus",
+    "monthlyextrastoragev1" => "MonthlyV1Plus",
+    "extrastorage" => "MonthlyV1Plus",
+    "extrastoragev1" => "MonthlyV1Plus",
+    "comped" => "FreeV1",
+    "comp" => "FreeV1"
+  }.freeze
+
+  # A plan key string that also exposes the plan's properties, so callers can
+  # treat `account.plan` either as the plan key ("FreeV1") or as the plan
+  # descriptor (plan.proper_name, plan.card_limit, ...).
+  class Plan < String
+    def initialize(key)
+      super(key.to_s)
+    end
+
+    def plan
+      Subscription.find(to_s)
+    end
+
+    def method_missing(name, *args, &block)
+      if plan.respond_to?(name)
+        plan.public_send(name, *args, &block)
+      else
+        super
+      end
+    end
+
+    def respond_to_missing?(name, include_private = false)
+      plan.respond_to?(name, include_private) || super
+    end
+  end
+
+  class << self
+    def wrap(key)
+      Plan.new(key)
+    end
+
+    def short_name
+      name.demodulize
+    end
+
+    def to_param
+      short_name
+    end
+
+    def paid?
+      price.to_i.positive?
+    end
+
+    # The Stripe recurring price that represents this plan, if any.
+    def stripe_price_id
+      case short_name
+      when "MonthlyV1" then ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      when "MonthlyV1Plus" then ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      end
+    end
+
+    # Look up a plan by key/name, tolerating the various spellings that show up
+    # in Stripe metadata and the database.
+    def find(key)
+      return key if key.is_a?(Class) && key <= Subscription
+
+      normalized = key.to_s.strip
+      return FreeV1 if normalized.blank?
+
+      const_name = PLAN_ALIASES[normalized.downcase] || normalized
+      const_get(const_name, false)
+    rescue NameError
+      FreeV1
+    end
   end
 
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
+    property :proper_name,  "Free"
     property :price,        0
-    property :frequency,    "yearly"
+    property :frequency,    "monthly"
+    property :card_limit,   1_000
+    property :storage_limit, 1.gigabyte
   end
+
+  class MonthlyV1 < Subscription
+    property :proper_name,  "Unlimited"
+    property :price,        20
+    property :frequency,    "monthly"
+    property :card_limit,   nil
+    property :storage_limit, 5.gigabytes
+  end
+
+  class MonthlyV1Plus < Subscription
+    property :proper_name,  "Unlimited+"
+    property :price,        25
+    property :frequency,    "monthly"
+    property :card_limit,   nil
+    property :storage_limit, 500.gigabytes
+  end
+
+  # Convenience aliases so the plan names used in the product read naturally.
+  Unlimited = MonthlyV1
+  UnlimitedPlus = MonthlyV1Plus
+  UnlimitedV1 = MonthlyV1
+  UnlimitedPlusV1 = MonthlyV1Plus
+  MonthlyExtraStorageV1 = MonthlyV1Plus
+  MonthlyV1ExtraStorage = MonthlyV1Plus
 end
