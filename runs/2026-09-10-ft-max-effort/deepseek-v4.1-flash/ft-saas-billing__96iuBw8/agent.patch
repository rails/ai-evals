diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..cd481a2
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,126 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(payload, signature, webhook_secret)
+
+    case event.type
+    when "customer.subscription.created", "customer.subscription.updated"
+      sync_subscription(event.data.object)
+    when "customer.subscription.deleted"
+      delete_subscription(event.data.object)
+    when "checkout.session.completed"
+      sync_checkout_session(event.data.object)
+    when "invoice.created", "invoice.finalized", "invoice.paid", "invoice.payment_succeeded", "invoice.payment_failed"
+      sync_invoice(event.data.object)
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def payload
+      request.body.read
+    end
+
+    def signature
+      request.env["HTTP_STRIPE_SIGNATURE"]
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+
+    def sync_subscription(stripe_subscription)
+      subscription = subscription_for(stripe_subscription)
+      return unless subscription
+
+      subscription.stripe_customer_id ||= stripe_customer(stripe_subscription)
+      subscription.update!(
+        plan_key: plan_key_for(stripe_subscription),
+        stripe_subscription_id: stripe_subscription.id,
+        status: attribute(stripe_subscription, :status),
+        current_period_end: timestamp(attribute(stripe_subscription, :current_period_end)),
+        cancel_at: timestamp(attribute(stripe_subscription, :cancel_at))
+      )
+    end
+
+    def delete_subscription(stripe_subscription)
+      subscription_for(stripe_subscription)&.update!(plan_key: "FreeV1", status: "canceled")
+    end
+
+    def sync_checkout_session(session)
+      subscription = subscription_for(session)
+      return unless subscription
+
+      subscription.stripe_customer_id ||= attribute(session, :customer)
+      subscription.stripe_subscription_id ||= attribute(session, :subscription)
+      subscription.save! if subscription.changed?
+    end
+
+    def sync_invoice(invoice)
+      subscription = subscription_for(invoice)
+      return unless subscription
+
+      subscription.update!(next_amount_due_in_cents: attribute(invoice, :amount_due) || attribute(invoice, :total))
+    end
+
+    def subscription_for(object)
+      subscription_id = attribute(object, :subscription)
+      subscription_id ||= attribute(object, :id) if attribute(object, :object).to_s == "subscription"
+      customer_id = stripe_customer(object)
+
+      by_subscription = Account::Subscription.find_by(stripe_subscription_id: subscription_id) if subscription_id.present?
+      by_customer = Account::Subscription.find_by(stripe_customer_id: customer_id) if customer_id.present?
+
+      by_subscription || by_customer || account_for(object)&.subscription || account_for(object)&.build_subscription
+    end
+
+    def account_for(object)
+      if (account_id = metadata_value(object, "account_id")).present?
+        Account.find_by(id: account_id)
+      elsif (queenbee_id = metadata_value(object, "queenbee_id")).present?
+        Account.find_by(external_account_id: queenbee_id)
+      elsif (external_account_id = metadata_value(object, "external_account_id")).present?
+        Account.find_by(external_account_id: external_account_id)
+      end
+    end
+
+    def stripe_customer(object)
+      attribute(object, :customer)
+    end
+
+    def plan_key_for(stripe_subscription)
+      price_ids = if stripe_subscription.respond_to?(:items) && stripe_subscription.items.respond_to?(:data)
+        stripe_subscription.items.data.map { |item| item.price&.id }
+      else
+        []
+      end
+
+      if ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].present? &&
+          price_ids.include?(ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"])
+        "MonthlyV1Plus"
+      else
+        "MonthlyV1"
+      end
+    end
+
+    def metadata_value(object, key)
+      metadata = attribute(object, :metadata)
+      return nil unless metadata
+
+      metadata[key] || metadata[key.to_sym]
+    end
+
+    def attribute(object, name)
+      object.respond_to?(name) ? object.public_send(name) : nil
+    end
+
+    def timestamp(value)
+      value.present? ? Time.zone.at(value.to_i) : nil
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..f6205e8
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,156 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  # Free plans run out of cards and storage, so we warn a little before the
+  # wall and stop allowing new published cards once we hit it.
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+  FREE_CARD_LIMIT = 1_000
+  FREE_STORAGE_LIMIT = 1.gigabyte
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+
+  # -- Plan -----------------------------------------------------------------
+
+  def plan_key
+    subscription&.plan_key.presence || "FreeV1"
+  end
+
+  def plan
+    Subscription.wrap(plan_key)
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def plan_name
+    plan.proper_name
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def stripe_subscription_id
+    subscription&.stripe_subscription_id
+  end
+
+  # -- Comp ---------------------------------------------------------------
+
+  def comped?
+    waiver = billing_waiver
+    waiver.present? && !waiver.destroyed?
+  end
+
+  def comped
+    comped?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless comped?
+    else
+      billing_waiver&.destroy
+      association(:billing_waiver).reset
+    end
+  end
+
+  def comp!
+    self.comped = true
+  end
+
+  def uncomp!
+    self.comped = false
+  end
+
+  # -- Overridden limits (support tooling) --------------------------------
+
+  # Overrides replace the values we check limits against, so support can
+  # unblock an account without touching the underlying data.
+  def override!(**attributes)
+    limit = overridden_limit || build_overridden_limit
+    values = attributes.slice(:card_count, :bytes_used).transform_values { |value| normalize_override(value) }
+    limit.update!(values)
+    limit
+  end
+
+  def reset_override!
+    overridden_limit&.destroy
+    association(:overridden_limit).reset
+  end
+  alias_method :reset_override, :reset_override!
+  alias_method :remove_override!, :reset_override!
+
+  # -- Card limits ---------------------------------------------------------
+
+  def cards_count
+    overridden_limit&.card_count || super
+  end
+  alias_method :cards_used, :cards_count
+
+  def card_limit
+    return nil if comped?
+    plan.card_limit
+  end
+
+  def cards_remaining
+    return nil if card_limit.nil?
+    [ card_limit - cards_count, 0 ].max
+  end
+  alias_method :cards_left, :cards_remaining
+
+  def exceeding_card_limit?
+    return false if comped?
+    card_limit.present? && cards_count >= card_limit
+  end
+  alias_method :over_card_limit?, :exceeding_card_limit?
+
+  def nearing_card_limit?
+    return false if comped? || exceeding_card_limit?
+    card_limit.present? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+  alias_method :near_card_limit?, :nearing_card_limit?
+
+  # -- Storage limits ------------------------------------------------------
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def storage_limit
+    storage_exception&.bytes_allowed || plan.storage_limit
+  end
+
+  def exceeding_storage_limit?
+    return false if comped?
+    bytes_used > storage_limit
+  end
+  alias_method :over_storage_limit?, :exceeding_storage_limit?
+
+  def nearing_storage_limit?
+    return false if comped? || exceeding_storage_limit?
+    bytes_used > storage_limit - Account::StorageLimited::NEAR_STORAGE_LIMIT_THRESHOLD
+  end
+  alias_method :near_storage_limit?, :nearing_storage_limit?
+
+  # True when any plan limit has been exhausted.
+  def exceeding_limits?
+    exceeding_card_limit? || exceeding_storage_limit?
+  end
+  alias_method :over_limits?, :exceeding_limits?
+  alias_method :limit_reached?, :exceeding_limits?
+
+  def nearing_limits?
+    nearing_card_limit? || nearing_storage_limit?
+  end
+
+  private
+    def normalize_override(value)
+      return nil if value.nil? || value.to_s.strip.empty?
+      value.to_i
+    end
+end
