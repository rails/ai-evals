diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..bc3c67a
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,43 @@
+class Admin::AccountsController < ::AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(created_at: :desc).includes(:subscription, :billing_waiver, :overridden_limit)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    @account.override!(**override_params.to_h.symbolize_keys)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  end
+
+  def reset
+    @account.reset_override!
+    redirect_to saas.admin_account_path(@account), notice: "Override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by(external_account_id: params[:id])
+      raise ActiveRecord::RecordNotFound, "Couldn't find Account" unless @account
+    end
+
+    def override_params
+      source = params.dig(:account, :overridden_limit) || params[:overridden_limit] || params[:account] || params
+      source.permit(:card_count, :bytes_used)
+    end
+end
diff --git a/saas/app/controllers/billings_controller.rb b/saas/app/controllers/billings_controller.rb
new file mode 100644
index 0000000..d02f2dc
--- /dev/null
+++ b/saas/app/controllers/billings_controller.rb
@@ -0,0 +1,53 @@
+class BillingsController < ApplicationController
+  before_action :ensure_billing_admin, only: %i[ create portal ]
+
+  def show
+    @plan = Current.account.plan
+  end
+
+  # Stripe hosts checkout, so all we do is create a Checkout Session and send
+  # the customer to Stripe.
+  def create
+    session = Stripe::Checkout::Session.create(
+      mode: "subscription",
+      customer: stripe_customer_id,
+      line_items: [ { price: plan_price_id, quantity: 1 } ],
+      allow_promotion_codes: true,
+      client_reference_id: Current.account.id,
+      metadata: { account_id: Current.account.id },
+      success_url: saas.billing_url,
+      cancel_url: saas.billing_url,
+      subscription_data: { metadata: { account_id: Current.account.id } }
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  # Stripe hosts the customer portal too.
+  def portal
+    session = Stripe::BillingPortal::Session.create(
+      customer: stripe_customer_id,
+      return_url: saas.billing_url
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def ensure_billing_admin
+      head :forbidden unless Current.user.admin? || Current.user.owner?
+    end
+
+    def plan_price_id
+      Subscription.find(billing_params[:plan]).stripe_price_id ||
+        ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    end
+
+    def billing_params
+      params.permit(:plan)
+    end
+
+    def stripe_customer_id
+      Current.account.stripe_customer_id
+    end
+end
