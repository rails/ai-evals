+module ReactionsHelper
+  def reaction_form_path(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_path(reactable.card, reactable)
+    else
+      card_reactions_path(reactable)
+    end
+  end
+
+  def reaction_path(reaction)
+    if reaction.reactable.is_a?(Comment)
+      card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction)
+    else
+      card_reaction_path(reaction.reactable, reaction)
+    end
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..e81e69d
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,38 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  open(event) {
+    event.preventDefault()
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction")
+    this.formTarget.querySelector(".reaction__form")?.classList.add("expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  close(event) {
+    if (event) event.preventDefault()
+
+    if (this.hasFormTarget) {
+      this.formTarget.querySelector("form")?.reset()
+      this.formTarget.classList.remove("reaction")
+      this.formTarget.hidden = true
+      this.formTarget.querySelector(".reaction__form")?.classList.remove("expanded")
+    }
+
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+  }
+
+  pick(event) {
+    event.preventDefault()
+    this.inputTarget.value = event.currentTarget.textContent.trim()
+    this.inputTarget.focus()
+    this.inputTarget.closest(".reaction__form")?.querySelector("details[open]")?.removeAttribute("open")
+  }
+
+  stop(event) {
+    event.stopPropagation()
+  }
+}
