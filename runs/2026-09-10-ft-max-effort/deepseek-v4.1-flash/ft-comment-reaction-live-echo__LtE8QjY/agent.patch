diff --git a/app/models/concerns/reactionable.rb b/app/models/concerns/reactionable.rb
new file mode 100644
index 0000000..80b3748
--- /dev/null
+++ b/app/models/concerns/reactionable.rb
@@ -0,0 +1,15 @@
+module Reactionable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :reactions, -> { chronologically }, as: :reactable, dependent: :destroy
+  end
+
+  def reacted_by?(user)
+    reactions.exists?(reacter: user)
+  end
+
+  def reaction_by(user)
+    reactions.find_by(reacter: user)
+  end
+end
diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..f270744
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,26 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  after_create :register_card_activity
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  delegate :card, to: :reactable
+
+  def to_partial_path
+    "reactions/reaction"
+  end
+
+  def emoji_only?
+    EmojiHelper::REACTIONS.key?(content)
+  end
+
+  private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
