new file mode 100644
index 0000000..d0c5a25
--- /dev/null
+++ b/app/views/reactions/_form.html.erb
@@ -0,0 +1,30 @@
+<div class="reaction--form" data-reaction-target="form" hidden>
+  <%= form_with url: reaction_form_path(reactable), scope: :reaction, class: "reaction__form",
+        data: { controller: "form", action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit" } do |form| %>
+    <label class="reaction__form-label">
+      <%= form.text_field :content, maxlength: 16, class: "input reaction__input",
+            autocomplete: "off", placeholder: "React…", value: nil,
+            data: { reaction_target: "input", form_target: "input" } %>
+    </label>
+
+    <details class="reaction__menu">
+      <summary class="reaction__menu-btn btn" title="Pick an emoji"><%= icon_tag "reaction" %></summary>
+      <div class="reaction__popup popup">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn" title="<%= name %>" data-action="reaction#pick"><%= emoji %></button>
+          <% end %>
+        </div>
+      </div>
+    </details>
+
+    <button type="submit" class="reaction__submit-btn btn" title="Confirm">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    </button>
+    <button type="button" class="reaction__cancel-btn btn" title="Cancel" data-action="reaction#close">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    </button>
+  <% end %>
+</div>
diff --git a/app/views/reactions/_reaction.html.erb b/app/views/reactions/_reaction.html.erb
new file mode 100644
index 0000000..fb15488
--- /dev/null
+++ b/app/views/reactions/_reaction.html.erb
@@ -0,0 +1,20 @@
+<% deleteable = reaction.reacter == Current.user %>
+<% data = deleteable ? { controller: "toggle-class", action: "click->toggle-class#toggle", toggle_class_toggle_class: "expanded" } : {} %>
+
+<%= tag.div id: dom_id(reaction), class: class_names("reaction", "reaction--deleteable": deleteable), data: data do %>
+  <figure class="reaction__avatar" aria-hidden="true">
+    <%= avatar_preview_tag reaction.reacter, hidden_for_screen_reader: true %>
+  </figure>
+
+  <span class="txt-small <%= "txt-medium" if reaction.emoji_only? %>"><%= reaction.content %></span>
+
+  <% if deleteable %>
+    <%= button_to reaction_path(reaction), method: :delete, class: "reaction__delete btn",
+          form: { data: { turbo_stream: true } },
+          data: { action: "click->reaction#stop" },
+          title: "Remove your reaction" do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Remove your reaction</span>
+    <% end %>
+  <% end %>
+<% end %>
