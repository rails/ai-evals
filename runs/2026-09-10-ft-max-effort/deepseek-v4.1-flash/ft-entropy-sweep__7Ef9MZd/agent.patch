new file mode 100644
index 0000000..4259315
--- /dev/null
+++ b/app/jobs/card/auto_postpone_job.rb
@@ -0,0 +1,12 @@
+class Card::AutoPostponeJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(card)
+    return unless card.active?
+    return if card.last_active_at > card.auto_postpone_period.seconds.ago
+
+    card.auto_postpone(user: card.account.system_user)
+  end
+end
