--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,15 @@
+# Secrets for a self-hosted Fizzy deployment (see config/deploy.yml).
+#
+# Kamal reads this file as a dotenv file and makes the values available to the
+# entries listed under `env.secret` in config/deploy.yml. It ships reading from
+# your environment, so keep it git-safe: export the variables in the shell that
+# runs `bin/kamal`, read them from a file, or fetch them from a password
+# manager. See https://kamal-deploy.org/docs/configuration/env/ for details.
+
+# Signs cookies and other tokens. Generate it once with `bin/rails secret` and
+# keep it stable across deploys, otherwise everyone will be signed out. Replace
+# the value on the right only if you are keeping this file out of git.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for the SMTP server configured in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
