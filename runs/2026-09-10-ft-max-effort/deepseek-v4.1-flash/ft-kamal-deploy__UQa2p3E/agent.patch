diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..5a0eab7
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,98 @@
+# Single-server Kamal deployment for self-hosting Fizzy.
+#
+# Everything runs in one container on one Linux box: the Rails app (served by
+# Thruster/Puma), the Solid Queue background worker inside Puma, SQLite, and
+# local file storage. kamal-proxy terminates TLS and fetches a Let's Encrypt
+# certificate for your hostname.
+#
+# Before your first deploy:
+#   1. Put your server's IP or hostname under `servers.web` below.
+#   2. Put your public hostname under `proxy.host` and `APP_FQDN` below, and
+#      fill in your mail server details. The hostname must resolve to the
+#      server above, with ports 80 and 443 reachable.
+#   3. Put your secrets in `.kamal/secrets` (see that file).
+#   4. Run `bin/kamal setup` (subsequent releases: `bin/kamal deploy`).
+#
+# SQLite databases and uploaded files live on the `fizzy_storage` volume, so
+# they survive redeploys.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. A local registry on the server is used below, so
+# no external image host is required.
+image: fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - 192.168.0.1 # <- your server's IP address or hostname
+
+# Enable SSL auto certification via Let's Encrypt. Requires a single web server
+# (which this config uses) and the hostname below to point at it.
+#
+# If you use Cloudflare, set the encryption mode in the SSL/TLS settings to
+# "Full" to enable end-to-end encryption.
+proxy:
+  ssl: true
+  host: fizzy.example.com # <- your public hostname
+
+# Use a local Docker registry running on the server, so `kamal setup` can build
+# and push the image without any external registry credentials.
+registry:
+  server: localhost:5555
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  secret:
+    # Signs cookies and other tokens. Generate once with `bin/rails secret`
+    # and keep it stable so logins survive redeploys.
+    - SECRET_KEY_BASE
+    # Password for the SMTP server configured below.
+    - SMTP_PASSWORD
+  clear:
+    RAILS_ENV: production
+    # Self-hosting uses SQLite; the databases live on the volume below.
+    DATABASE_ADAPTER: sqlite
+
+    # Public hostname, used to build links in emails and notifications.
+    APP_FQDN: fizzy.example.com # <- your public hostname
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@fizzy.example.com>"
+
+    # Outgoing mail. Fill in the details for your SMTP server. Port 587 with
+    # STARTTLS is the common choice; use SMTP_AUTHENTICATION=cram_md5 or plain
+    # for other servers.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+
+    # Run the Solid Queue supervisor inside the web server's Puma process so
+    # background jobs run on the same box, in the same container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Set the number of Puma workers to match your server's CPUs (defaults to
+    # the number of physical CPUs).
+    # WEB_CONCURRENCY: 2
+
+# Aliases are triggered with "bin/kamal <alias>". You can overwrite arguments
+# on invocation: "bin/kamal logs -r job".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# Persist SQLite databases and uploaded files across deployments.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Configure the image builder. Use arm64 if your server (or the machine you
+# build on) is ARM-based.
+builder:
+  arch: amd64
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..075f8b5 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,35 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Self-hosted deployments configure outgoing mail and the public hostname via
+  # environment variables set in config/deploy.yml. The hosted fizzy-saas engine
+  # supplies its own values, so only apply these when they are present.
+  #
+  #   APP_FQDN                    public hostname (used to build links in emails)
+  #   SMTP_ADDRESS                mail server host
+  #   SMTP_PORT                   mail server port (default: 587)
+  #   SMTP_USERNAME               mail server username
+  #   SMTP_PASSWORD               mail server password
+  #   SMTP_AUTHENTICATION         authentication method (default: plain)
+  #   SMTP_ENABLE_STARTTLS_AUTO   use STARTTLS (default: true)
+  if (app_fqdn = ENV["APP_FQDN"].presence)
+    config.action_mailer.default_url_options = { host: app_fqdn, protocol: "https" }
+    config.action_controller.default_url_options = { host: app_fqdn, protocol: "https" }
+  end
+
+  if (smtp_address = ENV["SMTP_ADDRESS"].presence)
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: Integer(ENV["SMTP_PORT"].presence || 587),
+      domain: ENV["SMTP_DOMAIN"].presence || app_fqdn,
+      user_name: ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }.compact
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..966cb88
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,71 @@
+## Deploying Fizzy to a single server
+
+Fizzy ships with a [Kamal](https://kamal-deploy.org) configuration for deploying
+everything to one Linux box: the Rails app, [Thruster](https://github.com/basecamp/thruster)/Puma,
+Solid Queue background jobs, SQLite, and local file storage all run in a single
+container. [kamal-proxy](https://github.com/basecamp/kamal-proxy) runs alongside
+it and terminates TLS with an automatic Let's Encrypt certificate.
+
+### Prerequisites
+
+- One Linux server with Docker and SSH access (Kamal can install Docker for you).
+- A hostname whose DNS `A`/`AAAA` record points at that server, with ports `80`
+  and `443` reachable, so the proxy can obtain a certificate.
+- Docker on the machine you deploy from (used to build the image).
+- An SMTP server for outgoing email.
+
+### Configure
+
+Edit [`config/deploy.yml`](../config/deploy.yml):
+
+1. Set `servers.web` to your server's IP address or hostname.
+2. Set `proxy.host` and `env.clear.APP_FQDN` to your public hostname.
+3. Fill in the `env.clear.SMTP_*` and `MAILER_FROM_ADDRESS` values with your
+   mail server details.
+
+Then provide your secrets (see [`.kamal/secrets`](../.kamal/secrets)). Generate
+a secret key base once and keep it stable, so sessions survive redeploys:
+
+```sh
+bin/rails secret
+```
+
+Kamal reads `.kamal/secrets` as a dotenv file, so the simplest approach is to
+export the secrets in the shell you deploy from:
+
+```sh
+export SECRET_KEY_BASE="<value from bin/rails secret>"
+export SMTP_PASSWORD="<your SMTP password>"
+```
+
+If you would rather edit `.kamal/secrets` directly, replace the `$...`
+references with the literal values -- but keep those out of git.
+
+### Deploy
+
+```sh
+bin/kamal setup
+```
+
+The first run prepares the server (installing Docker if needed), builds the
+image, pushes it to a local registry on the server, starts the container, and
+creates the SQLite databases. When it finishes, Fizzy is available at
+`https://your-hostname`.
+
+Deploy later changes with:
+
+```sh
+bin/kamal deploy
+```
+
+SQLite databases and uploaded files are stored on the `fizzy_storage` volume, so
+they persist across deploys.
+
+### Common commands
+
+```sh
+bin/kamal console   # Rails console in the running container
+bin/kamal shell     # bash in the running container
+bin/kamal logs      # follow application logs
+bin/kamal app exec --reuse "bin/rails dbconsole"
+```
