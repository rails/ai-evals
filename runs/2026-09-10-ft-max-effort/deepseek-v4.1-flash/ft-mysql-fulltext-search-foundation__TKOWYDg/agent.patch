@@ -0,0 +1,17 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split
+    @cards = matching_cards
+  end
+
+  private
+    def matching_cards
+      if @query.present?
+        Current.user.accessible_cards.published.search(@query).reverse_chronologically
+          .preload(:board, :rich_text_description, comments: :rich_text_body)
+      else
+        Card.none
+      end
+    end
+end
