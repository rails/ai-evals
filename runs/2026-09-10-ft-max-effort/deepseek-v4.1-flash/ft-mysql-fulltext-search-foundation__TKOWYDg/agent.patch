@@ -0,0 +1,16 @@
+module SearchesHelper
+  def search_highlight(text, terms)
+    highlight(text, terms) if text.present?
+  end
+
+  def search_matching_bodies(card, terms)
+    [ card.description&.to_plain_text, *card.comments.map { |comment| comment.body&.to_plain_text } ]
+      .compact_blank
+      .select { |body| matches_any?(body, terms) }
+  end
+
+  private
+    def matches_any?(text, terms)
+      terms.any? { |term| text.downcase.include?(term.downcase) }
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..91e78e7 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,18 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :search, ->(query) do
+    query.to_s.split.reduce(all) { |cards, term| cards.matching(term) }
+  end
+
+  scope :matching, ->(term) do
+    pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+
+    where("cards.title LIKE :pattern", pattern: pattern)
+      .or(where(id: Card.joins(:rich_text_description).where("action_text_rich_texts.body LIKE :pattern", pattern: pattern).select(:id)))
+      .or(where(id: Comment.joins(:rich_text_body).where("action_text_rich_texts.body LIKE :pattern", pattern: pattern).select(:card_id)))
+  end
+
   def card
     self
   end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..ea7f39a
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,50 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel panel--wide borderless center margin pad txt-align-start">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half margin-block-end", data: { turbo_frame: "_top" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards", autofocus: true,
+          autocomplete: "off", autocorrect: "off", class: "input" %>
+    <%= form.button type: :submit, class: "btn" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <p class="txt-small translucent" role="status"><%= pluralize @cards.size, "result" %></p>
+
+      <ul class="search-results flex flex-column gap" style="list-style: none; padding: 0;">
+        <% @cards.each do |card| %>
+          <li class="search-result pad border-radius border" style="border-color: var(--color-ink-lighter);">
+            <h2 class="search-result__title txt-medium margin-none">
+              <%= link_to search_highlight(card.title, @terms), card_path(card), class: "txt-ink" %>
+            </h2>
+
+            <p class="search-result__meta txt-x-small translucent margin-none-block-start">
+              <%= card.board.name %>
+            </p>
+
+            <% matching_bodies = search_matching_bodies(card, @terms) %>
+            <% if matching_bodies.any? %>
+              <ul class="search-result__excerpts txt-small margin-block-start" style="list-style: none; padding: 0;">
+                <% matching_bodies.each do |body| %>
+                  <li><%= search_highlight(body, @terms) %></li>
+                <% end %>
+              </ul>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% end %>
+</section>
