@@ -0,0 +1,89 @@
+require "test_helper"
+
+class SearchesPageTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+  end
+
+  test "renders a search form bound to the q parameter" do
+    get search_path(q: "logo")
+
+    assert_select "form[action=?][method=?]", search_path, "get" do
+      assert_select "input[name=q][value=?]", "logo"
+    end
+  end
+
+  test "finds cards by title and highlights matches" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select ".search-result__title mark", text: "logo"
+    assert_select ".search-result__title", /The logo isn/
+  end
+
+  test "finds cards by description and highlights matches" do
+    cards(:layout).update!(description: "A giraffe walks by the window")
+
+    get search_path(q: "giraffe")
+    assert_response :success
+
+    assert_select ".search-result__excerpts mark", text: "giraffe"
+    assert_select ".search-result__excerpts", /A giraffe walks by the window/
+  end
+
+  test "finds cards by comment body and highlights matches" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select ".search-result__excerpts mark", text: "overflowing"
+    assert_select ".search-result__excerpts", /The text is overflowing the container\./
+  end
+
+  test "requires every term to match" do
+    cards(:logo).comments.create!(creator: users(:kevin), body: "A special llama appears here")
+
+    get search_path(q: "logo llama")
+    assert_select ".search-result__title", /logo/
+
+    get search_path(q: "logo zebra")
+    assert_select ".search-result", count: 0
+  end
+
+  test "orders results newest first" do
+    with_current_user :kevin do
+      board = boards(:writebook)
+      board.cards.create!(creator: users(:kevin), title: "Searchable old", status: :published, created_at: 3.days.ago, last_active_at: 3.days.ago)
+      board.cards.create!(creator: users(:kevin), title: "Searchable new", status: :published, created_at: 1.day.ago, last_active_at: 1.day.ago)
+    end
+
+    get search_path(q: "searchable")
+    assert_response :success
+
+    titles = css_select(".search-result__title").map { |title| title.text.strip }
+    assert_equal [ "Searchable new", "Searchable old" ], titles
+  end
+
+  test "only returns cards from boards the user has access to" do
+    get search_path(q: "logo")
+    assert_select ".search-result__title", /logo/
+
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "logo")
+    assert_select ".search-result", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "never returns draft cards" do
+    cards(:unfinished_thoughts).update!(title: "Searchable unfinished draft")
+
+    get search_path(q: "searchable")
+    assert_select ".search-result", count: 0
+  end
+end
