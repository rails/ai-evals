@@ -0,0 +1,27 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p class="margin-none">We sent a six-character code to your email address. Enter it below to continue.</p>
+
+  <%= form_with url: create_session_magic_link_path, method: :post, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", inputmode: "text", maxlength: 6, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small"><%= link_to "Use a different email address", new_session_path, class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
