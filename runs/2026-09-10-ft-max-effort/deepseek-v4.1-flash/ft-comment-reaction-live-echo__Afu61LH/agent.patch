diff --git a/app/views/cards/reactions/_form.html.erb b/app/views/cards/reactions/_form.html.erb
new file mode 100644
index 0000000..8a50da3
--- /dev/null
+++ b/app/views/cards/reactions/_form.html.erb
@@ -0,0 +1,45 @@
+<%= form_with model: Reaction.new, url: reactions_path_for(reactable), class: "reaction__form flex-inline align-center gap-half",
+      html: { hidden: true }, data: { reactions_target: "form", action: "keydown.esc->reactions#close" } do |form| %>
+  <label class="reaction__form-label reaction__avatar flex-item-no-shrink" for="<%= form.field_id(:content) %>"
+         tabindex="-1">
+    <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+  </label>
+
+  <%= form.text_field :content, class: "input reaction__input", placeholder: "React…", required: true,
+        maxlength: 16, autocomplete: "off", data: { reactions_target: "input" } %>
+
+  <div class="reaction__menu">
+    <details class="popup reaction__popup popup--align-left" style="inset-inline: auto 0">
+      <summary class="btn reaction__menu-btn">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Choose an emoji</span>
+      </summary>
+
+      <div class="reaction__emoji-list">
+        <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+          <button type="button" class="btn" title="<%= name %>"
+                  data-action="click->reactions#pick" data-reactions-content-param="<%= emoji %>">
+            <%= emoji %>
+          </button>
+        <% end %>
+      </div>
+    </details>
+  </div>
+
+  <%= form.button type: "submit", class: "reaction__submit-btn btn", title: "Add reaction" do %>
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Add reaction</span>
+  <% end %>
+
+  <%= button_tag type: "button", class: "reaction__cancel-btn btn", title: "Cancel",
+        data: { action: "click->reactions#close" } do %>
+    <%= icon_tag "close" %>
+    <span class="for-screen-reader">Cancel</span>
+  <% end %>
+<% end %>
+
+<button type="button" class="reactions__trigger btn" data-reactions-target="trigger"
+        data-action="click->reactions#open">
+  <%= image_tag "boost-color.svg", alt: "" %>
+  <span class="for-screen-reader">Add a reaction</span>
+</button>
