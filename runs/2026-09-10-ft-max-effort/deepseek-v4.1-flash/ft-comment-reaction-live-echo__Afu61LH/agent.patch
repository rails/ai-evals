diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..688becd
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,22 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    case reactable
+    when Comment then card_comment_reactions_path(reactable.card, reactable)
+    when Card then card_reactions_path(reactable)
+    end
+  end
+
+  def reaction_path_for(reactable, reaction)
+    case reactable
+    when Comment then card_comment_reaction_path(reactable.card, reactable, reaction)
+    when Card then card_reaction_path(reactable, reaction)
+    end
+  end
+
+  def reaction_url_for(reaction)
+    case reaction.reactable
+    when Comment then card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction)
+    when Card then card_reaction_url(reaction.reactable, reaction)
+    end
+  end
+end
