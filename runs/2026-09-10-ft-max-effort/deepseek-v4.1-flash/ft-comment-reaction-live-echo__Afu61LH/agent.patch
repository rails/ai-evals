+<% reactable = reaction.reactable %>
+<% mine = reaction.reacter == Current.user %>
+<div id="<%= dom_id(reaction) %>"
+     class="<%= class_names("reaction", "reaction--deleteable": mine) %>"
+     data-controller="reaction"
+     data-action="click->reaction#toggleDelete">
+  <span class="reaction__avatar flex-item-no-shrink">
+    <%= avatar_tag reaction.reacter, hidden_for_screen_reader: true, tabindex: -1 %>
+  </span>
+
+  <span class="txt-small txt-medium overflow-ellipsis"><%= reaction.content %></span>
+
+  <% if mine %>
+    <%= button_to reaction_path_for(reactable, reaction), method: :delete,
+          class: "reaction__delete btn btn--circle borderless translucent" do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Remove reaction</span>
+    <% end %>
+  <% end %>
+</div>
