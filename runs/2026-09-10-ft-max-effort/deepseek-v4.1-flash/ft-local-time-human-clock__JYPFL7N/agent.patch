diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..5969ee7
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,21 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.element.addEventListener("turbo:morph-element", this.render)
+    this.render()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.render)
+  }
+
+  render = (event) => {
+    if (event && event.target !== this.element) return
+
+    this.element.textContent = formatLocalTime(this.element.getAttribute("datetime"), this.formatValue)
+  }
+}
diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..a5b1551
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,73 @@
+const LOCALE = "en-US"
+const MS_PER_DAY = 86_400_000
+
+const absoluteFormats = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  date_with_year: { month: "short", day: "numeric", year: "numeric" },
+  long_date: { weekday: "long", month: "long", day: "numeric" },
+  datetime: { year: "numeric", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" },
+  numeric_datetime: { year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit" },
+}
+
+const formatters = new Map()
+
+export function formatLocalTime(value, format = "relative") {
+  const date = parseTimestamp(value)
+
+  if (!date) return value
+  if (format === "relative") return formatRelativeTime(date)
+
+  return formatAbsoluteTime(date, format)
+}
+
+export function formatRelativeTime(date, now = new Date()) {
+  const days = calendarDaysBetween(now, date)
+
+  if (days === 0) return formatAbsoluteTime(date, "time")
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days < -1 && days >= -6) return `${-days} days ago`
+  if (days > 1 && days <= 6) return `in ${days} days`
+
+  return formatAbsoluteTime(date, "date")
+}
+
+function parseTimestamp(value) {
+  if (!value) return null
+
+  // A date without a time (like a timeline day) refers to that calendar day in
+  // the viewer's timezone, not to UTC midnight.
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+  if (dateOnly) {
+    const [, year, month, day] = dateOnly
+    return new Date(Number(year), Number(month) - 1, Number(day))
+  }
+
+  const date = new Date(value)
+  return isNaN(date) ? null : date
+}
+
+function formatAbsoluteTime(date, format) {
+  const options = absoluteFormats[format] || absoluteFormats.date
+  return formatterFor(options).format(date)
+}
+
+function formatterFor(options) {
+  const key = JSON.stringify(options)
+
+  if (!formatters.has(key)) {
+    formatters.set(key, new Intl.DateTimeFormat(LOCALE, options))
+  }
+
+  return formatters.get(key)
+}
+
+function calendarDaysBetween(from, to) {
+  return Math.round((startOfDay(to) - startOfDay(from)) / MS_PER_DAY)
+}
+
+function startOfDay(date) {
+  // No explicit timezone: day boundaries follow the viewer's own clock.
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
