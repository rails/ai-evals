@@ -0,0 +1,24 @@
+require "application_system_test_case"
+
+class LocalTimeTimezoneTest < ApplicationSystemTestCase
+  teardown do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  rescue Selenium::WebDriver::Error::WebDriverError
+    # The browser may already be gone; nothing to reset.
+  end
+
+  test "renders times in the browser's timezone" do
+    sign_in_as(users(:david))
+
+    card = cards(:layout)
+    at_nine_utc = Time.current.change(hour: 9, min: 0, sec: 0)
