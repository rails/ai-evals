diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..6396f5d 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,33 @@
 module TimeHelper
+  # Renders a <time> element whose visible text is filled in by the browser,
+  # using the viewer's own timezone. The server only sends the raw timestamp,
+  # so the markup can be cached and shared between viewers in any timezone.
+  #
+  # Formats:
+  #
+  #   :relative        "1:42 PM", "yesterday", "5 days ago", "Sep 12",
+  #                    "tomorrow" or "in 3 days"
+  #   :time            "1:42 PM"
+  #   :date            "Sep 12"
+  #   :date_with_year  "Sep 12, 2025"
+  #   :long_date       "Monday, September 12"
+  #   :datetime        "Sep 12, 2025, 1:42 PM"
+  #   :numeric_datetime "9/12/25, 1:42 PM"
+  def local_time(time, format: :relative, **options)
+    options[:class] = token_list("local-time-value", options[:class])
+    options[:datetime] = local_time_value(time)
+    options[:data] = { controller: "local-time", local_time_format_value: format }.merge(options[:data] || {})
+
+    content_tag :time, "", **options
+  end
+  alias_method :local_time_tag, :local_time
+
+  private
+    def local_time_value(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        time.iso8601
+      end
+    end
 end
