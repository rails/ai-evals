diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..9c77317
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "renders a time element carrying the raw timestamp only" do
+    time = Time.utc(2025, 9, 12, 13, 42, 0)
+
+    node = parse(local_time(time)).at_css("time")
+
+    assert_equal "2025-09-12T13:42:00Z", node["datetime"]
+    assert_includes node["class"], "local-time-value"
+    assert_equal "local-time", node["data-controller"]
+    assert_equal "relative", node["data-local-time-format-value"]
+    assert_equal "", node.text
+  end
+
+  test "renders the requested format" do
+    node = parse(local_time(Time.utc(2025, 9, 12, 13, 42, 0), format: :date)).at_css("time")
+
+    assert_equal "date", node["data-local-time-format-value"]
+  end
+
+  test "keeps extra classes and options" do
+    node = parse(local_time(Time.utc(2025, 9, 12, 13, 42, 0), class: "custom", title: "hello")).at_css("time")
+
+    assert_includes node["class"], "local-time-value"
+    assert_includes node["class"], "custom"
+    assert_equal "hello", node["title"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..c48e50c
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,58 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "card times are rendered in the browser from the raw timestamp" do
+    sign_in_as(users(:david))
+
+    card = cards(:layout)
+    today_at_1_42 = Time.current.change(hour: 13, min: 42, sec: 0)
+    card.update!(created_at: today_at_1_42, last_active_at: today_at_1_42)
+
+    visit card_url(card)
+
+    added = find(".card__meta-text--added time.local-time-value")
+    assert_equal card.created_at.utc.iso8601, added["datetime"]
+    assert_equal "1:42 PM", added.text
+
+    updated = find(".card__meta-text--updated time.local-time-value")
+    assert_equal "1:42 PM", updated.text
+  end
+
+  test "comment times are rendered relative in the browser" do
+    sign_in_as(users(:david))
+
+    recent = comments(:logo_agreement_kevin)
+    recent.update!(created_at: Time.current.change(hour: 13, min: 42, sec: 0))
+
+    older = comments(:logo_agreement_jz)
+    older.update!(created_at: 2.days.ago.change(hour: 13, min: 0, sec: 0))
+
+    visit card_url(cards(:logo))
+
+    within "##{dom_id(recent)}" do
+      time = find("a.comment__permalink-title time.local-time-value")
+      assert_equal "relative", time["data-local-time-format-value"]
+      assert_equal "1:42 PM", time.text
+    end
+
+    within "##{dom_id(older)}" do
+      assert_match(/2 days ago/i, find("a.comment__permalink-title time.local-time-value").text)
+    end
+  end
+
+  test "activity timestamps are rendered in the browser from the raw timestamp" do
+    sign_in_as(users(:kevin))
+
+    visit events_path
+
+    timestamp = find(".event__timestamp time.local-time-value")
+    assert_equal "time", timestamp["data-local-time-format-value"]
+    assert_match(/\A\d{1,2}:\d{2} (AM|PM)\z/, timestamp.text)
+
+    header = find(".events__column-header time.local-time-value", match: :first)
+    assert_equal "long_date", header["data-local-time-format-value"]
+    assert_match(/\A[A-Z]+, [A-Z]+ \d{1,2}\z/, header.text)
+  end
+end
