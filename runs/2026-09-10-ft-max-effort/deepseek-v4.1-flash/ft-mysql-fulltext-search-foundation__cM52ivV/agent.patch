@@ -0,0 +1,27 @@
+require "test_helper"
+
+class CardsSearchTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+  end
+
+  test "cards index with a term highlights matching cards" do
+    cards(:layout).comments.create!(body: "I hate haggis")
+    cards(:logo).comments.create!(body: "I love haggis")
+
+    get cards_path(term: "haggis")
+
+    assert_response :success
+    assert_select "article.card", count: 2
+    assert_select "mark", text: "haggis", count: 2
+  end
+
+  test "cards index with a term only shows matching cards" do
+    get cards_path(term: "logo")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "mark", text: "logo"
+  end
+end
diff --git a/test/controllers/search_page_test.rb b/test/controllers/search_page_test.rb
new file mode 100644
index 0000000..08337fd
--- /dev/null
+++ b/test/controllers/search_page_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class SearchPageTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "show succeeds with and without a query" do
+    get search_path
+    assert_response :success
+
+    get search_path(q: "logo")
+    assert_response :success
+  end
+
+  test "finds cards by title, description and comment body" do
+    cards(:buy_domain).update!(description: "Renew the registration")
+
+    get search_path(q: "registration")
+    assert_select "article.card", count: 1
+    assert_select "mark", text: "registration"
+
+    get search_path(q: "overflowing")
+    assert_select "article.card", count: 1
+
+    get search_path(q: "logo")
+    assert_select "article.card", count: 1
+  end
+
+  test "wraps matched words in mark" do
+    get search_path(q: "logo")
+    assert_select "mark", text: "logo"
+
+    get search_path(q: "overflowing")
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "orders results newest first" do
+    board = boards(:writebook)
+    older = board.cards.create!(creator: users(:kevin), status: "published", title: "Zebra older", created_at: 2.days.ago)
+    newer = board.cards.create!(creator: users(:kevin), status: "published", title: "Zebra newer", created_at: 1.hour.ago)
+
+    get search_path(q: "zebra")
+
+    assert_equal [ newer.title, older.title ], css_select("article.card h3").map { |el| el.text.strip }
+  end
+
+  test "never shows draft cards or their comments" do
+    boards(:writebook).cards.create!(creator: users(:kevin), status: "drafted", title: "Draft about haggis")
+
+    card = boards(:writebook).cards.create!(creator: users(:kevin), status: "published", title: "Secret plan")
+    card.comments.create!(creator: users(:kevin), body: "The haggis is hidden here")
+    card.update_column(:status, "drafted")
+
+    get search_path(q: "haggis")
+    assert_select "article.card", count: 0
+  end
+
+  test "only shows cards from accessible boards and accounts" do
+    get search_path(q: "radio")
+    assert_select "article.card", count: 0
+
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "logo")
+    assert_select "article.card", count: 0
+  end
+end
diff --git a/test/models/card_content_search_test.rb b/test/models/card_content_search_test.rb
