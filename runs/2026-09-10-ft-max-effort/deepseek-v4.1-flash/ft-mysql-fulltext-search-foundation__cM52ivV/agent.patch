+++ b/test/models/card_content_search_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class CardSearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "search matches card titles" do
+    assert_includes Card.search("logo"), cards(:logo)
+    assert_not_includes Card.search("logo"), cards(:layout)
+  end
+
+  test "search matches rich text descriptions" do
+    cards(:buy_domain).update!(description: "Renew the haggis domain")
+
+    assert_includes Card.search("haggis"), cards(:buy_domain)
+  end
+
+  test "search matches comment bodies" do
+    cards(:layout).comments.create!(body: "I hate haggis")
+    cards(:logo).comments.create!(body: "I love haggis")
+
+    assert_equal [ cards(:layout).id, cards(:logo).id ].sort, Card.search("haggis").pluck(:id).sort
+  end
+
+  test "search returns each card once even with several matching comments" do
+    cards(:logo).comments.create!(body: "haggis one")
+    cards(:logo).comments.create!(body: "haggis two")
+
+    assert_equal [ cards(:logo).id ], Card.search("haggis").pluck(:id)
+  end
+end
diff --git a/test/models/search_presenter_test.rb b/test/models/search_presenter_test.rb
new file mode 100644
index 0000000..2ca64bf
--- /dev/null
+++ b/test/models/search_presenter_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "results are scoped to accessible published cards, newest first" do
+    board = boards(:writebook)
+    older = board.cards.create!(creator: users(:david), status: "published", title: "Haggis older", created_at: 2.days.ago)
+    newer = board.cards.create!(creator: users(:david), status: "published", title: "Haggis newer", created_at: 1.hour.ago)
+
+    results = Search.new("haggis", user: users(:david)).results
+
+    assert_equal [ newer, older ], results.map(&:card)
+  end
+
+  test "draft cards and their comments are never returned" do
+    card = boards(:writebook).cards.create!(creator: users(:david), status: "published", title: "Secret")
+    card.comments.create!(creator: users(:david), body: "haggis secrets")
+    card.update_column(:status, "drafted")
+
+    search = Search.new("haggis", user: users(:david))
+    assert_empty search.results
+  end
+
+  test "results from inaccessible boards are hidden" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:david)
+
+    assert_empty Search.new("logo", user: users(:david)).results
+  end
+
+  test "excerpt points at the matching comment body" do
+    cards(:layout).comments.create!(body: "The haggis is overflowing")
+
+    result = Search.new("haggis", user: users(:david)).results.find { |r| r.card == cards(:layout) }
+    assert_includes result.excerpt, "haggis"
+  end
+end
