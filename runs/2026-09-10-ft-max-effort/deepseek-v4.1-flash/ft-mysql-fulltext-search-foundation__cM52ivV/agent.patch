--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,35 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Matches cards whose title, description, or any comment body contains the
+    # given term. The explicit joins let a single query look through both the
+    # card's rich text description and every comment's rich text body, while
+    # `distinct` collapses the rows produced by the has-many joins.
+    scope :search, ->(query) do
+      if query.present?
+        term = "%#{ActiveRecord::Base.sanitize_sql_like(query.to_s.strip)}%"
+
+        joins(<<~SQL.squish)
+          LEFT JOIN action_text_rich_texts AS card_descriptions
+            ON card_descriptions.record_type = 'Card'
+            AND card_descriptions.record_id = cards.id
+            AND card_descriptions.name = 'description'
+          LEFT JOIN comments AS search_comments
+            ON search_comments.card_id = cards.id
+          LEFT JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = search_comments.id
+            AND comment_bodies.name = 'body'
+        SQL
+          .where(
+            "cards.title LIKE :term OR card_descriptions.body LIKE :term OR comment_bodies.body LIKE :term",
+            term: term
+          )
+          .distinct
+      else
+        all
+      end
+    end
+  end
+end
