@@ -0,0 +1,25 @@
+module SearchesHelper
+  def search_highlighted(text, terms)
+    highlight(text.to_s, terms)
+  end
+
+  # Returns a window of +text+ centered on the first occurrence of +query+, so
+  # the matched words are visible even when the body is long. Returns the
+  # truncated text as-is when the query isn't found.
+  def search_excerpt(text, query, length: 200)
+    return if text.blank?
+
+    text = text.to_s.squish
+    index = query.present? ? text.downcase.index(query.downcase) : nil
+
+    if index
+      start = [ index - length / 3, 0 ].max
+      excerpt = text[start, length].to_s
+      excerpt = "…#{excerpt}" if start.positive?
+      excerpt = "#{excerpt}…" if start + length < text.length
+      excerpt
+    else
+      text.truncate(length)
+    end
+  end
+end
