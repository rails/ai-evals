diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..3791452
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,69 @@
+class Search
+  Result = Struct.new(:card, :excerpt, keyword_init: true)
+
+  attr_reader :query, :user
+
+  def self.result_for(card, query)
+    new(query).result_for(card)
+  end
+
+  def initialize(query, user: Current.user)
+    @query = query.to_s.strip
+    @user = user
+  end
+
+  def terms
+    query.split
+  end
+
+  def results
+    @results ||= cards.map { |card| result_for(card) }
+  end
+
+  def result_for(card)
+    Result.new(card: card, excerpt: excerpt_for(card))
+  end
+
+  def cards
+    @cards ||= cards_relation.to_a
+  end
+
+  private
+    def cards_relation
+      if query.present?
+        user.accessible_cards.published.search(query).includes(:board, :creator).reverse_chronologically
+      else
+        user.accessible_cards.none
+      end
+    end
+
+    def excerpt_for(card)
+      if description_matches?(card)
+        card.description.to_plain_text
+      else
+        matching_comment_for(card)&.body&.to_plain_text
+      end
+    end
+
+    def description_matches?(card)
+      card.description.present? && matches?(card.description.to_plain_text)
+    end
+
+    def matching_comment_for(card)
+      return if query.blank?
+
+      card.comments
+        .joins(:rich_text_body)
+        .where("action_text_rich_texts.body LIKE ?", like_query)
+        .chronologically
+        .first
+    end
+
+    def matches?(text)
+      text.present? && text.downcase.include?(query.downcase)
+    end
+
+    def like_query
+      "%#{ActiveRecord::Base.sanitize_sql_like(query)}%"
+    end
+end
