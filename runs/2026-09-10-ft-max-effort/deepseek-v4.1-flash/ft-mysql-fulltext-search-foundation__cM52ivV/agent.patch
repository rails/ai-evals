+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,23 @@
+<% card = result.card %>
+<% query = local_assigns.fetch(:query) %>
+<% terms = local_assigns.fetch(:terms) %>
+
+<article class="card search-result" id="<%= dom_id(card, :search_result) %>">
+  <div class="card__board search-result__board">
+    <%= link_to card.board.name, card.board, class: "btn btn--plain", data: { turbo_frame: "_top" } %>
+  </div>
+
+  <h3 class="card__title search-result__title">
+    <%= link_to search_highlighted(card.title, terms), card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } %>
+  </h3>
+
+  <% if result.excerpt.present? %>
+    <p class="search-result__excerpt card__excerpt txt-small">
+      <%= search_highlighted(search_excerpt(result.excerpt, query), terms) %>
+    </p>
+  <% end %>
+
+  <footer class="search-result__meta txt-x-small translucent">
+    Added by <%= card.creator.name %> <%= local_datetime_tag(card.created_at, style: :daysago) %>
+  </footer>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..d252fed
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, class: "search__form pad", data: { turbo_frame: "_top" } do |form| %>
+  <%= form.search_field :q,
+        value: @search.query,
+        placeholder: "Search cards…",
+        autofocus: true,
+        autocorrect: "off",
+        autocomplete: "off",
+        class: "input full-width" %>
+<% end %>
+
+<section class="search-results cards cards--grid" aria-label="Search results">
+  <div class="cards__list hide-scrollbar">
+    <% if @search.query.present? %>
+      <% if @search.results.any? %>
+        <%= render partial: "searches/result", collection: @search.results, as: :result, locals: { query: @search.query, terms: @search.terms } %>
+      <% else %>
+        <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+      <% end %>
+    <% else %>
+      <div class="blank-slate">Type to search for cards</div>
+    <% end %>
+  </div>
+</section>
