diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..c9ca1fc
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,75 @@
+# frozen_string_literal: true
+
+# Switches the active locale for each request and remembers the choice:
+#
+#   * `?locale=ja` switches to Japanese for this request and all subsequent
+#     requests in the current session.
+#   * Signed-in people also get their choice saved on their Identity, so it is
+#     restored the next time they sign in, even from a clean browser.
+#   * Unsupported locales (e.g. `?locale=xx`) are ignored without breaking the
+#     request or changing the current choice.
+module Localization
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[en ja].freeze
+  LOCALE_SESSION_KEY = :locale
+
+  included do
+    around_action :switch_locale
+    helper_method :current_locale
+  end
+
+  module ClassMethods
+    def supported_locales
+      SUPPORTED_LOCALES.map(&:to_sym)
+    end
+  end
+
+  private
+    def switch_locale(&action)
+      locale = resolved_locale
+      remember_locale(locale) if requested_locale
+      response.headers["Content-Language"] = locale.to_s
+      I18n.with_locale(locale, &action)
+    end
+
+    # Explicit `?locale=` choice for this request, or nil when absent/unsupported.
+    def requested_locale
+      return @requested_locale if defined?(@requested_locale)
+
+      candidate = params[:locale].to_s.strip.downcase
+      @requested_locale = candidate if self.class.supported_locales.include?(candidate.to_sym)
+      @requested_locale
+    end
+
+    def current_locale
+      I18n.locale
+    end
+
+    def resolved_locale
+      locale = requested_locale ||
+        (Current.identity&.locale if Current.identity.respond_to?(:locale)) ||
+        session[LOCALE_SESSION_KEY]
+
+      self.class.supported_locales.include?(locale&.to_s&.downcase&.to_sym) ? locale.to_s.downcase.to_sym : I18n.default_locale
+    end
+
+    def remember_locale(locale)
+      session[LOCALE_SESSION_KEY] = locale.to_s
+
+      if Current.identity.present? && Current.identity.locale != locale.to_s
+        Current.identity.update(locale: locale.to_s)
+      end
+    end
+
+    # Called right after a successful sign in so a locale chosen before signing
+    # in is carried over to the Identity, and a stored Identity locale wins for
+    # people who never picked one in this browser.
+    def sync_locale_with_identity(identity)
+      if (chosen = session[LOCALE_SESSION_KEY]).present? && self.class.supported_locales.include?(chosen.to_sym)
+        identity.update(locale: chosen.to_s) if identity.locale != chosen.to_s
+      elsif identity.locale.present?
+        session[LOCALE_SESSION_KEY] = identity.locale
+      end
+    end
+end
