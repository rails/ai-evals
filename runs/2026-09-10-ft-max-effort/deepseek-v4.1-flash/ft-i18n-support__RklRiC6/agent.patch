+
+  test "choice is remembered next sign in from a clean browser" do
+    sign_in_as :kevin
+
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    reset! # simulate a clean browser: no cookies, no session
+
+    sign_in_as :kevin
+    get root_path
+
+    assert_response :success
+    assert_match JAPANESE, response.body
+  end
+
+  test "invalid locale keeps previous choice" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_match JAPANESE, response.body
+  end
+
+  test "invalid locale does not raise for anonymous visitors" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_no_match JAPANESE, response.body
+    end
+  end
+end
+
+class LocalizationAnonymousPersistenceTest < ActionDispatch::IntegrationTest
+  JAPANESE = /[\u3040-\u30ff\u4e00-\u9fff]/
+
+  test "anonymous public page locale sticks for the session" do
+    sign_in_as :kevin
+    boards(:writebook).publish
+    key = boards(:writebook).publication.key
+    sign_out
+
+    get public_board_path(key, locale: "ja")
+    assert_response :success
+    assert_match JAPANESE, response.body
+
+    get public_board_path(key)
+    assert_response :success
+    assert_match JAPANESE, response.body
+  end
+end
