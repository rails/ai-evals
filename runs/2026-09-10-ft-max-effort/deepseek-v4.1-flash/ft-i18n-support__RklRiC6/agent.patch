         super
       end
     end
+
+    # Renders the mail in the recipient's chosen language (falling back to the
+    # default locale). Wrap the whole mail body, including the subject, so every
+    # part of the email is localized.
+    def with_locale_of(record)
+      I18n.with_locale(locale_for(record)) { yield }
+    end
+
+    def locale_for(record)
+      locale =
+        if record.respond_to?(:locale)
+          record.locale
+        elsif record.respond_to?(:identity)
+          record.identity&.locale
+        end
+
+      locale = locale.to_s
+      I18n.available_locales.map(&:to_s).include?(locale) ? locale.to_sym : I18n.default_locale
+    end
 end
