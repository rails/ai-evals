+      assert_includes response.body, "Fizzyをはじめる"
+      assert_not_includes response.body, "Get into Fizzy"
+    end
+  end
+
+  test "default english sign in page unchanged" do
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_includes response.body, "Get into Fizzy"
+      assert_not_includes response.body, "Fizzyをはじめる"
+    end
+  end
+
+  test "invalid locale does not switch" do
