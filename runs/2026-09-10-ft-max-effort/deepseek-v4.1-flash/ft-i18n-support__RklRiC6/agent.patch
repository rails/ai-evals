diff --git a/test/integration/localization_emails_test.rb b/test/integration/localization_emails_test.rb
new file mode 100644
index 0000000..bde84f4
--- /dev/null
+++ b/test/integration/localization_emails_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class LocalizationEmailsTest < ActionMailer::TestCase
+  JAPANESE = /[\u3040-\u30ff\u4e00-\u9fff]/
+
+  def decoded_body(email)
+    [ email.text_part, email.html_part ].compact.map { |p| p.body.decoded }.join("\n")
+  end
+
+  test "magic link email is japanese for japanese identity" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_match JAPANESE, email.subject
+    assert_match JAPANESE, decoded_body(email)
+  end
+
+  test "magic link email stays english by default" do
+    identity = identities(:kevin)
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is #{ magic_link.code }", email.subject
+    assert_no_match JAPANESE, decoded_body(email)
+  end
+
+  test "account cancellation email is japanese for japanese user" do
+    account = accounts(:"37s")
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    account.cancel(initiated_by: user)
+
+    email = AccountMailer.cancellation(account.cancellation)
+
+    assert_match JAPANESE, email.subject
+    assert_match JAPANESE, decoded_body(email)
+    assert_equal :en, I18n.locale
+  end
+
+  test "static error pages are bilingual" do
+    %w[400.html 404.html 422.html 500.html 406-unsupported-browser.html].each do |page|
+      body = File.read(Rails.root.join("public", page))
+      assert_match JAPANESE, body, "#{page} should contain Japanese"
+      assert_match(/(error|request|browser|exist)/i, body, "#{page} should contain English")
+    end
+  end
+end
diff --git a/test/integration/localization_head_test.rb b/test/integration/localization_head_test.rb
new file mode 100644
index 0000000..df61106
--- /dev/null
+++ b/test/integration/localization_head_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class LocalizationHeadTest < ActionDispatch::IntegrationTest
+  test "head exposes locale and localized time messages" do
+    sign_in_as :kevin
+
+    get root_path, params: { locale: "ja" }
+    assert_response :success
+
+    locale_meta = response.body[/<meta name="app-locale" content="([^"]*)"/, 1]
+    assert_equal "ja", locale_meta
+
+    messages_meta = response.body[/<meta name="app-time-messages" content="([^"]*)"/, 1]
+    assert messages_meta.present?
+    json = JSON.parse(CGI.unescapeHTML(messages_meta))
+    assert_equal "今日", json["today"]
+    assert_equal "%{count}日前", json["day_other"]
+  end
+end
