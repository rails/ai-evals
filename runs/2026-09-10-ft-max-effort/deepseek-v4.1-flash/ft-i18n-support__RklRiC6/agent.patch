+require "test_helper"
+
+class LocalizationMoreEmailsTest < ActionMailer::TestCase
+  JAPANESE = /[\u3040-\u30ff\u4e00-\u9fff]/
+
+  test "export email is japanese for japanese user" do
+    export = Account::Export.create!(account: Current.account, user: users(:david))
+    users(:david).identity.update!(locale: "ja")
+
+    email = ExportMailer.completed(export)
+
+    assert_match JAPANESE, email.subject
+    assert_match JAPANESE, email.html_part.body.decoded
+  end
+
+  test "import failure email is japanese for japanese identity" do
+    import = Account::Import.create!(account: Current.account, identity: identities(:david), status: :failed)
+    identities(:david).update!(locale: "ja")
+
+    email = ImportMailer.failed(import)
+
+    assert_match JAPANESE, email.subject
+    assert_match JAPANESE, email.text_part.body.decoded
+  end
+
+  test "notification bundle email is japanese for japanese user" do
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_match JAPANESE, email.subject
+    assert_match JAPANESE, email.html_part.body.decoded
+  end
+end
