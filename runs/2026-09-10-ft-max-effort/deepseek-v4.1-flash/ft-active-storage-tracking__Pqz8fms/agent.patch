diff --git a/app/models/concerns/storage_usage_trackable.rb b/app/models/concerns/storage_usage_trackable.rb
new file mode 100644
index 0000000..7099c66
--- /dev/null
+++ b/app/models/concerns/storage_usage_trackable.rb
@@ -0,0 +1,65 @@
+# Included into +ActiveStorage::Attachment+ so that adding or removing an
+# attachment recalculates the cached +bytes_used+ aggregates of the board it
+# belongs to (and of that board's account) in the background.
+module StorageUsageTrackable
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_usage_board
+    after_commit :update_storage_usage_later
+  end
+
+  # +purge+ and +purge_later+ remove the attachment with +delete+, which skips
+  # the destroy/commit callbacks above, so track it explicitly.
+  def delete
+    board = storage_usage_board
+    super
+  ensure
+    enqueue_storage_usage_update(board)
+  end
+
+  private
+    def update_storage_usage_later
+      enqueue_storage_usage_update(storage_usage_board)
+    end
+
+    def enqueue_storage_usage_update(board)
+      if board
+        board.update_bytes_used_later
+
+        if account = board.account
+          account.update_bytes_used_later
+        end
+      end
+    end
+
+    def remember_storage_usage_board
+      storage_usage_board
+    end
+
+    def storage_usage_board
+      @storage_usage_board ||= storage_usage_board_record
+    end
+
+    def storage_usage_board_record
+      case record_type
+      when "Card"
+        record.board if name == "image"
+      when "ActionText::RichText"
+        storage_usage_board_for_rich_text if name == "embeds"
+      end
+    end
+
+    def storage_usage_board_for_rich_text
+      rich_text = record
+      return unless rich_text
+
+      if StorageUsage.countable_rich_text?(rich_text.record_type, rich_text.name)
+        case rich_text.record_type
+        when "Board" then rich_text.record
+        when "Card" then rich_text.record&.board
+        when "Comment" then rich_text.record&.card&.board
+        end
+      end
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..46ce8b2
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,99 @@
+# Computes how many bytes an account or board uses to store the images and
+# rich text embeds that count toward its storage quota.
+#
+# Only two kinds of attachments are counted:
+#
+# * images attached directly to cards (+Card#image+)
+# * files embedded in a board's public description, a card's description, or a
+#   comment's body (stored as +ActionText::RichText+ embeds)
+#
+# Everything is aggregated in the database through subqueries, so the size of
+# the account or board doesn't matter: the attachments themselves are never
+# loaded into memory.
+class StorageUsage
+  COUNTABLE_RICH_TEXTS = {
+    "Board" => "public_description",
+    "Card" => "description",
+    "Comment" => "body"
+  }.freeze
+
+  class << self
+    def bytes_used_by(account)
+      new(account).bytes_used
+    end
+
+    def bytes_used_on(board)
+      new(board.account, board: board).bytes_used
+    end
+
+    def countable_rich_text?(record_type, name)
+      COUNTABLE_RICH_TEXTS[record_type] == name
+    end
+  end
+
+  def initialize(account, board: nil)
+    @account = account
+    @board = board
+  end
+
+  def bytes_used
+    countable_attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+  end
+
+  private
+    attr_reader :account, :board
+
+    def countable_attachments
+      card_images.or(rich_text_embeds)
+    end
+
+    def card_images
+      attachments.where(record_type: "Card", name: "image", record_id: card_ids)
+    end
+
+    def rich_text_embeds
+      attachments.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+    end
+
+    def attachments
+      ActiveStorage::Attachment.where(account_id: account.id)
+    end
+
+    def card_ids
+      if board
+        board.cards.select(:id)
+      else
+        account.cards.select(:id)
+      end
+    end
+
+    def rich_text_ids
+      if board
+        board_rich_text_ids
+      else
+        account_rich_text_ids
+      end
+    end
+
+    def account_rich_text_ids
+      countable_rich_texts.where(account_id: account.id).select(:id)
+    end
+
+    def board_rich_text_ids
+      board_record_ids = Board.where(id: board.id).select(:id)
+      card_record_ids = board.cards.select(:id)
+      comment_record_ids = Comment.where(card_id: card_record_ids).select(:id)
+
+      countable_rich_texts
+        .where(record_id: board_record_ids)
+        .or(countable_rich_texts.where(record_id: card_record_ids))
+        .or(countable_rich_texts.where(record_id: comment_record_ids))
+        .select(:id)
+    end
+
+    def countable_rich_texts
+      ActionText::RichText.where(record_type: "Board", name: COUNTABLE_RICH_TEXTS["Board"])
+        .or(ActionText::RichText.where(record_type: "Card", name: COUNTABLE_RICH_TEXTS["Card"]))
+        .or(ActionText::RichText.where(record_type: "Comment", name: COUNTABLE_RICH_TEXTS["Comment"]))
+    end
+end
