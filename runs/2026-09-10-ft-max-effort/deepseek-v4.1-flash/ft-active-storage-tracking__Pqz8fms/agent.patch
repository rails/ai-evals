diff --git a/test/models/storage_usage_bytes_used_test.rb b/test/models/storage_usage_bytes_used_test.rb
new file mode 100644
index 0000000..60f5102
--- /dev/null
+++ b/test/models/storage_usage_bytes_used_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class StorageUsageBytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "board#bytes_used counts images attached to its cards" do
+    blob = attach_image_to(@card)
+
+    assert_equal blob.byte_size, @board.bytes_used
+  end
+
+  test "board#bytes_used counts embeds in its public description" do
+    blob = embed_in { |html| @board.update!(public_description: html) }
+
+    assert_equal blob.byte_size, @board.bytes_used
+  end
+
+  test "board#bytes_used counts embeds in its cards' descriptions" do
+    blob = embed_in { |html| @card.update!(description: html) }
+
+    assert_equal blob.byte_size, @board.bytes_used
+  end
+
+  test "board#bytes_used counts embeds in comments on its cards" do
+    comment = @card.comments.first
+    blob = embed_in { |html| comment.update!(body: html) }
+
+    assert_equal blob.byte_size, @board.bytes_used
+  end
+
+  test "board#bytes_used does not count another board's attachments" do
+    other_board = boards(:private)
+
+    attach_image_to(@card)
+    embed_in { |html| @card.update!(description: html) }
+
+    assert_equal 0, other_board.bytes_used
+  end
+
+  test "board#bytes_used does not count avatars or account level files" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "account#bytes_used counts everything across its boards" do
+    blobs = [
+      attach_image_to(@card),
+      embed_in { |html| @card.update!(description: html) },
+      embed_in { |html| @board.update!(public_description: html) },
+      embed_in { |html| @card.comments.first.update!(body: html) }
+    ]
+
+    assert_equal blobs.sum(&:byte_size), @account.bytes_used
+  end
+
+  test "account#bytes_used does not count another account's attachments" do
+    other_card = cards(:radio)
+    attach_image_to(other_card)
+
+    assert_equal 0, @account.bytes_used
+    assert_equal other_card.image.blob.byte_size, other_card.board.account.bytes_used
+  end
+
+  test "moving a card moves its usage between boards" do
+    blob = attach_image_to(@card)
+    other_board = boards(:private)
+
+    @card.move_to(other_board)
+
+    assert_equal 0, @board.bytes_used
+    assert_equal blob.byte_size, other_board.bytes_used
+  end
+
+  test "usage is recalculated and persisted by the background job" do
+    blob = attach_image_to(@card)
+
+    perform_enqueued_jobs only: [ Board::UpdateBytesUsedJob, Account::UpdateBytesUsedJob ]
+
+    assert_equal blob.byte_size, @board.reload.read_attribute(:bytes_used)
+    assert_equal blob.byte_size, @account.reload.read_attribute(:bytes_used)
+  end
+
+  test "removing an image updates usage" do
+    blob = attach_image_to(@card)
+    perform_enqueued_jobs only: [ Board::UpdateBytesUsedJob, Account::UpdateBytesUsedJob ]
+    assert_equal blob.byte_size, @board.reload.read_attribute(:bytes_used)
+
+    @card.image.purge_later
+    perform_enqueued_jobs only: [ Board::UpdateBytesUsedJob, Account::UpdateBytesUsedJob ]
+
+    assert_equal 0, @board.reload.read_attribute(:bytes_used)
+    assert_equal 0, @account.reload.read_attribute(:bytes_used)
+  end
+
+  test "account#bytes_used equals the sum of its boards' usage" do
+    other_card = boards(:private).cards.create!(title: "Another card", creator: users(:kevin), status: :published)
+
+    blob = attach_image_to(@card)
+    other_blob = attach_image_to(other_card)
+
+    assert_equal blob.byte_size + other_blob.byte_size, @account.bytes_used
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal other_blob.byte_size, boards(:private).bytes_used
+  end
+
+  test "removing an embed from a description reduces usage" do
+    blob = embed_in { |html| @card.update!(description: html) }
+    assert_equal blob.byte_size, @board.bytes_used
+
+    @card.update!(description: "<p>No more image</p>")
+    perform_enqueued_jobs only: [ Board::UpdateBytesUsedJob, Account::UpdateBytesUsedJob ]
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "board#bytes_used ignores comments on other boards" do
+    other_card = boards(:private).cards.create!(title: "Another card", creator: users(:kevin), status: :published)
+    other_comment = other_card.comments.create!(body: "Hello", creator: users(:kevin))
+    blob = embed_in { |html| other_comment.update!(body: html) }
+
+    assert_equal 0, @board.bytes_used
+    assert_equal blob.byte_size, boards(:private).bytes_used
+  end
+
+test "background job persists usage for rich text embeds" do
+  comment = @card.comments.first
+  blob = embed_in { |html| comment.update!(body: html) }
+
+  perform_enqueued_jobs only: [ Board::UpdateBytesUsedJob, Account::UpdateBytesUsedJob ]
+
+  assert_equal blob.byte_size, @board.reload.read_attribute(:bytes_used)
+  assert_equal blob.byte_size, @account.reload.read_attribute(:bytes_used)
+end
+
+  private
+    def attach_image_to(card)
+      blob = ActiveStorage::Blob.create_and_upload! \
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+
+      card.image.attach(blob)
+      blob
+    end
+
+    def embed_in
+      blob = ActiveStorage::Blob.create_and_upload! \
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+
+      attachment_html = ActionText::Attachment.from_attachable(blob).to_html
+      yield "<p>An image: #{attachment_html}</p>"
+      blob
+    end
+end
