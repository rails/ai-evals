diff --git a/test/controllers/searches_feature_test.rb b/test/controllers/searches_feature_test.rb
new file mode 100644
index 0000000..e81b603
--- /dev/null
+++ b/test/controllers/searches_feature_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class SearchesFeatureTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:kevin)
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+  end
+
+  test "finds cards by title and highlights matches" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select ".card__title", text: /The logo isn't big enough/
+    assert_select "mark", text: "logo"
+  end
+
+  test "finds cards by description and highlights matches" do
+    cards(:logo).update! description: "A bigger logo please"
+
+    get search_path(q: "bigger")
+    assert_response :success
+
+    assert_select ".card__title", text: /The logo isn't big enough/
+    assert_select "mark", text: "bigger"
+  end
+
+  test "finds cards by comment body and highlights matches" do
+    get search_path(q: "agree")
+    assert_response :success
+
+    assert_select ".card__title", text: /The logo isn't big enough/
+    assert_select "mark", text: "agree"
+  end
+
+  test "returns newest first" do
+    boards(:writebook).cards.create! creator: users(:kevin), status: :published, title: "zebra earliest", created_at: 2.days.ago
+    boards(:writebook).cards.create! creator: users(:kevin), status: :published, title: "zebra latest", created_at: 1.hour.ago
+
+    get search_path(q: "zebra")
+    assert_response :success
+
+    assert_operator response.body.index("latest"), :<, response.body.index("earliest")
+  end
+
+  test "does not return draft cards" do
+    boards(:writebook).cards.create! creator: users(:kevin), status: :drafted, title: "zebra draft"
+
+    get search_path(q: "zebra")
+    assert_response :success
+
+    assert_select ".card__title", text: /zebra draft/, count: 0
+  end
+
+  test "does not return cards from other accounts" do
+    get search_path(q: "radio")
+    assert_response :success
+
+    assert_select ".card__title", text: /radio/, count: 0
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    logout_and_sign_in_as :jz
+
+    boards(:private).cards.create! creator: users(:kevin), status: :published, title: "zebra private"
+
+    get search_path(q: "zebra")
+    assert_response :success
+
+    assert_select ".card__title", text: /zebra private/, count: 0
+  end
+end
+
+class SearchesRichTextFeatureTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:kevin)
+    sign_in_as :kevin
+  end
+
+  test "highlights rich text without destroying markup" do
+    cards(:logo).update! description: "<div>Hello <strong>bigger</strong> world</div>"
+
+    get search_path(q: "bigger")
+    assert_response :success
+
+    assert_select ".card__description strong", text: "bigger"
+    assert_select ".card__description mark", text: "bigger"
+  end
+
+  test "highlights matched comments" do
+    get search_path(q: "agree")
+    assert_response :success
+
+    assert_select ".comment__body mark", text: "agree"
+  end
+end
+
+class SearchesEscapingFeatureTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:kevin)
+    sign_in_as :kevin
+  end
+
+  test "escapes plain text titles" do
+    boards(:writebook).cards.create! creator: users(:kevin), status: :published,
+      title: "dangerous <script>alert(1)</script> zebra"
+
+    get search_path(q: "zebra")
+    assert_response :success
+
+    assert_select ".card__title script", count: 0
+    assert_select ".card__title mark", text: "zebra"
+  end
+end
+
+class SearchesWildcardFeatureTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:kevin)
+    sign_in_as :kevin
+  end
+
+  test "treats like wildcards literally" do
+    boards(:writebook).cards.create! creator: users(:kevin), status: :published, title: "Save 100% now"
+    boards(:writebook).cards.create! creator: users(:kevin), status: :published, title: "Save 200 percent now"
+
+    get search_path(q: "100%")
+    assert_response :success
+
+    assert_select ".card__title", text: /Save 100% now/
+    assert_select ".card__title", text: /Save 200 percent now/, count: 0
+  end
+end
+
+class SearchesDraftCommentFeatureTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:kevin)
+    sign_in_as :kevin
+  end
+
+  test "does not return comments that live on draft cards" do
+    card = boards(:writebook).cards.create! creator: users(:kevin), status: :published, title: "Zebra"
+    card.comments.create! creator: users(:kevin), body: "a zebra appeared"
+
+    card.update! status: :drafted
+
+    get search_path(q: "zebra")
+    assert_response :success
+
+    assert_select ".card__title", text: /Zebra/, count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "does not return matching comments on boards the user cannot access" do
+    logout_and_sign_in_as :jz
+
+    boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Hidden").tap do |card|
+      card.comments.create! creator: users(:kevin), body: "a zebra appeared"
+    end
+
+    get search_path(q: "zebra")
+    assert_response :success
+
+    assert_select "mark", count: 0
+  end
+end
