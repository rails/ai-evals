+module SearchesHelper
+  def highlight_search(content, query)
+    return content if query.blank? || content.blank?
+
+    if content.is_a?(ActionText::Content)
+      highlight(content.to_s, query, sanitize: false)
+    else
+      highlight(content.to_s, query)
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..d675a7d
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,61 @@
+class Search
+  LIKE_ESCAPE = "!".freeze
+
+  attr_reader :user, :query
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def cards
+    @cards ||= if query.present?
+      user.accessible_cards
+        .published
+        .where(matching_cards, pattern: pattern)
+        .reverse_chronologically
+        .preloaded
+        .includes(comments: [ :creator, :rich_text_body ])
+    else
+      Card.none
+    end
+  end
+
+  def matches?(content)
+    content.present? && text_for(content).downcase.include?(query.downcase)
+  end
+
+  private
+    def matching_cards
+      <<~SQL.squish
+        cards.title LIKE :pattern ESCAPE '#{LIKE_ESCAPE}'
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Card'
+            AND action_text_rich_texts.record_id = cards.id
+            AND action_text_rich_texts.name = 'description'
+            AND action_text_rich_texts.body LIKE :pattern ESCAPE '#{LIKE_ESCAPE}'
+        )
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts AS comment_bodies
+          INNER JOIN comments AS matching_comments ON matching_comments.id = comment_bodies.record_id
+          WHERE comment_bodies.record_type = 'Comment'
+            AND comment_bodies.name = 'body'
+            AND matching_comments.card_id = cards.id
+            AND comment_bodies.body LIKE :pattern ESCAPE '#{LIKE_ESCAPE}'
+        )
+      SQL
+    end
+
+    def pattern
+      @pattern ||= "%#{ActiveRecord::Base.sanitize_sql_like(query, LIKE_ESCAPE)}%"
+    end
+
+    def text_for(content)
+      if content.respond_to?(:to_plain_text)
+        content.to_plain_text
+      else
+        content.to_s
+      end
+    end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..2aec333
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,47 @@
+<% matching_comments = card.comments.select { |comment| search.matches?(comment.body) } %>
+
+<%= card_article_tag card, class: "card" do %>
+  <div class="flex flex-column flex-item-grow max-inline-size">
+    <header class="card__header">
+      <div class="card__board">
+        <%= render "cards/display/common/board", card: card %>
+      </div>
+    </header>
+
+    <div class="card__body">
+      <div class="card__content">
+        <h3 class="card__title">
+          <%= link_to highlight_search(card.title, search.query), card_path(card),
+                class: "card__title-link", data: { turbo_frame: "_top" } %>
+        </h3>
+
+        <% if search.matches?(card.description) %>
+          <div class="card__description lexxy-content">
+            <%= highlight_search(card.description, search.query) %>
+          </div>
+        <% end %>
+
+        <% matching_comments.each do |comment| %>
+          <div class="comment__body lexxy-content margin-block-start-half">
+            <strong><%= comment.creator.familiar_name %></strong>
+            <%= highlight_search(comment.body, search.query) %>
+          </div>
+        <% end %>
+      </div>
+    </div>
+
+    <footer class="card__footer flex gap-half">
+      <div class="card__meta">
+        <div class="card__meta-avatars card__meta-avatars--author">
+          <%= avatar_tag card.creator %>
+        </div>
+        <span class="card__meta-text card__meta-text--added">
+          Added <%= local_datetime_tag(card.created_at, style: :daysago) %>
+        </span>
+        <span class="card__meta-text card__meta-text--author">
+          <%= card.creator.familiar_name %>
+        </span>
+      </div>
+    </footer>
+  </div>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c131582
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,30 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span>Search</span>
+  </h1>
+<% end %>
+
+<section class="search pad">
+  <%= form_with url: search_path, method: :get, class: "search__form" do |form| %>
+    <%= form.search_field :q, value: @search.query,
+          placeholder: "Search cards by title, description, or comment…",
+          class: "input",
+          autocomplete: "off", autocorrect: "off", autofocus: true %>
+  <% end %>
+
+  <% if @search.query.present? %>
+    <% if @cards.any? %>
+      <div class="cards cards--grid search__results">
+        <div class="cards__list">
+          <%= render partial: "searches/result", collection: @cards, as: :card, locals: { search: @search } %>
+        </div>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Search for cards by title, description, or comment.</div>
+  <% end %>
+</section>
