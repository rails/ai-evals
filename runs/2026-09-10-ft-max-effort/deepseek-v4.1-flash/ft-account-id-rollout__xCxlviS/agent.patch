diff --git a/config/initializers/account_scoping.rb b/config/initializers/account_scoping.rb
new file mode 100644
index 0000000..f233f5e
--- /dev/null
+++ b/config/initializers/account_scoping.rb
@@ -0,0 +1,23 @@
+# Framework-owned tables (Active Storage, Action Text) predate the application
+# models, so their account associations are attached here.
+#
+# account_id is populated from Current.account or from the owning record.
+# Active Storage records are optional because globally-owned blobs (for example
+# identity avatars) legitimately have no account.
+Rails.application.config.to_prepare do
+  if defined?(ActiveStorage::Blob) && !ActiveStorage::Blob.reflect_on_association(:account)
+    ActiveStorage::Blob.belongs_to :account, optional: true, default: -> { Current.account }
+  end
+
+  if defined?(ActiveStorage::Attachment) && !ActiveStorage::Attachment.reflect_on_association(:account)
+    ActiveStorage::Attachment.belongs_to :account, optional: true, default: -> { record.try(:account) }
+  end
+
+  if defined?(ActiveStorage::VariantRecord) && !ActiveStorage::VariantRecord.reflect_on_association(:account)
+    ActiveStorage::VariantRecord.belongs_to :account, optional: true, default: -> { blob.try(:account) }
+  end
+
+  if defined?(ActionText::RichText) && !ActionText::RichText.reflect_on_association(:account)
+    ActionText::RichText.belongs_to :account, optional: true, default: -> { record.try(:account) }
+  end
+end
