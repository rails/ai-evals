+class AddAccountIdToRemainingTables < ActiveRecord::Migration[8.2]
+  # Tables that hold an account's data but were missed when account_id was
+  # first introduced. Each entry maps a table to the SQL used to resolve the
+  # owning account from the table's existing associations.
+  TENANT_TABLES = {
+    "accesses" => "SELECT boards.account_id FROM boards WHERE boards.id = accesses.board_id",
+    "assignments" => "SELECT cards.account_id FROM cards WHERE cards.id = assignments.card_id",
+    "board_publications" => "SELECT boards.account_id FROM boards WHERE boards.id = board_publications.board_id",
+    "card_activity_spikes" => "SELECT cards.account_id FROM cards WHERE cards.id = card_activity_spikes.card_id",
+    "card_goldnesses" => "SELECT cards.account_id FROM cards WHERE cards.id = card_goldnesses.card_id",
+    "card_not_nows" => "SELECT cards.account_id FROM cards WHERE cards.id = card_not_nows.card_id",
+    "closures" => "SELECT cards.account_id FROM cards WHERE cards.id = closures.card_id",
+    "entropies" => <<~SQL.squish,
+      SELECT CASE entropies.container_type
+        WHEN 'Account' THEN entropies.container_id
+        WHEN 'Board' THEN (SELECT boards.account_id FROM boards WHERE boards.id = entropies.container_id)
+        WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = entropies.container_id)
+      END
+    SQL
+    "mentions" => <<~SQL.squish,
+      SELECT CASE mentions.source_type
+        WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = mentions.source_id)
+        WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = mentions.source_id)
+      END
+    SQL
+    "pins" => "SELECT cards.account_id FROM cards WHERE cards.id = pins.card_id",
+    "reactions" => <<~SQL.squish,
+      SELECT CASE reactions.reactable_type
+        WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = reactions.reactable_id)
+        WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = reactions.reactable_id)
+      END
+    SQL
+    "search_queries" => "SELECT users.account_id FROM users WHERE users.id = search_queries.user_id",
+    "taggings" => "SELECT cards.account_id FROM cards WHERE cards.id = taggings.card_id",
+    "user_settings" => "SELECT users.account_id FROM users WHERE users.id = user_settings.user_id",
+    "watches" => "SELECT cards.account_id FROM cards WHERE cards.id = watches.card_id",
+    "webhook_delinquency_trackers" => "SELECT webhooks.account_id FROM webhooks WHERE webhooks.id = webhook_delinquency_trackers.webhook_id",
+    "webhook_deliveries" => "SELECT webhooks.account_id FROM webhooks WHERE webhooks.id = webhook_deliveries.webhook_id",
+    # ActionText is account data, but Active Storage can also hold records that
+    # are legitimately global (identity avatars), so its account_id stays nullable.
+    "action_text_rich_texts" => <<~SQL.squish
+      SELECT CASE action_text_rich_texts.record_type
+        WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = action_text_rich_texts.record_id)
+        WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = action_text_rich_texts.record_id)
+        WHEN 'Board' THEN (SELECT boards.account_id FROM boards WHERE boards.id = action_text_rich_texts.record_id)
+      END
+    SQL
+  }.freeze
+
+  # Active Storage tables gain account_id where we can resolve it, but keep the
+  # column nullable because globally-owned blobs (e.g. identity avatars) exist.
+  NULLABLE_TENANT_TABLES = {
+    "active_storage_attachments" => <<~SQL.squish,
+      SELECT CASE active_storage_attachments.record_type
+        WHEN 'Card' THEN (SELECT cards.account_id FROM cards WHERE cards.id = active_storage_attachments.record_id)
+        WHEN 'Comment' THEN (SELECT comments.account_id FROM comments WHERE comments.id = active_storage_attachments.record_id)
+        WHEN 'Board' THEN (SELECT boards.account_id FROM boards WHERE boards.id = active_storage_attachments.record_id)
+        WHEN 'User' THEN (SELECT users.account_id FROM users WHERE users.id = active_storage_attachments.record_id)
+        WHEN 'ActionText::RichText' THEN (SELECT action_text_rich_texts.account_id FROM action_text_rich_texts WHERE action_text_rich_texts.id = active_storage_attachments.record_id)
+      END
+    SQL
+    "active_storage_blobs" => <<~SQL.squish,
+      SELECT (SELECT active_storage_attachments.account_id
+              FROM active_storage_attachments
+              WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+                AND active_storage_attachments.account_id IS NOT NULL
+              LIMIT 1)
+    SQL
+    "active_storage_variant_records" => <<~SQL.squish
+      SELECT active_storage_blobs.account_id
+      FROM active_storage_blobs
+      WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+    SQL
+  }.freeze
+
+  # Existing account_id columns that were left nullable and/or unindexed.
+  EXISTING_TENANT_TABLES = %w[
+    account_imports account_join_codes boards cards columns comments events
+    filters notification_bundles notifications push_subscriptions steps tags
+    users webhooks
+  ].freeze
