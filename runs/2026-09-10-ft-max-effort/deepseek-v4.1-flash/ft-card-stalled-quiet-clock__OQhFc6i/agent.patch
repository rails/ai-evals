diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..73d78a4
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,98 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  # A burst is a short flurry of attention. We keep the timestamp of the last
+  # one so we can detect cards that got hot and then went cold.
+  BURST_COMMENT_THRESHOLD = 3
+  BURST_PERSON_THRESHOLD = 2
+  BURST_WINDOW_DIVISOR = 3
+
+  # How long a card can sit untouched after a burst before it's considered stalled.
+  STALL_PERIOD = 2.weeks
+
+  included do
+    alias_attribute :burst_at, :last_burst_at
+
+    before_save :clear_stall_on_activity, if: :will_save_change_to_last_active_at?
+
+    scope :stalled, -> do
+      now = Time.current
+
+      where(
+        "cards.stalled_at IS NOT NULL AND cards.stalled_at <= :now " \
+          "OR cards.last_burst_at IS NOT NULL AND cards.last_active_at <= :stalled_before",
+        now: now, stalled_before: now - STALL_PERIOD
+      )
+    end
+  end
+
+  class_methods do
+    # Flags every card that burst and has since gone quiet for the stall period.
+    # Written as a batch so a scheduled run can keep the persisted flag (and
+    # therefore caches) in sync even when nobody is looking at the card.
+    def stall_all_due(as_of: Time.current)
+      Account.find_each do |account|
+        account.cards
+          .where.not(last_burst_at: nil)
+          .where(last_active_at: ..(as_of - STALL_PERIOD))
+          .where(stalled_at: nil)
+          .find_each { |card| card.update!(stalled_at: as_of) }
+      end
+    end
+  end
+
+  def burst?
+    last_burst_at.present?
+  end
+
+  alias_method :bursting?, :burst?
+
+  def stalled?
+    stored_stall? || derived_stall?
+  end
+
+  # When the card became stalled, used to render how long it has been stalled.
+  def stalled_since
+    if stored_stall?
+      stalled_at
+    elsif derived_stall?
+      last_active_at + STALL_PERIOD
+    end
+  end
+
+  def mark_burst
+    update!(last_burst_at: Time.current, last_active_at: Time.current, stalled_at: nil)
+  end
+
+  def detect_burst
+    mark_burst if burst_imminent?
+  end
+
+  def clear_stall
+    update!(stalled_at: nil) if stalled_at.present?
+  end
+
+  private
+    def stored_stall?
+      stalled_at.present? && stalled_at <= Time.current
+    end
+
+    def derived_stall?
+      burst? && last_active_at.present? && last_active_at <= STALL_PERIOD.ago
+    end
+
+    def clear_stall_on_activity
+      self.stalled_at = nil
+    end
+
+    def burst_imminent?
+      recent_comments = comments.by_user.where(created_at: burst_window.ago..)
+
+      recent_comments.count >= BURST_COMMENT_THRESHOLD &&
+        recent_comments.distinct.count(:creator_id) >= BURST_PERSON_THRESHOLD
+    end
+
+    def burst_window
+      (auto_postpone_period / BURST_WINDOW_DIVISOR).seconds
+    end
+end
