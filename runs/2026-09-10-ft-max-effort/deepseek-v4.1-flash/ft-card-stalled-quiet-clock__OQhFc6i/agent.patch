diff --git a/test/integration/stalled_cards_test.rb b/test/integration/stalled_cards_test.rb
new file mode 100644
index 0000000..97a6818
--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:text)
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+  end
+
+  test "cards index can list stalled cards" do
+    get cards_path(indexed_by: "stalled"), as: :json
+
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("number"), @card.number
+  end
+
+  test "stalled cards are marked in JSON" do
+    get card_path(@card, format: :json)
+
+    assert_response :success
+    assert @response.parsed_body["stalled"]
+  end
+
+  test "stalled cards show a badge" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select ".card--stalled"
+    assert_select ".card__stalled", text: "Stalled"
+  end
+end
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  test "cards index can list stalled cards within a board" do
+    get cards_path(indexed_by: "stalled", board_ids: [ @card.board_id ]), as: :json
+
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("number"), @card.number
+  end
+
