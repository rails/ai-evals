+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @board.update!(auto_postpone_period: 3.days) # burst window is one day
+    @card = @board.cards.create!(title: "Stallable card", creator: users(:david), status: :published)
+  end
+
+  test "a burst needs three comments from two people within the window" do
+    assert_not @card.burst?
+
+    @card.comments.create!(creator: users(:david), body: "one")
+    @card.comments.create!(creator: users(:david), body: "two")
+    @card.comments.create!(creator: users(:david), body: "three")
+    assert_not @card.reload.burst?, "three comments from one person aren't a burst"
+
+    @card.comments.create!(creator: users(:kevin), body: "four")
+    assert @card.reload.burst?
+  end
+
+  test "comments spread beyond the window don't burst" do
+    @card.comments.create!(creator: users(:david), body: "old", created_at: 3.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "older", created_at: 4.days.ago)
+    @card.comments.create!(creator: users(:david), body: "recent")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "assigning a card bursts it" do
+    assert_changes -> { @card.reload.burst? }, to: true do
+      @card.toggle_assignment users(:kevin)
+    end
+  end
+
+  test "reopening a card bursts it" do
+    @card.close
+    assert_changes -> { @card.reload.burst? }, to: true do
+      @card.reopen
+    end
+  end
+
+  test "a burst that goes quiet for two weeks is stalled" do
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a burst with recent activity is not stalled" do
+    @card.update!(last_burst_at: 1.week.ago, last_active_at: 1.week.ago)
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a card that never burst is not stalled" do
+    @card.update!(last_active_at: 3.weeks.ago)
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity resets a stalled card" do
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    travel 1.minute do
+      @card.comments.create!(creator: users(:kevin), body: "still alive")
+    end
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "the persisted stall flag can be cleared by activity" do
+    @card.update!(last_burst_at: 3.weeks.ago, stalled_at: 2.weeks.ago)
+    assert @card.stalled?
+
+    travel 1.minute do
+      @card.touch_last_active_at
+    end
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "stall_all_due marks quiet bursted cards" do
+    due = @card
+    due.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    fresh = @board.cards.create!(title: "Fresh", creator: users(:david), status: :published)
+    fresh.update!(last_burst_at: 1.hour.ago, last_active_at: 1.hour.ago)
+
+    Card.stall_all_due
+
+    assert_not_nil due.reload.stalled_at
+    assert_nil fresh.reload.stalled_at
+  end
+
+  test "indexed_by stalled scopes to stalled cards" do
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+end
