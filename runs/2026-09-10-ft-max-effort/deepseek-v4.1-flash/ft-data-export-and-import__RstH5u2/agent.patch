@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Account::ExportJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+  end
+
+  test "exports a full account and emails the requester" do
+    export = Export.create!(account: @account, user: users(:david), category: "account")
+
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      Account::ExportJob.perform_now(export)
+      perform_enqueued_jobs
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    export.file.open do |file|
+      reader = ZipFile::Reader.new(file)
+      assert reader.exists?("manifest.json")
+      assert reader.exists?("boards.json")
+    end
+  end
+
+  test "exports the cards a user can see" do
+    export = Export.create!(account: @account, user: users(:david), category: "cards")
+
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      Account::ExportJob.perform_now(export)
+      perform_enqueued_jobs
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.file.attached?
+
+    export.file.open do |file|
+      reader = ZipFile::Reader.new(file)
+      assert reader.exists?("manifest.json")
+      assert reader.exists?("cards.json")
+    end
+  end
+
+  test "marks the export failed when it cannot be produced" do
+    export = Export.create!(account: @account, user: users(:david), category: "account")
+    ZipFile.stubs(:create_for).raises(StandardError.new("boom"))
+
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      Account::ExportJob.perform_now(export)
+      perform_enqueued_jobs
+    end
+
+    export.reload
+    assert export.failed?
+    assert_equal "boom", export.error
+  end
+end
diff --git a/test/jobs/account/import_job_test.rb b/test/jobs/account/import_job_test.rb
new file mode 100644
index 0000000..94ca0d3
--- /dev/null
+++ b/test/jobs/account/import_job_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::ImportJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+  end
+
+  test "imports an account and emails the requester" do
+    import = build_import_from_export
+
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      Account::ImportJob.perform_now(import)
+      perform_enqueued_jobs
+    end
+
+    import.reload
+    assert import.completed?
+    assert_not_nil import.account
+    assert_equal "37signals", import.account.name
+  end
+
+  test "emails when an import fails and leaves nothing behind" do
+    import = Import.create!(identity: identities(:jason), user: users(:jason), account: @account)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        Account::ImportJob.perform_now(import)
+        perform_enqueued_jobs
+      end
+    end
+
+    import.reload
+    assert import.failed?
+    assert import.error.present?
+  end
+
+  private
+    def build_import_from_export
+      export = Export.create!(account: @account, user: users(:david), category: "account")
+      Account::ExportJob.perform_now(export)
+      perform_enqueued_jobs
+
+      import = Import.create!(identity: identities(:jason), user: users(:jason), account: @account)
+      export.file.open { |file| import.file.attach(io: file, filename: "export.zip", content_type: "application/zip") }
+      import
+    end
+end
