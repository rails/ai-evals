@@ -2,4 +2,20 @@ class Account::DataTransfer::EntropyRecordSet < Account::DataTransfer::RecordSet
   def initialize(account)
     super(account: account, model: Entropy)
   end
+
+  # Creating the destination account also creates its default entropy, so clear
+  # it before replaying the exported entropies.
+  def import_from(zip, importer)
+    with_zip(zip) do
+      return false unless zip.exists?(data_path)
+
+      Entropy.where(account_id: account.id).delete_all
+
+      JSON.parse(zip.read(data_path)).each do |row|
+        importer.import_record(Entropy, row)
+      end
+
+      true
+    end
+  end
 end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..f6a9df3
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,220 @@
+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  attr_reader :import, :account
+
+  def initialize(import)
+    @import = import
+    @id_map = {}
+    @uploaded_blob_keys = []
+    @uuid_columns = {}
+    @account = nil
+  end
+
+  def import!
+    open_archive do |zip|
+      manifest_data = read_manifest(zip)
+
+      ActiveRecord::Base.transaction do
+        @account = Account.create!(name: manifest_data.dig("account", "name").presence || "Imported account")
+        map_id(manifest_data.dig("account", "id"), @account.id)
+
+        manifest.import_from(zip, self)
+        finalize_account
+        import.update!(account: @account)
+      end
+    end
+
+    @account
+  rescue
+    cleanup_uploaded_blobs
+    raise
+  end
+
+  # Registers a row from the archive with the new account, remapping its
+  # primary and foreign keys so it slots into the new account's graph.
+  def import_record(model, row)
+    model.insert_all!([ remap_attributes(model, row) ])
+  end
+
+  def import_user(row, identity_email:)
+    row = row.except("identity_email")
+    attributes = remap_attributes(User, row)
+    attributes["identity_id"] = identity_for(identity_email)&.id
+
+    User.insert_all!([ attributes ])
+  end
+
+  def import_blob(row)
+    attributes = remap_attributes(::ActiveStorage::Blob, row)
+    attributes["key"] = SecureRandom.base58(24)
+    attributes["service_name"] = ::ActiveStorage::Blob.service.name
+
+    ::ActiveStorage::Blob.insert_all!([ attributes ])
+  end
+
+  def import_blob_file(old_blob_id, zip, path)
+    blob = ::ActiveStorage::Blob.find_by(id: id_for(old_blob_id))
+    return if blob.nil?
+
+    tempfile = Tempfile.new([ "import", ".bin" ])
+    tempfile.binmode
+    zip.stream(path) { |chunk| tempfile.write(chunk) }
+    tempfile.rewind
+
+    ::ActiveStorage::Blob.service.upload(
+      blob.key,
+      tempfile,
+      checksum: blob.checksum,
+      filename: blob.filename.to_s,
+      content_type: blob.content_type,
+      disposition: blob.content_type.to_s.start_with?("image/") ? "inline" : "attachment"
+    )
+
+    @uploaded_blob_keys << blob.key
+  ensure
+    tempfile&.close!
+  end
+
+  def import_rich_text(row)
+    attributes = remap_attributes(::ActionText::RichText, row)
+    attributes["body"] = rewrite_rich_text_body(attributes["body"])
+
+    ::ActionText::RichText.insert_all!([ attributes ])
+  end
+
+  # Maps an id from the archive to the id it will have in the new account.
+  # Ids are generated lazily so records that reference a row appearing later
+  # in the archive still agree on the same new id.
+  def id_for(old_id)
+    return nil if old_id.blank?
+
+    @id_map[old_id.to_s] ||= ActiveRecord::Type::Uuid.generate
+  end
+
+  private
+    def open_archive
+      raise InvalidArchive, "No file attached to import" unless import.file.attached?
+
+      import.file.open do |file|
+        yield build_reader(file)
+      end
+    end
+
+    def build_reader(file)
+      ZipFile::Reader.new(file)
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ArgumentError
+      raise InvalidArchive, "The uploaded file is not a valid Fizzy export."
+    end
+
+    def read_manifest(zip)
+      manifest_data = Account::DataTransfer::Manifest.read_manifest(zip)
+
+      unless manifest_data["version"] == Account::DataTransfer::Manifest::VERSION
+        raise InvalidArchive, "This export was created by an unsupported version of Fizzy."
+      end
+
+      if manifest_data["category"].present? && manifest_data["category"] != "account"
+        raise InvalidArchive, "This file isn't a full account export."
+      end
+
+      manifest_data
+    rescue ArgumentError
+      raise InvalidArchive, "The uploaded file is not a valid Fizzy export."
+    end
+
+    def manifest
+      @manifest ||= Account::DataTransfer::Manifest.new(account)
+    end
+
+    def finalize_account
+      highest_card_number = Card.where(account_id: account.id).maximum(:number) || 0
+      account.update_column(:cards_count, highest_card_number)
+
+      ensure_importer_can_access_account
+    end
+
+    def ensure_importer_can_access_account
+      return if import.identity.blank?
+      return if account.users.exists?(identity_id: import.identity_id)
+
+      account.users.create!(
+        identity: import.identity,
+        name: import.identity.email_address,
+        role: :owner,
+        verified_at: Time.current
+      )
+    end
+
+    def map_id(old_id, new_id)
+      return if old_id.blank?
+
+      @id_map[old_id.to_s] = new_id
+    end
+
+    def remap_attributes(model, row)
+      uuid_columns = uuid_columns_for(model)
+
+      row.each_with_object({}) do |(key, value), attributes|
+        attributes[key] = if key == "id" || (key.end_with?("_id") && uuid_columns.include?(key))
+          id_for(value)
+        else
+          value
+        end
+      end.tap do |attributes|
+        attributes["account_id"] = account.id if model.column_names.include?("account_id")
+        regenerate_unique_attributes(model, attributes)
+      end
+    end
+
+    def uuid_columns_for(model)
+      @uuid_columns[model] ||= model.column_names.select { |column| model.type_for_attribute(column).is_a?(ActiveRecord::Type::Uuid) }
+    end
+
+    def regenerate_unique_attributes(model, attributes)
+      # Tokens are generated by callbacks we intentionally skip when inserting
+      # directly, so make sure they stay unique across accounts.
+      attributes["key"] = SecureRandom.base58(24) if model == ::Board::Publication
+    end
+
+    def identity_for(email_address)
+      return nil if email_address.blank?
+
+      Identity.create_or_find_by!(email_address: email_address.strip.downcase)
+    end
+
+    def rewrite_rich_text_body(body)
+      return body if body.blank?
+
+      body.gsub(/sgid="([^"]+)"/) do
+        old_sgid = $1
+        old_blob_id = blob_id_from_sgid(old_sgid)
+        blob = old_blob_id && ::ActiveStorage::Blob.find_by(id: id_for(old_blob_id))
+
+        blob ? %(sgid="#{blob.attachable_sgid}") : %(sgid="#{old_sgid}")
+      end
+    rescue => error
+      Rails.logger.warn("Could not rewrite rich text attachments: #{error.message}")
+      body
+    end
+
+    def blob_id_from_sgid(sgid)
+      payload = sgid.to_s.split("--").first
+      data = JSON.parse(Base64.decode64(payload))
+      gid = data["gid"] || data[:gid]
+
+      gid&.split("/")&.last.presence
+    rescue JSON::ParserError, ArgumentError, TypeError
+      nil
+    end
+
+    def cleanup_uploaded_blobs
+      @uploaded_blob_keys.each do |key|
+        ::ActiveStorage::Blob.service.delete(key)
+      rescue => error
+        Rails.logger.warn("Could not clean up imported blob #{key}: #{error.message}")
+      end
+
+      @uploaded_blob_keys.clear
+    end
+end
