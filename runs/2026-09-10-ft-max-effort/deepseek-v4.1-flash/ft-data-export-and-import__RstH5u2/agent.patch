+    card = cards.find { |c| c["number"] == cards(:logo).number }
+    assert_equal "The logo isn't big enough", card["title"]
+    assert_equal cards(:logo).comments.count, card["comments"].size
+  end
+
+  test "includes picture and file contents" do
+    card = cards(:logo)
+    card.image.attach(
+      io: File.open(Rails.root.join("test/fixtures/files/moon.jpg"), "rb"),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    file = Tempfile.new([ "cards", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    Account::DataTransfer::CardsExport.new(account: @account, user: @user).export_to(writer)
+    writer.close
+    file.rewind
+
+    reader = ZipFile::Reader.new(file)
+    exported = JSON.parse(reader.read("cards.json")).find { |c| c["number"] == card.number }
