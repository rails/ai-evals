+require "test_helper"
+
+class Account::DataTransfer::ImportExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+  end
+
+  test "exports an account to an archive" do
+    file = export_account(@account)
+
+    assert_operator file.size, :>, 0
+
+    reader = ZipFile::Reader.new(file)
+    assert reader.exists?("manifest.json")
+    assert reader.exists?("boards.json")
+    assert reader.exists?("cards.json")
+    assert reader.exists?("active_storage_attachments.json")
+
+    manifest = JSON.parse(reader.read("manifest.json"))
+    assert_equal 1, manifest["version"]
+    assert_equal @account.name, manifest.dig("account", "name")
+  end
+
+  test "imports an exported account into a new account" do
+    file = export_account(@account)
+
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: file, filename: "export.zip", content_type: "application/zip")
+
+    new_account = Account::DataTransfer::Importer.new(import).import!
+
+    assert_not_equal @account.id, new_account.id
+    assert_equal @account.name, new_account.name
+    assert_equal @account.boards.count, new_account.boards.count
+    assert_equal @account.cards.count, new_account.cards.count
+    assert_equal @account.users.count, new_account.users.count
+    assert_equal Comment.where(account_id: @account.id).count, Comment.where(account_id: new_account.id).count
+
+    new_board = new_account.boards.find_by(name: "Writebook")
+    assert_not_nil new_board
+    assert_equal @account.cards.where(board: @account.boards.find_by(name: "Writebook")).count, new_board.cards.count
+  end
+
+  test "imports people and links them to their identities" do
+    file = export_account(@account)
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: file, filename: "export.zip", content_type: "application/zip")
+
+    new_account = Account::DataTransfer::Importer.new(import).import!
+
+    assert_equal @account.users.count, new_account.users.count
+    assert_equal @account.users.order(:name).pluck(:name, :role),
+      new_account.users.order(:name).pluck(:name, :role)
+
+    source_emails = @account.users.filter_map { |user| user.identity&.email_address }.sort
+    new_emails = new_account.users.filter_map { |user| user.identity&.email_address }.sort
+    assert_equal source_emails, new_emails
+  end
+
+  test "importing a non-archive leaves nothing behind" do
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      assert_raises(Account::DataTransfer::Importer::InvalidArchive) do
+        Account::DataTransfer::Importer.new(import).import!
+      end
+    end
+  end
+
+  private
+    def export_account(account)
+      file = Tempfile.new([ "export", ".zip" ])
+      file.binmode
+
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Manifest.new(account).export_to(writer)
+      writer.close
+
+      file.rewind
+      file
+    end
+end
+
+class Account::DataTransfer::ImportRollbackTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.account = @account
+  end
+
+  test "a failure partway through an import leaves nothing behind" do
+    file = Tempfile.new([ "broken", ".zip" ])
+    file.binmode
+
+    writer = ZipFile::Writer.new(file)
+    writer.add_file("manifest.json", { version: 1, account: { id: @account.id, name: "Broken" } }.to_json)
+    writer.add_file("accounts.json", "[]")
+    # A board with no name violates the NOT NULL/validation constraint.
+    writer.add_file("boards.json", [ { id: @account.id, account_id: @account.id, name: nil } ].to_json)
+    writer.close
+    file.rewind
+
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: file, filename: "broken.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      assert_raises(ActiveRecord::NotNullViolation, ActiveRecord::StatementInvalid) do
+        Account::DataTransfer::Importer.new(import).import!
+      end
+    end
+  end
+end
+
+class Account::DataTransfer::RejectsCardsExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.account = @account
+  end
+
+  test "refuses to import a cards-only export" do
+    file = Tempfile.new([ "cards", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    Account::DataTransfer::CardsExport.new(account: @account, user: users(:david)).export_to(writer)
+    writer.close
+    file.rewind
+
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: file, filename: "cards.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      assert_raises(Account::DataTransfer::Importer::InvalidArchive) do
+        Account::DataTransfer::Importer.new(import).import!
+      end
+    end
+  end
+end
+
+class Account::DataTransfer::ImportAccessTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.account = @account
+  end
+
+  test "the importer is given owner access when they weren't in the export" do
+    file = Tempfile.new([ "export", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    Account::DataTransfer::Manifest.new(@account).export_to(writer)
+    writer.close
+    file.rewind
+
+    outsider = Identity.create!(email_address: "outsider@example.com")
+    import = Import.create!(identity: outsider, account: @account)
+    import.file.attach(io: file, filename: "export.zip", content_type: "application/zip")
+
+    new_account = Account::DataTransfer::Importer.new(import).import!
+
+    user = new_account.users.find_by(identity: outsider)
+    assert_not_nil user
+    assert user.owner?
+  end
+end
