+    file.binmode
+
+    writer = ZipFile::Writer.new(file)
+    Account::DataTransfer::CardsExport.new(account: @account, user: @user).export_to(writer)
+    writer.close
+    file.rewind
+
+    reader = ZipFile::Reader.new(file)
+    manifest = JSON.parse(reader.read("manifest.json"))
+    assert_equal "cards", manifest["category"]
+    assert_equal @user.id, manifest.dig("user", "id")
+
+    cards = JSON.parse(reader.read("cards.json"))
