@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::DataTransfer::ImportCleanupTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.account = @account
+  end
+
+  test "a failed import cleans up files it had already uploaded" do
+    content = "file contents"
+    blob_row = {
+      "id" => "0000000000000000000000001",
+      "account_id" => @account.id,
+      "key" => "old-key",
+      "filename" => "hello.txt",
+      "content_type" => "text/plain",
+      "byte_size" => content.bytesize,
+      "checksum" => Digest::MD5.base64digest(content),
+      "metadata" => {},
+      "created_at" => Time.current
+    }
+
+    file = Tempfile.new([ "broken", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    writer.add_file("manifest.json", { version: 1, category: "account", account: { id: @account.id, name: "Broken" } }.to_json)
+    writer.add_file("accounts.json", "[]")
+    # Two blobs are listed but only the first has a file entry, so the import
+    # fails after the first file was already written to storage.
+    writer.add_file("active_storage_blobs.json", [ blob_row, blob_row.merge("id" => "0000000000000000000000002") ].to_json)
+    writer.add_file("files/0000000000000000000000001", content)
+    writer.close
+    file.rewind
+
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: file, filename: "broken.zip", content_type: "application/zip")
+
+    ActiveStorage::Blob.service.expects(:delete).once
+
+    assert_no_difference -> { Account.count } do
+      assert_raises(Account::DataTransfer::ActiveStorage::FileRecordSet::MissingFile) do
+        Account::DataTransfer::Importer.new(import).import!
+      end
+    end
+  end
+end
