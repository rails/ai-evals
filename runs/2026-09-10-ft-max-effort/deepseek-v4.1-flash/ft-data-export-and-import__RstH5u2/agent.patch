+  end
+
   def checksum
-    Base64.strict_encode64(@digest.digest)
+    Base64.strict_encode64(tracker.digest.digest)
   end
 
   private
     def streamer
-      @streamer ||= ZipKit::Streamer.new(@output_io)
+      @streamer ||= ZipKit::Streamer.new(tracker)
+    end
+
+    def tracker
+      @tracker ||= Tracker.new(@output_io)
+    end
+
+    # Wraps the destination IO so we can report the size and checksum of the
+    # archive as it is being streamed out.
+    class Tracker
+      attr_reader :bytes, :digest
+
+      def initialize(io)
+        @io = io
+        @bytes = 0
+        @digest = Digest::MD5.new
+      end
+
+      def <<(data)
+        @io << data
+        track(data)
+        self
+      end
+
+      def write(data)
+        @io.write(data)
+        track(data)
+        data.bytesize
+      end
+
+      private
+        def track(data)
+          @bytes += data.bytesize
+          @digest.update(data)
+        end
     end
 end
