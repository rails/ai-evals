@@ -0,0 +1,72 @@
+class Export < ApplicationRecord
+  CATEGORIES = %w[account cards].freeze
+  STATUSES = %w[pending processing completed failed].freeze
+
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  validates :category, inclusion: { in: CATEGORIES }
+  validates :status, inclusion: { in: STATUSES }
+
+  scope :stale, -> { where(created_at: ...DOWNLOAD_LINK_EXPIRY.ago) }
+
+  class << self
+    def find_by_download_id(id)
+      find_signed(id, purpose: :export_download)
+    end
+
+    # Download links expire after a day, so the archive is no longer useful.
+    def cleanup
+      stale.find_each(&:destroy)
+    end
+  end
+
+  def account_wide?
+    category == "account"
+  end
+
+  def cards?
+    category == "cards"
+  end
+
+  def processing!
+    update!(status: "processing")
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def completed!
+    update!(status: "completed", error: nil)
+  end
+
+  def failed!(message)
+    update!(status: "failed", error: message.to_s.truncate(10_000))
+  end
+
+  def download_id
+    signed_id(purpose: :export_download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+
+  def filename
+    account_name = account.name.to_s.parameterize.presence || "account"
+    "fizzy-#{account_name}-#{category}-export.zip"
+  end
+end
