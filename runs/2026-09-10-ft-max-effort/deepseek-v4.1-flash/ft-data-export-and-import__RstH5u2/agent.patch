diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..5db65a5
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:jason)
+    sign_in_as @admin
+  end
+
+  test "an admin can request a full account export" do
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with(job: Account::ExportJob) do
+        post account_exports_url
+      end
+    end
+
+    export = Export.last
+    assert_equal "account", export.category
+    assert_equal @admin, export.user
+    assert_redirected_to account_settings_path
+  end
+
+  test "a non-admin cannot request a full account export" do
+    logout_and_sign_in_as users(:david)
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_url
+    end
+
+    assert_response :forbidden
+  end
+
+  test "the requester can download a completed export" do
+    export = create_completed_export
+
+    get account_export_url(export.download_id)
+
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+    assert_equal "zip-data", response.body
+  end
+
+  test "the download link works without being signed in" do
+    export = create_completed_export
+    sign_out
+
+    get account_export_url(export.download_id)
+
+    assert_response :success
+    assert_equal "zip-data", response.body
+  end
+
+  test "a signed-in owner can download using the plain export id" do
+    export = create_completed_export
+
+    get account_export_url(export)
+
+    assert_response :success
+    assert_equal "zip-data", response.body
+  end
+
+  test "an expired or forged download id is rejected" do
+    get account_export_url("not-a-real-id")
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "account settings exposes the export control to admins" do
+    get account_settings_url
+
+    assert_response :success
+    assert_select "form[action=?]", account_exports_path
+  end
+
+  private
+    def create_completed_export
+      Export.create!(account: @account, user: @admin, category: "account").tap do |export|
+        export.file.attach(io: StringIO.new("zip-data"), filename: "export.zip", content_type: "application/zip")
+        export.completed!
+      end
+    end
+end
