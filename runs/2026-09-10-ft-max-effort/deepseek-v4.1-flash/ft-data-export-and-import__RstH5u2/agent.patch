diff --git a/app/jobs/account/export_job.rb b/app/jobs/account/export_job.rb
new file mode 100644
index 0000000..42b0753
--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,37 @@
+class Account::ExportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(export)
+    Current.with_account(export.account) do
+      export.processing!
+
+      if export.account_wide?
+        export_account(export)
+      else
+        export_cards(export)
+      end
+
+      export.completed!
+      ExportMailer.ready(export).deliver_later
+    end
+  rescue => error
+    Rails.error.report(error, context: { export_id: export&.id })
+    export&.failed!(error.message)
+    ExportMailer.failed(export).deliver_later if export&.persisted?
+  end
+
+  private
+    def export_account(export)
+      ZipFile.create_for(export.file, filename: export.filename) do |zip|
+        Account::DataTransfer::Manifest.new(export.account).export_to(zip)
+      end
+    end
+
+    def export_cards(export)
+      ZipFile.create_for(export.file, filename: export.filename) do |zip|
+        Account::DataTransfer::CardsExport.new(account: export.account, user: export.user).export_to(zip)
+      end
+    end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..ae17cfb
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,29 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    Current.with_account(import.account) do
+      import.processing!
+
+      Account::DataTransfer::Importer.new(import).import!
+
+      import.completed!
+      ImportMailer.completed(import).deliver_later
+    end
+  rescue => error
+    Rails.error.report(error, context: { import_id: import&.id })
+    import&.failed!(failure_message(error))
+    ImportMailer.failed(import).deliver_later if import&.persisted?
+  end
+
+  private
+    def failure_message(error)
+      if error.is_a?(Account::DataTransfer::Importer::InvalidArchive)
+        error.message
+      else
+        "We couldn't finish importing your account. #{error.message}"
+      end
+    end
+end
