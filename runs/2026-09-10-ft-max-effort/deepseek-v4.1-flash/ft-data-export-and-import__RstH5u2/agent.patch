@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::DataTransfer::ImportExportFilesTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+  end
+
+  test "round trips card images and rich text embeds" do
+    card = cards(:logo)
+    image_file = File.open(Rails.root.join("test/fixtures/files/moon.jpg"), "rb")
+    card.image.attach(io: image_file, filename: "moon.jpg", content_type: "image/jpeg")
+    image_file.close
+    original_image_blob = card.image.blob
+
+    comment = comments(:logo_1)
+    embedded_blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(Rails.root.join("test/fixtures/files/avatar.svg"), "rb"),
+      filename: "avatar.svg",
+      content_type: "image/svg+xml"
+    )
+    comment.update!(body: %(<p>Look:</p><action-text-attachment sgid="#{embedded_blob.attachable_sgid}"></action-text-attachment>))
+
+    file = export_account(@account)
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: file, filename: "export.zip", content_type: "application/zip")
+
+    new_account = Account::DataTransfer::Importer.new(import).import!
+
+    new_card = new_account.boards.find_by(name: card.board.name).cards.find_by(number: card.number)
+    assert new_card.image.attached?
+    assert_equal original_image_blob.checksum, new_card.image.blob.checksum
+
+    new_comment = new_card.comments.find { |c| c.body.to_s.include?("Look:") }
+    assert new_comment.body.to_s.include?("Look:")
+    new_embedded = ActionText::Content.new(new_comment.body.to_s).attachables.grep(ActiveStorage::Blob).first
+    assert_not_nil new_embedded
+    assert_equal embedded_blob.filename.to_s, new_embedded.filename.to_s
+    assert_equal embedded_blob.checksum, new_embedded.checksum
+  end
+
+  test "does not include the export's own archive" do
+    export = Export.create!(account: @account, user: users("david"), category: "account")
+    export.file.attach(io: StringIO.new("zip-archive"), filename: "existing.zip", content_type: "application/zip")
+
+    file = export_account(@account)
+    reader = ZipFile::Reader.new(file)
+    blobs = JSON.parse(reader.read("active_storage_blobs.json"))
+
+    assert_not_includes blobs.map { |blob| blob["checksum"] }, export.file.blob.checksum
+  end
+
+  private
+    def export_account(account)
+      file = Tempfile.new([ "export", ".zip" ])
+      file.binmode
+
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Manifest.new(account).export_to(writer)
+      writer.close
+
+      file.rewind
+      file
+    end
+end
