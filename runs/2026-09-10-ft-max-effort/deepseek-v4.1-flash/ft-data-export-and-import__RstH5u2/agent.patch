+require "test_helper"
+
+class Account::DataTransfer::CardsExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.account = @account
+  end
+
+  test "exports only the cards the user can see, with comments" do
