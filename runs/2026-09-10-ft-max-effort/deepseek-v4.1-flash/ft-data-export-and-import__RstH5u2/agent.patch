diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..f6132ab
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,45 @@
+class ZipFile::Reader
+  class MissingEntry < StandardError; end
+
+  def initialize(io)
+    @io = io
+    @entries = {}
+    ZipKit::FileReader.read_zip_structure(io: io).each do |entry|
+      @entries[normalize(entry.filename)] = entry
+    end
+  end
+
+  def exists?(path)
+    @entries.key?(normalize(path))
+  end
+
+  def read(path)
+    entry = entry_for(path)
+    reader = entry.extractor_from(@io)
+    contents = +""
+    contents << reader.extract(64.kilobytes) until reader.eof?
+    contents
+  end
+
+  # Streams the entry, yielding chunks of decompressed content.
+  def stream(path, chunk_size: 64.kilobytes)
+    entry = entry_for(path)
+    reader = entry.extractor_from(@io)
+    until reader.eof?
+      yield reader.extract(chunk_size)
+    end
+  end
+
+  def each_entry
+    @entries.each_key { |name| yield name }
+  end
+
+  private
+    def entry_for(path)
+      @entries.fetch(normalize(path)) { raise MissingEntry, "No such entry in archive: #{path}" }
+    end
+
+    def normalize(path)
+      path.to_s.sub(%r{\A\./}, "").delete_prefix("/")
+    end
+end
