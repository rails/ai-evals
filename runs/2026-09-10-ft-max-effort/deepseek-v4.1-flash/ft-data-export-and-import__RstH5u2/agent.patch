+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "cleanup removes stale exports and their files" do
+    stale = Export.create!(account: @account, user: @user, category: "account", created_at: 2.days.ago)
+    stale.file.attach(io: StringIO.new("old"), filename: "old.zip", content_type: "application/zip")
+    fresh = Export.create!(account: @account, user: @user, category: "account")
+
+    Export.cleanup
+
+    assert_not Export.exists?(stale.id)
+    assert Export.exists?(fresh.id)
+  end
+
+  test "find_by_download_id only accepts a valid signed id" do
+    export = Export.create!(account: @account, user: @user, category: "account")
+
+    assert_equal export, Export.find_by_download_id(export.download_id)
+    assert_nil Export.find_by_download_id("bogus")
+  end
+end
