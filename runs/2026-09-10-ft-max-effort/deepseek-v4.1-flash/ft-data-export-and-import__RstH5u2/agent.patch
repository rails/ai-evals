+    @import = import
+    @account = import.account
+
+    mail to: import.identity.email_address, subject: "Your Fizzy account is ready"
+  end
+
+  def failed(import)
+    @import = import
+    @account = import.account
+
+    mail to: import.identity.email_address, subject: "We couldn't import your Fizzy account"
+  end
+end
