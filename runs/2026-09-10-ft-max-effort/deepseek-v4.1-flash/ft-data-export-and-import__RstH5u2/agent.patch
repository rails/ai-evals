+    assert_equal "moon.jpg", exported.dig("image", "filename")
+    assert reader.exists?(exported.dig("image", "file"))
+    assert_equal File.binread(Rails.root.join("test/fixtures/files/moon.jpg")), reader.read(exported.dig("image", "file"))
+  end
