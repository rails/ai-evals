+require "test_helper"
+
+class Account::DataTransfer::ImportRelationshipsTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.account = @account
+  end
+
+  test "imported records keep their relationships" do
+    file = export_account(@account)
+    import = Import.create!(identity: identities(:jason), account: @account)
+    import.file.attach(io: file, filename: "export.zip", content_type: "application/zip")
+
+    new_account = Account::DataTransfer::Importer.new(import).import!
+    id = new_account.id
+
+    assert_equal @account.boards.count, Board.where(account_id: id).count
+    assert_equal @account.cards.count, Card.where(account_id: id).count
+
+    Card.where(account_id: id).find_each do |card|
+      assert_not_nil card.board
+      assert_not_nil card.creator
+      assert_equal id, card.board.account_id
+    end
+
+    Event.where(account_id: id).find_each do |event|
+      assert event.eventable.present?, "event #{event.id} lost its eventable"
+      assert event.board.present?
+    end
+
+    Reaction.where(account_id: id).find_each do |reaction|
+      assert reaction.reactable.present?, "reaction #{reaction.id} lost its reactable"
+    end
+
+    Mention.where(account_id: id).find_each do |mention|
+      assert mention.source.present?, "mention #{mention.id} lost its source"
+      assert_not_nil mention.mentionee
+    end
+
+    ActiveStorage::Attachment.where(account_id: id).find_each do |attachment|
+      assert_not_nil attachment.record, "attachment #{attachment.id} lost its record"
+      assert_not_nil attachment.blob
+    end
+
+    ActionText::RichText.where(account_id: id).find_each do |rich_text|
+      assert_not_nil rich_text.record, "rich text #{rich_text.id} lost its record"
+    end
+
+    Entropy.where(account_id: id).find_each do |entropy|
+      assert_not_nil entropy.container, "entropy #{entropy.id} lost its container"
+    end
+
+    Webhook.where(account_id: id).find_each do |webhook|
+      assert_kind_of Array, webhook.subscribed_actions
+      assert webhook.signing_secret.present?
+    end
+
+    Filter.where(account_id: id).find_each do |filter|
+      assert_kind_of Hash, filter.fields
+    end
+  end
+
+  private
+    def export_account(account)
+      file = Tempfile.new([ "export", ".zip" ])
+      file.binmode
+      writer = ZipFile::Writer.new(file)
+      Account::DataTransfer::Manifest.new(account).export_to(writer)
+      writer.close
+      file.rewind
+      file
+    end
+end
