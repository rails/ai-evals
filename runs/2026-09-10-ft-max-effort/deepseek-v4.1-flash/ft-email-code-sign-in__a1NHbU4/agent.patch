index 0000000..9e3f4b9
--- /dev/null
+++ b/app/views/sessions/codes/new.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_code_path, class: "flex flex-column gap-half txt-medium", data: { controller: "code-input" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width center", autofocus: true, autocomplete: "one-time-code", inputmode: "text", maxlength: SignInCode::CODE_LENGTH, placeholder: "Enter your code…", data: { code_input_target: "input", action: "input->code-input#submitWhenComplete" } %>
+      </label>
+    </div>
+
+    <% if @email_address.present? %>
+      <p>We emailed a six-character code to <strong><%= @email_address %></strong>. It expires in fifteen minutes.</p>
+    <% else %>
+      <p>We emailed you a six-character code. It expires in fifteen minutes.</p>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-code-input-target="submit">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
