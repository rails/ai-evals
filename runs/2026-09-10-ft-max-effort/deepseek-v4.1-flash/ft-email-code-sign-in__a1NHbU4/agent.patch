--- /dev/null
+++ b/app/controllers/sessions/codes_controller.rb
@@ -0,0 +1,77 @@
+class Sessions::CodesController < ApplicationController
+  wrap_parameters :session, include: %i[ code ]
+
+  require_unauthenticated_access
+  skip_before_action :require_account
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @email_address = session[:sign_in_email_address]
+  end
+
+  def create
+    if sign_in_code = SignInCode.authenticate(code_param)
+      sign_in_code.consume
+      session.delete(:sign_in_email_address)
+      start_new_session_for sign_in_code.identity
+
+      respond_to do |format|
+        format.html { continue_after_sign_in sign_in_code }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def code_param
+      params[:code].presence || params.dig(:session, :code)
+    end
+
+    def continue_after_sign_in(sign_in_code)
+      identity = sign_in_code.identity
+
+      if join_code = sign_in_code.account_join_code
+        join_account identity, join_code
+      elsif identity.users.none?
+        redirect_to new_signup_completion_path
+      else
+        redirect_to after_authentication_url
+      end
+    end
+
+    def join_account(identity, join_code)
+      join_code.redeem_if { |account| identity.join(account) }
+
+      if user = User.active.find_by(account: join_code.account, identity: identity)
+        if user.setup?
+          redirect_to landing_url(script_name: join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        redirect_to join_path(code: join_code.code, script_name: join_code.account.slug), alert: "That join code is no longer valid."
+      end
+    end
+
+    def invalid_code
+      message = "That code didn’t work. Check the code and try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_code_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_code_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
