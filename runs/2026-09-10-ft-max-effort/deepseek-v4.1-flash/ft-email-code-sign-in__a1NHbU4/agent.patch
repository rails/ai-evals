diff --git a/app/models/sign_in_code.rb b/app/models/sign_in_code.rb
new file mode 100644
index 0000000..6b5f449
--- /dev/null
+++ b/app/models/sign_in_code.rb
@@ -0,0 +1,77 @@
+class SignInCode < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_EXPIRATION = 15.minutes
+  EXPIRATION = CODE_EXPIRATION
+
+  belongs_to :identity
+  belongs_to :account_join_code, class_name: "Account::JoinCode", optional: true
+
+  before_validation :generate_code, on: :create
+  before_validation :set_expiration, on: :create
+
+  validates :code, presence: true, uniqueness: true
+  validates :expires_at, presence: true
+
+  scope :active, -> { where(expires_at: Time.current...) }
+  scope :expired, -> { where(expires_at: ..Time.current) }
+
+  class << self
+    def authenticate(value)
+      code = value.to_s.strip
+      active.find_by(code: [ code, code.upcase ].uniq) if code.present?
+    end
+
+    def generate_for(identity, **attributes)
+      identity.sign_in_codes.create!(**attributes)
+    end
+    alias_method :create_for, :generate_for
+
+    def issue(identity, **attributes)
+      generate_for(identity, **attributes)
+    end
+
+    def cleanup
+      expired.delete_all
+    end
+
+    def consume(value)
+      authenticate(value)&.consume
+    end
+  end
+
+  def join_code
+    account_join_code
+  end
+
+  def join_code=(value)
+    self.account_join_code = value
+  end
+
+  def account
+    account_join_code&.account
+  end
+
+  def active?
+    expires_at.present? && expires_at.future?
+  end
+
+  def expired?
+    !active?
+  end
+
+  def consume
+    destroy! if active?
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = SecureRandom.base58(CODE_LENGTH).upcase
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= CODE_EXPIRATION.from_now
+    end
+end
