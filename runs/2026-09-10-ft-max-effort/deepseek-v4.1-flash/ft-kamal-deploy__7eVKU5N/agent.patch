diff --git a/.kamal/secrets b/.kamal/secrets
new file mode 100644
index 0000000..bba4733
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,20 @@
+# Secrets defined here are available for reference under registry/password,
+# env/secret, builder/secrets, and accessories/*/env/secret in config/deploy.yml.
+# All secrets should be pulled from either a password manager, ENV, or a file.
+# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
+
+# Generate a stable secret key base once and keep it out of git. The file is
+# created the first time Kamal reads these secrets, and reused after that.
+SECRET_KEY_BASE=$(test -s .kamal/secret_key_base && cat .kamal/secret_key_base || (SAAS=false bin/rails secret > .kamal/secret_key_base && cat .kamal/secret_key_base))
+
+# Used when Rails credentials are enabled. It is empty when there is no
+# local config/master.key, which is fine for an ENV-only deployment.
+RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || printenv RAILS_MASTER_KEY 2>/dev/null || true)
+
+# Outbound mail password, if your SMTP server requires authentication.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional browser push notification keys. Generate them with:
+#   bin/rails runner 'vapid_key = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{vapid_key.private_key}"; puts "VAPID_PUBLIC_KEY=#{vapid_key.public_key}"'
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
