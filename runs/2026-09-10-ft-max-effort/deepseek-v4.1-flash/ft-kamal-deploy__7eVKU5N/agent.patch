@@ -31,6 +31,40 @@ Rails.application.configure do
     config.active_storage.service = ENV.fetch("ACTIVE_STORAGE_SERVICE", "local").to_sym
   end
 
+  # The canonical public hostname for this deployment. Set APP_HOST in
+  # config/deploy.yml. This is optional so image builds can precompile assets
+  # without requiring deployment-specific configuration.
+  app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence
+
+  if app_host
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options    = { host: app_host, protocol: "https" }
+
+    config.after_initialize do
+      Rails.application.routes.default_url_options = { host: app_host, protocol: "https" }
+    end
+  end
+
+  # Outbound email. Set SMTP_ADDRESS (and any SMTP_* variables) in
+  # config/deploy.yml. This is optional so image builds don't require mail setup.
+  if ENV["SMTP_ADDRESS"].present?
+    smtp_tls = ENV["SMTP_TLS"].presence
+    smtp_ssl = ENV["SMTP_SSL"].presence
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: ENV["SMTP_DOMAIN"].presence || app_host,
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV["SMTP_AUTHENTICATION"].presence&.to_sym,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", (smtp_tls || smtp_ssl) ? "false" : "true") == "true",
+      tls: smtp_tls == "true" ? true : nil,
+      ssl: smtp_ssl == "true" ? true : nil
+    }.compact
+  end
+
   # Enable serving of images, stylesheets, and JavaScripts from an asset server.
   # config.asset_host = "http://assets.example.com"
 
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..6a464f6
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,110 @@
+# Deploying Fizzy on a single server
+
+Fizzy ships with a [Kamal 2](https://kamal-deploy.org/) configuration for a
+single Linux box. Everything runs in one container:
+
+- Rails/Puma serves the app.
+- Solid Queue runs background jobs inside the Puma process.
+- SQLite stores the primary database, cache, queue, and cable data.
+- Active Storage keeps uploaded files on local disk.
+- `kamal-proxy` terminates HTTPS with an automatic Let's Encrypt certificate.
+
+The whole deployment is packaged in the image, and the data lives in a Docker
+named volume so it survives future deploys.
+
+## Prerequisites
+
+- A Linux server with SSH key access, a public hostname, and ports 80 and 443
+  open. Docker does not need to be installed; `kamal setup` installs it.
+- A DNS `A` (and optionally `AAAA`) record for your hostname pointing at the
+  server.
+- Docker running locally so Kamal can build the image and run its temporary
+  local registry.
+- Ruby and Bundler available locally (`bin/kamal` uses the app's bundle).
+
+## Configure
+
+Edit `config/deploy.yml`:
+
+1. Replace `192.168.0.1` under `servers.web` with your server's IP address or
+   hostname.
+2. Replace every `fizzy.example.com` placeholder with your public hostname.
+   `proxy.host` is used for the HTTPS certificate; `APP_HOST` and `APP_FQDN`
+   are used for links and emails. They must all match.
+3. Replace the `SMTP_*` settings and `MAILER_FROM_ADDRESS` with your mail
+   server details.
+
+The defaults already set `DATABASE_ADAPTER=sqlite`,
+`SOLID_QUEUE_IN_PUMA=true`, and a persistent
+`fizzy_storage:/rails/storage` volume.
+
+## Provide secrets
+
+`.kamal/secrets` is safe to commit because it only contains references to
+environment variables and local files, not raw credentials.
+
+Before running Kamal, export the secrets your mail server needs:
+
+```sh
+export SMTP_PASSWORD="your-smtp-password"
+```
+
+If your SMTP server does not require a password, you can leave it unset.
+
+Browser push notifications are optional. Generate a VAPID key pair and export
+it if you want them:
+
+```sh
+bin/rails runner 'vapid_key = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{vapid_key.private_key}"; puts "VAPID_PUBLIC_KEY=#{vapid_key.public_key}"'
+export VAPID_PRIVATE_KEY="..."
+export VAPID_PUBLIC_KEY="..."
+```
+
+A stable `SECRET_KEY_BASE` is generated the first time Kamal reads
+`.kamal/secrets` and is stored in `.kamal/secret_key_base` (gitignored). Keep
+that file; it is what lets sessions and signed links remain valid between
+deploys.
+
+## Deploy
+
+Bootstrap the server and deploy everything:
+
+```sh
+bin/kamal setup
+```
+
+When it finishes, open `https://your-hostname`. The first request may take a
+few seconds while `kamal-proxy` obtains the certificate.
+
+Future deploys are just:
+
+```sh
+bin/kamal deploy
+```
+
+The `fizzy_storage` volume is reused, so the SQLite databases, queue data, and
+uploaded files are retained.
+
+## Operations
+
+Useful aliases are defined in `config/deploy.yml`:
+
+```sh
+bin/kamal console          # Rails console in the deployed container
+bin/kamal shell            # shell inside the deployed container
+bin/kamal logs             # follow application logs
+bin/kamal dbc              # SQLite console in the deployed container
+```
+
+Background jobs are part of the web container. You can inspect them with
+Mission Control at `/jobs` after signing in as an admin.
+
+## Backups
+
+Because everything lives in the `fizzy_storage` volume, back it up
+periodically. For example, you can copy the SQLite databases and Active
+Storage files from the running container:
+
+```sh
+bin/kamal app exec "tar czf - /rails/storage" > fizzy-storage-backup.tar.gz
+```
