+## Deploying
+
+Fizzy includes a Kamal configuration for running on a single Linux server with
+SQLite and background jobs in one container. See the
+[deployment guide](docs/deployment.md) to get started. In short:
+
+1. Fill in your hostname and mail server settings in `config/deploy.yml`.
+2. Provide your secrets in `.kamal/secrets` (see the guide).
+3. Run `bin/kamal setup`.
+
 ## Contributing
 
 We welcome contributions! Please read our [style guide](STYLE.md) before submitting code.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..691637a
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,104 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. The default local registry means a bare image
+# name is enough. If you push to an external registry, use your-user/fizzy and
+# configure the registry section below.
+image: fizzy
+
+# Deploy to these servers. This is a single-box deployment, so there is one
+# web server and no separate job server.
+servers:
+  web:
+    - 192.168.0.1 # Replace with your server's IP address or hostname.
+
+# Enable SSL auto certification via Let's Encrypt and allow for multiple apps on a
+# single web server. If used with Cloudflare, set encryption mode in SSL/TLS
+# setting to "Full" to enable CF-to-app encryption.
+#
+# Using an SSL proxy like this requires config.assume_ssl and config.force_ssl in
+# production.rb. They are enabled by default for this deployment.
+#
+# Don't use this when deploying to multiple web servers (then you have to
+# terminate SSL at your load balancer).
+proxy:
+  ssl: true
+  host: fizzy.example.com # Replace with your hostname.
+
+# Where you keep your container images.
+registry:
+  # A local registry is managed by Kamal and forwarded to the server over SSH.
+  # This avoids requiring a separate hosted registry for a single-box deploy.
+  server: localhost:5555
+
+  # Needed for authenticated registries.
+  # username: your-user
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Fizzy defaults to SQLite. Keeping this explicit makes the one-box
+    # deployment self-contained: database, cache, queue, and uploads all live
+    # under /rails/storage.
+    DATABASE_ADAPTER: sqlite
+    RAILS_ENV: production
+
+    # Run as the open-source single-box app, and force HTTPS through the proxy.
+    SAAS: false
+    ASSUME_SSL: true
+    FORCE_SSL: true
+
+    # Public hostname used in emails and generated links. Must match proxy.host.
+    # Replace both placeholders with your hostname.
+    APP_HOST: fizzy.example.com
+    APP_FQDN: fizzy.example.com
+
+    # Outbound email. Replace these with your mail server details.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+
+    # Run the Solid Queue supervisor inside the web server's Puma process so
+    # background jobs run on the same box.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Set number of processes dedicated to Solid Queue (default: 1)
+    # JOB_CONCURRENCY: 3
+
+    # Set number of cores available to the application on each server (default: 1).
+    # WEB_CONCURRENCY: 2
+
+    # Log everything from Rails
+    # RAILS_LOG_LEVEL: debug
+  secret:
+    - SECRET_KEY_BASE
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+
+# Use a persistent storage volume for SQLite database files and local Active
+# Storage files. This is what makes your data survive future deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
