@@ -0,0 +1,67 @@
+# Activity
+
+Account activity mirrors the events shown in the timeline. Deprecated
+`card_collection_changed` events are omitted and `card_title_changed` events are
+included.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated, flat list of activity for the boards the current user can
+access, newest first.
+
+__Parameters:__
+
+| Name | Type | Description |
+|------|------|-------------|
+| `creator_ids` | Array | Only return activity created by these users |
+| `board_ids` | Array | Only return activity from these boards |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David assigned JZ to \"The logo isn't big enough\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "https://app.fizzy.do/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohdb",
+      "number": 1,
+      "title": "The logo isn't big enough",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcy",
+      "name": "Fizzy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    }
+  }
+]
+```
+
+`eventable` uses the same representation as the corresponding card or comment
+endpoint, and `board` and `creator` use the same representations as their
+respective endpoints.
+
+For card events `url` points at the card. For comment events `url` points at the
+card where the comment was posted and is anchored to the comment.
+
+`particulars` contains event-specific details, or is empty for other events:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged`, `card_sent_back_to_triage` | `column` |
+
+Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..d05eaca
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns a flat array of accessible activity newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    json = @response.parsed_body
+
+    assert_kind_of Array, json
+    assert json.any?
+
+    created_ats = json.map { |activity| Time.zone.parse(activity["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats, "expected newest activity first"
+  end
+
+  test "index includes card_title_changed but not card_collection_changed" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    title_changed = board.events.create!(action: "card_title_changed", creator: users(:kevin), eventable: card,
+      particulars: { particulars: { old_title: "Old", new_title: "New" } })
+    collection_changed = board.events.create!(action: "card_collection_changed", creator: users(:kevin), eventable: card,
+      particulars: { particulars: { old_collection: "A", new_collection: "B" } })
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    ids = @response.parsed_body.map { |activity| activity["id"] }
+    assert_includes ids, title_changed.id
+    assert_not_includes ids, collection_changed.id
+  end
+
+  test "index includes the expected fields" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.first
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url].sort,
+      activity.keys.sort
+  end
+
+  test "description is returned as plain text" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+  end
+
+  test "card activity url opens the card" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal card_url(event.card), activity["url"]
+  end
+
+  test "comment activity url opens the card and anchors the comment" do
+    event = events(:layout_commented)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+  end
+
+  test "assignment particulars include assignee_ids" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal event.assignee_ids, activity.dig("particulars", "assignee_ids")
+  end
+
+  test "board change particulars include old and new board with empty strings for missing values" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    event = board.events.create!(action: "card_board_changed", creator: users(:kevin), eventable: card,
+      particulars: { particulars: { old_board: "Old board", new_board: "" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_board" => "Old board", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "title change particulars include old and new title" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    event = board.events.create!(action: "card_title_changed", creator: users(:kevin), eventable: card,
+      particulars: { particulars: { old_title: "Old", new_title: "New" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "triage events include column, defaulting to empty string" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    event = board.events.create!(action: "card_sent_back_to_triage", creator: users(:kevin), eventable: card)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "column" => "" }, activity["particulars"])
+  end
+
+  test "other events have empty particulars" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "filters by creator_ids" do
+    david_event = events(:layout_published)
+    kevin_event = events(:text_published)
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+
+    ids = @response.parsed_body.map { |activity| activity["id"] }
+    assert_includes ids, david_event.id
+    assert_not_includes ids, kevin_event.id
+  end
+
+  test "filters by board_ids" do
+    board = boards(:writebook)
+    event = events(:layout_published)
+
+    get activities_path(format: :json), params: { board_ids: [ board.id ] }
+
+    assert_response :success
+    assert_includes @response.parsed_body.map { |a| a["id"] }, event.id
+    assert @response.parsed_body.all? { |a| a.dig("board", "id") == board.id }
+  end
+
+  test "does not return activity from boards the user cannot access" do
+    sign_out
+    sign_in_as :david
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "paginates" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    now = Time.current
+    20.times do |index|
+      board.events.create!(action: "card_published", creator: users(:kevin), eventable: card, created_at: now + index.seconds)
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert @response.headers["Link"].present?
+
+    next_page = @response.headers["Link"].match(/<([^>]+)>;\s*rel="next"/).captures.first
+    get URI.parse(next_page).request_uri, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+end
