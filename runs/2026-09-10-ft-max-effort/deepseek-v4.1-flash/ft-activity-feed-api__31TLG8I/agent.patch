+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+        fresh_when etag: @page.records
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.preloaded.activity
+      events = events.where(board_id: @filter.boards.ids) if params[:board_ids].present?
+      events = events.where(creator_id: @filter.creators.ids) if params[:creator_ids].present?
+      events.order(created_at: :desc, id: :desc)
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..20c6050
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,42 @@
+module ActivitiesHelper
+  # Emits the event-specific details for an activity. Events without any
+  # particulars get an empty object.
+  def activity_particulars(activity)
+    case activity.action
+    when "card_assigned", "card_unassigned"
+      { "assignee_ids" => activity_assignee_ids(activity) }
+    when "card_board_changed"
+      { "old_board" => activity_particular(activity, "old_board"), "new_board" => activity_particular(activity, "new_board") }
+    when "card_title_changed"
+      { "old_title" => activity_particular(activity, "old_title"), "new_title" => activity_particular(activity, "new_title") }
+    when "card_triaged", "card_sent_back_to_triage"
+      { "column" => activity_particular(activity, "column") }
+    else
+      {}
+    end
+  end
+
+  # Card events point at the card. Comment events point at the card where the
+  # comment was posted, anchored to the comment itself.
+  def activity_link_url(activity)
+    if activity.action.comment_created?
+      card_url(activity.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(activity.eventable))
+    else
+      card_url(activity.card)
+    end
+  end
+
+  private
+    def activity_assignee_ids(activity)
+      Array(activity.assignee_ids.presence || activity.particulars.to_h.dig("particulars", "assignee_ids"))
+    end
+
+    # Reads an event-specific detail from the (nested) particulars payload,
+    # returning an empty string when the value is missing.
+    def activity_particular(activity, key)
+      particulars = activity.particulars.to_h
+      value = particulars.dig("particulars", key)
+      value = particulars[key] if value.nil?
+      value.presence || ""
+    end
+end
