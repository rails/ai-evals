diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..2e4eb45 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,33 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  if (!event.data) return
+
+  const { title, options } = event.data.json()
+  const tasks = [ self.registration.showNotification(title, options) ]
+
+  if ("setAppBadge" in self.navigator) {
+    tasks.push(self.navigator.setAppBadge(options.data?.badge || 0))
+  }
+
+  event.waitUntil(Promise.all(tasks))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = new URL(event.notification.data.path, self.location.origin).href
+
+  event.waitUntil((async () => {
+    const clients = await self.clients.matchAll({ type: "window" })
+    const client = clients.find((client) => client.focused)
+
+    if (client) {
+      await client.navigate(url)
+    } else {
+      await self.clients.openWindow(url)
+    }
+  })())
+})
