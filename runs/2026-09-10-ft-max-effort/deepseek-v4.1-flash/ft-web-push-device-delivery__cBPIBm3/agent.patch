diff --git a/app/models/notification_pusher.rb b/app/models/notification_pusher.rb
new file mode 100644
index 0000000..7506916
--- /dev/null
+++ b/app/models/notification_pusher.rb
@@ -0,0 +1,81 @@
+class NotificationPusher
+  include Rails.application.routes.url_helpers
+  include NotificationsHelper
+
+  attr_reader :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def push
+    return unless should_push?
+
+    build_payload.tap do |payload|
+      push_to_user payload
+    end
+  end
+
+  private
+    def should_push?
+      notification.user.push_subscriptions.any? &&
+        !notification.creator.system? &&
+        notification.user.active?
+    end
+
+    def build_payload
+      case notification.source_type
+      when "Event" then build_event_payload
+      when "Mention" then build_mention_payload
+      else build_default_payload
+      end
+    end
+
+    def build_event_payload
+      event = notification.source
+
+      {
+        title: event_notification_title(event),
+        body: event_notification_body(event),
+        path: card_notification_path(notification.card)
+      }
+    end
+
+    def build_mention_payload
+      mention = notification.source
+
+      {
+        title: "#{mention.mentioner.first_name} mentioned you",
+        body: mention.source.mentionable_content.truncate(200),
+        path: card_notification_path(notification.card)
+      }
+    end
+
+    def build_default_payload
+      {
+        title: "New notification",
+        body: "You have a new notification",
+        path: account_prefix + notifications_path
+      }
+    end
+
+    def push_to_user(payload)
+      notification.user.push_subscriptions.find_each do |subscription|
+        deliver payload, subscription
+      end
+    end
+
+    def deliver(payload, subscription)
+      subscription.notification(**payload).deliver
+    rescue WebPush::ExpiredSubscription, OpenSSL::OpenSSLError
+      subscription.destroy
+    end
+
+    def card_notification_path(card)
+      account_prefix + card_path(card)
+    end
+
+    def account_prefix
+      notification.account.slug
+    end
+end
