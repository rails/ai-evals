diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..226c9c6 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,44 @@
 module TimeHelper
+  # Maps the Ruby-side format names used by views to the names the browser
+  # understands. See app/javascript/helpers/date_helpers.js for the formatting
+  # itself.
+  FORMATS = {
+    time: "time",
+    date: "date",
+    date_time: "date-time",
+    weekday: "weekday",
+    time_ago: "time-ago",
+    time_or_date: "time-or-date",
+    date_or_time: "date-or-time"
+  }.freeze
+
+  # Renders a <time> element carrying the raw UTC timestamp. The browser turns
+  # it into words in the viewer's own timezone, so the markup stays the same for
+  # everyone and can be cached and shared.
+  def local_time(time, format = nil, **attributes)
+    return if time.nil?
+
+    format = (attributes.delete(:format) || format || :time_or_date).to_sym
+    value = local_time_value(time)
+
+    attributes[:class] = class_names("local-time-value", attributes[:class])
+    attributes[:datetime] = value
+    attributes[:data] = { local_time_format: local_time_format(format) }.merge(attributes[:data] || {})
+
+    tag.time(value, **attributes)
+  end
+  alias_method :local_time_tag, :local_time
+
+  private
+    def local_time_value(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        time.iso8601
+      end
+    end
+
+    def local_time_format(format)
+      FORMATS.fetch(format) { format.to_s.tr("_", "-") }
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..780a576
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTimeElement, formatLocalTimes, SELECTOR } from "helpers/local_time_helpers"
+
+// Times are rendered by the server as raw timestamps and turned into words here,
+// in the viewer's own timezone. Formatting runs once on connect (full page loads
+// and Turbo navigations) and again whenever new markup is inserted (Turbo Streams
+// and morph refreshes).
+export default class extends Controller {
+  connect() {
+    this.format()
+    this.observer = new MutationObserver((mutations) => this.#mutated(mutations))
+    this.observer.observe(this.element, { childList: true, subtree: true, attributes: true, attributeFilter: [ "datetime" ] })
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+  }
+
+  format() {
+    formatLocalTimes(this.element)
+  }
+
+  #mutated(mutations) {
+    for (const mutation of mutations) {
+      const target = mutation.target.nodeType === Node.ELEMENT_NODE ? mutation.target : mutation.target.parentElement
+
+      if (target) {
+        this.#formatWithin(target)
+      }
+
+      for (const node of mutation.addedNodes) {
+        if (node.nodeType === Node.ELEMENT_NODE) {
+          this.#formatWithin(node)
+        }
+      }
+    }
+  }
+
+  #formatWithin(element) {
+    if (element.matches?.(SELECTOR)) {
+      formatLocalTimeElement(element)
+    }
+
+    element.querySelectorAll?.(SELECTOR).forEach(formatLocalTimeElement)
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..b8339e4 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,122 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+const DAY_IN_MILLISECONDS = 1000 * 60 * 60 * 24
+
+const timeFormatter = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const dateFormatterForDisplay = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const weekdayFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+const dateTimeFormatter = new Intl.DateTimeFormat("en-US", {
+  year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit"
+})
+const relativeFormatter = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+
+// The server sends raw ISO 8601 timestamps. Dates arrive as YYYY-MM-DD and must
+// be read as local calendar days; anything else is a full timestamp.
+export function parseTimestamp(value) {
+  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  }
+
+  return new Date(value)
+}
+
+export function formatTimestamp(date, format) {
+  switch (format) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date)
+    case "date-time":
+      return formatDateTime(date)
+    case "weekday":
+      return formatWeekday(date)
+    case "time-ago":
+      return formatTimeAgo(date)
+    case "date-or-time":
+      return formatDateOrTime(date)
+    case "time-or-date":
+      return formatTimeOrDate(date)
+    default:
+      return formatTimeOrDate(date)
+  }
+}
+
+// "1:42 PM" for today, "yesterday" for yesterday, "5 days ago" earlier in the
+// week, and "Sep 12" further back.
+function formatTimeOrDate(date) {
+  const daysAgo = calendarDaysBetween(date, new Date())
+
+  if (daysAgo <= 0) {
+    return formatTime(date)
+  } else if (daysAgo === 1) {
+    return relativeFormatter.format(-1, "day")
+  } else if (daysAgo < 7) {
+    return relativeFormatter.format(-daysAgo, "day")
+  } else {
+    return formatDate(date)
+  }
+}
+
+// "tomorrow" for tomorrow, "in 3 days" later in the week, and "Sep 12" further
+// ahead.
+function formatDateOrTime(date) {
+  const daysAhead = calendarDaysBetween(new Date(), date)
+
+  if (daysAhead <= 0) {
+    return formatTime(date)
+  } else if (daysAhead === 1) {
+    return relativeFormatter.format(1, "day")
+  } else if (daysAhead < 7) {
+    return relativeFormatter.format(daysAhead, "day")
+  } else {
+    return formatDate(date)
+  }
+}
+
+function formatTimeAgo(date) {
+  const seconds = Math.round((date - new Date()) / 1000)
+  const magnitude = Math.abs(seconds)
+
+  if (magnitude < 45) {
+    return relativeFormatter.format(seconds, "second")
+  } else if (magnitude < 90 * 60) {
+    return relativeFormatter.format(Math.round(seconds / 60), "minute")
+  } else if (magnitude < 22 * 60 * 60) {
+    return relativeFormatter.format(Math.round(seconds / (60 * 60)), "hour")
+  } else if (magnitude < 6 * DAY_IN_MILLISECONDS / 1000) {
+    return relativeFormatter.format(Math.round(seconds / (60 * 60 * 24)), "day")
+  } else if (magnitude < 30 * DAY_IN_MILLISECONDS / 1000) {
+    return relativeFormatter.format(Math.round(seconds / (60 * 60 * 24 * 7)), "week")
+  } else if (magnitude < 365 * DAY_IN_MILLISECONDS / 1000) {
+    return relativeFormatter.format(Math.round(seconds / (60 * 60 * 24 * 30)), "month")
+  } else {
+    return relativeFormatter.format(Math.round(seconds / (60 * 60 * 24 * 365)), "year")
+  }
+}
+
+function formatTime(date) {
+  return timeFormatter.format(date)
+}
+
+function formatDate(date) {
+  return dateFormatterForDisplay.format(date)
+}
+
+function formatWeekday(date) {
+  return weekdayFormatter.format(date)
+}
+
+function formatDateTime(date) {
+  return dateTimeFormatter.format(date)
+}
+
+function calendarDaysBetween(from, to) {
+  return Math.round((beginningOfLocalDay(to) - beginningOfLocalDay(from)) / DAY_IN_MILLISECONDS)
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..d2e4197
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,19 @@
+import { formatTimestamp, parseTimestamp } from "helpers/date_helpers"
+
+export const SELECTOR = "time[data-local-time-format]"
+
+export function formatLocalTimes(root = document) {
+  root.querySelectorAll(SELECTOR).forEach(formatLocalTimeElement)
+}
+
+export function formatLocalTimeElement(element) {
+  const value = element.getAttribute("datetime")
+
+  if (value) {
+    const text = formatTimestamp(parseTimestamp(value), element.dataset.localTimeFormat)
+
+    if (element.textContent !== text) {
+      element.textContent = text
+    }
+  }
+}
