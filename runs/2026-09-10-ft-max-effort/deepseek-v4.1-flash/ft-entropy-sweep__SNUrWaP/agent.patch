diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..93585bb 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,9 +24,40 @@ module Card::Entropic
   end
 
   class_methods do
+    # The sweep runs hourly across every account. A single global query can't
+    # use the cards index — its leading column is account_id — so it degrades
+    # into a full scan of the cards table. On installs with hundreds of
+    # thousands of cards that scan no longer fits in the hour.
+    #
+    # Instead we walk accounts and, within each, group boards by their
+    # effective entropy period. Comparing last_active_at against a constant
+    # per query lets the (account_id, last_active_at, status) index drive a
+    # range scan, so we only visit cards that are actually due.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      Account.find_each do |account|
+        auto_postpone_due_for(account)
+      end
+    end
+
+    def auto_postpone_due_for(account)
+      boards_by_period = account.boards.includes(:entropy).group_by { |board| board.entropy&.auto_postpone_period }
+
+      boards_by_period.each do |period, boards|
+        next if period.nil?
+
+        # Resolve the user lazily: not every account is guaranteed to have a
+        # system user, and the original sweep only looked one up once it found
+        # a card that was actually due.
+        system_user = nil
+
+        account.cards
+          .active
+          .where(board_id: boards.map(&:id))
+          .where(last_active_at: ..period.seconds.ago)
+          .find_each do |card|
+            system_user ||= account.system_user
+            card.auto_postpone(user: system_user)
+          end
       end
     end
   end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..29171ea 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -69,6 +69,36 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not_includes Card.postponing_soon, cards(:shipping)
   end
 
+  test "auto postpone all due respects a board period shorter than the account default" do
+    board = boards(:writebook).account.boards.create!(name: "Fast board", creator: users(:david))
+    board.auto_postpone_period = 7.days
+
+    due_card = board.cards.create!(creator: users(:david), title: "Due card", status: :published, last_active_at: 10.days.ago)
+    safe_card = board.cards.create!(creator: users(:david), title: "Safe card", status: :published, last_active_at: 5.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert due_card.reload.postponed?
+    assert_not safe_card.reload.postponed?
+  end
+
+  test "auto postpone all due does not postpone cards before their board's longer period" do
+    private_card = boards(:private).cards.create!(creator: users(:david), title: "Private card", status: :published)
+    private_card.update!(last_active_at: 45.days.ago)
+
+    # writebook overrides the account default with a 90 day period
+    cards(:logo).update!(last_active_at: 45.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert private_card.reload.postponed?
+    assert_not cards(:logo).reload.postponed?
+  end
+
   test "auto postpone all due works properly cross-account" do
     cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
     cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 2.days)
