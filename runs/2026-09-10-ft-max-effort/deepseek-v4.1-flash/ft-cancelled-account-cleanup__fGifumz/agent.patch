diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..ba844b8 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,59 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineratable, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineratable.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    transaction do
+      filter_ids = Filter.where(account_id: id).pluck(:id)
+      board_ids = Board.where(account_id: id).pluck(:id)
+
+      Account::DataTransfer::Manifest.new(self).each_record_set(&:delete)
+      delete_remaining_records
+      delete_storage_ledger(board_ids)
+      delete_filter_join_records(filter_ids)
+      delete if persisted?
+    end
+  end
+
+  private
+    def delete_remaining_records
+      delete_records_for Account::Cancellation, Account::Import, Account::JoinCode,
+        Export, Push::Subscription, Search::Query, ActiveStorage::Attachment,
+        ActiveStorage::Blob
+
+      Search::Record.for(id).where(account_id: id).destroy_all
+    end
+
+    def delete_records_for(*models)
+      models.each do |model|
+        model.where(account_id: id).delete_all
+      end
+    end
+
+    def delete_storage_ledger(board_ids)
+      Storage::Entry.where(account_id: id).delete_all
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+    end
+
+    def delete_filter_join_records(filter_ids)
+      return if filter_ids.empty?
+
+      quoted_ids = filter_ids.map { |filter_id| self.class.connection.quote(filter_id) }.join(",")
+
+      %w[ assignees_filters assigners_filters boards_filters creators_filters closers_filters filters_tags ].each do |table|
+        self.class.connection.delete("DELETE FROM #{self.class.connection.quote_table_name(table)} WHERE filter_id IN (#{quoted_ids})")
+      end
+    end
 end
