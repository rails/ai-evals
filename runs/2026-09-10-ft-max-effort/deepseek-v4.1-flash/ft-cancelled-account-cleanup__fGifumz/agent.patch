diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8041ca3
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    account = accounts("initech")
+    account.cancel(initiated_by: users("mike"))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_equal 0, Board.where(account_id: account.id).count
+  end
+
+  test "does not incinerate accounts cancelled within the grace period" do
+    account = accounts("initech")
+    account.cancel(initiated_by: users("mike"))
+    account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "does not incinerate active or reactivated accounts" do
+    cancelled = accounts("acme")
+    cancelled.cancel(initiated_by: users("mike"))
+    cancelled.cancellation.update!(created_at: 31.days.ago)
+    cancelled.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(cancelled.id)
+  end
+
+  test "incinerates due accounts without relying on Current.account" do
+    account = accounts("initech")
+    account.cancel(initiated_by: users("mike"))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      perform_enqueued_jobs do
+        Account::IncinerateDueJob.perform_later
+      end
+    end
+
+    assert_not Account.exists?(account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..ab57cb1
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("initech")
+    @user = users("mike")
+  end
+
+  test "incineratable includes only accounts cancelled beyond the grace period" do
+    due = @account
+    due.cancel(initiated_by: @user)
+    due.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+
+    recent = accounts("acme")
+    recent.cancel(initiated_by: @user)
+    recent.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.day)
+
+    assert_includes Account.incineratable, due
+    assert_not_includes Account.incineratable, recent
+    assert_not_includes Account.incineratable, accounts("37s")
+  end
+
+  test "incinerate_due incinerates every due account" do
+    due_accounts = [ @account, accounts("acme") ]
+
+    due_accounts.each do |account|
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    end
+
+    assert_difference -> { Account.count }, -2 do
+      Account.incinerate_due
+    end
+
+    due_accounts.each { |account| assert_not Account.exists?(account.id) }
+  end
+
+  test "incinerate permanently removes the account and all of its data" do
+    account_id = @account.id
+
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+    [ Board, Card, Column, Comment, Event, User, Access, Tag, Notification,
+      Account::Cancellation, Account::JoinCode ].each do |model|
+      assert_equal 0, model.where(account_id: account_id).count, "#{model} still has records"
+    end
+  end
+
+  test "incinerate removes derived records that have no dependent callbacks" do
+    account_id = @account.id
+    board = @account.boards.first
+    user = @account.users.first
+
+    Storage::Entry.record(account: @account, board: board, delta: 100, operation: "attach")
+    Search::Query.create!(account_id: account_id, user_id: user.id, terms: "hello")
+
+    @account.incinerate
+
+    assert_equal 0, Storage::Entry.where(account_id: account_id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: account_id).count
+    assert_equal 0, Search::Query.where(account_id: account_id).count
+  end
+
+  test "incinerate leaves other accounts and identities untouched" do
+    identity_count = Identity.count
+    other_account_id = accounts("37s").id
+
+    @account.incinerate
+
+    assert_equal identity_count, Identity.count
+    assert Account.exists?(other_account_id)
+    assert Board.where(account_id: other_account_id).any?
+  end
+end
