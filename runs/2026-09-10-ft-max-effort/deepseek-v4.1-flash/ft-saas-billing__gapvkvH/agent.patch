diff --git a/saas/app/controllers/account/billing_controller.rb b/saas/app/controllers/account/billing_controller.rb
new file mode 100644
index 0000000..4d7b12b
--- /dev/null
+++ b/saas/app/controllers/account/billing_controller.rb
@@ -0,0 +1,44 @@
+class Account::BillingController < ApplicationController
+  before_action :ensure_admin
+
+  def checkout
+    plan_key = params[:plan].presence || params[:plan_key].presence || "MonthlyV1"
+    plan = Subscription.find(plan_key)
+
+    if plan.blank?
+      redirect_to account_settings_path, alert: "Unknown plan" and return
+    end
+
+    session = Stripe::Checkout::Session.create(
+      mode: "subscription",
+      line_items: line_items_for(plan),
+      client_reference_id: Current.account.id,
+      customer_email: Current.user.identity.email_address,
+      subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan.short_name } },
+      success_url: account_settings_url,
+      cancel_url: account_settings_url
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  def portal
+    subscription = Current.account.subscription
+
+    if subscription&.stripe_customer_id.blank?
+      redirect_to account_settings_path, alert: "No subscription to manage" and return
+    end
+
+    session = Stripe::BillingPortal::Session.create(
+      customer: subscription.stripe_customer_id,
+      return_url: account_settings_url
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def line_items_for(plan)
+      plan.stripe_price_ids.map { |price| { price: price, quantity: 1 } }
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..20c4588
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,43 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+    @account = account
+  end
+
+  def comp
+    account.comped = true
+    redirect_to saas.admin_account_path(account), notice: "Account comped"
+  end
+
+  def uncomp
+    account.comped = false
+    redirect_to saas.admin_account_path(account), notice: "Account uncomped"
+  end
+
+  def override
+    overridden_limit = account.overridden_limit || account.build_overridden_limit
+    overridden_limit.update!(override_params)
+    redirect_to saas.admin_account_path(account), notice: "Override saved"
+  end
+
+  def reset
+    account.overridden_limit&.destroy!
+    redirect_to saas.admin_account_path(account), notice: "Override reset"
+  end
+
+  private
+    def account
+      @account ||= Account.find(params[:id])
+    end
+
+    def override_params
+      sources = [ params, params[:overridden_limit], params[:account_overridden_limit] ]
+      permitted = sources.compact.map { |source| source.permit(:card_count, :bytes_used) }.find(&:present?)
+      permitted || {}
+    end
+end
