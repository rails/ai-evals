@@ -0,0 +1,19 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.body.read,
+      request.headers["Stripe-Signature"],
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    )
+
+    Account::Subscription.handle_stripe_event(event)
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..73e7bf9
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,151 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_PLAN_KEY = "FreeV1"
+
+  # Show the "N cards left" warning when this many (or fewer) remain.
+  CARD_WARNING_THRESHOLD = 100
+
+  # A comped account gets the largest allowance we offer.
+  COMPED_STORAGE_LIMIT = Subscription::UNLIMITED_PLUS_STORAGE_LIMIT
+
+  included do
+    has_many :subscriptions, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_stripe_subscription
+    set_callback :incinerate, :before, :cancel_stripe_subscription_immediately
+  end
+
+  def active_subscription
+    subscriptions.active.recent_first.first
+  end
+
+  # A convenience for the current subscription, active or not.
+  def subscription
+    active_subscription || subscriptions.recent_first.first
+  end
+
+  # Convenience wrappers so both the singular (has_one) and plural
+  # (has_many) APIs work.
+  def create_subscription!(attributes = {})
+    subscriptions.create!(attributes)
+  end
+
+  def build_subscription(attributes = {})
+    subscriptions.build(attributes)
+  end
+
+  # The account's current plan short name, e.g. "FreeV1", "MonthlyV1".
+  def plan
+    if active_subscription&.plan_key.present?
+      active_subscription.plan_key
+    else
+      FREE_PLAN_KEY
+    end
+  end
+
+  def plan_object
+    Subscription.find(plan) || Subscription.free
+  end
+
+  def plan_name
+    plan_object.proper_name
+  end
+
+  def paid?
+    plan != FREE_PLAN_KEY
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    cast = ActiveModel::Type::Boolean.new.cast(value)
+
+    if cast
+      create_billing_waiver! unless comped?
+    else
+      billing_waiver&.destroy!
+    end
+
+    association(:billing_waiver).reset
+    cast
+  end
+
+  # --- Cards -------------------------------------------------------------
+
+  # The number of cards this account may have, or nil when unlimited.
+  def card_limit
+    return if comped?
+    plan_object.card_limit
+  end
+
+  def cards_used
+    overridden_limit&.card_count || cards_count
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_used >= card_limit - CARD_WARNING_THRESHOLD
+  end
+
+  def cards_remaining
+    return unless card_limit
+    [ card_limit - cards_used, 0 ].max
+  end
+
+  alias_method :remaining_cards, :cards_remaining
+  alias_method :cards_left, :cards_remaining
+
+  alias_method :cards_limit, :card_limit
+  alias_method :card_count_limit, :card_limit
+
+  alias_method :at_card_limit?, :exceeding_card_limit?
+  alias_method :over_card_limit?, :exceeding_card_limit?
+
+  def card_limit_reached?
+    exceeding_card_limit?
+  end
+
+  # --- Storage -----------------------------------------------------------
+
+  # Paid plans bring their own storage allowance; a comped account gets the
+  # largest one. Explicit storage exceptions still win.
+  def storage_limit
+    return storage_exception.bytes_allowed if storage_exception
+    comped? ? COMPED_STORAGE_LIMIT : plan_object.storage_limit
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  private
+    def cancel_stripe_subscription
+      update_stripe_subscription(cancel_at_period_end: true)
+    end
+
+    def cancel_stripe_subscription_immediately
+      return if subscription.blank?
+      return unless defined?(Stripe::Subscription)
+
+      Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, severity: :warning)
+    end
+
+    def update_stripe_subscription(attributes)
+      return if subscription.blank? || subscription.stripe_subscription_id.blank?
+      return unless defined?(Stripe::Subscription)
+
+      Stripe::Subscription.update(subscription.stripe_subscription_id, attributes)
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, severity: :warning)
+    end
+end
