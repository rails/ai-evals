@@ -0,0 +1,67 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to "Accounts", saas.admin_accounts_path %> / <%= @account.name %>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <dl class="flex flex-column gap-half">
+      <div>
+        <dt class="txt-x-small txt-ink-medium">Name</dt>
+        <dd><strong><%= @account.name %></strong></dd>
+      </div>
+      <div>
+        <dt class="txt-x-small txt-ink-medium">Queenbee ID</dt>
+        <dd>#<%= @account.external_account_id %></dd>
+      </div>
+      <div>
+        <dt class="txt-x-small txt-ink-medium">Plan</dt>
+        <dd><%= @account.plan_name %><%= " (comped)" if @account.comped? %></dd>
+      </div>
+      <div>
+        <dt class="txt-x-small txt-ink-medium">Cards</dt>
+        <dd><%= number_with_delimiter(@account.cards_used) %></dd>
+      </div>
+      <div>
+        <dt class="txt-x-small txt-ink-medium">Bytes used</dt>
+        <dd><%= number_with_delimiter(@account.bytes_used) %></dd>
+      </div>
+    </dl>
+
+    <div class="flex gap-half margin-block-start">
+      <%= button_to "Comp", saas.comp_admin_account_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :delete, class: "btn" %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override</h2>
+    </header>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :patch, scope: :overridden_limit, class: "flex flex-column gap-half" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count", class: "txt-x-small txt-ink-medium" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input", min: 0 %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used", class: "txt-x-small txt-ink-medium" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input", min: 0 %>
+      </div>
+
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <div class="margin-block-start">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :delete, class: "btn btn--negative" %>
+    </div>
+  </div>
+</section>
