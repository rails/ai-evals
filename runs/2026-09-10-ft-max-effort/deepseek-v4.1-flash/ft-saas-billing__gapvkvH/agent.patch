diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..75421c0
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,42 @@
+#!/usr/bin/env ruby
+#
+# Fetches Stripe credentials from 1Password for development and starts the
+# Stripe CLI listener forwarding webhooks to the local app.
+#
+# Usage:
+#   eval "$(BUNDLE_GEMFILE=Gemfile.saas bundle exec stripe-dev)"
+#   bin/dev
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+STRIPE_ENV = ENV.fetch("STRIPE_ENV", "Development")
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/#{STRIPE_ENV}/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+fields = %w[
+  STRIPE_SECRET_KEY
+  STRIPE_WEBHOOK_SECRET
+  STRIPE_MONTHLY_V1_PRICE_ID
+  STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID
+]
+
+values = fields.to_h { |field| [ field, op_read(field) ] }
+
+if values.any? { |_, value| value.empty? }
+  warn "Error: Could not fetch Stripe credentials from 1Password"
+  warn "Make sure you're signed in: op signin --account #{OP_ACCOUNT}"
+  exit 1
+end
+
+values.each do |field, value|
+  puts %Q(export #{field}="#{value}")
+end
+
+puts %Q(stripe listen --forward-to localhost:3000/stripe/webhooks >/tmp/stripe-listen.log 2>&1 &)
+
+warn ""
+warn "Stripe credentials loaded for development"
+warn "  Webhooks forwarding to /stripe/webhooks"
