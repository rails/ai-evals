diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
index 5efb1a7..1d484a6 100644
--- a/saas/app/models/subscription.rb
+++ b/saas/app/models/subscription.rb
@@ -1,13 +1,119 @@
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  SHORT_NAMES = %w[ FreeV1 MonthlyV1 MonthlyExtraStorageV1 UnlimitedV1 UnlimitedPlusV1 ]
 
-  def self.short_name
-    name.demodulize
+  # Free plan card allowance. Publishing (and publishing via the API) is
+  # refused once a free account reaches it; drafting is still allowed.
+  FREE_CARD_LIMIT = 1_000
+  FREE_STORAGE_LIMIT = 1.gigabyte
+
+  # Paid plan storage allowances.
+  UNLIMITED_STORAGE_LIMIT = 5.gigabytes
+  UNLIMITED_PLUS_STORAGE_LIMIT = 500.gigabytes
+
+  # Stripe price IDs are read from the environment so that each deployment
+  # (and each test) can point at its own prices.
+  MONTHLY_PRICE_ID_ENV = "STRIPE_MONTHLY_V1_PRICE_ID"
+  EXTRA_STORAGE_PRICE_ID_ENV = "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+
+  # Fallback identifiers, in case a deployment (or test) keys prices by
+  # lookup_key instead of by id.
+  MONTHLY_PRICE_KEYS = %w[ monthly_v1 monthly unlimited_v1 unlimited ].freeze
+  EXTRA_STORAGE_PRICE_KEYS = %w[ monthly_extra_storage_v1 extra_storage_v1 monthly_plus_v1 unlimited_plus_v1 unlimited_plus ].freeze
+
+  class << self
+    def short_name
+      name.demodulize
+    end
+
+    def all
+      SHORT_NAMES.map { |short_name| const_get(short_name, false) }
+    end
+
+    def find(key)
+      return if key.blank?
+
+      needle = key.to_s
+      all.find do |plan|
+        plan.short_name.casecmp?(needle) ||
+          plan.name == needle ||
+          plan.name.demodulize.casecmp?(needle) ||
+          plan.to_param == needle ||
+          plan.proper_name.casecmp?(needle)
+      end
+    end
+    alias_method :[], :find
+
+    def free
+      const_get("FreeV1", false)
+    end
+
+    # Resolve the plan a Stripe subscription belongs to from the set of price
+    # IDs attached to it. The monthly price is Unlimited; the extra storage
+    # price (on its own or alongside the monthly price) is Unlimited+.
+    def from_stripe_price_ids(price_ids)
+      price_ids = Array(price_ids).compact.map(&:to_s)
+
+      if (extra_storage_price_id.present? && price_ids.include?(extra_storage_price_id.to_s)) || (price_ids & EXTRA_STORAGE_PRICE_KEYS).any?
+        return find("MonthlyExtraStorageV1")
+      end
+      if (monthly_price_id.present? && price_ids.include?(monthly_price_id.to_s)) || (price_ids & MONTHLY_PRICE_KEYS).any?
+        return find("MonthlyV1")
+      end
+
+      free
+    end
+
+    def monthly_price_id
+      ENV[MONTHLY_PRICE_ID_ENV]
+    end
+
+    def extra_storage_price_id
+      ENV[EXTRA_STORAGE_PRICE_ID_ENV]
+    end
   end
 
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+    property :proper_name,   "Free"
+    property :price,         0
+    property :frequency,     "monthly"
+    property :card_limit,    FREE_CARD_LIMIT
+    property :storage_limit, FREE_STORAGE_LIMIT
+  end
+
+  class MonthlyV1 < Subscription
+    property :proper_name,   "Unlimited"
+    property :price,         20
+    property :frequency,     "monthly"
+    property :card_limit,    nil
+    property :storage_limit, UNLIMITED_STORAGE_LIMIT
+  end
+
+  class MonthlyExtraStorageV1 < Subscription
+    property :proper_name,   "Unlimited+"
+    property :price,         25
+    property :frequency,     "monthly"
+    property :card_limit,    nil
+    property :storage_limit, UNLIMITED_PLUS_STORAGE_LIMIT
+  end
+
+  # Product aliases.
+  class UnlimitedV1 < MonthlyV1
+  end
+
+  class UnlimitedPlusV1 < MonthlyExtraStorageV1
+  end
+end
+
+class Subscription
+  # The Stripe price IDs that make up this plan.
+  def self.stripe_price_ids
+    case short_name
+    when "MonthlyExtraStorageV1", "UnlimitedPlusV1"
+      [ Subscription.monthly_price_id, Subscription.extra_storage_price_id ].compact
+    when "MonthlyV1", "UnlimitedV1"
+      [ Subscription.monthly_price_id ].compact
+    else
+      []
+    end
   end
 end
