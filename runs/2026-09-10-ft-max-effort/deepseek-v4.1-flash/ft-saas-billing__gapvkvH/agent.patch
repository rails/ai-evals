@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @monthly_price_id = "price_monthly_v1"
+    @extra_price_id = "price_extra_storage_v1"
+    @previous_monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    @previous_extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @monthly_price_id
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = @extra_price_id
+  end
+
+  teardown do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @previous_monthly
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = @previous_extra
+  end
+
+  test "a created subscription assigns the plan" do
+    post_event subscription_event("customer.subscription.created", [ @monthly_price_id ])
+
+    assert_response :success
+    assert_equal "MonthlyV1", @account.reload.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "adding extra storage upgrades to unlimited plus" do
+    post_event subscription_event("customer.subscription.updated", [ @monthly_price_id, @extra_price_id ])
+
+    assert_equal "MonthlyExtraStorageV1", @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "a deleted subscription returns the account to free" do
+    @account.create_subscription!(
+      plan_key: "MonthlyV1", stripe_subscription_id: "sub_123", stripe_customer_id: "cus_123"
+    )
+
+    post_event subscription_event("customer.subscription.deleted", [ @monthly_price_id ], id: "sub_123", customer: "cus_123")
+
+    assert_nil @account.reload.subscription
+    assert_equal "FreeV1", @account.plan
+  end
+
+  private
+    def post_event(event)
+      Stripe::Webhook.stubs(:construct_event).returns(event)
+      untenanted do
+        post saas.stripe_webhooks_path, params: event.to_json, headers: { "Stripe-Signature" => "test" }
+      end
+    end
+
+    def subscription_event(type, price_ids, id: "sub_new", customer: "cus_new")
+      Stripe::Event.construct_from(
+        id: "evt_1",
+        type: type,
+        data: {
+          object: {
+            id: id,
+            customer: customer,
+            status: "active",
+            current_period_end: 1.month.from_now.to_i,
+            metadata: { account_id: @account.id },
+            items: { data: price_ids.map { |price_id| { price: { id: price_id } } } }
+          }
+        }
+      )
+    end
+end
+
+class Stripe::WebhooksLookupKeyTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "prices may be identified by lookup key" do
+    event = Stripe::Event.construct_from(
+      id: "evt_lookup",
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_lookup",
+          customer: "cus_lookup",
+          status: "active",
+          metadata: { account_id: @account.id },
+          items: { data: [ { price: { id: "price_unknown", lookup_key: "monthly_v1" } } ] }
+        }
+      }
+    )
+
+    Stripe::Webhook.stubs(:construct_event).returns(event)
+    untenanted { post saas.stripe_webhooks_path, params: event.to_json, headers: { "Stripe-Signature" => "test" } }
+
+    assert_response :success
+    assert_equal "MonthlyV1", @account.reload.plan
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..64e6982
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "defaults to the free plan" do
+    assert_equal "FreeV1", @account.plan
+    assert_equal "Free", @account.plan_name
+    assert_not @account.paid?
+  end
+
+  test "free plan card and storage limits" do
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid plan comes from the subscription" do
+    @account.create_subscription!(plan_key: "UnlimitedV1")
+
+    assert_equal "UnlimitedV1", @account.reload.plan
+    assert_equal "Unlimited", @account.plan_name
+    assert @account.paid?
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "unlimited plus brings a larger storage allowance" do
+    @account.create_subscription!(plan_key: "UnlimitedPlusV1")
+
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "exceeding card limit" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "nearing card limit counts down" do
+    @account.update_column(:cards_count, 900)
+
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 100, @account.cards_remaining
+  end
+
+  test "well under card limit" do
+    @account.update_column(:cards_count, 800)
+
+    assert_not @account.nearing_card_limit?
+    assert_equal 200, @account.cards_remaining
+  end
+
+  test "comped accounts have no card limit and a large storage allowance" do
+    @account.comped = true
+
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_equal Subscription::UNLIMITED_PLUS_STORAGE_LIMIT, @account.storage_limit
+
+    @account.comped = false
+    assert_not @account.comped?
+  end
+
+  test "overridden limits replace used counts" do
+    @account.update_column(:cards_count, 10)
+    @account.create_overridden_limit!(card_count: 12, bytes_used: 345)
+
+    assert_equal 12, @account.cards_used
+    assert_equal 345, @account.bytes_used
+  end
+
+  test "a storage exception still wins over the plan allowance" do
+    @account.create_subscription!(plan_key: "UnlimitedV1")
+    @account.add_storage_exception(7.gigabytes)
+
+    assert_equal 7.gigabytes, @account.reload.storage_limit
+  end
+end
+
+class Account::BillingSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "active_subscription prefers an active subscription" do
+    @account.create_subscription!(plan_key: "MonthlyV1", status: "active")
+    @account.create_subscription!(plan_key: "FreeV1", status: "canceled")
+
+    assert_equal "MonthlyV1", @account.reload.active_subscription.plan_key
+    assert_equal "MonthlyV1", @account.plan
+  end
+
+  test "plan falls back to free when the subscription is canceled" do
+    @account.create_subscription!(plan_key: "MonthlyV1", status: "canceled")
