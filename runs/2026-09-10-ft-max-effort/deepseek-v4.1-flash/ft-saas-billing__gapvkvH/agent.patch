diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..01eb058
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,132 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+  validates :stripe_customer_id, uniqueness: true, allow_nil: true
+
+  scope :active, -> { where(status: ACTIVE_STATUSES).or(where(status: nil)) }
+  scope :recent_first, -> { order(created_at: :desc) }
+
+  class << self
+    # Apply a Stripe event to the local subscription records. Kept here (rather
+    # than in the controller) so it can be exercised without a web request.
+    def handle_stripe_event(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated"
+        sync_from_stripe(event.data.object)
+      when "customer.subscription.deleted"
+        delete_from_stripe(event.data.object)
+      when "checkout.session.completed"
+        remember_customer(event.data.object)
+      end
+    end
+
+    def sync_from_stripe(stripe_subscription)
+      account = account_for(stripe_subscription)
+      return unless account
+
+      plan = Subscription.from_stripe_price_ids(price_ids_from(stripe_subscription))
+      plan_key = metadata_for(stripe_subscription)["plan_key"].presence || plan&.short_name
+
+      customer = value_for(stripe_subscription, :customer)
+      record = account.subscriptions.find_by(stripe_subscription_id: value_for(stripe_subscription, :id)) ||
+        account.subscriptions.find_by(stripe_customer_id: customer) ||
+        account.active_subscription ||
+        account.subscriptions.build
+      record.stripe_subscription_id = value_for(stripe_subscription, :id)
+      record.stripe_customer_id = customer
+      record.plan_key = plan_key
+      record.status = value_for(stripe_subscription, :status)
+      record.current_period_end = timestamp(value_for(stripe_subscription, :current_period_end))
+      record.cancel_at = timestamp(value_for(stripe_subscription, :cancel_at))
+      record.save!
+      reset_subscriptions(account)
+      record
+    end
+
+    def delete_from_stripe(stripe_subscription)
+      record = find_by(stripe_subscription_id: value_for(stripe_subscription, :id)) ||
+        find_by(stripe_customer_id: value_for(stripe_subscription, :customer))
+      reset_subscriptions(record.account) if record
+      record&.destroy!
+      record
+    end
+
+    def remember_customer(checkout_session)
+      account_id = value_for(checkout_session, :client_reference_id).presence ||
+        metadata_for(checkout_session)["account_id"]
+      account = Account.find_by(id: account_id) if account_id.present?
+      customer = value_for(checkout_session, :customer)
+      return unless account && customer.present?
+
+      record = account.subscriptions.find_by(stripe_customer_id: customer) ||
+        account.active_subscription ||
+        account.subscriptions.build
+      record.stripe_customer_id = customer
+      record.save!
+      reset_subscriptions(account)
+      record
+    end
+
+    private
+      def account_for(stripe_subscription)
+        account_id = metadata_for(stripe_subscription)["account_id"]
+        return Account.find_by(id: account_id) if account_id.present?
+
+        find_by(stripe_subscription_id: value_for(stripe_subscription, :id))&.account ||
+          find_by(stripe_customer_id: value_for(stripe_subscription, :customer))&.account
+      end
+
+      def price_ids_from(stripe_subscription)
+        items = value_for(stripe_subscription, :items)
+        data = value_for(items, :data) || []
+        Array(data).flat_map do |item|
+          price = value_for(item, :price)
+          [ value_for(price, :id), value_for(price, :lookup_key) ].compact
+        end
+      end
+
+      def metadata_for(object)
+        metadata = value_for(object, :metadata)
+        return {}.with_indifferent_access if metadata.blank?
+
+        if metadata.respond_to?(:with_indifferent_access)
+          metadata.with_indifferent_access
+        else
+          metadata
+        end
+      end
+
+      def value_for(object, key)
+        return if object.blank?
+
+        if object.respond_to?(key)
+          object.public_send(key)
+        elsif object.respond_to?(:[])
+          object[key] || object[key.to_s]
+        end
+      end
+
+      def timestamp(value)
+        Time.zone.at(value) if value.present?
+      end
+
+      def reset_subscriptions(account)
+        account.subscriptions.reset if account.subscriptions.loaded?
+      end
+  end
+
+  def active?
+    status.blank? || ACTIVE_STATUSES.include?(status)
+  end
+
+  def plan
+    Subscription.find(plan_key) || Subscription.free
+  end
+
+  def cancel_at_period_end?
+    cancel_at.present?
+  end
+end
