+  private
+    def perform_request
+      uri = URI.parse(webhook.url)
+
+      update! request: { headers: request_headers }
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |name, value| request[name] = value }
+      request.body = payload
+
+      response = http_for(uri).request(request)
+
+      { code: response.code.to_i, headers: response.to_hash }
+    end
+
+    def http_for(uri)
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+
+        # Pin the connection to a resolved public address when possible so the
+        # receiver can't be swapped out underneath us (DNS rebinding). If the
+        # host doesn't resolve to a public address we fall back to the host.
+        if ip_address = SsrfProtection.resolve_public_ip(uri.host)
+          http.ipaddr = ip_address
+        end
+      end
+    end
+
+    def payload
+      @payload ||= ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: [ :json ]
+      )
+    end
+
+    def request_headers
+      @request_headers ||= {
+        "Content-Type" => "application/json",
+        "User-Agent" => USER_AGENT,
+        TIMESTAMP_HEADER => event.created_at.utc.iso8601(3),
+        SIGNATURE_HEADER => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
