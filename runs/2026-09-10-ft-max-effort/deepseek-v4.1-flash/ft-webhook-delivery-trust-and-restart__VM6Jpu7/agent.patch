+  # Each delivery is attempted once: the state guard makes sure that a job that
+  # runs twice doesn't post the same event to the receiver twice.
+  def deliver
+    with_lock do
+      return unless pending?
+      in_progress!
+    end
+
+    response = perform_request
+
+    update! state: :completed, response: response
+
+    if succeeded?
+      webhook.delinquency_tracker.record_success
+    else
+      webhook.delinquency_tracker.record_failure
+    end
+  rescue StandardError
