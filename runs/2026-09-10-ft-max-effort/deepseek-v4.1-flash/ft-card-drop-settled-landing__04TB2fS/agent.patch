diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..448de4d
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,154 @@
+import { Controller } from "@hotwired/stimulus"
+import { put } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const CARD_SELECTOR = "article.card"
+const COLUMN_SELECTOR = ".cards"
+const LIST_SELECTOR = ".cards__list"
+const MOBILE_QUERY = "(max-width: 639px)"
+
+export default class extends Controller {
+  connect() {
+    this.cardObserver = new MutationObserver(() => this.#enableCards())
+    this.cardObserver.observe(this.element, { childList: true, subtree: true })
+    this.#enableCards()
+  }
+
+  disconnect() {
+    this.cardObserver.disconnect()
+  }
+
+  // Actions
+
+  dragStart(event) {
+    const card = event.target.closest(CARD_SELECTOR)
+    if (!card || !this.#canDrag) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(COLUMN_SELECTOR)
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragOver(event) {
+    const column = this.#columnFor(event)
+    if (!column || !this.#canDropOn(column)) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(column)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFor(event)
+    if (!column) return
+    if (event.relatedTarget && column.contains(event.relatedTarget)) return
+
+    column.classList.remove(HOVER_CONTAINER_CLASS)
+  }
+
+  drop(event) {
+    const column = this.#columnFor(event)
+    if (!column || !this.#canDropOn(column)) return
+
+    event.preventDefault()
+    event.stopPropagation()
+
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    // Move the card immediately so the board is already how the person left it.
+    this.#moveCard(card, column)
+    this.#save(card, column, sourceColumn)
+
+    this.#reset()
+  }
+
+  dragEnd() {
+    this.#reset()
+  }
+
+  // Private
+
+  get #canDrag() {
+    return !window.matchMedia(MOBILE_QUERY).matches
+  }
+
+  #columnFor(event) {
+    return event.target.closest(COLUMN_SELECTOR)
+  }
+
+  #canDropOn(column) {
+    return this.draggedCard && column && column !== this.sourceColumn
+  }
+
+  #highlight(column) {
+    this.element.querySelectorAll(`.${HOVER_CONTAINER_CLASS}`).forEach(container => {
+      if (container !== column) container.classList.remove(HOVER_CONTAINER_CLASS)
+    })
+
+    column.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #moveCard(card, column) {
+    const list = column.querySelector(LIST_SELECTOR)
+    if (!list) return
+
+    // Put the card exactly where the server will keep it, so nothing shifts
+    // once the save lands. Golden cards stay ahead of the rest.
+    const container = list.querySelector(CARD_SELECTOR)?.parentElement || list
+    const goldenCards = [ ...container.querySelectorAll(`${CARD_SELECTOR}.golden-effect`) ]
+
+    if (card.classList.contains("golden-effect")) {
+      container.prepend(card)
+    } else if (goldenCards.length > 0) {
+      goldenCards[goldenCards.length - 1].after(card)
+    } else {
+      container.prepend(card)
+    }
+  }
+
+  async #save(card, column, sourceColumn) {
+    const url = card.dataset.cardDragUrl
+    if (!url) return
+
+    try {
+      const response = await put(url, {
+        body: { column_id: column.dataset.columnId },
+        responseKind: "json"
+      })
+
+      if (!response.ok) throw new Error(`Move failed with status ${response.statusCode}`)
+    } catch (error) {
+      // Put the card back if the move didn't stick.
+      sourceColumn?.querySelector(LIST_SELECTOR)?.prepend(card)
+    }
+  }
+
+  #reset() {
+    this.draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.sourceColumn?.classList.remove(HOVER_CONTAINER_CLASS)
+
+    this.element.querySelectorAll(`.${HOVER_CONTAINER_CLASS}`).forEach(container => {
+      container.classList.remove(HOVER_CONTAINER_CLASS)
+    })
+
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  #enableCards() {
+    this.element.querySelectorAll(CARD_SELECTOR).forEach(card => {
+      if (this.#canDrag) {
+        card.setAttribute("draggable", "true")
+      } else {
+        card.removeAttribute("draggable")
+      }
+    })
+  }
+}
