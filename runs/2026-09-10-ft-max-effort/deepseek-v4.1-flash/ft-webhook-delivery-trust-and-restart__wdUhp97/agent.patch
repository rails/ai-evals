@@ -0,0 +1,17 @@
+require "test_helper"
+
+class Webhook::DeliveryCleanupTest < ActiveSupport::TestCase
+  test "cleanup deletes deliveries older than a week" do
+    assert Webhook::Delivery.exists?(webhook_deliveries(:successfully_completed).id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:errored).id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:unsuccessfully_completed).id)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(webhook_deliveries(:successfully_completed).id)
+    assert_not Webhook::Delivery.exists?(webhook_deliveries(:errored).id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:unsuccessfully_completed).id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:pending).id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:in_progress).id)
+  end
+end
