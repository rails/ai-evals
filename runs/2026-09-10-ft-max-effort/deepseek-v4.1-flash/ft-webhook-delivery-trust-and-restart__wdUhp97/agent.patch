     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +52,93 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      with_lock do
+        pending? && in_progress!
+      end
+    end
+
+    def perform
+      update!(request: { headers: headers })
+
+      response = post
+
+      update!(state: :completed, response: response_details(response))
+      webhook.record_delivery(self)
+    rescue => error
+      update!(state: :errored, response: { error: error_name(error) })
+      webhook.record_delivery(self)
+    end
+
+    def post
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      http.start { |connection| connection.request(http_request) }
+    end
+
+    def http_request
+      Net::HTTP::Post.new(uri).tap do |request|
+        headers.each { |name, value| request[name] = value }
+        request.body = payload
+      end
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def payload
+      @payload ||= if webhook.for_slack?
+        { text: chat_message }.to_json
+      elsif webhook.for_campfire?
+        { message: { content: chat_message } }.to_json
+      elsif webhook.for_basecamp?
+        { content: chat_message }.to_json
+      else
+        event_payload
+      end
+    end
+
+    def event_payload
+      renderer.render(template: "webhooks/event", assigns: { event: event }, formats: :json)
+    end
+
+    def renderer
+      WebhooksController.renderer.new(script_name: account.slug)
+    end
+
+    def chat_message
+      event.description_for(event.creator).to_plain_text
+    end
+
+    def response_details(response)
+      { code: response.code.to_i, headers: response.to_hash }
+    end
+
+    def error_name(error)
+      case error
+      when Timeout::Error, SocketError, SystemCallError, OpenSSL::SSL::SSLError
+        DESTINATION_UNREACHABLE
+      else
+        error.class.name
+      end
+    end
 end
