@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  setup do
+    Current.account = accounts("37s")
+    @board = boards(:writebook)
+    @webhook = webhooks(:active)
+    @card = cards(:logo)
+    @creator = users(:david)
+  end
+
+  test "creates a delivery for each subscribed webhook when an event happens" do
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      create_event("card_published")
+    end
+
+    assert_equal @webhook, Webhook::Delivery.last.webhook
+  end
+
+  test "does not create a delivery for an action the webhook is not subscribed to" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      create_event("card_triaged")
+    end
+  end
+
+  test "does not create a delivery for an inactive webhook" do
+    @webhook.deactivate
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      create_event("card_published")
+    end
+  end
+
+  test "suppress does not notify recipients" do
+    assert_no_enqueued_jobs only: NotifyRecipientsJob do
+      Event.suppress { create_event("card_published") }
+    end
+  end
+
+  test "suppress does not create deliveries" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      Event.suppress { create_event("card_published") }
+    end
+  end
+
+  private
+    def create_event(action)
+      Event.create!(board: @board, creator: @creator, eventable: @card, action: action)
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..5f944e9
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "is created with the webhook" do
+    webhook = Webhook.create!(board: boards(:writebook), name: "Test", url: "https://example.com/webhook")
+
+    assert_not_nil webhook.delinquency_tracker
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "can be found or created by webhook id" do
+    Webhook::DelinquencyTracker.where(webhook_id: @webhook.id).delete_all
+
+    tracker = Webhook::DelinquencyTracker.find_or_create_by!(webhook_id: @webhook.id)
+
+    assert_equal @webhook.account_id, tracker.account_id
+  end
+
+  test "deactivates the webhook after ten consecutive failures within an hour" do
+    assert @webhook.active?
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      10.times { @tracker.record_failure }
+    end
+
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+  end
+
+  test "does not deactivate when the failures span more than an hour" do
+    9.times { @tracker.record_failure }
+
+    travel 61.minutes
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  test "a success resets the streak" do
+    5.times { @tracker.record_failure }
+    assert_equal 5, @tracker.reload.consecutive_failures_count
+
+    @tracker.record_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
