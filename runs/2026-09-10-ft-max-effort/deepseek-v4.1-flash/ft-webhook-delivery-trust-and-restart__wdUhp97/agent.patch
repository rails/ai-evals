--- /dev/null
+++ b/app/models/event/webhookable.rb
@@ -0,0 +1,38 @@
+module Event::Webhookable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :deliver_to_webhooks
+  end
+
+  class_methods do
+    # Suppresses side effects (notifications and webhook deliveries) triggered
+    # while importing data, so we don't spam receivers for records that are
+    # being copied verbatim.
+    def suppress
+      previous = suppressed?
+      self.suppressed = true
+      yield
+    ensure
+      self.suppressed = previous
+    end
+
+    def suppressed?
+      !!ActiveSupport::IsolatedExecutionState[:suppress_events]
+    end
+    alias_method :suppress?, :suppressed?
+
+    def suppressed=(value)
+      ActiveSupport::IsolatedExecutionState[:suppress_events] = value
+    end
+  end
+
+  private
+    def deliver_to_webhooks
+      return if self.class.suppressed?
+
+      board.webhooks.active.subscribed_to(action).find_each do |webhook|
+        webhook.deliver(self)
+      end
+    end
+end
