index 0000000..720cbc1
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    Current.account = accounts("37s")
+    @webhook = webhooks(:active)
+    @event = events(:shipping_closed)
+  end
+
+  test "is queued on the webhooks queue" do
+    assert_equal "webhooks", Webhook::DeliveryJob.new.queue_name
+  end
+
+  test "posts the event and records a successful delivery" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "OK")
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.completed?
+    assert delivery.succeeded?
+    assert_not delivery.failed?
+
+    assert_requested(:post, @webhook.url) do |request|
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal "fizzy/1.0.0 Webhook", request.headers["User-Agent"]
+      assert_equal @event.created_at.utc.iso8601, request.headers["X-Webhook-Timestamp"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+
+      body = JSON.parse(request.body)
+      assert_equal @event.id, body["id"]
+      assert_equal @event.action, body["action"]
+      assert_equal @event.eventable.id, body.dig("eventable", "id")
+      assert_includes body.dig("eventable", "url"), @webhook.account.slug
+    end
+  end
+
+  test "records a failed delivery for a non successful response" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_nil delivery.response[:error]
+  end
+
+  test "records an errored delivery when the request cannot be made" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_timeout
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "does not deliver the same delivery twice" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested :post, @webhook.url, times: 1
+  end
+end
diff --git a/test/models/event/webhookable_test.rb b/test/models/event/webhookable_test.rb
