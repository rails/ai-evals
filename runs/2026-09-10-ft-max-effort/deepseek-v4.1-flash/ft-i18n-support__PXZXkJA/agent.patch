new file mode 100644
index 0000000..f2d7cff
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,31 @@
+// Minimal client-side translations for strings that are produced in JavaScript.
+// The server writes the active locale onto <html lang>, so we follow it here.
+const TRANSLATIONS = {
+  ja: {
+    "Are you sure?": "本当によろしいですか？",
+    "Please fill out this field": "この項目を入力してください",
+    "No selection": "未選択",
+    "Stalled for": "停滞期間",
+    "days": "日",
+    "Less than a minute ago": "1分未満前",
+    "Back to %{label}": "%{label}に戻る",
+    "Passkeys are not supported by this browser": "このブラウザはパスキーに対応していません",
+    "Missing passkey options": "パスキーの設定が見つかりません",
+    "Passkey ceremony failed": "パスキーの認証に失敗しました",
+    "Missing passkey challenge URL": "パスキーのチャレンジURLが見つかりません",
+    "Failed to refresh challenge": "チャレンジの更新に失敗しました"
+  }
+}
+
+export function currentLocale() {
+  return (document.documentElement.getAttribute("lang") || "en").split("-")[0]
+}
+
+export function t(key, params = {}) {
+  const message = TRANSLATIONS[currentLocale()]?.[key] ?? key
+
+  return Object.entries(params).reduce(
+    (result, [name, value]) => result.split(`%{${name}}`).join(String(value)),
+    message
+  )
+}
