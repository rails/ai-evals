diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..05464fd 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,24 @@
 module TimeHelper
+  # Renders a <time> element with the raw timestamp. The browser fills in the
+  # human-readable text (see app/javascript/controllers/local_time_controller.js),
+  # so cached HTML never has a timezone baked into it.
+  def local_time(time, format: :relative, **options)
+    tag.time(
+      class: token_list("local-time-value", options.delete(:class)),
+      datetime: time.utc.iso8601,
+      data: { controller: "local-time", local_time_format_value: format },
+      **options
+    )
+  end
+
+  # Counts elapsed time ("2 hours ago", "yesterday", "5 days ago") or, for
+  # timestamps older than a week, shows the date.
+  def local_time_ago(time, **options)
+    local_time(time, format: :ago, **options)
+  end
+
+  # Shows a short date such as "Sep 12".
+  def local_date(time, **options)
+    local_time(time, format: :date, **options)
+  end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..5ecdf67
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,84 @@
+import { Controller } from "@hotwired/stimulus"
+
+const RELATIVE_FORMATTER = new Intl.RelativeTimeFormat("en", { numeric: "auto" })
+const DATE_FORMATTER = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const DATE_WITH_YEAR_FORMATTER = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const TIME_FORMATTER = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const WEEKDAY_DATE_FORMATTER = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+const SHORT_DATE_TIME_FORMATTER = new Intl.DateTimeFormat("en-US", { year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit" })
+
+const MILLISECONDS_PER_DAY = 1000 * 60 * 60 * 24
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    const date = new Date(this.element.getAttribute("datetime"))
+
+    if (!isNaN(date)) {
+      this.element.textContent = this.#format(date)
+    }
+  }
+
+  #format(date) {
+    switch (this.formatValue) {
+      case "ago":
+        return this.#timeAgo(date)
+      case "date":
+        return DATE_FORMATTER.format(date)
+      case "date_with_year":
+        return DATE_WITH_YEAR_FORMATTER.format(date)
+      case "time":
+        return TIME_FORMATTER.format(date)
+      case "weekday_date":
+        return WEEKDAY_DATE_FORMATTER.format(date)
+      case "short_date_time":
+        return SHORT_DATE_TIME_FORMATTER.format(date)
+      default:
+        return this.#relative(date)
+    }
+  }
+
+  // Today shows the clock time; yesterday and tomorrow use words; the rest of
+  // the week counts days; anything older reads as a short date.
+  #relative(date) {
+    const days = this.#calendarDaysFromToday(date)
+
+    if (days === 0) {
+      return TIME_FORMATTER.format(date)
+    } else if (Math.abs(days) < 7) {
+      return RELATIVE_FORMATTER.format(days, "day")
+    } else {
+      return DATE_FORMATTER.format(date)
+    }
+  }
+
+  // Counts elapsed time for timestamps on the same day, then switches to
+  // calendar days so a card closing overnight reads "tomorrow" rather than
+  // "in 24 hours".
+  #timeAgo(date) {
+    const days = this.#calendarDaysFromToday(date)
+
+    if (days !== 0) {
+      return Math.abs(days) < 7 ? RELATIVE_FORMATTER.format(days, "day") : DATE_FORMATTER.format(date)
+    }
+
+    const seconds = Math.round((date - new Date()) / 1000)
+
+    if (Math.abs(seconds) < 45) {
+      return RELATIVE_FORMATTER.format(0, "second")
+    } else if (Math.abs(seconds) < 45 * 60) {
+      return RELATIVE_FORMATTER.format(Math.round(seconds / 60), "minute")
+    } else {
+      return RELATIVE_FORMATTER.format(Math.round(seconds / 3600), "hour")
+    }
+  }
+
+  #calendarDaysFromToday(date) {
+    const today = new Date()
+    const from = Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+    const to = Date.UTC(today.getFullYear(), today.getMonth(), today.getDate())
+
+    return Math.round((from - to) / MILLISECONDS_PER_DAY)
+  }
+}
