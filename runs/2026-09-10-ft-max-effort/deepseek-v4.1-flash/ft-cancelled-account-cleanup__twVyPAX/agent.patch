diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..f8217f7
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts that have been cancelled for more than 30 days" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+  end
+
+  test "leaves recently cancelled accounts alone" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 29.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..0703cf9
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerate_due incinerates accounts cancelled more than 30 days ago" do
+    cancel @account, at: 31.days.ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "incinerate_due ignores accounts cancelled within the grace period" do
+    cancel @account, at: 29.days.ago
+
+    assert_no_difference -> { Account.count } do
+      Account.incinerate_due
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate_due ignores active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account.incinerate_due
+    end
+  end
+
+  test "incineratable only includes accounts past the grace period" do
+    due = accounts(:initech)
+    recent = accounts(:acme)
+
+    cancel due, at: 31.days.ago
+    cancel recent, at: 29.days.ago
+
+    assert_includes Account.incineratable, due
+    assert_not_includes Account.incineratable, recent
+    assert_not_includes Account.incineratable, @account
+  end
+
+  test "incinerate permanently removes the account and all of its data" do
+    board = boards(:writebook)
+    card = board.cards.create!(title: "Doomed", creator: @user)
+    card.image.attach io: File.open(Rails.root.join("test/fixtures/files/avatar.png"), "rb"),
+      filename: "image.png", content_type: "image/png"
+    Storage::Entry.record(account: @account, board: board, delta: 1024, operation: "attach")
+
+    id = @account.id
+    @account.incinerate
+
+    assert_not Account.exists?(id)
+    assert_equal 0, Board.where(account_id: id).count
+    assert_equal 0, Card.where(account_id: id).count
+    assert_equal 0, User.where(account_id: id).count
+    assert_equal 0, Storage::Entry.where(account_id: id).count
+    assert_equal 0, ActiveStorage::Attachment.where(account_id: id).count
+    assert_equal 0, ActiveStorage::Blob.where(account_id: id).count
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: at)
+    end
+end
