diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..d4fa788
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,51 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  TOKEN_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(public_key: [ nil, "" ]).or(where.not(published_at: nil)) }
+  end
+
+  def publish
+    transaction do
+      update! \
+        public_key: public_key.presence || generate_public_key,
+        published_at: published_at.presence || Time.current
+    end
+  end
+
+  def unpublish
+    update! public_key: nil, published_at: nil
+  end
+
+  def published?
+    public_key.present? || published_at.present?
+  end
+
+  def public?
+    published?
+  end
+
+  def public_url
+    if public_key.present?
+      if Current.request_base_url.present?
+        URI.join(Current.request_base_url, public_board_path(public_key, script_name: nil)).to_s
+      else
+        public_board_path(public_key, script_name: nil)
+      end
+    end
+  end
+
+  private
+    def generate_public_key
+      loop do
+        candidate = SecureRandom.base58(TOKEN_LENGTH)
+        break candidate unless self.class.exists?(public_key: candidate)
+      end
+    end
+
+    def public_board_path(*)
+      Rails.application.routes.url_helpers.public_board_path(*)
+    end
+end
