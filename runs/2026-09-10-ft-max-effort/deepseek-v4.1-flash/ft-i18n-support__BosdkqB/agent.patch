diff --git a/app/controllers/concerns/localizable.rb b/app/controllers/concerns/localizable.rb
new file mode 100644
index 0000000..4cc4ba0
--- /dev/null
+++ b/app/controllers/concerns/localizable.rb
@@ -0,0 +1,55 @@
+# Resolves the locale for each request and keeps the user's choice sticky.
+#
+# The locale can be chosen explicitly with `?locale=ja`. A supported choice is
+# remembered in the session and, when the person is signed in, persisted on
+# their identity so it survives signing in again from a clean browser. Unknown
+# locales are ignored and never raise.
+module Localizable
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[ en ja ].freeze
+
+  # Normalizes a locale-ish value to a supported symbol, or nil when it isn't
+  # one we offer.
+  def self.normalize_locale(value)
+    value = value.to_s.downcase
+    return if value.blank?
+
+    # Accept "ja" as well as a regional variant like "ja-JP".
+    candidate = value.split("-", 2).first
+    candidate.to_sym if SUPPORTED_LOCALES.include?(candidate)
+  end
+
+  included do
+    prepend_before_action :remember_requested_locale
+    before_action :persist_requested_locale
+    around_action :switch_locale
+    helper_method :current_locale
+  end
+
+  private
+    def remember_requested_locale
+      if requested_locale = Localizable.normalize_locale(params[:locale])
+        @explicit_locale = requested_locale
+        session[:locale] = requested_locale.to_s
+      end
+    end
+
+    def persist_requested_locale
+      return if @explicit_locale.blank? || Current.identity.blank?
+      return if Current.identity.locale == @explicit_locale.to_s
+
+      Current.identity.update_column(:locale, @explicit_locale.to_s)
+    end
+
+    def switch_locale(&block)
+      I18n.with_locale(current_locale, &block)
+    end
+
+    def current_locale
+      Localizable.normalize_locale(params[:locale]) ||
+        Localizable.normalize_locale(session[:locale]) ||
+        Localizable.normalize_locale(Current.identity&.locale) ||
+        I18n.default_locale
+    end
+end
