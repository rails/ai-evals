diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..14c638a
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,162 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "locale param switches to Japanese" do
+    untenanted do
+      get new_session_url(locale: :ja)
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "メインコンテンツへスキップ", response.body
+  end
+
+  test "regional and uppercase locale variants are accepted" do
+    untenanted do
+      get new_session_url(locale: "ja-JP")
+      assert_select "html[lang=ja]"
+
+      get new_session_url(locale: "JA")
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "unknown locale is ignored" do
+    untenanted do
+      get new_session_url(locale: :xx)
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_no_match "メインコンテンツへスキップ", response.body
+  end
+
+  test "malformed locale params never break a page" do
+    untenanted do
+      get new_session_url(locale: "")
+      assert_response :success
+
+      get new_session_url(locale: "ja; drop table users")
+      assert_response :success
+      assert_select "html[lang=en]"
+
+      get new_session_url("locale[]": "ja")
+      assert_response :success
+    end
+  end
+
+  test "locale choice sticks for the session" do
+    untenanted do
+      get new_session_url(locale: :ja)
+      get new_session_url
+    end
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "locale can be switched back to English" do
+    untenanted do
+      get new_session_url(locale: :ja)
+      get new_session_url(locale: :en)
+    end
+
+    assert_select "html[lang=en]"
+    assert_match "Skip to main content", response.body
+  end
+
+  test "chosen locale is persisted on the identity when signed in" do
+    sign_in_as :kevin
+
+    get root_url(locale: :ja)
+
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "identity locale is applied after signing in from a clean browser" do
+    identities(:kevin).update!(locale: "ja")
+
+    sign_in_as :kevin
+
+    get root_url
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "signed in home page renders Japanese content" do
+    identities(:kevin).update!(locale: "ja")
+    sign_in_as :kevin
+
+    get root_url
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "アクティビティ", response.body
+    assert_match(/追加しました|割り当てました|コメントしました/, response.body)
+  end
+
+  test "magic link email is rendered in the identity locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    perform_enqueued_jobs { identity.send_magic_link }
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match(/確認コード/, email.subject)
+    assert_match(/確認コード/, email.html_part.decoded)
+  end
+
+  test "default stays English" do
+    identities(:kevin).update!(locale: nil)
+    sign_in_as :kevin
+
+    get root_url
+
+    assert_select "html[lang=en]"
+    assert_match "Skip to main content", response.body
+  end
+
+  test "dates are localized" do
+    assert_equal "2026年07月10日(金)", I18n.l(Date.new(2026, 7, 10), format: :long, locale: :ja)
+    assert_equal "2026/07/10", I18n.l(Date.new(2026, 7, 10), format: :default, locale: :ja)
+  end
+
+  test "static error pages contain both languages" do
+    %w[400 404 406-unsupported-browser 422 500].each do |file|
+      html = File.read(Rails.root.join("public", "#{file}.html"))
+      assert_match "Back home", html, "#{file} should include English"
+      assert_match "ホームに戻る", html, "#{file} should include Japanese"
+      assert_match 'lang="ja"', html, "#{file} should mark Japanese text"
+    end
+  end
+
+  test "available locales are limited to English and Japanese" do
+    assert_equal [ :en, :ja ], I18n.available_locales.sort
+    assert_equal :en, I18n.default_locale
+  end
+
+  test "japanese translations mirror the english key structure" do
+    en = flatten_keys(YAML.load_file(Rails.root.join("config/locales/en.yml"))["en"])
+    ja = flatten_keys(YAML.load_file(Rails.root.join("config/locales/ja.yml"))["ja"])
+
+    assert_equal en.sort, ja.sort
+  end
+
+  test "notification settings page is localized" do
+    identities(:kevin).update!(locale: "ja")
+    sign_in_as :kevin
+
+    get notifications_settings_path
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "通知設定", response.body
+  end
+
+  private
+    def flatten_keys(object, prefix = [])
+      return [ prefix.join(".") ] unless object.is_a?(Hash)
+
+      object.flat_map { |key, value| flatten_keys(value, prefix + [ key ]) }
+    end
+end
