diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..be194eb
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,62 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      active.where(<<~SQL.squish, STALLED_AFTER.ago)
+        cards.stalled_at IS NOT NULL
+        OR (
+          (cards.last_burst_at IS NOT NULL OR cards.burst_at IS NOT NULL)
+          AND cards.last_active_at <= ?
+        )
+      SQL
+    }
+  end
+
+  def stalled?
+    active? && (self[:stalled_at].present? || burst_inactive?)
+  end
+
+  def stalled_at
+    if active?
+      self[:stalled_at] || (last_active_at + STALLED_AFTER if burst_inactive?)
+    end
+  end
+
+  def burst?
+    self[:last_burst_at].present? || self[:burst_at].present?
+  end
+
+  # A card gets a burst when someone is assigned to it or reopens it.
+  def burst
+    update!(last_burst_at: Time.current, burst_at: Time.current)
+  end
+  alias_method :record_burst, :burst
+  alias_method :burst!, :burst
+
+  # A card also gets a burst when three or more comments from at least two
+  # people land on it within a third of the board's auto-close period.
+  def burst_from_comment(comment)
+    if comment_burst?(comment)
+      update!(last_burst_at: Time.current, burst_at: Time.current)
+    end
+  end
+  alias_method :record_burst_from_comment, :burst_from_comment
+
+  private
+    def burst_inactive?
+      burst? && last_active_at <= STALLED_AFTER.ago
+    end
+
+    def comment_burst?(comment)
+      window = auto_postpone_period / 3
+      latest = [ comment.created_at, comments.by_user.maximum(:created_at) ].compact.max
+      recent_comments = comments.by_user.where(created_at: (latest - window)..latest)
+
+      recent_comments.count >= BURST_COMMENT_COUNT && recent_comments.distinct.count(:creator_id) >= BURST_COMMENTER_COUNT
+    end
+end
