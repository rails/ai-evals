diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..a616d60 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,19 @@
 module TimeHelper
+  # Renders a <time> element carrying only the raw UTC timestamp. The browser
+  # turns it into words in the viewer's own timezone, so cached HTML stays
+  # shareable between viewers.
+  def local_time(time, format: :words, **options)
+    time = time.to_time if time.is_a?(Date)
+
+    tag.time time.utc.iso8601,
+      datetime: time.utc.iso8601,
+      data: { local_time_target: "time", local_time_format: format },
+      **options
+  end
+
+  def time_ago_tag(time, **options)
+    local_time(time, format: :words, **options)
+  end
+  alias_method :relative_time_tag, :time_ago_tag
+  alias_method :local_time_tag, :local_time
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..8114363
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,19 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime } from "helpers/date_helpers"
+
+// Renders <time> elements in the viewer's own timezone. The server only sends
+// the raw timestamp; this controller turns it into words once the page loads
+// (and again for time elements added by Turbo streams).
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  timeTargetConnected(element) {
+    const datetime = element.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (Number.isNaN(date.getTime())) return
+
+    element.textContent = formatDateTime(date, element.dataset.localTimeFormat)
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..0584a51 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,72 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+// Formats a timestamp in the viewer's own timezone. `format` selects the
+// wording: "words" (default) produces relative words such as "1:42 PM",
+// "yesterday", "5 days ago", "Sep 12", "tomorrow" or "in 3 days".
+export function formatDateTime(date, format = "words") {
+  switch (format) {
+    case "date": return formatMonthDay(date)
+    case "time": return formatClockTime(date)
+    case "weekday": return formatWeekday(date)
+    case "datetime": return formatNumericDateTime(date)
+    default: return formatWords(date)
+  }
+}
+
+export function formatWords(date, now = new Date()) {
+  const dayDifference = signedDifferenceInLocalDays(now, date)
+
+  if (dayDifference === 0) return formatClockTime(date)
+  if (dayDifference === -1) return "yesterday"
+  if (dayDifference === 1) return "tomorrow"
+  if (dayDifference < -1 && dayDifference > -7) return `${-dayDifference} days ago`
+  if (dayDifference > 1 && dayDifference < 7) return `in ${dayDifference} days`
+
+  return formatMonthDay(date)
+}
+
+export function formatClockTime(date) {
+  return normalizeSpaces(new Intl.DateTimeFormat("en-US", {
+    hour: "numeric",
+    minute: "2-digit"
+  }).format(date))
+}
+
+export function formatMonthDay(date) {
+  return normalizeSpaces(new Intl.DateTimeFormat("en-US", {
+    month: "short",
+    day: "numeric"
+  }).format(date))
+}
+
+function formatWeekday(date) {
+  return normalizeSpaces(new Intl.DateTimeFormat("en-US", {
+    weekday: "long",
+    month: "long",
+    day: "numeric"
+  }).format(date))
+}
+
+function formatNumericDateTime(date) {
+  const datePart = new Intl.DateTimeFormat("en-US", {
+    month: "numeric",
+    day: "numeric",
+    year: "2-digit"
+  }).format(date)
+
+  return `${datePart}, ${formatClockTime(date)}`
+}
+
+function signedDifferenceInLocalDays(fromDate, toDate) {
+  return Math.round((beginningOfLocalDay(toDate) - beginningOfLocalDay(fromDate)) / (1000 * 60 * 60 * 24))
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function normalizeSpaces(string) {
+  return string.replace(/[\u00a0\u202f]/g, " ")
+}
