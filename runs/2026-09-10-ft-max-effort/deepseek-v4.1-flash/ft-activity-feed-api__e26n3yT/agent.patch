+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "returns a flat list of activity, newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    events = @response.parsed_body
+    assert_kind_of Array, events
+    assert_equal 11, events.size
+
+    created_at = events.map { |event| event["created_at"] }
+    assert_equal created_at.sort.reverse, created_at
+  end
+
+  test "exposes the documented fields for each event" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.first
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url].sort, event.keys.sort
+  end
+
+  test "uses the existing API representations for eventable, board and creator" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_published" }
+    assert_equal "Card", event["eventable_type"]
+    assert_equal %w[assignees board closed column comments_url created_at creator description description_html golden has_attachments has_more_assignees id image_url last_active_at number postponed reactions_url status tags title url].sort, event["eventable"].keys.sort
+    assert_equal %w[all_access auto_postpone_period_in_days created_at creator id name url].sort, event["board"].keys.sort
+    assert_equal %w[active avatar_url created_at email_address id name role url].sort, event["creator"].keys.sort
+  end
+
+  test "returns the plain text description" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:logo_published).id }
+    assert_equal "David added &quot;The logo isn&#39;t big enough&quot;", event["description"]
+  end
+
+  test "card event urls open the card" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:logo_published).id }
+    assert_equal card_url(cards(:logo)), event["url"]
+  end
+
+  test "comment event urls open the card and jump to the comment" do
+    get activities_path(format: :json)
+
+    comment = comments(:layout_overflowing_david)
+    event = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+  end
+
+  test "omits deprecated card_collection_changed events" do
+    events(:logo_published).update!(action: "card_collection_changed")
+
+    get activities_path(format: :json)
+
+    assert_not_includes @response.parsed_body.map { |e| e["action"] }, "card_collection_changed"
+  end
+
+  test "includes card_title_changed events with old and new titles" do
+    events(:logo_published).update!(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, event["particulars"])
+  end
+
+  test "assignment events include assignee ids" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:logo_assignment_jz).id }
+    assert_equal [ users(:jz).id ], event["particulars"]["assignee_ids"]
+  end
+
+  test "board change events include old and new boards" do
+    events(:logo_published).update!(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old Board", "new_board" => "New Board" } })
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "Old Board", "new_board" => "New Board" }, event["particulars"])
+  end
+
+  test "board change events return empty strings for missing boards" do
+    events(:logo_published).update!(action: "card_board_changed", particulars: {})
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "", "new_board" => "" }, event["particulars"])
+  end
+
+  test "title change events return empty strings for missing titles" do
+    events(:logo_published).update!(action: "card_title_changed", particulars: {})
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "", "new_title" => "" }, event["particulars"])
+  end
+
+  test "triage events include the column" do
+    events(:logo_published).update!(action: "card_triaged", particulars: { "particulars" => { "column" => "In Progress" } })
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_triaged" }
+    assert_equal({ "column" => "In Progress" }, event["particulars"])
+  end
+
+  test "sent back to triage events include an empty column" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:buy_domain_sent_back_to_triage).id }
+    assert_equal({ "column" => "" }, event["particulars"])
+  end
+
+  test "other events have empty particulars" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:logo_published).id }
+    assert_equal({}, event["particulars"])
+  end
+
+  test "filters by creator ids" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    assert_equal 3, @response.parsed_body.size
+    @response.parsed_body.each do |event|
+      assert_equal users(:kevin).id, event["creator"]["id"]
+    end
+  end
+
+  test "filters by board ids" do
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ])
+
+    assert_equal 11, @response.parsed_body.size
+    @response.parsed_body.each do |event|
+      assert_equal boards(:writebook).id, event["board"]["id"]
+    end
+  end
+
+  test "does not return activity from boards the user cannot access" do
+    logout_and_sign_in_as :david
+    events(:logo_published).update!(board: boards(:private))
+
+    get activities_path(format: :json)
+
+    assert_not_includes @response.parsed_body.map { |e| e["id"] }, events(:logo_published).id
+  end
+
+  test "filters out boards the user cannot access" do
+    logout_and_sign_in_as :david
+    events(:logo_published).update!(board: boards(:private))
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+
+    assert_equal [], @response.parsed_body
+  end
+
+  test "can be consumed with a bearer token" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+
+  test "paginates activity" do
+    now = Time.current
+    5.times do |i|
+      Event.create!(board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo), action: "card_published", created_at: now + i.minutes)
+    end
+
+    get activities_path(format: :json)
+
+    assert_equal 15, @response.parsed_body.size
+    assert response.headers["Link"].present?
+
+    get activities_path(format: :json, page: 2)
+
+    assert_equal 1, @response.parsed_body.size
+  end
+
+  test "sets the pagination headers" do
+    get activities_path(format: :json)
+
+    assert_equal "11", response.headers["X-Total-Count"]
+  end
+end
