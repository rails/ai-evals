@@ -0,0 +1,43 @@
+class ActivitiesController < ApplicationController
+  # Mirrors the HTML timeline, minus the deprecated card_collection_changed
+  # events, plus card_title_changed events.
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activity
+  end
+
+  private
+    def activity
+      events = Event
+        .preloaded
+        .where(board: Current.user.boards)
+        .where(action: ACTIVITY_ACTIONS)
+
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+
+      events.order(created_at: :desc, id: :desc)
+    end
+
+    def board_ids
+      Array(params[:board_ids]).filter(&:present?)
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).filter(&:present?)
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..e7ba146
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,30 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: event.assignee_ids }
+    when "card_board_changed"
+      { old_board: particular_value(event, "old_board"), new_board: particular_value(event, "new_board") }
+    when "card_title_changed"
+      { old_title: particular_value(event, "old_title"), new_title: particular_value(event, "new_title") }
+    when "card_triaged", "card_sent_back_to_triage"
+      { column: particular_value(event, "column") }
+    else
+      {}
+    end
+  end
+
+  def activity_url(event)
+    case event.eventable
+    when Comment
+      card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable))
+    else
+      card_url(event.eventable)
+    end
+  end
+
+  private
+    def particular_value(event, key)
+      event.particulars&.dig("particulars", key).presence || ""
+    end
+end
