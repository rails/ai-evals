@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Cards::StalledFilterBehaviorTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON can filter by the stalled index" do
+    card = cards(:layout)
+    card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_equal [ card.number ], @response.parsed_body.pluck("number")
+    assert @response.parsed_body.first["stalled"]
+  end
+
+  test "a card without a burst is not listed as stalled" do
+    card = cards(:layout)
+    card.update! burst_at: nil, stalled_at: nil, last_active_at: 3.months.ago
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("number"), card.number
+  end
+
+  test "activity removes a card from the stalled index" do
+    card = cards(:layout)
+    card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    with_current_user(:kevin) { card.comments.create! body: "Still working on it" }
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("number"), card.number
+  end
+end
