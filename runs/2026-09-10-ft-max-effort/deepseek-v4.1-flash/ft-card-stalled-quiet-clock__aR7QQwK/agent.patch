diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..6715321
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,86 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_PEOPLE_COUNT = 2
+  BURST_WINDOW_DIVISOR = 3
+  STALL_PERIOD = 2.weeks
+
+  included do
+    before_save :clear_stall, if: :will_save_change_to_last_active_at?
+
+    scope :stalled, -> {
+      where(
+        "cards.stalled_at IS NOT NULL OR (cards.burst_at IS NOT NULL AND cards.last_active_at <= ?)",
+        STALL_PERIOD.ago
+      )
+    }
+  end
+
+  class_methods do
+    # Flags every card that had a burst and has since gone quiet for the stall
+    # period. Idempotent, so it can run repeatedly from the scheduler.
+    def stall_all_due
+      stalled.where(stalled_at: nil).find_each do |card|
+        card.update!(stalled_at: card.stalled_since)
+      end
+    end
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?
+    stalled_at.present? || stall_due?
+  end
+
+  # The moment the card became (or is due to become) stalled.
+  def stalled_since
+    stalled_at || (last_active_at + STALL_PERIOD if burst?)
+  end
+
+  def stalled_for(as_of = Time.current)
+    as_of - stalled_since if stalled?
+  end
+
+  def burst!(at: Time.current)
+    update!(burst_at: at) unless burst_at && burst_at >= at
+  end
+
+  def stall!
+    update!(stalled_at: stalled_since) if stalled? && !stalled_at?
+  end
+
+  # Assignment and reopening are bursts in their own right.
+  def register_burst_from(event)
+    if published? && event.action.to_s.in?(%w[ card_assigned card_reopened ])
+      burst! at: event.created_at
+    end
+  end
+
+  # Three or more comments from at least two people inside a third of the
+  # board's auto-close period add up to a burst.
+  def register_burst_from_comments(as_of = Time.current)
+    if published? && burst_window.positive?
+      recent_comments = comments.by_user.where(created_at: (as_of - burst_window)..as_of)
+
+      if recent_comments.count >= BURST_COMMENT_COUNT && recent_comments.distinct.count(:creator_id) >= BURST_PEOPLE_COUNT
+        burst! at: as_of
+      end
+    end
+  end
+
+  private
+    def stall_due?
+      burst? && last_active_at.present? && last_active_at <= STALL_PERIOD.ago
+    end
+
+    def burst_window
+      auto_postpone_period / BURST_WINDOW_DIVISOR
+    end
+
+    def clear_stall
+      self.stalled_at = nil
+    end
+end
