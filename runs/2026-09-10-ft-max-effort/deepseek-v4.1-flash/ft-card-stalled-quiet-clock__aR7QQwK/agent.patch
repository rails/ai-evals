+require "test_helper"
+
+class Cards::StalledRenderingBehaviorTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "the stalled card bubble carries the stall timestamp" do
+    card = cards(:layout)
+    card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    get card_path(card)
+
+    assert_response :success
+    assert_includes @response.body, "stalledAt"
+    assert_includes @response.body, card.stalled_since.iso8601
+  end
+
+  test "a stalled card is flagged in its markup" do
+    card = cards(:layout)
+    card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select "article.card--stalled", count: 1
+    assert_select ".bubble .for-screen-reader", text: "Stalled"
+  end
+
+test "stalled cards are flagged in the cards index" do
+  card = cards(:layout)
+  card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+  get cards_path
+
+  assert_response :success
+  assert_select "article.card--stalled", count: 1
+end
+
+  test "a card without a burst is not flagged as stalled" do
+    card = cards(:layout)
+    card.update! burst_at: nil, stalled_at: nil, last_active_at: 1.day.ago
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select "article.card--stalled", count: 0
+  end
+end
diff --git a/test/models/card/stallable_behavior_test.rb b/test/models/card/stallable_behavior_test.rb
new file mode 100644
index 0000000..1989f7a
--- /dev/null
+++ b/test/models/card/stallable_behavior_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class Card::StallableBehaviorTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+    @card.comments.destroy_all
+    @card.update! burst_at: nil, stalled_at: nil, last_active_at: 1.week.ago
+  end
+
+  test "three comments from two people within the burst window make a burst" do
+    freeze_time do
+      with_current_user(:david) { @card.comments.create! body: "One" }
+      with_current_user(:jz)    { @card.comments.create! body: "Two" }
+      assert_not @card.reload.burst?
+
+      with_current_user(:kevin) { @card.comments.create! body: "Three" }
+      assert @card.reload.burst?
+      assert_in_delta Time.current, @card.burst_at, 1.second
+    end
+  end
+
+  test "three comments from a single person are not a burst" do
+    freeze_time do
+      3.times { with_current_user(:david) { @card.comments.create! body: "Same person" } }
+      assert_not @card.reload.burst?
+    end
+  end
+
+  test "comments older than the burst window do not add up" do
+    old = 45.days.ago
+
+    with_current_user(:david) { @card.comments.create! body: "Old", created_at: old }
+    with_current_user(:jz)    { @card.comments.create! body: "Old", created_at: old }
+    with_current_user(:kevin) { @card.comments.create! body: "New" }
+
+    assert_not @card.reload.burst?
+  end
+
+  test "system comments do not count toward a burst" do
+    freeze_time do
+      3.times do
+        @card.comments.create! body: "System", creator: @card.account.system_user
+      end
+
+      assert_not @card.reload.burst?
+    end
+  end
+
+  test "assigning someone to a card is a burst" do
+    @card.assignments.delete_all
+    assert_not @card.burst?
+
+    @card.toggle_assignment(users(:jz))
+
+    assert @card.reload.burst?
+  end
+
+  test "reopening a card is a burst" do
+    card = cards(:shipping)
+    card.update! burst_at: nil, stalled_at: nil
+    assert card.closed?
+
+    card.reopen
+
+    assert card.reload.burst?
+  end
+
+  test "a card is stalled two weeks after its last burst activity" do
+    freeze_time do
+      @card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+      assert @card.stalled?
+      assert_includes Card.stalled, @card
+      assert_equal @card.last_active_at + Card::Stallable::STALL_PERIOD, @card.stalled_since
+      assert_equal 1.week, @card.stalled_for
+    end
+  end
+
+  test "a burst card with recent activity is not stalled" do
+    @card.update! burst_at: 3.weeks.ago, last_active_at: 1.day.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a card without a burst is never stalled" do
+    @card.update! burst_at: nil, last_active_at: 3.months.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "any activity resets a stalled card" do
+    @card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago, stalled_at: 1.week.ago
+    assert @card.stalled?
+
+    with_current_user(:kevin) { @card.comments.create! body: "Back in action" }
+
+    @card.reload
+    assert_not @card.stalled?
+    assert_nil @card.stalled_at
+  end
+
+  test "stall_all_due persists stalled_at for due cards" do
+    freeze_time do
+      @card.update! burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+      assert_difference -> { Card.stalled.where.not(stalled_at: nil).count }, +1 do
+        Card.stall_all_due
+      end
+
+      assert_equal @card.last_active_at + Card::Stallable::STALL_PERIOD, @card.reload.stalled_at
+    end
+  end
+
+
+test "a burst of comments followed by two quiet weeks stalls the card" do
+  with_current_user(:david) { @card.comments.create! body: "One" }
+  with_current_user(:jz)    { @card.comments.create! body: "Two" }
+  with_current_user(:kevin) { @card.comments.create! body: "Three" }
+
+  assert @card.reload.burst?
+  assert_not @card.stalled?
+
+  travel 2.weeks + 1.day do
+    assert @card.reload.stalled?
+  end
+end
+
+test "an assignment followed by two quiet weeks stalls the card" do
+  @card.assignments.delete_all
+  @card.toggle_assignment(users(:jz))
+
+  assert @card.reload.burst?
+  assert_not @card.stalled?
+
+  travel 2.weeks + 1.day do
+    assert @card.reload.stalled?
+  end
+end
+
+
+test "comments spread beyond a third of the auto-close period do not burst" do
+  entropies(:writebook_board).update! auto_postpone_period: 3.days
+
+  with_current_user(:david) { @card.comments.create! body: "Old", created_at: 2.days.ago }
+  with_current_user(:jz)    { @card.comments.create! body: "Old", created_at: 2.days.ago }
