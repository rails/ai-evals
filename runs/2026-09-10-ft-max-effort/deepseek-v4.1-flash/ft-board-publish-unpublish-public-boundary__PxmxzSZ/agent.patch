diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..bce2b5b
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,27 @@
+class Board::Publication < ApplicationRecord
+  belongs_to :account, default: -> { board.account }, optional: true
+  belongs_to :board, touch: true
+
+  has_secure_token :key
+
+  before_create :sync_public_key
+
+  class << self
+    def find_by_key(value)
+      find_by(key: value) || find_by(public_key: value)
+    end
+  end
+
+  def token
+    key.presence || public_key
+  end
+
+  def to_param
+    token
+  end
+
+  private
+    def sync_public_key
+      self.public_key ||= key
+    end
+end
diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..2b03da6
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,50 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+  end
+
+  def publish
+    transaction do
+      new_key = self[:public_key].presence || publication_key || SecureRandom.base58(24)
+      update! public_key: new_key
+      publication || create_publication!(key: new_key)
+    end
+  end
+
+  def unpublish
+    transaction do
+      update! public_key: nil if self[:public_key].present?
+      publication&.destroy
+      association(:publication).reset
+    end
+  end
+
+  def published?
+    key.present?
+  end
+
+  def public_url
+    Rails.application.routes.url_helpers.public_board_url(key, **url_options) if published?
+  end
+
+  def key
+    self[:public_key].presence || publication_key
+  end
+
+  def public_key
+    self[:public_key].presence || publication_key
+  end
+
+  private
+    def publication_key
+      publication.token if publication&.persisted?
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      base_options.merge(script_name: nil)
+    end
+end
