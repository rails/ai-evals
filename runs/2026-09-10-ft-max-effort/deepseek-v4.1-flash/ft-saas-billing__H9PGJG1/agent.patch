+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+        <div>
+          #<%= @account.external_account_id %> ·
+          <strong><%= @account.plan.proper_name %></strong> plan ·
+          <%= pluralize(@account.card_count, "card") %> ·
+          <%= number_to_human_size(@account.bytes_used) %> used
+        </div>
+      </header>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Comp</h2>
+      </header>
+
+      <div>
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+        <% else %>
+          <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+        <% end %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override</h2>
+      </header>
+
