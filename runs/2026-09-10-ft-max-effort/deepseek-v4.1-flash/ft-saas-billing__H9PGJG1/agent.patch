diff --git a/saas/test/billing_controller_smoke_test.rb b/saas/test/billing_controller_smoke_test.rb
new file mode 100644
index 0000000..a98acb4
--- /dev/null
+++ b/saas/test/billing_controller_smoke_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class BillingControllerSmokeTest < ActionDispatch::IntegrationTest
+  test "shows the plans to a signed-in admin" do
+    sign_in_as :kevin
+
+    get saas.account_billing_path
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "strong", text: "Unlimited"
+    assert_select "strong", text: "Unlimited+"
+    assert_select "button", text: "Upgrade"
+  end
+
+  test "starts a stripe checkout session for a paid plan" do
+    sign_in_as :kevin
+
+    session = mock("checkout session")
+    session.stubs(:url).returns("https://checkout.stripe.com/c/pay/cs_test")
+
+    Stripe::Checkout::Session.expects(:create).once.returns(session)
+
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly_test"
+    begin
+      post saas.account_billing_path, params: { plan_key: "UnlimitedV1" }
+    ensure
+      ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    end
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test"
+  end
