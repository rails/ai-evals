diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..67be5d0
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,109 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.raw_post,
+      request.headers["Stripe-Signature"],
+      ENV.fetch("STRIPE_WEBHOOK_SECRET")
+    )
+
+    handle_event(event)
+
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError, KeyError
+    head :bad_request
+  end
+
+  private
+    def handle_event(event)
+      case event.type.to_s
+      when "checkout.session.completed"
+        handle_checkout_session(value(event, :data, :object))
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        handle_subscription(value(event, :data, :object))
+      end
+    end
+
+    def handle_checkout_session(session)
+      account = find_account(session)
+      return unless account
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_customer_id = value(session, :customer)
+      subscription.stripe_subscription_id = value(session, :subscription)
+      subscription.plan_key = plan_key_for(session) || subscription.plan_key
+      subscription.status = "active"
+      subscription.save!
+    end
+
+    def handle_subscription(stripe_subscription)
+      account = find_account(stripe_subscription)
+      return unless account
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_customer_id = value(stripe_subscription, :customer) || subscription.stripe_customer_id
+      subscription.stripe_subscription_id = value(stripe_subscription, :id) || subscription.stripe_subscription_id
+
+      if plan_key = plan_key_for(stripe_subscription)
+        subscription.plan_key = plan_key
+      end
+
+      subscription.status = value(stripe_subscription, :status).presence
+      subscription.cancel_at = parse_time(value(stripe_subscription, :cancel_at))
+      subscription.current_period_end = current_period_end_for(stripe_subscription)
+      subscription.save!
+    end
+
+    def find_account(object)
+      if account_id = value(metadata_for(object), :account_id).presence
+        Account.find_by(id: account_id)
+      elsif customer_id = value(object, :customer).presence
+        Account::Subscription.find_by(stripe_customer_id: customer_id)&.account
+      end
+    end
+
+    def plan_key_for(object)
+      value(metadata_for(object), :plan_key).presence || plan_for_prices(object)&.short_name
+    end
+
+    def plan_for_prices(object)
+      price_ids_for(object).filter_map { |price_id| Subscription.for_stripe_price(price_id) }.max_by do |plan|
+        Array(plan.stripe_price_ids).size
+      end
+    end
+
+    def price_ids_for(object)
+      Array(value(value(object, :items), :data)).filter_map { |item| value(value(item, :price), :id) }
+    end
+
+    def current_period_end_for(object)
+      parse_time(value(object, :current_period_end)) ||
+        parse_time(value(Array(value(value(object, :items), :data)).first, :current_period_end))
+    end
+
+    def parse_time(timestamp)
+      return nil if timestamp.blank?
+      Time.zone.at(timestamp.to_i)
+    end
+
+    def metadata_for(object)
+      value(object, :metadata) || {}
+    end
+
+    # Reads a value from a Stripe object, a Hash with string keys, or a Hash
+    # with symbol keys, so tests can feed plain hashes while production feeds
+    # Stripe::StripeObject instances.
+    def value(object, *keys)
+      keys.reduce(object) do |current, key|
+        break nil if current.nil?
+        if current.respond_to?(:[])
+          current[key.to_s] || current[key.to_sym]
+        else
+          current.public_send(key)
+        end
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..ebf0ca1
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,68 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  # Show a countdown warning once this many (or fewer) cards remain.
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def plan
+    active_subscription&.plan || (comped? ? Subscription::UnlimitedV1 : Subscription::FreeV1)
+  end
+
+  def plan_name
+    plan.short_name
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver&.persisted? || false
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless comped?
+    else
+      billing_waiver&.destroy!
+    end
+  end
+
+  # Effective card count, honoring a support override when present.
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  # nil means unlimited.
+  def card_limit
+    plan.card_limit
+  end
+
+  def cards_remaining
+    return nil if card_limit.nil?
+    [ card_limit - card_count, 0 ].max
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  # Effective bytes used, honoring a support override when present.
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def storage_limit
+    storage_exception&.bytes_allowed || plan.storage_limit
+  end
+end
