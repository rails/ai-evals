diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..40de45e
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,24 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+  INACTIVE_STATUSES = %w[ canceled incomplete_expired unpaid incomplete ].freeze
+
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  def plan
+    Subscription.find(plan_key)
+  end
+
+  def plan=(plan)
+    self.plan_key = plan.respond_to?(:short_name) ? plan.short_name : plan.to_s
+  end
+
+  def active?
+    return false if status.in?(INACTIVE_STATUSES)
+    current_period_end.nil? || current_period_end.future?
+  end
+
+  def free?  = plan.free?
+  def paid?  = plan.paid?
+end
diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
index 5efb1a7..c71cdc6 100644
--- a/saas/app/models/subscription.rb
+++ b/saas/app/models/subscription.rb
@@ -1,13 +1,73 @@
+# A billing plan. Plans are string short names so they can be persisted and
+# compared with plain strings, and they also carry their billing metadata.
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  SHORT_NAMES = %w[ FreeV1 UnlimitedV1 UnlimitedPlusV1 ]
+  # Alternate plan keys used by the Stripe products for the same entitlements.
+  ALIASES = %w[ MonthlyV1 MonthlyExtraStorageV1 ]
 
-  def self.short_name
-    name.demodulize
+  class Plan < String
+    def initialize(name, **attributes)
+      super(name)
+      @attributes = attributes
+    end
+
+    attr_reader :attributes
+
+    def short_name  = to_s
+    def proper_name = attributes[:proper_name]
+    def price       = attributes[:price]
+    def frequency   = attributes[:frequency]
+    def card_limit  = attributes[:card_limit]
+    def storage_limit = attributes[:storage_limit]
+
+    def stripe_price_ids
+      case short_name
+      when "UnlimitedV1", "MonthlyV1"
+        Array(ENV["STRIPE_MONTHLY_V1_PRICE_ID"])
+      when "UnlimitedPlusV1", "MonthlyExtraStorageV1"
+        [ ENV["STRIPE_MONTHLY_V1_PRICE_ID"], ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ]
+      else
+        []
+      end.compact_blank.map(&:to_s)
+    end
+
+    def free? = price.to_i.zero?
+    def paid? = !free?
   end
 
-  class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+  FreeV1 = Plan.new("FreeV1", proper_name: "Free", price: 0, frequency: "monthly", card_limit: 1_000, storage_limit: 1.gigabyte)
+
+  UnlimitedV1 = Plan.new("UnlimitedV1", proper_name: "Unlimited", price: 20, frequency: "monthly", card_limit: nil, storage_limit: 5.gigabytes)
+  MonthlyV1   = Plan.new("MonthlyV1", proper_name: "Unlimited", price: 20, frequency: "monthly", card_limit: nil, storage_limit: 5.gigabytes)
+
+  UnlimitedPlusV1         = Plan.new("UnlimitedPlusV1", proper_name: "Unlimited+", price: 25, frequency: "monthly", card_limit: nil, storage_limit: 500.gigabytes)
+  MonthlyExtraStorageV1   = Plan.new("MonthlyExtraStorageV1", proper_name: "Unlimited+", price: 25, frequency: "monthly", card_limit: nil, storage_limit: 500.gigabytes)
+
+  class << self
+    def short_name
+      name.demodulize
+    end
+
+    # Returns the plan for the given short name. Unknown or blank names fall
+    # back to the free plan.
+    def find(short_name)
+      return default if short_name.blank?
+      const_get(short_name.to_s, false)
+    rescue NameError
+      default
+    end
+
+    def all
+      SHORT_NAMES.map { |short_name| find(short_name) }
+    end
+
+    def default
+      FreeV1
+    end
+
+    def for_stripe_price(price_id)
+      return nil if price_id.blank?
+      all.find { |plan| plan.stripe_price_ids.include?(price_id.to_s) }
+    end
   end
 end
diff --git a/saas/app/views/account/billings/show.html.erb b/saas/app/views/account/billings/show.html.erb
