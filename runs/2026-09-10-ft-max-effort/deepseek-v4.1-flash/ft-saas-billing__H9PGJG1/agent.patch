+        <label class="flex flex-column gap-quarter">
+          <span>Card count</span>
+          <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+        </label>
+
+        <label class="flex flex-column gap-quarter">
+          <span>Bytes used</span>
+          <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+        </label>
+
+        <%= form.submit "Override", class: "btn" %>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+  </div>
+</section>
