+<% @page_title = "Billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Plans</h2>
+        <div>You’re currently on the <strong><%= Current.account.plan.proper_name %></strong> plan.</div>
+      </header>
+
+      <div class="flex flex-column gap margin-block-start-half">
+        <% @plans.each do |plan| %>
+          <div class="flex align-center gap justify-space-between" data-plan="<%= plan.short_name %>">
+            <div>
+              <strong><%= plan.proper_name %></strong>
+              <div class="txt-small">
+                <%= number_with_delimiter(plan.card_limit) if plan.card_limit %> <%= "card".pluralize(plan.card_limit || 2) if plan.card_limit %>
+                <%= "Unlimited cards" unless plan.card_limit %>
+                · <%= number_to_human_size(plan.storage_limit) %> storage
+              </div>
+            </div>
+
+            <div>
+              <% if plan.free? %>
+                <span class="txt-small"><%= plan == Current.account.plan ? "Current plan" : "Free" %></span>
+              <% elsif plan == Current.account.plan %>
+                <span class="txt-small">Current plan</span>
+              <% else %>
+                <%= button_to "Upgrade", saas.account_billing_path(plan_key: plan.short_name), class: "btn", form: { data: { turbo: false } } %>
+              <% end %>
+            </div>
+          </div>
+          <hr class="separator--horizontal">
+        <% end %>
+      </div>
+    </section>
+  </div>
+</div>
