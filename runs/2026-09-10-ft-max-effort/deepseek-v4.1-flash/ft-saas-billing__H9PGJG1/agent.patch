diff --git a/saas/app/controllers/account/billings_controller.rb b/saas/app/controllers/account/billings_controller.rb
new file mode 100644
index 0000000..a403d9f
--- /dev/null
+++ b/saas/app/controllers/account/billings_controller.rb
@@ -0,0 +1,59 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin, only: %i[create portal]
+
+  def show
+    @plans = Subscription.all
+    @subscription = Current.account.active_subscription
+  end
+
+  def create
+    plan = Subscription.find(params[:plan_key])
+
+    if plan.free? || plan.stripe_price_ids.empty?
+      redirect_to saas.account_billing_path, alert: "That plan isn’t available right now."
+      return
+    end
+
+    session = Stripe::Checkout::Session.create(checkout_attributes(plan))
+    redirect_to session.url, allow_other_host: true
+  end
+
+  def portal
+    subscription = Current.account.active_subscription
+
+    if subscription&.stripe_customer_id.blank?
+      redirect_to saas.account_billing_path, alert: "There’s no billing account to manage yet."
+      return
+    end
+
+    session = Stripe::BillingPortal::Session.create(
+      customer: subscription.stripe_customer_id,
+      return_url: saas.account_billing_url
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def checkout_attributes(plan)
+      {
+        mode: "subscription",
+        line_items: plan.stripe_price_ids.map { |price_id| { price: price_id, quantity: 1 } },
+        client_reference_id: Current.account.id,
+        success_url: saas.account_billing_url,
+        cancel_url: saas.account_billing_url,
+        customer: Current.account.active_subscription&.stripe_customer_id.presence,
+        customer_email: (Current.account.active_subscription&.stripe_customer_id.present? ? nil : Current.identity.email_address),
+        subscription_data: {
+          metadata: {
+            account_id: Current.account.id,
+            plan_key: plan.short_name
+          }
+        },
+        metadata: {
+          account_id: Current.account.id,
+          plan_key: plan.short_name
+        }
+      }.compact
+    end
+end
