diff --git a/app/views/reactions/_reactions.html.erb b/app/views/reactions/_reactions.html.erb
new file mode 100644
index 0000000..4ea5a2f
--- /dev/null
+++ b/app/views/reactions/_reactions.html.erb
@@ -0,0 +1,43 @@
+<% reactions ||= reactable.reactions.chronologically.preloaded %>
+<div class="reactions" id="<%= dom_id(reactable, :reactions) %>" data-controller="reaction">
+  <ul class="reactions__list">
+    <%= render partial: "reactions/reaction", collection: reactions, as: :reaction %>
+  </ul>
+
+  <button type="button" class="reactions__trigger btn" data-reaction-target="trigger"
+      data-action="reaction#open" aria-label="Add a reaction" title="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+  </button>
+
+  <%= form_with model: Reaction.new, url: reactions_path_for(reactable),
+        class: "reaction__form", html: { hidden: true },
+        data: { reaction_target: "form", action: "turbo:submit-end->reaction#submitEnd" } do |form| %>
+    <label class="reaction__form-label reaction__avatar" tabindex="0">
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      <%= form.text_field :content, class: "input reaction__input", maxlength: 16, required: true,
+            autocomplete: "off", placeholder: "React…", data: { reaction_target: "input" } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog">
+      <button type="button" class="reaction__menu-btn btn" data-action="dialog#toggle" aria-label="Pick an emoji">
+        <%= icon_tag "reaction" %>
+      </button>
+
+      <dialog class="popup reaction__popup panel" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn" title="<%= label %>" aria-label="<%= label %>"
+                data-action="reaction#pick" data-emoji="<%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <button type="submit" class="reaction__submit-btn btn" aria-label="Add reaction" title="Add reaction">
+      <%= icon_tag "check" %>
+    </button>
+    <button type="button" class="reaction__cancel-btn btn" data-action="reaction#close" aria-label="Cancel" title="Cancel">
+      <%= icon_tag "close" %>
+    </button>
+  <% end %>
+</div>
