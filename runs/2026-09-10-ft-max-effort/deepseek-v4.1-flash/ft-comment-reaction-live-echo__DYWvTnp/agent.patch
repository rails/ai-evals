diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..916e711
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,53 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_reactable
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @reactable.reactions.chronologically.preloaded
+    fresh_when etag: @reactions
+  end
+
+  def create
+    @reaction = @reactable.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: polymorphic_path(@reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reactable
+      @reactable = if params[:comment_id].present?
+        @card.comments.find(params[:comment_id])
+      else
+        @card
+      end
+    end
+
+    def set_reaction
+      @reaction = @reactable.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden unless Current.user == @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..3bd9283
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,23 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    case reactable
+    when Comment
+      card_comment_reactions_path(reactable.card, reactable)
+    else
+      card_reactions_path(reactable)
+    end
+  end
+
+  def reaction_path_for(reaction)
+    case reaction.reactable
+    when Comment
+      card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction)
+    else
+      card_reaction_path(reaction.reactable, reaction)
+    end
+  end
+
+  def emoji_only_reaction?(reaction)
+    EmojiHelper::REACTIONS.key?(reaction.content)
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..46f94bf
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  open(event) {
+    event.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget?.focus()
+  }
+
+  close(event) {
+    event?.preventDefault()
+    if (!this.hasFormTarget) return
+
+    this.formTarget.querySelector("dialog[open]")?.close()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.reset()
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+  }
+
+  pick(event) {
+    event.preventDefault()
+    if (!this.hasInputTarget) return
+
+    this.inputTarget.value = event.currentTarget.dataset.emoji
+    this.inputTarget.focus()
+    event.currentTarget.closest("dialog")?.close()
+  }
+
+  toggle(event) {
+    if (event.target.closest("a, button, form, input, textarea, select, dialog")) return
+    event.currentTarget.classList.toggle("expanded")
+  }
+
+  stop(event) {
+    event.stopPropagation()
+  }
+
+  submitEnd(event) {
+    if (event.detail.success) this.close()
+  }
+}
