diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..3d59c05
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,19 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+  belongs_to :creator, class_name: "User", foreign_key: :reacter_id, inverse_of: false, optional: true
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  def card
+    reactable.is_a?(Card) ? reactable : reactable.card
+  end
+
+  def to_param
+    id
+  end
+end
