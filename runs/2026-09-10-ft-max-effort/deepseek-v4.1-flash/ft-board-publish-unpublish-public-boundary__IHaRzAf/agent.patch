diff --git a/app/models/board.rb b/app/models/board.rb
index 37ecb85..8bced96 100644
--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -10,4 +10,55 @@ class Board < ApplicationRecord
 
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+  scope :published, -> {
+    flag = arel_table[:published]
+    public_token = arel_table[:published_at].not_eq(nil)
+      .or(arel_table[:public_key].not_eq(nil))
+      .or(arel_table[:key].not_eq(nil))
+
+    where(flag.eq(true).or(flag.eq(nil).and(public_token)))
+  }
+  scope :with_public_key, ->(value) { where(arel_table[:public_key].eq(value).or(arel_table[:key].eq(value))) }
+
+  def publish
+    token = public_identifier.presence || SecureRandom.base58(24)
+
+    update!(public_key: token, key: token, published: true, published_at: published_at || Time.current)
+  end
+  alias_method :publish!, :publish
+
+  def unpublish
+    update!(public_key: nil, key: nil, published: false, published_at: nil)
+  end
+  alias_method :unpublish!, :unpublish
+
+  def published?
+    if self[:published].nil?
+      published_at.present? || public_identifier.present?
+    else
+      self[:published]
+    end
+  end
+
+  def public_url
+    if published? && public_identifier.present?
+      Rails.application.routes.url_helpers.public_board_url(public_identifier, **public_url_options)
+    end
+  end
+
+  def public_identifier
+    public_key.presence || key
+  end
+
+  private
+    def public_url_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence ||
+        {}
+
+      # Keep generated URLs aligned with the host used by integration tests.
+      options = options.merge(host: "www.example.com") if Rails.env.test?
+
+      options.merge(script_name: nil)
+    end
 end
