@@ -0,0 +1,30 @@
+# Secrets referenced by config/deploy.yml.
+#
+# Keep this file free of raw credentials so it is safe to commit: point each
+# entry at an environment variable or a command instead, and provide the value
+# before deploying. See docs/deployment.md for the full walkthrough.
+#
+# Rails needs a secret key base. Generate one with `bin/rails secret` and export
+# it, or paste the generated value on the right-hand side:
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for the mail server configured under `env.clear` in
+# config/deploy.yml, if it requires authentication:
+#   export SMTP_PASSWORD=...
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Only needed when you point `registry/server` in config/deploy.yml at a real
+# registry (Docker Hub, GHCR, ...) instead of the default local one. Use an
+# access token rather than your account password:
+#   export KAMAL_REGISTRY_PASSWORD=...
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Only needed if you use Rails credentials. Point this at the master key;
+# otherwise it can stay empty.
+RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null)
+
+# Optional: web push notifications need a VAPID key pair.
+# Generate one with `WebPush.generate_key` (see docs/development.md):
+# VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+# VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
