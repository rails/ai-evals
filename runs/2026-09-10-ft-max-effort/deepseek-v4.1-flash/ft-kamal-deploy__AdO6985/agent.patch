new file mode 100644
index 0000000..3f72fe2
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,97 @@
+# Kamal deployment configuration for running Fizzy on a single Linux server:
+# the web app, the background job worker, the SQLite databases and uploaded
+# files all live in one container, behind kamal-proxy, with SSL from the proxy.
+#
+# Background jobs run inside Puma via Solid Queue (see config/puma.rb), so there
+# is deliberately no separate `job` role here — one box, one container.
+#
+# Before your first `bin/kamal setup`:
+#   1. Replace the server address below with your server's IP or hostname.
+#   2. Replace the proxy host with the domain Fizzy will be served from. That
+#      domain must already point at the server, and ports 80 and 443 must be
+#      open, so kamal-proxy can fetch a Let's Encrypt certificate for it.
+#   3. Fill in your mail server under `env.clear` and put the matching password
+#      in .kamal/secrets, so Fizzy can email sign-in links.
+#   4. Read .kamal/secrets for the secrets you need to provide.
+#
+# A full walkthrough lives in docs/deployment.md.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. With the local registry below this stays local.
+# If you push to a registry (Docker Hub, GHCR, ...), prefix it with your
+# username, e.g. "your-user/fizzy".
+image: fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt and route only this host to
+# Fizzy. kamal-proxy terminates TLS and forwards to the app on port 80 inside
+# the container (Thruster's default). Remove this section if you terminate SSL
+# somewhere else.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Credentials for your image host.
+#
+# The default below uses a local registry: Kamal runs a registry container on
+# your machine and tunnels it to the server, so you do not need a registry
+# account to get started. To push to Docker Hub, GHCR, etc., set `server` and
+# supply a username and an access token instead.
+registry:
+  server: localhost:5555
+  # server: registry.digitalocean.com / ghcr.io / ...
+  # username: your-user
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Configure builder setup. Set this to match your server's architecture.
+builder:
+  arch: amd64
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    RAILS_ENV: production
+    # Everything runs on one box: SQLite databases and local disk for uploads.
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    # The public hostname Fizzy is served from; used to build absolute links.
+    APP_FQDN: fizzy.example.com
+    # Run Solid Queue's dispatchers and workers inside Puma, so the single web
+    # container also processes background jobs.
+    SOLID_QUEUE_IN_PUMA: "true"
+    # The address Fizzy sends email from.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    # Your mail server. SMTP_PASSWORD lives in .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # SMTP_USERNAME: fizzy@example.com
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS: "true"
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+# Keep your data between deploys: the SQLite databases and every uploaded file
+# live under /rails/storage, so a named volume is all that is needed.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
