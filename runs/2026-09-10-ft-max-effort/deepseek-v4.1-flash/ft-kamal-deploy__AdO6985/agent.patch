+      address: smtp_address,
+      port: (ENV["SMTP_PORT"].presence || ENV["MAILER_SMTP_PORT"].presence || ENV["MAILER_PORT"].presence || 587).to_i,
+      domain: ENV["SMTP_DOMAIN"].presence || ENV["MAILER_SMTP_DOMAIN"].presence || ENV["MAILER_DOMAIN"].presence,
+      user_name: ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence || ENV["MAILER_SMTP_USERNAME"].presence || ENV["MAILER_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence || ENV["MAILER_SMTP_PASSWORD"].presence || ENV["MAILER_PASSWORD"].presence,
+      authentication: (ENV["SMTP_AUTHENTICATION"].presence || ENV["MAILER_SMTP_AUTHENTICATION"].presence || ENV["MAILER_AUTHENTICATION"].presence)&.to_sym,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS", ENV.fetch("MAILER_SMTP_ENABLE_STARTTLS", "true")) == "true"
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
