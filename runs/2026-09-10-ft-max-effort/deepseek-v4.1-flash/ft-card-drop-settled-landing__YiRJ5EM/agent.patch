diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a85972c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,170 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Move cards between columns and statuses by dragging them around the board.
+//
+// The move is applied to the DOM as soon as a card is dropped, before the
+// request that persists it, so the board always feels instant and never casts
+// the card back to where it came from while the save is in flight. Dragging
+// only ever changes which column a card belongs to — never its position within
+// a column, since each column keeps its own order.
+export default class extends Controller {
+  static classes = [ "dragged", "hover" ]
+  static values = { desktopQuery: { type: String, default: "(min-width: 640px)" } }
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopQueryValue)
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+  }
+
+  dragStart(event) {
+    // Drag-and-drop isn't available on small viewports, so cancel any native
+    // drag the browser might otherwise start.
+    if (!this.#isDesktop) {
+      event.preventDefault()
+      return
+    }
+
+    const card = event.target.closest(".card")
+    if (!card || !card.dataset.dragAndDropUrl) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest("[data-drag-and-drop-column]")
+
+    card.classList.add(this.#draggedClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFrom(event)
+    if (!column) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    if (column !== this.hoveredColumn) this.#hover(column)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFrom(event)
+    if (!column || column !== this.hoveredColumn) return
+    if (!column.contains(event.relatedTarget)) this.#clearHover()
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    if (!card) return
+
+    const column = this.#columnFrom(event)
+    const source = this.sourceColumn
+
+    event.preventDefault()
+    event.stopPropagation()
+
+    this.#finishDrag()
+
+    // Columns keep their own order, so dropping a card back where it started is
+    // a no-op rather than a reorder.
+    if (!column || column === source) return
+
+    const list = column.querySelector(".cards__list")
+    if (!list) return
+
+    this.#insert(card, list)
+    this.#save(card, column, source)
+  }
+
+  dragEnd() {
+    this.#finishDrag()
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return this.mediaQuery.matches
+  }
+
+  get #draggedClass() {
+    return this.draggedClass || "drag-and-drop__dragged-item"
+  }
+
+  get #hoverClass() {
+    return this.hoverClass || "drag-and-drop__hover-container"
+  }
+
+  #columnFrom(event) {
+    const target = event.target
+    if (!(target instanceof Element)) return null
+
+    const element = target.closest("[data-drag-and-drop-column]")
+    return element && this.element.contains(element) ? element : null
+  }
+
+  #hover(column) {
+    this.#clearHover()
+    this.hoveredColumn = column
+    column.classList.add(this.#hoverClass)
+  }
+
+  #clearHover() {
+    this.hoveredColumn?.classList.remove(this.#hoverClass)
+    this.hoveredColumn = null
+  }
+
+  #finishDrag() {
+    this.#clearHover()
+    this.draggedCard?.classList.remove(this.#draggedClass)
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  // Insert the card where the server will put it: golden cards first, then most
+  // recently active first. Cards can be nested inside a pagination container, so
+  // we insert alongside whatever cards already live there.
+  #insert(card, list) {
+    const cards = Array.from(list.querySelectorAll(".card"))
+    const before = card.classList.contains("golden-effect")
+      ? cards[0]
+      : cards.find(element => !element.classList.contains("golden-effect"))
+
+    before ? before.parentNode.insertBefore(card, before) : list.append(card)
+  }
+
+  async #save(card, column, source) {
+    const response = await this.#moveRequest(card, column).catch(() => null)
+    if (!response?.ok) this.#revert(card, source)
+  }
+
+  #revert(card, source) {
+    const list = source?.querySelector(".cards__list")
+    if (list) this.#insert(card, list)
+  }
+
+  #moveRequest(card, column) {
+    const { dragAndDropColumnId: columnId, dragAndDropStatus: status } = column.dataset
+    const responseKind = "json"
+
+    if (columnId) {
+      return post(card.dataset.dragAndDropUrl, { body: { column_id: columnId }, responseKind })
+    }
+
+    switch (status) {
+      case "not_now":
+        return post(card.dataset.dragAndDropNotNowUrl, { responseKind })
+      case "closed":
+        return post(card.dataset.dragAndDropClosureUrl, { responseKind })
+      case "maybe":
+        return destroy(card.dataset.dragAndDropUrl, { responseKind })
+      default:
+        return Promise.reject(new Error(`Unknown drag-and-drop target: ${status}`))
+    }
+  }
+}
