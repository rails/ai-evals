diff --git a/test/system/drag_and_drop_verification_test.rb b/test/system/drag_and_drop_verification_test.rb
new file mode 100644
index 0000000..9bb525d
--- /dev/null
+++ b/test/system/drag_and_drop_verification_test.rb
@@ -0,0 +1,146 @@
+require "application_system_test_case"
+
+class DragAndDropVerificationTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "dragging a card from the stream into a column moves and saves it" do
+    card = cards(:buy_domain) # lives in the "Maybe?" stream, not in a column
+    column = columns(:writebook_triage)
+
+    assert_nil card.column
+
+    visit board_url(boards(:writebook))
+
+    expand_column column
+    assert_selector "##{dom_id(column)} .card", visible: true
+
+    drag_card_into card, column
+
+    within "##{dom_id(column)}" do
+      assert_selector "##{dom_id(card, :article)}", visible: true
+    end
+
+    wait_until { card.reload.column == column }
+
+    # The card is the most recently active card, so it leads the column once the
+    # server renders it again, after any golden cards.
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+
+    cards_in_column = all("##{dom_id(column)} .cards__list .card", visible: :all)
+    card_titles = cards_in_column.map { |element| element.find("h3", visible: :all).text }
+    golden_cards = cards_in_column.count { |element| element[:class].to_s.include?("golden-effect") }
+
+    assert_equal card.title, card_titles[golden_cards]
+  end
+
+  test "dragging a card from a column back to the stream clears its column" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    assert_equal column, card.column
+
+    visit board_url(boards(:writebook))
+
+    expand_column column
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: true
+
+    drag_card_into card, "maybe"
+
+    wait_until { card.reload.column.nil? }
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    visit board_url(boards(:writebook))
+
+    expand_column column
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: true
+
+    drag_card_into card, "not-now"
+
+    wait_until { card.reload.postponed? }
+  end
+
+  test "dragging a card to Done closes it" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+
+    drag_card_into card, "closed-cards"
+
+    wait_until { card.reload.closed? }
+
+    within "#closed-cards" do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+  end
+
+  test "dragging a closed card into a column reopens it" do
+    card = cards(:shipping) # closed
+    column = columns(:writebook_in_progress)
+
+    assert card.closed?
+
+    visit board_url(boards(:writebook))
+
+    expand_column "closed-cards"
+    assert_selector "#closed-cards ##{dom_id(card, :article)}", visible: true
+
+    drag_card_into card, column
+
+    wait_until { card.reload.column == column && card.reload.open? }
+  end
+
+  test "dropping a card on its own column is a no-op" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    visit board_url(boards(:writebook))
+
+    expand_column column
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: true
+
+    drag_card_into card, column
+
+    sleep 0.5
+    assert_equal column, card.reload.column
+  end
+
+  private
+    def expand_column(column)
+      selector = column.is_a?(String) ? "##{column}" : "##{dom_id(column)}"
+      find("#{selector} .cards__expander").click
+    end
+
+    def drag_card_into(card, column)
+      card_element = find "##{dom_id(card, :article)}"
+      column_selector = column.is_a?(String) ? "##{column}" : "##{dom_id(column)}"
+      column_element = find column_selector
+
+      page.execute_script(<<~JS, card_element, column_element)
+        const [card, column] = arguments
+        const dataTransfer = new DataTransfer()
+        const fire = (target, type) => target.dispatchEvent(
+          new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer })
+        )
+        fire(card, "dragstart")
+        fire(column, "dragenter")
+        fire(column, "dragover")
+        fire(column, "drop")
+        fire(card, "dragend")
+      JS
+    end
+
+    def wait_until(timeout: 5)
+      Timeout.timeout(timeout) do
+        sleep 0.1 until yield
+      end
+    end
+end
