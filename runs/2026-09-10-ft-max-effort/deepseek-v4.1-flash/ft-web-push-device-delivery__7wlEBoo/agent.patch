diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..460d63e
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @subscription = Push::Subscription.create!(
+      user: @user,
+      endpoint: "https://push.example.com/subscriptions/1",
+      p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+      auth_key: "tBHItJI5svbpez7KI4CCXg",
+      user_agent: "Mozilla/5.0"
+    )
+  end
+
+  test "requires endpoint and keys" do
+    subscription = Push::Subscription.new(user: @user)
+
+    assert_not subscription.valid?
+    assert subscription.errors[:endpoint].any?
+    assert subscription.errors[:p256dh_key].any?
+    assert subscription.errors[:auth_key].any?
+  end
+
+  test "deliver sends a web push" do
+    WebPush.expects(:payload_send).with(
+      message: "hello",
+      endpoint: @subscription.endpoint,
+      p256dh: @subscription.p256dh_key,
+      auth: @subscription.auth_key,
+      vapid: {
+        subject: Fizzy.vapid_subject,
+        public_key: Fizzy.vapid_public_key,
+        private_key: Fizzy.vapid_private_key
+      }
+    )
+
+    @subscription.deliver("hello")
+  end
+
+  test "deliver destroys the subscription when it has expired" do
+    response = Struct.new(:body, :code, :message).new("Gone", "410", "Gone")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver("hello")
+    end
+  end
+end
