+++ b/test/controllers/notifications/settings_push_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Notifications::SettingsPushTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "show renders push notification settings" do
+    get notifications_settings_path
+
+    assert_response :success
+    assert_select "[data-controller='notifications']"
+    assert_select "button[data-action='notifications#toggle']"
+    assert_select "[data-notifications-target='details']", minimum: 1
+  end
+
+  test "show exposes the vapid public key when configured" do
+    with_vapid_keys do
+      get notifications_settings_path
+
+      assert_select "meta[name='vapid-public-key'][content='test-public-key']"
+    end
+  end
+
+  private
+    def with_vapid_keys
+      original = ENV.to_h.slice("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+      ENV["VAPID_PUBLIC_KEY"] = "test-public-key"
+      ENV["VAPID_PRIVATE_KEY"] = "test-private-key"
+      yield
+    ensure
+      %w[ VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY ].each { |key| original.key?(key) ? ENV[key] = original[key] : ENV.delete(key) }
+    end
+end
