--- /dev/null
+++ b/app/models/push/message.rb
@@ -0,0 +1,44 @@
+# Builds the payload for a web push notification from a tray notification, so
+# both say the same thing and the notification opens the card it is about.
+class Push::Message
+  include NotificationsHelper
+  include Rails.application.routes.url_helpers
+
+  attr_reader :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def to_json(*)
+    { title:, body:, url: }.to_json
+  end
+
+  def title
+    case source
+    when Mention then "#{source.mentioner.first_name} @mentioned you"
+    when Event then event_notification_title(source)
+    end
+  end
+
+  def body
+    case source
+    when Mention then source.source.mentionable_content.truncate(200)
+    when Event then event_notification_body(source)
+    end
+  end
+
+  def url
+    polymorphic_url(notification.notifiable_target, base_url_options.merge(script_name: notification.account.slug))
+  end
+
+  private
+    def source
+      notification.source
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..bf4f6c6
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,35 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  scope :ordered, -> { order(created_at: :asc) }
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  def deliver(message)
+    message = Push::Message.new(message).to_json if message.is_a?(Notification)
+
+    WebPush.payload_send \
+      message: message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, SocketError, SystemCallError, IOError, Timeout::Error
+    # The push service is unreachable or rejected the message. Don't let a
+    # delivery failure break the notification flow (or job retries).
+    nil
+  end
+
+  private
+    def vapid_options
+      {
+        subject: Fizzy.vapid_subject,
+        public_key: Fizzy.vapid_public_key,
+        private_key: Fizzy.vapid_private_key
+      }
+    end
+end
