new file mode 100644
index 0000000..d75146a
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,30 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    subscription.update!(push_subscription_attributes)
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def push_subscription_attributes
+      push_subscription_params.to_h.symbolize_keys.merge(user_agent: request.user_agent)
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..53ef811
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,128 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Turns browser push notifications on and off for the device in use. The
+// browser's PushManager gives us a subscription that we register with the app
+// so it can deliver a push whenever a notification lands in the tray.
+export default class extends Controller {
+  static targets = ["details"]
+  static values = {
+    publicKey: String,
+    subscribeUrl: String
+  }
+
+  connect() {
+    this.refresh()
+  }
+
+  async toggle(event) {
+    event.preventDefault()
+
+    if (this.element.classList.contains("notifications--on")) {
+      await this.disable()
+    } else {
+      await this.enable()
+    }
+  }
+
+  async enable() {
+    if (!this.supported || !this.publicKeyValue) {
+      this.showDetails()
+      return
+    }
+
+    try {
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") {
+        this.showDetails()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#decodePublicKey(this.publicKeyValue)
+      })
+
+      if (!(await this.#save(subscription)).ok) {
+        await subscription.unsubscribe()
+        this.showDetails()
+        return
+      }
+
+      this.element.classList.add("notifications--on")
+      this.hideDetails()
+    } catch (error) {
+      console.error("Could not enable push notifications", error)
+      this.showDetails()
+    }
+  }
+
+  async disable() {
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription) {
+      await subscription.unsubscribe()
+    }
+
+    this.element.classList.remove("notifications--on")
+  }
+
+  async refresh() {
+    if (!this.supported || Notification.permission === "denied") {
+      this.element.classList.remove("notifications--on")
+      this.showDetails()
+      return
+    }
+
+    this.hideDetails()
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+
+    this.element.classList.toggle("notifications--on", Boolean(subscription))
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach((details) => details.hidden = false)
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach((details) => details.hidden = true)
+  }
+
+  get supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  #save(subscription) {
+    const keys = subscription.toJSON().keys
+
+    return fetch(this.subscribeUrlValue, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']")?.content
+      },
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      })
+    })
+  }
+
+  #decodePublicKey(base64) {
+    const padding = "=".repeat((4 - base64.length % 4) % 4)
+    const raw = atob((base64 + padding).replace(/-/g, "+").replace(/_/g, "/"))
+    const bytes = new Uint8Array(raw.length)
+
+    for (let i = 0; i < raw.length; i++) {
+      bytes[i] = raw.charCodeAt(i)
+    }
+
+    return bytes
+  }
+}
