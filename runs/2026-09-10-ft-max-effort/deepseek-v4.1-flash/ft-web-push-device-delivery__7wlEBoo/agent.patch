--- /dev/null
+++ b/test/models/notification/push_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  test "creating a notification enqueues a push" do
+    kevin = users(:kevin)
+    notifications(:layout_commented_kevin).destroy
+
+    notification = nil
+    assert_enqueued_with(job: Push::NotificationJob) do
+      notification = Notification.create!(user: kevin, source: events(:layout_commented), creator: users(:david))
+    end
+
+    assert_enqueued_with(job: Push::NotificationJob, args: [ notification ])
+  end
+
+  test "reading a notification does not enqueue a push" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.update!(read_at: nil)
+
+    assert_no_enqueued_jobs only: Push::NotificationJob do
+      notification.read
+    end
+
+    perform_enqueued_jobs
+  end
+
+  test "re-unreading a read notification enqueues a push" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.read
+    perform_enqueued_jobs
+
+    assert_enqueued_with(job: Push::NotificationJob, args: [ notification ]) do
+      notification.unread
+    end
+  end
+end
+
+class Notification::PushDeliveryTest < ActiveSupport::TestCase
+  test "push delivers the tray message to every subscription" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/1",
+      p256dh_key: "key",
+      auth_key: "key"
+    )
+
+    WebPush.expects(:payload_send).with { |args| JSON.parse(args[:message])["title"] == notification.card.title }
+
+    notification.push
+  end
+end
