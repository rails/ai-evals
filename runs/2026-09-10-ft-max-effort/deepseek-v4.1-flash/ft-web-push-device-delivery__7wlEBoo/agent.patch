@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create subscribes the current user's device" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/1",
+          p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+          auth_key: "tBHItJI5svbpez7KI4CCXg"
+        }
+      }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/subscriptions/1", subscription.endpoint
+    assert_equal "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM", subscription.p256dh_key
+    assert_equal "tBHItJI5svbpez7KI4CCXg", subscription.auth_key
+  end
+
+  test "create accepts flat json" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        endpoint: "https://push.example.com/subscriptions/2",
+        p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+        auth_key: "tBHItJI5svbpez7KI4CCXg"
+      }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create updates the keys for an existing endpoint" do
+    endpoint = "https://push.example.com/subscriptions/1"
+    @user.push_subscriptions.create!(endpoint: endpoint, p256dh_key: "old", auth_key: "old")
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: endpoint, p256dh_key: "new", auth_key: "new" }
+      }
+    end
+
+    assert_response :created
+    assert_equal "new", @user.push_subscriptions.find_by(endpoint: endpoint).p256dh_key
+  end
+
+  test "cannot subscribe another user" do
+    assert_no_difference -> { User.find(users(:kevin).id).push_subscriptions.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/3",
+          p256dh_key: "key",
+          auth_key: "key"
+        }
+      }
+    end
+
+    assert_response :forbidden
+  end
+end
