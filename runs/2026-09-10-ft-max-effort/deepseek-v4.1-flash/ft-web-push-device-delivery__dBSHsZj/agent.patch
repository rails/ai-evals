diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..d59ee1f
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,55 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user, only: :create
+  before_action :set_subscription, only: :destroy
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.assign_attributes subscription_params
+    subscription.user_agent = request.user_agent
+    subscription.save!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on" }
+      format.json { render json: { id: subscription.id }, status: :created }
+    end
+  end
+
+  def destroy
+    @subscription.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned off" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def set_subscription
+      if @user == Current.user
+        @subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+          @user.push_subscriptions.find_by(endpoint: endpoint_param)
+        head :not_found unless @subscription
+      else
+        head :forbidden
+      end
+    end
+
+    def endpoint_param
+      params.dig(:push_subscription, :endpoint).presence || params[:endpoint].presence || params[:id]
+    end
+
+    def subscription_params
+      params.require(:push_subscription).permit(:endpoint, :p256dh_key, :auth_key)
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..44cb26e
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,122 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Turns web push notifications on and off for the current device. The browser
+// hands us the subscription from its push service; we register it with the
+// server so notifications can be delivered here as well as to the tray.
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = { url: String, publicKey: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  async enable(event) {
+    event?.preventDefault()
+
+    if (!this.supported) return
+
+    if (Notification.permission !== "granted") {
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") return this.refresh()
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.applicationServerKey
+    })
+
+    await this.#create(subscription)
+    this.subscription = subscription
+    this.refresh()
+  }
+
+  async disable(event) {
+    event?.preventDefault()
+
+    const subscription = this.subscription || await this.currentSubscription()
+
+    if (subscription) {
+      await this.#destroy(subscription)
+      await subscription.unsubscribe()
+    }
+
+    this.subscription = null
+    this.refresh()
+  }
+
+  async refresh() {
+    this.subscription = await this.currentSubscription()
+    this.element.classList.toggle("notifications--on", Boolean(this.subscription))
+    this.#refreshDetails()
+  }
+
+  async currentSubscription() {
+    if (!this.supported) return null
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      return await registration.pushManager.getSubscription()
+    } catch {
+      return null
+    }
+  }
+
+  get supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get applicationServerKey() {
+    const value = (this.hasPublicKeyValue ? this.publicKeyValue : "").trim()
+    if (!value) return undefined
+
+    const padding = "=".repeat((4 - (value.length % 4)) % 4)
+    const base64 = (value + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+  }
+
+  async #create(subscription) {
+    const json = subscription.toJSON()
+
+    await this.#request(this.urlValue, "POST", {
+      push_subscription: {
+        endpoint: json.endpoint,
+        p256dh_key: json.keys.p256dh,
+        auth_key: json.keys.auth
+      }
+    })
+  }
+
+  async #destroy(subscription) {
+    const url = `${this.urlValue}?endpoint=${encodeURIComponent(subscription.endpoint)}`
+
+    await this.#request(url, "DELETE")
+  }
+
+  async #request(url, method, body) {
+    const response = await fetch(url, {
+      method,
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      },
+      body: body && JSON.stringify(body)
+    })
+
+    if (!response.ok) throw new Error(`Push subscription request failed (${response.status})`)
+  }
+
+  #refreshDetails() {
+    const blocked = this.supported && Notification.permission === "denied"
+
+    this.detailsTargets.forEach((details) => details.toggleAttribute("hidden", !blocked))
+  }
+
+  get #csrfToken() {
+    return document.querySelector('meta[name="csrf-token"]')?.content
+  }
+}
