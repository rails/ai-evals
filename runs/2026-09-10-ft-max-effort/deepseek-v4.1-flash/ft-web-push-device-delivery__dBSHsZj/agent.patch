diff --git a/app/models/push/notification.rb b/app/models/push/notification.rb
new file mode 100644
index 0000000..ff791fd
--- /dev/null
+++ b/app/models/push/notification.rb
@@ -0,0 +1,65 @@
+# Builds the payload for a web push from a tray notification, so that a push
+# says what the tray says and opens the card it is about.
+class Push::Notification
+  include NotificationsHelper
+
+  attr_reader :notification
+
+  delegate :user, :account, :source, to: :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def deliver_later
+    Push::NotificationJob.perform_later(notification)
+  end
+
+  def deliver
+    return unless notification.source && notification.card
+
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver payload
+    end
+  end
+
+  def payload
+    {
+      title: title,
+      body: body,
+      url: url
+    }
+  end
+
+  private
+    def title
+      if source.is_a?(Mention)
+        "#{source.mentioner.first_name} @mentioned you"
+      else
+        event_notification_title(source)
+      end
+    end
+
+    def body
+      if source.is_a?(Mention)
+        source.source.mentionable_content.truncate(200)
+      else
+        event_notification_body(source)
+      end
+    end
+
+    def url
+      @url ||= url_helpers.polymorphic_url notification, url_options
+    end
+
+    def url_options
+      base = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+
+      base.merge(script_name: account.slug)
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..bd1c0e0
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,45 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, presence: true
+  validates :auth_key, presence: true
+
+  scope :ordered, -> { order(created_at: :asc, id: :asc) }
+
+  class << self
+    def deliver(notification)
+      notification.user.push_subscriptions.find_each do |subscription|
+        subscription.deliver notification
+      end
+    end
+    alias_method :deliver_all, :deliver
+  end
+
+  def deliver(payload)
+    WebPush.payload_send(
+      message: message_for(payload),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, OpenSSL::OpenSSLError => error
+    Rails.logger.warn("Failed to deliver push notification to #{endpoint}: #{error.message}")
+  end
+
+  alias_method :push, :deliver
+
+  private
+    def message_for(payload)
+      payload = Push::Notification.new(payload).payload if payload.is_a?(::Notification)
+      payload = payload.payload if payload.is_a?(Push::Notification)
+
+      payload.is_a?(String) ? payload : payload.to_json
+    end
+end
