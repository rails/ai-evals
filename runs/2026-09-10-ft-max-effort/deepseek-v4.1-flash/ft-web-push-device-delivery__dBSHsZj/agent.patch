diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..cd4303b
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers the subscription for the current device" do
+    assert_difference -> { Push::Subscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscription",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, headers: { "User-Agent" => "Test Browser" }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = Push::Subscription.last
+    assert_equal @user, subscription.user
+    assert_equal accounts("37s"), subscription.account
+    assert_equal "https://push.example.com/subscription", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal "Test Browser", subscription.user_agent
+  end
+
+  test "create is idempotent for the same endpoint" do
+    params = {
+      push_subscription: {
+        endpoint: "https://push.example.com/subscription",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    }
+
+    post user_push_subscriptions_path(@user), params: params, as: :json
+    assert_response :created
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: params, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create allows the same endpoint for another user" do
+    other = users(:kevin)
+    subscription = other.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { Push::Subscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscription",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal other, subscription.reload.user
+    assert_equal @user, Push::Subscription.last.user
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscription",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create requires an endpoint" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { p256dh_key: "p256dh-key", auth_key: "auth-key" }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy removes the subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy by endpoint removes the subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      delete user_destroy_push_subscription_path(@user), params: { endpoint: subscription.endpoint }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for another user's subscription" do
+    subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(users(:kevin), subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/jobs/push/notification_job_test.rb b/test/jobs/push/notification_job_test.rb
new file mode 100644
index 0000000..9b88d5f
--- /dev/null
+++ b/test/jobs/push/notification_job_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Push::NotificationJobTest < ActiveSupport::TestCase
+  test "delivers a push that says what the tray says" do
+    user = users(:kevin)
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notification = notifications(:logo_assignment_kevin)
+    payload = Push::Notification.new(notification).payload
+
+    assert_equal "The logo isn't big enough", payload[:title]
+    assert_equal "Assigned to Kevin", payload[:body]
+
+    WebPush.expects(:payload_send).with(
+      message: payload.to_json,
+      endpoint: "https://push.example.com/subscription",
+      p256dh: "p256dh-key",
+      auth: "auth-key",
+      vapid: Push.vapid
+    )
+
+    Push::NotificationJob.perform_now(notification)
+  end
+
+  test "delivers a push for a mention" do
+    user = users(:david)
+    user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/david",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notification = notifications(:logo_mentioned_david)
+    payload = Push::Notification.new(notification).payload
+
+    assert_equal "JZ @mentioned you", payload[:title]
+    assert_equal "I agree.", payload[:body]
+    assert_includes payload[:url], "/cards/1#comment_"
+
+    WebPush.expects(:payload_send).once
+
+    Push::NotificationJob.perform_now(notification)
+  end
+
+  test "creating an unread notification enqueues a push" do
+    users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.com/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Push::NotificationJob) do
+      Notification.create!(user: users(:kevin), source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "does not enqueue a push when the user has no subscriptions" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs only: Push::NotificationJob do
+      Notification.create!(user: users(:kevin), source: events(:layout_commented), creator: users(:david))
+    end
+  end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..34bca5b
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  test "valid with endpoint and keys" do
+    subscription = Push::Subscription.new(
+      user: users(:david),
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert subscription.valid?
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "requires an endpoint" do
+    subscription = Push::Subscription.new(user: users(:david), p256dh_key: "p256dh", auth_key: "auth")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+  end
+
+  test "requires a p256dh key" do
+    subscription = Push::Subscription.new(user: users(:david), endpoint: "https://push.example.com/a", auth_key: "auth")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+  end
+
+  test "requires an auth key" do
+    subscription = Push::Subscription.new(user: users(:david), endpoint: "https://push.example.com/a", p256dh_key: "p256dh")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "requires a unique endpoint per user" do
+    Push::Subscription.create!(
+      user: users(:david),
+      endpoint: "https://push.example.com/shared",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    duplicate = Push::Subscription.new(
+      user: users(:david),
+      endpoint: "https://push.example.com/shared",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:endpoint], "has already been taken"
+  end
+
+  test "allows the same endpoint for a different user" do
+    Push::Subscription.create!(
+      user: users(:david),
+      endpoint: "https://push.example.com/shared",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    other = Push::Subscription.new(
+      user: users(:kevin),
+      endpoint: "https://push.example.com/shared",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert other.valid?
+  end
+
+  test "deliver sends the payload to the push service" do
+    subscription = Push::Subscription.create!(
+      user: users(:david),
+      endpoint: "https://push.example.com/subscription",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    WebPush.expects(:payload_send).with(
+      message: { title: "Hi" }.to_json,
+      endpoint: subscription.endpoint,
+      p256dh: subscription.p256dh_key,
+      auth: subscription.auth_key,
+      vapid: Push.vapid
+    )
+
+    subscription.deliver(title: "Hi")
+  end
+
+  test "deliver removes subscriptions the push service reports as gone" do
+    subscription = Push::Subscription.create!(
+      user: users(:david),
+      endpoint: "https://push.example.com/gone",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: ""), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.deliver(title: "Hi")
+    end
+  end
+end
