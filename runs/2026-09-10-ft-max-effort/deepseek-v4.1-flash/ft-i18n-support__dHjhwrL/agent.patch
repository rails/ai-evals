diff --git a/test/controllers/concerns/localization_test.rb b/test/controllers/concerns/localization_test.rb
new file mode 100644
index 0000000..a12b997
--- /dev/null
+++ b/test/controllers/concerns/localization_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "locale param switches to Japanese and remembers it in the session" do
+    untenanted { get new_session_path(locale: "ja") }
+
+    assert_response :success
+    assert_equal "ja", session[:locale]
+    assert_select "html[lang=ja]"
+    assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, response.body)
+  end
+
+  test "an unsupported locale is ignored and never breaks the page" do
+    untenanted { get new_session_path(locale: "xx") }
+    assert_response :success
+    assert_nil session[:locale]
+    assert_select "html[lang=en]"
+  end
+
+  test "the chosen locale sticks for the rest of the session" do
+    untenanted { get new_session_path(locale: "ja") }
+    assert_equal "ja", session[:locale]
+
+    untenanted { get new_session_path }
+    assert_equal "ja", session[:locale]
+    assert_select "html[lang=ja]"
+  end
+
+  test "the chosen locale is stored on the identity and survives a new sign in" do
+    sign_in_as :kevin
+
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    cookies.delete :session_token
+    Session.delete_all
+
+    sign_in_as :kevin
+    get board_path(boards(:writebook))
+
+    assert_response :success
+    assert_equal "ja", session[:locale]
+    assert_select "html[lang=ja]"
+  end
+
+  test "people who never chose a locale still get English" do
+    sign_in_as :david
+    get board_path(boards(:writebook))
+    assert_select "html[lang=en]"
+    assert_no_match(/[\p{Hiragana}\p{Katakana}]/, response.body)
+  end
+
+  test "emails are sent in the recipient's language" do
+    identities(:kevin).update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_match "Fizzyのコード", email.subject
+  end
+  test "public pages switch language too" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.publication.key, locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, response.body)
+  end
+
+  test "static error pages are served in both languages" do
+    %w[400 404 406-unsupported-browser 422 500].each do |name|
+      body = Rails.root.join("public/#{name}.html").read
+      assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, body, "#{name} should include Japanese")
+      assert_match(/Back home/, body, "#{name} should include English")
+    end
+  end
+
+end
