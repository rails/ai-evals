diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..804f1e6
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,54 @@
+# Handles choosing the locale for each request.
+#
+# A locale can be requested with a `?locale=` parameter. Only locales that the
+# app actually ships are honored; anything else is ignored so that a bogus
+# parameter can never break a page. The choice is remembered in the session so
+# it sticks for the rest of the visit, and, once someone is signed in, it is
+# also stored against their identity so it follows them to new browsers.
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :use_locale
+    helper_method :current_locale
+
+    # Pages must not be served from a cache holding another language.
+    etag { I18n.locale }
+  end
+
+  private
+    def use_locale(&)
+      requested_locale = recognize_locale(params[:locale])
+      session[:locale] = requested_locale if requested_locale
+
+      I18n.with_locale(current_locale.to_sym, &)
+    ensure
+      remember_locale(requested_locale)
+    end
+
+    def current_locale
+      recognize_locale(session[:locale]) || recognize_locale(Current.identity&.locale) || I18n.default_locale.to_s
+    end
+
+    def recognize_locale(value)
+      value = value.to_s
+      value if value.present? && I18n.available_locales.map(&:to_s).include?(value)
+    end
+
+    # Keep the session and the signed-in identity in sync with the locale that
+    # was chosen, in both directions: an explicit pick is saved to the
+    # identity, and an identity's stored locale is adopted when a session
+    # starts without one.
+    def remember_locale(requested_locale)
+      return unless Current.identity
+
+      chosen_locale = requested_locale || recognize_locale(session[:locale])
+
+      if chosen_locale
+        session[:locale] = chosen_locale
+        Current.identity.update_column(:locale, chosen_locale) if Current.identity.locale != chosen_locale
+      elsif (identity_locale = recognize_locale(Current.identity.locale))
+        session[:locale] = identity_locale
+      end
+    end
+end
