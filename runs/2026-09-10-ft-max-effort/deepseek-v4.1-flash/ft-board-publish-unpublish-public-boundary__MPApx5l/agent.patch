@@ -0,0 +1,42 @@
+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="cards cards--grid">
+  <% @columns.each do |column| %>
+    <div class="cards--doing" id="<%= dom_id(column) %>">
+      <header class="cards__header">
+        <h2 class="cards__title">
+          <%= link_to column.name, public_board_column_path(@board.key, column) %>
+        </h2>
+      </header>
+
+      <div class="cards__list">
+        <% column.cards.published.chronologically.each do |card| %>
+          <%= render "public/cards/card", card: card %>
+        <% end %>
+      </div>
+    </div>
+  <% end %>
+</section>
+
+<% uncolumned_cards = @board.cards.published.where(column_id: nil).chronologically %>
+<% if uncolumned_cards.any? %>
+  <section class="cards cards--grid">
+    <div class="cards--doing">
+      <header class="cards__header">
+        <h2 class="cards__title">Maybe</h2>
+      </header>
+
+      <div class="cards__list">
+        <% uncolumned_cards.each do |card| %>
+          <%= render "public/cards/card", card: card %>
+        <% end %>
+      </div>
+    </div>
+  </section>
+<% end %>
