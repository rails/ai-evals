diff --git a/app/models/board/publicly_accessible.rb b/app/models/board/publicly_accessible.rb
new file mode 100644
index 0000000..8c35dd2
--- /dev/null
+++ b/app/models/board/publicly_accessible.rb
@@ -0,0 +1,53 @@
+module Board::PubliclyAccessible
+  extend ActiveSupport::Concern
+
+  KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(key: nil) }
+
+    validates :key, uniqueness: true, allow_nil: true
+  end
+
+  def publish
+    update! key: generate_key unless published?
+  end
+
+  def unpublish
+    update! key: nil
+  end
+
+  def published?
+    key.present?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+
+  alias_method :publish!, :publish
+  alias_method :unpublish!, :unpublish
+  alias_method :public?, :published?
+
+  def public_url
+    public_board_url(key, **public_url_options) if published?
+  end
+
+  private
+    def generate_key
+      loop do
+        candidate = SecureRandom.base58(KEY_LENGTH)
+        break candidate unless self.class.exists?(key: candidate)
+      end
+    end
+
+    def public_board_url(...)
+      Rails.application.routes.url_helpers.public_board_url(...)
+    end
+
+    def public_url_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      options.symbolize_keys
+    end
+end
