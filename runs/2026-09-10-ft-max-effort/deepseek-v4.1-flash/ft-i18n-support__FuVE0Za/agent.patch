diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..50ea4bf
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "renders in English by default" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_match "Enter your email", response.body
+    assert_no_match(/[\p{Hiragana}\p{Katakana}]/, response.body)
+  end
+
+  test "?locale=ja switches the page to Japanese" do
+    untenanted do
+      get new_session_path(locale: :ja)
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "メールアドレスを入力", response.body
+  end
+
+  test "the chosen locale persists for the rest of the session" do
+    untenanted do
+      get new_session_path(locale: :ja)
+    end
+    assert_response :success
+
+    untenanted do
+      get new_session_path
+    end
+    assert_select "html[lang=ja]"
+  end
+
+  test "the chosen locale persists across requests when signed in" do
+    sign_in_as :david
+
+    get events_path(locale: :ja)
+    assert_response :success
+
+    get events_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "an unknown locale is ignored" do
+    untenanted do
+      get new_session_path(locale: :xx)
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_match "Enter your email", response.body
+  end
+
+  test "choosing a locale remembers it on the identity" do
+    sign_in_as :david
+
+    get events_path(locale: :ja)
+    assert_response :success
+
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "a remembered locale survives a clean browser sign in" do
+    identities(:david).update!(locale: "ja")
+
+    reset!
+    sign_in_as :david
+
+    get events_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "ホーム", response.body
+  end
+
+test "mailers render in the recipient's locale" do
+  identity = identities(:david)
+  identity.update!(locale: "ja")
+
+  magic_link = identity.magic_links.create!(code: "ABC123", expires_at: 15.minutes.from_now)
+  mail = MagicLinkMailer.sign_in_instructions(magic_link).deliver_now
+
+  assert_match "Fizzyのコード", mail.subject
+end
+
+  test "static error pages render in both languages" do
+    %w[400 404 422 500].each do |code|
+      body = Rails.root.join("public/#{code}.html").read
+      assert_match "Back home", body
+      assert_match "ホームに戻る", body
+    end
+  end
+end
