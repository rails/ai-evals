diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..85ea39a
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,75 @@
+# Resolves the locale for each request.
+#
+# The locale can come from:
+#
+# * an explicit `?locale=` param. Only locales in I18n.available_locales are
+#   honored, and choosing one remembers it for the rest of the session and,
+#   when signed in, on the identity so it survives a clean browser.
+# * the locale remembered on the identity (or session for anonymous people).
+# * otherwise, the default locale.
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+    after_action :reset_locale
+
+    helper_method :current_locale
+  end
+
+  private
+    def set_locale
+      @previous_locale = I18n.locale
+      I18n.locale = resolved_locale
+    end
+
+    def reset_locale
+      I18n.locale = @previous_locale if defined?(@previous_locale)
+    end
+
+    def resolved_locale
+      locale_from_param || remembered_locale || I18n.default_locale
+    end
+
+    def locale_from_param
+      requested = params[:locale].to_s
+
+      if requested.present? && I18n.available_locales.include?(requested.to_sym)
+        locale = requested.to_sym
+        remember_locale(locale)
+        locale
+      end
+    end
+
+    def remembered_locale
+      locale = session[:locale].presence || Current.identity&.locale.presence
+
+      if locale.present? && I18n.available_locales.include?(locale.to_sym)
+        remember_session_locale_on_identity
+        locale.to_sym
+      end
+    end
+
+    # A locale chosen before signing in is carried into the session. Once we
+    # know who this is, keep it on the identity so it survives a clean browser.
+    def remember_session_locale_on_identity
+      return if session[:locale].blank?
+      return unless Current.identity&.persisted?
+      return unless Current.identity.has_attribute?(:locale)
+      return if Current.identity.locale.present?
+
+      Current.identity.update_column(:locale, session[:locale])
+    end
+
+    def remember_locale(locale)
+      session[:locale] = locale.to_s
+
+      if Current.identity&.persisted? && Current.identity.has_attribute?(:locale)
+        Current.identity.update_column(:locale, locale.to_s)
+      end
+    end
+
+    def current_locale
+      I18n.locale
+    end
+end
