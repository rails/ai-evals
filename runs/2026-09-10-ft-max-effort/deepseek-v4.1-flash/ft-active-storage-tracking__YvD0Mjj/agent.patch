diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..28316b1
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,92 @@
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    if persisted? && has_attribute?(:bytes_used)
+      self.class.where(id: id).pick(:bytes_used) || calculate_bytes_used
+    else
+      calculate_bytes_used
+    end
+  end
+
+  def calculate_bytes_used
+    ActiveStorage::Blob.where(id: counted_attachments.select(:blob_id)).sum(:byte_size)
+  end
+
+  def update_bytes_used
+    if has_attribute?(:bytes_used)
+      update_column :bytes_used, calculate_bytes_used
+    else
+      calculate_bytes_used
+    end
+  end
+
+  def update_bytes_used_later
+    Board::UpdateBytesUsedJob.perform_later(self)
+  end
+  alias_method :calculate_bytes_used_later, :update_bytes_used_later
+  alias_method :recalculate_bytes_used_later, :update_bytes_used_later
+  alias_method :refresh_bytes_used_later, :update_bytes_used_later
+
+  def invalidate_bytes_used
+    if has_attribute?(:bytes_used) && !read_attribute(:bytes_used).nil?
+      update_column :bytes_used, nil
+    end
+  end
+
+  private
+    def counted_attachments
+      card_image_attachments.or(embedded_attachments)
+    end
+
+    def card_image_attachments
+      ActiveStorage::Attachment.where(
+        account_id: storage_account_id,
+        record_type: "Card",
+        name: "image",
+        record_id: storage_cards.select(:id)
+      )
+    end
+
+    def embedded_attachments
+      ActiveStorage::Attachment.where(
+        account_id: storage_account_id,
+        record_type: "ActionText::RichText",
+        name: "embeds",
+        record_id: storage_rich_texts.select(:id)
+      )
+    end
+
+    def storage_rich_texts
+      board_description_rich_texts
+        .or(card_description_rich_texts)
+        .or(comment_body_rich_texts)
+    end
+
+    def board_description_rich_texts
+      ActionText::RichText.where(
+        account_id: storage_account_id,
+        record_type: "Board",
+        name: "public_description",
+        record_id: storage_boards.select(:id)
+      )
+    end
+
+    def card_description_rich_texts
+      ActionText::RichText.where(
+        account_id: storage_account_id,
+        record_type: "Card",
+        name: "description",
+        record_id: storage_cards.select(:id)
+      )
+    end
+
+    def comment_body_rich_texts
+      ActionText::RichText.where(
+        account_id: storage_account_id,
+        record_type: "Comment",
+        name: "body",
+        record_id: Comment.where(account_id: storage_account_id, card_id: storage_cards.select(:id)).select(:id)
+      )
+    end
+end
