diff --git a/lib/rails_ext/storage_usage_attachment.rb b/lib/rails_ext/storage_usage_attachment.rb
new file mode 100644
index 0000000..20b49a4
--- /dev/null
+++ b/lib/rails_ext/storage_usage_attachment.rb
@@ -0,0 +1,58 @@
+module StorageUsageAttachment
+  def self.prepended(base)
+    base.after_commit :update_storage_usage_later
+  end
+
+  def delete
+    board = storage_usage_board
+    super
+  ensure
+    update_storage_usage_for(board) if board
+  end
+
+  private
+    def update_storage_usage_later
+      if board = storage_usage_board
+        update_storage_usage_for(board)
+      end
+    end
+
+    def update_storage_usage_for(board)
+      return unless board&.persisted?
+
+      board.invalidate_bytes_used
+      board.account&.invalidate_bytes_used
+      Board::UpdateBytesUsedJob.perform_later(board)
+    end
+
+    def storage_usage_board
+      case record_type
+      when "Card"
+        storage_usage_board_for_card if name == "image"
+      when "ActionText::RichText"
+        storage_usage_board_for_rich_text if name == "embeds"
+      end
+    end
+
+    def storage_usage_board_for_card
+      Card.find_by(id: record_id)&.board
+    end
+
+    def storage_usage_board_for_rich_text
+      rich_text = ActionText::RichText.find_by(id: record_id)
+      return unless rich_text
+
+      case rich_text.record_type
+      when "Board"
+        Board.find_by(id: rich_text.record_id)
+      when "Card"
+        Card.find_by(id: rich_text.record_id)&.board
+      when "Comment"
+        Comment.find_by(id: rich_text.record_id)&.board
+      end
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend StorageUsageAttachment
+end
