+require "test_helper"
+
+class NotificationMailerVerificationTest < ActionMailer::TestCase
+  setup do
+    @user = users(:jz)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notification = Notification.create!(user: @user, source: events(:logo_assignment_km), creator: users(:david))
+    @bundle = @notification.bundle
+    @email = NotificationMailer.bundle(@bundle)
+  end
+
+  test "bundle email is sent to the user" do
+    assert_equal [ @user.identity.email_address ], @email.to
+  end
+
+  test "bundle email has both html and text parts" do
+    assert @email.html_part.present?, "Email should have HTML part"
+    assert @email.text_part.present?, "Email should have text part"
+  end
+
+  test "bundle email includes the notification" do
+    assert_match "logo isn't big enough", @email.body.encoded
+    assert_match "David", @email.body.encoded
+  end
+
+  test "bundle email links to notification settings" do
+    assert_match "/notifications/settings", @email.body.encoded
+  end
+
+  test "bundle email subject mentions notifications" do
+    assert_match(/notification/i, @email.subject)
+  end
+
+  test "delivering the bundle email" do
+    assert_emails 1 do
+      @email.deliver_now
+    end
+  end
+end
+
+class NotificationMailerMentionVerificationTest < ActionMailer::TestCase
+  test "renders mention notifications" do
+    david = users(:david)
+    david.notification_bundles.destroy_all
+    david.settings.update!(bundle_email_frequency: :daily)
+
+    bundle = Notification::Bundle.create!(user: david, account: david.account)
+    bundle.notifications << notifications(:logo_mentioned_david)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_match "mentioned you", email.body.encoded
+  end
+end
