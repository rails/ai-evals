+require "test_helper"
+
+class NotificationSettingsVerificationTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "show includes email frequency options" do
+    get notifications_settings_path
+
+    assert_response :success
+    assert_match "Every 4 hours", response.body
+    assert_match "Weekly", response.body
+  end
+
+  test "update changes the bundle email frequency" do
+    patch notifications_settings_path, params: { bundle_email_frequency: "weekly" }
+
+    assert_redirected_to notifications_settings_path
+    assert_equal "weekly", @user.settings.reload.bundle_email_frequency
+  end
+
+  test "update ignores invalid frequencies" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    patch notifications_settings_path, params: { bundle_email_frequency: "sometimes" }
+
+    assert_redirected_to notifications_settings_path
+    assert_equal "daily", @user.settings.reload.bundle_email_frequency
+  end
+end
