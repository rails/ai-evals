diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..800d55f
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,106 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, dependent: :nullify, inverse_of: :bundle
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :open, -> { pending }
+  scope :undelivered, -> { pending }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :ordered, -> { order(:starts_at) }
+  scope :due, -> { pending.where("COALESCE(notification_bundles.ends_at, notification_bundles.deliver_at) <= ?", Time.current) }
+
+  before_validation :set_window, on: :create
+  after_create_commit :schedule_delivery
+
+  class << self
+    def for(record)
+      user = record.is_a?(User) ? record : record.user
+      pending_for(user) || create_for(user)
+    end
+    alias_method :add, :for
+
+    def pending_for(user)
+      where(user: user).pending.ordered.last
+    end
+
+    def create_for(user)
+      if settings = user.settings
+        if settings.bundle_email? && (interval = settings.bundle_email_interval)
+          now = Time.current
+          create!(user: user, starts_at: now, ends_at: now + interval)
+        end
+      end
+    end
+
+    def deliver_due
+      due.find_each(&:deliver)
+    end
+    alias_method :deliver_all, :deliver_due
+    alias_method :deliver_pending, :deliver_due
+  end
+
+  def deliver
+    with_lock do
+      return if delivered?
+
+      if deliverable?
+        Current.with_account(account) do
+          NotificationMailer.bundle(self).deliver_now
+        end
+      end
+
+      update!(delivered_at: Time.current)
+    end
+  end
+
+  def deliver_later
+    Notification::BundleJob.set(wait_until: deliver_at).perform_later(self)
+  end
+
+  def deliverable?
+    user.active? && account.active? && user.settings&.bundle_email? && user.identity&.email_address.present? && notifications.any?
+  end
+
+  def due?
+    pending? && deliver_at.present? && deliver_at <= Time.current
+  end
+
+  def pending?
+    !delivered?
+  end
+  alias_method :open?, :pending?
+  alias_method :undelivered?, :pending?
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def deliver_at
+    self[:ends_at] || self[:deliver_at] || ends_at_from_frequency
+  end
+
+  private
+    def set_window
+      self[:frequency] ||= user&.settings&.bundle_email_frequency
+      self.starts_at ||= Time.current
+      self.ends_at ||= self[:deliver_at] || starts_at + default_interval
+      self[:deliver_at] ||= ends_at
+    end
+
+    def schedule_delivery
+      deliver_later
+    end
+
+    def default_interval
+      User::Settings::BUNDLE_EMAIL_INTERVALS[self[:frequency]] ||
+        user&.settings&.bundle_email_interval || 4.hours
+    end
+
+    def ends_at_from_frequency
+      if (base = starts_at || created_at) && (interval = User::Settings::BUNDLE_EMAIL_INTERVALS[self[:frequency].presence || user&.settings&.bundle_email_frequency])
+        base + interval
+      end
+    end
+end
