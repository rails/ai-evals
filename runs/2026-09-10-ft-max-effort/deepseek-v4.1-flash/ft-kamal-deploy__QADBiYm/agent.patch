+# Secrets referenced from config/deploy.yml.
+#
+# Kamal reads this file as shell/dotenv, so values can come from your
+# environment, a command, or a password manager. Values are only used where
+# config/deploy.yml lists them under `env.secret`, so this file is safe to
+# commit as long as you don't paste raw credentials into it.
+
+# Rails needs a stable secret key base in production. Generate one once and keep
+# it somewhere safe (changing it invalidates existing sessions):
+#
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# The password for your SMTP server, if it requires authentication.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Only needed if you use `bin/rails credentials:edit`. Export it or point this at
+# the generated file:
+#
+#   RAILS_MASTER_KEY=$(cat config/master.key)
+#
+RAILS_MASTER_KEY=$RAILS_MASTER_KEY
