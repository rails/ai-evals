--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,88 @@
+# Kamal configuration for a single-server, self-hosted Fizzy.
+#
+# This is the "one box" setup: one Linux server running Docker. SQLite, uploaded
+# files, and background jobs all live inside the app container, and kamal-proxy
+# terminates TLS with an automatic Let's Encrypt certificate.
+#
+# To deploy:
+#   1. Fill in the values marked "TODO" below (your server, hostname, and mail
+#      server details).
+#   2. Add your secrets to .kamal/secrets.
+#   3. Run: bin/kamal setup
+#
+# See docs/self-hosting.md for the full walkthrough.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. It is built locally by Kamal and pushed to the
+# local registry that Kamal starts (see `registry` below), so you don't need a
+# Docker Hub, GHCR, or any other hosted registry account.
+image: fizzy
+
+# The servers to deploy to. For a one-box setup this is just your server's SSH
+# hostname or IP address.
+servers:
+  web:
+    - fizzy.example.com # TODO: your server's hostname or IP address
+
+# kamal-proxy serves the app and requests a Let's Encrypt certificate for the
+# hostname below. The hostname must resolve to your server and ports 80 and 443
+# must be open.
+proxy:
+  ssl: true
+  host: fizzy.example.com # TODO: the hostname you'll serve Fizzy from
+
+# Kamal builds the image on your machine and ships it to the server through a
+# local registry forwarded over SSH.
+registry:
+  server: localhost:5555
+
+# Build for the architecture of your server. Use arm64 for an ARM server.
+builder:
+  arch: amd64
+
+# Environment variables injected into the app container. Secrets live in
+# .kamal/secrets, everything else can be set here.
+env:
+  clear:
+    # The canonical hostname, used to generate links in emails, notifications,
+    # and webhooks. Must match the proxy host above.
+    APP_FQDN: fizzy.example.com # TODO: the hostname you'll serve Fizzy from
+
+    # The "From" address shown on emails Fizzy sends.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com> # TODO: your from address
+
+    # The mail server used to send email (e.g. magic links).
+    SMTP_ADDRESS: smtp.example.com # TODO: your mail server's hostname
+    SMTP_PORT: 587 # TODO: 587 for STARTTLS, 465 for implicit TLS
+    SMTP_USERNAME: fizzy@example.com # TODO: your mail server username
+
+    # Run Solid Queue's dispatcher and workers inside the web container so
+    # background jobs run on the box without a separate job server.
+    SOLID_QUEUE_IN_PUMA: true
+
+  # Secrets are read from .kamal/secrets.
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - RAILS_MASTER_KEY
+
+# Persist the SQLite databases and uploaded files across deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep the previous release's assets available during a deploy so in-flight
+# requests don't hit 404s.
+asset_path: /rails/public/assets
+
+# Handy shortcuts: bin/kamal console, bin/kamal shell, bin/kamal logs, bin/kamal dbc.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# Uncomment and set if you SSH into your server as a user other than root.
+# ssh:
+#   user: deploy
