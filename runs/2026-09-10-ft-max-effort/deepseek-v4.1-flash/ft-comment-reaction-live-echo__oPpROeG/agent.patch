new file mode 100644
index 0000000..23ce75a
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,38 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { card&.account || comment&.account }
+  belongs_to :card, optional: true, touch: true
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  normalizes :content, with: ->(content) { content.to_s.strip }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+  validate :has_a_target
+
+  after_create :register_card_activity
+
+  def target
+    comment || card
+  end
+
+  def to_partial_path
+    "reactions/reaction"
+  end
+
+  private
+    def has_a_target
+      errors.add(:base, "must belong to a card or a comment") unless card || comment
+    end
+
+    def parent_card
+      card || comment&.card
+    end
+
+    def register_card_activity
+      parent_card&.touch_last_active_at
+    end
+end
