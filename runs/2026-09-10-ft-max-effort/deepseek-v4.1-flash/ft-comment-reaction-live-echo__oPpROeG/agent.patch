diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..dc42fda
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,45 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  open(event) {
+    event.preventDefault()
+
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  close(event) {
+    if (event) event.preventDefault()
+
+    this.formTarget.classList.remove("expanded", "reaction")
+    this.formTarget.hidden = true
+    this.formTarget.reset()
+    this.triggerTarget.hidden = false
+  }
+
+  submitted(event) {
+    if (event.detail.success) {
+      this.close()
+    }
+  }
+
+  expand(event) {
+    const reaction = event.currentTarget
+
+    if (reaction.dataset.creatorId === this.#currentUserId) {
+      reaction.classList.toggle("expanded")
+    }
+  }
+
+  stop(event) {
+    event.stopPropagation()
+  }
+
+  get #currentUserId() {
+    return document.querySelector('meta[name="current-user-id"]')?.content
+  }
+}
