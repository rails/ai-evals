diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..acfd79a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,222 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const CONTAINER_SELECTOR = "[data-drag-and-drop-target='container']"
+
+export default class extends Controller {
+  static targets = [ "container" ]
+
+  // Lifecycle
+
+  connect() {
+    this.draggedCard = null
+    this.hoveredContainer = null
+  }
+
+  // Actions
+
+  dragStart(event) {
+    const card = event.target.closest(".card")
+    if (!this.#canDrag(card)) return
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const container = this.#containerFrom(event)
+    if (!container) return
+
+    // Columns keep their own order: dropping a card back where it came from
+    // should not reorder it within the column.
+    if (container === this.#sourceContainer) {
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "none"
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    if (this.hoveredContainer !== container) {
+      this.#clearHover()
+      this.hoveredContainer = container
+      container.classList.add(HOVER_CLASS)
+    }
+  }
+
+  dragLeave(event) {
+    const container = this.#containerFrom(event)
+    if (!container) return
+    if (event.relatedTarget && container.contains(event.relatedTarget)) return
+
+    container.classList.remove(HOVER_CLASS)
+    if (this.hoveredContainer === container) this.hoveredContainer = null
+  }
+
+  async drop(event) {
+    const container = this.#containerFrom(event)
+    if (!container) return
+
+    event.preventDefault()
+
+    const card = this.draggedCard
+    const sourceContainer = this.#sourceContainer
+    this.#clearHover()
+
+    if (!card || container === sourceContainer) return
+
+    card.classList.remove(DRAGGED_CLASS)
+    this.draggedCard = null
+
+    this.#moveCard(card, container, sourceContainer)
+    await this.#persist(card, container)
+  }
+
+  dragEnd() {
+    if (this.draggedCard) this.draggedCard.classList.remove(DRAGGED_CLASS)
+    this.draggedCard = null
+    this.#clearHover()
+  }
+
+  // Private
+
+  get #sourceContainer() {
+    return this.draggedCard?.closest(CONTAINER_SELECTOR)
+  }
+
+  #canDrag(card) {
+    return card && this.element.contains(card) && card.getAttribute("draggable") === "true"
+  }
+
+  #containerFrom(event) {
+    const container = event.target.closest(CONTAINER_SELECTOR)
+    if (container && this.element.contains(container)) return container
+  }
+
+  #clearHover() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(HOVER_CLASS)
+      this.hoveredContainer = null
+    }
+  }
+
+  #moveCard(card, container, sourceContainer) {
+    const targetList = container.querySelector(".cards__list")
+    if (!targetList) return
+
+    const action = container.dataset.dragAndDropAction
+    const destination = targetList.querySelector('[id$="-pagination-contents-1"]') || targetList
+
+    this.#removePlaceholders(destination)
+
+    // The board sorts cards through the column scope: golden cards first, then
+    // most recently active. Mirror that so the broadcast refresh that follows
+    // the save morphs the card without moving it.
+    if (this.#goldenFirst(action) && !card.classList.contains("golden-effect")) {
+      const goldenCards = destination.querySelectorAll(".card.golden-effect")
+      const lastGoldenCard = goldenCards[goldenCards.length - 1]
+
+      if (lastGoldenCard) {
+        lastGoldenCard.after(card)
+      } else {
+        destination.prepend(card)
+      }
+    } else {
+      destination.prepend(card)
+    }
+
+    this.#refreshEmptyState(sourceContainer)
+    this.#updateCount(sourceContainer, -1)
+    this.#updateCount(container, 1)
+  }
+
+  #goldenFirst(action) {
+    return action === "triage" || action === "maybe"
+  }
+
+  #removePlaceholders(container) {
+    container.querySelectorAll(":scope > .blank-slate").forEach(placeholder => placeholder.remove())
+  }
+
+  #refreshEmptyState(section) {
+    if (!section || section.id === "maybe") return
+
+    const list = section.querySelector(".cards__list")
+    if (!list || list.querySelector(".card") || list.querySelector(".blank-slate")) return
+
+    list.querySelectorAll("[data-controller~='pagination']").forEach(pagination => {
+      if (!pagination.querySelector(".card")) pagination.remove()
+    })
+
+    list.insertAdjacentHTML("beforeend", `
+      <div class="blank-slate blank-slate--default">No cards here</div>
+      <div class="blank-slate blank-slate--drag overflow-ellipsis">Drag cards here</div>
+    `)
+  }
+
+  #updateCount(section, delta) {
+    if (!section) return
+
+    const counter = section.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    const count = parseInt(counter.textContent, 10)
+    if (isNaN(count)) return
+
+    const nextCount = Math.max(0, count + delta)
+    counter.textContent = nextCount > 99 ? "99+" : nextCount.toString()
+  }
+
+  async #persist(card, container) {
+    const action = container.dataset.dragAndDropAction
+
+    let request
+    switch (action) {
+      case "triage":
+        request = this.#request(card.dataset.cardTriageUrl, "post", { column_id: container.dataset.dragAndDropColumnId })
+        break
+      case "maybe":
+        request = this.#request(card.dataset.cardTriageUrl, "delete")
+        break
+      case "not_now":
+        request = this.#request(card.dataset.cardNotNowUrl, "post")
+        break
+      case "closure":
+        request = this.#request(card.dataset.cardClosureUrl, "post")
+        break
+    }
+
+    if (!request) return
+
+    try {
+      const response = await request.perform()
+      if (!response.ok) throw new Error(`Card move failed with status ${response.statusCode}`)
+    } catch (error) {
+      console.error("Failed to move card", error)
+      this.#resync()
+    }
+  }
+
+  #request(url, method, body) {
+    if (!url) return null
+
+    return new FetchRequest(method, url, { body, responseKind: "json" })
+  }
+
+  #resync() {
+    if (window.Turbo) {
+      window.Turbo.visit(window.location.href, { action: "replace" })
+    } else {
+      window.location.reload()
+    }
+  }
+}
