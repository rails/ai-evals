diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..d0cb19a
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,49 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :ensure_card_is_reactable, only: %i[ new create ]
+
+  with_options only: :destroy do
+    before_action :set_reaction
+    before_action :ensure_permission_to_administer_reaction
+  end
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @card.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render "cards/reactions/show", status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def ensure_card_is_reactable
+      head :forbidden unless @card.reactable?
+    end
+
+    def set_reaction
+      @reaction = @card.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..241bce4
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,36 @@
+module ReactionsHelper
+  def new_reaction_path_for(reactable)
+    case reactable
+    when Card then new_card_reaction_path(reactable)
+    when Comment then new_card_comment_reaction_path(reactable.card, reactable)
+    end
+  end
+
+  def reactions_path_for(reactable)
+    case reactable
+    when Card then card_reactions_path(reactable)
+    when Comment then card_comment_reactions_path(reactable.card, reactable)
+    end
+  end
+
+  def reaction_path_for(reactable, reaction)
+    case reactable
+    when Card then card_reaction_path(reactable, reaction)
+    when Comment then card_comment_reaction_path(reactable.card, reactable, reaction)
+    end
+  end
+
+  def reaction_form_model(reactable)
+    case reactable
+    when Card then [ reactable, Reaction.new ]
+    when Comment then [ reactable.card, reactable, Reaction.new ]
+    end
+  end
+
+  def reaction_url_for(reaction)
+    case reaction.reactable
+    when Card then card_reaction_url(reaction.reactable, reaction)
+    when Comment then card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction)
+    end
+  end
+end
