diff --git a/test/system/card_reaction_test.rb b/test/system/card_reaction_test.rb
new file mode 100644
index 0000000..725fab9
--- /dev/null
+++ b/test/system/card_reaction_test.rb
@@ -0,0 +1,40 @@
+require "application_system_test_case"
+
+class CardReactionTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+  end
+
+  test "reacting to a card from its detail view" do
+    visit card_url(@card)
+
+    within "turbo-frame##{dom_id(@card, :reacting)}" do
+      find("a.reactions__trigger").click
+    end
+
+    fill_in "reaction_content", with: "👍"
+    find("button.reaction__submit-btn").click
+
+    within "turbo-frame##{dom_id(@card, :reacting)}" do
+      assert_selector ".reaction", text: "👍"
+    end
+  end
+
+  test "removing a card reaction" do
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)} .reaction" do
+      find("[data-reaction-delete-target='content']").click
+      find("button.reaction__delete").click
+    end
+
+    within "turbo-frame##{dom_id(@card, :reacting)}" do
+      assert_no_selector ".reaction"
+    end
+  end
+end
