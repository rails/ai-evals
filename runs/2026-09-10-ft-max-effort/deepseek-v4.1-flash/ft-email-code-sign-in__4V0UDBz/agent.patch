+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @email_address.present? %>
+    <p class="txt-medium">We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to continue. It expires in 15 minutes.</p>
+  <% else %>
+    <p class="txt-medium">Enter the six-character code we sent to your email. It expires in 15 minutes.</p>
+  <% end %>
+
+  <%= form_with url: session_code_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", maxlength: 6, class: "input txt-large full-width", placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Sign in</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
