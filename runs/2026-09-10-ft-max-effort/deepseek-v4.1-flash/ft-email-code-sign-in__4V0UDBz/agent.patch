@@ -0,0 +1,56 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def send_sign_in_code_to(identity)
+      identity.generate_sign_in_code
+      IdentityMailer.sign_in_code(identity).deliver_later
+      session[:sign_in_code_email] = identity.email_address
+    end
+
+    def sign_in_with_email_code(code)
+      code = code.to_s.strip
+
+      if identity = Identity.find_by_valid_sign_in_code(code)
+        start_new_session_for identity
+        redirect_after_email_code_sign_in(identity)
+      else
+        redirect_to new_session_code_path, alert: "That code didn't work. Try again."
+      end
+    end
+
+    def remember_email_address(email_address)
+      session[:sign_in_code_email] = email_address
+    end
+
+    def redirect_after_email_code_sign_in(identity)
+      if account_join_code = pending_join_code
+        join_account_using(identity, account_join_code)
+      elsif identity.accounts.active.none?
+        redirect_to new_signup_completion_path
+      else
+        redirect_to after_authentication_url
+      end
+    end
+
+    def remember_join_code(join_code)
+      session[:sign_in_code_join_code] = join_code.code
+    end
+
+    def pending_join_code
+      if code = session.delete(:sign_in_code_join_code)
+        Account::JoinCode.find_by(code: code)
+      end
+    end
+
+    def join_account_using(identity, account_join_code)
+      account_join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: account_join_code.account, identity: identity)
+
+      if user.setup?
+        redirect_to landing_url(script_name: account_join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: account_join_code.account.slug)
+      end
+    end
+end
