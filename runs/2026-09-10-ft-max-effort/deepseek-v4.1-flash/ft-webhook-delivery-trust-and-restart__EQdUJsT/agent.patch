@@ -29,4 +72,83 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def record_response(http_response)
+      code = http_response.code.to_i
+      update!(
+        request: { headers: request_headers },
+        response: { code: code, headers: http_response.to_hash },
+        state: :completed
+      )
+
+      if (200..299).cover?(code)
+        webhook.record_success
+      else
+        webhook.record_failure
+      end
+    end
+
+    def record_error(reason)
+      update!(
+        request: { headers: request_headers },
+        response: { error: reason },
+        state: :errored
+      )
+
+      webhook.record_failure
+    end
+
+    def post
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = DELIVERY_TIMEOUT
+      http.read_timeout = DELIVERY_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http.start { |connection| connection.request(request) }
+    end
+
+    def request_headers
+      @request_headers ||= {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def body
+      @body ||= payload
+    end
+
+    def payload
+      if webhook.for_slack?
+        { text: event_description }.to_json
+      elsif webhook.for_campfire?
+        { message: { body: event_description } }.to_json
+      elsif webhook.for_basecamp?
+        { content: event_description }.to_json
+      else
+        render_event_json
+      end
+    end
+
+    def render_event_json
+      ApplicationController.renderer
+        .new(script_name: webhook.account.slug)
+        .render(template: "webhooks/event", assigns: { event: event }, formats: [ :json ])
+    end
+
+    def event_description
+      event.description_for(nil).to_plain_text
+    end
