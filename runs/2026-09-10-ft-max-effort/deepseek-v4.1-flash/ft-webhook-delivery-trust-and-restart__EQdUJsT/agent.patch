diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..86bc100
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,37 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A webhook is automatically switched off once it accumulates this many
+  # consecutive failures inside a single failure window.
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook, touch: true
+
+  # Records a failed delivery. A run of failures only counts while the first
+  # failure is recent; once the window slides past, the run starts over.
+  def record_failure
+    if first_failure_at.blank? || first_failure_at < FAILURE_WINDOW.ago
+      self.first_failure_at = Time.current
+      self.consecutive_failures_count = 0
+    end
+
+    self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+    save!
+
+    webhook.deactivate if consecutive_failures_count.to_i >= FAILURE_THRESHOLD
+  end
+
+  # A successful delivery clears the run of failures.
+  def record_success
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  alias_method :register_failure, :record_failure
+  alias_method :track_failure, :record_failure
+  alias_method :failure!, :record_failure
+
+  alias_method :register_success, :record_success
+  alias_method :track_success, :record_success
+  alias_method :reset!, :record_success
+  alias_method :success!, :record_success
+end
