+class ZipFileReaderTest < ActiveSupport::TestCase
+  setup do
+    @tempfile = Tempfile.new([ "test", ".zip" ])
+    @tempfile.binmode
+
+    writer = ZipFile::Writer.new(@tempfile)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.add_file("docs/readme.txt") { |sink| sink.write("Readme") }
+    writer.add_file("docs/stored.bin", "Stored", compress: false)
+    writer.close
+    @tempfile.rewind
+  end
+
+  teardown do
+    @tempfile&.close!
+  end
+
+  test "reads files written by the writer" do
+    reader = ZipFile::Reader.new(@tempfile)
