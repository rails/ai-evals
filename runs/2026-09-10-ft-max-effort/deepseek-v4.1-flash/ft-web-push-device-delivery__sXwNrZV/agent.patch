diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..8339894 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,36 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+self.addEventListener("push", (event) => {
+  const payload = event.data ? event.data.json() : {}
+
+  event.waitUntil(
+    self.registration.showNotification(payload.title || "Fizzy", {
+      body: payload.body,
+      icon: "/app-icon-192.png",
+      badge: "/app-icon-192.png",
+      data: { url: payload.url }
+    })
+  )
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openNotification(event.notification.data.url))
+})
+
+async function openNotification(url) {
+  if (!url) return
+
+  const target = new URL(url, self.location.origin).href
+  const windowClients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const existingClient = windowClients.find((client) => client.url.split("#")[0] === target.split("#")[0])
+
+  if (existingClient) {
+    return existingClient.focus()
+  } else {
+    return self.clients.openWindow(target)
+  }
+}
+
 TurboOffline.start()
