index 0000000..a5cf4a4
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,38 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.update!(subscription_params.merge(user_agent: request.user_agent))
+
+    head :created
+  end
+
+  def destroy
+    find_subscription&.destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def find_subscription
+      if params[:id].present?
+        @user.push_subscriptions.find_by(id: params[:id])
+      else
+        @user.push_subscriptions.find_by(endpoint: subscription_params[:endpoint])
+      end
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..9605b13
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,117 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+// Turns web push notifications on and off for the device the person is using,
+// and keeps the browser subscription on the server in sync.
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = {
+    subscribeUrl: String,
+    unsubscribeUrl: String,
+    vapidPublicKey: String
+  }
+
+  async connect() {
+    if (!this.#supported) return
+
+    if (await this.#currentSubscription()) {
+      this.#setEnabled(true)
+    } else {
+      this.#setEnabled(false)
+      this.#showDetails(Notification.permission === "denied")
+    }
+  }
+
+  async enable() {
+    if (!this.#supported) return
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      return this.#showDetails(true)
+    }
+
+    try {
+      const subscription = await this.#subscribe()
+      await this.#save(subscription)
+      this.#setEnabled(true)
+      this.#showDetails(false)
+    } catch (error) {
+      console.error("Failed to enable push notifications", error)
+      this.#showDetails(true)
+    }
+  }
+
+  async disable() {
+    const subscription = await this.#currentSubscription()
+
+    if (subscription) {
+      await this.#destroy(subscription)
+      await subscription.unsubscribe()
+    }
+
+    this.#setEnabled(false)
+  }
+
+  // Private
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async #currentSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return await registration.pushManager.getSubscription()
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    const existingSubscription = await registration.pushManager.getSubscription()
+
+    if (existingSubscription) {
+      return existingSubscription
+    } else {
+      return await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#urlBase64ToUint8Array(this.vapidPublicKeyValue)
+      })
+    }
+  }
+
+  async #save(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    const request = new FetchRequest("post", this.subscribeUrlValue, {
+      body: { push_subscription: { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    await request.perform()
+  }
+
+  async #destroy(subscription) {
+    const { endpoint } = subscription.toJSON()
+
+    const request = new FetchRequest("delete", this.unsubscribeUrlValue, {
+      body: { push_subscription: { endpoint: endpoint } },
+      responseKind: "json"
+    })
+
+    await request.perform()
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+  }
+
+  #showDetails(show) {
+    this.detailsTargets.forEach((details) => details.hidden = !show)
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+
+    return Uint8Array.from([...rawData].map((char) => char.charCodeAt(0)))
+  }
+}
