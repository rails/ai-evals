--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,25 @@
+module Push
+  VAPID_SUBJECT = "mailto:support@fizzy.do"
+
+  def self.table_name_prefix
+    "push_"
+  end
+
+  class << self
+    def enabled?
+      public_key.present? && private_key.present?
+    end
+
+    def public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def vapid
+      { subject: ENV.fetch("VAPID_SUBJECT", VAPID_SUBJECT), public_key: public_key, private_key: private_key }
+    end
+  end
+end
