@@ -0,0 +1,39 @@
+# Builds the payload for a web push from the same content the tray renders, so
+# a push notification says what the corresponding tray item says and opens the
+# card (or comment) it is about.
+class Push::Payload
+  include NotificationsHelper
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def to_json(*)
+    { title: title, body: body, url: url }.to_json
+  end
+
+  private
+    attr_reader :notification
+
+    delegate :source, :account, :notifiable_target, to: :notification
+
+    def title
+      case source
+      when Mention then "#{source.mentioner.first_name} @mentioned you"
+      else event_notification_title(source)
+      end
+    end
+
+    def body
+      case source
+      when Mention then source.source.mentionable_content.truncate(200)
+      else event_notification_body(source)
+      end
+    end
+
+    def url
+      if notifiable_target
+        Rails.application.routes.url_helpers.polymorphic_path(notifiable_target, script_name: account.slug, only_path: true)
+      end
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..031230e
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,21 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  scope :for, ->(user) { where(user: user) }
+
+  def deliver(notification)
+    WebPush.payload_send(
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      message: notification.push_payload,
+      vapid: Push.vapid
+    )
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    # The push service has dropped this subscription, so stop trying to use it.
+    destroy
+  end
+end
