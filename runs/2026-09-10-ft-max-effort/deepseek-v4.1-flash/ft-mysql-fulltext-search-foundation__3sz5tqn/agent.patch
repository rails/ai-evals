diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..77b72d8
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,25 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap-half margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true,
+          class: "input full-width", autocorrect: "off", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <ul class="search-results flex flex-column gap-half txt-align-start">
+        <%= render partial: "searches/result", collection: @cards, as: :card, locals: { query: @query } %>
+      </ul>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% end %>
+</section>
