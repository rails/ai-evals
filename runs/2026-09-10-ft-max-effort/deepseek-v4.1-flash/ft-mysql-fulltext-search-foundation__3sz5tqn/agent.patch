diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..09eaf09
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show" do
+    get search_path
+    assert_response :success
+  end
+
+  test "index" do
+    get searches_path
+    assert_response :success
+  end
+
+  test "blank query returns no results" do
+    get search_path(q: "")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds cards by title and highlights the match" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "logo"
+    assert_no_match card_path(cards(:layout)), response.body
+  end
+
+  test "finds cards by description and highlights the match" do
+    cards(:logo).update! description: "A unique phrase about zebras"
+
+    get search_path(q: "zebras")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select ".search-result__snippet mark", text: "zebras"
+  end
+
+  test "finds cards by comment body and highlights the match" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:layout))
+    assert_select ".search-result__snippet mark", text: "overflowing"
+  end
+
+  test "case insensitive" do
+    get search_path(q: "LOGO")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: /LOGO/i
+  end
+
+  test "newest first" do
+    cards(:logo).update_column :created_at, 3.days.ago
+
+    newer = with_current_user(:kevin) do
+      boards(:writebook).cards.create!(creator: users(:kevin), title: "Logo redesign", status: :published)
+    end
+    newer.update_column :created_at, 1.hour.ago
+
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_operator response.body.index(card_path(newer)), :<, response.body.index(card_path(cards(:logo)))
+  end
+
+  test "does not reveal cards from boards the user cannot access" do
+    secret_card = with_current_user(:kevin) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "The secret logo", status: :published)
+    end
+
+    logout_and_sign_in_as :jz
+
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_no_match card_path(secret_card), response.body
+  end
+
+  test "does not reveal draft cards" do
+    draft = boards(:writebook).cards.create! creator: users(:kevin), title: "Draft dragon", status: :drafted
+
+    get search_path(q: "dragon")
+
+    assert_response :success
+    assert_no_match card_path(draft), response.body
+  end
+
+  test "does not reveal comments on draft cards" do
+    draft = with_current_user(:kevin) do
+      boards(:writebook).cards.create!(creator: users(:kevin), title: "Draft dragon", status: :published).tap do |card|
+        card.comments.create! creator: users(:kevin), body: "The wyvern secret"
+        card.update_column :status, "drafted"
+      end
+    end
+
+    get search_path(q: "wyvern")
+
+    assert_response :success
+    assert_no_match card_path(draft), response.body
+  end
+
+  test "treats wildcard characters literally" do
+    get search_path(q: "%")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+end
+
+class SearchesMultiWordTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "matches every word across the title" do
+    get search_path(q: "logo big")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "logo"
+    assert_select "mark", text: "big"
+    assert_no_match card_path(cards(:layout)), response.body
+  end
+
+  test "requires all words to match somewhere" do
+    get search_path(q: "logo dragon")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "matches words across description and comments" do
+    cards(:logo).update! description: "A blue widget report"
+    comments(:logo_1).update! body: "A zesty widget remark"
+
+    get search_path(q: "blue zesty")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select ".search-result__snippet mark", text: "blue"
+    assert_select ".search-result__snippet mark", text: "zesty"
+  end
+
+  test "wraps a contiguous phrase in a single mark" do
+    cards(:logo).update! description: "A blue widget report"
+
+    get search_path(q: "blue widget")
+
+    assert_response :success
+    assert_select "mark", text: "blue widget"
+  end
+end
+
+class SearchesWildcardTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "matches literal wildcard characters instead of treating them as wildcards" do
+    cards(:logo).update_column :title, "100% coverage"
+    cards(:layout).update_column :title, "100x coverage"
+
+    get search_path(q: "100%")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_no_match card_path(cards(:layout)), response.body
+  end
+end
