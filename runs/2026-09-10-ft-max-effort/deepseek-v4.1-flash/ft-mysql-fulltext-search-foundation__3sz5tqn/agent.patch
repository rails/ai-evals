+class SearchesController < ApplicationController
+  def show
+    search
+  end
+
+  def index
+    search
+    render :show
+  end
+
+  private
+    def search
+      @query = params[:q].to_s.strip
+      @cards = Current.user.search_cards(@query).preloaded.includes(comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..2d694b8
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,33 @@
+module SearchesHelper
+  def search_result_snippets(card, query)
+    terms = search_terms(query)
+    contents = [ card.description, *card.comments.map(&:body) ]
+
+    contents.filter_map do |content|
+      if content.present?
+        text = content.to_plain_text
+
+        if term = search_matching_term(text, terms)
+          excerpt(text, term, radius: 120, omission: "…")
+        end
+      end
+    end
+  end
+
+  def search_highlight(text, query)
+    highlight(h(text), search_highlight_phrases(query), sanitize: false)
+  end
+
+  private
+    def search_terms(query)
+      query.to_s.split
+    end
+
+    def search_highlight_phrases(query)
+      [ query.to_s.strip, *search_terms(query) ].reject(&:blank?).uniq
+    end
+
+    def search_matching_term(text, terms)
+      terms.find { |term| text.downcase.include?(term.downcase) }
+    end
+end
