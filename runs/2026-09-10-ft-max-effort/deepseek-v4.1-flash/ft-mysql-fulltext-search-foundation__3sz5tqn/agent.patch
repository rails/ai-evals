diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..8eb3fde
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,47 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  LIKE_ESCAPE = "!".freeze
+
+  included do
+    scope :search, ->(query) do
+      terms = query.to_s.split
+
+      if terms.present?
+        binds = {}
+        conditions = terms.each_with_index.map do |term, index|
+          bind = :"term_#{index}"
+          binds[bind] = "%#{ActiveRecord::Base.sanitize_sql_like(term, LIKE_ESCAPE)}%"
+
+          <<~SQL.squish
+            (
+              cards.title LIKE :#{bind} ESCAPE '#{LIKE_ESCAPE}'
+              OR EXISTS (
+                SELECT 1
+                FROM action_text_rich_texts AS card_descriptions
+                WHERE card_descriptions.record_type = 'Card'
+                  AND card_descriptions.record_id = cards.id
+                  AND card_descriptions.name = 'description'
+                  AND card_descriptions.body LIKE :#{bind} ESCAPE '#{LIKE_ESCAPE}'
+              )
+              OR EXISTS (
+                SELECT 1
+                FROM comments
+                INNER JOIN action_text_rich_texts AS comment_bodies
+                  ON comment_bodies.record_type = 'Comment'
+                  AND comment_bodies.record_id = comments.id
+                  AND comment_bodies.name = 'body'
+                WHERE comments.card_id = cards.id
+                  AND comment_bodies.body LIKE :#{bind} ESCAPE '#{LIKE_ESCAPE}'
+              )
+            )
+          SQL
+        end
+
+        published.where(conditions.join(" AND "), **binds)
+      else
+        none
+      end
+    end
+  end
+end
