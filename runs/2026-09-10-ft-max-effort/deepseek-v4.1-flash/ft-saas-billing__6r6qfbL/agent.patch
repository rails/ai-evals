+
+  def process
+    case event_type
+    when "checkout.session.completed"
+      checkout_completed(object)
+    when "customer.subscription.created", "customer.subscription.updated"
+      subscription_changed(object)
+    when "customer.subscription.deleted"
+      subscription_deleted(object)
+    end
+  end
+
+  private
+    def event_type
+      value(@event, :type)
+    end
+
+    def object
+      data = value(@event, :data)
+      value(data, :object)
+    end
+
+    def checkout_completed(session)
+      account = find_account_by_id(value(session, :client_reference_id))
+      account ||= find_account_by_id(metadata_value(session, "account_id"))
+      account ||= find_account_by_id(metadata_value(session, "external_account_id"))
+      account ||= account_for_customer(value(session, :customer))
+      return unless account
+
+      subscription = subscription_for(account)
+      subscription.stripe_customer_id = value(session, :customer) || subscription.stripe_customer_id
+      subscription.stripe_subscription_id = value(session, :subscription) || subscription.stripe_subscription_id
+      subscription.status = "active" if subscription.status.blank?
+
+      plan_key = metadata_value(session, "plan_key").presence || metadata_value(session, "plan").presence
+      if plan_key
+        subscription.plan_key = plan_key
+      end
+
+      subscription.save!
+    end
+
+    def subscription_changed(stripe_subscription)
+      account = account_for(stripe_subscription)
+      return unless account
+
+      subscription = subscription_for(account)
+      subscription.stripe_customer_id = value(stripe_subscription, :customer) || subscription.stripe_customer_id
+      subscription.stripe_subscription_id = value(stripe_subscription, :id) || subscription.stripe_subscription_id
+      subscription.status = value(stripe_subscription, :status)
+      subscription.current_period_end = timestamp(value(stripe_subscription, :current_period_end))
+      subscription.cancel_at = timestamp(value(stripe_subscription, :cancel_at))
+      subscription.plan_key = plan_key_for(stripe_subscription) || subscription.plan_key || default_plan_key
+      subscription.next_amount_due_in_cents = next_amount_due_in_cents(stripe_subscription)
+
+      subscription.save!
+    end
+
+    def subscription_deleted(stripe_subscription)
+      account = account_for(stripe_subscription)
+      return unless account
+
+      subscription = subscription_for(account)
+      subscription.update!(
+        plan_key: default_plan_key,
+        status: "canceled",
+        stripe_subscription_id: nil,
+        cancel_at: nil
+      )
+    end
+
+    def subscription_for(account)
+      account.account_subscription || account.build_account_subscription(plan_key: default_plan_key)
+    end
+
+    def find_account_by_id(id)
+      return nil if id.blank?
+      Account.find_by(id: id) || Account.find_by(external_account_id: id)
+    end
+
+    def account_for_customer(customer_id)
+      return nil if customer_id.blank?
+      Account::Subscription.find_by(stripe_customer_id: customer_id)&.account
+    end
+
+    def account_for(stripe_subscription)
+      account = find_account_by_id(metadata_value(stripe_subscription, "account_id"))
+      account ||= find_account_by_id(metadata_value(stripe_subscription, "queenbee_id"))
+      account ||= find_account_by_id(metadata_value(stripe_subscription, "external_account_id"))
+      account ||= account_for_customer(value(stripe_subscription, :customer))
+      account
+    end
+
+    def plan_key_for(stripe_subscription)
+      price_ids(stripe_subscription).each do |price_id|
+        if (plan = Subscription.find_by_stripe_price(price_id))
+          return plan.short_name
+        end
+      end
+
+      metadata_value(stripe_subscription, "plan_key").presence ||
+        metadata_value(stripe_subscription, "plan").presence ||
+        default_plan_key
+    end
+
+    def price_ids(stripe_subscription)
+      items = value(stripe_subscription, :items)
+      data = items.respond_to?(:data) ? items.data : value(items, :data)
+      Array(data).filter_map do |item|
+        price = value(item, :price)
+        value(price, :id)
+      end
+    end
+
+    def next_amount_due_in_cents(stripe_subscription)
+      amount = value(stripe_subscription, :next_amount_due_in_cents)
+      return amount if amount.present?
+
+      # Stripe doesn't report an amount due on the subscription; use the price
+      # of the first item when it's available.
+      items = value(stripe_subscription, :items)
+      data = items.respond_to?(:data) ? items.data : value(items, :data)
+      first = Array(data).first
+      return nil unless first
+      price = value(first, :price)
+      value(price, :unit_amount)
+    end
+
+    def metadata_value(record, key)
+      metadata = value(record, :metadata)
+      return nil if metadata.nil?
+      if metadata.respond_to?(:[])
+        metadata[key] || metadata[key.to_sym]
+      end
+    end
+
+    def timestamp(value)
+      return nil if value.blank?
+      return value if value.is_a?(Time)
+      Time.at(value.to_i)
+    end
+
+    def value(record, key)
+      return nil if record.nil?
+
+      if record.respond_to?(key)
+        record.public_send(key)
+      elsif record.is_a?(Hash)
+        record[key] || record[key.to_s]
+      end
+    end
+
+    def default_plan_key
+      Subscription.default.short_name
+    end
+end
