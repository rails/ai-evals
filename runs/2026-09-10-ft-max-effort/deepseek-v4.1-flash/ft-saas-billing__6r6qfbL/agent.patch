+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+    create
+  end
+
+  def create
+    customer_id = Current.account.account_subscription&.stripe_customer_id
+
+    if customer_id.blank?
+      redirect_to account_settings_path, alert: "There's no billing account to manage yet."
+      return
+    end
+
+    session = Stripe::BillingPortal::Session.create(
+      customer: customer_id,
+      return_url: account_settings_url(script_name: Current.account.slug)
+    )
+
+    redirect_to session.url, allow_other_host: true, status: :see_other
+  rescue Stripe::StripeError => error
+    Rails.error.report(error)
+    redirect_to account_settings_path, alert: "We couldn't open the billing portal. Please try again."
+  end
+end
