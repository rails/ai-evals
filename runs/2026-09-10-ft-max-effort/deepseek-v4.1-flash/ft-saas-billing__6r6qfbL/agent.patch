+  alias_method :can_publish_cards?, :within_card_limit?
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+  alias_method :approaching_card_limit?, :nearing_card_limit?
+  def cards_allowed = card_limit
+  def storage_allowed = storage_limit
+
+  # -- Storage -------------------------------------------------------------
+
   def storage_limit
-    storage_exception&.bytes_allowed || DEFAULT_STORAGE_LIMIT
+    overridden_limit&.bytes_used ||
+      storage_exception&.bytes_allowed ||
+      (Subscription::MonthlyExtraStorageV1.storage_limit if comped?) ||
+      plan_record.storage_limit ||
