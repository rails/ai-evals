diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..5c2973b
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,44 @@
+class Account::Subscription < SaasRecord
+  self.table_name = "account_subscriptions"
+
+  belongs_to :account, inverse_of: :account_subscription
+
+  def plan
+    Subscription.find(plan_key) || Subscription.default
+  end
+
+  def plan_name
+    plan.proper_name
+  end
+
+  delegate :proper_name, :price, :frequency, :card_limit, :storage_limit, to: :plan, allow_nil: true
+
+  def paid?
+    plan_key.present? && plan_key != Subscription.default.short_name
+  end
+
+  def free?
+    !paid?
+  end
+
+  def active?
+    status.blank? || status.in?(%w[ active trialing ])
+  end
+
+  # Ask Stripe to keep the subscription until the end of the current period,
+  # matching Fizzy's own cancellation grace period.
+  def cancel_at_period_end!
+    return if stripe_subscription_id.blank?
+    Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: true)
+  end
+
+  def resume!
+    return if stripe_subscription_id.blank?
+    Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: false)
+  end
+
+  def cancel_now!
+    return if stripe_subscription_id.blank?
+    Stripe::Subscription.cancel(stripe_subscription_id)
+  end
+end
