+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex flex-column gap margin-block-half">
+      <div class="txt-small txt-ink-medium">#<%= @account.external_account_id %></div>
+
+      <div class="flex align-center gap">
+        <div class="flex-item-grow">
+          <div class="txt-x-small">Plan</div>
+          <strong><%= @account.plan_name %></strong>
+          <% if @account.comped? %><span class="txt-small">(comped)</span><% end %>
+        </div>
+
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.comp_admin_account_path(@account), method: :delete, class: "btn" %>
+        <% else %>
+          <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn" %>
+        <% end %>
+      </div>
+
+      <div class="flex gap-half">
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <div class="txt-x-small">Cards</div>
+          <strong><%= number_with_delimiter(@account.cards_count) %></strong>
+        </div>
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <div class="txt-x-small">Bytes used</div>
+          <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+        </div>
+      </div>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override limits</h2>
+    </header>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap margin-block-half" do |form| %>
+      <label class="flex flex-column gap-quarter">
+        <span class="txt-x-small">Card count</span>
+        <%= number_field_tag "overridden_limit[card_count]", @account.overridden_limit&.card_count, class: "input", min: 0 %>
+      </label>
+
+      <label class="flex flex-column gap-quarter">
+        <span class="txt-x-small">Bytes used</span>
+        <%= number_field_tag "overridden_limit[bytes_used]", @account.overridden_limit&.bytes_used, class: "input", min: 0 %>
+      </label>
+
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <% if @account.overridden_limit %>
+      <%= button_to "Reset", saas.override_admin_account_path(@account), method: :delete, class: "btn" %>
+    <% end %>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+    <div class="flex flex-column gap margin-block-half">
+      <div class="txt-small">Status: <%= @account.account_subscription&.status || "none" %></div>
+      <div class="txt-small">Stripe customer: <%= @account.account_subscription&.stripe_customer_id || "none" %></div>
+    </div>
+  </div>
+</section>
