 module Account::StorageLimited
   extend ActiveSupport::Concern
 
+  DEFAULT_CARD_LIMIT = 1_000
   DEFAULT_STORAGE_LIMIT = 1.gigabyte
+  NEAR_CARD_LIMIT_THRESHOLD = 100
   NEAR_STORAGE_LIMIT_THRESHOLD = 500.megabytes
 
   included do
-    has_one :storage_exception
+    has_one :storage_exception, dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :account_subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :subscription, class_name: "Account::Subscription"
   end
 
+  # -- Cards ---------------------------------------------------------------
+
+  def card_limit
+    return nil if comped?
+    overridden_limit&.card_count || plan_record.card_limit
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def cards_remaining
+    return nil if card_limit.nil?
+    [ card_limit - cards_count, 0 ].max
+  end
+  alias_method :cards_left, :cards_remaining
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_count >= card_limit
+  end
+  alias_method :out_of_cards?, :exceeding_card_limit?
+  alias_method :card_limit_reached?, :exceeding_card_limit?
+  alias_method :has_reached_card_limit?, :exceeding_card_limit?
