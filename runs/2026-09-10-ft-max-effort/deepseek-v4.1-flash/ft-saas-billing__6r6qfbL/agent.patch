+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,27 @@
+class Stripe::WebhooksController < ActionController::API
+  # Stripe signs the raw body; we verify it ourselves before doing anything.
+  def create
+    event = Stripe::Webhook.construct_event(payload, signature, webhook_secret)
+
+    Billing::StripeWebhook.new(event).process
+
+    head :ok
+  rescue JSON::ParserError
+    head :bad_request
+  rescue Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def payload
+      @payload ||= request.body.read
+    end
+
+    def signature
+      request.env["HTTP_STRIPE_SIGNATURE"]
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+end
