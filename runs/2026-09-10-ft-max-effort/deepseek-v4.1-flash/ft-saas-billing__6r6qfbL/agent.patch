diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..d286c2d
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,43 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+    create
+  end
+
+  def create
+    plan = Subscription.find(params[:plan]) || Current.account.upgrade_plan || Subscription::MonthlyV1
+
+    if plan.free? || plan.stripe_price.blank?
+      redirect_to account_settings_path, alert: "That plan isn't available for checkout."
+      return
+    end
+
+    session = Stripe::Checkout::Session.create(checkout_attributes(plan))
+    redirect_to session.url, allow_other_host: true, status: :see_other
+  rescue Stripe::StripeError => error
+    Rails.error.report(error)
+    redirect_to account_settings_path, alert: "We couldn't start checkout. Please try again."
+  end
+
+  private
+    def checkout_attributes(plan)
+      attributes = {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price, quantity: 1 } ],
+        success_url: account_settings_url(script_name: Current.account.slug),
+        cancel_url: account_settings_url(script_name: Current.account.slug),
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, external_account_id: Current.account.external_account_id, plan_key: plan.short_name },
+        subscription_data: { metadata: { account_id: Current.account.id, external_account_id: Current.account.external_account_id, plan_key: plan.short_name } }
+      }
+
+      if (customer_id = Current.account.account_subscription&.stripe_customer_id).present?
+        attributes[:customer] = customer_id
+      else
+        attributes[:customer_email] = Current.user.identity.email_address
+      end
+
+      attributes
+    end
+end
