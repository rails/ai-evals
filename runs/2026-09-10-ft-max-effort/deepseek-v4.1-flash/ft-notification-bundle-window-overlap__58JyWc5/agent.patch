diff --git a/app/jobs/notification/bundle_job.rb b/app/jobs/notification/bundle_job.rb
new file mode 100644
index 0000000..91063f9
--- /dev/null
+++ b/app/jobs/notification/bundle_job.rb
@@ -0,0 +1,17 @@
+class Notification::BundleJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Runs with no arguments from the recurring schedule to deliver every due
+  # window. It can also be given a specific bundle to deliver, or a
+  # notification to add to its user's open window.
+  def perform(bundle_or_notification = nil)
+    case bundle_or_notification
+    when Notification::Bundle
+      bundle_or_notification.deliver if bundle_or_notification.due?
+    when Notification
+      Notification::Bundle.bundle(bundle_or_notification)
+    else
+      Notification::Bundle.deliver_due
+    end
+  end
+end
