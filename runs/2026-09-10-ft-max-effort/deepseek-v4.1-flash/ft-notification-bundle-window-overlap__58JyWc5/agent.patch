diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..34c524f
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,124 @@
+class Notification::Bundle < ApplicationRecord
+  # How long a window stays open after the first notification lands.
+  DURATIONS = User::Settings::BUNDLE_EMAIL_FREQUENCY_INTERVALS
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :open, -> { where(sent_at: nil) }
+  scope :unsent, -> { where(sent_at: nil) }
+  scope :sent, -> { where.not(sent_at: nil) }
+  scope :delivered, -> { where.not(sent_at: nil) }
+  scope :due, -> { open.where(ends_at: ..Time.current) }
+  scope :ordered, -> { order(:starts_at, :created_at) }
+
+  validates :starts_at, :ends_at, presence: true
+
+  class << self
+    # Adds a notification to the user's currently open window, opening a new
+    # window when there isn't one. Notifications that arrive while a window is
+    # already open always join that window, even when they land late.
+    def bundle(notification)
+      return unless bundleable?(notification)
+
+      user = notification.user
+      created = false
+
+      window = user.with_lock do
+        if existing = open_for(user)
+          existing
+        else
+          created = true
+          open_window_for(notification)
+        end.tap { |window| add(notification, window) }
+      end
+
+      schedule_delivery(window) if created
+      window
+    end
+    alias_method :create_for, :bundle
+
+    def open_for(user)
+      user.notification_bundles.open.ordered.last
+    end
+    alias_method :current_for, :open_for
+    alias_method :open_for_user, :open_for
+
+    def deliver_due
+      due.find_each do |bundle|
+        Current.with_account(bundle.account) { bundle.deliver }
+      end
+    end
+    alias_method :deliver_all, :deliver_due
+    alias_method :deliver_pending, :deliver_due
+
+    private
+      def bundleable?(notification)
+        user = notification.user
+
+        user.active? && user.account.active? && user.settings&.bundle_notifications?
+      end
+
+      def open_window_for(notification)
+        user = notification.user
+        frequency = user.settings.bundle_email_frequency
+        duration = DURATIONS.fetch(frequency)
+
+        # A late notification must never open a window that overlaps one that
+        # already existed, so the clock can't start before the previous end.
+        starts_at = [ notification.created_at || Time.current, user.notification_bundles.maximum(:ends_at) ].compact.max
+
+        user.notification_bundles.create!(
+          account: notification.account,
+          starts_at: starts_at,
+          ends_at: starts_at + duration
+        )
+      end
+
+      def add(notification, window)
+        return if notification.bundle_id == window.id
+
+        notification.update_column(:bundle_id, window.id)
+      end
+
+      def schedule_delivery(window)
+        Notification::BundleJob.set(wait_until: window.ends_at).perform_later(window)
+      end
+  end
+
+  def open?
+    sent_at.nil?
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  def due?
+    open? && ends_at <= Time.current
+  end
+
+  def deliver_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  def deliver
+    return if sent?
+
+    sent_now = with_lock do
+      if sent?
+        false
+      elsif notifications.none?
+        destroy
+        false
+      else
+        update!(sent_at: Time.current)
+      end
+    end
+
+    if sent_now && user.identity.present?
+      NotificationMailer.bundle(self).deliver_later
+    end
+  end
+end
diff --git a/app/models/notification/bundler.rb b/app/models/notification/bundler.rb
new file mode 100644
index 0000000..35ddec6
--- /dev/null
+++ b/app/models/notification/bundler.rb
@@ -0,0 +1,25 @@
+# Collects notifications into their user's currently open bundle, opening a
+# new time window when there isn't one already open.
+class Notification::Bundler
+  class << self
+    def call(notification)
+      new(notification).call
+    end
+    alias_method :bundle, :call
+
+    def for(user)
+      Notification::Bundle.open_for(user)
+    end
+  end
+
+  attr_reader :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def call
+    Notification::Bundle.bundle(notification)
+  end
+  alias_method :bundle, :call
+end
