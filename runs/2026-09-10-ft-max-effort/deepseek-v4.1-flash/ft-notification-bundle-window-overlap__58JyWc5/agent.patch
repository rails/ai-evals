new file mode 100644
index 0000000..408b3d7
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,23 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    set_bundle(bundle)
+    mail to: @user.identity.email_address, subject: subject, template_name: "bundle"
+  end
+
+  # Kept as an alias so the digest can be requested by either name.
+  def digest(bundle)
+    bundle(bundle)
+  end
+
+  private
+    def set_bundle(bundle)
+      @bundle = bundle
+      @user = bundle.user
+      @notifications = bundle.notifications.preloaded.order(:created_at)
+    end
+
+    def subject
+      count = @bundle.notifications.size
+      "#{count} new #{'notification'.pluralize(count)}"
+    end
+end
