+++ b/app/jobs/export_job.rb
@@ -0,0 +1,23 @@
+class ExportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(export)
+    export.processing!
+
+    ZipFile.create_for(export.file, filename: export.filename) do |zip|
+      if export.cards_export?
+        Account::DataTransfer::CardsExporter.new(export.user).to_zip(zip)
+      else
+        Account::DataTransfer::Manifest.new(export.account).to_zip(zip)
+      end
+    end
+
+    export.complete!
+    ExportMailer.ready(export).deliver_later
+  rescue => error
+    export.fail!(error.message)
+    ExportMailer.failed(export).deliver_later
+  end
+end
diff --git a/app/jobs/import_job.rb b/app/jobs/import_job.rb
new file mode 100644
index 0000000..d7127ee
--- /dev/null
+++ b/app/jobs/import_job.rb
@@ -0,0 +1,24 @@
+class ImportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    Account.transaction do
+      import.processing!
+
+      account = ZipFile.read(import.file) do |zip|
+        Account::DataTransfer::Importer.new(zip: zip, import: import).import!
+      end
+
+      raise "The import didn't produce an account" if account.blank?
+
+      import.complete!(account)
+    end
+
+    ImportMailer.completed(import).deliver_later
+  rescue => error
+    import.fail!(error.message)
+    ImportMailer.failed(import).deliver_later
+  end
+end
