diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..0eacf46
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,201 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const CARD_SELECTOR = ".card"
+const COLUMN_SELECTOR = ".cards"
+const LIST_SELECTOR = ".cards__list"
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+const AUTOSCROLL_THRESHOLD = 80
+const AUTOSCROLL_STEP = 14
+
+// Lets people move cards between columns (and between the special "Maybe?",
+// "Not now" and "Done" columns) using native drag and drop.
+//
+// The move is applied to the DOM as soon as the card is dropped so the board is
+// already in its final state, then the change is persisted in the background.
+// Columns keep their own order: dropping a card into the column it already
+// belongs to is a no-op, and a moved card lands at the top of its new column,
+// which is where the server will place it too.
+export default class extends Controller {
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+    this.autoScrollDirection = 0
+    this.autoScrollFrame = null
+
+    this.handleAutoScroll = this.handleAutoScroll.bind(this)
+    this.#makeCardsDraggable()
+    this.#observeCards()
+  }
+
+  disconnect() {
+    this.#stopAutoScrolling()
+    this.cardObserver?.disconnect()
+  }
+
+  // Turbo morphs can bring in freshly loaded columns, so make sure any new
+  // cards are draggable too.
+  refresh() {
+    this.#makeCardsDraggable()
+  }
+
+  dragstart(event) {
+    const card = event.target.closest(CARD_SELECTOR)
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(COLUMN_SELECTOR)
+    card.classList.add(DRAGGED_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragover(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event.target)
+    if (column) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#highlight(column)
+      this.#maybeAutoScroll(event.clientX)
+    } else {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+    const column = this.#columnFor(event.target)
+    const destination = column?.dataset.moveTo
+
+    this.#clearDraggingState()
+
+    if (!card || !column || column === sourceColumn) return
+    if (!destination) return
+
+    event.preventDefault()
+    this.#moveCard(card, column)
+    this.#persistMove(card, destination)
+  }
+
+  dragend() {
+    this.#clearDraggingState()
+  }
+
+  // Private
+
+  #columnFor(node) {
+    const column = node.closest(COLUMN_SELECTOR)
+    return column && this.element.contains(column) ? column : null
+  }
+
+  #highlight(column) {
+    if (column === this.hoveredColumn) return
+
+    this.hoveredColumn?.classList.remove(HOVER_CLASS)
+    this.hoveredColumn = column
+    column?.classList.add(HOVER_CLASS)
+  }
+
+  #moveCard(card, column) {
+    const list = column.querySelector(LIST_SELECTOR)
+    if (!list) return
+
+    // The server sorts newly moved cards to the top of the column (after any
+    // golden cards), so place the card there to avoid it shifting later.
+    const goldenCards = list.querySelectorAll(`${CARD_SELECTOR}.golden-effect`)
+    const anchor = goldenCards.length ? goldenCards[goldenCards.length - 1].nextSibling : list.firstChild
+    list.insertBefore(card, anchor)
+  }
+
+  #persistMove(card, destination) {
+    const { dndTriageUrl, dndNotNowUrl, dndClosureUrl } = card.dataset
+    if (!dndTriageUrl) return
+
+    if (destination === "maybe") {
+      this.#request(destroy(dndTriageUrl, { responseKind: "json" }))
+    } else if (destination === "not_now") {
+      this.#request(post(dndNotNowUrl, { responseKind: "json" }))
+    } else if (destination === "closed") {
+      this.#request(post(dndClosureUrl, { responseKind: "json" }))
+    } else {
+      this.#request(post(dndTriageUrl, { body: { column_id: destination }, responseKind: "json" }))
+    }
+  }
+
+  async #request(promise) {
+    try {
+      await promise
+    } catch (error) {
+      console.error("Failed to move card", error)
+    }
+  }
+
+  #clearDraggingState() {
+    this.draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.element.querySelectorAll(`.${HOVER_CLASS}`).forEach(element => {
+      element.classList.remove(HOVER_CLASS)
+    })
+
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+    this.#stopAutoScrolling()
+  }
+
+  #makeCardsDraggable() {
+    this.element.querySelectorAll(CARD_SELECTOR).forEach(card => {
+      card.draggable = true
+    })
+  }
+
+  #observeCards() {
+    this.cardObserver = new MutationObserver(() => this.#makeCardsDraggable())
+    this.cardObserver.observe(this.element, { childList: true, subtree: true })
+  }
+
+  #maybeAutoScroll(clientX) {
+    if (clientX == null) return
+
+    const rect = this.element.getBoundingClientRect()
+
+    if (clientX < rect.left + AUTOSCROLL_THRESHOLD) {
+      this.autoScrollDirection = -1
+    } else if (clientX > rect.right - AUTOSCROLL_THRESHOLD) {
+      this.autoScrollDirection = 1
+    } else {
+      this.#stopAutoScrolling()
+      return
+    }
+
+    if (!this.autoScrollFrame) {
+      this.autoScrollFrame = requestAnimationFrame(this.handleAutoScroll)
+    }
+  }
+
+  handleAutoScroll() {
+    if (!this.autoScrollDirection) {
+      this.autoScrollFrame = null
+      return
+    }
+
+    this.element.scrollLeft += this.autoScrollDirection * AUTOSCROLL_STEP
+    this.autoScrollFrame = requestAnimationFrame(this.handleAutoScroll)
+  }
+
+  #stopAutoScrolling() {
+    this.autoScrollDirection = 0
+    if (this.autoScrollFrame) {
+      cancelAnimationFrame(this.autoScrollFrame)
+      this.autoScrollFrame = null
+    }
+  }
+}
