--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,79 @@
+# Kamal deployment configuration for a single-box Fizzy install.
+#
+# Everything Fizzy needs runs on one Linux server with Docker:
+#
+#   * web and background jobs in a single container (Solid Queue runs inside
+#     Puma; see config/puma.rb)
+#   * the SQLite databases and uploaded files on a persistent volume
+#   * TLS certificates obtained and renewed automatically by kamal-proxy
+#
+# Before your first deploy, fill in the server address and hostname below, set
+# your mail server details, and provide the secrets referenced by
+# .kamal/secrets. Then run:
+#
+#   kamal setup
+#
+# See docs/self-hosting.md for the full walkthrough.
+
+# Your public hostname. The same value is used for the proxy certificate and
+# for the links Fizzy puts in emails and notifications, so keep the two in sync.
+<% app_host = [ ENV["FIZZY_HOST"], ENV["APP_HOST"], ENV["APP_FQDN"] ].find { |h| h && !h.empty? } || "fizzy.example.com" %>
+
+service: fizzy
+
+# Deploys go to a local registry that Kamal runs on the server, so there is no
+# external registry account (or credentials) to configure.
+image: fizzy
+
+# The server Fizzy runs on. Replace this with your server's address.
+servers:
+  web:
+    - 192.0.2.1
+
+proxy:
+  # kamal-proxy requests and renews a Let's Encrypt certificate for the host
+  # below, so port 80 and 443 need to be reachable and the host needs to
+  # resolve to this server.
+  ssl: true
+  host: <%= app_host %>
+
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    APP_HOST: <%= app_host %>
+    # Run background jobs in the web container. They share the container so
+    # there is no second role or process to manage.
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Who Fizzy's emails come from.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    # Your mail server. These defaults hand mail to a mail server listening on
+    # the same box; change them to send through a relay instead.
+    SMTP_ADDRESS: "localhost"
+    SMTP_PORT: "25"
+    # SMTP_USERNAME: "fizzy@example.com"
+    # SMTP_AUTHENTICATION: "plain"
+    # SMTP_ENABLE_STARTTLS_AUTO: "false"
+  secret:
+    - SECRET_KEY_BASE
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+    - SMTP_PASSWORD
+
+# The SQLite databases (primary, cache, queue and cable) and Active Storage
+# uploads all live under /rails/storage, so one volume keeps them across
+# deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
