@@ -0,0 +1,26 @@
+# Secrets referenced by config/deploy.yml.
+#
+# Keep this file safe to commit: reference secrets from your environment, a
+# file outside the repository, or a password manager instead of pasting raw
+# credentials. See https://kamal-deploy.org/docs/configuration/secrets/
+# for the available helpers.
+#
+# Either export the variables below in the shell you deploy from, or replace
+# the right-hand side with the literal value -- but only if you keep the
+# result out of version control.
+#
+# Generate the values once and keep them somewhere permanent: new values would
+# invalidate every existing session and push subscription.
+
+# Signs cookies and other data. Generate with:
+#   bin/rails secret
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# VAPID keys for browser push notifications. Generate a pair with:
+#   bin/rails runner 'key = WebPush.generate_key; puts key.private_key; puts key.public_key'
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+
+# Password for your SMTP server. Leave empty if it does not require
+# authentication.
+SMTP_PASSWORD=$SMTP_PASSWORD
