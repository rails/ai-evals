diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..5904c5e
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "an admin can request an account export" do
+    sign_in_as :kevin
+
+    assert_difference -> { Export.count }, +1 do
+      assert_enqueued_with(job: ExportJob) do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.kind
+  end
+
+  test "a non-admin cannot request an account export" do
+    sign_in_as :jz
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "anyone can request a personal export" do
+    sign_in_as :jz
+
+    assert_difference -> { Export.count }, +1 do
+      assert_enqueued_with(job: ExportJob) do
+        post my_exports_path
+      end
+    end
+
+    assert_equal "personal", Export.last.kind
+    assert_equal users(:jz), Export.last.user
+  end
+
+  test "downloads a ready export with a signed link" do
+    export = Export.create!(account: accounts("37s"), user: users(:david), kind: :account)
+    export.perform
+    assert export.reload.completed?
+
+    get account_export_path(export.download_id)
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+  end
+
+  test "does not download another account's export" do
+    other = Account.create!(name: "Somewhere else")
+    export = nil
+    Current.with_account(other) do
