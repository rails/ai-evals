diff --git a/test/models/account/data_transfer/round_trip_test.rb b/test/models/account/data_transfer/round_trip_test.rb
new file mode 100644
index 0000000..696d18d
--- /dev/null
+++ b/test/models/account/data_transfer/round_trip_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::DataTransfer::RoundTripTest < ActiveSupport::TestCase
+  test "exports an account and imports it into a brand new account" do
+    source = accounts("37s")
+
+    cards(:logo).image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: source, user: users(:david), kind: :account)
+    export.perform
+    assert export.reload.completed?, "export failed: #{export.error}"
+    assert export.file.attached?
+
+    entries = ZipFile.open(export.file) { |zip| zip.files }
+    assert_includes entries, "manifest.json"
+    assert entries.any? { |path| path.start_with?("boards/") }, entries.inspect
+    assert entries.any? { |path| path.start_with?("cards/") }, entries.inspect
+    assert entries.any? { |path| path.start_with?("comments/") }, entries.inspect
+    assert entries.any? { |path| path.start_with?("users/") }, entries.inspect
+    assert entries.any? { |path| path.start_with?("files/") }, entries.inspect
+
+    import = Import.new(account: source, identity: identities(:jason))
+    import.file.attach(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+    import.save!
+    import.perform
+
+    assert import.reload.completed?, "import failed: #{import.error}"
+    new_account = import.imported_account
+    assert_not_nil new_account
+    assert_not_equal source.id, new_account.id
+
+    assert_equal source.boards.count, new_account.boards.count
+    assert_equal source.cards.count, new_account.cards.count
+    assert_equal Comment.where(account: source).count, Comment.where(account: new_account).count
+
+    # Attachments and their file contents are restored
+    internal = Account::DataTransfer::RecordSet::INTERNAL_RECORD_TYPES
+    source_blob_keys = ActiveStorage::Attachment.where(account: source).where.not(record_type: internal).pluck(:blob_id)
+    new_blob_keys = ActiveStorage::Attachment.where(account: new_account).where.not(record_type: internal).pluck(:blob_id)
+    assert_equal source_blob_keys.count, new_blob_keys.count
+    assert new_account.cards.joins(:image_attachment).exists?
+    ActiveStorage::Blob.where(id: new_blob_keys).find_each do |blob|
+      assert blob.service.exist?(blob.key), "missing file for #{blob.filename}"
+    end
+
+# Foreign keys have been translated to the new ids
+user_ids = new_account.users.ids
+card_ids = new_account.cards.ids
+comment_ids = Comment.where(account: new_account).ids
+
+Assignment.where(account: new_account).find_each do |assignment|
+  assert_includes card_ids, assignment.card_id
+  assert_includes user_ids, assignment.assignee_id
+  assert_includes user_ids, assignment.assigner_id
+end
+
+Reaction.where(account: new_account).find_each do |reaction|
+  assert_includes user_ids, reaction.reacter_id
+  assert reaction.reactable_id.in?(reaction.reactable_type == "Card" ? card_ids : comment_ids)
+end
+
+Event.where(account: new_account).find_each do |event|
+  assert_includes new_account.boards.ids, event.board_id
+  assert_includes user_ids, event.creator_id
+end
+
+ActionText::RichText.where(account: new_account).find_each do |rich_text|
+  next unless rich_text.record_type == "Card" || rich_text.record_type == "Comment"
+  assert_includes(rich_text.record_type == "Card" ? card_ids : comment_ids, rich_text.record_id)
+end
+
+    # The importing identity has access to the new account
+    assert new_account.users.exists?(identity_id: identities(:jason).id)
+  end
+end
diff --git a/test/models/account/data_transfer/transfer_test.rb b/test/models/account/data_transfer/transfer_test.rb
new file mode 100644
index 0000000..86fde7c
--- /dev/null
+++ b/test/models/account/data_transfer/transfer_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Account::DataTransfer::TransferTest < ActiveSupport::TestCase
+  setup do
+    @source = accounts("37s")
+  end
+
+  test "personal export only includes the cards the user can see" do
+    Current.user = users(:kevin)
+    private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Secret", status: "published")
+
+    export = Export.create!(account: @source, user: users(:jz), kind: :personal)
+    export.perform
+    assert export.reload.completed?, "export failed: #{export.error}"
+
+    card_ids = ZipFile.open(export.file) do |zip|
+      zip.glob("cards/*.json").map { |path| JSON.parse(zip.read(path)).fetch("id") }
+    end
+
+    assert_includes card_ids, cards(:logo).id
+    assert_not_includes card_ids, private_card.id
+  end
+
+  test "imports rich text attachments and re-signs them" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg"
+    )
+    comments(:logo_1).update!(body: "<div>Look at this: <action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment></div>")
+
+    import = build_import(export_account)
+    import.perform
+    assert import.reload.completed?, "import failed: #{import.error}"
+
+    new_card = import.imported_account.cards.find_by!(title: cards(:logo).title)
+    rich_text = new_card.comments.joins(:rich_text_body)
+      .where("action_text_rich_texts.body LIKE ?", "%action-text-attachment%").first
+    assert_not_nil rich_text
+
+    attachables = ActionText::Content.new(rich_text.body.to_s).attachables
+    assert attachables.any?, "expected a valid attachment in #{rich_text.body.to_s.inspect}"
+    assert_equal import.imported_account.id, attachables.first.account_id
+    assert attachables.first.service.exist?(attachables.first.key)
+
+    attachment = ActiveStorage::Attachment.find_by!(blob_id: attachables.first.id)
+    assert_equal import.imported_account.id, attachment.account_id
+    assert_equal import.imported_account.id, ActionText::RichText.find(attachment.record_id).account_id
+  end
+
+  test "a failed import creates no account" do
+    import = build_import(export_account, transform: ->(path, data) {
+      if path.start_with?("cards/") && path.end_with?(".json")
+        JSON.generate(JSON.parse(data).merge("last_active_at" => nil))
+      else
+        data
+      end
+    })
+
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { Identity.count } do
+        import.perform
+      end
+    end
+
+    assert import.reload.failed?
+    assert_nil import.imported_account_id
+  end
+
+  test "rejects an uploaded file that isn't a zip" do
+    import = Import.new(account: @source, identity: identities(:jason))
+    import.file.attach(io: StringIO.new("not a zip"), filename: "notes.txt", content_type: "text/plain")
+    assert_not import.valid?
+    assert import.errors[:file].any?
+  end
+
+test "a record set can export and import itself generically" do
+  account = accounts("37s")
+  writer_tempfile = Tempfile.new([ "tags", ".zip" ])
+  writer_tempfile.binmode
+  writer = ZipFile::Writer.new(writer_tempfile)
+  Account::DataTransfer::RecordSet.new(account: account, model: Tag).export_to(writer)
+  writer.close
+  writer_tempfile.rewind
+
+  reader = ZipFile::Reader.new(writer_tempfile)
+  assert_equal Tag.where(account: account).count, reader.glob("tags/*.json").size
+
+  new_account = Account.create!(name: "Generic import")
+  context = Account::DataTransfer::ImportContext.new
+  context.register_id(account.id, new_account.id)
+
+  Account::DataTransfer::RecordSet.new(account: new_account, model: Tag).import_from(reader, context: context)
+
+  assert_equal Tag.where(account: account).count, Tag.where(account: new_account).count
+  assert_empty Tag.where(account: account).ids & Tag.where(account: new_account).ids
+end
+
+  private
+    def export_account
+      export = Export.create!(account: @source, user: users(:david), kind: :account)
+      export.perform
+      assert export.reload.completed?, "export failed: #{export.error}"
+      export
+    end
+
+    def build_import(export, transform: nil)
+      tempfile = Tempfile.new([ "import", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      ZipFile.open(export.file) do |reader|
+        reader.files.each do |path|
+          data = reader.read(path)
+          data = transform.call(path, data) if transform
+          writer.add_file(path, data)
+        end
+      end
+      writer.close
+      tempfile.rewind
+
+      Import.new(account: @source, identity: identities(:jason)).tap do |import|
+        import.file.attach(io: tempfile, filename: "import.zip", content_type: "application/zip")
+        import.save!
+      end
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..56d8969 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -38,3 +38,50 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
 end
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "reads files written by the writer" do
+    tempfile = Tempfile.new([ "round-trip", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("manifest.json", '{"hello":"world"}')
+    writer.add_file("docs/readme.txt", "Read me")
+    writer.add_file("files/large.bin") { |sink| sink.write("x" * 10_000) }
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    assert_equal [ "manifest.json", "docs/readme.txt", "files/large.bin" ].sort, reader.files.sort
+    assert reader.exists?("manifest.json")
+    assert_not reader.exists?("missing.txt")
+    assert_equal '{"hello":"world"}', reader.read("manifest.json")
+    assert_equal [ "docs/readme.txt" ], reader.glob("docs/*.txt")
+    assert_equal 10_000, reader.read("files/large.bin").bytesize
+
+    reader.open("docs/readme.txt") do |io|
+      assert_equal "Read me", io.read
+    end
+  end
+
+  test "streams large entries in chunks" do
+    tempfile = Tempfile.new([ "streaming", ".zip" ])
+    tempfile.binmode
+
+    content = SecureRandom.random_bytes(256 * 1024)
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("big.bin", content)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    reader.open("big.bin") do |io|
+      assert_equal content.bytesize, io.size
+      collected = +""
+      while (chunk = io.read(4096))
+        collected << chunk
+      end
+      assert_equal content, collected
+    end
+  end
+end
