diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..8409fe0
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,148 @@
+require "zip_kit"
+
+# Reads a ZIP archive from any IO-ish source (a local file or a
+# ZipFile::RemoteIO). Only the central directory is read eagerly; entry
+# contents are streamed on demand, so archives much larger than memory can be
+# read.
+class ZipFile::Reader
+  attr_reader :io
+
+  def initialize(io, read_local_headers: true)
+    @io = io
+    @read_local_headers = read_local_headers
+  end
+
+  def files
+    entries.map(&:filename)
+  end
+
+  def glob(pattern)
+    files.select { |path| File.fnmatch?(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    files.include?(path)
+  end
+
+  def read(path)
+    open(path) { |entry_io| entry_io.read }
+  end
+
+  def open(path)
+    entry = entry_for(path)
+    raise Errno::ENOENT, "No such entry in archive: #{path}" unless entry
+
+    entry_io = EntryIO.new(extractor_for(entry), entry.uncompressed_size)
+    if block_given?
+      begin
+        yield entry_io
+      ensure
+        entry_io.close
+      end
+    else
+      entry_io
+    end
+  end
+
+  def each_entry
+    return enum_for(:each_entry) unless block_given?
+
+    files.each { |path| yield path }
+  end
+
+  private
+    def entries
+      @entries ||= ZipKit::FileReader.read_zip_structure(io: io, read_local_headers: @read_local_headers)
+        .reject { |entry| entry.filename.to_s.empty? || entry.filename.end_with?("/") }
+    end
+
+    def entry_for(path)
+      entries.find { |entry| entry.filename == path }
+    end
+
+    # Resolves the offset of the compressed data for lazy entries (used when we
+    # deliberately skipped reading local headers, e.g. for remote archives).
+    def extractor_for(entry)
+      unless entry.known_offset?
+        offset = ZipKit::FileReader.new.get_compressed_data_offset(
+          io: io, local_file_header_offset: entry.local_file_header_offset
+        )
+        entry.compressed_data_offset = offset
+      end
+
+      entry.extractor_from(io)
+    end
+
+    # Adapts a ZipKit extractor to the subset of the IO interface that
+    # ActiveStorage services need in order to stream an upload.
+    class EntryIO
+      # Number of uncompressed bytes in the entry. ActiveStorage's S3 service
+      # uses this to decide between single- and multi-part uploads.
+      attr_reader :size
+
+      def initialize(extractor, size)
+        @extractor = extractor
+        @size = size
+      end
+
+      def read(length = nil, outbuf = nil)
+        if length.nil?
+          buffer = read_all
+        elsif length.negative?
+          raise ArgumentError, "negative length #{length} given"
+        elsif length.zero?
+          buffer = +""
+        else
+          buffer = read_length(length)
+          return nil if buffer.nil?
+        end
+
+        if outbuf
+          outbuf.replace(buffer)
+        else
+          buffer
+        end
+      end
+
+      def readpartial(maxlen, outbuf = nil)
+        data = read(maxlen, outbuf)
+        raise EOFError if data.nil?
+        data
+      end
+
+      def eof?
+        @extractor.eof?
+      end
+
+      def binmode
+        self
+      end
+
+      def close
+        # Nothing to release, but services may call it.
+      end
+
+      private
+        def read_all
+          buffer = +""
+          until @extractor.eof?
+            chunk = @extractor.extract(64.kilobytes)
+            break if chunk.nil?
+            buffer << chunk
+          end
+          buffer
+        end
+
+        def read_length(length)
+          return nil if @extractor.eof?
+
+          buffer = +""
+          while buffer.bytesize < length && !@extractor.eof?
+            chunk = @extractor.extract(length - buffer.bytesize)
+            break if chunk.nil?
+            buffer << chunk
+          end
+          buffer
+        end
+    end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..ac42c23
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,76 @@
+require "net/http"
+require "uri"
+require "openssl"
+
+# An adapter between HTTP(S) and the IO-ish interface that ZipKit::FileReader
+# expects. Unlike ZipKit::RemoteIO, which opens a fresh connection for every
+# request, this keeps a single (persistent) connection for the lifetime of the
+# reader. That matters a lot when reading a huge archive: the central directory
+# alone can require hundreds of ranged reads.
+#
+# We intentionally do not verify SSL certificates. This is only ever used to
+# read from the instance's own object storage, which in some self-hosted
+# deployments (PureStorage) presents a self-signed certificate.
+class ZipFile::RemoteIO < ZipKit::RemoteIO
+  def initialize(url, open_timeout: 10, read_timeout: 60)
+    super(url)
+    @open_timeout = open_timeout
+    @read_timeout = read_timeout
+    @http = nil
+  end
+
+  def close
+    @http&.finish if @http&.started?
+    @http = nil
+  end
+
+  protected
+    def request_range(range)
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = range
+        response = http.request(request)
+
+        case response.code
+        when "206", "200"
+          response.body
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+    def request_object_size
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = 0..0
+        response = http.request(request)
+
+        case response.code
+        when "206"
+          response["Content-Range"].split("/").last.to_i
+        when "200"
+          response["Content-Length"].to_i
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+  private
+    def with_http
+      http = (@http ||= build_http)
+      http.start unless http.started?
+      yield http
+    end
+
+    def build_http
+      http = Net::HTTP.new(@uri.hostname, @uri.port)
+      http.use_ssl = @uri.scheme == "https"
+      http.verify_mode = OpenSSL::SSL::VERIFY_NONE if http.use_ssl?
+      http.open_timeout = @open_timeout
+      http.read_timeout = @read_timeout
+      http.keep_alive_timeout = 30
+      http
+    end
+end
