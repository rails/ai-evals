+      <label class="flex flex-column gap-half">
+        <strong><%= form.label :file, "Export file (.zip)" %></strong>
+        <%= form.file_field :file, accept: "application/zip,.zip", required: true, class: "input" %>
+      </label>
+
+      <% if @import.errors.any? %>
+        <div class="margin-block-half txt-negative txt-small">
+          <p class="margin-block-none font-weight-bold">The import couldn't be started:</p>
+          <ul class="margin-block-none">
+            <% @import.errors.full_messages.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <div class="flex gap">
+        <%= form.button class: "btn btn--reversed" do %>
+          <span>Start import</span>
+        <% end %>
+        <%= link_to "Cancel", account_settings_path, class: "btn" %>
+      </div>
+    <% end %>
+  </div>
+</article>
diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
new file mode 100644
index 0000000..5171b06
--- /dev/null
+++ b/app/views/account/imports/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Import" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<article class="panel panel--wide shadow center txt-align-start">
+  <% if @import.completed? %>
+    <h2 class="margin-none-block-start">Your import is ready</h2>
+    <p>
+      Everything has been imported into
+      <strong><%= @import.imported_account&.name %></strong>.
+    </p>
+    <% if @import.imported_account %>
+      <%= link_to "Open #{@import.imported_account.name}", root_path(script_name: @import.imported_account.slug), class: "btn" %>
+    <% end %>
+  <% elsif @import.failed? %>
+    <h2 class="margin-none-block-start">The import couldn't be completed</h2>
+    <p>Nothing was left behind. You can try again with a fresh export.</p>
+    <% if @import.error.present? %>
+      <p class="txt-negative"><strong>Reason:</strong> <%= @import.error %></p>
+    <% end %>
+    <%= link_to "Try again", new_account_import_path, class: "btn" %>
+  <% else %>
+    <h2 class="margin-none-block-start">Your import is being processed</h2>
+    <p>We'll email you as soon as it's done. You can close this page.</p>
+  <% end %>
+</article>
