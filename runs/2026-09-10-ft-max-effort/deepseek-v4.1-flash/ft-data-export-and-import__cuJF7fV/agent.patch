+class Import < ApplicationRecord
+  STATUSES = %w[ pending processing completed failed ].freeze
+  ALLOWED_CONTENT_TYPES = %w[ application/zip application/x-zip-compressed application/octet-stream ].freeze
+
+  belongs_to :account
+  belongs_to :identity
+  belongs_to :imported_account, class_name: "Account", optional: true
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, STATUSES.index_by(&:itself), default: :pending, scopes: false
+
+  validate :file_must_be_present
+  validate :file_is_a_zip, if: -> { file.attached? }
+
+  def perform
+    update!(status: :processing, error: nil)
+    account = ZipFile.open(file) do |zip|
+      Account::DataTransfer::Importer.new(zip, identity: identity).import
+    end
+    update!(status: :completed, imported_account: account, completed_at: Time.current)
+    ImportMailer.completed(self).deliver_later
+    SearchReindexJob.perform_later(account_id: account.id)
+  rescue StandardError => e
+    update(status: :failed, error: "#{e.class}: #{e.message}", completed_at: Time.current)
+    ImportMailer.failed(self).deliver_later
+  end
+
+  private
+    def file_must_be_present
+      errors.add(:file, "can't be blank") unless file.attached?
+    end
+
+    def file_is_a_zip
+      return if file.content_type.in?(ALLOWED_CONTENT_TYPES) || file.filename.to_s.downcase.end_with?(".zip")
+
+      errors.add(:file, "must be a .zip archive")
+    end
+end
