diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..bc5ebcd
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,47 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/date_helpers"
+
+// Rewrites a server-rendered <time> element in the viewer's own timezone.
+export default class extends Controller {
+  static targets = [ "value" ]
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render = this.render.bind(this)
+    this.element.addEventListener("turbo:morph-element", this.render)
+    this.render()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.render)
+  }
+
+  render() {
+    const date = this.#parseDatetime(this.element.getAttribute("datetime"))
+    if (!date) return
+
+    const text = formatTimestamp(date, this.formatValue)
+
+    if (this.hasValueTarget) {
+      this.valueTarget.textContent = text
+    } else {
+      this.element.textContent = text
+    }
+
+    this.element.title = date.toLocaleString()
+  }
+
+  #parseDatetime(value) {
+    if (!value) return null
+
+    // A bare date (like "2025-01-22") represents a calendar day, so build it in
+    // the browser's timezone rather than letting Date parse it as UTC.
+    if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+      const [ year, month, day ] = value.split("-").map(Number)
+      return new Date(year, month - 1, day)
+    }
+
+    const date = new Date(value)
+    return isNaN(date) ? null : date
+  }
+}
