diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..04cd22f 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,32 @@
 module TimeHelper
+  # Renders a raw UTC timestamp that the browser turns into words in the
+  # viewer's own timezone. Cached HTML is therefore the same for everyone.
+  #
+  # Formats:
+  #   :relative       - "1:42 PM", "yesterday", "5 days ago", "Sep 12", "tomorrow", "in 3 days"
+  #   :time           - "1:42 PM"
+  #   :date           - "Sep 12"
+  #   :date_with_year - "Sep 12, 2024"
+  #   :date_time      - "Sep 12, 1:42 PM"
+  #   :long_date      - "Monday, September 12"
+  def local_time(time, format = nil, **options)
+    format = options.delete(:format) || format || :relative
+    datetime = timestamp_for(time)
+
+    tag.time datetime: datetime,
+      data: { controller: "local-time", local_time_format_value: format },
+      **options do
+      tag.span datetime, class: "local-time-value", data: { local_time_target: "value" }
+    end
+  end
+  alias_method :local_time_tag, :local_time
+
+  private
+    def timestamp_for(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        time.to_date.iso8601
+      end
+    end
 end
