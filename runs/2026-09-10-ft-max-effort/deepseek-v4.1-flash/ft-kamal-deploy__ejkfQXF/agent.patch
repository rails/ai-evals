+# Kamal deployment configuration for running Fizzy on a single Linux server.
+#
+# Everything runs in one container: the web server, the Solid Queue workers
+# that process background jobs, and SQLite databases for the app, cache,
+# cable, and queue. Uploaded files and the databases live in a Docker volume,
+# so they survive future deploys.
+#
+# To deploy:
+#   1. Edit the hostname, server address, and mail server settings below (or
+#      set the matching environment variables when you run Kamal).
+#   2. Provide your secrets in .kamal/secrets.
+#   3. Run `kamal setup`.
+#
+# You'll need Docker running locally and SSH access (as root, by default) to
+# the server, plus a DNS record pointing the hostname at it. kamal-proxy
+# obtains and renews the TLS certificate via Let's Encrypt for you.
+
+<% app_host = ENV.fetch("APP_HOST", "fizzy.example.com") %>
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: fizzy
+
+# The single server to deploy to. Defaults to the app hostname, but you can
+# set DEPLOY_HOST to an IP address if the DNS record isn't ready yet.
+servers:
+  web:
+    - <%= ENV.fetch("DEPLOY_HOST", app_host) %>
+
+# Terminate TLS at kamal-proxy and fetch a certificate for the hostname.
+proxy:
+  ssl: true
+  host: <%= app_host %>
+
+# Build a native image for the server. Change to arm64 for ARM servers.
+builder:
+  arch: amd64
+
+# Build and push to a local registry that Kamal manages for you, so no
+# external registry or account is required.
+registry:
+  server: localhost:5555
+
+# Persist SQLite databases and uploaded files across deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Bridge fingerprinted assets between the old and new containers during a
+# deploy, so in-flight requests don't 404.
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: "production"
+    # Public hostname, used for absolute URLs in emails and notifications.
+    APP_HOST: "<%= app_host %>"
+    # Outbound mail. Point these at your mail server.
+    MAILER_FROM_ADDRESS: "<%= ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <fizzy@#{app_host}>") %>"
+    SMTP_ADDRESS: "<%= ENV.fetch("SMTP_ADDRESS", "smtp.example.com") %>"
+    SMTP_PORT: "<%= ENV.fetch("SMTP_PORT", 587) %>"
+    SMTP_USERNAME: "<%= ENV.fetch("SMTP_USERNAME", "") %>"
+    SMTP_DOMAIN: "<%= app_host %>"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
