--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,33 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(term) do
+      if (query = term.to_s.strip).present?
+        where(<<~SQL, pattern: klass.like_pattern(query))
+          cards.title LIKE :pattern ESCAPE '!'
+          OR cards.id IN (
+            SELECT record_id FROM action_text_rich_texts
+            WHERE record_type = 'Card' AND name = 'description' AND body LIKE :pattern ESCAPE '!'
+          )
+          OR cards.id IN (
+            SELECT card_id FROM comments
+            WHERE id IN (
+              SELECT record_id FROM action_text_rich_texts
+              WHERE record_type = 'Comment' AND name = 'body' AND body LIKE :pattern ESCAPE '!'
+            )
+          )
+        SQL
+      else
+        all
+      end
+    end
+  end
+
+  class_methods do
+    def like_pattern(term)
+      escaped = term.to_s.gsub(/[!%_]/) { |character| "!#{character}" }
+      "%#{escaped}%"
+    end
+  end
+end
