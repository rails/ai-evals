diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..67325a5
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,39 @@
+class Search
+  attr_reader :query, :user
+
+  def initialize(query:, user:)
+    @query = query.to_s.strip
+    @user = user
+  end
+
+  def cards
+    @cards ||= if query.present?
+      user.accessible_cards.published.matching(query).preloaded.reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  def comments_for(card)
+    comments_by_card[card.id] || []
+  end
+
+  private
+    def comments_by_card
+      @comments_by_card ||= if query.present?
+        Comment.preloaded.preload(:creator)
+          .where(card_id: cards.select(:id))
+          .where(id: matching_comment_ids)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+
+    def matching_comment_ids
+      @matching_comment_ids ||= ActionText::RichText
+        .where(record_type: "Comment", name: "body")
+        .where("body LIKE ? ESCAPE '!'", Card.like_pattern(query))
+        .select(:record_id)
+    end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..334a976
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,29 @@
+<%= card_article_tag card, class: "card search-result" do %>
+  <div class="flex flex-column flex-item-grow max-inline-size">
+    <header class="card__header">
+      <%= link_to card.board.name, card.board, class: "card__board-name overflow-ellipsis" %>
+    </header>
+
+    <div class="card__body">
+      <div class="card__content">
+        <h3 class="card__title overflow-line-clamp">
+          <%= link_to search_highlight(card.title, search.query), card_path(card),
+                class: "card__title-link", data: { turbo_frame: "_top" } %>
+        </h3>
+
+        <% if snippet = search_snippet(card.rich_text_description&.to_plain_text, search.query) %>
+          <div class="card__description txt-small muted">
+            <%= snippet %>
+          </div>
+        <% end %>
+
+        <% search.comments_for(card).each do |comment| %>
+          <div class="search-result__comment txt-small">
+            <span class="search-result__comment-author"><strong><%= comment.creator.name %></strong></span>
+            <%= search_snippet(comment.rich_text_body&.to_plain_text, search.query) %>
+          </div>
+        <% end %>
+      </div>
+    </div>
+  </div>
+<% end %>
