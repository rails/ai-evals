@@ -0,0 +1,19 @@
+module SearchesHelper
+  def search_highlight(text, query)
+    escaped = ERB::Util.html_escape(text.to_s)
+
+    if query.present?
+      escaped = escaped.gsub(/(#{Regexp.escape(ERB::Util.html_escape(query.to_s))})/i, '<mark>\1</mark>')
+    end
+
+    escaped.html_safe
+  end
+
+  def search_snippet(text, query, length: 240)
+    if text.present? && query.present?
+      if snippet = excerpt(text.to_s, query.to_s, radius: length)
+        search_highlight(snippet, query)
+      end
+    end
+  end
+end
