+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span>Search</span>
+  </h1>
+<% end %>
+
+<div class="search pad-block-half">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards…",
+          class: "input full-width", autocomplete: "off", autofocus: true,
+          aria: { label: "Search cards" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</div>
+
+<section class="cards cards--grid">
+  <div class="cards__list hide-scrollbar">
+    <%= render partial: "searches/result", collection: @search.cards, as: :card, locals: { search: @search } %>
+  </div>
+</section>
