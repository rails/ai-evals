diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..35d065b
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+  end
+
+  test "finds cards by title" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "article.card" do
+      assert_select "mark", "logo"
+      assert_select ".card__title a", text: /The logo isn't big enough/
+    end
+  end
+
+  test "finds cards by description" do
+    cards(:logo).update!(description: "A description about wombats")
+
+    get search_path(q: "wombats")
+
+    assert_response :success
+    assert_select "article.card"
+    assert_select "mark", "wombats"
+  end
+
+  test "finds cards by comment body" do
+    cards(:layout).comments.create!(body: "The wombat is loose", creator: users(:david))
+
+    get search_path(q: "wombat")
+
+    assert_response :success
+    assert_select "article.card" do
+      assert_select "mark", "wombat"
+      assert_select ".search-result__comment", text: /The wombat is loose/
+    end
+  end
+
+  test "orders results newest first" do
+    cards(:logo).update_columns(title: "zebra first", created_at: 2.days.ago)
+    cards(:layout).update_columns(title: "zebra second", created_at: 1.day.ago)
+
+    get search_path(q: "zebra")
+
+    assert_response :success
+    titles = css_select("article.card .card__title").map { |element| element.text.strip }
+    assert_equal [ "zebra second", "zebra first" ], titles
+  end
+
+  test "does not show cards from inaccessible boards" do
+    boards(:private).cards.create!(title: "zebra confidential", status: "published", creator: users(:kevin))
+
+    get search_path(q: "zebra")
+
+    assert_response :success
+    assert_no_match /zebra confidential/, @response.body
+  end
+
+  test "shows cards from boards the user has access to" do
+    boards(:private).cards.create!(title: "zebra confidential", status: "published", creator: users(:kevin))
+
+    logout_and_sign_in_as :kevin
+
+    get search_path(q: "zebra")
+
+    assert_response :success
+    assert_select "article.card" do
+      assert_select ".card__title a", text: /zebra confidential/
+    end
+  end
+
+  test "does not show draft cards" do
+    boards(:writebook).cards.create!(title: "zebra draft", status: "drafted", creator: users(:david))
+
+    get search_path(q: "zebra")
+
+    assert_response :success
+    assert_no_match /zebra draft/, @response.body
+  end
+
+  test "does not show cards from other accounts" do
+    get search_path(q: "paycheck")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_select ".card__title a", count: 0
+  end
+
+  test "does not show comments of draft cards" do
+    cards(:layout).comments.create!(body: "The secret wombat", creator: users(:david))
+    cards(:layout).update_columns(status: "drafted")
+
+    get search_path(q: "wombat")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "blank query shows no results" do
+    get search_path
+
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+end
