--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,21 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_path(reactable.card, reactable, script_name: reactable.account.slug)
+    else
+      card_reactions_path(reactable, script_name: reactable.account.slug)
+    end
+  end
+
+  def reaction_path_for(reactable, reaction)
+    if reactable.is_a?(Comment)
+      card_comment_reaction_path(reactable.card, reactable, reaction, script_name: reactable.account.slug)
+    else
+      card_reaction_path(reactable, reaction, script_name: reactable.account.slug)
+    end
+  end
+
+  def emoji_reaction?(reaction)
+    EmojiHelper::REACTIONS.key?(reaction.content)
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..c6f2974
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,49 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "emoji" ]
+  static classes = [ "expanded" ]
+
+  show(event) {
+    event.preventDefault()
+
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", this.expandedClass)
+    this.#formElement?.classList.add(this.expandedClass)
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.#reset()
+  }
+
+  toggleEmoji(event) {
+    event.preventDefault()
+    this.emojiTarget.hidden = !this.emojiTarget.hidden
+  }
+
+  delete(event) {
+    event.currentTarget.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+
+  toggleDelete(event) {
+    if (event.target.closest("a, button, form, input, label")) return
+    if (event.currentTarget.dataset.reacterId !== window.Current?.user?.id) return
+    event.currentTarget.classList.toggle(this.expandedClass)
+  }
+
+  #reset() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", this.expandedClass)
+    this.#formElement?.reset()
+    this.#formElement?.classList.remove(this.expandedClass)
+    this.triggerTarget.hidden = false
+    if (this.hasEmojiTarget) this.emojiTarget.hidden = true
+  }
+
+  get #formElement() {
+    return this.formTarget.querySelector("form")
+  }
+}
