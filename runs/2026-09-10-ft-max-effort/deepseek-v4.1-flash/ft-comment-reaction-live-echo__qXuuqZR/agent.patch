diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..15404b9
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,44 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  include ActionView::RecordIdentifier
+
+  belongs_to :account, default: -> { card&.account }
+  belongs_to :card, optional: true
+  belongs_to :comment, optional: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+  validates :card, presence: true
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :on_cards, -> { where(comment_id: nil) }
+
+  after_create :register_card_activity
+  after_create_commit :broadcast_created
+  after_destroy_commit :broadcast_destroyed
+
+  def card
+    super || comment&.card
+  end
+
+  def reactable
+    comment || card
+  end
+
+  private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+
+    def broadcast_created
+      broadcast_replace_later_to [ card, :reactions ],
+        target: dom_id(reactable, :reactions),
+        partial: "cards/reactions/reactions",
+        locals: { reactable: reactable }
+    end
+
+    def broadcast_destroyed
+      broadcast_remove_to [ card, :reactions ], target: dom_id(self)
+    end
+end
