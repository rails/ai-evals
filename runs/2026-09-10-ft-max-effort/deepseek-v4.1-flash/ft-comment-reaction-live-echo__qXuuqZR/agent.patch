diff --git a/app/views/cards/reactions/_reactions.html.erb b/app/views/cards/reactions/_reactions.html.erb
new file mode 100644
index 0000000..74f47ec
--- /dev/null
+++ b/app/views/cards/reactions/_reactions.html.erb
@@ -0,0 +1,51 @@
+<% input_id = dom_id(reactable, :reaction_content) %>
+
+<div class="reactions"
+     id="<%= dom_id(reactable, :reactions) %>"
+     data-controller="reaction"
+     data-reaction-expanded-class="expanded">
+  <ul class="reactions__list">
+    <%= render collection: reactable.reactions.chronologically, partial: "cards/reactions/reaction", locals: { reactable: reactable } %>
+  </ul>
+
+  <div class="reaction--new" data-reaction-target="form" hidden>
+    <%= form_with url: reactions_path_for(reactable), scope: :reaction, class: "reaction__form",
+          data: { action: "keydown.esc->reaction#cancel:stop" } do |form| %>
+      <label class="reaction__form-label" for="<%= input_id %>">
+        <span class="for-screen-reader">Add a reaction</span>
+
+        <%= form.text_field :content, id: input_id, class: "input reaction__input", maxlength: Reaction::MAX_CONTENT_LENGTH,
+              autocomplete: "off", autocorrect: "off", spellcheck: "false",
+              placeholder: "React…", aria: { label: "Add a reaction" },
+              data: { reaction_target: "input" } %>
+      </label>
+
+      <div class="reaction__menu">
+        <button type="button" class="reaction__menu-btn btn" data-action="reaction#toggleEmoji" aria-label="Choose an emoji">
+          <%= icon_tag "reaction" %>
+        </button>
+
+        <div class="reaction__popup popup" hidden data-reaction-target="emoji">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+              <button type="submit" name="reaction[content]" value="<%= emoji %>" class="btn" title="<%= name %>" aria-label="<%= name %>"><%= emoji %></button>
+            <% end %>
+          </div>
+        </div>
+      </div>
+
+      <button type="submit" class="reaction__submit-btn btn" aria-label="Confirm reaction">
+        <%= icon_tag "check" %>
+      </button>
+
+      <button type="button" class="reaction__cancel-btn btn" data-action="reaction#cancel" aria-label="Cancel">
+        <%= icon_tag "close" %>
+      </button>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn" data-reaction-target="trigger" data-action="reaction#show">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+</div>
