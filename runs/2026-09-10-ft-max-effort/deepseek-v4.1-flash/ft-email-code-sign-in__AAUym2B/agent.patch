+require "test_helper"
+
+class EmailCodeSignInFlowTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "new renders the code form" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_select "input[name=code]"
+      assert_in_body "Psst, here's your code"
+      assert_in_body SignInCode.last.code
+    end
+  end
+
+  test "new without a pending authentication redirects to sign in" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create with a valid code signs in" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+
+      post session_magic_link_path, params: { code: last_code }
+
+      assert_redirected_to landing_url
+    end
+
+    assert parsed_cookies.signed[:session_token]
+    assert_equal identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "create with an invalid code does not sign in" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert_nil parsed_cookies.signed[:session_token]
+  end
+
+  test "a code expires after fifteen minutes" do
+    identity = identities(:kevin)
+    code = nil
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      code = last_code
+    end
+
+    travel 16.minutes do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to new_session_magic_link_path
+      end
+    end
+
+    assert_nil parsed_cookies.signed[:session_token]
+  end
+
+  test "create via JSON returns a session token" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }, as: :json
+      end
+
+      assert_response :created
+      assert @response.parsed_body["pending_authentication_token"].present?
+
+      post session_magic_link_path, params: { code: last_code }, as: :json
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create via JSON with an invalid code is unauthorized" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }, as: :json
+      post session_magic_link_path, params: { code: "WRONG1" }, as: :json
+
+      assert_response :unauthorized
+    end
+  end
+
+  private
+    def last_code
+      ActionMailer::Base.deliveries.last.subject.split(" ").first
+    end
+end
