--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,86 @@
+class Sessions::MagicLinksController < ApplicationController
+  include PendingAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    if @sign_in_code = pending_sign_in_code
+      @code = @sign_in_code.code if Rails.env.local?
+    else
+      redirect_to new_session_path, alert: "Your sign-in code has expired. Try again."
+    end
+  end
+
+  def create
+    if sign_in_code = pending_sign_in_code and sign_in_code.authenticate(params[:code])
+      complete_authentication sign_in_code
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def complete_authentication(sign_in_code)
+      identity = sign_in_code.identity || Identity.find_or_create_by!(email_address: sign_in_code.email_address)
+      intent = sign_in_code.intent
+      join_code = sign_in_code.account_join_code
+
+      sign_in_code.destroy!
+      clear_pending_authentication
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_after_authentication identity, intent, join_code }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def redirect_after_authentication(identity, intent, join_code)
+      case intent
+      when "join"
+        join_account identity, join_code
+      when "sign_up"
+        redirect_to new_signup_completion_path
+      else
+        redirect_to after_authentication_url
+      end
+    end
+
+    def join_account(identity, join_code)
+      if join_code
+        account = join_code.account
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: account, identity: identity)
+
+        if user.setup?
+          redirect_to landing_url(script_name: account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: account.slug)
+        end
+      else
+        redirect_to new_session_path, alert: "That join code is no longer available."
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
