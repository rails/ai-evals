+++ b/app/controllers/concerns/pending_authentication.rb
@@ -0,0 +1,24 @@
+module PendingAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def set_pending_authentication(sign_in_code)
+      cookies[:pending_authentication_token] = {
+        value: sign_in_code.token,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def clear_pending_authentication
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def pending_sign_in_code
+      SignInCode.find_signed(pending_authentication_token, purpose: :authentication)
+    end
+end
