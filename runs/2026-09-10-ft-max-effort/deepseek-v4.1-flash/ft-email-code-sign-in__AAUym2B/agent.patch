+++ b/test/controllers/email_code_authentication_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signing up sends a code and completes the identity" do
+    email_address = "email-code-signup-#{SecureRandom.hex(4)}@example.com"
+
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_emails 1 do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "sign_up", SignInCode.last.intent
+      assert_equal email_address, SignInCode.last.identity.email_address
+
+      assert_no_difference -> { Identity.count } do
+        post session_magic_link_path, params: { code: last_code }
+      end
+
+      assert_redirected_to new_signup_completion_path
+    end
+
+    assert Identity.exists?(email_address: email_address)
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "joining with a join code sends a code and joins the account" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "email-code-join-#{SecureRandom.hex(4)}@example.com"
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_emails 1 do
+        post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+      end
+    end
+
+    assert_response :redirect
+    assert_match %r{/session/magic_link\z}, response.location
+    assert_equal "join", SignInCode.last.intent
+    assert_equal join_code, SignInCode.last.account_join_code
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_magic_link_path, params: { code: last_code }
+      end
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    assert identity.users.exists?(account: account), "The identity should have joined the account"
+  end
+
+  private
+    def last_code
+      ActionMailer::Base.deliveries.last.subject.split(" ").first
+    end
+end
+
+class SessionsControllerEmailCodeTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "create with a new email address creates an identity and sends a code" do
+    email_address = "brand-new-#{SecureRandom.hex(4)}@example.com"
+
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_emails 1 do
+          post session_path, params: { email_address: email_address }
+        end
+      end
+
+      assert_redirected_to new_session_magic_link_path
+    end
+
+    assert Identity.exists?(email_address: email_address)
+  end
+
+  test "create with an invalid email address returns unprocessable entity" do
+    assert_no_emails do
+      untenanted do
+        post session_path, params: { email_address: "not-an-email" }, as: :json
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create puts the code in the email subject" do
+    assert_emails 1 do
+      untenanted do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_match(/\A[0-9A-Z]{6} /, mail.subject)
+    assert_match SignInCode.last.code, mail.subject
+  end
+
+  test "create is rate limited" do
