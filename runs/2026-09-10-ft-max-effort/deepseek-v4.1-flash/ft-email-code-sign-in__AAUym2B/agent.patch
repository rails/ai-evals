diff --git a/app/models/sign_in_code.rb b/app/models/sign_in_code.rb
new file mode 100644
index 0000000..d69de02
--- /dev/null
+++ b/app/models/sign_in_code.rb
@@ -0,0 +1,58 @@
+class SignInCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  INTENTS = %w[ sign_in sign_up join ].freeze
+
+  belongs_to :identity, optional: true
+  belongs_to :account_join_code, optional: true, class_name: "Account::JoinCode"
+
+  normalizes :email_address, with: ->(value) { value.to_s.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :intent, inclusion: { in: INTENTS }
+
+  before_create :assign_code
+  before_create :assign_expiration
+
+  scope :active, -> { where(expires_at: Time.current..) }
+
+  def self.generate(identity: nil, email_address: nil, intent: "sign_in", account_join_code: nil)
+    identity ||= Identity.find_or_create_by!(email_address: email_address)
+
+    create!(
+      identity: identity,
+      email_address: identity.email_address,
+      intent: intent,
+      account_join_code: account_join_code
+    )
+  end
+
+  def authenticate(candidate)
+    active? && ActiveSupport::SecurityUtils.secure_compare(code, candidate.to_s.strip.upcase)
+  end
+
+  def active?
+    expires_at.present? && expires_at > Time.current
+  end
+
+  def token
+    signed_id(purpose: :authentication, expires_in: EXPIRATION)
+  end
+
+  private
+    def assign_code
+      self.code ||= generate_code
+    end
+
+    def assign_expiration
+      self.expires_at ||= EXPIRATION.from_now
+    end
+
+    def generate_code
+      loop do
+        candidate = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+        break candidate unless self.class.active.exists?(code: candidate)
+      end
+    end
+end
