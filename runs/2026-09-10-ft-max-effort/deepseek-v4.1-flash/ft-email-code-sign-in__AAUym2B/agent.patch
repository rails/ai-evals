+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p class="txt-medium margin-none">
+    We sent a <%= SignInCode::CODE_LENGTH %>-character code to <strong><%= @sign_in_code.email_address %></strong>.
+  </p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "text", maxlength: SignInCode::CODE_LENGTH, class: "input txt-large full-width", placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <% if Rails.env.local? && @code.present? %>
+      <p class="txt-subtle txt-small margin-none">Psst, here's your code: <strong><%= @code %></strong></p>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
