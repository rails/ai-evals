diff --git a/app/controllers/concerns/reaction_scoped.rb b/app/controllers/concerns/reaction_scoped.rb
new file mode 100644
index 0000000..fb6cfc5
--- /dev/null
+++ b/app/controllers/concerns/reaction_scoped.rb
@@ -0,0 +1,48 @@
+module ReactionScoped
+  extend ActiveSupport::Concern
+
+  included do
+    wrap_parameters :reaction, include: %i[ content ]
+
+    include CardScoped
+
+    before_action :set_reactable
+    before_action :set_reaction, only: :destroy
+    before_action :ensure_permission_to_administer_reaction, only: :destroy
+  end
+
+  def index
+    render "cards/reactions/index"
+  end
+
+  def new
+    render "cards/reactions/new"
+  end
+
+  def create
+    @reaction = @reactable.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream { render "cards/reactions/create" }
+      format.json { render "cards/reactions/show", status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream { render "cards/reactions/destroy" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reaction
+      @reaction = @reactable.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..9eba513
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,33 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_path(reactable.card, reactable)
+    else
+      card_reactions_path(reactable)
+    end
+  end
+
+  def new_reaction_path_for(reactable)
+    if reactable.is_a?(Comment)
+      new_card_comment_reaction_path(reactable.card, reactable)
+    else
+      new_card_reaction_path(reactable)
+    end
+  end
+
+  def reaction_path_for(reaction)
+    if reaction.reactable.is_a?(Comment)
+      card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction)
+    else
+      card_reaction_path(reaction.reactable, reaction)
+    end
+  end
+
+  def reaction_url_for(reaction)
+    if reaction.reactable.is_a?(Comment)
+      card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction)
+    else
+      card_reaction_url(reaction.reactable, reaction)
+    end
+  end
+end
