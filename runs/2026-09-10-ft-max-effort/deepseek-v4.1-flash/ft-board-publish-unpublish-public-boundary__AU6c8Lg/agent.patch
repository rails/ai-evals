diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..ae77493
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,30 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Publishing</h2>
+    <p class="margin-none-block-start">
+      Publish this board to share it with anyone who has the secret link. People you share it with can view the board without signing in.
+    </p>
+
+    <% if board.published? %>
+      <div class="flex align-center gap-half margin-block-start">
+        <input type="text" class="input flex-item-grow" value="<%= board.public_url %>" readonly>
+
+        <%= tag.button class: "btn btn--link", data: {
+              controller: "copy-to-clipboard", action: "copy-to-clipboard#copy",
+              copy_to_clipboard_success_class: "btn--success",
+              copy_to_clipboard_content_value: board.public_url } do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+
+      <%= button_to board_publication_path(board), method: :delete, class: "btn btn--negative margin-block-start" do %>
+        <span>Unpublish board</span>
+      <% end %>
+    <% else %>
+      <%= button_to board_publication_path(board), method: :post, class: "btn margin-block-start" do %>
+        <span>Publish board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
