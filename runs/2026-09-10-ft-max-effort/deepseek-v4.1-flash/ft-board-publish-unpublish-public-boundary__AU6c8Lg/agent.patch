diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..d2f629e
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,30 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.turbo_stream { render_publication }
+      format.json { head :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.turbo_stream { render_publication }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def render_publication
+      render turbo_stream: turbo_stream.replace([ @board, :publication ], partial: "boards/edit/publication", locals: { board: @board })
+    end
+end
diff --git a/app/controllers/concerns/public_board_scoped.rb b/app/controllers/concerns/public_board_scoped.rb
new file mode 100644
index 0000000..ce6af2b
--- /dev/null
+++ b/app/controllers/concerns/public_board_scoped.rb
@@ -0,0 +1,26 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    skip_before_action :require_account
+    skip_after_action :block_search_engine_indexing
+
+    layout "public"
+
+    before_action :set_board
+  end
+
+  private
+    def set_board
+      @board = publication_scope.find_by!(key: params[:key] || params[:board_key]).board
+    end
+
+    def publication_scope
+      if Current.account
+        Board::Publication.where(account: Current.account)
+      else
+        Board::Publication.all
+      end
+    end
+end
