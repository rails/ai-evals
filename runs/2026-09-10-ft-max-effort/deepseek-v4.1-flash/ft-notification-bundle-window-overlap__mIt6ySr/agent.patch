diff --git a/app/models/notification/bundlable.rb b/app/models/notification/bundlable.rb
new file mode 100644
index 0000000..2941ea7
--- /dev/null
+++ b/app/models/notification/bundlable.rb
@@ -0,0 +1,20 @@
+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :capture_in_bundle, if: :bundleable?
+  end
+
+  private
+    def capture_in_bundle
+      # New activity bumps an existing notification rather than creating one,
+      # so make sure it lands in the window that is currently open.
+      Notification::Bundle.capture(self) if source_id_previously_changed?
+    end
+
+    def bundleable?
+      user.settings&.bundling_emails? || false
+    end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..726655a
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,92 @@
+# A time window during which a person's notifications are collected so they can
+# be emailed together, instead of one email per notification.
+#
+# The window opens when the first notification lands and closes after the
+# person's configured frequency. Notifications that arrive late still belong to
+# the window that is currently open, which guarantees that a person never ends
+# up with two overlapping windows.
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :pending, -> { undelivered }
+  scope :open, -> { undelivered.where(ends_at: Time.current..) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    # Finds (or opens) the window a notification belongs to and files it there.
+    # Returns nil when the person has asked not to receive bundle emails.
+    def capture(notification)
+      user = notification.user
+      duration = User::Settings::BUNDLE_EMAIL_FREQUENCY_DURATIONS[user.settings&.bundle_email_frequency]
+      return if duration.blank?
+
+      # Serialize window creation per person so concurrent notifications can't
+      # each open a window and end up overlapping.
+      user.with_lock do
+        bundle = open_window_for(user) || open_window(user, duration)
+        notification.bundle = bundle
+        notification.update_column(:bundle_id, bundle.id)
+        bundle
+      end
+    end
+
+    # Delivers every window whose time is up. The scheduled per-window job is
+    # the normal path; this is a safety net for deliveries that were missed.
+    def deliver_due
+      due.find_each(&:deliver)
+    end
+
+    def covering(time)
+      where("starts_at <= ? AND ends_at > ?", time, time)
+    end
+
+    private
+      def open_window_for(user)
+        user.notification_bundles.undelivered.covering(Time.current).order(:starts_at).last
+      end
+
+      def open_window(user, duration)
+        now = Time.current
+        user.notification_bundles.create!(starts_at: now, ends_at: now + duration)
+      end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def pending?
+    !delivered?
+  end
+
+  def due?
+    pending? && ends_at <= Time.current
+  end
+
+  def deliver
+    with_lock do
+      return if delivered?
+
+      update!(delivered_at: Time.current)
+
+      if deliverable?
+        Current.with_account(account) { NotificationMailer.bundle(self).deliver_later }
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::BundleJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  private
+    def deliverable?
+      notifications.any? && user.identity.present?
+    end
+end
