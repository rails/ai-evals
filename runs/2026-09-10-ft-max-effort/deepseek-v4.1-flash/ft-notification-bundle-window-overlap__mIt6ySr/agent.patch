index 4af896a..058b034 100644
--- a/app/controllers/notifications/settings_controller.rb
+++ b/app/controllers/notifications/settings_controller.rb
@@ -1,5 +1,29 @@
 class Notifications::SettingsController < ApplicationController
   def show
     @boards = Current.user.boards.alphabetically
+    @settings = Current.user.settings || Current.user.build_settings
   end
+
+  def update
+    settings = Current.user.settings || Current.user.create_settings
+
+    if settings.update(settings_params)
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path }
+        format.json { head :no_content }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: settings.errors.full_messages.to_sentence }
+        format.json { render json: settings.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+    def settings_params
+      # Accept both a nested user_settings hash and a top-level attribute so the
+      # setting can be updated from any notification settings form.
+      params.fetch(:user_settings, params).permit(:bundle_email_frequency)
+    end
 end
diff --git a/app/helpers/notification_mailer_helper.rb b/app/helpers/notification_mailer_helper.rb
new file mode 100644
index 0000000..7479f1f
--- /dev/null
+++ b/app/helpers/notification_mailer_helper.rb
@@ -0,0 +1,25 @@
+module NotificationMailerHelper
+  include NotificationsHelper
+
+  def notification_email_title(notification)
+    case notification.source
+    when Event
+      event_notification_title(notification.source)
+    when Mention
+      "#{notification.source.mentioner.first_name} mentioned you"
+    else
+      notification.card.title
+    end
+  end
+
+  def notification_email_body(notification)
+    case notification.source
+    when Event
+      event_notification_body(notification.source)
+    when Mention
+      notification.source.source.mentionable_content.truncate(200)
+    else
+      ""
+    end
+  end
+end
