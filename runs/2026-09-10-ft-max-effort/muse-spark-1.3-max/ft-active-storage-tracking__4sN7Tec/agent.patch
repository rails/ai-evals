diff --git a/app/models/card/storage_tracking.rb b/app/models/card/storage_tracking.rb
new file mode 100644
index 0000000..991c4de
--- /dev/null
+++ b/app/models/card/storage_tracking.rb
@@ -0,0 +1,40 @@
+module Card::StorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :capture_old_board_id_for_storage, if: :board_id_changed?
+    after_update_commit :recalculate_storage_on_board_change
+    after_destroy_commit :recalculate_storage_on_destroy
+  end
+
+  private
+    def capture_old_board_id_for_storage
+      @old_board_id_for_storage = board_id_was
+    end
+
+    def recalculate_storage_on_board_change
+      # Use captured id because handle_board_change performs an additional save
+      # in the same transaction, which would hide the original board change
+      # from saved_change_to_board_id? in after_update_commit.
+      old_board_id = @old_board_id_for_storage
+      @old_board_id_for_storage = nil
+      return unless old_board_id
+
+      new_board_id = board_id
+      return if old_board_id == new_board_id
+
+      if (old_board = Board.find_by(id: old_board_id))
+        old_board.recalculate_bytes_used_later
+      end
+
+      if new_board_id && (new_board = Board.find_by(id: new_board_id))
+        new_board.recalculate_bytes_used_later
+      end
+    end
+
+    def recalculate_storage_on_destroy
+      if board_id && (board = Board.find_by(id: board_id))
+        board.recalculate_bytes_used_later
+      end
+    end
+end
