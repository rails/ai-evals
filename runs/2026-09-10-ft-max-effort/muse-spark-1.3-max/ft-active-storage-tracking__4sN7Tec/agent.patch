diff --git a/lib/rails_ext/action_text_rich_text_storage_tracking.rb b/lib/rails_ext/action_text_rich_text_storage_tracking.rb
new file mode 100644
index 0000000..8bed8a7
--- /dev/null
+++ b/lib/rails_ext/action_text_rich_text_storage_tracking.rb
@@ -0,0 +1,40 @@
+# Recalculates storage when a rich text record itself is destroyed.
+#
+# Embed attachments have their own tracking, but when a rich text is destroyed
+# standalone (not as part of its parent card, comment, or board being destroyed),
+# its attachments are suppressed (their parent is gone), so the rich text must
+# trigger the recalculation itself.
+#
+# When the parent is also gone, the parent's own destroy handler recalculates,
+# so we skip to avoid duplicate jobs.
+module ActionTextRichTextStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :recalculate_storage_on_destroy
+  end
+
+  private
+    def recalculate_storage_on_destroy
+      if (board_id = storage_board_id) && (board = Board.find_by(id: board_id))
+        board.recalculate_bytes_used_later
+      end
+    end
+
+    def storage_board_id
+      case record_type
+      when "Board"
+        Board.exists?(record_id) ? record_id : nil
+      when "Card"
+        Card.where(id: record_id).pick(:board_id)
+      when "Comment"
+        Comment.joins(:card).where(comments: { id: record_id }).pick("cards.board_id")
+      else
+        nil
+      end
+    end
+end
+
+Rails.application.config.to_prepare do
+  ActionText::RichText.include ActionTextRichTextStorageTracking
+end
diff --git a/lib/rails_ext/active_storage_attachment_storage_tracking.rb b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
new file mode 100644
index 0000000..e9c2f2a
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
@@ -0,0 +1,98 @@
+# Tracks storage usage for card images and rich text embeds.
+#
+# Counted attachments:
+# - Card images (record_type: "Card", name: "image")
+# - Rich text embeds (record_type: "ActionText::RichText", name: "embeds")
+#   where the rich text belongs to a Board, Card, or Comment.
+#
+# All other attachments (avatars, exports, imports, variant records, etc.)
+# are ignored.
+#
+# Storage is recalculated in the background via Board::RecalculateBytesUsedJob,
+# which also updates the parent account. Recalculation uses efficient SQL SUM
+# queries, so it works for small boards as well as boards with many attachments.
+# Jobs are idempotent, so concurrent uploads from many users converge correctly.
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :recalculate_storage_on_create
+    before_destroy :capture_storage_board_before_destroy
+    after_destroy_commit :recalculate_storage_on_destroy
+  end
+
+  # +delete+ bypasses callbacks, so we must track storage here for
+  # +purge+, +purge_later+, and +detach+, which all use +delete+ internally.
+  # +destroy+ uses a separate path (+destroy_row+), so this does not double-track.
+  def delete
+    board_id = storage_board_id
+    super.tap do
+      if board_id && (board = Board.find_by(id: board_id))
+        board.recalculate_bytes_used_later
+      end
+    end
+  end
+
+  private
+    def recalculate_storage_on_create
+      if (board_id = storage_board_id) && (board = Board.find_by(id: board_id))
+        board.recalculate_bytes_used_later
+      end
+    end
+
+    def capture_storage_board_before_destroy
+      @storage_board_id_before_destroy = storage_board_id
+    end
+
+    def recalculate_storage_on_destroy
+      # If the parent record is gone, its own destroy handler will recalculate.
+      # This avoids N jobs when destroying cards, comments, or boards with many attachments.
+      return unless parent_still_exists?
+
+      if (board_id = @storage_board_id_before_destroy) && (board = Board.find_by(id: board_id))
+        board.recalculate_bytes_used_later
+      end
+    end
+
+    def parent_still_exists?
+      case record_type
+      when "Card"
+        return false unless name == "image"
+        Card.exists?(record_id)
+      when "ActionText::RichText"
+        return false unless name == "embeds"
+        ActionText::RichText.exists?(record_id)
+      else
+        false
+      end
+    end
+
+    def storage_board_id
+      case record_type
+      when "Card"
+        return nil unless name == "image"
+        Card.where(id: record_id).pick(:board_id)
+      when "ActionText::RichText"
+        return nil unless name == "embeds"
+        rich_text = ActionText::RichText.find_by(id: record_id)
+        return nil unless rich_text
+
+        case rich_text.record_type
+        when "Board"
+          rich_text.record_id
+        when "Card"
+          Card.where(id: rich_text.record_id).pick(:board_id)
+        when "Comment"
+          Comment.joins(:card).where(comments: { id: rich_text.record_id }).pick("cards.board_id")
+        else
+          nil
+        end
+      else
+        nil
+      end
+    end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.include ActiveStorageAttachmentStorageTracking
+end
