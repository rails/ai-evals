@@ -0,0 +1,148 @@
+require "test_helper"
+
+class Board::BytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "new board has zero bytes used" do
+    board = boards(:writebook)
+    assert_equal 0, board.bytes_used
+  end
+
+  test "card image counted in background" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob) do
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "test.jpg", content_type: "image/jpeg")
+    end
+
+    # Stale until jobs run
+    assert_equal 0, board.reload.bytes_used
+
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    assert_equal card.image.blob.byte_size, board.reload.bytes_used
+    assert_equal card.image.blob.byte_size, board.account.reload.bytes_used
+  end
+
+  test "card description embed counted" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "embed.jpg", content_type: "image/jpeg")
+    html = ActionText::Attachment.from_attachable(blob).to_html
+    card.update!(description: "<p>Hi #{html}</p>")
+
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+  end
+
+  test "comment embed counted" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * 100), filename: "c.txt", content_type: "text/plain")
+    html = ActionText::Attachment.from_attachable(blob).to_html
+    card.comments.create!(body: "<p>Hey #{html}</p>", creator: users(:david))
+
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+  end
+
+  test "board description embed counted" do
+    board = boards(:writebook)
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("y" * 200), filename: "b.txt", content_type: "text/plain")
+    html = ActionText::Attachment.from_attachable(blob).to_html
+    board.update!(public_description: "<p>Desc #{html}</p>")
+
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+    assert_equal blob.byte_size, board.account.reload.bytes_used
+  end
+
+  test "avatars ignored" do
+    board = boards(:writebook)
+
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    assert_equal 0, board.reload.bytes_used
+  end
+
+  test "purge decrements" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "test.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    size = card.image.blob.byte_size
+    assert_equal size, board.reload.bytes_used
+
+    card.image.purge_later
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  test "moving card transfers bytes" do
+    board = boards(:writebook)
+    other = boards(:private)
+    card = cards(:logo)
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("z" * 500), filename: "m.txt", content_type: "text/plain")
+    html = ActionText::Attachment.from_attachable(blob).to_html
+    card.update!(description: "<p>Hi #{html}</p>")
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
