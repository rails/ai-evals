--- /dev/null
+++ b/app/models/board/bytes_used.rb
@@ -0,0 +1,83 @@
+module Board::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :recalculate_account_bytes_used_after_destroy
+  end
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    with_lock do
+      update_columns(bytes_used: calculate_bytes_used)
+    end
+
+    if account_id && (current_account = Account.find_by(id: account_id))
+      current_account.recalculate_bytes_used_now
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Board was destroyed before the lock could be acquired; nothing to do.
+    nil
+  end
+
+  def calculate_bytes_used
+    card_images_bytes_used + board_embeds_bytes_used + card_embeds_bytes_used + comment_embeds_bytes_used
+  end
+
+  private
+    def recalculate_account_bytes_used_after_destroy
+      if account_id && (current_account = Account.find_by(id: account_id))
+        current_account.recalculate_bytes_used_later
+      end
+    end
+
+    def card_images_bytes_used
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def board_embeds_bytes_used
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: board_rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_embeds_bytes_used
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: card_rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comment_embeds_bytes_used
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: comment_rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def board_rich_text_ids
+      ActionText::RichText.where(record_type: "Board", record_id: id).select(:id)
+    end
+
+    def card_rich_text_ids
+      ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id)).select(:id)
+    end
+
+    def comment_rich_text_ids
+      ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id)).select(:id)
+    end
+
+    def comments
+      Comment.where(card_id: cards.select(:id))
+    end
+end
