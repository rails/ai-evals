--- /dev/null
+++ b/app/controllers/public/boards/cards_controller.rb
@@ -0,0 +1,25 @@
+class Public::Boards::CardsController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  def show
+    @board = find_published_board
+    Current.account = @board.account
+    number = params[:number] || params[:id]
+    raise ActiveRecord::RecordNotFound unless number.to_s.match?(/\A\d+\z/)
+    @card = @board.cards.published.find_by!(number: number)
+
+    respond_to do |format|
+      format.html
+      format.json
+    end
+  end
+
+  private
+    def find_published_board
+      key = params[:board_key] || params[:key] || params[:board_id]
+      Board.find_by!(public_key: key)
+    end
+end
