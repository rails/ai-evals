diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..de3e1e9
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,41 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :public_key, uniqueness: true, allow_nil: true
+    alias_attribute :public_token, :public_key
+  end
+
+  def published?
+    public_key.present?
+  end
+  alias_method :public?, :published?
+  alias_method :is_published?, :published?
+
+  def publish!
+    return self if published?
+    update!(public_key: self.class.generate_unique_public_key)
+    self
+  end
+  alias_method :publish, :publish!
+
+  def unpublish!
+    update!(public_key: nil) if published?
+    self
+  end
+  alias_method :unpublish, :unpublish!
+
+  def public_url
+    return nil unless published?
+    "#{account.slug}/public/boards/#{public_key}"
+  end
+
+  class_methods do
+    def generate_unique_public_key
+      loop do
+        key = SecureRandom.urlsafe_base64(24)
+        break key unless exists?(public_key: key)
+      end
+    end
+  end
+end
