@@ -0,0 +1,38 @@
+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="cards cards--grid">
+  <div class="card-columns">
+    <% @columns.each do |column| %>
+      <div class="cards" id="<%= dom_id(column) %>">
+        <header class="cards__header">
+          <h2><%= column.name %></h2>
+          <%= link_to "Open column", public_board_column_path(@board.public_key, column), class: "btn" %>
+        </header>
+        <div class="cards__list">
+          <% column.cards.published.latest.with_golden_first.preloaded.limit(50).each do |card| %>
+            <article class="card" id="<%= dom_id(card) %>">
+              <h3><%= link_to card.title, public_board_card_path(@board.public_key, card.number) %></h3>
+              <p><%= truncate(card.description.to_plain_text, length: 200) %></p>
+            </article>
+          <% end %>
+        </div>
+      </div>
+    <% end %>
+  </div>
+
+  <div class="cards__list" id="maybe">
+    <h2>Maybe?</h2>
+    <% @board.cards.awaiting_triage.latest.with_golden_first.preloaded.limit(50).each do |card| %>
+      <article class="card" id="<%= dom_id(card) %>">
+        <h3><%= link_to card.title, public_board_card_path(@board.public_key, card.number) %></h3>
+        <p><%= truncate(card.description.to_plain_text, length: 200) %></p>
+      </article>
+    <% end %>
+  </div>
+</section>
