@@ -0,0 +1,24 @@
+# Copy to `.kamal/secrets` and fill in real values. Never commit `.kamal/secrets`.
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# Secrets are read by Kamal (dotenv format) and injected into the container.
+# Supports `$VAR` passthrough and `$(command)` substitution, e.g.:
+#   SECRET_KEY_BASE=$(bin/rails secret)
+
+# Docker registry password (Docker Hub access token). Required for `kamal setup`.
+# Create at https://app.docker.com/settings/personal-access-tokens (read/write/delete).
+KAMAL_REGISTRY_PASSWORD=your-registry-token-here
+
+# Rails session/encryption secret. Required. Generate with:
+#   bin/rails secret
+SECRET_KEY_BASE=your-secret-key-base-here
+
+# SMTP password for the mail server in config/deploy.yml (`SMTP_USER_NAME`).
+# Leave blank (empty value) if your relay needs no authentication.
+SMTP_PASSWORD=your-smtp-password-here
+
+# Optional: web push (browser notifications). Generate with:
+#   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{k.private_key}\nVAPID_PUBLIC_KEY=#{k.public_key}"'
+# Then uncomment the two lines in config/deploy.yml `env.secret` and redeploy.
+# VAPID_PRIVATE_KEY=your-vapid-private-key-here
+# VAPID_PUBLIC_KEY=your-vapid-public-key-here
