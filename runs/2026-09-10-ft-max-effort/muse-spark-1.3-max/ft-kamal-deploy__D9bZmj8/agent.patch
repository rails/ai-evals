--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,94 @@
+# Fizzy — single-server Kamal deploy.
+#
+# One Linux box with Docker, SQLite, everything in one container, SSL from kamal-proxy.
+#
+# Fork setup:
+#   1. Replace the TODO placeholders below (server, host, image/registry, mail server).
+#   2. Copy .kamal/secrets.example to .kamal/secrets and fill in real secret values.
+#   3. Run `bin/kamal setup` — Fizzy will be live at https://your-host.
+#   4. Later deploys: `bin/kamal deploy`. Data survives because /rails/storage is a named volume.
+#
+# See docs/deploy.md for the full guide.
+
+service: fizzy
+image: your-user/fizzy
+
+# Single box. Put your server's IP or hostname here (must have Docker, reachable over SSH).
+servers:
+  web:
+    - 192.0.2.1 # TODO: replace with your server IP or hostname
+
+# SSL is terminated at kamal-proxy with automatic Let's Encrypt certificates.
+# DNS for `host` must point at the server above, and ports 80/443 must be open.
+proxy:
+  ssl: true
+  host: fizzy.example.com # TODO: replace with your public hostname (https://...)
+  # Proxy forwards to the container on port 80 by default (Thruster in Dockerfile). No app_port needed.
+
+# Image registry. Default is Docker Hub: `image` must be prefixed with your username,
+# and `username` must match. Create a Docker Hub access token for the password.
+# For GHCR, set `server: ghcr.io` and use `image: ghcr.io/your-user/fizzy`.
+registry:
+  username: your-user # TODO: replace with your Docker Hub username (must match image prefix)
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Build a Linux/amd64 image (most servers). Use `arm64` for ARM boxes.
+builder:
+  arch: amd64
+
+# Share fingerprinted assets (JS/CSS) between old and new containers to avoid 404s during deploys.
+asset_path: /rails/public/assets
+
+# Persist SQLite databases (primary, cable, cache, queue) and Active Storage files.
+# Without this volume, `kamal deploy` would wipe your data. Named volumes survive redeploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Keep image/container history small on a one-box server.
+retain_containers: 2
+
+# Environment injected into the container. Secrets come from `.kamal/secrets` (see .kamal/secrets.example).
+env:
+  clear:
+    RAILS_ENV: production
+    # SQLite is the default for open-source Fizzy; be explicit so forks never pick up MySQL.
+    DATABASE_ADAPTER: sqlite
+    # Local disk Active Storage, stored under /rails/storage (persisted by the volume above).
+    ACTIVE_STORAGE_SERVICE: local
+    # Run Solid Queue workers inside Puma so background jobs run in the single web container.
+    # This is also the Puma default for OSS (see config/puma.rb); set explicitly for clarity.
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Public hostname used for absolute URLs in mailers, Active Storage, notifications and webhooks.
+    # Must match `proxy.host` above.
+    APP_HOST: fizzy.example.com # TODO: replace with your public hostname
+    # Sender for magic links and notifications.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@fizzy.example.com>" # TODO: replace with your sender address
+    # Outbound mail server (magic links, notifications, exports). See docs/deploy.md.
+    SMTP_ADDRESS: smtp.example.com # TODO: replace with your SMTP host
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: fizzy.example.com # TODO: usually the same as APP_HOST
+    SMTP_USER_NAME: your-smtp-username # TODO: replace with your SMTP username (blank for no auth)
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    # Uncomment to allow open signups. Default (unset/false) lets the first account sign up,
+    # then closes registration — ideal for self-hosting a single team.
+    # MULTI_TENANT: "false"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Optional: web push (browser notifications). Generate with `bin/rails runner` (see docs/deploy.md),
+    # add both values to `.kamal/secrets`, then uncomment these two lines and redeploy.
+    # - VAPID_PRIVATE_KEY
+    # - VAPID_PUBLIC_KEY
+
+# Shortcuts: `bin/kamal console`, `bin/kamal shell`, `bin/kamal logs`, ...
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# Uncomment if you SSH as a non-root user.
+# ssh:
+#   user: app
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..966549b 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,41 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Single-server self-hosting (OSS): public hostname and SMTP from ENV.
+  # SaaS sets these in saas/config/environments/*.rb, so don't overwrite there.
+  # Don't overwrite if already set (e.g. by fizzy-saas).
+  unless Fizzy.saas?
+    app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence || ENV["HOST"].presence
+
+    if app_host.present? && config.action_mailer.default_url_options.blank?
+      config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+    end
+
+    if app_host.present? && config.action_controller.default_url_options.blank?
+      config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    end
+
+    if ENV["SMTP_ADDRESS"].present? && config.action_mailer.smtp_settings.blank?
+      smtp_user_name = ENV["SMTP_USER_NAME"].presence
+      smtp_authentication = ENV["SMTP_AUTHENTICATION"].presence
+      smtp_authentication ||= "plain" if smtp_user_name.present?
+
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: ENV.fetch("SMTP_ADDRESS"),
+        port: ENV.fetch("SMTP_PORT", 587).to_i,
+        domain: ENV["SMTP_DOMAIN"].presence || app_host.presence,
+        user_name: smtp_user_name,
+        password: ENV["SMTP_PASSWORD"].presence,
+        authentication: smtp_authentication,
+        enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true",
+        tls: (true if ENV["SMTP_TLS"] == "true"),
+        open_timeout: ENV.fetch("SMTP_OPEN_TIMEOUT", 5).to_i,
+        read_timeout: ENV.fetch("SMTP_READ_TIMEOUT", 5).to_i
+      }.compact
+    end
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/deploy.md b/docs/deploy.md
new file mode 100644
index 0000000..1208e67
--- /dev/null
+++ b/docs/deploy.md
@@ -0,0 +1,113 @@
+## Deploy with Kamal (single server)
+
+Fizzy ships with a one-box Kamal config: a single Linux server with Docker, SQLite,
+everything in one container, and SSL from kamal-proxy. Forks only need to fill in
+their hostname, mail server, and secrets, then run `kamal setup`.
+
+### Architecture
+
+- **One container** (`service: fizzy`): Thruster → Puma → Rails, with Solid Queue
+  workers running inside Puma (`SOLID_QUEUE_IN_PUMA=true`, see `config/puma.rb`).
+  No separate job container, no Redis.
+- **SQLite**: `DATABASE_ADAPTER=sqlite` with four files under `/rails/storage`
+  (`production.sqlite3`, `production_cable.sqlite3`, `production_cache.sqlite3`,
+  `production_queue.sqlite3`, see `config/database.sqlite.yml`) plus Active Storage
+  files under `/rails/storage/production/files`.
+- **Persistence**: `fizzy_storage:/rails/storage` named volume in `config/deploy.yml`.
+  Without it, each deploy would wipe the database and uploads.
+- **SSL**: `proxy.ssl: true` in `config/deploy.yml` provisions Let's Encrypt
+  certificates on the box. The app itself runs HTTP-only behind the proxy
+  (`assume_ssl`/`force_ssl` stay enabled in `config/environments/production.rb`).
+- **Mail**: magic links and notifications need a reachable SMTP relay and a public
+  hostname (`APP_HOST`, `SMTP_*` in `config/deploy.yml`, wired in
+  `config/environments/production.rb`). Sender defaults via `MAILER_FROM_ADDRESS`.
+
+### Prerequisites
+
+- A Linux server (amd64; use `builder.arch: arm64` for ARM) with Docker and SSH access.
+- A public hostname with DNS pointing at the server, ports 80/443 open.
+- A Docker Hub account (or GHCR) for the built image.
+- An SMTP relay (any provider) with host, port, username, password.
+
+### Setup (fork)
+
+1. **Edit `config/deploy.yml`** — replace every `TODO`:
+   - `servers.web`: your server IP or hostname.
+   - `proxy.host` and `env.clear.APP_HOST`: your public hostname (must match;
+     the app will be at `https://<host>`).
+   - `image` and `registry.username`: your Docker Hub namespace, e.g.
+     `image: alice/fizzy` + `username: alice`. For GHCR use
+     `server: ghcr.io` + `image: ghcr.io/alice/fizzy`.
+   - `env.clear.MAILER_FROM_ADDRESS`, `SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_DOMAIN`,
+     `SMTP_USER_NAME`, `SMTP_AUTHENTICATION`, `SMTP_ENABLE_STARTTLS_AUTO`: your
+     mail relay. `SMTP_DOMAIN` is usually the same as `APP_HOST`.
+   - For port 465 (implicit TLS), add `SMTP_TLS: "true"` under `env.clear`
+     and keep `SMTP_PORT: "465"`.
+
+2. **Create secrets**:
+   ```sh
+   cp .kamal/secrets.example .kamal/secrets
+   ```
+   Fill in:
+   - `KAMAL_REGISTRY_PASSWORD`: Docker Hub access token
+     (https://app.docker.com/settings/personal-access-tokens, read/write/delete).
+   - `SECRET_KEY_BASE`: generate with `bin/rails secret`.
+   - `SMTP_PASSWORD`: password for `SMTP_USER_NAME` (blank if your relay needs no auth).
+
+   Optional web push (browser notifications):
+   ```sh
+   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{k.private_key}\nVAPID_PUBLIC_KEY=#{k.public_key}"'
+   ```
+   Add both values to `.kamal/secrets`, uncomment the two `VAPID_*` lines under
+   `env.secret` in `config/deploy.yml`, and redeploy.
+
+3. **Deploy**:
+   ```sh
+   bin/kamal setup
+   ```
+   This bootstraps Docker, starts kamal-proxy with SSL, pushes env, and deploys.
+   Visit `https://your-host`. The first signup creates the first account; further
+   signups close automatically unless you set `MULTI_TENANT: "true"` in
+   `config/deploy.yml` (see `Account::MultiTenantable`).
+
+4. **Later deploys**:
+   ```sh
+   bin/kamal deploy
+   ```
+   Data survives because `/rails/storage` is a named volume. Fingerprinted assets
+   are bridged via `asset_path: /rails/public/assets` to avoid 404s mid-deploy.
+
+### Operations
+
+- Logs: `bin/kamal logs` or `bin/kamal app logs`
+- Console: `bin/kamal console` (`bin/rails console` on the box)
+- Shell: `bin/kamal shell`
+- DB console: `bin/kamal dbc`
+- Proxy logs: `bin/kamal proxy logs`
+- Reboot-safe: containers restart with Docker; the `fizzy_storage` volume persists.
+
+### Troubleshooting
+
+- **SSL/Let's Encrypt fails**: DNS must resolve `proxy.host` to the box *before*
+  `kamal setup`, and 80/443 must be reachable. Check `bin/kamal proxy logs`.
+- **No email (magic link never arrives)**: verify `APP_HOST`, `SMTP_*`, and
+  `MAILER_FROM_ADDRESS` in `config/deploy.yml`, `SMTP_PASSWORD` in `.kamal/secrets`,
+  then `bin/kamal app logs`. For unauthenticated relays on port 25, use
+  `SMTP_PORT: "25"`, blank `SMTP_USER_NAME`, and `SMTP_ENABLE_STARTTLS_AUTO: "false"`.
+- **Data wiped after deploy**: ensure `volumes: ["fizzy_storage:/rails/storage"]`
+  is present and you didn't run `kamal remove` (which deletes volumes).
+- **Jobs not running**: keep `SOLID_QUEUE_IN_PUMA: "true"` (default for OSS).
+  Check `/jobs` (Mission Control) and `bin/kamal app logs`. Recurring jobs are
+  declared in `config/recurring.yml`.
+- **Registry auth fails**: `image` prefix must match `registry.username`, and
+  `KAMAL_REGISTRY_PASSWORD` must be a valid token, not your account password.
+- **Wrong arch**: `builder.arch` must match the server (`amd64` vs `arm64`).
+  Mismatches fail at boot with `exec format error`.
+
+### Customizing
+
+- **SSH user**: uncomment `ssh.user` in `config/deploy.yml` if you don't deploy as root.
+- **Resources**: tune `WEB_CONCURRENCY` / `JOB_CONCURRENCY` via `env.clear` for small
+  boxes (defaults are CPU count; see `config/puma.rb` and `config/queue.yml`).
+- **Object storage**: set `ACTIVE_STORAGE_SERVICE: s3` plus `S3_*` env vars
+  (see `config/storage.oss.yml`) instead of `local` if you prefer S3 over disk.
