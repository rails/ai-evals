diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..fd30ac1
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,48 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  validates :webhook_id, uniqueness: true
+
+  def record_success
+    reset unless fresh?
+  end
+  alias_method :record_success!, :record_success
+
+  def record_failure
+    with_lock do
+      self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+      self.first_failure_at ||= Time.current
+      save! if changed?
+
+      deactivate_webhook_if_delinquent
+    end
+  end
+  alias_method :record_failure!, :record_failure
+
+  def reset
+    unless fresh?
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+  end
+  alias_method :reset!, :reset
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_THRESHOLD &&
+      first_failure_at.present? && first_failure_at <= FAILURE_WINDOW.ago
+  end
+
+  private
+    def fresh?
+      consecutive_failures_count.to_i.zero? && first_failure_at.nil?
+    end
+
+    def deactivate_webhook_if_delinquent
+      if delinquent? && webhook.active?
+        webhook.deactivate
+      end
+    end
+end
