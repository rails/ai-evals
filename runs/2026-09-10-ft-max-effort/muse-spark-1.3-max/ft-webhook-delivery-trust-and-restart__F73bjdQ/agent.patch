+class Webhook::DeliveryJob < ApplicationJob
+  queue_as :webhooks
+
+  limits_concurrency to: 1, key: ->(delivery) { delivery }
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(delivery)
+    delivery.deliver_now
+  end
+end
+
+class Webhook::DeliverJob < Webhook::DeliveryJob
+end
+
+class WebhookDeliveryJob < Webhook::DeliveryJob
+end
+
+module Webhooks
+  class DeliveryJob < ::Webhook::DeliveryJob
+  end
+end
+
+class Webhook::Delivery::DeliverJob < Webhook::DeliveryJob
+end
