+  alias_method :perform, :deliver_now
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +67,101 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def perform_delivery
+      payload = build_payload
+      timestamp = Time.current.utc.iso8601
+      signature = generate_signature(payload)
+      headers = build_headers(timestamp: timestamp, signature: signature)
+
+      update!(request: { headers: headers })
+
+      http_response = post_payload(payload, headers)
+      code = http_response.code.to_i
+
+      update!(state: :completed, response: { code: code })
+
+      track_delivery_result
+    rescue => error
+      handle_delivery_error(error)
+    end
+
+    def build_payload
+      Current.with(account: event.account) do
+        ApplicationController.render(template: "webhooks/event", assigns: { event: event }, formats: :json)
+      end
+    end
+
+    def generate_signature(payload)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def build_headers(timestamp:, signature:)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def post_payload(payload, headers)
+      uri = URI.parse(webhook.url)
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri, headers)
+        request.body = payload
+        http.request(request)
+      end
+    end
+
+    def track_delivery_result
+      tracker = webhook.ensure_delinquency_tracker
+
+      if succeeded?
+        tracker.record_success
+      else
+        tracker.record_failure
+      end
+    rescue => error
+      Rails.logger.error "Webhook::Delivery track result failed: #{error.class} #{error.message}"
+    end
+
+    def handle_delivery_error(error)
+      Rails.logger.error "Webhook::Delivery failed: #{error.class} #{error.message}"
+
+      error_name = error_name_for(error)
+
+      begin
+        if request.blank?
+          update!(state: :errored, request: { headers: {} }, response: { error: error_name })
+        else
+          update!(state: :errored, response: { error: error_name })
+        end
+      rescue => update_error
+        Rails.logger.error "Webhook::Delivery error update failed: #{update_error.class} #{update_error.message}"
+      end
+
+      begin
+        webhook.ensure_delinquency_tracker.record_failure
+      rescue => tracker_error
+        Rails.logger.error "Webhook::Delivery tracker failure failed: #{tracker_error.class} #{tracker_error.message}"
+      end
+    end
+
+    def error_name_for(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        "timeout"
+      when SocketError, SystemCallError, IOError, EOFError
+        "destination_unreachable"
+      when OpenSSL::SSL::SSLError
+        "ssl_error"
+      when URI::InvalidURIError
+        "invalid_url"
+      else
+        error.class.name.demodulize.underscore
+      end
+    end
 end
