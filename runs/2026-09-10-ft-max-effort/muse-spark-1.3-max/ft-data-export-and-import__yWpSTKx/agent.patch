+        )
+        context.set_mapped_id(hash["id"], entropy.id)
+      else
+        # Board entropy: remap and insert
+        mapped = remap_hash(hash)
+        # Ensure container_id remapped
+        mapped["container_id"] = context.mapped_id(old_container_id) if old_container_id
+        mapped["container_type"] = container_type
+        Entropy.insert(mapped)
+      end
+    rescue => e
+      raise ImportError, "Failed to import Entropy: #{e.message}"
+    end
 end
