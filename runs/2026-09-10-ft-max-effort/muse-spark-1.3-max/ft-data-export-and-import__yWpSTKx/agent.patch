@@ -0,0 +1,37 @@
+<% @page_title = "Import account" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Import account</h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Bring an account file back in</h2>
+        <p>Upload a Fizzy account export (.zip) to create a new account with everything in it — boards, cards, comments, files, and people.</p>
+      </header>
+
+      <%= form_with model: @import, url: account_imports_path, method: :post, scope: :import, html: { multipart: true }, class: "flex flex-column gap" do |form| %>
+        <% if @import.errors.any? %>
+          <div class="txt-negative">
+            <ul class="list-unindented">
+              <% @import.errors.full_messages.each do |message| %>
+                <li><%= message %></li>
+              <% end %>
+            </ul>
+          </div>
+        <% end %>
+
+        <div>
+          <%= form.label :file, "Account export file (.zip)", class: "txt-small txt-bold" %>
+          <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input full-width" %>
+        </div>
+
+        <%= form.submit "Import account", class: "btn btn--primary center" %>
+      <% end %>
+
+      <p class="txt-small txt-tinted margin-block-start">You will receive an email when the import is done, or if it failed and why. An import that cannot be completed leaves nothing behind.</p>
+    </section>
+  </div>
+</div>
