--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,86 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :creator, class_name: "User"
+
+  has_one_attached :file, dependent: :purge_later
+
+  DOWNLOAD_EXPIRY = 24.hours
+
+  validates :export_type, presence: true, inclusion: { in: %w[account cards] }
+
+  def account_export?
+    export_type == "account"
+  end
+
+  def cards_export?
+    export_type == "cards"
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_in: DOWNLOAD_EXPIRY)
+  end
+
+  class << self
+    def find_by_download_token(token)
+      find_signed(token, purpose: :download)
+    rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveSupport::MessageEncryptor::InvalidMessage
+      nil
+    end
+  end
+
+  def perform_export!
+    filename = export_filename
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account_export?
+        Account::DataTransfer::Manifest.new(account).export_to(zip)
+      else
+        Account::DataTransfer::CardsExporter.new(account, creator).export_to(zip)
+      end
+    end
+
+    update!(status: "completed", error_message: nil)
+
+    Current.with_account(account) do
+      ExportMailer.export_ready(self).deliver_now
+    end
+  rescue => e
+    Rails.logger.error "Export #{id} failed: #{e.message}\n#{e.backtrace&.first(20)&.join("\n")}"
+    update!(status: "failed", error_message: e.message)
+    # Swallow to avoid job retry; failure is recorded on export
+  end
+
+  def accessible_to?(user)
+    return false unless user.present?
+    return true if user == creator
+    return true if account.users.where(id: user.id).exists? && user.admin?
+    false
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  private
+    def export_filename
+      base = account.name.parameterize.presence || "fizzy"
+      date = Date.current.iso8601
+      if account_export?
+        "#{base}-account-export-#{date}.zip"
+      else
+        "#{base}-cards-export-#{date}.zip"
+      end
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..1725eed
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,180 @@
+class Import < ApplicationRecord
+  class ImportError < StandardError; end
+
+  belongs_to :account, optional: true
+  belongs_to :identity
+  belongs_to :creator, class_name: "User", optional: true
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  def pending?
+    status == "pending"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def perform_import!
+    update!(status: "processing")
+
+    raise ImportError, "No file attached" unless file.attached?
+
+    new_account_id = nil
+    created_keys = []
+
+    begin
+      account_name = read_account_name
+
+      ActiveRecord::Base.transaction do
+        new_account = Account.create!(name: account_name)
+
+        ZipFile::Reader.open_blob(file.blob) do |reader|
+          context = Account::DataTransfer::Manifest.import_from(
+            reader, new_account: new_account, importer_identity: identity
+          )
+          created_keys = context.created_blob_keys.dup
+        end
+
+        # Ensure user settings for all non-system users (in case export missing)
+        ensure_user_settings(new_account)
+
+        new_account_id = new_account.id
+      end
+
+      update!(status: "completed", imported_account_id: new_account_id, error_message: nil)
+
+      new_account = Account.find(new_account_id)
+      Current.with_account(new_account) do
+        ImportMailer.completed(self).deliver_now
+      end
+    rescue Account::DataTransfer::RecordSet::ImportError => e
+      handle_failure(e.message, created_keys, new_account_id)
+      # Don't re-raise? Job should not retry for invalid file. So swallow and mark failed.
+    rescue Zip::Error, Zlib::Error, ActiveStorage::FileNotFoundError => e
+      handle_failure("Invalid import file: #{e.message}", created_keys, new_account_id)
+    rescue ImportError => e
+      handle_failure(e.message, created_keys, new_account_id)
+    rescue => e
+      Rails.logger.error "Import #{id} failed: #{e.message}\n#{e.backtrace&.first(30)&.join("\n")}"
+      handle_failure(e.message, created_keys, new_account_id)
+    end
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  def accessible_to?(user)
+    return false unless user.present?
+    return true if creator.present? && user == creator
+    return true if identity.present? && user.identity_id == identity.id
+    if account.present? && account.users.where(id: user.id).exists?
+      return true
+    end
+    false
+  end
+
+  private
+    def read_account_name
+      name = nil
+      ZipFile::Reader.open_blob(file.blob) do |reader|
+        manifest_json = reader.read("manifest.json") || reader.read("fizzy_export.json")
+        if manifest_json.present?
+          begin
+            manifest = JSON.parse(manifest_json)
+            if manifest["type"] == "cards"
+              raise ImportError, "This file contains a cards export, not a full account export. Please use an account export file."
+            end
+            name = manifest.dig("account", "name") if manifest["account"]
+          rescue JSON::ParserError
+            raise ImportError, "Invalid export file: corrupt manifest"
+          end
+        end
+
+        if name.blank?
+          # Fallback: read data/accounts.json
+          accounts_json = reader.read("data/accounts.json") || reader.read("accounts.json")
+          if accounts_json.present?
+            begin
+              accounts = JSON.parse(accounts_json)
+              accounts = [ accounts ] unless accounts.is_a?(Array)
+              name = accounts.first&.dig("name")
+            rescue JSON::ParserError
+              # ignore, will use default
+            end
+          end
+        end
+
+        if name.blank? && manifest_json.blank?
+          # Check if valid export at all
+          unless reader.exists?("data/accounts.json") || reader.exists?("accounts.json") || reader.exists?("cards.json")
+            raise ImportError, "Invalid import file: not a Fizzy export"
+          end
+        end
+      end
+
+      name.presence || "Imported account"
+    rescue Errno::ENOENT, Zip::Error => e
+      raise ImportError, "Invalid import file: not a valid ZIP (#{e.message})"
+    end
+
+    def ensure_user_settings(new_account)
+      new_account.users.where.not(role: "system").find_each do |user|
+        unless user.settings.present?
+          User::Settings.create!(account: new_account, user: user)
+        end
+      end
+    end
+
+    def handle_failure(message, created_keys, new_account_id)
+      # Cleanup any files uploaded for failed import (DB rolled back, but files remain on storage)
+      cleanup_blob_files(created_keys)
+
+      # Ensure no partial account left behind (transaction should have rolled back,
+      # but handle case where account was created outside transaction or commit partially succeeded)
+      if new_account_id.present?
+        if Account.exists?(id: new_account_id)
+          begin
+            Account.find(new_account_id).destroy!
+          rescue => e
+            Rails.logger.error "Failed to cleanup partial account #{new_account_id}: #{e.message}"
+          end
+        end
+      end
+
+      update!(status: "failed", error_message: message, imported_account_id: nil)
+
+      # Send failure email with reason; use source account context if present, else no account
+      if account.present?
+        Current.with_account(account) do
+          ImportMailer.failed(self).deliver_now
+        end
+      else
+        Current.without_account do
+          ImportMailer.failed(self).deliver_now
+        end
+      end
+    end
+
+    def cleanup_blob_files(keys)
+      return if keys.blank?
+      service = ActiveStorage::Blob.service
+      keys.each do |key|
+        begin
+          service.delete(key)
+        rescue => e
+          Rails.logger.warn "Failed to cleanup blob #{key}: #{e.message}"
+        end
+      end
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..de661ac
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,114 @@
+class ZipFile::Reader
+  def self.open_blob(blob)
+    raise ArgumentError, "No block given" unless block_given?
+
+    service = blob.service
+
+    if disk_service?(service)
+      open_disk_blob(blob, service) { |reader| yield reader }
+    else
+      open_remote_blob(blob) { |reader| yield reader }
+    end
+  end
+
+  def self.open_path(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    require "zip"
+    Zip::File.open(path) do |zip|
+      yield new(zip)
+    end
+  end
+
+  def self.open_file(file)
+    raise ArgumentError, "No block given" unless block_given?
+
+    if file.respond_to?(:path) && file.path.present? && File.exist?(file.path.to_s)
+      open_path(file.path) { |reader| yield reader }
+    else
+      require "zip"
+      # Fallback: read via ZipKit or buffer to tempfile
+      tempfile = Tempfile.new([ "import", ".zip" ])
+      tempfile.binmode
+      IO.copy_stream(file, tempfile)
+      tempfile.rewind
+      begin
+        Zip::File.open(tempfile.path) do |zip|
+          yield new(zip)
+        end
+      ensure
+        tempfile.close
+        tempfile.unlink
+      end
+    end
+  end
+
+  def initialize(zip)
+    @zip = zip
+  end
+
+  def read(path)
+    entry = @zip.find_entry(path)
+    return nil unless entry
+    entry.get_input_stream(&:read)
+  rescue Errno::ENOENT
+    nil
+  end
+
+  def exists?(path)
+    @zip.find_entry(path).present?
+  end
+
+  def glob(pattern)
+    @zip.glob(pattern).map(&:name).sort
+  end
+
+  def entries
+    @zip.entries.map(&:name).sort
+  end
+
+  def stream(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    entry = @zip.find_entry(path)
+    raise Errno::ENOENT, path unless entry
+
+    entry.get_input_stream do |io|
+      while (chunk = io.read(5.megabytes))
+        yield chunk
+      end
+    end
+  end
+
+  def open_stream(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    entry = @zip.find_entry(path)
+    raise Errno::ENOENT, path unless entry
+
+    entry.get_input_stream do |io|
+      yield io
+    end
+  end
+
+  class << self
+    private
+      def disk_service?(service)
+        defined?(ActiveStorage::Service::DiskService) && service.is_a?(ActiveStorage::Service::DiskService)
+      end
+
+      def open_disk_blob(blob, service)
+        path = service.path_for(blob.key)
+        open_path(path) { |reader| yield reader }
+      rescue Errno::ENOENT, ActiveStorage::FileNotFoundError
+        # Fallback to blob.open (handles edge cases like missing file)
+        open_remote_blob(blob) { |reader| yield reader }
+      end
+
+      def open_remote_blob(blob)
+        blob.open do |file|
+          open_path(file.path) { |reader| yield reader }
+        end
+      end
+  end
+end
diff --git a/app/views/account/imports/new.html.erb b/app/views/account/imports/new.html.erb
