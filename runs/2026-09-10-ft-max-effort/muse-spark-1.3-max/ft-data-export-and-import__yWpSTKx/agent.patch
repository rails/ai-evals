@@ -1,4 +1,6 @@
 class Account::DataTransfer::Manifest
+  VERSION = 1
+
   attr_reader :account
 
   def initialize(account)
@@ -13,6 +15,236 @@ class Account::DataTransfer::Manifest
     end
   end
 
+  def export_to(zip)
+    # Write manifest metadata first
+    zip.add_file("manifest.json", JSON.pretty_generate(export_manifest_hash))
+    zip.add_file("fizzy_export.json", JSON.pretty_generate(export_manifest_hash))
+
+    each_record_set do |record_set|
+      record_set.export_to(zip)
+    end
+
+    # Also include human-readable cards export for spec compliance
+    export_cards_json(zip)
+  end
+  alias_method :export, :export_to
+
+  def self.import_from(reader, new_account:, importer_identity: nil)
+    context = Account::DataTransfer::ImportContext.new(new_account: new_account, importer_identity: importer_identity)
+
+    # Validate manifest
+    manifest_json = reader.read("manifest.json") || reader.read("fizzy_export.json")
+    if manifest_json.present?
+      begin
+        manifest = JSON.parse(manifest_json)
+        unless %w[account].include?(manifest["type"])
+          # Allow cards-only exports? For account import, require account type.
+          # But be lenient: if type is cards, raise with clear message.
+          if manifest["type"] == "cards"
+            raise Account::DataTransfer::RecordSet::ImportError, "This file contains a cards export, not a full account export. Please use an account export file."
+          end
+        end
+      rescue JSON::ParserError
+        # Lenient: continue if manifest invalid? But import should fail clearly.
+        raise Account::DataTransfer::RecordSet::ImportError, "Invalid export file: corrupt manifest"
+      end
+    else
+      # No manifest: check for data/accounts.json to determine if account export
+      unless reader.exists?("data/accounts.json") || reader.exists?("accounts.json")
+        raise Account::DataTransfer::RecordSet::ImportError, "Invalid import file: not a Fizzy account export"
+      end
+    end
+
+    # Import in manifest order (dependencies first)
+    # We need a dummy account for record set initialization (uses account for export scope, but import uses context)
+    dummy_manifest = new(new_account)
+    dummy_manifest.each_record_set do |record_set|
+      # Re-initialize record set with new_account? Actually import doesn't use account, only context.
+      # But record_set's model and attributes are what matter.
+      record_set.import_from(reader, context)
+    end
+
+    # Post-import fixes
+    fix_rich_text_bodies(context)
+    ensure_importer_access(context)
+    fix_cards_count(context)
+
+    context
+  end
+
+  class << self
+    private
+      def fix_rich_text_bodies(context)
+        return if context.rich_text_ids.empty?
+        id_map = context.id_map
+        return if id_map.empty?
+        new_account = context.new_account
+
+        ::ActionText::RichText.where(id: context.rich_text_ids).find_each do |rt|
+          body = rt.read_attribute_before_type_cast(:body).to_s
+          next if body.blank?
+
+          new_body = fix_rich_text_body(body, context, new_account)
+          # Also handle plain UUID occurrences (for non-SGID references)
+          id_map.each do |old_id, new_id|
+            if new_body.include?(old_id)
+              new_body = new_body.gsub(old_id, new_id)
+            end
+          end
+
+          if new_body != body
+            ::ActionText::RichText.where(id: rt.id).update_all(body: new_body)
+          end
+        end
+      rescue => e
+        Rails.logger.warn "Failed to fix rich text bodies: #{e.message}\n#{e.backtrace&.first(5)&.join("\n")}"
+      end
+
+      def fix_rich_text_body(html, context, new_account)
+        doc = Nokogiri::HTML.fragment(html)
+        changed = false
+
+        doc.css("action-text-attachment").each do |node|
+          sgid = node["sgid"]
+          next if sgid.blank?
+
+          begin
+            old_id = extract_id_from_sgid(sgid)
+            next if old_id.nil?
+
+            new_id = context.id_map[old_id.to_s]
+            next if new_id.nil?
+
+            # Determine attachable type from SGID (Blob vs User)
+            attachable_type = extract_type_from_sgid(sgid)
+            new_attachable = find_new_attachable(attachable_type, new_id, new_account)
+            next if new_attachable.nil?
+
+            new_sgid = new_attachable.attachable_sgid.to_s
+            if new_sgid != sgid
+              node["sgid"] = new_sgid
+              changed = true
+            end
+
+            # Update URL for blobs to point to new blob with new account slug
+            if new_attachable.is_a?(ActiveStorage::Blob)
+              begin
+                new_url = Rails.application.routes.url_helpers.polymorphic_url(new_attachable, only_path: true, script_name: new_account.slug)
+                if node["url"] != new_url
+                  node["url"] = new_url
+                  changed = true
+                end
+              rescue => e
+                Rails.logger.warn "Failed to update attachment URL: #{e.message}"
+              end
+            end
+          rescue => e
+            Rails.logger.warn "Failed to fix attachment SGID: #{e.message}"
+            next
+          end
+        end
+
+        changed ? doc.to_html : html
+      end
+
+      def extract_id_from_sgid(sgid)
+        # Try verified parse first (same instance, same secret)
+        begin
+          parsed = SignedGlobalID.parse(sgid, for: ActionText::Attachable::LOCATOR_NAME)
+          return parsed.model_id.to_s if parsed
+        rescue => e
+          # Fall through to unverified decode (cross-instance, different secret)
+        end
+
+        # Unverified: decode Base64 payload without checking signature
+        begin
+          payload = sgid.to_s.split("--").first
+          json = Base64.urlsafe_decode64(payload) rescue Base64.decode64(payload)
+          data = JSON.parse(json)
+          gid = data["data"] || data.to_s
+          # gid like "gid://fizzy/ActiveStorage::Blob/old_id" or with params
+          if gid =~ %r{gid://[^/]+/[^/]+/([^/?]+)}
+            return Regexp.last_match(1)
+          end
+        rescue => e
+          nil
+        end
+        nil
+      end
+
+      def extract_type_from_sgid(sgid)
+        begin
+          parsed = SignedGlobalID.parse(sgid, for: ActionText::Attachable::LOCATOR_NAME)
+          return parsed.model_class.name if parsed&.model_class
+        rescue
+        end
+
+        begin
+          payload = sgid.to_s.split("--").first
+          json = Base64.urlsafe_decode64(payload) rescue Base64.decode64(payload)
