--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,39 @@
+class Account::DataTransfer::ImportContext
+  attr_reader :new_account, :id_map, :identity_map, :importer_identity, :created_blob_keys, :rich_text_ids
+
+  def initialize(new_account:, importer_identity: nil)
+    @new_account = new_account
+    @importer_identity = importer_identity
+    @id_map = {}
+    @identity_map = {}
+    @created_blob_keys = []
+    @rich_text_ids = []
+  end
+
+  def mapped_id(old_id)
+    return nil if old_id.nil?
+    old_str = old_id.to_s
+    return new_account.id if old_str == old_account_id.to_s && old_account_id.present?
+    id_map[old_str] ||= ActiveRecord::Type::Uuid.generate
+  end
+
+  def set_mapped_id(old_id, new_id)
+    id_map[old_id.to_s] = new_id.to_s
+  end
+
+  def old_account_id
+    @old_account_id
+  end
+
+  def old_account_id=(value)
+    @old_account_id = value&.to_s
+  end
+
+  def track_blob_key(key)
+    created_blob_keys << key
+  end
+
+  def track_rich_text(id)
+    rich_text_ids << id
+  end
+end
diff --git a/app/models/account/data_transfer/manifest.rb b/app/models/account/data_transfer/manifest.rb
