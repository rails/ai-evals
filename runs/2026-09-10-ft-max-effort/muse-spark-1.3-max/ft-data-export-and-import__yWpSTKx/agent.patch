       ::ActionText::RichText.where(account: account)
     end
 
+    def remap_hash(hash)
+      context = import_context
+      new_account = context.new_account
+      mapped = super
+      # super already remaps id, account_id, and record_id via generic _id handling?
+      # But record_id is polymorphic with record_type; generic handling already remaps record_id.
+      # Ensure account_id set.
+      mapped["account_id"] = new_account.id
+      mapped
+    end
+
+    def bulk_insert(remapped_hashes)
+      super
+      # Track rich text ids for post-import SGID fixing
+      remapped_hashes.each do |mapped|
+        import_context.track_rich_text(mapped["id"])
+      end
+    end
 end
diff --git a/app/models/account/data_transfer/active_storage/attachment_record_set.rb b/app/models/account/data_transfer/active_storage/attachment_record_set.rb
index 0c87c10..35b327e 100644
--- a/app/models/account/data_transfer/active_storage/attachment_record_set.rb
+++ b/app/models/account/data_transfer/active_storage/attachment_record_set.rb
@@ -8,4 +8,31 @@ class Account::DataTransfer::ActiveStorage::AttachmentRecordSet < Account::DataT
       ::ActiveStorage::Attachment.where(account: account)
         .where.not(record_type: INTERNAL_RECORD_TYPES)
     end
+
+    def remap_hash(hash)
+      context = import_context
+      new_account = context.new_account
+      mapped = {}
+
+      hash.each do |key, value|
+        key = key.to_s
+        if key == "id"
+          mapped[key] = context.mapped_id(value)
+        elsif key == "account_id"
+          mapped[key] = new_account.id
+        elsif key == "blob_id"
+          mapped[key] = context.mapped_id(value)
+        elsif key == "record_id" && value.is_a?(String) && uuid_like?(value)
+          # Polymorphic record_id: remap via id map (handles Card, Comment, User, RichText, etc.)
+          # For record types that are not imported (e.g., Export), this will generate a new id
+          # but those attachments are excluded from export, so fine.
+          mapped[key] = context.mapped_id(value)
+        else
+          mapped[key] = value
+        end
+      end
+
+      mapped["account_id"] = new_account.id
+      mapped
+    end
 end
diff --git a/app/models/account/data_transfer/active_storage/blob_record_set.rb b/app/models/account/data_transfer/active_storage/blob_record_set.rb
