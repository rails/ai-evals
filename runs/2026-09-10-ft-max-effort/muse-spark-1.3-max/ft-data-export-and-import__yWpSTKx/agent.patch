+++ b/app/mailers/import_mailer.rb
@@ -0,0 +1,38 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.imported_account
+    @identity = import.identity
+
+    Current.with_account(@account) do
+      @account_url = root_url(script_name: @account.slug)
+      mail(
+        to: @identity.email_address,
+        subject: "Your import is complete"
+      )
+    end
+  end
+
+  def failed(import)
+    @import = import
+    @identity = import.identity
+    @error_message = import.error_message
+    @account = import.account || import.imported_account
+
+    if @account.present?
+      Current.with_account(@account) do
+        mail(
+          to: @identity.email_address,
+          subject: "Your import failed"
+        )
+      end
+    else
+      Current.without_account do
+        mail(
+          to: @identity.email_address,
+          subject: "Your import failed"
+        )
+      end
+    end
+  end
+end
