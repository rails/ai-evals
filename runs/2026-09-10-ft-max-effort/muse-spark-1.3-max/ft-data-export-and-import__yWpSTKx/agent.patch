   def initialize(account)
     super(account: account, model: Entropy)
   end
+
+  private
+    def import_records
+      json = read_export_json
+      return if json.nil?
+      hashes = parse_json_array(json)
+      return if hashes.empty?
+
+      hashes.each do |hash|
+        import_entropy_hash(hash)
+      end
+    end
+
+    def import_entropy_hash(hash)
+      context = import_context
+      new_account = context.new_account
+
+      container_type = hash["container_type"]
+      old_container_id = hash["container_id"]
+
+      if container_type == "Account"
+        # New account already has entropy via after_create; update it
+        entropy = new_account.entropy || new_account.build_entropy
