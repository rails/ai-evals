+# Fizzy single-box secrets — safe for git (no raw credentials here).
+#
+# Kamal reads this file with dotenv and substitutes $VARS from your local
+# environment (or `$(command)` output). Fill in the TODOs in config/deploy.yml,
+# export the variables below in your shell, then run `bin/kamal setup`.
+#
+# Generate values once and keep them stable across deploys (rotating
+# SECRET_KEY_BASE signs everyone out; rotating VAPID keys breaks push):
+#
+#   # Rails session/encryption secret (required):
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#
+#   # Registry password (required): Docker Hub access token or GHCR token.
+#   export KAMAL_REGISTRY_PASSWORD=your-registry-token
+#
+#   # SMTP credentials for the mail server in config/deploy.yml (required for
+#   # magic-link logins). If your relay needs no auth, export empty strings and
+#   # the app will skip authentication (see config/environments/production.rb).
+#   export SMTP_USERNAME=your-smtp-username
+#   export SMTP_PASSWORD=your-smtp-password
+#
+#   # Web Push (VAPID) keys for browser notifications (recommended).
+#   # Generate with: bin/rails runner 'k=WebPush.generate_key; puts k.private_key; puts k.public_key'
+#   export VAPID_PRIVATE_KEY=your-vapid-private-key
+#   export VAPID_PUBLIC_KEY=your-vapid-public-key
+#
+# Alternative: pull from a password manager instead of exporting, e.g.
+#   SECRET_KEY_BASE=$(op read "op://vault/fizzy/SECRET_KEY_BASE")
+# See https://kamal-deploy.org/docs/configuration/secrets
+#
+# DO NOT ENTER RAW CREDENTIALS HERE. This file is committed to git.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
