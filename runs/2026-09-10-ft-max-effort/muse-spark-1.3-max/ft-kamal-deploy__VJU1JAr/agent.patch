new file mode 100644
index 0000000..f1ce2c8
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,118 @@
+# Fizzy — single-box Kamal config (SQLite, one container, proxy SSL).
+#
+# This deploys the open-source Fizzy to one Linux server with Docker:
+#   - SQLite databases and Active Storage files live in /rails/storage,
+#     persisted in the `fizzy_storage` Docker volume across deploys.
+#   - Web + background jobs run in the same container (Solid Queue in Puma).
+#   - kamal-proxy terminates SSL with an automatic Let's Encrypt certificate.
+#
+# Fork setup (5 minutes):
+#   1. Point your domain at your server (A record) and make sure ports 80/443 are open.
+#   2. Fill in the TODOs below: servers, proxy host, image/registry, APP_HOST and SMTP.
+#   3. Fill in secrets — see .kamal/secrets for how to generate/export them:
+#        SECRET_KEY_BASE, KAMAL_REGISTRY_PASSWORD, SMTP_USERNAME, SMTP_PASSWORD,
+#        VAPID_PRIVATE_KEY, VAPID_PUBLIC_KEY
+#   4. Run `bin/kamal setup` from your laptop, then visit https://your-host.
+#      Later deploys: `bin/kamal deploy`.
+#
+# Full guide: docs/self-hosting.md
+
+service: fizzy
+
+# Docker image for your fork. Use Docker Hub (`username/fizzy`) or GHCR
+# (`ghcr.io/username/fizzy` — then set registry.server to ghcr.io below).
+# TODO: replace with your repository.
+image: your-docker-username/fizzy
+
+# One box. Put your server's IP or hostname here (SSH accessible, Docker will
+# be installed by `kamal setup` if missing). Keep exactly one host: proxy SSL
+# via Let's Encrypt only works with a single server.
+servers:
+  web:
+    # TODO: your server, e.g. 192.0.2.10 or fizzy.example.com
+    - 192.0.2.10
+
+# kamal-proxy: gapless deploys + automatic HTTPS.
+proxy:
+  ssl: true
+  # TODO: your domain, must resolve to the server above for the ACME challenge.
+  host: fizzy.example.com
+  # The app container listens on 80 via Thruster (see Dockerfile CMD).
+  # Defaults are fine; uncomment to be explicit:
+  # app_port: 80
+  # Healthcheck defaults to GET /up; Rails provides it out of the box.
+  # healthcheck:
+  #   path: /up
+  #   interval: 3
+  #   timeout: 3
+
+# Where built images are pushed. Kamal needs a registry even for one box.
+registry:
+  # For Docker Hub, omit `server` (defaults to Docker Hub).
+  # For GHCR, uncomment the next line:
+  # server: ghcr.io
+  # TODO: your registry username (Docker Hub username or GitHub username).
+  username: your-docker-username
+  # Password is read from .kamal/secrets — never commit raw credentials.
+  # Use a Docker Hub access token or a GHCR token (classic PAT with write:packages).
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Environment injected into the container. Secrets (secret:) come from
+# .kamal/secrets; the rest (clear:) are committed here.
+env:
+  clear:
+    RAILS_ENV: production
+    # Everything in one container: run Solid Queue workers inside Puma so
+    # background jobs (mailers, notifications, recurring tasks) run on the box.
+    SOLID_QUEUE_IN_PUMA: true
+    # Canonical host for links in emails and URLs generated by jobs.
+    # TODO: same value as proxy.host above, without protocol.
+    APP_HOST: fizzy.example.com
+    # Address shown in the From header. Override per deploy if you like.
+    # TODO: use an address on your domain.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    # Outbound mail server. Fizzy logs users in with email magic links, so
+    # SMTP must work for a usable install. See docs/self-hosting.md for examples
+    # (Postmark, Amazon SES, plain Postfix, etc.).
+    # TODO: your SMTP server.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # HELO domain; defaults to APP_HOST when omitted in production.rb, but be explicit.
+    # TODO: your domain.
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    # Uncomment if your provider needs implicit TLS on port 465 instead of STARTTLS:
+    # SMTP_TLS: true
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+
+# Persist SQLite (*.sqlite3) + Active Storage files across deploys.
+# Without this volume, the next deploy would start with an empty database.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Share fingerprinted assets between old/new containers to avoid 404s on
+# in-flight requests during a deploy.
+asset_path: /rails/public/assets
+
+# Build the image for your server's architecture. Most VPSes are amd64;
+# if your box is arm64 (e.g. Ampere/Hetzner ARM), change to arm64.
+builder:
+  arch: amd64
+
+# Uncomment if you SSH as a non-root user (that user must be in the docker group):
+# ssh:
+#   user: app
+
+# Shortcuts: `bin/kamal console`, `bin/kamal shell`, `bin/kamal logs`, ...
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..0530f00 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,36 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Self-hosted single-box (Kamal): canonical host for URLs in emails and jobs.
+  # Set APP_HOST to your domain (same as proxy.host in config/deploy.yml; APP_FQDN also works).
+  # Left blank when fizzy-saas already set an explicit host.
+  app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence
+  if app_host
+    if config.action_mailer.default_url_options.blank?
+      config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+    end
+    if config.action_controller.default_url_options.blank?
+      config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    end
+  end
+
+  # Self-hosted single-box (Kamal): outbound SMTP via env vars (see config/deploy.yml).
+  # Only configured when SMTP_ADDRESS is set; otherwise Action Mailer keeps its defaults.
+  # Left blank when fizzy-saas already set explicit smtp_settings.
+  if ENV["SMTP_ADDRESS"].present? && config.action_mailer.smtp_settings.blank?
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV["SMTP_DOMAIN"].presence || app_host,
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV["SMTP_USERNAME"].present? ? ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym : nil,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true",
+      tls: ENV["SMTP_TLS"] == "true" ? true : nil
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/self-hosting.md b/docs/self-hosting.md
new file mode 100644
index 0000000..8a7c078
--- /dev/null
+++ b/docs/self-hosting.md
@@ -0,0 +1,123 @@
+## Self-hosting Fizzy with Kamal (single box)
+
+Deploy your fork to one Linux server with Docker, SQLite, and automatic HTTPS.
+Everything runs in a single container (web + Solid Queue jobs in Puma); data
+persists in a Docker volume across deploys.
+
+### What you get
+
+- Fizzy at `https://your-host`
+- SQLite databases + Active Storage files in the `fizzy_storage` volume (`/rails/storage`)
+- Background jobs on the box (Solid Queue in Puma, no separate worker container)
+- SSL from kamal-proxy (Let's Encrypt, auto-renewed)
+
+### Prerequisites
+
+- A Linux server (1 vCPU / 2 GB RAM minimum) with SSH access and ports 80/443 open.
+  Kamal will install Docker if it is missing.
+- A domain pointing at the server (A record). The proxy needs it for the ACME challenge.
+- An SMTP server for outbound mail. Fizzy logs users in with email magic links,
+  so SMTP must work for a usable install.
+- A container registry: Docker Hub or GHCR. Kamal needs it even for one box.
+
+### 1. Fork and configure
+
+Fork the repo, then edit `config/deploy.yml` (every value to change is marked `TODO`):
+
+- `servers.web`: your server IP or hostname (keep exactly one host).
+- `proxy.host`: your domain (must resolve to the server).
+- `image` + `registry.username`: your Docker Hub (`username/fizzy`) or GHCR
+  (`ghcr.io/username/fizzy` with `registry.server: ghcr.io`) repository.
+- `env.clear.APP_HOST`: same as `proxy.host` (used for links in emails).
+- `env.clear.MAILER_FROM_ADDRESS`: e.g. `Fizzy <fizzy@yourdomain.com>`.
+- `env.clear.SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_DOMAIN`, `SMTP_AUTHENTICATION`,
+  `SMTP_ENABLE_STARTTLS_AUTO`: your mail server. Examples:
+  - Postmark: `smtp.postmarkapp.com:587`, auth `plain`, STARTTLS on.
+  - Amazon SES: `email-smtp.us-east-1.amazonaws.com:587`, auth `plain`, STARTTLS on.
+  - Plain Postfix relay without auth: set address/port, export empty
+    `SMTP_USERNAME`/`SMTP_PASSWORD` (the app then skips authentication).
+  - Port 465 implicit TLS: set `SMTP_TLS: true` and STARTTLS off.
+
+If your box is arm64 instead of amd64, set `builder.arch: arm64`.
+
+### 2. Secrets
+
+`.kamal/secrets` is committed as a template (no raw values). Export real values
+in your shell before running Kamal — see the comments in that file:
+
+```sh
+export SECRET_KEY_BASE=$(bin/rails secret)
+export KAMAL_REGISTRY_PASSWORD=your-registry-token
+export SMTP_USERNAME=your-smtp-username
+export SMTP_PASSWORD=your-smtp-password
+export VAPID_PRIVATE_KEY=your-vapid-private-key
+export VAPID_PUBLIC_KEY=your-vapid-public-key
+```
+
+- `SECRET_KEY_BASE`: `bin/rails secret`. Keep it stable — rotating signs everyone out.
+- `KAMAL_REGISTRY_PASSWORD`: Docker Hub access token or GHCR token (`write:packages`).
+- `VAPID_*`: for browser push notifications. Generate with:
+  `bin/rails runner 'k=WebPush.generate_key; puts k.private_key; puts k.public_key'`.
+  Keep them stable once set. If you skip push, you can remove the two lines from
+  both `config/deploy.yml` and `.kamal/secrets`.
+
+Alternatively, point each line in `.kamal/secrets` at your password manager,
+e.g. `SECRET_KEY_BASE=$(op read "op://vault/fizzy/SECRET_KEY_BASE")`.
+Never commit raw credentials.
+
+### 3. Deploy
+
+From your laptop (or wherever you have SSH + Docker):
+
+```sh
+bin/kamal setup   # first time: boots proxy, pushes env, deploys
+```
+
+Then visit `https://your-host`. Later updates:
+
+```sh
+bin/kamal deploy  # zero-downtime redeploy; data stays in fizzy_storage
+```
+
+Useful commands (see `aliases` in `config/deploy.yml`):
+
+```sh
+bin/kamal console # Rails console on the box
+bin/kamal shell   # bash in the app container
+bin/kamal logs    # tail app logs
+bin/kamal proxy logs # proxy logs (SSL/ACME issues show up here)
+```
+
+### How persistence works
+
+- `volumes: ["fizzy_storage:/rails/storage"]` mounts a named Docker volume over
+  `/rails/storage`, which holds `storage/*.sqlite3` (primary, cable, cache,
+  queue) and `storage/production/files` (Active Storage). Kamal re-attaches the
+  same volume on every deploy, so the next deploy keeps your data.
+- Entrypoint runs `db:prepare` on boot, creating/migrating SQLite files as needed.
+- To inspect the volume: `bin/kamal shell` then `ls -lh storage/`.
+
+### How jobs work
+
+`SOLID_QUEUE_IN_PUMA=true` (set in `config/deploy.yml`) runs Solid Queue
+workers inside the Puma process (`config/puma.rb` plugin), so mailers,
+notifications, webhooks, and `config/recurring.yml` tasks all run on the box
+with no extra container. For a single SQLite box this is simpler and safer than
+a separate `bin/jobs` container sharing the same SQLite files.
+
+### Troubleshooting
+
+- `bin/kamal config` validates your YAML + secrets without touching servers.
+- SSL stuck at “challenge failed”: DNS must resolve `proxy.host` to the server
+  and port 80 must be reachable. Check `bin/kamal proxy logs`.
+- No login emails: check `bin/kamal logs`, verify `SMTP_*` and that your
+  provider allows the From domain (SPF/DKIM). `SMTP_USERNAME` empty disables auth.
+- Healthcheck failing: the proxy hits `GET /up` on port 80 (Thruster → Puma).
+  Check `bin/kamal app logs` for boot errors (often a missing/empty `SECRET_KEY_BASE`).
+
+### Notes
+
+- This config is for the open-source app (`Fizzy.saas? == false`). 37signals’
+  hosted deployment lives in `saas/config/deploy*.yml` and is not for forks.
+- `bin/kamal` automatically uses `config/deploy.yml` in OSS mode; in SaaS mode
+  (`tmp/saas.txt` present) it switches to the SaaS config.
