diff --git a/app/views/join_codes/codes/new.html.erb b/app/views/join_codes/codes/new.html.erb
new file mode 100644
index 0000000..3e43510
--- /dev/null
+++ b/app/views/join_codes/codes/new.html.erb
@@ -0,0 +1,34 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @email_address.present? %>
+    <p>We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to join <%= @join_code.account.name %>.</p>
+  <% else %>
+    <p>Enter the six-character code we sent to your email to join <%= @join_code.account.name %>.</p>
+  <% end %>
+
+  <%= form_with url: join_code_path(join_code: @join_code.code), class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <% if @email_address.present? %>
+      <%= form.hidden_field :email_address, value: @email_address %>
+    <% end %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your code…", maxlength: 6, minlength: 6 %>
+      </label>
+    </div>
+
+    <p>This code works for 15 minutes.</p>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Join</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
