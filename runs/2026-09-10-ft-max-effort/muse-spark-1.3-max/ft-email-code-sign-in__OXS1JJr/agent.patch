@@ -0,0 +1,86 @@
+class JoinCodes::CodesController < ApplicationController
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @email_address = session[:join_email_address].presence || params[:email_address].presence
+
+    if @email_address.blank?
+      redirect_to join_path(code: @join_code.code)
+    end
+  end
+
+  def create
+    email_address = params[:email_address].presence || session[:join_email_address].presence
+    code = params[:code].presence
+
+    # Note: params[:join_code] is the account join code from the path,
+    # params[:code] is the email verification code from the form.
+    code ||= params.dig(:verification, :code).presence || params.dig(:signup, :code).presence || params.dig(:session, :code).presence
+
+    email_code = find_valid_code(email_address, code)
+
+    if email_code
+      email_code.use!
+      identity = Identity.find_or_create_by!(email_address: email_code.email_address)
+
+      if Current.identity != identity
+        start_new_session_for identity
+      end
+      session.delete(:join_email_address)
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json do
+          if user.setup?
+            render json: { session_token: session_token }
+          else
+            render json: { session_token: session_token }, status: :created
+          end
+        end
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_join_code_path(join_code: @join_code.code, email_address: email_address), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def find_valid_code(email_address, code)
+      return nil if code.blank?
+
+      if email_address.present?
+        EmailCode.verify(email_address, code) || EmailCode.verify_code_only(code)
+      else
+        EmailCode.verify_code_only(code)
+      end
+    end
+
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: params[:join_code], account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+end
