+class Signups::CodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_signup_code_path, alert: "Try again later." }
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def new
+    @email_address = session[:signup_code_email_address].presence || params[:email_address].presence
+
+    if @email_address.blank?
+      redirect_to new_signup_path
+    end
+  end
+
+  def create
+    email_address = params[:email_address].presence || params.dig(:signup, :email_address).presence || session[:signup_code_email_address].presence
+    code = params[:code].presence || params.dig(:signup, :code).presence
+
+    email_code = find_valid_code(email_address, code)
+
+    if email_code
+      email_code.use!
+      signup = Signup.new(email_address: email_code.email_address)
+      signup.create_identity
+      start_new_session_for signup.identity
+      session.delete(:signup_code_email_address)
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_signup_code_path(email_address: email_address), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def find_valid_code(email_address, code)
+      return nil if code.blank?
+
+      if email_address.present?
+        EmailCode.verify(email_address, code) || EmailCode.verify_code_only(code)
+      else
+        EmailCode.verify_code_only(code)
+      end
+    end
+
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+end
