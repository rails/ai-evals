index 0000000..6d0d9f0
--- /dev/null
+++ b/app/mailers/identity_mailer.rb
@@ -0,0 +1,14 @@
+class IdentityMailer < ApplicationMailer
+  def verification_code(email_code)
+    @email_code = email_code
+    @code = email_code.code
+
+    mail to: email_code.email_address, subject: "Your Fizzy sign-in code is #{@code}"
+  end
+
+  # Aliases so different flows can use purpose-specific names while sharing the same email.
+  alias_method :sign_in_code, :verification_code
+  alias_method :email_code, :verification_code
+  alias_method :sign_up_code, :verification_code
+  alias_method :join_code, :verification_code
+end
diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..cbd3bae
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,69 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRY = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+  validates :expires_at, presence: true
+
+  before_validation :generate_code, :set_expires_at, on: :create
+
+  scope :valid, -> { where(used_at: nil).where("expires_at > ?", Time.current) }
+
+  class << self
+    def generate_for(email_address)
+      normalized = email_address.to_s.strip.downcase
+      # Invalidate previous codes for this email so only the latest works.
+      where(email_address: normalized, used_at: nil).delete_all
+      create!(email_address: normalized)
+    end
+
+    def verify(email_address, code)
+      normalized_email = email_address.to_s.strip.downcase
+      normalized_code = code.to_s.strip.upcase
+
+      return nil if normalized_email.blank? || normalized_code.blank?
+
+      valid.find_by(email_address: normalized_email, code: normalized_code)
+    end
+
+    def verify_code_only(code)
+      normalized_code = code.to_s.strip.upcase
+      return nil if normalized_code.blank?
+
+      valid.where(code: normalized_code).order(created_at: :desc).first
+    end
+
+    def cleanup_expired
+      where("expires_at <= ?", Time.current).delete_all
+    end
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def used?
+    used_at.present?
+  end
+
+  def valid_code?
+    !expired? && !used?
+  end
+
+  def use!
+    update!(used_at: Time.current)
+  end
+
+  private
+    def generate_code
+      self.code ||= SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def set_expires_at
+      self.expires_at ||= EXPIRY.from_now
+    end
+end
