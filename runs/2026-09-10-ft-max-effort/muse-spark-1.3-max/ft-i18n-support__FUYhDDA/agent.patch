diff --git a/test/locale_check_test.rb b/test/locale_check_test.rb
new file mode 100644
index 0000000..267f5b9
--- /dev/null
+++ b/test/locale_check_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+class LocaleCheckTest < ActionDispatch::IntegrationTest
+  test "check remaining english" do
+    user = users(:david)
+    sign_in_as user
+    board = boards(:writebook)
+    paths = [
+      root_path,
+      board_path(board),
+      notifications_path,
+      account_settings_path,
+      new_board_path,
+    ]
+    paths.each do |path|
+      get "#{path}?locale=ja"
+      assert_response :success, "Failed for #{path}: #{response.status}"
+      body = response.body
+      doc = Nokogiri::HTML5.parse(body)
+      english = []
+      doc.traverse do |node|
+        if node.text?
+          parent = node.parent
+          next if parent && %w[script style].include?(parent.name)
+          t = node.text.strip
+          next if t.empty?
+          if t.match?(/[A-Za-z]{3,}/)
+            english << t[0,150]
+          end
+        end
+      end
+      puts "=== #{path} (#{english.size} english nodes) ==="
+      puts english.first(50).join("\n---\n")
+      puts ""
+      # Also check attributes with English
+      attrs = []
+      doc.traverse do |node|
+        if node.element?
+          node.attributes.each do |name, attr|
+            v = attr.value
+            next unless v && v.match?(/[A-Za-z]{3,}/)
+            # Skip code-like attributes? For now, list all with English
+            # Filter to UI-like attributes: placeholder, title, aria-label, alt, data-bridge-title, etc.
+            if %w[placeholder title alt aria-label].include?(name) || name.include?("bridge-title") || name.include?("validation")
+              attrs << "#{name}=#{v[0,120]}"
+            end
+          end
+        end
+      end
+      puts "ATTRS (#{attrs.size}):"
+      puts attrs.first(30).join("\n---\n")
+      puts "\n"
+    end
+  end
+end
