diff --git a/app/mailers/application_mailer.rb b/app/mailers/application_mailer.rb
index 9f0d723..7611cbd 100644
--- a/app/mailers/application_mailer.rb
+++ b/app/mailers/application_mailer.rb
@@ -6,6 +6,49 @@ class ApplicationMailer < ActionMailer::Base
   helper AvatarsHelper, HtmlHelper
 
   private
+    def with_locale_for(recipient, &block)
+      I18n.with_locale(locale_for(recipient), &block)
+    end
+
+    def locale_for(recipient)
+      case recipient
+      when Identity then recipient.preferred_locale_sym
+      when User then recipient.preferred_locale_sym
+      else I18n.default_locale
+      end
+    rescue
+      I18n.default_locale
+    end
+
+    def mail(*args, &block)
+      message = super
+      if I18n.locale.to_s == "ja"
+        translate_mail_to_japanese(message)
+      end
+      message
+    end
+
+    def translate_mail_to_japanese(message)
+      if message.html_part
+        html = message.html_part.body.decoded
+        translated = JapaneseTranslation.translate_html(html)
+        message.html_part.body = translated
+      end
+      if message.text_part
+        text = message.text_part.body.decoded
+        translated = JapaneseTranslation.translate_text(text)
+        message.text_part.body = translated
+      elsif message.body && message.content_type.to_s.include?("text/plain")
+        text = message.body.decoded
+        message.body = JapaneseTranslation.translate_text(text)
+      elsif message.body && message.content_type.to_s.include?("text/html")
+        html = message.body.decoded
+        message.body = JapaneseTranslation.translate_html(html)
+      end
+    rescue => ex
+      Rails.logger.error("translate_mail failed")
+    end
+
     def default_url_options
       if Current.account
         super.merge(script_name: Current.account.slug)
