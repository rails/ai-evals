diff --git a/lib/japanese_translation.rb b/lib/japanese_translation.rb
new file mode 100644
index 0000000..e49104d
--- /dev/null
+++ b/lib/japanese_translation.rb
@@ -0,0 +1,87 @@
+require_relative "japanese_translation/exact_part1"
+require_relative "japanese_translation/exact_part2"
+require_relative "japanese_translation/exact_part3"
+require_relative "japanese_translation/exact_part4"
+require_relative "japanese_translation/exact_part5"
+require_relative "japanese_translation/exact_part6"
+require_relative "japanese_translation/exact_part7"
+
+module JapaneseTranslation
+  EXACT = {}.merge(EXACT_PART1).merge(EXACT_PART2).merge(EXACT_PART3).merge(EXACT_PART4).merge(EXACT_PART5).merge(EXACT_PART6).merge(EXACT_PART7)
+
+  SORTED_KEYS = EXACT.keys.sort_by(&:length).reverse
+
+  PATTERNS = [
+    [ /\ABack to (.+)\z/, '\1に戻る' ],
+    [ /Back to (.+)/, '\1に戻る' ],
+    [ /\ALoad page (\d+)\z/, 'ページ\1を読み込む' ],
+    [ /Load page (\d+)/, 'ページ\1を読み込む' ],
+    [ /Show (\d+) more watchers/, '\1人のウォッチャーをさらに表示' ],
+    [ /Settings for (.+)/, '\1の設定' ],
+    [ /Download (.+)/, '\1をダウンロード' ],
+    [ /Column: (.+)/, 'カラム：\1' ],
+    [ /Join (.+) in Fizzy/, 'Fizzyで\1に参加' ],
+    [ /Search results for "(.+)"/, '「\1」の検索結果' ],
+    [ /Card (\d+)/, 'カード\1' ],
+  ]
+
+  def self.translate_html(html)
+    return html if html.blank?
+    return html unless html.include?("<")
+    begin
+      is_document = html.lstrip.start_with?("<!DOCTYPE", "<html")
+      if is_document
+        doc = Nokogiri::HTML5.parse(html)
+        return html unless doc
+        translate_node(doc)
+        doc.to_html
+      else
+        fragment = Nokogiri::HTML5.fragment(html)
+        translate_node(fragment)
+        fragment.to_html
+      end
+    rescue
+      Rails.logger.error("JapaneseTranslation failed")
+      html
+    end
+  end
+
+  def self.translate_node(root)
+    root.traverse do |node|
+      if node.text?
+        parent = node.parent
+        next if parent && %w[script style].include?(parent.name)
+        text = node.text
+        next if text.strip.empty?
+        translated = translate_text_content(text)
+        node.content = translated if translated != text
+      elsif node.element?
+        node.attributes.each do |name, attr|
+          val = attr.value
+          next unless val
+          next if val.strip.empty?
+          translated = translate_text_content(val)
+          attr.value = translated if translated != val
+        end
+      end
+    end
+  end
+
+  def self.translate_text_content(text)
+    result = text.dup
+    PATTERNS.each do |regex, replacement|
+      result = result.gsub(regex, replacement)
+    end
+    SORTED_KEYS.each do |en|
+      next unless result.include?(en)
+      ja = EXACT[en]
+      result = result.gsub(en, ja)
+    end
+    result
+  end
+
+  def self.translate_text(text)
+    return text if text.blank?
+    translate_text_content(text)
+  end
+end
