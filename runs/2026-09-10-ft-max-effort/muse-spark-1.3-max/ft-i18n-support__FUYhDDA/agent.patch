diff --git a/test/locale_test.rb b/test/locale_test.rb
new file mode 100644
index 0000000..16fcbb2
--- /dev/null
+++ b/test/locale_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "locale switching via param" do
+    user = users(:jason)
+    sign_in_as user
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", I18n.locale.to_s rescue nil
+    puts "BODY LANG: #{response.body[0,500]}"
+    assert_includes response.body, 'lang="ja"'
+    # Check our small dict translations
+    assert_includes response.body, "メインコンテンツへスキップ" # Skip to main content
+  end
+
+  test "invalid locale does not break" do
+    user = users(:jason)
+    sign_in_as user
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_includes response.body, 'lang="en"'
+    assert_includes response.body, "Skip to main content"
+  end
+
+  test "english unchanged" do
+    user = users(:jason)
+    sign_in_as user
+    get root_path
+    assert_response :success
+    assert_includes response.body, 'lang="en"'
+    assert_includes response.body, "Skip to main content"
+  end
+end
