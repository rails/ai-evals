diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..b0f07ca
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,56 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key p256dh auth ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @subscription = PushSubscription.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @subscription.assign_attributes(subscription_params.merge(user: @user, account: @user.account))
+
+    if @subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled for this device" }
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: @subscription.errors.full_messages.to_sentence }
+        format.json { render json: @subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @subscription = @user.push_subscriptions.find(params[:id])
+    @subscription.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      permitted = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key, :p256dh, :auth, keys: [ :p256dh, :auth ] ])
+
+      # Support browsers that post the raw PushSubscription JSON shape:
+      # { endpoint, keys: { p256dh, auth } } or flattened { endpoint, p256dh, auth }
+      if permitted[:keys].present?
+        permitted[:p256dh_key] ||= permitted.dig(:keys, :p256dh)
+        permitted[:auth_key] ||= permitted.dig(:keys, :auth)
+      end
+      permitted[:p256dh_key] ||= permitted.delete(:p256dh) if permitted.key?(:p256dh)
+      permitted[:auth_key] ||= permitted.delete(:auth) if permitted.key?(:auth)
+      permitted.except(:keys, :p256dh, :auth)
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..4394d0a
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,133 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "explainer", "details" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionsUrl: String
+  }
+
+  async connect() {
+    await this.#updateStatus()
+  }
+
+  async subscribe(event) {
+    event?.preventDefault()
+
+    if (!this.#supported) {
+      this.#showHelp()
+      return
+    }
+
+    this.#setBusy(true)
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission !== "granted") {
+        this.#showHelp()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+      }
+
+      await this.#saveSubscription(subscription)
+
+      this.element.classList.add("notifications--on")
+      this.#hideHelp()
+    } catch (error) {
+      console.error("Push subscription failed:", error)
+      this.#showHelp()
+    } finally {
+      this.#setBusy(false)
+    }
+  }
+
+  async #updateStatus() {
+    if (!this.#supported) return
+
+    try {
+      if (Notification.permission === "denied") {
+        this.#showHelp()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        this.element.classList.add("notifications--on")
+      } else if (Notification.permission === "granted") {
+        // Permission granted but not subscribed yet — stay in off state
+        this.element.classList.remove("notifications--on")
+      }
+    } catch {
+      // Service worker not ready yet; leave in off state
+    }
+  }
+
+  async #saveSubscription(subscription) {
+    const json = subscription.toJSON()
+
+    await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  #showHelp() {
+    this.element.classList.remove("notifications--on")
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = false
+    }
+  }
+
+  #hideHelp() {
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = true
+    }
+  }
+
+  #setBusy(busy) {
+    if (this.hasButtonTarget) {
+      this.buttonTarget.toggleAttribute("disabled", busy)
+      this.buttonTarget.toggleAttribute("aria-busy", busy)
+    }
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    return this.#urlBase64ToUint8Array(this.vapidPublicKeyValue)
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
