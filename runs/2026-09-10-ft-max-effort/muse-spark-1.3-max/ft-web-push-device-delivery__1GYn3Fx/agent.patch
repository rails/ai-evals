@@ -49,7 +51,79 @@ class Notification < ApplicationRecord
     read_at.present?
   end
 
+  def deliver_push_on_create
+    deliver_push_later
+  end
+
+  def deliver_push_on_update
+    deliver_push_later
+  end
+
+  def deliver_push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def deliver_push_now
+    return unless PushSubscription.configured?
+    return if source.nil? || card.nil?
+
+    payload = push_payload
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver(payload)
+    end
+  end
+
+  def push_payload
+    {
+      title: push_title,
+      body: push_body,
+      url: push_url,
+      card_url: push_url,
+      icon: "/app-icon-192.png",
+      badge: "/app-icon-192.png",
+      tag: "card-#{card_id}",
+      data: { url: push_url }
+    }.to_json
+  end
+
+  def push_title
+    case source_type
+    when "Event"
+      ApplicationController.helpers.event_notification_title(source)
+    when "Mention"
+      "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def push_body
+    case source_type
+    when "Event"
+      ApplicationController.helpers.event_notification_body(source)
+    when "Mention"
+      source.source.mentionable_content.truncate(200)
+    end
+  end
+
+  def push_url
+    helpers = Rails.application.routes.url_helpers
+    options = base_url_options.merge(script_name: account.slug)
+    if options[:host].present?
+      helpers.card_url(card, options)
+    else
+      helpers.card_path(card, script_name: account.slug)
+    end
+  end
+
   private
+    def should_deliver_push?
+      previous_changes.key?("source_id") || previous_changes.key?("source_type")
+    end
+
+    def base_url_options
+      (Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}).symbolize_keys
+    end
+
     def set_card
       self.card = source.card
     end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..d7e7781
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,44 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user&.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, presence: true
+  validates :auth_key, presence: true
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def vapid_subject
+      ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do")
+    end
+
+    def vapid_details
+      { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+  end
+
+  def deliver(message)
+    return unless self.class.configured?
+
+    WebPush.payload_send(
+      message: message.is_a?(String) ? message : JSON.generate(message),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid_details
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+end
