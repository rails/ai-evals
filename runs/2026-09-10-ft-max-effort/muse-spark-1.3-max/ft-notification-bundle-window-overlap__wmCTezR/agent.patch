+
+  test "full async flow creates one bundle and schedules delivery" do
+    t0 = Time.utc(2026, 1, 5, 10, 0, 0)
+    travel_to t0 do
+      perform_enqueued_jobs only: [ Notification::BundleJob ] do
+        @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+      end
+      assert_equal 1, Notification::Bundle.for_user(@user).count
+      bundle = Notification::Bundle.for_user(@user).first
+      assert_equal t0, bundle.starts_at
+      assert_equal t0 + 1.day, bundle.ends_at
+      # Delivery scheduled at ends_at
+      assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ bundle ], at: bundle.ends_at) do
+        bundle.schedule_delivery!
+      end
+    end
+  end
