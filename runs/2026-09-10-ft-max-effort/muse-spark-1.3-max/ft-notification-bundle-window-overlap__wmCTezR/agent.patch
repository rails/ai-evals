+
+  test "notification after sent window creates non-overlapping window" do
+    t0 = Time.utc(2026, 1, 5, 10, 0, 0)
+    travel_to t0 do
+      n = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+      b1 = Notification::Bundle.bundle_notification(n)
+      b1.update!(sent_at: Time.current)
+      n.update!(source: events(:layout_published))
+      b2 = Notification::Bundle.bundle_notification(n.reload)
+      assert_not_equal b1.id, b2.id
+      assert_no_overlaps_for(@user)
+      # New window starts at old ends to avoid overlap (since arrival within sent interval)
+      assert_equal b1.ends_at, b2.starts_at
+    end
+  end
+
+  private
+    def assert_no_overlaps_for(user)
+      bundles = Notification::Bundle.for_user(user).ordered.to_a
+      bundles.combination(2).each do |a, b|
+        assert_not (a.starts_at < b.ends_at && b.starts_at < a.ends_at),
+          "Windows overlap: #{a.starts_at}-#{a.ends_at} vs #{b.starts_at}-#{b.ends_at}"
+      end
+    end
+end
