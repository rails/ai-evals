+    Notification::Bundle.create!(account: @user.account, user: @user, starts_at: t0, ends_at: t0 + 1.day)
+    overlapping = Notification::Bundle.new(account: @user.account, user: @user, starts_at: t0 + 12.hours, ends_at: t0 + 36.hours)
+    assert_not overlapping.valid?
