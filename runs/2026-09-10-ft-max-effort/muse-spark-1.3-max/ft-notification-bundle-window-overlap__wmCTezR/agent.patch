@@ -0,0 +1,283 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @user.notifications.destroy_all
+    Notification::Bundle.where(user: @user).destroy_all
+  end
+
+  test "bundle_email_frequency enum values" do
+    assert_equal %w[ never every_few_hours daily weekly ].sort, User::Settings.bundle_email_frequencies.keys.sort
+  end
+
+  test "durations match spec" do
