diff --git a/test/jobs/notification_bundle_job_test.rb b/test/jobs/notification_bundle_job_test.rb
new file mode 100644
index 0000000..651dea7
--- /dev/null
+++ b/test/jobs/notification_bundle_job_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class NotificationBundleJobTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @user.notifications.destroy_all
+    Notification::Bundle.where(user: @user).destroy_all
+  end
+
+  test "BundleJob bundles notification" do
+    n = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    Notification::Bundle.where(user: @user).destroy_all
+    assert_difference -> { Notification::Bundle.count }, 1 do
+      Notification::BundleJob.perform_now(n)
+    end
+  end
+
+  test "BundleJob does nothing for never frequency" do
+    @user.settings.update!(bundle_email_frequency: "never")
+    n = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification::BundleJob.perform_now(n)
+    end
+  end
+
+  test "DeliveryJob delivers bundle" do
+    n = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = Notification::Bundle.bundle_notification(n)
+    assert_emails 1 do
+      Notification::Bundle::DeliveryJob.perform_now(bundle)
+    end
+    assert bundle.reload.sent?
+  end
+end
diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..ebaa203
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @user.notifications.destroy_all
+    Notification::Bundle.where(user: @user).destroy_all
+  end
+
+  test "digest sends one email per window with all notifications" do
+    t0 = Time.utc(2026, 1, 5, 10, 0, 0)
+    travel_to t0 do
+      n1 = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+      bundle = Notification::Bundle.bundle_notification(n1)
+      n2 = @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+      Notification::Bundle.bundle_notification(n2)
+
+      email = NotificationMailer.digest(bundle.reload)
+
+      assert_emails 1 do
+        email.deliver_now
+      end
+
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_equal "2 new notifications", email.subject
+      assert_match n1.card.title, email.body.encoded
+      assert_match n2.card.title, email.body.encoded
+      assert email.html_part.present?
+      assert email.text_part.present?
+    end
+  end
+
+  test "digest subject singular" do
+    n1 = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+    bundle = Notification::Bundle.bundle_notification(n1)
+    email = NotificationMailer.digest(bundle)
+    assert_equal "1 new notification", email.subject
+  end
+end
