--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,24 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_entries, class_name: "Notification::Bundle::Entry", dependent: :destroy
+    has_many :bundles, through: :bundle_entries, source: :bundle
+
+    after_save_commit :bundle_for_email_later, if: :source_id_previously_changed?
+  end
+
+  # Enqueue async bundling. Called automatically when a notification is created
+  # or when its source changes (i.e. a new event landed for the same card).
+  def bundle_for_email_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  # Synchronously assign this notification to the right digest window.
+  def bundle_for_email(at: Time.current)
+    Notification::Bundle.bundle_notification(self, at: at)
+  end
+
+  # Alias used by alternative naming.
+  alias_method :bundle, :bundle_for_email
+end
