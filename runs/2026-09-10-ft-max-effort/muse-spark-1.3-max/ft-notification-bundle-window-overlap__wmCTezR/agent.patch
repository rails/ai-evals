+  # Alias for notification digests — delegates to NotificationMailer for
+  # discoverability under either mailer name.
+  def notification_digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.ordered.to_a
+
+    Current.account = @account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: @notifications.size == 1 ? "1 new notification" : "#{@notifications.size} new notifications"
+    )
+  end
+  alias_method :digest, :notification_digest
 end
