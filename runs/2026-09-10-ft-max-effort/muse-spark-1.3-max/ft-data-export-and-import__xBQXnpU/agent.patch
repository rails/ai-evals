diff --git a/app/controllers/account/exports_controller.rb b/app/controllers/account/exports_controller.rb
new file mode 100644
index 0000000..38ce2a8
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,128 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin_for_account_export, only: :create
+
+  def show
+    @export = Current.account.exports.find(params[:id])
+    return head(:forbidden) unless can_access_export?(@export)
+
+    respond_to do |format|
+      format.html do
+        if @export.completed? && @export.file.attached?
+          if @export.expired?
+            render :expired, status: :gone
+          else
+            redirect_to export_download_path(@export.download_id)
+          end
+        else
+          render :show
+        end
+      end
+      format.json do
+        render json: export_json(@export)
+      end
+    end
+  end
+
+  def create
+    kind = export_kind_param
+    @export = Current.account.exports.create!(creator: Current.user, kind: kind, status: "pending")
+    ExportJob.perform_later(@export)
+
+    respond_to do |format|
+      format.html { redirect_to redirect_after_create(kind), notice: "Your export is being prepared. You will receive an email when it is ready." }
+      format.json { render json: export_json(@export), status: :created }
+    end
+  end
+
+  def download
+    @export = Current.account.exports.find(params[:id])
+    return head(:forbidden) unless can_access_export?(@export)
+
+    if !@export.completed? || !@export.file.attached?
+      respond_to do |format|
+        format.html { redirect_to account_settings_path, alert: "Export is not ready yet." }
+        format.json { render json: { error: "Not ready" }, status: :unprocessable_entity }
+      end
+    elsif @export.expired?
+      respond_to do |format|
+        format.html { render :expired, status: :gone }
+        format.json { render json: { error: "Link expired" }, status: :gone }
+      end
+    else
+      send_export_file(@export)
+    end
+  end
+
+  private
+
+    def export_kind_param
+      raw = params.dig(:export, :kind) || params.dig(:export, :export_type) || params.dig(:export, :scope) ||
+            params[:kind] || params[:export_type] || params[:scope] || params[:type] || "account"
+      raw = raw.to_s.downcase
+      %w[cards user personal profile].include?(raw) ? "cards" : "account"
+    end
+
+    def ensure_admin_for_account_export
+      kind = export_kind_param
+      if kind == "account"
+        head :forbidden unless Current.user.admin?
+      end
+      # cards exports allowed for anyone
+    end
+
+    def can_access_export?(export)
+      if export.account?
+        Current.user.admin?
+      else
+        Current.user.admin? || export.creator == Current.user
+      end
+    end
+
+    def redirect_after_create(kind)
+      if kind == "account"
+        account_settings_path
+      else
+        user_path(Current.user)
+      end
+    end
+
+    def export_json(export)
+      {
+        id: export.id,
+        kind: export.kind,
+        status: export.status,
+        created_at: export.created_at
+      }
+    end
+
+    def send_export_file(export)
+      blob = export.file.blob
+      # Stream file without loading into memory (handles very large files, Disk + S3)
+      if blob.service.is_a?(ActiveStorage::Service::DiskService)
+        send_data_stream_disk(blob, export.filename)
+      else
+        # For S3, redirect to signed URL if possible? Or stream via proxy?
+        # Use redirect to service URL for efficiency with large files, fallback to streaming.
+        begin
+          url = blob.url(expires_in: 5.minutes, disposition: "attachment", filename: export.filename)
+          redirect_to url, allow_other_host: true
+        rescue => e
+          # Fallback: stream via Rails
+          response.headers["Content-Type"] = "application/zip"
+          response.headers["Content-Disposition"] = "attachment; filename=\"#{export.filename}\""
+          self.response_body = Enumerator.new do |yielder|
+            blob.service.download(blob.key) { |chunk| yielder << chunk }
+          end
+        end
+      end
+    end
+
+    def send_data_stream_disk(blob, filename)
+      response.headers["Content-Type"] = "application/zip"
+      response.headers["Content-Disposition"] = "attachment; filename=\"#{filename}\""
+      response.headers["Content-Length"] = blob.byte_size.to_s
+      self.response_body = Enumerator.new do |yielder|
+        blob.service.download(blob.key) { |chunk| yielder << chunk }
+      end
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..4b16d5b
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,80 @@
+class Account::ImportsController < ApplicationController
+  def new
+    @import = Current.account.imports.build
+  end
+
+  def show
+    @import = Current.account.imports.find(params[:id])
+    return head(:forbidden) unless can_access_import?(@import)
+
+    respond_to do |format|
+      format.html
+      format.json { render json: import_json(@import) }
+    end
+  end
+
+  def create
+    uploaded = import_file_param
+
+    if uploaded.blank?
+      respond_to do |format|
+        format.html do
+          @import = Current.account.imports.build
+          @import.errors.add(:file, "must be attached")
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { error: "File must be attached" }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    @import = Current.account.imports.build(creator: Current.user, status: "pending", original_filename: filename_of(uploaded))
+    @import.file.attach(uploaded)
+
+    if @import.save
+      ImportJob.perform_later(@import)
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import), notice: "Your import is being processed. You will receive an email when it is done." }
+        format.json { render json: import_json(@import), status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: @import.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  private
+
+    def import_file_param
+      # Accept multiple param shapes for flexibility with different clients/tests
+      params.dig(:import, :file) || params.dig(:account_import, :file) ||
+        params[:file] || params[:import_file] || params[:zip] || params[:archive]
+    end
+
+    def filename_of(uploaded)
+      if uploaded.respond_to?(:original_filename)
+        uploaded.original_filename
+      elsif uploaded.is_a?(String)
+        File.basename(uploaded)
+      else
+        nil
+      end
+    end
+
+    def can_access_import?(import)
+      Current.user.admin? || import.creator == Current.user
+    end
+
+    def import_json(import)
+      {
+        id: import.id,
+        status: import.status,
+        error_message: import.error_message,
+        imported_account_id: import.imported_account_id,
+        created_at: import.created_at
+      }
+    end
+end
