+
+    respond_to do |format|
+      format.html { redirect_to user_path(@user), notice: "Your export is being prepared. You will receive an email when it is ready." }
+      format.json { render json: { id: @export.id, kind: @export.kind, status: @export.status }, status: :created }
+    end
+  end
+
+  def download
+    @export = Current.account.exports.find(params[:id])
+    return head(:forbidden) unless can_access?(@export)
+    if !@export.completed? || !@export.file.attached?
+      redirect_to user_path(@user), alert: "Export is not ready yet."
+    elsif @export.expired?
+      render "account/exports/expired", status: :gone
+    else
+      blob = @export.file.blob
+      response.headers["Content-Type"] = "application/zip"
+      response.headers["Content-Disposition"] = "attachment; filename=\"#{@export.filename}\""
