+++ b/app/mailers/export_mailer.rb
@@ -0,0 +1,39 @@
+class ExportMailer < ApplicationMailer
+  def ready(export)
+    @export = export
+    @account = export.account
+    @user = export.creator
+    @download_url = export_download_url(@export.download_id)
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy export is ready"
+    )
+  end
+  alias_method :completed, :ready
+  alias_method :export_ready, :ready
+
+  private
+
+    def export_download_url(download_id)
+      # Generate absolute URL with account slug for portability.
+      # Use host from default_url_options (example.com in test, BASE_URL in production).
+      Rails.application.routes.url_helpers.export_download_url(
+        download_id,
+        host: host_for_url,
+        script_name: @account.slug
+      )
+    rescue => e
+      # Fallback to relative path if host missing
+      Rails.application.routes.url_helpers.export_download_path(download_id, script_name: @account.slug)
+    end
+
+    def host_for_url
+      # Prefer BASE_URL host if set, else default_url_options, else example.com
+      if ENV["BASE_URL"].present?
+        URI.parse(ENV["BASE_URL"]).host
+      else
+        ActionMailer::Base.default_url_options[:host] || "example.com"
+      end
+    end
+end
diff --git a/app/mailers/import_mailer.rb b/app/mailers/import_mailer.rb
