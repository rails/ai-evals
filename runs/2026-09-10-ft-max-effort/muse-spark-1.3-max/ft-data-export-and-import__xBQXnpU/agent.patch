diff --git a/app/views/account/imports/new.html.erb b/app/views/account/imports/new.html.erb
new file mode 100644
index 0000000..1d176d0
--- /dev/null
+++ b/app/views/account/imports/new.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Import account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account Settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<div class="panel panel--wide shadow center flex flex-column gap">
+  <header>
+    <h2 class="txt-large margin-none font-weight-black"><%= @page_title %></h2>
+    <p class="txt-medium margin-none">Upload an account export file (.zip) to create a new account with its boards, cards, comments, files, and people.</p>
+  </header>
+
+  <%= form_with model: @import, url: account_imports_path, method: :post, multipart: true, class: "flex flex-column gap" do |form| %>
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small">
+        <% @import.errors.full_messages.each do |msg| %>
+          <p class="margin-none"><%= msg %></p>
+        <% end %>
+      </div>
+    <% end %>
+
+    <div class="flex flex-column gap-half">
+      <%= form.label :file, "Account file (.zip)", class: "txt-small font-weight-bold" %>
+      <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+    </div>
+
+    <div class="flex gap">
+      <%= form.submit "Import account", class: "btn btn--primary" %>
+    </div>
+  <% end %>
+
+  <footer class="txt-small txt-tinted">
+    <p class="margin-none">You will receive an email when the import is done, or if it failed and why. A failed import leaves nothing behind.</p>
+  </footer>
+</div>
diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
new file mode 100644
index 0000000..b46bf4a
--- /dev/null
+++ b/app/views/account/imports/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Import" %>
+<div class="panel panel--wide shadow center flex flex-column gap">
+  <header>
+    <% if @import.completed? %>
+      <h2 class="txt-large margin-none font-weight-black">Import complete</h2>
+      <p class="txt-medium margin-none">A new account was created with your boards, cards, comments, files, and people.</p>
+    <% elsif @import.failed? %>
+      <h2 class="txt-large margin-none font-weight-black">Import failed</h2>
+      <p class="txt-medium margin-none">The import could not be completed and nothing was created.</p>
+      <% if @import.error_message.present? %>
+        <p class="txt-small txt-negative"><%= @import.error_message %></p>
+      <% end %>
+    <% else %>
+      <h2 class="txt-large margin-none font-weight-black">Import in progress</h2>
+      <p class="txt-medium margin-none">Your import is being processed. You will receive an email when it is done.</p>
+    <% end %>
+  </header>
+
+  <% if @import.completed? && @import.imported_account %>
+    <div class="flex gap">
+      <%= link_to "Open new account", root_path(script_name: @import.imported_account.slug), class: "btn btn--primary" %>
+    </div>
+  <% elsif @import.failed? %>
+    <div class="flex gap">
+      <%= link_to "Try again", new_account_import_path, class: "btn" %>
+    </div>
+  <% end %>
+</div>
