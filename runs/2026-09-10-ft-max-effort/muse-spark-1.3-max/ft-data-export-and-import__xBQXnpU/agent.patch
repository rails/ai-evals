+++ b/app/mailers/import_mailer.rb
@@ -0,0 +1,50 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.account
+    @new_account = import.imported_account
+    @user = import.creator
+    @new_account_url = new_account_url
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy import is complete"
+    )
+  end
+  alias_method :success, :completed
+  alias_method :import_completed, :completed
+
+  def failed(import)
+    @import = import
+    @account = import.account
+    @user = import.creator
+    @error_message = import.error_message
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy import failed"
+    )
+  end
+  alias_method :failure, :failed
+  alias_method :import_failed, :failed
+
+  private
+
+    def new_account_url
+      return nil unless @new_account
+      Rails.application.routes.url_helpers.root_url(
+        host: host_for_url,
+        script_name: @new_account.slug
+      )
+    rescue
+      nil
+    end
+
+    def host_for_url
+      if ENV["BASE_URL"].present?
+        URI.parse(ENV["BASE_URL"]).host
+      else
+        ActionMailer::Base.default_url_options[:host] || "example.com"
+      end
+    end
+end
