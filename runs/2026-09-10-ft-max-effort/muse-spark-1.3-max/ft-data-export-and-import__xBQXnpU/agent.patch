+++ b/app/controllers/exports_controller.rb
@@ -0,0 +1,58 @@
+class ExportsController < ApplicationController
+  # Signed download links work for a day without requiring authentication.
+  # Allow with or without account slug (skip require_account without redirect).
+  skip_before_action :require_account
+  allow_unauthenticated_access
+
+  def show
+    download
+  end
+
+  def download
+    @export = Export.find_by_download_id(params[:signed_id] || params[:id])
+
+    if @export.nil?
+      respond_to do |format|
+        format.html { render "account/exports/expired", status: :gone }
+        format.json { render json: { error: "Link expired or invalid" }, status: :gone }
+      end
+      return
+    end
+
+    # Set Current.account for URL generation etc. (optional, doesn't require auth)
+    Current.account = @export.account
+
+    unless @export.completed? && @export.file.attached?
+      respond_to do |format|
+        format.html { render "account/exports/show", status: :unprocessable_entity }
+        format.json { render json: { error: "Not ready" }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    blob = @export.file.blob
+    filename = @export.filename
+
+    # Stream without loading into memory (handles very large files, Disk + S3)
+    if blob.service.is_a?(ActiveStorage::Service::DiskService)
+      response.headers["Content-Type"] = "application/zip"
+      response.headers["Content-Disposition"] = "attachment; filename=\"#{filename}\""
+      response.headers["Content-Length"] = blob.byte_size.to_s
+      self.response_body = Enumerator.new do |yielder|
+        blob.service.download(blob.key) { |chunk| yielder << chunk }
+      end
+    else
+      # For S3, redirect to signed URL for efficiency
+      begin
+        url = blob.url(expires_in: 5.minutes, disposition: "attachment", filename: filename)
+        redirect_to url, allow_other_host: true
+      rescue => e
+        response.headers["Content-Type"] = "application/zip"
+        response.headers["Content-Disposition"] = "attachment; filename=\"#{filename}\""
+        self.response_body = Enumerator.new do |yielder|
+          blob.service.download(blob.key) { |chunk| yielder << chunk }
+        end
+      end
+    end
+  end
+end
