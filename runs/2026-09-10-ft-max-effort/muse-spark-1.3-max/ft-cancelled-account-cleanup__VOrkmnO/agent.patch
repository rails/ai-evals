diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..1104b8d 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,40 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...Account::Incineratable::INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    account_id = id
+    destroy!.tap do
+      # Cleanup stragglers that survive the cascading destroy:
+      # - ActiveStorage blobs survive as `purge_later` (async), so purge them synchronously
+      #   to ensure files and DB rows are gone immediately. Purging blobs also removes
+      #   their variant records and attachments.
+      # - Storage ledger entries have no dependent destroy, so delete them explicitly.
+      ActiveStorage::Blob.where(account_id: account_id).find_each(&:purge)
+      Storage::Entry.where(account_id: account_id).delete_all
+
+      # Safety net for any remaining framework rows (should already be gone via purge).
+      ActiveStorage::Attachment.where(account_id: account_id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: account_id).delete_all
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at < Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+  end
+
+  def incineration_due_at
+    cancellation&.created_at&.+(Account::Incineratable::INCINERATION_GRACE_PERIOD)
+  end
 end
