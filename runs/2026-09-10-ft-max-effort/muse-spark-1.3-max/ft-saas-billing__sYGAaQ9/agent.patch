+++ b/saas/app/views/billing/show.html.erb
@@ -0,0 +1,38 @@
+<% @page_title = "Billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Current plan</h2>
+        <div>Your account is on the <strong><%= @account.plan_name %></strong> plan.</div>
+      </header>
+
+      <div class="flex flex-column gap-half margin-block-half">
+        <div>Cards: <%= number_with_delimiter(@account.effective_cards_count) %><% if @account.card_limit %> of <%= number_with_delimiter(@account.card_limit) %><% else %> (unlimited)<% end %></div>
+        <div>Storage: <%= number_to_human_size(@account.effective_bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %></div>
+      </div>
+
+      <% if @account.free? %>
+        <div class="flex gap-half">
+          <%= button_to "Upgrade", saas.checkout_billing_path(plan: "unlimited"), method: :post, class: "btn btn--reversed" %>
+        </div>
+        <div class="txt-small margin-block-start-half">
+          Unlimited — $20/month, 5 GB storage, unlimited cards.<br>
+          Unlimited+ — $25/month, 500 GB storage, unlimited cards.
+        </div>
+        <div class="flex gap-half margin-block-start-half">
+          <%= button_to "Upgrade to Unlimited+", saas.checkout_billing_path(plan: "unlimited_plus"), method: :post, class: "btn" %>
+        </div>
+      <% else %>
+        <div class="flex gap-half">
+          <%= button_to "Manage billing", saas.portal_billing_path, method: :post, class: "btn" %>
+        </div>
+      <% end %>
+    </section>
+  </div>
+</section>
