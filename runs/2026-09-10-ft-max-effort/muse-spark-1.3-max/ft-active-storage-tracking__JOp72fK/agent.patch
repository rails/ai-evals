diff --git a/app/models/comment/bytes_used.rb b/app/models/comment/bytes_used.rb
new file mode 100644
index 0000000..aa47c60
--- /dev/null
+++ b/app/models/comment/bytes_used.rb
@@ -0,0 +1,44 @@
+module Comment::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :capture_bytes_used_for_destroy, unless: :in_outer_bytes_used_bulk_destroy?, prepend: true
+    around_destroy :track_bytes_used_bulk_destroy, prepend: true
+    after_destroy_commit :decrement_parent_bytes_used_after_destroy
+  end
+
+  def calculate_bytes_used
+    ActiveStorage::Attachment
+      .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id AND active_storage_attachments.record_type = 'ActionText::RichText'")
+      .joins(:blob)
+      .where(active_storage_attachments: { name: "embeds" }, action_text_rich_texts: { record_type: "Comment", record_id: id, name: "body" })
+      .sum("active_storage_blobs.byte_size")
+  end
+
+  private
+    def track_bytes_used_bulk_destroy
+      BytesUsedBulkTracker.push(self)
+      yield
+    ensure
+      BytesUsedBulkTracker.pop
+    end
+
+    def in_outer_bytes_used_bulk_destroy?
+      BytesUsedBulkTracker.in_outer_bulk_destroy?
+    end
+
+    def capture_bytes_used_for_destroy
+      @bytes_used_before_destroy = calculate_bytes_used
+      @board_id_before_destroy = card&.board_id
+      @account_id_before_destroy = card&.board&.account_id || account_id
+    end
+
+    def decrement_parent_bytes_used_after_destroy
+      if @bytes_used_before_destroy && @bytes_used_before_destroy != 0
+        adjustments = []
+        adjustments << { type: "Board", id: @board_id_before_destroy, delta: -@bytes_used_before_destroy } if @board_id_before_destroy
+        adjustments << { type: "Account", id: @account_id_before_destroy, delta: -@bytes_used_before_destroy } if @account_id_before_destroy
+        BytesUsedAdjustmentJob.perform_later(adjustments) if adjustments.any?
+      end
+    end
+end
