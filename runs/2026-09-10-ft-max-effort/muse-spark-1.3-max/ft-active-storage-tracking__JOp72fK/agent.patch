+      ActiveStorage::Attachment
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id AND active_storage_attachments.record_type = 'ActionText::RichText'")
+        .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Comment'")
+        .joins("INNER JOIN cards ON cards.id = comments.card_id")
+        .joins(:blob)
+        .where(cards: { board_id: id }, active_storage_attachments: { name: "embeds" }, action_text_rich_texts: { name: "body" })
