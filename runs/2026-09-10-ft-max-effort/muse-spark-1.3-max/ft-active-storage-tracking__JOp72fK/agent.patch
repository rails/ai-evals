diff --git a/app/jobs/bytes_used_adjustment_job.rb b/app/jobs/bytes_used_adjustment_job.rb
new file mode 100644
index 0000000..6270c1b
--- /dev/null
+++ b/app/jobs/bytes_used_adjustment_job.rb
@@ -0,0 +1,34 @@
+# Applies storage usage deltas to cached +bytes_used+ counters.
+#
+# Deltas are captured synchronously when attachments change (so they survive
+# subsequent moves and destroys) but applied asynchronously in the background
+# via atomic SQL updates. Atomic updates keep the counters correct when many
+# users attach files concurrently, and a single job per change keeps the work
+# O(1) regardless of how many attachments an account or board already has.
+#
+# Adjustments are plain hashes so the job does not depend on records that may
+# have been deleted before the job runs. Missing records are simply skipped.
+class BytesUsedAdjustmentJob < ApplicationJob
+  queue_as :default
+
+  def perform(adjustments)
+    ActiveRecord::Base.transaction do
+      Array(adjustments).each do |adjustment|
+        apply_adjustment(adjustment)
+      end
+    end
+  end
+
+  private
+    def apply_adjustment(adjustment)
+      type = adjustment["type"] || adjustment[:type]
+      id = adjustment["id"] || adjustment[:id]
+      delta = (adjustment["delta"] || adjustment[:delta]).to_i
+
+      if delta != 0 && id.present? && %w[Account Board].include?(type.to_s)
+        type.to_s.constantize.update_counters(id, bytes_used: delta)
+      end
+    rescue ActiveRecord::RecordNotFound
+      # Record was deleted after the adjustment was enqueued; nothing to do.
+    end
+end
diff --git a/app/jobs/card/transfer_bytes_used_job.rb b/app/jobs/card/transfer_bytes_used_job.rb
new file mode 100644
index 0000000..6be5b3e
--- /dev/null
+++ b/app/jobs/card/transfer_bytes_used_job.rb
@@ -0,0 +1,33 @@
+class Card::TransferBytesUsedJob < ApplicationJob
+  # Moves a card's storage usage from one board to another in the background.
+  #
+  # The card's total is calculated in the job (not in the request) via a single
+  # SUM scoped to that card, so moves stay O(card) in the background and O(1) in
+  # the request regardless of board or account size.
+  #
+  # Account totals only change when boards belong to different accounts. Moves
+  # within an account leave the account total untouched.
+  def perform(card_id, old_board_id, new_board_id)
+    card = Card.find_by(id: card_id)
+    old_board = Board.find_by(id: old_board_id)
+    new_board = Board.find_by(id: new_board_id)
+
+    return if card.nil? || old_board.nil? || new_board.nil?
+    return if old_board_id == new_board_id
+
+    total = card.calculate_bytes_used
+    return if total == 0
+
+    adjustments = [
+      { type: "Board", id: old_board_id, delta: -total },
+      { type: "Board", id: new_board_id, delta: total }
+    ]
+
+    if old_board.account_id != new_board.account_id
+      adjustments << { type: "Account", id: old_board.account_id, delta: -total }
+      adjustments << { type: "Account", id: new_board.account_id, delta: total }
+    end
+
+    BytesUsedAdjustmentJob.perform_now(adjustments)
+  end
+end
