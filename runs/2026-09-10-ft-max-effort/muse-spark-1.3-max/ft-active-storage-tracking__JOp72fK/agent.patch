+module Board::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :capture_bytes_used_for_destroy, unless: :in_outer_bytes_used_bulk_destroy?, prepend: true
+    around_destroy :track_bytes_used_bulk_destroy, prepend: true
+    after_destroy_commit :decrement_account_bytes_used_after_destroy
+  end
+
+  def bytes_used
+    [ super || 0, 0 ].max
+  end
+
+  def calculate_bytes_used
+    card_images_bytes_used + board_embeds_bytes_used + card_embeds_bytes_used + comment_embeds_bytes_used
+  end
+
+  def recalculate_bytes_used!
+    update_columns(bytes_used: calculate_bytes_used)
+  end
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    recalculate_bytes_used!
+  end
+
+  def adjust_bytes_used_later(delta)
+    if delta.to_i != 0
+      BytesUsedAdjustmentJob.perform_later([ { type: "Board", id: id, delta: delta.to_i } ])
+    end
+  end
+
+  private
+    def track_bytes_used_bulk_destroy
+      BytesUsedBulkTracker.push(self)
+      yield
+    ensure
+      BytesUsedBulkTracker.pop
+    end
+
+    def in_outer_bytes_used_bulk_destroy?
+      BytesUsedBulkTracker.in_outer_bulk_destroy?
+    end
+
+    def capture_bytes_used_for_destroy
+      @bytes_used_before_destroy = calculate_bytes_used
+      @account_id_before_destroy = account_id
+    end
+
+    def decrement_account_bytes_used_after_destroy
+      if @bytes_used_before_destroy && @bytes_used_before_destroy != 0 && @account_id_before_destroy
+        BytesUsedAdjustmentJob.perform_later([ { type: "Account", id: @account_id_before_destroy, delta: -@bytes_used_before_destroy } ])
+      end
+    end
+
+    def card_images_bytes_used
+      ActiveStorage::Attachment
+        .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id AND active_storage_attachments.record_type = 'Card'")
+        .joins(:blob)
+        .where(cards: { board_id: id }, active_storage_attachments: { name: "image" })
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def board_embeds_bytes_used
+      ActiveStorage::Attachment
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id AND active_storage_attachments.record_type = 'ActionText::RichText'")
+        .joins(:blob)
+        .where(active_storage_attachments: { name: "embeds" }, action_text_rich_texts: { record_type: "Board", record_id: id, name: "public_description" })
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_embeds_bytes_used
+      ActiveStorage::Attachment
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id AND active_storage_attachments.record_type = 'ActionText::RichText'")
+        .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Card'")
+        .joins(:blob)
+        .where(cards: { board_id: id }, active_storage_attachments: { name: "embeds" }, action_text_rich_texts: { name: "description" })
+        .sum("active_storage_blobs.byte_size")
+    end
