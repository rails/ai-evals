+end
diff --git a/app/models/bytes_used_attachment_tracking.rb b/app/models/bytes_used_attachment_tracking.rb
new file mode 100644
index 0000000..d8dd653
--- /dev/null
+++ b/app/models/bytes_used_attachment_tracking.rb
@@ -0,0 +1,139 @@
+# Tracks storage usage for card images and rich text embeds.
+#
+# Only these attachments count towards Account and Board +bytes_used+:
+# - Card images (record_type Card, name image)
+# - Files embedded in board descriptions, card descriptions and comments
+#   (record_type ActionText::RichText, name embeds, where the rich text belongs
+#   to a Board/Card/Comment with the expected name)
+#
+# Everything else (avatars, exports, imports, unattached blobs) is ignored.
+#
+# Deltas are captured synchronously (so they survive subsequent moves and
+# destroys) but applied asynchronously via BytesUsedAdjustmentJob with atomic
+# SQL updates. Capturing uses only indexed primary-key lookups, so attaches stay
+# O(1) in the request regardless of account or board size.
+#
+# Purges via +purge+/+purge_later+/+detach+ bypass destroy callbacks (they use
+# +delete+), so +delete+ is overridden to capture the same delta. Destroys that
+# are part of a larger Board/Card/Comment destroy are skipped here because the
+# outermost record enqueues a single bulk adjustment instead (see
+# BytesUsedBulkTracker).
+module BytesUsedAttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :enqueue_bytes_used_increment
+    before_destroy :capture_bytes_used_for_destroy, unless: :in_bytes_used_bulk_destroy?
+    after_destroy_commit :enqueue_bytes_used_decrement
+  end
+
+  # +delete+ bypasses callbacks, but +purge+, +purge_later+ and +detach+ all go
+  # through it. Capture the delta here so those paths are counted too.
+  def delete
+    was_persisted = persisted?
+    capture = capture_bytes_used_adjustments if was_persisted
+    super.tap do
+      enqueue_captured_bytes_used_adjustments(capture, sign: -1) if was_persisted && capture
+    end
+  end
+
+  private
+    def enqueue_bytes_used_increment
+      if capture = capture_bytes_used_adjustments
+        enqueue_captured_bytes_used_adjustments(capture, sign: 1)
+      end
+    end
+
+    def capture_bytes_used_for_destroy
+      @bytes_used_capture_before_destroy = capture_bytes_used_adjustments
+    end
+
+    def enqueue_bytes_used_decrement
+      if @bytes_used_capture_before_destroy
+        enqueue_captured_bytes_used_adjustments(@bytes_used_capture_before_destroy, sign: -1)
+        @bytes_used_capture_before_destroy = nil
+      end
+    end
+
+    def in_bytes_used_bulk_destroy?
+      BytesUsedBulkTracker.in_bulk_destroy?
+    end
+
+    def enqueue_captured_bytes_used_adjustments(capture, sign:)
+      board_id, account_id, byte_size = capture
+      return if byte_size.to_i == 0
+
+      delta = byte_size.to_i * sign
+      adjustments = []
+      adjustments << { type: "Board", id: board_id, delta: delta } if board_id
+      adjustments << { type: "Account", id: account_id, delta: delta } if account_id
+
+      if adjustments.any?
+        BytesUsedAdjustmentJob.perform_later(adjustments)
+      end
+    end
+
+    # Returns [ board_id, account_id, byte_size ] or nil when not counted.
+    def capture_bytes_used_adjustments
+      board_id, account_id = bytes_used_board_and_account
+      return nil if board_id.nil? && account_id.nil?
+
+      byte_size = bytes_used_blob_byte_size
+      return nil if byte_size.nil? || byte_size == 0
+
+      [ board_id, account_id, byte_size ]
+    end
+
+    def bytes_used_board_and_account
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        bytes_used_for_card_image
+      when [ "ActionText::RichText", "embeds" ]
+        bytes_used_for_rich_text_embed
+      else
+        nil
+      end
+    end
+
+    def bytes_used_for_card_image
+      card = Card.find_by(id: record_id)
+      return nil if card.nil?
+
+      board = Board.find_by(id: card.board_id)
+      board ? [ board.id, board.account_id ] : nil
+    end
+
+    def bytes_used_for_rich_text_embed
+      rich_text = ActionText::RichText.find_by(id: record_id)
+      return nil if rich_text.nil?
+
+      case [ rich_text.record_type, rich_text.name ]
+      when [ "Board", "public_description" ]
+        board = Board.find_by(id: rich_text.record_id)
+        board ? [ board.id, board.account_id ] : nil
+      when [ "Card", "description" ]
+        card = Card.find_by(id: rich_text.record_id)
+        return nil if card.nil?
+
+        board = Board.find_by(id: card.board_id)
+        board ? [ board.id, board.account_id ] : nil
+      when [ "Comment", "body" ]
+        comment = Comment.find_by(id: rich_text.record_id)
+        return nil if comment.nil?
+
+        card = Card.find_by(id: comment.card_id)
+        return nil if card.nil?
+
+        board = Board.find_by(id: card.board_id)
+        board ? [ board.id, board.account_id ] : nil
+      else
+        nil
+      end
+    end
+
+    def bytes_used_blob_byte_size
+      # Use a direct lookup so this works in before_destroy (when associations
+      # may already be stale) and without instantiating the full blob.
+      ActiveStorage::Blob.where(id: blob_id).pick(:byte_size)
+    end
+end
diff --git a/app/models/bytes_used_bulk_tracker.rb b/app/models/bytes_used_bulk_tracker.rb
new file mode 100644
index 0000000..1e5fd4b
--- /dev/null
+++ b/app/models/bytes_used_bulk_tracker.rb
@@ -0,0 +1,40 @@
+# Tracks nested destroys of Account/Board/Card/Comment so that storage accounting
+# can coalesce many per-attachment updates into a single bulk adjustment.
+#
+# When a Board is destroyed, its Cards, Comments and all of their attachments are
+# destroyed in the same transaction. Without coalescing, each attachment would
+# enqueue its own adjustment job (O(N) jobs for N attachments). Instead, the
+# outermost record captures its total via a single SUM query and enqueues one job,
+# while inner records and attachments skip their own adjustments.
+#
+# Implemented with a thread-local stack because dependent destroys run synchronously
+# in the same thread inside the same transaction.
+class BytesUsedBulkTracker
+  THREAD_KEY = :bytes_used_bulk_destroy_stack
+
+  class << self
+    def stack
+      Thread.current[THREAD_KEY] ||= []
+    end
+
+    def push(record)
+      stack.push(record)
+    end
+
+    def pop
+      stack.pop
+    end
+
+    def in_bulk_destroy?
+      stack.any?
+    end
+
+    def in_outer_bulk_destroy?
+      stack.size > 1
+    end
+
+    def clear
+      Thread.current[THREAD_KEY] = []
+    end
+  end
+end
