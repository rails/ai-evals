+++ b/app/models/account/bytes_used.rb
@@ -0,0 +1,61 @@
+module Account::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    around_destroy :track_bytes_used_bulk_destroy, prepend: true
+  end
+
+  def bytes_used
+    [ super || 0, 0 ].max
+  end
+
+  def calculate_bytes_used
+    card_images_bytes_used + embeds_bytes_used
+  end
+
+  def recalculate_bytes_used!
+    update_columns(bytes_used: calculate_bytes_used)
+  end
+
+  def recalculate_bytes_used_later
+    Account::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    recalculate_bytes_used!
+  end
+
+  def adjust_bytes_used_later(delta)
+    if delta.to_i != 0
+      BytesUsedAdjustmentJob.perform_later([ { type: "Account", id: id, delta: delta.to_i } ])
+    end
+  end
+
+  private
+    def track_bytes_used_bulk_destroy
+      BytesUsedBulkTracker.push(self)
+      yield
+    ensure
+      BytesUsedBulkTracker.pop
+    end
+
+    def card_images_bytes_used
+      ActiveStorage::Attachment
+        .where(account_id: id, record_type: "Card", name: "image")
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def embeds_bytes_used
+      ActiveStorage::Attachment
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id AND active_storage_attachments.record_type = 'ActionText::RichText'")
+        .joins(:blob)
+        .where(active_storage_attachments: { account_id: id, name: "embeds" })
+        .where(
+          "(action_text_rich_texts.record_type = 'Board' AND action_text_rich_texts.name = 'public_description') OR " \
+          "(action_text_rich_texts.record_type = 'Card' AND action_text_rich_texts.name = 'description') OR " \
+          "(action_text_rich_texts.record_type = 'Comment' AND action_text_rich_texts.name = 'body')"
+        )
+        .sum("active_storage_blobs.byte_size")
+    end
+end
