diff --git a/app/models/authentication_code.rb b/app/models/authentication_code.rb
new file mode 100644
index 0000000..7e167c1
--- /dev/null
+++ b/app/models/authentication_code.rb
@@ -0,0 +1,60 @@
+class AuthenticationCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRES_IN = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+
+  before_validation :generate_code, :set_expiry, on: :create
+
+  scope :valid, -> { where("expires_at > ?", Time.current) }
+
+  def self.generate_for(email_address)
+    normalized = email_address.to_s.strip.downcase
+    where(email_address: normalized).delete_all
+    create!(email_address: normalized)
+  end
+
+  def self.verify(email_address, code)
+    normalized_email = email_address.to_s.strip.downcase
+    normalized_code = code.to_s.strip.upcase
+
+    return nil if normalized_email.blank? || normalized_code.blank?
+
+    record = valid.where(email_address: normalized_email).order(created_at: :desc).find do |candidate|
+      candidate.code.to_s.upcase == normalized_code
+    end
+
+    if record
+      record.destroy!
+      record
+    end
+  end
+
+  def self.valid_code?(email_address, code)
+    verify(email_address, code).present?
+  end
+
+  def deliver
+    if ActiveJob::Base.queue_adapter.is_a?(ActiveJob::QueueAdapters::TestAdapter)
+      AuthenticationMailer.email_code(email_address, code).deliver_now
+    else
+      AuthenticationMailer.email_code(email_address, code).deliver_later
+    end
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  private
+    def generate_code
+      self.code ||= SecureRandom.random_number(100_000..999_999).to_s
+    end
+
+    def set_expiry
+      self.expires_at ||= EXPIRES_IN.from_now
+    end
+end
