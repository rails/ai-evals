+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p class="txt-medium">We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to join <%= @join_code.account.name %>.</p>
+
+  <%= form_with url: join_code_path(join_code: @join_code.code, script_name: @join_code.account.slug), class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+    <%= form.hidden_field :email_address, value: @email_address %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your code…", maxlength: 6, minlength: 6 %>
+      </label>
+    </div>
+
+    <% if @development_code.present? %>
+      <p class="txt-small txt-subtle">Psst, here's your code: <strong><%= @development_code %></strong></p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Join</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
