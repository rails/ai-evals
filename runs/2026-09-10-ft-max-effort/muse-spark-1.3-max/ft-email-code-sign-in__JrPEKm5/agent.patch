+class Signups::CodesController < ApplicationController
+  wrap_parameters :signup, include: %i[ email_address ]
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_signup_path, alert: "Try again later." }
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def new
+    @email_address = params[:email_address].presence || params.dig(:signup, :email_address).presence || session[:pending_email_address]
+
+    if @email_address.blank?
+      redirect_to new_signup_path
+    else
+      @signup = Signup.new(email_address: @email_address)
+      @development_code = AuthenticationCode.valid.where(email_address: @email_address.to_s.strip.downcase).order(created_at: :desc).first&.code if Rails.env.development?
+    end
+  end
+
+  def create
+    email_address = params[:email_address].presence || params.dig(:signup, :email_address).presence || session[:pending_email_address]
+    email_address = email_address.to_s.strip.downcase.presence
+    code = params[:code].presence || params.dig(:signup, :code)
+
+    if email_address.present? && AuthenticationCode.verify(email_address, code)
+      signup = Signup.new(email_address: email_address)
+      identity = signup.create_identity
+      start_new_session_for identity
+      session.delete(:pending_email_address)
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_signup_code_path(email_address: email_address), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+end
