new file mode 100644
index 0000000..fd5c82d
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,54 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @push_subscription.assign_attributes(subscription_params)
+
+    if @push_subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled for this device" }
+        format.json { head :created }
+        format.any { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: "Could not enable push notifications" }
+        format.json { render json: @push_subscription.errors, status: :unprocessable_entity }
+        format.any { head :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @push_subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:id])
+
+    @push_subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled for this device" }
+      format.json { head :no_content }
+      format.any { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      raw = params.require(:push_subscription).permit(:endpoint, :p256dh_key, :auth_key, keys: [ :p256dh, :auth ])
+      {
+        endpoint: raw[:endpoint],
+        p256dh_key: raw[:p256dh_key] || raw.dig(:keys, :p256dh),
+        auth_key: raw[:auth_key] || raw.dig(:keys, :auth)
+      }
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..5d61740
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,109 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  async connect() {
+    if (await this.isSubscribed()) {
+      this.element.classList.add("notifications--on")
+      this.hideHelp()
+    } else {
+      this.element.classList.remove("notifications--on")
+
+      if (!this.pushSupported || Notification.permission === "denied") {
+        this.showHelp()
+      } else {
+        this.hideHelp()
+      }
+    }
+  }
+
+  async enable(event) {
+    event?.preventDefault()
+
+    if (!this.pushSupported) {
+      this.showHelp()
+      return
+    }
+
+    if (!this.vapidPublicKeyValue) return
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.showHelp()
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.urlBase64ToUint8Array(this.vapidPublicKeyValue)
+      })
+    }
+
+    const json = subscription.toJSON()
+
+    const response = await post(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      this.element.classList.add("notifications--on")
+      this.hideHelp()
+    } else {
+      this.showHelp()
+    }
+  }
+
+  get pushSupported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async isSubscribed() {
+    try {
+      if (!this.pushSupported) return false
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+      return !!subscription
+    } catch {
+      return false
+    }
+  }
+
+  showHelp() {
+    this.detailsTargets.forEach((el) => el.hidden = false)
+  }
+
+  hideHelp() {
+    this.detailsTargets.forEach((el) => el.hidden = true)
+  }
+
+  urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
