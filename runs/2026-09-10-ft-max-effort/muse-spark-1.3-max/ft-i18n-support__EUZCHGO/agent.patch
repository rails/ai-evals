@@ -13,4 +13,50 @@ class ApplicationMailer < ActionMailer::Base
         super
       end
     end
+
+    def mail(headers = {}, &block)
+      I18n.with_locale(recipient_locale) do
+        super
+      end
+    end
+
+    def recipient_locale
+      locale = nil
+
+      if defined?(@user) && @user
+        locale = @user.try(:preferred_locale) || @user.try(:settings)&.try(:locale) || @user.try(:identity)&.try(:locale)
+      end
+
+      if locale.blank? && defined?(@identity) && @identity
+        locale = @identity.try(:preferred_locale) || @identity.try(:locale)
+      end
+
+      if locale.blank? && defined?(@bundle) && @bundle
+        user = @bundle.try(:user)
+        locale = user&.preferred_locale if user
+      end
+
+      if locale.blank? && defined?(@export) && @export
+        user = @export.try(:user)
+        locale = user&.preferred_locale if user
+      end
+
+      if locale.blank? && defined?(@import) && @import
+        identity = @import.try(:identity)
+        locale = identity&.preferred_locale if identity
+      end
+
+      # For ImportMailer#completed which receives identity as param but stores only @account,
+      # try to infer from @account? No, fallback to default. Caller should set @identity.
+      if locale.blank? && defined?(@account) && @account && @account.is_a?(Account) && @account.users.one?
+        # Single-user account import? Try first user
+      end
+
+      locale = locale.to_s if locale
+      if locale.present? && I18n.available_locales.map(&:to_s).include?(locale.to_s)
+        locale.to_s
+      else
+        I18n.default_locale.to_s
+      end
+    end
 end
