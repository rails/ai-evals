diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..0e3b450
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,160 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :with_locale
+    after_action :sync_locale_after_action
+    helper_method :current_locale
+
+    etag { I18n.locale.to_s }
+  end
+
+  private
+    def with_locale(&action)
+      requested = valid_locale_param
+      if requested
+        session[:locale] = requested
+        persist_locale_to_records(requested)
+        I18n.with_locale(requested, &action)
+      else
+        stored = valid_stored_locale
+        # If session has locale and user is authenticated, sync it to DB so
+        # a choice made before signing in persists for next clean-browser sign-in.
+        if session[:locale].present? && valid_locale?(session[:locale]) && authenticated_for_locale?
+          persist_locale_to_records(session[:locale].to_s) if stored == session[:locale].to_s && db_locale != session[:locale].to_s
+        elsif session[:locale].blank? && db_locale.present?
+          # Restore DB choice into session for authenticated users (clean browser sign-in)
+          session[:locale] = db_locale
+        end
+        I18n.with_locale(stored, &action)
+      end
+    end
+
+    def sync_locale_after_action
+      # Handle sign-in during this request: Current.identity may have been set
+      # after with_locale ran (e.g., magic link consumption). Sync session<->DB.
+      return unless authenticated_for_locale?
+      begin
+        if session[:locale].present? && valid_locale?(session[:locale])
+          persist_locale_to_records(session[:locale].to_s) if db_locale != session[:locale].to_s
+        elsif session[:locale].blank? && db_locale.present?
+          session[:locale] = db_locale
+        end
+      rescue StandardError
+      end
+    end
+
+    def current_locale
+      I18n.locale
+    end
+
+    def valid_locale_param
+      locale = params[:locale]
+      return nil if locale.blank?
+      locale_str = locale.to_s
+      valid_locale?(locale_str) ? locale_str : nil
+    end
+
+    def valid_stored_locale
+      candidates = [ session[:locale], db_locale, I18n.default_locale.to_s ]
+      candidates.each do |candidate|
+        return candidate.to_s if candidate.present? && valid_locale?(candidate)
+      end
+      I18n.default_locale.to_s
+    end
+
+    def valid_locale?(locale)
+      I18n.available_locales.map(&:to_s).include?(locale.to_s)
+    end
+
+    def db_locale
+      # Prefer user settings locale, fall back to identity locale
+      begin
+        user_locale = Current.user&.settings&.locale
+        return user_locale.to_s if user_locale.present? && valid_locale?(user_locale)
+      rescue StandardError
+      end
+      begin
+        identity_locale = Current.identity&.locale
+        return identity_locale.to_s if identity_locale.present? && valid_locale?(identity_locale)
+      rescue StandardError
+      end
+      nil
+    end
+
+    def authenticated_for_locale?
+      Current.identity.present?
+    end
+
+    def persist_locale_to_records(locale)
+      return unless authenticated_for_locale?
+      locale_str = locale.to_s
+      return unless valid_locale?(locale_str)
+
+      begin
+        identity = Current.identity
+        if identity && identity.respond_to?(:locale) && identity.locale != locale_str
+          identity.update_column(:locale, locale_str)
+        end
+      rescue StandardError
+        # Ignore persistence failures
+      end
+
+      begin
+        settings = Current.user&.settings
+        if settings && settings.respond_to?(:locale) && settings.locale != locale_str
+          settings.update_column(:locale, locale_str)
+        end
+      rescue StandardError
+        # Ignore
+      end
+
+      # Also sync all other user settings for this identity so the choice
+      # sticks across accounts
+      begin
+        if Current.identity
+          Current.identity.users.includes(:settings).each do |user|
+            s = user.settings
+            if s && s.respond_to?(:locale) && s.locale != locale_str
+              s.update_column(:locale, locale_str)
+            end
+          rescue StandardError
+            next
+          end
+        end
+      rescue StandardError
+      end
+    end
+
+    def sync_session_locale_to_identity(identity)
+      return identity unless identity && identity.persisted?
+      session_locale = session[:locale]
+      if session_locale.present? && valid_locale?(session_locale)
+        begin
+          if identity.respond_to?(:locale) && identity.locale != session_locale.to_s
+            identity.update_column(:locale, session_locale.to_s)
+          end
+          # Also sync to all user settings for this identity
+          identity.users.includes(:settings).each do |user|
+            s = user.settings
+            if s && s.respond_to?(:locale) && s.locale != session_locale.to_s
+              s.update_column(:locale, session_locale.to_s)
+            end
+          rescue StandardError
+            next
+          end
+        rescue StandardError
+        end
+      elsif I18n.locale.to_s != I18n.default_locale.to_s && valid_locale?(I18n.locale)
+        # Fallback: if request locale is non-default but session empty (shouldn't happen),
+        # still sync
+        begin
+          if identity.respond_to?(:locale) && identity.locale != I18n.locale.to_s
+            identity.update_column(:locale, I18n.locale.to_s)
+          end
+        rescue StandardError
+        end
+      end
+      identity
+    end
+end
