diff --git a/app/views/notifications/settings/_email_digests.html.erb b/app/views/notifications/settings/_email_digests.html.erb
new file mode 100644
index 0000000..0bc35d8
--- /dev/null
+++ b/app/views/notifications/settings/_email_digests.html.erb
@@ -0,0 +1,23 @@
+<section class="settings__section">
+  <h2 class="divider">Email digests</h2>
+  <p class="txt-small">Batch your notifications into one email per time window.</p>
+  <%= form_with model: Current.user.settings, url: notifications_settings_path, method: :put, scope: :user_settings, class: "flex flex-column gap-half" do |form| %>
+    <label class="flex gap-half">
+      <%= form.radio_button :bundle_email_frequency, "never" %>
+      <span>Off — never send digest emails</span>
+    </label>
+    <label class="flex gap-half">
+      <%= form.radio_button :bundle_email_frequency, "every_few_hours" %>
+      <span>Every four hours</span>
+    </label>
+    <label class="flex gap-half">
+      <%= form.radio_button :bundle_email_frequency, "daily" %>
+      <span>Daily</span>
+    </label>
+    <label class="flex gap-half">
+      <%= form.radio_button :bundle_email_frequency, "weekly" %>
+      <span>Weekly</span>
+    </label>
+    <%= form.submit "Save", class: "btn" %>
+  <% end %>
+</section>
