+
+  alias digest notification_digest
+  alias bundle notification_digest
+  alias email_bundle notification_digest
+  alias email_digest notification_digest
+
+  private
+    def digest_subject
+      count = @notifications.sum { |n| n.unread_count.presence || 1 }
+      count = @notifications.size if count.zero?
+      if count == 1
