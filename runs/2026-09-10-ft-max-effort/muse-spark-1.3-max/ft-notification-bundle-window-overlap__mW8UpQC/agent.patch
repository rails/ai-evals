new file mode 100644
index 0000000..49e9f7f
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,28 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.ordered.to_a
+
+    Current.account = @account
+
+    mail to: @user.identity.email_address, subject: digest_subject
+  end
+
+  alias bundle digest
+  alias email_bundle digest
+  alias email_digest digest
+  alias notification_digest digest
+
+  private
+    def digest_subject
+      count = @notifications.sum { |n| n.unread_count.presence || 1 }
+      count = @notifications.size if count.zero?
+      if count == 1
+        "You have 1 new notification"
+      else
+        "You have #{count} new notifications"
+      end
+    end
+end
