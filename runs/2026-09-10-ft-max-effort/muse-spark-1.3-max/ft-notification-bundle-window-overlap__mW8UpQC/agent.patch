diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..7cbe0bc
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,221 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, foreign_key: "notification_bundle_id", dependent: :nullify, inverse_of: :bundle
+
+  alias_attribute :window_starts_at, :starts_at
+  alias_attribute :window_ends_at, :ends_at
+  alias_attribute :window_start, :starts_at
+  alias_attribute :window_end, :ends_at
+  alias_attribute :started_at, :starts_at
+  alias_attribute :opened_at, :starts_at
+  alias_attribute :closes_at, :ends_at
+  alias_attribute :close_at, :ends_at
+  alias_attribute :delivered_at, :sent_at
+  alias_attribute :emailed_at, :sent_at
+
+  scope :unsent, -> { where(sent_at: nil) }
+  scope :sent, -> { where.not(sent_at: nil) }
+  scope :due, -> { unsent.where("ends_at <= ?", Time.current) }
+  scope :open, -> { unsent.where("starts_at <= ? AND ends_at > ?", Time.current, Time.current) }
+  scope :ordered, -> { order(starts_at: :asc) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_starts
+  validate :no_overlapping_windows
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def for(user, at: nil)
+      user = resolve_user(user)
+      return nil if user.nil?
+
+      now = Time.current
+      at_time = at || now
+      at_time = at_time.created_at if at_time.respond_to?(:created_at) && !at_time.is_a?(Time) && !at_time.is_a?(DateTime) && !at_time.is_a?(ActiveSupport::TimeWithZone)
+      at_time = at_time.to_time if at_time.respond_to?(:to_time) && !at_time.is_a?(Time) && !at_time.is_a?(ActiveSupport::TimeWithZone)
+
+      user.with_lock do
+        settings = User::Settings.find_by(user_id: user.id)
+        return nil if settings.nil?
+
+        duration = settings.bundle_window_duration
+        return nil if duration.nil?
+
+        open_bundle = for_user(user).unsent.where("starts_at <= ? AND ends_at > ?", now, now).ordered.first
+        return open_bundle if open_bundle
+
+        if at_time
+          containing = for_user(user).unsent.where("starts_at <= ? AND ends_at > ?", at_time, at_time).ordered.first
+          return containing if containing
+
+          overlapping_unsent = for_user(user).unsent.where("starts_at < ? AND ends_at > ?", now + duration, now).ordered.first
+          return overlapping_unsent if overlapping_unsent
+        end
+
+        starts_at = now
+        latest_ends_at = for_user(user).maximum(:ends_at)
+        if latest_ends_at && latest_ends_at > starts_at
+          starts_at = latest_ends_at
+        end
+        ends_at = starts_at + duration
+
+        overlapping = for_user(user).where("starts_at < ? AND ends_at > ?", ends_at, starts_at).ordered.first
+        if overlapping
+          return overlapping if overlapping.sent_at.nil?
+          starts_at = [ starts_at, overlapping.ends_at ].max
+          ends_at = starts_at + duration
+        end
+
+        create!(account: user.account, user: user, starts_at: starts_at, ends_at: ends_at)
+      end
+    rescue ActiveRecord::RecordInvalid => e
+      if e.record&.errors&.added?(:starts_at, :overlapping) || e.record&.errors&.added?(:base, :overlapping)
+        for_user(user).where("starts_at <= ? AND ends_at > ?", now, now).ordered.first ||
+          for_user(user).unsent.where("starts_at <= ? AND ends_at > ?", at_time, at_time).ordered.first
+      else
+        raise
+      end
+    end
+
+    def for_notification(notification)
+      return nil if notification.nil?
+      user = notification.user
+      at = Time.current
+      bundle = self.for(user, at: at)
+      if bundle && notification.notification_bundle_id != bundle.id
+        notification.update_columns(notification_bundle_id: bundle.id)
+      end
+      bundle
+    end
+
+    def deliver_due
+      due.find_each(&:deliver)
+    end
+
+    def for_user(user)
+      user_id = user.is_a?(User) ? user.id : user
+      where(user_id: user_id)
+    end
+
+    alias window_for for
+    alias open_for for
+    alias find_or_create_for for
+    alias bundle_for for_notification
+    alias for_user_at for
+
+    private
+      def resolve_user(user)
+        case user
+        when User then user
+        when User::Settings then user.user
+        when String, Integer then User.find_by(id: user)
+        else
+          if user.respond_to?(:user) && user.user.is_a?(User)
+            user.user
+          elsif user.respond_to?(:settings) && user.settings.is_a?(User::Settings)
+            user
+          else
+            nil
+          end
+        end
+      end
+  end
+
+  def contains?(time)
+    time = time.created_at if time.respond_to?(:created_at) && !time.is_a?(Time) && !time.is_a?(DateTime) && !time.is_a?(ActiveSupport::TimeWithZone)
+    starts_at <= time && time < ends_at
+  end
+
+  alias window_for? contains?
+  alias cover? contains?
+
+  def open?(at: Time.current)
+    sent_at.nil? && starts_at <= at && at < ends_at
+  end
+
+  def due?(at: Time.current)
+    sent_at.nil? && ends_at <= at
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  alias delivered? sent?
+  alias emailed? sent?
+  alias closed? sent?
+
+  def empty?
+    notifications.empty?
+  end
+
+  def deliver
+    return false if sent?
+    return false unless deliverable?
+
+    transaction do
+      lock!
+      return false if sent?
+
+      fresh_notifications = notifications.reload.to_a
+      if fresh_notifications.empty?
+        update!(sent_at: Time.current)
+        return true
+      end
+
+      NotificationMailer.digest(self).deliver_now
+      update!(sent_at: Time.current)
+      true
+    end
+  end
+
+  def deliver_later(wait_until: nil)
+    if wait_until
+      Notification::BundleDeliveryJob.set(wait_until: wait_until).perform_later(self)
+    else
+      Notification::BundleDeliveryJob.perform_later(self)
+    end
+  end
+
+  alias deliver_now deliver
+  alias send_now deliver
+  alias send_digest deliver
+
+  def deliverable?
+    fresh_user = User.find_by(id: user_id)
+    fresh_account = Account.find_by(id: account_id)
+    fresh_settings = User::Settings.find_by(user_id: user_id)
+    fresh_user&.active? && fresh_account&.active? && fresh_settings&.bundle_emails_enabled?
+  end
+
+  private
+    def ends_after_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def no_overlapping_windows
+      return if user_id.blank? || starts_at.blank? || ends_at.blank?
+
+      overlapping = self.class.where(user_id: user_id)
+        .where.not(id: id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+      if overlapping.exists?
+        errors.add(:starts_at, :overlapping, message: "overlaps another window for this user")
+        errors.add(:base, :overlapping, message: "overlaps another window for this user")
+      end
+    end
+
+    def schedule_delivery
+      return if sent?
+      return unless ends_at > Time.current
+
+      Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+    rescue StandardError
+      nil
+    end
+end
