diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..700a072 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,39 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    if incineration_due?
+      destroy!
+      purge_residual_data
+    end
+  end
+
+  def incineration_due?
+    cancelled? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    # Cascading destroys handle most account data, but a few records survive:
+    # storage ledger entries have no dependent destroy, and blobs are purged
+    # asynchronously, so remove them explicitly to leave no trace.
+    def purge_residual_data
+      Storage::Entry.where(account_id: id).delete_all
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActionText::RichText.where(account_id: id).delete_all
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy)
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+      ActiveStorage::VariantRecord.where(account_id: id).delete_all
+    end
 end
