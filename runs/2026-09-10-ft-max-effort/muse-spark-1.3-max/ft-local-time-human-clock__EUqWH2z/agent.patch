diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..724f7b4 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,62 @@
 module TimeHelper
+  def local_time_tag(time, format: :relative, **options)
+    return "" if time.blank?
+
+    utc_time = time.utc
+    datetime = utc_time.iso8601
+    fallback = local_time_fallback(utc_time, format)
+
+    user_data = options.delete(:data) || {}
+    # Preserve any existing controller, appending ours
+    existing_controller = user_data[:controller] || user_data["controller"]
+    controllers = [ existing_controller, "time" ].compact.join(" ").split.uniq.join(" ")
+
+    data = user_data.merge(
+      controller: controllers,
+      time_format_value: format.to_s,
+      local: format.to_s,
+      format: format.to_s
+    )
+
+    css_class = [ "local-time-value", options.delete(:class) ].compact.join(" ").strip
+
+    tag.time(fallback, datetime: datetime, class: css_class.presence, data: data, **options)
+  end
+
+  # Convenience aliases so views can use whichever reads best.
+  # All route through local_time_tag and emit the same shareable markup.
+  def relative_time_tag(time, **options)
+    local_time_tag(time, format: :relative, **options)
+  end
+
+  def date_time_tag(time, format: :relative, **options)
+    local_time_tag(time, format: format, **options)
+  end
+
+  def local_time(time, format: :relative, **options)
+    local_time_tag(time, format: format, **options)
+  end
+
+  private
+    # Fallback rendered on the server in UTC so HTML is identical for
+    # everyone (shareable caches) and sensible without JavaScript.
+    # The browser replaces it with the viewer's local words.
+    def local_time_fallback(utc_time, format)
+      case format.to_sym
+      when :relative
+        utc_time.strftime("%b %-d")
+      when :date
+        utc_time.strftime("%b %-d")
+      when :full_date
+        utc_time.strftime("%b %d, %Y")
+      when :time
+        utc_time.strftime("%l:%M %p").strip
+      when :datetime, :short_datetime
+        utc_time.strftime("%-m/%-d/%y, %l:%M %p").strip
+      when :weekday_date
+        utc_time.strftime("%A, %B %-d")
+      else
+        utc_time.strftime("%b %-d")
+      end
+    end
 end
