diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..0fd1070
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,70 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatWithStyle, formatFullDatetime, formatFullDate } from "helpers/date_helpers"
+
+// Renders a server-provided timestamp in the viewer's own timezone.
+//
+// The server emits shareable markup:
+//
+//   <time datetime="2025-09-12T13:42:00Z" data-controller="time" data-time-format-value="relative">Sep 12</time>
+//
+// and this controller turns it into local words:
+//
+//   today      -> "1:42 PM"
+//   yesterday  -> "yesterday"
+//   5 days ago -> "5 days ago" (or "Sep 12" for date formats)
+//   tomorrow   -> "tomorrow"
+//   in 3 days  -> "in 3 days"
+//
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const datetime = this.element.getAttribute("datetime") || this.element.dataset.datetime
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date.getTime())) return
+
+    const text = formatWithStyle(date, this.#style, new Date())
+    if (text) this.element.textContent = text
+
+    try {
+      this.element.setAttribute("title", formatFullDatetime(date))
+    } catch {
+      // ignore title failures
+    }
+
+    this.#syncBridgeDescription(date)
+  }
+
+  get #style() {
+    if (this.hasFormatValue && this.formatValue) return this.formatValue
+    return this.element.getAttribute("data-local") ||
+      this.element.getAttribute("data-format") ||
+      this.element.dataset.format ||
+      "relative"
+  }
+
+  // Keep native bridge descriptions in the viewer's timezone too. The server
+  // renders them in UTC for shareable caches; when the visible <time> inside
+  // a stamp renders locally, mirror the local date onto the ancestor so the
+  // native side receives the viewer's words.
+  #syncBridgeDescription(date) {
+    const stamped = this.element.closest("[data-bridge-description]")
+    if (!stamped) return
+
+    try {
+      stamped.setAttribute("data-bridge-description", formatFullDate(date))
+    } catch {
+      // leave server value; browser rendering is still correct
+    }
+  }
+}
diff --git a/app/javascript/controllers/timezone_sync_controller.js b/app/javascript/controllers/timezone_sync_controller.js
new file mode 100644
index 0000000..1a668fb
--- /dev/null
+++ b/app/javascript/controllers/timezone_sync_controller.js
@@ -0,0 +1,22 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Keeps the user's stored timezone (used for emails) in sync with the
+// browser's timezone without baking the cookie into shareable HTML.
+//
+// The server renders the user's current timezone; the browser compares it
+// to its own and submits only when they differ.
+export default class extends Controller {
+  static values = { userTimezone: String }
+  static targets = [ "input" ]
+
+  connect() {
+    const browserTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+
+    if (browserTimezone && browserTimezone !== this.userTimezoneValue) {
+      this.inputTarget.value = browserTimezone
+      this.element.requestSubmit()
+    } else {
+      this.element.remove()
+    }
+  }
+}
