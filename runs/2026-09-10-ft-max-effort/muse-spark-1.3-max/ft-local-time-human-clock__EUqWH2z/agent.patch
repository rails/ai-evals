diff --git a/app/javascript/initializers/time.js b/app/javascript/initializers/time.js
new file mode 100644
index 0000000..2da1c5c
--- /dev/null
+++ b/app/javascript/initializers/time.js
@@ -0,0 +1,63 @@
+import { formatWithStyle, formatFullDatetime } from "helpers/date_helpers"
+
+// Fallback formatter for any <time datetime="..."> in the page, even without
+// a Stimulus controller. The primary path is the `time` controller, but this
+// ensures server-sent timestamps always become viewer-local words, including
+// content added via Turbo Streams/Morph before controllers connect.
+function formatTimeElement(element) {
+  // Skip if a Stimulus time controller will handle it (it sets title already)
+  // Still format to be safe; rendering is idempotent.
+  const datetime = element.getAttribute("datetime") || element.dataset.datetime
+  if (!datetime) return
+
+  const date = new Date(datetime)
+  if (isNaN(date.getTime())) return
+
+  const style = element.getAttribute("data-time-format-value") ||
+    element.getAttribute("data-local") ||
+    element.getAttribute("data-format") ||
+    element.dataset.format ||
+    "relative"
+
+  try {
+    const text = formatWithStyle(date, style, new Date())
+    if (text) element.textContent = text
+    element.setAttribute("title", formatFullDatetime(date))
+  } catch {
+    // ignore
+  }
+}
+
+function formatAllTimes(root = document) {
+  root.querySelectorAll("time[datetime]").forEach(formatTimeElement)
+}
+
+document.addEventListener("DOMContentLoaded", () => formatAllTimes())
+document.addEventListener("turbo:load", () => formatAllTimes())
+document.addEventListener("turbo:render", () => formatAllTimes())
+document.addEventListener("turbo:morph", () => formatAllTimes())
+document.addEventListener("turbo:frame-load", (event) => formatAllTimes(event.target))
+
+// Observe for dynamically added <time> elements (Turbo Streams, morphs)
+if (typeof MutationObserver !== "undefined") {
+  const observer = new MutationObserver((mutations) => {
+    for (const mutation of mutations) {
+      for (const node of mutation.addedNodes) {
+        if (node.nodeType !== 1) continue
+        if (node.matches?.("time[datetime]")) formatTimeElement(node)
+        node.querySelectorAll?.("time[datetime]").forEach(formatTimeElement)
+      }
+      if (mutation.type === "attributes" && mutation.target.matches?.("time[datetime]")) {
+        formatTimeElement(mutation.target)
+      }
+    }
+  })
+
+  const startObserving = () => observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: [ "datetime", "data-time-format-value", "data-local", "data-format" ] })
+  if (document.body) startObserving()
+  else document.addEventListener("DOMContentLoaded", startObserving)
+}
+
+// Re-render times periodically so day boundaries stay fresh
+// (e.g., "1:42 PM" becomes "yesterday" after midnight).
+setInterval(() => formatAllTimes(), 60_000)
