diff --git a/app/models/verification_code.rb b/app/models/verification_code.rb
new file mode 100644
index 0000000..090a8d1
--- /dev/null
+++ b/app/models/verification_code.rb
@@ -0,0 +1,55 @@
+class VerificationCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+  validates :expires_at, presence: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+  before_validation :set_expires_at, on: :create, if: -> { expires_at.blank? }
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+  scope :expired, -> { where("expires_at <= ?", Time.current) }
+
+  def self.generate_for(email_address)
+    normalized_email = email_address.to_s.strip.downcase
+
+    create!(email_address: normalized_email).tap do |record|
+      Rails.logger.info "Verification code for #{normalized_email}: #{record.code}"
+    end
+  end
+
+  def self.authenticate(email_address, code)
+    normalized_email = email_address.to_s.strip.downcase
+    normalized_code = code.to_s.strip.upcase
+    return nil if normalized_email.blank? || normalized_code.blank?
+
+    record = active.find_by(email_address: normalized_email, code: normalized_code)
+
+    if record
+      where(email_address: normalized_email).delete_all
+      record
+    end
+  end
+
+  def self.cleanup
+    expired.where("created_at < ?", 1.day.ago).delete_all
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def set_expires_at
+      self.expires_at = LIFETIME.from_now
+    end
+end
