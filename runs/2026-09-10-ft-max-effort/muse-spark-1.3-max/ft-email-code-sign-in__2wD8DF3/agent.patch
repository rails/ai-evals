+class Sessions::VerificationsController < ApplicationController
+  wrap_parameters :session, include: %i[ email_address code ]
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @email_address = params[:email_address].presence || params.dig(:session, :email_address).presence || session[:session_verification_email]
+
+    if @email_address.blank?
+      redirect_to new_session_path
+    else
+      session[:session_verification_email] = @email_address
+
+      if Rails.env.development?
+        @verification_code = VerificationCode.active.where(email_address: @email_address.strip.downcase).order(created_at: :desc).first
+      end
+    end
+  end
+
+  def create
+    email_address = params[:email_address].presence || params.dig(:session, :email_address).presence || session[:session_verification_email]
+    code = params[:code].presence || params.dig(:session, :code).presence
+
+    if email_address.present? && code.present? && VerificationCode.authenticate(email_address, code)
+      identity = Identity.find_or_create_by!(email_address: email_address.strip.downcase)
+      start_new_session_for identity
+      session.delete(:session_verification_email)
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_verification_path(email_address: email_address), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_verification_path(email_address: params[:email_address].presence || params.dig(:session, :email_address).presence || session[:session_verification_email]), alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
