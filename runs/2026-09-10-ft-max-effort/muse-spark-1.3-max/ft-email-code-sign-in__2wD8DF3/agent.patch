@@ -0,0 +1,30 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>We sent a 6-character code to <strong><%= @email_address %></strong>. Enter it below to join <%= @join_code.account.name %>.</p>
+
+  <%= form_with url: join_verification_path(join_code: @join_code.code), class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.hidden_field :email_address, value: @email_address %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your 6-character code…", maxlength: 6, minlength: 6 %>
+      </label>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Verify</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
