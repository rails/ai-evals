+class JoinCodes::VerificationsController < ApplicationController
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @email_address = params[:email_address].presence || session[:join_verification_email]
+
+    if @email_address.blank?
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug)
+    else
+      session[:join_verification_email] = @email_address
+
+      if Rails.env.development?
+        @verification_code = VerificationCode.active.where(email_address: @email_address.strip.downcase).order(created_at: :desc).first
+      end
+    end
+  end
+
+  def create
+    email_address = params[:email_address].presence || session[:join_verification_email]
+    code = params[:code]
+
+    if email_address.present? && code.present? && VerificationCode.authenticate(email_address, code)
+      identity = Identity.find_or_create_by!(email_address: email_address.strip.downcase)
+      start_new_session_for identity unless Current.identity == identity
+      session.delete(:join_verification_email)
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { message: "Joined" }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_join_verification_path(join_code: @join_code.code, script_name: @join_code.account.slug, email_address: email_address), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: params.expect(:join_code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render :"join_codes/inactive", status: :gone
+      end
+    end
+end
