+class Signups::VerificationsController < ApplicationController
+  wrap_parameters :signup, include: %i[ email_address code ]
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_signup_path, alert: "Try again later." }
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def new
+    @email_address = params[:email_address].presence || params.dig(:signup, :email_address).presence || session[:signup_verification_email]
+
+    if @email_address.blank?
+      redirect_to new_signup_path
+    else
+      session[:signup_verification_email] = @email_address
+
+      if Rails.env.development?
+        @verification_code = VerificationCode.active.where(email_address: @email_address.strip.downcase).order(created_at: :desc).first
+      end
+    end
+  end
+
+  def create
+    email_address = params[:email_address].presence || params.dig(:signup, :email_address).presence || session[:signup_verification_email]
+    code = params[:code].presence || params.dig(:signup, :code).presence
+
+    if email_address.present? && code.present? && VerificationCode.authenticate(email_address, code)
+      identity = Identity.find_or_create_by!(email_address: email_address.strip.downcase)
+      start_new_session_for identity
+      session.delete(:signup_verification_email)
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_signup_verification_path(email_address: email_address), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+end
