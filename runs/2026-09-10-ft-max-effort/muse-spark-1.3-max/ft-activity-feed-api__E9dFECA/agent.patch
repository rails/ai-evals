new file mode 100644
index 0000000..213e219
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,47 @@
+class ActivitiesController < ApplicationController
+  ACTIVITIES_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ]
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities_scope
+      end
+    end
+  end
+
+  private
+    def activities_scope
+      scope = Event.preloaded.where(board: boards_scope).where(action: ACTIVITIES_ACTIONS).order(created_at: :desc, id: :desc)
+      scope = scope.where(creator_id: creator_ids) if creator_ids.any?
+      scope
+    end
+
+    def boards_scope
+      if board_ids.any?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).reject(&:blank?)
+    end
+
+    def board_ids
+      Array(params[:board_ids]).reject(&:blank?)
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..5a34dcb
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,22 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    case event.action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(event.assignee_ids) }
+    when "card_board_changed"
+      {
+        old_board: event.particulars.dig("particulars", "old_board") || "",
+        new_board: event.particulars.dig("particulars", "new_board") || ""
+      }
+    when "card_title_changed"
+      {
+        old_title: event.particulars.dig("particulars", "old_title") || "",
+        new_title: event.particulars.dig("particulars", "new_title") || ""
+      }
+    when "card_triaged"
+      { column: event.particulars.dig("particulars", "column") || "" }
+    else
+      {}
+    end
+  end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..4503969
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,17 @@
+json.(event, :id, :action, :eventable_type)
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text.to_s
+json.particulars activity_particulars(event)
+json.url polymorphic_url(event.eventable)
+
+json.eventable do
+  case event.eventable
+  when Card
+    json.partial! "cards/card", card: event.eventable
+  when Comment
+    json.partial! "cards/comments/comment", comment: event.eventable
+  end
+end
+
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
