diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3c4525d
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,277 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  connect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  disconnect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  dragstart(event) {
+    const item = event.currentTarget
+    if (!item) return
+
+    this.draggedItem = item
+    this.sourceContainer = item.closest('[data-drag-and-drop-target="container"]')
+
+    item.classList.add("drag-and-drop__dragged-item")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", item.id || "card")
+      } catch {
+        // Some browsers restrict setData; dragging still works without it
+      }
+    }
+  }
+
+  dragend(event) {
+    this.#clearDragState()
+  }
+
+  dragenter(event) {
+    const container = event.currentTarget
+    if (!this.draggedItem || !container) return
+    if (container === this.sourceContainer) return
+
+    event.preventDefault()
+    container.classList.add("drag-and-drop__hover-container")
+  }
+
+  dragover(event) {
+    const container = event.currentTarget
+    if (!this.draggedItem || !container) return
+    if (container === this.sourceContainer) return
+
+    // Must preventDefault to signal that dropping is allowed
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+    container.classList.add("drag-and-drop__hover-container")
+  }
+
+  dragleave(event) {
+    const container = event.currentTarget
+    if (!container) return
+
+    // Only remove when truly leaving the container, not moving between children
+    if (event.relatedTarget && container.contains(event.relatedTarget)) return
+
+    container.classList.remove("drag-and-drop__hover-container")
+  }
+
+  async drop(event) {
+    const targetContainer = event.currentTarget
+    if (!targetContainer) return
+
+    event.preventDefault()
+    event.stopPropagation()
+
+    targetContainer.classList.remove("drag-and-drop__hover-container")
+
+    const item = this.draggedItem
+    const sourceContainer = this.sourceContainer
+
+    if (!item || !sourceContainer) return
+    if (targetContainer === sourceContainer) return
+
+    // Capture original position for potential revert
+    const sourceList = sourceContainer.querySelector(".cards__list")
+    const originalNextSibling = item.nextSibling
+    const originalParent = item.parentNode
+
+    // Optimistic move: the board is already the way you left it, no waiting on the save
+    this.#moveCard(item, sourceContainer, targetContainer)
+    item.classList.remove("drag-and-drop__dragged-item")
+
+    // Clear drag state immediately so subsequent drags work even while saving
+    const draggedItem = item
+    const source = sourceContainer
+    const target = targetContainer
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.#clearHoverContainers(target)
+
+    try {
+      await this.#saveMove(draggedItem, target)
+    } catch (error) {
+      // Revert optimistic move on failure so UI matches server truth
+      this.#revertMove(draggedItem, source, target, originalParent, originalNextSibling)
+    }
+  }
+
+  // Private
+
+  #moveCard(item, sourceContainer, targetContainer) {
+    const targetList = targetContainer.querySelector(".cards__list")
+    if (targetList) {
+      // Columns keep their own order: new cards go to the top (matching server's
+      // latest-first ordering), never inserted at an arbitrary position.
+      // Respect golden-first ordering: non-golden cards go after any golden cards.
+      if (!item.classList.contains("golden-effect")) {
+        const goldenCards = targetList.querySelectorAll(".card.golden-effect")
+        if (goldenCards.length > 0) {
+          goldenCards[goldenCards.length - 1].after(item)
+        } else {
+          targetList.prepend(item)
+        }
+      } else {
+        targetList.prepend(item)
+      }
+    } else {
+      targetContainer.prepend(item)
+    }
+
+    this.#updateCounts(sourceContainer, targetContainer)
+  }
+
+  #revertMove(item, sourceContainer, targetContainer, originalParent, originalNextSibling) {
+    if (originalParent && originalParent.isConnected) {
+      originalParent.insertBefore(item, originalNextSibling)
+    } else {
+      const sourceList = sourceContainer.querySelector(".cards__list")
+      if (sourceList) {
+        sourceList.prepend(item)
+      } else {
+        sourceContainer.prepend(item)
+      }
+    }
+
+    this.#updateCounts(targetContainer, sourceContainer)
+  }
+
+  #updateCounts(sourceContainer, targetContainer) {
+    this.#decrementCount(sourceContainer)
+    this.#incrementCount(targetContainer)
+  }
+
+  #decrementCount(container) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const current = this.#parseCount(countElement.textContent)
+    if (current === null) return
+
+    const next = Math.max(0, current - 1)
+    countElement.textContent = this.#formatCount(next, countElement.textContent)
+  }
+
+  #incrementCount(container) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const current = this.#parseCount(countElement.textContent)
+    if (current === null) {
+      // If we can't parse (e.g. "99+"), leave as is; server refresh will correct
+      return
+    }
+
+    const next = current + 1
+    countElement.textContent = this.#formatCount(next, countElement.textContent)
+  }
+
+  #parseCount(text) {
+    const trimmed = text.trim()
+    if (trimmed === "99+") return 99
+    const parsed = parseInt(trimmed, 10)
+    return Number.isNaN(parsed) ? null : parsed
+  }
+
+  #formatCount(count, previousText) {
+    if (previousText.trim() === "99+" && count >= 99) return "99+"
+    if (count > 99) return "99+"
+    return String(count)
+  }
+
+  async #saveMove(item, targetContainer) {
+    const destination = targetContainer.dataset.dragAndDropDestination
+    const columnId = targetContainer.dataset.dragAndDropColumnId
+
+    const triageUrl = item.dataset.cardTriageUrl
+    const closureUrl = item.dataset.cardClosureUrl
+    const notNowUrl = item.dataset.cardNotNowUrl
+
+    let request
+
+    if (destination === "column") {
+      if (!triageUrl || !columnId) return
+      request = post(triageUrl, { query: { column_id: columnId }, responseKind: "json" })
+    } else if (destination === "maybe" || destination === "stream") {
+      if (!triageUrl) return
+      request = destroy(triageUrl, { responseKind: "json" })
+    } else if (destination === "closed" || destination === "done") {
+      if (!closureUrl) return
+      request = post(closureUrl, { responseKind: "json" })
+    } else if (destination === "not_now" || destination === "not-now" || destination === "notnow") {
+      if (!notNowUrl) return
+      request = post(notNowUrl, { responseKind: "json" })
+    } else {
+      // Fallback: infer from container id for robustness
+      request = this.#saveByContainerId(item, targetContainer)
+      if (!request) return
+    }
+
+    const response = await request
+    if (!response.ok) {
+      throw new Error(`Drag save failed with status ${response.statusCode}`)
+    }
+    return response
+  }
+
+  #saveByContainerId(item, targetContainer) {
+    const id = targetContainer.id
+    const triageUrl = item.dataset.cardTriageUrl
+    const closureUrl = item.dataset.cardClosureUrl
+    const notNowUrl = item.dataset.cardNotNowUrl
+
+    if (id === "maybe") {
+      if (!triageUrl) return null
+      return destroy(triageUrl, { responseKind: "json" })
+    } else if (id === "closed-cards") {
+      if (!closureUrl) return null
+      return post(closureUrl, { responseKind: "json" })
+    } else if (id === "not-now") {
+      if (!notNowUrl) return null
+      return post(notNowUrl, { responseKind: "json" })
+    } else {
+      const columnId = targetContainer.dataset.dragAndDropColumnId || targetContainer.dataset.columnId
+      if (!triageUrl || !columnId) return null
+      return post(triageUrl, { query: { column_id: columnId }, responseKind: "json" })
+    }
+  }
+
+  #clearDragState() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove("drag-and-drop__dragged-item")
+    }
+    this.#clearHoverContainers()
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  #clearHoverContainers(except = null) {
+    this.containerTargets.forEach(container => {
+      if (container !== except) {
+        container.classList.remove("drag-and-drop__hover-container")
+      }
+    })
+    // Also clear any hover containers not in targets (e.g. dynamically added)
+    this.element.querySelectorAll(".drag-and-drop__hover-container").forEach(el => {
+      if (el !== except) el.classList.remove("drag-and-drop__hover-container")
+    })
+  }
+}
