diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..5721ab6
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    // Correct the deleteable affordance per-viewer: cached HTML is shared,
+    // so non-owners should not see the pointer cursor.
+    if (!this.isOwnReaction) {
+      this.element.classList.remove("reaction--deleteable")
+    }
+  }
+
+  toggle(event) {
+    // Don't toggle when interacting with links, buttons, inputs, or dialogs inside
+    if (event.target.closest("a, button, input, dialog, form")) {
+      return
+    }
+
+    if (!this.isOwnReaction) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  markDeleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get isOwnReaction() {
+    const creatorId = this.element.dataset.creatorId
+    const currentUserId = document.head.querySelector('meta[name="current-user-id"]')?.getAttribute("content")
+
+    if (!currentUserId || !creatorId) return false
+    return creatorId === currentUserId
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e8d819d
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,55 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "formContainer", "form", "input" ]
+
+  showForm(event) {
+    event?.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formContainerTarget.hidden = false
+    this.formContainerTarget.classList.add("expanded")
+
+    requestAnimationFrame(() => {
+      this.inputTarget?.focus()
+    })
+  }
+
+  hideForm(event) {
+    event?.preventDefault()
+    this.formContainerTarget.hidden = true
+    this.formContainerTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+    if (this.hasFormTarget) this.formTarget.reset()
+    this.formContainerTarget.querySelectorAll("dialog[open]").forEach(dialog => dialog.close())
+  }
+
+  reset(event) {
+    const { success } = event.detail
+    if (success) {
+      this.hideForm()
+    }
+  }
+
+  pickEmoji(event) {
+    event.preventDefault()
+    const emoji = event.currentTarget.dataset.emoji
+    if (!emoji || !this.hasInputTarget) return
+
+    const input = this.inputTarget
+    const current = input.value || ""
+
+    if (current.length === 0) {
+      input.value = emoji
+    } else {
+      const combined = current + emoji
+      // Use Array.from to avoid splitting surrogate pairs, then slice to 16
+      input.value = Array.from(combined).slice(0, 16).join("")
+    }
+
+    input.focus()
+  }
+
+  submitOnEnter(event) {
+    // Let the form submit naturally on Enter; this hook exists for future IME handling
+  }
+}
