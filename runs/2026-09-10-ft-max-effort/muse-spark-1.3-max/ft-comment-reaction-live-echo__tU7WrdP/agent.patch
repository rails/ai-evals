diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..7da882e
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,44 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account || card&.account }
+  belongs_to :card, optional: true, touch: true
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :card_or_comment_present
+
+  normalizes :content, with: ->(content) { content.to_s.strip.presence }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :for_card, -> { where(comment_id: nil).where.not(card_id: nil) }
+  scope :for_comment, -> { where.not(comment_id: nil) }
+
+  after_create_commit :register_card_activity
+
+  def parent_card
+    card || comment&.card
+  end
+
+  def to_partial_path
+    if comment_id?
+      "cards/comments/reactions/reaction"
+    else
+      "cards/reactions/reaction"
+    end
+  end
+
+  private
+    def card_or_comment_present
+      if card_id.blank? && comment_id.blank?
+        errors.add(:base, "Reaction must belong to a card or a comment")
+      elsif card_id.present? && comment_id.present?
+        errors.add(:base, "Reaction cannot belong to both a card and a comment")
+      end
+    end
+
+    def register_card_activity
+      parent_card&.touch_last_active_at
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+end
