+<button type="button" class="reactions__trigger btn btn--circle borderless" data-reactions-target="trigger" data-action="reactions#showForm" title="Add a reaction" aria-label="Add a reaction to this comment">
+  <%= image_tag "boost-color.svg", aria: { hidden: true } %>
+  <span class="for-screen-reader">Add a reaction</span>
+</button>
+
+<div class="reaction reaction__form" data-reactions-target="formContainer" hidden>
+  <%= form_with model: [ card, comment, Reaction.new ], url: card_comment_reactions_path(card, comment), data: { reactions_target: "form", action: "turbo:submit-end->reactions#reset keydown.esc->reactions#hideForm" } do |form| %>
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle" title="Choose an emoji" aria-label="Choose an emoji">
+        <%= icon_tag "reaction" %>
+      </button>
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog" data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn btn--circle borderless" data-action="reactions#pickEmoji dialog#close" data-emoji="<%= emoji %>" title="<%= label %>" aria-label="<%= label %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.label :content, class: "reaction__form-label" do %>
+      <span class="for-screen-reader">Reaction (max 16 characters)</span>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: 16, required: true, autocomplete: "off",
+            placeholder: "React…", aria: { label: "Reaction" }, data: { reactions_target: "input", action: "keydown.enter->reactions#submitOnEnter", "1p-ignore": "true" } %>
+    <% end %>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction", aria: { label: "Confirm reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm</span>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reactions#hideForm" title="Cancel" aria-label="Cancel reaction">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
