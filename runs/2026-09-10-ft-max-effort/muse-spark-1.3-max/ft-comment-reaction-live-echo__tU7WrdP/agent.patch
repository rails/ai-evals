+  <%= button_to card_reaction_path(reaction.card, reaction), method: :delete,
+        class: "reaction__delete btn btn--circle", form_class: "display-contents",
+        data: { only_visible_to_you: true, action: "click->reaction#markDeleting" },
+        title: "Remove your reaction", aria: { label: "Remove your reaction #{ h reaction.content }" } do %>
+    <%= icon_tag "trash" %>
+    <span class="for-screen-reader">Remove</span>
+  <% end %>
+</div>
