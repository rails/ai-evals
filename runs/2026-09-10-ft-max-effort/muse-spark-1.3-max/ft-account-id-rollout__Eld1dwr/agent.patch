diff --git a/config/initializers/multitenant_account_id.rb b/config/initializers/multitenant_account_id.rb
new file mode 100644
index 0000000..59b58d2
--- /dev/null
+++ b/config/initializers/multitenant_account_id.rb
@@ -0,0 +1,47 @@
+# Multi-tenant account_id rollout: ActiveStorage and ActionText records belong to an account.
+# These are Rails-internal tables extended with account_id (required + indexed).
+# Account is set automatically from the associated record/blob or Current.account.
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, optional: false
+
+  before_validation :set_account_from_current, if: -> { account_id.blank? }
+
+  private
+    def set_account_from_current
+      self.account = Current.account if Current.account.present?
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, optional: false
+
+  before_validation :set_account_from_record_blob_or_current, if: -> { account_id.blank? }
+
+  private
+    def set_account_from_record_blob_or_current
+      self.account ||= record.try(:account) || blob&.account || Current.account
+    end
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, optional: false
+
+  before_validation :set_account_from_blob_or_current, if: -> { account_id.blank? }
+
+  private
+    def set_account_from_blob_or_current
+      self.account ||= blob&.account || Current.account
+    end
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, optional: false
+
+  before_validation :set_account_from_record_or_current, if: -> { account_id.blank? }
+
+  private
+    def set_account_from_record_or_current
+      self.account ||= record.try(:account) || Current.account
+    end
+end
