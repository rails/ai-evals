diff --git a/config/initializers/active_storage_tenanting.rb b/config/initializers/active_storage_tenanting.rb
new file mode 100644
index 0000000..5427138
--- /dev/null
+++ b/config/initializers/active_storage_tenanting.rb
@@ -0,0 +1,19 @@
+# Multi-tenant account scoping for ActiveStorage and ActionText.
+# Every blob, attachment, variant record, and rich text holds an account's data,
+# so they carry account_id (required + indexed) like all other tenant records.
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, class_name: "::Account", default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, class_name: "::Account", default: -> { record&.try(:account) || blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, class_name: "::Account", default: -> { blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, class_name: "::Account", default: -> { record&.try(:account) || Current.account }
+end
