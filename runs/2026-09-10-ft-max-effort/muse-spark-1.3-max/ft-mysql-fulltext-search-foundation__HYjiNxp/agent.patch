diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..533b05a
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,22 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def matching_search_terms(terms)
+      terms = Array(terms).map(&:to_s).map(&:strip).reject(&:blank?)
+      return none if terms.empty?
+
+      query = left_joins(:rich_text_description, comments: :rich_text_body)
+
+      terms.each do |term|
+        escaped = "%#{ActiveRecord::Base.sanitize_sql_like(term.downcase)}%"
+        query = query.where(
+          "LOWER(cards.title) LIKE :q OR LOWER(action_text_rich_texts.body) LIKE :q OR LOWER(rich_text_bodies_comments.body) LIKE :q",
+          q: escaped
+        )
+      end
+
+      query.distinct
+    end
+  end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..e328c3f
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,29 @@
+<article id="<%= dom_id(card, :search_result) %>" class="card flex flex-column gap-half pad border radius">
+  <div class="flex align-center gap-half">
+    <span class="txt-x-small txt-subtle"><%= h card.board.name %></span>
+    <span class="txt-x-small txt-subtle">·</span>
+    <span class="txt-x-small txt-subtle">#<%= card.number %></span>
+  </div>
+
+  <h3 class="card__title">
+    <%= link_to highlight_search_terms(card.title.to_s, terms), card_path(card), title: card.title.to_s %>
+  </h3>
+
+  <% description_text = card.description.to_plain_text.to_s.strip %>
+  <% if description_text.present? %>
+    <p class="txt-small txt-subtle">
+      <%= search_highlighted_excerpt(card.description, terms) %>
+    </p>
+  <% end %>
+
+  <% matching = search_matching_comments(card, terms) %>
+  <% if matching.any? %>
+    <div class="flex flex-column gap-half">
+      <% matching.first(3).each do |comment| %>
+        <blockquote class="txt-small border-inline-start pad-inline-start" id="<%= dom_id(comment, :search_excerpt) %>">
+          <%= search_highlighted_excerpt(comment.body, terms) %>
+        </blockquote>
+      <% end %>
+    </div>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..2b65ad9
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel center margin pad">
+  <%= form_with url: search_path, method: :get, data: { turbo_frame: "_top" }, class: "flex gap-half" do %>
+    <%= search_field_tag :q, @query, placeholder: "Search cards…", autofocus: true, class: "input full-width", aria: { label: "Search cards" } %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p class="txt-align-center margin-block">Type above to search cards by title, description, or comments.</p>
+  <% elsif @page.records.empty? %>
+    <p class="txt-align-center margin-block">No cards found for “<%= h @query %>”.</p>
+  <% else %>
+    <p class="txt-small txt-subtle margin-block-half"><%= pluralize(@page.records.size, "result") %> for “<%= h @query %>”</p>
+
+    <%= with_automatic_pagination :search_results, @page do %>
+      <div class="flex flex-column gap">
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { terms: @terms } %>
+      </div>
+    <% end %>
+  <% end %>
+</section>
