index 0000000..d3adc91
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,20 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split
+    set_page_and_extract_portion_from search_results
+  end
+
+  private
+    def search_results
+      if @terms.any?
+        Current.user.accessible_cards
+          .published
+          .matching_search_terms(@terms)
+          .reverse_chronologically
+          .preload(:board, :rich_text_description, comments: :rich_text_body)
+      else
+        Card.none
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..7cfc6d9
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,38 @@
+module SearchHelper
+  def highlight_search_terms(text, terms)
+    highlight(text.to_s, terms)
+  end
+
+  def search_highlighted_excerpt(rich_text_or_string, terms, radius: 120, length: 300)
+    plain = if rich_text_or_string.respond_to?(:to_plain_text)
+      rich_text_or_string.to_plain_text.to_s
+    else
+      rich_text_or_string.to_s
+    end
+
+    snippet = nil
+    Array(terms).each do |term|
+      snippet = excerpt(plain, term, radius: radius)
+      break if snippet
+    end
+    snippet ||= truncate(plain, length: length)
+
+    highlight(snippet.to_s, terms)
+  end
+
+  def search_matching_comments(card, terms)
+    terms = Array(terms).map(&:to_s).reject(&:blank?)
+    return [] if terms.empty?
+
+    downcased_terms = terms.map(&:downcase)
+    card.comments.select do |comment|
+      plain = comment.body.to_plain_text.to_s.downcase
+      downcased_terms.any? { |term| plain.include?(term.downcase) }
+    end
+  end
+
+  def search_comment_matches?(comment, terms)
+    plain = comment.body.to_plain_text.to_s.downcase
+    Array(terms).any? { |term| plain.include?(term.to_s.downcase) }
+  end
+end
