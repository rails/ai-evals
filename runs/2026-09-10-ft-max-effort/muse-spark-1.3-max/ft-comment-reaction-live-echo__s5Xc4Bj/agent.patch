@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    comment = comments(:layout_overflowing_david)
+    comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    comment.reactions.create!(content: "Nice!", reacter: users(:jz))
+
+    get card_comment_reactions_path(comment.card, comment), as: :json
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_equal 2, body.size
+    assert_equal "👍", body.first["content"]
+    assert_equal users(:kevin).id, body.first["reacter"]["id"]
+  end
+
+  test "create as turbo_stream" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+      assert_turbo_stream action: :append, target: dom_id(comment, :reactions_list)
+    end
+
+    assert_response :success
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Great 👍", @response.parsed_body["content"]
+  end
+
+  test "create as JSON with flat params" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { content: "Flat" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Flat", @response.parsed_body["content"]
+  end
+
+  test "create with too long content is unprocessable" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "x" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create with 16 chars works" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "x" * 16 } }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "destroy as turbo_stream" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(cards(:logo), comment, reaction), as: :turbo_stream
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+
+    assert_response :success
+  end
+
+  test "destroy as JSON" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(cards(:logo), comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:jz))
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(cards(:logo), comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show as JSON" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get card_comment_reaction_path(cards(:logo), comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
