@@ -0,0 +1,51 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "formElement", "input", "list" ]
+
+  showForm(event) {
+    event?.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  hideForm(event) {
+    event?.preventDefault()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+    if (this.hasInputTarget) {
+      this.inputTarget.value = ""
+    }
+    const openDialog = this.formTarget.querySelector("dialog[open]")
+    if (openDialog) {
+      openDialog.close()
+    }
+  }
+
+  handleSubmit(event) {
+    if (event.detail.success) {
+      this.hideForm()
+    } else {
+      this.formTarget.classList.add("shake")
+      setTimeout(() => this.formTarget.classList.remove("shake"), 400)
+      this.inputTarget.focus()
+    }
+  }
+
+  pickEmoji(event) {
+    event.preventDefault()
+    const emoji = event.currentTarget.dataset.emoji
+    const input = this.inputTarget
+
+    if (!input.value) {
+      input.value = emoji
+    } else {
+      input.value = (input.value + " " + emoji).slice(0, 16)
+    }
+    input.focus()
+    event.currentTarget.closest("dialog")?.close()
+  }
+}
