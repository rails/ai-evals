+++ b/test/models/reaction_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "validates content presence" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "", reacter: users(:kevin))
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "validates content length max 16" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "x" * 17, reacter: users(:kevin))
+    assert_not reaction.valid?
+    assert reaction.errors[:content].any? { |e| e.include?("too long") }
+
+    reaction.content = "x" * 16
+    assert reaction.valid?
+  end
+
+  test "broadcasts append to card on create" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+
+    assert_turbo_stream_broadcasts(card, count: 1) do
+      comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    end
+  end
+
+  test "broadcasts remove to card on destroy" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+    reaction = comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_turbo_stream_broadcasts(card, count: 1) do
+      reaction.destroy!
+    end
+  end
+
+  test "touches card last_active_at on create" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+    old_time = card.last_active_at
+
+    travel 1.second do
+      comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    end
+
+    assert card.reload.last_active_at > old_time
+  end
+end
