diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..f8cee4f
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,41 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", inverse_of: :reactions, default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  after_create :register_card_activity
+
+  after_create_commit :broadcast_create
+  after_destroy_commit :broadcast_destroy
+
+  delegate :card, to: :comment
+
+  def to_partial_path
+    "cards/comments/reactions/reaction"
+  end
+
+  private
+    def register_card_activity
+      Card.suppressing_turbo_broadcasts do
+        comment.card.touch_last_active_at
+      end
+    end
+
+    def broadcast_create
+      broadcast_append_to card, target: helpers.dom_id(comment, :reactions_list),
+        partial: "cards/comments/reactions/reaction", locals: { reaction: self }
+    end
+
+    def broadcast_destroy
+      broadcast_remove_to card
+    end
+
+    def helpers
+      ApplicationController.helpers
+    end
+end
