diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..86c8435
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,55 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(public_token: nil) }
+    scope :unpublished, -> { where(public_token: nil) }
+  end
+
+  def published?
+    public_token.present?
+  end
+  alias_method :public?, :published?
+
+  def publish!
+    if public_token.blank?
+      update!(public_token: self.class.generate_unique_public_token)
+    end
+    self
+  end
+  alias_method :publish, :publish!
+
+  def unpublish!
+    update!(public_token: nil) if public_token.present?
+    self
+  end
+  alias_method :unpublish, :unpublish!
+
+  def public_key
+    public_token
+  end
+
+  def public_key=(value)
+    self.public_token = value
+  end
+
+  def key
+    public_token
+  end
+
+  def public_url
+    return nil unless published?
+
+    host = Rails.application.routes.default_url_options[:host] || "www.example.com"
+    Rails.application.routes.url_helpers.public_board_url(public_token, script_name: account.slug, host: host)
+  end
+
+  class_methods do
+    def generate_unique_public_token
+      loop do
+        token = SecureRandom.urlsafe_base64(24)
+        break token unless exists?(public_token: token)
+      end
+    end
+  end
+end
