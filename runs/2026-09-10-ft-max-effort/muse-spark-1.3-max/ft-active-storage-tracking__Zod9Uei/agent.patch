@@ -0,0 +1,12 @@
+class Card::BytesUsedTransferJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(old_board_id, new_board_id, byte_size)
+    byte_size = byte_size.to_i
+
+    if byte_size.positive?
+      Board.apply_bytes_used_delta(old_board_id, -byte_size)
+      Board.apply_bytes_used_delta(new_board_id, byte_size)
+    end
+  end
+end
