diff --git a/app/models/active_storage_attachment_tracking.rb b/app/models/active_storage_attachment_tracking.rb
new file mode 100644
index 0000000..93a557e
--- /dev/null
+++ b/app/models/active_storage_attachment_tracking.rb
@@ -0,0 +1,125 @@
+module ActiveStorageAttachmentTracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create_commit :track_bytes_used_on_create_later
+    before_destroy :capture_bytes_used_before_destroy
+    after_destroy_commit :track_bytes_used_on_destroy_later
+  end
+
+  # Purge and detach delete the attachment row without running destroy
+  # callbacks, so track them here. Destroy does not go through #delete,
+  # so there is no double counting.
+  def delete
+    track_bytes_used_on_delete_later
+    super
+  end
+
+  private
+    def track_bytes_used_on_create_later
+      if usage = storage_usage_for_tracking
+        StorageUsageDeltaJob.perform_later(usage[:board_id], usage[:account_id], usage[:byte_size])
+      end
+    end
+
+    def capture_bytes_used_before_destroy
+      @storage_usage_before_destroy = storage_usage_for_tracking
+    end
+
+    def track_bytes_used_on_destroy_later
+      if @storage_usage_before_destroy
+        StorageUsageDeltaJob.perform_later(
+          @storage_usage_before_destroy[:board_id],
+          @storage_usage_before_destroy[:account_id],
+          -@storage_usage_before_destroy[:byte_size]
+        )
+      end
+    end
+
+    def track_bytes_used_on_delete_later
+      return unless persisted?
+
+      if usage = storage_usage_for_tracking
+        StorageUsageDeltaJob.perform_later(usage[:board_id], usage[:account_id], -usage[:byte_size])
+      end
+    end
+
+    def storage_usage_for_tracking
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        storage_usage_for_card_image
+      when [ "ActionText::RichText", "embeds" ]
+        storage_usage_for_rich_text_embed
+      else
+        nil
+      end
+    end
+
+    def storage_usage_for_card_image
+      byte_size = blob_byte_size_for_tracking
+      return if byte_size.nil? || byte_size.zero?
+
+      board_id, account_id = Card.where(id: record_id).pick(:board_id, :account_id)
+
+      if board_id && account_id
+        { board_id: board_id, account_id: account_id, byte_size: byte_size }
+      elsif account_id_for_fallback
+        { board_id: nil, account_id: account_id_for_fallback, byte_size: byte_size }
+      end
+    end
+
+    def storage_usage_for_rich_text_embed
+      byte_size = blob_byte_size_for_tracking
+      return if byte_size.nil? || byte_size.zero?
+
+      rich_text_type, rich_text_record_id, rich_text_name = ActionText::RichText.where(id: record_id).pick(:record_type, :record_id, :name)
+      return if rich_text_type.nil?
+
+      case [ rich_text_type, rich_text_name ]
+      when [ "Board", "public_description" ]
+        account_id = Board.where(id: rich_text_record_id).pick(:account_id)
+
+        if account_id
+          { board_id: rich_text_record_id, account_id: account_id, byte_size: byte_size }
+        elsif account_id_for_fallback
+          { board_id: nil, account_id: account_id_for_fallback, byte_size: byte_size }
+        end
+      when [ "Card", "description" ]
+        board_id, account_id = Card.where(id: rich_text_record_id).pick(:board_id, :account_id)
+
+        if board_id && account_id
+          { board_id: board_id, account_id: account_id, byte_size: byte_size }
+        elsif account_id_for_fallback
+          { board_id: nil, account_id: account_id_for_fallback, byte_size: byte_size }
+        end
+      when [ "Comment", "body" ]
+        card_id = Comment.where(id: rich_text_record_id).pick(:card_id)
+
+        if card_id
+          board_id, account_id = Card.where(id: card_id).pick(:board_id, :account_id)
+
+          if board_id && account_id
+            { board_id: board_id, account_id: account_id, byte_size: byte_size }
+          elsif account_id_for_fallback
+            { board_id: nil, account_id: account_id_for_fallback, byte_size: byte_size }
+          end
+        elsif account_id_for_fallback
+          { board_id: nil, account_id: account_id_for_fallback, byte_size: byte_size }
+        end
+      else
+        nil
+      end
+    end
+
+    def blob_byte_size_for_tracking
+      if association(:blob).loaded? && blob
+        blob.byte_size
+      else
+        ActiveStorage::Blob.where(id: blob_id).pick(:byte_size)
+      end
+    end
+
+    def account_id_for_fallback
+      self[:account_id]
+    end
+end
