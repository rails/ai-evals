index 0000000..5dbec2f
--- /dev/null
+++ b/app/models/account/bytes_used.rb
@@ -0,0 +1,48 @@
+module Account::BytesUsed
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def apply_bytes_used_delta(account_id, delta)
+      return if delta.zero? || account_id.blank?
+
+      update_counters(account_id, bytes_used: delta)
+    end
+  end
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def calculate_bytes_used
+    card_images_bytes_used + embeds_bytes_used
+  end
+
+  def recalculate_bytes_used_now
+    update_column(:bytes_used, calculate_bytes_used)
+  end
+
+  def recalculate_bytes_used_later
+    Account::BytesUsedJob.perform_later(self)
+  end
+
+  private
+    def card_images_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def embeds_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: countable_rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def countable_rich_text_ids
+      ActionText::RichText.where(account_id: id)
+        .where(
+          "(record_type = ? AND name = ?) OR (record_type = ? AND name = ?) OR (record_type = ? AND name = ?)",
+          "Board", "public_description", "Card", "description", "Comment", "body"
+        ).select(:id)
+    end
+end
