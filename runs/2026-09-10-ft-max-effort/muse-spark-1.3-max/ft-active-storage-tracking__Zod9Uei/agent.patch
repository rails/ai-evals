new file mode 100644
index 0000000..bcf3aa1
--- /dev/null
+++ b/app/jobs/storage_usage_delta_job.rb
@@ -0,0 +1,12 @@
+class StorageUsageDeltaJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(board_id, account_id, delta)
+    delta = delta.to_i
+
+    if delta != 0
+      Board.apply_bytes_used_delta(board_id, delta) if board_id.present?
+      Account.apply_bytes_used_delta(account_id, delta) if account_id.present?
+    end
+  end
+end
