diff --git a/app/models/card/bytes_used.rb b/app/models/card/bytes_used.rb
new file mode 100644
index 0000000..79a7deb
--- /dev/null
+++ b/app/models/card/bytes_used.rb
@@ -0,0 +1,61 @@
+module Card::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :capture_board_change_for_bytes_used
+    after_update_commit :transfer_bytes_used_later
+  end
+
+  def calculate_bytes_used
+    card_image_bytes_used + card_description_bytes_used + comments_bytes_used
+  end
+
+  def transfer_bytes_used_later
+    old_board_id = @old_board_id_for_bytes_used
+    new_board_id = @new_board_id_for_bytes_used
+    @old_board_id_for_bytes_used = nil
+    @new_board_id_for_bytes_used = nil
+
+    if old_board_id && new_board_id && old_board_id != new_board_id
+      byte_size = calculate_bytes_used
+
+      if byte_size.positive?
+        Card::BytesUsedTransferJob.perform_later(old_board_id, new_board_id, byte_size)
+      end
+    end
+  end
+
+  private
+    def capture_board_change_for_bytes_used
+      if saved_change_to_board_id?
+        @old_board_id_for_bytes_used ||= board_id_before_last_save
+        @new_board_id_for_bytes_used = board_id
+      end
+    end
+
+    def card_image_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: id)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: card_description_rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comments_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: comment_rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_rich_text_ids
+      ActionText::RichText.where(record_type: "Card", record_id: id, name: "description").select(:id)
+    end
+
+    def comment_rich_text_ids
+      ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comments.select(:id)).select(:id)
+    end
+end
