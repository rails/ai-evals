diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..aa4c367
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,323 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+
+  connect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.currentHoverContainer = null
+    this.#enableDraggingForExistingItems()
+  }
+
+  disconnect() {
+    this.#cleanup()
+  }
+
+  itemTargetConnected(element) {
+    element.setAttribute("draggable", "true")
+  }
+
+  // Actions (wired via data-action on the board wrapper, events bubble from cards/columns)
+
+  dragstart(event) {
+    const item = this.#findItem(event.target)
+    if (!item) return
+
+    // Only handle drags for items inside this controller's element
+    if (!this.element.contains(item)) return
+
+    this.draggedItem = item
+    this.sourceContainer = this.#findContainer(item)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", item.id || "card")
+      } catch (_) {}
+    }
+
+    // Dim the dragged card instantly (design: drag_and_drop.css)
+    this.draggedItem.classList.add(DRAGGED_ITEM_CLASS)
+  }
+
+  dragover(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#findContainer(event.target)
+    if (!container) return
+    if (!this.element.contains(container)) return
+
+    // Allow dropping
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    if (this.currentHoverContainer !== container) {
+      this.#clearHover()
+      this.currentHoverContainer = container
+      container.classList.add(HOVER_CONTAINER_CLASS)
+    }
+  }
+
+  dragleave(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#findContainer(event.target)
+    if (!container) return
+
+    // Ignore dragleave when moving between children inside the same container
+    const related = event.relatedTarget
+    if (related && container.contains(related)) return
+
+    if (this.currentHoverContainer === container) {
+      container.classList.remove(HOVER_CONTAINER_CLASS)
+      this.currentHoverContainer = null
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    const targetContainer = this.#findContainer(event.target)
+    if (!targetContainer) return
+    if (!this.element.contains(targetContainer)) return
+
+    event.preventDefault()
+
+    const sourceContainer = this.sourceContainer || this.#findContainer(this.draggedItem)
+    const draggedItem = this.draggedItem
+
+    // Columns keep their own order — moves within the same column are ignored
+    if (sourceContainer && targetContainer && sourceContainer !== targetContainer) {
+      // Instant: update the board synchronously before saving, so when you let go
+      // the board is already the way you left it.
+      this.#moveCardOptimistically(draggedItem, sourceContainer, targetContainer)
+      this.#updateCounts(sourceContainer, targetContainer)
+
+      // Fire-and-forget: don't await, and rely on morph matching our optimistic
+      // placement so nothing shifts afterwards.
+      this.#saveMove(draggedItem, targetContainer)
+    }
+
+    this.#cleanupDragState()
+  }
+
+  dragend(event) {
+    this.#cleanupDragState()
+  }
+
+  // Private
+
+  #enableDraggingForExistingItems() {
+    // Ensure cards are draggable even if server markup predates drag-and-drop.
+    // Server-rendered cards already carry draggable="true", this is a safety net
+    // for dynamically inserted content before Stimulus connects targets.
+    // Only articles are draggable (excludes .board-tools.card).
+    for (const el of this.element.querySelectorAll('article.card')) {
+      if (!el.hasAttribute("draggable")) el.setAttribute("draggable", "true")
+    }
+  }
+
+  #findItem(target) {
+    if (!(target instanceof Element)) return null
+    return target.closest('[data-drag-and-drop-target="item"], article.card')
+  }
+
+  #findContainer(target) {
+    if (!(target instanceof Element)) return null
+    return target.closest('[data-drag-and-drop-target="container"], .cards')
+  }
+
+  #clearHover() {
+    if (this.currentHoverContainer) {
+      this.currentHoverContainer.classList.remove(HOVER_CONTAINER_CLASS)
+      this.currentHoverContainer = null
+    }
+    // Safety: clear any stray hover classes within scope
+    for (const el of this.element.querySelectorAll(`.${HOVER_CONTAINER_CLASS}`)) {
+      if (el !== this.currentHoverContainer) el.classList.remove(HOVER_CONTAINER_CLASS)
+    }
+  }
+
+  #cleanupDragState() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(DRAGGED_ITEM_CLASS)
+    }
+    this.#clearHover()
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  #cleanup() {
+    this.#cleanupDragState()
+  }
+
+  #moveCardOptimistically(card, sourceContainer, targetContainer) {
+    const targetList = targetContainer.querySelector(".cards__list")
+    if (!targetList) return
+
+    const isGolden = card.classList.contains("golden-effect")
+    const { parent, reference } = this.#insertionPoint(targetList, isGolden)
+
+    try {
+      parent.insertBefore(card, reference)
+    } catch (_) {
+      targetList.prepend(card)
+    }
+
+    // Ensure the moved card stays marked as a drag item / navigable item
+    if (!card.hasAttribute("draggable")) card.setAttribute("draggable", "true")
+  }
+
+  #insertionPoint(targetList, isGolden) {
+    const frames = [...targetList.querySelectorAll("turbo-frame")]
+    const cards = [...targetList.querySelectorAll("article.card")]
+
+    // Empty column (placeholder only, no frames or no cards): insert into list
+    if (frames.length === 0) {
+      return { parent: targetList, reference: targetList.firstChild }
+    }
+
+    if (cards.length === 0) {
+      // Frames exist but no cards yet (e.g. pagination link only)
+      const firstFrame = frames[0]
+      return { parent: firstFrame, reference: firstFrame.firstChild }
+    }
+
+    if (isGolden) {
+      // Golden cards stay first: prepend to the first frame
+      const firstFrame = frames[0]
+      return { parent: firstFrame, reference: firstFrame.firstChild }
+    }
+
+    // Non-golden: insert after the last golden card so server order (golden first,
+    // then latest) matches and nothing shifts after save.
+    const goldenCards = cards.filter((c) => c.classList.contains("golden-effect"))
+    if (goldenCards.length === 0) {
+      const firstFrame = frames[0]
+      return { parent: firstFrame, reference: firstFrame.firstChild }
+    }
+
+    const lastGolden = goldenCards[goldenCards.length - 1]
+    const parent = lastGolden.parentElement || frames[0]
+    return { parent, reference: lastGolden.nextSibling }
+  }
+
+  #updateCounts(sourceContainer, targetContainer) {
+    this.#adjustCount(sourceContainer, -1)
+    this.#adjustCount(targetContainer, 1)
+  }
+
+  #adjustCount(container, delta) {
+    const countEl = container.querySelector(".cards__expander-count")
+    if (!countEl) return
+
+    const raw = countEl.textContent.trim()
+    let current
+    if (raw === "99+") {
+      // Capped display: keep capped unless decrementing from the cap boundary.
+      // We can't know the true total, so stay capped on increment, and go to 99 on decrement.
+      current = delta > 0 ? 100 : 99
+      const next = current + (delta > 0 ? 0 : delta)
+      // If we were capped and decremented, show 99 (or stay 99+ if still >99, unknowable)
+      countEl.textContent = next > 99 ? "99+" : String(Math.max(next, 0))
+      return
+    }
+
+    current = parseInt(raw, 10)
+    if (Number.isNaN(current)) return
+    const next = Math.max(current + delta, 0)
+    countEl.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #saveMove(card, targetContainer) {
+    const type = this.#targetType(targetContainer)
+    const columnId = this.#targetColumnId(targetContainer)
+
+    if (type === "column") {
+      if (!columnId) return
+      const base = this.#triageUrl(card)
+      if (!base) return
+      const url = base.includes("?") ? `${base}&column_id=${encodeURIComponent(columnId)}` : `${base}?column_id=${encodeURIComponent(columnId)}`
+      post(url, { responseKind: "turbo-stream" })
+    } else if (type === "stream") {
+      const url = this.#triageUrl(card)
+      if (!url) return
+      destroy(url, { responseKind: "turbo-stream" })
+    } else if (type === "not_now") {
+      const url = this.#notNowUrl(card)
+      if (!url) return
+      post(url, { responseKind: "turbo-stream" })
+    } else if (type === "closed") {
+      const url = this.#closureUrl(card)
+      if (!url) return
+      post(url, { responseKind: "turbo-stream" })
+    }
+  }
+
+  #targetType(container) {
+    const fromData = container.dataset.dragAndDropType
+    if (fromData) {
+      const normalized = fromData.toLowerCase()
+      if (normalized === "column" || normalized === "stream" || normalized === "not_now" || normalized === "closed") return normalized
+      // Tolerate dashes (not-now)
+      if (normalized === "not-now") return "not_now"
+    }
+    return this.#inferType(container)
+  }
+
+  #inferType(container) {
+    const id = container.id || ""
+    if (id === "maybe") return "stream"
+    if (id === "not-now") return "not_now"
+    if (id === "closed-cards") return "closed"
+    if (id.startsWith("column_")) return "column"
+    if (container.classList.contains("cards--maybe")) return "stream"
+    if (container.classList.contains("cards--on-deck")) return "not_now"
+    if (container.classList.contains("cards--closed")) return "closed"
+    return "column"
+  }
+
+  #targetColumnId(container) {
+    if (container.dataset.dragAndDropColumnId) return container.dataset.dragAndDropColumnId
+    if (container.dataset.columnId) return container.dataset.columnId
+    const id = container.id || ""
+    if (id.startsWith("column_")) return id.replace(/^column_/, "")
+    const frame = container.querySelector('turbo-frame[id]')
+    if (frame && frame.id) {
+      const match = frame.id.match(/^column_(.+)_cards$/)
+      if (match) return match[1]
+    }
+    return null
+  }
+
+  #triageUrl(card) {
+    if (card.dataset.cardTriageUrl) return card.dataset.cardTriageUrl
+    if (card.dataset.triageUrl) return card.dataset.triageUrl
+    // Derive from sibling URLs
+    if (card.dataset.cardNotNowUrl) return card.dataset.cardNotNowUrl.replace(/\/not_now$/, "/triage")
+    if (card.dataset.cardClosureUrl) return card.dataset.cardClosureUrl.replace(/\/closure$/, "/triage")
+    const link = card.querySelector("a.card__link")
+    const href = link?.getAttribute("href")
+    if (href) return `${href}/triage`
+    return null
+  }
+
+  #notNowUrl(card) {
+    if (card.dataset.cardNotNowUrl) return card.dataset.cardNotNowUrl
+    const triage = this.#triageUrl(card)
+    if (triage) return triage.replace(/\/triage(\?.*)?$/, "/not_now")
+    return null
+  }
+
+  #closureUrl(card) {
+    if (card.dataset.cardClosureUrl) return card.dataset.cardClosureUrl
+    const triage = this.#triageUrl(card)
+    if (triage) return triage.replace(/\/triage(\?.*)?$/, "/closure")
+    return null
+  }
+}
