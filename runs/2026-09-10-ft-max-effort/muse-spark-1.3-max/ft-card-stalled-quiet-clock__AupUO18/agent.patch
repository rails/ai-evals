diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..1584630
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,75 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_INACTIVITY_PERIOD = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_MIN_PEOPLE = 2
+
+  included do
+    scope :stalled, -> { where(id: stalled_ids) }
+    scope :with_burst, -> { where(id: burst_ids) }
+    scope :with_attention_burst, -> { where(id: burst_ids) }
+  end
+
+  class_methods do
+    def stalled_ids
+      active.where("cards.last_active_at <= ?", STALLED_INACTIVITY_PERIOD.ago).find_each.select(&:had_burst?).map(&:id)
+    end
+
+    def burst_ids
+      all.find_each.select(&:had_burst?).map(&:id)
+    end
+  end
+
+  def stalled?
+    active? && stalled_inactive? && had_burst?
+  end
+
+  def had_burst?
+    burst_via_assignment_or_reopen? || burst_via_comments?
+  end
+  alias_method :burst?, :had_burst?
+  alias_method :had_attention_burst?, :had_burst?
+  alias_method :attention_burst?, :had_burst?
+  alias_method :bursted?, :had_burst?
+
+  def burst_via_assignment_or_reopen?
+    assignments.exists? || events.where(action: %w[card_assigned card_reopened]).exists?
+  end
+  alias_method :burst_via_assignment?, :burst_via_assignment_or_reopen?
+  alias_method :burst_via_reopen?, :burst_via_assignment_or_reopen?
+
+  def burst_via_comments?
+    comment_data = comments.by_user.order(:created_at, :id).pluck(:created_at, :creator_id)
+    return false if comment_data.size < BURST_COMMENT_COUNT
+
+    window = burst_window
+    counts = Hash.new(0)
+    left = 0
+
+    comment_data.each_with_index do |(time, creator_id), right|
+      counts[creator_id] += 1
+
+      while time - comment_data[left][0] > window
+        left_creator = comment_data[left][1]
+        counts[left_creator] -= 1
+        counts.delete(left_creator) if counts[left_creator] <= 0
+        left += 1
+      end
+
+      total = right - left + 1
+      return true if total >= BURST_COMMENT_COUNT && counts.size >= BURST_MIN_PEOPLE
+    end
+
+    false
+  end
+  alias_method :burst_via_comment?, :burst_via_comments?
+
+  def burst_window
+    auto_postpone_period / 3.0
+  end
+
+  def stalled_inactive?
+    last_active_at.present? && last_active_at <= STALLED_INACTIVITY_PERIOD.ago
+  end
+end
