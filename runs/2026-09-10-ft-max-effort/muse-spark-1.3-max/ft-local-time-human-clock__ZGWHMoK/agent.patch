diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..0d952d2
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+// Renders <time datetime="..."> in the viewer's own timezone.
+//
+// The server sends only the raw UTC timestamp; this controller turns it into
+// words locally so cached HTML can be shared between timezones.
+//
+// Usage (via TimeHelper#local_time):
+//   <time datetime="2026-09-12T13:42:00Z" data-controller="local-time" data-local-time-format-value="relative"></time>
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    const datetime = this.element.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date)) return
+
+    const format = this.hasFormatValue ? this.formatValue : "relative"
+    this.element.textContent = formatLocalTime(date, format, new Date())
+  }
+
+  update() {
+    this.render()
+  }
+}
