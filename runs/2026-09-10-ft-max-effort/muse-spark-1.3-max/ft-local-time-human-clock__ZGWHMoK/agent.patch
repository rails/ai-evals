diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..c498496 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,53 @@
 module TimeHelper
+  # Render a timestamp for client-side formatting in the viewer's timezone.
+  #
+  # The server sends only the raw UTC timestamp in a <time> element; a Stimulus
+  # controller formats it in the browser. This keeps fragment caches shareable
+  # between people in different timezones.
+  #
+  # Formats:
+  #   :relative (default) - smart calendar-relative: same day shows "1:42 PM",
+  #     yesterday/tomorrow as words, 2-6 days as "5 days ago"/"in 3 days",
+  #     beyond a week as "Sep 12" (with year when different).
+  #   :friendly, :calendar, :smart - aliases of :relative.
+  #   :time - "1:42 PM"
+  #   :date - "Sep 12"
+  #   :date_with_year - "Sep 12, 2025"
+  #   :weekday_date - "Monday, September 8"
+  #   :short_datetime - "9/12/25, 1:42 PM"
+  def local_time(time, format: :relative, **options)
+    datetime = time_to_iso8601(time)
+    return "" if datetime.nil?
+
+    data = options.delete(:data) || {}
+    existing_controller = data[:controller]
+    data[:controller] = [ existing_controller, "local-time" ].compact.join(" ")
+    data[:local_time_format_value] = format.to_s.dasherize
+    data[:action] = [ data[:action], "turbo:morph-element->local-time#render" ].compact.join(" ")
+
+    tag.time datetime: datetime, data: data, **options
+  end
+
+  alias_method :relative_time, :local_time
+  alias_method :friendly_time, :local_time
+  alias_method :local_datetime, :local_time
+  alias_method :formatted_time, :local_time
+
+  private
+    def time_to_iso8601(time)
+      if time.is_a?(String)
+        parsed = begin
+          Time.zone.parse(time)
+        rescue
+          Time.parse(time)
+        end
+        parsed&.utc&.iso8601
+      elsif time.is_a?(Date) && !time.is_a?(DateTime)
+        time.to_time.utc.iso8601
+      elsif time.respond_to?(:utc)
+        time.utc.iso8601
+      end
+    rescue
+      nil
+    end
 end
