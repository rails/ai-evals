+class SearchesController < ApplicationController
+  def show
+    @query = search_query
+    @terms = @query.split
+
+    if @query.present?
+      @cards = search_cards
+    else
+      @cards = Card.none
+    end
+
+    respond_to do |format|
+      format.html
+      format.json { render json: search_cards_json }
+    end
+  end
+
+  private
+    def search_query
+      (params[:q] || params[:query] || params[:term] || params[:search]).to_s.strip
+    end
+
+    def search_cards
+      Current.user.accessible_cards.published
+        .matching_terms(@terms)
+        .reverse_chronologically
+        .includes(:board, :rich_text_description, comments: :rich_text_body)
+    end
+
+    def search_cards_json
+      @cards.map do |card|
+        {
+          id: card.id,
+          number: card.number,
+          title: card.title,
+          board_id: card.board_id,
+          board_name: card.board.name,
+          created_at: card.created_at,
+          url: card_path(card)
+        }
+      end
+    end
+end
