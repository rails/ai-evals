+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,51 @@
+module SearchesHelper
+  def highlighted_card_title(card, terms)
+    if terms.any?
+      highlight(card.title.to_s, terms)
+    else
+      h(card.title.to_s)
+    end
+  end
+
+  def highlighted_description_excerpt(card, terms, radius: 100)
+    text = card.description&.to_plain_text.to_s
+    excerpted = excerpt_with_terms(text, terms, radius: radius)
+
+    if terms.any? && excerpted.present?
+      highlight(excerpted, terms)
+    else
+      h(excerpted.to_s)
+    end
+  end
+
+  def matching_comments_for(card, terms)
+    if terms.any?
+      downcased_terms = terms.map(&:downcase)
+
+      card.comments.select do |comment|
+        body_text = comment.body&.to_plain_text.to_s.downcase
+        downcased_terms.any? { |term| body_text.include?(term) }
+      end
+    else
+      []
+    end
+  end
+
+  def highlighted_comment_excerpt(comment, terms, radius: 100)
+    text = comment.body&.to_plain_text.to_s
+    excerpted = excerpt_with_terms(text, terms, radius: radius)
+    highlight(excerpted.to_s, terms)
+  end
+
+  private
+    def excerpt_with_terms(text, terms, radius: 100)
+      if text.blank?
+        ""
+      elsif terms.empty?
+        text.truncate(200)
+      else
+        found = terms.lazy.filter_map { |term| excerpt(text, term, radius: radius) }.first
+        found || text.truncate(200)
+      end
+    end
+end
