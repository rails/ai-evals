diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..a499f66
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,46 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def matching_terms(terms)
+      terms = Array(terms).map(&:to_s).map(&:strip).reject(&:blank?)
+      return none if terms.empty?
+
+      conditions = []
+      bindings = []
+
+      terms.each do |term|
+        pattern = "%#{sanitize_sql_like(term)}%"
+
+        conditions << "LOWER(cards.title) LIKE LOWER(?)"
+        bindings << pattern
+
+        conditions << <<~SQL.squish
+          EXISTS (
+            SELECT 1 FROM action_text_rich_texts AS card_descriptions
+            WHERE card_descriptions.record_type = 'Card'
+            AND card_descriptions.record_id = cards.id
+            AND card_descriptions.name = 'description'
+            AND LOWER(card_descriptions.body) LIKE LOWER(?)
+          )
+        SQL
+        bindings << pattern
+
+        conditions << <<~SQL.squish
+          EXISTS (
+            SELECT 1 FROM comments
+            INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+            WHERE comments.card_id = cards.id
+            AND LOWER(comment_bodies.body) LIKE LOWER(?)
+          )
+        SQL
+        bindings << pattern
+      end
+
+      where(conditions.join(" OR "), *bindings)
+    end
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..3667306
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,38 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, data: { turbo_frame: "_top" }, class: "search-form" do |form| %>
+  <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input" %>
+  <%= form.submit "Search", class: "btn" %>
+<% end %>
+
+<% if @query.present? %>
+  <% if @cards.any? %>
+    <div id="search_results" class="search-results">
+      <% @cards.each do |card| %>
+        <article id="<%= dom_id(card, :search_result) %>" class="search-result">
+          <h2 class="search-result__title">
+            <%= link_to highlighted_card_title(card, @terms), card_path(card) %>
+          </h2>
+          <p class="search-result__board"><%= h(card.board.name) %></p>
+          <% description_text = card.description&.to_plain_text.to_s %>
+          <% if description_text.present? %>
+            <p class="search-result__description"><%= highlighted_description_excerpt(card, @terms) %></p>
+          <% end %>
+          <% matching_comments_for(card, @terms).each do |comment| %>
+            <blockquote id="<%= dom_id(comment, :search_result) %>" class="search-result__comment">
+              <%= highlighted_comment_excerpt(comment, @terms) %>
+            </blockquote>
+          <% end %>
+        </article>
+      <% end %>
+    </div>
+  <% else %>
+    <p class="search-results__empty">No cards found for “<%= h(@query) %>”</p>
+  <% end %>
+<% end %>
