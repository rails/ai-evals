+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "Back to #{@board.name}", public_board_path(@board.public_key), class: "btn btn--back" %>
+  </div>
+<% end %>
+
+<article class="card card-perma">
+  <header class="card__header">
+    <h1><%= @card.title %></h1>
+    <p class="txt-small">In <%= @board.name %><% if @card.column %> / <%= @card.column.name %><% end %></p>
+  </header>
+
+  <div class="card__body">
+    <%= @card.description %>
+  </div>
+
+  <footer class="card__footer">
+    <p class="txt-small">Added by <%= @card.creator.name %></p>
+    <% if @card.tags.any? %>
+      <p class="txt-small">Tags: <%= @card.tags.map(&:title).sort.join(", ") %></p>
+    <% end %>
+  </footer>
+</article>
