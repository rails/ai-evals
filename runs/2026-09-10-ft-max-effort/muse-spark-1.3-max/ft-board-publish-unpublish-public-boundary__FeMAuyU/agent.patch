@@ -0,0 +1,22 @@
+class Public::BoardsController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  def show
+    @board = find_published_board!(params[:key])
+    @columns = @board.columns.sorted
+
+    respond_to do |format|
+      format.html
+      format.json
+    end
+  end
+
+  private
+    def find_published_board!(key)
+      scope = Current.account ? Current.account.boards : Board.all
+      scope.published.find_by!(public_key: key)
+    end
+end
