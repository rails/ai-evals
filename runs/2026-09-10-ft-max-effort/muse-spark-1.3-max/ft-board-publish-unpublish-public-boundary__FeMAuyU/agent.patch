diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..02885d4
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,57 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+
+    validates :public_key, uniqueness: { allow_nil: true }
+
+    after_update_commit -> { cards.touch_all }, if: :saved_change_to_public_key?
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def publish!
+    return true if published?
+
+    update!(public_key: self.class.generate_unique_public_key)
+  end
+
+  def unpublish!
+    update!(public_key: nil)
+  end
+
+  def public_url
+    return nil unless published?
+
+    Rails.application.routes.url_helpers.public_board_url(
+      public_key,
+      script_name: account.slug,
+      host: host_for_public_url
+    )
+  rescue StandardError
+    nil
+  end
+
+  def regenerate_public_key
+    update!(public_key: self.class.generate_unique_public_key)
+  end
+
+  class_methods do
+    def generate_unique_public_key
+      loop do
+        candidate = SecureRandom.base58(24)
+        break candidate unless exists?(public_key: candidate)
+      end
+    end
+  end
+
+  private
+    def host_for_public_url
+      Rails.application.routes.default_url_options[:host].presence ||
+        Rails.application.config.action_mailer.default_url_options&.dig(:host).presence ||
+        "example.com"
+    end
+end
