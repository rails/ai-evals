@@ -0,0 +1,40 @@
+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="card-columns">
+  <% @columns.each do |column| %>
+    <div class="cards" id="<%= dom_id(column) %>">
+      <header class="cards__header">
+        <h2><%= link_to column.name, public_board_column_path(@board.public_key, column) %></h2>
+      </header>
+      <div class="cards__list">
+        <% column.cards.published.open.order(last_active_at: :desc).limit(50).each do |card| %>
+          <article class="card">
+            <h3><%= link_to card.title, public_board_card_path(@board.public_key, card.number) %></h3>
+          </article>
+        <% end %>
+      </div>
+    </div>
+  <% end %>
+
+  <% stream_cards = @board.cards.published.awaiting_triage.latest.limit(50) %>
+  <% if stream_cards.any? %>
+    <div class="cards" id="stream">
+      <header class="cards__header">
+        <h2>Stream</h2>
+      </header>
+      <div class="cards__list">
+        <% stream_cards.each do |card| %>
+          <article class="card">
+            <h3><%= link_to card.title, public_board_card_path(@board.public_key, card.number) %></h3>
+          </article>
+        <% end %>
+      </div>
+    </div>
+  <% end %>
+</section>
