new file mode 100644
index 0000000..90d2d94
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,50 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @push_subscription.assign_attributes(subscription_params)
+
+    if @push_subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on for this device" }
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: @push_subscription.errors.full_messages.to_sentence }
+        format.json { render json: @push_subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @push_subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:endpoint]) ||
+      @user.push_subscriptions.find_by(endpoint: params.dig(:push_subscription, :endpoint))
+
+    @push_subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned off for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..e47dced
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,139 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "explainer", "status", "details" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  async connect() {
+    if (!this.supported || !this.vapidPublicKeyValue) {
+      this.buttonTarget.hidden = true
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.showBlocked()
+      return
+    }
+
+    if (Notification.permission === "granted") {
+      const subscription = await this.getSubscription()
+
+      if (subscription) {
+        await this.saveSubscription(subscription)
+        this.showOn()
+        return
+      }
+    }
+
+    this.showOff()
+  }
+
+  async subscribe(event) {
+    event.preventDefault()
+
+    if (!this.supported) return
+
+    const permission = await Notification.requestPermission()
+
+    if (permission === "denied") {
+      this.showBlocked()
+      return
+    }
+
+    if (permission !== "granted") {
+      this.showOff()
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.applicationServerKey
+        })
+      }
+
+      const response = await this.saveSubscription(subscription)
+
+      if (response.ok) {
+        this.showOn()
+      } else {
+        this.showOff()
+      }
+    } catch (error) {
+      console.error("Push subscription failed:", error)
+
+      if (Notification.permission === "denied") {
+        this.showBlocked()
+      } else {
+        this.showOff()
+      }
+    }
+  }
+
+  showOn() {
+    this.element.classList.add("notifications--on")
+    this.buttonTarget.hidden = true
+    this.explainerTarget.hidden = true
+  }
+
+  showOff() {
+    this.element.classList.remove("notifications--on")
+    this.buttonTarget.hidden = false
+    this.explainerTarget.hidden = true
+  }
+
+  showBlocked() {
+    this.element.classList.remove("notifications--on")
+    this.buttonTarget.hidden = true
+    this.explainerTarget.hidden = false
+  }
+
+  get supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get applicationServerKey() {
+    return this.urlBase64ToUint8Array(this.vapidPublicKeyValue)
+  }
+
+  async getSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async saveSubscription(subscription) {
+    const json = subscription.toJSON()
+
+    return post(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
