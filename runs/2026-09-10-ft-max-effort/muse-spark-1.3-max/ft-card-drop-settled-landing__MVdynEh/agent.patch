diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..3aa696e
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,318 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+const FALLBACK_DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const FALLBACK_HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  connect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  disconnect() {
+    this.#cleanup()
+  }
+
+  // Actions
+
+  dragstart(event) {
+    const item = event.currentTarget
+    const container = this.#containerFor(item)
+
+    if (!container) return
+
+    this.draggedItem = item
+    this.sourceContainer = container
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", item.id || "")
+      } catch {
+        // Some browsers restrict setData access
+      }
+    }
+
+    item.classList.add(this.#draggedItemClassName)
+  }
+
+  dragend() {
+    this.#cleanup()
+  }
+
+  dragenter(event) {
+    const container = event.currentTarget
+
+    if (!this.#canDropOn(container)) return
+
+    event.preventDefault()
+    container.classList.add(this.#hoverContainerClassName)
+  }
+
+  dragover(event) {
+    const container = event.currentTarget
+
+    if (!this.#canDropOn(container)) {
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "none"
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    container.classList.add(this.#hoverContainerClassName)
+  }
+
+  dragleave(event) {
+    const container = event.currentTarget
+
+    if (container.contains(event.relatedTarget)) return
+
+    container.classList.remove(this.#hoverContainerClassName)
+  }
+
+  drop(event) {
+    const targetContainer = event.currentTarget
+
+    event.preventDefault()
+    targetContainer.classList.remove(this.#hoverContainerClassName)
+
+    if (!this.draggedItem || !this.#canDropOn(targetContainer)) return
+
+    const draggedItem = this.draggedItem
+    const sourceContainer = this.sourceContainer
+
+    // Capture revert information before mutating the DOM
+    const sourceParent = draggedItem.parentNode
+    const sourceNextSibling = draggedItem.nextSibling
+
+    // Clear drag state up front so a new drag can start while we save
+    this.draggedItem = null
+    this.sourceContainer = null
+    draggedItem.classList.remove(this.#draggedItemClassName)
+    this.#clearHoverStates()
+
+    // Instant optimistic move: the board is already the way it was left,
+    // without waiting on the save.
+    this.#moveCardToContainer(draggedItem, sourceContainer, targetContainer)
+    this.#adjustCounts(sourceContainer, targetContainer, 1)
+
+    // Persist in the background with JSON so nothing re-renders or shifts.
+    // On failure, move the card back to where it came from.
+    this.#saveMove(draggedItem, targetContainer).catch(() => {
+      this.#revertMove(draggedItem, sourceParent, sourceNextSibling, sourceContainer, targetContainer)
+    })
+  }
+
+  // Private
+
+  #canDropOn(container) {
+    if (!this.draggedItem || !container) return false
+    if (!this.sourceContainer) return true
+
+    // Columns keep their own order: moves are between places, not within one.
+    return container !== this.sourceContainer
+  }
+
+  #containerFor(item) {
+    if (!item) return null
+
+    return item.closest('[data-drag-and-drop-target~="container"]') ||
+      item.closest(".cards")
+  }
+
+  #listFor(container) {
+    if (!container) return null
+    return container.querySelector(".cards__list")
+  }
+
+  #insertionParentFor(list) {
+    if (!list) return null
+
+    // Cards live inside pagination frames when paginated. Insert into the
+    // first frame so the structure (and a later morph) stays stable.
+    const firstFrame = list.querySelector("turbo-frame")
+    if (firstFrame) return firstFrame
+
+    return list
+  }
+
+  #moveCardToContainer(card, sourceContainer, targetContainer) {
+    const targetList = this.#listFor(targetContainer)
+    if (!targetList) return false
+
+    const parent = this.#insertionParentFor(targetList)
+    if (!parent) return false
+
+    const targetType = this.#columnTypeFor(targetContainer)
+    const isGolden = card.classList.contains("golden-effect")
+
+    // Custom columns and Maybe? order golden cards first. A moved card has
+    // the freshest activity, so it goes top overall when golden, otherwise
+    // top among non-golden. Not Now and Done order purely by recency.
+    if ((targetType === "column" || targetType === "maybe") && !isGolden) {
+      const lastGolden = [ ...parent.querySelectorAll(".card.golden-effect") ].pop()
+      if (lastGolden && lastGolden.nextSibling) {
+        parent.insertBefore(card, lastGolden.nextSibling)
+      } else if (lastGolden) {
+        parent.appendChild(card)
+      } else {
+        parent.prepend(card)
+      }
+    } else {
+      parent.prepend(card)
+    }
+
+    return true
+  }
+
+  #revertMove(card, sourceParent, sourceNextSibling, sourceContainer, targetContainer) {
+    if (sourceParent && sourceParent.isConnected) {
+      sourceParent.insertBefore(card, sourceNextSibling)
+    } else {
+      const sourceList = this.#listFor(sourceContainer)
+      const parent = sourceList ? this.#insertionParentFor(sourceList) : null
+      if (parent) parent.prepend(card)
+    }
+
+    this.#adjustCounts(targetContainer, sourceContainer, 1)
+  }
+
+  #adjustCounts(fromContainer, toContainer, amount) {
+    this.#adjustCount(fromContainer, -amount)
+    this.#adjustCount(toContainer, amount)
+  }
+
+  #adjustCount(container, delta) {
+    if (!container) return
+
+    const counter = container.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    const text = counter.textContent.trim()
+    if (text === "99+") return
+
+    const current = parseInt(text, 10)
+    if (isNaN(current)) return
+
+    const next = Math.max(0, current + delta)
+    counter.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #clearHoverStates() {
+    for (const container of this.containerTargets) {
+      container.classList.remove(this.#hoverContainerClassName)
+    }
+  }
+
+  #cleanup() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.#draggedItemClassName)
+    }
+
+    this.#clearHoverStates()
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  async #saveMove(card, targetContainer) {
+    const type = this.#columnTypeFor(targetContainer)
+
+    if (type === "column") {
+      const columnId = this.#columnIdFor(targetContainer)
+      const triageUrl = this.#triageUrlFor(card)
+
+      if (!triageUrl || !columnId) throw new Error("Missing triage target")
+
+      const url = `${triageUrl}?column_id=${encodeURIComponent(columnId)}`
+      const response = await post(url, { responseKind: "json" })
+      if (!response.ok) throw new Error(`Move failed: ${response.statusCode}`)
+    } else if (type === "maybe") {
+      const triageUrl = this.#triageUrlFor(card)
+      if (!triageUrl) throw new Error("Missing triage target")
+
+      const response = await destroy(triageUrl, { responseKind: "json" })
+      if (!response.ok) throw new Error(`Move failed: ${response.statusCode}`)
+    } else if (type === "not_now") {
+      const notNowUrl = this.#notNowUrlFor(card)
+      if (!notNowUrl) throw new Error("Missing not-now target")
+
+      const response = await post(notNowUrl, { responseKind: "json" })
+      if (!response.ok) throw new Error(`Move failed: ${response.statusCode}`)
+    } else if (type === "closed") {
+      const closureUrl = this.#closureUrlFor(card)
+      if (!closureUrl) throw new Error("Missing closure target")
+
+      const response = await post(closureUrl, { responseKind: "json" })
+      if (!response.ok) throw new Error(`Move failed: ${response.statusCode}`)
+    } else {
+      throw new Error(`Unknown column type: ${type}`)
+    }
+  }
+
+  #columnTypeFor(container) {
+    const dataset = container.dataset
+    const explicit = dataset.columnType || dataset.dragAndDropColumnType || dataset.dropType
+
+    if (explicit) return this.#normalizeColumnType(explicit)
+
+    return this.#inferTypeFromId(container.id)
+  }
+
+  #columnIdFor(container) {
+    const dataset = container.dataset
+    const explicit = dataset.columnId || dataset.dragAndDropColumnId || dataset.column
+
+    if (explicit) return explicit
+
+    return this.#inferIdFromDomId(container.id)
+  }
+
+  #normalizeColumnType(type) {
+    if (type === "not-now" || type === "not_now") return "not_now"
+    if (type === "closed" || type === "closed-cards" || type === "done") return "closed"
+    if (type === "maybe" || type === "stream") return "maybe"
+    return type
+  }
+
+  #inferTypeFromId(id) {
+    if (id === "maybe") return "maybe"
+    if (id === "not-now") return "not_now"
+    if (id === "closed-cards") return "closed"
+    if (id && id.startsWith("column_")) return "column"
+    return null
+  }
+
+  #inferIdFromDomId(id) {
+    if (id && id.startsWith("column_")) return id.replace(/^column_/, "")
+    return null
+  }
+
+  #triageUrlFor(card) {
+    return card.dataset.cardTriageUrl || card.dataset.triageUrl || card.dataset.dragAndDropTriageUrl
+  }
+
+  #notNowUrlFor(card) {
+    return card.dataset.cardNotNowUrl || card.dataset.notNowUrl || card.dataset.dragAndDropNotNowUrl
+  }
+
+  #closureUrlFor(card) {
+    return card.dataset.cardClosureUrl || card.dataset.closureUrl || card.dataset.dragAndDropClosureUrl
+  }
+
+  get #draggedItemClassName() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : FALLBACK_DRAGGED_ITEM_CLASS
+  }
+
+  get #hoverContainerClassName() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : FALLBACK_HOVER_CONTAINER_CLASS
+  }
+}
