diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..87c8a59
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,83 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_INACTIVITY_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      stalled_ids = []
+      active.where(last_active_at: ..STALLED_INACTIVITY_PERIOD.ago).find_each do |card|
+        stalled_ids << card.id if card.burst?
+      end
+      where(id: stalled_ids)
+    }
+  end
+
+  def stalled?
+    if active? && inactive_for_stalled_period? && burst?
+      true
+    else
+      false
+    end
+  end
+
+  def burst?
+    if comment_burst? || assigned_burst? || reopened_burst?
+      true
+    else
+      false
+    end
+  end
+  alias_method :had_burst?, :burst?
+  alias_method :has_burst?, :burst?
+
+  private
+    def inactive_for_stalled_period?
+      last_active_at.present? && last_active_at <= STALLED_INACTIVITY_PERIOD.ago
+    end
+
+    def comment_burst?
+      timestamps_and_creators = comments.by_user.order(:created_at).pluck(:created_at, :creator_id)
+
+      if timestamps_and_creators.size >= 3
+        burst_window_contains_three_comments_from_two_people?(timestamps_and_creators)
+      else
+        false
+      end
+    end
+
+    def burst_window_contains_three_comments_from_two_people?(timestamps_and_creators)
+      window_seconds = burst_window_seconds
+      left = 0
+
+      timestamps_and_creators.each_with_index do |(right_time, _), right|
+        while right_time - timestamps_and_creators[left].first > window_seconds
+          left += 1
+        end
+
+        window_slice = timestamps_and_creators[left..right]
+
+        if window_slice.size >= 3 && window_slice.map(&:second).uniq.size >= 2
+          return true
+        end
+      end
+
+      false
+    end
+
+    def burst_window_seconds
+      auto_postpone_period / 3.0
+    end
+
+    def assigned_burst?
+      if assignments.exists? || events.where(action: "card_assigned").exists?
+        true
+      else
+        false
+      end
+    end
+
+    def reopened_burst?
+      events.where(action: "card_reopened").exists?
+    end
+end
