diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..a693f90
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,42 @@
+module SearchesHelper
+  def highlight_search_terms(text)
+    return "" if text.blank?
+
+    words = @search&.words || []
+    escaped = ERB::Util.html_escape(text.to_s)
+
+    if words.any?
+      highlight(escaped, words, sanitize: false)
+    else
+      escaped
+    end
+  end
+
+  def highlighted_search_excerpt(text, radius: 100, truncate_length: 300)
+    plain = text.to_s
+    return "" if plain.blank?
+
+    words = @search&.words || []
+
+    excerpted = nil
+    words.each do |word|
+      if found = excerpt(plain, word, radius: radius)
+        excerpted = found
+        break
+      end
+    end
+    excerpted ||= plain.truncate(truncate_length)
+
+    highlight_search_terms(excerpted)
+  end
+
+  def matching_search_comments_for(card)
+    words = @search&.words || []
+    return [] if words.empty?
+
+    card.comments.select do |comment|
+      plain = comment.body.to_plain_text.to_s
+      plain.present? && words.any? { |word| plain.downcase.include?(word.downcase) }
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..7469c76
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,34 @@
+class Search
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def words
+    @words ||= query.split(/\s+/).reject(&:blank?)
+  end
+
+  def cards
+    if words.empty?
+      Card.none.reverse_chronologically
+    else
+      relation = user.accessible_cards.published
+        .where(cards: { account_id: user.account_id })
+        .reverse_chronologically
+
+      words.each do |word|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(word)}%"
+        relation = relation.where(
+          "cards.title LIKE :pattern ESCAPE '\\' OR " \
+          "EXISTS (SELECT 1 FROM action_text_rich_texts WHERE action_text_rich_texts.record_type = 'Card' AND action_text_rich_texts.name = 'description' AND action_text_rich_texts.record_id = cards.id AND action_text_rich_texts.body LIKE :pattern ESCAPE '\\') OR " \
+          "EXISTS (SELECT 1 FROM comments INNER JOIN action_text_rich_texts AS comment_rich_texts ON comment_rich_texts.record_type = 'Comment' AND comment_rich_texts.name = 'body' AND comment_rich_texts.record_id = comments.id WHERE comments.card_id = cards.id AND comment_rich_texts.body LIKE :pattern ESCAPE '\\')",
+          pattern: pattern
+        )
+      end
+
+      relation.preloaded.includes(comments: :rich_text_body)
+    end
+  end
+end
diff --git a/app/views/searches/_card.html.erb b/app/views/searches/_card.html.erb
new file mode 100644
index 0000000..a77f1e8
--- /dev/null
+++ b/app/views/searches/_card.html.erb
@@ -0,0 +1,25 @@
+<article id="<%= dom_id(card) %>" class="card search-result">
+  <div class="flex flex-column flex-item-grow max-inline-size">
+    <div class="card__content">
+      <h3 class="card__title">
+        <%= link_to highlight_search_terms(card.title), card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } %>
+      </h3>
+      <p class="card__board txt-small translucent">
+        <%= card.board.name %> #<%= card.number %>
+      </p>
+
+      <% description_text = card.description.to_plain_text.to_s %>
+      <% if description_text.present? %>
+        <p class="search-result__description">
+          <%= highlighted_search_excerpt(description_text) %>
+        </p>
+      <% end %>
+
+      <% matching_search_comments_for(card).each do |comment| %>
+        <blockquote id="<%= dom_id(comment, :search_excerpt) %>" class="search-result__comment">
+          <%= highlighted_search_excerpt(comment.body.to_plain_text.to_s) %>
+        </blockquote>
+      <% end %>
+    </div>
+  </div>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..8096de4
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,26 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form", data: { turbo_frame: "_top" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: @query.blank?, class: "input search__input" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div id="search-results" class="search__results">
+        <%= render partial: "searches/card", collection: @cards, as: :card %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards found for “<%= @query %>”</div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Type above to search cards by title, description, or comments</div>
+  <% end %>
+</section>
