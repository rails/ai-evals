diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..98b733d
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,59 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  class_methods do
+    def stalled
+      base = active.where(last_active_at: ..STALLED_AFTER.ago)
+      stalled_ids = base.filter_map { |card| card.id if card.had_burst? }
+      base.where(id: stalled_ids)
+    end
+  end
+
+  def stalled?
+    if active? && last_active_at.present? && last_active_at <= STALLED_AFTER.ago
+      had_burst?
+    else
+      false
+    end
+  end
+
+  def had_burst?
+    if ever_assigned? || ever_reopened?
+      true
+    else
+      comment_burst?
+    end
+  end
+
+  def comment_burst?
+    records = comments.by_user.order(:created_at, :id).pluck(:created_at, :creator_id)
+
+    if records.size >= 3
+      window = burst_window
+      records.each_cons(3).any? do |(first_at, first_creator), (_, second_creator), (third_at, third_creator)|
+        (third_at - first_at) <= window && [ first_creator, second_creator, third_creator ].uniq.size >= 2
+      end
+    else
+      false
+    end
+  end
+
+  def ever_assigned?
+    if assigned?
+      true
+    else
+      events.where(action: "card_assigned").exists?
+    end
+  end
+
+  def ever_reopened?
+    events.where(action: "card_reopened").exists?
+  end
+
+  private
+    def burst_window
+      board.auto_postpone_period.to_i / 3.0
+    end
+end
