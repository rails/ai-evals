diff --git a/app/views/account/imports/new.html.erb b/app/views/account/imports/new.html.erb
new file mode 100644
index 0000000..45a410e
--- /dev/null
+++ b/app/views/account/imports/new.html.erb
@@ -0,0 +1,25 @@
+<% @page_title = "Import account" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Import account</h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Bring an account file back in</h2>
+        <p class="margin-none">Choose an account export .zip file. We'll create a new account with everything in it — boards, cards, comments, files, people.</p>
+      </header>
+
+      <%= form_with model: @import, url: account_imports_path, method: :post, html: { multipart: true } do |form| %>
+        <div class="flex flex-column gap">
+          <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+          <%= form.submit "Import account", class: "btn btn--primary" %>
+        </div>
+      <% end %>
+
+      <p class="txt-small txt-tinted">You'll get an email when it's done, or when it failed and why.</p>
+    </section>
+  </div>
+</div>
diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
new file mode 100644
index 0000000..f341d4f
--- /dev/null
+++ b/app/views/account/imports/show.html.erb
@@ -0,0 +1,25 @@
+<% @page_title = "Import status" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Import status</h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <% if @import.completed? %>
+        <p>Your import is complete.</p>
+        <% if @import.account %>
+          <p><%= link_to "Open your new account", root_path(script_name: @import.account.slug), class: "btn btn--primary" %></p>
+        <% end %>
+      <% elsif @import.failed? %>
+        <p>Your import failed.</p>
+        <% if @import.error_message.present? %>
+          <p>Reason: <%= @import.error_message %></p>
+        <% end %>
+      <% else %>
+        <p>Your import is being processed. You'll get an email when it's done.</p>
+      <% end %>
+    </section>
+  </div>
+</div>
