@@ -0,0 +1,36 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Current.account.exports.create!(
+      creator: Current.user,
+      export_type: "account",
+      status: "pending"
+    )
+    export.generate_later
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Your export is being prepared. You'll get an email when it's ready." }
+      format.json { render json: { id: export.id, status: export.status }, status: :created }
+    end
+  end
+
+  def show
+    @export = Current.account.exports.find(params[:id])
+
+    unless @export.accessible_to?(Current.user)
+      head :forbidden and return
+    end
+
+    respond_to do |format|
+      format.html do
+        if @export.completed? && @export.file.attached?
+          redirect_to exports_download_path(@export.download_token, script_name: "")
+        else
+          redirect_to account_settings_path, notice: "Export is still being prepared."
+        end
+      end
+      format.json { render json: { id: @export.id, status: @export.status } }
+    end
+  end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..528de77
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,76 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+
+  def new
+    @import = Import.new
+  end
+
+  def create
+    uploaded = extract_uploaded_file
+
+    unless uploaded
+      respond_to do |format|
+        format.html do
+          @import = Import.new
+          flash.now[:alert] = "Please choose a file to import."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { error: "File is required" }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    new_account = Account.create!(name: "Importing…")
+
+    filename = uploaded.respond_to?(:original_filename) ? uploaded.original_filename : "import.zip"
+    import = Import.create!(identity: Current.identity, account: new_account, original_filename: filename)
+
+    Current.with_account(new_account) do
+      import.file.attach(uploaded)
+    end
+    import.process_later
+
+    respond_to do |format|
+      format.html do
+        if Current.account
+          redirect_to root_path, notice: "Your import is being processed. You'll get an email when it's done."
+        else
+          redirect_to session_menu_path(script_name: nil), notice: "Your import is being processed. You'll get an email when it's done."
+        end
+      end
+      format.json { render json: { id: import.id, status: import.status }, status: :created }
+    end
+  rescue ActiveRecord::RecordInvalid => error
+    respond_to do |format|
+      format.html do
+        @import = Import.new
+        flash.now[:alert] = error.message
+        render :new, status: :unprocessable_entity
+      end
+      format.json { render json: { error: error.message }, status: :unprocessable_entity }
+    end
+  end
+
+  def show
+    @import = Current.identity.imports.find(params[:id])
+
+    respond_to do |format|
+      format.html
+      format.json { render json: { id: @import.id, status: @import.status, error_message: @import.error_message, account_id: @import.account_id } }
+    end
+  rescue ActiveRecord::RecordNotFound
+    respond_to do |format|
+      format.html { head :not_found }
+      format.json { render json: { error: "Not found" }, status: :not_found }
+    end
+  end
+
+  private
+    def extract_uploaded_file
+      if params[:import] && params[:import][:file]
+        params[:import][:file]
+      elsif params[:file]
+        params[:file]
+      end
+    end
+end
diff --git a/app/controllers/exports/downloads_controller.rb b/app/controllers/exports/downloads_controller.rb
