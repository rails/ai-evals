@@ -0,0 +1,38 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.account
+    @identity = import.identity
+
+    if @account
+      Current.with_account(@account) do
+        @account_url = root_url(script_name: @account.slug, host: host_for_mailer)
+        mail(
+          to: @identity.email_address,
+          subject: "Your Fizzy import is complete"
+        )
+      end
+    else
+      mail(
+        to: @identity.email_address,
+        subject: "Your Fizzy import is complete"
+      )
+    end
+  end
+
+  def failed(import)
+    @import = import
+    @identity = import.identity
+    @error_message = import.error_message
+
+    mail(
+      to: @identity.email_address,
+      subject: "Your Fizzy import failed"
+    )
+  end
+
+  private
+    def host_for_mailer
+      Rails.application.config.action_mailer.default_url_options&.dig(:host) || "example.com"
+    end
+end
