+    def write_record(blob)
+      path = "files/#{blob.id}/#{blob.filename}"
+      begin
+        blob.open do |file|
+          zip.add_file(path, compress: false) do |sink|
+            IO.copy_stream(file, sink)
+          end
+        end
+      rescue => error
+        Rails.logger.error("Failed to export file for blob #{blob.id}: #{error.message}")
+      end
