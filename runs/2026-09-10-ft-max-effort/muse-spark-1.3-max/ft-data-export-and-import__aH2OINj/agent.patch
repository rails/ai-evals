new file mode 100644
index 0000000..bc8e6c9
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,50 @@
+class Import < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :identity, class_name: "Identity"
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself), default: "pending"
+
+  thread_mattr_accessor :suppressing_callbacks, default: false
+
+  class << self
+    def suppressing_callbacks?
+      suppressing_callbacks
+    end
+
+    def without_callbacks(&block)
+      original = suppressing_callbacks
+      self.suppressing_callbacks = true
+      yield
+    ensure
+      self.suppressing_callbacks = original
+    end
+  end
+
+  def process_later
+    if account
+      Current.with_account(account) do
+        ImportJob.perform_later(self)
+      end
+    else
+      ImportJob.perform_later(self)
+    end
+  end
+
+  def process_now
+    Account::DataTransfer::Importer.new(self).import!
+  rescue => error
+    Rails.error.report(error, severity: :error)
+    raise
+  end
+
+  def accessible_to?(user)
+    return false unless user
+    user.identity_id == identity_id
+  end
+
+  def publicly_accessible?
+    false
+  end
+end
