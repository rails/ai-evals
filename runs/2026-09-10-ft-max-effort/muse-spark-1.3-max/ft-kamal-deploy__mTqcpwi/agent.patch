index 7e81725..42dfa58 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,33 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Host for URLs generated outside requests (mailers, jobs). Set APP_HOST to
+  # the same public hostname as the Kamal proxy host (see config/deploy.yml).
+  # fizzy-saas overrides this with its own hosts, so this only applies when APP_HOST is set.
+  if (app_host = ENV["APP_HOST"].presence)
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+  end
+
+  # Outbound email via SMTP for self-hosted installs (see config/deploy.yml and docs/deploying.md).
+  # Set SMTP_ADDRESS (plus SMTP_PORT, SMTP_DOMAIN, SMTP_USERNAME, SMTP_PASSWORD, etc).
+  # fizzy-saas sets its own smtp_settings, so this only applies when SMTP_ADDRESS is set.
+  if ENV["SMTP_ADDRESS"].present?
+    smtp_username = ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence
+    smtp_settings = {
+      address: ENV.fetch("SMTP_ADDRESS"),
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: ENV.fetch("SMTP_DOMAIN") { ENV["APP_HOST"].presence || "localhost" },
+      user_name: smtp_username,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV["SMTP_AUTHENTICATION"].presence&.to_sym || (smtp_username ? :plain : nil),
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }
+    smtp_settings[:tls] = true if ENV["SMTP_TLS"] == "true"
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = smtp_settings.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
