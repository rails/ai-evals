+# Fizzy one-box secrets. Safe for git: values are read from your local ENV,
+# never enter raw credentials here. See docs/deploying.md.
+#
+# Required secrets (must be set in ENV before `bin/kamal setup` / `bin/kamal deploy`):
+#
+#   Generate once and export:
+#     openssl rand -hex 64
+#     # or: bin/rails secret
+#     export SECRET_KEY_BASE=<generated value>
+#     export SMTP_PASSWORD=<your smtp password>
+#
+# Kamal loads this file with dotenv, so `$VAR` below reads your exported ENV.
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Only needed if you switch config/deploy.yml to an external registry
+# (Docker Hub, GHCR, etc). Use an access token, not your real password.
+# Export it first: export KAMAL_REGISTRY_PASSWORD=<token>
+# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Optional: browser push notifications. Generate with the web-push gem
+# (see docs/development.md "Web Push Notifications") and export before deploying:
+# export VAPID_PRIVATE_KEY=<private> VAPID_PUBLIC_KEY=<public>
+# VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+# VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
