+# Fizzy one-box Kamal config.
+#
+# Target: a single Linux server with Docker, SQLite, everything in one
+# container, SSL terminated by kamal-proxy.
+#
+# Fork setup:
+#   1. Fill in your server, hostname, and mail server below (marked TODO).
+#   2. Fill in secrets in .kamal/secrets (SECRET_KEY_BASE, SMTP_PASSWORD).
+#   3. Run `bin/kamal setup` and open https://your-host.
+#
+# Data (SQLite databases + Active Storage files) lives in the named volume
+# `fizzy_storage` mounted at /rails/storage, so it survives redeploys.
+# Background jobs run on the box inside Puma via Solid Queue
+# (SOLID_QUEUE_IN_PUMA=true). No separate job container is needed until you
+# grow beyond one box.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. With the local registry below this becomes
+# localhost:5555/fizzy, so no external registry account is needed.
+image: fizzy
+
+# Deploy to a single server. Replace with your server's IP or hostname.
+# Kamal will bootstrap Docker on it during `bin/kamal setup`.
+servers:
+  web:
+    - your-server-host # TODO: e.g. 203.0.113.10 or fizzy.example.com
+
+# SSL is terminated by kamal-proxy via Let's Encrypt. Requires a single
+# server, a public DNS hostname pointing at it, and ports 80/443 open.
+# Note: If using Cloudflare, set encryption mode in SSL/TLS setting to "Full".
+proxy:
+  ssl: true
+  host: fizzy.example.com # TODO: your public hostname, same as APP_HOST below
+  # Proxy connects to Thruster on port 80 by default, which matches Dockerfile EXPOSE 80.
+  # app_port: 80
+
+# Local registry avoids needing Docker Hub / GHCR for a single box. Kamal runs
+# a registry on your machine and forwards it to the server over SSH.
+registry:
+  server: localhost:5555
+  # To use an external registry instead (Docker Hub, GHCR, etc), comment out
+  # the server above and use:
+  # server: ghcr.io
+  # username: your-registry-username
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Build a single-arch image for your server. Most servers are amd64; use arm64
+# for Ampere/Graviton/ARM boxes.
+builder:
+  arch: amd64
+
+# ENV injected into the container. Secrets come from .kamal/secrets.
+env:
+  clear:
+    # Run Solid Queue inside Puma so one container does web + jobs.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Public hostname for URLs in emails and background jobs. Must match proxy host above.
+    APP_HOST: fizzy.example.com # TODO: same as proxy host
+
+    # From: header for magic-link and notification emails.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@fizzy.example.com>" # TODO
+
+    # Outbound SMTP. Fill in your mail server; password stays in .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com # TODO
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com # TODO: usually same as APP_HOST
+    SMTP_USERNAME: fizzy@example.com # TODO: remove if your server needs no auth
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    # SMTP_TLS: false # set to true for implicit TLS (usually port 465)
+
+    # Optional tuning (uncomment to override defaults):
+    # WEB_CONCURRENCY: 1
+    # JOB_CONCURRENCY: 1
+    # RAILS_LOG_LEVEL: info
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Uncomment if you set VAPID keys for web push (see .kamal/secrets):
+    # - VAPID_PRIVATE_KEY
+    # - VAPID_PUBLIC_KEY
+
+# Persist SQLite (*.sqlite3) and Active Storage files across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Share fingerprinted assets between versions to avoid 404s on in-flight requests.
+asset_path: /rails/public/assets
+
+# Shortcuts: `bin/kamal console`, `bin/kamal shell`, `bin/kamal logs`, `bin/kamal dbc`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# SSH defaults to root. Uncomment and change if your box uses another user.
+# ssh:
+#   user: root
+
+# If you outgrow one box, split jobs to their own role by adding a `job`
+# entry under `servers` above (same or another host) and setting
+# SOLID_QUEUE_IN_PUMA to false on web:
+#
+# servers:
+#   web:
+#     - your-server-host
+#   job:
+#     hosts:
+#       - your-server-host
+#     cmd: bin/jobs
