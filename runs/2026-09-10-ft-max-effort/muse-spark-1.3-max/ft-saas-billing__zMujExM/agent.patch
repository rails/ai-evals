+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex flex-column gap margin-block-half">
+      <div>
+        <strong><%= @account.name %></strong>
+        <div class="txt-x-small txt-ink-medium">
+          #<%= @account.external_account_id %> •
+          <%= pluralize(@account.cards_count, "card") %> •
+          <%= number_to_human_size(@account.bytes_used) %> used •
+          Plan: <%= @account.try(:plan_name) || @account.try(:plan) || "Free" %> •
+          <%= @account.comped? ? "Comped" : "Not comped" %>
+        </div>
+      </div>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.comp_admin_account_path(@account), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+      </div>
+
+      <div>
+        <h2 class="divider txt-medium margin-block-start">Override limits</h2>
+        <%= form_with model: @overridden_limit, url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap-half" do |form| %>
+          <div class="flex flex-column gap-quarter">
+            <%= form.label :card_count, "Card count" %>
+            <%= form.number_field :card_count, class: "input", value: @overridden_limit.card_count %>
+          </div>
+          <div class="flex flex-column gap-quarter">
+            <%= form.label :bytes_used, "Bytes used" %>
+            <%= form.number_field :bytes_used, class: "input", value: @overridden_limit.bytes_used %>
+          </div>
+          <div class="flex gap-half">
+            <%= form.submit "Override", class: "btn btn--reversed" %>
+          </div>
+        <% end %>
+        <div class="margin-block-start-half">
+          <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :post, class: "btn" %>
+        </div>
+      </div>
+
+      <% if @subscription.present? %>
+        <div>
+          <h2 class="divider txt-medium margin-block-start">Subscription</h2>
+          <div class="txt-small">
+            Plan: <%= @subscription.plan_key %><br>
+            Status: <%= @subscription.status %><br>
+            Customer: <%= @subscription.stripe_customer_id %><br>
+            Subscription: <%= @subscription.stripe_subscription_id %>
+          </div>
+        </div>
+      <% end %>
+    </div>
+  </div>
+</section>
