diff --git a/saas/app/controllers/account/billings_controller.rb b/saas/app/controllers/account/billings_controller.rb
new file mode 100644
index 0000000..89ec74f
--- /dev/null
+++ b/saas/app/controllers/account/billings_controller.rb
@@ -0,0 +1,91 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    redirect_to account_settings_path
+  end
+
+  def checkout
+    # Delegate to billing checkout logic
+    plan = params[:plan].presence || "unlimited"
+    normalized = normalize_plan(plan)
+
+    price_id = price_id_for_plan(normalized)
+    price_id = "price_unlimited_test" if price_id.blank? && normalized == "unlimited"
+    price_id = "price_unlimited_plus_test" if price_id.blank? && normalized == "unlimited_plus"
+
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+
+    success_url = account_settings_url(script_name: Current.account.slug) + "?upgraded=1"
+    cancel_url = account_settings_url(script_name: Current.account.slug)
+
+    customer_email = Current.user.identity&.email_address || Current.account.owner_email
+
+    session = Stripe::Checkout::Session.create(
+      mode: "subscription",
+      client_reference_id: Current.account.id,
+      customer_email: customer_email,
+      metadata: {
+        account_id: Current.account.id,
+        external_account_id: Current.account.external_account_id,
+        plan: normalized
+      },
+      subscription_data: {
+        metadata: {
+          account_id: Current.account.id,
+          external_account_id: Current.account.external_account_id,
+          plan: normalized
+        }
+      },
+      line_items: [ { price: price_id, quantity: 1 } ],
+      success_url: success_url,
+      cancel_url: cancel_url
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  def portal
+    customer_id = Current.account.subscription&.stripe_customer_id
+
+    if customer_id.blank?
+      redirect_to account_settings_path, alert: "No billing account yet" and return
+    end
+
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+
+    return_url = account_settings_url(script_name: Current.account.slug)
+
+    session = Stripe::BillingPortal::Session.create(
+      customer: customer_id,
+      return_url: return_url
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def normalize_plan(plan)
+      key = plan.to_s.downcase.strip
+      if key.include?("plus") || key.include?("extra")
+        "unlimited_plus"
+      elsif key.include?("unlimited")
+        "unlimited"
+      else
+        "unlimited"
+      end
+    end
+
+    def price_id_for_plan(plan)
+      if plan == "unlimited_plus"
+        ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].presence ||
+          ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"].presence ||
+          ENV["STRIPE_UNLIMITED_PLUS_V1_PRICE_ID"].presence ||
+          ENV["STRIPE_PLUS_PRICE_ID"].presence
+      else
+        ENV["STRIPE_MONTHLY_V1_PRICE_ID"].presence ||
+          ENV["STRIPE_UNLIMITED_PRICE_ID"].presence ||
+          ENV["STRIPE_UNLIMITED_V1_PRICE_ID"].presence
+      end
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..6c5566c
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,57 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc).limit(200)
+  end
+
+  def show
+    @account = find_account
+    @subscription = @account.subscription
+    @overridden_limit = @account.overridden_limit || @account.build_overridden_limit
+  end
+
+  def comp
+    @account = find_account
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account = find_account
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Comp removed"
+  end
+
+  def override
+    @account = find_account
+
+    card_count = override_param(:card_count)
+    bytes_used = override_param(:bytes_used)
+
+    @account.override_limits!(card_count: card_count, bytes_used: bytes_used)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  end
+
+  def reset
+    @account = find_account
+    @account.reset_overridden_limits!
+    redirect_to saas.admin_account_path(@account), notice: "Override reset"
+  end
+
+  private
+    def find_account
+      Account.find_by(id: params[:id]) ||
+        Account.find_by(external_account_id: params[:id]) ||
+        Account.find(params[:id])
+    end
+
+    def override_param(key)
+      # Support multiple param shapes: nested under overridden_limit/account_overridden_limit, or top-level
+      value = params.dig(:account_overridden_limit, key) ||
+              params.dig(:overridden_limit, key) ||
+              params.dig(:override, key) ||
+              params[key]
+      value
+    end
+end
