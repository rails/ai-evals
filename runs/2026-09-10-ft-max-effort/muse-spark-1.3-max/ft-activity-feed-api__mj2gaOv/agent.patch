diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..0b8c145
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,44 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ]
+
+  def index
+    events = Event.preloaded
+      .where(board: boards)
+      .where(action: TIMELINEABLE_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+
+    events = events.where(creator_id: creator_ids) if creator_ids.present?
+
+    set_page_and_extract_portion_from events
+  end
+
+  private
+    def boards
+      if board_ids.present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..de95abe
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,33 @@
+json.(activity, :id, :action, :eventable_type)
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+json.url polymorphic_url(activity.eventable)
+
+particulars = case activity.action
+when "card_assigned", "card_unassigned"
+  { assignee_ids: Array(activity.assignee_ids) }
+when "card_board_changed"
+  details = activity.particulars.dig("particulars") || {}
+  { old_board: details["old_board"] || details["old_collection"] || "", new_board: details["new_board"] || details["new_collection"] || "" }
+when "card_title_changed"
+  details = activity.particulars.dig("particulars") || {}
+  { old_title: details["old_title"] || "", new_title: details["new_title"] || "" }
+when "card_triaged"
+  details = activity.particulars.dig("particulars") || {}
+  { column: details["column"] || "" }
+else
+  {}
+end
+json.particulars particulars
+
+json.eventable do
+  case activity.eventable
+  when Card
+    json.partial! "cards/card", card: activity.eventable
+  when Comment
+    json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
