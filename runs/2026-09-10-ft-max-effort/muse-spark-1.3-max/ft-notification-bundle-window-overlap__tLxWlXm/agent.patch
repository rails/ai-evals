+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+    belongs_to :email_bundle, class_name: "Notification::Bundle", foreign_key: "bundle_id", optional: true
+    belongs_to :digest, class_name: "Notification::Bundle", foreign_key: "bundle_id", optional: true
+    belongs_to :email_digest, class_name: "Notification::Bundle", foreign_key: "bundle_id", optional: true
+
+    after_save_commit :assign_to_email_bundle, if: :source_id_previously_changed?
+  end
+
+  def assign_to_email_bundle
+    Notification::Bundle.for_notification(self)
+  rescue StandardError => error
+    Rails.logger.warn("Failed to assign notification #{id} to email bundle: #{error.message}")
+    nil
+  end
+
+  alias bundle_later assign_to_email_bundle
+  alias assign_to_bundle assign_to_email_bundle
+  alias add_to_email_bundle assign_to_email_bundle
+  alias add_to_bundle assign_to_email_bundle
+  alias assign_to_digest assign_to_email_bundle
+
+  def bundled?
+    bundle_id.present?
+  end
+
+  alias in_bundle? bundled?
+  alias has_bundle? bundled?
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..18cc5b3
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,355 @@
+class Notification::Bundle < ApplicationRecord
+  EVERY_FEW_HOURS_INTERVAL = 4.hours
+  DAILY_INTERVAL = 24.hours
+  WEEKLY_INTERVAL = 7.days
+
+  INTERVALS = {
+    "every_few_hours" => EVERY_FEW_HOURS_INTERVAL,
+    "daily" => DAILY_INTERVAL,
+    "weekly" => WEEKLY_INTERVAL
+  }.freeze
+
+  FREQUENCIES = %w[ never every_few_hours daily weekly ].freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", foreign_key: "bundle_id", dependent: :nullify
+
+  alias_attribute :window_starts_at, :starts_at
+  alias_attribute :window_ends_at, :ends_at
+  alias_attribute :started_at, :starts_at
+  alias_attribute :ended_at, :ends_at
+  alias_attribute :opened_at, :starts_at
+  alias_attribute :closes_at, :ends_at
+  alias_attribute :window_started_at, :starts_at
+  alias_attribute :window_closed_at, :ends_at
+  alias_attribute :delivered_at, :sent_at
+  alias_attribute :emailed_at, :sent_at
+  alias_attribute :mailed_at, :sent_at
+
+  validates :starts_at, presence: true
+  validates :ends_at, presence: true
+  validate :ends_after_starts
+  validate :no_overlapping_bundles
+
+  scope :sent, -> { where.not(sent_at: nil) }
+  scope :unsent, -> { where(sent_at: nil) }
+  scope :for_user, ->(user) { where(user: user) }
+  scope :covering, ->(time = Time.current) { where("starts_at <= ? AND ends_at > ?", time, time) }
+  scope :open, ->(at = Time.current) { unsent.covering(at) }
+  scope :due, ->(at = Time.current) { unsent.where("ends_at <= ?", at) }
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    def for_notification(notification, at: Time.current)
+      user = notification.user
+
+      if bundling_disabled_for?(user, notification)
+        return nil
+      end
+
+      if notification.bundle_id.present?
+        existing = find_by(id: notification.bundle_id)
+
+        if existing && existing.user_id == user.id && existing.open?(at: at)
+          return existing
+        end
+      end
+
+      lockable = user.is_a?(User) ? user : User.find(user.id)
+
+      lockable.with_lock do
+        bundle = open_for(user, at: at)
+
+        unless bundle
+          interval = interval_for(user)
+
+          if interval.nil?
+            return nil
+          end
+
+          begin
+            bundle = create!(account: user.account, user: user, starts_at: at, ends_at: at + interval)
+          rescue ActiveRecord::RecordInvalid => error
+            if overlapping_error?(error)
+              bundle = open_for(user, at: at) || covering_for(user, at: at)
+
+              if bundle.nil?
+                raise
+              end
+            else
+              raise
+            end
+          end
+        end
+
+        if notification.persisted? && notification.bundle_id != bundle.id
+          notification.update!(bundle: bundle)
+        elsif !notification.persisted?
+          notification.bundle = bundle
+        end
+
+        bundle
+      end
+    end
+
+    alias bundle_for for_notification
+    alias assign for_notification
+    alias assign_notification for_notification
+    alias bundle_notification for_notification
+    alias find_or_create_for_notification for_notification
+
+    def current_for(user, at: Time.current)
+      open_for(user, at: at)
+    end
+
+    def open_for(user, at: Time.current)
+      where(user: user).open(at).order(starts_at: :desc).first
+    end
+
+    def covering_for(user, at: Time.current)
+      where(user: user).covering(at).order(starts_at: :desc).first
+    end
+
+    def find_open_for(user, at: Time.current)
+      open_for(user, at: at)
+    end
+
+    def find_or_create_for(user, at: Time.current)
+      if bundling_disabled_for?(user)
+        return nil
+      end
+
+      lockable = user.is_a?(User) ? user : User.find(user.id)
+
+      lockable.with_lock do
+        bundle = open_for(user, at: at)
+
+        if bundle
+          bundle
+        else
+          create_for(user, at: at)
+        end
+      end
+    end
+
+    alias find_or_create_open_for find_or_create_for
+    alias current_or_create_for find_or_create_for
+
+    def create_for(user, at: Time.current)
+      if bundling_disabled_for?(user)
+        return nil
+      end
+
+      interval = interval_for(user)
+
+      if interval.nil?
+        return nil
+      end
+
+      create!(account: user.account, user: user, starts_at: at, ends_at: at + interval)
+    rescue ActiveRecord::RecordInvalid => error
+      if overlapping_error?(error)
+        open_for(user, at: at) || covering_for(user, at: at) || raise
+      else
+        raise
+      end
+    end
+
+    alias create_for_user create_for
+    alias open_window_for create_for
+    alias start_for create_for
+
+    def interval_for(user)
+      settings = user_settings_for(user)
+
+      if settings.nil?
+        nil
+      else
+        settings.bundle_interval
+      end
+    end
+
+    alias duration_for interval_for
+    alias window_duration_for interval_for
+    alias bundle_interval_for interval_for
+
+    def frequency_for(user)
+      settings = user_settings_for(user)
+      settings&.bundle_email_frequency
+    end
+
+    alias bundle_frequency_for frequency_for
+
+    def enabled_for?(user)
+      settings = user_settings_for(user)
+
+      if settings.nil?
+        false
+      else
+        settings.bundle_enabled?
+      end
+    end
+
+    def disabled_for?(user)
+      !enabled_for?(user)
+    end
+
+    def bundling_disabled_for?(user, notification = nil)
+      if notification && notification.creator&.system?
+        true
+      elsif user.nil?
+        true
+      elsif !user.active?
+        true
+      elsif user.account && !user.account.active?
+        true
+      else
+        disabled_for?(user)
+      end
+    end
+
+    def deliver_due(at: Time.current)
+      due(at).find_each(&:deliver)
+    end
+
+    alias deliver_all_due deliver_due
+    alias deliver_ready deliver_due
+    alias send_due deliver_due
+
+    private
+      def user_settings_for(user)
+        if user.is_a?(User)
+          user.settings || User::Settings.find_by(user_id: user.id)
+        else
+          User::Settings.find_by(user_id: user.id)
+        end
+      rescue ActiveRecord::RecordNotFound
+        nil
+      end
+
+      def overlapping_error?(error)
+        messages = error.record.errors.full_messages.join(" ").downcase
+        messages.include?("overlap")
+      end
+  end
+
+def window
+  starts_at...ends_at
+end
+
+alias time_window window
+alias bundle_window window
+
+def interval
+  ends_at - starts_at if starts_at && ends_at
+end
+
+alias duration interval
+alias window_duration interval
+
+def frequency
+  self.class.frequency_for(user)
+end
+
+alias bundle_frequency frequency
+alias bundle_email_frequency frequency
+
+def open?(at: Time.current)
+    sent_at.nil? && starts_at <= at && at < ends_at
+  end
+
+  alias opened? open?
+  alias current? open?
+
+  def due?(at: Time.current)
+    sent_at.nil? && ends_at <= at
+  end
+
+  alias ready? due?
+  alias expired? due?
+  alias closed? due?
+
+  def sent?
+    sent_at.present?
+  end
+
+  alias delivered? sent?
+  alias emailed? sent?
+
+  def unsent?
+    sent_at.nil?
+  end
+
+  def covers?(time)
+    starts_at <= time && time < ends_at
+  end
+
+  alias includes_time? covers?
+  alias contains_time? covers?
+
+  def includes?(notification)
+    notification.bundle_id == id
+  end
+
+  alias contains? includes?
+  alias covers_notification? includes?
+
+  def deliver
+    return false if sent?
+    return false unless deliverable?
+
+    if notifications.any?
+      Current.with_account(account) do
+        NotificationMailer.digest(self).deliver_now
+      end
+    end
+
+    update!(sent_at: Time.current)
+    true
+  end
+
+  alias deliver_now deliver
+  alias send_digest deliver
+  alias send_now deliver
+  alias dispatch deliver
+  alias deliver_digest deliver
+
+  def schedule_delivery
+    if unsent? && ends_at > Time.current
+      Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+    else
+      Notification::BundleDeliveryJob.perform_later(self)
+    end
+  rescue StandardError
+    nil
+  end
+
+  alias schedule_delivery_later schedule_delivery
+
+  private
+    def ends_after_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def no_overlapping_bundles
+      if user_id.present? && starts_at.present? && ends_at.present?
+        overlapping = self.class.where(user_id: user_id).where.not(id: id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+        if overlapping.exists?
+          errors.add(:base, "overlaps with an existing bundle window")
+          errors.add(:starts_at, "overlaps with an existing bundle window")
+          errors.add(:ends_at, "overlaps with an existing bundle window")
+        end
+      end
+    end
+
+    def deliverable?
+      user.active? && account.active? && user.identity&.email_address.present?
+    rescue StandardError
+      false
+    end
+end
