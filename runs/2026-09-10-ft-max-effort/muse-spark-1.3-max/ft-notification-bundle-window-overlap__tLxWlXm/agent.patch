@@ -0,0 +1,17 @@
+class Notification::BundleDeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    fresh = Notification::Bundle.find_by(id: bundle.id) || bundle
+
+    if fresh.sent?
+      return
+    elsif fresh.ends_at <= Time.current
+      fresh.deliver
+    else
+      # Window not yet closed; skip early delivery. The bundle will be
+      # delivered when due via the recurring deliver_due sweep.
+      nil
+    end
+  end
+end
