+      <%= notification.payload.body %><br>
+      <%= link_to "View", notification.payload.url %>
+    </li>
+  <% end %>
+</ul>
+
+<p><%= link_to "View all notifications", notifications_url(script_name: @account.slug) %></p>
+
+<p class="footer">Need help? <%= mail_to "support@fizzy.do", "Send us an email" %>.</p>
