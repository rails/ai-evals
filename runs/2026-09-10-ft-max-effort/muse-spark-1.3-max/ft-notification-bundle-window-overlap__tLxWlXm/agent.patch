@@ -0,0 +1,23 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.ordered
+
+    Current.with_account(@account) do
+      mail to: @user.identity.email_address, subject: digest_subject
+    end
+  end
+
+  private
+    def digest_subject
+      count = @notifications.size
+
+      if count == 1
+        "You have 1 new notification"
+      else
+        "You have #{count} new notifications"
+      end
+    end
+end
