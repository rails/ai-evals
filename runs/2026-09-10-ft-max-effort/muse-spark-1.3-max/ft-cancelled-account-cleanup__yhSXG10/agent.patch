diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..67d3da0 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,88 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+  end
+
+  def incineration_due?
+    if cancelled?
+      cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+    else
+      false
+    end
+  end
+
+  def incinerate
+    destroy!
+  ensure
+    purge_orphaned_account_data
+  end
+
+  private
+    def purge_orphaned_account_data
+      account_id = id
+
+      Storage::Entry.where(account_id: account_id).delete_all
+
+      ActiveStorage::Attachment.where(account_id: account_id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: account_id).delete_all
+      purge_account_blobs(account_id)
+      ActionText::RichText.where(account_id: account_id).delete_all
+
+      Search::Record.for(account_id).where(account_id: account_id).destroy_all
+
+      Access.where(account_id: account_id).delete_all
+      Account::Cancellation.where(account_id: account_id).delete_all
+      Account::Import.where(account_id: account_id).delete_all
+      Account::JoinCode.where(account_id: account_id).delete_all
+      Assignment.where(account_id: account_id).delete_all
+      Board.where(account_id: account_id).delete_all
+      Board::Publication.where(account_id: account_id).delete_all
+      Card.where(account_id: account_id).delete_all
+      Card::ActivitySpike.where(account_id: account_id).delete_all
+      Card::Goldness.where(account_id: account_id).delete_all
+      Card::NotNow.where(account_id: account_id).delete_all
+      Closure.where(account_id: account_id).delete_all
+      Column.where(account_id: account_id).delete_all
+      Comment.where(account_id: account_id).delete_all
+      Entropy.where(account_id: account_id).delete_all
+      Event.where(account_id: account_id).delete_all
+      Export.where(account_id: account_id).delete_all
+      Filter.where(account_id: account_id).delete_all
+      Mention.where(account_id: account_id).delete_all
+      Notification.where(account_id: account_id).delete_all
+      Notification::Bundle.where(account_id: account_id).delete_all
+      Pin.where(account_id: account_id).delete_all
+      Push::Subscription.where(account_id: account_id).delete_all
+      Reaction.where(account_id: account_id).delete_all
+      Search::Query.where(account_id: account_id).delete_all
+      Step.where(account_id: account_id).delete_all
+      Tag.where(account_id: account_id).delete_all
+      Tagging.where(account_id: account_id).delete_all
+      User.where(account_id: account_id).delete_all
+      User::Settings.where(account_id: account_id).delete_all
+      Watch.where(account_id: account_id).delete_all
+      Webhook.where(account_id: account_id).delete_all
+      Webhook::DelinquencyTracker.where(account_id: account_id).delete_all
+      Webhook::Delivery.where(account_id: account_id).delete_all
+    end
+
+    def purge_account_blobs(account_id)
+      ActiveStorage::Blob.where(account_id: account_id).find_each do |blob|
+        begin
+          blob.purge
+        rescue
+          blob.delete
+        end
+      end
+    end
 end
