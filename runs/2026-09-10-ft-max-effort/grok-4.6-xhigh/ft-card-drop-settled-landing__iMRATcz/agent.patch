diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..f9dd803
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,131 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "dragging a card from maybe into a column moves it immediately and persists" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_triage)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+    drag_card card, to: "##{dom_id(column)}"
+
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    assert_card_in_column card, column
+  end
+
+  test "dragging a card onto Done closes it immediately" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_selector "#closed-cards .cards__list", visible: :all
+
+    drag_card card, to: "#closed-cards"
+
+    assert_selector "#closed-cards ##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    wait_until { card.reload.closed? }
+    assert card.closed?
+  end
+
+  test "dragging a card onto Not Now postpones it immediately" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_selector "#not-now .cards__list", visible: :all
+
+    drag_card card, to: "#not-now"
+
+    assert_selector "#not-now ##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    wait_until { card.reload.postponed? }
+    assert card.postponed?
+  end
+
+  test "dragging a triaged card back to Maybe untriages it" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    visit board_url(boards(:writebook))
+    find("##{dom_id(column)} .cards__expander").click
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}"
+
+    drag_card card, to: "#maybe"
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    wait_until { card.reload.column.nil? }
+    assert_nil card.column
+  end
+
+  test "dragging a closed card onto a column reopens and triages it" do
+    card = cards(:shipping)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    find("#closed-cards .cards__expander").click
+    assert_selector "#closed-cards ##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+    drag_card card, to: "##{dom_id(column)}"
+
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+    wait_until { card.reload.column == column && card.open? }
+    assert_equal column, card.column
+    assert card.open?
+  end
+
+  test "dropping a card on its current column does not persist a change" do
+    card = cards(:buy_domain)
+    original_active_at = card.last_active_at
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+
+    drag_card card, to: "#maybe"
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    sleep 0.5
+    assert_equal original_active_at.to_i, card.reload.last_active_at.to_i
+  end
+
+  private
+    def drag_card(card, to:)
+      source = find("##{dom_id(card, :article)}", visible: :all)
+      target = find(to, visible: :all)
+
+      page.execute_script(<<~JS, source, target)
+        const source = arguments[0]
+        const target = arguments[1]
+        const dt = new DataTransfer()
+
+        source.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: dt }))
+        target.dispatchEvent(new DragEvent("dragenter", { bubbles: true, cancelable: true, dataTransfer: dt }))
+        target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: dt }))
+        target.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: dt }))
+        source.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: dt }))
+      JS
+    end
+
+    def assert_card_in_column(card, column)
+      wait_until { card.reload.column == column }
+      assert_equal column, card.column
+    end
+
+    def wait_until(time: Capybara.default_max_wait_time)
+      deadline = Time.now + time
+      until yield
+        raise "condition not met after #{time}s" if Time.now > deadline
+        sleep 0.1
+      end
+    end
+end
