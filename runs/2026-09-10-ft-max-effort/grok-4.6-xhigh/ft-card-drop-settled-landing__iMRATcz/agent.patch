diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..96d7129
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,145 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Cards jump columns as soon as you drop them. Persistence happens in the
+// background as JSON so a Turbo Stream redraw can't shuffle the board afterwards.
+// Drops target a whole column, never a position within one.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #item = null
+
+  itemTargetConnected(item) {
+    if (this.#desktop) item.draggable = true
+  }
+
+  startDragging(event) {
+    this.#item = this.#itemFrom(event.target)
+    if (!this.#item) return
+
+    this.#item.classList.add(this.draggedItemClass)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", this.#item.id)
+  }
+
+  stopDragging() {
+    this.#item?.classList.remove(this.draggedItemClass)
+    this.#clearHover()
+    this.#item = null
+  }
+
+  enterContainer(event) {
+    if (!this.#item) return
+
+    event.preventDefault()
+    event.currentTarget.classList.add(this.hoverContainerClass)
+  }
+
+  leaveContainer(event) {
+    if (!event.currentTarget.contains(event.relatedTarget)) {
+      event.currentTarget.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  overContainer(event) {
+    if (!this.#item) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+  }
+
+  drop(event) {
+    event.preventDefault()
+
+    const container = event.currentTarget
+    const item = this.#item
+    if (!item) return
+
+    container.classList.remove(this.hoverContainerClass)
+    if (this.#containerFor(item) === container) return
+
+    this.#move(item, container)
+    this.#preventFollowingClick()
+    this.#persist(item, container)
+  }
+
+  #itemFrom(element) {
+    return element.closest("[data-drag-and-drop-target~='item']")
+  }
+
+  #containerFor(element) {
+    return element.closest("[data-drag-and-drop-target~='container']")
+  }
+
+  #move(item, container) {
+    const source = this.#containerFor(item)
+    this.#insert(item, container)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(container, +1)
+  }
+
+  #insert(item, container) {
+    container.querySelector(".cards__list")?.prepend(item)
+  }
+
+  #adjustCount(container, delta) {
+    if (!container) return
+
+    const element = container.querySelector(".cards__expander-count")
+    if (!element) return
+
+    const value = parseInt(element.textContent, 10)
+    if (Number.isNaN(value)) return
+
+    const next = Math.max(0, value + delta)
+    element.textContent = next > 99 ? "99+" : next
+  }
+
+  #preventFollowingClick() {
+    const prevent = (event) => {
+      event.preventDefault()
+      event.stopPropagation()
+    }
+
+    this.element.addEventListener("click", prevent, { capture: true })
+    setTimeout(() => this.element.removeEventListener("click", prevent, { capture: true }), 50)
+  }
+
+  #persist(item, container) {
+    this.#requestFor(item, container)
+  }
+
+  #requestFor(item, container) {
+    const options = { responseKind: "json" }
+    const { dropAction, columnId } = container.dataset
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = item.dataset
+
+    switch (dropAction) {
+      case "triage":
+        if (cardTriageUrl && columnId) {
+          return post(cardTriageUrl, { ...options, query: { column_id: columnId } })
+        }
+        break
+      case "maybe":
+        if (cardTriageUrl) return destroy(cardTriageUrl, options)
+        break
+      case "not_now":
+        if (cardNotNowUrl) return post(cardNotNowUrl, options)
+        break
+      case "closed":
+        if (cardClosureUrl) return post(cardClosureUrl, options)
+        break
+    }
+  }
+
+  #clearHover() {
+    this.containerTargets.forEach(container => {
+      container.classList.remove(this.hoverContainerClass)
+    })
+  }
+
+  get #desktop() {
+    return window.matchMedia("(min-width: 640px)").matches
+  }
+}
