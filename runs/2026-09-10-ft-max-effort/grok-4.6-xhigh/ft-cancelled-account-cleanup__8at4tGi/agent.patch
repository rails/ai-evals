index 0000000..3e757bc
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently removes data for accounts cancelled more than 30 days ago" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    account_id = account.id
+    card_id = cards(:logo).id
+    board_id = boards(:writebook).id
+    user_id = users(:david).id
+
+    travel 31.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account_id)
+    assert_not Card.exists?(card_id)
+    assert_not Board.exists?(board_id)
+    assert_not User.exists?(user_id)
+    assert_not Account::Cancellation.exists?(account_id: account_id)
+
+    assert Account.exists?(accounts(:initech).id)
+    assert Identity.exists?(identities(:david).id)
+  end
+
+  test "does not incinerate accounts cancelled less than 30 days ago" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    travel 29.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+    assert account.reload.cancelled?
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..1730c8f
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerate permanently removes a cancelled account after the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    account_id = @account.id
+    board_ids = @account.boards.ids
+    card_ids = @account.cards.ids
+    user_ids = @account.users.ids
+    comment_ids = Comment.where(account_id: account_id).ids
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(account_id)
+    assert_not Account::Cancellation.exists?(account_id: account_id)
+    assert_not Board.where(id: board_ids).exists?
+    assert_not Card.where(id: card_ids).exists?
+    assert_not User.where(id: user_ids).exists?
+    assert_not Comment.where(id: comment_ids).exists?
+
+    assert Account.exists?(accounts(:initech).id)
+    assert Identity.exists?(identities(:david).id)
+  end
+
+  test "incinerate does nothing during the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day do
+      assert_no_difference -> { Account.count } do
+        @account.incinerate
+      end
+    end
+
+    assert Account.exists?(@account.id)
+    assert @account.reload.cancelled?
+  end
+
+  test "incinerate does nothing for an active account" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate does nothing for a reactivated account" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert_not @account.reload.cancelled?
+  end
+
+  test "incinerate_due incinerates every account past the grace period" do
+    @account.cancel(initiated_by: @user)
+    initech = accounts(:initech)
+    initech.cancel(initiated_by: users(:mike))
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account.exists?(initech.id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "due_for_incineration includes cancelled accounts after the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day do
+      assert_includes Account.due_for_incineration, @account
+    end
+  end
+end
