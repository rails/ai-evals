diff --git a/app/controllers/concerns/magic_link_issuing.rb b/app/controllers/concerns/magic_link_issuing.rb
new file mode 100644
index 0000000..74537fd
--- /dev/null
+++ b/app/controllers/concerns/magic_link_issuing.rb
@@ -0,0 +1,56 @@
+module MagicLinkIssuing
+  extend ActiveSupport::Concern
+
+  private
+
+  def start_magic_link_challenge(email_address, deliver: true)
+    magic_link = Identity::MagicLink.issue(email_address)
+    set_pending_authentication_token(magic_link)
+
+    if deliver
+      magic_link.deliver_later
+      flash[:plain_code] = magic_link.code if Rails.env.local?
+    end
+  end
+
+  def set_pending_authentication_token(magic_link)
+    cookies.signed[:pending_authentication_token] = {
+      value: magic_link.signed_id(expires_in: Identity::MagicLink::EXPIRY_DURATION),
+      httponly: true,
+      same_site: :lax,
+      expires: Identity::MagicLink::EXPIRY_DURATION.from_now
+    }
+  end
+
+  def pending_authentication_token
+    cookies[:pending_authentication_token]
+  end
+
+  def authenticate_pending_magic_link
+    Identity::MagicLink.authenticate(cookies.signed[:pending_authentication_token], submitted_email_code)
+  end
+
+  def submitted_email_code
+    params[:code]
+  end
+
+  def respond_with_issued_magic_link
+    respond_to do |format|
+      format.html { redirect_to magic_link_form_url }
+      format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+    end
+  end
+
+  def authentication_failed
+    message = "That code didn't work. Try again."
+
+    respond_to do |format|
+      format.html { redirect_to magic_link_form_url, alert: message }
+      format.json { render json: { message: message }, status: :unauthorized }
+    end
+  end
+
+  def invalid_email_address?(email_address)
+    !Identity.new(email_address: email_address).valid?
+  end
+end
diff --git a/app/controllers/join_codes/magic_links_controller.rb b/app/controllers/join_codes/magic_links_controller.rb
