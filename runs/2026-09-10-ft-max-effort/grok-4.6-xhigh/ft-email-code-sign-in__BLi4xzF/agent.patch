+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+    Identity::MagicLink.stubs(:generate_code).returns("ABC123")
+  end
+
+  test "show" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      follow_redirect!
+
+      assert_response :success
+      assert_select "input[name=code]"
+    end
+  end
+
+  test "create signs in with a valid code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON returns a session token" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create rejects an invalid code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      post session_magic_link_path, params: { code: "XXXXXX" }
+
+      assert_redirected_to session_magic_link_url(script_name: nil)
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON rejects an invalid code" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+      post session_magic_link_path(format: :json), params: { code: "XXXXXX" }
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create rejects an expired code" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      travel Identity::MagicLink::EXPIRY_DURATION + 1.second
+
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to session_magic_link_url(script_name: nil)
+      assert_not cookies[:session_token].present?
+    end
+  end
+end
