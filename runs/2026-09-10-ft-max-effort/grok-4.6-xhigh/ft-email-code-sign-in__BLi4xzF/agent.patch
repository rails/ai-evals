@@ -0,0 +1,46 @@
+class Signups::MagicLinksController < ApplicationController
+  include MagicLinkIssuing
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to signup_magic_link_path, alert: "Try again later." }
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def show
+    @magic_link = Identity::MagicLink.find_signed(cookies.signed[:pending_authentication_token])
+  end
+
+  def create
+    magic_link = authenticate_pending_magic_link
+
+    if magic_link
+      signup = Signup.new(email_address: magic_link.email_address)
+      signup.create_identity
+      start_new_session_for signup.identity
+      magic_link.consume
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      authentication_failed
+    end
+  end
+
+  private
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+
+    def magic_link_form_url
+      signup_magic_link_url(script_name: nil)
+    end
+end
