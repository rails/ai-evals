diff --git a/test/models/identity/magic_link_test.rb b/test/models/identity/magic_link_test.rb
new file mode 100644
index 0000000..7668c4f
--- /dev/null
+++ b/test/models/identity/magic_link_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Identity::MagicLinkTest < ActiveSupport::TestCase
+  test "issue generates a six-character code" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+
+    assert_equal 6, magic_link.code.length
+    assert_match /\A[A-Z0-9]{6}\z/, magic_link.code
+    assert_equal "kevin@37signals.com", magic_link.email_address
+  end
+
+  test "issue normalizes email address" do
+    magic_link = Identity::MagicLink.issue("  kevin@37signals.com  ")
+
+    assert_equal "kevin@37signals.com", magic_link.email_address
+  end
+
+  test "issue replaces an existing code for the same email" do
+    first = Identity::MagicLink.issue("kevin@37signals.com")
+    second = Identity::MagicLink.issue("kevin@37signals.com")
+
+    assert_not Identity::MagicLink.exists?(first.id)
+    assert Identity::MagicLink.exists?(second.id)
+  end
+
+  test "authenticate accepts the issued code" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+    signed_id = magic_link.signed_id(expires_in: Identity::MagicLink::EXPIRY_DURATION)
+
+    assert_equal magic_link, Identity::MagicLink.authenticate(signed_id, magic_link.code)
+  end
+
+  test "authenticate is case-insensitive" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+    signed_id = magic_link.signed_id(expires_in: Identity::MagicLink::EXPIRY_DURATION)
+
+    assert Identity::MagicLink.authenticate(signed_id, magic_link.code.downcase)
+  end
+
+  test "authenticate rejects a wrong code" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+    signed_id = magic_link.signed_id(expires_in: Identity::MagicLink::EXPIRY_DURATION)
+
+    assert_nil Identity::MagicLink.authenticate(signed_id, "XXXXXX")
+  end
+
+  test "authenticate rejects an expired code" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+    signed_id = magic_link.signed_id(expires_in: Identity::MagicLink::EXPIRY_DURATION)
+    code = magic_link.code
+
+    travel Identity::MagicLink::EXPIRY_DURATION + 1.second
+
+    assert_nil Identity::MagicLink.authenticate(signed_id, code)
+  end
+
+  test "code works for fifteen minutes" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+    signed_id = magic_link.signed_id(expires_in: Identity::MagicLink::EXPIRY_DURATION)
+    code = magic_link.code
+
+    travel 15.minutes - 1.second
+
+    assert Identity::MagicLink.authenticate(signed_id, code)
+  end
+end
