diff --git a/app/models/identity/magic_link.rb b/app/models/identity/magic_link.rb
new file mode 100644
index 0000000..aabe5e4
--- /dev/null
+++ b/app/models/identity/magic_link.rb
@@ -0,0 +1,47 @@
+class Identity::MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRY_DURATION = 15.minutes
+
+  has_secure_password :code, validations: false
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  class << self
+    def issue(email_address)
+      email_address = email_address.to_s.strip.downcase
+      where(email_address: email_address).delete_all
+
+      create!(email_address: email_address, code: generate_code)
+    end
+
+    def authenticate(signed_id, submitted_code)
+      if signed_id.present? && submitted_code.present? && (magic_link = find_signed(signed_id))
+        magic_link if magic_link.accepts_code?(submitted_code)
+      end
+    end
+
+    def generate_code
+      SecureRandom.base36(CODE_LENGTH).upcase
+    end
+  end
+
+  def accepts_code?(submitted_code)
+    if expired?
+      false
+    else
+      authenticate_code(submitted_code.to_s.strip.upcase)
+    end
+  end
+
+  def expired?
+    created_at < EXPIRY_DURATION.ago
+  end
+
+  def consume
+    destroy
+  end
+
+  def deliver_later
+    IdentityMailer.magic_link(email_address: email_address, code: code).deliver_later
+  end
+end
