+++ b/app/controllers/join_codes/magic_links_controller.rb
@@ -0,0 +1,57 @@
+class JoinCodes::MagicLinksController < ApplicationController
+  include MagicLinkIssuing
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def show
+    @magic_link = Identity::MagicLink.find_signed(cookies.signed[:pending_authentication_token])
+  end
+
+  def create
+    magic_link = authenticate_pending_magic_link
+
+    if magic_link
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+      start_new_session_for identity
+      magic_link.consume
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      if user.setup?
+        redirect_to landing_url(script_name: @join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+      end
+    else
+      authentication_failed
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: request.path_parameters.fetch(:code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render :inactive, status: :gone
+      end
+    end
+
+    def submitted_email_code
+      request.request_parameters[:code]
+    end
+
+    def magic_link_form_url
+      join_magic_link_path(code: @join_code.code)
+    end
+end
