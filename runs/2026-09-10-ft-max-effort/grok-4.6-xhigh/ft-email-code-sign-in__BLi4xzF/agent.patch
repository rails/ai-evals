+class Sessions::MagicLinksController < ApplicationController
+  include MagicLinkIssuing
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def show
+    @magic_link = Identity::MagicLink.find_signed(cookies.signed[:pending_authentication_token])
+  end
+
+  def create
+    magic_link = authenticate_pending_magic_link
+    identity = Identity.find_by(email_address: magic_link.email_address) if magic_link
+
+    if identity
+      start_new_session_for identity
+      magic_link.consume
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      authentication_failed
+    end
+  end
+
+  private
+    def magic_link_form_url
+      session_magic_link_url(script_name: nil)
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to magic_link_form_url, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
