index 0000000..4f71d04
--- /dev/null
+++ b/test/controllers/join_codes/magic_links_controller_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+    Identity::MagicLink.stubs(:generate_code).returns("ABC123")
+  end
+
+  test "create joins an existing identity" do
+    identity = identities(:mike)
+
+    assert_not identity.users.exists?(account: @account)
+
+    assert_no_difference -> { Identity.count } do
+      assert_difference -> { User.count }, 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+        post join_magic_link_path(code: @join_code.code, script_name: @account.slug), params: { code: "ABC123" }
+      end
+    end
+
+    assert cookies[:session_token].present?
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create joins a new identity" do
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "new-joiner@example.com" }
+        post join_magic_link_path(code: @join_code.code, script_name: @account.slug), params: { code: "ABC123" }
+      end
+    end
+
+    assert cookies[:session_token].present?
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create rejects an invalid code" do
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "new-joiner@example.com" }
+    post join_magic_link_path(code: @join_code.code, script_name: @account.slug), params: { code: "XXXXXX" }
+
+    assert_redirected_to join_magic_link_path(code: @join_code.code)
+    assert_not cookies[:session_token].present?
+  end
+end
