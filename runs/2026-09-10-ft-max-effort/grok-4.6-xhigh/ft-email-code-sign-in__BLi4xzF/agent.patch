+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: url, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your code…", maxlength: 6, autocapitalize: "characters" %>
+      </label>
+    </div>
+
+    <% if @magic_link %>
+      <p>We sent a six-character code to <strong><%= @magic_link.email_address %></strong>. Enter it below.</p>
+    <% else %>
+      <p>Enter the six-character code we sent to your email.</p>
+    <% end %>
+
+    <% if Rails.env.local? && flash[:plain_code].present? %>
+      <p class="txt-subtle">Psst, here's your code: <%= flash[:plain_code] %></p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
