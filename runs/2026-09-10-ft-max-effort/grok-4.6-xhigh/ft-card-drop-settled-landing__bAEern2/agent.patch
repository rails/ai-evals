@@ -0,0 +1,158 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+// Cards jump to their new column as soon as you let go. Persistence happens in
+// the background as JSON so a Turbo Stream or page refresh can't reshuffle the board.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  #item
+  #hoverContainer
+
+  itemTargetConnected(item) {
+    item.draggable = true
+    item.querySelectorAll("a, img").forEach(element => element.draggable = false)
+  }
+
+  dragstart(event) {
+    const item = this.#itemFrom(event.target)
+    if (!item) return
+
+    this.#item = item
+    this.#item.classList.add(this.draggedItemClass)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+  }
+
+  dragover(event) {
+    if (!this.#item) return
+
+    const container = this.#containerFrom(event.target)
+    if (this.#canDropOn(container)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#clearHighlight()
+    }
+  }
+
+  dragenter(event) {
+    if (this.#canDropOn(this.#containerFrom(event.target))) {
+      event.preventDefault()
+    }
+  }
+
+  drop(event) {
+    const container = this.#containerFrom(event.target)
+    if (!this.#canDropOn(container)) return
+
+    event.preventDefault()
+    this.#move(this.#item, container)
+    this.#clearHighlight()
+  }
+
+  dragend() {
+    this.#item?.classList.remove(this.draggedItemClass)
+    this.#item = null
+    this.#clearHighlight()
+  }
+
+  // Private
+
+  #move(item, container) {
+    this.#place(item, container)
+    this.#save(item, container)
+  }
+
+  #place(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return
+
+    const sibling = this.#insertionSibling(item, list)
+    if (sibling) {
+      sibling.before(item)
+    } else {
+      const lastCard = [ ...list.querySelectorAll(".card") ].at(-1)
+      if (lastCard) {
+        lastCard.after(item)
+      } else {
+        list.prepend(item)
+      }
+    }
+  }
+
+  #insertionSibling(item, list) {
+    const cards = [ ...list.querySelectorAll(".card") ]
+
+    if (item.classList.contains("golden-effect")) {
+      return cards[0]
+    } else {
+      return cards.find(card => !card.classList.contains("golden-effect"))
+    }
+  }
+
+  #save(item, container) {
+    const url = this.#urlFor(item, container)
+    if (!url) return
+
+    const options = { responseKind: "json", keepalive: true }
+
+    switch (container.dataset.dropTo) {
+      case "column":
+        return post(url, { ...options, query: { column_id: container.dataset.columnId } })
+      case "maybe":
+        return destroy(url, options)
+      case "not_now":
+      case "closed":
+        return post(url, options)
+    }
+  }
+
+  #canDropOn(container) {
+    return container &&
+      this.#item &&
+      this.#containerFrom(this.#item) !== container &&
+      this.#urlFor(this.#item, container)
+  }
+
+  #urlFor(item, container) {
+    switch (container?.dataset.dropTo) {
+      case "column":
+      case "maybe":
+        return item.dataset.cardTriageUrl
+      case "not_now":
+        return item.dataset.cardNotNowUrl
+      case "closed":
+        return item.dataset.cardClosureUrl
+    }
+  }
+
+  #itemFrom(element) {
+    return this.itemTargets.find(item => item === element || item.contains(element))
+  }
+
+  #containerFrom(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+
+  #highlight(container) {
+    if (this.#hoverContainer === container) return
+
+    this.#clearHighlight()
+    this.#hoverContainer = container
+    this.#hoverContainer.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHighlight() {
+    this.#hoverContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoverContainer = null
+  }
+}
