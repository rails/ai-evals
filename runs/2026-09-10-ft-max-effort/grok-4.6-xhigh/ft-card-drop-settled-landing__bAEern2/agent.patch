diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..39c658c
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,180 @@
+require "application_system_test_case"
+require "timeout"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card to another column moves it immediately and persists" do
+    visit board_url(@board)
+    wait_for_column_cards(@column)
+
+    assert_selector ".cards--maybe .card", text: @card.title
+    drag_card @card, to: @column
+
+    assert_card_in_column @card, @column
+    assert_no_selector ".cards--maybe .card", text: @card.title
+    assert_eventually { @card.reload.column == @column }
+  end
+
+  test "dragging a card onto Done closes it immediately" do
+    visit board_url(@board)
+
+    drag_card @card, to: "#closed-cards"
+
+    assert_card_in_column @card, "#closed-cards"
+    assert_eventually { @card.reload.closed? }
+  end
+
+  test "dragging a card onto Not Now postpones it immediately" do
+    visit board_url(@board)
+
+    drag_card @card, to: "#not-now"
+
+    assert_card_in_column @card, "#not-now"
+    assert_eventually { @card.reload.postponed? }
+  end
+
+  test "dragging a card onto Maybe sends it back to triage immediately" do
+    card = cards(:text)
+    visit board_url(@board)
+    wait_for_column_cards(columns(:writebook_in_progress))
+
+    drag_card card, to: "#maybe"
+
+    assert_card_in_column card, "#maybe"
+    assert_eventually { card.reload.awaiting_triage? }
+  end
+
+  test "dragging over a column highlights it" do
+    visit board_url(@board)
+    wait_for_column_cards(@column)
+
+    html5_dragover find_card(@card), find_column(@column)
+
+    assert_selector "#{column_selector(@column)}.drag-and-drop__hover-container"
+  end
+
+  test "dragging a card between columns" do
+    card = cards(:text)
+    destination = columns(:writebook_triage)
+
+    visit board_url(@board)
+    wait_for_column_cards(columns(:writebook_in_progress))
+    wait_for_column_cards(destination)
+
+    drag_card card, to: destination
+
+    assert_card_in_column card, destination
+    assert_eventually { card.reload.column == destination }
+  end
+
+  test "dragging a closed card onto a column reopens it" do
+    card = cards(:shipping)
+
+    visit board_url(@board)
+    wait_for_column_cards("#closed-cards")
+    wait_for_column_cards(@column)
+
+    drag_card card, to: @column
+
+    assert_card_in_column card, @column
+    assert_eventually { card.reload.column == @column && card.open? }
+  end
+
+  test "dropping a card on its own column does not move it" do
+    card = cards(:text)
+    visit board_url(@board)
+    wait_for_column_cards(columns(:writebook_in_progress))
+
+    original_index = card_position(card)
+    drag_card card, to: columns(:writebook_in_progress)
+
+    assert_equal original_index, card_position(card)
+    assert_equal columns(:writebook_in_progress), card.reload.column
+  end
+
+  private
+    def drag_card(card, to:)
+      html5_drag_and_drop find_card(card), find_column(to)
+    end
+
+    def html5_drag_and_drop(source, target)
+      page.execute_script(<<~JS, source, target)
+        const source = arguments[0]
+        const target = arguments[1]
+        const dataTransfer = new DataTransfer()
+        const fire = (element, type) => {
+          element.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+        }
+
+        fire(source, "dragstart")
+        fire(target, "dragenter")
+        fire(target, "dragover")
+        fire(target, "drop")
+        fire(source, "dragend")
+      JS
+    end
+
+    def html5_dragover(source, target)
+      page.execute_script(<<~JS, source, target)
+        const source = arguments[0]
+        const target = arguments[1]
+        const dataTransfer = new DataTransfer()
+        const fire = (element, type) => {
+          element.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+        }
+
+        fire(source, "dragstart")
+        fire(target, "dragenter")
+        fire(target, "dragover")
+      JS
+    end
+
+    def find_card(card)
+      find("##{dom_id(card, :article)}", visible: :all)
+    end
+
+    def find_column(column)
+      find(column_selector(column), visible: :all)
+    end
+
+    def column_selector(column)
+      column.is_a?(String) ? column : "##{dom_id(column)}"
+    end
+
+    def wait_for_column_cards(column)
+      assert_selector "#{column_selector(column)} .card", visible: :all
+    end
+
+    def assert_card_in_column(card, column)
+      assert_selector "#{column_selector(column)} ##{dom_id(card, :article)}", visible: :all
+    end
+
+    def card_position(card)
+      page.evaluate_script(<<~JS)
+        (function() {
+          var card = document.getElementById(#{dom_id(card, :article).to_json})
+          var cards = Array.prototype.slice.call(card.closest(".cards__list").querySelectorAll(".card"))
+          return cards.indexOf(card)
+        })()
+      JS
+    end
+
+    def assert_eventually(timeout: Capybara.default_max_wait_time)
+      Timeout.timeout(timeout) do
+        loop do
+          break if yield
+          sleep 0.05
+        end
+      end
+    rescue Timeout::Error
+      flunk "condition was not met in time"
+    end
+end
