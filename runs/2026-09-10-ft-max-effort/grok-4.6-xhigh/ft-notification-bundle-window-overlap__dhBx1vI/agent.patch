diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..9a6f8e4
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "never does not open a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification
+    end
+  end
+
+  test "the clock starts when the first notification lands" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      notification = create_notification
+
+      bundle = notification.reload.bundle
+      assert_equal Time.utc(2026, 6, 1, 10, 0, 0), bundle.opens_at
+      assert_equal Time.utc(2026, 6, 1, 14, 0, 0), bundle.closes_at
+    end
+  end
+
+  test "subsequent notifications join the open window" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      first = create_notification(source: events(:logo_published))
+
+      travel 1.hour
+      second = create_notification(source: events(:layout_published))
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal first.bundle, second.reload.bundle
+    end
+  end
+
+  test "late notifications belong to the window that has already opened" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      first = create_notification(source: events(:logo_published))
+      bundle = first.bundle
+
+      travel 5.hours
+      late = create_notification(source: events(:layout_published), created_at: Time.utc(2026, 6, 1, 11, 0, 0))
+
+      assert_equal bundle, late.reload.bundle
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  test "a new window opens after the previous one closes" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      first = create_notification(source: events(:logo_published))
+
+      travel 5.hours
+      second = create_notification(source: events(:layout_published))
+
+      assert_equal 2, @user.notification_bundles.count
+      assert_not_equal first.bundle, second.reload.bundle
+      assert first.bundle.closes_at <= second.bundle.opens_at
+    end
+  end
+
+  test "windows never overlap" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      create_notification(source: events(:logo_published))
+      existing = @user.notification_bundles.first
+
+      overlapping = @user.notification_bundles.build(
+        opens_at: existing.opens_at + 1.hour,
+        closes_at: existing.closes_at + 1.hour
+      )
+
+      assert_not overlapping.valid?
+      assert_includes overlapping.errors[:base], "cannot overlap another window"
+    end
+  end
+
+  test "daily windows last one day" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      notification = create_notification
+      assert_equal 1.day, notification.reload.bundle.closes_at - notification.bundle.opens_at
+    end
+  end
+
+  test "weekly windows last one week" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      notification = create_notification
+      assert_equal 1.week, notification.reload.bundle.closes_at - notification.bundle.opens_at
+    end
+  end
+
+  test "schedules one email at the end of the window" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      notification = create_notification(source: events(:logo_published))
+      bundle = notification.reload.bundle
+
+      assert_enqueued_with(job: Notification::BundleJob, args: [ bundle ], at: bundle.closes_at)
+
+      create_notification(source: events(:layout_published))
+      assert_equal 1, enqueued_jobs.count { |job| job["job_class"] == "Notification::BundleJob" }
+    end
+  end
+
+  test "sends one email with the notifications in the window" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      create_notification(source: events(:logo_published))
+      create_notification(source: events(:layout_published))
+      bundle = @user.notification_bundles.first
+
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs only: Notification::BundleJob, at: bundle.closes_at
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @user.identity.email_address ], email.to
+      bundle.reload
+      assert bundle.sent?
+    end
+  end
+
+  test "does not send another email when a late notification joins a sent window" do
+    travel_to Time.utc(2026, 6, 1, 10, 0, 0) do
+      create_notification(source: events(:logo_published))
+      bundle = @user.notification_bundles.first
+
+      perform_enqueued_jobs only: Notification::BundleJob, at: bundle.closes_at
+      assert bundle.reload.sent?
+
+      travel 5.hours
+      late = create_notification(source: events(:layout_published), created_at: Time.utc(2026, 6, 1, 11, 0, 0))
+
+      assert_equal bundle, late.reload.bundle
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  private
+    def create_notification(source: events(:logo_published), created_at: Time.current)
+      Notification.create!(user: @user, source: source, creator: users(:david), created_at: created_at)
+    end
+end
