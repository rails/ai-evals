diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..62dbbe2
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,90 @@
+class Notification::Bundle < ApplicationRecord
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, foreign_key: :bundle_id, inverse_of: :bundle, dependent: :nullify
+
+  scope :overlapping, ->(range_start, range_end) { where("opens_at < ? AND closes_at > ?", range_end, range_start) }
+  scope :chronologically, -> { order(:opens_at) }
+
+  after_create_commit :deliver_later
+
+  validate :does_not_overlap_sibling_windows
+
+  class << self
+    def capture(notification)
+      settings = notification.user.settings
+      return if settings.nil? || settings.never?
+
+      settings.with_lock do
+        unless settings.reload.never?
+          duration = DURATIONS.fetch(settings.bundle_email_frequency.to_s)
+          time = notification.created_at
+          bundle = existing_window(notification.user, time, duration) || open_window(notification.user, time, duration)
+          assign_to(notification, bundle)
+          bundle
+        end
+      end
+    end
+
+    private
+      def existing_window(user, time, duration)
+        user.notification_bundles.overlapping(time, time + duration).chronologically.first
+      end
+
+      def open_window(user, time, duration)
+        user.notification_bundles.create!(opens_at: time, closes_at: time + duration)
+      rescue ActiveRecord::RecordInvalid
+        if bundle = existing_window(user, time, duration)
+          bundle
+        else
+          raise
+        end
+      end
+
+      def assign_to(notification, bundle)
+        unless notification.bundle_id == bundle.id
+          notification.update_column(:bundle_id, bundle.id)
+          notification.bundle = bundle
+        end
+      end
+  end
+
+  def deliver_later
+    Notification::BundleJob.set(wait_until: closes_at).perform_later(self)
+  end
+
+  def deliver
+    unless sent?
+      NotificationMailer.bundle(self).deliver_now if deliverable?
+      update!(sent_at: Time.current)
+    end
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  def open?(at: Time.current)
+    opens_at <= at && closes_at > at
+  end
+
+  private
+    def deliverable?
+      user.active? && user.identity&.email_address.present? && !user.settings.never? && notifications.unread.any?
+    end
+
+    def does_not_overlap_sibling_windows
+      siblings = user.notification_bundles.overlapping(opens_at, closes_at)
+      siblings = siblings.where.not(id: id) if id.present?
+
+      if siblings.exists?
+        errors.add(:base, "cannot overlap another window")
+      end
+    end
+end
