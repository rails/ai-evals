index 0000000..9aa0f47
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @webhook = Webhook.create!(name: "Tracker", url: "https://example.com/webhook", board: boards(:writebook), subscribed_actions: [ "card_published" ])
+    @tracker = @webhook.delinquency_tracker
+    @event = events(:logo_published)
+  end
+
+  test "auto-created with webhook" do
+    assert_not_nil @tracker
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert_equal @webhook.account, @tracker.account
+  end
+
+  test "success resets consecutive failures" do
+    @tracker.update!(consecutive_failures_count: 4, first_failure_at: 10.minutes.ago)
+
+    @tracker.record_success
+
+    @tracker.reload
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "ten consecutive failures within an hour deactivates the webhook" do
+    freeze_time do
+      9.times { record_failure }
+
+      assert @webhook.reload.active?
+      assert_equal 9, @tracker.reload.consecutive_failures_count
+
+      record_failure
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "failures spread over more than an hour start a new window" do
+    freeze_time do
+      9.times { record_failure }
+      travel 61.minutes
+      record_failure
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  test "a success in the middle of failures prevents deactivation" do
+    freeze_time do
+      9.times { record_failure }
+      @tracker.record_success
+      record_failure
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  private
+    def record_failure
+      @tracker.record_failure
+    end
+end
