diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..8186def
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,42 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset
+  end
+
+  def record_failure
+    start_new_window if window_expired?
+
+    increment_failures
+    webhook.deactivate if threshold_reached?
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  private
+    def window_expired?
+      first_failure_at.present? && first_failure_at < FAILURE_WINDOW.ago
+    end
+
+    def start_new_window
+      self.consecutive_failures_count = 0
+      self.first_failure_at = nil
+    end
+
+    def increment_failures
+      self.consecutive_failures_count += 1
+      self.first_failure_at ||= Time.current
+      save!
+    end
+
+    def threshold_reached?
+      consecutive_failures_count >= FAILURE_THRESHOLD
+    end
+end
