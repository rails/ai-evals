@@ -29,4 +68,56 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+        reload
+        true
+      end
+    end
+
+    def transmit
+      payload = Webhook::Payload.new(self)
+      headers = payload.headers
+      body = payload.body
+
+      update!(request: { headers: headers })
+      complete post(headers, body)
+    rescue *UNREACHABLE_ERRORS
+      error "destination_unreachable"
+    rescue => exception
+      error exception.class.name.underscore
+    end
+
+    def post(headers, body)
+      uri = URI.parse(webhook.url)
+
+      if ip = SsrfProtection.resolve_public_ip(uri.host)
+        http = Net::HTTP.new(uri.host, uri.port)
+        http.ipaddr = ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = TIMEOUT
+        http.read_timeout = TIMEOUT
+        http.write_timeout = TIMEOUT
+
+        request = Net::HTTP::Post.new(uri.request_uri)
+        request.body = body
+        headers.each { |name, value| request[name] = value }
+
+        http.request(request)
+      else
+        raise DestinationUnreachable
+      end
+    end
+
+    def complete(http_response)
+      update!(state: :completed, response: { code: http_response.code.to_i })
+      webhook.record_delivery_result(self)
+    end
+
+    def error(message)
+      update!(state: :errored, response: { error: message })
+      webhook.record_delivery_result(self)
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..6ef58ef
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,67 @@
+class Webhook::Payload
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def body
+    @body ||= if webhook.for_slack?
+      { text: chat_text }.to_json
+    elsif webhook.for_campfire?
+      { body: chat_text }.to_json
+    elsif webhook.for_basecamp?
+      { content: chat_text }.to_json
+    else
+      json_body
+    end
+  end
+
+  def headers
+    {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => timestamp,
+      "X-Webhook-Signature" => signature
+    }
+  end
+
+  private
+    def webhook
+      @delivery.webhook
+    end
+
+    def event
+      @delivery.event
+    end
+
+    def timestamp
+      @timestamp ||= Time.current.utc.iso8601(3)
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def json_body
+      renderer.render(template: "webhooks/event", formats: [ :json ], assigns: { event: event }, layout: false)
+    end
+
+    def chat_text
+      renderer.render(template: "webhooks/event", formats: [ :html ], assigns: { event: event }, layout: false).strip
+    end
+
+    def renderer
+      ApplicationController.renderer.new(
+        http_host: default_url_options[:host],
+        https: default_url_options[:protocol].to_s == "https",
+        script_name: webhook.account.slug
+      )
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        { host: "localhost" }
+    end
+end
