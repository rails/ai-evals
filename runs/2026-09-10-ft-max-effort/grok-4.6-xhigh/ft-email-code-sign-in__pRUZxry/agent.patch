diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..b80713c
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "new" do
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "input[name=code]"
+  end
+
+  test "create signs in with a valid code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      assert_no_difference -> { Identity.count } do
+        post session_magic_link_path, params: { code: email_authentication_code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+      assert_equal identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+
+  test "create is case insensitive" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      post session_magic_link_path, params: { code: email_authentication_code.downcase }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create still works just before expiry" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      travel PendingAuthentication::EXPIRY - 1.second
+
+      post session_magic_link_path, params: { code: email_authentication_code }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with an invalid code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      post session_magic_link_path, params: { code: "NOPE00" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+  end
+
+  test "create with an expired code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      travel PendingAuthentication::EXPIRY + 1.second
+
+      post session_magic_link_path, params: { code: email_authentication_code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: identity.email_address }
+      end
+
+      assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+
+      post session_magic_link_path(format: :json), params: { code: email_authentication_code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create via JSON with an invalid code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: identity.email_address }
+      end
+
+      post session_magic_link_path(format: :json), params: { code: "NOPE00" }
+
+      assert_response :unauthorized
+      assert_equal "That code didn't work. Try again.", @response.parsed_body["message"]
+    end
+  end
+end
