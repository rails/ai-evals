diff --git a/app/models/pending_authentication.rb b/app/models/pending_authentication.rb
new file mode 100644
index 0000000..ff938bb
--- /dev/null
+++ b/app/models/pending_authentication.rb
@@ -0,0 +1,88 @@
+class PendingAuthentication
+  EXPIRY = 15.minutes
+  CODE_LENGTH = 6
+  VERIFIER_PURPOSE = :pending_authentication
+
+  class << self
+    def issue(email_address:, purpose: :session, join_code: nil, account_id: nil)
+      new(
+        email_address: normalize_email_address(email_address),
+        purpose: purpose,
+        join_code: join_code,
+        account_id: account_id,
+        code: generate_code
+      )
+    end
+
+    def find_by_token(token)
+      if token.present? && (payload = verifier.verified(token, purpose: VERIFIER_PURPOSE))
+        new(
+          email_address: payload["email_address"],
+          purpose: payload["purpose"],
+          join_code: payload["join_code"],
+          account_id: payload["account_id"],
+          code_digest: payload["code_digest"]
+        )
+      end
+    end
+
+    def verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+
+    private
+      def generate_code
+        SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      end
+
+      def normalize_email_address(email_address)
+        email_address.to_s.strip.downcase
+      end
+  end
+
+  attr_reader :email_address, :code, :purpose, :join_code, :account_id
+
+  def initialize(email_address:, purpose: :session, join_code: nil, account_id: nil, code: nil, code_digest: nil)
+    @email_address = email_address
+    @purpose = purpose.to_s
+    @join_code = join_code
+    @account_id = account_id
+    @code = code
+    @code_digest = code_digest
+  end
+
+  def token
+    self.class.verifier.generate(payload, expires_in: EXPIRY, purpose: VERIFIER_PURPOSE)
+  end
+
+  def authenticate(submitted_code)
+    if submitted_code.present?
+      ActiveSupport::SecurityUtils.secure_compare(code_digest, digest(submitted_code))
+    else
+      false
+    end
+  end
+
+  def identity
+    Identity.find_or_create_by!(email_address: email_address)
+  end
+
+  private
+    def payload
+      {
+        "email_address" => email_address,
+        "code_digest" => code_digest,
+        "purpose" => purpose,
+        "join_code" => join_code,
+        "account_id" => account_id&.to_s
+      }
+    end
+
+    def code_digest
+      @code_digest ||= digest(code)
+    end
+
+    def digest(value)
+      Digest::SHA256.hexdigest(value.to_s.strip.upcase)
+    end
+end
