+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @email_address.present? %>
+    <p>We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to continue. It expires in 15 minutes.</p>
+  <% else %>
+    <p>We sent a six-character code to your email. Enter it below to continue. It expires in 15 minutes.</p>
+  <% end %>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", maxlength: 6, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
