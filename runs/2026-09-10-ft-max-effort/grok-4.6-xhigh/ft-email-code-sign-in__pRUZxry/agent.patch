diff --git a/test/models/pending_authentication_test.rb b/test/models/pending_authentication_test.rb
new file mode 100644
index 0000000..879531e
--- /dev/null
+++ b/test/models/pending_authentication_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class PendingAuthenticationTest < ActiveSupport::TestCase
+  test "issue generates a six-character uppercase code" do
+    pending_authentication = PendingAuthentication.issue(email_address: "kevin@37signals.com")
+
+    assert_match /\A[A-Z0-9]{6}\z/, pending_authentication.code
+    assert_equal "kevin@37signals.com", pending_authentication.email_address
+  end
+
+  test "normalizes email address" do
+    pending_authentication = PendingAuthentication.issue(email_address: "  Kevin@37signals.COM ")
+
+    assert_equal "kevin@37signals.com", pending_authentication.email_address
+  end
+
+  test "authenticate accepts the issued code" do
+    pending_authentication = PendingAuthentication.issue(email_address: "kevin@37signals.com")
+    found = PendingAuthentication.find_by_token(pending_authentication.token)
+
+    assert found.authenticate(pending_authentication.code)
+    assert found.authenticate(pending_authentication.code.downcase)
+    assert_not found.authenticate("NOPE00")
+    assert_not found.authenticate(nil)
+  end
+
+  test "find_by_token returns nil for an expired token" do
+    pending_authentication = PendingAuthentication.issue(email_address: "kevin@37signals.com")
+    token = pending_authentication.token
+
+    travel PendingAuthentication::EXPIRY + 1.second
+
+    assert_nil PendingAuthentication.find_by_token(token)
+  end
+
+  test "find_by_token returns nil for a blank or invalid token" do
+    assert_nil PendingAuthentication.find_by_token(nil)
+    assert_nil PendingAuthentication.find_by_token("")
+    assert_nil PendingAuthentication.find_by_token("nope")
+  end
+
+  test "identity finds or creates by email address" do
+    pending_authentication = PendingAuthentication.issue(email_address: identities(:kevin).email_address)
+    assert_equal identities(:kevin), pending_authentication.identity
+
+    pending_authentication = PendingAuthentication.issue(email_address: "new-person@example.com")
+    assert_difference -> { Identity.count }, 1 do
+      assert_equal "new-person@example.com", pending_authentication.identity.email_address
+    end
+  end
+end
