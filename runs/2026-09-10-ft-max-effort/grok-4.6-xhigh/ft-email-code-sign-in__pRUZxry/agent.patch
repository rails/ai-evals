diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..6da059e
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,79 @@
+class Sessions::MagicLinksController < ApplicationController
+  include PendingAuthenticatable
+
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @email_address = find_pending_authentication&.email_address
+  end
+
+  def create
+    if (pending_authentication = find_pending_authentication) && pending_authentication.authenticate(params[:code])
+      authenticate_with pending_authentication
+    else
+      authentication_failed
+    end
+  end
+
+  private
+    def authenticate_with(pending_authentication)
+      terminate_session if Current.session
+      start_new_session_for pending_authentication.identity
+      clear_pending_authentication_cookie
+
+      respond_to do |format|
+        format.html { redirect_after_authentication(pending_authentication) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def redirect_after_authentication(pending_authentication)
+      case pending_authentication.purpose
+      when "signup"
+        redirect_to new_signup_completion_path(script_name: nil)
+      when "join"
+        redirect_after_join(pending_authentication)
+      else
+        redirect_to after_authentication_url
+      end
+    end
+
+    def redirect_after_join(pending_authentication)
+      join_code = Account::JoinCode.find_by(code: pending_authentication.join_code, account_id: pending_authentication.account_id)
+
+      if join_code
+        join_code.redeem_if { |account| pending_authentication.identity.join(account) }
+        user = User.active.find_by!(account: join_code.account, identity: pending_authentication.identity)
+
+        if user.setup?
+          redirect_to landing_url(script_name: join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        redirect_to new_session_path(script_name: nil), alert: "That join code is no longer valid."
+      end
+    end
+
+    def authentication_failed
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
