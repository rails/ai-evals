new file mode 100644
index 0000000..c675601
--- /dev/null
+++ b/app/controllers/concerns/pending_authenticatable.rb
@@ -0,0 +1,25 @@
+module PendingAuthenticatable
+  private
+
+  def issue_pending_authentication(email_address, **options)
+    PendingAuthentication.issue(email_address: email_address, **options).tap do |pending_authentication|
+      IdentityMailer.code(email_address: pending_authentication.email_address, code: pending_authentication.code).deliver_later
+
+      cookies.signed[:pending_authentication_token] = {
+        value: pending_authentication.token,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+  end
+
+  def find_pending_authentication
+    if token = cookies.signed[:pending_authentication_token]
+      PendingAuthentication.find_by_token(token)
+    end
+  end
+
+  def clear_pending_authentication_cookie
+    cookies.delete(:pending_authentication_token)
+  end
+end
