+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "code includes the code in the subject and body" do
+    email = IdentityMailer.code(email_address: "kevin@37signals.com", code: "ABC123")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "ABC123 is your Fizzy code", email.subject
+    assert_match "ABC123", email.body.encoded
+  end
+end
