@@ -0,0 +1,65 @@
+# Activities
+
+Account activity is the same stream of events shown on the HTML timeline: cards being added, assigned, moved, closed, commented on, and so on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated, flat list of activity the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by event creator ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+Only activity on boards you can access is returned. Filtering by a board you cannot access yields no events for that board.
+
+The kinds of events match the HTML timeline, with two exceptions:
+
+- deprecated `card_collection_changed` events are omitted
+- `card_title_changed` events are included
+
+Each event includes `id`, `action`, `created_at`, `description`, `particulars`, `url`, `eventable_type`, `eventable`, `board`, and `creator`. Descriptions are returned as plain text. `eventable`, `board`, and `creator` use the same representations as the rest of the API.
+
+`url` opens the card. For comment events, it opens the card where the comment was posted and jumps to that comment.
+
+The `particulars` object exposes event-specific details:
+
+- assignment changes contain `assignee_ids`
+- board changes contain `old_board` and `new_board`
+- title changes contain `old_title` and `new_title`
+- triage events contain `column`
+
+Other events return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David assigned JZ to \"The logo isn't big enough\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zk1dtqduod5bkhv3k8m"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 1,
+      "title": "The logo isn't big enough"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    }
+  }
+]
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..225cb6b
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,210 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of accessible activity newest first" do
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body
+    assert json.is_a?(Array)
+    assert json.any?
+
+    expected_ids = users(:kevin).activities.limit(json.size).pluck(:id)
+    assert_equal expected_ids, json.pluck("id")
+
+    created_ats = json.map { |event| event["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index as JSON includes the expected event fields" do
+    event = events(:layout_assignment_jz)
+
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal event.action, json["action"]
+    assert_equal event.created_at.utc.as_json, json["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, json["description"]
+    assert_equal event.eventable_type, json["eventable_type"]
+    assert_equal polymorphic_url(event.eventable), json["url"]
+    assert_equal event.eventable_id, json["eventable"]["id"]
+    assert_equal event.board_id, json["board"]["id"]
+    assert_equal event.creator_id, json["creator"]["id"]
+    assert_equal Array(event.assignee_ids), json.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON uses card representations for card events" do
+    event = events(:logo_published)
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "Card", json["eventable_type"]
+    assert_equal event.eventable.number, json.dig("eventable", "number")
+    assert_equal event.eventable.title, json.dig("eventable", "title")
+    assert_equal card_url(event.eventable), json["url"]
+    assert_equal({}, json["particulars"])
+  end
+
+  test "index as JSON uses comment representations and jumps to the comment" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "Comment", json["eventable_type"]
+    assert_equal comment.id, json.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), json["url"]
+    assert_equal({}, json["particulars"])
+  end
+
+  test "index as JSON includes title change events with old and new titles" do
+    event = create_event(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "card_title_changed", json["action"]
+    assert_equal "Old title", json.dig("particulars", "old_title")
+    assert_equal "New title", json.dig("particulars", "new_title")
+  end
+
+  test "index as JSON includes board change events with old and new boards" do
+    event = create_event(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } }
+    )
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "Writebook", json.dig("particulars", "old_board")
+    assert_equal "Private board", json.dig("particulars", "new_board")
+  end
+
+  test "index as JSON includes triage events with column" do
+    event = create_event(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "In Progress", json.dig("particulars", "column")
+  end
+
+  test "index as JSON returns empty strings for missing board title or column values" do
+    title_event = create_event(action: "card_title_changed", particulars: {})
+    board_event = create_event(action: "card_board_changed", particulars: {})
+    triage_event = create_event(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+    json = @response.parsed_body.index_by { |activity| activity["id"] }
+
+    assert_equal "", json.dig(title_event.id, "particulars", "old_title")
+    assert_equal "", json.dig(title_event.id, "particulars", "new_title")
+    assert_equal "", json.dig(board_event.id, "particulars", "old_board")
+    assert_equal "", json.dig(board_event.id, "particulars", "new_board")
+    assert_equal "", json.dig(triage_event.id, "particulars", "column")
+  end
+
+  test "index as JSON omits deprecated card_collection_changed events" do
+    event = create_event(action: "card_collection_changed")
+
+    get activities_path, as: :json
+    assert_not @response.parsed_body.pluck("id").include?(event.id)
+    assert_not @response.parsed_body.pluck("action").include?("card_collection_changed")
+  end
+
+  test "index as JSON can filter by creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index as JSON can filter by board_ids" do
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index as JSON can combine creator_ids and board_ids filters" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+    assert_response :success
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity|
+      activity.dig("creator", "id") == users(:kevin).id && activity.dig("board", "id") == boards(:writebook).id
+    }
+  end
+
+  test "index as JSON does not return activity from inaccessible boards" do
+    private_event = create_event(board: boards(:private), creator: users(:kevin), eventable: cards(:logo), action: "card_published")
+
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_not @response.parsed_body.pluck("id").include?(private_event.id)
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_empty @response.parsed_body.pluck("id")
+  end
+
+  test "index as JSON paginates newest first" do
+    now = Time.current.change(usec: 0)
+
+    20.times do |index|
+      create_event action: "card_published", created_at: now + index.seconds
+    end
+
+    expected_ids = users(:kevin).activities.pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "index as JSON requires authentication" do
+    sign_out
+
+    get activities_path, as: :json, env: { "HTTP_AUTHORIZATION" => "Bearer nonsense" }
+    assert_response :unauthorized
+  end
+
+  private
+    def create_event(action:, board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo), **attributes)
+      board.events.create!(action:, creator:, eventable:, **attributes)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
