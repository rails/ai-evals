diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..4acf824 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,25 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: particular_for("old_board"), new_board: particular_for("new_board") }
+    when "card_title_changed"
+      { old_title: particular_for("old_title"), new_title: particular_for("new_title") }
+    when "card_triaged"
+      { column: particular_for("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_for(key)
+      source = particulars&.dig("particulars") || particulars || {}
+      (source[key] || source[key.to_sym]).to_s
+    end
 end
