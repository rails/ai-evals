@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment particulars expose assignee_ids" do
+    event = events(:logo_assignment_jz)
+
+    assert_equal({ assignee_ids: Array(event.assignee_ids) }, event.api_particulars)
+  end
+
+  test "title change particulars read nested values" do
+    event = events(:logo_published)
+    event.action = "card_title_changed"
+    event.particulars = { "particulars" => { "old_title" => "Before", "new_title" => "After" } }
+
+    assert_equal({ old_title: "Before", new_title: "After" }, event.api_particulars)
+  end
+
+  test "title change particulars read top-level values" do
+    event = events(:logo_published)
+    event.action = "card_title_changed"
+    event.particulars = { "old_title" => "Before", "new_title" => "After" }
+
+    assert_equal({ old_title: "Before", new_title: "After" }, event.api_particulars)
+  end
+
+  test "missing board title and column values become empty strings" do
+    event = events(:logo_published)
+
+    event.action = "card_board_changed"
+    event.particulars = {}
+    assert_equal({ old_board: "", new_board: "" }, event.api_particulars)
+
+    event.action = "card_title_changed"
+    assert_equal({ old_title: "", new_title: "" }, event.api_particulars)
+
+    event.action = "card_triaged"
+    assert_equal({ column: "" }, event.api_particulars)
+  end
+
+  test "other actions return an empty particulars object" do
+    assert_equal({}, events(:logo_published).api_particulars)
+    assert_equal({}, events(:layout_commented).api_particulars)
+    assert_equal({}, events(:shipping_closed).api_particulars)
+  end
+end
