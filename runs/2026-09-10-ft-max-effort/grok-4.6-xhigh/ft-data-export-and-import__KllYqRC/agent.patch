@@ -1,4 +1,40 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.session = Session.new(identity: @user.identity)
+    Current.account = @account
+  end
+
+  test "round-trips rich text with attachments" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    card.update!(description: %(<action-text-attachment sgid="#{blob.attachable_sgid}" content-type="image/jpeg"></action-text-attachment>))
+
+    export = @account.exports.create!(user: @user, kind: :account)
+    perform_enqueued_jobs only: Account::ExportJob
+
+    zip = {
+      io: StringIO.new(export.reload.file.download),
+      filename: "export.zip",
+      content_type: "application/zip"
+    }
+    import = Account::Import.create_from(file: zip, identity: @user.identity)
+    perform_enqueued_jobs only: Account::ImportJob
+    import.reload
+
+    assert import.completed?, import.error_message
+    imported_card = import.account.cards.find_by(title: card.title)
+    html = imported_card.description.body.to_html
+    assert_match(/action-text-attachment/, html)
+    sgid = Nokogiri::HTML.fragment(html).at_css("action-text-attachment")["sgid"]
+    attachable = ActionText::Attachable.from_attachable_sgid(sgid)
+    assert_equal "moon.jpg", attachable.filename.to_s
+  end
 end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..ebb76c2
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.session = Session.new(identity: @user.identity)
+  end
+
+  test "exporting an account writes records and files into a zip" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @user, kind: :account)
+
+    perform_enqueued_jobs only: Account::ExportJob
+
+    export.reload
+    assert export.file.attached?
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("version.json")
+      version = JSON.parse(zip.read("version.json"))
+      assert_equal "account", version["kind"]
+      assert zip.exists?("accounts/records.jsonl")
+      assert zip.exists?("users/records.jsonl")
+      assert zip.exists?("cards/records.jsonl")
+      assert zip.exists?("comments/records.jsonl")
+      assert zip.glob("files/*").any?
+    end
+  end
+
+  test "exporting cards writes json with comments and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @user.exports.create!(account: @account, kind: :cards)
+
+    perform_enqueued_jobs only: Account::ExportJob
+
+    export.reload
+    assert export.file.attached?
+
+    ZipFile.open(export.file) do |zip|
+      version = JSON.parse(zip.read("version.json"))
+      assert_equal "cards", version["kind"]
+      assert zip.exists?("cards/#{card.number}.json")
+
+      payload = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, payload["title"]
+      assert payload["comments"].any?
+      assert payload["files"].any?
+      assert zip.exists?(payload["files"].first["path"])
+    end
+  end
+
+  test "card export only includes cards the user can see" do
+    private_card = Card.create!(
+      account: @account,
+      board: boards(:private),
+      creator: users(:kevin),
+      title: "Secret",
+      status: :published,
+      last_active_at: Time.current
+    )
+
+    david = users(:david)
+    export = david.exports.create!(account: @account, kind: :cards)
+
+    perform_enqueued_jobs only: Account::ExportJob
+
+    ZipFile.open(export.reload.file) do |zip|
+      assert_not zip.exists?("cards/#{private_card.number}.json")
+      assert zip.exists?("cards/#{cards(:logo).number}.json")
+    end
+  end
+
+  test "sends an email with a download link when the export is ready" do
+    export = @account.exports.create!(user: @user, kind: :account)
+    perform_enqueued_jobs only: Account::ExportJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    email = ActionMailer::Base.deliveries.last
+    assert_not_nil email
+    assert_includes email.to, @user.identity.email_address
+    assert_match(/export is ready/i, email.subject)
+    assert_match(/download/i, email.body.encoded)
+  end
+
+  test "download link stops working after a day" do
+    export = @account.exports.create!(user: @user, kind: :account)
+    perform_enqueued_jobs only: Account::ExportJob
+    export.reload
+
+    assert export.accessible_to?(@user)
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.accessible_to?(@user)
+    end
+  end
+
+  test "expire_all purges old exports" do
+    export = @account.exports.create!(user: @user, kind: :account)
+    perform_enqueued_jobs only: Account::ExportJob
