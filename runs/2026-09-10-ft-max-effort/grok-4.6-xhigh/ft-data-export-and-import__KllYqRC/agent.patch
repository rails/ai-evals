+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, id_map: nil)
+    super(account: account, model: Filter, id_map: id_map)
+  end
+
+  private
+    def imported_attributes(attrs)
+      super.tap do |result|
+        if fields = result["fields"]
+          fields = JSON.parse(fields) if fields.is_a?(String)
+          if fields.is_a?(Hash)
+            fields["card_ids"] = remap_ids("Card", fields["card_ids"])
+            fields["column_ids"] = remap_ids("Column", fields["column_ids"])
+            result["fields"] = fields
+          end
+        end
+      end
+    end
+
+    def remap_ids(type, ids)
+      Array(ids).filter_map { |id| id_map.lookup(type, id) }
+    end
+end
