@@ -0,0 +1,15 @@
+class Account::DataTransfer::IdMap
+  def initialize
+    @ids = Hash.new { |hash, type| hash[type] = {} }
+  end
+
+  def remember(type, old_id, new_id)
+    @ids[type.to_s][old_id.to_s] = new_id
+  end
+
+  def lookup(type, old_id)
+    if old_id.present?
+      @ids[type.to_s][old_id.to_s]
+    end
+  end
+end
diff --git a/app/models/account/data_transfer/join_table_record_set.rb b/app/models/account/data_transfer/join_table_record_set.rb
