       ::ActionText::RichText.where(account: account)
     end
 
+    def exported_attributes(record)
+      super.merge("body" => portable_body(record))
+    end
+
+    def imported_attributes(attrs)
+      super.tap do |result|
+        result["body"] = restore_body(result["body"])
+      end
+    end
+
+    def portable_body(record)
+      html = record.read_attribute(:body).as_json
+      rewrite_attachment_sgids(html) do |sgid|
+        begin
+          attachable = ActionText::Attachable.from_attachable_sgid(sgid)
+          "#{attachable.class.name}/#{attachable.id}" if attachable
+        rescue
+          nil
+        end
+      end
+    end
+
+    def restore_body(html)
+      rewrite_attachment_sgids(html) do |portable|
+        begin
+          type, old_id = portable.to_s.split("/", 2)
+          new_id = id_map.lookup(type, old_id)
+          record = type.constantize.find_by(id: new_id) if new_id && type.present?
+          record&.attachable_sgid
+        rescue
+          nil
+        end
+      end
+    end
+
+    def rewrite_attachment_sgids(html)
+      if html.blank?
+        html
+      else
+        fragment = Nokogiri::HTML.fragment(html.to_s)
+        fragment.css("action-text-attachment[sgid]").each do |node|
+          if replacement = yield(node["sgid"])
+            node["sgid"] = replacement
+          end
+        end
+        fragment.to_html
+      end
+    end
 end
