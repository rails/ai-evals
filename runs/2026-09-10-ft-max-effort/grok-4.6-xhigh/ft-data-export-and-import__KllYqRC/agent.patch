index 0000000..88e00a8
--- /dev/null
+++ b/app/models/account/data_transfer/join_table_record_set.rb
@@ -0,0 +1,87 @@
+class Account::DataTransfer::JoinTableRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, table_name:, mapping:, id_map: nil)
+    @table_name = table_name
+    @mapping = mapping.transform_keys(&:to_s).transform_values { |type| type.is_a?(Class) ? type.name : type.to_s }
+    super(account: account, model: parent_model, attributes: @mapping.keys, id_map: id_map)
+  end
+
+  def delete_imported
+  end
+
+  private
+    attr_reader :mapping
+
+    def parent_model
+      mapping.values.first.constantize
+    end
+
+    def parent_key
+      mapping.keys.first
+    end
+
+    def model_dir
+      @table_name
+    end
+
+    def write_records
+      zip.add_file(records_path) do |sink|
+        each_join_row do |row|
+          sink.write(JSON.generate(row))
+          sink.write("\n")
+        end
+      end
+    end
+
+    def read_records
+      return unless zip.exists?(records_path)
+
+      rows = []
+
+      zip.each_json_line(records_path) do |attrs|
+        row = imported_join_row(attrs)
+        rows << row if row
+
+        if rows.size >= INSERT_BATCH_SIZE
+          insert_join_rows(rows)
+          rows = []
+        end
+      end
+
+      insert_join_rows(rows) if rows.any?
+    end
+
+    def imported_join_row(attrs)
+      row = {}
+
+      mapping.each do |column, type|
+        new_id = id_map.lookup(type, attrs[column])
+        return if new_id.blank?
+        row[column] = new_id
+      end
+
+      row
+    end
+
+    def insert_join_rows(rows)
+      join_model.insert_all!(rows, record_timestamps: false)
+    end
+
+    def each_join_row
+      parent_ids = parent_model.where(account_id: account.id).pluck(:id)
+      return if parent_ids.empty?
+
+      parent_ids.each_slice(INSERT_BATCH_SIZE) do |batch_ids|
+        join_model.where(parent_key => batch_ids).pluck(*attributes).each do |values|
+          yield attributes.zip(Array(values)).to_h
+        end
+      end
+    end
+
+    def join_model
+      table = @table_name
+      @join_model ||= Class.new(ApplicationRecord) do
+        self.table_name = table
+        self.primary_key = nil
+      end
+    end
+end
