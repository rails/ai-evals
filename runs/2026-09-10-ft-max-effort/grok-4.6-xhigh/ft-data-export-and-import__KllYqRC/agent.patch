--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -37,4 +37,27 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+
+  test "reader reads files written by the writer" do
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.add_file("data/records.jsonl", %({"id":"1"}\n))
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    assert reader.exists?("hello.txt")
+    assert_equal "Hello, World!", reader.read("hello.txt")
+    assert_equal [ "data/records.jsonl" ], reader.glob("data/*")
+
+    rows = []
+    reader.each_json_line("data/records.jsonl") { |row| rows << row }
+    assert_equal [ { "id" => "1" } ], rows
+  ensure
+    tempfile.close
+    tempfile.unlink
+  end
 end
