diff --git a/app/models/account/export.rb b/app/models/account/export.rb
new file mode 100644
index 0000000..0d7a450
--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,62 @@
+class Account::Export < ApplicationRecord
+  TTL = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :kind, %w[ account cards ].index_by(&:itself), prefix: true
+
+  after_create_commit :export_later
+
+  scope :expired, -> { where(created_at: ...TTL.ago) }
+
+  def self.expire_all
+    expired.find_each(&:expire)
+  end
+
+  def export_later
+    Account::ExportJob.perform_later(self)
+  end
+
+  def export_now
+    return if file.attached?
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      writer.export_to(zip)
+    end
+
+    AccountMailer.export_ready(self).deliver_later
+  end
+
+  def expire
+    file.purge_later if file.attached?
+    destroy
+  end
+
+  def expired?
+    created_at < TTL.ago
+  end
+
+  def accessible_to?(user)
+    user_id == user.id && file.attached? && !expired?
+  end
+
+  def filename
+    if kind_cards?
+      "#{user.name.parameterize.presence || "cards"}-cards-#{created_at.to_date}.zip"
+    else
+      "#{account.name.parameterize.presence || "account"}-export-#{created_at.to_date}.zip"
+    end
+  end
+
+  private
+    def writer
+      if kind_cards?
+        Account::DataTransfer::CardDump.new(user)
+      else
+        Account::DataTransfer::Manifest.new(account)
+      end
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..9e497fd
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,154 @@
+class Account::Import < ApplicationRecord
+  class InvalidExport < StandardError; end
+
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  after_create_commit :import_later, if: :pending?
+
+  class << self
+    def create_from(file:, identity:)
+      raise InvalidExport, "Choose a Fizzy account export zip to import." if file.blank?
+
+      account = create_destination_account
+      Current.with_account(account) do
+        import = new(identity: identity, account: account)
+        attach_uploaded_file(import, file)
+        import.save!
+        import
+      end
+    end
+
+    private
+      def attach_uploaded_file(import, file)
+        if file.is_a?(Hash)
+          import.file.attach(io: file[:io] || file["io"], filename: file[:filename] || file["filename"], content_type: file[:content_type] || file["content_type"])
+        else
+          import.file.attach(file)
+        end
+      end
+
+      def create_destination_account
+        id = ActiveRecord::Type::Uuid.generate
+        now = Time.current
+
+        Account.insert!({
+          id: id,
+          name: "Imported account",
+          external_account_id: Account::ExternalIdSequence.next,
+          cards_count: 0,
+          created_at: now,
+          updated_at: now
+        })
+
+        Account.find(id)
+      end
+  end
+
+  def import_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def import_now
+    return if completed? || failed?
+
+    processing!
+
+    ZipFile.open(file) do |zip|
+      Current.with_account(account) do
+        manifest.import_from(zip)
+        finalize_account
+      end
+    end
+
+    completed!
+    AccountMailer.import_completed(self).deliver_later
+  rescue => error
+    fail_and_rollback(error)
+  end
+
+  private
+    def manifest
+      @manifest ||= Account::DataTransfer::Manifest.new(account)
+    end
+
+    def finalize_account
+      account.create_join_code! unless account.join_code
+      ensure_importer_access
+      reindex_search
+      reconcile_storage
+    end
+
+    def ensure_importer_access
+      user = account.users.find_by(identity: identity)
+
+      if user
+        user.update_columns(role: "owner", active: true, verified_at: user.verified_at || Time.current) unless user.owner?
+      else
+        user = account.users.create!(
+          identity: identity,
+          name: identity.email_address,
+          role: :owner,
+          verified_at: Time.current
+        )
+        grant_access_to_all_boards(user)
+      end
+    end
+
+    def grant_access_to_all_boards(user)
+      account.boards.find_each do |board|
+        Access.find_or_create_by!(board: board, user: user) do |access|
+          access.account = account
+          access.involvement = :watching
+        end
+      end
+    end
+
+    def reindex_search
+      Card.where(account_id: account.id).find_each(&:reindex)
+      Comment.where(account_id: account.id).find_each(&:reindex)
+    end
+
+    def reconcile_storage
+      account.boards.find_each(&:reconcile_storage)
+      account.reconcile_storage
+    end
+
+    def fail_and_rollback(error)
+      Rails.error.report(error)
+      message = import_error_message(error)
+      rollback_account
+      update!(status: :failed, error_message: message)
+      AccountMailer.import_failed(self).deliver_later
+    end
+
+    def import_error_message(error)
+      case error
+      when InvalidExport
+        error.message
+      when JSON::ParserError, ZipKit::FileReader::InvalidStructure, ZipKit::FileReader::ReadError, Errno::ENOENT, ArgumentError
+        "This file isn't a valid Fizzy account export."
+      else
+        error.message.to_s.truncate(500)
+      end
+    end
+
+    def rollback_account
+      return if account.blank?
+
+      imported_account = account
+      file.purge if file.attached?
+      update_columns(account_id: nil)
+
+      Current.with_account(imported_account) do
+        Account::DataTransfer::Manifest.new(imported_account).delete_imported
+        Storage::Entry.suppressing_recording { imported_account.destroy! }
+      end
+    rescue => rollback_error
+      Rails.error.report(rollback_error)
+    end
+end
