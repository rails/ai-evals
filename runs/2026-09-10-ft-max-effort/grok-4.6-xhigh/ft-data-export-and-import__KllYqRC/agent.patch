diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..4df3d60
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.session = Session.new(identity: @user.identity)
+    Current.account = @account
+  end
+
+  test "importing an account export creates a new account with boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    original_title = card.title
+    original_comment = comments(:logo_agreement_jz).body.to_plain_text
+    original_board = boards(:writebook).name
+
+    zip = exported_account_zip
+
+    assert_difference -> { Account.count }, 1 do
+      import = Account::Import.create_from(file: zip, identity: @user.identity)
+      perform_enqueued_jobs only: Account::ImportJob
+      import.reload
+
+      assert import.completed?, import.error_message
+      imported = import.account
+      assert_not_equal @account.id, imported.id
+      assert_equal @account.name, imported.name
+      assert imported.boards.exists?(name: original_board)
+      assert imported.cards.exists?(title: original_title)
+      assert imported.users.exists?(name: "Kevin")
+      assert imported.users.exists?(name: "David")
+      assert Comment.where(account: imported).any? { |comment| comment.body.to_plain_text == original_comment }
+      assert ActiveStorage::Blob.where(account: imported).exists?
+    end
+  end
+
+  test "cannot import a cards export" do
+    export = @user.exports.create!(account: @account, kind: :cards)
+    perform_enqueued_jobs only: Account::ExportJob
+
+    zip = {
+      io: StringIO.new(export.reload.file.download),
+      filename: export.file.filename.to_s,
+      content_type: "application/zip"
+    }
+    import = Account::Import.create_from(file: zip, identity: @user.identity)
+    imported_account_id = import.account_id
+    perform_enqueued_jobs only: Account::ImportJob
+    import.reload
+
+    assert import.failed?
+    assert_match(/isn't a Fizzy account export/i, import.error_message)
+    assert_not Account.exists?(imported_account_id)
+  end
+
+  test "failed import leaves no account behind" do
+    import = Account::Import.create_from(
+      file: { io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip" },
+      identity: @user.identity
+    )
+    imported_account_id = import.account_id
+
+    perform_enqueued_jobs only: Account::ImportJob
+
+    import.reload
+    assert import.failed?
+    assert_nil import.account_id
+    assert_not Account.exists?(imported_account_id)
+    assert import.error_message.present?
+  end
+
+  test "sends an email when the import completes" do
+    zip = exported_account_zip
+    import = Account::Import.create_from(file: zip, identity: @user.identity)
+
+    perform_enqueued_jobs only: Account::ImportJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    import.reload
+
+    email = ActionMailer::Base.deliveries.last
+    assert import.completed?, import.error_message
+    assert_includes email.to, @user.identity.email_address
+    assert_match(/import is ready/i, email.subject)
+  end
+
+  test "sends an email with the reason when the import fails" do
+    import = Account::Import.create_from(
+      file: { io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip" },
+      identity: @user.identity
+    )
+
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      perform_enqueued_jobs only: Account::ImportJob
+    end
+
+    import.reload
+    email = AccountMailer.import_failed(import)
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match(/import failed/i, email.subject)
+    assert_match import.error_message, email.body.encoded
+  end
+
+  private
+    def exported_account_zip
+      export = @account.exports.create!(user: @user, kind: :account)
+      perform_enqueued_jobs only: Account::ExportJob
+      {
+        io: StringIO.new(export.reload.file.download),
+        filename: export.file.filename.to_s,
+        content_type: "application/zip"
+      }
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
