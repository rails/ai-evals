diff --git a/app/models/account/data_transfer/card_dump.rb b/app/models/account/data_transfer/card_dump.rb
new file mode 100644
index 0000000..d12f76b
--- /dev/null
+++ b/app/models/account/data_transfer/card_dump.rb
@@ -0,0 +1,93 @@
+class Account::DataTransfer::CardDump
+  def initialize(user)
+    @user = user
+    @account = user.account
+  end
+
+  def export_to(zip)
+    zip.add_file("version.json", JSON.pretty_generate(format: 1, kind: "cards", exported_at: Time.current.iso8601))
+
+    cards.find_each do |card|
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_payload(card)))
+      attach_files(zip, card)
+    end
+  end
+
+  private
+    attr_reader :user, :account
+
+    def cards
+      user.accessible_cards.preloaded.includes(comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ])
+    end
+
+    def card_payload(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description&.to_plain_text,
+        description_html: card.description&.to_s,
+        created_at: card.created_at&.iso8601,
+        last_active_at: card.last_active_at&.iso8601,
+        board: { id: card.board_id, name: card.board.name },
+        column: card.column && { id: card.column_id, name: card.column.name },
+        creator: person(card.creator),
+        assignees: card.assignees.map { |assignee| person(assignee) },
+        tags: card.tags.map(&:title).sort,
+        comments: card.comments.chronologically.map { |comment| comment_payload(comment) },
+        files: file_payloads(card)
+      }
+    end
+
+    def comment_payload(comment)
+      {
+        id: comment.id,
+        body: comment.body&.to_plain_text,
+        body_html: comment.body&.to_s,
+        created_at: comment.created_at&.iso8601,
+        creator: person(comment.creator)
+      }
+    end
+
+    def person(user)
+      {
+        id: user.id,
+        name: user.name,
+        email_address: user.identity&.email_address
+      }
+    end
+
+    def file_payloads(card)
+      blobs_for(card).map do |blob|
+        {
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          byte_size: blob.byte_size,
+          path: file_path(blob)
+        }
+      end
+    end
+
+    def attach_files(zip, card)
+      blobs_for(card).each do |blob|
+        zip.add_file(file_path(blob), compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+
+    def blobs_for(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat(card.attachments.map(&:blob))
+      card.comments.each do |comment|
+        blobs.concat(comment.attachments.map(&:blob))
+      end
+      blobs.compact.uniq
+    end
+
+    def file_path(blob)
+      "files/#{blob.id}/#{blob.filename}"
+    end
+end
