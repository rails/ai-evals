diff --git a/app/models/zip_file/extractor_io.rb b/app/models/zip_file/extractor_io.rb
new file mode 100644
index 0000000..eebb1b5
--- /dev/null
+++ b/app/models/zip_file/extractor_io.rb
@@ -0,0 +1,58 @@
+class ZipFile::ExtractorIO
+  CHUNK = 1.megabyte
+
+  def initialize(extractor)
+    @extractor = extractor
+    @buffer = +"".b
+  end
+
+  def read(length = nil, outbuf = nil)
+    data = if length.nil?
+      drain_remaining
+    else
+      take(length)
+    end
+
+    outbuf.replace(data || "") if outbuf
+    data
+  end
+
+  def eof?
+    @buffer.empty? && @extractor.eof?
+  end
+
+  def binmode
+    self
+  end
+
+  def close
+    self
+  end
+
+  private
+    def drain_remaining
+      parts = [ @buffer ]
+      @buffer = +"".b
+
+      until @extractor.eof?
+        chunk = @extractor.extract(CHUNK)
+        parts << chunk if chunk
+      end
+
+      parts.join.b
+    end
+
+    def take(length)
+      fill_buffer_to(length)
+      data = @buffer.byteslice(0, length)
+      @buffer = @buffer.byteslice(length..) || +"".b
+      data
+    end
+
+    def fill_buffer_to(length)
+      while @buffer.bytesize < length && !@extractor.eof?
+        chunk = @extractor.extract(CHUNK)
+        @buffer << chunk if chunk
+      end
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..9ab3d43
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,33 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def read(path)
+    buffer = +"".b
+    open(path) { |io| buffer << io.read unless io.nil? }
+    buffer
+  end
+
+  def open(path)
+    entry = @entries.fetch(path) { raise ArgumentError, "Zip entry not found: #{path}" }
+    io = ZipFile::ExtractorIO.new(entry.extractor_from(@io))
+    yield io
+  end
+
+  def each_json_line(path)
+    read(path).each_line do |line|
+      line = line.strip
+      yield JSON.parse(line) unless line.empty?
+    end
+  end
+end
