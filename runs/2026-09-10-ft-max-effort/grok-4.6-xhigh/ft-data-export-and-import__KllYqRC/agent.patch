index 0000000..f628af1
--- /dev/null
+++ b/test/mailers/account_mailer_export_import_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class AccountMailerExportImportTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    Current.account = @account
+    Current.session = Session.new(identity: @user.identity)
+  end
+
+  test "export_ready includes a download link" do
+    export = @account.exports.create!(user: @user, kind: :account)
+    export.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+
+    email = AccountMailer.export_ready(export)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match(/export is ready/i, email.subject)
+    assert_match(/download/i, email.body.encoded)
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+
+  test "import_completed includes the new account name" do
+    import = Account::Import.new(identity: @user.identity, account: @account, status: :completed)
+
+    email = AccountMailer.import_completed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match(/import is ready/i, email.subject)
+    assert_match @account.name, email.body.encoded
+  end
+
+  test "import_failed includes the error" do
+    import = Account::Import.new(identity: @user.identity, status: :failed, error_message: "Not a valid export")
+
+    email = AccountMailer.import_failed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match(/import failed/i, email.subject)
+    assert_match "Not a valid export", email.body.encoded
+  end
+end
