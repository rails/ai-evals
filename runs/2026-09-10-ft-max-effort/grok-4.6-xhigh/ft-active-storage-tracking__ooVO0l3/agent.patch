diff --git a/app/jobs/storage/adjustment_job.rb b/app/jobs/storage/adjustment_job.rb
new file mode 100644
index 0000000..bdbc64f
--- /dev/null
+++ b/app/jobs/storage/adjustment_job.rb
@@ -0,0 +1,8 @@
+class Storage::AdjustmentJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account_id, board_id, delta)
+    Account.update_counters(account_id, bytes_used: delta) if account_id
+    Board.update_counters(board_id, bytes_used: delta) if board_id
+  end
+end
