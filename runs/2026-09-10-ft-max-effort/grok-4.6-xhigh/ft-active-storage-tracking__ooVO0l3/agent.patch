diff --git a/lib/rails_ext/active_storage_attachment_storage.rb b/lib/rails_ext/active_storage_attachment_storage.rb
new file mode 100644
index 0000000..0bcdff4
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage.rb
@@ -0,0 +1,78 @@
+# Keep account and board storage counters in sync as attachments come and go.
+#
+# `purge`/`purge_later` call `delete` (skipping destroy callbacks), so both
+# destroy and delete have to apply the same adjustment.
+module ActiveStorageAttachmentStorage
+  def delete
+    if persisted?
+      remember_storage_usage
+      decrement_storage_usage_later
+    end
+
+    super
+  end
+
+  private
+    def remember_storage_usage
+      return unless counted_for_storage?
+
+      @storage_byte_size = blob.byte_size
+      if board = storage_board
+        @storage_board_id = board.id
+        @storage_account_id = board.account_id
+      end
+    rescue ActiveRecord::RecordNotFound
+      @storage_byte_size = nil
+    end
+
+    def increment_storage_usage_later
+      return unless counted_for_storage?
+      return unless board = storage_board
+      return if blob.byte_size.zero?
+
+      Storage::AdjustmentJob.perform_later(board.account_id, board.id, blob.byte_size)
+    end
+
+    def decrement_storage_usage_later
+      return unless @storage_byte_size&.positive?
+      return unless @storage_board_id
+
+      Storage::AdjustmentJob.perform_later(@storage_account_id, @storage_board_id, -@storage_byte_size)
+    end
+
+    def counted_for_storage?
+      image_attachment? || rich_text_embed?
+    end
+
+    def image_attachment?
+      record_type == "Card" && name == "image"
+    end
+
+    def rich_text_embed?
+      record_type == "ActionText::RichText"
+    end
+
+    def storage_board
+      case record
+      when Card then record.board
+      when ActionText::RichText then board_for_rich_text_owner(record.record)
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def board_for_rich_text_owner(owner)
+      case owner
+      when Board then owner
+      when Card then owner.board
+      when Comment then owner.board
+      end
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  before_destroy :remember_storage_usage, prepend: true
+  after_create_commit :increment_storage_usage_later
+  after_destroy_commit :decrement_storage_usage_later
+  prepend ActiveStorageAttachmentStorage
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..3730fac
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,225 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "bytes_used starts at zero" do
+    assert_equal 0, boards(:writebook).bytes_used
+    assert_equal 0, accounts("37s").bytes_used
+  end
+
+  test "card image counts toward board and account usage after the background job" do
+    card = cards(:logo)
+    board = card.board
+    account = card.account
+
+    assert_no_changes -> { [ board.reload.bytes_used, account.reload.bytes_used ] } do
+      attach_image(card)
+    end
+
+    size = card.image.blob.byte_size
+
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal size, board.reload.bytes_used
+    assert_equal size, account.reload.bytes_used
+  end
+
+  test "card description embeds count toward usage" do
+    card = cards(:logo)
+    blob = attach_embed(card, :description)
+
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal blob.byte_size, card.board.reload.bytes_used
+    assert_equal blob.byte_size, card.account.reload.bytes_used
+  end
+
+  test "comment embeds count toward usage" do
+    comment = cards(:logo).comments.create!(body: "Check this out")
+    blob = attach_embed(comment, :body)
+
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal blob.byte_size, comment.board.reload.bytes_used
+    assert_equal blob.byte_size, comment.account.reload.bytes_used
+  end
+
+  test "board description embeds count toward usage" do
+    board = boards(:writebook)
+    blob = attach_embed(board, :public_description)
+
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal blob.byte_size, board.reload.bytes_used
+    assert_equal blob.byte_size, board.account.reload.bytes_used
+  end
+
+  test "usage is the sum of counted attachments on a board" do
+    card = cards(:logo)
+    image_blob = attach_image(card)
+    description_blob = attach_embed(card, :description)
+    comment = card.comments.create!(body: "File")
+    comment_blob = attach_embed(comment, :body)
+    board_blob = attach_embed(card.board, :public_description)
+
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    expected = image_blob.byte_size + description_blob.byte_size + comment_blob.byte_size + board_blob.byte_size
+    assert_equal expected, card.board.reload.bytes_used
+    assert_equal expected, card.account.reload.bytes_used
+  end
+
+  test "account usage includes counted attachments across all of its boards" do
+    writebook = boards(:writebook)
+    private_board = boards(:private)
+    writebook_blob = attach_image(cards(:logo))
+    private_card = private_board.cards.create!(title: "Private card", creator: users(:kevin))
+    private_blob = attach_image(private_card)
+
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal writebook_blob.byte_size, writebook.reload.bytes_used
+    assert_equal private_blob.byte_size, private_board.reload.bytes_used
+    assert_equal writebook_blob.byte_size + private_blob.byte_size, accounts("37s").reload.bytes_used
+  end
+
+  test "removing a card image decrements usage" do
+    card = cards(:logo)
+    blob = attach_image(card)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal blob.byte_size, card.board.reload.bytes_used
+
+    card.image.purge
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  test "destroying a card decrements usage for its image, description, and comments" do
+    card = cards(:logo)
+    image_blob = attach_image(card)
+    description_blob = attach_embed(card, :description)
+    comment = card.comments.create!(body: "File")
+    comment_blob = attach_embed(comment, :body)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    expected = image_blob.byte_size + description_blob.byte_size + comment_blob.byte_size
+    assert_equal expected, card.board.reload.bytes_used
+
+    card.destroy
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "destroying a comment decrements usage" do
+    comment = cards(:logo).comments.create!(body: "File")
+    blob = attach_embed(comment, :body)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    comment.destroy
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "moving a card transfers usage between boards without changing account usage" do
+    card = cards(:logo)
+    blob = attach_image(card)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    old_board = boards(:writebook)
+    new_board = boards(:private)
+    account = accounts("37s")
+
+    assert_equal blob.byte_size, old_board.reload.bytes_used
+    assert_equal 0, new_board.reload.bytes_used
+
+    card.move_to(new_board)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal blob.byte_size, new_board.reload.bytes_used
+    assert_equal blob.byte_size, account.reload.bytes_used
+  end
+
+  test "destroying a board decrements account usage" do
+    board = boards(:private)
+    card = board.cards.create!(title: "Soon gone", creator: users(:kevin))
+    blob = attach_image(card)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal blob.byte_size, accounts("37s").reload.bytes_used
+
+    board.destroy
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "replacing a card image updates usage to the new file size" do
+    card = cards(:logo)
+    original = attach_image(card)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal original.byte_size, card.board.reload.bytes_used
+
+    card.image.attach(io: StringIO.new("tiny"), filename: "tiny.txt", content_type: "text/plain")
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal "tiny".bytesize, card.board.reload.bytes_used
+    assert_equal "tiny".bytesize, card.account.reload.bytes_used
+  end
+
+  test "removing a description embed decrements usage" do
+    card = cards(:logo)
+    attach_embed(card, :description)
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    card.update!(description: "No files here")
+    perform_enqueued_jobs only: Storage::AdjustmentJob
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  test "user avatars are not counted" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    assert_no_enqueued_jobs only: Storage::AdjustmentJob
+    assert_equal 0, accounts("37s").reload.bytes_used
+    assert_equal 0, boards(:writebook).reload.bytes_used
+  end
+
+  test "export files are not counted" do
+    export = exports(:pending_account_export)
+    export.file.attach(io: StringIO.new("zip-bytes"), filename: "export.zip", content_type: "application/zip")
+
+    assert_no_enqueued_jobs only: Storage::AdjustmentJob
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  private
+    def attach_image(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.image.blob
+    end
+
+    def attach_embed(record, attribute)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      html = ActionText::Attachment.from_attachable(blob).to_html
+      record.update!(attribute => html)
+      blob
+    end
+end
