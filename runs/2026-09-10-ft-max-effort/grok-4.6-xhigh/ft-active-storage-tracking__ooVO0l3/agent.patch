diff --git a/app/models/card/storage.rb b/app/models/card/storage.rb
new file mode 100644
index 0000000..cccc54d
--- /dev/null
+++ b/app/models/card/storage.rb
@@ -0,0 +1,22 @@
+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :transfer_storage_usage, if: :saved_change_to_board_id?
+  end
+
+  private
+    def transfer_storage_usage
+      delta = calculate_storage_bytes
+      return if delta.zero?
+
+      Storage::AdjustmentJob.perform_later(nil, board_id_before_last_save, -delta)
+      Storage::AdjustmentJob.perform_later(nil, board_id, delta)
+    end
+
+    def calculate_storage_bytes
+      Storage.bytes_used_by("Card", id, name: "image") +
+        Storage.rich_text_bytes_used_by("Card", id) +
+        Storage.rich_text_bytes_used_by("Comment", comments.select(:id))
+    end
+end
diff --git a/app/models/storage.rb b/app/models/storage.rb
new file mode 100644
index 0000000..1ef0dc9
--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,13 @@
+module Storage
+  class << self
+    def bytes_used_by(record_type, record_ids, name: nil)
+      scope = ActiveStorage::Attachment.joins(:blob).where(record_type: record_type, record_id: record_ids)
+      scope = scope.where(name: name) if name
+      scope.sum("active_storage_blobs.byte_size")
+    end
+
+    def rich_text_bytes_used_by(record_type, record_ids)
+      bytes_used_by("ActionText::RichText", ActionText::RichText.where(record_type: record_type, record_id: record_ids).select(:id))
+    end
+  end
+end
