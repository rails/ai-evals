diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..444de5c
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,77 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify, inverse_of: :bundle
+
+  after_create_commit :deliver_later
+
+  validate :must_not_overlap
+
+  scope :overlapping, ->(range) { where("starts_at < ? AND ends_at > ?", range.end, range.begin) }
+
+  class << self
+    def capture(notification)
+      if duration = notification.user.settings&.bundle_email_duration
+        transaction do
+          notification.user.lock!
+          open_window_for(notification.user, notification.created_at, duration).tap do |bundle|
+            bundle.add(notification)
+          end
+        end
+      end
+    end
+
+    private
+      def open_window_for(user, time, duration)
+        find_window_for(user, time, duration) || start_window_for(user, time, duration)
+      end
+
+      def find_window_for(user, time, duration)
+        user.notification_bundles.overlapping(time...time + duration).order(:starts_at).first
+      end
+
+      def start_window_for(user, time, duration)
+        starts_at = [ time, user.notification_bundles.maximum(:ends_at) ].compact.max
+        create!(user: user, starts_at: starts_at, ends_at: starts_at + duration)
+      end
+  end
+
+  def add(notification)
+    if notification.bundle_id != id
+      notification.update_column(:bundle_id, id)
+    end
+  end
+
+  def deliver_later
+    Notification::BundleJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    return if delivered?
+
+    if deliverable?
+      NotificationMailer.bundle(self).deliver_now
+    end
+
+    touch(:delivered_at)
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  private
+    def deliverable?
+      notifications.exists? && user.active? && user.identity.present? && user.settings&.bundle_email_duration.present?
+    end
+
+    def must_not_overlap
+      if user_id && starts_at && ends_at && overlapping_windows.exists?
+        errors.add(:base, "cannot overlap another window")
+      end
+    end
+
+    def overlapping_windows
+      self.class.where(user_id: user_id).where.not(id: id).overlapping(starts_at...ends_at)
+    end
+end
