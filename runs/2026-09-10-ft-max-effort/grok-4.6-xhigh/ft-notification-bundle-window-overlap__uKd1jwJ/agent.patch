--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,22 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(:created_at)
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    mail to: @user.identity.email_address, subject: subject_for(@notifications)
+  end
+
+  private
+    def subject_for(notifications)
+      count = notifications.size
+      boards = notifications.map { |notification| notification.card.board.name }.uniq
+
+      if boards.one?
+        "#{count} #{'notification'.pluralize(count)} on #{boards.first}"
+      else
+        "#{count} new Fizzy #{'notification'.pluralize(count)}"
+      end
+    end
+end
