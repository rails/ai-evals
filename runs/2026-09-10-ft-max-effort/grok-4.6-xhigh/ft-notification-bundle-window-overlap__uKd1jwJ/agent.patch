diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..d2cdc76
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @user.notifications.delete_all
+    @user.notification_bundles.delete_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "never does not open a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      create_notification(source: events(:layout_published))
+    end
+  end
+
+  test "the clock starts when the first notification lands" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      notification = create_notification(source: events(:layout_published))
+      bundle = notification.reload.bundle
+
+      assert_equal Time.zone.parse("2026-03-15 10:00"), bundle.starts_at
+      assert_equal Time.zone.parse("2026-03-15 14:00"), bundle.ends_at
+    end
+  end
+
+  test "every_few_hours windows last four hours" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      bundle = create_notification(source: events(:layout_published)).reload.bundle
+      assert_equal 4.hours, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "daily windows last one day" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      bundle = create_notification(source: events(:layout_published)).reload.bundle
+      assert_equal 1.day, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "weekly windows last one week" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      bundle = create_notification(source: events(:layout_published)).reload.bundle
+      assert_equal 1.week, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "later notifications join the window that has already opened" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      first = create_notification(source: events(:layout_published))
+
+      travel_to Time.zone.parse("2026-03-15 12:00")
+      second = create_notification(source: events(:text_published))
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal first.reload.bundle, second.reload.bundle
+    end
+  end
+
+  test "late notifications belong in the window that has already opened" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      create_notification(source: events(:layout_published))
+    end
+
+    travel_to Time.zone.parse("2026-03-15 12:00") do
+      late = create_notification(source: events(:text_published), created_at: Time.zone.parse("2026-03-15 09:00"))
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal first_bundle, late.reload.bundle
+      assert_operator late.reload.bundle.starts_at, :>, late.created_at
+    end
+  end
+
+  test "a notification after the window ends opens a new non-overlapping window" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      create_notification(source: events(:layout_published))
+    end
+
+    travel_to Time.zone.parse("2026-03-15 14:00") do
+      second = create_notification(source: events(:text_published))
+
+      assert_equal 2, @user.notification_bundles.count
+      assert_not_equal first_bundle, second.reload.bundle
+      assert_operator first_bundle.ends_at, :<=, second.reload.bundle.starts_at
+    end
+  end
+
+  test "nobody should ever end up with two overlapping windows" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      create_notification(source: events(:layout_published))
+    end
+
+    travel_to Time.zone.parse("2026-03-15 12:00") do
+      create_notification(source: events(:text_published), created_at: Time.zone.parse("2026-03-15 09:00"))
+      create_notification(source: events(:shipping_published), created_at: Time.zone.parse("2026-03-15 11:00"))
+    end
+
+    windows = @user.notification_bundles.order(:starts_at).to_a
+    assert_equal 1, windows.size
+
+    travel_to Time.zone.parse("2026-03-15 14:00") do
+      create_notification(source: events(:buy_domain_sent_back_to_triage))
+    end
+
+    windows = @user.notification_bundles.order(:starts_at).to_a
+    assert_equal 2, windows.size
+    windows.each_cons(2) do |left, right|
+      assert_operator left.ends_at, :<=, right.starts_at
+    end
+  end
+
+  test "creating an overlapping window is rejected" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      create_notification(source: events(:layout_published))
+    end
+
+    bundle = @user.notification_bundles.new(
+      starts_at: Time.zone.parse("2026-03-15 12:00"),
+      ends_at: Time.zone.parse("2026-03-15 16:00")
+    )
+
+    assert_not bundle.valid?
+    assert_includes bundle.errors[:base], "cannot overlap another window"
+  end
+
+  test "schedules one email delivery at the end of the window" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      assert_enqueued_with(job: Notification::BundleJob, at: Time.zone.parse("2026-03-15 14:00")) do
+        create_notification(source: events(:layout_published))
+      end
+
+      assert_no_enqueued_jobs only: Notification::BundleJob do
+        create_notification(source: events(:text_published))
+      end
+    end
+  end
+
+  test "sends one email per window with every notification in it" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      create_notification(source: events(:layout_published))
+      create_notification(source: events(:text_published))
+    end
+
+    bundle = first_bundle
+
+    assert_emails 1 do
+      travel_to bundle.ends_at
+      perform_enqueued_jobs only: Notification::BundleJob
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_match cards(:layout).title, email.body.encoded
+    assert_match cards(:text).title, email.body.encoded
+    assert bundle.reload.delivered?
+  end
+
+  test "does not send email when frequency is switched to never" do
+    travel_to Time.zone.parse("2026-03-15 10:00") do
+      create_notification(source: events(:layout_published))
+    end
+
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_emails do
+      travel_to first_bundle.ends_at
+      perform_enqueued_jobs only: Notification::BundleJob
+    end
+
+    assert first_bundle.reload.delivered?
+  end
+
+  test "users without settings are skipped" do
+    user = users(:jason)
+
+    assert_nil user.settings
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(user: user, source: events(:layout_published), creator: users(:david))
+    end
+  end
+
+  private
+    def create_notification(source:, created_at: Time.current)
+      Notification.create!(
+        user: @user,
+        source: source,
+        creator: users(:jz),
+        created_at: created_at
+      )
+    end
+
+    def first_bundle
+      @user.notification_bundles.order(:starts_at).first
+    end
+end
