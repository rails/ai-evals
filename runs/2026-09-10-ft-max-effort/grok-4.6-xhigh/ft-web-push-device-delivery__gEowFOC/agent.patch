--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+
+    ENV["VAPID_PUBLIC_KEY"] = "test-public-key"
+    ENV["VAPID_PRIVATE_KEY"] = "test-private-key"
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "title and body match the tray for an event" do
+    assert_equal "The logo isn't big enough", @notification.title
+    assert_equal "Assigned to Kevin", @notification.body
+  end
+
+  test "title and body match the tray for a mention" do
+    notification = notifications(:logo_mentioned_david)
+
+    assert_equal "JZ @mentioned you", notification.title
+    assert_equal notification.source.source.mentionable_content.truncate(200), notification.body
+  end
+
+  test "creating a notification enqueues a push when the user has subscriptions" do
+    Push::Subscription.subscribe(@user, **subscription_attributes)
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "creating a notification does not enqueue a push without subscriptions" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "updating the source enqueues a push" do
+    Push::Subscription.subscribe(@user, **subscription_attributes)
+
+    assert_enqueued_with job: Notification::PushJob do
+      @notification.update!(source: events(:logo_published), creator: users(:david), read_at: nil)
+    end
+  end
+
+  test "push_now delivers to every subscription" do
+    Push::Subscription.subscribe(@user, **subscription_attributes)
+    Push::Subscription.subscribe(@user, **subscription_attributes.merge(endpoint: "https://push.example.com/kevin-other"))
+
+    WebPush.expects(:payload_send).twice
+
+    @notification.push_now
+  end
+
+  test "push_now skips inactive users" do
+    Push::Subscription.subscribe(@user, **subscription_attributes)
+    @user.update_column(:active, false)
+    WebPush.expects(:payload_send).never
+
+    @notification.push_now
+  end
+
+  private
+    def subscription_attributes
+      {
+        endpoint: "https://push.example.com/kevin",
+        p256dh_key: "kevin-p256dh",
+        auth_key: "kevin-auth",
+        user_agent: "Mozilla/5.0"
+      }
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..53cce5b
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = Push::Subscription.subscribe(@user, **subscription_attributes)
+
+    ENV["VAPID_PUBLIC_KEY"] = "test-public-key"
+    ENV["VAPID_PRIVATE_KEY"] = "test-private-key"
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "push sends the tray title, body, and card path" do
+    WebPush.expects(:payload_send).with do |kwargs|
+      message = JSON.parse(kwargs[:message])
+
+      kwargs[:endpoint] == @subscription.endpoint &&
+        kwargs[:p256dh] == @subscription.p256dh_key &&
+        kwargs[:auth] == @subscription.auth_key &&
+        kwargs[:vapid][:public_key] == "test-public-key" &&
+        kwargs[:vapid][:private_key] == "test-private-key" &&
+        message["title"] == @notification.title &&
+        message["body"] == @notification.body &&
+        message["path"] == card_path(@notification.card, script_name: @user.account.slug)
+    end
+
+    @subscription.push(@notification)
+  end
+
+  test "push destroys expired subscriptions" do
+    WebPush.stubs(:payload_send).raises(expired_subscription_error)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+  end
+
+  test "push is a no-op without VAPID keys" do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+
+    WebPush.expects(:payload_send).never
+
+    @subscription.push(@notification)
+  end
+
+  private
+    def subscription_attributes
+      {
+        endpoint: "https://push.example.com/kevin",
+        p256dh_key: "kevin-p256dh",
+        auth_key: "kevin-auth",
+        user_agent: "Mozilla/5.0"
+      }
+    end
+
+    def expired_subscription_error
+      WebPush::ExpiredSubscription.new(stub(body: "", inspect: "410"), "push.example.com")
+    end
+end
