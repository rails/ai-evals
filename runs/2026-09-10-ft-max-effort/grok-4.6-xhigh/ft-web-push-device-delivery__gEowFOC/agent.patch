+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,44 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_own_user
+
+  def create
+    Push::Subscription.subscribe(@user, **subscription_attributes)
+
+    head :ok
+  end
+
+  def destroy
+    @user.push_subscriptions.destroy_by(endpoint: endpoint_param)
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_own_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_attributes
+      {
+        endpoint: endpoint_param,
+        p256dh_key: push_subscription_params[:p256dh_key],
+        auth_key: push_subscription_params[:auth_key],
+        user_agent: request.user_agent
+      }
+    end
+
+    def endpoint_param
+      push_subscription_params[:endpoint]
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
