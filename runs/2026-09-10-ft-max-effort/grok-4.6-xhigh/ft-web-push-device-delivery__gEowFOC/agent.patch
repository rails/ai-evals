new file mode 100644
index 0000000..9d5a1c8
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,55 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :push_later
+    after_update_commit :push_later_on_source_change
+  end
+
+  def title
+    case source
+    when Event
+      helpers.event_notification_title(source)
+    when Mention
+      "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def body
+    case source
+    when Event
+      helpers.event_notification_body(source)
+    when Mention
+      source.source.mentionable_content.truncate(200)
+    end
+  end
+
+  def push_later
+    if pushable?
+      Notification::PushJob.perform_later(self)
+    end
+  end
+
+  def push_now
+    if pushable?
+      user.push_subscriptions.find_each do |subscription|
+        subscription.push(self)
+      end
+    end
+  end
+
+  private
+    def push_later_on_source_change
+      if saved_change_to_source_id?
+        push_later
+      end
+    end
+
+    def pushable?
+      user.active? && account.active? && user.push_subscriptions.any? && Push::Subscription.configured?
+    end
+
+    def helpers
+      ApplicationController.helpers
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..783e264
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,51 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def subscribe(user, endpoint:, p256dh_key:, auth_key:, user_agent:)
+      where(endpoint: endpoint).where.not(user: user).destroy_all
+
+      user.push_subscriptions.find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent)
+      end
+    end
+
+    def vapid
+      {
+        subject: ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do"),
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    end
+
+    def configured?
+      vapid[:public_key].present? && vapid[:private_key].present?
+    end
+  end
+
+  def push(notification)
+    if self.class.configured?
+      WebPush.payload_send(
+        message: { title: notification.title, body: notification.body, path: path_for(notification) }.to_json,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: self.class.vapid,
+        open_timeout: 5,
+        read_timeout: 5
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  end
+
+  private
+    def path_for(notification)
+      Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug)
+    end
+end
