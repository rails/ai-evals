diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..559951f
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, headers: { "User-Agent" => "FizzyTest/1.0" }, as: :json
+    end
+
+    assert_response :ok
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/kevin", subscription.endpoint
+    assert_equal "kevin-p256dh", subscription.p256dh_key
+    assert_equal "kevin-auth", subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal "FizzyTest/1.0", subscription.user_agent
+  end
+
+  test "create updates an existing subscription for the same endpoint" do
+    subscription = Push::Subscription.subscribe(@user, **subscription_attributes)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params.merge(
+        push_subscription: subscription_params[:push_subscription].merge(p256dh_key: "rotated-p256dh")
+      ), as: :json
+    end
+
+    assert_response :ok
+    assert_equal "rotated-p256dh", subscription.reload.p256dh_key
+  end
+
+  test "create takes over an endpoint from another user" do
+    other = users(:david)
+    Push::Subscription.subscribe(other, **subscription_attributes)
+
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      assert_difference -> { other.push_subscriptions.count }, -1 do
+        post user_push_subscriptions_path(@user), params: subscription_params, headers: { "User-Agent" => "FizzyTest/1.0" }, as: :json
+      end
+    end
+
+    assert_response :ok
+    assert_equal @user, Push::Subscription.find_by(endpoint: subscription_attributes[:endpoint]).user
+  end
+
+  test "cannot create a subscription for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: subscription_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy" do
+    Push::Subscription.subscribe(@user, **subscription_attributes)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  private
+    def subscription_params
+      { push_subscription: subscription_attributes.except(:user_agent) }
+    end
+
+    def subscription_attributes
+      {
+        endpoint: "https://push.example.com/kevin",
+        p256dh_key: "kevin-p256dh",
+        auth_key: "kevin-auth",
+        user_agent: "Mozilla/5.0"
+      }
+    end
+end
