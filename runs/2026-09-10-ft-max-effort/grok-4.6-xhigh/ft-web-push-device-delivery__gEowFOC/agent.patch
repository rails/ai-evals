diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..bc02eb8
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,142 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "switch" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionsUrl: String
+  }
+
+  async connect() {
+    await this.#sync()
+  }
+
+  async toggle() {
+    try {
+      if (this.switchTarget.checked) {
+        await this.#subscribe()
+      } else {
+        await this.#unsubscribe()
+      }
+    } catch {
+      this.switchTarget.checked = false
+    }
+
+    this.#reflect()
+  }
+
+  async #sync() {
+    if (!this.#supported) {
+      this.switchTarget.disabled = true
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.switchTarget.disabled = true
+      this.switchTarget.checked = false
+      this.#showDetails()
+      this.#reflect()
+      return
+    }
+
+    this.#hideDetails()
+
+    const subscription = await this.#existingSubscription()
+    this.switchTarget.checked = subscription != null
+    this.#reflect()
+  }
+
+  async #subscribe() {
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.switchTarget.checked = false
+
+      if (permission === "denied") {
+        this.#showDetails()
+      }
+
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    await this.#save(subscription)
+  }
+
+  async #unsubscribe() {
+    const subscription = await this.#existingSubscription()
+
+    if (subscription) {
+      await this.#delete(subscription)
+      await subscription.unsubscribe()
+    }
+  }
+
+  async #save(subscription) {
+    const response = await post(this.subscriptionsUrlValue, {
+      body: this.#payload(subscription)
+    })
+
+    if (!response.ok) throw new Error("Failed to save subscription")
+  }
+
+  async #delete(subscription) {
+    const response = await destroy(this.subscriptionsUrlValue, {
+      body: this.#payload(subscription)
+    })
+
+    if (!response.ok) throw new Error("Failed to delete subscription")
+  }
+
+  async #existingSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  #payload(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    return {
+      push_subscription: {
+        endpoint,
+        p256dh_key: p256dh,
+        auth_key: auth
+      }
+    }
+  }
+
+  #reflect() {
+    this.element.classList.toggle("notifications--on", this.switchTarget.checked)
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(element => element.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(element => element.hidden = true)
+  }
+
+  get #supported() {
+    return this.vapidPublicKeyValue && "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = atob(base64)
+    const bytes = new Uint8Array(raw.length)
+
+    for (let i = 0; i < raw.length; i++) {
+      bytes[i] = raw.charCodeAt(i)
+    }
+
+    return bytes
+  }
+}
