diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..6e2af95
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,68 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_locale
+    after_action :persist_locale_to_identity
+
+    helper_method :available_locales
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def set_locale(&)
+      locale = resolve_locale
+      persist_locale_to_session(locale) if requested_locale
+      I18n.with_locale(locale, &)
+    end
+
+    def resolve_locale
+      requested_locale || session_locale || identity_locale || I18n.default_locale
+    end
+
+    def requested_locale
+      locale_if_available(params[:locale])
+    end
+
+    def session_locale
+      locale_if_available(session[:locale])
+    end
+
+    def identity_locale
+      locale_if_available(Current.identity&.locale)
+    end
+
+    def persist_locale_to_session(locale)
+      session[:locale] = locale.to_s
+    end
+
+    def persist_locale_to_identity
+      return unless requested_locale
+      return unless Current.identity
+      return if Current.identity.locale == requested_locale.to_s
+
+      Current.identity.update_column(:locale, requested_locale.to_s)
+    end
+
+    def locale_if_available(value)
+      value.to_s.presence_in(I18n.available_locales.map(&:to_s))
+    end
+
+    def available_locales
+      I18n.available_locales
+    end
+
+    def sync_locale_with_identity
+      return unless Current.identity
+
+      if session_locale
+        unless Current.identity.locale == session_locale.to_s
+          Current.identity.update_column(:locale, session_locale.to_s)
+        end
+      elsif identity_locale
+        session[:locale] = identity_locale.to_s
+      end
+    end
+end
