new file mode 100644
index 0000000..bf22c29
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,69 @@
+const translations = {
+  en: {
+    back_to: "Back to %{label}",
+    less_than_a_minute_ago: "Less than a minute ago",
+    year: { one: "%{count} year ago", other: "%{count} years ago" },
+    month: { one: "%{count} month ago", other: "%{count} months ago" },
+    week: { one: "%{count} week ago", other: "%{count} weeks ago" },
+    day: { one: "%{count} day ago", other: "%{count} days ago" },
+    hour: { one: "%{count} hour ago", other: "%{count} hours ago" },
+    minute: { one: "%{count} minute ago", other: "%{count} minutes ago" },
+    today: "today",
+    yesterday: "yesterday",
+    tomorrow: "tomorrow",
+    days_ago: "%{count} days ago",
+    in_days: "in %{count} days",
+    today_label: "Today",
+    day_unit: "day",
+    days_unit: "days",
+    stalled_for: "Stalled for",
+    action_in: "%{action} in",
+    please_fill_out: "Please fill out this field"
+  },
+  ja: {
+    back_to: "%{label} に戻る",
+    less_than_a_minute_ago: "1分未満前",
+    year: { one: "%{count}年前", other: "%{count}年前" },
+    month: { one: "%{count}ヶ月前", other: "%{count}ヶ月前" },
+    week: { one: "%{count}週間前", other: "%{count}週間前" },
+    day: { one: "%{count}日前", other: "%{count}日前" },
+    hour: { one: "%{count}時間前", other: "%{count}時間前" },
+    minute: { one: "%{count}分前", other: "%{count}分前" },
+    today: "今日",
+    yesterday: "昨日",
+    tomorrow: "明日",
+    days_ago: "%{count}日前",
+    in_days: "%{count}日後",
+    today_label: "今日",
+    day_unit: "日",
+    days_unit: "日",
+    stalled_for: "停滞",
+    action_in: "%{action}まで",
+    please_fill_out: "この欄を入力してください"
+  }
+}
+
+export function currentLocale() {
+  return document.documentElement.lang === "ja" ? "ja" : "en"
+}
+
+export function dateTimeLocale() {
+  return document.documentElement.lang === "ja" ? "ja-JP" : "en-US"
+}
+
+export function t(key, interpolations = {}) {
+  const locale = currentLocale()
+  const table = translations[locale] || translations.en
+  let str = table[key] ?? translations.en[key] ?? key
+
+  if (str && typeof str === "object") {
+    const count = interpolations.count
+    str = count === 1 ? str.one : str.other
+  }
+
+  Object.entries(interpolations).forEach(([name, value]) => {
+    str = String(str).replaceAll(`%{${name}}`, value)
+  })
+
+  return str
+}
