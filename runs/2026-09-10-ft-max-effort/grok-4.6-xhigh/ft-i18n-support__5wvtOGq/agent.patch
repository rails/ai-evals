diff --git a/test/integration/locale_switching_test.rb b/test/integration/locale_switching_test.rb
new file mode 100644
index 0000000..364bdf3
--- /dev/null
+++ b/test/integration/locale_switching_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class LocaleSwitchingTest < ActionDispatch::IntegrationTest
+  test "pages render in English by default" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "h1", text: "Get into Fizzy"
+  end
+
+  test "locale=ja switches the page to Japanese" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "Fizzyに入る"
+  end
+
+  test "locale choice sticks for the rest of the session" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "Fizzyに入る"
+  end
+
+  test "unknown locale does not switch or break the page" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "h1", text: "Get into Fizzy"
+  end
+
+  test "unknown locale does not override an existing Japanese choice" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      get new_session_path, params: { locale: "xx" }
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+test "choosing Japanese stores the locale on the identity" do
+  identity = identities(:kevin)
+
+  untenanted do
+    get new_session_path, params: { locale: "ja" }
+    post session_path, params: { email_address: identity.email_address }
+    post session_magic_link_path, params: { code: identity.magic_links.order(:id).last.code }
+  end
+
+  identity.reload
+  assert_equal "ja", identity.locale
+end
+
+test "signing in restores the identity locale" do
+  identities(:kevin).update_column(:locale, "ja")
+
+  sign_in_as :kevin
+
+  get root_path
+  assert_response :success
+  assert_select "html[lang=ja]"
+end
+
+
+  test "emails are sent in the recipient locale" do
+    identity = identities(:kevin)
+    identity.update_column(:locale, "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_equal "Fizzy のコードは #{magic_link.code} です", email.subject
+  end
+
+  test "emails stay in English when the recipient never chose a locale" do
+    identity = identities(:kevin)
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+  end
+end
