diff --git a/saas/app/controllers/account/checkouts_controller.rb b/saas/app/controllers/account/checkouts_controller.rb
new file mode 100644
index 0000000..d29cc4e
--- /dev/null
+++ b/saas/app/controllers/account/checkouts_controller.rb
@@ -0,0 +1,41 @@
+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    session = Stripe::Checkout::Session.create(checkout_params)
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def checkout_params
+      {
+        mode: "subscription",
+        line_items: [ { price: price_id, quantity: 1 } ],
+        success_url: account_settings_url,
+        cancel_url: account_settings_url,
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id },
+        subscription_data: { metadata: { account_id: Current.account.id } }
+      }.merge(customer_params)
+    end
+
+    def customer_params
+      if Current.account.subscription&.stripe_customer_id.present?
+        { customer: Current.account.subscription.stripe_customer_id }
+      else
+        { customer_email: Current.identity.email_address }
+      end
+    end
+
+    def price_id
+      if unlimited_plus?
+        ENV.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID") { "price_monthly_extra_storage_v1" }
+      else
+        ENV.fetch("STRIPE_MONTHLY_V1_PRICE_ID") { "price_monthly_v1" }
+      end
+    end
+
+    def unlimited_plus?
+      params[:plan].in?(%w[ MonthlyExtraStorageV1 unlimited_plus Unlimited+ ])
+    end
+end
