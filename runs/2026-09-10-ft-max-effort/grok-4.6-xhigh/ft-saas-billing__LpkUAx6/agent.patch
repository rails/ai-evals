diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..de3c582
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription updated marks the account unlimited" do
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.stripe_webhooks_path, params: {
+        type: "customer.subscription.updated",
+        data: {
+          object: {
+            id: "sub_initech",
+            customer: "cus_initech",
+            status: "active",
+            current_period_end: 1.month.from_now.to_i,
+            metadata: { account_id: account.id },
+            items: {
+              data: [
+                { price: { id: "price_monthly_v1" } }
+              ]
+            }
+          }
+        }
+      }, as: :json
+    end
+
+    assert_response :ok
+    subscription = account.reload.subscription
+    assert_equal "MonthlyV1", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal "cus_initech", subscription.stripe_customer_id
+    assert account.paid?
+    assert_equal 5.gigabytes, account.storage_limit
+  end
+
+  test "subscription with extra storage marks the account unlimited plus" do
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.stripe_webhooks_path, params: {
+        type: "customer.subscription.updated",
+        data: {
+          object: {
+            id: "sub_plus",
+            customer: "cus_plus",
+            status: "active",
+            metadata: { account_id: account.id },
+            items: {
+              data: [
+                { price: { id: "price_monthly_v1" } },
+                { price: { id: "price_monthly_extra_storage_v1" } }
+              ]
+            }
+          }
+        }
+      }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal "MonthlyExtraStorageV1", account.reload.subscription.plan_key
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "subscription deleted reverts the account to free" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_initech",
+      stripe_subscription_id: "sub_initech",
+      plan_key: "MonthlyV1",
+      status: "active"
+    )
+
+    untenanted do
+      post saas.stripe_webhooks_path, params: {
+        type: "customer.subscription.deleted",
+        data: {
+          object: {
+            id: "sub_initech",
+            customer: "cus_initech",
+            status: "canceled",
+            metadata: { account_id: account.id },
+            items: { data: [] }
+          }
+        }
+      }, as: :json
+    end
+
+    assert_response :ok
+    assert_not account.reload.paid?
+    assert_equal "Free", account.plan_name
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "checkout session completed creates a subscription record" do
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.stripe_webhooks_path, params: {
+        type: "checkout.session.completed",
+        data: {
+          object: {
+            customer: "cus_checkout",
+            subscription: "sub_checkout",
+            client_reference_id: account.id,
+            metadata: { account_id: account.id }
+          }
+        }
+      }, as: :json
+    end
+
+    assert_response :ok
+    subscription = account.reload.subscription
+    assert_equal "cus_checkout", subscription.stripe_customer_id
+    assert_equal "sub_checkout", subscription.stripe_subscription_id
+  end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..5cfa2c7
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan has a 1000 card limit and 1 GB of storage" do
+    assert_equal "Free", @account.plan_name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert @account.free?
+    assert_not @account.paid?
+  end
+
+  test "unlimited plan has no card limit and 5 GB of storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: "MonthlyV1",
+      status: "active"
+    )
+
+    assert_equal "Unlimited", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert @account.paid?
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "unlimited plus plan has no card limit and 500 GB of storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      plan_key: "MonthlyExtraStorageV1",
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comped accounts get unlimited plus limits" do
+    @account.comp
+
+    assert @account.comped?
+    assert_equal "Unlimited+", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_not @account.free?
+  end
+
+  test "uncomp removes the billing waiver" do
+    @account.comp
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal "Free", @account.plan_name
+  end
+
+  test "exceeding card limit at 1000 cards" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "nearing card limit from 100 cards out" do
+    @account.update_column(:cards_count, 950)
+
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "not nearing card limit when more than 100 remain" do
+    @account.update_column(:cards_count, 899)
+
+    assert_not @account.nearing_card_limit?
+    assert_equal 101, @account.cards_remaining
+  end
+
+  test "overridden card count is used for limit checks" do
+    @account.update_column(:cards_count, 1_000)
+    @account.override_limits(card_count: 10)
+
+    assert_not @account.exceeding_card_limit?
+    assert_equal 10, @account.billed_card_count
+  end
+
+  test "overridden bytes used is used for storage checks" do
+    Account.any_instance.stubs(:bytes_used).returns(2.gigabytes)
+    assert @account.exceeding_storage_limit?
+
+    @account.override_limits(bytes_used: 10)
+
+    assert_not @account.exceeding_storage_limit?
+    assert_equal 10, @account.billed_bytes_used
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 10, bytes_used: 20)
+    @account.reset_overridden_limits
+
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "paid plan storage allowance is used instead of the free default" do
+    Account.any_instance.stubs(:bytes_used).returns(2.gigabytes)
+    assert @account.exceeding_storage_limit?
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_storage",
+      stripe_subscription_id: "sub_storage",
+      plan_key: "MonthlyV1",
+      status: "active"
+    )
+
+    assert_not @account.exceeding_storage_limit?
+  end
+end
