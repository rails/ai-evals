diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..52967cb
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,41 @@
+#!/usr/bin/env ruby
+#
+# Fetches Stripe credentials from 1Password and starts webhook forwarding.
+#
+# Usage: eval "$(BUNDLE_GEMFILE=Gemfile.saas bundle exec stripe-dev)"
+#        bin/dev  # start the dev server in the same terminal session
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+OP_ENV = "Development"
+FORWARD_TO = ENV.fetch("STRIPE_FORWARD_TO", "localhost:3000/stripe/webhooks")
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/#{OP_ENV}/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+secret_key = op_read("STRIPE_SECRET_KEY")
+monthly_price_id = op_read("STRIPE_MONTHLY_V1_PRICE_ID")
+extra_storage_price_id = op_read("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+
+if secret_key.empty?
+  warn "Error: Could not fetch Stripe credentials from 1Password"
+  warn "Make sure you're signed in: op signin --account #{OP_ACCOUNT}"
+  exit 1
+end
+
+webhook_secret = `stripe listen --print-secret 2>/dev/null`.strip
+
+unless webhook_secret.empty?
+  spawn({ "STRIPE_API_KEY" => secret_key }, "stripe", "listen", "--forward-to", FORWARD_TO, out: File::NULL, err: File::NULL)
+end
+
+puts %(export STRIPE_SECRET_KEY="#{secret_key}")
+puts %(export STRIPE_MONTHLY_V1_PRICE_ID="#{monthly_price_id}")
+puts %(export STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID="#{extra_storage_price_id}")
+puts %(export STRIPE_WEBHOOK_SECRET="#{webhook_secret}") unless webhook_secret.empty?
+
+warn ""
+warn "Stripe credentials loaded for development"
+warn "  Forwarding webhooks to #{FORWARD_TO}" unless webhook_secret.empty?
