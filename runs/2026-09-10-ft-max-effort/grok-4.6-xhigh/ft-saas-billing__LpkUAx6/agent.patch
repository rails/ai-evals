diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..114f968
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,147 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  PAID_PLAN_KEYS = %w[ MonthlyV1 MonthlyExtraStorageV1 ].freeze
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  class << self
+    def process_stripe_event(event)
+      type = event_type(event)
+      object = event_object(event)
+
+      case type
+      when "checkout.session.completed"
+        sync_from_checkout_session(object)
+      when "customer.subscription.created", "customer.subscription.updated"
+        sync_from_stripe_subscription(object)
+      when "customer.subscription.deleted"
+        sync_from_stripe_subscription(object)
+      when "invoice.paid", "invoice.upcoming", "invoice.payment_failed"
+        sync_from_invoice(object)
+      end
+    end
+
+    private
+      def event_type(event)
+        event.respond_to?(:type) ? event.type : event["type"]
+      end
+
+      def event_object(event)
+        if event.respond_to?(:data)
+          event.data.object
+        else
+          event.dig("data", "object")
+        end
+      end
+
+      def sync_from_checkout_session(session)
+        account = find_account_from(session)
+        return unless account
+
+        customer_id = value(session, :customer)
+        subscription_id = value(session, :subscription)
+        return unless customer_id
+
+        record = account.subscription || account.build_subscription
+        record.stripe_customer_id = customer_id
+        record.stripe_subscription_id = subscription_id if subscription_id.present?
+        record.status ||= "active"
+        record.plan_key ||= "MonthlyV1"
+        record.save!
+      end
+
+      def sync_from_stripe_subscription(stripe_subscription)
+        account = find_account_from(stripe_subscription)
+        customer_id = value(stripe_subscription, :customer)
+        return unless account && customer_id
+
+        record = account.subscription || find_by(stripe_customer_id: customer_id) || account.build_subscription
+        record.account = account
+        record.stripe_customer_id = customer_id
+        record.stripe_subscription_id = value(stripe_subscription, :id)
+        record.status = value(stripe_subscription, :status)
+        record.plan_key = plan_key_from(stripe_subscription)
+        record.current_period_end = time_at(value(stripe_subscription, :current_period_end) || item_period_end(stripe_subscription))
+        record.cancel_at = time_at(value(stripe_subscription, :cancel_at))
+        record.save!
+      end
+
+      def sync_from_invoice(invoice)
+        customer_id = value(invoice, :customer)
+        subscription_id = value(invoice, :subscription)
+        record = find_by(stripe_customer_id: customer_id) if customer_id
+        record ||= find_by(stripe_subscription_id: subscription_id) if subscription_id
+        return unless record
+
+        amount = value(invoice, :amount_due)
+        record.update!(next_amount_due_in_cents: amount) if amount
+      end
+
+      def find_account_from(object)
+        metadata = value(object, :metadata)
+        account_id = value(metadata, :account_id) || value(object, :client_reference_id)
+
+        if account_id.present?
+          Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+        else
+          customer_id = value(object, :customer)
+          find_by(stripe_customer_id: customer_id)&.account if customer_id
+        end
+      end
+
+      def plan_key_from(stripe_subscription)
+        ids = price_ids_from(stripe_subscription)
+        extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+        monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+
+        if extra.present? && ids.include?(extra)
+          "MonthlyExtraStorageV1"
+        elsif monthly.present? && ids.include?(monthly)
+          "MonthlyV1"
+        elsif ids.any?
+          "MonthlyV1"
+        else
+          "FreeV1"
+        end
+      end
+
+      def price_ids_from(stripe_subscription)
+        items = value(stripe_subscription, :items)
+        data = value(items, :data) || items
+        Array(data).filter_map { |item| value(value(item, :price), :id) }
+      end
+
+      def item_period_end(stripe_subscription)
+        items = value(stripe_subscription, :items)
+        data = value(items, :data) || items
+        first = Array(data).first
+        value(first, :current_period_end)
+      end
+
+      def value(object, key)
+        return if object.nil?
+
+        if object.respond_to?(:[])
+          object[key] || object[key.to_s] || object[key.to_sym]
+        elsif object.respond_to?(key)
+          object.public_send(key)
+        end
+      end
+
+      def time_at(timestamp)
+        Time.at(timestamp) if timestamp.present?
+      end
+  end
+
+  def active?
+    ACTIVE_STATUSES.include?(status)
+  end
+
+  def paid?
+    active? && PAID_PLAN_KEYS.include?(plan_key)
+  end
+
+  def paid_plan?
+    PAID_PLAN_KEYS.include?(plan_key)
+  end
+end
