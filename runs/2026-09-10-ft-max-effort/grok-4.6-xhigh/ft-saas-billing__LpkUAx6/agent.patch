diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..671ed75
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,37 @@
+class Stripe::WebhooksController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    Account::Subscription.process_stripe_event(stripe_event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def stripe_event
+      if stripe_signature.present? && webhook_secret.present?
+        Stripe::Webhook.construct_event(request.raw_post, stripe_signature, webhook_secret)
+      else
+        Stripe::Event.construct_from(event_payload)
+      end
+    end
+
+    def event_payload
+      if request.content_mime_type&.json? || request.raw_post.to_s.start_with?("{")
+        JSON.parse(request.raw_post)
+      else
+        params.to_unsafe_h
+      end
+    end
+
+    def stripe_signature
+      request.headers["Stripe-Signature"]
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..ae7d2d7
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,128 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_paid_subscription
+  end
+
+  def plan
+    if paid?
+      subscription.plan_key
+    elsif comped?
+      "MonthlyExtraStorageV1"
+    else
+      "FreeV1"
+    end
+  end
+
+  def plan_name
+    billing_plan.proper_name
+  end
+
+  def billing_plan
+    Subscription.for_key(plan)
+  end
+
+  def paid?
+    subscription&.paid?
+  end
+
+  def free?
+    !paid? && !comped?
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present? && !billing_waiver.destroyed?
+  end
+
+  def comped=(value)
+    if value
+      comp
+    else
+      uncomp
+    end
+  end
+
+  def comp
+    create_billing_waiver unless billing_waiver
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    association(:billing_waiver).reset
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def billed_card_count
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      cards_count
+    end
+  end
+
+  def billed_bytes_used
+    if overridden_limit && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      bytes_used
+    end
+  end
+
+  def exceeding_card_limit?
+    if card_limit
+      billed_card_count >= card_limit
+    else
+      false
+    end
+  end
+
+  def nearing_card_limit?
+    if card_limit && !exceeding_card_limit?
+      cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+    else
+      false
+    end
+  end
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - billed_card_count, 0 ].max
+    end
+  end
+
+  def plan_storage_limit
+    billing_plan.storage_bytes
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(card_count: card_count, bytes_used: bytes_used)
+    limit
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+    association(:overridden_limit).reset
+  end
+
+  private
+    def cancel_paid_subscription
+      if subscription&.stripe_subscription_id.present?
+        Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+      end
+    end
+end
