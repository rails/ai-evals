--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,22 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "comment timestamps are formatted in the browser" do
+    comments(:logo_agreement_jz).update_column(:created_at, 1.day.ago)
+
+    sign_in_as(users(:kevin))
+    visit card_url(cards(:logo))
+
+    assert_selector "##{dom_id(comments(:logo_agreement_kevin))} time.local-time-value", text: /\d{1,2}:\d{2}\s?(AM|PM)/i
+    assert_selector "##{dom_id(comments(:logo_agreement_jz))} time.local-time-value", text: /yesterday/i
+  end
+
+  test "future auto-close times are formatted in the browser" do
+    sign_in_as(users(:kevin))
+    visit card_url(cards(:logo))
+
+    assert_selector "##{dom_id(cards(:logo), :closure_notice)} time.local-time-value", text: /in \d+ days/
+  end
+end
