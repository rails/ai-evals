+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @board.publish
+  end
+
+  test "show as JSON" do
+    get public_board_card_path(@board.publication, @card), as: :json
+
+    assert_response :success
+    assert_equal @card.number, @response.parsed_body["number"]
+    assert_equal @card.title, @response.parsed_body["title"]
+  end
+
+  test "show as HTML" do
+    get public_board_card_path(@board.publication, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+  end
+
+  test "show is not found for drafted cards" do
+    draft = @board.cards.create!(creator: users(:kevin), status: :drafted)
+
+    get public_board_card_path(@board.publication, draft), as: :json
+
+    assert_response :not_found
+  end
+
+  test "show is not found for cards on another board" do
+    other_board = boards(:private)
+    other_board.publish
+
+    get public_board_card_path(other_board.publication, @card), as: :json
+
+    assert_response :not_found
+  end
+
+  test "show is not found when unpublished" do
+    @board.unpublish
+
+    get public_board_card_path("missing-key", @card), as: :json
+
+    assert_response :not_found
+  end
+end
