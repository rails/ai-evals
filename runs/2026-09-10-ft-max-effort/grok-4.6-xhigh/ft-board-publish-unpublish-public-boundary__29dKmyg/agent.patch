diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..6036d15
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publish and unpublish" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      @board.publish
+    end
+
+    assert_not_nil @board.publication.key
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      @board.unpublish
+    end
+  end
+
+  test "publishing twice keeps the same key" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "published scope" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_includes Board.published, @board
+  end
+end
