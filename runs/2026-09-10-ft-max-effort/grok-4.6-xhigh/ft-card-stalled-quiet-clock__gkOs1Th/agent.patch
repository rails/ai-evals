diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..fda6b7a
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,149 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "three comments from two people within a third of the auto-close period record a burst" do
+    freeze_time
+
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "three comments from one person do not record a burst" do
+    freeze_time
+
+    3.times { @card.comments.create!(body: "Solo", creator: users(:david)) }
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "two comments from two people do not record a burst" do
+    freeze_time
+
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    freeze_time
+
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "System", creator: users(:system))
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the auto-close period do not record a burst" do
+    freeze_time
+    @card.board.update!(auto_postpone_period: 3.days)
+
+    @card.comments.create!(body: "Old", creator: users(:david), created_at: 36.hours.ago)
+    @card.comments.create!(body: "Recent", creator: users(:kevin))
+    @card.comments.create!(body: "Also recent", creator: users(:david))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments within a third of a short auto-close period record a burst" do
+    freeze_time
+    @card.board.update!(auto_postpone_period: 3.days)
+
+    @card.comments.create!(body: "First", creator: users(:david), created_at: 20.hours.ago)
+    @card.comments.create!(body: "Second", creator: users(:kevin), created_at: 10.hours.ago)
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "assigning someone records a burst" do
+    freeze_time
+
+    @card.toggle_assignment(users(:kevin))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "unassigning someone does not record a burst" do
+    freeze_time
+    cards(:layout).toggle_assignment(users(:jz))
+
+    assert_nil cards(:layout).reload.last_burst_at
+  end
+
+  test "reopening a card records a burst" do
+    freeze_time
+    card = cards(:shipping)
+
+    card.reopen
+    assert_equal Time.current, card.reload.last_burst_at
+  end
+
+  test "closing a card does not record a burst" do
+    freeze_time
+
+    @card.close
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "a burst followed by two weeks of inactivity is stalled" do
+    freeze_time
+    @card.update!(last_burst_at: Time.current, last_active_at: Time.current)
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a burst followed by less than two weeks of inactivity is not stalled" do
+    freeze_time
+    @card.update!(last_burst_at: Time.current, last_active_at: Time.current)
+
+    travel 2.weeks - 1.minute
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity on a stalled card resets it" do
+    freeze_time
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.comments.create!(body: "I'm back", creator: users(:david))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed cards are not stalled" do
+    freeze_time
+    card = cards(:shipping)
+    card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "postponed cards are not stalled" do
+    freeze_time
+    @card.postpone
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "indexed_by stalled" do
+    freeze_time
+    @card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    assert_includes Card.indexed_by("stalled"), @card
+    assert_not_includes Card.indexed_by("stalled"), cards(:logo)
+  end
+end
