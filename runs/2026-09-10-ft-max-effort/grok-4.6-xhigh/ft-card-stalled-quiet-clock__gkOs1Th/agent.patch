diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..43358b6
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,31 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_INACTIVITY_PERIOD = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_AUTHOR_COUNT = 2
+
+  included do
+    scope :stalled, -> {
+      active.where.not(last_burst_at: nil).where(last_active_at: ..Card::Stallable::STALL_INACTIVITY_PERIOD.ago)
+    }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALL_INACTIVITY_PERIOD.ago && active?
+  end
+
+  def record_burst
+    update!(last_active_at: Time.current, last_burst_at: Time.current)
+  end
+
+  def bursting_from_comments?(as_of: Time.current)
+    creator_ids = comments.by_user.where(comments: { created_at: burst_window_for(as_of) }).pluck(:creator_id)
+    creator_ids.size >= BURST_COMMENT_COUNT && creator_ids.uniq.size >= BURST_AUTHOR_COUNT
+  end
+
+  private
+    def burst_window_for(as_of)
+      (as_of - auto_postpone_period / 3)..as_of
+    end
+end
