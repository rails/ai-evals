+module SearchesHelper
+  def highlighted_search_text(text, query)
+    query = query.to_s.strip
+    escaped = html_escape(text.to_s)
+
+    if query.present?
+      highlight(escaped, query)
+    else
+      escaped
+    end
+  end
+end
