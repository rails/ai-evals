diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..920d7e7
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds cards by title and wraps matches in mark" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "logo"
+  end
+
+  test "finds cards by description and wraps matches in mark" do
+    cards(:shipping).update!(description: "Pack the hedgehog mascot")
+
+    get search_path(q: "hedgehog")
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result a[href=?]", card_path(cards(:shipping))
+    assert_select "mark", text: "hedgehog"
+  end
+
+  test "finds cards by comment body and wraps matches in mark" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result a[href=?]", card_path(cards(:layout))
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "returns newest cards first" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create!(title: "Zebra older", creator: users(:kevin), status: :published, created_at: 2.days.ago)
+      boards(:writebook).cards.create!(title: "Zebra newer", creator: users(:kevin), status: :published, created_at: 1.day.ago)
+    end
+
+    get search_path(q: "Zebra")
+
+    titles = css_select(".search-result").map(&:text)
+    assert titles.index { |text| text.include?("newer") } < titles.index { |text| text.include?("older") }
+  end
+
+  test "does not return draft cards" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create!(title: "Zebra draft", creator: users(:kevin), status: :drafted)
+    end
+
+    get search_path(q: "Zebra")
+
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return comments on draft cards" do
+    with_current_user :kevin do
+      draft = boards(:writebook).cards.create!(title: "Silent draft", creator: users(:kevin), status: :drafted)
+      comment = draft.comments.new(creator: users(:kevin), account: draft.account)
+      comment.save!(validate: false)
+      ActionText::RichText.create!(record: comment, name: "body", body: "hidden wombat", account: draft.account)
+    end
+
+    get search_path(q: "wombat")
+
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    card = with_current_user :kevin do
+      boards(:private).cards.create!(title: "Secret platypus", creator: users(:kevin), status: :published)
+    end
+
+    get search_path(q: "platypus")
+    assert_select ".search-result a[href=?]", card_path(card)
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "platypus")
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return cards from other accounts" do
+    get search_path(q: "radio")
+    assert_select ".search-result", count: 0
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..ef3d14d
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "finds published cards by title" do
+    results = users(:kevin).accessible_cards.search("logo")
+
+    assert_includes results, cards(:logo)
+    assert_not_includes results, cards(:shipping)
+  end
+
+  test "finds published cards by description" do
+    cards(:shipping).update!(description: "Pack the hedgehog mascot")
+
+    results = users(:kevin).accessible_cards.search("hedgehog")
+
+    assert_equal [ cards(:shipping) ], results
+  end
+
+  test "finds published cards by comment body" do
+    results = users(:kevin).accessible_cards.search("overflowing")
+
+    assert_equal [ cards(:layout) ], results
+  end
+
+  test "returns newest cards first" do
+    older = boards(:writebook).cards.create!(title: "Zebra older", creator: users(:kevin), status: :published, created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Zebra newer", creator: users(:kevin), status: :published, created_at: 1.day.ago)
+
+    assert_equal [ newer, older ], users(:kevin).accessible_cards.search("Zebra")
+  end
+
+  test "excludes draft cards" do
+    boards(:writebook).cards.create!(title: "Zebra draft", creator: users(:kevin), status: :drafted)
+
+    assert_empty users(:kevin).accessible_cards.search("Zebra draft")
+  end
+
+  test "excludes comments on draft cards" do
+    draft = boards(:writebook).cards.create!(title: "Silent draft", creator: users(:kevin), status: :drafted)
+    comment = draft.comments.new(creator: users(:kevin), account: draft.account)
+    comment.save!(validate: false)
+    ActionText::RichText.create!(record: comment, name: "body", body: "hidden wombat", account: draft.account)
+
+    assert_empty users(:kevin).accessible_cards.search("wombat")
+  end
+
+  test "excludes cards on boards the user cannot access" do
+    boards(:private).cards.create!(title: "Secret platypus", creator: users(:kevin), status: :published)
+
+    assert_empty users(:david).accessible_cards.search("platypus")
+    assert_equal 1, users(:kevin).accessible_cards.search("platypus").count
+  end
+
+  test "blank queries match nothing" do
+    assert_empty users(:kevin).accessible_cards.search("  ")
+    assert_empty users(:kevin).accessible_cards.search(nil)
+  end
+
+  test "treats like metacharacters as literals" do
+    boards(:writebook).cards.create!(title: "100% recycled", creator: users(:kevin), status: :published)
+
+    assert_equal 1, users(:kevin).accessible_cards.search("%").count
+    assert_empty users(:kevin).accessible_cards.search("_eco")
+  end
+end
