diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..9850125
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,48 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      query = query.to_s.strip
+
+      if query.present?
+        pattern = "%#{sanitize_sql_like(query)}%"
+        escape = "\\"
+
+        descriptions = ActionText::RichText
+          .where(record_type: "Card", name: "description")
+          .where(ActionText::RichText.arel_table[:body].matches(pattern, escape))
+          .select(:record_id)
+
+        commented = Comment
+          .joins(:rich_text_body)
+          .where(ActionText::RichText.arel_table[:body].matches(pattern, escape))
+          .select(:card_id)
+
+        published
+          .where(arel_table[:title].matches(pattern, escape))
+          .or(published.where(id: descriptions))
+          .or(published.where(id: commented))
+          .reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+
+  def search_snippets(query)
+    needle = query.to_s.strip
+    return [] if needle.blank?
+
+    snippets = []
+    description_text = description.to_plain_text
+    snippets << description_text if description_text.downcase.include?(needle.downcase)
+
+    comments.each do |comment|
+      text = comment.body.to_plain_text
+      snippets << text if text.downcase.include?(needle.downcase)
+    end
+
+    snippets
+  end
+end
