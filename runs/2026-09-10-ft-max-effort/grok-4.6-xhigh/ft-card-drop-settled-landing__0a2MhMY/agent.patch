diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..43eeaed
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,187 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+// Move a card between columns/statuses on drop. The board updates immediately;
+// the save runs in the background so nothing waits or jumps afterwards.
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  #item
+  #origin
+  #hovered
+  #suppressingRefresh
+
+  // Lifecycle
+
+  connect() {
+    document.addEventListener("turbo:before-stream-render", this.#suppressRefresh)
+  }
+
+  disconnect() {
+    document.removeEventListener("turbo:before-stream-render", this.#suppressRefresh)
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  // Actions
+
+  start(event) {
+    if (!this.#supported) {
+      event.preventDefault()
+      return
+    }
+
+    const item = this.#itemFrom(event)
+    if (!item) return
+
+    this.#item = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  over(event) {
+    const container = this.#containerFrom(event)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#clearHighlight()
+    }
+  }
+
+  drop(event) {
+    event.preventDefault()
+
+    const container = this.#containerFrom(event)
+    const item = this.#item
+    if (!container || !item || container.contains(item)) return
+
+    this.#clearHighlight()
+    this.#origin = null
+    this.#move(item, container)
+    this.#persist(item, container)
+  }
+
+  end() {
+    this.#item?.classList.remove(this.draggedItemClass)
+    this.#item = null
+    this.#clearHighlight()
+  }
+
+  // Private
+
+  #itemFrom(event) {
+    return event.target.closest?.("[data-drag-and-drop-target~='item']")
+  }
+
+  #containerFrom(event) {
+    return event.target.closest?.("[data-drag-and-drop-target~='container']")
+  }
+
+  #highlight(container) {
+    if (this.#hovered === container) return
+
+    this.#clearHighlight()
+    container.classList.add(this.hoverContainerClass)
+    this.#hovered = container
+  }
+
+  #clearHighlight() {
+    this.#hovered?.classList.remove(this.hoverContainerClass)
+    this.#hovered = null
+  }
+
+  #move(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return
+
+    this.#origin = { parent: item.parentNode, nextSibling: item.nextSibling }
+    list.prepend(item)
+  }
+
+  async #persist(item, container) {
+    this.#suppressingRefresh = true
+
+    try {
+      const response = await this.#requestFor(item, container)
+      if (response && !response.ok) this.#revert(item)
+    } catch {
+      this.#revert(item)
+    } finally {
+      setTimeout(() => this.#suppressingRefresh = false, 2000)
+    }
+  }
+
+  #requestFor(item, container) {
+    switch (container.dataset.dropAction) {
+      case "triage":
+        return this.#triage(item, container.dataset.columnId)
+      case "maybe":
+        return this.#sendBackToTriage(item)
+      case "postpone":
+        return this.#postpone(item)
+      case "close":
+        return this.#close(item)
+    }
+  }
+
+  #triage(item, columnId) {
+    const url = item.dataset.cardTriageUrl
+    if (!url || !columnId) return
+
+    return post(`${url}?column_id=${encodeURIComponent(columnId)}`, { responseKind: "json" })
+  }
+
+  #sendBackToTriage(item) {
+    const url = item.dataset.cardTriageUrl
+    if (!url) return
+
+    return destroy(url, { responseKind: "json" })
+  }
+
+  #postpone(item) {
+    const url = item.dataset.cardNotNowUrl
+    if (!url) return
+
+    return post(url, { responseKind: "json" })
+  }
+
+  #close(item) {
+    const url = item.dataset.cardClosureUrl
+    if (!url) return
+
+    return post(url, { responseKind: "json" })
+  }
+
+  #revert(item) {
+    if (!this.#origin) return
+
+    const { parent, nextSibling } = this.#origin
+    if (nextSibling) {
+      parent.insertBefore(item, nextSibling)
+    } else {
+      parent.append(item)
+    }
+  }
+
+  #suppressRefresh = (event) => {
+    if (this.#suppressingRefresh && event.target.getAttribute?.("action") === "refresh") {
+      event.preventDefault()
+    }
+  }
+
+  get #supported() {
+    return window.matchMedia("(min-width: 640px)").matches
+  }
+}
