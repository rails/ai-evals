diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..3f22c65
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,101 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+  end
+
+  test "dragging a card to another column moves it immediately and persists" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_on_hold)
+
+    visit board_url(boards(:writebook))
+    expand_column dom_id(column)
+
+    html5_drag_to find("#maybe ##{dom_id(card, :article)}"), find("##{dom_id(column)}")
+
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}"
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    assert_eventually { card.reload.column == column }
+  end
+
+  test "dragging a card to Done closes it immediately" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+    expand_column "closed-cards"
+
+    html5_drag_to find("#maybe ##{dom_id(card, :article)}"), find("#closed-cards")
+
+    assert_selector "#closed-cards ##{dom_id(card, :article)}"
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    assert_eventually { card.reload.closed? }
+  end
+
+  test "dragging a card to Not Now postpones it immediately" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+    expand_column "not-now"
+
+    html5_drag_to find("#maybe ##{dom_id(card, :article)}"), find("#not-now")
+
+    assert_selector "#not-now ##{dom_id(card, :article)}"
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    assert_eventually { card.reload.postponed? }
+  end
+
+  test "dragging a card to Maybe sends it back to triage" do
+    card = cards(:logo)
+    column = card.column
+
+    visit board_url(boards(:writebook))
+    expand_column dom_id(column)
+
+    html5_drag_to find("##{dom_id(column)} ##{dom_id(card, :article)}"), find("#maybe")
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_no_selector "##{dom_id(column)} ##{dom_id(card, :article)}"
+    assert_eventually { card.reload.column.nil? }
+  end
+
+  private
+    def expand_column(id)
+      find("##{id} .cards__expander").click
+      assert_selector "##{id}.is-expanded"
+      assert_selector "##{id} .cards__list"
+    end
+
+    def html5_drag_to(source, target)
+      page.execute_script(<<~JS, source, target)
+        const source = arguments[0]
+        const target = arguments[1]
+        const dataTransfer = new DataTransfer()
+
+        const fire = (element, type) => {
+          element.dispatchEvent(new DragEvent(type, {
+            bubbles: true,
+            cancelable: true,
+            dataTransfer
+          }))
+        }
+
+        fire(source, "dragstart")
+        fire(target, "dragover")
+        fire(target, "drop")
+        fire(source, "dragend")
+      JS
+    end
+
+    def assert_eventually(timeout: Capybara.default_max_wait_time)
+      deadline = Time.now + timeout
+
+      loop do
+        return if yield
+        raise Minitest::Assertion, "condition was not met" if Time.now > deadline
+        sleep 0.1
+      end
+    end
+end
