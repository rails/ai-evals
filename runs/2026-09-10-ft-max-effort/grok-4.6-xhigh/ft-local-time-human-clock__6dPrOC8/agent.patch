diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..5a89ac1 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,21 @@
 module TimeHelper
+  def local_time_tag(time, type: :relative, **options)
+    if time
+      datetime = iso8601_for(time)
+      options[:data] = { local_time_target: type.to_s.camelize(:lower) }.merge(options.delete(:data) || {})
+
+      tag.time **options, datetime: datetime do
+        tag.span datetime, class: "local-time-value"
+      end
+    end
+  end
+
+  private
+    def iso8601_for(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        time.iso8601
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..9625915
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,76 @@
+import { Controller } from "@hotwired/stimulus"
+import { parseDatetime, formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/
+
+export default class extends Controller {
+  static targets = [ "relative", "time", "date", "longDate", "weekday", "datetime" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(this.refresh.bind(this), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  refresh() {
+    this.relativeTargets.forEach(element => this.#localize(element, "relative"))
+    this.timeTargets.forEach(element => this.#localize(element, "time"))
+    this.dateTargets.forEach(element => this.#localize(element, "date"))
+    this.longDateTargets.forEach(element => this.#localize(element, "longDate"))
+    this.weekdayTargets.forEach(element => this.#localize(element, "weekday"))
+    this.datetimeTargets.forEach(element => this.#localize(element, "datetime"))
+  }
+
+  relativeTargetConnected(element) {
+    this.#localize(element, "relative")
+  }
+
+  timeTargetConnected(element) {
+    this.#localize(element, "time")
+  }
+
+  dateTargetConnected(element) {
+    this.#localize(element, "date")
+  }
+
+  longDateTargetConnected(element) {
+    this.#localize(element, "longDate")
+  }
+
+  weekdayTargetConnected(element) {
+    this.#localize(element, "weekday")
+  }
+
+  datetimeTargetConnected(element) {
+    this.#localize(element, "datetime")
+  }
+
+  #localize(element, type) {
+    const datetime = element.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = parseDatetime(datetime)
+    if (isNaN(date.getTime())) return
+
+    this.#valueElement(element).textContent = formatLocalTime(date, type)
+    element.title = formatLocalTime(date, DATE_ONLY.test(datetime) ? "weekday" : "datetime")
+  }
+
+  #valueElement(element) {
+    const existing = element.querySelector(".local-time-value")
+
+    if (existing) {
+      return existing
+    } else {
+      const value = document.createElement("span")
+      value.className = "local-time-value"
+      element.replaceChildren(value)
+      return value
+    }
+  }
+}
