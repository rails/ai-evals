diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..9853aa4
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "emits a time tag with a UTC timestamp so HTML can be cached across timezones" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+
+    html_new_york = Time.use_zone("America/New_York") { local_time_tag(time) }
+    html_tokyo = Time.use_zone("Asia/Tokyo") { local_time_tag(time) }
+
+    assert_equal html_new_york, html_tokyo
+    assert_includes html_new_york, 'datetime="2024-09-12T17:42:00Z"'
+    assert_includes html_new_york, 'data-local-time-target="relative"'
+    assert_includes html_new_york, 'class="local-time-value"'
+    assert_includes html_new_york, "2024-09-12T17:42:00Z"
+    assert_no_match(/1:42|Sep|September|yesterday/i, html_new_york.gsub("2024-09-12T17:42:00Z", ""))
+  end
+
+  test "uses the given type as a stimulus target" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+
+    assert_includes local_time_tag(time, type: :time), 'data-local-time-target="time"'
+    assert_includes local_time_tag(time, type: :date), 'data-local-time-target="date"'
+    assert_includes local_time_tag(time, type: :long_date), 'data-local-time-target="longDate"'
+    assert_includes local_time_tag(time, type: :weekday), 'data-local-time-target="weekday"'
+    assert_includes local_time_tag(time, type: :datetime), 'data-local-time-target="datetime"'
+  end
+
+  test "sends calendar dates without a time of day" do
+    html = local_time_tag(Date.new(2024, 9, 12), type: :weekday)
+
+    assert_includes html, 'datetime="2024-09-12"'
+    assert_not_includes html, "T"
+  end
+
+  test "returns nil when time is missing" do
+    assert_nil local_time_tag(nil)
+  end
+
+  test "merges additional html attributes" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+    html = local_time_tag(time, class: "comment__time", data: { turbo_frame: "_top" })
+
+    assert_includes html, 'class="comment__time"'
+    assert_includes html, 'data-turbo-frame="_top"'
+    assert_includes html, 'data-local-time-target="relative"'
+  end
+
+  test "comment partial HTML is identical for every timezone" do
+    comment = comments(:logo_agreement_kevin)
+
+    html_new_york = Time.use_zone("America/New_York") { render "cards/comments/comment", comment: comment }
+    html_tokyo = Time.use_zone("Asia/Tokyo") { render "cards/comments/comment", comment: comment }
+
+    assert_equal html_new_york, html_tokyo
+    assert_includes html_new_york, %(datetime="#{comment.created_at.utc.iso8601}")
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..07db171
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,34 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:kevin)
+  end
+
+  test "comments render in the viewer's timezone" do
+    card = cards(:logo)
+    today = card.comments.create!(creator: users(:kevin), body: "Posted today", created_at: Time.current.beginning_of_day + 13.hours + 42.minutes)
+    yesterday = card.comments.create!(creator: users(:kevin), body: "Posted last night", created_at: Time.current.beginning_of_day - 3.hours)
+    earlier = card.comments.create!(creator: users(:kevin), body: "Posted this week", created_at: Time.current.beginning_of_day - 5.days)
+    older = card.comments.create!(creator: users(:kevin), body: "Posted last month", created_at: Time.current.beginning_of_day - 20.days)
+
+    visit card_url(card)
+
+    assert_selector "##{dom_id(today)} .local-time-value", text: "1:42 PM"
+    assert_selector "##{dom_id(yesterday)} .local-time-value", text: /yesterday/i
+    assert_selector "##{dom_id(earlier)} .local-time-value", text: /5 days ago/i
+    assert_selector "##{dom_id(older)} .local-time-value", text: older.created_at.strftime("%b %-d")
+  end
+
+  test "a card auto-closing overnight reads tomorrow and further out in N days" do
+    card = cards(:logo)
+
+    card.update!(last_active_at: Time.current.beginning_of_day - 89.days)
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :closure_notice)} .local-time-value", text: /tomorrow/i
+
+    card.update!(last_active_at: Time.current.beginning_of_day - 87.days)
+    visit card_url(card)
+    assert_selector "##{dom_id(card, :closure_notice)} .local-time-value", text: "in 3 days"
+  end
+end
