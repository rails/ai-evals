diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..95a4eb7
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,35 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  after_create_commit :broadcast_create
+  after_destroy_commit :broadcast_destroy
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  normalizes :content, with: -> { it.strip }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  delegate :card, to: :comment
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+
+  def emoji_only?
+    content.match?(/\A(?:\p{Extended_Pictographic}|\p{Emoji_Presentation}|[\u{FE0F}\u{200D}\u{20E3}])+\z/)
+  end
+
+  private
+    def broadcast_create
+      broadcast_append_to card, target: [ comment, :reactions ]
+    end
+
+    def broadcast_destroy
+      broadcast_remove_to card
+    end
+end
