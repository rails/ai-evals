diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..a41ce78
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions)
+    assert_turbo_stream action: :update, target: dom_id(@comment, :new_reaction)
+    assert_equal "🎉", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Ship it" } }, as: :json
+    end
+
+    reaction = @comment.reactions.last
+    assert_response :created
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Ship it", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "👍" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @comment.reactions.last.content
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal reactions(:logo_agreement_jz_thumbs_up).content, @response.parsed_body.first["content"]
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+
+    get card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), @response.parsed_body["url"]
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction" do
+    reaction = @comment.reactions.create!(content: "👏", reacter: users(:jz))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "new" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select ".reaction__form"
+    assert_select "input.reaction__input"
+  end
+
+  test "card show includes reactions strip" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select ".reactions"
+    assert_select ".reactions__trigger"
+    assert_select ".reaction", text: /👍/
+  end
+end
