+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "🎉")
+
+    assert_equal "🎉", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal comment, reaction.comment
+    assert_equal comment.account, reaction.account
+  end
+
+  test "content is stripped and limited to 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "  Nice  ")
+    assert_equal "Nice", reaction.content
+
+    reaction = comment.reactions.build(content: "a" * 17)
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "content cannot be blank" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "   ")
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "emoji_only?" do
+    comment = comments(:logo_agreement_jz)
+
+    assert comment.reactions.build(content: "👍").emoji_only?
+    assert comment.reactions.build(content: "🎉🎉").emoji_only?
+    assert_not comment.reactions.build(content: "Great 👍").emoji_only?
+    assert_not comment.reactions.build(content: "Nice").emoji_only?
+  end
+
+  test "creating a reaction broadcasts it to the card" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_turbo_stream_broadcasts comment.card, count: 1 do
+      comment.reactions.create!(content: "🙌")
+    end
+  end
+
+  test "destroying a reaction broadcasts the removal to the card" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+
+    assert_turbo_stream_broadcasts reaction.card, count: 1 do
+      reaction.destroy
+    end
+  end
+end
