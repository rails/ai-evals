diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..4602987
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,36 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+let translationsCache
+
+export function i18n(key, params = {}) {
+  const translations = loadTranslations()
+  let value = key.split(".").reduce((obj, part) => obj?.[part], translations)
+
+  if (value && typeof value === "object") {
+    const count = params.count
+    value = count === 1 ? value.one : value.other
+  }
+
+  if (typeof value !== "string") return key
+
+  return Object.entries(params).reduce((str, [name, replacement]) => {
+    return str.replaceAll(`%{${name}}`, replacement)
+  }, value)
+}
+
+export function dateLocale() {
+  const lang = document.documentElement.lang || "en"
+  return lang === "ja" ? "ja" : "en-US"
+}
+
+function loadTranslations() {
+  if (translationsCache) return translationsCache
+
+  try {
+    translationsCache = JSON.parse(getMetaContent("i18n-translations") || "{}")
+  } catch {
+    translationsCache = {}
+  }
+
+  return translationsCache
+}
