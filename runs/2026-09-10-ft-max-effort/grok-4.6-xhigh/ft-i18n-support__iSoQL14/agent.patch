diff --git a/app/models/locale.rb b/app/models/locale.rb
new file mode 100644
index 0000000..1e7dd31
--- /dev/null
+++ b/app/models/locale.rb
@@ -0,0 +1,20 @@
+module Locale
+  class << self
+    def available
+      I18n.available_locales.map(&:to_s)
+    end
+
+    def available?(value)
+      cast(value).present?
+    end
+
+    def cast(value)
+      value = value.to_s if value.is_a?(Symbol)
+      value if value.is_a?(String) && value.present? && available.include?(value)
+    end
+
+    def for(identity)
+      cast(identity&.locale) || I18n.default_locale.to_s
+    end
+  end
+end
