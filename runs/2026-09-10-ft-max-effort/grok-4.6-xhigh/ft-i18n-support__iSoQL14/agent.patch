diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..10f91f7
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "unrecognized locale query param does not change locale or break the page" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+
+  test "locale=ja switches the page to Japanese and sticks for the rest of the session" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyに入る"
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyに入る"
+    end
+  end
+
+  test "people who never chose a locale still see English" do
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+
+  test "locale choice persists on the identity across a clean sign-in" do
+    identity = identities(:kevin)
+    identity.update_column(:locale, "ja")
+
+    sign_in_as :kevin
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "choosing Japanese while signed in persists to the identity" do
+    sign_in_as :kevin
+
+    get root_path, params: { locale: "ja" }
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_select "html[lang=ja]"
+  end
+
+  test "magic link email uses the identity locale" do
+    identity = identities(:kevin)
+    identity.update_column(:locale, "ja")
+
+    email = MagicLinkMailer.sign_in_instructions(identity.send_magic_link)
+    assert_match(/Fizzyのコードは/, email.subject)
+  end
+
+  test "static error pages include both English and Japanese" do
+    html = File.read(Rails.public_path.join("404.html"))
+    assert_match(/doesn’t exist/, html)
+    assert_match(/存在しません/, html)
+  end
+end
