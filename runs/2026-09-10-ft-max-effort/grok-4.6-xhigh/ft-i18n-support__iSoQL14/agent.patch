diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..5d4e93b
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,56 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_locale, prepend: true
+    before_action :persist_or_restore_identity_locale
+
+    helper_method :current_locale
+
+    fragment_cache_key { I18n.locale }
+    etag { I18n.locale }
+  end
+
+  private
+    def set_locale(&action)
+      if locale = requested_locale
+        session[:locale] = locale
+      end
+
+      Current.chosen_locale = session_locale
+      I18n.with_locale(session_locale || I18n.default_locale, &action)
+    end
+
+    def persist_or_restore_identity_locale
+      if Current.identity
+        if locale = session_locale
+          persist_locale_to_identity(locale)
+        elsif locale = identity_locale
+          session[:locale] = locale
+          I18n.locale = locale
+        end
+      end
+    end
+
+    def requested_locale
+      Locale.cast(params[:locale])
+    end
+
+    def session_locale
+      Locale.cast(session[:locale])
+    end
+
+    def identity_locale
+      Locale.cast(Current.identity&.locale)
+    end
+
+    def persist_locale_to_identity(locale)
+      if Current.identity.locale != locale
+        Current.identity.update_column(:locale, locale)
+      end
+    end
+
+    def current_locale
+      I18n.locale
+    end
+end
