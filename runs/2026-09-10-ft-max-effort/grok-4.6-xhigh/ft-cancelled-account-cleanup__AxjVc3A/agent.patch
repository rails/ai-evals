diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..cb9404e
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently removes accounts cancelled more than 30 days ago" do
+    account = accounts(:initech)
+    card = cards(:radio)
+    user = users(:mike)
+
+    travel_to 31.days.ago do
+      account.cancel(initiated_by: user)
+    end
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+    assert_not Card.exists?(card.id)
+    assert_not User.exists?(user.id)
+    assert Identity.exists?(identities(:mike).id)
+  end
+
+  test "does not remove accounts cancelled within the last 30 days" do
+    account = accounts(:initech)
+
+    travel_to 29.days.ago do
+      account.cancel(initiated_by: users(:mike))
+    end
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+  end
+
+  test "does not remove active accounts" do
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(accounts(:initech).id)
+    assert Account.exists?(accounts(:"37s").id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..3f807c3
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @user = users(:mike)
+  end
+
+  test "incineration_due includes accounts cancelled more than the grace period ago" do
+    travel_to Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day do
+      @account.cancel(initiated_by: @user)
+    end
+
+    assert_includes Account.incineration_due, @account
+    assert @account.incineration_due?
+  end
+
+  test "incineration_due excludes accounts cancelled within the grace period" do
+    travel_to Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.day do
+      @account.cancel(initiated_by: @user)
+    end
+
+    assert_not_includes Account.incineration_due, @account
+    assert_not @account.incineration_due?
+  end
+
+  test "incineration_due excludes active accounts" do
+    assert_not_includes Account.incineration_due, @account
+    assert_not @account.incineration_due?
+  end
+
+  test "incinerate destroys a due account and its data" do
+    card = cards(:radio)
+    board = boards(:miltons_wish_list)
+
+    travel_to Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day do
+      @account.cancel(initiated_by: @user)
+    end
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Card.exists?(card.id)
+    assert_not Board.exists?(board.id)
+    assert_not User.exists?(@user.id)
+    assert Identity.exists?(identities(:mike).id)
+  end
+
+  test "incinerate does not destroy an account still within the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert @account.reload.cancelled?
+  end
+
+  test "incinerate_due incinerates only accounts past the grace period" do
+    recent = accounts(:acme)
+    recent_user = users(:jason)
+    recent.cancel(initiated_by: recent_user)
+
+    travel_to Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day do
+      @account.cancel(initiated_by: @user)
+    end
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(recent.id)
+    assert Account.exists?(accounts(:"37s").id)
+  end
+end
