+# Secrets referenced by config/deploy.yml (registry/password and env/secret).
+#
+# Pull values from the environment, a file, or a password manager.
+# Do not commit raw secret values. This file should stay safe for git.
+#
+#   export KAMAL_REGISTRY_PASSWORD=...
+#   export SECRET_KEY_BASE=$(bin/rails secret)   # generate once and reuse
+#   export SMTP_PASSWORD=...
+
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional: browser push notifications
+# VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+# VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
