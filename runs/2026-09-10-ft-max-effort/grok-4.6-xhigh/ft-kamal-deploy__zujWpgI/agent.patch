diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..2e6961e
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,81 @@
+# Deploy Fizzy to one Linux box: Docker, SQLite, SSL from kamal-proxy.
+# Web, background jobs, and SQLite all run in a single container. Uploads and
+# the database live in a Docker volume so they survive the next deploy.
+#
+# Fill in the values below (hostname, server, registry, mail) and the secrets
+# in .kamal/secrets, then run: bin/kamal setup
+#
+# Fizzy will be at https://<host>.
+
+<%
+  # Public hostname (DNS A record pointing at the server)
+  host = "fizzy.example.com"
+
+  # Linux server with Docker (IP address or SSH hostname)
+  server = "192.168.0.1"
+
+  # Docker image name, e.g. your-dockerhub-user/fizzy or your-github-user/fizzy
+  image = "your-user/fizzy"
+
+  # Registry username (Docker Hub username, or GitHub username for GHCR)
+  registry_username = "your-user"
+
+  # Mail, used for magic-link login and notifications
+  mailer_from   = "Fizzy <fizzy@example.com>"
+  smtp_address  = "smtp.example.com"
+  smtp_port     = 587
+  smtp_username = "you@example.com"
+%>
+
+service: fizzy
+image: <%= image %>
+
+servers:
+  web:
+    - <%= server %>
+
+proxy:
+  ssl: true
+  host: <%= host %>
+
+registry:
+  # Uncomment to push to GitHub Container Registry instead of Docker Hub:
+  # server: ghcr.io
+  username: <%= registry_username %>
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Uncomment for browser push notifications (see docs/deploy.md):
+    # - VAPID_PRIVATE_KEY
+    # - VAPID_PUBLIC_KEY
+  clear:
+    APP_HOST: <%= host %>
+    MAILER_FROM_ADDRESS: "<%= mailer_from %>"
+    SMTP_ADDRESS: <%= smtp_address %>
+    SMTP_PORT: <%= smtp_port %>
+    SMTP_USERNAME: <%= smtp_username %>
+    # SQLite-friendly process counts for a single box
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+
+# SQLite databases and Active Storage files. Back this volume up off-server.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+builder:
+  arch: amd64
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# ssh:
+#   user: ubuntu
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..c26cde0 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,31 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Self-hosted Kamal deploys set APP_HOST and SMTP_* (see config/deploy.yml).
+  # SaaS overrides these in fizzy-saas.
+  if ENV["APP_HOST"].present?
+    url_options = { host: ENV["APP_HOST"], protocol: "https" }
+    config.action_controller.default_url_options = url_options
+    config.action_mailer.default_url_options     = url_options
+  end
+
+  if ENV["SMTP_ADDRESS"].present?
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.raise_delivery_errors = true
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: ENV["SMTP_DOMAIN"].presence || ENV["APP_HOST"],
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }
+
+    if ENV["SMTP_USERNAME"].present?
+      config.action_mailer.smtp_settings[:user_name] = ENV["SMTP_USERNAME"]
+      config.action_mailer.smtp_settings[:password] = ENV["SMTP_PASSWORD"]
+      config.action_mailer.smtp_settings[:authentication] = ENV.fetch("SMTP_AUTHENTICATION", "plain")
+    end
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/deploy.md b/docs/deploy.md
new file mode 100644
index 0000000..53c01bd
--- /dev/null
+++ b/docs/deploy.md
@@ -0,0 +1,53 @@
+## Deploying
+
+Fizzy deploys to a single Linux server with [Kamal](https://kamal-deploy.org/). The box needs Docker (Kamal can install it). SQLite, file storage, and background jobs all run in one container. SSL is terminated by kamal-proxy via Let's Encrypt.
+
+After setup, Fizzy is at `https://your-host`. Data lives in a Docker volume and survives deploys.
+
+### What you need
+
+- A Linux server with SSH access and ports 80 and 443 open
+- A hostname with a DNS A record pointing at that server
+- An SMTP server, for magic-link login emails
+- A Docker registry account (Docker Hub or GitHub Container Registry)
+
+### Configure
+
+1. In `config/deploy.yml`, fill in the values at the top: hostname, server, image/registry, and mail.
+2. Export secrets (or put them in `.kamal/secrets`; don't commit raw values):
+
+```sh
+export KAMAL_REGISTRY_PASSWORD=...   # registry access token
+export SECRET_KEY_BASE=$(bin/rails secret)  # generate once and reuse
+export SMTP_PASSWORD=...
+```
+
+3. Point DNS at the server before running setup, so Let's Encrypt can issue a certificate.
+
+### Setup
+
+From a machine that can SSH to the server and build Docker images:
+
+```sh
+bin/kamal setup
+```
+
+Visit `https://your-host` and sign up. Later deploys:
+
+```sh
+bin/kamal deploy
+```
+
+SQLite and uploads live in the `fizzy_storage` volume. Back it up off-server.
+
+Useful aliases: `bin/kamal console`, `bin/kamal logs`, `bin/kamal shell`.
+
+### Optional: web push
+
+Generate VAPID keys and add `VAPID_PRIVATE_KEY` / `VAPID_PUBLIC_KEY` to `.kamal/secrets`. Uncomment those entries under `env.secret` in `config/deploy.yml`.
+
+```ruby
+vapid_key = WebPush.generate_key
+puts "VAPID_PRIVATE_KEY=#{vapid_key.private_key}"
+puts "VAPID_PUBLIC_KEY=#{vapid_key.public_key}"
+```
