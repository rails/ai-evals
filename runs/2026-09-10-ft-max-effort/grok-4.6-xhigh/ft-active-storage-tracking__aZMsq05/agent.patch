@@ -0,0 +1,39 @@
+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_previous_board_id, if: :will_save_change_to_board_id?
+    after_save :remember_storage_change
+    after_save_commit :recalculate_board_bytes_used_later, if: :storage_changed?
+    after_destroy_commit :recalculate_board_bytes_used_later
+    after_touch :recalculate_board_bytes_used_later
+    after_update_commit :recalculate_bytes_used_for_moved_boards, if: :moved_between_boards?
+  end
+
+  private
+    def remember_previous_board_id
+      @previous_board_id = board_id_in_database
+    end
+
+    def remember_storage_change
+      @storage_changed = attachment_changes["image"].present? || rich_text_description&.body_previously_changed?
+    end
+
+    def storage_changed?
+      @storage_changed
+    end
+
+    def moved_between_boards?
+      @previous_board_id.present?
+    end
+
+    def recalculate_board_bytes_used_later
+      if board
+        board.recalculate_bytes_used_later
+      end
+    end
+
+    def recalculate_bytes_used_for_moved_boards
+      Board.where(id: [ board_id, @previous_board_id ]).each(&:recalculate_bytes_used_later)
+    end
+end
