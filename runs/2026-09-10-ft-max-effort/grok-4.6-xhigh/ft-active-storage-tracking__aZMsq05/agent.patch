+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "bytes_used is isolated per account" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+
+    assert_operator accounts("37s").reload.bytes_used, :>, 0
+    assert_equal 0, accounts(:initech).reload.bytes_used
+  end
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..9f27d51
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @account = accounts("37s")
+  end
+
+  test "bytes_used starts at zero" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counts card images after background calculation" do
+    blob = attach_image_to cards(:logo)
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+
+    perform_storage_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    blob = embed_file_in cards(:logo), :description
+
+    perform_storage_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "counts files embedded in comments" do
+    blob = embed_file_in cards(:logo).comments.create!(body: "See attached"), :body
+
+    perform_storage_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "counts files embedded in board descriptions" do
+    blob = embed_file_in @board, :public_description
+
+    perform_storage_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "sums every counted file on the board" do
+    image = attach_image_to cards(:logo)
+    description = embed_file_in cards(:layout), :description
+    comment = embed_file_in cards(:logo).comments.create!(body: "file"), :body
+    board_description = embed_file_in @board, :public_description
+
+    perform_storage_jobs
+
+    expected = [ image, description, comment, board_description ].sum(&:byte_size)
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+  end
+
+  test "does not count avatars" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "does not count export files" do
+    export = Account::Export.create!(account: @account, user: users(:david))
+    export.file.attach(io: file_fixture("moon.jpg").open, filename: "export.zip", content_type: "application/zip")
+
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "does not count image variants" do
+    blob = embed_file_in cards(:logo).comments.create!(body: "image"), :body
+
+    perform_storage_jobs
+
+    assert blob.attachments.sole.variant(:small).processed?
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "drops usage when a counted file is removed" do
+    attach_image_to cards(:logo)
+    perform_storage_jobs
+    assert_operator @board.reload.bytes_used, :>, 0
+
+    cards(:logo).image.purge
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moves usage with a card to another board" do
+    blob = attach_image_to cards(:logo)
+    perform_storage_jobs
+
+    destination = boards(:private)
+    cards(:logo).update!(board: destination)
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, destination.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "account usage includes every board" do
+    writebook_blob = attach_image_to cards(:logo)
+    private_card = boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: :published)
+    private_blob = attach_image_to private_card
+
+    perform_storage_jobs
+
+    assert_equal writebook_blob.byte_size, boards(:writebook).reload.bytes_used
+    assert_equal private_blob.byte_size, boards(:private).reload.bytes_used
+    assert_equal writebook_blob.byte_size + private_blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "account usage drops when a board is destroyed" do
+    attach_image_to cards(:logo)
+    perform_storage_jobs
+    assert_operator @account.reload.bytes_used, :>, 0
+
+    @board.destroy
+    perform_storage_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  private
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.image.blob
+    end
+
+    def embed_file_in(record, attribute)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      html = ActionText::Attachment.from_attachable(blob).to_html
+      record.update!(attribute => html)
+      blob
+    end
+
+    def perform_storage_jobs
+      perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+    end
+end
