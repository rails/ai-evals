diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..bc578a4
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,79 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_save :remember_storage_change
+    after_save_commit :recalculate_bytes_used_later, if: :storage_changed?
+    after_destroy_commit :recalculate_account_bytes_used_later
+  end
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    previous = bytes_used_in_database
+    current = calculate_bytes_used
+
+    if previous != current
+      update_column :bytes_used, current
+      Account.update_counters(account_id, bytes_used: current - previous)
+    end
+  end
+
+  private
+    def remember_storage_change
+      @storage_changed = rich_text_public_description&.body_previously_changed?
+    end
+
+    def storage_changed?
+      @storage_changed
+    end
+
+    def recalculate_account_bytes_used_later
+      if account
+        account.recalculate_bytes_used_later
+      end
+    end
+
+    def calculate_bytes_used
+      ActiveStorage::Blob.where(id: counted_blob_ids).sum(:byte_size)
+    end
+
+    def counted_blob_ids
+      [
+        card_image_attachments,
+        board_description_attachments,
+        card_description_attachments,
+        comment_attachments
+      ].map { |attachments| attachments.select(:blob_id) }.reduce { |combined, blob_ids| combined.or(blob_ids) }
+    end
+
+    def card_image_attachments
+      ActiveStorage::Attachment.where(record: cards, name: "image")
+    end
+
+    def board_description_attachments
+      if rich_text = rich_text_public_description
+        ActiveStorage::Attachment.where(record: rich_text, name: "embeds")
+      else
+        ActiveStorage::Attachment.none
+      end
+    end
+
+    def card_description_attachments
+      ActiveStorage::Attachment.where(record: card_descriptions, name: "embeds")
+    end
+
+    def comment_attachments
+      ActiveStorage::Attachment.where(record: comment_bodies, name: "embeds")
+    end
+
+    def card_descriptions
+      ActionText::RichText.where(record: cards, name: "description")
+    end
+
+    def comment_bodies
+      ActionText::RichText.where(record: Comment.where(card: cards), name: "body")
+    end
+end
