diff --git a/test/controllers/cards/local_times_test.rb b/test/controllers/cards/local_times_test.rb
new file mode 100644
index 0000000..6cedab9
--- /dev/null
+++ b/test/controllers/cards/local_times_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Cards::LocalTimesTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "comments render a raw UTC timestamp for the browser" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(cards(:logo))
+
+    assert_select "##{dom_id(comment)} time.local-time-value[data-controller=local-time]" do |elements|
+      assert_equal comment.created_at.in_time_zone("UTC").iso8601, elements.first["datetime"]
+      assert_equal comment.created_at.in_time_zone("UTC").iso8601, elements.first.text
+    end
+  end
+
+  test "card timestamps are the same regardless of timezone cookie" do
+    comment = comments(:logo_agreement_kevin)
+
+    cookies[:timezone] = "America/New_York"
+    get card_path(cards(:logo))
+    datetime_in_new_york = css_select("##{dom_id(comment)} time").first["datetime"]
+
+    cookies[:timezone] = "Asia/Tokyo"
+    get card_path(cards(:logo))
+    datetime_in_tokyo = css_select("##{dom_id(comment)} time").first["datetime"]
+
+    assert_equal datetime_in_new_york, datetime_in_tokyo
+    assert_match(/Z$/, datetime_in_new_york)
+  end
+
+  test "card meta renders local-time tags instead of server-formatted relative times" do
+    get card_path(cards(:logo))
+
+    assert_select ".card__meta-text--added time.local-time-value[data-controller=local-time]"
+    assert_select ".card__meta-text--updated time.local-time-value[data-controller=local-time]"
+    assert_select ".card__meta-text--added", text: /ago/, count: 0
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..551f36e
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a time tag with the raw UTC timestamp" do
+    time = Time.utc(2025, 9, 12, 18, 42, 0)
+
+    assert_select parse(local_time_tag(time)), "time.local-time-value" do |elements|
+      element = elements.first
+      assert_equal "2025-09-12T18:42:00Z", element["datetime"]
+      assert_equal "2025-09-12T18:42:00Z", element.text
+      assert_equal "local-time", element["data-controller"]
+      assert_equal "relative", element["data-local-time-format-value"]
+      assert_equal "turbo:morph-element->local-time#render:self", element["data-action"]
+    end
+  end
+
+  test "does not format the timestamp in the current timezone" do
+    time = Time.utc(2025, 9, 12, 18, 42, 0)
+
+    Time.use_zone("America/Los_Angeles") do
+      html = local_time_tag(time)
+
+      assert_includes html, "2025-09-12T18:42:00Z"
+      assert_not_includes html, "11:42"
+      assert_not_includes html, "Sep"
+    end
+  end
+
+  test "time format" do
+    html = local_time_tag(Time.utc(2025, 9, 12, 18, 42, 0), format: :time)
+
+    assert_select parse(html), "time[data-local-time-format-value=time]"
+  end
+
+  test "date format" do
+    html = local_time_tag(Time.utc(2025, 9, 12, 18, 42, 0), format: :date)
+
+    assert_select parse(html), "time[data-local-time-format-value=date]"
+  end
+
+  test "datetime format" do
+    html = local_time_tag(Time.utc(2025, 9, 12, 18, 42, 0), format: :datetime)
+
+    assert_select parse(html), "time[data-local-time-format-value=datetime]"
+  end
+
+  test "weekday format uses a date-only timestamp so the calendar day is not shifted by timezone" do
+    time = Time.utc(2025, 9, 13, 4, 0, 0)
+
+    Time.use_zone("America/Los_Angeles") do
+      html = local_time_tag(time, format: :weekday)
+
+      assert_select parse(html), "time[datetime='2025-09-12'][data-local-time-format-value=weekday]", text: "2025-09-12"
+    end
+  end
+
+  test "merges extra classes" do
+    html = local_time_tag(Time.utc(2025, 9, 12, 18, 42, 0), class: "txt-ink")
+
+    assert_select parse(html), "time.local-time-value.txt-ink"
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
