diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..e4318dc 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,24 @@
 module TimeHelper
+  def local_time_tag(time, format: :relative, **options)
+    iso8601 = iso8601_for(time, format)
+
+    tag.time iso8601,
+      datetime: iso8601,
+      class: class_names("local-time-value", options.delete(:class)),
+      data: {
+        controller: "local-time",
+        action: "turbo:morph-element->local-time#render:self",
+        local_time_format_value: format
+      }.merge(options.delete(:data) || {}),
+      **options
+  end
+
+  private
+    def iso8601_for(time, format)
+      if format.to_sym == :weekday
+        time.in_time_zone.to_date.iso8601
+      else
+        time.in_time_zone("UTC").iso8601
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..2f604d4
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseTimestamp } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+    this.render()
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  render() {
+    const date = parseTimestamp(this.element.dateTime)
+
+    if (!Number.isNaN(date.getTime())) {
+      this.element.textContent = formatLocalTime(date, this.formatValue)
+    }
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..4c5c929 100644
