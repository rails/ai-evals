+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+  end
+
+  test "a comment from two hours ago reads as the time of day" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update!(created_at: 2.hours.ago)
+
+    visit card_url(cards(:logo))
+
+    assert_selector "##{dom_id(comment)} time", text: expected_time_of_day(comment.created_at)
+  end
+
+  test "a comment from last night reads yesterday" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update!(created_at: Time.current.yesterday.change(hour: 22, min: 15))
+
+    visit card_url(cards(:logo))
+
+    assert_selector "##{dom_id(comment)} time", text: /yesterday/i
+  end
+
+  test "a comment from earlier in the week reads as days ago" do
+    comment = comments(:logo_agreement_jz)
+    comment.update!(created_at: 5.days.ago.change(hour: 15))
+
+    visit card_url(cards(:logo))
+
+    assert_selector "##{dom_id(comment)} time", text: /5 days ago/i
+  end
+
+  test "a comment from last year reads as a date" do
+    comment = comments(:logo_agreement_jz)
+    comment.update!(created_at: Time.utc(2025, 9, 12, 15, 0, 0))
+
+    visit card_url(cards(:logo))
+
+    assert_selector "##{dom_id(comment)} time", text: "Sep 12, 2025"
+  end
+
+  test "a card auto-closing overnight reads tomorrow" do
+    card = cards(:logo)
+    card.update!(last_active_at: Time.current.tomorrow.change(hour: 10) - card.auto_postpone_period)
+
+    visit card_url(card)
+
+    assert_selector "##{dom_id(card, :closure_notice)} time", text: /tomorrow/i
+  end
+
+  test "a card auto-closing further out reads in N days" do
+    card = cards(:logo)
+    card.update!(last_active_at: 3.days.from_now.change(hour: 10) - card.auto_postpone_period)
+
+    visit card_url(card)
+
+    assert_selector "##{dom_id(card, :closure_notice)} time", text: "in 3 days"
+  end
+
+  private
+    def expected_time_of_day(time)
+      time.in_time_zone(browser_time_zone).strftime("%-l:%M %p").strip
+    end
+
+    def browser_time_zone
+      "UTC"
+    end
+end
