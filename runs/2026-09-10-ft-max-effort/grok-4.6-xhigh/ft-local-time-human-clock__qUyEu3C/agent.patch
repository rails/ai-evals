+++ b/app/javascript/helpers/date_helpers.js
@@ -1,7 +1,40 @@
 import { getMetaContent } from "helpers/meta_helpers"
 
+const MS_PER_DAY = 1000 * 60 * 60 * 24
+
+const timeOfDayFormatter = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", hour12: true })
+const shortDateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const shortDateWithYearFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const dateTimeFormatter = new Intl.DateTimeFormat("en-US", { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit", hour12: true })
+const weekdayFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+
+export function formatLocalTime(date, format = "relative") {
+  switch (format) {
+    case "time":
+      return formatTimeOfDay(date)
+    case "date":
+      return formatDate(date)
+    case "datetime":
+      return formatDateTime(date)
+    case "weekday":
+      return formatWeekday(date)
+    default:
+      return formatRelative(date)
+  }
+}
+
+export function parseTimestamp(value) {
+  const dateOnly = value.match(/^(\d{4})-(\d{2})-(\d{2})$/)
+
+  if (dateOnly) {
+    return new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
+  } else {
+    return new Date(value)
+  }
+}
+
 export function signedDifferenceInDays(fromDate, toDate) {
-  return Math.round((beginningOfDay(toDate) - beginningOfDay(fromDate)) / (1000 * 60 * 60 * 24))
+  return Math.round((beginningOfDay(toDate) - beginningOfDay(fromDate)) / MS_PER_DAY)
 }
 
 export function beginningOfDay(date) {
@@ -9,6 +42,56 @@ export function beginningOfDay(date) {
   return new Date(Date.UTC(year, month - 1, day))
 }
 
+function formatRelative(date) {
+  const days = localCalendarDaysAway(date)
+
+  if (days === 0) {
+    return formatTimeOfDay(date)
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days < -1 && days > -7) {
+    return `${Math.abs(days)} days ago`
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else {
+    return formatDate(date)
+  }
+}
+
+function formatTimeOfDay(date) {
+  return normalizeSpaces(timeOfDayFormatter.format(date))
+}
+
+function formatDate(date) {
+  if (date.getFullYear() === new Date().getFullYear()) {
+    return shortDateFormatter.format(date)
+  } else {
+    return shortDateWithYearFormatter.format(date)
+  }
+}
+
+function formatDateTime(date) {
+  return normalizeSpaces(dateTimeFormatter.format(date))
+}
+
+function formatWeekday(date) {
+  return weekdayFormatter.format(date)
+}
+
+function localCalendarDaysAway(date) {
+  return Math.round((localBeginningOfDay(date) - localBeginningOfDay(new Date())) / MS_PER_DAY)
+}
+
+function localBeginningOfDay(date) {
+  return new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()))
+}
+
+function normalizeSpaces(string) {
+  return string.replace(/\u202f/g, " ")
+}
+
