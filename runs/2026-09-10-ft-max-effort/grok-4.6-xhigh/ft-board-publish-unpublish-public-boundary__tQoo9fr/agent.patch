@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publish creates a publication with a secret key" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.reload.published?
+    assert @board.publication.key.present?
+  end
+
+  test "publish is idempotent" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublish removes the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.reload.published?
+  end
+
+  test "published scope" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+    assert_includes Board.published, @board
+  end
+end
