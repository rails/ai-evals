diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..02e0740 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,26 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due ignores closed and drafted cards" do
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    cards(:shipping).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    cards(:unfinished_thoughts).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 2.days)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+    assert_not cards(:unfinished_thoughts).reload.postponed?
+  end
+
+  test "auto postpone all due includes cards exactly at the cutoff" do
+    freeze_time
+
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+  end
 end
