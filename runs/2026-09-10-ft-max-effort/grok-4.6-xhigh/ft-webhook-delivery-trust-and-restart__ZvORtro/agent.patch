index 0000000..5ef412b
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.create_delinquency_tracker
+  end
+
+  test "resets consecutive failures after a success" do
+    3.times { @tracker.track(failed_delivery) }
+    assert_equal 3, @tracker.reload.consecutive_failures_count
+
+    @tracker.track(successful_delivery)
+
+    @tracker.reload
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "does not deactivate after ten failures within an hour" do
+    10.times { @tracker.track(failed_delivery) }
+
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "deactivates after ten consecutive failures spanning an hour" do
+    travel_to 61.minutes.ago do
+      @tracker.track(failed_delivery)
+    end
+
+    9.times { @tracker.track(failed_delivery) }
+
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+    assert_not @webhook.reload.active?
+  end
+
+  test "does not deactivate after nine consecutive failures spanning an hour" do
+    travel_to 2.hours.ago do
+      @tracker.track(failed_delivery)
+    end
+
+    8.times { @tracker.track(failed_delivery) }
+
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new(state: :completed, response: { code: 500 })
+    end
+
+    def successful_delivery
+      Webhook::Delivery.new(state: :completed, response: { code: 200 })
+    end
+end
