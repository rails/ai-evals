--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    stub_dns_resolution("1.1.1.1")
+    @webhook = webhooks(:active)
+    @request = stub_request(:post, @webhook.url).to_return(status: 200)
+  end
+
+  test "relays a published card to subscribed webhooks exactly once" do
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      perform_enqueued_jobs do
+        boards(:writebook).cards.create!(title: "Relay me", status: :published, creator: users(:david))
+      end
+    end
+
+    assert_requested @request, times: 1
+
+    delivery = @webhook.deliveries.ordered.first
+    assert delivery.succeeded?
+    assert_equal "completed", delivery.state
+    assert_equal 200, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig("headers", "User-Agent")
+    assert_equal "application/json", delivery.request.dig("headers", "Content-Type")
+    assert delivery.request.dig("headers", "X-Webhook-Timestamp").present?
+    assert delivery.request.dig("headers", "X-Webhook-Signature").present?
+  end
+
+  test "does not relay unsubscribed actions" do
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        cards(:logo).postpone(user: users(:david))
+      end
+    end
+
+    assert_not_requested @request
+  end
+
+  test "does not relay to inactive webhooks" do
+    @webhook.deactivate
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        boards(:writebook).cards.create!(title: "Skip me", status: :published, creator: users(:david))
+      end
+    end
+
+    assert_not_requested @request
+  end
+
+  test "signs the payload with HMAC SHA256" do
+    perform_enqueued_jobs do
+      boards(:writebook).cards.create!(title: "Signed", status: :published, creator: users(:david))
+    end
+
+    delivery = @webhook.deliveries.ordered.first
+    payload = Webhook::Payload.new(@webhook, delivery.event).to_s
+    expected = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, payload)
+    assert_equal expected, delivery.request.dig("headers", "X-Webhook-Signature")
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
