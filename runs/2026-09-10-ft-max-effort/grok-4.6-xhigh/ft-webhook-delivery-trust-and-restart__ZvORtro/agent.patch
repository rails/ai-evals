diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..5f534c5
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,44 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track(delivery)
+    with_lock do
+      if delivery.succeeded?
+        record_success
+      elsif delivery.failed?
+        record_failure
+      end
+    end
+  end
+
+  def reset
+    if consecutive_failures_count > 0 || first_failure_at.present?
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+  end
+
+  private
+    def record_success
+      reset
+    end
+
+    def record_failure
+      if consecutive_failures_count.zero?
+        update!(consecutive_failures_count: 1, first_failure_at: Time.current)
+      else
+        increment!(:consecutive_failures_count)
+      end
+
+      webhook.deactivate if delinquent?
+    end
+
+    def delinquent?
+      consecutive_failures_count >= FAILURE_THRESHOLD &&
+        first_failure_at.present? &&
+        first_failure_at <= FAILURE_PERIOD.ago
+    end
+end
