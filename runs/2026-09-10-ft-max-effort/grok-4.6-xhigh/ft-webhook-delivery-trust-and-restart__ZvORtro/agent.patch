@@ -1,4 +1,28 @@
+require "net/http"
+require "resolv"
+
 class Webhook::Delivery < ApplicationRecord
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  RETENTION_PERIOD = 1.week
+  CONNECTION_ERRORS = [
+    Timeout::Error,
+    Errno::ECONNREFUSED,
+    Errno::ECONNRESET,
+    Errno::EHOSTUNREACH,
+    Errno::ENETUNREACH,
+    Errno::ETIMEDOUT,
+    Errno::EPERM,
+    Errno::EACCES,
+    Net::OpenTimeout,
+    Net::ReadTimeout,
+    Net::WriteTimeout,
+    SocketError,
+    OpenSSL::SSL::SSLError,
+    Resolv::ResolvError
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +33,26 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  after_create_commit :deliver_later, if: :pending?
+
+  class << self
+    def cleanup
+      stale.in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    return unless claim
+
+    submit_and_record
+    track_delinquency
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +73,78 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      with_lock do
+        if pending?
+          in_progress!
+          true
+        end
+      end
+    end
+
+    def submit_and_record
+      submit
+    rescue *CONNECTION_ERRORS
+      record_error "destination_unreachable"
+    end
+
+    def submit
+      uri = URI.parse(webhook.url)
+      ip = SsrfProtection.resolve_public_ip(uri.hostname)
+
+      if ip.present?
+        post_to uri, ip
+      else
+        record_error "destination_unreachable"
+      end
+    end
+
+    def post_to(uri, ip)
+      body = Webhook::Payload.new(webhook, event).to_s
+      headers = request_headers_for(body)
+
+      update!(request: { headers: headers })
+
+      http_response = http_post(uri, ip, body, headers)
+      record_response http_response
+    end
+
+    def request_headers_for(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def http_post(uri, ip, body, headers)
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request.body = body
+      headers.each { |name, value| request[name] = value }
+
+      http.request(request)
+    end
+
+    def record_response(http_response)
+      update! state: :completed, response: { code: http_response.code.to_i, error: nil }
+    end
+
+    def record_error(error)
+      update! state: :errored, response: { error: error }
+    end
+
+    def track_delinquency
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker
+      tracker.track(self)
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..5b10639
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,62 @@
+class Webhook::Payload
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def to_s
+    if @webhook.for_slack?
+      { text: html }.to_json
+    elsif @webhook.for_campfire?
+      { body: html }.to_json
+    elsif @webhook.for_basecamp?
+      { content: html }.to_json
+    else
+      json
+    end
+  end
+
+  private
+    def html
+      render(:html).strip
+    end
+
+    def json
+      render(:json)
+    end
+
+    def render(format)
+      ApplicationController.renderer.new(**renderer_defaults).render(
+        template: "webhooks/event",
+        assigns: { event: @event },
+        formats: [ format ],
+        layout: false
+      )
+    end
+
+    def renderer_defaults
+      {
+        http_host: http_host,
+        https: https?,
+        script_name: @event.account.slug
+      }
+    end
+
+    def http_host
+      if url_options[:port]
+        "#{url_options[:host]}:#{url_options[:port]}"
+      else
+        url_options[:host]
+      end
+    end
+
+    def https?
+      url_options[:protocol] == "https"
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        { host: "localhost" }
+    end
+end
