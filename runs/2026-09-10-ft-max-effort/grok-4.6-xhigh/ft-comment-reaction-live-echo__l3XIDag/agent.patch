+    <span class="for-screen-reader">Your reaction</span>
+    <%= form.text_field :content, class: "input reaction__input", maxlength: Reaction::MAX_CONTENT_LENGTH, required: true,
+          autocomplete: "off", data: { reactions_target: "input", form_target: "input" } %>
