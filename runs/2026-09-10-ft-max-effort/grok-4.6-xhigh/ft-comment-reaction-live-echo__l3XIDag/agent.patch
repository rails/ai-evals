diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..a3b14dc
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+      assert_turbo_stream action: :append, target: dom_id(@comment, :reactions)
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal "👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Ship it" } }, as: :json
+    end
+
+    assert_response :created
+    json = @response.parsed_body
+    assert_equal "Ship it", json["content"]
+    assert_equal users(:kevin).id, json["reacter"]["id"]
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "💯" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "💯", @response.parsed_body["content"]
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, comments(:logo_agreement_kevin)), as: :json
+    assert_response :success
+
+    body = @response.parsed_body
+    assert_equal 2, body.size
+    assert_equal "👍", body.first["content"]
+    assert body.first["reacter"]["name"]
+    assert body.first["url"]
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:logo_kevin_thumbs_up)
+
+    get card_comment_reaction_path(@card, reaction.comment, reaction), as: :json
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "👍", @response.parsed_body["content"]
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_kevin_thumbs_up)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :turbo_stream
+      assert_turbo_stream action: :remove, target: reaction
+    end
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_kevin_thumbs_up)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for another user" do
+    reaction = reactions(:logo_jz_fire)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "card show includes reactions strip" do
+    get card_path(@card)
+    assert_response :success
+    assert_select ".reactions"
+    assert_select ".reactions__trigger img[src*=boost-color]"
+    assert_select "form.reaction__form[hidden]"
