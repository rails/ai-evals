new file mode 100644
index 0000000..f789065
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "👍")
+
+    assert_equal "👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal comment.account, reaction.account
+    assert_equal comment, reaction.comment
+  end
+
+  test "content is stripped and limited to 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "  Nice  ")
+    assert_equal "Nice", reaction.content
+
+    reaction = comment.reactions.build(content: "a" * 17)
+    assert_not reaction.valid?
+    assert reaction.errors[:content].any?
+  end
+
+  test "content cannot be blank" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.build(content: "   ")
+    assert_not reaction.valid?
+    assert reaction.errors[:content].any?
+  end
+
+  test "creating a reaction records card activity" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    freeze_time do
+      card.update_column(:last_active_at, 1.day.ago)
+
+      assert_changes -> { card.reload.last_active_at } do
+        comment.reactions.create!(content: "🎉")
+      end
+
+      assert_equal Time.current, card.last_active_at
+    end
+  end
+
+  test "broadcasts the reaction to the card" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_turbo_stream_broadcasts comment.card do
+      comment.reactions.create!(content: "👏")
+    end
+  end
+
+  test "broadcasts removal to the card" do
+    reaction = reactions(:logo_kevin_thumbs_up)
+
+    assert_turbo_stream_broadcasts reaction.card do
+      reaction.destroy!
+    end
+  end
+
+  test "emoji? is true for emoji-only content" do
+    reaction = reactions(:logo_kevin_thumbs_up)
+    assert reaction.emoji?
+
+    reaction.content = "Great work"
+    assert_not reaction.emoji?
+  end
+
+  test "comment destroys reactions" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { Reaction.count }, -2 do
+      comment.destroy!
+    end
+  end
+end
