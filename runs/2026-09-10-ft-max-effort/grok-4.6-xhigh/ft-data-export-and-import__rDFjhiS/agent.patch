@@ -0,0 +1,26 @@
+class Exports::DownloadsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+
+  def show
+    export = Export.find_signed!(params[:id], purpose: :download)
+    return head :not_found unless export.completed? && export.file.attached?
+
+    if disk_service?(export.file)
+      send_file export.file.service.path_for(export.file.key),
+        filename: export.file.filename.to_s,
+        type: export.file.content_type,
+        disposition: :attachment
+    else
+      redirect_to export.file.url(expires_in: 5.minutes, disposition: :attachment), allow_other_host: true
+    end
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    head :not_found
+  end
+
+  private
+    def disk_service?(attachment)
+      service = attachment.blob.service
+      service.respond_to?(:path_for) && File.exist?(service.path_for(attachment.blob.key))
+    end
+end
