@@ -0,0 +1,69 @@
+class Export < ApplicationRecord
+  EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself)
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  after_create_commit :process_later
+
+  scope :expired, -> { where(created_at: ...EXPIRATION.ago) }
+
+  class << self
+    def expire_all
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def process_later
+    Export::ProcessJob.perform_later(self)
+  end
+
+  def process_now
+    processing!
+    attach_archive
+    completed!
+    ExportMailer.ready(self).deliver_later
+  rescue => error
+    file.purge if file.attached?
+    update!(status: :failed, error_message: error.message)
+    Rails.error.report(error)
+  end
+
+  def accessible_to?(user)
+    user == self.user || user.admin?
+  end
+
+  def filename
+    timestamp = Time.current.strftime("%Y%m%d-%H%M%S")
+
+    if account?
+      "#{self.account.name.parameterize}-export-#{timestamp}.zip"
+    else
+      "#{user.name.parameterize}-cards-#{timestamp}.zip"
+    end
+  end
+
+  def download_signed_id
+    signed_id(purpose: :download, expires_in: EXPIRATION)
+  end
+
+  private
+    def attach_archive
+      ZipFile.create_for(file, filename: filename) do |zip|
+        exporter.export_to(zip)
+      end
+    end
+
+    def exporter
+      if account?
+        Account::DataTransfer::Exporter.new(self.account)
+      else
+        Account::DataTransfer::CardsExporter.new(user)
+      end
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..af12ce5
