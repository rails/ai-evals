+++ b/app/models/import.rb
@@ -0,0 +1,57 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  after_create_commit :process_later
+
+  def process_later
+    Import::ProcessJob.perform_later(self)
+  end
+
+  def process_now
+    imported = nil
+    processing!
+    imported = perform_import
+    grant_requester_access(imported)
+    update!(status: :completed, imported_account: imported)
+    ImportMailer.completed(self).deliver_later
+  rescue => error
+    destroy_imported(imported)
+    update!(status: :failed, error_message: error.message)
+    ImportMailer.failed(self).deliver_later
+    Rails.error.report(error)
+  end
+
+  def accessible_to?(user)
+    user == self.user || user.admin?
+  end
+
+  private
+    def perform_import
+      ZipFile.open_for(file) do |zip|
+        Account::DataTransfer::Importer.new(zip).import
+      end
+    end
+
+    def grant_requester_access(imported_account)
+      return if imported_account.users.exists?(identity_id: user.identity_id)
+
+      imported_account.users.create!(
+        identity: user.identity,
+        name: user.name,
+        role: :admin,
+        verified_at: Time.current
+      )
+    end
+
+    def destroy_imported(imported_account)
+      if imported_account&.persisted?
+        Storage::Entry.suppressing_recording { imported_account.destroy }
+      end
+    end
+end
