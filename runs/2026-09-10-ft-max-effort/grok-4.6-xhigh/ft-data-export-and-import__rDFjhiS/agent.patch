@@ -27,4 +36,140 @@ class Account::DataTransfer::RecordSet
     def model_dir
       model.table_name
     end
+
+    def records_path
+      "#{model_dir}/records.jsonl"
+    end
+
+    def export
+      return if no_records?
+
+      zip.add_file(records_path) do |sink|
+        each_record do |record|
+          sink.write(dump_record(record).to_json)
+          sink.write("\n")
+        end
+      end
+    end
+
+    def import(id_map)
+      return unless zip.exists?(records_path)
+
+      rows = []
+
+      each_exported_record do |attrs|
+        rows << remap_attributes(attrs, id_map)
+        if rows.size >= BATCH_SIZE
+          insert_rows(rows)
+          rows = []
+        end
+      end
+
+      insert_rows(rows)
+    end
+
+    def no_records?
+      relation = records
+
+      if relation.respond_to?(:exists?)
+        !relation.exists?
+      else
+        relation.empty?
+      end
+    end
+
+    def each_record(&block)
+      relation = records
+
+      if relation.respond_to?(:find_each)
+        relation.find_each(&block)
+      else
+        relation.each(&block)
+      end
+    end
+
+    def each_exported_record
+      zip.open(records_path) do |io|
+        io.each_line do |line|
+          line = line.strip
+          next if line.empty?
+
+          yield JSON.parse(line)
+        end
+      end
+    end
+
+    def dump_record(record)
+      attributes.each_with_object({}) do |name, hash|
+        hash[name] = dump_attribute(record, name)
+      end
+    end
+
+    def dump_attribute(record, name)
+      typed = record.read_attribute(name)
+      column = record.class.columns_hash[name]
+
+      if column&.type == :integer && model.defined_enums[name]
+        record.read_attribute_before_type_cast(name)
+      else
+        dump_value(typed)
+      end
+    end
+
+    def dump_value(value)
+      case value
+      when Time, ActiveSupport::TimeWithZone
+        value.utc.iso8601(6)
+      when Date
+        value.iso8601
+      when BigDecimal
+        value.to_s
+      when ActionText::Content
+        utf8_string(value.to_html)
+      when String
+        utf8_string(value)
+      else
+        value.as_json
+      end
+    end
+
+    def utf8_string(value)
+      value.to_s.dup.force_encoding(Encoding::UTF_8).scrub
+    end
+
+    def remap_attributes(attrs, id_map)
+      new_attrs = attrs.slice(*attributes)
+      old_id = new_attrs["id"]
+      new_attrs["id"] = ActiveRecord::Type::Uuid.generate
+      id_map.store(model.name, old_id, new_attrs["id"])
+
+      model.reflect_on_all_associations(:belongs_to).each do |reflection|
+        remap_foreign_key(new_attrs, reflection, id_map)
+      end
+
+      new_attrs
+    end
+
+    def remap_foreign_key(attrs, reflection, id_map)
+      fk = reflection.foreign_key.to_s
+      return unless attrs.key?(fk)
+      return if attrs[fk].nil?
+
+      if reflection.polymorphic?
+        type = attrs[reflection.foreign_type.to_s]
+        mapped = id_map.lookup?(type, attrs[fk])
+        attrs[fk] = mapped if mapped
+      elsif reflection.class_name == "Account"
+        attrs[fk] = account.id
+      elsif reflection.class_name == "Identity"
+        # Identities are resolved by email in UserRecordSet
+      else
+        mapped = id_map.lookup?(reflection.class_name, attrs[fk])
+        attrs[fk] = mapped if mapped
+      end
+    end
+
+    def insert_rows(rows)
+      model.insert_all!(rows) if rows.any?
+    end
 end
