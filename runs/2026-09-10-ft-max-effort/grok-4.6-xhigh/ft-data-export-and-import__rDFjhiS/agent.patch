diff --git a/app/models/zip_file/extractor_io.rb b/app/models/zip_file/extractor_io.rb
new file mode 100644
index 0000000..4d93974
--- /dev/null
+++ b/app/models/zip_file/extractor_io.rb
@@ -0,0 +1,71 @@
+class ZipFile::ExtractorIO
+  def initialize(extractor, size:)
+    @extractor = extractor
+    @size = size
+    @buffer = +""
+  end
+
+  attr_reader :size
+
+  def read(n = nil, outbuf = nil)
+    data = if n.nil?
+      take_remaining
+    else
+      fill_buffer_to(n)
+      @buffer.slice!(0, n)
+    end
+
+    data ||= ""
+
+    if outbuf
+      outbuf.replace(data)
+    else
+      data
+    end
+  end
+
+  def eof?
+    @buffer.empty? && @extractor.eof?
+  end
+
+  def each_line
+    loop do
+      while @buffer.exclude?("\n") && !@extractor.eof?
+        chunk = @extractor.extract(64.kilobytes)
+        @buffer << chunk if chunk
+      end
+
+      if (idx = @buffer.index("\n"))
+        yield @buffer.slice!(0, idx + 1)
+      else
+        yield @buffer unless @buffer.empty?
+        break
+      end
+    end
+  end
+
+  def binmode
+    self
+  end
+
+  def close
+  end
+
+  private
+    def take_remaining
+      data = +@buffer
+      @buffer = +""
+      until @extractor.eof?
+        chunk = @extractor.extract(1.megabyte)
+        data << chunk if chunk
+      end
+      data
+    end
+
+    def fill_buffer_to(n)
+      while @buffer.bytesize < n && !@extractor.eof?
+        chunk = @extractor.extract(1.megabyte)
+        @buffer << chunk if chunk
+      end
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..0bb3e7e
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,32 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def exists?(path)
+    find_entry(path).present?
+  end
+
+  def glob(pattern)
+    @entries.select { |entry| File.fnmatch(pattern, entry.filename) }.map(&:filename).sort
+  end
+
+  def read(path)
+    open(path, &:read)
+  end
+
+  def open(path)
+    entry = find_entry(path)
+    raise ArgumentError, "No zip entry named #{path}" unless entry
+
+    extractor = entry.extractor_from(@io)
+    io = ZipFile::ExtractorIO.new(extractor, size: entry.uncompressed_size)
+    yield io
+  end
+
+  private
+    def find_entry(path)
+      @entries.find { |entry| entry.filename == path }
+    end
+end
diff --git a/app/models/zip_file/service_io.rb b/app/models/zip_file/service_io.rb
new file mode 100644
index 0000000..018fb2e
--- /dev/null
+++ b/app/models/zip_file/service_io.rb
@@ -0,0 +1,45 @@
+class ZipFile::ServiceIO
+  def initialize(service, key, size:)
+    @service = service
+    @key = key
+    @size = size
+    @pos = 0
+  end
+
+  attr_reader :size
+
+  def seek(amount, whence = IO::SEEK_SET)
+    @pos = case whence
+    when IO::SEEK_SET then amount
+    when IO::SEEK_CUR then @pos + amount
+    when IO::SEEK_END then @size + amount
+    else raise ArgumentError, "Unknown seek mode #{whence}"
+    end
+    0
+  end
+
+  def tell
+    @pos
+  end
+
+  def read(n = nil)
+    if @pos >= @size
+      return n.nil? ? nil : ""
+    end
+
+    n = @size - @pos if n.nil?
+    n = [ n, @size - @pos ].min
+    return "" if n <= 0
+
+    data = @service.download_chunk(@key, @pos...(@pos + n))
+    @pos += data.bytesize
+    data
+  end
+
+  def binmode
+    self
+  end
+
+  def close
+  end
+end
