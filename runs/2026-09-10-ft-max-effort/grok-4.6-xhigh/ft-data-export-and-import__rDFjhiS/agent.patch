+    tempfile.binmode
+
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.add_file("data/records.jsonl", { id: 1, name: "Ada" }.to_json + "\n")
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    assert reader.exists?("hello.txt")
