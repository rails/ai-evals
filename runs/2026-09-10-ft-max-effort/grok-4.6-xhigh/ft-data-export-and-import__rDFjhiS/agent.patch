@@ -8,4 +8,46 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def dump_record(record)
+      super.merge("body" => rewrite_body_for_export(record.body))
+    end
+
+    def remap_attributes(attrs, id_map)
+      remapped = super
+      remapped["body"] = rewrite_body_for_import(remapped["body"], id_map)
+      remapped
+    end
+
+    def rewrite_body_for_export(content)
+      return if content.blank?
+
+      fragment = Nokogiri::HTML.fragment(content.to_html)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        attachable = ActionText::Attachable.from_attachable_sgid(node["sgid"])
+        node["export-gid"] = attachable.to_global_id.to_s if attachable
+      rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+      end
+      fragment.to_html
+    end
+
+    def rewrite_body_for_import(html, id_map)
+      return html if html.blank?
+
+      fragment = Nokogiri::HTML.fragment(html)
+      fragment.css("action-text-attachment[export-gid]").each do |node|
+        gid = GlobalID.parse(node["export-gid"])
+        next unless gid
+
+        new_id = id_map.lookup?(gid.model_name.to_s, gid.model_id) || gid.model_id
+        record = gid.model_class.find_by(id: new_id)
+        next unless record&.respond_to?(:attachable_sgid)
+
+        node["sgid"] = record.attachable_sgid
+        if record.is_a?(ActiveStorage::Blob)
+          node["url"] = Rails.application.routes.url_helpers.rails_blob_path(record, only_path: true)
+        end
+        node.remove_attribute("export-gid")
+      end
+      fragment.to_html
+    end
 end
