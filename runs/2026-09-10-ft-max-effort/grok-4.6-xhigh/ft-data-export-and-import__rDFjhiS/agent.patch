     super(account: account, model: Entropy)
   end
+
+  private
+    def import(id_map)
+      return unless zip.exists?(records_path)
+
+      rows = []
+
+      each_exported_record do |attrs|
+        if attrs["container_type"] == "Account"
+          import_account_entropy(attrs, id_map)
+        else
+          rows << remap_attributes(attrs, id_map)
+        end
+      end
+
+      insert_rows(rows)
+    end
+
+    def import_account_entropy(attrs, id_map)
+      entropy = Entropy.find_by!(container: account)
+      id_map.store("Entropy", attrs["id"], entropy.id)
+
+      updates = {}
+      updates[:auto_postpone_period] = attrs["auto_postpone_period"] if attrs["auto_postpone_period"]
+      entropy.update_columns(updates) if updates.any?
+    end
 end
