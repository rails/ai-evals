diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..732367c
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "process_now attaches a zip and emails a download link for account exports" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+
+    assert_enqueued_with job: Export::ProcessJob, args: [ export ]
+
+    assert_emails 1 do
+      perform_enqueued_jobs only: [ Export::ProcessJob, ActionMailer::MailDeliveryJob ]
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+  end
+
+  test "cards export only includes cards the user can see" do
+    assert boards(:private).accessible_to?(users(:kevin))
+    assert_not boards(:private).accessible_to?(users(:david))
+
+    private_card = nil
+    with_current_user(users(:kevin)) do
+      private_card = boards(:private).cards.create!(
+        title: "Secret work",
+        creator: users(:kevin),
+        status: :published,
+        account: @account
+      )
+    end
+
+    export = Export.create!(account: @account, user: users(:david), kind: :cards)
+    perform_enqueued_jobs only: Export::ProcessJob
+    export.reload
+
+    ZipFile.open_for(export.file) do |zip|
+      assert_equal "cards", JSON.parse(zip.read("manifest.json"))["kind"]
+      card_files = zip.glob("cards/*.json")
+      payloads = card_files.map { |path| JSON.parse(zip.read(path)) }
+
+      assert payloads.any? { |payload| payload["title"] == cards(:logo).title }
+      assert payloads.none? { |payload| payload["title"] == private_card.title }
+      assert payloads.any? { |payload| payload["comments"].is_a?(Array) }
+    end
+  end
+
+  test "expire_all destroys old exports" do
+    export = Export.create!(account: @account, user: @user, kind: :cards)
+    export.update_columns(created_at: 2.days.ago)
+
+    assert_difference -> { Export.count }, -1 do
+      Export.expire_all
+    end
+  end
+end
