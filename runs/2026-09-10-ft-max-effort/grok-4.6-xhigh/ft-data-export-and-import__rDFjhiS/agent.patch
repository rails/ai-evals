+    import.save!
+
+    perform_enqueued_jobs only: [ Import::ProcessJob, ActionMailer::MailDeliveryJob ]
+
+    import.reload
+    assert import.completed?, import.error_message
+    imported = import.imported_account
+    assert_not_equal @account.id, imported.id
+    assert_equal @account.name, imported.name
+
+    assert imported.users.exists?(identity: identities(:kevin))
+    assert imported.users.exists?(identity: identities(:david))
+    assert imported.boards.exists?(name: boards(:writebook).name)
+
+    imported_card = imported.cards.find_by!(title: card.title)
+    assert_not_equal card.id, imported_card.id
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+    assert_equal original_comment_bodies.sort, imported_card.comments.by_user.map { |comment| comment.body.to_plain_text }.sort
+  end
+
+  test "a failed import leaves no new account behind" do
+    export = Export.create!(account: @account, user: @user, kind: :cards)
+    perform_enqueued_jobs only: Export::ProcessJob
+    export.reload
+
+    assert_no_difference -> { Account.count } do
+      import = Import.new(account: @account, user: @user)
+      import.file.attach(io: StringIO.new(export.file.download), filename: "cards.zip", content_type: "application/zip")
+      import.save!
+      perform_enqueued_jobs only: [ Import::ProcessJob, ActionMailer::MailDeliveryJob ]
+      import.reload
+      assert import.failed?
+      assert_nil import.imported_account
+      assert import.error_message.present?
+    end
+  end
+end
