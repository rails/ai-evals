@@ -0,0 +1,22 @@
+class Account::DataTransfer::IdMap
+  def initialize
+    @map = {}
+  end
+
+  def store(class_name, old_id, new_id)
+    @map[class_name.to_s] ||= {}
+    @map[class_name.to_s][old_id.to_s] = new_id
+  end
+
+  def lookup(class_name, old_id)
+    mapped = lookup?(class_name, old_id)
+    raise KeyError, "No mapping for #{class_name} #{old_id}" if mapped.nil? && old_id.present?
+    mapped
+  end
+
+  def lookup?(class_name, old_id)
+    return if old_id.nil?
+
+    @map.dig(class_name.to_s, old_id.to_s)
+  end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..f507e69
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,74 @@
+class Account::DataTransfer::Importer
+  class InvalidExport < StandardError; end
+
+  def initialize(zip)
+    @zip = zip
+  end
+
+  def import
+    verify_manifest!
+
+    id_map = Account::DataTransfer::IdMap.new
+    account = nil
+
+    begin
+      account_record_set = Account::DataTransfer::AccountRecordSet.new(nil)
+      account = account_record_set.import_from(@zip, id_map)
+
+      Current.with_account(account) do
+        Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+          next if record_set.is_a?(Account::DataTransfer::AccountRecordSet)
+
+          record_set.import_from(@zip, id_map)
+        end
+
+        reindex(account)
+        reconcile_storage(account)
+      end
+
+      account
+    rescue
+      destroy_account(account)
+      raise
+    end
+  end
+
+  private
+    def verify_manifest!
+      unless @zip.exists?("manifest.json")
+        raise InvalidExport, "This file is not a Fizzy account export."
+      end
+
+      manifest = JSON.parse(@zip.read("manifest.json"))
+
+      if manifest["kind"] != "account"
+        raise InvalidExport, "This file is a cards export and cannot be imported as an account."
+      end
+
+      if manifest["version"] != 1
+        raise InvalidExport, "This export was created by an unsupported version of Fizzy."
+      end
+    end
+
+    def reindex(account)
+      Card.where(account: account).published.find_each(&:reindex)
+      Comment.where(account: account).includes(:card).find_each do |comment|
+        comment.reindex if comment.searchable?
+      end
+    rescue StandardError => error
+      Rails.error.report(error)
+    end
+
+    def reconcile_storage(account)
+      account.reconcile_storage
+      account.boards.find_each(&:reconcile_storage)
+    rescue StandardError => error
+      Rails.error.report(error)
+    end
+
+    def destroy_account(account)
+      if account&.persisted?
+        Storage::Entry.suppressing_recording { account.destroy }
+      end
+    end
+end
