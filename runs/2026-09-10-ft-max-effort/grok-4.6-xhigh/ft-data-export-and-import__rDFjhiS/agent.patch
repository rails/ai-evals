+++ b/app/models/account/data_transfer/cards_exporter.rb
@@ -0,0 +1,86 @@
+class Account::DataTransfer::CardsExporter
+  def initialize(user)
+    @user = user
+    @account = user.account
+  end
+
+  def export_to(zip)
+    zip.add_file("manifest.json", { version: 1, kind: "cards" }.to_json)
+
+    cards.find_each do |card|
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_payload(card)))
+      export_files(zip, card)
+    end
+  end
+
+  private
+    def cards
+      @user.accessible_cards.preloaded
+    end
+
+    def card_payload(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        board: card.board.name,
+        column: card.column&.name,
+        creator: card.creator.name,
+        assignees: card.assignees.map(&:name),
+        tags: card.tags.map(&:title).sort,
+        created_at: card.created_at.utc.iso8601,
+        last_active_at: card.last_active_at.utc.iso8601,
+        comments: comments_payload(card),
+        attachments: attachments_payload(card)
+      }
+    end
+
+    def comments_payload(card)
+      card.comments.preloaded.chronologically.map do |comment|
+        {
+          id: comment.id,
+          body: comment.body.to_plain_text,
+          body_html: comment.body.to_s,
+          creator: comment.creator.name,
+          created_at: comment.created_at.utc.iso8601
+        }
+      end
+    end
+
+    def attachments_payload(card)
+      blobs_for(card).map do |blob|
+        {
+          id: blob.id,
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          path: file_path(blob)
+        }
+      end
+    end
+
+    def export_files(zip, card)
+      blobs_for(card).each do |blob|
+        zip.add_file(file_path(blob), compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        rescue ActiveStorage::FileNotFoundError
+        end
+      end
+    end
+
+    def blobs_for(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat(card.attachments.map(&:blob))
+      card.comments.preloaded.each do |comment|
+        blobs.concat(comment.attachments.map(&:blob))
+      end
+      blobs.compact.uniq
+    end
+
+    def file_path(blob)
+      "files/#{blob.id}/#{blob.filename}"
+    end
+end
