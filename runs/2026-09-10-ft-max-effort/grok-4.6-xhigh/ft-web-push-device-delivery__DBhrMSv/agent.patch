diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..594c3bb
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,23 @@
+Rails.application.configure do
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+  config.x.vapid.subject = ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do")
+
+  if config.x.vapid.public_key.blank? && Rails.env.local?
+    if Rails.env.development?
+      path = Rails.root.join("tmp/vapid.yml")
+      unless path.exist?
+        key = WebPush.generate_key
+        File.write(path, { "public_key" => key.public_key, "private_key" => key.private_key }.to_yaml)
+      end
+
+      vapid = YAML.safe_load_file(path)
+      config.x.vapid.public_key = vapid["public_key"]
+      config.x.vapid.private_key = vapid["private_key"]
+    else
+      key = WebPush.generate_key
+      config.x.vapid.public_key = key.public_key
+      config.x.vapid.private_key = key.private_key
+    end
+  end
+end
