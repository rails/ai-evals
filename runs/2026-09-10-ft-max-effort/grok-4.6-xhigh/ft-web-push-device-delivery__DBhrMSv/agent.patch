--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,31 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    Push::Subscription.register(
+      user: @user,
+      user_agent: request.user_agent,
+      endpoint: subscription_params[:endpoint],
+      p256dh_key: subscription_params[:p256dh_key],
+      auth_key: subscription_params[:auth_key]
+    )
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..c9e2bfe
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,109 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+  static targets = [ "details" ]
+
+  async connect() {
+    if (!this.#supported) {
+      this.#off({ showHelp: true })
+      return
+    }
+
+    switch (Notification.permission) {
+      case "granted":
+        try {
+          await this.#subscribe()
+          this.#on()
+        } catch {
+          this.#off({ showHelp: true })
+        }
+        break
+      case "denied":
+        this.#off({ showHelp: true })
+        break
+      default:
+        this.#off({ showHelp: false })
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (!this.#supported) {
+      this.#off({ showHelp: true })
+      return
+    }
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        await this.#subscribe()
+        this.#on()
+      } else {
+        this.#off({ showHelp: true })
+      }
+    } catch {
+      this.#off({ showHelp: true })
+    }
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    }
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: this.#payloadFrom(subscription)
+    })
+
+    if (!response.ok) {
+      await subscription.unsubscribe()
+      throw new Error("Failed to register push subscription")
+    }
+  }
+
+  #on() {
+    this.element.classList.add("notifications--on")
+    this.#toggleHelp(false)
+  }
+
+  #off({ showHelp }) {
+    this.element.classList.remove("notifications--on")
+    this.#toggleHelp(showHelp)
+  }
+
+  #toggleHelp(show) {
+    this.detailsTargets.forEach(details => details.hidden = !show)
+  }
+
+  #payloadFrom(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    return {
+      push_subscription: {
+        endpoint,
+        p256dh_key: keys.p256dh,
+        auth_key: keys.auth
+      }
+    }
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+
+    return Uint8Array.from([...rawData].map(char => char.charCodeAt(0)))
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+}
