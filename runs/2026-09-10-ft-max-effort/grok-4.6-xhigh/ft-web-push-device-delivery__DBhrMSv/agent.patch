diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..82284af
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,32 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def register(user:, endpoint:, p256dh_key:, auth_key:, user_agent: nil)
+      subscription = find_or_initialize_by(endpoint: endpoint)
+      subscription.update!(user: user, account: user.account, p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent)
+      subscription
+    end
+  end
+
+  def push(payload)
+    WebPush.payload_send(
+      message: payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: Rails.configuration.x.vapid.subject,
+        public_key: Rails.configuration.x.vapid.public_key,
+        private_key: Rails.configuration.x.vapid.private_key
+      },
+      open_timeout: 5,
+      read_timeout: 5
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  end
+end
