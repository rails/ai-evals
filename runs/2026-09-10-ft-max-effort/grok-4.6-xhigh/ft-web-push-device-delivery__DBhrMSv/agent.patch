+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/david",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/david", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal @user, subscription.user
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/david-json",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create updates an existing subscription with the same endpoint" do
+    subscription = Push::Subscription.register(
+      user: @user,
+      endpoint: "https://push.example.com/existing",
+      p256dh_key: "old-p256dh",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new-p256dh",
+          auth_key: "new-auth"
+        }
+      }
+    end
+
+    assert_response :created
+    subscription.reload
+    assert_equal "new-p256dh", subscription.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/kevin",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :forbidden
+  end
+end
