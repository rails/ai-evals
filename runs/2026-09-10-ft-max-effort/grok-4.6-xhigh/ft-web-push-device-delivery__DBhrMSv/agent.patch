diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..5620c4f
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = Push::Subscription.register(
+      user: @user,
+      endpoint: "https://push.example.com/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key",
+      user_agent: "Mozilla/5.0"
+    )
+  end
+
+  test "register creates a subscription for the user" do
+    assert_equal @user, @subscription.user
+    assert_equal @user.account, @subscription.account
+    assert_equal "https://push.example.com/kevin", @subscription.endpoint
+    assert_equal "Mozilla/5.0", @subscription.user_agent
+  end
+
+  test "register reassigns an endpoint to a different user" do
+    david = users(:david)
+
+    subscription = Push::Subscription.register(
+      user: david,
+      endpoint: @subscription.endpoint,
+      p256dh_key: "other-p256dh",
+      auth_key: "other-auth"
+    )
+
+    assert_equal @subscription, subscription
+    assert_equal david, subscription.user
+    assert_equal david.account, subscription.account
+  end
+
+  test "push sends the payload to the push service" do
+    payload = { title: "Layout is broken", body: "A comment", path: "/cards/2" }
+
+    WebPush.expects(:payload_send).with do |params|
+      message = JSON.parse(params[:message])
+      params[:endpoint] == @subscription.endpoint &&
+        params[:p256dh] == "p256dh-key" &&
+        params[:auth] == "auth-key" &&
+        params[:vapid][:public_key] == Rails.configuration.x.vapid.public_key &&
+        params[:vapid][:private_key] == Rails.configuration.x.vapid.private_key &&
+        message["title"] == "Layout is broken" &&
+        message["body"] == "A comment" &&
+        message["path"] == "/cards/2"
+    end
+
+    @subscription.push(payload)
+  end
+
+  test "push destroys expired subscriptions" do
+    WebPush.stubs(:payload_send).raises(expired_subscription_error)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.push({ title: "Gone", body: "Expired", path: "/" })
+    end
+  end
+
+  private
+    def expired_subscription_error
+      response = Object.new
+      def response.body; "" end
+      def response.inspect; "410 Gone" end
+      WebPush::ExpiredSubscription.new(response, "push.example.com")
+    end
+end
