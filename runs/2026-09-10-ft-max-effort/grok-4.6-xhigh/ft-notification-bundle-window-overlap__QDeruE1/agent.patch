+class NotificationMailerPreview < ActionMailer::Preview
+  def bundle
+    user = User.active.joins(:notifications).first
+    Current.account = user.account
+
+    window = user.notification_windows.first || Notification::Window.create!(
+      user: user,
+      account: user.account,
+      starts_at: 4.hours.ago,
+      ends_at: Time.current
+    )
+
+    user.notifications.unread.limit(5).update_all(window_id: window.id)
+
+    NotificationMailer.bundle(window)
+  end
+end
