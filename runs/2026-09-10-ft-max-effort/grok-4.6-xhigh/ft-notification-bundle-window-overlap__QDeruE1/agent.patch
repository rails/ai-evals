+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :window, class_name: "Notification::Window", optional: true
+
+    after_save_commit :bundle_email, if: :source_id_previously_changed?
+  end
+
+  def bundle_email
+    Notification::Window.capture(self)
+  end
+end
diff --git a/app/models/notification/window.rb b/app/models/notification/window.rb
new file mode 100644
index 0000000..6e6535a
--- /dev/null
+++ b/app/models/notification/window.rb
@@ -0,0 +1,113 @@
+class Notification::Window < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", foreign_key: :window_id, inverse_of: :window, dependent: :nullify
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :covering, ->(time) { where("starts_at <= ? AND ends_at > ?", time, time) }
+  scope :chronologically, -> { order(:starts_at, :id) }
+
+  validate :does_not_overlap_another_window
+
+  class << self
+    def capture(notification)
+      return unless capturable?(notification)
+
+      notification.user.with_lock do
+        window = existing_window_for(notification) || open_window_for(notification)
+        assign(notification, window)
+        window
+      end
+    end
+
+    private
+      def capturable?(notification)
+        user = notification.user
+        settings = user.settings
+
+        user.active? && notification.account.active? && settings&.bundle_email_period.present?
+      end
+
+      def existing_window_for(notification)
+        user = notification.user
+
+        user.notification_windows.undelivered.chronologically.first ||
+          user.notification_windows.covering(notification.created_at).chronologically.first ||
+          user.notification_windows.covering(Time.current).chronologically.first
+      end
+
+      def open_window_for(notification)
+        user = notification.user
+        starts_at = next_available_starts_at(user)
+
+        user.notification_windows.create!(
+          account: user.account,
+          starts_at: starts_at,
+          ends_at: starts_at + user.settings.bundle_email_period
+        ).tap(&:deliver_later)
+      end
+
+      def next_available_starts_at(user)
+        now = Time.current
+        latest = user.notification_windows.chronologically.last
+
+        if latest && latest.ends_at > now
+          latest.ends_at
+        else
+          now
+        end
+      end
+
+      def assign(notification, window)
+        if notification.window_id != window.id
+          notification.update_column(:window_id, window.id)
+        end
+      end
+  end
+
+  def deliver_later
+    Notification::WindowJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    user.with_lock do
+      reload
+      return if delivered?
+
+      send_email if deliverable?
+      update!(delivered_at: Time.current)
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def overlap?(other)
+    starts_at < other.ends_at && ends_at > other.starts_at
+  end
+
+  def notifications_for_email
+    notifications.unread.preloaded.order(:created_at)
+  end
+
+  private
+    def send_email
+      NotificationMailer.bundle(self).deliver_now
+    end
+
+    def deliverable?
+      user.active? && account.active? && user.settings&.bundle_email_period.present? &&
+        user.identity&.email_address.present? && notifications_for_email.any?
+    end
+
+    def does_not_overlap_another_window
+      if overlapping_windows.exists?
+        errors.add(:base, "overlaps another window")
+      end
+    end
+
+    def overlapping_windows
+      self.class.where(user_id: user_id).where.not(id: id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+    end
+end
