+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def bundle(window)
+    @window = window
+    @user = window.user
+    @notifications = window.notifications_for_email
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    mail to: @user.identity.email_address, subject: bundle_subject
+  end
+
+  private
+    def bundle_subject
+      count = @notifications.size
+      account_name = @window.account.name
+
+      if count == 1
+        @notifications.first.payload.title
+      else
+        "#{count} new notifications in #{account_name}"
+      end
+    end
+end
