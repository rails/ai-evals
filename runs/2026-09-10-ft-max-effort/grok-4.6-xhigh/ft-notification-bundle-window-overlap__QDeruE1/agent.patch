@@ -0,0 +1,27 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "bundle" do
+    notification = Notification.create!(
+      user: @user,
+      source: events(:shipping_published),
+      creator: users(:david)
+    )
+    window = notification.reload.window
+    email = NotificationMailer.bundle(window)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_match "We need to ship the app", email.subject
+    assert_match "Writebook", email.body.encoded
+    assert_match "Notification settings", email.body.encoded
+  end
+end
