+  end
+
+  test "clock starts when the first notification lands" do
+    travel_to @now do
+      window = capture_for(:shipping_published)
+
+      assert_equal @now, window.starts_at
+      assert_equal @now + 4.hours, window.ends_at
+    end
+  end
+
+  test "subsequent notifications join the open window without restarting the clock" do
+    travel_to @now do
+      first = capture_for(:shipping_published)
+
+      travel 1.hour
+      second = capture_for(:text_published)
+
+      assert_equal first, second
+      assert_equal @now, first.reload.starts_at
+      assert_equal @now + 4.hours, first.ends_at
+      assert_equal 1, @user.notification_windows.count
+    end
+  end
+
+  test "late notifications belong in the window that has already opened" do
+    travel_to @now do
+      window = capture_for(:shipping_published)
+
+      travel 5.hours
+
+      late = create_notification(:text_published, created_at: @now + 1.hour)
+
+      assert_equal window, late.reload.window
+      assert_equal 1, @user.notification_windows.count
+    end
+  end
+
+  test "late notifications belong in the covering window even after it was delivered" do
+    travel_to @now do
+      window = capture_for(:shipping_published)
+      window.deliver_now
+
+      travel 5.hours
+
+      late = create_notification(:text_published, created_at: @now + 1.hour)
+
+      assert_equal window, late.reload.window
+      assert_equal 1, @user.notification_windows.count
+    end
+  end
+
+  test "a notification after the window ends opens a non-overlapping window" do
+    travel_to @now do
+      first = capture_for(:shipping_published)
+      first.deliver_now
+
+      travel 5.hours
+      second = capture_for(:text_published)
+
+      assert_not_equal first, second
+      assert second.starts_at >= first.ends_at
+      assert_not first.overlap?(second)
+      assert_equal 2, @user.notification_windows.count
+    end
+  end
+
+  test "nobody should ever end up with two overlapping windows" do
+    travel_to @now do
+      capture_for(:shipping_published)
+
+      overlapping = @user.notification_windows.new(
+        account: @user.account,
+        starts_at: @now + 1.hour,
+        ends_at: @now + 5.hours
+      )
+
+      assert_not overlapping.valid?
+      assert_includes overlapping.errors[:base], "overlaps another window"
+    end
+  end
+
+  test "adjacent windows do not count as overlapping" do
+    travel_to @now do
+      first = capture_for(:shipping_published)
+      first.deliver_now
+
+      travel_to first.ends_at
+      second = capture_for(:text_published)
+
+      assert_equal first.ends_at, second.starts_at
+      assert_not first.overlap?(second)
+    end
+  end
+
+  test "never does not open a window or send email" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Window.count } do
+      assert_no_enqueued_jobs only: Notification::WindowJob do
+        create_notification(:shipping_published)
+      end
+    end
+  end
+
+  test "daily windows last one day" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    travel_to @now do
+      window = capture_for(:shipping_published)
+      assert_equal @now + 1.day, window.ends_at
+    end
+  end
+
+  test "weekly windows last one week" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+
+    travel_to @now do
+      window = capture_for(:shipping_published)
+      assert_equal @now + 1.week, window.ends_at
+    end
+  end
+
+  test "schedules one delivery job when the window opens" do
+    travel_to @now do
+      assert_enqueued_with(job: Notification::WindowJob, at: @now + 4.hours) do
+        capture_for(:shipping_published)
+      end
+
+      assert_no_enqueued_jobs only: Notification::WindowJob do
+        capture_for(:text_published)
+      end
+    end
+  end
+
+  test "sends one email per window" do
+    travel_to @now do
+      capture_for(:shipping_published)
+      capture_for(:text_published)
+      window = @user.notification_windows.first
+
+      assert_emails 1 do
+        window.deliver_now
+      end
+
+      assert window.reload.delivered?
+
+      assert_no_emails do
+        window.deliver_now
+      end
+    end
+  end
+
+  test "does not send an email when every notification in the window has been read" do
+    travel_to @now do
+      notification = create_notification(:shipping_published)
+      notification.read
+      window = notification.reload.window
+
+      assert_no_emails do
+        window.deliver_now
+      end
+
+      assert window.reload.delivered?
+    end
+  end
+
+test "window job sends the digest email" do
+  travel_to @now do
+    capture_for(:shipping_published)
+
+    assert_emails 1 do
+      perform_enqueued_jobs only: Notification::WindowJob
+    end
+  end
+end
+
+  test "windows are isolated per person" do
+    other = users(:david)
+    other.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    travel_to @now do
+      kevin_window = capture_for(:shipping_published)
+      david_window = capture_for(:text_published, user: other)
+
+      assert_not_equal kevin_window, david_window
+      assert_equal @user, kevin_window.user
+      assert_equal other, david_window.user
+    end
+  end
+
+  private
+    def capture_for(event_name, **attributes)
+      create_notification(event_name, **attributes).reload.window
+    end
+
+    def create_notification(event_name, user: @user, creator: users(:david), created_at: Time.current)
+      Notification.create!(
+        user: user,
+        source: events(event_name),
+        creator: creator,
+        created_at: created_at
+      )
+    end
+end
