+<h1 class="title">Your Fizzy notifications</h1>
+<p class="subtitle"><%= pluralize(@notifications.size, "update") %> in <%= @window.account.name %></p>
+
+<% @notifications_by_board.each_with_index do |(board, notifications), index| %>
+  <% if index > 0 %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <div class="notification">
+      <table>
+        <tr>
+          <td class="avatar__container"><%= mail_avatar_tag notification.creator %></td>
+          <td>
+            <p class="card__title"><%= link_to payload.title, payload.url %></p>
+            <p class="notification__details"><%= payload.body %></p>
+            <p class="notification__author"><%= notification.creator.name %></p>
+          </td>
+        </tr>
+      </table>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "Notification settings", notifications_settings_url %>
+  · Need help? <%= mail_to "support@fizzy.do", "Send us an email" %>.
+</p>
