diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..5101ea4
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,88 @@
+# Single-box Kamal deploy for Fizzy.
+#
+# One Linux server, one container: Rails, SQLite, Solid Queue, and SSL from
+# kamal-proxy. Fill in your hostname, mail server, and secrets, then run
+# `kamal setup`. Data lives on a volume so it survives the next deploy.
+#
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (use your-user/fizzy on Docker Hub / GHCR).
+image: fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt (kamal-proxy).
+# Using an SSL proxy like this requires config.assume_ssl and config.force_ssl
+# in production.rb (already on by default).
+#
+# The host must point at this server, and port 443 must be open.
+proxy:
+  ssl: true
+  host: app.example.com
+
+# Where you keep your container images.
+# localhost:5555 is a local registry Kamal starts for you; no Docker Hub account
+# required. Switch to hub.docker.com / ghcr.io / ... if you prefer.
+registry:
+  server: localhost:5555
+
+  # Needed for authenticated registries.
+  # username: your-user
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+  clear:
+    # Run the Solid Queue Supervisor inside Puma so jobs run on this box.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Public hostname, used for mailer links and Host authorization.
+    # Keep in sync with proxy.host above.
+    APP_HOST: app.example.com
+
+    # Mail server (magic-link login is email). Keep the password in .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: you@example.com
+    MAILER_FROM_ADDRESS: "Fizzy <you@example.com>"
+
+    # SQLite-friendly process counts. Raise these if the box has headroom.
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+
+# Aliases are triggered with "bin/kamal <alias>". You can overwrite arguments on invocation:
+# "bin/kamal logs -r job" will tail logs from the first server in the job section.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Persistent volume for SQLite database files and local Active Storage uploads.
+# Recommended to change this to a mounted volume path that is backed up off server.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64
+
+  # # Build image via remote server (useful for faster amd64 builds on arm64 computers)
+  # remote: ssh://docker@docker-builder-server
+
+# Use a different ssh user than root
+# ssh:
+#   user: app
