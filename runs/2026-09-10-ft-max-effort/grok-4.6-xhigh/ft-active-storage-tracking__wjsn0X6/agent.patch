new file mode 100644
index 0000000..2041bcc
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,47 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :recalculate_account_bytes_used_later
+  end
+
+  def recalculate_bytes_used_later
+    Board::BytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    update_column :bytes_used, calculate_bytes_used
+    account.recalculate_bytes_used_now
+  end
+
+  private
+    def calculate_bytes_used
+      ActiveStorage::Blob.where(id: counted_blob_ids).sum(:byte_size)
+    end
+
+    def counted_blob_ids
+      counted_attachments.select(:blob_id)
+    end
+
+    def counted_attachments
+      image_attachments = ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: cards.select(:id))
+      embed_attachments = ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: counted_rich_texts.select(:id))
+
+      ActiveStorage::Attachment.where(id: image_attachments.select(:id))
+        .or(ActiveStorage::Attachment.where(id: embed_attachments.select(:id)))
+    end
+
+    def counted_rich_texts
+      card_texts = ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id))
+      comment_texts = ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards.select(:id)).select(:id))
+      board_texts = ActionText::RichText.where(record_type: "Board", record_id: id)
+
+      ActionText::RichText.where(id: card_texts.select(:id))
+        .or(ActionText::RichText.where(id: comment_texts.select(:id)))
+        .or(ActionText::RichText.where(id: board_texts.select(:id)))
+    end
+
+    def recalculate_account_bytes_used_later
+      account.recalculate_bytes_used_later unless account.destroyed?
+    end
+end
