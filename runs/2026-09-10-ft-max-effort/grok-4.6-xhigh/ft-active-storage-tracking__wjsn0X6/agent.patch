index 0000000..fd6e908
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+  end
+
+  test "bytes_used starts at zero" do
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "bytes_used includes card images on the board" do
+    attach_image_to cards(:logo)
+    attach_image_to create_card_on(@other_board)
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg"), @board.reload.bytes_used
+    assert_equal blob_size("moon.jpg"), @other_board.reload.bytes_used
+  end
+
+  test "bytes_used includes files embedded in the board description" do
+    attach_embed_to @board, :public_description
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg"), @board.reload.bytes_used
+    assert_equal 0, @other_board.reload.bytes_used
+  end
+
+  test "bytes_used includes files embedded in card descriptions and comments" do
+    attach_embed_to cards(:logo), :description
+    attach_embed_to comments(:logo_agreement_jz), :body
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg") * 2, @board.reload.bytes_used
+  end
+
+  test "bytes_used does not include attachments from other boards" do
+    attach_image_to create_card_on(@other_board)
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob_size("moon.jpg"), @other_board.reload.bytes_used
+  end
+
+  test "removing a card image decreases bytes_used" do
+    attach_image_to cards(:logo)
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+    assert_equal blob_size("moon.jpg"), @board.reload.bytes_used
+
+    cards(:logo).image.purge
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "moving a card transfers usage between boards" do
+    card = cards(:logo)
+    attach_image_to card
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg"), @board.reload.bytes_used
+    assert_equal 0, @other_board.reload.bytes_used
+
+    card.move_to(@other_board)
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob_size("moon.jpg"), @other_board.reload.bytes_used
+    assert_equal blob_size("moon.jpg"), @board.account.reload.bytes_used
+  end
+
+  test "destroying a card decreases bytes_used" do
+    attach_image_to cards(:logo)
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    cards(:logo).destroy
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @board.account.reload.bytes_used
+  end
+
+  test "bytes_used is calculated in the background" do
+    attach_image_to cards(:logo)
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_enqueued_with job: Board::BytesUsedJob, args: [ @board ]
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg"), @board.reload.bytes_used
+  end
+
+  test "replacing a card image updates bytes_used" do
+    card = cards(:logo)
+    attach_image_to card
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+    assert_equal blob_size("moon.jpg"), @board.reload.bytes_used
+
+    card.image.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("avatar.png"), @board.reload.bytes_used
+    assert_equal blob_size("avatar.png"), @board.account.reload.bytes_used
+  end
+
+  test "destroying a board removes its usage from the account" do
+    attach_image_to cards(:logo)
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+    assert_equal blob_size("moon.jpg"), @board.account.reload.bytes_used
+
+    @board.destroy
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal 0, accounts(:"37s").reload.bytes_used
+  end
+
+  test "variant files are not counted" do
+    attach_embed_to cards(:logo), :description
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    embed = cards(:logo).description.embeds.sole
+    assert embed.variant(:small).processed?
+
+    assert_equal blob_size("moon.jpg"), @board.reload.bytes_used
+  end
+
+  private
+    def create_card_on(board)
+      board.cards.create!(title: "Secret", status: :published)
+    end
+
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    def attach_embed_to(record, rich_text_name)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+
+      record.public_send(:"#{rich_text_name}=", "See attached")
+      record.save!
+      rich_text = record.public_send(rich_text_name)
+      rich_text.body = ActionText::Content.new(rich_text.body.to_html).append_attachables(blob)
+      record.save!
