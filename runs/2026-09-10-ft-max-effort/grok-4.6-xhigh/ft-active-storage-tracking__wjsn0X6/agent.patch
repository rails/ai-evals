--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+  end
+
+  test "bytes_used starts at zero" do
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "bytes_used includes card images across all boards" do
+    attach_image_to cards(:logo)
+    attach_image_to create_card_on(@other_board)
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg") * 2, @account.reload.bytes_used
+  end
+
+  test "bytes_used includes files embedded in board, card, and comment content" do
+    attach_embed_to @board, :public_description
+    attach_embed_to cards(:logo), :description
+    attach_embed_to comments(:logo_agreement_jz), :body
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg") * 3, @account.reload.bytes_used
+  end
+
+  test "bytes_used does not count avatars or export files" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    Account::Export.create!(account: @account, user: users(:david)).file.attach(
+      io: file_fixture("moon.jpg").open, filename: "export.zip", content_type: "application/zip"
+    )
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "bytes_used is calculated in the background" do
+    attach_image_to cards(:logo)
+
+    assert_equal 0, @account.reload.bytes_used
+    assert_enqueued_jobs 1, only: Board::BytesUsedJob
+
+    perform_enqueued_jobs only: [ Board::BytesUsedJob, Account::BytesUsedJob ]
+
+    assert_equal blob_size("moon.jpg"), @account.reload.bytes_used
+  end
+
+  private
+    def create_card_on(board)
+      board.cards.create!(title: "Secret", status: :published)
+    end
+
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    def attach_embed_to(record, rich_text_name)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+
+      record.public_send(:"#{rich_text_name}=", "See attached")
+      record.save!
+      rich_text = record.public_send(rich_text_name)
+      rich_text.body = ActionText::Content.new(rich_text.body.to_html).append_attachables(blob)
+      record.save!
+    end
+
+    def blob_size(filename)
+      file_fixture(filename).size
+    end
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
