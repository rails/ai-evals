diff --git a/lib/rails_ext/active_storage_bytes_used.rb b/lib/rails_ext/active_storage_bytes_used.rb
new file mode 100644
index 0000000..cd5c8ec
--- /dev/null
+++ b/lib/rails_ext/active_storage_bytes_used.rb
@@ -0,0 +1,54 @@
+# Recalculate account/board storage usage when counted attachments change.
+# Card images and Action Text embeds are counted; avatars, exports, and variants are not.
+#
+# ActiveStorage::Attachment#purge (and purge_later) delete the row without
+# running callbacks, so those paths are wrapped here.
+#
+# Attachments are created inside the parent record's save, so after_create
+# (not after_create_commit) is used. Jobs themselves enqueue after the
+# surrounding transaction commits.
+module ActiveStorageBytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :recalculate_board_bytes_used_later
+    after_destroy :recalculate_board_bytes_used_later
+  end
+
+  private
+    def recalculate_board_bytes_used_later
+      board_for_bytes_used&.recalculate_bytes_used_later
+    end
+
+    def board_for_bytes_used
+      case record
+      when Card
+        record.board
+      when ActionText::RichText
+        case record.record
+        when Board then record.record
+        when Card then record.record.board
+        when Comment then record.record.board
+        end
+      end
+    end
+end
+
+module ActiveStorageBytesUsed::Purge
+  def purge
+    board = board_for_bytes_used
+    super
+    board&.recalculate_bytes_used_later
+  end
+
+  def purge_later
+    board = board_for_bytes_used
+    super
+    board&.recalculate_bytes_used_later
+  end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageBytesUsed
+  prepend ActiveStorageBytesUsed::Purge
+end
