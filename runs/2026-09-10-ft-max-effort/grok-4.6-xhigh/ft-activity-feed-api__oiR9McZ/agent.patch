+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "api particulars for assignment changes include assignee_ids" do
+    event = events(:logo_assignment_jz)
+
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.api_particulars)
+  end
+
+  test "api particulars for board changes include old and new board" do
+    event = events(:logo_published)
+    event.update!(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "A", "new_board" => "B" } })
+
+    assert_equal({ old_board: "A", new_board: "B" }, event.api_particulars)
+  end
+
+  test "api particulars for title changes include old and new title" do
+    event = events(:logo_published)
+    event.update!(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "A", "new_title" => "B" } })
+
+    assert_equal({ old_title: "A", new_title: "B" }, event.api_particulars)
+  end
+
+  test "api particulars for triage events include column" do
+    event = events(:logo_published)
+    event.update!(action: "card_triaged", particulars: { "particulars" => { "column" => "Doing" } })
+
+    assert_equal({ column: "Doing" }, event.api_particulars)
+  end
+
+  test "api particulars return empty strings for missing board title or column values" do
+    event = events(:logo_published)
+
+    event.update!(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, event.api_particulars)
+
+    event.update!(action: "card_title_changed", particulars: {})
+    assert_equal({ old_title: "", new_title: "" }, event.api_particulars)
+
+    event.update!(action: "card_triaged", particulars: {})
+    assert_equal({ column: "" }, event.api_particulars)
+  end
+
+  test "api particulars for other events are empty" do
+    assert_equal({}, events(:logo_published).api_particulars)
+    assert_equal({}, events(:layout_commented).api_particulars)
+  end
+end
