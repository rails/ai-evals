+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,224 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any?
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.map { |activity| Time.iso8601(activity["created_at"]) }
+    assert created_ats.each_cons(2).all? { |a, b| a >= b }
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index as JSON includes event attributes" do
+    event = events(:logo_published)
+
+    get activities_path, as: :json
+
+    activity = find_activity(event)
+    assert_equal event.id, activity["id"]
+    assert_equal "card_published", activity["action"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal ({}), activity["particulars"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+    assert_equal event.eventable.number, activity.dig("eventable", "number")
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.board.name, activity.dig("board", "name")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+    assert_equal event.creator.name, activity.dig("creator", "name")
+  end
+
+  test "index as JSON uses existing card representation for eventable" do
+    get cards_path, as: :json
+    card_json = @response.parsed_body.find { |card| card["id"] == cards(:logo).id }
+
+    get activities_path, as: :json
+    activity = find_activity(events(:logo_published))
+
+    assert_equal card_json, activity["eventable"]
+  end
+
+  test "index as JSON uses existing comment representation for eventable" do
+    comment = comments(:layout_overflowing_david)
+
+    get card_comment_path(comment.card, comment), as: :json
+    comment_json = @response.parsed_body
+
+    get activities_path, as: :json
+    activity = find_activity(events(:layout_commented))
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment_json, activity["eventable"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "index as JSON includes assignment particulars" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path, as: :json
+
+    activity = find_activity(event)
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON includes board change particulars" do
+    event = create_event(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } }
+    )
+
+    get activities_path, as: :json
+
+    activity = find_activity(event)
+    assert_equal "Writebook", activity.dig("particulars", "old_board")
+    assert_equal "Private board", activity.dig("particulars", "new_board")
+  end
+
+  test "index as JSON includes title change particulars" do
+    event = create_event(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+
+    get activities_path, as: :json
+
+    activity = find_activity(event)
+    assert_equal "Old title", activity.dig("particulars", "old_title")
+    assert_equal "New title", activity.dig("particulars", "new_title")
+  end
+
+  test "index as JSON includes triage particulars" do
+    event = create_event(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+
+    get activities_path, as: :json
+
+    activity = find_activity(event)
+    assert_equal "In Progress", activity.dig("particulars", "column")
+  end
+
+  test "index as JSON returns empty strings for missing board title or column particulars" do
+    board_event = create_event(action: "card_board_changed", particulars: {})
+    title_event = create_event(action: "card_title_changed", particulars: {})
+    triage_event = create_event(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    assert_equal "", find_activity(board_event).dig("particulars", "old_board")
+    assert_equal "", find_activity(board_event).dig("particulars", "new_board")
+    assert_equal "", find_activity(title_event).dig("particulars", "old_title")
+    assert_equal "", find_activity(title_event).dig("particulars", "new_title")
+    assert_equal "", find_activity(triage_event).dig("particulars", "column")
+  end
+
+  test "index as JSON includes card_title_changed events" do
+    event = create_event(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "A", "new_title" => "B" } })
+
+    get activities_path, as: :json
+
+    assert_not_nil find_activity(event)
+  end
+
+  test "index as JSON omits deprecated card_collection_changed events" do
+    event = create_event(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_nil find_activity(event)
+  end
+
+  test "index as JSON can filter by creator_ids" do
+    get activities_path, as: :json, params: { creator_ids: [ users(:kevin).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index as JSON can filter by board_ids" do
+    private_event = create_event(board: boards(:private), creator: users(:kevin))
+
+    get activities_path, as: :json, params: { board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+    assert_nil find_activity(private_event)
+  end
+
+  test "index as JSON ignores inaccessible board_ids" do
+    create_event(board: boards(:private), creator: users(:kevin))
+
+    logout_and_sign_in_as :jz
+    get activities_path, as: :json, params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index as JSON includes unassigned particulars" do
+    event = create_event(action: "card_unassigned", particulars: { assignee_ids: [ users(:jz).id ] })
+
+    get activities_path, as: :json
+
+    activity = find_activity(event)
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON only returns activity the current user can access" do
+    private_event = create_event(board: boards(:private), creator: users(:kevin))
+
+    get activities_path, as: :json
+    assert_not_nil find_activity(private_event)
+
+    logout_and_sign_in_as :jz
+
+    get activities_path, as: :json
+    assert_nil find_activity(private_event)
+  end
+
+  test "index as JSON paginates newest first" do
+    20.times do |index|
+      create_event(created_at: index.minutes.ago)
+    end
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_match(/rel="next"/, @response.headers["Link"])
+
+    next_page = next_page_from_link_header(@response.headers["Link"])
+    get next_page, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+
+  private
+    def find_activity(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+
+    def create_event(action: "card_published", board: boards(:writebook), creator: users(:david), eventable: cards(:logo), **attributes)
+      board.events.create!(action:, creator:, eventable:, **attributes)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
