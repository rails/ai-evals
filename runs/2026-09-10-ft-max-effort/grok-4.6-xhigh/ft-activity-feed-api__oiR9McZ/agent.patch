diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..61851a3 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,27 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: nested_particular("old_board"), new_board: nested_particular("new_board") }
+    when "card_title_changed"
+      { old_title: nested_particular("old_title"), new_title: nested_particular("new_title") }
+    when "card_triaged"
+      { column: nested_particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def nested_particular(key)
+      stored = particulars || {}
+      value = stored.dig("particulars", key)
+      value = stored[key] if value.nil?
+      value.to_s
+    end
 end
