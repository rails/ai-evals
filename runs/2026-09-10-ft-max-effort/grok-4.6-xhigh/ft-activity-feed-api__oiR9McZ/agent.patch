@@ -0,0 +1,38 @@
+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  test "activities are newest first and limited to accessible boards" do
+    private_event = boards(:private).events.create!(
+      action: "card_published",
+      creator: users(:kevin),
+      eventable: cards(:logo)
+    )
+    collection_event = boards(:writebook).events.create!(
+      action: "card_collection_changed",
+      creator: users(:david),
+      eventable: cards(:logo)
+    )
+    title_event = boards(:writebook).events.create!(
+      action: "card_title_changed",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: { "particulars" => { "old_title" => "A", "new_title" => "B" } }
+    )
+
+    kevin_ids = users(:kevin).activities.map(&:id)
+    jz_ids = users(:jz).activities.map(&:id)
+
+    assert_includes kevin_ids, private_event.id
+    assert_not_includes jz_ids, private_event.id
+    assert_not_includes kevin_ids, collection_event.id
+    assert_includes kevin_ids, title_event.id
+    assert_equal title_event.id, kevin_ids.first
+  end
+
+  test "activities can be filtered by creator and board" do
+    ids = users(:kevin).activities(creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ]).map(&:id)
+
+    assert_includes ids, events(:text_published).id
+    assert_not_includes ids, events(:logo_published).id
+  end
+end
