diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..6b0be8f 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,8 +25,18 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      Account.includes(:entropy, boards: :entropy).find_each do |account|
+        account.boards.group_by(&:auto_postpone_period).each do |period, boards|
+          system_user = account.system_user
+
+          account.cards.active
+            .where(board_id: boards.map(&:id), last_active_at: ..(now - period))
+            .find_each do |card|
+              card.auto_postpone(user: system_user)
+            end
+        end
       end
     end
   end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..03b8047 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,39 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due respects different board periods in the same account" do
+    private_card = boards(:private).cards.create!(title: "Private task", creator: users(:david), status: :published)
+    private_card.update!(last_active_at: 40.days.ago)
+    cards(:logo).update!(last_active_at: 40.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+    assert private_card.reload.postponed?
+  end
+
+  test "auto postpone all due postpones the same cards as due_to_be_postponed" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    cards(:text).update!(last_active_at: 1.day.from_now - entropies(:writebook_board).auto_postpone_period)
+    cards(:radio).update!(last_active_at: 1.day.ago - entropies(:miltons_wish_list_board).auto_postpone_period)
+
+    due_ids = Card.due_to_be_postponed.pluck(:id)
+    assert_includes due_ids, cards(:logo).id
+    assert_includes due_ids, cards(:radio).id
+    assert_not_includes due_ids, cards(:text).id
+
+    Card.auto_postpone_all_due
+
+    due_ids.each { |id| assert Card.find(id).postponed? }
+    assert_not cards(:text).reload.postponed?
+  end
+
+  test "auto postpone all due does not join entropies to find due cards" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_no_queries_match(/COALESCE\(entropies.auto_postpone_period/) do
+      Card.auto_postpone_all_due
+    end
+  end
 end
