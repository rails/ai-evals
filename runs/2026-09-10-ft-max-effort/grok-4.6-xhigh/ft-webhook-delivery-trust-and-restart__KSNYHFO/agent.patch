 end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..85cdaf5
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,147 @@
+class Webhook::Request
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  Unreachable = Class.new(StandardError)
+
+  def initialize(delivery)
+    @webhook = delivery.webhook
+    @event = delivery.event
+  end
+
+  def perform
+    response = post
+
+    [ request_payload, { code: response.code.to_i } ]
+  rescue Unreachable, SocketError, Errno::ECONNREFUSED, Errno::EHOSTUNREACH,
+      Errno::ENETUNREACH, Errno::ECONNRESET, Errno::ETIMEDOUT, IPAddr::InvalidAddressError
+    [ request_payload, { error: "destination_unreachable" } ]
+  rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Timeout::Error
+    [ request_payload, { error: "timeout" } ]
+  rescue OpenSSL::SSL::SSLError
+    [ request_payload, { error: "ssl_error" } ]
+  end
+
+  private
+    def post
+      raise Unreachable if resolved_ip.blank?
+
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.ipaddr = resolved_ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.write_timeout = OPEN_TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri)
+      headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http.request(request)
+    end
+
+    def request_payload
+      { "headers" => headers }
+    end
+
+    def headers
+      @headers ||= {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => timestamp
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, body)
+    end
+
+    def timestamp
+      @event.created_at.utc.iso8601
+    end
+
+    def content_type
+      if @webhook.for_campfire?
+        "text/plain"
+      else
+        "application/json"
+      end
+    end
+
+    def body
+      @body ||=
+        if @webhook.for_slack?
+          { text: message }.to_json
+        elsif @webhook.for_basecamp?
+          { content: message }.to_json
+        elsif @webhook.for_campfire?
+          message
+        else
+          json_payload
+        end
+    end
+
+    def message
+      [ @event.description_for(@event.creator).to_plain_text, eventable_url ].compact.join("\n")
+    end
+
+    def eventable_url
+      if @event.eventable
+        url_helpers.polymorphic_url(@event.eventable, **url_options)
+      end
+    end
+
+    def json_payload
+      renderer.render(template: "webhooks/event", layout: false, formats: [ :json ], assigns: { event: @event })
+    end
+
+    def renderer
+      options = default_url_options
+      host = options[:host] || "localhost"
+
+      ApplicationController.renderer.new(
+        http_host: host,
+        https: options[:protocol] == "https",
+        script_name: @webhook.account.slug
+      )
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+
+    def url_options
+      default_url_options.merge(script_name: @webhook.account.slug)
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        { host: "localhost" }
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+
+      @resolved_ip =
+        if ip_address?(uri.hostname)
+          SsrfProtection.blocked_address?(uri.hostname) ? nil : uri.hostname
+        else
+          SsrfProtection.resolve_public_ip(uri.hostname)
+        end
+    end
+
+    def ip_address?(host)
+      IPAddr.new(host)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+
+    def uri
+      @uri ||= URI.parse(@webhook.url)
+    end
+end
