   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +49,31 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def perform_request
+      Webhook::Request.new(self).perform
+    rescue StandardError
+      [ { "headers" => {} }, { error: "internal_error" } ]
+    end
+
+    def complete(request_data, response_data)
+      update!(
+        state: response_data[:error].present? ? :errored : :completed,
+        request: request_data,
+        response: response_data
+      )
+    end
+
+    def record_delinquency
+      if succeeded?
+        webhook.record_success
+      else
