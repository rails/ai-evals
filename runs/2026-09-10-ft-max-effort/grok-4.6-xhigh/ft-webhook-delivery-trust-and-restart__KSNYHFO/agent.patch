new file mode 100644
index 0000000..9b1ff8d
--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    stub_dns_resolution(PUBLIC_IP)
+    Current.session = sessions(:david)
+    @webhook = webhooks(:active)
+  end
+
+  test "creating an event POSTs once to subscribed active webhooks" do
+    stub_webhook_post(@webhook.url)
+
+    event = create_published_event
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    assert_requested :post, @webhook.url, times: 1
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request["headers"]["User-Agent"]
+    assert_equal "application/json", delivery.request["headers"]["Content-Type"]
+    assert_equal event.created_at.utc.iso8601, delivery.request["headers"]["X-Webhook-Timestamp"]
+    assert_equal expected_signature(delivery), delivery.request["headers"]["X-Webhook-Signature"]
+  end
+
+  test "does not deliver to inactive webhooks" do
+    @webhook.deactivate
+    stub_webhook_post(@webhook.url)
+
+    create_published_event
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "does not deliver when the webhook is not subscribed to the action" do
+    @webhook.update!(subscribed_actions: [ "comment_created" ])
+    stub_webhook_post(@webhook.url)
+
+    create_published_event
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "relay_now is idempotent for a webhook and event" do
+    stub_webhook_post(@webhook.url)
+    event = events(:layout_commented)
+    @webhook.update!(subscribed_actions: [ "comment_created" ])
+
+    event.relay_now
+    event.relay_now
+    perform_enqueued_jobs
+
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  private
+    def create_published_event
+      boards(:writebook).events.create!(
+        action: "card_published",
+        creator: users(:david),
+        eventable: cards(:logo)
+      )
+    end
+
+    def stub_webhook_post(url, status: 200)
+      stub_request(:post, url).with(ipaddr: PUBLIC_IP).to_return(status: status)
+    end
+
+    def expected_signature(delivery)
+      body = Webhook::Request.new(delivery).send(:body)
+      OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body)
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
