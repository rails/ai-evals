+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "magic_link puts the code in the subject" do
+    email = IdentityMailer.magic_link(email_address: "kevin@37signals.com", code: "ABC123")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "ABC123 is your Fizzy code", email.subject
+  end
+
+  test "magic_link includes the code in html and text parts" do
+    email = IdentityMailer.magic_link(email_address: "kevin@37signals.com", code: "ABC123")
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+    assert_match "ABC123", email.html_part.body.decoded
+    assert_match "ABC123", email.text_part.body.decoded
+  end
+end
