+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,45 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def issue_magic_link_for(email_address)
+      authentication = Identity::EmailAuthentication.issue(email_address)
+      cookies[:pending_authentication_token] = { value: authentication.token, httponly: true, same_site: :lax }
+      @email_code = authentication.code
+    end
+
+    def email_address_from_magic_link_code
+      Identity::EmailAuthentication.authenticate(cookies[:pending_authentication_token], submitted_code)
+    end
+
+    def submitted_code
+      request.request_parameters[:code] || params[:code]
+    end
+
+    def start_session_from_magic_link(identity)
+      cookies.delete(:pending_authentication_token)
+      start_new_session_for identity
+    end
+
+    def respond_to_issued_magic_link(path)
+      respond_to do |format|
+        format.html do
+          if Rails.env.local?
+            redirect_to path, flash: { email_code: @email_code }
+          else
+            redirect_to path
+          end
+        end
+        format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+      end
+    end
+
+    def reject_invalid_magic_link_code(redirect_path)
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to redirect_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+end
