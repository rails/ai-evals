diff --git a/app/models/identity/email_authentication.rb b/app/models/identity/email_authentication.rb
new file mode 100644
index 0000000..e61e030
--- /dev/null
+++ b/app/models/identity/email_authentication.rb
@@ -0,0 +1,66 @@
+class Identity::EmailAuthentication
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  PURPOSE = :email_authentication
+
+  attr_reader :email_address, :code, :token
+
+  class << self
+    def issue(email_address)
+      email_address = email_address.to_s.strip.downcase
+      code = generate_code
+      token = generate_token(email_address, code)
+
+      IdentityMailer.magic_link(email_address: email_address, code: code).deliver_later
+      Rails.logger.info "Verification code for #{email_address}: #{code}"
+
+      new(email_address, code: code, token: token)
+    end
+
+    def authenticate(token, code)
+      if token.present? && code.present?
+        payload = verifier.verify(token, purpose: PURPOSE)
+        payload["email_address"] if valid_digest?(payload["code_digest"], code)
+      end
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def generate_code
+      SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    private
+      def generate_token(email_address, code)
+        verifier.generate(
+          { "email_address" => email_address, "code_digest" => digest(code) },
+          expires_in: EXPIRATION,
+          purpose: PURPOSE
+        )
+      end
+
+      def valid_digest?(code_digest, code)
+        if code_digest.present?
+          ActiveSupport::SecurityUtils.secure_compare(code_digest, digest(code))
+        end
+      end
+
+      def digest(code)
+        OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, normalize_code(code))
+      end
+
+      def normalize_code(code)
+        code.to_s.strip.upcase
+      end
+
+      def verifier
+        Rails.application.message_verifier(PURPOSE)
+      end
+  end
+
+  def initialize(email_address, code: nil, token: nil)
+    @email_address = email_address
+    @code = code
+    @token = token
+  end
+end
