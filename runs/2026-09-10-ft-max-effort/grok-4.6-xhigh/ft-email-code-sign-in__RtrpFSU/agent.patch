diff --git a/test/models/identity/email_authentication_test.rb b/test/models/identity/email_authentication_test.rb
new file mode 100644
index 0000000..1ccf3af
--- /dev/null
+++ b/test/models/identity/email_authentication_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Identity::EmailAuthenticationTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "issue generates a six-character uppercase code" do
+    authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+
+    assert_match /\A[A-Z0-9]{6}\z/, authentication.code
+  end
+
+  test "issue sends an email with the code in the subject" do
+    assert_emails 1 do
+      authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+      email = ActionMailer::Base.deliveries.last
+
+      assert_equal [ "kevin@37signals.com" ], email.to
+      assert_equal "#{authentication.code} is your Fizzy code", email.subject
+      assert_match authentication.code, email.body.encoded
+    end
+  end
+
+  test "issue normalizes the email address" do
+    authentication = Identity::EmailAuthentication.issue("  Kevin@37signals.com  ")
+
+    assert_equal "kevin@37signals.com", authentication.email_address
+  end
+
+  test "authenticate returns the email address for a valid code" do
+    authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+
+    assert_equal "kevin@37signals.com", Identity::EmailAuthentication.authenticate(authentication.token, authentication.code)
+  end
+
+  test "authenticate is case-insensitive" do
+    authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+
+    assert_equal "kevin@37signals.com", Identity::EmailAuthentication.authenticate(authentication.token, authentication.code.downcase)
+  end
+
+  test "authenticate rejects a wrong code" do
+    authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+
+    assert_nil Identity::EmailAuthentication.authenticate(authentication.token, "XXXXXX")
+  end
+
+  test "authenticate rejects a missing token or code" do
+    authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+
+    assert_nil Identity::EmailAuthentication.authenticate(nil, authentication.code)
+    assert_nil Identity::EmailAuthentication.authenticate(authentication.token, nil)
+    assert_nil Identity::EmailAuthentication.authenticate(authentication.token, "")
+  end
+
+  test "authenticate rejects an expired code" do
+    authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+
+    travel 16.minutes do
+      assert_nil Identity::EmailAuthentication.authenticate(authentication.token, authentication.code)
+    end
+  end
+
+  test "authenticate accepts a code within fifteen minutes" do
+    authentication = Identity::EmailAuthentication.issue("kevin@37signals.com")
+
+    travel 14.minutes do
+      assert_equal "kevin@37signals.com", Identity::EmailAuthentication.authenticate(authentication.token, authentication.code)
+    end
+  end
+end
