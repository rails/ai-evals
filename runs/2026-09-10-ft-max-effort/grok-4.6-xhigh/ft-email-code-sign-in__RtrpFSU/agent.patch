+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+    Identity::EmailAuthentication.stubs(:generate_code).returns("ABC123")
+  end
+
+  test "new" do
+    get new_join_magic_link_path(code: @join_code.code, script_name: @account.slug)
+
+    assert_response :success
+    assert_select "input[name=code]"
+  end
+
+  test "create with valid code joins an existing identity" do
+    identity = identities(:jz)
+
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+
+    assert_no_difference -> { Identity.count } do
+      assert_no_difference -> { User.count } do
+        post join_magic_link_path(code: @join_code.code, script_name: @account.slug), params: { code: "ABC123" }
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+  end
+
+  test "create with valid code joins a new identity" do
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newjoiner@example.com" }
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        post join_magic_link_path(code: @join_code.code, script_name: @account.slug), params: { code: "ABC123" }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+  end
+
+  test "create with invalid code" do
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "newjoiner@example.com" }
+    post join_magic_link_path(code: @join_code.code, script_name: @account.slug), params: { code: "XXXXXX" }
+
+    assert_redirected_to new_join_magic_link_path(code: @join_code.code)
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+    assert_not cookies[:session_token].present?
+  end
+end
