+<div id="<%= dom_id(comment, :new_reaction) %>">
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-target="trigger" data-action="reaction#compose" data-controller="tooltip">
+    <%= image_tag "boost-color.svg", alt: "", draggable: false, aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ], id: dom_id(comment, :reaction_form),
+        class: "reaction__form",
+        html: { hidden: true },
+        data: { reaction_target: "form", controller: "form",
+                action: "submit->form#preventEmptySubmit keydown.esc->reaction#cancel turbo:submit-end->reaction#reset" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label" do %>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: Reaction::CONTENT_MAX_LENGTH,
+            required: true, autocomplete: "off", aria: { label: "Reaction" },
+            data: { reaction_target: "input", form_target: "input" } %>
+    <% end %>
+
+    <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false"
+          data-action="click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--plain" data-action="dialog#toggle">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, description| %>
+            <button type="button" class="btn" title="<%= description %>"
+                  data-action="reaction#pick dialog#close"
+                  data-reaction-emoji-param="<%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <button type="submit" class="reaction__submit-btn btn btn--plain">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm</span>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn btn--plain" data-action="reaction#cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
