+++ b/test/models/reaction_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "👍")
+
+    assert_equal "👍", reaction.content
+    assert_equal users(:david), reaction.reacter
+    assert_equal comment, reaction.comment
+    assert_equal comment.account, reaction.account
+    assert_equal comment.card, reaction.card
+  end
+
+  test "strips content" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "  👍  ")
+    assert_equal "👍", reaction.content
+  end
+
+  test "content is required" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: " ")
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content cannot exceed 16 characters" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "a" * 17)
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "content can be 16 characters" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "a" * 16)
+    assert_equal "a" * 16, reaction.content
+  end
+
+  test "creating a reaction does not touch the card" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    assert_no_changes -> { card.reload.updated_at } do
+      comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "creating a reaction broadcasts it to the card" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_turbo_stream_broadcasts comment.card, count: 1 do
+      comment.reactions.create!(content: "🎉")
+    end
+  end
+
+  test "destroying a reaction broadcasts removal to the card" do
+    reaction = reactions(:logo_agreement_kevin_jz_thumbs_up)
+
+    assert_turbo_stream_broadcasts reaction.card, count: 1 do
+      reaction.destroy
+    end
+  end
+end
