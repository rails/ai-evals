+require "test_helper"
+
+class EmojiHelperTest < ActionView::TestCase
+  test "emoji_reaction? is true for emoji-only content" do
+    assert emoji_reaction?("👍")
+    assert emoji_reaction?("🎉")
+    assert emoji_reaction?("💯")
+  end
+
+  test "emoji_reaction? is false when content includes letters or numbers" do
+    assert_not emoji_reaction?("Great 👍")
+    assert_not emoji_reaction?("100")
+    assert_not emoji_reaction?("")
+    assert_not emoji_reaction?(nil)
+  end
+
+  test "reaction_content_tag uses compact classes for emoji-only reactions" do
+    assert_equal %(<span class="txt-small txt-medium">👍</span>), reaction_content_tag("👍")
+    assert_equal %(<span class="txt-small">Great 👍</span>), reaction_content_tag("Great 👍")
+  end
+end
