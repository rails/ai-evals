diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..cf064d0
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,36 @@
+class Reaction < ApplicationRecord
+  CONTENT_MAX_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  validates :content, presence: true, length: { maximum: CONTENT_MAX_LENGTH }
+  normalizes :content, with: -> { it.strip }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  after_create_commit :broadcast_create
+  after_destroy_commit :broadcast_remove
+
+  delegate :card, to: :comment
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+
+  private
+    def broadcast_create
+      if comment
+        broadcast_append_to card, target: [ comment, :reactions_list ],
+          partial: "cards/comments/reactions/reaction", locals: { reaction: self }
+      end
+    end
+
+    def broadcast_remove
+      if comment
+        broadcast_remove_to card
+      end
+    end
+end
