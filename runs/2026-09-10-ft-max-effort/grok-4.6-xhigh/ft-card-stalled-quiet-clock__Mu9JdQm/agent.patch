new file mode 100644
index 0000000..620665e
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,28 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALL_PERIOD.ago && active?
+  end
+
+  def record_burst
+    now = Time.current
+    update!(last_active_at: now, last_burst_at: now)
+  end
+
+  def comment_burst?
+    recent_comments = comments.by_user.where(created_at: comment_burst_window.ago..)
+    recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+  end
+
+  private
+    def comment_burst_window
+      (auto_postpone_period / 3).seconds
+    end
+end
