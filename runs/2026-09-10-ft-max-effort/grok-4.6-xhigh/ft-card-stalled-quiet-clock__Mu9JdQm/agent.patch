diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..7341c81
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "three comments from two people within the window record a burst" do
+    freeze_time
+
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create!(body: "Three", creator: users(:jz))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "three comments from one person do not record a burst" do
+    3.times { @card.comments.create!(body: "Solo", creator: users(:david)) }
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "two comments from two people do not record a burst" do
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    3.times { @card.comments.create!(body: "System", creator: users(:system)) }
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:kevin))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the auto-close period do not record a burst" do
+    boards(:writebook).update! auto_postpone_period: 3.days
+
+    travel_to 2.days.ago do
+      @card.comments.create!(body: "Old one", creator: users(:david))
+      @card.comments.create!(body: "Old two", creator: users(:kevin))
+    end
+
+    @card.comments.create!(body: "New", creator: users(:jz))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "further comments in a burst window keep the burst" do
+    freeze_time
+
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:kevin))
+    @card.comments.create!(body: "Three", creator: users(:jz))
+    assert @card.reload.last_burst_at.present?
+
+    travel 1.hour
+    @card.comments.create!(body: "Four", creator: users(:david))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "assigning someone records a burst" do
+    freeze_time
+
+    @card.toggle_assignment users(:kevin)
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "unassigning resets the burst" do
+    @card.toggle_assignment users(:kevin)
+    assert @card.reload.last_burst_at.present?
+
+    @card.toggle_assignment users(:kevin)
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "reopening records a burst" do
+    freeze_time
+
+    cards(:shipping).reopen
+    assert_equal Time.current, cards(:shipping).reload.last_burst_at
+  end
+
+  test "a burst with no activity for two weeks is stalled" do
+    freeze_time
+
+    @card.toggle_assignment users(:kevin)
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "activity after a burst resets it" do
+    freeze_time
+
+    @card.toggle_assignment users(:kevin)
+    travel 1.week
+    @card.comments.create!(body: "Still here", creator: users(:david))
+    assert_nil @card.reload.last_burst_at
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity on a stalled card resets it" do
+    freeze_time
+
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    @card.comments.create!(body: "Back", creator: users(:david))
+    assert_not @card.reload.stalled?
+    assert_nil @card.last_burst_at
+  end
+
+  test "closed cards are not stalled" do
+    @card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    @card.create_closure! user: users(:david)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "postponed cards are not stalled" do
+    @card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    @card.create_not_now! user: users(:david)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+end
