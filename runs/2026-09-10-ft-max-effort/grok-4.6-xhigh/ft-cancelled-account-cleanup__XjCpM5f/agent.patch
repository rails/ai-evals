diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..47fa747
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently removes accounts cancelled more than 30 days ago" do
+    due = accounts(:initech)
+    due.cancel(initiated_by: users(:mike))
+    due.cancellation.update_columns(created_at: 31.days.ago)
+
+    recent = create_cancelled_account
+    recent.cancellation.update_columns(created_at: 29.days.ago)
+
+    active = accounts(:"37s")
+    due_board_id = boards(:miltons_wish_list).id
+    due_user_id = users(:mike).id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due.id)
+    assert_not Board.exists?(due_board_id)
+    assert_not User.exists?(due_user_id)
+    assert Account.exists?(recent.id)
+    assert Account.exists?(active.id)
+    assert Identity.exists?(identities(:mike).id)
+  end
+
+  test "does nothing when no accounts are due for incineration" do
+    accounts(:initech).cancel(initiated_by: users(:mike))
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  private
+    def create_cancelled_account
+      account = Account.create_with_owner(
+        account: { name: "Recently Cancelled" },
+        owner: { name: "Owner", identity: identities(:david) }
+      )
+      account.cancel(initiated_by: account.users.find_by!(role: :owner))
+      account
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..979a046
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @user = users(:mike)
+  end
+
+  test "incinerate permanently removes a cancelled account after the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    board_id = boards(:miltons_wish_list).id
+    card_id = cards(:radio).id
+    user_id = @user.id
+    identity_id = identities(:mike).id
+    other_account_id = accounts(:"37s").id
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Board.exists?(board_id)
+    assert_not Card.exists?(card_id)
+    assert_not User.exists?(user_id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+
+    assert Identity.exists?(identity_id)
+    assert Account.exists?(other_account_id)
+  end
+
+  test "incinerate does nothing before the grace period elapses" do
+    @account.cancel(initiated_by: @user)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert @account.reload.cancelled?
+  end
+
+  test "incinerate does nothing for an active account" do
+    assert_not @account.cancelled?
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate does nothing if the account was reactivated" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert_not @account.reload.cancelled?
+  end
+
+  test "due_for_incineration scope includes accounts cancelled more than 30 days ago" do
+    due = @account
+    due.cancel(initiated_by: @user)
+    due.cancellation.update_columns(created_at: 31.days.ago)
+
+    recent = accounts(:acme)
+    recent.users.create!(role: :owner, name: "Acme Owner", identity: identities(:david))
+    recent.cancel(initiated_by: recent.users.find_by!(role: :owner))
+    recent.cancellation.update_columns(created_at: 29.days.ago)
+
+    assert_includes Account.due_for_incineration, due
+    assert_not_includes Account.due_for_incineration, recent
+    assert_not_includes Account.due_for_incineration, accounts(:"37s")
+  end
+end
