diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..2c0c273
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,45 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :push_later, on: [ :create, :update ]
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if should_push?
+  end
+
+  def push
+    return unless should_push?
+
+    payload = push_payload
+    user.push_subscriptions.find_each { |subscription| subscription.deliver(payload) }
+  end
+
+  def push_payload
+    {
+      title: title,
+      body: body,
+      path: Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+    }
+  end
+
+  def title
+    case source
+    when Event then ApplicationController.helpers.event_notification_title(source)
+    when Mention then "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def body
+    case source
+    when Event then ApplicationController.helpers.event_notification_body(source)
+    when Mention then source.source.mentionable_content.truncate(200)
+    end
+  end
+
+  private
+    def should_push?
+      !read? && user.push_subscriptions.any?
+    end
+end
