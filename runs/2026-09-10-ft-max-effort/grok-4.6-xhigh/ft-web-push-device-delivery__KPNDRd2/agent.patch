diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..7b8eb1d
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @params = {
+      push_subscription: {
+        endpoint: "https://push.example.com/david",
+        p256dh_key: "p256dh",
+        auth_key: "auth"
+      }
+    }
+  end
+
+  test "create stores a subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @params
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/david", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create as JSON with nested params" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @params, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        endpoint: "https://push.example.com/flat",
+        p256dh_key: "p256dh",
+        auth_key: "auth"
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "https://push.example.com/flat", @user.push_subscriptions.last.endpoint
+  end
+
+  test "create updates an existing subscription with the same endpoint" do
+    Push::Subscription.store(@user, @params[:push_subscription])
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: @params[:push_subscription].merge(p256dh_key: "rotated")
+      }
+    end
+
+    assert_response :created
+    assert_equal "rotated", @user.push_subscriptions.find_by(endpoint: "https://push.example.com/david").p256dh_key
+  end
+
+  test "create reassigns an endpoint from another user" do
+    Push::Subscription.store(users(:kevin), @params[:push_subscription])
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: @params
+    end
+
+    assert_response :created
+    assert_equal @user, Push::Subscription.find_by(endpoint: "https://push.example.com/david").user
+    assert_not users(:kevin).push_subscriptions.exists?
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: @params
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the subscription for this device" do
+    Push::Subscription.store(@user, @params[:push_subscription])
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://push.example.com/david" } }
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy as JSON" do
+    Push::Subscription.store(@user, @params[:push_subscription])
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://push.example.com/david" } }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for another user" do
+    Push::Subscription.store(users(:kevin), {
+      endpoint: "https://push.example.com/kevin",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    })
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscriptions_path(users(:kevin)), params: { push_subscription: { endpoint: "https://push.example.com/kevin" } }
+    end
+
+    assert_response :forbidden
+  end
+end
