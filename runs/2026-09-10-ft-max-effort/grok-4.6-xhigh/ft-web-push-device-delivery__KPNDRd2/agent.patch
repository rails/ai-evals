new file mode 100644
index 0000000..c71efa3
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,45 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_account
+
+  class << self
+    def store(user, attributes)
+      attributes = attributes.to_h.symbolize_keys
+
+      find_or_initialize_by(endpoint: attributes[:endpoint]).tap do |subscription|
+        subscription.update!(user: user, p256dh_key: attributes[:p256dh_key], auth_key: attributes[:auth_key])
+      end
+    end
+  end
+
+  def deliver(payload)
+    return if Rails.configuration.x.vapid.public_key.blank?
+
+    WebPush.payload_send(
+      message: JSON.generate(payload),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def set_account
+      self.account = user.account
+    end
+
+    def vapid
+      {
+        subject: Rails.configuration.x.vapid.subject,
+        public_key: Rails.configuration.x.vapid.public_key,
+        private_key: Rails.configuration.x.vapid.private_key
+      }
+    end
+end
