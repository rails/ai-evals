diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..d79947b
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @attributes = {
+      endpoint: "https://push.example.com/david",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    }
+  end
+
+  test "store creates a subscription for the user" do
+    subscription = Push::Subscription.store(@user, @attributes)
+
+    assert_equal @user, subscription.user
+    assert_equal @user.account, subscription.account
+    assert_equal "https://push.example.com/david", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+  end
+
+  test "store updates keys when the endpoint already exists" do
+    Push::Subscription.store(@user, @attributes)
+
+    subscription = assert_no_difference -> { Push::Subscription.count } do
+      Push::Subscription.store(@user, @attributes.merge(p256dh_key: "new-p256dh", auth_key: "new-auth"))
+    end
+
+    assert_equal "new-p256dh", subscription.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+  test "deliver sends a web push payload" do
+    subscription = Push::Subscription.store(@user, @attributes)
+    payload = { title: "The logo isn't big enough", body: "Assigned to Kevin", path: "/cards/1" }
+
+    WebPush.expects(:payload_send).with do |args|
+      args[:message] == JSON.generate(payload) &&
+        args[:endpoint] == subscription.endpoint &&
+        args[:p256dh] == "p256dh" &&
+        args[:auth] == "auth" &&
+        args[:vapid][:public_key] == Rails.configuration.x.vapid.public_key &&
+        args[:vapid][:private_key] == Rails.configuration.x.vapid.private_key
+    end
+
+    subscription.deliver(payload)
+  end
+
+  test "deliver destroys expired subscriptions" do
+    subscription = Push::Subscription.store(@user, @attributes)
+    WebPush.stubs(:payload_send).raises(expired_subscription_error)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.deliver(title: "Gone")
+    end
+  end
+
+  test "deliver destroys invalid subscriptions" do
+    subscription = Push::Subscription.store(@user, @attributes)
+    WebPush.stubs(:payload_send).raises(invalid_subscription_error)
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.deliver(title: "Gone")
+    end
+  end
+
+  test "deliver is a no-op without vapid keys" do
+    subscription = Push::Subscription.store(@user, @attributes)
+    Rails.configuration.x.vapid.stubs(:public_key).returns(nil)
+    WebPush.expects(:payload_send).never
+
+    subscription.deliver(title: "Nope")
+  end
+
+  private
+    def expired_subscription_error
+      WebPush::ExpiredSubscription.new(stub(body: "", inspect: "410 Gone"), "push.example.com")
+    end
+
+    def invalid_subscription_error
+      WebPush::InvalidSubscription.new(stub(body: "", inspect: "404 Not Found"), "push.example.com")
+    end
+end
