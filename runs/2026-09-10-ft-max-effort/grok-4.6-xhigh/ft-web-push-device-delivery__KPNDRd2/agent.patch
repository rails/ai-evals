diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..aed0f5e
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,133 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+  static targets = [ "details" ]
+
+  async connect() {
+    this.#hideDetails()
+
+    if (!this.#supported) return
+
+    switch (Notification.permission) {
+      case "granted":
+        if (await this.#existingSubscription()) this.#showOn()
+        break
+      case "denied":
+        this.#showDetails()
+        break
+    }
+  }
+
+  async enable() {
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      switch (permission) {
+        case "granted":
+          await this.#subscribe()
+          this.#showOn()
+          this.#hideDetails()
+          break
+        case "denied":
+          this.#showDetails()
+          break
+      }
+    } catch {
+      this.#showDetails()
+    }
+  }
+
+  async disable() {
+    const subscription = await this.#existingSubscription()
+
+    if (subscription) {
+      await this.#deleteOnServer(subscription)
+      await subscription.unsubscribe()
+    }
+
+    this.#showOff()
+  }
+
+  async #subscribe() {
+    const registration = await this.#serviceWorkerRegistration
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    await this.#postToServer(subscription)
+  }
+
+  #postToServer(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    return post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      }
+    })
+  }
+
+  #deleteOnServer(subscription) {
+    return destroy(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint
+        }
+      }
+    })
+  }
+
+  async #existingSubscription() {
+    const registration = await this.#serviceWorkerRegistration
+    return registration.pushManager.getSubscription()
+  }
+
+  #showOn() {
+    this.element.classList.add("notifications--on")
+  }
+
+  #showOff() {
+    this.element.classList.remove("notifications--on")
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(details => details.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => details.hidden = true)
+  }
+
+  get #supported() {
+    return this.vapidPublicKeyValue && "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  get #serviceWorkerRegistration() {
+    return navigator.serviceWorker.ready
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
