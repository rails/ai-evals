+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel borderless center margin pad txt-align-start">
+  <%= form_with url: search_path, method: :get, class: "flex gap margin-block-end" do %>
+    <%= search_field_tag :q, @query, class: "input", placeholder: "Search cards…", autofocus: true, autocomplete: "off", autocorrect: "off" %>
+    <button type="submit" class="btn">
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    </button>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div class="search__results">
+        <% @cards.each do |card| %>
+          <%= render "searches/result", card: card %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards match this search</div>
+    <% end %>
+  <% end %>
+</section>
