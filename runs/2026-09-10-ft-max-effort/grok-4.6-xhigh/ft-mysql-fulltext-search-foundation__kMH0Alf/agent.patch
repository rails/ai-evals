+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,19 @@
+module SearchesHelper
+  def highlighted_search_text(text)
+    highlight(text.to_s, search_terms)
+  end
+
+  def matching_search_comments(card)
+    card.comments.select { |comment| matches_search?(comment.body.to_plain_text) }
+  end
+
+  private
+    def matches_search?(text)
+      search_terms.any? { |term| text.match?(/#{Regexp.escape(term)}/i) }
+    end
+
+    def search_terms
+      query = params[:q].to_s.strip
+      [ query, *query.split ].uniq.compact_blank
+    end
+end
