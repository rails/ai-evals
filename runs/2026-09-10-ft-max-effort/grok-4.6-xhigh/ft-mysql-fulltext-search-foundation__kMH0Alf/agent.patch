+<article class="search__result" id="<%= dom_id(card) %>">
+  <h2 class="search__title txt-medium">
+    <%= link_to card_path(card) do %>
+      <%= highlighted_search_text card.title %>
+    <% end %>
+  </h2>
+
+  <p class="search__board txt-small txt-subtle"><%= card.board.name %></p>
