diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..082e042
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title, newest first, and wraps matches in mark" do
+    older = create_published_card title: "Ancient quetzalcoatl sighting", created_at: 3.days.ago
+    newer = create_published_card title: "Fresh quetzalcoatl sighting", created_at: 1.hour.ago
+
+    get search_path(q: "quetzalcoatl")
+    assert_response :success
+
+    assert_select "article.search__result", count: 2
+    assert_select "article.search__result:nth-of-type(1)", text: /Fresh quetzalcoatl sighting/
+    assert_select "article.search__result:nth-of-type(2)", text: /Ancient quetzalcoatl sighting/
+    assert_select "mark", text: "quetzalcoatl"
+    assert_includes response.body, card_path(newer)
+    assert_includes response.body, card_path(older)
+  end
+
+  test "finds cards by description" do
+    card = create_published_card title: "Unrelated title"
+    card.update! description: "Look for the quetzalcoatl in the mural"
+
+    get search_path(q: "quetzalcoatl")
+    assert_response :success
+
+    assert_select "article.search__result", text: /Unrelated title/
+    assert_select "mark", text: "quetzalcoatl"
+  end
+
+  test "finds cards by comment body" do
+    card = create_published_card title: "Unrelated title"
+    card.comments.create!(body: "I spotted a quetzalcoatl nearby", creator: users(:kevin))
+
+    get search_path(q: "quetzalcoatl")
+    assert_response :success
+
+    assert_select "article.search__result", text: /Unrelated title/
+    assert_select "mark", text: "quetzalcoatl"
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(
+        title: "Secret quetzalcoatl",
+        status: :published,
+        creator: users(:kevin)
+      )
+    end
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "quetzalcoatl")
+    assert_response :success
+    assert_select "article.search__result", count: 0
+    assert_no_match "Secret quetzalcoatl", response.body
+  end
+
+  test "does not return draft cards" do
+    create_published_card title: "Published quetzalcoatl"
+    boards(:writebook).cards.create!(
+      title: "Draft quetzalcoatl",
+      status: :drafted,
+      creator: users(:kevin)
+    )
+
+    get search_path(q: "quetzalcoatl")
+    assert_response :success
+    assert_select "article.search__result", count: 1
+    assert_select "article.search__result", text: /Published quetzalcoatl/
+    assert_no_match "Draft quetzalcoatl", response.body
+  end
+
+  test "does not return comments on draft cards" do
+    card = create_published_card title: "Will be drafted"
+    card.comments.create!(body: "Hidden quetzalcoatl comment", creator: users(:kevin))
+    card.update_column :status, "drafted"
+
+    get search_path(q: "quetzalcoatl")
+    assert_response :success
+    assert_select "article.search__result", count: 0
+    assert_no_match "Hidden quetzalcoatl comment", response.body
+  end
+
+  test "empty query shows no results" do
+    create_published_card title: "Anything"
+
+    get search_path(q: "")
+    assert_response :success
+    assert_select "article.search__result", count: 0
+  end
+
+  test "a card matching several fields appears once" do
+    card = create_published_card title: "quetzalcoatl title"
+    card.update! description: "quetzalcoatl description"
+    card.comments.create!(body: "quetzalcoatl comment", creator: users(:kevin))
+
+    get search_path(q: "quetzalcoatl")
+    assert_response :success
+    assert_select "article.search__result", count: 1
+  end
+
+  test "escapes LIKE wildcards in the query" do
+    create_published_card title: "100 percent sure"
+    create_published_card title: "100% sure"
+
+    get search_path(q: "100%")
+    assert_response :success
+    assert_select "article.search__result", count: 1
+    assert_select "article.search__result", text: /100% sure/
+  end
+
+  test "finds fixture cards by title case-insensitively" do
+    get search_path(q: "LOGO")
+    assert_response :success
+    assert_select "article.search__result", text: /The logo isn't big enough/
+    assert_select "mark", text: "logo"
+  end
+
+  test "finds fixture cards by comment body" do
+    get search_path(q: "overflowing")
+    assert_response :success
+    assert_select "article.search__result", text: /Layout is broken/
+    assert_select "mark", text: "overflowing"
+  end
+
+  private
+    def create_published_card(title:, created_at: Time.current)
+      with_current_user(:kevin) do
+        boards(:writebook).cards.create!(
+          title: title,
+          status: :published,
+          creator: users(:kevin),
+          created_at: created_at
+        )
+      end
+    end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..15f7aac
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "matching finds cards by title, description, or comment body" do
+    by_title = boards(:writebook).cards.create!(title: "Contains quetzalcoatl", status: :published, creator: users(:kevin))
+    by_description = boards(:writebook).cards.create!(title: "Plain title", status: :published, creator: users(:kevin), description: "Mentions quetzalcoatl")
+    by_comment = boards(:writebook).cards.create!(title: "Another title", status: :published, creator: users(:kevin))
+    by_comment.comments.create!(body: "Saw a quetzalcoatl", creator: users(:kevin))
+    boards(:writebook).cards.create!(title: "No match", status: :published, creator: users(:kevin))
+
+    assert_equal [ by_title, by_description, by_comment ].sort_by(&:id), Card.matching("quetzalcoatl").sort_by(&:id)
+  end
+
+  test "matching returns a card only once when several fields match" do
+    card = boards(:writebook).cards.create!(title: "quetzalcoatl title", status: :published, creator: users(:kevin), description: "quetzalcoatl description")
+    card.comments.create!(body: "quetzalcoatl comment", creator: users(:kevin))
+
+    assert_equal [ card ], Card.matching("quetzalcoatl")
+  end
+
+  test "matching is blank-safe" do
+    assert_empty Card.matching("")
+    assert_empty Card.matching(nil)
+  end
+end
