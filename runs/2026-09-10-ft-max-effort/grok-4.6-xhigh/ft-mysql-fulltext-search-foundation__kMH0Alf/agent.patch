+    <p class="search__description"><%= highlighted_search_text card.description.to_plain_text %></p>
+  <% end %>
+
+  <% matching_search_comments(card).each do |comment| %>
+    <p class="search__comment txt-small"><%= highlighted_search_text comment.body.to_plain_text %></p>
