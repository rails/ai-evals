@@ -0,0 +1,20 @@
+class SearchesController < ApplicationController
+  def show
+    @query = query_param
+    @cards = search_results
+  end
+
+  private
+    def query_param
+      params[:q].to_s.strip
+    end
+
+    def search_results
+      Current.user.accessible_cards
+        .published
+        .matching(@query)
+        .reverse_chronologically
+        .preload(:board, comments: :rich_text_body)
+        .with_rich_text_description
+    end
+end
