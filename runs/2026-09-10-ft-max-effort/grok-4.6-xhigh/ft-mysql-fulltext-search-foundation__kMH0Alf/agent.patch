diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..4395bb9
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,27 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def matching(query)
+      if query.present?
+        pattern = "%#{sanitize_sql_like(query)}%"
+        where(id: matching_ids_for(pattern))
+      else
+        none
+      end
+    end
+
+    private
+      def matching_ids_for(pattern)
+        title_ids = Card.where(*like_clause("title", pattern)).select(:id)
+        description_ids = ActionText::RichText.where(record_type: "Card", name: "description").where(*like_clause("body", pattern)).select(:record_id)
+        comment_ids = Comment.joins(:rich_text_body).where(*like_clause("action_text_rich_texts.body", pattern)).select(:card_id)
+
+        Card.where(id: title_ids).or(Card.where(id: description_ids)).or(Card.where(id: comment_ids)).select(:id)
+      end
+
+      def like_clause(column, pattern)
+        [ "#{column} LIKE ? ESCAPE ?", pattern, "\\" ]
+      end
+  end
+end
