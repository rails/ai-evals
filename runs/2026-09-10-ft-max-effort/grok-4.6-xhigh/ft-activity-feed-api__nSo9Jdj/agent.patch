@@ -0,0 +1,243 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of accessible activity newest first" do
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body
+    assert_kind_of Array, json
+    assert json.any?
+
+    expected_ids = users(:kevin).activities.limit(json.size).map(&:id)
+    assert_equal expected_ids, json.map { |event| event["id"] }
+  end
+
+  test "index as JSON includes the documented event fields" do
+    event = events(:logo_published)
+
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal event.id, json["id"]
+    assert_equal "card_published", json["action"]
+    assert_equal event.created_at.utc.as_json, json["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, json["description"]
+    assert_equal({}, json["particulars"])
+    assert_equal polymorphic_url(event), json["url"]
+    assert_equal "Card", json["eventable_type"]
+    assert_equal event.eventable.id, json.dig("eventable", "id")
+    assert_equal event.eventable.title, json.dig("eventable", "title")
+    assert_equal event.board.id, json.dig("board", "id")
+    assert_equal event.creator.id, json.dig("creator", "id")
+  end
+
+test "index as JSON returns the current user plain-text description" do
+  event = events(:logo_assignment_km)
+
+  get activities_path, as: :json
+  json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+  assert_equal event.description_for(users(:kevin)).to_plain_text, json["description"]
+  assert_includes json["description"], "will handle"
+  assert_no_match(/</, json["description"])
+end
+
+test "index as JSON uses the card URL for card events" do
+    event = events(:logo_published)
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal card_url(cards(:logo)), json["url"]
+  end
+
+  test "index as JSON uses the card URL with comment anchor for comment events" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", json["eventable_type"]
+    assert_equal comment.id, json.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), json["url"]
+  end
+
+  test "index as JSON includes assignment particulars" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal [ users(:jz).id ], json.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON includes unassigned assignee_ids" do
+    event = events(:logo_assignment_jz)
+    event.update_column(:action, "card_unassigned")
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal [ users(:jz).id ], json.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON includes board change particulars" do
+    event = create_activity_event(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } }
+    )
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Writebook", json.dig("particulars", "old_board")
+    assert_equal "Private board", json.dig("particulars", "new_board")
+  end
+
+  test "index as JSON includes title change events and particulars" do
+    event = create_activity_event(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert json.present?, "title change events should be included"
+    assert_equal "Old title", json.dig("particulars", "old_title")
+    assert_equal "New title", json.dig("particulars", "new_title")
+  end
+
+  test "index as JSON includes triage particulars" do
+    event = create_activity_event(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In progress" } }
+    )
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "In progress", json.dig("particulars", "column")
+  end
+
+  test "index as JSON returns empty strings for missing board title and column particulars" do
+    board_event = create_activity_event(action: "card_board_changed", particulars: {})
+    title_event = create_activity_event(action: "card_title_changed", particulars: {})
+    triage_event = create_activity_event(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+    json = @response.parsed_body.index_by { |item| item["id"] }
+
+    assert_equal "", json.dig(board_event.id, "particulars", "old_board")
+    assert_equal "", json.dig(board_event.id, "particulars", "new_board")
+    assert_equal "", json.dig(title_event.id, "particulars", "old_title")
+    assert_equal "", json.dig(title_event.id, "particulars", "new_title")
+    assert_equal "", json.dig(triage_event.id, "particulars", "column")
+  end
+
+  test "index as JSON omits deprecated card_collection_changed events" do
+    event = create_activity_event(action: "card_collection_changed")
+
+    get activities_path, as: :json
+    ids = @response.parsed_body.map { |item| item["id"] }
+
+    assert_not_includes ids, event.id
+  end
+
+  test "index as JSON can filter by creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+
+    creator_ids = @response.parsed_body.map { |item| item.dig("creator", "id") }.uniq
+    assert_equal [ users(:kevin).id ], creator_ids
+  end
+
+  test "index as JSON can OR multiple creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id, users(:david).id ] }, as: :json
+    assert_response :success
+
+    creator_ids = @response.parsed_body.map { |item| item.dig("creator", "id") }.uniq.sort
+    assert_equal [ users(:david).id, users(:kevin).id ].sort, creator_ids
+  end
+
+  test "index as JSON can filter by board_ids" do
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+    assert_response :success
+
+    board_ids = @response.parsed_body.map { |item| item.dig("board", "id") }.uniq
+    assert_equal [ boards(:writebook).id ], board_ids
+  end
+
+  test "index as JSON does not return activity from inaccessible boards" do
+    event = create_activity_event(board: boards(:private), creator: users(:kevin))
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.map { |item| item["id"] }, event.id
+
+    logout_and_sign_in_as :jz
+    get activities_path, as: :json
+    assert_not_includes @response.parsed_body.map { |item| item["id"] }, event.id
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_empty @response.parsed_body
+  end
+
+test "index as JSON omits events not shown in the HTML timeline besides title changes" do
+  event = create_activity_event(action: "card_resumed")
+
+  get activities_path, as: :json
+  ids = @response.parsed_body.map { |item| item["id"] }
+
+  assert_not_includes ids, event.id
+end
+
+test "index as JSON can filter a private board the user can access" do
+  event = create_activity_event(board: boards(:private), creator: users(:kevin))
+
+  get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+  ids = @response.parsed_body.map { |item| item["id"] }
+
+  assert_includes ids, event.id
+  assert ids.all? { |id| Event.find(id).board_id == boards(:private).id }
+end
+
+test "index as JSON paginates newest first" do
+    20.times do |index|
+      create_activity_event(created_at: index.minutes.ago)
+    end
+
+    expected_ids = users(:kevin).activities.map(&:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |item| item["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def create_activity_event(action: "card_published", board: boards(:writebook), creator: users(:david), eventable: cards(:logo), particulars: {}, created_at: Time.current)
+      board.events.create!(action:, creator:, eventable:, particulars:, created_at:)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
