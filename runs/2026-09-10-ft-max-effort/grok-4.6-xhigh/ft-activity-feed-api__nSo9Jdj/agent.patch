@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "activity particulars for assignment changes include assignee_ids" do
+    event = events(:logo_assignment_jz)
+
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.activity_particulars)
+  end
+
+  test "activity particulars for board changes include old and new board names" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } })
+
+    assert_equal({ old_board: "Writebook", new_board: "Private board" }, event.activity_particulars)
+  end
+
+  test "activity particulars for title changes include old and new titles" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    assert_equal({ old_title: "Old", new_title: "New" }, event.activity_particulars)
+  end
+
+  test "activity particulars for triage events include the column" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+
+    assert_equal({ column: "In progress" }, event.activity_particulars)
+  end
+
+  test "activity particulars return empty strings for missing board title and column values" do
+    event = events(:logo_published)
+
+    event.update_columns(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, event.activity_particulars)
+
+    event.update_columns(action: "card_title_changed", particulars: {})
+    assert_equal({ old_title: "", new_title: "" }, event.activity_particulars)
+
+    event.update_columns(action: "card_triaged", particulars: {})
+    assert_equal({ column: "" }, event.activity_particulars)
+  end
+
+  test "activity particulars read nested values stored with symbol keys" do
+    event = events(:logo_published)
+    event.action = "card_title_changed"
+    event.particulars = { particulars: { old_title: "Before", new_title: "After" } }
+
+    assert_equal({ old_title: "Before", new_title: "After" }, event.activity_particulars)
+  end
+
+  test "other events return an empty particulars object" do
+    assert_equal({}, events(:logo_published).activity_particulars)
+    assert_equal({}, events(:layout_commented).activity_particulars)
+    assert_equal({}, events(:shipping_closed).activity_particulars)
+  end
+end
diff --git a/test/models/user/timelined_test.rb b/test/models/user/timelined_test.rb
