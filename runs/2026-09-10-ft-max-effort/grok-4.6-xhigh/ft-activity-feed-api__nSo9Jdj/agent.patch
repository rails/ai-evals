@@ -0,0 +1,43 @@
+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  test "activities include title changes and exclude deprecated collection changes" do
+    collection_changed = boards(:writebook).events.create!(
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_collection_changed"
+    )
+    title_changed = boards(:writebook).events.create!(
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old", new_title: "New" } }
+    )
+
+    activity_ids = users(:kevin).activities.map(&:id)
+
+    assert_includes activity_ids, title_changed.id
+    assert_not_includes activity_ids, collection_changed.id
+  end
+
+  test "activities can be filtered by creator and board" do
+    kevin_events = users(:kevin).activities(creator_ids: [ users(:kevin).id ])
+    assert kevin_events.any?
+    assert kevin_events.all? { |event| event.creator_id == users(:kevin).id }
+
