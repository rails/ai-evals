diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..35e5256
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,62 @@
+class Account::Plan
+  attr_reader :key, :name, :card_limit, :storage_limit, :price_cents, :stripe_price_env
+
+  def initialize(key:, name:, card_limit:, storage_limit:, price_cents:, stripe_price_env: nil)
+    @key = key
+    @name = name
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_cents = price_cents
+    @stripe_price_env = stripe_price_env
+  end
+
+  FREE = new(
+    key: "free",
+    name: "Free",
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte,
+    price_cents: 0
+  )
+
+  UNLIMITED = new(
+    key: "unlimited",
+    name: "Unlimited",
+    card_limit: nil,
+    storage_limit: 5.gigabytes,
+    price_cents: 20_00,
+    stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+  )
+
+  UNLIMITED_PLUS = new(
+    key: "unlimited_plus",
+    name: "Unlimited+",
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    price_cents: 25_00,
+    stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+  )
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].index_by(&:key).freeze
+
+  class << self
+    def for(key)
+      ALL[key.to_s] || FREE
+    end
+
+    def for_stripe_price_id(price_id)
+      ALL.values.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+    end
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env] if stripe_price_env
+  end
+
+  def free?
+    key == FREE.key
+  end
+
+  def paid?
+    !free?
+  end
+end
