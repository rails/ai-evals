+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start"><%= @account.name %></h2>
+    </header>
+
+    <div class="flex flex-column gap margin-block-half">
+      <div>
+        Plan: <strong><%= @account.billing_plan.name %></strong>
+        <% if @account.comped? %>
+          (Comped)
+        <% end %>
+      </div>
+      <div>Card count: <%= number_with_delimiter(@account.billing_card_count) %></div>
+      <div>Bytes used: <%= number_with_delimiter(@account.bytes_used) %></div>
+    </div>
+
+    <div class="flex gap margin-block-half">
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+    </div>
+
+    <%= form_with url: saas.admin_account_overridden_limit_path(@account), class: "flex flex-column gap-half margin-block-half" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, class: "input", value: @account.overridden_limit&.card_count %>
+      </div>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, class: "input", value: @account.overridden_limit&.bytes_used %>
+      </div>
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn" %>
+  </div>
+</section>
