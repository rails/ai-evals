diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..40451bc
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,129 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  def active?
+    ACTIVE_STATUSES.include?(status)
+  end
+
+  class << self
+    def sync_from_stripe_event(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        upsert_from_stripe_subscription(event.data.object)
+      when "checkout.session.completed"
+        upsert_from_checkout_session(event.data.object)
+      end
+    end
+
+    private
+      def upsert_from_stripe_subscription(stripe_sub)
+        account = find_account_for_subscription(stripe_sub)
+        return unless account
+
+        plan = plan_from_stripe_subscription(stripe_sub)
+
+        find_or_initialize_by(account: account).update!(
+          stripe_customer_id: customer_id_from(stripe_value(stripe_sub, :customer)),
+          stripe_subscription_id: stripe_value(stripe_sub, :id),
+          status: stripe_value(stripe_sub, :status),
+          plan_key: plan.key,
+          current_period_end: period_end_from(stripe_sub),
+          cancel_at: time_from(stripe_value(stripe_sub, :cancel_at)),
+          next_amount_due_in_cents: plan.price_cents
+        )
+      end
+
+      def upsert_from_checkout_session(session)
+        subscription_id = id_from(stripe_value(session, :subscription))
+        return if subscription_id.blank?
+
+        account = find_account_for_checkout(session)
+        return unless account
+
+        record = find_or_initialize_by(account: account)
+        attrs = {
+          stripe_customer_id: customer_id_from(stripe_value(session, :customer)),
+          stripe_subscription_id: subscription_id
+        }
+        attrs[:status] = "active" if record.status.blank?
+        attrs[:plan_key] = metadata_value(session, "plan_key").presence || Account::Plan::UNLIMITED.key if record.plan_key.blank?
+        record.update!(attrs)
+      end
+
+      def find_account_for_subscription(stripe_sub)
+        account_id = metadata_value(stripe_sub, "account_id")
+
+        Account.find_by(id: account_id) ||
+          find_by(stripe_subscription_id: stripe_value(stripe_sub, :id))&.account ||
+          find_by(stripe_customer_id: customer_id_from(stripe_value(stripe_sub, :customer)))&.account
+      end
+
+      def find_account_for_checkout(session)
+        Account.find_by(id: stripe_value(session, :client_reference_id)) ||
+          Account.find_by(id: metadata_value(session, "account_id"))
+      end
+
+      def plan_from_stripe_subscription(stripe_sub)
+        price_ids = price_ids_from(stripe_sub)
+        matched = price_ids.filter_map { |price_id| Account::Plan.for_stripe_price_id(price_id) }
+        metadata_key = metadata_value(stripe_sub, "plan_key")
+
+        matched.find { |plan| plan == Account::Plan::UNLIMITED_PLUS } ||
+          matched.first ||
+          (metadata_key.present? ? Account::Plan.for(metadata_key) : Account::Plan::UNLIMITED)
+      end
+
+      def price_ids_from(stripe_sub)
+        items = stripe_value(stripe_sub, :items)
+        data = items.respond_to?(:data) ? items.data : Array(items)
+        data.filter_map { |item| stripe_value(stripe_value(item, :price), :id) }
+      rescue
+        []
+      end
+
+      def period_end_from(stripe_sub)
+        timestamp = stripe_value(stripe_sub, :current_period_end)
+        if timestamp.blank?
+          items = stripe_value(stripe_sub, :items)
+          data = items.respond_to?(:data) ? items.data : Array(items)
+          timestamp = stripe_value(data.first, :current_period_end) if data.first
+        end
+        time_from(timestamp)
+      rescue
+        nil
+      end
+
+      def metadata_value(object, key)
+        metadata = stripe_value(object, :metadata)
+        stripe_value(metadata, key) if metadata
+      end
+
+      def time_from(value)
+        Time.at(value.to_i).utc if value.present?
+      end
+
+      def customer_id_from(customer)
+        id_from(customer)
+      end
+
+      def stripe_value(object, key)
+        if object.nil?
+          nil
+        elsif object.respond_to?(:[])
+          object[key.to_s] || object[key.to_sym]
+        elsif object.respond_to?(key)
+          object.public_send(key)
+        end
+      end
+
+      def id_from(value)
+        if value.respond_to?(:id) && !value.is_a?(String)
+          value.id
+        else
+          value
+        end
+      end
+  end
+end
