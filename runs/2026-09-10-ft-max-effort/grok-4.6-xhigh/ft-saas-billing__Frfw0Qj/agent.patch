index 0000000..9f7fd53
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription updated webhook marks the account paid" do
+    account = accounts(:initech)
+
+    untenanted do
+      post "/stripe/webhooks", params: subscription_event(
+        type: "customer.subscription.updated",
+        account: account,
+        status: "active",
+        price_id: ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      ), as: :json
+    end
+
+    assert_response :ok
+    account.reload
+    assert account.paid?
+    assert_equal "unlimited", account.subscription.plan_key
+    assert_equal 5.gigabytes, account.storage_limit
+  end
+
+  test "subscription with extra storage price is unlimited plus" do
+    account = accounts(:initech)
+
+    untenanted do
+      post "/stripe/webhooks", params: subscription_event(
+        type: "customer.subscription.updated",
+        account: account,
+        status: "active",
+        price_id: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      ), as: :json
+    end
+
+    assert_response :ok
+    assert_equal "Unlimited+", account.reload.billing_plan.name
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "subscription deleted webhook returns the account to free" do
+    account = accounts(:initech)
+    Account::Subscription.create!(
+      account: account,
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_wh_del",
+      stripe_subscription_id: "sub_wh_del",
+      status: "active"
+    )
+
+    untenanted do
+      post "/stripe/webhooks", params: subscription_event(
+        type: "customer.subscription.deleted",
+        account: account,
+        status: "canceled",
+        price_id: ENV["STRIPE_MONTHLY_V1_PRICE_ID"],
+        customer: "cus_wh_del",
+        subscription_id: "sub_wh_del"
+      ), as: :json
+    end
+
+    assert_response :ok
+    assert_not account.reload.paid?
+    assert_equal "Free", account.billing_plan.name
+  end
+
+  test "checkout session completed creates a subscription" do
+    account = accounts(:acme)
+
+    untenanted do
+      post "/stripe/webhooks", params: {
+        type: "checkout.session.completed",
+        data: {
+          object: {
+            id: "cs_test",
+            customer: "cus_checkout",
+            subscription: "sub_checkout",
+            client_reference_id: account.id,
+            metadata: { account_id: account.id, plan_key: "unlimited" }
+          }
+        }
+      }, as: :json
+    end
+
+    assert_response :ok
+    account.reload
+    assert account.paid?
+    assert_equal "cus_checkout", account.subscription.stripe_customer_id
+  end
+
+  private
+    def subscription_event(type:, account:, status:, price_id:, customer: "cus_wh", subscription_id: "sub_wh")
+      {
+        type: type,
+        data: {
+          object: {
+            id: subscription_id,
+            customer: customer,
+            status: status,
+            metadata: { account_id: account.id },
+            items: {
+              data: [
+                { price: { id: price_id } }
+              ]
+            }
+          }
+        }
+      }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..e1a8aec
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan is the default" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1_000, @account.billing_plan.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.paid?
+  end
+
+  test "paid unlimited plan has 5 GB storage and no card limit" do
+    subscribe! plan_key: "unlimited"
+
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_nil @account.billing_plan.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert @account.paid?
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "paid unlimited plus plan has 500 GB storage" do
+    subscribe! plan_key: "unlimited_plus"
+
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "exceeding card limit at 1000 cards on the free plan" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+  end
+
+  test "not exceeding card limit at 999 cards" do
+    @account.update_column(:cards_count, 999)
+
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "nearing card limit from 100 cards out" do
+    @account.update_column(:cards_count, 900)
+
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+  end
+
+  test "counts down cards remaining" do
+    @account.update_column(:cards_count, 950)
+
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "not nearing card limit with more than 100 remaining" do
+    @account.update_column(:cards_count, 899)
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "not nearing card limit when already exceeding" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "comped accounts do not exceed the card limit" do
+    @account.update_column(:cards_count, 1_000)
+    @account.comped = true
+
+    assert @account.comped?
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "overridden card count is used for limit checks" do
+    @account.override_limits(card_count: 950)
+
+    assert_equal 950, @account.billing_card_count
+    assert_equal 50, @account.cards_remaining
+    assert @account.nearing_card_limit?
+  end
+
+  test "overridden bytes used is used for storage checks" do
+    @account.override_limits(bytes_used: 1.gigabyte + 1)
+
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 950, bytes_used: 123)
+    @account.reset_overridden_limits
+
+    assert_nil @account.reload.overridden_limit
+    assert_equal @account.cards_count, @account.billing_card_count
+  end
+
+  test "canceled subscription returns to the free plan" do
+    subscribe! plan_key: "unlimited", status: "canceled"
+
+    assert_not @account.paid?
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  private
+    def subscribe!(plan_key:, status: "active")
+      Account::Subscription.create!(
+        account: @account,
+        plan_key: plan_key,
+        stripe_customer_id: "cus_#{@account.id}",
+        stripe_subscription_id: "sub_#{@account.id}",
+        status: status
+      )
+    end
+end
