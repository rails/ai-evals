--- /dev/null
+++ b/saas/test/controllers/admin/accounts/comps_controller_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class Admin::Accounts::CompsControllerTest < ActionDispatch::IntegrationTest
+  test "comp waives billing" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account)
+    end
+
+    assert_response :redirect
+    assert account.reload.comped?
+  end
+
+  test "uncomp removes the waiver" do
+    sign_in_as :david
+    account = accounts(:initech)
+    account.comped = true
+
+    untenanted do
+      delete saas.admin_account_comp_path(account)
+    end
+
+    assert_response :redirect
+    assert_not account.reload.comped?
+  end
+end
diff --git a/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
new file mode 100644
index 0000000..4625af5
--- /dev/null
+++ b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  test "override sets card count and bytes used" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account), params: { card_count: 950, bytes_used: 1234 }
+    end
+
+    assert_response :redirect
+    account.reload
+    assert_equal 950, account.overridden_limit.card_count
+    assert_equal 1234, account.overridden_limit.bytes_used
+    assert_equal 950, account.billing_card_count
+    assert_equal 1234, account.bytes_used
+  end
+
+  test "reset drops the override" do
+    sign_in_as :david
+    account = accounts(:initech)
+    account.override_limits(card_count: 950, bytes_used: 1234)
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account)
+    end
+
+    assert_response :redirect
+    assert_nil account.reload.overridden_limit
+  end
+end
