diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..9ffb610
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,33 @@
+class StripeWebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    Account::Subscription.sync_from_stripe_event(construct_event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def construct_event
+      payload = request.body.read
+      signature = request.env["HTTP_STRIPE_SIGNATURE"]
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      if secret.present? && signature.present?
+        Stripe::Webhook.construct_event(payload, signature, secret)
+      else
+        Stripe::Event.construct_from(event_hash(payload))
+      end
+    end
+
+    def event_hash(payload)
+      if payload.present? && payload.strip.start_with?("{")
+        JSON.parse(payload)
+      else
+        params.to_unsafe_h.slice("type", "data")
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..d5f090f
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,123 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription"
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver"
+  end
+
+  def billing_plan
+    if subscription&.active?
+      Account::Plan.for(subscription.plan_key)
+    else
+      Account::Plan::FREE
+    end
+  end
+
+  def paid?
+    subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless billing_waiver
+    else
+      billing_waiver&.destroy
+      self.billing_waiver = nil
+    end
+  end
+
+  def exceeding_card_limit?
+    return false if comped? || billing_plan.card_limit.nil?
+
+    billing_card_count >= billing_plan.card_limit
+  end
+
+  def nearing_card_limit?
+    return false if exceeding_card_limit? || billing_plan.card_limit.nil?
+
+    cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  def cards_remaining
+    if billing_plan.card_limit
+      [ billing_plan.card_limit - billing_card_count, 0 ].max
+    end
+  end
+
+  def billing_card_count
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      cards_count
+    end
+  end
+
+  def bytes_used
+    if overridden_limit && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      super
+    end
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attrs = { card_count: card_count, bytes_used: bytes_used }
+
+    if overridden_limit
+      overridden_limit.update!(attrs)
+    else
+      create_overridden_limit!(attrs)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+    self.overridden_limit = nil
+  end
+
+  def create_stripe_checkout_session(success_url:, cancel_url:, customer_email:)
+    Stripe::Checkout::Session.create(stripe_checkout_params(
+      success_url: success_url,
+      cancel_url: cancel_url,
+      customer_email: customer_email
+    ))
+  end
+
+  def create_stripe_portal_session(return_url:)
+    Stripe::BillingPortal::Session.create(
+      customer: subscription.stripe_customer_id,
+      return_url: return_url
+    )
+  end
+
+  private
+    def stripe_checkout_params(success_url:, cancel_url:, customer_email:)
+      params = {
+        mode: "subscription",
+        line_items: [ { price: Account::Plan::UNLIMITED.stripe_price_id, quantity: 1 } ],
+        success_url: success_url,
+        cancel_url: cancel_url,
+        client_reference_id: id,
+        metadata: { account_id: id, plan_key: Account::Plan::UNLIMITED.key },
+        subscription_data: {
+          metadata: { account_id: id, plan_key: Account::Plan::UNLIMITED.key }
+        }
+      }
+
+      if (customer_id = subscription&.stripe_customer_id)
+        params[:customer] = customer_id
+      else
+        params[:customer_email] = customer_email
+      end
+
+      params
+    end
+end
