+    def checkout_or_portal_url
+      if Current.account.stripe_customer_id.present? && selected_plan.nil?
+        Current.account.create_billing_portal_session(return_url: account_settings_url).url
+      else
+        Current.account.create_checkout_session(
+          plan: selected_plan || Plan.unlimited,
+          success_url: account_settings_url,
+          cancel_url: account_settings_url
+        ).url
+      end
+    end
+
+    def selected_plan
+      Plan.find(params[:plan]) if params[:plan].present?
+    end
+end
