diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..2371920
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan allows 1000 cards and 1 GB" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "exceeding card limit at 1000 cards" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "not exceeding card limit at 999 cards" do
+    @account.update_column(:cards_count, 999)
+
+    assert_not @account.exceeding_card_limit?
+    assert_equal 1, @account.cards_remaining
+  end
+
+  test "nearing card limit counts down from 100 cards out" do
+    @account.update_column(:cards_count, 950)
+
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "not nearing card limit well under the threshold" do
+    @account.update_column(:cards_count, 800)
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid unlimited plan has 5 GB and no card limit" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "paid unlimited plus plan has 500 GB" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      plan_key: "monthly_extra_storage_v1",
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comped accounts get unlimited plus limits" do
+    @account.comped = true
+    @account.update_column(:cards_count, 5_000)
+    Account.any_instance.stubs(:bytes_used).returns(10.gigabytes)
+
+    assert @account.comped?
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "overridden card count is used for limits" do
+    @account.update_column(:cards_count, 10)
+    @account.override_limits(card_count: 1_000)
+
+    assert_equal 1_000, @account.billed_card_count
+    assert @account.exceeding_card_limit?
+  end
+
+  test "overridden bytes used is used for storage limits" do
+    @account.override_limits(bytes_used: 2.gigabytes)
+
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+    @account.reset_overridden_limits
+
+    assert_nil @account.reload.overridden_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "canceled subscription falls back to free" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_canceled",
+      stripe_subscription_id: "sub_canceled",
+      plan_key: "monthly_v1",
+      status: "canceled"
+    )
+
+    assert_equal "Free", @account.billing_plan.name
+    assert_not @account.paid?
+    assert_nil @account.active_subscription
+  end
+end
