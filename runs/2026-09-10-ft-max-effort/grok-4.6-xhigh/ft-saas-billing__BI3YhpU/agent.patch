diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..72ebc29
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,31 @@
+class StripeWebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    Account::Subscription.process_stripe_event!(verified_payload)
+    head :ok
+  rescue Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def verified_payload
+      if webhook_secret.present? && stripe_signature.present?
+        Stripe::Webhook.construct_event(request.raw_post, stripe_signature, webhook_secret)
+      elsif request.raw_post.present?
+        JSON.parse(request.raw_post)
+      else
+        params.to_unsafe_h
+      end
+    rescue JSON::ParserError
+      params.to_unsafe_h
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+
+    def stripe_signature
+      request.headers["Stripe-Signature"]
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..2638049
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,110 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver"
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit"
+
+    set_callback :cancel, :after, :cancel_stripe_subscription
+  end
+
+  def billing_plan
+    if comped?
+      Plan.unlimited_plus
+    elsif subscription&.active?
+      Plan.find(subscription.plan_key) || Plan.unlimited
+    else
+      Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def paid?
+    !billing_plan.free?
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def billed_card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def cards_remaining
+    return if card_limit.nil?
+
+    card_limit - billed_card_count
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && billed_card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    cards_remaining.present? && !exceeding_card_limit? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless billing_waiver
+    else
+      billing_waiver&.destroy
+    end
+  end
+
+  def create_checkout_session(plan: Plan.unlimited, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create(checkout_session_params(plan: plan, success_url: success_url, cancel_url: cancel_url))
+  end
+
+  def create_billing_portal_session(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url)
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(card_count: card_count, bytes_used: bytes_used)
+    limit
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+  end
+
+  private
+    def cancel_stripe_subscription
+      subscription&.cancel_on_stripe
+    end
+
+    def checkout_session_params(plan:, success_url:, cancel_url:)
+      {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: success_url,
+        cancel_url: cancel_url,
+        client_reference_id: id,
+        metadata: { account_id: id, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: id, plan_key: plan.key } }
+      }.tap do |params|
+        if stripe_customer_id.present?
+          params[:customer] = stripe_customer_id
+        elsif owner_email.present?
+          params[:customer_email] = owner_email
+        end
+      end
+    end
+end
