+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_match(/Free/, response.body)
+    assert_select "button", text: "Upgrade"
+  end
+
+  test "admins see unlimited after subscribing" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      plan_key: "monthly_v1",
+      status: "active"
+    )
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_match(/Unlimited/, response.body)
+    assert_select "button", text: "Upgrade"
+  end
+end
