diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..f994a84
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,168 @@
+class Account::Subscription < SaasRecord
+  self.table_name = "account_subscriptions"
+
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def cancel_on_stripe
+    if stripe_subscription_id.present?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+    end
+  rescue Stripe::StripeError => error
+    Rails.logger.error("Failed to cancel Stripe subscription #{stripe_subscription_id}: #{error.message}")
+  end
+
+  class << self
+    def process_stripe_event!(payload)
+      payload = normalize(payload)
+      object = indifferent(payload.dig(:data, :object) || (payload[:customer] || payload[:object] ? payload : {}))
+      type = payload[:type].to_s
+      type = inferred_type(object) if type.blank?
+
+      case type
+      when "customer.subscription.created", "customer.subscription.updated"
+        sync_from_stripe_subscription!(object)
+      when "customer.subscription.deleted"
+        sync_from_stripe_subscription!(object.merge(status: object[:status].presence || "canceled"))
+      when "checkout.session.completed"
+        sync_from_checkout_session!(object)
+      when "invoice.paid", "invoice.upcoming", "invoice.payment_succeeded"
+        sync_from_invoice!(object)
+      end
+    end
+
+    private
+      def normalize(payload)
+        payload = JSON.parse(payload) if payload.is_a?(String)
+        indifferent(payload)
+      end
+
+      def indifferent(value)
+        value = value.to_hash if value.respond_to?(:to_hash) && !value.is_a?(Hash)
+        value.is_a?(Hash) ? value.with_indifferent_access : {}
+      end
+
+      def inferred_type(object)
+        case object[:object].to_s
+        when "subscription" then "customer.subscription.updated"
+        when "checkout.session" then "checkout.session.completed"
+        when "invoice" then "invoice.paid"
+        end
+      end
+
+      def sync_from_stripe_subscription!(object)
+        object = indifferent(object)
+        account = find_account_from(object)
+        customer_id = id_of(object[:customer])
+        return unless account && customer_id
+
+        price = extract_price(object)
+        plan = Plan.find_by_stripe_price(price) || Plan.find(indifferent(object[:metadata])[:plan_key])
+        item = extract_items(object).first || {}
+        period_end = object[:current_period_end] || item[:current_period_end]
+        status = object[:status]
+        plan_key = plan&.key
+        plan_key ||= "monthly_v1" if status.to_s.in?(ACTIVE_STATUSES)
+
+        upsert_for!(account, {
+          stripe_customer_id: customer_id,
+          stripe_subscription_id: id_of(object[:id]),
+          status: status,
+          plan_key: plan_key,
+          current_period_end: time_at(period_end),
+          cancel_at: time_at(object[:cancel_at]),
+          next_amount_due_in_cents: amount_from(price) || plan&.price_cents
+        }.compact)
+      end
+
+      def sync_from_checkout_session!(session)
+        session = indifferent(session)
+        account = find_account_from(session)
+        customer_id = id_of(session[:customer])
+        return unless account && customer_id
+
+        plan = Plan.find(indifferent(session[:metadata])[:plan_key])
+        plan_key = plan&.key || "monthly_v1"
+
+        upsert_for!(account, {
+          stripe_customer_id: customer_id,
+          stripe_subscription_id: id_of(session[:subscription]),
+          status: "active",
+          plan_key: plan_key,
+          next_amount_due_in_cents: plan&.price_cents
+        }.compact)
+      end
+
+      def sync_from_invoice!(invoice)
+        invoice = indifferent(invoice)
+        subscription_id = id_of(invoice[:subscription])
+        record = find_by(stripe_subscription_id: subscription_id) if subscription_id.present?
+        record ||= find_by(stripe_customer_id: id_of(invoice[:customer]))
+        return unless record
+
+        amount = invoice[:amount_due] || invoice[:amount_paid] || invoice[:total]
+        record.update!(next_amount_due_in_cents: amount) if amount.present?
+      end
+
+      def upsert_for!(account, attrs)
+        record = if attrs[:stripe_subscription_id].present?
+          find_by(stripe_subscription_id: attrs[:stripe_subscription_id])
+        end
+        record ||= account.subscription || account.build_subscription
+        record.update!(attrs)
+        record
+      end
+
+      def find_account_from(object)
+        object = indifferent(object)
+        metadata = indifferent(object[:metadata])
+        identifier = metadata[:account_id] || object[:client_reference_id]
+
+        if identifier.present?
+          Account.find_by(id: identifier) || Account.find_by(external_account_id: identifier)
+        end || find_by(stripe_customer_id: id_of(object[:customer]))&.account ||
+          find_by(stripe_subscription_id: id_of(object[:id]) || id_of(object[:subscription]))&.account
+      end
+
+      def extract_items(object)
+        items = indifferent(object)[:items]
+        data = items.is_a?(Hash) ? (items[:data] || []) : Array(items)
+        data = indifferent(object)[:lines][:data] if data.blank? && indifferent(object)[:lines].is_a?(Hash)
+        Array(data).map { |item| indifferent(item) }
+      end
+
+      def extract_price(object)
+        item = extract_items(object).first || {}
+        item[:price] || item[:plan]
+      end
+
+      def amount_from(price)
+        return if price.blank?
+        return price if price.is_a?(Numeric)
+        return price[:unit_amount] || price["unit_amount"] if price.is_a?(Hash)
+
+        price.unit_amount if price.respond_to?(:unit_amount)
+      end
+
+      def id_of(value)
+        case value
+        when nil then nil
+        when String then value
+        when Hash then value[:id] || value["id"]
+        else
+          value.respond_to?(:id) ? value.id : value.to_s
+        end
+      end
+
+      def time_at(value)
+        return if value.blank?
+
+        value.is_a?(Numeric) ? Time.at(value) : Time.zone.parse(value.to_s)
+      end
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..d62d858
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,100 @@
+class Plan
+  attr_reader :key, :name, :price_cents, :card_limit, :storage_bytes, :stripe_price_env
+
+  def initialize(key:, name:, price_cents:, storage_bytes:, card_limit: nil, stripe_price_env: nil)
+    @key = key
+    @name = name
+    @price_cents = price_cents
+    @card_limit = card_limit
+    @storage_bytes = storage_bytes
+    @stripe_price_env = stripe_price_env
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env] if stripe_price_env
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def free?
+    price_cents.zero?
+  end
+
+  class << self
+    def all
+      [ free, unlimited, unlimited_plus ]
+    end
+
+    def free
+      @free ||= new(
+        key: "free",
+        name: "Free",
+        price_cents: 0,
+        card_limit: 1_000,
+        storage_bytes: 1.gigabyte
+      )
+    end
+
+    def unlimited
+      @unlimited ||= new(
+        key: "monthly_v1",
+        name: "Unlimited",
+        price_cents: 20_00,
+        storage_bytes: 5.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+      )
+    end
+
+    def unlimited_plus
+      @unlimited_plus ||= new(
+        key: "monthly_extra_storage_v1",
+        name: "Unlimited+",
+        price_cents: 25_00,
+        storage_bytes: 500.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+      )
+    end
+
+    def find(identifier)
+      return if identifier.blank?
+
+      token = identifier.to_s
+      all.find do |plan|
+        [ plan.key, plan.name, plan.stripe_price_id ].compact.include?(token)
+      end
+    end
+
+    def find_by_stripe_price(price)
+      return if price.blank?
+
+      find(price_id_from(price)) || find_by_unit_amount(unit_amount_from(price))
+    end
+
+    def find_by_unit_amount(amount)
+      all.find { |plan| plan.price_cents == amount.to_i } if amount.present?
+    end
+
+    private
+      def price_id_from(price)
+        case price
+        when String
+          price
+        when Hash
+          price[:id] || price["id"]
+        else
+          price.respond_to?(:id) ? price.id : price.to_s
+        end
+      end
+
+      def unit_amount_from(price)
+        case price
+        when Hash
+          price[:unit_amount] || price["unit_amount"]
+        else
+          price.unit_amount if price.respond_to?(:unit_amount)
+        end
+      end
+  end
+end
