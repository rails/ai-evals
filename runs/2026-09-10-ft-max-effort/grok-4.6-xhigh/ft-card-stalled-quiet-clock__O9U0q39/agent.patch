diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..9e38422
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "assignment is a burst" do
+    freeze_time
+
+    assert_nil @card.last_burst_at
+
+    @card.toggle_assignment users(:kevin)
+
+    assert_equal Time.current, @card.reload.last_burst_at
+    assert_not @card.stalled?
+  end
+
+  test "unassignment is not a burst" do
+    @card.toggle_assignment users(:kevin)
+    assert_not_nil @card.reload.last_burst_at
+
+    @card.toggle_assignment users(:kevin)
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "reopening is a burst" do
+    freeze_time
+
+    card = cards(:shipping)
+    card.update!(last_burst_at: nil)
+    card.reopen
+
+    assert_equal Time.current, card.reload.last_burst_at
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    freeze_time
+
+    assert_nil @card.last_burst_at
+
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:david))
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create!(body: "Three", creator: users(:kevin))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "three comments from one person is not a burst" do
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:david))
+    @card.comments.create!(body: "Three", creator: users(:david))
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "two comments from two people is not a burst" do
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:kevin))
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    @card.comments.create!(body: "One", creator: users(:david))
+    @card.comments.create!(body: "Two", creator: users(:kevin))
+    @card.comments.create!(body: "System", creator: users(:system))
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the auto-close period are not a burst" do
+    window = (@card.auto_postpone_period / 3).seconds
+
+    travel_to (window + 1.day).ago do
+      @card.comments.create!(body: "Old one", creator: users(:david))
+      @card.comments.create!(body: "Old two", creator: users(:kevin))
+    end
+
+    @card.comments.create!(body: "New", creator: users(:jz))
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    @card.toggle_assignment users(:kevin)
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks + 1.second
+
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "activity resets a stalled card" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks + 1.second
+    assert @card.reload.stalled?
+
+    @card.comments.create!(body: "Still on it", creator: users(:david))
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+    assert_nil @card.last_burst_at
+  end
+
+  test "activity after a burst resets it so two weeks of quiet is not stalled" do
+    @card.toggle_assignment users(:kevin)
+    @card.comments.create!(body: "Working", creator: users(:david))
+
+    travel 2.weeks + 1.second
+
+    assert_not @card.reload.stalled?
+    assert_nil @card.last_burst_at
+  end
+
+  test "closed cards are not stalled" do
+    @card.close
+    @card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "postponed cards are not stalled" do
+    @card.postpone
+    @card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "indexed_by stalled" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks + 1.second
+
+    assert_includes Card.indexed_by("stalled"), @card
+    assert_not_includes Card.indexed_by("stalled"), cards(:logo)
+  end
+end
