diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..1299ea4
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,25 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_INACTIVITY_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      active.where.not(last_burst_at: nil).where(last_active_at: ..STALL_INACTIVITY_PERIOD.ago)
+    }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALL_INACTIVITY_PERIOD.ago && active?
+  end
+
+  def record_burst
+    update!(last_active_at: Time.current, last_burst_at: Time.current)
+  end
+
+  def comment_burst?(as_of: Time.current)
+    window = auto_postpone_period / 3.0
+    recent = comments.by_user.where(created_at: (as_of - window)..as_of)
+    recent.count >= 3 && recent.distinct.count(:creator_id) >= 2
+  end
+end
