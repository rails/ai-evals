+class ImportMailer < ApplicationMailer
+  def completed(import, imported_account)
+    @import = import
+    @imported_account = imported_account
+    @account_url = root_url(script_name: imported_account.slug)
+
+    mail to: import.user.identity.email_address, subject: "Your Fizzy import is complete"
+  end
+
+  def failed(import, error)
+    @import = import
+    @error_message = error.respond_to?(:message) ? error.message : error.to_s
+
+    mail to: import.user.identity.email_address, subject: "Your Fizzy import failed"
+  end
+end
