diff --git a/app/models/zip_file/extractor_io.rb b/app/models/zip_file/extractor_io.rb
new file mode 100644
index 0000000..bef78f6
--- /dev/null
+++ b/app/models/zip_file/extractor_io.rb
@@ -0,0 +1,61 @@
+class ZipFile::ExtractorIO
+  def initialize(extractor, size:)
+    @extractor = extractor
+    @size = size
+    @buffer = +""
+  end
+
+  attr_reader :size
+
+  def read(length = nil, buf = nil)
+    data = if length
+      take(length)
+    else
+      drain
+    end
+
+    buf.replace(data || "") if buf
+
+    data
+  end
+
+  def eof?
+    @buffer.empty? && @extractor.eof?
+  end
+
+  def binmode
+    self
+  end
+
+  private
+    def take(length)
+      fill_to(length)
+
+      if @buffer.empty?
+        nil
+      else
+        @buffer.slice!(0, length)
+      end
+    end
+
+    def fill_to(length)
+      while @buffer.bytesize < length && !@extractor.eof?
+        chunk = @extractor.extract([ length - @buffer.bytesize, 1024 * 1024 ].max)
+        break if chunk.nil? || chunk.empty?
+        @buffer << chunk
+      end
+    end
+
+    def drain
+      parts = [ @buffer ]
+      @buffer = +""
+
+      until @extractor.eof?
+        chunk = @extractor.extract(1024 * 1024)
+        break if chunk.nil?
+        parts << chunk
+      end
+
+      parts.join
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..160d048
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,33 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def glob(pattern)
+    @entries.select { |entry| File.fnmatch(pattern, entry.filename) }.map(&:filename).sort
+  end
+
+  def exists?(path)
+    @entries.any? { |entry| entry.filename == path }
+  end
+
+  def read(path)
+    open(path) { |io| io.read }
+  end
+
+  def open(path)
+    entry = find_entry(path)
+    extractor = entry.extractor_from(@io)
+    yield ZipFile::ExtractorIO.new(extractor, size: entry.uncompressed_size)
+  end
+
+  private
+    def find_entry(path)
+      if entry = @entries.find { |e| e.filename == path }
+        entry
+      else
+        raise ArgumentError, "No zip entry #{path}"
+      end
+    end
+end
