 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+  end
+
+  test "exported rich text replaces attachable sgids with portable blob ids" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    html = %(<action-text-attachment sgid="#{blob.attachable_sgid}" filename="moon.jpg"></action-text-attachment>)
+    @card.update!(description: html)
+
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export_to(writer)
+    writer.close
+    tempfile.rewind
+
+    reader = ZipFile::Reader.new(tempfile)
+    path = reader.glob("action_text_rich_texts/*.json").find do |entry|
+      JSON.parse(reader.read(entry))["record_id"] == @card.id
+    end
+
+    payload = JSON.parse(reader.read(path))
+    assert_includes payload["body"], "blob:#{blob.id}"
+    assert_not_includes payload["body"], blob.attachable_sgid
+  end
 end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..642bd7d
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "creating an account export enqueues a job" do
+    assert_enqueued_with(job: ExportJob) do
+      @account.exports.create!(user: @user, kind: :account)
+    end
+  end
+
+  test "export_now attaches a zip and emails a download link" do
+    export = @account.exports.create!(user: @user, kind: :account)
+
+    assert_emails 1 do
+      export.export_now
+    end
+
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "ready", email.subject
+    assert_match "/exports/", email.body.encoded
+    assert_match "download", email.body.encoded
+  end
+
+  test "account export zip includes account records and files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @user, kind: :account)
+    export.export_now
+
+    ZipFile.open_for(export.file) do |zip|
+      assert zip.glob("accounts/*.json").any?
+      assert zip.glob("users/*.json").any?
+      assert zip.glob("cards/*.json").any?
+      assert zip.glob("comments/*.json").any?
+      assert zip.glob("files/*").any?
+    end
+  end
+
+  test "cards export zip includes JSON with comments and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: users(:david), kind: :cards)
+    export.export_now
+
+    ZipFile.open_for(export.file) do |zip|
+      json_path = "cards/#{card.number}.json"
+      assert zip.exists?(json_path), "expected #{json_path} in #{zip.glob("cards/**/*")}"
+
+      payload = JSON.parse(zip.read(json_path))
+      assert_equal card.title, payload["title"]
+      assert payload["comments"].any?
+      assert_includes payload["files"], "moon.jpg"
+      assert zip.exists?("cards/#{card.number}/moon.jpg")
+    end
+  end
+
+  test "cards export only includes cards the user can see" do
+    with_current_user(users(:kevin)) do
+      boards(:private).cards.create!(
+        title: "Secret",
+        creator: users(:kevin),
+        status: :published,
+        last_active_at: Time.current
+      )
+    end
+
+    export = @account.exports.create!(user: users(:david), kind: :cards)
+    export.export_now
+
+    ZipFile.open_for(export.file) do |zip|
+      paths = zip.glob("cards/*.json")
+      titles = paths.map { |path| JSON.parse(zip.read(path))["title"] }
+      assert_includes titles, cards(:logo).title
+      assert_not_includes titles, "Secret"
+    end
+  end
+
+  test "cleanup destroys expired exports" do
+    export = @account.exports.create!(user: @user, kind: :account)
+    export.update_column(:created_at, 2.days.ago)
+
+    assert_difference -> { Export.count }, -1 do
+      Export.cleanup
+    end
+  end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..f4050e8
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "creating an import enqueues a job" do
+    import = build_import_from_account_export
+    clear_enqueued_jobs
+
+    assert_enqueued_with(job: ImportJob) do
+      import.save!
+    end
+  end
+
+  test "import_now creates a new account with boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    import = build_import_from_account_export
+    import.save!
+
+    assert_difference -> { Account.count }, 1 do
+      assert_emails 1 do
+        import.import_now
+      end
+    end
+
+    imported = Account.order(:created_at).last
+    assert_equal @account.name, imported.name
+    assert_not_equal @account.id, imported.id
+    assert_not_equal @account.external_account_id, imported.external_account_id
+
+    assert imported.users.exists?(identity: identities(:david))
+    assert imported.users.exists?(identity: identities(:jason))
+    assert imported.boards.exists?(name: boards(:writebook).name)
+    assert imported.cards.exists?(title: card.title)
+    assert imported.cards.find_by(title: card.title).comments.exists?
+    assert imported.cards.find_by(title: card.title).image.attached?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "complete", email.subject
+    assert_match imported.name, email.body.encoded
+  end
+
+  test "failed import leaves nothing behind and emails the reason" do
+    import = @account.imports.build(user: @user)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "nope.txt", content_type: "text/plain")
+    import.save!
+
+    account_count = Account.count
+    user_count = User.count
+    card_count = Card.count
+
+    assert_emails 1 do
+      import.import_now
+    end
+
+    assert_equal account_count, Account.count
+    assert_equal user_count, User.count
+    assert_equal card_count, Card.count
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "failed", email.subject
+    assert_match(/reason/i, email.body.encoded)
+  end
+
+  test "importer is added as owner when they are not in the file" do
+    import = build_import_from_account_export(user: users(:mike))
+    import.save!
+    import.import_now
+
+    imported = Account.order(:created_at).last
+    importer = imported.users.find_by(identity: identities(:mike))
+    assert importer.present?
+    assert importer.owner?
+  end
+
+  private
+    def build_import_from_account_export(user: @user)
+      export = @account.exports.create!(user: @user, kind: :account)
+      export.export_now
+
+      zip_data = export.file.download
+      destination = user.account
+
+      import = destination.imports.build(user: user)
+      Current.with_account(destination) do
+        blob = ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new(zip_data),
+          filename: "export.zip",
+          content_type: "application/zip"
+        )
+        import.file.attach(blob)
+      end
+      import
+    end
+end
