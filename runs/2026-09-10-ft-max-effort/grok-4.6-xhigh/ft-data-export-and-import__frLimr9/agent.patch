diff --git a/app/models/card/export.rb b/app/models/card/export.rb
new file mode 100644
index 0000000..e79ebe2
--- /dev/null
+++ b/app/models/card/export.rb
@@ -0,0 +1,90 @@
+class Card::Export
+  def initialize(user)
+    @user = user
+  end
+
+  def export_to(zip)
+    cards.find_each do |card|
+      zip.add_file card_json_path(card), card_payload(card)
+      export_files(zip, card)
+    end
+  end
+
+  private
+    def cards
+      @user.accessible_cards.published.includes(
+        :board, :column, :creator, :assignees, :tags, :image_blob,
+        comments: [ :creator, :rich_text_body ]
+      ).with_rich_text_description
+    end
+
+    def card_json_path(card)
+      "cards/#{card.number}.json"
+    end
+
+    def card_payload(card)
+      JSON.pretty_generate(card_as_json(card))
+    end
+
+    def card_as_json(card)
+      {
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "description" => card.description.to_plain_text,
+        "description_html" => card.description.to_s,
+        "board" => card.board.name,
+        "column" => card.column&.name,
+        "creator" => card.creator.name,
+        "assignees" => card.assignees.map(&:name),
+        "tags" => card.tags.map(&:title).sort,
+        "closed" => card.closed?,
+        "created_at" => card.created_at.utc,
+        "comments" => card.comments.chronologically.map { |comment| comment_as_json(comment) },
+        "files" => file_names(card)
+      }
+    end
+
+    def comment_as_json(comment)
+      {
+        "creator" => comment.creator.name,
+        "body" => comment.body.to_plain_text,
+        "body_html" => comment.body.to_s,
+        "created_at" => comment.created_at.utc
+      }
+    end
+
+    def file_names(card)
+      blobs_for(card).map { |blob| blob.filename.to_s }
+    end
+
+    def export_files(zip, card)
+      used_names = Hash.new(0)
+
+      blobs_for(card).each do |blob|
+        name = unique_file_name(blob.filename.to_s, used_names)
+        zip.add_file "cards/#{card.number}/#{name}", compress: false do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+
+    def unique_file_name(name, used_names)
+      used_names[name] += 1
+      if used_names[name] == 1
+        name
+      else
+        ext = File.extname(name)
+        base = File.basename(name, ext)
+        "#{base}-#{used_names[name]}#{ext}"
+      end
+    end
+
+    def blobs_for(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat(card.attachments.map(&:blob))
+      card.comments.each { |comment| blobs.concat(comment.attachments.map(&:blob)) }
+      blobs.compact.uniq
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..5a4f570
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,65 @@
+class Export < ApplicationRecord
+  EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself)
+
+  after_create_commit :export_later
+
+  class << self
+    def cleanup
+      where(created_at: ...EXPIRATION.ago).find_each(&:destroy)
+    end
+  end
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def export_now
+    Current.with_account(account) do
+      attach_zip
+      ExportMailer.ready(self).deliver_now
+    end
+  end
+
+  def filename
+    stamp = created_at.strftime("%Y-%m-%d")
+
+    if account?
+      "fizzy-#{account.name.parameterize}-#{stamp}.zip"
+    else
+      "fizzy-cards-#{stamp}.zip"
+    end
+  end
+
+  def download_signed_id
+    signed_id(purpose: :download, expires_in: EXPIRATION)
+  end
+
+  def publicly_accessible?
+    true
+  end
+
+  def accessible_to?(user)
+    self.user == user || user&.admin?
+  end
+
+  private
+    def attach_zip
+      ZipFile.create_for(file, filename: filename) do |zip|
+        exporter.export_to(zip)
+      end
+    end
+
+    def exporter
+      if account?
+        Account::DataTransfer::Manifest.new(account)
+      else
+        Card::Export.new(user)
+      end
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..250ba83
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,88 @@
+class Import < ApplicationRecord
+  EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  after_create_commit :import_later
+
+  class << self
+    def cleanup
+      where(created_at: ...EXPIRATION.ago).find_each(&:destroy)
+    end
+  end
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    imported_account = nil
+
+    ZipFile.open_for(file) do |zip|
+      validate_export!(zip)
+      imported_account = create_imported_account(zip)
+
+      Current.with_account(imported_account) do
+        Account::DataTransfer::Manifest.new(imported_account).import_from(zip)
+        ensure_importer_access(imported_account)
+        reindex(imported_account)
+      end
+    end
+
+    ImportMailer.completed(self, imported_account).deliver_now
+  rescue ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::ReadError
+    cleanup_imported_account(imported_account)
+    ImportMailer.failed(self, "This file doesn't look like a Fizzy account export.").deliver_now
+  rescue => error
+    Rails.error.report(error)
+    cleanup_imported_account(imported_account)
+    ImportMailer.failed(self, error).deliver_now
+  end
+
+  private
+    def validate_export!(zip)
+      if zip.glob("accounts/*.json").none?
+        raise "This file doesn't look like a Fizzy account export."
+      end
+    end
+
+    def create_imported_account(zip)
+      attrs = JSON.parse(zip.read(zip.glob("accounts/*.json").first))
+      Account.create!(name: attrs["name"].presence || "Imported account")
+    end
+
+    def ensure_importer_access(imported_account)
+      unless imported_account.users.exists?(identity: user.identity)
+        imported_account.users.create!(
+          name: user.name,
+          identity: user.identity,
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+    end
+
+    def reindex(imported_account)
+      Card.where(account_id: imported_account.id).published.find_each do |card|
+        card.reindex
+      rescue => error
+        Rails.error.report(error)
+      end
+
+      Comment.where(account_id: imported_account.id).find_each do |comment|
+        comment.reindex
+      rescue => error
+        Rails.error.report(error)
+      end
+    end
+
+    def cleanup_imported_account(imported_account)
+      if imported_account
+        account_id = imported_account.id
+        imported_account.destroy
+        ActiveStorage::Blob.where(account_id: account_id).find_each(&:purge)
+      end
+    end
+end
