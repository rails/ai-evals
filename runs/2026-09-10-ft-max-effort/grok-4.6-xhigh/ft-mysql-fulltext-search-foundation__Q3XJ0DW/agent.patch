diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..391a0a9
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "finds cards by title" do
+    assert_includes Card.search("logo"), cards(:logo)
+    assert_not_includes Card.search("logo"), cards(:layout)
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update!(description: "A unique description about widgets")
+
+    assert_includes Card.search("widgets"), cards(:layout)
+    assert_not_includes Card.search("widgets"), cards(:logo)
+  end
+
+  test "finds cards by comment body" do
+    assert_includes Card.search("overflowing"), cards(:layout)
+    assert_not_includes Card.search("overflowing"), cards(:logo)
+  end
+
+  test "returns newest cards first" do
+    older = boards(:writebook).cards.create!(title: "SearchableUnique older", status: :published, creator: users(:kevin), created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "SearchableUnique newer", status: :published, creator: users(:kevin), created_at: 1.day.ago)
+
+    assert_equal [ newer, older ], Card.search("SearchableUnique").reverse_chronologically
+  end
+
+  test "does not return draft cards" do
+    boards(:writebook).cards.create!(title: "DraftUnique title", status: :drafted, creator: users(:kevin))
+
+    assert_empty Card.published.search("DraftUnique")
+  end
+
+  test "does not return draft cards matched only by comments" do
+    card = boards(:writebook).cards.create!(title: "A draft card", status: :published, creator: users(:kevin))
+    card.comments.create!(body: "DraftCommentUnique", creator: users(:kevin))
+    card.update_column(:status, "drafted")
+
+    assert_empty Card.published.search("DraftCommentUnique")
+  end
+
+  test "blank query matches nothing" do
+    assert_empty Card.search("")
+    assert_empty Card.search("  ")
+    assert_empty Card.search(nil)
+  end
+
+  test "a card matching in multiple comments is returned once" do
+    card = cards(:logo)
+    card.comments.create!(body: "RepeatedUnique first", creator: users(:kevin))
+    card.comments.create!(body: "RepeatedUnique second", creator: users(:kevin))
+
+    assert_equal [ card ], Card.search("RepeatedUnique")
+  end
+
+  test "escapes LIKE wildcards in the query" do
+    cards(:logo).update!(title: "100% done")
+
+    assert_includes Card.search("100%"), cards(:logo)
+    assert_not_includes Card.search("%"), cards(:layout)
+  end
+
+  test "does not find cards from other accounts" do
+    assert_not_includes users(:kevin).accessible_cards.search("radio"), cards(:radio)
+  end
+end
