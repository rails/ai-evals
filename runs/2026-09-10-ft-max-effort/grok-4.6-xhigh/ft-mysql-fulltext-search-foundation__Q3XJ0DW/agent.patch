diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..fc78cef
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,40 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half align-center" do %>
+    <%= search_field_tag :q, @query,
+          class: "input",
+          placeholder: "Search cards…",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off",
+          aria: { label: "Search cards" },
+          data: { "1p-ignore": true } %>
+    <%= button_tag class: "btn", type: "submit" do %>
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <ol class="search__results txt-align-start">
+          <% @page.records.each do |card| %>
+            <%= render "searches/result", card: card, query: @query %>
+          <% end %>
+        </ol>
+      <% end %>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% end %>
+</section>
