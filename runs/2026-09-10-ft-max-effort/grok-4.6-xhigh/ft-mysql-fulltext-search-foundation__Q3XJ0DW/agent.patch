diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..49c8cbe
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select "mark", count: 0
+  end
+
+  test "finds cards by title and wraps matched words in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "mark", text: "logo"
+    assert_select ".search__title", text: /The logo isn't big enough/
+    assert_select ".search__title", text: /Layout is broken/, count: 0
+  end
+
+  test "finds cards by description and wraps matched words in mark" do
+    cards(:text).update!(description: "A distinctive banana description")
+
+    get search_path(q: "banana")
+    assert_response :success
+
+    assert_select "mark", text: "banana"
+    assert_select ".search__title", text: /The text is too small/
+  end
+
+  test "finds cards by comment body and wraps matched words in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "mark", text: "overflowing"
+    assert_select ".search__title", text: /Layout is broken/
+  end
+
+  test "returns newest cards first" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create!(title: "ChronoUnique older", status: :published, creator: users(:kevin), created_at: 2.days.ago)
+      boards(:writebook).cards.create!(title: "ChronoUnique newer", status: :published, creator: users(:kevin), created_at: 1.day.ago)
+    end
+
+    get search_path(q: "ChronoUnique")
+    assert_response :success
+
+    assert_select ".search__title" do |elements|
+      titles = elements.map { |element| element.text.strip }
+      assert_equal [ "ChronoUnique newer", "ChronoUnique older" ], titles
+    end
+  end
+
+  test "only returns cards from boards the user currently has access to" do
+    private_card = nil
+    with_current_user :kevin do
+      private_card = boards(:private).cards.create!(title: "PrivateUnique secret", status: :published, creator: users(:kevin))
+    end
+
+    get search_path(q: "PrivateUnique")
+    assert_response :success
+    assert_select "mark", text: "PrivateUnique"
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "PrivateUnique")
+    assert_response :success
+    assert_select "mark", count: 0
+    assert_select ".search__result", count: 0
+  end
+
+  test "never returns draft cards" do
+    boards(:writebook).cards.create!(title: "DraftTitleUnique", status: :drafted, creator: users(:kevin))
+
+    get search_path(q: "DraftTitleUnique")
+    assert_response :success
+    assert_select "mark", count: 0
+    assert_select ".search__result", count: 0
+  end
+
+  test "never returns draft cards matched only by comments" do
+    with_current_user :kevin do
+      card = boards(:writebook).cards.create!(title: "Invisible draft", status: :published, creator: users(:kevin))
+      card.comments.create!(body: "DraftBodyUnique", creator: users(:kevin))
+      card.update_column(:status, "drafted")
+    end
+
+    get search_path(q: "DraftBodyUnique")
+    assert_response :success
+    assert_select "mark", count: 0
+    assert_select ".search__result", count: 0
+  end
+end
