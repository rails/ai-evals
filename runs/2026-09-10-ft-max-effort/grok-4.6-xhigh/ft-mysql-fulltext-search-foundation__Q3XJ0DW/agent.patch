--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,15 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from cards
+  end
+
+  private
+    def cards
+      Current.user.accessible_cards
+        .published
+        .search(@query)
+        .reverse_chronologically
+        .includes(:board, :rich_text_description, comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..3ad8a12
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,31 @@
+module SearchesHelper
+  def highlighted_search_text(text, query)
+    highlight(text.to_s, search_words(query))
+  end
+
+  def highlighted_search_snippets(card, query)
+    search_snippet_texts(card, query).filter_map do |text|
+      if snippet = excerpt(text, query, radius: 80)
+        highlighted_search_text(snippet, query)
+      end
+    end
+  end
+
+  private
+    def search_words(query)
+      query.to_s.split
+    end
+
+    def search_snippet_texts(card, query)
+      return [] if query.blank?
+
+      texts = []
+      texts << card.description.to_plain_text if card.description.present?
+
+      card.comments.each do |comment|
+        texts << comment.body.to_plain_text if comment.body.present?
+      end
+
+      texts.select { |text| text.downcase.include?(query.downcase) }
+    end
+end
