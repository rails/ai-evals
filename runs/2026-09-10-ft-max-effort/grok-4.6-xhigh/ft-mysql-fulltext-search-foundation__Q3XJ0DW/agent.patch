diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..612beeb
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,23 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) {
+      if query.blank?
+        none
+      else
+        where(id: matching_ids_for(query))
+      end
+    }
+  end
+
+  class_methods do
+    def matching_ids_for(query)
+      pattern = "%#{sanitize_sql_like(query)}%"
+
+      Card.left_joins(:rich_text_description, comments: :rich_text_body)
+        .where("cards.title LIKE :q ESCAPE '\\' OR action_text_rich_texts.body LIKE :q ESCAPE '\\' OR rich_text_bodies_comments.body LIKE :q ESCAPE '\\'", q: pattern)
+        .select(:id)
+    end
+  end
+end
