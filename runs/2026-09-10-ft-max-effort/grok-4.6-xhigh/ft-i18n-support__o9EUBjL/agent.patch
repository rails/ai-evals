diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..a712cfe
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,33 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function currentLocale() {
+  return getMetaContent("locale") || "en-US"
+}
+
+export function translations() {
+  const json = document.getElementById("i18n-translations")
+  if (!json) return {}
+  try {
+    return JSON.parse(json.textContent)
+  } catch {
+    return {}
+  }
+}
+
+export function t(key, replacements = {}) {
+  const value = key.split(".").reduce((acc, part) => acc && acc[part], translations())
+  if (typeof value !== "string") return ""
+
+  return value.replace(/%\{(\w+)\}/g, (_, name) => replacements[name] ?? "")
+}
+
+export function tCount(key, count) {
+  const node = key.split(".").reduce((acc, part) => acc && acc[part], translations())
+  if (!node || typeof node !== "object") {
+    const str = t(key, { count })
+    return str
+  }
+
+  const form = count === 1 && node.one ? node.one : (node.other || node.one || "")
+  return form.replace(/%\{count\}/g, count)
+}
