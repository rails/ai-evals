diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..0ad97c7
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,82 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  LOCALES = {
+    "en" => "en-US",
+    "ja" => "ja-JP"
+  }.freeze
+
+  included do
+    around_action :reset_locale_after_request
+    helper_method :current_locale, :javascript_locale, :javascript_translations
+
+    etag { current_locale }
+  end
+
+  private
+    def set_locale
+      persist_requested_locale
+      I18n.locale = current_locale
+    end
+
+    def reset_locale_after_request
+      yield
+    ensure
+      I18n.locale = I18n.default_locale
+    end
+
+    def persist_requested_locale
+      return unless requested_locale
+
+      session[:locale] = requested_locale
+      persist_locale_to_identity(Current.identity)
+    end
+
+    def current_locale
+      @current_locale ||= begin
+        locale = requested_locale || session_locale || identity_locale
+        valid_locale?(locale) ? locale.to_sym : I18n.default_locale
+      end
+    end
+
+    def requested_locale
+      locale = params[:locale]
+      locale if locale.is_a?(String) && valid_locale?(locale)
+    end
+
+    def session_locale
+      locale = session[:locale]
+      locale if valid_locale?(locale)
+    end
+
+    def identity_locale
+      locale = Current.identity&.locale
+      locale if valid_locale?(locale)
+    end
+
+    def persist_locale_to_identity(identity)
+      return unless identity && session[:locale].present? && valid_locale?(session[:locale])
+      return if identity.locale == session[:locale]
+
+      identity.update_column(:locale, session[:locale])
+    end
+
+    def restore_identity_locale_to_session(identity)
+      return unless identity&.locale.present? && valid_locale?(identity.locale)
+      return if session[:locale].present?
+
+      session[:locale] = identity.locale
+    end
+
+    def valid_locale?(locale)
+      locale.present? && I18n.available_locales.map(&:to_s).include?(locale.to_s)
+    end
+
+    def javascript_locale
+      LOCALES.fetch(I18n.locale.to_s, LOCALES["en"])
+    end
+
+    def javascript_translations
+      I18n.t("javascript")
+    end
+end
