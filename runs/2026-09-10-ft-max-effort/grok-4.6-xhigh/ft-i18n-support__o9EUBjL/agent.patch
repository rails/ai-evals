diff --git a/test/controllers/concerns/localization_test.rb b/test/controllers/concerns/localization_test.rb
new file mode 100644
index 0000000..f36edc9
--- /dev/null
+++ b/test/controllers/concerns/localization_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "default locale is english and pages still contain english copy" do
+    get root_path
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_includes response.body, "Skip to main content"
+    assert_not_includes response.body, "メインコンテンツへスキップ"
+  end
+
+  test "opening a page with locale=ja switches to japanese" do
+    get root_path, params: { locale: "ja" }
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "メインコンテンツへスキップ"
+    assert_not_includes response.body, "Skip to main content"
+  end
+
+  test "locale choice sticks for the rest of the session" do
+    get root_path, params: { locale: "ja" }
+    assert_select "html[lang=ja]"
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "メインコンテンツへスキップ"
+  end
+
+  test "unknown locale does not switch or break the page" do
+    get root_path, params: { locale: "xx" }
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_includes response.body, "Skip to main content"
+  end
+
+  test "locale persists on the identity for the next sign in" do
+    get root_path, params: { locale: "ja" }
+    assert_equal "ja", identities(:david).reload.locale
+
+    sign_out
+    reset!
+
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+    sign_in_as :david
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "メインコンテンツへスキップ"
+  end
+
+  test "people who never chose a locale keep english" do
+    assert_nil identities(:david).locale
+
+    get root_path
+    assert_select "html[lang=en]"
