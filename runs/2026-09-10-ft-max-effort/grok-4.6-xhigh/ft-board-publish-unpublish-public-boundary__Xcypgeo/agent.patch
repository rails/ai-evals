+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show without authentication" do
+    get public_board_card_path(@board.publication.key, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+  end
+
+  test "show as JSON without authentication" do
+    get public_board_card_path(@board.publication.key, @card), as: :json
+
+    assert_response :success
+    assert_equal @card.number, @response.parsed_body["number"]
