diff --git a/app/controllers/concerns/public_board_scoped.rb b/app/controllers/concerns/public_board_scoped.rb
new file mode 100644
index 0000000..d9d7b4e
--- /dev/null
+++ b/app/controllers/concerns/public_board_scoped.rb
@@ -0,0 +1,30 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    skip_before_action :require_account
+
+    before_action :set_public_board
+
+    layout "public"
+  end
+
+  private
+    def set_public_board
+      @board = public_boards.joins(:publication).find_by!(board_publications: { key: public_board_key })
+      Current.account ||= @board.account
+    end
+
+    def public_boards
+      if Current.account
+        Current.account.boards
+      else
+        Board.all
+      end
+    end
+
+    def public_board_key
+      params[:board_key] || params[:key]
+    end
+end
