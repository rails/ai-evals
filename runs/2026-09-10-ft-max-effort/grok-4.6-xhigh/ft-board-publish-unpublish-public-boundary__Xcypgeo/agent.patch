+      <% end %>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to share a secret URL with anyone.</p>
+      <%= button_to board_publication_path(board), method: :post, class: "btn" do %>
+        <span>Publish board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
