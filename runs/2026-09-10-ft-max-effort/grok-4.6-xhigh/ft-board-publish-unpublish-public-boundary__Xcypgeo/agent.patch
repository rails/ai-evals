+  test "show rejects unknown card numbers" do
+    get public_board_card_path(@board.publication.key, 999)
+
+    assert_response :not_found
+  end
+
+  test "show for an unpublished board" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_card_path(key, @card)
+
+    assert_response :not_found
+  end
+end
