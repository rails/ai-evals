@@ -0,0 +1,24 @@
+# Secrets defined here are available for reference under registry/password,
+# env/secret, builder/secrets, and accessories/*/env/secret in config/deploy.yml.
+#
+# Fill these in before running `bin/kamal setup`. Pull values from a password
+# manager, the environment, or a file. Do not commit raw credentials.
+
+# Docker Hub / GHCR access token
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Generate with: bin/rails secret
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for your SMTP server
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional, for browser push notifications (see docs/development.md):
+# VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+# VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+
+# Example: extract secrets from 1Password (or another compatible pw manager)
+# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE SMTP_PASSWORD)
+# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE ${SECRETS})
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD ${SECRETS})
