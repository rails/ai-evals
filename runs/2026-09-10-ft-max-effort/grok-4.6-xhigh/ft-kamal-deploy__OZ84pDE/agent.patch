diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..e70190d
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,116 @@
+# One-box Kamal deploy for Fizzy.
+#
+# Target: a single Linux server with Docker. SQLite, Active Storage, the web
+# process, and background jobs all run in one container. kamal-proxy terminates
+# SSL. Data lives on a Docker volume so it survives the next deploy.
+#
+# After you fork this repo, fill in:
+#   1. Your hostname (servers, proxy.host, APP_HOST)
+#   2. Your mail server (SMTP_* and MAILER_FROM_ADDRESS)
+#   3. Your secrets in .kamal/secrets
+#
+# Then run:
+#   bin/kamal setup
+#
+# Fizzy will be at https://your-host.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (use your-user/fizzy on Docker Hub, or
+# your-github-user/fizzy with registry.server: ghcr.io).
+image: your-user/fizzy
+
+# Deploy to this server. Use the hostname or IP you SSH to.
+servers:
+  web:
+    - fizzy.example.com
+  # Everything runs in the web container (Solid Queue inside Puma).
+  # Split jobs out only when you grow beyond one box:
+  # job:
+  #   hosts:
+  #     - fizzy.example.com
+  #   cmd: bin/jobs
+
+# SSL via Let's Encrypt on kamal-proxy. DNS for this host must point at the
+# server. Using an SSL proxy requires assume_ssl / force_ssl (already on in
+# production.rb). If you use Cloudflare, set SSL/TLS encryption mode to "Full".
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Where you keep your container images.
+registry:
+  # Alternatives: registry.digitalocean.com / ghcr.io / ...
+  # server: ghcr.io
+
+  username: your-user
+
+  # Always use an access token rather than a real password when possible.
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Optional, for browser push notifications:
+    # - VAPID_PRIVATE_KEY
+    # - VAPID_PUBLIC_KEY
+  clear:
+    # Run Solid Queue inside Puma so jobs share the web container.
+    # Puma already enables this for OSS unless SOLID_QUEUE_IN_PUMA=false.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Public hostname used for links in emails, webhooks, and exports.
+    APP_HOST: fizzy.example.com
+
+    # From-address for magic links and notifications.
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@example.com>"
+
+    # Outgoing mail server. Password is in .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: you@example.com
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS_AUTO: true
+    # SMTP_TLS: true  # for implicit TLS on port 465
+
+    # Set number of processes dedicated to Solid Queue (default: 1 per CPU).
+    # JOB_CONCURRENCY: 3
+
+    # Set number of cores available to the application on each server.
+    # WEB_CONCURRENCY: 2
+
+    # Log everything from Rails
+    # RAILS_LOG_LEVEL: debug
+
+# Aliases are triggered with "bin/kamal <alias>". You can overwrite arguments
+# on invocation: "bin/kamal logs -r job" will tail logs from the first job host.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Persistent volume for SQLite databases and local Active Storage files.
+# Recommended to change this to a mounted path that is backed up off server.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64
+
+  # Build image via remote server (useful for faster amd64 builds on arm64).
+  # remote: ssh://docker@docker-builder-server
+
+# Use a different ssh user than root
+# ssh:
+#   user: app
