@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @due = accounts(:initech)
+    @recent = accounts(:"37s")
+    @active = accounts(:acme)
+
+    cancel @due, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago, by: users(:mike)
+    cancel @recent, at: 1.day.ago, by: users(:david)
+  end
+
+  test "incinerates accounts cancelled longer ago than the grace period" do
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@due.id)
+    assert_empty User.where(account_id: @due.id)
+    assert_empty Account::Cancellation.where(account_id: @due.id)
+  end
+
+  test "leaves recently cancelled and active accounts alone" do
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(@recent.id)
+    assert @recent.reload.cancelled?
+    assert Account.exists?(@active.id)
+  end
+
+  test "is performed later without an account context" do
+    Current.without_account do
+      assert_enqueued_with job: Account::IncinerateDueJob, queue: "backend" do
+        Account::IncinerateDueJob.perform_later
+      end
+    end
+
+    perform_enqueued_jobs only: Account::IncinerateDueJob
+
+    assert_not Account.exists?(@due.id)
+    assert Account.exists?(@recent.id)
+  end
+
+  private
+    def cancel(account, at:, by:)
+      account.cancel(initiated_by: by)
+      account.cancellation.update!(created_at: at)
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..2958433
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled longer ago than the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_includes Account.due_for_incineration, @account
+    assert @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes accounts still within the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes active accounts" do
+    assert_empty Account.due_for_incineration
+    assert_not @account.due_for_incineration?
+  end
+
+  test "incinerate removes the account and everything associated with it" do
+    Current.set(account: @account, user: @user) do
+      cards(:logo).image.attach(io: StringIO.new("image data"), filename: "logo.png", content_type: "image/png")
+    end
+    perform_enqueued_jobs
+
+    cancel @account, at: 31.days.ago
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+    perform_enqueued_jobs
+
+    assert_not Account.exists?(@account.id)
+    assert_no_rows_left_for @account
+    assert Account.exists?(accounts(:initech).id)
+    assert Identity.exists?(identities(:david).id)
+  end
+
+  test "incinerate purges blobs that were never attached" do
+    blob = Current.with_account(@account) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("orphan"), filename: "orphan.txt", content_type: "text/plain")
+    end
+
+    cancel @account, at: 31.days.ago
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob, args: [ blob ] do
+      @account.incinerate
+    end
+  end
+
+  test "incinerate does nothing to an active account" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate does nothing while the grace period is running" do
+    cancel @account, at: 29.days.ago
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  test "incinerate does nothing to an account reactivated after being found due" do
+    cancel @account, at: 31.days.ago
+    stale_account = Account.due_for_incineration.first
+
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      stale_account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate_due incinerates every due account and nothing else" do
+    due = accounts(:initech)
+    recent = @account
+    active = accounts(:acme)
+
+    cancel due, at: 31.days.ago, by: users(:mike)
+    cancel recent, at: 1.day.ago
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(due.id)
+    assert Account.exists?(recent.id)
+    assert Account.exists?(active.id)
+  end
+
+  private
+    def cancel(account, at:, by: @user)
+      account.cancel(initiated_by: by)
+      account.cancellation.update!(created_at: at)
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    end
+
+    def assert_no_rows_left_for(account)
+      ApplicationRecord.connection.tables.each do |table|
+        next unless ApplicationRecord.connection.columns(table).any? { it.name == "account_id" }
+
+        remaining = Class.new(ApplicationRecord) { self.table_name = table }.where(account_id: account.id).count
+        assert_equal 0, remaining, "Expected no #{table} rows for the incinerated account"
+      end
+
+      assert_empty Storage::Total.where(owner: account)
+    end
+end
