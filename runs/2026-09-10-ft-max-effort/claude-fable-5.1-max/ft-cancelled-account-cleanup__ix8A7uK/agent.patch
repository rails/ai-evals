diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..bd824be 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,44 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  # Permanently removes the account and everything associated with it. Only cancelled accounts
+  # whose grace period has elapsed are incinerated, so an account reactivated in the meantime
+  # is left alone.
+  def incinerate
+    with_lock do
+      if due_for_incineration?
+        purge_unattached_blobs
+        delete_storage_entries
+        destroy!
+      end
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    # Blobs uploaded but never attached to anything aren't reached by the dependent
+    # destroys. Attached blobs are purged by their attachments.
+    def purge_unattached_blobs
+      ActiveStorage::Blob.where(account: self).unattached.find_each(&:purge_later)
+    end
+
+    # The storage ledger is shared with boards, so it isn't a dependent association.
+    def delete_storage_entries
+      Storage::Entry.where(account: self).delete_all
+    end
 end
