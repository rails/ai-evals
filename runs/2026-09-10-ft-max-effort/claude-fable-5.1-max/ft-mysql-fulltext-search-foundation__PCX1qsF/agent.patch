diff --git a/app/models/concerns/searchable.rb b/app/models/concerns/searchable.rb
new file mode 100644
index 0000000..97d687c
--- /dev/null
+++ b/app/models/concerns/searchable.rb
@@ -0,0 +1,18 @@
+# Shared by the models that take part in card search. Including models
+# define a +matching(term)+ scope; this concern composes it across terms.
+module Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search,       ->(terms) { terms.present? ? Array(terms).reduce(all) { |records, term| records.matching(term) } : none }
+    scope :matching_any, ->(terms) { Array(terms).collect { matching(it) }.reduce(:or) || none }
+  end
+
+  class_methods do
+    # Case-insensitive "contains" predicate for LIKE. The escape character is
+    # spelled out because SQLite, unlike MySQL, has none by default.
+    def contains(attribute, term)
+      attribute.matches("%#{sanitize_sql_like(term)}%", "\\")
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..bb9156a
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,26 @@
+# A search someone runs across the cards they can currently see. Every word in
+# the query must appear somewhere in a card—its title, description, or any of
+# its comments—for the card to match. Drafts never turn up.
+class Search
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user, @query = user, query.to_s.squish
+  end
+
+  def terms
+    @terms ||= query.split.uniq(&:downcase)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    user.accessible_cards.published.search(terms).reverse_chronologically.preload(:board, :column, :closure).with_rich_text_description
+  end
+
+  def comments_matching_in(cards)
+    Comment.where(card_id: cards.map(&:id)).matching_any(terms).chronologically.preload(:creator, :rich_text_body).group_by(&:card_id)
+  end
+end
