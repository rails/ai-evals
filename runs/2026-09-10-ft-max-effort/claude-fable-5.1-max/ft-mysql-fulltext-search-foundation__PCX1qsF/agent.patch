+<% @page_title = @search.blank? ? "Search" : "Search for “#{@search.query}”" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless unpad">
+  <%= form_with url: search_path, method: :get, class: "search__form" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards by title, description, or comments…",
+          class: "input", autofocus: true, autocomplete: "off", autocorrect: "off", aria: { label: "Search cards" }, data: { "1p-ignore": "true" } %>
+    <button type="submit" class="btn">
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    </button>
+  <% end %>
+
+  <% if @search.blank? %>
+    <div class="search__blank-slate blank-slate">Type a word or two to find cards by what’s in them</div>
+  <% elsif @page.empty? %>
+    <div class="search__blank-slate blank-slate">No cards match “<%= @search.query %>”</div>
+  <% else %>
+    <%= with_automatic_pagination :search_results, @page, class: "search__results" do %>
+      <%= render partial: "searches/show/card", collection: @page.records, as: :card,
+            locals: { search: @search, comments_by_card: @search.comments_matching_in(@page.records) } %>
+    <% end %>
+  <% end %>
+</section>
