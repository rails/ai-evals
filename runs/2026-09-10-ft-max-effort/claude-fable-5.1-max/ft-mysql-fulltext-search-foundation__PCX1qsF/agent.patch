+<% comments = comments_by_card.fetch(card.id, []) %>
+
+<%= tag.article id: dom_id(card, :search_result), class: [ "card", "card--search-result", { "card--closed": card.closed? } ], style: "--card-color: #{card.color}" do %>
+  <header class="card__header">
+    <div class="card__board">
+      <span class="card__id">
+        <span class="for-screen-reader">Card number</span>
+        <%= card.number %>
+      </span>
+      <span class="card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </span>
+    </div>
+
+    <div class="card__search-meta flex-item-grow txt-align-end">
+      <%= local_datetime_tag card.created_at, style: :timeordate %>
+    </div>
+  </header>
+
+  <div class="card__body">
+    <h3 class="card__title">
+      <%= link_to highlight_search_terms(card.title, search.terms), card_path(card), class: "card__search-link", data: { turbo_frame: "_top" } %>
+    </h3>
+
+    <% if description = search_excerpt(card.description.to_plain_text, search.terms) %>
+      <p class="card__search-excerpt"><%= description %></p>
+    <% end %>
+
+    <% comments.first(SearchesController::COMMENTS_PER_CARD).each do |comment| %>
+      <p class="card__search-excerpt card__search-comment">
+        <%= link_to card_path(card, anchor: dom_id(comment)), class: "card__search-link", data: { turbo_frame: "_top" } do %>
+          <strong><%= comment.creator.name %></strong>
+          <%= search_excerpt(comment.body.to_plain_text, search.terms, radius: 80) || truncate(comment.body.to_plain_text.squish, length: 160, omission: "…") %>
+        <% end %>
+      </p>
+    <% end %>
+
+    <% if comments.size > SearchesController::COMMENTS_PER_CARD %>
+      <p class="card__search-excerpt translucent">
+        <%= link_to "+ #{pluralize(comments.size - SearchesController::COMMENTS_PER_CARD, "more matching comment")}", card_path(card), data: { turbo_frame: "_top" } %>
+      </p>
+    <% end %>
+  </div>
+<% end %>
