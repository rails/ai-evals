 ```
 
+## `GET /:account_slug/search`
+
+Searches the cards you have access to by what is in them: the title, the description, and the body of any comment. Every word in the query must appear somewhere on a card for it to match. Draft cards never appear. Results come newest first and are paginated like `GET /:account_slug/cards`.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `q` | The words to search for |
+
+Example:
+- `q=logo+contrast` — cards mentioning both "logo" and "contrast"
+
+__Response:__
+
+Same shape as `GET /:account_slug/cards`.
+
 ## `GET /:account_slug/cards/:card_number`
 
 Returns a specific card by its number.
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e5c6395
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+
+    assert_select "input[name=q]"
+    assert_select "article", count: 0
+  end
+
+  test "show finds cards by title and marks the matched words" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "article", count: 1
+    assert_select "article .card__title a[href=?]", card_path(cards(:logo)) do
+      assert_select "mark", text: "logo"
+    end
+  end
+
+  test "show finds cards by description and marks the matched words in an excerpt" do
+    with_current_user(:kevin) do
+      cards(:layout).update!(description: "<div>The <strong>sidebar</strong> is squished</div>")
+    end
+
+    get search_path(q: "sidebar")
+    assert_response :success
+
+    assert_select "article", count: 1
+    assert_select "article .card__title", text: "Layout is broken"
+    assert_select "article .card__search-excerpt mark", text: "sidebar"
+  end
+
+  test "show finds cards by comment body and marks the matched words in the comment" do
+    get search_path(q: "agree")
+    assert_response :success
+
+    assert_select "article", count: 1
+    assert_select "article .card__title", text: "The logo isn't big enough"
+    assert_select "article .card__search-comment a[href=?]", card_path(cards(:logo), anchor: dom_id(comments(:logo_agreement_jz))) do
+      assert_select "mark", text: "agree"
+    end
+  end
+
+  test "show requires every word to match" do
+    get search_path(q: "logo agree")
+    assert_select "article", count: 1
+
+    get search_path(q: "logo overflowing")
+    assert_select "article", count: 0
+    assert_select ".blank-slate", text: /No cards match/
+  end
+
+  test "show lists newest cards first" do
+    with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "Older zebra", status: "published", created_at: 2.days.ago)
+      boards(:writebook).cards.create!(title: "Newer zebra", status: "published", created_at: 1.day.ago)
+    end
+
+    get search_path(q: "zebra")
+    assert_equal [ "Newer zebra", "Older zebra" ], css_select("article .card__title").map { it.text.squish }
+  end
+
+  test "show only includes cards from boards the user has access to" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret logo plans", status: "published")
+    end
+
+    get search_path(q: "logo")
+    assert_select "article", count: 2
+
+    logout_and_sign_in_as :david
+    get search_path(q: "logo")
+    assert_select "article", count: 1
+    assert_select "article .card__title", text: "Secret logo plans", count: 0
+  end
+
+  test "show stops including cards once access is revoked" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret logo plans", status: "published")
+    end
+
+    get search_path(q: "secret")
+    assert_select "article", count: 1
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path(q: "secret")
+    assert_select "article", count: 0
+  end
+
+  test "show never includes drafts or their comments" do
+    with_current_user(:kevin) do
+      card = boards(:writebook).cards.create!(title: "Logo draft", status: "published")
+      card.comments.create!(body: "A wombat comment")
+      card.update_column :status, "drafted"
+    end
+
+    get search_path(q: "logo")
+    assert_select "article", count: 1
+    assert_select "article .card__title", text: "Logo draft", count: 0
+
+    get search_path(q: "wombat")
+    assert_select "article", count: 0
+  end
+
+  test "show escapes card content" do
+    with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "<script>alert('xylo')</script> xylo", status: "published")
+    end
+
+    get search_path(q: "xylo")
+    assert_no_match "<script>", response.body
+    assert_select "article mark", text: "xylo", count: 2
+  end
+
+  test "show caps the comments listed per card" do
+    with_current_user(:kevin) do
+      5.times { |i| cards(:shipping).comments.create!(body: "Comment #{i} mentions a xylophone") }
+    end
+
+    get search_path(q: "xylophone")
+    assert_select "article", count: 1
+    assert_select ".card__search-comment", count: SearchesController::COMMENTS_PER_CARD
+    assert_select "a[href=?]", card_path(cards(:shipping)), text: "+ 2 more matching comments"
+  end
+
+  test "show paginates" do
+    with_current_user(:kevin) do
+      20.times { |i| boards(:writebook).cards.create!(title: "Card #{i} about quokkas", status: "published") }
+    end
+
+    get search_path(q: "quokkas")
+    assert_select "article", count: 15
+    assert_select "a.pagination-link[href*=?][href*=?]", "page=2", "q=quokkas"
+
+    get search_path(q: "quokkas", page: 2)
+    assert_select "turbo-frame#search_results-pagination-contents-2"
+    assert_select "article", count: 5
+  end
+
+  test "show as JSON" do
+    get search_path(q: "agree", format: :json)
+    assert_response :success
+
+    assert_equal [ cards(:logo).number ], @response.parsed_body.pluck("number")
+  end
+
+  test "show requires signing in" do
+    sign_out
+
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..f9ac23d
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlight wraps every match in mark, case insensitively" do
+    assert_equal "The <mark>logo</mark> isn&#39;t <mark>big</mark> enough. <mark>LOGO</mark>!",
+      highlight_search_terms("The logo isn't big enough. LOGO!", %w[ logo big ])
+  end
+
+  test "highlight escapes the text and leaves it alone without matches" do
+    assert_equal "a &lt;b&gt; c", highlight_search_terms("a <b> c", %w[ zzz ])
+    assert_equal "a &lt;b&gt; c", highlight_search_terms("a <b> c", [])
+    assert_equal "", highlight_search_terms(nil, %w[ a ])
+  end
+
+  test "highlight never splits an escaped entity" do
+    assert_equal "1 &lt; 2 <mark>lt</mark>", highlight_search_terms("1 < 2 lt", %w[ lt ])
+  end
+
+  test "highlight treats terms literally" do
+    assert_equal "<mark>a.b</mark> axb <mark>(c)</mark>", highlight_search_terms("a.b axb (c)", %w[ a.b (c) ])
+  end
+
+  test "highlight output is html safe" do
+    assert_predicate highlight_search_terms("logo", %w[ logo ]), :html_safe?
+  end
+
+  test "excerpt surrounds the first match and marks all terms" do
+    text = "#{"lorem " * 30}the needle in the haystack #{"ipsum " * 30}"
+
+    assert_equal "…rem lorem lorem the <mark>needle</mark> in the <mark>haystack</mark> ips…",
+      search_excerpt(text, %w[ needle haystack ], radius: 20)
+  end
+
+  test "excerpt squishes whitespace and is nil without a match" do
+    assert_equal "one <mark>two</mark> three", search_excerpt("one\n\n  two   three", %w[ two ])
+    assert_nil search_excerpt("nothing here", %w[ zzz ])
+  end
+end
