+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "matching by title" do
+    assert_includes Card.matching("logo"), cards(:logo)
+    assert_not_includes Card.matching("logo"), cards(:layout)
+  end
+
+  test "matching is case insensitive" do
+    assert_includes Card.matching("LOGO"), cards(:logo)
+  end
+
+  test "matching by description" do
+    cards(:layout).update!(description: "<div>The <strong>sidebar</strong> is squished</div>")
+
+    assert_includes Card.matching("sidebar"), cards(:layout)
+    assert_not_includes Card.matching("sidebar"), cards(:logo)
+  end
+
+  test "matching by comment body" do
+    assert_includes Card.matching("overflowing"), cards(:layout)
+    assert_not_includes Card.matching("overflowing"), cards(:logo)
+  end
+
+  test "LIKE wildcards in the term are taken literally" do
+    hundred = boards(:writebook).cards.create!(title: "Sales grew 100% last year", status: "published")
+    boards(:writebook).cards.create!(title: "Sales grew 1000 last year", status: "published")
+    underscored = boards(:writebook).cards.create!(title: "Rename a_b", status: "published")
+    boards(:writebook).cards.create!(title: "Rename aXb", status: "published")
+
+    assert_equal [ hundred ], Card.matching("100%").to_a
+    assert_equal [ underscored ], Card.matching("a_b").to_a
+    assert_empty Card.matching("\\")
+  end
+
+  test "search requires every term to match, anywhere on the card" do
+    assert_includes Card.search(%w[ logo agree ]), cards(:logo)
+    assert_not_includes Card.search(%w[ logo overflowing ]), cards(:logo)
+    assert_empty Card.search(%w[ logo nonsense ])
+  end
+
+  test "search for no terms finds nothing" do
+    assert_empty Card.search([])
+    assert_empty Card.search(nil)
+  end
+
+  test "comments matching any term" do
+    matches = Comment.matching_any(%w[ agree overflowing ])
+
+    assert_includes matches, comments(:logo_agreement_jz)
+    assert_includes matches, comments(:layout_overflowing_david)
+    assert_not_includes matches, comments(:logo_agreement_kevin)
+    assert_empty Comment.matching_any([])
+  end
+end
