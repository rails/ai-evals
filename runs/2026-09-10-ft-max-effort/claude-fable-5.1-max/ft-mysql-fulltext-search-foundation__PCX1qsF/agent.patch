diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..a6c7a0c
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,19 @@
+module SearchesHelper
+  # Wraps every occurrence of the terms in <mark>, escaping everything else.
+  def highlight_search_terms(text, terms)
+    segments = text.to_s.split(search_terms_pattern(terms))
+    safe_join segments.map.with_index { |segment, index| index.odd? ? tag.mark(segment) : segment }
+  end
+
+  # A stretch of text around the first match, with the terms marked. Nil when nothing matches.
+  def search_excerpt(text, terms, radius: 100)
+    if excerpt = excerpt(text.to_s.squish, search_terms_pattern(terms), radius: radius, omission: "…")
+      highlight_search_terms excerpt, terms
+    end
+  end
+
+  private
+    def search_terms_pattern(terms)
+      Regexp.new("(#{Regexp.union(terms).source})", Regexp::IGNORECASE)
+    end
+end
