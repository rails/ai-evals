@@ -0,0 +1,59 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "terms are the distinct words in the query" do
+    assert_equal %w[ logo big ], Search.new(users(:kevin), "  logo   big LOGO ").terms
+    assert Search.new(users(:kevin), "   ").blank?
+    assert Search.new(users(:kevin), nil).blank?
+    assert_not Search.new(users(:kevin), "logo").blank?
+  end
+
+  test "cards found by title, description, or comment" do
+    cards(:text).update!(description: "<div>Bump the font size</div>")
+
+    assert_equal [ cards(:logo) ], Search.new(users(:kevin), "logo").cards.to_a
+    assert_equal [ cards(:text) ], Search.new(users(:kevin), "font").cards.to_a
+    assert_equal [ cards(:layout) ], Search.new(users(:kevin), "overflowing").cards.to_a
+  end
+
+  test "cards come newest first" do
+    older = boards(:writebook).cards.create!(title: "Older zebra", status: "published", created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Newer zebra", status: "published", created_at: 1.day.ago)
+
+    assert_equal [ newer, older ], Search.new(users(:kevin), "zebra").cards.to_a
+  end
+
+  test "cards only from boards the user currently has access to" do
+    secret = boards(:private).cards.create!(title: "Secret logo plans", status: "published")
+
+    assert_includes Search.new(users(:kevin), "logo").cards, secret
+    assert_not_includes Search.new(users(:david), "logo").cards, secret
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+    assert_not_includes Search.new(users(:kevin), "logo").cards, secret
+  end
+
+  test "drafts and their comments never turn up" do
+    card = boards(:writebook).cards.create!(title: "Logo draft", status: "published")
+    card.comments.create!(body: "A wombat comment")
+    card.update_column :status, "drafted"
+
+    assert_not_includes Search.new(users(:kevin), "logo").cards, card
+    assert_empty Search.new(users(:kevin), "wombat").cards
+  end
+
+  test "blank search finds nothing" do
+    assert_empty Search.new(users(:kevin), "").cards
+  end
+
+  test "comments matching in cards, grouped by card" do
+    grouped = Search.new(users(:kevin), "agree overflowing").comments_matching_in([ cards(:logo), cards(:layout) ])
+
+    assert_equal [ comments(:logo_agreement_jz) ], grouped[cards(:logo).id]
+    assert_equal [ comments(:layout_overflowing_david) ], grouped[cards(:layout).id]
+  end
+end
