+++ b/app/models/card/searchable.rb
@@ -0,0 +1,16 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    include ::Searchable
+
+    # A card matches a term when it appears in the title, the description, or any of its comments.
+    scope :matching, ->(term) do
+      descriptions = ActionText::RichText.where(record_type: "Card", name: "description")
+
+      where(contains(arel_table[:title], term))
+        .or(where(id: descriptions.where(contains(descriptions.arel_table[:body], term)).select(:record_id)))
+        .or(where(id: Comment.matching(term).select(:card_id)))
+    end
+  end
+end
