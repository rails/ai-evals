diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..8ca436b
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,127 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves items between drop zones by dragging them around. A dropped item lands in its new zone
+// right away, before the request that saves the move is answered, so nothing waits on the server.
+//
+// Zones declare that request with data-drop-url (rendered for a ":card_id" placeholder, filled in
+// with the dropped item's data-card-id) and data-drop-method.
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer", "stickyItem" ]
+  static targets = [ "item", "dropzone", "list" ]
+
+  #draggedItem = null
+
+  disconnect() {
+    this.#finishDragging()
+  }
+
+  dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    if (!item) return
+
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    this.#useAsDragImage(item, event)
+    this.#dimAfterDragImageIsTaken(item)
+  }
+
+  dragOver(event) {
+    if (!this.#draggedItem) return
+
+    const dropzone = this.#dropzoneContaining(event.target)
+    this.#highlight(dropzone)
+
+    if (dropzone) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const dropzone = this.#dropzoneContaining(event.target)
+    if (!item || !dropzone) return
+
+    event.preventDefault()
+    this.#finishDragging()
+    this.#move(item, dropzone)
+  }
+
+  dragEnd() {
+    this.#finishDragging()
+  }
+
+  // Private
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  // An item can't be dropped back into the zone it's being dragged from: zones keep their own order.
+  #dropzoneContaining(element) {
+    return this.dropzoneTargets.find(dropzone => dropzone.contains(element) && !dropzone.contains(this.#draggedItem))
+  }
+
+  #useAsDragImage(item, event) {
+    const { left, top } = item.getBoundingClientRect()
+    event.dataTransfer.setDragImage(item, event.clientX - left, event.clientY - top)
+  }
+
+  // The browser snapshots the drag image right after dragstart, so dim the item only once that's done.
+  async #dimAfterDragImageIsTaken(item) {
+    await nextFrame()
+    if (this.#draggedItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  #highlight(dropzone) {
+    this.dropzoneTargets.forEach(zone => zone.classList.toggle(this.hoverContainerClass, zone === dropzone))
+  }
+
+  #finishDragging() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#highlight(null)
+  }
+
+  async #move(item, dropzone) {
+    const undo = this.#place(item, dropzone)
+    const response = await this.#save(item, dropzone).catch(() => null)
+
+    if (!response?.ok) undo()
+  }
+
+  // A moved item is the most recent one, so it goes on top; only sticky items stay above it.
+  #place(item, dropzone) {
+    const { parentNode, nextSibling } = item
+    const items = this.itemTargets.filter(other => dropzone.contains(other))
+    const successor = items.find(other => this.#isSticky(item) || !this.#isSticky(other))
+
+    if (successor) {
+      successor.before(item)
+    } else if (items.length) {
+      items.at(-1).after(item)
+    } else {
+      this.#listIn(dropzone)?.prepend(item)
+    }
+
+    return () => parentNode.insertBefore(item, nextSibling?.parentNode === parentNode ? nextSibling : null)
+  }
+
+  #isSticky(item) {
+    return this.hasStickyItemClass && item.classList.contains(this.stickyItemClass)
+  }
+
+  #listIn(dropzone) {
+    return this.listTargets.find(list => dropzone.contains(list))
+  }
+
+  #save(item, dropzone) {
+    const { dropUrl, dropMethod = "post" } = dropzone.dataset
+    const url = dropUrl.replace(":card_id", encodeURIComponent(item.dataset.cardId))
+
+    return new FetchRequest(dropMethod, url, { responseKind: "turbo-stream" }).perform()
+  }
+}
