+    draft = Current.set(user: users(:kevin)) { @board.cards.create!(title: "Secret draft", status: "drafted") }
+
+    get public_board_path(@board.publication.key)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@board.publication, draft), count: 0
+    assert_no_match "Secret draft", response.body
+  end
+
+  test "show when signed in" do
+    sign_in_as :kevin
+
+    get public_board_path(@board.publication.key)
+
+    assert_response :success
+  end
+
+  test "show works with the publication as param" do
+    get public_board_path(@board.publication)
+
+    assert_response :success
+  end
+
+  test "show with an unknown key" do
+    get public_board_path("unknown")
+
+    assert_response :not_found
+  end
+
+  test "show an unpublished board" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_path(key)
+
+    assert_response :not_found
+  end
+
+  test "show a board published in another account" do
+    board = boards(:miltons_wish_list)
