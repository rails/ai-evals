diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..f4164a3
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,38 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <% if board.published? %>
+      <% url = public_board_url(board.publication) %>
+      <p class="margin-none-block-start">Anyone with this link can see this board and its cards, without signing in.</p>
+
+      <div class="flex align-center gap-half margin-block-end">
+        <input type="text" class="input flex-item-grow txt-small" value="<%= url %>" readonly aria-label="Public link">
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+
+      <div class="flex align-center gap">
+        <%= link_to url, class: "btn", target: "_blank", data: { turbo: false } do %>
+          <%= icon_tag "globe" %>
+          <span>Open public board</span>
+        <% end %>
+
+        <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative", disabled: !Current.user.admin?,
+              form: { data: { turbo_confirm: "Are you sure you want to unpublish this board? The public link will stop working." } } do %>
+          <%= icon_tag "lock" %>
+          <span>Unpublish</span>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="margin-none-block-start">Publishing this board creates a secret link that lets anyone see it and its cards, without signing in. Only admins can publish boards.</p>
+
+      <%= button_to board_publication_path(board), method: :post, class: "btn", disabled: !Current.user.admin? do %>
+        <%= icon_tag "globe" %>
+        <span>Publish this board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
