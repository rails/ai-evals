diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..7b01bab
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,24 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  def publish
+    create_publication! unless published?
+  end
+
+  def unpublish
+    if published?
+      publication.destroy
+      reset_publication
+    end
+  end
+
+  def published?
+    publication.present?
+  end
+end
