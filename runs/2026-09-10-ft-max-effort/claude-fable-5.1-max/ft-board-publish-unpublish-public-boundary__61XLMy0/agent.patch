+      Current.account.cancel(initiated_by: users(:kevin))
+    end
+    assert_not Current.account.active?
+
+    get public_board_path(@board.publication.key)
+
+    assert_response :not_found
+  end
+
+  test "show links to the current public key even when partials are cached" do
+    with_actionview_partial_caching do
+      get public_board_path(@board.publication)
+      assert_response :success
+      assert_select "a[href=?]", public_board_column_path(@board.publication, columns(:writebook_triage))
+
+      @board.unpublish
+      @board.publish
+
+      get public_board_path(@board.publication)
+      assert_response :success
+      assert_select "a[href=?]", public_board_column_path(@board.publication, columns(:writebook_triage))
+      assert_select "a[href=?]", public_board_card_path(@board.publication, cards(:buy_domain))
+    end
+  end
+
+  test "show is fresh" do
