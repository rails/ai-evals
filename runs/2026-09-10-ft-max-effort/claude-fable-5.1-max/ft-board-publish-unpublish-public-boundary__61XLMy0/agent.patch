@@ -0,0 +1,23 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    layout "public"
+
+    before_action :ensure_account_is_active, :set_board
+  end
+
+  private
+    def ensure_account_is_active
+      head :not_found unless Current.account.active?
+    end
+
+    def set_board
+      @board = Current.account.boards.published.find_by!(board_publications: { key: public_board_key })
+    end
+
+    def public_board_key
+      params[:board_key] || params[:key]
+    end
+end
