+    assert_response :not_modified
+
+    Current.set(user: users(:kevin)) { @board.cards.create!(title: "Another one", status: "published") }
+
+    get public_board_path(@board.publication.key), headers: { "If-None-Match" => etag }
+    assert_response :success
+  end
+end
