diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..c9c39f9
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_not_includes Board.published, @board
+  end
+
+  test "publishing creates a publication with a secret key" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.publication.key.present?
+    assert_equal @board.account, @board.publication.account
+    assert_includes Board.published, @board
+  end
+
+  test "publishing an already published board keeps the same key" do
+    @board.publish
+    key = @board.publication.key
+
+    @board.publish
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublishing destroys the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_not_includes Board.published, @board
+  end
+
+  test "republishing after unpublishing generates a new key" do
+    @board.publish
+    key = @board.publication.key
+
+    @board.unpublish
+    @board.publish
+
+    assert @board.published?
+    assert_not_equal key, @board.publication.key
+    assert_equal 1, Board::Publication.count
+  end
+
+  test "unpublishing an unpublished board is a no-op" do
+    assert_no_difference -> { Board::Publication.count } do
+      @board.unpublish
+    end
+  end
+
+  test "publishing and unpublishing touch the board" do
+    updated_at = @board.updated_at
+
+    travel 1.minute do
+      @board.publish
+      assert_not_equal updated_at, @board.reload.updated_at
+    end
+
+    updated_at = @board.updated_at
+
+    travel 2.minutes do
+      @board.unpublish
+      assert_not_equal updated_at, @board.reload.updated_at
+    end
+  end
+
+  test "publications are destroyed along with the board" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "publication key is used as param" do
+    @board.publish
+
+    assert_equal @board.publication.key, @board.publication.to_param
+  end
+
+  test "published cards on a published board are publicly accessible" do
+    card = cards(:logo)
+    assert_not card.publicly_accessible?
+    assert_not comments(:logo_1).publicly_accessible?
+
+    @board.publish
+    assert card.reload.publicly_accessible?
+    assert comments(:logo_1).reload.publicly_accessible?
+
+    draft = @board.cards.create!(title: "Draft", status: "drafted", creator: users(:kevin))
+    assert_not draft.publicly_accessible?
+  end
+end
