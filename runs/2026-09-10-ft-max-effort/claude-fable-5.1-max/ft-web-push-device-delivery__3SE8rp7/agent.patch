@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/kevin", p256dh_key: "p256dh", auth_key: "auth", user_agent: "Chrome")
+  end
+
+  test "belongs to the user's account" do
+    assert_equal accounts(:"37s"), @subscription.account
+  end
+
+  test "deliver sends the payload to the endpoint, signed with the VAPID key pair" do
+    WebPush.expects(:payload_send).with(
+      message: "payload", endpoint: "https://push.example.com/send/kevin", p256dh: "p256dh", auth: "auth",
+      vapid: { subject: Push.vapid.subject, public_key: Push.vapid.public_key, private_key: Push.vapid.private_key })
+
+    @subscription.deliver("payload")
+  end
+
+  test "deliver drops the subscription once the push service says it's gone" do
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: ""), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver("payload")
+    end
+  end
+
+  test "deliver drops the subscription the push service doesn't know" do
+    WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(stub(body: ""), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver("payload")
+    end
+  end
+
+  test "deliver surfaces other push service errors" do
+    WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(stub(body: ""), "push.example.com"))
+
+    assert_no_difference -> { Push::Subscription.count } do
+      assert_raises WebPush::PushServiceError do
+        @subscription.deliver("payload")
+      end
+    end
+  end
+
+  test "destroyed along with the user" do
+    assert_difference -> { Push::Subscription.count }, -1 do
+      users(:kevin).destroy
+    end
+  end
+end
diff --git a/test/models/push_test.rb b/test/models/push_test.rb
new file mode 100644
