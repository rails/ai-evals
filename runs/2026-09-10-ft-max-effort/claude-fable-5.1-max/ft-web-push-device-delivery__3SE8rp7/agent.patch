index 0000000..4ddf7bc
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @user = users(:kevin)
+    @subscription = { endpoint: "https://push.example.com/send/kevin", p256dh_key: "p256dh", auth_key: "auth" }
+  end
+
+  test "create registers this device for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, headers: { "User-Agent" => "Chrome on macOS" }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/send/kevin", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal "Chrome on macOS", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create as JSON, the way the browser hands over its subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create doesn't register the same device twice" do
+    @user.push_subscriptions.create!(@subscription)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }
+    end
+
+    assert_response :created
+  end
+
+  test "create requires the whole subscription" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.except(:auth_key) }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create is only for yourself" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: { push_subscription: @subscription }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create requires signing in" do
+    sign_out
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }
+    end
+
+    assert_response :redirect
+  end
+end
diff --git a/test/models/notification/pushing_test.rb b/test/models/notification/pushing_test.rb
new file mode 100644
index 0000000..5229b49
--- /dev/null
+++ b/test/models/notification/pushing_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @subscription = @kevin.push_subscriptions.create!(endpoint: "https://push.example.com/send/kevin", p256dh_key: "p256dh", auth_key: "auth")
+    notifications(:layout_commented_kevin).destroy
+  end
+
+  test "creating a notification pushes it" do
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "renotifying pushes again" do
+    notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    notification.read
+
+    assert_enqueued_with job: Notification::PushJob do
+      notification.source_type_will_change!
+      notification.update!(source: events(:layout_published), read_at: nil, unread_count: notification.unread_count + 1)
+    end
+  end
+
+  test "marking a notification unread again doesn't push" do
+    notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    notification.read
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.unread
+    end
+  end
+
+  test "nothing to push without subscriptions" do
+    @subscription.destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "nothing to push without a VAPID key pair" do
+    Push.stubs(enabled?: false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "a notification read before the push goes out stays quiet" do
+    notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    notification.read
+
+    WebPush.expects(:payload_send).never
+
+    perform_enqueued_jobs only: Notification::PushJob
+  end
+
+  test "a push says what the tray says about an event and opens its card" do
+    notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+
+    payload = deliver_push_for(notification)
+
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal comments(:layout_overflowing_david).body.to_plain_text.truncate(200), payload["body"]
+    assert_equal "#{accounts(:"37s").slug}/cards/#{cards(:layout).number}##{dom_id(comments(:layout_overflowing_david))}", payload["path"]
+    assert_equal dom_id(notification), payload["tag"]
+  end
+
+  test "a push says what the tray says about a mention" do
+    notification = notifications(:logo_mentioned_david)
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/send/david", p256dh_key: "p256dh", auth_key: "auth")
+
+    payload = deliver_push_for(notification)
+
+    assert_equal "JZ @mentioned you", payload["title"]
+    assert_equal comments(:logo_agreement_jz).mentionable_content.truncate(200), payload["body"]
+    assert_equal "#{accounts(:"37s").slug}/cards/#{cards(:logo).number}##{dom_id(comments(:logo_agreement_jz))}", payload["path"]
+  end
+
+  test "pushes reach every device the user turned on" do
+    @kevin.push_subscriptions.create!(endpoint: "https://push.example.com/send/kevin-phone", p256dh_key: "p256dh", auth_key: "auth")
+    Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+
+    endpoints = []
+    WebPush.stubs(:payload_send).with { |**options| endpoints << options[:endpoint] }
+
+    perform_enqueued_jobs only: Notification::PushJob
+
+    assert_equal [ "https://push.example.com/send/kevin", "https://push.example.com/send/kevin-phone" ], endpoints.sort
+  end
+
+  test "the push job carries the notification's account into its links" do
+    Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+
+    payload = nil
+    WebPush.stubs(:payload_send).with { |**options| payload = JSON.parse(options[:message]) }
+
+    Current.account = nil
+    perform_enqueued_jobs only: Notification::PushJob
+
+    assert payload["path"].start_with?("#{accounts(:"37s").slug}/cards/"), "Expected an account-scoped path, got #{payload["path"]}"
+  end
+
+  private
+    def deliver_push_for(notification)
+      payload = nil
+      WebPush.stubs(:payload_send).with { |**options| payload = JSON.parse(options[:message]) }
+      notification.push_now
+      payload
+    end
+
+    def dom_id(record)
+      ActionView::RecordIdentifier.dom_id(record)
+    end
+end
