--- /dev/null
+++ b/test/models/push_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class PushTest < ActiveSupport::TestCase
+  test "enabled with a VAPID key pair" do
+    assert Push.enabled?
+  end
+
+  test "disabled without a VAPID key pair" do
+    with_vapid_key_pair(public_key: nil, private_key: nil) do
+      assert_not Push.enabled?
+    end
+
+    with_vapid_key_pair(public_key: nil, private_key: Push.vapid.private_key) do
+      assert_not Push.enabled?
+    end
+  end
+
+  private
+    def with_vapid_key_pair(public_key:, private_key:)
+      original = Push.vapid.to_h
+      Push.vapid.public_key, Push.vapid.private_key = public_key, private_key
+      yield
+    ensure
+      Push.vapid.merge!(original)
+    end
+end
