+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  test "turning on push notifications in a browser that blocks them" do
+    sign_in_as(users(:david))
+    visit notifications_settings_url
+
+    within "[data-controller='notifications']" do
+      assert_selector "h2", text: "Push Notifications"
+      assert_button "Turn on notifications for this device"
+      assert_no_selector "[data-notifications-target='details']", visible: :visible
+    end
+    assert_no_selector ".notifications--on"
+    assert_equal "default", evaluate_script("Notification.permission")
+
+    click_on "Turn on notifications for this device" # The test browser denies every permission prompt
+
+    within "[data-controller='notifications']" do
+      assert_selector "[data-notifications-target='details']", text: "Notifications are blocked for Fizzy in this browser."
+      assert_selector ".notifications-help h3", text: "Turn on notifications for this website."
+      assert_no_button "Turn on notifications for this device"
+    end
+    assert_no_selector ".notifications--on"
+    assert_equal "denied", evaluate_script("Notification.permission")
