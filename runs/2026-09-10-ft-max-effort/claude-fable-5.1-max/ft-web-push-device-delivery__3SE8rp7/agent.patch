+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions.find_or_create_by!(push_subscription_params) do |subscription|
+      subscription.user_agent = request.user_agent
+    end
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..484f839
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,111 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns web push on for this device: asks for permission, subscribes the service worker
+// with the app's VAPID key, and hands the subscription to the server.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "button", "details", "unsupported" ]
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+
+  async connect() {
+    if (this.#supported) {
+      await this.#refresh()
+    } else {
+      this.buttonTarget.hidden = true
+      this.unsupportedTarget.hidden = false
+    }
+  }
+
+  async subscribe() {
+    this.buttonTarget.disabled = true
+
+    try {
+      if (await Notification.requestPermission() === "granted") {
+        await this.#subscribe()
+      }
+    } catch (error) {
+      console.error("Couldn’t turn on push notifications", error)
+    } finally {
+      this.buttonTarget.disabled = false
+      await this.#refresh()
+    }
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // A device counts as on once the server knows about its subscription, so an existing
+  // subscription is synced again on every visit—it may have been made from another account.
+  async #refresh() {
+    this.#blocked = Notification.permission === "denied"
+
+    try {
+      const subscription = await this.#currentSubscription()
+      this.#on = !!subscription
+      if (subscription) this.#on = await this.#sync(subscription)
+    } catch (error) {
+      console.error("Couldn’t check push notifications", error)
+      this.#on = false
+    }
+  }
+
+  async #currentSubscription() {
+    if (Notification.permission === "granted") {
+      const subscription = await (await this.#registration()).pushManager.getSubscription()
+      return subscription && this.#signedWithOurKey(subscription) ? subscription : null
+    }
+  }
+
+  async #subscribe() {
+    const registration = await this.#registration()
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription && !this.#signedWithOurKey(subscription)) {
+      await subscription.unsubscribe()
+    }
+
+    await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+  }
+
+  async #sync(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } }
+    })
+
+    return response.ok
+  }
+
+  async #registration() {
+    if (!await navigator.serviceWorker.getRegistration("/")) {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    }
+
+    return navigator.serviceWorker.ready
+  }
+
+  #signedWithOurKey(subscription) {
+    const ours = this.#applicationServerKey
+    const theirs = new Uint8Array(subscription.options.applicationServerKey ?? [])
+
+    return theirs.length === ours.length && theirs.every((byte, index) => byte === ours[index])
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+
+  set #on(on) {
+    this.element.classList.toggle(this.onClass, on)
+  }
+
+  set #blocked(blocked) {
+    this.buttonTarget.hidden = blocked
+    this.detailsTargets.forEach(target => target.hidden = !blocked)
+  }
+}
