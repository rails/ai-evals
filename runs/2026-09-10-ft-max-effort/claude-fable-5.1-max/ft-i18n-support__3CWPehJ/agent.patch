--- a/test/mailers/magic_link_mailer_test.rb
+++ b/test/mailers/magic_link_mailer_test.rb
@@ -14,3 +14,45 @@ class MagicLinkMailerTest < ActionMailer::TestCase
     assert_match magic_link.code, email.body.encoded
   end
 end
+
+class MagicLinkMailerLocaleTest < ActionMailer::TestCase
+  test "speaks the language the recipient chose" do
+    identities(:kevin).update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyの認証コードは #{ magic_link.code } です", email.subject
+    assert_match "認証コード", email.html_part.body.to_s
+    assert_match "認証コード", email.text_part.body.to_s
+    assert_match '<html lang="ja">', email.html_part.body.to_s
+  end
+
+  test "falls back to the language of the request for newcomers without a saved choice" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = I18n.with_locale(:ja) { MagicLinkMailer.sign_in_instructions(magic_link).tap(&:message) }
+    assert_equal "Fizzyの認証コードは #{ magic_link.code } です", email.subject
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_equal "Your Fizzy code is #{ magic_link.code }", email.subject
+  end
+
+  test "delivers later in the language of the request that asked for it" do
+    identities(:kevin).update!(locale: nil)
+
+    I18n.with_locale(:ja) { identities(:kevin).send_magic_link }
+    perform_enqueued_jobs
+
+    assert_match "認証コード", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "keeps English for people who never chose anything" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is #{ magic_link.code }", email.subject
+    assert_match "Fizzy verification code", email.html_part.body.to_s
+    assert_match '<html lang="en">', email.html_part.body.to_s
+  end
+end
diff --git a/test/mailers/notification/bundle_mailer_locale_test.rb b/test/mailers/notification/bundle_mailer_locale_test.rb
new file mode 100644
index 0000000..98610a6
--- /dev/null
+++ b/test/mailers/notification/bundle_mailer_locale_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Notification::BundleMailerLocaleTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.notifications.destroy_all
+    @bundle = Notification::Bundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+  end
+
+  test "renders the digest in the language the recipient chose, dates included" do
+    @user.identity.update!(locale: "ja")
+    create_notification
+
+    email = Notification::BundleMailer.notification(@bundle)
+
+    assert_equal "Fizzy: 新しい通知", email.subject
+    assert_match "以降の通知", email.html_part.body.to_s
+    assert_match(/\d+月\d+日（.曜日）\d+時/, email.html_part.body.to_s)
+    assert_no_match(/Notifications since/, email.html_part.body.to_s)
+  end
+
+  test "renders the digest in English when nothing was chosen" do
+    create_notification
+
+    email = Notification::BundleMailer.notification(@bundle)
+
+    assert_equal "Fizzy: New notifications", email.subject
+    assert_match "Notifications since", email.html_part.body.to_s
+    assert_match "1 new notification", email.html_part.body.to_s
+  end
+
+  private
+    def create_notification
+      event = events(:logo_assignment_david)
+      Notification.create!(user: @user, creator: event.creator, source: event, card: event.card)
+    end
+end
