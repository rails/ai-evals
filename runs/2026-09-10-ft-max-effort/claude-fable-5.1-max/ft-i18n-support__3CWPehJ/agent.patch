diff --git a/test/controllers/concerns/current_locale_test.rb b/test/controllers/concerns/current_locale_test.rb
new file mode 100644
index 0000000..41bec49
--- /dev/null
+++ b/test/controllers/concerns/current_locale_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class CurrentLocaleTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "pages render in English when nobody chose anything" do
+    get cards_path
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "h1", text: "all boards"
+    assert_select "a.header__skip-navigation", text: "Skip to main content"
+  end
+
+  test "switches to Japanese with the locale param and remembers the choice for the session" do
+    get cards_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "すべてのボード"
+    assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+
+    get cards_path
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "すべてのボード"
+    assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+  end
+
+  test "persists the choice on the identity so it survives signing in from a clean browser" do
+    get cards_path(locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    reset!
+    sign_in_as :kevin
+
+    get cards_path
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "すべてのボード"
+    assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+  end
+
+  test "remembers the choice for anonymous visitors" do
+    sign_out
+
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "ignores locales that are not offered" do
+    get cards_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "h1", text: "all boards"
+    assert_select "a.header__skip-navigation", text: "Skip to main content"
+    assert_nil identities(:kevin).reload.locale
+
+    get cards_path(locale: [ "ja" ])
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "switching back to English sticks too" do
+    get cards_path(locale: "ja")
+    get cards_path(locale: "en")
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+
+  test "remembers the choice even when the page redirects" do
+    get landing_path(locale: "ja")
+    assert_response :redirect
+    follow_redirect!
+    assert_select "html[lang=ja]"
+  end
+
+  test "localizes the web app manifest" do
+    get pwa_manifest_path(format: :json)
+    assert_equal "en", response.parsed_body["lang"]
+    assert_equal "Notifications", response.parsed_body["shortcuts"].first["name"]
+
+    get cards_path(locale: "ja")
+    get pwa_manifest_path(format: :json)
+    assert_equal "ja", response.parsed_body["lang"]
+    assert_equal "通知", response.parsed_body["shortcuts"].first["name"]
+  end
+
+  test "static error pages speak both languages" do
+    %w[ 400 404 406-unsupported-browser 422 500 ].each do |page|
+      html = Rails.public_path.join("#{page}.html").read
+      assert_match(/Back home/, html)
+      assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, html)
+      assert_match(/lang="ja"/, html)
+    end
+  end
+
+  test "includes the locale in the ETag" do
+    get user_avatar_path(users(:kevin))
+    etag = response.headers.fetch("ETag")
+
+    get user_avatar_path(users(:kevin), locale: "ja")
+    assert_response :success
+    assert_not_equal etag, response.headers.fetch("ETag")
+  end
+
+  test "does not leak the locale into other requests" do
+    get cards_path(locale: "ja")
+
+    reset!
+    sign_in_as :david
+    get cards_path
+    assert_select "html[lang=en]"
+  end
+end
diff --git a/test/mailers/magic_link_mailer_test.rb b/test/mailers/magic_link_mailer_test.rb
