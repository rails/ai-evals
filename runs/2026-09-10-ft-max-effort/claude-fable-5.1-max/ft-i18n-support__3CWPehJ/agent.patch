--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,8 @@
+// The server renders <html lang="…"> in the locale the person chose. English is served
+// as en-US so browser date formatting matches what Fizzy has always shown.
+const INTL_LOCALES = { en: "en-US" }
+
+export function currentLocale() {
+  const lang = document.documentElement.lang || "en"
+  return INTL_LOCALES[lang] || lang
+}
