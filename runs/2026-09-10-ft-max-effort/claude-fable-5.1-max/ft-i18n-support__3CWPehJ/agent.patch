diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..e1cc0ea
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,34 @@
+# Renders every request in the language the person chose. `?locale=ja` on any page switches and
+# remembers the choice: in the session for everyone, and on the identity for people who are signed in,
+# so it follows them to their next sign-in. Unknown locales are ignored. Without a choice, the default applies.
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_current_locale
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&)
+      remember_requested_locale
+      I18n.with_locale(current_locale, &)
+    end
+
+    def remember_requested_locale
+      if locale = available_locale(params[:locale])
+        session[:locale] = locale
+        Current.identity&.update!(locale: locale)
+      end
+    end
+
+    def current_locale
+      available_locale(Current.identity&.locale) || available_locale(session[:locale]) || I18n.default_locale
+    end
+
+    def available_locale(locale)
+      locale.to_s.presence_in(I18n.available_locales.map(&:to_s))
+    end
+end
