diff --git a/app/jobs/account/incinerate_due_job.rb b/app/jobs/account/incinerate_due_job.rb
new file mode 100644
index 0000000..1de9c98
--- /dev/null
+++ b/app/jobs/account/incinerate_due_job.rb
@@ -0,0 +1,17 @@
+class Account::IncinerateDueJob < ApplicationJob
+  queue_as :backend
+
+  def perform
+    Account.due_for_incineration.find_each do |account|
+      incinerate(account)
+    end
+  end
+
+  private
+    # Report and move on, so one account that can't be incinerated doesn't hold up the rest
+    def incinerate(account)
+      account.incinerate
+    rescue => error
+      Rails.error.report(error, context: { account_id: account.id })
+    end
+end
