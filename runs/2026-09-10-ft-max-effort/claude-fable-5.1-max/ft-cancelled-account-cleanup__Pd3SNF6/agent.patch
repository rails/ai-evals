diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..122a29b
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @due = accounts(:"37s")
+    @due.cancel(initiated_by: users(:david))
+    @due.cancellation.update!(created_at: 31.days.ago)
+
+    @recently_cancelled = accounts(:initech)
+    @recently_cancelled.cancel(initiated_by: users(:mike))
+    @recently_cancelled.cancellation.update!(created_at: 29.days.ago)
+
+    @active = accounts(:acme)
+  end
+
+  test "incinerates accounts cancelled longer ago than the grace period and no other" do
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@due.id)
+    assert_empty User.where(account_id: @due.id)
+    assert_empty Board.where(account_id: @due.id)
+    assert_empty Card.where(account_id: @due.id)
+
+    assert @recently_cancelled.reload.cancelled?
+    assert Account.exists?(@active.id)
+  end
+
+  test "reports accounts that can't be incinerated and carries on with the rest" do
+    @recently_cancelled.cancellation.update!(created_at: 31.days.ago)
+    Account.any_instance.stubs(:destroy!).raises(ActiveRecord::StatementInvalid, "Lock wait timeout exceeded")
+    Rails.error.expects(:report).twice.with { |error, **| error.is_a?(ActiveRecord::StatementInvalid) }
+
+    assert_nothing_raised do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@due.id)
+    assert Account.exists?(@recently_cancelled.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..af4dce5
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @account.cancel(initiated_by: users(:david))
+  end
+
+  test "due for incineration once the grace period has passed since cancellation" do
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+
+    @account.cancellation.update!(created_at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago)
+
+    assert_includes Account.due_for_incineration, @account
+    assert @account.due_for_incineration?
+  end
+
+  test "not due for incineration when reactivated" do
+    @account.cancellation.update!(created_at: 31.days.ago)
+    @account.reactivate
+    @account.reload
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "incinerate removes the account and everything in it" do
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty Board.where(account_id: @account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_empty Comment.where(account_id: @account.id)
+    assert_empty Event.where(account_id: @account.id)
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+  end
+
+  test "incinerate removes uploaded files and storage records" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    blob = card.image.blob
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_operator Storage::Entry.where(account_id: @account.id).count, :>, 0
+
+    perform_enqueued_jobs do
+      @account.incinerate
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+    assert_empty ActiveStorage::Attachment.where(account_id: @account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Storage::Total.where(owner: @account)
+  end
+
+  test "incinerate does nothing while still within the grace period" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate does nothing once reactivated, even through another instance" do
+    @account.cancellation.update!(created_at: 31.days.ago)
+    Account.find(@account.id).reactivate
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+end
