diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..366d123
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,31 @@
+# Keeps count of a webhook's consecutive failed deliveries so that a receiver
+# that keeps failing can be switched off. A webhook becomes delinquent once it
+# has failed FAILURE_THRESHOLD times in a row over a period of at least
+# GRACE_PERIOD. A single successful delivery resets the count.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  GRACE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    with_lock do
+      self.first_failure_at ||= Time.current
+      increment :consecutive_failures_count
+      save!
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil if failing?
+  end
+
+  def failing?
+    consecutive_failures_count.to_i.positive?
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_THRESHOLD && first_failure_at.present? && first_failure_at <= GRACE_PERIOD.ago
+  end
+end
