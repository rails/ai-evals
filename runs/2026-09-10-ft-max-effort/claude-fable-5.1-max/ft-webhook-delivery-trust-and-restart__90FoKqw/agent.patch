+class WebhookDeliveringTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+  end
+
+  test "deliver_later creates a delivery and enqueues its job for a subscribed event" do
+    event = events(:logo_published)
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        @webhook.deliver_later(event)
+      end
+    end
+
+    delivery = @webhook.deliveries.ordered.first
+    assert_equal event, delivery.event
+    assert_equal @webhook.account, delivery.account
+    assert delivery.pending?
+  end
+
+  test "deliver_later ignores events the webhook isn't subscribed to" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        @webhook.deliver_later(events(:layout_commented))
+      end
+    end
+  end
+
+  test "deliver_later does nothing for a switched off webhook" do
+    @webhook.deactivate
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        @webhook.deliver_later(events(:logo_published))
+      end
+    end
+  end
+
+  test "subscribed_to?" do
+    assert @webhook.subscribed_to?(events(:logo_published))
+    assert @webhook.subscribed_to?(events(:logo_assignment_jz))
+    assert_not @webhook.subscribed_to?(events(:layout_commented))
+    assert_not @webhook.subscribed_to?(events(:buy_domain_sent_back_to_triage))
+  end
+
+  test "signature_for is an HMAC-SHA256 of the body using the signing secret" do
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, "{}"), @webhook.signature_for("{}")
+    assert_not_equal @webhook.signature_for("{}"), webhooks(:inactive).signature_for("{}")
+  end
+
+  test "endpoint" do
+    assert_equal URI.parse(@webhook.url), @webhook.endpoint.uri
+  end
+end
