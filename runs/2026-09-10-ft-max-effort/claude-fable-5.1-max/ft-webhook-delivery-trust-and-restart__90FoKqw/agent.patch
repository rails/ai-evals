@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @subscribed = webhooks(:active)
+    @unsubscribed = @board.webhooks.create!(name: "Comments only", url: "https://comments.example.com/hook", subscribed_actions: %w[ comment_created ])
+    @switched_off = @board.webhooks.create!(name: "Switched off", url: "https://off.example.com/hook", subscribed_actions: %w[ card_published ], active: false)
+  end
+
+  test "creating an event queues a delivery for each active webhook subscribed to it" do
+    event = nil
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+        event = @board.events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+      end
+    end
+
+    delivery = event.webhook_deliveries.sole
+    assert_equal @subscribed, delivery.webhook
+    assert delivery.pending?
+    assert_empty @unsubscribed.deliveries
+    assert_empty @switched_off.deliveries
+  end
+
+  test "events nobody subscribed to don't queue anything" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        @board.events.create!(action: "card_triaged", creator: users(:david), eventable: cards(:logo), particulars: { column: "Doing" })
+      end
+    end
+  end
+
+  test "events on boards without webhooks don't queue anything" do
+    Current.user = users(:mike)
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      boards(:miltons_wish_list).events.create!(action: "card_published", creator: users(:mike), eventable: cards(:radio))
+    end
+  end
+
+  test "card activity ends up with the board's webhooks" do
+    Current.user = users(:david)
+
+    assert_difference -> { @subscribed.deliveries.count }, +1 do
+      @board.cards.create!(title: "Ship it", status: :published, creator: users(:david))
+    end
+
+    assert_equal "card_published", @subscribed.deliveries.ordered.first.event.action
+  end
+
+  test "system events raised outside of a request are delivered too" do
+    @subscribed.update! subscribed_actions: %w[ card_auto_postponed ]
+    card = cards(:logo)
+    card.update_columns last_active_at: 1.year.ago
+
+    stub_dns_resolution "93.184.216.34"
+    stub_request(:post, @subscribed.url).to_return(status: 200)
+
+    Current.without_account do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        Card.auto_postpone_all_due
+      end
+    end
+
+    assert_requested :post, @subscribed.url do |posted|
+      body = JSON.parse(posted.body)
+      body["action"] == "card_auto_postponed" && body.dig("eventable", "id") == card.id && body.dig("creator", "id") == card.account.system_user.id
+    end
+    assert @subscribed.deliveries.ordered.first.succeeded?
+  end
+
+  test "deliveries go along when their event is destroyed" do
+    event = @board.events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+
+    assert_difference -> { Webhook::Delivery.count }, -1 do
+      event.destroy
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..e3afaef
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @tracker = webhook_delinquency_trackers(:active)
+  end
+
+  test "created along with its webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "record_failure counts consecutive failures from the first one" do
+    freeze_time do
+      @tracker.record_failure
+
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+
+    travel 10.minutes do
+      @tracker.record_failure
+
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal 10.minutes.ago, @tracker.first_failure_at
+    end
+  end
+
+  test "reset clears the streak" do
+    2.times { @tracker.record_failure }
+    assert @tracker.failing?
+
+    @tracker.reset
+
+    assert_not @tracker.failing?
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "delinquent after ten consecutive failures spanning at least an hour" do
+    travel_to 61.minutes.ago do
+      @tracker.record_failure
+    end
+
+    8.times { @tracker.record_failure }
+    assert_not @tracker.delinquent?, "nine failures aren't enough"
+
+    @tracker.record_failure
+    assert @tracker.delinquent?
+  end
+
+  test "not delinquent when ten failures happen within the hour" do
+    travel_to 30.minutes.ago do
+      @tracker.record_failure
+    end
+
+    9.times { @tracker.record_failure }
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert_not @tracker.delinquent?
+  end
+
+  test "not delinquent when failing for over an hour but fewer than ten times" do
+    travel_to 2.hours.ago do
+      @tracker.record_failure
+    end
+
+    5.times { @tracker.record_failure }
+
+    assert_not @tracker.delinquent?
+  end
+
+  test "destroyed along with its webhook" do
+    webhook = @tracker.webhook
+
+    assert_difference -> { Webhook::DelinquencyTracker.count }, -1 do
+      webhook.destroy
+    end
+  end
+end
