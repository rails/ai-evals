+
+  test "slack payload is a message with a link" do
+    webhook = Webhook.new(url: "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx", board: boards(:writebook)) # gitleaks:allow
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal({ "text" => %(David added "The logo isn't big enough" <#{card_url(@card)}|↗︎>) }, JSON.parse(payload.body))
+  end
+
+  test "slack payload escapes what slack needs escaped" do
+    Current.user = users(:david)
+    @card.update! title: "Tom & Jerry <3 >:)"
+    webhook = Webhook.new(url: "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx", board: boards(:writebook)) # gitleaks:allow
+
+    text = JSON.parse(Webhook::Payload.new(webhook, @event.reload).body)["text"]
+
+    assert_includes text, "David added \"Tom &amp; Jerry &lt;3 &gt;:)\""
+  end
+
+  test "campfire payload is html" do
+    webhook = Webhook.new(url: "https://chat.example.com/rooms/1/2-abcdef/messages", board: boards(:writebook))
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "text/html", payload.content_type
+    assert_includes payload.body, "David added &quot;The logo isn&#39;t big enough&quot;"
+    assert_includes payload.body, %(<a href="#{card_url(@card)}">↗︎</a>)
+  end
+
+  test "basecamp payload is a chat line with html content" do
+    webhook = Webhook.new(url: "https://3.basecamp.com/999/integrations/some-token/buckets/111/chats/222/lines", board: boards(:writebook))
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "application/json", payload.content_type
+    content = JSON.parse(payload.body).fetch("content")
+    assert_includes content, "David added &quot;The logo isn&#39;t big enough&quot;"
+    assert_includes content, %(<a href="#{card_url(@card)}">↗︎</a>)
+  end
+
+  test "urls are absolute and account scoped" do
+    url = JSON.parse(Webhook::Payload.new(webhooks(:active), @event).body).dig("eventable", "url")
+
+    assert_equal "http://example.com#{accounts(:"37s").slug}/cards/#{@card.number}", url
+  end
+
+  private
+    def card_url(card)
+      Rails.application.routes.url_helpers.card_url(card, host: "example.com", script_name: card.account.slug)
+    end
+end
