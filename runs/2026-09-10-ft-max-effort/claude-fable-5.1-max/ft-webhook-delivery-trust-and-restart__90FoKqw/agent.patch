+++ b/app/models/event/relaying.rb
@@ -0,0 +1,18 @@
+# Relays events to the board's webhooks: one delivery per subscribed, active
+# webhook, each posted by its own job.
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :webhook_deliveries, class_name: "Webhook::Delivery", dependent: :delete_all
+
+    after_create_commit :relay_to_webhooks
+  end
+
+  private
+    def relay_to_webhooks
+      board.webhooks.active.each do |webhook|
+        webhook.deliver_later(self)
+      end
+    end
+end
