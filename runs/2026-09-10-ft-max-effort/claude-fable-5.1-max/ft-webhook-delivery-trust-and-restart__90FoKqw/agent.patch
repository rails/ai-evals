+require "test_helper"
+
+class Webhook::EndpointTest < ActiveSupport::TestCase
+  URL = "https://receiver.example.com/hooks?token=abc"
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @endpoint = Webhook::Endpoint.new(URL)
+    @headers = { "Content-Type" => "application/json" }
+  end
+
+  test "posts to the resolved public IP while talking to the hostname" do
+    stub_dns_resolution "10.0.0.5", PUBLIC_IP
+    request = stub_request(:post, URL).with(ipaddr: PUBLIC_IP, body: "{}", headers: @headers).to_return(status: 202)
+
+    response = @endpoint.post("{}", @headers)
+
+    assert_requested request
+    assert_equal "202", response.code
+  end
+
+  test "refuses destinations that only resolve to blocked addresses" do
+    stub_dns_resolution "127.0.0.1", "192.168.0.10", "::1"
+    request = stub_request(:post, URL)
+
+    error = assert_raises Webhook::Endpoint::Error do
+      @endpoint.post("{}", @headers)
+    end
+
+    assert_equal "destination_unreachable", error.reason
+    assert_equal "Destination unreachable", error.message
+    assert_not_requested request
+  end
+
+  test "refuses URLs without a host" do
+    error = assert_raises Webhook::Endpoint::Error do
+      Webhook::Endpoint.new("http:///hooks").post("{}", @headers)
+    end
+
+    assert_equal "destination_unreachable", error.reason
+  end
+
+  test "translates transport failures into reasons" do
+    stub_dns_resolution PUBLIC_IP
+
+    { Errno::ECONNREFUSED => "destination_unreachable",
+      Errno::EHOSTUNREACH => "destination_unreachable",
+      Errno::ENETUNREACH => "destination_unreachable",
+      SocketError => "destination_unreachable",
+      Net::OpenTimeout => "timeout",
+      Net::ReadTimeout => "timeout",
+      Errno::ETIMEDOUT => "timeout",
+      OpenSSL::SSL::SSLError => "ssl_error",
+      Errno::ECONNRESET => "connection_failed",
+      Errno::EPIPE => "connection_failed",
+      EOFError => "connection_failed",
+      Net::HTTPBadResponse => "connection_failed",
+      Zlib::DataError => "connection_failed" }.each do |exception, reason|
+      stub_request(:post, URL).to_raise(exception)
+
+      error = assert_raises(Webhook::Endpoint::Error, "#{exception} should be translated") { @endpoint.post("{}", @headers) }
+      assert_equal reason, error.reason, "#{exception} should be reported as #{reason}"
+    end
+  end
+
+  test "non-2xx responses are answers, not errors" do
+    stub_dns_resolution PUBLIC_IP
+    stub_request(:post, URL).to_return(status: 503)
+
+    assert_equal "503", @endpoint.post("{}", @headers).code
+  end
+end
