@@ -29,4 +53,40 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      if self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+        reload
+      end
+    end
+
+    def perform
+      payload = Webhook::Payload.new(webhook, event)
+      self.request = { headers: headers_for(payload) }
+
+      complete webhook.endpoint.post(payload.body, request[:headers])
+    rescue Webhook::Endpoint::Error => error
+      fail_with error.reason
+    rescue
+      fail_with "internal_error"
+      raise
+    end
+
+    def headers_for(payload)
+      {
+        "Content-Type" => payload.content_type,
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Signature" => webhook.signature_for(payload.body),
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+      }
+    end
+
+    def complete(http_response)
+      update! state: :completed, response: { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+    end
+
+    def fail_with(reason)
+      update! state: :errored, response: { error: reason }
+    end
 end
diff --git a/app/models/webhook/endpoint.rb b/app/models/webhook/endpoint.rb
new file mode 100644
index 0000000..b868508
--- /dev/null
+++ b/app/models/webhook/endpoint.rb
@@ -0,0 +1,68 @@
+# The URL a webhook posts to. Requests are pinned to a public IP address
+# resolved up front (see SsrfProtection), redirects are never followed, and
+# every transport failure surfaces as an Endpoint::Error with a reason that
+# can be logged on the delivery.
+class Webhook::Endpoint
+  class Error < StandardError
+    attr_reader :reason
+
+    def initialize(reason)
+      @reason = reason.to_s
+      super(@reason.humanize)
+    end
+  end
+
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
+  TRANSPORT_ERRORS = [
+    SocketError, SystemCallError, Timeout::Error, IOError, OpenSSL::SSL::SSLError,
+    Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, Net::ProtocolError, Zlib::Error
+  ].freeze
+
+  attr_reader :uri
+
+  def initialize(url)
+    @uri = URI.parse(url)
+  end
+
+  def post(body, headers)
+    connection.post(uri.request_uri, body, headers)
+  rescue *TRANSPORT_ERRORS => error
+    raise Error, reason_for(error)
+  end
+
+  private
+    def connection
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = public_ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = READ_TIMEOUT
+      end
+    end
+
+    def public_ip
+      resolve_public_ip or raise Error, :destination_unreachable
+    end
+
+    def resolve_public_ip
+      SsrfProtection.resolve_public_ip(uri.host) if uri.host.present?
+    rescue Resolv::ResolvError, SystemCallError
+      nil
+    end
+
+    def reason_for(error)
+      case error
+      when Timeout::Error, Errno::ETIMEDOUT
+        :timeout
+      when OpenSSL::SSL::SSLError
+        :ssl_error
+      when SocketError, Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH
+        :destination_unreachable
+      else
+        :connection_failed
+      end
+    end
+end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..da8104d
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,82 @@
+# What a webhook posts about an event. Chat receivers (Slack, Campfire, and
+# Basecamp chats) get a one-line message, everything else gets the JSON
+# representation of the event rendered by webhooks/event.json.jbuilder.
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def content_type
+    if webhook.for_campfire?
+      "text/html"
+    else
+      "application/json"
+    end
+  end
+
+  def body
+    @body ||= if webhook.for_slack?
+      { text: as_slack_text }.to_json
+    elsif webhook.for_basecamp?
+      { content: as_html }.to_json
+    elsif webhook.for_campfire?
+      as_html
+    else
+      as_json
+    end
+  end
+
+  private
+    def as_slack_text
+      "#{slack_escape(description)} <#{eventable_url}|↗︎>"
+    end
+
+    def as_html
+      render :html
+    end
+
+    def as_json
+      render :json
+    end
+
+    def description
+      CGI.unescapeHTML(event.description_for(nil).to_plain_text)
+    end
+
+    # Slack only wants these three characters escaped: https://api.slack.com/reference/surfaces/formatting#escaping
+    def slack_escape(text)
+      text.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
+    end
+
+    def eventable_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+    end
+
+    def render(format)
+      renderer.render template: "webhooks/event", formats: [ format ], assigns: { event: event }, layout: false
+    end
+
+    def renderer
+      ApplicationController.renderer.new(renderer_env)
+    end
+
+    def renderer_env
+      { script_name: url_options[:script_name] }.tap do |env|
+        if url_options[:host]
+          env[:http_host] = [ url_options[:host], url_options[:port] ].compact.join(":")
+          env[:https] = url_options[:protocol].to_s.start_with?("https")
+        end
+      end
+    end
+
+    def url_options
+      @url_options ||= default_url_options.merge(script_name: event.account.slug)
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence || {}
+    end
+end
