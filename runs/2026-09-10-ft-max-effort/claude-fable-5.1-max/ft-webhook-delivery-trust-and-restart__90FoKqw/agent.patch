+class WebhookDelinquencyTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+  end
+
+  test "creates its delinquency tracker" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_not webhook.delinquency_tracker.delinquent?
+  end
+
+  test "a webhook that somehow lacks a tracker gets one on demand" do
+    @webhook.delinquency_tracker.delete
+
+    assert_difference -> { Webhook::DelinquencyTracker.count }, +1 do
+      assert @webhook.reload.delinquency_tracker.persisted?
+    end
+  end
+
+  test "switched off after ten failed deliveries in a row over an hour" do
+    travel_to 2.hours.ago do
+      @webhook.track_delivery(failed_delivery)
+    end
+
+    8.times { @webhook.track_delivery(failed_delivery) }
+    assert @webhook.active?, "nine failures aren't enough"
+
+    @webhook.track_delivery(failed_delivery)
+    assert_not @webhook.active?
+    assert_not @webhook.reload.active?
+  end
+
+  test "stays on when ten deliveries fail in quick succession" do
+    10.times { @webhook.track_delivery(failed_delivery) }
+
+    assert @webhook.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "stays on when failing for over an hour but fewer than ten times" do
+    travel_to 2.hours.ago do
+      @webhook.track_delivery(failed_delivery)
+    end
+
+    3.times { @webhook.track_delivery(failed_delivery) }
+
+    assert @webhook.active?
+  end
+
+  test "a successful delivery ends the failure streak" do
+    travel_to 2.hours.ago do
+      9.times { @webhook.track_delivery(failed_delivery) }
+    end
+
+    @webhook.track_delivery(successful_delivery)
+    assert_not @webhook.delinquency_tracker.failing?
+
+    @webhook.track_delivery(failed_delivery)
+    assert @webhook.active?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "errored deliveries count as failures too" do
+    travel_to 2.hours.ago do
+      @webhook.track_delivery(webhook_deliveries(:errored))
+    end
+
+    9.times { @webhook.track_delivery(webhook_deliveries(:errored)) }
+
+    assert_not @webhook.active?
+  end
+
+  test "reactivating gives the receiver a clean slate" do
+    webhook = webhooks(:inactive)
+    assert webhook.delinquency_tracker.delinquent?
+
+    webhook.activate
+
+    assert webhook.active?
+    assert_not webhook.delinquency_tracker.failing?
+    assert_not webhook.delinquency_tracker.delinquent?
+  end
+
+  private
+    def failed_delivery
+      webhook_deliveries(:unsuccessfully_completed)
+    end
+
+    def successful_delivery
+      webhook_deliveries(:successfully_completed)
+    end
+end
