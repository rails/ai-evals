+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,23 @@
+module ReactionsHelper
+  def reactions_path_for(reactable, **options)
+    polymorphic_path([ *reactable_route_scope(reactable), :reactions ], **options)
+  end
+
+  def reactions_url_for(reactable, **options)
+    polymorphic_url([ *reactable_route_scope(reactable), :reactions ], **options)
+  end
+
+  def reaction_path_for(reaction, **options)
+    polymorphic_path([ *reactable_route_scope(reaction.reactable), reaction ], **options)
+  end
+
+  def reaction_url_for(reaction, **options)
+    polymorphic_url([ *reactable_route_scope(reaction.reactable), reaction ], **options)
+  end
+
+  private
+    # Reactions are nested under the card for cards and under the comment for comments
+    def reactable_route_scope(reactable)
+      reactable.is_a?(Card) ? [ reactable ] : [ reactable.card, reactable ]
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..002fb8c
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+// A single reaction. The markup is cached and shared by everyone, so whether a reaction is
+// the current user's own (and can be removed by clicking it) is worked out here.
+export default class extends Controller {
+  connect() {
+    this.refresh()
+  }
+
+  // Also called after a Turbo morph, which resets the classes to the server-rendered ones
+  refresh() {
+    this.element.classList.toggle("reaction--deleteable", this.#mine)
+  }
+
+  toggle(event) {
+    if (this.#mine && !event.target.closest(".reaction__delete")) {
+      this.element.classList.toggle("expanded")
+    }
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) {
+      this.element.classList.remove("expanded")
+    }
+  }
+
+  removing() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #mine() {
+    return this.element.dataset.creatorId === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..f4ee897
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,45 @@
+import { Controller } from "@hotwired/stimulus"
+
+// The reactions strip: a button that turns into a small form for adding a reaction, and back again.
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  expand() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.formTarget.reset()
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+  }
+
+  collapseAfterSubmit({ detail: { success } }) {
+    if (success) this.collapse()
+  }
+
+  cancel(event) {
+    if (this.#expanded) {
+      event.stopPropagation()
+      this.collapse()
+    }
+  }
+
+  pick({ params: { content } }) {
+    const value = this.inputTarget.value + content
+
+    if (value.length <= this.inputTarget.maxLength) {
+      this.inputTarget.value = value
+    }
+
+    this.inputTarget.focus()
+  }
+
+  get #expanded() {
+    return !this.formTarget.hidden
+  }
+}
