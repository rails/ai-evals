--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,50 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_reactable
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @reactable.reactions.preloaded.chronologically
+
+    fresh_when etag: @reactions
+  end
+
+  def create
+    @reaction = @reactable.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reactable
+      @reactable = @card
+    end
+
+    def set_reaction
+      @reaction = @reactable.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden unless @reaction.by?(Current.user)
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
