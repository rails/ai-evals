index 0000000..fb02a31
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "reacting to a comment" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal accounts(:"37s"), reaction.account
+    assert_equal cards(:logo), reaction.card
+    assert_equal [ reaction ], @comment.reload.reactions
+  end
+
+  test "reacting to a card" do
+    reaction = cards(:logo).reactions.create!(content: "Boost!")
+
+    assert_equal cards(:logo), reaction.card
+    assert_includes cards(:logo).reload.reactions, reaction
+  end
+
+  test "content is required" do
+    assert_not @comment.reactions.build(content: "").valid?
+    assert_not @comment.reactions.build(content: "   ").valid?
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert @comment.reactions.build(content: "🎉" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+  end
+
+  test "content is stripped of surrounding whitespace" do
+    assert_equal "Great 👍", @comment.reactions.create!(content: "  Great 👍 ").content
+  end
+
+  test "reacting touches the comment and registers activity on its card" do
+    card = @comment.card
+    @comment.update_columns(updated_at: 1.day.ago)
+    card.update_columns(updated_at: 1.day.ago, last_active_at: 1.day.ago)
+
+    @comment.reactions.create!(content: "👏")
+
+    assert @comment.reload.updated_at > 1.minute.ago
+    assert card.reload.updated_at > 1.minute.ago
+    assert card.last_active_at > 1.minute.ago
+  end
+
+  test "removing a reaction touches the comment" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up_by_david)
+    reaction.reactable.update_columns(updated_at: 1.day.ago)
+
+    reaction.destroy
+
+    assert reaction.reactable.reload.updated_at > 1.minute.ago
+  end
+
+  test "reactions are destroyed along with the comment" do
+    assert_difference -> { Reaction.count }, -2 do
+      comments(:logo_agreement_jz).destroy
+    end
+  end
+
+  test "reactions are destroyed along with the card" do
+    assert_difference -> { Reaction.count }, -3 do
+      cards(:logo).destroy
+    end
+  end
+
+  test "chronologically" do
+    assert_equal reactions(:logo_agreement_jz_thumbs_up_by_david, :logo_agreement_jz_nice_by_kevin),
+      comments(:logo_agreement_jz).reactions.chronologically.to_a
+  end
+
+  test "by?" do
+    assert reactions(:logo_agreement_jz_thumbs_up_by_david).by?(users(:david))
+    assert_not reactions(:logo_agreement_jz_thumbs_up_by_david).by?(users(:kevin))
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..30a946b
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,156 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+    @comment = comments(:layout_overflowing_david)
+  end
+
+  test "reacting to a comment" do
+    visit card_url(@card)
+
+    within_reactions_of @comment do
+      assert_no_selector ".reaction"
+      assert_no_field "Your reaction"
+
+      click_on "Add a reaction"
+      assert_no_selector ".reactions__trigger"
+      fill_in "Your reaction", with: "Love it 👍"
+      click_on "Add this reaction"
+
+      assert_selector ".reaction", text: "Love it 👍"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    reaction = @comment.reactions.sole
+    assert_equal "Love it 👍", reaction.content
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "picking an emoji" do
+    visit card_url(@card)
+
+    within_reactions_of @comment do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      click_on "Party popper"
+      assert_field "Your reaction", with: "🎉"
+      click_on "Add this reaction"
+
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    assert_equal "🎉", @comment.reactions.sole.content
+  end
+
+  test "canceling a reaction" do
+    visit card_url(@card)
+
+    within_reactions_of @comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Never mind"
+      click_on "Cancel"
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      click_on "Add a reaction"
+      assert_field "Your reaction", with: ""
+    end
+
+    assert_empty @comment.reactions
+  end
+
+  test "removing your own reaction" do
+    # Someone else's comment, so only the reaction's own creator id can determine ownership
+    comment = comments(:logo_agreement_jz)
+    mine = comment.reactions.create!(content: "Mine", reacter: users(:david))
+    theirs = comment.reactions.create!(content: "Theirs", reacter: users(:kevin))
+
+    visit card_url(cards(:logo))
+
+    within_reactions_of comment do
+      assert_selector "##{dom_id(mine)}.reaction--deleteable"
+      assert_no_selector "##{dom_id(theirs)}.reaction--deleteable"
+      assert_no_button "Remove your reaction"
+
+      find("##{dom_id(theirs)}").click
+      assert_no_button "Remove your reaction"
+
+      find("##{dom_id(mine)}").click
+      click_on "Remove your reaction"
+
+      assert_no_selector "##{dom_id(mine)}"
+      assert_selector "##{dom_id(theirs)}", text: "Theirs"
+    end
+
+    assert_not Reaction.exists?(mine.id)
+    assert Reaction.exists?(theirs.id)
+  end
+
+  test "escape cancels a reaction without leaving the card" do
+    visit card_url(@card)
+
+    within_reactions_of @comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Never mind"
+      send_keys :escape
+
+      assert_no_field "Your reaction"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_current_path card_path(@card)
+  end
+
+  test "a reaction being typed survives a refresh broadcast" do
+    visit card_url(@card)
+
+    within_reactions_of @comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Still typing"
+    end
+
+    react_elsewhere
+
+    within_reactions_of @comment do
+      assert_selector ".reaction", text: "👀", wait: 5
+      assert_field "Your reaction", with: "Still typing"
+
+      click_on "Add this reaction"
+      assert_selector ".reaction", text: "Still typing"
+    end
+  end
+
+  test "reactions from others show up without reloading" do
+    visit card_url(@card)
+    within_reactions_of(@comment) { assert_no_selector ".reaction" }
+
+    react_elsewhere
+
+    within_reactions_of @comment do
+      assert_selector ".reaction", text: "👀", wait: 5
+    end
+  end
+
+  private
+    def within_reactions_of(comment, &block)
+      within "##{dom_id(comment, :reactions)}", &block
+    end
+
+    def react_elsewhere
+      wait_for_cable_subscriptions
+      @comment.reactions.create!(content: "👀", reacter: users(:kevin))
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
