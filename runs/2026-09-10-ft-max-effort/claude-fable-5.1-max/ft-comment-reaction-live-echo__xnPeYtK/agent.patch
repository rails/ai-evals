diff --git a/app/views/reactions/_new.html.erb b/app/views/reactions/_new.html.erb
new file mode 100644
index 0000000..b05dd99
--- /dev/null
+++ b/app/views/reactions/_new.html.erb
@@ -0,0 +1,47 @@
+<%# Permanent so a reaction being typed survives the card refreshes broadcast to everyone %>
+<div id="<%= dom_id(reactable, :new_reaction) %>" class="reaction__menu" data-turbo-permanent
+    data-controller="dialog" data-dialog-orient-value="false"
+    data-action="keydown.esc->dialog#close keydown.esc->reactions#cancel click@document->dialog#closeOnClickOutside">
+  <button type="button" class="reactions__trigger btn btn--circle" title="Add a reaction"
+      data-reactions-target="trigger" data-action="reactions#expand">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: Reaction.new, url: reactions_path_for(reactable), class: "reaction__form", html: { hidden: true },
+        data: { reactions_target: "form", action: "turbo:submit-end->reactions#collapseAfterSubmit" } do |form| %>
+    <button type="button" class="reaction__menu-btn btn btn--circle borderless" title="Pick an emoji" data-action="dialog#toggle">
+      <%= icon_tag "reaction" %>
+      <span class="for-screen-reader">Pick an emoji</span>
+    </button>
+
+    <label class="reaction__form-label">
+      <span class="for-screen-reader">Your reaction</span>
+      <%= form.text_field :content, class: "input reaction__input", placeholder: "React…", required: true,
+            maxlength: Reaction::CONTENT_MAX_LENGTH, autocomplete: "off", data: { reactions_target: "input", "1p-ignore": "true" } %>
+    </label>
+
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless" title="Add this reaction">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add this reaction</span>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" title="Cancel" data-action="reactions#collapse">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+
+  <dialog class="reaction__popup popup popup--align-right panel shadow" data-dialog-target="dialog"
+      data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+    <div class="reaction__emoji-list">
+      <% EmojiHelper::REACTIONS.each do |emoji, description| %>
+        <button type="button" class="btn btn--circle borderless" title="<%= description %>"
+            data-action="reactions#pick dialog#close" data-reactions-content-param="<%= emoji %>">
+          <span aria-hidden="true"><%= emoji %></span>
+          <span class="for-screen-reader"><%= description %></span>
+        </button>
+      <% end %>
+    </div>
+  </dialog>
+</div>
