+<% @page_title = "Plan" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account Settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">
+    <%= @page_title %>
+    <% unless Current.user.admin? %>
+      <div class="txt-normal font-weight-normal">Only admins can change the plan</div>
+    <% end %>
+  </h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <% if params[:checkout] == "completed" %>
+      <section class="settings__section">
+        <div class="pad border-radius fill-selected">
+          <strong>Thanks for upgrading!</strong>
+          <% unless @account.paid? %>
+            Stripe is confirming your payment. Your new plan will show up here in a moment.
+          <% end %>
+        </div>
+      </section>
+    <% end %>
+
+    <%= render "account/settings/saas/subscription", account: @account %>
+  </div>
+
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Plans</h2>
+        <div>Hosted Fizzy is free up to <%= number_with_delimiter(Subscription.free.card_limit) %> cards and <%= number_to_human_size(Subscription.free.storage_limit) %> of storage. Every card counts, drafts included, and the count never goes down.</div>
+      </header>
+
+      <ul class="settings-subscription__plans list-unindented margin-block-none flex flex-column gap">
+        <% Subscription.all.each do |plan| %>
+          <li class="settings-subscription__plan flex align-center gap pad border border-radius" id="<%= plan.short_name.underscore.dasherize %>-plan">
+            <div class="flex-item-grow min-width">
+              <strong class="txt-medium"><%= plan.proper_name %></strong>
+              <span class="txt-subtle"><%= plan_price(plan) if plan.paid? %></span>
+              <div class="txt-small"><%= plan_card_allowance(plan) %>, <%= plan_storage_allowance(plan) %></div>
+            </div>
+
+            <% if @account.plan == plan %>
+              <span class="btn btn--plain non-clickable">Current plan</span>
+            <% elsif plan.paid? && Current.user.admin? && !@account.paid? %>
+              <%= button_to "Upgrade", account_subscription_checkout_path(plan: plan), class: "btn btn--link settings-subscription__button", form: { data: { turbo: false } } %>
+            <% end %>
+          </li>
+        <% end %>
+      </ul>
+
+      <% if @account.paid? && Current.user.admin? %>
+        <div class="txt-small">Change plans, update your payment details, or cancel from the billing portal.</div>
+        <%= button_to "Manage subscription", account_subscription_portal_path, class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+      <% elsif !Current.user.admin? %>
+        <div class="txt-small">Ask an account admin to upgrade.</div>
+      <% end %>
+
+      <div class="txt-small">
+        Prefer to run your own? <%= link_to "Self-host Fizzy", "https://github.com/basecamp/fizzy", class: "txt-current txt-underline", target: "_blank" %> with no limits at all.
+      </div>
+    </section>
+  </div>
+</div>
