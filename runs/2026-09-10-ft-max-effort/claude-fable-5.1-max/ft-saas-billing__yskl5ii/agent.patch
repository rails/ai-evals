new file mode 100644
index 0000000..f823830
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,135 @@
+# An account's Stripe customer and the subscription it holds. Stripe is the source of truth:
+# this record mirrors it, kept current by Stripe's webhooks, so limits can be enforced and
+# the plan shown without asking Stripe on every request.
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ trialing active past_due ]
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  class << self
+    # Mirrors a Stripe subscription, as delivered by a customer.subscription.* webhook.
+    def sync(stripe_subscription)
+      data = normalize(stripe_subscription)
+
+      if account = account_for(data)
+        find_or_initialize_by(account: account).tap do |subscription|
+          subscription.update_from_stripe(data) if subscription.tracks?(data)
+        end
+      end
+    end
+
+    # Links the customer and subscription a Stripe Checkout session created to the account that started it.
+    def complete_checkout(checkout_session)
+      data = normalize(checkout_session)
+
+      if (account = account_for_checkout(data)) && data[:subscription].present?
+        find_or_initialize_by(account: account).tap do |subscription|
+          subscription.update_from_checkout(data)
+        end
+      end
+    end
+
+    # Remembers what the next invoice will charge, as announced by an invoice.upcoming webhook.
+    def record_upcoming_invoice(stripe_invoice)
+      data = normalize(stripe_invoice)
+      subscription_id = id_of(data[:subscription] || data.dig(:parent, :subscription_details, :subscription))
+
+      find_by(stripe_subscription_id: subscription_id)&.update!(next_amount_due_in_cents: data[:amount_due]) if subscription_id.present?
+    end
+
+    def normalize(stripe_object)
+      stripe_object.to_hash.deep_symbolize_keys
+    end
+
+    def id_of(object_or_id)
+      object_or_id.is_a?(Hash) ? object_or_id[:id] : object_or_id
+    end
+
+    private
+      def account_for(data)
+        find_by(stripe_subscription_id: data[:id])&.account ||
+          Account.find_by(id: data.dig(:metadata, :account_id)) ||
+          find_by(stripe_customer_id: id_of(data[:customer]))&.account
+      end
+
+      def account_for_checkout(data)
+        Account.find_by(id: data[:client_reference_id]) || Account.find_by(id: data.dig(:metadata, :account_id))
+      end
+  end
+
+  def plan
+    ::Subscription.find(plan_key) || ::Subscription::MonthlyV1
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def past_due?
+    status == "past_due"
+  end
+
+  def canceling?
+    active? && cancel_at.present?
+  end
+
+  # A stale webhook about a subscription this record no longer follows must not overwrite the live one.
+  def tracks?(data)
+    stripe_subscription_id.blank? || stripe_subscription_id == data[:id] || data[:status].in?(ACTIVE_STATUSES)
+  end
+
+  def update_from_stripe(data)
+    item = Array(data.dig(:items, :data)).first || {}
+    period_end = data[:current_period_end] || item[:current_period_end]
+
+    self.stripe_subscription_id = data[:id]
+    self.stripe_customer_id = self.class.id_of(data[:customer]) || stripe_customer_id
+    self.status = data[:status]
+    self.plan_key = plan_key_from(item[:price] || data[:plan], data)
+    self.current_period_end = time_at(period_end) || current_period_end
+    self.cancel_at = time_at(data[:cancel_at] || (period_end if data[:cancel_at_period_end]))
+    save!
+  end
+
+  def update_from_checkout(data)
+    self.stripe_customer_id = self.class.id_of(data[:customer])
+    self.stripe_subscription_id = self.class.id_of(data[:subscription])
+    self.plan_key = plan_key_from(nil, data)
+    self.status = "active" unless active?
+    save!
+  end
+
+  def cancel_later
+    Account::Subscription::CancelJob.perform_later(self)
+  end
+
+  def cancel_now
+    if stripe_subscription_id.present? && active?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+    end
+
+    update!(status: "canceled")
+  rescue Stripe::InvalidRequestError => error
+    # Already gone on Stripe's side, which is what we wanted anyway.
+    Rails.logger.info "[Billing] Stripe declined to cancel #{stripe_subscription_id}: #{error.message}"
+    update!(status: "canceled")
+  end
+
+  def create_stripe_portal_session(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url)
+  end
+
+  private
+    def plan_key_from(price, data)
+      plan = ::Subscription.find_by_stripe_price(price) || ::Subscription.find(data.dig(:metadata, :plan_key))
+      plan&.short_name || plan_key || ::Subscription::MonthlyV1.short_name
+    end
+
+    def time_at(seconds)
+      Time.at(seconds).utc if seconds.present?
+    end
+end
diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
