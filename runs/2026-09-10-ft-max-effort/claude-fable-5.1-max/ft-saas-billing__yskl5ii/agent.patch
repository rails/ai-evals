--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,27 @@
+# The free plan includes a fixed number of cards, drafts included, and the count never
+# goes down: card numbers are handed out from it, so deleting cards frees nothing.
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def cards_remaining
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+end
