+  end
+
+  test "a subscription created in Stripe puts the account on the plan" do
+    post_event "customer.subscription.created", stripe_subscription(status: "active")
+
+    assert_response :ok
+    assert @account.reload.paid?
+    assert_equal Subscription::MonthlyV1, @account.plan
+    assert_equal "sub_123", @account.subscription.stripe_subscription_id
+  end
+
+  test "a subscription updated in Stripe is mirrored" do
+    post_event "customer.subscription.created", stripe_subscription(status: "active")
+    post_event "customer.subscription.updated", stripe_subscription(status: "active", price: Subscription::MonthlyExtraStorageV1.stripe_price_id, cancel_at_period_end: true)
+
+    assert_response :ok
+    assert_equal Subscription::MonthlyExtraStorageV1, @account.reload.plan
+    assert @account.subscription.canceling?
+  end
+
+  test "a subscription deleted in Stripe drops the account back to free" do
+    post_event "customer.subscription.created", stripe_subscription(status: "active")
+    post_event "customer.subscription.deleted", stripe_subscription(status: "canceled")
+
+    assert_response :ok
+    assert_not @account.reload.paid?
+    assert_equal Subscription.free, @account.plan
+  end
+
+  test "a completed checkout links the Stripe customer to the account" do
+    post_event "checkout.session.completed", { id: "cs_123", object: "checkout.session", mode: "subscription", client_reference_id: @account.id,
+      customer: "cus_123", subscription: "sub_123", metadata: { account_id: @account.id, plan_key: "MonthlyV1" } }
+
+    assert_response :ok
+    assert @account.reload.paid?
+    assert_equal "cus_123", @account.subscription.stripe_customer_id
+  end
+
+  test "an upcoming invoice records what is due next" do
+    post_event "customer.subscription.created", stripe_subscription(status: "active")
+    post_event "invoice.upcoming", { object: "invoice", amount_due: 2000, subscription: "sub_123" }
+
+    assert_response :ok
+    assert_equal 2000, @account.subscription.reload.next_amount_due_in_cents
+  end
+
+  test "events we do not care about are acknowledged" do
+    post_event "payment_intent.succeeded", { id: "pi_123", object: "payment_intent" }
+
+    assert_response :ok
+  end
+
+  test "events with a bad signature are rejected" do
+    post_event "customer.subscription.created", stripe_subscription, signature: "t=#{Time.current.to_i},v1=bogus"
+
+    assert_response :bad_request
+    assert_not @account.reload.paid?
+  end
+
+  test "unsigned events are rejected" do
+    post_event "customer.subscription.created", stripe_subscription, signature: nil
+
+    assert_response :bad_request
+    assert_not @account.reload.paid?
+  end
+
+  test "unsigned events are let through locally when no secret is configured" do
+    ENV["STRIPE_WEBHOOK_SECRET"] = nil
+
+    post_event "customer.subscription.created", stripe_subscription, signature: nil
+
+    assert_response :ok
+    assert @account.reload.paid?
+  end
+
+  test "garbage is rejected" do
+    untenanted do
+      post "/stripe/webhooks", params: "not json", headers: { "Content-Type" => "application/json", "Stripe-Signature" => signature_for("not json") }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "webhooks need no session" do
+    post_event "customer.subscription.created", stripe_subscription
+
+    assert_response :ok
+    assert_nil cookies[:session_token].presence
+  end
+
+  private
+    def post_event(type, object, signature: :valid)
+      payload = { id: "evt_123", object: "event", type: type, created: Time.current.to_i, data: { object: object } }.to_json
+      signature = signature_for(payload) if signature == :valid
+
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: { "Content-Type" => "application/json", "Stripe-Signature" => signature }.compact
+      end
+    end
+
+    def signature_for(payload, timestamp: Time.current)
+      "t=#{timestamp.to_i},v1=#{Stripe::Webhook::Signature.compute_signature(timestamp, payload, WEBHOOK_SECRET)}"
+    end
+
+    def stripe_subscription(status: "active", price: Subscription::MonthlyV1.stripe_price_id, cancel_at_period_end: false)
+      {
+        id: "sub_123",
+        object: "subscription",
+        customer: "cus_123",
+        status: status,
+        current_period_end: 1.month.from_now.to_i,
+        cancel_at: nil,
+        cancel_at_period_end: cancel_at_period_end,
+        metadata: { account_id: @account.id, plan_key: "MonthlyV1" },
+        items: { object: "list", data: [ { id: "si_123", price: { id: price, object: "price" }, quantity: 1 } ] }
+      }
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..166829e
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,189 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start on the free plan" do
+    assert_equal Subscription.free, @account.plan
+    assert @account.free?
+    assert_not @account.paid?
+    assert_not @account.comped?
+    assert_nil @account.active_subscription
+  end
+
+  test "an active Stripe subscription puts the account on its plan" do
+    subscribe @account, plan_key: "MonthlyV1", status: "active"
+
+    assert_equal Subscription::MonthlyV1, @account.plan
+    assert @account.paid?
+    assert_not @account.free?
+    assert_equal @account.subscription, @account.active_subscription
+  end
+
+  test "a past due subscription still counts while Stripe retries the payment" do
+    subscribe @account, plan_key: "MonthlyExtraStorageV1", status: "past_due"
+
+    assert_equal Subscription::MonthlyExtraStorageV1, @account.plan
+    assert @account.paid?
+  end
+
+  test "a canceled subscription drops the account back to free" do
+    subscribe @account, plan_key: "MonthlyV1", status: "canceled"
+
+    assert_equal Subscription.free, @account.plan
+    assert_not @account.paid?
+    assert_nil @account.active_subscription
+  end
+
+  test "comping gives the top plan for free" do
+    @account.comp
+
+    assert @account.comped?
+    assert_not @account.free?
+    assert_not @account.paid?
+    assert_equal Subscription::MonthlyExtraStorageV1, @account.plan
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comping is idempotent and uncomping takes it back" do
+    assert_difference -> { Account::BillingWaiver.count }, +1 do
+      @account.comp
+      @account.comp
+    end
+
+    assert_difference -> { Account::BillingWaiver.count }, -1 do
+      @account.uncomp
+    end
+
+    assert_not @account.comped?
+    assert_equal Subscription.free, @account.reload.plan
+  end
+
+  test "comped= drives comping for Queenbee" do
+    @account.comped = "1"
+    assert @account.comped?
+
+    @account.comped = "0"
+    assert_not @account.comped?
+  end
+
+  test "a paying account that is also comped is on the plan it pays for" do
+    subscribe @account, plan_key: "MonthlyV1", status: "active"
+    @account.comp
+
+    assert_equal Subscription::MonthlyV1, @account.plan
+  end
+
+  test "overriding limits replaces the counted cards and bytes" do
+    @account.update_column(:cards_count, 1_200)
+    Account.any_instance.stubs(:storage_total).returns(Storage::Total.new(bytes_stored: 3.gigabytes))
+
+    @account.override_limits(card_count: 5, bytes_used: 10.megabytes)
+
+    assert_equal 5, @account.card_count
+    assert_equal 10.megabytes, @account.bytes_used
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "overriding again updates the same override, blanks fall back to the real numbers" do
+    @account.update_column(:cards_count, 1_200)
+    @account.override_limits(card_count: 5, bytes_used: 10.megabytes)
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      @account.override_limits(card_count: nil, bytes_used: 20.megabytes)
+    end
+
+    assert_equal 1_200, @account.card_count
+    assert_equal 20.megabytes, @account.bytes_used
+  end
+
+  test "overriding nothing is a reset" do
+    @account.override_limits(card_count: 5)
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      @account.override_limits(card_count: nil, bytes_used: nil)
+    end
+
+    assert_nil @account.overridden_limit
+  end
+
+  test "resetting drops the override" do
+    @account.update_column(:cards_count, 1_200)
+    @account.override_limits(card_count: 5)
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      @account.reset_overridden_limits
+    end
+
+    assert_equal 1_200, @account.card_count
+    @account.reset_overridden_limits
+  end
+
+  test "canceling the account cancels its Stripe subscription" do
+    subscribe @account, plan_key: "MonthlyV1", status: "active"
+
+    assert_enqueued_with job: Account::Subscription::CancelJob, args: [ @account.subscription ] do
+      @account.cancel(initiated_by: users(:mike))
+    end
+
+    Stripe::Subscription.expects(:cancel).with("sub_123").once
+    perform_enqueued_jobs only: Account::Subscription::CancelJob
+
+    assert_equal "canceled", @account.subscription.reload.status
+    assert_equal Subscription.free, @account.reload.plan
+  end
+
+  test "canceling a free account touches nothing in Stripe" do
+    assert_no_enqueued_jobs only: Account::Subscription::CancelJob do
+      @account.cancel(initiated_by: users(:mike))
+    end
+  end
+
+  test "incinerating an account takes its billing records along" do
+    subscribe @account, plan_key: "MonthlyV1", status: "canceled"
+    @account.comp
+    @account.override_limits(card_count: 1)
+
+    @account.incinerate
+
+    assert_not Account::Subscription.exists?(account_id: @account.id)
+    assert_not Account::BillingWaiver.exists?(account_id: @account.id)
+    assert_not Account::OverriddenLimit.exists?(account_id: @account.id)
+  end
+
+  test "creating a Stripe checkout session for a plan" do
+    Current.identity = identities(:mike)
+
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:mode] == "subscription" &&
+        params[:line_items] == [ { price: Subscription::MonthlyV1.stripe_price_id, quantity: 1 } ] &&
+        params[:client_reference_id] == @account.id &&
+        params[:subscription_data][:metadata] == { account_id: @account.id, plan_key: "MonthlyV1" } &&
+        params[:customer_email] == "mike@37signals.com" &&
+        params[:success_url] == "https://example.com/done" &&
+        params[:cancel_url] == "https://example.com/back"
+    end.returns(stub(url: "https://checkout.stripe.com/session"))
+
+    checkout = @account.create_stripe_checkout_session(Subscription::MonthlyV1, success_url: "https://example.com/done", cancel_url: "https://example.com/back")
+
+    assert_equal "https://checkout.stripe.com/session", checkout.url
+  end
+
+  test "checking out again reuses the Stripe customer" do
+    subscribe @account, plan_key: "MonthlyV1", status: "canceled"
+
+    Stripe::Checkout::Session.expects(:create).with { |params| params[:customer] == "cus_123" && !params.key?(:customer_email) }.returns(stub(url: "https://checkout.stripe.com/session"))
+
+    @account.create_stripe_checkout_session(Subscription::MonthlyV1, success_url: "https://example.com/done", cancel_url: "https://example.com/back")
+  end
+
+  private
+    def subscribe(account, **attributes)
+      Account::Subscription.create!(account: account, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", **attributes)
+      account.reload
+    end
+end
diff --git a/saas/test/models/account/card_limited_test.rb b/saas/test/models/account/card_limited_test.rb
