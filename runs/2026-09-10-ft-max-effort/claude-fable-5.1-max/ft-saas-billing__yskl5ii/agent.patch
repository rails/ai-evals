diff --git a/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
new file mode 100644
index 0000000..1ab4ec1
--- /dev/null
+++ b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.update_column(:cards_count, 1_200)
+  end
+
+  test "staff can override the card count and bytes used" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 10, bytes_used: 2048 } } }
+
+    assert_redirected_to untenanted { saas.admin_account_path(@account) }
+    assert_equal 10, @account.reload.card_count
+    assert_equal 2048, @account.bytes_used
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "a blank field keeps counting the real number" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: "", bytes_used: 2048 } } }
+
+    assert_equal 1_200, @account.reload.card_count
+    assert_equal 2048, @account.bytes_used
+  end
+
+  test "overriding again replaces the override" do
+    sign_in_as :david
+    @account.override_limits(card_count: 10)
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      untenanted { post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 20 } } }
+    end
+
+    assert_equal 20, @account.reload.card_count
+  end
+
+  test "staff can reset the override" do
+    sign_in_as :david
+    @account.override_limits(card_count: 10, bytes_used: 2048)
+
+    untenanted { delete saas.admin_account_overridden_limit_path(@account) }
+
+    assert_redirected_to untenanted { saas.admin_account_path(@account) }
+    assert_nil @account.reload.overridden_limit
+    assert_equal 1_200, @account.card_count
+    assert @account.exceeding_card_limit?
+  end
+
+  test "resetting with no override is fine" do
+    sign_in_as :david
+
+    untenanted { delete saas.admin_account_overridden_limit_path(@account) }
+
+    assert_redirected_to untenanted { saas.admin_account_path(@account) }
+  end
+
+  test "non-staff cannot override limits" do
+    sign_in_as :jz
+
+    untenanted { post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 10 } } }
+
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limit
+  end
+end
