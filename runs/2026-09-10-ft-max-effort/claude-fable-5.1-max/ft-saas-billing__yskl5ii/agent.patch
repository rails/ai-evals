diff --git a/saas/test/models/account/storage_limited_test.rb b/saas/test/models/account/storage_limited_test.rb
index f587d9e..08bf434 100644
--- a/saas/test/models/account/storage_limited_test.rb
+++ b/saas/test/models/account/storage_limited_test.rb
@@ -36,4 +36,49 @@ class Account::StorageLimitedTest < ActiveSupport::TestCase
 
     assert_not accounts(:initech).nearing_storage_limit?
   end
+
+  test "a paid plan brings its own storage allowance" do
+    Account.any_instance.stubs(:bytes_used).returns(4.gigabytes)
+    subscribe accounts(:initech), plan_key: "MonthlyV1"
+
+    assert_equal 5.gigabytes, accounts(:initech).storage_limit
+    assert_not accounts(:initech).exceeding_storage_limit?
+
+    Account.any_instance.stubs(:bytes_used).returns(6.gigabytes)
+    assert accounts(:initech).exceeding_storage_limit?
+
+    subscribe accounts(:initech), plan_key: "MonthlyExtraStorageV1"
+    assert_equal 500.gigabytes, accounts(:initech).storage_limit
+    assert_not accounts(:initech).exceeding_storage_limit?
+  end
+
+  test "a comped account gets the top plan storage allowance" do
+    accounts(:initech).comp
+
+    assert_equal 500.gigabytes, accounts(:initech).storage_limit
+  end
+
+  test "a storage exception still wins over the plan" do
+    subscribe accounts(:initech), plan_key: "MonthlyV1"
+    accounts(:initech).add_storage_exception(10.gigabytes)
+
+    assert_equal 10.gigabytes, accounts(:initech).storage_limit
+  end
+
+  test "overridden bytes used are what count against the limit" do
+    Account.any_instance.stubs(:storage_total).returns(Storage::Total.new(bytes_stored: 2.gigabytes))
+    assert accounts(:initech).exceeding_storage_limit?
+
+    accounts(:initech).override_limits(bytes_used: 100.megabytes)
+
+    assert_equal 100.megabytes, accounts(:initech).bytes_used
+    assert_not accounts(:initech).exceeding_storage_limit?
+  end
+
+  private
+    def subscribe(account, plan_key:)
+      Account::Subscription.where(account: account).destroy_all
+      Account::Subscription.create!(account: account, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: plan_key, status: "active")
+      account.reload
+    end
 end
diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..87fad39
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "syncing a new Stripe subscription tagged with the account" do
+    subscription = Account::Subscription.sync stripe_subscription(status: "active", price: Subscription::MonthlyV1.stripe_price_id)
+
+    assert_equal @account, subscription.account
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "active", subscription.status
+    assert_equal Subscription::MonthlyV1, subscription.plan
+    assert_equal Time.utc(2026, 5, 1), subscription.current_period_end
+    assert_nil subscription.cancel_at
+    assert subscription.active?
+    assert @account.reload.paid?
+  end
+
+  test "syncing recognizes the Unlimited+ price" do
+    subscription = Account::Subscription.sync stripe_subscription(price: Subscription::MonthlyExtraStorageV1.stripe_price_id)
+
+    assert_equal Subscription::MonthlyExtraStorageV1, subscription.plan
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "syncing falls back to the plan named in the metadata for an unknown price" do
+    subscription = Account::Subscription.sync stripe_subscription(price: "price_legacy", metadata: { account_id: @account.id, plan_key: "MonthlyExtraStorageV1" })
+
+    assert_equal Subscription::MonthlyExtraStorageV1, subscription.plan
+  end
+
+  test "syncing finds the account through an existing record when the metadata is missing" do
+    Account::Subscription.create!(account: @account, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "MonthlyV1", status: "active")
+
+    Account::Subscription.sync stripe_subscription(status: "past_due", metadata: {})
+
+    assert_equal "past_due", @account.subscription.reload.status
+    assert @account.subscription.past_due?
+  end
+
+  test "syncing a scheduled cancellation" do
+    subscription = Account::Subscription.sync stripe_subscription(cancel_at_period_end: true)
+
+    assert subscription.canceling?
+    assert_equal subscription.current_period_end, subscription.cancel_at
+
+    subscription = Account::Subscription.sync stripe_subscription(cancel_at_period_end: false)
+    assert_not subscription.canceling?
+    assert_nil subscription.cancel_at
+  end
+
+  test "syncing a deletion drops the account back to free" do
+    Account::Subscription.sync stripe_subscription(status: "active")
+    Account::Subscription.sync stripe_subscription(status: "canceled")
+
+    assert_equal "canceled", @account.subscription.reload.status
+    assert_not @account.reload.paid?
+    assert_equal Subscription.free, @account.plan
+  end
+
+  test "syncing reads the period end from the items on newer Stripe API versions" do
+    payload = stripe_subscription.except(:current_period_end)
+    payload[:items][:data].first[:current_period_end] = Time.utc(2026, 6, 1).to_i
+
+    subscription = Account::Subscription.sync payload
+
+    assert_equal Time.utc(2026, 6, 1), subscription.current_period_end
+  end
+
+  test "a stale event about a superseded subscription is ignored" do
+    Account::Subscription.sync stripe_subscription(id: "sub_new", status: "active")
+    Account::Subscription.sync stripe_subscription(id: "sub_old", status: "canceled")
+
+    assert_equal "sub_new", @account.subscription.reload.stripe_subscription_id
+    assert_equal "active", @account.subscription.status
+  end
+
+  test "a new active subscription for the same customer takes over" do
+    Account::Subscription.sync stripe_subscription(id: "sub_old", status: "canceled")
+    Account::Subscription.sync stripe_subscription(id: "sub_new", status: "active")
+
+    assert_equal "sub_new", @account.subscription.reload.stripe_subscription_id
+    assert @account.reload.paid?
+  end
+
+  test "syncing a subscription nobody claims does nothing" do
+    assert_no_difference -> { Account::Subscription.count } do
+      assert_nil Account::Subscription.sync(stripe_subscription(metadata: {}))
+    end
+  end
+
+  test "syncing accepts Stripe objects" do
+    stripe_object = Stripe::Subscription.construct_from(stripe_subscription)
+
+    subscription = Account::Subscription.sync(stripe_object)
+
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal Subscription::MonthlyV1, subscription.plan
+  end
+
+  test "completing a checkout links the customer and subscription before Stripe details them" do
+    subscription = Account::Subscription.complete_checkout \
+      id: "cs_123", client_reference_id: @account.id, customer: "cus_123", subscription: "sub_123", metadata: { account_id: @account.id, plan_key: "MonthlyExtraStorageV1" }
+
+    assert_equal @account, subscription.account
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "active", subscription.status
+    assert_equal Subscription::MonthlyExtraStorageV1, subscription.plan
+    assert @account.reload.paid?
+  end
+
+  test "completing a checkout after the subscription synced keeps what Stripe said" do
+    Account::Subscription.sync stripe_subscription(status: "trialing")
+
+    Account::Subscription.complete_checkout id: "cs_123", client_reference_id: @account.id, customer: "cus_123", subscription: "sub_123", metadata: { plan_key: "MonthlyV1" }
+
+    assert_equal "trialing", @account.subscription.reload.status
+  end
+
+  test "completing a checkout for an unknown account does nothing" do
+    assert_no_difference -> { Account::Subscription.count } do
+      assert_nil Account::Subscription.complete_checkout(id: "cs_123", client_reference_id: "nope", customer: "cus_123", subscription: "sub_123", metadata: {})
+    end
+  end
+
+  test "recording the upcoming invoice" do
+    Account::Subscription.sync stripe_subscription
+
+    Account::Subscription.record_upcoming_invoice amount_due: 2500, parent: { subscription_details: { subscription: "sub_123" } }
+
+    assert_equal 2500, @account.subscription.reload.next_amount_due_in_cents
+  end
+
+  test "canceling on Stripe" do
+    subscription = Account::Subscription.sync stripe_subscription(status: "active")
+    Stripe::Subscription.expects(:cancel).with("sub_123")
+
+    subscription.cancel_now
+
+    assert_equal "canceled", subscription.reload.status
+  end
+
+  test "canceling something Stripe already canceled just records it" do
+    subscription = Account::Subscription.sync stripe_subscription(status: "active")
+    Stripe::Subscription.expects(:cancel).raises(Stripe::InvalidRequestError.new("No such subscription", "id"))
+
+    subscription.cancel_now
+
+    assert_equal "canceled", subscription.reload.status
+  end
+
+  test "the billing portal session is for the Stripe customer" do
+    subscription = Account::Subscription.sync stripe_subscription
+    Stripe::BillingPortal::Session.expects(:create).with(customer: "cus_123", return_url: "https://example.com/plan").returns(stub(url: "https://billing.stripe.com/session"))
+
+    assert_equal "https://billing.stripe.com/session", subscription.create_stripe_portal_session(return_url: "https://example.com/plan").url
+  end
+
+  private
+    def stripe_subscription(id: "sub_123", status: "active", price: Subscription::MonthlyV1.stripe_price_id, cancel_at_period_end: false, metadata: { account_id: @account.id })
+      {
+        id: id,
+        object: "subscription",
+        customer: "cus_123",
+        status: status,
+        current_period_end: Time.utc(2026, 5, 1).to_i,
+        cancel_at: nil,
+        cancel_at_period_end: cancel_at_period_end,
+        metadata: metadata,
+        items: { object: "list", data: [ { id: "si_123", price: { id: price, object: "price" }, quantity: 1 } ] }
+      }
+    end
+end
