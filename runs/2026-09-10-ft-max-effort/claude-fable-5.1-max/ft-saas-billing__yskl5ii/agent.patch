diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..b5c04c2
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,89 @@
+# Hosted Fizzy is free up to the limits of the free plan; Stripe bills for the paid plans.
+# Support can also comp an account, giving it the top plan's allowances for nothing.
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+
+    set_callback :cancel, :after, -> { subscription&.cancel_later }
+  end
+
+  def plan
+    if active_subscription
+      active_subscription.plan
+    elsif comped?
+      ::Subscription.complimentary
+    else
+      ::Subscription.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def paid?
+    active_subscription.present?
+  end
+
+  def free?
+    !paid? && !comped?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    self.billing_waiver = nil
+  end
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    if card_count.nil? && bytes_used.nil?
+      reset_overridden_limits
+    elsif overridden_limit
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy!
+    self.overridden_limit = nil
+  end
+
+  def create_stripe_checkout_session(plan, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create \
+      mode: "subscription",
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      client_reference_id: id,
+      metadata: { account_id: id, plan_key: plan.short_name },
+      subscription_data: { metadata: { account_id: id, plan_key: plan.short_name } },
+      success_url: success_url,
+      cancel_url: cancel_url,
+      allow_promotion_codes: true,
+      **stripe_checkout_customer_options
+  end
+
+  private
+    def stripe_checkout_customer_options
+      if subscription
+        { customer: subscription.stripe_customer_id }
+      else
+        { customer_email: Current.identity&.email_address }.compact
+      end
+    end
+end
