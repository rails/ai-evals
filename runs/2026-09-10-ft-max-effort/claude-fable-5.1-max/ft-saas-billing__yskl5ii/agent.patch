+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow full-width">
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half", data: { turbo_frame: "_top" } do |form| %>
+      <%= form.search_field :q, value: params[:q], placeholder: "Search by name or account id…", class: "input full-width", autofocus: true, autocomplete: "off" %>
+      <%= form.button "Search", class: "btn" %>
+    <% end %>
+
+    <% if @page.records.any? %>
+      <ul class="list-unindented margin-block-half">
+        <% @page.records.each do |account| %>
+          <li class="flex align-center gap-half margin-block-start-half" id="<%= dom_id(account) %>">
+            <div class="flex-item-grow min-width overflow-ellipsis txt-align-start">
+              <%= link_to account.name, saas.admin_account_path(account), class: "txt-ink font-weight-bold" %>
+              <br>
+              <span class="txt-x-small txt-ink-medium">
+                #<%= account.external_account_id %> •
+                <%= account.owner_email || "No owner" %> •
+                <%= account.plan.proper_name %><%= " (comped)" if account.comped? %>
+                <%= "• Cancelled" if account.cancelled? %>
+              </span>
+            </div>
+
+            <div class="txt-medium txt-align-end txt-nowrap">
+              <strong><%= number_with_delimiter(account.cards_count) %></strong>
+              <span class="txt-x-small txt-ink-medium">cards</span>
+            </div>
+          </li>
+        <% end %>
+      </ul>
+
+      <nav class="flex gap justify-space-between txt-small">
+        <% if @page.number > 1 %>
+          <%= link_to "Previous", saas.admin_accounts_path(q: params[:q].presence, page: @page.number - 1), class: "btn" %>
+        <% end %>
+        <% if @page.before_last? %>
+          <%= link_to "Next", saas.admin_accounts_path(q: params[:q].presence, page: @page.number + 1), class: "btn margin-inline-start-auto" %>
+        <% end %>
+      </nav>
+    <% else %>
+      <div class="blank-slate">No accounts found</div>
+    <% end %>
+  </div>
+</section>
