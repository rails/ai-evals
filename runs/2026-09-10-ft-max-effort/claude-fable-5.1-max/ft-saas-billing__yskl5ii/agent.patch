diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..d7d82ae
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,67 @@
+#!/usr/bin/env ruby
+#
+# Sets up Stripe for local development: fetches the development credentials from
+# 1Password, then starts the Stripe CLI forwarding webhooks to the dev server and
+# prints the environment the app needs.
+#
+# Usage: eval "$(bundle exec stripe-dev)"
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+WEBHOOKS_URL = "localhost:3000/stripe/webhooks"
+FORWARDED_EVENTS = %w[
+  checkout.session.completed
+  customer.subscription.created
+  customer.subscription.updated
+  customer.subscription.deleted
+  invoice.upcoming
+]
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/Development/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+unless system("stripe", "--version", out: File::NULL, err: File::NULL)
+  warn "Error: the Stripe CLI is not installed. See https://stripe.com/docs/stripe-cli"
+  exit 1
+end
+
+secret_key = op_read("STRIPE_SECRET_KEY")
+monthly_v1_price_id = op_read("STRIPE_MONTHLY_V1_PRICE_ID")
+monthly_extra_storage_v1_price_id = op_read("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+
+if secret_key.empty? || monthly_v1_price_id.empty? || monthly_extra_storage_v1_price_id.empty?
+  warn "Error: Could not fetch Stripe credentials from 1Password"
+  warn "Make sure you're signed in: op signin --account #{OP_ACCOUNT}"
+  exit 1
+end
+
+# `stripe listen` prints the signing secret for the tunnel it opens, which the app needs to verify the forwarded events.
+listener = IO.popen([ "stripe", "listen", "--api-key", secret_key, "--events", FORWARDED_EVENTS.join(","), "--forward-to", WEBHOOKS_URL, err: [ :child, :out ] ])
+Process.detach(listener.pid)
+
+webhook_secret = nil
+while (line = listener.gets)
+  if (match = line.match(/(whsec_\w+)/))
+    webhook_secret = match[1]
+    break
+  end
+end
+
+if webhook_secret.nil?
+  warn "Error: Could not start the Stripe webhook tunnel"
+  exit 1
+end
+
+puts %Q(export STRIPE_SECRET_KEY="#{secret_key}")
+puts %Q(export STRIPE_WEBHOOK_SECRET="#{webhook_secret}")
+puts %Q(export STRIPE_MONTHLY_V1_PRICE_ID="#{monthly_v1_price_id}")
+puts %Q(export STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID="#{monthly_extra_storage_v1_price_id}")
+puts %Q(export STRIPE_LISTEN_PID="#{listener.pid}")
+
+warn ""
+warn "Stripe configured for development"
+warn "  Webhooks forwarded to #{WEBHOOKS_URL} (stripe listen, pid #{listener.pid})"
+warn "  Plans: Unlimited (#{monthly_v1_price_id}), Unlimited+ (#{monthly_extra_storage_v1_price_id})"
+warn "  Stop the tunnel with: kill $STRIPE_LISTEN_PID"
