+
+  def show
+    @account = Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+  end
+
+  private
+    def accounts
+      scope = Account.preload(:subscription, :billing_waiver)
+
+      if (query = params[:q].to_s.strip).present?
+        scope.where("name LIKE ?", "%#{Account.sanitize_sql_like(query)}%").or(scope.where(external_account_id: query.to_i)).order(:name)
