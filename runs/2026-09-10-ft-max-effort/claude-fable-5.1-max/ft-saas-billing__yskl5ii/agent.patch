+require "test_helper"
+
+class Account::SubscriptionSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and an upgrade button" do
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings-subscription" do
+      assert_select "strong", "Free"
+      assert_select "a[href=?]", account_subscription_path, text: "Upgrade"
+      assert_select "li", text: /5 of 1,000 cards used/
+    end
+  end
+
+  test "admins of paying accounts see their plan and manage it through Stripe" do
+    sign_in_as :kevin
+    Account::Subscription.create!(account: accounts(:"37s"), stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "MonthlyExtraStorageV1", status: "active")
+
+    get account_settings_path
+
+    assert_select ".settings-subscription" do
+      assert_select "strong", "Unlimited+"
+      assert_select "form[action=?] button", account_subscription_portal_path, text: "Manage subscription"
+      assert_select "a", text: "Upgrade", count: 0
+      assert_select "li", text: /cards used/, count: 0
+    end
+  end
+
+  test "comped accounts are on the house" do
+    sign_in_as :kevin
+    accounts(:"37s").comp
+
+    get account_settings_path
+
+    assert_select ".settings-subscription", text: /Unlimited\+.*on the house/m
+    assert_select ".settings-subscription a", text: "Upgrade", count: 0
+  end
+
+  test "members see the plan but no upgrade button" do
+    sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings-subscription strong", "Free"
+    assert_select ".settings-subscription a", text: "Upgrade", count: 0
+  end
+end
