+require "test_helper"
+
+class SubscriptionTest < ActiveSupport::TestCase
+  test "the free plan includes 1,000 cards and 1 GB" do
+    assert Subscription.free.free?
+    assert_equal 0, Subscription.free.price
+    assert_equal 1_000, Subscription.free.card_limit
+    assert_equal 1.gigabyte, Subscription.free.storage_limit
+  end
+
+  test "Unlimited is $20 a month for unlimited cards and 5 GB" do
+    plan = Subscription::MonthlyV1
+
+    assert plan.paid?
+    assert_equal "Unlimited", plan.proper_name
+    assert_equal 20, plan.price
+    assert_equal "monthly", plan.frequency
+    assert plan.unlimited_cards?
+    assert_equal 5.gigabytes, plan.storage_limit
+  end
+
+  test "Unlimited+ is $25 a month for unlimited cards and 500 GB" do
+    plan = Subscription::MonthlyExtraStorageV1
+
+    assert plan.paid?
+    assert_equal "Unlimited+", plan.proper_name
+    assert_equal 25, plan.price
+    assert plan.unlimited_cards?
+    assert_equal 500.gigabytes, plan.storage_limit
+  end
+
+  test "paid plans are the ones sold through Stripe" do
+    assert_equal [ Subscription::MonthlyV1, Subscription::MonthlyExtraStorageV1 ], Subscription.paid
+  end
+
+  test "finding by short name, underscored or proper" do
+    assert_equal Subscription::MonthlyV1, Subscription.find("MonthlyV1")
+    assert_equal Subscription::MonthlyV1, Subscription.find("monthly_v1")
+    assert_equal Subscription::MonthlyExtraStorageV1, Subscription.find("Unlimited+")
+    assert_equal Subscription::FreeV1, Subscription.find("free")
+    assert_nil Subscription.find("Bogus")
+    assert_nil Subscription.find(nil)
+  end
+
+  test "stripe price ids come from the environment" do
+    with_env "STRIPE_MONTHLY_V1_PRICE_ID" => "price_abc" do
+      assert_equal "price_abc", Subscription::MonthlyV1.stripe_price_id
+      assert_equal Subscription::MonthlyV1, Subscription.find_by_stripe_price_id("price_abc")
+    end
+
+    assert_nil Subscription.find_by_stripe_price_id("price_unknown")
+    assert_nil Subscription.find_by_stripe_price_id(nil)
+  end
+
+  test "a Stripe price is matched by id, then by what it charges, then by what it is called" do
+    with_env "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus" do
+      assert_equal Subscription::MonthlyExtraStorageV1, Subscription.find_by_stripe_price(id: "price_plus", unit_amount: 999)
+    end
+
+    assert_equal Subscription::MonthlyV1, Subscription.find_by_stripe_price(id: "price_whatever", unit_amount: 2000, currency: "usd")
+    assert_equal Subscription::MonthlyExtraStorageV1, Subscription.find_by_stripe_price(id: "price_whatever", unit_amount: 2500, currency: "usd")
+    assert_equal Subscription::MonthlyV1, Subscription.find_by_stripe_price(id: "price_whatever", lookup_key: "monthly_v1")
+    assert_equal Subscription::MonthlyExtraStorageV1, Subscription.find_by_stripe_price("id" => "price_whatever", "nickname" => "Unlimited+")
+    assert_nil Subscription.find_by_stripe_price(id: "price_whatever", unit_amount: 100)
+    assert_nil Subscription.find_by_stripe_price(nil)
+  end
+
+  private
+    def with_env(values)
+      previous = values.keys.index_with { |key| ENV[key] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous.each { |key, value| ENV[key] = value }
+    end
+end
