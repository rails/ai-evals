+module BillingHelper
+  def plan_price(plan)
+    if plan.free?
+      "Free"
+    else
+      "#{number_to_currency(plan.price, precision: 0)}/#{plan.frequency == "monthly" ? "month" : "year"}"
+    end
+  end
+
+  def plan_card_allowance(plan)
+    plan.unlimited_cards? ? "Unlimited cards" : "#{number_with_delimiter(plan.card_limit)} cards"
+  end
+
+  def plan_storage_allowance(plan)
+    "#{number_to_human_size(plan.storage_limit)} storage"
+  end
+
+  # The plan worth pitching to an account that has hit a limit, if there is a bigger one.
+  def upgrade_plan_for(account)
+    if account.free?
+      Subscription::MonthlyV1
+    elsif account.plan == Subscription::MonthlyV1
+      Subscription::MonthlyExtraStorageV1
+    end
+  end
+end
