@@ -1,13 +1,98 @@
+# The plans hosted Fizzy sells. Each is a Queenbee subscription type, and the paid ones
+# are priced in Stripe under the price id found in STRIPE_<SHORT_NAME>_PRICE_ID.
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  SHORT_NAMES = %w[ FreeV1 MonthlyV1 MonthlyExtraStorageV1 ]
 
-  def self.short_name
-    name.demodulize
+  class << self
+    def short_name
+      name.demodulize
+    end
+
+    def all
+      SHORT_NAMES.collect { |short_name| const_get(short_name, false) }
+    end
+
+    def free
+      FreeV1
+    end
+
+    def paid
+      all.select(&:paid?)
+    end
+
+    def complimentary
+      MonthlyExtraStorageV1
+    end
+
+    def find(name)
+      all.find { |subscription| subscription.called?(name) }
+    end
+
+    def find_by_stripe_price_id(price_id)
+      paid.find { |subscription| subscription.stripe_price_id == price_id } if price_id.present?
+    end
+
+    # Matches a Stripe price, as it appears on a subscription item, to a paid plan: by the
+    # configured price id first, or failing that by what it charges or what it is called.
+    def find_by_stripe_price(price)
+      price = price.to_h.symbolize_keys
+
+      find_by_stripe_price_id(price[:id]) ||
+        paid.find { |subscription| subscription.charges?(price) } ||
+        paid.find { |subscription| subscription.called?(price[:lookup_key] || price[:nickname]) }
+    end
+
+    # Answers to the short name, its underscored form, or the proper name.
+    def called?(name)
+      [ short_name, short_name.underscore, proper_name ].any? { |candidate| candidate.casecmp?(name.to_s) }
+    end
+
+    def charges?(price)
+      self.price * 100 == price[:unit_amount] && price[:currency].to_s.in?([ "", "usd" ])
+    end
+
+    def free?
+      price.zero?
+    end
+
+    def paid?
+      !free?
+    end
+
+    def unlimited_cards?
+      card_limit.nil?
+    end
+
+    def stripe_price_id
+      ENV.fetch("STRIPE_#{short_name.underscore.upcase}_PRICE_ID") { "price_#{short_name.underscore}" if Rails.env.local? }
+    end
+
+    def to_param
+      short_name
+    end
   end
 
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+    property :proper_name,   "Free"
+    property :price,         0
+    property :frequency,     "yearly"
+    property :card_limit,    1_000
+    property :storage_limit, 1.gigabyte
+  end
+
+  class MonthlyV1 < Subscription
+    property :proper_name,   "Unlimited"
+    property :price,         20
+    property :frequency,     "monthly"
+    property :card_limit,    nil
+    property :storage_limit, 5.gigabytes
+  end
+
+  class MonthlyExtraStorageV1 < Subscription
+    property :proper_name,   "Unlimited+"
+    property :price,         25
+    property :frequency,     "monthly"
+    property :card_limit,    nil
+    property :storage_limit, 500.gigabytes
   end
 end
