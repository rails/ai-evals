+# Sends an admin to Stripe Checkout to pay for a plan. Stripe reports back through the webhooks.
+class Account::Subscriptions::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+  before_action :ensure_not_already_paying
+  before_action :set_plan
+
+  def create
+    checkout = Current.account.create_stripe_checkout_session @plan,
+      success_url: account_subscription_url(checkout: "completed"), cancel_url: account_subscription_url
+
+    redirect_to checkout.url, allow_other_host: true, status: :see_other
+  end
+
+  private
+    def ensure_not_already_paying
+      redirect_to account_subscription_path, notice: "You already have a plan. Manage it from the billing portal." if Current.account.paid?
+    end
+
+    def set_plan
+      @plan = Subscription.find(params[:plan])
+      head :unprocessable_entity unless @plan&.paid?
+    end
+end
