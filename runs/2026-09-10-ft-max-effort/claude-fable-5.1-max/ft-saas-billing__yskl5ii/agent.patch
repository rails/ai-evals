+      </dl>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Comp</h2>
+        <div>A comped account gets the <%= Subscription.complimentary.proper_name %> plan without paying.</div>
+      </header>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn btn--link" %>
