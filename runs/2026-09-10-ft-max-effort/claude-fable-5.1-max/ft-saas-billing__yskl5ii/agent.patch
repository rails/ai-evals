+<section class="settings__section settings-subscription">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= account.plan.proper_name %></strong> plan<%= ", on the house" if account.comped? && !account.paid? %>:
+      <%= plan_card_allowance(account.plan).downcase %> and <%= plan_storage_allowance(account.plan) %>.
+    </div>
+  </header>
+
+  <ul class="list-unindented margin-block-none">
+    <% if account.card_limit %>
+      <li><strong><%= number_with_delimiter(account.card_count) %></strong> of <%= number_with_delimiter(account.card_limit) %> cards used</li>
+    <% end %>
+    <li><strong><%= number_to_human_size(account.bytes_used) %></strong> of <%= number_to_human_size(account.storage_limit) %> storage used</li>
+    <% if subscription = account.active_subscription %>
+      <% if subscription.canceling? %>
+        <li>Your subscription ends <%= local_datetime_tag subscription.cancel_at, style: :date %>.</li>
+      <% elsif subscription.current_period_end %>
+        <li>Next payment of <%= number_to_currency((subscription.next_amount_due_in_cents || subscription.plan.price * 100) / 100.0) %> on <%= local_datetime_tag subscription.current_period_end, style: :date %>.</li>
+      <% end %>
+      <% if subscription.past_due? %>
+        <li class="txt-negative">Your last payment failed. Please update your payment details.</li>
+      <% end %>
+    <% end %>
+  </ul>
+
+  <% if Current.user.admin? %>
+    <div class="flex gap-half flex-wrap">
+      <% if account.paid? %>
+        <%= button_to "Manage subscription", account_subscription_portal_path, class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+        <%= link_to "See the plans", account_subscription_path, class: "btn btn--plain txt-link" %>
+      <% elsif upgrade_plan_for(account) %>
+        <%= link_to "Upgrade", account_subscription_path, class: "btn btn--link settings-subscription__button" %>
+      <% end %>
+    </div>
+  <% end %>
+</section>
