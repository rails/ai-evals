diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..25f7983
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,46 @@
+# Stripe posts subscription changes here, signed with STRIPE_WEBHOOK_SECRET. Development and
+# test have no Stripe to sign anything, so unsigned events are let through there when no
+# secret is configured.
+class Stripe::WebhooksController < ApplicationController
+  skip_before_action :require_account, :require_authentication
+  allow_unauthorized_access
+  skip_forgery_protection
+
+  before_action :set_event
+
+  def create
+    case @event.type
+    when "checkout.session.completed"
+      Account::Subscription.complete_checkout(@event.data.object)
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+      Account::Subscription.sync(@event.data.object)
+    when "invoice.upcoming"
+      Account::Subscription.record_upcoming_invoice(@event.data.object)
+    end
+
+    head :ok
+  end
+
+  private
+    def set_event
+      @event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"].to_s, webhook_secret)
+    rescue Stripe::SignatureVerificationError
+      if unsigned_events_allowed?
+        @event = Stripe::Event.construct_from(JSON.parse(request.raw_post, symbolize_names: true))
+      else
+        head :bad_request
+      end
+    rescue JSON::ParserError
+      head :bad_request
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"].to_s.tap do |secret|
+        raise "STRIPE_WEBHOOK_SECRET is not set, so Stripe webhooks can't be verified" if secret.blank? && !Rails.env.local?
+      end
+    end
+
+    def unsigned_events_allowed?
+      Rails.env.local? && ENV["STRIPE_WEBHOOK_SECRET"].blank?
+    end
+end
