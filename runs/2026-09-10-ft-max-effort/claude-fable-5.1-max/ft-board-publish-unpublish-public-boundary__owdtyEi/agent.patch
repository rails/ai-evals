diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..533ba52
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,38 @@
+<%= turbo_frame_tag board, :publication do %>
+  <% if board.published? || Current.user.admin? %>
+    <div class="margin-block-end">
+      <h2 class="divider txt-large">Public link</h2>
+
+      <% if board.published? %>
+        <% url = public_board_url(board.publication) %>
+        <p class="margin-none-block-start">Anyone with this link can see a read-only version of this board and its cards. No sign in needed.</p>
+
+        <div class="flex align-center gap-half">
+          <input type="text" class="input flex-item-grow" value="<%= url %>" readonly aria-label="Public link">
+
+          <%= button_to_copy_to_clipboard(url) do %>
+            <%= icon_tag "copy-paste" %>
+            <span class="for-screen-reader">Copy public link</span>
+          <% end %>
+        </div>
+
+        <% if Current.user.admin? %>
+          <div class="flex align-center justify-center margin-block-start">
+            <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative txt-small", data: { turbo_confirm: "Are you sure you want to unpublish this board? The public link will stop working." } do %>
+              <span>Unpublish this board</span>
+            <% end %>
+          </div>
+        <% end %>
+      <% else %>
+        <p class="margin-none-block-start">Publish this board to share a read-only version of it with anyone via a secret link.</p>
+
+        <div class="flex align-center justify-center">
+          <%= button_to board_publication_path(board), method: :post, class: "btn" do %>
+            <%= icon_tag "share" %>
+            <span>Publish this board</span>
+          <% end %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+<% end %>
