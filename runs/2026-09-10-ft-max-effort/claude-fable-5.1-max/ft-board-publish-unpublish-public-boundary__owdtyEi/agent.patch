@@ -0,0 +1,38 @@
+require "application_system_test_case"
+
+class PublicBoardTest < ApplicationSystemTestCase
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "browsing a public board without signing in" do
+    visit public_board_url(@key)
+
+    assert_selector "h1", text: "Writebook"
+    assert_selector "#maybe h3", text: "Buy domain"
+
+    # Columns load their cards lazily and start out collapsed
+    assert_selector "##{dom_id(columns(:writebook_triage), :cards)} .card", count: 2, visible: :all
+    find("##{dom_id(columns(:writebook_triage))} .cards__expander").click
+    assert_selector "##{dom_id(columns(:writebook_triage))}.is-expanded h3", text: "The logo isn't big enough"
+
+    click_on "The logo isn't big enough"
+    assert_selector "h1.card__title", text: "The logo isn't big enough"
+    assert_selector ".comment", text: "I agree"
+
+    click_on "Back to Writebook"
+    assert_selector "h1", text: "Writebook"
+  end
+
+  test "browsing a public column" do
+    visit public_board_column_url(@key, columns(:writebook_triage))
+
+    assert_selector "h1", text: "Column: Triage"
+    assert_selector ".card", count: 2
+
+    click_on "Back to Writebook"
+    assert_selector "h1", text: "Writebook"
+  end
+end
