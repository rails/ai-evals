diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..1af89c8
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    board = Board.create!(name: "New board", creator: users(:kevin))
+
+    assert_not board.published?
+    assert_nil board.publication
+  end
+
+  test "publishing creates a publication with a secret key" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.publication.key.present?
+    assert_equal @board.account, @board.publication.account
+  end
+
+  test "publishing an already published board keeps the same key" do
+    @board.publish
+    key = @board.publication.key
+
+    @board.publish
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublishing destroys the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_not @board.reload.published?
+  end
+
+  test "unpublishing a board that isn't published is a no-op" do
+    assert_no_difference -> { Board::Publication.count } do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+  end
+
+  test "republishing generates a new key" do
+    @board.publish
+    old_key = @board.publication.key
+
+    @board.unpublish
+    @board.publish
+
+    assert_not_equal old_key, @board.publication.key
+  end
+
+  test "publishing and unpublishing touch the board" do
+    assert_changes -> { @board.reload.updated_at } do
+      @board.publish
+    end
+
+    assert_changes -> { @board.reload.updated_at } do
+      @board.unpublish
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "published cards of published boards are publicly accessible" do
+    assert_not cards(:logo).publicly_accessible?
+
+    @board.publish
+
+    assert cards(:logo).reload.publicly_accessible?
+    assert comments(:logo_agreement_jz).publicly_accessible?
+  end
+
+  test "drafted cards are never publicly accessible" do
+    board = boards(:miltons_wish_list)
+    board.publish
+
+    assert cards(:radio).reload.publicly_accessible?
+    assert_not cards(:unfinished_thoughts).reload.publicly_accessible?
+  end
+end
