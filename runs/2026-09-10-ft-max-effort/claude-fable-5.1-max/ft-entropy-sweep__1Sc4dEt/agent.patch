@@ -0,0 +1,9 @@
+class Card::AutoPostponeDueJob < ApplicationJob
+  # The sweep runs hourly. Should a run ever outlast its hour, skip the next one rather than
+  # letting overlapping sweeps contend for the same cards and slow each other down further.
+  limits_concurrency to: 1, key: "all", on_conflict: :discard, duration: 1.hour
+
+  def perform
+    Card.auto_postpone_all_due
+  end
+end
