@@ -0,0 +1,8 @@
+class IndexCardsOnBoardIdAndLastActiveAt < ActiveRecord::Migration[8.2]
+  def change
+    # The entropy sweep looks up each board's cards by last_active_at. Including status and id
+    # lets SQLite answer that lookup from the index alone (InnoDB includes the primary key implicitly).
+    add_index :cards, [ :board_id, :last_active_at, :status, :id ]
+    remove_index :cards, :board_id
+  end
+end
