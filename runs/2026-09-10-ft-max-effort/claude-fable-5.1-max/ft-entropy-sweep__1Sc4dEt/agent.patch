diff --git a/test/jobs/card/auto_postpone_due_job_test.rb b/test/jobs/card/auto_postpone_due_job_test.rb
new file mode 100644
index 0000000..2430698
--- /dev/null
+++ b/test/jobs/card/auto_postpone_due_job_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class Card::AutoPostponeDueJobTest < ActiveJob::TestCase
+  test "postpones every card that is due, across boards and accounts" do
+    cards(:logo).update!(last_active_at: 1.year.ago)
+    cards(:radio).update!(last_active_at: 1.year.ago)
+
+    Card::AutoPostponeDueJob.perform_now
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:radio).reload.postponed?
+    assert_empty Card.due_to_be_postponed
+  end
+
+  test "only one sweep runs at a time and an overlapping one is skipped" do
+    assert_equal 1, Card::AutoPostponeDueJob.concurrency_limit
+    assert_equal :discard, Card::AutoPostponeDueJob.concurrency_on_conflict
+    assert Card::AutoPostponeDueJob.new.concurrency_limited?
+  end
+end
diff --git a/test/models/board/entropic_test.rb b/test/models/board/entropic_test.rb
new file mode 100644
index 0000000..18cf893
--- /dev/null
+++ b/test/models/board/entropic_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Board::EntropicTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "auto postpone due cards postpones the cards idle for longer than the board period" do
+    cards(:logo).update!(last_active_at: 91.days.ago)
+    cards(:shipping).update!(last_active_at: 89.days.ago)
+
+    boards(:writebook).auto_postpone_due_cards
+
+    assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone due cards falls back to the account period when the board has none" do
+    entropies(:writebook_board).destroy
+    cards(:logo).update!(last_active_at: 31.days.ago)
+    cards(:shipping).update!(last_active_at: 29.days.ago)
+
+    boards(:writebook).reload.auto_postpone_due_cards
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone due cards leaves other boards alone" do
+    cards(:logo).update!(last_active_at: 1.year.ago)
+    cards(:radio).update!(last_active_at: 1.year.ago)
+
+    boards(:writebook).auto_postpone_due_cards
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+  end
+end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..75ea3f4 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,53 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "idle_for scope" do
+    cards(:logo).update!(last_active_at: 31.days.ago)
+    cards(:shipping).update!(last_active_at: 29.days.ago)
+
+    assert_includes Card.idle_for(30.days.to_i), cards(:logo)
+    assert_not_includes Card.idle_for(30.days.to_i), cards(:shipping)
+  end
+
+  test "idle_for scope only considers active cards" do
+    cards(:shipping).close
+    cards(:layout).postpone
+    cards(:text).drafted!
+    cards(:logo, :shipping, :layout, :text).each { |card| card.update!(last_active_at: 1.year.ago) }
+
+    assert_equal [ cards(:logo) ], Card.idle_for(30.days.to_i).to_a
+  end
+
+  test "auto postpone all due leaves nothing due to be postponed" do
+    entropies(:writebook_board).update!(auto_postpone_period: 7.days)
+    boards(:writebook).cards.update_all(last_active_at: 6.days.ago)
+    cards(:logo).update!(last_active_at: 8.days.ago)
+    cards(:radio).update!(last_active_at: 91.days.ago)
+    cards(:paycheck).update!(last_active_at: 89.days.ago)
+    assert_equal cards(:logo, :radio).to_set, Card.due_to_be_postponed.to_set
+
+    Card.auto_postpone_all_due
+
+    assert_empty Card.due_to_be_postponed
+    assert cards(:logo).reload.postponed?
+    assert cards(:radio).reload.postponed?
+    assert_not cards(:buy_domain).reload.postponed?
+    assert_not cards(:paycheck).reload.postponed?
+  end
+
+  test "auto postpone all due ignores drafted, closed and already postponed cards" do
+    cards(:shipping).close
+    cards(:layout).postpone
+    cards(:logo, :shipping, :layout, :unfinished_thoughts).each { |card| card.update!(last_active_at: 1.year.ago) }
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:shipping).reload.closed?
+    assert_equal users(:david), cards(:layout).reload.postponed_by
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
 end
