+module Admin::AccountScoped
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_account
+  end
+
+  private
+    def set_account
+      @account = find_account(params[:account_id] || params[:id])
+    end
+
+    # Support knows accounts by the number in their URLs as often as by id.
+    def find_account(id)
+      if id.to_s.match?(/\A\d+\z/)
