diff --git a/saas/app/views/admin/accounts/index.html.erb b/saas/app/views/admin/accounts/index.html.erb
new file mode 100644
index 0000000..99230dc
--- /dev/null
+++ b/saas/app/views/admin/accounts/index.html.erb
@@ -0,0 +1,44 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half", data: { turbo_frame: "_top" } do |form| %>
+      <%= form.search_field :q, value: params[:q], placeholder: "Search by name or account number…", class: "input input--transparent full-width txt-small", autocomplete: "off", autofocus: true %>
+      <%= form.button class: "btn btn--circle btn--link" do %>
+        <%= icon_tag "search" %>
+        <span class="for-screen-reader">Search</span>
+      <% end %>
+    <% end %>
+
+    <% if @page.records.any? %>
+      <%= with_manual_pagination :admin_accounts, @page do %>
+        <ul class="margin-block-half">
+          <% @page.records.each do |account| %>
+            <li class="flex align-start gap-half margin-block-start-half">
+              <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+                <strong><%= link_to account.name, saas.admin_account_path(account), class: "txt-ink" %></strong>
+                <br>
+                <span class="txt-x-small txt-ink-medium">
+                  #<%= account.external_account_id %> •
+                  <%= account.owner_email || "No owner" %> •
+                  <%= account.plan.name %><%= " (comped)" if account.comped? && !account.subscribed? %><%= " • Cancelled" if account.cancelled? %>
+                </span>
+              </div>
+
+              <div class="txt-medium" style="text-align: right">
+                <strong><%= number_with_delimiter(account.cards_count) %></strong>
+                <span class="txt-x-small txt-ink-medium">cards</span>
+              </div>
+            </li>
+          <% end %>
+        </ul>
+      <% end %>
+    <% else %>
+      <p class="txt-align-center txt-subtle margin-block-half">No accounts match “<%= params[:q] %>”</p>
+    <% end %>
+  </div>
+</section>
