+<% plan = account.plan %>
+<% subscription = account.active_subscription %>
+
+<section class="settings__section settings-subscription">
+  <header>
+    <h2 class="divider">Plan</h2>
+  </header>
+
+  <div class="flex align-center justify-space-between gap flex-wrap">
+    <div class="txt-align-start">
+      <strong class="txt-medium"><%= plan.name %></strong>
+      <% if subscription %>
+        <span class="txt-subtle">· <%= number_to_currency(plan.price, precision: 0) %>/month</span>
+      <% elsif account.comped? %>
+        <span class="txt-subtle">· Complimentary</span>
+      <% end %>
+
+      <div class="txt-small">
+        <% if plan.unlimited_cards? %>
+          Unlimited cards
+        <% else %>
+          <%= number_with_delimiter(account.cards_used) %> of <%= number_with_delimiter(plan.card_limit) %> cards used
+        <% end %>
+        · <%= number_to_human_size(account.bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage used
+      </div>
+
+      <% if subscription&.ending? %>
+        <div class="txt-small txt-negative">Ends <%= subscription.cancel_at.to_date.to_fs(:long) %>, after which the account returns to the Free plan.</div>
+      <% elsif subscription&.status == "past_due" %>
+        <div class="txt-small txt-negative">The last payment didn’t go through. Update your payment details to keep the plan.</div>
+      <% end %>
+    </div>
+
+    <% if Current.user.admin? %>
+      <% if subscription %>
+        <%= button_to "Manage subscription", account_subscription_portal_path, class: "btn settings-subscription__button" %>
+      <% elsif !account.comped? %>
+        <%= link_to "Upgrade", account_subscription_path, class: "btn btn--link settings-subscription__button" %>
+      <% end %>
+    <% end %>
+  </div>
+</section>
