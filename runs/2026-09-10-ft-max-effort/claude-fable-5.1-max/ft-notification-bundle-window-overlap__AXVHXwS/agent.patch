diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..e903fc9
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @kevin = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "open_for starts the clock when the window opens and closes it after the user's frequency" do
+    @kevin.settings.update!(bundle_email_frequency: :daily)
+
+    freeze_time do
+      bundle = Notification::Bundle.open_for(@kevin)
+
+      assert bundle.persisted?
+      assert_equal @kevin.account, bundle.account
+      assert_equal 1.day.from_now, bundle.deliver_at
+      assert_not bundle.delivered?
+    end
+  end
+
+  test "open_for reuses the window that's already open so windows never overlap" do
+    bundle = Notification::Bundle.open_for(@kevin)
+
+    travel 3.hours do
+      assert_no_difference -> { Notification::Bundle.count } do
+        assert_equal bundle, Notification::Bundle.open_for(@kevin)
+      end
+    end
+  end
+
+  test "open_for reuses an overdue window that hasn't been delivered yet" do
+    bundle = Notification::Bundle.open_for(@kevin)
+
+    travel 5.hours do
+      assert bundle.reload.deliver_at.past?
+      assert_equal bundle, Notification::Bundle.open_for(@kevin)
+    end
+  end
+
+  test "open_for opens a new window once the previous one was delivered" do
+    delivered = Notification::Bundle.open_for(@kevin)
+    delivered.deliver
+
+    reopened = Notification::Bundle.open_for(@kevin)
+
+    assert_not_equal delivered, reopened
+    assert_equal [ reopened ], @kevin.notification_bundles.pending
+  end
+
+  test "open_for keeps windows apart per user" do
+    assert_not_equal Notification::Bundle.open_for(@kevin), Notification::Bundle.open_for(users(:david))
+  end
+
+  test "deliver_all_due enqueues delivery for pending bundles whose window has closed" do
+    due = @kevin.notification_bundles.create!(deliver_at: 1.minute.ago)
+    users(:david).notification_bundles.create!(deliver_at: 1.minute.from_now)
+    users(:jz).notification_bundles.create!(deliver_at: 1.day.ago, delivered_at: 1.day.ago)
+
+    assert_enqueued_with job: Notification::Bundle::DeliverJob, args: [ due ] do
+      Notification::Bundle.deliver_all_due
+    end
+
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob
+  end
+
+  test "deliver emails the bundle and closes the window" do
+    bundle = bundle_with(@notification)
+
+    freeze_time do
+      assert_enqueued_email_with NotificationMailer, :bundle, args: [ bundle ] do
+        bundle.deliver
+      end
+
+      assert_equal Time.current, bundle.reload.delivered_at
+    end
+  end
+
+  test "deliver only emails once" do
+    bundle = bundle_with(@notification)
+    bundle.deliver
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+  end
+
+  test "deliver skips the email when every bundled notification was already read" do
+    bundle = bundle_with(@notification)
+    @notification.read
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email when the bundle is empty" do
+    bundle = @kevin.notification_bundles.create!(deliver_at: Time.current)
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email when the user turned bundle emails off in the meantime" do
+    bundle = bundle_with(@notification)
+    @kevin.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email when the user was deactivated" do
+    bundle = bundle_with(@notification)
+    @kevin.deactivate
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email when the account was cancelled" do
+    bundle = bundle_with(@notification)
+    @kevin.account.cancel(initiated_by: users(:jason))
+    clear_enqueued_jobs
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver_later runs the delivery in a job" do
+    bundle = bundle_with(@notification)
+
+    assert_enqueued_emails 1 do
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        bundle.deliver_later
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "reschedule keeps the window's start and moves its end to match the new frequency" do
+    bundle = freeze_time { Notification::Bundle.open_for(@kevin) }
+
+    travel 1.hour do
+      @kevin.settings.update!(bundle_email_frequency: :weekly)
+      bundle.reschedule
+
+      assert_equal bundle.created_at + 1.week, bundle.reload.deliver_at
+    end
+  end
+
+  test "destroying a user destroys their bundles" do
+    bundle = bundle_with(@notification)
+
+    @kevin.destroy
+
+    assert_not Notification::Bundle.exists?(bundle.id)
+  end
+
+  private
+    def bundle_with(notification)
+      notification.user.notification_bundles.create!(deliver_at: Time.current).tap do |bundle|
+        notification.update_column :bundle_id, bundle.id
+      end
+    end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
new file mode 100644
index 0000000..bc859a9
--- /dev/null
+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "bundle_later is enqueued when a notification is created" do
+    assert_enqueued_with job: Notification::BundleJob do
+      users(:david).notifications.create!(source: events(:layout_published), creator: users(:jason))
+    end
+  end
+
+  test "bundle_later is enqueued when the notification's source changes" do
+    assert_enqueued_with job: Notification::BundleJob, args: [ @notification ] do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "bundle_later is not enqueued for other updates" do
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.read
+    end
+  end
+
+  test "bundle_now opens a window that starts when the first notification lands" do
+    freeze_time do
+      @notification.bundle_now
+
+      bundle = @notification.reload.bundle
+      assert_equal 4.hours.from_now, bundle.deliver_at
+      assert_equal [ @notification ], bundle.notifications
+    end
+  end
+
+  test "bundle_now adds notifications arriving later to the window that's already open" do
+    @notification.bundle_now
+    other = notifications(:layout_commented_kevin)
+
+    travel 3.hours do
+      assert_no_difference -> { Notification::Bundle.count } do
+        other.bundle_now
+      end
+    end
+
+    assert_equal @notification.reload.bundle, other.reload.bundle
+  end
+
+  test "bundle_now adds a notification arriving after the window closed but before it was delivered" do
+    @notification.bundle_now
+    other = notifications(:layout_commented_kevin)
+
+    travel 5.hours do
+      other.bundle_now
+    end
+
+    assert_equal @notification.reload.bundle, other.reload.bundle
+  end
+
+  test "bundle_now moves a re-notified notification into a new window once the old one was delivered" do
+    @notification.bundle_now
+    delivered = @notification.reload.bundle
+    delivered.deliver
+
+    @notification.bundle_now
+
+    assert_not_equal delivered, @notification.reload.bundle
+    assert_empty delivered.notifications.reload
+  end
+
+  test "bundle_now doesn't bundle when the user turned bundle emails off" do
+    @kevin.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+
+    assert_nil @notification.reload.bundle
+  end
+
+  test "bundle_now doesn't bundle for users without settings" do
+    mike = users(:mike)
+    notification = Current.with_account(mike.account) do
+      Notification.create!(user: mike, source: Event.create!(board: boards(:miltons_wish_list), creator: mike, eventable: cards(:radio), action: "card_published"), creator: mike)
+    end
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.bundle_now
+    end
+  end
+
+  test "bundle_now is bookkeeping that leaves the notification's timestamps and tray alone" do
+    assert_no_changes -> { @notification.reload.updated_at } do
+      assert_no_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        @notification.bundle_now
+      end
+    end
+  end
+
+  test "creating a notification lands it in the user's open window" do
+    david = users(:david)
+    open_bundle = Notification::Bundle.open_for(david)
+
+    notification = david.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    perform_enqueued_jobs only: Notification::BundleJob
+
+    assert_equal open_bundle, notification.reload.bundle
+  end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
