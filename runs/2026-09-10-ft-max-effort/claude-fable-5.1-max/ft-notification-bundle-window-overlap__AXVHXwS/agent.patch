diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..9a25d86
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,53 @@
+# A time window batching a user's notifications into a single email. The window opens when the
+# first notification lands and closes after the user's chosen frequency has elapsed.
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, dependent: :nullify
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :due, -> { pending.where(deliver_at: ..Time.current) }
+
+  class << self
+    def deliver_all_due
+      due.find_each(&:deliver_later)
+    end
+
+    # A user only ever has one window open at a time, so notifications arriving late join it rather than
+    # opening another. Expects the caller to hold a lock on the user so concurrent arrivals can't race here.
+    def open_for(user)
+      pending.lock.find_or_create_by!(user: user) do |bundle|
+        bundle.deliver_at = user.bundle_email_window.from_now
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.perform_later(self)
+  end
+
+  def deliver
+    with_lock do
+      unless delivered?
+        update! delivered_at: Time.current
+        NotificationMailer.bundle(self).deliver_later if deliverable?
+      end
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def reschedule
+    if window = user.bundle_email_window
+      update! deliver_at: created_at + window
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && user.receives_bundle_emails? && account.active? && notifications.unread.exists?
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..0e6560e
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,22 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :bundle_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  def bundle_now
+    user.with_lock do
+      if user.receives_bundle_emails?
+        # Joining a bundle is bookkeeping, not an update worth broadcasting or reordering the tray for.
+        update_column :bundle_id, Notification::Bundle.open_for(user).id
+      end
+    end
+  end
+end
