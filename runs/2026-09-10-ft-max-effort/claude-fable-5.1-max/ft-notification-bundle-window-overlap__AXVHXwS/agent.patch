@@ -0,0 +1,13 @@
+class NotificationMailerPreview < ActionMailer::Preview
+  def bundle
+    Event.reverse_chronologically.limit(10).each(&:notify_recipients) if Notification.unread.none?
+
+    user = Notification.unread.last.user
+    Current.account = user.account
+
+    bundle = user.notification_bundles.pending.first || user.notification_bundles.create!(deliver_at: Time.current)
+    user.notifications.unread.limit(5).update_all(bundle_id: bundle.id)
+
+    NotificationMailer.bundle(bundle)
+  end
+end
