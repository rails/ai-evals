diff --git a/test/integration/notification_bundles_test.rb b/test/integration/notification_bundles_test.rb
new file mode 100644
index 0000000..3c85bb0
--- /dev/null
+++ b/test/integration/notification_bundles_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class NotificationBundlesTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @assigner = users(:david)
+    @assignee = users(:kevin)
+    @card = cards(:logo)
+
+    @card.assignments.destroy_all
+    @assignee.notifications.destroy_all
+
+    Current.user = @assigner
+    freeze_time
+  end
+
+  test "notifications landing within the window are emailed together once it closes" do
+    notify_by_assigning @card
+    notify_by_commenting_on cards(:layout)
+
+    bundle = @assignee.notification_bundles.pending.sole
+    assert_equal 4.hours.from_now, bundle.deliver_at
+    assert_equal @assignee.notifications.reload.to_set, bundle.notifications.to_set
+
+    travel 3.hours do
+      assert_no_enqueued_emails { deliver_due_bundles }
+    end
+
+    travel 4.hours do
+      assert_emails 1 do
+        deliver_due_bundles
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @assignee.identity.email_address ], email.to
+    assert_equal "2 new notifications in 37signals", email.subject
+    assert_includes email.html_part.body.to_s, "#{@assignee.account.slug}/cards/#{@card.number}"
+    assert bundle.reload.delivered?
+  end
+
+  test "a notification landing after the window closed goes into the next one" do
+    notify_by_assigning @card
+    first_window = @assignee.notification_bundles.pending.sole
+
+    travel 4.hours do
+      deliver_due_bundles
+      notify_by_commenting_on cards(:layout)
+    end
+
+    second_window = @assignee.notification_bundles.pending.sole
+    assert_not_equal first_window, second_window
+    assert_equal [ notifications_for(cards(:layout)) ], second_window.notifications.to_a
+    assert_equal [ notifications_for(@card) ], first_window.notifications.to_a
+  end
+
+  test "people who turned bundle emails off get nothing" do
+    @assignee.settings.update!(bundle_email_frequency: :never)
+
+    notify_by_assigning @card
+
+    assert_empty @assignee.notification_bundles
+
+    travel 1.week do
+      assert_no_enqueued_emails { deliver_due_bundles }
+    end
+  end
+
+  test "people pick how long the window stays open" do
+    @assignee.settings.update!(bundle_email_frequency: :weekly)
+
+    notify_by_assigning @card
+
+    assert_equal 1.week.from_now, @assignee.notification_bundles.pending.sole.deliver_at
+  end
+
+  private
+    def notify_by_assigning(card)
+      perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::BundleJob ] do
+        card.toggle_assignment(@assignee)
+      end
+    end
+
+    def notify_by_commenting_on(card)
+      card.watch_by(@assignee)
+
+      perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::BundleJob ] do
+        card.comments.create!(body: "Take a look at this", creator: @assigner)
+      end
+    end
+
+    def notifications_for(card)
+      @assignee.notifications.find_by!(card: card)
+    end
+
+    def deliver_due_bundles
+      perform_enqueued_jobs only: [ Notification::Bundle::DeliverJob, ActionMailer::MailDeliveryJob ] do
+        Current.without_account { Notification::Bundle.deliver_all_due }
+      end
+    end
+end
diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
