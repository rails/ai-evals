@@ -0,0 +1,21 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.unread.preloaded.ordered
+
+    mail to: @user.identity.email_address, subject: bundle_subject
+  end
+
+  private
+    def bundle_subject
+      "#{@notifications.size} new #{"notification".pluralize(@notifications.size)} in #{@bundle.account.name}"
+    end
+
+    # Bundles are delivered on a schedule rather than from a request, so link into the bundle's account.
+    def default_url_options
+      super.merge(script_name: @bundle.account.slug)
+    end
+end
