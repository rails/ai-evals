index 0000000..0a6adf6
--- /dev/null
+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @settings = @kevin.settings
+  end
+
+  test "bundle emails go out every few hours by default" do
+    assert @settings.bundle_email_every_few_hours?
+    assert_equal 4.hours, @settings.bundle_email_window
+  end
+
+  test "bundle email window follows the frequency" do
+    assert_equal 1.day, @settings.tap { it.bundle_email_frequency = :daily }.bundle_email_window
+    assert_equal 1.week, @settings.tap { it.bundle_email_frequency = :weekly }.bundle_email_window
+    assert_nil @settings.tap { it.bundle_email_frequency = :never }.bundle_email_window
+  end
+
+  test "only known frequencies are accepted" do
+    @settings.bundle_email_frequency = :hourly
+
+    assert_not @settings.valid?
+    assert_includes @settings.errors[:bundle_email_frequency], "is not included in the list"
+  end
+
+  test "users receive bundle emails unless they turned them off" do
+    assert @kevin.receives_bundle_emails?
+
+    @settings.update!(bundle_email_frequency: :never)
+    assert_not @kevin.reload.receives_bundle_emails?
+  end
+
+  test "users without settings don't receive bundle emails" do
+    assert_not users(:mike).receives_bundle_emails?
+  end
+
+  test "changing the frequency reschedules the window that's currently open" do
+    bundle = Notification::Bundle.open_for(@kevin)
+
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert_equal bundle.created_at + 1.day, bundle.reload.deliver_at
+  end
+
+  test "changing the frequency leaves delivered windows alone" do
+    bundle = Notification::Bundle.open_for(@kevin)
+    bundle.deliver
+
+    assert_no_changes -> { bundle.reload.deliver_at } do
+      @settings.update!(bundle_email_frequency: :daily)
+    end
+  end
+
+  test "turning bundle emails off leaves the open window to close on its own schedule" do
+    bundle = Notification::Bundle.open_for(@kevin)
+
+    assert_no_changes -> { bundle.reload.deliver_at } do
+      @settings.update!(bundle_email_frequency: :never)
+    end
+
+    assert_not bundle.delivered?
+  end
+end
