@@ -0,0 +1,66 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @bundle = @kevin.notification_bundles.create!(deliver_at: Time.current)
+    @kevin.notifications.update_all(bundle_id: @bundle.id)
+  end
+
+  test "bundle goes to the user with a subject counting the notifications" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @kevin.identity.email_address ], email.to
+    assert_equal "3 new notifications in 37signals", email.subject
+  end
+
+  test "bundle subject reads naturally for a single notification" do
+    @kevin.notifications.where.not(id: notifications(:logo_assignment_kevin)).update_all(bundle_id: nil)
+
+    assert_equal "1 new notification in 37signals", NotificationMailer.bundle(@bundle).subject
+  end
+
+  test "bundle groups notifications by board with links into the account" do
+    email = NotificationMailer.bundle(@bundle)
+
+    [ email.html_part.body.to_s, email.text_part.body.to_s ].each do |body|
+      assert_includes body, boards(:writebook).name
+      assert_includes body, "Buy domain"
+      assert_includes body, "Moved back to Maybe? by David"
+      assert_includes body, "RE: Layout is broken"
+      assert_includes body, "Assigned to Kevin"
+      assert_includes body, "#{@kevin.account.slug}/cards/#{cards(:logo).number}"
+      assert_includes body, "#{@kevin.account.slug}/notifications/settings"
+    end
+  end
+
+  test "bundle leaves out notifications that were read in the meantime" do
+    notifications(:buy_domain_sent_back_to_triage_kevin).read
+
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_equal "2 new notifications in 37signals", email.subject
+    assert_not_includes email.html_part.body.to_s, "Buy domain"
+  end
+
+  test "bundle renders mentions" do
+    david = users(:david)
+    bundle = david.notification_bundles.create!(deliver_at: Time.current)
+    david.notifications.update_all(bundle_id: bundle.id)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_includes email.html_part.body.to_s, "JZ @mentioned you"
+    assert_includes email.text_part.body.to_s, "JZ @mentioned you"
+  end
+
+  test "bundle links into the account even without account context" do
+    Current.without_account do
+      assert_includes NotificationMailer.bundle(@bundle).html_part.body.to_s, "#{@kevin.account.slug}/cards/#{cards(:logo).number}"
+    end
+  end
+end
