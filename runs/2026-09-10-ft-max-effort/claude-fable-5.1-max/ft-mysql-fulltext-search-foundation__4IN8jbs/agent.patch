diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..27755d6
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "terms are the distinct words of the query" do
+    search = Search.new(users(:kevin), "  logo   Logo big ")
+
+    assert_equal %w[ logo big ], search.terms
+    assert_equal "logo Logo big", search.query
+    assert_not search.blank?
+  end
+
+  test "blank without any words" do
+    assert Search.new(users(:kevin), nil).blank?
+    assert Search.new(users(:kevin), "   ").blank?
+    assert_empty Search.new(users(:kevin), "   ").cards
+  end
+
+  test "cards matching every term, newest first" do
+    older = create_published_card("Haggis for breakfast", created_at: 2.days.ago)
+    newer = create_published_card("Haggis for dinner", created_at: 1.day.ago)
+
+    assert_equal [ newer, older ], Search.new(users(:kevin), "haggis").cards
+    assert_equal [ newer ], Search.new(users(:kevin), "haggis dinner").cards
+  end
+
+  test "cards from accessible boards only" do
+    card = create_published_card("Haggis in private", board: boards(:private))
+
+    assert_equal [ card ], Search.new(users(:kevin), "haggis").cards
+    assert_empty Search.new(users(:david), "haggis").cards
+  end
+
+  test "cards never include drafts" do
+    draft = boards(:writebook).cards.create!(title: "Haggis draft", creator: users(:kevin), status: :drafted)
+    draft.update! description: "Secret haggis notes"
+
+    assert_empty Search.new(users(:kevin), "haggis").cards
+  end
+
+  test "matching comments on a card" do
+    search = Search.new(users(:kevin), "overflowing agree")
+
+    assert_equal [ comments(:layout_overflowing_david) ], search.matching_comments_on(cards(:layout))
+    assert_equal [ comments(:logo_agreement_jz) ], search.matching_comments_on(cards(:logo))
+  end
+
+  test "pattern matches any term regardless of case" do
+    pattern = Search.new(users(:kevin), "logo 100%").pattern
+
+    assert_match pattern, "The LOGO is fine"
+    assert_match pattern, "Give it 100%"
+    assert_no_match pattern, "Give it 100"
+  end
+
+  private
+    def create_published_card(title, board: boards(:writebook), **attributes)
+      board.cards.create!(title: title, creator: Current.user, status: :published, **attributes)
+    end
+end
