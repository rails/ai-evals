@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "containing a term in the title" do
+    assert_equal [ cards(:logo) ], Card.containing("logo")
+    assert_equal [ cards(:logo) ], Card.containing("LOGO")
+  end
+
+  test "containing a term in the description" do
+    cards(:shipping).update! description: "<div>Nothing ships without <strong>haggis</strong>.</div>"
+
+    assert_equal [ cards(:shipping) ], Card.containing("haggis")
+  end
+
+  test "containing a term in the body of a comment" do
+    assert_equal [ cards(:layout) ], Card.containing("overflowing")
+  end
+
+  test "containing treats wildcards literally" do
+    cards(:logo).update! title: "The logo is 100% too small"
+
+    assert_equal [ cards(:logo) ], Card.containing("100%")
+    assert_equal [ cards(:logo) ], Card.containing("%")
+    assert_empty Card.containing("_")
+  end
+
+  test "matching requires every term, wherever each of them appears" do
+    assert_equal [ cards(:layout) ], Card.matching(%w[ layout overflowing ])
+    assert_empty Card.matching(%w[ logo overflowing ])
+  end
+
+  test "matching everything when there are no terms" do
+    assert_equal Card.count, Card.matching([]).count
+  end
+end
