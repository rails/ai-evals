+module SearchesHelper
+  # Plain-text snippet around the first match, with every match wrapped in <mark>. Nil when nothing matches.
+  def search_snippet(search, content, radius: 100)
+    if snippet = excerpt(content.to_plain_text.squish, search.pattern, radius: radius)
+      highlight(snippet, search.pattern)
+    end
+  end
+end
