+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless unpad flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards…", class: "input full-width", autofocus: true,
+          autocomplete: "off", autocorrect: "off", aria: { label: "Search cards" }, data: { "1p-ignore": "true" } %>
+
+    <button type="submit" class="btn btn--circle-mobile">
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    </button>
+  <% end %>
+
+  <% if @search.blank? %>
+    <p class="search__hint txt-small txt-subtle txt-align-center">Find cards by their title, description, or comments</p>
+  <% else %>
+    <div class="search__results flex flex-column gap-half">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+      <% end %>
+    </div>
+
+    <% if @page.empty? %>
+      <div class="blank-slate center">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% end %>
+</section>
