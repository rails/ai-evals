--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,14 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Cards containing every term, each somewhere in the title, the description, or the body of a comment.
+    scope :matching, ->(terms) { Array(terms).inject(all) { |cards, term| cards.containing(term) } }
+
+    scope :containing, ->(term) do
+      where(arel_table[:title].matches("%#{sanitize_sql_like(term)}%", "\\"))
+        .or(where(id: ActionText::RichText.containing(term).where(record_type: "Card", name: "description").select(:record_id)))
+        .or(where(id: Comment.containing(term).select(:card_id)))
+    end
+  end
+end
