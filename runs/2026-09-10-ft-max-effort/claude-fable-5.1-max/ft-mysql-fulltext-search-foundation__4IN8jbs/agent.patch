+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :containing, ->(term) { joins(:rich_text_body).merge(ActionText::RichText.containing(term)) }
+    scope :containing_any, ->(terms) { Array(terms).collect { |term| containing(term) }.inject(:or) }
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..e9977a4
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,33 @@
+class Search
+  MAX_COMMENTS_PER_CARD = 3
+
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user, @query = user, query.to_s.squish
+  end
+
+  def terms
+    @terms ||= query.split.uniq(&:downcase)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    if blank?
+      Card.none
+    else
+      user.accessible_cards.published.matching(terms).reverse_chronologically.preload(:board, :column).with_rich_text_description
+    end
+  end
+
+  def matching_comments_on(card)
+    card.comments.containing_any(terms).chronologically.with_rich_text_body.includes(:creator).limit(MAX_COMMENTS_PER_CARD)
+  end
+
+  def pattern
+    @pattern ||= Regexp.new(Regexp.union(terms).source, Regexp::IGNORECASE)
+  end
+end
