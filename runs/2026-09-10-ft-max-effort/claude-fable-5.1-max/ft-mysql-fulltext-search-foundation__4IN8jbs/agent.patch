diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..291f12b
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+
+    assert_select "input[name=q]"
+    assert_select ".search-result", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "show finds cards by title and marks the matched words" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:logo).id}" do
+      assert_select "a[href=?]", card_path(cards(:logo))
+      assert_select "mark", text: "logo"
+    end
+    assert_select "#search_result_card_#{cards(:layout).id}", count: 0
+  end
+
+  test "show finds cards by description" do
+    cards(:shipping).update! description: "<div>We can't ship without a proper haggis recipe.</div>"
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:shipping).id}" do
+      assert_select "mark", text: "haggis"
+    end
+    assert_select ".search-result", count: 1
+  end
+
+  test "show finds cards by the body of their comments" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:layout).id}" do
+      assert_select "mark", text: "overflowing"
+      assert_select "strong", text: users(:david).name
+    end
+    assert_select ".search-result", count: 1
+  end
+
+  test "show matches case insensitively" do
+    get search_path(q: "LOGO")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:logo).id}" do
+      assert_select "mark", text: "logo"
+    end
+  end
+
+  test "show requires every word to match, wherever it appears" do
+    get search_path(q: "layout overflowing")
+    assert_response :success
+    assert_select "#search_result_card_#{cards(:layout).id}"
+    assert_select ".search-result", count: 1
+
+    get search_path(q: "layout haggis")
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select ".blank-slate", text: /No cards match/
+  end
+
+  test "show lists the newest cards first" do
+    older, newer = with_current_user(:kevin) do
+      [ create_published_card("Haggis for breakfast", created_at: 2.days.ago), create_published_card("Haggis for dinner", created_at: 1.day.ago) ]
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_equal [ newer, older ].collect { dom_id(it, :search_result) }, css_select(".search-result").collect { it["id"] }
+  end
+
+  test "show only includes cards from boards the user has access to" do
+    card = with_current_user(:kevin) { create_published_card("Haggis in private", board: boards(:private)) }
+
+    get search_path(q: "haggis")
+    assert_select "#search_result_card_#{card.id}"
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "show never includes drafts" do
+    draft = boards(:writebook).cards.create!(title: "Haggis draft", creator: users(:kevin), status: :drafted)
+    draft.update! description: "Secret haggis notes"
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "show never includes cards from other accounts" do
+    get search_path(q: "radio")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "show treats wildcards in the query literally" do
+    cards(:logo).update_columns title: "The logo is 100% too small"
+
+    get search_path(q: "100%")
+    assert_select "#search_result_card_#{cards(:logo).id}" do
+      assert_select "mark", text: "100%"
+    end
+
+    get search_path(q: "%")
+    assert_select ".search-result", count: 1
+
+    get search_path(q: "_")
+    assert_select ".search-result", count: 0
+  end
+
+  test "show as JSON" do
+    get search_path(q: "overflowing", format: :json)
+    assert_response :success
+
+    assert_equal [ cards(:layout).number ], @response.parsed_body.pluck("number")
+  end
+
+  private
+    def create_published_card(title, board: boards(:writebook), **attributes)
+      board.cards.create!(title: title, creator: Current.user, status: :published, **attributes)
+    end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
