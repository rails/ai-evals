diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..1052c6b
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,22 @@
+class NotificationMailer < ApplicationMailer
+  helper_method :bundle_starts_at_in_words
+
+  def bundle(bundle)
+    @bundle = bundle
+    @account = bundle.account
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(updated_at: :desc)
+    @notifications_by_board = @notifications.group_by { it.card.board }.sort_by { |board, _| board.name.downcase }
+
+    mail to: @user.identity.email_address, subject: subject_for(@notifications.size)
+  end
+
+  private
+    def subject_for(count)
+      "#{count} new #{"notification".pluralize(count)} in #{@account.name}"
+    end
+
+    def bundle_starts_at_in_words
+      @bundle.starts_at.in_time_zone(@user.timezone).strftime("%A, %B %-d at %-l:%M %p %Z")
+    end
+end
