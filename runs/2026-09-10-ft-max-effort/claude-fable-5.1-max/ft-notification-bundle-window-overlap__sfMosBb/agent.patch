@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @kevin.settings.update!(bundle_email_frequency: :daily)
+    @notification = notifications(:layout_commented_kevin)
+  end
+
+  test "bundle_later enqueues Notification::BundleJob" do
+    assert_enqueued_with(job: Notification::BundleJob, args: [ @notification ]) do
+      @notification.bundle_later
+    end
+  end
+
+  test "bundle_later is called after notification is created" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @kevin.notifications.create!(source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "bundle_later is called when notification source changes" do
+    assert_enqueued_with(job: Notification::BundleJob, args: [ @notification ]) do
+      @notification.update!(source: events(:layout_published))
+    end
+  end
+
+  test "bundle_later is not called for other updates" do
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.read
+    end
+  end
+
+  test "bundle_now adds the notification to the user's current bundle" do
+    assert_nil @notification.bundle
+
+    @notification.bundle_now
+
+    bundle = @notification.reload.bundle
+    assert bundle.present?
+    assert_equal @kevin, bundle.user
+    assert_includes bundle.notifications, @notification
+  end
+
+  test "bundle_now doesn't touch the notification otherwise" do
+    assert_no_changes -> { @notification.reload.updated_at } do
+      assert_no_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        @notification.bundle_now
+      end
+    end
+  end
+
+  test "bundle_now puts notifications for the same user in the same bundle" do
+    other_notification = notifications(:logo_assignment_kevin)
+
+    @notification.bundle_now
+    other_notification.bundle_now
+
+    assert_equal @notification.reload.bundle, other_notification.reload.bundle
+  end
+
+  test "bundle_now moves a notification to the current bundle when it's notified about again" do
+    @notification.bundle_now
+    previous_bundle = @notification.reload.bundle
+    previous_bundle.update!(delivered_at: Time.current)
+
+    @notification.update!(source: events(:layout_published))
+    perform_enqueued_jobs only: Notification::BundleJob
+
+    assert_not_equal previous_bundle, @notification.reload.bundle
+    assert @notification.bundle.pending?
+  end
+
+  test "bundle_now does nothing when bundled emails are off" do
+    @kevin.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+
+    assert_nil @notification.reload.bundle
+  end
+
+  test "bundle_now does nothing for users without settings" do
+    notification = notifications(:logo_mentioned_david)
+    notification.update_column :user_id, users(:jason).id
+    assert_nil users(:jason).settings
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.reload.bundle_now
+    end
+  end
+
+  test "bundle_now does nothing for deactivated users" do
+    @kevin.update!(active: false)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+  end
+
+  test "bundle_now does nothing for notifications from the system user" do
+    @notification.update_column :creator_id, users(:system).id
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.reload.bundle_now
+    end
+  end
+
+  test "notifications get bundled once created" do
+    notifications(:layout_commented_kevin).destroy
+
+    notification = perform_enqueued_jobs only: Notification::BundleJob do
+      @kevin.notifications.create!(source: events(:layout_commented), creator: users(:david))
+    end
+
+    assert notification.reload.bundle.present?
+    assert_equal notification.created_at, notification.bundle.starts_at
+    assert_equal notification.created_at + 1.day, notification.bundle.ends_at
+  end
+
+  test "bundle job is discarded when the notification is gone" do
+    @notification.bundle_later
+    @notification.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Notification::BundleJob
+    end
+  end
+end
