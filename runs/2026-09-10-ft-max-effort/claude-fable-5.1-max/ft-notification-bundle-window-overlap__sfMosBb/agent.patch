+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:kevin).settings
+  end
+
+  test "bundle emails are daily by default" do
+    assert @settings.bundle_email_daily?
+    assert @settings.bundle_email?
+    assert_equal 1.day, @settings.bundle_email_interval
+  end
+
+  test "bundle emails can be turned off" do
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_not @settings.bundle_email?
+    assert_nil @settings.bundle_email_interval
+  end
+
+  test "bundle email frequency picks the interval between emails" do
+    { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, interval|
+      @settings.update!(bundle_email_frequency: frequency)
+
+      assert @settings.bundle_email?
+      assert_equal interval, @settings.bundle_email_interval
+    end
+  end
+
+  test "bundle email frequency only accepts the known frequencies" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+    assert_includes @settings.errors[:bundle_email_frequency], "is not included in the list"
+  end
+
+  test "user delegates bundle email settings" do
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert users(:kevin).bundle_email?
+    assert_equal 1.day, users(:kevin).bundle_email_interval
+  end
+
+  test "user without settings has no bundle email" do
+    assert_nil users(:jason).settings
+    assert_nil users(:jason).bundle_email?
+  end
+end
