index 0000000..3f6d4a2
--- /dev/null
+++ b/test/integration/notification_bundles_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class NotificationBundlesTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @kevin = users(:kevin)
+    @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+    @kevin.notifications.destroy_all
+    @start = Time.utc(2026, 3, 1, 10, 0)
+  end
+
+  test "notifications land in one window and go out in a single email once it ends" do
+    travel_to @start do
+      perform_enqueued_jobs do
+        Current.set(user: users(:david)) { cards(:logo).comments.create!(body: "First comment", creator: users(:david)) }
+      end
+
+      @bundle = @kevin.notification_bundles.sole
+      assert_equal @start...(@start + 4.hours), @bundle.window
+      assert_equal 1, @bundle.notifications.count
+    end
+
+    travel_to @start + 2.hours do
+      perform_enqueued_jobs do
+        Current.set(user: users(:david)) do
+          cards(:logo).comments.create!(body: "Second comment on the same card", creator: users(:david))
+          cards(:layout).comments.create!(body: "A comment on another card", creator: users(:david))
+        end
+      end
+
+      assert_equal @bundle, @kevin.notification_bundles.sole
+      assert_equal 2, @bundle.notifications.count
+    end
+
+    travel_to @start + 4.hours do
+      assert_emails 1 do
+        Current.without_account do
+          Notification::Bundle.deliver_all_due
+        end
+        perform_enqueued_jobs
+      end
+
+      assert @bundle.reload.delivered?
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "2 new notifications in 37signals", email.subject
+    assert_match "Second comment on the same card", email.html_part.body.decoded
+    assert_match "A comment on another card", email.html_part.body.decoded
+    assert_match "http://example.com#{@kevin.account.slug}/cards/#{cards(:logo).number}#comment_", email.html_part.body.decoded
+
+    travel_to @start + 5.hours do
+      perform_enqueued_jobs do
+        Current.set(user: users(:david)) { cards(:logo).comments.create!(body: "Third comment, after the email went out", creator: users(:david)) }
+      end
+
+      new_bundle = @kevin.notification_bundles.pending.sole
+      assert_equal @start + 5.hours, new_bundle.starts_at
+      assert_equal [ @kevin.notifications.find_by(card: cards(:logo)) ], new_bundle.notifications.to_a
+    end
+  end
+end
