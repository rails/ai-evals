@@ -0,0 +1,61 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @kevin.settings.update!(bundle_email_frequency: :daily, timezone_name: "America/Chicago")
+    @bundle = @kevin.notification_bundles.create!(starts_at: Time.utc(2026, 3, 1, 16), ends_at: Time.utc(2026, 3, 2, 16))
+
+    notifications(:logo_mentioned_david).update_columns(user_id: @kevin.id, card_id: cards(:shipping).id)
+    @kevin.notifications.update_all(bundle_id: @bundle.id)
+
+    @email = NotificationMailer.bundle(@bundle)
+  end
+
+  test "bundle sends one email to the user" do
+    assert_emails 1 do
+      @email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], @email.to
+    assert_equal "4 new notifications in 37signals", @email.subject
+  end
+
+  test "bundle has both HTML and text parts" do
+    assert @email.html_part.present?
+    assert @email.text_part.present?
+  end
+
+  test "bundle lists every notification grouped by board" do
+    html = @email.html_part.body.decoded
+
+    assert_match "Writebook", html
+    assert_match %r{href="http://example.com#{@kevin.account.slug}/boards/#{boards(:writebook).id}"}, html
+    assert_match "The logo isn&#39;t big enough", html
+    assert_match "Assigned to you by David", html
+    assert_match "RE: Layout is broken", html
+    assert_match "The text is overflowing the container.", html
+    assert_match "Moved back to Maybe? by David", html
+    assert_match "JZ mentioned you", html
+    assert_match %r{href="http://example.com#{@kevin.account.slug}/cards/#{cards(:logo).number}"}, html
+    assert_match %r{href="http://example.com#{@kevin.account.slug}/cards/#{cards(:layout).number}#comment_}, html
+  end
+
+  test "bundle tells since when in the user's timezone" do
+    assert_match "since Sunday, March 1 at 10:00 AM CST", @email.text_part.body.decoded
+  end
+
+  test "bundle links to the notification settings" do
+    assert_match "bundled daily", @email.text_part.body.decoded
+    assert_match "http://example.com#{@kevin.account.slug}/notifications/settings", @email.text_part.body.decoded
+  end
+
+  test "bundle with a single notification" do
+    @kevin.notifications.where.not(id: notifications(:layout_commented_kevin).id).update_all(bundle_id: nil)
+
+    email = NotificationMailer.bundle(@bundle.reload)
+
+    assert_equal "1 new notification in 37signals", email.subject
+    assert_match "1 new notification", email.html_part.body.decoded
+  end
+end
diff --git a/test/mailers/previews/notification_mailer_preview.rb b/test/mailers/previews/notification_mailer_preview.rb
