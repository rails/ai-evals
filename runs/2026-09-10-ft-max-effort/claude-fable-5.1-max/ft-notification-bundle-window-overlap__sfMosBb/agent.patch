index 0000000..1be9943
--- /dev/null
+++ b/test/mailers/previews/notification_mailer_preview.rb
@@ -0,0 +1,18 @@
+class NotificationMailerPreview < ActionMailer::Preview
+  def bundle
+    bundle = Notification::Bundle.joins(:notifications).last || sample_bundle
+    Current.account = bundle.account
+
+    NotificationMailer.bundle(bundle)
+  end
+
+  private
+    # The email is built from a bundle's notifications on record, so make one out of the latest notifications if there's none yet.
+    def sample_bundle
+      user = Notification.last.user
+
+      user.notification_bundles.create!(starts_at: 1.day.ago, ends_at: Time.current, delivered_at: Time.current).tap do |bundle|
+        user.notifications.limit(5).update_all(bundle_id: bundle.id)
+      end
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
