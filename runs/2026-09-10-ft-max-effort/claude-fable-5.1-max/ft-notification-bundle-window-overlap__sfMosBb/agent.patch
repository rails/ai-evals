--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,290 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @kevin = users(:kevin)
+    @kevin.settings.update!(bundle_email_frequency: :every_few_hours)
+    @start = Time.utc(2026, 3, 1, 10, 0)
+  end
+
+  test "the first notification opens a window that starts when it landed" do
+    travel_to @start do
+      notification = create_notification
+
+      bundle = Notification::Bundle.for(notification)
+
+      assert_equal @kevin, bundle.user
+      assert_equal @kevin.account, bundle.account
+      assert_equal @start, bundle.starts_at
+      assert_equal @start + 4.hours, bundle.ends_at
+      assert bundle.pending?
+    end
+  end
+
+  test "the window lasts as long as the user's frequency" do
+    @kevin.settings.update!(bundle_email_frequency: :weekly)
+
+    travel_to @start do
+      assert_equal @start...(@start + 1.week), Notification::Bundle.for(create_notification).window
+    end
+  end
+
+  test "notifications landing while a window is open join it" do
+    travel_to @start do
+      @bundle = Notification::Bundle.for(create_notification)
+    end
+
+    travel_to @start + 3.hours do
+      assert_no_difference -> { Notification::Bundle.count } do
+        assert_equal @bundle, Notification::Bundle.for(create_notification(events(:logo_assignment_km)))
+      end
+    end
+  end
+
+  test "notifications landing after a window has ended open a new one" do
+    travel_to @start do
+      @bundle = Notification::Bundle.for(create_notification)
+    end
+
+    travel_to @start + 4.hours do
+      new_bundle = Notification::Bundle.for(create_notification(events(:logo_assignment_km)))
+
+      assert_not_equal @bundle, new_bundle
+      assert_equal @start + 4.hours, new_bundle.starts_at
+    end
+  end
+
+  test "late notifications belong in the window that was open when they were created" do
+    travel_to @start do
+      @bundle = Notification::Bundle.for(create_notification)
+    end
+
+    travel_to @start + 5.hours do
+      late_notification = create_notification(events(:logo_assignment_km), created_at: @start + 3.hours)
+
+      assert @bundle.due?
+      assert_equal @bundle, Notification::Bundle.for(late_notification)
+    end
+  end
+
+  test "late notifications whose window was already delivered join the window open right now" do
+    travel_to @start do
+      @bundle = Notification::Bundle.for(create_notification)
+    end
+
+    travel_to @start + 4.hours do
+      @bundle.deliver
+      @open_bundle = Notification::Bundle.for(create_notification(events(:logo_assignment_km)))
+    end
+
+    travel_to @start + 4.hours + 5.minutes do
+      late_notification = create_notification(events(:buy_domain_sent_back_to_triage), created_at: @start + 3.hours)
+
+      assert_equal @open_bundle, Notification::Bundle.for(late_notification)
+    end
+  end
+
+  test "late notifications whose window was already delivered start a new window now rather than an overlapping one" do
+    travel_to @start do
+      @bundle = Notification::Bundle.for(create_notification)
+    end
+
+    travel_to @start + 4.hours do
+      @bundle.deliver
+    end
+
+    travel_to @start + 4.hours + 5.minutes do
+      late_notification = create_notification(events(:logo_assignment_km), created_at: @start + 3.hours)
+
+      new_bundle = Notification::Bundle.for(late_notification)
+
+      assert_not_equal @bundle, new_bundle
+      assert_equal Time.current, new_bundle.starts_at
+      assert_not new_bundle.window.overlap?(@bundle.window)
+    end
+  end
+
+  test "a window delivered before it ended is never overlapped: the next one starts once it ends" do
+    travel_to @start do
+      @bundle = Notification::Bundle.for(create_notification)
+      @bundle.deliver
+    end
+
+    travel_to @start + 1.hour do
+      new_bundle = Notification::Bundle.for(create_notification(events(:logo_assignment_km)))
+
+      assert_not_equal @bundle, new_bundle
+      assert_equal @bundle.ends_at, new_bundle.starts_at
+      assert_not new_bundle.window.overlap?(@bundle.window)
+    end
+  end
+
+  test "late notifications join a window that started after they were created if it's the one collecting now" do
+    travel_to @start do
+      @bundle = Notification::Bundle.for(create_notification)
+    end
+
+    travel_to @start + 1.minute do
+      late_notification = create_notification(events(:logo_assignment_km), created_at: @start - 1.second)
+
+      assert_equal @bundle, Notification::Bundle.for(late_notification)
+    end
+  end
+
+  test "notifications created so long ago that their window would be over already start a new window now" do
+    travel_to @start do
+      notification = create_notification(created_at: @start - 1.day)
+
+      assert_equal @start, Notification::Bundle.for(notification).starts_at
+    end
+  end
+
+  test "windows for the same user never overlap" do
+    @kevin.notification_bundles.create!(starts_at: @start, ends_at: @start + 4.hours)
+
+    overlapping = @kevin.notification_bundles.build(starts_at: @start + 2.hours, ends_at: @start + 6.hours)
+    assert_not overlapping.valid?
+    assert_includes overlapping.errors[:base], "Window overlaps another bundle"
+
+    assert @kevin.notification_bundles.build(starts_at: @start + 4.hours, ends_at: @start + 8.hours).valid?
+    assert users(:david).notification_bundles.build(starts_at: @start + 2.hours, ends_at: @start + 6.hours).valid?
+  end
+
+  test "a window must end after it starts" do
+    assert_not @kevin.notification_bundles.build(starts_at: @start, ends_at: @start).valid?
+    assert_not @kevin.notification_bundles.build(starts_at: @start, ends_at: @start - 1.hour).valid?
+  end
+
+  test "covering and due scopes" do
+    bundle = @kevin.notification_bundles.create!(starts_at: @start, ends_at: @start + 4.hours)
+
+    assert_includes Notification::Bundle.covering(@start), bundle
+    assert_includes Notification::Bundle.covering(@start + 3.hours), bundle
+    assert_not_includes Notification::Bundle.covering(@start + 4.hours), bundle
+    assert_not_includes Notification::Bundle.covering(@start - 1.second), bundle
+
+    travel_to(@start + 3.hours) { assert_not_includes Notification::Bundle.due, bundle }
+    travel_to(@start + 4.hours) { assert_includes Notification::Bundle.due, bundle }
+
+    bundle.update!(delivered_at: @start + 4.hours)
+    travel_to(@start + 4.hours) { assert_not_includes Notification::Bundle.due, bundle }
+  end
+
+  test "deliver emails the bundled notifications and marks the bundle delivered" do
+    bundle = bundle_with_notifications
+
+    travel_to @start + 4.hours do
+      assert_emails 1 do
+        bundle.deliver
+        perform_enqueued_jobs
+      end
+
+      assert bundle.reload.delivered?
+      assert_equal Time.current, bundle.delivered_at
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_match "2 new notifications", email.subject
+  end
+
+  test "deliver only ever emails a bundle once" do
+    bundle = bundle_with_notifications
+
+    assert_emails 1 do
+      bundle.deliver
+      bundle.deliver
+      perform_enqueued_jobs
+    end
+  end
+
+  test "deliver skips the email for users who turned bundled emails off since" do
+    bundle = bundle_with_notifications
+    @kevin.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_emails do
+      bundle.deliver
+      perform_enqueued_jobs
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email when there's nothing left to send" do
+    bundle = @kevin.notification_bundles.create!(starts_at: @start, ends_at: @start + 4.hours)
+
+    assert_no_emails do
+      bundle.deliver
+      perform_enqueued_jobs
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email for deactivated users" do
+    bundle = bundle_with_notifications
+    @kevin.update!(active: false)
+
+    assert_no_emails do
+      bundle.deliver
+      perform_enqueued_jobs
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver_later enqueues a delivery job" do
+    bundle = bundle_with_notifications
+
+    assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ bundle ]) do
+      bundle.deliver_later
+    end
+  end
+
+  test "deliver_all_due delivers the pending bundles whose window has ended" do
+    due = bundle_with_notifications(starts_at: @start - 4.hours, ends_at: @start)
+    open = @kevin.notification_bundles.create!(starts_at: @start, ends_at: @start + 4.hours)
+    delivered = @kevin.notification_bundles.create!(starts_at: @start - 8.hours, ends_at: @start - 4.hours, delivered_at: @start - 4.hours)
+
+    travel_to @start do
+      Current.without_account do
+        assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ due ]) do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+
+      assert_emails 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    assert due.reload.delivered?
+    assert open.reload.pending?
+    assert_equal @start - 4.hours, delivered.reload.delivered_at
+    assert_match %r{http://example.com#{@kevin.account.slug}/cards/}, ActionMailer::Base.deliveries.last.html_part.body.decoded
+  end
+
+  test "destroying a bundle leaves its notifications behind" do
+    bundle = bundle_with_notifications
+    notification = bundle.notifications.first
+
+    bundle.destroy
+
+    assert_nil notification.reload.bundle
+  end
+
+  private
+    def create_notification(source = events(:layout_commented), **attributes)
+      @kevin.notifications.where(card: source.card).destroy_all
+
+      Notification.create!(user: @kevin, source: source, creator: users(:david), **attributes)
+    end
+
+    def bundle_with_notifications(starts_at: @start, ends_at: @start + 4.hours)
+      @kevin.notification_bundles.create!(starts_at: starts_at, ends_at: ends_at).tap do |bundle|
+        @kevin.notifications.limit(2).each { |notification| notification.update_column :bundle_id, bundle.id }
+      end
+    end
+end
