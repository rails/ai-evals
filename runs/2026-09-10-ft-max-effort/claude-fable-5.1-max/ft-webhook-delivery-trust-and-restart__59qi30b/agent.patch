new file mode 100644
index 0000000..afe0390
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "tracking a failed delivery starts counting" do
+    freeze_time
+
+    @tracker.track failed_delivery
+
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert_equal Time.current, @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "tracking consecutive failures keeps the time of the first one" do
+    first_failure_at = 30.minutes.ago.change(usec: 0)
+    @tracker.update! consecutive_failures_count: 3, first_failure_at: first_failure_at
+
+    @tracker.track failed_delivery
+
+    assert_equal 4, @tracker.consecutive_failures_count
+    assert_equal first_failure_at, @tracker.first_failure_at
+  end
+
+  test "tracking a successful delivery resets the count" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+
+    @tracker.track successful_delivery
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "deactivates the webhook after ten consecutive failures spanning over an hour" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 61.minutes.ago
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      @tracker.track failed_delivery
+    end
+
+    assert @tracker.delinquent?
+  end
+
+  test "ten consecutive failures within an hour are not enough to deactivate the webhook" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 10.minutes.ago
+
+    assert_no_changes -> { @webhook.reload.active? } do
+      @tracker.track failed_delivery
+    end
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert_not @tracker.delinquent?
+  end
+
+  test "fewer than ten consecutive failures over an hour are not enough to deactivate the webhook" do
+    @tracker.update! consecutive_failures_count: 5, first_failure_at: 3.hours.ago
+
+    assert_no_changes -> { @webhook.reload.active? } do
+      @tracker.track failed_delivery
+    end
+
+    assert_not @tracker.delinquent?
+  end
+
+  test "a success in between failures prevents deactivation" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+
+    @tracker.track successful_delivery
+    @tracker.track failed_delivery
+
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating the webhook gives the receiver a fresh start" do
+    @tracker.update! consecutive_failures_count: 10, first_failure_at: 2.hours.ago
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new webhook: @webhook, event: events(:layout_commented), state: :errored, response: { error: "destination_unreachable" }
+    end
+
+    def successful_delivery
+      Webhook::Delivery.new webhook: @webhook, event: events(:layout_commented), state: :completed, response: { code: 200 }
+    end
+end
