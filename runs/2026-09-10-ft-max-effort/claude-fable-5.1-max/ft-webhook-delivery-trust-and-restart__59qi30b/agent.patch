   end
+
+  private
+    def claim
+      with_lock do
+        in_progress! if pending?
+      end
+    end
+
+    def post
+      http_response = Net::HTTP.start(uri.hostname, uri.port, **connection_options) { it.request(http_request) }
+      record_response http_response
+    rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout
+      record_error "timeout"
+    rescue OpenSSL::SSL::SSLError
+      record_error "ssl_error"
+    rescue SocketError, SystemCallError, IOError
+      record_error "destination_unreachable"
+    rescue Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, Zlib::Error
+      record_error "invalid_response"
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def connection_options
+      { use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT }
+    end
+
+    def http_request
+      Net::HTTP::Post.new(uri, headers).tap do |request|
+        request.body = payload.body
+        request.basic_auth uri.decoded_user, uri.decoded_password if uri.userinfo
+      end
+    end
+
+    def payload
+      @payload ||= Webhook::Payload.new(webhook, event)
+    end
+
+    def headers
+      @headers ||= {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => payload.content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload.body)
+    end
+
+    def record_response(http_response)
+      update! state: :completed, request: { headers: headers },
+        response: { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+    end
+
+    def record_error(error)
+      update! state: :errored, request: { headers: headers }, response: { error: error }
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..80e0c36
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,48 @@
+# What gets POSTed to a webhook's URL for an event. Generic receivers get the full
+# JSON representation of the event; chat integrations get a human-readable line.
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def body
+    @body ||= if webhook.for_slack?
+      { text: render(:text) }.to_json
+    elsif webhook.for_basecamp?
+      { content: render(:html) }.to_json
+    elsif webhook.for_campfire?
+      render(:html)
+    else
+      render(:json)
+    end
+  end
+
+  def content_type
+    webhook.for_campfire? ? "text/html" : "application/json"
+  end
+
+  private
+    def render(format)
+      renderer.render template: "webhooks/event", formats: format, assigns: { event: event }, layout: false
+    end
+
+    def renderer
+      ApplicationController.renderer.new script_name: event.account.slug, **host_env
+    end
+
+    # Links in the payload must be absolute, so point the renderer at the instance's public URL.
+    def host_env
+      if host = url_options[:host]
+        { http_host: [ host, url_options[:port] ].compact.join(":"), https: url_options[:protocol].to_s.start_with?("https") }
+      else
+        {}
+      end
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+    end
+end
