+    inactive = boards(:writebook).webhooks.create!(name: "Inactive", url: "https://inactive.example.com/", subscribed_actions: %w[ card_closed ], active: false)
+
+    event = cards(:logo).close.then { cards(:logo).events.last }
+    assert event.action.card_closed?
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        event.relay_now
+      end
+    end
+
+    assert_equal [ event ], webhook.deliveries.where(event: event).map(&:event)
+    assert_empty unsubscribed.deliveries
+    assert_empty inactive.deliveries
+  end
+
+  test "relaying ignores webhooks on other boards" do
+    other_board_webhook = webhooks(:inactive).tap { it.update!(active: true) }
+    assert_not_equal boards(:writebook), other_board_webhook.board
+
+    event = cards(:logo).close.then { cards(:logo).events.last }
+    event.relay_now
+
+    assert_empty other_board_webhook.deliveries
+  end
+
+  test "an event is posted to the receiver exactly once, end to end" do
+    WebMock.disable_net_connect!
+    webhook = webhooks(:active)
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs do
+      cards(:logo).close
+    end
+
+    event = cards(:logo).events.last
+    delivery = webhook.deliveries.find_by!(event: event)
+    assert delivery.succeeded?
+    assert_requested stub, times: 1
+
+    # Relaying the same event again neither creates nor posts another delivery
+    perform_enqueued_jobs do
+      event.relay_now
+    end
+
+    assert_equal 1, webhook.deliveries.where(event: event).count
+    assert_requested stub, times: 1
+  ensure
+    WebMock.allow_net_connect!
+  end
+end
