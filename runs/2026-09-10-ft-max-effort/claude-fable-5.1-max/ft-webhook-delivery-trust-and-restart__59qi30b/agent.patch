+# Relays events to the webhooks of the board they happened on.
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    board.webhooks.active.each { |webhook| webhook.deliver(self) }
+  end
+end
