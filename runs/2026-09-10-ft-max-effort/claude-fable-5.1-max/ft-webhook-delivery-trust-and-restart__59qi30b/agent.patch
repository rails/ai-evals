+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = @webhook.deliveries.create!(event: events(:layout_assignment_jz))
+
+    WebMock.disable_net_connect!
+  end
+
+  teardown do
+    WebMock.allow_net_connect!
+  end
+
+  test "performs the delivery" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(@delivery)
+
+    assert_requested stub
+    assert @delivery.reload.succeeded?
+  end
+
+  test "runs on the webhooks queue" do
+    assert_enqueued_with job: Webhook::DeliveryJob, queue: "webhooks" do
+      @delivery.deliver_later
+    end
+  end
+
+  test "is discarded when the delivery no longer exists" do
+    @delivery.deliver_later
+    @delivery.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+end
