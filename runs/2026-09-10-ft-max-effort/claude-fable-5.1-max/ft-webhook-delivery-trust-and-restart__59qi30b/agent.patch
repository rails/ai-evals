+# Never retried: the receiver must not get the same event twice, and the
+# delivery itself records how it went.
+class Webhook::DeliveryJob < ApplicationJob
+  queue_as :webhooks
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(delivery)
+    delivery.deliver
+  end
+end
