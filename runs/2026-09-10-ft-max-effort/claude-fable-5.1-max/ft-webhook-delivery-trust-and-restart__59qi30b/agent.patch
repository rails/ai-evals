+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:layout_commented)
+  end
+
+  test "generic webhooks get the event as JSON" do
+    payload = Webhook::Payload.new(webhooks(:active), @event)
+
+    assert_equal "application/json", payload.content_type
+
+    body = JSON.parse(payload.body)
+    assert_equal @event.id, body["id"]
+    assert_equal "comment_created", body["action"]
+    assert_equal @event.created_at.utc.iso8601(3), body["created_at"]
+    assert_equal @event.eventable.id, body.dig("eventable", "id")
+    assert_equal "The text is overflowing the container.", body.dig("eventable", "body", "plain_text")
+    assert_equal @event.board.id, body.dig("board", "id")
+    assert_equal @event.creator.id, body.dig("creator", "id")
+    assert_equal "David", body.dig("creator", "name")
+  end
+
+  test "generic webhooks get cards as JSON" do
+    body = JSON.parse(Webhook::Payload.new(webhooks(:active), events(:logo_published)).body)
+
+    assert_equal "card_published", body["action"]
+    assert_equal cards(:logo).id, body.dig("eventable", "id")
+    assert_equal cards(:logo).title, body.dig("eventable", "title")
+    assert_equal card_url(cards(:logo)), body.dig("eventable", "url")
+  end
+
+  test "Slack webhooks get a text message with an escaped description and a link" do
+    payload = Webhook::Payload.new(Webhook.new(url: "https://hooks.slack.com/services/T123/B456/xyz"), @event)
+
+    assert_equal "application/json", payload.content_type
+
+    text = JSON.parse(payload.body).fetch("text")
+    assert_includes text, %(David commented on "Layout is broken")
+    assert_includes text, "<#{card_url(cards(:layout))}#comment_#{@event.eventable.id}|↗︎>"
+    assert_not_includes text, "&quot;"
+  end
+
+  test "Slack messages escape characters that Slack treats as markup" do
+    cards(:layout).update_column :title, "Tom & Jerry <3"
+
+    text = JSON.parse(Webhook::Payload.new(Webhook.new(url: "https://hooks.slack.com/services/T123/B456/xyz"), @event).body).fetch("text")
+
+    assert_includes text, %(David commented on "Tom &amp; Jerry &lt;3")
+  end
+
+  test "Campfire webhooks get an HTML message" do
+    payload = Webhook::Payload.new(Webhook.new(url: "https://chat.example.com/rooms/1/2-bot-key/messages"), @event)
+
+    assert_equal "text/html", payload.content_type
+    assert_includes payload.body, "David commented on &quot;Layout is broken&quot;"
+    assert_includes payload.body, %(<a href="#{card_url(cards(:layout))}#comment_#{@event.eventable.id}">↗︎</a>)
+  end
+
+  test "Basecamp webhooks get an HTML message as a chatbot line" do
+    payload = Webhook::Payload.new(Webhook.new(url: "https://3.basecamp.com/1/integrations/token/buckets/2/chats/3/lines"), @event)
+
+    assert_equal "application/json", payload.content_type
+
+    content = JSON.parse(payload.body).fetch("content")
+    assert_includes content, "David commented on &quot;Layout is broken&quot;"
+    assert_includes content, %(<a href="#{card_url(cards(:layout))}#comment_#{@event.eventable.id}">↗︎</a>)
+  end
+
+  test "links use the instance's public URL" do
+    with_default_url_options host: "fizzy.example.com", protocol: "https" do
+      body = JSON.parse(Webhook::Payload.new(webhooks(:active), events(:logo_published)).body)
+
+      assert_match %r{\Ahttps://fizzy.example.com/\d+/cards/#{cards(:logo).number}\z}, body.dig("eventable", "url")
+    end
+  end
+
+  private
+    def card_url(card)
+      Rails.application.routes.url_helpers.card_url(card, host: "example.com", script_name: accounts("37s").slug)
+    end
+
+    def with_default_url_options(**options)
+      original = Rails.application.routes.default_url_options
+      Rails.application.routes.default_url_options = options
+      yield
+    ensure
+      Rails.application.routes.default_url_options = original
+    end
+end
