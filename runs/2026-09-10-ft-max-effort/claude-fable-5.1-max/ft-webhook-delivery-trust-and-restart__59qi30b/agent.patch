+require "test_helper"
+
+class WebhooksHelperTest < ActionView::TestCase
+  test "webhook_delivery_outcome describes how the delivery went" do
+    assert_equal "HTTP 200", webhook_delivery_outcome(webhook_deliveries(:successfully_completed))
+    assert_equal "HTTP 422", webhook_delivery_outcome(webhook_deliveries(:unsuccessfully_completed))
+    assert_equal "Destination unreachable", webhook_delivery_outcome(webhook_deliveries(:errored))
+    assert_equal "Timed out", webhook_delivery_outcome(Webhook::Delivery.new(state: :errored, response: { error: "timeout" }))
+    assert_equal "SSL error", webhook_delivery_outcome(Webhook::Delivery.new(state: :errored, response: { error: "ssl_error" }))
+    assert_nil webhook_delivery_outcome(webhook_deliveries(:pending))
+  end
+
+  test "slack_escape unescapes HTML entities and escapes Slack's control characters" do
+    assert_equal %(David added "Tom &amp; Jerry &lt;3"), slack_escape(%(David added &quot;Tom &amp; Jerry &lt;3&quot;).html_safe)
+    assert_equal "isn't", slack_escape("isn&#39;t")
+  end
+end
