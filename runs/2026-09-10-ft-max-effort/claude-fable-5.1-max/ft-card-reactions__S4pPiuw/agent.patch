diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..c63bf09
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @david_reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    @kevin_reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+
+    assert_select "##{dom_id(@david_reaction)}"
+    assert_select "##{dom_id(@kevin_reaction)}"
+    assert_select "a[href=?]", new_card_reaction_path(@card)
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+
+    assert_select "form[action=?]", card_reactions_path(@card)
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+
+    reaction = @card.reactions.last
+    assert_equal "Great work!", reaction.content
+    assert_equal users(:david), reaction.reacter
+    assert_equal @card, reaction.reactable
+  end
+
+  test "create touches the card activity" do
+    assert_changes -> { @card.reload.last_active_at } do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "🎉" } }
+    end
+  end
+
+  test "destroy" do
+    reaction = @david_reaction
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @kevin_reaction
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "cannot react to cards in inaccessible boards" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:david)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "👀" } }
+      assert_response :not_found
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+    assert_equal card_reaction_url(@card, @david_reaction), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, @card.reactions.last), @response.parsed_body["url"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
