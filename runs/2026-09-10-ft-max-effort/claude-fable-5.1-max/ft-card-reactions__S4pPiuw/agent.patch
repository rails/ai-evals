diff --git a/test/system/card_reactions_test.rb b/test/system/card_reactions_test.rb
new file mode 100644
index 0000000..e511a56
--- /dev/null
+++ b/test/system/card_reactions_test.rb
@@ -0,0 +1,42 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+  end
+
+  test "reacting to a card from its detail view" do
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      click_on "Add your own reaction"
+      fill_in "reaction[content]", with: "Love it!"
+      click_on "Submit"
+
+      assert_selector ".reaction", text: "Love it!"
+    end
+
+    reaction = @card.reactions.reload.last
+    assert_equal "Love it!", reaction.content
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "deleting your own reaction from a card" do
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      assert_selector ".reaction", text: "👍"
+
+      find(".reaction [data-reaction-delete-target='content']").click
+      click_on "Delete this reaction"
+
+      assert_no_selector ".reaction", text: "👍"
+    end
+
+    assert_empty @card.reactions.reload
+  end
+end
