@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled longer ago than the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes recently cancelled and active accounts" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not_includes Account.due_for_incineration, accounts(:initech)
+  end
+
+  test "incineratable?" do
+    assert_not @account.incineratable?
+
+    cancel @account, at: 1.day.ago
+    assert_not @account.incineratable?
+
+    @account.cancellation.update!(created_at: 31.days.ago)
+    assert @account.incineratable?
+  end
+
+  test "incinerate removes the account and everything in it" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    blob_key = card.image.blob.key
+    Storage::Entry.record account: @account, board: card.board, recordable: card, delta: 1024, operation: "attach"
+    card.reindex
+
+    cancel @account, at: 31.days.ago
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+    assert_empty ActionText::RichText.where(account_id: @account.id)
+    assert_empty ActiveStorage::Attachment.where(account_id: @account.id)
+    assert_empty ActiveStorage::Blob.where(account_id: @account.id)
+    assert_empty Search::Record.for(@account.id).where(account_id: @account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob_key)
+  end
+
+  test "incinerate leaves other accounts and identities alone" do
+    cancel @account, at: 31.days.ago
+
+    assert_no_difference -> { Identity.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(accounts(:initech).id)
+    assert_not_empty User.where(account: accounts(:initech))
+  end
+
+  test "incinerate does nothing for active accounts" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "incinerate does nothing for accounts still within the grace period" do
+    cancel @account, at: 1.day.ago
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  test "incinerate_due incinerates every account past the grace period" do
+    cancel @account, at: 31.days.ago
+    cancel accounts(:initech), at: 1.day.ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: account.users.admin.first)
+      account.cancellation.update!(created_at: at)
+    end
+end
