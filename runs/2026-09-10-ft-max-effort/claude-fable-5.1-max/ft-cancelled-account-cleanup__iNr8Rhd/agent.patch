diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..ed3cdd9 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,47 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  # Permanently removes the account and everything in it once the grace period after
+  # its cancellation has passed. Records that the account's associations don't reach
+  # are removed first, so an interrupted incineration can simply be run again.
+  def incinerate
+    if incineratable?
+      purge_blobs
+      delete_search_records
+      delete_storage_entries
+      destroy
+    end
+  end
+
+  def incineratable?
+    cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    # Attachments are deleted without callbacks so the storage ledger doesn't track
+    # detaches for an account that is going away. Purging the blobs removes the files too.
+    def purge_blobs
+      ActiveStorage::Attachment.where(account: self).in_batches.delete_all
+      ActiveStorage::Blob.where(account: self).find_each(&:purge)
+    end
+
+    def delete_search_records
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy)
+    end
+
+    def delete_storage_entries
+      Storage::Entry.where(account: self).in_batches.delete_all
+    end
 end
