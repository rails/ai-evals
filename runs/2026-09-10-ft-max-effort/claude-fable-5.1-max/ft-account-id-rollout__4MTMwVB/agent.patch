+    assignments:                  { from: :cards,    via: :card_id },
+    board_publications:           { from: :boards,   via: :board_id },
+    card_activity_spikes:         { from: :cards,    via: :card_id },
+    card_goldnesses:              { from: :cards,    via: :card_id },
+    card_not_nows:                { from: :cards,    via: :card_id },
+    closures:                     { from: :cards,    via: :card_id },
