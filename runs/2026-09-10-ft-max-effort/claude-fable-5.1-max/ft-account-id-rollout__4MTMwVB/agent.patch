diff --git a/test/models/tenant_tables_test.rb b/test/models/tenant_tables_test.rb
new file mode 100644
index 0000000..590bb81
--- /dev/null
+++ b/test/models/tenant_tables_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class TenantTablesTest < ActiveSupport::TestCase
+  # Tables holding no account data: the accounts themselves, global identity and
+  # authentication records, and the join tables behind Filter's has_and_belongs_to_many.
+  GLOBAL_TABLES = %w[
+    accounts account_external_id_sequences
+    identities identity_access_tokens magic_links sessions action_pack_passkeys
+    assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags
+  ]
+
+  # Rails-owned tables whose rows mostly, but not always, belong to an account (identity avatars don't).
+  ACCOUNT_OPTIONAL_TABLES = %w[ action_text_rich_texts active_storage_attachments active_storage_blobs active_storage_variant_records ]
+
+  test "every table holding an account's data has a required, indexed account_id" do
+    tenant_tables.each do |table|
+      column = connection.columns(table).find { |column| column.name == "account_id" }
+
+      assert column, "#{table} is missing account_id"
+      assert_not column.null, "#{table}.account_id should be required" unless ACCOUNT_OPTIONAL_TABLES.include?(table)
+      assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table}.account_id should be indexed"
+    end
+  end
+
+  private
+    def connection
+      ActiveRecord::Base.connection
+    end
+
+    def tenant_tables
+      connection.tables - GLOBAL_TABLES - %w[ ar_internal_metadata schema_migrations ] - full_text_search_tables
+    end
+
+    def full_text_search_tables
+      connection.tables.grep(/\Asearch_records_fts/)
+    end
