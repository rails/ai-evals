+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  setup do
+    @import = Account::Import.create_for(identities(:kevin), file: { io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip" })
+    Current.reset
+  end
+
+  test "completed tells the importer where the new account is" do
+    @import.account.update!(name: "Imported Co")
+    @import.update!(status: :completed)
+
+    email = ImportMailer.completed(@import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "Your Fizzy import is done", email.subject
+    assert_match "Imported Co", email.text_part.body.to_s
+    assert_match %r{http://example\.com/#{@import.account.external_account_id}/landing}, email.text_part.body.to_s
+  end
+
+  test "failed tells the importer why and where to try again" do
+    @import.update!(status: :failed, error_message: "The file isn't a Fizzy account export.", account: nil)
+
+    email = ImportMailer.failed(@import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal "Your Fizzy import failed", email.subject
+    assert_match "The file isn't a Fizzy account export.", email.text_part.body.to_s
+    assert_match "What went wrong", email.html_part.body.to_s
+    assert_match "nothing was created", email.text_part.body.to_s
+    assert_match "http://example.com/account/imports/new", email.text_part.body.to_s
