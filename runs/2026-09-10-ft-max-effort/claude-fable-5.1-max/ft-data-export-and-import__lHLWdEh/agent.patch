@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    @export = Account::Export.create!(user: users(:jason))
+    @export.process
+  end
+
+  test "archive describes itself" do
+    ZipFile.open(@export.file) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+
+      assert_equal Account::Export::FORMAT, manifest["format"]
+      assert_equal Account::Export::VERSION, manifest["version"]
+      assert_equal @account.name, manifest.dig("account", "name")
+    end
+  end
+
+  test "archive has every record set as JSON lines" do
+    ZipFile.open(@export.file) do |zip|
+      %w[ accounts users user_settings boards columns cards comments tags taggings accesses events notifications active_storage_blobs active_storage_attachments action_text_rich_texts ].each do |table|
+        assert zip.exists?("#{table}.jsonl"), "expected #{table}.jsonl in the archive"
+      end
+
+      assert_equal @account.cards.count, zip.each_line("cards.jsonl").count
+      assert_equal [ @account.id ], zip.each_line("accounts.jsonl").map { |line| JSON.parse(line)["id"] }
+      assert_equal @account.users.pluck(:name).sort, zip.each_line("users.jsonl").map { |line| JSON.parse(line)["name"] }.sort
+    end
+  end
+
+  test "users travel with their email addresses instead of identity ids" do
+    ZipFile.open(@export.file) do |zip|
+      jason = zip.each_line("users.jsonl").map { |line| JSON.parse(line) }.find { |user| user["name"] == "Jason" }
+
+      assert_equal "jason@37signals.com", jason["email_address"]
+      assert_not jason.key?("identity_id")
+    end
+  end
+
+  test "archive has the files behind the account's blobs" do
+    ZipFile.open(@export.file) do |zip|
+      blob = @card.image.blob
+
+      assert_equal file_fixture("moon.jpg").binread, zip.read("files/#{blob.id}/moon.jpg")
+    end
+  end
+
+  test "blobs don't carry the service they were stored with" do
+    ZipFile.open(@export.file) do |zip|
+      blob = JSON.parse(zip.each_line("active_storage_blobs.jsonl").first)
+
+      assert blob.key?("key")
+      assert_not blob.key?("service_name")
+    end
+  end
+
+  test "the export's own archive isn't part of the export" do
+    second_export = Account::Export.create!(user: users(:jason))
+    second_export.process
+
+    ZipFile.open(second_export.file) do |zip|
+      blob_ids = zip.each_line("active_storage_blobs.jsonl").map { |line| JSON.parse(line)["id"] }
+
+      assert_not_includes blob_ids, @export.file.blob.id
+      assert_not zip.glob("files/*/*").any? { |path| path.include?(@export.file.blob.id) }
+      assert zip.each_line("active_storage_attachments.jsonl").none? { |line| JSON.parse(line)["record_type"] == "Export" }
+    end
+  end
+
+  test "other accounts' data stays out" do
+    ZipFile.open(@export.file) do |zip|
+      board_ids = zip.each_line("boards.jsonl").map { |line| JSON.parse(line)["id"] }
+
+      assert_includes board_ids, boards(:writebook).id
+      assert_not_includes board_ids, boards(:miltons_wish_list).id
+    end
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
