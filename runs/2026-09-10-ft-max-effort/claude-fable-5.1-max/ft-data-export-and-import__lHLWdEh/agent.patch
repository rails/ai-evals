+
+  test "imports attachments signed for the records they now point at" do
+    target = accounts(:initech)
+    ids = Account::DataTransfer::IdMap.new
+    new_blob = Current.with_account(target) { ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg") }
+    ids[@blob.id] = new_blob.id
+    ids[users(:jason).id] = users(:mike).id
+
+    data = JSON.parse(@record_set.send(:attributes_for_export, @card.rich_text_description).to_json)
+    row = Current.with_account(target) do
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(target).send(:attributes_for_import, data, ids)
+    end
+    attachments = Nokogiri::HTML.fragment(row["body"]).css("action-text-attachment")
+
+    assert_equal [ new_blob.attachable_sgid, users(:mike).attachable_sgid ], attachments.map { |node| node["sgid"] }
+    assert attachments.none? { |node| node["gid"] }
+    assert_includes attachments.first["url"], target.slug
+    assert_equal [ new_blob, users(:mike) ], ActionText::Content.new(row["body"]).attachables
+  end
+
+  test "imports attachments to missing records without a signature" do
