diff --git a/test/integration/account_transfer_test.rb b/test/integration/account_transfer_test.rb
new file mode 100644
index 0000000..bbec5c3
--- /dev/null
+++ b/test/integration/account_transfer_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+# Exporting an account and importing it again, the way people do it: through the browser and email.
+class AccountTransferTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+
+    Current.user = users(:david)
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @card.update! description: "<p>Look #{ActionText::Attachment.from_attachable(blob).to_html} cc #{ActionText::Attachment.from_attachable(users(:jason)).to_html}</p>"
+    Current.reset
+  end
+
+  test "an admin exports the account, downloads it, and someone else imports it as a new account" do
+    sign_in_as :kevin
+    perform_enqueued_jobs only: [ Export::ProcessJob, ActionMailer::MailDeliveryJob ] do
+      post account_exports_url
+    end
+
+    export = Account::Export.last
+    assert export.completed?
+
+    download_link = ActionMailer::Base.deliveries.last.text_part.body.to_s[%r{^http\S+/rails/active_storage/blobs/redirect/\S+}]
+    assert download_link, "expected a download link in the email"
+    get URI(download_link).path
+    assert_response :redirect
+    get response.location
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+    archive = response.body
+
+    ActionMailer::Base.deliveries.clear
+    logout_and_sign_in_as :mike
+
+    untenanted do
+      get new_account_import_url
+      assert_response :success
+
+      perform_enqueued_jobs only: [ Account::Import::ProcessJob, ActionMailer::MailDeliveryJob ] do
+        post account_imports_url, params: { account_import: { file: Rack::Test::UploadedFile.new(StringIO.new(archive), "application/zip", true, original_filename: "export.zip") } }
+      end
+
+      import = Account::Import.last
+      assert import.completed?, import.error_message
+      assert_redirected_to account_import_url(import)
+      follow_redirect!
+      assert_select "a", text: "Open 37signals"
+    end
+
+    import = Account::Import.last
+    imported = import.account
+    assert_equal "37signals", imported.name
+    assert_not_equal @account, imported
+
+    email = ActionMailer::Base.deliveries.find { |mail| mail.subject == "Your Fizzy import is done" }
+    assert_equal [ "mike@37signals.com" ], email.to
+    assert_match landing_path(script_name: imported.slug), email.text_part.body.to_s
+
+    # Mike, who imported it, gets in as an admin and sees the card with its attachments intact
+    with_script_name(imported.slug) do
+      get landing_url
+      assert_response :redirect
+
+      get account_settings_url
+      assert_response :success
+      assert_select "h1", text: /Account Settings/
+
+      card = imported.cards.find_by!(number: @card.number)
+      get card_url(card)
+      assert_response :success
+      assert_select "h1", text: /logo isn't big enough/
+      assert_select "figure.attachment img[src*=?]", "#{imported.slug}/rails/active_storage/representations"
+      assert_select "action-text-attachment[content-type='application/vnd.actiontext.mention']", text: /Jason/
+
+      get rails_blob_url(card.image.blob)
+      assert_response :redirect
+    end
+
+    # The people who were in the account are in the new one too, and can get in
+    logout_and_sign_in_as :jason
+    with_script_name(imported.slug) do
+      get landing_url
+      assert_response :redirect
+      get account_settings_url
+      assert_response :success
+    end
+
+    untenanted do
+      get session_menu_url
+      assert_select "strong", text: "37signals", count: 2
+    end
+  end
+
+  private
+    def with_script_name(script_name)
+      original = integration_session.default_url_options[:script_name]
+      integration_session.default_url_options[:script_name] = script_name
+      yield
+    ensure
+      integration_session.default_url_options[:script_name] = original
+    end
+end
