diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..8ac525a
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,62 @@
+# An IO-like view of a stored ZIP file that fetches ranges of it on demand from the
+# blob's storage service, so archives of any size can be read without downloading
+# them whole. Only what ZipKit::FileReader needs is implemented: +seek+ (absolute),
+# +tell+, +size+ and +read+. Reads are buffered in large chunks since every fetch is a
+# round trip to the service.
+class ZipFile::BlobIO
+  CHUNK_SIZE = 8.megabytes
+
+  attr_reader :blob
+
+  def initialize(blob)
+    @blob = blob
+    @position = 0
+    @buffer = "".b
+    @buffer_offset = 0
+  end
+
+  def size
+    blob.byte_size
+  end
+
+  def tell
+    @position
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise ArgumentError, "Only IO::SEEK_SET is supported" unless mode == IO::SEEK_SET
+
+    @position = offset.clamp(0, size)
+    0
+  end
+
+  def read(length = nil)
+    length ||= size - @position
+    raise ArgumentError, "Negative length #{length} given" if length.negative?
+
+    if length.zero?
+      "".b
+    elsif @position >= size
+      nil
+    else
+      length = [ length, size - @position ].min
+      fill_buffer(length) unless buffered?(length)
+
+      @buffer.byteslice(@position - @buffer_offset, length).tap do |data|
+        @position += data.bytesize
+      end
+    end
+  end
+
+  private
+    def buffered?(length)
+      @position >= @buffer_offset && @position + length <= @buffer_offset + @buffer.bytesize
+    end
+
+    def fill_buffer(length)
+      last = [ @position + [ length, CHUNK_SIZE ].max, size ].min - 1
+
+      @buffer = blob.service.download_chunk(blob.key, @position..last).b
+      @buffer_offset = @position
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..921129b
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,46 @@
+# Reads the central directory of a ZIP archive up front and gives streaming access to
+# its entries, one at a time. Works on top of any IO-like object with +seek+, +tell+,
+# +size+ and +read+ — a File or a ZipFile::BlobIO.
+class ZipFile::Reader
+  class EntryNotFound < StandardError; end
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io, read_local_headers: false).index_by(&:filename)
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def size_of(path)
+    find(path).uncompressed_size
+  end
+
+  def read(path)
+    open(path, &:read)
+  end
+
+  def open(path)
+    entry = Entry.new(@io, find(path))
+
+    if block_given?
+      yield entry
+    else
+      entry
+    end
+  end
+
+  def each_line(path, &block)
+    open(path) { |entry| entry.each_line(&block) }
+  end
+
+  private
+    def find(path)
+      @entries.fetch(path) { raise EntryNotFound, "No entry named #{path} in the archive" }
+    end
+end
diff --git a/app/models/zip_file/reader/entry.rb b/app/models/zip_file/reader/entry.rb
new file mode 100644
index 0000000..11a6d88
--- /dev/null
+++ b/app/models/zip_file/reader/entry.rb
@@ -0,0 +1,86 @@
+# A single ZIP entry exposed as a read-only, forward-only IO: it inflates the compressed
+# bytes on the fly as they are asked for, so entries never have to fit in memory. Has the
+# subset of IO needed by IO.copy_stream and Active Storage service uploads.
+class ZipFile::Reader::Entry
+  CHUNK_SIZE = 1.megabyte
+  MAX_LINE_LENGTH = 256.megabytes
+
+  attr_reader :path
+
+  def initialize(io, zip_entry)
+    @io = io
+    @zip_entry = zip_entry
+    @path = zip_entry.filename
+    rewind
+  end
+
+  def size
+    @zip_entry.uncompressed_size
+  end
+
+  def rewind
+    @buffer = "".b
+    @extractor = nil
+    @exhausted = false
+    0
+  end
+
+  def eof?
+    @buffer.empty? && (@exhausted || extractor.eof?)
+  end
+
+  def read(length = nil, outbuf = nil)
+    fill_buffer_until { length.present? && @buffer.bytesize >= length }
+    data = take(length ? [ length, @buffer.bytesize ].min : @buffer.bytesize)
+
+    if data.empty? && length&.positive?
+      nil
+    else
+      outbuf ? outbuf.replace(data) : data
+    end
+  end
+
+  def each_line
+    return to_enum(:each_line) unless block_given?
+
+    loop do
+      fill_buffer_until { @buffer.include?("\n") || @buffer.bytesize > MAX_LINE_LENGTH }
+
+      if newline = @buffer.index("\n")
+        yield take(newline + 1)
+      elsif @buffer.bytesize > MAX_LINE_LENGTH
+        raise ZipKit::FileReader::ReadError, "Line in #{path} exceeds #{MAX_LINE_LENGTH} bytes"
+      elsif @buffer.empty?
+        break
+      else
+        yield take(@buffer.bytesize)
+      end
+    end
+  end
+
+  private
+    def extractor
+      @extractor ||= begin
+        @zip_entry.compressed_data_offset = compressed_data_offset unless @zip_entry.known_offset?
+        @zip_entry.extractor_from(@io)
+      end
+    end
+
+    def compressed_data_offset
+      ZipKit::FileReader.new.get_compressed_data_offset(io: @io, local_file_header_offset: @zip_entry.local_file_header_offset)
+    end
+
+    def fill_buffer_until
+      until yield || @exhausted
+        if chunk = extractor.extract(CHUNK_SIZE)
+          @buffer << chunk
+        else
+          @exhausted = true
+        end
+      end
+    end
+
+    def take(length)
+      @buffer.slice!(0, length)
+    end
+end
