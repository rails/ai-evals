+  end
+
+  test "leaves attachments that don't point at records alone" do
+    @card.update! description: %(<p><action-text-attachment content-type="image/*" url="https://example.com/pic.png" presentation="gallery"></action-text-attachment></p>)
+    body = @record_set.send(:attributes_for_export, @card.rich_text_description)["body"]
+    node = Nokogiri::HTML.fragment(body).at_css("action-text-attachment")
+
+    assert_nil node["gid"]
+    assert_equal "https://example.com/pic.png", node["url"]
