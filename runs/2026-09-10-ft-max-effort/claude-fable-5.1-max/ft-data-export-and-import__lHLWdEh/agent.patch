+require "test_helper"
+
+class Account::DataTransfer::IdMapTest < ActiveSupport::TestCase
+  setup do
+    @ids = Account::DataTransfer::IdMap.new
+  end
+
+  test "hands out a fresh id for each old one, consistently" do
+    new_id = @ids["03ax3uw3fe6abwb75m0nrjpbt"]
+
+    assert_not_equal "03ax3uw3fe6abwb75m0nrjpbt", new_id
+    assert_equal new_id, @ids["03ax3uw3fe6abwb75m0nrjpbt"]
+    assert_not_equal new_id, @ids["03ax3uw3fe6abwb75m0nrjpbu"]
+    assert_equal 25, new_id.length
+  end
+
+  test "keeps the time ordering of the old ids" do
+    older, newer = cards(:logo).id, Card.create!(board: boards(:writebook), creator: users(:david), title: "New").id
+
+    assert_operator @ids[older], :<, @ids[newer]
