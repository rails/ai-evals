@@ -0,0 +1,76 @@
+require "test_helper"
+
+class User::ExportTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    Current.user = @user
+
+    @card = cards(:logo)
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @embedded = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @card.update! description: "<p>Look #{ActionText::Attachment.from_attachable(@embedded).to_html} cc #{ActionText::Attachment.from_attachable(users(:jason)).to_html}</p>"
+    @attached = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("hello"), filename: "notes.txt", content_type: "text/plain")
+    @comment = @card.comments.create!(creator: @user, body: "<p>See #{ActionText::Attachment.from_attachable(@attached).to_html}</p>")
+
+    @export = User::Export.create!(user: @user)
+    @export.process
+  end
+
+  test "archive has a JSON document per card the user can see" do
+    ZipFile.open(@export.file) do |zip|
+      assert_equal @user.accessible_cards.published.map { |card| "cards/#{card.number}.json" }.sort, zip.glob("cards/*.json")
+      assert_equal "fizzy-cards-export", JSON.parse(zip.read("manifest.json"))["format"]
+    end
+  end
+
+  test "cards that the user can't see stay out" do
+    private_card = boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: "published")
+    @export = User::Export.create!(user: @user)
+    @export.process
+
+    ZipFile.open(@export.file) do |zip|
+      assert_not zip.exists?("cards/#{private_card.number}.json")
+    end
+  end
+
+  test "a card document has the card, its comments and its attachments" do
+    ZipFile.open(@export.file) do |zip|
+      card = JSON.parse(zip.read("cards/#{@card.number}.json"))
+
+      assert_equal @card.title, card["title"]
+      assert_equal "Writebook", card.dig("board", "name")
+      assert_equal "David", card.dig("creator", "name")
+      assert_equal %w[ web ], card["tags"] & %w[ web ]
+      assert_equal "Look [avatar.png] cc @jason", card.dig("description", "plain_text")
+      assert_equal %(<p>Look <img src="cards/1/avatar.png" alt="avatar.png"> cc @jason</p>), card.dig("description", "html")
+      assert_equal "cards/1/moon.jpg", card.dig("image", "path")
+      assert_equal [ "cards/1/avatar.png" ], card["attachments"].map { |attachment| attachment["path"] }
+      assert_equal @card.created_at.utc.iso8601(3), card["created_at"]
+
+      comment = card["comments"].find { |comment| comment["id"] == @comment.id }
+      assert_equal %(<p>See <a href="cards/1/notes.txt">notes.txt</a></p>), comment.dig("body", "html")
+      assert_equal [ "cards/1/notes.txt" ], comment["attachments"].map { |attachment| attachment["path"] }
+      assert_equal @card.comments.count, card["comments"].size
+    end
+  end
+
+  test "archive has every picture and file attached to the cards and their comments" do
+    ZipFile.open(@export.file) do |zip|
+      assert_equal file_fixture("moon.jpg").binread, zip.read("cards/1/moon.jpg")
+      assert_equal file_fixture("avatar.png").binread, zip.read("cards/1/avatar.png")
+      assert_equal "hello", zip.read("cards/1/notes.txt")
+    end
+  end
+
+  test "files with the same name get their own paths" do
+    another = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("bye"), filename: "notes.txt", content_type: "text/plain")
+    @card.comments.create!(creator: @user, body: "<p>And #{ActionText::Attachment.from_attachable(another).to_html}</p>")
+    @export = User::Export.create!(user: @user)
+    @export.process
+
+    ZipFile.open(@export.file) do |zip|
+      assert_equal "hello", zip.read("cards/1/notes.txt")
+      assert_equal "bye", zip.read("cards/1/notes-2.txt")
+    end
+  end
+end
