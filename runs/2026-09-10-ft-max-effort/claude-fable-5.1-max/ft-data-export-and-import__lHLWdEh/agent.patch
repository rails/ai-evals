+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @jason, @david = users(:jason), users(:david)
+    Current.user = @david
+
+    @card = cards(:logo)
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @embedded = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @card.update! description: "<p>Look #{ActionText::Attachment.from_attachable(@embedded).to_html} cc #{ActionText::Attachment.from_attachable(@jason).to_html}</p>"
+    @card.comments.create!(creator: @david, body: "<p>Noted #{ActionText::Attachment.from_attachable(ActiveStorage::Blob.create_and_upload!(io: StringIO.new("hello"), filename: "notes.txt", content_type: "text/plain")).to_html}</p>")
+    @card.toggle_tag_with("imported")
+    boards(:writebook).publish
+    boards(:writebook).update!(auto_postpone_period: 90.days)
+    @david.avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @filter = @david.filters.remember(indexed_by: "closed", tag_ids: [ tags(:web).id ], board_ids: [ boards(:writebook).id ], assignee_ids: [ @jason.id ], column_ids: [ columns(:writebook_triage).id ])
+
+    @export = Account::Export.create!(user: @jason)
+    @export.process
+
+    @importer = Identity.create!(email_address: "importer@example.com")
+    Current.reset
+  end
+
+  test "creating an import makes an empty account, stores the archive in it and queues the work" do
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_with job: Account::Import::ProcessJob do
+        @import = Account::Import.create_for(@importer, file: archive_upload)
+      end
+    end
+
+    assert @import.pending?
+    assert_equal @importer, @import.identity
+    assert_equal Account::Import::PLACEHOLDER_NAME, @import.account.name
+    assert @import.file.attached?
+    assert_equal @import.account, @import.file.blob.account
+    assert_empty @import.account.users
+  end
+
+  test "importing brings the whole account back as a new one" do
+    import = process_import
+
+    assert import.completed?, import.error_message
+    account = import.account
+    assert_not_equal @account, account
+    assert_equal "37signals", account.name
+    assert_equal @account.cards_count, account.cards_count
+    assert_not_equal @account.external_account_id, account.external_account_id
+
+    assert_equal @account.boards.pluck(:name).sort, account.boards.pluck(:name).sort
+    assert_equal @account.cards.pluck(:number, :title).sort, account.cards.pluck(:number, :title).sort
+    assert_equal Comment.where(account: @account).count, Comment.where(account: account).count
+    assert_equal @account.tags.pluck(:title).sort, account.tags.pluck(:title).sort
+    assert_equal Event.where(account: @account).count, Event.where(account: account).count
+    assert_equal Notification.where(account: @account).count, Notification.where(account: account).count
+    assert_equal Access.where(account: @account).count + 1, Access.where(account: account).count # plus the importer's
+    assert_equal ActiveStorage::Attachment.where(account: @account).where.not(record_type: "Export").count, ActiveStorage::Attachment.where(account: account).count
+
+    card = account.cards.find_by!(number: @card.number)
+    assert_equal @card.title, card.title
+    assert_equal @card.created_at, card.created_at
+    assert_equal @card.due_on, card.due_on
+    assert_equal "Writebook", card.board.name
+    assert_equal "Triage", card.column.name
+    assert_equal "David", card.creator.name
+    assert_equal account, card.creator.account
+    assert_equal @card.tags.pluck(:title).sort, card.tags.pluck(:title).sort
+    assert_equal @card.assignees.pluck(:name).sort, card.assignees.pluck(:name).sort
+    assert_equal @card.comments.count, card.comments.count
+    assert card.golden?
+  end
+
+  test "records keep their ids apart from the originals" do
+    account = process_import.account
+
+    assert_empty account.cards.ids & @account.cards.ids
+    assert_empty account.users.ids & @account.users.ids
+    assert_equal @account.cards.order(:id).pluck(:number), account.cards.order(:id).pluck(:number)
+  end
+
+  test "files come along and attachments point at them" do
+    account = process_import.account
+    card = account.cards.find_by!(number: @card.number)
+
+    assert card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, card.image.download
+    assert_not_equal @card.image.blob.key, card.image.blob.key
+    assert_equal ActiveStorage::Blob.service.name.to_s, card.image.blob.service_name
+    assert_equal account, card.image.blob.account
+
+    assert_equal [ "avatar.png" ], card.attachments.map { |attachment| attachment.blob.filename.to_s }
+    assert_equal file_fixture("avatar.png").binread, card.attachments.first.blob.download
+
+    comment = card.comments.joins(:rich_text_body).find { |comment| comment.attachments.any? }
+    assert_equal "hello", comment.attachments.first.blob.download
+
+    assert account.users.find_by!(name: "David").avatar.attached?
+  end
+
+  test "rich text attachments and mentions resolve to the new records" do
+    account = process_import.account
+    card = account.cards.find_by!(number: @card.number)
+
+    blob, user = card.description.body.attachables
+    assert_kind_of ActiveStorage::Blob, blob
+    assert_equal account, blob.account
+    assert_equal "avatar.png", blob.filename.to_s
+    assert_equal account.users.find_by!(name: "Jason"), user
+    assert_includes card.description.body.to_html, account.slug
+  end
+
+  test "people are linked to identities by email address and can get in" do
+    account = process_import.account
+
+    assert_equal [ "System" ], account.users.where(identity: nil).pluck(:name)
+    assert_equal identities(:jason), account.users.find_by!(name: "Jason").identity
+    assert_equal "owner", account.users.find_by!(name: "Jason").role
+    assert_equal "admin", account.users.find_by!(name: "Kevin").role
+    assert_equal account.users.find_by!(name: "David").id, account.users.find_by!(name: "David").settings.user_id
+    assert_equal @david.settings.bundle_email_frequency, account.users.find_by!(name: "David").settings.bundle_email_frequency
+    assert identities(:david).accounts.include?(account)
+  end
+
+  test "identities are created for people who aren't known here" do
+    identities(:jz).update!(email_address: "jz@elsewhere.com")
+    @export = Account::Export.create!(user: @jason).tap(&:process)
+    identities(:jz).update!(email_address: "jz@37signals.com")
+
+    assert_difference -> { Identity.count }, 1 do
+      @imported = process_import.account
+    end
+
+    jz = @imported.users.find_by!(name: "JZ")
+    assert_equal "jz@elsewhere.com", jz.identity.email_address
+    assert_not_equal identities(:jz), jz.identity
+    assert jz.active?
+  end
+
+  test "whoever imports the account gets to administer it" do
+    account = process_import.account
+    importer = account.users.find_by!(identity: @importer)
+
+    assert_equal "admin", importer.role
+    assert importer.verified?
+    assert importer.active?
+    assert_equal "importer@example.com", importer.name
+    assert_equal account.boards.all_access.count, importer.boards.count
+  end
+
+  test "the importer owns the account when nobody else does" do
+    @jason.update!(role: :admin)
+    @export = Account::Export.create!(user: @jason).tap(&:process)
+
+    account = process_import.account
+
+    assert_equal "owner", account.users.find_by!(identity: @importer).role
+  end
+
+  test "an importer who was a member becomes an admin, keeping their user" do
+    import = Account::Import.create_for(identities(:jz), file: archive_upload)
+    import.process
+
+    account = import.reload.account
+    jz = account.users.find_by!(identity: identities(:jz))
+    assert_equal "JZ", jz.name
+    assert_equal "admin", jz.role
+    assert_equal 1, account.users.where(identity: identities(:jz)).count
+  end
+
+  test "settings that live outside the records come along" do
+    account = process_import.account
+    board = account.boards.find_by!(name: "Writebook")
+
+    assert board.published?
+    assert_not_equal boards(:writebook).publication.key, board.publication.key
+    assert_equal 90.days.to_i, board.entropy.auto_postpone_period
+    assert_equal @account.entropy.auto_postpone_period, account.entropy.auto_postpone_period
+    assert_equal @account.entropies.count, account.entropies.count
+    assert_equal @account.webhooks.count, account.webhooks.count
+  end
+
+  test "saved filters point at the new boards, tags, people and columns" do
+    account = process_import.account
+    filter = account.users.find_by!(name: "David").filters.detect { |filter| filter.indexed_by.closed? }
+
+    assert_equal [ "web" ], filter.tags.pluck(:title)
+    assert_equal [ "Writebook" ], filter.boards.pluck(:name)
+    assert_equal [ "Jason" ], filter.assignees.pluck(:name)
+    assert_equal [ account.boards.find_by!(name: "Writebook").columns.find_by!(name: "Triage").id ], filter.column_ids
+    assert_equal Filter.digest_params(filter.as_params), filter.params_digest
+    assert_not_equal @filter.params_digest, filter.params_digest
+  end
+
+  test "event particulars point at the new people" do
+    account = process_import.account
+    event = Event.where(account: account, action: "card_assigned").first!
+
+    assert event.assignees.any?
+    assert event.assignees.all? { |assignee| assignee.account == account }
+  end
+
+  test "the new account is searchable and its storage accounted for" do
+    account = process_import.account
+
+    assert_equal account.cards.published.count + Comment.where(account: account).count, Search::Record.for(account.id).where(account_id: account.id).count
+    assert_equal account.boards.sum { |board| board.send(:calculate_real_storage_bytes) }, account.bytes_used_exact
+  end
+
+  test "the uploaded archive is thrown away once it's been imported" do
+    import = process_import
+
+    assert_not import.file.attached?
+  end
+
+  test "importing emails the importer when it's done" do
+    import = Account::Import.create_for(@importer, file: archive_upload)
+
+    assert_enqueued_with job: ActionMailer::MailDeliveryJob, args: [ "ImportMailer", "completed", "deliver_now", { args: [ import ] } ] do
+      import.process
+    end
+  end
+
+  test "an archive that isn't a zip fails and leaves nothing behind" do
+    assert_import_fails_cleanly with: { io: StringIO.new("not a zip"), filename: "junk.zip", content_type: "application/zip" } do |import|
+      assert_match(/damaged, incomplete or isn't a ZIP archive/, import.error_message)
+    end
+  end
+
+  test "a zip that isn't an account export fails and leaves nothing behind" do
+    zip = StringIO.new.binmode
+    ZipFile::Writer.new(zip).tap { |writer| writer.add_file("hello.txt", "hi") }.close
+
+    assert_import_fails_cleanly with: { io: zip.tap(&:rewind), filename: "other.zip", content_type: "application/zip" } do |import|
+      assert_equal "The file isn't a Fizzy account export.", import.error_message
+    end
+  end
+
+  test "an export from a newer Fizzy fails and leaves nothing behind" do
+    zip = StringIO.new.binmode
+    ZipFile::Writer.new(zip).tap do |writer|
+      writer.add_file("manifest.json", { format: Account::Export::FORMAT, version: Account::Export::VERSION + 1 }.to_json)
+      writer.add_file("accounts.jsonl", "")
+    end.close
+
+    assert_import_fails_cleanly with: { io: zip.tap(&:rewind), filename: "future.zip", content_type: "application/zip" } do |import|
+      assert_match(/newer version/, import.error_message)
+    end
+  end
+
+  test "an import that breaks halfway through fails and leaves nothing behind" do
+    Account::DataTransfer::ActiveStorage::FileRecordSet.any_instance.stubs(:import_from).raises(ActiveStorage::IntegrityError)
+
+    assert_import_fails_cleanly with: archive_upload do |import|
+      assert_match(/doesn't match its checksum/, import.error_message)
+    end
+  end
+
+  private
+    def archive_upload(export = @export)
+      { io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip" }
+    end
+
+    def process_import(identity = @importer)
+      Account::Import.create_for(identity, file: archive_upload).tap do |import|
+        import.process
+        import.reload
+      end
+    end
+
+    def assert_import_fails_cleanly(with:)
+      import = nil
+
+      assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Board.count }, -> { Card.count }, -> { Entropy.count }, -> { ActiveStorage::Blob.count } ] do
+        import = Account::Import.create_for(@importer, file: with)
+        @account_id, @blob_id = import.account.id, import.file.blob.id
+
+        assert_enqueued_with job: ActionMailer::MailDeliveryJob, args: [ "ImportMailer", "failed", "deliver_now", { args: [ import ] } ] do
+          import.process
+        end
+      end
+
+      import.reload
+      assert import.failed?
+      assert_nil import.account
+      assert_not Account.exists?(@account_id)
+      assert_not ActiveStorage::Blob.exists?(@blob_id)
+      assert_not Account::JoinCode.exists?(account_id: @account_id)
+
+      yield import
+    end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..c932169
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jason)
+  end
+
+  test "creating an export queues it up for processing" do
+    assert_enqueued_with job: Export::ProcessJob do
+      Account::Export.create!(user: @user)
+    end
+  end
+
+  test "processing generates the archive and emails a download link" do
+    export = Account::Export.create!(user: @user)
+
+    assert_enqueued_with job: ActionMailer::MailDeliveryJob, args: [ "ExportMailer", "completed", "deliver_now", { args: [ export ] } ] do
+      export.process
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+    assert_equal "37signals-account-#{Date.current.iso8601}.zip", export.file.filename.to_s
+  end
+
+  test "a failed export is marked as such and the error surfaces" do
+    export = Account::Export.create!(user: @user)
+    export.stubs(:write_to).raises(IOError, "disk on fire")
+
+    assert_raises IOError do
+      export.process
+    end
+
+    assert export.reload.failed?
+    assert_not export.file.attached?
+  end
+
+  test "is only accessible to the person who asked for it" do
+    export = Account::Export.create!(user: @user)
+
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users(:kevin))
+    assert_not export.accessible_to?(nil)
+  end
+
+  test "belongs to the user's account" do
+    export = User::Export.create!(user: users(:mike))
+
+    assert_equal accounts(:initech), export.account
+  end
+
+  test "cleanup removes exports whose download links have expired" do
+    fresh = Account::Export.create!(user: @user)
+    stale = Account::Export.create!(user: @user)
+    stale.file.attach(io: StringIO.new("zip"), filename: "old.zip", content_type: "application/zip")
+    stale.update_columns(updated_at: (Export::DOWNLOAD_LINK_EXPIRY + 1.hour).ago)
+
+    Export.cleanup
+
+    assert Export.exists?(fresh.id)
+    assert_not Export.exists?(stale.id)
+  end
+end
diff --git a/test/models/user/export_test.rb b/test/models/user/export_test.rb
