diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..65d0b4e
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+  end
+
+  test "bytes used is zero until something is attached" do
+    assert_equal 0, @account.bytes_used
+    assert_nil @account.storage_usage
+  end
+
+  test "bytes used across all boards are counted towards the account in the background" do
+    attach_image_to cards(:logo), bytes: 100
+    embed_in cards(:logo), bytes: 200
+    embed_in comments(:logo_agreement_jz), bytes: 400
+    embed_in boards(:writebook), bytes: 800
+    embed_in boards(:private).cards.create!(title: "Private", creator: users(:kevin)), bytes: 1600
+    embed_in cards(:radio), bytes: 3200 # Another account
+
+    assert_equal 0, @account.reload.bytes_used
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+
+    assert_equal 3100, @account.reload.bytes_used
+    assert_equal 3200, accounts(:initech).reload.bytes_used
+  end
+
+  test "bytes freed by boards are freed from the account" do
+    attach_image_to cards(:logo), bytes: 100
+    embed_in cards(:logo), bytes: 200
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 300, @account.reload.bytes_used
+
+    cards(:logo).update! image: nil
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 200, @account.reload.bytes_used
+
+    cards(:logo).destroy!
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving cards between boards doesn't change the account's bytes used" do
+    attach_image_to cards(:logo), bytes: 100
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+
+    cards(:logo).move_to boards(:private)
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+
+    assert_equal 100, @account.reload.bytes_used
+  end
+
+  test "destroying a board frees its bytes from the account in the background" do
+    attach_image_to cards(:logo), bytes: 100
+    embed_in boards(:writebook), bytes: 200
+    embed_in boards(:private).cards.create!(title: "Private", creator: users(:kevin)), bytes: 400
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 700, @account.reload.bytes_used
+
+    assert_enqueued_with job: StorageUsage::AdjustJob, args: [ @account, { by: -300 } ] do
+      boards(:writebook).destroy!
+    end
+
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 400, @account.reload.bytes_used
+  end
+
+  test "destroying a board without bytes used doesn't touch the account" do
+    assert_no_enqueued_jobs only: StorageUsage::AdjustJob do
+      boards(:writebook).destroy!
+    end
+  end
+
+  test "recalculating sums the boards' bytes used" do
+    attach_image_to cards(:logo), bytes: 100
+    embed_in boards(:private).cards.create!(title: "Private", creator: users(:kevin)), bytes: 200
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+
+    StorageUsage.for(@account).update! bytes_used: 42
+    assert_equal 42, @account.reload.bytes_used
+
+    @account.recalculate_storage_usage_later
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+    assert_equal 300, @account.reload.bytes_used
+  end
+
+  test "destroying the account destroys its storage usage and discards pending adjustments" do
+    attach_image_to cards(:logo), bytes: 100
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert StorageUsage.exists?(account: @account)
+
+    @account.destroy!
+    perform_enqueued_jobs only: [ StorageUsage::AdjustJob, StorageUsage::RecalculateJob ]
+
+    assert_not StorageUsage.exists?(account_id: @account.id)
+  end
+
+  private
+    def attach_image_to(card, bytes:)
+      card.image.attach io: StringIO.new("x" * bytes), filename: "image.png", content_type: "image/png"
+      card
+    end
+
+    def embed_in(record, bytes:)
