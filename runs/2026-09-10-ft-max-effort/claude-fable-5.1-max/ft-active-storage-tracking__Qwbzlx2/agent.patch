@@ -0,0 +1,13 @@
+# Bytes used by the files counted towards an account's or a board's storage: card images, and files
+# embedded in board descriptions, card descriptions and comments. Kept up to date in the background
+# by Account::Storage and Board::Storage.
+class StorageUsage < ApplicationRecord
+  belongs_to :account, default: -> { container.account }
+  belongs_to :container, polymorphic: true
+
+  class << self
+    def for(container)
+      find_by(container: container) || create_or_find_by!(container: container)
+    end
+  end
+end
