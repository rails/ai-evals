diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..7da45e7 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,49 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorage
+  module Extensions
+    module Attachment
+      extend ActiveSupport::Concern
+
+      included do
+        # Attachments embedded in the rich texts of the given records
+        scope :embedded_in, ->(records) { where(record: ActionText::RichText.where(record: records)) }
+
+        # Attachments that belong to a board (card images and rich text embeds, see Board::Storage)
+        # count towards its storage usage. They must be destroyed, not deleted or purged directly,
+        # for the change to be tracked.
+        after_create_commit  :count_towards_storage_usage, if: :counts_towards_storage_usage?
+        after_destroy_commit :discount_from_storage_usage, if: :counts_towards_storage_usage?
+      end
+
+      class_methods do
+        def bytes_used
+          joins(:blob).sum("active_storage_blobs.byte_size")
+        end
+      end
+
+      private
+        def board
+          record.try(:board)
+        end
+
+        def counts_towards_storage_usage?
+          board&.persisted?
+        end
+
+        def count_towards_storage_usage
+          board.adjust_storage_usage_later(by: byte_size)
+        end
+
+        def discount_from_storage_usage
+          board.adjust_storage_usage_later(by: -byte_size)
+        end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorage::Extensions::Attachment
+end
