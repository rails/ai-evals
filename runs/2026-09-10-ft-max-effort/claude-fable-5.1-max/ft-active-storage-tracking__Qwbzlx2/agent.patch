+  end
+
+  test "bytes used by a card's image, description and comments" do
+    assert_equal 0, cards(:logo).bytes_used
+
+    cards(:logo).image.attach io: StringIO.new("x" * 100), filename: "image.png", content_type: "image/png"
+    cards(:logo).update! description: embed(bytes: 200)
+    comments(:logo_agreement_jz).update! body: embed(bytes: 400)
+    cards(:layout).update! description: embed(bytes: 800)
