diff --git a/app/models/card/storage.rb b/app/models/card/storage.rb
new file mode 100644
index 0000000..4070707
--- /dev/null
+++ b/app/models/card/storage.rb
@@ -0,0 +1,24 @@
+module Card::Storage
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Bytes used by these cards' images and by the files embedded in their descriptions and comments.
+    # Unlike boards and accounts, cards are small enough to be counted on the spot.
+    def bytes_used
+      ActiveStorage::Attachment.where(record: all).bytes_used +
+        ActiveStorage::Attachment.embedded_in(all).bytes_used +
+        ActiveStorage::Attachment.embedded_in(Comment.where(card: all)).bytes_used
+    end
+  end
+
+  def bytes_used
+    self.class.where(id: id).bytes_used
+  end
+
+  def move_storage_usage_later(from:, to:)
+    bytes = bytes_used
+
+    from.adjust_storage_usage_later(by: -bytes)
+    to.adjust_storage_usage_later(by: bytes)
+  end
+end
