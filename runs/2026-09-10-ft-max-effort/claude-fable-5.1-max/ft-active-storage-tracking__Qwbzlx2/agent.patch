diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..0e94192
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+  end
+
+  test "bytes used is zero until something is attached" do
+    assert_equal 0, @board.bytes_used
+    assert_nil @board.storage_usage
+  end
+
+  test "card images count towards the board in the background" do
+    assert_enqueued_with job: StorageUsage::AdjustJob do
+      attach_image_to cards(:logo), bytes: 100
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 100, @board.reload.bytes_used
+  end
+
+  test "files embedded in card descriptions, comments and the board description count towards the board" do
+    embed_in cards(:logo), bytes: 100
+    embed_in comments(:logo_agreement_jz), bytes: 200
+    embed_in @board, bytes: 300
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+
+    assert_equal 600, @board.reload.bytes_used
+  end
+
+  test "removing embeds, images, comments and cards frees their bytes" do
+    attach_image_to cards(:logo), bytes: 100
+    embed_in cards(:logo), bytes: 200
+    embed_in cards(:layout), bytes: 400
+    comment = embed_in cards(:layout).comments.create!(body: "Take a look"), bytes: 800
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 1500, @board.reload.bytes_used
+
+    cards(:logo).update! description: "No more embeds"
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 1300, @board.reload.bytes_used
+
+    cards(:logo).update! image: nil
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 1200, @board.reload.bytes_used
+
+    comment.destroy!
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 400, @board.reload.bytes_used
+
+    cards(:layout).destroy!
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "replacing a card image swaps its bytes" do
+    attach_image_to cards(:logo), bytes: 100
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 100, @board.reload.bytes_used
+
+    attach_image_to cards(:logo), bytes: 250
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 250, @board.reload.bytes_used
+  end
+
+  test "attachments that don't belong to a board don't count" do
+    users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    Account::Export.create!(account: @board.account, user: users(:david)).file.attach io: StringIO.new("x" * 100), filename: "export.zip"
+
+    assert_no_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 0, StorageUsage.count
+  end
+
+  test "moving a card moves its bytes to the new board" do
+    attach_image_to cards(:logo), bytes: 100
+    embed_in cards(:logo), bytes: 200
+    embed_in comments(:logo_agreement_jz), bytes: 400
+    embed_in cards(:layout), bytes: 800
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert_equal 1500, @board.reload.bytes_used
+
+    cards(:logo).move_to boards(:private)
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+
+    assert_equal 800, @board.reload.bytes_used
+    assert_equal 700, boards(:private).reload.bytes_used
+  end
+
+  test "recalculating counts everything from scratch" do
+    attach_image_to cards(:logo), bytes: 100
+    embed_in cards(:logo), bytes: 200
+    embed_in comments(:logo_agreement_jz), bytes: 400
+    embed_in @board, bytes: 800
+    embed_in cards(:radio), bytes: 1600 # Another board
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+
+    StorageUsage.for(@board).update! bytes_used: 42
+    assert_equal 42, @board.reload.bytes_used
+
+    @board.recalculate_storage_usage
+    assert_equal 1500, @board.reload.bytes_used
+  end
+
+  test "recalculating in the background" do
+    attach_image_to cards(:logo), bytes: 100
+
+    assert_enqueued_with job: StorageUsage::RecalculateJob, args: [ @board ] do
+      @board.recalculate_storage_usage_later
+    end
+
+    perform_enqueued_jobs only: StorageUsage::RecalculateJob
+    assert_equal 100, @board.reload.bytes_used
+  end
+
+  test "destroying the board destroys its storage usage" do
+    attach_image_to cards(:logo), bytes: 100
+    perform_enqueued_jobs only: StorageUsage::AdjustJob
+    assert StorageUsage.exists?(container: @board)
+
+    @board.destroy!
+    assert_not StorageUsage.exists?(container: @board)
+  end
+
+  private
+    def attach_image_to(card, bytes:)
+      card.image.attach io: StringIO.new("x" * bytes), filename: "image.png", content_type: "image/png"
+      card
+    end
+
+    def embed_in(record, bytes:)
+      blob = ActiveStorage::Blob.create_and_upload! io: StringIO.new("x" * bytes), filename: "file.txt", content_type: "text/plain"
+      html = "<p>See attached</p>#{ActionText::Attachment.from_attachable(blob).to_html}"
+
+      case record
+      when Board then record.update! public_description: html
+      when Card then record.update! description: html
+      when Comment then record.update! body: html
+      end
+
+      record
+    end
+end
