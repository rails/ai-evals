index 0000000..ac52b52
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  test "for finds or creates the usage of a container" do
+    assert_difference -> { StorageUsage.count }, +1 do
+      usage = StorageUsage.for(boards(:writebook))
+
+      assert_equal boards(:writebook), usage.container
+      assert_equal accounts(:"37s"), usage.account
+      assert_equal 0, usage.bytes_used
+    end
+
+    assert_no_difference -> { StorageUsage.count } do
+      assert_equal boards(:writebook).storage_usage, StorageUsage.for(boards(:writebook))
+    end
+  end
+
+  test "accounts and boards have their own usage" do
+    assert_not_equal StorageUsage.for(accounts(:"37s")), StorageUsage.for(boards(:writebook))
+    assert_equal accounts(:"37s"), StorageUsage.for(accounts(:"37s")).account
+  end
+end
