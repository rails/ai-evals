+    assert_equal 700, cards(:logo).bytes_used
+    assert_equal 800, cards(:layout).bytes_used
+    assert_equal 1500, boards(:writebook).cards.bytes_used
+    assert_equal 0, boards(:private).cards.bytes_used
+  end
