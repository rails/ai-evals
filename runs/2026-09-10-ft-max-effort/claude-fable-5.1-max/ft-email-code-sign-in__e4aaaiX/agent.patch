+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small margin-block-start">
+    Didn’t get it? The code expires in <%= distance_of_time_in_words(MagicLink::EXPIRY) %>. Check your spam folder, or <%= link_to "start over", new_session_path, class: "txt-link" %> to get a new one.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
