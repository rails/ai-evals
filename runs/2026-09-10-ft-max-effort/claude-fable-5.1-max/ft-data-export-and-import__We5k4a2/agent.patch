index 6017f88..6ee6139 100644
--- a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
+++ b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
@@ -1,4 +1,95 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @card = cards(:logo)
+    @card.update! description: <<~HTML
+      <div>
+        Hey <action-text-attachment sgid="#{users(:jz).attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>,
+        look at <action-text-attachment sgid="#{@blob.attachable_sgid}" content-type="image/jpeg" filename="moon.jpg" url="/rails/active_storage/blobs/redirect/old/moon.jpg"></action-text-attachment>
+        and <action-text-attachment url="https://example.com/remote.png" content-type="image/*"></action-text-attachment>
+      </div>
+    HTML
+    @rich_text = @card.rich_text_description
+    @record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(@account)
+  end
+
+  test "exports every rich text in the account" do
+    zip = write_zip
+
+    assert_equal ActionText::RichText.where(account: @account).count, zip.glob("action_text_rich_texts/*.json").size
+    assert zip.exists?("action_text_rich_texts/#{@rich_text.id}.json")
+  end
+
+  test "exported attachments carry plain global ids instead of signed ones" do
+    exported = exported_rich_text
+
+    assert_equal @rich_text.id, exported["id"]
+    assert_equal "Card", exported["record_type"]
+    assert_equal @card.id, exported["record_id"]
+
+    body = Nokogiri::HTML5.fragment(exported["body"])
+    attachments = body.css("action-text-attachment")
+
+    assert_equal 3, attachments.size
+    assert_equal "gid://fizzy/User/#{users(:jz).id}", attachments[0]["gid"]
+    assert_equal "gid://fizzy/ActiveStorage::Blob/#{@blob.id}", attachments[1]["gid"]
+    assert_nil attachments[1]["url"], "instance-specific URLs don't travel"
+    assert_equal "moon.jpg", attachments[1]["filename"]
+    assert attachments.none? { |attachment| attachment["sgid"] }
+
+    assert_nil attachments[2]["gid"]
+    assert_equal "https://example.com/remote.png", attachments[2]["url"]
+  end
+
+  test "imported attachments are signed again for the records they became" do
+    zip = write_zip
+    imported_account = Account.create!(name: "Imported")
+    mapping = Account::DataTransfer::Mapping.new
+    mapping.map @account.id, to: imported_account.id
+    mapping.map @card.id, to: imported_card(imported_account).id
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(imported_account).import_from(zip, mapping)
+
+    rich_text = ActionText::RichText.find(mapping.id_for(@rich_text.id))
+    assert_equal imported_account, rich_text.account
+    assert_equal mapping.id_for(@card.id), rich_text.record_id
+
+    attachments = rich_text.body.fragment.find_all("action-text-attachment")
+    assert attachments.none? { |attachment| attachment["gid"] }
+
+    user_sgid, blob_sgid = attachments[0]["sgid"], attachments[1]["sgid"]
+    assert_equal mapping.id_for(users(:jz).id), SignedGlobalID.parse(user_sgid, for: "attachable").model_id
+    assert_equal mapping.id_for(@blob.id), SignedGlobalID.parse(blob_sgid, for: "attachable").model_id
+    assert_match %r{\A#{imported_account.slug}/rails/active_storage/blobs/redirect/.+/moon\.jpg\z}, attachments[1]["url"]
+
+    assert_equal "https://example.com/remote.png", attachments[2]["url"]
+  end
+
+  private
+    def write_zip
+      tempfile = Tempfile.new([ "rich_texts", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      @record_set.export_to(writer)
+      writer.close
+      tempfile.flush
+
+      ZipFile::Reader.new(File.open(tempfile.path, "rb"))
+    end
+
+    def exported_rich_text
+      JSON.parse write_zip.read("action_text_rich_texts/#{@rich_text.id}.json")
+    end
+
+    def imported_card(account)
+      Current.with_account(account) do
+        board = account.boards.create!(name: "Imported", creator: account.users.create!(name: "Someone", role: :owner))
+        board.cards.create!(title: "Imported", creator: board.creator)
+      end
+    end
 end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..2c030f0
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,182 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    Current.session = sessions(:kevin)
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "creating an export processes it later" do
+    assert_enqueued_with job: Export::ProcessJob do
+      @account.exports.create!(user: @user, full: true)
+    end
+  end
+
+  test "a full export packs the whole account for import" do
+    cards(:logo).update! description: "<div>Hello <action-text-attachment sgid=\"#{users(:david).attachable_sgid}\" content-type=\"application/vnd.actiontext.mention\"></action-text-attachment></div>"
+    cards(:logo).image.attach io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg"
+    export = @account.exports.create!(user: @user, full: true)
+
+    assert_emails 1 do
+      perform_enqueued_jobs only: Export::ProcessJob
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    end
+
+    export.reload
+    assert export.completed?
+    assert export.downloadable?
+    assert_in_delta Export::DOWNLOAD_PERIOD.from_now, export.expires_at, 1.minute
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("manifest.json")
+      assert_equal Account::DataTransfer::Manifest::FORMAT, JSON.parse(zip.read("manifest.json"))["format"]
+      assert_equal [ "accounts/#{@account.id}.json" ], zip.glob("accounts/*.json")
+      assert_equal @account.cards.count, zip.glob("cards/*.json").size
+      assert_equal @account.users.count, zip.glob("users/*.json").size
+      assert_equal @account.boards.count, zip.glob("boards/*.json").size
+      assert zip.exists?("comments/#{comments(:logo_agreement_jz).id}.json")
+      assert zip.exists?("files/#{cards(:logo).image.blob.id}/moon.jpg")
+
+      card = JSON.parse(zip.read("cards/#{cards(:logo).id}.json"))
+      assert_equal cards(:logo).title, card["title"]
+      assert_equal boards(:writebook).id, card["board_id"]
+
+      user = JSON.parse(zip.read("users/#{users(:david).id}.json"))
+      assert_equal "david@37signals.com", user["email_address"]
+      assert_nil user["identity_id"]
+
+      rich_text = JSON.parse(zip.read("action_text_rich_texts/#{cards(:logo).rich_text_description.id}.json"))
+      assert_includes rich_text["body"], "gid=\"gid://fizzy/User/#{users(:david).id}\""
+      assert_not_includes rich_text["body"], "sgid="
+
+      assert_not zip.glob("*").include?("cards/1.json")
+    end
+
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert_match "Your Fizzy export is ready", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "a personal export packs the cards the user can see, with their comments and files" do
+    cards(:logo).image.attach io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg"
+    export = users(:jz).exports.create!
+
+    perform_enqueued_jobs only: Export::ProcessJob
+    export.reload
+
+    assert export.completed?
+    assert_not export.full?
+
+    ZipFile.open(export.file) do |zip|
+      assert_not zip.exists?("manifest.json")
+      assert_equal users(:jz).accessible_cards.published.count, zip.glob("cards/*.json").size
+      assert zip.exists?("cards/#{cards(:logo).number}.json")
+      assert_not zip.exists?("cards/#{cards(:logo).id}.json")
+
+      card = JSON.parse(zip.read("cards/#{cards(:logo).number}.json"))
+      assert_equal cards(:logo).title, card["title"]
+      assert_equal "Writebook", card.dig("board", "name")
+      assert_equal cards(:logo).comments.count, card["comments"].size
+      assert_includes card["comments"].collect { |comment| comment.dig("body", "plain_text") }, "I agree."
+      assert_equal "cards/#{cards(:logo).number}/moon.jpg", card.dig("image", "path")
+      assert zip.exists?("cards/#{cards(:logo).number}/moon.jpg")
+      assert_equal File.binread(file_fixture("moon.jpg")), zip.read("cards/#{cards(:logo).number}/moon.jpg")
+    end
+  end
+
+  test "a personal export makes rich text portable and keeps file names apart" do
+    embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    cards(:logo).image.attach io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg"
+    cards(:logo).update! description: <<~HTML
+      <div>
+        Hey <action-text-attachment sgid="#{users(:jz).attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>,
+        see <action-text-attachment sgid="#{embed.attachable_sgid}" content-type="image/jpeg" filename="moon.jpg" url="/rails/active_storage/blobs/redirect/x/moon.jpg"></action-text-attachment>
+      </div>
+    HTML
+    export = users(:jz).exports.create!
+
+    perform_enqueued_jobs only: Export::ProcessJob
+
+    ZipFile.open(export.reload.file) do |zip|
+      card = JSON.parse(zip.read("cards/#{cards(:logo).number}.json"))
+      description = card["description"]
+
+      assert_equal "Hey @jz, see [moon.jpg]", description["plain_text"].squish
+      assert_includes description["html"], "Hey @jz"
+      assert_includes description["html"], "url=\"cards/#{cards(:logo).number}/moon-2.jpg\""
+      assert_not_includes description["html"], "sgid="
+
+      assert_equal [ "cards/#{cards(:logo).number}/moon-2.jpg" ], description["attachments"].collect { |attachment| attachment["path"] }
+      assert_equal "cards/#{cards(:logo).number}/moon.jpg", card.dig("image", "path")
+      assert zip.exists?("cards/#{cards(:logo).number}/moon.jpg")
+      assert zip.exists?("cards/#{cards(:logo).number}/moon-2.jpg")
+    end
+  end
+
+  test "a personal export leaves out the cards the user can't see" do
+    private_card = boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: "published")
+    export = users(:jz).exports.create!
+
+    perform_enqueued_jobs only: Export::ProcessJob
+
+    ZipFile.open(export.reload.file) do |zip|
+      assert_not zip.exists?("cards/#{private_card.number}.json")
+    end
+  end
+
+  test "a full export leaves out the files of other exports and imports" do
+    previous_export = @account.exports.create!(user: @user, full: true)
+    perform_enqueued_jobs only: Export::ProcessJob
+    import = Import.create!(user: @user, file: { io: file_fixture("export.zip").open, filename: "export.zip", content_type: "application/zip" })
+
+    export = @account.exports.create!(user: @user, full: true)
+    perform_enqueued_jobs only: Export::ProcessJob
+
+    ZipFile.open(export.reload.file) do |zip|
+      assert_not zip.exists?("active_storage_blobs/#{previous_export.reload.file.blob.id}.json")
+      assert_not zip.exists?("active_storage_blobs/#{import.file.blob.id}.json")
+      assert_empty zip.glob("files/*/*")
+      assert_empty zip.glob("active_storage_attachments/*.json").select { |path| zip.read(path).match?(/"record_type": "(Export|Import)"/) }
+    end
+  end
+
+  test "a failed export tells the user" do
+    export = @account.exports.create!(user: @user, full: true)
+    Account.any_instance.stubs(:export_to).raises("boom")
+
+    assert_raises RuntimeError do
+      export.process
+    end
+
+    assert export.reload.failed?
+    assert_enqueued_email_with ExportMailer, :failed, args: [ export ]
+  end
+
+  test "downloads expire after a day" do
+    export = @account.exports.create!(user: @user, full: true)
+    perform_enqueued_jobs only: Export::ProcessJob
+    export.reload
+
+    assert export.downloadable?
+
+    travel Export::DOWNLOAD_PERIOD + 1.minute do
+      assert export.expired?
+      assert_not export.downloadable?
+
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+
+  test "only the requester can access the file" do
+    export = @account.exports.create!(user: @user, full: true)
+
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users(:david))
+  end
+end
