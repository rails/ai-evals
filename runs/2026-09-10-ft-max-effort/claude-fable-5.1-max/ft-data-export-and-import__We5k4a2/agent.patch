+require "test_helper"
+
+class ExportMailerTest < ActionMailer::TestCase
+  include Rails.application.routes.url_helpers
+
+  def default_url_options
+    Rails.application.config.action_mailer.default_url_options
+  end
+
+  setup do
+    @export = accounts(:"37s").exports.create!(user: users(:kevin), full: true)
+    @export.update! status: :completed, expires_at: Export::DOWNLOAD_PERIOD.from_now
+  end
+
+  test "completed sends the download link to the requester" do
+    email = ExportMailer.completed(@export)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ users(:kevin).identity.email_address ], email.to
+    assert_equal "Your Fizzy export is ready", email.subject
+    assert_match export_url(@export, script_name: accounts(:"37s").slug), email.html_part.body.encoded
+    assert_match export_url(@export, script_name: accounts(:"37s").slug), email.text_part.body.encoded
