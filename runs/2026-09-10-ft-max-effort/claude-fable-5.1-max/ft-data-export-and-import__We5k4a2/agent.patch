+    @account = accounts(:"37s")
+    @importer = users(:mike)
+  end
+
+  test "creating an import processes it later" do
+    assert_enqueued_with job: Import::ProcessJob do
+      create_import exported_account_file
+    end
+  end
+
+  test "importing an account export creates a new account with everything in it" do
+    cards(:logo).update! description: "<div>Hello <action-text-attachment sgid=\"#{users(:david).attachable_sgid}\" content-type=\"application/vnd.actiontext.mention\"></action-text-attachment></div>"
+    cards(:logo).image.attach io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg"
+    users(:david).avatar.attach io: File.open(file_fixture("avatar.png")), filename: "avatar.png", content_type: "image/png"
+    embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "embed.png", content_type: "image/png")
+    cards(:logo).comments.create! creator: users(:kevin), body: "<div>See <action-text-attachment sgid=\"#{embed.attachable_sgid}\" content-type=\"image/png\" filename=\"embed.png\"></action-text-attachment></div>"
+    boards(:writebook).update! auto_postpone_period: 7.days
+    boards(:writebook).publish
+    cards(:layout).update! title: "Das Layout ist kaputt — größer, bitte 🚀"
+    file = exported_account_file
+
+    import = nil
+    assert_difference -> { Account.count }, +1 do
+      import = create_import(file)
+      perform_enqueued_jobs only: Import::ProcessJob
+    end
+
+    import.reload
+    assert import.completed?, import.error_message
+    imported = import.imported_account
+
+    assert_not_equal @account, imported
+    assert_equal @account.name, imported.name
+    assert_equal @account.cards_count, imported.cards_count
+    assert_not_equal @account.external_account_id, imported.external_account_id
+    assert imported.join_code.present?
+    assert_equal @account.entropy.auto_postpone_period, imported.entropy.auto_postpone_period
+
+    # People, plus the importer
+    assert_equal @account.users.count + 1, imported.users.count
+    assert_equal (@account.users.pluck(:name) << @importer.name).sort, imported.users.pluck(:name).sort
+    david = imported.users.find_by!(name: "David")
+    assert_equal identities(:david), david.identity
+    assert_equal "member", david.role
+    assert david.avatar.attached?
+    assert_equal File.binread(file_fixture("avatar.png")), david.avatar.download
+    assert imported.system_user.present?
+
+    # The importer owns the new account
+    mike = imported.users.find_by!(identity: @importer.identity)
+    assert mike.owner?
+
+    # Boards, columns and cards
+    assert_equal @account.boards.pluck(:name).sort, imported.boards.pluck(:name).sort
+    writebook = imported.boards.find_by!(name: "Writebook")
+    assert_equal boards(:writebook).columns.pluck(:name).sort, writebook.columns.pluck(:name).sort
+    assert_equal 7.days, writebook.auto_postpone_period
+    assert writebook.published?
+    assert_equal @account.cards.count, imported.cards.count
+
+    assert_equal "Das Layout ist kaputt — größer, bitte 🚀", imported.cards.find_by!(number: cards(:layout).number).title
+
+    logo = imported.cards.find_by!(number: cards(:logo).number)
+    assert_not_equal cards(:logo).id, logo.id
+    assert_equal cards(:logo).title, logo.title
+    assert_equal writebook, logo.board
+    assert_equal david, logo.creator
+    assert_equal cards(:logo).column.name, logo.column.name
+    assert_equal cards(:logo).created_at.to_i, logo.created_at.to_i
+
+    # Comments
+    assert_equal cards(:logo).comments.count, logo.comments.count
+    agreement = logo.comments.joins(:creator).find_by!(users: { name: "JZ" })
+    assert_equal "I agree.", agreement.body.to_plain_text
+
+    # Files
+    assert logo.image.attached?
+    assert_equal File.binread(file_fixture("moon.jpg")), logo.image.download
+    assert_not_equal cards(:logo).image.blob.key, logo.image.blob.key
+
+    # Rich text attachments point to the new records
+    assert_equal [ david ], logo.description.body.attachables
+    assert_includes logo.description.body.to_html, "sgid="
+    assert_not_includes logo.description.body.to_html, "gid=\"gid://"
+
+    with_embed = logo.comments.find { |comment| comment.body.embeds.any? }
+    imported_embed = with_embed.body.body.attachables.sole
+    assert_kind_of ActiveStorage::Blob, imported_embed
+    assert_not_equal embed, imported_embed
+    assert_equal imported, imported_embed.account
+    assert_equal [ imported_embed ], with_embed.body.embeds.collect(&:blob)
+    assert_equal File.binread(file_fixture("avatar.png")), imported_embed.download
+    assert_includes with_embed.body.body.to_html, "#{imported.slug}/rails/active_storage/blobs/redirect/"
+
+    # Everything else came along
+    assert_equal cards(:logo).tags.pluck(:title).sort, logo.tags.pluck(:title).sort
+    assert_equal "never", david.settings.bundle_email_frequency
+    assert_equal users(:david).filters.count, david.filters.count
+    assert_equal Access.where(account: @account).count + imported.boards.all_access.count, Access.where(account: imported).count
+    assert_equal Event.where(account: @account).count, Event.where(account: imported).count
+    assert_equal ActiveStorage::Blob.where(account: @account).count - 1, ActiveStorage::Blob.where(account: imported).count
+
+    webhook = writebook.webhooks.find_by!(name: webhooks(:active).name)
+    assert_equal webhooks(:active).subscribed_actions, webhook.subscribed_actions
+    assert_equal webhooks(:active).signing_secret, webhook.signing_secret
+    assert webhook.delinquency_tracker.present?
+
+    # Derived data is rebuilt
+    assert_equal imported.cards.published.count, Search::Record.for(imported.id).where(account_id: imported.id, searchable_type: "Card").count
+    assert_equal logo.image.blob.byte_size + imported_embed.byte_size, imported.bytes_used_exact
+    assert_equal logo.image.blob.byte_size + imported_embed.byte_size, writebook.bytes_used_exact
+
+    assert_enqueued_email_with ImportMailer, :completed, args: [ import ]
+    assert_not import.file.attached?
+  end
+
+  test "a failed import leaves nothing behind" do
+    cards(:logo).image.attach io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg"
+    file = exported_account_file
+    Account::DataTransfer::RecordSet.any_instance.stubs(:insert).raises(ActiveRecord::StatementInvalid, "boom")
+
+    import = create_import(file)
+
+    uploaded_keys = []
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Card.count }, -> { Identity.count } ] do
+      tracking_uploaded_keys(uploaded_keys) do
+        assert_raises ActiveRecord::StatementInvalid do
+          import.process
+        end
+      end
+    end
+
+    assert import.reload.failed?
+    assert_equal "boom", import.error_message
+    assert_nil import.imported_account
+    assert_enqueued_email_with ImportMailer, :failed, args: [ import ]
+
+    assert_not_empty uploaded_keys
+    assert uploaded_keys.none? { |key| ActiveStorage::Blob.service.exist?(key) }, "uploaded files should have been deleted"
+  end
+
+  test "a file that isn't an account export fails with a reason" do
+    export = users(:jz).exports.create!
+    perform_enqueued_jobs only: Export::ProcessJob
+
+    import = create_import(export.reload.file.blob)
+
+    assert_raises Account::DataTransfer::Error do
+      import.process
+    end
+
+    assert import.reload.failed?
+    assert_equal "The file is not a Fizzy account export", import.error_message
+  end
+
+  test "an import must be a zip file" do
+    import = Import.new(user: @importer, account: accounts(:initech), file: { io: StringIO.new("nope"), filename: "export.txt", content_type: "text/plain" })
+
+    assert_not import.valid?
+    assert_includes import.errors.full_messages.to_sentence, "zip"
+  end
+
+  test "importing an account twice on the same instance works" do
+    boards(:writebook).publish
+    file = exported_account_file
+
+    assert_difference -> { Account.count }, +2 do
+      create_import(file).process
+      create_import(file).process
+    end
+  end
+
+  private
+    def tracking_uploaded_keys(keys)
+      subscriber = ActiveSupport::Notifications.subscribe("service_upload.active_storage") { |event| keys << event.payload[:key] }
+      yield
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    def exported_account_file
+      export = @account.exports.create!(user: users(:kevin), full: true)
+      perform_enqueued_jobs only: Export::ProcessJob
+      export.reload.file.blob
+    end
+
+    # Uploads the export like a user would, from the importer's own account
+    def create_import(blob)
+      Current.with_account(accounts(:initech)) do
+        Import.create! user: @importer, account: accounts(:initech),
+          file: { io: StringIO.new(blob.download), filename: blob.filename.to_s, content_type: blob.content_type }
+      end
+    end
+end
