diff --git a/app/models/account/data_transfer.rb b/app/models/account/data_transfer.rb
new file mode 100644
index 0000000..d4202b5
--- /dev/null
+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,18 @@
+# Moves whole accounts between Fizzy instances: an account is exported to a ZIP file
+# holding one JSON document per record plus every attached file, and imported back
+# into a brand new account by replaying that ZIP.
+module Account::DataTransfer
+  extend ActiveSupport::Concern
+
+  class Error < StandardError; end
+
+  class_methods do
+    def import_from(zip, &block)
+      Manifest.new(new).import_from(zip, &block)
+    end
+  end
+
+  def export_to(zip)
+    Manifest.new(self).export_to(zip)
+  end
+end
diff --git a/app/models/account/data_transfer/account_record_set.rb b/app/models/account/data_transfer/account_record_set.rb
index 7e4fee3..b38c7e1 100644
--- a/app/models/account/data_transfer/account_record_set.rb
+++ b/app/models/account/data_transfer/account_record_set.rb
@@ -1,11 +1,29 @@
+# The account itself. On import it is created through Active Record so that it gets
+# its own external id, join code and default entropy, like any other new account.
 class Account::DataTransfer::AccountRecordSet < Account::DataTransfer::RecordSet
+  IMPORTED_ATTRIBUTES = %w[ name cards_count created_at updated_at ]
+
   def initialize(account)
     super(account: account, model: Account)
   end
 
+  def import_from(zip, mapping)
+    exported = JSON.parse(zip.read(exported_account_path_in(zip)))
+
+    account.assign_attributes exported.slice(*IMPORTED_ATTRIBUTES)
+    account.save!
+
+    mapping.map exported["id"], to: account.id
+  end
+
   private
     def records
       [ account ]
     end
 
+    def exported_account_path_in(zip)
+      zip.glob("#{model_dir}/*.json").sole
+    rescue Enumerable::SoleItemExpectedError
+      raise Account::DataTransfer::Error, "The export must contain exactly one account"
+    end
 end
