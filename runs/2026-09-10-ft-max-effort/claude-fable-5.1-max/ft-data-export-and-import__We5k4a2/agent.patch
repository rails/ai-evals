diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..952269f
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,74 @@
+# Reads a blob as if it were a local file, fetching it from the storage service in chunks
+# with ranged downloads. This lets the reader open ZIP files far larger than memory or
+# disk, wherever they are stored, without downloading them whole.
+class ZipFile::BlobIO
+  CHUNK_SIZE = 8.megabytes
+
+  attr_reader :blob
+
+  def initialize(blob)
+    @blob = blob
+    @pos = 0
+    @buffer = "".b
+    @buffer_start = 0
+  end
+
+  def size
+    blob.byte_size
+  end
+
+  def tell
+    @pos
+  end
+  alias_method :pos, :tell
+
+  def seek(offset, whence = IO::SEEK_SET)
+    @pos = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then @pos + offset
+    when IO::SEEK_END then size + offset
+    else raise ArgumentError, "Unsupported seek mode #{whence}"
+    end.clamp(0, size)
+
+    0
+  end
+
+  def eof?
+    @pos >= size
+  end
+
+  # Behaves like IO#read: returns nil at the end when a length is given, an empty string otherwise.
+  def read(length = nil)
+    available = size - @pos
+
+    if length.nil?
+      read_bytes(available)
+    elsif length.negative?
+      raise ArgumentError, "negative length #{length} given"
+    elsif length.zero?
+      "".b
+    elsif available.zero?
+      nil
+    else
+      read_bytes([ length, available ].min)
+    end
+  end
+
+  private
+    def read_bytes(length)
+      fill_buffer(@pos, length) unless buffered?(@pos, length)
+
+      @buffer.byteslice(@pos - @buffer_start, length).tap do |data|
+        @pos += data.bytesize
+      end
+    end
+
+    def buffered?(offset, length)
+      offset >= @buffer_start && offset + length <= @buffer_start + @buffer.bytesize
+    end
+
+    def fill_buffer(offset, length)
+      @buffer_start = offset
+      @buffer = blob.download_chunk(offset...[ offset + [ length, CHUNK_SIZE ].max, size ].min)
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..66a1b8e
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,50 @@
+# Reads entries out of a ZIP file through any seekable IO, including a ZipFile::BlobIO.
+# The central directory is parsed upfront; entries are only read when asked for.
+class ZipFile::Reader
+  class IntegrityError < StandardError; end
+
+  CHUNK_SIZE = ZipFile::BlobIO::CHUNK_SIZE
+
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries = @file_reader.read_zip_structure(io: io, read_local_headers: false).index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def read(path)
+    "".b.tap do |data|
+      stream(path) { |chunk| data << chunk }
+    end
+  end
+
+  # Yields the contents of an entry in chunks, verifying them against the entry's checksum.
+  def stream(path)
+    entry = entry_for(path)
+    extractor = entry.extractor_from(@io)
+    crc32 = 0
+
+    while chunk = extractor.extract(CHUNK_SIZE)
+      crc32 = Zlib.crc32(chunk, crc32)
+      yield chunk
+    end
+
+    raise IntegrityError, "#{path} is corrupt" unless crc32 == entry.crc32
+  end
+
+  private
+    def entry_for(path)
+      @entries.fetch(path) { raise Errno::ENOENT, path }.tap do |entry|
+        unless entry.known_offset?
+          entry.compressed_data_offset = @file_reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+        end
+      end
+    end
+end
