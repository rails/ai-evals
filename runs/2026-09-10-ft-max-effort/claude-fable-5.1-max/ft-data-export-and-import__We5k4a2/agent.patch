+require "test_helper"
+
+class ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "anyone can export the cards they can see" do
+    assert_difference -> { Export.personal.count }, +1 do
+      assert_enqueued_with job: Export::ProcessJob do
+        post exports_path
+      end
+    end
+
+    export = Export.last
+    assert_not export.full?
+    assert_equal users(:david), export.user
+
+    assert_redirected_to user_path(users(:david))
+    assert_match "preparing your export", flash[:notice]
+  end
+
+  test "an export already in progress isn't requested again" do
+    post exports_path
+
+    assert_no_difference -> { Export.count } do
+      post exports_path
+    end
+  end
+
+  test "the profile page offers the export" do
+    get user_path(users(:david))
+
+    assert_response :success
+    assert_select "form[action=?]", exports_path
+  end
+
+  test "the profile page of someone else doesn't offer the export" do
+    get user_path(users(:jz))
+
+    assert_response :success
+    assert_select "form[action=?]", exports_path, count: 0
+  end
+
+  test "downloading a completed export" do
+    export = completed_export_for(users(:david))
+
+    get export_path(export)
+
+    assert_redirected_to rails_blob_path(export.file, disposition: :attachment)
+
+    follow_redirect!
+    assert_response :redirect
+    assert_match export.file.filename.to_s, response.location
+  end
+
+  test "an export can't be downloaded once it expires" do
+    export = completed_export_for(users(:david))
+
+    travel Export::DOWNLOAD_PERIOD + 1.minute do
+      get export_path(export)
+
+      assert_response :success
+      assert_select "h2", text: /expired/
+    end
+  end
+
+  test "an export in progress shows its status" do
+    post exports_path
+
+    get export_path(Export.last)
+
+    assert_response :success
+    assert_select "h2", text: /preparing your export/
+  end
+
+  test "an export can only be downloaded by who requested it" do
+    export = completed_export_for(users(:kevin))
+
+    get export_path(export)
+    assert_response :not_found
+
+    get rails_blob_path(export.file, disposition: :attachment)
+    assert_response :forbidden
+  end
+
+  private
+    def completed_export_for(user)
+      user.exports.create!.tap do |export|
+        perform_enqueued_jobs only: Export::ProcessJob
+        export.reload
+      end
+    end
+end
