+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  include Rails.application.routes.url_helpers
+
+  def default_url_options
+    Rails.application.config.action_mailer.default_url_options
+  end
+
+  setup do
+    Current.session = sessions(:david)
+    @import = Import.create!(file: { io: file_fixture("export.zip").open, filename: "export.zip", content_type: "application/zip" })
+  end
+
+  test "completed links to the new account" do
+    @import.update! status: :completed, imported_account: accounts(:acme)
+    email = ImportMailer.completed(@import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ users(:david).identity.email_address ], email.to
+    assert_equal "Your Fizzy import is done", email.subject
+    assert_match landing_url(script_name: accounts(:acme).slug), email.html_part.body.encoded
+    assert_match landing_url(script_name: accounts(:acme).slug), email.text_part.body.encoded
+    assert_match accounts(:acme).name, email.text_part.body.encoded
+  end
+
+  test "failed says why" do
+    @import.update! status: :failed, error_message: "The file is not a Fizzy account export"
+    email = ImportMailer.failed(@import)
+
+    assert_equal [ users(:david).identity.email_address ], email.to
+    assert_equal "Your Fizzy import failed", email.subject
+    assert_match "The file is not a Fizzy account export", email.html_part.body.encoded
+    assert_match "The file is not a Fizzy account export", email.text_part.body.encoded
+    assert_match new_account_import_url(script_name: accounts(:"37s").slug), email.text_part.body.encoded
+  end
+end
