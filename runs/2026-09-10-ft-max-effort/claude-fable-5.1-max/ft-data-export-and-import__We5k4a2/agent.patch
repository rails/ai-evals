+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account Settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<div class="panel panel--wide shadow center flex flex-column gap" style="--panel-size: 60ch;">
+  <header>
+    <h2 class="txt-large margin-none font-weight-black"><%= @page_title %></h2>
+    <p class="txt-medium margin-none">Upload the zip file exported from a Fizzy account, and we’ll create a new account with everything in it: boards, cards, comments, files and people.</p>
+  </header>
+
+  <%= form_with model: @import, url: account_imports_path, class: "flex flex-column gap" do |form| %>
+    <%= form.file_field :file, class: "input", accept: ".zip,application/zip", required: true, direct_upload: true %>
+
+    <% if @import.errors.any? %>
+      <p class="margin-none txt-negative txt-small"><%= @import.errors.full_messages.to_sentence %></p>
+    <% end %>
+
+    <p class="margin-none txt-small">The import runs in the background. You’ll get an email when it’s done, or if it couldn’t be completed and why. Everyone who was on the exported account will find the new account the next time they sign in with the same email address.</p>
+
+    <%= form.button class: "btn btn--reversed center" do %>
+      <span>Import</span>
+    <% end %>
+  <% end %>
