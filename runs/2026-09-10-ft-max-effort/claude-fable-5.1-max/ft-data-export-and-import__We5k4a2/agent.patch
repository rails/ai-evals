+    assert_match accounts(:"37s").name, email.text_part.body.encoded
+  end
+
+  test "failed tells the requester" do
+    @export.failed!
+    email = ExportMailer.failed(@export)
+
+    assert_equal [ users(:kevin).identity.email_address ], email.to
+    assert_equal "Your Fizzy export couldn't be created", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
