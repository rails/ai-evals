+
+    follow_redirect!
+    assert_response :success
+    assert_select "p", text: /importing/i
+  end
+
+  test "create without an account in the URL" do
+    untenanted do
+      assert_difference -> { Account::Import.count }, 1 do
+        post account_imports_path, params: { account_import: { file: export_upload } }
+      end
+
+      assert_redirected_to account_import_path(Account::Import.last)
+    end
