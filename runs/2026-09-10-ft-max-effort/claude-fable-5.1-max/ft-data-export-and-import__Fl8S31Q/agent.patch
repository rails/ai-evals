+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @card = cards(:logo)
+    Current.session = sessions(:david)
+
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @card.comments.create!(body: "<p>Look at this #{ActionText::Attachment.from_attachable(blob).to_html} #{mention_of(users(:kevin))}</p>")
+
+    Current.session = nil
+    @export = export_account
+  end
+
+  test "importing an export creates a new account with everything in it" do
+    import = import_export
+
+    assert import.completed?, import.error_message
+    account = import.account
+    assert_not_equal @account, account
+    assert_equal @account.name, account.name
+    assert_not_equal @account.external_account_id, account.external_account_id
+    assert account.join_code.present?
+    assert_equal @account.entropy.auto_postpone_period, account.entropy.auto_postpone_period
+
+    assert_equal @account.users.count, account.users.count
+    assert_equal @account.users.pluck(:name).sort, account.users.pluck(:name).sort
+    assert_equal users(:david).identity, account.users.find_by(name: "David").identity
+    assert_equal "owner", account.users.find_by(name: "Jason").role
+    assert account.system_user.present?
+
+    assert_equal @account.boards.pluck(:name).sort, account.boards.pluck(:name).sort
+    assert_equal @account.cards.count, account.cards.count
+    assert_equal @account.columns.count, account.columns.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: account).count
+    assert_equal Event.where(account: @account).count, Event.where(account: account).count
+    assert_equal Access.where(account: @account).count, Access.where(account: account).count
+    assert_equal Reaction.where(account: @account).pluck(:content).sort, Reaction.where(account: account).pluck(:content).sort
+
+    card = account.cards.find_by!(number: @card.number)
+    assert_equal @card.title, card.title
+    assert_equal @card.board.name, card.board.name
+    assert_equal @card.column.name, card.column.name
+    assert_equal @card.creator.name, card.creator.name
+    assert_equal @card.created_at.to_i, card.created_at.to_i
+    assert card.image.attached?
+    assert_not_equal @card.image.blob.key, card.image.blob.key
+    assert_equal @card.image.blob.checksum, card.image.blob.checksum
+    assert_equal file_fixture("moon.jpg").binread, card.image.download
+
+    comment = card.comments.chronologically.last
+    assert_equal 1, comment.body.embeds.size
+    assert_equal "avatar.png", comment.body.embeds.first.blob.filename.to_s
+    assert_equal file_fixture("avatar.png").binread, comment.body.embeds.first.blob.download
+    assert_includes comment.body.body.attachables, account.users.find_by!(name: "Kevin")
+    assert_equal card.board.accesses.pluck(:user_id).sort, card.board.users.pluck(:id).sort
+
+    assert_enqueued_with job: Storage::ReconcileJob, args: [ account ]
+    assert_enqueued_with job: Storage::ReconcileJob, args: [ card.board ]
+  end
+
+  test "public boards, avatars, webhooks and their kin come along" do
+    boards(:writebook).publish
+    users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+    users(:david).avatar_thumbnail.processed
+    @export = export_account
+
+    account = import_export.account
+
+    board = account.boards.find_by!(name: "Writebook")
+    assert board.published?
+    assert_not_equal boards(:writebook).publication.key, board.publication.key
+
+    david = account.users.find_by!(name: "David")
+    assert david.avatar.attached?
+    assert_equal file_fixture("avatar.png").binread, david.avatar.download
+    assert_equal users(:david).avatar.blob.variant_records.count, david.avatar.blob.variant_records.count
+    assert david.avatar_thumbnail.processed?
+
+    assert_equal Webhook.where(account: @account).pluck(:name).sort, board.account.webhooks.pluck(:name).sort
+    assert_equal Webhook::Delivery.where(account: @account).count, Webhook::Delivery.where(account: account).count
+    assert_equal Webhook::DelinquencyTracker.where(account: @account).count, Webhook::DelinquencyTracker.where(account: account).count
+    assert_equal Notification.where(account: @account).count, Notification.where(account: account).count
+    assert_equal Mention.where(account: @account).count, Mention.where(account: account).count
+  end
+
+  test "importing keeps the account it came from untouched" do
+    assert_no_difference [ -> { @account.reload.cards.count }, -> { @account.users.count }, -> { ActiveStorage::Blob.where(account: @account).count } ] do
+      import_export
+    end
+  end
+
+  test "records get new ids of their own" do
+    account = import_export.account
+
+    assert_empty account.cards.ids & @account.cards.ids
+    assert_empty account.users.ids & @account.users.ids
+    assert_empty ActiveStorage::Blob.where(account: account).pluck(:key) & ActiveStorage::Blob.where(account: @account).pluck(:key)
+  end
+
+  test "the person importing gets in as an owner when they weren't on the account" do
+    identity = Identity.create!(email_address: "newcomer@example.com")
+    import = import_export(identity: identity)
+
+    user = import.account.users.find_by!(identity: identity)
+    assert user.owner?
+    assert user.verified?
+  end
+
+  test "saved filters keep what they filter by" do
+    filter = users(:david).filters.remember(board_ids: [ boards(:writebook).id ], tag_ids: [ tags(:web).id ], assignee_ids: [ users(:kevin).id ], indexed_by: "closed")
+    @export = export_account
+
+    account = import_export.account
+    imported_filter = account.users.find_by!(name: "David").filters.find { |candidate| candidate.indexed_by.closed? }
+
+    assert_equal [ "Writebook" ], imported_filter.boards.map(&:name)
+    assert_equal [ "web" ], imported_filter.tags.map(&:title)
+    assert_equal [ "Kevin" ], imported_filter.assignees.map(&:name)
+    assert_equal Filter.digest_params(imported_filter.as_params), imported_filter.params_digest
+    assert_not_equal filter.params_digest, imported_filter.params_digest
+  end
+
+  test "imported cards can be searched for" do
+    account = import_export.account
+    user = account.users.find_by!(name: "David")
+
+    assert_includes Card.where(account: account).mentioning("logo", user: user), account.cards.find_by!(number: @card.number)
+  end
+
+  test "a completed import emails the person who asked for it" do
+    import = nil
+
+    assert_enqueued_emails 1 do
+      import = import_export
+    end
+
+    assert_enqueued_email_with Account::ImportMailer, :completed, args: [ import ]
+  end
+
+  test "a file that isn't an export fails and leaves nothing behind" do
+    import = nil
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Identity.count }, -> { Card.count }, -> { ActiveStorage::Blob.count } ] do
+      import = import_zip { |zip| zip.add_file "cards/1.json", "{}" }
+    end
+
+    assert import.failed?
+    assert_enqueued_email_with Account::ImportMailer, :failed, args: [ import ]
+    assert_nil import.account
+    assert_match(/isn't a Fizzy account export/, import.error_message)
+  end
+
+  test "a file that isn't a zip fails with a reason" do
+    import = import_file(StringIO.new("PK but not really a zip file at all"), filename: "bogus.zip")
+
+    assert import.failed?
+    assert_match(/zip/i, import.error_message)
+  end
+
+  test "an import that breaks down halfway leaves nothing behind" do
+    Account::DataTransfer::ActionText::RichTextRecordSet.any_instance.stubs(:import_from).raises("boom")
+    import = nil
+
+    uploaded_keys = uploaded_keys_during do
+      assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Card.count }, -> { Comment.count }, -> { ActiveStorage::Blob.count }, -> { ActiveStorage::Attachment.count }, -> { Entropy.count } ] do
+        import = import_export
+      end
+    end
+
+    assert import.failed?
+    assert_equal "boom", import.error_message
+    assert_nil import.account
+
+    assert_operator uploaded_keys.size, :>, 1
+    uploaded_keys.each { |key| assert_not ActiveStorage::Blob.service.exist?(key), "#{key} was left behind" }
+  end
+
+  test "the uploaded file is removed once the import has run" do
+    import = import_export
+
+    assert_not ActiveStorage::Blob.service.exist?(import.file_key)
+  end
+
+  test "one import at a time per person" do
+    Account::Import.create!(identity: identities(:david), file: zip_upload)
+    import = Account::Import.new(identity: identities(:david), file: zip_upload)
+
+    assert_not import.valid?
+    assert_match(/already have an import/, import.errors.full_messages.to_sentence)
+    assert Account::Import.new(identity: identities(:kevin), file: zip_upload).valid?
+  end
+
+  test "requires a zip file" do
+    import = Account::Import.new(identity: identities(:david), file: StringIO.new("plain text"))
+
+    assert_not import.valid?
+    assert_includes import.errors[:file], "must be a .zip file exported from Fizzy"
+  end
+
+  private
+    def zip_upload
+      Rack::Test::UploadedFile.new(@export.file.open.path, "application/zip", original_filename: "export.zip")
+    end
+
+    def uploaded_keys_during
+      keys = []
+      subscriber = ActiveSupport::Notifications.subscribe("service_upload.active_storage") { |event| keys << event.payload[:key] }
+      yield
+      keys
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+
+    def mention_of(user)
+      ActionText::Attachment.from_attachable(user).to_html
+    end
+
+    def export_account
+      Account::Export.create!(account: @account, user: users(:jason)).tap(&:process)
+    end
+
+    def import_export(identity: identities(:david))
+      @export.file.open do |file|
+        import_file(file, filename: @export.file.filename.to_s, identity: identity)
+      end
+    end
+
+    def import_zip(identity: identities(:david))
+      Tempfile.create([ "export", ".zip" ], binmode: true) do |tempfile|
+        writer = ZipFile::Writer.new(tempfile)
+        yield writer
+        writer.close
+        tempfile.rewind
+
+        import_file(tempfile, filename: "export.zip", identity: identity)
+      end
+    end
+
+    def import_file(file, filename:, identity: identities(:david))
+      Account::Import.create!(identity: identity, file: Rack::Test::UploadedFile.new(file, "application/zip", original_filename: filename)).tap(&:process)
+    end
+end
