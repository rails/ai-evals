+require "test_helper"
+
+class Account::DataTransfer::IdMapTest < ActiveSupport::TestCase
+  setup do
+    @ids = Account::DataTransfer::IdMap.new
+  end
+
+  test "mints a new id the first time it sees one, and sticks with it" do
+    new_id = @ids["old"]
+
+    assert_not_equal "old", new_id
+    assert_equal new_id, @ids["old"]
+    assert_not_equal new_id, @ids["other"]
+    assert @ids.include?("old")
+    assert_not @ids.include?("never seen")
+  end
+
+  test "remaps the ids it knows about in nested data" do
+    new_id = @ids["old"]
+
+    assert_equal({ "assignee_ids" => [ new_id, "unknown" ], "nested" => { "card_id" => new_id }, "count" => 1 },
+      @ids.remap({ "assignee_ids" => [ "old", "unknown" ], "nested" => { "card_id" => "old" }, "count" => 1 }))
+  end
+
+  test "hands out storage keys for blobs" do
+    key = @ids.blob_key_for("blob")
+
+    assert_equal key, @ids.blob_key_for("blob")
+    assert_not_equal key, @ids.blob_key_for("other blob")
+    assert_equal 2, @ids.blob_keys.size
+  end
+end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..dd8cdbb
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+    Current.session = sessions(:kevin)
+
+    @card = cards(:logo)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @comment = @card.comments.create!(body: "<p>Take a look #{ActionText::Attachment.from_attachable(@blob).to_html}</p>")
+  end
+
+  test "creating an export processes it in the background" do
+    export = Account::Export.create!(account: @account, user: @user)
+
+    assert export.pending?
+    assert_enqueued_with job: ExportJob, args: [ export ]
+  end
+
+  test "processing builds a zip with everything in the account and emails a download link" do
+    export = Account::Export.create!(account: @account, user: @user)
+
+    assert_enqueued_emails 1 do
+      export.process
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+    assert_match(/\A37signals-\d{4}-\d{2}-\d{2}\.zip\z/, export.file.filename.to_s)
+    assert_enqueued_email_with ExportMailer, :completed, args: [ export ]
+
+    open_export(export) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      assert_equal "fizzy-account", manifest["kind"]
+      assert_equal @account.name, manifest.dig("account", "name")
+
+      assert_equal @account.cards.count, records_in(zip, "cards").size
+      assert_equal @account.users.count, records_in(zip, "users").size
+      assert_equal @account.boards.count, records_in(zip, "boards").size
+      assert_equal Comment.where(account: @account).count, records_in(zip, "comments").size
+      assert_equal Event.where(account: @account).count, records_in(zip, "events").size
+      assert_equal Entropy.where(account: @account).count, records_in(zip, "entropies").size
+      assert_equal 1, records_in(zip, "accounts").size
+
+      card = records_in(zip, "cards").find { |record| record["id"] == @card.id }
+      assert_equal @card.title, card["title"]
+      assert_equal @card.board_id, card["board_id"]
+      assert_equal @card.created_at.utc.iso8601(6), card["created_at"]
+
+      user = records_in(zip, "users").find { |record| record["id"] == @user.id }
+      assert_equal @user.identity.email_address, user["email_address"]
+      assert_equal "admin", user["role"]
+
+      assert_equal ActiveStorage::Blob.where(account: @account).where.not(id: export.file.blob.id).count, records_in(zip, "active_storage_blobs").size
+      assert_equal file_fixture("moon.jpg").binread, zip.read("files/#{@card.image.blob.id}").b
+      assert_equal file_fixture("avatar.png").binread, zip.read("files/#{@blob.id}").b
+    end
+  end
+
+  test "rich text attachments are exported as plain record references" do
+    export = Account::Export.create!(account: @account, user: @user)
+    export.process
+
+    open_export(export) do |zip|
+      body = records_in(zip, "action_text_rich_texts").find { |record| record["record_id"] == @comment.id }["body"]
+      attachment = Nokogiri::HTML5.fragment(body).at_css("action-text-attachment")
+
+      assert_equal "ActiveStorage::Blob", attachment["attachable-type"]
+      assert_equal @blob.id, attachment["attachable-id"]
+      assert_nil attachment["sgid"]
+      assert_nil attachment["url"]
+      assert_equal "avatar.png", attachment["filename"]
+    end
+  end
+
+  test "the zip files of earlier exports are left out" do
+    earlier_export = Account::Export.create!(account: @account, user: @user).tap(&:process)
+
+    export = Account::Export.create!(account: @account, user: @user).tap(&:process)
+
+    open_export(export) do |zip|
+      blob_ids = records_in(zip, "active_storage_blobs").map { |record| record["id"] }
+      assert_not_includes blob_ids, earlier_export.file.blob.id
+      assert_not zip.exists?("files/#{earlier_export.file.blob.id}")
+      assert_not records_in(zip, "active_storage_attachments").any? { |record| record["record_type"] == "Export" }
+    end
+  end
+
+  test "a failed export is marked as such" do
+    export = Account::Export.create!(account: @account, user: @user)
+    Account::DataTransfer::Manifest.any_instance.stubs(:export_to).raises("boom")
+
+    assert_raises(RuntimeError) { export.process }
+    assert export.failed?
+  end
+
+  test "the download link is only for the person who asked for the export" do
+    export = Account::Export.create!(account: @account, user: @user).tap(&:process)
+
+    assert export.file.blob.accessible_to?(@user)
+    assert_not export.file.blob.accessible_to?(users(:david))
+    assert_not export.file.blob.publicly_accessible?
+  end
+
+  test "stale exports are cleaned up along with their files" do
+    export = Account::Export.create!(account: @account, user: @user).tap(&:process)
+    export.update_columns(updated_at: (Export::RETENTION_PERIOD + 1.hour).ago)
+    fresh_export = Account::Export.create!(account: @account, user: @user).tap(&:process)
+    slow_export = Account::Export.create!(account: @account, user: @user).tap { |slow| slow.update_columns(status: :processing, updated_at: (Export::RETENTION_PERIOD + 1.hour).ago) }
+
+    assert_difference -> { Export.count }, -1 do
+      Export.cleanup
+    end
+
+    assert_not Export.exists?(export.id)
+    assert Export.exists?(fresh_export.id)
+    assert Export.exists?(slow_export.id)
+  end
+
+  test "exports of both kinds go along with the account" do
+    Account::Export.create!(account: @account, user: @user)
+    User::Export.create!(account: @account, user: @user)
+
+    assert_difference -> { Export.count }, -2 do
+      @account.incinerate
+    end
+  end
+
+  private
+    def open_export(export, &block)
+      ZipFile.open(export.file.key, byte_size: export.file.byte_size, &block)
+    end
+
+    def records_in(zip, table)
+      zip.glob("#{table}/*.jsonl").flat_map do |path|
+        [].tap { |records| zip.each_line(path) { |line| records << JSON.parse(line) } }
+      end
+    end
+end
