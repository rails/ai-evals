+require "test_helper"
+
+class User::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.session = sessions(:david)
+
+    @card = cards(:logo)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @comment = @card.comments.create!(body: "<p>Take a look #{ActionText::Attachment.from_attachable(@blob).to_html}</p>", creator: users(:kevin))
+  end
+
+  test "processing builds a zip with the cards the user can see and emails a download link" do
+    export = User::Export.create!(account: @account, user: @user)
+
+    assert_enqueued_emails 1 do
+      export.process
+    end
+
+    assert export.completed?
+    assert_match(/\Adavid-cards-\d{4}-\d{2}-\d{2}\.zip\z/, export.file.filename.to_s)
+    assert_enqueued_email_with ExportMailer, :completed, args: [ export ]
+
+    open_export(export) do |zip|
+      assert_equal "fizzy-cards", JSON.parse(zip.read("manifest.json"))["kind"]
+
+      numbers = zip.glob("cards/*.json").map { |path| File.basename(path, ".json").to_i }.sort
+      assert_equal @user.accessible_cards.published.pluck(:number).sort, numbers
+
+      card = JSON.parse(zip.read("cards/#{@card.number}.json"))
+      assert_equal @card.title, card["title"]
+      assert_equal @card.board.name, card["board"]
+      assert_equal @card.column.name, card["column"]
+      assert_equal @card.creator.name, card.dig("creator", "name")
+      assert_equal @card.creator.identity.email_address, card.dig("creator", "email_address")
+
+      assert_equal "moon.jpg", card.dig("image", "filename")
+      assert_equal "cards/#{@card.number}/moon.jpg", card.dig("image", "path")
+      assert_equal file_fixture("moon.jpg").binread, zip.read("cards/#{@card.number}/moon.jpg").b
+
+      comment = card["comments"].find { |comment| comment["id"] == @comment.id }
+      assert_equal "Kevin", comment.dig("creator", "name")
+      assert_equal "Take a look [avatar.png]", comment.dig("body", "plain_text")
+      assert_equal [ "cards/#{@card.number}/avatar.png" ], comment.dig("body", "attachments").map { |attachment| attachment["path"] }
+      assert_includes comment.dig("body", "html"), %(<img src="cards/#{@card.number}/avatar.png")
+      assert_equal file_fixture("avatar.png").binread, zip.read("cards/#{@card.number}/avatar.png").b
+    end
+  end
+
+  test "cards on boards the user can't see are left out" do
+    board = @account.boards.create!(name: "Secret", creator: users(:kevin))
+    secret_card = board.cards.create!(title: "Secret plans", creator: users(:kevin), status: "published")
+    export = User::Export.create!(account: @account, user: @user).tap(&:process)
+
+    open_export(export) do |zip|
+      assert_not zip.exists?("cards/#{secret_card.number}.json")
+      assert zip.exists?("cards/#{@card.number}.json")
+    end
+  end
+
+  test "files with the same name on a card get different paths" do
+    other_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @card.comments.create!(body: "<p>Another #{ActionText::Attachment.from_attachable(other_blob).to_html}</p>")
+    export = User::Export.create!(account: @account, user: @user).tap(&:process)
+
+    open_export(export) do |zip|
+      paths = JSON.parse(zip.read("cards/#{@card.number}.json"))["comments"].flat_map { |comment| comment.dig("body", "attachments").map { |attachment| attachment["path"] } }
+      assert_equal [ "cards/#{@card.number}/avatar.png", "cards/#{@card.number}/avatar-2.png" ], paths
+      paths.each { |path| assert zip.exists?(path) }
+    end
+  end
+
+  private
+    def open_export(export, &block)
+      ZipFile.open(export.file.key, byte_size: export.file.byte_size, &block)
+    end
+end
