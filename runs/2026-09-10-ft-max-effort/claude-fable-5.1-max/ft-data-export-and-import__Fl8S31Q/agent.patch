+<% end %>
+
+<section class="panel shadow center flex flex-column gap" style="--panel-size: 60ch;">
+  <% if @import.completed? && @import.account %>
+    <p class="margin-none">
+      <strong><%= @import.account.name %></strong> is ready, with all of its boards, cards, comments, files and people.
+    </p>
+
+    <%= link_to landing_path(script_name: @import.account.slug), class: "btn btn--link center" do %>
+      <span>Open <%= @import.account.name %></span>
