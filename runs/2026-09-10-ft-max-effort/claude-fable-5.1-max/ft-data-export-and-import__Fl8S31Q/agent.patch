diff --git a/app/models/user/export.rb b/app/models/user/export.rb
new file mode 100644
index 0000000..89b912c
--- /dev/null
+++ b/app/models/user/export.rb
@@ -0,0 +1,153 @@
+# The cards someone has access to: a JSON file per card, comments included, along with every
+# picture and file attached to them.
+class User::Export < Export
+  KIND = "fizzy-cards"
+  VERSION = 1
+
+  private
+    attr_reader :zip
+
+    def basename
+      "#{user.name} cards"
+    end
+
+    def build(zip)
+      @zip = zip
+      zip.add_file "manifest.json", description.to_json
+
+      cards.find_each do |card|
+        export_card(card)
+      end
+    end
+
+    def description
+      {
+        kind: KIND,
+        version: VERSION,
+        exported_at: Time.current.utc.iso8601,
+        account: { id: account.id, name: account.name },
+        user: { id: user.id, name: user.name }
+      }
+    end
+
+    def cards
+      user.accessible_cards.published.preloaded
+    end
+
+    def export_card(card)
+      @file_paths = {}
+      zip.add_file "cards/#{card.number}.json", JSON.pretty_generate(card_json(card))
+    end
+
+    def card_json(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        board: card.board.name,
+        column: card.column&.name,
+        tags: card.tags.map(&:title).sort,
+        creator: person_json(card.creator),
+        assignees: card.assignees.map { |assignee| person_json(assignee) },
+        golden: card.golden?,
+        postponed: card.postponed?,
+        closed: card.closed?,
+        closed_at: timestamp(card.closure&.created_at),
+        due_on: card.due_on,
+        created_at: timestamp(card.created_at),
+        last_active_at: timestamp(card.last_active_at),
+        description: rich_text_json(card.description, card),
+        image: (file_json(card.image.blob, card) if card.image.attached?),
+        steps: card.steps.map { |step| { content: step.content, completed: step.completed? } },
+        reactions: card.reactions.map { |reaction| reaction_json(reaction) },
+        comments: comments_of(card).map { |comment| comment_json(comment, card) }
+      }
+    end
+
+    def comments_of(card)
+      card.comments.chronologically.with_rich_text_body_and_embeds.includes(:creator, reactions: :reacter)
+    end
+
+    def comment_json(comment, card)
+      {
+        id: comment.id,
+        creator: person_json(comment.creator),
+        created_at: timestamp(comment.created_at),
+        body: rich_text_json(comment.body, card),
+        reactions: comment.reactions.map { |reaction| reaction_json(reaction) }
+      }
+    end
+
+    def reaction_json(reaction)
+      { content: reaction.content, reacter: person_json(reaction.reacter) }
+    end
+
+    def person_json(person)
+      @people ||= {}
+      @people[person.id] ||= { id: person.id, name: person.name, email_address: person.identity&.email_address }
+    end
+
+    def timestamp(time)
+      time&.utc&.iso8601
+    end
+
+    def rich_text_json(rich_text, card)
+      {
+        plain_text: rich_text.to_plain_text,
+        html: html_for(rich_text, card),
+        attachments: rich_text.embeds.filter_map { |embed| file_json(embed.blob, card) }
+      }
+    end
+
+    # Attachments in the HTML point at the files in the zip, rather than at Fizzy
+    def html_for(rich_text, card)
+      rich_text.body&.fragment&.replace(ActionText::Attachment.tag_name) do |node|
+        case attachable = ActionText::Attachable.from_node(node)
+        when ActiveStorage::Blob then file_link_for(attachable, card) || node
+        when User then ERB::Util.html_escape("@#{attachable.name}")
+        else node
+        end
+      end&.to_html
+    end
+
+    def file_link_for(blob, card)
+      if path = file_path_for(blob, card)
+        if blob.image?
+          %(<img src="#{ERB::Util.html_escape(path)}" alt="#{ERB::Util.html_escape(blob.filename)}">)
+        else
+          %(<a href="#{ERB::Util.html_escape(path)}">#{ERB::Util.html_escape(blob.filename)}</a>)
+        end
+      end
+    end
+
+    def file_json(blob, card)
+      if path = file_path_for(blob, card)
+        { filename: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size, path: path }
+      end
+    end
+
+    # Adds the file to the zip the first time it comes up for a card, and tells where it ended up
+    def file_path_for(blob, card)
+      @file_paths.fetch(blob.id) do
+        @file_paths[blob.id] = add_file(blob, card)
+      end
+    end
+
+    def add_file(blob, card)
+      if blob.service.exist?(blob.key)
+        unique_path_for(blob, card).tap do |path|
+          zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+        end
+      end
+    end
+
+    def unique_path_for(blob, card)
+      filename = ActiveStorage::Filename.new(blob.filename.sanitized)
+      directory = "cards/#{card.number}"
+      counter = 1
+
+      path = "#{directory}/#{filename}"
+      path = "#{directory}/#{filename.base}-#{counter += 1}#{filename.extension_with_delimiter}" while zip.exists?(path)
+      path
+    end
+end
