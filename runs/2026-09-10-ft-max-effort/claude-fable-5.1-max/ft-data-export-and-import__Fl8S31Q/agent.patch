+require "test_helper"
+
+class Account::ImportMailerTest < ActionMailer::TestCase
+  setup do
+    @import = Account::Import.create!(identity: identities(:david), file: Rack::Test::UploadedFile.new(zip_file, "application/zip", original_filename: "37signals.zip"))
+  end
+
+  test "completed links to the new account" do
+    @import.update! account: accounts(:initech), status: :completed
+    email = Account::ImportMailer.completed(@import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_equal "Your Fizzy import is done", email.subject
+    assert_match accounts(:initech).name, email.html_part.body.encoded
+    assert_match "http://example.com#{accounts(:initech).slug}/landing", email.text_part.body.encoded
+  end
+
+  test "failed says why" do
+    @import.update! status: :failed, error_message: "This file isn't a Fizzy account export"
+    email = Account::ImportMailer.failed(@import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal "Your Fizzy import failed", email.subject
+    assert_match "37signals.zip", email.html_part.body.encoded
+    assert_match "This file isn&#39;t a Fizzy account export", email.html_part.body.encoded
+    assert_match "This file isn't a Fizzy account export", email.text_part.body.encoded
+    assert_match "http://example.com/account/imports/new", email.text_part.body.encoded
+  end
+  private
+    def zip_file
+      StringIO.new.tap do |io|
+        writer = ZipFile::Writer.new(io)
+        writer.add_file "manifest.json", "{}"
+        writer.close
+        io.rewind
+      end
+    end
+end
