+    key = ZipFile.store(StringIO.new(damaged))
+
+    ZipFile.open(key, byte_size: damaged.bytesize) do |reader|
+      assert_raises(ZipFile::IntegrityError) { reader.read("files/data.bin") }
+    end
+  ensure
