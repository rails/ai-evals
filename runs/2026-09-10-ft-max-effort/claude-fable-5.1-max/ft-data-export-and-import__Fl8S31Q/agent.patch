diff --git a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
index 6017f88..0013014 100644
--- a/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
+++ b/test/models/account/data_transfer/action_text/rich_text_record_set_test.rb
@@ -1,4 +1,65 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @comment = cards(:logo).comments.create!(body: <<~HTML)
+      <p>Look #{ActionText::Attachment.from_attachable(@blob).to_html} #{ActionText::Attachment.from_attachable(users(:kevin)).to_html}</p>
+      <action-text-attachment url="https://example.com/remote.gif" content-type="image/*" presentation="gallery"></action-text-attachment>
+    HTML
+  end
+
+  test "exported bodies refer to attachments by record, and get signed again when imported" do
+    zip = ZipFile::Writer.new(StringIO.new.binmode)
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(@account).export_to(zip)
+    assert_equal [ "action_text_rich_texts/00001.jsonl" ], zip.glob("action_text_rich_texts/*")
+
+    exported = exported_body_from(zip)
+    attachments = Nokogiri::HTML5.fragment(exported).css("action-text-attachment")
+    assert_equal [ [ "ActiveStorage::Blob", @blob.id ], [ "User", users(:kevin).id ], [ nil, nil ] ],
+      attachments.map { |node| [ node["attachable-type"], node["attachable-id"] ] }
+    assert_equal [ nil, nil, nil ], attachments.map { |node| node["sgid"] }
+    assert_equal "https://example.com/remote.gif", attachments.last["url"]
+
+    ids = Account::DataTransfer::IdMap.new
+    new_blob = Current.with_account(accounts(:initech)) { ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png") }
+    ids.stubs(:[]).with(@blob.id).returns(new_blob.id)
+    ids.stubs(:[]).with(users(:kevin).id).returns(users(:mike).id)
+
+    imported = ActionText::Content.new(Account::DataTransfer::ActionText::Body.new(exported).import(ids))
+    assert_equal [ new_blob, users(:mike) ], imported.attachables.first(2)
+    assert_kind_of ActionText::Attachables::RemoteImage, imported.attachables.last
+    assert_nil imported.fragment.find_all("action-text-attachment").first["attachable-id"]
+  end
+
+  test "attachments that can't be found are left missing" do
+    ids = Account::DataTransfer::IdMap.new
+    body = Account::DataTransfer::ActionText::Body.new(%(<p>Gone <action-text-attachment attachable-type="User" attachable-id="nope" caption="Hi"></action-text-attachment></p>))
+
+    imported = body.import(ids)
+    assert_equal %(<p>Gone <action-text-attachment caption="Hi"></action-text-attachment></p>), imported.strip
+    assert_kind_of ActionText::Attachables::MissingAttachable, ActionText::Content.new(imported).attachables.sole
+  end
+
+  test "empty bodies are left alone" do
+    assert_nil Account::DataTransfer::ActionText::Body.new(nil).export
+    assert_equal "", Account::DataTransfer::ActionText::Body.new("").import(Account::DataTransfer::IdMap.new)
+  end
+
+  private
+    def exported_body_from(writer)
+      io = writer.instance_variable_get(:@output_io)
+      writer.close
+      io.rewind
+      key = ZipFile.store(io)
+      ZipFile.open(key, byte_size: io.size) do |zip|
+        records = []
+        zip.each_line("action_text_rich_texts/00001.jsonl") { |line| records << JSON.parse(line) }
+        records.find { |record| record["record_id"] == @comment.id }["body"]
+      end
+    ensure
+      ZipFile.delete(key) if key
+    end
 end
