+# Imports don't belong to an account, they create one, so they work with or without one in the URL
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  before_action :ensure_accounts_can_be_created
+  before_action :set_import, only: :show
+
+  layout -> { Current.account ? "application" : "public" }
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Current.identity.imports.build(import_params)
+
+    if @import.save
+      redirect_to account_import_path(@import), notice: "We’re importing your account. You’ll get an email when it’s ready."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+  end
+
+  private
+    def ensure_accounts_can_be_created
+      unless Account.accepting_signups?
+        redirect_to session_menu_path(script_name: nil), alert: "This Fizzy isn’t taking new accounts."
+      end
+    end
+
+    def set_import
+      @import = Current.identity.imports.find(params[:id])
+    end
+
+    def import_params
+      params.expect(account_import: [ :file ])
+    end
+end
