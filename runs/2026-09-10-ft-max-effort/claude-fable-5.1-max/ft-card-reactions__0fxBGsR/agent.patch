diff --git a/test/integration/card_reactions_test.rb b/test/integration/card_reactions_test.rb
new file mode 100644
index 0000000..02907df
--- /dev/null
+++ b/test/integration/card_reactions_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class CardReactionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "card detail view lets users react to the card" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get card_path(@card)
+    assert_response :success
+
+    assert_select "##{dom_id(@card, :card_container)}" do
+      assert_select "turbo-frame##{dom_id(@card, :reacting)}" do
+        assert_select "##{dom_id(reaction)}", text: /👍/
+        assert_select "a[href='#{new_card_reaction_path(@card)}']"
+      end
+    end
+  end
+
+  test "comments keep their own reactions in the card detail view" do
+    comment = comments(:logo_agreement_jz)
+    comment_reaction = comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+    card_reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get card_path(@card)
+    assert_response :success
+
+    assert_select "turbo-frame##{dom_id(comment, :reacting)}" do
+      assert_select "##{dom_id(comment_reaction)}"
+      assert_select "##{dom_id(card_reaction)}", count: 0
+      assert_select "a[href='#{new_card_comment_reaction_path(@card, comment)}']"
+    end
+
+    assert_select "turbo-frame##{dom_id(@card, :reacting)}" do
+      assert_select "##{dom_id(card_reaction)}"
+      assert_select "##{dom_id(comment_reaction)}", count: 0
+    end
+  end
+
+  test "draft cards can't be reacted to from their detail view" do
+    draft = boards(:writebook).cards.create!(status: :drafted, creator: users(:david))
+
+    get card_draft_path(draft)
+    assert_response :success
+
+    assert_select "turbo-frame##{dom_id(draft, :reacting)}", count: 0
+  end
+
+  test "card previews show the boost count when the card has reactions" do
+    @card.reactions.create!(content: "👍", reacter: users(:kevin))
+    @card.reactions.create!(content: "🎉", reacter: users(:jz))
+
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+
+    assert_select "##{dom_id(@card, :article)}" do
+      assert_select ".card__reactions strong", text: "2"
+    end
+  end
+
+  test "card previews don't show a boost count when the card has no reactions" do
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+
+    assert_select "##{dom_id(@card, :article)}" do
+      assert_select ".card__reactions", count: 0
+    end
+  end
+
+  test "card previews only count the card's own reactions" do
+    comments(:logo_agreement_jz).reactions.create!(content: "🎉", reacter: users(:kevin))
+
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+
+    assert_select "##{dom_id(@card, :article)}" do
+      assert_select ".card__reactions", count: 0
+    end
+  end
+end
