diff --git a/test/controllers/concerns/current_locale_test.rb b/test/controllers/concerns/current_locale_test.rb
new file mode 100644
index 0000000..1031faa
--- /dev/null
+++ b/test/controllers/concerns/current_locale_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class CurrentLocaleTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "renders in English by default" do
+    get root_path
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "?locale=ja switches to Japanese and sticks to the session and the identity" do
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:david).reload.locale
+
+    get root_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "the chosen locale follows the identity to a clean browser" do
+    get root_path(locale: "ja")
+    reset!
+
+    sign_in_as :david
+    get root_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "a choice made on another browser follows the identity here" do
+    get root_path(locale: "ja")
+
+    identities(:david).update! locale: "en" # ... from another browser
+    get root_path
+    assert_select "html[lang=en]"
+  end
+
+  test "switching back to English also sticks" do
+    get root_path(locale: "ja")
+    get root_path(locale: "en")
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:david).reload.locale
+
+    get root_path
+    assert_select "html[lang=en]"
+  end
+
+  test "an unknown locale is ignored" do
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil identities(:david).reload.locale
+
+    get root_path(locale: "ja")
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "signed in people see pages that don't require signing in in their language too" do
+    identities(:david).update! locale: "ja"
+
+    get join_path(code: account_join_codes(:"37s").code)
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "anonymous visitors keep their choice for the session" do
+    sign_out
+
+    untenanted { get new_session_path(locale: "ja") }
+    assert_select "html[lang=ja]"
+
+    untenanted { get new_session_path }
+    assert_select "html[lang=ja]"
+  end
+
+  test "a locale chosen before signing in is kept after signing in" do
+    sign_out
+    untenanted { get new_session_path(locale: "ja") }
+
+    sign_in_as :david
+    get root_path
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "sign-in codes go out in the language chosen on the sign-in page" do
+    sign_out
+
+    untenanted do
+      get new_session_path(locale: "ja")
+
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:david).email_address }
+      end
+    end
+
+    assert_match "認証コード", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "the sign-in page speaks the language of the person who just signed out" do
+    get root_path(locale: "ja")
+    sign_out
+
+    untenanted { get new_session_path }
+    assert_select "html[lang=ja]"
+  end
+
+  test "the locale is part of the ETag" do
+    get user_avatar_path(users(:kevin))
+    etag = response.headers.fetch("ETag")
+
+    get user_avatar_path(users(:kevin)), headers: { "If-None-Match" => etag }
+    assert_equal 304, response.status
+
+    get user_avatar_path(users(:kevin), locale: "ja"), headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_not_equal etag, response.headers.fetch("ETag")
+  end
+end
