--- a/test/models/notification/pushable_test.rb
+++ b/test/models/notification/pushable_test.rb
@@ -95,3 +95,34 @@ class Notification::PushableTest < ActiveSupport::TestCase
     Notification.push_targets = original_targets
   end
 end
+
+class Notification::PushableLocaleTest < ActiveSupport::TestCase
+  setup do
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "pushes in the recipient's language, not the sender's" do
+    @notification.user.identity.update! locale: "ja"
+
+    target_class = mock("push_target_class")
+    target_class.expects(:process).with { |notification| notification.payload.title.include?("メンション") }
+
+    with_push_targets(target_class) { I18n.with_locale(:en) { @notification.push } }
+  end
+
+  test "keeps English for recipients who never chose a language" do
+    target_class = mock("push_target_class")
+    target_class.expects(:process).with { |notification| notification.payload.title.include?("mentioned you") }
+
+    with_push_targets(target_class) { I18n.with_locale(:ja) { @notification.push } }
+  end
+
+  private
+    def with_push_targets(*targets)
+      original_targets = Notification.push_targets
+      Notification.push_targets = targets
+      yield
+    ensure
+      Notification.push_targets = original_targets
+    end
+end
