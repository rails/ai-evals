@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Identity::LocaleTest < ActiveSupport::TestCase
+  test "only speaks languages Fizzy offers" do
+    identity = identities(:david)
+
+    assert identity.update(locale: "ja")
+    assert identity.update(locale: nil)
+    assert_not identity.update(locale: "xx")
+  end
+
+  test "in_locale runs in the chosen language" do
+    identities(:david).update! locale: "ja"
+
+    assert_equal :ja, identities(:david).in_locale { I18n.locale }
+    assert_equal :ja, users(:david).in_locale { I18n.locale }
+  end
+
+  test "in_locale falls back to the default language when none was chosen" do
+    I18n.with_locale(:ja) do
+      assert_equal :en, identities(:david).in_locale { I18n.locale }
+      assert_equal :en, users(:david).in_locale { I18n.locale }
+    end
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
