       Notification.create!(user: user, creator: user, source: source, created_at: 30.minutes.ago)
     end
 end
+
+class Notification::BundleMailerLocaleTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.notifications.destroy_all
+    @bundle = Notification::Bundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    @user.notifications.create!(source: events(:logo_published), creator: users(:jz), unread_count: 1)
+  end
+
+  test "writes in the recipient's language, not the sender's" do
+    @user.identity.update! locale: "ja"
+
+    email = I18n.with_locale(:en) { Notification::BundleMailer.notification(@bundle).message }
+
+    assert_equal "Fizzy：新しい通知", email.subject
