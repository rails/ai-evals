+++ b/test/integration/error_pages_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+# Static error pages are served without knowing who is looking, so they speak both languages.
+class ErrorPagesTest < ActiveSupport::TestCase
+  PAGES = {
+    "400.html" => [ "Bad request", "不正なリクエスト" ],
+    "404.html" => [ "Sorry, that page doesn’t exist!", "お探しのページは見つかりませんでした" ],
+    "406-unsupported-browser.html" => [ "You need to upgrade your browser", "ブラウザのアップグレードが必要です" ],
+    "422.html" => [ "Unprocessable entity", "処理できないリクエスト" ],
+    "500.html" => [ "Internal server error", "サーバー内部エラー" ]
+  }
+
+  PAGES.each do |page, (english, japanese)|
+    test "#{page} speaks English and Japanese" do
+      html = Rails.public_path.join(page).read
+
+      assert_includes html, english
+      assert_includes html, japanese
+      assert_includes html, "Back home"
+      assert_includes html, "ホームに戻る"
+    end
+  end
+end
diff --git a/test/integration/japanese_test.rb b/test/integration/japanese_test.rb
new file mode 100644
index 0000000..fd1f29e
--- /dev/null
+++ b/test/integration/japanese_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+# A person who chose Japanese gets every screen in Japanese: nothing readable stays English.
+class JapaneseTest < ActionDispatch::IntegrationTest
+  ENGLISH_WORDS = /\b(?:Add|Back to|Cancel|Card|Delete|Done|Edit|Home|Notifications|Save|Search|Settings|Sign|Watch)\b/
+
+  setup do
+    sign_in_as :kevin
+    identities(:kevin).update! locale: "ja"
+    @board, @card = boards(:writebook), cards(:logo)
+  end
+
+  test "signed in screens" do
+    [
+      root_path, board_path(@board), edit_board_path(@board), new_board_path, cards_path, card_path(@card),
+      edit_card_path(@card), new_card_assignment_path(@card), new_card_tagging_path(@card), edit_card_column_path(@card),
+      edit_card_board_path(@card), card_watch_path(@card), card_pin_path(@card),
+      board_column_path(@board, columns(:writebook_in_progress)), board_columns_closed_path(@board),
+      board_columns_not_now_path(@board), board_columns_stream_path(@board),
+      notifications_path, notifications_settings_path, tray_notifications_path,
+      my_menu_path, my_pins_path, my_access_tokens_path, new_my_access_token_path, my_passkeys_path,
+      user_path(users(:kevin)), edit_user_path(users(:kevin)), user_events_path(users(:kevin)),
+      new_user_email_address_path(users(:kevin)),
+      account_settings_path, account_join_code_path, edit_account_join_code_path,
+      board_webhooks_path(@board), new_board_webhook_path(@board), board_webhook_path(@board, webhooks(:active)), edit_board_webhook_path(@board, webhooks(:active)),
+      search_path(q: "haggis"), events_day_timeline_column_path(:added, day: Date.current)
+    ].each do |path|
+      get path
+      assert_response :success, "#{path} should render"
+      assert_japanese path
+    end
+  end
+
+test "screens you don't need to sign in for" do
+  sign_out
+
+  untenanted do
+    get new_session_path(locale: "ja")
+    assert_japanese request.path
+
+    get new_signup_path
+    assert_japanese request.path
+
+    post session_path, params: { email_address: identities(:kevin).email_address }
+    get session_magic_link_path
+    assert_japanese request.path
+  end
+
+  get join_path(code: account_join_codes(:"37s").code)
+  assert_japanese request.path
+end
+
+  test "public boards" do
+    @board.publish
+    get published_board_path(@board)
+    assert_japanese published_board_path(@board)
+
+    get published_card_path(@card)
+    assert_japanese published_card_path(@card)
+  end
+
+  private
+    def assert_japanese(path)
+      assert_select "html[lang=ja]", 1, "#{path} should be marked as Japanese"
+      assert_no_match(/translation missing/i, response.body, "#{path} has missing translations")
+
+      text = Nokogiri::HTML5(response.body).at("body").text
+      assert_no_match ENGLISH_WORDS, text, "#{path} still speaks English"
+    end
+end
