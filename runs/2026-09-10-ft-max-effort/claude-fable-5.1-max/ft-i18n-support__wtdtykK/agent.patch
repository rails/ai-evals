diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..84ccc99
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,48 @@
+# Renders every request in the language the person chose. Opening any page with
+# ?locale=xx picks a language, which sticks to the browser session and, once
+# signed in, to the identity so it follows them to their next sign-in.
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_current_locale
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&)
+      remember_locale requested_locale if requested_locale
+      carry_locale_between_session_and_identity if Current.identity
+
+      I18n.with_locale(remembered_locale || I18n.default_locale, &)
+    end
+
+    def requested_locale
+      params[:locale].presence_in(available_locales)
+    end
+
+    def remember_locale(locale)
+      session[:locale] = locale
+      Current.identity&.update!(locale: locale)
+    end
+
+    # A choice made before signing in becomes the identity's; a choice made on another
+    # browser follows the identity here.
+    def carry_locale_between_session_and_identity
+      if Current.identity.locale.blank?
+        Current.identity.update!(locale: session[:locale]) if session[:locale]
+      elsif session[:locale] != Current.identity.locale
+        session[:locale] = Current.identity.locale
+      end
+    end
+
+    def remembered_locale
+      session[:locale].presence_in(available_locales)
+    end
+
+    def available_locales
+      I18n.available_locales.map(&:to_s)
+    end
+end
