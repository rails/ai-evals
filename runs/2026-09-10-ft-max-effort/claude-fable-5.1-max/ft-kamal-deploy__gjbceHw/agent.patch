new file mode 100644
index 0000000..5e377ef
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,26 @@
+# Secrets for config/deploy.yml. Kamal reads this file on your machine when you run bin/kamal and passes
+# the values to the container, so they never end up in the image or in the repository.
+#
+# Each value is read from your shell environment: export it before deploying, or put the values in a
+# .env file (gitignored) and load it with `set -a; source .env; set +a`. To read them from a password
+# manager instead, replace the right-hand sides with `kamal secrets fetch`, for example:
+#
+#   SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from Vault/Fizzy KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE SMTP_PASSWORD)
+#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+#
+# See https://kamal-deploy.org/docs/commands/secrets/ for the supported password managers.
+
+# Access token for the container registry named in config/deploy.yml.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Signs cookies, sessions, and other tokens. Generate one with `bin/rails secret` and keep it: changing it
+# signs everyone out.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for the SMTP server named in config/deploy.yml. Leave it unset if the server doesn't need one.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Key pair for browser push notifications. Optional: without it everything but push notifications works.
+# Generate it with `bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}", "VAPID_PRIVATE_KEY=#{k.private_key}"'`
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
