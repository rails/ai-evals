diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..f35ece3
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,97 @@
+# Deploy Fizzy to a single server with Kamal: https://kamal-deploy.org
+#
+# Everything runs in one container on one box. Puma serves the web requests and runs the Solid Queue
+# supervisor for background jobs, the SQLite databases and uploaded files live on a Docker volume,
+# and kamal-proxy terminates SSL with a certificate from Let's Encrypt.
+#
+# To deploy your fork: fill in the values marked "Fill in" below, export the secrets listed in
+# .kamal/secrets, and run `bin/kamal setup`. After that, `bin/kamal deploy` ships new versions.
+# See docs/deployment.md for the full walkthrough.
+
+service: fizzy
+
+# Fill in: the name of the container image. Kamal builds it locally and pushes it to the registry below.
+image: your-user/fizzy
+
+# Fill in: the server to deploy to, as an IP address or hostname that you can SSH into as root.
+# Kamal installs Docker if it isn't there yet. See `ssh` at the bottom to deploy as another user.
+servers:
+  web:
+    - 192.168.0.1
+
+# Fill in: the hostname Fizzy is served at. Its DNS must point to the server above, with ports 80 and 443
+# reachable from the internet, so kamal-proxy can get a certificate from Let's Encrypt and renew it.
+# The `&host` anchor reuses the same value for APP_HOST below.
+proxy:
+  ssl: true
+  host: &host fizzy.example.com
+
+# Fill in: credentials for the container registry. Docker Hub unless `server` is set.
+# The password comes from .kamal/secrets; use an access token rather than your real password.
+registry:
+  # server: ghcr.io
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Environment variables for the container. Secrets come from .kamal/secrets.
+env:
+  clear:
+    # Canonical host for links in emails, push notifications, and webhooks.
+    APP_HOST: *host
+
+    # Fill in: the SMTP server that delivers Fizzy's email. Sign-in codes arrive by email, so nobody can
+    # log in until this works. SMTP_PASSWORD comes from .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+
+    # SMTP_AUTHENTICATION: login    # Defaults to plain. Skipped when SMTP_USERNAME is not set.
+    # SMTP_TLS: true                # Connect over SMTPS (usually port 465) instead of upgrading with STARTTLS.
+    # SMTP_DOMAIN: fizzy.example.com # HELO domain. Defaults to APP_HOST.
+
+    # Puma workers and Solid Queue worker processes default to one per CPU. Turn them down on a small box.
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 1
+
+    # Background jobs run inside Puma. Set this to false and add a `job` role with `cmd: bin/jobs` to run
+    # them in their own container instead.
+    # SOLID_QUEUE_IN_PUMA: false
+
+    # Log everything from Rails.
+    # RAILS_LOG_LEVEL: debug
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The SQLite databases and uploaded files live in /rails/storage. Keeping that directory on a named
+# volume means the data survives deploys. Back it up: it is the only copy.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid hitting 404 on in-flight
+# requests during a deploy. Combines all files from the new and old version inside the asset_path.
+asset_path: /rails/public/assets
+
+# How long to wait for the container to become healthy before a deploy is called off. The first boot on a
+# small server also has to create the databases, so leave some room.
+deploy_timeout: 60
+
+# Build the image on your machine and push it to the registry. Match `arch` to the server's CPU.
+builder:
+  arch: amd64
+  # arch: arm64
+
+# Run these with `bin/kamal console`, `bin/kamal shell`, `bin/kamal logs`, and `bin/kamal dbc`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs --follow
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# Deploy as a user other than root. Docker must already be installed and the user must be in the docker group.
+# ssh:
+#   user: deploy
