diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..88a5caa
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,44 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, describeLocalTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(this.refresh.bind(this), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  timeTargetConnected(target) {
+    this.#render(target)
+  }
+
+  // Relative words go stale: "1:42 PM" turns into "yesterday" at midnight.
+  refresh() {
+    this.timeTargets.forEach(target => this.#render(target))
+  }
+
+  // Morphing puts back whatever the server sent, so redo the words.
+  morph({ target }) {
+    if (this.#isTimeTarget(target)) this.#render(target)
+  }
+
+  #render(target) {
+    const words = formatLocalTime(target)
+    const description = describeLocalTime(target)
+
+    if (target.textContent !== words) target.textContent = words
+    if (description && !target.title) target.title = description
+  }
+
+  #isTimeTarget(element) {
+    return element.matches(`[data-${this.identifier}-target~="time"]`)
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..1a32e7e
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,73 @@
+// Turns <time datetime="…" data-style="…"> tags rendered by TimeHelper#local_datetime_tag
+// into words in the viewer's own timezone.
+
+const LOCALE = "en-US"
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+
+const timeFormat = new Intl.DateTimeFormat(LOCALE, { hour: "numeric", minute: "2-digit" })
+const dateFormat = new Intl.DateTimeFormat(LOCALE, { month: "short", day: "numeric" })
+const fullDateFormat = new Intl.DateTimeFormat(LOCALE, { month: "short", day: "numeric", year: "numeric" })
+const weekdayFormat = new Intl.DateTimeFormat(LOCALE, { weekday: "long", month: "long", day: "numeric" })
+const datetimeFormat = new Intl.DateTimeFormat(LOCALE, { dateStyle: "short", timeStyle: "short" })
+const fullDatetimeFormat = new Intl.DateTimeFormat(LOCALE, { dateStyle: "full", timeStyle: "short" })
+const relativeDayFormat = new Intl.RelativeTimeFormat(LOCALE, { numeric: "auto" })
+
+const STYLES = {
+  time: date => timeFormat.format(date),              // 1:42 PM
+  date: (date, now) => formatDate(date, now),         // Sep 12
+  full_date: date => fullDateFormat.format(date),     // Sep 12, 2025
+  weekday: date => weekdayFormat.format(date),        // Friday, September 12
+  datetime: date => datetimeFormat.format(date),      // 9/12/25, 1:42 PM
+  relative: (date, now) => formatRelative(date, now)  // yesterday, in 3 days…
+}
+
+export function formatLocalTime(element, now = new Date()) {
+  const format = STYLES[element.dataset.style] || STYLES.date
+  return format(parseDatetime(element.dateTime), now)
+}
+
+// The exact moment, for hovering over relative words like "5 days ago".
+export function describeLocalTime(element) {
+  if (isInstant(element.dateTime)) {
+    return fullDatetimeFormat.format(parseDatetime(element.dateTime))
+  }
+}
+
+function formatDate(date, now) {
+  return date.getFullYear() === now.getFullYear() ? dateFormat.format(date) : fullDateFormat.format(date)
+}
+
+function formatRelative(date, now) {
+  const days = calendarDaysBetween(now, date)
+
+  if (days === 0 && date <= now) {
+    return timeFormat.format(date)                     // 1:42 PM
+  } else if (days > -7) {
+    return relativeDayFormat.format(days, "day")       // yesterday, 5 days ago, today, tomorrow, in 3 days
+  } else {
+    return formatDate(date, now)                       // Sep 12
+  }
+}
+
+function calendarDaysBetween(from, to) {
+  return Math.round((startOfDay(to) - startOfDay(from)) / DAY_IN_MILLISECONDS)
+}
+
+function startOfDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+// Whole dates ("2025-01-21") are calendar days rather than instants, so build
+// them in local time instead of letting Date assume midnight UTC.
+function parseDatetime(string) {
+  if (isInstant(string)) {
+    return new Date(string)
+  } else {
+    const [ year, month, day ] = string.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  }
+}
+
+function isInstant(string) {
+  return string.includes("T")
+}
