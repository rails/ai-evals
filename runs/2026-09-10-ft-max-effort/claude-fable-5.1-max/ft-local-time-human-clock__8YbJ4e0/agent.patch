diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..2f87b92 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,27 @@
 module TimeHelper
+  # Renders a <time> tag that the browser turns into words in the viewer's own
+  # timezone (see local_time_controller.js), so the HTML is the same for everyone
+  # and can be cached and shared.
+  #
+  # Styles:
+  #
+  #   :time       1:42 PM
+  #   :date       Sep 12 (or Sep 12, 2024 when it's not this year)
+  #   :full_date  Sep 12, 2025
+  #   :weekday    Friday, September 12
+  #   :datetime   9/12/25, 1:42 PM
+  #   :relative   1:42 PM, yesterday, 5 days ago, Sep 12, today, tomorrow, in 3 days
+  def local_datetime_tag(datetime, style: :date, **attributes)
+    css_class = token_list("local-time-value", attributes.delete(:class))
+
+    tag.time **attributes, class: css_class, datetime: local_datetime_attribute(datetime),
+      data: { local_time_target: "time", style: style }
+  end
+
+  private
+    # Whole dates stay dates, so the browser doesn't shift them across midnight;
+    # instants are normalized to UTC so the tag doesn't depend on Time.zone.
+    def local_datetime_attribute(datetime)
+      datetime.acts_like?(:time) ? datetime.utc.iso8601 : datetime.iso8601
+    end
 end
