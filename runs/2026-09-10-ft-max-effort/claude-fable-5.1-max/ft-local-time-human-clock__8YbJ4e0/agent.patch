diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..98c64d3
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag leaves the words to the browser" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_dom_equal <<~HTML.strip, local_datetime_tag(time, style: :relative)
+      <time class="local-time-value" datetime="2025-09-12T13:42:00Z" data-local-time-target="time" data-style="relative"></time>
+    HTML
+  end
+
+  test "local_datetime_tag renders the same HTML whatever the timezone" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    in_utc = Time.use_zone("UTC") { local_datetime_tag(time.in_time_zone) }
+    in_tokyo = Time.use_zone("Asia/Tokyo") { local_datetime_tag(time.in_time_zone) }
+
+    assert_equal in_utc, in_tokyo
+    assert_match 'datetime="2025-09-12T13:42:00Z"', in_tokyo
+  end
+
+  test "local_datetime_tag keeps whole dates as dates" do
+    assert_match 'datetime="2025-01-21"', local_datetime_tag(Date.new(2025, 1, 21), style: :weekday)
+  end
+
+  test "local_datetime_tag defaults to the date style and takes extra attributes" do
+    tag = local_datetime_tag(Time.current, class: "card__timestamp", id: "stamp")
+
+    assert_select Nokogiri::HTML::DocumentFragment.parse(tag), "time#stamp.local-time-value.card__timestamp[data-style=date]"
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..ed8ac93
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,124 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:david)
+    @card = cards(:logo)
+  end
+
+  test "comments are put into words in the viewer's timezone" do
+    earlier_today = comment_created 2.hours.ago
+    yesterday = comment_created 1.day.ago
+    this_week = comment_created 5.days.ago
+    last_month = comment_created 30.days.ago
+    last_year = comment_created 400.days.ago
+
+    # Around noon, so a comment from a couple of hours ago is still today
+    browse_in_timezone zone_where_it_is_currently(hour: 12)
+    visit card_url(@card)
+
+    assert_comment_time earlier_today, in_viewer_timezone(earlier_today.created_at, "%-l:%M %p")
+    assert_comment_time yesterday, "yesterday"
+    assert_comment_time this_week, "5 days ago"
+    assert_comment_time last_month, date_words(last_month.created_at)
+    assert_comment_time last_year, date_words(last_year.created_at)
+
+    # Shortly after midnight, the same comment from a couple of hours ago was yesterday
+    browse_in_timezone zone_where_it_is_currently(hour: 0)
+    visit card_url(@card)
+
+    assert_comment_time earlier_today, "yesterday"
+  end
+
+  test "cards say when they were added and when they'll move to not now" do
+    browse_in_timezone zone_where_it_is_currently(hour: 12)
+
+    @card.update! last_active_at: 1.day.from_now - @card.auto_postpone_period
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(@card, :meta)} .card__meta-text--added", text: /Added #{date_words(@card.created_at)}/i
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+    @card.update! last_active_at: 3.days.from_now - @card.auto_postpone_period
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” in 3 days if there’s no activity."
+  end
+
+  test "words survive a page morph" do
+    comment = comment_created 1.day.ago
+    visit card_url(@card)
+    assert_comment_time comment, "yesterday"
+
+    Current.user = users(:david)
+    @card.update! title: "Morphed title"
+    page.execute_script "Turbo.session.refresh(location.href)"
+
+    assert_selector ".card__title-link", text: "Morphed title"
+    assert_comment_time comment, "yesterday"
+  end
+
+  test "timeline days are calendar dates that don't shift with the timezone" do
+    browse_in_timezone zone_where_it_is_currently(hour: 0)
+    Current.user = users(:david)
+    event = comment_created(1.hour.ago).events.last
+
+    visit events_url # Sets the timezone cookie the server groups events by
+    visit events_url
+
+    today = Time.now.in_time_zone(@timezone)
+    assert_selector "time[datetime='#{today.to_date.iso8601}']", text: normalized(today.strftime("%A, %B %-d")), minimum: 3
+    assert_selector ".events__time-block time", text: normalized(in_viewer_timezone(event.created_at, "%-l:%M %p"))
+  end
+
+  test "the server sends raw UTC timestamps and the browser fills in every one" do
+    visit card_url(@card)
+
+    assert_selector "time[data-local-time-target=time][datetime$='Z']", minimum: 5
+    assert page.evaluate_script(<<~JS), "Expected every <time> to have been put into words"
+      Array.from(document.querySelectorAll("time[data-local-time-target]")).every(time => time.textContent.trim() !== "")
+    JS
+  end
+
+  private
+    def comment_created(time)
+      @card.comments.create! creator: users(:david), body: "Comment from #{time}", created_at: time
+    end
+
+    def assert_comment_time(comment, words)
+      assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: normalized(words)
+    end
+
+    def in_viewer_timezone(time, format)
+      time.in_time_zone(@timezone).strftime(format)
+    end
+
+    # The year is only spelled out when it isn't this one
+    def date_words(time)
+      this_year = time.in_time_zone(@timezone).year == Time.now.in_time_zone(@timezone).year
+      in_viewer_timezone(time, this_year ? "%b %-d" : "%b %-d, %Y")
+    end
+
+    # Intl separates the meridian with a narrow no-break space
+    def normalized(words)
+      /\A#{words.split(" ").map { Regexp.escape(it) }.join("[[:space:]]")}\z/i
+    end
+
+    # A fixed-offset zone in which the current local time has the given hour
+    def zone_where_it_is_currently(hour:)
+      offset = hour - Time.now.utc.hour
+      offset += 24 if offset < -11
+      offset -= 24 if offset > 12
+
+      case offset <=> 0
+      when 0 then "Etc/GMT"
+      when 1 then "Etc/GMT-#{offset}" # POSIX offsets have inverted signs
+      else "Etc/GMT+#{-offset}"
+      end
+    end
+
+    def browse_in_timezone(name)
+      @timezone = ActiveSupport::TimeZone[name]
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: name)
+    end
+end
