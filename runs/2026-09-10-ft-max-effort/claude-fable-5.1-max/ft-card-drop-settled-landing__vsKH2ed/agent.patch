diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..4dc8ed6
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,143 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves items (cards) between containers (columns) with native drag and drop.
+//
+// Containers say where to send dropped items with a `data-drag-and-drop-url` template,
+// where `:card_id` stands for the item's `data-card-id`, and an optional
+// `data-drag-and-drop-method` (POST by default).
+//
+// Items are moved in the DOM as soon as they are dropped, so the board is already in
+// its final shape before the response comes back to refresh the affected columns.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem = null
+  #hoverContainer = null
+
+  dragStart(event) {
+    const item = this.#itemFor(event.target)
+    if (!item) return
+
+    this.#draggedItem = item
+    this.#prepareDataTransfer(event, item)
+    this.#dimOnceDragImageIsCaptured(item)
+  }
+
+  dragOver(event) {
+    const container = this.#dropTargetFor(event.target)
+    this.#hover(container)
+
+    if (container) {
+      event.preventDefault()
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.element.contains(event.relatedTarget)) {
+      this.#hover(null)
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const container = this.#dropTargetFor(event.target)
+
+    if (container) {
+      event.preventDefault()
+      this.#finishDragging()
+      this.#move(item, container)
+    }
+  }
+
+  dragEnd() {
+    this.#finishDragging()
+  }
+
+  // Private
+
+  #itemFor(element) {
+    return element.closest(`[data-${this.identifier}-target~="item"]`)
+  }
+
+  #dropTargetFor(element) {
+    const container = element.closest(`[data-${this.identifier}-target~="container"]`)
+    return container && this.#acceptsDraggedItem(container) ? container : null
+  }
+
+  // Items can be moved to any container but the one they are in
+  #acceptsDraggedItem(container) {
+    return this.#draggedItem && !container.contains(this.#draggedItem)
+  }
+
+  #prepareDataTransfer({ dataTransfer, clientX, clientY }, item) {
+    if (!dataTransfer) return
+
+    const { left, top } = item.getBoundingClientRect()
+
+    dataTransfer.effectAllowed = "move"
+    dataTransfer.setData("text/plain", item.id) // Firefox won't start dragging without data
+    dataTransfer.setDragImage(item, clientX - left, clientY - top) // Drag the whole item, even when grabbed by an image or link
+  }
+
+  // Wait for the browser to capture the drag image, so it isn't dimmed too
+  async #dimOnceDragImageIsCaptured(item) {
+    await nextFrame()
+
+    if (this.#draggedItem === item) {
+      item.classList.add(this.draggedItemClass)
+    }
+  }
+
+  #hover(container) {
+    if (container === this.#hoverContainer) return
+
+    this.#hoverContainer?.classList.remove(this.hoverContainerClass)
+    container?.classList.add(this.hoverContainerClass)
+    this.#hoverContainer = container
+  }
+
+  #finishDragging() {
+    this.#hover(null)
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+  }
+
+  #move(item, container) {
+    this.#insert(item, container)
+    this.#save(item, container)
+  }
+
+  // Moved cards become the most recently active, so they land at the top of their new
+  // column. Columns that keep golden cards first only let other cards land right below
+  // them. Matching the server's ordering means nothing shifts once the column is refreshed.
+  #insert(item, container) {
+    const items = this.itemTargets.filter(other => container.contains(other))
+    const anchor = items.find(other => !this.#outranks(other, item, container))
+
+    if (anchor) {
+      anchor.before(item)
+    } else if (items.length) {
+      items.at(-1).after(item)
+    } else {
+      container.querySelector(".cards__list")?.prepend(item)
+    }
+  }
+
+  #outranks(other, item, container) {
+    return container.dataset.dragAndDropGoldenFirst === "true" && this.#isGolden(other) && !this.#isGolden(item)
+  }
+
+  #isGolden(item) {
+    return item.classList.contains("golden-effect")
+  }
+
+  #save(item, container) {
+    const { dragAndDropUrl: url, dragAndDropMethod: method = "post" } = container.dataset
+    const request = new FetchRequest(method, url.replace(":card_id", item.dataset.cardId), { responseKind: "turbo-stream" })
+
+    request.perform()
+  }
+}
