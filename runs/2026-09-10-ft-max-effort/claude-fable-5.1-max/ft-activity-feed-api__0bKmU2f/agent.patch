@@ -0,0 +1,141 @@
+# Activities
+
+Activities are the events that make up an account's activity timeline: cards being added, assigned, moved, renamed, closed, and commented on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity on the boards you have access to, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `board_ids[]` | Filter by board ID(s) |
+| `creator_ids[]` | Filter by the ID(s) of the users who performed the activity |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David assigned Jason to &quot;First!&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a8"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 4,
+      "title": "First!",
+      "status": "published",
+      "description": "Hello, World!",
+      "description_html": "<div class=\"action-text-content\"><p>Hello, World!</p></div>",
+      "image_url": null,
+      "has_attachments": false,
+      "tags": ["programming"],
+      "closed": false,
+      "postponed": false,
+      "golden": false,
+      "last_active_at": "2025-12-05T19:38:48.553Z",
+      "created_at": "2025-12-05T19:38:48.540Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+      "board": {
+        "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+        "name": "Fizzy",
+        "all_access": true,
+        "created_at": "2025-12-05T19:36:35.534Z",
+        "auto_postpone_period_in_days": 30,
+        "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm",
+        "creator": {
+          "id": "03f5v9zjw7pz8717a4no1h8a7",
+          "name": "David Heinemeier Hansson",
+          "role": "owner",
+          "active": true,
+          "email_address": "david@example.com",
+          "created_at": "2025-12-05T19:36:35.401Z",
+          "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+        }
+      },
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David Heinemeier Hansson",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+      },
+      "assignees": [
+        {
+          "id": "03f5v9zjw7pz8717a4no1h8a8",
+          "name": "Jason Fried",
+          "role": "owner",
+          "active": true,
+          "email_address": "jason@example.com",
+          "created_at": "2025-12-05T19:36:35.401Z",
+          "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a8"
+        }
+      ],
+      "has_more_assignees": false,
+      "comments_url": "http://app.fizzy.localhost:3006/897362094/cards/4/comments",
+      "reactions_url": "http://app.fizzy.localhost:3006/897362094/cards/4/reactions"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm",
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David Heinemeier Hansson",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+      }
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+### Actions
+
+`action` is one of:
+`card_published`, `card_assigned`, `card_unassigned`, `card_closed`, `card_reopened`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, `card_board_changed`, `card_title_changed`, `comment_created`
+
+`description` is a plain-text sentence describing the activity from the point of view of the current user, as shown in the activity timeline. It is HTML-escaped, so it is safe to embed in HTML.
+
+### Eventable
+
+`eventable_type` is either `Card` or `Comment`, and `eventable` is the matching [card](cards.md) or [comment](comments.md).
+
+For card activity, `url` opens the card. For comment activity, it opens the card where the comment was posted and jumps to the comment.
+
+### Particulars
+
+`particulars` holds the details specific to each kind of activity:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` — the IDs of the users who were assigned or unassigned |
+| `card_board_changed` | `old_board`, `new_board` — the names of the boards the card was moved from and to |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` — the name of the column the card was moved into |
+
+All other actions have empty `particulars`. Board, title, and column values that are unavailable are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..ee15b94
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,194 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal Event.where(board: users(:kevin).boards).count, @response.parsed_body.size
+  end
+
+  test "index as JSON includes event attributes" do
+    get activities_path, as: :json
+
+    event = events(:layout_assignment_jz)
+    activity = find_activity(event)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.as_json, activity["created_at"]
+    assert_equal %(David assigned JZ to &quot;Layout is broken&quot;), activity["description"]
+    assert_equal card_url(cards(:layout)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity.dig("eventable", "id")
+    assert_equal cards(:layout).number, activity.dig("eventable", "number")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+  end
+
+  test "index as JSON renders comment events with the comment and a link to it on the card" do
+    get activities_path, as: :json
+
+    activity = find_activity(events(:layout_commented))
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.card_id, activity.dig("eventable", "card", "id")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_includes activity["description"], "David commented on"
+  end
+
+  test "index as JSON describes events from the current user's perspective" do
+    get activities_path, as: :json
+
+    event = events(:logo_assignment_km)
+
+    assert_equal event.description_for(users(:kevin)).to_plain_text, find_activity(event)["description"]
+    assert_includes find_activity(event)["description"], "David will handle"
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.map { |activity| Time.zone.parse(activity["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index as JSON exposes assignee ids for assignment events" do
+    get activities_path, as: :json
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, find_activity(events(:layout_assignment_jz))["particulars"])
+  end
+
+  test "index as JSON exposes boards for board change events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old", "new_board" => "New" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, find_activity(event)["particulars"])
+  end
+
+  test "index as JSON exposes titles for title change events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Before", "new_title" => "After" } })
+
+    get activities_path, as: :json
+
+    activity = find_activity(event)
+    assert_equal({ "old_title" => "Before", "new_title" => "After" }, activity["particulars"])
+    assert_includes activity["description"], "renamed"
+  end
+
+  test "index as JSON exposes the column for triage events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "column" => "In progress" }, find_activity(event)["particulars"])
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    board_changed, title_changed, triaged = events(:logo_published), events(:layout_published), events(:text_published)
+    board_changed.update_columns(action: "card_board_changed", particulars: {})
+    title_changed.update_columns(action: "card_title_changed", particulars: {})
+    triaged.update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, find_activity(board_changed)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, find_activity(title_changed)["particulars"])
+    assert_equal({ "column" => "" }, find_activity(triaged)["particulars"])
+  end
+
+  test "index as JSON returns empty particulars for other events" do
+    get activities_path, as: :json
+
+    assert_equal({}, find_activity(events(:logo_published))["particulars"])
+    assert_equal({}, find_activity(events(:shipping_closed))["particulars"])
+    assert_equal({}, find_activity(events(:layout_commented))["particulars"])
+    assert_equal({}, find_activity(events(:buy_domain_sent_back_to_triage))["particulars"])
+  end
+
+  test "index as JSON omits deprecated collection change events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_collection_changed", particulars: { "particulars" => { "new_collection" => "New" } })
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_nil find_activity(event)
+  end
+
+  test "index as JSON can filter by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert_equal Event.where(creator: users(:kevin)).count, @response.parsed_body.size
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index as JSON can filter by board" do
+    event = publish_card_in(boards(:private))
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "index as JSON only returns activity on accessible boards" do
+    event = publish_card_in(boards(:private))
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.pluck("id"), event.id
+
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+  end
+
+  test "index as JSON is paginated" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal Event.where(board: users(:kevin).boards).count.to_s, @response.headers["X-Total-Count"]
+    assert_nil @response.headers["Link"]
+
+    get activities_path(page: 2), as: :json
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index as JSON with an access token" do
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:jasons_api_token).token}" }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+  end
+
+  private
+    def find_activity(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+
+    def publish_card_in(board)
+      with_current_user(:kevin) do
+        board.cards.create!(title: "Secret", status: "published").events.sole
+      end
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
