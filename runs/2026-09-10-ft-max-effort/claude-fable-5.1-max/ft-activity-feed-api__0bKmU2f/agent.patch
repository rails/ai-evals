+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "activities are the timelineable events on accessible boards, newest first" do
+    activities = @user.activities_for(filter)
+
+    assert_equal Event.where(board: @user.boards).count, activities.count
+    assert_equal activities.sort_by { |event| [ event.created_at, event.id ] }.reverse, activities.to_a
+    assert_equal events(:layout_assignment_jz), activities.first
+  end
+
+  test "activities exclude events on inaccessible boards" do
+    event = publish_card_in(boards(:private))
+
+    assert_includes @user.activities_for(filter), event
+    assert_not_includes users(:david).activities_for(filter(user: users(:david))), event
+  end
+
+  test "activities exclude deprecated collection change events but include title changes" do
+    collection_changed, title_changed = events(:logo_published), events(:layout_published)
+    collection_changed.update_columns(action: "card_collection_changed")
+    title_changed.update_columns(action: "card_title_changed")
+
+    activities = @user.activities_for(filter)
+
+    assert_not_includes activities, collection_changed
+    assert_includes activities, title_changed
+  end
+
+  test "activities can be filtered by boards" do
+    event = publish_card_in(boards(:private))
+
+    assert_equal [ event ], @user.activities_for(filter(board_ids: [ boards(:private).id ])).to_a
+  end
+
+  test "activities can be filtered by creators" do
+    activities = @user.activities_for(filter(creator_ids: [ users(:david).id ]))
+
+    assert activities.any?
+    assert activities.all? { |event| event.creator == users(:david) }
+  end
+
+  private
+    def filter(user: @user, **params)
+      user.filters.from_params(params)
+    end
+
+    def publish_card_in(board)
+      with_current_user(:kevin) do
+        board.cards.create!(title: "Secret", status: "published").events.sole
+      end
+    end
+end
