@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "relevant particulars for assignment events" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).relevant_particulars)
+
+    event = events(:logo_assignment_jz)
+    event.update_columns(action: "card_unassigned")
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.relevant_particulars)
+  end
+
+  test "relevant particulars for board change events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } })
+
+    assert_equal({ old_board: "Writebook", new_board: "Private board" }, event.relevant_particulars)
+  end
+
+  test "relevant particulars for title change events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Before", "new_title" => "After" } })
+
+    assert_equal({ old_title: "Before", new_title: "After" }, event.relevant_particulars)
+  end
+
+  test "relevant particulars for triage events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+
+    assert_equal({ column: "In progress" }, event.relevant_particulars)
+  end
+
+  test "relevant particulars are empty strings when missing" do
+    event = events(:logo_published)
+
+    event.update_columns(action: "card_board_changed", particulars: {})
+    assert_equal({ old_board: "", new_board: "" }, event.relevant_particulars)
+
+    event.update_columns(action: "card_title_changed", particulars: {})
+    assert_equal({ old_title: "", new_title: "" }, event.relevant_particulars)
+
+    event.update_columns(action: "card_triaged", particulars: {})
+    assert_equal({ column: "" }, event.relevant_particulars)
+
+    event.update_columns(action: "card_assigned", particulars: {})
+    assert_equal({ assignee_ids: [] }, event.relevant_particulars)
+  end
+
+  test "relevant particulars are empty for other events" do
+    assert_equal({}, events(:logo_published).relevant_particulars)
+    assert_equal({}, events(:shipping_closed).relevant_particulars)
