+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "create" do
+    sign_in_as :kevin
+
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "create as JSON" do
+    sign_in_as :kevin
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal public_board_url(@board.public_key, script_name: nil), @response.parsed_body["public_url"]
+  end
+
+  test "destroy" do
+    sign_in_as :kevin
+    @board.publish
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "destroy as JSON" do
+    sign_in_as :kevin
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "owners can publish boards too" do
+    sign_in_as :jason
+    @board.accesses.grant_to users(:jason)
+
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "non-admins can't publish boards" do
+    sign_in_as :david
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admins can't unpublish boards" do
+    sign_in_as :david
+    @board.publish
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "admins can't publish boards they don't have access to" do
+    sign_in_as :kevin
+    board = boards(:private)
+    board.accesses.revoke_from users(:kevin)
+
+    post board_publication_path(board)
+
+    assert_response :not_found
+    assert_not board.reload.published?
+  end
+end
