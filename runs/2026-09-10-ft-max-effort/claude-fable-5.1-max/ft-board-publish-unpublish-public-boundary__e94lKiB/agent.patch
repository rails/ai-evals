@@ -0,0 +1,36 @@
+<div class="margin-block-end">
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <p class="margin-none-block-start">Anyone with this link can see this board and its cards without signing in. They can’t make any changes.</p>
+
+    <% url = public_board_url_for(board) %>
+    <div class="flex align-center gap-half margin-block">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" aria-label="Public link" readonly>
+
+      <%= button_to_copy_to_clipboard(url) do %>
+        <%= icon_tag "copy-paste" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <% if Current.user.admin? %>
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative borderless txt-small", form_class: "flex justify-center",
+            form: { data: { turbo_confirm: "Are you sure you want to unpublish this board? The public link will stop working." } } do %>
+        <%= icon_tag "lock" %>
+        <span>Unpublish this board</span>
+      <% end %>
+    <% end %>
+  <% else %>
+    <p class="margin-none-block-start">This board is only visible to the people who have access to it. Publishing it creates a secret link that anyone can use to see the board and its cards, without being able to make changes.</p>
+
+    <% if Current.user.admin? %>
+      <%= button_to board_publication_path(board), method: :post, class: "btn btn--link", form_class: "flex justify-center" do %>
+        <%= icon_tag "globe" %>
+        <span>Publish this board</span>
+      <% end %>
+    <% else %>
+      <p class="margin-none txt-small txt-subtle">Only admins can publish a board.</p>
+    <% end %>
+  <% end %>
+</div>
