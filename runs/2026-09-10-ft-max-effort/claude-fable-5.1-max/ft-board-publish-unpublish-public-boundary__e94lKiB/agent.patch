+    @board.publish
+
+    assert_no_changes -> { @board.reload.public_key } do
+      @board.publish
+    end
+  end
+
+  test "unpublishing removes the key, so the old link stops working after republishing" do
+    @board.publish
+    old_key = @board.public_key
+
+    @board.unpublish
+    assert_not @board.published?
+    assert_nil @board.public_key
+
+    @board.publish
+    assert_not_equal old_key, @board.public_key
+  end
+
+  test "published cards on a published board are publicly accessible" do
+    card = cards(:logo)
+    assert_not card.publicly_accessible?
+    assert_not comments(:logo_1).publicly_accessible?
+
+    @board.publish
+
+    assert card.reload.publicly_accessible?
+    assert comments(:logo_1).reload.publicly_accessible?
+
+    card.update_column :status, "drafted"
+    assert_not card.reload.publicly_accessible?
+  end
+
+  test "publishing touches the cards, so their cached representations get refreshed" do
+    assert_changes -> { @board.cards.first.reload.updated_at } do
+      @board.publish
+    end
+  end
+end
