diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..2a63d4d
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,25 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def publish
+    update! public_key: SecureRandom.base58(PUBLIC_KEY_LENGTH) unless published?
+  end
+
+  def unpublish
+    update! public_key: nil
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+end
