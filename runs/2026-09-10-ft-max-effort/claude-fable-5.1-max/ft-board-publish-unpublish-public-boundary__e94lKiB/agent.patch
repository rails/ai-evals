+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.json { head :no_content }
+    end
+  end
+end
diff --git a/app/controllers/concerns/public_board_scoped.rb b/app/controllers/concerns/public_board_scoped.rb
new file mode 100644
index 0000000..e323297
--- /dev/null
+++ b/app/controllers/concerns/public_board_scoped.rb
@@ -0,0 +1,28 @@
+# Published boards can be seen by anyone who knows their secret key, whether the
+# request is tenanted or not: the board found by that key sets the current account.
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    skip_before_action :require_account
+
+    before_action :set_board, :ensure_account_is_active
+
+    layout "public"
+  end
+
+  private
+    def set_board
+      @board = Board.published.find_by!(public_key: board_key)
+      Current.account = @board.account
+    end
+
+    def board_key
+      params[:board_key]
+    end
+
+    def ensure_account_is_active
+      head :not_found unless Current.account.active?
+    end
+end
