@@ -0,0 +1,60 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @settings = @user.settings
+  end
+
+  test "bundle emails are off by default" do
+    assert_equal "never", @settings.bundle_email_frequency
+    assert @settings.bundle_email_never?
+    assert_not @settings.bundle_emails?
+    assert_nil @settings.bundle_email_interval
+  end
+
+  test "each frequency maps to how long a window stays open" do
+    { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, interval|
+      @settings.update!(bundle_email_frequency: frequency)
+
+      assert @settings.bundle_emails?
+      assert_equal interval, @settings.bundle_email_interval
+    end
+  end
+
+  test "only the known frequencies are valid" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+    assert_includes @settings.errors[:bundle_email_frequency], "is not included in the list"
+  end
+
+  test "changing the frequency refits the pending window" do
+    @settings.update!(bundle_email_frequency: :weekly)
+    bundle = Notification::Bundle.current_for(@user)
+
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    assert_equal bundle.starts_at + 4.hours, bundle.reload.ends_at
+  end
+
+  test "turning emails off drops the pending window" do
+    @settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.current_for(@user)
+
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_not Notification::Bundle.exists?(bundle.id)
+  end
+
+  test "changing the frequency leaves delivered windows alone" do
+    @settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.current_for(@user)
+    bundle.update!(delivered_at: Time.current)
+
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert Notification::Bundle.exists?(bundle.id)
+    assert_equal bundle.starts_at + 1.day, bundle.reload.ends_at
+  end
+end
