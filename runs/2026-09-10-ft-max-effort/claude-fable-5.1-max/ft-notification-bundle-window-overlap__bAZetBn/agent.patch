diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..5bf959c
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,223 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "current_for opens a window when there is none, with the clock starting now" do
+    freeze_time do
+      bundle = Notification::Bundle.current_for(@user)
+
+      assert bundle.persisted?
+      assert bundle.pending?
+      assert_equal @user, bundle.user
+      assert_equal @user.account, bundle.account
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 1.day.from_now, bundle.ends_at
+    end
+  end
+
+  test "current_for sizes the window by the user's frequency" do
+    freeze_time do
+      @user.settings.update!(bundle_email_frequency: :every_few_hours)
+      assert_equal 4.hours.from_now, Notification::Bundle.current_for(@user).ends_at
+
+      @user.notification_bundles.destroy_all
+      @user.settings.update!(bundle_email_frequency: :weekly)
+      assert_equal 1.week.from_now, Notification::Bundle.current_for(@user).ends_at
+    end
+  end
+
+  test "current_for returns the pending window while it is open" do
+    bundle = Notification::Bundle.current_for(@user)
+
+    travel 2.hours do
+      assert_equal bundle, Notification::Bundle.current_for(@user)
+    end
+  end
+
+  test "current_for keeps returning a closed window until it has been delivered" do
+    bundle = Notification::Bundle.current_for(@user)
+
+    travel 25.hours do
+      assert bundle.due?
+      assert_equal bundle, Notification::Bundle.current_for(@user)
+    end
+  end
+
+  test "current_for opens a new window once the previous one was delivered" do
+    first = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, first.id
+
+    travel 25.hours do
+      first.deliver
+
+      second = Notification::Bundle.current_for(@user)
+
+      assert_not_equal first, second
+      assert_equal Time.current, second.starts_at
+    end
+  end
+
+  test "windows never overlap" do
+    first = Notification::Bundle.current_for(@user)
+    first.update!(delivered_at: Time.current)
+
+    travel 2.hours do
+      second = Notification::Bundle.current_for(@user)
+
+      assert_not first.window.overlap?(second.window)
+      assert_equal first.ends_at, second.starts_at
+      assert_equal first.ends_at + 1.day, second.ends_at
+    end
+  end
+
+  test "due includes only pending windows that have closed" do
+    closed = Notification::Bundle.current_for(@user)
+
+    travel 25.hours do
+      open = Notification::Bundle.create!(user: users(:david), starts_at: Time.current, ends_at: 1.day.from_now)
+      delivered = Notification::Bundle.create!(user: users(:jz), starts_at: 2.days.ago, ends_at: 1.day.ago, delivered_at: 1.day.ago)
+
+      assert_equal [ closed ], Notification::Bundle.due.to_a
+      assert_not_includes Notification::Bundle.due, open
+      assert_not_includes Notification::Bundle.due, delivered
+    end
+  end
+
+  test "deliver emails the bundle once and marks it delivered" do
+    bundle = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, bundle.id
+
+    freeze_time do
+      assert_enqueued_emails 1 do
+        bundle.deliver
+      end
+
+      assert bundle.delivered?
+      assert_equal Time.current, bundle.delivered_at
+
+      assert_no_enqueued_emails do
+        bundle.deliver
+      end
+    end
+  end
+
+  test "deliver emails only once even when two deliveries race" do
+    bundle = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, bundle.id
+    stale_copy = Notification::Bundle.find(bundle.id)
+
+    assert_enqueued_emails 1 do
+      bundle.deliver
+      stale_copy.deliver
+    end
+  end
+
+  test "deliver skips the email when there is nothing to send" do
+    bundle = Notification::Bundle.current_for(@user)
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.delivered?
+  end
+
+  test "deliver skips the email when emails have been turned off in the meantime" do
+    bundle = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, bundle.id
+    @user.settings.update_column :bundle_email_frequency, "never"
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.delivered?
+  end
+
+  test "deliver skips the email for deactivated users" do
+    bundle = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, bundle.id
+    @user.deactivate
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.delivered?
+  end
+
+  test "deliver_later enqueues a delivery job" do
+    bundle = Notification::Bundle.current_for(@user)
+
+    assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ bundle ]) do
+      bundle.deliver_later
+    end
+  end
+
+  test "deliver_all_due delivers due windows in their account's context" do
+    due = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, due.id
+    still_open = Notification::Bundle.create!(user: users(:david), starts_at: Time.current, ends_at: 2.days.from_now)
+
+    travel 25.hours do
+      Current.without_account do
+        assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ due ]) do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+
+      assert_emails 1 do
+        perform_enqueued_jobs only: [ Notification::Bundle::DeliveryJob, ActionMailer::MailDeliveryJob ]
+      end
+
+      assert due.reload.delivered?
+      assert still_open.reload.pending?
+      assert_match %r{href="http://example.com#{@user.account.slug}/notifications/settings"}, ActionMailer::Base.deliveries.last.html_part.body.decoded
+    end
+  end
+
+  test "refit resizes a pending window to the user's frequency" do
+    bundle = Notification::Bundle.current_for(@user)
+    @user.settings.update_column :bundle_email_frequency, "every_few_hours"
+
+    bundle.refit
+
+    assert_equal bundle.starts_at + 4.hours, bundle.reload.ends_at
+  end
+
+  test "refit drops a pending window when emails are turned off" do
+    bundle = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, bundle.id
+    @user.settings.update_column :bundle_email_frequency, "never"
+
+    bundle.refit
+
+    assert_not Notification::Bundle.exists?(bundle.id)
+    assert_nil @notification.reload.bundle
+  end
+
+  test "destroying a bundle leaves its notifications in place" do
+    bundle = Notification::Bundle.current_for(@user)
+    @notification.update_column :bundle_id, bundle.id
+
+    bundle.destroy
+
+    assert Notification.exists?(@notification.id)
+    assert_nil @notification.reload.bundle_id
+  end
+
+  test "destroying a user destroys their bundles" do
+    bundle = Notification::Bundle.current_for(@user)
+
+    @user.destroy
+
+    assert_not Notification::Bundle.exists?(bundle.id)
+  end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
new file mode 100644
index 0000000..92673fa
--- /dev/null
+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "bundle_later enqueues Notification::BundleJob" do
+    assert_enqueued_with(job: Notification::BundleJob, args: [ @notification ]) do
+      @notification.bundle_later
+    end
+  end
+
+  test "bundle_later is called after notification is created" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @user.notifications.create!(source: events(:shipping_closed), creator: users(:david))
+    end
+  end
+
+  test "bundle_later is called when notification source changes" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "bundle_later is not called for other updates" do
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.read
+    end
+  end
+
+  test "bundle_now opens a window for the user and files the notification into it" do
+    assert_difference -> { @user.notification_bundles.count }, +1 do
+      @notification.bundle_now
+    end
+
+    bundle = @notification.reload.bundle
+    assert bundle.pending?
+    assert_equal @user, bundle.user
+    assert_equal [ @notification ], bundle.notifications.to_a
+  end
+
+  test "bundle_now files notifications landing in the same window together" do
+    other = notifications(:buy_domain_sent_back_to_triage_kevin)
+
+    @notification.bundle_now
+    travel 3.hours do
+      other.bundle_now
+    end
+
+    assert_equal @notification.reload.bundle, other.reload.bundle
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "bundle_now files late notifications into the window that has already opened" do
+    other = notifications(:buy_domain_sent_back_to_triage_kevin)
+
+    @notification.bundle_now
+    travel 25.hours do
+      other.bundle_now
+    end
+
+    assert_equal @notification.reload.bundle, other.reload.bundle
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "bundle_now leaves a notification that is already waiting in a pending window alone" do
+    @notification.bundle_now
+    bundle = @notification.reload.bundle
+
+    assert_no_difference -> { @user.notification_bundles.count } do
+      @notification.update!(source: events(:logo_published))
+      @notification.bundle_now
+    end
+
+    assert_equal bundle, @notification.reload.bundle
+  end
+
+  test "bundle_now moves a notification that lands again after its window was delivered" do
+    @notification.bundle_now
+    first = @notification.reload.bundle
+
+    travel 25.hours do
+      first.deliver
+      @notification.update!(source: events(:logo_published))
+      @notification.bundle_now
+    end
+
+    second = @notification.reload.bundle
+    assert_not_equal first, second
+    assert second.pending?
+    assert_empty first.notifications
+  end
+
+  test "bundle_now does not touch the notification's timestamps or broadcast" do
+    updated_at = @notification.updated_at
+
+    assert_no_turbo_stream_broadcasts [ @user, :notifications ] do
+      @notification.bundle_now
+    end
+
+    assert_equal updated_at, @notification.reload.updated_at
+  end
+
+  test "bundle_now does nothing when emails are off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+
+    assert_nil @notification.reload.bundle
+  end
+
+  test "bundle_now does nothing for users without settings" do
+    @user.settings.destroy
+    @user.reload
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+  end
+
+  test "bundle_now does nothing when the creator is the system user" do
+    @notification.update!(creator: users(:system))
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+  end
+
+  test "bundle_now does nothing for deactivated users" do
+    @user.deactivate
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+  end
+
+  test "bundle_now does nothing for cancelled accounts" do
+    @user.account.cancel(initiated_by: users(:jason))
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+  end
+
+  test "Notification::BundleJob bundles the notification" do
+    perform_enqueued_jobs only: Notification::BundleJob do
+      @notification.bundle_later
+    end
+
+    assert @notification.reload.bundle.present?
+  end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
