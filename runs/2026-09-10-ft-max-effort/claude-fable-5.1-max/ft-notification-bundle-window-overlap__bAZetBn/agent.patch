+<h1 class="title"><%= pluralize @notifications.size, "new notification" %> in <%= @bundle.account.name %></h1>
+<p class="subtitle">Here’s what happened since <%= @bundle.starts_at.to_fs(:short) %>.</p>
+
+<% @notifications_by_board.each_with_index do |(board, notifications), index| %>
+  <% if index > 0 %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification">
+      <tr>
+        <td class="avatar__container"><%= mail_avatar_tag notification.creator, size: 40 %></td>
+        <td>
+          <h3 class="card__title"><%= link_to payload.title, payload.url %></h3>
+          <p class="notification__details"><%= payload.body %></p>
+          <p class="notification__author"><%= notification.creator.name %> · <%= notification.source.created_at.to_fs(:short) %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  You’re getting this email because you asked for your notifications to be bundled up <%= bundle_email_frequency_name(@user.settings.bundle_email_frequency).downcase %>.
+  <%= link_to "Change how often you get these emails", notifications_settings_url %>.
+</p>
