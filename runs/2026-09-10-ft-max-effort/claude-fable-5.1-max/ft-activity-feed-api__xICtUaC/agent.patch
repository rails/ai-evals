+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "activities are the accessible events shown in the timeline, newest first" do
+    activities = @user.activities_for(filter_with)
+
+    assert_includes activities, events(:layout_assignment_jz)
+    assert_includes activities, events(:layout_commented)
+    assert_includes activities, events(:shipping_closed)
+    assert_equal activities.sort_by { |event| [ event.created_at, event.id ] }.reverse, activities.to_a
+  end
+
+  test "activities include title changes but not deprecated collection changes" do
+    title_changed = track_event "card_title_changed", particulars: { old_title: "Old", new_title: "New" }
+    collection_changed = track_event "card_collection_changed", particulars: { new_collection: "Private board" }
+
+    activities = @user.activities_for(filter_with)
+
+    assert_includes activities, title_changed
+    assert_not_includes activities, collection_changed
+  end
+
+  test "activities only include events from accessible boards" do
+    private_event = track_event "card_closed", board: boards(:private), eventable: cards(:logo)
+
+    assert_includes @user.activities_for(filter_with), private_event
+    assert_not_includes users(:jz).activities_for(filter_with(creator: users(:jz))), private_event
+  end
+
+  test "activities can be filtered by creators and boards" do
+    private_event = track_event "card_closed", board: boards(:private), eventable: cards(:logo)
+
+    by_creator = @user.activities_for(filter_with(creator_ids: [ users(:kevin).id ]))
+    assert by_creator.any?
+    assert_equal [ users(:kevin) ], by_creator.map(&:creator).uniq
+
+    by_board = @user.activities_for(filter_with(board_ids: [ boards(:private).id ]))
+    assert_equal [ private_event ], by_board.to_a
+  end
+
+  private
+    def filter_with(creator: @user, **params)
+      creator.filters.from_params(params)
+    end
+
+    def track_event(action, board: boards(:writebook), eventable: cards(:logo), particulars: nil)
+      board.events.create! action: action, creator: users(:david), eventable: eventable, particulars: { particulars: particulars }.compact
+    end
+end
