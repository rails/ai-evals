diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..8ce084d
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,179 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected = users(:kevin).accessible_events.where(action: User::Timelined::ACTIVITY_ACTIONS).reverse_chronologically
+    assert_equal expected.count, @response.parsed_body.count
+    assert_equal expected.pluck(:id), @response.parsed_body.pluck("id")
+  end
+
+  test "index as JSON includes activity attributes" do
+    event = events(:layout_assignment_jz)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "David assigned JZ to"
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    assert_equal card_url(cards(:layout)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity.dig("eventable", "id")
+    assert_equal cards(:layout).number, activity.dig("eventable", "number")
+    assert_equal cards(:layout).title, activity.dig("eventable", "title")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+  end
+
+  test "index as JSON includes comment activities pointing at the comment on its card" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal comment.card.id, activity.dig("eventable", "card", "id")
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index as JSON exposes event particulars" do
+    board_changed = track_event_on_logo "card_board_changed", particulars: { old_board: "Writebook", new_board: "Private board" }
+    title_changed = track_event_on_logo "card_title_changed", particulars: { old_title: "Old title", new_title: "New title" }
+    triaged = track_event_on_logo "card_triaged", particulars: { column: "In progress" }
+    closed = track_event_on_logo "card_closed"
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, particulars_for(board_changed))
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, particulars_for(title_changed))
+    assert_equal({ "column" => "In progress" }, particulars_for(triaged))
+    assert_equal({}, particulars_for(closed))
+    assert_equal({}, particulars_for(events(:buy_domain_sent_back_to_triage)))
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    board_changed = track_event_on_logo "card_board_changed"
+    title_changed = track_event_on_logo "card_title_changed"
+    triaged = track_event_on_logo "card_triaged"
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, particulars_for(board_changed))
+    assert_equal({ "old_title" => "", "new_title" => "" }, particulars_for(title_changed))
+    assert_equal({ "column" => "" }, particulars_for(triaged))
+  end
+
+  test "index as JSON includes title changes but not deprecated collection changes" do
+    title_changed = track_event_on_logo "card_title_changed", particulars: { old_title: "Old title", new_title: "New title" }
+    collection_changed = track_event_on_logo "card_collection_changed", particulars: { new_collection: "Private board" }
+
+    get activities_path, as: :json
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, title_changed.id
+    assert_not_includes ids, collection_changed.id
+  end
+
+  test "index as JSON filtered by creators" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.where(creator: users(:kevin)).count, @response.parsed_body.count
+    assert_equal [ users(:kevin).id ], @response.parsed_body.map { |a| a.dig("creator", "id") }.uniq
+  end
+
+  test "index as JSON filtered by boards" do
+    private_event = track_event_on_private_board
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path(board_ids: [ boards(:writebook).id ]), as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { |a| a.dig("board", "id") }.uniq
+  end
+
+  test "index as JSON only includes activity from accessible boards" do
+    private_event = track_event_on_private_board
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+
+    logout_and_sign_in_as :jz
+
