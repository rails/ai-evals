--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,23 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(event.assignee_ids) }
+    when "card_board_changed"
+      nested_particulars_for(event, :old_board, :new_board)
+    when "card_title_changed"
+      nested_particulars_for(event, :old_title, :new_title)
+    when "card_triaged"
+      nested_particulars_for(event, :column)
+    else
+      {}
+    end
+  end
+
+  private
+    # Card events store the details passed to track_event under a nested "particulars" key
+    def nested_particulars_for(event, *keys)
+      particulars = event.particulars.dig("particulars") || {}
+      keys.index_with { |key| particulars[key.to_s].to_s }
+    end
+end
