diff --git a/app/views/sessions/magic_links/new.html.erb b/app/views/sessions/magic_links/new.html.erb
new file mode 100644
index 0000000..adbf9c3
--- /dev/null
+++ b/app/views/sessions/magic_links/new.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex justify-center">
+      <%= form.text_field :code, class: "input", autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+            maxlength: MagicLink::CODE_LENGTH, placeholder: "Code", autofocus: true, required: true, aria: { label: "Sign-in code" } %>
+    </div>
+
+    <% if @magic_link %>
+      <p>We sent a <%= MagicLink::CODE_LENGTH %>-character code to <strong><%= @magic_link.identity.email_address %></strong>. Enter it here to continue.</p>
+    <% else %>
+      <p>We sent a <%= MagicLink::CODE_LENGTH %>-character code to your email address. Enter it here to continue.</p>
+    <% end %>
+
+    <% if Rails.env.development? && @magic_link %>
+      <p class="txt-small txt-subtle">Psst, here’s your code: <strong><%= @magic_link.code %></strong></p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small margin-block-start">
+    Didn’t get it? Check your spam folder, or <%= link_to "start over", new_session_path, class: "txt-link" %>.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
