new file mode 100644
index 0000000..818de99
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "new" do
+    untenanted do
+      request_code_for @identity
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_in_body @identity.email_address
+    end
+  end
+
+  test "new without a pending code still asks for one" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_not_in_body @identity.email_address
+    end
+  end
+
+  test "new redirects authenticated users" do
+    sign_in_as @identity
+
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "create signs in with the right code" do
+    untenanted do
+      code = request_code_for(@identity)
+
+      assert_difference -> { @identity.sessions.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+      assert_empty @identity.magic_links
+    end
+  end
+
+  test "create is forgiving about how the code is typed" do
+    untenanted do
+      code = request_code_for(@identity)
+
+      post session_magic_link_path, params: { code: " #{code[0, 3].downcase} #{code[3, 3]} " }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create returns to where the person was headed" do
+    get cards_path
+    assert_response :redirect
+
+    untenanted do
+      code = request_code_for(@identity)
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to cards_url(script_name: accounts("37s").slug)
+    end
+  end
+
+  test "create with the wrong code" do
+    untenanted do
+      request_code_for @identity
+
+      assert_no_difference -> { @identity.sessions.count } do
+        post session_magic_link_path, params: { code: "WRONG1" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+      assert_equal 1, @identity.magic_links.count, "A wrong guess shouldn't burn the code"
+    end
+  end
+
+  test "create with an expired code" do
+    untenanted do
+      code = request_code_for(@identity)
+
+      travel MagicLink::EXPIRY_DURATION + 1.second do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with a code that is still good after a while" do
+    untenanted do
+      code = request_code_for(@identity)
+
+      travel MagicLink::EXPIRY_DURATION - 1.minute do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create without having asked for a code" do
+    magic_link = @identity.magic_links.create!
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create with someone else's pending code" do
+    untenanted do
+      code = request_code_for(@identity)
+      request_code_for identities(:david)
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create can't reuse a code" do
+    untenanted do
+      code = request_code_for(@identity)
+      token = cookies[:pending_authentication_token]
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to landing_path
+
+      sign_out
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+      code = @identity.magic_links.last.code
+
+      post session_magic_link_path(format: :json), params: { code: code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+      assert_equal cookies[:session_token], @response.parsed_body["session_token"]
+    end
+  end
+
+  test "create via JSON with the wrong code" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+
+      post session_magic_link_path(format: :json), params: { code: "WRONG1" }
+
+      assert_response :unauthorized
+      assert_equal "That code didn't work. Try again.", @response.parsed_body["message"]
+    end
+  end
+
+  test "create is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: "ABCDEF" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  private
+    def request_code_for(identity)
+      post session_path, params: { email_address: identity.email_address }
+      identity.magic_links.last.code
+    end
+end
