diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..108a911
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @magic_link = @identity.magic_links.create!
+  end
+
+  test "codes are six unambiguous characters" do
+    assert_equal MagicLink::CODE_LENGTH, @magic_link.code.length
+    assert_match /\A[#{MagicLink::CODE_ALPHABET.join}]+\z/, @magic_link.code
+    assert_no_match /[01IO]/, @magic_link.code
+  end
+
+  test "each link gets its own code" do
+    another = @identity.magic_links.create!
+
+    assert_not_equal @magic_link.code, another.code
+  end
+
+  test "consume with the right code destroys the link and returns the identity" do
+    assert_equal @identity, @magic_link.consume(@magic_link.code)
+    assert_not MagicLink.exists?(@magic_link.id)
+  end
+
+  test "consume ignores case, whitespace and dashes" do
+    code = @magic_link.code
+
+    assert_equal @identity, @magic_link.consume(" #{code[0, 3].downcase}-#{code[3, 3]} ")
+  end
+
+  test "consume with the wrong code keeps the link" do
+    assert_nil @magic_link.consume("NOPE")
+    assert_nil @magic_link.consume(nil)
+    assert_nil @magic_link.consume("")
+    assert MagicLink.exists?(@magic_link.id)
+  end
+
+  test "consume with an expired code keeps the link" do
+    travel MagicLink::EXPIRY_DURATION + 1.second do
+      assert_predicate @magic_link, :expired?
+      assert_nil @magic_link.consume(@magic_link.code)
+    end
+
+    assert MagicLink.exists?(@magic_link.id)
+  end
+
+  test "codes work for fifteen minutes" do
+    assert_equal 15.minutes, MagicLink::EXPIRY_DURATION
+
+    travel 14.minutes do
+      assert_predicate @magic_link, :active?
+      assert_includes MagicLink.active, @magic_link
+      assert_not_includes MagicLink.expired, @magic_link
+    end
+
+    travel 16.minutes do
+      assert_not_predicate @magic_link, :active?
+      assert_not_includes MagicLink.active, @magic_link
+      assert_includes MagicLink.expired, @magic_link
+    end
+  end
+
+  test "pending authentication token finds the link" do
+    token = @magic_link.pending_authentication_token
+
+    assert_equal @magic_link, MagicLink.find_by_pending_authentication_token(token)
+    assert_nil MagicLink.find_by_pending_authentication_token("nonsense")
+    assert_nil MagicLink.find_by_pending_authentication_token(nil)
+    assert_nil MagicLink.find_by_pending_authentication_token(@magic_link.signed_id(purpose: :something_else))
+  end
+
+  test "pending authentication token expires with the code" do
+    token = @magic_link.pending_authentication_token
+
+    travel MagicLink::EXPIRY_DURATION + 1.second do
+      assert_nil MagicLink.find_by_pending_authentication_token(token)
+    end
+  end
+
+  test "cleanup removes expired links" do
+    expired = @identity.magic_links.create!
+    expired.update_column :created_at, (MagicLink::EXPIRY_DURATION + 1.minute).ago
+
+    assert_difference -> { MagicLink.count }, -1 do
+      MagicLink.cleanup
+    end
+
+    assert MagicLink.exists?(@magic_link.id)
+    assert_not MagicLink.exists?(expired.id)
+  end
+
+  test "destroying an identity destroys its links" do
+    assert_difference -> { MagicLink.count }, -1 do
+      @identity.destroy!
+    end
+  end
+end
