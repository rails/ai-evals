diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..c4de1a9
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,55 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_ALPHABET = %w[ 2 3 4 5 6 7 8 9 A B C D E F G H J K L M N P Q R S T U V W X Y Z ].freeze # No 0/O or 1/I to mix up
+  EXPIRY_DURATION = 15.minutes
+
+  belongs_to :identity
+
+  scope :active, -> { where(created_at: EXPIRY_DURATION.ago..) }
+  scope :expired, -> { where(created_at: ...EXPIRY_DURATION.ago) }
+
+  before_create :generate_code
+
+  class << self
+    def find_by_pending_authentication_token(token)
+      find_signed(token, purpose: :pending_authentication)
+    end
+
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: :pending_authentication, expires_in: EXPIRY_DURATION)
+  end
+
+  # Codes are single-use: a matching code destroys the link and hands back its identity.
+  def consume(entered_code)
+    if active? && matches?(entered_code)
+      destroy
+      identity
+    end
+  end
+
+  def active?
+    created_at.after?(EXPIRY_DURATION.ago)
+  end
+
+  def expired?
+    !active?
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH, chars: CODE_ALPHABET)
+    end
+
+    def matches?(entered_code)
+      ActiveSupport::SecurityUtils.secure_compare(code, normalize(entered_code))
+    end
+
+    def normalize(entered_code)
+      entered_code.to_s.gsub(/[\s-]/, "").upcase
+    end
+end
