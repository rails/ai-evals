diff --git a/app/controllers/concerns/pending_authentication.rb b/app/controllers/concerns/pending_authentication.rb
new file mode 100644
index 0000000..223055e
--- /dev/null
+++ b/app/controllers/concerns/pending_authentication.rb
@@ -0,0 +1,32 @@
+# Signing in by email happens in two steps: a code is emailed to the identity, and the browser
+# holds a token tying it to that code until the person enters it. The token travels as a cookie,
+# so that a code on its own is not enough to get in.
+module PendingAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def start_pending_authentication_for(identity, return_to: nil)
+      magic_link = identity.send_magic_link
+
+      cookies[:pending_authentication_token] = {
+        value: magic_link.pending_authentication_token,
+        expires: MagicLink::EXPIRY_DURATION.from_now,
+        httponly: true,
+        same_site: :lax
+      }
+
+      session[:return_to_after_authenticating] = return_to if return_to
+    end
+
+    def pending_magic_link
+      MagicLink.find_by_pending_authentication_token(pending_authentication_token)
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def finish_pending_authentication
+      cookies.delete :pending_authentication_token
+    end
+end
