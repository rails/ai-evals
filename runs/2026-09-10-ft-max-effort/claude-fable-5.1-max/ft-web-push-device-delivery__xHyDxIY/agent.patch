diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..e618e39
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @notification = notifications(:layout_commented_kevin)
+
+    subscribe_to_push @kevin, endpoint: "https://push.example.com/subscriptions/kevin-desktop"
+    subscribe_to_push @kevin, endpoint: "https://push.example.com/subscriptions/kevin-phone"
+  end
+
+  test "landing in the tray pushes to the user's devices" do
+    @notification.destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "landing in the tray again with a new source pushes again" do
+    assert_enqueued_with job: Notification::PushJob, args: [ @notification ] do
+      @notification.update!(source: events(:layout_assignment_jz), read_at: nil, unread_count: @notification.unread_count + 1)
+    end
+  end
+
+  test "reading and unreading don't push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "nothing to push without subscribed devices" do
+    @kevin.push_subscriptions.destroy_all
+    @notification.destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "nothing to push without a VAPID key pair" do
+    @notification.destroy
+    PushSubscription.stubs(:enabled?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "push says what the tray says and opens the card" do
+    comment = events(:layout_commented).eventable
+    pushes = capture_pushes { @notification.push_now }
+
+    assert_equal @kevin.push_subscriptions.pluck(:endpoint).sort, pushes.map { |push| push[:endpoint] }.sort
+
+    pushes.each do |push|
+      assert_equal "RE: #{cards(:layout).title}", push[:payload]["title"]
+      assert_equal comment.body.to_plain_text.truncate(200), push[:payload]["body"]
+      assert_equal "#{@kevin.account.slug}/cards/#{cards(:layout).number}#comment_#{comment.id}", push[:payload]["path"]
+      assert_equal "notification_#{@notification.id}", push[:payload]["tag"]
+      assert_equal "high", push[:urgency]
+      assert_equal PushSubscription.vapid.public_key, push[:vapid][:public_key]
+    end
+  end
+
+  test "push for a mention" do
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/subscriptions/david", p256dh_key: "p256dh", auth_key: "auth")
+
+    push = capture_pushes { notification.push_now }.sole
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", push[:payload]["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), push[:payload]["body"]
+    assert_equal "#{@kevin.account.slug}/cards/#{cards(:logo).number}#comment_#{mention.source.id}", push[:payload]["path"]
+  end
+
+  test "no push once it's been read in the meantime" do
+    @notification.read
+
+    assert_empty capture_pushes { @notification.push_now }
+  end
+
+  test "the job performs the push within the account" do
+    pushes = capture_pushes do
+      perform_enqueued_jobs only: Notification::PushJob do
+        @notification.push_later
+      end
+    end
+
+    assert_equal 2, pushes.size
+    assert pushes.all? { |push| push[:payload]["path"].start_with?("#{@kevin.account.slug}/") }
+  end
+
+  private
+    def capture_pushes
+      pushes = []
+      WebPush.stubs(:payload_send).with { |**options| pushes << options.merge(payload: JSON.parse(options[:message])); true }
+      yield
+      pushes
+    end
+end
