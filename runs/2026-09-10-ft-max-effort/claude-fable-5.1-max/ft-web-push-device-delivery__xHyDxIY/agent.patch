+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+
+    @params = { push_subscription: {
+      endpoint: "https://push.example.com/subscriptions/david-laptop",
+      p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+      auth_key: "tBHItJI5svbpez7KI4CCXg"
+    } }
+  end
+
+  test "create registers this device for the user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @params, as: :json, headers: { "User-Agent" => "Mozilla/5.0 Chrome/131.0.0.0" }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal @params[:push_subscription][:endpoint], subscription.endpoint
+    assert_equal @params[:push_subscription][:p256dh_key], subscription.p256dh_key
+    assert_equal @params[:push_subscription][:auth_key], subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal Session.last, subscription.session
+    assert_equal "Mozilla/5.0 Chrome/131.0.0.0", subscription.user_agent
+  end
+
+  test "create is idempotent for a device that's already registered" do
+    post user_push_subscriptions_path(@user), params: @params, as: :json
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: @params, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create rejects an endpoint that isn't https" do
+    @params[:push_subscription][:endpoint] = "http://push.example.com/insecure"
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: @params, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires the subscription" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: "" }, as: :json
+
+    assert_response :bad_request
+  end
+
+  test "create is forbidden for other users" do
