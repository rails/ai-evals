diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..931ab60 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,37 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Push notifications: show what the tray shows, and open the card it's about when tapped
+self.addEventListener("push", (event) => {
+  if (event.data) {
+    event.waitUntil(showNotification(event.data.json()))
+  }
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openPath(event.notification.data?.path))
+})
+
+async function showNotification({ title, body, path, tag }) {
+  await self.registration.showNotification(title, {
+    body: body,
+    tag: tag,
+    renotify: true,
+    icon: "/app-icon-192.png",
+    data: { path: path }
+  })
+}
+
+async function openPath(path) {
+  const url = new URL(path || "/", self.location.origin).href
+  const [ client ] = await self.clients.matchAll({ type: "window" })
+
+  if (client?.navigate) {
+    await client.focus()
+    await client.navigate(url)
+  } else {
+    await self.clients.openWindow(url)
+  }
+}
