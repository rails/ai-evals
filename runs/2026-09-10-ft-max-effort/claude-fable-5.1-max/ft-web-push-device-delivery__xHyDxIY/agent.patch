diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..cf5e41f
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,25 @@
+# Web push notifications identify this server to the browsers' push services with a VAPID key pair.
+# Ops provide it via VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY (generate one with `bin/rails web_push:vapid_key`);
+# without one, push notifications stay off. Development and test make do with a throwaway pair kept in tmp/.
+Rails.application.configure do
+  config.x.vapid.subject = ENV.fetch("VAPID_SUBJECT") do
+    from_address = ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")
+    "mailto:#{from_address[/<([^>]+)>/, 1] || from_address}"
+  end
+
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+
+  if Rails.env.local? && config.x.vapid.private_key.blank?
+    path = Rails.root.join("tmp/vapid_key.pem")
+
+    key = if path.exist?
+      WebPush::VapidKey.from_pem(path.read)
+    else
+      WebPush.generate_key.tap { |generated| path.write(generated.to_pem) }
+    end
+
+    config.x.vapid.public_key = key.public_key
+    config.x.vapid.private_key = key.private_key
+  end
+end
