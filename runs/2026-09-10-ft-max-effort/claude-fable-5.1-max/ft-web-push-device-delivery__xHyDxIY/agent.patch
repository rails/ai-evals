diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..77cd14b
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = subscribe_to_push(users(:kevin))
+  end
+
+  test "enabled when a VAPID key pair is configured" do
+    assert PushSubscription.enabled?
+
+    PushSubscription.stubs(:vapid).returns(ActiveSupport::OrderedOptions.new)
+    assert_not PushSubscription.enabled?
+  end
+
+  test "endpoint must be an https URL" do
+    subscription = users(:kevin).push_subscriptions.new(endpoint: "http://push.example.com/insecure", p256dh_key: "p256dh", auth_key: "auth")
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be an https URL"
+
+    subscription.endpoint = "not a url"
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://push.example.com/subscriptions/new"
+    assert subscription.valid?
+  end
+
+  test "requires the subscription keys" do
+    subscription = users(:kevin).push_subscriptions.new(endpoint: "https://push.example.com/subscriptions/new")
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "belongs to the user's account" do
+    assert_equal users(:kevin).account, @subscription.account
+  end
+
+  test "deliver sends an encrypted, VAPID-signed, high urgency push to the endpoint" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+    @subscription.deliver({ title: "Hello", body: "World" }.to_json)
+
+    assert_requested :post, @subscription.endpoint do |request|
+      request.headers["Authorization"].start_with?("vapid t=") &&
+        request.headers["Content-Encoding"] == "aes128gcm" &&
+        request.headers["Urgency"] == "high" &&
+        request.body.present?
+    end
+  end
+
+  test "deliver drops a subscription the push service says is gone" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.deliver("{}")
+    end
+
+    assert_not PushSubscription.exists?(@subscription.id)
+  end
+
+  test "deliver drops a subscription the push service doesn't know" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 404)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.deliver("{}")
+    end
+  end
+
+  test "deliver raises on other push service failures and keeps the subscription" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 500)
+
+    assert_no_difference -> { PushSubscription.count } do
+      assert_raises WebPush::PushServiceError do
+        @subscription.deliver("{}")
+      end
+    end
+  end
+
+  test "destroyed along with the user" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      users(:kevin).destroy
+    end
+  end
+
+  test "destroyed along with the session it was turned on from" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.session.destroy
+    end
+  end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..a8685ca
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,112 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  teardown do
+    forget_the_fake_push_service
+    page.driver.browser.execute_cdp("Browser.resetPermissions")
+  end
+
+  test "offering to turn push notifications on for this device" do
+    visit notifications_settings_url
+
+    within "[data-controller=notifications]" do
+      assert_text "Push notifications are off on this device."
+      assert_button "Turn on"
+      assert_no_text "Push notifications are on for this device."
+      assert_no_text "Notifications are blocked for Fizzy."
+    end
+  end
+
+  test "turning push notifications on registers this device" do
+    set_notification_permission "granted"
+    subscribe_with_a_fake_push_service endpoint: "https://push.example.com/subscriptions/system-test"
+
+    visit notifications_settings_url
+    wait_for_notifications_controller
+
+    within "[data-controller=notifications]" do
+      click_on "Turn on"
+
+      assert_text "Push notifications are on for this device."
+      assert_no_text "Push notifications are off on this device."
+    end
+
+    subscription = @user.push_subscriptions.find_by!(endpoint: "https://push.example.com/subscriptions/system-test")
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.identity.sessions.last, subscription.session
+  end
+
+  test "a device that's already on is recognized as such" do
+    set_notification_permission "granted"
+    subscribe_with_a_fake_push_service endpoint: "https://push.example.com/subscriptions/system-test", existing: true
+
+    visit notifications_settings_url
+
+    within "[data-controller=notifications]" do
+      assert_text "Push notifications are on for this device."
+      assert_no_text "Push notifications are off on this device."
+    end
+
+    assert @user.push_subscriptions.exists?(endpoint: "https://push.example.com/subscriptions/system-test")
+  end
+
+  test "explaining how to allow blocked notifications" do
+    set_notification_permission "denied"
+
+    visit notifications_settings_url
+
+    within "[data-controller=notifications]" do
+      assert_text "Push notifications are off on this device."
+      assert_text "Notifications are blocked for Fizzy."
+      assert_text "Turn on notifications for this website."
+      assert_no_text "Push notifications are on for this device."
+    end
+
+    assert_empty @user.push_subscriptions
+  end
+
+  private
+    def sign_in_as(user)
+      visit session_transfer_url(user.identity.transfer_id, script_name: nil)
+      assert_current_path root_path
+    end
+
+    def set_notification_permission(setting)
+      page.driver.browser.execute_cdp("Browser.setPermission", origin: page.server_url, permission: { name: "notifications" }, setting: setting)
+    end
+
+    # Subscribing with a real push service needs the outside world; stand one in at the browser's edge
+    def subscribe_with_a_fake_push_service(endpoint:, existing: false)
+      @fake_push_service = page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+        const subscription = {
+          endpoint: #{endpoint.to_json},
+          toJSON() { return { endpoint: this.endpoint, keys: { p256dh: "p256dh-key", auth: "auth-key" } } },
+          async unsubscribe() { return true }
+        }
+        PushManager.prototype.subscribe = async () => subscription
+        PushManager.prototype.getSubscription = async () => #{existing ? "subscription" : "null"}
+      JS
+    end
+
+    def forget_the_fake_push_service
+      if @fake_push_service
+        page.driver.browser.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @fake_push_service["identifier"])
+      end
+    end
+
+    def wait_for_notifications_controller
+      element = find("[data-controller=notifications]")
+
+      page.document.synchronize do
+        unless page.evaluate_script("!!Stimulus.getControllerForElementAndIdentifier(arguments[0], 'notifications')", element)
+          raise Capybara::ElementNotFound, "The notifications controller hasn't connected"
+        end
+      end
+    end
+end
