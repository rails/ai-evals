@@ -0,0 +1,24 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions.find_or_initialize_by(push_subscription_params)
+      .update!(session: Current.session, user_agent: request.user_agent)
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..2bebb22
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,105 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns push notifications on for this device: asks for permission, subscribes the service worker
+// with the browser's push service, and registers that subscription with Fizzy.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "prompt", "unsupported", "details" ]
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+
+  async connect() {
+    if (this.#supported) {
+      if (Notification.permission === "denied") {
+        this.#revealDetails()
+      } else if (Notification.permission === "granted" && await this.#existingSubscription()) {
+        await this.#subscribe()
+      }
+    } else {
+      this.#revealUnsupported()
+    }
+  }
+
+  async subscribe() {
+    if (!this.#supported) return
+
+    if (Notification.permission === "default") {
+      await Notification.requestPermission()
+    }
+
+    if (Notification.permission === "granted") {
+      await this.#subscribe()
+    } else if (Notification.permission === "denied") {
+      this.#revealDetails()
+    }
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "Notification" in window && "PushManager" in window
+  }
+
+  async #existingSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #subscribe() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await this.#subscribeWithPushService(registration)
+      await this.#register(subscription)
+    } catch (error) {
+      console.error("Couldn't turn on push notifications", error)
+      this.#revealDetails()
+    }
+  }
+
+  async #subscribeWithPushService(registration) {
+    const options = { userVisibleOnly: true, applicationServerKey: this.#applicationServerKey }
+
+    try {
+      return await registration.pushManager.subscribe(options)
+    } catch (error) {
+      // A subscription made with a previous VAPID key has to be replaced, not reused
+      if (error.name === "InvalidStateError") {
+        await (await registration.pushManager.getSubscription())?.unsubscribe()
+        return await registration.pushManager.subscribe(options)
+      } else {
+        throw error
+      }
+    }
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      this.element.classList.add(this.onClass)
+      this.#hideDetails()
+    } else {
+      await subscription.unsubscribe()
+    }
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+
+  #revealDetails() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+  }
+
+  #revealUnsupported() {
+    this.promptTarget.hidden = true
+    this.unsupportedTarget.hidden = false
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
index 0000000..0ce51e8
--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,11 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Push services hiccup like mailservers do: patiently retry the transient failures.
+  retry_on Net::OpenTimeout, Net::ReadTimeout, Socket::ResolutionError, wait: :polynomially_longer
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, wait: :polynomially_longer
+
+  def perform(notification)
+    notification.push_now
+  end
+end
