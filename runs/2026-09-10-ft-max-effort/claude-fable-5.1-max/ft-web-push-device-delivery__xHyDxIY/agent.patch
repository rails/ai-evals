new file mode 100644
index 0000000..bd11660
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,26 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    # Landing in the tray, whether for the first time or with a fresh source, is what reaches the devices
+    after_save_commit :push_later, if: :source_id_previously_changed?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if PushSubscription.enabled? && user.push_subscriptions.any?
+  end
+
+  def push_now
+    unless read?
+      message = push_message
+      user.push_subscriptions.each { |subscription| subscription.deliver(message) }
+    end
+  end
+
+  private
+    # Says what the tray says, and points to the card it's about
+    def push_message
+      ApplicationController.renderer.new(script_name: account.slug)
+        .render(layout: false, template: "notifications/push", assigns: { notification: self }, formats: :json)
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..dda2b93
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,39 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+
+  class << self
+    def enabled?
+      vapid.public_key.present? && vapid.private_key.present?
+    end
+
+    def vapid
+      Rails.configuration.x.vapid
+    end
+  end
+
+  def deliver(message)
+    WebPush.payload_send \
+      message: message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid.to_h,
+      urgency: "high"
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def validate_endpoint
+      unless URI.parse(endpoint.presence).is_a?(URI::HTTPS)
+        errors.add :endpoint, "must be an https URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "not a URL"
+    end
+end
