new file mode 100644
index 0000000..3ea5d8b
--- /dev/null
+++ b/test/test_helpers/push_subscription_test_helper.rb
@@ -0,0 +1,10 @@
+module PushSubscriptionTestHelper
+  # Push payloads are encrypted for the subscriber, so registering a device takes real client keys
+  def subscribe_to_push(user, endpoint: "https://push.example.com/subscriptions/#{SecureRandom.hex(8)}")
+    user.push_subscriptions.create! \
+      endpoint: endpoint,
+      p256dh_key: WebPush.encode64(OpenSSL::PKey::EC.generate("prime256v1").public_key.to_bn.to_s(2)),
+      auth_key: WebPush.encode64(SecureRandom.random_bytes(16)),
+      session: user.identity.sessions.first
+  end
+end
