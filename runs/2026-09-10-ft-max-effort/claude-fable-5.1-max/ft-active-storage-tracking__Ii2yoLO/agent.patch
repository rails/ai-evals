@@ -0,0 +1,80 @@
+require "test_helper"
+
+class ActiveStorageAttachmentStorageTrackingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+  end
+
+  test "card images belong to the card's board" do
+    cards(:logo).image.attach(upload_file)
+
+    assert_equal @board, cards(:logo).image.attachment.board
+  end
+
+  test "files embedded in card descriptions belong to the card's board" do
+    cards(:logo).update!(description: embed(upload_file))
+
+    assert_equal @board, cards(:logo).description.embeds.sole.board
+  end
+
+  test "files embedded in comments belong to the card's board" do
+    comment = cards(:logo).comments.create!(body: embed(upload_file))
+
+    assert_equal @board, comment.body.embeds.sole.board
+  end
+
+  test "files embedded in board descriptions belong to the board" do
+    @board.update!(public_description: embed(upload_file))
+
+    assert_equal @board, @board.public_description.embeds.sole.board
+  end
+
+  test "files that aren't on a board don't belong to one" do
+    users(:david).avatar.attach(upload_file)
+
+    assert_nil users(:david).avatar.attachment.board
+  end
+
+  test "attaching a file schedules a recalculation for its board" do
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      cards(:logo).image.attach(upload_file)
+    end
+  end
+
+  test "attaching a file that isn't on a board doesn't schedule anything" do
+    assert_no_enqueued_jobs only: Board::RecalculateBytesUsedJob do
+      users(:david).avatar.attach(upload_file)
+    end
+  end
+
+  test "destroying an attachment schedules a recalculation for its board" do
+    cards(:logo).image.attach(upload_file)
+
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      cards(:logo).image.attachment.destroy
+    end
+  end
+
+  test "purging an attachment schedules a recalculation for its board" do
+    cards(:logo).image.attach(upload_file)
+
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      cards(:logo).image.purge
+    end
+
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      cards(:layout).image.attach(upload_file)
+      cards(:layout).image.purge_later
+    end
+  end
+
+  private
+    def upload_file
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * 1024), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(blob)
+      ActionText::Content.new("<p>Attached</p>").append_attachables(blob).to_html
+    end
+end
