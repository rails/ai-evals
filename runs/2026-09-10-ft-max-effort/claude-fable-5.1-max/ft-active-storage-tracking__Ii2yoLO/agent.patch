+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+  end
+
+  test "adds up the bytes used by all its boards" do
+    boards(:writebook).update_column :bytes_used, 100
+    boards(:private).update_column :bytes_used, 50
+    boards(:miltons_wish_list).update_column :bytes_used, 1000 # Another account's board
+
+    @account.recalculate_bytes_used
+
+    assert_equal 150, @account.bytes_used
+    assert_equal 150, @account.reload.bytes_used
+  end
+
+  test "recalculating later happens in a job" do
+    assert_enqueued_with job: Account::RecalculateBytesUsedJob, args: [ @account ] do
+      @account.recalculate_bytes_used_later
+    end
+  end
