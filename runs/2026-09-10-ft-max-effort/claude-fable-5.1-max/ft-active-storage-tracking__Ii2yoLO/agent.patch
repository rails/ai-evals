+class Board::RecalculateBytesUsedJob < ApplicationJob
+  # Run one recalculation per board at a time so a slower, staler sum can't overwrite a fresher one.
+  limits_concurrency key: ->(board) { board }
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(board)
+    board.recalculate_bytes_used
+  end
+end
