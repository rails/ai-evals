+    blob = upload_moon
+    cards(:logo).comments.create!(body: embed(blob))
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "counts files embedded in the board description" do
+    blob = upload_moon
+    @board.update!(public_description: embed(blob))
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "adds up everything on the board and its cards" do
+    image, description_blob, comment_blob, board_blob = 4.times.map { upload_moon }
+
+    cards(:logo).image.attach(image)
+    cards(:layout).update!(description: embed(description_blob))
+    cards(:text).comments.create!(body: embed(comment_blob))
+    @board.update!(public_description: embed(board_blob))
+
+    perform_enqueued_jobs
+
+    assert_equal 4 * image.byte_size, @board.reload.bytes_used
+    assert_equal 4 * image.byte_size, @account.reload.bytes_used
+  end
+
+  test "ignores files that aren't on a board" do
+    users(:david).avatar.attach(upload_moon)
+    Export.create!(account: @account, user: users(:david)).file.attach(io: StringIO.new("zip"), filename: "export.zip")
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "ignores image variants" do
+    blob = upload_moon
+    cards(:logo).comments.create!(body: embed(blob))
+
+    perform_enqueued_jobs
+
+    assert ActiveStorage::VariantRecord.where(blob: blob).exists?, "Expected variants to have been processed"
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "stops counting a card image once it's removed" do
+    card = cards(:logo)
+    card.image.attach(upload_moon)
+    perform_enqueued_jobs
+
+    assert_changes -> { @board.reload.bytes_used }, to: 0 do
+      card.image.purge_later
+      perform_enqueued_jobs
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "stops counting a file once it's no longer embedded" do
+    card = cards(:logo)
+    card.update!(description: embed(upload_moon))
+    perform_enqueued_jobs
+
+    assert_changes -> { @board.reload.bytes_used }, to: 0 do
+      card.update!(description: "<p>No more images</p>")
+      perform_enqueued_jobs
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "stops counting files when their card is destroyed" do
+    card = cards(:logo)
+    card.image.attach(upload_moon)
+    card.comments.create!(body: embed(upload_moon))
+    perform_enqueued_jobs
+
+    assert_changes -> { @board.reload.bytes_used }, to: 0 do
+      card.destroy
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "stops counting files when their comment is destroyed" do
+    comment = cards(:logo).comments.create!(body: embed(upload_moon))
+    perform_enqueued_jobs
+
+    assert_changes -> { @board.reload.bytes_used }, to: 0 do
+      comment.destroy
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+  end
+
+  test "follows cards when they move to another board" do
+    card = cards(:logo)
+    card.image.attach(upload_moon)
+    card.comments.create!(body: embed(upload_moon))
+    perform_enqueued_jobs
+
+    bytes_used = @board.reload.bytes_used
+    assert_operator bytes_used, :>, 0
+
+    card.move_to(boards(:private))
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal bytes_used, boards(:private).reload.bytes_used
+    assert_equal bytes_used, @account.reload.bytes_used
+  end
+
+  test "recalculating counts what's attached right now" do
+    cards(:logo).image.attach(upload_moon)
+    @board.update_column :bytes_used, 42
+
+    @board.recalculate_bytes_used
+
+    assert_equal cards(:logo).image.byte_size, @board.bytes_used
+    assert_equal cards(:logo).image.byte_size, @account.reload.bytes_used
+  end
+
+  test "recalculating later happens in a job" do
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      @board.recalculate_bytes_used_later
+    end
+  end
+
+  test "recalculation isn't scheduled for destroyed boards" do
+    @board.destroy
+
+    assert_no_enqueued_jobs only: Board::RecalculateBytesUsedJob do
+      @board.recalculate_bytes_used_later
+    end
+  end
+
+  test "recalculating doesn't touch or broadcast the board" do
+    cards(:logo).image.attach(upload_moon)
+
+    assert_no_changes -> { @board.reload.updated_at } do
+      assert_no_turbo_stream_broadcasts @board do
+        @board.recalculate_bytes_used
+      end
+    end
+  end
+
+  private
+    def upload_moon
+      ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    def embed(blob)
+      ActionText::Content.new("<p>Look at this</p>").append_attachables(blob).to_html
+    end
+end
