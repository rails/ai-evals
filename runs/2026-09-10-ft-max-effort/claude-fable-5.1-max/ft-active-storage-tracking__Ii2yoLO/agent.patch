+require "test_helper"
+
+class Board::RecalculateBytesUsedJobTest < ActiveJob::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+  end
+
+  test "recalculates the bytes used by the board and its account" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @board.update_column :bytes_used, 42
+
+    Board::RecalculateBytesUsedJob.perform_now(@board)
+
+    assert_equal cards(:logo).image.byte_size, @board.reload.bytes_used
+    assert_equal cards(:logo).image.byte_size, @board.account.reload.bytes_used
+  end
+
+  test "is discarded when the board no longer exists" do
+    Board::RecalculateBytesUsedJob.perform_later(@board)
+    @board.delete
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Board::RecalculateBytesUsedJob
+    end
+  end
+
+  test "runs one recalculation per board at a time" do
+    job = Board::RecalculateBytesUsedJob.new(@board)
+
+    assert job.concurrency_limited?
+    assert_not_equal job.concurrency_key, Board::RecalculateBytesUsedJob.new(boards(:private)).concurrency_key
+    assert_equal job.concurrency_key, Board::RecalculateBytesUsedJob.new(Board.find(@board.id)).concurrency_key
+  end
+end
