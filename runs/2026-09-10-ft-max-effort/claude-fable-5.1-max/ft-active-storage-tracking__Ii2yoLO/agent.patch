diff --git a/lib/rails_ext/active_storage_attachment_storage_tracking.rb b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
new file mode 100644
index 0000000..659a93a
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
@@ -0,0 +1,35 @@
+# Keep the storage usage of boards up to date as files are attached and removed.
+#
+# Attachments know the record they belong to, and records that live on a board (cards,
+# comments and their rich texts, or the board itself) know their board.
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_commit :recalculate_board_bytes_used_later, on: [ :create, :destroy ]
+  end
+
+  # Purging deletes the attachment row without running destroy callbacks.
+  def purge
+    super
+    recalculate_board_bytes_used_later
+  end
+
+  def purge_later
+    super
+    recalculate_board_bytes_used_later
+  end
+
+  def board
+    record.try(:board)
+  end
+
+  private
+    def recalculate_board_bytes_used_later
+      board&.recalculate_bytes_used_later
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  prepend ActiveStorageAttachmentStorageTracking
+end
