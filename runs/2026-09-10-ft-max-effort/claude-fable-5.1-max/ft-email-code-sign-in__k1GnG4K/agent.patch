diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..85eaa64
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code that expires in fifteen minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_match /\A[A-Z2-9]{6}\z/, magic_link.code
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert_predicate magic_link, :sign_in?
+    end
+  end
+
+  test "consume returns and destroys the magic link matching the code" do
+    magic_link = @identity.magic_links.create!
+
+    assert_difference -> { MagicLink.count }, -1 do
+      assert_equal magic_link, @identity.magic_links.consume(magic_link.code)
+    end
+
+    assert_nil @identity.magic_links.consume(magic_link.code), "a code should only work once"
+  end
+
+  test "consume ignores case and surrounding whitespace" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal magic_link, @identity.magic_links.consume(" #{magic_link.code.downcase} ")
+  end
+
+  test "consume rejects wrong, blank, and expired codes" do
+    magic_link = @identity.magic_links.create!
+
+    assert_nil @identity.magic_links.consume("WRONG1")
+    assert_nil @identity.magic_links.consume(nil)
+    assert_nil @identity.magic_links.consume("")
+
+    travel 16.minutes do
+      assert_predicate magic_link, :expired?
+      assert_nil @identity.magic_links.consume(magic_link.code)
+    end
+
+    assert magic_link.reload.persisted?, "failed attempts should leave the magic link alone"
+  end
+
+  test "consume only matches codes belonging to the identity" do
+    magic_link = @identity.magic_links.create!
+
+    assert_nil identities(:david).magic_links.consume(magic_link.code)
+    assert magic_link.reload.persisted?
+  end
+
+  test "cleanup removes expired magic links" do
+    expired = @identity.magic_links.create!
+    active = travel(10.minutes) { @identity.magic_links.create! }
+
+    travel 16.minutes do
+      MagicLink.cleanup
+    end
+
+    assert_not MagicLink.exists?(expired.id)
+    assert MagicLink.exists?(active.id)
+  end
+
+  test "deliver_later emails the code to the identity" do
+    magic_link = @identity.magic_links.create!
+
+    assert_emails 1 do
+      magic_link.deliver_later
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], mail.to
+    assert_includes mail.subject, magic_link.code
+  end
+
+  test "destroying an identity destroys its magic links" do
+    @identity.magic_links.create!
+
+    assert_difference -> { MagicLink.count }, -1 do
+      @identity.destroy!
+    end
+  end
+end
