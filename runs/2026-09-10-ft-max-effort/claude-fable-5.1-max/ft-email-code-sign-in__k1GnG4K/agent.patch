+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @magic_link = @identity.magic_links.create!
+  end
+
+  test "code is sent to the identity" do
+    email = MagicLinkMailer.code(@magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @identity.email_address ], email.to
+  end
+
+  test "code is in the subject so it shows up in a notification" do
+    email = MagicLinkMailer.code(@magic_link)
+
+    assert_equal "Your Fizzy sign-in code is #{@magic_link.code}", email.subject
+  end
+
+  test "code is in both the HTML and text parts" do
+    email = MagicLinkMailer.code(@magic_link)
+
+    assert_includes email.html_part.decoded, @magic_link.code
+    assert_includes email.text_part.decoded, @magic_link.code
+    assert_match /15 minutes/, email.text_part.decoded
+  end
+
+  test "sign-up codes say so" do
+    email = MagicLinkMailer.code(@identity.magic_links.create!(purpose: :sign_up))
+
+    assert_match /sign-up code/, email.subject
+    assert_match /sign up for Fizzy/, email.text_part.decoded
+  end
+end
