diff --git a/app/views/sessions/magic_links/new.html.erb b/app/views/sessions/magic_links/new.html.erb
new file mode 100644
index 0000000..0196cd9
--- /dev/null
+++ b/app/views/sessions/magic_links/new.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column align-center gap txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.text_field :code, class: "input", autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+          autofocus: true, required: true, maxlength: MagicLink::CODE_LENGTH, placeholder: "•" * MagicLink::CODE_LENGTH, aria: { label: "Code" } %>
+
+    <p>We emailed a <%= MagicLink::CODE_LENGTH %>-character code to <strong><%= @identity.email_address %></strong>. Enter it here within <%= distance_of_time_in_words(MagicLink::EXPIRY_DURATION) %> to sign in.</p>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle margin-block-start">
+    Didn’t get it? Check your spam folder, or <%= link_to "start over", new_session_path, class: "txt-link" %> to get a new code.
+  </p>
+
+  <% if Rails.env.development? && (magic_link = @identity.magic_links.active.last) %>
+    <p class="txt-small txt-subtle">Psst, here’s your code: <strong><%= magic_link.code %></strong></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
