diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..fd9d69f
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,49 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  # Letters and digits that are easy to tell apart when read off a notification
+  CODE_ALPHABET = %w[ A B C D E F G H J K M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ]
+  EXPIRY_DURATION = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  before_create :generate_code, :set_expiry
+
+  class << self
+    def consume(code)
+      if magic_link = active.find_by(code: normalize_code(code))
+        magic_link.destroy
+      end
+    end
+
+    def cleanup
+      expired.delete_all
+    end
+
+    private
+      def normalize_code(code)
+        code.to_s.strip.upcase
+      end
+  end
+
+  def deliver_later
+    MagicLinkMailer.code(self).deliver_later
+  end
+
+  def expired?
+    expires_at.past?
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH, chars: CODE_ALPHABET)
+    end
+
+    def set_expiry
+      self.expires_at = EXPIRY_DURATION.from_now
+    end
+end
