new file mode 100644
index 0000000..e8819b1
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,27 @@
+# Secrets referenced from config/deploy.yml. This file is committed, so it only says where
+# each secret comes from: the environment, a command, or a password manager. Never paste
+# the values themselves in here.
+#
+# The simplest way is to export the variables in your shell before running bin/kamal.
+# Run `bin/kamal secrets print` to check what Kamal will pass along.
+
+# Signs cookies and sessions. Generate one with `bin/rails secret` and keep it: changing it
+# signs everyone out.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for the SMTP_USERNAME in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Keys for web push notifications, see docs/development.md. Leave them empty to run without
+# push notifications.
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Only when pushing to a hosted registry: a token that can push images, such as a GitHub
+# personal access token with the write:packages scope for ghcr.io.
+# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Alternatively, read the secrets from a password manager with `kamal secrets fetch`, e.g.
+# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from Vault/Fizzy SECRET_KEY_BASE SMTP_PASSWORD)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
