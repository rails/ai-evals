diff --git a/test/deploy_config_test.rb b/test/deploy_config_test.rb
new file mode 100644
index 0000000..b0ef235
--- /dev/null
+++ b/test/deploy_config_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+require "kamal"
+
+class DeployConfigTest < ActiveSupport::TestCase
+  setup do
+    @config = Kamal::Configuration.create_from(config_file: Rails.root.join("config/deploy.yml"))
+    @web = @config.role(:web)
+  end
+
+  test "a single web role, served over SSL by the proxy" do
+    assert_equal %w[ web ], @config.roles.map(&:name)
+    assert @web.ssl?
+    assert_equal [ "fizzy.example.com" ], @web.proxy.hosts
+  end
+
+  test "the container links to its host and runs the jobs itself" do
+    env = @web.env(@web.primary_host).clear
+
+    assert_equal @web.proxy.hosts.first, env["APP_HOST"]
+    assert_equal true, env["SOLID_QUEUE_IN_PUMA"]
+  end
+
+  test "databases and files persist on a volume" do
+    assert_includes @config.volume_args, "fizzy_storage:/rails/storage"
+  end
+
+  test "every secret is wired up in .kamal/secrets" do
+    assert_empty @config.env.secret_keys - @config.secrets.to_h.keys
+  end
+end
