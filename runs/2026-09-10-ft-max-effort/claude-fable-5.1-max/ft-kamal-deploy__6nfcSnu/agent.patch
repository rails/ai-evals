   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Host for the links in emails, push notifications and webhooks, which are generated outside of a request.
+  # Don't overwrite if it's already been set (e.g. by fizzy-saas)
+  if config.action_mailer.default_url_options.blank? && ENV["APP_HOST"].present?
+    config.action_mailer.default_url_options = { host: ENV["APP_HOST"], protocol: ssl_enabled ? "https" : "http" }
+  end
+
+  # Send email through the SMTP server given in the environment. STARTTLS is used when the server offers it,
+  # unless SMTP_TLS=true selects SMTPS (usually port 465). Without SMTP_ADDRESS, Action Mailer defaults apply.
+  # Don't overwrite if it's already been set (e.g. by fizzy-saas)
+  if config.action_mailer.smtp_settings.blank? && ENV["SMTP_ADDRESS"].present?
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: ENV.fetch("SMTP_DOMAIN") { ENV["APP_HOST"] },
+      user_name: ENV["SMTP_USERNAME"],
+      password: ENV["SMTP_PASSWORD"],
+      authentication: (ENV.fetch("SMTP_AUTHENTICATION", "plain") if ENV["SMTP_USERNAME"].present?),
+      tls: ENV["SMTP_TLS"] == "true"
+    }.compact_blank
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
