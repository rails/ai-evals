diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..7942906
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,87 @@
+# Deploy Fizzy to a single server with Kamal: https://kamal-deploy.org
+#
+# One Linux box with Docker runs everything in one container: Puma serves the web
+# requests and runs the Solid Queue background jobs, SQLite holds the data, and
+# kamal-proxy terminates SSL with a Let's Encrypt certificate.
+#
+# Fill in your server, hostname and mail server below, export the secrets listed
+# in .kamal/secrets, then run `bin/kamal setup`. See docs/deployment.md.
+#
+# 37signals' own multi-server setup lives in saas/config/deploy.yml.
+
+service: fizzy
+image: fizzy
+
+# The server to deploy to, by IP address or hostname. Kamal connects as root over
+# SSH and installs Docker if it's missing.
+servers:
+  web:
+    - 192.168.0.1
+
+# Use a different SSH user than root.
+# ssh:
+#   user: deploy
+
+# kamal-proxy serves Fizzy over HTTPS with a Let's Encrypt certificate. Point the DNS
+# A record for this hostname at the server and open ports 80 and 443.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# The image goes to a registry Kamal runs on your machine and tunnels to the server
+# over SSH, so no registry account is needed. To push to a hosted registry instead,
+# set its server, credentials and the image name, e.g. for ghcr.io/your-user/fizzy:
+#
+# image: your-user/fizzy
+# registry:
+#   server: ghcr.io
+#   username: your-user
+#   password:
+#     - KAMAL_REGISTRY_PASSWORD
+registry:
+  server: localhost:5555
+
+# Build for the server's architecture. Use arm64 for an ARM server.
+builder:
+  arch: amd64
+
+# Environment for the container. Secrets are read through .kamal/secrets.
+env:
+  clear:
+    # The hostname from above. Links in emails, push notifications and webhooks point here.
+    APP_HOST: fizzy.example.com
+
+    # Run the Solid Queue supervisor inside Puma, so the one container also runs the jobs.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Sign-in codes and notifications go out by email, so an SMTP server is required.
+    # STARTTLS is used when the server offers it. Set SMTP_TLS: true for SMTPS on port 465,
+    # and leave out SMTP_USERNAME for a relay that doesn't ask for credentials.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+
+    # Puma workers and Solid Queue worker processes default to one per CPU core.
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 1
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The SQLite databases and uploaded files live in /rails/storage. Keeping that on a
+# Docker volume is what makes the data survive deploys, so this is what to back up.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep serving assets from the previous version to requests in flight during a deploy.
+asset_path: /rails/public/assets
+
+# Shortcuts: bin/kamal console, bin/kamal logs, ...
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse bash
+  logs: app logs -f
+  dbc: app exec -i --reuse "bin/rails dbconsole"
