diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..63902dd
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,163 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+import { isMobile } from "helpers/platform_helpers"
+
+// Drag cards between the columns of a board.
+//
+// Columns keep their own order, so a dropped card goes to the top of its new column, which is where
+// the server will place it as the column's most recently active card. The card is moved as soon as
+// it's dropped and the change is saved in the background: the response refreshes the affected
+// columns in place, so nothing shifts around afterwards.
+export default class extends Controller {
+  static targets = [ "container", "list", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem = null
+
+  // Native drag and drop isn't available on touch devices
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  // Actions
+
+  async dragStart(event) {
+    const item = this.#itemFor(event.target)
+    if (!item) return
+
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+
+    // Let the browser capture the drag image before dimming the card
+    await nextFrame()
+    if (this.#draggedItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  dragEnter(event) {
+    this.#hover(event)
+  }
+
+  dragOver(event) {
+    this.#hover(event)
+  }
+
+  dragLeave(event) {
+    // Not every browser reports where the pointer went; those keep the highlight until the next dragover
+    if (event.relatedTarget && !this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  async drop(event) {
+    const item = this.#draggedItem
+    const container = this.#containerFor(event.target)
+    if (!item || !container) return
+
+    event.preventDefault()
+    this.#reset()
+
+    if (!container.contains(item)) {
+      await this.#move(item, container)
+    }
+  }
+
+  dragEnd() {
+    this.#reset()
+  }
+
+  // Private
+
+  #hover(event) {
+    if (!this.#draggedItem) return
+
+    const container = this.#containerFor(event.target)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlight(container)
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(candidate => {
+      candidate.classList.toggle(this.hoverContainerClass, candidate === container)
+    })
+  }
+
+  #reset() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#highlight(null)
+  }
+
+  async #move(item, container) {
+    const origin = { parent: item.parentNode, nextSibling: item.nextSibling }
+
+    this.#placeAtTop(item, container)
+
+    if (!await this.#persist(item, container)) {
+      this.#restore(item, origin)
+    }
+  }
+
+  // Golden cards stay at the top of their column, so anything else goes right below them
+  #placeAtTop(item, container) {
+    const items = this.itemTargets.filter(candidate => container.contains(candidate))
+    const list = this.listTargets.find(candidate => container.contains(candidate))
+    const successor = items.find(candidate => this.#isGolden(item) || !this.#isGolden(candidate))
+
+    if (successor) {
+      successor.before(item)
+    } else if (items.length) {
+      items.at(-1).after(item)
+    } else {
+      list?.prepend(item)
+    }
+  }
+
+  #isGolden(item) {
+    return item.classList.contains("golden-effect")
+  }
+
+  #restore(item, { parent, nextSibling }) {
+    if (nextSibling?.parentNode === parent) {
+      parent.insertBefore(item, nextSibling)
+    } else {
+      parent.append(item)
+    }
+  }
+
+  async #persist(card, column) {
+    try {
+      const response = await this.#requestToMove(card, column)
+      return response.ok
+    } catch {
+      return false
+    }
+  }
+
+  #requestToMove(card, column) {
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = card.dataset
+    const { dragAndDropDestination: destination, columnId } = column.dataset
+    const options = { responseKind: "turbo-stream" }
+
+    switch (destination) {
+      case "column":  return post(cardTriageUrl, { ...options, query: { column_id: columnId } })
+      case "maybe":   return destroy(cardTriageUrl, options)
+      case "not_now": return post(cardNotNowUrl, options)
+      case "closed":  return post(cardClosureUrl, options)
+    }
+  }
+
+  #itemFor(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerFor(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+}
