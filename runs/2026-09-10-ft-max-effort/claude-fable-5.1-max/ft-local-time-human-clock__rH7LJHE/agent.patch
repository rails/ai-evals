diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..4c02ec5
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,64 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDate, formatDateTime, formatFullDate, formatFullDateTime, formatLongDate, formatRelativeDate, formatTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Keep in sync with the styles documented in TimeHelper#local_time_tag
+const FORMATTERS = {
+  relative: formatRelativeDate,
+  time: formatTime,
+  date: formatDate,
+  full_date: formatFullDate,
+  long_date: formatLongDate,
+  datetime: formatDateTime
+}
+
+// One shared timer re-renders every connected element, so a page left open as the day rolls
+// over sees "tomorrow" become "1:42 PM", and "1:42 PM" become "yesterday".
+const refresher = {
+  controllers: new Set(),
+  timer: null,
+
+  add(controller) {
+    this.controllers.add(controller)
+    this.timer ||= setInterval(() => this.controllers.forEach(controller => controller.render()), REFRESH_INTERVAL)
+  },
+
+  remove(controller) {
+    this.controllers.delete(controller)
+
+    if (this.controllers.size === 0) {
+      clearInterval(this.timer)
+      this.timer = null
+    }
+  }
+}
+
+// Renders a <time datetime="…"> element in the viewer's own timezone, so the server can send
+// the raw timestamp instead of baking its own clock into HTML shared between people.
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    refresher.add(this)
+  }
+
+  disconnect() {
+    refresher.remove(this)
+  }
+
+  // Only touch the DOM when the words change, so refreshes don't churn observers needlessly.
+  render() {
+    const date = new Date(this.element.dateTime)
+    const text = this.#formatter(date)
+    const title = formatFullDateTime(date)
+
+    if (this.element.textContent !== text) this.element.textContent = text
+    if (this.element.title !== title) this.element.title = title
+  }
+
+  get #formatter() {
+    return FORMATTERS[this.styleValue] || FORMATTERS.relative
+  }
+}
