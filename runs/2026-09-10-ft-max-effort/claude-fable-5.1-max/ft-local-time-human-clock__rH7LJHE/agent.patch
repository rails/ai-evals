diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..6865589 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,20 @@
 module TimeHelper
+  # Renders a <time> tag carrying the raw timestamp, which the local-time Stimulus controller
+  # turns into words in the viewer's own timezone. Nothing about the server's clock or zone
+  # ends up in the HTML, so it caches and shares between people just fine.
+  #
+  # Styles (see app/javascript/controllers/local_time_controller.js):
+  #
+  #   :relative  – "1:42 PM" today, "yesterday", "5 days ago", "tomorrow", "in 3 days", otherwise "Sep 12"
+  #   :time      – "1:42 PM"
+  #   :date      – "Sep 12", or "Sep 12, 2024" outside the current year
+  #   :full_date – "Sep 12, 2025"
+  #   :long_date – "Friday, September 12"
+  #   :datetime  – "9/12/25, 1:42 PM"
+  def local_time_tag(time, style: :relative, data: {}, **attributes)
+    tag.time datetime: time.utc.iso8601,
+      class: class_names("local-time-value", attributes.delete(:class)),
+      data: { controller: "local-time", local_time_style_value: style, action: "turbo:morph-element->local-time#render", **data },
+      **attributes
+  end
 end
