diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..085b7cb
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag sends the raw timestamp for the browser to render" do
+    time = Time.utc(2025, 9, 12, 13, 42).in_time_zone("America/New_York")
+
+    assert_dom_equal <<~HTML, local_time_tag(time)
+      <time datetime="2025-09-12T13:42:00Z" class="local-time-value" data-controller="local-time"
+        data-local-time-style-value="relative" data-action="turbo:morph-element->local-time#render"></time>
+    HTML
+  end
+
+  test "local_time_tag with a style" do
+    assert_select parse(local_time_tag(Time.current, style: :long_date)), "time[data-local-time-style-value=long_date]"
+  end
+
+  test "local_time_tag with extra classes, data and attributes" do
+    html = local_time_tag(Time.current, class: "txt-small", id: "when", data: { bridge__stamp_target: "description" })
+
+    assert_select parse(html), "time#when.local-time-value.txt-small[data-controller=local-time][data-bridge--stamp-target=description]"
+  end
+
+  test "local_time_tag renders identically whatever the server's timezone" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    tags = %w[ UTC Asia/Tokyo America/Los_Angeles ].collect do |zone|
+      Time.use_zone(zone) { local_time_tag(time.in_time_zone) }
+    end
+
+    assert_equal 1, tags.uniq.size
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..0544cc5
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,134 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+  end
+
+  test "comments read as a time today, yesterday, days ago, or a date" do
+    today, yesterday, this_week, older = in_browser_time_zone do
+      [
+        comment_created_at(Time.current.beginning_of_day + 13.hours + 42.minutes),
+        comment_created_at(1.day.ago),
+        comment_created_at(5.days.ago),
+        comment_created_at(30.days.ago)
+      ]
+    end
+
+    visit card_url(@card)
+
+    assert_comment_time today, "1:42 PM"
+    assert_comment_time yesterday, "yesterday"
+    assert_comment_time this_week, "5 days ago"
+    assert_comment_time older, in_browser_time_zone { older.created_at.strftime("%b %-d") }
+  end
+
+  test "times carry the full date and time as a tooltip" do
+    comment = in_browser_time_zone { comment_created_at(Time.current.beginning_of_day + 13.hours + 42.minutes) }
+
+    visit card_url(@card)
+
+    title = in_browser_time_zone { comment.created_at.strftime("%A, %B %-d, %Y at %-l:%M %p") }
+    assert_selector "##{dom_id(comment)} .comment__permalink-title time[title='#{title}']", text: "1:42 PM"
+  end
+
+  test "a card auto-postponing overnight reads as tomorrow, further out as in a few days" do
+    @card.update_columns last_active_at: 1.day.from_now - @card.auto_postpone_period
+    visit card_url(@card)
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+    @card.update_columns last_active_at: 3.days.from_now - @card.auto_postpone_period
+    visit card_url(@card)
+    assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” in 3 days if there’s no activity."
+  end
+
+  test "a closed card shows when it was completed" do
+    Current.user = users(:kevin)
+    @card.close
+
+    visit card_url(@card)
+
+    completed_on = in_browser_time_zone { @card.closed_at.strftime("%b %-d") }
+    assert_selector ".card-perma__closure-message", text: "Completed by Kevin on #{completed_on}."
+    assert_selector ".card__closed-date time", text: /#{in_browser_time_zone { @card.closed_at.strftime("%b %-d, %Y") }}/i
+  end
+
+  test "times stay rendered when the page is refreshed with a morph" do
+    comment = in_browser_time_zone { comment_created_at(1.day.ago) }
+    @card.update_columns last_active_at: 5.days.ago
+    visit card_url(@card)
+    assert_comment_time comment, "yesterday"
+    assert_selector ".card__meta-text--updated time", text: /5 days ago/i
+
+    update_card_elsewhere
+
+    assert_selector "h1", text: "Retitled elsewhere", wait: 5
+    assert_comment_time comment, "yesterday"
+    assert_selector ".card__meta-text--updated time", text: /\A\d{1,2}:\d{2} [AP]M\z/i
+  end
+
+  test "relative dates are worded from the viewer's own day boundaries" do
+    visit root_url
+    now = "2025-09-15T12:00:00Z"
+
+    with_time_zone "UTC" do
+      assert_equal "1:42 PM", format_relative_date("2025-09-15T13:42:00Z", now)
+      assert_equal "yesterday", format_relative_date("2025-09-14T23:59:00Z", now)
+      assert_equal "tomorrow", format_relative_date("2025-09-16T00:00:00Z", now)
+      assert_equal "5 days ago", format_relative_date("2025-09-10T12:00:00Z", now)
+      assert_equal "in 3 days", format_relative_date("2025-09-18T12:00:00Z", now)
+      assert_equal "Sep 8", format_relative_date("2025-09-08T12:00:00Z", now)
+      assert_equal "Sep 22", format_relative_date("2025-09-22T12:00:00Z", now)
+      assert_equal "Dec 31, 2024", format_relative_date("2024-12-31T12:00:00Z", now)
+    end
+
+    # 23:00 UTC on the 14th is already the morning of the 15th in Tokyo, but still the 14th in Los Angeles
+    with_time_zone("Asia/Tokyo") { assert_equal "8:00 AM", format_relative_date("2025-09-14T23:00:00Z", now) }
+    with_time_zone("America/Los_Angeles") { assert_equal "yesterday", format_relative_date("2025-09-14T23:00:00Z", now) }
+  end
+
+  private
+    def comment_created_at(time)
+      @card.comments.create!(creator: users(:kevin), body: "Posted #{time}").tap { it.update! created_at: time }
+    end
+
+    # Matched loosely because the header capitalizes with CSS
+    def assert_comment_time(comment, text)
+      assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: /\A#{text}\z/i
+    end
+
+    def update_card_elsewhere
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+      Current.user = users(:kevin)
+      @card.update!(title: "Retitled elsewhere")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    def in_browser_time_zone(&)
+      Time.use_zone(page.evaluate_script("Intl.DateTimeFormat().resolvedOptions().timeZone"), &)
+    end
+
+    # The page formats in the timezone the server rendered with, which it learns from the timezone meta tag
+    def with_time_zone(name)
+      original = page.evaluate_script(%(document.querySelector("meta[name=timezone]").content))
+      set_meta_time_zone name
+      yield
+    ensure
+      set_meta_time_zone original
+    end
+
+    def set_meta_time_zone(name)
+      page.execute_script %(document.querySelector("meta[name=timezone]").content = arguments[0]), name
+    end
+
+    def format_relative_date(date, now)
+      page.evaluate_async_script <<~JS, date, now
+        const [ date, now, callback ] = arguments
+        import("helpers/date_helpers").then(({ formatRelativeDate }) => callback(formatRelativeDate(new Date(date), new Date(now))))
+      JS
+    end
+end
