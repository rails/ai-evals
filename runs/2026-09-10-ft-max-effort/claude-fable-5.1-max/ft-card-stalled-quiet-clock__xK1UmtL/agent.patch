diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..7a53885
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,49 @@
+# A card bursts when it gets a flurry of attention: several people commenting in
+# quick succession, someone being assigned to it, or someone reopening it. A card
+# that burst and then went quiet for a while is stalled, until activity resumes.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+
+  included do
+    has_one :burst, dependent: :destroy, class_name: "Card::Burst"
+
+    scope :stallable, -> { active.joins(:burst) }
+    scope :stalled, -> { stallable.where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def burst?
+    burst.present?
+  end
+
+  def record_burst
+    create_burst! unless burst?
+  end
+
+  # Comments are bursting when enough of them, from enough different people, land
+  # within a third of the board's auto-postpone period.
+  def comments_bursting?(as_of: Time.current)
+    comments_by_commenter = comments.by_user.where(created_at: (as_of - burst_window)..as_of).group(:creator_id).count
+    comments_by_commenter.values.sum >= BURST_COMMENTS && comments_by_commenter.size >= BURST_COMMENTERS
+  end
+
+  def stallable?
+    burst? && active?
+  end
+
+  def stalled?
+    stallable? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def stalls_at
+    last_active_at + STALLED_AFTER if stallable?
+  end
+
+  private
+    def burst_window
+      (auto_postpone_period / 3).seconds
+    end
+end
