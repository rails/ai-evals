diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..b6d129b
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "three comments from two people within the burst window record a burst" do
+    @card.comments.create! creator: users(:kevin), body: "First"
+    @card.comments.create! creator: users(:jz), body: "Second"
+    assert_not @card.reload.burst?
+
+    @card.comments.create! creator: users(:kevin), body: "Third"
+    assert @card.reload.burst?
+  end
+
+  test "three comments from a single person don't record a burst" do
+    3.times { @card.comments.create! creator: users(:kevin), body: "Talking to myself" }
+    assert_not @card.reload.burst?
+  end
+
+  test "comments spread beyond a third of the auto-postpone period don't record a burst" do
+    window = (boards(:writebook).auto_postpone_period / 3).seconds
+
+    travel_to (window + 2.days).ago do
+      @card.comments.create! creator: users(:kevin), body: "First"
+    end
+    travel_to 1.day.ago do
+      @card.comments.create! creator: users(:jz), body: "Second"
+    end
+    @card.comments.create! creator: users(:kevin), body: "Third"
+
+    assert_not @card.reload.burst?
+  end
+
+  test "system comments don't count towards a burst" do
+    @card.comments.create! creator: users(:system), body: "System says"
+    @card.comments.create! creator: users(:kevin), body: "First"
+    @card.comments.create! creator: users(:jz), body: "Second"
+
+    assert_not @card.reload.burst?
+  end
+
+  test "assigning someone records a burst" do
+    @card.toggle_assignment users(:kevin)
+    assert @card.reload.burst?
+  end
+
+  test "reopening records a burst" do
+    assert_not cards(:shipping).burst?
+
+    cards(:shipping).reopen
+    assert cards(:shipping).reload.burst?
+  end
+
+  test "closing and postponing don't record a burst" do
+    @card.close
+    assert_not @card.reload.burst?
+
+    cards(:layout).postpone
+    assert_not cards(:layout).reload.burst?
+  end
+
+  test "a burst is only recorded once" do
+    @card.record_burst
+
+    assert_no_difference -> { Card::Burst.count } do
+      @card.record_burst
+      @card.toggle_assignment users(:kevin)
+    end
+  end
+
+  test "recording a burst touches the card" do
+    assert_changes -> { @card.reload.updated_at } do
+      travel 1.minute do
+        @card.record_burst
+      end
+    end
+  end
+
+  test "a card that burst and then saw no activity for two weeks is stalled" do
+    @card.record_burst
+    assert_not @card.stalled?
+    assert_equal @card.last_active_at + 2.weeks, @card.stalls_at
+
+    travel 2.weeks + 1.minute do
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "cards without a burst never stall" do
+    travel 3.weeks do
+      assert_not @card.stalled?
+      assert_nil @card.stalls_at
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "any activity resets a stalled card" do
+    @card.record_burst
+
+    travel_to 3.weeks.from_now do
+      assert @card.reload.stalled?
+
+      @card.comments.create! creator: users(:kevin), body: "Any update on this?"
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+      assert_equal @card.last_active_at + 2.weeks, @card.stalls_at
+    end
+  end
+
+  test "closed and postponed cards don't stall" do
+    @card.record_burst
+    cards(:layout).record_burst
+
+    travel_to 3.weeks.from_now do
+      @card.reload.close
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+
+      cards(:layout).reload.postpone
+      assert_not cards(:layout).reload.stalled?
+      assert_not_includes Card.stalled, cards(:layout)
+    end
+  end
+
+  test "drafts don't stall" do
+    cards(:unfinished_thoughts).record_burst
+
+    travel 3.weeks do
+      assert_not cards(:unfinished_thoughts).reload.stalled?
+      assert_not_includes Card.stalled, cards(:unfinished_thoughts)
+    end
+  end
+
+  test "stalled index" do
+    @card.record_burst
+
+    travel 3.weeks do
+      assert_equal [ @card ], Card.indexed_by("stalled").to_a
+    end
+  end
+end
