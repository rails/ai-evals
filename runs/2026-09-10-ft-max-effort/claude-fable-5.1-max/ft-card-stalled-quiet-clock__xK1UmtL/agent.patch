@@ -0,0 +1,48 @@
+require "application_system_test_case"
+
+class StalledCardTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:text)
+  end
+
+  test "a stalled card wears a bubble saying so, until activity resumes" do
+    @card.record_burst
+    @card.update! last_active_at: 3.weeks.ago
+
+    visit card_url(@card)
+
+    within("##{dom_id(@card, :bubble)}.bubble--stalled") do
+      assert_text(/stalled for\s+7\s+days/i)
+    end
+
+    comment_elsewhere
+
+    assert_text "Picking this back up", wait: 5
+    assert_no_selector "##{dom_id(@card, :bubble)}:not([hidden])"
+  end
+
+  test "cards without a burst don't stall" do
+    @card.update! last_active_at: 3.weeks.ago
+
+    visit cards_url
+    assert_selector "##{dom_id(@card, :article)}"
+
+    assert_no_selector "##{dom_id(@card, :bubble)}:not([hidden])"
+  end
+
+  private
+    def comment_elsewhere
+      wait_for_cable_subscriptions
+      @card.comments.create! creator: users(:kevin), body: "Picking this back up"
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
