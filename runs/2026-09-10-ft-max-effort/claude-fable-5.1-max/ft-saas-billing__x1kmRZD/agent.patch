+        </div>
+
+        <div class="flex flex-column gap-quarter txt-small">
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, min: 0, class: "input", placeholder: @account.storage_total&.bytes_stored || 0 %>
+        </div>
