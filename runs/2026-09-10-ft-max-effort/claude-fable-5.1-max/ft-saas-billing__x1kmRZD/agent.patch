index 0000000..843856d
--- /dev/null
+++ b/saas/test/models/account/card_limited_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts get 1,000 cards" do
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1_000, @account.cards_remaining
+    assert_not @account.reached_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "every numbered card counts" do
+    @account.update_column :cards_count, 999
+
+    assert_equal 999, @account.cards_used
+    assert_equal 1, @account.cards_remaining
+    assert_not @account.reached_card_limit?
+  end
+
+  test "reaching the limit" do
+    @account.update_column :cards_count, 1_000
+    assert @account.reached_card_limit?
+    assert_equal 0, @account.cards_remaining
+
+    @account.update_column :cards_count, 1_200
+    assert @account.reached_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "nearing the limit from 100 cards out" do
+    @account.update_column :cards_count, 899
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column :cards_count, 900
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update_column :cards_count, 950
+    assert_equal 50, @account.cards_remaining
+
+    @account.update_column :cards_count, 1_000
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid plans don't cap cards" do
+    @account.update_column :cards_count, 5_000
+    subscribe @account
+
+    assert_nil @account.card_limit
+    assert_nil @account.cards_remaining
+    assert_not @account.reached_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "an overridden card count stands in for the real one" do
+    @account.update_column :cards_count, 5
+    @account.override_limits(card_count: 1_000)
+
+    assert_equal 1_000, @account.cards_used
+    assert @account.reached_card_limit?
+    assert_equal 5, @account.cards_count
+  end
+end
diff --git a/saas/test/models/account/limit_overridable_test.rb b/saas/test/models/account/limit_overridable_test.rb
