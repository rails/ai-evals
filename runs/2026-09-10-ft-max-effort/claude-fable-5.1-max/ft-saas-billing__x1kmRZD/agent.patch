+require "test_helper"
+
+class Account::Subscriptions::PortalsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "admins are sent to the Stripe customer portal" do
+    sign_in_as :kevin
+    subscribe @account, stripe_customer_id: "cus_37s"
+
+    Stripe::BillingPortal::Session.expects(:create).with(customer: "cus_37s", return_url: account_subscription_url(host: "www.example.com"))
+      .returns(stub(url: "https://billing.stripe.com/session/xyz"))
+
+    post account_subscription_portal_path
+
+    assert_redirected_to "https://billing.stripe.com/session/xyz"
+  end
+
+  test "there's no portal without a Stripe customer" do
+    sign_in_as :kevin
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post account_subscription_portal_path
+
+    assert_response :not_found
+  end
+
+  test "members can't open the portal" do
+    sign_in_as :david
+    subscribe @account
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post account_subscription_portal_path
+
+    assert_response :forbidden
