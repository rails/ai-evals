@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::LimitOverridableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "overriding card count and bytes used" do
+    @account.override_limits(card_count: 950, bytes_used: 900.megabytes)
+
+    assert_equal 950, @account.cards_used
+    assert_equal 900.megabytes, @account.bytes_used
+    assert @account.nearing_card_limit?
+    assert @account.nearing_storage_limit?
+  end
+
+  test "overriding again replaces the override" do
+    @account.override_limits(card_count: 950, bytes_used: 900.megabytes)
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      @account.override_limits(card_count: 10)
+    end
+
+    assert_equal 10, @account.cards_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "resetting drops the override" do
+    @account.override_limits(card_count: 950)
+    @account.reset_overridden_limits
+
+    assert_equal 0, @account.cards_used
+    assert_nil @account.overridden_limit
+    assert_not Account::OverriddenLimit.exists?(account_id: @account.id)
+  end
+
+  test "resetting without an override is fine" do
+    assert_nothing_raised { @account.reset_overridden_limits }
+  end
+
+  test "an override has to override something" do
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits }
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(card_count: -1) }
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(bytes_used: "lots") }
+  end
+end
