diff --git a/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
new file mode 100644
index 0000000..1d05c73
--- /dev/null
+++ b/saas/test/controllers/admin/accounts/overridden_limits_controller_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can override an account's card count and bytes used" do
+    sign_in_as :david
+
+    untenanted do
+      put saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: "1000", bytes_used: 2.gigabytes.to_s } }
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+
+    assert_equal "Limits overridden", flash[:notice]
+    @account.reload
+    assert_equal 1_000, @account.cards_used
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.reached_card_limit?
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "a blank field means no override for it" do
+    sign_in_as :david
+    @account.override_limits(card_count: 5, bytes_used: 5)
+
+    untenanted do
+      put saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: "950", bytes_used: "" } }
+    end
+
+    @account.reload
+    assert_equal 950, @account.cards_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "an override has to override something" do
+    sign_in_as :david
+
+    untenanted do
+      put saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: "", bytes_used: "" } }
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+
+    assert_equal "Nothing to override", flash[:alert]
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "staff can reset the override" do
+    sign_in_as :david
+    @account.override_limits(card_count: 1_000)
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+
+    assert_equal "Override reset", flash[:notice]
+    assert_nil @account.reload.overridden_limit
+    assert_equal 0, @account.cards_used
+  end
+
+  test "non-staff can't override" do
+    sign_in_as :mike
+
+    untenanted do
+      put saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: "0" } }
+    end
+
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limit
+  end
+end
