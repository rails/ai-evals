index 0000000..5eb6f3c
--- /dev/null
+++ b/saas/test/controllers/account/settings_plan_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::SettingsPlanTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and an upgrade" do
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_select "section", text: /on the Free plan/
+    assert_select "section", text: /5 of 1,000 cards used/
+    assert_select "a[href=?]", account_subscription_path, text: "Upgrade"
+  end
+
+  test "owners see their plan and an upgrade" do
+    sign_in_as :jason
+
+    get account_settings_path
+
+    assert_select "a[href=?]", account_subscription_path, text: "Upgrade"
+  end
+
+  test "members see the plan but can't upgrade" do
+    sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "section", text: /on the Free plan/
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
+  test "subscribers see their paid plan and manage billing instead of upgrading to it" do
+    sign_in_as :kevin
+    subscribe accounts(:"37s"), to: Plan.find("monthly_extra_storage_v1")
+
+    get account_settings_path
+
+    assert_select "section", text: /on the Unlimited\+ plan/
+    assert_select "a", text: "Upgrade", count: 0
+    assert_select "form[action=?] button", account_subscription_portal_path, text: "Manage billing"
+  end
+
+  test "comped accounts see their complimentary plan" do
+    sign_in_as :kevin
+    accounts(:"37s").comp
+
+    get account_settings_path
+
+    assert_select "section", text: /on the Unlimited plan, complimentary/
+    assert_select "button", text: "Manage billing", count: 0
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions/checkouts_controller_test.rb b/saas/test/controllers/account/subscriptions/checkouts_controller_test.rb
new file mode 100644
index 0000000..801bec2
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions/checkouts_controller_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Account::Subscriptions::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "admins are sent to Stripe to check out the chosen plan" do
+    sign_in_as :kevin
+
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:line_items] == [ { price: "price_monthly_extra_storage_v1", quantity: 1 } ] &&
+        params[:client_reference_id] == @account.id &&
+        params[:success_url] == account_subscription_checkout_url(host: "www.example.com") &&
+        params[:cancel_url] == account_subscription_url(host: "www.example.com")
+    end.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_123"))
+
+    post account_subscription_checkout_path(plan: "monthly_extra_storage_v1")
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_123"
+  end
+
+  test "only paid plans can be checked out" do
+    sign_in_as :kevin
+    Stripe::Checkout::Session.expects(:create).never
+
+    post account_subscription_checkout_path(plan: "free_v1")
+    assert_response :not_found
+
+    post account_subscription_checkout_path(plan: "gold")
+    assert_response :not_found
+  end
+
+  test "members can't check out" do
+    sign_in_as :david
+    Stripe::Checkout::Session.expects(:create).never
+
+    post account_subscription_checkout_path(plan: "monthly_v1")
+
+    assert_response :forbidden
+  end
+
+  test "returning from checkout thanks the customer for the plan the webhook has set up" do
+    sign_in_as :kevin
+    subscribe @account, to: Plan.unlimited
+
+    get account_subscription_checkout_path
+
+    assert_redirected_to account_subscription_path
+    assert_equal "Thanks! You're now on the Unlimited plan.", flash[:notice]
+  end
+
+  test "returning from checkout before the webhook lands asks for a moment" do
+    sign_in_as :kevin
+
+    get account_subscription_checkout_path
+
+    assert_redirected_to account_subscription_path
+    assert_equal "Thanks! Your new plan will show up here in a moment.", flash[:notice]
+  end
+end
