+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "free accounts see both paid plans with their prices" do
+    sign_in_as :kevin
+
+    get account_subscription_path
+
+    assert_response :success
+    assert_select "h2", text: "Your plan"
+    assert_select "section", text: /Free/
+    assert_select "section", text: /1,000 cards, 1 GB of storage/
+    assert_select "h2", text: "Unlimited"
+    assert_select "section", text: /\$20\/month · Unlimited cards, 5 GB of storage/
+    assert_select "h2", text: "Unlimited+"
+    assert_select "section", text: /\$25\/month · Unlimited cards, 500 GB of storage/
+    assert_select "form[action=?] button", account_subscription_checkout_path(plan: "monthly_v1"), text: "Upgrade to Unlimited"
+    assert_select "form[action=?] button", account_subscription_checkout_path(plan: "monthly_extra_storage_v1"), text: "Upgrade to Unlimited+"
+  end
+
+  test "members can look but only admins can upgrade" do
+    sign_in_as :david
+
+    get account_subscription_path
+
+    assert_response :success
+    assert_select "button", text: /Upgrade to/, count: 0
+    assert_select "div", text: "Only account admins can upgrade."
+  end
+
+  test "subscribers manage their plan through the billing portal" do
+    sign_in_as :kevin
+    subscribe @account, current_period_end: Time.zone.parse("2026-10-01 12:00")
+
+    get account_subscription_path
+
+    assert_response :success
+    assert_select "section", text: /Unlimited · \$20\/month/
+    assert_select "section", text: /Renews on/
+    assert_select "time[datetime=?]", Time.zone.parse("2026-10-01 12:00").to_i.to_s
+    assert_select "form[action=?] button", account_subscription_portal_path, text: "Manage billing"
+    assert_select "h2", text: "Unlimited+"
+    assert_select "button", text: /Upgrade to/, count: 0
+    assert_select "div", text: /Switch plans from/
+  end
+
+  test "an ending subscription says so" do
+    sign_in_as :kevin
+    subscribe @account, cancel_at: 5.days.from_now
+
+    get account_subscription_path
+
+    assert_select "section", text: /Your plan ends on/
+  end
+
+  test "a past due subscription asks for a new card" do
+    sign_in_as :kevin
+    subscribe @account, status: "past_due"
+
+    get account_subscription_path
+
+    assert_select "section", text: /Your last payment failed/
+  end
+
+  test "the biggest plan has nowhere to upgrade to" do
+    sign_in_as :kevin
+    subscribe @account, to: Plan.find("monthly_extra_storage_v1")
+
+    get account_subscription_path
+
+    assert_select "h2", text: "Need more?"
+    assert_select "button", text: /Upgrade to/, count: 0
+  end
+
+  test "requires signing in" do
+    get account_subscription_path
+
+    assert_response :redirect
+  end
+end
