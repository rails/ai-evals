+class Account::Subscriptions::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_plan, only: :create
+
+  def create
+    redirect_to Current.account.checkout_url(@plan, success_url: account_subscription_checkout_url, cancel_url: account_subscription_url),
+      allow_other_host: true
+  end
+
+  # Where Stripe sends the customer once they've paid. Stripe posts the new subscription
+  # to the webhook, which is usually done by the time the customer gets here.
+  def show
+    redirect_to account_subscription_path, notice: thanks
+  end
+
+  private
+    def set_plan
+      @plan = Plan.paid.find { |plan| plan.key == params[:plan] }
+      head :not_found unless @plan
+    end
+
+    def thanks
+      if Current.account.current_plan.paid?
+        "Thanks! You're now on the #{Current.account.current_plan.name} plan."
+      else
+        "Thanks! Your new plan will show up here in a moment."
+      end
+    end
+end
