+<% @page_title = "Plan" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Your plan</h2>
+        <div>
+          <strong><%= @plan.name %></strong><%= " · #{plan_price(@plan)}" if @plan.paid? %><%= ", complimentary" if @account.comped? && !@subscription %>
+        </div>
+        <div><%= plan_allowances(@plan) %>.</div>
+      </header>
+
+      <div class="txt-small">
+        <%= render "account/subscriptions/usage", account: @account %>
+      </div>
+
+      <% if @subscription %>
+        <div class="txt-small">
+          <% if @subscription.ending? %>
+            Your plan ends on <%= local_datetime_tag(@subscription.cancel_at, style: :date) %>.
+          <% elsif @subscription.status == "past_due" %>
+            Your last payment failed. Update your card to keep your plan.
+          <% elsif @subscription.current_period_end %>
+            Renews on <%= local_datetime_tag(@subscription.current_period_end, style: :date) %>.
+          <% end %>
+        </div>
+      <% end %>
+
+      <% if Current.user.admin? && @account.subscription %>
+        <%= button_to "Manage billing", account_subscription_portal_path, class: "btn", form: { data: { turbo: false } } %>
+        <div class="txt-small txt-subtle">Change plans, update your card, download invoices, or cancel.</div>
+      <% end %>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow center">
+    <% if @upgrades.any? %>
+      <% @upgrades.each do |plan| %>
+        <section class="settings__section">
+          <header>
+            <h2 class="divider"><%= plan.name %></h2>
+            <div><strong><%= plan_price(plan) %></strong> · <%= plan_allowances(plan) %>.</div>
+          </header>
+
+          <% if Current.user.admin? && !@subscription %>
+            <%= button_to "Upgrade to #{plan.name}", account_subscription_checkout_path(plan: plan), class: "btn btn--link settings-subscription__button", form: { data: { turbo: false } } %>
+          <% end %>
+        </section>
+      <% end %>
+
+      <% if !Current.user.admin? %>
+        <div class="txt-small txt-subtle">Only account admins can upgrade.</div>
+      <% elsif @subscription %>
+        <div class="txt-small txt-subtle">Switch plans from <em>Manage billing</em>.</div>
+      <% end %>
+    <% else %>
+      <section class="settings__section">
+        <header>
+          <h2 class="divider">Need more?</h2>
+          <div>You're on our biggest plan. <%= link_to "Self-host Fizzy", "https://github.com/basecamp/fizzy", target: "_blank" %> for unlimited storage, or get in touch.</div>
+        </header>
+      </section>
+    <% end %>
+  </div>
+</div>
