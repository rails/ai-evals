+                <%= account.current_plan.name %><%= ", comped" if account.comped? %>
+              </span>
+            </div>
+
+            <div class="txt-medium" style="text-align: right">
+              <strong><%= number_with_delimiter(account.cards_used) %></strong>
+              <span class="txt-x-small txt-ink-medium">cards</span>
+            </div>
