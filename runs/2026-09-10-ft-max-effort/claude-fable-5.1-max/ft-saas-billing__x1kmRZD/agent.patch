+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def update
+    @account.override_limits(**overridden_limit_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to saas.admin_account_path(@account), alert: error.record.errors.full_messages.to_sentence
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def overridden_limit_params
+      params.expect(account_overridden_limit: [ :card_count, :bytes_used ]).to_h.symbolize_keys.transform_values(&:presence)
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
