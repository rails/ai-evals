index 0000000..eaa3c3d
--- /dev/null
+++ b/saas/test/test_helpers/billing_test_helper.rb
@@ -0,0 +1,26 @@
+module BillingTestHelper
+  def subscribe(account, to: Plan.unlimited, status: "active", **attributes)
+    account.create_subscription! \
+      plan_key: to.key, status: status, stripe_customer_id: "cus_#{account.external_account_id}",
+      stripe_subscription_id: "sub_#{account.external_account_id}", current_period_end: 30.days.from_now, **attributes
+  end
+
+  def stripe_subscription_for(account, plan: Plan.unlimited, id: "sub_123", customer: "cus_123", status: "active", **attributes)
+    Stripe::Subscription.construct_from({
+      id: id, object: "subscription", customer: customer, status: status, cancel_at: nil,
+      metadata: { account_id: account.id },
+      items: { object: "list", data: [
+        { id: "si_123", object: "subscription_item", current_period_end: 30.days.from_now.to_i, price: { id: plan.stripe_price_id, object: "price" } }
+      ] }
+    }.merge(attributes))
+  end
+
+  def stripe_webhook_headers(payload, secret: ENV["STRIPE_WEBHOOK_SECRET"], timestamp: Time.now)
+    signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+    { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(timestamp, signature) }
+  end
+
+  def stripe_event_payload(type, object)
+    { id: "evt_123", object: "event", type: type, data: { object: JSON.parse(object.to_json) } }.to_json
+  end
+end
