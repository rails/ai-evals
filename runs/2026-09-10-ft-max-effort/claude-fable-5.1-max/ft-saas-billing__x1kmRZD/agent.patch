diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..f8c5c7c
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "syncing a new Stripe subscription subscribes the account it was checked out for" do
+    assert_difference -> { Account::Subscription.count }, +1 do
+      Account::Subscription.sync_from_stripe stripe_subscription_for(@account)
+    end
+
+    subscription = @account.reload.subscription
+    assert_equal Plan.unlimited, subscription.plan
+    assert_equal [ "cus_123", "sub_123", "active" ], [ subscription.stripe_customer_id, subscription.stripe_subscription_id, subscription.status ]
+    assert_in_delta 30.days.from_now, subscription.current_period_end, 5.seconds
+    assert_nil subscription.cancel_at
+    assert subscription.active?
+    assert_not subscription.ending?
+  end
+
+  test "syncing an existing subscription updates it in place" do
+    subscription = subscribe(@account, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+    cancel_at = 10.days.from_now.change(usec: 0)
+
+    assert_no_difference -> { Account::Subscription.count } do
+      Account::Subscription.sync_from_stripe stripe_subscription_for(@account, plan: Plan.find("monthly_extra_storage_v1"), cancel_at: cancel_at.to_i)
+    end
+
+    subscription.reload
+    assert_equal Plan.find("monthly_extra_storage_v1"), subscription.plan
+    assert_equal cancel_at, subscription.cancel_at
+    assert subscription.ending?
+  end
+
+  test "statuses" do
+    subscription = subscribe(@account, status: "trialing")
+    assert subscription.active?
+    assert_not subscription.canceled?
+
+    subscription.update! status: "paused"
+    assert_not subscription.active?
+    assert_not subscription.canceled?
+
+    subscription.update! status: "incomplete_expired"
+    assert subscription.canceled?
+  end
+
+  test "a canceled subscription lapses the plan" do
+    subscribe @account, stripe_subscription_id: "sub_123"
+
+    Account::Subscription.sync_from_stripe stripe_subscription_for(@account, status: "canceled")
+
+    assert_equal "canceled", @account.subscription.reload.status
+    assert_equal Plan.free, @account.reload.current_plan
+  end
+
+  test "subscriptions without account metadata are matched by Stripe customer" do
+    subscribe @account, stripe_customer_id: "cus_known", stripe_subscription_id: "sub_old", status: "canceled"
+
+    Account::Subscription.sync_from_stripe stripe_subscription_for(@account, id: "sub_new", customer: "cus_known", metadata: {})
+
+    assert_equal "sub_new", @account.subscription.reload.stripe_subscription_id
+    assert @account.subscription.active?
+  end
+
+  test "subscriptions for nobody we know are ignored" do
+    assert_no_difference -> { Account::Subscription.count } do
+      Account::Subscription.sync_from_stripe stripe_subscription_for(@account, customer: "cus_stranger", metadata: {})
+      Account::Subscription.sync_from_stripe stripe_subscription_for(@account, metadata: { account_id: "nope" })
+    end
+  end
+
+  test "a late cancellation of a replaced subscription is ignored" do
+    subscribe @account, stripe_subscription_id: "sub_current"
+
+    Account::Subscription.sync_from_stripe stripe_subscription_for(@account, id: "sub_previous", status: "canceled")
+
+    assert_equal [ "sub_current", "active" ], [ @account.subscription.reload.stripe_subscription_id, @account.subscription.status ]
+  end
+
+  test "a subscription at a price we don't sell is an error" do
+    price = { id: "price_legacy", object: "price" }
+    stripe_subscription = stripe_subscription_for(@account, items: { object: "list", data: [ { id: "si_1", object: "subscription_item", price: price } ] })
+
+    assert_raises(Account::Subscription::UnknownPriceError) do
+      Account::Subscription.sync_from_stripe stripe_subscription
+    end
+  end
+
+  test "current period end can come from the subscription itself on older Stripe API versions" do
+    period_end = 20.days.from_now.change(usec: 0)
+
+    Account::Subscription.sync_from_stripe stripe_subscription_for(@account, current_period_end: period_end.to_i)
+
+    assert_equal period_end, @account.subscription.current_period_end
+  end
+
+  test "cancel_later cancels at Stripe in a job" do
+    subscription = subscribe(@account, stripe_subscription_id: "sub_bye")
+    Stripe::Subscription.expects(:cancel).with("sub_bye")
+
+    perform_enqueued_jobs only: Account::Subscription::CancelJob do
+      subscription.cancel_later
+    end
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
