+        <% end %>
+      </ul>
+    <% end %>
+
+    <% if @page.records.empty? %>
+      <div class="blank-slate margin-block">No accounts found</div>
+    <% end %>
+  </div>
+</section>
+
+<% content_for :footer do %>
+  <%= link_to "Stats", saas.admin_stats_path, class: "txt-small" %>
+<% end %>
