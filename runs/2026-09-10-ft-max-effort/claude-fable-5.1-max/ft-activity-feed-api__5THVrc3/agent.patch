 module User::Timelined
   extend ActiveSupport::Concern
 
+  # The kinds of events exposed as activity via the API: the ones shown in the day timeline,
+  # minus deprecated collection changes, plus title changes.
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_title_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+  ]
+
   included do
     has_many :accessible_events, through: :boards, source: :events
   end
@@ -8,4 +25,10 @@ module User::Timelined
   def timeline_for(day, filter:)
     User::DayTimeline.new(self, day, filter)
   end
+
+  def activities(filter:)
+    events = Event.preloaded.where(board: filter.boards.presence || boards, action: ACTIVITY_ACTIONS)
+    events = events.where(creator_id: filter.creators.ids) if filter.creators.present?
+    events.reverse_chronologically
+  end
 end
