+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "activities include timelined events from accessible boards, newest first" do
+    activities = @user.activities(filter: filter_for)
+
+    assert_equal boards(:writebook).events.count, activities.count
+    assert_equal events(:layout_assignment_jz), activities.first
+    assert_equal activities.sort_by { |event| [ event.created_at, event.id ] }.reverse, activities.to_a
+  end
+
+  test "activities exclude events from inaccessible boards" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from @user
+
+    assert_empty @user.activities(filter: filter_for)
+  end
+
+  test "activities include title changes but not deprecated collection changes" do
+    title_change = track_event("card_title_changed", particulars: { old_title: "Old", new_title: "New" })
+    collection_change = track_event("card_collection_changed", particulars: { new_collection: "Private board" })
+
+    activities = @user.activities(filter: filter_for)
+
+    assert_includes activities, title_change
+    assert_not_includes activities, collection_change
+  end
+
+  test "activities can be filtered by creators" do
+    activities = @user.activities(filter: filter_for(creator_ids: [ users(:kevin).id ]))
+
+    assert_not_empty activities
+    assert_equal [ users(:kevin) ], activities.map(&:creator).uniq
+  end
+
+  test "activities can be filtered by boards" do
+    event = track_event("card_closed", board: boards(:private))
+
+    assert_equal [ event ], @user.activities(filter: filter_for(board_ids: [ boards(:private).id ])).to_a
+    assert_not_includes @user.activities(filter: filter_for(board_ids: [ boards(:writebook).id ])), event
+  end
+
+  private
+    def filter_for(**params)
+      @user.filters.from_params(params)
+    end
+
+    def track_event(action, board: boards(:writebook), **particulars)
+      board.events.create! action: action, eventable: cards(:logo), creator: users(:david), particulars: particulars
+    end
+end
