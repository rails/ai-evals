+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal boards(:writebook).events.count, @response.parsed_body.count
+    assert @response.parsed_body.any? { |activity| activity["id"] == events(:logo_assignment_jz).id }
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index as JSON includes card event attributes" do
+    event = events(:layout_assignment_jz)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "David assigned JZ to"
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    assert_equal card_url(cards(:layout)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity.dig("eventable", "id")
+    assert_equal cards(:layout).number, activity.dig("eventable", "number")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal board_url(boards(:writebook)), activity.dig("board", "url")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal user_url(users(:david)), activity.dig("creator", "url")
+  end
+
+  test "index as JSON includes comment event attributes" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, params: { creator_ids: [ users(:david).id ] }, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_includes activity["description"], "David commented on"
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(cards(:layout), anchor: dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+  end
+
+  test "index as JSON exposes particulars of board, title, and triage changes" do
+    board_change = track_event_for(cards(:logo), "card_board_changed", particulars: { old_board: "Writebook", new_board: "Private board" })
+    title_change = track_event_for(cards(:logo), "card_title_changed", particulars: { old_title: "The logo isn't big enough", new_title: "Bigger logo" })
+    triage = track_event_for(cards(:logo), "card_triaged", particulars: { column: "In progress" })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, particulars_for(board_change))
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "Bigger logo" }, particulars_for(title_change))
+    assert_equal({ "column" => "In progress" }, particulars_for(triage))
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    board_change = track_event_for(cards(:logo), "card_board_changed", particulars: { new_board: "Private board" })
+    title_change = track_event_for(cards(:logo), "card_title_changed")
+    triage = track_event_for(cards(:logo), "card_triaged")
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "Private board" }, particulars_for(board_change))
+    assert_equal({ "old_title" => "", "new_title" => "" }, particulars_for(title_change))
+    assert_equal({ "column" => "" }, particulars_for(triage))
+  end
+
+  test "index as JSON returns empty particulars for other events" do
+    get activities_path, as: :json
+
+    assert_equal({}, particulars_for(events(:shipping_closed)))
+    assert_equal({}, particulars_for(events(:buy_domain_sent_back_to_triage)))
+    assert_equal({}, particulars_for(events(:logo_published)))
+  end
+
+  test "index as JSON omits deprecated collection changes" do
+    collection_change = track_event_for(cards(:logo), "card_collection_changed", particulars: { new_collection: "Private board" })
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), collection_change.id
+  end
+
+  test "index as JSON filters by creator" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert_equal [ users(:kevin).id ], @response.parsed_body.map { |activity| activity.dig("creator", "id") }.uniq
+  end
+
+  test "index as JSON filters by board" do
+    event = track_event_for(cards(:logo), "card_closed", board: boards(:private))
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_equal [ event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "index as JSON only includes activity from accessible boards" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index as JSON is paginated" do
+    20.times { track_event_for(cards(:logo), "card_closed") }
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.count
+    assert_match(/page=2>; rel="next"/, @response.headers["Link"])
+
+    get activities_path, params: { page: 2 }, as: :json
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert_nil @response.headers["Link"]
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  private
+    def track_event_for(card, action, board: card.board, **particulars)
+      board.events.create! action: action, eventable: card, creator: users(:david), particulars: particulars
+    end
+
+    def particulars_for(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }["particulars"]
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
