+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "details of assignment changes contain the assignee ids" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).details)
+
+    event = event_with("card_unassigned", {})
+    assert_equal({ assignee_ids: [] }, event.details)
+  end
+
+  test "details of board changes contain the old and new board" do
+    event = event_with("card_board_changed", particulars: { old_board: "Writebook", new_board: "Private board" })
+    assert_equal({ old_board: "Writebook", new_board: "Private board" }, event.details)
+  end
+
+  test "details of title changes contain the old and new title" do
+    event = event_with("card_title_changed", particulars: { old_title: "Old", new_title: "New" })
+    assert_equal({ old_title: "Old", new_title: "New" }, event.details)
+  end
+
+  test "details of triages contain the column" do
+    event = event_with("card_triaged", particulars: { column: "In progress" })
+    assert_equal({ column: "In progress" }, event.details)
+  end
+
+  test "missing details are empty strings" do
+    assert_equal({ old_board: "", new_board: "" }, event_with("card_board_changed", {}).details)
+    assert_equal({ old_title: "", new_title: "" }, event_with("card_title_changed", {}).details)
+    assert_equal({ column: "" }, event_with("card_triaged", {}).details)
+  end
+
+  test "other events have no details" do
+    assert_equal({}, events(:logo_published).details)
+    assert_equal({}, events(:shipping_closed).details)
+    assert_equal({}, events(:layout_commented).details)
+  end
+
+  private
+    def event_with(action, particulars)
+      events(:logo_published).tap { |event| event.update_columns action: action, particulars: particulars }
+    end
+end
