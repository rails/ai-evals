diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..3b7cf7c 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,25 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  # The particulars relevant to each kind of event, with empty values when they weren't recorded.
+  def details
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      details_for :old_board, :new_board
+    when "card_title_changed"
+      details_for :old_title, :new_title
+    when "card_triaged"
+      details_for :column
+    else
+      {}
+    end
+  end
+
+  private
+    def details_for(*names)
+      names.index_with { |name| particulars.dig("particulars", name.to_s).to_s }
+    end
 end
