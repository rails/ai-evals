diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..dc13bc8
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,56 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, localTimeTitle } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+const connectedControllers = new Set()
+let refreshTimer
+
+// Turns the raw timestamp in a <time> element's datetime attribute into words in the viewer's
+// own timezone. Everything connected is re-rendered once a minute on a shared timer, so relative
+// words keep up as the day rolls over: "1:42 PM" becomes "yesterday", "tomorrow" becomes "1:42 PM".
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    startRefreshing(this)
+  }
+
+  disconnect() {
+    stopRefreshing(this)
+  }
+
+  // Also called after a page or frame morph, which resets the element to the empty one the server sent
+  render() {
+    const time = new Date(this.element.getAttribute("datetime"))
+
+    this.#set("textContent", formatLocalTime(time, this.styleValue))
+    this.#set("title", localTimeTitle(time, this.styleValue))
+  }
+
+  // Only touch the DOM for changes, so re-rendering doesn't ripple out to observers of the element
+  #set(property, value) {
+    if (value && this.element[property] !== value) {
+      this.element[property] = value
+    }
+  }
+}
+
+function startRefreshing(controller) {
+  connectedControllers.add(controller)
+  refreshTimer ||= setInterval(refreshAll, REFRESH_INTERVAL)
+}
+
+function stopRefreshing(controller) {
+  connectedControllers.delete(controller)
+
+  if (connectedControllers.size === 0) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+  }
+}
+
+function refreshAll() {
+  connectedControllers.forEach(controller => controller.render())
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..c7a689c
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,77 @@
+// Turns timestamps into words in the viewer's own timezone. The UI is in English, so only
+// the timezone follows the viewer, not the language.
+const LOCALE = "en-US"
+const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1000
+const DAYS_IN_A_WEEK = 7
+
+const formats = {
+  time: new Intl.DateTimeFormat(LOCALE, { hour: "numeric", minute: "2-digit" }),
+  date: new Intl.DateTimeFormat(LOCALE, { month: "short", day: "numeric" }),
+  dateWithYear: new Intl.DateTimeFormat(LOCALE, { month: "short", day: "numeric", year: "numeric" }),
+  weekdayDate: new Intl.DateTimeFormat(LOCALE, { weekday: "long", month: "long", day: "numeric" }),
+  datetime: new Intl.DateTimeFormat(LOCALE, { dateStyle: "short", timeStyle: "short" }),
+  exact: new Intl.DateTimeFormat(LOCALE, { dateStyle: "full", timeStyle: "short" }),
+  relativeDays: new Intl.RelativeTimeFormat(LOCALE, { numeric: "auto" })
+}
+
+// Styles that leave out the date or the time of day, and so get the exact moment as a title
+const ABBREVIATED_STYLES = [ "relative", "time", "date", "date_with_year" ]
+
+export function formatLocalTime(date, style = "relative", now = new Date()) {
+  switch (style) {
+    case "relative":
+      return formatRelative(date, now)
+    case "time":
+      return format(formats.time, date)
+    case "date":
+      return formatDate(date, now)
+    case "date_with_year":
+      return format(formats.dateWithYear, date)
+    case "weekday_date":
+      return format(formats.weekdayDate, date)
+    case "datetime":
+      return format(formats.datetime, date)
+    default:
+      throw new Error(`Unknown local time style: ${style}`)
+  }
+}
+
+export function localTimeTitle(date, style = "relative") {
+  if (ABBREVIATED_STYLES.includes(style)) {
+    return format(formats.exact, date)
+  } else {
+    return null
+  }
+}
+
+// "1:42 PM" today, "yesterday", "5 days ago", "tomorrow", "in 3 days", and a date from a week away
+function formatRelative(date, now) {
+  const days = differenceInLocalDays(now, date)
+
+  if (days === 0) {
+    return format(formats.time, date)
+  } else if (Math.abs(days) < DAYS_IN_A_WEEK) {
+    return formats.relativeDays.format(days, "day")
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+// "Sep 12", or "Sep 12, 2024" when it's not this year
+function formatDate(date, now) {
+  return format(date.getFullYear() === now.getFullYear() ? formats.date : formats.dateWithYear, date)
+}
+
+// Newer ICU versions put a narrow no-break space before AM/PM. Keep the plain space the app has always shown.
+function format(dateTimeFormat, date) {
+  return dateTimeFormat.format(date).replace(/[\u202f\u00a0]/g, " ")
+}
+
+// Calendar days apart in the viewer's timezone, so 11 PM to 1 AM counts as a day, not two hours
+function differenceInLocalDays(from, to) {
+  return Math.round((startOfLocalDay(to) - startOfLocalDay(from)) / MILLISECONDS_PER_DAY)
+}
+
+function startOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
