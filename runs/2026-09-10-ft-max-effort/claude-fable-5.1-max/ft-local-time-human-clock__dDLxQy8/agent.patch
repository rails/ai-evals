diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..8ad1ca8 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,24 @@
 module TimeHelper
+  # Renders a <time> element that the browser turns into words in the viewer's own timezone
+  # (see local_time_controller.js). The server only sends the raw timestamp, so the HTML is
+  # the same for everyone and can be cached and shared between people.
+  #
+  # Styles:
+  #   :relative       "1:42 PM" today, "yesterday", "5 days ago", "tomorrow", "in 3 days", further out "Sep 12" or "Sep 12, 2024"
+  #   :time           "1:42 PM"
+  #   :date           "Sep 12", or "Sep 12, 2024" when it's not this year
+  #   :date_with_year "Sep 12, 2025"
+  #   :weekday_date   "Friday, September 12"
+  #   :datetime       "9/12/25, 1:42 PM"
+  def local_time_tag(time, style: :relative, **attributes)
+    data = attributes.delete(:data).to_h
+    css_class = token_list("local-time-value", attributes.delete(:class))
+
+    tag.time class: css_class, datetime: time.utc.iso8601, **attributes, data: {
+      controller: "local-time",
+      local_time_style_value: style,
+      action: "turbo:morph-element->local-time#render:self",
+      **data
+    }
+  end
 end
