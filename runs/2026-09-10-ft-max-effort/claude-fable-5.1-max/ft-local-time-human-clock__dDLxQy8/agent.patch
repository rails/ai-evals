diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..8f24e8e
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  setup do
+    @time = Time.utc(2025, 1, 22, 17, 30)
+  end
+
+  test "local_time_tag leaves the words to the browser" do
+    assert_equal_html \
+      %(<time class="local-time-value" datetime="2025-01-22T17:30:00Z" data-controller="local-time" data-local-time-style-value="relative" data-action="turbo:morph-element->local-time#render:self"></time>),
+      local_time_tag(@time)
+  end
+
+  test "local_time_tag sends the same raw timestamp whatever the server's timezone" do
+    utc = local_time_tag(@time)
+
+    Time.use_zone("Asia/Tokyo") do
+      assert_equal utc, local_time_tag(@time.in_time_zone)
+      assert_equal utc, local_time_tag(Time.zone.parse("2025-01-23 02:30"))
+    end
+  end
+
+  test "local_time_tag with a style" do
+    assert_select parse(local_time_tag(@time, style: :date)), "time[data-local-time-style-value=date]"
+    assert_select parse(local_time_tag(@time, style: :weekday_date)), "time[data-local-time-style-value=weekday_date]"
+  end
+
+  test "local_time_tag with other attributes" do
+    tag = parse(local_time_tag(@time, class: "txt-small", id: "when", data: { bridge__stamp_target: "description" }))
+
+    assert_select tag, "time#when.local-time-value.txt-small[data-bridge--stamp-target=description]"
+    assert_select tag, "time[data-controller=local-time][data-action]"
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
