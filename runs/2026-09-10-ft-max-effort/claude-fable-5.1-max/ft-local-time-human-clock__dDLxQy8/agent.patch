+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  # Far enough from the server's UTC that the day is often a different one
+  VIEWER_TIMEZONE = "Pacific/Auckland"
+
+  setup do
+    view_from VIEWER_TIMEZONE
+    sign_in_as users(:david)
+
+    @card = cards(:logo)
+    @today = Time.current.in_time_zone(VIEWER_TIMEZONE).beginning_of_day
+  end
+
+  test "comments are stamped in the viewer's own timezone" do
+    this_morning = comment_at(@today + 1.minute)
+    last_night = comment_at(@today - 1.minute)
+    earlier_this_week = comment_at(@today - 5.days)
+    a_while_ago = comment_at(@today - 10.days)
+
+    visit card_url(@card)
+
+    assert_selector "##{dom_id(this_morning)} time", text: /\A12:01 AM\z/i
+    assert_selector "##{dom_id(last_night)} time", text: /\Ayesterday\z/i
+    assert_selector "##{dom_id(earlier_this_week)} time", text: /\A5 days ago\z/i
+    assert_selector "##{dom_id(a_while_ago)} time", text: /\A#{(@today - 10.days).strftime("%b %-d")}/i
+    assert_selector "##{dom_id(a_while_ago)} time[title='#{(@today - 10.days).strftime("%A, %B %-d, %Y at %-l:%M %p")}']"
+  end
+
+  test "card metadata is in the viewer's own timezone" do
+    @card.update!(created_at: @today - 1.minute, last_active_at: @today + 1.minute)
+
+    visit card_url(@card)
+
+    assert_selector ".card__meta-text--added time", text: /\Ayesterday\z/i
+    assert_selector ".card__meta-text--updated time", text: /\A12:01 AM\z/i
+  end
+
+  test "auto-closing is announced in the viewer's own timezone" do
+    @card.update!(last_active_at: @today + 1.day + 1.minute - @card.auto_postpone_period)
+    visit card_url(@card)
+    assert_selector ".card-perma__closure-message", text: /Moves to “Not Now” tomorrow if there’s no activity/i
+
+    @card.update!(last_active_at: @today + 3.days + 1.minute - @card.auto_postpone_period)
+    visit card_url(@card)
+    assert_selector ".card-perma__closure-message", text: /Moves to “Not Now” in 3 days if there’s no activity/i
+  end
+
+  test "the same HTML reads differently for a viewer elsewhere" do
+    comment = comment_at(Time.current)
+
+    visit card_url(@card)
+    assert_selector "##{dom_id(comment)} time", text: /\A#{comment.created_at.in_time_zone(VIEWER_TIMEZONE).strftime("%-l:%M %p")}\z/i
+
+    view_from "America/Los_Angeles"
+    visit card_url(@card)
+    assert_selector "##{dom_id(comment)} time", text: /\A#{comment.created_at.in_time_zone("America/Los_Angeles").strftime("%-l:%M %p")}\z/i
+  end
+
+  test "times survive a page refresh morph" do
+    Current.user = users(:kevin)
+    comment = comment_at(@today - 1.minute)
+
+    visit card_url(@card)
+    assert_selector "##{dom_id(comment)} time", text: /\Ayesterday\z/i
+
+    update_card_elsewhere
+    assert_selector "h1", text: "Retitled elsewhere", wait: 5
+
+    assert_selector "##{dom_id(comment)} time", text: /\Ayesterday\z/i
+  end
+
+  private
+    def view_from(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def comment_at(time)
+      @card.comments.create!(body: "Posted at #{time.utc.iso8601}", creator: users(:kevin), created_at: time)
+    end
+
+    def update_card_elsewhere
+      wait_for_cable_subscriptions
+      @card.update!(title: "Retitled elsewhere")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
