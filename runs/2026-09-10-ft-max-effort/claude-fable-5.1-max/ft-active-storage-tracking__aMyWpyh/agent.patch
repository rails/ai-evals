diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..13975ca
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,37 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit -> { account.recalculate_bytes_used_later }
+  end
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used
+    update_columns bytes_used: blobs.sum(:byte_size)
+    account.recalculate_bytes_used
+  end
+
+  private
+    # Only card images and the files embedded in the descriptions of the board and its cards,
+    # and in the comments on those cards, count towards the storage used.
+    def blobs
+      ActiveStorage::Blob.where(id: card_images.or(embeds).select(:blob_id))
+    end
+
+    def card_images
+      ActiveStorage::Attachment.where(record: cards, name: "image")
+    end
+
+    def embeds
+      ActiveStorage::Attachment.where(record: rich_texts, name: "embeds")
+    end
+
+    def rich_texts
+      ActionText::RichText.where(record: self)
+        .or(ActionText::RichText.where(record: cards))
+        .or(ActionText::RichText.where(record: Comment.where(card: cards)))
+    end
+end
