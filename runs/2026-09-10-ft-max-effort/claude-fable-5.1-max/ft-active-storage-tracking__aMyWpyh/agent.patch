index 0000000..3d96359
--- /dev/null
+++ b/app/jobs/board/recalculate_bytes_used_job.rb
@@ -0,0 +1,11 @@
+class Board::RecalculateBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Recalculations for the same account run one at a time, so that a slower job can't
+  # overwrite a fresher total with a stale one when lots of attachments change at once.
+  limits_concurrency key: ->(board) { board.account_id }, group: "bytes_used"
+
+  def perform(board)
+    board.recalculate_bytes_used
+  end
+end
