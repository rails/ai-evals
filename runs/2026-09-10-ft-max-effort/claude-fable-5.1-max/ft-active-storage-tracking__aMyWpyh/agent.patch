@@ -56,3 +56,29 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorage
+  module Extensions
+    module Attachment
+      extend ActiveSupport::Concern
+
+      prepended do
+        after_commit :recalculate_board_bytes_used_later, on: [ :create, :destroy ]
+      end
+
+      # Purging and detaching delete the attachment without running its callbacks.
+      def delete
+        super.tap { recalculate_board_bytes_used_later }
+      end
+
+      private
+        def recalculate_board_bytes_used_later
+          record.try(:board)&.recalculate_bytes_used_later
+        end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend ActiveStorage::Extensions::Attachment
+end
