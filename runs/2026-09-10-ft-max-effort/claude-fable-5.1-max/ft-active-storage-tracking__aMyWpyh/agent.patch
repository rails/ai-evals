diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..376cd55
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "bytes used is the sum of the bytes used by its boards" do
+    boards(:writebook).update_columns bytes_used: 300
+    boards(:private).update_columns bytes_used: 200
+    boards(:miltons_wish_list).update_columns bytes_used: 100
+
+    @account.recalculate_bytes_used
+    assert_equal 500, @account.reload.bytes_used
+
+    accounts(:initech).recalculate_bytes_used
+    assert_equal 100, accounts(:initech).reload.bytes_used
+  end
+
+  test "bytes used is recalculated in the background" do
+    assert_enqueued_with job: Account::RecalculateBytesUsedJob, args: [ @account ] do
+      @account.recalculate_bytes_used_later
+    end
+  end
+
+  test "destroying a board reduces bytes used" do
+    boards(:writebook).update_columns bytes_used: 300
+    boards(:private).update_columns bytes_used: 200
+    @account.update_columns bytes_used: 500
+
+    assert_enqueued_with job: Account::RecalculateBytesUsedJob, args: [ @account ] do
+      boards(:private).destroy!
+    end
+
+    perform_enqueued_jobs only: Account::RecalculateBytesUsedJob
+    assert_equal 300, @account.reload.bytes_used
+  end
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..ddb86fb
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,203 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+  end
+
+  test "bytes used is recalculated in the background" do
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      cards(:logo).image.attach(moon)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "card images count towards bytes used" do
+    cards(:logo).image.attach(moon)
+    cards(:layout).image.attach(moon)
+
+    perform_recalculations
+    assert_equal moon_size * 2, @board.reload.bytes_used
+  end
+
+  test "files embedded in card descriptions count towards bytes used" do
+    cards(:logo).update!(description: "<p>Look at this</p>#{embed(moon_blob)}")
+
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "files embedded in comments count towards bytes used" do
+    cards(:logo).comments.create!(body: "<p>Look at this</p>#{embed(moon_blob)}")
+
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "files embedded in the board description count towards bytes used" do
+    @board.update!(public_description: "<p>Look at this</p>#{embed(moon_blob)}")
+
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "other attachments don't count towards bytes used" do
+    users(:david).avatar.attach(moon)
+
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "remote images don't count towards bytes used" do
+    cards(:logo).update!(description: '<action-text-attachment url="https://example.com/moon.jpg" content-type="image/jpeg"></action-text-attachment>')
+
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "purging a card image reduces bytes used" do
+    cards(:logo).image.attach(moon)
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+
+    cards(:logo).image.purge_later
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "purging an attachment directly reduces bytes used" do
+    cards(:logo).image.attach(moon)
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+
+    ActiveStorage::Attachment.find(cards(:logo).image_attachment.id).purge
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "detaching a card image reduces bytes used" do
+    cards(:logo).image.attach(moon)
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+
+    cards(:logo).image.detach
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "replacing a card image updates bytes used" do
+    cards(:logo).image.attach(moon)
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+
+    cards(:logo).image.attach(avatar)
+    perform_recalculations
+    assert_equal avatar_size, @board.reload.bytes_used
+  end
+
+  test "removing an embedded file from a description reduces bytes used" do
+    cards(:logo).update!(description: "<p>Look at this</p>#{embed(moon_blob)}")
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+
+    cards(:logo).update!(description: "<p>Never mind</p>")
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a comment reduces bytes used" do
+    comment = cards(:logo).comments.create!(body: "<p>Look at this</p>#{embed(moon_blob)}")
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+
+    comment.destroy!
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a card reduces bytes used" do
+    card = cards(:logo)
+    card.image.attach(moon)
+    card.update!(description: "<p>Look at this</p>#{embed(avatar_blob)}")
+    card.comments.create!(body: "<p>And this</p>#{embed(avatar_blob)}")
+    perform_recalculations
+    assert_equal moon_size + avatar_size * 2, @board.reload.bytes_used
+
+    card.destroy!
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "moving a card to another board moves its bytes used along" do
+    card = cards(:logo)
+    card.image.attach(moon)
+    card.comments.create!(body: "<p>Look at this</p>#{embed(avatar_blob)}")
+    perform_recalculations
+    assert_equal moon_size + avatar_size, @board.reload.bytes_used
+    assert_equal 0, boards(:private).reload.bytes_used
+
+    card.move_to boards(:private)
+    perform_recalculations
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal moon_size + avatar_size, boards(:private).reload.bytes_used
+  end
+
+  test "destroying a board reduces the account's bytes used" do
+    cards(:logo).image.attach(moon)
+    boards(:private).cards.create!(title: "Private", image: avatar, status: :published)
+    perform_recalculations
+    assert_equal moon_size + avatar_size, accounts(:"37s").reload.bytes_used
+
+    boards(:private).destroy!
+    perform_recalculations
+    assert_equal moon_size, accounts(:"37s").reload.bytes_used
+  end
+
+  test "recalculating bytes used rolls up into the account" do
+    cards(:logo).image.attach(moon)
+    boards(:private).cards.create!(title: "Private", image: avatar, status: :published)
+
+    perform_recalculations
+    assert_equal moon_size, @board.reload.bytes_used
+    assert_equal avatar_size, boards(:private).reload.bytes_used
+    assert_equal moon_size + avatar_size, accounts(:"37s").reload.bytes_used
+  end
+
+  private
+    def perform_recalculations
+      perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+    end
+
+    def moon
+      { io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg" }
+    end
+
+    def moon_size
+      file_fixture("moon.jpg").size
+    end
+
+    def moon_blob
+      ActiveStorage::Blob.create_and_upload!(**moon)
+    end
+
+    def avatar
+      { io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png" }
+    end
+
+    def avatar_size
+      file_fixture("avatar.png").size
+    end
+
+    def avatar_blob
+      ActiveStorage::Blob.create_and_upload!(**avatar)
+    end
+
+    def embed(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
