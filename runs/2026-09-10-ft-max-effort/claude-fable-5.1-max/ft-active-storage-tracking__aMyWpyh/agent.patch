diff --git a/script/migrations/20260716-backfill-bytes-used.rb b/script/migrations/20260716-backfill-bytes-used.rb
new file mode 100755
index 0000000..9202b0a
--- /dev/null
+++ b/script/migrations/20260716-backfill-bytes-used.rb
@@ -0,0 +1,15 @@
+# Backfill the storage used by every board and account, which is otherwise only
+# recalculated when attachments change.
+#
+# Usage:
+#   bin/rails runner script/migrations/20260716-backfill-bytes-used.rb
+#
+total = Board.count
+puts "Recalculating bytes used for #{total} boards\n\n"
+
+Board.find_each.with_index do |board, index|
+  puts "[#{index + 1}/#{total}] #{board.name} (#{board.id})"
+  board.recalculate_bytes_used
+end
+
+puts "\nDone."
