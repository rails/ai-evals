@@ -0,0 +1,10 @@
+class Account::RecalculateBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Takes turns with the recalculations of the account's boards, which roll up into its total.
+  limits_concurrency key: ->(account) { account.id }, group: "bytes_used"
+
+  def perform(account)
+    account.recalculate_bytes_used
+  end
+end
