+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions_list)
+
+    reaction = @comment.reactions.last
+    assert_equal "🎉", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "create broadcasts the reaction to everyone looking at the card" do
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+      assert_turbo_stream_broadcasts([ @comment.card, :activity ], count: 1) do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+      end
+    end
+  end
+
+  test "create with content longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "This is way too long" } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on a system comment is not allowed" do
+    system_comment = comments(:logo_1)
+
+    assert_no_difference -> { system_comment.reactions.count } do
+      post card_comment_reactions_path(system_comment.card, system_comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create on a card in a board without access" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy broadcasts the removal to everyone looking at the card" do
+    assert_turbo_stream_broadcasts([ @comment.card, :activity ], count: 1) do
+      delete card_comment_reaction_path(@comment.card, @comment, reactions(:logo_agreement_jz_kevin)), as: :turbo_stream
+    end
+  end
+
+  test "destroy another user's reaction" do
+    reaction = reactions(:logo_agreement_jz_david)
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal %w[ 👍 Agreed! ], @response.parsed_body.map { it["content"] }
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    get card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_comment_reaction_url(@comment.card, @comment, reaction), @response.parsed_body["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(@comment.card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal Reaction.last.id, @response.parsed_body["id"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { content: "💯" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "💯", Reaction.last.content
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "comment JSON links to its reactions" do
+    get card_comment_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@comment.card, @comment), @response.parsed_body["reactions_url"]
+  end
+end
