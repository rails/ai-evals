+<div id="<%= dom_id(comment, :new_reaction) %>" class="display-contents" data-controller="reaction-form" data-turbo-permanent>
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-form-target="trigger" data-action="reaction-form#expand" data-controller="tooltip">
+    <%= image_tag "boost-color.svg", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <template data-reaction-form-target="template">
+    <div class="reaction reaction__form expanded" data-reaction-form-target="form" data-action="keydown.esc->reaction-form#cancel:stop">
+      <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), class: "display-contents",
+            data: { action: "turbo:submit-end->reaction-form#collapseWhenSubmitted" } do |form| %>
+        <div class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+          <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle">
+            <%= icon_tag "reaction" %>
+            <span class="for-screen-reader">Pick an emoji</span>
+          </button>
+
+          <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog" data-action="keydown.esc->dialog#close:stop">
+            <div class="reaction__emoji-list">
+              <% EmojiHelper::REACTIONS.each do |emoji, description| %>
+                <button type="button" class="btn btn--plain" aria-label="<%= description %>"
+                    data-action="reaction-form#insert dialog#close" data-reaction-form-emoji-param="<%= emoji %>"><%= emoji %></button>
+              <% end %>
+            </div>
+          </dialog>
+        </div>
+
+        <label class="reaction__form-label">
+          <span class="for-screen-reader">Your reaction</span>
+          <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "input reaction__input",
