diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..685834a
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,57 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_comment_is_reactable, only: :create
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preloaded.chronologically
+
+    fresh_when etag: @reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def show
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_comment_is_reactable
+      head :forbidden unless @comment.reactable?
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..9828023
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,13 @@
+module ReactionsHelper
+  EMOJI = /\p{Extended_Pictographic}|\p{Regional_Indicator}/
+  EMOJI_COMPONENT = /\p{Emoji_Modifier}|\u200D|\uFE0F|\u20E3/
+  EMOJI_ONLY = /\A(?:#{EMOJI}|#{EMOJI_COMPONENT}|\s)+\z/
+
+  def reaction_content_tag(reaction)
+    tag.span reaction.content, class: class_names("txt-small", "txt-medium": emoji_only?(reaction.content))
+  end
+
+  def emoji_only?(content)
+    content.match?(EMOJI_ONLY) && content.match?(EMOJI)
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..7f2e358
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,60 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded", "deleting" ]
+
+  connect() {
+    if (this.#deleteable) {
+      this.element.classList.add(this.deleteableClass)
+      this.element.tabIndex = 0
+    }
+  }
+
+  toggle({ target }) {
+    if (this.#deleteable && !target.closest("a, form")) {
+      this.#toggleExpanded()
+    }
+  }
+
+  toggleWithKeyboard(event) {
+    if (this.#deleteable && event.target === this.element) {
+      event.preventDefault()
+      this.#toggleExpanded()
+    }
+  }
+
+  collapse(event) {
+    if (this.#expanded) {
+      event.stopPropagation()
+      this.#collapse()
+    }
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.#collapse()
+  }
+
+  deleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  deletionEnded({ detail: { success } }) {
+    if (!success) this.element.classList.remove(this.deletingClass)
+  }
+
+  #toggleExpanded() {
+    this.element.classList.toggle(this.expandedClass)
+  }
+
+  #collapse() {
+    this.element.classList.remove(this.expandedClass)
+  }
+
+  get #deleteable() {
+    return Current.user?.id === this.element.dataset.creatorId
+  }
+
+  get #expanded() {
+    return this.element.classList.contains(this.expandedClass)
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..f1badfa
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,35 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "template", "form", "input" ]
+
+  expand() {
+    this.triggerTarget.hidden = true
+    this.triggerTarget.after(this.templateTarget.content.cloneNode(true))
+    this.inputTarget.focus()
+  }
+
+  insert({ params: { emoji } }) {
+    const input = this.inputTarget
+
+    if (input.value.length + emoji.length <= input.maxLength) {
+      input.setRangeText(emoji, input.selectionStart, input.selectionEnd, "end")
+    }
+
+    input.focus()
+  }
+
+  cancel() {
+    this.#collapse()
+  }
+
+  collapseWhenSubmitted({ detail: { success } }) {
+    if (success) this.#collapse()
+  }
+
+  #collapse() {
+    if (this.hasFormTarget) this.formTarget.remove()
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus({ preventScroll: true })
+  }
+}
