+        </label>
+
+        <button type="submit" class="reaction__submit-btn btn btn--circle borderless">
+          <%= icon_tag "check" %>
+          <span class="for-screen-reader">Add reaction</span>
+        </button>
+
+        <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reaction-form#cancel">
+          <%= icon_tag "close" %>
+          <span class="for-screen-reader">Cancel</span>
+        </button>
+      <% end %>
