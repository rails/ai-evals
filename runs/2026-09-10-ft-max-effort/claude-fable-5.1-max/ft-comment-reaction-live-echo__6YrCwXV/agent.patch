+
+  included do
+    after_create_commit :broadcast_addition
+    after_destroy_commit :broadcast_removal
+  end
+
+  private
+    def broadcast_addition
+      broadcast_append_later_to card, :activity, target: [ comment, :reactions_list ], partial: "cards/comments/reactions/reaction"
