+require "test_helper"
+
+class Reaction::BroadcastableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "creating a reaction appends it to the comment's reactions for everyone looking at the card" do
+    reaction = @comment.reactions.create!(content: "🔥")
+
+    stream = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    end.sole
+
+    assert_equal "append", stream["action"]
+    assert_equal dom_id(@comment, :reactions_list), stream["target"]
+    assert_includes stream.to_html, %(id="#{dom_id(reaction)}")
+    assert_includes stream.to_html, "🔥"
+  end
+
+  test "broadcast renders account-scoped URLs" do
+    @comment.reactions.create!(content: "🔥")
+
+    stream = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    end.sole
+
+    assert_includes stream.to_html, %(action="#{@comment.account.slug}/cards/)
+  end
+
+  test "destroying a reaction removes it for everyone looking at the card" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    stream = capture_turbo_stream_broadcasts([ reaction.card, :activity ]) do
+      reaction.destroy
+    end.sole
+
+    assert_equal "remove", stream["action"]
+    assert_equal dom_id(reaction), stream["target"]
+  end
+end
