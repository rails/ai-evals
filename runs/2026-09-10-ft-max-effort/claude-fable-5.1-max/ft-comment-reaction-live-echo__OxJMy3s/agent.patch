+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list" data-reactions-target="emojiList"></div>
+      </dialog>
+    </div>
+
+    <%= form.label :content, class: "reaction__form-label", for: nil do %>
+      <span class="for-screen-reader">Your reaction</span>
+      <%= form.text_field :content, id: nil, class: "input reaction__input", placeholder: "…", required: true, autocomplete: "off",
+            maxlength: Reaction::CONTENT_MAXIMUM_LENGTH, data: { reactions_target: "input", "1p-ignore": "true" } %>
+    <% end %>
+
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add your reaction</span>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reactions#collapse">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-reactions-target="trigger" data-action="reactions#expand">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+</div>
