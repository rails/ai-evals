+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create defaults the reacter to the current user and the account to the comment's" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment.card, reaction.card
+  end
+
+  test "content is stripped" do
+    reaction = @comment.reactions.create!(content: "  Nice one  ")
+
+    assert_equal "Nice one", reaction.content
+  end
+
+  test "content is required" do
+    reaction = @comment.reactions.build(content: "   ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.build(content: "x" * 16).valid?
+    assert @comment.reactions.build(content: "❤️" * 8).valid?
+    assert_not @comment.reactions.build(content: "x" * 17).valid?
+  end
+
+  test "reactions are listed chronologically" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_equal [ reactions(:logo_agreement_kevin_thumbs_up_by_jz), reactions(:logo_agreement_kevin_praise_by_david) ], comment.reactions.to_a
+
+    latest = comment.reactions.create!(content: "🎉")
+    assert_equal latest, comment.reload.reactions.last
+  end
+
+  test "creating a reaction touches the comment and registers activity on the card" do
+    card = @comment.card
+
+    assert_changes -> { @comment.reload.updated_at } do
+      assert_changes -> { card.reload.last_active_at } do
+        @comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "creating a reaction refreshes the card for everyone looking at it" do
+    assert_turbo_stream_broadcasts @comment.card do
+      @comment.reactions.create!(content: "👍")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { Reaction.count }, -comment.reactions.count do
+      comment.destroy
+    end
+  end
+
+  test "system comments are not reactable" do
+    assert_not comments(:logo_1).reactable?
+    assert comments(:logo_agreement_kevin).reactable?
+  end
+end
