+require "test_helper"
+
+class EmojiHelperTest < ActionView::TestCase
+  test "emoji only" do
+    assert emoji_only?("👍")
+    assert emoji_only?("❤️")
+    assert emoji_only?("🎉 🥳")
+    assert emoji_only?("👍🏽")
+    assert emoji_only?("👨‍👩‍👧‍👦")
+
+    EmojiHelper::REACTIONS.each_key do |emoji|
+      assert emoji_only?(emoji), "Expected #{emoji} to count as emoji"
+    end
+  end
+
+  test "text is not emoji only" do
+    assert_not emoji_only?("Great 👍")
+    assert_not emoji_only?("Nice one")
+    assert_not emoji_only?("100")
+    assert_not emoji_only?("")
+    assert_not emoji_only?(nil)
+  end
+end
