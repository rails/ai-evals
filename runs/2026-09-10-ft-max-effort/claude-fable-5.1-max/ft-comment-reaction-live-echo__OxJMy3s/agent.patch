+    data-reactions-emoji-list-template-value="reaction_emoji_list">
+  <%= form_with model: [ comment.card, comment, Reaction.new ], class: "reaction__form", html: { hidden: true },
+        data: { reactions_target: "form", action: "keydown.esc->reactions#collapse:stop turbo:submit-end->reactions#collapseWhenSubmitted" } do |form| %>
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle">
