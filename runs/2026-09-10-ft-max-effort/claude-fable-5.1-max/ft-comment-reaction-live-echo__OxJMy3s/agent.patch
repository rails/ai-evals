new file mode 100644
index 0000000..3494dfb
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,42 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Marks the current user's own reactions as deleteable: clicking one reveals the button to remove it
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  connect() {
+    this.markAsDeleteable()
+  }
+
+  // Also runs after a page refresh morphs the reaction, since that resets its classes and attributes
+  markAsDeleteable() {
+    const deleteable = this.#reactedByCurrentUser
+
+    this.element.classList.toggle(this.deleteableClass, deleteable)
+
+    if (deleteable) {
+      this.element.setAttribute("tabindex", "0")
+    } else {
+      this.element.removeAttribute("tabindex")
+    }
+  }
+
+  toggle(event) {
+    if (this.#reactedByCurrentUser && !event.target.closest("form, a")) {
+      this.element.classList.toggle(this.expandedClass)
+    }
+  }
+
+  fadeOut() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  fadeInUnlessRemoved({ detail: { success } }) {
+    if (!success) this.element.classList.remove(this.deletingClass)
+  }
+
+  get #reactedByCurrentUser() {
+    return this.reacterIdValue === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..ba3151b
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,50 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the "add a reaction" button for a small form, and puts the button back once the reaction is in the strip
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "emojiList" ]
+  static classes = [ "reaction", "expanded" ]
+  static values = { emojiListTemplate: String }
+
+  expand() {
+    this.#loadEmojiList()
+
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add(this.reactionClass, this.expandedClass)
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.formTarget.reset()
+    this.formTarget.classList.remove(this.reactionClass, this.expandedClass)
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  collapseWhenSubmitted({ detail: { success } }) {
+    if (success) this.collapse()
+  }
+
+  insertEmoji({ params: { emoji } }) {
+    const content = this.inputTarget.value + emoji
+
+    if (content.length <= this.inputTarget.maxLength) {
+      this.inputTarget.value = content
+    }
+
+    this.inputTarget.focus()
+  }
+
+  // The emoji list is rendered once per page; each form clones it the first time it opens
+  #loadEmojiList() {
+    if (this.emojiListTarget.childElementCount === 0 && this.#emojiListTemplate) {
+      this.emojiListTarget.append(this.#emojiListTemplate.content.cloneNode(true))
+    }
+  }
+
+  get #emojiListTemplate() {
+    return document.getElementById(this.emojiListTemplateValue)
+  }
+}
