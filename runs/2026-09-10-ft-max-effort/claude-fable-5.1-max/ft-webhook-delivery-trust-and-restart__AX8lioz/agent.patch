+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "events are relayed after they are created" do
+    assert_enqueued_with job: Event::RelayJob do
+      cards(:logo).close
+    end
+  end
+
+  test "relaying an event delivers it to the active webhooks subscribed to its action" do
+    webhook = webhooks(:active)
+    unsubscribed = boards(:writebook).webhooks.create!(name: "Comments only", url: "https://example.com/comments", subscribed_actions: %w[ comment_created ])
+    inactive = boards(:writebook).webhooks.create!(name: "Inactive", url: "https://example.com/inactive", subscribed_actions: %w[ card_closed ], active: false)
+    other_board = boards(:private).webhooks.create!(name: "Other board", url: "https://example.com/other", subscribed_actions: %w[ card_closed ])
+
+    cards(:logo).close
+    event = cards(:logo).events.find_by!(action: "card_closed")
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      event.relay_now
+    end
+
+    assert webhook.deliveries.exists?(event: event)
+    assert_not unsubscribed.deliveries.exists?(event: event)
+    assert_not inactive.deliveries.exists?(event: event)
+    assert_not other_board.deliveries.exists?(event: event)
+  end
+
+  test "relaying an event more than once still delivers it once" do
+    event = events(:shipping_closed)
+    webhook_deliveries(:pending).destroy
+
+    assert_difference -> { webhooks(:active).deliveries.count }, +1 do
+      event.relay_now
+      event.relay_now
+    end
+  end
+
+  test "an event is delivered exactly once, end to end" do
+    request = stub_request(:post, webhooks(:active).url).to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).close
+    end
+
+    assert_requested request, times: 1
+
+    delivery = webhooks(:active).deliveries.find_by!(event: cards(:logo).events.find_by!(action: "card_closed"))
+    assert delivery.succeeded?
+  end
+
+  test "deliveries are deleted along with the event" do
+    event = events(:logo_published)
+    assert event.webhook_deliveries.any?
+
+    assert_difference -> { Webhook::Delivery.count }, -event.webhook_deliveries.count do
+      event.destroy
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..e285bdf
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @tracker = webhook_delinquency_trackers(:active)
+  end
+
+  test "tracking a failed delivery counts consecutive failures from the first one" do
+    freeze_time do
+      @tracker.track failed_delivery
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+
+    travel 10.minutes do
+      @tracker.track failed_delivery
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal 10.minutes.ago, @tracker.first_failure_at
+    end
+  end
+
+  test "tracking a successful delivery resets the failures" do
+    3.times { @tracker.track failed_delivery }
+
+    @tracker.track successful_delivery
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "not delinquent until enough deliveries fail in a row" do
+    travel_to 2.hours.ago do
+      9.times { @tracker.track failed_delivery }
+    end
+
+    assert_not @tracker.delinquent?
+
+    @tracker.track failed_delivery
+    assert @tracker.delinquent?
+  end
+
+  test "not delinquent when failing for less than an hour, even if many deliveries failed" do
+    12.times { @tracker.track failed_delivery }
+    assert_not @tracker.delinquent?
+
+    travel 61.minutes do
+      assert @tracker.delinquent?
+    end
+  end
+
+  test "a successful delivery in between prevents delinquency" do
+    travel_to 2.hours.ago do
+      9.times { @tracker.track failed_delivery }
+    end
+
+    @tracker.track successful_delivery
+    @tracker.track failed_delivery
+
+    assert_not @tracker.delinquent?
+    assert_equal 1, @tracker.consecutive_failures_count
+  end
+
+  test "reset" do
+    tracker = webhook_delinquency_trackers(:inactive)
+    assert tracker.delinquent?
+
+    tracker.reset
+
+    assert_not tracker.delinquent?
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new(webhook: @tracker.webhook, event: events(:logo_published), state: :errored, response: { error: "timed_out" })
+    end
+
+    def successful_delivery
+      Webhook::Delivery.new(webhook: @tracker.webhook, event: events(:logo_published), state: :completed, response: { code: 200 })
+    end
+end
diff --git a/test/models/webhook/delinquent_test.rb b/test/models/webhook/delinquent_test.rb
new file mode 100644
index 0000000..92fb20a
--- /dev/null
+++ b/test/models/webhook/delinquent_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Webhook::DelinquentTest < ActiveSupport::TestCase
+  test "a delinquency tracker is created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "the delinquency tracker is destroyed along with the webhook" do
+    webhook = webhooks(:active)
+
+    assert_difference -> { Webhook::DelinquencyTracker.count }, -1 do
+      webhook.destroy
+    end
+  end
+
+  test "tracking failed deliveries deactivates the webhook once it becomes delinquent" do
+    webhook = webhooks(:active)
+
+    travel_to 2.hours.ago do
+      9.times { webhook.track_delivery failed_delivery_for(webhook) }
+    end
+
+    assert webhook.active?
+    assert_not webhook.delinquent?
+
+    webhook.track_delivery failed_delivery_for(webhook)
+
+    assert webhook.delinquent?
+    assert_not webhook.active?
+  end
+
+  test "tracking a successful delivery keeps the webhook active" do
+    webhook = webhooks(:active)
+    webhook.delinquency_tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+
+    webhook.track_delivery successful_delivery_for(webhook)
+
+    assert webhook.active?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "reactivating a webhook forgives its past failures" do
+    webhook = webhooks(:inactive)
+    assert webhook.delinquent?
+
+    webhook.activate
+
+    assert webhook.active?
+    assert_not webhook.delinquent?
+    assert_equal 0, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  private
+    def failed_delivery_for(webhook)
+      Webhook::Delivery.new(webhook: webhook, event: events(:logo_published), state: :completed, response: { code: 500 })
+    end
+
+    def successful_delivery_for(webhook)
+      Webhook::Delivery.new(webhook: webhook, event: events(:logo_published), state: :completed, response: { code: 200 })
+    end
+end
