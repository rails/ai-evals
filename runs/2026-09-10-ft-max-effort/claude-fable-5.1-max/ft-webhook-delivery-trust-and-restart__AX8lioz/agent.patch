@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Webhook::Delivery::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:logo_published)
+    @card_url = "http://example.com#{accounts(:"37s").slug}/cards/#{cards(:logo).number}"
+  end
+
+  test "payload for a generic webhook is the event as JSON" do
+    payload = payload_for "https://api.example.com/webhooks"
+
+    assert_equal "application/json", payload.content_type
+
+    body = JSON.parse(payload.body)
+    assert_equal @event.id, body["id"]
+    assert_equal "card_published", body["action"]
+    assert_equal @event.created_at.utc.iso8601(3), body["created_at"]
+    assert_equal cards(:logo).id, body.dig("eventable", "id")
+    assert_equal "The logo isn't big enough", body.dig("eventable", "title")
+    assert_equal @card_url, body.dig("eventable", "url")
+    assert_equal boards(:writebook).id, body.dig("board", "id")
+    assert_equal users(:david).id, body.dig("creator", "id")
+  end
+
+  test "payload for a comment event includes the comment" do
+    payload = payload_for "https://api.example.com/webhooks", event: events(:layout_commented)
+
+    body = JSON.parse(payload.body)
+    assert_equal "comment_created", body["action"]
+    assert_equal comments(:layout_overflowing_david).id, body.dig("eventable", "id")
+    assert_equal cards(:layout).id, body.dig("eventable", "card", "id")
+  end
+
+  test "payload for Slack is a message in Slack's markup" do
+    payload = payload_for "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx"
+
+    assert_equal "application/json", payload.content_type
+    assert_equal({ "text" => %(David added "The logo isn't big enough" <#{@card_url}|↗︎>) }, JSON.parse(payload.body))
+  end
+
+  test "payload for Slack only escapes what Slack expects escaped" do
+    cards(:logo).update_column :title, %(Fix <b> tag & "quotes")
+
+    payload = payload_for "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx"
+
+    assert_equal %(David added "Fix &lt;b&gt; tag &amp; "quotes"" <#{@card_url}|↗︎>), JSON.parse(payload.body)["text"]
+  end
+
+  test "payload for Campfire is an HTML message" do
+    payload = payload_for "https://chat.example.com/rooms/1/2-bot/messages"
+
+    assert_equal "text/html", payload.content_type
+    assert_equal %(David added &quot;The logo isn&#39;t big enough&quot; <a href="#{@card_url}">↗︎</a>), payload.body
+  end
+
+  test "payload for a Basecamp chatbot is an HTML message as JSON" do
+    payload = payload_for "https://3.basecamp.com/123/integrations/abc/buckets/456/chats/789/lines"
+
+    assert_equal "application/json", payload.content_type
+    assert_equal({ "content" => %(David added &quot;The logo isn&#39;t big enough&quot; <a href="#{@card_url}">↗︎</a>) }, JSON.parse(payload.body))
+  end
+
+  test "payload links use the configured base URL" do
+    with_default_url_options host: "fizzy.example.org", protocol: "https", port: 8443 do
+      payload = payload_for "https://api.example.com/webhooks"
+
+      assert_equal "https://fizzy.example.org:8443#{accounts(:"37s").slug}/cards/#{cards(:logo).number}", JSON.parse(payload.body).dig("eventable", "url")
+    end
+  end
+
+  private
+    def payload_for(url, event: @event)
+      webhook = Webhook.create!(name: "Test", url: url, board: boards(:writebook))
+      Webhook::Delivery::Payload.new(webhook.deliveries.create!(event: event))
+    end
+
+    def with_default_url_options(**options)
+      original = Rails.application.routes.default_url_options
+      Rails.application.routes.default_url_options = options
+      yield
+    ensure
+      Rails.application.routes.default_url_options = original
+    end
+end
diff --git a/test/models/webhook/delivery/performable_test.rb b/test/models/webhook/delivery/performable_test.rb
new file mode 100644
index 0000000..b5730d0
--- /dev/null
+++ b/test/models/webhook/delivery/performable_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class Webhook::Delivery::PerformableTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = @webhook.deliveries.create!(event: events(:shipping_published))
+  end
+
+  test "deliver_later enqueues the delivery on the webhooks queue" do
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ @delivery ], queue: "webhooks" do
+      @delivery.deliver_later
+    end
+  end
+
+  test "deliver_now posts the event to the webhook and logs the exchange" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "OK", headers: { "Content-Type" => "text/plain", "X-Request-Id" => "abc123" })
+
+    freeze_time do
+      @delivery.deliver_now
+
+      assert @delivery.completed?
+      assert @delivery.succeeded?
+      assert_equal 200, @delivery.response[:code]
+      assert_equal "abc123", @delivery.response[:headers]["X-Request-Id"]
+      assert_equal Time.current.utc.iso8601(3), @delivery.request[:headers]["X-Webhook-Timestamp"]
+      assert_equal "fizzy/1.0.0 Webhook", @delivery.request[:headers]["User-Agent"]
+      assert_equal "application/json", @delivery.request[:headers]["Content-Type"]
+    end
+
+    assert_requested :post, @webhook.url, times: 1 do |http_request|
+      body = JSON.parse(http_request.body)
+
+      assert_equal "card_published", body["action"]
+      assert_equal cards(:shipping).id, body.dig("eventable", "id")
+      assert_equal "fizzy/1.0.0 Webhook", http_request.headers["User-Agent"]
+      assert_equal "application/json", http_request.headers["Content-Type"]
+      assert_equal @delivery.request[:headers]["X-Webhook-Timestamp"], http_request.headers["X-Webhook-Timestamp"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, http_request.body), http_request.headers["X-Webhook-Signature"]
+    end
+  end
+
+  test "deliver_now logs an unsuccessful response as a completed delivery that failed" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    @delivery.deliver_now
+
+    assert @delivery.completed?
+    assert @delivery.failed?
+    assert_not @delivery.succeeded?
+    assert_equal 500, @delivery.response[:code]
+  end
+
+  test "deliver_now logs connection problems as errored deliveries" do
+    stub_request(:post, @webhook.url).to_timeout
+    @delivery.deliver_now
+    assert @delivery.errored?
+    assert @delivery.failed?
+    assert_equal "timed_out", @delivery.response[:error]
+
+    delivery = @webhook.deliveries.create!(event: events(:shipping_closed))
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    delivery.deliver_now
+    assert delivery.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+
+    delivery = @webhook.deliveries.create!(event: events(:text_published))
+    stub_request(:post, @webhook.url).to_raise(SocketError.new("getaddrinfo: Name or service not known"))
+    delivery.deliver_now
+    assert_equal "destination_unreachable", delivery.response[:error]
+
+    delivery = @webhook.deliveries.create!(event: events(:layout_assignment_jz))
+    stub_request(:post, @webhook.url).to_raise(OpenSSL::SSL::SSLError.new("certificate verify failed"))
+    delivery.deliver_now
+    assert_equal "secure_connection_failed", delivery.response[:error]
+
+    delivery = @webhook.deliveries.create!(event: events(:logo_assignment_david))
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNRESET)
+    delivery.deliver_now
+    assert_equal "connection_failed", delivery.response[:error]
+  end
+
+  test "deliver_now never delivers more than once" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver_now
+    @delivery.deliver_now
+    Webhook::Delivery.find(@delivery.id).deliver_now
+
+    assert_requested request, times: 1
+  end
+
+  test "deliver_now does not retry a delivery that failed" do
+    request = stub_request(:post, @webhook.url).to_timeout
+
+    @delivery.deliver_now
+    @delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert @delivery.errored?
+  end
+
+  test "deliver_now leaves deliveries already in progress alone" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    @delivery.in_progress!
+
+    @delivery.deliver_now
+
+    assert_not_requested request
+    assert @delivery.in_progress?
+  end
+
+  test "deliver_now tracks the outcome for the webhook" do
+    stub_request(:post, @webhook.url).to_return(status: 503)
+    @webhook.delinquency_tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+
+    @delivery.deliver_now
+
+    assert_equal 10, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_not @webhook.reload.active?
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    @webhook.deliveries.create!(event: events(:shipping_closed)).deliver_now
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "performing the job delivers the delivery" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      @delivery.deliver_later
+    end
+
+    assert_requested request, times: 1
+    assert @delivery.reload.succeeded?
+  end
+end
