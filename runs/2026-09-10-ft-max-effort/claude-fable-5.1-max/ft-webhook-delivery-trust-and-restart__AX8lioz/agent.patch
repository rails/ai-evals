+require "test_helper"
+
+class Webhook::DeliverableTest < ActiveSupport::TestCase
+  test "subscribed_to" do
+    webhook = webhooks(:active)
+
+    assert_includes Webhook.subscribed_to("card_published"), webhook
+    assert_includes Webhook.subscribed_to(:card_closed), webhook
+    assert_not_includes Webhook.subscribed_to("comment_created"), webhook
+    assert_not_includes Webhook.subscribed_to("card_unassigned"), webhook, "card_assigned shouldn't match card_unassigned"
+  end
+
+  test "deliver_later creates a delivery for the event and enqueues it" do
+    webhook = webhooks(:active)
+    event = events(:shipping_published)
+
+    assert_difference -> { webhook.deliveries.count }, +1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        webhook.deliver_later(event)
+      end
+    end
+
+    delivery = webhook.deliveries.find_by!(event: event)
+    assert delivery.pending?
+    assert_equal webhook.account, delivery.account
+  end
+
+  test "deliver_later delivers an event to a webhook only once" do
+    webhook = webhooks(:active)
+    event = events(:shipping_published)
+
+    webhook.deliver_later(event)
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      webhook.deliver_later(event)
+    end
+  end
+
+  test "deliveries are deleted along with the webhook" do
+    webhook = webhooks(:active)
+    assert webhook.deliveries.any?
+
+    assert_difference -> { Webhook::Delivery.count }, -webhook.deliveries.count do
+      webhook.destroy
+    end
+  end
+end
