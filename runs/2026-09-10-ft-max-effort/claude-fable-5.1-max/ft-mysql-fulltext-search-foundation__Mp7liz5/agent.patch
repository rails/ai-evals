+module SearchesHelper
+  EXCERPT_RADIUS = 80
+
+  def search_highlight(text, search)
+    highlight text, search.pattern
+  end
+
+  def search_excerpt(text, search)
+    if snippet = excerpt(text, search.pattern, radius: EXCERPT_RADIUS)
+      highlight snippet, search.pattern
+    end
+  end
+end
