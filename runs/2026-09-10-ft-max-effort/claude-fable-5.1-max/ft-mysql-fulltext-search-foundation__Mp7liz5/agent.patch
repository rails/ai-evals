+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  include ::Searchable
+
+  included do
+    scope :matching_any, ->(terms) do
+      Array(terms).map do |term|
+        joins(:rich_text_body).where "action_text_rich_texts.body LIKE :pattern ESCAPE :escape", like_binds_for(term)
+      end.reduce(:or)
+    end
+  end
