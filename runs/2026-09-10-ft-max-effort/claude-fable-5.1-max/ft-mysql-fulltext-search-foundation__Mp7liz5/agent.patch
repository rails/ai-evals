diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..ba74537
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,33 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  include ::Searchable
+
+  # A term matches a card when it appears in the title, the description, or the body of
+  # any of its comments. Every term has to match, but each may do so in a different place.
+  MATCHING_TERM_SQL = <<~SQL.squish
+    cards.title LIKE :pattern ESCAPE :escape
+    OR EXISTS (
+      SELECT 1 FROM action_text_rich_texts
+      WHERE action_text_rich_texts.record_type = 'Card'
+        AND action_text_rich_texts.record_id = cards.id
+        AND action_text_rich_texts.name = 'description'
+        AND action_text_rich_texts.body LIKE :pattern ESCAPE :escape
+    )
+    OR EXISTS (
+      SELECT 1 FROM comments
+      INNER JOIN action_text_rich_texts
+        ON action_text_rich_texts.record_type = 'Comment'
+        AND action_text_rich_texts.record_id = comments.id
+        AND action_text_rich_texts.name = 'body'
+      WHERE comments.card_id = cards.id
+        AND action_text_rich_texts.body LIKE :pattern ESCAPE :escape
+    )
+  SQL
+
+  included do
+    scope :matching, ->(terms) do
+      Array(terms).reduce(all) { |cards, term| cards.where MATCHING_TERM_SQL, like_binds_for(term) }
+    end
+  end
+end
