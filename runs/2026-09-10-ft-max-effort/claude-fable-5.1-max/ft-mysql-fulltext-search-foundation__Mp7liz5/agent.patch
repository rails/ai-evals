+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  test "matching cards by title" do
+    assert_equal [ cards(:logo) ], Card.matching("logo").to_a
+    assert_equal [ cards(:logo) ], Card.matching("LOGO").to_a
+  end
+
+  test "matching cards by description" do
+    cards(:shipping).update! description: "<div>Pick a <strong>haggis</strong> supplier</div>"
+
+    assert_equal [ cards(:shipping) ], Card.matching("haggis").to_a
+  end
+
+  test "matching cards by the body of their comments" do
+    assert_equal [ cards(:layout) ], Card.matching("overflowing").to_a
+  end
+
+  test "matching requires every term to match, each anywhere on the card" do
+    assert_equal [ cards(:layout) ], Card.matching(%w[ layout overflowing ]).to_a
+    assert_empty Card.matching(%w[ layout haggis ])
+  end
+
+  test "matching treats LIKE wildcards literally" do
+    cards(:logo).update_column :title, "Make the logo 100% bigger"
+
+    assert_equal [ cards(:logo) ], Card.matching("100%").to_a
+    assert_empty Card.matching("100_")
+    assert_empty Card.matching("100!")
+  end
+
+  test "matching nothing matches everything" do
+    assert_equal Card.count, Card.matching([]).count
+  end
+end
