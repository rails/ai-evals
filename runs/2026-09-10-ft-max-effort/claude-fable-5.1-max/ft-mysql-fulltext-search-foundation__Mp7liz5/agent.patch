diff --git a/app/models/concerns/searchable.rb b/app/models/concerns/searchable.rb
new file mode 100644
index 0000000..148598c
--- /dev/null
+++ b/app/models/concerns/searchable.rb
@@ -0,0 +1,13 @@
+module Searchable
+  extend ActiveSupport::Concern
+
+  # SQLite has no default escape character for LIKE, so spell out one that works on MySQL too.
+  LIKE_ESCAPE = "!"
+
+  class_methods do
+    # Named binds for a "column LIKE :pattern ESCAPE :escape" condition matching the term anywhere.
+    def like_binds_for(term)
+      { pattern: "%#{sanitize_sql_like(term, LIKE_ESCAPE)}%", escape: LIKE_ESCAPE }
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..aabf46d
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,37 @@
+class Search
+  MATCHING_COMMENTS_PER_CARD = 3
+
+  attr_reader :query, :searcher
+
+  def initialize(query, searcher: Current.user)
+    @query = query.to_s.squish
+    @searcher = searcher
+  end
+
+  # The distinct words of the query, with anything quoted kept together as a phrase.
+  def terms
+    @terms ||= query.scan(/"([^"]*)"|(\S+)/).map { |phrase, word| (phrase || word).squish }.compact_blank.uniq(&:downcase)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    if blank?
+      Card.none
+    else
+      searcher.accessible_cards.published.matching(terms).reverse_chronologically
+        .preload(:board, :column, :closure, :creator, :rich_text_description)
+    end
+  end
+
+  def matching_comments_on(card)
+    card.comments.matching_any(terms).chronologically.preload(:creator, :rich_text_body).limit(MATCHING_COMMENTS_PER_CARD)
+  end
+
+  # Matches any of the terms, trying the longest first so overlapping ones highlight whole.
+  def pattern
+    @pattern ||= /#{terms.sort_by { -it.length }.map { Regexp.escape(it) }.join("|")}/i
+  end
+end
