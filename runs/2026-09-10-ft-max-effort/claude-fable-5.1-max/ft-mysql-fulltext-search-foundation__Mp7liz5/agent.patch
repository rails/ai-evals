+++ b/docs/api/sections/search.md
@@ -0,0 +1,46 @@
+# Search
+
+Search finds cards by what's in them: their title, their description, or the body of any of their comments.
+
+## `GET /:account_slug/search`
+
+Returns a paginated list of cards matching the query, newest first. Every word of the query has to appear
+somewhere on a card for it to match, though each word may be found in a different place. Only cards on
+boards you have access to are returned, and draft cards never are.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `q` | The words to search for |
+
+Example:
+- `q=logo+bigger` — cards mentioning both "logo" and "bigger"
+
+__Response:__
+
+The same card representation as [`GET /:account_slug/cards`](cards.md).
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "number": 1,
+    "title": "The logo isn't big enough",
+    "status": "published",
+    "description": "It should be at least twice as big.",
+    "description_html": "<div class=\"action-text-content\"><p>It should be at least twice as big.</p></div>",
+    "image_url": null,
+    "has_attachments": false,
+    "tags": ["design"],
+    "golden": false,
+    "last_active_at": "2025-12-05T19:38:48.553Z",
+    "created_at": "2025-12-05T19:38:48.540Z",
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "board": { "...": "..." },
+    "creator": { "...": "..." },
+    "comments_url": "http://app.fizzy.localhost:3006/897362094/cards/1/comments",
+    "reactions_url": "http://app.fizzy.localhost:3006/897362094/cards/1/reactions"
+  }
+]
+```
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..60d9085
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show finds cards by title and marks the matched words" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:logo).id} mark", text: "logo"
+    assert_match "The <mark>logo</mark> isn't big enough", response.body
+    assert_select "#search_result_card_#{cards(:layout).id}", count: 0
+  end
+
+  test "show finds cards by description" do
+    with_current_user :kevin do
+      cards(:shipping).update! description: "<div>We should pick a <strong>haggis</strong> supplier first</div>"
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:shipping).id}" do
+      assert_select "mark", text: "haggis"
+    end
+  end
+
+  test "show finds cards by the body of their comments" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:layout).id}" do
+      assert_select "mark", text: "overflowing"
+      assert_select ".search-result__excerpt--comment", text: /David: The text is overflowing the container\./
+    end
+  end
+
+  test "show only finds cards from boards the user currently has access to" do
+    card = publish_card boards(:private), "Secret marketing budget"
+
+    get search_path(q: "secret")
+    assert_select "#search_result_card_#{card.id}"
+
+    logout_and_sign_in_as :david
+    get search_path(q: "secret")
+    assert_response :success
+    assert_select "#search_result_card_#{card.id}", count: 0
+
+    boards(:private).accesses.grant_to(users(:david))
+    get search_path(q: "secret")
+    assert_select "#search_result_card_#{card.id}"
+
+    boards(:private).accesses.revoke_from(users(:david))
+    get search_path(q: "secret")
+    assert_select "#search_result_card_#{card.id}", count: 0
+  end
+
+  test "show never finds draft cards nor their comments" do
+    draft = publish_card boards(:writebook), "Draft about haggis"
+    with_current_user(:kevin) { draft.comments.create!(body: "Nobody should find this haggis", creator: users(:kevin)) }
+    draft.update_column :status, "drafted"
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_select "#search_result_card_#{draft.id}", count: 0
+    assert_select ".search-result", count: 0
+  end
+
+  test "show lists the newest cards first" do
+    publish_card boards(:writebook), "Older haggis", created_at: 2.days.ago
+    publish_card boards(:writebook), "Newer haggis", created_at: 1.day.ago
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_operator response.body.index("Newer <mark>haggis</mark>"), :<, response.body.index("Older <mark>haggis</mark>")
+  end
+
+  test "show requires every word to match somewhere on the card" do
+    get search_path(q: "layout overflowing")
+    assert_response :success
+    assert_select "#search_result_card_#{cards(:layout).id}"
+
+    get search_path(q: "layout haggis")
+    assert_response :success
+    assert_select "#search_result_card_#{cards(:layout).id}", count: 0
+    assert_select ".search-results .blank-slate", text: /No cards match/
+  end
+
+  test "show finds quoted phrases as a whole" do
+    get search_path(q: %q("big enough"))
+    assert_response :success
+    assert_select "#search_result_card_#{cards(:logo).id} mark", text: "big enough"
+
+    get search_path(q: %q("enough big"))
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "show without a query renders the search form and no results" do
+    get search_path
+    assert_response :success
+
+    assert_select "input[name=q]"
+    assert_select ".search-results", count: 0
+  end
+
+  test "show keeps the marked up contents safe" do
+    cards(:logo).update_column :title, "Logo <script>alert(1)</script> & friends"
+
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_no_match "<script>", response.body[/<main.*<\/main>/m]
+    assert_match "<mark>Logo</mark> alert(1) &amp; friends", response.body
+  end
+
+  test "show as JSON" do
+    get search_path(q: "logo", format: :json)
+    assert_response :success
+
+    assert_equal [ cards(:logo).number ], response.parsed_body.pluck("number")
+  end
+
+  private
+    def publish_card(board, title, **attributes)
+      with_current_user :kevin do
+        board.cards.create!(title: title, creator: users(:kevin), status: :published, **attributes)
+      end
+    end
+end
