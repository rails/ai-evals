diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..9a852c4
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "terms are the distinct words of the query" do
+    assert_equal %w[ logo big ], Search.new("  logo   big  LOGO ").terms
+    assert_empty Search.new("   ").terms
+    assert_empty Search.new(nil).terms
+  end
+
+  test "terms keep quoted phrases together" do
+    assert_equal [ "big enough", "logo" ], Search.new(%q( "big   enough" logo )).terms
+    assert_equal [ "logo" ], Search.new(%q( "" logo )).terms
+    assert_equal [ %q(logo") ], Search.new(%q(logo")).terms
+  end
+
+  test "blank without any terms" do
+    assert Search.new("").blank?
+    assert Search.new("logo").present?
+  end
+
+  test "cards matching every term on boards the searcher can access, newest first" do
+    private_card = boards(:private).cards.create!(title: "Private logo notes", creator: users(:kevin), status: :published)
+
+    assert_equal [ private_card, cards(:logo) ], Search.new("logo").cards.to_a
+    assert_equal [ cards(:logo) ], Search.new("logo", searcher: users(:david)).cards.to_a
+  end
+
+  test "cards found through a description or a comment" do
+    cards(:shipping).update! description: "<div>Haggis first</div>"
+
+    assert_equal [ cards(:shipping) ], Search.new("haggis").cards.to_a
+    assert_equal [ cards(:layout) ], Search.new("overflowing").cards.to_a
+    assert_empty Search.new("layout haggis").cards
+  end
+
+  test "cards never include drafts" do
+    cards(:logo).update_column :status, "drafted"
+
+    assert_empty Search.new("logo").cards
+  end
+
+  test "no cards without terms" do
+    assert_empty Search.new("").cards
+  end
+
+  test "matching comments on a card" do
+    assert_equal [ comments(:logo_agreement_jz) ], Search.new("agree overflowing").matching_comments_on(cards(:logo)).to_a
+    assert_empty Search.new("haggis").matching_comments_on(cards(:logo))
+  end
+
+  test "pattern matches any term regardless of case, preferring the longest" do
+    pattern = Search.new("log logo (big)").pattern
+
+    assert_equal "Logo", "The Logo isn't (big) enough"[pattern]
+    assert_equal "(big)", "This is (big)"[pattern]
+    assert_nil "Nothing here"[pattern]
+  end
+end
