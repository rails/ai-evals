+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlighting the matched words" do
+    search = Search.new("logo big")
+
+    assert_equal "The <mark>logo</mark> isn't <mark>big</mark> enough", search_highlight("The logo isn't big enough", search)
+    assert_equal "<mark>LOGO</mark>", search_highlight("LOGO", search)
+    assert_equal "No match", search_highlight("No match", search)
+    assert_equal "", search_highlight(nil, search)
+  end
+
+  test "highlighting leaves the text safe" do
+    highlighted = search_highlight("Logo <script>alert(1)</script> & co", Search.new("logo"))
+
+    assert highlighted.html_safe?
+    assert_equal "<mark>Logo</mark> alert(1) &amp; co", highlighted
+  end
+
+  test "excerpting around the first match" do
+    text = "#{"Lorem ipsum " * 20}dolor sit logo amet #{"consectetur " * 20}"
+    excerpt = search_excerpt(text, Search.new("logo"))
+
+    assert_match(/\A\.\.\..*<mark>logo<\/mark>.*\.\.\.\z/, excerpt)
+    assert_operator excerpt.length, :<, 200
+  end
+
+  test "excerpting nothing when there is no match" do
+    assert_nil search_excerpt("Nothing to see here", Search.new("logo"))
+    assert_nil search_excerpt(nil, Search.new("logo"))
+  end
+end
