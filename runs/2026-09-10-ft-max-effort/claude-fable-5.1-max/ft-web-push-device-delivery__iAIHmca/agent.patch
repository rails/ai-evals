@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers the browser's subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params },
+        headers: { "User-Agent" => "Mozilla/5.0 Chrome/140.0" }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://example.com/push/abc123", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal "Mozilla/5.0 Chrome/140.0", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create as JSON responds with the subscription" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+
+    assert_response :created
+    assert_equal @user.push_subscriptions.last.id, @response.parsed_body["id"]
+    assert_equal "https://example.com/push/abc123", @response.parsed_body["endpoint"]
+  end
+
+  test "create with flat JSON params" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create is idempotent for an endpoint, refreshing its keys" do
+    subscription = @user.push_subscriptions.create!(subscription_params.merge(auth_key: "old-auth-key"))
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+    assert_equal subscription.id, @response.parsed_body["id"]
+    assert_equal "auth-key", subscription.reload.auth_key
+  end
+
+  test "create requires all subscription attributes" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params.except(:auth_key) }, as: :json
+      assert_response :unprocessable_entity
+
+      post user_push_subscriptions_path(@user), params: { something_else: "entirely" }, as: :json
+      assert_response :bad_request
+    end
+  end
+
+  test "create is forbidden for other users" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the subscription" do
+    subscription = @user.push_subscriptions.create!(subscription_params)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for other users' subscriptions" do
+    subscription = users(:kevin).push_subscriptions.create!(subscription_params)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(users(:kevin), subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscription_params
+      { endpoint: "https://example.com/push/abc123", p256dh_key: "p256dh-key", auth_key: "auth-key" }
+    end
+end
