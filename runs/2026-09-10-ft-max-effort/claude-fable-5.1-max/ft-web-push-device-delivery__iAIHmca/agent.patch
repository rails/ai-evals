+# Raised when the push service responds in a way we don't know how to handle.
+class Push::Subscription::ServiceError < StandardError
+  attr_reader :response, :host
+
+  def initialize(response, host)
+    @response, @host = response, host
+    super "Push service #{host} responded with #{response.code} #{response.message}".strip
+  end
+end
