+
+    assert_difference -> { users(:kevin).push_subscriptions.count }, +1 do
+      users(:kevin).push_subscriptions.register(endpoint: "https://example.com/push/new", user_agent: "Firefox", **keys)
+    end
+
+    assert_no_difference -> { users(:kevin).push_subscriptions.count } do
+      subscription = users(:kevin).push_subscriptions.register(endpoint: "https://example.com/push/new", user_agent: "Firefox 2", **keys)
+
+      assert_equal "Firefox 2", subscription.user_agent
+      assert_equal users(:kevin).account, subscription.account
+    end
+  end
+
+  test "publish sends the encrypted message to the push service, pinned to the resolved IP" do
+    with_vapid_keys do |vapid_key|
+      request = stub_request(:post, "https://example.com/push").with(ipaddr: PUBLIC_TEST_IP) do |request|
+        assert_equal "aes128gcm", request.headers["Content-Encoding"]
+        assert_equal "high", request.headers["Urgency"]
+        assert_equal Push::Subscription::TTL.to_i.to_s, request.headers["Ttl"]
+        assert_match(/\Avapid t=.+,k=#{Regexp.escape(vapid_key.public_key.delete("="))}\z/, request.headers["Authorization"])
+        assert_not_includes request.body, "Logo", "the message must be encrypted"
+        true
+      end.to_return(status: 201)
+
+      assert @subscription.publish(@message)
+      assert_requested request
+    end
+  end
+
+  test "publish removes the subscription when the push service says it's gone" do
+    [ 404, 410 ].each do |status|
+      subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://example.com/push/#{status}", **browser_push_keys)
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      assert_not subscription.publish(@message)
+      assert_not Push::Subscription.exists?(subscription.id), "expected a #{status} to remove the subscription"
+    end
+  end
+
+  test "publish removes the subscription when it was created for another VAPID key pair" do
+    [ 401, 403, [ 400, "UnauthorizedRegistration" ] ].each do |status|
+      subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://example.com/push/#{Array(status).first}", **browser_push_keys)
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      assert_not subscription.publish(@message)
+      assert_not Push::Subscription.exists?(subscription.id), "expected a #{status} to remove the subscription"
+    end
+  end
+
+  test "publish keeps the subscription and reports when the push service is unavailable" do
+    [ 429, 500, 503 ].each do |status|
+      stub_request(:post, "https://example.com/push").to_return(status: status)
+
+      Rails.error.expects(:report).with { |error, **| error.is_a?(Push::Subscription::ServiceError) && error.response.code == status.to_s }
+      assert_not @subscription.publish(@message)
+    end
+
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "publish keeps the subscription and reports when the push service can't be reached" do
+    stub_request(:post, "https://example.com/push").to_timeout
+
+    Rails.error.expects(:report).with { |error, **| error.is_a?(Timeout::Error) }
+    assert_not @subscription.publish(@message)
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "publish raises on responses it doesn't know how to handle" do
+    stub_request(:post, "https://example.com/push").to_return(status: 418)
+
+    error = assert_raises Push::Subscription::ServiceError do
+      @subscription.publish(@message)
+    end
+
+    assert_equal "418", error.response.code
+    assert_equal "example.com", error.host
+  end
+
+  test "publish doesn't contact endpoints that resolve to private addresses" do
+    stub_dns_resolution("169.254.169.254")
+    request = stub_request(:post, "https://example.com/push")
+
+    assert_not @subscription.publish(@message)
+    assert_not_requested request
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "publish removes subscriptions whose endpoint isn't an https URL" do
+    [ "http://example.com/push", "not a url at all" ].each do |endpoint|
+      subscription = users(:kevin).push_subscriptions.create!(endpoint: endpoint, **browser_push_keys)
+
+      assert_not subscription.publish(@message)
+      assert_not Push::Subscription.exists?(subscription.id), "expected #{endpoint.inspect} to remove the subscription"
+    end
+  end
+
+  test "publish removes subscriptions whose keys can't encrypt anything" do
+    subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://example.com/push", p256dh_key: "not-a-key", auth_key: "nope")
+    request = stub_request(:post, "https://example.com/push")
+
+    assert_not subscription.publish(@message)
+    assert_not_requested request
+    assert_not Push::Subscription.exists?(subscription.id)
+  end
+
+  test "subscriptions go away with their user" do
+    assert_difference -> { Push::Subscription.count }, -1 do
+      users(:kevin).destroy
+    end
+  end
+
+  test "subscriptions are dropped when their user is deactivated" do
+    assert_difference -> { Push::Subscription.count }, -1 do
+      users(:kevin).deactivate
+    end
+  end
+end
