diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..7fe6760 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,38 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Push notifications: say what the tray says, and open the card it's about when tapped
+self.addEventListener("push", (event) => {
+  if (event.data) {
+    const { title, body, tag, path } = event.data.json()
+
+    event.waitUntil(self.registration.showNotification(title, {
+      body: body,
+      tag: tag,
+      renotify: true,
+      icon: "/app-icon-192.png",
+      badge: "/app-icon-192-maskable.png",
+      data: { path: path }
+    }))
+  }
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openWindow(event.notification.data?.path))
+})
+
+async function openWindow(path) {
+  const url = new URL(path || "/", self.location.origin).href
+  const windows = await self.clients.matchAll({ type: "window" })
+  const client = windows.find((window) => window.url === url) || windows[0]
+
+  if (client) {
+    await client.focus()
+    if (client.url !== url) await client.navigate(url).catch(() => self.clients.openWindow(url))
+  } else {
+    await self.clients.openWindow(url)
+  }
+}
+
 TurboOffline.start()
