new file mode 100644
index 0000000..5f08c3f
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,39 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+  before_action :set_push_subscription, only: :destroy
+
+  def create
+    @push_subscription = @user.push_subscriptions.register(push_subscription_params.merge(user_agent: request.user_agent))
+
+    respond_to do |format|
+      format.html { head :created }
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def destroy
+    @push_subscription.destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def set_push_subscription
+      @push_subscription = @user.push_subscriptions.find(params[:id])
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..639c059
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,168 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+// Turns web push on or off for the device at hand. The browser's push subscription is
+// registered with the server so that whatever lands in the tray also reaches this device.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "toggle", "explainer", "blocked", "unsupported", "details" ]
+  static values = { subscriptionsUrl: String }
+
+  async connect() {
+    if (this.#supported) {
+      await this.#refresh()
+    } else {
+      this.#showUnsupported()
+    }
+  }
+
+  async subscribe() {
+    try {
+      switch (await Notification.requestPermission()) {
+        case "granted": await this.#register(await this.#findOrCreateSubscription()); break
+        case "denied":  this.#showBlocked(); break
+        default:        this.#turnOff()
+      }
+    } catch (error) {
+      console.error("Couldn't subscribe to push notifications", error)
+      this.#showUnsupported()
+    }
+  }
+
+  async unsubscribe() {
+    if (this.#registeredUrl) {
+      await destroy(this.#registeredUrl)
+    }
+
+    this.#forget()
+    this.#turnOff()
+  }
+
+  async #refresh() {
+    try {
+      const subscription = await this.#currentSubscription()
+
+      if (Notification.permission === "denied") {
+        this.#showBlocked()
+      } else if (Notification.permission === "granted" && subscription && this.#registeredId) {
+        await this.#register(this.#keyMatches(subscription) ? subscription : await this.#findOrCreateSubscription())
+      } else {
+        this.#forget()
+        this.#turnOff()
+      }
+    } catch (error) {
+      console.error("Couldn't refresh the push subscription", error)
+      this.#turnOff()
+    }
+  }
+
+  // Subscribing
+
+  async #findOrCreateSubscription() {
+    const existing = await this.#currentSubscription()
+
+    if (existing && this.#keyMatches(existing)) {
+      return existing
+    } else {
+      await existing?.unsubscribe()
+      return (await this.#registration).pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  async #currentSubscription() {
+    return (await this.#registration).pushManager.getSubscription()
+  }
+
+  async #register(subscription) {
+    const response = await post(this.subscriptionsUrlValue, { body: this.#payloadFor(subscription), responseKind: "json" })
+
+    if (response.ok) {
+      this.#remember((await response.json).id)
+      this.#turnOn()
+    } else {
+      this.#turnOff()
+    }
+  }
+
+  #payloadFor(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+    return { push_subscription: { endpoint: endpoint, p256dh_key: p256dh, auth_key: auth } }
+  }
+
+  #keyMatches(subscription) {
+    const current = new Uint8Array(subscription.options?.applicationServerKey || [])
+    const expected = this.#applicationServerKey
+    return current.length === expected.length && current.every((byte, index) => byte === expected[index])
+  }
+
+  get #applicationServerKey() {
+    return base64UrlToUint8Array(getMetaContent("vapid-public-key"))
+  }
+
+  get #registration() {
+    return navigator.serviceWorker.ready
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // Remembering which subscription is this device's, per account
+
+  #remember(id) {
+    localStorage.setItem(this.#storageKey, id)
+  }
+
+  #forget() {
+    localStorage.removeItem(this.#storageKey)
+  }
+
+  get #registeredId() {
+    return localStorage.getItem(this.#storageKey)
+  }
+
+  get #registeredUrl() {
+    return this.#registeredId && `${this.subscriptionsUrlValue}/${this.#registeredId}`
+  }
+
+  get #storageKey() {
+    return `push-subscription:${this.subscriptionsUrlValue}`
+  }
+
+  // Showing state
+
+  #turnOn() {
+    this.element.classList.add(this.onClass)
+    this.explainerTarget.hidden = true
+  }
+
+  #turnOff() {
+    this.element.classList.remove(this.onClass)
+    this.explainerTarget.hidden = true
+  }
+
+  #showBlocked() {
+    this.#turnOff()
+    this.#explain({ blocked: true })
+  }
+
+  #showUnsupported() {
+    this.#turnOff()
+    this.toggleTargets.forEach(toggle => toggle.hidden = true)
+    this.#explain({ blocked: false })
+  }
+
+  #explain({ blocked }) {
+    this.blockedTargets.forEach(element => element.hidden = !blocked)
+    this.detailsTargets.forEach(element => element.hidden = !blocked)
+    this.unsupportedTargets.forEach(element => element.hidden = blocked)
+    this.explainerTarget.hidden = false
+  }
+}
+
+function base64UrlToUint8Array(base64Url) {
+  const unpadded = (base64Url || "").replace(/=+$/, "")
+  const base64 = unpadded.replace(/-/g, "+").replace(/_/g, "/") + "=".repeat((4 - unpadded.length % 4) % 4)
+  return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+}
