+namespace :push do
+  desc "Generate the VAPID key pair that identifies this Fizzy instance to browsers' push services"
+  task :vapid_keys do
+    require "web-push"
+
+    vapid_key = WebPush.generate_key
+
+    puts "VAPID_PUBLIC_KEY=#{vapid_key.public_key}"
+    puts "VAPID_PRIVATE_KEY=#{vapid_key.private_key}"
+  end
+end
