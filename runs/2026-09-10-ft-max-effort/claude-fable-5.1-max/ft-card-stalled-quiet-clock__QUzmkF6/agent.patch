diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..bbf5623
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,49 @@
+# A card gets a burst of attention when someone is assigned to it, when it's reopened, or when
+# several people comment on it within a short time. A card that had a burst and then went cold is
+# stalled. Any activity on the card resets that, since it's tracked off last_active_at.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  BURST_ACTIONS = %w[ card_assigned card_reopened ]
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+
+  included do
+    has_one :burst, dependent: :destroy, class_name: "Card::Burst"
+
+    scope :stalled, -> { active.joins(:burst).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stallable?
+    active? && burst.present?
+  end
+
+  def stalled?
+    stallable? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def record_burst_from(event)
+    if burst_from?(event)
+      create_burst! unless burst
+    end
+  rescue ActiveRecord::RecordNotUnique
+    # Already burst
+  end
+
+  private
+    def burst_from?(event)
+      event.action.in?(BURST_ACTIONS) || (event.action.comment_created? && comments_burst?)
+    end
+
+    def comments_burst?
+      commenter_ids = comments.by_user.where(created_at: burst_window.ago..).pluck(:creator_id)
+      commenter_ids.size >= BURST_COMMENTS && commenter_ids.uniq.size >= BURST_COMMENTERS
+    end
+
+    # Comments have to land within a third of the board's auto-postpone period to count as a burst
+    def burst_window
+      (auto_postpone_period / 3).seconds
+    end
+end
