+require "application_system_test_case"
+
+class StalledCardTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+
+    @card = cards(:buy_domain)
+    @card.create_burst!
+    @card.update! last_active_at: 3.weeks.ago
+  end
+
+  test "a stalled card shows how long it has been stalled" do
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :bubble)}" do
+      assert_text(/stalled for/i)
+      assert_text "21"
+      assert_text(/days/i)
+    end
+  end
+
+  test "stalled cards are flagged on the board and listed under the stalled filter" do
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@card, :bubble)}", text: /stalled for/i
+    assert_selector "##{dom_id(cards(:layout), :bubble)}", visible: :hidden
+
+    visit cards_url(indexed_by: "stalled")
+    assert_selector "##{dom_id(@card, :article)}"
+    assert_no_selector "##{dom_id(cards(:layout), :article)}"
+  end
+
+  test "activity on a stalled card resets it" do
+    visit card_url(@card)
+    assert_selector "##{dom_id(@card, :bubble)}", text: /stalled for/i
+
+    @card.comments.create! body: "Picking this back up", creator: users(:jz)
+
+    visit card_url(@card)
+    assert_selector "##{dom_id(@card, :bubble)}", visible: :hidden
+  end
+
+  private
+    def sign_in_as(user)
+      visit session_transfer_url(user.identity.transfer_id, script_name: nil)
+      assert_current_path root_path
+    end
+end
