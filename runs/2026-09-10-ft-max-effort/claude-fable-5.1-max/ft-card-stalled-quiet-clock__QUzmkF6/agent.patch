diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..899ffdc
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "assigning someone bursts the card" do
+    assert_changes -> { cards(:buy_domain).reload.burst.present? }, from: false, to: true do
+      cards(:buy_domain).toggle_assignment users(:jz)
+    end
+  end
+
+  test "reopening bursts the card" do
+    assert_changes -> { cards(:shipping).reload.burst.present? }, from: false, to: true do
+      cards(:shipping).reopen
+    end
+  end
+
+  test "three comments from two people within a third of the auto-postpone period burst the card" do
+    card = cards(:buy_domain)
+
+    card.comments.create! body: "First", creator: users(:david)
+    card.comments.create! body: "Second", creator: users(:david)
+    assert_not card.reload.burst.present?
+
+    card.comments.create! body: "Third", creator: users(:jz)
+    assert card.reload.burst.present?
+  end
+
+  test "comments from a single person don't burst the card" do
+    card = cards(:buy_domain)
+
+    3.times { |i| card.comments.create! body: "Comment #{i}", creator: users(:david) }
+
+    assert_not card.reload.burst.present?
+  end
+
+  test "comments spread out beyond a third of the auto-postpone period don't burst the card" do
+    card = cards(:buy_domain)
+    window = card.auto_postpone_period / 3
+
+    card.comments.create! body: "Long ago", creator: users(:david), created_at: (window + 1.day).seconds.ago
+    card.comments.create! body: "Recent", creator: users(:david)
+    card.comments.create! body: "Also recent", creator: users(:jz)
+
+    assert_not card.reload.burst.present?
+  end
+
+  test "system comments don't count towards a burst" do
+    card = cards(:buy_domain)
+
+    card.comments.create! body: "Something happened", creator: card.account.system_user
+    card.comments.create! body: "First", creator: users(:david)
+    card.comments.create! body: "Second", creator: users(:jz)
+
+    assert_not card.reload.burst.present?
+  end
+
+  test "other activity doesn't burst the card" do
+    card = cards(:buy_domain)
+
+    card.update! title: "New title"
+    card.triage_into columns(:writebook_in_progress)
+    card.close
+
+    assert_not card.reload.burst.present?
+  end
+
+  test "a burst card with no activity for two weeks is stalled" do
+    card = cards(:buy_domain)
+    card.toggle_assignment users(:jz)
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    card.update! last_active_at: 15.days.ago
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "a card without a burst never stalls" do
+    card = cards(:buy_domain)
+    card.update! last_active_at: 3.weeks.ago
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "any activity on a stalled card resets it" do
+    card = cards(:buy_domain)
+    card.toggle_assignment users(:jz)
+    card.update! last_active_at: 3.weeks.ago
+    assert card.stalled?
+
+    card.comments.create! body: "Picking this back up", creator: users(:jz)
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "closed and postponed cards aren't stalled" do
+    card = cards(:buy_domain)
+    card.toggle_assignment users(:jz)
+    card.update! last_active_at: 3.weeks.ago
+    assert card.stalled?
+
+    card.postpone
+    card.update! last_active_at: 3.weeks.ago
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    card.close
+    card.update! last_active_at: 3.weeks.ago
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "indexing by stalled" do
+    cards(:buy_domain).toggle_assignment users(:jz)
+    cards(:buy_domain).update! last_active_at: 3.weeks.ago
+    cards(:layout).update! last_active_at: 3.weeks.ago
+
+    assert_equal [ cards(:buy_domain) ], users(:david).filters.new(indexed_by: "stalled").cards.to_a
+  end
+end
