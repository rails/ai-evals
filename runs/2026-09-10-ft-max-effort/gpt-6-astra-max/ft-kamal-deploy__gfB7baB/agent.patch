+# Copy to .kamal/secrets, fill in the values, and keep that file private.
+# It is ignored by Git and excluded from Docker builds. Never commit real secrets.
+# You can also reference exported variables, e.g. SMTP_PASSWORD=$SMTP_PASSWORD.
+# Use single quotes around literal values containing $, #, or spaces.
+
+# Generate once with bin/rails secret. Keep the same value across deploys.
+SECRET_KEY_BASE=replace-with-output-of-bin-rails-secret
+
+SMTP_USERNAME=replace-with-your-smtp-username
+SMTP_PASSWORD=replace-with-your-smtp-password
+
+# Optional browser push keys. Generate once and uncomment here and in config/deploy.yml.
+# VAPID_PRIVATE_KEY=replace-with-your-private-key
+# VAPID_PUBLIC_KEY=replace-with-your-public-key
