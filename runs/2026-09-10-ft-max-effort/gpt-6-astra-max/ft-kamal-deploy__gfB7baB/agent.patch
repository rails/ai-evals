+# Single-server, self-hosted Fizzy. See docs/self-hosting.md before running bin/kamal setup.
+service: fizzy
+image: fizzy
+minimum_version: 2.11.0
+
+servers:
+  web:
+    # Replace this once: it is used for SSH, HTTPS, and links in emails and jobs.
+    - &host fizzy.example.com
+
+# Kamal Proxy obtains and renews the certificate. Thruster serves HTTP inside the container.
+proxy:
+  ssl: true
+  host: *host
+  app_port: 80
+
+# Kamal runs a registry on your development machine and forwards it over SSH during deploys.
+# No Docker Hub or other registry account is required.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Change to arm64 for an ARM server.
+
+# All databases (including jobs, cache, and cable) and uploaded files live here.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    SAAS: "false"
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Conservative defaults for a small box; increase these if you have memory to spare.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    APP_FQDN: *host
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *host
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Uncomment both to enable browser push notifications (see the guide).
+    # - VAPID_PRIVATE_KEY
+    # - VAPID_PUBLIC_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs --follow
