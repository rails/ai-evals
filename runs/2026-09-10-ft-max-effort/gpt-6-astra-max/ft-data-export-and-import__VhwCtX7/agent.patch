+      end
+      unless entry.storage_mode.in?([ 0, 8 ]) && entry.gp_flags & 1 == 0 && single_disk_entry?(entry)
+        raise ZipFile::Error, "Encrypted or unsupported ZIP entry: #{path}"
+      end
+      unless entry.local_file_header_offset >= 0 && entry.local_file_header_offset + 30 <= @io.size && entry.compressed_size >= 0 && entry.uncompressed_size >= 0
+        raise ZipFile::Error, "Invalid ZIP entry: #{path}"
+      end
+    end
+
+    def single_disk_entry?(entry)
+      # ZipKit leaves the ZIP64 disk-number sentinel undecoded. The EOCD is
+      # still checked for a single disk, and every data offset is bounded above.
+      entry.disk_number_start == 0 || (entry.disk_number_start == 0xffff && entry.version_needed_to_extract >= 45)
+    end
+
+    class DirectoryReader < ZipKit::FileReader
+      private
+        def num_files_and_central_directory_offset(io, offset)
+          validate_directory(super, io)
+        end
+
+        def num_files_and_central_directory_offset_zip64(io, offset)
+          validate_directory(super, io)
+        end
+
+        def validate_directory(directory, io)
+          count, offset, size = directory
+          unless offset.between?(0, io.size) && size.between?(0, Source::MAX_READ_SIZE) && offset + size <= io.size && count.between?(0, size / 46)
+            raise ZipFile::Error, "Invalid ZIP central directory."
+          end
+          directory
+        end
+    end
+
+    # Active Storage range reads work with both Disk and S3, without temporary
+    # URLs that could expire during a multi-hour import. Bound the ZIP parser's
+    # reads too: an untrusted central-directory offset must not read 500GB at once.
+    class Source
+      MAX_READ_SIZE = 256.megabytes
+
+      attr_reader :tell
+
+      def initialize(source)
+        @source = source
+        @tell = 0
+      end
+
+      def size
+        @source.respond_to?(:byte_size) ? @source.byte_size : @source.size
+      end
+
+      def seek(offset, mode = IO::SEEK_SET)
+        unless mode == IO::SEEK_SET && offset.between?(0, size)
+          raise ZipFile::Error, "Invalid offset in ZIP archive."
+        end
+        @tell = offset
+        0
+      end
+
+      def read(length = nil)
+        length ||= size - tell
+        raise ZipFile::Error, "The ZIP archive directory is too large." unless length.between?(0, MAX_READ_SIZE)
+        length = [ length, size - tell ].min
+
+        if length.zero?
+          "".b
+        else
+          data = if @source.respond_to?(:download_chunk)
+            @source.download_chunk(tell...(tell + length))
+          else
+            @source.seek(tell)
+            @source.read(length)
+          end
+          raise ZipFile::Error, "The ZIP archive is truncated." unless data&.bytesize == length
+          @tell += data.bytesize
+          data
+        end
+      end
+    end
+end
