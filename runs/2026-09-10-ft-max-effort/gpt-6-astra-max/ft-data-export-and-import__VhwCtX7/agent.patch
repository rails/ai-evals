+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper, DataTransferTestHelper
+  setup do
+    @source = accounts(:"37s")
+    @identity = identities(:mike)
+  end
+
+  test "round trip restores an account with fresh ids, people, cards, comments and files" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("original image"), filename: "image.png", content_type: "image/png")
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_emails 1 do
+        import.process_now
+      end
+    end
+
+    assert import.completed?, import.error_message
+    account = import.account
+    assert_not_equal @source.id, account.id
+    assert_not_equal @source.external_account_id, account.external_account_id
+    assert_equal @source.name, account.name
+    assert_equal @source.boards.count, account.boards.count
+    assert_equal @source.cards.count, account.cards.count
+    assert_equal @source.users.count + 1, account.users.count
+    assert account.users.find_by!(identity: @identity).owner?
+    imported_card = account.cards.find_by!(number: card.number)
+    assert_not_equal card.id, imported_card.id
+    assert_equal card.title, imported_card.title
+    assert_equal card.comments.count, imported_card.comments.count
+    assert_equal "original image", imported_card.image.download
+    assert_not_equal card.image.blob.key, imported_card.image.blob.key
+    assert_equal "I agree.", imported_card.comments.find_by!(creator: account.users.find_by!(name: "JZ")).body.to_plain_text
+    assert_not import.file.attached?
+
+    assert_no_difference -> { Account.count } do
+      assert_no_enqueued_emails { import.process_now }
+    end
+  ensure
+    export&.file&.purge
+    card&.image&.purge
+    delete_imported_files(import)
+  end
+
+  test "invalid archive sends a reason and creates nothing" do
+    import = Current.without_account do
+      Account::Import.create!(identity: @identity, file: { io: StringIO.new("not a zip"), filename: "broken.zip" })
+    end
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Identity.count }, -> { Card.count } ] do
+      assert_enqueued_emails(1) { import.process_now }
+    end
+
+    assert import.failed?
+    assert_match /ZIP|archive/i, import.error_message
+    assert_nil import.account
+    assert_not import.file.attached?
+  end
+
+  test "rich text, memberships, history and storage totals survive the round trip" do
+    image = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "image.png", content_type: "image/png")
+    document = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("document content"), filename: "report.pdf", content_type: "application/pdf")
+    card = cards(:logo)
+    card.update!(description: "<p>Old description #{ActionText::Attachment.from_attachable(image).to_html} #{ActionText::Attachment.from_attachable(users(:jz)).to_html}</p>")
+    comment = card.comments.create!(creator: users(:david), body: "<p>Old comment #{ActionText::Attachment.from_attachable(document).to_html}</p>")
+    card.update_columns(created_at: 7.years.ago, updated_at: 6.years.ago)
+    board = card.board
+    board.publish
+    filter = users(:david).filters.create!(boards: [ board ], tags: [ tags(:mobile) ], fields: { card_ids: [ card.id ], column_ids: [ columns(:writebook_triage).id ] })
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+
+    import.process_now
+
+    assert import.completed?, import.error_message
+    imported = import.account.cards.find_by!(number: card.number)
+    assert_equal card.created_at, imported.created_at
+    assert_equal card.updated_at, imported.updated_at
+    assert_equal file_fixture("avatar.png").binread, imported.rich_text_description.embeds.sole.download
+    imported_comment = imported.comments.find_by!(creator: import.account.users.find_by!(name: "David"))
+    assert_equal "document content", imported_comment.rich_text_body.embeds.sole.download
+    assert_equal [ import.account.users.find_by!(name: "JZ") ], imported.description.body.attachables.grep(User)
+    assert_includes imported.description.body.to_html, import.account.slug
+    assert_not_equal board.publication.key, imported.board.publication.key
+    assert_equal image.byte_size + document.byte_size, import.account.bytes_used
+    assert_equal image.byte_size + document.byte_size, imported.board.bytes_used
+    assert Search::Record.for(import.account.id).exists?(account_id: import.account.id, searchable_id: imported.id)
+    imported_filter = Filter.where(account: import.account).detect { |record| record.card_ids.present? }
+    assert_not_nil imported_filter
+    assert_equal [ imported.id ], imported_filter.card_ids
+    assert_equal [ imported.board.id ], imported_filter.boards.ids
+    assert_equal [ "mobile" ], imported_filter.tags.pluck(:title)
+  ensure
+    export&.file&.purge
+    image&.service&.delete(image.key)
+    document&.service&.delete(document.key)
+    delete_imported_files(import)
+  end
+
+  test "a corrupt file rolls back records, new identities, and files already uploaded" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("first image"), filename: "first.png", content_type: "image/png")
+    document = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("last document"), filename: "last.pdf", content_type: "application/pdf")
+    card.update!(description: ActionText::Attachment.from_attachable(document).to_html)
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    original_files = stored_files
+    import = rewritten_import(export) do |path, content|
+      if path == "data/users/#{users(:david).id}.json"
+        JSON.parse(content).merge("email_address" => "new-person@example.org").to_json
+      elsif path.start_with?("files/#{document.id}/")
+        "X" * content.bytesize
+      else
+        content
+      end
+    end
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Identity.count }, -> { Board.count }, -> { Card.count }, -> { Comment.count }, -> { ActionText::RichText.count }, -> { Storage::Entry.count } ] do
+      assert_enqueued_emails(1) { import.process_now }
+    end
+
+    assert import.failed?
+    assert_match /integrity check/, import.error_message
+    assert_nil import.account
+    assert_not import.file.attached?
+    assert_equal original_files, stored_files
+    assert_equal "first image", card.image.download
+  ensure
+    export&.file&.purge
+    card&.image&.purge
+    document&.service&.delete(document.key)
+  end
+
+  test "foreign references cannot link imported data into an existing account" do
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = rewritten_import(export) do |path, content|
+      if path == "data/cards/#{cards(:logo).id}.json"
+        JSON.parse(content).merge("board_id" => boards(:miltons_wish_list).id).to_json
+      else
+        content
+      end
+    end
+    assert_no_difference -> { Account.count } do
+      import.process_now
+    end
+    assert import.failed?
+    assert_match /referenced board/, import.error_message
+  ensure
+    export&.file&.purge
+  end
+
+  test "personal exports are rejected" do
+    export = Export.create!(account: @source, user: users(:david), kind: :cards)
+    export.build_now
+    import = create_import(export)
+    assert_no_difference -> { Account.count } do
+      import.process_now
+    end
+    assert import.failed?
+    assert_match /account export/, import.error_message
+  ensure
+    export&.file&.purge
+  end
+
+  test "account transfers can be completed entirely with S3 storage" do
+    service = use_s3_storage
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("S3 picture"), filename: "image.png", content_type: "image/png")
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+    import.process_now
+
+    assert import.completed?, import.error_message
+    imported_card = import.account.cards.find_by!(number: card.number)
+    assert_equal "S3 picture", imported_card.image.download
+    assert_equal "memory_s3", imported_card.image.blob.service_name
+    assert service.range_reads.any?
+    assert_not import.file.attached?
+  end
+
+  test "a notification retry does not create another account" do
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+    Account::ImportMailer.stubs(:completed).raises(IOError, "mail queue unavailable")
+    assert_raises(IOError) { import.process_now }
+    assert import.reload.completed?
+    assert_nil import.notified_at
+    Account::ImportMailer.unstub(:completed)
+
+    assert_no_difference -> { Account.count } do
+      assert_enqueued_emails(1) { import.process_now }
+    end
+    assert import.notified_at
+  ensure
+    export&.file&.purge
+    delete_imported_files(import)
+  end
+
+  test "a retry removes files left by an interrupted attempt" do
+    service = use_s3_storage
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+    leftover_key = "account-imports/#{import.id}/interrupted-file"
+    service.upload(leftover_key, StringIO.new("partial upload"))
+
+    import.process_now
+
+    assert import.completed?, import.error_message
+    assert_not service.exist?(leftover_key)
+    assert service.exist?(export.file.blob.key)
+  end
+
+  test "the importing person becomes owner without duplicating their membership" do
+    @identity = identities(:david)
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+    import.process_now
+
+    assert import.completed?, import.error_message
+    assert_equal @source.users.count, import.account.users.count
+    assert import.account.users.find_by!(identity: @identity).owner?
+    assert_not import.account.users.find_by!(identity: identities(:jason)).owner?
+    assert users(:david).reload.member?
+    assert_equal import.account.boards.count, import.account.users.find_by!(identity: @identity).boards.count
+    new_card = import.account.cards.create!(board: import.account.boards.first, creator: import.account.users.find_by!(identity: @identity))
+    assert_operator new_card.number, :>, @source.cards.maximum(:number)
+  ensure
+    export&.file&.purge
+    delete_imported_files(import)
+  end
+
+  test "unsupported versions and incomplete inventories leave no account behind" do
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = rewritten_import(export) do |path, content|
+      path == "manifest.json" ? JSON.parse(content).merge("version" => 999).to_json : content
+    end
+    assert_no_difference -> { Account.count } do
+      import.process_now
+    end
+    assert import.failed?
+    assert_match /unsupported archive version/, import.error_message
+
+    import = rewritten_import(export) do |path, content|
+      content unless path == "data/cards/#{cards(:logo).id}.json"
+    end
+    assert_no_difference -> { Account.count } do
+      import.process_now
+    end
+    assert import.failed?
+    assert_match /incomplete/, import.error_message
+  ensure
+    export&.file&.purge
+  end
+
+  test "S3 SHA256 files can be imported into local MD5 storage" do
+    local_service = ActiveStorage::Blob.service
+    s3_service = use_s3_storage(default_digest_type: :sha256)
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("SHA256 picture"), filename: "image.png", content_type: "image/png")
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    assert export.file.blob.checksum.start_with?("sha256:")
+    import = create_import(export)
+
+    ActiveStorage::Blob.stubs(:service).returns(local_service)
+    ActiveStorage::Blob.services.stubs(:fetch).with(local_service.name.to_s).returns(local_service)
+    import.process_now
+
+    assert import.completed?, import.error_message
+    image = import.account.cards.find_by!(number: card.number).image
+    assert_equal local_service.name.to_s, image.blob.service_name
+    image.open { |file| assert_equal "SHA256 picture", file.read }
+  ensure
+    export&.file&.purge
+    delete_imported_files(import)
+  end
+
+  test "local MD5 files can be imported into SHA256 S3 storage" do
+    local_service = ActiveStorage::Blob.service
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("MD5 picture"), filename: "image.png", content_type: "image/png")
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+
+    s3_service = use_s3_storage(default_digest_type: :sha256)
+    ActiveStorage::Blob.services.stubs(:fetch).with(local_service.name.to_s).returns(local_service)
+    import.process_now
+
+    assert import.completed?, import.error_message
+    image = import.account.cards.find_by!(number: card.number).image
+    assert_equal "memory_s3", image.blob.service_name
+    assert image.blob.checksum.start_with?("sha256:")
+    image.open { |file| assert_equal "MD5 picture", file.read }
+  ensure
+    export&.file&.purge
+    card&.image&.purge
+  end
+
+  test "Unicode and unusual attachment filenames round trip safely" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("picture"), filename: "résumé-写真.png", content_type: "image/png")
+    document = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("document"), filename: "..", content_type: "application/pdf")
+    card.update!(description: ActionText::Attachment.from_attachable(document).to_html)
+    export = Export.create!(account: @source, user: users(:jason), kind: :account)
+    export.build_now
+    import = create_import(export)
+    import.process_now
+
+    assert import.completed?, import.error_message
+    imported_card = import.account.cards.find_by!(number: card.number)
+    assert_equal "résumé-写真.png", imported_card.image.filename.to_s
+    assert_equal "picture", imported_card.image.download
+    assert_equal "..", imported_card.rich_text_description.embeds.sole.filename.to_s
+    assert_equal "document", imported_card.rich_text_description.embeds.sole.download
+  ensure
+    export&.file&.purge
+    card&.image&.purge
+    document&.service&.delete(document.key)
+    delete_imported_files(import)
+  end
+
+  private
+    def rewritten_import(export)
+      original = ZipFile::Reader.new(export.file.blob)
+      Tempfile.create([ "test-import", ".zip" ], binmode: true) do |file|
+        writer = ZipFile::Writer.new(file)
+        original.glob("*").each do |path|
+          content = yield path, original.read(path)
+          writer.add_file(path, content, compress: !path.start_with?("files/")) if content
+        end
+        writer.close
+        file.rewind
+        Current.without_account do
+          Account::Import.create!(identity: @identity, file: { io: file, filename: "account.zip", content_type: "application/zip" })
+        end
+      end
+    end
+
+    def stored_files
+      Dir.glob(Rails.root.join("tmp/storage/files/**/*")).select { |path| File.file?(path) }.sort
+    end
+
+    def delete_imported_files(import)
+      if import&.account
+        ActiveStorage::Blob.where(account: import.account).find_each { |blob| blob.service.delete(blob.key) }
+      end
+    end
+
+    def create_import(export)
+      export.file.open do |file|
+        Current.without_account do
+          Account::Import.create!(identity: @identity, file: { io: file, filename: "account.zip", content_type: "application/zip" })
+        end
+      end
+    end
+end
