 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  test "rich text references can be restored with a different signing key" do
+    original_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("document"), filename: "report.pdf", content_type: "application/pdf")
+    imported_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("document"), filename: "report.pdf", content_type: "application/pdf")
+    user = users(:jz)
+    body = ActionText::Content.new("<p>Hello #{ActionText::Attachment.from_attachable(user).to_html}</p>#{ActionText::Attachment.from_attachable(original_blob).to_html}")
+
+    portable = Account::DataTransfer::RichText.export(body)
+    assert_includes portable, original_blob.id
+    assert_not_includes portable, original_blob.attachable_sgid
+
+    # The archive no longer needs to verify any of the original signed IDs.
+    ActionText::Attachable.expects(:from_attachable_sgid).never
+    restored = Account::DataTransfer::RichText.import(portable) do |type, id|
+      type == "User" ? users(:kevin) : imported_blob
+    end
+    fragment = Nokogiri::HTML5.fragment(restored)
+    assert_equal [ users(:kevin).attachable_sgid, imported_blob.attachable_sgid ], fragment.css("action-text-attachment").map { |node| node["sgid"] }
+  ensure
+    original_blob&.purge
+    imported_blob&.purge
+  end
 end
