+class Account::ImportsController < ApplicationController
+  layout "public"
+  disallow_account_scope
+
+  def new
+    @import = Current.identity.account_imports.new
+  end
+
+  def create
+    @import = Current.identity.account_imports.new(import_params)
+
+    if @import.save
+      redirect_to account_import_path(@import, script_name: nil)
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+    @import = Current.identity.account_imports.find(params[:id])
+  end
+
+  private
+    def import_params
+      params.expect(import: [ :file ])
+    end
+end
