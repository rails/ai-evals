+class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfer::ActiveStorage::BlobRecordSet
+  class << self
+    def path_for(blob, id: blob.id)
+      filename = blob.filename.sanitized.gsub(/[[:cntrl:]]/, "-")
+      filename = "attachment" if filename.blank? || filename.in?([ ".", ".." ])
+      "files/#{id}/#{filename}"
     end
 
-    def excluded_blob_ids
-      ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
+    def export_blob(blob, zip)
+      path = path_for(blob)
+      unless zip.exists?(path)
+        zip.add_file(path, compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
     end
+  end
 
+  def directory
+    "files"
+  end
+
+  def export_to(zip)
+    count = 0
+    each_record do |blob|
+      self.class.export_blob(blob, zip)
+      count += 1
+    end
+    count
+  end
 end
