diff --git a/app/views/account/imports/new.html.erb b/app/views/account/imports/new.html.erb
new file mode 100644
index 0000000..147531a
--- /dev/null
+++ b/app/views/account/imports/new.html.erb
@@ -0,0 +1,22 @@
+<% @page_title = "Import a Fizzy account" %>
+
+<div class="panel panel--centered center txt-align-center">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+  <p>Choose a ZIP downloaded from Fizzy's account settings. We'll create a new account with its boards, cards, comments, files, and people. Your existing accounts won't change.</p>
+
+  <%= form_with model: @import, scope: :import, url: account_imports_path(script_name: nil), class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <%= form.label :file, "Account export (.zip)" %>
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+
+    <% if @import.errors.any? %>
+      <ul class="txt-negative txt-small">
+        <% @import.errors.full_messages.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    <% end %>
+
+    <p>We'll email <strong><%= Current.identity.email_address %></strong> when the import is finished, or if it can't be completed. A failed import won't leave a partial account behind.</p>
+    <%= form.submit "Import account", class: "btn btn--reversed center" %>
+  <% end %>
+</div>
diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
