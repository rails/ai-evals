@@ -0,0 +1,100 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "account export contains records and readable cards with comments" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+
+    assert_enqueued_with(job: ExportJob, args: [ export ])
+    assert_enqueued_emails 1 do
+      export.build_now
+    end
+
+    assert export.completed?
+    assert_in_delta 1.day, export.expires_at - Time.current, 2
+    zip = ZipFile::Reader.new(export.file.blob)
+    assert_equal "account", JSON.parse(zip.read("manifest.json"))["type"]
+    card = cards(:logo)
+    json = JSON.parse(zip.read("cards/#{card.number}.json"))
+    assert_equal card.title, json["title"]
+    assert_equal card.comments.count, json["comments"].size
+    assert_includes json["comments"].map { |comment| comment["body"] }.join, "I agree."
+    assert zip.exists?("data/accounts/#{@account.id}.json")
+    assert_not zip.exists?("data/accounts/#{accounts(:initech).id}.json")
+  ensure
+    export&.file&.purge
+  end
+
+  test "personal export only includes accessible cards and their attachments" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("picture"), filename: "picture.png", content_type: "image/png")
+    export = Export.create!(account: @account, user: users(:david), kind: :cards)
+    export.build_now
+
+    zip = ZipFile::Reader.new(export.file.blob)
+    assert_equal users(:david).accessible_cards.count, zip.glob("cards/*.json").size
+    assert_not zip.exists?("data/accounts/#{@account.id}.json")
+    json = JSON.parse(zip.read("cards/#{card.number}.json"))
+    assert_equal "picture", zip.read(json["image"]["path"])
+  ensure
+    export&.file&.purge
+    card&.image&.purge
+  end
+
+  test "completed exports are not rebuilt and expire after one day" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.build_now
+    token = export.download_token
+
+    assert_equal export, Export.find_signed(token, purpose: :download)
+    assert_no_enqueued_emails { export.build_now }
+    travel 1.day + 1.second do
+      assert_not export.downloadable?
+      assert_nil Export.find_signed(token, purpose: :download)
+    end
+  ensure
+    export&.file&.purge
+  end
+  test "a retry can notify about a completed export without rebuilding it" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    ExportMailer.stubs(:completed).raises(IOError, "mail queue unavailable")
+    assert_raises(IOError) { export.build_now }
+    assert export.reload.completed?
+    key = export.file.blob.key
+    assert_nil export.notified_at
+    ExportMailer.unstub(:completed)
+
+    assert_enqueued_emails(1) { export.build_now }
+    assert_equal key, export.file.blob.key
+    assert export.notified_at
+  ensure
+    export&.file&.purge
+  end
+
+  test "account exports exclude previous exports and unfinished uploads" do
+    first = Export.create!(account: @account, user: @user, kind: :account)
+    first.build_now
+    unfinished = ActiveStorage::Blob.create_before_direct_upload!(filename: "pending.png", byte_size: 100, checksum: "pending")
+    second = Export.create!(account: @account, user: @user, kind: :account)
+    second.build_now
+    zip = ZipFile::Reader.new(second.file.blob)
+    assert_not zip.exists?("data/active_storage_blobs/#{first.file.blob.id}.json")
+    assert_not zip.exists?("data/active_storage_blobs/#{unfinished.id}.json")
+  ensure
+    first&.file&.purge
+    second&.file&.purge
+    unfinished&.purge
+  end
+
+  test "permission is checked again when the job runs" do
+    export = Export.create!(account: @account, user: users(:kevin), kind: :account)
+    users(:kevin).update!(role: :member)
+    assert_raises(Account::DataTransfer::Error) { export.build_now }
+    assert_not export.reload.file.attached?
+  end
+end
