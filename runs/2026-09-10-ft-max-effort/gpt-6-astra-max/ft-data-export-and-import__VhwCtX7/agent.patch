--- /dev/null
+++ b/app/controllers/exports_controller.rb
@@ -0,0 +1,17 @@
+class ExportsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+
+  def show
+    export = Export.find_signed(params[:id], purpose: :download) || raise(ActiveRecord::RecordNotFound)
+    response.headers["Cache-Control"] = "no-store"
+
+    if export.downloadable?
+      ActiveStorage::Current.set(url_options: { protocol: request.protocol, host: request.host, port: request.port, script_name: nil }) do
+        redirect_to export.file.url(expires_in: export.expires_at - Time.current, disposition: :attachment), allow_other_host: true
+      end
+    else
+      head :gone
+    end
+  end
+end
