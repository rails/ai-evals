+    end
+
+    def data_offset_for(entry)
+      # Only the fixed header is needed to find the data. Reading ZipKit's maximum
+      # possible header for every tiny JSON entry would amplify S3 range traffic.
+      @io.seek(entry.local_file_header_offset)
+      header = @io.read(30)
+      signature, version, flags, compression = header.unpack("Vvvv")
+      unless signature == 0x04034b50 && (flags & 1).zero? && compression == entry.storage_mode
+        raise ZipFile::Error, "Invalid ZIP local header: #{entry.filename}"
+      end
+      filename_size, extra_size = header.byteslice(26, 4).unpack("vv")
+      entry.local_file_header_offset + 30 + filename_size + extra_size
+    end
+
+    def validate_entry(entry)
+      path = entry.filename
+      if path.blank? || path.start_with?("/") || path.match?(/\A[a-z]:/i) || path.include?("\\") || path.include?("\0") || path.split("/").intersect?([ ".", ".." ])
