+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "an identity without an account can start an import" do
+    identity = Identity.create!(email_address: "new-importer@example.com")
+    sign_in_as identity
+
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      assert_select "input[type=file]"
+
+      assert_difference -> { Account::Import.count }, 1 do
+        assert_enqueued_with(job: Account::ImportJob) do
+          post account_imports_path, params: { import: { file: fixture_file_upload("avatar.png", "application/zip"), identity_id: identities(:jason).id } }
+        end
+      end
+      assert_redirected_to account_import_path(Account::Import.last)
+      assert_equal identity, Account::Import.last.identity
+      assert_nil Account::Import.last.account
+      follow_redirect!
+      assert_response :success
+    end
+  ensure
+    Account::Import.last&.file&.purge
+  end
+
+  test "the background import sends its completion email after creating the account" do
+    sign_in_as :mike
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+    export.build_now
+    clear_enqueued_jobs
+
+    export.file.open do |file|
+      untenanted do
+        assert_difference -> { Account.count }, 1 do
+          assert_emails 1 do
+            perform_enqueued_jobs(only: [ Account::ImportJob, ActionMailer::MailDeliveryJob ]) do
+              post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(file.path, "application/zip") } }
+            end
+          end
+        end
+        import = Account::Import.last
+        assert import.completed?, import.error_message
+        assert_equal [ identities(:mike).email_address ], ActionMailer::Base.deliveries.last.to
+        assert_includes ActionMailer::Base.deliveries.last.text_part.body.decoded, import.account.slug
+        follow_redirect!
+        assert_response :success
+      end
+    end
+  ensure
+    export&.file&.purge
+  end
+
+  test "imports require signing in" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+      assert_no_difference -> { Account::Import.count } do
+        post account_imports_path, params: { import: { file: fixture_file_upload("avatar.png") } }
+      end
+      assert_response :redirect
+    end
+  end
+
+  test "an upload is required" do
+    sign_in_as :david
+    untenanted do
+      assert_no_difference -> { Account::Import.count } do
+        post account_imports_path, params: { import: { file: "" } }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "import status is private to its identity" do
+    import = Account::Import.new(identity: identities(:jason))
+    import.save!(validate: false)
+    sign_in_as :david
+    untenanted do
+      get account_import_path(import)
+      assert_response :not_found
+    end
+  end
+  test "an attached file cannot be adopted and purged by an import" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("private data"), filename: "private.zip", content_type: "application/zip")
+    sign_in_as :mike
+    untenanted do
+      assert_no_difference -> { Account::Import.count } do
+        post account_imports_path, params: { import: { file: card.image.blob.signed_id } }
+      end
+      assert_response :unprocessable_entity
+    end
+    assert_equal "private data", card.image.download
+  ensure
+    card&.image&.purge
+  end
+end
