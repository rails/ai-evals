+<% @page_title = "Account import" %>
+
+<div class="panel panel--centered center txt-align-center">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+  <% if @import.completed? %>
+    <p>Your account has been imported.</p>
+    <%= link_to "Open your imported account", root_path(script_name: @import.account.slug), class: "btn btn--link" %>
+  <% elsif @import.failed? %>
+    <p>Your import couldn't be completed: <%= @import.error_message %></p>
+    <p>No account or imported data has been kept.</p>
+    <%= link_to "Try another import", new_account_import_path(script_name: nil), class: "btn btn--link" %>
+  <% else %>
+    <p>Your account is being imported. You can close this page; we'll email you when it's finished, or if it can't be completed.</p>
+  <% end %>
+</div>
