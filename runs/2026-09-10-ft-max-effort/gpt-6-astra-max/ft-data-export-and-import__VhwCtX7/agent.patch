diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..18aaf6c
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,314 @@
+class Account::DataTransfer::Importer
+  POLYMORPHIC_TYPES = {
+    "Entropy" => %w[ Account Board ],
+    "Event" => %w[ Card Comment ],
+    "Notification" => %w[ Event Mention ],
+    "Mention" => %w[ Card Comment ],
+    "Reaction" => %w[ Card Comment ],
+    "ActionText::RichText" => %w[ Card Comment Board ],
+    "ActiveStorage::Attachment" => %w[ Card User ActionText::RichText ActiveStorage::Blob ActiveStorage::VariantRecord ]
+  }.freeze
+  EMBEDDED_IDS = {
+    "card_ids" => "Card", "column_ids" => "Column", "board_ids" => "Board", "tag_ids" => "Tag",
+    "assignee_ids" => "User", "creator_ids" => "User", "closer_ids" => "User"
+  }.freeze
+
+  attr_reader :account
+
+  def initialize(blob, identity:, file_key_prefix:)
+    @zip = ZipFile::Reader.new(blob)
+    @identity = identity
+    @file_key_prefix = file_key_prefix
+    @record_sets = []
+    Account::DataTransfer::Manifest.new(nil).each_record_set do |set|
+      @record_sets << set unless set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+    end
+    @models = @record_sets.map(&:model).index_by(&:name)
+    @ids = {}
+    @paths = {}
+  end
+
+  def import
+    validate_manifest
+
+    # Insert without model callbacks: restoring history must not publish events,
+    # send notifications, dispatch webhooks, or replace the original timestamps.
+    ApplicationRecord.transaction do
+      register_ids
+      create_account
+      Current.with(account: account, user: nil) do
+        @record_sets.drop(1).each { |set| import_records(set) }
+        import_files
+        complete_account
+        yield account if block_given?
+      end
+    end
+    account
+  rescue
+    discard_files
+    raise
+  end
+
+  def discard_files
+    ActiveStorage::Blob.service.delete_prefixed(@file_key_prefix)
+  end
+
+  private
+    attr_reader :zip, :identity, :manifest
+
+    def validate_manifest
+      @manifest = read_json("manifest.json")
+      unless manifest.values_at("format", "type") == [ "fizzy", "account" ]
+        raise Account::DataTransfer::Error, "Please choose a supported Fizzy account export, not a personal cards export."
+      end
+      unless manifest["version"] == Account::DataTransfer::Manifest::VERSION
+        raise Account::DataTransfer::Error, "This export uses an unsupported archive version. Please update Fizzy and try again."
+      end
+      unless manifest["counts"].is_a?(Hash) && manifest["counts"].keys.sort == (@record_sets.map(&:directory) + [ "files" ]).sort
+        raise Account::DataTransfer::Error, "The account archive has an incomplete manifest."
+      end
+    end
+
+    def read_json(path)
+      JSON.parse(zip.read(path)).tap do |data|
+        raise Account::DataTransfer::Error, "Invalid JSON record: #{path}" unless data.is_a?(Hash)
+      end
+    rescue JSON::ParserError
+      raise Account::DataTransfer::Error, "Invalid JSON record: #{path}"
+    end
+
+    def register_ids
+      @record_sets.each do |set|
+        paths = zip.glob("#{set.directory}/*.json")
+        verify_count(set.directory, paths.size)
+        @paths[set.model.name] = paths
+        @ids[set.model.name] = paths.index_with do |path|
+          old_id = File.basename(path, ".json")
+          unless path == "#{set.directory}/#{old_id}.json" && old_id.match?(/\A[0-9a-z]{25}\z/) && old_id.to_i(36) < 2**128
+            raise Account::DataTransfer::Error, "Invalid record ID in #{path}."
+          end
+          ActiveRecord::Type::Uuid.generate
+        end.transform_keys { |path| File.basename(path, ".json") }
+      end
+
+      unless @ids.fetch("Account").keys == [ manifest["account_id"] ]
+        raise Account::DataTransfer::Error, "The archive must contain exactly one account."
+      end
+      unless zip.glob("data/*").size == @paths.values.sum(&:size)
+        raise Account::DataTransfer::Error, "The archive contains unknown records."
+      end
+      verify_count("files", zip.glob("files/*").size)
+    end
+
+    def verify_count(directory, count)
+      unless manifest["counts"][directory] == count
+        raise Account::DataTransfer::Error, "The account archive is incomplete: #{directory}."
+      end
+    end
+
+    def create_account
+      data = read_record(@record_sets.first, @paths.fetch("Account").sole)
+      if data["name"].blank?
+        raise Account::DataTransfer::Error, "The account is missing its name."
+      end
+      attributes = data.slice("name", "cards_count", "created_at", "updated_at").merge(
+        "id" => id_for("Account", data["id"]), "external_account_id" => Account::ExternalIdSequence.next
+      )
+      Account.insert_all!([ attributes ])
+      @account = Account.find(attributes.fetch("id"))
+      account.create_join_code!
+    end
+
+    def read_record(set, path)
+      read_json(path).tap do |data|
+        unless data["id"] == File.basename(path, ".json") && (set.model == Account || data["account_id"] == manifest["account_id"])
+          raise Account::DataTransfer::Error, "Record does not belong to the exported account: #{path}."
+        end
+      end
+    end
+
+    def import_records(set)
+      @paths.fetch(set.model.name).each do |path|
+        data = read_record(set, path)
+        attributes = attributes_for(set, data)
+        set.model.insert_all!([ attributes ])
+        import_filter_associations(attributes.fetch("id"), data) if set.model == Filter
+      end
+    end
+
+    def attributes_for(set, data)
+      attributes = data.slice(*set.attributes).merge("id" => id_for(set.model.name, data["id"]), "account_id" => account.id)
+      remap_references(set.model, attributes, data)
+
+      case set.model.name
+      when "User"
+        prepare_user(attributes, data)
+      when "Board::Publication"
+        attributes["key"] = SecureRandom.base58(24)
+      when "ActiveStorage::Blob"
+        attributes["key"] = "#{@file_key_prefix}#{ActiveStorage::Blob.generate_unique_secure_token}"
+        attributes["service_name"] = ActiveStorage::Blob.service.name
+      when "ActionText::RichText"
+        validate_rich_text(attributes)
+        attributes["body"] = Account::DataTransfer::RichText.import(data["body"]) do |type, old_id|
+          @models.fetch(type).find(id_for(type, old_id))
+        end
+      when "ActiveStorage::Attachment"
+        validate_attachment(attributes)
+      when "Filter"
+        attributes["fields"] = remap_embedded_ids(data["fields"])
+      when "Event"
+        attributes["particulars"] = remap_embedded_ids(data["particulars"])
+      when "Notification::Bundle"
+        attributes["status"] = "delivered"
+      end
+
+      set.model.defined_enums.each do |name, values|
+        unless values.key?(attributes[name].to_s)
+          raise Account::DataTransfer::Error, "Invalid #{name} in #{set.model.model_name.human}."
+        end
+      end
+      attributes
+    end
+
+    def remap_references(model, attributes, data)
+      model.reflect_on_all_associations(:belongs_to).each do |reflection|
+        next if reflection.name == :identity && model == User
+
+        key = reflection.foreign_key
+        if data[key].present?
+          type = if reflection.polymorphic?
+            data[reflection.foreign_type].tap do |type|
+              unless POLYMORPHIC_TYPES.fetch(model.name, []).include?(type)
+                raise Account::DataTransfer::Error, "Invalid reference type in #{model.model_name.human}."
+              end
+            end
+          else
+            reflection.klass.name
+          end
+          attributes[key] = id_for(type, data[key])
+        end
+      end
+    end
+
+    def id_for(type, old_id)
+      @ids.fetch(type, {}).fetch(old_id) do
+        raise Account::DataTransfer::Error, "The archive is missing a referenced #{type.demodulize.underscore.humanize.downcase} record."
+      end
+    end
+
+    def prepare_user(attributes, data)
+      raise Account::DataTransfer::Error, "A person is missing their name." if attributes["name"].blank?
+
+      if data["email_address"].present? && attributes["role"] != "system"
+        person = Identity.find_or_create_by!(email_address: data["email_address"])
+        attributes["identity_id"] = person.id
+      end
+      # Ownership belongs to the person doing the import, not the source owner.
+      attributes["role"] = "admin" if attributes["role"] == "owner"
+    end
+
+    def validate_rich_text(attributes)
+      parent = @models.fetch(attributes["record_type"])
+      unless parent.reflect_on_association("rich_text_#{attributes['name']}")
+        raise Account::DataTransfer::Error, "Unknown rich text field in the archive."
+      end
+    end
+
+    def validate_attachment(attributes)
+      parent = @models.fetch(attributes["record_type"])
+      unless parent.reflect_on_attachment(attributes["name"])
+        raise Account::DataTransfer::Error, "Unknown attachment field in the archive."
+      end
+    end
+
+    def remap_embedded_ids(value)
+      if value.is_a?(Hash)
+        value.to_h do |key, item|
+          if type = EMBEDDED_IDS[key]
+            [ key, Array(item).filter_map { |old_id| @ids.fetch(type)[old_id] } ]
+          else
+            [ key, remap_embedded_ids(item) ]
+          end
+        end
+      else
+        value
+      end
+    end
+
+    def import_filter_associations(id, data)
+      filter = Filter.find(id)
+      Account::DataTransfer::FilterRecordSet::ASSOCIATIONS.each do |name|
+        type = Filter.reflect_on_association(name).klass.name
+        ids = Array(data.fetch("associations", {})[name]).map { |old_id| id_for(type, old_id) }
+        filter.public_send("#{name.singularize}_ids=", ids)
+      end
+      filter.update_columns(params_digest: Filter.digest_params(filter.as_params))
+    end
+
+    def import_files
+      @paths.fetch("ActiveStorage::Blob").each do |path|
+        data = read_json(path)
+        blob = ActiveStorage::Blob.find(id_for("ActiveStorage::Blob", data["id"]))
+        filename = Account::DataTransfer::ActiveStorage::FileRecordSet.path_for(blob, id: data["id"])
+        unless zip.size(filename) == blob.byte_size
+          raise Account::DataTransfer::Error, "Incorrect file size: #{blob.filename}."
+        end
+        ZipFile.write_blob(blob) do |stream|
+          digest, expected_checksum = source_digest(blob.checksum)
+          storage_digest = blob.service.checksum_implementation == digest.class ? digest : blob.service.checksum_implementation.new
+          zip.each_chunk(filename) do |chunk|
+            digest.update(chunk)
+            storage_digest.update(chunk) unless storage_digest.equal?(digest)
+            stream.write(chunk)
+          end
+          if expected_checksum.present? && expected_checksum != digest.base64digest
+            raise Account::DataTransfer::Error, "File failed its integrity check: #{blob.filename}."
+          end
+          blob.update_columns(checksum: ZipFile.checksum_for(blob.service, storage_digest.base64digest))
+        end
+      end
+    end
+
+    def source_digest(checksum)
+      if checksum.to_s.include?(":")
+        algorithm, value = checksum.split(":", 2)
+        unless algorithm == "sha256"
+          raise Account::DataTransfer::Error, "The archive uses an unsupported file checksum."
+        end
+        [ OpenSSL::Digest::SHA256.new, value ]
+      else
+        [ OpenSSL::Digest::MD5.new, checksum ]
+      end
+    end
+
+    def complete_account
+      owner = account.users.find_by(identity: identity)
+      if owner
+        owner.update_columns(role: "owner", active: true, verified_at: Time.current)
+      else
+        owner_id = ActiveRecord::Type::Uuid.generate
+        User.insert_all!([ { id: owner_id, account_id: account.id, identity_id: identity.id, role: "owner", name: identity.users.first&.name || identity.email_address, verified_at: Time.current } ])
+        owner = account.users.find(owner_id)
+        User::Settings.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: account.id, user_id: owner.id, bundle_email_frequency: :every_few_hours } ])
+      end
+      Access.insert_all account.boards.ids.map { |id| { id: ActiveRecord::Type::Uuid.generate, account_id: account.id, board_id: id, user_id: owner.id } }
+      unless account.users.exists?(role: :system) && account.entropy
+        raise Account::DataTransfer::Error, "The archive is missing account settings or its system user."
+      end
+
+      account.update_columns(cards_count: [ account.cards_count, account.cards.maximum(:number).to_i ].max)
+      account.cards.find_each(&:reindex)
+      Comment.where(account: account).find_each(&:reindex)
+      rebuild_storage_totals
+    end
+
+    def rebuild_storage_totals
+      account.boards.find_each do |board|
+        bytes = board.send(:calculate_real_storage_bytes)
+        entry = Storage::Entry.create!(account: account, board: board, delta: bytes, operation: "reconcile")
+        board.create_storage_total!(bytes_stored: bytes, last_entry_id: entry.id)
+      end
+      account.create_storage_total!(bytes_stored: account.boards.joins(:storage_total).sum("storage_totals.bytes_stored"), last_entry_id: account.storage_entries.maximum(:id))
+    end
