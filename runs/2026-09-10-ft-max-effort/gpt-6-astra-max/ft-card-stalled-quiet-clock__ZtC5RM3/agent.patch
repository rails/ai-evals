--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    freeze_time
+    @card = cards(:logo)
+    @board = @card.board
+    @board.publish
+  end
+
+  test "the stalled index returns only accessible stalled cards" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create! title: "A private card", status: :published
+    end
+    [ @card, private_card, cards(:radio) ].each(&:spike)
+    travel 2.weeks
+    Card.stall_all_due
+    cards(:text).spike
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+    assert_equal true, response.parsed_body.first["stalled"]
+
+    get cards_path, params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "article.card--stalled .card__stalled", text: "Stalled"
+    assert_select "[data-combobox-value=stalled]", text: "Stalled"
+  end
+
+  test "stalled can be combined with other card filters" do
+    stall_card
+
+    get cards_path(format: :json), params: { indexed_by: "stalled", board_ids: [ @board.id ], tag_ids: [ tags(:web).id ] }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+
+    get cards_path(format: :json), params: { indexed_by: "stalled", column_ids: [ columns(:writebook_in_progress).id ] }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "stalled indicators appear on card details board previews and pins" do
+    stall_card
+    @card.pin_by users(:david)
+
+    [ card_path(@card), board_column_path(@board, @card.column), my_pins_path ].each do |path|
+      get path
+      assert_response :success
+      assert_select "##{dom_id(@card, :article)}.card--stalled .card__stalled", text: "Stalled"
+    end
+  end
+
+  test "stalled indicators appear on public card details and previews" do
+    stall_card
+
+    [ public_board_card_path(@board.publication.key, @card), public_board_column_path(@board.publication.key, @card.column) ].each do |path|
+      get path
+      assert_response :success
+      assert_select "##{dom_id(@card, :article)}.card--stalled .card__stalled", text: "Stalled"
+    end
+  end
+
+  test "stalled indicators appear on activity timeline entries" do
+    event = @card.events.find_by!(action: "card_published")
+    stall_card
+
+    get events_path(day: event.created_at.to_date)
+    assert_response :success
+    assert_select "##{dom_id(event, :timelined)} .card__stalled", text: "Stalled"
+  end
+
+  test "card activity removes the indicator and the card from the stalled index" do
+    stall_card
+
+    patch card_path(@card, format: :json), params: { card: { description: "Working on this again" } }, as: :json
+    assert_response :success
+    assert_equal false, response.parsed_body["stalled"]
+
+    get card_path(@card)
+    assert_response :success
+    assert_select "article.card--stalled", count: 0
+    assert_select ".card__stalled", count: 0
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "cached previews reflect both stalling and renewed activity" do
+    with_actionview_partial_caching do
+      @card.spike
+      get board_column_path(@board, @card.column)
+      assert_select "##{dom_id(@card, :article)} .card__stalled", count: 0
+
+      travel 2.weeks
+      Card.stall_all_due
+      get board_column_path(@board, @card.column)
+      assert_select "##{dom_id(@card, :article)} .card__stalled", text: "Stalled"
+
+      travel 1.second
+      @card.reload.comments.create! body: "Working on this again", creator: users(:david)
+      get board_column_path(@board, @card.column)
+      assert_select "##{dom_id(@card, :article)} .card__stalled", count: 0
+    end
+  end
+
+  test "cached timeline entries reflect both stalling and renewed activity" do
+    with_actionview_partial_caching do
+      event = @card.events.find_by!(action: "card_published")
+      path = events_path(day: event.created_at.to_date)
+      selector = "##{dom_id(event, :timelined)} .card__stalled"
+
+      @card.spike
+      get path
+      assert_select selector, count: 0
+
+      travel 2.weeks
+      Card.stall_all_due
+      get path
+      assert_select selector, text: "Stalled"
+
+      travel 1.second
+      @card.reload.comments.create! body: "Working on this again", creator: users(:david)
+      get path
+      assert_select selector, count: 0
+    end
+  end
+
+  test "a burst of comments through the API leads to a stalled card" do
+    @card = with_current_user(:david) do
+      @board.cards.create! title: "A new discussion", status: :published
+    end
+
+    post card_comments_path(@card), params: { body: "First thought" }, as: :json
+    assert_response :created
+    assert_not @card.reload.spiked?
+
+    logout_and_sign_in_as :jz
+    post card_comments_path(@card), params: { body: "Another thought" }, as: :json
+    assert_response :created
+    assert_not @card.reload.spiked?
+
+    post card_comments_path(@card), params: { body: "Let's do this" }, as: :json
+    assert_response :created
+    assert @card.reload.spiked?
+
+    travel 2.weeks
+    Card.stall_all_due
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+    assert_equal true, response.parsed_body.first["stalled"]
+  end
+
+  private
+    def stall_card
+      @card.spike
+      travel 2.weeks
+      Card.stall_all_due
+      @card.reload
+    end
+end
