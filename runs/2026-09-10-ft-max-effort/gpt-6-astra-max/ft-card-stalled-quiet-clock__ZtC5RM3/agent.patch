diff --git a/app/models/card/engageable.rb b/app/models/card/engageable.rb
new file mode 100644
index 0000000..db6dc40
--- /dev/null
+++ b/app/models/card/engageable.rb
@@ -0,0 +1,68 @@
+module Card::Engageable
+  extend ActiveSupport::Concern
+
+  SPIKE_COMMENT_COUNT = 3
+  SPIKE_CREATOR_COUNT = 2
+  STALL_PERIOD = 2.weeks.to_i
+
+  included do
+    has_one :engagement, dependent: :destroy
+
+    scope :spiked, -> { joins(:engagement).merge(Card::Engagement.spiked) }
+    scope :stalled, -> { active.joins(:engagement).merge(Card::Engagement.stalled) }
+
+    after_save :reset_stalled_engagement, if: :saved_change_to_last_active_at?
+    # Deferred association touches skip dirty tracking. A cache-only touch must not reset a stall.
+    after_touch :reset_stalled_engagement, if: -> { last_active_at > Time.current - STALL_PERIOD }
+  end
+
+  class_methods do
+    def stall_all_due(as_of: Time.current)
+      Account.find_each do |account|
+        Current.set(account: account) do
+          account.cards.active.spiked.where(last_active_at: ..(as_of - STALL_PERIOD)).find_each do |card|
+            card.stall(as_of: as_of)
+          end
+        end
+      end
+    end
+  end
+
+  def spiked?
+    engagement&.spiked? || false
+  end
+
+  def stalled?
+    active? && (engagement&.stalled? || false)
+  end
+
+  def spike
+    with_lock do
+      (engagement || build_engagement).spiked! unless spiked?
+    end
+  end
+
+  def spike_if_engaged
+    unless spiked?
+      recent_comments = comments.by_user.where(created_at: (Time.current - auto_postpone_period / 3.0)..Time.current)
+
+      if recent_comments.count >= SPIKE_COMMENT_COUNT && recent_comments.distinct.count(:creator_id) >= SPIKE_CREATOR_COUNT
+        spike
+      end
+    end
+  end
+
+  def stall(as_of: Time.current)
+    with_lock do
+      if active? && spiked? && last_active_at <= as_of - STALL_PERIOD
+        engagement.stalled!
+      end
+    end
+  end
+
+  private
+    def reset_stalled_engagement
+      association(:engagement).reset
+      engagement.spiked! if engagement&.stalled?
+    end
+end
