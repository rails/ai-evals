--- /dev/null
+++ b/db/migrate/20260710120100_backfill_card_bursts.rb
@@ -0,0 +1,37 @@
+class BackfillCardBursts < ActiveRecord::Migration[8.2]
+  def up
+    Card.reset_column_information
+
+    Card.where(last_burst_at: nil).preload(board: [ :entropy, { account: :entropy } ]).find_each do |card|
+      if burst_at = assignment_or_reopening_at(card) || comment_burst_at(card)
+        Card.where(id: card.id, last_burst_at: nil).update_all(last_burst_at: burst_at, updated_at: Time.current)
+      end
+    end
+  end
+
+  def down
+    # The preceding migration removes the burst timestamps.
+  end
+
+  private
+    def assignment_or_reopening_at(card)
+      [
+        card.assignments.maximum(:created_at),
+        card.events.where(action: %w[ card_assigned card_reopened ]).maximum(:created_at)
+      ].compact.max
+    end
+
+    def comment_burst_at(card)
+      period = card.auto_postpone_period / 3.0
+
+      # Every qualifying window contains three consecutive human comments with
+      # at least two authors. Stream them so large discussions stay bounded.
+      card.comments.by_user.find_each(cursor: [ :created_at, :id ], order: [ :desc, :desc ]).each_cons(3) do |comments|
+        if comments.first.created_at - comments.last.created_at <= period && comments.map(&:creator_id).uniq.size >= 2
+          return comments.first.created_at
+        end
+      end
+
+      nil
+    end
+end
