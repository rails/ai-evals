index 0000000..1a2d0ff
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,282 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = boards(:writebook).cards.create!(title: "Burst of attention", status: :published).reload
+  end
+
+  test "a comment burst stalls after two quiet weeks and activity resets the clock" do
+    comment_by :david
+    comment_by :kevin
+    comment_by :david
+
+    assert_not @card.reload.stalled?
+    travel 2.weeks - 1.second
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+
+    comment_by :jz
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "two comments from different people are not a burst" do
+    comment_by :david
+    comment_by :kevin
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "comments from only one person are not a burst" do
+    4.times { comment_by :david }
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "assignment starts a burst" do
+    @card.toggle_assignment(users(:kevin))
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "reopening starts a burst" do
+    @card.close
+    @card.reopen
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "quiet cards without a burst do not stall" do
+    travel 1.year
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "comments exactly a third of the board period apart are a burst" do
+    @card.board.update! auto_postpone_period: 30.days
+    comment_by :david
+    travel 9.days
+    comment_by :kevin
+    travel 1.day
+    comment_by :david
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "comments spread beyond a third of the board period are not a burst" do
+    @card.board.update! auto_postpone_period: 30.days
+    comment_by :david
+    travel 10.days + 1.second
+    comment_by :kevin
+    comment_by :david
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "comment bursts use the account period when the board has no override" do
+    @card.board.entropy.destroy!
+    @card.board.reload
+    @card.account.entropy.update! auto_postpone_period: 3.days
+    comment_by :david
+    travel 1.day + 1.second
+    comment_by :kevin
+    comment_by :david
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "system comments count neither as comments nor as another person in a burst" do
+    comment_by :david
+    3.times { @card.comments.create!(creator: @card.account.system_user, body: "System activity") }
+    comment_by :david
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "comments on other cards do not contribute to a burst" do
+    comment_by :david
+    comment_by :kevin
+    cards(:layout).comments.create!(creator: users(:david), body: "Another card")
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "creating an assignment directly starts a burst" do
+    @card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "reopening an already open card does not start a burst" do
+    @card.reopen
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "drafted closed and postponed cards are not stalled" do
+    @card.toggle_assignment(users(:kevin))
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.drafted!
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "card content edits reset stalled cards" do
+    assert_activity_resets { @card.update!(title: "A new title") }
+    assert_activity_resets { @card.update!(description: "A new description") }
+    assert_activity_resets { @card.update!(due_on: Date.tomorrow) }
+  end
+
+  test "comment edits and deletions reset stalled cards" do
+    comment = comment_by :david
+    assert_activity_resets { comment.update!(body: "An updated comment") }
+    assert_activity_resets { comment.destroy! }
+  end
+
+  test "checklist activity resets stalled cards" do
+    step = nil
+    assert_activity_resets { step = @card.steps.create!(content: "First step") }
+    assert_activity_resets { step.update!(content: "Revised step") }
+    assert_activity_resets { step.update!(completed: true) }
+    assert_activity_resets { step.destroy! }
+  end
+
+  test "tagging and golden status reset stalled cards" do
+    assert_activity_resets { @card.toggle_tag_with("stalled test") }
+    assert_activity_resets { @card.toggle_tag_with("stalled test") }
+    assert_activity_resets { @card.gild }
+    assert_activity_resets { @card.ungild }
+  end
+
+  test "adding and removing reactions resets stalled cards" do
+    reaction = nil
+    assert_activity_resets { reaction = @card.reactions.create!(content: "👍") }
+    assert_activity_resets { reaction.destroy! }
+
+    comment = comment_by :david
+    assert_activity_resets { reaction = comment.reactions.create!(content: "👍") }
+    assert_activity_resets { reaction.destroy! }
+  end
+
+  test "unassigning and moving cards resets stalled cards" do
+    @card.toggle_assignment(users(:kevin))
+    assert_activity_resets { @card.toggle_assignment(users(:kevin)) }
+    assert_activity_resets { @card.triage_into(columns(:writebook_in_progress)) }
+    assert_activity_resets { @card.move_to(boards(:private)) }
+  end
+
+  test "the burst window includes fractional days" do
+    @card.board.update! auto_postpone_period: 11.days
+    comment_by :david
+    travel 3.days + 16.hours
+    comment_by :kevin
+    comment_by :david
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "publishing a previously assigned draft resets its activity clock" do
+    @card.drafted!
+    @card.toggle_assignment(users(:kevin))
+    travel 2.weeks
+
+    @card.publish
+
+    assert_equal Time.current, @card.reload.last_active_at
+    assert_not @card.stalled?
+  end
+
+  test "adding an image resets a stalled card" do
+    assert_activity_resets do
+      @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+  end
+
+  test "assignment and reopening events start a burst" do
+    @card.track_event(:assigned, assignee_ids: [ users(:kevin).id ])
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    @card.update_column(:last_burst_at, nil)
+    @card.track_event(:reopened)
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "the cutoff and deadline agree across daylight saving time changes" do
+    Time.use_zone("America/Los_Angeles") do
+      travel_to Time.zone.local(2026, 2, 22, 2, 30)
+      @card.record_burst
+      deadline = @card.stalled_at
+
+      travel 2.weeks.to_i - 1
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+      assert_equal Time.current + 1.second, deadline
+
+      travel 1.second
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+      assert_equal Time.current, deadline
+    end
+  end
+
+  test "cache invalidation is not card activity" do
+    @card.toggle_assignment(users(:kevin))
+    travel 2.weeks
+
+    @card.touch
+    @card.board.entropy.update! auto_postpone_period: 365.days
+    assert @card.reload.stalled?
+  end
+
+  private
+    def assert_activity_resets
+      @card.record_burst
+      travel 2.weeks
+      assert @card.reload.stalled?
+
+      yield
+
+      assert_not @card.reload.stalled?
+      assert_equal Time.current, @card.last_active_at
+      assert_not_includes Card.stalled, @card
+    end
+
+    def comment_by(name)
+      @card.comments.create!(body: "Let's work on this", creator: users(name))
+    end
+end
