+++ b/test/system/stalled_cards_test.rb
@@ -0,0 +1,82 @@
+require "application_system_test_case"
+
+class StalledCardsSystemTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    Current.user = users(:kevin)
+    @card = cards(:text)
+
+    travel_to 15.days.ago do
+      @card.toggle_assignment(users(:kevin))
+    end
+  end
+
+  test "stalled indicators appear on card details and previews" do
+    visit card_url(@card)
+    assert_stalled_bubble
+
+    visit cards_url(indexed_by: "stalled")
+    assert_stalled_bubble
+  end
+
+  test "a cached bubble is updated when connected" do
+    visit card_url(@card)
+    assert_stalled_bubble
+
+    page.execute_script <<~JS, dom_id(@card, :bubble)
+      const bubble = document.getElementById(arguments[0])
+      const cachedBubble = bubble.cloneNode(true)
+      cachedBubble.hidden = true
+      cachedBubble.classList.remove("bubble--stalled")
+      cachedBubble.querySelectorAll("[data-bubble-target]").forEach(target => target.textContent = "")
+      bubble.replaceWith(cachedBubble)
+    JS
+
+    assert_stalled_bubble
+  end
+
+  test "new activity clears the stalled indicator" do
+    visit card_url(@card)
+    assert_stalled_bubble
+
+    @card.comments.create!(creator: users(:kevin), body: "Let's get this moving again")
+    visit card_url(@card)
+
+    assert_no_selector "##{dom_id(@card, :bubble)}.bubble--stalled"
+    assert_no_selector "##{dom_id(@card, :bubble)}"
+  end
+
+  test "changing the activity deadline updates the indicator without a page reload" do
+    visit card_url(@card)
+    assert_stalled_bubble
+
+    page.execute_script <<~JS, dom_id(@card, :bubble)
+      document.getElementById(arguments[0]).dataset.bubbleStalledAtValue = new Date(Date.now() + 86400000).toISOString()
+    JS
+    assert_no_selector "##{dom_id(@card, :bubble)}.bubble--stalled"
+
+    page.execute_script <<~JS, dom_id(@card, :bubble)
+      document.getElementById(arguments[0]).dataset.bubbleStalledAtValue = new Date(Date.now() - 1000).toISOString()
+    JS
+    assert_stalled_bubble
+  end
+
+  test "a visible card becomes stalled at its deadline" do
+    visit card_url(@card)
+    assert_stalled_bubble
+
+    page.execute_script <<~JS, dom_id(@card, :bubble)
+      document.getElementById(arguments[0]).dataset.bubbleStalledAtValue = new Date(Date.now() + 1000).toISOString()
+    JS
+
+    assert_no_selector "##{dom_id(@card, :bubble)}.bubble--stalled"
+    assert_stalled_bubble
+  end
+
+  private
+    def assert_stalled_bubble
+      assert_selector "##{dom_id(@card, :bubble)}.bubble--stalled", text: /Stalled/i
+    end
+end
