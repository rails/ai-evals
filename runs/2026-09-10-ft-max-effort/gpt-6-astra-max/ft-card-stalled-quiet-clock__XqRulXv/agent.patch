diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..f9e930a
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,36 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks.to_i
+  BURST_COMMENTS_COUNT = 3
+  BURST_CREATORS_COUNT = 2
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..(Time.current - STALL_PERIOD)) }
+  end
+
+  def stalled?
+    last_burst_at? && active? && last_active_at <= (Time.current - STALL_PERIOD)
+  end
+
+  def stalled_at
+    last_active_at + STALL_PERIOD if last_burst_at? && active?
+  end
+
+  def record_burst
+    now = Time.current
+    update! last_burst_at: now, last_active_at: now
+  end
+
+  def detect_comment_burst
+    record_burst if comment_burst?
+  end
+
+  private
+    def comment_burst?
+      now = Time.current
+      recent_comments = comments.by_user.where(created_at: (now - auto_postpone_period / 3.0)..now)
+
+      recent_comments.count >= BURST_COMMENTS_COUNT && recent_comments.distinct.count(:creator_id) >= BURST_CREATORS_COUNT
+    end
+end
