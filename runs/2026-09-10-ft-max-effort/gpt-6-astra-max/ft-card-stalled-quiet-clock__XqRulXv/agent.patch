+require "test_helper"
+require_relative "../../db/migrate/20260710120100_backfill_card_bursts"
+
+class BackfillCardBurstsTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = boards(:writebook).cards.create!(title: "Existing card", status: :published).reload
+  end
+
+  test "backfills old comment bursts without resetting later activity" do
+    travel_to 60.days.ago do
+      comment_by :david
+      comment_by :kevin
+      comment_by :david
+    end
+    travel_to 15.days.ago do
+      comment_by :jz
+    end
+    @card.update_column(:last_burst_at, nil)
+    last_active_at = @card.reload.last_active_at
+
+    BackfillCardBursts.new.up
+
+    assert @card.reload.last_burst_at.present?
+    assert_equal last_active_at, @card.last_active_at
+    assert @card.stalled?
+  end
+
+  test "backfills assignments and reopenings without requiring human comments" do
+    reopened_card = cards(:shipping)
+    travel_to 15.days.ago do
+      @card.toggle_assignment(users(:kevin))
+      reopened_card.reopen
+    end
+    @card.update_column(:last_burst_at, nil)
+    reopened_card.update_column(:last_burst_at, nil)
+
+    BackfillCardBursts.new.up
+
+    assert @card.reload.stalled?
+    assert reopened_card.reload.stalled?
+  end
+
+  test "ignores system comments and comments outside the burst period" do
+    travel_to 60.days.ago do
+      comment_by :kevin
+    end
+    travel_to 15.days.ago do
+      3.times { comment_by :david }
+      @card.comments.create!(creator: @card.account.system_user, body: "A system comment")
+    end
+    @card.update_column(:last_burst_at, nil)
+
+    BackfillCardBursts.new.up
+
+    assert_nil @card.reload.last_burst_at
+    assert_not @card.stalled?
+  end
+
+  test "does not overwrite a burst that has already been recorded" do
+    @card.toggle_assignment(users(:kevin))
+    timestamps = @card.reload.attributes.slice("last_burst_at", "last_active_at", "updated_at")
+    travel 1.day
+
+    BackfillCardBursts.new.up
+
+    assert_equal timestamps, @card.reload.attributes.slice("last_burst_at", "last_active_at", "updated_at")
+  end
+
+  private
+    def comment_by(name)
+      @card.comments.create!(creator: users(name), body: "Historical comment")
+    end
+end
