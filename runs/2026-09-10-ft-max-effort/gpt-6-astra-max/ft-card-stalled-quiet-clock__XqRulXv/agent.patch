diff --git a/test/integration/stalled_cards_test.rb b/test/integration/stalled_cards_test.rb
new file mode 100644
index 0000000..40fa51b
--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    freeze_time
+    @card = cards(:text)
+    Current.set(user: users(:kevin)) { @card.toggle_assignment(users(:kevin)) }
+  end
+
+  test "cards index filters stalled cards" do
+    travel 2.weeks
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+    assert_equal true, response.parsed_body.first["stalled"]
+  end
+  test "stalled cards are shown in card details and previews" do
+    travel 2.weeks
+
+    [ card_path(@card), cards_path(indexed_by: "stalled"), board_column_path(@card.board, @card.column) ].each do |path|
+      get path
+      assert_response :success
+      assert_stalled_bubble
+    end
+  end
+
+  test "stalled cards are shown in public details and previews" do
+    @card.board.publish
+    travel 2.weeks
+
+    [ public_board_card_path(@card.board.publication.key, @card), public_board_column_path(@card.board.publication.key, @card.column) ].each do |path|
+      get path
+      assert_response :success
+      assert_stalled_bubble
+    end
+  end
+
+  test "activity removes a card from the stalled index and clears its indicator" do
+    travel 2.weeks
+    patch card_path(@card, format: :json), params: { card: { description: "Working on this again" } }
+    assert_response :success
+    assert_equal false, response.parsed_body["stalled"]
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_empty response.parsed_body
+
+    get card_path(@card)
+    assert_response :success
+    assert_select "#bubble_card_#{@card.id}.bubble--stalled", count: 0
+  end
+
+  test "stalled cards are limited to accessible boards and the current account" do
+    Current.set(user: users(:david)) do
+      private_board = Board.create!(name: "Private work", all_access: false)
+      private_board.cards.create!(title: "Private card", status: :published).record_burst
+      cards(:radio).record_burst
+    end
+    travel 2.weeks
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+  end
+
+  test "removing a card image resets its activity clock" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    delete card_image_path(@card), as: :json
+    assert_response :no_content
+    assert_not @card.reload.stalled?
+    assert_equal Time.current, @card.last_active_at
+  end
+
+  test "JSON stalled state is not frozen in the cached card" do
+    Rails.stubs(:cache).returns(ActiveSupport::Cache::MemoryStore.new)
+    with_actionview_partial_caching do
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal false, response.parsed_body["stalled"]
+
+      travel 2.weeks
+      cache_reads = []
+      ActiveSupport::Notifications.subscribed(->(event) { cache_reads << event.payload }, "cache_read.active_support") do
+        get card_path(@card, format: :json)
+      end
+      assert_response :success
+      assert cache_reads.any? { |read| read[:hit] && read[:key].include?(@card.cache_key_with_version) }
+      assert_equal true, response.parsed_body["stalled"]
+    end
+  end
+
+  private
+    def assert_stalled_bubble
+      assert_select "#bubble_card_#{@card.id}.bubble--stalled:not([hidden])" do
+        assert_select "[data-bubble-target=top]", text: "Stalled"
+      end
+      assert_select "#bubble_card_#{@card.id}[data-bubble-stalled-at-value=?]", @card.reload.stalled_at.iso8601
+    end
+end
