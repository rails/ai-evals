diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..3fe3e38
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,102 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded, name: :ip
+  before_action :require_pending_authentication
+  rate_limit to: 10, within: MagicLink::EXPIRATION_TIME, only: :create, with: :rate_limit_exceeded,
+    by: -> { @pending_authentication["magic_link_id"] }, name: :code
+
+  layout "public"
+  helper_method :email_authentication_restart_url
+
+  def new
+  end
+
+  def create
+    if identity = MagicLink.find_by(id: @pending_authentication["magic_link_id"])&.consume(params.permit(:code)[:code])
+      start_new_session_for identity
+      cookies.delete(:pending_authentication_token)
+      redirect_url = after_magic_link_authentication_url
+
+      respond_to do |format|
+        format.html { redirect_to redirect_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      message = "That code didn't work. Try again or request a new code."
+
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = message
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def require_pending_authentication
+      @pending_authentication = cookies.encrypted[:pending_authentication_token]
+
+      unless @pending_authentication
+        message = "Enter your email address to get a new sign-in code."
+
+        respond_to do |format|
+          format.html { redirect_to new_session_url, alert: message }
+          format.json { render json: { message: message }, status: :unauthorized }
+        end
+      end
+    end
+
+    def after_magic_link_authentication_url
+      return_url = after_authentication_url
+
+      if @pending_authentication["join_code"]
+        after_join_url
+      elsif @pending_authentication["purpose"] == "sign_up" || (Current.identity.users.none? && Account.accepting_signups?)
+        new_signup_completion_url
+      else
+        return_url
+      end
+    end
+
+    def after_join_url
+      attributes = @pending_authentication["join_code"]
+      join_code = Account::JoinCode.find_by(account_id: attributes["account_id"], code: attributes["code"])
+      join_code&.redeem_if { |account| join_code.code == attributes["code"] && Current.identity.join(account) }
+      user = Current.identity.users.active.find_by(account: join_code.account) if join_code
+
+      if user
+        if user.setup?
+          landing_url(script_name: join_code.account.slug)
+        else
+          new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        email_authentication_restart_url
+      end
+    end
+
+    def email_authentication_restart_url
+      join_code = @pending_authentication["join_code"]
+      account = Account.find_by(id: join_code["account_id"]) if join_code
+
+      if account
+        join_url(code: join_code["code"], script_name: account.slug)
+      elsif @pending_authentication["purpose"] == "sign_up"
+        new_signup_url
+      else
+        new_session_url
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
