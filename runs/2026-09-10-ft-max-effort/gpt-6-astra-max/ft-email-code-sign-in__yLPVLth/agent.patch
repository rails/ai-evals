+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+    end
+
+    @magic_link = @identity.magic_links.last
+  end
+
+  test "new shows the code form without exposing the code" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_select "form[action=?]", session_magic_link_path do
+        assert_select "input[name=code][autocomplete=one-time-code][maxlength='6']"
+      end
+      assert_in_body @identity.email_address
+      assert_not_in_body @magic_link.code
+    end
+  end
+
+  test "new requires a pending authentication cookie" do
+    cookies.delete("pending_authentication_token")
+
+    untenanted do
+      get new_session_magic_link_path
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create signs in via JSON and clears the pending cookie" do
+    untenanted do
+      assert_difference -> { Session.count }, 1 do
+        post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+      end
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+      assert_not cookies[:pending_authentication_token].present?
+      assert_equal @identity, Session.last.identity
+      assert_not MagicLink.exists?(@magic_link.id)
+    end
+  end
+
+  test "invalid codes can be retried without consuming the request" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "WRONG!" }
+      end
+
+      assert_response :unprocessable_entity
+      assert_select "#flash", text: /That code didn't work/
+      assert_select "input[name=code]"
+      assert MagicLink.exists?(@magic_link.id)
+      assert cookies[:pending_authentication_token].present?
+
+      post session_magic_link_path, params: { code: @magic_link.code.downcase }
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "missing and malformed codes are unauthorized via JSON" do
+    untenanted do
+      [ {}, { code: "" }, { code: "short" }, { code: [ @magic_link.code ] }, { code: { value: @magic_link.code } } ].each do |params|
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: params, as: :json
+        end
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "a code cannot authenticate a different pending identity" do
+    @magic_link.update!(code: "ABC123")
+    other_magic_link = identities(:mike).magic_links.create!(code: "XYZ789")
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: other_magic_link.code }, as: :json
+      end
+
+      assert_response :unauthorized
+      assert MagicLink.exists?(@magic_link.id)
+      assert MagicLink.exists?(other_magic_link.id)
+    end
+  end
+
+  test "a new request cannot be verified with an earlier request's code" do
+    @magic_link.update!(code: "ABC123")
+
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      @identity.magic_links.last.update!(code: "XYZ789")
+
+      post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "verification cannot change the pending identity or destination through parameters" do
+    untenanted do
+      post session_magic_link_path, params: {
+        code: @magic_link.code,
+        email_address: identities(:mike).email_address,
+        purpose: "sign_up",
+        return_to: "https://example.net"
+      }
+
+      assert_redirected_to landing_path
+      assert_equal @identity, Session.last.identity
+    end
+  end
+
+  test "missing or tampered cookies cannot authenticate" do
+    untenanted do
+      [ nil, "tampered-token" ].each do |token|
+        cookies[:pending_authentication_token] = token
+
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+        end
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "expired codes cannot authenticate even with an unexpired cookie" do
+    @magic_link.update!(expires_at: 1.second.ago)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+      end
+      assert_response :unauthorized
+    end
+  end
+
+  test "expired pending cookies cannot be replayed" do
+    token = cookies[:pending_authentication_token]
+
+    travel_to @magic_link.expires_at + 1.second do
+      cookies[:pending_authentication_token] = token
+
+      untenanted do
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+        end
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "a consumed code cannot be replayed with its original cookie" do
+    token = cookies[:pending_authentication_token]
+
+    untenanted do
+      post session_magic_link_path, params: { code: @magic_link.code }
+      sign_out
+      cookies[:pending_authentication_token] = token
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+      end
+      assert_response :unauthorized
+    end
+  end
+
+  test "verification is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+      end
+
+      assert_response :too_many_requests
+      assert MagicLink.exists?(@magic_link.id)
+    end
+  end
+  test "verification is also rate limited by pending code" do
+    Rails.cache.stubs(:increment).returns(1)
+    Rails.cache.expects(:increment)
+      .with("rate-limit:sessions/magic_links:code:#{@magic_link.id}", 1, expires_in: 15.minutes)
+      .returns(11)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @magic_link.code }, as: :json
+      end
+
+      assert_response :too_many_requests
+      assert MagicLink.exists?(@magic_link.id)
+    end
+  end
+end
