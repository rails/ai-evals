index 0000000..2cbc7dd
--- /dev/null
+++ b/test/integration/email_code_authentication_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in with the code from the email subject" do
+    untenanted do
+      code = request_email_code(session_path, email_address: identities(:kevin).email_address)
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code][maxlength='6']"
+
+      assert_difference -> { Session.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_path
+      assert_equal identities(:kevin), Session.last.identity
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "sign up with an email code and complete account setup" do
+    Account.any_instance.expects(:setup_customer_template).once
+
+    untenanted do
+      code = request_email_code(signup_path, signup: { email_address: "new-person@example.com" })
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+
+      account = Account.last
+      assert_redirected_to landing_url(script_name: account.slug)
+      assert_equal "new-person@example.com", account.users.find_by!(role: :owner).identity.email_address
+    end
+  end
+
+  test "join an account after verifying an email code" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+    code = nil
+
+    assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+      code = request_email_code(join_path(code: join_code.code, script_name: account.slug), email_address: "joiner@example.com")
+    end
+    assert_not cookies[:session_token].present?
+
+    untenanted do
+      assert_difference [ -> { User.count }, -> { join_code.reload.usage_count } ], 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    follow_redirect!
+    assert_response :success
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+
+    post users_joins_path(script_name: account.slug), params: { user: { name: "New Joiner" } }
+    assert_redirected_to landing_path(script_name: account.slug)
+
+    user = account.users.find_by!(identity: Identity.find_by!(email_address: "joiner@example.com"))
+    assert_predicate user, :verified?
+    assert_equal "New Joiner", user.name
+  end
+
+  private
+    def request_email_code(path, **params)
+      assert_emails 1 do
+        perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+          post path, params: params
+        end
+      end
+
+      assert_response :redirect
+      assert_match %r{/session/magic_link/new\z}, response.redirect_url
+      assert cookies[:pending_authentication_token].present?
+
+      email = ActionMailer::Base.deliveries.last
+      code = email.subject[/\b[A-Z0-9]{6}\b/]
+      assert code, "The email subject should contain a six-character code"
+      assert_includes email.text_part.body.decoded, code
+      code
+    end
+end
