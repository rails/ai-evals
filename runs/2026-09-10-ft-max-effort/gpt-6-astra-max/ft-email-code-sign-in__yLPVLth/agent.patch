+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p>If <strong><%= @pending_authentication["email_address"] %></strong> has access to Fizzy, you’ll receive a six-character sign-in code. Enter it below to continue. The code works for 15 minutes.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <%= form.label :code, "Sign-in code" %>
+    <%= form.text_field :code, required: true, class: "input center", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", autocorrect: "off", spellcheck: false, minlength: MagicLink::CODE_LENGTH, maxlength: MagicLink::CODE_LENGTH %>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p>Can’t find it? Check your spam folder, or <%= link_to "request a new code", email_authentication_restart_url %>.</p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
