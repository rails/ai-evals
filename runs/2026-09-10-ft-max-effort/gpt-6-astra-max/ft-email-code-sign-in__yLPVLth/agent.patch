@@ -0,0 +1,24 @@
+module Authentication::ViaMagicLink
+  private
+
+  def start_pending_authentication_for(identity, email_address: identity&.email_address, purpose: :sign_in, join_code: nil)
+    magic_link = identity&.send_magic_link
+
+    cookies.encrypted[:pending_authentication_token] = {
+      value: {
+        magic_link_id: magic_link&.id || SecureRandom.base36(25),
+        email_address: email_address,
+        purpose: purpose,
+        join_code: join_code&.slice(:account_id, :code)
+      },
+      expires: magic_link&.expires_at || MagicLink::EXPIRATION_TIME.from_now,
+      httponly: true,
+      same_site: :lax
+    }
+
+    respond_to do |format|
+      format.html { redirect_to new_session_magic_link_url(script_name: nil) }
+      format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+    end
+  end
+end
