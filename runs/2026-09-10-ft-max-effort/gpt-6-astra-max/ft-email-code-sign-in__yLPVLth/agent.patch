diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..0d66951
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code valid for fifteen minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_match /\A[A-Z0-9]{6}\z/, magic_link.code
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert_includes MagicLink.active, magic_link
+    end
+  end
+
+  test "consumes a code only once even with a stale record" do
+    magic_link = @identity.magic_links.create!
+    stale_magic_link = MagicLink.find(magic_link.id)
+
+    assert_equal @identity, magic_link.consume(magic_link.code)
+    assert_nil stale_magic_link.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "accepts lowercase codes and surrounding whitespace" do
+    magic_link = @identity.magic_links.create!(code: "ABC123")
+
+    assert_equal @identity, magic_link.consume(" abc123 \n")
+  end
+
+  test "does not consume an invalid code" do
+    magic_link = @identity.magic_links.create!(code: "ABC123")
+
+    [ "WRONG1", "ABC12", "", nil ].each do |code|
+      assert_nil magic_link.consume(code)
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "codes are scoped to their own request" do
+    magic_link = @identity.magic_links.create!(code: "ABC123")
+    other_magic_link = identities(:mike).magic_links.create!(code: "XYZ789")
+
+    assert_nil magic_link.consume(other_magic_link.code)
+    assert MagicLink.exists?(other_magic_link.id)
+    assert_equal @identity, magic_link.consume(magic_link.code)
+  end
+
+  test "a code works just before it expires" do
+    magic_link = @identity.magic_links.create!
+
+    travel_to magic_link.expires_at - 1.second do
+      assert_equal @identity, magic_link.consume(magic_link.code)
+    end
+  end
+
+  test "a code stops working at exactly fifteen minutes" do
+    magic_link = @identity.magic_links.create!
+
+    travel_to magic_link.expires_at, with_usec: true do
+      assert_nil magic_link.consume(magic_link.code)
+      assert_not_includes MagicLink.active, magic_link
+      assert_includes MagicLink.expired, magic_link
+    end
+  end
+
+  test "cleanup removes expired codes but keeps active ones" do
+    expired = @identity.magic_links.create!(expires_at: Time.current)
+    active = @identity.magic_links.create!
+
+    assert_difference -> { MagicLink.count }, -1 do
+      MagicLink.cleanup
+    end
+
+    assert_not MagicLink.exists?(expired.id)
+    assert MagicLink.exists?(active.id)
+  end
+
+  test "destroying an identity removes its pending codes" do
+    magic_link = @identity.magic_links.create!
+    @identity.destroy!
+
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+end
