@@ -0,0 +1,23 @@
+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>Enter the six-character code sent to <strong><%= pending_authentication["email_address"] %></strong>. It’s valid for 15 minutes.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <%= form.label :code, "Sign-in code", class: "for-screen-reader" %>
+    <%= form.text_field :code, required: true, class: "input center", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, minlength: MagicLink::CODE_LENGTH, maxlength: MagicLink::CODE_LENGTH %>
+
+    <button type="submit" class="btn btn--link center">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p><%= link_to "Request a new code or use a different email", pending_authentication["entry_url"], class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
