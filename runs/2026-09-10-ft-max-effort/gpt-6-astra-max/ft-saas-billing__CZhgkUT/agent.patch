diff --git a/saas/test/controllers/account/subscriptions/checkouts_controller_test.rb b/saas/test/controllers/account/subscriptions/checkouts_controller_test.rb
new file mode 100644
index 0000000..ca7ec69
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions/checkouts_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+require_relative "../../../support/stripe_test_helper"
+
+class Account::Subscriptions::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    sign_in_as :kevin
+    @account = accounts(:"37s")
+  end
+
+  test "checkout creates and reuses an account-bound customer with a configured price" do
+    ::Stripe::Customer.expects(:create).with({
+      name: @account.name, email: @account.owner_email, metadata: { account_id: @account.id }
+    }, { idempotency_key: "fizzy-account-#{@account.id}" }).once
+      .returns(::Stripe::Customer.construct_from(id: "cus_offline"))
+    ::Stripe::Checkout::Session.expects(:create).with({
+      mode: "subscription", customer: "cus_offline", client_reference_id: @account.id,
+      line_items: [ { price: ENV["STRIPE_MONTHLY_V1_PRICE_ID"], quantity: 1 } ],
+      subscription_data: { metadata: { account_id: @account.id } },
+      success_url: saas.account_subscription_url(checkout: "success"), cancel_url: saas.account_subscription_url
+    }, has_entry(:idempotency_key, regexp_matches(/\Afizzy-checkout-/))).once
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_offline", status: "open", url: "https://checkout.stripe.com/c/pay/offline"))
+    ::Stripe::Checkout::Session.expects(:retrieve).with("cs_offline").once
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_offline", status: "open", url: "https://checkout.stripe.com/c/pay/offline"))
+
+    2.times do
+      post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1", price_id: "price_tampered", customer_id: "cus_tampered" }
+      assert_redirected_to "https://checkout.stripe.com/c/pay/offline"
+      assert_response :see_other
+    end
+
+    assert_equal "cus_offline", @account.reload.subscription.stripe_customer_id
+    assert_equal "Free", @account.billing_plan.name
+  end
+
+  test "the plus checkout uses the 500 GB price" do
+    @account.create_subscription!(stripe_customer_id: "cus_offline")
+    ::Stripe::Checkout::Session.expects(:create).with({
+      mode: "subscription", customer: "cus_offline", client_reference_id: @account.id,
+      line_items: [ { price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"], quantity: 1 } ],
+      subscription_data: { metadata: { account_id: @account.id } },
+      success_url: saas.account_subscription_url(checkout: "success"), cancel_url: saas.account_subscription_url
+    }, { idempotency_key: "fizzy-checkout-#{@account.subscription.id}-monthly_extra_storage_v1" })
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_plus", status: "open", url: "https://checkout.stripe.com/c/pay/plus"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_extra_storage_v1" }
+    assert_redirected_to "https://checkout.stripe.com/c/pay/plus"
+  end
+
+  test "unknown and free plan keys cannot create checkout sessions" do
+    [ "free_v1", "price_tampered", nil ].each do |plan_key|
+      post saas.account_subscription_checkout_path, params: { plan_key: plan_key }
+      assert_response :unprocessable_entity
+    end
+    assert_nil @account.reload.subscription
+  end
+
+  test "subscribed and comped accounts cannot start a second subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_offline", stripe_subscription_id: "sub_offline", status: "active", plan_key: "monthly_v1")
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_extra_storage_v1" }
+    assert_response :conflict
+
+    @account.subscription.update!(status: "canceled")
+    @account.comp
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_extra_storage_v1" }
+    assert_response :conflict
+  end
+
+  test "members cannot view or change billing" do
+    logout_and_sign_in_as :jz
+
+    get saas.account_subscription_path
+    assert_response :forbidden
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_response :forbidden
+    post saas.account_subscription_portal_path
+    assert_response :forbidden
+    assert_nil @account.reload.subscription
+  end
+
+  test "admins cannot change another account's billing" do
+    post saas.account_subscription_checkout_path(script_name: accounts(:initech).slug), params: { plan_key: "monthly_v1" }
+    assert_response :redirect
+    assert_nil accounts(:initech).reload.subscription
+  end
+
+  test "the checkout return URL never grants a paid plan" do
+    get saas.account_subscription_path(checkout: "success")
+    assert_response :success
+    assert_equal "Free", @account.reload.billing_plan.name
+    assert_select "[role=status]", text: /once Stripe confirms/
+  end
+
+  test "Stripe errors let the administrator retry without granting a paid plan" do
+    ::Stripe::Customer.stubs(:create).raises(::Stripe::APIConnectionError.new("Offline"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_redirected_to saas.account_subscription_path
+    assert_match /temporarily unavailable/, flash[:alert]
+    assert_nil @account.reload.subscription
+  end
+
+  test "missing price configuration does not contact Stripe" do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_redirected_to saas.account_subscription_path
+    assert_nil @account.reload.subscription
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions/portals_controller_test.rb b/saas/test/controllers/account/subscriptions/portals_controller_test.rb
new file mode 100644
index 0000000..fdb8b44
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions/portals_controller_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+require_relative "../../../support/stripe_test_helper"
+
+class Account::Subscriptions::PortalsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    sign_in_as :kevin
+    @account = accounts(:"37s")
+  end
+
+  test "portal uses only the current account customer and returns to its billing page" do
+    @account.create_subscription!(stripe_customer_id: "cus_offline", stripe_subscription_id: "sub_offline", status: "active", plan_key: "monthly_v1")
+    ::Stripe::BillingPortal::Session.expects(:create).with(customer: "cus_offline", return_url: saas.account_subscription_url)
+      .returns(::Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session/offline"))
+
+    post saas.account_subscription_portal_path, params: { customer_id: "cus_other", return_url: "https://example.net" }
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/offline"
+  end
+
+  test "accounts without a Stripe customer cannot open a portal" do
+    post saas.account_subscription_portal_path
+    assert_response :not_found
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..ee6cb5a
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    integration_session.default_url_options[:script_name] = ""
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and open each account" do
+    get saas.admin_accounts_path
+    assert_response :success
+    assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+
+    get saas.admin_account_path(@account)
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value=Override]"
+  end
+
+  test "staff can comp and uncomp an account" do
+    post saas.admin_account_billing_waiver_path(@account)
+    assert_redirected_to saas.admin_account_path(@account)
+    assert @account.reload.comped?
+
+    follow_redirect!
+    assert_select "button", text: "Uncomp"
+
+    delete saas.admin_account_billing_waiver_path(@account)
+    assert_redirected_to saas.admin_account_path(@account)
+    assert_not @account.reload.comped?
+  end
+
+  test "staff can override effective usage and Reset drops the override" do
+    patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "1000", bytes_used: "536870912000" } }
+    assert_redirected_to saas.admin_account_path(@account)
+    assert_equal 1_000, @account.reload.card_count
+    assert_equal 500.gigabytes, @account.bytes_used
+
+    follow_redirect!
+    assert_select "button", text: "Reset"
+
+    delete saas.admin_account_overridden_limits_path(@account)
+    assert_redirected_to saas.admin_account_path(@account)
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "account admins who are not staff cannot access support tools" do
+    logout_and_sign_in_as :mike
+    get saas.admin_accounts_path
+    assert_response :forbidden
+
+    get saas.admin_account_path(@account)
+    assert_response :forbidden
+
+    post saas.admin_account_billing_waiver_path(@account)
+    assert_response :forbidden
+    assert_not @account.reload.comped?
+
+    patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "0" } }
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "invalid overrides render errors without changing usage" do
+    @account.override_limits(card_count: 950, bytes_used: 0)
+    patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "-1", bytes_used: "1.5" } }
+    assert_response :unprocessable_entity
+    assert_select "[role=alert]", text: /Card count/
+    assert_equal 950, @account.reload.card_count
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "blank and zero overrides work and cannot be reassigned to another account" do
+    patch saas.admin_account_overridden_limits_path(@account), params: {
+      overridden_limits: { card_count: "0", bytes_used: "", account_id: accounts(:acme).id }
+    }
+    assert_response :redirect
+    assert_equal 0, @account.reload.card_count
+    assert_nil @account.overridden_limits.bytes_used
+    assert_nil accounts(:acme).overridden_limits
+  end
+
+  test "non-staff cannot uncomp or reset overrides" do
+    @account.comp
+    @account.override_limits(card_count: 0, bytes_used: nil)
+    logout_and_sign_in_as :mike
+
+    delete saas.admin_account_billing_waiver_path(@account)
+    assert_response :forbidden
+    assert @account.reload.comped?
+
+    delete saas.admin_account_overridden_limits_path(@account)
+    assert_response :forbidden
+    assert @account.reload.overridden_limits
+  end
+
+  test "support pages require authentication" do
+    sign_out
+    get saas.admin_accounts_path
+    assert_redirected_to new_session_path
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..424041e
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,170 @@
+require "test_helper"
+require_relative "../../support/stripe_test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_offline")
+  end
+
+  test "signed subscription creation works without a session or account slug" do
+    untenanted { assert_equal "/stripe/webhooks", saas.stripe_webhooks_path }
+
+    post_stripe_event(subscription_event)
+    assert_response :ok
+    assert_equal "active", @subscription.reload.status
+    assert_equal "sub_offline", @subscription.stripe_subscription_id
+    assert_equal "Unlimited", @account.reload.billing_plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal 1.month.from_now.to_i, @subscription.current_period_end.to_i
+  end
+
+  test "updates change plans and their storage allowances" do
+    post_stripe_event(subscription_event)
+    post_stripe_event(subscription_event(type: "customer.subscription.updated", price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]))
+    assert_response :ok
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    post_stripe_event(subscription_event(type: "customer.subscription.updated"))
+    assert_response :ok
+    assert_equal "Unlimited", @account.reload.billing_plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "cancel at period end keeps access until subscription deletion" do
+    post_stripe_event(subscription_event(cancel_at_period_end: true))
+    assert_response :ok
+    assert @subscription.reload.active?
+    assert_equal @subscription.current_period_end, @subscription.cancel_at
+
+    post_stripe_event(subscription_event(type: "customer.subscription.deleted", status: "canceled", items: { data: [] }))
+    assert_response :ok
+    assert_equal "Free", @account.reload.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "unpaid and incomplete subscriptions do not grant a paid plan" do
+    post_stripe_event(subscription_event(status: "incomplete"))
+    assert_response :ok
+    assert_equal "Free", @account.reload.billing_plan.name
+
+    post_stripe_event(subscription_event(type: "customer.subscription.updated", status: "unpaid"))
+    assert_response :ok
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "duplicate events are recorded only once and cannot undo a later change" do
+    event = subscription_event
+    post_stripe_event(event)
+    post_stripe_event(subscription_event(type: "customer.subscription.updated", price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]))
+
+    assert_no_difference -> { Account::Subscription::Event.count } do
+      post_stripe_event(event)
+    end
+    assert_response :ok
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+  end
+
+  test "out of order updates do not revert the latest plan" do
+    post_stripe_event(subscription_event(price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]))
+    post_stripe_event(subscription_event(type: "customer.subscription.updated", created: 1.minute.ago.to_i))
+
+    assert_response :ok
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+  end
+
+  test "a canceled subscription cannot be reactivated by a delayed event" do
+    post_stripe_event(subscription_event(type: "customer.subscription.deleted", status: "canceled"))
+    post_stripe_event(subscription_event)
+
+    assert_response :ok
+    assert_equal "canceled", @subscription.reload.status
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "a deletion for an old subscription does not cancel its replacement" do
+    post_stripe_event(subscription_event(subscription_id: "sub_old"))
+    event = subscription_event(subscription_id: "sub_new", price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"])
+    event[:data][:object][:created] = 1.hour.ago.to_i
+    post_stripe_event(event)
+    post_stripe_event(subscription_event(type: "customer.subscription.deleted", subscription_id: "sub_old", status: "canceled"))
+
+    assert_response :ok
+    assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+  end
+
+  test "unknown customers and unrelated events are acknowledged without changing accounts" do
+    assert_no_difference -> { Account::Subscription::Event.count } do
+      post_stripe_event(subscription_event(customer: "cus_someone_else", metadata: { account_id: @account.id }))
+      assert_response :ok
+      post_stripe_event(subscription_event(type: "invoice.paid"))
+      assert_response :ok
+    end
+    assert_nil @subscription.reload.status
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "unrecognized prices are not applied or acknowledged as successful" do
+    post_stripe_event(subscription_event(price: "price_unknown"))
+    assert_response :unprocessable_entity
+    assert_nil @subscription.reload.status
+    assert_equal 0, @subscription.events.count
+  end
+
+  test "missing invalid and expired signatures are refused" do
+    payload = subscription_event.to_json
+    untenanted do
+      post saas.stripe_webhooks_path, params: payload, headers: { "Content-Type" => "application/json" }
+      assert_response :bad_request
+
+      post saas.stripe_webhooks_path, params: payload,
+        headers: { "Content-Type" => "application/json", "Stripe-Signature" => "t=#{Time.current.to_i},v1=invalid" }
+      assert_response :bad_request
+    end
+
+    post_stripe_event(payload, timestamp: 10.minutes.ago)
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "signed malformed JSON is refused" do
+    post_stripe_event("not json")
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "a missing webhook secret fails closed" do
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+    untenanted { post saas.stripe_webhooks_path, as: :json }
+    assert_response :service_unavailable
+    assert_nil @subscription.reload.status
+  end
+
+  test "malformed signed event envelopes do not change subscriptions" do
+    [ {}, subscription_event.merge(created: "yesterday"), subscription_event.merge(data: {}) ].each do |event|
+      post_stripe_event(event)
+      assert_response :bad_request
+    end
+    assert_nil @subscription.reload.status
+    assert_equal 0, @subscription.events.count
+  end
+
+  test "a delayed creation event cannot overwrite an update from the same second" do
+    post_stripe_event(subscription_event(type: "customer.subscription.updated", price: ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]))
+    post_stripe_event(subscription_event)
+    assert_response :ok
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+  end
+
+  test "a confirmed subscription clears the pending checkout" do
+    @subscription.update!(stripe_checkout_session_id: "cs_offline", stripe_checkout_plan_key: "monthly_v1")
+    post_stripe_event(subscription_event)
+    assert_response :ok
+    assert_nil @subscription.reload.stripe_checkout_session_id
+    assert_nil @subscription.stripe_checkout_plan_key
+  end
+end
diff --git a/saas/test/integration/billing_test.rb b/saas/test/integration/billing_test.rb
new file mode 100644
index 0000000..cb8e0a9
--- /dev/null
+++ b/saas/test/integration/billing_test.rb
@@ -0,0 +1,192 @@
+require "test_helper"
+
+class BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    integration_session.default_url_options[:script_name] = @account.slug
+    @account.update_column(:cards_count, 100)
+  end
+
+  test "a free account at its card limit can still draft and edit" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    post board_cards_path(@board)
+    assert_redirected_to card_draft_path(@draft)
+
+    put card_path(@draft), params: { card: { title: "Still drafting" } }, as: :json
+    assert_response :success
+    assert_equal "Still drafting", @draft.reload.title
+    assert @draft.drafted?
+  end
+
+  test "publishing and API creation are refused at the card limit" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    post card_publish_path(@draft)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board), params: { card: { title: "Over the limit" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "publishing the thousandth real card works but the next card is refused" do
+    existing_count = @account.cards.published.count
+    @account.cards.insert_all!((999 - existing_count).times.map do |i|
+      { id: ActiveRecord::Type::Uuid.generate, board_id: @board.id, creator_id: users(:mike).id,
+        number: 1_000 + i, title: "Published card", status: "published", last_active_at: Time.current, created_at: Time.current, updated_at: Time.current }
+    end)
+
+    post card_publish_path(@draft)
+    assert_response :redirect
+    assert_equal 1_000, @account.cards.published.count
+
+    post board_cards_path(@board), params: { card: { title: "One too many" } }, as: :json
+    assert_response :forbidden
+    assert_equal 1_000, @account.cards.published.count
+  end
+
+  test "create buttons give way to an Upgrade pitch at the limit" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+
+    get board_path(@board)
+    assert_response :success
+    assert_select "button", text: "Add a card", count: 0
+    assert_select "form[action=?] button", board_cards_path(@board), text: "Start a draft"
+    assert_select "a", text: "Upgrade"
+
+    get root_path
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "warning counts down without removing create buttons" do
+    @account.override_limits(card_count: 950, bytes_used: nil)
+
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select "[role=status]", text: /50 cards left/
+  end
+
+  test "comped accounts can publish past the card limit" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    @account.comp
+
+    post card_publish_path(@draft)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "admins see their plan and Upgrade in settings" do
+    get account_settings_path
+    assert_response :success
+    assert_select "#billing", text: /Free/
+    assert_select "#billing a", text: "Upgrade"
+  end
+
+  test "billing page shows the approved plans" do
+    get saas.account_subscription_path
+    assert_response :success
+    assert_select "h2", text: "Free"
+    assert_select "h2", text: "Unlimited"
+    assert_select "h2", text: "Unlimited+"
+    assert_match "$20/month", response.body
+    assert_match "$25/month", response.body
+    assert_match "500 GB", response.body
+  end
+
+  test "cached board and activity pages reflect changes to billing limits" do
+    [ board_path(@board), root_path ].each do |path|
+      @account.override_limits(card_count: 950, bytes_used: nil)
+      get path
+      assert_response :success
+      etag = response.headers.fetch("ETag")
+
+      get path, headers: { "If-None-Match" => etag }
+      assert_response :not_modified
+
+      @account.override_limits(card_count: 1_000, bytes_used: nil)
+      get path, headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select "a", text: "Upgrade"
+      assert_select "button", text: "Add a card", count: 0
+      assert_select "form[action=?] button", board_cards_path(@board), text: "Start a draft"
+    end
+  end
+
+  test "a new draft can be created after the card allowance is exhausted" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { @account.cards.drafted.count } do
+      post board_cards_path(@board)
+    end
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "card limits also apply to bearer-token API requests" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    token = identities(:mike).access_tokens.create!(permission: :write)
+    sign_out
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board), params: { card: { title: "API card" } }, as: :json,
+        headers: { "Authorization" => "Bearer #{token.token}" }
+    end
+    assert_response :forbidden
+    assert_match /Upgrade/, response.parsed_body.fetch("error")
+
+    post card_publish_path(@draft), as: :json, headers: { "Authorization" => "Bearer #{token.token}" }
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "members are directed to an admin and do not see billing settings" do
+    users(:mike).update!(role: :member)
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_match /Ask an admin to/, response.body
+    assert_select "a[href=?]", saas.account_subscription_path, count: 0
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+
+    get account_settings_path
+    assert_response :success
+    assert_select "#billing", count: 0
+  end
+
+  test "paid API creation uses the plan's storage allowance" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+    @account.override_limits(card_count: 5_000, bytes_used: 6.gigabytes)
+
+    post board_cards_path(@board), params: { card: { title: "Too much storage for Unlimited" } }, as: :json
+    assert_response :forbidden
+
+    subscription.update!(plan_key: "monthly_extra_storage_v1")
+    post board_cards_path(@board), params: { card: { title: "Fits Unlimited+" } }, as: :json
+    assert_response :created
+  end
+
+  test "comp overrides do not hide existing Stripe charges from admins" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", stripe_subscription_id: "sub_initech", status: "active", plan_key: "monthly_v1")
+    @account.comp
+
+    get account_settings_path
+    assert_response :success
+    assert_select "#billing", text: /still has a Stripe subscription/
+    assert_select "#billing button", text: "Manage billing"
+  end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..eff205e
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan has the approved card and storage allowances" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "only published cards count, not the numbering sequence or drafts" do
+    @account.update_column(:cards_count, 10_000)
+
+    assert_equal @account.cards.published.count, @account.card_count
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "warning starts with 100 cards left and ends at the limit" do
+    @account.override_limits(card_count: 899, bytes_used: nil)
+    assert_not @account.nearing_card_limit?
+
+    @account.override_limits(card_count: 900, bytes_used: nil)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.override_limits(card_count: 999, bytes_used: nil)
+    assert @account.nearing_card_limit?
+    assert_equal 1, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 0, @account.cards_remaining
+
+    @account.override_limits(card_count: 1_001, bytes_used: nil)
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "paid plans bring their own storage allowance and unlimited cards" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+    @account.override_limits(card_count: 50_000, bytes_used: 2.gigabytes)
+
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_equal 2_000, @account.billing_plan.price_in_cents
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_storage_limit?
+
+    subscription.update!(plan_key: "monthly_extra_storage_v1")
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_equal 2_500, @account.billing_plan.price_in_cents
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "inactive subscriptions do not grant paid allowances" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_initech", status: "incomplete", plan_key: "monthly_v1")
+    assert_equal "Free", @account.billing_plan.name
+
+    subscription.update!(status: "canceled")
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp are idempotent and restore the underlying plan" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    2.times { @account.comp }
+
+    assert @account.comped?
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_not @account.exceeding_card_limit?
+    assert_equal 1, Account::BillingWaiver.where(account: @account).count
+
+    2.times { @account.uncomp }
+    assert_not @account.comped?
+    assert @account.exceeding_card_limit?
+  end
+
+  test "zero overrides are effective and reset restores real usage" do
+    real_card_count = @account.cards.published.count
+    @account.override_limits(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    @account.reset_overridden_limits
+    assert_nil @account.overridden_limits
+    assert_equal real_card_count, @account.card_count
+  end
+
+  test "storage overrides do not alter the storage ledger" do
+    @account.create_storage_total!(bytes_stored: 123)
+    @account.override_limits(card_count: nil, bytes_used: 500.gigabytes)
+    assert_equal 500.gigabytes, @account.bytes_used
+
+    @account.reset_overridden_limits
+    assert_equal 123, @account.bytes_used
+  end
+
+  test "overrides reject negative and non-integer usage" do
+    override = @account.build_overridden_limits(card_count: -1, bytes_used: -1)
+    assert_not override.valid?
+    assert override.errors[:card_count].any?
+    assert override.errors[:bytes_used].any?
+
+    override.assign_attributes(card_count: "1.5", bytes_used: "not a number")
+    assert_not override.valid?
+  end
+
+  test "a smaller legacy storage exception cannot reduce the paid allowance" do
+    @account.add_storage_exception(2.gigabytes)
+    @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.add_storage_exception(10.gigabytes)
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+end
