@@ -0,0 +1,20 @@
+class Account::Subscriptions::CheckoutsController < Account::SubscriptionsController
+  def create
+    plan = Plan.find(params[:plan_key])
+
+    if !plan&.paid?
+      head :unprocessable_entity
+    elsif @account.comped? || @account.subscription&.current?
+      head :conflict
+    else
+      raise Plan::Unavailable if plan.stripe_price_id.blank?
+
+      subscription = @account.subscription_for_billing
+      redirect_to subscription.checkout_url(plan: plan,
+        success_url: saas.account_subscription_url(checkout: "success"),
+        cancel_url: saas.account_subscription_url), allow_other_host: true, status: :see_other
+    end
+  rescue Account::Subscription::AlreadySubscribed
+    head :conflict
+  end
+end
