@@ -0,0 +1,19 @@
+module Card::CountLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_card_limit
+      # Serialize the check and publication so concurrent requests cannot both
+      # spend the last free card. HTML draft creation never enters this guard.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit?
+          respond_to do |format|
+            format.html { head :forbidden }
+            format.json { render json: { error: "Card limit reached. Upgrade to publish more cards." }, status: :forbidden }
+          end
+        else
+          yield
+        end
+      end
+    end
+end
