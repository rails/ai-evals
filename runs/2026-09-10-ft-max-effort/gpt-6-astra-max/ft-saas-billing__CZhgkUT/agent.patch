+class Plan
+  class Unavailable < StandardError; end
+
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price_in_cents:, storage_limit:, card_limit: nil, stripe_price_variable: nil)
+    @key, @name, @price_in_cents = key, name, price_in_cents
+    @card_limit, @storage_limit = card_limit, storage_limit
+    @stripe_price_variable = stripe_price_variable
+    freeze
+  end
+
+  FREE = new(key: "free_v1", name: "Free", price_in_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte)
+  UNLIMITED = new(key: "monthly_v1", name: "Unlimited", price_in_cents: 2_000, storage_limit: 5.gigabytes,
+    stripe_price_variable: "STRIPE_MONTHLY_V1_PRICE_ID")
+  UNLIMITED_PLUS = new(key: "monthly_extra_storage_v1", name: "Unlimited+", price_in_cents: 2_500, storage_limit: 500.gigabytes,
+    stripe_price_variable: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  class << self
+    def find(key)
+      ALL.find { |plan| plan.key == key }
+    end
+
+    def paid
+      ALL.select(&:paid?)
+    end
+
+    def find_by_stripe_price_id(price_id)
+      paid.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+    end
+  end
+
+  def paid?
+    price_in_cents.positive?
+  end
+
+  def stripe_price_id
+    ENV[@stripe_price_variable] if @stripe_price_variable
+  end
+
+  def queenbee_name
+    key.camelize
+  end
+end
