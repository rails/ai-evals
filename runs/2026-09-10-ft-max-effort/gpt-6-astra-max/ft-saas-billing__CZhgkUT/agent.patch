@@ -0,0 +1,47 @@
+<% @page_title = "Plans & Billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <p>Your plan: <strong><%= @account.billing_plan.name %></strong><%= " (comped)" if @account.comped? && !@account.active_subscription %></p>
+    <p><%= number_with_delimiter(@account.card_count) %> published cards · <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %> storage used.</p>
+
+    <% if params[:checkout] == "success" %>
+      <p role="status">Thanks! Your plan will update once Stripe confirms your subscription. If it hasn’t updated yet, refresh this page in a moment.</p>
+    <% end %>
+
+    <% if @account.comped? && @account.subscription&.current? %>
+      <p>Complimentary access is enabled. Your existing Stripe subscription continues until you cancel it in Manage billing.</p>
+    <% end %>
+
+    <% if @account.subscription %>
+      <%= button_to "Manage billing", saas.account_subscription_portal_path, class: "btn", data: { turbo: false } %>
+      <% if @account.subscription.current? && !@account.subscription.active? %>
+        <p>Please check your subscription’s payment status in Stripe to restore your paid plan.</p>
+      <% end %>
+      <% if @account.subscription.active? && @account.subscription.cancel_at %>
+        <p>Your paid plan ends on <%= @account.subscription.cancel_at.to_date.to_fs(:long) %>.</p>
+      <% end %>
+    <% end %>
+  </div>
+
+  <% Plan::ALL.each do |plan| %>
+    <div class="settings__panel panel shadow">
+      <h2><%= plan.name %></h2>
+      <p><strong><%= plan.paid? ? "#{number_to_currency(plan.price_in_cents / 100, precision: 0)}/month" : "Free" %></strong></p>
+      <p><%= plan.card_limit ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards" %> · <%= number_to_human_size(plan.storage_limit) %> storage</p>
+      <% if plan == @account.billing_plan %>
+        <p>Current plan</p>
+      <% elsif plan.paid? && !@account.comped? && !@account.subscription&.current? %>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_subscription_checkout_path, params: { plan_key: plan.key }, class: "btn btn--reversed", data: { turbo: false } %>
+      <% elsif plan.paid? && @account.subscription&.current? %>
+        <div>Change plans in <%= button_to "Manage billing", saas.account_subscription_portal_path, class: "btn btn--link", data: { turbo: false } %></div>
+      <% end %>
+    </div>
+  <% end %>
+
+  <p><%= link_to "Back to account settings", main_app.account_settings_path %></p>
+</section>
