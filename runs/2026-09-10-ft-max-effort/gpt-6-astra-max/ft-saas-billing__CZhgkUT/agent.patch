diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..9f65903
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,20 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    if secret = ENV["STRIPE_WEBHOOK_SECRET"].presence
+      event = ::Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], secret)
+      ::Account::Subscription.process(event)
+      head :ok
+    else
+      head :service_unavailable
+    end
+  rescue JSON::ParserError, ::Stripe::SignatureVerificationError, ::Account::Subscription::InvalidEvent
+    head :bad_request
+  rescue ::Account::Subscription::UnknownPrice
+    # Keep the event retryable: a missing/misconfigured price must not silently
+    # grant the wrong plan or acknowledge a subscription change we cannot apply.
+    Rails.logger.warn "Stripe event #{event.id} has an unrecognized subscription price"
+    head :unprocessable_entity
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..224d4bd
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,95 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+
+    set_callback :cancel, :before, -> { subscription&.cancel }
+    set_callback :reactivate, :before, -> { subscription&.resume }
+  end
+
+  def billing_plan
+    if active_subscription
+      subscription.plan
+    elsif comped?
+      Plan::UNLIMITED
+    else
+      Plan::FREE
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def billing_cache_key
+    [ billing_plan.key, comped?, cards_remaining, storage_limit, bytes_used ]
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def card_count
+    # cards_count is a numbering sequence. Drafting or deleting a card must not
+    # spend the free plan's published-card allowance.
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def cards_remaining
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    cards_remaining&.between?(1, NEAR_CARD_LIMIT_THRESHOLD) || false
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    self.billing_waiver = Account::BillingWaiver.create_or_find_by!(account: self) unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def override_limits(attributes)
+    (overridden_limits || build_overridden_limits).update!(attributes)
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy!
+    reload_overridden_limits
+  end
+
+  def subscription_for_billing
+    with_lock do
+      subscription || create_subscription!(stripe_customer_id: create_stripe_customer.id)
+    end
+  end
+
+  private
+    def create_stripe_customer
+      ::Stripe::Customer.create({
+        name: name,
+        email: owner_email,
+        metadata: { account_id: id }
+      }, { idempotency_key: "fizzy-account-#{id}" })
+    end
+end
