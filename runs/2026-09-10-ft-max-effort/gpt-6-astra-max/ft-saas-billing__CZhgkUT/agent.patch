+module StripeTestHelper
+  extend ActiveSupport::Concern
+
+  STRIPE_ENV = {
+    "STRIPE_MONTHLY_V1_PRICE_ID" => "price_monthly_offline",
+    "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_storage_offline",
+    "STRIPE_WEBHOOK_SECRET" => "whsec_offline_test"
+  }.freeze
+
+  included do
+    setup do
+      @original_stripe_env = STRIPE_ENV.keys.index_with { |key| ENV[key] }
+      STRIPE_ENV.each { |key, value| ENV[key] = value }
+      @original_stripe_key = ::Stripe.api_key
+      ::Stripe.api_key = "sk_test_offline"
+      @original_net_connect = WebMock::Config.instance.allow_net_connect
+      WebMock.disable_net_connect!
+    end
+
+    teardown do
+      @original_stripe_env.each { |key, value| ENV[key] = value }
+      ::Stripe.api_key = @original_stripe_key
+      WebMock::Config.instance.allow_net_connect = @original_net_connect
+    end
+  end
+
+  private
+    def subscription_event(id: "evt_#{SecureRandom.hex(8)}", type: "customer.subscription.created",
+      customer: "cus_offline", subscription_id: "sub_offline", created: Time.current.to_i,
+      price: ENV["STRIPE_MONTHLY_V1_PRICE_ID"], status: "active", **attributes)
+      {
+        id: id, object: "event", type: type, created: created,
+        data: {
+          object: {
+            id: subscription_id, object: "subscription", customer: customer, status: status,
+            created: 1.day.ago.to_i, cancel_at: nil, cancel_at_period_end: false,
+            items: { object: "list", data: [ {
+              id: "si_offline", object: "subscription_item", quantity: 1,
+              current_period_end: 1.month.from_now.to_i,
+              price: { id: price, object: "price", currency: "usd", recurring: { interval: "month" } }
+            } ] }
+          }.merge(attributes)
+        }
+      }
+    end
+
+    def post_stripe_event(event, timestamp: Time.current)
+      payload = event.is_a?(String) ? event : event.to_json
+      signature = ::Stripe::Webhook::Signature.compute_signature(timestamp, payload, ENV["STRIPE_WEBHOOK_SECRET"])
+      header = ::Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      untenanted do
+        post saas.stripe_webhooks_path, params: payload,
+          headers: { "Content-Type" => "application/json", "Stripe-Signature" => header }
+      end
+    end
+end
