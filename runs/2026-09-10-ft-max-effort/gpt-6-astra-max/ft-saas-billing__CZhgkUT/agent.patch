+class Account::Subscription < SaasRecord
+  class InvalidEvent < StandardError; end
+  class UnknownPrice < StandardError; end
+  class AlreadySubscribed < StandardError; end
+
+  EVENT_TYPES = %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ].freeze
+  STATUSES = %w[ incomplete incomplete_expired trialing active past_due canceled unpaid paused ].freeze
+  TERMINAL_STATUSES = %w[ canceled incomplete_expired ].freeze
+
+  belongs_to :account
+  has_many :events, class_name: "Account::Subscription::Event", dependent: :delete_all
+
+  before_destroy :cancel_now
+
+  validates :stripe_customer_id, presence: true
+  validates :plan_key, :stripe_checkout_plan_key, inclusion: { in: Plan.paid.map(&:key) }, allow_nil: true
+  validates :status, inclusion: { in: STATUSES }, allow_nil: true
+
+  def self.process(event)
+    unless event.is_a?(::Stripe::Event) && event[:id].is_a?(String) && event[:id].present? && event[:type].is_a?(String) && event[:created].is_a?(Integer)
+      raise InvalidEvent
+    end
+
+    if event.type.in?(EVENT_TYPES)
+      object = event[:data][:object] if event[:data].is_a?(::Stripe::StripeObject)
+      unless object.is_a?(::Stripe::StripeObject) && object[:id].is_a?(String) && object[:id].present? && object[:customer].is_a?(String) && object[:status].in?(STATUSES)
+        raise InvalidEvent
+      end
+
+      find_by(stripe_customer_id: object.customer)&.apply(event)
+    end
+  end
+
+  def plan
+    Plan.find(plan_key) || Plan::FREE
+  end
+
+  def active?
+    status.in?(%w[ active trialing ])
+  end
+
+  def current?
+    stripe_subscription_id.present? && !status.in?(TERMINAL_STATUSES)
+  end
+
+  def checkout_url(plan:, success_url:, cancel_url:)
+    raise Plan::Unavailable unless plan.paid? && plan.stripe_price_id.present?
+
+    with_lock do
+      raise AlreadySubscribed if current?
+      checkout = pending_checkout
+
+      if checkout&.status == "complete"
+        # Wait for the subscription webhook rather than charging again.
+        raise AlreadySubscribed
+      elsif checkout&.status == "open" && stripe_checkout_plan_key == plan.key
+        checkout.url
+      else
+        expire_checkout(checkout)
+        create_checkout(plan: plan, success_url: success_url, cancel_url: cancel_url).url
+      end
+    end
+  end
+
+  def portal_url(return_url:)
+    ::Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def cancel
+    change_renewal(cancel_at_period_end: true)
+  end
+
+  def resume
+    change_renewal(cancel_at_period_end: false)
+  end
+
+  def apply(event)
+    with_lock do
+      unless events.exists?(stripe_event_id: event.id)
+        update_from_event(event) unless stale_event?(event)
+        events.create!(stripe_event_id: event.id)
+      end
+    end
+  end
+
+  private
+    def pending_checkout
+      ::Stripe::Checkout::Session.retrieve(stripe_checkout_session_id) if stripe_checkout_session_id
+    end
+
+    def expire_checkout(checkout)
+      ::Stripe::Checkout::Session.expire(checkout.id) if checkout&.status == "open"
+    end
+
+    def create_checkout(plan:, success_url:, cancel_url:)
+      idempotency_key = [ "fizzy-checkout", id, stripe_subscription_id, stripe_checkout_session_id, plan.key ].compact.join("-")
+      checkout = ::Stripe::Checkout::Session.create({
+        mode: "subscription",
+        customer: stripe_customer_id,
+        client_reference_id: account_id,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        subscription_data: { metadata: { account_id: account_id } },
+        success_url: success_url,
+        cancel_url: cancel_url
+      }, { idempotency_key: idempotency_key })
+
+      update!(stripe_checkout_session_id: checkout.id, stripe_checkout_plan_key: plan.key)
+      checkout
+    end
+
+    def change_renewal(cancel_at_period_end:)
+      if current?
+        ::Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: cancel_at_period_end)
+      elsif checkout = pending_checkout
+        if checkout.status == "complete"
+          ::Stripe::Subscription.update(checkout.subscription, cancel_at_period_end: cancel_at_period_end)
+        elsif cancel_at_period_end
+          expire_checkout(checkout)
+        end
+      end
+    end
+
+    def cancel_now
+      if current?
+        ::Stripe::Subscription.cancel(stripe_subscription_id)
+      elsif checkout = pending_checkout
+        if checkout.status == "complete"
+          ::Stripe::Subscription.cancel(checkout.subscription)
+        else
+          expire_checkout(checkout)
+        end
+      end
+    end
+
+    def stale_event?(event)
+      object = event.data.object
+
+      if last_stripe_event_created_at && event.created < last_stripe_event_created_at.to_i
+        true
+      elsif stripe_subscription_id == object.id
+        (last_stripe_event_created_at.present? && event.type == "customer.subscription.created") ||
+          (status.in?(TERMINAL_STATUSES) && event.type != "customer.subscription.deleted")
+      elsif stripe_subscription_id.present?
+        event.type == "customer.subscription.deleted" ||
+          (stripe_subscription_created_at && object["created"].to_i < stripe_subscription_created_at.to_i)
+      else
+        false
+      end
+    end
+
+    def update_from_event(event)
+      object = event.data.object
+      item = object["items"]&.[]("data")&.first
+      deleted = event.type == "customer.subscription.deleted"
+      plan = Plan.find_by_stripe_price_id(item&.[]("price")&.[]("id")) unless deleted
+      raise UnknownPrice if !deleted && !plan
+
+      period_end = timestamp(object["current_period_end"] || item&.[]("current_period_end"))
+
+      update!(
+        stripe_subscription_id: object.id,
+        stripe_checkout_session_id: nil,
+        stripe_checkout_plan_key: nil,
+        stripe_subscription_created_at: timestamp(object["created"]),
+        plan_key: deleted ? plan_key : plan.key,
+        status: deleted ? "canceled" : object.status,
+        current_period_end: period_end,
+        cancel_at: timestamp(object["cancel_at"]) || (period_end if object["cancel_at_period_end"]),
+        last_stripe_event_created_at: timestamp(event.created)
+      )
+    end
+
+    def timestamp(value)
+      raise InvalidEvent if value && !value.is_a?(Integer)
+      Time.at(value).utc if value
+    end
+end
