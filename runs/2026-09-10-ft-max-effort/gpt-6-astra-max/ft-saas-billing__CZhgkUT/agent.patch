diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..2b932d7
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+require_relative "../../support/stripe_test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_offline")
+  end
+
+  test "changing plans expires the old checkout before opening another" do
+    @subscription.update!(stripe_checkout_session_id: "cs_pending", stripe_checkout_plan_key: "monthly_v1")
+    ::Stripe::Checkout::Session.expects(:retrieve).with("cs_pending")
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_pending", status: "open"))
+
+    checkout_sequence = sequence("change checkout plan")
+    ::Stripe::Checkout::Session.expects(:expire).with("cs_pending").in_sequence(checkout_sequence)
+    ::Stripe::Checkout::Session.expects(:create).with({
+      mode: "subscription", customer: "cus_offline", client_reference_id: @account.id,
+      line_items: [ { price: Plan::UNLIMITED_PLUS.stripe_price_id, quantity: 1 } ],
+      subscription_data: { metadata: { account_id: @account.id } }, success_url: "https://example.com/success", cancel_url: "https://example.com/cancel"
+    }, { idempotency_key: "fizzy-checkout-#{@subscription.id}-cs_pending-monthly_extra_storage_v1" }).in_sequence(checkout_sequence)
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_plus", url: "https://checkout.stripe.com/plus"))
+
+    assert_equal "https://checkout.stripe.com/plus", @subscription.checkout_url(plan: Plan::UNLIMITED_PLUS,
+      success_url: "https://example.com/success", cancel_url: "https://example.com/cancel")
+    assert_equal "cs_plus", @subscription.reload.stripe_checkout_session_id
+    assert_equal "monthly_extra_storage_v1", @subscription.stripe_checkout_plan_key
+  end
+
+  test "completed checkout waits for its webhook instead of charging again" do
+    @subscription.update!(stripe_checkout_session_id: "cs_pending", stripe_checkout_plan_key: "monthly_v1")
+    ::Stripe::Checkout::Session.expects(:retrieve).with("cs_pending")
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_pending", status: "complete"))
+
+    assert_raises(Account::Subscription::AlreadySubscribed) do
+      @subscription.checkout_url(plan: Plan::UNLIMITED_PLUS, success_url: "https://example.com", cancel_url: "https://example.com")
+    end
+    assert_equal "Free", @account.billing_plan.name
+  end
+
+  test "account cancellation stops renewals and reactivation resumes them" do
+    activate_subscription
+    ::Stripe::Subscription.expects(:update).with("sub_offline", cancel_at_period_end: true)
+    @account.cancel(initiated_by: users(:jason))
+    assert @account.cancelled?
+
+    ::Stripe::Subscription.expects(:update).with("sub_offline", cancel_at_period_end: false)
+    @account.reactivate
+    assert_not @account.reload.cancelled?
+  end
+
+  test "billing failure prevents account cancellation so it can be retried" do
+    activate_subscription
+    ::Stripe::Subscription.expects(:update).raises(::Stripe::APIConnectionError.new("Offline"))
+
+    assert_raises(::Stripe::APIConnectionError) { @account.cancel(initiated_by: users(:jason)) }
+    assert_not @account.reload.cancelled?
+  end
+
+  test "account cancellation expires an open checkout" do
+    @subscription.update!(stripe_checkout_session_id: "cs_pending", stripe_checkout_plan_key: "monthly_v1")
+    ::Stripe::Checkout::Session.expects(:retrieve).with("cs_pending")
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_pending", status: "open"))
+    ::Stripe::Checkout::Session.expects(:expire).with("cs_pending")
+
+    @account.cancel(initiated_by: users(:jason))
+    assert @account.cancelled?
+  end
+
+  test "account cancellation also handles checkout completed before its webhook" do
+    @subscription.update!(stripe_checkout_session_id: "cs_pending", stripe_checkout_plan_key: "monthly_v1")
+    ::Stripe::Checkout::Session.expects(:retrieve).with("cs_pending")
+      .returns(::Stripe::Checkout::Session.construct_from(id: "cs_pending", status: "complete", subscription: "sub_offline"))
+    ::Stripe::Subscription.expects(:update).with("sub_offline", cancel_at_period_end: true)
+
+    @account.cancel(initiated_by: users(:jason))
+    assert @account.cancelled?
+  end
+
+  test "destroying subscription records cancels any remaining active subscription" do
+    activate_subscription
+    ::Stripe::Subscription.expects(:cancel).with("sub_offline")
+    @subscription.destroy!
+    assert @subscription.destroyed?
+  end
+
+  test "canceled subscriptions are not canceled again during deletion" do
+    @subscription.update!(stripe_subscription_id: "sub_offline", status: "canceled", plan_key: "monthly_v1")
+    @subscription.destroy!
+    assert @subscription.destroyed?
+  end
+
+  private
+    def activate_subscription
+      @subscription.update!(stripe_subscription_id: "sub_offline", status: "active", plan_key: "monthly_v1")
+    end
+end
