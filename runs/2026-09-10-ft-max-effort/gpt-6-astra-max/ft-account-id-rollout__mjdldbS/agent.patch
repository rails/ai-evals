+require "test_helper"
+
+class AccountOwnershipTest < ActiveSupport::TestCase
+  GLOBAL_TABLES = %w[
+    accounts account_external_id_sequences identities identity_access_tokens magic_links sessions
+    action_pack_passkeys action_push_native_devices ar_internal_metadata schema_migrations
+  ].freeze
+
+  test "every tenant table has a required indexed UUID account_id" do
+    connection = ActiveRecord::Base.connection
+    tenant_tables = connection.tables - GLOBAL_TABLES
+    tenant_tables.reject! { |table| table.start_with?("search_records_fts", "console1984_", "audits1984_") }
+
+    tenant_tables.each do |table|
+      column = connection.columns(table).find { |column| column.name == "account_id" }
+      assert column, "#{table} has no account_id"
+      assert_equal :uuid, column.type, table
+      assert_not column.null, "#{table}.account_id allows NULL"
+      assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table} has no account index"
+    end
+
+    GLOBAL_TABLES.each do |table|
+      assert_not connection.column_exists?(table, :account_id), table if connection.table_exists?(table)
+    end
+  end
+
+  test "dependent records inherit their owner's account rather than the current account" do
+    card, board, user = cards(:logo), boards(:writebook), users(:david)
+    records = [
+      Access.new(board: board, user: user),
+      Assignment.new(card: card, assignee: user, assigner: user),
+      Board::Publication.new(board: board),
+      Card::ActivitySpike.new(card: card), Card::Goldness.new(card: card), Card::NotNow.new(card: card),
+      Closure.new(card: card), Pin.new(card: card, user: user), Watch.new(card: card, user: user),
+      Tagging.new(card: card, tag: tags(:web)),
+      Mention.new(source: card, mentioner: user, mentionee: users(:kevin)),
+      Reaction.new(reactable: comments(:logo_agreement_jz), reacter: user, content: "👍"),
+      User::Settings.new(user: user), Search::Query.new(user: user, terms: "a remembered search"),
+      Webhook::DelinquencyTracker.new(webhook: webhooks(:active)),
+      Webhook::Delivery.new(webhook: webhooks(:active), event: events(:logo_published)),
+      Entropy.new(container: board), Entropy.new(container: board.account),
+      Storage::Total.new(owner: board), Storage::Total.new(owner: board.account)
+    ]
+
+    Current.set(account: accounts(:initech)) do
+      records.each do |record|
+        assert record.valid?, "#{record.class}: #{record.errors.full_messages.join(', ')}"
+        assert_equal board.account, record.account, record.class.name
+      end
+    end
+  end
+
+  test "bulk access grants include the owning account" do
+    Current.without_account do
+      user = accounts(:"37s").users.create!(name: "New member")
+      assert user.accesses.exists?
+      assert_equal [ user.account_id ], user.accesses.distinct.pluck(:account_id)
+
+      boards(:private).accesses.grant_to(user)
+      assert_equal user.account_id, boards(:private).access_for(user).account_id
+    end
+  end
+
+  test "all filter join records get an account and are deleted with the filter" do
+    Current.set(account: accounts(:initech)) do
+      filter = users(:david).filters.create!(
+        tag_ids: [ tags(:web).id ], board_ids: [ boards(:writebook).id ],
+        assignee_ids: [ users(:kevin).id ], creator_ids: [ users(:david).id ], closer_ids: [ users(:jz).id ]
+      )
+      joins = %i[tag_resources board_resources assignee_resources creator_resources closer_resources].map { |name| filter.public_send(name) }
+
+      joins.each { |rows| assert_equal [ filter.account_id ], rows.pluck(:account_id) }
+      assert_includes tags(:web).filters, filter
+      assert_includes boards(:writebook).filters, filter
+
+      filter.destroy!
+      joins.each { |rows| assert_empty rows.reload }
+    end
+  end
+
+  test "rich text and file attachments inherit ownership without a current account" do
+    Current.without_account do
+      card = cards(:logo)
+      card.update!(description: "Tenant-owned text")
+      assert_equal card.account, card.rich_text_description.account
+
+      card.image.attach(io: StringIO.new("a file"), filename: "file.txt", content_type: "text/plain")
+      assert_equal card.account, card.image.attachment.account
+      assert_equal card.account, card.image.blob.account
+    end
+  end
+
+  test "variants and their image blobs inherit the original blob's account" do
+    user = users(:david)
+    Current.set(account: accounts(:initech)) do
+      File.open(file_fixture("avatar.png")) do |file|
+        user.avatar.attach(io: file, filename: "avatar.png", content_type: "image/png")
+      end
+      assert_equal user.account, user.avatar.blob.account
+      assert_equal user.account, user.avatar.attachment.account
+    end
+
+    Current.without_account do
+      user.avatar.blob.variant(resize_to_limit: [ 32, 32 ]).processed
+      user.avatar.blob.variant_records.each do |variant|
+        assert_equal user.account, variant.account
+        assert_equal user.account, variant.image.attachment.account
+        assert_equal user.account, variant.image.blob.account
+      end
+    end
+  end
+
+  test "direct upload blobs take the request account" do
+    blob = ActiveStorage::Blob.create_before_direct_upload!(filename: "file.txt", byte_size: 4, checksum: "checksum", content_type: "text/plain")
+    assert_equal Current.account, blob.account
+  end
+end
