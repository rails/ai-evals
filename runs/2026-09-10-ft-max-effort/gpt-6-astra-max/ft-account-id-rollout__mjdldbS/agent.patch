+    watches: [ :cards, :card_id ],
+    search_queries: [ :users, :user_id ],
+    user_settings: [ :users, :user_id ],
+    webhook_delinquency_trackers: [ :webhooks, :webhook_id ],
+    webhook_deliveries: [ :webhooks, :webhook_id ],
+    assignees_filters: [ :filters, :filter_id ],
+    assigners_filters: [ :filters, :filter_id ],
+    boards_filters: [ :filters, :filter_id ],
+    closers_filters: [ :filters, :filter_id ],
