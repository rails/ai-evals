diff --git a/config/initializers/tenanting/active_storage.rb b/config/initializers/tenanting/active_storage.rb
new file mode 100644
index 0000000..69dfeeb
--- /dev/null
+++ b/config/initializers/tenanting/active_storage.rb
@@ -0,0 +1,28 @@
+# Direct uploads get their account from the request. Derived files must instead
+# inherit the source record's account, including in jobs without Current.account.
+module ActiveStorageBlobAccount
+  def build_after_unfurling(record: nil, **attributes)
+    super.tap do |blob|
+      owner = case record
+      when ActiveStorage::VariantRecord then record.blob
+      when ActionText::RichText then record.record
+      else record
+      end
+
+      blob.account = owner.try(:account) || Current.account
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+  singleton_class.prepend ActiveStorageBlobAccount
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.account }
+end
