diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..2236302
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,63 @@
+# Single-server deployment. See docs/deployment.md for setup and backups.
+service: fizzy
+image: your-dockerhub-user/fizzy
+
+# Point this hostname at your server. The proxy and Rails use it too.
+servers:
+  web:
+    - &app_host fizzy.example.com
+
+# Kamal terminates HTTPS; the image's Thruster server listens on port 80.
+proxy:
+  ssl: true
+  host: *app_host
+  app_port: 80
+  healthcheck:
+    path: /up
+
+registry:
+  username: your-dockerhub-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+# Secrets are read from .kamal/secrets, not baked into the image.
+env:
+  clear:
+    SAAS: "false"
+    APP_FQDN: *app_host
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Web requests, background jobs, and recurring tasks share this container.
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+
+    MAILER_FROM_ADDRESS: "Fizzy <notifications@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Optional browser push notifications (see docs/deployment.md):
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+# All four SQLite databases and uploaded files live here. Keep the volume name
+# unchanged across deploys, and back it up separately from the application image.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
