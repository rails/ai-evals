@@ -0,0 +1,23 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "email digests default to off" do
+    settings = User::Settings.new
+
+    assert_equal "never", settings.bundle_email_frequency
+    assert_nil settings.bundle_email_interval
+  end
+
+  test "email frequency supports only the four documented choices" do
+    settings = users(:david).settings
+
+    %w[ never every_few_hours daily weekly ].each do |frequency|
+      assert settings.update(bundle_email_frequency: frequency)
+      assert_equal frequency, settings.reload.bundle_email_frequency
+    end
+
+    assert_not settings.update(bundle_email_frequency: "hourly")
+    assert_not settings.update(bundle_email_frequency: nil)
+    assert_not settings.update(bundle_email_frequency: "")
+  end
+end
