diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..f0da32e
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  self.use_transactional_tests = false
+
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @creator_id = users(:jz).id
+    @account = @user.account
+    travel_to Time.utc(2026, 9, 10, 9, 17, 23)
+  end
+
+  teardown do
+    @user.reload
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: "never")
+  end
+
+  test "simultaneous first arrivals create only one window" do
+    event_ids = %i[ logo_published layout_published buy_domain_sent_back_to_triage ].map { events(it).id }
+    times = [ Time.current, 1.minute.ago, 1.minute.from_now ]
+
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+      bundle_ids = concurrently(3) do |index|
+        notify(event_ids[index], at: times[index]).bundle_id
+      end
+
+      assert_equal 1, bundle_ids.uniq.size
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 3, @user.notification_bundles.reload.first.notifications.count
+  end
+
+  test "concurrent deliveries send one email" do
+    bundle = notify(events(:logo_published).id).bundle
+    travel_to bundle.ends_at
+
+    assert_emails 1 do
+      concurrently(3) { Notification::Bundle.find(bundle.id).deliver }
+    end
+
+    assert_not_nil bundle.reload.sent_at
+  end
+
+  test "delivery racing a late arrival never opens overlapping windows" do
+    bundle = notify(events(:logo_published).id).bundle
+    event_id = events(:layout_published).id
+    late_at = bundle.starts_at - 1.hour
+    travel_to bundle.ends_at
+
+    assert_emails 1 do
+      concurrently(2) do |index|
+        if index.zero?
+          Notification::Bundle.find(bundle.id).deliver
+        else
+          notify(event_id, at: late_at)
+        end
+      end
+    end
+
+    windows = @user.notification_bundles.order(:starts_at).to_a
+    windows.each_cons(2) { |first, second| assert_operator first.ends_at, :<=, second.starts_at }
+    assert_equal 2, @user.notifications.where.not(bundle_id: nil).count
+  end
+
+  private
+    def notify(event_id, at: Time.current)
+      User.find(@user.id).notifications.create!(source: Event.find(event_id), creator_id: @creator_id,
+        created_at: at, updated_at: at)
+    end
+
+    def concurrently(count)
+      ready = Queue.new
+      start = Queue.new
+      threads = count.times.map do |index|
+        Thread.new do
+          Rails.application.executor.wrap do
+            ActiveRecord::Base.connection_pool.with_connection do
+              Current.with_account(@account) do
+                ready << true
+                start.pop
+                yield index
+              end
+            end
+          end
+        end
+      end
+
+      Timeout.timeout(10) do
+        count.times { ready.pop }
+        count.times { start << true }
+        threads.map(&:value)
+      end
+    ensure
+      threads&.each(&:kill)
+      threads&.each(&:join)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..708dd4a
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,165 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @user.notifications.destroy_all
+    travel_to Time.utc(2026, 9, 10, 9, 17, 23)
+    @notification = @user.notifications.create!(source: events(:logo_published), creator: users(:jz))
+    @bundle = @notification.bundle
+  end
+
+  test "delivery waits until the window ends" do
+    assert_no_emails do
+      @bundle.deliver
+    end
+
+    assert_nil @bundle.reload.sent_at
+  end
+
+  test "one email contains all unread notifications in the window" do
+    other = @user.notifications.create!(source: events(:layout_published), creator: users(:jz))
+    travel_to @bundle.ends_at
+
+    assert_emails 1 do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliverJob)
+    end
+
+    assert_equal Time.current, @bundle.reload.sent_at
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes Nokogiri::HTML(email.html_part.body.decoded).text, @notification.payload.title
+    assert_includes Nokogiri::HTML(email.html_part.body.decoded).text, other.payload.title
+    assert_includes email.text_part.body.decoded, @notification.payload.url
+    assert_includes email.text_part.body.decoded, other.payload.url
+  end
+
+  test "repeated delivery of the same bundle does not send twice" do
+    other_instance = Notification::Bundle.find(@bundle.id)
+    travel_to @bundle.ends_at
+
+    assert_emails 1 do
+      @bundle.deliver
+      other_instance.deliver
+    end
+  end
+
+  test "read notifications are omitted from the email" do
+    other = @user.notifications.create!(source: events(:layout_published), creator: users(:jz))
+    other.read
+    travel_to @bundle.ends_at
+    @bundle.deliver
+
+    email = ActionMailer::Base.deliveries.last
+    assert_includes email.text_part.body.decoded, @notification.payload.title
+    assert_not_includes email.text_part.body.decoded, other.payload.title
+  end
+
+  test "an empty bundle is completed without sending an email" do
+    @notification.destroy!
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.sent_at
+  end
+
+  test "a fully read bundle is completed without sending an email" do
+    @notification.read
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.sent_at
+  end
+
+  test "turning email off suppresses an already scheduled digest" do
+    @user.settings.update!(bundle_email_frequency: "never")
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.sent_at
+  end
+
+  test "inactive users do not receive scheduled digests" do
+    @user.deactivate
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.sent_at
+  end
+
+  test "cancelled accounts do not send scheduled digests" do
+    @user.account.cancel(initiated_by: @user)
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.sent_at
+  end
+
+  test "failed delivery can be retried" do
+    travel_to @bundle.ends_at
+    message = mock
+    message.expects(:deliver_now).raises(Net::ReadTimeout)
+    NotificationMailer.expects(:bundle).with(@bundle).returns(message)
+
+    assert_raises(Net::ReadTimeout) { @bundle.deliver }
+    assert_nil @bundle.reload.sent_at
+  end
+
+  test "late notifications never reopen or overlap a sent window" do
+    travel_to @bundle.ends_at
+    @bundle.deliver
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jz),
+      created_at: @bundle.starts_at - 1.hour, updated_at: @bundle.starts_at - 1.hour)
+
+    assert_not_equal @bundle, notification.bundle
+    assert_equal @bundle.ends_at, notification.bundle.starts_at
+    assert_equal @bundle.ends_at + 4.hours, notification.bundle.ends_at
+    assert_nil notification.bundle.sent_at
+  end
+
+  test "destroying a bundle preserves in-app notifications" do
+    @bundle.destroy!
+
+    assert_nil @notification.reload.bundle_id
+  end
+
+  test "destroying a user removes their bundles" do
+    assert_difference "Notification::Bundle.count", -1 do
+      @user.destroy!
+    end
+  end
+  test "delivery jobs retry temporary mail errors" do
+    travel_to @bundle.ends_at
+    message = mock
+    message.expects(:deliver_now).raises(Net::ReadTimeout)
+    NotificationMailer.expects(:bundle).with(@bundle).returns(message)
+
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, args: [ @bundle ]) do
+      Notification::Bundle::DeliverJob.perform_now(@bundle)
+    end
+
+    assert_nil @bundle.reload.sent_at
+  end
+
+  test "delivery jobs discard deleted bundles" do
+    @bundle.destroy!
+
+    assert_no_emails do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliverJob)
+    end
+  end
+
+  test "email links use the bundle's account rather than ambient account context" do
+    Current.with_account(accounts(:initech)) do
+      email = NotificationMailer.bundle(@bundle)
+      settings_url = Rails.application.routes.url_helpers.notifications_settings_url(host: "example.com", script_name: @bundle.account.slug)
+
+      assert_includes email.text_part.body.decoded, settings_url
+      assert_includes email.text_part.body.decoded, @notification.payload.url
+      assert_not_includes email.text_part.body.decoded, accounts(:initech).slug
+    end
+  end
+end
diff --git a/test/models/notification/bundling_test.rb b/test/models/notification/bundling_test.rb
new file mode 100644
index 0000000..70bc527
--- /dev/null
+++ b/test/models/notification/bundling_test.rb
@@ -0,0 +1,179 @@
+require "test_helper"
+
+class Notification::BundlingTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @user.notifications.destroy_all
+    @start = Time.utc(2026, 9, 10, 9, 17, 23)
+    travel_to @start
+  end
+
+  test "off does not create a bundle" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil notify(:logo_published).bundle
+    end
+  end
+
+  { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, duration|
+    test "#{frequency} starts its clock with the first notification" do
+      @user.settings.update!(bundle_email_frequency: frequency)
+      notification = notify(:logo_published)
+
+      assert_equal @start, notification.bundle.starts_at
+      assert_equal @start + duration, notification.bundle.ends_at
+      assert_equal @user, notification.bundle.user
+      assert_equal @user.account, notification.bundle.account
+    end
+  end
+
+  test "notifications in a window share one bundle and one scheduled delivery" do
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+      first = notify(:logo_published)
+      travel 2.hours
+      second = notify(:layout_published)
+
+      assert_equal first.bundle, second.bundle
+      assert_equal @start + 4.hours, first.bundle.ends_at
+      assert_equal [ first, second ].sort_by(&:id), first.bundle.notifications.sort_by(&:id)
+    end
+
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, at: @start + 4.hours)
+  end
+
+  test "late notifications join an existing window even when they predate its start" do
+    first = notify(:logo_published)
+    late = notify(:layout_published, at: @start - 2.hours)
+
+    assert_equal first.bundle, late.bundle
+    assert_equal @start, first.bundle.reload.starts_at
+    assert_equal @start + 4.hours, first.bundle.ends_at
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "a notification at the deadline opens an adjacent non-overlapping window" do
+    first = notify(:logo_published)
+    travel 4.hours
+    second = notify(:layout_published)
+
+    assert_not_equal first.bundle, second.bundle
+    assert_equal first.bundle.ends_at, second.bundle.starts_at
+    assert_equal @start + 8.hours, second.bundle.ends_at
+  end
+
+  test "changing frequency preserves an open window and applies to the next one" do
+    first = notify(:logo_published)
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    travel 1.hour
+    second = notify(:layout_published)
+
+    assert_equal first.bundle, second.bundle
+    assert_equal @start + 4.hours, second.bundle.ends_at
+
+    travel 3.hours
+    first.update!(source: events(:logo_assignment_david))
+
+    assert_equal @start + 4.hours, first.reload.bundle.starts_at
+    assert_equal @start + 4.hours + 1.week, first.bundle.ends_at
+    assert_equal second.bundle.ends_at, first.bundle.starts_at
+  end
+
+  test "each user has independent windows" do
+    other = users(:kevin)
+    other.settings.update!(bundle_email_frequency: "daily")
+    other.notifications.destroy_all
+    first = notify(:logo_published)
+    second = other.notifications.create!(source: events(:logo_published), creator: users(:jz))
+
+    assert_not_equal first.bundle, second.bundle
+    assert_equal @start + 4.hours, first.bundle.ends_at
+    assert_equal @start + 1.day, second.bundle.ends_at
+  end
+
+  test "reading and unreading do not open a new window" do
+    notification = notify(:logo_published)
+    travel 5.hours
+
+    assert_no_difference "Notification::Bundle.count" do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "a failed notification save rolls back the bundle and its scheduled job" do
+    assert_no_difference "Notification::Bundle.count" do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        Notification.transaction do
+          notify(:logo_published)
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "idle periods do not create empty windows" do
+    first = notify(:logo_published)
+    travel 3.days
+    second = notify(:layout_published)
+
+    assert_equal Time.current, second.bundle.starts_at
+    assert_equal Time.current + 4.hours, second.bundle.ends_at
+    assert_equal 2, @user.notification_bundles.count
+    assert_operator first.bundle.ends_at, :<, second.bundle.starts_at
+  end
+
+  test "late arrivals go into the earliest eligible unsent window" do
+    first = notify(:logo_published)
+    travel 4.hours
+    second = notify(:layout_published)
+    late = notify(:buy_domain_sent_back_to_triage, at: @start + 1.hour)
+
+    assert_equal first.bundle, late.bundle
+    assert_not_equal second.bundle, late.bundle
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "new activity in the same window retains its bundle" do
+    notification = notify(:logo_published)
+    bundle = notification.bundle
+    travel 1.hour
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        notification.update!(source: events(:logo_assignment_david))
+      end
+    end
+
+    assert_equal bundle, notification.reload.bundle
+  end
+
+  test "system notifications and inactive recipients are not bundled" do
+    assert_no_difference "Notification::Bundle.count" do
+      notification = @user.notifications.create!(source: events(:logo_published), creator: users(:system))
+      assert_nil notification.bundle
+
+      @user.deactivate
+      assert_nil notify(:layout_published).bundle
+    end
+  end
+
+  test "retrying the same notification source does not open another window" do
+    notification = notify(:logo_published)
+    bundle = notification.bundle
+    travel 5.hours
+
+    assert_no_difference "Notification::Bundle.count" do
+      notification.source_type_will_change!
+      notification.update!(source: notification.source, unread_count: notification.unread_count + 1)
+    end
+
+    assert_equal bundle, notification.reload.bundle
+  end
+
+  private
+    def notify(event, at: Time.current)
+      @user.notifications.create!(source: events(event), creator: users(:jz), created_at: at, updated_at: at)
+    end
+end
