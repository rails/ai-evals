--- /dev/null
+++ b/app/models/notification/bundling.rb
@@ -0,0 +1,20 @@
+module Notification::Bundling
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    before_create :assign_email_bundle
+    before_update :assign_email_bundle, if: :email_source_changed?
+  end
+
+  private
+    def email_source_changed?
+      # Notifier forces source_type dirty even on retries of the same activity.
+      source_id != source_id_in_database || source_type != source_type_in_database
+    end
+
+    def assign_email_bundle
+      self.bundle = Notification::Bundle.for(self, at: new_record? ? created_at : updated_at)
+    end
+end
