diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..9c750f1
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,57 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :pending, -> { where(sent_at: nil) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def for(notification, at: notification.created_at)
+      user = notification.user
+
+      # Lock before looking for a window, even when none exists yet. The lock is
+      # held through the notification's save so membership and creation are atomic.
+      user.with_lock do
+        if (interval = user.settings&.bundle_email_interval) && user.active? && user.identity && user.account.active? && !notification.creator.system?
+          # Delayed notifications may predate starts_at. They still belong to the
+          # first unsent window whose deadline hasn't passed their timestamp.
+          user.notification_bundles.pending.where("ends_at > ?", at).order(:ends_at).lock.first ||
+            create_for(user, at: at, interval: interval)
+        end
+      end
+    end
+
+    private
+      def create_for(user, at:, interval:)
+        # A late arrival must not reopen or overlap a window already sent.
+        last_window = user.notification_bundles.order(ends_at: :desc).lock.first
+        starts_at = [ at, last_window&.ends_at ].compact.max
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + interval)
+      end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+    end
+  end
+
+  def deliver
+    user.with_lock do
+      reload(lock: true)
+
+      if sent_at.nil? && ends_at <= Time.current
+        if user.settings&.bundle_email_interval && user.active? && user.identity && account.active? && notifications.unread.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update!(sent_at: Time.current)
+      end
+    end
+  end
+end
diff --git a/app/models/notification/bundling.rb b/app/models/notification/bundling.rb
