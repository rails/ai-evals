index 0000000..664e48e
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,454 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_triage)
+    sign_in_as(users(:david))
+  end
+
+  test "dropping a card moves it immediately into the column's order before saving" do
+    visit_board
+    expand_column(@column)
+    pause_card_saves
+    remember_card_element
+
+    drop_in(@column)
+
+    assert_card_in @column
+    assert_card_order @column, cards(:logo), @card, cards(:layout)
+    assert_nil @card.reload.column
+    assert_count "maybe", 0
+    assert_count @column, 3
+    assert_selector "#maybe .blank-slate--drag", text: "Drag cards here", wait: 0
+    assert_no_selector "#{column_selector(@column)} .blank-slate", wait: 0
+    assert_equal @column.color.to_s, find(card_selector(@card))[:style][/--card-color: ([^;]+);/, 1]
+    assert_no_drag_styles
+
+    finish_card_save
+
+    assert_equal @column, @card.reload.column
+    assert_card_order @column, cards(:logo), @card, cards(:layout)
+    assert_same_card_element
+    request = page.evaluate_script("window.cardSaveRequests[0]")
+    assert_equal "POST", request["method"]
+    assert_equal @column.id, JSON.parse(request["body"])["column_id"]
+    assert_includes request["headers"]["accept"], "application/json"
+    assert request["headers"]["x-turbo-request-id"].present?
+
+    page.refresh
+    wait_for_columns
+    assert_card_order @column, cards(:logo), @card, cards(:layout)
+  end
+
+  test "a golden card moves ahead of other golden cards" do
+    @card.gild
+    visit_board
+    pause_card_saves
+
+    drop_in(@column)
+
+    assert_card_order @column, @card, cards(:logo), cards(:layout)
+    finish_card_save
+    page.refresh
+    wait_for_columns
+    assert_card_order @column, @card, cards(:logo), cards(:layout)
+  end
+
+  test "an ordinary card follows an entirely golden destination" do
+    cards(:layout).gild
+    visit_board
+    original_order = column_card_ids(@column)
+    pause_card_saves
+
+    drop_in(@column)
+
+    assert_equal original_order + [ dom_id(@card, :article) ], column_card_ids(@column)
+    finish_card_save
+    page.refresh
+    wait_for_columns
+    assert_equal original_order + [ dom_id(@card, :article) ], column_card_ids(@column)
+  end
+
+  test "cards move between statuses and columns without waiting or prioritizing gold in inactive columns" do
+    Current.set(user: users(:david)) { cards(:logo).postpone }
+    cards(:shipping).gild
+    visit_board
+    pause_card_saves
+
+    drop_in("closed-cards")
+    assert_card_order "closed-cards", @card, cards(:shipping)
+    assert_no_selector "#{card_selector(@card)}.card--active", visible: :all, wait: 0
+    assert_not @card.reload.closed?
+    finish_card_save
+    assert @card.reload.closed?
+
+    drop_in("not-now")
+    assert_card_order "not-now", @card, cards(:logo)
+    assert_selector "#{card_selector(@card)}.card--postponed", visible: :all, wait: 0
+    assert @card.reload.closed?
+    finish_card_save
+    assert @card.reload.postponed?
+    assert_not @card.closed?
+
+    drop_in(@column)
+    assert_card_order @column, @card, cards(:layout)
+    assert_selector "#{card_selector(@card)}.card--active", visible: :all, wait: 0
+    assert_no_selector "#{card_selector(@card)}.card--postponed, #{card_selector(@card)} .card__closed", visible: :all, wait: 0
+    finish_card_save
+    assert @card.reload.active?
+    assert_equal @column, @card.column
+
+    drop_in("maybe")
+    assert_card_in "maybe"
+    assert_count @column, 1
+    assert_count "maybe", 1
+    assert_equal Column::Colored::DEFAULT_COLOR.to_s, find(card_selector(@card))[:style][/--card-color: ([^;]+);/, 1]
+    finish_card_save
+    assert @card.reload.awaiting_triage?
+    assert_equal [ "POST", "POST", "POST", "DELETE" ], page.evaluate_script("window.cardSaveRequests.map(request => request.method)")
+  end
+
+  test "dropping in the same column does not reorder or save" do
+    @card = cards(:layout)
+    visit_board
+    expand_column(@column)
+    original_order = column_card_ids(@column)
+    original_activity = @card.last_active_at
+    pause_card_saves
+
+    drop_in(@column)
+
+    assert_equal original_order, column_card_ids(@column)
+    assert_equal 0, page.evaluate_script("window.cardSaveRequests.length")
+    assert_equal original_activity, @card.reload.last_active_at
+    assert_no_drag_styles
+  end
+
+  test "hover styling survives crossing children and is cleared when a drag is canceled" do
+    visit_board
+    pause_card_saves
+    dispatch_drag("dragstart", card_selector(@card))
+    assert_selector "#{card_selector(@card)}.drag-and-drop__dragged-item"
+
+    dispatch_drag("dragover", "#{column_selector(@column)} .cards__header")
+    assert_selector "#{column_selector(@column)}.drag-and-drop__hover-container"
+    dispatch_drag("dragleave", "#{column_selector(@column)} .cards__header", related_target: "#{column_selector(@column)} .cards__expander")
+    assert_selector "#{column_selector(@column)}.drag-and-drop__hover-container"
+
+    dispatch_drag("dragover", "#closed-cards .cards__header")
+    assert_no_selector "#{column_selector(@column)}.drag-and-drop__hover-container"
+    assert_selector "#closed-cards.drag-and-drop__hover-container"
+
+    dispatch_drag("dragend", card_selector(@card))
+    assert_no_drag_styles
+    assert_card_in "maybe"
+    assert_equal 0, page.evaluate_script("window.cardSaveRequests.length")
+  end
+
+  test "external drags and drops outside a column do not move cards" do
+    visit_board
+    pause_card_saves
+
+    dispatch_drag("dragover", "#closed-cards")
+    dispatch_drag("drop", "#closed-cards")
+    assert_no_drag_styles
+    assert_card_in "maybe"
+
+    dispatch_drag("dragstart", card_selector(@card))
+    dispatch_drag("dragover", "#closed-cards")
+    dispatch_drag("drop", ".card-columns")
+    assert_no_drag_styles
+    assert_card_in "maybe"
+    assert_equal 0, page.evaluate_script("window.cardSaveRequests.length")
+  end
+
+  [ "http", "network" ].each do |failure|
+    test "a #{failure} failure restores the original card, order, and counts" do
+      visit_board
+      pause_card_saves
+      drop_in(@column)
+      assert_card_in @column
+
+      fail_card_save(failure)
+
+      assert_selector "[role=alert]", text: "Couldn't move this card"
+      assert_card_in "maybe"
+      assert_card_order @column, cards(:logo), cards(:layout)
+      assert_count @column, 2
+      assert_count "maybe", 1
+      assert_nil @card.reload.column
+      assert_no_drag_styles
+    end
+  end
+
+  test "successive drops are immediate while their saves run in order" do
+    visit_board
+    pause_card_saves
+    remember_card_element
+
+    drop_in(@column)
+    drop_in("closed-cards")
+    assert_card_in "closed-cards"
+    assert_equal 1, page.evaluate_script("window.cardSaveRequests.length")
+    assert_count @column, 2
+    assert_count "maybe", 0
+    assert_nil @card.reload.column
+
+    finish_card_save
+    assert_equal @column, @card.reload.column
+    assert_not @card.closed?
+    assert_card_in "closed-cards"
+
+    finish_card_save
+    assert @card.reload.closed?
+    assert_card_in "closed-cards"
+    assert_same_card_element
+  end
+
+  test "different cards save in drop order so that the server keeps the optimistic order" do
+    visit_board
+    pause_card_saves
+    first_card = @card
+    drop_in(@column)
+
+    @card = cards(:text)
+    drop_in(@column)
+    assert_card_order @column, cards(:logo), @card, first_card, cards(:layout)
+    assert_equal 1, page.evaluate_script("window.cardSaveRequests.length")
+
+    finish_card_save
+    finish_card_save
+    page.refresh
+    wait_for_columns
+    assert_card_order @column, cards(:logo), @card, first_card, cards(:layout)
+  end
+
+  test "loading another page after a drop does not duplicate the pagination boundary card" do
+    Current.set(user: users(:david)) do
+      18.times do |index|
+        @board.cards.create!(title: "Paginated card #{index}", column: @column, status: :published)
+      end
+    end
+    visit_board
+    assert_equal 15, column_card_ids(@column).size
+    pause_card_saves
+    drop_in(@column)
+    assert_equal 16, column_card_ids(@column).size
+    finish_card_save
+
+    expand_column(@column)
+    link = find("#{column_selector(@column)} [data-pagination-target=paginationLink]", visible: :all)
+    page.execute_script("arguments[0].scrollIntoView()", link)
+    assert_selector "#{column_selector(@column)} .cards__list .card", count: 21, visible: :all
+    assert_card_order @column, *@column.cards.active.latest.with_golden_first
+  end
+
+  test "a failed earlier save does not undo a newer drop" do
+    visit_board
+    pause_card_saves
+    drop_in(@column)
+    drop_in("closed-cards")
+
+    fail_card_save
+    assert_card_in "closed-cards"
+    assert_no_selector "[role=alert]", text: "Couldn't move this card"
+    finish_card_save
+    assert @card.reload.closed?
+    assert_card_in "closed-cards"
+  end
+
+  test "a failed later save restores the last successfully saved location" do
+    visit_board
+    pause_card_saves
+    drop_in(@column)
+    drop_in("closed-cards")
+    finish_card_save
+
+    fail_card_save
+
+    assert_selector "[role=alert]", text: "Couldn't move this card"
+    assert_card_in @column
+    assert_card_order @column, cards(:logo), @card, cards(:layout)
+    assert_count @column, 3
+    assert_count "maybe", 0
+    assert_count "closed-cards", 1
+    assert_equal @column, @card.reload.column
+  end
+
+  test "a stale destination frame cannot undo a drop even if it arrives after the save" do
+    visit_board
+    expand_column(@column)
+    pause_card_saves
+    remember_card_element
+    pause_column_reload(@column)
+
+    drop_in(@column)
+    assert_card_in @column
+    finish_card_save
+    finish_column_reload
+
+    assert_card_order @column, cards(:logo), @card, cards(:layout)
+    assert_card_in @column
+    assert_count @column, 3
+    assert_same_card_element
+  end
+
+  test "a stale source frame cannot duplicate a moved card" do
+    @card = cards(:layout)
+    visit_board
+    expand_column(@column)
+    pause_card_saves
+    pause_column_reload(@column)
+
+    drop_in("maybe")
+    finish_card_save
+    finish_column_reload
+
+    assert_card_in "maybe"
+    assert_card_order @column, cards(:logo)
+    assert_count @column, 1
+  end
+
+  private
+    def visit_board
+      visit board_url(@board)
+      wait_for_columns
+    end
+
+    def wait_for_columns
+      assert_no_selector ".card-columns turbo-frame[src]:not([complete])", visible: :all
+    end
+
+    def expand_column(column)
+      selector = column_selector(column)
+      find("#{selector} .cards__expander").click unless find(selector)[:class].include?("is-expanded")
+      assert_selector "#{selector}.is-expanded .cards__list"
+    end
+
+    def drop_in(column)
+      source_id = page.evaluate_script("document.querySelector(arguments[0]).closest('[data-drag-and-drop-target~=container]').id", card_selector(@card))
+      expand_column(source_id)
+      card = find(card_selector(@card))
+      destination = find("#{column_selector(column)} .cards__header")
+      # Start a native drag before moving to the destination (rather than simulating DragEvents).
+      page.driver.browser.action.move_to(card.native).pause(duration: 0.3).click_and_hold.pause(duration: 0.1)
+        .move_by(10, 0).pause(duration: 0.1).move_to(destination.native).pause(duration: 0.1).release.perform
+    end
+
+    def column_selector(column)
+      "##{column.is_a?(String) ? column : dom_id(column)}"
+    end
+
+    def card_selector(card)
+      "##{dom_id(card, :article)}"
+    end
+
+    def column_card_ids(column)
+      all("#{column_selector(column)} .cards__list .card", visible: :all).map { |card| card[:id] }
+    end
+
+    def assert_card_order(column, *cards)
+      assert_equal cards.map { |card| dom_id(card, :article) }, column_card_ids(column)
+    end
+
+    def assert_card_in(column)
+      assert_selector "#{column_selector(column)} #{card_selector(@card)}", visible: :all, wait: 0
+      assert_selector card_selector(@card), count: 1, visible: :all, wait: 0
+    end
+
+    def assert_count(column, count)
+      assert_equal count.to_s, find("#{column_selector(column)} .cards__expander-count", visible: :all).text(:all)
+    end
+
+    def assert_no_drag_styles
+      assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all, wait: 0
+    end
+
+    def remember_card_element
+      page.execute_script("window.movedCard = document.querySelector(arguments[0])", card_selector(@card))
+    end
+
+    def assert_same_card_element
+      assert page.evaluate_script("window.movedCard === document.querySelector(arguments[0])", card_selector(@card))
+    end
+
+    def dispatch_drag(type, target, related_target: nil)
+      page.execute_script <<~JS, type, target, related_target
+        const [type, target, relatedTarget] = arguments
+        window.dragTransfer ||= new DataTransfer()
+        document.querySelector(target).dispatchEvent(new DragEvent(type, {
+          bubbles: true, cancelable: true, dataTransfer: window.dragTransfer,
+          relatedTarget: relatedTarget && document.querySelector(relatedTarget)
+        }))
+      JS
+    end
+
+    # Hold the request, not just its response, to prove the drop does not wait for the server.
+    def pause_card_saves
+      page.execute_script <<~'JS'
+        const originalFetch = window.fetch
+        window.cardSaves = []
+        window.cardSaveRequests = []
+        window.fetch = (url, options = {}) => {
+          if (new URL(url, location.href).pathname.match(/\/cards\/\d+\/(triage|not_now|closure)$/) && ["POST", "DELETE"].includes(options.method)) {
+            window.cardSaveRequests.push({ url: String(url), method: options.method, body: options.body, headers: Object.fromEntries(options.headers) })
+            return new Promise((resolve, reject) => {
+              window.cardSaves.push({
+                resume: () => originalFetch(url, options).then(response => { resolve(response); return response.status }, reject),
+                fail: () => resolve(new Response(null, { status: 422 })),
+                reject: () => reject(new TypeError("Network error"))
+              })
+            })
+          } else {
+            return originalFetch(url, options)
+          }
+        }
+      JS
+    end
+
+    def finish_card_save
+      status = page.evaluate_async_script <<~JS
+        const done = arguments[0]
+        const resume = () => {
+          const save = window.cardSaves.shift()
+          if (save) save.resume().then(done)
+          else setTimeout(resume, 10)
+        }
+        resume()
+      JS
+      assert_equal 204, status
+    end
+
+    def fail_card_save(failure = "http")
+      page.execute_script("window.cardSaves.shift().#{failure == 'http' ? 'fail' : 'reject'}()")
+    end
+
+    # Capture an old response, then let it render only after the optimistic move and save.
+    def pause_column_reload(column)
+      page.execute_script <<~JS, dom_id(column, :cards)
+        const frame = document.getElementById(arguments[0])
+        const originalFetch = window.fetch
+        window.fetch = async (url, options) => {
+          const response = await originalFetch(url, options)
+          if (String(url) === frame.src) {
+            return new Promise(resolve => {
+              window.finishColumnReload = () => resolve(response)
+              document.body.dataset.columnResponseReady = "true"
+            })
+          }
+          return response
+        }
+        frame.reload()
+      JS
+      assert_selector "body[data-column-response-ready]"
+    end
+
+    def finish_column_reload
+      page.execute_script("window.finishColumnReload()")
+      assert_no_selector ".card-columns turbo-frame[busy]", visible: :all
+    end
+end
