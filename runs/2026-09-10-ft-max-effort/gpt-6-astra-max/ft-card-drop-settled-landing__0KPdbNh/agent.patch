diff --git a/app/javascript/controllers/board_drag_and_drop_controller.js b/app/javascript/controllers/board_drag_and_drop_controller.js
new file mode 100644
index 0000000..fccaf25
--- /dev/null
+++ b/app/javascript/controllers/board_drag_and_drop_controller.js
@@ -0,0 +1,221 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "error" ]
+  static values = { autoPostponePeriod: Number }
+
+  #saves = new Map()
+  #saveQueue = Promise.resolve()
+  #frameMoves = new WeakMap()
+  #sequence = 0
+
+  move({ detail: { item, source, destination } }) {
+    const state = this.#saves.get(item) || {
+      item, confirmed: this.#snapshot(item, source), columns: new Set()
+    }
+    this.#saves.set(item, state)
+    state.columns.add(source)
+    state.columns.add(destination)
+    state.destination = destination
+    state.sequence = ++this.#sequence
+
+    this.#insert(item, destination)
+    this.#updateCard(item, destination)
+    this.#changeCount(source, -1)
+    this.#changeCount(destination, 1)
+
+    // An already-loading column or pagination frame must not undo the local move.
+    this.element.querySelectorAll("turbo-frame[busy]").forEach(frame => this.#trackFrame(frame))
+
+    const snapshot = this.#snapshot(item, destination)
+    const sequence = state.sequence
+    const request = this.#requestFor(item, destination)
+
+    // Activity timestamps must follow drop order, even when different cards move quickly.
+    // Only the saves are queued; every local move has already happened.
+    this.#saveQueue = this.#saveQueue.then(() => this.#save(request, state, snapshot, sequence))
+  }
+
+  trackFrameRequest({ target }) {
+    if (target.matches("turbo-frame")) {
+      this.#frameMoves.delete(target)
+      this.#trackFrame(target)
+    }
+  }
+
+  preserveFrame({ target, detail }) {
+    const column = target.closest('[data-drag-and-drop-target~="container"]')
+    if (!column) return
+
+    const moves = this.#frameMoves.get(target) || new Map()
+
+    const render = detail.render
+    detail.render = async (currentFrame, newFrame) => {
+      const placements = Array.from(moves.values()).sort((a, b) => a.sequence - b.sequence)
+
+      for (const { item } of placements) {
+        newFrame.querySelector(`#${item.id}`)?.remove()
+        if (currentFrame.contains(item)) item.remove()
+      }
+
+      // An insertion can move the pagination boundary backwards by one card.
+      // Keep the existing element rather than rendering it again on the next page.
+      for (const card of newFrame.querySelectorAll(".card")) {
+        const existing = column.querySelector(`#${card.id}`)
+        if (existing && !currentFrame.contains(existing)) card.remove()
+      }
+
+      await render(currentFrame, newFrame)
+
+      for (const { item, destination } of placements) {
+        if (destination === column) this.#insert(item, destination)
+      }
+      this.#frameMoves.delete(target)
+    }
+  }
+
+  preserveColumn(event) {
+    for (const state of this.#saves.values()) {
+      if (state.columns.has(event.target)) {
+        event.preventDefault()
+      }
+    }
+  }
+
+  #snapshot(item, column) {
+    return { column, parent: item.parentNode, nextSibling: item.nextSibling, card: item.cloneNode(true) }
+  }
+
+  #insert(item, column) {
+    const cards = Array.from(column.querySelectorAll(".cards__list .card")).filter(card => card !== item)
+    const goldenFirst = [ "maybe", "triaged" ].includes(column.dataset.cardStatus)
+    const first = goldenFirst && !item.classList.contains("golden-effect")
+      ? cards.find(card => !card.classList.contains("golden-effect"))
+      : cards[0]
+
+    // Moves record new activity. Match latest.with_golden_first for active columns,
+    // latest for Not Now, and recently_closed_first for Done, regardless of pointer height.
+    if (first) {
+      first.before(item)
+    } else if (cards.length) {
+      cards.at(-1).after(item)
+    } else {
+      column.querySelector(".cards__list").prepend(item)
+    }
+  }
+
+  #updateCard(item, column) {
+    const status = column.dataset.cardStatus
+    item.classList.toggle("card--active", [ "maybe", "triaged" ].includes(status))
+    item.classList.toggle("card--postponed", status === "not_now")
+    item.style.setProperty("--card-color", column.dataset.cardColor)
+    item.removeAttribute("aria-selected")
+    this.#updateHotkeys(item, status)
+
+    // Stamps are hidden on the board, but an old system-postponed stamp can be visible.
+    item.querySelectorAll(".card__closed, .card__header .card__column-name").forEach(element => element.remove())
+    item.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+      const current = stage.dataset.columnId === column.dataset.columnId
+      stage.classList.toggle("card__column-name--current", current)
+      if (current) item.querySelector(".card__header").append(stage.cloneNode(true))
+    })
+
+    const now = new Date()
+    const time = item.querySelector(".card__meta-text--updated time")
+    if (time) {
+      time.dateTime = Math.floor(now.getTime() / 1000)
+      time.innerHTML = '<span class="local-time-value">today</span>'
+    }
+
+    const bubble = item.querySelector(".bubble")
+    if (bubble) {
+      const entropy = JSON.parse(bubble.dataset.bubbleEntropyValue)
+      entropy.closesAt = new Date(now.getTime() + this.autoPostponePeriodValue * 1000).toISOString()
+      bubble.dataset.bubbleEntropyValue = JSON.stringify(entropy)
+      bubble.dataset.bubbleStalledValue = "{}"
+      bubble.hidden = true
+    }
+  }
+
+  #updateHotkeys(item, status) {
+    const urls = JSON.parse(item.dataset.cardMoveUrls)
+    const hotkeys = { cardNotNowUrl: urls.not_now, cardClosureUrl: urls.closure, cardAssignToSelfUrl: urls.assign_to_self }
+    for (const [key, url] of Object.entries(hotkeys)) {
+      if (status === "closed") {
+        delete item.dataset[key]
+      } else {
+        item.dataset[key] = url
+      }
+    }
+    item.dataset.action = status === "closed" ? "" : "mouseenter->navigable-list#hoverSelect"
+  }
+
+  #changeCount(column, change) {
+    const button = column.querySelector(".cards__expander")
+    const count = Number(button.dataset.cardCount) + change
+    button.dataset.cardCount = count
+    button.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+    button.style.setProperty("--card-count", Math.min(column.querySelectorAll(".cards__list .card").length, 15))
+  }
+
+  #trackFrame(frame) {
+    const column = frame.closest('[data-drag-and-drop-target~="container"]')
+    const moves = this.#frameMoves.get(frame) || new Map()
+    for (const state of this.#saves.values()) {
+      if (state.columns.has(column)) moves.set(state.item.id, state)
+    }
+    if (moves.size) this.#frameMoves.set(frame, moves)
+  }
+
+  #requestFor(item, column) {
+    const urls = JSON.parse(item.dataset.cardMoveUrls)
+    switch (column.dataset.cardStatus) {
+      case "triaged":
+        return new FetchRequest("post", urls.triage, { responseKind: "json", body: { column_id: column.dataset.columnId } })
+      case "maybe":
+        return new FetchRequest("delete", urls.triage, { responseKind: "json" })
+      case "not_now":
+        return new FetchRequest("post", urls.not_now, { responseKind: "json" })
+      case "closed":
+        return new FetchRequest("post", urls.closure, { responseKind: "json" })
+    }
+  }
+
+  async #save(request, state, snapshot, sequence) {
+    const item = state.item
+    try {
+      // request.js uses Turbo.fetch, whose request ID suppresses our own broadcast refresh.
+      const response = await request.perform()
+      if (!response.ok) throw new Error("Card move failed")
+      state.confirmed = snapshot
+    } catch {
+      // A newer drop describes the complete desired state and can still succeed.
+      if (state.sequence === sequence && this.element.isConnected) {
+        this.#restore(state)
+        document.getElementById("flash").append(this.errorTarget.content.cloneNode(true))
+      }
+    } finally {
+      if (state.sequence === sequence) this.#saves.delete(item)
+    }
+  }
+
+  #restore(state) {
+    const { column, parent, nextSibling, card } = state.confirmed
+    const source = state.destination
+    state.item.replaceWith(card)
+    state.item = card
+    state.destination = column
+
+    if (parent.isConnected) {
+      parent.insertBefore(card, nextSibling?.parentNode === parent ? nextSibling : null)
+    } else {
+      this.#insert(card, column)
+    }
+
+    if (source !== column) {
+      this.#changeCount(source, -1)
+      this.#changeCount(column, 1)
+    }
+  }
+}
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..1ee1bc8
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,95 @@
+import { Controller } from "@hotwired/stimulus"
+import { isMobile } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #item
+  #source
+  #hoverContainer
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  disconnect() {
+    this.end()
+    this.itemTargets.forEach(item => item.removeAttribute("draggable"))
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.removeAttribute("draggable")
+  }
+
+  start(event) {
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    const source = this.#containerFor(item)
+
+    if (this.itemTargets.includes(item) && source && event.dataTransfer) {
+      this.#item = item
+      this.#source = source
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.clearData()
+      event.dataTransfer.setData("text/plain", item.id)
+      const { left, top } = item.getBoundingClientRect()
+      event.dataTransfer.setDragImage(item, event.clientX - left, event.clientY - top)
+      item.classList.add(this.draggedItemClass)
+    }
+  }
+
+  over(event) {
+    const container = this.#containerFor(event.target)
+
+    if (this.#item && container && container !== this.#source) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#highlight(null)
+    }
+  }
+
+  leave(event) {
+    if (this.#containerFor(event.target) === this.#hoverContainer && !this.#hoverContainer?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const destination = this.#containerFor(event.target)
+    const item = this.#item
+    const source = this.#source
+
+    this.end()
+
+    if (item && destination && destination !== source) {
+      event.preventDefault()
+      this.dispatch("drop", { detail: { item, source, destination } })
+    }
+  }
+
+  end() {
+    this.#item?.classList.remove(this.draggedItemClass)
+    this.#item = null
+    this.#source = null
+    this.#highlight(null)
+  }
+
+  #containerFor(element) {
+    const container = element?.closest('[data-drag-and-drop-target~="container"]')
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #highlight(container) {
+    if (this.#hoverContainer !== container) {
+      this.#hoverContainer?.classList.remove(this.hoverContainerClass)
+      this.#hoverContainer = container
+      container?.classList.add(this.hoverContainerClass)
+    }
+  }
+}
