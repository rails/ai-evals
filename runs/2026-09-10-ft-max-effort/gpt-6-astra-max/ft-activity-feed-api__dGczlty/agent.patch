@@ -0,0 +1,316 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of accessible events, newest first" do
+    get "/#{accounts("37s").external_account_id}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index accepts a read-only access token" do
+    sign_out
+    token = identity_access_tokens(:jasons_api_token).token
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index rejects an invalid access token" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer invalid" }
+
+    assert_response :unauthorized
+  end
+
+  test "index rejects access to another account" do
+    get "/#{accounts(:initech).external_account_id}/activities.json"
+
+    assert_response :forbidden
+  end
+
+  test "card activities use the existing API representations" do
+    event = events(:logo_published)
+    activity = activity_for(event)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.as_json, activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+
+    get cards_path, params: { card_ids: [ event.eventable_id ] }, as: :json
+    assert_response :success
+    assert_equal @response.parsed_body.sole, activity["eventable"]
+
+    get board_path(event.board), as: :json
+    assert_response :success
+    assert_equal @response.parsed_body, activity["board"]
+
+    get user_path(event.creator), as: :json
+    assert_response :success
+    assert_equal @response.parsed_body, activity["creator"]
+  end
+
+  test "comment activities use the comment representation and link to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+    activity = activity_for(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: "comment_#{comment.id}"), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment), as: :json
+    assert_response :success
+    assert_equal @response.parsed_body, activity["eventable"]
+  end
+
+  test "descriptions use the plain-text form for the current user" do
+    event = events(:logo_assignment_km)
+    cards(:logo).update_column(:title, "Tom & Jerry <3")
+
+    activity = activity_for(event)
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "will handle"
+    assert_not_includes activity["description"], "<span"
+
+    logout_and_sign_in_as :david
+
+    activity = activity_for(event)
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "assigned Kevin"
+  end
+
+  test "index includes timeline actions and title changes but excludes deprecated and unrelated actions" do
+    card_actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_postponed card_auto_postponed card_title_changed
+      card_triaged card_sent_back_to_triage
+    ]
+
+    (card_actions + %w[ card_collection_changed card_resumed card_drafted ]).each do |action|
+      cards(:logo).events.create!(action: action, board: boards(:writebook), creator: users(:jz))
+    end
+    events(:layout_commented).update!(creator: users(:jz))
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:jz).id ] }
+
+    assert_response :success
+    assert_equal (card_actions + [ "comment_created" ]).sort, @response.parsed_body.pluck("action").sort
+  end
+
+  test "assignment changes expose only assignee IDs" do
+    event = events(:logo_assignment_jz)
+
+    %w[ card_assigned card_unassigned ].each do |action|
+      event.update!(action: action, particulars: { assignee_ids: [ users(:jz).id, users(:kevin).id ], ignored: "detail" })
+
+      assert_equal({ "assignee_ids" => [ users(:jz).id, users(:kevin).id ] }, activity_for(event)["particulars"])
+    end
+  end
+
+  test "board, title, and triage changes expose only their event-specific particulars" do
+    event = events(:logo_published)
+    details = {
+      "card_board_changed" => { "old_board" => "Old board", "new_board" => "New board" },
+      "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" }
+    }
+
+    details.each do |action, particulars|
+      event.update!(action: action, particulars: { particulars: particulars.merge("ignored" => "detail"), ignored: "detail" })
+
+      assert_equal particulars, activity_for(event)["particulars"], action
+    end
+  end
+
+  test "missing board, title, and column particulars are empty strings" do
+    event = events(:logo_published)
+    details = {
+      "card_board_changed" => %w[ old_board new_board ],
+      "card_title_changed" => %w[ old_title new_title ],
+      "card_triaged" => %w[ column ]
+    }
+
+    details.each do |action, keys|
+      [ {}, { particulars: keys.index_with(nil) }, nil ].each do |particulars|
+        event.update!(action: action, particulars: particulars)
+
+        assert_equal keys.index_with(""), activity_for(event)["particulars"], "#{action} with #{particulars.inspect}"
+      end
+    end
+  end
+
+  test "other events return an empty particulars object even if details were stored" do
+    [ events(:logo_published), events(:layout_commented), events(:buy_domain_sent_back_to_triage) ].each do |event|
+      event.update!(particulars: { assignee_ids: [ users(:jz).id ], particulars: { column: "Ignored" } })
+
+      assert_equal({}, activity_for(event)["particulars"])
+    end
+  end
+
+  test "index filters by one or more event creators" do
+    [ [ users(:david).id ], [ users(:david).id, users(:kevin).id ] ].each do |creator_ids|
+      get activities_path(format: :json), params: { creator_ids: creator_ids }
+
+      assert_response :success
+      expected_ids = users(:kevin).accessible_events.where(creator_id: creator_ids).order(created_at: :desc, id: :desc).ids
+      assert_equal expected_ids, @response.parsed_body.pluck("id")
+    end
+  end
+
+  test "index filters by one or more boards" do
+    with_current_user(:kevin) { cards(:logo).move_to(boards(:private)) }
+
+    [ [ boards(:private).id ], [ boards(:private).id, boards(:writebook).id ] ].each do |board_ids|
+      get activities_path(format: :json), params: { board_ids: board_ids }
+
+      assert_response :success
+      expected_ids = users(:kevin).accessible_events.where(board_id: board_ids).order(created_at: :desc, id: :desc).ids
+      assert_equal expected_ids, @response.parsed_body.pluck("id")
+    end
+  end
+
+  test "index combines creator and board filters using the event creator, not the card creator" do
+    with_current_user(:kevin) { cards(:logo).move_to(boards(:private)) }
+    event = cards(:logo).events.find_by!(action: "card_board_changed")
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_equal [ event.id ], @response.parsed_body.pluck("id")
+    assert_equal users(:david).id, @response.parsed_body.sole.dig("eventable", "creator", "id")
+  end
+
+  test "index ignores empty filters and returns no events for unknown IDs" do
+    get activities_path(format: :json), params: { creator_ids: [], board_ids: [] }
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.count, @response.parsed_body.count
+
+    %i[ creator_ids board_ids ].each do |filter|
+      get activities_path(format: :json), params: { filter => [ ActiveRecord::Type::Uuid.generate ] }
+
+      assert_response :success
+      assert_equal [], @response.parsed_body
+    end
+  end
+
+  test "index never exposes card or comment activity on inaccessible boards" do
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+    logout_and_sign_in_as :david
+    expected_ids = users(:david).accessible_events.order(created_at: :desc, id: :desc).ids
+
+    [ {}, { board_ids: [ boards(:private).id, boards(:writebook).id ] } ].each do |filters|
+      get activities_path(format: :json), params: filters
+
+      assert_response :success
+      assert_equal expected_ids, @response.parsed_body.pluck("id")
+      assert_not_includes @response.parsed_body.pluck("id"), events(:layout_published).id
+      assert_not_includes @response.parsed_body.pluck("id"), events(:layout_commented).id
+    end
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index never exposes activity from another account, even when filtered by its IDs" do
+    event = Current.with(account: accounts(:initech), user: users(:mike)) do
+      cards(:radio).track_event("published")
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+
+    [ { board_ids: [ boards(:miltons_wish_list).id ] }, { creator_ids: [ users(:mike).id ] } ].each do |filters|
+      get activities_path(format: :json), params: filters
+
+      assert_response :success
+      assert_equal [], @response.parsed_body
+    end
+  end
+
+  test "index returns an empty array when the current user has no board access" do
+    users(:kevin).accesses.destroy_all
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index paginates in newest-first order and preserves filters in next-page links" do
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+    baseline = 2.months.ago.change(usec: 0)
+    creator_ids = [ users(:jz).id, users(:kevin).id ]
+    board_ids = [ boards(:private).id, boards(:writebook).id ]
+
+    55.times do |index|
+      card = cards(index.even? ? :layout : :logo)
+      creator = users(index % 3 == 0 ? :jz : :kevin)
+      card.events.create!(action: "card_published", creator: creator, board: card.board, created_at: baseline + (index % 7).minutes)
+    end
+    cards(:logo).track_event("published", creator: users(:david))
+
+    expected_ids = users(:kevin).accessible_events.where(creator_id: creator_ids, board_id: board_ids).order(created_at: :desc, id: :desc).ids
+    actual_ids = []
+    page_sizes = []
+    next_page = activities_path(format: :json, creator_ids: creator_ids, board_ids: board_ids)
+
+    while next_page
+      get next_page
+      assert_response :success
+
+      assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      page_sizes << @response.parsed_body.size
+      next_page = next_page_from_link_header(@response.headers["Link"])
+
+      if next_page
+        next_filters = Rack::Utils.parse_nested_query(URI.parse(next_page).query)
+        assert_equal creator_ids, next_filters["creator_ids"]
+        assert_equal board_ids, next_filters["board_ids"]
+      end
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_equal [ 15, 30, expected_ids.size - 45 ], page_sizes
+  end
+
+  test "index returns an empty array after the last page" do
+    get activities_path(format: :json), params: { page: 2 }
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  private
+    def activity_for(event)
+      get activities_path(format: :json)
+      assert_response :success
+
+      @response.parsed_body.find { |activity| activity["id"] == event.id }.tap do |activity|
+        assert_not_nil activity, "Expected activity for event #{event.id}"
+      end
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
