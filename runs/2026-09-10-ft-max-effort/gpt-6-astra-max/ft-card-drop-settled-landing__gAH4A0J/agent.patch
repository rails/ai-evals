+  private
+    def refresh_visits(request_id)
+      page.evaluate_async_script <<~'JS', request_id
+        const [requestId, done] = arguments
+        const session = window.Turbo.session
+        const originalVisit = session.visit
+        let visits = 0
+        session.visit = () => visits++
+
+        const stream = document.createElement("turbo-stream")
+        stream.setAttribute("action", "refresh")
+        stream.setAttribute("request-id", requestId)
+        document.body.append(stream)
+        stream.render().then(() => {
+          // Turbo debounces refresh streams for 150ms.
+          setTimeout(() => {
+            session.visit = originalVisit
+            done(visits)
+          }, 300)
+        })
+      JS
+    end
+
+    def wait_for_columns
+      [ "#not-now", "#closed-cards", *@board.columns.map { |column| "##{dom_id(column)}" } ].each do |column|
+        assert_selector "#{column} .cards__list", visible: :all
+      end
+    end
+
+    def card_state
+      [ @card.reload.column_id, @card.closed?, @card.postponed? ]
+    end
+
+    def card_order(column)
+      all("#{column} .card", visible: :all).map { |card| card[:id] }
+    end
+
+    def drag_card_to(card, selector)
+      element = find("##{dom_id(card, :article)}", visible: :all)
+      start_drag element
+      destination = find(selector, visible: :all, match: :first)
+      drag_event "dragover", destination
+      drag_event "drop", destination
+      drag_event "dragend", element
+    end
+
+    def start_drag(element)
+      page.execute_script "window.cardDragData = new DataTransfer()"
+      drag_event "dragstart", element
+    end
+
+    def drag_event(name, element, related_target: nil)
+      page.execute_script <<~'JS', name, element, related_target
+        arguments[1].dispatchEvent(new DragEvent(arguments[0], {
+          bubbles: true, cancelable: true, dataTransfer: window.cardDragData, relatedTarget: arguments[2]
+        }))
+      JS
+    end
+
+    def hold_card_requests
+      page.execute_script <<~'JS'
+        window.cardRequests = []
+        const originalFetch = window.fetch
+        window.fetch = (url, options) => {
+          if (/\/cards\/\d+\/(triage|closure|not_now)/.test(url) && options?.method !== "GET") {
+            return new Promise((resolve, reject) => {
+              window.cardRequests.push({
+                url, options, reject,
+                fail: () => resolve(new Response(null, { status: 500 })),
+                release: async () => resolve(await originalFetch(url, options))
+              })
+            })
+          }
+          return originalFetch(url, options)
+        }
+      JS
+    end
+
+    def release_card_request
+      page.evaluate_async_script <<~'JS'
+        const done = arguments[arguments.length - 1]
+        window.lastCardRequest = window.cardRequests.shift()
+        window.lastCardRequest.release().then(done)
+      JS
+    end
+end
