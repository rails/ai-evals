diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..08a3b12
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,466 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_in_progress)
+
+    visit board_url(@board)
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    wait_for_columns
+  end
+
+  test "a drop moves the card before saving and keeps the column order after saving" do
+    hold_card_requests
