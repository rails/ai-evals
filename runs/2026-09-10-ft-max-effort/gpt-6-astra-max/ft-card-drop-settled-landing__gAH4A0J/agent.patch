diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..1c236d2
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,248 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const ITEM_SELECTOR = '[data-drag-and-drop-target~="item"]'
+const CONTAINER_SELECTOR = '[data-drag-and-drop-target~="container"]'
+
+export default class extends Controller {
+  static targets = [ "item", "container", "stamp", "error" ]
+  static classes = [ "dragged", "hover" ]
+  static values = { timeZone: String, autoPostponePeriod: Number }
+
+  #draggedItem
+  #hoveredContainer
+  #pendingItems = new Set()
+  #saveQueue = Promise.resolve()
+
+  disconnect() {
+    this.dragEnd()
+    this.itemTargets.forEach(item => item.removeAttribute("draggable"))
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = !this.#pendingItems.has(item)
+  }
+
+  itemTargetDisconnected(item) {
+    item.removeAttribute("draggable")
+    if (item === this.#draggedItem && !this.element.contains(item)) {
+      this.dragEnd()
+    }
+  }
+
+  preventDraggableChange(event) {
+    if (event.detail.attributeName === "draggable" && event.target.matches(ITEM_SELECTOR)) {
+      event.preventDefault()
+    }
+  }
+
+  dragStart(event) {
+    const item = event.target.closest(ITEM_SELECTOR)
+    if (!item || !event.dataTransfer || this.#pendingItems.has(item)) {
+      event.preventDefault()
+      return
+    }
+
+    this.dragEnd()
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedClass)
+  }
+
+  dragOver(event) {
+    const container = this.#dropContainer(event.target)
+    this.#hover(container)
+
+    if (this.#draggedItem) {
+      event.dataTransfer.dropEffect = container ? "move" : "none"
+      if (container) event.preventDefault()
+    }
+  }
+
+  dragLeave({ relatedTarget }) {
+    if (!this.#hoveredContainer?.contains(relatedTarget)) this.#hover(null)
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const container = this.#dropContainer(event.target)
+    this.dragEnd()
+
+    if (container) {
+      event.preventDefault()
+      this.#move(item, container)
+    }
+  }
+
+  dragEnd() {
+    this.#draggedItem?.classList.remove(this.draggedClass)
+    this.#draggedItem = null
+    this.#hover(null)
+  }
+
+  #dropContainer(element) {
+    const container = element.closest(CONTAINER_SELECTOR)
+    if (this.#draggedItem && this.containerTargets.includes(container) &&
+        container !== this.#draggedItem.closest(CONTAINER_SELECTOR) && container.querySelector(".cards__list")) {
+      return container
+    }
+  }
+
+  #hover(container) {
+    if (container !== this.#hoveredContainer) {
+      this.#hoveredContainer?.classList.remove(this.hoverClass)
+      this.#hoveredContainer = container
+      this.#hoveredContainer?.classList.add(this.hoverClass)
+    }
+  }
+
+  async #move(item, container) {
+    const source = item.closest(CONTAINER_SELECTOR)
+    const position = document.createComment("card position")
+    const original = item.cloneNode(true)
+
+    item.before(position)
+    this.#pendingItems.add(item)
+    item.draggable = false
+    this.#insert(item, container)
+    this.#updateCard(item, container)
+    this.#updateCount(source, -1)
+    this.#updateCount(container, 1)
+
+    try {
+      // Request.js uses Turbo.fetch, so our own broadcast refresh is ignored.
+      // JSON saves don't render a response over the optimistic move either.
+      const response = await this.#save(item, container)
+      if (!response.ok) throw new Error("Unable to move card")
+    } catch {
+      if (this.element.contains(item) && this.element.contains(position)) {
+        item.remove()
+        position.replaceWith(original)
+        this.#updateCount(source, 1)
+        this.#updateCount(container, -1)
+        document.getElementById("flash")?.append(this.errorTarget.content.cloneNode(true))
+      }
+    } finally {
+      position.remove()
+      this.#pendingItems.delete(item)
+      item.draggable = true
+    }
+  }
+
+  #insert(item, container) {
+    const items = Array.from(container.querySelectorAll(ITEM_SELECTOR))
+    const goldenFirst = container.dataset.columnStatus === "active" && !item.classList.contains("golden-effect")
+    const nextItem = goldenFirst ? items.find(item => !item.classList.contains("golden-effect")) : items[0]
+
+    // Moves touch last_active_at. Keep the server's newest-first order, with
+    // golden cards first in active columns, regardless of the pointer position.
+    if (nextItem) {
+      nextItem.before(item)
+    } else if (items.length) {
+      items.at(-1).after(item)
+    } else {
+      container.querySelector(".cards__list").prepend(item)
+    }
+  }
+
+  #updateCard(item, container) {
+    const status = container.dataset.columnStatus
+    const active = status === "active"
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", status === "not_now")
+
+    if (status !== "closed") {
+      item.style.setProperty("--card-color", container.dataset.columnColor || "var(--color-card-default)")
+      item.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+        stage.classList.toggle("card__column-name--current", stage.dataset.columnId === container.dataset.columnId)
+      })
+    }
+
+    const columnName = item.querySelector(".card__header > .card__column-name")
+    columnName.hidden = !active || !container.dataset.columnId
+    columnName.firstElementChild.textContent = container.dataset.columnName
+
+    this.#updateHotkeys(item, status !== "closed")
+    this.#updateActivity(item)
+    item.querySelector(".card__closed")?.remove()
+    if (!active) this.#addStamp(item, container.dataset.columnName)
+  }
+
+  #updateHotkeys(item, open) {
+    for (const action of [ "Closure", "NotNow", "AssignToSelf" ]) {
+      if (open) {
+        item.dataset[`card${action}Url`] = item.dataset[`dragAndDrop${action}Url`]
+      } else {
+        delete item.dataset[`card${action}Url`]
+      }
+    }
+    item.dataset.action = open ? "mouseenter->navigable-list#hoverSelect" : ""
+  }
+
+  #updateActivity(item) {
+    const now = Date.now()
+    const time = item.querySelector(".card__meta-text--updated time")
+    const updatedTime = time.cloneNode(true)
+    updatedTime.setAttribute("datetime", Math.floor(now / 1000))
+    time.replaceWith(updatedTime)
+
+    const bubble = item.querySelector(".bubble")
+    if (bubble) {
+      const updatedBubble = bubble.cloneNode(true)
+      const entropy = JSON.parse(bubble.dataset.bubbleEntropyValue)
+      entropy.closesAt = new Date(now + this.autoPostponePeriodValue * 1000).toISOString()
+      updatedBubble.dataset.bubbleEntropyValue = JSON.stringify(entropy)
+      updatedBubble.removeAttribute("data-bubble-stalled-value")
+      updatedBubble.hidden = true
+      bubble.replaceWith(updatedBubble)
+    }
+  }
+
+  #addStamp(item, title) {
+    const stamp = this.stampTarget.content.firstElementChild.cloneNode(true)
+    const date = new Date().toLocaleDateString("en-US", {
+      timeZone: this.timeZoneValue, month: "short", day: "2-digit", year: "numeric"
+    })
+    stamp.dataset.bridgeTitle = title
+    stamp.dataset.bridgeDescription = date
+    stamp.querySelector(".card__closed-title").textContent = title
+    stamp.querySelector(".card__closed-title").dataset.text = title
+    stamp.querySelector(".card__closed-date").textContent = date
+    item.querySelector(".card__body").append(stamp)
+  }
+
+  #updateCount(container, change) {
+    const button = container.querySelector(".cards__expander")
+    const count = Number(button.dataset.cardCount) + change
+    button.dataset.cardCount = count
+    button.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+    button.style.setProperty("--card-count", Math.min(container.querySelectorAll(ITEM_SELECTOR).length, 15))
+  }
+
+  #save(item, container) {
+    // Preserve drop order in the activity timestamps that determine server order.
+    const request = this.#request(item, container)
+    const save = this.#saveQueue.then(() => request.perform())
+    this.#saveQueue = save.catch(() => {})
+    return save
+  }
+
+  #request(item, container) {
+    const options = { responseKind: "json" }
+    switch (container.dataset.columnStatus) {
+      case "closed":
+        return new FetchRequest("post", item.dataset.dragAndDropClosureUrl, options)
+      case "not_now":
+        return new FetchRequest("post", item.dataset.dragAndDropNotNowUrl, options)
+      default:
+        if (container.dataset.columnId) {
+          return new FetchRequest("post", item.dataset.dragAndDropTriageUrl, {
+            ...options, body: { column_id: container.dataset.columnId }
+          })
+        } else {
+          return new FetchRequest("delete", item.dataset.dragAndDropTriageUrl, options)
+        }
+    }
+  }
+}
