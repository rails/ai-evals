diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..d53ae29
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights each matched word case insensitively" do
+    result = highlight_search_matches("Bright nebula and NEBULA stars", search("nebula bright"))
+    assert_equal "<mark>Bright</mark> <mark>nebula</mark> and <mark>NEBULA</mark> stars", result
+  end
+
+  test "treats regular expression metacharacters literally" do
+    result = highlight_search_matches("a.*b and a longer b", search("a.*b"))
+    assert_equal "<mark>a.*b</mark> and a longer b", result
+  end
+
+  test "escapes both matching and nonmatching text before marking it as HTML safe" do
+    result = highlight_search_matches("<img src=x onerror=alert(1)> nebula & <script>alert(1)</script>", search("<script> nebula"))
+
+    assert_equal "&lt;img src=x onerror=alert(1)&gt; <mark>nebula</mark> &amp; <mark>&lt;script&gt;</mark>alert(1)&lt;/script&gt;", result
+    assert result.html_safe?
+    assert_empty Nokogiri::HTML.fragment(result).css("img, script")
+  end
+
+  test "matches plain text rather than HTML-escaped entities" do
+    assert_equal "<mark>&amp;</mark> stars", highlight_search_matches("& stars", search("&"))
+    assert_equal "&amp; stars", highlight_search_matches("& stars", search("amp"))
+  end
+
+  test "blank queries and empty text are safe" do
+    assert_equal "&lt;script&gt;", highlight_search_matches("<script>", search(nil))
+    assert_equal "", highlight_search_matches(nil, search("nebula"))
+  end
+
+  test "excerpt surrounds matches deep in rich text" do
+    content = ActionText::Content.new("<p>#{'Before ' * 100}<strong>Nebula</strong> &amp; stars #{'after ' * 100}</p>")
+    result = search_excerpt(content.to_plain_text, search("nebula"))
+
+    assert_includes result, "<mark>Nebula</mark> &amp; stars"
+    assert_operator result.length, :<, 250
+    assert_match(/\A\.\.\./, result)
+    assert_match(/\.\.\.\z/, result)
+  end
+
+  test "excerpt falls back to a short description when only the title matched" do
+    content = ActionText::Content.new("<p>#{'Before ' * 100}</p>")
+    result = search_excerpt(content.to_plain_text, search("nebula"))
+
+    assert_operator result.length, :<=, 200
+    assert_no_match(/<mark>/, result)
+  end
+
+  private
+    def search(query)
+      Search.new(query, user: users(:kevin))
+    end
+end
