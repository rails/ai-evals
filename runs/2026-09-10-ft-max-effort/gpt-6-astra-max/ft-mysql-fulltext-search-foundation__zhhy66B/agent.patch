diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..d201019
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.account = accounts("37s")
+    Current.session = sessions(:kevin)
+  end
+
+  test "finds cards by title at /search?q=term" do
+    get "/#{accounts("37s").external_account_id}/search", params: { q: "logo" }
+
+    assert_response :success
+    assert_results cards(:logo)
+    assert_select "#search_results a[href=?] mark", card_path(cards(:logo)), text: "logo"
+    assert_select "form[action=?][method=get] input[name=q][value=logo]", search_path
+  end
+
+  test "finds and highlights descriptions even when matches are far into the text" do
+    cards(:logo).update!(description: "<p>#{'Before ' * 100}<strong>NEBULA</strong> #{'after ' * 100}</p>")
+
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_results cards(:logo)
+    assert_select ".search-result__description mark", text: "NEBULA"
+  end
+
+  test "finds and highlights comment bodies with a link to the comment" do
+    get search_path, params: { q: "overflowing" }
+
+    assert_response :success
+    assert_results cards(:layout)
+    assert_select ".search-result__comment mark", text: "overflowing"
+    assert_select ".search-result__comment a[href=?]", card_path(cards(:layout), anchor: dom_id(comments(:layout_overflowing_david)))
+  end
+
+  test "shows each card once in newest first order regardless of matching comments" do
+    cards(:logo).update!(title: "nebula", description: "nebula", created_at: 3.days.ago)
+    cards(:layout).update!(title: "nebula", created_at: 1.day.ago)
+    2.times { cards(:logo).comments.create!(body: "nebula") }
+
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_results cards(:layout), cards(:logo)
+    assert_select ".search-result__comment", count: 2
+  end
+
+  test "revoking board access immediately removes title, description, and comment matches" do
+    cards(:logo).update!(title: "titlematch", description: "descriptionmatch")
+    cards(:logo).comments.create!(body: "commentmatch")
+
+    %w[ titlematch descriptionmatch commentmatch ].each do |query|
+      get search_path, params: { q: query }
+      assert_results cards(:logo)
+    end
+
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:kevin))
+
+    %w[ titlematch descriptionmatch commentmatch ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_results
+      assert_select "#search_results", text: /No cards found/
+    end
+  end
+
+  test "draft cards and their existing comments never appear" do
+    cards(:text).update!(title: "nebula", description: "nebula")
+    cards(:text).comments.create!(body: "stardust")
+    cards(:text).drafted!
+
+    %w[ nebula stardust ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_results
+      assert_select "#search_results mark", count: 0
+    end
+  end
+
+  test "search stays in the current account when an identity belongs to multiple accounts" do
+    users(:mike).update!(identity: identities(:kevin))
+    cards(:radio).update!(description: "secretnebula")
+
+    get search_path, params: { q: "secretnebula" }
+    assert_response :success
+    assert_results
+
+    get search_path(script_name: accounts(:initech).slug), params: { q: "secretnebula" }
+    assert_response :success
+    assert_results cards(:radio)
+  end
+
+  test "blank and missing queries show an empty search form rather than all cards" do
+    [ {}, { q: "" }, { q: " \n\t " } ].each do |query|
+      get search_path, params: query
+
+      assert_response :success
+      assert_results
+      assert_select "form[role=search] input[name=q]"
+      assert_equal "", css_select("form[role=search] input[name=q]").first["value"].to_s
+      assert_select "#search_results", text: /Search for words/
+    end
+  end
+
+  test "no matches shows a safe empty state and preserves the query" do
+    query = '<script>alert("nebula")</script>'
+    get search_path, params: { q: query }
+
+    assert_response :success
+    assert_results
+    assert_select "#search_results", text: /No cards found/
+    assert_select "#search_results script", count: 0
+    assert_select "input[name=q][value=?]", query
+  end
+
+  test "highlights titles and rich text without rendering untrusted HTML" do
+    cards(:logo).update!(title: "<img src=x onerror=alert(1)> nebula", description: "<p>&lt;script&gt;nebula&lt;/script&gt;</p>")
+    cards(:logo).comments.create!(body: "<p>&lt;img src=x onerror=alert(1)&gt; nebula</p>")
+
+    get search_path, params: { q: "nebula" }
+
+    assert_response :success
+    assert_results cards(:logo)
+    assert_select ".search-result__title mark", text: "nebula"
+    assert_select ".search-result__description mark", text: "nebula"
+    assert_select ".search-result__comment mark", text: "nebula"
+    assert_select "#search_results img, #search_results script", count: 0
+  end
+
+  test "pagination preserves the query and does not repeat cards" do
+    cards = 17.times.map do |index|
+      boards(:writebook).cards.create!(title: "pagination nebula #{index}", status: :published, created_at: index.minutes.ago)
+    end
+
+    get search_path, params: { q: "pagination nebula" }
+    assert_response :success
+    assert_results(*cards.first(15))
+
+    next_page = css_select("a[aria-label='Load page 2']").first["href"]
+    assert_equal "pagination nebula", Rack::Utils.parse_query(URI.parse(next_page).query)["q"]
+
+    get next_page
+    assert_response :success
+    assert_results(*cards.last(2))
+    assert_select "a[aria-label='Load page 3']", count: 0
+  end
+
+  test "search requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+
+    assert_response :redirect
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def assert_results(*cards)
+      assert_equal cards.map { |card| dom_id(card, :search_result) }, css_select("#search_results .search-result").map { |result| result["id"] }
+    end
+end
