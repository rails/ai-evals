+  <% if comment = @matching_comments[card.id] %>
+    <blockquote class="search-result__comment">
+      <p><%= search_excerpt(comment.body.plain_text_body, @search) %></p>
+      <%= link_to "View comment", card_path(card, anchor: dom_id(comment)), class: "txt-small", data: { turbo_frame: "_top" } %>
+    </blockquote>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..e318930
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,27 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, html: { role: "search" }, class: "flex gap-half margin-block" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search titles, descriptions, and comments…", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn btn--reversed" %>
+  <% end %>
+
+  <section id="search_results" aria-label="Search results">
+    <% if @search.query.blank? %>
+      <p class="blank-slate">Search for words in card titles, descriptions, or comments.</p>
+    <% elsif @page.records.empty? %>
+      <p class="blank-slate">No cards found for “<%= @search.query %>”.</p>
+    <% else %>
+      <p class="txt-small txt-subtle">Newest cards first</p>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "result", collection: @page.records, as: :card %>
+      <% end %>
+    <% end %>
+  </section>
+</section>
