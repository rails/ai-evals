+<article id="<%= dom_id(card, :search_result) %>" class="search-result">
+  <header>
+    <p class="txt-small txt-subtle margin-none-block">
+      <%= link_to card.board.name, card.board, data: { turbo_frame: "_top" } %> · #<%= card.number %> · <%= local_datetime_tag card.created_at, style: :date %>
+    </p>
+    <h2 class="search-result__title">
+      <%= link_to highlight_search_matches(card.title, @search), card, data: { turbo_frame: "_top" } %>
+    </h2>
+  </header>
+
+  <% if card.description.present? %>
+    <p class="search-result__description"><%= search_excerpt(card.description.plain_text_body, @search) %></p>
