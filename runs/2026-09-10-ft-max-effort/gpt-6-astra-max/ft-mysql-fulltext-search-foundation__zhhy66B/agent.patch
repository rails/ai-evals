diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..0b4f774
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,58 @@
+class Search
+  attr_reader :query, :user
+
+  def initialize(query, user:)
+    @query = query.to_s.squish
+    @user = user
+  end
+
+  def cards
+    if terms.any?
+      terms.reduce(user.accessible_cards.published) do |cards, term|
+        descriptions = matching_rich_texts(term).where(record_type: "Card", name: "description")
+        comment_bodies = matching_rich_texts(term).where(record_type: "Comment", name: "body")
+        comments = Comment.where(id: comment_bodies.select(:record_id))
+
+        cards.where("LOWER(cards.title) LIKE ? ESCAPE '!'", pattern_for(term))
+          .or(cards.where(id: descriptions.select(:record_id)))
+          .or(cards.where(id: comments.select(:card_id)))
+      end.reverse_chronologically
+    else
+      user.accessible_cards.none
+    end
+  end
+
+  def matching_comments_for(cards)
+    if terms.any? && cards.any?
+      bodies = terms.map { |term| matching_rich_texts(term) }.reduce(&:or)
+        .where(record_type: "Comment", name: "body")
+
+      # Only load one matching comment per card, even on long discussions.
+      comment_ids = user.accessible_comments.merge(Card.published)
+        .where(card_id: cards.map(&:id), id: bodies.select(:record_id))
+        .group(:card_id).select("MAX(comments.id)")
+
+      Comment.where(id: comment_ids).with_rich_text_body.index_by(&:card_id)
+    else
+      {}
+    end
+  end
+
+  def terms
+    @terms ||= query.downcase.split.uniq
+  end
+
+  def pattern
+    @pattern ||= Regexp.new(Regexp.union(terms.sort_by { |term| -term.length }).source, Regexp::IGNORECASE) if terms.any?
+  end
+
+  private
+    def matching_rich_texts(term)
+      ActionText::RichText.where(account_id: user.account_id)
+        .where("LOWER(action_text_rich_texts.plain_text_body) LIKE ? ESCAPE '!'", pattern_for(term))
+    end
+
+    def pattern_for(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+    end
+end
