--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,17 @@
+module SearchesHelper
+  def highlight_search_matches(text, search)
+    if search.pattern
+      safe_join(text.to_s.split(/(#{search.pattern})/).each_with_index.map do |part, index|
+        index.odd? ? tag.mark(part) : part
+      end)
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_excerpt(text, search)
+    text = text.to_s.squish
+    snippet = excerpt(text, search.pattern, radius: 100) if search.pattern
+    highlight_search_matches(snippet || text.truncate(200), search)
+  end
+end
