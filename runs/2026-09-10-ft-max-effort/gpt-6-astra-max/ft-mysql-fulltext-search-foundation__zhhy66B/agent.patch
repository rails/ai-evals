diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..e3d2b17
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,191 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @user = users(:kevin)
+  end
+
+  test "finds titles, descriptions, and any comment body without duplicate cards" do
+    cards(:logo).update!(title: "Searchable nebula", description: "<p>A <strong>nebula</strong></p>")
+    cards(:logo).comments.create!(body: "Another nebula")
+    cards(:logo).comments.create!(body: "A second nebula")
+    cards(:layout).update!(description: "<p>Nebula in the description</p>")
+    cards(:text).comments.create!(body: "<p>NEBULA in a comment</p>")
+
+    assert_equal [ cards(:logo), cards(:layout), cards(:text) ].sort_by(&:id), search("nebula").cards.sort_by(&:id)
+  end
+
+  test "existing comment bodies are searchable" do
+    assert_equal [ cards(:logo) ], search("agree").cards
+  end
+
+  test "results are ordered by card creation time, then id, newest first" do
+    cards(:logo).update!(title: "nebula", created_at: 3.days.ago)
+    cards(:layout).update!(title: "nebula", created_at: 1.day.ago)
+    cards(:text).update!(title: "nebula", created_at: cards(:layout).created_at)
+    cards(:logo).comments.create!(body: "Most recent nebula activity")
+
+    newest = [ cards(:layout), cards(:text) ].sort_by(&:id).reverse
+    assert_equal [ *newest, cards(:logo) ], search("nebula").cards
+  end
+
+  test "all words must match and can be spread over titles, descriptions, and different comments" do
+    cards(:logo).update!(title: "Nebula", description: "<p>purple gas</p>")
+    cards(:logo).comments.create!(body: "bright")
+    cards(:logo).comments.create!(body: "stars")
+    cards(:layout).update!(title: "Nebula", description: "purple gas and bright dust")
+
+    assert_equal [ cards(:logo) ], search("  NEBULA purple\tbright\nstars  ").cards
+    assert_empty search("nebula purple missing").cards
+  end
+
+  test "blank queries do not return all cards" do
+    [ nil, "", " \n\t " ].each do |query|
+      assert_empty search(query).cards
+    end
+  end
+
+  test "searches literal SQL wildcards, escape characters, and regexp punctuation" do
+    [ "%", "_", "!", "\\", ".*", "[", "(", "a|b", "'" ].each do |term|
+      cards(:logo).update!(title: "Literal #{term} title")
+      cards(:layout).update!(description: "<p>Literal #{term} description</p>")
+      comments(:layout_overflowing_david).update!(body: "Literal #{term} comment")
+
+      assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id), search(term).cards.sort_by(&:id), "Expected literal matches for #{term.inspect}"
+    end
+
+    assert_empty search("' OR 1=1 --").cards
+  end
+
+  test "searches readable text, not HTML attributes or tags" do
+    cards(:logo).update!(description: '<p data-secret="hiddenattribute">A <strong>neb</strong>ula &amp; stardust</p>')
+    cards(:layout).comments.create!(body: '<div data-secret="hiddenattribute">Another <em>neb</em>ula</div>')
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id), search("nebula").cards.sort_by(&:id)
+    assert_equal [ cards(:logo) ], search("&").cards
+    assert_empty search("hiddenattribute").cards
+    assert_empty search("strong").cards
+  end
+
+  test "only cards on currently accessible boards are returned even for admins" do
+    cards(:logo).update!(title: "nebula")
+    private_card = boards(:private).cards.create!(title: "nebula", description: "secret nebula", status: :published)
+    private_card.comments.create!(body: "secret nebula comment")
+
+    assert_includes search("nebula").cards, private_card
+    boards(:private).accesses.revoke_from(@user)
+    assert_equal [ cards(:logo) ], search("nebula").cards
+    assert_empty search("nebula").matching_comments_for([ private_card ])
+
+    boards(:private).accesses.grant_to(@user)
+    assert_includes search("nebula").cards, private_card
+  end
+
+  test "other accounts are not searched" do
+    cards(:radio).update!(title: "nebula", description: "nebula")
+    assert_empty search("nebula").cards
+  end
+
+  test "drafts and their existing comments are excluded including the user's own drafts" do
+    card = cards(:text)
+    card.update!(title: "nebula", description: "purple")
+    card.comments.create!(body: "stardust")
+
+    assert_equal [ card ], search("stardust").cards
+    card.drafted!
+
+    %w[ nebula purple stardust ].each do |query|
+      assert_empty search(query).cards
+    end
+    assert_empty search("stardust").matching_comments_for([ card ])
+
+    card.publish
+    assert_equal [ card ], search("stardust").cards
+  end
+
+  test "closed and postponed cards are still searchable" do
+    cards(:logo).update!(title: "nebula")
+    cards(:logo).close
+    cards(:layout).update!(title: "nebula")
+    cards(:layout).postpone
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id), search("nebula").cards.sort_by(&:id)
+  end
+
+  test "moving a card immediately changes the visibility of all its content" do
+    cards(:logo).update!(title: "nebula", description: "purple")
+    cards(:logo).comments.create!(body: "stardust")
+    boards(:private).accesses.revoke_from(@user)
+    cards(:logo).assignees.clear
+    cards(:logo).move_to(boards(:private))
+
+    %w[ nebula purple stardust ].each do |query|
+      assert_empty search(query).cards
+    end
+
+    cards(:logo).move_to(boards(:writebook))
+    assert_equal [ cards(:logo) ], search("stardust").cards
+  end
+
+  test "edits and deletions are reflected immediately" do
+    card = cards(:logo)
+    card.update!(title: "nebula", description: "stardust")
+    assert_equal [ card ], search("nebula").cards
+    assert_equal [ card ], search("stardust").cards
+
+    card.update!(title: "Changed", description: "")
+    card.comments.by_system.destroy_all # Title history is also searchable content.
+    assert_empty search("nebula").cards
+    assert_empty search("stardust").cards
+
+    comment = card.comments.create!(body: "nebula")
+    assert_equal [ card ], search("nebula").cards
+    comment.update!(body: "stardust")
+    assert_empty search("nebula").cards
+    assert_equal [ card ], search("stardust").cards
+    comment.destroy!
+    assert_empty search("stardust").cards
+
+    card.update!(description: "nebula")
+    card.destroy!
+    assert_empty search("nebula").cards
+  end
+
+  test "only one matching comment is loaded per card" do
+    cards(:logo).comments.create!(body: "nebula")
+    latest = cards(:logo).comments.create!(body: "another nebula")
+    cards(:logo).comments.create!(body: "unrelated")
+    other = cards(:layout).comments.create!(body: "nebula")
+
+    assert_equal({ cards(:logo).id => latest, cards(:layout).id => other }, search("nebula").matching_comments_for([ cards(:logo), cards(:layout) ]))
+    assert_equal({ cards(:logo).id => latest }, search("nebula").matching_comments_for([ cards(:logo) ]))
+    assert_empty search("nebula").matching_comments_for([])
+  end
+
+  test "title history remains searchable through system comments" do
+    cards(:logo).update!(title: "nebula")
+    cards(:logo).update!(title: "A different title")
+
+    assert_equal [ cards(:logo) ], search("nebula").cards
+    assert search("nebula").matching_comments_for([ cards(:logo) ]).fetch(cards(:logo).id).creator.system?
+  end
+
+  test "plain text is synchronized when rich text is edited directly" do
+    cards(:logo).update!(description: "<p>nebula</p>")
+    cards(:logo).description.update!(body: "<p>stardust &amp; stars</p>")
+
+    assert_equal "stardust & stars", cards(:logo).description.reload.plain_text_body
+    assert_empty search("nebula").cards
+    assert_equal [ cards(:logo) ], search("stardust").cards
+
+    cards(:logo).description.update!(body: nil)
+    assert_equal "", cards(:logo).description.reload.plain_text_body
+    assert_empty search("stardust").cards
+  end
+
+  private
+    def search(query)
+      Search.new(query, user: @user)
+    end
+end
