diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..0ed99fd
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+require_relative "../../stripe_test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_local", stripe_subscription_id: "sub_local", plan_key: "monthly_v1", status: "active")
+  end
+
+  test "only active and trialing subscriptions grant paid access" do
+    %w[ active trialing ].each do |status|
+      assert Account::Subscription.new(status: status, plan_key: "monthly_v1").active?
+    end
+    %w[ incomplete incomplete_expired past_due canceled unpaid paused ].each do |status|
+      assert_not Account::Subscription.new(status: status, plan_key: "monthly_v1").active?
+    end
+    assert_not Account::Subscription.new(status: "active").active?
+  end
+
+  test "delinquent subscriptions must use the portal, not another checkout" do
+    %w[ incomplete past_due unpaid paused ].each do |status|
+      @subscription.status = status
+      assert @subscription.subscribed?
+    end
+    %w[ canceled incomplete_expired ].each do |status|
+      @subscription.status = status
+      assert_not @subscription.subscribed?
+    end
+  end
+
+  test "canceling a subscription is idempotent" do
+    cancellation = stub_stripe(:delete, "subscriptions/sub_local", stripe_subscription_data(status: "canceled"))
+
+    2.times { @subscription.cancel }
+
+    assert_equal "canceled", @subscription.reload.status
+    assert_requested cancellation, times: 1
+  end
+
+  test "comp cancels existing charges and uncomp does not restart them" do
+    cancellation = stub_stripe(:delete, "subscriptions/sub_local", stripe_subscription_data(status: "canceled"))
+
+    @account.comp
+    assert @account.reload.comped?
+    assert_equal "canceled", @subscription.reload.status
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.uncomp
+    assert_equal Plan.free, @account.reload.billing_plan
+    assert_requested cancellation, times: 1
+  end
+
+  test "account cancellation stops billing before canceling the account" do
+    cancellation = stub_stripe(:delete, "subscriptions/sub_local", stripe_subscription_data(status: "canceled"))
+
+    @account.cancel(initiated_by: users(:mike))
+
+    assert @account.reload.cancelled?
+    assert_equal "canceled", @subscription.reload.status
+    assert_requested cancellation, times: 1
+  end
+
+  test "failed Stripe cancellation neither deletes nor comps the account" do
+    stub_stripe(:delete, "subscriptions/sub_local", { error: { type: "api_error", message: "Unavailable" } }, status: 503)
+
+    assert_raises(Stripe::APIError) { @account.cancel(initiated_by: users(:mike)) }
+    assert_not @account.reload.cancelled?
+
+    assert_raises(Stripe::APIError) { @account.comp }
+    assert_not @account.reload.comped?
+    assert @subscription.reload.active?
+  end
+
+  test "canceling an abandoned checkout expires it only once" do
+    @subscription.update!(stripe_subscription_id: nil, status: nil, checkout_session_id: "cs_local", checkout_session_url: "https://checkout.stripe.com/c/pay/local", checkout_session_expires_at: 1.hour.from_now)
+    expiration = stub_stripe(:post, "checkout/sessions/cs_local/expire", { id: "cs_local", object: "checkout.session", status: "expired" })
+
+    2.times { @subscription.cancel }
+
+    assert_requested expiration, times: 1
+    assert_nil @subscription.reload.checkout_session_id
+  end
+
+  test "paid plans are not reduced by an older storage exception" do
+    @account.add_storage_exception(2.gigabytes)
+    assert_equal 5.gigabytes, @account.storage_limit
+    @subscription.update!(plan_key: "monthly_extra_storage_v1")
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+end
