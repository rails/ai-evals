diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..fbebdca
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+require_relative "../../stripe_test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_local")
+  end
+
+  test "signed subscription events work without authentication or an account prefix" do
+    data = stripe_subscription_data
+    deliver_stripe_event(stripe_event(data: data))
+
+    assert_response :success
+    assert_equal "sub_local", @subscription.reload.stripe_subscription_id
+    assert_equal "active", @subscription.status
+    assert_equal "monthly_v1", @subscription.plan_key
+    assert_equal Time.at(data[:items][:data].first[:current_period_end]), @subscription.current_period_end
+    assert_equal 5.gigabytes, @account.reload.storage_limit
+    assert_nil @account.card_limit
+  end
+
+  test "subscription upgrades, scheduled cancellations, and deletion update entitlements" do
+    deliver_stripe_event(stripe_event)
+    data = stripe_subscription_data(cancel_at_period_end: true)
+    data[:items][:data].first[:price][:id] = ENVIRONMENT.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    deliver_stripe_event(stripe_event(type: "customer.subscription.updated", data: data))
+
+    assert_response :success
+    assert_equal "monthly_extra_storage_v1", @subscription.reload.plan_key
+    assert_equal @subscription.current_period_end, @subscription.cancel_at
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+
+    deliver_stripe_event(stripe_event(type: "customer.subscription.deleted", data: data.merge(status: "canceled")))
+    assert_response :success
+    assert_equal "canceled", @subscription.reload.status
+    assert_equal Plan.free, @account.reload.billing_plan
+  end
+
+  test "duplicate and stale events do not roll a subscription back" do
+    event = stripe_event
+    deliver_stripe_event(event)
+    assert_no_changes -> { @subscription.reload.attributes } do
+      deliver_stripe_event(event)
+    end
+
+    stale = stripe_event(type: "customer.subscription.updated", data: stripe_subscription_data(status: "past_due"), created: 1.hour.ago.to_i)
+    deliver_stripe_event(stale)
+    assert_response :success
+    assert_equal "active", @subscription.reload.status
+  end
+
+  test "a cancellation wins over a same-second subscription update" do
+    created = Time.current.to_i
+    deliver_stripe_event(stripe_event(created: created))
+    deliver_stripe_event(stripe_event(type: "customer.subscription.deleted", created: created, data: stripe_subscription_data(status: "canceled")))
+    deliver_stripe_event(stripe_event(type: "customer.subscription.updated", created: created))
+
+    assert_equal "canceled", @subscription.reload.status
+    assert_equal Plan.free, @account.reload.billing_plan
+  end
+
+  test "events for an older subscription cannot replace a new subscription" do
+    deliver_stripe_event(stripe_event)
+    data = stripe_subscription_data(id: "sub_new", created: Time.current.to_i)
+    deliver_stripe_event(stripe_event(data: data))
+    deliver_stripe_event(stripe_event(type: "customer.subscription.deleted", data: stripe_subscription_data(status: "canceled"), created: 1.minute.from_now.to_i))
+
+    assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+    assert @subscription.active?
+  end
+
+  test "unknown prices cannot grant a paid allowance" do
+    data = stripe_subscription_data
+    data[:items][:data].first[:price][:id] = "price_unknown"
+    deliver_stripe_event(stripe_event(data: data))
+
+    assert_response :success
+    assert_nil @subscription.reload.plan_key
+    assert_equal Plan.free, @account.reload.billing_plan
+  end
+
+  test "unknown customers and unrelated events are acknowledged without creating subscriptions" do
+    assert_no_difference -> { Account::Subscription.count } do
+      deliver_stripe_event(stripe_event(data: stripe_subscription_data(customer: "cus_unknown")))
+      assert_response :success
+      deliver_stripe_event(stripe_event(type: "invoice.paid", data: { id: "in_local", object: "invoice" }))
+      assert_response :success
+    end
+    assert_nil @subscription.reload.stripe_subscription_id
+  end
+
+  test "customer id, not metadata, identifies the account" do
+    data = stripe_subscription_data(metadata: { account_id: accounts(:"37s").id })
+    deliver_stripe_event(stripe_event(data: data))
+
+    assert_nil accounts(:"37s").reload.subscription
+    assert_equal "sub_local", @account.reload.subscription.stripe_subscription_id
+  end
+
+  test "bad signatures, missing signatures, old signatures, and malformed JSON are rejected" do
+    assert_no_changes -> { @subscription.reload.attributes } do
+      deliver_stripe_event(stripe_event, secret: "wrong_secret")
+      assert_response :bad_request
+
+      post "/stripe/webhooks", params: stripe_event.to_json, headers: { "Content-Type" => "application/json" }
+      assert_response :bad_request
+
+      deliver_stripe_event(stripe_event, timestamp: 1.hour.ago.to_i)
+      assert_response :bad_request
+
+      deliver_stripe_event("not JSON")
+      assert_response :bad_request
+    end
+  end
+
+  test "an empty webhook secret cannot authenticate events" do
+    ENV["STRIPE_WEBHOOK_SECRET"] = ""
+    deliver_stripe_event(stripe_event, secret: "")
+    assert_response :service_unavailable
+    assert_nil @subscription.reload.stripe_subscription_id
+  end
+
+  test "subscription downgrades change storage immediately and cancellation can be unscheduled" do
+    data = stripe_subscription_data(cancel_at_period_end: true)
+    data[:items][:data].first[:price][:id] = ENVIRONMENT.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    deliver_stripe_event(stripe_event(data: data))
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+
+    deliver_stripe_event(stripe_event(type: "customer.subscription.updated"))
+    assert_response :success
+    assert_equal 5.gigabytes, @account.reload.storage_limit
+    assert_nil @subscription.reload.cancel_at
+  end
+
+  test "older Stripe API period fields are also supported" do
+    data = stripe_subscription_data(current_period_end: 2.weeks.from_now.to_i)
+    data[:items][:data].first.delete(:current_period_end)
+    deliver_stripe_event(stripe_event(data: data))
+
+    assert_response :success
+    assert_equal Time.at(data[:current_period_end]), @subscription.reload.current_period_end
+  end
+
+  test "processing failures are not acknowledged so Stripe can retry" do
+    Account::Subscription.expects(:process).raises(ActiveRecord::ConnectionNotEstablished)
+
+    assert_raises ActiveRecord::ConnectionNotEstablished do
+      without_action_dispatch_exception_handling { deliver_stripe_event(stripe_event) }
+    end
+  end
+  test "a canceled subscription can be replaced by one created in the same second" do
+    freeze_time do
+      deliver_stripe_event(stripe_event)
+      deliver_stripe_event(stripe_event(type: "customer.subscription.deleted", data: stripe_subscription_data(status: "canceled")))
+      deliver_stripe_event(stripe_event(data: stripe_subscription_data(id: "sub_new")))
+
+      assert_response :success
+      assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+      assert @subscription.active?
+
+      deliver_stripe_event(stripe_event(type: "customer.subscription.deleted", data: stripe_subscription_data(status: "canceled")))
+      assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+      assert @subscription.active?
+    end
+  end
+end
diff --git a/saas/test/integration/billing_test.rb b/saas/test/integration/billing_test.rb
new file mode 100644
index 0000000..57f5454
--- /dev/null
+++ b/saas/test/integration/billing_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.update!(cards_count: @account.cards.maximum(:number))
+    @card = cards(:unfinished_thoughts)
+    @board = boards(:miltons_wish_list)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "a full free account can draft and edit but cannot publish or create through JSON" do
+    @account.override_limits(card_count: 1_000)
+
+    post board_cards_path(@board)
+    assert_redirected_to card_draft_path(@card)
+
+    patch card_path(@card), params: { card: { title: "Keep drafting" } }, as: :json
+    assert_response :success
+    assert_equal "Keep drafting", @card.reload.title
+
+    post card_publish_path(@card)
+    assert_response :forbidden
+    assert @card.reload.drafted?
+
+    post card_publish_path(@card), as: :json
+    assert_response :forbidden
+    assert @card.reload.drafted?
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board), params: { card: { title: "Not allowed" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "exhausted drafts replace create buttons with an upgrade pitch" do
+    @account.override_limits(card_count: 1_000)
+
+    get card_draft_path(@card)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a[href=?]", saas.account_subscription_path, text: "Upgrade"
+  end
+
+  test "the warning counts down from 100 cards" do
+    [ [ 899, nil ], [ 900, "100 cards left" ], [ 950, "50 cards left" ], [ 999, "1 card left" ] ].each do |count, message|
+      @account.override_limits(card_count: count)
+      get card_draft_path(@card)
+      assert_response :success
+      assert_select ".card-perma__notch-new-card-buttons"
+      if message
+        assert_select ".card-limit-notice", text: /#{message}/
+      else
+        assert_select ".card-limit-notice", count: 0
+      end
+    end
+  end
+
+  test "admins see their plan and upgrade in settings" do
+    get account_settings_path
+    assert_response :success
+    assert_select "#billing", text: /Free/
+    assert_select "#billing a[href=?]", saas.account_subscription_path, text: "Upgrade"
+  end
+
+  test "the thousandth published card is allowed, but the next one is not" do
+    fill_published_cards_to(999)
+    post card_publish_path(@card)
+    assert_response :redirect
+    assert @card.reload.published?
+    assert_equal 1_000, @account.card_count
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board), params: { card: { title: "Over quota" } }, as: :json
+    end
+    assert_response :forbidden
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board)
+    end
+    assert_response :redirect
+    new_draft = Card.last
+    assert new_draft.drafted?
+    post card_publish_path(new_draft)
+    assert_response :forbidden
+    assert new_draft.reload.drafted?
+  end
+
+  test "the API can create the last free card, then must upgrade" do
+    fill_published_cards_to(999)
+    post board_cards_path(@board), params: { card: { title: "Last free card" } }, as: :json
+    assert_response :created
+    assert_equal 1_000, @account.card_count
+
+    post board_cards_path(@board), params: { card: { title: "Over quota" } }, as: :json
+    assert_response :forbidden
+    assert_equal 1_000, @account.card_count
+  end
+
+  test "paid and comped accounts can publish over the free card allowance" do
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+    @account.comp
+    post card_publish_path(@card)
+    assert_response :redirect
+
+    @account.uncomp
+    @account.create_subscription!(stripe_customer_id: "cus_paid", stripe_subscription_id: "sub_paid", status: "active", plan_key: "monthly_v1")
+    post board_cards_path(@board), params: { card: { title: "Paid card" } }, as: :json
+    assert_response :created
+  end
+
+  test "members see the upgrade explanation without billing access" do
+    users(:mike).update!(role: :member)
+    @account.override_limits(card_count: 1_000)
+    get card_draft_path(@card)
+
+    assert_response :success
+    assert_select ".card-perma__account-limit-message", text: /Ask an account admin to upgrade/
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "storage follows the selected paid plan when publishing" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_paid", stripe_subscription_id: "sub_paid", status: "active", plan_key: "monthly_v1")
+    @account.override_limits(card_count: 1_000, bytes_used: 5.gigabytes + 1)
+
+    get card_draft_path(@card)
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message", text: /Unlimited plan \(5 GB\)/
+    assert_select "a[href=?]", saas.account_subscription_path, text: "Upgrade"
+
+    post card_publish_path(@card)
+    assert_response :forbidden
+
+    subscription.update!(plan_key: "monthly_extra_storage_v1")
+    get card_draft_path(@card)
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select ".card-limit-notice", count: 0
+
+    post card_publish_path(@card)
+    assert_response :redirect
+    assert @card.reload.published?
+  end
+
+  private
+    def fill_published_cards_to(count)
+      number = @account.cards.maximum(:number)
+      Card.insert_all! Array.new(count - @account.cards.published.count) { |index|
+        { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: @board.id, creator_id: users(:mike).id,
+          number: number + index + 1, title: "Published card", status: "published", last_active_at: Time.current }
+      }
+      @account.update!(cards_count: @account.cards.maximum(:number))
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..ce9f831
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    Current.account = @account
+  end
+
+  test "accounts start free without contacting Stripe" do
+    Stripe::Customer.expects(:create).never
+
+    assert_equal Plan.free, @account.billing_plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "card usage counts published cards, not drafts or the numbering sequence" do
+    @account.update!(cards_count: 2_000)
+    assert_equal @account.cards.published.count, @account.card_count
+
+    assert_no_difference -> { @account.card_count } do
+      @account.cards.create!(board: boards(:miltons_wish_list), creator: users(:mike), status: :drafted)
+    end
+
+    assert_difference -> { @account.card_count } do
+      with_current_user(:mike) { cards(:unfinished_thoughts).publish }
+    end
+  end
+
+  test "free card limit and countdown boundaries" do
+    [ [ 899, 101, false, false ], [ 900, 100, true, false ], [ 950, 50, true, false ],
+      [ 999, 1, true, false ], [ 1_000, 0, false, true ], [ 1_001, 0, false, true ] ].each do |count, remaining, nearing, exceeded|
+      @account.override_limits(card_count: count)
+      assert_equal remaining, @account.remaining_cards
+      assert_equal nearing, @account.nearing_card_limit?
+      assert_equal exceeded, @account.exceeding_card_limit?
+    end
+  end
+
+  test "comp and uncomp are persistent and idempotent" do
+    2.times { @account.comp }
+    assert @account.reload.comped?
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_equal 1, Account::BillingWaiver.where(account: @account).count
+
+    2.times { @account.uncomp }
+    assert_not @account.reload.comped?
+    assert_equal Plan.free, @account.billing_plan
+  end
+
+  test "usage overrides allow zero and reset restores real usage" do
+    original_cards = @account.card_count
+    original_bytes = @account.bytes_used
+    @account.override_limits(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.reload.card_count
+    assert_equal 0, @account.bytes_used
+
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    assert_difference -> { Account::OverriddenLimits.count }, -1 do
+      @account.reset_overridden_limits
+    end
+    assert_equal original_cards, @account.reload.card_count
+    assert_equal original_bytes, @account.bytes_used
+  end
+
+  test "invalid overrides do not change usage" do
+    @account.override_limits(card_count: 950)
+
+    [ -1, "not a number", 1.5 ].each do |value|
+      assert_raises ActiveRecord::RecordInvalid do
+        @account.override_limits(card_count: value)
+      end
+      assert_equal 950, @account.reload.card_count
+    end
+  end
+
+  test "paid subscriptions bring their storage allowance and unlimited cards" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_paid", stripe_subscription_id: "sub_paid", status: "active", plan_key: "monthly_v1")
+    @account.override_limits(card_count: 10_000, bytes_used: 2.gigabytes)
+
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_storage_limit?
+
+    subscription.update!(plan_key: "monthly_extra_storage_v1")
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+
+    subscription.update!(status: "canceled")
+    assert_equal Plan.free, @account.reload.billing_plan
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+  end
+end
