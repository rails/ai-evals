+<% @page_title = "Plan & billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel shadow center">
+  <p>Your plan: <strong><%= @account.billing_plan.name %></strong><%= " (Complimentary)" if @account.comped? %></p>
+
+  <% if params[:checkout] == "complete" %>
+    <p role="status">Thanks! Your plan will update when Stripe confirms your subscription.</p>
+  <% end %>
+
+  <% if @account.subscription %>
+    <%= button_to "Manage billing", saas.account_subscription_portal_path(script_name: Current.account.slug), class: "btn", form: { data: { turbo: false } } %>
+    <% if @account.subscription.cancel_at %>
+      <p>Your subscription ends <%= local_datetime_tag @account.subscription.cancel_at, style: :date %>.</p>
+    <% end %>
+  <% end %>
+
+  <div class="flex flex-wrap gap justify-center margin-block">
+    <% Plan.all.each do |plan| %>
+      <section class="panel">
+        <h2><%= plan.name %></h2>
+        <p><strong><%= plan.free? ? "Free" : "#{number_to_currency(plan.price_in_cents / 100, precision: 0)}/month" %></strong></p>
+        <p><%= plan.card_limit ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards" %></p>
+        <p><%= number_to_human_size(plan.storage_limit) %> storage</p>
+        <% unless plan.free? || @account.comped? %>
+          <% if @account.subscription&.subscribed? %>
+            <%= button_to "Change plan", saas.account_subscription_portal_path(script_name: Current.account.slug), class: "btn", form: { data: { turbo: false } } %>
+          <% else %>
+            <%= button_to "Upgrade to #{plan.name}", saas.account_subscription_path(script_name: Current.account.slug), params: { plan_key: plan.key }, class: "btn", form: { data: { turbo: false } } %>
+          <% end %>
+        <% end %>
+      </section>
+    <% end %>
+  </div>
+
+  <% if @account.comped? %>
+    <p>This account is complimentary. Contact support to change its plan.</p>
+  <% end %>
+
+  <p>Checkout, payment details, and cancellations are handled securely by Stripe.</p>
+  <%= link_to "Back to settings", main_app.account_settings_path(script_name: Current.account.slug) %>
+</section>
