diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..8a4e91c
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,130 @@
+class Account::Subscription < SaasRecord
+  STRIPE_EVENTS = %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :account_id, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+  validates :plan_key, inclusion: { in: Plan.paid.map(&:key) }, allow_nil: true
+
+  class << self
+    def process(event)
+      if event.type.in?(STRIPE_EVENTS)
+        stripe_subscription = event.data.object
+        customer_id = stripe_subscription.customer
+        customer_id = customer_id.id unless customer_id.is_a?(String)
+        find_by(stripe_customer_id: customer_id)&.synchronize(stripe_subscription, event: event)
+      end
+    end
+  end
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def active?
+    status.in?(%w[ active trialing ]) && plan.present?
+  end
+
+  def subscribed?
+    stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ])
+  end
+
+  def checkout_url(plan:, success_url:, cancel_url:)
+    with_lock do
+      if subscribed?
+        portal_url(return_url: cancel_url)
+      elsif checkout_session_expires_at&.future? && checkout_plan_key == plan.key
+        checkout_session_url
+      else
+        expire_checkout_session
+
+        checkout = Stripe::Checkout::Session.create({
+          mode: "subscription",
+          customer: stripe_customer_id,
+          client_reference_id: account_id,
+          line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+          subscription_data: { metadata: { account_id: account_id } },
+          success_url: success_url,
+          cancel_url: cancel_url
+        }, { idempotency_key: "fizzy-checkout-#{id}-#{plan.key}-#{checkout_session_id || "new"}-#{updated_at.to_f}" })
+
+        update! checkout_session_id: checkout.id, checkout_session_url: checkout.url,
+          checkout_session_expires_at: Time.at(checkout.expires_at), checkout_plan_key: plan.key
+        checkout.url
+      end
+    end
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def cancel
+    with_lock do
+      if subscribed?
+        Stripe::Subscription.cancel(stripe_subscription_id)
+        update! status: "canceled"
+      end
+      expire_checkout_session
+      update!(cleared_checkout_attributes) if checkout_session_id
+    end
+  end
+
+  def synchronize(stripe_subscription, event:)
+    with_lock do
+      if newer_stripe_event?(stripe_subscription, event)
+        items = stripe_subscription.items.data
+        plan = Plan.find_by_stripe_price_id(items.first.price.id) if items.one?
+        period_end = stripe_subscription[:current_period_end] || items.filter_map { |item| item[:current_period_end] }.max
+
+        update! stripe_subscription_id: stripe_subscription.id,
+          stripe_created_at: Time.at(stripe_subscription.created),
+          status: event.type == "customer.subscription.deleted" ? "canceled" : stripe_subscription.status,
+          plan_key: plan&.key,
+          current_period_end: timestamp(period_end),
+          cancel_at: timestamp(stripe_subscription[:cancel_at] || (period_end if stripe_subscription[:cancel_at_period_end])),
+          last_stripe_event_id: event.id,
+          last_stripe_event_created_at: Time.at(event.created),
+          **cleared_checkout_attributes
+      end
+    end
+  end
+
+  private
+    def expire_checkout_session
+      if checkout_session_id
+        begin
+          # Expiry time alone cannot tell us whether checkout completed.
+          Stripe::Checkout::Session.expire(checkout_session_id)
+        rescue Stripe::InvalidRequestError => error
+          # Retrying a failed checkout change may encounter the session we already expired.
+          raise error unless Stripe::Checkout::Session.retrieve(checkout_session_id).status == "expired"
+        end
+      end
+    end
+
+    def newer_stripe_event?(stripe_subscription, event)
+      return false if last_stripe_event_id == event.id
+
+      if stripe_subscription_id == stripe_subscription.id
+        # A canceled Stripe subscription cannot be reactivated, even by a delayed event.
+        (!status.in?(%w[ canceled incomplete_expired ]) || event.type == "customer.subscription.deleted") &&
+          (last_stripe_event_created_at.nil? || Time.at(event.created) >= last_stripe_event_created_at)
+      else
+        incoming_created_at = Time.at(stripe_subscription.created)
+        stripe_created_at.nil? || incoming_created_at > stripe_created_at ||
+          (incoming_created_at == stripe_created_at && !subscribed? && event.type != "customer.subscription.deleted" &&
+            (last_stripe_event_created_at.nil? || Time.at(event.created) >= last_stripe_event_created_at))
+      end
+    end
+
+    def timestamp(seconds)
+      Time.at(seconds) if seconds
+    end
+
+    def cleared_checkout_attributes
+      { checkout_session_id: nil, checkout_session_url: nil, checkout_session_expires_at: nil, checkout_plan_key: nil }
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..070d989
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,53 @@
+class Plan
+  class NotConfigured < StandardError; end
+
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  class << self
+    def all
+      ALL
+    end
+
+    def free
+      all.first
+    end
+
+    def paid
+      all.reject(&:free?)
+    end
+
+    def find(key)
+      all.find { |plan| plan.key == key.to_s }
+    end
+
+    def find_by_stripe_price_id(price_id)
+      paid.find { |plan| plan.configured_stripe_price_id == price_id } if price_id.present?
+    end
+  end
+
+  def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:, stripe_price_variable: nil)
+    @key, @name, @price_in_cents = key, name, price_in_cents
+    @card_limit, @storage_limit = card_limit, storage_limit
+    @stripe_price_variable = stripe_price_variable
+  end
+
+  def free?
+    price_in_cents.zero?
+  end
+
+  def stripe_price_id
+    configured_stripe_price_id || raise(NotConfigured, "Stripe price is not configured for #{name}")
+  end
+
+  def configured_stripe_price_id
+    ENV[@stripe_price_variable].presence if @stripe_price_variable
+  end
+
+  ALL = [
+    new(key: "free_v1", name: "Free", price_in_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte),
+    new(key: "monthly_v1", name: "Unlimited", price_in_cents: 2_000, card_limit: nil, storage_limit: 5.gigabytes,
+      stripe_price_variable: "STRIPE_MONTHLY_V1_PRICE_ID"),
+    new(key: "monthly_extra_storage_v1", name: "Unlimited+", price_in_cents: 2_500, card_limit: nil, storage_limit: 500.gigabytes,
+      stripe_price_variable: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  ].each(&:freeze).freeze
+end
