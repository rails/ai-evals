+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts(:initech)
+  end
+
+  test "override and reset usage without changing real data" do
+    original_cards = @account.card_count
+    original_bytes = @account.bytes_used
+    numbering_sequence = @account.cards_count
+
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 1_000, bytes_used: 6.gigabytes } }
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_equal 1_000, @account.reload.card_count
+      assert_equal 6.gigabytes, @account.bytes_used
+      assert_equal numbering_sequence, @account.cards_count
+      assert_equal original_cards, @account.cards.published.count
+
+      follow_redirect!
+      assert_select "button", text: "Reset"
+      assert_select "input[name='overridden_limits[card_count]'][value='1000']"
+
+      assert_difference -> { Account::OverriddenLimits.count }, -1 do
+        delete saas.admin_account_overridden_limits_path(@account)
+      end
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_equal original_cards, @account.reload.card_count
+      assert_equal original_bytes, @account.bytes_used
+    end
+  end
+
+  test "zero and blank values are supported" do
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "0", bytes_used: "" } }
+      assert_response :see_other
+      assert_equal 0, @account.reload.card_count
+      assert_nil @account.overridden_limits.bytes_used
+    end
+  end
+
+  test "invalid values are shown without saving" do
+    @account.override_limits(card_count: 950)
+
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "-1", bytes_used: "invalid" } }
+      assert_response :unprocessable_entity
+      assert_select "[role=alert]", text: /must be greater than or equal to 0/
+      assert_equal 950, @account.reload.card_count
+    end
+  end
+
+  test "only staff can override or reset usage" do
+    logout_and_sign_in_as :mike
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 0 } }
+      assert_response :forbidden
+      assert_nil @account.reload.overridden_limits
+
+      @account.override_limits(card_count: 950)
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :forbidden
+      assert_equal 950, @account.reload.card_count
+    end
+  end
+
+  test "overrides too large for storage are rejected rather than raising a database error" do
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { bytes_used: "9" * 30 } }
+      assert_response :unprocessable_entity
+      assert_nil @account.reload.overridden_limits
+    end
+  end
+end
