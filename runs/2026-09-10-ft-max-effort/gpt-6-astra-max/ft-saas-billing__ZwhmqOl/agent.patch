diff --git a/saas/test/stripe_test_helper.rb b/saas/test/stripe_test_helper.rb
new file mode 100644
index 0000000..f0ed668
--- /dev/null
+++ b/saas/test/stripe_test_helper.rb
@@ -0,0 +1,60 @@
+module StripeTestHelper
+  extend ActiveSupport::Concern
+
+  ENVIRONMENT = {
+    "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited_test",
+    "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_unlimited_plus_test",
+    "STRIPE_WEBHOOK_SECRET" => "whsec_local_billing_tests"
+  }.freeze
+
+  included do
+    setup do
+      @stripe_environment = ENVIRONMENT.to_h { |key, value| [ key, ENV[key] ] }
+      ENV.update(ENVIRONMENT)
+      @stripe_api_key = Stripe.api_key
+      Stripe.api_key = "sk_test_local_billing_tests"
+
+      # Fail closed: no test in this suite can accidentally contact Stripe.
+      stub_request(:any, %r{\Ahttps://api\.stripe\.com/}).to_raise("Unexpected Stripe request")
+    end
+
+    teardown do
+      @stripe_environment.each { |key, value| value ? ENV[key] = value : ENV.delete(key) }
+      Stripe.api_key = @stripe_api_key
+    end
+  end
+
+  private
+    def stub_stripe(method, resource, response, status: 200)
+      stub_request(method, "https://api.stripe.com/v1/#{resource}").to_return(
+        status: status, body: response.to_json, headers: { "Content-Type" => "application/json" }
+      )
+    end
+
+    def stripe_parameters(request)
+      URI.decode_www_form(request.body).to_h
+    end
+
+    def stripe_subscription_data(**attributes)
+      {
+        id: "sub_local", object: "subscription", customer: "cus_local", status: "active", created: 1.day.ago.to_i,
+        cancel_at: nil, cancel_at_period_end: false,
+        items: { object: "list", data: [ {
+          id: "si_local", object: "subscription_item", current_period_end: 1.month.from_now.to_i,
+          price: { id: ENVIRONMENT.fetch("STRIPE_MONTHLY_V1_PRICE_ID"), object: "price" }
+        } ] }
+      }.merge(attributes)
+    end
+
+    def stripe_event(type: "customer.subscription.created", data: stripe_subscription_data, created: Time.current.to_i, id: "evt_#{SecureRandom.hex(8)}")
+      { id: id, object: "event", type: type, api_version: Stripe.api_version, created: created, data: { object: data } }
+    end
+
+    def deliver_stripe_event(event, timestamp: Time.current.to_i, secret: ENVIRONMENT.fetch("STRIPE_WEBHOOK_SECRET"))
+      payload = event.is_a?(String) ? event : event.to_json
+      signature = OpenSSL::HMAC.hexdigest("SHA256", secret, "#{timestamp}.#{payload}")
+      post "/stripe/webhooks", params: payload, headers: {
+        "Content-Type" => "application/json", "Stripe-Signature" => "t=#{timestamp},v1=#{signature}"
+      }
+    end
+end
