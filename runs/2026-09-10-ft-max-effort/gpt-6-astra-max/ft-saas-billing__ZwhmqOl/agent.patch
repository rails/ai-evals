index 0000000..cd37ab5
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,14 @@
+# Stripe authenticates with a signature, not a Fizzy session or an account URL prefix.
+class Stripe::WebhooksController < ActionController::API
+  def create
+    if secret = ENV["STRIPE_WEBHOOK_SECRET"].presence
+      event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], secret)
+      Account::Subscription.process(event)
+      head :ok
+    else
+      head :service_unavailable
+    end
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..5b82a70
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,86 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+
+    set_callback :cancel, :before, :cancel_subscription
+  end
+
+  def billing_plan
+    if subscription&.active?
+      subscription.plan
+    elsif comped?
+      Plan.find("monthly_v1")
+    else
+      Plan.free
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    with_lock do
+      subscription&.cancel
+      self.billing_waiver = Account::BillingWaiver.create_or_find_by!(account: self)
+    end
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def card_count
+    # cards_count is a numbering sequence, including deleted cards and drafts.
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def remaining_cards
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    remaining_cards&.between?(1, NEAR_CARD_LIMIT_THRESHOLD) || false
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def override_limits(attributes)
+    (overridden_limits || build_overridden_limits).update!(attributes)
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy!
+    reload_overridden_limits
+  end
+
+  def subscription_for_checkout
+    with_lock do
+      subscription || create_subscription!(stripe_customer_id: Stripe::Customer.create({
+        name: name, email: owner_email || Current.identity&.email_address, metadata: { account_id: id }
+      }, { idempotency_key: "fizzy-account-#{id}" }).id)
+    end
+  end
+
+  private
+    def cancel_subscription
+      subscription&.cancel
+    end
+end
