@@ -0,0 +1,18 @@
+module Card::PlanLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_card_limit
+      # Serialize checking and publishing so two requests cannot spend the last card.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit?
+          respond_to do |format|
+            format.html { head :forbidden }
+            format.json { render json: { error: "This account has used all its free cards. Upgrade to publish more." }, status: :forbidden }
+          end
+        else
+          yield
+        end
+      end
+    end
+end
