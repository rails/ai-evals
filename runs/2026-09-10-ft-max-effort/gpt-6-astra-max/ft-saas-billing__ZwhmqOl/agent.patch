@@ -0,0 +1,30 @@
+require "test_helper"
+require_relative "../../stripe_test_helper"
+
+class Account::Subscriptions::PortalsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "portal belongs to the current account and returns to its settings" do
+    @account.create_subscription!(stripe_customer_id: "cus_local")
+    stub_stripe(:post, "billing_portal/sessions", { id: "bps_local", object: "billing_portal.session", url: "https://billing.stripe.com/p/session/local" })
+
+    post saas.account_subscription_portal_path, params: { customer: "cus_another", return_url: "https://untrusted.example" }
+
+    assert_redirected_to "https://billing.stripe.com/p/session/local"
+    assert_requested :post, "https://api.stripe.com/v1/billing_portal/sessions" do |request|
+      stripe_parameters(request) == { "customer" => "cus_local", "return_url" => "http://www.example.com#{@account.slug}/account/settings" }
+    end
+  end
+
+  test "accounts without a Stripe customer are shown upgrade options" do
+    post saas.account_subscription_portal_path
+    assert_redirected_to saas.account_subscription_path
+    assert_nil @account.reload.subscription
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..8d6d81f
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,237 @@
+require "test_helper"
+require_relative "../../stripe_test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "the plan page shows the approved prices without calling Stripe" do
+    get saas.account_subscription_path
+    assert_response :success
+    assert_select "h2", text: "Free"
+    assert_select "h2", text: "Unlimited"
+    assert_select "h2", text: "Unlimited+"
+    assert_select "p", text: "$20/month"
+    assert_select "p", text: "$25/month"
+    assert_select "p", text: "1 GB storage"
+    assert_select "p", text: "5 GB storage"
+    assert_select "p", text: "500 GB storage"
+    assert_select "form[action=?]", saas.account_subscription_path, count: 2
+    assert_nil @account.reload.subscription
+  end
+
+  test "checkout uses the chosen server-side price and the current account" do
+    stub_stripe(:post, "customers", { id: "cus_local", object: "customer" })
+    stub_stripe(:post, "checkout/sessions", checkout_response)
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_extra_storage_v1", stripe_customer_id: "cus_someone_else", price: "price_tampered", return_url: "https://untrusted.example" }
+
+    assert_response :see_other
+    assert_redirected_to checkout_response[:url]
+    assert_equal "cus_local", @account.reload.subscription.stripe_customer_id
+    assert_equal Plan.free, @account.billing_plan, "Checkout does not grant paid access before Stripe confirms it"
+    assert_requested :post, "https://api.stripe.com/v1/customers" do |request|
+      parameters = stripe_parameters(request)
+      parameters["metadata[account_id]"] == @account.id && parameters["email"] == "mike@37signals.com" && request.headers["Idempotency-Key"].present?
+    end
+    assert_requested :post, "https://api.stripe.com/v1/checkout/sessions" do |request|
+      parameters = stripe_parameters(request)
+      parameters["mode"] == "subscription" && parameters["customer"] == "cus_local" &&
+        parameters["line_items[0][price]"] == ENVIRONMENT.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID") &&
+        parameters["line_items[0][quantity]"] == "1" && parameters["client_reference_id"] == @account.id &&
+        parameters["subscription_data[metadata][account_id]"] == @account.id &&
+        parameters["success_url"] == "http://www.example.com#{@account.slug}/account/subscription?checkout=complete" &&
+        parameters["cancel_url"] == "http://www.example.com#{@account.slug}/account/subscription"
+    end
+  end
+
+  test "repeated checkout reuses the customer and open session" do
+    customer = stub_stripe(:post, "customers", { id: "cus_local", object: "customer" })
+    checkout = stub_stripe(:post, "checkout/sessions", checkout_response)
+
+    2.times do
+      post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+      assert_redirected_to checkout_response[:url]
+    end
+
+    assert_requested customer, times: 1
+    assert_requested checkout, times: 1
+    assert_equal 1, Account::Subscription.where(account: @account).count
+  end
+
+  test "changing the checkout plan expires the old session" do
+    stub_stripe(:post, "customers", { id: "cus_local", object: "customer" })
+    checkout = stub_stripe(:post, "checkout/sessions", checkout_response)
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+
+    expiration = stub_stripe(:post, "checkout/sessions/cs_local/expire", { id: "cs_local", object: "checkout.session", status: "expired" })
+    post saas.account_subscription_path, params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_redirected_to checkout_response[:url]
+    assert_requested expiration, times: 1
+    assert_requested checkout, times: 2
+    assert_equal "monthly_extra_storage_v1", @account.reload.subscription.checkout_plan_key
+  end
+
+  test "subscribed accounts are sent to the portal instead of a second checkout" do
+    @account.create_subscription!(stripe_customer_id: "cus_local", stripe_subscription_id: "sub_local", status: "active", plan_key: "monthly_v1")
+    portal = stub_stripe(:post, "billing_portal/sessions", { id: "bps_local", object: "billing_portal.session", url: "https://billing.stripe.com/p/session/local" })
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_redirected_to "https://billing.stripe.com/p/session/local"
+    assert_requested portal
+  end
+
+  test "invalid and free plan keys cannot start checkout" do
+    [ nil, "free_v1", "unknown", "price_unlimited_test" ].each do |plan_key|
+      post saas.account_subscription_path, params: { plan_key: plan_key }
+      assert_response :unprocessable_entity
+    end
+    assert_nil @account.reload.subscription
+  end
+
+  test "a successful checkout return alone does not upgrade the account" do
+    get saas.account_subscription_path(checkout: "complete")
+    assert_response :success
+    assert_select "[role=status]", text: /when Stripe confirms/
+    assert_equal Plan.free, @account.reload.billing_plan
+  end
+
+  test "Stripe outages show a recoverable error without granting access" do
+    stub_stripe(:post, "customers", { error: { type: "api_error", message: "Temporarily unavailable" } }, status: 503)
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to saas.account_subscription_path
+    assert_equal "Billing is temporarily unavailable. Please try again.", flash[:alert]
+    assert_equal Plan.free, @account.reload.billing_plan
+    assert_nil @account.subscription
+  end
+
+  test "members cannot view or change billing even if they are staff" do
+    logout_and_sign_in_as :david
+    integration_session.default_url_options[:script_name] = accounts(:"37s").slug
+
+    get saas.account_subscription_path
+    assert_response :forbidden
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+    assert_response :forbidden
+    post saas.account_subscription_portal_path
+    assert_response :forbidden
+
+    get account_settings_path
+    assert_response :success
+    assert_select "#billing", count: 0
+  end
+
+  test "billing cannot be managed across accounts" do
+    post saas.account_subscription_path(script_name: accounts(:"37s").slug), params: { plan_key: "monthly_v1" }, as: :json
+    assert_response :forbidden
+    assert_nil accounts(:"37s").reload.subscription
+  end
+
+  test "comped accounts cannot start a paid subscription" do
+    @account.comp
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+    assert_response :conflict
+    assert_nil @account.reload.subscription
+
+    get saas.account_subscription_path
+    assert_select "form[action=?]", saas.account_subscription_path, count: 0
+  end
+
+  test "missing price configuration fails without contacting Stripe" do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to saas.account_subscription_path
+    assert_equal "Billing is temporarily unavailable. Please try again.", flash[:alert]
+    assert_nil @account.reload.subscription
+  end
+
+  test "paid settings and the subscription page show the current allowance" do
+    @account.create_subscription!(stripe_customer_id: "cus_local", stripe_subscription_id: "sub_local", status: "active", plan_key: "monthly_extra_storage_v1", cancel_at: 1.month.from_now)
+
+    get account_settings_path
+    assert_response :success
+    assert_select "#billing", text: /Unlimited\+.*500 GB/m
+    assert_select "#billing form[action=?]", saas.account_subscription_portal_path
+
+    get saas.account_subscription_path
+    assert_response :success
+    assert_select "p", text: /Your subscription ends/
+    assert_select "form[action=?]", saas.account_subscription_portal_path
+  end
+
+  test "expired checkouts use a new idempotency key" do
+    freeze_time do
+      customer = stub_stripe(:post, "customers", { id: "cus_local", object: "customer" })
+      idempotency_keys = []
+      stub_request(:post, "https://api.stripe.com/v1/checkout/sessions").to_return do |request|
+        idempotency_keys << request.headers["Idempotency-Key"]
+        { body: checkout_response.to_json, headers: { "Content-Type" => "application/json" } }
+      end
+      post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+      assert_response :see_other
+
+      stub_stripe(:post, "checkout/sessions/cs_local/expire", { error: { type: "invalid_request_error", message: "Already expired" } }, status: 400)
+      stub_stripe(:get, "checkout/sessions/cs_local", { id: "cs_local", object: "checkout.session", status: "expired" })
+
+      travel 2.hours
+      post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+      assert_response :see_other
+      assert_equal 2, idempotency_keys.uniq.size
+      assert_requested customer, times: 1
+    end
+  end
+
+  test "checkout can be retried after an earlier expiration succeeded" do
+    stub_stripe(:post, "customers", { id: "cus_local", object: "customer" })
+    stub_stripe(:post, "checkout/sessions", checkout_response)
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+
+    stub_stripe(:post, "checkout/sessions/cs_local/expire", { error: { type: "invalid_request_error", message: "Already expired" } }, status: 400)
+    stub_stripe(:get, "checkout/sessions/cs_local", { id: "cs_local", object: "checkout.session", status: "expired" })
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_extra_storage_v1" }
+    assert_redirected_to checkout_response[:url]
+    assert_equal "monthly_extra_storage_v1", @account.reload.subscription.checkout_plan_key
+  end
+
+  test "completed checkouts cannot be replaced while their webhook is pending" do
+    stub_stripe(:post, "customers", { id: "cus_local", object: "customer" })
+    checkout = stub_stripe(:post, "checkout/sessions", checkout_response)
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+
+    stub_stripe(:post, "checkout/sessions/cs_local/expire", { error: { type: "invalid_request_error", message: "Already completed" } }, status: 400)
+    stub_stripe(:get, "checkout/sessions/cs_local", { id: "cs_local", object: "checkout.session", status: "complete" })
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_extra_storage_v1" }
+    assert_redirected_to saas.account_subscription_path
+    assert_requested checkout, times: 1
+  end
+
+  test "a completed checkout stays protected after its local expiration" do
+    @account.create_subscription!(stripe_customer_id: "cus_local", checkout_session_id: "cs_local", checkout_plan_key: "monthly_v1", checkout_session_url: checkout_response[:url], checkout_session_expires_at: 1.day.ago)
+    stub_stripe(:post, "checkout/sessions/cs_local/expire", { error: { type: "invalid_request_error", message: "Already completed" } }, status: 400)
+    stub_stripe(:get, "checkout/sessions/cs_local", { id: "cs_local", object: "checkout.session", status: "complete" })
+
+    post saas.account_subscription_path, params: { plan_key: "monthly_v1" }
+    assert_redirected_to saas.account_subscription_path
+    assert_equal "Billing is temporarily unavailable. Please try again.", flash[:alert]
+    assert_not_requested :post, "https://api.stripe.com/v1/checkout/sessions"
+  end
+
+  private
+    def checkout_response
+      { id: "cs_local", object: "checkout.session", url: "https://checkout.stripe.com/c/pay/local", expires_at: 1.hour.from_now.to_i }
+    end
+end
