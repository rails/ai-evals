+# Direct uploads are identity-scoped: an importer need not belong to any account.
+class Account::Imports::UploadsController < ApplicationController
+  disallow_account_scope
+  rescue_from Account::DataTransfer::Error, with: ->(error) { render json: { error: error.message }, status: :unprocessable_entity }
+
+  def create
+    upload = Account::Import::Upload.create(identity: Current.identity, attributes: blob_params, multipart: params[:multipart] == true)
+    blob = upload.blob
+
+    if upload.multipart?
+      render json: { signed_id: blob.signed_id, multipart: {
+        part_size: upload.part_size,
+        parts_url: account_imports_upload_parts_url(blob.signed_id, script_name: nil),
+        completion_url: account_imports_upload_completion_url(blob.signed_id, script_name: nil),
+        abort_url: account_imports_upload_url(blob.signed_id, script_name: nil)
+      } }
+    else
+      ActiveStorage::Current.set(url_options: { protocol: request.protocol, host: request.host, port: request.port }) do
+        render json: blob.as_json(root: false, methods: :signed_id).merge(direct_upload: {
+          url: blob.service_url_for_direct_upload, headers: blob.service_headers_for_direct_upload
+        })
+      end
+    end
+  end
+
+  def destroy
+    Account::Import::Upload.find(Current.identity, params[:id]).destroy
+    head :no_content
+  end
+
+  private
+    def blob_params
+      params.expect(blob: %i[ filename byte_size checksum content_type ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
