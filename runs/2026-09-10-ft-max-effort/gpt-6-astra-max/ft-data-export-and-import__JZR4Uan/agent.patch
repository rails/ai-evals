@@ -0,0 +1,67 @@
+require "test_helper"
+require "active_storage/service/s3_service"
+
+class Account::Import::UploadTest < ActiveSupport::TestCase
+  setup do
+    @original_service = ActiveStorage::Blob.service
+    @service = ActiveStorage::Service::S3Service.new(bucket: "fizzy-test", region: "us-east-1", stub_responses: true)
+    @service.name = "transfer_s3"
+    ActiveStorage::Blob.service = @service
+    ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(@service)
+    @service.client.client.stub_responses(:create_multipart_upload, upload_id: "multipart-id")
+  end
+
+  teardown do
+    ActiveStorage::Blob.service = @original_service
+  end
+
+  test "a large upload uses S3 multipart with bounded part sizes" do
+    upload = create_upload(600.gigabytes)
+    assert upload.multipart?
+    assert_equal 100.megabytes, upload.part_size
+    assert_nil upload.blob.checksum
+    assert upload.blob.composed
+    assert_includes upload.part_url(1), "partNumber=1"
+    assert_includes upload.part_url(6144), "uploadId=multipart-id"
+    assert_raises(Account::DataTransfer::Error) { upload.part_url(0) }
+    assert_raises(Account::DataTransfer::Error) { upload.part_url(6145) }
+  end
+
+  test "completion submits every part and makes the blob importable" do
+    upload = create_upload(101.megabytes)
+    parts = [ { part_number: 1, etag: "first" }, { part_number: 2, etag: "second" } ]
+    upload.complete(parts)
+    assert_not upload.multipart?
+    request = @service.client.client.api_requests.find { |request| request[:operation_name] == :complete_multipart_upload }
+    assert_equal parts, request[:params].dig(:multipart_upload, :parts)
+    assert_equal upload.blob.key, request[:params][:key]
+  end
+
+  test "incomplete multipart uploads cannot be completed" do
+    upload = create_upload(101.megabytes)
+    assert_raises(Account::DataTransfer::Error) { upload.complete([ { part_number: 1, etag: "first" } ]) }
+    assert upload.multipart?
+  end
+
+  test "an upload can only be found by its initiating identity" do
+    upload = create_upload(101.megabytes)
+    assert_equal upload.blob, Account::Import::Upload.find(identities(:kevin), upload.blob.signed_id).blob
+    assert_raises(ActiveRecord::RecordNotFound) { Account::Import::Upload.find(identities(:david), upload.blob.signed_id) }
+  end
+
+  test "abandoned uploads are aborted and purged" do
+    upload = create_upload(101.megabytes)
+    upload.blob.update!(created_at: 8.days.ago)
+    assert_difference -> { ActiveStorage::Blob.count }, -1 do
+      Account::Import::Upload.cleanup
+    end
+    assert @service.client.client.api_requests.any? { |request| request[:operation_name] == :abort_multipart_upload }
+  end
+
+  private
+    def create_upload(size)
+      Account::Import::Upload.create(identity: identities(:kevin), multipart: true, attributes: {
+        filename: "account.zip", byte_size: size, checksum: nil, content_type: "application/zip"
+      })
+    end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
