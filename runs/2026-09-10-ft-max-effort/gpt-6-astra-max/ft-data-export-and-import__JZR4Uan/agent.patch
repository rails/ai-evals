@@ -0,0 +1,91 @@
+require "test_helper"
+require "active_storage/service/s3_service"
+
+class ZipFile::S3Test < ActiveSupport::TestCase
+  include DataTransferTestHelper
+
+  setup do
+    @original_service = ActiveStorage::Blob.service
+    @service = ActiveStorage::Service::S3Service.new(bucket: "fizzy-test", region: "us-east-1", stub_responses: true)
+    @service.name = "transfer_s3"
+    ActiveStorage::Blob.service = @service
+    ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(@service)
+  end
+
+  teardown do
+    ActiveStorage::Blob.service = @original_service
+  end
+
+  test "ZIP creation streams to S3 with the correct service, size and checksum" do
+    output = StringIO.new("".b)
+    @service.expects(:upload_stream).with(has_entries(content_type: "application/zip", part_size: 100.megabytes)).yields(output)
+    Tempfile.expects(:create).never
+    export = Export.create!(account: Current.account, user: users(:jason), kind: :account)
+    ZipFile.create_for(export.file, filename: "account.zip") { |zip| zip.add_file("example.txt", "S3 streaming") }
+    blob = export.file.blob
+    assert_equal @service, blob.service
+    assert_equal "transfer_s3", blob.service_name
+    assert_equal output.string.bytesize, blob.byte_size
+    assert_equal Digest::MD5.base64digest(output.string), blob.checksum
+    output.rewind
+    assert_equal "S3 streaming", ZipFile::Reader.new(output).read("example.txt")
+  end
+
+  test "failed writes remove the incomplete blob and object" do
+    output = StringIO.new("".b)
+    @service.expects(:upload_stream).yields(output)
+    @service.expects(:delete).once
+    export = Export.create!(account: Current.account, user: users(:jason), kind: :account)
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      assert_raises(RuntimeError) do
+        ZipFile.create_for(export.file, filename: "account.zip") { raise "interrupted" }
+      end
+    end
+    assert_not export.file.attached?
+  end
+
+  test "file restoration streams from a disk archive to S3 and adopts its checksum algorithm" do
+    ActiveStorage::Blob.service = @original_service
+    ActiveStorage::Blob.services.stubs(:fetch).with(@original_service.name.to_s).returns(@original_service)
+    Current.user = users(:jason)
+    add_transfer_attachments
+    import = create_account_import(create_account_export)
+
+    @service = ActiveStorage::Service::S3Service.new(bucket: "fizzy-test", region: "us-east-1", stub_responses: true, default_digest_type: :sha256)
+    @service.name = "transfer_s3"
+    ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(@service)
+    ActiveStorage::Blob.service = @service
+    files = {}
+    @service.define_singleton_method(:upload_stream) do |key:, **options, &block|
+      io = StringIO.new("".b)
+      block.call(io)
+      files[key] = io.string
+    end
+    @service.define_singleton_method(:download) do |key, &block|
+      block ? block.call(files.fetch(key)) : files.fetch(key)
+    end
+    Tempfile.expects(:create).never
+
+    import.import_now
+    assert import.completed?, import.failure_reason
+    file = import.account.cards.find_by!(number: @card.number).description.embeds.sole
+    assert_equal "transfer_s3", file.service_name
+    assert_equal "sha256:#{Digest::SHA256.base64digest('Design notes')}", file.checksum
+    file.open { |io| assert_equal "Design notes", io.read }
+    assert files.keys.all? { |key| key.start_with?("fizzy-imports/#{import.id}/") }
+  end
+
+  test "ZIP exports use the destination service's configured digest" do
+    @service = ActiveStorage::Service::S3Service.new(bucket: "fizzy-test", region: "us-east-1", stub_responses: true, default_digest_type: :sha256)
+    @service.name = "transfer_s3"
+    ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(@service)
+    ActiveStorage::Blob.service = @service
+    output = StringIO.new("".b)
+    @service.expects(:upload_stream).yields(output)
+    @service.define_singleton_method(:download) { |key, &block| block.call(output.string) }
+    export = Export.create!(account: Current.account, user: users(:jason), kind: :account)
+    ZipFile.create_for(export.file, filename: "account.zip") { |zip| zip.add_file("test", "SHA-256") }
+    assert_equal "sha256:#{Digest::SHA256.base64digest(output.string)}", export.file.checksum
+    export.file.open { |io| assert_equal output.string, io.read }
+  end
+end
