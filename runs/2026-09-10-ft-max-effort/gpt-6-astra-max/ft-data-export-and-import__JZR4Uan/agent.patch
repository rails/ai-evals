index 0000000..f8b1251
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,44 @@
+# Seekable access through Active Storage's range API, for both Disk and S3.
+# In particular, never download a 500GB archive to parse its central directory.
+class ZipFile::BlobIO
+  MAX_READ_SIZE = 128.megabytes
+  BUFFER_SIZE = 1.megabyte
+
+  attr_reader :pos
+  alias_method :tell, :pos
+
+  delegate :byte_size, to: :@blob
+  alias_method :size, :byte_size
+
+  def initialize(blob)
+    @blob = blob
+    @pos = 0
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    unless mode == IO::SEEK_SET && offset.between?(0, size)
+      raise ZipFile::Error, "Invalid ZIP offset"
+    end
+
+    @pos = offset
+    0
+  end
+
+  def read(length = nil)
+    length ||= size - pos
+    raise ZipFile::Error, "ZIP directory is too large" unless length.between?(0, MAX_READ_SIZE)
+    return "".b if length.zero?
+    return if pos == size
+
+    length = [ length, size - pos ].min
+    unless @buffer && pos >= @buffer_start && pos + length <= @buffer_start + @buffer.bytesize
+      @buffer_start = pos
+      @buffer = @blob.download_chunk(pos...[ pos + [ length, BUFFER_SIZE ].max, size ].min)
+    end
+
+    @buffer.byteslice(pos - @buffer_start, length).tap do |data|
+      raise ZipFile::Error, "The ZIP file is truncated" unless data && data.bytesize == length
+      @pos += data.bytesize
+    end
+  end
+end
diff --git a/app/models/zip_file/checksum.rb b/app/models/zip_file/checksum.rb
