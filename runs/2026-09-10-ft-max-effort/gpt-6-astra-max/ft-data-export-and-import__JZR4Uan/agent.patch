diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..f004284
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,73 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself)
+
+  validate :archive_is_attached, on: :create
+  after_create_commit :import_later
+
+  def import_later
+    Current.without_account { Account::ImportJob.perform_later(self) }
+  end
+
+  def import_now
+    Current.without_account do
+      with_lock { restore_account if pending? }
+      file.purge if file.attached?
+
+      with_lock do
+        if !pending? && notified_at.nil?
+          AccountImportMailer.public_send(status, self).deliver_later
+          update! notified_at: Time.current
+        end
+      end
+    end
+  end
+
+  def accessible_to?(user)
+    false
+  end
+
+  private
+    def archive_is_attached
+      if !file.attached?
+        errors.add(:file, "is required")
+      elsif !file.byte_size.positive? || file.filename.extension_without_delimiter.downcase != "zip"
+        errors.add(:file, "must be a ZIP account export")
+      end
+    end
+
+    def restore_account
+      importer = Account::DataTransfer::Importer.new(self)
+      importer.cleanup
+
+      transaction(requires_new: true) do
+        account = importer.import
+        update! account: account, status: :completed, completed_at: Time.current
+      end
+    rescue => error
+      importer.cleanup(error: error)
+      reload
+      Rails.error.report(error)
+      update! status: :failed, failure_reason: failure_message(error)
+    end
+
+    def failure_message(error)
+      case error
+      when Account::DataTransfer::Error, ZipFile::Error
+        error.message
+      when ActiveStorage::FileNotFoundError
+        "The uploaded archive could not be found in storage. Please upload it again."
+      when ActiveRecord::RecordNotUnique
+        "The archive contains duplicate records."
+      when ActiveRecord::NotNullViolation, KeyError
+        "The archive is missing required record fields."
+      when ActiveRecord::RecordInvalid
+        "An imported record is invalid: #{error.record.errors.full_messages.to_sentence}"
+      else
+        "The archive could not be restored (#{error.class.name.demodulize}). Please try again or contact support."
+      end
+    end
+end
diff --git a/app/models/account/import/upload.rb b/app/models/account/import/upload.rb
new file mode 100644
index 0000000..42f624b
--- /dev/null
+++ b/app/models/account/import/upload.rb
@@ -0,0 +1,90 @@
+class Account::Import::Upload
+  PART_SIZE = 100.megabytes
+  MAXIMUM_PARTS = 10_000
+
+  attr_reader :blob
+
+  class << self
+    def create(identity:, attributes:, multipart: false)
+      unless attributes[:filename].to_s.downcase.end_with?(".zip") && attributes[:byte_size].to_i.positive?
+        raise Account::DataTransfer::Error, "Choose a ZIP account export"
+      end
+
+      # Large archives are multipart/composed objects. Their ZIP entries are
+      # verified individually during import, without a second full-file read.
+      metadata = { import_identity_id: identity.id }
+      metadata[:composed] = true if multipart && attributes[:checksum].blank?
+      blob = Current.without_account { ActiveStorage::Blob.create!(**attributes, account: nil, metadata: metadata) }
+      new(blob).tap { |upload| upload.start_multipart if multipart }
+    rescue
+      blob&.purge
+      raise
+    end
+
+    def find(identity, signed_id)
+      blob = ActiveStorage::Blob.find_signed!(signed_id)
+      if blob.account_id.nil? && blob.metadata["import_identity_id"] == identity.id && blob.attachments.none?
+        new(blob)
+      else
+        raise ActiveRecord::RecordNotFound
+      end
+    end
+
+    def cleanup
+      ActiveStorage::Blob.unattached.where(account: nil, created_at: ..1.week.ago).find_each do |blob|
+        if blob.metadata["import_identity_id"] && (blob.metadata["import_upload_touched_at"].nil? || Time.iso8601(blob.metadata["import_upload_touched_at"]) < 1.week.ago)
+          new(blob).destroy
+        end
+      end
+    end
+  end
+
+  def initialize(blob)
+    @blob = blob
+  end
+
+  def start_multipart
+    if defined?(ActiveStorage::Service::S3Service) && blob.service.is_a?(ActiveStorage::Service::S3Service)
+      upload = object.initiate_multipart_upload(content_type: blob.content_type, **blob.service.upload_options)
+      blob.update!(metadata: blob.metadata.merge("multipart_upload_id" => upload.id))
+    end
+  end
+
+  def multipart?
+    blob.metadata["multipart_upload_id"].present?
+  end
+
+  def part_size
+    [ PART_SIZE, blob.byte_size.fdiv(MAXIMUM_PARTS).ceil ].max
+  end
+
+  def part_url(number)
+    unless multipart? && number.between?(1, part_count)
+      raise Account::DataTransfer::Error, "Invalid upload part"
+    end
+    blob.update!(metadata: blob.metadata.merge("import_upload_touched_at" => Time.current.iso8601))
+    object.presigned_url(:upload_part, upload_id: blob.metadata.fetch("multipart_upload_id"), part_number: number, expires_in: 1.hour.to_i)
+  end
+
+  def complete(parts)
+    unless multipart? && parts.map { |part| part.fetch(:part_number) } == (1..part_count).to_a && parts.all? { |part| part[:etag].present? }
+      raise Account::DataTransfer::Error, "The upload is incomplete"
+    end
+    object.multipart_upload(blob.metadata.fetch("multipart_upload_id")).complete(multipart_upload: { parts: parts })
+    blob.update!(metadata: blob.metadata.except("multipart_upload_id"))
+  end
+
+  def destroy
+    object.multipart_upload(blob.metadata.fetch("multipart_upload_id")).abort if multipart?
+    blob.purge
+  end
+
+  private
+    def object
+      blob.service.send(:object_for, blob.key)
+    end
+
+    def part_count
+      blob.byte_size.fdiv(part_size).ceil
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..fdf224c
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,88 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), suffix: :export
+  enum :status, %w[ pending completed failed ].index_by(&:itself)
+
+  validates :kind, presence: true
+  validate :requester_can_export, on: :create
+
+  before_validation -> { self.email_address ||= user&.identity&.email_address }, on: :create
+  validates :email_address, presence: true
+
+  after_create_commit :generate_later
+
+  scope :expired, -> { where(expires_at: ..Time.current) }
+
+  def self.cleanup
+    expired.find_each(&:destroy!)
+  end
+
+  def generate_later
+    Current.with_account(account) { ExportJob.perform_later(self) }
+  end
+
+  def generate_now
+    with_lock { generate_archive if pending? }
+
+    with_lock do
+      if !pending? && notified_at.nil?
+        ExportMailer.public_send(status, self).deliver_later
+        update! notified_at: Time.current
+      end
+    end
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at) if downloadable?
+  end
+
+  def downloadable?
+    completed? && file.attached? && expires_at&.future? && requester_allowed?
+  end
+
+  # Archives are only served through their expiring download tokens, never via
+  # permanent Active Storage signed IDs.
+  def accessible_to?(user)
+    false
+  end
+
+  private
+    def requester_can_export
+      unless requester_allowed?
+        errors.add(:user, "cannot request this export")
+      end
+    end
+
+    def requester_allowed?
+      user&.active? && user.account == account && account.active? && user.identity.present? && (!account_export? || user.admin?)
+    end
+
+    def generate_archive
+      transaction(requires_new: true) do
+        user.reload
+        raise Account::DataTransfer::Error, "You no longer have permission to export this account" unless valid?(:create)
+
+        ZipFile.create_for(file, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+          if account_export?
+            Account::DataTransfer::Manifest.new(account).export_to(zip)
+            Export::Cards.new(account.cards).export_to(zip)
+          else
+            cards = user.accessible_cards
+            visible_cards = cards.published.or(cards.drafted.where(creator: user))
+            Export::Cards.new(visible_cards).export_to(zip)
+            zip.add_file("manifest.json", { format: "fizzy", version: Account::DataTransfer::VERSION, type: "cards" }.to_json)
+          end
+        end
+
+        update! status: :completed, completed_at: Time.current, expires_at: 1.day.from_now
+      end
+    rescue => error
+      file.blob&.purge
+      reload
+      Rails.error.report(error)
+      update! status: :failed, failure_reason: "The export could not be created. Please try again.", expires_at: 1.day.from_now
+    end
+end
diff --git a/app/models/export/cards.rb b/app/models/export/cards.rb
new file mode 100644
index 0000000..d63ef5d
--- /dev/null
+++ b/app/models/export/cards.rb
@@ -0,0 +1,72 @@
+class Export::Cards
+  def initialize(cards)
+    @cards = cards
+  end
+
+  def export_to(zip)
+    @cards.preloaded.find_each(batch_size: 100) do |card|
+      write_files(zip, card)
+      card.comments.with_rich_text_body_and_embeds.find_each { |comment| write_files(zip, comment) }
+
+      zip.add_file("cards/#{card.number}.json") do |sink|
+        sink.write card_attributes(card).to_json.delete_suffix("}")
+        sink.write ',"comments":['
+        first = true
+        card.comments.with_rich_text_body_and_embeds.includes(:creator).find_each do |comment|
+          sink.write "," unless first
+          sink.write comment_attributes(comment).to_json
+          first = false
+        end
+        sink.write "]}"
+      end
+    end
+  end
+
+  private
+    def write_files(zip, record)
+      blobs_for(record).each do |blob|
+        path = Account::DataTransfer.file_path(blob)
+        unless zip.exists?(path)
+          zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+        end
+      end
+    end
+
+    def blobs_for(record)
+      blobs = record.attachments.map(&:blob)
+      blobs << record.image.blob if record.is_a?(Card) && record.image.attached?
+      blobs.uniq(&:id)
+    end
+
+    def card_attributes(card)
+      card.attributes.except("account_id").merge(
+        "board" => card.board.as_json(only: %i[ id name ]),
+        "creator" => person(card.creator),
+        "description" => Account::DataTransfer::RichText.dump(card.description.body),
+        "assignees" => card.assignees.map { |user| person(user) },
+        "tags" => card.tags.pluck(:title),
+        "steps" => card.steps.as_json(except: %i[ account_id ]),
+        "closed" => card.closed?,
+        "attachments" => files(card)
+      )
+    end
+
+    def comment_attributes(comment)
+      comment.attributes.except("account_id").merge(
+        "creator" => person(comment.creator),
+        "body" => Account::DataTransfer::RichText.dump(comment.body.body),
+        "attachments" => files(comment)
+      )
+    end
+
+    def person(user)
+      user.as_json(only: %i[ id name ])
+    end
+
+    def files(record)
+      blobs_for(record).map do |blob|
+        { id: blob.id, filename: blob.filename.to_s, content_type: blob.content_type,
+          byte_size: blob.byte_size, path: Account::DataTransfer.file_path(blob) }
+      end
+    end
+end
