+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include DataTransferTestHelper
+
+  setup do
+    Current.user = users(:jason)
+  end
+
+  test "account archive round trips into a new account with people and files" do
+    add_transfer_attachments
+    source = Current.account
+    export = create_account_export
+    import = create_account_import(export)
+
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_emails 1 do
+        import.import_now
+        assert import.completed?, import.failure_reason
+      end
+    end
+
+    account = import.account
+    assert_not_equal source.id, account.id
+    assert_not_equal source.external_account_id, account.external_account_id
+    assert_equal source.name, account.name
+    assert_equal source.boards.count, account.boards.count
+    assert_equal source.cards.count, account.cards.count
+    assert_equal source.users.count, account.users.count
+    assert_equal users(:kevin).identity, account.users.owner.sole.identity
+    assert users(:jason).reload.owner?, "the source owner is not changed"
+    assert_equal account.boards.count, account.users.owner.sole.boards.count
+    assert_not import.file.attached?
+
+    card = account.cards.find_by!(number: @card.number)
+    assert_not_equal @card.id, card.id
+    assert_equal @card.created_at, card.created_at
+    assert_equal @card.title, card.title
+    assert_equal @card.creator.identity, card.creator.identity
+    assert_equal @card.comments.count, card.comments.count
+    assert_equal @card.image.download, card.image.download
+    assert_not_equal @card.image.blob.key, card.image.blob.key
+    assert_equal "Design notes", card.description.embeds.sole.download
+    assert_equal "Comment attachment", card.comments.detect { |comment| comment.body.to_plain_text.include?("Portable comment") }.body.embeds.sole.download
+    assert_equal [ account.id ], ActiveStorage::Blob.where(id: card.description.embeds.blobs.pluck(:id)).distinct.pluck(:account_id)
+    assert_includes card.description.body.attachables, account.users.find_by!(identity: identities(:david))
+    assert_includes card.description.body.to_html, account.slug
+    assert Search::Record.for(account.id).exists?(account_id: account.id, searchable_id: card.id)
+    assert_operator account.bytes_used, :>, 0
+  end
+
+  test "importing as a new person makes them the owner without losing the original people" do
+    export = create_account_export
+    identity = Identity.create!(email_address: "new-owner@example.com")
+    import = create_account_import(export, identity: identity)
+    import.import_now
+    assert import.completed?, import.failure_reason
+    assert_equal Current.account.users.count + 1, import.account.users.count
+    assert_equal identity, import.account.users.owner.sole.identity
+    assert_equal import.account.boards.count, import.account.users.owner.sole.boards.count
+  end
+
+  test "a failure after file restoration rolls back all account data and removes uploaded files" do
+    add_transfer_attachments
+    export = create_account_export
+    import = create_account_import(export)
+    Account::DataTransfer::Importer.any_instance.stubs(:rebuild_derived_data).raises(Account::DataTransfer::Error, "Invalid account data")
+
+    counts = [ Account, User, Identity, Board, Card, Comment, Event, ActionText::RichText, Storage::Entry, Storage::Total ].map { |model| -> { model.count } }
+    assert_no_difference counts do
+      assert_enqueued_emails 1 do
+        import.import_now
+      end
+    end
+
+    assert import.failed?
+    assert_equal "Invalid account data", import.failure_reason
+    assert_nil import.account
+    assert_not import.file.attached?
+    assert_empty Dir.glob(ActiveStorage::Blob.service.send(:path_for, "fizzy-imports/#{import.id}/**/*"))
+  end
+
+  test "malformed archives fail with a reason and do not create an account" do
+    import = Current.without_account do
+      Account::Import.create!(identity: identities(:kevin), file: {
+        io: StringIO.new("not a ZIP"), filename: "bad.zip", content_type: "application/zip"
+      })
+    end
+    assert_no_difference -> { Account.count } do
+      import.import_now
+    end
+    assert import.failed?
+    assert_match /ZIP/, import.failure_reason
+    assert_not import.file.attached?
+  end
+
+  test "jobs can be retried without creating a second account or sending another email" do
+    import = create_account_import(create_account_export)
+    import.import_now
+    assert import.completed?, import.failure_reason
+
+    assert_no_difference -> { Account.count } do
+      assert_no_enqueued_emails { import.import_now }
+    end
+  end
+
+  test "a personal cards export is not an account backup" do
+    export = Export.create!(account: Current.account, user: users(:david), kind: :cards)
+    export.generate_now
+    import = create_account_import(export)
+    assert_no_difference -> { Account.count } do
+      import.import_now
+    end
+    assert import.failed?
+    assert_match /account export/, import.failure_reason
+  end
+
+  test "a missing record makes the entire archive incomplete" do
+    export = create_account_export
+    rewrite_archive(export) { |path, content| content unless path == "records/cards/#{cards(:logo).id}.json" }
+    import = create_account_import(export)
+    assert_no_difference -> { Account.count } do
+      import.import_now
+    end
+    assert import.failed?
+    assert_match /incomplete/, import.failure_reason
+  end
+
+  test "references cannot escape the archive into an existing account" do
+    export = create_account_export
+    rewrite_archive(export) do |path, content|
+      if path == "records/cards/#{cards(:logo).id}.json"
+        JSON.parse(content).merge("board_id" => boards(:miltons_wish_list).id).to_json
+      else
+        content
+      end
+    end
+    import = create_account_import(export)
+    assert_no_difference [ -> { Account.count }, -> { Card.count }, -> { Identity.count } ] do
+      import.import_now
+    end
+    assert import.failed?
+    assert_match /missing a referenced Board/i, import.failure_reason
+  end
+
+  test "file checksum mismatches roll back every record and uploaded file" do
+    add_transfer_attachments
+    export = create_account_export
+    rewrite_archive(export) do |path, content|
+      path == Account::DataTransfer.file_path(@comment_blob) ? "Corrupted contents" : content
+    end
+    import = create_account_import(export)
+    assert_no_difference [ -> { Account.count }, -> { Card.count }, -> { User.count } ] do
+      import.import_now
+    end
+    assert import.failed?
+    assert_match /comment.txt.*corrupt/, import.failure_reason
+    assert_nil import.account
+    assert_empty Dir.glob(ActiveStorage::Blob.service.send(:path_for, "fizzy-imports/#{import.id}/**/*"))
+  end
+
+  test "import works when source signatures can no longer be verified" do
+    add_transfer_attachments
+    import = create_account_import(create_account_export)
+    original_verifier = SignedGlobalID.verifier
+    SignedGlobalID.verifier = ActiveSupport::MessageVerifier.new("another-fizzy-instance")
+    import.import_now
+    assert import.completed?, import.failure_reason
+    assert_equal "Design notes", import.account.cards.find_by!(number: @card.number).description.embeds.sole.download
+  ensure
+    SignedGlobalID.verifier = original_verifier if original_verifier
+  end
+
+  test "a transient notification error can be retried without reimporting" do
+    import = create_account_import(create_account_export)
+    AccountImportMailer.expects(:completed).raises("queue unavailable").once
+    assert_raises(RuntimeError) { import.import_now }
+    assert import.completed?
+    assert_nil import.notified_at
+    AccountImportMailer.unstub(:completed)
+    assert_no_difference -> { Account.count } do
+      assert_enqueued_emails 1 do
+        import.import_now
+      end
+    end
+    assert import.notified_at
+  end
+
+  test "publications get new keys and saved filter associations are remapped" do
+    board = boards(:writebook)
+    board.publish
+    filter = Filter.create!(creator: users(:david), boards: [ board ], assignees: [ users(:kevin) ], card_ids: [ cards(:logo).id ])
+    import = create_account_import(create_account_export)
+    import.import_now
+    assert import.completed?, import.failure_reason
+
+    restored_board = import.account.boards.find_by!(name: board.name)
+    assert_not_equal board.publication.key, restored_board.publication.key
+    restored_filter = Filter.find_by!(account: import.account, created_at: filter.created_at)
+    assert_equal [ restored_board ], restored_filter.boards.to_a
+    assert_equal [ import.account.users.find_by!(identity: identities(:kevin)) ], restored_filter.assignees.to_a
+    assert_equal [ import.account.cards.find_by!(number: cards(:logo).number).id ], restored_filter.card_ids
+    assert_equal Filter.digest_params(restored_filter.as_params), restored_filter.params_digest
+  end
+
+  test "an empty account can be restored" do
+    source = Account.create_with_owner(account: { name: "Empty" }, owner: { name: "Kevin", identity: identities(:kevin) })
+    export = create_account_export(account: source, user: source.users.owner.sole)
+    import = create_account_import(export)
+    import.import_now
+    assert import.completed?, import.failure_reason
+    assert_empty import.account.cards
+    assert_empty import.account.boards
+    assert_equal "Empty", import.account.name
+    assert import.account.entropy
+  end
+
+  test "imports provision a tenant using the normal signup integration" do
+    import = create_account_import(create_account_export)
+    Signup.any_instance.expects(:create_tenant).returns(987654321)
+    import.import_now
+    assert import.completed?, import.failure_reason
+    assert_equal 987654321, import.account.external_account_id
+  end
+
+  test "failed imports cancel external tenant provisioning" do
+    import = create_account_import(create_account_export)
+    Signup.any_instance.expects(:create_tenant).returns(987654321)
+    Account::DataTransfer::Importer.any_instance.stubs(:rebuild_derived_data).raises(Account::DataTransfer::Error, "Failed restoration")
+    Signup.any_instance.expects(:handle_account_creation_error).with { |error| error.message == "Failed restoration" }
+    assert_no_difference -> { Account.count } do
+      import.import_now
+    end
+    assert import.failed?
+  end
+
+  test "new identities and all attachment records are removed on rollback" do
+    add_transfer_attachments
+    export = create_account_export
+    rewrite_archive(export) do |path, content|
+      if path == "records/users/#{users(:david).id}.json"
+        JSON.parse(content).merge("email_address" => "new-person-from-another-instance@example.com").to_json
+      else
+        content
+      end
+    end
+    import = create_account_import(export)
+    original_blob_count = ActiveStorage::Blob.count
+    original_attachment_count = ActiveStorage::Attachment.count
+    Account::DataTransfer::Importer.any_instance.stubs(:rebuild_derived_data).raises(Account::DataTransfer::Error, "Late failure")
+    assert_no_difference -> { Identity.count } do
+      import.import_now
+    end
+    assert import.failed?
+    assert_equal original_blob_count - 1, ActiveStorage::Blob.count, "only the source upload is removed"
+    assert_equal original_attachment_count - 1, ActiveStorage::Attachment.count
+  end
+
+  test "avatars and their variants survive a round trip" do
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    thumbnail = users(:david).avatar_thumbnail.processed
+    import = create_account_import(create_account_export)
+    import.import_now
+    assert import.completed?, import.failure_reason
+    user = import.account.users.find_by!(identity: identities(:david))
+    assert_equal users(:david).avatar.download, user.avatar.download
+    assert_equal thumbnail.download, user.avatar_thumbnail.processed.download
+    assert_equal import.account.id, user.avatar.blob.account_id
+  end
+
+  test "SHA-256 file checksums can be verified and restored to disk" do
+    add_transfer_attachments
+    export = create_account_export
+    rewrite_archive(export) do |path, content|
+      if path == "records/active_storage_blobs/#{@file_blob.id}.json"
+        JSON.parse(content).merge("checksum" => "sha256:#{Digest::SHA256.base64digest('Design notes')}").to_json
+      else
+        content
+      end
+    end
+    import = create_account_import(export)
+    import.import_now
+    assert import.completed?, import.failure_reason
+    file = import.account.cards.find_by!(number: @card.number).description.embeds.sole
+    assert_equal Digest::MD5.base64digest("Design notes"), file.checksum
+    file.open { |io| assert_equal "Design notes", io.read }
+  end
+
+  test "international filenames survive the archive round trip" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("International"), filename: "résumé-日本語.txt", content_type: "text/plain")
+    cards(:logo).update!(description: ActionText::Content.new("<p>File</p>").append_attachables([ blob ]))
+    import = create_account_import(create_account_export)
+    import.import_now
+    assert import.completed?, import.failure_reason
+    file = import.account.cards.find_by!(number: cards(:logo).number).description.embeds.sole
+    assert_equal "résumé-日本語.txt", file.filename.to_s
+    assert_equal "International", file.download
+  end
+
+  test "unrecognized rich-text fields fail without keeping an account" do
+    cards(:logo).update!(description: "For export")
+    export = create_account_export
+    path_to_change = "records/action_text_rich_texts/#{cards(:logo).rich_text_description.id}.json"
+    rewrite_archive(export) { |path, content| path == path_to_change ? JSON.parse(content).merge("name" => "unrecognized").to_json : content }
+    import = create_account_import(export)
+    assert_no_difference -> { Account.count } do
+      import.import_now
+    end
+    assert import.failed?
+    assert_equal "Unknown rich-text field in the archive", import.failure_reason
+  end
+end
