index 0000000..d254c0b
--- /dev/null
+++ b/app/models/zip_file/checksum.rb
@@ -0,0 +1,24 @@
+class ZipFile::Checksum
+  ALGORITHMS = { "md5" => Digest::MD5, "sha256" => Digest::SHA256 }.freeze
+
+  attr_reader :algorithm
+
+  def self.for_service(service)
+    new(service.respond_to?(:default_digest_type) ? service.default_digest_type : :md5)
+  end
+
+  def self.from_encoded(checksum)
+    new(checksum.include?(":") ? checksum.split(":", 2).first : :md5)
+  end
+
+  def initialize(algorithm = :md5)
+    @algorithm = algorithm.to_s
+    @digest = ALGORITHMS.fetch(@algorithm) { raise ZipFile::Error, "Unsupported attachment checksum algorithm" }.new
+  end
+
+  delegate :update, :base64digest, to: :@digest
+
+  def to_s
+    algorithm == "md5" ? base64digest : "#{algorithm}:#{base64digest}"
+  end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..41639e7
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,101 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 64.kilobytes
+  MAX_JSON_SIZE = 32.megabytes
+
+  def initialize(io)
+    @io = io
+    @reader = ZipKit::FileReader.new
+    @entries = {}
+
+    @reader.read_zip_structure(io: io, read_local_headers: false).each do |entry|
+      validate_entry(entry)
+      @entries[entry.filename] = entry
+    end
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature => error
+    raise ZipFile::Error, "The file is not a valid ZIP archive: #{error.message}"
+  end
+
+  def glob(pattern)
+    @entries.each_key.select { |path| File.fnmatch(pattern, path, File::FNM_PATHNAME) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def read(path, limit: MAX_JSON_SIZE)
+    raise ZipFile::Error, "ZIP entry is too large: #{path}" if entry_for(path).uncompressed_size > limit
+
+    String.new(encoding: Encoding::BINARY).tap do |content|
+      each_chunk(path) { |chunk| content << chunk }
+    end
+  end
+
+  def read_json(path)
+    JSON.parse(read(path).force_encoding(Encoding::UTF_8))
+  rescue JSON::ParserError, EncodingError
+    raise ZipFile::Error, "Invalid JSON in #{path}"
+  end
+
+  def each_chunk(path)
+    entry = entry_for(path)
+    offset = @reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+    raise ZipFile::Error, "Invalid ZIP entry offset: #{path}" if offset + entry.compressed_size > @io.size
+
+    @io.seek(offset)
+    remaining = entry.compressed_size
+    size = 0
+    crc = 0
+    inflater = Zlib::Inflate.new(-Zlib::MAX_WBITS) if entry.storage_mode == 8
+
+    emit = lambda do |chunk|
+      size += chunk.bytesize
+      raise ZipFile::Error, "Incorrect ZIP entry size: #{path}" if size > entry.uncompressed_size
+      crc = Zlib.crc32(chunk, crc)
+      yield chunk
+    end
+
+    while remaining.positive?
+      data = @io.read([ remaining, CHUNK_SIZE ].min)
+      raise ZipFile::Error, "Truncated ZIP entry: #{path}" if data.nil? || data.empty?
+      remaining -= data.bytesize
+
+      if inflater
+        inflater.inflate(data, &emit)
+      else
+        emit.call(data)
+      end
+    end
+
+    unless (!inflater || inflater.finished?) && size == entry.uncompressed_size && crc == entry.crc32
+      raise ZipFile::Error, "Corrupt ZIP entry: #{path}"
+    end
+  rescue Zlib::Error, ZipKit::FileReader::ReadError => error
+    raise ZipFile::Error, "Corrupt ZIP entry #{path}: #{error.message}"
+  ensure
+    inflater&.close
+  end
+
+  private
+    def validate_entry(entry)
+      path = entry.filename.force_encoding(Encoding::UTF_8)
+      raise ZipFile::Error, "Invalid filename encoding in ZIP archive" unless path.valid_encoding?
+
+      if path.blank? || path.start_with?("/") || path.include?("\\") || path.include?("\0") || path.include?(":") || path.split("/").any? { |part| part.in?([ ".", ".." ]) }
+        raise ZipFile::Error, "Unsafe path in ZIP archive"
+      end
+      raise ZipFile::Error, "Duplicate ZIP entry: #{path}" if exists?(path)
+      raise ZipFile::Error, "Encrypted ZIP files are not supported" unless (entry.gp_flags & 0x41).zero?
+      raise ZipFile::Error, "Unsupported ZIP compression" unless entry.storage_mode.in?([ 0, 8 ])
+      raise ZipFile::Error, "ZIP symlinks are not supported" if (entry.external_attrs >> 16) & 0o170000 == 0o120000
+      raise ZipFile::Error, "Invalid ZIP entry offset" unless entry.local_file_header_offset.between?(0, @io.size)
+
+      if entry.uncompressed_size > [ entry.compressed_size * 1000, MAX_JSON_SIZE ].max
+        raise ZipFile::Error, "ZIP entry expands too much: #{path}"
+      end
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise ZipFile::Error, "The archive is missing #{path}" }
+    end
+end
