+require "application_system_test_case"
+
+class AccountImportsTest < ApplicationSystemTestCase
+  include DataTransferTestHelper
+
+  Capybara.register_driver :data_transfer_chrome do |app|
+    options = Selenium::WebDriver::Chrome::Options.new
+    options.add_argument("--headless")
+    options.add_argument("--no-sandbox") if Process.uid.zero?
+    options.add_argument("--disable-dev-shm-usage")
+    Capybara::Selenium::Driver.new(app, browser: :chrome, options: options)
+  end
+  driven_by :data_transfer_chrome
+
+  test "uploading a ZIP directly before requesting the import" do
+    export = create_account_export
+    sign_in_as users(:kevin)
+    visit new_account_import_path(script_name: nil)
+    upload_archive(export)
+    assert_equal identities(:kevin).id, Account::Import.last.file.blob.metadata["import_identity_id"]
+    assert_equal export.file.download, Account::Import.last.file.download
+  end
+
+  test "the large-file upload flow streams to disk before submitting the import" do
+    export = create_account_export
+    sign_in_as users(:kevin)
+    visit new_account_import_path(script_name: nil)
+    page.execute_script('document.querySelector("form[data-controller=account-import-upload]").dataset.accountImportUploadMultipartThresholdValue = "1"')
+    upload_archive(export)
+    assert Account::Import.last.file.blob.composed
+    assert_equal export.file.download, Account::Import.last.file.download
+  end
+
+  private
+    def upload_archive(export)
+      Tempfile.create([ "account", ".zip" ]) do |file|
+        file.binmode
+        file.write(export.file.download)
+        file.flush
+        attach_file "Fizzy account ZIP file", file.path
+        click_on "Import account"
+        assert_text "Your account is being imported", wait: 10
+      end
+    end
+end
