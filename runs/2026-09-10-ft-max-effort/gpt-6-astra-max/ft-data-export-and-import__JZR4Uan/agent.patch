@@ -0,0 +1,32 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  layout "public"
+
+  def new
+    @import = Current.identity.account_imports.new
+  end
+
+  def create
+    @import = Current.identity.account_imports.new
+    upload = params.dig(:account_import, :file)
+
+    if upload.is_a?(String) && upload.present?
+      blob = ActiveStorage::Blob.find_signed(upload)
+      unless blob && blob.account_id.nil? && blob.metadata["import_identity_id"] == Current.identity.id && blob.attachments.none? && blob.metadata["multipart_upload_id"].blank?
+        return head :forbidden
+      end
+      upload = blob
+    end
+
+    @import.file = upload
+    if @import.save
+      redirect_to account_import_path(@import, script_name: nil), notice: "Your account is being imported. We'll email you when it's done."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+    @import = Current.identity.account_imports.find(params[:id])
+  end
+end
