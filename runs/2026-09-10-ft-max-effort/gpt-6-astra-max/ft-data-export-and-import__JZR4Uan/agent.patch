+++ b/test/models/export_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include DataTransferTestHelper
+
+  setup do
+    Current.user = users(:jason)
+  end
+
+  test "account archive includes private boards, readable cards, comments and all attached files" do
+    add_transfer_attachments
+    private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Private", status: :published)
+    export = create_account_export
+
+    ZipFile.open(export.file.blob) do |zip|
+      manifest = zip.read_json("manifest.json")
+      assert_equal "account", manifest["type"]
+      assert zip.exists?("records/boards/#{boards(:private).id}.json")
+      assert zip.exists?("cards/#{private_card.number}.json")
+      assert_not zip.exists?("records/cards/#{cards(:radio).id}.json")
+      assert_empty zip.glob("records/identities/*")
+      assert_empty zip.glob("records/exports/*")
+      assert_empty zip.glob("records/sessions/*")
+
+      card = zip.read_json("cards/#{@card.number}.json")
+      assert_equal @card.title, card["title"]
+      assert_includes card["description"], "Portable description"
+      assert_equal "Design notes", zip.read(card["attachments"].find { |file| file["filename"] == "notes.txt" }["path"])
+      image = card["attachments"].find { |file| file["filename"] == "moon.jpg" }
+      assert_equal @card.image.download, zip.read(image["path"])
+      comment = card["comments"].find { |comment| comment["id"] == @comment.id }
+      assert_includes comment["body"], "Portable comment"
+      assert_equal "Comment attachment", zip.read(comment["attachments"].first["path"])
+      assert_equal manifest["counts"]["files"], zip.glob("files/*/*").size
+    end
+  end
+
+  test "personal archive excludes private boards, other people's drafts and other accounts" do
+    private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Private", status: :published)
+    other_draft = boards(:writebook).cards.create!(creator: users(:kevin), title: "Not shared")
+    own_draft = boards(:writebook).cards.create!(creator: users(:david), title: "My draft")
+    export = Export.create!(account: Current.account, user: users(:david), kind: :cards)
+    export.generate_now
+    assert export.completed?, export.failure_reason
+
+    ZipFile.open(export.file.blob) do |zip|
+      assert zip.exists?("cards/#{cards(:logo).number}.json")
+      assert zip.exists?("cards/#{own_draft.number}.json")
+      assert_not zip.exists?("cards/#{private_card.number}.json")
+      assert_not zip.exists?("cards/#{other_draft.number}.json")
+      assert_empty zip.glob("records/*/*")
+      titles = zip.glob("cards/*.json").map { |path| zip.read_json(path)["title"] }
+      assert_not_includes titles, cards(:radio).title
+    end
+  end
+
+  test "export is generated and emailed only once" do
+    export = Export.create!(account: Current.account, user: users(:jason), kind: :account)
+    assert_enqueued_emails 1 do
+      2.times { export.generate_now }
+    end
+    assert_in_delta 1.day, export.expires_at - export.completed_at, 1
+  end
+
+  test "download token expires after a day" do
+    export = create_account_export
+    token = export.download_token
+    assert_equal export, Export.find_signed(token, purpose: :download)
+    travel 1.day + 1.second
+    assert_nil Export.find_signed(token, purpose: :download)
+    assert_not export.downloadable?
+  end
+
+  test "permissions are checked again when the job runs" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    users(:kevin).update!(role: :member)
+    assert_enqueued_emails 1 do
+      export.generate_now
+    end
+    assert export.failed?
+    assert_not export.file.attached?
+  end
+
+  test "exports use current board access rather than access at request time" do
+    export = Export.create!(account: Current.account, user: users(:david), kind: :cards)
+    users(:david).accesses.delete_all
+    export.generate_now
+    assert export.completed?, export.failure_reason
+    ZipFile.open(export.file.blob) { |zip| assert_empty zip.glob("cards/*.json") }
+  end
+
+  test "unfinished and internal uploads are not part of an account backup" do
+    abandoned = ActiveStorage::Blob.create_before_direct_upload!(filename: "unfinished.jpg", byte_size: 12, checksum: "unfinished")
+    first_export = create_account_export
+    second_export = create_account_export
+    ZipFile.open(second_export.file.blob) do |zip|
+      assert_not zip.exists?("records/active_storage_blobs/#{abandoned.id}.json")
+      assert_not zip.exists?("records/active_storage_blobs/#{first_export.file.blob.id}.json")
+    end
+  end
+
+  test "cleanup purges expired archives" do
+    export = create_account_export
+    blob = export.file.blob
+    travel 1.day + 1.second
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { Export.cleanup }
+    assert_not Export.exists?(export.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+end
diff --git a/test/models/zip_file/reader_test.rb b/test/models/zip_file/reader_test.rb
new file mode 100644
index 0000000..9e483f8
--- /dev/null
+++ b/test/models/zip_file/reader_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  test "reads stored and compressed entries, including empty files" do
+    zip = build_zip { |writer| writer.add_file("plain", "hello"); writer.add_file("binary", "\0\xff".b, compress: false); writer.add_file("empty", "") }
+    reader = ZipFile::Reader.new(zip)
+    assert_equal "hello", reader.read("plain")
+    assert_equal "\0\xff".b, reader.read("binary")
+    assert_equal "", reader.read("empty")
+    assert_raises(ZipFile::Error) { reader.read("missing") }
+  end
+
+  test "corruption is detected rather than silently importing damaged files" do
+    zip = build_zip { |writer| writer.add_file("test", "unchanged", compress: false) }
+    zip.string.sub!("unchanged", "corrupted")
+    reader = ZipFile::Reader.new(zip)
+    assert_raises(ZipFile::Error) { reader.read("test") }
+  end
+
+  test "rejects traversal and absolute paths" do
+    %w[ ../evil.txt /unsafe.txt ].each do |unsafe|
+      zip = build_zip { |writer| writer.add_file("a" * unsafe.length, "test") }
+      zip.string.gsub!("a" * unsafe.length, unsafe)
+      assert_raises(ZipFile::Error) { ZipFile::Reader.new(zip) }
+    end
+  end
+
+  test "bounds JSON reads by uncompressed size" do
+    zip = build_zip { |writer| writer.add_file("large", "x" * 1000) }
+    assert_raises(ZipFile::Error) { ZipFile::Reader.new(zip).read("large", limit: 10) }
+  end
+
+  test "writer records the real byte size and checksum" do
+    zip = StringIO.new("".b)
+    writer = ZipFile::Writer.new(zip)
+    writer.add_file("test", "some bytes")
+    writer.close
+    assert_equal zip.string.bytesize, writer.byte_size
+    assert_equal Digest::MD5.base64digest(zip.string), writer.checksum
+  end
+
+  test "range reader never downloads the whole blob" do
+    zip = build_zip { |writer| writer.add_file("test", "range reads") }
+    blob = ActiveStorage::Blob.create_and_upload!(io: zip, filename: "test.zip")
+    blob.expects(:download).never
+    ZipFile.open(blob) { |reader| assert_equal "range reads", reader.read("test") }
+  ensure
+    blob&.purge
+  end
+
+  test "range reader rejects corrupt offsets and excessive reads before accessing storage" do
+    blob = stub(byte_size: 600.gigabytes)
+    blob.expects(:download_chunk).never
+    io = ZipFile::BlobIO.new(blob)
+    assert_raises(ZipFile::Error) { io.seek(-1) }
+    assert_raises(ZipFile::Error) { io.read }
+  end
+
+  test "reads a ZIP64 central directory beyond 600 GB with bounded range requests" do
+    Tempfile.create("large-zip64") do |file|
+      file.binmode
+      streamer = ZipKit::Streamer.new(file)
+      streamer.add_stored_entry(filename: "huge.bin", size: 600.gigabytes)
+      file.seek(600.gigabytes, IO::SEEK_CUR)
+      streamer.simulate_write(600.gigabytes)
+      streamer.write_deflated_file("manifest.json") { |sink| sink.write('{"large":true}') }
+      streamer.close
+      file.flush
+
+      blob = Object.new
+      blob.define_singleton_method(:byte_size) { file.size }
+      blob.define_singleton_method(:download_chunk) do |range|
+        raise "Unbounded read" if range.size > 1.megabyte
+        file.seek(range.begin)
+        file.read(range.size)
+      end
+      ZipFile.open(blob) { |reader| assert_equal({ "large" => true }, reader.read_json("manifest.json")) }
+    end
+  end
+
+  test "duplicate entry names are rejected on read" do
+    zip = build_zip do |writer|
+      writer.add_file("one.txt", "one")
+      writer.add_file("two.txt", "two")
+    end
+    zip.string.gsub!("two.txt", "one.txt")
+    assert_raises(ZipFile::Error) { ZipFile::Reader.new(zip) }
+  end
+
+  private
+    def build_zip
+      StringIO.new("".b).tap do |io|
+        writer = ZipFile::Writer.new(io)
+        yield writer
+        writer.close
+        io.rewind
+      end
+    end
+end
