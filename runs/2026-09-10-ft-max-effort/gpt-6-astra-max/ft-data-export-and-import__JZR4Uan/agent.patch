@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Account::Imports::UploadsControllerTest < ActionDispatch::IntegrationTest
+  test "uploads are signed-in identity scoped, without needing an account" do
+    identity = Identity.create!(email_address: "importer@example.com")
+    sign_in_as identity
+    untenanted do
+      post account_imports_uploads_path, params: { blob: {
+        filename: "account.zip", byte_size: 3, checksum: Digest::MD5.base64digest("zip"), content_type: "application/zip"
+      } }, as: :json
+      assert_response :success
+      blob = ActiveStorage::Blob.find_signed!(response.parsed_body["signed_id"])
+      assert_equal identity.id, blob.metadata["import_identity_id"]
+      assert_nil blob.account_id
+      assert response.parsed_body.dig("direct_upload", "url")
+    end
+  end
+
+  test "another identity cannot claim an import upload" do
+    sign_in_as :kevin
+    blob = ActiveStorage::Blob.create!(account: nil, filename: "account.zip", byte_size: 3, checksum: "test", metadata: { import_identity_id: identities(:jason).id })
+    untenanted do
+      post account_imports_path, params: { account_import: { file: blob.signed_id } }
+      assert_response :forbidden
+    end
+  end
+
+  test "a signed in person can upload parts and complete an S3 archive" do
+    require "active_storage/service/s3_service"
+    original_service = ActiveStorage::Blob.service
+    service = ActiveStorage::Service::S3Service.new(bucket: "fizzy-test", region: "us-east-1", stub_responses: true)
+    service.name = "transfer_s3"
+    service.client.client.stub_responses(:create_multipart_upload, upload_id: "multipart-id")
+    ActiveStorage::Blob.service = service
+    ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(service)
+    sign_in_as :kevin
+
+    untenanted do
+      post account_imports_uploads_path, params: { multipart: true, blob: {
+        filename: "account.zip", byte_size: 101.megabytes, checksum: nil, content_type: "application/zip"
+      } }, as: :json
+      assert_response :success
+      upload = response.parsed_body
+      blob = ActiveStorage::Blob.find_signed!(upload["signed_id"])
+      assert_equal identities(:kevin).id, blob.metadata["import_identity_id"]
+      assert_nil blob.account_id
+
+      post account_imports_path, params: { account_import: { file: upload["signed_id"] } }
+      assert_response :forbidden, "unfinished multipart blobs cannot start an import"
+
+      post upload.dig("multipart", "parts_url"), params: { part_number: 1 }, as: :json
+      assert_response :success
+      assert_includes response.parsed_body["url"], "partNumber=1"
+      post upload.dig("multipart", "completion_url"), params: { parts: [ { part_number: 1, etag: "one" }, { part_number: 2, etag: "two" } ] }, as: :json
+      assert_response :no_content
+      assert_nil blob.reload.metadata["multipart_upload_id"]
+    end
+  ensure
+    ActiveStorage::Blob.service = original_service
+  end
+
+  test "another identity cannot sign parts, complete, or cancel an upload" do
+    sign_in_as :david
+    blob = ActiveStorage::Blob.create!(filename: "account.zip", byte_size: 3, checksum: "test", metadata: { import_identity_id: identities(:kevin).id })
+    untenanted do
+      post account_imports_upload_parts_path(blob.signed_id), params: { part_number: 1 }, as: :json
+      assert_response :not_found
+      post account_imports_upload_completion_path(blob.signed_id), params: { parts: [ { part_number: 1, etag: "etag" } ] }, as: :json
+      assert_response :not_found
+      delete account_imports_upload_path(blob.signed_id), as: :json
+      assert_response :not_found
+    end
+    assert ActiveStorage::Blob.exists?(blob.id)
+  end
+
+  test "uploads require a session" do
+    untenanted do
+      assert_no_difference -> { ActiveStorage::Blob.count } do
+        post account_imports_uploads_path, params: { blob: { filename: "account.zip", byte_size: 3, checksum: "test" } }, as: :json
+      end
+      assert_response :redirect
+    end
+  end
+end
