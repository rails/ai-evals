diff --git a/app/javascript/controllers/account_import_upload_controller.js b/app/javascript/controllers/account_import_upload_controller.js
new file mode 100644
index 0000000..dc5451d
--- /dev/null
+++ b/app/javascript/controllers/account_import_upload_controller.js
@@ -0,0 +1,96 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { start as startDirectUploads } from "@rails/activestorage"
+
+export default class extends Controller {
+  static targets = [ "file", "submit", "progress", "status" ]
+  static values = { url: String, multipartThreshold: Number }
+
+  #uploading = false
+  #uploaded = false
+
+  connect() {
+    startDirectUploads()
+  }
+
+  async submit(event) {
+    const file = this.fileTarget.files[0]
+    if (!file || file.size <= this.multipartThresholdValue || this.#uploaded) return
+
+    // Smaller files use Active Storage's normal direct upload. Larger files
+    // use bounded S3 parts (or a streamed Disk PUT), without hashing the whole
+    // archive in the browser or hitting S3's single-request size limit.
+    event.preventDefault()
+    event.stopPropagation()
+    if (this.#uploading) return
+
+    this.#uploading = true
+    this.submitTarget.disabled = true
+    this.#showProgress(0)
+    let upload
+
+    try {
+      upload = await this.#post(this.urlValue, {
+        multipart: true,
+        blob: { filename: file.name, byte_size: file.size, content_type: "application/zip", checksum: null }
+      })
+
+      if (upload.multipart) {
+        await this.#uploadParts(file, upload.multipart)
+      } else {
+        await this.#put(upload.direct_upload.url, file, upload.direct_upload.headers)
+      }
+
+      const input = document.createElement("input")
+      input.type = "hidden"
+      input.name = this.fileTarget.name
+      input.value = upload.signed_id
+      this.element.appendChild(input)
+      this.fileTarget.disabled = true
+      this.#uploaded = true
+      this.submitTarget.disabled = false
+      this.element.requestSubmit()
+    } catch (error) {
+      if (upload?.multipart) await destroy(upload.multipart.abort_url).catch(() => {})
+      this.statusTarget.textContent = `${error.message} Please choose the file and try again.`
+      this.submitTarget.disabled = false
+    } finally {
+      this.#uploading = false
+    }
+  }
+
+  progress(event) {
+    this.#showProgress(event.detail.progress)
+  }
+
+  async #uploadParts(file, upload) {
+    const parts = []
+    for (let offset = 0, part = 1; offset < file.size; offset += upload.part_size, part++) {
+      const { url } = await this.#post(upload.parts_url, { part_number: part })
+      const response = await this.#put(url, file.slice(offset, offset + upload.part_size))
+      const etag = response.headers.get("ETag")
+      if (!etag) throw new Error("Storage must expose the ETag header for large uploads.")
+      parts.push({ part_number: part, etag })
+      this.#showProgress(Math.min(100, (offset + upload.part_size) / file.size * 100))
+    }
+    await this.#post(upload.completion_url, { parts })
+  }
+
+  async #post(url, body) {
+    const response = await post(url, { body, responseKind: "json" })
+    if (!response.ok) throw new Error("The upload could not be completed.")
+    if (response.statusCode !== 204) return response.json
+  }
+
+  async #put(url, body, headers = {}) {
+    const response = await fetch(url, { method: "PUT", body, headers })
+    if (!response.ok) throw new Error("The file could not be uploaded.")
+    return response
+  }
+
+  #showProgress(value) {
+    this.progressTarget.hidden = false
+    this.progressTarget.value = value
+    this.statusTarget.textContent = `Uploading ${Math.round(value)}%. Keep this page open until the upload finishes.`
+  }
+}
