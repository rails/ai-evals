+class Account::DataTransfer::Importer
+  POLYMORPHIC_TYPES = {
+    "Entropy" => %w[ Account Board ],
+    "Reaction" => %w[ Card Comment ],
+    "Mention" => %w[ Card Comment ],
+    "Event" => %w[ Card Comment ],
+    "Notification" => %w[ Event Mention ],
+    "ActiveStorage::Attachment" => %w[ Card User ActionText::RichText ActiveStorage::VariantRecord ],
+    "ActionText::RichText" => %w[ Board Card Comment ]
+  }.freeze
+
+  ID_LISTS = {
+    "assignee_ids" => "User", "creator_ids" => "User", "closer_ids" => "User",
+    "card_ids" => "Card", "column_ids" => "Column", "board_ids" => "Board", "tag_ids" => "Tag"
+  }.freeze
+
+  def initialize(import)
+    @import = import
+    @record_sets = Account::DataTransfer::Manifest.new(nil).each_record_set.reject do |record_set|
+      record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+    end
+    @models = @record_sets.to_h { |record_set| [ record_set.model.name, record_set.model ] }
+  end
+
+  def import
+    ZipFile.open(@import.file.blob) do |zip|
+      @zip = zip
+      validate_manifest
+      create_account
+
+      Current.with(account: @account, user: nil) do
+        restore_records
+        restore_files
+        assign_owner
+        rebuild_derived_data
+      end
+    end
+    @account
+  end
+
+  def cleanup(error: nil)
+    ActiveStorage::Blob.service.delete_prefixed(storage_prefix)
+  ensure
+    @signup&.cancel_provisioned_account(error) if error
+  end
+
+  private
+    def validate_manifest
+      manifest = @zip.read_json("manifest.json")
+      unless manifest.is_a?(Hash) && manifest.values_at("format", "version", "type") == [ "fizzy", Account::DataTransfer::VERSION, "account" ]
+        raise Account::DataTransfer::Error, "Choose a supported Fizzy account export, not a personal cards export"
+      end
+
+      @source_account_id = manifest.fetch("account_id")
+      validate_id(@source_account_id)
+      expected = @record_sets.to_h { |set| [ set.directory, @zip.glob("#{set.directory}/*.json").size ] }
+      expected["files"] = @zip.glob("files/*/*").size
+      unless manifest["counts"] == expected && expected["records/accounts"] == 1 && expected["files"] == expected["records/active_storage_blobs"]
+        raise Account::DataTransfer::Error, "The account archive is incomplete: its record or file counts do not match"
+      end
+    end
+
+    def create_account
+      data = read_record(Account, "records/accounts/#{@source_account_id}.json")
+      @signup = Signup.new(identity: @import.identity, full_name: @import.identity.users.first&.name || @import.identity.email_address)
+      @account = @signup.create_account_from_export(data.slice("name", "cards_count", "created_at", "updated_at"))
+      @account.entropies.delete_all
+      @account.association(:entropy).reset
+    end
+
+    def restore_records
+      @record_sets.reject { |set| set.model == Account }.each do |set|
+        @zip.glob("#{set.directory}/*.json").each do |path|
+          data = read_record(set.model, path)
+          attributes = attributes_for(set.model, data)
+
+          # Restoring historical data must not broadcast, send notifications,
+          # dispatch webhooks, change timestamps, or create duplicate defaults.
+          set.model.insert!(attributes)
+          restore_filter_associations(attributes.fetch("id"), data) if set.model == Filter
+        end
+      end
+    end
+
+    def read_record(model, path)
+      data = @zip.read_json(path)
+      unless data.is_a?(Hash) && path == "records/#{model.table_name}/#{data['id']}.json"
+        raise Account::DataTransfer::Error, "Invalid record in #{path}"
+      end
+      validate_id(data["id"])
+      if model != Account && data["account_id"] != @source_account_id
+        raise Account::DataTransfer::Error, "A record belongs to a different account: #{path}"
+      end
+      data
+    end
+
+    def attributes_for(model, data)
+      attributes = data.slice(*model.column_names)
+      attributes["id"] = mapped_id(model, data.fetch("id"))
+      rewrite_associations(model, attributes)
+      rewrite_details(model, attributes, data)
+      attributes
+    end
+
+    def rewrite_associations(model, attributes)
+      model.reflect_on_all_associations(:belongs_to).each do |reflection|
+        next if model == User && reflection.name == :identity
+
+        if source_id = attributes[reflection.foreign_key]
+          target = if reflection.polymorphic?
+            type = attributes[reflection.foreign_type]
+            unless POLYMORPHIC_TYPES.fetch(model.name, []).include?(type)
+              raise Account::DataTransfer::Error, "Unsupported #{model.name} reference: #{type}"
+            end
+            @models.fetch(type)
+          else
+            reflection.klass
+          end
+          attributes[reflection.foreign_key] = mapped_id(target, source_id)
+        end
+      end
+    end
+
+    def mapped_id(model, source_id)
+      validate_id(source_id)
+      unless @models.value?(model) && @zip.exists?("records/#{model.table_name}/#{source_id}.json")
+        raise Account::DataTransfer::Error, "The archive is missing a referenced #{model.model_name.human} record"
+      end
+
+      if model == Account
+        raise Account::DataTransfer::Error, "The archive references another account" unless source_id == @source_account_id
+        @account.id
+      else
+        # Deterministic within this import: no in-memory ID map proportional to
+        # the number of cards/files. Keep UUID timestamp/version bits so that
+        # chronological ordering works just as it did in the source account.
+        source_hex = ActiveRecord::Type::Uuid.base36_to_hex(source_id)
+        hash = Digest::SHA256.hexdigest("#{@account.id}/#{model.name}/#{source_id}")
+        hex = source_hex.first(16) + hash.last(16)
+        hex[16] = ((hex[16].to_i(16) & 3) | 8).to_s(16)
+        ActiveRecord::Type::Uuid.hex_to_base36(hex)
+      end
+    end
+
+    def validate_id(id)
+      raise Account::DataTransfer::Error, "Invalid record ID in the archive" unless id.is_a?(String) && id.match?(/\A[a-z0-9]{25}\z/) && id.to_i(36) < 2**128
+    end
+
+    def rewrite_details(model, attributes, data)
+      case model.name
+      when "User"
+        restore_identity(attributes, data)
+      when "Board::Publication"
+        attributes["key"] = SecureRandom.base58(24)
+      when "Webhook"
+        attributes["signing_secret"] = SecureRandom.base58(24)
+        attributes["active"] = false
+      when "Notification::Bundle"
+        attributes["status"] = "delivered"
+      when "ActiveStorage::Blob"
+        attributes["key"] = "#{storage_prefix}#{attributes.fetch('id')}"
+        attributes["service_name"] = ActiveStorage::Blob.service.name
+        unless attributes["metadata"].nil? || attributes["metadata"].is_a?(Hash)
+          raise Account::DataTransfer::Error, "Invalid attachment metadata"
+        end
+        attributes["metadata"] = (attributes["metadata"] || {}).except("composed", "import_identity_id", "multipart_upload_id", "import_upload_touched_at")
+        unless attributes["byte_size"].is_a?(Integer) && attributes["byte_size"] >= 0
+          raise Account::DataTransfer::Error, "Invalid attachment size"
+        end
+      when "ActiveStorage::Attachment"
+        target = @models.fetch(attributes.fetch("record_type"))
+        unless target.reflect_on_attachment(attributes["name"])
+          raise Account::DataTransfer::Error, "Unknown attachment name in the archive"
+        end
+      when "ActionText::RichText"
+        target = @models.fetch(attributes.fetch("record_type"))
+        reflection = target.reflect_on_association("rich_text_#{attributes['name']}")
+        unless reflection&.klass == ActionText::RichText
+          raise Account::DataTransfer::Error, "Unknown rich-text field in the archive"
+        end
+        attributes["body"] = Account::DataTransfer::RichText.load(data["body"].to_s) do |type, id|
+          model = @models.fetch(type)
+          model.find(mapped_id(model, id))
+        end
+      end
+
+      %w[ particulars fields ].each do |name|
+        attributes[name] = rewrite_id_lists(attributes[name]) if attributes[name]
+      end
+    end
+
+    def restore_identity(attributes, data)
+      unless User.roles.key?(attributes["role"]) && attributes["name"].present?
+        raise Account::DataTransfer::Error, "Invalid person in the archive"
+      end
+
+      if attributes["active"] && attributes["role"] != "system" && data["email_address"].blank?
+        raise Account::DataTransfer::Error, "An active person is missing their email address"
+      end
+
+      attributes["identity_id"] = nil
+      if data["email_address"].present? && attributes["role"] != "system"
+        identity = Identity.find_or_create_by!(email_address: data["email_address"])
+        attributes["identity_id"] = identity.id
+      end
+    end
+
+    def rewrite_id_lists(value)
+      case value
+      when Hash
+        value.to_h do |key, item|
+          if ID_LISTS.key?(key)
+            [ key, Array(item).map { |id| mapped_id(@models.fetch(ID_LISTS.fetch(key)), id) } ]
+          else
+            [ key, rewrite_id_lists(item) ]
+          end
+        end
+      when Array
+        value.map { |item| rewrite_id_lists(item) }
+      else
+        value
+      end
+    end
+
+    def restore_filter_associations(id, data)
+      filter = Filter.find(id)
+      data.fetch("associations", {}).each do |name, ids|
+        unless Account::DataTransfer::FilterRecordSet::ASSOCIATIONS.include?(name)
+          raise Account::DataTransfer::Error, "Unknown filter association"
+        end
+        model = Filter.reflect_on_association(name).klass
+        filter.public_send("#{name.singularize}_ids=", ids.map { |source_id| mapped_id(model, source_id) })
+      end
+      filter.update_columns(params_digest: Filter.digest_params(filter.as_params))
+    end
+
+    def restore_files
+      @zip.glob("records/active_storage_blobs/*.json").each do |path|
+        data = @zip.read_json(path)
+        blob = ActiveStorage::Blob.find(mapped_id(ActiveStorage::Blob, data.fetch("id")))
+        filename = "files/#{data.fetch('id')}/#{blob.filename}"
+        target_checksum = ZipFile::Checksum.for_service(blob.service)
+        source_checksum = blob.checksum ? ZipFile::Checksum.from_encoded(blob.checksum) : target_checksum
+        target_checksum = source_checksum if target_checksum.algorithm == source_checksum.algorithm
+        checksums = [ source_checksum, target_checksum ].uniq
+        expected_checksum = blob.checksum&.split(":", 2)&.last
+        size = 0
+
+        ZipFile.upload(blob) do |io|
+          @zip.each_chunk(filename) do |chunk|
+            checksums.each { |checksum| checksum.update(chunk) }
+            size += chunk.bytesize
+            io.write(chunk)
+          end
+          unless size == blob.byte_size && (expected_checksum.nil? || expected_checksum == source_checksum.base64digest)
+            raise Account::DataTransfer::Error, "The attachment #{blob.filename} is corrupt or incomplete"
+          end
+        end
+        blob.update_columns(checksum: target_checksum.to_s)
+      end
+    end
+
+    def assign_owner
+      owner = @account.users.find_by(identity: @import.identity)
+      owner ||= @account.users.create!(identity: @import.identity, name: @import.identity.email_address, role: :owner, verified_at: Time.current)
+      @account.users.where(role: :owner).where.not(id: owner.id).update_all(role: :admin)
+      owner.update!(role: :owner, active: true, verified_at: Time.current)
+      @account.boards.where.not(id: owner.boards.select(:id)).find_each do |board|
+        board.accesses.create!(user: owner)
+      end
+      @account.users.create!(role: :system, name: "System") unless @account.users.exists?(role: :system)
+    end
+
+    def rebuild_derived_data
+      @account.update!(cards_count: [ @account.cards_count, @account.cards.maximum(:number).to_i ].max)
+      @account.cards.with_rich_text_description.find_each(&:reindex)
+      Comment.where(account: @account).with_rich_text_body.includes(:card).find_each(&:reindex)
+
+      @account.boards.find_each do |board|
+        bytes = board.send(:calculate_real_storage_bytes)
+        Storage::Entry.create!(account: @account, board: board, delta: bytes, operation: "import") if bytes.positive?
+        board.materialize_storage
+      end
+      @account.materialize_storage
+    end
+
+    def storage_prefix
+      "fizzy-imports/#{@import.id}/"
+    end
+end
