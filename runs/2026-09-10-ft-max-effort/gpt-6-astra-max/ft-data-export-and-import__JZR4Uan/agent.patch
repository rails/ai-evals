+class ExportsController < ApplicationController
+  allow_unauthenticated_access
+
+  def show
+    export = Export.find_signed(params[:id], purpose: :download)
+
+    if export && export.account == Current.account && export.downloadable?
+      no_store
+      ActiveStorage::Current.set(url_options: { protocol: request.protocol, host: request.host, port: request.port, script_name: request.script_name }) do
+        # The URL comes only from the configured storage service, never from
+        # a request parameter. External redirects are required for private S3.
+        redirect_to export.file.url(expires_in: [ export.expires_at - Time.current, 5.minutes ].min, disposition: :attachment), allow_other_host: true
+      end
+    else
+      head :not_found
+    end
+  end
+end
