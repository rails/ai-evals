diff --git a/app/models/account/data_transfer/rich_text.rb b/app/models/account/data_transfer/rich_text.rb
new file mode 100644
index 0000000..9bcab46
--- /dev/null
+++ b/app/models/account/data_transfer/rich_text.rb
@@ -0,0 +1,38 @@
+# Signed Global IDs and blob URLs are instance-specific. Archive references are
+# deliberately unsigned and are only resolved against records in this archive.
+class Account::DataTransfer::RichText
+  class << self
+    def dump(content)
+      transform(content&.to_html.to_s) do |node|
+        if attachable = ActionText::Attachable.from_attachable_sgid(node["sgid"])
+          if attachable.is_a?(ActiveStorage::Blob) || attachable.is_a?(User)
+            node["sgid"] = "fizzy://#{attachable.class.name}/#{attachable.id}"
+            node["url"] = Account::DataTransfer.file_path(attachable) if attachable.is_a?(ActiveStorage::Blob)
+          end
+        else
+          node.remove_attribute("sgid")
+        end
+      end
+    end
+
+    def load(html)
+      transform(html) do |node|
+        if node["sgid"].present?
+          match = %r{\Afizzy://(ActiveStorage::Blob|User)/([a-z0-9]{25})\z}.match(node["sgid"])
+          raise Account::DataTransfer::Error, "Invalid rich-text attachment reference" unless match
+
+          attachable = yield match[1], match[2]
+          node["sgid"] = attachable.attachable_sgid
+          node["url"] = attachable.to_rich_text_attributes[:url] if attachable.is_a?(ActiveStorage::Blob)
+        end
+      end
+    end
+
+    private
+      def transform(html)
+        Nokogiri::HTML5.fragment(html).tap do |document|
+          document.css("action-text-attachment").each { |node| yield node }
+        end.to_html
+      end
+  end
+end
