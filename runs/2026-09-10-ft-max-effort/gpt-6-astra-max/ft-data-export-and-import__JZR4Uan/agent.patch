+<% @page_title = "Import a Fizzy account" %>
+
+<section class="panel panel--centered flex flex-column gap">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+  <p>Choose the ZIP downloaded from a Fizzy account's settings. We'll create a new account with its people, boards, cards, comments, pictures, and files. Existing accounts won't be changed.</p>
+  <p>We'll email <strong><%= Current.identity.email_address %></strong> when the import is complete, or explain why it couldn't be imported.</p>
+
+  <%= form_with model: @import, url: account_imports_path(script_name: nil), class: "flex flex-column gap", data: { turbo: false, controller: "account-import-upload", action: "submit->account-import-upload#submit direct-upload:progress->account-import-upload#progress", account_import_upload_url_value: account_imports_uploads_path(script_name: nil), account_import_upload_multipart_threshold_value: Account::Import::Upload::PART_SIZE } do |form| %>
+    <% if @import.errors.any? %>
+      <ul class="txt-negative" role="alert">
+        <% @import.errors.full_messages.each do |message| %>
+          <li><%= message %></li>
+        <% end %>
+      </ul>
+    <% end %>
+    <%= form.label :file, "Fizzy account ZIP file", class: "font-weight-bold" %>
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, data: { direct_upload_url: account_imports_uploads_url(script_name: nil), account_import_upload_target: "file" } %>
+    <progress max="100" value="0" hidden data-account-import-upload-target="progress" aria-label="Upload progress"></progress>
+    <p role="status" data-account-import-upload-target="status"></p>
+    <%= form.submit "Import account", class: "btn btn--link center", data: { account_import_upload_target: "submit" } %>
+  <% end %>
+</section>
