+module DataTransferTestHelper
+  include ActionMailer::TestHelper
+
+  def create_account_export(account: accounts(:"37s"), user: users(:jason))
+    Current.with(account: account, user: user) do
+      Export.create!(account: account, user: user, kind: :account).tap do |export|
+        export.generate_now
+        assert export.completed?, export.failure_reason
+      end
+    end
+  end
+
+  def create_account_import(export, identity: identities(:kevin))
+    Current.without_account do
+      Account::Import.create!(identity: identity, file: {
+        io: StringIO.new(export.file.download), filename: "account.zip", content_type: "application/zip"
+      })
+    end
+  end
+
+  def add_transfer_attachments
+    @card = cards(:logo)
+    @file_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Design notes"), filename: "notes.txt", content_type: "text/plain")
+    @comment_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("Comment attachment"), filename: "comment.txt", content_type: "text/plain")
+    @card.update!(description: ActionText::Content.new("<p>Portable description</p>").append_attachables([ @file_blob, users(:david) ]))
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    @comment = @card.comments.create!(creator: users(:jason), body: ActionText::Content.new("<p>Portable comment</p>").append_attachables([ @comment_blob ]))
+  end
+
+  def rewrite_archive(export)
+    output = StringIO.new("".b)
+    writer = ZipFile::Writer.new(output)
+    ZipFile.open(export.file.blob) do |zip|
+      zip.glob("**/*").each do |path|
+        content = yield(path, zip.read(path))
+        writer.add_file(path, content) unless content.nil?
+      end
+    end
+    writer.close
+    output.rewind
+    export.file.attach(io: output, filename: "account.zip", content_type: "application/zip")
+  end
+end
