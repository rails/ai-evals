diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..466a648
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,43 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+  #observer
+
+  connect() {
+    this.render()
+    this.#timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+
+    // Turbo can morph the timestamp or restore its raw fallback without
+    // disconnecting this controller. Reformat both kinds of change.
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-format-value" ],
+      childList: true,
+      characterData: true,
+      subtree: true
+    })
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.#observer.disconnect()
+  }
+
+  render() {
+    const timestamp = this.element.getAttribute("datetime")
+    const date = parseLocalTime(timestamp)
+
+    if (!Number.isNaN(date.getTime())) {
+      const text = formatLocalTime(date, this.formatValue)
+      if (this.element.textContent !== text) this.element.textContent = text
+      this.element.title = formatLocalTime(date, timestamp.length === 10 ? "full-date" : "full")
+    }
+  }
+}
