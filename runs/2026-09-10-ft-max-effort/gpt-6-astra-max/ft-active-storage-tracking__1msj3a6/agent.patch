+module StorageTestHelper
+  private
+    def blob(size, account: Current.account)
+      Current.with_account(account) do
+        ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new("x" * size), filename: "file.txt", content_type: "text/plain")
+      end
+    end
+
+    def content_with(*blobs)
+      blobs.map { |blob| ActionText::Attachment.from_attachable(blob).to_html }.join
+    end
+
+    def materialize
+      while enqueued_jobs.any? { |job| job[:job] == Storage::MaterializeJob }
+        perform_enqueued_jobs only: Storage::MaterializeJob
+      end
+    end
+end
