diff --git a/app/jobs/storage/backfill_job.rb b/app/jobs/storage/backfill_job.rb
new file mode 100644
index 0000000..4d10104
--- /dev/null
+++ b/app/jobs/storage/backfill_job.rb
@@ -0,0 +1,19 @@
+class Storage::BackfillJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout
+
+  def perform(account = nil)
+    step :attachments do |step|
+      attachments = ActiveStorage::Attachment.where(storage_tracked: false)
+      attachments = attachments.where(account: account) if account
+
+      attachments.find_each(start: step.cursor) do |attachment|
+        attachment.track_storage
+        step.set!(attachment.id)
+      end
+    end
+  end
+end
