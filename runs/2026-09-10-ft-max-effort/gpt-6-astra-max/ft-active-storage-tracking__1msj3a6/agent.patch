@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Storage::ImportTest < ActiveSupport::TestCase
+  include StorageTestHelper
+
+  test "exported attachment usage is rebuilt after import without counting the archive" do
+    source_account = accounts(:"37s")
+    exporter = users(:david)
+    Current.session = sessions(:david)
+    card = cards(:logo)
+    board_id = card.board_id
+    card.image.attach blob(11)
+    card.update! description: content_with(blob(23))
+    card.board.update! public_description: content_with(blob(37))
+    comments(:logo_agreement_jz).update! body: content_with(blob(41))
+    materialize
+    assert_equal 112, source_account.bytes_used
+
+    export = Account::Export.create!(account: source_account, user: exporter)
+    export.build
+    export_tempfile = Tempfile.new([ "storage-export", ".zip" ])
+    export.file.open { |file| FileUtils.cp(file.path, export_tempfile.path) }
+    source_account.destroy!
+    ActiveStorage::Blob.where(account: source_account).delete_all
+
+    target_account = Account.create_with_owner(account: { name: "Imported storage" },
+      owner: { identity: exporter.identity, name: exporter.name })
+    import = Account::Import.create!(account: target_account, identity: exporter.identity)
+    Current.with_account(target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+    import.check
+    import.process
+
+    assert_equal 0, target_account.bytes_used
+    perform_enqueued_jobs only: Storage::BackfillJob
+    materialize
+
+    assert_equal 112, target_account.bytes_used
+    assert_equal 112, Board.find(board_id).bytes_used
+    Storage::BackfillJob.perform_now(target_account)
+    materialize
+    assert_equal 112, target_account.bytes_used
+  ensure
+    export_tempfile&.close!
+  end
+end
