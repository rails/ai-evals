+++ b/test/models/storage/attachment_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Storage::AttachmentTest < ActiveSupport::TestCase
+  include StorageTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+  end
+
+  test "backfills existing attachments exactly once" do
+    attachment = legacy_attachment
+    assert_not attachment.storage_tracked?
+    assert_empty Storage::Entry.all
+
+    Storage::BackfillJob.perform_now(@account)
+    Storage::BackfillJob.perform_now(@account)
+    attachment.track_storage
+    materialize
+
+    assert attachment.reload.storage_tracked?
+    assert_equal 23, @account.bytes_used
+    assert_equal 23, @card.board.bytes_used
+  end
+
+  test "backfills all counted attachment types and excludes avatars" do
+    @card.image.attach blob(11)
+    @card.update! description: content_with(blob(23))
+    @card.board.update! public_description: content_with(blob(37))
+    comments(:logo_agreement_jz).update! body: content_with(blob(41))
+    users(:david).avatar.attach blob(53)
+    Storage::Entry.delete_all
+    ActiveStorage::Attachment.update_all(storage_tracked: false)
+    clear_enqueued_jobs
+
+    Storage::BackfillJob.perform_now
+    materialize
+
+    assert_equal 112, @account.bytes_used
+    assert_equal 112, @card.board.bytes_used
+    assert_not ActiveStorage::Attachment.where(storage_tracked: false).exists?
+  end
+
+  test "removing an attachment before it is backfilled does not subtract uncounted bytes" do
+    attachment = legacy_attachment
+    attachment.delete
+    Storage::BackfillJob.perform_now(@account)
+    materialize
+
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "a stale instance uses the backfilled marker when it is removed" do
+    attachment = legacy_attachment
+    ActiveStorage::Attachment.find(attachment.id).track_storage
+    materialize
+    assert_equal 23, @account.bytes_used
+
+    attachment.delete
+    materialize
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "an attachment removed during backfill is skipped" do
+    attachment = legacy_attachment
+    ActiveStorage::Attachment.find(attachment.id).delete
+
+    assert_nothing_raised { attachment.track_storage }
+    materialize
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "backfill marks nothing when its transaction rolls back" do
+    attachment = legacy_attachment
+    ActiveStorage::Attachment.transaction do
+      attachment.track_storage
+      raise ActiveRecord::Rollback
+    end
+
+    assert_not attachment.reload.storage_tracked?
+    assert_empty Storage::Entry.all
+  end
+
+  test "backfill is scoped to the imported account" do
+    legacy_attachment
+    other_account = accounts(:initech)
+    legacy_attachment(card: cards(:radio), size: 41)
+
+    Storage::BackfillJob.perform_now(other_account)
+    materialize
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 41, other_account.bytes_used
+  end
+
+  test "imports do not copy the tracking marker from another installation" do
+    record_set = Account::DataTransfer::ActiveStorage::AttachmentRecordSet.new(@account)
+
+    assert_not_includes record_set.attributes, "storage_tracked"
+  end
+
+  private
+    def legacy_attachment(card: @card, size: 23)
+      attachment = ActiveStorage::Attachment.new(account: card.account, record: card, name: "image", blob: blob(size, account: card.account))
+      ActiveStorage::Attachment.insert_all!([ attachment.attributes.except("created_at") ])
+      attachment.reload
+    end
+end
diff --git a/test/models/storage/concurrency_test.rb b/test/models/storage/concurrency_test.rb
new file mode 100644
index 0000000..f7089e7
--- /dev/null
+++ b/test/models/storage/concurrency_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Storage::ConcurrencyTest < ActiveSupport::TestCase
+  include StorageTestHelper
+
+  self.use_transactional_tests = false
+
+  setup do
+    @account = Account.create_with_owner(account: { name: "Concurrent storage" },
+      owner: { name: "Owner", identity: identities(:david) })
+    @owner = @account.users.find_by!(role: :owner)
+    Current.account = @account
+    Current.user = @owner
+    @boards = 2.times.map { |index| @account.boards.create!(name: "Board #{index}", creator: @owner) }
+  end
+
+  teardown do
+    @account.destroy!
+    ActiveStorage::Blob.where(account: @account).find_each(&:purge)
+  end
+
+  test "overlapping workers, uploads, removals, and moves preserve exact totals" do
+    cards = 12.times.map do |index|
+      @boards.first.cards.create!(creator: @owner, status: :published, title: "Card #{index}").tap do |card|
+        card.image.attach blob(index + 1)
+      end
+    end
+    gate = Queue.new
+
+    writers = cards.each_slice(6).map do |batch|
+      in_thread(gate) do
+        batch.each do |card|
+          card = Card.find(card.id)
+          card.update! description: content_with(blob(23))
+          card.move_to(@boards.last)
+          card.image.detach
+        end
+      end
+    end
+    workers = 2.times.map do
+      in_thread(gate) do
+        10.times { Storage::MaterializeJob.perform_now(@account) }
+      end
+    end
+
+    4.times { gate.push(true) }
+    (writers + workers).each(&:value)
+    materialize
+
+    assert_equal 12 * 23, @account.bytes_used
+    assert_equal 0, @boards.first.bytes_used
+    assert_equal 12 * 23, @boards.last.bytes_used
+    assert_empty Storage::Entry.where(account: @account)
+    assert_equal 12, Storage::Ledger.where(account: @account).count
+  end
+
+  private
+    def in_thread(gate, &block)
+      Thread.new do
+        ApplicationRecord.connection_pool.with_connection do
+          Current.set(account: @account, user: @owner) do
+            gate.pop
+            block.call
+          end
+        end
+      end
+    end
+end
diff --git a/test/models/storage/entry_test.rb b/test/models/storage/entry_test.rb
new file mode 100644
index 0000000..d4065f1
--- /dev/null
+++ b/test/models/storage/entry_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Storage::EntryTest < ActiveSupport::TestCase
+  include StorageTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "coalesces a burst of changes into a single job" do
+    assert_enqueued_jobs 1, only: Storage::MaterializeJob do
+      @card.image.attach blob(11)
+      @card.update! description: content_with(blob(23), blob(37))
+      comments(:logo_agreement_jz).update! body: content_with(blob(41))
+    end
+
+    assert_equal 4, Storage::Entry.count
+    materialize
+    assert_equal 112, @account.bytes_used
+  end
+
+  test "consumes bounded batches and schedules the next batch" do
+    stub_const Storage::Entry, :BATCH_SIZE, 2 do
+      @card.update! description: content_with(blob(11), blob(23), blob(37))
+
+      Storage::Entry.materialize_now(@account)
+      assert_equal 1, Storage::Entry.count
+      assert_operator @account.bytes_used, :<, 71
+
+      materialize
+      assert_equal 71, @account.bytes_used
+      assert_equal 71, @board.bytes_used
+      assert_empty Storage::Entry.all
+    end
+  end
+
+  test "repeated and out of order jobs cannot count the same entries twice" do
+    @card.image.attach blob(23)
+    first_job = enqueued_jobs.find { |job| job[:job] == Storage::MaterializeJob }
+    materialize
+    @card.update! description: content_with(blob(41))
+    materialize
+
+    2.times { ActiveJob::Base.execute(first_job) }
+
+    assert_equal 64, @account.bytes_used
+    assert_equal 64, @board.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "failed materialization rolls back counters, ledgers, and consumption" do
+    @card.image.attach blob(23)
+    Storage::Total.any_instance.stubs(:increment!).raises("interrupted")
+
+    assert_raises(RuntimeError) { Storage::Entry.materialize_now(@account) }
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+    assert_empty Storage::Ledger.all
+    assert_equal 1, Storage::Entry.count
+
+    Storage::Total.any_instance.unstub(:increment!)
+    materialize
+    assert_equal 23, @account.bytes_used
+    assert_equal 23, @board.bytes_used
+  end
+
+  test "recurring recovery finds work even when its original job was lost" do
+    @card.image.attach blob(23)
+    clear_enqueued_jobs
+
+    Storage::Entry.materialize_all_later
+    materialize
+
+    assert_equal 23, @account.bytes_used
+    assert_equal 23, @board.bytes_used
+  end
+
+  test "a move does not need to load blobs or attachments" do
+    @card.image.attach blob(23)
+    materialize
+    @card.move_to(boards(:private))
+
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] }
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      materialize
+    end
+
+    assert_equal 23, boards(:private).bytes_used
+    assert_equal 0, @board.bytes_used
+    assert_not queries.any? { |sql| sql.match?(/active_storage_(attachments|blobs)/) }
+  end
+
+  test "deleted sources are removed correctly over multiple batches" do
+    stub_const Storage::Entry, :BATCH_SIZE, 2 do
+      @card.update! description: content_with(blob(11), blob(23), blob(37))
+      materialize
+      @card.destroy!
+      materialize
+
+      assert_equal 0, @account.bytes_used
+      assert_equal 0, @board.bytes_used
+      assert_empty Storage::Ledger.all
+      assert_empty Storage::Entry.all
+    end
+  end
+
+  test "account deletion before the first total is created is harmless" do
+    @card.image.attach blob(23)
+    stale_account = Account.find(@account.id)
+    @account.destroy!
+
+    assert_nothing_raised { Storage::Entry.materialize_now(stale_account) }
+    assert_not Storage::Total.exists?(account: stale_account)
+  end
+
+  test "account deletion between finding and locking its total is harmless" do
+    @card.image.attach blob(23)
+    total = Storage::Total.for(@account)
+    Storage::Total.stubs(:for).returns(total)
+    @account.destroy!
+
+    assert_nothing_raised { Storage::Entry.materialize_now(@account) }
+    assert_not Storage::Total.exists?(account: @account)
+  end
+
+  test "does not swallow database errors for an existing account" do
+    Storage::Total.stubs(:for).raises(ActiveRecord::InvalidForeignKey)
+
+    assert_raises(ActiveRecord::InvalidForeignKey) { Storage::Entry.materialize_now(@account) }
+  end
+
+  test "deleting an account cleans derived storage data and discards its jobs" do
+    @card.image.attach blob(23)
+    materialize
+    @card.update! description: content_with(blob(41))
+    assert Storage::Entry.exists?(account: @account)
+    assert Storage::Ledger.exists?(account: @account)
+    assert Storage::Total.exists?(account: @account)
+
+    @account.destroy!
+    materialize
+
+    assert_not Storage::Entry.exists?(account: @account)
+    assert_not Storage::Ledger.exists?(account: @account)
+    assert_not Storage::Total.exists?(account: @account)
+  end
+end
