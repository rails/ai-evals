+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  include StorageTestHelper
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "accounts and boards start with no storage usage" do
+    assert_usage 0
+  end
+
+  test "card images are counted in the background" do
+    @card.image.attach blob(123)
+
+    assert_usage 0
+    materialize
+    assert_usage 123
+  end
+
+  test "counts board descriptions, card descriptions, and comments across all boards" do
+    @board.update! public_description: content_with(blob(11))
+    @card.update! description: content_with(blob(23), blob(37))
+    comments(:logo_agreement_jz).update! body: content_with(blob(41))
+    other_card = boards(:private).cards.create!(creator: users(:david))
+    other_card.image.attach blob(53)
+
+    materialize
+
+    assert_equal 112, @board.bytes_used
+    assert_equal 53, boards(:private).bytes_used
+    assert_equal 165, @account.bytes_used
+  end
+
+  test "counts images on drafts and closed cards" do
+    draft = @board.cards.create!(creator: users(:david))
+    draft.image.attach blob(13)
+    cards(:shipping).image.attach blob(17)
+
+    materialize
+    assert_usage 30
+  end
+
+  test "ignores unattached uploads, avatars, exports, previews, variants, and other rich text fields" do
+    blob(1_000)
+    users(:david).avatar.attach blob(2_000)
+    Account::Export.create!(account: @account, user: users(:david)).file.attach blob(3_000)
+
+    original = blob(4_000)
+    original.preview_image.attach blob(5_000)
+    variant = original.variant_records.create!(variation_digest: "test")
+    variant.image.attach blob(6_000)
+    other_text = ActionText::RichText.create!(account: @account, record: @card, name: "other", body: content_with(blob(7_000)))
+    @card.image.attach blob(19)
+
+    materialize
+    assert_usage 19
+    assert other_text.embeds.attached?
+  end
+
+  test "counts attachment references rather than deduplicating shared blobs" do
+    shared = blob(23)
+    @card.image.attach shared
+    @card.update! description: content_with(shared, shared)
+    @board.update! public_description: content_with(shared)
+
+    materialize
+    assert_usage 69
+  end
+
+  test "isolates accounts even when no account context is set" do
+    Current.without_account do
+      cards(:radio).image.attach blob(101, account: accounts(:initech))
+    end
+    @card.image.attach blob(23)
+
+    materialize
+    assert_usage 23
+    assert_equal 101, accounts(:initech).bytes_used
+    assert_equal 101, boards(:miltons_wish_list).bytes_used
+  end
+
+  test "replacing and clearing an image updates usage" do
+    @card.image.attach blob(23)
+    materialize
+    assert_usage 23
+
+    @card.image.attach blob(41)
+    materialize
+    assert_usage 41
+
+    @card.update! image: nil
+    materialize
+    assert_usage 0
+  end
+
+  test "removing embeds and deleting comments updates usage" do
+    comment = comments(:logo_agreement_jz)
+    kept_blob = blob(17)
+    @card.update! description: content_with(kept_blob, blob(23))
+    comment.update! body: content_with(blob(41))
+    @board.update! public_description: content_with(blob(53))
+    materialize
+    assert_usage 134
+
+    @card.update! description: content_with(kept_blob)
+    comment.destroy!
+    @board.update! public_description: "No more attachments"
+    materialize
+    assert_usage 17
+  end
+
+  test "purging and detaching images removes their usage" do
+    [ :purge, :purge_later, :detach ].each do |method|
+      @card.reload.image.attach blob(23)
+      materialize
+      assert_usage 23
+
+      @card.image.public_send(method)
+      materialize
+      assert_usage 0
+    end
+  end
+
+  test "bulk detaching embeds leaves the blobs but removes their usage" do
+    @card.update! description: content_with(blob(23), blob(41))
+    materialize
+    assert_usage 64
+
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      @card.description.embeds.detach
+      materialize
+    end
+    assert_usage 0
+  end
+
+  test "a stale attachment cannot subtract its bytes twice" do
+    @card.image.attach blob(23)
+    first = @card.image.attachment
+    second = ActiveStorage::Attachment.find(first.id)
+    materialize
+
+    first.delete
+    second.destroy!
+    materialize
+    assert_usage 0
+  end
+
+  test "moves images, descriptions, and comment files without changing account usage" do
+    @card.image.attach blob(11)
+    @card.update! description: content_with(blob(23))
+    comments(:logo_agreement_jz).update! body: content_with(blob(37))
+    @board.update! public_description: content_with(blob(41))
+    materialize
+
+    @card.move_to(boards(:private))
+    materialize
+
+    assert_equal 41, @board.bytes_used
+    assert_equal 71, boards(:private).bytes_used
+    assert_equal 112, @account.bytes_used
+  end
+
+  test "moves work with pending attachments and repeated moves before jobs run" do
+    @card.image.attach blob(23)
+    @card.move_to(boards(:private))
+    @card.move_to(@board)
+    @card.move_to(boards(:private))
+    @card.update! description: content_with(blob(41))
+
+    materialize
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 64, boards(:private).bytes_used
+    assert_equal 64, @account.bytes_used
+  end
+
+  test "deleting a card removes all its counted attachments but not its board description" do
+    @card.image.attach blob(11)
+    @card.update! description: content_with(blob(23))
+    comments(:logo_agreement_jz).update! body: content_with(blob(37))
+    @board.update! public_description: content_with(blob(41))
+    materialize
+
+    @card.destroy!
+    materialize
+
+    assert_usage 41
+    assert_not Storage::Ledger.exists?(record_type: "Card", record_id: @card.id)
+  end
+
+  test "deleting a board removes its usage from the account" do
+    @card.image.attach blob(11)
+    @board.update! public_description: content_with(blob(23))
+    other_card = boards(:private).cards.create!(creator: users(:david))
+    other_card.image.attach blob(37)
+    materialize
+
+    @board.destroy!
+    materialize
+
+    assert_equal 37, @account.bytes_used
+    assert_equal 37, boards(:private).bytes_used
+    assert_not Storage::Total.exists?(owner: @board)
+    assert_not Storage::Ledger.exists?(board_id: @board.id)
+  end
+
+  test "attachments deleted before their jobs run do not leave usage behind" do
+    @card.image.attach blob(23)
+    comments(:logo_agreement_jz).update! body: content_with(blob(41))
+    @card.destroy!
+
+    materialize
+    assert_usage 0
+  end
+
+  test "rolled back attachments and removals do not change usage" do
+    @card.image.attach blob(23)
+    materialize
+
+    ActiveStorage::Attachment.transaction do
+      @card.image.attachment.destroy!
+      raise ActiveRecord::Rollback
+    end
+    materialize
+    assert_usage 23
+
+    Card.transaction do
+      cards(:layout).image.attach blob(41)
+      raise ActiveRecord::Rollback
+    end
+    materialize
+    assert_usage 23
+  end
+
+  test "reading totals only reads a single cached value and never loads attachments" do
+    @card.image.attach blob(23)
+    materialize
+
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] unless event.payload[:name] == "SCHEMA" }
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      assert_usage 23
+    end
+
+    assert_equal 2, queries.size
+    assert queries.all? { |sql| sql.include?("storage_totals") }
+  end
+
+  test "supports totals larger than a 32 bit integer" do
+    large_blob = blob(1)
+    large_blob.update! byte_size: 5.gigabytes
+    @card.image.attach large_blob
+
+    materialize
+    assert_usage 5.gigabytes
+  end
+
+  private
+    def assert_usage(bytes)
+      assert_equal bytes, @board.bytes_used
+      assert_equal bytes, @account.bytes_used
+    end
+end
