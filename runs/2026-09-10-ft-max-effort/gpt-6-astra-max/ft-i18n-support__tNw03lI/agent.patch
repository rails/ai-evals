diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..888e666
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,27 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+let cachedContent
+let cachedTranslations
+
+function translations() {
+  const content = getMetaContent("translations")
+  if (content !== cachedContent || !cachedTranslations) {
+    cachedContent = content
+    cachedTranslations = JSON.parse(content || "{}")
+  }
+  return cachedTranslations
+}
+
+export function locale() {
+  return translations().locale || "en-US"
+}
+
+export function translate(key, values = {}) {
+  let message = key.split(".").reduce((value, part) => value?.[part], translations())
+  if (typeof message === "object" && message !== null) {
+    message = values.count === 1 && message.one ? message.one : message.other
+  }
+  if (typeof message !== "string") throw new Error(`Missing translation: ${key}`)
+
+  return message.replace(/%\{(\w+)\}/g, (_, name) => String(values[name] ?? ""))
+}
