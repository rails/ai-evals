diff --git a/app/javascript/initializers/localization.js b/app/javascript/initializers/localization.js
new file mode 100644
index 0000000..e084cae
--- /dev/null
+++ b/app/javascript/initializers/localization.js
@@ -0,0 +1,38 @@
+import { Turbo } from "@hotwired/turbo-rails"
+import { locale, translate } from "helpers/i18n_helpers"
+
+// Locale changes force a full Turbo reload (see the locale meta tag). Also
+// discard previously cached documents, including the offline cache.
+try {
+  const previousLocale = sessionStorage.getItem("fizzy-locale")
+  if (previousLocale !== locale() && (previousLocale || locale() !== "en-US")) {
+    Turbo.cache.clear()
+    Turbo.offline?.clearCache()
+  }
+  sessionStorage.setItem("fizzy-locale", locale())
+} catch {
+  // Storage may be unavailable in private browsing.
+}
+
+// Native browser validation follows the browser's language, not the app's.
+// Keep English's existing behavior, but provide Japanese for Japanese pages.
+document.addEventListener("invalid", (event) => {
+  if (locale() !== "ja-JP") return
+  const input = event.target
+  const validity = input.validity
+  if (!validity || validity.customError) return
+
+  let key = "invalid"
+  if (validity.valueMissing) key = "required"
+  else if (validity.typeMismatch) key = input.type === "email" ? "email" : "url"
+  else if (validity.patternMismatch) key = "pattern"
+  else if (validity.tooShort) key = "too_short"
+  else if (validity.tooLong) key = "too_long"
+  else if (validity.rangeUnderflow) key = "range_underflow"
+  else if (validity.rangeOverflow) key = "range_overflow"
+
+  input.setCustomValidity(input.dataset.validationMessage || translate(`validation.${key}`, {
+    count: validity.tooShort ? input.minLength : input.maxLength, min: input.min, max: input.max
+  }))
+  input.addEventListener("input", () => input.setCustomValidity(""), { once: true })
+}, true)
