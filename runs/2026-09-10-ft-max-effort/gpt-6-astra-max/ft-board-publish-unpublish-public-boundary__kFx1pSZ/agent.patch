diff --git a/app/controllers/public/boards/columns_controller.rb b/app/controllers/public/boards/columns_controller.rb
new file mode 100644
index 0000000..87cead3
--- /dev/null
+++ b/app/controllers/public/boards/columns_controller.rb
@@ -0,0 +1,27 @@
+class Public::Boards::ColumnsController < Public::BaseController
+  before_action :set_column
+
+  def show
+    set_page_and_extract_portion_from @cards.latest.with_golden_first.preloaded
+    fresh_when etag: [ @board, @column, @title, @page.records, Current.account ]
+  end
+
+  private
+    def set_column
+      case params[:id]
+      when "stream"
+        @title = "Maybe?"
+        @cards = @board.cards.awaiting_triage
+      when "not_now"
+        @title = "Not Now"
+        @cards = @board.cards.postponed
+      when "closed"
+        @title = "Done"
+        @cards = @board.cards.published.closed
+      else
+        @column = @board.columns.find(params[:id])
+        @title = @column.name
+        @cards = @board.cards.active.where(column: @column)
+      end
+    end
+end
