+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "anyone with the key can view the board" do
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage))
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:buy_domain))
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+
+  test "private boards can be shared without granting account access" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.publication.key)
+
+    assert_response :success
+    assert_select "h1", text: board.name
+  end
+
+  test "signed-in users from another account can view public boards" do
+    sign_in_as :mike
+
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+  end
+
+  test "drafts are not shown even when requested through filters" do
+    cards(:buy_domain).drafted!
+
+    get public_board_path(@key), params: { indexed_by: "draft", card_ids: [ cards(:buy_domain).id ] }
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:buy_domain)), count: 0
+    assert_not_includes response.body, cards(:buy_domain).title
+  end
+
+  test "unknown keys and board IDs do not grant access" do
+    [ "invalid-key", @board.id ].each do |key|
+      get public_board_path(key)
+      assert_response :not_found
+    end
+  end
+
+  test "keys are scoped to the account" do
+    board = boards(:miltons_wish_list)
+    board.publish
+
+    get public_board_path(board.publication.key)
+
+    assert_response :not_found
+  end
+
+  test "unpublishing revokes access even with a cached response" do
+    get public_board_path(@key)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    @board.unpublish
+
+    get public_board_path(@key), headers: { "If-None-Match" => etag }
+    assert_response :not_found
+
+    @board.publish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_path(@board.publication.key)
+    assert_response :success
+  end
+
+  test "public pages do not expose private controls, streams, or email addresses even to admins" do
+    sign_in_as :kevin
+
+    public_paths.each do |path|
+      get path
+
+      assert_response :success
+      assert_select "form", count: 0
+      assert_select "turbo-cable-stream-source", count: 0
+      assert_select "meta[name=turbo-cache-control][content=no-cache]"
+      assert_equal "no-referrer", response.headers["Referrer-Policy"]
+      assert_equal "none", response.headers["X-Robots-Tag"]
+      assert_not_includes response.body, users(:david).identity.email_address
+    end
+  end
+
+  test "public pages cannot be used to modify resources" do
+    public_paths.each do |path|
+      [ :post, :patch, :delete ].each do |method|
+        public_send method, path
+        assert_response :not_found
+      end
+    end
+
+    assert @board.reload.published?
+    assert cards(:logo).reload.published?
+  end
+
+  test "public pages do not reuse private JSON representations" do
+    public_paths.each do |path|
+      get path, as: :json
+      assert_response :not_acceptable
+    end
+  end
+
+  test "public pages are unavailable for canceled accounts" do
+    @board.account.create_cancellation!(initiated_by: users(:jason))
+
+    public_paths.each do |path|
+      get path
+      assert_response :not_found
+    end
+  end
+
+  test "query parameters cannot override the secret URL key" do
+    get public_board_path("invalid-key"), params: { board_key: @key }
+    assert_response :not_found
+  end
+
+  test "public board cards are paginated" do
+    with_current_user :kevin do
+      20.times { |index| @board.cards.create!(title: "Public card #{index}", status: :published) }
+    end
+
+    expected_paths = @board.cards.awaiting_triage.latest.with_golden_first.map { |card| public_board_card_path(@key, card) }
+    actual_paths = []
+    next_page = public_board_path(@key)
+    page_count = 0
+
+    while next_page
+      get next_page
+      assert_response :success
+
+      actual_paths.concat css_select("a.card__link").pluck("href")
+      next_page = css_select("a.pagination-link").first&.[]("href")
+      page_count += 1
+    end
+
+    assert_equal expected_paths, actual_paths
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def public_paths
+      [
+        public_board_path(@key),
+        public_board_column_path(@key, columns(:writebook_triage)),
+        public_board_card_path(@key, cards(:logo))
+      ]
+    end
+end
