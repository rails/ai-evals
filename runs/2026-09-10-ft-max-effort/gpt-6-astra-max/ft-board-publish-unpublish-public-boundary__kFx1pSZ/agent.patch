diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..ca6e83e
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publishing creates a secret key and touches the board" do
+    freeze_time do
+      assert_changes -> { @board.reload.updated_at } do
+        @board.publish
+      end
+    end
+
+    assert @board.published?
+    assert_equal @board.account, @board.publication.account
+    assert_match /\A[1-9A-HJ-NP-Za-km-z]{24,}\z/, @board.publication.key
+  end
+
+  test "publishing is idempotent" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference "Publication.count" do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublishing revokes the key and republishing generates a new one" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_difference "Publication.count", -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.reload.published?
+    assert_not Publication.exists?(key: key)
+
+    @board.publish
+    assert_not_equal key, @board.publication.key
+  end
+
+  test "unpublishing an unpublished board is harmless" do
+    assert_no_difference "Publication.count" do
+      @board.unpublish
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+
+    assert_difference "Publication.count", -1 do
+      @board.destroy!
+    end
+  end
+
+  test "publishing reloads a stale publication association" do
+    other_instance = Board.find(@board.id)
+    assert_nil other_instance.publication
+    @board.publish
+
+    assert_no_difference "Publication.count" do
+      other_instance.publish
+    end
+
+    assert_equal @board.publication.key, other_instance.publication.key
+  end
+
+  test "different boards have different secret keys" do
+    @board.publish
+    boards(:private).publish
+
+    assert_not_equal @board.publication.key, boards(:private).publication.key
+  end
+
+  test "unpublishing clears publication state immediately and is idempotent" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.publication
+
+    assert_no_difference "Publication.count" do
+      @board.unpublish
+    end
+  end
+
+  test "the database enforces one publication per board" do
+    @board.publish
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Publication.create!(board: @board)
+    end
+  end
+
+  test "the database enforces unique publication keys" do
+    @board.publish
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Publication.create!(board: boards(:private), key: @board.publication.key)
+    end
+  end
+end
