@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+    @card = cards(:logo)
+  end
+
+  test "anyone with the key can view a published card by number" do
+    @card.update!(description: "Public card description")
+
+    get public_board_card_path(@key, @card.number)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_includes response.body, "Public card description"
+    assert_select "a[href=?]", public_board_path(@key)
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+  end
+
+  test "drafts cannot be opened" do
+    @card.drafted!
+
+    get public_board_card_path(@key, @card.number)
+
+    assert_response :not_found
+  end
+
+  test "cards are scoped to the published board" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_card_path(board.publication.key, @card.number)
+
+    assert_response :not_found
+  end
+
+  test "card numbers are resolved within the board's account" do
+    board = boards(:miltons_wish_list)
+    board.publish
+
+    get public_board_card_path(board.publication.key, cards(:radio).number, script_name: board.account.slug)
+
+    assert_response :success
+    assert_select "h1", text: cards(:radio).title
+    assert_not_includes response.body, @card.title
+  end
+
+  test "invalid keys, missing cards, and revoked publications are not found" do
+    get public_board_card_path("invalid-key", @card.number)
+    assert_response :not_found
+
+    get public_board_card_path(@key, 999_999)
+    assert_response :not_found
+
+    @board.unpublish
+    get public_board_card_path(@key, @card.number)
+    assert_response :not_found
+  end
+
+  test "closed and postponed cards can still be opened" do
+    with_current_user :kevin do
+      cards(:text).postpone
+    end
+
+    [ cards(:text), cards(:shipping) ].each do |card|
+      get public_board_card_path(@key, card)
+      assert_response :success
+      assert_select "h1", text: card.title
+    end
+  end
+
+  test "a revoked card is not served from cache" do
+    get public_board_card_path(@key, @card)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    @board.unpublish
+
+    get public_board_card_path(@key, @card), headers: { "If-None-Match" => etag }
+    assert_response :not_found
+  end
+
+  test "a card changed to a draft is not served from cache" do
+    get public_board_card_path(@key, @card)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    @card.drafted!
+
+    get public_board_card_path(@key, @card), headers: { "If-None-Match" => etag }
+    assert_response :not_found
+  end
+
+  test "a card moved to another board is no longer public" do
+    with_current_user :kevin do
+      @card.update!(board: boards(:private))
+    end
+
+    get public_board_card_path(@key, @card)
+
+    assert_response :not_found
+  end
+
+  test "card numbers must be numeric" do
+    [ @card.id, "#{@card.number}suffix" ].each do |number|
+      get "#{public_board_path(@key)}/cards/#{number}"
+      assert_response :not_found
+    end
+  end
+
+  test "card content and steps are escaped and read only" do
+    with_current_user :kevin do
+      @card.update!(title: "Fix `<script>`", description: "<p>Some <strong>details</strong></p>")
+    end
+    @card.steps.create!(content: "<unfinished>")
+    @card.steps.create!(content: "Finished", completed: true)
+
+    get public_board_card_path(@key, @card)
+
+    assert_response :success
+    assert_select "h1 code", text: "<script>"
+    assert_select ".card__description strong", text: "details"
+    assert_select "li", text: "○ <unfinished>"
+    assert_select "li", text: "✓ Finished"
+    assert_select "form", count: 0
+    assert_select "input", count: 0
+  end
+end
