+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,19 @@
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+
+  layout "public"
+
+  before_action :set_board
+  before_action :protect_publication_key
+
+  private
+    def set_board
+      raise ActiveRecord::RecordNotFound unless Current.account.active?
+
+      @board = Current.account.boards.published.includes(:publication).find_by!(publications: { key: request.path_parameters[:board_key] || request.path_parameters[:key] })
+    end
+
+    def protect_publication_key
+      response.headers["Referrer-Policy"] = "no-referrer"
+    end
+end
