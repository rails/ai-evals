+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admins can publish" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "admins can unpublish" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "publishing as JSON returns the board with its public URL" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal @board.id, response.parsed_body["id"]
+    assert_equal public_board_url(@board.reload.publication.key), response.parsed_body["public_url"]
+  end
+
+  test "unpublishing as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "members cannot publish even their own boards" do
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+
+    assert_no_difference "Publication.count" do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "members cannot unpublish even their own boards" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    assert_no_difference "Publication.count" do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "owners can publish" do
+    @board.accesses.grant_to users(:jason)
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish boards they cannot access" do
+    boards(:private).accesses.destroy_all
+
+    post board_publication_path(boards(:private)), as: :json
+
+    assert_response :not_found
+    assert_not boards(:private).reload.published?
+  end
+
+  test "admins cannot publish boards in another account" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+
+    assert_response :not_found
+    assert_not boards(:miltons_wish_list).reload.published?
+  end
+
+  test "publishing and unpublishing require authentication" do
+    sign_out
+
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board)
+    assert_response :redirect
+    assert @board.reload.published?
+  end
+
+  test "repeated publication requests preserve the key" do
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    url = response.parsed_body["public_url"]
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert_equal url, response.parsed_body["public_url"]
+
+    2.times do
+      delete board_publication_path(@board), as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "admins see publication controls" do
+    get edit_board_path(@board)
+    assert_select "form[action=?]", board_publication_path(@board)
+  end
+
+  test "members do not see publication controls on their own boards" do
+    logout_and_sign_in_as :david
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "form[action=?]", board_publication_path(@board), count: 0
+  end
+end
