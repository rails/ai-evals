+require "test_helper"
+
+class Public::Boards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+    @column = columns(:writebook_triage)
+  end
+
+  test "anyone with the key can view a column" do
+    get public_board_column_path(@key, @column)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo))
+    assert_select "a[href=?]", public_board_path(@key)
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+  end
+
+  test "only published active cards in the column are shown" do
+    cards(:logo).drafted!
+
+    get public_board_column_path(@key, @column)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo)), count: 0
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:text)), count: 0
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:layout))
+  end
+
+  test "columns are scoped to the published board" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_column_path(board.publication.key, @column)
+
+    assert_response :not_found
+  end
+
+  test "invalid keys, missing columns, and revoked publications are not found" do
+    get public_board_column_path("invalid-key", @column)
+    assert_response :not_found
+
+    get public_board_column_path(@key, "missing-column")
+    assert_response :not_found
+
+    @board.unpublish
+    get public_board_column_path(@key, @column)
+    assert_response :not_found
+  end
+
+  test "built-in columns show published cards in the matching state" do
+    with_current_user :kevin do
+      cards(:text).postpone
+    end
+
+    {
+      "stream" => cards(:buy_domain),
+      "not_now" => cards(:text),
+      "closed" => cards(:shipping)
+    }.each do |column_id, card|
+      get public_board_column_path(@key, column_id)
+      assert_response :success
+      assert_select "a[href=?]", public_board_card_path(@key, card)
+
+      card.drafted!
+
+      get public_board_column_path(@key, column_id)
+      assert_response :success
+      assert_select "a[href=?]", public_board_card_path(@key, card), count: 0
+    end
+  end
+
+  test "cards from another board are excluded even if they reference this column" do
+    card = cards(:buy_domain)
+    card.update_columns(board_id: boards(:private).id, column_id: @column.id)
+
+    get public_board_column_path(@key, @column)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, card), count: 0
+  end
+
+  test "column cards are paginated" do
+    with_current_user :kevin do
+      20.times { |index| @board.cards.create!(title: "Column card #{index}", column: @column, status: :published) }
+    end
+
+    expected_paths = @board.cards.active.where(column: @column).latest.with_golden_first.map { |card| public_board_card_path(@key, card) }
+    actual_paths = []
+    next_page = public_board_column_path(@key, @column)
+    page_count = 0
+
+    while next_page
+      get next_page
+      assert_response :success
+
+      actual_paths.concat css_select("a.card__link").pluck("href")
+      next_page = css_select("a.pagination-link").first&.[]("href")
+      page_count += 1
+    end
+
+    assert_equal expected_paths, actual_paths
+    assert_operator page_count, :>, 1
+  end
+
+  test "a revoked column is not served from cache" do
+    get public_board_column_path(@key, @column)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    @board.unpublish
+
+    get public_board_column_path(@key, @column), headers: { "If-None-Match" => etag }
+    assert_response :not_found
+  end
+end
