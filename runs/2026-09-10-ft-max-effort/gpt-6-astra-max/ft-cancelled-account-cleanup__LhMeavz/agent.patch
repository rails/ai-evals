diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..b21da04
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates overdue accounts but preserves recent cancellations and active accounts" do
+    overdue = accounts(:"37s")
+    recent = accounts(:initech)
+    active = accounts(:acme)
+
+    cancel_at overdue, 31.days.ago
+    cancel_at recent, 29.days.ago
+
+    Current.without_account do
+      assert_difference "Account.count", -1 do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert_not Account.exists?(overdue.id)
+    assert recent.reload.cancelled?
+    assert active.reload.active?
+  end
+
+  test "requires cancellation to be strictly more than 30 days old" do
+    freeze_time do
+      overdue = accounts(:"37s")
+      at_boundary = accounts(:initech)
+      within_grace_period = Account.create_with_owner(account: { name: "Recent cancellation" }, owner: { name: "David", identity: identities(:david) })
+
+      cancel_at overdue, 30.days.ago - 1.second
+      cancel_at at_boundary, 30.days.ago
+      cancel_at within_grace_period, 30.days.ago + 1.second
+
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+
+      assert_not Account.exists?(overdue.id)
+      assert Account.exists?(at_boundary.id)
+      assert Account.exists?(within_grace_period.id)
+    end
+  end
+
+  test "processes multiple overdue accounts and can run again safely" do
+    cancel_at accounts(:"37s"), 31.days.ago
+    cancel_at accounts(:initech), 32.days.ago
+
+    Current.without_account do
+      assert_difference "Account.count", -2 do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert_no_difference "Account.count" do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert accounts(:acme).reload.active?
+  end
+
+  private
+    def cancel_at(account, time)
+      account.cancel(initiated_by: account.users.where.not(role: :system).first!)
+      account.cancellation.update!(created_at: time)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..dbf2a96
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,207 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  FILTER_JOIN_TABLES = %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ]
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.user = @user
+  end
+
+  test "incinerates all account-owned database rows without touching other accounts or shared identities" do
+    other_account = accounts(:initech)
+    shared_user = other_account.users.create!(name: "David", identity: @user.identity)
+    populate_account_records(@user, cards(:logo))
+    populate_account_records(users(:mike), cards(:radio))
+    other_counts = tenant_record_counts(other_account)
+    totals_to_remove = Storage::Total.where(owner: [ @account, boards(:writebook) ]).ids
+    totals_to_keep = Storage::Total.where(owner: [ other_account, boards(:miltons_wish_list) ]).ids
+    cancel_overdue
+
+    assert tenant_record_counts(@account).values.sum.positive?
+    assert_equal 2, totals_to_remove.size
+    assert_equal 2, totals_to_keep.size
+
+    assert_no_difference [ "Identity.count", "Session.count", "Identity::AccessToken.count" ] do
+      assert_no_enqueued_jobs do
+        @account.incinerate
+      end
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty tenant_record_counts(@account).reject { |_, count| count.zero? }
+    assert_not Storage::Total.exists?(id: totals_to_remove)
+    assert_equal totals_to_keep.size, Storage::Total.where(id: totals_to_keep).count
+    assert_equal other_counts, tenant_record_counts(other_account)
+    assert_equal identities(:david), shared_user.reload.identity
+    assert other_account.reload.active?
+  end
+
+  test "incinerates all filter join tables but preserves other accounts' filter relationships" do
+    filter = populate_filter_relationships(@user)
+    other_filter = populate_filter_relationships(users(:mike))
+    other_counts = filter_relationship_counts(other_filter)
+    cancel_overdue
+
+    assert filter_relationship_counts(filter).values.all?(&:positive?)
+
+    @account.incinerate
+
+    assert filter_relationship_counts(filter).values.all?(&:zero?)
+    assert_equal other_counts, filter_relationship_counts(other_filter)
+  end
+
+  test "incinerates orphaned records and unattached uploads" do
+    card = cards(:logo)
+    populate_account_records(@user, card)
+    cancel_overdue
+    card.delete
+    @user.delete
+
+    assert ActionText::RichText.where(account: @account).exists?
+    assert ActiveStorage::Attachment.where(record: card).exists?
+    assert ActiveStorage::Blob.unattached.where(account: @account).exists?
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty tenant_record_counts(@account).reject { |_, count| count.zero? }
+  end
+
+  test "removes search records and their SQLite FTS entries without affecting another account" do
+    cards(:logo).reindex
+    cards(:radio).reindex
+    records = Search::Record.for(@account.id).where(account_id: @account.id)
+    other_records = Search::Record.for(accounts(:initech).id).where(account_id: accounts(:initech).id)
+    search_ids = records.ids
+    other_search_ids = other_records.ids
+    cancel_overdue
+
+    assert search_ids.any?
+    assert other_search_ids.any?
+
+    @account.incinerate
+
+    assert_empty records.reload
+    assert_equal other_search_ids, other_records.ids
+
+    if Fizzy.db_adapter.sqlite?
+      assert_not Search::Record::SQLite::Fts.exists?(rowid: search_ids)
+      assert_equal other_search_ids.size, Search::Record::SQLite::Fts.where(rowid: other_search_ids).count
+    end
+  end
+
+  test "rolls back all deletions if incineration fails" do
+    populate_account_records(@user, cards(:logo))
+    filter = populate_filter_relationships(@user)
+    cancel_overdue
+    counts = tenant_record_counts(@account)
+    filter_counts = filter_relationship_counts(filter)
+    total_ids = Storage::Total.ids
+    @account.stubs(:delete).raises(ActiveRecord::StatementInvalid, "Deletion failed")
+
+    assert_raises ActiveRecord::StatementInvalid do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert_equal counts, tenant_record_counts(@account)
+    assert_equal filter_counts, filter_relationship_counts(filter)
+    assert_equal total_ids.sort, Storage::Total.ids.sort
+
+    if Fizzy.db_adapter.sqlite?
+      search_ids = Search::Record.where(account_id: @account.id).ids
+      assert_equal search_ids.size, Search::Record::SQLite::Fts.where(rowid: search_ids).count
+    end
+  end
+
+  test "does not incinerate an account reactivated after selection" do
+    cancel_overdue
+    selected_account = Account.due_for_incineration.find(@account.id)
+    assert selected_account.cancelled?
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      selected_account.incinerate
+    end
+
+    assert @account.reload.active?
+  end
+
+  test "rechecks the grace period if an account was reactivated and cancelled again" do
+    cancel_overdue
+    selected_account = Account.due_for_incineration.find(@account.id)
+    assert selected_account.cancelled?
+    @account.reactivate
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference "Account.count" do
+      selected_account.incinerate
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  private
+    def populate_account_records(user, card)
+      Current.set(account: user.account, user: user) do
+        card.board.create_publication!
+        card.create_activity_spike!
+        card.create_not_now!(user: user)
+        card.steps.create!(content: "A step")
+        user.create_settings! unless user.settings
+        user.notification_bundles.create!
+        user.search_queries.create!(terms: "search history")
+        SsrfProtection.stubs(:resolve_public_ip).returns("8.8.8.8")
+        user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/#{user.id}")
+        Account::Import.create!(account: user.account, identity: user.identity, status: :completed, completed_at: Time.current)
+
+        card.image.attach io: StringIO.new("account attachment"), filename: "attachment.txt", content_type: "text/plain"
+        ActiveStorage::VariantRecord.create!(blob: card.image.blob, variation_digest: "thumbnail")
+        ActiveStorage::Blob.create_and_upload! io: StringIO.new("unattached upload"), filename: "unattached.txt", content_type: "text/plain"
+        card.board.materialize_storage
+        user.account.materialize_storage
+        card.reindex
+      end
+    end
+
+    def cancel_overdue
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update!(created_at: 31.days.ago)
+    end
+
+    def tenant_record_counts(account)
+      connection = ApplicationRecord.connection
+      account_id = connection.quote(account.id_for_database)
+
+      connection.tables.filter_map do |table|
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          [ table, connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{account_id}") ]
+        end
+      end.to_h
+    end
+
+    def populate_filter_relationships(user)
+      filter = user.filters.create!
+      filter.assignees << user
+      filter.creators << user
+      filter.closers << user
+      filter.board_ids = [ user.account.boards.first!.id ]
+      filter.tags << Tag.create!(account: user.account, title: "Filtered tag")
+
+      # This legacy join table is no longer exposed through Filter's associations.
+      connection = ApplicationRecord.connection
+      connection.execute "INSERT INTO assigners_filters (filter_id, assigner_id) VALUES (#{connection.quote(filter.id_for_database)}, #{connection.quote(user.id_for_database)})"
+      filter
+    end
+
+    def filter_relationship_counts(filter)
+      connection = ApplicationRecord.connection
+      filter_id = connection.quote(filter.id_for_database)
+
+      FILTER_JOIN_TABLES.to_h do |table|
+        [ table, connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE filter_id = #{filter_id}") ]
+      end
+    end
+end
