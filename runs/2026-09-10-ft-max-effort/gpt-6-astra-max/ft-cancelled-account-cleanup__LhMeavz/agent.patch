diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..752d193 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,64 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    # Reactivation takes the same lock, so recheck the cancellation after acquiring it.
+    with_lock do
+      if cancellation && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+        incinerate_storage_totals
+        incinerate_search_records
+
+        self.class.with_connection do |connection|
+          incinerate_filter_relationships(connection)
+          incinerate_account_records(connection)
+        end
+
+        delete
+      end
+    end
+  end
+
+  private
+    def incinerate_storage_totals
+      Storage::Total.where(owner: self).or(Storage::Total.where(owner: boards)).delete_all
+    end
+
+    def incinerate_search_records
+      # On SQLite, destroying search records also removes their FTS5 entries.
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+    end
+
+    def incinerate_filter_relationships(connection)
+      filter_ids = Filter.where(account_id: id).select(:id).to_sql
+
+      tables_with_column(connection, "filter_id").each do |table|
+        connection.delete "DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{filter_ids})"
+      end
+    end
+
+    def incinerate_account_records(connection)
+      # Delete tenant rows directly, including orphaned records and unattached uploads.
+      # Normal destruction callbacks can enqueue jobs and recreate data during cleanup.
+      account_id = connection.quote(id_for_database)
+
+      tables_with_column(connection, "account_id").each do |table|
+        connection.delete "DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{account_id}"
+      end
+    end
+
+    def tables_with_column(connection, column)
+      connection.tables.select { |table| connection.schema_cache.columns_hash(table).key?(column) }
+    end
 end
