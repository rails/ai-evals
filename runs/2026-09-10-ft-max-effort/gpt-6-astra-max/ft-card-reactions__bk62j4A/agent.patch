+++ b/test/system/reactions_test.rb
@@ -0,0 +1,91 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+  end
+
+  test "reacting to a card and removing its last boost" do
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      click_on "Add your own reaction"
+      fill_in "reaction_content", with: "Not yet"
+      click_on "Cancel"
+      assert_no_selector "form.reaction__form"
+
+      click_on "Add your own reaction"
+      fill_in "reaction_content", with: "Great work!"
+      click_on "Submit"
+      assert_selector ".reaction", text: "Great work!"
+    end
+
+    assert_equal "Great work!", @card.reactions.last.content
+    assert_equal users(:david), @card.reactions.last.reacter
+
+    visit_card_column
+    find("##{dom_id(@card, :article)}").hover
+    assert_selector "##{dom_id(@card, :article)} .card__boosts", text: "1"
+
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      find("[data-reaction-delete-target='content']", text: "Great work!").click
+      click_on "Delete this reaction"
+      assert_no_selector ".reaction"
+    end
+
+    assert_empty @card.reactions.reload
+
+    visit_card_column
+    assert_selector "##{dom_id(@card, :article)}"
+    assert_no_selector "##{dom_id(@card, :article)} .card__boosts"
+  end
+
+  test "reacting to a card on a small screen" do
+    page.current_window.resize_to(390, 844)
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reacting)}" do
+      click_on "Add your own reaction"
+      find(".reaction__menu-btn").click
+      find("button[data-emoji='👍']").click
+      click_on "Submit"
+      assert_selector ".reaction", text: "👍"
+    end
+
+    assert_equal "👍", @card.reactions.last.content
+  ensure
+    page.current_window.resize_to(1200, 800)
+  end
+
+  test "comment reactions still support emoji and deletion" do
+    comment = comments(:logo_agreement_jz)
+    visit card_url(@card)
+
+    within "##{dom_id(comment, :reacting)}" do
+      click_on "Add your own reaction"
+      find(".reaction__menu-btn").click
+      find("button[data-emoji='👍']").click
+      click_on "Submit"
+      assert_selector ".reaction", text: "👍"
+
