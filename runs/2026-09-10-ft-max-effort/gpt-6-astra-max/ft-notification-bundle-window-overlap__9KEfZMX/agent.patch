diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..72c25b5
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,65 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :entries, class_name: "Notification::Bundle::Entry", dependent: :delete_all, inverse_of: :bundle
+  has_many :notifications, through: :entries
+
+  scope :pending, -> { where(processed_at: nil) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }, if: -> { starts_at && ends_at }
+
+  attr_readonly :account_id, :user_id, :starts_at, :ends_at
+
+  after_create_commit :deliver_later
+
+  class << self
+    def capture(notification, at: notification.updated_at)
+      user = notification.user
+
+      user.with_lock do
+        if user.receives_bundled_emails? && !notification.creator.system?
+          bundle = find_or_open_for(user, at)
+          bundle.entries.find_or_create_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+
+    private
+      def find_or_open_for(user, at)
+        # Delayed notifications can predate the start of an already-open window.
+        user.notification_bundles.pending.where("ends_at > ?", at).order(:ends_at).lock.first || open_for(user, at)
+      end
+
+      def open_for(user, at)
+        # Never backdate a new window into one that has already been processed.
+        previous_end = user.notification_bundles.order(ends_at: :desc).lock.pick(:ends_at)
+        starts_at = [ at, previous_end ].compact.max
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + user.bundle_email_interval)
+      end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+    end
+  end
+
+  def deliver_now
+    # Capture and delivery share the recipient lock so an email cannot miss an
+    # entry being added concurrently, and duplicate jobs cannot send it twice.
+    user.with_lock do
+      reload(lock: true)
+
+      if processed_at.nil? && ends_at <= Time.current
+        if user.receives_bundled_emails? && notifications.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update!(processed_at: Time.current)
+      end
+    end
+  end
+end
