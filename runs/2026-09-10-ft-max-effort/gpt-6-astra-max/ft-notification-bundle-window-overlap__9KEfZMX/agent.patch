diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..fe9dae4
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  include Rails.application.routes.url_helpers
+  test "digest includes every notification and account-scoped links in both formats" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.capture(notifications(:logo_assignment_kevin), at: Time.current)
+    Notification::Bundle.capture(notifications(:layout_commented_kevin), at: Time.current)
+
+    Current.without_account do
+      email = NotificationMailer.bundle(bundle)
+
+      assert_equal [ user.identity.email_address ], email.to
+      assert_equal "Your Fizzy notification digest", email.subject
+
+      [ email.html_part, email.text_part ].each do |part|
+        body = part == email.html_part ? CGI.unescapeHTML(part.body.to_s) : part.body.to_s
+        bundle.notifications.each do |notification|
+          assert_includes body, notification.payload.title
+          assert_includes body, notification.payload.body
+          assert_includes body, notification.payload.url
+        end
+        assert_includes body, notifications_url(script_name: bundle.account.slug, host: "example.com")
+        assert_includes body, notifications_settings_url(script_name: bundle.account.slug, host: "example.com")
+      end
+    end
+  end
+  test "digests render mentions as well as events" do
+    notification = notifications(:logo_mentioned_david)
+    notification.user.settings.update!(bundle_email_frequency: :weekly)
+    bundle = Notification::Bundle.capture(notification, at: Time.current)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_includes email.text_part.body.to_s, notification.payload.title
+    assert_includes email.text_part.body.to_s, notification.payload.body
+    assert_includes email.html_part.body.to_s, notification.payload.url
+  end
+
+  test "notification content is escaped in HTML digests" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.user.settings.update!(bundle_email_frequency: :daily)
+    title = "<script>alert(1)</script> & title"
+    notification.card.update_columns(title: title)
+    bundle = Notification::Bundle.capture(notification, at: Time.current)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_not_includes email.html_part.body.to_s, "<script>"
+    assert_includes email.html_part.body.to_s, ERB::Util.html_escape(title)
+    assert_includes email.text_part.body.to_s, title
+  end
+end
