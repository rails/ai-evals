+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    freeze_time
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "creating a notification schedules a digest instead of sending an email" do
+    notifications(:layout_commented_kevin).destroy!
+    notification = nil
+
+    assert_no_emails do
+      assert_enqueued_with(job: Notification::Bundle::DeliverJob, at: Time.current + 4.hours) do
+        notification = @user.notifications.create!(source: events(:layout_commented), creator: users(:david))
+      end
+    end
+
+    assert_equal 1, notification.bundles.count
+    assert_equal notification.updated_at, notification.bundles.first.starts_at
+  end
+
+  test "source changes on existing notifications are bundled" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_difference "Notification::Bundle.count", 1 do
+      notification.update!(source: events(:logo_published))
+    end
+
+    assert_equal Time.current, notification.bundles.first.starts_at
+  end
+
+  test "further activity on the same card does not duplicate entries or delivery jobs" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.update!(source: events(:logo_published))
+
+    travel 1.hour
+
+    assert_no_difference [ "Notification::Bundle.count", "Notification::Bundle::Entry.count" ] do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        notification.update!(source: events(:logo_assignment_jz))
+      end
+    end
+  end
+
+  test "new activity on an old notification can open a later window" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.update!(source: events(:logo_published))
+    first = notification.bundles.first
+
+    travel_to first.ends_at
+
+    assert_difference "Notification::Bundle.count", 1 do
+      notification.update!(source: events(:logo_assignment_jz))
+    end
+
+    assert_equal 2, notification.bundles.count
+    assert_equal first.ends_at, notification.bundles.order(:starts_at).last.starts_at
+  end
+
+  test "reading and other non-source changes do not open windows" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_difference "Notification::Bundle.count" do
+      notification.read
+      notification.unread
+      notification.update!(unread_count: 5)
+    end
+  end
+
+  test "never keeps in-app notifications but does not schedule email" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      assert_no_difference "Notification::Bundle.count" do
+        notifications(:logo_assignment_kevin).update!(source: events(:logo_published))
+      end
+    end
+  end
+
+  test "enabling email is honored even when settings were cached on the notification" do
+    @user.settings.update!(bundle_email_frequency: :never)
+    notification = notifications(:logo_assignment_kevin)
+    assert_nil notification.user.bundle_email_interval
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    assert_difference "Notification::Bundle.count", 1 do
+      notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "system activity is not bundled" do
+    assert_no_difference "Notification::Bundle.count" do
+      notifications(:logo_assignment_kevin).update!(source: events(:logo_published), creator: users(:system))
+    end
+  end
+
+  test "destroying notifications removes their digest entries" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.update!(source: events(:logo_published))
+
+    assert_difference "Notification::Bundle::Entry.count", -1 do
+      notification.destroy!
+    end
+  end
+
+  test "destroying a user removes their digests and entries" do
+    notifications(:logo_assignment_kevin).update!(source: events(:logo_published))
+
+    assert_difference [ "Notification::Bundle.count", "Notification::Bundle::Entry.count" ], -1 do
+      @user.destroy!
+    end
+  end
+end
