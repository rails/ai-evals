diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..255eeb2 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,8 +25,20 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      Account.preload(:entropy).find_each do |account|
+        system_user = nil
+
+        account.entropies.distinct.pluck(:auto_postpone_period).each do |period|
+          # Resolve entropy on boards so the account/activity index can bound each card scan.
+          boards = account.boards.left_joins(:entropy)
+            .where("COALESCE(entropies.auto_postpone_period, ?) = ?", account.entropy&.auto_postpone_period, period)
+
+          active.where(account: account, board: boards, last_active_at: ..(now - period)).find_each do |card|
+            card.auto_postpone(user: system_user ||= account.system_user)
+          end
+        end
       end
     end
   end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..35616ec 100644
--- a/test/models/card/entropic_test.rb
