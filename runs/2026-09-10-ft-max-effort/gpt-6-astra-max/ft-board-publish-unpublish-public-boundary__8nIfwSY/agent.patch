diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..98a0629
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+    assert_not_includes Board.published, @board
+  end
+
+  test "publishing creates a secret key and invalidates the board cache" do
+    assert_changes -> { @board.cache_key_with_version } do
+      assert_difference -> { Board::Publication.count }, +1 do
+        @board.publish
+      end
+    end
+
+    assert @board.published?
+    assert @board.publicly_accessible?
+    assert_equal @board.account, @board.publication.account
+    assert_match /\A[0-9A-Za-z]{24,}\z/, @board.publication.key
+    assert_equal @board.publication.key, @board.publication.to_param
+    assert_includes Board.published, @board
+  end
+
+  test "publishing is idempotent" do
+    publication = @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      assert_equal publication, Board.find(@board.id).publish
+    end
+
+    assert_equal publication.key, @board.reload.publication.key
+  end
+
+  test "unpublishing revokes the key and invalidates the board cache" do
+    publication = @board.publish
+
+    assert_changes -> { @board.cache_key_with_version } do
+      assert_difference -> { Board::Publication.count }, -1 do
+        @board.unpublish
+      end
+    end
+
+    assert_not @board.published?
+    assert_not @board.publicly_accessible?
+    assert_nil @board.publication
+    assert_not Board::Publication.exists?(key: publication.key)
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.unpublish
+    end
+
+    assert_not_equal publication.key, @board.publish.key
+  end
+
+  test "a board can only have one publication" do
+    @board.publish
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Board::Publication.create!(board: @board)
+    end
+  end
+
+  test "publication keys are unique" do
+    publication = @board.publish
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Board::Publication.create!(board: boards(:private), key: publication.key)
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    publication = @board.publish
+    @board.destroy!
+
+    assert_not Board::Publication.exists?(publication.id)
+  end
+
+  test "publishing does not change board membership or all access" do
+    board = boards(:private)
+
+    assert_no_changes -> { [ board.all_access?, board.users.ids ] } do
+      board.publish
+      board.unpublish
+    end
+  end
+
+  test "cancelled accounts do not have publicly accessible boards" do
+    @board.publish
+    @board.account.cancel(initiated_by: users(:kevin))
+
+    assert @board.published?
+    assert_not @board.publicly_accessible?
+  end
+end
