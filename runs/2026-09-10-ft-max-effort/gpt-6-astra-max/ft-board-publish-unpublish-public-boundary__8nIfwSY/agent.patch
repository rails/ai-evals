+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+
+  before_action :set_board
+  before_action :protect_public_link
+
+  layout "public"
+
+  private
+    def set_board
+      if Current.account.active?
+        @board = Current.account.boards.published.find_by!(board_publications: { key: params[:board_key] || params[:key] })
+      else
+        head :not_found
+      end
+    end
+
+    def protect_public_link
+      response.headers["Referrer-Policy"] = "no-referrer"
+    end
+end
