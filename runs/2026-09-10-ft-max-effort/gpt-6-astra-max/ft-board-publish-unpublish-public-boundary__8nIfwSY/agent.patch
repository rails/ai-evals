diff --git a/test/integration/public_board_publication_test.rb b/test/integration/public_board_publication_test.rb
new file mode 100644
index 0000000..0a61ab0
--- /dev/null
+++ b/test/integration/public_board_publication_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class PublicBoardPublicationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board JSON includes a public URL that is nil by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "publish, browse anonymously, and revoke public links" do
+    post board_publication_path(@board), as: :json
+    assert_response :created
+
+    get board_path(@board), as: :json
+    public_url = response.parsed_body.fetch("public_url")
+    assert_match %r{/public/boards/[^/]+\z}, public_url
+
+    column_url = "#{public_url}/columns/#{columns(:writebook_triage).id}"
+    card_url = "#{public_url}/cards/#{cards(:logo).number}"
+    sign_out
+
+    get public_url
+    assert_response :success
+    assert_select "h1", text: @board.name
+    board_etag = response.headers["ETag"]
+
+    get column_url
+    assert_response :success
+    assert_select "a[href=?]", URI.parse(card_url).path
+
+    get card_url
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+    sign_out
+
+    get public_url, headers: { "If-None-Match" => board_etag }
+    assert_response :not_found
+
+    get column_url
+    assert_response :not_found
+
+    get card_url
+    assert_response :not_found
+  end
+
+  test "board JSON and nested board JSON reflect publication changes with caching" do
+    with_json_caching do
+      get board_path(@board), as: :json
+      assert_nil response.parsed_body.fetch("public_url")
+      board_etag = response.headers["ETag"]
+
+      get card_path(cards(:logo)), as: :json
+      assert_nil response.parsed_body.fetch("board").fetch("public_url")
+
+      post board_publication_path(@board), as: :json
+      assert_response :created
+      public_url = response.parsed_body.fetch("public_url")
+
+      get board_path(@board), as: :json, headers: { "If-None-Match" => board_etag }
+      assert_response :success
+      assert_equal public_url, response.parsed_body["public_url"]
+
+      get card_path(cards(:logo)), as: :json
+      assert_equal public_url, response.parsed_body["board"]["public_url"]
+
+      get boards_path, as: :json
+      assert_equal public_url, response.parsed_body.find { |board| board["id"] == @board.id }["public_url"]
+      assert_nil response.parsed_body.find { |board| board["id"] == boards(:private).id }.fetch("public_url")
+
+      delete board_publication_path(@board), as: :json
+      assert_response :no_content
+
+      get board_path(@board), as: :json
+      assert_nil response.parsed_body.fetch("public_url")
+
+      get card_path(cards(:logo)), as: :json
+      assert_nil response.parsed_body.fetch("board").fetch("public_url")
+    end
+  end
+
+  private
+    def with_json_caching
+      original_cache = Rails.cache
+      original_perform_caching = ApplicationController.perform_caching
+      Rails.cache = ActiveSupport::Cache::MemoryStore.new
+      ApplicationController.perform_caching = true
+      yield
+    ensure
+      Rails.cache = original_cache
+      ApplicationController.perform_caching = original_perform_caching
+    end
+end
