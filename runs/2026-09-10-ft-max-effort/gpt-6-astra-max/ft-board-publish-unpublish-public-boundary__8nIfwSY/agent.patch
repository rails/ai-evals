+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "show without signing in" do
+    get public_board_path(@publication)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@publication, columns(:writebook_triage))
+    @board.cards.published.each do |card|
+      assert_select "a[href=?]", public_board_card_path(@publication, card)
+    end
+    assert_select "form, turbo-cable-stream-source", count: 0
+    assert_equal "none", response.headers["X-Robots-Tag"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_not_includes response.headers["Cache-Control"], "public"
+  end
+
+  test "private board members are not required to follow a public link" do
+    board = boards(:private)
+    board.publish
+    sign_in_as :mike
+
+    get public_board_path(board.publication)
+
+    assert_response :success
+    assert_select "h1", text: board.name
+    assert_select "form, turbo-cable-stream-source", count: 0
+  end
+
+  test "unknown keys and board IDs cannot be used as public keys" do
+    get public_board_path("unknown-key")
+    assert_response :not_found
+
+    get public_board_path(@board.id)
+    assert_response :not_found
+  end
+
+  test "keys are scoped to their account" do
+    get public_board_path(@publication, script_name: accounts(:initech).slug)
+
+    assert_response :not_found
+  end
+
+  test "draft cards and cards from other boards are not shown" do
+    draft = @board.cards.create!(title: "A secret draft", status: :drafted, creator: users(:kevin))
+
+    get public_board_path(@publication), params: { indexed_by: "draft", board_ids: [ boards(:miltons_wish_list).id ] }
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@publication, draft), count: 0
+    assert_not_includes response.body, draft.title
+    assert_not_includes response.body, cards(:radio).title
+  end
+
+  test "public pages do not grant access to the private board" do
+    get board_path(@board)
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "unpublished keys cannot be reused after publishing again" do
+    @board.unpublish
+    @board.publish
+
+    get public_board_path(@publication)
+    assert_response :not_found
+
+    get public_board_path(@board.publication)
+    assert_response :success
+  end
+
+  test "cancelled accounts cannot be viewed publicly" do
+    @board.account.cancel(initiated_by: users(:kevin))
+
+    get public_board_path(@publication)
+
+    assert_response :not_found
+  end
+
+  test "public routes are read only" do
+    post public_board_path(@publication)
+    assert_response :not_found
+
+    delete public_board_path(@publication)
+    assert_response :not_found
+    assert @board.reload.published?
+  end
+
+  test "pagination stays public and excludes drafts" do
+    Card.insert_all! 40.times.map { |index|
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: @board.account_id,
+        board_id: @board.id,
+        creator_id: users(:kevin).id,
+        number: 100 + index,
+        title: "Card #{index}",
+        status: index.even? ? "published" : "drafted",
+        last_active_at: Time.current
+      }
+    }
+
+    expected_paths = @board.cards.published.map { |card| public_board_card_path(@publication, card) }
+    actual_paths = []
+    next_page = public_board_path(@publication)
+    page_count = 0
+
+    while next_page
+      get next_page
+      assert_response :success
+      page_count += 1
+      actual_paths.concat(css_select("a.card__link").map { |link| link["href"] })
+      next_page = css_select("a.pagination-link").first&.[]("href")
+    end
+
+    assert_operator page_count, :>, 1
+    assert_equal expected_paths.sort, actual_paths.sort
+  end
+end
