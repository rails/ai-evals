diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..0b6aa9e
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,41 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/time_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    this.refreshTimer = setInterval(() => this.render(), REFRESH_INTERVAL)
+
+    // Turbo morphs can restore the raw text without reconnecting the controller.
+    this.observer = new MutationObserver(() => this.render())
+    this.observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime" ],
+      childList: true,
+      characterData: true,
+      subtree: true
+    })
+  }
+
+  disconnect() {
+    clearInterval(this.refreshTimer)
+    this.observer.disconnect()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const datetime = this.element.dateTime
+    const text = formatLocalTime(datetime, this.formatValue)
+    const title = formatLocalTime(datetime, "tooltip")
+
+    if (this.element.textContent !== text) this.element.textContent = text
+    if (this.element.title !== title) this.element.title = title
+  }
+}
diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..087bb9a
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,69 @@
+const DATE_FORMATS = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { year: "numeric", month: "short", day: "numeric" },
+  short_date: { month: "short", day: "numeric" },
+  long_date: { weekday: "long", month: "long", day: "numeric" },
+  full_date: { weekday: "long", year: "numeric", month: "long", day: "numeric" },
+  datetime: { dateStyle: "short", timeStyle: "short" },
+  tooltip: { weekday: "long", year: "numeric", month: "long", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" }
+}
+
+const dateFormatters = new Map()
+const relativeDateFormatter = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+
+export function formatLocalTime(datetime, format = "relative", now = new Date()) {
+  // A calendar date is not a UTC timestamp. Keep timeline headings on their
+  // designated day, even in timezones west of UTC.
+  const dateOnly = /^\d{4}-\d{2}-\d{2}$/.test(datetime)
+  const date = new Date(dateOnly ? `${datetime}T00:00:00` : datetime)
+
+  if (Number.isNaN(date.getTime())) return datetime
+
+  switch (format) {
+    case "relative":
+      return formatRelativeTime(date, now, dateOnly)
+    case "relative_date":
+      return relativeDateFormatter.format(differenceInCalendarDays(now, date), "day")
+    case "short_date":
+      return formatShortDate(date, now)
+    case "tooltip":
+      return formatDate(date, dateOnly ? "full_date" : "tooltip")
+    default:
+      return formatDate(date, format)
+  }
+}
+
+function formatRelativeTime(date, now, dateOnly) {
+  const days = differenceInCalendarDays(now, date)
+
+  if (days === 0 && !dateOnly) {
+    return formatDate(date, "time")
+  } else if (days > -7) {
+    return relativeDateFormatter.format(days, "day")
+  } else {
+    return formatShortDate(date, now)
+  }
+}
+
+function differenceInCalendarDays(fromDate, toDate) {
+  // Compare local calendar dates, not elapsed 24-hour periods. Days spanning a
+  // daylight-saving transition can be 23 or 25 hours long.
+  const fromDay = Date.UTC(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const toDay = Date.UTC(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return Math.round((toDay - fromDay) / 86_400_000)
+}
+
+function formatShortDate(date, now) {
+  return formatDate(date, date.getFullYear() === now.getFullYear() ? "short_date" : "date")
+}
+
+function formatDate(date, format) {
+  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone
+  const key = `${format}:${timeZone}`
+
+  if (!dateFormatters.has(key)) {
+    dateFormatters.set(key, new Intl.DateTimeFormat("en-US", { ...DATE_FORMATS[format], timeZone }))
+  }
+
+  return dateFormatters.get(key).format(date)
+}
