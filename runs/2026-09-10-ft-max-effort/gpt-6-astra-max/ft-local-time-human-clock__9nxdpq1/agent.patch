@@ -0,0 +1,21 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card sharing sends raw timestamps for the browser to format" do
+    card = cards(:logo)
+    element = Nokogiri::HTML5.fragment(bridged_share_url_button(card: card)).at_css("button")
+    details = JSON.parse(element["data-bridge--share-card-value"])
+
+    assert_equal card.created_at.iso8601, details["addedAt"]
+    assert_equal card.last_active_at.iso8601, details["updatedAt"]
+    assert_equal card.creator.familiar_name, details["author"]
+    assert_nil element["data-bridge-share-description"]
+  end
+
+  test "non-card sharing preserves its plain text description" do
+    element = Nokogiri::HTML5.fragment(bridged_share_url_button("3 open cards, 1 in MAYBE?")).at_css("button")
+
+    assert_equal "3 open cards, 1 in MAYBE?", element["data-bridge-share-description"]
+    assert_nil element["data-bridge--share-card-value"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..961547b
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "timestamps are sent as UTC with an unformatted fallback" do
+    time = Time.new(2025, 9, 18, 13, 42, 0, "-07:00")
+    element = time_element(time)
+
+    assert_equal "2025-09-18T20:42:00Z", element["datetime"]
+    assert_equal element["datetime"], element.text
+    assert_equal "local-time", element["data-controller"]
+    assert_equal "relative", element["data-local-time-format-value"]
+    assert_nil element["title"]
+    assert_equal(-7.hours, time.utc_offset, "Rendering must not mutate the timestamp")
+  end
+
+  test "calendar dates have no timezone or implied time of day" do
+    element = time_element(Date.new(2025, 9, 18), format: :long_date)
+
+    assert_equal "2025-09-18", element["datetime"]
+    assert_equal "2025-09-18", element.text
+    assert_equal "long_date", element["data-local-time-format-value"]
+  end
+
+  test "DateTime timestamps retain their instant" do
+    element = time_element(DateTime.iso8601("2025-09-18T13:42:00-07:00"))
+
+    assert_equal "2025-09-18T20:42:00Z", element["datetime"]
+  end
+
+  test "HTML and data attributes are preserved without replacing the time controller" do
+    data = { controller: "tooltip", tooltip_target: "content" }
+    element = time_element(Time.utc(2025, 9, 18), format: :date, id: "closed-at", class: "timestamp", data: data)
+
+    assert_equal "closed-at", element["id"]
+    assert_equal "timestamp", element["class"]
+    assert_equal "local-time tooltip", element["data-controller"]
+    assert_equal "content", element["data-tooltip-target"]
+    assert_equal "date", element["data-local-time-format-value"]
+    assert_equal({ controller: "tooltip", tooltip_target: "content" }, data)
+  end
+
+  test "cached markup is independent of the server timezone and current date" do
+    timestamp = Time.utc(2025, 9, 18, 20, 42)
+    expected = local_time_tag(timestamp)
+
+    [ "UTC", "America/Los_Angeles", "Asia/Tokyo" ].each do |zone|
+      Time.use_zone(zone) do
+        travel_to timestamp + 10.days do
+          assert_equal expected, local_time_tag(timestamp.in_time_zone)
+        end
+      end
+    end
+  end
+
+  private
+    def time_element(time, **options)
+      Nokogiri::HTML5.fragment(local_time_tag(time, **options)).at_css("time")
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..e92f85d
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,238 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    travel_to Time.utc(2025, 9, 18, 22, 42)
+    @browser = page.driver.browser
+    @browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    @clock_script = @browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)["identifier"]
+      window.localTimeTestNow = #{Time.current.to_i * 1000}
+      const NativeDate = Date
+      window.Date = class extends NativeDate {
+        constructor(...args) {
+          super(...(args.length ? args : [window.localTimeTestNow]))
+        }
+
+        static now() { return window.localTimeTestNow }
+      }
+    JS
+    sign_in_as(users(:david))
+  end
+
+  teardown do
+    @browser&.execute_cdp("Page.removeScriptToEvaluateOnNewDocument", identifier: @clock_script) if @clock_script
+    @browser&.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+
+  test "comments use the browser timezone even when the server renders in UTC" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update_column :created_at, Time.utc(2025, 9, 18, 20, 42)
+    page.execute_script('document.cookie = "timezone=UTC; path=/"')
+
+    visit card_comment_url(comment.card, comment)
+
+    assert_selector "meta[name='timezone'][content='UTC']", visible: :all
+    assert_selector ".comment__permalink-title time", exact_text: "1:42 PM"
+    title = find(".comment__permalink-title time")["title"]
+    assert_includes title, "September 18, 2025"
+    assert_includes title, "1:42 PM PDT"
+  end
+
+  test "relative timestamps use local calendar days and short dates for older activity" do
+    {
+      "2025-09-18T20:42:00Z" => "1:42 PM",
+      "2025-09-18T06:59:00Z" => "yesterday",
+      "2025-09-13T20:42:00Z" => "5 days ago",
+      "2025-09-12T20:42:00Z" => "6 days ago",
+      "2025-09-11T20:42:00Z" => "Sep 11",
+      "2024-12-31T20:42:00Z" => "Dec 31, 2024",
+      "2025-09-19T07:01:00Z" => "tomorrow",
+      "2025-09-21T20:42:00Z" => "in 3 days"
+    }.each do |datetime, expected|
+      assert_equal expected, format_time(datetime), datetime
+    end
+  end
+
+  test "auto-close dates include their own relative wording" do
+    card = cards(:layout)
+    card.update_column :last_active_at, Time.utc(2025, 9, 19, 7, 1) - card.auto_postpone_period
+    visit card_url(card)
+    assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+    {
+      "2025-09-18T23:00:00Z" => "today",
+      "2025-09-19T07:01:00Z" => "tomorrow",
+      "2025-09-21T20:42:00Z" => "in 3 days",
+      "2025-10-18T20:42:00Z" => "in 30 days"
+    }.each do |datetime, expected|
+      insert_time_tag(Time.iso8601(datetime), format: :relative_date)
+      assert_selector "#test-time", exact_text: expected
+      page.execute_script('document.getElementById("test-time").remove()')
+    end
+  end
+
+  test "absolute dates and times are local but calendar dates do not shift" do
+    assert_equal "Sep 17, 2025", format_time("2025-09-18T00:30:00Z", format: :date)
+    assert_equal "5:30 PM", format_time("2025-09-18T00:30:00Z", format: :time)
+    assert_equal "9/17/25, 5:30 PM", format_time("2025-09-18T00:30:00Z", format: :datetime)
+    assert_equal "Sep 12", format_time("2025-09-12T20:42:00Z", format: :short_date)
+
+    insert_time_tag(Date.new(2025, 9, 18), format: :long_date)
+    assert_selector "#test-time", exact_text: "Thursday, September 18"
+    assert_equal "Thursday, September 18, 2025", find("#test-time")["title"]
+    assert_equal "today", format_time("2025-09-18")
+    assert_equal "not-a-timestamp", format_time("not-a-timestamp")
+  end
+
+  test "relative days are correct across daylight saving and year boundaries" do
+    assert_equal "2 days ago", format_time("2025-03-09T07:55:00Z", now: "2025-03-10T07:05:00Z")
+    assert_equal "yesterday", format_time("2025-03-09T08:05:00Z", now: "2025-03-10T07:05:00Z")
+    assert_equal "in 2 days", format_time("2025-03-10T07:05:00Z", now: "2025-03-09T07:55:00Z", format: :relative_date)
+    assert_equal "12:05 AM", format_time("2025-11-02T07:05:00Z", now: "2025-11-03T07:55:00Z")
+    assert_equal "today", format_time("2025-11-03T07:55:00Z", now: "2025-11-02T07:05:00Z", format: :relative_date)
+    assert_equal "yesterday", format_time("2025-01-01T07:55:00Z", now: "2025-01-01T08:05:00Z")
+    assert_equal "yesterday", format_time("2024-03-01T07:55:00Z", now: "2024-03-01T08:05:00Z")
+  end
+
+  test "an open page follows a change in the viewer timezone" do
+    insert_time_tag(Time.utc(2025, 9, 18, 20, 42))
+    assert_selector "#test-time", exact_text: "1:42 PM"
+
+    { "Asia/Tokyo" => "5:42 AM", "Asia/Kathmandu" => "2:27 AM" }.each do |timezone, expected|
+      @browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+      page.execute_script <<~JS
+        const time = document.getElementById("test-time")
+        Stimulus.getControllerForElementAndIdentifier(time, "local-time").render()
+      JS
+
+      assert_selector "#test-time", exact_text: expected
+      assert_includes find("#test-time")["title"], "September 19, 2025"
+    end
+  end
+
+  test "the same cached markup works in different viewer timezones" do
+    html = ApplicationController.helpers.local_time_tag(Time.utc(2025, 9, 18, 20, 42), id: "test-time")
+    page.execute_script('document.body.insertAdjacentHTML("beforeend", arguments[0])', html)
+    assert_selector "#test-time", exact_text: "1:42 PM"
+
+    @browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Asia/Tokyo")
+    page.refresh
+
+    page.execute_script('document.body.insertAdjacentHTML("beforeend", arguments[0])', html)
+    assert_selector "#test-time", exact_text: "5:42 AM"
+    assert_includes find("#test-time")["title"], "September 19, 2025"
+  end
+
+  test "native share and stamp descriptions use local dates" do
+    card = cards(:layout)
+    card.close(user: users(:david))
+    card.closure.update_column :created_at, Time.utc(2025, 9, 18, 0, 30)
+    card.update_columns(created_at: Time.utc(2025, 9, 18, 0, 30), last_active_at: Time.utc(2025, 9, 18, 20, 42))
+    visit card_url(card)
+    assert_selector ".card__closed-date time", exact_text: "SEP 17, 2025"
+
+    descriptions = page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      window.bridgeTimeMessages = {}
+      Promise.all([
+        import("controllers/bridge/share_controller"),
+        import("controllers/bridge/stamp_controller")
+      ]).then(modules => {
+        for (const { default: Controller } of modules) {
+          Stimulus.register(`bridge--${Controller.component}`, class extends Controller {
+            static get shouldLoad() { return true }
+            send(event, data) { window.bridgeTimeMessages[this.component] = data }
+          })
+        }
+        requestAnimationFrame(() => {
+          const button = document.querySelector('[data-controller="bridge--share"]')
+          Stimulus.getControllerForElementAndIdentifier(button, "bridge--share").shareUrl()
+          done(window.bridgeTimeMessages)
+        })
+      }).catch(error => done(error.toString()))
+    JS
+
+    assert_equal "Sep 17, 2025", descriptions.dig("stamp", "description")
+    assert_includes descriptions.dig("share", "description"), "Added Sep 17 by #{card.creator.familiar_name}"
+    assert_includes descriptions.dig("share", "description"), "Updated Sep 18"
+
+    @browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Asia/Tokyo")
+    page.execute_script <<~JS
+      const time = document.querySelector(".card__closed-date time")
+      Stimulus.getControllerForElementAndIdentifier(time, "local-time").render()
+    JS
+    assert_selector ".card__closed-date time", exact_text: "SEP 18, 2025"
+    assert_equal "Sep 18, 2025", page.evaluate_script("window.bridgeTimeMessages.stamp.description")
+  end
+
+  test "Turbo morphs and new timestamps are rendered without reconnecting" do
+    insert_time_tag(Time.utc(2025, 9, 18, 20, 42))
+    assert_selector "#test-time", exact_text: "1:42 PM"
+    page.execute_script('window.originalTimeElement = document.getElementById("test-time")')
+
+    morph_time_tag(Time.utc(2025, 9, 18, 20, 42))
+    assert_selector "#test-time", exact_text: "1:42 PM"
+    assert page.evaluate_script('window.originalTimeElement === document.getElementById("test-time")')
+
+    morph_time_tag(Time.utc(2025, 9, 18, 6, 59))
+    assert_selector "#test-time", exact_text: "yesterday"
+    assert_includes find("#test-time")["title"], "September 17, 2025"
+
+    page.execute_script('document.getElementById("test-time").dataset.localTimeFormatValue = "date"')
+    assert_selector "#test-time", exact_text: "Sep 17, 2025"
+  end
+
+  test "labels refresh when an open page crosses midnight and timers stop on disconnect" do
+    page.execute_script <<~JS
+      const setInterval = window.setInterval
+      const clearInterval = window.clearInterval
+      window.timeRefreshCallbacks = new Map()
+      window.setInterval = (callback, delay) => {
+        const timer = setInterval(callback, delay)
+        window.timeRefreshCallbacks.set(timer, callback)
+        return timer
+      }
+      window.clearInterval = timer => {
+        window.timeRefreshCallbacks.delete(timer)
+        clearInterval(timer)
+      }
+    JS
+    insert_time_tag(Time.utc(2025, 9, 18, 20, 42))
+    assert_selector "#test-time", exact_text: "1:42 PM"
+
+    page.execute_script <<~JS
+      const time = document.getElementById("test-time")
+      window.testTimeTimer = Stimulus.getControllerForElementAndIdentifier(time, "local-time").refreshTimer
+      window.localTimeTestNow = Date.parse("2025-09-19T07:01:00Z")
+      window.timeRefreshCallbacks.get(window.testTimeTimer)()
+    JS
+    assert_selector "#test-time", exact_text: "yesterday"
+
+    page.execute_script('document.getElementById("test-time").remove()')
+    assert page.evaluate_script("!window.timeRefreshCallbacks.has(window.testTimeTimer)")
+  end
+
+  private
+    def format_time(datetime, format: :relative, now: "2025-09-18T22:42:00Z")
+      page.evaluate_async_script(<<~JS, datetime, format, now)
+        const [datetime, format, now, done] = arguments
+        import("helpers/time_helpers").then(({ formatLocalTime }) => {
+          done(formatLocalTime(datetime, format, new Date(now)))
+        }).catch(error => done(error.toString()))
+      JS
+    end
+
+    def insert_time_tag(time, **options)
+      html = ApplicationController.helpers.local_time_tag(time, id: "test-time", **options)
+      page.execute_script('document.body.insertAdjacentHTML("beforeend", arguments[0])', html)
+    end
+
+    def morph_time_tag(time)
+      html = ApplicationController.helpers.local_time_tag(time, id: "test-time")
+      page.evaluate_async_script(<<~JS, html)
+        const [html, done] = arguments
+        document.getElementById("test-time").addEventListener("turbo:morph-element", () => requestAnimationFrame(done), { once: true })
+        Turbo.renderStreamMessage(`<turbo-stream action="replace" method="morph" target="test-time"><template>${html}</template></turbo-stream>`)
+      JS
+    end
+end
