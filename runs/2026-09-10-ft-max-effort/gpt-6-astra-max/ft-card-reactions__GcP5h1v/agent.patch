+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @david_reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    @kevin_reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "destroy" do
+    reaction = @david_reaction
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @kevin_reaction
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, @card.reactions.last), @response.parsed_body["url"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card)
+
+    assert_response :success
+    assert_select "turbo-frame[id=?]", dom_id(@card, :new_reaction) do
+      assert_select "form[action=?][data-turbo-frame=?]", card_reactions_path(@card), dom_id(@card, :reacting) do
+        assert_select "input[name='reaction[content]'][maxlength='16']"
+        assert_select "a[href=?][data-turbo-frame=?]", card_reactions_path(@card), dom_id(@card, :reacting)
+      end
+    end
+  end
+
+  test "create with flat JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { content: "👍" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+  end
+
+  test "index only includes card reactions" do
+    comment = comments(:logo_agreement_jz)
+    comment.reactions.create!(content: "Comment boost", reacter: users(:david))
+
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal [ @david_reaction.id, @kevin_reaction.id ], @response.parsed_body.pluck("id")
+    assert_equal card_reaction_url(@card, @david_reaction), @response.parsed_body.first["url"]
+  end
+
+  test "cannot destroy another card's reaction" do
+    reaction = cards(:layout).reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_reaction_path(@card, reaction), as: :turbo_stream
+      assert_response :not_found
+    end
+  end
+
+  test "cannot destroy a comment reaction through the card" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_reaction_path(@card, reaction), as: :turbo_stream
+      assert_response :not_found
+    end
+  end
+
+  test "cannot access reactions on an inaccessible card" do
+    @card.board.update!(all_access: false)
+    @card.board.accesses.revoke_from users(:david)
+
+    get card_reactions_path(@card)
+    assert_response :not_found
+
+    get new_card_reaction_path(@card)
+    assert_response :not_found
+
+    assert_no_difference -> { Reaction.count } do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :turbo_stream
+      assert_response :not_found
+
+      delete card_reaction_path(@card, @david_reaction), as: :turbo_stream
+      assert_response :not_found
+    end
+  end
+end
