     end
   end
+
+  test "creating a card reaction touches the card activity" do
+    assert_changes -> { cards(:logo).reload.last_active_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "card and comment reactions share defaults and ordering" do
+    [ cards(:logo), comments(:logo_agreement_jz) ].each do |reactable|
+      later = reactable.reactions.create!(content: "Nice!")
+      earlier = reactable.reactions.create!(content: "👍", created_at: 1.day.ago)
+
+      assert_equal reactable, later.reactable
+      assert_equal reactable.account, later.account
+      assert_equal users(:david), later.reacter
+      assert_equal [ earlier, later ], reactable.reactions.reload.to_a
+    end
+  end
+
+  test "destroying a reaction touches its target and card but does not register new activity" do
+    [ cards(:logo), comments(:logo_agreement_jz) ].each do |reactable|
+      reaction = reactable.reactions.create!(content: "Nice!")
+
+      travel 1.minute do
+        assert_no_changes -> { reactable.card.reload.last_active_at } do
+          assert_changes -> { reactable.reload.updated_at } do
+            assert_changes -> { reactable.card.reload.updated_at } do
+              reaction.destroy!
+            end
+          end
+        end
+      end
+    end
+  end
+
+  test "destroying a comment deletes only its reactions" do
+    card_reaction = cards(:logo).reactions.create!(content: "👍")
