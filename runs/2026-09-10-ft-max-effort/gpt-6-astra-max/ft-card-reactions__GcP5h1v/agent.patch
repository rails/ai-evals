+    assert_not Reaction.exists?(card_reaction.id)
+    assert_not Reaction.exists?(comment_reaction.id)
+  end
 end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..a89ec15
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,93 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    sign_in_as users(:david)
+  end
+
+  test "reacting to a card updates its board preview" do
+    visit card_url(@card)
+    add_reaction_to @card, content: "Nice!"
+
+    visit board_column_url(@card.board, @card.column)
+    assert_selector "##{dom_id(@card, :article)} .card__boosts strong", text: "1"
+
+    visit card_url(@card)
+    delete_reaction_from @card, content: "Nice!"
+
+    visit board_column_url(@card.board, @card.column)
+    assert_no_selector "##{dom_id(@card, :article)} .card__boosts"
+  end
+
+  test "reacting to comments still works independently of card reactions" do
+    comment = comments(:logo_agreement_jz)
+
+    visit card_url(@card)
+    add_reaction_to comment, content: "Great!"
+    within_reactions(@card) { assert_no_selector ".reaction" }
+    delete_reaction_from comment, content: "Great!"
+  end
+
+  test "canceling a card reaction restores the add button" do
+    visit card_url(@card)
+
+    within_reactions @card do
+      click_on "Add your own reaction"
+      fill_in "reaction[content]", with: "Never mind"
+      click_on "Cancel"
+
+      assert_selector ".reactions__trigger"
+      assert_no_selector "form"
+      assert_no_selector ".reaction"
+    end
+  end
+
+  test "the card emoji picker fits and inserts emoji on desktop and mobile" do
+    [ [ 1200, 1000 ], [ 390, 844 ] ].each do |width, height|
+      page.current_window.resize_to(width, height)
+      visit card_url(@card)
+
+      within_reactions @card do
+        click_on "Add your own reaction"
+        find(".reaction__menu-btn").click
+
+        popup = find(".reaction__popup[open]")
+        assert popup.evaluate_script("this.scrollWidth <= this.clientWidth"), "Emoji picker overflows at #{width}px"
+        popup.find("button[data-emoji='👍']").click
+
+        assert_field "reaction[content]", with: "👍"
+        click_on "Cancel"
+      end
+    end
+  ensure
+    page.current_window.resize_to(1200, 1000)
+  end
+
+  private
+    def add_reaction_to(reactable, content:)
+      within_reactions reactable do
+        click_on "Add your own reaction"
+        fill_in "reaction[content]", with: content
+        click_on "Submit"
+
+        assert_selector ".reaction", text: content
+        assert_selector ".reactions__trigger"
+      end
+    end
+
+    def delete_reaction_from(reactable, content:)
+      within_reactions reactable do
+        find("[data-reaction-delete-target='content']", text: content).click
+        click_on "Delete this reaction"
+
+        assert_no_selector ".reaction"
+      end
+    end
+
+    def within_reactions(reactable, &block)
+      within "##{dom_id(reactable, :reacting)}", &block
+    end
+end
