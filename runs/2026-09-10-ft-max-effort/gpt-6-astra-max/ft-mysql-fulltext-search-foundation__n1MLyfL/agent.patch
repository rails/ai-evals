diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..703b331
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,76 @@
+class Search
+  MAX_QUERY_LENGTH = 200
+  MAX_COMMENT_EXCERPTS = 3
+
+  attr_reader :query, :terms
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.is_a?(String) ? query.squish.first(MAX_QUERY_LENGTH) : ""
+    @terms = @query.split.uniq(&:downcase)
+  end
+
+  def cards
+    if terms.any?
+      terms.reduce(user.accessible_cards.published) do |cards, term|
+        cards.merge(cards_matching(term))
+      end.reverse_chronologically
+    else
+      user.accessible_cards.none
+    end
+  end
+
+  def comments_for(cards)
+    if terms.any?
+      matching_bodies = terms.map { |term| rich_texts_matching(term) }.reduce(:or).where(record_type: "Comment", name: "body")
+
+      comments = user.accessible_comments.merge(Card.published)
+        .where(card: cards, id: matching_bodies.select(:record_id))
+
+      recent_comment_excerpts(comments).order(created_at: :desc, id: :desc).with_rich_text_body
+    else
+      user.accessible_comments.none
+    end
+  end
+
+  def pattern
+    @pattern ||= /#{Regexp.union(terms.sort_by { |term| -term.length }).source}/i if terms.any?
+  end
+
+  private
+    attr_reader :user
+
+    def cards_matching(term)
+      descriptions = rich_texts_matching(term).where(record_type: "Card", name: "description")
+      comment_bodies = rich_texts_matching(term).where(record_type: "Comment", name: "body")
+      comments = Comment.where(id: comment_bodies.select(:record_id))
+
+      Card.where("LOWER(cards.title) LIKE ? ESCAPE '!'", like_pattern(term))
+        .or(Card.where(id: descriptions.select(:record_id)))
+        .or(Card.where(id: comments.select(:card_id)))
+    end
+
+    def rich_texts_matching(term)
+      ActionText::RichText.where(account_id: user.account_id)
+        .where("LOWER(action_text_rich_texts.plain_text_body) LIKE ? ESCAPE '!'", like_pattern(term))
+    end
+
+    def like_pattern(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term.downcase, "!")}%"
+    end
+
+    def recent_comment_excerpts(comments)
+      ranked_comments = comments.select(<<~SQL.squish)
+        comments.id,
+        ROW_NUMBER() OVER (
+          PARTITION BY comments.card_id
+          ORDER BY comments.created_at DESC, comments.id DESC
+        ) AS match_rank
+      SQL
+
+      comment_ids = Comment.from(ranked_comments, :ranked_comments)
+        .where("ranked_comments.match_rank <= ?", MAX_COMMENT_EXCERPTS).select("ranked_comments.id")
+
+      Comment.where(id: comment_ids)
+    end
+end
