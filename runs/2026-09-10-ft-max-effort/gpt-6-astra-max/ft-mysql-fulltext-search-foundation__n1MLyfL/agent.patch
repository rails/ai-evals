new file mode 100644
index 0000000..5513575
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,22 @@
+module SearchesHelper
+  def highlight_search_terms(text, search)
+    if search.pattern
+      safe_join(text.to_s.split(/(#{search.pattern})/).each_with_index.map do |part, index|
+        index.odd? ? tag.mark(part) : part
+      end)
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_result_excerpt(text, search)
+    text = text.to_s.squish
+    snippet = if search.pattern&.match?(text)
+      excerpt(text, search.pattern, radius: 100)
+    else
+      text.truncate(200)
+    end
+
+    highlight_search_terms(snippet, search)
+  end
+end
