diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..f1de11c
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "searches existing titles and comment bodies" do
+    assert_equal [ cards(:logo) ], search("logo").cards
+    assert_equal [ cards(:layout) ], search("overflowing").cards
+  end
+
+  test "matches all query words across titles, descriptions, and different comments" do
+    cards(:logo).update! title: "Crimson", description: "A fox"
+    cards(:layout).comments.create! body: "A crimson animal"
+    cards(:layout).comments.create! body: "It is a fox"
+    cards(:text).update! title: "Only a fox"
+    cards(:shipping).update! title: "Only crimson"
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id), search("CRIMSON fox").cards.sort_by(&:id)
+  end
+
+  test "returns a card only once even when multiple fields and comments match" do
+    card = cards(:logo)
+    card.update! title: "Needle", description: "Needle again"
+    2.times { card.comments.create! body: "Needle in a comment" }
+
+    assert_equal [ card ], search("needle").cards
+    assert_equal 2, search("needle").comments_for([ card ]).by_user.count
+  end
+
+  test "loads only the newest matching comment excerpts for each card" do
+    comments = 6.times.map do |index|
+      cards(:logo).comments.create! body: "Needle #{index}", created_at: index.minutes.ago
+    end
+    other_comment = cards(:layout).comments.create! body: "Needle on another card", created_at: 1.day.ago
+
+    assert_equal [ *comments.first(3), other_comment ], search("needle").comments_for([ cards(:logo), cards(:layout) ])
+  end
+
+  test "searches visible rich text including entities and words split by formatting" do
+    cards(:logo).update! description: '<p class="hiddenattribute">R&amp;D and a nee<strong>dle</strong></p>'
+
+    assert_equal [ cards(:logo) ], search("r&d needle").cards
+    assert_empty search("hiddenattribute").cards
+    assert_empty search("strong").cards
+  end
+
+  test "treats SQL wildcards and escape characters literally" do
+    cards(:logo).update! title: "100% finished_one!"
+    cards(:layout).update! description: "100 percent finished two"
+
+    [ "100%", "finished_one", "one!" ].each do |query|
+      assert_equal [ cards(:logo) ], search(query).cards
+    end
+  end
+
+  test "treats quotes and SQL syntax as text" do
+    assert_empty search("' OR 1=1 --").cards
+  end
+
+  test "blank or malformed queries have no results" do
+    [ nil, "", " \t\n ", [], { q: "logo" } ].each do |query|
+      assert_empty search(query).cards
+      assert_empty search(query).comments_for([ cards(:logo) ])
+    end
+  end
+
+  test "normalizes and bounds query length" do
+    assert_equal "crimson fox", search("  crimson \n fox  ").query
+    assert_equal [ "crimson" ], search("crimson CRIMSON").terms
+    assert_equal Search::MAX_QUERY_LENGTH, search("x" * 1_000).query.length
+  end
+
+  test "orders by card creation time rather than recent activity" do
+    cards(:logo).update_columns title: "Needle", created_at: 3.days.ago, last_active_at: Time.current
+    cards(:layout).update_columns title: "Needle", created_at: 1.day.ago, last_active_at: 1.day.ago
+
+    assert_equal [ cards(:layout), cards(:logo) ], search("needle").cards
+  end
+
+  test "breaks creation time ties by descending card id" do
+    time = 1.day.ago
+    cards(:logo).update! title: "Needle", created_at: time
+    cards(:layout).update! title: "Needle", created_at: time
+
+    assert_equal [ cards(:layout), cards(:logo) ].sort_by(&:id).reverse, search("needle").cards
+  end
+
+  test "uses current board access even for publicly shared boards" do
+    private_card = boards(:private).cards.create! title: "Needle", status: :published
+    private_card.comments.create! body: "Needle"
+    boards(:private).publish
+    query = search("needle", user: users(:david))
+
+    assert_empty query.cards
+    assert_empty query.comments_for([ private_card ])
+
+    boards(:private).accesses.grant_to users(:david)
+    assert_equal [ private_card ], query.cards
+
+    boards(:private).accesses.revoke_from users(:david)
+    assert_empty query.cards
+    assert_empty query.comments_for([ private_card ])
+  end
+
+  test "moving a card immediately changes who can find it and its comments" do
+    card = boards(:writebook).cards.create! title: "Needle", status: :published
+    card.comments.create! body: "Needle"
+    query = search("needle", user: users(:david))
+
+    assert_equal [ card ], query.cards
+
+    card.move_to boards(:private)
+
+    assert_empty query.cards
+    assert_empty query.comments_for([ card ])
+  end
+
+  test "does not include cards or comments from other accounts" do
+    cards(:radio).update! title: "Needle"
+    cards(:radio).comments.create! creator: users(:mike), body: "Needle"
+
+    assert_empty search("needle").cards
+    assert_empty search("needle").comments_for([ cards(:radio) ])
+  end
+
+  test "never returns drafts or their comments, including after unpublishing" do
+    card = cards(:logo)
+    card.update! title: "Needle", description: "Needle"
+    card.comments.create! body: "Needle"
+    query = search("needle")
+
+    card.drafted!
+    assert_empty query.cards
+    assert_empty query.comments_for([ card ])
+
+    card.publish
+    assert_equal [ card ], query.cards
+    assert_equal 1, query.comments_for([ card ]).by_user.count
+
+    card.drafted!
+    assert_empty query.cards
+    assert_empty query.comments_for([ card ])
+  end
+
+  test "description edits and removals are searchable immediately" do
+    card = cards(:logo)
+    card.update! description: "Needle"
+    assert_equal [ card ], search("needle").cards
+
+    card.description.update! body: "Haystack"
+    assert_empty search("needle").cards
+    assert_equal [ card ], search("haystack").cards
+
+    card.update! description: ""
+    assert_empty search("haystack").cards
+  end
+
+  test "comment edits and deletions are searchable immediately" do
+    comment = cards(:logo).comments.create! body: "Needle"
+    assert_equal [ cards(:logo) ], search("needle").cards
+
+    comment.update! body: "Haystack"
+    assert_empty search("needle").cards
+    assert_equal [ cards(:logo) ], search("haystack").cards
+
+    comment.destroy!
+    assert_empty search("haystack").cards
+  end
+
+  private
+    def search(query, user: users(:kevin))
+      Search.new(user: user, query: query)
+    end
+end
