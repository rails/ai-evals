diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..1af1534
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,25 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel panel--wide center txt-align-start">
+  <%= form_with url: search_path, method: :get, html: { role: "search" }, class: "flex align-center gap margin-block-end-double" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards…", maxlength: Search::MAX_QUERY_LENGTH,
+          autofocus: true, class: "input full-width min-width", aria: { description: "Search titles, descriptions, and comments" } %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <%= with_manual_pagination :search_results, @page do %>
+    <% if @search.terms.empty? %>
+      <p class="txt-subtle">Search for words in card titles, descriptions, or comments.</p>
+    <% elsif @page.records.empty? %>
+      <p class="txt-subtle">No cards found for “<%= @search.query %>”.</p>
+    <% else %>
+      <%= render partial: "searches/card", collection: @page.records, as: :card, locals: { search: @search, comments_by_card: @comments_by_card } %>
+    <% end %>
+  <% end %>
+</section>
