+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights all matched terms without changing their case" do
+    assert_equal "A <mark>Crimson</mark> <mark>fox</mark> and a <mark>CRIMSON</mark> <mark>FOX</mark>",
+      highlight_search_terms("A Crimson fox and a CRIMSON FOX", search("crimson fox"))
+  end
+
+  test "escapes HTML before marking matches" do
+    assert_equal "&lt;img src=x onerror=alert(1)&gt; <mark>Needle</mark> &amp; thread",
+      highlight_search_terms("<img src=x onerror=alert(1)> Needle & thread", search("needle"))
+  end
+
+  test "does not highlight inside HTML entities introduced by escaping" do
+    assert_equal "R&amp;D and <mark>amp</mark>", highlight_search_terms("R&D and amp", search("amp"))
+    assert_equal "R<mark>&amp;</mark>D", highlight_search_terms("R&D", search("&"))
+  end
+
+  test "treats regular expression metacharacters literally" do
+    assert_equal "A <mark>[needle].*</mark> and a needle", highlight_search_terms("A [needle].* and a needle", search("[needle].*"))
+  end
+
+  test "highlights the longest of overlapping terms" do
+    assert_equal "<mark>catalog</mark> <mark>cat</mark>", highlight_search_terms("catalog cat", search("cat catalog"))
+  end
+
+  test "centers excerpts on a match rather than truncating it away" do
+    text = "before " * 100 + "Needle" + " after" * 100
+    result = search_result_excerpt(text, search("needle"))
+
+    assert_includes result, "<mark>Needle</mark>"
+    assert_operator result.length, :<, 250
+    assert result.start_with?("...")
+    assert result.end_with?("...")
+  end
+
+  test "truncates and escapes unmatched excerpts" do
+    result = search_result_excerpt("<img>" * 100, search("needle"))
+
+    assert_not_includes result, "<img>"
+    assert_not_includes result, "<mark>"
+    assert result.end_with?("...")
+  end
+
+  test "handles missing text and blank queries" do
+    assert_equal "", highlight_search_terms(nil, search("needle"))
+    assert_equal "", search_result_excerpt(nil, search("needle"))
+    assert_equal "&lt;b&gt;", highlight_search_terms("<b>", search(""))
+  end
+
+  private
+    def search(query)
+      Search.new(user: users(:kevin), query: query)
+    end
+end
