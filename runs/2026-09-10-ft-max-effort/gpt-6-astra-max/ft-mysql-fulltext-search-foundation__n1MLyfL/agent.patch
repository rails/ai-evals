diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..8d6cdee
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,181 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.account = accounts(:"37s")
+    Current.user = users(:kevin)
+  end
+
+  test "searches titles, descriptions, and comments, newest cards first" do
+    cards(:logo).update! title: "Needle in the title", created_at: 3.days.ago
+    cards(:layout).update! description: "A <strong>Needle</strong> in the description", created_at: 2.days.ago
+    cards(:text).update! created_at: 1.day.ago
+    cards(:text).comments.create! creator: users(:kevin), body: "A Needle in a comment"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map { |card| dom_id(card, :search_result) }, results.map { |result| result["id"] }
+    end
+    assert_select ".search-result__title mark", text: "Needle"
+    assert_select ".search-result__description mark", text: "Needle"
+    assert_select ".search-result__comment mark", text: "Needle"
+  end
+
+  test "search immediately respects revoked board access" do
+    cards(:logo).update! title: "Needle"
+    boards(:writebook).update! all_access: false
+
+    get search_path, params: { q: "needle" }
+    assert_response :success
+    assert_select ".search-result", count: 1
+
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "needle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "drafts and comments on drafts do not appear" do
+    cards(:logo).update! title: "Needle"
+    cards(:layout).comments.create! creator: users(:kevin), body: "Needle"
+    cards(:logo).drafted!
+    cards(:layout).drafted!
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+  test "requires authentication" do
+    sign_out
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :redirect
+    assert_select ".search-result", count: 0
+  end
+
+  test "has a GET search form and an empty state" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?][method=get][role=search]", search_path do
+      assert_select 'input[type=search][name=q][value=""]'
+      assert_select "label[for=q]", text: "Search cards"
+    end
+    assert_select ".search-result", count: 0
+    assert_select 'meta[name="turbo-cache-control"][content="no-cache"]'
+  end
+
+  test "keeps the query in the form and explains when nothing matches" do
+    get search_path, params: { q: "notfoundanywhere" }
+
+    assert_response :success
+    assert_select "input[name=q][value=?]", "notfoundanywhere"
+    assert_select "p", text: "No cards found for “notfoundanywhere”."
+  end
+
+  test "handles whitespace and malformed query parameters" do
+    [ " \t\n ", [ "logo" ], { term: "logo" } ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "links to the card and to matching comments" do
+    comment = cards(:logo).comments.create! body: "Needle"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title a[href=?]", card_path(cards(:logo))
+    assert_select ".search-result__comment a[href=?]", card_path(cards(:logo), anchor: dom_id(comment)) do
+      assert_select "mark", text: "Needle"
+    end
+  end
+
+  test "paginates cards newest first and preserves the query" do
+    matching_cards = 18.times.map do |index|
+      boards(:writebook).cards.create! title: "Paginatedneedle #{index}", status: :published, created_at: index.minutes.ago
+    end
+
+    get search_path, params: { q: "paginatedneedle" }
+
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal matching_cards.first(15).map { |card| dom_id(card, :search_result) }, results.map { |result| result["id"] }
+    end
+    next_page = css_select("a.pagination-link").sole["href"]
+    assert_equal({ "q" => "paginatedneedle", "page" => "2" }, URI.decode_www_form(URI(next_page).query).to_h)
+
+    get next_page
+
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal matching_cards.last(3).map { |card| dom_id(card, :search_result) }, results.map { |result| result["id"] }
+    end
+    assert_select "a.pagination-link", count: 0
+  end
+
+  test "empty result pages still include their pagination frame" do
+    get search_path, params: { q: "notfoundanywhere", page: 2 }, headers: { "Turbo-Frame" => "search_results-pagination-contents-2" }
+
+    assert_response :success
+    assert_select "turbo-frame#search_results-pagination-contents-2" do
+      assert_select "p", text: "No cards found for “notfoundanywhere”."
+    end
+  end
+
+  test "only searches the current account even when the identity belongs to multiple accounts" do
+    accounts(:initech).users.create! identity: identities(:kevin), name: "Kevin", role: :member
+    cards(:radio).update_column :title, "Needle from another account"
+    cards(:radio).comments.create! creator: users(:mike), body: "Needle comment from another account"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path(script_name: accounts(:initech).slug), params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title", text: "Needle from another account"
+  end
+
+  test "escapes result text without removing highlights" do
+    cards(:logo).update! title: "<img src=x onerror=alert(1)> Needle", description: "<p>&lt;script&gt;Needle&lt;/script&gt;</p>"
+    cards(:logo).comments.create! body: "<p>&lt;img src=x onerror=alert(1)&gt; Needle</p>"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result script, .search-result img", count: 0
+    assert_select ".search-result__title mark", text: "Needle"
+    assert_select ".search-result__description mark", text: "Needle"
+    assert_select ".search-result__comment mark", text: "Needle", minimum: 1
+  end
+
+  test "escapes the query in the form and empty state" do
+    query = '<script>alert("needle")</script>'
+
+    get search_path, params: { q: query }
+
+    assert_response :success
+    assert_select "main script", count: 0
+    assert_select "input[name=q][value=?]", query
+  end
+
+  test "search is available in the navigation menu" do
+    get my_menu_path
+
+    assert_response :success
+    assert_select "a[href=?]", search_path, text: /Search/
+  end
+end
