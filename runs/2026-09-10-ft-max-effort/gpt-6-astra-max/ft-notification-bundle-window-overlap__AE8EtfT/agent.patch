+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_items, class_name: "Notification::Bundle::Item", dependent: :delete_all
+    has_many :bundles, through: :bundle_items
+
+    after_save_commit :bundle, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def bundle
+    Notification::Bundle.add(self) unless creator.system?
+  end
+end
