diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..17465e4
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  # Real transactions and separate connections are needed to exercise row locks.
+  self.use_transactional_tests = false
+
+  setup do
+    travel_to Time.utc(2026, 9, 14, 9, 17, 23)
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification_ids = [ notifications(:logo_assignment_kevin).id, notifications(:layout_commented_kevin).id ]
+    @user.notifications.update_all(updated_at: Time.current)
+  end
+
+  teardown do
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :never)
+  end
+
+  test "simultaneous first arrivals open only one window" do
+    Notification.find(@notification_ids.last).update_columns(updated_at: 1.hour.ago)
+
+    bundles = concurrently do |index|
+      Notification.find(@notification_ids[index % @notification_ids.size]).bundle
+    end
+
+    assert_equal 1, bundles.map(&:id).uniq.size
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal @notification_ids.sort, bundles.first.notifications.pluck(:id).sort
+  end
+
+  test "simultaneous arrivals at the next boundary cannot overlap windows" do
+    first_bundle = Notification.find(@notification_ids.first).bundle
+    travel_to first_bundle.ends_at
+    @notification_ids.zip([ events(:logo_published), events(:layout_published) ]).each do |id, source|
+      Notification.find(id).update_columns(source_id: source.id, source_type: "Event", updated_at: Time.current)
+    end
+
+    bundles = concurrently do |index|
+      Notification.find(@notification_ids[index % @notification_ids.size]).bundle
+    end
+
+    assert_equal 1, bundles.map(&:id).uniq.size
+    assert_equal 2, @user.notification_bundles.count
+    assert_equal first_bundle.ends_at, bundles.first.starts_at
+  end
+
+  test "simultaneous delivery jobs send one email" do
+    bundle = Notification.find(@notification_ids.first).bundle
+    travel_to bundle.ends_at
+
+    assert_emails 1 do
+      concurrently { Notification::Bundle.find(bundle.id).deliver }
+    end
+
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "concurrent direct writes cannot create overlapping windows" do
+    windows = concurrently do |index|
+      starts_at = Time.current + index.hours
+      window = Notification::Bundle.new(user: User.find(@user.id), starts_at: starts_at, ends_at: starts_at + 4.hours)
+      window.save
+      window
+    end
+
+    assert_equal 1, windows.count(&:persisted?)
+    assert_equal 1, @user.notification_bundles.count
+    assert windows.reject(&:persisted?).all? { |window| window.errors[:base].include?("Digest windows cannot overlap") }
+  end
+
+  private
+    def concurrently
+      ready = Queue.new
+      start = Queue.new
+      threads = 4.times.map do |index|
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            ready << true
+            start.pop
+            yield index
+          end
+        end
+      end
+
+      threads.size.times { ready.pop }
+      threads.size.times { start << true }
+      threads.map(&:value)
+    ensure
+      threads&.each(&:join)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
