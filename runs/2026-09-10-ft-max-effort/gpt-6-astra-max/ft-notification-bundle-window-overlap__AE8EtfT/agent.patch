index 0000000..0e986e8
--- /dev/null
+++ b/app/jobs/notification/bundle/deliver_job.rb
@@ -0,0 +1,15 @@
+class Notification::Bundle::DeliverJob < ApplicationJob
+  include SmtpDeliveryErrorHandling
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    bundle.deliver
+  rescue Net::SMTPSyntaxError, Net::SMTPFatalError => error
+    if rescue_with_handler(error)
+      bundle.discard
+    else
+      raise
+    end
+  end
+end
