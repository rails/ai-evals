diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..d460da7
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,101 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :items, class_name: "Notification::Bundle::Item", dependent: :delete_all
+  has_many :notifications, through: :items
+
+  scope :pending, -> { where(processed_at: nil) }
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }, if: -> { starts_at.present? && ends_at.present? }
+  validate :does_not_overlap, if: -> { will_save_change_to_user_id? || will_save_change_to_starts_at? || will_save_change_to_ends_at? }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification, at: notification.updated_at)
+      user = notification.user
+
+      # Lock the person, not just existing windows: there may be no window yet.
+      user.with_lock do
+        if (interval = user.settings&.bundle_email_interval) && user.active? && user.identity.present? && user.account.active?
+          notification.bundle_items.lock.find_by(source: notification.source)&.bundle ||
+            add_to_window(notification, at: at, interval: interval)
+        end
+      end
+    end
+
+    def deliver_all_due
+      due.find_each(&:deliver_later)
+    end
+
+    private
+      def add_to_window(notification, at:, interval:)
+        find_or_create_for(notification.user, at: at, interval: interval).tap do |bundle|
+          item = bundle.items.find_or_initialize_by(notification: notification)
+          item.update!(source: notification.source)
+        end
+      end
+
+      def find_or_create_for(user, at:, interval:)
+        # Delayed notifications can predate starts_at. They still belong to an
+        # existing unsent window, rather than opening an overlapping one.
+        user.notification_bundles.pending.where("ends_at > ?", at).order(:ends_at).lock.first ||
+          create_next_for(user, at: at, interval: interval)
+      end
+
+      def create_next_for(user, at:, interval:)
+        previous_end = user.notification_bundles.order(ends_at: :desc).lock.pick(:ends_at)
+        starts_at = previous_end && at < previous_end ? [ previous_end, Time.current ].max : at
+
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + interval)
+      end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+    end
+  end
+
+  def deliver
+    # Use the same lock order as bundling so delivery cannot race an addition.
+    user.with_lock do
+      with_lock do
+        if processed_at.nil? && ends_at <= Time.current
+          if deliverable?
+            Current.with_account(account) { NotificationMailer.bundle(self).deliver_now }
+          end
+
+          update!(processed_at: Time.current)
+        end
+      end
+    end
+  end
+
+  def discard
+    user.with_lock do
+      with_lock do
+        update!(processed_at: Time.current) if processed_at.nil?
+      end
+    end
+  end
+
+  private
+    def does_not_overlap
+      if user && starts_at && ends_at
+        user.with_lock do
+          overlapping = user.notification_bundles.where.not(id: id)
+            .where("starts_at < ? AND ends_at > ?", ends_at, starts_at).lock
+
+          errors.add(:base, "Digest windows cannot overlap") if overlapping.exists?
+        end
+      end
+    end
+
+    def deliverable?
+      user.active? && user.identity.present? && account.active? &&
+        user.settings&.bundle_email_interval.present? && notifications.exists?
+    end
+end
diff --git a/app/models/notification/bundle/item.rb b/app/models/notification/bundle/item.rb
new file mode 100644
index 0000000..d60229c
--- /dev/null
+++ b/app/models/notification/bundle/item.rb
@@ -0,0 +1,16 @@
+class Notification::Bundle::Item < ApplicationRecord
+  belongs_to :account, default: -> { bundle.account }
+  belongs_to :bundle, class_name: "Notification::Bundle", inverse_of: :items
+  belongs_to :notification
+  belongs_to :source, polymorphic: true
+
+  def bundled_notification
+    # Notifications are reused per card. Keep this window's source even when
+    # the notification has since been updated by activity in another window.
+    notification.dup.tap do |copy|
+      copy.source = source
+      copy.card = notification.card
+      copy.account = notification.account
+    end
+  end
+end
