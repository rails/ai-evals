+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "email digests default to off" do
+    settings = User::Settings.new
+
+    assert_equal "never", settings.bundle_email_frequency
+    assert_nil settings.bundle_email_interval
+  end
+
+  test "supported email frequencies map to intervals" do
+    settings = users(:david).settings
+
+    { never: nil, every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, interval|
+      settings.update!(bundle_email_frequency: frequency)
+
+      assert_equal frequency.to_s, settings.reload.bundle_email_frequency
+      if interval
+        assert_equal interval, settings.bundle_email_interval
+      else
+        assert_nil settings.bundle_email_interval
+      end
+    end
+  end
+
+  test "unsupported and missing email frequencies are invalid" do
+    settings = users(:david).settings
+
+    [ "hourly", "", nil ].each do |frequency|
+      settings.bundle_email_frequency = frequency
+
+      assert_not settings.valid?
+      assert settings.errors[:bundle_email_frequency].present?
+    end
+  end
+end
