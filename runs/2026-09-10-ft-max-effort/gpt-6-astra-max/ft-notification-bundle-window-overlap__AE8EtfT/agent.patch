+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,345 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    travel_to Time.utc(2026, 9, 14, 9, 17, 23)
+  end
+
+  test "off does not create a window or schedule email" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        notify
+      end
+    end
+  end
+
+  test "the first notification starts a window of the chosen duration" do
+    { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, duration|
+      @user.settings.update!(bundle_email_frequency: frequency)
+      notification = notify
+      bundle = notification.bundles.sole
+
+      assert_equal @user, bundle.user
+      assert_equal @user.account, bundle.account
+      assert_equal Time.current, bundle.starts_at
+      assert_equal Time.current + duration, bundle.ends_at
+
+      notification.destroy!
+      bundle.destroy!
+    end
+  end
+
+  test "notifications in the same window schedule only one digest" do
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+      first = notify
+      bundle = first.bundles.sole
+      travel 2.hours
+      second = notify(:layout_published)
+
+      assert_equal bundle, second.bundles.sole
+      assert_equal [ first, second ].sort_by(&:id), bundle.notifications.order(:id).to_a
+      assert_equal 4.hours, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "a notification at the end starts a new nonoverlapping window" do
+    first_bundle = notify.bundles.sole
+    travel_to first_bundle.ends_at
+    second_bundle = notify(:layout_published).bundles.sole
+
+    assert_not_equal first_bundle, second_bundle
+    assert_equal first_bundle.ends_at, second_bundle.starts_at
+    assert_equal second_bundle.starts_at + 4.hours, second_bundle.ends_at
+  end
+
+  test "late notifications join an already opened window even before its start" do
+    bundle = notify.bundles.sole
+    travel 1.hour
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      late_notification = notify(:layout_published, created_at: 2.hours.ago, updated_at: 2.hours.ago)
+      assert_equal bundle, late_notification.bundles.sole
+    end
+
+    assert_equal 4.hours, bundle.reload.ends_at - bundle.starts_at
+  end
+
+  test "frequency changes leave the open window intact" do
+    bundle = notify.bundles.sole
+    @user.settings.update!(bundle_email_frequency: :weekly)
+    travel 1.hour
+
+    assert_equal bundle, notify(:layout_published).bundles.sole
+    assert_equal 4.hours, bundle.reload.ends_at - bundle.starts_at
+
+    travel_to bundle.ends_at
+    notification = @user.notifications.find_by!(card: cards(:logo))
+    notification.update!(source: events(:logo_assignment_km))
+    next_bundle = notification.bundles.order(:starts_at).last
+
+    assert_equal bundle.ends_at, next_bundle.starts_at
+    assert_equal 1.week, next_bundle.ends_at - next_bundle.starts_at
+  end
+
+  test "repeated bundling is idempotent" do
+    notification = notify
+    bundle = notification.bundles.sole
+
+    assert_no_difference [ -> { Notification::Bundle.count }, -> { bundle.items.count } ] do
+      notification.bundle
+      notification.bundle
+    end
+  end
+
+  test "windows are independent for each person" do
+    first_bundle = notify.bundles.sole
+    other_user = users(:jz)
+    other_user.settings.update!(bundle_email_frequency: :daily)
+    travel 30.minutes
+
+    other = other_user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    other_bundle = other.bundles.sole
+
+    assert_not_equal first_bundle, other_bundle
+    assert_equal other_user, other_bundle.user
+    assert_equal Time.current, other_bundle.starts_at
+    assert_equal 1.day, other_bundle.ends_at - other_bundle.starts_at
+  end
+
+  test "one email contains the whole window and retries do not resend it" do
+    first = notify
+    second = notify(:layout_published)
+    bundle = first.bundles.sole
+
+    assert_no_emails { bundle.deliver }
+    assert_nil bundle.reload.processed_at
+
+    travel_to bundle.ends_at
+    assert_emails 1 do
+      bundle.deliver
+      bundle.reload.deliver
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    [ first, second ].each do |notification|
+      assert_includes email.html_part.body.decoded, ERB::Util.html_escape(notification.payload.title)
+      assert_includes email.text_part.body.decoded, notification.payload.title
+    end
+    assert_equal Time.current, bundle.reload.processed_at
+  end
+
+  test "late notifications cannot overlap a delivered window" do
+    bundle = notify.bundles.sole
+    travel_to bundle.ends_at
+    bundle.deliver
+    travel 1.hour
+
+    late = notify(:layout_published, created_at: 2.hours.ago, updated_at: 2.hours.ago)
+    next_bundle = late.bundles.sole
+
+    assert_operator next_bundle.starts_at, :>=, bundle.ends_at
+    assert_equal Time.current, next_bundle.starts_at
+    assert_nil next_bundle.processed_at
+  end
+
+  test "notification activity is bundled but read changes are not" do
+    notification = notify
+    bundle = notification.bundles.sole
+    travel 30.minutes
+
+    assert_no_difference -> { bundle.items.count } do
+      notification.update!(source: events(:logo_assignment_km))
+    end
+
+    travel_to bundle.ends_at
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.read
+      notification.unread
+      notification.update!(unread_count: 5)
+    end
+  end
+
+  test "turning digests off stops additions and suppresses the pending email" do
+    bundle = notify.bundles.sole
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference [ -> { Notification::Bundle.count }, -> { bundle.items.count } ] do
+      notify(:layout_published)
+    end
+
+    travel_to bundle.ends_at
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "inactive people do not open windows" do
+    @user.deactivate
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notify
+    end
+  end
+
+  test "deactivated people do not receive pending digests" do
+    bundle = notify.bundles.sole
+    @user.deactivate
+    travel_to bundle.ends_at
+
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "cancelled accounts do not receive pending digests" do
+    bundle = notify.bundles.sole
+    @user.account.cancel(initiated_by: users(:david))
+    travel_to bundle.ends_at
+
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "system actions do not open windows" do
+    assert_no_difference -> { Notification::Bundle.count } do
+      @user.notifications.create!(source: events(:logo_published), creator: users(:system))
+    end
+  end
+
+  test "people without settings do not open windows" do
+    @user.settings.destroy!
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notify
+    end
+  end
+
+  test "deleted notifications are removed from digests and empty digests are skipped" do
+    notification = notify
+    bundle = notification.bundles.sole
+    notification.destroy!
+
+    assert_empty bundle.items
+    assert_empty bundle.notifications
+    travel_to bundle.ends_at
+
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "failed deliveries remain pending for retry" do
+    bundle = notify.bundles.sole
+    travel_to bundle.ends_at
+    delivery = mock
+    delivery.expects(:deliver_now).raises(Net::OpenTimeout)
+    NotificationMailer.expects(:bundle).with(bundle).returns(delivery)
+
+    assert_raises(Net::OpenTimeout) { bundle.deliver }
+    assert_nil bundle.reload.processed_at
+  end
+
+  test "late notifications join the next pending window after a delivery" do
+    first_bundle = notify.bundles.sole
+    travel_to first_bundle.ends_at
+    first_bundle.deliver
+    current_notification = notify(:layout_published)
+    current_bundle = current_notification.bundles.sole
+    travel 1.hour
+
+    late = notify(:buy_domain_sent_back_to_triage, created_at: 1.day.ago, updated_at: 1.day.ago)
+
+    assert_equal current_bundle, late.bundles.sole
+    assert_equal first_bundle.ends_at, current_bundle.starts_at
+  end
+
+  test "direct window creation rejects overlaps but allows adjacent windows" do
+    bundle = notify.bundles.sole
+    overlapping = @user.notification_bundles.new(starts_at: bundle.starts_at - 1.hour, ends_at: bundle.starts_at + 1.hour)
+
+    assert_not overlapping.valid?
+    assert_includes overlapping.errors[:base], "Digest windows cannot overlap"
+
+    adjacent = @user.notification_bundles.create!(starts_at: bundle.ends_at, ends_at: bundle.ends_at + 4.hours)
+    assert adjacent.persisted?
+  end
+
+  test "window bounds must be present and increasing" do
+    [ [ nil, Time.current ], [ Time.current, nil ], [ Time.current, Time.current ], [ Time.current, 1.hour.ago ] ].each do |starts_at, ends_at|
+      bundle = @user.notification_bundles.new(starts_at: starts_at, ends_at: ends_at)
+      assert_not bundle.valid?
+    end
+  end
+
+  test "a gap between digests does not align the next window to the old schedule" do
+    bundle = notify.bundles.sole
+    travel_to bundle.ends_at + 3.hours + 13.minutes
+    next_bundle = notify(:layout_published).bundles.sole
+
+    assert_equal Time.current, next_bundle.starts_at
+    assert_equal Time.current + 4.hours, next_bundle.ends_at
+  end
+
+  test "an overdue digest keeps the activity from its own window" do
+    notification = notify
+    first_bundle = notification.bundles.sole
+    original_body = notification.payload.body
+    travel_to first_bundle.ends_at + 1.hour
+    notification.update!(source: events(:logo_assignment_km))
+    next_bundle = notification.bundles.order(:starts_at).last
+    next_body = notification.payload.body
+
+    assert_emails(1) { first_bundle.deliver }
+    first_email = ActionMailer::Base.deliveries.last
+    assert_includes first_email.text_part.body.decoded, original_body
+    assert_not_includes first_email.text_part.body.decoded, next_body
+
+    travel_to next_bundle.ends_at
+    assert_emails(1) { next_bundle.deliver }
+    assert_includes ActionMailer::Base.deliveries.last.text_part.body.decoded, next_body
+  end
+
+  test "retrying an already delivered notification does not open another window" do
+    notification = notify
+    bundle = notification.bundles.sole
+    travel_to bundle.ends_at
+    bundle.deliver
+    travel 1.hour
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      assert_equal bundle, notification.bundle
+    end
+  end
+
+  test "deleted sources are removed even when the notification has newer activity" do
+    notification = notify
+    bundle = notification.bundles.sole
+    travel_to bundle.ends_at
+    notification.update!(source: events(:logo_assignment_km))
+    events(:logo_published).destroy!
+
+    assert_empty bundle.items
+    assert_no_emails { bundle.deliver }
+    assert notification.reload.persisted?
+  end
+
+  test "window boundaries preserve subsecond notification timestamps" do
+    travel_to Time.current.change(usec: 123_456), with_usec: true
+    bundle = notify.bundles.sole
+    assert_equal Time.current, bundle.starts_at
+
+    travel_to bundle.ends_at, with_usec: true
+    assert_emails(1) { bundle.deliver }
+    assert_equal bundle.ends_at, notify(:layout_published).bundles.sole.starts_at
+  end
+
+  private
+    def notify(event = :logo_published, **attributes)
+      @user.notifications.create!(source: events(event), creator: users(:david), **attributes)
+    end
+end
