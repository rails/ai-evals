@@ -0,0 +1,343 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of events newest first" do
+    get "#{accounts("37s").slug}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).pluck(:id), @response.parsed_body.pluck("id")
+  end
+
+  test "card events use the existing API representations and plain text descriptions" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    get card_path(event.card), as: :json
+    assert_equal @response.parsed_body.except("steps"), activity["eventable"]
+
+    get board_path(event.board), as: :json
+    assert_equal @response.parsed_body, activity["board"]
+
+    get user_path(event.creator), as: :json
+    assert_equal @response.parsed_body, activity["creator"]
+  end
+
+  test "comment events link to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment), as: :json
+    assert_equal @response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+    included_events = actions.map do |action|
+      eventable = action == "comment_created" ? comments(:layout_overflowing_david) : cards(:logo)
+      create_event(action, eventable: eventable)
+    end
+    excluded_events = %w[ card_collection_changed card_resumed unknown_action ].map { |action| create_event(action) }
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal actions.sort, @response.parsed_body.pluck("action").uniq.sort
+    included_events.each { |event| assert_includes @response.parsed_body.pluck("id"), event.id }
+    excluded_events.each { |event| assert_not_includes @response.parsed_body.pluck("id"), event.id }
+  end
+
+  test "assignment changes expose only assignee ids" do
+    assignee_ids = [ users(:david).id, users(:jz).id ]
+
+    %w[ card_assigned card_unassigned ].each do |action|
+      event = create_event(action, particulars: { assignee_ids: assignee_ids, unrelated: "ignored" })
+
+      assert_equal({ "assignee_ids" => assignee_ids }, activity_for(event)["particulars"])
+    end
+  end
+
+  test "board changes expose board names" do
+    event = create_event("card_board_changed", particulars: {
+      particulars: { old_board: "Old board", new_board: "New board", unrelated: "ignored" }
+    })
+
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activity_for(event)["particulars"])
+  end
+
+  test "title changes expose old and new titles" do
+    old_title = cards(:logo).title
+    with_current_user :kevin do
+      cards(:logo).update!(title: "A better logo")
+    end
+    event = cards(:logo).events.find_by!(action: "card_title_changed")
+
+    activity = activity_for(event)
+
+    assert_equal({ "old_title" => old_title, "new_title" => "A better logo" }, activity["particulars"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+  end
+
+  test "triage events expose the column name" do
+    event = create_event("card_triaged", particulars: { particulars: { column: "In Progress", unrelated: "ignored" } })
+
+    assert_equal({ "column" => "In Progress" }, activity_for(event)["particulars"])
+  end
+
+  test "missing board title and column details are empty strings" do
+    {
+      "card_board_changed" => %w[ old_board new_board ],
+      "card_title_changed" => %w[ old_title new_title ],
+      "card_triaged" => %w[ column ]
+    }.each do |action, keys|
+      [ {}, { particulars: keys.index_with(nil) } ].each do |particulars|
+        event = create_event(action, particulars: particulars)
+
+        assert_equal keys.index_with(""), activity_for(event)["particulars"]
+      end
+    end
+  end
+
+  test "other events have empty particulars even when extra details are stored" do
+    %w[ card_published card_closed card_reopened card_postponed card_auto_postponed card_sent_back_to_triage ].each do |action|
+      event = create_event(action, particulars: { assignee_ids: [ users(:jz).id ], particulars: { column: "Ignored" } })
+
+      assert_equal({}, activity_for(event)["particulars"])
+    end
+  end
+
+  test "filters by creator ids" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.where(creator: users(:kevin)).ids.sort, @response.parsed_body.pluck("id").sort
+
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id, users(:david).id ])
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.ids.sort, @response.parsed_body.pluck("id").sort
+  end
+
+  test "filters by board ids and combines board and creator filters" do
+    private_card = create_private_card
+    private_event = private_card.events.sole
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id, boards(:writebook).id ], creator_ids: [ users(:kevin).id ])
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.where(creator: users(:kevin)).ids.sort, @response.parsed_body.pluck("id").sort
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ], creator_ids: [ users(:david).id ])
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "empty filters do not restrict activity" do
+    get activities_path(format: :json), params: { board_ids: [], creator_ids: [] }
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.ids.sort, @response.parsed_body.pluck("id").sort
+  end
+
+  test "unknown filters return an empty array" do
+    [ { creator_ids: [ ActiveRecord::Type::Uuid.generate ] }, { board_ids: [ ActiveRecord::Type::Uuid.generate ] } ].each do |filters|
+      get activities_path(format: :json), params: filters
+
+      assert_response :success
+      assert_equal [], @response.parsed_body
+      assert_equal "0", @response.headers["X-Total-Count"]
+      assert_nil @response.headers["Link"]
+    end
+  end
+
+  test "only returns accessible activity even when filtering by inaccessible boards" do
+    private_event = create_private_card.events.sole
+    other_account_event = create_event("card_published", eventable: cards(:radio), creator: users(:mike))
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes @response.parsed_body.pluck("id"), other_account_event.id
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id, boards(:writebook).id, boards(:miltons_wish_list).id ])
+
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id, boards(:miltons_wish_list).id ])
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "card and comment activity follows cards moved to inaccessible boards" do
+    with_current_user :kevin do
+      cards(:layout).move_to(boards(:private))
+    end
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert_not_includes @response.parsed_body.pluck("id"), events(:layout_published).id
+    assert_not_includes @response.parsed_body.pluck("id"), events(:layout_commented).id
+  end
+
+  test "users without board access receive an empty array" do
+    logout_and_sign_in_as :jason
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+    assert_equal "0", @response.headers["X-Total-Count"]
+    assert_nil @response.headers["Link"]
+  end
+
+  test "cannot access another account" do
+    get activities_path(format: :json, script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+  end
+
+  test "index accepts read-only bearer tokens" do
+    sign_out
+    token = identities(:kevin).access_tokens.create!(description: "Activity reader", permission: :read)
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+  end
+
+  test "index rejects invalid bearer tokens" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer invalid" }
+
+    assert_response :unauthorized
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json", @response.media_type
+
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "paginates newest first with stable ordering and preserves filters in next links" do
+    activity_time = 2.days.ago.change(usec: 0)
+    50.times do |index|
+      create_event("card_published", created_at: activity_time + (index / 2).seconds)
+    end
+    create_private_card
+    create_event("card_published", creator: users(:jz))
+    creator_ids = [ users(:kevin).id, users(:david).id ]
+    board_ids = [ boards(:writebook).id, boards(:private).id ]
+    expected_ids = users(:kevin).accessible_events.where(creator_id: creator_ids, board_id: board_ids).order(created_at: :desc, id: :desc).pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: creator_ids, board_ids: board_ids)
+    page_count = 0
+
+    while next_page
+      get next_page
+
+      assert_response :success
+      assert_kind_of Array, @response.parsed_body
+      assert_equal expected_ids.size.to_s, @response.headers["X-Total-Count"]
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      page_count += 1
+      assert_operator page_count, :<, 10, "Pagination should terminate"
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "pages beyond the end return an empty array" do
+    get activities_path(format: :json, page: 999)
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "activity includes system and deactivated creators" do
+    system_event = create_event("card_auto_postponed", creator: users(:system))
+    users(:david).deactivate
+
+    get activities_path(format: :json, creator_ids: [ users(:system).id, users(:david).id ])
+
+    assert_response :success
+    system_activity = @response.parsed_body.find { |activity| activity["id"] == system_event.id }
+    assert_equal "system", system_activity.dig("creator", "role")
+    assert_nil system_activity.dig("creator", "email_address")
+    deactivated_activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_published).id }
+    assert_equal false, deactivated_activity.dig("creator", "active")
+    assert_nil deactivated_activity.dig("creator", "email_address")
+  end
+
+  private
+    def create_event(action, eventable: cards(:logo), creator: users(:kevin), **attributes)
+      eventable.events.create!(action: action, board: eventable.card.board, creator: creator, **attributes)
+    end
+
+    def create_private_card
+      with_current_user :kevin do
+        boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :published)
+      end
+    end
+
+    def activity_for(event)
+      get activities_path(format: :json)
+      assert_response :success
+      @response.parsed_body.find { |record| record["id"] == event.id }
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
diff --git a/test/lib/geared_pagination_test.rb b/test/lib/geared_pagination_test.rb
new file mode 100644
index 0000000..5170561
--- /dev/null
+++ b/test/lib/geared_pagination_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class GearedPaginationTest < ActiveSupport::TestCase
+  test "next page links work without query parameters" do
+    headers = pagination_headers("http://example.com/1234/activities.json")
+
+    assert_equal "40", headers["X-Total-Count"]
+    assert_equal '<http://example.com/1234/activities.json?page=2>; rel="next"', headers["Link"]
+  end
+
+  test "next page links preserve repeated and encoded parameters and replace the page" do
+    url = "http://example.com/1234/activities.json?creator_ids[]=first&creator_ids[]=second&board_ids[]=one&board_ids[]=two&terms[]=one%20%26%20two&terms[]=a%2Bb%3Fc&page=1"
+    headers = pagination_headers(url)
+    next_url = headers["Link"].match(/<([^>]+)>/)[1]
+    query = URI.parse(next_url).query
+
+    assert_equal({
+      "creator_ids" => [ "first", "second" ],
+      "board_ids" => [ "one", "two" ],
+      "terms" => [ "one & two", "a+b?c" ],
+      "page" => "2"
+    }, Rack::Utils.parse_nested_query(query))
+    assert_equal 1, URI.decode_www_form(query).count { |key, _| key == "page" }
+  end
+
