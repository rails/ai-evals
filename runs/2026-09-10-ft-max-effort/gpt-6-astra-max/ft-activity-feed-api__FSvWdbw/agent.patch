@@ -0,0 +1,32 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_title_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+  ].freeze
+
+  def index
+    respond_to do |format|
+      format.json { set_page_and_extract_portion_from activity_events }
+    end
+  end
+
+  private
+    def activity_events
+      filters = params.permit(creator_ids: [], board_ids: []).transform_values(&:compact_blank)
+      events = Current.user.accessible_events.where(action: ACTIVITY_ACTIONS)
+      events = events.where(creator_id: filters[:creator_ids]) if filters[:creator_ids].present?
+      events = events.where(board_id: filters[:board_ids]) if filters[:board_ids].present?
+
+      events.preloaded.order(created_at: :desc, id: :desc)
+    end
+end
