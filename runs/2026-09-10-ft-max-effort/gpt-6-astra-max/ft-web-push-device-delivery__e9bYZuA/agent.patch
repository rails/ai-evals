diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..3c7061f
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,36 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: :push_source_changed?
+  end
+
+  def push_later
+    if PushSubscription.configured? && user.push_subscriptions.exists?
+      payload = push_payload
+
+      Current.with_account(account) do
+        user.push_subscriptions.find_each do |subscription|
+          Notification::PushJob.perform_later(self, subscription, payload)
+        end
+      end
+    end
+  end
+
+  def push_to(subscription, payload)
+    if subscription.user_id == user_id && !read? && user.active? && account.active? && user.accessible_cards.exists?(id: card_id)
+      subscription.push(payload)
+    end
+  end
+
+  def push_payload
+    ApplicationController.renderer.new(script_name: account.slug).render(
+      template: "notifications/push", formats: [ :json ], assigns: { notification: self }
+    )
+  end
+
+  private
+    def push_source_changed?
+      source_id_previously_changed? || source_type_previously_changed?
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..f855a33
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,56 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  scope :for_endpoint, ->(endpoint) { where(endpoint_digest: Digest::SHA256.hexdigest(endpoint.to_s)) }
+
+  before_validation :set_endpoint_digest, if: :endpoint_changed?
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 2048 }
+  validates :p256dh_key, :auth_key, length: { maximum: 255 }
+  validates :endpoint_digest, uniqueness: { scope: :user_id }
+  validate :validate_endpoint
+
+  class << self
+    def configured?
+      vapid.values_at(:public_key, :private_key).all?(&:present?)
+    end
+
+    def vapid
+      {
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"],
+        subject: ENV.fetch("BASE_URL", "https://fizzy.do")
+      }
+    end
+  end
+
+  def push(payload)
+    if self.class.configured?
+      Request.new(
+        message: payload,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: self.class.vapid,
+        ttl: 1.day.to_i
+      ).perform
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy
+  end
+
+  private
+    def set_endpoint_digest
+      # Endpoints are case-sensitive and can exceed MySQL's index length limit.
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add :endpoint, "must be an HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS URL"
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..3434656
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,32 @@
+class PushSubscription::Request < WebPush::Request
+  ENDPOINT_TIMEOUT = 5
+  MAX_RESPONSE_SIZE = 16.kilobytes
+
+  class ResponseTooLarge < StandardError; end
+
+  def perform
+    if ip_address = SsrfProtection.resolve_public_ip(uri.host)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.ipaddr = ip_address
+      http.use_ssl = true
+      http.open_timeout = ENDPOINT_TIMEOUT
+      http.read_timeout = ENDPOINT_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+      response = http.request(request) { |response| read_response_with_limit(response) }
+      verify_response(response)
+      response
+    end
+  end
+
+  private
+    def read_response_with_limit(response)
+      response_body = +""
+      response.read_body do |chunk|
+        raise ResponseTooLarge if response_body.bytesize + chunk.bytesize > MAX_RESPONSE_SIZE
+        response_body << chunk
+      end
+      response.body = response_body
+    end
+end
