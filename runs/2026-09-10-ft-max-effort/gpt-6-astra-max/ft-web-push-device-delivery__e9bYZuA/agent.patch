--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,12 @@
+class Notification::PushJob < ApplicationJob
+  self.log_arguments = false
+
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout,
+    SocketError, Errno::ECONNRESET, Errno::ECONNREFUSED, Resolv::ResolvError, Resolv::ResolvTimeout,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(notification, subscription, payload)
+    notification.push_to(subscription, payload)
+  end
+end
