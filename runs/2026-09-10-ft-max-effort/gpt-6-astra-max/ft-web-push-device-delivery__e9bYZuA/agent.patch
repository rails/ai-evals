+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,171 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    key = WebPush.generate_key
+    @vapid = { public_key: key.public_key, private_key: key.private_key, subject: "https://example.com" }
+    PushSubscription.stubs(:vapid).returns(@vapid)
+
+    @attributes = {
+      endpoint: "https://push.example.com/device",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16))
+    }
+    @subscription = users(:kevin).subscribe_to_push(@attributes)
+    @payload = { title: "A card", body: "Added by David", data: { url: "/123/cards/42" } }.to_json
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "sends an encrypted Web Push request with the configured VAPID keys" do
+    delivery = stub_request(:post, @subscription.endpoint).with do |request|
+      assert_equal "application/octet-stream", request.headers["Content-Type"]
+      assert_equal "aes128gcm", request.headers["Content-Encoding"]
+      assert_equal 1.day.to_i.to_s, request.headers["Ttl"]
+      assert_not_equal @payload, request.body
+
+      authorization = request.headers["Authorization"].match(/\Avapid t=(.+),k=(.+)\z/)
+      assert_equal @vapid[:public_key].delete("="), authorization[2]
+      jwt, = JWT.decode(authorization[1], WebPush::VapidKey.from_keys(@vapid[:public_key], @vapid[:private_key]).curve, true, algorithm: "ES256")
+      assert_equal "https://push.example.com", jwt["aud"]
+      assert_equal @vapid[:subject], jwt["sub"]
+      true
+    end.to_return(status: 201)
+
+    @subscription.push(@payload)
+
+    assert_requested delivery
+  end
+
+  test "removes expired subscriptions" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+    assert_difference "PushSubscription.count", -1 do
+      @subscription.push(@payload)
+    end
+
+    assert @subscription.destroyed?
+  end
+
+  test "removes invalid subscriptions" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 404)
+
+    assert_difference "PushSubscription.count", -1 do
+      @subscription.push(@payload)
+    end
+  end
+
+  test "does not remove subscriptions for VAPID authorization errors" do
+    [ 401, 403 ].each do |status|
+      stub_request(:post, @subscription.endpoint).to_return(status: status)
+
+      assert_no_difference "PushSubscription.count" do
+        assert_raises WebPush::Unauthorized do
+          @subscription.push(@payload)
+        end
+      end
+    end
+  end
+
+  test "preserves subscriptions and propagates temporary service errors for retry" do
+    { 429 => WebPush::TooManyRequests, 503 => WebPush::PushServiceError }.each do |status, error|
+      stub_request(:post, @subscription.endpoint).to_return(status: status)
+
+      assert_no_difference "PushSubscription.count" do
+        assert_raises error do
+          @subscription.push(@payload)
+        end
+      end
+    end
+  end
+
+  test "does not send without both VAPID keys" do
+    [ :public_key, :private_key ].each do |key|
+      PushSubscription.stubs(:vapid).returns(@vapid.except(key))
+      Net::HTTP.expects(:new).never
+
+      assert_not PushSubscription.configured?
+      @subscription.push(@payload)
+    end
+  end
+
+  test "does not deliver to private endpoints" do
+    stub_dns_resolution("127.0.0.1", "10.0.0.1", "169.254.169.254", "::1")
+    Net::HTTP.expects(:new).never
+
+    @subscription.push(@payload)
+  end
+
+  test "pins delivery to the checked public address" do
+    http = mock("http")
+    Net::HTTP.expects(:new).with("push.example.com", 443).returns(http)
+    http.expects(:ipaddr=).with("93.184.216.34")
+    http.expects(:use_ssl=).with(true)
+    http.expects(:open_timeout=).with(PushSubscription::Request::ENDPOINT_TIMEOUT)
+    http.expects(:read_timeout=).with(PushSubscription::Request::ENDPOINT_TIMEOUT)
+    http.expects(:request).with(instance_of(Net::HTTP::Post)).returns(Net::HTTPCreated.new("1.1", "201", "Created"))
+
+    @subscription.push(@payload)
+  end
+
+  test "does not buffer oversized push-service responses" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 201, body: "x" * (PushSubscription::Request::MAX_RESPONSE_SIZE + 1))
+
+    assert_raises PushSubscription::Request::ResponseTooLarge do
+      @subscription.push(@payload)
+    end
+
+    assert PushSubscription.exists?(@subscription.id)
+  end
+
+  test "requires endpoint and both encryption keys" do
+    @attributes.each_key do |attribute|
+      @subscription.assign_attributes(attribute => nil)
+
+      assert_not @subscription.valid?
+      assert @subscription.errors.added?(attribute, :blank)
+      @subscription.reload
+    end
+  end
+
+  test "requires a valid HTTPS endpoint without credentials or a fragment" do
+    [ "invalid", "http://push.example.com/device", "https:///device", "https://user:password@push.example.com/device", "https://push.example.com/device#fragment" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+
+      assert_not @subscription.valid?, "Should reject #{endpoint}"
+      assert @subscription.errors[:endpoint].present?
+    end
+  end
+
+  test "supports long endpoints and uses a case-sensitive digest for uniqueness" do
+    attributes = @attributes.merge(endpoint: "https://push.example.com/#{'a' * 1000}")
+    subscription = users(:kevin).subscribe_to_push(attributes)
+
+    assert_equal subscription, users(:kevin).subscribe_to_push(attributes)
+    assert_not_equal subscription, users(:kevin).subscribe_to_push(attributes.merge(endpoint: attributes[:endpoint].upcase))
+  end
+
+  test "the same browser can subscribe independently to different account memberships" do
+    other_subscription = users(:mike).subscribe_to_push(@attributes)
+
+    assert_not_equal @subscription, other_subscription
+    assert_equal accounts(:initech), other_subscription.account
+    assert_equal @subscription.endpoint, other_subscription.endpoint
+  end
+
+  test "duplicate endpoints are rejected for the same user" do
+    duplicate = @subscription.user.push_subscriptions.new(@attributes)
+
+    assert_not duplicate.valid?
+    assert duplicate.errors[:endpoint_digest].present?
+  end
+
+  test "destroying a user removes their subscriptions" do
+    user = accounts(:"37s").users.create!(name: "Push recipient")
+    subscription = user.subscribe_to_push(@attributes)
+
+    user.destroy!
+
+    assert_not PushSubscription.exists?(subscription.id)
+    assert PushSubscription.exists?(@subscription.id)
+  end
+end
