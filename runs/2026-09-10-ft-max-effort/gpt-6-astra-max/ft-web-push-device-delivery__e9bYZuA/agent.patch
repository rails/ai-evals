+<section class="settings__section hide-on-native">
+  <h2 class="divider">Push Notifications</h2>
+  <p>Get the same notifications as your tray on this device.</p>
+
+  <% if PushSubscription.configured? %>
+    <div data-controller="notifications"
+         data-notifications-url-value="<%= user_push_subscriptions_path(Current.user) %>"
+         data-notifications-public-key-value="<%= PushSubscription.vapid[:public_key] %>"
+         data-action="focus@window->notifications#refresh online@window->notifications#refresh">
+      <div class="notifications__status panel" aria-live="polite">
+        <p class="notifications__on-message">Push notifications are on for this device.</p>
+        <p class="notifications__off-message">Push notifications are off for this device.</p>
+
+        <button type="button" class="btn btn--link" data-notifications-target="enable" data-action="notifications#enable" disabled>Turn on notifications</button>
+        <button type="button" class="btn btn--link" data-notifications-target="disable" data-action="notifications#disable" hidden>Turn off notifications</button>
+
+        <p data-notifications-target="unsupported" hidden>This browser doesn’t support push notifications. Try another browser or install Fizzy as a web app.</p>
+        <p data-notifications-target="denied" hidden>Notifications are blocked. Follow the instructions below to allow them, then try again.</p>
+        <p data-notifications-target="error" role="alert" hidden>Couldn’t update push notifications. Please try again.</p>
+      </div>
+
+      <details data-notifications-target="help" class="margin-block-start-half">
+        <summary>Need help with notifications?</summary>
+        <div class="notifications-help__explainer">
+          <%= render "notifications/settings/browser" %>
+          <%= render "notifications/settings/install" %>
+          <%= render "notifications/settings/system" %>
+        </div>
+      </details>
+    </div>
+  <% else %>
+    <p>Push notifications haven’t been configured on this server.</p>
+  <% end %>
+</section>
