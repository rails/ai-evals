+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,165 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @attributes = {
+      endpoint: "https://push.example.com/device-one",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-key"
+    }
+    sign_in_as @user
+  end
+
+  test "registers the current device for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.sole
+    assert_equal @attributes, subscription.attributes.symbolize_keys.slice(*@attributes.keys)
+    assert_equal @user.account, subscription.account
+    assert_equal subscription.id, response.parsed_body["id"]
+  end
+
+  test "accepts form-encoded browser subscriptions" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }
+
+    assert_response :created
+    assert_equal @attributes[:endpoint], @user.push_subscriptions.sole.endpoint
+  end
+
+  test "registering the same endpoint again refreshes its keys without duplicating it" do
+    subscription = @user.subscribe_to_push(@attributes)
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: @attributes.merge(p256dh_key: "new-public-key", auth_key: "new-auth-key")
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal subscription.id, response.parsed_body["id"]
+    assert_equal "new-public-key", subscription.reload.p256dh_key
+    assert_equal "new-auth-key", subscription.auth_key
+  end
+
+  test "registering another device keeps the first device" do
+    first_device = @user.subscribe_to_push(@attributes)
+
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: @attributes.merge(endpoint: "https://push.example.com/device-two")
+      }, as: :json
+    end
+
+    assert_response :created
+    assert @user.push_subscriptions.exists?(first_device.id)
+  end
+
+  test "lists only the current user's devices without their keys" do
+    subscription = @user.subscribe_to_push(@attributes)
+    users(:kevin).subscribe_to_push(@attributes.merge(endpoint: "https://push.example.com/kevin"))
+
+    get user_push_subscriptions_path(@user), as: :json
+
+    assert_response :success
+    assert_equal [ { "id" => subscription.id, "endpoint" => subscription.endpoint } ], response.parsed_body
+  end
+
+  test "removes only the selected device" do
+    subscription = @user.subscribe_to_push(@attributes)
+    other_device = @user.subscribe_to_push(@attributes.merge(endpoint: "https://push.example.com/device-two"))
+
+    assert_difference "PushSubscription.count", -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+    assert @user.push_subscriptions.exists?(other_device.id)
+  end
+
+  test "cannot register for another user even as an administrator" do
+    sign_out
+    sign_in_as :kevin
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot list another user's subscriptions" do
+    get user_push_subscriptions_path(users(:kevin)), as: :json
+
+    assert_response :forbidden
+  end
+
+  test "cannot delete another user's subscription through own user URL" do
+    subscription = users(:kevin).subscribe_to_push(@attributes)
+
+    assert_no_difference "PushSubscription.count" do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "cannot delete another user's subscription through their user URL" do
+    subscription = users(:kevin).subscribe_to_push(@attributes)
+
+    assert_no_difference "PushSubscription.count" do
+      delete user_push_subscription_path(users(:kevin), subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot register a user from another account" do
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(users(:mike)), params: { push_subscription: @attributes }, as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @attributes }, as: :json
+    end
+
+    assert_response :redirect
+  end
+
+  test "ignores client-supplied user and account IDs" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: @attributes.merge(user_id: users(:mike).id, account_id: accounts(:initech).id)
+    }, as: :json
+
+    assert_response :created
+    assert_equal @user.account, @user.push_subscriptions.sole.account
+  end
+
+  test "rejects missing subscription parameters" do
+    post user_push_subscriptions_path(@user), params: {}, as: :json
+
+    assert_response :bad_request
+  end
+
+  test "rejects incomplete subscriptions" do
+    @attributes.each_key do |attribute|
+      assert_no_difference "PushSubscription.count" do
+        post user_push_subscriptions_path(@user), params: {
+          push_subscription: @attributes.except(attribute)
+        }, as: :json
+      end
+
+      assert_response :unprocessable_entity
+      assert response.parsed_body["errors"].key?(attribute.to_s)
+    end
+  end
+end
