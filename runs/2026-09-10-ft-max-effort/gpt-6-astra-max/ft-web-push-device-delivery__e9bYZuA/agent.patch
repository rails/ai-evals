new file mode 100644
index 0000000..d47e7df
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,36 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def index
+    no_store
+    render json: @user.push_subscriptions.as_json(only: [ :id, :endpoint ])
+  end
+
+  def create
+    subscription = @user.subscribe_to_push(push_subscription_params)
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: { errors: error.record.errors }, status: :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..43b279f
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,140 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+import { isNative } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static targets = [ "enable", "disable", "unsupported", "denied", "error", "help" ]
+  static values = { url: String, publicKey: String }
+
+  #registration
+  #subscription
+  #subscriptionId
+  #busy = false
+  #error = false
+
+  async connect() {
+    if (isNative()) {
+      this.element.hidden = true
+    } else {
+      this.#render()
+      await this.refresh()
+    }
+  }
+
+  async refresh() {
+    if (!this.#supported || this.#busy) return
+
+    this.#busy = true
+    this.#error = false
+    this.#render()
+
+    try {
+      this.#registration ||= await this.#registerServiceWorker()
+      this.#subscription = await this.#registration.pushManager.getSubscription()
+      let subscriptionId = null
+
+      if (this.#subscription && Notification.permission === "granted") {
+        const response = await get(this.urlValue, { responseKind: "json" })
+        if (!response.ok) throw new Error("Could not load push subscriptions")
+
+        const subscriptions = await response.json
+        subscriptionId = subscriptions.find(subscription => subscription.endpoint === this.#subscription.endpoint)?.id
+      }
+
+      this.#subscriptionId = subscriptionId
+    } catch {
+      this.#error = true
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async enable() {
+    if (!this.#registration || this.#busy) return
+
+    this.#busy = true
+    this.#error = false
+    this.#render()
+
+    try {
+      // Request permission directly from the click, before any other asynchronous work.
+      if (await Notification.requestPermission() === "granted") {
+        this.#subscription ||= await this.#registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+
+        const { endpoint, keys } = this.#subscription.toJSON()
+        const response = await post(this.urlValue, {
+          body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+          responseKind: "json"
+        })
+        if (!response.ok) throw new Error("Could not save push subscription")
+
+        this.#subscriptionId = (await response.json).id
+      }
+    } catch {
+      this.#error = true
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async disable() {
+    if (!this.#subscriptionId || this.#busy) return
+
+    this.#busy = true
+    this.#error = false
+    this.#render()
+
+    try {
+      const response = await destroy(`${this.urlValue}/${encodeURIComponent(this.#subscriptionId)}`, { responseKind: "json" })
+      if (!response.ok && response.statusCode !== 404) throw new Error("Could not remove push subscription")
+
+      // Other accounts on this device may still use the browser's subscription.
+      this.#subscriptionId = null
+    } catch {
+      this.#error = true
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async #registerServiceWorker() {
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    return await navigator.serviceWorker.ready
+  }
+
+  #render() {
+    const enabled = !!this.#subscriptionId && this.#permission === "granted"
+    const denied = this.#permission === "denied"
+
+    this.element.classList.toggle("notifications--on", enabled)
+    this.enableTarget.hidden = enabled || !this.#supported
+    this.enableTarget.disabled = this.#busy || !this.#registration || denied
+    this.disableTarget.hidden = !enabled
+    this.disableTarget.disabled = this.#busy
+    this.unsupportedTarget.hidden = this.#supported
+    this.deniedTarget.hidden = !denied
+    this.errorTarget.hidden = !this.#error
+
+    if (denied || !this.#supported) this.helpTarget.open = true
+  }
+
+  get #permission() {
+    return window.Notification?.permission
+  }
+
+  get #supported() {
+    return !isNative() && window.isSecureContext && "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
