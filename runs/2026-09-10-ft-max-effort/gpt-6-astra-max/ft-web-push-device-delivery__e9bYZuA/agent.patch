+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    @attributes = { endpoint: "https://push.example.com/browser", p256dh_key: "browser-key", auth_key: "browser-auth" }
+    PushSubscription.stubs(:vapid).returns(public_key: "AQID_w", private_key: "private-vapid-key")
+
+    sign_in_as @user
+    stub_browser_push
+  end
+
+  test "enables this device only after a user gesture" do
+    visit_settings
+
+    assert_button "Turn on notifications", disabled: false
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+    assert_empty @user.push_subscriptions
+
+    click_on "Turn on notifications"
+
+    assert_text "Push notifications are on for this device."
+    assert_equal @attributes, @user.push_subscriptions.sole.attributes.symbolize_keys.slice(*@attributes.keys)
+    assert_equal [ 1, 2, 3, 255 ], page.evaluate_script("pushTest.options.applicationServerKey")
+    assert page.evaluate_script("pushTest.options.userVisibleOnly")
+    assert page.evaluate_script("pushTest.requestedFromGesture")
+  end
+
+  test "recognizes the current device without asking for permission again" do
+    @user.subscribe_to_push(@attributes)
+    page.execute_script("pushTest.subscribed = true; pushTest.permission = 'granted'")
+
+    visit_settings
+
+    assert_text "Push notifications are on for this device."
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+    assert_equal 1, @user.push_subscriptions.count
+  end
+
+  test "a browser subscription does not silently opt another account in" do
+    users(:mike).subscribe_to_push(@attributes)
+    page.execute_script("pushTest.subscribed = true; pushTest.permission = 'granted'")
+
+    visit_settings
+
+    assert_button "Turn on notifications", disabled: false
+    assert_empty @user.push_subscriptions
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+
+    click_on "Turn on notifications"
+
+    assert_text "Push notifications are on for this device."
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal 0, page.evaluate_script("pushTest.subscribeCalls")
+  end
+
+  test "disables only this account's current device" do
+    current = @user.subscribe_to_push(@attributes)
+    other_device = @user.subscribe_to_push(@attributes.merge(endpoint: "https://push.example.com/phone"))
+    other_account = users(:mike).subscribe_to_push(@attributes)
+    page.execute_script("pushTest.subscribed = true; pushTest.permission = 'granted'")
+
+    visit_settings
+    click_on "Turn off notifications"
+
+    assert_text "Push notifications are off for this device."
+    assert_not PushSubscription.exists?(current.id)
+    assert PushSubscription.exists?(other_device.id)
+    assert PushSubscription.exists?(other_account.id)
+    assert_equal 0, page.evaluate_script("pushTest.unsubscribeCalls")
+  end
+
+  test "denied permission shows the supplied help without registering" do
+    page.execute_script("pushTest.nextPermission = 'denied'")
+    visit_settings
+    click_on "Turn on notifications"
+
+    assert_text "Notifications are blocked."
+    assert_selector "[data-notifications-target='help'][open]"
+    assert_text "Turn on notifications for this website."
+    assert_empty @user.push_subscriptions
+    assert_equal 0, page.evaluate_script("pushTest.subscribeCalls")
+    assert_button "Turn on notifications", disabled: true
+
+    page.execute_script("pushTest.permission = 'granted'; window.dispatchEvent(new Event('focus'))")
+
+    assert_button "Turn on notifications", disabled: false
+    assert_empty @user.push_subscriptions
+  end
+
+  test "dismissing permission leaves notifications off" do
+    page.execute_script("pushTest.nextPermission = 'default'")
+    visit_settings
+    click_on "Turn on notifications"
+
+    assert_text "Push notifications are off for this device."
+    assert_button "Turn on notifications", disabled: false
+    assert_empty @user.push_subscriptions
+    assert_equal 0, page.evaluate_script("pushTest.subscribeCalls")
+  end
+
+  test "unsupported browsers get help instead of a broken enable button" do
+    page.execute_script("delete window.PushManager")
+    visit_settings
+
+    assert_text "This browser doesn’t support push notifications."
+    assert_selector "[data-notifications-target='help'][open]"
+    assert_no_button "Turn on notifications"
+    assert_empty @user.push_subscriptions
+  end
+
+  test "failed registration stays off and can be retried without duplicating the browser subscription" do
+    page.execute_script("pushTest.attributes.auth_key = ''")
+    visit_settings
+    click_on "Turn on notifications"
+
+    assert_text "Couldn’t update push notifications. Please try again."
+    assert_text "Push notifications are off for this device."
+    assert_button "Turn on notifications", disabled: false
+    assert_empty @user.push_subscriptions
+
+    page.execute_script("pushTest.attributes.auth_key = 'browser-auth'")
+    click_on "Turn on notifications"
+
+    assert_text "Push notifications are on for this device."
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal 1, page.evaluate_script("pushTest.subscribeCalls")
+  end
+
+  test "worker registration failures recover when returning to the tab" do
+    page.execute_script(<<~JS)
+      const register = navigator.serviceWorker.register.bind(navigator.serviceWorker)
+      pushTest.failRegistration = true
+      navigator.serviceWorker.register = (...args) => {
+        return pushTest.failRegistration ? Promise.reject(new Error("Registration unavailable")) : register(...args)
+      }
+    JS
+    visit_settings
+
+    assert_text "Couldn’t update push notifications. Please try again."
+    assert_button "Turn on notifications", disabled: true
+    assert_empty @user.push_subscriptions
+
+    page.execute_script("pushTest.failRegistration = false; window.dispatchEvent(new Event('focus'))")
+
+    assert_button "Turn on notifications", disabled: false
+    click_on "Turn on notifications"
+    assert_text "Push notifications are on for this device."
+  end
+
+  test "the service worker displays the tray payload" do
+    payload = JSON.parse(notifications(:logo_mentioned_david).push_payload)
+    result = run_service_worker(payload: payload)
+
+    assert_equal [ payload ], result["shown"]
+    assert result["offlineStarted"]
+  end
+
+  test "clicking a push opens the card including its account and comment anchor" do
+    payload = JSON.parse(notifications(:logo_mentioned_david).push_payload)
+    result = run_service_worker(payload: payload, click: true)
+
+    assert result["closed"]
+    assert_equal URI.join(page.current_url, payload.dig("data", "url")).to_s, result["opened"]
+    assert_equal({ "type" => "window", "includeUncontrolled" => true }, result["matchOptions"])
+  end
+
+  test "clicking a push focuses a window already showing that card" do
+    payload = JSON.parse(notifications(:logo_mentioned_david).push_payload)
+    result = run_service_worker(payload: payload, click: true, existing_window: true)
+
+    assert result["closed"]
+    assert result["focused"]
+    assert_nil result["opened"]
+  end
+
+  test "the service worker ignores empty pushes and external click destinations" do
+    assert_empty run_service_worker(payload: nil)["shown"]
+
+    result = run_service_worker(payload: { title: "A notification", data: { url: "https://other.example.com/" } }, click: true)
+
+    assert result["closed"]
+    assert_nil result["opened"]
+  end
+
+  private
+    def visit_settings
+      page.execute_script("Turbo.visit(arguments[0])", notifications_settings_path)
+      assert_selector "[data-controller='notifications']"
+    end
+
+    def stub_browser_push
+      result = page.evaluate_async_script(<<~JS, @attributes)
+        const attributes = arguments[0]
+        const done = arguments[arguments.length - 1]
+
+        ;(async () => {
+          window.pushTest = {
+            attributes, permission: "default", nextPermission: "granted", permissionRequests: 0,
+            subscribed: false, subscribeCalls: 0, unsubscribeCalls: 0
+          }
+
+          const subscription = {
+            endpoint: attributes.endpoint,
+            toJSON() {
+              return { endpoint: this.endpoint, keys: { p256dh: pushTest.attributes.p256dh_key, auth: pushTest.attributes.auth_key } }
+            },
+            async unsubscribe() { pushTest.unsubscribeCalls++; return true }
+          }
+          const registration = {
+            pushManager: {
+              async getSubscription() { return pushTest.subscribed ? subscription : null },
+              async subscribe(options) {
+                pushTest.subscribeCalls++
+                pushTest.subscribed = true
+                pushTest.options = { userVisibleOnly: options.userVisibleOnly, applicationServerKey: Array.from(options.applicationServerKey) }
+                return subscription
+              }
+            }
+          }
+          const ready = navigator.serviceWorker.ready.then(worker => {
+            Object.defineProperty(worker, "pushManager", { configurable: true, value: registration.pushManager })
+            return worker
+          })
+          Object.defineProperty(navigator.serviceWorker, "ready", { configurable: true, value: ready })
+          Object.defineProperty(window, "Notification", { configurable: true, value: {
+            get permission() { return pushTest.permission },
+            async requestPermission() {
+              pushTest.permissionRequests++
+              pushTest.requestedFromGesture = navigator.userActivation.isActive
+              pushTest.permission = pushTest.nextPermission
+              return pushTest.permission
+            }
+          } })
+          done(true)
+        })().catch(error => done(error.stack))
+      JS
+      assert_equal true, result
+    end
+
+    def run_service_worker(payload:, click: false, existing_window: false)
+      source = page.evaluate_async_script(<<~JS)
+        const done = arguments[arguments.length - 1]
+        fetch("/service-worker.js").then(response => response.text()).then(done)
+      JS
+      origin = page.evaluate_script("location.origin")
+      worker_window = open_new_window
+
+      # Workers have their own global context. Use a blank tab to avoid evaluating
+      # the worker inside the application's CSP-protected document.
+      result = within_window(worker_window) do
+        visit "about:blank"
+        page.evaluate_async_script(<<~JS, source, payload, click, existing_window, origin)
+          const [source, payload, click, existingWindow, origin, done] = arguments
+
+          ;(async () => {
+            const listeners = {}
+            const promises = []
+            const result = { shown: [] }
+            const self = {
+              location: { origin },
+              addEventListener(name, callback) { listeners[name] = callback },
+              registration: {
+                async showNotification(title, options) { result.shown.push({ title, ...options }) }
+              },
+              clients: {
+                async claim() {},
+                async matchAll(options) {
+                  result.matchOptions = options
+                  return existingWindow ? [{
+                    url: new URL(payload.data.url, origin).href,
+                    async focus() { result.focused = true }
+                  }] : []
+                },
+                async openWindow(url) { result.opened = url }
+              }
+            }
+            const offline = {
+              addRule() {},
+              handlers: { networkFirst() {}, cacheFirst() {} },
+              start() { result.offlineStarted = true }
+            }
+
+            new Function("self", "importScripts", "TurboOffline", source)(self, () => {}, offline)
+            listeners.push({ data: payload ? { json: () => payload } : null, waitUntil(promise) { promises.push(promise) } })
+            await Promise.all(promises)
+
+            if (click) {
+              listeners.notificationclick({
+                notification: { data: payload.data, close() { result.closed = true } },
+                waitUntil(promise) { promises.push(promise) }
+              })
+              await Promise.all(promises)
+            }
+
+            done(result)
+          })().catch(error => done({ failure: error.stack }))
+        JS
+      end
+
+      assert_nil result["failure"], result["failure"]
+      result
+    ensure
+      worker_window&.close
+    end
+end
