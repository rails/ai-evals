+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.subscribe_to_push(
+      endpoint: "https://push.example.com/phone", p256dh_key: "public-key", auth_key: "auth-key"
+    )
+  end
+
+  test "new tray notifications enqueue a push for each of the recipient's devices" do
+    desktop = @notification.user.subscribe_to_push(
+      endpoint: "https://push.example.com/desktop", p256dh_key: "desktop-key", auth_key: "desktop-auth"
+    )
+    users(:david).subscribe_to_push(endpoint: "https://push.example.com/david", p256dh_key: "david-key", auth_key: "david-auth")
+    notifications(:layout_commented_kevin).destroy!
+
+    notification = nil
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      notification = Notification.create!(user: @notification.user, source: events(:layout_commented), creator: users(:david))
+    end
+
+    [ @subscription, desktop ].each do |subscription|
+      assert_enqueued_with job: Notification::PushJob, args: [ notification, subscription, notification.push_payload ]
+    end
+  end
+
+  test "new activity on an existing tray notification enqueues another push" do
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "mentions also enqueue pushes" do
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      @notification.update!(source: mentions(:logo_card_david_mention_by_jz))
+    end
+  end
+
+  test "reading, marking unread, and touching notifications do not push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+      @notification.touch
+    end
+  end
+
+  test "rolled back notifications do not push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.transaction(requires_new: true) do
+        @notification.update!(source: events(:logo_published))
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "does not enqueue pushes without devices or VAPID configuration" do
+    PushSubscription.stubs(:configured?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.push_later
+    end
+
+    PushSubscription.stubs(:configured?).returns(true)
+    @subscription.destroy!
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.push_later
+    end
+  end
+
+  test "event payload uses the tray text and an account-scoped card link" do
+    payload = JSON.parse(@notification.push_payload)
+
+    assert_equal ApplicationController.helpers.event_notification_title(@notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(@notification.source), payload["body"]
+    assert_equal "#{@notification.account.slug}/cards/#{@notification.card.number}", payload.dig("data", "url")
+    assert_equal @notification.id, payload["tag"]
+    assert_equal "/app-icon-192.png", payload["icon"]
+    assert payload["renotify"]
+  end
+
+  test "comment payload uses plain-text tray excerpt and links to the comment on its card" do
+    notification = notifications(:layout_commented_kevin)
+    comment = notification.source.eventable
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal "RE: #{comment.card.title}", payload["title"]
+    assert_equal comment.body.to_plain_text.truncate(200), payload["body"]
+    assert_equal "#{notification.account.slug}/cards/#{comment.card.number}#comment_#{comment.id}", payload.dig("data", "url")
+  end
+
+  test "mention payload matches the tray for mentions in cards and comments" do
+    notification = notifications(:logo_mentioned_david)
+
+    [ mentions(:logo_card_david_mention_by_jz), mentions(:logo_comment_david_mention_by_jz) ].each do |mention|
+      notification.update!(source: mention)
+      payload = JSON.parse(notification.push_payload)
+
+      assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+      assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+      assert payload.dig("data", "url").start_with?("#{notification.account.slug}/cards/#{mention.card.number}")
+    end
+  end
+
+  test "untitled cards use the tray's card-number fallback" do
+    @notification.card.update_column(:title, "")
+
+    assert_equal "Card #{@notification.card.number}", JSON.parse(@notification.push_payload)["title"]
+  end
+
+  test "enqueued payload retains the activity's wording if the tray changes before delivery" do
+    @notification.push_later
+    original_payload = @notification.push_payload
+    @notification.card.update_column(:title, "A later title")
+
+    assert_enqueued_with job: Notification::PushJob, args: [ @notification, @subscription, original_payload ]
+    assert_not_equal JSON.parse(original_payload)["title"], JSON.parse(@notification.reload.push_payload)["title"]
+  end
+
+  test "delivers to the recipient's device" do
+    payload = @notification.push_payload
+    @subscription.expects(:push).with(payload)
+
+    @notification.push_to(@subscription, payload)
+  end
+
+  test "does not deliver read notifications" do
+    @notification.read
+    @subscription.expects(:push).never
+
+    @notification.push_to(@subscription, @notification.push_payload)
+  end
+
+  test "does not deliver after the recipient is deactivated" do
+    @notification.user.deactivate
+    @subscription.expects(:push).never
+
+    @notification.push_to(@subscription, @notification.push_payload)
+  end
+
+  test "does not deliver for an inactive account" do
+    @notification.account.stubs(:active?).returns(false)
+    @subscription.expects(:push).never
+
+    @notification.push_to(@subscription, @notification.push_payload)
+  end
+
+  test "does not deliver after access to the card is removed" do
+    @notification.user.accesses.where(board: @notification.card.board).delete_all
+    @subscription.expects(:push).never
+
+    @notification.push_to(@subscription, @notification.push_payload)
+  end
+
+  test "does not deliver to a different user's device" do
+    subscription = users(:david).subscribe_to_push(endpoint: "https://push.example.com/david", p256dh_key: "key", auth_key: "auth")
+    subscription.expects(:push).never
+
+    @notification.push_to(subscription, @notification.push_payload)
+  end
+end
