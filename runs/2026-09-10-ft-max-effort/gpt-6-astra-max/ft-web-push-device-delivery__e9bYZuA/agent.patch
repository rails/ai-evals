@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveSupport::TestCase
+  setup do
+    key = WebPush.generate_key
+    PushSubscription.stubs(:vapid).returns(public_key: key.public_key, private_key: key.private_key, subject: "https://example.com")
+
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.subscribe_to_push(
+      endpoint: "https://push.example.com/phone",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16))
+    )
+    @payload = @notification.push_payload
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "delivers in the notification's account context" do
+    PushSubscription.any_instance.expects(:push).with do |payload|
+      assert_equal @notification.account, Current.account
+      assert_equal @payload, payload
+      true
+    end
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      @notification.push_later
+    end
+  end
+
+  test "expired devices do not prevent delivery to other devices" do
+    desktop = @notification.user.subscribe_to_push(
+      endpoint: "https://push.example.com/desktop", p256dh_key: @subscription.p256dh_key, auth_key: @subscription.auth_key
+    )
+    expired = stub_request(:post, @subscription.endpoint).to_return(status: 410)
+    delivered = stub_request(:post, desktop.endpoint).to_return(status: 201)
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      @notification.push_later
+    end
+
+    assert_requested expired
+    assert_requested delivered
+    assert_not PushSubscription.exists?(@subscription.id)
+    assert PushSubscription.exists?(desktop.id)
+  end
+
+  test "temporary push-service failures retry only the affected device" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 503)
+
+    assert_enqueued_with job: Notification::PushJob, args: [ @notification, @subscription, @payload ] do
+      Notification::PushJob.perform_now(@notification, @subscription, @payload)
+    end
+
+    assert PushSubscription.exists?(@subscription.id)
+  end
+
+  test "connection timeouts are retried" do
+    PushSubscription.any_instance.stubs(:push).raises(Net::ReadTimeout)
+
+    assert_enqueued_with job: Notification::PushJob, args: [ @notification, @subscription, @payload ] do
+      Notification::PushJob.perform_now(@notification, @subscription, @payload)
+    end
+  end
+
+  test "deleted subscriptions are safely discarded" do
+    @notification.push_later
+    @subscription.destroy!
+    PushSubscription.any_instance.expects(:push).never
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Notification::PushJob
+    end
+  end
+
+  test "deleted notifications are safely discarded" do
+    @notification.push_later
+    @notification.destroy!
+    PushSubscription.any_instance.expects(:push).never
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Notification::PushJob
+    end
+  end
+end
