new file mode 100644
index 0000000..c62fbaa
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,28 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.register(subscription_params)
+
+    render json: { id: subscription.id }, status: :created, location: user_push_subscription_path(@user, subscription)
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..dca7510
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,137 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "error", "help" ]
+  static values = { url: String, publicKey: String, subscriptions: Object }
+
+  #registration
+  #subscription
+  #subscriptionId
+  #busy = false
+
+  async connect() {
+    this.buttonTarget.disabled = true
+
+    if (this.#supported) {
+      try {
+        // Use the same root-scoped worker as offline mode, including on account-prefixed pages.
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.#registration = await navigator.serviceWorker.ready
+        await this.refresh()
+      } catch {
+        this.#showError("Couldn’t check notification settings. Please reload and try again.")
+      }
+    } else {
+      this.#showError("This browser doesn’t support push notifications. See the help below.")
+      this.helpTarget.open = true
+    }
+  }
+
+  async refresh() {
+    if (this.#registration && !this.#busy) {
+      this.#busy = true
+      this.buttonTarget.disabled = true
+
+      try {
+        this.#subscription = await this.#registration.pushManager.getSubscription()
+        this.#subscriptionId = this.subscriptionsValue[this.#subscription?.endpoint]
+        this.errorTarget.hidden = true
+      } catch {
+        this.#showError("Couldn’t check notification settings. Please try again.")
+      } finally {
+        this.#busy = false
+        this.#render()
+      }
+    }
+  }
+
+  async toggle() {
+    if (this.#busy || this.buttonTarget.disabled) return
+
+    this.#busy = true
+    this.buttonTarget.disabled = true
+    this.errorTarget.hidden = true
+
+    try {
+      if (this.#enabled) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+    } catch {
+      this.#showError("Couldn’t update notifications. Please check your connection and try again.")
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async #enable() {
+    // Ask before any other asynchronous work so browsers recognize the user gesture.
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      this.#subscription = await this.#registration.pushManager.getSubscription() ||
+        await this.#registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+
+      const { endpoint, keys } = this.#subscription.toJSON()
+      const response = await post(this.urlValue, {
+        body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+        responseKind: "json"
+      })
+      if (!response.ok) throw new Error("Subscription registration failed")
+
+      const { id } = await response.json
+      this.#subscriptionId = id
+      this.subscriptionsValue = { ...this.subscriptionsValue, [endpoint]: id }
+      this.helpTarget.open = false
+    } else {
+      this.#showError("Notifications weren’t allowed. You can try again or follow the help below.")
+      this.helpTarget.open = true
+    }
+  }
+
+  async #disable() {
+    const response = await destroy(`${this.urlValue}/${this.#subscriptionId}`, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Subscription removal failed")
+
+    const subscriptions = { ...this.subscriptionsValue }
+    delete subscriptions[this.#subscription.endpoint]
+    this.subscriptionsValue = subscriptions
+    this.#subscriptionId = null
+
+    // Keep the browser subscription: another account may still use it on this device.
+  }
+
+  #render() {
+    this.element.classList.toggle("notifications--on", this.#enabled)
+    this.buttonTarget.textContent = this.#enabled ? "Turn off notifications" : "Turn on notifications"
+    this.buttonTarget.setAttribute("aria-pressed", String(this.#enabled))
+    this.buttonTarget.disabled = Notification.permission === "denied"
+
+    if (Notification.permission === "denied") this.helpTarget.open = true
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #enabled() {
+    return !!this.#subscriptionId && Notification.permission === "granted"
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push_subscription/delivery_job.rb b/app/jobs/push_subscription/delivery_job.rb
