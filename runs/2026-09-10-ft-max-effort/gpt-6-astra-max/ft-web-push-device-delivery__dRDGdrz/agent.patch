--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,257 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @original_configuration = Rails.configuration.x.web_push
+    @vapid_key = WebPush.generate_key
+    Rails.configuration.x.web_push = ActiveSupport::OrderedOptions.new.update(@vapid_key.to_h)
+    Rails.configuration.x.web_push.public_key = @vapid_key.public_key.delete("=")
+    @user = users(:kevin)
+    @endpoint = "https://fcm.googleapis.com/fcm/send/browser"
+    @keys = { p256dh: WebPush.generate_key.public_key, auth: WebPush.encode64(SecureRandom.random_bytes(16)) }
+  end
+
+  teardown do
+    Rails.configuration.x.web_push = @original_configuration
+  end
+
+  test "opt in and out on this device" do
+    visit_settings
+    mock_browser_push(permission: "default")
+
+    assert_text "Notifications are off for this device."
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+    assert_empty @user.push_subscriptions
+
+    click_button "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    subscription = @user.push_subscriptions.sole
+    assert_equal @endpoint, subscription.endpoint
+    assert_equal @keys[:p256dh], subscription.p256dh_key
+    assert_equal @keys[:auth], subscription.auth_key
+    assert_equal 1, page.evaluate_script("pushTest.permissionRequests")
+    assert_equal true, page.evaluate_script("pushTest.options.userVisibleOnly")
+    assert_equal Base64.urlsafe_decode64(@vapid_key.public_key).bytes, page.evaluate_script("Array.from(pushTest.options.applicationServerKey)")
+
+    click_button "Turn off notifications"
+
+    assert_text "Notifications are off for this device."
+    assert_empty @user.push_subscriptions.reload
+    assert_equal 0, page.evaluate_script("pushTest.unsubscriptions")
+  end
+
+  test "an existing permission and browser subscription do not opt in another account" do
+    visit_settings
+    mock_browser_push(permission: "granted", existing: true)
+
+    assert_text "Notifications are off for this device."
+    assert_empty @user.push_subscriptions
+
+    click_button "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    assert_equal 0, page.evaluate_script("pushTest.subscriptions")
+    assert_equal 1, @user.push_subscriptions.count
+  end
+
+  test "recognizes an already registered device without prompting again" do
+    @user.push_subscriptions.create!(endpoint: @endpoint, p256dh_key: @keys[:p256dh], auth_key: @keys[:auth])
+    visit_settings
+    mock_browser_push(permission: "granted", existing: true)
+
+    assert_text "Notifications are on for this device."
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+    assert_equal 1, @user.push_subscriptions.count
+  end
+
+  test "denied permissions show the supplied browser help" do
+    visit_settings
+    mock_browser_push(permission: "default", requested_permission: "denied")
+
+    click_button "Turn on notifications"
+
+    assert_text "Notifications weren’t allowed."
+    assert_selector "details[data-notifications-target='help'][open]"
+    assert_button "Turn on notifications", disabled: true
+    assert_empty @user.push_subscriptions
+    assert_equal 0, page.evaluate_script("pushTest.subscriptions")
+  end
+
+  test "dismissing the permission prompt leaves notifications off and allows another try" do
+    visit_settings
+    mock_browser_push(permission: "default", requested_permission: "default")
+
+    click_button "Turn on notifications"
+
+    assert_text "Notifications are off for this device."
+    assert_text "Notifications weren’t allowed."
+    assert_button "Turn on notifications", disabled: false
+    assert_empty @user.push_subscriptions
+  end
+
+  test "unsupported browsers show help without crashing" do
+    visit_settings
+    page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      delete window.PushManager
+      const controller = Stimulus.getControllerForElementAndIdentifier(document.querySelector('[data-controller="notifications"]'), "notifications")
+      controller.connect().then(done)
+    JS
+
+    assert_text "This browser doesn’t support push notifications."
+    assert_selector "details[data-notifications-target='help'][open]"
+    assert_button "Turn on notifications", disabled: true
+  end
+
+  test "failed registration is not shown as enabled and can be retried" do
+    visit_settings
+    mock_browser_push(permission: "granted")
+    page.execute_script <<~JS
+      window.originalFetch = window.fetch
+      window.fetch = (...args) => {
+        if (args[0].toString().includes("push_subscriptions")) {
+          return Promise.resolve(new Response("Unavailable", { status: 503 }))
+        }
+        return originalFetch(...args)
+      }
+    JS
+
+    click_button "Turn on notifications"
+
+    assert_text "Couldn’t update notifications."
+    assert_text "Notifications are off for this device."
+    assert_empty @user.push_subscriptions
+
+    page.execute_script "window.fetch = window.originalFetch"
+    click_button "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal 1, page.evaluate_script("pushTest.subscriptions")
+  end
+
+  test "service worker activates push support for existing offline installations" do
+    mock_service_worker
+    page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      workerTest.listeners.install({ waitUntil: (promise) => promise.then(done) })
+    JS
+
+    assert_equal true, page.evaluate_script("workerTest.skippedWaiting")
+  end
+
+  test "service worker displays the push and opens its account-scoped card" do
+    mock_service_worker
+    payload = JSON.parse(notifications(:layout_commented_kevin).push_payload)
+
+    page.evaluate_async_script <<~JS, payload
+      const [payload, done] = arguments
+      let pending
+      workerTest.listeners.push({ data: { json: () => payload }, waitUntil: (promise) => pending = promise })
+      Promise.resolve(pending).then(done)
+    JS
+
+    assert_equal payload["title"], page.evaluate_script("workerTest.shown[0].title")
+    assert_equal payload["body"], page.evaluate_script("workerTest.shown[0].options.body")
+
+    click_push(payload.dig("data", "url"))
+
+    assert_equal [ "https://fizzy.example#{payload.dig('data', 'url')}" ], page.evaluate_script("workerTest.opened")
+    assert_equal true, page.evaluate_script("workerTest.closed")
+  end
+
+  test "service worker focuses an existing card window" do
+    mock_service_worker
+    url = "https://fizzy.example/123/cards/45#comment_67"
+    page.execute_script <<~JS, url
+      workerTest.windows = [{ url: arguments[0], focus: async () => workerTest.focused = true }]
+    JS
+
+    click_push(url)
+
+    assert_equal true, page.evaluate_script("workerTest.focused")
+    assert_empty page.evaluate_script("workerTest.opened")
+  end
+
+  test "service worker ignores empty pushes and never opens a foreign origin" do
+    mock_service_worker
+    page.execute_script "workerTest.listeners.push({ data: null, waitUntil: () => {} })"
+
+    assert_empty page.evaluate_script("workerTest.shown")
+    click_push("https://evil.example/123/cards/45")
+    assert_empty page.evaluate_script("workerTest.opened")
+  end
+
+  private
+    def visit_settings
+      sign_in_as @user
+      visit notifications_settings_path
+      assert_selector "[data-controller='notifications']"
+    end
+
+    def mock_browser_push(permission:, existing: false, requested_permission: "granted")
+      page.evaluate_async_script <<~JS, permission, existing, requested_permission, @endpoint, @keys
+        const [permission, existing, requestedPermission, endpoint, keys, done] = arguments
+        window.pushTest = { permission, permissionRequests: 0, subscriptions: 0, unsubscriptions: 0 }
+        const subscription = {
+          endpoint,
+          toJSON: () => ({ endpoint, keys }),
+          unsubscribe: async () => { pushTest.unsubscriptions++; return true }
+        }
+        let currentSubscription = existing ? subscription : null
+        const registration = { pushManager: {
+          getSubscription: async () => currentSubscription,
+          subscribe: async (options) => {
+            pushTest.subscriptions++
+            pushTest.options = options
+            return currentSubscription = subscription
+          }
+        } }
+        Object.defineProperty(Notification, "permission", { configurable: true, get: () => pushTest.permission })
+        Notification.requestPermission = async () => {
+          pushTest.permissionRequests++
+          return pushTest.permission = requestedPermission
+        }
+        Object.defineProperty(navigator, "serviceWorker", { configurable: true, value: {
+          register: async () => registration,
+          ready: Promise.resolve(registration)
+        } })
+        const controller = Stimulus.getControllerForElementAndIdentifier(document.querySelector('[data-controller="notifications"]'), "notifications")
+        controller.connect().then(done)
+      JS
+    end
+
+    def mock_service_worker
+      worker_script = ApplicationController.renderer.render(template: "pwa/service_worker", formats: [ :js ], layout: false)
+      page.driver.browser.navigate.to("about:blank")
+      page.execute_script <<~JS, worker_script
+        window.workerTest = { listeners: {}, shown: [], opened: [], windows: [], focused: false, closed: false }
+        const worker = {
+          location: { origin: "https://fizzy.example" },
+          skipWaiting: async () => workerTest.skippedWaiting = true,
+          addEventListener: (name, handler) => workerTest.listeners[name] = handler,
+          registration: { showNotification: async (title, options) => workerTest.shown.push({ title, options }) },
+          clients: {
+            claim: async () => {},
+            matchAll: async () => workerTest.windows,
+            openWindow: async (url) => workerTest.opened.push(url)
+          }
+        }
+        const offline = { addRule: () => {}, start: () => {}, handlers: { networkFirst: () => {}, cacheFirst: () => {} } }
+        new Function("self", "TurboOffline", "importScripts", arguments[0])(worker, offline, () => {})
+      JS
+    end
+
+    def click_push(url)
+      page.evaluate_async_script <<~JS, url
+        const [url, done] = arguments
+        let pending
+        workerTest.listeners.notificationclick({
+          notification: { data: { url }, close: () => workerTest.closed = true },
+          waitUntil: (promise) => pending = promise
+        })
+        Promise.resolve(pending).then(done)
+      JS
+    end
+end
