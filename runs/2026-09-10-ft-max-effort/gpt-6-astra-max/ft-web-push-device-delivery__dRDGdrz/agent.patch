@@ -0,0 +1,12 @@
+class PushSubscription::DeliveryJob < ApplicationJob
+  queue_as :backend
+  self.log_arguments = false
+
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout,
+    SocketError, Errno::ECONNRESET, Errno::ECONNREFUSED, wait: :polynomially_longer, attempts: 5
+
+  def perform(subscription, notification, payload)
+    subscription.deliver_now(notification, payload)
+  end
+end
