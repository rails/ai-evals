diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..cfb6f82
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,29 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: :new_push_activity?
+  end
+
+  def push_later
+    if PushSubscription.configured?
+      subscriptions = user.push_subscriptions.to_a
+
+      if subscriptions.any?
+        # Snapshot the tray text before another event updates this card's notification.
+        payload = push_payload
+        subscriptions.each { |subscription| subscription.deliver_later(self, payload) }
+      end
+    end
+  end
+
+  def push_payload
+    ApplicationController.renderer.new(script_name: account.slug).render \
+      partial: "notifications/push", formats: [ :json ], locals: { notification: self }
+  end
+
+  private
+    def new_push_activity?
+      saved_change_to_source_id? || saved_change_to_source_type?
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..edf98ed
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,70 @@
+class PushSubscription < ApplicationRecord
+  # Only browser push services may be contacted, never arbitrary user-supplied hosts.
+  PUSH_SERVICE_HOSTS = %w[ fcm.googleapis.com android.googleapis.com web.push.apple.com ].freeze
+  PUSH_SERVICE_DOMAINS = %w[ push.services.mozilla.com notify.windows.com ].freeze
+
+  self.filter_attributes += [ :endpoint ]
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, presence: true, length: { maximum: 2048 }
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 255 }
+  validate :validate_endpoint
+
+  class << self
+    def configured?
+      Rails.configuration.x.web_push.public_key.present? && Rails.configuration.x.web_push.private_key.present?
+    end
+
+    def register(attributes)
+      attributes = attributes.to_h.with_indifferent_access
+
+      find_or_create_by!(endpoint_digest: Digest::SHA256.hexdigest(attributes[:endpoint].to_s)) do |subscription|
+        subscription.assign_attributes(attributes)
+      end.tap do |subscription|
+        subscription.update!(attributes) unless subscription.previously_new_record?
+      end
+    end
+  end
+
+  def deliver_later(notification, payload)
+    PushSubscription::DeliveryJob.perform_later(self, notification, payload)
+  end
+
+  def deliver_now(notification, payload)
+    if self.class.configured? && deliverable?(notification)
+      WebPush.payload_send \
+        endpoint: endpoint, p256dh: p256dh_key, auth: auth_key, message: payload,
+        vapid: Rails.configuration.x.web_push.to_h,
+        ttl: 1.day.to_i, open_timeout: 5, read_timeout: 5
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+
+  private
+    def deliverable?(notification)
+      user.active? && account.active? && notification.user_id == user_id && user.accessible_cards.exists?(notification.card_id)
+    end
+
+    def set_endpoint_digest
+      # Endpoints can be long and contain case-sensitive tokens, even on databases
+      # whose default collation is case-insensitive.
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      host = uri.host.to_s.downcase
+      push_service = PUSH_SERVICE_HOSTS.include?(host) || PUSH_SERVICE_DOMAINS.any? { |domain| host.end_with?(".#{domain}") }
+
+      unless uri.is_a?(URI::HTTPS) && uri.port == 443 && uri.userinfo.nil? && uri.fragment.nil? && push_service
+        errors.add :endpoint, "must be an HTTPS URL for a browser push service"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "is not a valid URL"
+    end
+end
