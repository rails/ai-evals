+  test "auto postpone all due uses inclusive cutoffs for every entropy period" do
+    freeze_time
+    Card.update_all(last_active_at: Time.current)
+
+    Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.each do |period|
+      entropies(:writebook_board).update!(auto_postpone_period: period)
+      cards(:logo).resume
+      cards(:logo).update!(last_active_at: Time.current - period)
+      cards(:layout).update!(last_active_at: Time.current - period + 1.second)
+
+      assert_difference -> { Card.postponed.count }, +1 do
+        Card.auto_postpone_all_due
+      end
+
+      assert cards(:logo).reload.postponed?
+      assert_not cards(:layout).reload.postponed?
+    end
+  end
