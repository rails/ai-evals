-        card.auto_postpone(user: card.account.system_user)
+      now = Time.now
+
+      # Resolve entropy per board so card selection can use an indexed activity cutoff.
+      Board.joins(:account).preload(:entropy, account: :entropy).find_in_batches do |boards|
+        system_users = {}
+
+        boards.group_by { |board| board.entropy&.auto_postpone_period }.each do |period, boards|
+          if period
+            active.where(board: boards, last_active_at: ..(now - period)).find_each do |card|
+              system_user = system_users[card.account_id] ||= card.account.system_user
+              card.auto_postpone(user: system_user)
+            end
+          end
+        end
       end
     end
   end
