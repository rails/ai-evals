+    entropies(:private_board).update!(auto_postpone_period: 7.days)
+    cards(:text).update_columns(board_id: boards(:private).id, last_active_at: 8.days.ago)
+    cards(:logo).update!(last_active_at: 45.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:text).reload.postponed?
+    assert_not cards(:logo).reload.postponed?
+  end
+
+  test "auto postpone all due uses each account default and system user without current context" do
+    entropies(:writebook_board, :miltons_wish_list_board).each(&:destroy!)
