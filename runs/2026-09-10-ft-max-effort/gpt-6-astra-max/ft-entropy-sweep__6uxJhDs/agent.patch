diff --git a/script/benchmark_entropy_sweep.rb b/script/benchmark_entropy_sweep.rb
new file mode 100644
index 0000000..0c03c23
--- /dev/null
+++ b/script/benchmark_entropy_sweep.rb
@@ -0,0 +1,128 @@
+# Run after RAILS_ENV=test bin/rails db:prepare:
+#   RAILS_ENV=test bin/rails runner script/benchmark_entropy_sweep.rb
+#   PROFILE=backlog RAILS_ENV=test bin/rails runner script/benchmark_entropy_sweep.rb
+# All synthetic data and temporary index changes are rolled back.
+require "benchmark"
+require "active_support/testing/time_helpers"
+
+abort "Use the SQLite test database" unless Rails.env.test? && Fizzy.db_adapter.sqlite?
+
+include ActiveSupport::Testing::TimeHelpers
+
+card_count = Integer(ENV.fetch("CARD_COUNT", 120_000))
+board_count = Integer(ENV.fetch("BOARD_COUNT", 100))
+account_count = Integer(ENV.fetch("ACCOUNT_COUNT", 4))
+profile = ENV.fetch("PROFILE", "sparse")
+abort "PROFILE must be sparse or backlog" unless profile.in?(%w[ sparse backlog ])
+abort "Counts must be positive" unless [ card_count, board_count, account_count ].all?(&:positive?)
+
+connection = Card.connection
+index_columns = [ :board_id, :status, :last_active_at ]
+uuid = -> { ActiveRecord::Type::Uuid.generate }
+selected_ids = []
+
+# Exercise the real sweep, but record selections instead of running callbacks.
+Card.define_method(:auto_postpone) do |user:|
+  raise "Wrong system user for #{id}" unless user.system? && user.account_id == account_id
+  selected_ids << id
+end
+
+begin
+  freeze_time do
+    ActiveRecord::Base.logger.silence do
+      Card.transaction do
+        accounts = account_count.times.map do |i|
+          { id: uuid.call, name: "Entropy benchmark #{i}", external_account_id: 9_000_000_000 + i }
+        end
+        Account.insert_all!(accounts)
+        users = accounts.map { |account| { id: uuid.call, account_id: account[:id], name: "System", role: "system" } }
+        User.insert_all!(users)
+        boards = board_count.times.map do |i|
+          user = users[i % account_count]
+          { id: uuid.call, account_id: user[:account_id], creator_id: user[:id], name: "Entropy benchmark #{i}" }
+        end
+        Board.insert_all!(boards)
+        entropies = accounts.map do |account|
+          { id: uuid.call, account_id: account[:id], container_id: account[:id], container_type: "Account", auto_postpone_period: 30.days.to_i }
+        end
+        boards.each_with_index do |board, i|
+          if i.even?
+            entropies << { id: uuid.call, account_id: board[:account_id], container_id: board[:id], container_type: "Board", auto_postpone_period: 90.days.to_i }
+          end
+        end
+        Entropy.insert_all!(entropies)
+
+        puts "Seeding #{card_count} cards across #{board_count} boards and #{account_count} accounts (#{profile})..."
+        card_count.times.each_slice(1000) do |numbers|
+          cards = numbers.map do |i|
+            board = boards[i % board_count]
+            distribution = i / board_count % 10
+            age = if i % 997 == 0
+              400.days
+            elsif profile == "backlog"
+              [ 400.days, 400.days, 400.days, 400.days, 400.days, 400.days, 45.days, 45.days, 1.day, 1.day ][distribution]
+            else
+              1.day
+            end
+            { id: uuid.call, account_id: board[:account_id], board_id: board[:id], creator_id: board[:creator_id], number: i + 1,
+              title: "Entropy benchmark #{i}", status: distribution == 5 ? "drafted" : "published", last_active_at: Time.current - age }
+          end
+          Card.insert_all!(cards)
+          closed = cards.each_with_index.filter_map do |card, i|
+            if numbers[i] / board_count % 10 <= 2 && numbers[i] % 997 != 0
+              { id: uuid.call, card_id: card[:id], account_id: card[:account_id] }
+            end
+          end
+          postponed = cards.each_with_index.filter_map do |card, i|
+            if (numbers[i] / board_count % 10).in?([ 3, 4 ]) && numbers[i] % 997 != 0
+              { id: uuid.call, card_id: card[:id], account_id: card[:account_id] }
+            end
+          end
+          Closure.insert_all!(closed) if closed.any?
+          Card::NotNow.insert_all!(postponed) if postponed.any?
+        end
+
+        measure = ->(label, &sweep) do
+          selected_ids.clear
+          selection_time = 0.0
+          query_count = 0
+          first_selection = nil
+          subscriber = ->(event) do
+            query_count += 1
+            if event.payload[:sql].match?(/\ASELECT "cards"\.\* FROM "cards"/)
+              selection_time += event.duration / 1000
+              first_selection ||= event.payload
+            end
+          end
+          duration = Benchmark.realtime do
+            ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+              Card.uncached { sweep.call }
+            end
+          end
+          puts "%s: %.3fs total, %.3fs selecting cards, %d queries, %d candidates" % [ label, duration, selection_time, query_count, selected_ids.size ]
+          if first_selection
+            plan = connection.exec_query("EXPLAIN QUERY PLAN #{first_selection[:sql]}", "Entropy query plan", first_selection[:binds])
+            puts plan.map { |row| "  #{row['detail']}" }
+          end
+          selected_ids.sort
+        end
+
+        connection.remove_index :cards, index_columns, if_exists: true
+        connection.execute("ANALYZE")
+        expected = measure.call("Original joined sweep") do
+          Card.due_to_be_postponed.find_each { |card| card.auto_postpone(user: card.account.system_user) }
+        end
+
+        connection.add_index :cards, index_columns
+        connection.execute("ANALYZE cards")
+        actual = measure.call("Indexed board-batched sweep") { Card.auto_postpone_all_due }
+        raise "Eligibility changed" unless actual == expected
+        raise "Duplicate selections" unless actual.uniq.size == actual.size
+        puts "Identical eligible cards; rolling back benchmark data."
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+ensure
+  Card.remove_method(:auto_postpone)
+end
