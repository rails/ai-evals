diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..c9bf4f7 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,69 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    transaction do
+      # Take the same account lock as reactivation, then recheck eligibility.
+      # Another run may already have incinerated the account since selection.
+      if self.class.lock.exists?(id: id) && self.class.due_for_incineration.lock.exists?(id: id)
+        self.class.with_connection do |connection|
+          incinerate_filter_resources(connection)
+          incinerate_storage_totals
+          incinerate_search_index
+          incinerate_account_records(connection)
+          delete
+        end
+      end
+    end
+  end
+
+  private
+    def incinerate_filter_resources(connection)
+      filter_ids = Filter.where(account_id: id).select(:id).to_sql
+
+      tables_with_column(connection, "filter_id").each do |table|
+        connection.delete "DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{filter_ids})"
+      end
+    end
+
+    def incinerate_storage_totals
+      Storage::Total.where(owner: self)
+        .or(Storage::Total.where(owner_type: "Board", owner_id: boards.select(:id)))
+        .delete_all
+    end
+
+    def incinerate_search_index
+      if Fizzy.db_adapter.sqlite?
+        Search::Record::SQLite::Fts.where(rowid: Search::Record.for(id).where(account_id: id).select(:id)).delete_all
+      end
+    end
+
+    def incinerate_account_records(connection)
+      # Remaining account-owned tables carry account_id, including framework and SaaS
+      # tables. Delete directly to avoid callbacks that recreate data or enqueue
+      # activity jobs for an account that is going away.
+      account_id = connection.quote(id_for_database)
+
+      tables_with_column(connection, "account_id").each do |table|
+        connection.delete "DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{account_id}"
+      end
+    end
+
+    def tables_with_column(connection, column)
+      connection.tables.select { |table| connection.schema_cache.columns_hash(table).key?(column) }
+    end
 end
