index 0000000..b9a3f4f
--- /dev/null
+++ b/test/models/webhook/delivering_test.rb
@@ -0,0 +1,212 @@
+require "test_helper"
+
+class Webhook::DeliveringTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    WebMock.disable_net_connect!
+  end
+
+  teardown do
+    WebMock.allow_net_connect!
+  end
+
+  test "successful HTTP responses complete a delivery" do
+    receiver = stub_request(:post, @webhook.url).to_return(status: 201)
+
+    @delivery.deliver_now
+
+    assert_requested receiver, times: 1
+    assert_predicate @delivery.reload, :completed?
+    assert_predicate @delivery, :succeeded?
+    assert_equal 201, @delivery.response[:code]
+    assert_not_empty @delivery.request[:headers]
+  end
+
+  test "HTTP failures are logged and are not retried or counted twice" do
+    receiver = stub_request(:post, @webhook.url).to_return(status: 503)
+
+    2.times { Webhook::Delivery.find(@delivery.id).deliver_now }
+
+    assert_requested receiver, times: 1
+    assert_predicate @delivery.reload, :completed?
+    assert_predicate @delivery, :failed?
+    assert_equal 503, @delivery.response[:code]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "connection failures are logged and are not retried" do
+    receiver = stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    2.times { Webhook::Delivery.find(@delivery.id).deliver_now }
+
+    assert_requested receiver, times: 1
+    assert_predicate @delivery.reload, :errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "an overlapping job cannot claim an in-progress delivery" do
+    receiver = stub_request(:post, @webhook.url).to_return do
+      assert_predicate Webhook::Delivery.find(@delivery.id), :in_progress?
+      Webhook::Delivery.find(@delivery.id).deliver_now
+      { status: 200 }
+    end
+
+    @delivery.deliver_now
+
+    assert_requested receiver, times: 1
+    assert_predicate @delivery.reload, :succeeded?
+  end
+
+  test "completed errored and interrupted deliveries are not sent again" do
+    %i[ successfully_completed unsuccessfully_completed errored in_progress ].each do |fixture|
+      delivery = webhook_deliveries(fixture)
+      assert_no_changes -> { delivery.reload.attributes } do
+        delivery.deliver_now
+      end
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "inactive receivers skip queued deliveries without extending the failure streak" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+
+    @delivery.deliver_now
+
+    assert_not_requested :post, @webhook.url
+    assert_predicate @delivery.reload, :errored?
+    assert_equal "webhook_inactive", @delivery.response[:error]
+    assert_equal 10, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "moving the card to another board skips queued deliveries" do
+    Current.with(user: users(:david)) { @delivery.event.card.move_to(boards(:private)) }
+
+    @delivery.deliver_now
+
+    assert_not_requested :post, @webhook.url
+    assert_predicate @delivery.reload, :errored?
+    assert_equal "board_changed", @delivery.response[:error]
+    assert_nil @webhook.reload.delinquency_tracker
+  end
+
+  test "the tenth failure spanning an hour disables the webhook and stops queued posts" do
+    freeze_time do
+      @webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 1.hour.ago)
+      next_delivery = @webhook.deliver_later(events(:layout_assignment_jz))
+      receiver = stub_request(:post, @webhook.url).to_return(status: 500)
+
+      @delivery.deliver_now
+      next_delivery.deliver_now
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+      assert_equal "webhook_inactive", next_delivery.reload.response[:error]
+      assert_requested receiver, times: 1
+    end
+  end
+
+  test "a success resets consecutive failures" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_predicate @webhook.reload, :active?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "a burst of ten failures does not disable a webhook before an hour" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 30.minutes.ago)
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    @delivery.deliver_now
+
+    assert_predicate @webhook.reload, :active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "database prevents duplicate deliveries for the same webhook and event" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      @webhook.deliveries.create!(event: @delivery.event)
+    end
+  end
+
+  test "missing HTTP status is not successful" do
+    @delivery.update!(state: :completed, response: {})
+    assert_not @delivery.succeeded?
+    assert_predicate @delivery, :failed?
+  end
+
+  test "cleanup deletes only deliveries older than a week and preserves failure tracking" do
+    freeze_time do
+      @delivery.update_columns(created_at: 1.week.ago - 1.second)
+      boundary = webhook_deliveries(:successfully_completed)
+      boundary.update_columns(created_at: 1.week.ago)
+      recent = webhook_deliveries(:errored)
+      recent.update_columns(created_at: 1.week.ago + 1.second)
+      tracker = @webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 2.weeks.ago)
+
+      assert_difference "Webhook::Delivery.count", -1 do
+        Webhook::Delivery.cleanup
+      end
+
+      assert_not Webhook::Delivery.exists?(@delivery.id)
+      assert Webhook::Delivery.exists?(boundary.id)
+      assert Webhook::Delivery.exists?(recent.id)
+      assert_equal 9, tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "concurrent workers send only one POST" do
+    receiver = stub_request(:post, @webhook.url).to_return(status: 200)
+    ready = Queue.new
+    start = Queue.new
+    delivery_id = @delivery.id
+
+    workers = 5.times.map do
+      Thread.new do
+        ready << true
+        start.pop
+        ActiveRecord::Base.connection_pool.with_connection do
+          Webhook::Delivery.find(delivery_id).deliver_now
+        end
+      end
+    end
+
+    5.times { ready.pop }
+    5.times { start << true }
+    workers.each(&:value)
+
+    assert_requested receiver, times: 1
+    assert_predicate @delivery.reload, :succeeded?
+  end
+
+  test "timeouts are logged as failures" do
+    receiver = stub_request(:post, @webhook.url).to_timeout
+
+    @delivery.deliver_now
+
+    assert_requested receiver, times: 1
+    assert_predicate @delivery.reload, :errored?
+    assert_equal "timeout", @delivery.response[:error]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "unexpected errors are logged without making the delivery retryable" do
+    Webhook::Request.any_instance.expects(:perform).once.raises(RuntimeError, "Unexpected error")
+
+    assert_raises RuntimeError do
+      @delivery.deliver_now
+    end
+    @delivery.reload.deliver_now
+
+    assert_predicate @delivery.reload, :errored?
+    assert_equal "delivery_error", @delivery.response[:error]
+  end
+end
