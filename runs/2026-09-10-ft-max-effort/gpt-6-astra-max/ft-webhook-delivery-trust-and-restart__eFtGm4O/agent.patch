+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_assignment_jz)
+  end
+
+  test "JSON describes the event and uses account-prefixed URLs" do
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_equal @event.id, payload["id"]
+    assert_equal "card_assigned", payload["action"]
+    assert_equal @event.created_at.utc.iso8601(3), payload["created_at"]
+    assert_equal [ users(:jz).id ], payload.dig("particulars", "assignee_ids")
+    assert_equal @event.creator.id, payload.dig("creator", "id")
+    assert_equal @event.board.id, payload.dig("board", "id")
+    assert_equal @event.card.id, payload.dig("eventable", "id")
+    assert_equal "http://example.com#{@event.account.slug}/cards/#{@event.card.number}", payload.dig("eventable", "url")
+  end
+
+  test "JSON uses the configured host scheme and port independent of Current.account" do
+    Rails.application.routes.stubs(:default_url_options).returns(host: "fizzy.example.com", protocol: "https", port: 3443)
+
+    payload = Current.with_account(accounts(:initech)) do
+      JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+    end
+
+    assert_equal "https://fizzy.example.com:3443#{@event.account.slug}/cards/#{@event.card.number}", payload.dig("eventable", "url")
+    assert_equal accounts("37s"), Current.account
+  end
+
+  test "comment events include the comment body and its card" do
+    event = events(:layout_commented)
+    payload = JSON.parse(Webhook::Payload.new(@webhook, event).to_json)
+
+    assert_equal "comment_created", payload["action"]
+    assert_equal event.eventable.id, payload.dig("eventable", "id")
+    assert_equal event.eventable.body.to_plain_text, payload.dig("eventable", "body", "plain_text")
+    assert_equal event.card.id, payload.dig("eventable", "card", "id")
+  end
+
+  test "Slack receives a text message" do
+    @webhook.url = "https://hooks.slack.com/services/T123/B456/test-token" # gitleaks:allow
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_equal [ "text" ], payload.keys
+    assert_includes payload["text"], @event.description_for(nil).to_plain_text
+    assert_includes payload["text"], "#{@event.account.slug}/cards/#{@event.card.number}"
+  end
+
+  test "Campfire receives an HTML body without personalizing it to Current.user" do
