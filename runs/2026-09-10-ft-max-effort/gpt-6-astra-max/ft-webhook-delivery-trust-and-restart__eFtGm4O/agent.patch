+module Event::Webhookable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :dispatch_webhooks
+  end
+
+  def dispatch_webhooks
+    transaction do
+      # Keep this marker after delivery logs expire so an old event cannot be dispatched again.
+      if self.class.where(id: id, webhooks_dispatched_at: nil).update_all(webhooks_dispatched_at: Time.current) == 1
+        board.webhooks.active.subscribed_to(action).find_each do |webhook|
+          webhook.deliver_later(self)
+        end
+      end
+    end
+  end
+end
