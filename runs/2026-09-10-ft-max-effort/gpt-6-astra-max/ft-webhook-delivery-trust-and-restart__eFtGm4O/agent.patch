diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..44c6f7d
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,44 @@
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def to_json
+    if webhook.for_slack?
+      { text: plain_text }.to_json
+    elsif webhook.for_campfire?
+      { body: render(:html) }.to_json
+    elsif webhook.for_basecamp?
+      { content: render(:html) }.to_json
+    else
+      render(:json)
+    end
+  end
+
+  private
+    def plain_text
+      "#{event.description_for(nil).to_plain_text}\n#{Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)}"
+    end
+
+    def render(format)
+      base_uri = URI.parse(Rails.application.routes.url_helpers.root_url(**url_options))
+      http_host = base_uri.host
+      http_host += ":#{base_uri.port}" if base_uri.port != base_uri.default_port
+
+      Current.with(account: event.account, user: nil) do
+        ApplicationController.renderer.new(
+          http_host: http_host,
+          https: base_uri.scheme == "https",
+          script_name: event.account.slug
+        ).render(template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event })
+      end
+    end
+
+    def url_options
+      @url_options ||= (Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}).merge(script_name: event.account.slug)
+    end
+end
diff --git a/app/models/webhook/request.rb b/app/models/webhook/request.rb
new file mode 100644
index 0000000..5b19bc7
--- /dev/null
+++ b/app/models/webhook/request.rb
@@ -0,0 +1,76 @@
+require "net/http"
+
+class Webhook::Request
+  REQUEST_TIMEOUT = 15
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "Content-Type" => "application/json",
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "X-Webhook-Id" => delivery.id,
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def body
+    @body ||= Webhook::Payload.new(webhook, event).to_json
+  end
+
+  def perform
+    if ip = public_ip
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      Timeout.timeout(REQUEST_TIMEOUT) do
+        connection(ip).request(request) do |response|
+          # Receiver-controlled bodies are neither retained nor buffered in memory.
+          response.read_body { |_chunk| }
+          return { code: response.code.to_i }
+        end
+      end
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError, Resolv::ResolvError
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def public_ip
+      ip = IPAddr.new(uri.hostname)
+      ip.to_s unless SsrfProtection.blocked_address?(ip)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(uri.hostname)
+    end
+
+    def connection(ip)
+      # Pin the validated address while retaining the hostname for Host, TLS/SNI and certificate verification.
+      # Do not use an environment proxy, which could bypass the validated address.
+      Net::HTTP.new(uri.hostname, uri.port, nil).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = WRITE_TIMEOUT
+        http.max_retries = 0
+      end
+    end
+end
