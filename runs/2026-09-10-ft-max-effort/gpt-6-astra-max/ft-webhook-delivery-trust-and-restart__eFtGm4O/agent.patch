index 0000000..d9929b9
--- /dev/null
+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "a board event posts once and records the outcome" do
+    webhook = webhooks(:active)
+    stub_dns_resolution("93.184.216.34")
+    receiver = stub_request(:post, webhook.url).to_return(status: 204)
+
+    event = nil
+    assert_difference -> { webhook.deliveries.count }, +1 do
+      event = cards(:logo).track_event(:closed, creator: users(:david))
+    end
+
+    delivery = webhook.deliveries.find_by!(event: event)
+    assert_predicate delivery, :pending?
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    Webhook::DeliveryJob.perform_now(delivery.reload)
+    event.dispatch_webhooks
+
+    assert_requested receiver, times: 1
+    assert_predicate delivery.reload, :succeeded?
+    assert_equal 204, delivery.response[:code]
+    assert_equal 1, webhook.deliveries.where(event: event).count
+  end
+
+  test "only active subscriptions on the event board are dispatched" do
+    board = boards(:writebook)
+    subscribed = board.webhooks.create!(name: "Second receiver", url: "https://second.example.com/webhooks", subscribed_actions: [ "card_closed" ])
+    board.webhooks.create!(name: "Inactive", url: "https://inactive.example.com/webhooks", subscribed_actions: [ "card_closed" ], active: false)
+    board.webhooks.create!(name: "Unsubscribed", url: "https://unsubscribed.example.com/webhooks", subscribed_actions: [ "card_reopened" ])
+    boards(:private).webhooks.create!(name: "Other board", url: "https://private.example.com/webhooks", subscribed_actions: [ "card_closed" ])
+    boards(:miltons_wish_list).webhooks.create!(name: "Other account", url: "https://other.example.com/webhooks", subscribed_actions: [ "card_closed" ])
+
+    event = nil
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      assert_difference "Webhook::Delivery.count", +2 do
+        event = cards(:logo).track_event(:closed, creator: users(:david))
+      end
+    end
+
+    assert_equal [ webhooks(:active).id, subscribed.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+  end
+
+  test "unsubscribed events do not create deliveries" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        cards(:logo).track_event(:reopened, creator: users(:david))
+      end
+    end
+  end
+
+  test "rolled back events neither leave deliveries nor enqueue jobs" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference [ "Event.count", "Webhook::Delivery.count" ] do
+        Event.transaction(requires_new: true) do
+          cards(:logo).track_event(:closed, creator: users(:david))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "dispatch remains idempotent after delivery logs expire" do
+    freeze_time do
+      event = cards(:logo).track_event(:closed, creator: users(:david))
+      delivery = event.webhook_deliveries.sole
+      assert_not_nil event.reload.webhooks_dispatched_at
+
+      travel 1.week + 1.second
+      Webhook::Delivery.cleanup
+      assert_not Webhook::Delivery.exists?(delivery.id)
+
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        assert_no_difference "Webhook::Delivery.count" do
+          event.dispatch_webhooks
+        end
+      end
+    end
+  end
+
+  test "delivery jobs carry the event account even without a current account" do
+    stub_dns_resolution("93.184.216.34")
+    receiver = stub_request(:post, webhooks(:active).url).to_return do
+      assert_equal accounts("37s"), Current.account
+      { status: 200 }
+    end
+
+    event = Current.without_account do
+      cards(:logo).track_event(:closed, creator: users(:david))
+    end
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested receiver, times: 1
+    assert_equal accounts("37s"), event.webhook_deliveries.sole.account
+    assert_predicate event.webhook_deliveries.sole, :succeeded?
+  end
+end
