+    assert_includes payload["body"], "href=\"http://example.com#{@event.account.slug}/cards/#{@event.card.number}\""
+  end
+
+  test "Basecamp receives HTML content" do
+    @webhook.url = "https://3.basecamp.com/123/integrations/test-token/buckets/456/chats/789/lines" # gitleaks:allow
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_equal [ "content" ], payload.keys
+    assert_includes payload["content"], @event.description_for(nil).to_plain_text
+    assert_includes payload["content"], "#{@event.account.slug}/cards/#{@event.card.number}"
+  end
+end
diff --git a/test/models/webhook/request_test.rb b/test/models/webhook/request_test.rb
new file mode 100644
index 0000000..a46eaa3
--- /dev/null
+++ b/test/models/webhook/request_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Webhook::RequestTest < ActiveSupport::TestCase
+  setup do
+    @delivery = webhook_deliveries(:pending)
+    @webhook = @delivery.webhook
+    @request = Webhook::Request.new(@delivery)
+    stub_dns_resolution("93.184.216.34")
+    WebMock.disable_net_connect!
+  end
+
+  teardown do
+    WebMock.allow_net_connect!
+  end
+
+  test "posts signed JSON to the validated IP with a stable delivery identifier" do
+    receiver = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34") do |request|
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal @delivery.id, request.headers["X-Webhook-Id"]
+      assert_equal @delivery.event.created_at.utc.iso8601(3), request.headers["X-Webhook-Timestamp"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+      assert_equal @delivery.event.id, JSON.parse(request.body)["id"]
+      true
+    end.to_return(status: 204, body: "not retained")
+
+    assert_equal({ code: 204 }, @request.perform)
+    assert_requested receiver, times: 1
+  end
+
+  test "does not follow redirects" do
+    receiver = stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/secret" })
+
+    assert_equal({ code: 302 }, @request.perform)
+    assert_requested receiver, times: 1
+    assert_not_requested :any, "http://127.0.0.1/secret"
+  end
+
+  test "connection uses bounded timeouts without proxies or automatic retries" do
+    connection = Net::HTTP.new("api.example.com", 443, nil)
+    Net::HTTP.expects(:new).with("api.example.com", 443, nil).returns(connection)
+    receiver = stub_request(:post, @webhook.url).to_timeout
+
+    assert_equal({ error: "timeout" }, @request.perform)
+    assert_requested receiver, times: 1
+    assert_equal 0, connection.max_retries
+    assert_equal Webhook::Request::OPEN_TIMEOUT, connection.open_timeout
+    assert_equal Webhook::Request::READ_TIMEOUT, connection.read_timeout
+    assert_equal Webhook::Request::WRITE_TIMEOUT, connection.write_timeout
+    assert_predicate connection, :use_ssl?
+  end
+
+  test "DNS failures are reported without attempting a POST" do
+    Resolv::DNS.stubs(:open).raises(Resolv::ResolvError)
+
+    assert_equal({ error: "destination_unreachable" }, @request.perform)
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "private DNS resolutions are blocked" do
+    %w[ 127.0.0.1 10.0.0.1 169.254.169.254 ::1 fd00:ec2::254 ].each do |ip|
+      stub_dns_resolution(ip)
+      assert_equal({ error: "destination_unreachable" }, @request.perform)
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "literal private IP addresses are blocked without DNS" do
+    SsrfProtection.expects(:resolve_public_ip).never
+
+    [ "http://127.0.0.1/webhook", "http://[::1]/webhook" ].each do |url|
+      @webhook.update!(url: url)
+      assert_equal({ error: "destination_unreachable" }, Webhook::Request.new(@delivery).perform)
+      assert_not_requested :post, url
+    end
+  end
+
+  test "public literal IP URLs retain the port and query string" do
+    @webhook.update!(url: "http://93.184.216.34:8080/webhook?token=value")
+    SsrfProtection.expects(:resolve_public_ip).never
+    receiver = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 202)
+
+    assert_equal({ code: 202 }, @request.perform)
+    assert_requested receiver, times: 1
+  end
+
+  test "network and TLS errors are reported" do
+    [ SocketError, EOFError, Errno::ECONNRESET, OpenSSL::SSL::SSLError, Net::HTTPBadResponse ].each do |error|
+      receiver = stub_request(:post, @webhook.url).to_raise(error)
+      assert_equal({ error: "destination_unreachable" }, @request.perform)
+      remove_request_stub(receiver)
+    end
+  end
+
+  test "an overall deadline also bounds continuously streaming responses" do
+    Timeout.expects(:timeout).with(Webhook::Request::REQUEST_TIMEOUT).raises(Timeout::Error)
+
+    assert_equal({ error: "timeout" }, @request.perform)
+  end
+end
