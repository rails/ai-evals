+require "test_helper"
+
+class Account::DataTransfer::EventRecordSetTest < ActiveSupport::TestCase
+  test "imports events from older archives without dispatching webhooks" do
+    event = events(:layout_assignment_jz)
+    data = event.attributes.except("webhooks_dispatched_at")
+    event.destroy!
+    record_set = Account::DataTransfer::EventRecordSet.new(accounts("37s"))
+
+    with_archive(data) do |reader|
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        assert_no_difference "Webhook::Delivery.count" do
+          record_set.import(from: reader)
+          Event.find(data["id"]).dispatch_webhooks
+        end
+      end
+    end
+
+    assert_not_nil Event.find(data["id"]).webhooks_dispatched_at
+  end
+
+  test "accepts missing dispatch markers while retaining integrity checks" do
+    record_set = Account::DataTransfer::EventRecordSet.new(accounts("37s"))
+    record_set.importable_model_names = %w[ Card Board Event ]
+    data = events(:layout_assignment_jz).attributes.except("webhooks_dispatched_at").merge(
+      "id" => "new_event_id",
+      "account_id" => "old_account_id",
+      "board_id" => "old_board_id",
+      "creator_id" => "old_creator_id",
+      "eventable_id" => "old_card_id"
+    )
+
+    with_archive(data) do |reader|
+      assert_nothing_raised { record_set.check(from: reader) }
+    end
+
+    with_archive(data.except("action")) do |reader|
+      assert_raises Account::DataTransfer::RecordSet::IntegrityError do
+        record_set.check(from: reader)
+      end
+    end
+  end
+
+  private
+    def with_archive(data)
+      Tempfile.create([ "events", ".zip" ]) do |file|
+        file.binmode
+        writer = ZipFile::Writer.new(file)
+        writer.add_file("data/events/#{data['id']}.json", data.to_json)
+        writer.close
+        file.rewind
+        yield ZipFile::Reader.new(file)
+      end
+    end
+end
