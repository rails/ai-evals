@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @tracker = webhooks(:active).create_delinquency_tracker!
+  end
+
+  test "records consecutive failures from the first failure" do
+    freeze_time do
+      @tracker.record_failure
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+      assert_equal accounts("37s"), @tracker.account
+
+      travel 20.minutes
+      @tracker.record_failure
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal 20.minutes.ago, @tracker.first_failure_at
+    end
+  end
+
+  test "requires both ten failures and at least one hour" do
+    freeze_time do
+      @tracker.update!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+      assert_not @tracker.delinquent?, "Nine failures are not enough, regardless of duration"
+
+      @tracker.update!(consecutive_failures_count: 10, first_failure_at: 1.hour.ago + 1.second)
+      assert_not @tracker.delinquent?, "A short burst must not disable a webhook"
+
+      travel 1.second
+      assert_predicate @tracker, :delinquent?
+
+      @tracker.update!(consecutive_failures_count: 11, first_failure_at: 2.hours.ago)
+      assert_predicate @tracker, :delinquent?
+    end
+  end
+
+  test "reset starts a fresh failure streak" do
+    freeze_time do
+      @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+      @tracker.reset
+
+      assert_equal 0, @tracker.consecutive_failures_count
+      assert_nil @tracker.first_failure_at
+      assert_not @tracker.delinquent?
+
+      @tracker.record_failure
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+  end
+end
diff --git a/test/models/webhook/delivering_test.rb b/test/models/webhook/delivering_test.rb
