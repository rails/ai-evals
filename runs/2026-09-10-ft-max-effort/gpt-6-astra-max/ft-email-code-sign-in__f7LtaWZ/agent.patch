+        post join_path(code: @join_code.code), params: { email_address: identity.email_address }
+      end
+    end
+
+    untenanted do
+      assert_difference -> { @join_code.reload.usage_count }, 1 do
+        assert_difference -> { User.count }, 1 do
+          post session_magic_link_path, params: { code: identity.magic_links.last.code }
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+  end
+
+  test "signs in an existing member without using another join" do
+    identity = identities(:jz)
+
+    post join_path(code: @join_code.code), params: { email_address: identity.email_address }
+
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { User.count }, -> { @join_code.reload.usage_count } ] do
+        post session_magic_link_path, params: { code: identity.magic_links.last.code }
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+  end
+
+  test "joins via JSON when signups are disabled" do
+    with_multi_tenant_mode(false) do
+      assert_enqueued_emails 1 do
+        post join_path(code: @join_code.code), params: { email_address: "newmember@example.com" }, as: :json
+      end
+
+      assert_response :created
+      assert_equal cookies[:pending_authentication_token], response.parsed_body["pending_authentication_token"]
+
+      identity = Identity.find_by!(email_address: "newmember@example.com")
+      untenanted do
+        post session_magic_link_path, params: { code: identity.magic_links.last.code }, as: :json
+      end
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+      assert identity.users.exists?(account: @account)
+    end
+  end
+
+  test "does not join when the join code is exhausted while waiting for email" do
+    post join_path(code: @join_code.code), params: { email_address: "newmember@example.com" }
+    magic_link = Identity.find_by!(email_address: "newmember@example.com").magic_links.last
+    @join_code.update!(usage_count: @join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { Session.count }, -> { @join_code.reload.usage_count } ] do
+        post session_magic_link_path, params: { code: magic_link.code }
+      end
+    end
+
+    assert_response :gone
+    assert_in_body "That code is all used up"
+    assert cookies[:session_token].blank?
+    assert cookies[:pending_authentication_token].blank?
+  end
+
+  test "does not join when the join code is rotated while waiting for email" do
+    post join_path(code: @join_code.code), params: { email_address: "newmember@example.com" }
