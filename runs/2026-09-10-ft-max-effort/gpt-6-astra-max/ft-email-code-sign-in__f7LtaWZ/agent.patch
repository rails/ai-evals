diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..c7b5749
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,24 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  attribute :code, :string, default: -> { SecureRandom.base36(CODE_LENGTH).upcase }
+  attribute :expires_at, :datetime, default: -> { EXPIRATION_TIME.from_now }
+
+  normalizes :code, with: ->(value) { value.strip.upcase }
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+  scope :expired, -> { where(expires_at: ..Time.current) }
+
+  def self.consume(code, id:)
+    transaction do
+      active.lock.find_by(id: id, code: code)&.tap(&:destroy!)
+    end
+  end
+
+  def self.cleanup
+    expired.in_batches.delete_all
+  end
+end
