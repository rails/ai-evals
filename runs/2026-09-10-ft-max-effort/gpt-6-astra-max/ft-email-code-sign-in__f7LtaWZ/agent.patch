+      post session_magic_link_path, params: {
+        code: @magic_link.code,
+        email_address: identities(:david).email_address,
+        magic_link_id: ActiveRecord::Type::Uuid.generate
+      }
+
+      assert_equal @identity, Session.find_signed!(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+
+  test "authenticates a JSON client using only the pending token cookie" do
+    client = open_session
+    client.cookies[:pending_authentication_token] = @pending_authentication_token
+    client.post "/session/magic_link", params: { code: @magic_link.code }, as: :json
+
+    assert_equal 200, client.response.status
+    assert_equal client.cookies[:session_token], client.response.parsed_body["session_token"]
+    assert client.cookies[:pending_authentication_token].blank?
+
+    client.get "/my/identity", as: :json
+    assert_equal 200, client.response.status
+  end
+
+  test "rate limits code attempts without consuming the code" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
