@@ -0,0 +1,23 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p>We sent a code to <strong><%= @email_address %></strong>. Enter it below to continue. It works for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.label :code, "Email code", class: "for-screen-reader" %>
+    <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, maxlength: MagicLink::CODE_LENGTH, pattern: "[A-Za-z0-9]{#{MagicLink::CODE_LENGTH}}", placeholder: "6-character code" %>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p><%= link_to "Use a different email or get a new code", @restart_url, class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
