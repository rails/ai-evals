diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..6ef83ad
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,95 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  rate_limit to: 10, within: MagicLink::EXPIRATION_TIME, only: :create, with: :rate_limit_exceeded,
+    by: -> { pending_authentication&.fetch("magic_link_id") || request.remote_ip }, name: "magic_link"
+  before_action :require_pending_authentication
+
+  layout "public"
+
+  def new
+    @email_address = pending_authentication["email_address"]
+    @restart_url = restart_url
+  end
+
+  def create
+    if magic_link = MagicLink.consume(params.expect(:code), id: pending_authentication["magic_link_id"])
+      cookies.delete(:pending_authentication_token)
+
+      if pending_authentication["purpose"] == "join"
+        join_account(magic_link.identity)
+      else
+        destination = signing_up?(magic_link.identity) ? new_signup_completion_url : after_authentication_url
+        authenticate(magic_link.identity, destination: destination)
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def require_pending_authentication
+      unless pending_authentication
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email address to get a new code." }
+          format.json { render json: { message: "Enter your email address to get a new code." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def restart_url
+      if pending_authentication["purpose"] == "sign_up"
+        new_signup_path
+      elsif pending_authentication["purpose"] == "join" && (join_code = Account::JoinCode.find_by(id: pending_authentication["join_code_id"]))
+        join_url(code: pending_authentication["join_code"], script_name: join_code.account.slug)
+      else
+        new_session_path
+      end
+    end
+
+    def signing_up?(identity)
+      pending_authentication["purpose"] == "sign_up" || (identity.users.none? && Account.accepting_signups?)
+    end
+
+    def join_account(identity)
+      @join_code = Account::JoinCode.find_by(id: pending_authentication["join_code_id"], code: pending_authentication["join_code"])
+
+      if @join_code.nil?
+        head :not_found
+      elsif user = @join_code.redeem(identity)
+        authenticate(identity, destination: after_join_url_for(user))
+      else
+        respond_to do |format|
+          format.html { render "join_codes/inactive", status: :gone }
+          format.json { render json: { message: "That join code is all used up." }, status: :gone }
+        end
+      end
+    end
+
+    def authenticate(identity, destination:)
+      terminate_session if Current.session && Current.identity != identity
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code didn’t work. Try again or request a new code."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
