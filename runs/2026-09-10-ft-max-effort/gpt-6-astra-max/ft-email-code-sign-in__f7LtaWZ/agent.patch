diff --git a/test/integration/email_code_authentication_test.rb b/test/integration/email_code_authentication_test.rb
new file mode 100644
index 0000000..6eaba50
--- /dev/null
+++ b/test/integration/email_code_authentication_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in using the code from the email subject" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post session_path, params: { email_address: identity.email_address }
+        end
+      end
+
+      assert_no_difference -> { Session.count } do
+        follow_redirect!
+      end
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code][maxlength='6']"
+      assert_nil cookies[:session_token]
+
+      code = code_from_email(identity.email_address)
+      verification_path = css_select("form").first["action"]
+
+      assert_difference -> { identity.sessions.count }, 1 do
+        post verification_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].blank?
+    end
+  end
+
+  test "sign up using an email code and complete the account" do
+    email_address = "newperson@example.com"
+
+    untenanted do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      follow_redirect!
+      assert_response :success
+      verification_path = css_select("form").first["action"]
+
+      assert_no_difference -> { Account.count } do
+        post verification_path, params: { code: code_from_email(email_address) }
+      end
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+
+      identity = Identity.find_by!(email_address: email_address)
+      user = identity.users.sole
+      assert_equal "New Person", user.name
+      assert_predicate user, :owner?
+      assert_predicate user, :verified?
+      assert_redirected_to landing_url(script_name: user.account.slug)
+    end
+  end
+
+  test "join an account only after verifying the email code" do
+    email_address = "newmember@example.com"
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+        end
+      end
+    end
+
+    follow_redirect!
+    assert_response :success
+    verification_path = css_select("form").first["action"]
+
+    assert_difference -> { User.count }, 1 do
+      assert_difference -> { join_code.reload.usage_count }, 1 do
+        post verification_path, params: { code: code_from_email(email_address) }
+      end
+    end
+
+    assert cookies[:session_token].present?
+    assert cookies[:pending_authentication_token].blank?
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+    post users_joins_path(script_name: account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path(script_name: account.slug)
+
+    user = account.users.find_by!(identity: Identity.find_by!(email_address: email_address))
+    assert_equal "New Member", user.name
+    assert_predicate user, :verified?
+  end
+
+  private
+    def code_from_email(email_address)
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ email_address ], email.to
+
+      code = email.subject[/\b[A-Z0-9]{6}\b/]
+      assert_not_nil code, "Expected a six-character code in the email subject"
+      code
+    end
+end
