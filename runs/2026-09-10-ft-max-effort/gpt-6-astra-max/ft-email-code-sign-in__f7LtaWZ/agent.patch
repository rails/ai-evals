diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..5e3ad2f
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code that expires in fifteen minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_match /\A[A-Z0-9]{6}\z/, magic_link.code
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+    end
+  end
+
+  test "consumes a code once" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code, id: magic_link.id)
+    assert_nil MagicLink.consume(magic_link.code, id: magic_link.id)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "accepts a code just before fifteen minutes" do
+    freeze_time
+    magic_link = @identity.magic_links.create!
+
+    travel 15.minutes - 1.second
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code, id: magic_link.id)
+  end
+
+  test "rejects a code at fifteen minutes" do
+    freeze_time
+    magic_link = @identity.magic_links.create!
+
+    travel 15.minutes
+
+    assert_nil MagicLink.consume(magic_link.code, id: magic_link.id)
+    assert_predicate magic_link.reload, :persisted?
+  end
+
+  test "normalizes case and surrounding whitespace when consuming a code" do
+    magic_link = @identity.magic_links.create!(code: "ABC123")
+
+    assert_equal magic_link, MagicLink.consume(" abc123 \n", id: magic_link.id)
+  end
+
+  test "does not consume another challenge's code" do
+    magic_link = @identity.magic_links.create!(code: "ABC123")
+    other_link = @identity.magic_links.create!(code: "DEF456")
+
+    assert_no_difference -> { MagicLink.count } do
+      assert_nil MagicLink.consume(other_link.code, id: magic_link.id)
+    end
+  end
+
+  test "rejects invalid codes without consuming the challenge" do
+    magic_link = @identity.magic_links.create!
+
+    assert_no_difference -> { MagicLink.count } do
+      [ nil, "", " ", "WRONG", "TOO-LONG" ].each do |code|
+        assert_nil MagicLink.consume(code, id: magic_link.id)
+      end
+    end
+  end
+
+  test "cleans up only expired codes" do
+    freeze_time do
+      expired_link = @identity.magic_links.create!(expires_at: Time.current)
+      active_link = @identity.magic_links.create!
+
+      assert_difference -> { MagicLink.count }, -1 do
+        MagicLink.cleanup
+      end
+
+      assert_not MagicLink.exists?(expired_link.id)
+      assert MagicLink.exists?(active_link.id)
+    end
+  end
+
+  test "destroying an identity destroys its codes" do
+    magic_link = @identity.magic_links.create!
+
+    @identity.destroy!
+
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+end
