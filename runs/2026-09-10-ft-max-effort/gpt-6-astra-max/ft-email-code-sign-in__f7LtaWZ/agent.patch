@@ -0,0 +1,37 @@
+module Authentication::ViaMagicLink
+  private
+
+  def send_magic_link_to(identity, email_address: identity&.email_address, purpose: :sign_in, join_code: nil)
+    magic_link = identity&.send_magic_link
+
+    cookies.signed[:pending_authentication_token] = {
+      value: {
+        magic_link_id: magic_link&.id || ActiveRecord::Type::Uuid.generate,
+        email_address: email_address,
+        purpose: purpose,
+        join_code_id: join_code&.id,
+        join_code: join_code&.code
+      }.compact,
+      expires: magic_link&.expires_at || MagicLink::EXPIRATION_TIME.from_now,
+      httponly: true,
+      same_site: :lax
+    }
+
+    respond_to do |format|
+      format.html { redirect_to new_session_magic_link_url(script_name: nil) }
+      format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+    end
+  end
+
+  def pending_authentication
+    @pending_authentication ||= cookies.signed[:pending_authentication_token]
+  end
+
+  def after_join_url_for(user)
+    if user.setup?
+      landing_url(script_name: user.account.slug)
+    else
+      new_users_verification_url(script_name: user.account.slug)
+    end
+  end
+end
