+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "sends the code in the subject and both email formats" do
+    identity = identities(:kevin)
+    magic_link = identity.magic_links.create!
+    email = IdentityMailer.magic_link(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identity.email_address ], email.to
+    assert_includes email.subject, magic_link.code
+    assert_includes email.html_part.body.decoded, magic_link.code
+    assert_includes email.text_part.body.decoded, magic_link.code
+    assert_includes email.html_part.body.decoded, "15 minutes"
+    assert_includes email.text_part.body.decoded, "15 minutes"
+    assert_includes email.text_part.body.decoded, "only be used once"
+  end
+end
