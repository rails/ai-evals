diff --git a/test/helpers/bridge_helper_test.rb b/test/helpers/bridge_helper_test.rb
new file mode 100644
index 0000000..d3df443
--- /dev/null
+++ b/test/helpers/bridge_helper_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card share buttons send raw timestamps for the browser to format" do
+    card = cards(:logo)
+    card.created_at = Time.iso8601("2025-01-21T20:15:00-05:00")
+    card.last_active_at = Time.iso8601("2025-01-22T20:15:00-05:00")
+
+    button = Nokogiri::HTML.fragment(bridged_share_card_button(card)).at_css("button")
+
+    assert_equal "2025-01-22T01:15:00Z", button["data-bridge-share-created-at"]
+    assert_equal "2025-01-23T01:15:00Z", button["data-bridge-share-updated-at"]
+    assert_includes button["data-bridge-share-description"], "by #{card.creator.familiar_name}"
+    assert_no_match(/Jan|2025/, button["data-bridge-share-description"])
+  end
+
+  test "board share buttons keep their plain descriptions" do
+    description = bridge_share_board_description(boards(:writebook))
+    button = Nokogiri::HTML.fragment(bridged_share_url_button(description)).at_css("button")
+
+    assert_equal description, button["data-bridge-share-description"]
+    assert_nil button["data-bridge-share-created-at"]
+    assert_nil button["data-bridge-share-updated-at"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..feb692e
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time tags contain a raw UTC timestamp rather than server-formatted text" do
+    time = Time.iso8601("2025-01-22T13:42:00-05:00")
+
+    assert_select fragment(local_time_tag(time)), "time" do |elements|
+      element = elements.first
+      assert_equal "2025-01-22T18:42:00Z", element["datetime"]
+      assert_equal element["datetime"], element.text
+      assert_equal "local-time", element["data-controller"]
+      assert_equal "time-or-date", element["data-local-time-style-value"]
+      assert_nil element["title"]
+    end
+  end
+
+  test "local time tags are independent of the server timezone and current time" do
+    timestamp = Time.utc(2025, 1, 22, 18, 42)
+    tags = [ "America/New_York", "Asia/Tokyo" ].map do |timezone|
+      Time.use_zone(timezone) { local_time_tag(timestamp.in_time_zone) }
+    end
+
+    travel_to 1.year.from_now do
+      assert_equal tags.first, local_time_tag(timestamp)
+    end
+    assert_equal tags.first, tags.last
+  end
+
+  test "local time tags preserve HTML options and other controllers without mutating them" do
+    data = { controller: "tooltip", action: "click->tooltip#show" }
+    html = local_time_tag(Time.current, style: :long_date, class: "timestamp", data: data)
+
+    assert_select fragment(html), "time.timestamp" do |elements|
+      assert_equal "tooltip local-time", elements.first["data-controller"]
+      assert_equal "click->tooltip#show", elements.first["data-action"]
+      assert_equal "long-date", elements.first["data-local-time-style-value"]
+    end
+    assert_equal "tooltip", data[:controller]
+  end
+
+  test "calendar dates stay date-only" do
+    assert_select fragment(local_time_tag(Date.new(2025, 1, 22), style: :long_date)), "time" do |elements|
+      assert_equal "2025-01-22", elements.first["datetime"]
+      assert_equal "2025-01-22", elements.first.text
+    end
+  end
+
+  private
+    def fragment(html)
+      Nokogiri::HTML.fragment(html)
+    end
+end
diff --git a/test/integration/local_time_rendering_test.rb b/test/integration/local_time_rendering_test.rb
new file mode 100644
index 0000000..c295d08
--- /dev/null
+++ b/test/integration/local_time_rendering_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_kevin)
+    @comment.update!(created_at: Time.utc(2025, 1, 22, 18, 42))
+  end
+
+  test "comments send the same raw timestamp in every server timezone" do
+    timestamps = [ "America/New_York", "Asia/Tokyo" ].map do |timezone|
+      cookies[:timezone] = timezone
+      get card_path(@comment.card)
+      assert_response :success
+
+      selector = "##{ActionView::RecordIdentifier.dom_id(@comment)} .comment__permalink-title time"
+      assert_select selector, count: 1
+      css_select(selector).first.to_html
+    end
+
+    assert_equal timestamps.first, timestamps.last
+    assert_includes timestamps.first, 'datetime="2025-01-22T18:42:00Z"'
+    assert_includes timestamps.first, 'data-controller="local-time"'
+  end
+  test "cached comments remain timestamp-only when the day and timezone change" do
+    original_store = ApplicationController.cache_store
+    original_caching = ApplicationController.perform_caching
+    ApplicationController.cache_store = ActiveSupport::Cache::MemoryStore.new
+    ApplicationController.perform_caching = true
+    cache_hits = []
+    subscriber = ->(event) { cache_hits << event.payload[:key].to_s if event.payload[:hit] }
+
+    ActiveSupport::Notifications.subscribed(subscriber, "cache_read.active_support") do
+      cookies[:timezone] = "America/New_York"
+      get card_path(@comment.card)
+      selector = "##{ActionView::RecordIdentifier.dom_id(@comment)} .comment__permalink-title time"
+      assert_select selector, count: 1
+      first_timestamp = css_select(selector).first.to_html
+
+      travel_to 2.days.from_now do
+        cookies[:timezone] = "Asia/Tokyo"
+        get card_path(@comment.card)
+        assert_select selector, count: 1
+        assert_equal first_timestamp, css_select(selector).first.to_html
+      end
+    end
+
+    assert cache_hits.any? { |key| key.include?("comments/#{@comment.id}") }, "Expected a comment fragment cache hit"
+  ensure
+    ApplicationController.cache_store = original_store
+    ApplicationController.perform_caching = original_caching
+  end
+
+  test "auto-closing notices leave relative wording to the browser" do
+    card = cards(:layout)
+    deadline = card.entropy.auto_clean_at.utc.iso8601
+    get card_path(card)
+
+    assert_select ".card-perma__closure-message time[data-local-time-style-value='relative']" do |elements|
+      assert_equal deadline, elements.first["datetime"]
+      assert_equal "Moves to “Not Now” #{deadline} if there’s no activity.", elements.first.parent.text.squish
+    end
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..c3e8e9a
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,271 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    use_timezone "America/New_York"
+    sign_in_as(users(:kevin))
+    freeze_browser_time "2025-09-17T19:42:00Z"
+  end
+
+  teardown do
+    page.execute_script <<~JS
+      if (window.originalSetInterval) {
+        window.setInterval = window.originalSetInterval
+        window.clearInterval = window.originalClearInterval
+      }
+    JS
+    use_timezone ""
+  end
+
+  test "recent timestamps use local clock times and calendar days" do
+    {
+      "2025-09-17T17:42:00Z" => "1:42 PM",
+      "2025-09-17T03:30:00Z" => "yesterday",
+      "2025-09-12T17:42:00Z" => "5 days ago",
+      "2025-09-10T17:42:00Z" => "Sep 10",
+      "2024-09-12T17:42:00Z" => "Sep 12, 2024",
+      "2025-09-18T17:42:00Z" => "tomorrow"
+    }.each do |timestamp, expected|
+      assert_equal expected, formatted_time(timestamp)
+    end
+  end
+
+  test "relative deadlines use today tomorrow and in N days" do
+    {
+      "2025-09-17T20:00:00Z" => "today",
+      "2025-09-18T04:01:00Z" => "tomorrow",
+      "2025-09-20T04:01:00Z" => "in 3 days",
+      "2025-10-17T04:01:00Z" => "in 30 days",
+      "2025-09-17T03:59:00Z" => "yesterday"
+    }.each do |timestamp, expected|
+      assert_equal expected, formatted_time(timestamp, style: "relative")
+    end
+  end
+
+  test "midnight boundaries follow the browser even with stale server timezone metadata" do
+    page.execute_script <<~JS
+      document.head.insertAdjacentHTML("beforeend", '<meta name="timezone" content="Asia/Tokyo">')
+    JS
+
+    assert_equal "yesterday", formatted_time("2025-09-18T03:59:00Z", now: "2025-09-18T04:01:00Z")
+    assert_equal "tomorrow", formatted_time("2025-09-18T04:01:00Z", style: "relative", now: "2025-09-18T03:59:00Z")
+  end
+
+  test "the same timestamp follows the viewer across timezones including fractional offsets" do
+    {
+      "America/New_York" => [ "8:15 PM", "Jan 21, 2025" ],
+      "Asia/Tokyo" => [ "10:15 AM", "Jan 22, 2025" ],
+      "Asia/Kathmandu" => [ "7:00 AM", "Jan 22, 2025" ],
+      "Pacific/Honolulu" => [ "3:15 PM", "Jan 21, 2025" ],
+      "Pacific/Kiritimati" => [ "3:15 PM", "Jan 22, 2025" ]
+    }.each do |timezone, (time, date)|
+      use_timezone timezone
+      assert_equal time, formatted_time("2025-01-22T01:15:00Z", style: "time"), timezone
+      assert_equal date, formatted_time("2025-01-22T01:15:00Z", style: "date"), timezone
+    end
+  end
+
+  test "relative dates count calendar days across DST month year and leap day boundaries" do
+    [
+      [ "2025-03-08T12:00:00-05:00", "2025-03-09T12:00:00-04:00" ],
+      [ "2025-11-01T12:00:00-04:00", "2025-11-02T12:00:00-05:00" ],
+      [ "2025-01-31T23:59:00-05:00", "2025-02-01T00:01:00-05:00" ],
+      [ "2024-12-31T23:59:00-05:00", "2025-01-01T00:01:00-05:00" ],
+      [ "2024-02-28T12:00:00-05:00", "2024-02-29T12:00:00-05:00" ],
+      [ "2024-02-29T12:00:00-05:00", "2024-03-01T12:00:00-05:00" ]
+    ].each do |before, after|
+      assert_equal "tomorrow", formatted_time(after, style: "relative", now: before)
+      assert_equal "yesterday", formatted_time(before, style: "relative", now: after)
+    end
+  end
+
+  test "calendar dates do not shift west of UTC" do
+    append_time Date.new(2025, 1, 22), style: :long_date
+
+    assert_selector "#local-time-test", exact_text: "Wednesday, January 22, 2025"
+    assert_equal "Wednesday, January 22, 2025", find("#local-time-test")["title"]
+  end
+
+  test "time tags added after page load get local text and an absolute tooltip" do
+    append_time Time.iso8601("2025-09-17T17:42:00Z")
+
+    assert_selector "#local-time-test", exact_text: "1:42 PM"
+    assert_equal "Wednesday, September 17, 2025 at 1:42 PM", find("#local-time-test")["title"]
+    assert_equal "2025-09-17T17:42:00Z", find("#local-time-test")["datetime"]
+  end
+
+  test "comments render in the browser timezone on a page requested in UTC" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update!(created_at: Time.utc(2025, 9, 17, 17, 42))
+    page.execute_script "document.cookie = 'timezone=UTC; path=/'"
+    visit card_url(comment.card)
+    freeze_browser_time "2025-09-17T19:42:00Z"
+
+    selector = "##{ActionView::RecordIdentifier.dom_id(comment)} .comment__permalink-title time"
+    assert_selector "#{selector}[title]"
+    page.execute_script "arguments[0].dateTime = '2025-09-17T17:42:00.000Z'", find(selector)
+
+    assert_selector selector, exact_text: "1:42 PM"
+  end
+
+  test "changing timestamps styles and fallback text rerenders a connected time tag" do
+    append_time Time.iso8601("2025-09-17T17:42:00Z")
+    assert_selector "#local-time-test", exact_text: "1:42 PM"
+
+    page.execute_script "document.querySelector('#local-time-test').dateTime = '2025-09-12T17:42:00Z'"
+    assert_selector "#local-time-test", exact_text: "5 days ago"
+
+    page.execute_script "document.querySelector('#local-time-test').dataset.localTimeStyleValue = 'date'"
+    assert_selector "#local-time-test", exact_text: "Sep 12, 2025"
+
+    page.execute_script "document.querySelector('#local-time-test').firstChild.data = '2025-09-12T17:42:00Z'"
+    assert_selector "#local-time-test", exact_text: "Sep 12, 2025"
+  end
+
+  test "Turbo morphs keep timestamps localized without reconnecting the element" do
+    append_time Time.iso8601("2025-09-17T17:42:00Z")
+    assert_selector "#local-time-test", exact_text: "1:42 PM"
+
+    html = time_tag_html(Time.iso8601("2025-09-16T17:42:00Z"))
+    page.execute_script <<~JS, html
+      window.originalTimeElement = document.querySelector("#local-time-test")
+      Turbo.renderStreamMessage(`<turbo-stream action="replace" method="morph" target="local-time-test"><template>${arguments[0]}</template></turbo-stream>`)
+    JS
+
+    assert_selector "#local-time-test", exact_text: "yesterday"
+    assert page.evaluate_script("document.querySelector('#local-time-test') === window.originalTimeElement")
+  end
+
+  test "relative text refreshes as days pass and the timer is cleared on disconnect" do
+    page.execute_script <<~JS
+      window.localTimeIntervals = new Map()
+      window.originalSetInterval = window.setInterval
+      window.originalClearInterval = window.clearInterval
+      window.setInterval = (callback, delay) => {
+        const id = window.originalSetInterval(callback, delay)
+        if (delay === 60000) window.localTimeIntervals.set(id, callback)
+        return id
+      }
+      window.clearInterval = (id) => {
+        window.localTimeIntervals.delete(id)
+        window.originalClearInterval(id)
+      }
+    JS
+    append_time Time.iso8601("2025-09-17T17:42:00Z")
+    assert_selector "#local-time-test", exact_text: "1:42 PM"
+
+    freeze_browser_time "2025-09-18T19:42:00Z"
+    page.execute_script "window.localTimeIntervals.forEach(callback => callback())"
+    assert_selector "#local-time-test", exact_text: "yesterday"
+
+    count = page.evaluate_script("window.localTimeIntervals.size")
+    assert_operator count, :>, 0
+    page.execute_script "document.querySelector('#local-time-test').remove()"
+    assert_equal count - 1, page.evaluate_script("window.localTimeIntervals.size")
+  end
+
+  test "invalid or missing timestamps do not break rendering" do
+    append_time Time.iso8601("2025-09-17T17:42:00Z")
+    assert_selector "#local-time-test", exact_text: "1:42 PM"
+
+    page.execute_script "document.querySelector('#local-time-test').dateTime = 'not-a-date'"
+    assert_selector "#local-time-test", exact_text: "not-a-date"
+    assert_no_selector "#local-time-test[title]"
+
+    page.execute_script "document.querySelector('#local-time-test').removeAttribute('datetime')"
+    assert_selector "#local-time-test", exact_text: "", visible: :all
+    assert_no_selector "#local-time-test[title]"
+  end
+
+  test "native card shares format their timestamp metadata in the viewer timezone" do
+    register_test_bridge "share"
+    card = cards(:logo)
+    card.created_at = Time.utc(2025, 1, 22, 1, 15)
+    card.last_active_at = Time.utc(2025, 1, 23, 1, 15)
+    html = ApplicationController.helpers.bridged_share_card_button(card)
+
+    page.execute_script <<~JS, html
+      document.body.insertAdjacentHTML("beforeend", arguments[0])
+      const button = document.body.lastElementChild
+      button.id = "share-time-test"
+      button.dataset.controller = "test-share"
+    JS
+    page.execute_script <<~JS
+      const button = document.querySelector("#share-time-test")
+      Stimulus.getControllerForElementAndIdentifier(button, "test-share").shareUrl()
+    JS
+    description = page.evaluate_script("window.timeBridgeMessage.description")
+
+    assert_includes description, "Added Jan 21, 2025 by #{card.creator.familiar_name}"
+    assert_includes description, "Updated Jan 22, 2025"
+  end
+
+  test "native stamps format the same local date as their time tags" do
+    register_test_bridge "stamp"
+    card = cards(:logo)
+    card.close(user: users(:kevin))
+    card.closure.update!(created_at: Time.utc(2025, 1, 22, 1, 15))
+    html = ApplicationController.render(partial: "cards/display/common/stamp", locals: { card: card })
+
+    page.execute_script <<~JS, html
+      const container = document.createElement("div")
+      container.id = "stamp-time-test"
+      container.className = "card-perma"
+      container.innerHTML = arguments[0]
+      container.querySelector("[data-controller='bridge--stamp']").dataset.controller = "test-stamp"
+      document.body.append(container)
+    JS
+
+    assert_selector "#stamp-time-test time", exact_text: "JAN 21, 2025"
+    assert_equal "Jan 21, 2025", page.evaluate_script("window.timeBridgeMessage.description")
+    assert_equal "Done", page.evaluate_script("window.timeBridgeMessage.title")
+  end
+
+  private
+    def register_test_bridge(component)
+      result = page.evaluate_async_script <<~JS, component
+        const [component, done] = arguments
+        import(`controllers/bridge/${component}_controller`).then(({ default: BridgeController }) => {
+          class TestBridgeController extends BridgeController {
+            static get shouldLoad() { return true }
+            send(event, data) { window.timeBridgeMessage = { event, ...data } }
+          }
+          Stimulus.register(`test-${component}`, TestBridgeController)
+          done("registered")
+        }).catch(error => done(error.message))
+      JS
+      assert_equal "registered", result
+    end
+
+    def use_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def freeze_browser_time(timestamp)
+      page.execute_script <<~JS, timestamp
+        window.OriginalDate ||= Date
+        const now = new window.OriginalDate(arguments[0]).getTime()
+        window.Date = class extends window.OriginalDate {
+          constructor(...args) { super(...(args.length ? args : [now])) }
+          static now() { return now }
+        }
+      JS
+    end
+
+    def append_time(time, **options)
+      page.execute_script "document.body.insertAdjacentHTML('beforeend', arguments[0])", time_tag_html(time, **options)
+    end
+
+    def time_tag_html(time, **options)
+      ApplicationController.helpers.local_time_tag(time, id: "local-time-test", **options)
+    end
+
+    def formatted_time(timestamp, style: "time-or-date", now: "2025-09-17T19:42:00Z")
+      page.evaluate_async_script <<~JS, timestamp, style, now
+        const [timestamp, style, now, done] = arguments
+        import("helpers/date_helpers").then(({ formatLocalTime, parseLocalTime }) => {
+          done(formatLocalTime(parseLocalTime(timestamp), style, parseLocalTime(now)))
+        }).catch(error => done(error.message))
+      JS
+    end
+end
