diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..13a3d1f
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,56 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "time-or-date" } }
+
+  #observer
+  #timer
+
+  connect() {
+    this.render()
+    this.#observeTime()
+    this.#timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    this.#observer.disconnect()
+    clearInterval(this.#timer)
+  }
+
+  styleValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const datetime = this.element.dateTime
+    const date = parseLocalTime(datetime)
+    let text = datetime
+
+    if (!Number.isNaN(date.getTime())) {
+      text = formatLocalTime(date, this.styleValue)
+      this.element.title = formatLocalTime(date, datetime.length === 10 ? "long-date" : "datetime")
+    } else {
+      this.element.removeAttribute("title")
+    }
+
+    if (this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+  }
+
+  #observeTime() {
+    // Turbo morphs can change the timestamp or restore the server's fallback
+    // text without reconnecting the controller.
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime" ],
+      childList: true,
+      characterData: true,
+      subtree: true
+    })
+  }
+}
