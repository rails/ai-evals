diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..665f30f
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,21 @@
+module SearchesHelper
+  def highlight_search_matches(text, terms)
+    if terms.any?
+      parts = text.to_s.split(/(#{search_terms_pattern(terms)})/)
+      safe_join(parts.each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part })
+    else
+      ERB::Util.html_escape(text.to_s)
+    end
+  end
+
+  def search_excerpt(text, terms)
+    text = text.to_s.squish
+    snippet = excerpt(text, search_terms_pattern(terms), radius: 100) || text.truncate(200)
+    highlight_search_matches(snippet, terms)
+  end
+
+  private
+    def search_terms_pattern(terms)
+      Regexp.new(Regexp.union(terms.sort_by { |term| -term.length }).source, Regexp::IGNORECASE)
+    end
+end
