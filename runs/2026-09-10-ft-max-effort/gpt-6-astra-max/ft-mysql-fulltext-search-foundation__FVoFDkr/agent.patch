+    record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(card.account)
+
+    [ nil, "stale-index" ].each do |plain_text_body|
+      data = {
+        "id" => ActiveRecord::Type::Uuid.generate,
+        "account_id" => card.account_id,
+        "record_type" => "Card",
+        "record_id" => card.id,
+        "name" => "description",
+        "body" => "<div>ne<strong>bula</strong> R&amp;D</div>",
+        "created_at" => Time.current.iso8601,
+        "updated_at" => Time.current.iso8601
+      }
+      data["plain_text_body"] = plain_text_body if plain_text_body
+
+      Tempfile.create([ "search_import", ".zip" ]) do |file|
+        file.binmode
+        writer = ZipFile::Writer.new(file)
+        writer.add_file("data/action_text_rich_texts/#{data['id']}.json", data.to_json)
+        writer.close
+        file.rewind
+
+        record_set.import(from: ZipFile::Reader.new(file))
+      end
+
+      rich_text = ::ActionText::RichText.find(data["id"])
+      assert_equal "nebula R&D", rich_text.plain_text_body.strip
+      assert_equal [ card ], Search.new("nebula R&D", user: users(:david)).cards
+      assert_empty Search.new("stale-index", user: users(:david)).cards
+      rich_text.destroy!
+    end
+  end
