diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..05e4a44
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights all matches case insensitively" do
+    assert_equal "<mark>Nebula</mark> and <mark>NEBULA</mark>", highlight_search_matches("Nebula and NEBULA", [ "nebula" ])
+  end
+
+  test "highlights multiple terms preferring the longest match" do
+    assert_equal "<mark>Nebula</mark> <mark>cloud</mark>", highlight_search_matches("Nebula cloud", %w[ neb nebula cloud ])
+  end
+
+  test "escapes HTML in text and in the matching terms" do
+    text = '<script>alert("x")</script> & nebula'
+    result = highlight_search_matches(text, [ "<script>", "nebula" ])
+
+    assert_dom_equal "<mark>&lt;script&gt;</mark>alert(&quot;x&quot;)&lt;/script&gt; &amp; <mark>nebula</mark>", result
+    assert result.html_safe?
+  end
+
+  test "does not highlight inside escaped HTML entities" do
+    assert_equal "&lt; &amp; <mark>lt</mark>", highlight_search_matches("< & lt", [ "lt" ])
+  end
+
+  test "regular expression characters are literal" do
+    assert_equal "<mark>C++</mark> <mark>[test]</mark> test", highlight_search_matches("C++ [test] test", [ "C++", "[test]" ])
+  end
+
+  test "escapes text even with no search terms" do
+    assert_equal "&lt;script&gt;", highlight_search_matches("<script>", [])
+  end
+
+  test "excerpts include matches far into the content" do
+    text = "Unrelated text. " * 100 + "A Nebula appears here. " + "More unrelated text. " * 100
+    result = search_excerpt(text, [ "nebula" ])
+
+    assert_includes result, "<mark>Nebula</mark>"
+    assert_operator result.length, :<, 250
+  end
+
+  test "excerpts without matches are truncated and escaped" do
+    result = search_excerpt("<script>" + "x" * 300, [ "nebula" ])
+
+    assert_match /\A&lt;script&gt;/, result
+    assert_match /\.\.\.\z/, result
+    assert_not_includes result, "<mark>"
+  end
+
+  test "empty content has an empty excerpt" do
+    assert_equal "", search_excerpt(nil, [ "nebula" ])
+  end
+end
