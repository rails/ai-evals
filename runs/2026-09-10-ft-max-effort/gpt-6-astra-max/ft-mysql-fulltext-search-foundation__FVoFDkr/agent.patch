@@ -0,0 +1,26 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap", role: "search" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @search.query, placeholder: "Search cards…", class: "input full-width", autofocus: true %>
+    <%= button_tag "Search", class: "btn btn--reversed" %>
+  <% end %>
+
+  <div id="search_results" class="margin-block-start" aria-live="polite">
+    <% if @search.query.blank? %>
+      <p>Search cards by title, description, or comments.</p>
+    <% elsif @page.records.empty? %>
+      <p>No cards found for “<%= @search.query %>”.</p>
+    <% else %>
+      <%= with_manual_pagination :search_results_paginated_container, @page do %>
+        <%= render partial: "searches/card", collection: @page.records, locals: { terms: @search.terms, comments: @comments } %>
+      <% end %>
+    <% end %>
+  </div>
+</section>
