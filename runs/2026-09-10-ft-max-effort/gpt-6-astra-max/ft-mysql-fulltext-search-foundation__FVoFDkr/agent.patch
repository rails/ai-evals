+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @user = users(:david)
+  end
+
+  test "blank queries do not match any cards" do
+    [ nil, "", " \t\n " ].each do |query|
+      assert_empty search(query).cards
+    end
+  end
+
+  test "matches titles without descriptions or comments" do
+    assert_equal [ cards(:buy_domain) ], search("DOMAIN").cards
+  end
+
+  test "matches existing comments" do
+    assert_equal [ cards(:layout) ], search("overflowing").cards
+  end
+
+  test "all terms must match but can appear in different fields or comments" do
+    cards(:logo).update!(title: "Nebula planning", description: "A green cloud")
+    cards(:layout).comments.create!(body: "A nebula", creator: @user)
+    cards(:layout).comments.create!(body: "It is green", creator: @user)
+    cards(:text).update!(title: "Another nebula")
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort, search("  GREEN \t nebula  ").cards.sort
+  end
+
+  test "searches visible rich text rather than HTML markup" do
+    cards(:logo).update!(description: '<div><a href="https://secret.example">ne<strong>bula</strong> R&amp;D</a></div>')
+    cards(:text).comments.create!(body: "<p>ne<em>bula</em> R&amp;D</p>", creator: @user)
+
+    assert_equal [ cards(:logo), cards(:text) ].sort, search("nebula R&D").cards.sort
+    assert_empty search("href").cards
+    assert_empty search("secret.example").cards
+    assert_empty search("strong").cards
+  end
+
+  test "exact accented terms match consistently across titles descriptions and comments" do
+    cards(:logo).update!(title: "ÉCLAIR")
+    cards(:layout).update!(description: "<p>ÉCLAIR</p>")
+    cards(:text).comments.create!(body: "<p>ÉCLAIR</p>", creator: @user)
+
+    assert_equal [ cards(:logo), cards(:layout), cards(:text) ].sort, search("ÉCLAIR").cards.sort
+  end
+
+  test "SQL wildcards and query syntax are literal text" do
+    [ "%", "_", "!", "C:\\work", "O'Reilly", "C++", "[test]", '" OR 1=1 --' ].each do |term|
+      cards(:logo).update!(title: "Find #{term} here")
+      assert_equal [ cards(:logo) ], search(term).cards, "Expected a literal match for #{term.inspect}"
+    end
+  end
+
+  test "SQL wildcards are literal in descriptions and comments too" do
+    cards(:logo).update!(description: "A 100% solution")
+    cards(:layout).comments.create!(body: "Uses snake_case", creator: @user)
+    cards(:text).update!(description: "A 1000 solution using snakeXcase")
+
+    assert_equal [ cards(:logo) ], search("100%").cards
+    assert_equal [ cards(:layout) ], search("snake_case").cards
+  end
+
+  test "one result per card even when all fields and multiple comments match" do
+    cards(:logo).update!(title: "Nebula", description: "Nebula description")
+    2.times { cards(:logo).comments.create!(body: "Nebula comment", creator: @user) }
+
+    assert_equal [ cards(:logo) ], search("nebula").cards
+    assert_equal [ cards(:logo).comments.last ], search("nebula").comments_for([ cards(:logo) ]).values
+  end
+
+  test "sorts by card creation time rather than recent activity with a stable tie breaker" do
+    cards(:logo).update!(title: "Nebula", created_at: 3.days.ago, last_active_at: Time.current)
+    cards(:layout).update!(title: "Nebula", created_at: 1.day.ago)
+    cards(:text).update!(title: "Nebula", created_at: cards(:layout).created_at)
+    cards(:logo).comments.create!(body: "Nebula recent comment", creator: @user)
+
+    assert_equal [ *[ cards(:layout), cards(:text) ].sort_by(&:id).reverse, cards(:logo) ], search("nebula").cards
+  end
+
+  test "access grants and revocations take effect immediately" do
+    card = boards(:private).cards.create!(title: "Nebula", description: "Nebula description", status: :published, creator: users(:kevin))
+    card.comments.create!(body: "Nebula comment", creator: users(:kevin))
+    query = search("nebula")
+
+    assert_empty query.cards
+    assert_empty query.comments_for([ card ])
+
+    boards(:private).accesses.grant_to(@user)
+    assert_equal [ card ], query.cards
+    assert_equal [ card.id ], query.comments_for([ card ]).keys
+
+    boards(:private).accesses.revoke_from(@user)
+    assert_empty query.cards
+    assert_empty query.comments_for([ card ])
+  end
+
+  test "moving a card uses access to its current board" do
+    card = boards(:writebook).cards.create!(title: "A card", status: :published, creator: @user)
+    card.comments.create!(body: "Nebula comment", creator: @user)
+    assert_equal [ card ], search("nebula").cards
+
+    card.move_to(boards(:private))
+    assert_empty search("nebula").cards
+
+    card.move_to(boards(:writebook))
+    assert_equal [ card ], search("nebula").cards
+  end
+
+  test "cards and their comments follow publication status immediately" do
+    card = cards(:logo)
+    card.update!(title: "A card", description: "")
+    comment = card.comments.create!(body: "Nebula comment", creator: @user)
+    assert_equal [ card ], search("nebula").cards
+
+    card.drafted!
+    assert_empty search("nebula").cards
+    assert_empty search("nebula").comments_for([ card ])
+
+    card.publish
+    assert_equal [ card ], search("nebula").cards
+
+    comment.destroy!
+    assert_empty search("nebula").cards
+  end
+
+  test "title and rich text edits are immediately searchable" do
+    card = cards(:logo)
+    card.update!(title: "Nebula")
+    assert_equal [ card ], search("nebula").cards
+
+    card.update!(title: "A card", description: "Nebula description")
+    assert_equal [ card ], search("nebula").cards
+
+    card.rich_text_description.update!(body: "A different description")
+    card.comments.by_system.destroy_all # Title changes leave searchable audit comments.
+    assert_empty search("nebula").cards
+
+    comment = card.comments.create!(body: "Nebula comment", creator: @user)
+    assert_equal [ card ], search("nebula").cards
+
+    comment.update!(body: "A different comment")
+    assert_empty search("nebula").cards
+
+    comment.rich_text_body.update!(body: "Nebula again")
+    assert_equal [ card ], search("nebula").cards
+
+    card.destroy!
+    assert_empty search("nebula").cards
+  end
+
+  test "closed and postponed published cards are searchable" do
+    cards(:logo).update!(title: "Nebula")
+    cards(:logo).close
+    cards(:text).update!(title: "Nebula")
+    cards(:text).postpone
+
+    assert_equal [ cards(:logo), cards(:text) ].sort, search("nebula").cards.sort
+  end
+
+  private
+    def search(query)
+      Search.new(query, user: @user)
+    end
+end
