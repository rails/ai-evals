diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..4f5d253
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.account = accounts(:"37s")
+    Current.user = users(:david)
+  end
+
+  test "searches titles descriptions and comments with newest cards first" do
+    cards(:logo).update!(title: "Nebula planning", created_at: 3.days.ago)
+    cards(:layout).update!(description: "<div>A <strong>nebula</strong> description</div>", created_at: 2.days.ago)
+    cards(:text).update!(created_at: 1.day.ago)
+    cards(:text).comments.create!(body: "Discuss the nebula here", creator: users(:david))
+    cards(:text).comments.create!(body: "Another nebula comment", creator: users(:david))
+
+    search_for "nebula"
+
+    assert_response :success
+    assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map { |card| card_path(card) }, result_paths
+    assert_select "#search_results mark", text: /nebula/i, minimum: 3
+    assert_select "form[action=?][method=get] input[name=q][value=nebula]", search_path
+  end
+
+  test "search only returns cards on accessible boards in the current account" do
+    cards(:logo).update!(title: "Nebula planning")
+    boards(:private).cards.create!(title: "Secret nebula", status: :published, creator: users(:kevin))
+    cards(:radio).update_column(:title, "Another account's nebula")
+
+    search_for "nebula"
+
+    assert_response :success
+    assert_equal [ card_path(cards(:logo)) ], result_paths
+    assert_no_match "Secret nebula", response.body
+    assert_no_match "Another account's nebula", response.body
+  end
+
+  test "drafts and comments on drafts are never results" do
+    cards(:logo).update!(title: "Nebula draft", description: "Nebula description", status: :drafted)
+    comments(:layout_overflowing_david).update!(body: "Nebula comment")
+    cards(:layout).drafted!
+
+    search_for "nebula"
+
+    assert_response :success
+    assert_empty result_paths
+    assert_select "#search_results", text: /No cards found/
+  end
+
+  test "empty searches show a search form without results" do
+    [ nil, "", "  \t\n " ].each do |query|
+      search_for query
+
+      assert_response :success
+      assert_empty result_paths
+      assert_select "input[type=search][name=q]"
+    end
+  end
+
+  test "access changes apply to repeated searches" do
+    cards(:logo).update!(title: "Nebula planning")
+    boards(:writebook).update!(all_access: false)
+
+    search_for "nebula"
+    assert_equal [ card_path(cards(:logo)) ], result_paths
+
+    boards(:writebook).accesses.revoke_from(users(:david))
+    search_for "nebula"
+    assert_response :success
+    assert_empty result_paths
+    assert_no_match "Nebula planning", response.body
+
+    boards(:writebook).accesses.grant_to(users(:david))
+    search_for "nebula"
+    assert_equal [ card_path(cards(:logo)) ], result_paths
+  end
+
+  test "matches in inaccessible descriptions and comments are excluded" do
+    private_card = boards(:private).cards.create!(title: "Private card", description: "Nebula description", status: :published, creator: users(:kevin))
+    private_card.comments.create!(body: "Nebula comment", creator: users(:kevin))
+
+    Current.with(account: accounts(:initech), user: users(:mike)) do
+      cards(:radio).update!(description: "Nebula in another account")
+      cards(:radio).comments.create!(body: "Nebula comment in another account")
+    end
+
+    search_for "nebula"
+
+    assert_response :success
+    assert_empty result_paths
+  end
+
+  test "search requires authentication" do
+    sign_out
+
+    search_for "logo"
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "search requires membership in the current account" do
+    get "/#{accounts(:initech).external_account_id}/search", params: { q: "radio" }
+
+    assert_redirected_to session_menu_path(script_name: nil)
+  end
+
+  test "query and matching content cannot inject HTML" do
+    query = '<script>alert("search")</script>'
+    cards(:logo).update!(title: query, description: "<div>#{ERB::Util.html_escape(query)}</div>")
+    cards(:text).comments.create!(body: "<div>#{ERB::Util.html_escape(query)}</div>", creator: users(:david))
+
+    search_for query
+
+    assert_response :success
+    assert_equal [ card_path(cards(:logo)), card_path(cards(:text)) ].sort, result_paths.sort
+    assert_select "#search_results script, #search_results img", count: 0
+    assert_select "#search_results mark", text: query, minimum: 3
+    assert_select "input[name=q][value=?]", query
+  end
+
+  test "unexpected query parameter types are treated as empty searches" do
+    [ [ "nebula" ], { term: "nebula" } ].each do |query|
+      search_for query
+
+      assert_response :success
+      assert_empty result_paths
+    end
+  end
+
+  test "pagination retains the query and newest first ordering" do
+    matching_cards = 27.times.map do |index|
+      boards(:writebook).cards.create!(title: "Nebula #{index}", created_at: index.minutes.ago, status: :published, creator: users(:david))
+    end
+
+    search_for "nebula"
+
+    assert_response :success
+    assert_equal matching_cards.first(25).map { |card| card_path(card) }, result_paths
+    next_page = css_select("#search_results .pagination-link").first["href"]
+    assert_equal "nebula", Rack::Utils.parse_query(URI.parse(next_page).query)["q"]
+
+    get next_page
+
+    assert_response :success
+    assert_equal matching_cards.last(2).map { |card| card_path(card) }, result_paths
+    assert_select "#search_results .pagination-link", count: 0
+  end
+
+  test "navigation has a link to search" do
+    get my_menu_path
+
+    assert_response :success
+    assert_select "a[href=?]", search_path, text: "Search cards"
+  end
+
+  private
+    def search_for(query)
+      get "/#{accounts(:"37s").external_account_id}/search", params: { q: query }
+    end
+
+    def result_paths
+      css_select("#search_results h2 a").map { |link| link["href"] }
+    end
+end
