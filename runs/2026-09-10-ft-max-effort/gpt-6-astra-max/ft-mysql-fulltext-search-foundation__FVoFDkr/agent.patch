diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..47e65bd
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,57 @@
+class Search
+  attr_reader :query, :user
+
+  def initialize(query, user:)
+    @query = query.to_s.squish
+    @user = user
+  end
+
+  def terms
+    @terms ||= query.split.uniq
+  end
+
+  def cards
+    accessible_cards = user.accessible_cards.where(account_id: user.account_id).published
+
+    if terms.any?
+      terms.reduce(accessible_cards) do |cards, term|
+        descriptions = matching_rich_texts("Card", "description", term)
+        comment_bodies = matching_rich_texts("Comment", "body", term)
+        commented_cards = Comment.where(id: comment_bodies.select(:record_id)).select(:card_id)
+
+        cards.where("LOWER(cards.title) LIKE LOWER(?) ESCAPE '!'", pattern_for(term))
+          .or(cards.where(id: descriptions.select(:record_id)))
+          .or(cards.where(id: commented_cards))
+      end.reverse_chronologically
+    else
+      accessible_cards.none
+    end
+  end
+
+  def comments_for(cards)
+    cards = cards.to_a
+
+    if terms.any? && cards.any?
+      bodies = terms.map { |term| matching_rich_texts("Comment", "body", term) }.reduce(&:or)
+
+      matching_comments = user.accessible_comments
+        .where(cards: { account_id: user.account_id, status: :published })
+        .where(card: cards, id: bodies.select(:record_id))
+
+      Comment.where(id: matching_comments.group(:card_id).select("MAX(comments.id)"))
+        .preload(:rich_text_body).index_by(&:card_id)
+    else
+      {}
+    end
+  end
+
+  private
+    def matching_rich_texts(record_type, name, term)
+      ActionText::RichText.where(account_id: user.account_id, record_type: record_type, name: name)
+        .where("LOWER(action_text_rich_texts.plain_text_body) LIKE LOWER(?) ESCAPE '!'", pattern_for(term))
+    end
+
+    def pattern_for(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+    end
+end
