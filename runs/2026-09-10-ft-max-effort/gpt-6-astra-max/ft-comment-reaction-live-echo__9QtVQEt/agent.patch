new file mode 100644
index 0000000..f44e7f3
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def new
+    @reaction = @comment.reactions.build(creator: Current.user)
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to @comment, status: :see_other }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.replace([ @comment, :new_reaction ],
+            partial: "cards/comments/reactions/form", locals: { comment: @comment, reaction: @reaction }), status: :unprocessable_entity
+        end
+        format.html { render :new, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @comment, status: :see_other }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..2255b47
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle", "delete" ]
+  static values = { creatorId: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  refresh() {
+    if (this.#ownReaction) {
+      this.element.classList.add("reaction--deleteable")
+      this.toggleTarget.setAttribute("role", "button")
+      this.toggleTarget.setAttribute("tabindex", "0")
+      this.toggleTarget.setAttribute("aria-expanded", this.element.classList.contains("expanded"))
+      this.deleteTarget.hidden = false
+    }
+  }
+
+  toggle(event) {
+    if (this.#ownReaction && !this.deleteTarget.contains(event.target)) {
+      event.preventDefault()
+      const expanded = this.element.classList.toggle("expanded")
+      this.toggleTarget.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  collapse() {
+    if (this.#ownReaction) {
+      this.element.classList.remove("expanded")
+      this.toggleTarget.setAttribute("aria-expanded", "false")
+      this.toggleTarget.focus()
+    }
+  }
+
+  get #ownReaction() {
+    return this.creatorIdValue === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..0d168d8
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,20 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input" ]
+  static values = { maximumLength: Number }
+
+  connect() {
+    // Native maxlength counts UTF-16 code units; Rails and the database count Unicode characters.
+    this.inputTarget.maxLength = this.maximumLengthValue * 2
+  }
+
+  limitLength(event) {
+    if (!event.isComposing) {
+      const characters = Array.from(this.inputTarget.value)
+      if (characters.length > this.maximumLengthValue) {
+        this.inputTarget.value = characters.slice(0, this.maximumLengthValue).join("")
+      }
+    }
+  }
+}
