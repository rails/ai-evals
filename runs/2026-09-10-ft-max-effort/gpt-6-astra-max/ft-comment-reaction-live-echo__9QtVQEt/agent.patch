diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..60b1a3e
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,213 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "comments have a reactions strip and an add button" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment)} .reactions" do
+      assert_select "##{dom_id(@comment, :reactions)}.reactions__list"
+      assert_select "a.reactions__trigger[href=?]", new_card_comment_reaction_path(@card, @comment) do
+        assert_select "img[src*='boost-color']"
+      end
+    end
+  end
+
+  test "cached comments reflect reaction creation and removal" do
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 0
+
+      reaction = @comment.reactions.create!(content: "👍", creator: users(:kevin))
+      get card_path(@card)
+      assert_select "##{dom_id(reaction)}", count: 1
+
+      reaction.destroy!
+      get card_path(@card)
+      assert_select "##{dom_id(reaction)}", count: 0
+    end
+  end
+
+  test "new renders a compact reaction form" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)}" do
+      assert_select "form.reaction__form[action=?]", card_comment_reactions_path(@card, @comment) do
+        assert_select "input.reaction__input[name='reaction[content]'][maxlength='16'][required]"
+        assert_select ".reaction__submit-btn"
+        assert_select ".reaction__cancel-btn"
+      end
+    end
+  end
+
+  test "create appends the reaction and restores the add button" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice work! 🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions)
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :new_reaction)
+    assert_select ".reactions__trigger"
+    assert_select ".reaction__input", count: 0
+
+    reaction = @comment.reactions.last
+    assert_equal "Nice work! 🎉", reaction.content
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+
+    get card_comment_path(@card, @comment)
+    assert_select "##{dom_id(reaction)}", text: /Nice work! 🎉/
+    assert_select "##{dom_id(reaction)} [title='Kevin']"
+  end
+
+  test "one person can leave multiple reactions" do
+    assert_difference -> { @comment.reactions.count }, +2 do
+      2.times do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+        assert_response :success
+      end
+    end
+  end
+
+  test "creator account and comment cannot be supplied by the client" do
+    post card_comment_reactions_path(@card, @comment), params: {
+      reaction: { content: "👍", creator_id: users(:mike).id, account_id: accounts(:initech).id, comment_id: comments(:layout_overflowing_david).id }
+    }, as: :turbo_stream
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment, reaction.comment
+  end
+
+  test "invalid content keeps the form open with validation errors" do
+    [ "", "   ", "x" * 17 ].each do |content|
+      assert_no_difference -> { @comment.reactions.count } do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+
+      assert_response :unprocessable_entity
+      assert_turbo_stream status: :unprocessable_entity, action: :replace, target: dom_id(@comment, :new_reaction)
+      assert_select ".reaction__input[value=?]", content
+      assert_select "[role='alert']"
+      assert_select "turbo-stream[action='append']", count: 0
+    end
+  end
+
+  test "HTML submissions redirect to the comment" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }
+
+    assert_redirected_to card_path(@card, anchor: dom_id(@comment))
+
+    delete card_comment_reaction_path(@card, @comment, @comment.reactions.last)
+
+    assert_redirected_to card_path(@card, anchor: dom_id(@comment))
+  end
+
+  test "invalid HTML submissions render the form" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "x" * 17 } }
+    end
+
+    assert_response :unprocessable_entity
+    assert_equal "text/html", response.media_type
+    assert_select ".reaction__input[value=?]", "x" * 17
+    assert_select "[role='alert']"
+  end
+
+  test "reaction content is escaped" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "<b>Hi!</b>" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_select ".reaction b", count: 0
