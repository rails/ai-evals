@@ -0,0 +1,29 @@
+<%= turbo_frame_tag comment, :new_reaction do %>
+  <%= form_with model: reaction, url: card_comment_reactions_path(comment.card, comment), class: "reaction reaction__form expanded",
+        data: { controller: "form morph-guard reaction-form", reaction_form_maximum_length_value: Reaction::MAX_CONTENT_LENGTH,
+                action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit keydown.esc->form#cancel:stop" } do |form| %>
+    <%= form.label :content, for: dom_id(comment, :reaction_content), class: "reaction__form-label" do %>
+      <%= avatar_preview_tag reaction.creator, class: "reaction__avatar", hidden_for_screen_reader: true %>
+      <span class="for-screen-reader">Your reaction (<%= Reaction::MAX_CONTENT_LENGTH %> characters max)</span>
+    <% end %>
+
+    <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "input reaction__input", required: true, maxlength: Reaction::MAX_CONTENT_LENGTH,
+          autocomplete: "off", autofocus: true, placeholder: "React…", aria: { describedby: reaction.errors.any? ? dom_id(comment, :reaction_errors) : nil },
+          data: { form_target: "input", reaction_form_target: "input",
+                  action: "input->reaction-form#limitLength compositionstart->form#compositionStart compositionend->reaction-form#limitLength compositionend->form#compositionEnd" } %>
+
+    <%= form.button class: "btn btn--plain reaction__submit-btn" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_path(comment.card, comment), class: "btn btn--plain reaction__cancel-btn", data: { form_target: "cancel" } do %>
+      <%= icon_tag "remove" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    <% end %>
+  <% end %>
+
+  <% if reaction.errors.any? %>
+    <p id="<%= dom_id(comment, :reaction_errors) %>" class="txt-small txt-negative margin-none" role="alert"><%= reaction.errors.full_messages.to_sentence %></p>
+  <% end %>
+<% end %>
