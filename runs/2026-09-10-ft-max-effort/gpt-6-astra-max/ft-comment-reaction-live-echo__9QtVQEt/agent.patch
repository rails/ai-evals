+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comments must belong to the card in the URL" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "reactions must belong to the comment in the URL" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "👍", creator: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "reactions require authentication" do
+    sign_out
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "another account cannot be used to create a reaction" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment, script_name: accounts(:initech).slug),
+        params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "losing card access also prevents removing your reactions" do
+    reaction = @comment.reactions.create!(content: "👍", creator: users(:kevin))
+    accesses(:writebook_kevin).destroy!
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "inaccessible cards cannot be reacted to" do
+    accesses(:writebook_kevin).destroy!
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+end
