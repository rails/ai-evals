diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..97eaae9
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "defaults to the comment's account and the current creator" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal @comment.account, reaction.account
+    assert_equal Current.user, reaction.creator
+  end
+
+  test "requires content of at most 16 characters" do
+    [ nil, "", "   ", "x" * 17, "🎉" * 17 ].each do |content|
+      reaction = @comment.reactions.build(content: content)
+      assert_not reaction.valid?, "Expected #{content.inspect} to be invalid"
+      assert reaction.errors[:content].any?
+    end
+
+    [ "👍", "Nice work! 🎉", "x" * 16, "🎉" * 16 ].each do |content|
+      reaction = @comment.reactions.create!(content: content)
+      assert_equal content, reaction.reload.content
+    end
+  end
+
+  test "comments preload reactions and their creators" do
+    @comment.reactions.create!(content: "👍")
+    comment = Comment.preloaded.find(@comment.id)
+
+    assert_predicate comment.association(:reactions), :loaded?
+    assert_predicate comment.reactions.first.association(:creator), :loaded?
+    assert_predicate comment.reactions.first.creator.association(:account), :loaded?
+  end
+
+  test "reactions are shown chronologically" do
+    recent = @comment.reactions.create!(content: "Second")
+    older = @comment.reactions.create!(content: "First", created_at: 1.minute.ago)
+
+    assert_equal [ older, recent ], @comment.reactions.reload
+  end
+
+  test "creating and destroying a reaction invalidate the cached comment" do
+    reaction = nil
+
+    assert_changes -> { @comment.reload.updated_at } do
+      reaction = @comment.reactions.create!(content: "👍")
+    end
+
+    travel 1.second do
+      assert_changes -> { @comment.reload.updated_at } do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "destroying a comment also destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroying a creator also destroys their reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "creation broadcasts to card viewers without a current user" do
+    reaction = @comment.reactions.create!(content: "👍")
+    Current.user = nil
+
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "append", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(@comment, :reactions), broadcasts.first["target"]
+    assert_includes broadcasts.first.to_s, ActionView::RecordIdentifier.dom_id(reaction)
+    assert_includes broadcasts.first.to_s, "#{@comment.account.slug}/cards/#{@comment.card.number}/comments/#{@comment.id}/reactions/#{reaction.id}"
+  end
+
+  test "destruction broadcasts a removal to card viewers" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      reaction.destroy!
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "remove", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), broadcasts.first["target"]
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..adb0dda
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,181 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@comment.card)
+  end
+
+  test "add, cancel, confirm again, and remove your own reactions" do
+    within_comment do
+      click_on "Add a reaction"
+      assert_selector ".reaction__input:focus"
+      assert_no_selector ".reactions__trigger"
+      fill_in "Your reaction", with: "Great work!"
+      click_on "Confirm reaction"
+
+      assert_selector ".reactions__list .reaction", text: "Great work!", count: 1
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Never mind"
+      click_on "Cancel reaction"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+      assert_no_text "Never mind"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Thanks!"
+      find(".reaction__input").send_keys :enter
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_no_selector ".reaction__input"
+
+      within ".reaction", text: "Great work!" do
+        assert_no_button "Remove reaction"
+        find("[data-reaction-target='toggle']").click
+        click_on "Remove reaction"
+      end
+
+      assert_no_selector ".reactions__list .reaction", text: "Great work!"
+      assert_selector ".reactions__list .reaction", text: "Thanks!", count: 1
+    end
+
+    page.refresh
+    within_comment do
+      assert_selector ".reactions__list .reaction", text: "Thanks!", count: 1
+    end
+  end
+
+  test "escape cancels a reaction without posting it" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Never mind"
+      find(".reaction__input").send_keys :escape
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reactions__list .reaction"
+    end
+  end
+
+  test "blank reactions cannot be confirmed and text is limited to 16 characters" do
+    within_comment do
+      click_on "Add a reaction"
+      click_on "Confirm reaction"
+      assert_selector ".reaction__input"
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Your reaction", with: "   "
+      click_on "Confirm reaction"
+      assert_selector ".reaction__input"
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Your reaction", with: "12345678901234567"
+      assert_field "Your reaction", with: "1234567890123456"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "1234567890123456", count: 1
+    end
+  end
+
+  test "emoji use the same 16 character limit as text" do
+    within_comment do
+      click_on "Add a reaction"
+      find(".reaction__input").click
+      page.driver.browser.execute_cdp("Input.insertText", text: "🎉" * 16)
+
+      assert_field "Your reaction", with: "🎉" * 16
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "🎉" * 16, count: 1
+    end
+  end
+
+  test "live reactions preserve an open form and only authors can reveal removal" do
+    wait_for_cable_subscriptions
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Still typing"
+    end
+
+    reaction = @comment.reactions.create!(content: "🎉", creator: users(:david))
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+
+    within_comment do
+      within "##{dom_id(reaction)}" do
+        assert_selector "[title='David']"
+        find("[data-reaction-target='toggle']").click
+        assert_no_button "Remove reaction"
+      end
+
+      assert_field "Your reaction", with: "Still typing"
+      assert_no_selector ".reactions__trigger"
+    end
+
+    reaction.destroy!
+
+    within_comment do
+      assert_no_selector "##{dom_id(reaction)}"
+      assert_field "Your reaction", with: "Still typing"
+    end
+  end
+
+  test "your reactions remain removable by keyboard after a card refresh" do
+    wait_for_cable_subscriptions
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    assert_selector "##{dom_id(reaction)}"
+
+    Current.user = users(:david)
+    @comment.card.update!(title: "Retitled elsewhere")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    assert_selector "h1", text: "Retitled elsewhere"
+
+    within "##{dom_id(reaction)}" do
+      toggle = find("[data-reaction-target='toggle'][role='button'][tabindex='0']")
+      toggle.send_keys :enter
+      assert_button "Remove reaction"
+      toggle.send_keys :escape
+      assert_no_button "Remove reaction"
+      toggle.send_keys :space
+      click_on "Remove reaction"
+    end
+
+    assert_no_selector "##{dom_id(reaction)}"
+    within_comment { assert_selector ".reactions__trigger" }
+  end
+
+  test "broadcasting your reaction does not duplicate it or reset the next form" do
+    wait_for_cable_subscriptions
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Nice!"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "Nice!", count: 1
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Next one"
+    end
+
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+
+    within_comment do
+      assert_selector ".reactions__list .reaction", text: "Nice!", count: 1
+      assert_field "Your reaction", with: "Next one"
+    end
+  end
+
+  private
+    def within_comment(&block)
+      within "##{dom_id(@comment)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
