diff --git a/app/jobs/storage/reconcile_job.rb b/app/jobs/storage/reconcile_job.rb
new file mode 100644
index 0000000..a271aa5
--- /dev/null
+++ b/app/jobs/storage/reconcile_job.rb
@@ -0,0 +1,14 @@
+class Storage::ReconcileJob < ApplicationJob
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked
+
+  # Coalesce bursts of changes. Correctness comes from database checkpoints and
+  # locks, not the queue semaphore; the recurring sweep catches the final race
+  # between draining pending work and releasing the semaphore.
+  limits_concurrency to: 1, key: ->(account) { account }, on_conflict: :discard
+
+  def perform(account)
+    Storage::Entry.reconcile(account)
+  end
+end
