diff --git a/app/models/storage/attachment_scope.rb b/app/models/storage/attachment_scope.rb
new file mode 100644
index 0000000..099aad2
--- /dev/null
+++ b/app/models/storage/attachment_scope.rb
@@ -0,0 +1,76 @@
+# All four counted attachment locations. Keep the joins separate so each path
+# uses its foreign-key indexes, including when reconciling just a few attachments
+# in an account with millions of them. Blobs are counted once per attachment.
+class Storage::AttachmentScope
+  def initialize(account)
+    @account = account
+  end
+
+  def each_batch(record = account)
+    scopes_for(record).each do |scope|
+      scope.in_batches(of: Storage::Entry::BATCH_SIZE) do |batch|
+        yield batch.pluck("active_storage_attachments.id")
+      end
+    end
+  end
+
+  def sizes_for(attachment_ids)
+    scopes_for(account).flat_map do |scope|
+      scope.where(id: attachment_ids).pluck("active_storage_attachments.id", "boards.id", "active_storage_blobs.byte_size")
+    end
+  end
+
+  private
+    attr_reader :account
+
+    def scopes_for(record)
+      card_scopes = [ card_images, card_embeds, comment_embeds ]
+
+      case record
+      when Card
+        card_scopes.map { |scope| scope.where(cards: { id: record.id }) }
+      when Board
+        [ board_embeds, *card_scopes ].map { |scope| scope.where(boards: { id: record.id }) }
+      when Account
+        [ board_embeds, *card_scopes ]
+      end
+    end
+
+    def card_images
+      on_card_board attachments.where(record_type: "Card", name: "image")
+        .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id")
+    end
+
+    def card_embeds
+      on_card_board embeds.where(action_text_rich_texts: { record_type: "Card", name: "description" })
+        .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id")
+    end
+
+    def comment_embeds
+      on_card_board embeds.where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+        .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+        .joins("INNER JOIN cards ON cards.id = comments.card_id")
+        .where(comments: { account_id: account.id })
+    end
+
+    def on_card_board(scope)
+      scope.joins("INNER JOIN boards ON boards.id = cards.board_id")
+        .where(cards: { account_id: account.id }, boards: { account_id: account.id })
+    end
+
+    def board_embeds
+      embeds.where(action_text_rich_texts: { record_type: "Board", name: "public_description" })
+        .joins("INNER JOIN boards ON boards.id = action_text_rich_texts.record_id")
+        .where(boards: { account_id: account.id })
+    end
+
+    def embeds
+      attachments.where(record_type: "ActionText::RichText", name: "embeds")
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .where(action_text_rich_texts: { account_id: account.id })
+    end
+
+    def attachments
+      ActiveStorage::Attachment.where(account: account).joins(:blob)
+    end
+end
diff --git a/app/models/storage/attachment_tracking.rb b/app/models/storage/attachment_tracking.rb
new file mode 100644
index 0000000..66d2139
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,23 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_save :track_storage_change
+    after_destroy :track_storage_change
+  end
+
+  # Active Storage's purge, purge_later, and detach call delete, not destroy.
+  def delete
+    transaction do
+      super.tap { track_storage_change }
+    end
+  end
+
+  private
+    def track_storage_change
+      if (record_type == "Card" && name == "image") || (record_type == "ActionText::RichText" && name == "embeds")
+        Storage::Entry.mark_pending([ id ], account_id: account_id)
+        account.reconcile_storage_later
+      end
+    end
+end
diff --git a/app/models/storage/detach_many_tracking.rb b/app/models/storage/detach_many_tracking.rb
new file mode 100644
index 0000000..c1ce3d0
--- /dev/null
+++ b/app/models/storage/detach_many_tracking.rb
@@ -0,0 +1,16 @@
+module Storage::DetachManyTracking
+  def detach
+    # Unlike individual detach/purge, detach-many uses delete_all and skips the
+    # attachment callbacks. Mark its rows before that bulk deletion, atomically.
+    if record.is_a?(ActionText::RichText) && name == "embeds" && attachments.respond_to?(:in_batches)
+      Storage::Entry.transaction do
+        attachments.in_batches(of: Storage::Entry::BATCH_SIZE) do |batch|
+          Storage::Entry.mark_pending(batch.pluck(:id), account_id: record.account_id)
+        end
+        super.tap { record.account.reconcile_storage_later }
+      end
+    else
+      super
+    end
+  end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..79969fd
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,109 @@
+# One accounting checkpoint per attachment, using the Active Storage attachment's
+# ID as our ID. Requests only mark checkpoints pending, in the same transaction as
+# the attachment change. No hot account/board counter is written by the request.
+#
+# Workers compare current attachments with these checkpoints, rather than replay
+# add/remove events. Retries, duplicate jobs, and out-of-order card moves are safe.
+class Storage::Entry < ApplicationRecord
+  BATCH_SIZE = 1_000
+
+  belongs_to :account
+  belongs_to :board, optional: true
+
+  scope :pending, -> { where(pending: true) }
+
+  class << self
+    def mark_pending(attachment_ids, account_id:)
+      if attachment_ids.any?
+        upsert_all(attachment_ids.map { |id| { id: id, account_id: account_id, pending: true } }, update_only: [ :pending ])
+      end
+    end
+
+    def refresh(record)
+      previously_tracked(record).in_batches(of: BATCH_SIZE) { |batch| batch.update_all(pending: true) }
+      track_all(record)
+      record.account.reconcile_storage_later
+    end
+
+    def reconcile(account)
+      total = Storage::Total.for(account)
+
+      unless total.initialized_at?
+        track_all(account)
+        total.update!(initialized_at: Time.current)
+      end
+
+      while reconcile_batch(account, total)
+        # Release locks between batches, including while the account is busy.
+      end
+    end
+
+    # Also bootstraps pre-existing accounts. Pending rows are a durable outbox:
+    # this sweep recovers an enqueue failure or a notification discarded while
+    # another worker was finishing the same account.
+    def reconcile_pending_later
+      initialized_accounts = Storage::Total.where(record_type: "Account").where.not(initialized_at: nil).select(:record_id)
+      Account.where.not(id: initialized_accounts).or(Account.where(id: pending.select(:account_id))).find_each do |account|
+        account.reconcile_storage_later
+      end
+    end
+
+    private
+      def previously_tracked(record)
+        case record
+        when Account then where(account: record)
+        when Board then where(account: record.account, board: record)
+        else none
+        end
+      end
+
+      def track_all(record)
+        Storage::AttachmentScope.new(record.account).each_batch(record) do |ids|
+          mark_pending(ids, account_id: record.account.id)
+        end
+      end
+
+      def reconcile_batch(account, total)
+        # Select candidates outside the transaction, then lock just their primary
+        # keys. Locking the pending index range would gap-lock new uploads on
+        # MySQL. Read source attachments only AFTER acquiring the checkpoint locks
+        # so a concurrent change is either counted here or remains pending.
+        ids = pending.where(account: account).order(:id).limit(BATCH_SIZE).pluck(:id)
+
+        if ids.any?
+          total.with_lock do
+            entries = where(id: ids).order(:id).lock.select(&:pending?)
+
+            if entries.any?
+              sizes = Storage::AttachmentScope.new(account).sizes_for(entries.map(&:id))
+              apply_deltas(account, total, entries, sizes)
+              checkpoint(account, entries, sizes)
+            end
+          end
+          true
+        else
+          false
+        end
+      end
+
+      def apply_deltas(account, total, entries, sizes)
+        deltas = Hash.new(0)
+        entries.each { |entry| deltas[entry.board_id] -= entry.byte_size if entry.board_id }
+        sizes.each { |id, board_id, byte_size| deltas[board_id] += byte_size }
+        deltas.reject! { |board_id, delta| delta.zero? }
+
+        Storage::Total.apply_board_deltas(account, deltas)
+        total.update!(bytes_used: total.bytes_used + deltas.values.sum)
+      end
+
+      def checkpoint(account, entries, sizes)
+        if sizes.any?
+          upsert_all(sizes.map do |id, board_id, byte_size|
+            { id: id, account_id: account.id, board_id: board_id, byte_size: byte_size, pending: false }
+          end, update_only: [ :board_id, :byte_size, :pending ])
+        end
+
+        where(id: entries.map(&:id) - sizes.map(&:first)).delete_all
+      end
+  end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..aa60bf6
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,23 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :account
+  belongs_to :record, polymorphic: true
+
+  def self.for(record)
+    find_or_create_by!(record: record) { |total| total.account = record.account }
+  end
+
+  def self.apply_board_deltas(account, deltas)
+    # A deleted board must not get a new total. Its old bytes are still deducted
+    # from the account by the reconciler.
+    board_ids = account.boards.where(id: deltas.keys).pluck(:id)
+    if board_ids.any?
+      insert_all(board_ids.map do |board_id|
+        { id: ActiveRecord::Type::Uuid.generate, account_id: account.id, record_type: "Board", record_id: board_id }
+      end)
+    end
+
+    deltas.sort.each do |board_id, delta|
+      where(account: account, record_type: "Board", record_id: board_id).update_counters(bytes_used: delta)
+    end
+  end
+end
