diff --git a/app/jobs/storage/reconcile_job.rb b/app/jobs/storage/reconcile_job.rb
new file mode 100644
index 0000000..274f1a5
--- /dev/null
+++ b/app/jobs/storage/reconcile_job.rb
@@ -0,0 +1,27 @@
+# Initial backfill and periodic repair (including bulk imports/deletions that skip
+# callbacks). Work is resumable and never loads attachment contents into memory.
+class Storage::ReconcileJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, wait: :polynomially_longer
+
+  def perform(account = nil)
+    step :entries do |step|
+      Storage::Entry.invalidate_all(account: account, start: step.cursor) do |id|
+        step.set! id
+      end
+    end
+
+    step :attachments do |step|
+      scope = account ? ActiveStorage::Attachment.where(account: account) : ActiveStorage::Attachment.all
+      missing = Storage::Attachments.new(scope).all.where.not(id: Storage::Entry.select(:id))
+      Storage::Entry.invalidate_attachments(missing, start: step.cursor) do |id|
+        step.set! id
+      end
+    end
+
+    Storage::Entry.reconcile_later(account: account)
+  end
+end
diff --git a/app/jobs/storage/update_job.rb b/app/jobs/storage/update_job.rb
