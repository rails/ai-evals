--- /dev/null
+++ b/app/jobs/storage/update_job.rb
@@ -0,0 +1,12 @@
+class Storage::UpdateJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError, ActiveRecord::RecordNotFound
+  retry_on ActiveRecord::Deadlocked, wait: :polynomially_longer
+
+  limits_concurrency to: 1, key: ->(account, shard) { "#{account.id}/#{shard}" }, on_conflict: :discard
+
+  def perform(account, shard)
+    Storage::Entry.reconcile(account, shard)
+  end
+end
