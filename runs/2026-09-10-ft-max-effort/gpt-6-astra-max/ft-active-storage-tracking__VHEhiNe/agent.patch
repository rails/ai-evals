+++ b/app/models/card/storage_tracked.rb
@@ -0,0 +1,15 @@
+module Card::StorageTracked
+  extend ActiveSupport::Concern
+
+  included do
+    # Run inside the move transaction, before handle_board_change's nested save
+    # clears saved_changes. Include comments, even when no attachment was edited.
+    after_update :invalidate_moved_storage, if: :saved_change_to_board_id?
+  end
+
+  private
+    def invalidate_moved_storage
+      attachments = Storage::Attachments.new.on_card(self)
+      Storage::Entry.where(id: attachments.select(:id)).update_all(dirty: true)
+    end
+end
