diff --git a/app/models/storage/attachments.rb b/app/models/storage/attachments.rb
new file mode 100644
index 0000000..e275607
--- /dev/null
+++ b/app/models/storage/attachments.rb
@@ -0,0 +1,64 @@
+# Only original attachments in these four locations count. These queries deliberately
+# never load rich text bodies, blobs, or lists of all the cards/comments on a board.
+class Storage::Attachments
+  def initialize(scope = ActiveStorage::Attachment.all)
+    @scope = scope
+  end
+
+  def all
+    matching(card_images, board_descriptions, card_descriptions, comment_bodies)
+  end
+
+  def on_card(card)
+    matching(*[ card_images, card_descriptions, comment_bodies ].map { |relation| relation.where(cards: { id: card.id }) })
+  end
+
+  def usage
+    [ card_images, board_descriptions, card_descriptions, comment_bodies ].each_with_object({}) do |relation, usage|
+      relation.joins(:blob).pluck("active_storage_attachments.id", "boards.id", "active_storage_blobs.byte_size").each do |id, board_id, byte_size|
+        usage[id] = [ board_id, byte_size ]
+      end
+    end
+  end
+
+  private
+    attr_reader :scope
+
+    def matching(*relations)
+      relations.map { |relation| scope.where(id: relation.select("active_storage_attachments.id")) }.reduce(:or)
+    end
+
+    def card_images
+      scope.where(record_type: "Card", name: "image")
+        .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id AND cards.account_id = active_storage_attachments.account_id")
+        .joins(cards_board_join)
+    end
+
+    def board_descriptions
+      embeds("Board", "public_description")
+        .joins("INNER JOIN boards ON boards.id = action_text_rich_texts.record_id AND boards.account_id = active_storage_attachments.account_id")
+    end
+
+    def card_descriptions
+      embeds("Card", "description")
+        .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id AND cards.account_id = active_storage_attachments.account_id")
+        .joins(cards_board_join)
+    end
+
+    def comment_bodies
+      embeds("Comment", "body")
+        .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id AND comments.account_id = active_storage_attachments.account_id")
+        .joins("INNER JOIN cards ON cards.id = comments.card_id AND cards.account_id = comments.account_id")
+        .joins(cards_board_join)
+    end
+
+    def embeds(record_type, name)
+      scope.where(record_type: "ActionText::RichText", name: "embeds")
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id AND action_text_rich_texts.account_id = active_storage_attachments.account_id")
+        .where(action_text_rich_texts: { record_type: record_type, name: name })
+    end
+
+    def cards_board_join
+      "INNER JOIN boards ON boards.id = cards.board_id AND boards.account_id = cards.account_id"
+    end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..835c36b
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,109 @@
+# A durable, coalescing work list and the last accounted state of each attachment.
+# Invalidation and attachment changes share a transaction. Reconciliation locks
+# entries before reading attachments, and commits snapshots and totals together.
+class Storage::Entry < ApplicationRecord
+  SHARD_COUNT = 16
+  BATCH_SIZE = 100
+  MAX_BATCHES = 100
+
+  belongs_to :account
+
+  scope :pending, -> { where(dirty: true) }
+
+  class << self
+    def invalidate_attachment(attachment)
+      upsert_all([ attributes_for(attachment) ], update_only: [ :dirty ])
+    end
+
+    def invalidate_attachments(attachments, start: nil)
+      attachments.select(:id, :account_id).find_in_batches(start: start) do |batch|
+        upsert_all(batch.map { |attachment| attributes_for(attachment) }, update_only: [ :dirty ])
+        yield batch.last.id if block_given?
+      end
+    end
+
+    def invalidate_all(account: nil, start: nil)
+      entries = account ? where(account: account) : all
+      entries.select(:id).find_in_batches(start: start) do |batch|
+        where(id: batch.map(&:id)).update_all(dirty: true)
+        yield batch.last.id if block_given?
+      end
+    end
+
+    def reconcile_later(account: nil)
+      accounts = account ? Account.where(id: account.id) : Account.all
+      accounts.where(id: pending.distinct.select(:account_id)).find_each do |account|
+        Current.with_account(account) do
+          pending.where(account: account).distinct.pluck(:shard).each do |shard|
+            Storage::UpdateJob.perform_later(account, shard)
+          end
+        end
+      end
+    end
+
+    def reconcile(account, shard)
+      entries = pending.where(account: account, shard: shard)
+      if entries.exists?
+        total = Storage::Total.for(account, account, shard)
+
+        # Bound each job as well as each transaction. The next sweep picks up any
+        # remainder, so a constantly busy account cannot monopolize a worker.
+        cursor = nil
+        MAX_BATCHES.times do
+          cursor = reconcile_batch(entries, total, after: cursor)
+          break unless cursor
+        end
+      end
+    end
+
+    private
+      def attributes_for(attachment)
+        { id: attachment.id, account_id: attachment.account_id, shard: attachment.id.to_i(36) % SHARD_COUNT, dirty: true }
+      end
+
+      def reconcile_batch(entries, total, after:)
+        entries = entries.where(id: after..).where.not(id: after) if after
+        uncached do
+          total.with_lock do
+            batch = entries.order(:id).limit(BATCH_SIZE).lock.to_a
+            if batch.any?
+              reconcile_entries(batch, total)
+              batch.last.id
+            else
+              # A worker may have started creating this shard as the account was deleted.
+              total.destroy! unless Account.exists?(total.account_id)
+              nil
+            end
+          end
+        end
+      end
+
+      def reconcile_entries(batch, total)
+        attachments = ActiveStorage::Attachment.where(account_id: total.account_id, id: batch.map(&:id))
+        usage = Storage::Attachments.new(attachments).usage
+        deltas = Hash.new(0)
+        snapshots = []
+        removed_ids = []
+
+        batch.each do |entry|
+          deltas[entry.board_id] -= entry.byte_size if entry.board_id
+
+          if current = usage[entry.id]
+            board_id, byte_size = current
+            deltas[board_id] += byte_size
+            snapshots << entry.attributes.merge("board_id" => board_id, "byte_size" => byte_size, "dirty" => false)
+          else
+            removed_ids << entry.id
+          end
+        end
+
+        deltas.sort.each do |board_id, delta|
+          Storage::Total.adjust_board(total.account, board_id, total.shard, delta)
+        end
+        total.increment!(:bytes_used, deltas.values.sum) unless deltas.values.sum.zero?
+
+        upsert_all(snapshots, update_only: [ :board_id, :byte_size, :dirty ]) if snapshots.any?
+        where(id: removed_ids).delete_all if removed_ids.any?
+      end
+  end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..b2b4dae
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,18 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :account
+  belongs_to :record, polymorphic: true
+
+  def self.for(account, record, shard)
+    find_or_create_by!(account: account, record: record, shard: shard)
+  end
+
+  # The account's corresponding shard is always locked before changing a board's
+  # shard. This also serializes concurrent workers without locking Account/Board.
+  def self.adjust_board(account, board_id, shard, delta)
+    if delta != 0
+      total = find_or_create_by!(account: account, record_type: "Board", record_id: board_id, shard: shard)
+      total.increment!(:bytes_used, delta)
+      total.destroy! if total.bytes_used.zero?
+    end
+  end
+end
diff --git a/app/models/storage/tracked_attachment.rb b/app/models/storage/tracked_attachment.rb
new file mode 100644
index 0000000..1e6df99
--- /dev/null
+++ b/app/models/storage/tracked_attachment.rb
@@ -0,0 +1,26 @@
+module Storage::TrackedAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :invalidate_storage_entry
+    after_destroy :invalidate_storage_entry, if: :previously_persisted?
+  end
+
+  # Active Storage's purge, purge_later and singular detach use delete, not destroy.
+  def delete
+    if persisted?
+      transaction do
+        super.tap { invalidate_storage_entry }
+      end
+    else
+      super
+    end
+  end
+
+  private
+    def invalidate_storage_entry
+      if (record_type == "Card" && name == "image") || (record_type == "ActionText::RichText" && name == "embeds")
+        Storage::Entry.invalidate_attachment(self)
+      end
+    end
+end
diff --git a/app/models/storage/tracked_embeds.rb b/app/models/storage/tracked_embeds.rb
