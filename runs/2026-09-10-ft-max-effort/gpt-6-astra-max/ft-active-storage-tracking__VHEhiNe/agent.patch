diff --git a/app/models/account/storage_tracked.rb b/app/models/account/storage_tracked.rb
new file mode 100644
index 0000000..aaeef91
--- /dev/null
+++ b/app/models/account/storage_tracked.rb
@@ -0,0 +1,27 @@
+module Account::StorageTracked
+  extend ActiveSupport::Concern
+  include Storage::Usage
+
+  included do
+    before_destroy :lock_storage_accounting, prepend: true
+    after_destroy :delete_storage_accounting
+  end
+
+  def reconcile_storage_later
+    Current.with_account(self) { Storage::ReconcileJob.perform_later(self) }
+  end
+
+  private
+    def lock_storage_accounting
+      # Lock before dependent destroys invalidate attachments, matching workers'
+      # total -> entry lock order. Include shards not yet used by a worker.
+      Storage::Entry::SHARD_COUNT.times do |shard|
+        Storage::Total.for(self, self, shard).lock!
+      end
+    end
+
+    def delete_storage_accounting
+      Storage::Entry.where(account_id: id).delete_all
+      Storage::Total.where(account_id: id).delete_all
+    end
+end
