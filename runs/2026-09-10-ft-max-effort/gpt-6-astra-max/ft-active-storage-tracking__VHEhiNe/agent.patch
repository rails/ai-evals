index 0000000..9de5c28
--- /dev/null
+++ b/app/models/storage/tracked_embeds.rb
@@ -0,0 +1,13 @@
+module Storage::TrackedEmbeds
+  # Plural detach uses delete_all, bypassing attachment callbacks altogether.
+  def detach
+    if record.is_a?(ActionText::RichText) && name == "embeds"
+      record.class.transaction do
+        Storage::Entry.invalidate_attachments(record.embeds_attachments)
+        super
+      end
+    else
+      super
+    end
+  end
+end
