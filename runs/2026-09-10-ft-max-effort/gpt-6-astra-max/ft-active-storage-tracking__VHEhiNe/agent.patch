diff --git a/test/models/storage/usage_test.rb b/test/models/storage/usage_test.rb
new file mode 100644
index 0000000..784cfa7
--- /dev/null
+++ b/test/models/storage/usage_test.rb
@@ -0,0 +1,511 @@
+require "test_helper"
+
+class Storage::UsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "empty accounts and boards use no storage" do
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts card images and files in board descriptions, card descriptions, and comments" do
+    @card.image.attach blob(10)
+    @board.update!(public_description: embed(blob(20)))
+    @card.update!(description: embed(blob(30)))
+    @card.comments.create!(body: embed(blob(40)))
+
+    update_usage
+
+    assert_equal 100, @board.bytes_used
+    assert_equal 100, @account.bytes_used
+  end
+
+  test "usage is updated in the background without memoizing reads" do
+    assert_equal 0, @board.bytes_used
+    @card.image.attach blob(10)
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    update_usage
+    assert_equal 10, @board.bytes_used
+    assert_equal 10, @account.bytes_used
+  end
+
+  test "rolls up multiple boards and keeps accounts isolated" do
+    @card.image.attach blob(10)
+    boards(:private).update!(public_description: embed(blob(20)))
+    other = boards(:miltons_wish_list)
+    Current.with_account(other.account) do
+      other.update!(public_description: embed(blob(30)))
+    end
+
+    update_usage
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 20, boards(:private).bytes_used
+    assert_equal 30, @account.bytes_used
+    assert_equal 30, other.bytes_used
+    assert_equal 30, other.account.bytes_used
+    assert_equal 0, accounts(:acme).bytes_used
+  end
+
+  test "does not count avatars, exports, imports, variants, previews, or unattached blobs" do
+    users(:david).avatar.attach blob(10)
+    export = Account::Export.create!(account: @account, user: users(:david))
+    export.file.attach blob(20)
+    import = Account::Import.create!(account: @account, identity: identities(:david))
+    import.file.attach blob(30)
+    original = blob(40)
+    original.preview_image.attach blob(50)
+    original.variant_records.create!(variation_digest: "test").image.attach blob(60)
+    blob(70)
+
+    update_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "only the specified attachment names and rich text fields count" do
+    ActiveStorage::Attachment.create!(record: @card, name: "other", blob: blob(10))
+    other_text = ActionText::RichText.create!(record: @card, name: "other", body: embed(blob(20)))
+    @card.update!(description: "No files")
+    ActiveStorage::Attachment.create!(record: @card.description, name: "other", blob: blob(30))
+
+    update_usage
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+    assert_empty Storage::Entry.where(id: other_text.embeds_attachments.select(:id))
+  end
+
+  test "counts original attachments but not their generated files" do
+    original = blob(10)
+    @card.image.attach original
+    original.preview_image.attach blob(20)
+    original.variant_records.create!(variation_digest: "test").image.attach blob(30)
+
+    update_usage
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 10, @account.bytes_used
+  end
+
+  test "counts draft and closed cards" do
+    draft = @board.cards.create!
+    draft.image.attach blob(10)
+    cards(:shipping).update!(description: embed(blob(20)))
+
+    update_usage
+
+    assert_equal 30, @board.bytes_used
+    assert_equal 30, @account.bytes_used
+  end
+
+  test "counts each attachment once, including equal sized and reused blobs" do
+    reused = blob(10)
+    @card.image.attach reused
+    @card.update!(description: embed(reused) + embed(reused) + embed(blob(10)))
+    @card.comments.create!(body: embed(reused))
+
+    update_usage
+
+    assert_equal 40, @board.bytes_used
+    assert_equal 40, @account.bytes_used
+  end
+
+  test "replaces images and removes embedded files" do
+    @card.image.attach blob(10)
+    @card.update!(description: embed(blob(20)))
+    @board.update!(public_description: embed(blob(30)))
+    comment = @card.comments.create!(body: embed(blob(40)))
+    update_usage
+
+    @card.image.attach blob(50)
+    @card.update!(description: "No files")
+    @board.update!(public_description: "No files")
+    comment.update!(body: "No files")
+    update_usage
+
+    assert_equal 50, @board.bytes_used
+    assert_equal 50, @account.bytes_used
+  end
+
+  test "purging an image updates usage even though Active Storage skips destroy callbacks" do
+    @card.image.attach blob(10)
+    update_usage
+
+    @card.image.purge
+    update_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "purge later removes usage before the blob is purged" do
+    @card.image.attach blob(10)
+    original = @card.image.blob
+    update_usage
+
+    @card.image.purge_later
+    update_usage
+
+    assert ActiveStorage::Blob.exists?(original.id)
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "detaching images and embeds updates usage without deleting blobs" do
+    @card.image.attach blob(10)
+    @card.update!(description: embed(blob(20)))
+    update_usage
+
+    assert_no_difference "ActiveStorage::Blob.count" do
+      @card.image.detach
+      @card.description.embeds.detach
+      update_usage
+    end
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "coalesces attachment creation and deletion before reconciliation" do
+    @card.image.attach blob(10)
+    @card.image.purge_later
+    @card.image.attach blob(20)
+
+    update_usage
+
+    assert_equal 20, @board.bytes_used
+    assert_equal 20, @account.bytes_used
+  end
+
+  test "moves images, descriptions, and comments to the new board" do
+    @card.image.attach blob(10)
+    @card.update!(description: embed(blob(20)))
+    @card.comments.create!(body: embed(blob(30)))
+    @board.update!(public_description: embed(blob(40)))
+    update_usage
+
+    @card.move_to(boards(:private))
+    update_usage
+
+    assert_equal 40, @board.bytes_used
+    assert_equal 60, boards(:private).bytes_used
+    assert_equal 100, @account.bytes_used
+  end
+
+  test "a move and edits before reconciliation use the latest board and attachments" do
+    @card.image.attach blob(10)
+    comment = @card.comments.create!(body: embed(blob(20)))
+    update_usage
+
+    @card.move_to(boards(:private))
+    comment.update!(body: embed(blob(30)))
+    @card.image.purge_later
+    @card.update!(description: embed(blob(40)))
+    update_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 70, boards(:private).bytes_used
+    assert_equal 70, @account.bytes_used
+  end
+
+  test "moves attachments that have not yet been counted" do
+    @card.image.attach blob(10)
+    @card.comments.create!(body: embed(blob(20)))
+    @card.move_to(boards(:private))
+    update_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 30, boards(:private).bytes_used
+    assert_equal 30, @account.bytes_used
+  end
+
+  test "deleting comments and cards removes their usage" do
+    @card.image.attach blob(10)
+    @card.update!(description: embed(blob(20)))
+    comment = @card.comments.create!(body: embed(blob(30)))
+    @board.update!(public_description: embed(blob(40)))
+    update_usage
+
+    comment.destroy!
+    update_usage
+    assert_equal 70, @board.bytes_used
+
+    @card.comments.create!(body: embed(blob(50)))
+    update_usage
+    @card.destroy!
+    update_usage
+
+    assert_equal 40, @board.bytes_used
+    assert_equal 40, @account.bytes_used
+  end
+
+  test "deleting a board removes its entire usage from the account" do
+    @card.image.attach blob(10)
+    @card.comments.create!(body: embed(blob(20)))
+    @board.update!(public_description: embed(blob(30)))
+    boards(:private).update!(public_description: embed(blob(40)))
+    update_usage
+
+    @board.destroy!
+    update_usage
+
+    assert_equal 40, @account.bytes_used
+    assert_empty Storage::Total.where(record: @board)
+    assert_empty Storage::Entry.where(board_id: @board.id)
+  end
+
+  test "deleting an account cleans up both pending and accounted usage" do
+    @card.image.attach blob(10)
+    update_usage
+    @board.update!(public_description: embed(blob(20)))
+    Storage::Entry.reconcile_later
+
+    @account.destroy!
+    perform_enqueued_jobs(only: Storage::UpdateJob)
+
+    assert_empty Storage::Total.where(account_id: @account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "rolled back attachment changes and moves do not change usage" do
+    @card.image.attach blob(10)
+    update_usage
+
+    Card.transaction(requires_new: true) do
+      @card.move_to(boards(:private))
+      @card.image.purge_later
+      @card.update!(description: embed(blob(20)))
+      raise ActiveRecord::Rollback
+    end
+    update_usage
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 0, boards(:private).bytes_used
+    assert_equal 10, @account.bytes_used
+  end
+
+  test "reconciliation and repeated jobs are idempotent" do
+    @card.image.attach blob(10)
+    update_usage
+    entry = Storage::Entry.first
+
+    2.times do
+      Storage::Entry.invalidate_attachment(@card.image.attachment)
+      Storage::UpdateJob.perform_now(@account, entry.shard)
+      Storage::UpdateJob.perform_now(@account, entry.shard)
+    end
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 10, @account.bytes_used
+  end
+
+  test "reconciliation backfills old attachments and repairs bulk deletions" do
+    @card.image.attach blob(10)
+    @card.update!(description: embed(blob(20)))
+    @card.comments.create!(body: embed(blob(30)))
+    @board.update!(public_description: embed(blob(40)))
+    Storage::Entry.delete_all # Simulate data present before storage accounting was installed.
+
+    perform_enqueued_jobs(only: Storage::UpdateJob) do
+      Storage::ReconcileJob.perform_now
+    end
+    assert_equal 100, @account.bytes_used
+    assert_equal 100, @board.bytes_used
+
+    ActiveStorage::Attachment.where(record: @card, name: "image").delete_all
+    perform_enqueued_jobs(only: Storage::UpdateJob) do
+      Storage::ReconcileJob.perform_now(@account)
+    end
+
+    assert_equal 90, @account.bytes_used
+    assert_equal 90, @board.bytes_used
+  end
+
+  test "supports byte counts larger than a signed 32 bit integer" do
+    original = ActiveStorage::Blob.create_before_direct_upload!(filename: "large.dat", byte_size: 5.terabytes, checksum: "test", content_type: "application/octet-stream", metadata: { identified: true, analyzed: true })
+    @card.image.attach original
+    update_usage
+
+    assert_equal 5.terabytes, @board.bytes_used
+    assert_equal 5.terabytes, @account.bytes_used
+  end
+
+  test "rollup failures leave totals and snapshots unchanged and preserve pending work" do
+    @card.image.attach blob(10)
+    entry = Storage::Entry.first
+    Storage::Entry.expects(:upsert_all).raises(RuntimeError, "interrupted")
+
+    assert_raises(RuntimeError) { Storage::Entry.reconcile(@account, entry.shard) }
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    assert entry.reload.dirty?
+    assert_equal 0, entry.byte_size
+
+    Storage::Entry.unstub(:upsert_all)
+    update_usage
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 10, @account.bytes_used
+    assert_not entry.reload.dirty?
+  end
+
+  test "reconciles large attachment collections in bounded batches" do
+    attachments = attach_in_shard(Storage::Entry::BATCH_SIZE + 1, 0)
+    Storage::Entry.invalidate_attachments(attachments)
+
+    stub_const(Storage::Entry, :MAX_BATCHES, 1) do
+      Storage::Entry.reconcile(@account, 0)
+      assert_equal Storage::Entry::BATCH_SIZE, @account.bytes_used
+      assert_equal 1, Storage::Entry.pending.count
+
+      Storage::Entry.reconcile(@account, 0)
+      assert_equal Storage::Entry::BATCH_SIZE + 1, @board.bytes_used
+      assert_equal Storage::Entry::BATCH_SIZE + 1, @account.bytes_used
+      assert_empty Storage::Entry.pending
+    end
+  end
+
+  test "concurrent invalidations and duplicate workers do not lose or duplicate usage" do
+    attachments = attach_in_shard(10, 0)
+    5.times.map do
+      Thread.new { Storage::Entry.invalidate_attachments(attachments) }
+    end.each(&:value)
+
+    assert_equal 10, Storage::Entry.pending.count
+
+    5.times.map do
+      Thread.new { Storage::Entry.reconcile(@account, 0) }
+    end.each(&:value)
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 10, @account.bytes_used
+    assert_empty Storage::Entry.pending
+  end
+
+  test "non attachment edits do not schedule recounts" do
+    @card.image.attach blob(10)
+    update_usage
+
+    @card.update!(title: "Changed title")
+    @card.comments.create!(body: "No attachments")
+    @board.update!(name: "Changed name")
+
+    assert_empty Storage::Entry.pending
+  end
+
+  test "reading usage only queries the small totals table" do
+    @card.image.attach blob(10)
+    update_usage
+    queries = []
+    subscriber = ->(_name, _start, _finish, _id, payload) { queries << payload[:sql] unless payload[:name] == "SCHEMA" }
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      assert_equal 10, @board.bytes_used
+      assert_equal 10, @account.bytes_used
+    end
+
+    assert_equal 2, queries.size
+    assert queries.all? { |sql| sql.include?("storage_totals") && sql.include?("SUM") }
+  end
+
+  test "account backfills carry the account context rather than the caller's account" do
+    @card.image.attach blob(10)
+    Storage::Entry.delete_all
+
+    Current.with_account(accounts(:initech)) { @account.reconcile_storage_later }
+    job = enqueued_jobs.find { |job| job[:job] == Storage::ReconcileJob }
+    assert_equal @account.to_gid.to_s, job["account"].to_s
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+    perform_enqueued_jobs(only: Storage::UpdateJob)
+
+    assert_equal 10, @account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "reconciliation of one account does not dirty another account's entries" do
+    @card.image.attach blob(10)
+    other = boards(:miltons_wish_list)
+    Current.with_account(other.account) { other.update!(public_description: embed(blob(20))) }
+    update_usage
+
+    Storage::ReconcileJob.perform_now(@account)
+
+    assert Storage::Entry.where(account: @account).pending.exists?
+    assert_empty Storage::Entry.where(account: other.account).pending
+  end
+
+  test "clearing rich text to empty or nil removes its embedded storage" do
+    @card.update!(description: embed(blob(10)))
+    @board.update!(public_description: embed(blob(20)))
+    comment = @card.comments.create!(body: embed(blob(30)))
+    update_usage
+
+    @card.update!(description: nil)
+    @board.update!(public_description: "")
+    comment.update!(body: "")
+    update_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "remote images do not count as stored files" do
+    @card.update!(description: '<action-text-attachment content-type="image/png" url="https://example.com/image.png"></action-text-attachment>')
+    update_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "discarding unsaved attachments does not create accounting entries" do
+    assert_no_difference "Storage::Entry.count" do
+      ActiveStorage::Attachment.new(record: @card, name: "image", blob: blob(10)).delete
+      ActiveStorage::Attachment.new(record: @card, name: "image", blob: blob(20)).destroy!
+    end
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  private
+    def attach_in_shard(count, shard)
+      @card.update!(description: "Files")
+      rows = count.times.map do
+        # Keep UUIDv7 ordering while assigning the random low bits to one shard.
+        id = (ActiveRecord::Type::Uuid.generate.to_i(36) & ~15 | shard).to_s(36).rjust(25, "0")
+        {
+          id: id, account_id: @account.id, record_type: "ActionText::RichText",
+          record_id: @card.description.id, name: "embeds", blob_id: blob(1).id, created_at: Time.current
+        }
+      end
+      ActiveStorage::Attachment.insert_all!(rows)
+      ActiveStorage::Attachment.where(id: rows.map { |row| row[:id] })
+    end
+
+    def blob(size)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * size), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def update_usage
+      perform_enqueued_jobs(only: Storage::UpdateJob) do
+        Storage::Entry.reconcile_later
+      end
+    end
+end
