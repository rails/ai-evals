+module Storage::Usage
+  # At most SHARD_COUNT rows, regardless of the number of boards or attachments.
+  # Don't memoize: a background worker may have updated usage since the last read.
+  def bytes_used
+    Storage::Total.where(record: self).sum(:bytes_used)
+  end
+end
