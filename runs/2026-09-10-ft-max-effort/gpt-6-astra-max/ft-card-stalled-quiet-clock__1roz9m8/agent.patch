diff --git a/test/integration/stalled_cards_test.rb b/test/integration/stalled_cards_test.rb
new file mode 100644
index 0000000..8d98aca
--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,235 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    freeze_time
+    @board = boards(:writebook)
+    @column = columns(:writebook_in_progress)
+    with_current_user(:kevin) do
+      @card = @board.cards.create!(title: "A stalled card", status: :published, column: @column)
+      @card.toggle_assignment(users(:david))
+    end
+  end
+
+  test "the stalled index filters HTML and JSON and can be combined with board filters" do
+    stall_card
+
+    get cards_path(indexed_by: :stalled, board_ids: [ @board.id ])
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "article.card--stalled .card__stalled", text: "Stalled"
+    assert_select "[data-combobox-value=stalled]", count: 1
+
+    get cards_path(indexed_by: :stalled, board_ids: [ @board.id ]), as: :json
+    assert_response :success
+    assert_equal [ @card.number ], response.parsed_body.pluck("number")
+    assert_equal true, response.parsed_body.sole["stalled"]
+
+    patch card_path(@card), params: { card: { description: "Work is underway again" } }, as: :json
+    assert_response :success
+    assert_equal false, response.parsed_body["stalled"]
+
+    get cards_path(indexed_by: :stalled), as: :json
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "the stalled index only returns accessible cards" do
+    with_current_user(:david) do
+      private_board = Board.create!(name: "Private", all_access: false)
+      private_card = private_board.cards.create!(title: "Private stalled card", status: :published)
+      private_card.toggle_assignment(users(:david))
+    end
+    Current.with_account(accounts(:initech)) do
+      with_current_user(:mike) { cards(:radio).toggle_assignment(users(:mike)) }
+    end
+    stall_card
+    assert_equal 3, Card.stalled.count
+
+    get cards_path(indexed_by: :stalled), as: :json
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+  end
+
+  test "private and public card displays show the stalled indicator" do
+    @board.publish
+    stall_card
+
+    [ card_path(@card), board_column_path(@board, @column),
+      public_board_card_path(@board.publication.key, @card),
+      public_board_column_path(@board.publication.key, @column) ].each do |path|
+      get path
+      assert_response :success
+      assert_select "#article_card_#{@card.id}.card--stalled .card__stalled", text: "Stalled"
+    end
+  end
+
+  test "card JSON reports false before stalling and true afterwards" do
+    get card_path(@card), as: :json
+    assert_response :success
+    assert_equal false, response.parsed_body["stalled"]
+
+    stall_card
+
+    get card_path(@card), as: :json
+    assert_response :success
+    assert_equal true, response.parsed_body["stalled"]
+  end
+
+  test "cached card previews are invalidated when a card stalls and when activity resumes" do
+    with_actionview_partial_caching do
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      stall_card
+
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled", count: 1
+
+      travel 1.second
+      patch card_path(@card), params: { card: { title: "Work has resumed" } }, as: :json
+      assert_response :success
+
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  test "column conditional requests are invalidated when a card stalls" do
+    get board_column_path(@board, @column)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    stall_card
+
+    get board_column_path(@board, @column), headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled", count: 1
+  end
+
+  test "removing a card image clears its stalled flag" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    stall_card
+
+    delete card_image_path(@card), as: :json
+    assert_response :no_content
+    assert_not @card.reload.stalled?
+    assert_equal Time.current, @card.last_active_at
+  end
+
+  test "search results show the stalled indicator" do
+    stall_card
+
+    get search_path(q: "stalled")
+    assert_response :success
+    assert_select ".search__result .card__stalled", text: "Stalled"
+  end
+
+  test "cached notifications reflect the current stalled state" do
+    notification = users(:kevin).notifications.create!(source: @card.events.last, creator: users(:david))
+
+    with_card_caching do
+      get tray_notifications_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+      etag = response.headers["ETag"]
+
+      stall_card
+
+      get tray_notifications_path, headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled", count: 1
+
+      get notifications_path, as: :json
+      assert_response :success
+      entry = response.parsed_body.find { |entry| entry["id"] == notification.id }
+      assert_equal true, entry.dig("card", "stalled")
+
+      travel 1.second
+      patch card_path(@card), params: { card: { description: "Working again" } }, as: :json
+      assert_response :success
+
+      get tray_notifications_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      get notifications_path, as: :json
+      assert_response :success
+      entry = response.parsed_body.find { |entry| entry["id"] == notification.id }
+      assert_equal false, entry.dig("card", "stalled")
+    end
+  end
+
+  test "cached timeline entries reflect the current stalled state" do
+    path = events_path(day: @card.created_at.to_date)
+
+    with_card_caching do
+      get path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+      etag = response.headers["ETag"]
+
+      stall_card
+
+      get path, headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select ".event .card__stalled", text: "Stalled", minimum: 1
+
+      travel 1.second
+      patch card_path(@card), params: { card: { description: "Working again" } }, as: :json
+      assert_response :success
+
+      get path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  test "cached card details and JSON reflect the current stalled state" do
+    with_card_caching do
+      get card_path(@card)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+      get card_path(@card), as: :json
+      assert_equal false, response.parsed_body["stalled"]
+
+      stall_card
+
+      get card_path(@card)
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled", count: 1
+      get card_path(@card), as: :json
+      assert_equal true, response.parsed_body["stalled"]
+
+      travel 1.second
+      patch card_path(@card), params: { card: { description: "Working again" } }, as: :json
+      assert_response :success
+      assert_equal false, response.parsed_body["stalled"]
+
+      get card_path(@card)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  private
+    def with_card_caching
+      original_cache_store, original_rails_cache = ApplicationController.cache_store, Rails.cache
+      with_actionview_partial_caching do
+        ApplicationController.cache_store = Rails.cache = ActionView::PartialRenderer.collection_cache
+        yield
+      end
+    ensure
+      ApplicationController.cache_store, Rails.cache = original_cache_store, original_rails_cache
+    end
+
+    def stall_card
+      travel 2.weeks
+      Card.stall_all_due
+      assert @card.reload.stalled?
+    end
+end
diff --git a/test/models/card/engageable_test.rb b/test/models/card/engageable_test.rb
new file mode 100644
index 0000000..c01ee38
--- /dev/null
+++ b/test/models/card/engageable_test.rb
@@ -0,0 +1,355 @@
+require "test_helper"
+
+class Card::EngageableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = boards(:writebook).cards.create!(title: "A burst that goes cold", status: :published)
+  end
+
+  test "a comment burst stalls after two quiet weeks and activity clears it" do
+    comment_by :david
+    comment_by :kevin
+    comment_by :david
+
+    assert @card.reload.bursty?
+    assert_not @card.stalled?
+    last_active_at = @card.last_active_at
+
+    travel 2.weeks - 1.second
+    Card.stall_all_due
+    assert_not @card.reload.stalled?
+
+    travel 1.second
+    Card.stall_all_due
+    assert @card.reload.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+    assert_equal last_active_at, @card.last_active_at
+
