diff --git a/app/models/card/engageable.rb b/app/models/card/engageable.rb
new file mode 100644
index 0000000..ad1c3af
--- /dev/null
+++ b/app/models/card/engageable.rb
@@ -0,0 +1,75 @@
+module Card::Engageable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    has_one :engagement, dependent: :destroy, class_name: "Card::Engagement"
+
+    scope :bursty, -> { joins(:engagement).merge(Card::Engagement.bursty) }
+    scope :stalled, -> { active.joins(:engagement).merge(Card::Engagement.stalled) }
+
+    after_update :reset_stalled_engagement, if: :saved_change_to_last_active_at?
+    after_touch :reset_stalled_engagement, if: :saved_change_to_last_active_at?
+  end
+
+  class_methods do
+    def stall_all_due(as_of: Time.current)
+      Account.find_each do |account|
+        Current.with_account(account) do
+          account.cards.active.bursty.where(last_active_at: ..(as_of - STALL_PERIOD)).find_each do |card|
+            card.stall(as_of: as_of)
+          end
+        end
+      end
+    end
+  end
+
+  def bursty?
+    engagement&.bursty? || false
+  end
+
+  def stalled?
+    active? && (engagement&.stalled? || false)
+  end
+
+  def engage_with(event)
+    if bursty_event?(event)
+      with_lock do
+        (engagement || build_engagement).bursty! if active? && !bursty?
+      end
+    end
+  end
+
+  def stall(as_of: Time.current)
+    with_lock do
+      if active? && bursty? && last_active_at <= as_of - STALL_PERIOD
+        engagement.stalled!
+      end
+    end
+  end
+
+  private
+    def bursty_event?(event)
+      case event.action
+      when "card_assigned", "card_reopened"
+        true
+      when "comment_created"
+        burst_of_comments?
+      else
+        false
+      end
+    end
+
+    def burst_of_comments?
+      recent_comments = comments.by_user.where(created_at: (Time.current - auto_postpone_period / 3.0)..Time.current)
+      recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+    end
+
+    def reset_stalled_engagement
+      if reload_engagement&.stalled?
+        engagement.destroy!
+        association(:engagement).reset
+      end
+    end
+end
