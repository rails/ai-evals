diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..f6901a7
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,151 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+  TERMINAL_STATUSES = %w[ canceled incomplete_expired ].freeze
+  EVENTS = %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ].freeze
+
+  class AlreadySubscribed < StandardError; end
+  class CheckoutCompleted < StandardError; end
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+  validates :plan_key, inclusion: { in: ->(_) { Plan.paid.map(&:key) } }, allow_nil: true
+
+  class << self
+    def create_stripe_customer_for(account)
+      Stripe::Customer.create({
+        name: account.name,
+        email: account.users.owner.first&.identity&.email_address || Current.identity&.email_address,
+        metadata: { account_id: account.id }
+      }, stripe_options.merge(idempotency_key: "fizzy-account-#{account.id}"))
+    end
+
+    def process(event)
+      if event.type.in?(EVENTS)
+        data = event.data.object.to_hash.deep_stringify_keys
+        if subscription = find_by(stripe_customer_id: data.fetch("customer"))
+          subscription.sync(event, data)
+        end
+      end
+    end
+
+    def stripe_options
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY") }
+    end
+  end
+
+  def plan
+    Plan.find(plan_key) if plan_key
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def ongoing?
+    active? || (stripe_subscription_id.present? && !status.in?(TERMINAL_STATUSES))
+  end
+
+  def checkout_url(plan:, success_url:, cancel_url:)
+    raise ArgumentError, "Choose a paid plan" unless plan.paid?
+    raise KeyError, "Missing Stripe price for #{plan.key}" if plan.stripe_price_id.blank?
+
+    with_lock do
+      raise AlreadySubscribed if ongoing?
+
+      checkout = Stripe::Checkout::Session.retrieve(stripe_checkout_session_id, self.class.stripe_options) if stripe_checkout_session_id
+      raise CheckoutCompleted if checkout&.status == "complete"
+
+      if checkout&.status == "open" && stripe_checkout_plan_key == plan.key
+        checkout.url
+      else
+        Stripe::Checkout::Session.expire(checkout.id, {}, self.class.stripe_options) if checkout&.status == "open"
+        create_checkout_url(plan: plan, success_url: success_url, cancel_url: cancel_url)
+      end
+    end
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create({
+      customer: stripe_customer_id,
+      return_url: return_url
+    }, self.class.stripe_options).url
+  end
+
+  def cancel
+    with_lock do
+      subscription_to_cancel = stripe_subscription_id unless status.in?(TERMINAL_STATUSES)
+
+      if stripe_checkout_session_id
+        checkout = Stripe::Checkout::Session.retrieve(stripe_checkout_session_id, self.class.stripe_options)
+        if checkout.status == "open"
+          Stripe::Checkout::Session.expire(checkout.id, {}, self.class.stripe_options)
+        elsif checkout.status == "complete"
+          subscription_to_cancel = checkout.subscription
+        end
+      end
+
+      if subscription_to_cancel
+        Stripe::Subscription.cancel(subscription_to_cancel, {}, self.class.stripe_options)
+        self.stripe_subscription_id = subscription_to_cancel
+      end
+
+      update!(status: "canceled", cancel_at: nil, stripe_checkout_session_id: nil, stripe_checkout_plan_key: nil)
+    end
+  end
+
+  def sync(event, data)
+    with_lock do
+      if newer_event?(event, data)
+        item = data.fetch("items", {}).fetch("data", []).find { |item| Plan.find_by_stripe_price_id(item.dig("price", "id")) }
+        plan = Plan.find_by_stripe_price_id(item&.dig("price", "id"))
+
+        update!(
+          stripe_subscription_id: data.fetch("id"),
+          stripe_subscription_created_at: timestamp(data["created"]),
+          plan_key: plan&.key,
+          status: event.type == "customer.subscription.deleted" ? "canceled" : data.fetch("status"),
+          current_period_end: timestamp(data["current_period_end"] || item&.dig("current_period_end")),
+          cancel_at: timestamp(data["cancel_at"]),
+          stripe_event_id: event.id,
+          stripe_event_created_at: timestamp(event.created),
+          stripe_checkout_session_id: nil,
+          stripe_checkout_plan_key: nil
+        )
+      end
+    end
+  end
+
+  private
+    def create_checkout_url(plan:, success_url:, cancel_url:)
+      # Stable across retries, but different after a checkout expires or a subscription ends.
+      idempotency_key = [ "fizzy-checkout", id, stripe_subscription_id, stripe_checkout_session_id, plan.key ].compact.join("-")
+      checkout = Stripe::Checkout::Session.create({
+        mode: "subscription",
+        customer: stripe_customer_id,
+        client_reference_id: account_id,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        subscription_data: { metadata: { account_id: account_id } },
+        success_url: success_url,
+        cancel_url: cancel_url
+      }, self.class.stripe_options.merge(idempotency_key: idempotency_key))
+
+      update!(stripe_checkout_session_id: checkout.id, stripe_checkout_plan_key: plan.key)
+      checkout.url
+    end
+
+    def newer_event?(event, data)
+      return false if stripe_event_id == event.id
+      return false if stripe_event_created_at && event.created < stripe_event_created_at.to_i
+
+      if stripe_subscription_id == data.fetch("id")
+        status != "canceled"
+      else
+        !stripe_subscription_created_at || data.fetch("created") > stripe_subscription_created_at.to_i
+      end
+    end
+
+    def timestamp(value)
+      Time.at(value).utc if value
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..ce3587c
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,44 @@
+class Plan
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  def self.all
+    @all ||= [
+      new(key: "free_v1", name: "Free", price_in_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte),
+      new(key: "monthly_v1", name: "Unlimited", price_in_cents: 2_000, storage_limit: 5.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"),
+      new(key: "monthly_extra_storage_v1", name: "Unlimited+", price_in_cents: 2_500, storage_limit: 500.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    ].each(&:freeze).freeze
+  end
+
+  def self.free
+    all.first
+  end
+
+  def self.paid
+    all.select(&:paid?)
+  end
+
+  def self.find(key)
+    all.find { |plan| plan.key == key } || raise(ActiveRecord::RecordNotFound, "Unknown plan")
+  end
+
+  def self.find_by_stripe_price_id(price_id)
+    paid.find { |plan| plan.stripe_price_id == price_id } if price_id.present?
+  end
+
+  def initialize(key:, name:, price_in_cents:, storage_limit:, card_limit: nil, stripe_price_env: nil)
+    @key, @name, @price_in_cents = key, name, price_in_cents
+    @card_limit, @storage_limit, @stripe_price_env = card_limit, storage_limit, stripe_price_env
+  end
+
+  def paid?
+    price_in_cents.positive?
+  end
+
+  def stripe_price_id
+    if @stripe_price_env
+      ENV.fetch(@stripe_price_env).presence || raise(KeyError, "Missing #{@stripe_price_env}")
+    end
+  end
+end
