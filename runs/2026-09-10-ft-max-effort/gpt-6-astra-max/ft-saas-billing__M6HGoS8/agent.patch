diff --git a/saas/test/controllers/card/limited_test.rb b/saas/test/controllers/card/limited_test.rb
new file mode 100644
index 0000000..bd6359e
--- /dev/null
+++ b/saas/test/controllers/card/limited_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class Card::LimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.update!(cards_count: @account.cards.maximum(:number))
+    @draft = cards(:unfinished_thoughts)
+    @board = boards(:miltons_wish_list)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "API creation is refused at the free card limit" do
+    Account.any_instance.stubs(:card_count).returns(1_000)
+
+    assert_no_difference "Card.count" do
+      post board_cards_path(@board), params: { card: { title: "One too many" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "publishing is refused at the free card limit" do
+    Account.any_instance.stubs(:card_count).returns(1_000)
+
+    post card_publish_path(@draft)
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "JSON publishing is refused over the free card limit" do
+    Account.any_instance.stubs(:card_count).returns(1_001)
+
+    post card_publish_path(@draft), as: :json
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "drafting and editing remain available at the free card limit" do
+    Account.any_instance.stubs(:card_count).returns(1_000)
+    @draft.destroy!
+
+    assert_difference "Card.drafted.count", 1 do
+      post board_cards_path(@board)
+    end
+
+    draft = Card.last
+    assert_redirected_to card_draft_path(draft)
+
+    patch card_path(draft), params: { card: { title: "Still thinking" } }, as: :json
+    assert_response :success
+    assert_equal "Still thinking", draft.reload.title
+    assert draft.drafted?
+  end
+
+  test "the last free card can be published" do
+    Account.any_instance.stubs(:card_count).returns(999)
+
+    post card_publish_path(@draft), as: :json
+
+    assert_response :created
+    assert @draft.reload.published?
+  end
+
+  test "draft shows an upgrade pitch instead of create buttons at the limit" do
+    Account.any_instance.stubs(:card_count).returns(1_000)
+
+    get card_draft_path(@draft)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message", text: /Upgrade/
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "the warning counts down from 100 cards left" do
+    { 900 => "100 cards left", 950 => "50 cards left", 999 => "1 card left" }.each do |count, warning|
+      Account.any_instance.stubs(:card_count).returns(count)
+
+      get card_draft_path(@draft)
+
+      assert_response :success
+      assert_select ".card-limit-notice", text: /#{warning}/
+      assert_select ".card-perma__notch-new-card-buttons"
+    end
+  end
+
+  test "no card warning before the last 100 cards" do
+    Account.any_instance.stubs(:card_count).returns(899)
+
+    get card_draft_path(@draft)
+
+    assert_response :success
+    assert_select ".card-limit-notice", count: 0
+  end
+  test "the actual published count enforces the 1000 card boundary without blocking drafts" do
+    @board.cards.insert_all! (4..1_000).map { |number| {
+      id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: @board.id, creator_id: users(:mike).id,
+      number: number, status: "published", title: "Card #{number}", last_active_at: Time.current
+    } }
+    @account.update!(cards_count: 1_000)
+    assert_equal 999, @account.card_count
+
+    post card_publish_path(@draft), as: :json
+    assert_response :created
+    assert_equal 1_000, @account.card_count
+
+    assert_no_difference "Card.count" do
+      post board_cards_path(@board), params: { card: { title: "Over the limit" } }, as: :json
+    end
+    assert_response :forbidden
+
+    assert_difference "Card.drafted.count", 1 do
+      post board_cards_path(@board)
+    end
+    assert_response :redirect
+  end
+
+  test "paid plans remove the card warning and allow API creation above the free limit" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+    @account.override_limits(card_count: 100_000, bytes_used: 2.gigabytes)
+
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_select ".card-limit-notice", count: 0
+    assert_select ".card-perma__notch-new-card-buttons"
+
+    assert_difference "Card.published.count", 1 do
+      post board_cards_path(@board), params: { card: { title: "Paid card" } }, as: :json
+    end
+    assert_response :created
+  end
+
+  test "paid plans still enforce their own storage limit" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+    @account.override_limits(bytes_used: 5.gigabytes + 1)
+
+    post card_publish_path(@draft), as: :json
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "comped accounts can publish above the free card limit" do
+    @account.comp
+    @account.override_limits(card_count: 1_000)
+
+    post card_publish_path(@draft), as: :json
+
+    assert_response :created
+    assert @draft.reload.published?
+  end
+
+  test "members get an upgrade explanation without access to billing controls" do
+    users(:mike).update!(role: "member")
+    @account.override_limits(card_count: 1_000)
+
+    get card_draft_path(@draft)
+
+    assert_response :success
+    assert_select ".card-perma__account-limit-message", text: /Upgrade/
+    assert_select ".card-perma__account-limit-message", text: /Ask an account admin/
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade", count: 0
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..f565d5b
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,106 @@
+require_relative "../../billing_test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include BillingTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_initech")
+  end
+
+  test "Stripe can post subscription changes without a login or account prefix" do
+    payload = stripe_subscription_event.to_json
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: {
+        "Content-Type" => "application/json", "Stripe-Signature" => stripe_signature(payload)
+      }
+    end
+
+    assert_response :success
+    assert_equal "monthly_v1", @subscription.reload.plan_key
+    assert_equal 5.gigabytes, @account.reload.storage_limit
+    assert_nil accounts(:"37s").subscription
+  end
+
+  test "valid signatures are required" do
+    payload = stripe_subscription_event.to_json
+
+    [ nil, "invalid", stripe_signature(payload, secret: "wrong_secret"), stripe_signature(payload, timestamp: 10.minutes.ago.to_i) ].each do |signature|
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: { "Content-Type" => "application/json", "Stripe-Signature" => signature }
+      end
+      assert_response :bad_request
+    end
+
+    assert_nil @subscription.reload.status
+  end
+
+  test "payload tampering is rejected" do
+    payload = stripe_subscription_event.to_json
+
+    untenanted do
+      post "/stripe/webhooks", params: payload.sub("price_unlimited", "price_unlimited_plus"), headers: {
+        "Content-Type" => "application/json", "Stripe-Signature" => stripe_signature(payload)
+      }
+    end
+
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "invalid JSON is rejected even with a matching signature" do
+    payload = "not json"
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: {
+        "Content-Type" => "application/json", "Stripe-Signature" => stripe_signature(payload)
+      }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "unrelated events are acknowledged without creating billing records" do
+    payload = stripe_subscription_event(type: "invoice.created").to_json
+
+    assert_no_difference "Account::Subscription.count" do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: {
+          "Content-Type" => "application/json", "Stripe-Signature" => stripe_signature(payload)
+        }
+      end
+    end
+
+    assert_response :success
+    assert_nil @subscription.reload.status
+  end
+
+  test "processing errors are not acknowledged so Stripe can retry" do
+    Account::Subscription.stubs(:process).raises(ActiveRecord::ConnectionNotEstablished)
+    payload = stripe_subscription_event.to_json
+
+    assert_raises ActiveRecord::ConnectionNotEstablished do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: {
+          "Content-Type" => "application/json", "Stripe-Signature" => stripe_signature(payload)
+        }
+      end
+    end
+  end
+
+  test "missing price configuration is retryable rather than acknowledging a lost upgrade" do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    payload = stripe_subscription_event.to_json
+
+    assert_raises KeyError do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: {
+          "Content-Type" => "application/json", "Stripe-Signature" => stripe_signature(payload)
+        }
+      end
+    end
+
+    assert_nil @subscription.reload.status
+  end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..7085791
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start on the free plan without Stripe records" do
+    assert_nil @account.subscription
+    assert_equal Plan.free, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "usage counts published cards rather than drafts or the numbering sequence" do
+    @account.update!(cards_count: 10_000)
+
+    assert_equal 2, @account.card_count
+
+    cards(:unfinished_thoughts).published!
+    assert_equal 3, @account.card_count
+
+    cards(:radio).destroy!
+    assert_equal 2, @account.card_count
+    assert_equal 10_000, @account.reload.cards_count
+  end
+
+  test "the free limit and warning boundaries" do
+    { 899 => [ 101, false, false ], 900 => [ 100, true, false ], 950 => [ 50, true, false ],
+      999 => [ 1, true, false ], 1_000 => [ 0, false, true ], 1_001 => [ 0, false, true ] }.each do |count, expected|
+      @account.override_limits(card_count: count)
+      assert_equal expected, [ @account.remaining_cards, @account.nearing_card_limit?, @account.exceeding_card_limit? ]
+    end
+  end
+
+  test "each active paid plan has unlimited cards and its own storage allowance" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active")
+    @account.override_limits(card_count: 100_000)
+
+    Plan.paid.each do |plan|
+      subscription.update!(plan_key: plan.key)
+
+      assert_equal plan, @account.plan
+      assert_equal plan.storage_limit, @account.storage_limit
+      assert_nil @account.remaining_cards
+      assert_not @account.nearing_card_limit?
+      assert_not @account.exceeding_card_limit?
+    end
+  end
+
+  test "inactive subscriptions do not grant paid allowances" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_initech", plan_key: "monthly_v1")
+
+    %w[ incomplete incomplete_expired unpaid canceled paused ].each do |status|
+      subscription.update!(status: status)
+      assert_equal Plan.free, @account.plan
+    end
+
+    %w[ active trialing past_due ].each do |status|
+      subscription.update!(status: status)
+      assert_equal Plan.find("monthly_v1"), @account.plan
+    end
+  end
+
+  test "comp and uncomp are idempotent and restore the underlying plan" do
+    @account.override_limits(card_count: 1_000)
+
+    assert_difference "Account::BillingWaiver.count", 1 do
+      2.times { @account.comp }
+    end
+    assert @account.comped?
+    assert_equal Plan.find("monthly_v1"), @account.plan
+    assert_not @account.exceeding_card_limit?
+
+    assert_difference "Account::BillingWaiver.count", -1 do
+      2.times { @account.uncomp }
+    end
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+    assert @account.exceeding_card_limit?
+  end
+
+  test "comping does not reduce an existing paid storage allowance" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_extra_storage_v1")
+    @account.comp
+
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "storage exceptions never reduce the plan allowance" do
+    @account.add_storage_exception(10.gigabytes)
+    assert_equal 10.gigabytes, @account.storage_limit
+
+    @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_extra_storage_v1")
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "zero overrides are honored and reset restores measured usage without modifying data" do
+    @account.create_storage_total!(bytes_stored: 123_456)
+    original_count = @account.card_count
+    original_sequence = @account.cards_count
+
+    @account.override_limits(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+
+    assert_difference "Account::OverriddenLimits.count", -1 do
+      @account.reset_overridden_limits
+    end
+
+    assert_equal original_count, @account.card_count
+    assert_equal 123_456, @account.bytes_used
+    assert_equal original_sequence, @account.reload.cards_count
+    assert_equal 123_456, @account.storage_total.bytes_stored
+  end
+
+  test "blank overrides fall back to measured usage" do
+    @account.create_storage_total!(bytes_stored: 123_456)
+    @account.override_limits(card_count: 950, bytes_used: "")
+    assert_equal 950, @account.card_count
+    assert_equal 123_456, @account.bytes_used
+
+    @account.override_limits(card_count: "", bytes_used: 500.gigabytes)
+    assert_equal 2, @account.card_count
+    assert_equal 500.gigabytes, @account.bytes_used
+  end
+
+  test "overrides must be nonnegative whole numbers" do
+    [ -1, "1.5", "lots" ].each do |value|
+      assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(card_count: value) }
+      @account.reload
+      assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(bytes_used: value) }
+      @account.reload
+    end
+  end
+
+  test "usage overrides drive storage enforcement too" do
+    @account.override_limits(bytes_used: 1.gigabyte + 1)
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+    assert_not @account.exceeding_storage_limit?
+  end
+  test "canceled accounts cannot start checkout even from a stale account instance" do
+    stale_account = Account.find(@account.id)
+    @account.cancel(initiated_by: users(:mike))
+
+    assert_raises ActiveRecord::RecordNotFound do
+      stale_account.checkout_url(plan: Plan.find("monthly_v1"), success_url: "http://example.com", cancel_url: "http://example.com")
+    end
+    assert_nil @account.reload.subscription
+  end
+end
