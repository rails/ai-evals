@@ -0,0 +1,24 @@
+class Account::Subscriptions::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Plan.find(params.require(:plan_key))
+
+    if plan.paid?
+      checkout_url = Current.account.checkout_url(
+        plan: plan,
+        success_url: saas.account_subscription_url(checkout: "complete"),
+        cancel_url: saas.account_subscription_url
+      )
+      redirect_to checkout_url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  rescue Account::Subscription::AlreadySubscribed
+    redirect_to saas.account_subscription_path, alert: "Use Manage billing to change your subscription.", status: :see_other
+  rescue Account::Subscription::CheckoutCompleted
+    redirect_to saas.account_subscription_path, notice: "Stripe is confirming your checkout. Please try again shortly.", status: :see_other
+  rescue Stripe::StripeError
+    redirect_to saas.account_subscription_path, alert: "Billing is temporarily unavailable. Please try again.", status: :see_other
+  end
+end
