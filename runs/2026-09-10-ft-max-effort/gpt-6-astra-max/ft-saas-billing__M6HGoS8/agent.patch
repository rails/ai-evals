@@ -0,0 +1,18 @@
+module Card::Limited
+  extend ActiveSupport::Concern
+
+  private
+    def with_card_limit
+      # Serialize the check and publication so concurrent requests cannot use the same last card.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit?
+          respond_to do |format|
+            format.html { render partial: "cards/container/footer/saas/card_limit_exceeded", status: :forbidden }
+            format.json { render json: { error: "This account has reached its free card limit. Upgrade to publish more cards." }, status: :forbidden }
+          end
+        else
+          yield
+        end
+      end
+    end
+end
