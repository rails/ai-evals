diff --git a/saas/test/billing_test_helper.rb b/saas/test/billing_test_helper.rb
new file mode 100644
index 0000000..47ae70c
--- /dev/null
+++ b/saas/test/billing_test_helper.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+module BillingTestHelper
+  extend ActiveSupport::Concern
+
+  STRIPE_ENVIRONMENT = {
+    "STRIPE_SECRET_KEY" => "sk_test_fizzy",
+    "STRIPE_WEBHOOK_SECRET" => "whsec_fizzy",
+    "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited",
+    "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_unlimited_plus"
+  }.freeze
+
+  included do
+    setup do
+      @previous_stripe_environment = ENV.to_h.slice(*STRIPE_ENVIRONMENT.keys)
+      ENV.update(STRIPE_ENVIRONMENT)
+      @vcr_was_on = VCR.turned_on?
+      VCR.turn_off!
+      WebMock.disable_net_connect!(allow_localhost: true)
+    end
+
+    teardown do
+      STRIPE_ENVIRONMENT.each_key { |key| ENV.delete(key) }
+      ENV.update(@previous_stripe_environment)
+      Stripe::APIRequestor.clear_all_connection_managers
+      WebMock.allow_net_connect!
+      VCR.turn_on! if @vcr_was_on
+    end
+  end
+
+  def stripe_subscription_event(type: "customer.subscription.updated", id: "evt_#{SecureRandom.hex(8)}", created: Time.current.to_i,
+    subscription_id: "sub_initech", subscription_created: 1.day.ago.to_i, **attributes)
+    Stripe::Event.construct_from(
+      id: id,
+      object: "event",
+      type: type,
+      created: created,
+      data: { object: {
+        id: subscription_id,
+        object: "subscription",
+        customer: "cus_initech",
+        created: subscription_created,
+        status: "active",
+        cancel_at: nil,
+        items: { data: [ {
+          id: "si_initech",
+          price: { id: "price_unlimited" },
+          current_period_end: 1.month.from_now.to_i
+        } ] }
+      }.merge(attributes) }
+    )
+  end
+
+  def stripe_response(attributes)
+    { status: 200, body: attributes.to_json, headers: { "Content-Type" => "application/json" } }
+  end
+
+  def stripe_signature(payload, secret: ENV.fetch("STRIPE_WEBHOOK_SECRET"), timestamp: Time.current.to_i)
+    signature = OpenSSL::HMAC.hexdigest("SHA256", secret, "#{timestamp}.#{payload}")
+    "t=#{timestamp},v1=#{signature}"
+  end
+end
