diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..dddb296
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,134 @@
+require_relative "../../billing_test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  include BillingTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_initech")
+  end
+
+  test "creates and persists a Stripe customer once using an account idempotency key" do
+    account = accounts(:"37s")
+    request = stub_request(:post, "https://api.stripe.com/v1/customers")
+      .with(body: { name: account.name, email: "jason@37signals.com", metadata: { account_id: account.id } },
+        headers: { "Authorization" => "Bearer sk_test_fizzy", "Idempotency-Key" => "fizzy-account-#{account.id}" })
+      .to_return(stripe_response(id: "cus_37s", object: "customer"))
+
+    assert_difference "Account::Subscription.count", 1 do
+      2.times { assert_equal "cus_37s", account.subscription_for_checkout.stripe_customer_id }
+    end
+
+    assert_requested request, times: 1
+    assert_equal Plan.free, account.plan
+  end
+
+  test "created subscriptions grant the plan from the Stripe price" do
+    event = stripe_subscription_event(type: "customer.subscription.created")
+    Account::Subscription.process(event)
+
+    assert_equal "sub_initech", @subscription.reload.stripe_subscription_id
+    assert_equal "monthly_v1", @subscription.plan_key
+    assert_equal Time.at(event.data.object.items.data.first.current_period_end), @subscription.current_period_end
+    assert_equal Plan.find("monthly_v1"), @account.reload.plan
+  end
+
+  test "updates change the plan and preserve paid access until scheduled cancellation" do
+    cancel_at = 1.month.from_now.to_i
+    event = stripe_subscription_event(cancel_at: cancel_at,
+      items: { data: [ { price: { id: "price_unlimited_plus" }, current_period_end: cancel_at } ] })
+
+    Account::Subscription.process(event)
+
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+    assert_equal Time.at(cancel_at), @subscription.reload.cancel_at
+    assert @subscription.active?
+  end
+
+  test "supports Stripe payloads with subscription-level billing periods" do
+    period_end = 1.month.from_now.to_i
+    Account::Subscription.process(stripe_subscription_event(current_period_end: period_end,
+      items: { data: [ { price: { id: "price_unlimited" } } ] }))
+
+    assert_equal Time.at(period_end), @subscription.reload.current_period_end
+  end
+
+  test "deletion returns the account to Free" do
+    Account::Subscription.process(stripe_subscription_event(type: "customer.subscription.deleted", status: "canceled"))
+
+    assert_equal "canceled", @subscription.reload.status
+    assert_equal Plan.free, @account.reload.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "replayed events do not write twice" do
+    event = stripe_subscription_event
+    Account::Subscription.process(event)
+    updated_at = @subscription.reload.updated_at
+
+    travel 1.minute do
+      Account::Subscription.process(event)
+      assert_equal updated_at, @subscription.reload.updated_at
+    end
+  end
+
+  test "older events cannot undo a newer plan change" do
+    Account::Subscription.process(stripe_subscription_event(created: 2.minutes.ago.to_i,
+      items: { data: [ { price: { id: "price_unlimited_plus" } } ] }))
+    Account::Subscription.process(stripe_subscription_event(created: 3.minutes.ago.to_i))
+
+    assert_equal "monthly_extra_storage_v1", @subscription.reload.plan_key
+  end
+
+  test "canceled subscriptions cannot be revived by delayed updates" do
+    Account::Subscription.process(stripe_subscription_event(type: "customer.subscription.deleted", status: "canceled"))
+    Account::Subscription.process(stripe_subscription_event)
+
+    assert_equal "canceled", @subscription.reload.status
+  end
+
+  test "a new subscription can replace a canceled subscription" do
+    Account::Subscription.process(stripe_subscription_event(type: "customer.subscription.deleted", status: "canceled"))
+    event = stripe_subscription_event(type: "customer.subscription.created", subscription_id: "sub_new", subscription_created: Time.current.to_i)
+    Account::Subscription.process(event)
+
+    assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+    assert @subscription.active?
+  end
+
+  test "a late deletion for an old subscription cannot cancel its replacement" do
+    event = stripe_subscription_event(subscription_id: "sub_new", subscription_created: 1.hour.ago.to_i)
+    Account::Subscription.process(event)
+
+    Account::Subscription.process(stripe_subscription_event(type: "customer.subscription.deleted", status: "canceled"))
+
+    assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+    assert @subscription.active?
+  end
+
+  test "unknown prices cannot grant a paid plan" do
+    Account::Subscription.process(stripe_subscription_event(items: { data: [ { price: { id: "price_unknown" } } ] }))
+
+    assert_nil @subscription.reload.plan_key
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "unknown customers and unrelated event types are ignored" do
+    assert_no_difference "Account::Subscription.count" do
+      Account::Subscription.process(stripe_subscription_event(customer: "cus_someone_else"))
+      Account::Subscription.process(stripe_subscription_event(type: "invoice.paid"))
+    end
+
+    assert_nil @subscription.reload.status
+  end
+
+  test "only one subscription record can belong to an account or customer" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      @account.create_subscription!(stripe_customer_id: "cus_another")
+    end
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      accounts(:acme).create_subscription!(stripe_customer_id: "cus_initech")
+    end
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..0dc4f29
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,33 @@
+require_relative "../billing_test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  include BillingTestHelper
+
+  test "approved plans and monthly prices" do
+    assert_equal [ "Free", "Unlimited", "Unlimited+" ], Plan.all.map(&:name)
+    assert_equal [ 0, 2_000, 2_500 ], Plan.all.map(&:price_in_cents)
+    assert_equal [ 1_000, nil, nil ], Plan.all.map(&:card_limit)
+    assert_equal [ 1.gigabyte, 5.gigabytes, 500.gigabytes ], Plan.all.map(&:storage_limit)
+    assert_not Plan.free.paid?
+    assert_equal 2, Plan.paid.size
+  end
+
+  test "Stripe prices map only to configured paid plans" do
+    assert_equal Plan.find("monthly_v1"), Plan.find_by_stripe_price_id("price_unlimited")
+    assert_equal Plan.find("monthly_extra_storage_v1"), Plan.find_by_stripe_price_id("price_unlimited_plus")
+    assert_nil Plan.find_by_stripe_price_id("price_unknown")
+    assert_nil Plan.find_by_stripe_price_id(nil)
+    assert_nil Plan.free.stripe_price_id
+  end
+
+  test "unknown plan keys are rejected" do
+    assert_raises(ActiveRecord::RecordNotFound) { Plan.find("price_from_the_browser") }
+  end
+
+  test "plans can be displayed without Stripe configuration" do
+    BillingTestHelper::STRIPE_ENVIRONMENT.each_key { |key| ENV.delete(key) }
+
+    assert_equal [ "Free", "Unlimited", "Unlimited+" ], Plan.all.map(&:name)
+    assert_raises(KeyError) { Plan.find_by_stripe_price_id("price_unknown") }
+  end
+end
