+<% @page_title = "Plans & billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings settings--billing margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <p><%= link_to "Back to account settings", main_app.account_settings_path %></p>
+    <h2>Your plan: <%= @account.plan.name %></h2>
+    <% if @account.comped? %>
+      <p>This account has complimentary Unlimited access.</p>
+    <% end %>
+    <% if params[:checkout] == "complete" %>
+      <p>Your plan will update once Stripe confirms your subscription.</p>
+    <% end %>
+    <p><%= number_with_delimiter(@account.card_count) %> cards published &middot; <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %> storage used</p>
+    <% if @account.subscription %>
+      <%= button_to "Manage billing", saas.account_subscription_portal_path, class: "btn btn--link", data: { turbo: false } %>
+      <p class="txt-small">Change your plan, update payment details, or cancel in Stripe’s customer portal.</p>
+    <% end %>
+  </div>
+
+  <div class="billing__plans">
+    <% @plans.each do |plan| %>
+      <section class="settings__panel panel shadow center">
+        <h2><%= plan.name %></h2>
+        <p class="txt-large"><%= plan.paid? ? "#{number_to_currency(plan.price_in_cents / 100, precision: 0)}/month" : "Free" %></p>
+        <p><%= plan.card_limit ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards" %> &middot; <%= number_to_human_size(plan.storage_limit) %> storage</p>
+        <% if plan == @account.plan %>
+          <strong>Current plan</strong>
+        <% elsif plan.paid? && !@account.subscription&.ongoing? %>
+          <%= button_to "Upgrade to #{plan.name}", saas.account_subscription_checkout_path, params: { plan_key: plan.key }, class: "btn btn--link", data: { turbo: false } %>
+        <% end %>
+      </section>
+    <% end %>
+  </div>
+</div>
