+    @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+    request = stub_request(:post, "https://api.stripe.com/v1/billing_portal/sessions")
+      .with(body: { customer: "cus_initech", return_url: "http://www.example.com#{@account.slug}/account/subscription" })
+      .to_return(stripe_response(id: "bps_initech", object: "billing_portal.session", url: "https://billing.stripe.com/p/session/initech"))
+
+    post saas.account_subscription_portal_path, params: { stripe_customer_id: "cus_other", return_url: "https://untrusted.example" }
+
+    assert_response :see_other
+    assert_redirected_to "https://billing.stripe.com/p/session/initech"
+    assert_requested request
+  end
+
+  test "free accounts without Stripe customers go back to plans" do
+    post saas.account_subscription_portal_path
+
+    assert_redirected_to saas.account_subscription_path
+  end
+
+  test "Stripe failures are recoverable" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech")
+    Stripe::BillingPortal::Session.stubs(:create).raises(Stripe::APIConnectionError.new("unavailable"))
+
+    post saas.account_subscription_portal_path
+
+    assert_redirected_to saas.account_subscription_path
+    assert_match /temporarily unavailable/, flash[:alert]
+  end
+
+  test "members cannot open the portal" do
+    logout_and_sign_in_as :jz
+
+    post saas.account_subscription_portal_path(script_name: accounts(:"37s").slug)
+
+    assert_response :forbidden
+  end
+
+  test "admins cannot open another account's portal" do
+    post saas.account_subscription_portal_path(script_name: accounts(:"37s").slug), as: :json
+
+    assert_response :forbidden
+  end
+end
