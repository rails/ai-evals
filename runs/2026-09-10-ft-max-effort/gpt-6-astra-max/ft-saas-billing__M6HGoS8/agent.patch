+require "test_helper"
+
+class Account::BillingSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their free plan and an upgrade link in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings-subscription", text: /Free/
+    assert_select ".settings-subscription a", text: "Upgrade"
+  end
+
+  test "members do not see billing controls in settings" do
+    sign_in_as :jz
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings-subscription", count: 0
+  end
+
+  test "paid admins see their plan, price, storage and billing portal" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings-subscription", text: /Unlimited/
+    assert_select ".settings-subscription", text: /\$20\/month/
+    assert_select ".settings-subscription", text: /5 GB/
+    assert_select ".settings-subscription a", text: "Upgrade"
+    assert_select ".settings-subscription button", text: "Manage billing"
+  end
+
+  test "Unlimited+ shows its storage allowance instead of free storage" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_extra_storage_v1")
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings-subscription", text: /Unlimited/
+    assert_select ".settings-subscription", text: /\$25\/month/
+    assert_select ".settings-subscription", text: /500 GB/
+    assert_select ".settings-subscription button", text: "Manage billing"
+  end
+end
diff --git a/saas/test/controllers/account/cancellations_controller_test.rb b/saas/test/controllers/account/cancellations_controller_test.rb
new file mode 100644
index 0000000..a7aa9c6
--- /dev/null
+++ b/saas/test/controllers/account/cancellations_controller_test.rb
@@ -0,0 +1,63 @@
+require_relative "../../billing_test_helper"
+
+class Account::BillingCancellationsControllerTest < ActionDispatch::IntegrationTest
+  include BillingTestHelper
+
+  setup do
+    sign_in_as :jason
+    @account = accounts(:"37s")
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_37s", stripe_subscription_id: "sub_37s", status: "active", plan_key: "monthly_v1")
+  end
+
+  test "account deletion cancels the Stripe subscription" do
+    request = stub_request(:delete, "https://api.stripe.com/v1/subscriptions/sub_37s")
+      .to_return(stripe_response(id: "sub_37s", object: "subscription", status: "canceled"))
+
+    post account_cancellation_path
+
+    assert_redirected_to session_menu_path(script_name: nil)
+    assert @account.reload.cancelled?
+    assert_equal "canceled", @subscription.reload.status
+    assert_requested request
+  end
+
+  test "Stripe failures leave the account open so the owner can retry" do
+    Stripe::Subscription.stubs(:cancel).raises(Stripe::APIConnectionError.new("unavailable"))
+
+    post account_cancellation_path
+
+    assert_redirected_to account_settings_path
+    assert_match /has not been deleted/, flash[:alert]
+    assert_not @account.reload.cancelled?
+    assert_equal "active", @subscription.reload.status
+  end
+
+  test "account deletion expires an open checkout" do
+    @subscription.update!(stripe_subscription_id: nil, status: nil, stripe_checkout_session_id: "cs_open")
+    stub_request(:get, "https://api.stripe.com/v1/checkout/sessions/cs_open")
+      .to_return(stripe_response(id: "cs_open", object: "checkout.session", status: "open"))
+    expire = stub_request(:post, "https://api.stripe.com/v1/checkout/sessions/cs_open/expire")
+      .to_return(stripe_response(id: "cs_open", object: "checkout.session", status: "expired"))
+
+    post account_cancellation_path
+
+    assert @account.reload.cancelled?
+    assert_nil @subscription.reload.stripe_checkout_session_id
+    assert_requested expire
+  end
+
+  test "account deletion cancels a completed checkout even before its webhook arrives" do
+    @subscription.update!(stripe_subscription_id: nil, status: nil, stripe_checkout_session_id: "cs_complete")
+    stub_request(:get, "https://api.stripe.com/v1/checkout/sessions/cs_complete")
+      .to_return(stripe_response(id: "cs_complete", object: "checkout.session", status: "complete", subscription: "sub_pending"))
+    cancel = stub_request(:delete, "https://api.stripe.com/v1/subscriptions/sub_pending")
+      .to_return(stripe_response(id: "sub_pending", object: "subscription", status: "canceled"))
+
+    post account_cancellation_path
+
+    assert @account.reload.cancelled?
+    assert_equal "sub_pending", @subscription.reload.stripe_subscription_id
+    assert_equal "canceled", @subscription.status
+    assert_requested cancel
+  end
+end
