+require_relative "../../../billing_test_helper"
+
+class Account::Subscriptions::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  include BillingTestHelper
+
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "checkout uses the configured price and current account customer" do
+    customer_request = stub_request(:post, "https://api.stripe.com/v1/customers")
+      .with(body: { name: @account.name, email: "mike@37signals.com", metadata: { account_id: @account.id } })
+      .to_return(stripe_response(id: "cus_initech", object: "customer"))
+    checkout_request = stub_request(:post, "https://api.stripe.com/v1/checkout/sessions")
+      .with(body: {
+        mode: "subscription", customer: "cus_initech", client_reference_id: @account.id,
+        line_items: [ { price: "price_unlimited", quantity: "1" } ],
+        subscription_data: { metadata: { account_id: @account.id } },
+        success_url: "http://www.example.com#{@account.slug}/account/subscription?checkout=complete",
+        cancel_url: "http://www.example.com#{@account.slug}/account/subscription"
+      })
+      .to_return(stripe_response(id: "cs_initech", object: "checkout.session", url: "https://checkout.stripe.com/c/pay/cs_initech"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1", stripe_customer_id: "cus_other", success_url: "https://untrusted.example" }
+
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_initech"
+    assert_equal "cus_initech", @account.reload.subscription.stripe_customer_id
+    assert_equal Plan.free, @account.plan
+    assert_requested customer_request
+    assert_requested checkout_request
+  end
+
+  test "Unlimited+ checkout uses its own price" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech")
+    request = stub_request(:post, "https://api.stripe.com/v1/checkout/sessions")
+      .with(body: hash_including("line_items" => [ { "price" => "price_unlimited_plus", "quantity" => "1" } ]))
+      .to_return(stripe_response(id: "cs_initech", object: "checkout.session", url: "https://checkout.stripe.com/c/pay/cs_initech"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_response :see_other
+    assert_requested request
+  end
+
+  test "unknown and free plans cannot start checkout" do
+    post saas.account_subscription_checkout_path, params: { plan_key: "price_arbitrary" }
+    assert_response :not_found
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "free_v1" }
+    assert_response :unprocessable_entity
+    assert_nil @account.reload.subscription
+  end
+
+  test "existing paid subscriptions are managed through the portal instead" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", status: "active", plan_key: "monthly_v1")
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_redirected_to saas.account_subscription_path
+    assert_match /Manage billing/, flash[:alert]
+  end
+
+  test "Stripe failures do not grant paid access" do
+    Stripe::Customer.stubs(:create).raises(Stripe::APIConnectionError.new("unavailable"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to saas.account_subscription_path
+    assert_match /temporarily unavailable/, flash[:alert]
+    assert_equal Plan.free, @account.reload.plan
+    assert_nil @account.subscription
+  end
+
+  test "members cannot create checkout sessions" do
+    logout_and_sign_in_as :jz
+
+    post saas.account_subscription_checkout_path(script_name: accounts(:"37s").slug), params: { plan_key: "monthly_v1" }
+
+    assert_response :forbidden
+  end
+
+  test "admins cannot create checkout for another account" do
+    post saas.account_subscription_checkout_path(script_name: accounts(:"37s").slug), params: { plan_key: "monthly_v1" }, as: :json
+
+    assert_response :forbidden
+    assert_nil accounts(:"37s").subscription
+  end
+  test "repeated checkout requests reuse the open session" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", stripe_checkout_session_id: "cs_open", stripe_checkout_plan_key: "monthly_v1")
+    request = stub_request(:get, "https://api.stripe.com/v1/checkout/sessions/cs_open")
+      .to_return(stripe_response(id: "cs_open", object: "checkout.session", status: "open", url: "https://checkout.stripe.com/c/pay/cs_open"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_open"
+    assert_requested request
+  end
+
+  test "choosing another plan expires the previous checkout first" do
