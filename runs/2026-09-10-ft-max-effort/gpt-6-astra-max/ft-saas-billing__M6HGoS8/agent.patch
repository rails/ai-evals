+    assert_requested expire
+    assert_requested create
+  end
+
+  test "a completed checkout awaiting its webhook cannot create another subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", stripe_checkout_session_id: "cs_complete", stripe_checkout_plan_key: "monthly_v1")
+    stub_request(:get, "https://api.stripe.com/v1/checkout/sessions/cs_complete")
+      .to_return(stripe_response(id: "cs_complete", object: "checkout.session", status: "complete"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to saas.account_subscription_path
+    assert_match /confirming your checkout/, flash[:notice]
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "incomplete subscriptions use the portal rather than starting a second subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_initech", stripe_subscription_id: "sub_initech", status: "incomplete", plan_key: "monthly_v1")
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+
+    assert_redirected_to saas.account_subscription_path
+    assert_match /Manage billing/, flash[:alert]
+  end
+
+  test "an expired checkout can be replaced" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_initech", stripe_checkout_session_id: "cs_expired", stripe_checkout_plan_key: "monthly_v1")
+    stub_request(:get, "https://api.stripe.com/v1/checkout/sessions/cs_expired")
+      .to_return(stripe_response(id: "cs_expired", object: "checkout.session", status: "expired"))
+    create = stub_request(:post, "https://api.stripe.com/v1/checkout/sessions")
+      .with(headers: { "Idempotency-Key" => "fizzy-checkout-#{subscription.id}-cs_expired-monthly_v1" })
+      .to_return(stripe_response(id: "cs_new", object: "checkout.session", url: "https://checkout.stripe.com/c/pay/cs_new"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
