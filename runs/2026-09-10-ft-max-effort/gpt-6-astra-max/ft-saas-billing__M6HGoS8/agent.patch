@@ -0,0 +1,13 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    Account::Subscription.process(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..06dea54
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,92 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+
+    set_callback :cancel, :before, :cancel_billing
+  end
+
+  def plan
+    if subscription&.active? && subscription.plan
+      subscription.plan
+    elsif comped?
+      Plan.find("monthly_v1")
+    else
+      Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def comp
+    self.billing_waiver ||= Account::BillingWaiver.create_or_find_by!(account: self)
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    self.billing_waiver = nil
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def remaining_cards
+    [ plan.card_limit - card_count, 0 ].max if plan.card_limit
+  end
+
+  def exceeding_card_limit?
+    plan.card_limit.present? && card_count >= plan.card_limit
+  end
+
+  def nearing_card_limit?
+    plan.card_limit.present? && remaining_cards.between?(1, NEAR_CARD_LIMIT_THRESHOLD)
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def override_limits(**attributes)
+    (overridden_limits || build_overridden_limits).update!(attributes)
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy!
+    self.overridden_limits = nil
+  end
+
+  def checkout_url(**options)
+    with_lock do
+      raise ActiveRecord::RecordNotFound unless active?
+
+      subscription_for_checkout.checkout_url(**options)
+    end
+  end
+
+  def subscription_for_checkout
+    with_lock do
+      reload_subscription || create_subscription!(stripe_customer_id: Account::Subscription.create_stripe_customer_for(self).id)
+    end
+  end
+
+  private
+    def cancel_billing
+      subscription&.cancel
+    end
+end
