@@ -0,0 +1,111 @@
+require "test_helper"
+
+class CurrentLocaleTest < ActionDispatch::IntegrationTest
+  test "English remains the default" do
+    untenanted { get new_session_path, headers: { "Accept-Language" => "ja-JP,ja;q=0.9" } }
+
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "anonymous locale selection survives subsequent requests and invalid locales" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+
+      get new_session_path(locale: :xx)
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  test "a signed in person's choice is restored in a clean browser" do
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    cookies.to_hash.each_key { |name| cookies.delete(name) }
+    sign_in_as :kevin
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+
+    get root_path(locale: :xx)
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get root_path(locale: :en)
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+
+  test "anonymous choice is saved only after authenticating" do
+    untenanted { get new_session_path(locale: :ja) }
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "an unsupported locale does not change the default" do
+    untenanted { get new_session_path(locale: :xx) }
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_equal :en, I18n.locale
+  end
+
+  test "malformed locale values are ignored" do
+    untenanted do
+      [ { locale: [ "ja" ] }, { locale: { value: "ja" } } ].each do |parameters|
+        get new_session_path, params: parameters
+        assert_response :success
+        assert_select "html[lang=en]"
+      end
+    end
+  end
+
+  test "a new identity does not inherit another identity's language" do
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+    cookies.delete("session_token")
+    sign_in_as :david
+    get root_path
+    assert_select "html[lang=en]"
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "locale participates in validators and shared cache variation" do
+    sign_in_as :kevin
+    get board_path(boards(:writebook))
+    etag = response.headers.fetch("ETag")
+    get board_path(boards(:writebook), locale: :ja), headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_not_equal etag, response.headers.fetch("ETag")
+    assert_equal "ja", response.headers["Content-Language"]
+    assert_includes response.headers["Vary"], "Cookie"
+  end
+
+  test "locale is restored even when rendering raises" do
+    sign_in_as :kevin
+    without_action_dispatch_exception_handling do
+      assert_raises ActiveRecord::RecordNotFound do
+        get board_path("missing", locale: :ja)
+      end
+    end
+    assert_equal :en, I18n.locale
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "the preference applies across account memberships" do
+    user = users(:kevin)
+    accounts(:initech).users.create!(identity: user.identity, name: user.name, role: :member)
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+    get root_path(script_name: accounts(:initech).slug)
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+end
