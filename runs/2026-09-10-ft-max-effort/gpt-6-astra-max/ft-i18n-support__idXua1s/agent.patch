diff --git a/app/views/mission_control/jobs/jobs/_error_information.html.erb b/app/views/mission_control/jobs/jobs/_error_information.html.erb
new file mode 100644
index 0000000..dbb65e9
--- /dev/null
+++ b/app/views/mission_control/jobs/jobs/_error_information.html.erb
@@ -0,0 +1,22 @@
+<% if job.failed? %>
+  <h2 class="subtitle"><%= t("job_admin.error_information") %></h2>
+
+  <table class="table">
+    <tbody>
+    <tr>
+      <th><%= t("job_admin.type") %></th>
+      <td> <%= job.last_execution_error.error_class %> </td>
+    </tr>
+    <tr>
+      <th><%= t("job_admin.message") %></th>
+      <td> <%= job.last_execution_error.try(:message) || job.last_execution_error.inspect %> </td>
+    </tr>
+    </tbody>
+  </table>
+
+  <% if @server.backtrace_cleaner %>
+    <%= render "mission_control/jobs/jobs/failed/backtrace_toggle", application: @application, job: job %>
+  <% end %>
+
+  <pre class="is-family-monospace mb-4 backtrace-content"><%= failed_job_backtrace(job, @server) %></pre>
+<% end %>
diff --git a/app/views/mission_control/jobs/jobs/_filters.html.erb b/app/views/mission_control/jobs/jobs/_filters.html.erb
new file mode 100644
index 0000000..0cf7f75
--- /dev/null
+++ b/app/views/mission_control/jobs/jobs/_filters.html.erb
@@ -0,0 +1,55 @@
+<div class="filter level-left">
+  <%= form_for :filter, url: application_jobs_path(MissionControl::Jobs::Current.application, jobs_status), method: :get,
+    data: { controller: "form", action: "input->form#debouncedSubmit" } do |form| %>
+
+    <div class="field is-grouped">
+      <div class="control">
+        <%= form.label :job_class_name, class: "label" %>
+        <div class="select is-rounded">
+          <%= form.text_field :job_class_name, value: @job_filters[:job_class_name], class: "input", list: "job-classes", placeholder: t("job_admin.filter_by_job_class"), autocomplete: "off" %>
+        </div>
+      </div>
+
+      <div class="control">
+        <%= form.label :queue_name, class: "label" %>
+        <div class="select is-rounded">
+          <%= form.text_field :queue_name, value: @job_filters[:queue_name], class: "input", list: "queue-names", placeholder: t("job_admin.filter_by_queue_name"), autocomplete: "off" %>
+        </div>
+      </div>
+
+      <% if jobs_status == "finished" %>
+        <div class="control">
+          <%= form.label :finished_at_start, class: "label" %>
+          <div class="select is-rounded">
+            <%= form.datetime_field :finished_at_start, value: @job_filters[:finished_at]&.begin, class: "input", placeholder: t("job_admin.finished_from") %>
+          </div>
+        </div>
+
+        <div class="control">
+          <%= form.label :finished_at_end, class: "label" %>
+          <div class="select is-rounded">
+            <%= form.datetime_field :finished_at_end, value: @job_filters[:finished_at]&.end, class: "input", placeholder: t("job_admin.finished_to") %>
+          </div>
+        </div>
+      <% end %>
+
+      <%= hidden_field_tag :server_id, MissionControl::Jobs::Current.server.id %>
+
+      <datalist id="job-classes" class="is-hidden">
+        <% job_class_names.each do |job_class_name| %>
+          <option value="<%= job_class_name %>"></option>
+        <% end %>
+      </datalist>
+
+      <datalist id="queue-names" class="is-hidden">
+        <% queue_names.each do |queue_name| %>
+          <option value="<%= queue_name %>"></option>
+        <% end %>
+      </datalist>
+
+      <div class="control is-align-self-flex-end">
+        <%= link_to t("job_admin.clear"), application_jobs_path(MissionControl::Jobs::Current.application, jobs_status, job_class_name: nil, queue_name: nil, finished_at: nil..nil), class: "button" %>
+      </div>
+    </div>
+  <% end %>
+</div>
diff --git a/app/views/mission_control/jobs/jobs/_general_information.html.erb b/app/views/mission_control/jobs/jobs/_general_information.html.erb
new file mode 100644
index 0000000..eb78f7d
--- /dev/null
+++ b/app/views/mission_control/jobs/jobs/_general_information.html.erb
@@ -0,0 +1,71 @@
+<table class="table">
+  <tbody>
+  <tr>
+    <th><%= t("job_admin.arguments") %></th>
+    <td>
+      <div class="is-family-monospace">
+        <%= job_arguments(job) %>
+      </div>
+    </td>
+  </tr>
+  <tr>
+    <th><%= t("job_admin.job_id") %></th>
+    <td><%= job.job_id %></td>
+  </tr>
+  <tr>
+    <th><%= t("job_admin.queue") %></th>
+    <td>
+      <div class="tag">
+        <%= link_to job.queue_name, application_queue_path(@application, job.queue) %>
+      </div>
+    </td>
+  </tr>
+  <tr>
+    <th><%= t("job_admin.enqueued") %></th>
+    <td>
+      <%= t("job_admin.time_ago_html", time: (time_distance_in_words_with_title(job.enqueued_at.to_datetime))) %>
+    </td>
+  </tr>
+  <% if job.scheduled? %>
+    <tr>
+      <th><%= t("job_admin.scheduled") %></th>
+      <td>
+        <%= bidirectional_time_distance_in_words_with_title(job.scheduled_at) %>
+        <% if job_delayed?(job) %>
+          <div class="is-danger tag ml-4"><%= t("job_admin.delayed") %></div>
+        <% end %>
+      </td>
+    </tr>
+  <% end %>
+  <% if job.failed? %>
+    <tr>
+      <th><%= t("job_admin.failed") %></th>
+      <td>
+        <%= t("job_admin.time_ago_html", time: (time_distance_in_words_with_title(job.failed_at))) %>
+      </td>
+    </tr>
+  <% end %>
+  <% if job.finished_at.present? %>
+    <tr>
+      <th><%= t("job_admin.finished") %></th>
+      <td>
+        <%= t("job_admin.time_ago_html", time: (time_distance_in_words_with_title(job.finished_at))) %>
+      </td>
+    </tr>
+    <tr>
+      <th><%= t("job_admin.duration") %></th>
+      <td>
+        <%= t("job_admin.seconds", count: job.duration.round(3)) %>
+      </td>
+    </tr>
+  <% end %>
+  <% if job.worker_id.present? %>
+    <tr>
+      <th><%= t("job_admin.processed_by") %></th>
+      <td>
+        <%= link_to t("job_admin.worker_link", id: (job.worker_id)), application_worker_path(@application, job.worker_id) %>
+      </td>
+    </tr>
+  <% end %>
+  </tbody>
+</table>
