diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..6d923a2
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,40 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_current_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def with_current_locale
+      if locale = supported_locale(params[:locale])
+        session[:locale] = session[:pending_locale] = locale
+      end
+
+      I18n.with_locale(supported_locale(session[:locale]) || I18n.default_locale) do
+        # Some requests redirect before Authentication resumes the session. A
+        # choice on those pages should still be saved to the signed-in identity.
+        apply_identity_locale(Current.identity || find_session_by_cookie&.identity)
+        yield
+        response.set_header("Content-Language", I18n.locale.to_s)
+        response.set_header("Vary", (response.get_header("Vary").to_s.split(",").map(&:strip) + [ "Cookie" ]).uniq.join(", "))
+      end
+    end
+
+    def apply_identity_locale(identity)
+      if identity
+        if locale = supported_locale(session.delete(:pending_locale))
+          identity.update!(locale: locale) unless identity.locale == locale
+        end
+
+        I18n.locale = identity.preferred_locale
+        session[:locale] = I18n.locale.to_s
+      end
+    end
+
+    def supported_locale(locale)
+      locale if locale.is_a?(String) && I18n.available_locales.map(&:to_s).include?(locale)
+    end
+end
diff --git a/app/controllers/concerns/mission_control/jobs/application_scoped.rb b/app/controllers/concerns/mission_control/jobs/application_scoped.rb
new file mode 100644
index 0000000..2a5cf03
--- /dev/null
+++ b/app/controllers/concerns/mission_control/jobs/application_scoped.rb
@@ -0,0 +1,38 @@
+module MissionControl::Jobs::ApplicationScoped
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_application
+    around_action :activating_job_server
+
+    delegate :applications, to: MissionControl::Jobs
+  end
+
+  private
+    def set_application
+      @application = find_application or raise MissionControl::Jobs::Errors::ResourceNotFound, t("job_admin.application_not_found")
+      MissionControl::Jobs::Current.application = @application
+    end
+
+    def find_application
+      if params[:application_id]
+        applications[params[:application_id]]
+      else
+        applications.first
+      end
+    end
+
+    def activating_job_server(&block)
+      @server = find_server or raise MissionControl::Jobs::Errors::ResourceNotFound, t("job_admin.server_not_found")
+      MissionControl::Jobs::Current.server = @server
+      @server.activating(&block)
+    end
+
+    def find_server
+      if params[:server_id]
+        MissionControl::Jobs::Current.application.servers[params[:server_id]]
+      else
+        @application.servers.first
+      end
+    end
+end
