+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+  end
+
+  test "Japanese pages and frames render without missing translations" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    paths = [
+      root_path, board_path(board), new_board_path, edit_board_path(board),
+      cards_path, cards_path(indexed_by: "not_now", sorted_by: "oldest"),
+      card_path(card), edit_card_path(card), edit_card_board_path(card), edit_card_column_path(card),
+      new_card_assignment_path(card), new_card_tagging_path(card), new_card_reaction_path(card),
+      board_columns_closed_path(board), board_columns_not_now_path(board), board_columns_stream_path(board),
+      board_column_path(board, columns(:writebook_triage)),
+      account_settings_path, account_join_code_path, edit_account_join_code_path,
+      user_path(users(:kevin)), edit_user_path(users(:kevin)), user_events_path(users(:kevin)),
+      user_path(users(:david)), user_events_path(users(:david)), new_user_email_address_path(users(:kevin)),
+      notifications_path, tray_notifications_path, notifications_settings_path,
+      my_menu_path, my_pins_path, my_access_tokens_path, new_my_access_token_path, my_passkeys_path,
+      search_path(q: "logo"), board_webhooks_path(board), new_board_webhook_path(board)
+    ]
+
+    paths.each do |path|
+      get path
+      assert_response :success, path
+      assert_select ".translation_missing", count: 0
+      assert_no_match(/Translation missing|translation missing/, response.body, path)
+      assert_select "html:not([lang=ja])", count: 0
+
+      # These are app-owned labels, including hidden accessibility text.
+      assert_no_match(/>\s*(?:Save changes|Mark as Done|Card number|Delete this card|Skip to main content|Back to Fizzy)\s*</, response.body, path)
+    end
+  end
+
+  test "a public board honors an anonymous Japanese choice" do
+    boards(:writebook).publish
+    sign_out
+    get published_board_path(boards(:writebook), locale: :ja)
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "[data-column-name='検討中']"
+    assert_select "[data-column-name='Maybe?']", count: 0
+
+    get published_card_path(cards(:logo))
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "new signups get Japanese instructions before authentication" do
+    sign_out
+    untenanted do
+      get new_signup_path(locale: :ja)
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        post signup_path, params: { signup: { email_address: "tokyo@example.com" } }
+      end
+      assert_response :redirect
+      assert_match "Fizzyの確認コード", ActionMailer::Base.deliveries.last.subject
+      follow_redirect!
+      assert_select "html[lang=ja]"
+      assert_select "p", /分/
+    end
+  end
+end
diff --git a/test/lib/localization_test.rb b/test/lib/localization_test.rb
new file mode 100644
index 0000000..b560ffc
--- /dev/null
+++ b/test/lib/localization_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+require "yaml"
+require "nokogiri"
+
+class LocalizationCatalogTest < ActiveSupport::TestCase
+  test "Japanese covers every application message with matching interpolations" do
+    english = flatten(YAML.load_file(Rails.root.join("config/locales/en.yml")).fetch("en"))
+    japanese = flatten(YAML.load_file(Rails.root.join("config/locales/ja.yml")).fetch("ja"))
+
+    assert_equal english.keys.sort, japanese.keys.sort
+    english.each do |key, value|
+      assert_equal interpolations(value), interpolations(japanese.fetch(key)), key
+      assert_empty interpolations(value).map(&:to_sym) & I18n::RESERVED_KEYS, key
+    end
+  end
+
+  test "all application-owned visible template text uses translations" do
+    files = Dir[Rails.root.join("app/views/**/*.{html,svg,turbo_stream,text}.erb"), Rails.root.join("saas/app/views/**/*.erb")]
+    assert_not_empty files
+    files.each do |file|
+      next if file.end_with?("_theme_preference.html.erb") # JavaScript in a javascript_tag block
+      source = File.read(file).gsub(/<%.*?%>/m, "")
+      document = Nokogiri::HTML5.fragment(source)
+      document.css("script, style").remove
+      document.xpath(".//text()").each do |node|
+        value = node.text.strip
+        next if node.ancestors.any? { |ancestor| ancestor.name == "kbd" }
+        next unless value.match?(/[A-Za-z]{2}/)
+        next if value.match?(/\A(?:Fizzy[™®]?|37signals[™®]?|Basecamp™|HEY™|ESC|[\s.,!&;©—-])+\z/)
+        flunk "Untranslated text in #{file}: #{value.inspect}"
+      end
+
+      document.css("*").each do |node|
+        %w[ title alt placeholder aria-label aria-description data-text data-column-name data-bridge-title data-bridge-description data-validation-message ].each do |attribute|
+          value = node[attribute].to_s
+          next if value == "Fizzy" || !value.match?(/[A-Za-z]{2}/)
+          flunk "Untranslated #{attribute} in #{file}: #{value.inspect}"
+        end
+      end
+    end
+  end
+
+  test "static error pages present both languages without a request locale" do
+    Dir[Rails.root.join("public/*.html")].each do |file|
+      document = Nokogiri::HTML5(File.read(file))
+      assert document.at_css("[lang=en]"), file
+      assert document.at_css("[lang=ja]"), file
+      assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, document.at_css("title").text, file)
+      assert_includes document.at_css("a[href='/']").text, "Back home", file
+      assert_includes document.at_css("a[href='/']").text, "ホームに戻る", file
+    end
+  end
+
+  test "literal translation calls provide all required interpolations" do
+    require "prism"
+    catalog = YAML.load_file(Rails.root.join("config/locales/en.yml")).fetch("en")
+    files = Dir[Rails.root.join("{app,lib,saas/app}/**/*.{rb,erb}")]
+    calls = []
+    files.each do |file|
+      source = File.read(file)
+      snippets = file.end_with?(".erb") ? source.scan(/<%(?!#)(?:=|-)?(.*?)%>/m).flatten : [ source ]
+      snippets.each do |snippet|
+        collect_translation_calls(Prism.parse(snippet).value, file, calls)
+      end
+    end
+
+    assert_not_empty calls
+    calls.each do |file, key, arguments|
+      value = key.split(".").reduce(catalog) { |hash, part| hash[part] if hash.is_a?(Hash) }
+      assert_not_nil value, "Missing English key #{key} in #{file}"
+      next if arguments.any? { |argument| argument.is_a?(Prism::AssocSplatNode) }
+      options = arguments.filter_map { |argument| argument.key.unescaped if argument.is_a?(Prism::AssocNode) }
+      value = value.values.join if value.is_a?(Hash) && value.key?("other")
+      next unless value.is_a?(String)
+      assert_empty interpolations(value) - options, "Missing arguments for #{key} in #{file}"
+    end
+  end
+
+  private
+    def collect_translation_calls(node, file, calls)
+      if node.is_a?(Prism::CallNode) && %i[ t translate ].include?(node.name)
+        arguments = node.arguments&.arguments || []
+        if arguments.first.is_a?(Prism::StringNode)
+          options = arguments.grep(Prism::KeywordHashNode).flat_map(&:elements)
+          calls << [ file, arguments.first.unescaped, options ]
+        end
+      end
+      node.compact_child_nodes.each { |child| collect_translation_calls(child, file, calls) }
+    end
+
+    def flatten(hash, prefix = nil)
+      hash.each_with_object({}) do |(key, value), result|
+        key = [ prefix, key ].compact.join(".")
+        if value.is_a?(Hash)
+          result.merge!(flatten(value, key))
+        else
+          result[key] = value
+        end
+      end
+    end
+
+    def interpolations(value)
+      value.to_s.scan(/%\{(\w+)\}/).flatten.sort
+    end
+end
