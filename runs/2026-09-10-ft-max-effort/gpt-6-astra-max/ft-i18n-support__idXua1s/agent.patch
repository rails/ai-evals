+    account_export = Account::Export.create!(account: @account, user: @user)
+    user_export = User::DataExport.create!(account: @account, user: @user)
+    import = Account::Import.create!(account: @account, identity: @identity, status: :failed)
+    cancellation = Account::Cancellation.new(account: @account, initiated_by: @user)
+
+    messages = [
+      MagicLinkMailer.sign_in_instructions(magic_link),
+      ExportMailer.completed(account_export), ExportMailer.completed(user_export),
+      ImportMailer.completed(@identity, @account), ImportMailer.failed(import),
+      AccountMailer.cancellation(cancellation),
+      UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user)
+    ]
+
+    I18n.with_locale(:en) do
+      messages.each do |message|
+        assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, message.subject)
+        assert_japanese_body(message)
+        assert_equal :en, I18n.locale
+      end
+      assert_match "分", MagicLinkMailer.sign_in_instructions(magic_link).text_part.body.decoded
+    end
+  end
+
+  test "notification bundles localize dates, counts, and events in HTML and plain text" do
+    @user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: @user, creator: users(:kevin), source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+    assert_japanese_body(email)
+    assert_match "新しい通知", email.subject
+    [ email.html_part, email.text_part ].each do |part|
+      body = part.body.decoded
+      assert_match /\d+月\d+日（.+曜日）\d\d:\d\d/, body
+      assert_match "1件の新しい通知", body
+      assert_no_match(/Notifications since|new notification|Added by|Monday|January|\d+(?:am|pm)/, body)
+    end
+  end
+
+  test "queued mail uses the recipient's saved preference at delivery time" do
+    @identity.update!(locale: nil)
+    magic_link = MagicLink.create!(identity: @identity)
+    MagicLinkMailer.sign_in_instructions(magic_link).deliver_later
+    @identity.update!(locale: :ja)
+
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    assert_match "Fizzyの確認コード", ActionMailer::Base.deliveries.last.subject
+    assert_equal :en, I18n.locale
+  end
+
+  test "a Japanese job or request does not turn an English recipient's mail Japanese" do
+    @identity.update!(locale: nil)
+    I18n.with_locale(:ja) do
+      email = MagicLinkMailer.sign_in_instructions(MagicLink.create!(identity: @identity))
+      assert_match "Your Fizzy code is", email.subject
+      assert_match "Please enter this 6-character verification code", email.text_part.body.decoded
+      assert_equal :ja, I18n.locale
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  test "an anonymous choice can localize a sign-in email without modifying the identity" do
+    @identity.update!(locale: nil)
+    magic_link = MagicLink.create!(identity: @identity)
+    email = MagicLinkMailer.sign_in_instructions(magic_link, locale: :ja)
+    assert_match "Fizzyの確認コード", email.subject
+    assert_nil @identity.reload.locale
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link, locale: :xx)
+    assert_match "Your Fizzy code is", email.subject
+  end
+
+  test "HTML translations escape account names" do
+    @account.update!(name: '<img src=x onerror="alert(1)">')
+    cancellation = Account::Cancellation.new(account: @account, initiated_by: @user)
+    html = Nokogiri::HTML5(AccountMailer.cancellation(cancellation).html_part.body.decoded)
+    assert_empty html.css("img")
+    assert_includes html.text, @account.name
+  end
+
+test "Japanese links carry locale into a clean browser while English links stay unchanged" do
+  export = Account::Export.create!(account: @account, user: @user)
+  japanese = ExportMailer.completed(export)
+  assert_match "locale=ja", japanese.html_part.body.decoded
+
+  @identity.update!(locale: nil)
+  english = ExportMailer.completed(export.reload)
+  assert_no_match "locale=", english.html_part.body.decoded
+end
+
+  private
+    def assert_japanese_body(message)
+      html = Nokogiri::HTML5((message.html_part || message).body.decoded)
+      assert_equal "ja", html.at_css("html")["lang"]
+      assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, html.at_css("body").text)
+      if message.text_part
+        assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, message.text_part.body.decoded)
+      end
+    end
+end
diff --git a/test/models/localization_test.rb b/test/models/localization_test.rb
new file mode 100644
index 0000000..8c3b061
--- /dev/null
+++ b/test/models/localization_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class ModelLocalizationTest < ActiveSupport::TestCase
+  test "push payloads use the recipient language rather than the actor or job language" do
+    japanese_user = users(:kevin)
+    japanese_user.identity.update!(locale: :ja)
+    english_user = users(:david)
+    event = events(:logo_published)
+    japanese = Notification.new(user: japanese_user, creator: english_user, source: event, card: event.card)
+    english = Notification.new(user: english_user, creator: japanese_user, source: event, card: event.card)
+
+    I18n.with_locale(:en) do
+      assert_match "が追加しました", japanese.payload.body
+      assert_equal :en, I18n.locale
+    end
+    I18n.with_locale(:ja) do
+      assert_equal "Added by #{event.creator.name}", english.payload.body
+      assert_equal :ja, I18n.locale
+    end
+  end
+
+  test "broadcast fragments render in the recipient language and restore the surrounding locale" do
+    user = users(:kevin)
+    user.identity.update!(locale: :ja)
+    notification = user.notifications.find_or_initialize_by(card: cards(:logo))
+    notification.update!(creator: users(:david), source: events(:logo_published), read_at: nil)
+    pin = user.pins.find_or_create_by!(card: cards(:logo))
+
+    I18n.with_locale(:en) do
+      html = ApplicationController.render(partial: "notifications/notification", locals: { notification: notification })
+      assert_match "既読にする", html
+      assert_no_match "Mark as read", html
+
+      html = ApplicationController.render(partial: "my/pins/pin", locals: { pin: pin })
+      assert_match "このカードのピン留めを解除", html
+      assert_no_match "Unpin this card", html
+      assert_equal :en, I18n.locale
+    end
+  end
+
+  test "runtime labels do not freeze in the boot locale" do
+    I18n.with_locale(:ja) do
+      assert_equal "青", Color::COLORS.first.name
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      assert_equal "システム", users(:system).name
+      assert_equal "完了", Filter.indexed_by_human_name("closed")
+    end
+    assert_equal "Blue", Color::COLORS.first.name
+    assert_equal "Today", TimeWindowParser.human_name_for("today")
+    assert_equal "System", users(:system).name
+  end
+
+  test "Japanese-generated account names increment across language changes" do
+    identity = Identity.create!(email_address: "tokyo-team@example.com", locale: :ja)
+    generator = Signup::AccountNameGenerator.new(identity: identity, name: "田中 太郎")
+    I18n.with_locale(:ja) do
+      assert_equal "田中のFizzy", generator.generate
+      account = Account.create!(name: generator.generate)
+      account.users.create!(identity: identity, name: "田中 太郎", role: :owner)
+      identity.reload
+      assert_equal "田中のFizzy（2）", generator.generate
+    end
+    assert_equal "田中's 2nd Fizzy", generator.generate
+  end
+
+  test "Japanese onboarding is complete without replacing existing user content" do
+    account = accounts(:"37s")
+    original_title = cards(:logo).title
+    I18n.with_locale(:ja) do
+      Account::Seeder.new(account, users(:kevin)).seed
+      board = account.boards.find_by!(name: "練習用")
+      assert_equal 11, board.cards.count
+      board.cards.each do |card|
+        assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, card.title)
+        assert_match(/[\p{Hiragana}\p{Katakana}\p{Han}]/, card.description.to_plain_text)
+      end
+      assert_equal original_title, cards(:logo).reload.title
+    end
+  end
+
+  test "locale preferences are validated and unsupported stored values fail safely" do
+    identity = identities(:kevin)
+    identity.locale = "xx"
+    assert_not identity.valid?
+    assert_equal :en, identity.preferred_locale
+    identity.locale = "ja"
+    assert identity.valid?
+    assert_equal "ja", identity.preferred_locale
+  end
+end
