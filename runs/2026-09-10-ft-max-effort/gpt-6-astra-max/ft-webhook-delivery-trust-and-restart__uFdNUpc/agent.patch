+    assert_nil delivery.webhook.delinquency_tracker
+    assert_not_requested receiver
+
+    delivery.webhook.activate
+    delivery.deliver
+    assert_not_requested receiver
+  end
+
+  test "cleanup deletes expired deliveries in every state" do
+    Webhook::Delivery.update_all(created_at: 8.days.ago)
+
+    Current.without_account { Webhook::Delivery.cleanup }
+
+    assert_empty Webhook::Delivery.all
+  end
+
+  test "pending deliveries can be recovered without retrying attempted deliveries" do
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      Current.without_account { Webhook::Delivery.deliver_pending_later }
+    end
+
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ webhook_deliveries(:pending) ], queue: "webhooks"
+  end
+
+  test "sanitizing request headers is case insensitive" do
+    delivery = Webhook::Delivery.new(request: { headers: { "x-webhook-signature" => "secret", "Content-Type" => "application/json" } })
+
+    assert_equal({ "Content-Type" => "application/json" }, delivery.sanitized_request[:headers])
+  end
 end
