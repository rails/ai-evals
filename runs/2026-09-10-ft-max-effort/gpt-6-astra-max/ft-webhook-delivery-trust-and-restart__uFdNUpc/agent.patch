@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Webhook::Delivery::RequestTest < ActiveSupport::TestCase
+  setup do
+    @delivery = webhook_deliveries(:pending)
+    stub_dns_resolution "93.184.216.34"
+  end
+
+  test "POSTs the event JSON signed with the webhook secret and a stable delivery ID" do
+    sent_request = nil
+    receiver = stub_request(:post, @delivery.webhook.url).with(ipaddr: "93.184.216.34").to_return do |request|
+      sent_request = request
+      { status: 202, headers: { "X-Receiver" => "test" }, body: "not stored" }
+    end
+
+    @delivery.deliver
+
+    assert_requested receiver, times: 1
+    assert @delivery.succeeded?
+    assert_equal "application/json", sent_request.headers["Content-Type"]
+    assert_equal @delivery.id, sent_request.headers["X-Webhook-Delivery"]
+    assert_equal @delivery.event.created_at.utc.iso8601(3), sent_request.headers["X-Webhook-Timestamp"]
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", @delivery.webhook.signing_secret, sent_request.body), sent_request.headers["X-Webhook-Signature"]
+    assert_equal sent_request.headers["X-Webhook-Signature"], @delivery.request.dig(:headers, "X-Webhook-Signature")
+    assert_not @delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+
+    payload = JSON.parse(sent_request.body)
+    assert_equal @delivery.event.id, payload["id"]
+    assert_equal "card_closed", payload["action"]
+    assert_equal @delivery.event.board_id, payload.dig("board", "id")
+    assert_equal @delivery.event.creator_id, payload.dig("creator", "id")
+    assert_equal @delivery.event.eventable_id, payload.dig("eventable", "id")
+    assert_includes payload.dig("eventable", "url"), "#{@delivery.account.slug}/cards/"
+    assert_equal [ "test" ], @delivery.response.dig(:headers, "x-receiver")
+    assert_nil @delivery.response[:body]
+  end
+
+  [ 200, 201, 204, 299, 300, 400, 422, 500, 503 ].each do |code|
+    test "records HTTP #{code} without retrying" do
+      receiver = stub_request(:post, @delivery.webhook.url).to_return(status: code)
+
+      2.times { @delivery.deliver }
+
+      assert @delivery.completed?
+      assert_equal code, @delivery.response[:code]
+      assert_equal (200..299).cover?(code), @delivery.succeeded?
+      assert_equal @delivery.succeeded? ? 0 : 1, @delivery.webhook.delinquency_tracker.consecutive_failures_count
+      assert_requested receiver, times: 1
+    end
+  end
+
+  { Net::OpenTimeout => "timeout", Net::ReadTimeout => "timeout", SocketError => "destination_unreachable", OpenSSL::SSL::SSLError => "destination_unreachable" }.each do |error, summary|
+    test "logs #{error} without retrying" do
+      receiver = stub_request(:post, @delivery.webhook.url).to_raise(error)
+
+      2.times { @delivery.deliver }
+
+      assert @delivery.errored?
+      assert_equal summary, @delivery.response[:error]
+      assert_equal 1, @delivery.webhook.delinquency_tracker.consecutive_failures_count
+      assert_requested receiver, times: 1
+    end
+  end
+
+  test "redirects are logged as failures and are not followed" do
+    receiver = stub_request(:post, @delivery.webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/private" })
+    redirect = stub_request(:any, "http://127.0.0.1/private")
+
+    @delivery.deliver
+
+    assert @delivery.failed?
+    assert_equal 302, @delivery.response[:code]
+    assert_requested receiver, times: 1
+    assert_not_requested redirect
+  end
+
+  [ "127.0.0.1", "10.0.0.1", "169.254.169.254", "::1", "fd00:ec2::254", "::ffff:127.0.0.1" ].each do |address|
+    test "does not send to DNS resolving to #{address}" do
+      stub_dns_resolution address
+      receiver = stub_request(:post, @delivery.webhook.url)
+
+      @delivery.deliver
+
+      assert @delivery.errored?
+      assert_equal "destination_unreachable", @delivery.response[:error]
+      assert_not_requested receiver
+    end
+  end
+
+  test "does not send when DNS cannot resolve an address" do
+    SsrfProtection.stubs(:resolve_public_ip).returns(nil)
+    receiver = stub_request(:post, @delivery.webhook.url)
+
+    @delivery.deliver
+
+    assert @delivery.errored?
+    assert_not_requested receiver
+  end
+
+  test "rejects private IP literals without doing DNS lookups" do
+    @delivery.webhook.update!(url: "http://127.0.0.1/webhook")
+    SsrfProtection.expects(:resolve_public_ip).never
+    receiver = stub_request(:post, @delivery.webhook.url)
+
+    @delivery.deliver
+
+    assert @delivery.errored?
+    assert_not_requested receiver
+  end
+
+  test "allows public IP literals and preserves the request path and query" do
+    @delivery.webhook.update!(url: "http://93.184.216.34:8080/webhook?token=test")
+    receiver = stub_request(:post, @delivery.webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 204)
+    SsrfProtection.expects(:resolve_public_ip).never
+
+    @delivery.deliver
+
+    assert @delivery.succeeded?
+    assert_requested receiver, times: 1
+  end
+end
