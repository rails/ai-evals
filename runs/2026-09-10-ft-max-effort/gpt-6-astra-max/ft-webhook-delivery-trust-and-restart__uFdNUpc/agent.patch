+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    # Keep the outbox in the event's transaction; delivery jobs run after commit.
+    after_create :relay_to_webhooks
+  end
+
+  private
+    def relay_to_webhooks
+      board.webhooks.active.find_each do |webhook|
+        webhook.trigger(self)
+      end
+    end
+end
