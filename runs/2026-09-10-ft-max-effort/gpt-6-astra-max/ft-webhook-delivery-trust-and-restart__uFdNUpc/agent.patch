+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution "93.184.216.34"
+  end
+
+  test "committed board events are delivered and logged" do
+    webhook = webhooks(:active)
+    receiver = stub_request(:post, webhook.url).to_return(status: 204)
+    event = nil
+
+    perform_enqueued_jobs(only: Webhook::DeliveryJob) do
+      event = cards(:logo).track_event(:closed, creator: users(:david))
+    end
+
+    delivery = event.webhook_deliveries.sole
+    assert_equal webhook, delivery.webhook
+    assert_equal event.account, delivery.account
+    assert delivery.succeeded?
+    assert_equal 204, delivery.response[:code]
+    assert_requested receiver, times: 1
+  end
+
+  test "rolled back events do not enqueue deliveries" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        Event.transaction do
+          cards(:logo).track_event(:closed, creator: users(:david))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+  test "only active subscriptions on the event board are triggered" do
+    board = boards(:writebook)
+    matching = board.webhooks.create!(name: "Second receiver", url: "https://second.example.com", subscribed_actions: [ "card_closed" ])
+    board.webhooks.create!(name: "Other action", url: "https://other.example.com", subscribed_actions: [ "comment_created" ])
+    board.webhooks.create!(name: "Disabled", url: "https://disabled.example.com", subscribed_actions: [ "card_closed" ], active: false)
+    boards(:private).webhooks.create!(name: "Other board", url: "https://private.example.com", subscribed_actions: [ "card_closed" ])
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      event = cards(:logo).track_event(:closed, creator: users(:david))
+      assert_equal [ webhooks(:active).id, matching.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+    end
+  end
+
+  test "comment creation is relayed when subscribed" do
+    webhooks(:active).update!(subscribed_actions: [ "comment_created" ])
+
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      comment = cards(:logo).comments.create!(body: "A useful update", creator: users(:david))
+      delivery = comment.events.sole.webhook_deliveries.sole
+      assert_equal "comment_created", delivery.event.action
+    end
+  end
+
+  test "unsubscribed events do not create deliveries" do
+    assert_no_difference "Webhook::Delivery.count" do
+      cards(:logo).track_event(:reopened, creator: users(:david))
+    end
+  end
+
+  test "deliveries are not enqueued before the event commits" do
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      Event.transaction do
+        assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+          cards(:logo).track_event(:closed, creator: users(:david))
+        end
+      end
+    end
+  end
+
+  test "persistent failed POSTs disable a receiver and stop future events" do
+    freeze_time
+    webhook = webhooks(:active)
+    receiver = stub_request(:post, webhook.url).to_return(status: 503)
+
+    perform_enqueued_jobs(only: Webhook::DeliveryJob) do
+      cards(:logo).track_event(:closed, creator: users(:david))
+      travel 1.hour
+      9.times { cards(:logo).track_event(:closed, creator: users(:david)) }
+    end
+
+    assert_not webhook.reload.active?
+    assert_requested receiver, times: 10
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      event = cards(:logo).track_event(:closed, creator: users(:david))
+      assert_empty event.webhook_deliveries
+    end
+  end
+end
