+require "test_helper"
+
+class Webhook::Delivery::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_assignment_jz)
+    @url_options = Rails.application.routes.default_url_options.dup
+    Rails.application.routes.default_url_options = { host: "fizzy.example.com", protocol: "https", port: 8443 }
+  end
+
+  teardown do
+    Rails.application.routes.default_url_options = @url_options
+  end
+
+  test "uses the event account for links and restores the calling context" do
+    Current.set(account: accounts(:initech), user: users(:mike)) do
+      payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, @event).to_json)
+
+      assert_equal [ users(:jz).id ], payload.dig("particulars", "assignee_ids")
+      assert_equal "https://fizzy.example.com:8443#{@event.account.slug}/cards/#{@event.card.number}", payload.dig("eventable", "url")
+      assert_equal accounts(:initech), Current.account
+      assert_equal users(:mike), Current.user
+    end
+  end
+
+  test "includes the comment body and card in comment payloads" do
+    event = events(:layout_commented)
+    payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, event).to_json)
+
+    assert_equal "comment_created", payload["action"]
+    assert_equal event.eventable.id, payload.dig("eventable", "id")
+    assert_equal event.eventable.body.to_plain_text, payload.dig("eventable", "body", "plain_text")
+    assert_equal event.card.id, payload.dig("eventable", "card", "id")
+  end
+
+  test "Slack receives plain text with a link, not the generic event object" do
+    @webhook.url = "https://hooks.slack.com/services/T123/B456/token" # gitleaks:allow
+    payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, @event).to_json)
+
+    assert_equal [ "text" ], payload.keys
+    assert_includes payload["text"], %Q("#{@event.card.title}")
+    assert_includes payload["text"], "<https://fizzy.example.com:8443#{@event.account.slug}/cards/#{@event.card.number}|View in Fizzy>"
+  end
+
+  test "Slack links can use the configured mailer host in development" do
+    Rails.application.routes.default_url_options = {}
+    @webhook.url = "https://hooks.slack.com/services/T123/B456/token" # gitleaks:allow
+    payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, @event).to_json)
+
+    assert_includes payload["text"], "http://example.com#{@event.account.slug}/cards/"
+  end
+
+  [ "https://chat.example.com/rooms/123/456-token/messages", "https://3.basecamp.com/123/integrations/token/buckets/456/chats/789/lines" ].each do |url|
+    test "#{url} receives HTML content with an account-scoped link" do
+      @webhook.url = url
+      payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, @event).to_json)
+      content = Nokogiri::HTML.fragment(payload.fetch("content"))
+
+      assert_equal [ "content" ], payload.keys
+      assert_includes content.text, @event.card.title
+      assert_equal "https://fizzy.example.com:8443#{@event.account.slug}/cards/#{@event.card.number}", content.at("a")["href"]
+    end
+  end
+end
