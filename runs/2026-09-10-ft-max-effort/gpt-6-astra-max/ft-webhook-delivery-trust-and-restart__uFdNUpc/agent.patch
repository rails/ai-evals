--- /dev/null
+++ b/test/models/webhook/delivery/concurrency_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Webhook::Delivery::ConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    stub_dns_resolution "93.184.216.34"
+  end
+
+  test "parallel workers can only claim a delivery once" do
+    delivery = webhook_deliveries(:pending)
+    receiver = stub_request(:post, delivery.webhook.url).to_return(status: 503)
+
+    in_parallel do
+      Webhook::Delivery.find(delivery.id).deliver
+    end
+
+    assert delivery.reload.completed?
+    assert_requested receiver, times: 1
+    assert_equal 1, delivery.webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "parallel triggers create only one outbox entry" do
+    webhook = webhooks(:active)
+    event = events(:logo_assignment_david)
+
+    assert_difference -> { Webhook::Delivery.uncached { Webhook::Delivery.count } }, 1 do
+      in_parallel do
+        Webhook.find(webhook.id).trigger(Event.find(event.id))
+      end
+    end
+  end
+
+  test "concurrent failures do not lose increments" do
+    webhook = webhooks(:active)
+    deliveries = %i[ logo_assignment_david layout_assignment_jz text_published ].map do |event|
+      webhook.trigger(events(event))
+    end
+    receiver = stub_request(:post, webhook.url).to_return(status: 503)
+
+    in_parallel do |index|
+      deliveries[index].deliver
+    end
+
+    assert_requested receiver, times: 3
+    assert_equal 3, webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  private
+    def in_parallel
+      ready = Queue.new
+      start = Queue.new
+      threads = 3.times.map do |index|
+        Thread.new do
+          Rails.application.executor.wrap do
+            ActiveRecord::Base.connection_pool.with_connection do
+              ready << true
+              start.pop
+              yield index
+            end
+          end
+        end
+      end
+
+      3.times { ready.pop }
+      3.times { start << true }
+      threads.each(&:value)
+    ensure
+      threads&.each(&:join)
+    end
+end
