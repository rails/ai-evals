@@ -0,0 +1,41 @@
+require "cgi"
+
+class Webhook::Delivery::Payload
+  # Workers may render the process's first views in parallel. Initialize the
+  # shared template container once, while this class is being loaded.
+  ApplicationController.eager_load!
+
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def to_json
+    Current.set(account: event.account, user: nil) do
+      if webhook.for_slack?
+        { text: "#{slack_description} <#{event_url}|View in Fizzy>" }.to_json
+      elsif webhook.for_campfire? || webhook.for_basecamp?
+        { content: render(:html) }.to_json
+      else
+        render(:json)
+      end
+    end
+  end
+
+  private
+    def slack_description
+      CGI.unescapeHTML(event.description_for(nil).to_plain_text).gsub(/[&<>]/, "&" => "&amp;", "<" => "&lt;", ">" => "&gt;")
+    end
+
+    def event_url
+      options = Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options || {}
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **options, script_name: event.account.slug)
+    end
+
+    def render(format)
+      ApplicationController.renderer.new(script_name: event.account.slug).render(
+        template: "webhooks/event", formats: [ format ], assigns: { event: event }, layout: false
+      )
+    end
+end
diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..e74ae7f
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,78 @@
+require "ipaddr"
+require "net/http"
+require "openssl"
+require "resolv"
+require "timeout"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 10
+
+  attr_reader :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Delivery" => delivery.id,
+      "X-Webhook-Timestamp" => delivery.event.created_at.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body)
+    }
+  end
+
+  def body
+    @body ||= Webhook::Delivery::Payload.new(delivery.webhook, delivery.event).to_json
+  end
+
+  def perform
+    Timeout.timeout(TIMEOUT) do
+      uri = URI.parse(delivery.webhook.url)
+
+      if uri.is_a?(URI::HTTP) && uri.host.present? && uri.userinfo.nil?
+        if ip = resolve_public_ip(uri.hostname)
+          post(uri, ip)
+        else
+          { error: "destination_unreachable" }
+        end
+      else
+        { error: "invalid_url" }
+      end
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::ProtocolError, Resolv::ResolvError
+    { error: "destination_unreachable" }
+  rescue URI::InvalidURIError
+    { error: "invalid_url" }
+  end
+
+  private
+    def resolve_public_ip(hostname)
+      address = IPAddr.new(hostname)
+      address.to_s unless SsrfProtection.blocked_address?(address)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(hostname)
+    end
+
+    def post(uri, ip)
+      # Pin the vetted IP while retaining the hostname for Host and TLS/SNI.
+      # Neither environment proxies nor redirects may bypass the SSRF check.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      response = http.request(request) do |response|
+        # Do not retain an untrusted, potentially very large response body.
+        response.read_body { |_chunk| }
+      end
+      { code: response.code.to_i, headers: response.to_hash }
+    end
+end
