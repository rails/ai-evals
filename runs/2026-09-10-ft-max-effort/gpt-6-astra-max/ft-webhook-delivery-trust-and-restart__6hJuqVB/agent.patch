--- /dev/null
+++ b/test/integration/board_webhooks_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class BoardWebhooksTest < ActiveSupport::TestCase
+  setup do
+    VCR.turn_off!
+    WebMock.disable_net_connect!
+    @webhook = webhooks(:active)
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  teardown do
+    WebMock.allow_net_connect!
+    VCR.turn_on!
+  end
+
+  test "a board event is posted and its result is logged" do
+    post = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 201)
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      perform_enqueued_jobs(only: [ Event::RelayJob, Webhook::DeliveryJob ]) do
+        @event = cards(:logo).track_event(:published, creator: users(:david))
+      end
+    end
+
+    delivery = @webhook.deliveries.find_by!(event: @event)
+    assert delivery.succeeded?, "#{delivery.state}: #{delivery.response.inspect}"
+    assert_equal 201, delivery.response[:code]
+    assert_requested post, times: 1
+    assert_requested(:post, @webhook.url) do |request|
+      payload = JSON.parse(request.body)
+      assert_equal @event.id, payload["id"]
+      assert_equal "card_published", payload["action"]
+      assert_equal @event.board_id, payload.dig("board", "id")
+      assert_includes payload.dig("eventable", "url"), "#{@event.account.slug}/cards/"
+      assert_equal delivery.id, request.headers["X-Webhook-Id"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+    end
+  end
+  test "replaying both jobs does not post the event again" do
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs(only: [ Event::RelayJob, Webhook::DeliveryJob ]) do
+      @event = cards(:logo).track_event(:published, creator: users(:david))
+    end
+    delivery = @webhook.deliveries.find_by!(event: @event)
+
+    perform_enqueued_jobs(only: [ Event::RelayJob, Webhook::DeliveryJob ]) do
+      2.times { Event::RelayJob.perform_later(@event) }
+      2.times { Webhook::DeliveryJob.perform_later(delivery) }
+    end
+
+    assert_equal 1, @webhook.deliveries.where(event: @event).count
+    assert_requested post, times: 1
+  end
+
+  test "a failing receiver is switched off and later events are not sent" do
+    post = stub_request(:post, @webhook.url).to_return(status: 503)
+    freeze_time
+
+    perform_enqueued_jobs(only: [ Event::RelayJob, Webhook::DeliveryJob ]) do
+      9.times { cards(:logo).track_event(:published, creator: users(:david)) }
+    end
+    assert @webhook.reload.active?
+
+    travel 1.hour do
+      perform_enqueued_jobs(only: [ Event::RelayJob, Webhook::DeliveryJob ]) do
+        2.times { cards(:logo).track_event(:published, creator: users(:david)) }
+      end
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+      assert_requested post, times: 10
+    end
+  end
+
+  test "a comment produces one delivery with its body" do
+    @webhook.update! subscribed_actions: [ "comment_created" ]
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      perform_enqueued_jobs(only: [ Event::RelayJob, Webhook::DeliveryJob ]) do
+        @comment = cards(:logo).comments.create!(creator: users(:david), body: "A webhook comment")
+      end
+    end
+
+    assert_requested post, times: 1
+    assert_requested(:post, @webhook.url) do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "comment_created", payload["action"]
+      assert_equal @comment.id, payload.dig("eventable", "id")
+      assert_equal "A webhook comment", payload.dig("eventable", "body", "plain_text")
+    end
+  end
+end
diff --git a/test/models/event/relaying_test.rb b/test/models/event/relaying_test.rb
new file mode 100644
index 0000000..1fdeda7
--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+  end
+
+  test "committed events enqueue a relay job in their account" do
+    event = create_event
+
+    assert_enqueued_with job: Event::RelayJob, args: [ event ]
+    job = enqueued_jobs.find { |job| job[:job] == Event::RelayJob }
+    assert_equal event.account.to_gid.to_s, job["account"].to_s
+  end
+
+  test "rolled back events do not enqueue a relay" do
+    assert_no_enqueued_jobs only: Event::RelayJob do
+      Event.transaction(requires_new: true) do
+        create_event
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "only active webhooks subscribed to this board event are triggered" do
+    other_action = @webhook.board.webhooks.create!(name: "Other action", url: @webhook.url, subscribed_actions: [ "card_closed" ])
+    inactive = @webhook.board.webhooks.create!(name: "Inactive", url: @webhook.url, active: false, subscribed_actions: [ "card_published" ])
+    webhooks(:inactive).activate
+    event = create_event
+
+    assert_difference "Webhook::Delivery.count", +1 do
+      event.relay_now
+    end
+
+    assert @webhook.deliveries.exists?(event: event)
+    assert_empty other_action.deliveries
+    assert_empty inactive.deliveries
+    assert_empty webhooks(:inactive).deliveries
+  end
+
+  test "replaying an event creates only one delivery per webhook" do
+    event = create_event
+
+    assert_difference "Webhook::Delivery.count", +1 do
+      2.times { Event.find(event.id).relay_now }
+    end
+  end
+
+  test "empty subscriptions never trigger deliveries" do
+    @webhook.update! subscribed_actions: []
+
+    assert_no_difference "Webhook::Delivery.count" do
+      create_event.relay_now
+    end
+  end
+
+  test "unpermitted events do not enqueue a relay" do
+    assert_no_enqueued_jobs only: Event::RelayJob do
+      cards(:logo).track_event(:title_changed, creator: users(:david))
+    end
+  end
+
+  test "events without active board webhooks do not enqueue a relay" do
+    @webhook.deactivate
+
+    assert_no_enqueued_jobs only: Event::RelayJob do
+      create_event
+    end
+  end
+
+  test "triggers cannot cross boards or accounts" do
+    event = create_event
+
+    assert_no_difference "Webhook::Delivery.count" do
+      event.board = boards(:private)
+      @webhook.trigger(event)
+
+      event.board = @webhook.board
+      event.account = accounts(:initech)
+      @webhook.trigger(event)
+    end
+  end
+
+  test "expired events cannot be replayed after their delivery logs are cleaned up" do
+    event = create_event
+    event.relay_now
+
+    travel 1.week + 1.second do
+      Webhook::Delivery.cleanup
+
+      assert_no_difference "Webhook::Delivery.count" do
+        event.relay_now
+      end
+    end
+  end
+
+  test "concurrent relays create only one delivery" do
+    event = create_event
+    account = event.account
+    start = Queue.new
+    workers = 5.times.map do
+      Thread.new do
+        start.pop
+        ActiveRecord::Base.connection_pool.with_connection do
+          Current.with_account(account) { Event.find(event.id).relay_now }
+        end
+      end
+    end
+
+    assert_difference "Webhook::Delivery.count", +1 do
+      5.times { start << true }
+      workers.each(&:value)
+    end
+  end
+
+  test "deleted events are discarded by relay jobs" do
+    event = create_event
+    event.destroy!
+
+    assert_no_difference "Webhook::Delivery.count" do
+      perform_enqueued_jobs only: Event::RelayJob
+    end
+  end
+
+  private
+    def create_event
+      cards(:logo).track_event(:published, creator: users(:david))
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..aa5ced1
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @failure = webhook_deliveries(:unsuccessfully_completed)
+    @success = webhook_deliveries(:successfully_completed)
+    freeze_time
+  end
+
+  test "ten consecutive failures over an hour deactivate the webhook" do
+    @webhook.record_delivery(@failure)
+    first_failure_at = Time.current
+
+    travel 1.hour do
+      8.times { @webhook.record_delivery(@failure) }
+      assert @webhook.reload.active?
+
+      @webhook.record_delivery(@failure)
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+      assert_equal first_failure_at, @webhook.delinquency_tracker.first_failure_at
+      assert_equal @webhook.account, @webhook.delinquency_tracker.account
+    end
+  end
+
+  test "ten failures in less than an hour do not deactivate the webhook" do
+    10.times { @webhook.record_delivery(@failure) }
+
+    travel 1.hour - 1.second do
+      @webhook.record_delivery(@failure)
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "an hour of failures without ten attempts does not deactivate the webhook" do
+    @webhook.record_delivery(@failure)
+
+    travel 2.hours do
+      8.times { @webhook.record_delivery(@failure) }
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "success resets both the failure counter and the start of the streak" do
+    9.times { @webhook.record_delivery(@failure) }
+
+    travel 1.hour do
+      @webhook.record_delivery(@success)
+      assert_equal 0, @webhook.reload.delinquency_tracker.consecutive_failures_count
+      assert_nil @webhook.delinquency_tracker.first_failure_at
+
+      @webhook.record_delivery(@failure)
+      assert @webhook.reload.active?
+      assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+      assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+    end
+  end
+
+  test "reactivation resets the failure streak" do
+    10.times { @webhook.record_delivery(@failure) }
+    @webhook.deactivate
+
+    travel 2.hours do
+      @webhook.activate
+
+      assert @webhook.reload.active?
+      assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+      assert_nil @webhook.delinquency_tracker.first_failure_at
+
+      @webhook.record_delivery(@failure)
+      assert @webhook.reload.active?
+      assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+    end
+  end
+
+  test "incomplete deliveries are not counted as failures" do
+    @webhook.record_delivery(webhook_deliveries(:pending))
+    @webhook.record_delivery(webhook_deliveries(:in_progress))
+
+    assert_equal 0, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "destroying the webhook removes its tracker and delivery log" do
+    @webhook.record_delivery(@failure)
+    tracker = @webhook.delinquency_tracker
+
+    @webhook.destroy!
+
+    assert_not Webhook::DelinquencyTracker.exists?(tracker.id)
+    assert_not Webhook::Delivery.exists?(webhook_id: @webhook.id)
+  end
+end
diff --git a/test/models/webhook/delivery_cleanup_test.rb b/test/models/webhook/delivery_cleanup_test.rb
