+++ b/test/models/webhook/delivery_dispatch_test.rb
@@ -0,0 +1,252 @@
+require "test_helper"
+
+class Webhook::DeliveryDispatchTest < ActiveSupport::TestCase
+  setup do
+    VCR.turn_off!
+    WebMock.disable_net_connect!
+    stub_dns_resolution("93.184.216.34")
+    @delivery = webhook_deliveries(:pending)
+    @webhook = @delivery.webhook
+  end
+
+  teardown do
+    WebMock.allow_net_connect!
+    VCR.turn_on!
+  end
+
+  [ 200, 201, 204, 299 ].each do |status|
+    test "HTTP #{status} is a successful completed delivery" do
+      post = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34")
+        .to_return(status: status, headers: { "X-Request-Id" => "receiver-request-id" })
+
+      @delivery.deliver_now
+
+      assert @delivery.reload.completed?
+      assert @delivery.succeeded?
+      assert_not @delivery.failed?
+      assert_equal status, @delivery.response[:code]
+      assert_equal [ "receiver-request-id" ], @delivery.response.dig("headers", "x-request-id")
+      assert_requested post, times: 1
+    end
+  end
+
+  [ 301, 302, 400, 422, 429, 500, 503 ].each do |status|
+    test "HTTP #{status} is logged as a failure without retrying or following redirects" do
+      post = stub_request(:post, @webhook.url).to_return(status: status, headers: { "Location" => "http://127.0.0.1/private" })
+
+      2.times { @delivery.deliver_now }
+
+      assert @delivery.reload.completed?
+      assert @delivery.failed?
+      assert_equal status, @delivery.response[:code]
+      assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+      assert_requested post, times: 1
+    end
+  end
+
+  [ Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout ].each do |error|
+    test "#{error} is logged without retrying" do
+      post = stub_request(:post, @webhook.url).to_raise(error)
+
+      2.times { @delivery.deliver_now }
+
+      assert @delivery.reload.errored?
+      assert_equal "timeout", @delivery.response[:error]
+      assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+      assert_requested post, times: 1
+    end
+  end
+
+  [ SocketError, Errno::ECONNREFUSED, Errno::ECONNRESET, EOFError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse ].each do |error|
+    test "#{error} is logged as an unreachable destination" do
+      post = stub_request(:post, @webhook.url).to_raise(error)
+
+      @delivery.deliver_now
+
+      assert @delivery.reload.errored?
+      assert_equal "destination_unreachable", @delivery.response[:error]
+      assert_requested post, times: 1
+    end
+  end
+
+  test "queued copies of a delivery only post once" do
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+    2.times { @delivery.deliver_later }
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert @delivery.reload.succeeded?
+    assert_requested post, times: 1
+  end
+
+  test "a stale worker cannot send a delivery claimed by another worker" do
+    duplicate = Webhook::Delivery.find(@delivery.id)
+    post = stub_request(:post, @webhook.url).to_return do
+      assert @delivery.reload.in_progress?
+      duplicate.deliver_now
+      { status: 200 }
+    end
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.succeeded?
+    assert_requested post, times: 1
+  end
+
+  test "deliveries already in progress or finished are not sent" do
+    %i[ in_progress successfully_completed unsuccessfully_completed errored ].each do |name|
+      webhook_deliveries(name).deliver_now
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "queued deliveries are not sent after deactivation" do
+    @webhook.deactivate
+    @delivery.deliver_now
+
+    assert @delivery.reload.errored?
+    assert_equal "webhook_inactive", @delivery.response[:error]
+    assert_nil @webhook.reload.delinquency_tracker
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "expired pending deliveries are not sent" do
+    @delivery.update! created_at: 1.week.ago - 1.second
+    @delivery.deliver_now
+
+    assert @delivery.reload.pending?
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "private destinations are blocked before making a request" do
+    stub_dns_resolution("127.0.0.1", "169.254.169.254", "10.1.1.1", "::1")
+    Net::HTTP.expects(:new).never
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "unresolvable destinations are logged" do
+    stub_dns_resolution
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "deleted deliveries are discarded by queued jobs" do
+    @delivery.deliver_later
+    @delivery.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+    assert_not_requested :post, @webhook.url
+  end
+  test "connections disable proxies and retries and have bounded timeouts" do
+    connection = Net::HTTP.new("api.example.com", 443, nil)
+    Net::HTTP.expects(:new).with("api.example.com", 443, nil).returns(connection)
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_equal "93.184.216.34", connection.ipaddr
+    assert connection.use_ssl?
+    assert_equal 0, connection.max_retries
+    assert_equal Webhook::Delivery::Request::TIMEOUT, connection.open_timeout
+    assert_equal Webhook::Delivery::Request::TIMEOUT, connection.read_timeout
+    assert_equal Webhook::Delivery::Request::TIMEOUT, connection.write_timeout
+    assert_requested post, times: 1
+  end
+
+  test "the overall deadline also bounds DNS resolution" do
+    Timeout.expects(:timeout).with(Webhook::Delivery::Request::TOTAL_TIMEOUT).raises(Timeout::Error)
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.errored?
+    assert_equal "timeout", @delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "HTTP destinations preserve their port path and query string" do
+    @webhook.update! url: "http://receiver.example.com:8080/events?token=example"
+    post = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 204)
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.succeeded?
+    assert_requested post, times: 1
+  end
+
+  test "public IP literals can receive deliveries without a DNS lookup" do
+    @webhook.update! url: "https://93.184.216.34/events"
+    Resolv::DNS.expects(:open).never
+    post = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.succeeded?
+    assert_requested post, times: 1
+  end
+
+  test "private IP literals cannot bypass destination validation" do
+    @webhook.update! url: "http://[::ffff:127.0.0.1]/private"
+    Resolv::DNS.expects(:open).never
+    Net::HTTP.expects(:new).never
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "payload errors are logged and reported without sending or retrying" do
+    error = RuntimeError.new("Cannot render the event")
+    Webhook::Payload.any_instance.expects(:to_json).once.raises(error)
+    Rails.error.expects(:report).with(error)
+
+    2.times { @delivery.deliver_now }
+
+    assert @delivery.reload.errored?
+    assert_equal "delivery_error", @delivery.response[:error]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert_not_requested :post, @webhook.url
+  end
+  test "concurrent workers make only one POST" do
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+    start = Queue.new
+    workers = 5.times.map do
+      Thread.new do
+        start.pop
+        ActiveRecord::Base.connection_pool.with_connection do
+          Webhook::Delivery.find(@delivery.id).deliver_now
+        end
+      end
+    end
+
+    5.times { start << true }
+    workers.each(&:value)
+
+    assert @delivery.reload.succeeded?
+    assert_requested post, times: 1
+  end
+
+  test "failure to save a result cannot cause the POST to be repeated" do
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+    @delivery.stubs(:record_result).raises(ActiveRecord::ConnectionNotEstablished)
+
+    assert_raises ActiveRecord::ConnectionNotEstablished do
+      @delivery.deliver_now
+    end
+    Webhook::Delivery.find(@delivery.id).deliver_now
+
+    assert @delivery.reload.in_progress?
+    assert_requested post, times: 1
+  end
+end
