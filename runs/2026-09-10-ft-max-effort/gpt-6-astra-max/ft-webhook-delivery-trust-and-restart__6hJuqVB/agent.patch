@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Webhook::DeliveryCleanupTest < ActiveSupport::TestCase
+  test "cleanup removes logs older than one week regardless of state or account" do
+    freeze_time
+    Webhook::Delivery.update_all(created_at: Time.current)
+    expired = webhook_deliveries(:successfully_completed)
+    expired_pending = webhook_deliveries(:pending)
+    boundary = webhook_deliveries(:errored)
+    recent = webhook_deliveries(:in_progress)
+
+    expired.update! created_at: 1.week.ago - 1.second
+    expired_pending.update! created_at: 1.week.ago - 1.second
+    boundary.update! created_at: 1.week.ago
+    recent.update! created_at: 1.week.ago + 1.second
+
+    Current.with_account(accounts(:initech)) do
+      assert_difference "Webhook::Delivery.count", -2 do
+        Webhook::Delivery.cleanup
+      end
+    end
+
+    assert_not Webhook::Delivery.exists?(expired.id)
+    assert_not Webhook::Delivery.exists?(expired_pending.id)
+    assert Webhook::Delivery.exists?(boundary.id)
+    assert Webhook::Delivery.exists?(recent.id)
+
+    assert_no_difference "Webhook::Delivery.count" do
+      Webhook::Delivery.cleanup
+    end
+  end
+
+  test "a webhook event pair is unique in the database" do
+    delivery = webhook_deliveries(:pending)
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(webhook: delivery.webhook, event: delivery.event)
+    end
+  end
+
+  test "a webhook has only one delinquency tracker" do
+    webhook = webhooks(:active)
+    webhook.create_delinquency_tracker!
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::DelinquencyTracker.create!(webhook: webhook)
+    end
+  end
+end
diff --git a/test/models/webhook/delivery_dispatch_test.rb b/test/models/webhook/delivery_dispatch_test.rb
