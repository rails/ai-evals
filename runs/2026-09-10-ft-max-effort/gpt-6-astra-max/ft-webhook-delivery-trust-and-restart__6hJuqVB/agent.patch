+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_published)
+  end
+
+  test "JSON includes card and event data with account scoped URLs" do
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_equal @event.id, payload["id"]
+    assert_equal @event.action, payload["action"]
+    assert_equal @event.creator_id, payload.dig("creator", "id")
+    assert_equal @event.eventable_id, payload.dig("eventable", "id")
+    assert_equal @event.board_id, payload.dig("board", "id")
+    assert_equal "http://example.com#{@event.account.slug}/cards/#{@event.card.number}", payload.dig("eventable", "url")
+  end
+
+  test "comment events include the comment body and card" do
+    event = events(:layout_commented)
+    payload = JSON.parse(Webhook::Payload.new(@webhook, event).to_json)
+
+    assert_equal event.eventable_id, payload.dig("eventable", "id")
+    assert_equal event.eventable.body.to_plain_text, payload.dig("eventable", "body", "plain_text")
+    assert_equal event.card.id, payload.dig("eventable", "card", "id")
+  end
+
+  test "URLs use the configured host protocol and port" do
+    options = Rails.application.routes.default_url_options.dup
+    Rails.application.routes.default_url_options = { host: "fizzy.example.org", protocol: "https", port: 8443 }
+
+    payload = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_equal "https://fizzy.example.org:8443#{@event.account.slug}/cards/#{@event.card.number}", payload.dig("eventable", "url")
+  ensure
+    Rails.application.routes.default_url_options = options
+  end
+
+  test "Slack receives a text message with a link" do
