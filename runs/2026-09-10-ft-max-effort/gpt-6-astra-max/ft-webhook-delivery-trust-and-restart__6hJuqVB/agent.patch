diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..7e8f205
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,76 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 5.seconds
+  TOTAL_TIMEOUT = 15.seconds
+
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Id" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def perform
+    Timeout.timeout(TOTAL_TIMEOUT) do
+      uri = URI.parse(webhook.url)
+
+      if uri.scheme.in?(Webhook::PERMITTED_SCHEMES) && uri.host.present?
+        if ip_address = public_ip(uri.hostname)
+          post(uri, ip_address)
+        else
+          { error: "destination_unreachable" }
+        end
+      else
+        { error: "invalid_url" }
+      end
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::OpenSSLError, Resolv::ResolvError, Net::ProtocolError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError
+    { error: "destination_unreachable" }
+  rescue URI::InvalidURIError
+    { error: "invalid_url" }
+  end
+
+  private
+    def body
+      @body ||= Webhook::Payload.new(webhook, event).to_json
+    end
+
+    def public_ip(hostname)
+      ip_address = IPAddr.new(hostname)
+      ip_address.to_s unless SsrfProtection.blocked_address?(ip_address)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(hostname)
+    end
+
+    def post(uri, ip_address)
+      # Don't use environment proxies or resolve the hostname again after the
+      # SSRF check. Keep the hostname for Host, TLS SNI, and certificate checks.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip_address
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http.request(request) do |response|
+        # Close the connection without buffering an untrusted response body.
+        return { code: response.code.to_i, headers: response.to_hash }
+      end
+    end
+end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..eaf6760
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,40 @@
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def to_json
+    if webhook.for_slack?
+      { text: slack_text }.to_json
+    elsif webhook.for_campfire? || webhook.for_basecamp?
+      { content: render(:html) }.to_json
+    else
+      render(:json)
+    end
+  end
+
+  private
+    def slack_text
+      description = CGI.unescapeHTML(event.description_for(nil).to_plain_text)
+        .gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
+      url = Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+      "#{description}\n<#{url}|View in Fizzy>"
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      base_options.merge(script_name: event.account.slug)
+    end
+
+    def render(format)
+      ApplicationController.renderer.new(
+        http_host: [ url_options[:host], url_options[:port] ].compact.join(":"),
+        https: url_options[:protocol].to_s.delete_suffix("://") == "https",
+        script_name: event.account.slug
+      ).render(template: "webhooks/event", formats: [ format ], assigns: { event: event }, layout: false)
+    end
+end
