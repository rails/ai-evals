diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..d007dc9
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,24 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    with_lock do
+      publication || create_publication!
+    end
+  end
+
+  def unpublish
+    with_lock do
+      publication&.destroy!
+      reload_publication
+    end
+  end
+end
