+  test "pagination keeps using the public key and only returns published cards" do
+    Current.set(user: users(:kevin)) do
+      20.times { |index| @board.cards.create!(title: "Public card #{index}", status: :published) }
+      @board.cards.create!(title: "Secret draft", status: :drafted)
+    end
+    expected_numbers = @board.cards.published.latest.with_golden_first.pluck(:number)
+    actual_numbers = []
+    next_page = public_board_path(@key)
