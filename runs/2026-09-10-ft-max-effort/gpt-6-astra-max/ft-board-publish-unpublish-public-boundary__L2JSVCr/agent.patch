diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..62b3564
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,71 @@
+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "Back to #{@board.name}", public_board_path(@publication.key), class: "btn btn--back" %>
+  </div>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <header class="card__header">
+        <%= link_to @board.name, public_board_path(@publication.key) %>
+        <span class="card__id">#<%= @card.number %></span>
+        <% if @card.triaged? %>
+          <%= link_to @card.column.name, public_board_column_path(@publication.key, @card.column), class: "card__column-name" %>
+        <% end %>
+        <% @card.tags.each do |tag| %>
+          <span class="card__tag"><%= tag.title %></span>
+        <% end %>
+      </header>
+
+      <div class="card__body">
+        <div class="card__content">
+          <h1 class="card__title"><%= card_html_title(@card) %></h1>
+          <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+            <%= @card.description %>
+          </div>
+          <% if @card.steps.any? %>
+            <ol class="steps txt-small">
+              <% @card.steps.each do |step| %>
+                <li class="step">
+                  <%= check_box_tag nil, nil, step.completed?, disabled: true, class: "checkbox", aria: { label: step.content } %>
+                  <span class="step__content"><%= step.content %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        </div>
+        <%= render "cards/display/common/stamp", card: @card %>
+      </div>
+
+      <footer class="card__footer">
+        <span class="card__meta">
+          Added by <%= @card.creator.familiar_name %>
+          <%= local_datetime_tag @card.created_at, style: :daysago %>
+          <% if @card.assignees.any? %>
+            · Assigned to <%= @card.assignees.map(&:familiar_name).to_sentence %>
+          <% end %>
+        </span>
+        <%= render "cards/display/common/background", card: @card %>
+      </footer>
+    <% end %>
+  </div>
+</section>
+
+<section class="comments" aria-label="Comments">
+  <% @card.comments.chronologically.with_rich_text_body.includes(:creator).each do |comment| %>
+    <article id="<%= dom_id(comment) %>" class="comment">
+      <div class="comment__content">
+        <h2 class="txt-normal">
+          <%= comment.creator.name %>
+          <%= local_datetime_tag comment.created_at, style: :agoorweekday %>
+        </h2>
+        <div class="comment__body lexxy-content" data-controller="syntax-highlight retarget-links"><%= comment.body %></div>
+      </div>
+    </article>
+  <% end %>
+</section>
