diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..91da56e
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "boards are unpublished by default" do
+    assert_not boards(:writebook).published?
+    assert_nil boards(:writebook).publication
+  end
+
+  test "publish creates a secret key without changing board access" do
+    board = boards(:private)
+
+    assert_no_difference -> { board.accesses.count } do
+      board.publish
+    end
+
+    assert board.published?
+    assert_equal board.account, board.publication.account
+    assert_match /\A[a-zA-Z0-9]{24,}\z/, board.publication.key
+    assert_not board.reload.all_access?
+  end
+
+  test "publishing again preserves the secret key" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication.key
+
+    assert_no_difference "Board::Publication.count" do
+      board.publish
+    end
+
+    assert_equal key, board.reload.publication.key
+  end
+
+  test "each board has a different key" do
+    boards(:writebook).publish
+    boards(:private).publish
+
+    assert_not_equal boards(:writebook).publication.key, boards(:private).publication.key
+  end
+
+  test "unpublishing revokes the key and can be repeated" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_difference "Board::Publication.count", -1 do
+      board.unpublish
+    end
+
+    assert_not board.published?
+    assert_nil board.reload.publication
+    board.unpublish
+    assert_not board.published?
+  end
+
+  test "republishing generates a new secret key" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication.key
+    board.unpublish
+    board.publish
+
+    assert_not_equal key, board.publication.key
+  end
+
+  test "publication changes invalidate the board cache" do
+    board = boards(:writebook)
+
+    travel 1.minute do
+      assert_changes -> { board.reload.cache_key_with_version } do
+        board.publish
+      end
+    end
+
+    travel 2.minutes do
+      assert_changes -> { board.reload.cache_key_with_version } do
+        board.unpublish
+      end
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    board = boards(:private)
+    board.publish
+
+    assert_difference "Board::Publication.count", -1 do
+      board.destroy!
+    end
+  end
+end
