+  test "anyone with the key can view the board" do
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage))
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo))
+    assert_select "form, turbo-cable-stream-source", count: 0
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+
+  test "public URLs also work without an account prefix" do
+    get public_board_path(@key, script_name: "")
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+  end
+
+  test "signed in users do not need access to the board or account" do
+    @board.update!(all_access: false)
+    @board.accesses.where(user: users(:jz)).destroy_all
+
+    [ :jz, :mike ].each do |identity|
+      sign_in_as identity
+      get public_board_path(@key)
+
+      assert_response :success
+      assert_select "form, turbo-cable-stream-source", count: 0
+    end
+  end
+
+  test "drafts and cards from other boards are not shown" do
+    @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:kevin))
+    Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(title: "Private card", status: :published)
+    end
+
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_select ".card__title", text: "Secret draft", count: 0
+    assert_select ".card__title", text: "Private card", count: 0
+    assert_select ".card__title", text: cards(:logo).title
+  end
+
+  test "invalid keys and board IDs cannot be used" do
+    [ "unknown-key", @board.id ].each do |key|
+      get public_board_path(key)
+      assert_response :not_found
+    end
+  end
+
+  test "keys cannot be used with another account prefix" do
+    get public_board_path(@key, script_name: accounts(:initech).slug)
+    assert_response :not_found
+
+    get public_board_path(@key, script_name: "/999999999999")
+    assert_response :not_found
+  end
+
+  test "unpublishing revokes the URL even with a cached response" do
+    get public_board_path(@key)
+    etag = response.headers["ETag"]
+    @board.unpublish
+
+    get public_board_path(@key), headers: { "If-None-Match" => etag }
+    assert_response :not_found
+  end
