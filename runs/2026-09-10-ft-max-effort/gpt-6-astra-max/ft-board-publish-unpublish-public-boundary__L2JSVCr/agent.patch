+  test "republishing does not restore the old URL" do
+    @board.unpublish
+    @board.publish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_path(@board.publication.key)
+    assert_response :success
+  end
+
+  test "empty boards can be published and viewed" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.publication.key)
+
+    assert_response :success
