+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish" do
+    post "#{board_path(@board)}/publication"
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "unpublish" do
+    @board.publish
+    delete board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "publish as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "unpublish as JSON" do
+    @board.publish
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "publication requests are idempotent" do
+    2.times do
+      post board_publication_path(@board), as: :json
+      assert_response :created
+    end
+
+    2.times do
+      delete board_publication_path(@board), as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "members cannot publish even when they created the board" do
+    @board.update!(creator: users(:jz))
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "members cannot unpublish even when they created the board" do
+    @board.update!(creator: users(:jz))
+    @board.publish
+    key = @board.publication.key
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "admins cannot publish inaccessible boards" do
+    @board.accesses.find_by!(user: users(:kevin)).destroy!
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :not_found
+    assert_not @board.reload.published?
+  end
+
+  test "admins cannot publish boards from another account" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+
+    assert_response :not_found
+    assert_not boards(:miltons_wish_list).reload.published?
+  end
+
+  test "publication requires authentication" do
+    sign_out
+
+    post board_publication_path(@board)
+
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "unpublishing requires authentication" do
+    @board.publish
+    sign_out
+
+    delete board_publication_path(@board)
+
+    assert_response :redirect
+    assert @board.reload.published?
+  end
+
+  test "account owners can publish boards they have access to" do
+    @board.accesses.grant_to users(:jason)
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "board settings expose publication controls only to admins" do
+    get edit_board_path(@board)
+    assert_select "form[action=?]", board_publication_path(@board) do
+      assert_select "button", text: "Publish this board"
+    end
+
+    @board.publish
+    get edit_board_path(@board)
+    assert_select "a[href=?]", public_board_path(@board.publication.key)
+    assert_select "form[action=?]", board_publication_path(@board) do
+      assert_select "button", text: "Unpublish this board"
+    end
+
+    logout_and_sign_in_as :jz
+    get edit_board_path(@board)
+    assert_select "form[action=?]", board_publication_path(@board), count: 0
+  end
+end
