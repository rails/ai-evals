diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..769b097
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,431 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    Current.user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_in_progress)
+    cards(:logo).triage_into(@column)
+
+    sign_in_as(users(:david))
+    visit board_url(@board)
+    assert_selector "##{dom_id(@column, :cards)}[complete]", visible: :all
+  end
+
+  test "a drop takes its final sorted position before the save finishes" do
+    hold_card_move(card_triage_path(@card))
+    card = find("##{dom_id(@card, :article)}")
+    assert_equal "true", card[:draggable]
+    page.execute_script "window.draggedCard = arguments[0]", card
+
+    drag_element(card, find("##{dom_id(@column)} .cards__expander"))
+
+    expected_order = [ cards(:logo), @card, cards(:text) ].map { |card| dom_id(card, :article) }
+    assert_equal expected_order, card_order(dom_id(@column))
+    assert_equal "3", find("##{dom_id(@column)} .cards__expander-count", visible: :all).text(:all)
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_nil @card.reload.column
+    assert_equal "POST", page.evaluate_script("window.cardMove.method")
+    assert_includes page.evaluate_script("window.cardMove.accept"), "application/json"
+    assert page.evaluate_script("window.cardMove.requestId"), "The move should carry Turbo’s refresh-suppression request ID"
+
+    finish_card_move
+
+    assert_equal @column, @card.reload.column
+    assert_equal expected_order, card_order(dom_id(@column))
+    assert page.evaluate_script("window.draggedCard === document.getElementById(arguments[0])", dom_id(@card, :article))
+
+    refresh
