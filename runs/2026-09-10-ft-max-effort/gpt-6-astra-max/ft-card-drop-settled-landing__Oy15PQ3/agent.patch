+  private
+    def hold_card_move(url)
+      page.execute_script <<~JS, url
+        window.originalFetch ||= window.fetch
+        document.documentElement.removeAttribute("data-card-move-complete")
+        document.documentElement.removeAttribute("data-card-moves-complete")
+        window.cardMove = null
+        window.completedCardMoves = 0
+
+        window.fetch = async (url, options = {}) => {
+          if (new URL(url, location.href).pathname === arguments[0] && options.method !== "GET") {
+            const headers = new Headers(options.headers)
+            window.cardMove = { method: options.method, accept: headers.get("Accept"), requestId: headers.get("X-Turbo-Request-Id") }
+            const failure = await new Promise(resolve => window.finishCardMove = resolve)
+            try {
+              if (failure === "network-error") throw new TypeError("Failed to fetch")
+              return failure ? new Response(null, { status: failure }) : await window.originalFetch(url, options)
+            } finally {
+              document.documentElement.dataset.cardMoveComplete = "true"
+              document.documentElement.dataset.cardMovesComplete = ++window.completedCardMoves
+            }
+          }
+
+          const response = await window.originalFetch(url, options)
+          if (options.method && options.method !== "GET") {
+            document.documentElement.dataset.cardMovesComplete = ++window.completedCardMoves
+          }
+          return response
+        }
+      JS
+    end
+
+    def finish_card_move(failure = nil)
+      page.execute_script "window.finishCardMove(arguments[0])", failure
+      assert_selector "html[data-card-move-complete]"
+    end
+
+    def drag_card(card, to:)
+      drag_element(find("##{dom_id(card, :article)}"), find("##{to} .cards__expander"))
+      assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    end
+
+    def drag_element(source, destination)
+      # Move off the initial press point to start a native HTML5 drag before crossing
+      # to the destination. Capybara's emulation can synthesize a click on no-op drops.
+      page.driver.browser.action
+        .move_to(source.native).click_and_hold
+        .move_by(10, 0).pause(duration: 0.1)
+        .move_to(destination.native).pause(duration: 0.1)
+        .release.perform
+    end
+
+    def expand_column(column_id)
+      find("##{column_id} .cards__expander").click
+      assert_selector "##{column_id}.is-expanded"
+      page.evaluate_async_script <<~JS
+        const done = arguments[arguments.length - 1]
+        const animations = document.querySelector(".card-columns").getAnimations({ subtree: true })
+        const transitions = animations.filter(animation => animation.effect.getComputedTiming().iterations !== Infinity)
+        Promise.allSettled(transitions.map(animation => animation.finished)).then(done)
+      JS
+    end
+
+    def dispatch_drag_event(type, target, related_target: nil)
+      page.execute_script <<~JS, type, target, related_target
+        window.dragData ||= new DataTransfer()
+        arguments[1].dispatchEvent(new DragEvent(arguments[0], {
+          bubbles: true, cancelable: true, dataTransfer: window.dragData, relatedTarget: arguments[2]
+        }))
+      JS
+    end
+
+    def card_order(column_id)
+      page.all("##{column_id} article.card", visible: :all).map { |card| card[:id] }
+    end
+end
