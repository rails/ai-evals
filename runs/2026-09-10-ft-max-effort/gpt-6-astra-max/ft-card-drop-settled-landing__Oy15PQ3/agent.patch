diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..2d7044e
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,256 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container", "error" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem
+  #hoveredContainer
+  #moves = new Map()
+  #requests = Promise.resolve()
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.removeAttribute("draggable")
+  }
+
+  disconnect() {
+    this.dragEnd()
+  }
+
+  dragStart(event) {
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!item || !this.itemTargets.includes(item)) return
+
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    if (!this.#draggedItem) return
+
+    const container = this.#containerFor(event.target)
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#hover(container)
+    } else {
+      event.dataTransfer.dropEffect = "none"
+      this.#hover(null)
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.#hoveredContainer?.contains(event.relatedTarget)) {
+      this.#hover(null)
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const source = item && this.#containerFor(item)
+    const destination = this.#containerFor(event.target)
+    this.dragEnd()
+
+    if (item && source && destination) {
+      event.preventDefault()
+      if (source !== destination) this.#move(item, source, destination)
+    }
+  }
+
+  dragEnd() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#hover(null)
+  }
+
+  preventRefresh(event) {
+    if (this.#moves.size && event.target === this.element) {
+      event.preventDefault()
+    }
+  }
+
+  preserveMoves({ detail }) {
+    const render = detail.render
+    detail.render = async (current, incoming) => {
+      const moves = Array.from(this.#moves.values())
+      const displaced = Array.from(current.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+        .map(item => this.#moves.get(item)).filter(Boolean).reverse()
+
+      // A column may have started loading before the drop. Its stale response
+      // must neither resurrect the source card nor remove the destination card.
+      moves.forEach(({ item }) => incoming.querySelector(`#${item.id}`)?.remove())
+      displaced.forEach(({ item }) => item.remove())
+      await render(current, incoming)
+      // Insert bottom-to-top to preserve the optimistic order of repeated moves.
+      displaced.forEach(({ item, destination }) => this.#insert(item, destination))
+    }
+  }
+
+  #containerFor(element) {
+    const container = element.closest('[data-drag-and-drop-target~="container"]')
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #hover(container) {
+    if (container !== this.#hoveredContainer) {
+      this.#hoveredContainer?.classList.remove(this.hoverContainerClass)
+      container?.classList.add(this.hoverContainerClass)
+      this.#hoveredContainer = container
+    }
+  }
+
+  #move(item, source, destination) {
+    const move = this.#moves.get(item) || {
+      item, saved: this.#snapshot(item), frameLoads: new Set(), version: 0
+    }
+    this.#moves.set(item, move)
+    move.destination = destination
+    const version = ++move.version
+    const loadingFrames = [ source, destination ].flatMap(container =>
+      Array.from(container.querySelectorAll("turbo-frame"), frame => frame.loaded)
+    )
+
+    loadingFrames.forEach(promise => move.frameLoads.add(promise))
+
+    this.#insert(item, destination)
+    this.#updateAppearance(item, destination)
+    this.#changeCount(source, -1)
+    this.#changeCount(destination, 1)
+
+    const snapshot = this.#snapshot(item)
+    const request = this.#requestFor(item, destination)
+
+    // Apply every drop immediately, but save in drop order so activity timestamps
+    // match the optimistic order, even when moving several different cards.
+    move.request = this.#requests = this.#requests.then(() => this.#save(move, request, snapshot, version))
+    Promise.allSettled([ move.request, ...move.frameLoads ]).then(() => {
+      if (move.version === version) this.#moves.delete(item)
+    })
+  }
+
+  #snapshot(item) {
+    return {
+      contents: item.cloneNode(true),
+      container: this.#containerFor(item),
+      parent: item.parentElement,
+      nextSibling: item.nextSibling
+    }
+  }
+
+  #insert(item, container) {
+    const items = Array.from(container.querySelectorAll('[data-drag-and-drop-target~="item"]')).filter(candidate => candidate !== item)
+    const goldenFirst = container.dataset.dragAndDropGoldenFirst === "true"
+    const nextItem = goldenFirst && !item.classList.contains("golden-effect")
+      ? items.find(item => !item.classList.contains("golden-effect"))
+      : items[0]
+
+    // A move updates last_active_at (or closed_at), making it first in its sort
+    // group. Keep pagination frames intact and never use the pointer to reorder.
+    if (nextItem) {
+      nextItem.before(item)
+    } else if (items.length) {
+      items[items.length - 1].after(item)
+    } else {
+      this.#listFor(container).prepend(item)
+    }
+  }
+
+  #listFor(container) {
+    let list = container.querySelector(".cards__list")
+    if (!list) {
+      list = document.createElement("div")
+      list.className = "cards__list hide-scrollbar"
+      container.querySelector("turbo-frame").append(list)
+    }
+    return list
+  }
+
+  #updateAppearance(item, container) {
+    const columnId = container.dataset.dragAndDropColumnId
+    const status = container.dataset.dragAndDropStatus
+    const active = status === "maybe" || status === "column"
+
+    item.style.setProperty("--card-color", container.dataset.cardColor)
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", status === "not-now")
+    item.removeAttribute("aria-selected")
+    item.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+
+    const columnName = item.querySelector(".card__header .card__column-name")
+    columnName.hidden = !columnId
+    columnName.firstElementChild.textContent = columnId ? container.dataset.columnName : ""
+
+    item.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.columnId === columnId)
+    })
+
+    const time = item.querySelector(".card__meta-text--updated time")
+    time.setAttribute("datetime", Math.floor(Date.now() / 1000))
+    this.dispatch("time-changed", { target: time })
+  }
+
+  #changeCount(container, delta) {
+    const counter = container.querySelector(".cards__expander-count")
+    const count = Math.max(0, Number(counter.dataset.count) + delta)
+    counter.dataset.count = count
+    counter.textContent = count > 99 ? "99+" : count
+    const loadedCount = container.querySelectorAll('[data-drag-and-drop-target~="item"]').length
+    container.querySelector(".cards__expander").style.setProperty("--card-count", Math.min(loadedCount, 15))
+  }
+
+  #requestFor(item, container) {
+    const options = { responseKind: "json" }
+
+    switch (container.dataset.dragAndDropStatus) {
+      case "column":
+        options.body = { column_id: container.dataset.dragAndDropColumnId }
+        return new FetchRequest("post", item.dataset.cardTriageUrl, options)
+      case "maybe":
+        return new FetchRequest("delete", item.dataset.cardTriageUrl, options)
+      case "not-now":
+        return new FetchRequest("post", item.dataset.cardNotNowUrl, options)
+      case "closed":
+        return new FetchRequest("post", item.dataset.cardClosureUrl, options)
+    }
+  }
+
+  async #save(move, request, snapshot, version) {
+    try {
+      // JSON acknowledges the move without rendering a Turbo Stream. Request.js uses
+      // Turbo.fetch, so our own broadcast refresh is ignored via its request ID too.
+      const response = await request.perform()
+      if (!response.ok) throw new Error("Unable to move card")
+      move.saved = snapshot
+    } catch {
+      if (move.version === version) {
+        this.#restore(move)
+        if (this.element.isConnected) this.element.append(this.errorTarget.content.cloneNode(true))
+      }
+    }
+  }
+
+  #restore(move) {
+    const { item, saved, destination } = move
+    if (saved.container.isConnected) {
+      item.className = saved.contents.className
+      item.style.cssText = saved.contents.style.cssText
+      item.innerHTML = saved.contents.innerHTML
+
+      if (saved.parent.isConnected) {
+        saved.parent.insertBefore(item, saved.nextSibling?.parentElement === saved.parent ? saved.nextSibling : null)
+      } else {
+        this.#insert(item, saved.container)
+      }
+      this.#changeCount(destination, -1)
+      this.#changeCount(saved.container, 1)
+      move.destination = saved.container
+    }
+  }
+}
