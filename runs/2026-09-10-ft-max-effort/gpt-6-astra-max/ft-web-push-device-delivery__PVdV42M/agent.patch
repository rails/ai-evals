index 0000000..6e51c7e
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @desktop = @user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/desktop", p256dh_key: "public-key", auth_key: "auth-key")
+    @phone = @user.push_subscriptions.create!(endpoint: "https://web.push.apple.com/phone", p256dh_key: "public-key", auth_key: "auth-key")
+  end
+
+  test "creating a tray entry enqueues a push for each of the recipients devices" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "new activity on an existing tray entry also enqueues pushes" do
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      Notifier.for(events(:logo_published)).notify
+    end
+  end
+
+  test "does not enqueue pushes when the recipient has no subscriptions" do
+    @user.push_subscriptions.destroy_all
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notifier.for(events(:logo_published)).notify
+    end
+  end
+
+  test "a rolled back tray entry does not enqueue a push" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.transaction(requires_new: true) do
+        Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "each push retains its original tray text when later activity replaces the source" do
+    notification = notifications(:logo_assignment_kevin)
+    original_payload = notification.push_payload
+    notification.push_later
+
+    Notifier.for(events(:logo_published)).notify
+    latest_payload = notification.reload.push_payload
+    assert_not_equal original_payload, latest_payload
+
+    PushSubscription.any_instance.expects(:push).with(original_payload).twice
+    PushSubscription.any_instance.expects(:push).with(latest_payload).twice
+    perform_enqueued_jobs only: Notification::PushJob
+  end
+
+  test "only the recipients devices receive pushes" do
+    users(:david).push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/other", p256dh_key: "public-key", auth_key: "auth-key")
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      notification.push_later
+    end
+
+    assert_enqueued_with job: Notification::PushJob, args: [ notification, @desktop, notification.push_payload ]
+    assert_enqueued_with job: Notification::PushJob, args: [ notification, @phone, notification.push_payload ]
+  end
+
+  test "reading and manually unreading a tray entry do not send pushes" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+      notification.touch
+    end
+  end
+
+  test "no jobs are enqueued when push is not configured" do
+    PushSubscription.stubs(:configured?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notifier.for(events(:logo_published)).notify
+    end
+  end
+
+  test "pushes use the tray wording and link to the account scoped card" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload["body"]
+    assert_equal "#{@user.account.slug}/cards/#{notification.card.number}", payload.dig("data", "url")
+  end
+
+  test "comment pushes retain the comment anchor" do
+    notification = notifications(:layout_commented_kevin)
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal "RE: #{notification.card.title}", payload["title"]
+    assert_equal notification.source.eventable.body.to_plain_text.truncate(200), payload["body"]
+    assert_equal "#{@user.account.slug}/cards/#{notification.card.number}#comment_#{notification.source.eventable.id}", payload.dig("data", "url")
+  end
+
+  test "mention pushes use the same wording as mention tray entries" do
+    notification = notifications(:logo_mentioned_david)
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal "#{notification.source.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal notification.source.source.mentionable_content.truncate(200), payload["body"]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}#comment_#{notification.source.source.id}", payload.dig("data", "url")
+  end
+end
