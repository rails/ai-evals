+                data-notifications-target="button" data-action="notifications#toggle">
+          <span class="notifications__on-message">Turn off notifications</span>
+          <span class="notifications__off-message">Turn on notifications</span>
+        </button>
+        <p data-notifications-target="unsupported" hidden>This browser doesn't support push notifications. Try a supported browser or install Fizzy as a web app.</p>
+        <p data-notifications-target="blocked" hidden>Notifications are blocked for Fizzy. Follow the instructions below to allow them, then return here to turn them on.</p>
+        <p data-notifications-target="error" role="alert" hidden></p>
