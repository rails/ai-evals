@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/desktop", p256dh_key: "public-key", auth_key: "auth-key")
+    @payload = @notification.push_payload
+  end
+
+  test "delivers to the subscription" do
+    PushSubscription.any_instance.expects(:push).with(@payload)
+
+    Notification::PushJob.perform_now(@notification, @subscription, @payload)
+  end
+
+  test "does not send another users notification to a subscription" do
+    PushSubscription.any_instance.expects(:push).never
+
+    Notification::PushJob.perform_now(notifications(:logo_mentioned_david), @subscription, @payload)
+  end
+
+  test "does not send after account access is revoked" do
+    @notification.card.board.accesses.where(user: @notification.user).delete_all
+    PushSubscription.any_instance.expects(:push).never
+
+    Notification::PushJob.perform_now(@notification, @subscription, @payload)
+  end
+
+  test "does not send to an inactive user" do
+    @notification.user.update!(active: false)
+    PushSubscription.any_instance.expects(:push).never
+
+    Notification::PushJob.perform_now(@notification, @subscription, @payload)
+  end
+
+  test "does not send for an inactive account" do
+    @notification.account.create_cancellation!(initiated_by: users(:jason))
+    PushSubscription.any_instance.expects(:push).never
+
+    Notification::PushJob.perform_now(@notification, @subscription, @payload)
+  end
+
+  test "discards a job if its notification was removed" do
+    Notification::PushJob.perform_later(@notification, @subscription, @payload)
+    @notification.destroy!
+    PushSubscription.any_instance.expects(:push).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: Notification::PushJob }
+  end
+
+  test "discards a job if its device was unsubscribed" do
+    Notification::PushJob.perform_later(@notification, @subscription, @payload)
+    @subscription.destroy!
+    PushSubscription.any_instance.expects(:push).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: Notification::PushJob }
+  end
+
+  test "retries temporary failures for just the affected device" do
+    response = Net::HTTPTooManyRequests.new("1.1", "429", "Too Many Requests")
+    response.stubs(:body).returns("")
+    PushSubscription.any_instance.expects(:push).raises(WebPush::TooManyRequests.new(response, "fcm.googleapis.com"))
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ @notification, @subscription, @payload ]) do
+      Notification::PushJob.perform_now(@notification, @subscription, @payload)
+    end
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
