@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @subscription_params = {
+      endpoint: "https://fcm.googleapis.com/fcm/send/desktop",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    }
+    sign_in_as @user
+  end
+
+  test "registers a subscription for the current user and account" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params }, as: :json
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal @user.account, subscription.account
+    assert_equal @subscription_params.stringify_keys, subscription.attributes.slice(*@subscription_params.keys.map(&:to_s))
+    assert_equal user_push_subscription_url(@user, subscription), response.headers["Location"]
+  end
+
+  test "registering an endpoint again updates its keys without duplicating the device" do
+    2.times do |index|
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params.merge(auth_key: "auth-#{index}") }, as: :json
+      assert_response :created
+    end
+
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal "auth-1", @user.push_subscriptions.last.auth_key
+  end
+
+  test "ignores user and account attributes from the browser" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: @subscription_params.merge(user_id: users(:kevin).id, account_id: accounts(:initech).id)
+    }, as: :json
+
+    assert_response :created
+    assert_equal @user.account, @user.push_subscriptions.last.account
+  end
+
+  test "cannot subscribe another user even as an admin" do
+    logout_and_sign_in_as :kevin
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params }, as: :json
+
+    assert_response :forbidden
+  end
+
+  test "cannot subscribe a user from another account" do
+    post user_push_subscriptions_path(users(:mike)), params: { push_subscription: @subscription_params }, as: :json
+
+    assert_response :not_found
+  end
+
+  test "rejects an incomplete subscription" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params.except(:auth_key) }, as: :json
+
+    assert_response :unprocessable_entity
+    assert_empty @user.push_subscriptions
+  end
+
+  test "requires subscription parameters" do
+    post user_push_subscriptions_path(@user), params: {}, as: :json
+
+    assert_response :bad_request
+  end
+
+  test "removes only the selected device" do
+    desktop = @user.push_subscriptions.create!(@subscription_params)
+    phone = @user.push_subscriptions.create!(@subscription_params.merge(endpoint: "https://fcm.googleapis.com/fcm/send/phone"))
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, desktop), as: :json
+    end
+
+    assert_response :no_content
+    assert_equal [ phone ], @user.push_subscriptions.reload
+  end
+
+  test "cannot delete another users subscription" do
+    subscription = users(:kevin).push_subscriptions.create!(@subscription_params)
+
+    assert_no_difference "PushSubscription.count" do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params }, as: :json
+
+    assert_response :redirect
+  end
+end
