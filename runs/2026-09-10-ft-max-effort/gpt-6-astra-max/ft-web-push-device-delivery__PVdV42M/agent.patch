+         data-notifications-url-value="<%= user_push_subscriptions_path(Current.user) %>"
+         data-notifications-public-key-value="<%= PushSubscription.vapid[:public_key] %>"
+         data-notifications-subscriptions-value="<%= push_subscription_urls_for(Current.user).to_json %>">
