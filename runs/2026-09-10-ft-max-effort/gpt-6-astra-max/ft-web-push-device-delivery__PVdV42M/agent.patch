+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout,
+    Resolv::ResolvTimeout, Resolv::ResolvError, SocketError, Errno::ECONNRESET, Errno::ECONNREFUSED, Errno::ETIMEDOUT, wait: :polynomially_longer, attempts: 5
+
+  def perform(notification, subscription, payload)
+    notification.push_to(subscription, payload)
+  end
+end
