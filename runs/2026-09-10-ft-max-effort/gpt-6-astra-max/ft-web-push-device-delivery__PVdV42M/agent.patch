+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if PushSubscription.configured? && user.push_subscriptions.exists?
+      # Capture the tray text before another event replaces this notification's source.
+      payload = push_payload
+
+      user.push_subscriptions.find_each do |subscription|
+        Notification::PushJob.perform_later(self, subscription, payload)
+      end
+    end
+  end
+
+  def push_payload
+    ApplicationController.renderer.new(script_name: account.slug).render(
+      template: "notifications/push", formats: [ :json ], locals: { notification: self }
+    )
+  end
+
+  def push_to(subscription, payload)
+    if subscription.user_id == user_id && user.active? && account.active? && card.accessible_to?(user)
+      subscription.push(payload)
+    end
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..fce746f
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,58 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 2048 }
+  validates :p256dh_key, :auth_key, length: { maximum: 255 }
+  validate :validate_endpoint
+
+  class << self
+    def configured?
+      vapid.values_at(:public_key, :private_key).all?(&:present?)
+    end
+
+    def vapid
+      Rails.application.config.x.web_push.vapid
+    end
+
+    def register(attributes)
+      create_or_find_by!(endpoint_digest: digest(attributes[:endpoint])) do |subscription|
+        subscription.assign_attributes(attributes)
+      end.tap do |subscription|
+        subscription.update!(attributes) unless subscription.previously_new_record?
+      end
+    end
+
+    def digest(endpoint)
+      Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+  end
+
+  def push(payload)
+    if self.class.configured?
+      Request.new(
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        message: payload, vapid: self.class.vapid, ttl: 1.day.to_i
+      ).perform
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, Request::InvalidEndpoint
+    destroy!
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = self.class.digest(endpoint)
+    end
+
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add :endpoint, "must be an HTTPS push service URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS push service URL"
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..762c331
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,39 @@
+# Keep WebPush's encryption and VAPID handling, but pin the connection to a public
+# IP just as we do for webhooks. Subscription URLs are supplied by the browser.
+class PushSubscription::Request < WebPush::Request
+  class InvalidEndpoint < StandardError; end
+  class ResponseTooLarge < StandardError; end
+
+  ENDPOINT_TIMEOUT = 5.seconds
+  MAX_RESPONSE_SIZE = 100.kilobytes
+
+  def perform
+    ip = SsrfProtection.resolve_public_ip(uri.hostname)
+    raise InvalidEndpoint unless ip
+
+    http = Net::HTTP.new(uri.host, uri.port).tap do |connection|
+      connection.ipaddr = ip
+      connection.use_ssl = true
+      connection.open_timeout = ENDPOINT_TIMEOUT
+      connection.read_timeout = ENDPOINT_TIMEOUT
+      connection.write_timeout = ENDPOINT_TIMEOUT
+    end
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = http.request(request) do |response|
+      limit_response_size(response)
+    end
+    verify_response(response)
+    response
+  end
+
+  private
+    def limit_response_size(response)
+      bytes_read = 0
+      response.read_body do |chunk|
+        bytes_read += chunk.bytesize
+        raise ResponseTooLarge if bytes_read > MAX_RESPONSE_SIZE
+      end
+    end
+end
