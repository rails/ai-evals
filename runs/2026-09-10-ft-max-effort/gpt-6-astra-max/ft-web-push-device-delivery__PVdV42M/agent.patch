+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    key = WebPush.generate_key
+    PushSubscription.stubs(:vapid).returns(public_key: key.public_key, private_key: key.private_key, subject: "https://fizzy.example.com")
+    @user = users(:kevin)
+    @attributes = {
+      endpoint: "https://fcm.googleapis.com/fcm/send/desktop",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16))
+    }
+    @subscription = @user.push_subscriptions.create!(@attributes)
+    stub_dns_resolution("142.250.184.74")
+  end
+
+  test "push requires both VAPID keys" do
+    assert PushSubscription.configured?
+
+    [ nil, "" ].each do |missing_key|
+      [ :public_key, :private_key ].each do |key|
+        PushSubscription.stubs(:vapid).returns({ public_key: "public", private_key: "private" }.merge(key => missing_key))
+        assert_not PushSubscription.configured?
+      end
+    end
+  end
+
+  test "sends an encrypted payload with VAPID authentication over a pinned connection" do
+    payload = { title: "A notification", body: "Tray text", data: { url: "/cards/1" } }.to_json
+    request = stub_request(:post, @subscription.endpoint).with(
+      ipaddr: "142.250.184.74",
+      headers: { "Content-Encoding" => "aes128gcm", "TTL" => "86400", "Authorization" => /\Avapid t=.+,k=.+/ }
+    ) { |request| request.body.present? && !request.body.include?("Tray text") }.to_return(status: 201)
+
+    @subscription.push(payload)
+
+    assert_requested request
+    assert_not @subscription.destroyed?
+  end
+
+  test "removes expired and invalid subscriptions" do
+    [ 404, 410 ].each do |status|
+      subscription = @user.push_subscriptions.create!(@attributes.merge(endpoint: "https://fcm.googleapis.com/fcm/send/#{status}"))
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      assert_difference "PushSubscription.count", -1 do
+        subscription.push({ title: "Hello" }.to_json)
+      end
+    end
+  end
+
+  test "an expired device does not prevent delivery to another device" do
+    notification = notifications(:logo_assignment_kevin)
+    phone = @user.push_subscriptions.create!(@attributes.merge(endpoint: "https://web.push.apple.com/phone"))
+    desktop_request = stub_request(:post, @subscription.endpoint).to_return(status: 410)
+    phone_request = stub_request(:post, phone.endpoint).to_return(status: 201)
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      notification.push_later
+    end
+
+    assert_requested desktop_request
+    assert_requested phone_request
+    assert_equal [ phone ], @user.push_subscriptions.reload
+  end
+
+  test "does not remove subscriptions on transient or authentication errors" do
+    { 429 => WebPush::TooManyRequests, 503 => WebPush::PushServiceError, 403 => WebPush::Unauthorized }.each do |status, error|
+      stub_request(:post, @subscription.endpoint).to_return(status: status)
+
+      assert_no_difference "PushSubscription.count" do
+        assert_raises(error) { @subscription.push({ title: "Hello" }.to_json) }
+      end
+    end
+  end
+
+  test "does not contact private endpoints" do
+    stub_dns_resolution("127.0.0.1", "10.0.0.1", "169.254.169.254", "::1")
+
+    assert_difference "PushSubscription.count", -1 do
+      @subscription.push({ title: "Hello" }.to_json)
+    end
+
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  test "limits push service response size" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 201, body: "x" * (PushSubscription::Request::MAX_RESPONSE_SIZE + 1))
+
+    assert_raises PushSubscription::Request::ResponseTooLarge do
+      @subscription.push({ title: "Hello" }.to_json)
+    end
+  end
+
+  test "does not send when VAPID is unconfigured" do
+    PushSubscription.stubs(:configured?).returns(false)
+
+    @subscription.push({ title: "Hello" }.to_json)
+
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  test "requires all browser subscription fields" do
+    [ :endpoint, :p256dh_key, :auth_key ].each do |attribute|
+      subscription = @user.push_subscriptions.new(@attributes.merge(attribute => ""))
+
+      assert_not subscription.valid?
+      assert subscription.errors.added?(attribute, :blank)
+    end
+  end
+
+  test "rejects invalid URLs and non HTTPS endpoints" do
+    [ "http://fcm.googleapis.com/push", "https:///push", "not a URL", "https://user:password@example.com/push", "https://example.com/push#fragment" ].each do |endpoint|
+      subscription = @user.push_subscriptions.new(@attributes.merge(endpoint: endpoint))
+
+      assert_not subscription.valid?, "Accepted #{endpoint.inspect}"
+      assert subscription.errors[:endpoint].present?
+    end
+  end
+
+  test "registration is idempotent and updates the browser keys" do
+    assert_no_difference "PushSubscription.count" do
+      registered = @user.push_subscriptions.register(@attributes.merge(auth_key: "new-auth-key"))
+      assert_equal @subscription, registered
+    end
+    assert_equal "new-auth-key", @subscription.reload.auth_key
+  end
+
+  test "the database prevents duplicate endpoints for one user" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      @user.push_subscriptions.create!(@attributes)
+    end
+  end
+
+  test "supports long case sensitive endpoints without prefix collisions" do
+    endpoint = "https://fcm.googleapis.com/fcm/send/#{'a' * 400}"
+
+    assert_difference -> { @user.push_subscriptions.count }, 3 do
+      [ endpoint, "#{endpoint}a", "#{endpoint}A" ].each do |endpoint|
+        @user.push_subscriptions.register(@attributes.merge(endpoint: endpoint))
+      end
+    end
+  end
+
+  test "the same browser can subscribe in multiple accounts" do
+    other_user = accounts(:initech).users.create!(name: @user.name, identity: @user.identity)
+
+    subscription = other_user.push_subscriptions.register(@attributes)
+
+    assert_equal other_user, subscription.user
+    assert_equal other_user.account, subscription.account
+    assert_equal @subscription.endpoint, subscription.endpoint
+  end
+
+  test "deactivating a user removes their subscriptions" do
+    assert_difference "PushSubscription.count", -1 do
+      @user.deactivate
+    end
+  end
+
+  test "destroying a user removes their subscriptions" do
+    assert_difference "PushSubscription.count", -1 do
+      @user.destroy!
+    end
+  end
+end
diff --git a/test/system/notifications_test.rb b/test/system/notifications_test.rb
new file mode 100644
index 0000000..f6298ba
--- /dev/null
+++ b/test/system/notifications_test.rb
@@ -0,0 +1,203 @@
+require "application_system_test_case"
+
+class NotificationsTest < ApplicationSystemTestCase
+  setup do
+    @key = WebPush.generate_key
+    PushSubscription.stubs(:vapid).returns(public_key: @key.public_key, private_key: @key.private_key, subject: "https://fizzy.example.com")
+    @user = users(:david)
+    @endpoint = "https://fcm.googleapis.com/fcm/send/desktop"
+    sign_in_as @user
+  end
+
+  test "enables and disables push for just this device" do
+    phone = @user.push_subscriptions.create!(endpoint: "https://web.push.apple.com/phone", p256dh_key: "phone-public-key", auth_key: "phone-auth-key")
+    mock_push_support
+    open_settings
+
+    assert_button "Turn on notifications", disabled: false
+    assert_equal 0, page.evaluate_script("mockPush.permissionRequests")
+    assert_text "Notifications are off for this device."
+
+    click_on "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    assert_button "Turn off notifications", disabled: false
+    subscription = @user.push_subscriptions.find_by!(endpoint: @endpoint)
+    assert_equal "browser-public-key", subscription.p256dh_key
+    assert_equal "browser-auth-key", subscription.auth_key
+    assert_equal 1, page.evaluate_script("mockPush.permissionRequests")
+    assert_equal true, page.evaluate_script("mockPush.options.userVisibleOnly")
+    assert_equal Base64.urlsafe_decode64(@key.public_key).bytes, page.evaluate_script("mockPush.options.applicationServerKey")
+
+    click_on "Turn off notifications"
+
+    assert_text "Notifications are off for this device."
+    assert_equal [ phone ], @user.push_subscriptions.reload
+    assert_equal 0, page.evaluate_script("mockPush.unsubscribeCalls")
+  end
+
+  test "recognizes an existing subscription on this device without asking permission" do
+    @user.push_subscriptions.create!(endpoint: @endpoint, p256dh_key: "browser-public-key", auth_key: "browser-auth-key")
+    mock_push_support(permission: "granted", subscribed: true)
+    open_settings
+
+    assert_text "Notifications are on for this device."
+    assert_button "Turn off notifications", disabled: false
+    assert_equal 0, page.evaluate_script("mockPush.permissionRequests")
+    assert_equal 0, page.evaluate_script("mockPush.subscribeCalls")
+  end
+
+  test "permission alone does not opt this user in" do
+    mock_push_support(permission: "granted", subscribed: true)
+    open_settings
+
+    assert_text "Notifications are off for this device."
+    click_on "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal 0, page.evaluate_script("mockPush.permissionRequests")
+    assert_equal 0, page.evaluate_script("mockPush.subscribeCalls")
+  end
+
+  test "shows help when permission has been denied" do
+    mock_push_support(permission: "denied")
+    open_settings
+
+    assert_button "Turn on notifications", disabled: true
+    assert_text "Notifications are blocked for Fizzy."
+    assert_selector "details[open]", text: "Need help with notifications?"
+    assert_text "Turn on notifications for this website."
+    assert_equal 0, page.evaluate_script("mockPush.permissionRequests")
+  end
+
+  test "does not subscribe when the permission prompt is dismissed" do
+    mock_push_support(permission_result: "default")
+    open_settings
+    click_on "Turn on notifications"
+
+    assert_button "Turn on notifications", disabled: false
+    assert_text "Notifications are off for this device."
+    assert_equal 0, page.evaluate_script("mockPush.subscribeCalls")
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "shows help if the service worker cannot become ready" do
+    mock_push_support
+    page.execute_script <<~JS
+      Object.defineProperty(navigator.serviceWorker, "ready", { configurable: true, get: () => Promise.reject(new Error("Unavailable")) })
+    JS
+    open_settings
+
+    assert_text "Couldn't check notification settings. Please reload and try again."
+    assert_selector "details[open]", text: "Need help with notifications?"
+    assert_button "Turn on notifications", disabled: true
+  end
+
+  test "a failed opt out remains on and can be retried" do
+    subscription = @user.push_subscriptions.create!(endpoint: @endpoint, p256dh_key: "browser-public-key", auth_key: "browser-auth-key")
+    mock_push_support(permission: "granted", subscribed: true)
+    page.execute_script <<~JS
+      const originalFetch = window.fetch
+      window.fetch = (url, options) => {
+        if (options?.method === "DELETE" && url.includes("push_subscriptions") && !mockPush.failedOnce) {
+          mockPush.failedOnce = true
+          return Promise.resolve(new Response(null, { status: 503 }))
+        }
+        return originalFetch(url, options)
+      }
+    JS
+    open_settings
+    click_on "Turn off notifications"
+
+    assert_text "Couldn't update notifications. Please try again."
+    assert_text "Notifications are on for this device."
+    assert @user.push_subscriptions.exists?(subscription.id)
+
+    click_on "Turn off notifications"
+
+    assert_text "Notifications are off for this device."
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "shows installation help when push is unsupported" do
+    page.execute_script("delete window.PushManager")
+    open_settings
+
+    assert_button "Turn on notifications", disabled: true
+    assert_text "This browser doesn't support push notifications."
+    assert_selector "details[open]", text: "Need help with notifications?"
+  end
+
+  test "a failed registration stays off and can be retried" do
+    mock_push_support
+    page.execute_script <<~JS
+      const originalFetch = window.fetch
+      window.fetch = (url, options) => {
+        if (options?.method === "POST" && url.includes("push_subscriptions") && !mockPush.failedOnce) {
+          mockPush.failedOnce = true
+          return Promise.resolve(new Response(null, { status: 503 }))
+        }
+        return originalFetch(url, options)
+      }
+    JS
+    open_settings
+    click_on "Turn on notifications"
+
+    assert_text "Couldn't update notifications. Please try again."
+    assert_text "Notifications are off for this device."
+    assert_button "Turn on notifications", disabled: false
+    assert_empty @user.push_subscriptions.reload
+
+    click_on "Turn on notifications"
+
+    assert_text "Notifications are on for this device."
+    assert_no_text "Couldn't update notifications."
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal 1, page.evaluate_script("mockPush.subscribeCalls")
+  end
+
+  private
+    def mock_push_support(permission: "default", permission_result: "granted", subscribed: false)
+      page.execute_script <<~JS
+        window.mockPush = {
+          permission: #{permission.to_json},
+          permissionRequests: 0,
+          subscribed: #{subscribed.to_json},
+          subscribeCalls: 0,
+          unsubscribeCalls: 0
+        }
+        const subscription = {
+          endpoint: #{@endpoint.to_json},
+          toJSON: () => ({
+            endpoint: #{@endpoint.to_json},
+            keys: { p256dh: "browser-public-key", auth: "browser-auth-key" }
+          }),
+          unsubscribe: async () => { mockPush.unsubscribeCalls++; return true }
+        }
+        Object.defineProperty(Notification, "permission", { configurable: true, get: () => mockPush.permission })
+        Notification.requestPermission = async () => {
+          mockPush.permissionRequests++
+          mockPush.permission = #{permission_result.to_json}
+          return mockPush.permission
+        }
+        Object.defineProperty(navigator.serviceWorker, "ready", {
+          configurable: true,
+          value: Promise.resolve({ pushManager: {
+            getSubscription: async () => mockPush.subscribed ? subscription : null,
+            subscribe: async (options) => {
+              mockPush.subscribeCalls++
+              mockPush.subscribed = true
+              mockPush.options = { userVisibleOnly: options.userVisibleOnly, applicationServerKey: Array.from(options.applicationServerKey) }
+              return subscription
+            }
+          } })
+        })
+      JS
+    end
+
+    def open_settings
+      page.execute_script("Turbo.visit(#{notifications_settings_path.to_json})")
+      assert_selector "h1", text: "Notification Settings"
+    end
+end
diff --git a/test/system/push_service_worker_test.rb b/test/system/push_service_worker_test.rb
new file mode 100644
index 0000000..189e290
--- /dev/null
+++ b/test/system/push_service_worker_test.rb
@@ -0,0 +1,102 @@
+require "application_system_test_case"
+
+class PushServiceWorkerTest < ApplicationSystemTestCase
+  setup do
+    @worker_source = PwaController.render(:service_worker, formats: [ :js ])
+    visit "/session/new"
+  end
+
+  test "shows the push payload as a notification and keeps the worker alive" do
+    result = run_worker <<~JS
+      listeners.push({ data: { json: () => ({ title: "Tray title", body: "Tray body", tag: "notification_1", data: { url: "/123/cards/45" } }) }, waitUntil })
+      await pending
+    JS
+
+    assert_equal [ "Tray title", { "body" => "Tray body", "tag" => "notification_1", "data" => { "url" => "/123/cards/45" } } ], result["notification"]
+    assert result["waited"]
+  end
+
+  test "ignores pushes without data" do
+    result = run_worker <<~JS
+      listeners.push({ data: null, waitUntil })
+    JS
+
+    assert_nil result["notification"]
+  end
+
+  test "ignores malformed push payloads" do
+    result = run_worker <<~JS
+      listeners.push({ data: { json: () => { throw new SyntaxError("Invalid JSON") } }, waitUntil })
+      listeners.push({ data: { json: () => null }, waitUntil })
+      listeners.push({ data: { json: () => ({}) }, waitUntil })
+    JS
+
+    assert_nil result["error"]
+    assert_nil result["notification"]
+  end
+
+  test "ignores invalid click URLs" do
+    result = run_worker <<~JS
+      listeners.notificationclick({ notification: { data: { url: "https://[invalid" }, close: () => { result.closed = true } }, waitUntil })
+    JS
+
+    assert_nil result["error"]
+    assert_nil result["opened"]
+  end
+
+  test "notification click opens the account scoped card and comment" do
+    result = run_worker <<~JS
+      listeners.notificationclick({ notification: { data: { url: "/123/cards/45#comment_67" }, close: () => { result.closed = true } }, waitUntil })
+      await pending
+    JS
+
+    assert result["closed"]
+    assert result["waited"]
+    assert_equal "https://fizzy.example.com/123/cards/45#comment_67", result["opened"]
+  end
+
+  test "notification click focuses a window already showing the card" do
+    result = run_worker <<~JS
+      self.clients.matchAll = async () => [{ url: "https://fizzy.example.com/123/cards/45", focus: async () => { result.focused = true } }]
+      listeners.notificationclick({ notification: { data: { url: "/123/cards/45" }, close: () => { result.closed = true } }, waitUntil })
+      await pending
+    JS
+
+    assert result["focused"]
+    assert_nil result["opened"]
+  end
+
+  test "notification click does not open another origin" do
+    result = run_worker <<~JS
+      listeners.notificationclick({ notification: { data: { url: "https://elsewhere.example.com/123/cards/45" }, close: () => { result.closed = true } }, waitUntil })
+      await pending
+    JS
+
+    assert result["closed"]
+    assert_nil result["opened"]
+  end
+
+  private
+    def run_worker(script)
+      page.evaluate_async_script <<~JS
+        const done = arguments[0]
+        const result = {}
+        const listeners = {}
+        let pending
+        const waitUntil = (promise) => { result.waited = true; pending = promise }
+        const self = {
+          location: { origin: "https://fizzy.example.com" },
+          addEventListener: (name, listener) => { listeners[name] = listener },
+          registration: { showNotification: async (...args) => { result.notification = args } },
+          clients: {
+            matchAll: async () => [],
+            openWindow: async (url) => { result.opened = url },
+            claim: async () => {}
+          }
+        }
+        const TurboOffline = { addRule: () => {}, start: () => {}, handlers: { networkFirst: () => {}, cacheFirst: () => {} } }
+        new Function("self", "TurboOffline", "importScripts", #{@worker_source.to_json})(self, TurboOffline, () => {})
+        ;(async () => { #{script} })().then(() => done(result), (error) => done({ error: error.message }))
+      JS
+    end
+end
