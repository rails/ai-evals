+<%= form_with model: reaction, url: card_comment_reactions_path(comment.card, comment), namespace: dom_id(comment),
+      class: "reaction reaction__form expanded flex align-center gap-half",
+      data: { controller: "form", action: "submit->form#preventComposingSubmit submit->form#preventEmptySubmit compositionstart->form#compositionStart compositionend->form#compositionEnd keydown.esc->form#cancel" } do |form| %>
+  <span class="reaction__avatar">
+    <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+  </span>
+
+  <%= form.label :content, class: "reaction__form-label flex align-center" do %>
+    <span class="for-screen-reader">Reaction (up to 16 characters)</span>
+    <%= form.text_field :content, class: "reaction__input input txt-small", maxlength: 16, size: 16,
+          required: true, autofocus: true, autocomplete: "off", placeholder: "Your reaction",
+          data: { form_target: "input" }, aria: { describedby: (dom_id(comment, :reaction_errors) if reaction.errors.any?) } %>
+  <% end %>
+
+  <%= form.button type: :submit, class: "reaction__submit-btn btn btn--plain" do %>
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Confirm reaction</span>
+  <% end %>
+
+  <%= link_to card_comment_path(comment.card, comment), class: "reaction__cancel-btn btn btn--plain", data: { form_target: "cancel" } do %>
+    <%= icon_tag "remove" %>
+    <span class="for-screen-reader">Cancel reaction</span>
+  <% end %>
+<% end %>
+
+<% if reaction.errors.any? %>
+  <p id="<%= dom_id(comment, :reaction_errors) %>" class="txt-small txt-negative" role="alert"><%= reaction.errors.full_messages.to_sentence %></p>
+<% end %>
