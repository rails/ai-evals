diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..b617eea
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "defaults to the comment's account and current creator" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal @comment.account, reaction.account
+    assert_equal users(:david), reaction.creator
+    assert_equal @comment.card, reaction.card
+  end
+
+  test "accepts emoji and up to sixteen characters of text" do
+    [ "👍", "❤️", "Great idea!", "a" * 16 ].each do |content|
+      reaction = @comment.reactions.build(content: content)
+      assert reaction.valid?, reaction.errors.full_messages.to_sentence
+    end
+  end
+
+  test "rejects blank and overlong reactions" do
+    [ nil, "", "   ", "a" * 17 ].each do |content|
+      reaction = @comment.reactions.build(content: content)
+      assert_not reaction.valid?
+      assert reaction.errors[:content].any?
+    end
+  end
+
+  test "strips surrounding whitespace" do
+    assert_equal "Nice!", @comment.reactions.create!(content: " Nice! ").content
+  end
+
+  test "allows multiple reactions by the same creator" do
+    assert_difference -> { @comment.reactions.count }, 2 do
+      2.times { @comment.reactions.create!(content: "👍") }
+    end
+  end
+
+  test "creating and removing reactions invalidates the cached comment" do
+    reaction = nil
+
+    travel 1.second do
+      assert_changes -> { @comment.reload.cache_key_with_version } do
+        reaction = @comment.reactions.create!(content: "Nice!")
+      end
+    end
+
+    travel 2.seconds do
+      assert_changes -> { @comment.reload.cache_key_with_version } do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "reactions are destroyed with their comment" do
+    reaction = @comment.reactions.create!(content: "Nice!")
+
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "reactions are destroyed with their creator" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "preloaded comments include reactions and their creators" do
+    @comment.reactions.create!(content: "Nice!")
+
+    comment = Comment.preloaded.find(@comment.id)
+
+    assert comment.association(:reactions).loaded?
+    assert comment.reactions.first.association(:comment).loaded?
+    assert comment.reactions.first.association(:creator).loaded?
+  end
+
+  test "creation is broadcast to the card's reactions list" do
+    reaction = @comment.reactions.create!(content: "Nice!")
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+    end
+
+    append = broadcasts.find { |broadcast| broadcast["action"] == "append" }
+    assert_not_nil append
+    assert_equal dom_id(@comment, :reactions), append["target"]
+    assert_includes append.at_css("##{dom_id(reaction)}").text, "Nice!"
+    assert append.at_css("form[action^='#{@comment.account.slug}/cards/']")
+  end
+
+  test "removal is broadcast to the card" do
+    reaction = @comment.reactions.create!(content: "Nice!")
+
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) { reaction.destroy! }
+
+    assert broadcasts.any? { |broadcast| broadcast["action"] == "remove" && broadcast["target"] == dom_id(reaction) }
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..d700035
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,219 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding multiple reactions and removing your own" do
+    visit card_url(@comment.card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Reaction (up to 16 characters)", with: "Great idea!"
+      click_on "Confirm reaction"
+
+      assert_selector ".reactions__list .reaction", text: "Great idea!"
+      assert_no_selector "input[name='reaction[content]']"
+      assert_selector ".reactions__trigger"
+      assert_no_button "Remove reaction"
+
+      click_on "Add a reaction"
+      fill_in "Reaction (up to 16 characters)", with: "Agreed!"
+      click_on "Confirm reaction"
+
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_no_selector "input[name='reaction[content]']"
+
+      within find(".reaction", text: "Great idea!") do
+        find("[data-reaction-target='trigger']").click
+        click_on "Remove reaction"
+      end
+
+      assert_no_selector ".reactions__list .reaction", text: "Great idea!"
+      assert_selector ".reactions__list .reaction", text: "Agreed!"
+
+      within find(".reaction", text: "Agreed!") do
+        find("[data-reaction-target='trigger']").send_keys :enter
+        click_on "Remove reaction"
+      end
+
+      assert_no_selector ".reactions__list .reaction"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_empty @comment.reactions.reload
+  end
+
+  test "canceling leaves no reaction and reopens an empty form" do
+    visit card_url(@comment.card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Reaction (up to 16 characters)", with: "Never mind"
+      click_on "Cancel reaction"
+
+      assert_no_selector "input[name='reaction[content]']"
+      assert_selector ".reactions__trigger"
+
+      click_on "Add a reaction"
+      assert_field "Reaction (up to 16 characters)", with: ""
+      find("input[name='reaction[content]']").send_keys :escape
+
+      assert_no_selector "input[name='reaction[content]']"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_empty @comment.reactions.reload
+  end
+
+  test "blank input is rejected and emoji can be submitted" do
+    visit card_url(@comment.card)
+
+    within_comment do
+      click_on "Add a reaction"
+      click_on "Confirm reaction"
+      assert_selector "input[name='reaction[content]']"
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Reaction (up to 16 characters)", with: "   "
+      click_on "Confirm reaction"
+      assert_selector "input[name='reaction[content]']"
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Reaction (up to 16 characters)", with: "✨"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "✨"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal "✨", @comment.reactions.sole.content
+  end
+
+  test "text input is limited to sixteen characters" do
+    visit card_url(@comment.card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Reaction (up to 16 characters)", with: "a" * 17
+      assert_field "Reaction (up to 16 characters)", with: "a" * 16
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "a" * 16
+    end
+
+    assert_equal "a" * 16, @comment.reactions.sole.content
+  end
+
+  test "server validation errors keep the form available for correction" do
+    visit card_url(@comment.card)
+
+    within_comment do
+      click_on "Add a reaction"
+      input = find("input[name='reaction[content]']")
+      page.execute_script("arguments[0].removeAttribute('maxlength')", input)
+      fill_in "Reaction (up to 16 characters)", with: "a" * 17
+      click_on "Confirm reaction"
+
+      assert_selector "[role='alert']", text: "Content is too long"
+      assert_field "Reaction (up to 16 characters)", with: "a" * 17
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Reaction (up to 16 characters)", with: "Fixed!"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "Fixed!"
+      assert_selector ".reactions__trigger"
+      assert_no_selector "[role='alert']"
+    end
+  end
+
+  test "someone else's reaction cannot be expanded for removal" do
+    reaction = @comment.reactions.create!(content: "Indeed!", creator: users(:kevin))
+
+    visit card_url(@comment.card)
+
+    within "##{dom_id(reaction)}" do
+      assert_selector "img[title='Kevin']"
+      find("[data-reaction-target='trigger']").click
+      assert_no_button "Remove reaction"
+      assert_no_selector "[role='button']"
+    end
+  end
+
+  test "live additions and removals preserve a reaction being typed" do
+    visit card_url(@comment.card)
+    wait_for_cable_subscriptions
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Reaction (up to 16 characters)", with: "Still typing"
+    end
+
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+    perform_reaction_broadcasts
+
+    within_comment do
+      assert_selector "##{dom_id(reaction)}", text: "Nice!", count: 1
+      assert_field "Reaction (up to 16 characters)", with: "Still typing"
+    end
+
+    reaction.destroy!
+    perform_reaction_broadcasts
+
+    within_comment do
+      assert_no_selector "##{dom_id(reaction)}"
+      assert_field "Reaction (up to 16 characters)", with: "Still typing"
+    end
+  end
+
+  test "other people viewing the card see reactions appear and disappear" do
+    visit card_url(@comment.card)
+    wait_for_cable_subscriptions
+
+    Capybara.using_session(:other_viewer) do
+      sign_in_as(users(:kevin))
+      visit card_url(@comment.card)
+      wait_for_cable_subscriptions
+    end
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Reaction (up to 16 characters)", with: "Great idea!"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "Great idea!", count: 1
+    end
+    perform_reaction_broadcasts
+
+    Capybara.using_session(:other_viewer) do
+      within_comment do
+        assert_selector ".reactions__list .reaction", text: "Great idea!", count: 1
+        assert_no_button "Remove reaction"
+      end
+    end
+
+    within_comment do
+      find(".reaction [data-reaction-target='trigger']").click
+      click_on "Remove reaction"
+      assert_no_selector ".reactions__list .reaction"
+    end
+    perform_reaction_broadcasts
+
+    Capybara.using_session(:other_viewer) do
+      within_comment { assert_no_selector ".reactions__list .reaction" }
+    end
+  end
+
+  private
+    def within_comment(&block)
+      within "##{dom_id(@comment)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def perform_reaction_broadcasts
+      perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+    end
+end
