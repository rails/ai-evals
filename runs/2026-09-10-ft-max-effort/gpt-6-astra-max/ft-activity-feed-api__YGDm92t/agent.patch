+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from filtered_events
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events.in_activity_feed.reverse_chronologically.preloaded
+      events = events.where(creator_id: filter_params[:creator_ids]) if filter_params[:creator_ids].present?
+      events = events.where(board_id: filter_params[:board_ids]) if filter_params[:board_ids].present?
+      events
+    end
+
+    def filter_params
+      params.permit(creator_ids: [], board_ids: [])
+    end
+end
