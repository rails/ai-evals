@@ -0,0 +1,289 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index returns account activity as a flat newest-first JSON array" do
+    get "#{accounts(:"37s").slug}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal users(:david).accessible_events.order(created_at: :desc, id: :desc).ids,
+      @response.parsed_body.pluck("id")
+  end
+
+  test "card activities use the existing API representations and plain-text descriptions" do
+    event = events(:logo_published)
+    activity = activity_for(event)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.as_json, activity["created_at"]
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_not_includes activity["description"], "<span"
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    get cards_path, params: { card_ids: [ event.eventable_id ] }, as: :json
+    assert_response :success
+    assert_equal @response.parsed_body.sole, activity["eventable"]
+
+    get board_path(event.board), as: :json
+    assert_response :success
+    assert_equal @response.parsed_body, activity["board"]
+
+    get user_path(event.creator), as: :json
+    assert_response :success
+    assert_equal @response.parsed_body, activity["creator"]
+  end
+
+  test "comment activities use the comment API representation and link to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+    activity = activity_for(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment), as: :json
+    assert_response :success
+    assert_equal @response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but excludes deprecated and unrelated actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_postponed card_auto_postponed card_title_changed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+
+    (actions + %w[ card_collection_changed card_resumed comment_updated ]).each do |action|
+      eventable = action.start_with?("comment_") ? comments(:layout_overflowing_david) : cards(:logo)
+      create_event action, eventable: eventable, creator: users(:jz)
+    end
+
+    get activities_path, params: { creator_ids: [ users(:jz).id ] }, as: :json
+
+    assert_response :success
+    assert_equal actions.sort, @response.parsed_body.pluck("action").sort
+  end
+
+  %w[ card_assigned card_unassigned ].each do |action|
+    test "#{action} exposes assignee IDs" do
+      assignee_ids = [ users(:jz).id, users(:kevin).id ]
+      event = create_event action, particulars: { assignee_ids: assignee_ids, ignored: "private detail" }
+
+      assert_equal({ "assignee_ids" => assignee_ids }, activity_for(event)["particulars"])
+    end
+  end
+
+  {
+    "card_board_changed" => { "old_board" => "Old & board", "new_board" => "New board" },
+    "card_title_changed" => { "old_title" => "Old <title>", "new_title" => "New title" },
+    "card_triaged" => { "column" => "In progress" }
+  }.each do |action, particulars|
+    test "#{action} exposes flattened particulars" do
+      event = create_event action, particulars: { particulars: particulars.merge("ignored" => "private detail") }
+
+      assert_equal particulars, activity_for(event)["particulars"]
+    end
+
+    test "#{action} returns empty strings for missing particulars" do
+      [ {}, { particulars: {} }, { particulars: nil }, { particulars: particulars.transform_values { nil } } ].each do |missing_particulars|
+        event = create_event action, particulars: missing_particulars
+
+        assert_equal particulars.transform_values { "" }, activity_for(event)["particulars"]
+      end
+    end
+  end
+
+  test "other activities return an empty particulars object" do
+    actions = %w[ card_published card_closed card_reopened card_postponed card_auto_postponed card_sent_back_to_triage comment_created ]
+
+    actions.each do |action|
+      eventable = action == "comment_created" ? comments(:layout_overflowing_david) : cards(:logo)
+      event = create_event action, eventable: eventable, particulars: { ignored: "private detail" }
+
+      assert_equal({}, activity_for(event)["particulars"])
+    end
+  end
+
+  test "filters by one or more creators" do
+    [ [ users(:kevin).id ], [ users(:kevin).id, users(:david).id ] ].each do |creator_ids|
+      get activities_path, params: { creator_ids: creator_ids }, as: :json
+
+      assert_response :success
+      assert_equal users(:david).accessible_events.where(creator_id: creator_ids).order(created_at: :desc, id: :desc).ids,
+        @response.parsed_body.pluck("id")
+    end
+  end
+
+  test "filters by one or more accessible boards" do
+    logout_and_sign_in_as :kevin
+    create_event "card_published", eventable: private_card, creator: users(:kevin)
+
+    [ [ boards(:private).id ], [ boards(:private).id, boards(:writebook).id ] ].each do |board_ids|
+      get activities_path, params: { board_ids: board_ids }, as: :json
+
+      assert_response :success
+      assert_equal users(:kevin).accessible_events.where(board_id: board_ids).order(created_at: :desc, id: :desc).ids,
+        @response.parsed_body.pluck("id")
+    end
+  end
+
+  test "combines creator and board filters" do
+    logout_and_sign_in_as :kevin
+    event = create_event "card_published", eventable: private_card, creator: users(:jz)
+    create_event "card_published", creator: users(:jz)
+
+    get activities_path, params: { creator_ids: [ users(:jz).id ], board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_equal [ event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "only returns accessible activity even when inaccessible boards are requested" do
+    private_event = create_event "card_published", eventable: private_card
+    other_account_event = create_event "card_published", eventable: cards(:radio), creator: users(:mike)
+    inaccessible_board_ids = [ private_event.board_id, other_account_event.board_id ]
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes @response.parsed_body.pluck("id"), other_account_event.id
+
+    get activities_path, params: { board_ids: inaccessible_board_ids }, as: :json
+    assert_response :success
+    assert_equal [], @response.parsed_body
+
+    get activities_path, params: { board_ids: inaccessible_board_ids + [ boards(:writebook).id ] }, as: :json
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "non-matching filters return an empty array" do
+    [ :creator_ids, :board_ids ].each do |filter|
+      get activities_path, params: { filter => [ ActiveRecord::Type::Uuid.generate ] }, as: :json
+
+      assert_response :success
+      assert_equal [], @response.parsed_body
+      assert_nil @response.headers["Link"]
+    end
+  end
+
+  test "creator filters include historical activity from deactivated users" do
+    users(:kevin).deactivate
+
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id && activity.dig("creator", "active") == false }
+  end
+
+  test "activity follows card access when a card moves to an inaccessible board" do
+    card = cards(:layout)
+    with_current_user(:kevin) { card.move_to(boards(:private)) }
+    assert_not users(:david).boards.exists?(boards(:private).id)
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), events(:layout_published).id
+    assert_not_includes @response.parsed_body.pluck("id"), events(:layout_commented).id
+  end
+
+  test "returns an empty array when the user cannot access any boards" do
+    users(:david).accesses.destroy_all
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+    assert_equal "0", @response.headers["X-Total-Count"]
+    assert_nil @response.headers["Link"]
+  end
+
+  test "paginates newest first with stable ordering and preserves filters in next links" do
+    logout_and_sign_in_as :kevin
+    baseline = 2.days.ago.change(usec: 0)
+    events = 70.times.map do |index|
+      create_event "card_published", creator: users(:jz), created_at: baseline + (index / 2).minutes
+    end
+    create_event "card_published", eventable: private_card, creator: users(:jz), created_at: baseline
+
+    expected_ids = events.sort_by { |event| [ event.created_at, event.id ] }.reverse.map(&:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      assert_equal events.size.to_s, @response.headers["X-Total-Count"]
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+    assert_nil @response.headers["Link"]
+
+    get activities_path, params: { page: 1000 }, as: :json
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "accepts a read-only bearer token" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:jasons_api_token).token}" }
+
+    assert_response :success
+  end
+
+  test "rejects an invalid bearer token" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer invalid" }
+
+    assert_response :unauthorized
+  end
+
+  test "rejects access to an account without membership" do
+    get activities_path(script_name: accounts(:initech).slug), as: :json
+
+    assert_response :forbidden
+  end
+
+  private
+    def activity_for(event)
+      get activities_path, as: :json
+      assert_response :success
+
+      @response.parsed_body.find { |activity| activity["id"] == event.id }.tap do |activity|
+        assert_not_nil activity
+      end
+    end
+
+    def create_event(action, eventable: cards(:logo), creator: users(:david), particulars: {}, **attributes)
+      eventable.events.create! action: action, board: eventable.card.board, creator: creator, particulars: particulars, **attributes
+    end
+
+    def private_card
+      @private_card ||= with_current_user(:kevin) do
+        boards(:private).cards.create! title: "Private activity", creator: users(:kevin), status: :published
+      end
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
