diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..650ed3e
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,29 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal
+
+  delegate :card, to: :reactable
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+
+  private
+    def broadcast_creation
+      broadcast_append_later_to card, :activity, target: [ reactable, :reactions ]
+    end
+
+    def broadcast_removal
+      broadcast_remove_to card, :activity
+    end
+end
