diff --git a/app/views/cards/comments/reactions/new.html.erb b/app/views/cards/comments/reactions/new.html.erb
new file mode 100644
index 0000000..6bbede6
--- /dev/null
+++ b/app/views/cards/comments/reactions/new.html.erb
@@ -0,0 +1,33 @@
+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <div class="reaction reaction__form expanded">
+    <%= form_with model: @reaction, namespace: dom_id(@comment), url: card_comment_reactions_path(@card, @comment), class: "flex align-center gap-half",
+          data: { controller: "form morph-guard", action: "submit->form#preventEmptySubmit keydown.esc->form#cancel:stop" } do |form| %>
+      <span class="reaction__avatar" aria-hidden="true">
+        <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      </span>
+
+      <%= form.label :content, class: "reaction__form-label flex align-center" do %>
+        <span class="for-screen-reader">Reaction</span>
+        <%# maxlength counts UTF-16 units; the Unicode pattern enforces the character limit, including emoji. %>
+        <%= form.text_field :content, class: "input reaction__input txt-small", required: true,
+              maxlength: Reaction::MAX_CONTENT_LENGTH * 2, pattern: ".{1,#{Reaction::MAX_CONTENT_LENGTH}}", title: "16 characters maximum",
+              autofocus: true, autocomplete: "off", data: { form_target: "input", "1p-ignore": true } %>
+      <% end %>
+
+      <%= form.button class: "reaction__submit-btn btn btn--circle borderless", title: "Add this reaction" do %>
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Add this reaction</span>
+      <% end %>
+
+      <%= link_to card_comment_path(@card, @comment), class: "reaction__cancel-btn btn btn--circle borderless",
+            title: "Cancel", data: { form_target: "cancel" } do %>
+        <%= icon_tag "remove" %>
+        <span class="for-screen-reader">Cancel</span>
+      <% end %>
+    <% end %>
+  </div>
+
+  <% if @reaction.errors.any? %>
+    <p class="txt-small txt-negative" role="alert"><%= @reaction.errors.full_messages.to_sentence %></p>
+  <% end %>
+<% end %>
