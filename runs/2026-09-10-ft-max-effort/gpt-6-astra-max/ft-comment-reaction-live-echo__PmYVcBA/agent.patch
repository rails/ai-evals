diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..b676ac7
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,227 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "comments have a reactions strip and an add button" do
+    get card_comment_path(@comment.card, @comment)
+
+    assert_response :success
+    assert_select ".reactions" do
+      assert_select ".reactions__list"
+      assert_select ".reactions__trigger", text: "Add a reaction"
+      assert_select ".reactions__trigger img[src*='boost-color']"
+    end
+  end
+
+  test "new shows an inline form with confirm and cancel" do
+    get new_card_comment_reaction_path(@comment.card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)}" do
+      assert_select "input[name='reaction[content]'][maxlength='32'][pattern='.{1,16}'][required][autofocus]"
+      assert_select ".reaction__submit-btn", text: "Add this reaction"
+      assert_select ".reaction__cancel-btn", text: "Cancel"
+    end
+  end
+
+  test "create appends the reaction and restores the add button" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions)
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :new_reaction)
+    assert_select ".reactions__trigger", text: "Add a reaction"
+    assert_select "input[name='reaction[content]']", count: 0
+  end
+
+  test "create accepts sixteen characters as JSON" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "a" * 16 } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "a" * 16, @comment.reactions.last.content
+  end
+
+  test "create supports flat JSON parameters" do
+    post card_comment_reactions_path(@comment.card, @comment), params: { content: "Great work!" }, as: :json
+
+    assert_response :created
+    assert_equal "Great work!", @comment.reactions.last.content
+  end
+
+  test "create ignores forged ownership and parent parameters" do
+    post card_comment_reactions_path(@comment.card, @comment), params: {
+      reaction: { content: "👍", reacter_id: users(:mike).id, account_id: accounts(:initech).id,
+        reactable_id: comments(:layout_overflowing_david).id, reactable_type: "Comment" }
+    }, as: :json
+
+    assert_response :created
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment, reaction.reactable
+  end
+
+  test "invalid content is rejected without saving or broadcasting" do
+    [ "", "   ", "a" * 17 ].each do |content|
+      assert_no_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        assert_no_difference "Reaction.count" do
+          post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :json
+        end
+      end
+
+      assert_response :unprocessable_entity
+      assert @response.parsed_body["errors"].present?
+    end
+  end
+
+  test "invalid content preserves the form and explains the error" do
+    content = "a" * 17
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)}" do
+      assert_select "input[name='reaction[content]'][value='#{content}']"
+      assert_select "[role='alert']", text: /too long/
+      assert_select ".reaction__cancel-btn"
+    end
+  end
+
+  test "index as JSON includes the reaction and its author" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    get card_comment_reactions_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    json = @response.parsed_body.sole
+    assert_equal reaction.id, json["id"]
+    assert_equal "👍", json["content"]
+    assert_equal users(:david).id, json.dig("reacter", "id")
+    assert_equal users(:david).name, json.dig("reacter", "name")
+    assert_equal card_comment_reaction_url(@comment.card, @comment, reaction), json["url"]
+  end
+
+  test "reaction text is escaped and the author is shown on the card" do
+    reaction = @comment.reactions.create!(content: "<b>Hi</b>", reacter: users(:david))
+
+    get card_path(@comment.card)
+
+    assert_response :success
+    assert_select "##{dom_id(reaction)}" do
+      assert_select "span", text: "<b>Hi</b>"
+      assert_select "b", count: 0
+      assert_select "img[title='David']"
+    end
+  end
+
+  test "cached comments reflect added and removed reactions" do
+    with_actionview_partial_caching do
+      get card_path(@comment.card)
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 0
+
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" } }, as: :json
+      reaction = @comment.reactions.last
+
+      get card_path(@comment.card)
+      assert_select "##{dom_id(reaction)}", count: 1
+
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+      get card_path(@comment.card)
+      assert_select "##{dom_id(reaction)}", count: 0
+    end
+  end
+
+  test "authentication is required to add reactions" do
+    sign_out
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :redirect
+  end
+
+  test "destroy removes the reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "even an admin cannot delete someone else's reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "reactions must belong to the comment in the URL" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "comments must belong to the card in the URL" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "a user cannot react on an inaccessible board" do
+    Current.set(user: users(:kevin)) do
+      card = boards(:private).cards.create!(title: "Private", status: :published)
+      @comment = card.comments.create!(body: "Private note")
+    end
+    logout_and_sign_in_as :david
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "a user cannot access reactions in another account" do
+    get card_comment_reactions_path(@comment.card, @comment, script_name: accounts(:initech).slug), as: :json
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..05332f3
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "content is required and limited to sixteen characters" do
+    reaction = @comment.reactions.build
+
+    [ nil, "", "   ", "a" * 17, "👍" * 17 ].each do |content|
+      reaction.content = content
+      assert_not reaction.valid?, "Expected #{content.inspect} to be invalid"
+      assert reaction.errors[:content].present?
+    end
+
+    [ "👍", "❤️", "👩🏽‍💻", "Great work!", "a" * 16, "👍" * 16 ].each do |content|
+      reaction.content = content
+      assert reaction.valid?, "Expected #{content.inspect} to be valid"
+    end
+  end
+
+  test "defaults to the current user and the comment's account" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment.card, reaction.card
+  end
+
+  test "a user can leave multiple reactions" do
+    assert_difference -> { @comment.reactions.count }, 2 do
+      2.times { @comment.reactions.create!(content: "👍") }
+    end
+  end
+
+  test "reactions are ordered chronologically" do
+    later = @comment.reactions.create!(content: "Second", created_at: 1.minute.ago)
+    earlier = @comment.reactions.create!(content: "First", created_at: 2.minutes.ago)
+
+    assert_equal [ earlier, later ], @comment.reactions.reload
+  end
+
+  test "creating and destroying a reaction invalidates the comment cache" do
+    reaction = nil
+
+    assert_changes -> { @comment.reload.cache_key_with_version } do
+      reaction = @comment.reactions.create!(content: "👍")
+    end
+
+    assert_changes -> { @comment.reload.cache_key_with_version } do
+      reaction.destroy!
+    end
+  end
+
+  test "destroying the comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroying the reacter destroys their reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "creating a reaction broadcasts an append with account-scoped URLs and its author" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    broadcasts = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) do
+      Current.set(user: nil) do
+        perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+      end
+    end
+
+    broadcast = broadcasts.sole
+    assert_equal "append", broadcast["action"]
+    assert_equal dom_id(@comment, :reactions), broadcast["target"]
+    assert_includes broadcast.to_s, dom_id(reaction)
+    assert_includes broadcast.to_s, reaction.reacter.name
+    assert_includes broadcast.to_s, "action=\"#{@comment.account.slug}/cards/"
+    assert_includes broadcast.to_s, "data-reaction-reacter-id-value=\"#{reaction.reacter_id}\""
+  end
+
+  test "destroying a reaction broadcasts its removal" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    broadcasts = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) do
+      reaction.destroy!
+    end
+
+    assert_equal "remove", broadcasts.sole["action"]
+    assert_equal dom_id(reaction), broadcasts.sole["target"]
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..46b1233
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,190 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "add emoji and text reactions without leaving the card" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      assert_no_selector ".reactions__trigger"
+      assert_selector ".reaction__form"
+      fill_in "Reaction", with: "👍"
+      click_on "Add this reaction"
+
+      assert_selector ".reactions__list .reaction", text: "👍", count: 1
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      click_on "Add a reaction"
+      assert_field "Reaction", with: ""
+      fill_in "Reaction", with: "Good point!"
+      click_on "Add this reaction"
+
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_selector ".reactions__list .reaction", text: "Good point!"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_current_path card_path(@comment.card)
+    assert_equal [ "👍", "Good point!" ], @comment.reactions.pluck(:content)
+  end
+
+  test "sixteen emoji count as sixteen characters" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "👍" * 16
+      assert_field "Reaction", with: "👍" * 16
+      click_on "Add this reaction"
+
+      assert_selector ".reactions__list .reaction", text: "👍" * 16
+    end
+  end
+
+  test "cancel and Escape restore the button without adding a reaction" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Never mind"
+      click_on "Cancel"
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reactions__list .reaction"
+
+      click_on "Add a reaction"
+      assert_field "Reaction", with: ""
+      find_field("Reaction").send_keys :escape
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_current_path card_path(@comment.card)
+    assert_empty @comment.reactions
+  end
+
+  test "blank input cannot be submitted and text is limited to sixteen characters" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "   "
+      click_on "Add this reaction"
+
+      assert_selector ".reaction__input"
+      assert_no_selector ".reactions__list .reaction"
+      assert_empty @comment.reactions
+
+      fill_in "Reaction", with: "a" * 17
+      click_on "Add this reaction"
+      assert_selector ".reaction__input:invalid"
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Reaction", with: "a" * 16
+      click_on "Add this reaction"
+
+      assert_selector ".reactions__list .reaction", text: "a" * 16
+    end
+  end
+
+  test "only your reactions can be expanded and removed" do
+    mine = @comment.reactions.create!(content: "Nice!", reacter: users(:kevin))
+    theirs = @comment.reactions.create!(content: "Agreed", reacter: users(:david))
+    visit card_url(@comment.card)
+
+    within "##{dom_id(theirs)}" do
+      find("[data-reaction-target='toggle']").click
+      assert_no_selector ".reaction__delete", visible: true
+      assert_no_selector "[role='button']"
+    end
+
+    within "##{dom_id(mine)}" do
+      assert_no_selector ".reaction__delete", visible: true
+      find("[data-reaction-target='toggle']").click
+      assert_button "Remove this reaction"
+      find("[data-reaction-target='toggle']").send_keys :escape
+      assert_no_selector ".reaction__delete", visible: true
+      find("[data-reaction-target='toggle']").send_keys :enter
+      click_on "Remove this reaction"
+    end
+
+    assert_no_selector "##{dom_id(mine)}"
+    assert_selector "##{dom_id(theirs)}"
+    assert_not Reaction.exists?(mine.id)
+    assert Reaction.exists?(theirs.id)
+  end
+
+  test "other viewers receive additions and removals without losing a draft" do
+    visit card_url(@comment.card)
+    wait_for_cable_subscriptions
+
+    using_session :other_viewer do
+      sign_in_as users(:david)
+      visit card_url(@comment.card)
+      wait_for_cable_subscriptions
+      within_reactions do
+        click_on "Add a reaction"
+        fill_in "Reaction", with: "My draft"
+      end
+    end
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "👏"
+      click_on "Add this reaction"
+      assert_selector ".reactions__list .reaction", text: "👏"
+    end
+
+    perform_reaction_broadcasts
+    reaction = @comment.reactions.find_by!(content: "👏")
+
+    using_session :other_viewer do
+      within_reactions do
+        assert_selector "##{dom_id(reaction)}", text: "👏", wait: 5
+        assert_field "Reaction", with: "My draft"
+        within "##{dom_id(reaction)}" do
+          assert_selector "img[title='Kevin']"
+          find("[data-reaction-target='toggle']").click
+          assert_no_selector ".reaction__delete", visible: true
+        end
+      end
+    end
+
+    within "##{dom_id(reaction)}" do
+      find("[data-reaction-target='toggle']").click
+      click_on "Remove this reaction"
+    end
+    assert_no_selector "##{dom_id(reaction)}"
+    perform_reaction_broadcasts
+
+    using_session :other_viewer do
+      assert_no_selector "##{dom_id(reaction)}", wait: 5
+      within_reactions { assert_field "Reaction", with: "My draft" }
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment)} .reactions", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def perform_reaction_broadcasts
+      perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+    end
+end
