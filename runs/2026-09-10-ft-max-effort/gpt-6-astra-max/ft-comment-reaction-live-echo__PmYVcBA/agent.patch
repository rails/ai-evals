new file mode 100644
index 0000000..b23511a
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,58 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preload(:reacter)
+  end
+
+  def new
+    @reaction = @comment.reactions.new
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :new, formats: :html, status: :unprocessable_entity }
+        format.json { render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..733f483
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle" ]
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#isMine) {
+      this.element.classList.add("reaction--deleteable")
+      this.toggleTarget.setAttribute("role", "button")
+      this.toggleTarget.setAttribute("tabindex", "0")
+      this.collapse()
+    }
+  }
+
+  toggle(event) {
+    if (this.#isMine && !event.target.closest("form")) {
+      this.#setExpanded(!this.element.classList.contains("expanded"))
+    }
+  }
+
+  collapse() {
+    if (this.#isMine) {
+      this.#setExpanded(false)
+    }
+  }
+
+  #setExpanded(expanded) {
+    this.element.classList.toggle("expanded", expanded)
+    this.toggleTarget.setAttribute("aria-expanded", expanded)
+  }
+
+  get #isMine() {
+    return this.reacterIdValue === Current.user?.id
+  }
+}
