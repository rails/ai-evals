+    blob = ActiveStorage::Blob.new(key: "new-file", filename: "file.txt", byte_size: data.bytesize, checksum: Digest::MD5.base64digest(data), content_type: "text/plain", service_name: service.name)
+    blob.stubs(:service).returns(service)
