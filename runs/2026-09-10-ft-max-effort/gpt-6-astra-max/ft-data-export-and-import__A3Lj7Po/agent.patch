new file mode 100644
index 0000000..1f9a606
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,92 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself)
+
+  before_validation :set_storage_service_name, on: :create
+  validate :file_attached, on: :create
+  after_create_commit :import_later
+
+  def import_later
+    Current.without_account { Account::ImportJob.perform_later(self) }
+  end
+
+  def import_now(resume: false)
+    if claim(resume: resume)
+      importer = Account::DataTransfer::Importer.new(self)
+      begin
+        cleanup_files
+        ZipFile.open(file.blob) do |zip|
+          importer.stage(zip)
+          transaction do
+            update!(account: importer.import, status: :completed, completed_at: Time.current)
+          end
+        end
+      rescue => error
+        # An after_commit callback may fail after the account was committed. Never
+        # delete files belonging to a successfully committed account.
+        unless reload.completed?
+          importer.cleanup
+          update!(account: nil, status: :failed, completed_at: Time.current, error: failure_reason(error))
+        end
+        Rails.error.report(error)
+      end
+      notify_later
+    end
+
+    file.purge if completed? || failed?
+  end
+
+  def storage_prefix
+    "imports/#{id}/"
+  end
+
+  def storage_service
+    ActiveStorage::Blob.services.fetch(storage_service_name)
+  end
+
+  def cleanup_files
+    storage_service.delete_prefixed(storage_prefix) unless completed?
+  end
+
+  private
+    def claim(resume:)
+      with_lock do
+        if pending? || (processing? && resume)
+          processing!
+          true
+        end
+      end
+    end
+
+    def notify_later
+      if completed?
+        Account::ImportMailer.completed(self).deliver_later
+      else
+        Account::ImportMailer.failed(self).deliver_later
+      end
+    end
+
+    def set_storage_service_name
+      self.storage_service_name ||= ActiveStorage::Blob.service.name
+    end
+
+    def file_attached
+      errors.add(:file, "must be an account ZIP export") unless file.attached?
+    end
+
+    def failure_reason(error)
+      case error
+      when Account::DataTransfer::Importer::InvalidArchive, ZipFile::InvalidFile
+        error.message.truncate(1000)
+      when ActiveStorage::FileNotFoundError
+        "A file is missing from the account export. Please export the account again."
+      when ActiveRecord::ActiveRecordError, KeyError, TypeError, ArgumentError
+        "The account export contains invalid or inconsistent records. Please export the account again."
+      else
+        "An unexpected error prevented the import from completing. Please try again or contact support."
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
