@@ -0,0 +1,18 @@
+<% @page_title = "Import a Fizzy account" %>
+
+<div class="panel panel--centered flex flex-column gap">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+  <p>Upload a ZIP downloaded from Fizzy's account settings. We'll create a new account with its boards, cards, comments, files, and people. Your existing accounts won't change.</p>
+  <p>We'll email <strong><%= Current.identity.email_address %></strong> when it's done, or explain why it couldn't be imported. An unsuccessful import won't leave any imported data behind.</p>
+
+  <%= form_with model: @import, url: account_imports_path, class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <% if @import.errors.any? %>
+      <div role="alert" class="txt-negative">
+        <%= @import.errors.full_messages.to_sentence %>
+      </div>
+    <% end %>
+    <%= form.label :file, "Account ZIP file" %>
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+    <%= form.submit "Import account", class: "btn btn--link center" %>
+  <% end %>
+</div>
