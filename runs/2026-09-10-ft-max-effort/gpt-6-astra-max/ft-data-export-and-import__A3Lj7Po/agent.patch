+  def self.export_blob(zip, blob)
+    path = path_for(blob)
+    unless zip.exists?(path)
+      zip.add_file(path, compress: false) do |io|
+        digest = Digest::MD5.new
+        size = 0
+        blob.download do |chunk|
+          io.write(chunk)
+          size += chunk.bytesize
+          digest.update(chunk)
+        end
+        unless size == blob.byte_size && Base64.strict_encode64(digest.digest) == blob.checksum
+          raise ActiveStorage::IntegrityError, "An attached file has an incorrect checksum"
+        end
+      end
     end
+    path
+  end
 
