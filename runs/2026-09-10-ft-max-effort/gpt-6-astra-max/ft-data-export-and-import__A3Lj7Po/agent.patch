index 0000000..5c6dd7e
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,91 @@
+class Export < ApplicationRecord
+  class NotPermitted < StandardError; end
+
+  DOWNLOAD_PERIOD = 24.hours
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), prefix: true
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself)
+
+  validate :permitted_user, on: :create
+  after_create_commit :export_later
+
+  def self.cleanup
+    where.not(status: :pending).where(completed_at: ..DOWNLOAD_PERIOD.ago).find_each(&:destroy!)
+  end
+
+  def export_later
+    Current.with_account(account) { ExportJob.perform_later(self) }
+  end
+
+  # Retries may reclaim an interrupted job; ordinary duplicate requests may not.
+  def export_now(resume: false)
+    if claim(resume: resume)
+      begin
+        raise NotPermitted, "You no longer have permission to export this data" unless permitted?
+        file.purge
+        Current.with_account(account) do
+          ZipFile.create_for(file, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+            # A read-only snapshot does not hold a SQLite write lock while streaming.
+            ApplicationRecord.transaction do
+              if kind_account?
+                Account::DataTransfer::Manifest.new(account).export_to(zip)
+              else
+                Account::DataTransfer::CardExport.new(user.accessible_cards.where(account: account)).export_to(zip)
+                zip.add_file("manifest.json", { format: "fizzy-cards", version: Account::DataTransfer::Manifest::VERSION }.to_json)
+              end
+            end
+          end
+        end
+        update!(status: :completed, completed_at: Time.current)
+      rescue => error
+        file.purge
+        update!(status: :failed, completed_at: Time.current, error: "The export could not be completed. Please try again.")
+        Rails.error.report(error)
+      end
+
+      if completed?
+        ExportMailer.completed(self).deliver_later
+      elsif user.identity
+        ExportMailer.failed(self).deliver_later
+      end
+    end
+  end
+
+  def expires_at
+    completed_at + DOWNLOAD_PERIOD if completed_at
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at) if completed? && completed_at
+  end
+
+  def available?
+    completed? && expires_at&.future? && file.attached? && permitted?
+  end
+
+  def accessible_to?(user)
+    self.user == user && available?
+  end
+
+  private
+    def claim(resume:)
+      with_lock do
+        if pending? || (processing? && resume)
+          processing!
+          true
+        end
+      end
+    end
+
+    def permitted_user
+      errors.add(:user, "cannot export this data") unless permitted?
+    end
+
+    def permitted?
+      user && account && user.account_id == account.id && user.active? && account.active? && (!kind_account? || user.admin?)
+    end
+end
