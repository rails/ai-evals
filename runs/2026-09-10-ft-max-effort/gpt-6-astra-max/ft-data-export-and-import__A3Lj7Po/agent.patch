+    blob = ActiveStorage::Blob.new(key: "archive", byte_size: data.bytesize, service_name: service.name)
+    blob.stubs(:service).returns(service)
+    service.expects(:download).never
+    service.define_singleton_method(:download_chunk) { |key, range| data.byteslice(range) }
+
+    ZipFile.open(blob) { |zip| assert_equal "streamed content", zip.read("data") }
+  end
+
+  test "S3 import writes extracted files using multipart uploads and verifies checksums" do
