@@ -0,0 +1,21 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  layout "public"
+
+  def new
+    @import = Current.identity.imports.new
+  end
+
+  def create
+    @import = Current.identity.imports.new
+    upload = params.dig(:account_import, :file)
+    # Only accept a new upload, never a signed blob belonging to another record.
+    @import.file = upload if upload.is_a?(ActionDispatch::Http::UploadedFile)
+
+    if @import.save
+      redirect_to new_account_import_path, notice: "Your account is being imported. We'll email you when it's done."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
