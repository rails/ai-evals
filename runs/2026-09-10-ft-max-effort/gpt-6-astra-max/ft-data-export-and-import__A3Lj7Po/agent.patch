@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "the job emails completion with a link to the new account" do
+    export = Export.create!(account: accounts("37s"), user: users(:kevin), kind: :account)
+    export.export_now
+    import = export.file.blob.open do |io|
+      Account::Import.create!(identity: identities(:kevin),
+        file: { io: io, filename: "account.zip", content_type: "application/zip" })
+    end
+
+    perform_enqueued_jobs only: Account::ImportJob
+    assert import.reload.completed?, import.error
+    assert_not import.file.attached?
+    assert_enqueued_email_with Account::ImportMailer, :completed, args: [ import ]
+    email = Account::ImportMailer.completed(import).message
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_includes email.text_part.body.to_s, "http://example.com#{import.account.slug}"
+    assert_not_includes email.text_part.body.to_s, "http://example.com#{accounts("37s").slug}"
+  end
+
+  test "failed jobs remove interrupted uploads and email an explanation" do
+    import = Account::Import.create!(identity: identities(:kevin),
+      file: { io: StringIO.new("not a zip"), filename: "account.zip", content_type: "application/zip" })
+    import.processing!
+    partial_key = "#{import.storage_prefix}interrupted-file"
+    import.storage_service.upload(partial_key, StringIO.new("left over from an interrupted worker"))
+    assert import.storage_service.exist?(partial_key)
+
+    import.import_now(resume: true)
+    assert import.reload.failed?
+    assert_not import.file.attached?
+    assert_not import.storage_service.exist?(partial_key)
+    assert_enqueued_email_with Account::ImportMailer, :failed, args: [ import ]
+    email = Account::ImportMailer.failed(import).message
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_includes email.text_part.body.to_s, import.error
+    assert_includes email.text_part.body.to_s, "No new account or imported data has been kept"
+  end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..4d87e80
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+  end
+
+  test "the job builds the archive and emails a fixed one day download link" do
+    export = @account.exports.create!(user: @user, kind: :cards)
+    assert_enqueued_jobs 1, only: ExportJob
+
+    travel 3.days do
+      perform_enqueued_jobs only: ExportJob
+      assert export.reload.completed?
+      assert_in_delta 1.day, export.expires_at - Time.current, 1
+      assert_enqueued_email_with ExportMailer, :completed, args: [ export ]
+      email = ExportMailer.completed(export).message
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_includes email.text_part.body.to_s, "/exports/"
+      assert_includes email.text_part.body.to_s, "24 hours"
+      assert_not_includes email.text_part.body.to_s, "#{@account.slug}/exports"
+    end
+  end
+
+  test "permission is checked again when an export runs" do
+    export = @account.exports.create!(user: @user, kind: :account)
+    @user.update!(role: :member)
+    export.export_now
+
+    assert export.failed?
+    assert_not export.file.attached?
+    assert_not export.available?
+  end
+
+  test "personal export uses the boards visible at execution time" do
+    export = @account.exports.create!(user: @user, kind: :cards)
+    @user.accesses.delete_all
+    export.export_now
+    assert export.completed?
+    ZipFile.open(export.file.blob) { |zip| assert_empty zip.glob("cards/*.json") }
+  end
+
+  test "an archive never includes itself or previous exports" do
+    first = @account.exports.create!(user: @user, kind: :cards)
+    first.export_now
+    second = @account.exports.create!(user: @user, kind: :account)
+    second.export_now
+    assert second.completed?
+    ZipFile.open(second.file.blob) do |zip|
+      assert_empty zip.glob("files/*/*.zip")
+      assert_empty zip.glob("records/exports/*.json")
+    end
+  end
+
+  test "download lifetime is exactly 24 hours across daylight saving changes" do
+    Time.use_zone("America/New_York") do
+      travel_to Time.zone.local(2026, 3, 7, 12) do
+        export = @account.exports.create!(user: @user, kind: :cards)
+        export.export_now
+        assert_equal 24.hours, export.expires_at - export.completed_at
+      end
+    end
+  end
+
+  test "admins can export boards they cannot access personally" do
+    owner = users(:jason)
+    assert_empty owner.boards
+    export = @account.exports.create!(user: owner, kind: :account)
+    export.export_now
+    assert export.completed?
+    ZipFile.open(export.file.blob) { |zip| assert zip.exists?("cards/1.json") }
+  end
+
+  test "pending direct uploads do not prevent an account export" do
+    pending = ActiveStorage::Blob.create_before_direct_upload!(filename: "unfinished.txt", byte_size: 20, checksum: "pending")
+    export = @account.exports.create!(user: @user, kind: :account)
+    export.export_now
+    assert export.completed?, export.error
+    ZipFile.open(export.file.blob) { |zip| assert_empty zip.glob("files/#{pending.id}/*") }
+  end
+
+  test "an interrupted export can be retried without duplicating its archive" do
+    export = @account.exports.create!(user: @user, kind: :cards)
+    export.processing!
+    export.file.attach(io: StringIO.new("partial zip"), filename: "partial.zip")
+    partial = export.file.blob
+    export.export_now
+    assert export.processing?
+    export.export_now(resume: true)
+    assert export.completed?, export.error
+    assert_not partial.service.exist?(partial.key)
+    assert_not ActiveStorage::Blob.exists?(partial.id)
+  end
+
+  test "finished jobs are idempotent and expired archives are cleaned up" do
+    export = @account.exports.create!(user: @user, kind: :cards)
+    export.export_now
+    blob = export.file.blob
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      assert_no_enqueued_emails { export.export_now }
+    end
+    travel_to export.expires_at + 1.second do
+      assert_not export.available?
+      perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+        Export.cleanup
+      end
+      assert_not Export.exists?(export.id)
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
+end
