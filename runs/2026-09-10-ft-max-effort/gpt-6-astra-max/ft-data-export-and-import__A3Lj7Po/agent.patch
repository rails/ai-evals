@@ -0,0 +1,306 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = Current.user = users(:kevin)
+  end
+
+  test "account export imports into a new account with its people and content" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.open(export.file.blob) do |zip|
+      assert_equal "fizzy-account", JSON.parse(zip.read("manifest.json"))["format"]
+      card = JSON.parse(zip.read("cards/1.json"))
+      assert_equal cards(:logo).title, card["title"]
+      assert_equal cards(:logo).comments.count, card["comments"].size
+    end
+
+    import = account_import_for(export)
+    assert_difference -> { Account.count }, 1 do
+      import.import_now
+    end
+
+    assert import.completed?, import.error
+    imported = import.account
+    assert_not_equal @account.id, imported.id
+    assert_not_equal @account.external_account_id, imported.external_account_id
+    assert_equal @account.name, imported.name
+    assert_equal @account.boards.count, imported.boards.count
+    assert_equal @account.cards.count, imported.cards.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: imported).count
+    assert_equal @account.users.count, imported.users.count
+    assert imported.users.find_by!(identity: @user.identity).owner?
+    assert_equal cards(:logo).description.to_plain_text, imported.cards.find_by!(number: 1).description.to_plain_text
+    assert_not import.file.attached?
+  end
+
+  test "personal exports only contain visible cards and their comments" do
+    private_card = boards(:private).cards.create!(title: "Private", creator: @user, status: :published)
+    export = Export.create!(account: @account, user: users(:david), kind: :cards)
+    export.export_now
+
+    ZipFile.open(export.file.blob) do |zip|
+      assert zip.exists?("cards/1.json")
+      assert_not zip.exists?("cards/#{private_card.number}.json")
+      assert_empty zip.glob("records/*/*.json")
+      assert_equal "fizzy-cards", JSON.parse(zip.read("manifest.json"))["format"]
+    end
+  end
+
+  test "invalid imports do not leave an account behind" do
+    import = Account::Import.create!(identity: @user.identity,
+      file: { io: StringIO.new("not a zip"), filename: "account.zip", content_type: "application/zip" })
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Identity.count }, -> { Card.count } ] do
+      import.import_now
+    end
+
+    assert import.failed?
+    assert import.error.present?
+    assert_nil import.account
+    assert_not import.file.attached?
+  end
+
+  test "pictures files mentions and historical timestamps survive an import" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    embedded = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("description attachment"), filename: "notes.txt", content_type: "text/plain")
+    card.update!(description: ActionText::Content.new("<p>With a mention</p>").append_attachables([ embedded, users(:david) ]))
+    comment = comments(:logo_agreement_kevin)
+    comment_file = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("comment attachment"), filename: "comment.txt", content_type: "text/plain")
+    comment.update!(body: ActionText::Content.new("<p>A comment</p>").append_attachables(comment_file))
+    original_updated_at = card.reload.updated_at
+
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    assert export.completed?, export.error
+
+    ZipFile.open(export.file.blob) do |zip|
+      json = JSON.parse(zip.read("cards/1.json"))
+      assert_equal %w[ moon.jpg notes.txt ], json["attachments"].map { |attachment| attachment["filename"] }.sort
+      assert_equal "description attachment", zip.read(json["attachments"].find { |attachment| attachment["filename"] == "notes.txt" }["path"])
+    end
+
+    import = account_import_for(export)
+    import.import_now
+    assert import.completed?, import.error
+    imported_card = import.account.cards.find_by!(number: 1)
+    assert_equal original_updated_at, imported_card.updated_at
+    assert_equal card.image.download, imported_card.image.download
+    assert_not_equal card.image.blob.key, imported_card.image.blob.key
+    assert_equal "description attachment", imported_card.attachments.first.download
+    assert_equal "comment attachment", imported_card.comments.find_by!(creator: import.account.users.find_by!(identity: @user.identity)).attachments.first.download
+    assert_includes imported_card.description.body.attachables, import.account.users.find_by!(identity: users(:david).identity)
+    assert_not_includes imported_card.description.body.attachables, users(:david)
+    assert_equal import.account.id, imported_card.image.blob.account_id
+    assert_equal @account.bytes_used_exact, import.account.bytes_used_exact
+    assert_not Storage::Entry.where(account: import.account, user_id: @account.users.select(:id)).exists?
+    assert_equal @user, Current.user
+  end
+
+  test "the same archive can be imported twice without changing its source" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    first, second = account_import_for(export), account_import_for(export)
+    source_cards = @account.cards.pluck(:id, :title)
+
+    assert_difference -> { Account.count }, 2 do
+      first.import_now
+      second.import_now
+    end
+    assert first.completed?, first.error
+    assert second.completed?, second.error
+    assert_not_equal first.account_id, second.account_id
+    assert_empty first.account.cards.ids & second.account.cards.ids
+    assert_equal source_cards, @account.cards.pluck(:id, :title)
+
+    assert_no_difference -> { Account.count } do
+      first.import_now
+    end
+  end
+
+  test "a different signed in identity becomes owner without replacing imported people" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    import = account_import_for(export)
+    identity = Identity.create!(email_address: "importer@example.com")
+    import.update!(identity: identity)
+    import.import_now
+
+    assert import.completed?, import.error
+    assert_equal @account.users.count + 1, import.account.users.count
+    owner = import.account.users.find_by!(identity: identity)
+    assert owner.owner?
+    assert_equal import.account.boards.count, owner.boards.count
+    assert users(:jason).reload.owner?
+  end
+
+  test "personal archives cannot be imported as accounts" do
+    export = Export.create!(account: @account, user: @user, kind: :cards)
+    export.export_now
+    import = account_import_for(export)
+
+    assert_no_difference -> { Account.count } do
+      import.import_now
+    end
+    assert import.failed?
+    assert_match "not a personal cards export", import.error
+  end
+
+  test "missing records and foreign account references roll back all changes" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    import = altered_import(export) do |path, content|
+      if path == "records/cards/#{cards(:logo).id}.json"
+        JSON.parse(content).merge("board_id" => boards(:miltons_wish_list).id).to_json
+      else
+        content
+      end
+    end
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Identity.count }, -> { Card.count }, -> { Board.count } ] do
+      import.import_now
+    end
+    assert import.failed?
+    assert_match "Missing Board reference", import.error
+  end
+
+  test "a late failure rolls back new identities records search data and stored files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    import = altered_import(export) do |path, content|
+      if path == "records/users/#{users(:david).id}.json"
+        JSON.parse(content).merge("email_address" => "brand-new-person@example.com").to_json
+      else
+        content
+      end
+    end
+    Account.any_instance.stubs(:materialize_storage).raises("Simulated finalization failure")
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Identity.count }, -> { Card.count }, -> { Board.count }, -> { Search::Record.for(@account.id).count }, -> { ActionText::RichText.count }, -> { Storage::Entry.count }, -> { Storage::Total.count } ] do
+      import.import_now
+    end
+    assert import.failed?
+    assert_empty Dir.glob("#{import.storage_service.send(:path_for, import.storage_prefix)}/**/*").select { |path| File.file?(path) }
+    assert_not Identity.exists?(email_address: "brand-new-person@example.com")
+  end
+
+  test "shared template files are copied without other accounts' data" do
+    template = accounts(:initech)
+    shared = unrelated = nil
+    Current.with_account(template) do
+      shared = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("shared template file"), filename: "template.txt", content_type: "text/plain")
+      unrelated = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("private file"), filename: "private.txt", content_type: "text/plain")
+    end
+    stub_const(Storage, :TEMPLATE_ACCOUNT_ID, template.id) do
+      cards(:logo).update!(description: ActionText::Content.new("Template").append_attachables(shared))
+    end
+
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    assert export.completed?, export.error
+    ZipFile.open(export.file.blob) do |zip|
+      assert zip.exists?("files/#{shared.id}/template.txt")
+      assert_not zip.exists?("files/#{unrelated.id}/private.txt")
+      assert_not zip.exists?("records/users/#{users(:mike).id}.json")
+    end
+    import = account_import_for(export)
+    import.import_now
+    assert import.completed?, import.error
+    blob = import.account.cards.find_by!(number: 1).attachments.first.blob
+    assert_equal "shared template file", blob.download
+    assert_equal import.account_id, blob.account_id
+    assert_not_equal shared.key, blob.key
+  end
+
+  test "missing binary files and checksum mismatches fail without an account" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    assert export.completed?
+
+    [ nil, "corrupted content" ].each do |replacement|
+      import = altered_import(export) { |path, content| path.start_with?("files/") ? replacement : content }
+      assert_no_difference -> { Account.count } do
+        import.import_now
+      end
+      assert import.failed?
+      assert_not import.file.attached?
+      assert_empty Dir.glob("#{import.storage_service.send(:path_for, import.storage_prefix)}/**/*").select { |path| File.file?(path) }
+    end
+  end
+
+  test "files are staged before any account records are inserted" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    import = account_import_for(export)
+    count = Account.count
+    open_transactions = ApplicationRecord.connection.open_transactions
+    copied = false
+    original = ZipFile::Reader.instance_method(:copy_to)
+    test_case = self
+    ZipFile::Reader.define_method(:copy_to) do |path, blob|
+      test_case.assert_equal count, Account.count
+      test_case.assert_not blob.persisted?
+      test_case.assert_equal open_transactions, ApplicationRecord.connection.open_transactions
+      copied = true
+      original.bind_call(self, path, blob)
+    end
+    import.import_now
+    assert import.completed?, import.error
+    assert copied
+  ensure
+    ZipFile::Reader.define_method(:copy_to, original) if original
+  end
+
+  test "historical broken links are retained and comment anchors are remapped" do
+    missing_board_id = ActiveRecord::Type::Uuid.generate
+    cards(:logo).update!(description: <<~HTML)
+      <a href="#{@account.slug}/boards/#{missing_board_id}">An old board</a>
+      <a href="#{@account.slug}/cards/1#comment_#{comments(:logo_agreement_kevin).id}">A comment</a>
+    HTML
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.export_now
+    import = account_import_for(export)
+    import.import_now
+
+    assert import.completed?, import.error
+    card = import.account.cards.find_by!(number: 1)
+    comment = card.comments.find_by!(creator: import.account.users.find_by!(identity: @user.identity))
+    assert_includes card.description.body.to_html, "#{import.account.slug}/boards/#{missing_board_id}"
+    assert_includes card.description.body.to_html, "#{import.account.slug}/cards/1#comment_#{comment.id}"
+  end
+
+  private
+    def altered_import(export)
+      io = StringIO.new("".b)
+      writer = ZipFile::Writer.new(io)
+      ZipFile.open(export.file.blob) do |zip|
+        zip.glob("**/*").each do |path|
+          content = yield(path, zip.read(path))
+          writer.add_file(path, content) if content
+        end
+      end
+      writer.close
+      io.rewind
+      Current.without_account do
+        Account::Import.create!(identity: @user.identity,
+          file: { io: io, filename: "account.zip", content_type: "application/zip" })
+      end
+    end
+
+    def account_import_for(export)
+      export.file.blob.open do |io|
+        Account::Import.create!(identity: @user.identity,
+          file: { io: io, filename: "account.zip", content_type: "application/zip" })
+      end
+    end
+end
