+    # Sparse files occupy only a few filesystem blocks despite their logical size.
+    Tempfile.create("zip64") do |file|
+      file.binmode
+      file.seek(offset)
+      file.write(local_file + central + zip64_end + locator + ending)
+      file.flush
+      service = s3_service
+      bytes_read = 0
+      service.expects(:download).never
+      service.define_singleton_method(:download_chunk) do |key, range|
+        bytes_read += range.size
+        file.seek(range.begin)
+        file.read(range.size)
+      end
+      blob = ActiveStorage::Blob.new(key: "large-archive", byte_size: file.size, service_name: service.name)
+      blob.stubs(:service).returns(service)
