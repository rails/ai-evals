diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..3a1eb69
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    cancel_account(at: 31.days.ago)
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "incinerates multiple overdue accounts when enqueued without an account" do
+    cancel_account(at: 31.days.ago)
+    accounts(:initech).cancel(initiated_by: users(:mike))
+    accounts(:initech).cancellation.update!(created_at: 32.days.ago)
+
+    Current.without_account do
+      perform_enqueued_jobs(only: Account::IncinerateDueJob) do
+        Account::IncinerateDueJob.perform_later
+      end
+    end
+
+    assert_performed_with job: Account::IncinerateDueJob, queue: "backend"
+    assert_equal [ accounts(:acme).id ], Account.ids
+  end
+
+  test "retains accounts within the grace period" do
+    cancel_account(at: 29.days.ago)
+
+    assert_no_difference "Account.count" do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  test "waits until more than 30 days after cancellation" do
+    freeze_time do
+      cancel_account(at: 30.days.ago)
+
+      assert_no_difference "Account.count" do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert @account.reload.cancelled?
+
+      travel 1.second
+      Account::IncinerateDueJob.perform_now
+
+      assert_not Account.exists?(@account.id)
+    end
+  end
+
+  test "retains reactivated accounts" do
+    cancel_account(at: 31.days.ago)
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert @account.reload.active?
+  end
+
+  test "can run again after incinerating accounts" do
+    cancel_account(at: 31.days.ago)
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+
+      assert_no_difference "Account.count" do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  private
+    def cancel_account(at:)
+      @account.cancel(initiated_by: users(:david))
+      @account.cancellation.update!(created_at: at)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..7f6aff3
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @account.cancel(initiated_by: users(:david))
+    @account.cancellation.update!(created_at: 31.days.ago)
+  end
+
+  test "incinerates every account-owned table without touching other accounts or enqueuing activity" do
+    create_account_data(account: @account, user: users(:david), card: cards(:logo))
+    create_account_data(account: accounts(:initech), user: users(:mike), card: cards(:radio))
+    empty_tables = account_record_counts(@account).select { |table, count| count.zero? && !table.start_with?("search_records") }.keys
+    assert_empty empty_tables, "Seed every account-owned table to keep the incineration audit comprehensive"
+    other_account_counts = account_record_counts(accounts(:initech))
+
+    assert_no_enqueued_jobs do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    account_record_counts(@account).each do |table, count|
+      assert_equal 0, count, "Account data remains in #{table}"
+    end
+    assert_equal other_account_counts, account_record_counts(accounts(:initech))
+  end
+
+  test "incinerates all filter join tables" do
+    own_filter = filters(:jz_assignments)
+    other_filter = users(:mike).filters.create!(terms: [ "retained" ])
+
+    other_tag = Tag.create!(account: accounts(:initech), title: "retained")
+    join_tables = {
+      "assignees_filters" => [ :assignee_id, users(:kevin), users(:mike) ],
+      "assigners_filters" => [ :assigner_id, users(:kevin), users(:mike) ],
+      "boards_filters" => [ :board_id, boards(:writebook), boards(:miltons_wish_list) ],
+      "closers_filters" => [ :closer_id, users(:kevin), users(:mike) ],
+      "creators_filters" => [ :creator_id, users(:kevin), users(:mike) ],
+      "filters_tags" => [ :tag_id, tags(:web), other_tag ]
+    }
+
+    join_models = join_tables.map do |table, (foreign_key, own_resource, other_resource)|
+      model = model_for_table(table)
+      model.insert_all! [ { filter_id: own_filter.id, foreign_key => own_resource.id },
+        { filter_id: other_filter.id, foreign_key => other_resource.id } ]
+      model
+    end
+
+    @account.incinerate
+
+    join_models.each do |model|
+      assert_not model.where(filter_id: own_filter.id).exists?, "Account data remains in #{model.table_name}"
+      assert_equal 1, model.where(filter_id: other_filter.id).count
+    end
+  end
+
+  test "incinerates storage totals for the account and its boards" do
+    @account.materialize_storage
+    boards(:writebook).materialize_storage
+    accounts(:initech).materialize_storage
+    boards(:miltons_wish_list).materialize_storage
+
+    own_total_ids = [ @account.storage_total.id, boards(:writebook).storage_total.id ]
+    other_totals = Storage::Total.where.not(id: own_total_ids).order(:id).map(&:attributes)
+
+    @account.incinerate
+
+    assert_not Storage::Total.where(id: own_total_ids).exists?
+    assert_equal other_totals, Storage::Total.order(:id).map(&:attributes)
+  end
+
+  test "incinerates search records including the SQLite full-text index" do
+    cards(:logo).reindex
+    comments(:logo_agreement_jz).reindex
+    cards(:radio).reindex
+
+    search_records = Search::Record.for(@account.id).where(account_id: @account.id)
+    search_ids = search_records.ids
+    other_search_records = Search::Record.for(accounts(:initech).id).where(account_id: accounts(:initech).id)
+    other_search_ids = other_search_records.ids
+
+    assert_not_empty search_ids
+    assert_not_empty other_search_ids
+
+    @account.incinerate
+
+    assert_empty search_records.reload
+    assert_equal other_search_ids, other_search_records.ids
+
+    if Search::Record.connection.adapter_name == "SQLite"
+      assert_not Search::Record::SQLite::Fts.where(rowid: search_ids).exists?
+      assert Search::Record::SQLite::Fts.where(rowid: other_search_ids).exists?
+    end
+  end
+
+  test "preserves global identities and their authentication data" do
+    identity = identities(:david)
+    other_membership = accounts(:initech).users.create!(name: "David", identity: identity)
+
+    assert_no_difference [ "Identity.count", "Session.count", "Identity::AccessToken.count", "MagicLink.count" ] do
+      @account.incinerate
+    end
+
+    assert_equal identity, other_membership.reload.identity
+    assert_not User.where(account_id: @account.id).exists?
+  end
+
+  test "rechecks cancellation after locking the account" do
+    stale_account = Account.find(@account.id)
+    assert stale_account.cancelled?
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      stale_account.incinerate
+    end
+
+    assert stale_account.reload.active?
+  end
+
+  test "a new cancellation starts a new grace period" do
+    stale_account = Account.find(@account.id)
+    assert stale_account.cancelled?
+    @account.reactivate
+    @account.reload.cancel(initiated_by: users(:david))
+
+    assert_no_difference "Account.count" do
+      stale_account.incinerate
+    end
+
+    assert stale_account.reload.cancelled?
+  end
+
+  test "rolls back all database deletion if incineration fails" do
+    create_account_data(account: @account, user: users(:david), card: cards(:logo))
+    original_counts = account_record_counts(@account)
+    original_total_count = Storage::Total.count
+    User.stubs(:where).with(account_id: @account.id).raises(ActiveRecord::StatementInvalid)
+
+    assert_raises ActiveRecord::StatementInvalid do
+      @account.incinerate
+    end
+
+    assert @account.reload.cancelled?
+    assert_equal original_counts, account_record_counts(@account)
+    assert_equal original_total_count, Storage::Total.count
+  end
+
+  private
+    def create_account_data(account:, user:, card:)
+      Current.with_account(account) do
+        user.create_settings! unless user.settings
+        blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("image data"), filename: "image.png", content_type: "image/png")
+        card.image.attach(blob)
+        blob.variant_records.create!(variation_digest: "thumbnail")
+        ActiveStorage::Blob.create_and_upload!(io: StringIO.new("abandoned upload"), filename: "abandoned.txt", content_type: "text/plain")
+        card.update!(description: "Private account content")
+        card.create_activity_spike!
+        card.create_not_now!(user: user)
+        card.steps.create!(content: "A private step")
+        card.board.create_publication!
+        user.search_queries.create!(terms: "private search")
+        user.notification_bundles.create!
+        subscription = user.push_subscriptions.build(endpoint: "https://fcm.googleapis.com/#{user.id}")
+        subscription.stubs(:resolved_endpoint_ip).returns("8.8.8.8")
+        subscription.save!
+        account.imports.create!(identity: user.identity, status: :completed)
+        user.data_exports.create!(account: account)
+        account.materialize_storage
+        card.board.materialize_storage
+      end
+    end
+
+    def account_record_counts(account)
+      account_record_classes.to_h do |model|
+        [ model.table_name, model.where(account_id: account.id).count ]
+      end
+    end
+
+    def account_record_classes
+      @account_record_classes ||= ApplicationRecord.with_connection do |connection|
+        connection.tables.filter_map do |table|
+          if connection.columns(table).any? { |column| column.name == "account_id" }
+            model_for_table(table)
+          end
+        end
+      end
+    end
+
+    def model_for_table(table)
+      Class.new(ApplicationRecord) do
+        self.table_name = table
+        self.inheritance_column = nil
+      end
+    end
+end
