diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..3591287 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,101 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    Current.with_account(self) do
+      with_lock do
+        if cancellation.present? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+          incinerate_filter_joins
+          incinerate_search_records
+          incinerate_storage_totals
+          incinerate_account_records
+          destroy!
+        end
+      end
+    end
+  end
+
+  private
+    def incinerate_filter_joins
+      filter_ids = Filter.where(account_id: id).select(:id).to_sql
+
+      self.class.with_connection do |connection|
+        %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].each do |table|
+          connection.delete("DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{filter_ids})")
+        end
+      end
+    end
+
+    def incinerate_search_records
+      # Destroying search records also removes their SQLite full-text rows.
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+    end
+
+    def incinerate_storage_totals
+      Storage::Total.where(owner: self).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: boards.select(:id)).delete_all
+    end
+
+    def incinerate_account_records
+      # Avoid activity, notification, and storage callbacks while deleting the whole account.
+      account_record_classes.each do |record_class|
+        record_class.where(account_id: id).delete_all
+      end
+    end
+
+    def account_record_classes
+      [
+        ActiveStorage::Attachment,
+        ActiveStorage::VariantRecord,
+        ActiveStorage::Blob,
+        ActionText::RichText,
+        Account::Cancellation,
+        Account::Import,
+        Account::JoinCode,
+        Webhook::Delivery,
+        Webhook::DelinquencyTracker,
+        Webhook,
+        Notification,
+        Notification::Bundle,
+        Mention,
+        Reaction,
+        Pin,
+        Watch,
+        Assignment,
+        Tagging,
+        Closure,
+        Card::Goldness,
+        Card::NotNow,
+        Card::ActivitySpike,
+        Step,
+        Storage::Entry,
+        Event,
+        Comment,
+        Card,
+        Access,
+        Board::Publication,
+        Column,
+        Entropy,
+        Board,
+        Tag,
+        Export,
+        Search::Query,
+        Push::Subscription,
+        User::Settings,
+        Filter,
+        User
+      ]
+    end
 end
