diff --git a/config/initializers/active_storage_account.rb b/config/initializers/active_storage_account.rb
new file mode 100644
index 0000000..108ab38
--- /dev/null
+++ b/config/initializers/active_storage_account.rb
@@ -0,0 +1,30 @@
+module ActiveStorageBlobAccount
+  def build_after_unfurling(record: nil, **attributes)
+    super.tap do |blob|
+      # Defer account assignment until validation: a new owning record may not
+      # have assigned its own default account when the upload is first built.
+      blob.account_owner = case record
+      when ActiveStorage::VariantRecord
+        record.blob
+      when ActionText::RichText
+        record.record
+      else
+        record
+      end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  attr_accessor :account_owner
+  belongs_to :account, default: -> { account_owner.try(:account) || Current.account }
+  singleton_class.prepend ActiveStorageBlobAccount
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.account }
+end
