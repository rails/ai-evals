+ENV["RAILS_ENV"] ||= "test"
+require_relative "../../config/environment"
+require "minitest/autorun"
+require "delegate"
+require_relative "../../db/migrate/20260710120000_complete_account_id_rollout"
+
+class CompleteAccountIdRolloutTest < Minitest::Test
+  class Database < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  # A minimal pre-rollout schema, independent of application models and fixtures.
+  TABLE_COLUMNS = {
+    accounts: [], identities: [], sessions: [ :identity_id ], magic_links: [ :identity_id ],
+    identity_access_tokens: [ :identity_id ], action_pack_passkeys: [ :holder_id, :holder_type ],
+    account_external_id_sequences: [],
+    users: [ :account_id, :identity_id ], tags: [ :account_id ], account_join_codes: [ :account_id ],
+    account_imports: [ :account_id ], account_cancellations: [ :account_id ], exports: [ :account_id ],
+    storage_entries: [ :account_id ], search_records: [ :account_id ],
+    boards: [ :account_id, :creator_id ], cards: [ :account_id, :board_id ],
+    columns: [ :account_id, :board_id ], comments: [ :account_id, :card_id ],
+    events: [ :account_id, :board_id ], filters: [ :account_id, :creator_id ],
+    notification_bundles: [ :account_id, :user_id ], notifications: [ :account_id, :user_id ],
+    push_subscriptions: [ :account_id, :user_id ], steps: [ :account_id, :card_id ],
+    webhooks: [ :account_id, :board_id ], accesses: [ :board_id, :user_id ],
+    assignments: [ :card_id ], board_publications: [ :board_id ],
+    card_activity_spikes: [ :card_id ], card_goldnesses: [ :card_id ], card_not_nows: [ :card_id ],
+    closures: [ :card_id ], pins: [ :card_id ], taggings: [ :card_id ], watches: [ :card_id ],
+    search_queries: [ :user_id ], user_settings: [ :user_id ],
+    webhook_deliveries: [ :webhook_id ], webhook_delinquency_trackers: [ :webhook_id ],
+    assignees_filters: [ :filter_id, :assignee_id ], assigners_filters: [ :filter_id, :assigner_id ],
+    boards_filters: [ :filter_id, :board_id ], closers_filters: [ :filter_id, :closer_id ],
+    creators_filters: [ :filter_id, :creator_id ], filters_tags: [ :filter_id, :tag_id ],
+    entropies: [ :container_id, :container_type ], storage_totals: [ :owner_id, :owner_type ],
+    mentions: [ :source_id, :source_type ], reactions: [ :reactable_id, :reactable_type ],
+    action_text_rich_texts: [ :record_id, :record_type ],
+    active_storage_blobs: [], active_storage_attachments: [ :record_id, :record_type, :blob_id ],
+    active_storage_variant_records: [ :blob_id ]
+  }.freeze
+
+  GLOBAL_TABLES = %i[
+    accounts identities sessions magic_links identity_access_tokens action_pack_passkeys account_external_id_sequences
+  ].freeze
+  JOIN_TABLES = %i[assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags].freeze
+  REQUIRED_TABLES = %i[account_cancellations exports storage_entries search_records].freeze
+  DIRECT_PARENTS = {
+    boards: [ :users, :creator_id ], cards: [ :boards, :board_id ], columns: [ :boards, :board_id ],
+    comments: [ :cards, :card_id ], events: [ :boards, :board_id ], filters: [ :users, :creator_id ],
+    notification_bundles: [ :users, :user_id ], notifications: [ :users, :user_id ],
+    push_subscriptions: [ :users, :user_id ], steps: [ :cards, :card_id ], webhooks: [ :boards, :board_id ],
+    accesses: [ :boards, :board_id ], assignments: [ :cards, :card_id ], board_publications: [ :boards, :board_id ],
+    card_activity_spikes: [ :cards, :card_id ], card_goldnesses: [ :cards, :card_id ], card_not_nows: [ :cards, :card_id ],
+    closures: [ :cards, :card_id ], pins: [ :cards, :card_id ], taggings: [ :cards, :card_id ], watches: [ :cards, :card_id ],
+    search_queries: [ :users, :user_id ], user_settings: [ :users, :user_id ],
+    webhook_deliveries: [ :webhooks, :webhook_id ], webhook_delinquency_trackers: [ :webhooks, :webhook_id ],
+    assignees_filters: [ :filters, :filter_id ], assigners_filters: [ :filters, :filter_id ],
+    boards_filters: [ :filters, :filter_id ], closers_filters: [ :filters, :filter_id ],
+    creators_filters: [ :filters, :filter_id ], filters_tags: [ :filters, :filter_id ]
+  }.freeze
+
+  def setup
+    Database.establish_connection adapter: "sqlite3", database: ":memory:"
+    @connection = Database.connection
+    @expected = []
+
+    TABLE_COLUMNS.each do |table, columns|
+      @connection.create_table table, id: JOIN_TABLES.include?(table) ? false : :uuid do |t|
+        t.string :payload
+        columns.each do |column|
+          t.column column, column.to_s.end_with?("_type") ? :string : :uuid,
+            null: !(column == :account_id && REQUIRED_TABLES.include?(table))
+        end
+      end
+    end
+
+    (REQUIRED_TABLES + [ :account_imports ]).each { |table| @connection.add_index table, :account_id }
+    @connection.add_index :users, [ :account_id, :identity_id ], unique: true
+  end
