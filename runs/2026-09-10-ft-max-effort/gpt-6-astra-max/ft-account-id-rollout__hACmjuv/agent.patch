+    comment_text = insert :action_text_rich_texts, "comment-body", record_id: ids[:comments], record_type: "Comment"
+    @expected << [ :action_text_rich_texts, rich_text, account ] << [ :action_text_rich_texts, comment_text, account ]
+
+    { "User" => ids[:users], "Export" => ids[:exports], "Account::Export" => ids[:exports], "Account::Import" => ids[:account_imports],
+      "ActionText::RichText" => rich_text }.each do |type, record_id|
+      blob = attach_blob(type, record_id, type, account)
+      preview = attach_blob("#{type}-preview", blob, "ActiveStorage::Blob", account)
+      3.times do |depth|
+        variant = insert :active_storage_variant_records, "#{type}-variant-#{depth}", blob_id: preview
+        @expected << [ :active_storage_variant_records, variant, account ]
+        preview = attach_blob("#{type}-variant-image-#{depth}", variant, "ActiveStorage::VariantRecord", account)
+      end
