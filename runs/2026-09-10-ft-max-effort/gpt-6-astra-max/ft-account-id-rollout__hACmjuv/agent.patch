+    Database.remove_connection
+  end
+
+  def test_backfills_every_ownership_path_for_multiple_accounts
+    seed_tenant("first")
+    seed_tenant("second")
+
+    migrate
+
+    @expected.each do |table, id, account|
+      assert_equal account, account_id(table, id), "Wrong account for #{table} #{id}"
+    end
+
+    tenant_tables.each do |table|
+      column = @connection.columns(table).find { |candidate| candidate.name == "account_id" }
+      assert_equal :uuid, column.type, table.to_s
+      refute column.null, table.to_s
+      assert @connection.index_exists?(table, :account_id), table.to_s
+      assert_raises(ActiveRecord::NotNullViolation) { insert(table, "null-account", account_id: nil) }
