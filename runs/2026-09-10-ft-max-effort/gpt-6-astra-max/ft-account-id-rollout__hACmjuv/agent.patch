+require "test_helper"
+
+class Account::DataOwnershipTest < ActiveSupport::TestCase
+  GLOBAL_TABLES = %w[
+    accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys
+    schema_migrations ar_internal_metadata
+  ].freeze
+
+  test "every account data table has a required indexed UUID account id" do
+    connection = ActiveRecord::Base.connection
+    tables = connection.tables.reject { |table| GLOBAL_TABLES.include?(table) || table.start_with?("search_records_fts") }
+
+    tables.each do |table|
+      account_id = connection.columns(table).find { |column| column.name == "account_id" }
+      assert account_id, "#{table} is missing account_id"
+      assert_equal :uuid, account_id.type, table
+      assert_not account_id.null, "#{table}.account_id must be required"
+      assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table}.account_id must be indexed"
+    end
+
+    GLOBAL_TABLES.each do |table|
+      assert_not connection.column_exists?(table, :account_id), "#{table} is global"
+    end
+  end
+
+  test "child records derive their account from their owner rather than the current account" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    user = users(:david)
+    webhook = webhooks(:active)
+    records = [
+      Access.new(board: board, user: user),
+      Assignment.new(card: card, assignee: users(:jz), assigner: user),
+      Board::Publication.new(board: board),
+      Card::ActivitySpike.new(card: card),
+      Card::Goldness.new(card: card),
+      Card::NotNow.new(card: card),
+      Closure.new(card: card),
+      Entropy.new(container: account, auto_postpone_period: 30.days),
+      Entropy.new(container: board, auto_postpone_period: 30.days),
+      Mention.new(source: card, mentioner: user, mentionee: users(:jz)),
+      Mention.new(source: comments(:logo_agreement_jz), mentioner: user, mentionee: users(:jz)),
+      Pin.new(card: card, user: user),
+      Reaction.new(reactable: card, reacter: user, content: "👍"),
+      Reaction.new(reactable: comments(:logo_agreement_jz), reacter: user, content: "👍"),
+      Search::Query.new(user: user, terms: "ownership"),
+      Storage::Total.new(owner: account),
+      Storage::Total.new(owner: board),
+      Tagging.new(card: card, tag: tags(:web)),
+      User::Settings.new(user: user),
+      Watch.new(card: card, user: user),
+      Webhook::Delivery.new(webhook: webhook, event: events(:logo_published)),
+      Webhook::DelinquencyTracker.new(webhook: webhook),
+      ActionText::RichText.new(record: card, name: "description", body: "Owned text")
+    ]
+
+    Current.with_account(accounts(:initech)) do
+      records.each do |record|
+        record.valid?
+        assert_equal account, record.account, "#{record.class} must inherit its owner's account"
+      end
+    end
+  end
+
+  test "bulk access grants include the account" do
+    board = boards(:writebook)
+    user = users(:jz)
+    board.accesses.where(user: user).delete_all
+
+    Current.with_account(accounts(:initech)) do
+      board.accesses.grant_to(user)
+    end
+    assert_equal board.account, board.accesses.find_by!(user: user).account
+
+    board.update!(all_access: true)
+    board.accesses.where(user: user).delete_all
+    Current.with_account(nil) { user.send(:grant_access_to_boards) }
+    assert_equal user.account, board.accesses.find_by!(user: user).account
+  end
+
+  test "all filter join records inherit the filter account without current context" do
+    filter = Current.with_account(nil) do
+      Filter.create! creator: users(:david), tags: [ tags(:web) ], boards: [ boards(:writebook) ],
+        assignees: [ users(:jz) ], creators: [ users(:david) ], closers: [ users(:kevin) ]
+    end
+
+    %i[tags boards assignees creators closers].each do |association|
+      join_model = Filter.const_get("HABTM_#{association.to_s.camelize}")
+      assert_equal filter.account, join_model.find_by!(filter_id: filter.id).account
+    end
+  end
+
+  test "uploads and their derivatives inherit their owner without current context" do
+    user = users(:mike)
+    Current.with_account(nil) do
+      user.avatar.attach io: File.open(file_fixture("avatar.png")), filename: "avatar.png", content_type: "image/png"
+    end
+
+    assert_equal user.account, user.avatar.attachment.account
+    assert_equal user.account, user.avatar.blob.account
+    variant = user.avatar.blob.variant_records.first!
+    assert_equal user.account, variant.account
+    assert_equal user.account, variant.image.attachment.account
+    assert_equal user.account, variant.image.blob.account
+  end
+
+  test "uploads on a new card use its account after owner defaults are assigned" do
+    card = Current.with_account(accounts(:initech)) do
+      Card.create! board: boards(:writebook), creator: users(:david), title: "New upload",
+        image: { io: StringIO.new("contents"), filename: "test.txt", content_type: "text/plain" }
+    end
+
+    assert_equal boards(:writebook).account, card.account
+    assert_equal card.account, card.image.attachment.account
+    assert_equal card.account, card.image.blob.account
+  end
+
+  test "direct uploads use the current account" do
+    blob = Current.with_account(accounts(:initech)) do
+      ActiveStorage::Blob.create_before_direct_upload! filename: "test.txt", byte_size: 4, checksum: "checksum", content_type: "text/plain"
+    end
+    assert_equal accounts(:initech), blob.account
+  end
+
+  test "transient search input remains valid without an owner" do
+    Current.with_account(nil) do
+      assert Search::Query.wrap("search terms").valid?
+      assert_not Search::Query.wrap("").valid?
+    end
+  end
