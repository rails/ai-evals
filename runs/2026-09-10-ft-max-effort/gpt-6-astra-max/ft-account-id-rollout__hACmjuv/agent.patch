+  def test_drops_unresolvable_rows_and_descendants_of_deleted_accounts
+    seed_tenant("survivor")
+    orphan = seed_tenant("orphan")
+    @connection.execute "DELETE FROM accounts WHERE id = #{quote_uuid(orphan[:accounts])}"
+    %i[users tags account_imports account_join_codes].each { |table| insert(table, "orphan-null") }
+    DIRECT_PARENTS.each do |table, (_, foreign_key)|
+      insert table, "orphan-missing-parent", foreign_key => uuid("missing")
+    end
+    { entropies: :container, storage_totals: :owner, mentions: :source, reactions: :reactable,
+      action_text_rich_texts: :record }.each do |table, association|
+      insert table, "orphan-type", "#{association}_type" => "Unknown", "#{association}_id" => orphan[:cards]
+    end
+    insert :active_storage_blobs, "orphan-unattached"
+    insert :active_storage_variant_records, "orphan-variant", blob_id: uuid("missing")
+    insert :active_storage_attachments, "orphan-attachment", record_type: "Card", record_id: uuid("missing"), blob_id: uuid("missing")
+    insert :active_storage_attachments, "orphan-missing-blob", record_type: "Card", record_id: uuid("survivor/cards"), blob_id: uuid("missing")
+    blob = insert :active_storage_blobs, "orphan-cycle"
+    insert :active_storage_attachments, "orphan-cycle-attachment", record_type: "ActiveStorage::Blob", record_id: blob, blob_id: blob
+
+    migrate
+
+    tenant_tables.each do |table|
+      assert_equal 0, @connection.select_value("SELECT COUNT(*) FROM #{table} WHERE payload LIKE 'orphan%'"), table.to_s
+    end
+    assert_equal uuid("survivor/accounts"), account_id(:cards, uuid("survivor/cards"))
+  end
