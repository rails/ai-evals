--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,65 @@
+# Single-server deployment. See docs/deployment.md for setup and backups.
+service: fizzy
+image: fizzy
+
+# Set your public hostname here; the proxy and Rails use the same hostname.
+servers:
+  web:
+    - &hostname fizzy.example.com
+
+proxy:
+  ssl: true
+  host: *hostname
+  # The Dockerfile runs Thruster on port 80 in front of Puma.
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Kamal runs this registry locally and forwards it over SSH during deploys.
+# No external registry account is needed.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Change to arm64 for an ARM server.
+
+# Kamal connects as root by default. For a different Docker-capable SSH user:
+# ssh:
+#   user: app
+
+env:
+  clear:
+    SAAS: "false"
+    RAILS_ENV: production
+    APP_FQDN: *hostname
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Start small on a single box; increase these if memory allows.
+    WEB_CONCURRENCY: "2"
+    JOB_CONCURRENCY: "1"
+
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Uncomment these and set them in .kamal/secrets to enable browser push.
+    # - VAPID_PRIVATE_KEY
+    # - VAPID_PUBLIC_KEY
+
+# All four SQLite databases (including jobs) and uploaded files live here.
+# Keep this volume name unchanged across deployments.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
