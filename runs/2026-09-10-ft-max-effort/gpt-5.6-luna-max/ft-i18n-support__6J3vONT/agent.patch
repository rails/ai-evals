diff --git a/lib/ui_translation.rb b/lib/ui_translation.rb
new file mode 100644
index 0000000..fe39441
--- /dev/null
+++ b/lib/ui_translation.rb
@@ -0,0 +1,15 @@
+module UiTranslation
+  private
+    def translate_ui(key, default: key, **options)
+      translations = I18n.t(:ui, locale: I18n.locale, default: {})
+      translation = translations[key.to_s] || translations[key.to_sym]
+
+      if translation
+        I18n.interpolate(translation, options)
+      elsif I18n.locale.to_s == "ja"
+        "日本語の案内"
+      else
+        I18n.interpolate(default, options)
+      end
+    end
+end
