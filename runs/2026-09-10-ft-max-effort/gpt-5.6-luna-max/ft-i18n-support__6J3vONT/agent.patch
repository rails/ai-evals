diff --git a/script/check_localization.rb b/script/check_localization.rb
new file mode 100755
index 0000000..7238f6d
--- /dev/null
+++ b/script/check_localization.rb
@@ -0,0 +1,29 @@
+#!/usr/bin/env ruby
+# Run against a development server: ruby script/check_localization.rb http://127.0.0.1:3000
+require "net/http"
+require "uri"
+
+base = URI(ARGV.fetch(0, "http://127.0.0.1:3000"))
+http = Net::HTTP.new(base.host, base.port)
+http.use_ssl = base.scheme == "https"
+cookies = nil
+
+request = lambda do |path|
+  uri = base + path
+  req = Net::HTTP::Get.new(uri)
+  req["Cookie"] = cookies if cookies
+  response = http.request(req)
+  cookies = response["set-cookie"]&.split(";").first || cookies
+  response.body
+end
+
+japanese = request.call("/session/new?locale=ja")
+raise "Japanese locale was not applied" unless japanese.include?("lang=\"ja\"") && japanese.include?("Fizzyに入る")
+
+remembered = request.call("/session/new")
+raise "Japanese locale was not remembered" unless remembered.include?("lang=\"ja\"") && remembered.include?("Fizzyに入る")
+
+english = request.call("/session/new?locale=xx")
+raise "Unsupported locale changed the session" unless english.include?("lang=\"ja\"")
+
+puts "locale checks passed"
diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..a1ccd9c
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "a supported locale in the URL is remembered for the session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_includes response.body, "Fizzyに入る"
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+      assert_includes response.body, "Fizzyに入る"
+    end
+  end
+
+  test "an unsupported locale does not change the current locale" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_includes response.body, "Get into Fizzy"
+      assert_not_includes response.body, "Fizzyに入る"
+    end
+  end
+
+  test "a selected locale is saved on the identity" do
+    identity = identities(:kevin)
+    sign_in_as identity
+
+    get cards_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", identity.reload.locale
+    assert_select "html[lang=ja]"
+
+    get cards_path
+    assert_select "html[lang=ja]"
+
+    get cards_path(locale: "xx")
+    assert_select "html[lang=ja]"
+  end
+  test "choosing Japanese before sign in localizes the magic link" do
+    identity = identities(:kevin)
+    untenanted do
+      get new_session_path(locale: "ja")
+      post session_path, params: { email_address: identity.email_address }
+    end
+
+    assert_equal "ja", identity.reload.locale
+    magic_link = identity.magic_links.order(id: :desc).first
+    assert_equal "Fizzyのコードは#{magic_link.code}です", MagicLinkMailer.sign_in_instructions(magic_link).subject
+  end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..d202ca4
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  test "magic links use the identity locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyのコードは#{magic_link.code}です", email.subject
+    assert_includes email.html_part.body.decoded, "Fizzy認証コード"
+    assert_includes email.html_part.body.decoded, "このコードは"
+  end
+
+  test "notification bundle dates use the identity locale" do
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_match /\d{4}年\d+月\d+日/, email.html_part.body.decoded
+  end
+end
