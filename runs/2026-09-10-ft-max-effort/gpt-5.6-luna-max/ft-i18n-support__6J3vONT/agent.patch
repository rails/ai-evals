diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..6f250ba
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,70 @@
+module Localization
+  include UiTranslation
+
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[en ja].freeze
+
+  included do
+    prepend_before_action :capture_requested_locale
+    around_action :set_locale
+    helper_method :current_locale
+    helper_method :ui
+  end
+
+  private
+    def capture_requested_locale
+      session[:locale] = requested_locale if requested_locale
+    end
+
+    def set_locale(&action)
+      locale = locale_from_request
+      persist_requested_locale(locale) if requested_locale?(locale)
+
+      I18n.with_locale(locale, &action)
+    end
+
+    def locale_from_request
+      if requested_locale
+        requested_locale
+      elsif session_locale
+        session_locale
+      elsif identity_locale
+        identity_locale
+      else
+        I18n.default_locale.to_s
+      end
+    end
+
+    def persist_requested_locale(locale)
+      session[:locale] = locale
+      Current.identity.update!(locale: locale) if Current.identity && Current.identity.locale != locale
+    end
+
+    def requested_locale
+      locale = params[:locale].to_s.downcase
+      locale if SUPPORTED_LOCALES.include?(locale)
+    end
+
+    def requested_locale?(locale)
+      locale.present? && requested_locale == locale
+    end
+
+    def session_locale
+      locale = session[:locale].to_s
+      locale if SUPPORTED_LOCALES.include?(locale)
+    end
+
+    def identity_locale
+      locale = Current.identity&.locale.to_s
+      locale if SUPPORTED_LOCALES.include?(locale)
+    end
+
+    def current_locale
+      I18n.locale.to_s
+    end
+
+    def ui(key, default: key, **options)
+      translate_ui(key, default: default, **options)
+    end
+end
