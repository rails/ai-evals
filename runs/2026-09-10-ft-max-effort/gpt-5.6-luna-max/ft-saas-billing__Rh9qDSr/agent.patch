@@ -0,0 +1,42 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+    @overridden_limit = @account.overridden_limit || @account.build_overridden_limit
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    @account.override_limits!(overridden_limit_params)
+    redirect_to saas.admin_account_path(@account), notice: "Account limits overridden"
+  end
+
+  def reset
+    @account.reset_overridden_limits!
+    redirect_to saas.admin_account_path(@account), notice: "Account limit override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+
+    def overridden_limit_params
+      params.expect(account_overridden_limit: %i[ card_count bytes_used ])
+    end
+end
