@@ -0,0 +1,38 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    create_portal_session
+  end
+
+  def create
+    create_portal_session
+  end
+
+  private
+    def stripe_session_url(session)
+      if session.respond_to?(:url)
+        session.url
+      else
+        session[:url] || session['url']
+      end
+    end
+
+    def create_portal_session
+      customer = Current.account.subscription&.stripe_customer_id
+
+      if customer.blank?
+        redirect_to saas.account_subscription_path(plan: "unlimited", script_name: request.script_name)
+      else
+        Stripe.api_key = ENV.fetch("STRIPE_SECRET_KEY", "sk_test_fizzy")
+        session = Stripe::BillingPortal::Session.create(
+          customer: customer,
+          return_url: account_settings_url(script_name: request.script_name)
+        )
+        redirect_to stripe_session_url(session), allow_other_host: true
+      end
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, severity: :error)
+      redirect_to account_settings_path(script_name: request.script_name), alert: "We couldn't open the customer portal. Please try again."
+    end
+end
diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..6235c4f
--- /dev/null
+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,62 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    redirect_to_checkout
+  end
+
+  def create
+    redirect_to_checkout
+  end
+
+  private
+    def redirect_to_checkout
+      Stripe.api_key = ENV.fetch("STRIPE_SECRET_KEY", "sk_test_fizzy")
+
+      session = Stripe::Checkout::Session.create(checkout_session_params)
+      redirect_to stripe_session_url(session), allow_other_host: true
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, severity: :error)
+      redirect_to account_settings_path(script_name: request.script_name), alert: "We couldn't start checkout. Please try again."
+    end
+
+    def checkout_session_params
+      plan = Account::Plan.find(params[:plan].presence || "unlimited")
+      prices = [ { price: ENV.fetch("STRIPE_MONTHLY_V1_PRICE_ID", "price_unlimited"), quantity: 1 } ]
+      if plan.key == "unlimited_plus"
+        prices << { price: ENV.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID", "price_extra_storage"), quantity: 1 }
+      end
+
+      customer = Current.account.subscription&.stripe_customer_id
+      {
+        mode: "subscription",
+        line_items: prices,
+        success_url: account_settings_url(script_name: request.script_name),
+        cancel_url: account_settings_url(script_name: request.script_name),
+        client_reference_id: Current.account.id,
+        metadata: billing_metadata.merge(plan_key: plan.key),
+        subscription_data: { metadata: billing_metadata.merge(plan_key: plan.key) }
+      }.tap do |attributes|
+        if customer.present?
+          attributes[:customer] = customer
+        else
+          attributes[:customer_email] = Current.account.owner_email
+        end
+      end
+    end
+
+    def stripe_session_url(session)
+      if session.respond_to?(:url)
+        session.url
+      else
+        session[:url] || session['url']
+      end
+    end
+
+    def billing_metadata
+      {
+        account_id: Current.account.id,
+        external_account_id: Current.account.external_account_id.to_s
+      }
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
