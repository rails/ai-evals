diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..e3ebd45
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,173 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account, inverse_of: :subscription
+
+  scope :active, -> { where(status: %w[ active trialing ]) }
+
+  def active?
+    status.blank? || status.in?(%w[ active trialing ])
+  end
+
+  def plan
+    Account::Plan.find(plan_key)
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def update_from_stripe!(stripe_subscription, plan_key: nil)
+    self.plan_key = plan_key if plan_key.present?
+    self.status = stripe_value(stripe_subscription, :status) if stripe_value(stripe_subscription, :status).present?
+    self.current_period_end = stripe_time(stripe_value(stripe_subscription, :current_period_end))
+    self.cancel_at = stripe_time(stripe_value(stripe_subscription, :cancel_at))
+    self.next_amount_due_in_cents = stripe_value(stripe_subscription, :next_amount_due_in_cents)
+    save!
+  end
+
+  class << self
+    def process_webhook_event(event)
+      case stripe_value(event, :type).to_s
+      when "checkout.session.completed"
+        process_checkout_session(stripe_value(stripe_value(event, :data), :object))
+      when "customer.subscription.created", "customer.subscription.updated"
+        process_stripe_subscription(stripe_value(stripe_value(event, :data), :object))
+      when "customer.subscription.deleted"
+        process_stripe_subscription(stripe_value(stripe_value(event, :data), :object), deleted: true)
+      when "invoice.paid", "invoice.payment_succeeded", "invoice.payment_failed"
+        process_invoice(stripe_value(stripe_value(event, :data), :object))
+      end
+    end
+
+    private
+      def process_checkout_session(session)
+        return unless session
+
+        account = account_for(session)
+        return unless account
+
+        subscription_id = stripe_value(session, :subscription)
+        customer_id = stripe_value(session, :customer)
+        subscription = find_or_initialize_for(account, subscription_id, customer_id)
+        subscription.account = account
+        subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+        subscription.stripe_customer_id = customer_id if customer_id.present?
+        subscription.plan_key = plan_key_for(session, fallback: "unlimited")
+        subscription.status = "active" if subscription.status.blank?
+        subscription.save!
+      end
+
+      def process_stripe_subscription(stripe_subscription, deleted: false)
+        return unless stripe_subscription
+
+        subscription_id = stripe_value(stripe_subscription, :id)
+        customer_id = stripe_value(stripe_subscription, :customer)
+        subscription = find_by_stripe_ids(subscription_id, customer_id)
+        account = subscription&.account || account_for(stripe_subscription)
+        return unless account
+
+        subscription ||= find_or_initialize_for(account, subscription_id, customer_id)
+        subscription.account = account
+        subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+        subscription.stripe_customer_id = customer_id if customer_id.present?
+        subscription.plan_key = plan_key_for(stripe_subscription, fallback: subscription.plan_key.presence || "unlimited")
+        status = stripe_value(stripe_subscription, :status)
+        subscription.status = deleted ? "canceled" : status if deleted || status.present?
+        subscription.current_period_end = stripe_time(stripe_value(stripe_subscription, :current_period_end))
+        subscription.cancel_at = stripe_time(stripe_value(stripe_subscription, :cancel_at))
+        subscription.save!
+      end
+
+      def process_invoice(invoice)
+        return unless invoice
+
+        subscription_id = stripe_value(invoice, :subscription)
+        customer_id = stripe_value(invoice, :customer)
+        subscription = find_by_stripe_ids(subscription_id, customer_id)
+        return unless subscription
+
+        amount = stripe_value(invoice, :amount_due) || stripe_value(invoice, :amount_paid)
+        subscription.update!(
+          next_amount_due_in_cents: amount,
+          status: subscription.status.presence || "active"
+        )
+      end
+
+      def find_or_initialize_for(account, subscription_id, customer_id)
+        find_by_stripe_ids(subscription_id, customer_id) || account.subscription || account.build_subscription
+      end
+
+      def find_by_stripe_ids(subscription_id, customer_id)
+        record = find_by(stripe_subscription_id: subscription_id) if subscription_id.present?
+        record ||= find_by(stripe_customer_id: customer_id) if customer_id.present?
+        record
+      end
+
+      def account_for(object)
+        metadata = stripe_value(object, :metadata)
+        account_id = stripe_value(metadata, :account_id) || stripe_value(object, :client_reference_id)
+        external_account_id = stripe_value(metadata, :external_account_id)
+        customer_id = stripe_value(object, :customer)
+        subscription_id = stripe_value(object, :subscription) || stripe_value(object, :id)
+
+        account = Account.find_by(id: account_id) if account_id.present?
+        account ||= Account.find_by(external_account_id: external_account_id) if external_account_id.present?
+        account ||= find_by_stripe_ids(subscription_id, customer_id)&.account
+        account
+      end
+
+      def plan_key_for(object, fallback: "free")
+        metadata = stripe_value(object, :metadata)
+        metadata_plan = stripe_value(metadata, :plan_key) || stripe_value(metadata, :plan)
+        return Account::Plan.normalize_key(metadata_plan) if metadata_plan.present?
+
+        price_ids(object).each do |price_id|
+          return "unlimited_plus" if price_id == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+        end
+
+        price_ids(object).each do |price_id|
+          return "unlimited" if price_id == ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+        end
+
+        fallback
+      end
+
+      def price_ids(object)
+        items = stripe_value(object, :items)
+        data = stripe_value(items, :data) || []
+
+        Array(data).filter_map do |item|
+          price = stripe_value(item, :price) || stripe_value(item, :plan)
+          stripe_value(price, :id) || stripe_value(item, :price) || stripe_value(item, :plan)
+        end
+      end
+
+      def stripe_value(object, key)
+        if object.respond_to?(key)
+          object.public_send(key)
+        elsif object.respond_to?(:[])
+          object[key] || object[key.to_s]
+        end
+      end
+
+      def stripe_time(value)
+        if value.present?
+          value.is_a?(Time) ? value : Time.zone.at(value.to_i)
+        end
+      end
+  end
+
+  private
+    def stripe_value(object, key)
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[])
+        object[key] || object[key.to_s]
+      end
+    end
+
+    def stripe_time(value)
+      if value.present?
+        value.is_a?(Time) ? value : Time.zone.at(value.to_i)
+      end
+    end
+end
