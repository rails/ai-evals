diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..4669a17
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,122 @@
+class Account::Plan
+  attr_reader :key, :name, :card_limit, :storage_limit, :monthly_price, :queenbee_key
+
+  def initialize(key:, name:, card_limit:, storage_limit:, monthly_price:, queenbee_key:)
+    @key = key
+    @name = name
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @monthly_price = monthly_price
+    @queenbee_key = queenbee_key
+    freeze
+  end
+
+  FREE = new(
+    key: "free",
+    name: "Free",
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte,
+    monthly_price: 0,
+    queenbee_key: "FreeV1"
+  )
+
+  UNLIMITED = new(
+    key: "unlimited",
+    name: "Unlimited",
+    card_limit: nil,
+    storage_limit: 5.gigabytes,
+    monthly_price: 20,
+    queenbee_key: "UnlimitedV1"
+  )
+
+  UNLIMITED_PLUS = new(
+    key: "unlimited_plus",
+    name: "Unlimited+",
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    monthly_price: 25,
+    queenbee_key: "UnlimitedPlusV1"
+  )
+
+  COMPED = new(
+    key: "comped",
+    name: "Comped",
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    monthly_price: 0,
+    queenbee_key: "UnlimitedPlusV1"
+  )
+
+  PLANS = [ FREE, UNLIMITED, UNLIMITED_PLUS, COMPED ].freeze
+
+  class << self
+    def find(key)
+      PLANS.find { |plan| plan.key == normalize_key(key) } || FREE
+    end
+
+    alias_method :for, :find
+
+    def normalize_key(key)
+      value = key.to_s
+      aliases.fetch(value.downcase, value.downcase)
+    end
+
+    def paid_plans
+      [ UNLIMITED, UNLIMITED_PLUS ]
+    end
+
+    private
+      def aliases
+        @aliases ||= {
+          "" => "free",
+          "free" => "free",
+          "freev1" => "free",
+          "free_v1" => "free",
+          "unlimited" => "unlimited",
+          "unlimited_v1" => "unlimited",
+          "unlimitedv1" => "unlimited",
+          "monthlyv1" => "unlimited",
+          "monthly_v1" => "unlimited",
+          "unlimited_plus" => "unlimited_plus",
+          "unlimited_plus_v1" => "unlimited_plus",
+          "monthly_extra_storage_v1" => "unlimited_plus",
+          "unlimited+" => "unlimited_plus",
+          "unlimitedplus" => "unlimited_plus",
+          "unlimitedplusv1" => "unlimited_plus",
+          "comped" => "comped"
+        }
+      end
+  end
+
+  alias_method :price, :monthly_price
+
+  def proper_name
+    name
+  end
+
+  def frequency
+    "monthly"
+  end
+
+  def monthly_price_in_cents
+    monthly_price * 100
+  end
+
+  def paid?
+    monthly_price.positive?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def stripe_price_ids
+    ids = [ ENV["STRIPE_MONTHLY_V1_PRICE_ID"] ]
+    ids << ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] if key == "unlimited_plus"
+    ids.compact_blank
+  end
+
+  def to_s
+    name
+  end
+end
