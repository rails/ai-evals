@@ -0,0 +1,18 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.raw_post,
+      request.headers["Stripe-Signature"],
+      ENV.fetch("STRIPE_WEBHOOK_SECRET", "")
+    )
+
+    Account::Subscription.process_webhook_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError, Stripe::InvalidRequestError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..278c224
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,112 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy, inverse_of: :account
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy, inverse_of: :account
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy, inverse_of: :account
+  end
+
+  def billing_plan
+    if comped?
+      Account::Plan::COMPED
+    elsif active_subscription
+      active_subscription.plan
+    else
+      Account::Plan::FREE
+    end
+  end
+
+  # Queenbee's account contract calls this method `plan`; keep returning the
+  # versioned name while exposing the human-readable plan through plan_name.
+  def plan
+    billing_plan.queenbee_key
+  end
+
+  def plan_name
+    billing_plan.name
+  end
+
+  def paid?
+    billing_plan.paid? || comped?
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    waiver = billing_waiver
+    (waiver.present? && !waiver.destroyed?) || (persisted? && Account::BillingWaiver.exists?(account_id: id))
+  end
+
+  def comp!
+    Account::BillingWaiver.find_or_create_by!(account_id: id)
+    association(:billing_waiver).reset
+  end
+
+  def uncomp!
+    Account::BillingWaiver.where(account_id: id).destroy_all
+    association(:billing_waiver).reset
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_used
+    if overridden_limit&.card_count.nil?
+      cards_count
+    else
+      overridden_limit.card_count
+    end
+  end
+
+  def cards_left
+    if card_limit
+      [ card_limit - cards_used, 0 ].max
+    end
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_left <= 100
+  end
+
+  alias_method :card_count, :cards_used
+  alias_method :effective_card_count, :cards_used
+  alias_method :cards_remaining, :cards_left
+
+  def bytes_used
+    if overridden_limit&.bytes_used.nil?
+      super
+    else
+      overridden_limit.bytes_used
+    end
+  end
+
+  def storage_limit
+    storage_exception&.bytes_allowed || billing_plan.storage_limit
+  end
+
+  def override_limits!(attributes)
+    limit = Account::OverriddenLimit.find_or_initialize_by(account_id: id)
+    limit.assign_attributes(attributes)
+    limit.save!
+    association(:overridden_limit).target = limit
+    limit
+  end
+
+  def reset_overridden_limits!
+    Account::OverriddenLimit.where(account_id: id).destroy_all
+    association(:overridden_limit).reset
+  end
+
+  alias_method :comp, :comp!
+  alias_method :uncomp, :uncomp!
+  alias_method :override_limit!, :override_limits!
+  alias_method :reset_override!, :reset_overridden_limits!
+end
