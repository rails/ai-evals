@@ -0,0 +1,30 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+  before_action :set_export, only: :download
+  allow_unauthenticated_access only: :download
+
+  def create
+    export = Export.create!(account: Current.account, user: Current.user, kind: :account)
+    export.enqueue
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "We'll email you when your account export is ready." }
+      format.json { render json: { id: export.id, status: export.status }, status: :accepted }
+    end
+  end
+
+  def download
+    if @export.completed? && @export.file.attached? && @export.account == Current.account
+      redirect_to rails_blob_path(@export.file, disposition: :attachment)
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def set_export
+      @export = Export.find_signed!(params[:id], purpose: :download)
+    rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+      head :not_found
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
