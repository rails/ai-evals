index 0000000..5ceb2ec
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,65 @@
+class Account::DataTransfer::Importer
+  attr_reader :import, :context
+
+  def initialize(import)
+    @import = import
+    @context = Account::DataTransfer::ImportContext.new
+  end
+
+  def run
+    imported_account = nil
+
+    Account.transaction do
+      ZipFile.with_blob(import.file.blob) do |io|
+        reader = ZipFile::Reader.new(io)
+        imported_account = Account::DataTransfer::Manifest.new(import.account).import_into(reader, context: context)
+      end
+
+      ensure_importer_access(imported_account)
+      imported_account.update_columns(cards_count: imported_account.cards.count)
+    end
+
+    imported_account
+  rescue
+    cleanup_uploaded_blobs
+    raise
+  end
+
+  private
+    def ensure_importer_access(imported_account)
+      identity = import.identity
+      target_user = imported_account.users.find_by(identity: identity)
+
+      if target_user
+        target_user.update!(role: :owner, active: true, verified_at: target_user.verified_at || Time.current)
+      else
+        target_user = imported_account.users.create!(
+          name: import.user&.name.presence || identity.email_address,
+          identity: identity,
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+
+      imported_account.boards.find_each do |board|
+        board.accesses.create_or_find_by!(user: target_user) do |access|
+          access.involvement = :watching
+        end
+      end
+
+      unless imported_account.users.where(role: :system).exists?
+        imported_account.users.create!(name: "System", role: :system)
+      end
+    end
+
+    def cleanup_uploaded_blobs
+      context.created_blob_keys.each do |service, key|
+        begin
+          service.delete(key)
+        rescue ActiveStorage::FileNotFoundError
+        rescue => exception
+          Rails.error.report(exception, severity: :warning)
+        end
+      end
+    end
+end
