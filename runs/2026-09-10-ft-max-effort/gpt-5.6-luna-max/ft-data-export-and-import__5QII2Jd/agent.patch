@@ -0,0 +1,34 @@
+class Account::ImportsController < ApplicationController
+  def new
+    @import = Import.new
+  end
+
+  def create
+    uploaded_file = import_params[:file]
+    raise KeyError if uploaded_file.blank?
+
+    @import = Import.create!(
+      account: Current.account,
+      identity: Current.identity,
+      user: Current.user,
+      file: uploaded_file
+    )
+    @import.enqueue
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "We'll email you when your account import is ready." }
+      format.json { render json: { id: @import.id, status: @import.status }, status: :accepted }
+    end
+  rescue KeyError, ActionController::ParameterMissing
+    @import ||= Import.new
+    respond_to do |format|
+      format.html { render :new, status: :unprocessable_entity }
+      format.json { render json: { errors: [ "Choose a Fizzy account export file" ] }, status: :unprocessable_entity }
+    end
+  end
+
+  private
+    def import_params
+      params.expect(import: [ :file ])
+    end
+end
