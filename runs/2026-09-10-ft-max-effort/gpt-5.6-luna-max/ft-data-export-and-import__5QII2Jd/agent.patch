diff --git a/app/models/account/data_transfer/import_context.rb b/app/models/account/data_transfer/import_context.rb
new file mode 100644
index 0000000..38af19a
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,51 @@
+class Account::DataTransfer::ImportContext
+  attr_reader :account, :source_account_id, :ids, :blobs, :created_blob_keys
+
+  def initialize(account: nil, source_account_id: nil)
+    @account = account
+    @source_account_id = source_account_id
+
+    @ids = Hash.new { |mapping, model_name| mapping[model_name] = {} }
+    @blobs = {}
+    @created_blob_keys = []
+  end
+
+  def account=(account)
+    @account = account
+  end
+
+  def source_account_id=(source_account_id)
+    @source_account_id = source_account_id
+  end
+  def register(model_name, source_id, target_id = nil)
+    if source_id.present?
+      ids[model_name.to_s][source_id.to_s] ||= (target_id || new_id)
+    end
+  end
+
+  def mapped_id(model_name, source_id)
+    if source_id.present?
+      ids[model_name.to_s][source_id.to_s] || source_id
+    end
+  end
+
+  def register_blob(source_id, blob, source_key:)
+    register("ActiveStorage::Blob", source_id, blob.id)
+    blobs[source_id.to_s] = { blob: blob, source_key: source_key }
+  end
+
+  def blob_for(source_id)
+    blobs[source_id.to_s]
+  end
+
+  def each_blob
+    blobs.each_value do |blob|
+      yield blob
+    end
+  end
+
+  private
+    def new_id
+      ActiveRecord::Type::Uuid.generate
+    end
+end
