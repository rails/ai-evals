+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @account = export.account
+    @download_url = account_export_download_url(export.download_id, script_name: @account.slug)
+
+    mail(
+      to: export.user.identity.email_address,
+      subject: "Your Fizzy #{export.account? ? "account" : "card"} export is ready"
+    )
+  end
+
+  def export_failed(export)
+    @export = export
+    @account = export.account
+
+    mail(
+      to: export.user.identity.email_address,
+      subject: "Your Fizzy export could not be completed"
+    )
+  end
+
+  def import_completed(import, account)
+    @import = import
+    @account = account
+    @account_url = landing_url(script_name: account.slug)
+
+    mail(
+      to: import.identity.email_address,
+      subject: "Your Fizzy account import is complete"
+    )
+  end
+
+  def import_failed(import)
+    @import = import
+    @account = import.account
+
+    mail(
+      to: import.identity.email_address,
+      subject: "Your Fizzy account import could not be completed"
+    )
+  end
+end
