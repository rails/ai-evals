@@ -0,0 +1,71 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  RESOURCE_ASSOCIATIONS = {
+    "tags" => [ "filters_tags", "tag_id", "Tag" ],
+    "boards" => [ "boards_filters", "board_id", "Board" ],
+    "assignees" => [ "assignees_filters", "assignee_id", "User" ],
+    "creators" => [ "creators_filters", "creator_id", "User" ],
+    "closers" => [ "closers_filters", "closer_id", "User" ]
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: ::Filter)
+  end
+
+  def import_from(reader, context:)
+    entries = record_entries(reader)
+    rows = entries.map { |entry| reader.read_json(entry).stringify_keys }
+    super(reader, context: context)
+
+    rows.each do |row|
+      filter_id = context.mapped_id(model.name, row.fetch("id"))
+      resources = row.fetch("resources", {})
+
+      RESOURCE_ASSOCIATIONS.each do |name, (table, foreign_key, target_model)|
+        ids = Array(resources[name]).filter_map do |source_id|
+          context.mapped_id(target_model, source_id)
+        end
+
+        rows_for_join = ids.map do |target_id|
+          { "filter_id" => filter_id, foreign_key => target_id }
+        end
+        join_model = Class.new(ApplicationRecord) do
+          self.table_name = table
+        end
+        join_model.insert_all(rows_for_join) if rows_for_join.any?
+      end
+    end
+
+    rows.length
+  end
+
+  protected
+    def export_attributes(record)
+      super.merge(
+        "resources" => RESOURCE_ASSOCIATIONS.keys.index_with do |name|
+          record.public_send(name).ids
+        end
+      )
+    end
+
+    def import_attributes(record_attributes, context:)
+      super.tap do |attributes|
+        fields = record_attributes["fields"]
+        fields = JSON.parse(fields) if fields.is_a?(String)
+        fields = fields.to_h.deep_dup
+        {
+          "card_ids" => "Card",
+          "column_ids" => "Column",
+          "assignee_ids" => "User",
+          "creator_ids" => "User",
+          "closer_ids" => "User",
+          "board_ids" => "Board",
+          "tag_ids" => "Tag"
+        }.each do |field, target_model|
+          fields[field] = Array(fields[field]).filter_map { |source_id| context.mapped_id(target_model, source_id) } if fields.key?(field)
+        end
+
+        attributes["fields"] = fields
+        attributes["params_digest"] = Filter.digest_params(fields)
+      end
+    end
+end
