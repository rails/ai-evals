diff --git a/app/models/card/data_transfer/exporter.rb b/app/models/card/data_transfer/exporter.rb
new file mode 100644
index 0000000..5688f52
--- /dev/null
+++ b/app/models/card/data_transfer/exporter.rb
@@ -0,0 +1,121 @@
+class Card::DataTransfer::Exporter
+  attr_reader :user, :account
+
+  def initialize(user:, account:)
+    @user = user
+    @account = account
+  end
+
+  def export_to(zip)
+    cards = user.accessible_cards.where(account: account).distinct
+    zip.add_file("manifest.json", JSON.generate(
+      version: 1,
+      type: "cards",
+      user_id: user.id,
+      exported_at: Time.current.utc.iso8601
+    ))
+
+    cards.find_each do |card|
+      export_card(card, zip)
+    end
+  end
+
+  private
+    def export_card(card, zip)
+      attachments = attachments_for(card)
+      attachment_paths = attachments.each_with_object({}) do |attachment, paths|
+        paths[attachment.id.to_s] = attachment_path(card, attachment)
+      end
+
+      payload = {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        due_on: card.due_on,
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        last_active_at: card.last_active_at,
+        description: {
+          html: card.description.to_s,
+          plain_text: card.description.to_plain_text
+        },
+        board: record_attributes(card.board),
+        column: card.column && record_attributes(card.column),
+        creator: person_attributes(card.creator),
+        assignees: card.assignees.map { |assignee| person_attributes(assignee) },
+        tags: card.tags.order(:title).pluck(:title),
+        steps: card.steps.map { |step| step.attributes.slice("id", "content", "completed", "created_at", "updated_at") },
+        comments: card.comments.chronologically.includes(:creator).map { |comment| comment_attributes(comment, attachment_paths) },
+        attachments: attachments.map { |attachment| attachment_attributes(attachment, attachment_paths.fetch(attachment.id.to_s)) }
+      }
+
+      zip.add_file("cards/#{card.number}.json", JSON.generate(payload))
+      attachments.each do |attachment|
+        zip.add_file(attachment_paths.fetch(attachment.id.to_s), compress: false) do |sink|
+          attachment.blob.download do |chunk|
+            sink.write(chunk)
+          end
+        end
+      end
+    end
+
+    def comment_attributes(comment, attachment_paths)
+      rich_text = comment.body
+      attachments = attachments_for_record(rich_text)
+
+      {
+        id: comment.id,
+        created_at: comment.created_at,
+        updated_at: comment.updated_at,
+        creator: person_attributes(comment.creator),
+        body: {
+          html: rich_text.to_s,
+          plain_text: rich_text.to_plain_text
+        },
+        attachments: attachments.map { |attachment| attachment_attributes(attachment, attachment_paths.fetch(attachment.id.to_s)) }
+      }
+    end
+
+    def attachment_attributes(attachment, path)
+      {
+        id: attachment.id,
+        name: attachment.name,
+        record_type: attachment.record_type,
+        filename: attachment.blob.filename.to_s,
+        content_type: attachment.blob.content_type,
+        byte_size: attachment.blob.byte_size,
+        path: path
+      }
+    end
+
+    def attachments_for(card)
+      records = [ card, card.description, *card.comments.map(&:body) ]
+      records.flat_map { |record| attachments_for_record(record) }.uniq(&:id)
+    end
+
+    def attachments_for_record(record)
+      if record
+        ActiveStorage::Attachment.where(record_type: record.class.name, record_id: record.id).includes(:blob).to_a
+      else
+        []
+      end
+    end
+
+    def attachment_path(card, attachment)
+      filename = attachment.blob.filename.sanitized
+      "files/#{card.number}/#{attachment.id}-#{filename}"
+    end
+
+    def record_attributes(record)
+      record.attributes.slice("id", "name", "color", "position", "all_access")
+    end
+
+    def person_attributes(person)
+      {
+        id: person.id,
+        name: person.name,
+        email_address: person.identity&.email_address
+      }
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..41756ff
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,61 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %i[ account cards ], default: :account
+  enum :status, %i[ pending processing completed failed ], default: :pending
+
+  scope :recent, -> { order(created_at: :desc) }
+
+  def enqueue
+    ExportJob.perform_later(self)
+  end
+
+  def generate
+    processing!
+    file.purge if file.attached?
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account?
+        Account::DataTransfer::Manifest.new(account).export_to(zip)
+      else
+        Card::DataTransfer::Exporter.new(user: user, account: account).export_to(zip)
+      end
+    end
+
+    completed!
+    notify_ready
+  rescue => error
+    fail_with(error)
+    raise
+  end
+
+  def download_id
+    signed_id(purpose: :download, expires_in: 1.day)
+  end
+
+  def filename
+    prefix = (account.name.to_s.parameterize.presence || "fizzy").truncate(220, omission: "")
+    suffix = account? ? "account" : "cards"
+    "#{prefix}-#{suffix}-export.zip"
+  end
+
+  def failure_reason
+    error
+  end
+
+  private
+    def notify_ready
+      DataTransferMailer.export_ready(self).deliver_later
+    rescue => exception
+      Rails.error.report(exception, severity: :warning)
+    end
+
+    def fail_with(exception)
+      file.purge if file.attached?
+      update_columns(status: self.class.statuses.fetch("failed"), error: "#{exception.class}: #{exception.message}", updated_at: Time.current)
+      DataTransferMailer.export_failed(self).deliver_later
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..ee232e6
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,69 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  belongs_to :user, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %i[ pending processing completed failed ], default: :pending
+
+  def enqueue
+    ImportJob.perform_later(self)
+  end
+
+  def process
+    processing!
+    imported_account = Account::DataTransfer::Importer.new(self).run
+    reconcile_storage(imported_account)
+    enqueue_reindex(imported_account)
+    purge_input_file
+    completed!
+    notify_completed(imported_account)
+    imported_account
+  rescue => exception
+    fail_with(exception)
+    nil
+  end
+
+  def failure_reason
+    error
+  end
+
+  private
+    def reconcile_storage(imported_account)
+      Current.with_account(imported_account) { imported_account.reconcile_storage }
+    rescue => exception
+      Rails.error.report(exception, severity: :warning)
+    end
+
+
+    def enqueue_reindex(imported_account)
+      Current.with_account(imported_account) do
+        Account::DataTransfer::ReindexJob.perform_later(imported_account)
+      end
+    rescue => exception
+      Rails.error.report(exception, severity: :warning)
+    end
+
+    def purge_input_file
+      file.purge if file.attached?
+    rescue => exception
+      Rails.error.report(exception, severity: :warning)
+    end
+
+    def notify_completed(imported_account)
+      DataTransferMailer.import_completed(self, imported_account).deliver_later
+    rescue => exception
+      Rails.error.report(exception, severity: :warning)
+    end
+
+    def fail_with(exception)
+      update_columns(status: self.class.statuses.fetch("failed"), error: "#{exception.class}: #{exception.message}", updated_at: Time.current)
+      purge_input_file
+      begin
+        DataTransferMailer.import_failed(self).deliver_later
+      rescue => mail_error
+        Rails.error.report(mail_error, severity: :warning)
+      end
+    end
+end
