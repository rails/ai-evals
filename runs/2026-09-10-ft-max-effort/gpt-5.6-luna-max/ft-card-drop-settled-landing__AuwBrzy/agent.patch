diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..daa3c40
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,331 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+
+  #draggedItem
+  #hoverContainer
+  #pendingMoves = new WeakMap()
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  start(event) {
+    const item = this.#itemFor(event.target)
+
+    if (!item || this.#pendingMoves.has(item)) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedItem = item
+    event.dataTransfer?.setData("text/plain", item.id)
+    if (event.dataTransfer) event.dataTransfer.effectAllowed = "move"
+
+    item.classList.add(DRAGGED_ITEM_CLASS)
+  }
+
+  enter(event) {
+    this.#updateHoverContainer(event)
+  }
+
+  over(event) {
+    const container = this.#updateHoverContainer(event)
+
+    if (!container) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+  }
+
+  leave(event) {
+    const container = this.#containerFor(event.target)
+
+    if (!container || (event.relatedTarget && container.contains(event.relatedTarget))) return
+
+    if (container === this.#hoverContainer) {
+      this.#clearHoverContainer()
+    }
+  }
+
+  drop(event) {
+    const container = this.#containerFor(event.target)
+    const item = this.#draggedItem || this.#itemFromDataTransfer(event)
+
+    event.preventDefault()
+    this.#clearHoverContainer()
+
+    if (!item || !container || !this.#canDrop(item, container)) return
+
+    const move = this.#move(item, container)
+    if (move) this.#persist(item, container, move)
+  }
+
+  finish() {
+    this.#draggedItem?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#draggedItem = null
+    this.#clearHoverContainer()
+  }
+
+  // Private
+
+  #updateHoverContainer(event) {
+    const container = this.#containerFor(event.target)
+
+    if (!container || !this.#draggedItem || !this.#canDrop(this.#draggedItem, container)) {
+      this.#clearHoverContainer()
+      return null
+    }
+
+    if (this.#hoverContainer !== container) {
+      this.#clearHoverContainer()
+      this.#hoverContainer = container
+      container.classList.add(HOVER_CONTAINER_CLASS)
+    }
+
+    return container
+  }
+
+  #clearHoverContainer() {
+    this.#hoverContainer?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.#hoverContainer = null
+  }
+
+  #itemFor(element) {
+    const item = element?.closest?.('[data-drag-and-drop-target~="item"]')
+    return item && this.element.contains(item) ? item : null
+  }
+
+  #itemFromDataTransfer(event) {
+    const id = event.dataTransfer?.getData("text/plain")
+    return id ? this.#itemFor(document.getElementById(id)) : null
+  }
+
+  #containerFor(element) {
+    const container = element?.closest?.('[data-drag-and-drop-target~="container"]')
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #canDrop(item, container) {
+    if (!this.#itemFor(item) || !this.containerTargets.includes(container)) return false
+    if (this.#containerFor(item) === container) return false
+
+    return !!this.#requestFor(item, container, { preview: true })
+  }
+
+  #move(item, container) {
+    const list = container.querySelector(".cards__list")
+    const parent = item.parentNode
+
+    if (!list || !parent) return null
+
+    const move = {
+      item,
+      parent,
+      nextSibling: item.nextSibling,
+      sourceList: item.closest(".cards__list"),
+      destinationList: list,
+      cardState: this.#captureCardState(item)
+    }
+
+    // Cards are sorted by activity on the server. A move creates activity, so putting the
+    // card first keeps the optimistic board in the same order that the next refresh would use.
+    list.prepend(item)
+    this.#syncEmptyPlaceholder(move.sourceList)
+    this.#syncEmptyPlaceholder(move.destinationList)
+    this.#updateCard(item, container)
+    this.#pendingMoves.set(item, move)
+
+    return move
+  }
+
+  #persist(item, container, move) {
+    const request = this.#requestFor(item, container)
+
+    if (!request) {
+      this.#pendingMoves.delete(item)
+      this.#rollback(move)
+      return
+    }
+
+    request.then(response => {
+      if (this.#pendingMoves.get(item) !== move) return
+
+      this.#pendingMoves.delete(item)
+      if (!response.ok) this.#rollback(move)
+    }).catch(() => {
+      if (this.#pendingMoves.get(item) === move) {
+        this.#pendingMoves.delete(item)
+        this.#rollback(move)
+      }
+    })
+  }
+
+  #rollback(move) {
+    if (!move.item.isConnected || !move.parent.isConnected) return
+
+    if (move.nextSibling?.parentNode === move.parent) {
+      move.parent.insertBefore(move.item, move.nextSibling)
+    } else {
+      move.parent.append(move.item)
+    }
+
+    this.#syncEmptyPlaceholder(move.sourceList)
+    this.#syncEmptyPlaceholder(move.destinationList)
+    this.#restoreCardState(move.item, move.cardState)
+  }
+
+  #syncEmptyPlaceholder(list) {
+    if (!list) return
+
+    const placeholders = [ ...list.querySelectorAll(".blank-slate") ]
+    const hasCards = list.querySelector(".card")
+    const hasMoreCards = list.querySelector(".pagination-link")
+
+    if (hasCards || hasMoreCards) {
+      placeholders.forEach(placeholder => placeholder.remove())
+    } else if (placeholders.length === 0) {
+      const defaultPlaceholder = document.createElement("div")
+      defaultPlaceholder.className = "blank-slate blank-slate--default"
+      defaultPlaceholder.textContent = "No cards here"
+
+      const dragPlaceholder = document.createElement("div")
+      dragPlaceholder.className = "blank-slate blank-slate--drag overflow-ellipsis"
+      dragPlaceholder.textContent = "Drag cards here"
+
+      list.append(defaultPlaceholder, dragPlaceholder)
+    }
+  }
+
+  #captureCardState(item) {
+    return {
+      className: item.className,
+      style: item.getAttribute("style"),
+      headerColumn: this.#headerColumn(item)?.cloneNode(true),
+      stages: this.#stageColumns(item).map(stage => ({ stage, className: stage.className })),
+      closedStamps: this.#closedStamps(item).map(stamp => ({
+        stamp: stamp.cloneNode(true),
+        parent: stamp.parentNode,
+        nextSibling: stamp.nextSibling
+      }))
+    }
+  }
+
+  #restoreCardState(item, state) {
+    if (!state) return
+
+    item.className = state.className
+    if (state.style === null) {
+      item.removeAttribute("style")
+    } else {
+      item.setAttribute("style", state.style)
+    }
+
+    this.#headerColumns(item).forEach(column => column.remove())
+    if (state.headerColumn) item.querySelector(".card__header")?.append(state.headerColumn)
+
+    state.stages.forEach(({ stage, className }) => {
+      if (stage.isConnected) stage.className = className
+    })
+
+    this.#closedStamps(item).forEach(stamp => stamp.remove())
+    state.closedStamps.forEach(({ stamp, parent, nextSibling }) => {
+      if (!parent?.isConnected) return
+      if (nextSibling?.parentNode === parent) {
+        parent.insertBefore(stamp, nextSibling)
+      } else {
+        parent.append(stamp)
+      }
+    })
+  }
+
+  #updateCard(item, container) {
+    const status = container.dataset.dragAndDropStatus
+    const columnName = container.dataset.dragAndDropColumnName
+    const columnColor = container.dataset.dragAndDropColumnColor
+    const columnId = container.dataset.dragAndDropColumnId
+
+    if (status !== "closed" && columnColor) item.style.setProperty("--card-color", columnColor)
+
+    if (status === "column" && columnName) {
+      const header = item.querySelector(".card__header")
+      const currentColumn = this.#headerColumn(item) || this.#newHeaderColumn()
+      const label = currentColumn.querySelector(".overflow-ellipsis") || currentColumn
+
+      label.textContent = columnName
+      if (!currentColumn.isConnected) header?.append(currentColumn)
+
+      this.#stageColumns(item).forEach(stage => {
+        const isCurrentColumn = columnId ? stage.dataset.dragAndDropColumnId === columnId : stage.textContent.trim() === columnName
+        stage.classList.toggle("card__column-name--current", isCurrentColumn)
+      })
+    } else {
+      this.#headerColumns(item).forEach(column => column.remove())
+      if (status !== "closed") {
+        this.#stageColumns(item).forEach(stage => stage.classList.remove("card__column-name--current"))
+      }
+    }
+
+    item.classList.toggle("card--active", status === "column" || status === "maybe")
+    item.classList.toggle("card--postponed", status === "not-now")
+    this.#closedStamps(item).forEach(stamp => stamp.remove())
+  }
+
+  #newHeaderColumn() {
+    const column = document.createElement("span")
+    column.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+    column.innerHTML = '<span class="overflow-ellipsis"></span>'
+    return column
+  }
+
+  #headerColumn(item) {
+    return this.#headerColumns(item)[0]
+  }
+
+  #headerColumns(item) {
+    const header = item.querySelector(".card__header")
+    return header ? [ ...header.children ].filter(child => child.classList.contains("card__column-name--current")) : []
+  }
+
+  #stageColumns(item) {
+    return [ ...item.querySelectorAll(".card__stages .card__column-name") ]
+  }
+
+  #closedStamps(item) {
+    return [ ...item.querySelectorAll(".card__closed") ]
+  }
+
+  #requestFor(item, container, { preview = false } = {}) {
+    const status = container.dataset.dragAndDropStatus
+    const options = { responseKind: "json" }
+    const urls = item.dataset
+
+    switch (status) {
+      case "column": {
+        const url = urls.dragAndDropTriageUrl
+        const columnId = container.dataset.dragAndDropColumnId
+        if (!url || !columnId) return null
+
+        const triageUrl = new URL(url, document.baseURI)
+        triageUrl.searchParams.set("column_id", columnId)
+        return preview ? triageUrl : post(triageUrl.toString(), options)
+      }
+      case "maybe":
+        if (!urls.dragAndDropTriageUrl) return null
+        return preview ? urls.dragAndDropTriageUrl : destroy(urls.dragAndDropTriageUrl, options)
+      case "not-now":
+        if (!urls.dragAndDropNotNowUrl) return null
+        return preview ? urls.dragAndDropNotNowUrl : post(urls.dragAndDropNotNowUrl, options)
+      case "closed":
+        if (!urls.dragAndDropClosureUrl) return null
+        return preview ? urls.dragAndDropClosureUrl : post(urls.dragAndDropClosureUrl, options)
+      default:
+        return null
+    }
+  }
+}
