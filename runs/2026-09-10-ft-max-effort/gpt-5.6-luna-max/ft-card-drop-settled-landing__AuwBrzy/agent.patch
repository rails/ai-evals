diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..3da5e4f
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,99 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "board exposes cards and columns as drag and drop elements" do
+    visit board_url(boards(:writebook))
+
+    assert_selector ".card-columns[data-controller~='drag-and-drop']"
+    assert_selector "article.card[data-drag-and-drop-target='item'][draggable='true']"
+    assert_selector "##{dom_id(columns(:writebook_in_progress))}[data-drag-and-drop-target='container']"
+  end
+end
+
+class CardDragAndDropInteractionTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "drops a card into another column immediately" do
+    card = cards(:logo)
+    destination = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+
+    drag_state = page.execute_script(<<~JS, dom_id(card, :article), dom_id(destination))
+      const card = document.getElementById(arguments[0])
+      const destination = document.getElementById(arguments[1])
+      const dataTransfer = new DataTransfer()
+      const dispatch = (element, name) => element.dispatchEvent(new DragEvent(name, { bubbles: true, cancelable: true, dataTransfer }))
+
+      dispatch(card, "dragstart")
+      dispatch(destination, "dragover")
+      const dragState = { cardClasses: card.className, destinationClasses: destination.className }
+      dispatch(destination, "drop")
+      dispatch(card, "dragend")
+      return dragState
+    JS
+
+    assert_includes drag_state["cardClasses"], "drag-and-drop__dragged-item"
+    assert_includes drag_state["destinationClasses"], "drag-and-drop__hover-container"
+    assert_selector "##{dom_id(destination)} ##{dom_id(card, :article)}", visible: :all
+    sleep 0.5
+    assert_selector "##{dom_id(card, :article)} .card__header > .card__column-name--current", text: destination.name, visible: :all
+    assert_equal destination.id, card.reload.column_id
+    assert_no_selector "##{dom_id(columns(:writebook_triage))} ##{dom_id(card, :article)}"
+  end
+end
+
+class CardDragAndDropStatusTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "drops cards into the board statuses" do
+    card = cards(:logo)
+
+    visit board_url(boards(:writebook))
+
+    drag(card, "maybe")
+    wait_until { card.reload.column_id.nil? }
+
+    drag(card, "not-now")
+    wait_until { card.reload.postponed? }
+
+    drag(card, "closed-cards")
+    wait_until { card.reload.closed? }
+  end
+
+  private
+    def drag(card, container_id)
+      page.execute_script(<<~JS, dom_id(card, :article), container_id)
+        const card = document.getElementById(arguments[0])
+        const destination = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+        const dispatch = (element, name) => element.dispatchEvent(new DragEvent(name, { bubbles: true, cancelable: true, dataTransfer }))
+
+        dispatch(card, "dragstart")
+        dispatch(destination, "dragover")
+        dispatch(destination, "drop")
+        dispatch(card, "dragend")
+      JS
+    end
+
+    def wait_until(timeout: 5)
+      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
+      sleep 0.05 until yield || Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
+      assert yield, "condition was not met within #{timeout} seconds"
+    end
+end
