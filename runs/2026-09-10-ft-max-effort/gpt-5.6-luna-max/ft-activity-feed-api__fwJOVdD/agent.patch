@@ -1,4 +1,19 @@
 class Event < ApplicationRecord
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
   include Notifiable, Particulars, Promptable
 
   belongs_to :account, default: -> { board.account }
@@ -37,7 +52,28 @@ class Event < ApplicationRecord
     Event::Description.new(self, user)
   end
 
+  def activity_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids).compact }
+    when "card_board_changed"
+      { old_board: activity_particular("old_board"), new_board: activity_particular("new_board") }
+    when "card_title_changed"
+      { old_title: activity_particular("old_title"), new_title: activity_particular("new_title") }
+    when "card_triaged"
+      { column: activity_particular("column") }
+    else
+      {}
+    end
+  end
+
   private
+    def activity_particular(name)
+      values = particulars.to_h
+      values = values["particulars"] || values[:particulars] || values
+      values[name] || values[name.to_sym] || ""
+    end
+
     def dispatch_webhooks
       Event::WebhookDispatchJob.perform_later(self)
     end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..98c1509
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,24 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action, :eventable_type)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.particulars event.activity_particulars
+
+  if event.eventable_type == "Comment"
+    json.url card_url(event.eventable.card, anchor: dom_id(event.eventable))
+  else
+    json.url card_url(event.eventable)
+  end
+
+  json.eventable do
+    case event.eventable
+    when Card
+      json.partial! "cards/card", card: event.eventable
+    when Comment
+      json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
