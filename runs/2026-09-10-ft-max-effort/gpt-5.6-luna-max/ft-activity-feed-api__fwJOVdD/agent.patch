diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..132bbf3
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,28 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activity_events
+  end
+
+  private
+    def activity_events
+      events = Current.user.accessible_events
+        .where(account_id: Current.account.id, action: Event::ACTIVITY_ACTIONS)
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+
+      events.preloaded.order(created_at: :desc, id: :desc)
+    end
+
+    def creator_ids
+      ids_param(:creator_ids)
+    end
+
+    def board_ids
+      ids_param(:board_ids)
+    end
+
+    def ids_param(name)
+      Array(params[name]).flat_map { |value| value.to_s.split(",") }.compact_blank
+    end
+end
