diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..b0cf638
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activity newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert activities.any?
+    assert_equal activities.sort_by { |activity| [ activity["created_at"], activity["id"] ] }.reverse, activities
+
+    activity = activities.find { |entry| entry["id"] == events(:layout_commented).id }
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal events(:layout_commented).description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_url(cards(:layout)), activity["url"].split("#").first
+    assert_equal dom_id(comments(:layout_overflowing_david)), activity["url"].split("#").last
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+    assert_equal events(:layout_commented).board.id, activity.dig("board", "id")
+    assert_equal events(:layout_commented).creator.id, activity.dig("creator", "id")
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index includes title changes and omits collection changes" do
+    title_event = Event.create!(
+      account: accounts("37s"),
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: { old_title: "", new_title: "New title" }
+    )
+    collection_event = Event.create!(
+      account: accounts("37s"),
+      board: boards(:writebook),
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_collection_changed"
+    )
+
+    get activities_path, as: :json
+
+    ids = @response.parsed_body.map { |activity| activity["id"] }
+    assert_includes ids, title_event.id
+    assert_not_includes ids, collection_event.id
+  end
+
+  test "index exposes event-specific particulars and empty missing values" do
+    board_event = Event.create!(
+      account: accounts("37s"), board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo),
+      action: "card_board_changed", particulars: { old_board: "Old board" }
+    )
+    title_event = Event.create!(
+      account: accounts("37s"), board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo),
+      action: "card_title_changed", particulars: { new_title: "New title" }
+    )
+    triage_event = Event.create!(
+      account: accounts("37s"), board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo),
+      action: "card_triaged", particulars: {}
+    )
+
+    get activities_path, as: :json
+
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "old_board" => "Old board", "new_board" => "" }, activities[board_event.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "New title" }, activities[title_event.id]["particulars"])
+    assert_equal({ "column" => "" }, activities[triage_event.id]["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activities[events(:logo_assignment_jz).id]["particulars"])
+  end
+
+  test "index filters by creator and board" do
+    get activities_path(creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ]), as: :json
+
+    activities = @response.parsed_body
+    assert activities.any?
+    assert activities.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+    assert activities.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index only returns activity on accessible boards" do
+    private_event = Event.create!(
+      account: accounts("37s"), board: boards(:private), creator: users(:kevin), eventable: cards(:logo), action: "card_published"
+    )
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |activity| activity["id"] }, private_event.id
+  end
+
+  test "index paginates activity" do
+    20.times do |index|
+      Event.create!(
+        account: accounts("37s"), board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo),
+        action: "card_closed", created_at: index.minutes.from_now
+      )
+    end
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal Event.where(account: accounts("37s"), action: Event::ACTIVITY_ACTIONS).count.to_s, @response.headers["X-Total-Count"]
+    assert_match(/rel="next"/, @response.headers["Link"])
+
+    next_page = URI.parse(@response.headers["Link"].match(/<([^>]+)>/)[1]).request_uri
+    first_page_ids = @response.parsed_body.map { |activity| activity["id"] }
+    get next_page, as: :json
+
+    assert_response :success
+    assert_empty first_page_ids & @response.parsed_body.map { |activity| activity["id"] }
+  end
+end
