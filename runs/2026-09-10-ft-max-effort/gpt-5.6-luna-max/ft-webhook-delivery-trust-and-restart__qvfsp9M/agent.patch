+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    board.webhooks.active.find_each do |webhook|
+      if webhook.subscribed_to?(action)
+        delivery = webhook.deliveries.create_or_find_by!(event: self)
+        delivery.deliver_later if delivery.pending?
+      end
+    end
+  end
+end
