diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..debdeba
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,32 @@
+# Activities
+
+Activities describe changes and comments shown in the account activity timeline.
+Only activity from boards the current user can access is returned.
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat, newest-first list of activity. The endpoint accepts the following optional filters:
+
+- `creator_ids[]` — return activity created by the specified users
+- `board_ids[]` — return activity from the specified boards
+
+Each activity includes `id`, `action`, `created_at`, `description`, `particulars`, `url`,
+`eventable_type`, `eventable`, `board`, and `creator`. The `eventable`, `board`, and `creator`
+objects use the same representations as their corresponding API endpoints. Descriptions are
+plain text. Card activity links to the card; comment activity links to the card and anchors to
+the comment.
+
+`particulars` contains action-specific data:
+
+- assignment changes include `assignee_ids`
+- board changes include `old_board` and `new_board`
+- title changes include `old_title` and `new_title`
+- triage changes include `column`
+
+For other activity, `particulars` is an empty object. Missing board, title, or column values are
+returned as empty strings. Deprecated `card_collection_changed` activity is not returned;
+`card_title_changed` activity is included.
+
+Responses use the standard API pagination headers. If more activity is available, the response
+includes a `Link` header with a `rel="next"` URL and `X-Total-Count` contains the total number
+of matching activity records.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..d798f3c
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activity newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+
+    activities = @response.parsed_body
+    expected = users(:kevin).accessible_events.activities.reverse_chronologically
+
+    assert_equal expected.count, activities.count
+    assert_equal expected.pluck(:id), activities.pluck("id")
+    assert_equal expected.pluck(:action).uniq.sort, activities.pluck("action").uniq.sort
+    assert_equal expected.count.to_s, response.headers["X-Total-Count"]
+
+    activity = activities.find { |record| record["id"] == events(:layout_commented).id }
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], activity.keys.sort
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal events(:layout_commented).description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_url(comments(:layout_overflowing_david).card, anchor: dom_id(comments(:layout_overflowing_david))), activity["url"]
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "card activity URL opens the card" do
+    activity = events(:logo_assignment_jz)
+
+    get activities_path, as: :json
+
+    record = @response.parsed_body.find { |item| item["id"] == activity.id }
+    assert_equal card_url(activity.eventable), record["url"]
+    assert_equal "Card", record["eventable_type"]
+    assert_equal activity.eventable.id, record.dig("eventable", "id")
+  end
+
+  test "comment activity URL points to the card and comment" do
+    activity = events(:layout_commented)
+
+    get activities_path, as: :json
+
+    record = @response.parsed_body.find { |item| item["id"] == activity.id }
+    assert_equal card_url(activity.eventable.card, anchor: dom_id(activity.eventable)), record["url"]
+    assert_equal "Comment", record["eventable_type"]
+    assert_equal activity.eventable.id, record.dig("eventable", "id")
+  end
+
+  test "filters by creators and boards" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.present?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "does not include deprecated collection changes or omit title changes" do
+    title_change = events(:logo_published)
+    title_change.update!(action: "card_title_changed", particulars: { particulars: { old_title: "Old title", new_title: "New title" } })
+    collection_change = events(:layout_published)
+    collection_change.update!(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, title_change.id
+    assert_not_includes ids, collection_change.id
+  end
+
+  test "serializes event particulars" do
+    assignment = events(:logo_assignment_jz)
+    board_change = events(:logo_published)
+    board_change.update!(action: "card_board_changed", particulars: { particulars: { old_board: "Old", new_board: "New" } })
+    title_change = events(:layout_published)
+    title_change.update!(action: "card_title_changed", particulars: { particulars: { old_title: "Old", new_title: "New" } })
+    triage = events(:shipping_published)
+    triage.update!(action: "card_triaged", particulars: { particulars: { column: "Review" } })
+
+    get activities_path, as: :json
+    records = @response.parsed_body.index_by { |activity| activity["id"] }
+
+    assert_equal [ users(:jz).id ], records.fetch(assignment.id).dig("particulars", "assignee_ids")
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, records.fetch(board_change.id)["particulars"])
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, records.fetch(title_change.id)["particulars"])
+    assert_equal({ "column" => "Review" }, records.fetch(triage.id)["particulars"])
+    assert_equal({}, records.fetch(events(:shipping_closed).id)["particulars"])
+  end
+
+  test "missing board, title, and column values are empty strings" do
+    board_change = events(:logo_published)
+    board_change.update!(action: "card_board_changed", particulars: {})
+    title_change = events(:layout_published)
+    title_change.update!(action: "card_title_changed", particulars: {})
+    triage = events(:shipping_published)
+    triage.update!(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+    records = @response.parsed_body.index_by { |activity| activity["id"] }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, records.fetch(board_change.id)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, records.fetch(title_change.id)["particulars"])
+    assert_equal({ "column" => "" }, records.fetch(triage.id)["particulars"])
+    assert_equal({ "column" => "" }, records.fetch(events(:buy_domain_sent_back_to_triage).id)["particulars"])
+  end
+
+  test "paginates activity using the API pagination conventions" do
+    card = cards(:logo)
+    board = boards(:writebook)
+    creator = users(:kevin)
+    now = Time.current
+
+    Event.insert_all! 16.times.map { |index|
+      timestamp = now + index.minutes
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: board.account_id,
+        action: "card_published",
+        board_id: board.id,
+        creator_id: creator.id,
+        eventable_id: card.id,
+        eventable_type: "Card",
+        particulars: {},
+        created_at: timestamp,
+        updated_at: timestamp
+      }
+    }
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_equal users(:kevin).accessible_events.activities.count.to_s, response.headers["X-Total-Count"]
+    assert_match(/page=2.*rel=\"next\"/, response.headers["Link"])
+
+    get activities_path(format: :json, page: 2)
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.activities.count - 15, @response.parsed_body.size
+    assert_nil response.headers["Link"]
+  end
+
+  test "only returns activity from boards the current user can access" do
+    inaccessible_board = boards(:private)
+    inaccessible_event = Event.create!(account: inaccessible_board.account, action: "card_published", board: inaccessible_board, creator: users(:kevin), eventable: cards(:logo))
+
+    accesses(:private_kevin).destroy!
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.pluck("id"), inaccessible_event.id
+  end
+end
