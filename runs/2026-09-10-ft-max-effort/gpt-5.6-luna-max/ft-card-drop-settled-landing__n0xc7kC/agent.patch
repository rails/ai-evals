+require "test_helper"
+
+class BoardDragAndDropViewTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "board exposes drag and drop targets" do
+    get board_path(boards(:writebook))
+
+    assert_response :success
+    assert_select ".card-columns[data-controller~=?]", "drag-and-drop"
+    assert_select ".cards[data-drag-and-drop-target~=?][data-drag-and-drop-column-id=?]", "container", columns(:writebook_in_progress).id
+    assert_select ".cards[data-drag-and-drop-target~=?][data-drag-and-drop-status=?]", "container", "maybe"
+    assert_select ".card[draggable=?][data-drag-and-drop-target~=?][data-drag-and-drop-url]", "true", "item", minimum: 1
+  end
+end
diff --git a/test/controllers/cards/columns_controller_test.rb b/test/controllers/cards/columns_controller_test.rb
new file mode 100644
index 0000000..1d602ee
--- /dev/null
+++ b/test/controllers/cards/columns_controller_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Cards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "update moves a card to a column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    patch card_column_path(card), params: { column_id: column.id }, as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+
+  test "update moves a card to Maybe" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { status: "maybe" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.awaiting_triage?
+  end
+
+  test "update moves a card to Not Now" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { status: "not_now" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.postponed?
+  end
+
+  test "update moves a card to Done" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { status: "closed" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.closed?
+  end
+
+  test "a column from another board cannot be used" do
+    card = cards(:logo)
+    column = Column.create!(board: boards(:private), name: "Other", color: "#000000")
+
+    patch card_column_path(card), params: { column_id: column.id }, as: :json
+
+    assert_response :not_found
+  end
+end
diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..13b1674
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,60 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @destination = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card moves it to another column immediately and saves it" do
+    visit board_url(@card.board)
+
+    source_selector = "##{dom_id(@card, :article)}"
+    destination_selector = "[data-drag-and-drop-column-id='#{@destination.id}']"
+    assert_selector source_selector, visible: :all
+    assert_selector "#{destination_selector} .cards__list", visible: :all
+    source = find(source_selector, visible: :all, match: :first)
+    card_id = source[:id]
+
+    page.execute_script(<<~JAVASCRIPT, source_selector, destination_selector)
+      const source = document.querySelector(arguments[0])
+      const destination = document.querySelector(arguments[1])
+      const dataTransfer = new DataTransfer()
+      const dispatch = (element, type) => element.dispatchEvent(new DragEvent(type, {
+        bubbles: true,
+        cancelable: true,
+        dataTransfer
+      }))
+
+      dispatch(source, "dragstart")
+      dispatch(destination, "dragover")
+    JAVASCRIPT
+
+    assert_selector "#{destination_selector}.drag-and-drop__hover-container", visible: :all
+    assert_selector "##{card_id}.drag-and-drop__dragged-item", visible: :all
+
+    page.execute_script(<<~JAVASCRIPT, destination_selector, source_selector)
+      const destination = document.querySelector(arguments[0])
+      const source = document.querySelector(arguments[1])
+      const dataTransfer = new DataTransfer()
+      const dispatch = (element, type) => element.dispatchEvent(new DragEvent(type, {
+        bubbles: true,
+        cancelable: true,
+        dataTransfer
+      }))
+
+      dispatch(destination, "drop")
+      dispatch(source, "dragend")
+    JAVASCRIPT
+
+    assert_selector "##{card_id}", visible: :all
+    assert_selector "#{destination_selector} ##{card_id}", visible: :all
+
+    Timeout.timeout(5) do
+      sleep 0.05 until @card.reload.column_id == @destination.id
+    end
+  end
+end
