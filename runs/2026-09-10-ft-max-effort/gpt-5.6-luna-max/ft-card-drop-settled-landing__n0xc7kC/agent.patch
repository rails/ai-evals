--- a/app/controllers/cards/columns_controller.rb
+++ b/app/controllers/cards/columns_controller.rb
@@ -1,8 +1,51 @@
 class Cards::ColumnsController < ApplicationController
+  include CardScoped
+
   def edit
-    @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
     @columns = @card.board.columns.sorted
 
     fresh_when etag: [ @card, @columns ]
   end
+
+  def update
+    if params[:column_id].present?
+      update_column
+    elsif params[:status].present?
+      update_status
+    else
+      raise ActionController::BadRequest, "A column or status is required"
+    end
+
+    respond_to do |format|
+      format.html { redirect_to @card }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def update_column
+      case params[:column_id].to_s
+      when "maybe", "triage", "not_now", "closed", "done"
+        update_status_to params[:column_id]
+      else
+        @card.triage_into @card.board.columns.find(params[:column_id])
+      end
+    end
+
+    def update_status
+      update_status_to params[:status]
+    end
+
+    def update_status_to(status)
+      case status.to_s
+      when "maybe", "triage"
+        @card.send_back_to_triage
+      when "not_now"
+        @card.postpone
+      when "closed", "done"
+        @card.close
+      else
+        raise ActionController::BadRequest, "Unknown card status"
+      end
+    end
 end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a6a9677
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,190 @@
+import { Controller } from "@hotwired/stimulus"
+import { patch } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const ITEM_SELECTOR = '[data-drag-and-drop-target~="item"]'
+const CONTAINER_SELECTOR = '[data-drag-and-drop-target~="container"]'
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+
+  #draggedItem
+  #hoveredContainer
+  #pendingMoves = new WeakMap()
+
+  // Actions
+
+  start(event) {
+    const item = this.#itemFrom(event.target)
+
+    if (item) {
+      this.#draggedItem = item
+      item.classList.add(DRAGGED_ITEM_CLASS)
+      event.dataTransfer?.setData("text/plain", item.id)
+      if (event.dataTransfer) event.dataTransfer.effectAllowed = "move"
+    }
+  }
+
+  over(event) {
+    if (this.#draggedItem) {
+      const container = this.#containerFrom(event.target)
+
+      if (container) {
+        event.preventDefault()
+        if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+        this.#setHoveredContainer(container)
+      } else {
+        this.#setHoveredContainer()
+      }
+    }
+  }
+
+  drop(event) {
+    if (this.#draggedItem) {
+      event.preventDefault()
+
+      const item = this.#draggedItem
+      const source = this.#containerFrom(item)
+      const destination = this.#containerFrom(event.target)
+
+      this.#clearDragState()
+
+      if (destination && source !== destination) {
+        this.#move(item, source, destination)
+      }
+    }
+  }
+
+  end() {
+    this.#clearDragState()
+  }
+
+  // Private
+
+  #move(item, source, destination) {
+    const list = destination.querySelector(".cards__list")
+
+    if (list) {
+      const move = {
+        item,
+        source,
+        destination,
+        originalParent: item.parentElement,
+        originalNextSibling: item.nextSibling
+      }
+
+      this.#insertAtTop(item, list)
+      this.#updateCount(source, -1)
+      this.#updateCount(destination, 1)
+      this.#pendingMoves.set(item, move)
+      void this.#persist(move)
+    }
+  }
+
+  #insertAtTop(item, list) {
+    if (item.classList.contains("golden-effect")) {
+      list.prepend(item)
+    } else {
+      const firstNonGolden = [ ...list.querySelectorAll(".card") ].find(card => !card.classList.contains("golden-effect"))
+
+      if (firstNonGolden) {
+        firstNonGolden.parentElement.insertBefore(item, firstNonGolden)
+      } else {
+        list.append(item)
+      }
+    }
+  }
+
+  async #persist(move) {
+    const parameters = this.#parametersFor(move.destination)
+    const url = move.item.dataset.dragAndDropUrl
+
+    if (parameters && url) {
+      try {
+        const response = await patch(url, { body: parameters, responseKind: "json" })
+
+        if (!response.ok) {
+          throw new Error(`Could not move card (HTTP ${response.statusCode})`)
+        }
+
+        if (this.#pendingMoves.get(move.item) === move) {
+          this.#pendingMoves.delete(move.item)
+        }
+      } catch (error) {
+        if (this.#pendingMoves.get(move.item) === move) {
+          this.#rollback(move)
+          this.#pendingMoves.delete(move.item)
+        }
+
+        console.error(error)
+      }
+    } else {
+      this.#rollback(move)
+      this.#pendingMoves.delete(move.item)
+    }
+  }
+
+  #rollback(move) {
+    const destinationList = move.destination.querySelector(".cards__list")
+
+    if (destinationList?.contains(move.item)) {
+      if (move.originalParent?.isConnected) {
+        if (move.originalNextSibling?.parentNode === move.originalParent) {
+          move.originalParent.insertBefore(move.item, move.originalNextSibling)
+        } else {
+          move.originalParent.append(move.item)
+        }
+
+        this.#updateCount(move.destination, -1)
+        this.#updateCount(move.source, 1)
+      }
+    }
+  }
+
+  #parametersFor(destination) {
+    if (destination.dataset.dragAndDropColumnId) {
+      return { column_id: destination.dataset.dragAndDropColumnId }
+    } else if (destination.dataset.dragAndDropStatus) {
+      return { status: destination.dataset.dragAndDropStatus }
+    }
+  }
+
+  #setHoveredContainer(container) {
+    if (this.#hoveredContainer !== container) {
+      this.#hoveredContainer?.classList.remove(HOVER_CONTAINER_CLASS)
+      this.#hoveredContainer = container
+      this.#hoveredContainer?.classList.add(HOVER_CONTAINER_CLASS)
+    }
+  }
+
+  #clearDragState() {
+    this.#draggedItem?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#draggedItem = null
+    this.#setHoveredContainer()
+  }
+
+  #itemFrom(element) {
+    const item = element?.closest?.(ITEM_SELECTOR)
+    return item && this.element.contains(item) ? item : null
+  }
+
+  #containerFrom(element) {
+    const container = element?.closest?.(CONTAINER_SELECTOR)
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #updateCount(container, change) {
+    if (container) {
+      const count = container.querySelector(".cards__expander-count")
+      const expander = container.querySelector(".cards__expander")
+      const current = Number.parseInt(count?.textContent, 10)
+
+      if (count && count.textContent !== "99+" && Number.isInteger(current)) {
+        const next = Math.max(0, current + change)
+        count.textContent = next > 99 ? "99+" : next
+        expander?.style.setProperty("--card-count", Math.min(next, 15))
+      }
+    }
+  }
+}
