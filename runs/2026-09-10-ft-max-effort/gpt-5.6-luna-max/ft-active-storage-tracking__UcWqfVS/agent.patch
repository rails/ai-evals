diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..2298a7e
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = Board.create!(name: "Storage usage board", creator: users(:david))
+    @card = cards(:logo)
+    @user = users(:david)
+  end
+
+  test "counts card images and embeds in board, card, and comment descriptions" do
+    card_image = attach_card_image("card image")
+    board_description = attach_rich_text(@board, :public_description, "board description")
+    card_description = attach_rich_text(@card, :description, "card description")
+    comment = @card.comments.create!(body: "Comment", creator: @user)
+    comment_body = attach_rich_text(comment, :body, "comment body")
+
+    refresh_storage_usage
+
+    expected = card_image.byte_size + board_description.byte_size + card_description.byte_size + comment_body.byte_size
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+  end
+
+  test "does not count unrelated active storage attachments" do
+    blob = upload_blob("avatar")
+    ActiveStorage::Attachment.create!(record: @user, name: "avatar", blob: blob, account: @account)
+
+    refresh_storage_usage
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "counts a blob only once when it is used more than once on a board" do
+    blob = upload_blob("shared file")
+    @card.image.attach(blob)
+    rich_text = @card.description
+    rich_text.body = ActionText::Content.new("").append_attachables(blob)
+    @card.save!
+
+    refresh_storage_usage
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "updates usage when attachments are removed and cards move boards" do
+    card_image = attach_card_image("card image")
+    board_description = attach_rich_text(@board, :public_description, "board description")
+    refresh_storage_usage
+
+    assert_equal card_image.byte_size + board_description.byte_size, @board.reload.bytes_used
+
+    perform_storage_jobs do
+      @card.image.detach
+    end
+    assert_equal board_description.byte_size, @board.reload.bytes_used
+
+    perform_storage_jobs do
+      @card.update!(board: @other_board)
+    end
+    assert_equal board_description.byte_size, @board.reload.bytes_used
+    assert_equal 0, @other_board.reload.bytes_used
+    assert_equal board_description.byte_size, @account.reload.bytes_used
+
+    perform_storage_jobs do
+      @board.public_description = "A description without the old file"
+      @board.save!
+    end
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "usage refreshes happen in background jobs" do
+    blob = upload_blob("card image")
+    @card.image.attach(blob)
+
+    assert_equal 0, @board.reload.bytes_used
+    perform_storage_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "detaching all rich text embeds refreshes usage" do
+    blob = attach_rich_text(@board, :public_description, "board description")
+    refresh_storage_usage
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    perform_storage_jobs do
+      @board.public_description.embeds.detach
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "deleting a board refreshes the account usage" do
+    blob = attach_rich_text(@other_board, :public_description, "board description")
+    refresh_storage_usage
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    perform_storage_jobs do
+      @other_board.destroy!
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  private
+    def attach_card_image(contents)
+      blob = upload_blob(contents)
+      @card.image.attach(blob)
+      blob
+    end
+
+    def attach_rich_text(record, association, contents)
+      blob = upload_blob(contents)
+      rich_text = record.public_send(association)
+      rich_text.body = ActionText::Content.new("").append_attachables(blob)
+      record.save!
+      blob
+    end
+
+    def upload_blob(contents)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: "storage-usage-#{contents}.bin",
+        content_type: "application/octet-stream"
+      )
+    end
+
+    def refresh_storage_usage
+      StorageUsage::RecalculateJob.perform_now(@account.id)
+    end
+
+    def perform_storage_jobs(&block)
+      perform_enqueued_jobs(&block)
+    end
+end
