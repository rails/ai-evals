new file mode 100644
index 0000000..af65f23
--- /dev/null
+++ b/app/jobs/storage_usage/recalculate_job.rb
@@ -0,0 +1,34 @@
+class StorageUsage::RecalculateJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform(account_id = nil)
+    if account_id
+      recalculate_account(account_id)
+    else
+      recalculate_all
+    end
+  end
+
+  private
+    def recalculate_account(account_id)
+      if account = Account.find_by(id: account_id)
+        account.boards.find_each do |board|
+          StorageUsage::BoardRefresher.refresh(board.id)
+        end
+
+        StorageUsage::AccountRefresher.refresh(account.id)
+      end
+    end
+
+    def recalculate_all
+      Board.find_each do |board|
+        StorageUsage::BoardRefresher.refresh(board.id)
+      end
+
+      Account.find_each do |account|
+        StorageUsage::AccountRefresher.refresh(account.id)
+      end
+    end
+end
