diff --git a/app/models/concerns/storage_usage/attachment_callbacks.rb b/app/models/concerns/storage_usage/attachment_callbacks.rb
new file mode 100644
index 0000000..a6aa8bc
--- /dev/null
+++ b/app/models/concerns/storage_usage/attachment_callbacks.rb
@@ -0,0 +1,41 @@
+module StorageUsage::AttachmentCallbacks
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :refresh_storage_usage_after_create
+    before_destroy :remember_storage_usage_location
+    after_destroy_commit :refresh_storage_usage_after_destroy
+  end
+
+  def delete
+    remember_storage_usage_location
+    super.tap { refresh_storage_usage_after_destroy }
+  end
+
+  private
+    def remember_storage_usage_location
+      if StorageUsage.relevant_attachment?(self)
+        @storage_usage_location ||= StorageUsage.location_for_attachment(self)
+      end
+    end
+
+    def refresh_storage_usage_after_create
+      refresh_storage_usage_later
+    end
+
+    def refresh_storage_usage_after_destroy
+      refresh_storage_usage_later
+    end
+
+    def refresh_storage_usage_later
+      if StorageUsage.relevant_attachment?(self)
+        location = @storage_usage_location || StorageUsage.location_for_attachment(self)
+
+        if location&.board_id
+          StorageUsage.refresh_board_later(location.board_id)
+        elsif location&.account_id
+          StorageUsage.refresh_account_later(location.account_id)
+        end
+      end
+    end
+end
diff --git a/app/models/concerns/storage_usage/detach_many_callbacks.rb b/app/models/concerns/storage_usage/detach_many_callbacks.rb
