+++ b/app/models/concerns/storage_usage/detach_many_callbacks.rb
@@ -0,0 +1,15 @@
+module StorageUsage::DetachManyCallbacks
+  def detach
+    location = if record.is_a?(ActionText::RichText) && StorageUsage.relevant_rich_text?(record)
+      StorageUsage.location_for_rich_text(record)
+    end
+
+    super.tap do
+      if location&.board_id
+        StorageUsage.refresh_board_later(location.board_id)
+      elsif location&.account_id
+        StorageUsage.refresh_account_later(location.account_id)
+      end
+    end
+  end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..b385b09
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,64 @@
+module StorageUsage
+  Location = Struct.new(:board_id, :account_id, keyword_init: true)
+
+  CARD_IMAGE = { record_type: "Card", name: "image" }.freeze
+  RICH_TEXT_EMBEDS = { record_type: "ActionText::RichText", name: "embeds" }.freeze
+
+  class << self
+    def relevant_attachment?(attachment)
+      attachment.name == CARD_IMAGE[:name] && attachment.record_type == CARD_IMAGE[:record_type] ||
+        attachment.name == RICH_TEXT_EMBEDS[:name] && attachment.record_type == RICH_TEXT_EMBEDS[:record_type]
+    end
+
+    def relevant_rich_text?(rich_text)
+      rich_text.name == "public_description" && rich_text.record_type == "Board" ||
+        rich_text.name == "description" && rich_text.record_type == "Card" ||
+        rich_text.name == "body" && rich_text.record_type == "Comment"
+    end
+
+    def refresh_board_later(board_id)
+      if StorageUsage::BoardRefresher.request(board_id)
+        StorageUsage::RefreshBoardJob.perform_later(board_id)
+      end
+    end
+
+    def refresh_account_later(account_id)
+      StorageUsage::RefreshAccountJob.perform_later(account_id)
+    end
+
+    def location_for_attachment(attachment)
+      if attachment.record_type == CARD_IMAGE[:record_type] && attachment.name == CARD_IMAGE[:name]
+        location_for_card(attachment.record)
+      elsif attachment.record_type == RICH_TEXT_EMBEDS[:record_type] && attachment.name == RICH_TEXT_EMBEDS[:name]
+        location_for_rich_text(attachment.record)
+      end
+    end
+
+    def location_for_rich_text(rich_text)
+      if rich_text
+        case rich_text.record_type
+        when "Board"
+          location_for_board(Board.find_by(id: rich_text.record_id))
+        when "Card"
+          location_for_card(Card.find_by(id: rich_text.record_id))
+        when "Comment"
+          location_for_comment(Comment.find_by(id: rich_text.record_id))
+        end
+      end
+    end
+
+    def location_for_board(board)
+      Location.new(board_id: board.id, account_id: board.account_id) if board
+    end
+
+    def location_for_card(card)
+      Location.new(board_id: card.board_id, account_id: card.account_id) if card
+    end
+
+    def location_for_comment(comment)
+      if comment && (card = comment.card)
+        location_for_card(card)
+      end
+    end
+  end
+end
