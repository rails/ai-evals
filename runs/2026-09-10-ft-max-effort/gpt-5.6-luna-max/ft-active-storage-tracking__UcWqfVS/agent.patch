diff --git a/app/models/storage_usage/board_refresher.rb b/app/models/storage_usage/board_refresher.rb
new file mode 100644
index 0000000..4d1cc23
--- /dev/null
+++ b/app/models/storage_usage/board_refresher.rb
@@ -0,0 +1,25 @@
+class StorageUsage::BoardRefresher
+  class << self
+    def request(board_id)
+      Board.where(id: board_id, storage_usage_pending: false).update_all(storage_usage_pending: true) == 1
+    end
+
+    def refresh(board_id)
+      Board.transaction do
+        if board = Board.lock.find_by(id: board_id)
+          old_bytes_used = board.bytes_used.to_i
+          new_bytes_used = StorageUsage::Calculator.bytes_used_for(board)
+          delta = new_bytes_used - old_bytes_used
+
+          board.update_columns(bytes_used: new_bytes_used, storage_usage_pending: false)
+          update_account(board.account_id, delta) if delta != 0
+        end
+      end
+    end
+
+    private
+      def update_account(account_id, delta)
+        Account.where(id: account_id).update_all("bytes_used = bytes_used + #{delta}")
+      end
+  end
+end
diff --git a/app/models/storage_usage/calculator.rb b/app/models/storage_usage/calculator.rb
new file mode 100644
index 0000000..ec06c80
--- /dev/null
+++ b/app/models/storage_usage/calculator.rb
@@ -0,0 +1,62 @@
+class StorageUsage::Calculator
+  class << self
+    def bytes_used_for(board)
+      new(board).bytes_used
+    end
+  end
+
+  def initialize(board)
+    @board = board
+  end
+
+  def bytes_used
+    ActiveStorage::Blob.where(id: attachment_scope.select(:blob_id).distinct).sum(:byte_size)
+  end
+
+  private
+    attr_reader :board
+
+    def attachment_scope
+      ActiveStorage::Attachment.where(
+        record_type: StorageUsage::CARD_IMAGE[:record_type],
+        name: StorageUsage::CARD_IMAGE[:name],
+        record_id: card_ids
+      ).or(
+        ActiveStorage::Attachment.where(
+          record_type: StorageUsage::RICH_TEXT_EMBEDS[:record_type],
+          name: StorageUsage::RICH_TEXT_EMBEDS[:name],
+          record_id: rich_text_ids
+        )
+      )
+    end
+
+    def card_ids
+      @card_ids ||= Card.where(board_id: board.id).select(:id)
+    end
+
+    def rich_text_ids
+      @rich_text_ids ||= begin
+        ActionText::RichText.where(
+          record_type: "Board",
+          name: "public_description",
+          record_id: board.id
+        ).or(
+          ActionText::RichText.where(
+            record_type: "Card",
+            name: "description",
+            record_id: card_ids
+          )
+        ).or(
+          ActionText::RichText.where(
+            record_type: "Comment",
+            name: "body",
+            record_id: comment_ids
+          )
+        ).select(:id)
+      end
+    end
+
+    def comment_ids
+      @comment_ids ||= Comment.where(card_id: card_ids).select(:id)
+    end
+end
