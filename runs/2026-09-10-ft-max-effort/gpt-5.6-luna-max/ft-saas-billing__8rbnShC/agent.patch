@@ -0,0 +1,49 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, except: :index
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Account uncomped"
+  end
+
+  def override
+    @account.override_limits!(
+      card_count: override_value(:card_count),
+      bytes_used: override_value(:bytes_used)
+    )
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to saas.admin_account_path(@account, script_name: nil), alert: error.record.errors.full_messages.to_sentence
+  end
+
+  def reset
+    @account.reset_limits_override!
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Limits reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+    end
+
+    def override_value(name)
+      value = params.dig(:override, name) || params[name]
+      value.present? ? Integer(value, 10) : nil
+    rescue ArgumentError, TypeError
+      value
+    end
+end
