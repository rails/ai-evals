diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..8b7fa2c
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,146 @@
+class Account::Plan
+  FREE = "free"
+  UNLIMITED = "unlimited"
+  UNLIMITED_PLUS = "unlimited_plus"
+
+  CARD_LIMIT = 1_000
+  CARD_WARNING_THRESHOLD = 100
+  FREE_CARD_LIMIT = CARD_LIMIT
+  FREE_STORAGE_LIMIT = 1.gigabyte
+  UNLIMITED_STORAGE_LIMIT = 5.gigabytes
+  UNLIMITED_PLUS_STORAGE_LIMIT = 500.gigabytes
+
+  PLANS = {
+    FREE => {
+      name: "Free",
+      price: 0,
+      card_limit: CARD_LIMIT,
+      storage_limit: FREE_STORAGE_LIMIT
+    },
+    UNLIMITED => {
+      name: "Unlimited",
+      price: 20,
+      card_limit: nil,
+      storage_limit: UNLIMITED_STORAGE_LIMIT
+    },
+    UNLIMITED_PLUS => {
+      name: "Unlimited+",
+      price: 25,
+      card_limit: nil,
+      storage_limit: UNLIMITED_PLUS_STORAGE_LIMIT
+    }
+  }.freeze
+
+  PRICE_ENV_KEYS = {
+    UNLIMITED => %w[STRIPE_UNLIMITED_PRICE_ID STRIPE_MONTHLY_V1_PRICE_ID],
+    UNLIMITED_PLUS => %w[STRIPE_UNLIMITED_PLUS_PRICE_ID STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID]
+  }.freeze
+
+  attr_reader :key
+
+  def self.[](key)
+    new(normalize_key(key))
+  end
+
+  def self.free
+    self[FREE]
+  end
+
+  def self.unlimited
+    self[UNLIMITED]
+  end
+
+  def self.unlimited_plus
+    self[UNLIMITED_PLUS]
+  end
+
+  def self.normalize_key(key)
+    value = key.to_s.strip
+
+    case value.downcase
+    when "", "free", "freev1", "free_v1" then FREE
+    when "unlimited", "unlimitedv1", "unlimited_v1" then UNLIMITED
+    when "unlimited+", "unlimited plus", "unlimited_plus", "unlimitedplus", "unlimitedplusv1", "unlimited_plus_v1" then UNLIMITED_PLUS
+    else
+      normalized = value.downcase.tr(" -", "__")
+      PLANS.key?(normalized) ? normalized : FREE
+    end
+  end
+
+  def self.known_key?(key)
+    value = key.to_s.strip.downcase
+    %w[free freev1 free_v1 unlimited unlimitedv1 unlimited_v1 unlimited+ unlimited_plus unlimitedplus unlimitedplusv1 unlimited_plus_v1].include?(value) || value == "unlimited plus"
+  end
+
+  def self.from_stripe_price(price_id)
+    return FREE if price_id.blank?
+
+    PRICE_ENV_KEYS.each do |plan_key, env_keys|
+      return plan_key if env_keys.any? { |env_key| ENV[env_key].present? && ENV[env_key] == price_id }
+    end
+
+    nil
+  end
+
+  def self.stripe_price_id(key)
+    normalized_key = normalize_key(key)
+    env_keys = PRICE_ENV_KEYS[normalized_key] || []
+    env_keys.lazy.map { |env_key| ENV[env_key] }.find(&:present?)
+  end
+
+  def initialize(key)
+    @key = self.class.normalize_key(key)
+  end
+
+  def name
+    details[:name]
+  end
+  alias display_name name
+
+  def price
+    details[:price]
+  end
+
+  def card_limit
+    details[:card_limit]
+  end
+
+  def storage_limit
+    details[:storage_limit]
+  end
+
+  def paid?
+    key != FREE
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def stripe_price_id
+    stripe_price_ids.first || key
+  end
+
+  def stripe_price_ids
+    ids = if key == UNLIMITED_PLUS && ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"].blank?
+      [ self.class.stripe_price_id(UNLIMITED), ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] ].compact
+    else
+      [ self.class.stripe_price_id(key) ].compact
+    end
+
+    ids.presence || [ key ]
+  end
+
+  def to_param
+    key
+  end
+
+  def to_s
+    name
+  end
+
+  private
+    def details
+      PLANS.fetch(key)
+    end
+end
