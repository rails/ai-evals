diff --git a/saas/app/models/account/storage_limited.rb b/saas/app/models/account/storage_limited.rb
index 46db552..1f6e006 100644
--- a/saas/app/models/account/storage_limited.rb
+++ b/saas/app/models/account/storage_limited.rb
@@ -1,25 +1,174 @@
 module Account::StorageLimited
   extend ActiveSupport::Concern
 
+  DEFAULT_CARD_LIMIT = Account::Plan::CARD_LIMIT
+  NEAR_CARD_LIMIT_THRESHOLD = Account::Plan::CARD_WARNING_THRESHOLD
   DEFAULT_STORAGE_LIMIT = 1.gigabyte
   NEAR_STORAGE_LIMIT_THRESHOLD = 500.megabytes
 
   included do
-    has_one :storage_exception
+    has_one :storage_exception, dependent: :destroy
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def billing_plan
+    plan_key = if subscription&.canceled?
+      Account::Plan::FREE
+    else
+      subscription&.plan_key.presence || Account::Plan::FREE
+    end
+    plan = Account::Plan[plan_key]
+
+    if comped? && plan.key == Account::Plan::FREE
+      Account::Plan[Account::Plan::UNLIMITED]
+    else
+      plan
+    end
+  end
+  alias effective_plan billing_plan
+  alias subscription_plan billing_plan
+
+  def plan
+    billing_plan.name
+  end
+  alias plan_name plan
+
+  def plan_key
+    billing_plan.key
+  end
+
+  def free?
+    billing_plan.key == Account::Plan::FREE
+  end
+
+  def paid?
+    billing_plan.paid?
+  end
+
+  def active_subscription
+    subscription if subscription&.paid? && subscription.active?
+  end
+
+  def current_plan
+    billing_plan
+  end
+
+  def storage_allowance
+    storage_limit
+  end
+
+  def card_allowance
+    card_limit
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    create_billing_waiver! unless comped?
+    billing_waiver
+  end
+  alias comp comp!
+
+  def uncomp!
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+    true
+  end
+  alias uncomp uncomp!
+
+  def overridden_limits
+    overridden_limit
+  end
+
+  def card_limit
+    if overridden_limit&.card_count.nil?
+      billing_plan.card_limit
+    else
+      overridden_limit.card_count
+    end
+  end
+
+  def card_count
+    overridden_limit&.card_count.nil? ? cards_count : overridden_limit.card_count
+  end
+  alias cards_used card_count
+  alias effective_card_count card_count
+
+  def cards_remaining
+    if card_limit
+      card_limit - card_count
+    end
+  end
+
+  def nearing_card_limit?
+    cards_remaining && cards_remaining.between?(1, NEAR_CARD_LIMIT_THRESHOLD)
+  end
+  alias nearing_card_limit nearing_card_limit?
+
+  def cards_left
+    cards_remaining
+  end
+
+  def exceeding_card_limit?
+    cards_remaining && cards_remaining <= 0
+  end
+  alias card_limit_exceeded? exceeding_card_limit?
+
+  def exceeding_limits?
+    exceeding_card_limit? || exceeding_storage_limit?
+  end
+
+  def bytes_used
+    if overridden_limit && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      super
+    end
   end
 
   def storage_limit
-    storage_exception&.bytes_allowed || DEFAULT_STORAGE_LIMIT
+    storage_exception&.bytes_allowed || billing_plan.storage_limit || DEFAULT_STORAGE_LIMIT
   end
 
   def exceeding_storage_limit?
     bytes_used > storage_limit
   end
 
+  alias storage_limit_exceeded? exceeding_storage_limit?
+
   def nearing_storage_limit?
     !exceeding_storage_limit? && bytes_used > storage_limit - NEAR_STORAGE_LIMIT_THRESHOLD
   end
 
+  def override_limits!(card_count: nil, bytes_used: nil)
+    record = overridden_limit || build_overridden_limit
+    record.assign_attributes(card_count: card_count, bytes_used: bytes_used)
+
+    if record.empty?
+      record.destroy! if record.persisted?
+      association(:overridden_limit).reset
+      nil
+    else
+      record.save!
+      record
+    end
+  end
+  alias override! override_limits!
+  alias override_limits override_limits!
+
+  def reset_limits_override!
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+    true
+  end
+  alias reset_override! reset_limits_override!
+  alias reset_limits_override reset_limits_override!
+  alias reset_override reset_limits_override!
+
   def add_storage_exception(bytes)
