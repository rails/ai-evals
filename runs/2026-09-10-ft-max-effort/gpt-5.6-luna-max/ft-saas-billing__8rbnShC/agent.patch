+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list and inspect accounts" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: accounts(:initech).name, href: saas.admin_account_path(accounts(:initech), script_name: nil)
+  end
+
+  test "staff can comp and override an account, then reset it" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted { post "/admin/accounts/" + account.id.to_s + "/comp" }
+    assert_redirected_to saas.admin_account_path(account, script_name: nil)
+    assert account.reload.comped?
+
+    untenanted do
+      post "/admin/accounts/" + account.id.to_s + "/override", params: { override: { card_count: "12", bytes_used: "34" } }
+    end
+    assert_equal 12, account.reload.card_count
+    assert_equal 34, account.bytes_used
+
+    untenanted { post "/admin/accounts/" + account.id.to_s + "/reset" }
+    assert_nil account.reload.overridden_limit
+  end
+end
