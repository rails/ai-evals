       storage_exception.update!(bytes_allowed: bytes)
diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..456229f
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,46 @@
+class Account::Subscription < SaasRecord
+  PLAN_KEYS = Account::Plan::PLANS.keys.freeze
+
+  belongs_to :account, class_name: "::Account", foreign_key: :account_id
+
+  validates :plan_key, inclusion: { in: PLAN_KEYS }
+  validates :stripe_customer_id, uniqueness: true, allow_nil: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  before_validation do
+    self.plan_key = Account::Plan.normalize_key(plan_key)
+  end
+
+  def plan
+    Account::Plan[plan_key]
+  end
+
+  def plan=(value)
+    self.plan_key = value
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def storage_limit
+    plan.storage_limit
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def active?
+    status.blank? || status.in?(%w[active trialing past_due])
+  end
+
+  def canceled?
+    status.in?(%w[canceled cancelled unpaid incomplete_expired])
+  end
+  alias cancelled? canceled?
+end
