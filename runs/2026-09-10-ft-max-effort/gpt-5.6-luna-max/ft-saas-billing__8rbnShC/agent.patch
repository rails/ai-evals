+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription webhook updates the account plan" do
+    account = accounts(:initech)
+    payload = {
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_test",
+          customer: "cus_test",
+          status: "active",
+          metadata: { account_id: account.id },
+          items: { data: [ { price: { id: "unlimited_plus" } } ] }
+        }
+      }
+    }
+
+    Stripe::Webhook.stubs(:construct_event).returns(payload)
+
+    untenanted do
+      post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :ok
+    assert_equal "Unlimited+", account.reload.plan
+    assert_equal "cus_test", account.subscription.stripe_customer_id
+  end
+end
+
+class StripeSubscriptionCancellationTest < ActionDispatch::IntegrationTest
+  test "a deleted subscription returns the account to Free" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", stripe_subscription_id: "sub_deleted", stripe_customer_id: "cus_deleted", status: "active")
+    payload = {
+      type: "customer.subscription.deleted",
+      data: { object: { id: "sub_deleted", customer: "cus_deleted", status: "canceled" } }
+    }
+    Stripe::Webhook.stubs(:construct_event).returns(payload)
+
+    untenanted { post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" } }
+
+    assert_response :ok
+    assert_equal "Free", account.reload.plan
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..9b14215
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan has the approved limits" do
+    assert_equal "Free", @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid plans bring their own storage allowance" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active")
+    assert_equal "Unlimited", @account.plan
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.subscription.update!(plan_key: "unlimited_plus")
+    assert_equal "Unlimited+", @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comp gives a free account paid limits and uncomp removes them" do
+    @account.comp!
+    assert @account.comped?
+    assert_nil @account.card_limit
+
+    @account.uncomp!
+    assert_not @account.comped?
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "support can override and reset usage" do
+    @account.override_limits!(card_count: 950, bytes_used: 123)
+    assert_equal 950, @account.card_count
+    assert_equal 123, @account.bytes_used
+
+    @account.reset_limits_override!
+    assert_nil @account.overridden_limit
+    assert_equal @account.cards_count, @account.card_count
+  end
+end
