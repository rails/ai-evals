@@ -0,0 +1,42 @@
+class Stripe::CheckoutsController < ApplicationController
+  def show
+    create
+  end
+
+  def create
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+    plan = requested_plan
+    session = Stripe::Checkout::Session.create(checkout_session_attributes(plan))
+
+    redirect_to session.url, allow_other_host: true
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, severity: :error)
+    redirect_to main_app.account_settings_path, alert: "We couldn't start checkout. Please try again."
+  end
+
+  private
+    def requested_plan
+      plan = Account::Plan[params[:plan].presence || Account::Plan::UNLIMITED]
+      raise ArgumentError, "A paid plan is required" unless plan.paid?
+
+      plan
+    end
+
+    def checkout_session_attributes(plan)
+      attributes = {
+        mode: "subscription",
+        line_items: plan.stripe_price_ids.map { |price| { price: price, quantity: 1 } },
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan: plan.key },
+        subscription_data: { metadata: { account_id: Current.account.id, plan: plan.key } },
+        success_url: main_app.account_settings_url,
+        cancel_url: main_app.account_settings_url
+      }
+
+      if customer_id = Current.account.subscription&.stripe_customer_id
+        attributes[:customer] = customer_id
+      end
+
+      attributes
+    end
+end
