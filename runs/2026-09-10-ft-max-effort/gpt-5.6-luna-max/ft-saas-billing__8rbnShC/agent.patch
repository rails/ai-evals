+class Stripe::PortalsController < ApplicationController
+  def show
+    create
+  end
+
+  def create
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+    customer_id = Current.account.subscription&.stripe_customer_id
+
+    if customer_id.blank?
+      redirect_to main_app.account_settings_path, alert: "There is no billing account to manage yet."
+    else
+      session = Stripe::BillingPortal::Session.create(
+        customer: customer_id,
+        return_url: main_app.account_settings_url
+      )
+      redirect_to session.url, allow_other_host: true
+    end
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, severity: :error)
+    redirect_to main_app.account_settings_path, alert: "We couldn't open the customer portal. Please try again."
+  end
+end
diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..06dbec5
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,166 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = stripe_event
+    process_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def stripe_event
+      if ENV["STRIPE_WEBHOOK_SECRET"].present?
+        Stripe::Webhook.construct_event(
+          request.raw_post,
+          request.headers["Stripe-Signature"],
+          ENV["STRIPE_WEBHOOK_SECRET"]
+        )
+      else
+        JSON.parse(request.raw_post)
+      end
+    end
+
+    def process_event(event)
+      type = value(event, :type).to_s
+      object = value(value(event, :data), :object)
+
+      case type
+      when "checkout.session.completed"
+        synchronize_checkout(object)
+      when /^customer\.subscription\./
+        synchronize_subscription(object, canceled: type.end_with?(".deleted") || value(object, :status).to_s.in?(%w[canceled cancelled unpaid incomplete_expired]))
+      end
+    end
+
+    def synchronize_checkout(checkout)
+      account = find_account(checkout)
+      return unless account
+
+      subscription_id = reference(value(checkout, :subscription))
+      customer_id = reference(value(checkout, :customer))
+      plan_key = plan_key_for(value(value(checkout, :metadata), :plan))
+
+      synchronize_account_subscription(
+        account,
+        subscription_id: subscription_id,
+        customer_id: customer_id,
+        plan_key: plan_key,
+        status: "active"
+      )
+    end
+
+    def synchronize_subscription(stripe_subscription, canceled: false)
+      subscription_id = reference(value(stripe_subscription, :id))
+      customer_id = reference(value(stripe_subscription, :customer))
+      local_subscription = Account::Subscription.find_by(stripe_subscription_id: subscription_id) if subscription_id.present?
+      local_subscription ||= Account::Subscription.find_by(stripe_customer_id: customer_id) if customer_id.present?
+
+      account = local_subscription&.account || find_account(stripe_subscription)
+      return unless account
+
+      plan_key = if canceled
+        Account::Plan::FREE
+      else
+        plan_key_for(value(value(stripe_subscription, :metadata), :plan)) ||
+          plan_key_for_prices(price_ids_from(stripe_subscription)) ||
+          local_subscription&.plan_key ||
+          Account::Plan::FREE
+      end
+
+      synchronize_account_subscription(
+        account,
+        subscription_id: subscription_id,
+        customer_id: customer_id,
+        plan_key: plan_key,
+        status: canceled ? "canceled" : value(stripe_subscription, :status),
+        price_id: price_id_from(stripe_subscription),
+        current_period_end: timestamp(value(stripe_subscription, :current_period_end)),
+        cancel_at: timestamp(value(stripe_subscription, :cancel_at))
+      )
+    end
+
+    def synchronize_account_subscription(account, subscription_id:, customer_id:, plan_key:, status:, price_id: nil, current_period_end: nil, cancel_at: nil)
+      subscription = Account::Subscription.find_or_initialize_by(account_id: account.id)
+      subscription.assign_attributes(
+        stripe_subscription_id: subscription_id.presence || subscription.stripe_subscription_id,
+        stripe_customer_id: customer_id.presence || subscription.stripe_customer_id,
+        plan_key: Account::Plan.normalize_key(plan_key),
+        stripe_price_id: price_id.presence || subscription.stripe_price_id,
+        status: status.presence || subscription.status,
+        current_period_end: current_period_end || subscription.current_period_end,
+        cancel_at: cancel_at || subscription.cancel_at
+      )
+      subscription.save!
+    end
+
+    def find_account(object)
+      metadata = value(object, :metadata)
+      identifier = value(metadata, :account_id).presence ||
+        value(metadata, :external_account_id).presence ||
+        value(object, :client_reference_id).presence
+
+      if identifier.present?
+        Account.find_by(id: identifier) || Account.find_by(external_account_id: identifier)
+      end
+    end
+
+    def plan_key_for(value)
+      return if value.blank?
+
+      key = Account::Plan.from_stripe_price(value)
+      key ||= Account::Plan.normalize_key(value) if Account::Plan.known_key?(value)
+
+      if key.nil? && value.to_s.downcase.match?(/unlimited.*(?:plus|\+)/)
+        Account::Plan::UNLIMITED_PLUS
+      elsif key.nil? && value.to_s.downcase.include?("unlimited")
+        Account::Plan::UNLIMITED
+      else
+        key
+      end
+    end
+
+    def price_id_from(stripe_subscription)
+      item = Array(value(value(stripe_subscription, :items), :data)).first
+      value(value(item, :price), :id) || value(item, :price)
+    end
+
+    def price_ids_from(stripe_subscription)
+      Array(value(value(stripe_subscription, :items), :data)).filter_map do |item|
+        value(value(item, :price), :id) || value(item, :price)
+      end
+    end
+
+    def plan_key_for_prices(price_ids)
+      price_ids.filter_map { |price_id| plan_key_for(price_id) }.max_by do |plan_key|
+        Account::Plan::PLANS.keys.index(plan_key)
+      end
+    end
+
+    def reference(value)
+      if value.respond_to?(:id)
+        value.public_send(:id) || value
+      elsif value.is_a?(Hash)
+        value[:id] || value["id"] || value
+      else
+        value
+      end
+    end
+
+    def timestamp(value)
+      if value.present?
+        value.is_a?(Numeric) ? Time.at(value).in_time_zone : value
+      end
+    end
+
+    def value(object, key)
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[]) && !object.is_a?(String)
+        object[key] || object[key.to_s]
+      end
+    end
+end
