@@ -0,0 +1,43 @@
+require "test_helper"
+
+class CardReactionsViewTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "card detail view provides card reaction controls" do
+    card = cards(:logo)
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select "##{dom_id(card, :reacting)}"
+    assert_select "a[href=?]", new_card_reaction_path(card)
+  end
+
+  test "card JSON exposes card reactions URL" do
+    card = cards(:logo)
+
+    get card_path(card, format: :json)
+
+    assert_response :success
+    assert_equal card_reactions_url(card), @response.parsed_body["reactions_url"]
+  end
+
+  test "card preview shows a non-zero boost count" do
+    card = cards(:logo)
+    card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get board_column_path(card.column.board, card.column)
+
+    assert_response :success
+    assert_select ".card__boosts strong", text: "1"
+  end
+
+  test "card preview omits a zero boost count" do
+    get board_column_path(columns(:writebook_in_progress).board, columns(:writebook_in_progress))
+
+    assert_response :success
+    assert_select ".card__boosts", count: 0
+  end
+end
