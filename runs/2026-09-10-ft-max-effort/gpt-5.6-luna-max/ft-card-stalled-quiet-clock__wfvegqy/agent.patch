diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..d2a6b00
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    boards(:writebook).entropy.update! auto_postpone_period: 30.days
+  end
+
+  test "three comments from two people in a third of the board period create a burst" do
+    card = new_card
+    burst_time = Time.current.change(usec: 0)
+
+    travel_to burst_time do
+      add_comment card, users(:david)
+      add_comment card, users(:jz)
+      add_comment card, users(:david)
+    end
+
+    assert_not_nil card.reload.last_burst_at
+    assert_not card.stalled?
+  end
+
+  test "three comments from one person do not create a burst" do
+    card = new_card
+    burst_time = Time.current.change(usec: 0)
+
+    travel_to burst_time do
+      3.times { add_comment card, users(:david) }
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments outside the burst window do not create a burst" do
+    card = new_card
+    first_comment_time = Time.current.change(usec: 0)
+
+    travel_to first_comment_time do
+      add_comment card, users(:david)
+    end
+    travel 10.days + 1.second
+    add_comment card, users(:jz)
+    add_comment card, users(:david)
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "system comments do not count as people in a burst" do
+    card = new_card
+    burst_time = Time.current.change(usec: 0)
+
+    travel_to burst_time do
+      add_comment card, users(:system)
+      add_comment card, users(:david)
+      add_comment card, users(:jz)
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments exactly on the window boundary create a burst" do
+    card = new_card
+    first_comment_time = Time.current.change(usec: 0)
+
+    travel_to first_comment_time do
+      add_comment card, users(:david)
+    end
+    travel_to first_comment_time + 10.days do
+      add_comment card, users(:jz)
+      add_comment card, users(:david)
+    end
+
+    assert_not_nil card.reload.last_burst_at
+  end
+
+  test "assignment creates a burst" do
+    card = new_card
+
+    card.toggle_assignment users(:jz)
+
+    assert_not_nil card.reload.last_burst_at
+  end
+
+  test "reopening creates a burst" do
+    card = new_card
+    card.close
+
+    card.reopen
+
+    assert_not_nil card.reload.last_burst_at
+  end
+
+  test "closed and postponed cards are not stalled" do
+    closed_card = new_card
+    postponed_card = new_card
+    stale_time = 3.weeks.ago
+    closed_card.update_columns last_burst_at: stale_time, last_active_at: stale_time
+    postponed_card.update_columns last_burst_at: stale_time, last_active_at: stale_time
+
+    closed_card.close
+    postponed_card.postpone
+
+    assert_not closed_card.reload.stalled?
+    assert_not postponed_card.reload.stalled?
+  end
+
+  test "a burst becomes stalled after two weeks without activity" do
+    card = new_card
+    burst_time = Time.current.change(usec: 0)
+    card.update_column :last_burst_at, burst_time
+    card.update_column :last_active_at, burst_time
+
+    travel_to burst_time + 2.weeks + 1.second do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "activity resets stalled status" do
+    card = new_card
+    burst_time = Time.current.change(usec: 0)
+    card.update_columns last_burst_at: burst_time, last_active_at: burst_time
+
+    travel_to burst_time + 2.weeks + 1.second do
+      assert card.reload.stalled?
+      card.touch_last_active_at
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "stalled index filters cards" do
+    stalled_card = new_card
+    active_card = new_card
+    stale_time = 3.weeks.ago
+    stalled_card.update_columns last_burst_at: stale_time, last_active_at: stale_time
+
+    cards = users(:david).filters.new(indexed_by: "stalled").cards
+
+    assert_includes cards, stalled_card
+    assert_not_includes cards, active_card
+  end
+
+  private
+    def new_card
+      boards(:writebook).cards.create!(title: "Burst card", creator: users(:david), status: :published)
+    end
+
+    def add_comment(card, creator)
+      card.comments.create!(creator: creator, body: "A comment")
+    end
+end
