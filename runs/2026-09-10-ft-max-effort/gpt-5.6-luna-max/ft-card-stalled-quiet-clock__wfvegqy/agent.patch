diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..aaa6dbe
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,42 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      active
+        .where(last_burst_at: ..STALL_PERIOD.ago)
+        .where(last_active_at: ..STALL_PERIOD.ago)
+    end
+  end
+
+  def stalled?
+    active? && last_burst_at.present? && last_burst_at <= STALL_PERIOD.ago && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def burst_from_comment?(comment)
+    comments.by_user
+      .where(created_at: (comment.created_at - burst_comment_period)..comment.created_at)
+      .group(:card_id)
+      .having(
+        "COUNT(*) >= ? AND COUNT(DISTINCT creator_id) >= ?",
+        BURST_COMMENT_COUNT,
+        BURST_COMMENTER_COUNT
+      )
+      .exists?
+  end
+
+  def record_burst_at(time = Time.current)
+    if last_burst_at.nil? || time > last_burst_at
+      update! last_burst_at: time
+    end
+  end
+
+  private
+    def burst_comment_period
+      board.auto_postpone_period / 3
+    end
+end
