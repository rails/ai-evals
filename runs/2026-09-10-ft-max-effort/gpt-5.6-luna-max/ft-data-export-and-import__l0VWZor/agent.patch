diff --git a/app/jobs/export_job.rb b/app/jobs/export_job.rb
new file mode 100644
index 0000000..cc3a7ab
--- /dev/null
+++ b/app/jobs/export_job.rb
@@ -0,0 +1,37 @@
+class ExportJob < ApplicationJob
+  queue_as :backend
+
+  def perform(export)
+    Current.with_account(export.account) do
+      Current.set(user: export.user, account: export.account) do
+        export.update!(status: :processing, expires_at: Export::DOWNLOAD_EXPIRY.from_now)
+        create_export(export)
+        export.update!(status: :completed)
+        ExportMailer.ready(export).deliver_later
+      end
+    end
+  rescue StandardError => error
+    mark_failed(export, error)
+  end
+
+  private
+    def create_export(export)
+      ZipFile.create_for(export.file, filename: export.filename) do |zip|
+        if export.account?
+          Account::DataTransfer::Exporter.new(export.account, zip).export
+        else
+          cards = export.user.accessible_cards.where(account: export.account, id: export.card_ids).distinct
+          Account::DataTransfer::CardExporter.new(export.account, cards, zip).export
+        end
+      end
+    end
+
+    def mark_failed(export, error)
+      Rails.error.report(error, context: { export_id: export.id })
+      export.file.purge if export.file.attached?
+      export.update_columns(status: "failed", error: error.message, expires_at: Export::DOWNLOAD_EXPIRY.from_now)
+      ExportMailer.failed(export).deliver_later
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+end
diff --git a/app/jobs/import_job.rb b/app/jobs/import_job.rb
