+++ b/app/controllers/search_controller.rb
@@ -0,0 +1,19 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+
+    if @query.present?
+      set_page_and_extract_portion_from search_results
+    end
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards
+        .published
+        .matching(@query)
+        .reverse_chronologically
+        .with_rich_text_description
+        .preload(:board, comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..5c1f5b1
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,15 @@
+module SearchHelper
+  def search_result_excerpt(content, query)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+
+    if text_excerpt = excerpt(text, query, radius: 120)
+      highlight(text_excerpt, query)
+    end
+  end
+
+  def search_result_comment_excerpts(card, query)
+    card.comments.filter_map do |comment|
+      search_result_excerpt(comment.body, query)
+    end
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..d586700 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,37 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :matching, ->(term) do
+    if term.present?
+      where(<<~SQL.squish, term: term)
+        INSTR(LOWER(cards.title), LOWER(:term)) > 0
+        OR EXISTS (
+          SELECT 1
+          FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Card'
+            AND action_text_rich_texts.record_id = cards.id
+            AND action_text_rich_texts.name = 'description'
+            AND action_text_rich_texts.account_id = cards.account_id
+            AND INSTR(LOWER(action_text_rich_texts.body), LOWER(:term)) > 0
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comments.account_id = cards.account_id
+            AND comment_bodies.account_id = cards.account_id
+            AND INSTR(LOWER(comment_bodies.body), LOWER(:term)) > 0
+        )
+      SQL
+    else
+      none
+    end
+  end
+
   def card
     self
   end
diff --git a/app/views/search/_result.html.erb b/app/views/search/_result.html.erb
new file mode 100644
