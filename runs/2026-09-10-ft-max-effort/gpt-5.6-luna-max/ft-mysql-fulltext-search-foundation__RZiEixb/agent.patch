diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..b79e98b
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches published cards by title, description, and comment body" do
+    description_card = cards(:text)
+    description_card.update! description: "<p>A searchable description.</p>"
+
+    comment_card = cards(:shipping)
+    comment_card.comments.create! body: "A searchable comment", creator: users(:kevin)
+
+    get search_path, params: { q: "searchable" }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 2
+    assert_select "mark", text: "searchable", count: 2
+  end
+
+  test "returns cards newest first" do
+    older_card, newer_card = with_current_user(:kevin) do
+      [
+        boards(:writebook).cards.create!(title: "Searchable older", status: :published, creator: users(:kevin)),
+        boards(:writebook).cards.create!(title: "Searchable newer", status: :published, creator: users(:kevin))
+      ]
+    end
+    older_card.update_column :created_at, 2.days.ago
+    newer_card.update_column :created_at, 1.day.ago
+
+    get search_path, params: { q: "Searchable" }
+
+    assert_response :success
+    titles = css_select("[data-search-result] a.font-weight-black").map { |title| title.text.squish }
+    assert_equal 2, titles.length
+
+    newer_position = titles.index { |title| title.include?("Searchable newer") }
+    older_position = titles.index { |title| title.include?("Searchable older") }
+    assert_operator newer_position, :<, older_position
+  end
+
+  test "does not return drafts" do
+    boards(:writebook).cards.create!(title: "Searchable draft", status: :drafted, creator: users(:kevin))
+
+    get search_path, params: { q: "Searchable draft" }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "does not return cards from inaccessible boards" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Searchable secret", status: :published, creator: users(:kevin))
+    end
+    boards(:private).accesses.revoke_from users(:kevin)
+    logout_and_sign_in_as :jz
+
+    get search_path, params: { q: "Searchable secret" }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "blank searches show the search page" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?]", search_path
+    assert_select "[data-search-result]", count: 0
+  end
+end
