+++ b/app/views/search/_result.html.erb
@@ -0,0 +1,20 @@
+<article id="<%= dom_id(card, :search_result) %>" class="panel margin-block-end txt-align-start" data-search-result>
+  <header class="flex align-center gap-half margin-block-end-half">
+    <%= link_to card_path(card), class: "font-weight-black txt-x-large", data: { turbo_frame: "_top" } do %>
+      <span class="txt-tinted">#<%= card.number %></span>
+      <%= highlight(card.title, query) %>
+    <% end %>
+  </header>
+
+  <div class="txt-small txt-tinted margin-block-end-half">
+    <%= link_to card.board.name, board_path(card), data: { turbo_frame: "_top" } %>
+  </div>
+
+  <% if description = search_result_excerpt(card.description, query) %>
+    <p class="margin-block-end-half"><%= description %></p>
+  <% end %>
+
+  <% search_result_comment_excerpts(card, query).each do |comment| %>
+    <p class="txt-small txt-tinted margin-block-end-half"><%= comment %></p>
+  <% end %>
+</article>
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..da08995
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,26 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel panel--wide center margin-block-start-half">
+  <%= form_with url: search_path, method: :get, class: "flex gap", role: "search" do %>
+    <%= search_field_tag :q, @query, placeholder: "Search cards…", class: "input flex-1", autofocus: true, autocorrect: "off" %>
+    <%= submit_tag "Search", class: "btn btn--positive" %>
+  <% end %>
+</div>
+
+<% if @query.present? %>
+  <%= tag.div class: "search-results center margin-block" do %>
+    <% if @page.records.any? %>
+      <%= with_manual_pagination :search_results, @page do %>
+        <%= render partial: "search/result", collection: @page.records, as: :card, locals: { query: @query } %>
+      <% end %>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% end %>
+<% else %>
+  <p class="margin-block center txt-align-center">Search cards by title, description, or comment.</p>
+<% end %>
