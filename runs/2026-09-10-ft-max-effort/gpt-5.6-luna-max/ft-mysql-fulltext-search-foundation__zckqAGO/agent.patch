index 0000000..a40ff50
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles, descriptions, and comments" do
+    title_card = cards(:buy_domain)
+    description_card = cards(:layout)
+    comment_card = cards(:text)
+
+    with_current_user do
+      title_card.update!(title: "A searchable title")
+      description_card.update!(description: "<p>A searchable description</p>")
+      comment_card.comments.create!(body: "<p>A searchable comment</p>", creator: users(:kevin), account: accounts("37s"))
+    end
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_select "article.search-result", count: 3
+    assert_select "mark", text: "searchable", minimum: 3
+    assert_select "h3", text: /A searchable title/
+    assert_select "p", text: /A searchable description/
+    assert_select "p", text: /A searchable comment/
+  end
+
+  test "returns newest cards first" do
+    older = cards(:buy_domain)
+    newer = cards(:layout)
+
+    with_current_user do
+      older.update!(title: "Search order older", created_at: 2.days.ago)
+      newer.update!(title: "Search order newer", created_at: 1.day.ago)
+    end
+
+    get search_path(q: "Search order")
+
+    assert_response :success
+    first_result = response.body.index(%(<article class="search-result))
+    assert_operator response.body.index("newer", first_result), :<, response.body.index("older", first_result)
+  end
+
+  test "only returns cards from boards the current user can access" do
+    private_card = nil
+    with_current_user do
+      private_card = boards(:private).cards.create!(
+        title: "Private searchable card",
+        creator: users(:kevin),
+        account: accounts("37s"),
+        status: :published
+      )
+    end
+
+    get search_path(q: "Private searchable")
+    assert_response :success
+    assert_select "h3", text: /Private searchable card/
+
+    logout_and_sign_in_as :jz
+    get search_path(q: "Private searchable")
+    assert_response :success
+    assert_not_includes response.body, private_card.title
+  end
+
+  test "excludes draft cards and their comments" do
+    draft = nil
+    with_current_user do
+      draft = boards(:writebook).cards.create!(
+        title: "Draft searchable card",
+        creator: users(:kevin),
+        account: accounts("37s"),
+        status: :published
+      )
+      draft.comments.create!(body: "<p>Draft searchable comment</p>", creator: users(:kevin), account: accounts("37s"))
+      draft.update!(status: :drafted)
+    end
+
+    get search_path(q: "Draft searchable")
+
+    assert_response :success
+    assert_not_includes response.body, "Draft searchable card"
+    assert_not_includes response.body, "Draft searchable comment"
+  end
+
+  test "escapes highlighted search content" do
+    with_current_user do
+      cards(:buy_domain).update!(title: "<script>safe searchable</script>")
+    end
+
+    get search_path(q: "searchable")
+
+    assert_response :success
+    assert_select "mark", text: "searchable"
+    assert_not_includes response.body, "<script>safe"
+  end
+
+  private
+    def with_current_user(user = users(:kevin), &block)
+      Current.set(user: user, account: user.account, &block)
+    end
+end
