@@ -0,0 +1,18 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from search_cards
+  end
+
+  private
+    def search_cards
+      if @query.present?
+        Current.user.accessible_cards.published
+          .matching(@query)
+          .reverse_chronologically
+          .includes(:board, :rich_text_description, comments: [ :creator, :rich_text_body ])
+      else
+        Card.none
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
