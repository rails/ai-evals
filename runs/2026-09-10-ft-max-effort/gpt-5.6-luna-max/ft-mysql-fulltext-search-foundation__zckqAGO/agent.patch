--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,26 @@
+module SearchHelper
+  def search_result_matches(card, query)
+    matches = []
+    description = card.description.to_plain_text
+
+    matches << { label: "Description", text: description } if search_text_matches?(description, query)
+
+    card.comments.each do |comment|
+      body = comment.body.to_plain_text
+      if search_text_matches?(body, query)
+        matches << { label: "#{comment.creator.name}'s comment", text: body }
+      end
+    end
+
+    matches
+  end
+
+  def search_result_excerpt(text, query)
+    excerpt(text, query, radius: 120) || text.truncate(240)
+  end
+
+  private
+    def search_text_matches?(text, query)
+      text.downcase.include?(query.downcase)
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..e195344 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -21,6 +21,31 @@ class Card < ApplicationRecord
 
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
+  scope :matching, ->(term) do
+    search_term = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+
+    where(<<~SQL.squish, term: search_term)
+      LOWER(cards.title) LIKE LOWER(:term)
+      OR EXISTS (
+        SELECT 1
+        FROM action_text_rich_texts
+        WHERE action_text_rich_texts.record_type = 'Card'
+          AND action_text_rich_texts.name = 'description'
+          AND action_text_rich_texts.record_id = cards.id
+          AND LOWER(action_text_rich_texts.body) LIKE LOWER(:term)
+      )
+      OR EXISTS (
+        SELECT 1
+        FROM comments
+        INNER JOIN action_text_rich_texts AS comment_rich_texts
+          ON comment_rich_texts.record_type = 'Comment'
+          AND comment_rich_texts.name = 'body'
+          AND comment_rich_texts.record_id = comments.id
+        WHERE comments.card_id = cards.id
+          AND LOWER(comment_rich_texts.body) LIKE LOWER(:term)
+      )
+    SQL
+  end
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
   scope :preloaded,               -> { with_users.preload(:column, :tags, :steps, :closure, :goldness, :activity_spike, :image_attachment, reactions: :reacter, board: [ :entropy, :columns ], not_now: [ :user ]).with_rich_text_description_and_embeds }
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..4ae17f3
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,46 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide shadow center margin-block-start-half">
+  <%= form_with url: search_path, method: :get, class: "flex gap", data: { controller: "form" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input fill-transparent flex-item-grow", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn btn--reversed" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <h2 class="txt-large margin-block-start">Results for <%= @query %></h2>
+
+    <% if @page.used? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <div class="flex flex-column gap">
+          <% @page.records.each do |card| %>
+            <article class="search-result border-block-end pad-block-end">
+              <h3 class="txt-large margin-none">
+                <%= link_to highlight(card.title, @query), card_path(card) %>
+              </h3>
+
+              <div class="txt-small translucent">
+                <%= link_to card.board.name, board_path(card.board) %>
+              </div>
+
+              <% search_result_matches(card, @query).each do |match| %>
+                <p class="margin-block-start-half">
+                  <strong><%= match[:label] %>:</strong>
+                  <%= highlight(search_result_excerpt(match[:text], @query), @query) %>
+                </p>
+              <% end %>
+            </article>
+          <% end %>
+        </div>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards matched your search.</p>
+    <% end %>
+  <% else %>
+    <p class="txt-align-center translucent margin-block-start">Search card titles, descriptions, and comments.</p>
+  <% end %>
+</section>
