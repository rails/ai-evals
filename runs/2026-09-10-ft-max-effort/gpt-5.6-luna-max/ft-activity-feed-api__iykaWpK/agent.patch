index 0000000..9e927c1
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,49 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a paginated list of activity for the boards the current user can access.
+Activity is returned newest first as a flat JSON array.
+
+The list can be filtered by repeating `creator_ids[]` and/or `board_ids[]`.
+Activity from boards the current user cannot access is never returned.
+
+The response uses the standard API pagination headers. `X-Total-Count`
+contains the total number of matching events, and `Link` contains a
+`rel="next"` URL when another page is available.
+
+__Response:__
+
+Each event contains `id`, `action`, `created_at`, `description`,
+`particulars`, `url`, `eventable_type`, `eventable`, `board`, and `creator`.
+`eventable`, `board`, and `creator` use the same representations as the
+corresponding API resources. Card event URLs open the card. Comment event
+URLs open the card and anchor to the comment.
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David assigned JZ to \"Fizzy\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjysoy0fqs9yg0ei3hq"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/42",
+    "eventable_type": "Card",
+    "eventable": {},
+    "board": {},
+    "creator": {}
+  }
+]
+```
+
+`particulars` contains `assignee_ids` for assignment changes,
+`old_board` and `new_board` for board changes, `old_title` and `new_title`
+for title changes, and `column` for triage events. Other events return an
+empty object. Missing board, title, or column values are returned as empty
+strings.
+
+Deprecated `card_collection_changed` events are omitted. `card_title_changed`
+events are included.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..92a518b
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns the accessible activity timeline" do
+    events(:logo_published).update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } },
+      created_at: Time.current
+    )
+    events(:layout_published).update_column(:action, "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    event = @response.parsed_body.find { |activity| activity["id"] == events(:logo_published).id }
+    assert_equal %w[
+      action board created_at creator description eventable eventable_type id particulars url
+    ].sort, event.keys.sort
+    assert_equal "card_title_changed", event["action"]
+    assert_equal events(:logo_published).description_for(users(:kevin)).to_plain_text, event["description"]
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, event["particulars"])
+    assert_equal card_url(cards(:logo)), event["url"]
+    assert_equal cards(:logo).id, event.dig("eventable", "id")
+    assert_equal "Card", event["eventable_type"]
+    assert_equal boards(:writebook).id, event.dig("board", "id")
+    assert_equal users(:david).id, event.dig("creator", "id")
+
+    refute @response.parsed_body.any? { |activity| activity["action"] == "card_collection_changed" }
+    assert_equal @response.parsed_body.map { |activity| activity["created_at"] },
+      @response.parsed_body.map { |activity| activity["created_at"] }.sort.reverse
+  end
+
+  test "index includes particulars for each supported change" do
+    events(:logo_assignment_jz).update_columns(particulars: { "assignee_ids" => [ users(:jz).id ] })
+    events(:logo_published).update_columns(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "New board" } }
+    )
+    events(:layout_published).update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+    events(:buy_domain_sent_back_to_triage).update_columns(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In progress" } }
+    )
+
+    get activities_path, as: :json
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activities.fetch(events(:logo_assignment_jz).id)["particulars"])
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activities.fetch(events(:logo_published).id)["particulars"])
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activities.fetch(events(:layout_published).id)["particulars"])
+    assert_equal({ "column" => "In progress" }, activities.fetch(events(:buy_domain_sent_back_to_triage).id)["particulars"])
+    assert_equal({}, activities.fetch(events(:shipping_closed).id)["particulars"])
+  end
+
+  test "missing particulars values are represented by empty strings" do
+    events(:logo_published).update_columns(
+      action: "card_board_changed",
+      particulars: {}
+    )
+    events(:layout_published).update_columns(
+      action: "card_title_changed",
+      particulars: {}
+    )
+    events(:buy_domain_sent_back_to_triage).update_columns(
+      action: "card_triaged",
+      particulars: {}
+    )
+
+    get activities_path, as: :json
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.fetch(events(:logo_published).id)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.fetch(events(:layout_published).id)["particulars"])
+    assert_equal({ "column" => "" }, activities.fetch(events(:buy_domain_sent_back_to_triage).id)["particulars"])
+  end
+
+  test "comment activity URL points to the comment on its card" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+    activity = @response.parsed_body.find { |record| record["id"] == events(:layout_commented).id }
+
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+  end
+
+  test "filters by creator and board" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "only returns activity from boards the current user can access" do
+    logout_and_sign_in_as :jz
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "uses API pagination headers" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.where(action: Event::ACTIVITY_ACTIONS).count, @response.headers["X-Total-Count"].to_i
+  end
+end
