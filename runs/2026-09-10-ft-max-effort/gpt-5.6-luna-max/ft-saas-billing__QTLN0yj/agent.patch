+class Stripe::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    session = Account::Billing::Stripe.checkout(
+      Current.account,
+      plan_key: params[:plan] || Account::Billing::UNLIMITED_PLAN,
+      success_url: account_settings_url,
+      cancel_url: account_settings_url
+    )
+
+    redirect_to stripe_session_url(session), allow_other_host: true
+  rescue ArgumentError => error
+    redirect_to account_settings_path, alert: error.message
+  end
+
+  private
+    def stripe_session_url(session)
+      if session.respond_to?(:url)
+        session.url
+      else
+        session[:url] || session["url"]
+      end
+    end
+end
