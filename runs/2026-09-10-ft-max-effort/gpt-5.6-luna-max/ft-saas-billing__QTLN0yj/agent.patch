+require "test_helper"
+require "ostruct"
+
+class BillingSmokeTest < ActionDispatch::IntegrationTest
+  test "free accounts may draft at the card limit but cannot publish or create through the API" do
+    sign_in_as :mike
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    assert_response :redirect
