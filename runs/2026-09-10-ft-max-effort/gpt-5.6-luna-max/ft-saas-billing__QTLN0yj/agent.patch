+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <dl class="flex flex-column gap-half margin-block-half">
+      <div class="flex justify-space-between gap-half">
+        <dt>Plan</dt>
+        <dd><strong><%= @account.plan %></strong></dd>
+      </div>
+      <div class="flex justify-space-between gap-half">
+        <dt>Cards</dt>
+        <dd><%= number_with_delimiter(@account.billing_card_count) %><% if @account.card_limit %> / <%= number_with_delimiter(@account.card_limit) %><% end %></dd>
+      </div>
+      <div class="flex justify-space-between gap-half">
+        <dt>Storage</dt>
+        <dd><%= number_to_human_size(@account.bytes_used) %> / <%= number_to_human_size(@account.storage_limit) %></dd>
