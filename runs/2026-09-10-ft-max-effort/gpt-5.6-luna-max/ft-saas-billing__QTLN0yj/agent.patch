+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+      </label>
+      <div class="flex gap-half">
+        <%= form.submit "Override", class: "btn btn--link" %>
+      </div>
+    <% end %>
+    <%= button_to "Reset", saas.override_admin_account_path(@account), method: :delete, class: "btn" %>
+  </div>
+</section>
