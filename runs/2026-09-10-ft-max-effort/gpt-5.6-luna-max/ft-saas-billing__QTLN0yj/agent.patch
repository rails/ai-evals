diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..f97437d
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,60 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    card_count, bytes_used = override_values
+    if card_count.nil? && bytes_used.nil?
+      @account.errors.add(:base, "Enter a card count or bytes used")
+      render :show, status: :unprocessable_entity
+    else
+      @account.override_limits!(card_count: card_count, bytes_used: bytes_used)
+      redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+    end
+  rescue ArgumentError
+    @account.errors.add(:base, "Card count and bytes used must be non-negative numbers")
+    render :show, status: :unprocessable_entity
+  end
+
+  def reset
+    @account.reset_limit_override!
+    redirect_to saas.admin_account_path(@account), notice: "Limit override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+    end
+
+    def override_values
+      source = params[:override] || params[:account] || params
+      values = source.respond_to?(:permit) ? source.permit(:card_count, :bytes_used) : source
+      [ nonnegative_integer(values[:card_count]), nonnegative_integer(values[:bytes_used]) ]
+    end
+
+    def nonnegative_integer(value)
+      return if value.blank?
+
+      Integer(value.to_s, 10).tap do |number|
+        raise ArgumentError if number.negative?
+      end
+    end
+end
