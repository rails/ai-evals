diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..2ef20b7
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,100 @@
+class Notification::EmailBundle < ApplicationRecord
+  FREQUENCY_DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, inverse_of: :email_bundle, dependent: :nullify
+
+  scope :pending, -> { where(sent_at: nil) }
+  scope :due, ->(at = Time.current) { pending.where("ends_at <= ?", at) }
+
+  validates :frequency, inclusion: { in: FREQUENCY_DURATIONS.keys }
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_start
+
+  class << self
+    def add(notification, at: nil)
+      user = notification.user
+
+      if notification.email_bundle_id.blank?
+        user.with_lock do
+          notification.reload
+          at ||= Time.current
+          frequency = user.settings&.bundle_email_frequency
+
+          if frequency.present? && frequency != "never" && notification.email_bundle_id.blank?
+            bundle, created = find_or_create_for(user, frequency, at)
+            notification.update_columns(email_bundle_id: bundle.id)
+            bundle.deliver_later if created
+          end
+        end
+      end
+    end
+
+    def deliver_due(at: Time.current)
+      due(at).find_each { |bundle| bundle.deliver(at: at) }
+    end
+
+    private
+      def find_or_create_for(user, frequency, at)
+        previous_bundle = user.email_bundles.pending.order(starts_at: :desc).first
+
+        if previous_bundle&.open_at?(at)
+          [ previous_bundle, false ]
+        else
+          starts_at = [ at, previous_bundle&.ends_at ].compact.max
+          [ create!(
+            account: user.account,
+            user: user,
+            frequency: frequency,
+            starts_at: starts_at,
+            ends_at: starts_at + FREQUENCY_DURATIONS.fetch(frequency)
+          ), true ]
+        end
+      end
+  end
+
+  def open_at?(at = Time.current)
+    starts_at <= at && at < ends_at
+  end
+
+  def deliver_later
+    Current.with(account: account) do
+      Notification::EmailBundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+  end
+
+  def deliver(at: nil)
+    user.with_lock do
+      reload
+      at ||= Time.current
+
+      if sent_at.nil? && ends_at <= at
+        if deliverable?
+          Current.with(account: account) do
+            NotificationMailer.digest(self).deliver_now
+          end
+        end
+
+        update!(sent_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && account.active? && user.identity&.email_address.present? &&
+        user.settings&.bundle_email_frequency != "never" && notifications.exists?
+    end
+
+    def ends_after_start
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+end
