--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,19 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(created_at: :asc, id: :asc)
+
+    mail to: @user.identity.email_address, subject: digest_subject
+  end
+
+  def bundle(bundle)
+    digest(bundle)
+  end
+
+  private
+    def digest_subject
+      count = @notifications.size
+      "#{count} new Fizzy notification#{'s' unless count == 1}"
+    end
+end
