diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..d1cc1e1
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jz)
+    @user.settings.update!(bundle_email_frequency: "daily")
+  end
+
+  test "starts a window with the first notification and adds late notifications to it" do
+    starts_at = Time.zone.local(2026, 7, 10, 9)
+
+    first = travel_to starts_at do
+      create_notification(events(:text_published))
+    end
+
+    bundle = first.reload.email_bundle
+    assert_equal starts_at, bundle.starts_at
+    assert_equal starts_at + 1.day, bundle.ends_at
+
+    second = travel_to starts_at + 2.hours do
+      create_notification(events(:shipping_published))
+    end
+
+    assert_equal bundle, second.reload.email_bundle
+    assert_equal [ first, second ].map(&:id).sort, bundle.reload.notifications.pluck(:id).sort
+  end
+
+  test "opens a new window at the boundary without overlapping the previous one" do
+    starts_at = Time.zone.local(2026, 7, 10, 9)
+
+    first = travel_to starts_at do
+      create_notification(events(:text_published))
+    end
+    previous_bundle = first.reload.email_bundle
+
+    second = travel_to previous_bundle.ends_at do
+      create_notification(events(:shipping_published))
+    end
+    next_bundle = second.reload.email_bundle
+
+    assert_not_equal previous_bundle, next_bundle
+    assert_equal previous_bundle.ends_at, next_bundle.starts_at
+    assert_operator previous_bundle.ends_at, :<=, next_bundle.starts_at
+  end
+
+  test "uses the selected frequency duration" do
+  assert_equal 4.hours, Notification::EmailBundle::FREQUENCY_DURATIONS.fetch("every_few_hours")
+  assert_equal 1.day, Notification::EmailBundle::FREQUENCY_DURATIONS.fetch("daily")
+  assert_equal 1.week, Notification::EmailBundle::FREQUENCY_DURATIONS.fetch("weekly")
+end
+
+test "does not create a bundle when email bundling is off" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    notification = create_notification(events(:text_published))
+
+    assert_nil notification.reload.email_bundle
+    assert_empty @user.reload.email_bundles
+  end
+
+  test "delivers one email for a due window" do
+    starts_at = Time.zone.local(2026, 7, 10, 9)
+    notification = travel_to starts_at do
+      create_notification(events(:text_published))
+    end
+    bundle = notification.reload.email_bundle
+
+    travel_to bundle.ends_at do
+      perform_enqueued_jobs
+      bundle.reload.deliver
+    end
+
+    assert bundle.reload.sent_at.present?
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    assert_equal @user.identity.email_address, ActionMailer::Base.deliveries.first.to.first
+  end
+
+  private
+    def create_notification(source)
+      Notification.create!(
+        account: @user.account,
+        user: @user,
+        creator: source.creator,
+        source: source,
+        unread_count: 1
+      )
+    end
+end
