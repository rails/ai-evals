+    get public_board_card_path(@public_key, card, script_name: nil)
+
+    assert_response :not_found
+  end
+
+  test "published card can be viewed as JSON" do
+    card = cards(:logo)
+
+    get public_board_card_path(@public_key, card, script_name: nil), as: :json
+
+    assert_response :success
+    assert_equal card.number, @response.parsed_body["number"]
+  end
+end
