+
+    respond_to do |format|
+      format.html { redirect_to @board }
+      format.json { head :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to @board }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_board
+      @board = Current.account.boards.find(params[:board_id])
+    end
+end
