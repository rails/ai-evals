+require "test_helper"
+
+class Public::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @public_key = @board.public_key
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "anyone can view a column on a published board" do
+    get public_board_column_path(@public_key, @column, script_name: nil)
+
+    assert_response :success
+    assert_match @column.name, response.body
+    assert_match cards(:text).title, response.body
+  end
+
+  test "a column from another board is not exposed" do
+    other_board = boards(:private)
+    other_column = other_board.columns.create!(name: "Private column")
+
+    get public_board_column_path(@public_key, other_column, script_name: nil)
+
+    assert_response :not_found
+  end
+end
