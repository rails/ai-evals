diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..63fb845
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,33 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :publicly_available, -> { where.not(public_key: nil) }
+    scope :published, -> { publicly_available }
+  end
+
+  def publish
+    update!(public_key: generate_public_key) unless publicly_available?
+  end
+
+  def unpublish
+    update!(public_key: nil) if publicly_available?
+  end
+
+  def publicly_available?
+    public_key.present?
+  end
+
+  alias_method :published?, :publicly_available?
+  alias_method :public?, :publicly_available?
+
+  private
+    def generate_public_key
+      loop do
+        key = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+        break key unless self.class.exists?(public_key: key)
+      end
+    end
+end
