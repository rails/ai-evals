@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @public_key = @board.public_key
+  end
+
+  test "anyone can view a published board" do
+    get public_board_path(@public_key, script_name: nil)
+
+    assert_response :success
+    assert_match @board.name, response.body
+    assert_select "h3", text: cards(:logo).title
+  end
+
+  test "published board can be viewed as JSON" do
+    get public_board_path(@public_key, script_name: nil), as: :json
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+  end
+
+  test "unknown public keys are not found" do
+    get public_board_path("not-a-real-key", script_name: nil)
+
+    assert_response :not_found
+  end
+
+  test "unpublished boards are no longer visible" do
+    @board.unpublish
+
+    get public_board_path(@public_key, script_name: nil)
+
+    assert_response :not_found
+  end
+end
