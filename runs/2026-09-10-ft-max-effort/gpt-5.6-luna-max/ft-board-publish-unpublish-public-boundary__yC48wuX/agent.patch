@@ -0,0 +1,41 @@
+<% @page_title = @board.name %>
+<% @body_class = "contained-scrolling" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<div class="card-columns public" data-controller="navigable-list">
+  <div class="card-columns__left"></div>
+
+  <div class="card-columns__right">
+    <% @columns.each do |column| %>
+      <section class="cards is-expanded" id="<%= dom_id(column) %>">
+        <header class="cards__header">
+          <h2 class="cards__title overflow-ellipsis" style="--column-color: <%= column.color %>"><%= column.name %></h2>
+          <%= link_to public_board_column_path(@board.public_key, column, script_name: nil), class: "btn btn--circle", data: { turbo_frame: "_top" } do %>
+            <span class="for-screen-reader">Open column</span>
+            <%= icon_tag "maximize" %>
+          <% end %>
+        </header>
+
+        <div class="cards__list hide-scrollbar">
+          <%= render partial: "public/cards/card", collection: @cards_by_column[column.id], as: :card, locals: { board: @board } %>
+        </div>
+      </section>
+    <% end %>
+
+    <% if @cards_by_column[nil].present? %>
+      <section class="cards is-expanded" id="maybe">
+        <header class="cards__header">
+          <h2 class="cards__title">Maybe?</h2>
+        </header>
+        <div class="cards__list hide-scrollbar">
+          <%= render partial: "public/cards/card", collection: @cards_by_column[nil], as: :card, locals: { board: @board } %>
+        </div>
+      </section>
+    <% end %>
+  </div>
+</div>
