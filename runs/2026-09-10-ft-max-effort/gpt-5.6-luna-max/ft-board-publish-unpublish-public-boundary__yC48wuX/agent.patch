diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..4eab0ea
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  test "board JSON has no public URL by default" do
+    sign_in_as :kevin
+
+    get board_path(boards(:writebook)), as: :json
+
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "only admins can publish a board" do
+    board = boards(:writebook)
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_nil board.reload.public_key
+  end
+
+  test "published board, columns, and published cards are public" do
+    board = boards(:writebook)
+    draft = board.cards.create!(creator: users(:kevin), status: :drafted, title: "Secret draft")
+
+    sign_in_as :kevin
+    post board_publication_path(board), as: :json
+
+    assert_response :success
+    key = board.reload.public_key
+    assert key.present?
+
+    get board_path(board), as: :json
+    assert_equal public_board_url(key, script_name: nil), response.parsed_body["public_url"]
+    cookies.delete :session_token
+
+    get public_board_path(key, script_name: nil)
+    assert_response :success
+    assert_includes response.body, board.name
+    assert_includes response.body, cards(:text).title
+    assert_not_includes response.body, draft.title
+
+    column = columns(:writebook_in_progress)
+    get public_board_column_path(key, column, script_name: nil)
+    assert_response :success
+    assert_includes response.body, cards(:text).title
+
+    get public_board_card_path(key, cards(:text).number, script_name: nil)
+    assert_response :success
+    assert_includes response.body, cards(:text).title
+
+    get public_board_card_path(key, draft.number, script_name: nil)
+    assert_response :not_found
+  end
+
+  test "unpublishing removes public access" do
+    board = boards(:writebook)
+    sign_in_as :kevin
+    post board_publication_path(board), as: :json
+    key = board.reload.public_key
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :success
+    assert_nil board.reload.public_key
+
+    get public_board_path(key, script_name: nil)
+    assert_response :not_found
+  end
+end
