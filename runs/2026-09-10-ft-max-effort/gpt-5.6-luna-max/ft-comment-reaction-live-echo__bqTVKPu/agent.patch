@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  show(event) {
+    event.preventDefault()
+
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.triggerTarget.hidden = true
+
+    requestAnimationFrame(() => this.inputTarget.focus())
+  }
+
+  cancel(event) {
+    event.preventDefault()
+
+    this.formTarget.querySelector("form")?.reset()
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+  }
+
+  selectEmoji(event) {
+    event.preventDefault()
+    this.inputTarget.value = event.currentTarget.dataset.emoji
+    this.inputTarget.focus()
+  }
+
+  submitted(event) {
+    if (!event.detail.success) return
+
+    // The successful response replaces this strip with a fresh form and button.
+    // Keeping this method makes the behavior safe if a non-stream response is
+    // used by a native client or a future endpoint.
+    this.formTarget.classList.remove("reaction", "expanded")
+  }
+}
