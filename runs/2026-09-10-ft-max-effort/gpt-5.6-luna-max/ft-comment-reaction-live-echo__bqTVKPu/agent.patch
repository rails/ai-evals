new file mode 100644
index 0000000..d1e89c8
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,32 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment&.account || Current.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", inverse_of: :reactions, default: -> { Current.user }
+
+  before_validation :normalize_content
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  after_create :register_card_activity
+  after_commit :broadcast_reactions, on: %i[ create destroy ]
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  private
+    def normalize_content
+      self.content = content.to_s.strip if content
+    end
+
+    def register_card_activity
+      comment.card.touch_last_active_at
+    end
+
+    def broadcast_reactions
+      comment.broadcast_replace_later_to comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions",
+        locals: { comment: comment }
+    end
+end
