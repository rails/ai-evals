diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..e10d22f
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,54 @@
+<% reactions = comment.reactions %>
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions">
+  <div id="<%= dom_id(comment, :reactions_list) %>" class="reactions__list" aria-label="Reactions">
+    <%= render partial: "cards/comments/reactions/reaction", collection: reactions, as: :reaction %>
+  </div>
+
+  <% reaction_input_id = dom_id(comment, :reaction_content) %>
+  <div class="reaction__form" data-reactions-target="form" hidden>
+    <%= form_with model: [ comment.card, comment, Reaction.new ],
+          class: "flex align-center full-width",
+          data: { action: "turbo:submit-end->reactions#submitted" } do |form| %>
+      <%= form.label :content, for: reaction_input_id, class: "reaction__form-label", title: "Write a reaction" do %>
+        <span class="for-screen-reader">Your reaction</span>
+        <%= form.text_field :content,
+              id: reaction_input_id,
+              class: "reaction__input input",
+              maxlength: Reaction::MAX_CONTENT_LENGTH,
+              autocomplete: "off",
+              required: true,
+              data: { reactions_target: "input" } %>
+      <% end %>
+
+      <div class="reaction__menu" data-controller="dialog">
+        <button type="button" class="reaction__menu-btn btn btn--circle borderless" title="Choose an emoji" aria-haspopup="dialog" data-action="dialog#toggle">
+          <%= icon_tag "reaction" %>
+          <span class="for-screen-reader">Choose an emoji</span>
+        </button>
+
+        <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog" aria-label="Choose an emoji">
+          <div class="reaction__emoji-list" role="list">
+            <% EmojiHelper::REACTIONS.each do |emoji, description| %>
+              <button type="button" class="btn" title="<%= description %>" data-emoji="<%= emoji %>" data-action="reactions#selectEmoji dialog#close"><%= emoji %></button>
+            <% end %>
+          </div>
+        </dialog>
+      </div>
+
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction" do %>
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Add reaction</span>
+      <% end %>
+
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" title="Cancel" data-action="reactions#cancel">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-reactions-target="trigger" data-action="reactions#show" title="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+</div>
