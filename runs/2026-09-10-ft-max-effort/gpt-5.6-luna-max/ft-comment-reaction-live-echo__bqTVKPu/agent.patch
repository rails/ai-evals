+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,26 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { ownerId: String }
+  static targets = [ "delete" ]
+
+  connect() {
+    this.owned = Current.user?.id?.toString() === this.ownerIdValue
+    if (this.owned) {
+      this.element.classList.add("reaction--deleteable")
+    } else if (this.hasDeleteTarget) {
+      this.deleteTarget.remove()
+    }
+  }
+
+  toggle(event) {
+    if (!this.owned || event.target.closest("form, a")) return
+
+    if (event.type === "keydown") event.preventDefault()
+    this.element.classList.toggle("expanded")
+  }
+
+  deleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+}
