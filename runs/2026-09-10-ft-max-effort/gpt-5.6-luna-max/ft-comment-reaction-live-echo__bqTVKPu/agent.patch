diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..6df1cc4
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create renders the strip and broadcasts it to the card" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts @comment.card do
+        assert_difference -> { @comment.reactions.count }, 1 do
+          post card_comment_reactions_path(@comment.card, @comment),
+            params: { reaction: { content: "👏" } }, as: :turbo_stream
+        end
+      end
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=replace][target='#{dom_id(@comment, :reactions)}']"
+    assert_includes response.body, "reactions__trigger"
+    assert_includes response.body, "👏"
+  end
+
+  test "create accepts flat JSON params" do
+    post card_comment_reactions_path(@comment.card, @comment), params: { content: "Nice" }, as: :json
+
+    assert_response :created
+    assert_equal "Nice", @comment.reactions.last.content
+  end
+
+  test "create rejects content longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "index returns reactions as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get card_comment_reactions_path(@comment.card, @comment), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, response.parsed_body.first["id"]
+    assert_equal "👍", response.parsed_body.first["content"]
+    assert_equal "Kevin", response.parsed_body.first.dig("reacter", "name")
+  end
+
+  test "destroy broadcasts the updated strip" do
+    reaction = @comment.reactions.create!(content: "👏", reacter: users(:kevin))
+    clear_enqueued_jobs
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts @comment.card, count: 1 do
+        assert_difference -> { @comment.reactions.count }, -1 do
+          delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+        end
+      end
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=replace][target='#{dom_id(@comment, :reactions)}']"
+  end
+
+  test "destroy cannot remove another user's reaction" do
+    reaction = @comment.reactions.create!(content: "👏", reacter: users(:jz))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
