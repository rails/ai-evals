diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..ad1a5c1
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @owner = users(:jason)
+  end
+
+  test "incinerates accounts cancelled beyond the grace period" do
+    cancellation = Account::Cancellation.create!(account: @account, initiated_by: @owner)
+    cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    card = cards(:logo)
+    card.reindex
+    card.image.attach(io: StringIO.new("contents"), filename: "example.txt", content_type: "text/plain")
+    attachment = card.image.attachment
+    blob = attachment.blob
+    Storage::Entry.create!(account: @account, delta: 100, operation: "attach")
+    Storage::Total.create!(owner: @account, bytes_stored: 100)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account::Cancellation.exists?(cancellation.id)
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: @account.id)
+    assert_not Search::Record.for(@account.id).exists?(account_id: @account.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
+
+  test "does not incinerate accounts still within the grace period" do
+    cancellation = Account::Cancellation.create!(account: @account, initiated_by: @owner)
+    cancellation.update_columns(created_at: 29.days.ago, updated_at: 29.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(@account.id)
+    assert Account::Cancellation.exists?(cancellation.id)
+  end
+
+  test "incineration is due only after the grace period" do
+    cancellation = Account::Cancellation.create!(account: @account, initiated_by: @owner)
+    cancellation.update_columns(created_at: 30.days.ago + 1.minute, updated_at: 30.days.ago + 1.minute)
+
+    assert_not_includes Account.incineration_due, @account
+
+    cancellation.update_columns(created_at: 30.days.ago - 1.minute, updated_at: 30.days.ago - 1.minute)
+
+    assert_includes Account.incineration_due, @account
+  end
+end
