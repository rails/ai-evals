diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..6dac72a
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments by two people within a third of the board period create a burst" do
+    card = create_card
+
+    travel_to Time.current do
+      create_comment card, users(:david), "One"
+      create_comment card, users(:kevin), "Two"
+      create_comment card, users(:david), "Three"
+    end
+
+    assert card.reload.burst_at.present?
+    assert_not card.stalled?
+  end
+
+  test "comments by one person do not create a burst" do
+    card = create_card
+
+    3.times { |number| create_comment card, users(:david), number.to_s }
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "comments outside the board burst window do not create a burst" do
+    card = create_card
+    start = Time.current
+
+    travel_to start do
+      create_comment card, users(:david), "One"
+    end
+    travel_to start + 30.days + 1.second do
+      create_comment card, users(:kevin), "Two"
+      create_comment card, users(:david), "Three"
+    end
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    card = create_card
+
+    create_comment card, users(:david), "One"
+    create_comment card, users(:kevin), "Two"
+    card.comments.create!(creator: users(:system), body: "System activity")
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "assignment creates a burst" do
+    card = create_card
+
+    card.toggle_assignment users(:kevin)
+
+    assert card.reload.burst_at.present?
+  end
+
+  test "reopening creates a burst" do
+    card = create_card
+    card.close
+
+    card.reopen
+
+    assert card.reload.burst_at.present?
+  end
+
+  test "a burst becomes stalled after two weeks without activity" do
+    card = create_card
+    card.update_columns(burst_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "activity resets stalled status" do
+    card = create_card
+    card.update_columns(burst_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert card.reload.stalled?
+
+    card.comments.create!(creator: users(:kevin), body: "Still working")
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  private
+    def create_card
+      boards(:writebook).cards.create!(title: "Needs attention", status: :published, creator: users(:david))
+    end
+
+    def create_comment(card, creator, body)
+      card.comments.create!(creator: creator, body: body)
+    end
+end
