diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..02da1ca
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,54 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  BURST_COMMENT_WINDOW_DIVISOR = 3
+  STALLED_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      where.not(burst_at: nil)
+        .where("burst_at <= ?", Time.current)
+        .where("last_active_at <= ?", STALLED_PERIOD.ago)
+    end
+  end
+
+  def burst?
+    burst_at.present?
+  end
+  alias_method :bursted?, :burst?
+
+  def stalled?(as_of: Time.current)
+    burst? && burst_at <= as_of && last_active_at.present? && last_active_at <= as_of - STALLED_PERIOD
+  end
+
+  def record_burst(at: Time.current)
+    update_column(:burst_at, at) if burst_at.blank?
+  end
+
+  def record_burst_from_event(event)
+    record_burst if event.action.to_s.in?(%w[ card_assigned card_reopened ])
+  end
+
+  def record_burst_from_comment(comment)
+    record_burst if comment_burst?(comment)
+  end
+
+  def cache_key_with_version
+    "#{super}-#{stalled? ? "stalled" : "not-stalled"}"
+  end
+
+  private
+    def comment_burst?(comment)
+      window_start = comment.created_at - burst_comment_window
+      recent_comments = comments.by_user.where(created_at: window_start..comment.created_at)
+      authors = recent_comments.group(:creator_id).count
+
+      authors.values.sum >= BURST_COMMENT_COUNT && authors.size >= BURST_COMMENTER_COUNT
+    end
+
+    def burst_comment_window
+      board.auto_postpone_period.to_f / BURST_COMMENT_WINDOW_DIVISOR
+    end
+end
