diff --git a/lib/localized_text.rb b/lib/localized_text.rb
new file mode 100644
index 0000000..4169814
--- /dev/null
+++ b/lib/localized_text.rb
@@ -0,0 +1,123 @@
+module LocalizedText
+  module_function
+
+  def translate(text, locale: I18n.locale)
+    return text unless locale.to_s == "ja"
+    return text if text.match?(/[ぁ-んァ-ヶ一-龯]/)
+
+    leading = text[/\A\s*/].to_s
+    trailing = text[/\s*\z/].to_s
+    value = text.strip
+    translated = translation_for(value) || translate_dynamic(value) || value
+
+    "#{leading}#{translated}#{trailing}"
+  end
+
+  def translation_for(text)
+    key = text.parameterize(separator: "_")
+    return nil if key.blank?
+
+    translation = I18n.t("ui.#{key}", locale: :ja, default: nil)
+    translation if translation.is_a?(String) && translation != "ui.#{key}"
+  rescue I18n::MissingInterpolationArgument
+    nil
+  end
+
+  def translate_dynamic(text)
+    case text
+    when "Completed by"
+      "完了者："
+    when "Updated"
+      "更新済み"
+    when "Just a sec while we sign you in with"
+      "サインインしています："
+    when "The code sent to"
+      "次のアドレスに送信したコード："
+    when "Need help?"
+      "お困りですか？"
+    when "Send us an email"
+      "メールで問い合わせる"
+    when "RE:"
+      "返信："
+    when "Ensure notifications are allowed for"
+      "通知を許可："
+    when "in your system settings."
+      "のシステム設定で許可してください。"
+    when "used with the Fizzy developer API."
+      "Fizzy開発者APIで使用"
+    when "When push notifications aren’t working, this can usually be fixed by checking your notification settings to make sure they’re allowed."
+      "プッシュ通知が機能しない場合は、通知設定を確認して許可されていることを確認すると解決できます。"
+    when "Copy auto-login link"
+      "自動ログインリンクをコピー"
+    when "Display auto-login QR code"
+      "自動ログイン用QRコードを表示"
+    when /\ADownload (.+)\z/
+      "ダウンロード：#{Regexp.last_match(1)}"
+    when /\ASave changes \((.+)\)\z/
+      "変更を保存（#{Regexp.last_match(1)}）"
+    when /\APost this comment \((.+)\)\z/
+      "このコメントを投稿（#{Regexp.last_match(1)}）"
+    when /\ACreate card \((.+)\)\z/
+      "カードを作成（#{Regexp.last_match(1)}）"
+    when /\ACreate and add another \((.+)\)\z/
+      "作成してもう1つ追加（#{Regexp.last_match(1)}）"
+    when "My profile", "Profile", "profile"
+      "プロフィール"
+    when "Account Settings"
+      "アカウント設定"
+    when "Add people"
+      "メンバーを追加"
+    when "Start export"
+      "エクスポートを開始"
+    when "Personal access tokens"
+      "個人アクセストークン"
+    when "Passkeys"
+      "パスキー"
+    when /\ARole: (Administrator|Member|Owner)\z/
+      roles = { "Administrator" => "管理者", "Member" => "メンバー", "Owner" => "オーナー" }
+      "役割：#{roles.fetch(Regexp.last_match(1))}"
+    when /\ARemove (.+) from the account\z/
+      "#{Regexp.last_match(1)}をアカウントから削除"
+    when /\AScan this code to join (.+):\z/
+      "#{Regexp.last_match(1)}に参加するにはこのコードをスキャンしてください："
+    when /\AThis code has been used (\d+)\/(\d+) times \((\d+) remaining\)\z/
+      "このコードは#{Regexp.last_match(1)}/#{Regexp.last_match(2)}回使用されています（残り#{Regexp.last_match(3)}回）"
+    when /\AColumn: (.+)\z/
+      "列：#{Regexp.last_match(1)}"
+    when /\AGo to (.+)\z/
+      "#{Regexp.last_match(1)}へ移動"
+    when /\ABack to (.+)\z/
+      I18n.t("ui.back_to", locale: :ja, label: translate(Regexp.last_match(1)), default: "%{label}に戻る")
+    when /\ASettings for (.+)\z/
+      I18n.t("ui.settings_for", locale: :ja, label: translate(Regexp.last_match(1)), default: "%{label}の設定")
+    when /\AShow (\d+) more watchers\z/
+      I18n.t("ui.show_more_watchers", locale: :ja, count: Regexp.last_match(1), default: "さらに%{count}人のウォッチャーを表示")
+    when /\A(\d+) subscribers?\z/
+      I18n.t("ui.subscribers", locale: :ja, count: Regexp.last_match(1), default: "%{count}人の購読者")
+    when /\AProfile avatar for (.+)\z/
+      "#{Regexp.last_match(1)}のプロフィールアバター"
+    when /\AWhich cards are assigned to (.+)\?\z/
+      person = Regexp.last_match(1) == "me" ? "自分" : Regexp.last_match(1)
+      "#{person}に割り当てられているカード"
+    when /\AWhich cards were added by (.+)\?\z/
+      person = Regexp.last_match(1) == "me" ? "自分" : Regexp.last_match(1)
+      "#{person}が追加したカード"
+    when "Moves to “Not Now”"
+      "「今はしない」に移動"
+    when "if there’s no activity."
+      "活動がない場合。"
+    when "Passkey registration was cancelled. Try again when you are ready."
+      "パスキーの登録がキャンセルされました。準備ができたらもう一度お試しください。"
+    when "Something went wrong while registering your passkey."
+      "パスキーの登録中に問題が発生しました。"
+    when "You already have a passkey registered on this device. Remove the existing one first and try again."
+      "このデバイスにはすでにパスキーが登録されています。既存のパスキーを削除してからもう一度お試しください。"
+    when "Your browser will prompt you to create a passkey using your device's biometrics, PIN, or security key"
+      "ブラウザーに、デバイスの生体認証、PIN、またはセキュリティキーを使ってパスキーを作成するよう求められます。"
+    when /\AEnsure notifications are allowed for (.+) in your system settings\.\z/
+      "#{Regexp.last_match(1)}のシステム設定で通知が許可されていることを確認してください。"
+    when /\AManage (.+) used with the Fizzy developer API\.\z/
+      "Fizzy開発者APIで使用する#{Regexp.last_match(1)}を管理"
+    end
+  end
+end
