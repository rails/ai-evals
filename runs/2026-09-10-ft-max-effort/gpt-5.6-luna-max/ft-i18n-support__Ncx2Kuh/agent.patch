diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..0964819
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "a supported query locale is used for the page and remembered" do
+    untenanted do
+      get new_session_path(locale: "ja")
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "Fizzyにログイン"
+    assert_equal "ja", cookies[:locale]
+  end
+
+  test "an unsupported query locale does not change the current locale" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      get new_session_path(locale: "xx")
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "Fizzyにログイン"
+  end
+
+  test "a locale selected before sign-in is saved to the identity" do
+    identity = identities(:jz)
+
+    untenanted do
+      get new_session_path(locale: "ja")
+    end
+
+    sign_in_as identity
+    assert_equal "ja", identity.reload.locale
+
+    cookies.delete :locale
+    cookies.delete :session_token
+    cookies.delete :_fizzy_session
+
+    sign_in_as identity
+    get new_session_path
+    assert_redirected_to root_url
+
+    get root_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "English remains the default when no locale was selected" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_includes response.body, "Get into Fizzy"
+    assert_not_includes response.body, "Fizzyにログイン"
+  end
+
+  private
+    def untenanted(&block)
+      original_script_name = integration_session.default_url_options[:script_name]
+      integration_session.default_url_options[:script_name] = ""
+      yield
+    ensure
+      integration_session.default_url_options[:script_name] = original_script_name
+    end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..53d06a5
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  test "a Japanese identity receives Japanese magic-link mail" do
+    identity = identities(:jz)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.new(identity: identity, code: "ABC123", expires_at: 15.minutes.from_now)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyの確認コードはABC123です", email.subject
+    assert_includes email.text_part.body.decoded, "確認コード"
+    assert_includes email.html_part.body.decoded, "lang=\"ja\""
+    assert_not_includes email.text_part.body.decoded, "Please enter"
+  end
+end
