diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..60c50bb
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,104 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[ en ja ].freeze
+  DEFAULT_LOCALE = "en".freeze
+  LOCALE_COOKIE = :locale
+
+  def self.supported_locale?(locale)
+    SUPPORTED_LOCALES.include?(locale.to_s)
+  end
+
+  included do
+    prepend_around_action :with_locale
+    helper_method :current_locale
+  end
+
+  class_methods do
+    def supported_locale?(locale)
+      SUPPORTED_LOCALES.include?(locale.to_s)
+    end
+  end
+
+  private
+    def with_locale(&)
+      requested_locale = locale_from_param
+      remember_locale(requested_locale) if requested_locale
+
+      I18n.with_locale(locale_for_request) do
+        yield
+      end
+    end
+
+    def current_locale
+      I18n.locale.to_s
+    end
+def localized_message(key, default:, **options)
+  I18n.t("messages.#{key}", default: default, **options)
+end
+
+
+    def locale_from_param
+      locale = params[:locale].to_s
+      self.class.supported_locale?(locale) ? locale : nil
+    end
+
+    def locale_for_request
+      locale_from_param || locale_from_authenticated_identity || session_locale || cookie_locale || DEFAULT_LOCALE
+    end
+
+    def locale_from_authenticated_identity
+      Current.identity&.locale.presence || identity_from_session_cookie&.locale.presence
+    end
+
+    def session_locale
+      locale = session[:locale].to_s
+      self.class.supported_locale?(locale) ? locale : nil
+    end
+
+    def cookie_locale
+      locale = cookies[LOCALE_COOKIE].to_s
+      self.class.supported_locale?(locale) ? locale : nil
+    end
+
+    def identity_from_session_cookie
+      if (session_record = Session.find_signed(cookies.signed[:session_token]))
+        session_record.identity
+      end
+    rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def remember_locale(locale)
+      if locale
+        session[:locale] = locale
+        cookies.permanent[LOCALE_COOKIE] = {
+          value: locale,
+          httponly: true,
+          same_site: :lax
+        }
+
+        identity = Current.identity || identity_from_session_cookie
+        identity.update!(locale: locale) if identity && identity.locale != locale
+      end
+    end
+
+    def remember_locale_for(identity)
+      locale = locale_from_param || session_locale || cookie_locale
+
+      if locale
+        identity.update!(locale: locale) if identity.locale != locale
+        cookies.permanent[LOCALE_COOKIE] = {
+          value: locale,
+          httponly: true,
+          same_site: :lax
+        }
+      elsif identity.locale
+        cookies.permanent[LOCALE_COOKIE] = {
+          value: identity.locale,
+          httponly: true,
+          same_site: :lax
+        }
+      end
+    end
+end
diff --git a/app/controllers/concerns/localized_responses.rb b/app/controllers/concerns/localized_responses.rb
new file mode 100644
index 0000000..a7a116e
--- /dev/null
+++ b/app/controllers/concerns/localized_responses.rb
@@ -0,0 +1,64 @@
+require "nokogiri"
+
+module LocalizedResponses
+  extend ActiveSupport::Concern
+
+  included do
+    after_action :localize_html_response
+  end
+
+  module_function
+
+  def localize_html(body)
+    document = if body.lstrip.downcase.start_with?("<!doctype", "<html")
+      Nokogiri::HTML5.parse(body)
+    else
+      Nokogiri::HTML5.fragment(body)
+    end
+
+    document.traverse do |node|
+      if node.text? && translatable_text_node?(node)
+        node.content = LocalizedText.translate(node.text)
+      end
+    end
+
+    document.traverse do |node|
+      if node.element? && node.name != "lexxy-editor" && node.ancestors.none? { |ancestor| ancestor.element? && ancestor.name == "lexxy-editor" }
+        %w[ aria-label aria-description title alt placeholder data-bridge-title data-turbo-confirm data-turbo-submits-with data-validation-message ].each do |attribute|
+          if (value = node[attribute]).present?
+            node[attribute] = LocalizedText.translate(value)
+          end
+        end
+      end
+    end
+
+    document.to_html
+  end
+
+  def translatable_text_node?(node)
+    return false if node.text.strip.empty?
+
+    node.ancestors.none? do |ancestor|
+      ancestor.element? && (
+        ancestor.name.in?(%w[ script style code pre textarea lexxy-editor action-text-attachment ]) ||
+        ancestor["contenteditable"] == "true" ||
+        ancestor["class"].to_s.split.include?("card__title") ||
+        ancestor["class"].to_s.split.include?("user-content") ||
+        ancestor["class"].to_s.split.include?("lexxy-content") ||
+        ancestor["class"].to_s.split.include?("notification__details")
+      )
+    end
+  end
+
+  private
+    def localize_html_response
+      if I18n.locale.to_s == "ja" && localizable_response?
+        body = response.body.is_a?(Array) ? response.body.join : response.body.to_s
+        response.body = LocalizedResponses.localize_html(body)
+      end
+    end
+
+    def localizable_response?
+      response.media_type.to_s.start_with?("text/html", "text/vnd.turbo-stream")
+    end
+end
