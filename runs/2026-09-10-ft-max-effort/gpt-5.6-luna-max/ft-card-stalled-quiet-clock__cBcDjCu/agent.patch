diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..ba14f9a
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,37 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(burst_at: nil).where(last_active_at: ..(STALLED_AFTER.ago)) }
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?(as_of: Time.current)
+    active? && burst? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def register_comment_activity(comment)
+    attributes = { last_active_at: Time.current }
+    attributes[:burst_at] = Time.current if comment_burst?(comment)
+    update! attributes
+  end
+
+  private
+    def comment_burst?(comment)
+      recent_comments = comments.by_user.where(created_at: (comment.created_at - burst_window)..comment.created_at)
+
+      recent_comments.count >= BURST_COMMENT_COUNT &&
+        recent_comments.distinct.count(:creator_id) >= BURST_COMMENTER_COUNT
+    end
+
+    def burst_window
+      auto_postpone_period / 3
+    end
+end
