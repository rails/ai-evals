diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..94ebc2b
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people within a third of the auto-close period create a burst" do
+    card = new_card
+    now = Time.current
+
+    card.comments.create! creator: users(:david), created_at: now - 2.days, body: "First"
+    card.comments.create! creator: users(:david), created_at: now - 1.day, body: "Second"
+    assert_not card.reload.burst?
+
+    card.comments.create! creator: users(:kevin), created_at: now, body: "Third"
+
+    assert card.reload.burst?
+    assert_in_delta now, card.burst_at, 1.second
+  end
+
+  test "comments from one person do not create a burst" do
+    card = new_card
+    now = Time.current
+
+    3.times do |index|
+      card.comments.create! creator: users(:david), created_at: now - index.hours, body: "Comment #{index}"
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "comments outside a third of the auto-close period do not create a burst" do
+    board = boards(:writebook)
+    board.update! auto_postpone_period: 3.days
+    card = new_card
+    now = Time.current
+
+    card.comments.create! creator: users(:david), created_at: now - 2.days, body: "First"
+    card.comments.create! creator: users(:kevin), created_at: now - 1.5.days, body: "Second"
+    card.comments.create! creator: users(:david), created_at: now, body: "Third"
+
+    assert_not card.reload.burst?
+  end
+
+  test "system comments do not create a burst" do
+    card = new_card
+    system_user = card.account.system_user
+
+    3.times do |index|
+      card.comments.create! creator: system_user, created_at: index.hours.ago, body: "System comment #{index}"
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "a card without a burst is not stalled" do
+    card = new_card
+    card.update_column :last_active_at, 3.weeks.ago
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "closed and postponed cards are not stalled" do
+    closed_card = new_card
+    closed_card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    closed_card.close
+    closed_card.update_column :last_active_at, 3.weeks.ago
+
+    postponed_card = new_card
+    postponed_card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    postponed_card.postpone
+    postponed_card.update_column :last_active_at, 3.weeks.ago
+
+    assert_not closed_card.reload.stalled?
+    assert_not postponed_card.reload.stalled?
+    assert_not_includes Card.stalled, closed_card
+    assert_not_includes Card.stalled, postponed_card
+  end
+
+  test "assignment creates a burst" do
+    card = new_card
+
+    with_current_user(:david) do
+      card.toggle_assignment users(:kevin)
+    end
+
+    assert card.reload.burst?
+  end
+
+  test "reopening creates a burst" do
+    card = cards(:shipping)
+
+    card.reopen
+
+    assert card.reload.burst?
+  end
+
+  test "a burst becomes stalled after two weeks without activity" do
+    card = new_card
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+    assert_includes users(:david).filters.new(indexed_by: "stalled").cards, card
+  end
+
+  test "activity resets stalled status" do
+    card = new_card
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    assert card.reload.stalled?
+
+    card.touch_last_active_at
+
+    assert_not card.reload.stalled?
+    assert_not_includes users(:david).filters.new(indexed_by: "stalled").cards, card
+  end
+
+  private
+    def new_card
+      boards(:writebook).cards.create!(creator: users(:david), title: "Burst test", status: :published)
+    end
+end
