+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "requires content and limits it to sixteen characters" do
+    reaction = Reaction.new(comment: comments(:logo_agreement_kevin), user: users(:kevin))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+
+    reaction.content = "a" * (Reaction::MAX_CONTENT_LENGTH + 1)
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "strips content before validating" do
+    reaction = Reaction.new(comment: comments(:logo_agreement_kevin), user: users(:kevin), content: "  👍  ")
+
+    assert reaction.valid?
+    assert_equal "👍", reaction.content
+  end
+
+  test "emoji content is identified" do
+    assert Reaction.new(content: "❤️").emoji?
+    assert_not Reaction.new(content: "Sounds good").emoji?
+  end
+end
+
+class ReactionBroadcastTest < ActiveSupport::TestCase
+  test "refreshes the card stream after a reaction is created" do
+    comment = comments(:logo_agreement_kevin)
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts(comment.card, count: 1) do
+        comment.reactions.create!(content: "👍", user: users(:kevin))
+      end
+    end
+  end
+end
