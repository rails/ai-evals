diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..2e27b44
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,41 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+  EMOJI_ONLY = /\A[\p{Extended_Pictographic}\p{Emoji_Presentation}\p{Emoji_Modifier}\p{Regional_Indicator}\uFE0F\u200D\u20E3]+\z/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :user, default: -> { Current.user }
+
+  alias_attribute :body, :content
+
+  scope :chronologically, -> { order(created_at: :asc, id: :desc) }
+
+  before_validation :strip_content
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  def emoji?
+    content.present? && content.match?(EMOJI_ONLY)
+  end
+
+  def creator
+    user
+  end
+
+  def creator=(value)
+    self.user = value
+  end
+
+  def creator_id
+    user_id
+  end
+
+  def creator_id=(value)
+    self.user_id = value
+  end
+
+  private
+    def strip_content
+      self.content = content.strip if content
+    end
+end
