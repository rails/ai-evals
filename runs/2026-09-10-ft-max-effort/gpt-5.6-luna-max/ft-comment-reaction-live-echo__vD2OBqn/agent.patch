diff --git a/app/views/cards/comments/_reaction.html.erb b/app/views/cards/comments/_reaction.html.erb
new file mode 100644
index 0000000..d27d57e
--- /dev/null
+++ b/app/views/cards/comments/_reaction.html.erb
@@ -0,0 +1,25 @@
+<% can_delete = reaction.user_id == Current.user.id %>
+<%= tag.div id: dom_id(reaction),
+      class: class_names("reaction", "reaction--deleteable": can_delete),
+      data: { reaction_user_id: reaction.user_id, action: ("click->reactions#toggleReaction keydown.enter->reactions#toggleReaction keydown.space->reactions#toggleReaction" if can_delete) },
+      role: ("button" if can_delete),
+      tabindex: (0 if can_delete),
+      aria: { expanded: (false if can_delete), label: "#{reaction.user.name} reacted with #{reaction.content}" },
+      title: reaction.user.name do %>
+  <span class="reaction__avatar" aria-hidden="true">
+    <%= avatar_preview_tag reaction.user, hidden_for_screen_reader: true %>
+  </span>
+
+  <span class="<%= class_names("txt-small", "txt-medium": reaction.emoji?) %>"><%= reaction.content %></span>
+
+  <% if can_delete %>
+    <%= button_to card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction),
+          method: :delete,
+          class: "reaction__delete btn btn--circle borderless",
+          aria: { label: "Remove your reaction" },
+          data: { action: "click->reactions#remove" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Remove your reaction</span>
+    <% end %>
+  <% end %>
+<% end %>
diff --git a/app/views/cards/comments/_reaction_form.html.erb b/app/views/cards/comments/_reaction_form.html.erb
new file mode 100644
index 0000000..abb973a
--- /dev/null
+++ b/app/views/cards/comments/_reaction_form.html.erb
@@ -0,0 +1,63 @@
+<%= form_with scope: :reaction,
+      url: card_comment_reactions_path(comment.card, comment),
+      class: "reaction__form flex align-center",
+      data: { reactions_target: "form" } do |form| %>
+  <%= button_tag type: :button,
+        class: "reactions__trigger reaction__form-label btn btn--circle",
+        data: { reactions_target: "trigger", action: "reactions#open" },
+        aria: { label: "Add a reaction" } do %>
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  <% end %>
+
+  <span class="reaction__controls flex align-center gap-half" data-reactions-target="controls" hidden>
+    <%= form.text_field :content,
+          class: "input reaction__input",
+          maxlength: Reaction::MAX_CONTENT_LENGTH,
+          minlength: 1,
+          required: true,
+          size: Reaction::MAX_CONTENT_LENGTH,
+          value: "",
+          id: dom_id(comment, :reaction_content),
+          autocomplete: "off",
+          placeholder: "React…",
+          aria: { label: "Reaction" },
+          data: { reactions_target: "input" } %>
+
+    <span class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+      <%= button_tag type: :button,
+            class: "reaction__menu-btn btn btn--circle borderless",
+            data: { action: "dialog#toggle:stop" },
+            aria: { label: "Choose an emoji" } do %>
+        <%= icon_tag "reaction" %>
+      <% end %>
+
+      <%= tag.dialog class: "reaction__popup popup panel", data: { dialog_target: "dialog" }, aria: { label: "Choose an emoji" } do %>
+        <span class="reaction__emoji-list">
+          <% reaction_emojis.each do |emoji| %>
+            <%= button_tag emoji,
+                  type: :button,
+                  class: "btn btn--circle",
+                  data: { action: "reactions#chooseEmoji", reaction_value: emoji },
+                  aria: { label: "React with #{emoji}" } %>
+          <% end %>
+        </span>
+      <% end %>
+    </span>
+
+    <%= form.button type: :submit,
+          class: "reaction__submit-btn btn btn--circle borderless",
+          aria: { label: "Confirm reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+
+    <%= button_tag type: :button,
+          class: "reaction__cancel-btn btn btn--circle borderless",
+          data: { action: "reactions#cancel" },
+          aria: { label: "Cancel reaction" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    <% end %>
+  </span>
+<% end %>
