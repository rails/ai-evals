diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..858aaba
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,48 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content body ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :set_reaction, :ensure_reaction_ownership, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_reaction_ownership
+      head :forbidden unless @reaction.user == Current.user
+    end
+
+    def reaction_params
+      permitted = params.expect(reaction: [ :content, :body ])
+      { content: permitted[:content].presence || permitted[:body] }
+    end
+end
