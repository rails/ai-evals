diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..c5021b5
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,79 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "trigger", "controls", "input" ]
+
+  connect() {
+    this.syncOwnReactions()
+  }
+
+  open(event) {
+    event.preventDefault()
+
+    this.formTarget.classList.add("reaction", "expanded")
+    this.triggerTarget.hidden = true
+    this.controlsTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event.preventDefault()
+
+    this.resetForm()
+  }
+
+  chooseEmoji(event) {
+    event.preventDefault()
+
+    this.inputTarget.value = event.currentTarget.dataset.reactionValue
+    event.currentTarget.closest("dialog")?.close()
+    this.formTarget.requestSubmit()
+  }
+
+  toggleReaction(event) {
+    const reaction = event.currentTarget
+    if (!reaction.classList.contains("reaction--deleteable")) return
+
+    if (event.type === "keydown") {
+      if (![ "Enter", " " ].includes(event.key)) return
+
+      event.preventDefault()
+    }
+
+    reaction.classList.toggle("expanded")
+    reaction.setAttribute("aria-expanded", reaction.classList.contains("expanded"))
+  }
+
+  remove(event) {
+    event.stopPropagation()
+    event.currentTarget.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+
+  syncOwnReactions() {
+    const currentUserId = document.querySelector('meta[name="current-user-id"]')?.content
+    if (!currentUserId) return
+
+    this.element.querySelectorAll(".reaction[data-reaction-user-id]").forEach(reaction => {
+      const ownReaction = reaction.dataset.reactionUserId === currentUserId
+
+      reaction.classList.toggle("reaction--deleteable", ownReaction)
+      if (ownReaction) {
+        reaction.setAttribute("tabindex", "0")
+        reaction.setAttribute("role", "button")
+        reaction.setAttribute("aria-expanded", reaction.classList.contains("expanded"))
+      } else {
+        reaction.removeAttribute("tabindex")
+        reaction.removeAttribute("role")
+        reaction.removeAttribute("aria-expanded")
+      }
+    })
+  }
+
+  resetForm() {
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.controlsTarget.hidden = true
+    this.element.querySelectorAll("dialog[open]").forEach(dialog => dialog.close())
+    this.formTarget.reset()
+  }
+}
