+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "add and remove a reaction" do
+    visit card_url(@comment.card)
+
+    within("##{dom_id(@comment, :reactions)}") do
+      click_button "Add a reaction"
+      assert_selector "input.reaction__input", visible: true
+      find("input.reaction__input", visible: true).fill_in with: "Nice work"
+      click_button "Confirm reaction"
+    end
+
+    within("##{dom_id(@comment, :reactions)}") do
+      assert_selector ".reaction", text: "Nice work"
+      click_button "Add a reaction"
+      assert_equal "", find("input.reaction__input", visible: true).value
+      click_button "Cancel reaction"
+      assert_selector "button[aria-label='Add a reaction']"
+      find(".reaction--deleteable").click
+      assert_selector ".reaction__delete", visible: true
+      find(".reaction__delete").click
+    end
+
+    assert_no_selector "##{dom_id(@comment, :reactions)} .reaction", text: "Nice work"
+  end
+end
+
+class ReactionsLiveUpdateTest < ApplicationSystemTestCase
+  test "a reaction added elsewhere appears without a reload" do
+    comment = comments(:logo_agreement_kevin)
+    sign_in_as(users(:david))
+    visit card_url(comment.card)
+
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    comment.reactions.create!(content: "Live now", user: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "##{dom_id(comment, :reactions)} .reaction", text: "Live now", wait: 5
+  end
+end
