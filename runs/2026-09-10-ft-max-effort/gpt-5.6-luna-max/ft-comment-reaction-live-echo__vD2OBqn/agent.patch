+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create as turbo stream" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions)
+    assert_includes @response.body, "👍"
+    assert_includes @response.body, "boost-color-"
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { content: "Looks good" }, as: :json
+    end
+
+    reaction = Reaction.last
+    assert_response :created
+    assert_equal card_comment_reaction_path(comment.card, comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal "Looks good", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("user", "id")
+  end
+
+  test "cannot react to a draft card" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+    original_status = card.status
+    card.update_column(:status, "drafted")
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  ensure
+    card&.update_column(:status, original_status)
+  end
+
+  test "destroy own reaction" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", user: users(:kevin))
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions)
+  end
+
+  test "cannot destroy another user's reaction" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", user: users(:jz))
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
