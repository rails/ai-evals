+
+  layout "public"
+
+  def new
+    if @email_code = pending_email_code(purpose: :sign_in)
+      @email_address = @email_code.email_address
+    else
+      redirect_to new_session_path
+    end
+  end
+
+  def create
+    @email_code = pending_email_code(purpose: :sign_in)
+
+    if @email_code && (identity = Identity.find_by(email_address: @email_code.email_address)) && consume_email_code(purpose: :sign_in, code: code)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def code
+      params.expect(:code)
+    end
+
+    def invalid_code
+      message = "That code is invalid or expired. Try again."
+
+      respond_to do |format|
+        format.html do
+          @email_address = @email_code&.email_address
+          flash.now[:alert] = message
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
