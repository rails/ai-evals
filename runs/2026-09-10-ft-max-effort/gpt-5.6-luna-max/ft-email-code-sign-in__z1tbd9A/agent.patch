@@ -0,0 +1,77 @@
+class JoinCodes::VerificationsController < ApplicationController
+  include EmailCodeAuthentication
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    if @email_code = pending_join_email_code
+      @email_address = @email_code.email_address
+    else
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug)
+    end
+  end
+
+  def create
+    @email_code = pending_join_email_code
+
+    if @email_code && (email_code = consume_email_code(purpose: :join, code: code))
+      identity = Identity.find_or_create_by!(email_address: email_code.email_address)
+      start_new_session_for identity
+      join_account_as identity
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def code
+      params.expect(:code)
+    end
+
+    def pending_join_email_code
+      email_code = pending_email_code(purpose: :join)
+      email_code if email_code && pending_email_code_context[:join_code] == @join_code.code
+    end
+
+    def set_join_code
+      @join_code = Account::JoinCode.find_by(code: params.expect(:join_code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+
+    def join_account_as(identity)
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      if user.setup?
+        redirect_to landing_url(script_name: @join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+      end
+    end
+
+    def invalid_code
+      message = "That code is invalid or expired. Try again."
+
+      respond_to do |format|
+        format.html do
+          @email_address = @email_code&.email_address
+          flash.now[:alert] = message
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: message }, status: :unprocessable_entity }
+      end
+    end
+end
