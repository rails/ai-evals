diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..dafb5fc
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,57 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  PURPOSES = %w[ sign_in sign_up join ].freeze
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code_digest, :purpose, presence: true
+  validates :purpose, inclusion: { in: PURPOSES }
+
+  class << self
+    def issue(email_address:, purpose:)
+      code = generate_code
+      create!(
+        email_address: email_address,
+        code_digest: digest(code),
+        purpose: purpose.to_s
+      ).tap do |email_code|
+        IdentityMailer.email_code(email_address: email_code.email_address, code: code).deliver_later
+      end
+    end
+
+    private
+      def generate_code
+        SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      end
+
+      def digest(code)
+        OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code.to_s.strip.upcase)
+      end
+  end
+
+  def consume(code)
+    with_lock do
+      if usable? && secure_code_match?(code)
+        update!(used_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def expired?
+    created_at.nil? || Time.current >= created_at + EXPIRATION
+  end
+
+  private
+    def usable?
+      used_at.nil? && !expired?
+    end
+
+    def secure_code_match?(code)
+      ActiveSupport::SecurityUtils.secure_compare(self.class.send(:digest, code), code_digest)
+    end
+end
