diff --git a/test/controllers/email_code_authentication_test.rb b/test/controllers/email_code_authentication_test.rb
new file mode 100644
index 0000000..5a2da8a
--- /dev/null
+++ b/test/controllers/email_code_authentication_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "signs in with an email code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+
+      assert_redirected_to new_session_verification_path
+      code = email_code_from_last_delivery
+
+      get new_session_verification_path
+      assert_response :success
+      assert_select "input[name=code][autocomplete='one-time-code']"
+
+      post session_verification_path, params: { code: code }
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "email code is in the subject and is six characters" do
+    assert_emails 1 do
+      EmailCode.issue(email_address: "newuser@example.com", purpose: :sign_in)
+    end
+
+    assert_match(/\A[A-Z0-9]{6}\z/, email_code_from_last_delivery)
+    assert_includes ActionMailer::Base.deliveries.last.subject, email_code_from_last_delivery
+  end
+
+  test "an email code cannot be used after fifteen minutes" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+
+      code = email_code_from_last_delivery
+      EmailCode.order(created_at: :desc).first.update_column(:created_at, 15.minutes.ago)
+      post session_verification_path, params: { code: code }
+    end
+
+    assert_response :unprocessable_entity
+    assert_not cookies[:session_token].present?
+  end
+
+  test "an email code can only be used once" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+
+      code = email_code_from_last_delivery
+      post session_verification_path, params: { code: code }
+      assert_redirected_to landing_path
+
+      delete session_path
+      post session_verification_path, params: { code: code }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "signs up after verifying an email code" do
+    email_address = "newuser@example.com"
+
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+
+      assert_redirected_to new_signup_verification_path
+      code = email_code_from_last_delivery
+      post signup_verification_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New User" } }
+      end
+      assert_response :redirect
+    end
+  end
+
+  test "joins an account after verifying an email code" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "joiner@example.com"
+
+    assert_emails 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+    end
+
+    assert_redirected_to new_join_verification_url(join_code: join_code.code, script_name: account.slug)
+    code = email_code_from_last_delivery
+
+    post join_verification_path(join_code: join_code.code, script_name: account.slug), params: { code: code }
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    identity = Identity.find_by!(email_address: email_address)
+    assert identity.users.exists?(account: account)
+  end
+
+  private
+    def email_code_from_last_delivery
+      ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}\z/]
+    end
+end
