index 0000000..4a9afd3
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,38 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def issue_email_code(email_address, purpose:, context: {})
+      email_code = EmailCode.issue(email_address: email_address, purpose: purpose)
+      session[:email_code] = {
+        "id" => email_code.id,
+        "purpose" => purpose.to_s
+      }.merge(context.stringify_keys)
+      email_code
+    end
+
+    def pending_email_code(purpose:)
+      context = pending_email_code_context
+
+      if context[:purpose] == purpose.to_s
+        EmailCode.find_by(id: context[:id], purpose: purpose.to_s)
+      end
+    end
+
+    def pending_email_code_context
+      (session[:email_code] || {}).to_h.with_indifferent_access
+    end
+
+    def consume_email_code(purpose:, code:)
+      if email_code = pending_email_code(purpose: purpose)
+        if email_code.consume(code)
+          session.delete(:email_code)
+          email_code
+        end
+      end
+    end
+
+    def valid_email_address?(email_address)
+      email_address.present? && Identity.new(email_address: email_address).valid?
+    end
+end
