--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+  setup do
+    @user = users(:david)
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "belongs to a user and account" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example/subscriptions/one",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    assert_equal @user, subscription.user
+    assert_equal @user.account, subscription.account
+  end
+
+  test "an endpoint can be registered once per user" do
+    attributes = {
+      endpoint: "https://push.example/subscriptions/one",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    }
+    @user.push_subscriptions.create!(attributes)
+
+    assert_raises ActiveRecord::RecordInvalid do
+      @user.push_subscriptions.create!(attributes)
+    end
+  end
+
+  test "payload uses the tray copy and opens the card" do
+    payload = @notification.push_payload
+
+    assert_equal "JZ @mentioned you", payload[:title]
+    assert_equal @notification.source.source.mentionable_content.truncate(200), payload[:body]
+    assert_equal card_path(@notification.card, script_name: @notification.account.slug), payload[:url]
+  end
+
+  test "delivers the notification payload through web push" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example/subscriptions/one",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |arguments|
+        arguments[:message] == @notification.push_payload.to_json &&
+          arguments[:endpoint] == subscription.endpoint &&
+          arguments[:p256dh] == subscription.p256dh_key &&
+          arguments[:auth] == subscription.auth_key &&
+          arguments[:vapid][:public_key] == "public-key" &&
+          arguments[:vapid][:private_key] == "private-key"
+      end
+
+      subscription.deliver(@notification)
+    end
+  end
+
+  private
+    def with_vapid_keys
+      original_public_key = ENV["VAPID_PUBLIC_KEY"]
+      original_private_key = ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = "public-key"
+      ENV["VAPID_PRIVATE_KEY"] = "private-key"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = original_public_key
+      ENV["VAPID_PRIVATE_KEY"] = original_private_key
+    end
+end
