diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..a9d1658
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers the current user's subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.sole
+    assert_equal subscription_params[:push_subscription][:endpoint], subscription.endpoint
+    assert_equal subscription_params[:push_subscription][:p256dh_key], subscription.p256dh_key
+    assert_equal subscription_params[:push_subscription][:auth_key], subscription.auth_key
+    assert_equal subscription.id, @response.parsed_body["id"]
+  end
+
+test "create rejects an insecure endpoint" do
+  post user_push_subscriptions_path(@user), params: subscription_params.deep_merge(push_subscription: { endpoint: "http://example.com" }), as: :json
+
+  assert_response :unprocessable_entity
+  assert_empty @user.push_subscriptions
+end
+
+  test "create updates an existing endpoint" do
+    subscription = @user.push_subscriptions.create!(subscription_params[:push_subscription])
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params.deep_merge(push_subscription: { auth_key: "new-auth" }), as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-auth", subscription.reload.auth_key
+  end
+
+  test "create cannot register a subscription for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: subscription_params, as: :json
+
+    assert_response :forbidden
+    assert_empty users(:kevin).push_subscriptions
+  end
+
+  test "destroy removes the current user's subscription" do
+    subscription = @user.push_subscriptions.create!(subscription_params[:push_subscription])
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  private
+    def subscription_params
+      {
+        push_subscription: {
+          endpoint: "https://push.example/subscriptions/david",
+          p256dh_key: "p256dh",
+          auth_key: "auth"
+        }
+      }
+    end
+end
diff --git a/test/jobs/notification/push_job_test.rb b/test/jobs/notification/push_job_test.rb
new file mode 100644
index 0000000..005849b
--- /dev/null
+++ b/test/jobs/notification/push_job_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "delivers to every subscription" do
+    first = @user.push_subscriptions.create!(subscription_attributes("one"))
+    second = @user.push_subscriptions.create!(subscription_attributes("two"))
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).twice.with do |arguments|
+        [ first.endpoint, second.endpoint ].include?(arguments[:endpoint])
+      end
+
+      Notification::PushJob.perform_now(@notification)
+    end
+  end
+
+  test "enqueues when a notification reaches the tray and VAPID is configured" do
+    @notification.destroy
+
+    with_vapid_keys do
+      assert PushSubscription.vapid_configured?
+      assert_enqueued_with job: Notification::PushJob do
+        Notification.create!(user: @user, source: mentions(:logo_comment_david_mention_by_jz), creator: users(:jz))
+      end
+    end
+  end
+
+  test "enqueues when a notification becomes unread" do
+    @notification.read
+
+    with_vapid_keys do
+      assert_enqueued_with job: Notification::PushJob do
+        @notification.unread
+      end
+    end
+  end
+
+  test "does not enqueue push work when VAPID is not configured" do
+    without_vapid_keys do
+      @notification.destroy
+
+      assert_no_enqueued_jobs only: Notification::PushJob do
+        Notification.create!(user: @user, source: mentions(:logo_comment_david_mention_by_jz), creator: users(:jz))
+      end
+    end
+  end
+
+  private
+    def subscription_attributes(suffix)
+      {
+        endpoint: "https://push.example/subscriptions/#{suffix}",
+        p256dh_key: "p256dh-#{suffix}",
+        auth_key: "auth-#{suffix}"
+      }
+    end
+
+    def with_vapid_keys
+      with_environment("public-key", "private-key") { yield }
+    end
+
+    def without_vapid_keys
+      with_environment(nil, nil) { yield }
+    end
+
+    def with_environment(public_key, private_key)
+      original_public_key = ENV["VAPID_PUBLIC_KEY"]
+      original_private_key = ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"] = public_key
+      ENV["VAPID_PRIVATE_KEY"] = private_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = original_public_key
+      ENV["VAPID_PRIVATE_KEY"] = original_private_key
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
