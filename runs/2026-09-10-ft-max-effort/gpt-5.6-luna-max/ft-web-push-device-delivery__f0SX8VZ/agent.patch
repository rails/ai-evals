@@ -0,0 +1,40 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+
+    if @push_subscription.update(push_subscription_params)
+      respond_to do |format|
+        format.json { render json: { id: @push_subscription.id, endpoint: @push_subscription.endpoint }, status: :created }
+        format.any { head :created }
+      end
+    else
+      respond_to do |format|
+        format.json { render json: @push_subscription.errors, status: :unprocessable_entity }
+        format.any { head :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..79373dc
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,166 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details", "status", "toggle" ]
+
+  static values = {
+    url: String,
+    destroyUrlTemplate: String,
+    vapidPublicKey: String,
+    subscriptions: Array
+  }
+
+  async connect() {
+    this.#hideDetails()
+    this.#setEnabled(false)
+    this.#setBusy(true)
+
+    if (this.#supported) {
+      await this.#refresh()
+      this.#setBusy(false)
+    } else {
+      this.toggleTarget.disabled = true
+    }
+  }
+
+  async toggle() {
+    this.#setBusy(true)
+
+    try {
+      if (!this.element.classList.contains("notifications--on")) {
+        const permission = await this.#requestPermission()
+        if (permission !== "granted") {
+          this.#showDetails()
+          return
+        }
+      }
+
+      const subscription = await this.#subscription
+      if (this.#registered(subscription)) {
+        await this.#disable(subscription)
+      } else {
+        await this.#enable(subscription)
+      }
+    } catch (error) {
+      console.error("Unable to update push notification settings", error)
+      this.#setEnabled(false)
+      this.#showDetails()
+    } finally {
+      this.#setBusy(false)
+    }
+  }
+
+  get #supported() {
+    return Boolean(
+      this.vapidPublicKeyValue &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      "Notification" in window
+    )
+  }
+
+  async #refresh() {
+    if (Notification.permission === "denied") {
+      this.#showDetails()
+      return
+    }
+
+    const subscription = await this.#subscription
+    this.#setEnabled(Boolean(subscription && this.#registered(subscription)))
+  }
+
+  async #requestPermission() {
+    if (Notification.permission === "granted") return "granted"
+    if (Notification.permission === "denied") return "denied"
+    return Notification.requestPermission()
+  }
+
+  async #enable(subscription) {
+    const activeSubscription = subscription || await this.#subscribe()
+    const record = await this.#save(activeSubscription)
+    this.subscriptionsValue = [ ...this.subscriptionsValue.filter(existing => existing.endpoint !== record.endpoint), record ]
+    this.#hideDetails()
+    this.#setEnabled(true)
+  }
+
+  async #disable(subscription) {
+    const record = this.#registered(subscription)
+    if (record?.id) {
+      const response = await fetch(this.destroyUrlTemplateValue.replace("__ID__", encodeURIComponent(record.id)), {
+        method: "DELETE",
+        credentials: "same-origin",
+        headers: this.#headers
+      })
+      if (!response.ok) throw new Error(`Push subscription removal failed: ${response.status}`)
+    }
+
+    this.subscriptionsValue = this.subscriptionsValue.filter(existing => existing.endpoint !== subscription.endpoint)
+    this.#setEnabled(false)
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#decodePublicKey(this.vapidPublicKeyValue)
+    })
+  }
+
+  async #save(subscription) {
+    const data = subscription.toJSON()
+    const formData = new FormData()
+    formData.append("push_subscription[endpoint]", data.endpoint)
+    formData.append("push_subscription[p256dh_key]", data.keys.p256dh)
+    formData.append("push_subscription[auth_key]", data.keys.auth)
+
+    const response = await fetch(this.urlValue, {
+      method: "POST",
+      credentials: "same-origin",
+      headers: { ...this.#headers, Accept: "application/json" },
+      body: formData
+    })
+    if (!response.ok) throw new Error(`Push subscription registration failed: ${response.status}`)
+
+    return await response.json()
+  }
+
+  get #subscription() {
+    return navigator.serviceWorker.ready.then(registration => registration.pushManager.getSubscription())
+  }
+
+  #registered(subscription) {
+    return subscription && this.subscriptionsValue.find(existing => existing.endpoint === subscription.endpoint)
+  }
+
+  #decodePublicKey(key) {
+    const padding = "=".repeat((4 - key.length % 4) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    return Uint8Array.from(rawData, character => character.charCodeAt(0))
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    if (this.hasToggleTarget) {
+      this.toggleTarget.textContent = enabled ? "Turn off notifications on this device" : "Turn on notifications"
+      this.toggleTarget.setAttribute("aria-pressed", enabled)
+    }
+  }
+
+  #setBusy(busy) {
+    this.toggleTarget.disabled = busy
+    this.statusTarget.toggleAttribute("aria-busy", busy)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => details.hidden = true)
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(details => details.hidden = false)
+  }
+
+  get #headers() {
+    return { "X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content }
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
