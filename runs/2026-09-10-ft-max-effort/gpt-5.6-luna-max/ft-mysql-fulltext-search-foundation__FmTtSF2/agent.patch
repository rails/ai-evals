diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..37b2457
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds published cards by title, description, and comment body" do
+    title_card = create_card(title: "A needle in the title")
+    description_card = create_card(title: "Description result", description: "A needle in the description")
+    comment_card = create_card(title: "Comment result")
+    create_comment(comment_card, "A needle in a comment")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 3
+    assert_select ".search-result a[href='#{card_path(title_card)}']"
+    assert_select ".search-result a[href='#{card_path(description_card)}']"
+    assert_select ".search-result a[href='#{card_path(comment_card)}']"
+    assert_select "mark", text: "needle", count: 3
+  end
+
+  test "returns results newest first" do
+    older_card = create_card(title: "needle older", created_at: 2.days.ago)
+    newer_card = create_card(title: "needle newer", created_at: 1.day.ago)
+
+    get search_path, params: { q: "needle" }
+
+    result_links = css_select(".search-result a").map { |link| link["href"] }
+    assert_equal [ card_path(newer_card), card_path(older_card) ], result_links
+  end
+
+  test "only searches boards the current user can access" do
+    inaccessible_card = create_card(board: boards(:private), title: "needle inaccessible")
+    logout_and_sign_in_as :jz
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result a[href='#{card_path(inaccessible_card)}']", count: 0
+  end
+
+  test "does not return draft cards or their comments" do
+    draft_card = create_card(title: "needle draft", status: "drafted")
+    published_card = create_card(title: "Published card")
+    create_comment(published_card, "needle in a comment")
+    published_card.update!(status: "drafted")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "highlights case-insensitive multi-word searches" do
+    create_card(title: "A Red needle")
+
+    get search_path, params: { q: "red NEEDLE" }
+
+    assert_response :success
+    assert_select "mark", text: "Red"
+    assert_select "mark", text: "needle"
+  end
+
+  test "does not search when the query is blank" do
+    create_card(title: "needle")
+
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_card(board: boards(:writebook), title:, description: nil, status: "published", created_at: Time.current)
+      with_current_user(:kevin) do
+        board.cards.create!(
+          creator: users(:kevin),
+          title: title,
+          description: description,
+          status: status,
+          created_at: created_at,
+          last_active_at: created_at
+        )
+      end
+    end
+
+    def create_comment(card, body)
+      with_current_user(:kevin) do
+        card.comments.create!(creator: users(:kevin), body: body)
+      end
+    end
+end
