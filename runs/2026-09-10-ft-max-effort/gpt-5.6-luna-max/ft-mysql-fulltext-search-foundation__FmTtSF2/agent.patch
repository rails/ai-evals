+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,55 @@
+class SearchesController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @search_terms = @query.split
+
+    set_page_and_extract_portion_from search_results
+  end
+
+  private
+    def search_results
+      if @search_terms.any?
+        Current.user.accessible_cards.published
+          .where(search_predicate, **search_bindings)
+          .preload(:board, :rich_text_description, comments: :rich_text_body)
+          .reverse_chronologically
+      else
+        Current.user.accessible_cards.none
+      end
+    end
+
+    def search_predicate
+      @search_terms.each_index.map do |index|
+        term = "term_#{index}"
+        <<~SQL.squish
+          (
+            LOWER(#{Card.quoted_table_name}.title) LIKE :#{term}
+            OR EXISTS (
+              SELECT 1
+              FROM #{ActionText::RichText.quoted_table_name} AS card_descriptions
+              WHERE card_descriptions.record_type = 'Card'
+                AND card_descriptions.record_id = #{Card.quoted_table_name}.id
+                AND card_descriptions.name = 'description'
+                AND LOWER(card_descriptions.body) LIKE :#{term}
+            )
+            OR EXISTS (
+              SELECT 1
+              FROM #{Comment.quoted_table_name} AS comments
+              INNER JOIN #{ActionText::RichText.quoted_table_name} AS comment_bodies
+                ON comment_bodies.record_type = 'Comment'
+                AND comment_bodies.record_id = comments.id
+                AND comment_bodies.name = 'body'
+              WHERE comments.card_id = #{Card.quoted_table_name}.id
+                AND LOWER(comment_bodies.body) LIKE :#{term}
+            )
+          )
+        SQL
+      end.join(" AND ")
+    end
+
+    def search_bindings
+      @search_terms.each_with_index.to_h do |term, index|
+        [ "term_#{index}".to_sym, "%#{ActiveRecord::Base.sanitize_sql_like(term.downcase)}%" ]
+      end
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..c7d6434
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,20 @@
+module SearchesHelper
+  def highlighted_search_text(text)
+    highlight text.to_s, @search_terms
+  end
+
+  def search_excerpt(content, length: 240)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    return if text.blank?
+
+    matching_term = @search_terms.find { |term| text.match?(Regexp.new(Regexp.escape(term), Regexp::IGNORECASE)) }
+    matching_term ? excerpt(text, matching_term, radius: length / 2) : text.truncate(length)
+  end
+
+  def search_comments_for(card)
+    card.comments.select do |comment|
+      searchable_text = comment.body.to_plain_text
+      @search_terms.any? { |term| searchable_text.match?(Regexp.new(Regexp.escape(term), Regexp::IGNORECASE)) }
+    end
+  end
+end
diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..68a331d
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,44 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide center-block">
+  <%= form_with url: search_path, method: :get, class: "flex gap" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input flex-item-grow", type: "search" %>
+    <%= form.submit "Search", class: "btn btn--primary" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.empty? %>
+      <div class="blank-slate">No cards match <strong><%= @query %></strong></div>
+    <% else %>
+      <div class="search-results margin-block-start-double">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <% @page.records.each do |card| %>
+            <article class="search-result border-block-end padding-block" id="<%= dom_id(card, :search_result) %>">
+              <h2 class="txt-medium margin-none">
+                <%= link_to highlighted_search_text(card.title), card_path(card) %>
+              </h2>
+
+              <% if description = search_excerpt(card.description) %>
+                <p class="margin-block-half"><%= highlighted_search_text(description) %></p>
+              <% end %>
+
+              <% search_comments_for(card).each do |comment| %>
+                <% if comment_body = search_excerpt(comment.body) %>
+                  <p class="txt-small margin-block-half translucent">
+                    <%= highlighted_search_text(comment_body) %>
+                  </p>
+                <% end %>
+              <% end %>
+            </article>
+          <% end %>
+        <% end %>
+      </div>
+    <% end %>
+  <% else %>
+    <p class="margin-block-start">Enter a term to search card titles, descriptions, and comments.</p>
+  <% end %>
+</section>
