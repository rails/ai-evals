+class Notification::PushPayload
+  include NotificationsHelper
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def to_h
+    {
+      title: title,
+      body: body,
+      url: Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug)
+    }
+  end
+
+  private
+    attr_reader :notification
+
+    def title
+      case notification.source_type
+      when "Event"
+        event_notification_title(notification.source)
+      when "Mention"
+        mention = notification.source
+        "#{mention.mentioner.first_name} @mentioned you"
+      end
+    end
+
+    def body
+      case notification.source_type
+      when "Event"
+        event_notification_body(notification.source)
+      when "Mention"
+        notification.source.source.mentionable_content.truncate(200)
+      end
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..780257c
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,40 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+
+    def digest_endpoint(endpoint)
+      Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def find_or_initialize_by_endpoint(endpoint)
+      find_by(endpoint: endpoint) || find_or_initialize_by(endpoint_digest: digest_endpoint(endpoint))
+    end
+  end
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: JSON.generate(Notification::PushPayload.new(notification).to_h),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    )
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = self.class.digest_endpoint(endpoint) if endpoint.present?
+    end
+end
