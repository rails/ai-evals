+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = PushSubscription.create!(
+      user: @user,
+      account: @user.account,
+      endpoint: "https://push.example.test/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "endpoint digest makes registration idempotent" do
+    duplicate = PushSubscription.find_or_initialize_by_endpoint(@subscription.endpoint)
+
+    assert_equal @subscription, duplicate
+    assert_equal @subscription.endpoint_digest, duplicate.endpoint_digest
+  end
+
+  test "delivers the notification payload through web push" do
+    with_env("VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key") do
+      WebPush.expects(:payload_send).with(
+        message: JSON.generate(Notification::PushPayload.new(@notification).to_h),
+        endpoint: @subscription.endpoint,
+        p256dh: @subscription.p256dh_key,
+        auth: @subscription.auth_key,
+        vapid: { public_key: "public-key", private_key: "private-key" }
+      )
+
+      @subscription.deliver(@notification)
+    end
+  end
+
+  private
+    def with_env(values)
+      original_values = values.keys.index_with { |key| ENV[key] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      original_values.each { |key, value| ENV[key] = value }
+    end
+end
