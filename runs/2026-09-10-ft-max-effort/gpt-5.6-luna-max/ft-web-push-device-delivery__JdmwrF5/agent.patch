diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..37b309b 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,39 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  const payload = event.data ? event.data.json() : {}
+  const title = payload.title || "Fizzy"
+  const options = {
+    body: payload.body,
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192-maskable.png",
+    data: { url: payload.url }
+  }
+
+  event.waitUntil(self.registration.showNotification(title, options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url
+  if (url) {
+    event.waitUntil(openNotificationUrl(url))
+  }
+})
+
+async function openNotificationUrl(url) {
+  const targetUrl = new URL(url, self.location.origin).href
+  const windows = await clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  for (const windowClient of windows) {
+    if ("navigate" in windowClient) {
+      const navigatedClient = await windowClient.navigate(targetUrl)
+      return navigatedClient?.focus()
+    }
+  }
+
+  return clients.openWindow(targetUrl)
+}
