+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = PushSubscription.create!(
+      user: @notification.user,
+      account: @notification.account,
+      endpoint: "https://push.example.test/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "delivers to every registered subscription" do
+    with_env("VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key") do
+      WebPush.expects(:payload_send).once
+
+      Notification::PushJob.perform_now(@notification)
+    end
+  end
+
+  test "removes expired subscriptions" do
+    with_env("VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key") do
+      response = Struct.new(:body).new("")
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        Notification::PushJob.perform_now(@notification)
+      end
+    end
+  end
+
+  private
+    def with_env(values)
+      original_values = values.keys.index_with { |key| ENV[key] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      original_values.each { |key, value| ENV[key] = value }
+    end
+end
