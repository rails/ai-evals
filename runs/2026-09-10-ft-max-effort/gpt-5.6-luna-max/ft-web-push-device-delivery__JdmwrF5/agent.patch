@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+
+    @subscription = {
+      endpoint: "https://push.example.test/subscriptions/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    }
+  end
+
+  test "create registers the current user's subscription" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :no_content
+    assert_equal @user, PushSubscription.last.user
+    assert_equal Current.account, PushSubscription.last.account
+    assert_equal @subscription[:endpoint], PushSubscription.last.endpoint
+  end
+
+  test "create updates an existing subscription for the current device" do
+    push_subscription = PushSubscription.create!(user: @user, account: @user.account, **@subscription)
+    replacement = @subscription.merge(p256dh_key: "new-p256dh-key", auth_key: "new-auth-key")
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: replacement }, as: :json
+    end
+
+    assert_response :no_content
+    assert_equal "new-p256dh-key", push_subscription.reload.p256dh_key
+    assert_equal "new-auth-key", push_subscription.auth_key
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
