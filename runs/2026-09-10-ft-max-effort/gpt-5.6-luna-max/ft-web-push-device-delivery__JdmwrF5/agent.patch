--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,20 @@
+class Notification::PushJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError, ActiveRecord::RecordNotFound
+
+  def perform(notification)
+    if PushSubscription.configured? && notification.user.active? && notification.user.account.active?
+      notification.user.push_subscriptions.find_each do |subscription|
+        deliver_to(subscription, notification)
+      end
+    end
+  end
+
+  private
+    def deliver_to(subscription, notification)
+      subscription.deliver(notification)
+    rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+      subscription.destroy!
+    end
+end
