@@ -0,0 +1,31 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    push_subscription = PushSubscription.find_or_initialize_by_endpoint(push_subscription_params[:endpoint])
+    push_subscription.update!(push_subscription_params.merge(user: @user, account: Current.account))
+
+    head :no_content
+  end
+
+  def destroy
+    push_subscription = @user.push_subscriptions.find(params[:id])
+    push_subscription.destroy!
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b4230d2
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,142 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "explainer" ]
+
+  static values = {
+    publicKey: String,
+    subscriptionUrl: String
+  }
+
+  connect() {
+    this.#syncExistingSubscription()
+  }
+
+  async enable() {
+    if (!this.#canUsePush) {
+      this.#showHelp()
+      return
+    }
+
+    this.buttonTarget.disabled = true
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        const registration = await this.#serviceWorkerRegistration
+        const subscription = await this.#subscriptionFor(registration)
+        await this.#saveSubscription(subscription)
+        this.#setEnabled(true)
+      } else {
+        this.#showHelp()
+      }
+    } catch (error) {
+      console.error("Unable to enable push notifications", error)
+      this.#showHelp()
+    } finally {
+      if (!this.element.classList.contains("notifications--on")) {
+        this.buttonTarget.disabled = false
+      }
+    }
+  }
+
+  async #syncExistingSubscription() {
+    if (!this.#canUsePush) {
+      this.buttonTarget.disabled = true
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showHelp()
+      return
+    }
+
+    try {
+      const registration = await this.#serviceWorkerRegistration
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#saveSubscription(subscription)
+        this.#setEnabled(true)
+      }
+    } catch (error) {
+      console.error("Unable to synchronize push notifications", error)
+      this.#showHelp()
+    }
+  }
+
+  async #subscriptionFor(registration) {
+    const currentSubscription = await registration.pushManager.getSubscription()
+
+    if (currentSubscription) {
+      return currentSubscription
+    }
+
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#decodePublicKey(this.publicKeyValue)
+    })
+  }
+
+  async #saveSubscription(subscription) {
+    const request = new FetchRequest("post", this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: this.#encodeKey(subscription.getKey("p256dh")),
+          auth_key: this.#encodeKey(subscription.getKey("auth"))
+        }
+      },
+      responseKind: "json"
+    })
+    const response = await request.perform()
+
+    if (!response.ok) {
+      throw new Error(`Push subscription registration failed (${response.statusCode})`)
+    }
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.explainerTarget.hidden = enabled
+    this.buttonTarget.hidden = enabled
+    this.buttonTarget.disabled = false
+  }
+
+  #showHelp() {
+    this.explainerTarget.hidden = false
+    this.buttonTarget.hidden = false
+  }
+
+  #decodePublicKey(key) {
+    const padding = "=".repeat((4 - key.length % 4) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+
+  #encodeKey(key) {
+    if (!key) {
+      throw new Error("Push subscription is missing an encryption key")
+    }
+
+    const bytes = new Uint8Array(key)
+    let binary = ""
+    bytes.forEach(byte => binary += String.fromCharCode(byte))
+
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  get #canUsePush() {
+    return this.publicKeyValue &&
+      "Notification" in window &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window
+  }
+
+  get #serviceWorkerRegistration() {
+    return navigator.serviceWorker.register("/service-worker.js", { scope: "/" }).then(() => navigator.serviceWorker.ready)
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
