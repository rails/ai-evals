diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..f6823a0
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,18 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag emits an unformatted timestamp" do
+    timestamp = Time.utc(2025, 9, 12, 17, 42)
+
+    assert_select Nokogiri::HTML::DocumentFragment.parse(local_time_tag(timestamp, format: :time)), "time[data-controller='time'][data-time-format-value='time']" do |time|
+      assert_equal timestamp.iso8601, time.first["datetime"]
+      assert_empty time.first.text
+    end
+  end
+
+  test "local_time_tag preserves calendar dates without a timezone" do
+    date = Date.new(2025, 9, 12)
+
+    assert_select Nokogiri::HTML::DocumentFragment.parse(local_time_tag(date, format: :weekday_date)), "time[datetime='2025-09-12']"
+  end
+end
