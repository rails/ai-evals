diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..65436ac
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,28 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    const date = dateFromAttribute(this.element.getAttribute("datetime"))
+
+    if (!Number.isNaN(date.getTime())) {
+      this.element.textContent = formatDateTime(date, this.formatValue)
+    }
+  }
+}
+
+function dateFromAttribute(value) {
+  if (!value) return new Date(NaN)
+
+  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    return new Date(`${value}T00:00:00`)
+  }
+
+  return new Date(value)
+}
