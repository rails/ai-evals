+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,71 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  PENDING_AUTHENTICATION_COOKIE = :pending_authentication_token
+
+  included do
+    helper_method :email_code_restart_path
+  end
+
+  private
+    def request_email_code(email_address:, purpose:, join_code: nil)
+      @pending_email_code, code = EmailCode.issue(
+        email_address: normalized_email_address(email_address),
+        purpose: purpose,
+        join_code: join_code
+      )
+      @pending_authentication_token = @pending_email_code.signed_id(
+        purpose: EmailCode::SIGNED_ID_PURPOSE,
+        expires_in: EmailCode::EXPIRATION
+      )
+
+      cookies[PENDING_AUTHENTICATION_COOKIE] = {
+        value: @pending_authentication_token,
+        httponly: true,
+        same_site: :lax,
+        path: "/"
+      }
+
+      IdentityMailer.magic_link(email_address: @pending_email_code.email_address, code: code).deliver_later
+    end
+
+    def respond_with_email_code_request
+      respond_to do |format|
+        format.html do
+          redirect_to session_magic_link_path(script_name: nil),
+            notice: "Check your email for a six-character code."
+        end
+        format.json do
+          render json: { pending_authentication_token: @pending_authentication_token }, status: :created
+        end
+      end
+    end
+
+    def pending_email_code
+      @pending_email_code ||= if (token = cookies[PENDING_AUTHENTICATION_COOKIE]).present?
+        EmailCode.find_signed(token, purpose: EmailCode::SIGNED_ID_PURPOSE)
+      end
+    end
+
+    def clear_pending_email_code
+      cookies.delete(PENDING_AUTHENTICATION_COOKIE, path: "/")
+    end
+
+    def valid_email_address?(email_address)
+      email_address.present? && Identity.new(email_address: email_address).valid?
+    end
+
+    def normalized_email_address(email_address)
+      Identity.new(email_address: email_address).email_address
+    end
+
+    def email_code_restart_path
+      if pending_email_code&.signup?
+        new_signup_path
+      elsif pending_email_code&.join? && pending_email_code.join_code
+        join_path(code: pending_email_code.join_code.code, script_name: pending_email_code.join_code.account.slug)
+      else
+        new_session_path(script_name: nil)
+      end
+    end
+end
