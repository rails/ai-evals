diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..16286eb
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,80 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  SIGNED_ID_PURPOSE = "email_code"
+
+  SIGN_IN = "sign_in"
+  SIGNUP = "signup"
+  JOIN = "join"
+  PURPOSES = [ SIGN_IN, SIGNUP, JOIN ].freeze
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, inclusion: { in: PURPOSES }
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  class << self
+    def issue(email_address:, purpose:, join_code: nil)
+      email_address = Identity.new(email_address: email_address).email_address
+      code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      email_code = transaction do
+        where(email_address: email_address, used_at: nil).update_all(used_at: Time.current)
+
+        create!(
+          email_address: email_address,
+          code_digest: digest(code),
+          purpose: purpose,
+          join_code: join_code,
+          join_code_value: join_code&.code,
+          expires_at: EXPIRATION.from_now
+        )
+      end
+
+      [ email_code, code ]
+    end
+
+    def digest(code)
+      OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code.to_s)
+    end
+  end
+
+  def consume_if_valid(code)
+    with_lock do
+      if usable? && valid_code?(code)
+        update!(used_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def usable?
+    used_at.nil? && expires_at.future?
+  end
+
+  def sign_in?
+    purpose == SIGN_IN
+  end
+
+  def signup?
+    purpose == SIGNUP
+  end
+
+  def join?
+    purpose == JOIN
+  end
+
+  def join_code_valid?
+    join_code.present? && join_code_value == join_code.code
+  end
+
+  private
+    def valid_code?(code)
+      normalized_code = code.to_s.strip.upcase
+      normalized_code.length == CODE_LENGTH &&
+        ActiveSupport::SecurityUtils.secure_compare(self.class.digest(normalized_code), code_digest)
+    end
+end
