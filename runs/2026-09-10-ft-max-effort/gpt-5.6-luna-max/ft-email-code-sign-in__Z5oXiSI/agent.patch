+
+  <p class="txt-small margin-none">
+    <%= link_to "Use a different email address", email_code_restart_path, class: "txt-link" %>
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
