--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signs in with the code from the email" do
+    request_email_code_for_session identities(:kevin).email_address
+
+    get session_magic_link_path(script_name: nil)
+    assert_response :success
+    assert_select "input[name=code][maxlength='6']"
+
+    post session_magic_link_path(script_name: nil), params: { code: email_code }
+
+    assert_redirected_to landing_path(script_name: nil)
+    assert cookies[:session_token].present?
+  end
+
+  test "supports the JSON authentication flow" do
+    perform_enqueued_jobs do
+      untenanted do
+        post session_path(format: :json), params: { email_address: identities(:kevin).email_address }, as: :json
+      end
+    end
+
+    assert_response :created
+    assert @response.parsed_body["pending_authentication_token"].present?
+
+    post session_magic_link_path(format: :json, script_name: nil), params: { code: email_code }, as: :json
+
+    assert_response :success
+    assert @response.parsed_body["session_token"].present?
+  end
+
+  test "rejects an invalid code without signing in" do
+    request_email_code_for_session identities(:kevin).email_address
+
+    post session_magic_link_path(script_name: nil), params: { code: "WRONG1" }
+
+    assert_response :unprocessable_entity
+    assert_in_body "That code is invalid or has expired."
+    assert_select "input[name=code]"
+    assert_not cookies[:session_token].present?
+  end
+
+  test "rejects an expired code" do
+    request_email_code_for_session identities(:kevin).email_address
+
+    travel_to 16.minutes.from_now do
+      post session_magic_link_path(script_name: nil), params: { code: email_code }
+    end
+
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_equal "That code is invalid or has expired.", flash[:alert]
+  end
+
+  test "a code can only be used once" do
+    request_email_code_for_session identities(:kevin).email_address
+
+    post session_magic_link_path(script_name: nil), params: { code: email_code }
+    assert_redirected_to landing_path(script_name: nil)
+
+    assert_not EmailCode.order(created_at: :desc).first.usable?
+  end
+
+  test "signs up after verifying the code" do
+    email_address = "new-user@example.com"
+    request_email_code_for_signup email_address
+
+    post session_magic_link_path(script_name: nil), params: { code: email_code }
+
+    assert_redirected_to new_signup_completion_path(script_name: nil)
+    assert Identity.exists?(email_address: email_address)
+
+    post signup_completion_path(script_name: nil), params: { signup: { full_name: "New User" } }
+
+    assert_response :redirect
+    assert User.exists?(identity: Identity.find_by!(email_address: email_address))
+  end
+
+  test "joins after verifying the code" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "joining-user@example.com"
+
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+    end
+
+    assert_redirected_to session_magic_link_path(script_name: nil)
+    assert_equal email_code, ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+
+    post session_magic_link_path(script_name: nil), params: { code: email_code }
+
+    assert_redirected_to new_users_verification_path(script_name: account.slug)
+    assert User.exists?(account: account, identity: Identity.find_by!(email_address: email_address))
+  end
+
+  test "puts the code in the email subject" do
+    request_email_code_for_session identities(:kevin).email_address
+
+    assert_includes ActionMailer::Base.deliveries.last.subject, email_code
+    assert_equal 6, email_code.length
+  end
+
+  private
+    def request_email_code_for_session(email_address)
+      perform_enqueued_jobs do
+        untenanted do
+          post session_path, params: { email_address: email_address }
+        end
+      end
+
+      assert_redirected_to session_magic_link_path(script_name: nil)
+    end
+
+    def request_email_code_for_signup(email_address)
+      perform_enqueued_jobs do
+        untenanted do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      assert_redirected_to session_magic_link_path(script_name: nil)
+    end
+
+    def email_code
+      ActionMailer::Base.deliveries.last.subject[/[A-Z0-9]{6}/]
+    end
+end
