diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..ce55af0
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,121 @@
+class Sessions::MagicLinksController < ApplicationController
+  include EmailCodeAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    if @email_code = pending_email_code
+    else
+      redirect_to new_session_path(script_name: nil), alert: "Request a new code to sign in."
+    end
+  end
+
+  def create
+    @email_code = pending_email_code
+
+    if @email_code&.consume_if_valid(params[:code])
+      complete_email_code_authentication
+    else
+      invalid_email_code
+    end
+  end
+
+  private
+    def complete_email_code_authentication
+      if @email_code.sign_in?
+        authenticate_for_sign_in
+      elsif @email_code.signup?
+        authenticate_for_signup
+      elsif @email_code.join?
+        authenticate_for_join
+      else
+        invalid_email_code
+      end
+    end
+
+    def authenticate_for_sign_in
+      if identity = Identity.find_by(email_address: @email_code.email_address)
+        start_new_session_for identity
+        complete_authentication redirect_to: after_authentication_url
+      else
+        invalid_email_code
+      end
+    end
+
+    def authenticate_for_signup
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      start_new_session_for identity
+      complete_authentication redirect_to: new_signup_completion_path
+    end
+
+    def authenticate_for_join
+      if @email_code.join_code_valid? && @email_code.join_code.active?
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        @email_code.join_code.redeem_if { |account| identity.join(account) }
+
+        if user = User.active.find_by(account: @email_code.join_code.account, identity: identity)
+          start_new_session_for identity
+          redirect_after_join user
+        else
+          invalid_email_code
+        end
+      else
+        invalid_email_code
+      end
+    end
+
+    def complete_authentication(redirect_to:)
+      clear_pending_email_code
+
+      respond_to do |format|
+        format.html { redirect_to redirect_to }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def redirect_after_join(user)
+      clear_pending_email_code
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @email_code.join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @email_code.join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_email_code
+      message = "That code is invalid or has expired."
+
+      respond_to do |format|
+        format.html do
+          if @email_code
+            flash.delete(:notice)
+            flash.now[:alert] = message
+            render :new, status: :unprocessable_entity
+          else
+            flash.delete(:notice)
+            redirect_to new_session_path(script_name: nil), alert: message
+          end
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
