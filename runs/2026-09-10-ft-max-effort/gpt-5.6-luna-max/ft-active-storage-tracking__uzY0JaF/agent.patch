diff --git a/app/models/storage_usage/tracker.rb b/app/models/storage_usage/tracker.rb
new file mode 100644
index 0000000..0ffa5b6
--- /dev/null
+++ b/app/models/storage_usage/tracker.rb
@@ -0,0 +1,166 @@
+class StorageUsage::Tracker
+  class << self
+    def update_later(attachment_id)
+      StorageUsage::UpdateJob.perform_later(attachment_id)
+    end
+
+    def update_now(attachment_id)
+      ApplicationRecord.transaction do
+        attachment = ActiveStorage::Attachment.lock.find_by(id: attachment_id)
+        entry = StorageUsage::Entry.lock.find_by(attachment_id: attachment_id)
+        contribution = contribution_for(attachment)
+
+        if contribution
+          if entry
+            replace_entry(entry, contribution)
+          else
+            add_entry(attachment_id, contribution)
+          end
+        elsif entry
+          remove_entry(entry)
+        end
+      end
+    end
+
+    def reconcile_card_now(card_id)
+      StorageUsage::Calculator.tracked_attachments_for_card(card_id).find_each do |attachment|
+        update_now(attachment.id)
+      end
+    end
+
+    def reconcile_board_now(board_id)
+      StorageUsage::Calculator.tracked_attachments_for_board(board_id).find_each do |attachment|
+        update_now(attachment.id)
+      end
+    end
+
+    def rebuild_account_now(account_id)
+      account = Account.find_by(id: account_id)
+
+      if account
+        board_ids = Board.where(account_id: account_id).pluck(:id)
+
+        ApplicationRecord.transaction do
+          StorageUsage::Entry.where(account_id: account_id).or(
+            StorageUsage::Entry.where(board_id: board_ids)
+          ).delete_all
+          Board.where(id: board_ids).update_all(bytes_used: 0)
+          Account.where(id: account_id).update_all(bytes_used: 0)
+        end
+
+        StorageUsage::Calculator.tracked_attachments_for_account(account_id).find_each do |attachment|
+          update_now(attachment.id)
+        end
+      end
+    end
+
+    def rebuild_all_now
+      Account.find_each do |account|
+        rebuild_account_now(account.id)
+      end
+    end
+
+    def tracked_attachment?(attachment)
+      StorageUsage.tracked_attachment?(attachment)
+    end
+
+    def contribution_for(attachment)
+      if tracked_attachment?(attachment)
+        owner = storage_owner_for(attachment)
+        board = board_for(owner)
+
+        if board&.persisted?
+          StorageUsage::Contribution.new(
+            account_id: board.account_id,
+            board_id: board.id,
+            blob_id: attachment.blob_id,
+            byte_size: attachment.byte_size
+          )
+        end
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    private
+      def add_entry(attachment_id, contribution)
+        apply_delta(contribution, +1)
+        StorageUsage::Entry.create!(
+          attachment_id: attachment_id,
+          account_id: contribution.account_id,
+          board_id: contribution.board_id,
+          blob_id: contribution.blob_id,
+          byte_size: contribution.byte_size
+        )
+      end
+
+      def replace_entry(entry, contribution)
+        old_contribution = StorageUsage::Contribution.new(
+          account_id: entry.account_id,
+          board_id: entry.board_id,
+          blob_id: entry.blob_id,
+          byte_size: entry.byte_size
+        )
+
+        if old_contribution != contribution
+          apply_delta(old_contribution, -1)
+          apply_delta(contribution, +1)
+          entry.update!(
+            account_id: contribution.account_id,
+            board_id: contribution.board_id,
+            blob_id: contribution.blob_id,
+            byte_size: contribution.byte_size
+          )
+        end
+      end
+
+      def remove_entry(entry)
+        contribution = StorageUsage::Contribution.new(
+          account_id: entry.account_id,
+          board_id: entry.board_id,
+          blob_id: entry.blob_id,
+          byte_size: entry.byte_size
+        )
+
+        apply_delta(contribution, -1)
+        entry.delete
+      end
+
+      def apply_delta(contribution, multiplier)
+        delta = contribution.byte_size * multiplier
+        Board.update_counters(contribution.board_id, bytes_used: delta)
+        Account.update_counters(contribution.account_id, bytes_used: delta)
+      end
+
+      def storage_owner_for(attachment)
+        case attachment.record_type
+        when "Card"
+          attachment.record if attachment.name == "image"
+        when "ActionText::RichText"
+          rich_text_owner_for(attachment)
+        end
+      end
+
+      def rich_text_owner_for(attachment)
+        rich_text = attachment.record
+        return unless rich_text.name == rich_text_name_for(rich_text.record_type)
+
+        rich_text.record
+      end
+
+      def rich_text_name_for(record_type)
+        {
+          "Board" => "public_description",
+          "Card" => "description",
+          "Comment" => "body"
+        }[record_type]
+      end
+
+      def board_for(owner)
+        case owner
+        when Board then owner
+        when Card, Comment then owner.board
+        end
+      end
+  end
+end
diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
new file mode 100644
index 0000000..29c12e9
--- /dev/null
+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,13 @@
+Rails.application.config.to_prepare do
+  unless ActiveStorage::Attachment < StorageUsage::ActiveStorageAttachment
+    ActiveStorage::Attachment.include StorageUsage::ActiveStorageAttachment
+  end
+
+  unless ActiveStorage::Attachment < StorageUsage::DeleteAttachment
+    ActiveStorage::Attachment.prepend StorageUsage::DeleteAttachment
+  end
+
+  unless ActiveStorage::Attached::Changes::DetachMany < StorageUsage::DetachMany
+    ActiveStorage::Attached::Changes::DetachMany.prepend StorageUsage::DetachMany
+  end
+end
