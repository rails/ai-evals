@@ -0,0 +1,113 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @comment = comments(:logo_1)
+  end
+
+  test "counts card images and supported rich text embeds on the board and account" do
+    board_description = create_blob("board description")
+    card_image = create_blob("card image")
+    card_description = create_blob("card description")
+    comment_body = create_blob("comment body")
+
+    perform_storage_jobs do
+      @board.update!(public_description: attachment_html(board_description))
+      @card.image.attach(card_image)
+      @card.update!(description: attachment_html(card_description))
+      @comment.update!(body: attachment_html(comment_body))
+    end
+
+    expected = [ board_description, card_image, card_description, comment_body ].sum(&:byte_size)
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+  end
+
+  test "ignores attachments that are not card or supported rich text files" do
+    avatar = create_blob("avatar")
+
+    perform_storage_jobs do
+      users(:david).avatar.attach(avatar)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "tracks replacement and detachment" do
+    first = create_blob("first")
+    second = create_blob("second")
+
+    perform_storage_jobs do
+      @card.image.attach(first)
+    end
+    assert_equal first.byte_size, @board.reload.bytes_used
+
+    perform_storage_jobs do
+      @card.image.attach(second)
+    end
+    assert_equal second.byte_size, @board.reload.bytes_used
+
+    perform_storage_jobs do
+      @card.image.detach
+    end
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "tracks purged attachments" do
+    image = create_blob("card image")
+
+    perform_storage_jobs do
+      @card.image.attach(image)
+    end
+    assert_equal image.byte_size, @board.reload.bytes_used
+
+    perform_storage_jobs do
+      @card.image.purge
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moves card storage to its new board" do
+    destination = @account.boards.create!(name: "Destination", creator: users(:david))
+    image = create_blob("card image")
+
+    perform_storage_jobs do
+      @card.image.attach(image)
+    end
+    assert_equal image.byte_size, @board.reload.bytes_used
+
+    perform_storage_jobs do
+      @card.update!(board: destination)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal image.byte_size, destination.reload.bytes_used
+    assert_equal image.byte_size, @account.reload.bytes_used
+  end
+
+  private
+    def create_blob(contents)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: "storage-usage.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def attachment_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def perform_storage_jobs(&block)
+      yield
+      StorageUsage::RebuildAccountJob.perform_now(@account.id)
+    end
+end
