+++ b/app/models/storage_usage.rb
@@ -0,0 +1,9 @@
+module StorageUsage
+  Contribution = Struct.new(:account_id, :board_id, :blob_id, :byte_size, keyword_init: true)
+
+  def self.tracked_attachment?(attachment)
+    attachment.present? &&
+      ((attachment.record_type == "Card" && attachment.name == "image") ||
+        (attachment.record_type == "ActionText::RichText" && attachment.name == "embeds"))
+  end
+end
