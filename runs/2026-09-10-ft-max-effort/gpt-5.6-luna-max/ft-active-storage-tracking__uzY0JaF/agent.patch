+module StorageUsage::ActiveStorageAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :update_storage_usage_after_create_later, if: :storage_usage_tracked?
+    after_destroy_commit :update_storage_usage_after_destroy_later, if: :storage_usage_tracked?
+  end
+
+  private
+    def storage_usage_tracked?
+      StorageUsage.tracked_attachment?(self)
+    end
+
+    def update_storage_usage_after_create_later
+      StorageUsage::Tracker.update_later(id)
+    end
+
+    def update_storage_usage_after_destroy_later
+      StorageUsage::Tracker.update_later(id)
+    end
+end
diff --git a/app/models/storage_usage/calculator.rb b/app/models/storage_usage/calculator.rb
new file mode 100644
index 0000000..ce48814
--- /dev/null
+++ b/app/models/storage_usage/calculator.rb
@@ -0,0 +1,66 @@
+class StorageUsage::Calculator
+  class << self
+    def tracked_attachments_for_card(card_id)
+      card_ids = Card.where(id: card_id).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      tracked_attachments_for(card_ids: card_ids, comment_ids: comment_ids)
+    end
+
+    def tracked_attachments_for_board(board_id)
+      board_ids = Board.where(id: board_id).select(:id)
+      card_ids = Card.where(board_id: board_ids).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      tracked_attachments_for(board_ids: board_ids, card_ids: card_ids, comment_ids: comment_ids)
+    end
+
+    def tracked_attachments_for_account(account_id)
+      board_ids = Board.where(account_id: account_id).select(:id)
+      card_ids = Card.where(board_id: board_ids).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      tracked_attachments_for(board_ids: board_ids, card_ids: card_ids, comment_ids: comment_ids)
+    end
+
+    private
+      def tracked_attachments_for(board_ids: nil, card_ids: nil, comment_ids: nil)
+        direct_attachments = ActiveStorage::Attachment.where(
+          record_type: "Card",
+          name: "image",
+          record_id: card_ids || Card.none.select(:id)
+        )
+
+        rich_text_ids = ActionText::RichText.none.select(:id)
+
+        if board_ids
+          rich_text_ids = rich_text_ids.or(
+            ActionText::RichText.where(record_type: "Board", name: "public_description", record_id: board_ids)
+              .select(:id)
+          )
+        end
+
+        if card_ids
+          rich_text_ids = rich_text_ids.or(
+            ActionText::RichText.where(record_type: "Card", name: "description", record_id: card_ids)
+              .select(:id)
+          )
+        end
+
+        if comment_ids
+          rich_text_ids = rich_text_ids.or(
+            ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comment_ids)
+              .select(:id)
+          )
+        end
+
+        embedded_attachments = ActiveStorage::Attachment.where(
+          record_type: "ActionText::RichText",
+          name: "embeds",
+          record_id: rich_text_ids
+        )
+
+        direct_attachments.or(embedded_attachments).select(:id)
+      end
+  end
+end
