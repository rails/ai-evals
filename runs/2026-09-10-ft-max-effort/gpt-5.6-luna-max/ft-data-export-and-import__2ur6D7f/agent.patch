diff --git a/app/models/account/data_transfer/archive.rb b/app/models/account/data_transfer/archive.rb
new file mode 100644
index 0000000..44065c8
--- /dev/null
+++ b/app/models/account/data_transfer/archive.rb
@@ -0,0 +1,69 @@
+require "zip_kit/file_reader"
+
+class Account::DataTransfer::Archive
+  MAX_ENTRY_NAME_BYTES = 1_024
+
+  attr_reader :io, :entries
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+    validate_entries!
+  end
+
+  def entry(path)
+    entries_by_path.fetch(path) { raise ArgumentError, "Archive is missing #{path}" }
+  end
+
+  def each_path(pattern = "*")
+    return enum_for(__method__, pattern) unless block_given?
+
+    entries.each do |archive_entry|
+      if File.fnmatch(pattern, archive_entry.filename)
+        yield archive_entry.filename
+      end
+    end
+  end
+
+  def read(path)
+    extractor = entry(path).extractor_from(io)
+    output = String.new(encoding: Encoding::BINARY)
+    output << extractor.extract(1.megabyte) until extractor.eof?
+    output.force_encoding(Encoding::UTF_8)
+  end
+
+  def extract_to(path, output)
+    extractor = entry(path).extractor_from(io)
+    output.binmode if output.respond_to?(:binmode)
+    output.write(extractor.extract(1.megabyte)) until extractor.eof?
+    output.flush if output.respond_to?(:flush)
+    output
+  end
+
+  private
+    def entries_by_path
+      @entries_by_path ||= entries.index_by(&:filename)
+    end
+
+    def validate_entries!
+      if entries.empty?
+        raise ArgumentError, "Archive is empty"
+      end
+
+      if entries.any? { |archive_entry| archive_entry.filename.bytesize > MAX_ENTRY_NAME_BYTES }
+        raise ArgumentError, "Archive contains an invalid filename"
+      end
+
+      if entries.any? { |archive_entry| invalid_path?(archive_entry.filename) }
+        raise ArgumentError, "Archive contains an invalid filename"
+      end
+
+      if entries.map(&:filename).uniq.length != entries.length
+        raise ArgumentError, "Archive contains duplicate filenames"
+      end
+    end
+
+    def invalid_path?(path)
+      path.start_with?("/") || path.include?("\\") || path.split("/").include?("..") || path.include?("\0")
+    end
+end
diff --git a/app/models/account/data_transfer/association_record_set.rb b/app/models/account/data_transfer/association_record_set.rb
new file mode 100644
index 0000000..0fc2fcd
--- /dev/null
+++ b/app/models/account/data_transfer/association_record_set.rb
@@ -0,0 +1,43 @@
+class Account::DataTransfer::AssociationRecordSet
+  attr_reader :account, :table_name, :attributes
+
+  def initialize(account:, table_name:, account_association:, foreign_key:)
+    @account = account
+    @table_name = table_name
+    @account_association = account_association
+    @foreign_key = foreign_key
+    @attributes = ApplicationRecord.connection.columns(table_name).map(&:name)
+  end
+
+  def write_to(zip)
+    each_record.with_index do |record, index|
+      zip.add_file("#{table_name}/#{index}.json", JSON.generate(record))
+    end
+  end
+
+  def each_record
+    return enum_for(__method__) unless block_given?
+
+    records.each { |record| yield record }
+  end
+
+  private
+    attr_reader :account_association, :foreign_key
+
+    def records
+      ids = account.public_send(account_association).ids
+      return [] if ids.empty?
+
+      quoted_ids = ids.map { |id| ApplicationRecord.connection.quote(ActiveRecord::Type::Uuid.new.serialize(id)) }.join(", ")
+      quoted_table = ApplicationRecord.connection.quote_table_name(table_name)
+      column_types = ApplicationRecord.connection.columns(table_name).index_by(&:name)
+
+      ApplicationRecord.connection.select_all(
+        "SELECT * FROM #{quoted_table} WHERE #{foreign_key} IN (#{quoted_ids})"
+      ).to_a.map do |record|
+        record.each_with_object({}) do |(name, value), cast_record|
+          cast_record[name] = column_types.fetch(name).cast_type.deserialize(value)
+        end
+      end
+    end
+end
