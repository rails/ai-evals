diff --git a/app/models/card/data_transfer/exporter.rb b/app/models/card/data_transfer/exporter.rb
new file mode 100644
index 0000000..d32bc4f
--- /dev/null
+++ b/app/models/card/data_transfer/exporter.rb
@@ -0,0 +1,118 @@
+class Card::DataTransfer::Exporter
+  ARCHIVE_FILENAME = "fizzy-cards-export.zip"
+  ARCHIVE_VERSION = 1
+
+  def initialize(account:, user:)
+    @account = account
+    @user = user
+  end
+
+  def write_to(attachment)
+    ZipFile.create_for(attachment, filename: ARCHIVE_FILENAME) do |zip|
+      zip.add_file("fizzy.json", JSON.generate(
+        version: ARCHIVE_VERSION,
+        kind: "cards",
+        account_id: @account.id,
+        user_id: @user.id,
+        created_at: Time.current.utc.iso8601
+      ))
+
+      visible_cards.find_each do |card|
+        write_card(zip, card)
+      end
+    end
+  end
+
+  private
+    def visible_cards
+      @user.accessible_cards.where(account_id: @account.id).distinct
+    end
+
+    def write_card(zip, card)
+      attachments = card_attachments(card)
+      attachment_paths = attachments.each_with_index.map do |attachment, index|
+        path = attachment_path(card, attachment, index)
+        write_attachment(zip, attachment, path)
+        {
+          "path" => path,
+          "filename" => attachment.blob.filename.to_s,
+          "content_type" => attachment.blob.content_type,
+          "byte_size" => attachment.blob.byte_size,
+          "name" => attachment.name,
+          "record_type" => attachment.record_type
+        }
+      end
+
+      zip.add_file("cards/#{card.number}.json", JSON.generate(card_json(card, attachment_paths)))
+    end
+
+    def card_json(card, attachment_paths)
+      {
+        "id" => card.id,
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "due_on" => card.due_on&.iso8601,
+        "created_at" => card.created_at&.utc&.iso8601,
+        "updated_at" => card.updated_at&.utc&.iso8601,
+        "last_active_at" => card.last_active_at&.utc&.iso8601,
+        "description" => card.description.to_plain_text,
+        "description_html" => card.description.to_s,
+        "board" => { "id" => card.board.id, "name" => card.board.name },
+        "column" => card.column && { "id" => card.column.id, "name" => card.column.name },
+        "creator" => person_json(card.creator),
+        "assignees" => card.assignees.map { |assignee| person_json(assignee) },
+        "tags" => card.tags.order(:title).pluck(:title),
+        "comments" => card.comments.chronologically.map { |comment| comment_json(comment) },
+        "attachments" => attachment_paths
+      }
+    end
+
+    def comment_json(comment)
+      {
+        "id" => comment.id,
+        "created_at" => comment.created_at&.utc&.iso8601,
+        "updated_at" => comment.updated_at&.utc&.iso8601,
+        "body" => comment.body.to_plain_text,
+        "body_html" => comment.body.to_s,
+        "creator" => person_json(comment.creator)
+      }
+    end
+
+    def person_json(user)
+      {
+        "id" => user.id,
+        "name" => user.name,
+        "email_address" => user.identity&.email_address,
+        "role" => user.role
+      }
+    end
+
+    def card_attachments(card)
+      comments = card.comments.to_a
+      rich_texts = [ card.description, *comments.map(&:body) ].compact
+      scopes = [
+        ActiveStorage::Attachment.where(record_type: "Card", record_id: card.id),
+        *comments.map { |comment| ActiveStorage::Attachment.where(record_type: "Comment", record_id: comment.id) },
+        ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.map(&:id))
+      ]
+
+      scopes.reduce { |attachments, scope| attachments.or(scope) }
+        .includes(:blob)
+        .order(:created_at, :id)
+        .to_a
+    end
+
+    def attachment_path(card, attachment, index)
+      filename = ActiveStorage::Filename.new(attachment.blob.filename.to_s).sanitized
+      "files/#{card.number}/#{index}-#{filename}"
+    end
+
+    def write_attachment(zip, attachment, path)
+      zip.add_file(path, compress: false) do |sink|
+        attachment.blob.open do |io|
+          IO.copy_stream(io, sink)
+        end
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..d057c43
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,46 @@
+class Export < ApplicationRecord
+  DOWNLOAD_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, { account: "account", cards: "cards" }, scopes: false
+  enum :status, { pending: "pending", processing: "processing", completed: "completed", failed: "failed" }, scopes: false
+
+  validates :kind, presence: true
+
+  def generate
+    update!(status: :processing)
+
+    if account?
+      Account::DataTransfer::Exporter.new(account).write_to(file)
+    elsif cards?
+      Card::DataTransfer::Exporter.new(account: account, user: user).write_to(file)
+    else
+      raise ArgumentError, "Unknown export kind: #{kind.inspect}"
+    end
+
+    update!(status: :completed, completed_at: Time.current, expires_at: DOWNLOAD_EXPIRY.from_now)
+    DataTransferMailer.export_ready(self).deliver_later
+  rescue StandardError => error
+    file.purge if file.attached?
+    update_columns(status: "failed", error: error.message, updated_at: Time.current) if persisted?
+    DataTransferMailer.export_failed(self).deliver_later if persisted?
+    raise
+  end
+
+  def downloadable?
+    completed? && file.attached? && (expires_at.blank? || expires_at.future?)
+  end
+
+  def download_id
+    @download_id ||= signed_id(purpose: :download, expires_in: DOWNLOAD_EXPIRY)
+  end
+
+  def download_url
+    url_options = ActionMailer::Base.default_url_options.merge(script_name: account.slug)
+    Rails.application.routes.url_helpers.download_export_url(download_id, **url_options)
+  end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..ed760ac
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,27 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, { pending: "pending", processing: "processing", completed: "completed", failed: "failed" }, scopes: false
+
+  validate :file_must_be_attached, on: :create
+
+  def process
+    update!(status: :processing)
+    imported_account = Account::DataTransfer::Importer.new(self).import
+    update!(status: :completed, completed_at: Time.current)
+    DataTransferMailer.import_completed(self, imported_account).deliver_later
+    imported_account
+  rescue StandardError => error
+    update_columns(status: "failed", error: error.message, updated_at: Time.current) if persisted?
+    DataTransferMailer.import_failed(self).deliver_later if persisted?
+    raise
+  end
+
+  private
+    def file_must_be_attached
+      errors.add(:file, "must be attached") unless file.attached?
+    end
+end
