@@ -0,0 +1,33 @@
+class Exports::DownloadsController < ApplicationController
+  allow_unauthenticated_access
+
+  def show
+    export = Export.find_signed!(params[:id], purpose: :download)
+    return head :not_found unless export.account == Current.account
+    return head :gone unless export.downloadable?
+
+    ActiveStorage::Current.url_options = {
+      protocol: request.protocol,
+      host: request.host,
+      port: request.port,
+      script_name: request.script_name
+    }
+
+    redirect_to export.file.url(
+      expires_in: [ Export::DOWNLOAD_EXPIRY, export.expires_at && export.expires_at - Time.current ].compact.min,
+      disposition: "attachment",
+      filename: download_filename(export)
+    )
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    head :not_found
+  end
+
+  private
+    def download_filename(export)
+      if export.account?
+        "#{export.account.name.parameterize}-export.zip"
+      else
+        "#{export.account.name.parameterize}-cards.zip"
+      end
+    end
+end
