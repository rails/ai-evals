diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..39f5793
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,29 @@
+require "zip_kit/file_reader"
+
+class ZipFile::Reader
+  attr_reader :io, :entries
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def each(pattern = "*")
+    return enum_for(__method__, pattern) unless block_given?
+
+    entries.each do |entry|
+      yield entry if File.fnmatch(pattern, entry.filename)
+    end
+  end
+
+  def read(path)
+    extractor = entry(path).extractor_from(io)
+    content = String.new(encoding: Encoding::BINARY)
+    content << extractor.extract(1.megabyte) until extractor.eof?
+    content
+  end
+
+  def entry(path)
+    entries.find { |entry| entry.filename == path } || raise(ArgumentError, "Archive is missing #{path}")
+  end
+end
