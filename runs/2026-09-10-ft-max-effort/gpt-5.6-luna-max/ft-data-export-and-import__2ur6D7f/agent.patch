+class Account::DataTransfer::Exporter
+  ARCHIVE_FILENAME = "fizzy-account-export.zip"
+  ARCHIVE_VERSION = 1
+
+  def initialize(account)
+    @account = account
+  end
+
+  def write_to(attachment)
+    ZipFile.create_for(attachment, filename: ARCHIVE_FILENAME) do |zip|
+      zip.add_file("fizzy.json", JSON.generate(
+        version: ARCHIVE_VERSION,
+        kind: "account",
+        account_id: @account.id,
+        created_at: Time.current.utc.iso8601
+      ))
+
+      Account::DataTransfer::Manifest.new(@account).each_record_set do |record_set|
+        record_set.write_to(zip)
+      end
+    end
+  end
+end
