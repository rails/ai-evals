diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..328220b
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,445 @@
+class Account::DataTransfer::Importer
+  BATCH_SIZE = 500
+
+  MODEL_CLASSES = [
+    Account,
+    Identity,
+    User,
+    User::Settings,
+    Tag,
+    Board,
+    Column,
+    Entropy,
+    Board::Publication,
+    Webhook,
+    Access,
+    Card,
+    Comment,
+    Step,
+    Assignment,
+    Tagging,
+    Closure,
+    Card::Goldness,
+    Card::NotNow,
+    Card::ActivitySpike,
+    Watch,
+    Pin,
+    Reaction,
+    Mention,
+    Filter,
+    Webhook::DelinquencyTracker,
+    Event,
+    Notification,
+    Notification::Bundle,
+    Webhook::Delivery,
+    ActiveStorage::Blob,
+    ActiveStorage::VariantRecord,
+    ActiveStorage::Attachment,
+    ActionText::RichText
+  ].freeze
+
+  JOIN_TABLES = %w[boards_filters filters_tags assignees_filters assigners_filters creators_filters closers_filters].freeze
+
+  TABLE_ORDER = %w[
+    accounts
+    identities
+    users
+    user_settings
+    tags
+    boards
+    columns
+    entropies
+    board_publications
+    webhooks
+    accesses
+    cards
+    comments
+    steps
+    assignments
+    taggings
+    closures
+    card_goldnesses
+    card_not_nows
+    card_activity_spikes
+    watches
+    pins
+    reactions
+    mentions
+    filters
+    boards_filters
+    filters_tags
+    assignees_filters
+    assigners_filters
+    creators_filters
+    closers_filters
+    webhook_delinquency_trackers
+    events
+    notifications
+    notification_bundles
+    webhook_deliveries
+    active_storage_blobs
+    active_storage_variant_records
+    action_text_rich_texts
+    active_storage_attachments
+  ].freeze
+
+  def initialize(import)
+    @import = import
+    @created_blob_keys = []
+    @id_map = {}
+    @paths_by_table = Hash.new { |paths, table| paths[table] = [] }
+    @join_models = {}
+    @embed_blob_ids_by_rich_text = Hash.new { |ids, rich_text_id| ids[rich_text_id] = [] }
+  end
+
+  def import
+    @import.file.blob.open do |archive_io|
+      archive = Account::DataTransfer::Archive.new(archive_io)
+      @archive = archive
+      validate_archive!(archive)
+      index_archive!(archive)
+
+      ApplicationRecord.transaction(requires_new: true) do
+        @account = create_account
+        import_identities
+        import_tables
+        owner = ensure_importer_is_an_owner
+        Current.set(account: @account, user: owner, identity: owner.identity) do
+          @account.boards.find_each do |board|
+            board.reconcile_storage
+            board.materialize_storage
+          end
+          @account.reconcile_storage
+          @account.materialize_storage
+          @account.cards.published.find_each(&:reindex)
+          Comment.where(account_id: @account.id).joins(:card).merge(Card.published).find_each(&:reindex)
+        end
+      end
+    end
+
+    @account
+  rescue StandardError
+    purge_created_blobs
+    @account&.destroy! if @account&.persisted?
+    raise
+  ensure
+    @archive = nil
+  end
+
+  private
+    def validate_archive!(archive)
+      metadata = JSON.parse(archive.read("fizzy.json"))
+
+      unless metadata["version"].to_i == 1 && metadata["kind"] == "account"
+        raise ArgumentError, "This is not a Fizzy account export"
+      end
+
+      @source_account_id = metadata["account_id"]
+      raise ArgumentError, "This is not a valid Fizzy account export" if @source_account_id.blank?
+    rescue JSON::ParserError, KeyError
+      raise ArgumentError, "This is not a valid Fizzy account export"
+    end
+
+    def index_archive!(archive)
+      archive.each_path do |path|
+        next unless path.end_with?(".json")
+        next if path == "fizzy.json"
+
+        table, filename = path.split("/", 2)
+        next unless filename&.end_with?(".json")
+
+        @paths_by_table[table] << path
+        attributes = JSON.parse(archive.read(path))
+        if attributes["account_id"].present? && attributes["account_id"] != @source_account_id
+          raise ArgumentError, "Archive contains records from another account"
+        end
+        if table == "active_storage_attachments" && attributes["record_type"] == "ActionText::RichText" && attributes["name"] == "embeds"
+          @embed_blob_ids_by_rich_text[attributes["record_id"]] << attributes["blob_id"]
+        end
+        source_id = attributes["id"]
+        next if source_id.blank?
+
+        if @id_map.key?(source_id) && @id_map[source_id] != source_id
+          raise ArgumentError, "Archive contains duplicate record IDs"
+        end
+
+        @id_map[source_id] ||= ActiveRecord::Type::Uuid.generate
+        if table == "accounts"
+          @source_account_id ||= source_id
+        end
+      rescue JSON::ParserError
+        raise ArgumentError, "Archive contains invalid JSON"
+      end
+
+      if @paths_by_table["accounts"].empty?
+        raise ArgumentError, "Archive does not contain an account"
+      end
+
+      unknown_tables = @paths_by_table.keys - TABLE_ORDER
+      if unknown_tables.any?
+        raise ArgumentError, "Archive contains unsupported records: " + unknown_tables.join(", ")
+      end
+
+      if @paths_by_table["accounts"].length != 1
+        raise ArgumentError, "Archive must contain exactly one account"
+      end
+
+      @source_account_id ||= JSON.parse(archive.read(@paths_by_table["accounts"].first))["id"]
+      unless @id_map.key?(@source_account_id)
+        raise ArgumentError, "Archive does not contain a valid account"
+      end
+    end
+
+    def create_account
+      source = read_record(@archive, @paths_by_table["accounts"].first)
+      target_attributes = mapped_attributes(source)
+      target_attributes.delete("external_account_id")
+      target_attributes["id"] = @id_map.fetch(source.fetch("id"))
+
+      Account.create!(target_attributes)
+    end
+
+    def import_identities
+      each_record("identities") do |source_attributes|
+        source_id = source_attributes.fetch("id")
+        identity = Identity.find_by(email_address: source_attributes["email_address"])
+
+        if identity
+          @id_map[source_id] = identity.id
+        else
+          Identity.insert_all!([ mapped_attributes(source_attributes) ])
+        end
+      end
+    end
+
+    def import_tables
+      TABLE_ORDER.drop(2).each do |table|
+        next if table == "identities"
+        next if @paths_by_table[table].empty?
+
+        if table == "active_storage_blobs"
+          import_blobs
+        elsif table == "active_storage_attachments"
+          import_attachments
+        elsif table == "action_text_rich_texts"
+          import_rich_texts
+        elsif table == "entropies"
+          import_entropies
+        else
+          import_model_records(table)
+        end
+      end
+    end
+
+    def import_model_records(table)
+      model = model_for_table(table)
+      raise ArgumentError, "Archive contains unsupported records: #{table}" unless model
+
+      rows = []
+      each_record(table) do |source_attributes|
+        rows << mapped_attributes(source_attributes)
+        if rows.size >= BATCH_SIZE
+          model.insert_all!(rows)
+          rows.clear
+        end
+      end
+      model.insert_all!(rows) if rows.any?
+    end
+
+    def import_entropies
+      model = Entropy
+      rows = []
+
+      each_record("entropies") do |source_attributes|
+        if source_attributes["container_type"] == "Account" && source_attributes["container_id"] == @source_account_id
+          entropy = @account.entropy || @account.create_entropy!(auto_postpone_period: source_attributes["auto_postpone_period"])
+          entropy.assign_attributes(mapped_attributes(source_attributes).except("id"))
+          entropy.save!
+          @id_map[source_attributes.fetch("id")] = entropy.id
+        else
+          rows << mapped_attributes(source_attributes)
+          if rows.size >= BATCH_SIZE
+            model.insert_all!(rows)
+            rows.clear
+          end
+        end
+      end
+
+      model.insert_all!(rows) if rows.any?
+    end
+
+    def import_blobs
+      each_record("active_storage_blobs") do |source_attributes|
+        source_id = source_attributes.fetch("id")
+        target_attributes = mapped_attributes(source_attributes)
+        target_attributes["id"] = @id_map.fetch(source_id)
+        target_attributes["key"] = ActiveStorage::Blob.generate_unique_secure_token
+        target_attributes["service_name"] = ActiveStorage::Blob.service.name
+
+        ActiveStorage::Blob.insert_all!([ target_attributes ])
+        blob = ActiveStorage::Blob.find(target_attributes["id"])
+        upload_blob(blob, source_id)
+      end
+    end
+
+    def upload_blob(blob, source_id)
+      path = "files/#{source_id}"
+      tempfile = Tempfile.new([ "fizzy-import", ".blob" ])
+      tempfile.binmode
+
+      @archive.extract_to(path, tempfile)
+      tempfile.rewind
+
+      unless tempfile.size == blob.byte_size
+        raise ArgumentError, "Attachment #{source_id} has an unexpected size"
+      end
+
+      service = ActiveStorage::Blob.services.fetch(blob.service_name)
+      @created_blob_keys << [ service, blob.key ]
+      service.upload(blob.key, tempfile, checksum: blob.checksum)
+    ensure
+      tempfile&.close
+      tempfile&.unlink
+    end
+
+    def import_rich_texts
+      rows = []
+      each_record("action_text_rich_texts") do |source_attributes|
+        attributes = mapped_attributes(source_attributes)
+        attributes["body"] = rewrite_embedded_blobs(source_attributes["body"], rich_text_id: source_attributes["id"])
+        rows << attributes
+        if rows.size >= BATCH_SIZE
+          ActionText::RichText.insert_all!(rows)
+          rows.clear
+        end
+      end
+      ActionText::RichText.insert_all!(rows) if rows.any?
+    end
+
+    def import_attachments
+      rows = []
+      each_record("active_storage_attachments") do |source_attributes|
+        attributes = mapped_attributes(source_attributes)
+        next if duplicate_attachment?(attributes)
+
+        rows << attributes
+        if rows.size >= BATCH_SIZE
+          ActiveStorage::Attachment.insert_all!(rows)
+          rows.clear
+        end
+      end
+      ActiveStorage::Attachment.insert_all!(rows) if rows.any?
+    end
+
+    def duplicate_attachment?(attributes)
+      ActiveStorage::Attachment.exists?(
+        record_type: attributes["record_type"],
+        record_id: attributes["record_id"],
+        name: attributes["name"]
+      )
+    end
+
+    def ensure_importer_is_an_owner
+      source_user = @import.user
+      target_identity_id = @id_map[source_user.identity_id]
+      target_user = User.find_by(account: @account, identity_id: target_identity_id) if target_identity_id
+
+      if target_user
+        target_user.update!(active: true, role: :owner, verified_at: target_user.verified_at || Time.current)
+      else
+        target_identity = Identity.find(target_identity_id)
+        target_user = @account.users.create!(
+          identity: target_identity,
+          name: source_user.name.presence || target_identity.email_address,
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+
+      @account.boards.find_each do |board|
+        Access.insert_all([ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: @account.id,
+          board_id: board.id,
+          user_id: target_user.id,
+          involvement: "access_only"
+        } ], unique_by: :index_accesses_on_board_id_and_user_id)
+      end
+
+      target_user
+    end
+
+    def rewrite_embedded_blobs(body, rich_text_id:)
+      return body unless body.present?
+
+      attachment_index = 0
+      body.to_s.gsub(/sgid=(['"])([^'"]+)\1/) do |match|
+        quote = Regexp.last_match(1)
+        sgid = Regexp.last_match(2)
+        source_blob = begin
+          GlobalID::Locator.locate_signed(sgid, for: ActionText::Attachable::LOCATOR_NAME)
+        rescue GlobalID::IdentificationError, ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+          nil
+        end
+        source_blob_id = source_blob&.id || @embed_blob_ids_by_rich_text[rich_text_id][attachment_index]
+        target_blob = ActiveStorage::Blob.find_by(id: @id_map[source_blob_id])
+        attachment_index += 1
+
+        if target_blob&.respond_to?(:attachable_sgid)
+          "sgid=#{quote}#{target_blob.attachable_sgid}#{quote}"
+        else
+          match
+        end
+      end
+    end
+
+    def each_record(table)
+      return enum_for(__method__, table) unless block_given?
+
+      @paths_by_table.fetch(table, []).each do |path|
+        yield read_record(@archive, path)
+      end
+    end
+
+    def read_record(archive, path)
+      JSON.parse(archive.read(path))
+    rescue JSON::ParserError
+      raise ArgumentError, "Archive contains invalid JSON"
+    end
+
+    def mapped_attributes(source_attributes)
+      source_attributes.each_with_object({}) do |(name, value), attributes|
+        attributes[name] = if maps_identifier?(name) && value.present?
+          @id_map.fetch(value, value)
+        else
+          value
+        end
+      end
+    end
+
+    def maps_identifier?(name)
+      name == "id" || name.end_with?("_id") || name.in?(%w[record_id])
+    end
+
+    def model_for_table(table)
+      if JOIN_TABLES.include?(table)
+        @join_models[table] ||= Class.new(ApplicationRecord) do
+          self.table_name = table
+        end
+      else
+        MODEL_CLASSES.find { |model| model.table_name == table }
+      end
+    end
+
+    def purge_created_blobs
+      @created_blob_keys.each do |service, key|
+        service.delete(key)
+      rescue StandardError
+        nil
+      end
+    end
+
+    def archive
+      @archive || raise(ArgumentError, "Archive has not been opened")
+    end
+end
