diff --git a/test/controllers/data_transfers_controller_test.rb b/test/controllers/data_transfers_controller_test.rb
new file mode 100644
index 0000000..acebff0
--- /dev/null
+++ b/test/controllers/data_transfers_controller_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class DataTransfersControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "an admin can request an account export" do
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with job: ExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "a non-admin cannot request an account export" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a signed export link redirects to the archive" do
+    account = Current.account
+    user = users(:kevin)
+    export = account.exports.create!(user: user, kind: :cards, status: :completed, completed_at: Time.current, expires_at: 1.day.from_now)
+    ZipFile.create_for(export.file, filename: "cards.zip") do |zip|
+      zip.add_file("fizzy.json", "{}")
+    end
+
+    get download_export_path(export.download_id)
+
+    assert_response :redirect
+    assert_match %r{/rails/active_storage/}, response.location
+  end
+
+  test "an expired export link is gone" do
+    account = Current.account
+    user = users(:kevin)
+    export = account.exports.create!(user: user, kind: :cards, status: :completed, completed_at: Time.current, expires_at: 1.minute.ago)
+
+    get download_export_path(export.download_id)
+
+    assert_response :gone
+  end
+end
diff --git a/test/models/data_transfer_failure_test.rb b/test/models/data_transfer_failure_test.rb
new file mode 100644
index 0000000..5fcb912
--- /dev/null
+++ b/test/models/data_transfer_failure_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class DataTransferFailureTest < ActiveSupport::TestCase
+  test "a failed import after a blob upload leaves no account behind" do
+    account = accounts("37s")
+    user = users("jason")
+    Current.set(account: account, user: user, identity: user.identity) do
+      cards("logo").image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      export = account.exports.create!(user: user, kind: :account)
+      export.generate
+
+      imported = account.imports.new(user: user)
+      imported.file.attach(io: StringIO.new(export.file.blob.download), filename: "account.zip", content_type: "application/zip")
+      imported.save!
+      ActiveStorage::Service::DiskService.any_instance.stubs(:upload).raises(IOError, "storage unavailable")
+
+      assert_raises(IOError) { imported.process }
+      assert imported.reload.failed?
+      assert_equal 0, Account.where(name: account.name).where.not(id: account.id).count
+    end
+  end
+end
diff --git a/test/models/data_transfer_round_trip_test.rb b/test/models/data_transfer_round_trip_test.rb
new file mode 100644
index 0000000..3b37f57
--- /dev/null
+++ b/test/models/data_transfer_round_trip_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class DataTransferRoundTripTest < ActiveSupport::TestCase
+  test "account exports and imports all records" do
+    account = accounts("37s")
+    user = users("jason")
+    Current.set(account: account, user: user, identity: user.identity) do
+      filter = user.filters.create!(board_ids: [ boards(:writebook).id ])
+      cards("logo").image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      cards("logo").description = %(<p>See this picture</p><action-text-attachment sgid="#{cards("logo").image.blob.attachable_sgid}" content-type="image/jpeg" filename="moon.jpg"></action-text-attachment>)
+      cards("logo").save!
+      export = account.exports.create!(user: user, kind: :account)
+      export.generate
+
+      assert export.completed?
+      assert export.file.attached?
+      assert_includes DataTransferMailer.export_ready(export).encoded, "/exports/"
+
+      imported = account.imports.new(user: user)
+      imported.file.attach(io: StringIO.new(export.file.blob.download), filename: "account.zip", content_type: "application/zip")
+      imported.save!
+      new_account = imported.process
+
+      assert_not_equal account.id, new_account.id
+      assert_equal account.name, new_account.name
+      assert_equal account.boards.count, new_account.boards.count
+      assert_equal account.cards.count, new_account.cards.count
+      assert_equal Comment.where(account: account).count, Comment.where(account: new_account).count
+      assert new_account.users.where(identity: user.identity).exists?
+      imported_card = new_account.cards.find_by(number: cards("logo").number)
+      assert imported_card.image.attached?
+      assert_includes imported_card.description.to_s, "action-text-attachment"
+      assert ActionText::Attachable.from_attachable_sgid(imported_card.description.body.attachables.first.attachable_sgid)
+      assert_equal cards("logo").image.blob.download, imported_card.image.blob.download
+      imported_filter = new_account.filters.find_by(params_digest: filter.params_digest)
+      assert_equal [ new_account.boards.find_by(name: boards(:writebook).name).id ], imported_filter.boards.ids
+      assert new_account.users.where(identity: user.identity).first.owner?
+    end
+  end
+
+  test "card export includes visible cards, comments, and attachments" do
+    account = accounts("37s")
+    user = users("kevin")
+    card = cards("logo")
+    Current.set(account: account, user: user, identity: user.identity) do
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      export = account.exports.create!(user: user, kind: :cards)
+      export.generate
+
+      export.file.blob.open do |io|
+        archive = Account::DataTransfer::Archive.new(io)
+        card_json = JSON.parse(archive.read("cards/#{card.number}.json"))
+        assert_equal card.comments.count, card_json.fetch("comments").size
+        assert_equal 1, card_json.fetch("attachments").size
+        assert_equal "moon.jpg", card_json.fetch("attachments").first.fetch("filename")
+        assert archive.each_path("files/*").any?
+      end
+    end
+  end
+
+  test "a malformed import leaves no account behind" do
+    account = accounts("37s")
+    user = users("jason")
+    Current.set(account: account, user: user, identity: user.identity) do
+      imported = account.imports.new(user: user)
+      imported.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip")
+      imported.save!
+
+      assert_raises(StandardError) do
+        imported.process
+      end
+
+      assert imported.reload.failed?
+      assert_equal 0, Account.where(name: account.name).where.not(id: account.id).count
+    end
+  end
+end
