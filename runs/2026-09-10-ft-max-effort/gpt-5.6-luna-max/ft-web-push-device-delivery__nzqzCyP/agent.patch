@@ -0,0 +1,21 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    attributes = push_subscription_params
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: attributes[:endpoint])
+    subscription.update!(attributes.to_h.symbolize_keys)
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..0697380
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,124 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  static targets = [ "button", "details" ]
+
+  connect() {
+    this.busy = false
+    this.buttonTarget.disabled = !this.supported
+    this.hideDetails()
+    this.refresh()
+  }
+
+  async refresh() {
+    this.element.classList.remove("notifications--on")
+
+    if (!this.supported) return
+
+    if (Notification.permission === "denied") {
+      this.showDetails()
+    }
+
+    try {
+      const subscription = await this.subscription()
+      if (subscription) {
+        await this.save(subscription)
+        this.setEnabled()
+      }
+    } catch (error) {
+      console.error("Unable to load push notification settings", error)
+    }
+  }
+
+  async enable() {
+    if (!this.supported || this.busy) return
+
+    this.busy = true
+    this.buttonTarget.disabled = true
+
+    try {
+      const permission = Notification.permission === "granted" ? "granted" : await Notification.requestPermission()
+
+      if (permission === "granted") {
+        const subscription = await this.subscription({ subscribe: true })
+        await this.save(subscription)
+        this.setEnabled()
+      } else {
+        this.showDetails()
+      }
+    } catch (error) {
+      console.error("Unable to enable push notifications", error)
+      this.showDetails()
+    } finally {
+      this.buttonTarget.disabled = false
+      this.busy = false
+    }
+  }
+
+  get supported() {
+    return Boolean(
+      this.vapidPublicKeyValue &&
+      "Notification" in window &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window
+    )
+  }
+
+  async subscription({ subscribe = false } = {}) {
+    const registration = await navigator.serviceWorker.ready
+    const existingSubscription = await registration.pushManager.getSubscription()
+
+    if (existingSubscription || !subscribe) return existingSubscription
+
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.applicationServerKey
+    })
+  }
+
+  async save(subscription) {
+    const serialized = subscription.toJSON()
+    const response = await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": document.querySelector("meta[name=csrf-token]")?.content
+      },
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: serialized.endpoint,
+          p256dh_key: serialized.keys.p256dh,
+          auth_key: serialized.keys.auth
+        }
+      })
+    })
+
+    if (!response.ok) throw new Error(`Push subscription registration failed: ${response.status}`)
+  }
+
+  setEnabled() {
+    this.element.classList.add("notifications--on")
+    this.hideDetails()
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach((details) => { details.hidden = false })
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach((details) => { details.hidden = true })
+  }
+
+  get applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push_notification_job.rb b/app/jobs/push_notification_job.rb
