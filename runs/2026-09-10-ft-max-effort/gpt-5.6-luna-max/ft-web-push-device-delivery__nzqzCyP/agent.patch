@@ -0,0 +1,39 @@
+class Notification::PushPayload
+  include NotificationsHelper
+  include Rails.application.routes.url_helpers
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def to_h
+    {
+      title: title,
+      body: body,
+      url: card_path(notification.card, script_name: notification.account.slug)
+    }
+  end
+
+  def to_json(*)
+    to_h.to_json
+  end
+
+  private
+    attr_reader :notification
+
+    def title
+      case notification.source
+      when Event then event_notification_title(notification.source)
+      when Mention then "#{notification.source.mentioner.first_name} @mentioned you"
+      else notification.card.title.presence || "Card #{notification.card.number}"
+      end
+    end
+
+    def body
+      case notification.source
+      when Event then event_notification_body(notification.source)
+      when Mention then notification.source.source.mentionable_content.truncate(200)
+      else notification.creator.familiar_name
+      end
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..d860e1e
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,31 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  class << self
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+  end
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: notification.push_payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options
+    )
+  end
+
+  private
+    def vapid_options
+      {
+        subject: ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do"),
+        public_key: ENV.fetch("VAPID_PUBLIC_KEY"),
+        private_key: ENV.fetch("VAPID_PRIVATE_KEY")
+      }
+    end
+end
