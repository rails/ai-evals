@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = {
+      endpoint: "https://push.example.test/subscription",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    }
+  end
+
+  test "creates a push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :created
+    assert_equal @subscription.stringify_keys, @user.push_subscriptions.sole.attributes.slice("endpoint", "p256dh_key", "auth_key")
+  end
+
+  test "updates an existing subscription for the same endpoint" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: @subscription.merge(p256dh_key: "new-public-key", auth_key: "new-auth-key")
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-public-key", @user.push_subscriptions.sole.p256dh_key
+    assert_equal "new-auth-key", @user.push_subscriptions.sole.auth_key
+  end
+
+  test "cannot register a subscription for another user" do
+    assert_no_difference -> { users(:kevin).push_subscriptions.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/jobs/push_notification_job_test.rb b/test/jobs/push_notification_job_test.rb
new file mode 100644
index 0000000..ace5c9d
--- /dev/null
+++ b/test/jobs/push_notification_job_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class PushNotificationJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = PushSubscription.create!(
+      user: @notification.user,
+      endpoint: "https://push.example.test/subscription",
+      p256dh_key: "public-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "delivers the notification to every subscription" do
+    other_subscription = PushSubscription.create!(
+      user: @notification.user,
+      endpoint: "https://push.example.test/other-subscription",
+      p256dh_key: "other-public-key",
+      auth_key: "other-auth-key"
+    )
+
+    with_env("VAPID_PUBLIC_KEY" => "public-vapid-key", "VAPID_PRIVATE_KEY" => "private-vapid-key") do
+      WebPush.expects(:payload_send).with do |options|
+        options[:message] == @notification.push_payload.to_json &&
+          options[:endpoint].in?([ @subscription.endpoint, other_subscription.endpoint ]) &&
+          options[:p256dh].in?([ @subscription.p256dh_key, other_subscription.p256dh_key ]) &&
+          options[:auth].in?([ @subscription.auth_key, other_subscription.auth_key ]) &&
+          options[:vapid][:public_key] == "public-vapid-key" &&
+          options[:vapid][:private_key] == "private-vapid-key"
+      end.twice.returns(nil)
+
+      PushNotificationJob.perform_now(@notification)
+    end
+  end
+
+  test "does not send when VAPID credentials are not configured" do
+    WebPush.expects(:payload_send).never
+
+    PushNotificationJob.perform_now(@notification)
+  end
+
+  private
+    def with_env(values)
+      originals = values.keys.index_with { |key| ENV[key] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
