diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..8d8a578
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :never)
+    notifications(:layout_commented_kevin).destroy!
+    notifications(:buy_domain_sent_back_to_triage_kevin).destroy!
+    clear_enqueued_jobs
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "never does not create an email bundle" do
+    notification = create_notification(events(:layout_commented))
+
+    assert_empty @user.notification_email_bundles
+    assert_no_enqueued_jobs only: Notification::EmailBundleJob
+  end
+
+  test "notification creation opens a bundle for the person" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david), unread_count: 1)
+    bundle = @user.notification_email_bundles.active.first
+
+    assert_equal [ notification ], bundle.notifications.to_a
+    assert_equal 1.day, bundle.ends_at - bundle.starts_at
+    assert_enqueued_with job: Notification::EmailBundleJob, args: [ bundle ]
+  end
+
+  test "frequency controls the window length" do
+    {
+      every_few_hours: 4.hours,
+      daily: 1.day,
+      weekly: 1.week
+    }.each do |frequency, period|
+      @user.settings.update!(bundle_email_frequency: frequency)
+      notification = create_notification(events(:layout_commented))
+      bundle = Notification::EmailBundle.schedule(notification, at: Time.current)
+
+      assert_equal period, bundle.ends_at - bundle.starts_at
+      bundle.destroy!
+      notification.destroy!
+    end
+  end
+
+  test "notifications in the same window share one bundle" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    first = create_notification(events(:layout_commented))
+    first_bundle = Notification::EmailBundle.schedule(first, at: Time.utc(2026, 1, 1, 12))
+
+    second = create_notification(events(:buy_domain_sent_back_to_triage))
+    second_bundle = Notification::EmailBundle.schedule(second, at: Time.utc(2026, 1, 1, 13))
+
+    assert_equal first_bundle, second_bundle
+    assert_equal [ first, second ].sort_by(&:id), first_bundle.notifications.order(:id).to_a
+    assert_equal 1, @user.notification_email_bundles.count
+  end
+
+  test "a later window starts when the previous one ends" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    first = create_notification(events(:layout_commented))
+    first_bundle = Notification::EmailBundle.schedule(first, at: Time.utc(2026, 1, 1, 12))
+
+    second = create_notification(events(:buy_domain_sent_back_to_triage))
+    second_bundle = Notification::EmailBundle.schedule(second, at: first_bundle.ends_at)
+
+    assert_not_equal first_bundle, second_bundle
+    assert_equal first_bundle.ends_at, second_bundle.starts_at
+    assert_operator second_bundle.starts_at, :>=, first_bundle.ends_at
+    assert_equal 2, @user.notification_email_bundles.count
+    assert_nil first_bundle.reload.active
+  end
+
+  test "a late timestamp cannot create an overlapping window" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    first = create_notification(events(:layout_commented))
+    first_bundle = Notification::EmailBundle.schedule(first, at: Time.utc(2026, 1, 1, 12))
+    first_bundle.update!(active: nil, sent_at: first_bundle.ends_at)
+
+    late = create_notification(events(:buy_domain_sent_back_to_triage))
+    second_bundle = Notification::EmailBundle.schedule(late, at: Time.utc(2026, 1, 1, 13))
+
+    assert_equal first_bundle.ends_at, second_bundle.starts_at
+    assert_operator second_bundle.starts_at, :>=, first_bundle.ends_at
+  end
+
+  test "turning email notifications off prevents a pending bundle from being sent" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    notification = create_notification(events(:layout_commented))
+    bundle = Notification::EmailBundle.schedule(notification, at: Time.current)
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to bundle.ends_at do
+      bundle.deliver
+    end
+
+    assert_empty ActionMailer::Base.deliveries
+    assert bundle.reload.sent_at.present?
+  end
+
+  test "one email is sent for all notifications in a bundle" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    first = create_notification(events(:layout_commented))
+    bundle = Notification::EmailBundle.schedule(first, at: Time.utc(2026, 1, 1, 12))
+    second = create_notification(events(:buy_domain_sent_back_to_triage))
+    Notification::EmailBundle.schedule(second, at: Time.utc(2026, 1, 1, 13))
+
+    travel_to bundle.ends_at do
+      perform_enqueued_jobs only: Notification::EmailBundleJob
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    email = ActionMailer::Base.deliveries.first
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "Layout is broken", email.body.encoded
+    assert_match "Buy domain", email.body.encoded
+    assert bundle.reload.sent_at.present?
+  end
+
+  private
+    def create_notification(event)
+      frequency = @user.settings.bundle_email_frequency
+      @user.settings.update!(bundle_email_frequency: :never) unless frequency == "never"
+      notification = Notification.create!(user: @user, source: event, creator: users(:david), unread_count: 1)
+      @user.settings.update!(bundle_email_frequency: frequency) unless frequency == "never"
+      notification
+    end
+end
