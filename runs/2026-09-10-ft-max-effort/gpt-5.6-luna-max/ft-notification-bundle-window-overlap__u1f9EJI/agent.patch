diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..8df9bc2
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,113 @@
+class Notification::EmailBundle < ApplicationRecord
+  FREQUENCIES = User::Settings::BUNDLE_EMAIL_FREQUENCY_PERIODS.keys.freeze
+
+  belongs_to :account
+  belongs_to :user
+
+  has_many :items,
+    class_name: "Notification::EmailBundleItem",
+    foreign_key: :notification_email_bundle_id,
+    dependent: :destroy
+  has_many :notifications, through: :items
+
+  validates :frequency, inclusion: { in: FREQUENCIES }
+  validates :starts_at, :ends_at, presence: true
+
+  scope :active, -> { where(active: true) }
+  scope :pending, -> { where(sent_at: nil) }
+
+  class << self
+    def schedule(notification, at: Time.current)
+      return unless notification.emailable?
+
+      at = at.to_time.change(usec: 0)
+
+      bundle = nil
+      new_bundle = false
+      user = notification.user
+
+      user.with_lock do
+        settings = user.settings
+        frequency = settings&.bundle_email_frequency
+
+        if frequency.present? && frequency != "never"
+          bundle = active_bundle_for(user, at)
+
+          unless bundle
+            starts_at = [ at, latest_window_end_for(user) ].compact.max
+            bundle = user.notification_email_bundles.create!(
+              account: notification.account,
+              frequency: frequency,
+              starts_at: starts_at,
+              ends_at: starts_at + settings.bundle_email_period,
+              active: true
+            )
+            new_bundle = true
+          end
+
+          bundle.items.create_or_find_by!(notification: notification)
+        end
+      end
+
+      if new_bundle
+        Notification::EmailBundleJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+      end
+
+      bundle
+    rescue ActiveRecord::RecordNotUnique
+      retry
+    end
+
+    private
+      def latest_window_end_for(user)
+        user.notification_email_bundles.maximum(:ends_at)
+      end
+
+      def active_bundle_for(user, at)
+        user.notification_email_bundles
+          .active
+          .lock
+          .order(starts_at: :desc)
+          .first
+          .then do |bundle|
+            if bundle && bundle.sent_at.nil? && bundle.ends_at > at
+              bundle
+            else
+              bundle&.update!(active: nil)
+              nil
+            end
+          end
+      end
+  end
+
+  def deliver
+    if ends_at > Time.current
+      self.class.delivery_job.set(wait_until: ends_at).perform_later(self)
+      false
+    else
+      with_lock do
+        reload
+
+        unless sent_at.present? || ends_at > Time.current
+          update!(active: nil)
+
+          NotificationMailer.bundle(self).deliver_now if deliverable?
+          update!(sent_at: Time.current)
+        end
+      end
+
+      true
+    end
+  end
+
+  def deliverable?
+    user.reload
+    account.reload
+
+    user.active? && account.active? && user.identity.present? && user.settings.bundle_email_frequency != "never" && notifications.exists?
+  end
+
+  def self.delivery_job
+    Notification::EmailBundleJob
+  end
+end
