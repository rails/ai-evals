diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d951e21
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,197 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+
+  #draggedCard
+  #hoveredColumn
+  #pendingMoves = new WeakMap()
+
+  disconnect() {
+    this.#clearDragState()
+  }
+
+  dragstart(event) {
+    const card = this.#cardFor(event.target)
+
+    if (card) {
+      this.#draggedCard = card
+      card.classList.add("drag-and-drop__dragged-item")
+      card.setAttribute("aria-grabbed", "true")
+
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = "move"
+        event.dataTransfer.setData?.("text/plain", card.id)
+      }
+    }
+  }
+
+  dragenter(event) {
+    const column = this.#columnFor(event.target)
+
+    if (this.#draggedCard && column) {
+      event.preventDefault()
+      this.#setHoveredColumn(column)
+    }
+  }
+
+  dragover(event) {
+    const column = this.#columnFor(event.target)
+
+    if (this.#draggedCard && column) {
+      event.preventDefault()
+      event.dataTransfer && (event.dataTransfer.dropEffect = "move")
+      this.#setHoveredColumn(column)
+    }
+  }
+
+  dragleave(event) {
+    const column = this.#columnFor(event.target)
+
+    if (column && !column.contains(event.relatedTarget)) {
+      column.classList.remove("drag-and-drop__hover-container")
+      if (this.#hoveredColumn === column) {
+        this.#hoveredColumn = null
+      }
+    }
+  }
+
+  drop(event) {
+    event.preventDefault()
+
+    const card = this.#draggedCard
+    const destination = this.#columnFor(event.target)
+    const source = card && this.#columnFor(card)
+
+    this.#clearDragState()
+
+    if (card && source && destination && source !== destination) {
+      const move = this.#moveFor(card, destination)
+
+      if (move && this.#moveCard(card, destination)) {
+        this.#updateCount(source, -1)
+        this.#updateCount(destination, 1)
+        this.#saveMove(card, move)
+      }
+    }
+  }
+
+  dragend() {
+    this.#clearDragState()
+  }
+
+  #cardFor(element) {
+    const card = element?.closest?.("[data-drag-and-drop-target~='card']")
+    return card && this.cardTargets.includes(card) ? card : null
+  }
+
+  #columnFor(element) {
+    const column = element?.closest?.("[data-drag-and-drop-target~='column']")
+    return column && this.columnTargets.includes(column) ? column : null
+  }
+
+  #setHoveredColumn(column) {
+    if (this.#hoveredColumn !== column) {
+      this.#hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+      this.#hoveredColumn = column
+      column.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  #clearDragState() {
+    this.#draggedCard?.classList.remove("drag-and-drop__dragged-item")
+    this.#draggedCard?.removeAttribute("aria-grabbed")
+    this.columnTargets.forEach(column => column.classList.remove("drag-and-drop__hover-container"))
+    this.#draggedCard = null
+    this.#hoveredColumn = null
+  }
+
+  #moveFor(card, destination) {
+    const destinationType = destination.dataset.dragAndDropDestination
+
+    switch (destinationType) {
+      case "column":
+        if (card.dataset.cardTriageUrl && destination.dataset.dragAndDropColumnId) {
+          return {
+            method: "post",
+            url: this.#withColumn(card.dataset.cardTriageUrl, destination.dataset.dragAndDropColumnId)
+          }
+        }
+        break
+      case "maybe":
+        if (card.dataset.cardTriageUrl) {
+          return { method: "delete", url: card.dataset.cardTriageUrl }
+        }
+        break
+      case "not-now":
+        if (card.dataset.cardNotNowUrl) {
+          return { method: "post", url: card.dataset.cardNotNowUrl }
+        }
+        break
+      case "closed":
+        if (card.dataset.cardClosureUrl) {
+          return { method: "post", url: card.dataset.cardClosureUrl }
+        }
+        break
+    }
+
+    return null
+  }
+
+  #withColumn(url, columnId) {
+    const separator = url.includes("?") ? "&" : "?"
+    return `${url}${separator}column_id=${encodeURIComponent(columnId)}`
+  }
+
+  #moveCard(card, destination) {
+    const list = destination.querySelector(".cards__list")
+
+    if (list) {
+      list.prepend(card)
+      return true
+    }
+
+    const frame = destination.querySelector("turbo-frame")
+    if (frame) {
+      frame.append(card)
+      return true
+    }
+
+    return false
+  }
+
+  #updateCount(column, change) {
+    const count = column.querySelector(".cards__expander-count")
+
+    if (count && !count.textContent.trim().endsWith("+")) {
+      const currentCount = Number.parseInt(count.textContent, 10)
+
+      if (!Number.isNaN(currentCount)) {
+        const nextCount = Math.max(0, currentCount + change)
+        count.textContent = nextCount > 99 ? "99+" : nextCount
+        column.querySelector(".cards__expander")?.style.setProperty("--card-count", Math.min(nextCount, 15))
+      }
+    }
+  }
+
+  #saveMove(card, move) {
+    const previousMove = this.#pendingMoves.get(card)
+    const request = previousMove
+      ? previousMove.catch(() => {}).then(() => this.#sendMove(move))
+      : this.#sendMove(move)
+    const completed = Promise.resolve(request).catch(error => console.error("Unable to move card", error))
+
+    this.#pendingMoves.set(card, completed)
+    completed.finally(() => {
+      if (this.#pendingMoves.get(card) === completed) {
+        this.#pendingMoves.delete(card)
+      }
+    })
+  }
+
+  #sendMove({ method, url }) {
+    const options = { responseKind: "json" }
+    return method === "delete" ? destroy(url, options) : post(url, options)
+  }
+}
