+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,13 @@
+Rails.application.config.to_prepare do
+  unless ActiveStorage::Attachment.ancestors.include?(StorageUsage::ActiveStorageAttachmentCallbacks)
+    ActiveStorage::Attachment.include StorageUsage::ActiveStorageAttachmentCallbacks
+  end
+
+  unless ActiveStorage::Attachment.ancestors.include?(StorageUsage::ActiveStorageAttachmentDeletion)
+    ActiveStorage::Attachment.prepend StorageUsage::ActiveStorageAttachmentDeletion
+  end
+
+  unless ActionText::RichText.ancestors.include?(StorageUsage::RichTextCallbacks)
+    ActionText::RichText.include StorageUsage::RichTextCallbacks
+  end
+end
