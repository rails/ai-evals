diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..24ff80e
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+
+    Current.account = @account
+    Current.user = @user
+    Current.session = sessions(:david)
+  end
+
+  test "board and account bytes used include only board storage" do
+    attach_card_image @card, 11
+    embed @board, :public_description, 13
+    embed @card, :description, 17
+    embed comments(:logo_1), :body, 19
+
+    other_board = boards(:private)
+    other_card = other_board.cards.create!(creator: @user, title: "Another card", status: :published)
+    attach_card_image other_card, 23
+
+    export = Account::Export.create!(account: @account, user: @user)
+    export.file.attach io: StringIO.new("x" * 29), filename: "export.zip", content_type: "application/zip"
+
+    refresh @board, @account
+    refresh other_board, @account
+
+    assert_equal 60, @board.reload.bytes_used
+    assert_equal 83, @account.reload.bytes_used
+    assert_equal 23, other_board.reload.bytes_used
+  end
+
+  test "a blob attached more than once is counted once" do
+    blob = create_blob(31)
+    @card.image.attach(blob)
+    @card.update!(description: ActionText::Attachment.from_attachable(blob).to_html)
+
+    refresh @board, @account
+
+    assert_equal 31, @board.reload.bytes_used
+    assert_equal 31, @account.reload.bytes_used
+  end
+
+  test "usage is refreshed by the background job when attachments change" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    attach_card_image @card, 37
+    embed @card, :description, 41
+    embed comments(:logo_1), :body, 43
+    StorageUsage::RefreshJob.perform_now(@board.id, @account.id)
+
+    assert_equal 121, @board.reload.bytes_used
+    assert_equal 121, @account.reload.bytes_used
+
+    @card.image.detach
+    @card.update!(description: "No files here")
+    comments(:logo_1).update!(body: "No files here either")
+    StorageUsage::RefreshJob.perform_now(@board.id, @account.id)
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card refreshes both boards" do
+    other_board = boards(:private)
+    attach_card_image @card, 47
+    refresh @board, @account
+    assert_equal 47, @board.reload.bytes_used
+
+    @card.update!(board: other_board)
+    StorageUsage::RefreshJob.perform_now(@board.id, @account.id)
+    StorageUsage::RefreshJob.perform_now(other_board.id, @account.id)
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 47, other_board.reload.bytes_used
+    assert_equal 47, @account.reload.bytes_used
+  end
+
+  test "reading bytes used uses the cached value" do
+    @board.update_column(:bytes_used, 123)
+
+    assert_queries_count 0 do
+      assert_equal 123, @board.bytes_used
+    end
+  end
+
+  test "the calculation is a single aggregate query" do
+    assert_queries_count 1 do
+      StorageUsage::Calculator.for(@board)
+    end
+  end
+
+  private
+    def create_blob(size, filename: "attachment.bin")
+      Current.with(account: @account) do
+        ActiveStorage::Blob.create_and_upload!(
+          io: StringIO.new("x" * size),
+          filename: filename,
+          content_type: "application/octet-stream"
+        )
+      end
+    end
+    def attach_card_image(card, size)
+      card.image.attach create_blob(size, filename: "card-image.bin")
+    end
+
+    def embed(record, attribute, size)
+      record.update!(attribute => ActionText::Attachment.from_attachable(create_blob(size)).to_html)
+    end
+
+    def refresh(board, account)
+      StorageUsage::RefreshJob.perform_now(board.id, account.id)
+    end
+end
