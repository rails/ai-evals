diff --git a/app/models/storage_usage/trackable.rb b/app/models/storage_usage/trackable.rb
new file mode 100644
index 0000000..8b8844a
--- /dev/null
+++ b/app/models/storage_usage/trackable.rb
@@ -0,0 +1,23 @@
+module StorageUsage::Trackable
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    self[:bytes_used].to_i
+  end
+
+  def refresh_bytes_used_now
+    with_lock do
+      update_column :bytes_used, StorageUsage::Calculator.for(self)
+    end
+
+    bytes_used
+  end
+
+  def refresh_bytes_used_later
+    if is_a?(Board)
+      StorageUsage.refresh_later(board_id: id, account_id: account_id)
+    else
+      StorageUsage.refresh_later(account_id: id)
+    end
+  end
+end
