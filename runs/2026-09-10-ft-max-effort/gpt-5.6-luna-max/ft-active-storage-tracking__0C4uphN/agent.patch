+class StorageUsage::RefreshJob < ApplicationJob
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(board_id = nil, account_id = nil)
+    Board.find_by(id: board_id)&.refresh_bytes_used_now if board_id
+    Account.find_by(id: account_id)&.refresh_bytes_used_now if account_id
+  end
+end
