diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..ef31672
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,67 @@
+module StorageUsage
+  def self.refresh_later(board_id: nil, account_id: nil)
+    if board_id.present? || account_id.present?
+      StorageUsage::RefreshJob.perform_later(board_id, account_id)
+    end
+  end
+
+  def self.references_for(record)
+    case record
+    when ActiveStorage::Attachment
+      references_for_attachment(record)
+    when ActionText::RichText
+      references_for_rich_text(record)
+    else
+      {}
+    end
+  end
+
+  def self.references_for_attachment(attachment)
+    if attachment.record_type == "Card" && attachment.name == "image"
+      card = attachment.record
+      {
+        board_id: card&.board_id || Card.where(id: attachment.record_id).pick(:board_id),
+        account_id: attachment.account_id
+      }
+    else
+      {}
+    end
+  rescue ActiveRecord::RecordNotFound
+    { account_id: attachment.account_id }
+  end
+
+  def self.references_for_rich_text(rich_text)
+    if rich_text.name == rich_text_name_for(rich_text.record_type)
+      owner = rich_text.record
+      {
+        board_id: board_id_for(owner, rich_text),
+        account_id: rich_text.account_id
+      }
+    else
+      {}
+    end
+  rescue ActiveRecord::RecordNotFound
+    { account_id: rich_text.account_id }
+  end
+
+  def self.rich_text_name_for(record_type)
+    {
+      "Board" => "public_description",
+      "Card" => "description",
+      "Comment" => "body"
+    }[record_type]
+  end
+  private_class_method :rich_text_name_for
+
+  def self.board_id_for(owner, rich_text)
+    case rich_text.record_type
+    when "Board"
+      rich_text.record_id
+    when "Card"
+      owner&.board_id || Card.where(id: rich_text.record_id).pick(:board_id)
+    when "Comment"
+      owner&.card&.board_id || Comment.where(id: rich_text.record_id).joins(:card).pick(:board_id)
+    end
+  end
+  private_class_method :board_id_for
+end
diff --git a/app/models/storage_usage/active_storage_attachment_callbacks.rb b/app/models/storage_usage/active_storage_attachment_callbacks.rb
new file mode 100644
index 0000000..5418c89
--- /dev/null
+++ b/app/models/storage_usage/active_storage_attachment_callbacks.rb
@@ -0,0 +1,17 @@
+module StorageUsage::ActiveStorageAttachmentCallbacks
+  extend ActiveSupport::Concern
+
+  included do
+    # These records are often autosaved as part of their parent transaction. ApplicationJob
+    # defers the enqueue until that transaction commits.
+    after_create :refresh_storage_usage_later
+    after_destroy :refresh_storage_usage_later
+  end
+
+  private
+    def refresh_storage_usage_later
+      StorageUsage.references_for(self).then do |references|
+        StorageUsage.refresh_later(**references) if references.present?
+      end
+    end
+end
