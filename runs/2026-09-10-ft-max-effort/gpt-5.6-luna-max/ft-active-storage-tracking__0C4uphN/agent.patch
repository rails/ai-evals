diff --git a/app/models/storage_usage/calculator.rb b/app/models/storage_usage/calculator.rb
new file mode 100644
index 0000000..6b476c0
--- /dev/null
+++ b/app/models/storage_usage/calculator.rb
@@ -0,0 +1,102 @@
+class StorageUsage::Calculator
+  def self.for(record)
+    new(record).calculate
+  end
+
+  def initialize(record)
+    @account_id = record.is_a?(Account) ? record.id : record.account_id
+    @board_id = record.id if record.is_a?(Board)
+  end
+
+  def calculate
+    ActiveStorage::Blob
+      .where(account_id: account_id, id: relevant_attachments.select(:blob_id))
+      .sum(:byte_size)
+  end
+
+  private
+    attr_reader :account_id, :board_id
+
+    def relevant_attachments
+      card_images.or(rich_text_embeds)
+    end
+
+    def card_images
+      attachments.where(
+        record_type: "Card",
+        name: "image",
+        record_id: card_ids
+      )
+    end
+
+    def rich_text_embeds
+      attachments.where(
+        record_type: "ActionText::RichText",
+        name: "embeds",
+        record_id: rich_text_ids
+      )
+    end
+
+    def attachments
+      ActiveStorage::Attachment.where(account_id: account_id)
+    end
+
+    def card_ids
+      cards = if board_id
+        Card.where(account_id: account_id, board_id: board_id)
+      else
+        Card.where(
+          account_id: account_id,
+          board_id: Board.where(account_id: account_id).select(:id)
+        )
+      end
+
+      cards.select(:id)
+    end
+
+    def board_ids
+      boards = Board.where(account_id: account_id)
+      boards = boards.where(id: board_id) if board_id
+      boards.select(:id)
+    end
+
+    def comment_ids
+      comments = Comment.where(account_id: account_id, card_id: card_ids)
+      comments.select(:id)
+    end
+
+    def rich_text_ids
+      board_description_ids
+        .or(card_description_ids)
+        .or(comment_body_ids)
+        .select(:id)
+    end
+
+    def rich_texts
+      ActionText::RichText.where(account_id: account_id)
+    end
+
+    def board_description_ids
+      rich_texts.where(
+        record_type: "Board",
+        name: "public_description",
+        record_id: board_ids
+      )
+    end
+
+    def card_description_ids
+      rich_texts.where(
+        record_type: "Card",
+        name: "description",
+        record_id: card_ids
+      )
+    end
+
+    def comment_body_ids
+      rich_texts.where(
+        record_type: "Comment",
+        name: "body",
+        record_id: comment_ids
+      )
+    end
+end
