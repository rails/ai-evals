diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..c0305ae
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,65 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[en ja].freeze
+
+  included do
+    prepend_around_action :with_request_locale
+    helper_method :current_locale
+  end
+
+  private
+    def with_request_locale
+      locale = locale_for_request
+      Current.locale = locale
+      Current.locale_explicit = locale_was_selected?
+
+      I18n.with_locale(locale) do
+        yield
+        persist_locale_preference!(Current.identity) if Current.identity
+      end
+    ensure
+      Current.locale = nil
+      Current.locale_explicit = nil
+    end
+
+    def current_locale
+      I18n.locale
+    end
+
+    def locale_for_request
+      if requested_locale = normalized_locale(params[:locale])
+        session[:locale] = requested_locale
+        requested_locale
+      elsif session_locale = normalized_locale(session[:locale])
+        session_locale
+      elsif identity = identity_from_session_cookie
+        normalized_locale(identity.locale) || I18n.default_locale
+      else
+        I18n.default_locale
+      end
+    end
+
+    def locale_was_selected?
+      normalized_locale(params[:locale]).present? || normalized_locale(session[:locale]).present?
+    end
+
+    def normalized_locale(locale)
+      locale = locale.to_s.downcase
+      locale if SUPPORTED_LOCALES.include?(locale)
+    end
+
+    def identity_from_session_cookie
+      if token = cookies.signed[:session_token]
+        Session.find_signed(token)&.identity
+      end
+    rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def persist_locale_preference!(identity)
+      if locale_was_selected? && identity.locale != Current.locale.to_s
+        identity.update!(locale: Current.locale.to_s)
+      end
+    end
+end
