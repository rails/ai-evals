diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..df7d8d7
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "a supported query locale switches the page and survives subsequent requests" do
+    sign_in_as :kevin
+
+    get events_path(locale: "ja")
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "アクティビティ"
+
+    get events_path(locale: "xx")
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.body, "アクティビティ"
+  end
+
+  test "Japanese pages do not expose missing translations" do
+    sign_in_as :kevin
+
+    [ my_menu_path, account_settings_path, notifications_settings_path ].each do |path|
+      get path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_no_match(/translation missing/, response.body, path)
+    end
+  end
+
+  test "an unsupported locale does not switch an English visitor" do
+    sign_in_as :kevin
+
+    get events_path(locale: "xx")
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_includes response.body, "Activity"
+  end
+
+  test "locale selected before sign-in is persisted on the identity" do
+    identity = identities(:kevin)
+
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_select "html[lang=ja]"
+
+      post session_path, params: { email_address: identity.email_address }
+      magic_link = identity.magic_links.order(id: :desc).first
+      post session_magic_link_path, params: { code: magic_link.code }
+    end
+
+    assert_response :redirect
+    assert_equal "ja", identity.reload.locale
+  end
+
+  test "an identity locale is used when sending a magic link from a clean browser" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+    end
+
+    mail = MagicLinkMailer.sign_in_instructions(identity.magic_links.order(id: :desc).first)
+    assert_match(/Fizzyの認証コード：/, mail.subject)
+  end
+end
