+++ b/app/models/webhook/delivery.rb
@@ -10,6 +10,32 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  after_create_commit :deliver_later
+
+  def self.cleanup
+    where(created_at: ...1.week.ago).delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    if claim_for_delivery
+      begin
+        body = render_payload
+        headers = request_headers(body)
+        update! request: { headers: headers }
+
+        response = post(body, headers)
+        update! state: :completed, response: response
+        record_result
+      rescue StandardError
+        record_failure
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +53,83 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        if pending?
+          update! state: :in_progress
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def render_payload
+      if webhook.for_slack?
+        { text: render_event }.to_json
+      elsif webhook.for_campfire?
+        { message: { body: render_event } }.to_json
+      elsif webhook.for_basecamp?
+        { content: render_event }.to_json
+      else
+        ApplicationController.render(
+          template: "webhooks/event",
+          formats: [ :json ],
+          assigns: { event: event }
+        )
+      end
+    end
+
+    def render_event
+      ApplicationController.render(
+        template: "webhooks/event",
+        formats: [ :html ],
+        layout: false,
+        assigns: { event: event }
+      ).strip
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest(OpenSSL::Digest::SHA256.new, webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      response = http.start { |connection| connection.request(request) }
+      {
+        code: response.code.to_i,
+        headers: response.each_header.to_h
+      }
+    end
+
+    def record_result
+      if succeeded?
+        webhook.ensure_delinquency_tracker.record_success
+      else
+        webhook.ensure_delinquency_tracker.record_failure
+      end
+    end
+
+    def record_failure
+      update! state: :errored, response: { error: "destination_unreachable" }
+      webhook.ensure_delinquency_tracker.record_failure
+    end
 end
