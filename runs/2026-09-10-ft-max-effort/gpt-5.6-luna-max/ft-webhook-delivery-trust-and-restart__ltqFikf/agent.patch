diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..852ff82
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,31 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset
+  end
+
+  def record_failure(at: Time.current)
+    with_lock do
+      if first_failure_at.blank? || first_failure_at < at - FAILURE_WINDOW
+        self.consecutive_failures_count = 0
+        self.first_failure_at = at
+      end
+
+      self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+      save!
+
+      webhook.deactivate if consecutive_failures_count >= FAILURE_LIMIT
+    end
+  end
+
+  def reset
+    with_lock do
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+  end
+end
