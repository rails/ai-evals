+++ b/test/models/webhook/delivery_job_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  private
+    def fresh_webhook
+      boards(:writebook).webhooks.create!(name: "Delivery test", url: "https://example.com/delivery", subscribed_actions: [ "comment_created" ])
+    end
+
+    def fresh_event
+      boards(:writebook).events.create!(action: "comment_created", creator: users(:david), eventable: comments(:layout_overflowing_david))
+    end
+
+  public
+  test "posts a signed event and records a successful response" do
+    webhook = fresh_webhook
+    event = fresh_event
+    delivery = webhook.deliver(event)
+    body = ApplicationController.render(template: "webhooks/event", formats: [ :json ], assigns: { event: event })
+
+    stub_request(:post, webhook.url).to_return(status: 202, body: "accepted")
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    delivery.reload
+
+    assert delivery.succeeded?
+    assert_equal "completed", delivery.state
+    assert_equal 202, delivery.response[:code]
+    assert_requested :post, webhook.url, times: 1, body: body
+    assert_equal OpenSSL::HMAC.hexdigest(OpenSSL::Digest::SHA256.new, webhook.signing_secret, body),
+      delivery.request[:headers]["X-Webhook-Signature"]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request[:headers]["User-Agent"]
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+  end
+
+  test "formats payloads for supported chat receivers" do
+    event = fresh_event
+    cases = {
+      "https://hooks.slack.com/services/T123/B456/token" => ->(message) { { text: message } },
+      "https://example.com/rooms/123/456-room/messages" => ->(message) { { message: { body: message } } },
+      "https://basecamp.com/999/integrations/token/buckets/111/chats/222/lines" => ->(message) { { content: message } }
+    }
+
+    cases.each do |url, payload|
+      webhook = boards(:writebook).webhooks.create!(name: "Chat receiver", url: url, subscribed_actions: [ "comment_created" ])
+      delivery = webhook.deliver(event)
+      expected_message = ApplicationController.render(
+        template: "webhooks/event", formats: [ :html ], layout: false, assigns: { event: event }
+      ).strip
+      stub_request(:post, url).to_return(status: 200)
+
+      Webhook::DeliveryJob.perform_now(delivery)
+
+      assert_requested :post, url, body: payload.call(expected_message).to_json
+    end
+  end
+
+  test "does not post twice when the delivery job is run twice" do
+    webhook = fresh_webhook
+    delivery = webhook.deliver(fresh_event)
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested :post, webhook.url, times: 1
+  end
+
+  test "records an unreachable destination as a failed delivery" do
+    webhook = fresh_webhook
+    delivery = webhook.deliver(fresh_event)
+    stub_request(:post, webhook.url).to_raise(SocketError.new("unreachable"))
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    delivery.reload
+
+    assert delivery.failed?
+    assert_equal "errored", delivery.state
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+end
