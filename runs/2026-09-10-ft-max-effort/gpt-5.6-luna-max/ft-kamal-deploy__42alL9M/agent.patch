@@ -31,6 +31,32 @@ Rails.application.configure do
     config.active_storage.service = ENV.fetch("ACTIVE_STORAGE_SERVICE", "local").to_sym
   end
 
+  # OSS deployments provide their public hostname and SMTP settings through Kamal.
+  # The SaaS engine supplies its own production URL and mail configuration.
+  unless Fizzy.saas?
+    # URLs generated by background jobs and mailers need the public hostname,
+    # since they do not have a request from which to infer it.
+    app_fqdn = ENV.fetch("APP_FQDN", "localhost")
+    public_url_options = { host: app_fqdn, protocol: "https" }
+    config.action_controller.default_url_options = public_url_options
+    config.action_mailer.default_url_options = public_url_options
+    Rails.application.routes.default_url_options = public_url_options
+
+    # The one-box deployment uses the SMTP server supplied in its Kamal config.
+    # Authentication values are optional so unauthenticated local mail relays work
+    # too; when set, they are supplied through Kamal's secrets file.
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: ENV.fetch("SMTP_ADDRESS", "localhost"),
+      port: Integer(ENV.fetch("SMTP_PORT", "25")),
+      domain: ENV.fetch("SMTP_DOMAIN", app_fqdn),
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }
+  end
+
