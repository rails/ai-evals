diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..ef9fe4b
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,56 @@
+# Deploy Fizzy to one Linux host with Docker.
+# Replace fizzy.example.com with the hostname that points at this server.
+service: fizzy
+image: fizzy
+retain_containers: 1
+
+servers:
+  web:
+    - fizzy.example.com
+
+# kamal-proxy obtains and renews a Let's Encrypt certificate for this host.
+# Ports 80 and 443 must be reachable from the Internet.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Kamal uses a local registry during the build, so an external registry is not
+# required for a one-box deployment.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+# Keep SQLite databases and local Active Storage files outside the replaceable
+# application container. This volume is deliberately mounted at /rails/storage,
+# where all production SQLite databases and uploads live.
+volumes:
+  - fizzy:/rails/storage
+
+# Bridge fingerprinted assets between the old and new containers during deploys.
+asset_path: /rails/public/assets
+
+# The Puma configuration starts Solid Queue in the same container. Do not add a
+# separate jobs role for this deployment.
+env:
+  clear:
+    APP_FQDN: fizzy.example.com
+    DATABASE_ADAPTER: sqlite
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@fizzy.example.com>"
+    RAILS_ENV: production
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    SOLID_QUEUE_IN_PUMA: true
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse "/bin/bash"
