+class Signups::CodesController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    if pending_email_code?(purpose: :signup)
+      @email_address = email_code_email_address(purpose: :signup)
+    else
+      redirect_to new_signup_path
+    end
+  end
+
+  def create
+    if pending_email_code?(purpose: :signup)
+      @email_address = email_code_email_address(purpose: :signup)
+
+      if email_address = verify_email_code(params.expect(:code), purpose: :signup)
+        identity = Identity.find_or_create_by!(email_address: email_address)
+        start_new_session_for identity
+        redirect_to new_signup_completion_path
+      else
+        render :new, status: :unprocessable_entity
+      end
+    else
+      redirect_to new_signup_path
+    end
+  end
+
+  private
+    def rate_limit_exceeded
+      redirect_to new_signup_path, alert: "Try again later."
+    end
+end
