+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>We sent a six-character code to <strong><%= @email_address %></strong>.</p>
+
+  <%= form_with url: join_verification_path(code: @join_code.code, script_name: @join_code.account.slug), class: "flex flex-column gap", data: { turbo: false, controller: "form" } do |form| %>
+    <%= form.text_field :code, required: true, class: "input txt-large txt-align-center", autofocus: true, autocomplete: "one-time-code", inputmode: "text", maxlength: 6, autocapitalize: "characters", spellcheck: false %>
+
+    <button type="submit" id="verify_code" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <%= link_to "Use a different email address", join_path(code: @join_code.code, script_name: @join_code.account.slug), class: "btn btn--plain txt-link center txt-small" %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
