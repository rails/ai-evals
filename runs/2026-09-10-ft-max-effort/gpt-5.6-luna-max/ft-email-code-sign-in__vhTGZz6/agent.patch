diff --git a/test/controllers/email_code_authentication_test.rb b/test/controllers/email_code_authentication_test.rb
new file mode 100644
index 0000000..9a774eb
--- /dev/null
+++ b/test/controllers/email_code_authentication_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signs in with a code from the email subject" do
+    perform_enqueued_jobs do
+      untenanted do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+
+        assert_redirected_to new_session_code_path
+        assert_equal 1, ActionMailer::Base.deliveries.size
+
+        email = ActionMailer::Base.deliveries.last
+        code = email.subject.split.last
+        assert_equal 6, code.length
+        assert_includes email.to, identities(:kevin).email_address
+
+        get new_session_code_path
+        assert_response :success
+        assert_select "input[name=code]"
+
+        post session_code_path, params: { code: code.downcase }
+
+        assert_redirected_to landing_url
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "does not accept a code after fifteen minutes or more" do
+    perform_enqueued_jobs do
+      untenanted do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+        code = ActionMailer::Base.deliveries.last.subject.split.last
+        travel 15.minutes
+
+        post session_code_path, params: { code: code }
+
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "a code can only be used once" do
+    perform_enqueued_jobs do
+      untenanted do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+        code = ActionMailer::Base.deliveries.last.subject.split.last
+        post session_code_path, params: { code: code }
+        assert_response :redirect
+
+        sign_out
+        post session_code_path, params: { code: code }
+
+        assert_redirected_to new_session_path
+      end
+    end
+  end
+
+  test "signs up after verifying the email code" do
+    email_address = "new-user@example.com"
+
+    perform_enqueued_jobs do
+      untenanted do
+        post signup_path, params: { signup: { email_address: email_address } }
+
+        assert_redirected_to new_signup_code_path
+        code = ActionMailer::Base.deliveries.last.subject.split.last
+
+        post signup_code_path, params: { code: code }
+
+        assert_redirected_to new_signup_completion_path
+        assert Identity.find_by(email_address: email_address).sessions.exists?
+      end
+    end
+  end
+
+  test "joins an account after verifying the email code" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identities(:jz).email_address }
+    end
+
+    assert_redirected_to new_join_verification_path(code: join_code.code, script_name: account.slug)
+    code = ActionMailer::Base.deliveries.last.subject.split.last
+
+    post join_verification_path(code: join_code.code, script_name: account.slug), params: { code: code }
+
+    assert_redirected_to landing_url(script_name: account.slug)
+    assert account.users.exists?(identity: identities(:jz))
+  end
+end
