index 0000000..b843a69
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,74 @@
+module EmailCodeAuthentication
+  EMAIL_CODE_EXPIRATION = 15.minutes
+  EMAIL_CODE_LENGTH = 6
+  EMAIL_CODE_SESSION_KEY = :email_code_challenge
+  EMAIL_CODE_INVALID_MESSAGE = "That code is invalid or has expired. Request a new one."
+
+  private
+    def issue_email_code(email_address:, purpose:, metadata: {})
+      code = SecureRandom.alphanumeric(EMAIL_CODE_LENGTH).upcase
+      normalized_email_address = Identity.new(email_address: email_address).email_address
+
+      session[EMAIL_CODE_SESSION_KEY] = {
+        email_address: normalized_email_address,
+        code_digest: Digest::SHA256.hexdigest(code),
+        purpose: purpose.to_s,
+        metadata: metadata,
+        expires_at: Time.current.to_i + EMAIL_CODE_EXPIRATION.to_i
+      }
+
+      IdentityMailer.email_code(email_address: normalized_email_address, code: code).deliver_later
+    end
+
+    def email_code_email_address(purpose:, metadata: {})
+      challenge = email_code_challenge
+
+      if email_code_challenge_matches?(challenge, purpose: purpose, metadata: metadata)
+        challenge["email_address"]
+      end
+    end
+
+    def pending_email_code?(purpose:, metadata: {})
+      email_code_challenge_matches?(email_code_challenge, purpose: purpose, metadata: metadata)
+    end
+
+    def verify_email_code(code, purpose:, metadata: {})
+      challenge = email_code_challenge
+
+      if email_code_valid?(challenge, code, purpose: purpose, metadata: metadata)
+        session.delete(EMAIL_CODE_SESSION_KEY)
+        challenge["email_address"]
+      else
+        flash.now[:alert] = EMAIL_CODE_INVALID_MESSAGE
+        nil
+      end
+    end
+
+    def email_code_challenge
+      challenge = session[EMAIL_CODE_SESSION_KEY]
+      challenge&.stringify_keys
+    end
+
+    def email_code_challenge_matches?(challenge, purpose:, metadata: {})
+      if challenge.present? && challenge["purpose"] == purpose.to_s && challenge["email_address"].present?
+        expected_metadata = metadata.stringify_keys
+        actual_metadata = challenge.fetch("metadata", {}).to_h.stringify_keys
+
+        expected_metadata.all? do |key, value|
+          actual_metadata[key] == value.to_s
+        end
+      else
+        false
+      end
+    end
+
+    def email_code_valid?(challenge, code, purpose:, metadata: {})
+      if email_code_challenge_matches?(challenge, purpose: purpose, metadata: metadata) &&
+          challenge["expires_at"].to_i > Time.current.to_i && challenge["code_digest"].present?
+        submitted_digest = Digest::SHA256.hexdigest(code.to_s.strip.upcase)
+        ActiveSupport::SecurityUtils.secure_compare(submitted_digest, challenge["code_digest"].to_s)
+      else
+        false
+      end
+    end
+end
