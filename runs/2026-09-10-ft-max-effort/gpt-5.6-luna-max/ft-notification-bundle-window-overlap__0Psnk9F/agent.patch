index 0000000..da68921
--- /dev/null
+++ b/app/models/notification/email_bundleable.rb
@@ -0,0 +1,24 @@
+module Notification::EmailBundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :email_bundle, class_name: "Notification::EmailBundle", optional: true, inverse_of: :notifications
+
+    after_create :bundle_email
+    after_update :bundle_email, if: :source_id_previously_changed?
+  end
+
+  def bundle_email
+    if bundle_email_eligible?
+      Notification::EmailBundle.add(self)
+    end
+  end
+
+  def bundle_email_later
+    bundle_email
+  end
+
+  def bundle_email_eligible?
+    user.active? && account.active? && creator.present? && !creator.system?
+  end
+end
