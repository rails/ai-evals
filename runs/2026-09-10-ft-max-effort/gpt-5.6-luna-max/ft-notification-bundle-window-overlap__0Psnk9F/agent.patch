--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  teardown do
+    travel_back
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "bundle includes every notification in its window" do
+    user = users(:kevin)
+    user.notifications.delete_all
+    Notification::EmailBundle.delete_all
+    user.settings.update!(bundle_email_frequency: :daily)
+
+    notification = Notification.create!(
+      user: user,
+      source: events(:logo_published),
+      creator: users(:david),
+      card: cards(:logo),
+      unread_count: 1
+    )
+    bundle = notification.reload.email_bundle
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "Your Fizzy notification digest", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert_includes email.body.encoded, cards(:logo).title
+  end
+end
diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
