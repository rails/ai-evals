@@ -0,0 +1,11 @@
+class Notification::EmailBundle::DeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(email_bundle)
+    if email_bundle.due?
+      email_bundle.deliver
+    else
+      self.class.set(wait_until: email_bundle.ends_at).perform_later(email_bundle)
+    end
+  end
+end
