--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  include ActiveSupport::Testing::TimeHelpers
+
+  setup do
+    @user = users(:kevin)
+    @user.notifications.delete_all
+    Notification::EmailBundle.delete_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @start = Time.zone.local(2026, 7, 10, 12, 0, 0)
+  end
+
+  teardown do
+    travel_back
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "schedules one delivery job for the first notification" do
+    travel_to @start do
+      assert_enqueued_with(job: Notification::EmailBundle::DeliveryJob) do
+        create_notification(events(:logo_published), cards(:logo))
+      end
+    end
+  end
+
+  test "starts a window with the first notification" do
+    travel_to @start do
+      notification = create_notification(events(:logo_published), cards(:logo))
+
+      assert_equal @start, notification.reload.email_bundle.starts_at
+      assert_equal @start + 4.hours, notification.email_bundle.ends_at
+      assert_equal "every_few_hours", notification.email_bundle.frequency
+    end
+  end
+
+  test "adds notifications that arrive during a window to that window" do
+    first_notification = travel_to(@start) { create_notification(events(:logo_published), cards(:logo)) }
+    second_notification = travel_to(@start + 3.hours) { create_notification(events(:layout_commented), cards(:layout)) }
+
+    assert_equal first_notification.email_bundle, second_notification.email_bundle
+    assert_equal 1, Notification::EmailBundle.count
+  end
+
+  test "starts a new non-overlapping window after the frequency elapses" do
+    first_notification = travel_to(@start) { create_notification(events(:logo_published), cards(:logo)) }
+    second_notification = travel_to(@start + 4.hours) { create_notification(events(:buy_domain_sent_back_to_triage), cards(:buy_domain)) }
+
+    assert_not_equal first_notification.email_bundle, second_notification.email_bundle
+    assert_equal first_notification.email_bundle.ends_at, second_notification.email_bundle.starts_at
+    assert_operator second_notification.email_bundle.starts_at, :>=, first_notification.email_bundle.ends_at
+  end
+
+  test "a notification processed late joins the already-open window" do
+    first_notification = travel_to(@start) { create_notification(events(:logo_published), cards(:logo)) }
+
+    travel_to(@start + 2.hours) do
+      late_notification = Notification.new(
+        user: @user,
+        source: events(:layout_commented),
+        creator: users(:david),
+        card: cards(:layout),
+        created_at: @start + 30.minutes
+      )
+      late_notification.save!
+
+      assert_equal first_notification.email_bundle, late_notification.reload.email_bundle
+    end
+  end
+
+  test "never does not create an email bundle" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to @start do
+      notification = create_notification(events(:logo_published), cards(:logo))
+
+      assert_nil notification.reload.email_bundle
+      assert_empty Notification::EmailBundle.all
+    end
+  end
+
+  test "delivers one email for a window" do
+    first_notification = travel_to(@start) { create_notification(events(:logo_published), cards(:logo)) }
+    second_notification = travel_to(@start + 1.hour) { create_notification(events(:layout_commented), cards(:layout)) }
+
+    travel_to(first_notification.email_bundle.ends_at) do
+      Notification::EmailBundle::DeliveryJob.perform_now(first_notification.email_bundle)
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.first.to
+    assert_equal first_notification.email_bundle, second_notification.reload.email_bundle
+    assert first_notification.email_bundle.reload.delivered_at.present?
+  end
+
+  private
+    def create_notification(source, card)
+      Notification.create!(user: @user, source: source, creator: users(:david), card: card, unread_count: 1)
+    end
+end
