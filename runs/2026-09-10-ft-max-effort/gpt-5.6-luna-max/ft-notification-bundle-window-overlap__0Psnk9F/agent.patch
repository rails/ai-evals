diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..e8528f4
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,109 @@
+class Notification::EmailBundle < ApplicationRecord
+  FREQUENCY_DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, foreign_key: :email_bundle_id, inverse_of: :email_bundle, dependent: :nullify
+
+  validates :frequency, inclusion: { in: FREQUENCY_DURATIONS.keys }
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_start
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :ordered, -> { order(starts_at: :asc, id: :asc) }
+
+  class << self
+    def add(notification)
+      user = notification.user
+      frequency = user.settings&.bundle_email_frequency
+      duration = FREQUENCY_DURATIONS[frequency]
+
+      if duration && notification.bundle_email_eligible?
+        bundle = nil
+        schedule_delivery = false
+        now = Time.current
+        notification_time = notification.created_at || now
+
+        user.with_lock do
+          bundles = where(user: user).ordered.to_a
+          pending_bundles = bundles.select { |candidate| candidate.delivered_at.nil? }
+
+          bundle = pending_bundles.reverse.find { |candidate| candidate.contains?(notification_time) }
+          bundle ||= pending_bundles.reverse.find { |candidate| candidate.open_at?(now) }
+
+          unless bundle
+            latest_bundle = bundles.max_by(&:ends_at)
+            starts_at = [ notification_time, now ].max
+            starts_at = latest_bundle.ends_at if latest_bundle && latest_bundle.ends_at > starts_at
+
+            bundle = create!(
+              account: notification.account,
+              user: user,
+              frequency: frequency,
+              starts_at: starts_at,
+              ends_at: starts_at + duration
+            )
+          end
+
+          notification.update!(email_bundle: bundle) unless notification.email_bundle_id == bundle.id
+
+          if bundle.delivery_scheduled_at.nil? && bundle.delivered_at.nil?
+            bundle.update!(delivery_scheduled_at: now)
+            schedule_delivery = true
+          end
+        end
+
+        if schedule_delivery
+          Notification::EmailBundle::DeliveryJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+        end
+
+        bundle
+      end
+    end
+  end
+
+  def contains?(time)
+    starts_at <= time && time < ends_at
+  end
+
+  def open_at?(time = Time.current)
+    starts_at <= time && time < ends_at
+  end
+
+  def due?(time = Time.current)
+    time >= ends_at
+  end
+
+  def deliver
+    user.with_lock do
+      lock!
+
+      if delivered_at.nil? && due?
+        if deliverable?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && account.active? && user.identity.present? && user.settings&.bundle_email_frequency != "never" && notifications.exists?
+    end
+
+    def ends_after_start
+      errors.add(:ends_at, "must be after starts_at") if starts_at.present? && ends_at.present? && ends_at <= starts_at
+    end
+
+    def does_not_overlap_another_bundle
+      if starts_at.present? && ends_at.present? && user_id.present? && self.class.where(user_id: user_id).where.not(id: id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at).exists?
+        errors.add(:base, "overlaps another email bundle")
+      end
+    end
+end
diff --git a/app/models/notification/email_bundleable.rb b/app/models/notification/email_bundleable.rb
