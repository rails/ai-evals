diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..e77bc32
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than thirty days ago" do
+    account = accounts(:initech)
+    cancellation = Account::Cancellation.create!(account: account, initiated_by: users(:mike))
+    cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+  end
+
+  test "does not incinerate an account canceled within the grace period" do
+    travel_to Time.current do
+      account = accounts(:initech)
+      cancellation = Account::Cancellation.create!(account: account, initiated_by: users(:mike))
+      cancellation.update_columns(created_at: 30.days.ago, updated_at: 30.days.ago)
+
+      Account::IncinerateDueJob.perform_now
+
+      assert Account.exists?(account.id)
+    end
+  end
+
+  test "removes account data that is not destroyed through account associations" do
+    account = accounts(:initech)
+    cancellation = Account::Cancellation.create!(account: account, initiated_by: users(:mike))
+    cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    Search::Record.for(account.id).create!(
+      account_id: account.id,
+      searchable_type: "Card",
+      searchable_id: cards(:radio).id,
+      card_id: cards(:radio).id,
+      board_id: boards(:miltons_wish_list).id,
+      title: "Radio",
+      content: "Radio",
+      created_at: Time.current
+    )
+    Storage::Entry.create!(account_id: account.id, delta: 1, operation: "test")
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Search::Record.for(account.id).where(account_id: account.id).exists?
+    assert_not Storage::Entry.where(account_id: account.id).exists?
+  end
+
+  test "removes account-owned attachments and blobs" do
+    account = accounts(:initech)
+    blob = Current.with_account(account) do
+      cards(:radio).image.attach(io: StringIO.new("image"), filename: "image.txt", content_type: "text/plain")
+      cards(:radio).image.blob
+    end
+    cancellation = Account::Cancellation.create!(account: account, initiated_by: users(:mike))
+    cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    attachment_id = blob.attachments.first.id
+    Account::IncinerateDueJob.perform_now
+
+    assert_not ActiveStorage::Attachment.exists?(attachment_id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
+
+  test "runs on the backend queue" do
+    assert_equal "backend", Account::IncinerateDueJob.new.queue_name
+  end
+end
