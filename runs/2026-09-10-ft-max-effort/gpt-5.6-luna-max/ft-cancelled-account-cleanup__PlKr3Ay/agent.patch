diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..22cc94d 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,56 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineratable, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+
+    scope :incineration_due, -> { incineratable }
+  end
+
+  def incinerate
+    with_lock do
+      if incineration_due?
+        remove_search_records
+        remove_storage_data
+        destroy!
+        remove_remaining_account_data
+      end
+    end
+  end
+
+  private
+    def incineration_due?
+      self.class.incineratable.where(id: id).exists?
+    end
+
+    def remove_search_records
+      Search::Record.for(id).where(account_id: id).destroy_all
+    end
+
+    def remove_storage_data
+      Storage::Entry.where(account_id: id).delete_all
+      Storage::Total.where(owner_type: self.class.name, owner_id: id).delete_all
+
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).delete_all
+      ActionText::RichText.where(account_id: id).delete_all
+    end
+
+    def remove_remaining_account_data
+      connection = self.class.connection
+      quoted_id = connection.quote(ActiveRecord::Type::Uuid.new.serialize(id))
+
+      connection.tables.each do |table|
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          quoted_table = connection.quote_table_name(table)
+          quoted_column = connection.quote_column_name("account_id")
+          connection.execute("DELETE FROM #{quoted_table} WHERE #{quoted_column} = #{quoted_id}")
+        end
+      end
+    end
 end
