diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..7aa6421
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = Account.create!(name: "Incineration test account")
+    @user = @account.users.create!(name: "Incineration test user", role: :owner)
+  end
+
+  test "incinerates accounts cancelled beyond the grace period" do
+    @account.create_cancellation!(
+      initiated_by: @user,
+      created_at: 31.days.ago,
+      updated_at: 31.days.ago
+    )
+
+    account_id = @account.id
+    user_id = @user.id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account_id)
+    assert_not User.exists?(user_id)
+    assert_not Account::Cancellation.exists?(account_id: account_id)
+  end
+
+  test "does not incinerate accounts cancelled within the grace period" do
+    @account.create_cancellation!(initiated_by: @user)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(@account.id)
+    assert User.exists?(@user.id)
+    assert Account::Cancellation.exists?(account_id: @account.id)
+  end
+
+  test "does not incinerate an account at exactly the grace period" do
+    travel_to Time.current.change(usec: 0) do
+      @account.create_cancellation!(
+        initiated_by: @user,
+        created_at: 30.days.ago,
+        updated_at: 30.days.ago
+      )
+
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+end
