diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..3a7469f 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,108 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  def incinerate
+    account_id = id
+
+    self.class.transaction do
+      lock!
+      cancellation = Account::Cancellation.find_by(account_id: account_id)
+      next unless cancellation && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+
+      ids = incineration_ids
+      delete_search_index_records(account_id)
+      delete_join_records(ids)
+      delete_storage_totals(account_id, ids[:board_ids])
+      delete_records_where_in("active_storage_variant_records", "blob_id", ids[:blob_ids])
+      delete_account_scoped_records(account_id)
+      delete
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Another worker may have incinerated the account while this job was running.
+  end
+
+  private
+    def incineration_ids
+      {
+        board_ids: Board.where(account_id: id).ids,
+        filter_ids: Filter.where(account_id: id).ids,
+        tag_ids: Tag.where(account_id: id).ids,
+        user_ids: User.where(account_id: id).ids,
+        blob_ids: ActiveStorage::Blob.where(account_id: id).ids
+      }
+    end
+
+    # SQLite's FTS virtual table is not returned by connection.tables, so it
+    # needs to be cleared before its backing search records are removed.
+    def delete_search_index_records(account_id)
+      return unless self.class.connection.adapter_name == "SQLite"
+
+      search_record_ids = self.class.connection.select_values(<<~SQL.squish)
+        SELECT id FROM #{self.class.connection.quote_table_name("search_records")}
+        WHERE #{self.class.connection.quote_column_name("account_id")} = #{quote_uuid(account_id)}
+      SQL
+
+      delete_records_where_in("search_records_fts", "rowid", search_record_ids, serialize: false)
+    end
+
+    def delete_join_records(ids)
+      delete_records_where_in "assignees_filters", "assignee_id", ids[:user_ids]
+      delete_records_where_in "assignees_filters", "filter_id", ids[:filter_ids]
+      delete_records_where_in "assigners_filters", "assigner_id", ids[:user_ids]
+      delete_records_where_in "assigners_filters", "filter_id", ids[:filter_ids]
+      delete_records_where_in "boards_filters", "board_id", ids[:board_ids]
+      delete_records_where_in "boards_filters", "filter_id", ids[:filter_ids]
+      delete_records_where_in "closers_filters", "closer_id", ids[:user_ids]
+      delete_records_where_in "closers_filters", "filter_id", ids[:filter_ids]
+      delete_records_where_in "creators_filters", "creator_id", ids[:user_ids]
+      delete_records_where_in "creators_filters", "filter_id", ids[:filter_ids]
+      delete_records_where_in "filters_tags", "filter_id", ids[:filter_ids]
+      delete_records_where_in "filters_tags", "tag_id", ids[:tag_ids]
+    end
+
+    def delete_storage_totals(account_id, board_ids)
+      conditions = [
+        "(owner_type = #{self.class.connection.quote("Account")} AND owner_id = #{quote_uuid(account_id)})"
+      ]
+
+      if board_ids.any?
+        quoted_board_ids = board_ids.map { |board_id| quote_uuid(board_id) }.join(", ")
+        conditions << "(owner_type = #{self.class.connection.quote("Board")} AND owner_id IN (#{quoted_board_ids}))"
+      end
+
+      self.class.connection.delete <<~SQL.squish
+        DELETE FROM #{self.class.connection.quote_table_name("storage_totals")}
+        WHERE #{conditions.join(" OR ")}
+      SQL
+    end
+
+    # Account-scoped tables all carry an account_id. Discovering them from the
+    # schema keeps this purge from silently missing a newly-added tenant table.
+    def delete_account_scoped_records(account_id)
+      self.class.connection.tables.each do |table_name|
+        next if table_name == self.class.table_name
+        next unless self.class.connection.columns(table_name).any? { |column| column.name == "account_id" }
+
+        self.class.connection.delete <<~SQL.squish
+          DELETE FROM #{self.class.connection.quote_table_name(table_name)}
+          WHERE #{self.class.connection.quote_column_name("account_id")} = #{quote_uuid(account_id)}
+        SQL
+      end
+    end
+
+    def delete_records_where_in(table_name, column_name, values, serialize: true)
+      return if values.empty?
+
+      quoted_values = values.map { |value| serialize ? quote_uuid(value) : self.class.connection.quote(value) }.join(", ")
+      self.class.connection.delete <<~SQL.squish
+        DELETE FROM #{self.class.connection.quote_table_name(table_name)}
+        WHERE #{self.class.connection.quote_column_name(column_name)} IN (#{quoted_values})
+      SQL
+    end
+
+    def quote_uuid(value)
+      self.class.connection.quote(self.class.type_for_attribute("id").serialize(value))
+    end
 end
