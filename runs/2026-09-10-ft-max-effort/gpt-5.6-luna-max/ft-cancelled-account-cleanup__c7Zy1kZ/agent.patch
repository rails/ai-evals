@@ -0,0 +1,8 @@
+class Account::IncinerateDueJob < ApplicationJob
+  def perform
+    Account
+      .joins(:cancellation)
+      .where(account_cancellations: { created_at: ...Account::Incineratable::INCINERATION_GRACE_PERIOD.ago })
+      .find_each(&:incinerate)
+  end
+end
