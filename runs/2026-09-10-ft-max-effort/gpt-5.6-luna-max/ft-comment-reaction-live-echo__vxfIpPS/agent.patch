diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..9e2784c
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,34 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true
+  belongs_to :reacter, class_name: "User", inverse_of: :reactions, default: -> { Current.user }
+
+  before_validation :normalize_content
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+  validates :reacter, presence: true
+
+  scope :chronologically, -> { order created_at: :asc, id: :desc }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  after_create_commit :broadcast_reactions
+  after_destroy_commit :broadcast_reactions
+
+  delegate :card, to: :reactable
+
+  private
+    def broadcast_reactions
+      return unless reactable&.persisted?
+
+      broadcast_replace_later_to card,
+        target: ActionView::RecordIdentifier.dom_id(reactable, :reactions),
+        partial: "cards/comments/reactions/reactions",
+        locals: { comment: reactable }
+    end
+
+    def normalize_content
+      self.content = content.to_s.strip
+    end
+end
