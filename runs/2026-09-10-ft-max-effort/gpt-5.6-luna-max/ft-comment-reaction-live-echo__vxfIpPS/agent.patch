diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..3451bef
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", Reaction.last.content
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal Reaction.last.id, @response.parsed_body["id"]
+  end
+
+  test "create as a Turbo Stream replaces the comment reactions" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Live" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_select "turbo-stream[action='replace'][target='#{ActionView::RecordIdentifier.dom_id(@comment, :reactions)}']"
+    assert_select "turbo-stream .reaction__content", text: "Live"
+  end
+
+  test "create with flat JSON params" do
+    post card_comment_reactions_path(@card, @comment), params: { content: "Looks good" }, as: :json
+
+    assert_response :created
+    assert_equal "Looks good", Reaction.last.content
+  end
+
+  test "content is limited to 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "This is too long!" } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "show as JSON" do
+    reaction = @comment.reactions.create!(content: "👏", reacter: users(:kevin))
+
+    get card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+  end
+
+  test "index as JSON" do
+    @comment.reactions.create!(content: "👏", reacter: users(:kevin))
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ "👏" ], @response.parsed_body.map { |reaction| reaction["content"] }
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "destroy own reaction" do
+    reaction = @comment.reactions.create!(content: "Remove me", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy as a Turbo Stream replaces the comment reactions" do
+    reaction = @comment.reactions.create!(content: "Remove me", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+
+    assert_response :success
+    assert_select "turbo-stream[action='replace'][target='#{ActionView::RecordIdentifier.dom_id(@comment, :reactions)}']"
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = @comment.reactions.create!(content: "Hands off", reacter: users(:jz))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
