+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT MIN(account_id)
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+        )
+        WHERE EXISTS (
+          SELECT 1
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+        )
+      SQL
+    end
+
+    def remove_orphaned_storage_records
+      execute <<~SQL
+        DELETE FROM active_storage_attachments
+        WHERE account_id IS NULL
+           OR NOT EXISTS (
+             SELECT 1 FROM accounts
+             WHERE accounts.id = active_storage_attachments.account_id
+           )
+           OR NOT EXISTS (
+             SELECT 1 FROM active_storage_blobs
+             WHERE active_storage_blobs.id = active_storage_attachments.blob_id
+           )
+           OR EXISTS (
+             SELECT 1 FROM active_storage_blobs
+             WHERE active_storage_blobs.id = active_storage_attachments.blob_id
+               AND active_storage_blobs.account_id IS NOT NULL
+               AND active_storage_blobs.account_id <> active_storage_attachments.account_id
+           )
+      SQL
+
+      execute <<~SQL
+        DELETE FROM active_storage_variant_records
+        WHERE NOT EXISTS (
+          SELECT 1
+          FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+        )
+      SQL
