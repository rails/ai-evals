+      populate_from_parent "reactions", "comments", "reactable_id", source_type: "Comment", source_type_column: "reactable_type"
+
+      populate_from_account_id "entropies", "container_id", source_type: "Account", source_type_column: "container_type"
+      populate_from_parent "entropies", "boards", "container_id", source_type: "Board", source_type_column: "container_type"
+      populate_from_parent "entropies", "cards", "container_id", source_type: "Card", source_type_column: "container_type"
+    end
+
+    def remove_orphaned_join_records
+      join_records = {
+        "assignees_filters" => [ [ "filters", "filter_id" ], [ "users", "assignee_id" ] ],
+        "assigners_filters" => [ [ "filters", "filter_id" ], [ "users", "assigner_id" ] ],
+        "boards_filters" => [ [ "filters", "filter_id" ], [ "boards", "board_id" ] ],
+        "closers_filters" => [ [ "filters", "filter_id" ], [ "users", "closer_id" ] ],
+        "creators_filters" => [ [ "filters", "filter_id" ], [ "users", "creator_id" ] ],
+        "filters_tags" => [ [ "filters", "filter_id" ], [ "tags", "tag_id" ] ]
+      }
+
+      join_records.each do |join_table, parents|
+        conditions = parents.map do |parent_table, foreign_key|
+          "NOT EXISTS (SELECT 1 FROM #{parent_table} WHERE #{parent_table}.id = #{join_table}.#{foreign_key} AND #{parent_table}.account_id = #{join_table}.account_id)"
+        end
+
+        execute <<~SQL
+          DELETE FROM #{join_table}
+          WHERE #{conditions.join(" OR ")}
+        SQL
+      end
+    end
+
