+      populate_from_parent "storage_totals", "boards", "owner_id", source_type: "Board", source_type_column: "owner_type"
+      populate_from_parent "active_storage_variant_records", "active_storage_blobs", "blob_id"
+    end
+
+    def remove_orphaned_account_records
+      ACCOUNT_TABLES.each do |table_name|
+        delete_orphaned_rows table_name
+      end
+    end
+
+    def remove_orphaned_search_records
+      search_record_tables.each do |table_name|
+        delete_orphaned_rows table_name
+      end
+    end
+
+    def enforce_account_id_constraints
+      ACCOUNT_TABLES.each do |table_name|
+        change_column_null table_name, :account_id, false
+        add_index table_name, :account_id unless account_id_index_exists?(table_name)
+      end
+
+      remove_index :tags, name: "index_tags_on_title" if index_exists?(:tags, :title, name: "index_tags_on_title")
+      add_index :tags, [ :account_id, :title ], unique: true,
+        name: "index_tags_on_account_id_and_title"
+    end
+
+    def remove_account_id_indexes
+      ACCOUNT_TABLES.each do |table_name|
+        if table_exists?(table_name) && account_id_index_exists?(table_name)
+          remove_index table_name, column: :account_id
+        end
+      end
+    end
+
+    def account_id_index_exists?(table_name)
+      indexes(table_name).any? { |index| index.columns == [ "account_id" ] }
+    end
+
+    def populate_from_parent(child_table, parent_table, foreign_key, source_type: nil, source_type_column: nil)
+      source_type_column ||= "source_type" if source_type
+      predicates = [ "#{parent_table}.id = #{child_table}.#{foreign_key}" ]
+      predicates << "#{child_table}.#{source_type_column} = #{connection.quote(source_type)}" if source_type
+
+      execute <<~SQL
+        UPDATE #{child_table}
+        SET account_id = (
+          SELECT #{parent_table}.account_id
+          FROM #{parent_table}
+          WHERE #{predicates.join(" AND ")}
+        )
+        WHERE #{child_table}.account_id IS NULL
+          AND EXISTS (
+            SELECT 1
+            FROM #{parent_table}
+            WHERE #{predicates.join(" AND ")}
+          )
+      SQL
+    end
+
+    def populate_from_account_id(child_table, foreign_key, source_type:, source_type_column:)
+      execute <<~SQL
+        UPDATE #{child_table}
+        SET account_id = #{child_table}.#{foreign_key}
+        WHERE #{child_table}.account_id IS NULL
+          AND #{child_table}.#{source_type_column} = #{connection.quote(source_type)}
+          AND EXISTS (
+            SELECT 1 FROM accounts
+            WHERE accounts.id = #{child_table}.#{foreign_key}
+          )
+      SQL
+    end
+
+    def delete_missing_parent(child_table, parent_table, foreign_key)
+      execute <<~SQL
+        DELETE FROM #{child_table}
+        WHERE NOT EXISTS (
+          SELECT 1
+          FROM #{parent_table}
+          WHERE #{parent_table}.id = #{child_table}.#{foreign_key}
+        )
+      SQL
+    end
+
+    def delete_orphaned_rows(table_name)
+      execute <<~SQL
+        DELETE FROM #{table_name}
+        WHERE account_id IS NULL
+           OR NOT EXISTS (
+             SELECT 1 FROM accounts
+             WHERE accounts.id = #{table_name}.account_id
+           )
+      SQL
+    end
+
+    def search_record_tables
+      if connection.adapter_name == "SQLite"
+        [ "search_records" ]
+      else
+        16.times.map { |shard_id| "search_records_#{shard_id}" }
+      end
+    end
+end
