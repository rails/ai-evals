+      populate_from_parent "active_storage_attachments", "boards", "record_id", source_type: "Board", source_type_column: "record_type"
+      populate_from_parent "active_storage_attachments", "cards", "record_id", source_type: "Card", source_type_column: "record_type"
+      populate_from_parent "active_storage_attachments", "comments", "record_id", source_type: "Comment", source_type_column: "record_type"
+      populate_from_parent "active_storage_attachments", "users", "record_id", source_type: "User", source_type_column: "record_type"
+      populate_from_parent "active_storage_attachments", "exports", "record_id", source_type: "Export", source_type_column: "record_type"
+      populate_from_parent "active_storage_attachments", "account_imports", "record_id", source_type: "Account::Import", source_type_column: "record_type"
+      populate_from_parent "active_storage_attachments", "action_text_rich_texts", "record_id", source_type: "ActionText::RichText", source_type_column: "record_type"
+    end
