+require "test_helper"
+
+class ReactionCardTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+  end
+
+  test "creating a card reaction touches the card activity" do
+    assert_changes -> { @card.reload.last_active_at } do
+      @card.reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "a reaction belongs to exactly one target" do
+    reaction = Reaction.new(content: "Nice!")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:base], "must belong to either a card or a comment"
+  end
+
+  test "card reactions are deleted with their card" do
+    reaction = @card.reactions.create!(content: "Nice!")
+
+    assert_difference -> { Reaction.where(id: reaction.id).count }, -1 do
+      @card.destroy!
+    end
+  end
+end
