diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..03b88b4
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,57 @@
+<% app_fqdn = "fizzy.example.com" %>
+
+# A single-host deployment for the SQLite edition of Fizzy.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - <%= app_fqdn %>
+
+# kamal-proxy obtains and renews the Let's Encrypt certificate for this host.
+# Point DNS at the server and allow inbound ports 80 and 443 before running setup.
+proxy:
+  ssl: true
+  host: <%= app_fqdn %>
+
+# The local registry is forwarded over SSH to the deployment host. This avoids
+# requiring a hosted image registry for a one-box installation.
+registry:
+  server: localhost:5555
+
+# Build for the Linux server even when Kamal is run from an Apple Silicon Mac.
+builder:
+  arch: amd64
+
+asset_path: /rails/public/assets
+
+# Solid Queue is loaded by Puma, so the web container is also the job container.
+# Keep this volume name stable: it contains SQLite databases and local uploads.
+volumes:
+  - fizzy:/rails/storage
+
+env:
+  clear:
+    RAILS_ENV: production
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+    APP_FQDN: <%= app_fqdn %>
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: "1"
+    JOB_CONCURRENCY: "1"
+
+    # Replace this with the hostname of the SMTP server used by this installation.
+    SMTP_ADDRESS: smtp.example.com
+    MAILER_FROM_ADDRESS: "Fizzy <support@<%= app_fqdn %>>"
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: <%= app_fqdn %>
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
