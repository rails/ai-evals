+
+## Self-hosted deployment
+
+The repository includes a Kamal configuration for a single Linux server running
+Docker. It uses SQLite and local Active Storage in a persistent Docker volume,
+and runs Solid Queue inside Puma, so the web app and background jobs stay in one
+container. Kamal's proxy obtains and renews the HTTPS certificate with Let's
+Encrypt.
+
+1. Point DNS for your hostname at the server and make ports 80 and 443 reachable.
+2. In `config/deploy.yml`, replace `app.example.com` and `smtp.example.com` with
+   your hostname and SMTP server.
+3. Copy `.kamal/secrets.example` to `.kamal/secrets` and fill in the Rails and
+   SMTP secrets. Generate `SECRET_KEY_BASE` with `openssl rand -hex 64`.
+4. Ensure your local Docker installation can build the image and that your SSH
+   user can administer Docker on the server.
+5. Run `bin/kamal setup` (or `kamal setup`).
+
+The `fizzy_storage` volume contains the SQLite databases and uploaded files; do
+not remove it when replacing or upgrading the container.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..8c6ebf1
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,59 @@
+# One-box deployment for a self-hosted Fizzy instance.
+# Replace every app.example.com occurrence with your public hostname and
+# smtp.example.com with your outbound mail server before deploying.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - app.example.com
+
+proxy:
+  ssl: true
+  host: app.example.com
+
+# Kamal runs a local registry and forwards it over SSH to the server. This keeps
+# the setup usable from a fork without requiring a public image registry.
+registry:
+  server: localhost:5555
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Run Solid Queue's supervisor from Puma so web requests and background jobs
+    # share this one container and this one server.
+    SOLID_QUEUE_IN_PUMA: true
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+
+    # Public application URL and outbound mail server.
+    APP_FQDN: app.example.com
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: app.example.com
+    SMTP_ENABLE_STARTTLS_AUTO: true
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# This volume contains all SQLite databases and local Active Storage files.
+# It is deliberately outside the image so a deploy cannot replace application
+# data with the new container filesystem.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Keep fingerprinted assets available while old containers drain during deploys.
+asset_path: /rails/public/assets
+
+builder:
+  arch: amd64
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse "bash"
+  logs: app logs -f
