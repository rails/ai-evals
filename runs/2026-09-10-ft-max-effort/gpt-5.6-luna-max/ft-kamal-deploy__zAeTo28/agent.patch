+# Copy this file to .kamal/secrets and replace every value before deploying.
+# Keep .kamal/secrets private; it is ignored by git.
+
+# Generate with: openssl rand -hex 64
+SECRET_KEY_BASE=replace-with-a-long-random-secret
+
+# Rails master key (use config/master.key if you add encrypted credentials).
+RAILS_MASTER_KEY=replace-with-your-rails-master-key
+
+# Credentials for the SMTP server configured in config/deploy.yml.
+SMTP_USERNAME=replace-with-your-smtp-username
+SMTP_PASSWORD=replace-with-your-smtp-password
