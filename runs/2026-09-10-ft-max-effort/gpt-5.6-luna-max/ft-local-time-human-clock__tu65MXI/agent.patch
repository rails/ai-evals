diff --git a/app/javascript/controllers/date_controller.js b/app/javascript/controllers/date_controller.js
new file mode 100644
index 0000000..7a5a122
--- /dev/null
+++ b/app/javascript/controllers/date_controller.js
@@ -0,0 +1,52 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/date_helpers"
+
+const RERENDER_INTERVAL = 60 * 1000
+const DYNAMIC_FORMATS = new Set([ "comment", "future", "relative" ])
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "date" } }
+
+  connect() {
+    this.render = this.render.bind(this)
+    document.addEventListener("turbo:render", this.render)
+    this.observer = new MutationObserver(this.render)
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime", "data-date-format-value" ] })
+    this.render()
+
+    if (DYNAMIC_FORMATS.has(this.formatValue)) {
+      this.timer = setInterval(this.render, RERENDER_INTERVAL)
+    }
+  }
+
+  disconnect() {
+    document.removeEventListener("turbo:render", this.render)
+    this.observer?.disconnect()
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const date = this.date
+
+    if (date) {
+      this.element.textContent = formatTimestamp(date, this.formatValue)
+      this.element.dispatchEvent(new CustomEvent("date:rendered", { bubbles: true }))
+    }
+  }
+
+  get date() {
+    const value = this.element.getAttribute("datetime")
+
+    if (!value) {
+      return
+    }
+
+    if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+      const [ year, month, day ] = value.split("-").map(Number)
+      return new Date(year, month - 1, day)
+    }
+
+    const date = new Date(value)
+    return Number.isNaN(date.getTime()) ? undefined : date
+  }
+}
