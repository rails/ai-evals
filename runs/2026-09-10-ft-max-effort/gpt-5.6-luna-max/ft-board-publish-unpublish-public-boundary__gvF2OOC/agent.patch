--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,29 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  def publish
+    update!(public_key: public_key.presence || generate_public_key)
+  end
+
+  def unpublish
+    update!(public_key: nil)
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def public_url
+    Rails.application.routes.url_helpers.public_board_path(public_key) if published?
+  end
+
+  private
+    def generate_public_key
+      loop do
+        key = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+        break key unless self.class.exists?(public_key: key)
+      end
+    end
+end
