+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="public-board">
+  <% if @columns.any? %>
+    <div class="public-board__columns">
+      <% @columns.each do |column| %>
+        <section class="public-board__column">
+          <h2 class="public-board__column-title">
+            <%= link_to column.name, public_board_column_path(@board.public_key, column) %>
+          </h2>
+
+          <ul class="public-board__cards">
+            <% @cards_by_column.fetch(column.id, []).each do |card| %>
+              <li><%= link_to "##{card.number} #{card.title}", public_board_card_path(@board.public_key, card) %></li>
+            <% end %>
+          </ul>
+        </section>
+      <% end %>
+    </div>
+  <% end %>
+
+  <% if (cards_without_column = @cards_by_column[nil]).present? %>
+    <section class="public-board__column public-board__column--untriaged">
+      <h2 class="public-board__column-title">Maybe?</h2>
+      <ul class="public-board__cards">
+        <% cards_without_column.each do |card| %>
+          <li><%= link_to "##{card.number} #{card.title}", public_board_card_path(@board.public_key, card) %></li>
+        <% end %>
+      </ul>
+    </section>
+  <% end %>
+
+  <% if @cards.empty? %>
+    <p class="blank-slate">No cards have been published yet.</p>
+  <% end %>
+</section>
