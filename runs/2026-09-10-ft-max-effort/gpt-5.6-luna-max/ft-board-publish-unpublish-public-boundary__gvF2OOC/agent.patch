--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "public URL is nil until published" do
+    assert_nil @board.public_url
+  end
+
+  test "publish assigns a unique public key and URL" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.public_key.present?
+    assert_equal "/public/boards/#{@board.public_key}", @board.public_url
+  end
+
+  test "unpublish removes the public URL" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.public_url
+  end
+end
