diff --git a/test/models/webhook/delivery_integration_test.rb b/test/models/webhook/delivery_integration_test.rb
new file mode 100644
index 0000000..420e2c9
--- /dev/null
+++ b/test/models/webhook/delivery_integration_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Webhook::DeliveryIntegrationTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "Delivery test",
+      url: "https://receiver.example.test/webhooks",
+      subscribed_actions: [ "card_published" ]
+    )
+    @event = events(:logo_published)
+  end
+
+  test "event creation queues relay after commit" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      Event.create!(
+        board: @webhook.board,
+        account: @webhook.account,
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_published"
+      )
+    end
+  end
+
+  test "an event creates one delivery and posts its signed payload" do
+    stub_request(:post, @webhook.url).to_return(status: 202)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      @event.relay_later
+    end
+
+    delivery = @webhook.deliveries.sole
+    assert delivery.succeeded?
+    assert_equal "completed", delivery.state
+    assert_equal 202, delivery.response_summary[:code]
+    assert_requested :post, @webhook.url, times: 1
+    assert_requested :post, @webhook.url, headers: {
+      "Content-Type" => "application/json",
+      "X-Webhook-Signature" => delivery.request["headers"]["X-Webhook-Signature"]
+    }
+  end
+
+  test "a delivery is posted at most once even when delivered again" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    delivery = @webhook.deliver_later(@event)
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    delivery.deliver_now
+
+    assert_requested :post, @webhook.url, times: 1
+    assert_equal 1, @webhook.deliveries.where(event: @event).count
+  end
+
+  test "ten failures within an hour deactivate a webhook" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    10.times do
+      event = Event.create!(board: @webhook.board, account: @webhook.account, creator: users(:david), eventable: cards(:logo), action: "card_published")
+      Webhook::Delivery.create!(webhook: @webhook, event: event).deliver_now
+    end
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a success resets consecutive failures" do
+    @webhook.delinquency_tracker.update!(consecutive_failures_count: 9, first_failure_at: 10.minutes.ago)
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::Delivery.create!(webhook: @webhook, event: @event).deliver_now
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "delivery cleanup keeps one week of history" do
+    old_delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    old_delivery.update_columns(created_at: 1.week.ago - 1.second)
+    recent_delivery = Webhook::Delivery.create!(webhook: @webhook, event: events(:layout_published))
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+end
