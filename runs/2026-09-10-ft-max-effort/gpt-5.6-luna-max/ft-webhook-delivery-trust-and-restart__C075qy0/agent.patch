@@ -27,6 +65,101 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response_error.blank? && response_code.to_i.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        if pending?
+          update! state: :in_progress
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def complete(http_response)
+      update! state: :completed, response: { code: http_response.code.to_i }
+
+      if succeeded?
+        delinquency_tracker.record_success
+      else
+        delinquency_tracker.record_failure
+      end
+    end
+
+    def fail_delivery(error)
+      update! state: :errored, response: { error: error_code(error) }
+      delinquency_tracker.record_failure
+    end
+
+    def response_code
+      response[:code] || response["code"]
+    end
+
+    def response_error
+      response[:error] || response["error"]
+    end
+
+    def delinquency_tracker
+      webhook.delinquency_tracker || Webhook::DelinquencyTracker.create_or_find_by!(webhook: webhook)
+    end
+
+    def payload
+      if webhook.for_slack?
+        { text: render_event(:html) }.to_json
+      elsif webhook.for_basecamp?
+        { content: render_event(:html) }.to_json
+      elsif webhook.for_campfire?
+        { body: render_event(:html) }.to_json
+      else
+        render_event(:json)
+      end
+    end
+
+    def render_event(format)
+      Current.with_account(event.account) do
+        ApplicationController.renderer.new(script_name: event.account.slug).render(
+          template: "webhooks/event",
+          formats: [ format ],
+          assigns: { event: event },
+          layout: false
+        )
+      end
+    end
+
+    def request_headers(body)
+      timestamp = event.created_at.utc.iso8601(3)
+
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest(OpenSSL::Digest::SHA256.new, webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 10
+      http.read_timeout = 10
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http.request(request)
+    end
+
+    def error_code(error)
+      if NETWORK_ERRORS.any? { |error_class| error.is_a?(error_class) }
+        "destination_unreachable"
+      else
+        error.message.presence || error.class.name
+      end
+    end
 end
