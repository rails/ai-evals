diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..7e4a21a
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,34 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  MAX_CONSECUTIVE_FAILURES = FAILURE_LIMIT
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    with_lock do
+      now = Time.current
+
+      if first_failure_at.present? && first_failure_at >= now - FAILURE_WINDOW
+        self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+      else
+        self.consecutive_failures_count = 1
+        self.first_failure_at = now
+      end
+
+      save!
+      webhook.deactivate if consecutive_failures_count >= FAILURE_LIMIT && webhook.active?
+    end
+  end
+
+  def record_success
+    with_lock do
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  alias failure! record_failure
+  alias success! record_success
+  alias reset record_success
+end
