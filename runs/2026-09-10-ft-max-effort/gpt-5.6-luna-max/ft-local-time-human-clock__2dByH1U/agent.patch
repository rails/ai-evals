diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..b7c55f3 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,19 @@
 module TimeHelper
+  # Keep the cached HTML independent of the server timezone. The browser formats this value.
+  def local_time_tag(time, format: :relative, **options)
+    local_time_element(time.utc.iso8601, format: format, **options)
+  end
+
+  def local_date_tag(date, format: :long_date, **options)
+    local_time_element(date.to_date.iso8601, format: format, **options)
+  end
+
+  private
+    def local_time_element(timestamp, format:, **options)
+      data = options.delete(:data) || {}
+      data[:controller] = [ data[:controller], "time" ].compact.join(" ")
+      data[:time_format_value] = format
+
+      tag.time **options, datetime: timestamp, data: data
+    end
 end
