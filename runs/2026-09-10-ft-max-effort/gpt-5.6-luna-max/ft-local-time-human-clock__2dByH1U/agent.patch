diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..7851573
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    this.#observeChanges()
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+  }
+
+  render() {
+    this.element.textContent = formatLocalTime(this.element.getAttribute("datetime"), this.formatValue)
+  }
+
+  #observeChanges() {
+    this.observer = new MutationObserver(() => this.render())
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime", "data-time-format-value" ] })
+  }
+}
