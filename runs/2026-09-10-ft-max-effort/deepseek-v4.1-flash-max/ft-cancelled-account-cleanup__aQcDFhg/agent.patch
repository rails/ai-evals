diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..825c8da 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,106 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      where(id: Account::Cancellation.due.select(:account_id))
+    }
+    scope :incineratable, -> { due_for_incineration }
+    scope :due, -> { due_for_incineration }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+
+    # Tables that hold account-owned records. Discovered from the schema so
+    # that new account-scoped tables are covered without maintaining a list.
+    def account_scoped_table_names
+      @account_scoped_table_names ||= connection.tables.select do |table_name|
+        connection.columns(table_name).any? { |column| column.name == "account_id" }
+      end
+    end
+
+    # Uses an anonymous Active Record model so UUID values are serialized with
+    # the same custom type as the rest of the application.
+    def model_for_table(table_name)
+      @models ||= {}
+      @models[table_name] ||= Class.new(ApplicationRecord) do
+        self.table_name = table_name
+      end
+    end
+  end
+
+  def incineratable?
+    cancellation&.due?
+  end
+  alias_method :due_for_incineration?, :incineratable?
+  alias_method :due?, :incineratable?
+
+  def incinerate
+    with_lock do
+      transaction do
+        destroy_search_index
+        destroy_filter_join_rows
+        destroy_storage_totals
+        destroy_account_scoped_records
+      end
+
+      destroy!
+    end
+  end
+  alias_method :incinerate!, :incinerate
+
+  private
+    def connection
+      self.class.connection
+    end
+
+    def destroy_search_index
+      return unless search_index_exists?
+
+      Search::Record::SQLite::Fts.where(rowid: Search::Record.where(account_id: id).select(:id)).delete_all
+    end
+
+    # SQLite FTS5 tables are virtual tables, so #table_exists? does not see them.
+    def search_index_exists?
+      connection.adapter_name.downcase.include?("sqlite") &&
+        connection.select_value("SELECT COUNT(*) FROM sqlite_master WHERE name = 'search_records_fts'").to_i.positive?
+    end
+
+    def destroy_filter_join_rows
+      filter_ids = ::Filter.where(account_id: id).select(:id).to_sql
+      user_ids = ::User.where(account_id: id).select(:id).to_sql
+      board_ids = ::Board.where(account_id: id).select(:id).to_sql
+      tag_ids = ::Tag.where(account_id: id).select(:id).to_sql
+
+      destroy_join_rows "assignees_filters", "assignee_id", user_ids, filter_ids
+      destroy_join_rows "assigners_filters", "assigner_id", user_ids, filter_ids
+      destroy_join_rows "boards_filters", "board_id", board_ids, filter_ids
+      destroy_join_rows "closers_filters", "closer_id", user_ids, filter_ids
+      destroy_join_rows "creators_filters", "creator_id", user_ids, filter_ids
+      destroy_join_rows "filters_tags", "tag_id", tag_ids, filter_ids
+    end
+
+    def destroy_join_rows(table_name, owner_column, owner_ids, filter_ids)
+      connection.delete <<~SQL
+        DELETE FROM #{connection.quote_table_name(table_name)}
+        WHERE filter_id IN (#{filter_ids})
+           OR #{connection.quote_column_name(owner_column)} IN (#{owner_ids})
+      SQL
+    end
+
+    def destroy_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: ::Board.where(account_id: id).select(:id)).delete_all
+    end
+
+    def destroy_account_scoped_records
+      self.class.account_scoped_table_names.each do |table_name|
+        self.class.model_for_table(table_name).where(account_id: id).delete_all
+      end
+    end
 end
