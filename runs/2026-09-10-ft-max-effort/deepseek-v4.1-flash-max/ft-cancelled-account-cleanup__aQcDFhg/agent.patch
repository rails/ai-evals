diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8658b74
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,236 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:initech)
+    @user = users(:mike)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    cancel_account(@account, at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_nil Account.find_by(id: @account.id)
+  end
+
+  test "removes all data associated with a due account" do
+    cancel_account(@account, at: 31.days.ago)
+    @account.users.first.settings # ensure associations are loaded
+
+    Account::IncinerateDueJob.perform_now
+
+    account_scoped_tables.each do |table|
+      assert_equal 0, count_for(table, @account.id), "Expected #{table} rows to be removed"
+    end
+
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: @account.id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: boards_of(@account)).count
+  end
+
+  test "does not incinerate accounts cancelled less than 30 days ago" do
+    cancel_account(@account, at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerates all due accounts and leaves non-due accounts untouched" do
+    active_account = accounts(:acme)
+    cancel_account(@account, at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(active_account.id)
+    assert Account.exists?(accounts("37s").id)
+  end
+
+  test "removes filter join rows for a due account" do
+    cancel_account(@account, at: 31.days.ago)
+
+    board = @account.boards.first
+    tag = @account.tags.create!(title: "incinerate me")
+    filter = Filter.create!(creator: @user)
+    filter.tags << tag
+    filter.board_ids = [ board.id ]
+    filter.assignees << @user
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_equal 0, join_row_count("assignees_filters", "filter_id", filter.id)
+    assert_equal 0, join_row_count("boards_filters", "filter_id", filter.id)
+    assert_equal 0, join_row_count("filters_tags", "filter_id", filter.id)
+  end
+
+  test "removes storage totals and search index for a due account" do
+    cancel_account(@account, at: 31.days.ago)
+
+    board = @account.boards.first
+    card = @account.cards.first
+    Storage::Total.create!(owner: @account, bytes_stored: 10)
+    Storage::Total.create!(owner: board, bytes_stored: 10)
+    Storage::Entry.create!(account: @account, board: board, delta: 10, operation: "attach")
+
+    search_record = Search::Record.for(@account.id).create!(
+      account_id: @account.id,
+      searchable_type: "Card",
+      searchable_id: card.id,
+      card_id: card.id,
+      board_id: board.id,
+      title: "incinerate me",
+      content: "incinerate me",
+      created_at: Time.current
+    )
+    rowid = search_record.id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: @account.id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: board.id).count
+    assert_equal 0, Storage::Entry.where(account_id: @account.id).count
+
+    if ActiveRecord::Base.connection.adapter_name == "SQLite"
+      fts_count = ActiveRecord::Base.connection.select_value(
+        "SELECT COUNT(*) FROM search_records_fts WHERE rowid = #{rowid}"
+      ).to_i
+      assert_equal 0, fts_count
+    end
+  end
+
+  test "removes active storage attachments and blobs for a due account" do
+    cancel_account(@account, at: 31.days.ago)
+
+    card = @account.cards.first
+    Current.with_account(@account) do
+      card.image.attach(io: StringIO.new("image-data"), filename: "image.png", content_type: "image/png")
+    end
+
+    assert_operator ActiveStorage::Blob.where(account_id: @account.id).count, :>, 0
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_equal 0, ActiveStorage::Blob.where(account_id: @account.id).count
+    assert_equal 0, ActiveStorage::Attachment.where(account_id: @account.id).count
+  end
+
+  test "is idempotent" do
+    cancel_account(@account, at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "selects only accounts due for incineration" do
+    due_account = @account
+    recent_account = accounts(:acme)
+    recent_account.cancel(initiated_by: users(:david))
+    recent_account.cancellation.update_column(:created_at, 29.days.ago)
+    due_account.cancel(initiated_by: @user)
+    due_account.cancellation.update_column(:created_at, 31.days.ago)
+
+    assert_equal [ due_account ], Account.due_for_incineration.to_a
+    assert_equal [ due_account ], Account.incineratable.to_a
+    assert_equal [ due_account ], Account.due.to_a
+    assert Account::Cancellation.due.include?(due_account.cancellation)
+    assert due_account.incineratable?
+    assert due_account.due?
+    assert_not recent_account.incineratable?
+    assert_not accounts("37s").incineratable?
+  end
+
+  test "works when enqueued through ActiveJob" do
+    cancel_account(@account, at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      perform_enqueued_jobs { Account::IncinerateDueJob.perform_later }
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "incinerate removes the account and marks it destroyed" do
+    account_id = @account.id
+    cancel_account(@account, at: 31.days.ago)
+
+    @account.incinerate
+
+    assert @account.destroyed?
+    assert_not Account.exists?(account_id)
+    assert_not Account::Cancellation.exists?(account_id: account_id)
+  end
+
+  test "removes comments and rich text for a due account" do
+    cancel_account(@account, at: 31.days.ago)
+
+    card = @account.cards.first
+    Current.with_account(@account) do
+      card.comments.create!(creator: @user, body: "Goodbye")
+    end
+
+    assert_operator Comment.where(account_id: @account.id).count, :>, 0
+    assert_operator ActionText::RichText.where(account_id: @account.id).count, :>, 0
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_equal 0, Comment.where(account_id: @account.id).count
+    assert_equal 0, ActionText::RichText.where(account_id: @account.id).count
+  end
+
+
+  test "does not incinerate accounts cancelled exactly 30 days ago" do
+    travel_to Time.current do
+      cancel_account(@account, at: 30.days.ago)
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(@account.id)
+    end
+  end
+
+  private
+    def cancel_account(account, at:)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update_column(:created_at, at)
+    end
+
+    def account_scoped_tables
+      ActiveRecord::Base.connection.tables.select do |table|
+        ActiveRecord::Base.connection.columns(table).any? { |column| column.name == "account_id" }
+      end
+    end
+
+    def count_for(table, account_id)
+      model = Class.new(ApplicationRecord) { self.table_name = table }
+      model.where(account_id: account_id).count
+    end
+
+    def join_row_count(table, column, value)
+      model = Class.new(ApplicationRecord) { self.table_name = table }
+      model.where(column => value).count
+    end
+
+    def boards_of(account)
+      Board.where(account_id: account.id).pluck(:id)
+    end
+end
