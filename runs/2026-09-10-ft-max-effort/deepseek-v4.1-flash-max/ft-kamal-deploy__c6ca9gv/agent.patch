--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,86 @@
+# Fizzy deployment configuration for a single Linux server running Kamal.
+#
+# Before your first deploy:
+#
+#   1. Replace the example server address and hostname below (192.0.2.10 and
+#      fizzy.example.com) with your own.
+#   2. Fill in your mail server details under env.clear.
+#   3. Copy .env.example to .env and fill in your secrets.
+#   4. Run: bin/kamal setup
+#
+# The whole app (web server and background jobs) runs in a single container,
+# and all of its data lives in the named fizzy_storage volume so it survives
+# future deploys. See docs/deployment.md for the full guide.
+
+service: fizzy
+
+# Image name used for the container built by Kamal. It is pushed to a registry
+# running on your local machine, so you don't need a registry provider account.
+image: fizzy
+
+servers:
+  web:
+    # Replace with the IP address or hostname of your server.
+    - 192.0.2.10
+
+# If you don't deploy as root, uncomment this and use a user with sudo:
+# ssh:
+#   user: app
+
+proxy:
+  # kamal-proxy terminates SSL and requests a Let's Encrypt certificate for
+  # your hostname. Ports 80 and 443 need to be reachable on the server.
+  ssl: true
+  # Replace with the hostname people will use to visit your Fizzy.
+  host: fizzy.example.com
+
+# Bridge precompiled assets across deploys to avoid momentary 404s.
+asset_path: /rails/public/assets
+
+# SQLite databases, Active Storage uploads, and exports all live in
+# /rails/storage. The named volume keeps them around between containers and
+# deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+builder:
+  # Change to arm64 if your server is ARM64 (for example, an Ampere machine).
+  arch: amd64
+
+# Kamal runs a registry on your machine and tunnels it to the server, so no
+# external registry service or credentials are required.
+registry:
+  server: localhost:5555
+
+env:
+  clear:
+    RAILS_ENV: production
+
+    # Everything runs from the single container: SQLite for the databases and
+    # local disk for Active Storage uploads (both stored in the volume).
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Public hostname used in emails, notifications and generated links.
+    # Keep this in sync with proxy.host above. APP_FQDN and FIZZY_HOST are
+    # also accepted.
+    APP_HOST: fizzy.example.com
+
+    # Outbound email. A deployed Fizzy sends verification codes by email, so
+    # this must point at a mail server that can deliver to your users.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+    # SMTP_HOST is also accepted. SMTP_PASSWORD is a secret (see .env).
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    # SMTP_USER_NAME and SMTP_USER are also accepted.
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+
+    # Run Solid Queue background jobs inside the web container.
+    SOLID_QUEUE_IN_PUMA: "true"
+
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
