+# Copy this file to .env and fill in the values below.
+#
+# .env is gitignored and is loaded automatically by bin/kamal, so these
+# secrets never need to be committed. They are consumed by .kamal/secrets.
+# See docs/deployment.md for the full deployment guide.
+
+# Generate once with `bin/rails secret` and keep the value stable. Fizzy uses
+# it to sign cookies and sessions, so changing it signs everyone out.
+SECRET_KEY_BASE=
+
+# The password for the SMTP_USERNAME configured in config/deploy.yml.
+SMTP_PASSWORD=
+
+# Only required if you use Rails encrypted credentials
+# (config/credentials.yml.enc). `bin/rails credentials:edit` writes it to
+# config/master.key, which is gitignored, and .kamal/secrets reads it there.
+# RAILS_MASTER_KEY=
