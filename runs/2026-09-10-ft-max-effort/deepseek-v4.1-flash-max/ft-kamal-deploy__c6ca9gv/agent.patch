--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,19 @@
+# Secrets for the single-server deployment in config/deploy.yml.
+#
+# Kamal loads this file with dotenv and resolves the values below from the
+# local .env file (loaded by bin/kamal) or from your environment. Keep raw
+# secrets out of this file: it is safe for git and should stay that way.
+#
+# See docs/deployment.md and .env.example for the full set-up instructions.
+
+# Signs cookies and sessions. Generate it once with `bin/rails secret` and
+# keep it stable: changing it signs everybody out.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Only required if you use Rails encrypted credentials
+# (config/credentials.yml.enc). `bin/rails credentials:edit` writes
+# config/master.key, which is gitignored.
+RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || echo "$RAILS_MASTER_KEY")
+
+# Password for the SMTP_USERNAME configured in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
