diff --git a/app/models/search/record/sqlite/fts.rb b/app/models/search/record/sqlite/fts.rb
index ed7b378..1453ec6 100644
--- a/app/models/search/record/sqlite/fts.rb
+++ b/app/models/search/record/sqlite/fts.rb
@@ -18,4 +18,17 @@ class Search::Record::SQLite::Fts < ApplicationRecord
       [ rowid, title, content ]
     )
   end
+
+  def self.bulk_upsert(records)
+    return if records.empty?
+
+    placeholders = Array.new(records.size, "(?, ?, ?)").join(", ")
+    values = records.flat_map { |rowid, title, content| [ rowid, title, content ] }
+
+    connection.exec_query(
+      "INSERT OR REPLACE INTO search_records_fts(rowid, title, content) VALUES #{placeholders}",
+      "Search::Record::SQLite::Fts Bulk Upsert",
+      values
+    )
+  end
 end
