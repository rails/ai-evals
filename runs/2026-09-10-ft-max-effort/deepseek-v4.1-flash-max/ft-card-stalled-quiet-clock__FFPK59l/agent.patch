diff --git a/test/models/card/stallable_behavior_test.rb b/test/models/card/stallable_behavior_test.rb
new file mode 100644
index 0000000..ded7fdf
--- /dev/null
+++ b/test/models/card/stallable_behavior_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Card::StallableBehaviorTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = Board.create! name: "Stallable", creator: users(:david)
+  end
+
+  test "bursts when three comments from two people land within a third of the auto-close period" do
+    card = published_card
+
+    travel_to(8.days.ago) { card.comments.create!(creator: users(:david), body: "One") }
+    travel_to(4.days.ago) { card.comments.create!(creator: users(:jz), body: "Two") }
+    assert_not card.reload.burst?
+
+    travel_to(Time.current) { card.comments.create!(creator: users(:kevin), body: "Three") }
+    assert card.reload.burst?
+  end
+
+  test "does not burst with comments from a single person" do
+    card = published_card
+
+    3.times { card.comments.create!(creator: users(:david), body: "Same") }
+
+    assert_not card.reload.burst?
+  end
+
+  test "does not burst when comments fall outside the board's auto-close period" do
+    card = published_card
+    @board.entropy.update!(auto_postpone_period: 7.days)
+
+    travel_to(5.days.ago) { card.comments.create!(creator: users(:david), body: "One") }
+    travel_to(3.days.ago) { card.comments.create!(creator: users(:jz), body: "Two") }
+    travel_to(Time.current) { card.comments.create!(creator: users(:kevin), body: "Three") }
+
+    assert_equal 3, card.comments.by_user.count
+    assert_not card.reload.burst?
+  end
+
+  test "does not count system comments as people" do
+    card = published_card
+    card.comments.create!(creator: users(:david), body: "One")
+    3.times { card.comments.create!(creator: users(:system), body: "System") }
+
+    assert_not card.reload.burst?
+  end
+
+  test "bursts when a card is assigned" do
+    card = published_card
+
+    card.toggle_assignment users(:kevin)
+
+    assert card.reload.burst?
+  end
+
+  test "bursts when a card is reopened" do
+    card = published_card
+    card.close
+
+    card.reopen
+
+    assert card.reload.burst?
+  end
+
+  test "is stalled after two quiet weeks following a burst" do
+    card = published_card
+    card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    assert card.stalled?
+    assert_includes Card.stalled, card
+    assert_includes Card.indexed_by("stalled"), card
+  end
+
+  test "is not stalled without a burst" do
+    card = published_card
+    card.update_columns(last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "activity resets a stalled card" do
+    card = published_card
+    card.update_columns(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago, stalled_at: 3.weeks.ago)
+    assert card.stalled?
+
+    card.comments.create!(creator: users(:david), body: "Back")
+    card.reload
+
+    assert_not card.stalled?
+    assert_nil card.stalled_at
+    assert_operator card.last_active_at, :>, 3.weeks.ago
+  end
+
+  test "title changes reset a stalled card" do
+    card = cards(:logo)
+    card.update_columns(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    card.update!(title: "Something new")
+
+    assert_not card.reload.stalled?
+  end
+
+  test "auto_stall_all_due persists a stall timestamp" do
+    card = published_card
+    card.update_columns(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    Card.auto_stall_all_due(as_of: 1.day.from_now)
+
+    assert_not_nil card.reload.stalled_at
+    assert card.stalled?
+  end
+
+  private
+    def published_card
+      @board.cards.create! title: "Card", status: "published", creator: users(:david)
+    end
+end
