@@ -0,0 +1,28 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, class: "search__form", role: "search" do |form| %>
+  <%= form.label :q, "Search", class: "visually-hidden" %>
+
+  <div class="flex gap-half">
+    <%= form.search_field :q, value: @query, placeholder: "Search cards by title, description, or comments", autofocus: true, class: "input filter__terms search__input", aria: { label: "Search cards" } %>
+    <%= button_tag "Search", type: "submit", name: nil, class: "btn" %>
+  </div>
+<% end %>
+
+<section id="search_results" class="cards cards--grid search__results search-results">
+  <div class="cards__list">
+    <% if @cards.any? %>
+      <%= render partial: "searches/card", collection: @cards, as: :card, locals: { query: @query } %>
+    <% else %>
+      <div class="blank-slate">
+        <%= @query.present? ? "No cards match your search" : "Search cards by title, description, or comments" %>
+      </div>
+    <% end %>
+  </div>
+</section>
