diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..346e11c
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,47 @@
+module SearchHelper
+  def search_highlight(text, query = @query)
+    if text.present? && query.present?
+      highlight(text, query, highlighter: "<mark>\\1</mark>")
+    else
+      text
+    end
+  end
+
+  def search_excerpt(content, query = @query)
+    if query.present?
+      text = excerpt_source(content, query)
+      search_highlight(truncated_text(text, query), query) if text.present?
+    end
+  end
+
+  private
+    def excerpt_source(content, query)
+      if content.respond_to?(:description)
+        matching_text(content, query) || first_text(content)
+      elsif content.respond_to?(:to_plain_text)
+        content.to_plain_text
+      else
+        content.to_s
+      end
+    end
+
+    def matching_text(card, query)
+      card_texts(card).detect { |text| text.downcase.include?(query.downcase) }
+    end
+
+    def first_text(card)
+      card_texts(card).first
+    end
+
+    def card_texts(card)
+      [ card.description&.to_plain_text, *card.comments.map { |comment| comment.body&.to_plain_text } ].compact_blank
+    end
+
+    def truncated_text(text, query)
+      if text.length > 200
+        excerpt(text, query, radius: 80) || text.truncate(200)
+      else
+        text
+      end
+    end
+end
