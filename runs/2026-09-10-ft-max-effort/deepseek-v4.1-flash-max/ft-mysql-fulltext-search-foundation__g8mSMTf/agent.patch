+++ b/test/controllers/search_page_feature_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class SearchPageFeatureTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles newest first and highlights matches" do
+    with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "Hamburger older", status: :published, creator: users(:kevin), created_at: 2.days.ago)
+      boards(:writebook).cards.create!(title: "Hamburger newer", status: :published, creator: users(:kevin), created_at: 1.day.ago)
+    end
+
+    get search_path(q: "Hamburger")
+
+    assert_response :success
+    assert_select "article.card", count: 2
+    assert_select "mark", text: "Hamburger", count: 2
+    assert_operator response.body.index(card_path(Card.find_by!(title: "Hamburger newer"))), :<, response.body.index(card_path(Card.find_by!(title: "Hamburger older")))
+  end
+
+  test "searches card descriptions and highlights matches" do
+    with_current_user(:kevin) do
+      cards(:logo).update!(description: "Needs a vector redraw")
+    end
+
+    get search_path(q: "vector")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "vector"
+  end
+
+  test "searches comment bodies and highlights matches" do
+    with_current_user(:kevin) do
+      cards(:logo).comments.create!(body: "The vector file is missing", creator: users(:kevin))
+    end
+
+    get search_path(q: "vector")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "vector"
+  end
+
+  test "does not include drafts or their comments" do
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(title: "Hamburger secret draft", status: :published, creator: users(:kevin))
+      draft.update!(description: "Hamburger secret description")
+      draft.comments.create!(body: "Hamburger secret comment", creator: users(:kevin))
+      draft.update_column(:status, "drafted")
+    end
+
+    get search_path(q: "Hamburger secret")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "only includes cards from accessible boards" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Hamburger secret", status: :published, creator: users(:kevin))
+    end
+
+    logout_and_sign_in_as :david
+    get search_path(q: "Hamburger secret")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+
+    logout_and_sign_in_as :kevin
+    get search_path(q: "Hamburger secret")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+  end
+
+  test "blank query renders page without results" do
+    get search_path
+
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+end
diff --git a/test/models/card_search_feature_test.rb b/test/models/card_search_feature_test.rb
new file mode 100644
index 0000000..482048e
--- /dev/null
+++ b/test/models/card_search_feature_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class CardSearchFeatureTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "search matches cards by title, description, or comment body without duplicates" do
+    card = cards(:logo)
+    card.update!(description: "The vector needs work")
+    card.comments.create!(body: "The vector is still off", creator: users(:kevin))
+
+    assert_equal [ card ], Card.search("vector", user: users(:kevin)).to_a
+  end
+
+  test "search only includes published cards on accessible boards" do
+    assert_empty Card.search("unfinished")
+
+    board = boards(:private)
+    Card.create!(title: "Hamburger secret", status: :published, board: board, creator: users(:kevin))
+
+    Current.session = sessions(:david)
+    assert_empty Card.search("Hamburger secret")
+  end
+
+  test "search orders newest first" do
+    older = boards(:writebook).cards.create!(title: "Hamburger older", status: :published, creator: users(:kevin), created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Hamburger newer", status: :published, creator: users(:kevin), created_at: 1.day.ago)
+
+    assert_equal [ newer, older ], Card.search("Hamburger").to_a
+  end
+  test "filter term matches card content" do
+    filter = users(:kevin).filters.new(term: "agree")
+
+    assert_includes filter.cards, cards(:logo)
+    assert_predicate filter, :used?
+  end
+  test "search excludes cards from other accounts" do
+    assert_empty Card.search("radio", user: users(:kevin))
+  end
+end
