new file mode 100644
index 0000000..513676f
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,48 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(query) do
+      query = query.to_s.strip
+
+      if query.present?
+        pattern = "%#{sanitize_sql_like(query)}%"
+
+        description_matches = ActionText::RichText
+          .where(record_type: "Card", name: "description")
+          .where("action_text_rich_texts.account_id = cards.account_id")
+          .where("action_text_rich_texts.body LIKE ?", pattern)
+
+        comment_matches = Comment
+          .joins(:rich_text_body)
+          .where("comments.account_id = cards.account_id")
+          .where("action_text_rich_texts.account_id = comments.account_id")
+          .where("action_text_rich_texts.body LIKE ?", pattern)
+
+        where("cards.title LIKE ?", pattern)
+          .or(where(id: description_matches.select(:record_id)))
+          .or(where(id: comment_matches.select(:card_id)))
+      else
+        none
+      end
+    end
+
+    scope :search, ->(query, user: Current.user) do
+      query = query.to_s.strip
+
+      if query.present?
+        published.matching(query).accessible_to(user).reverse_chronologically
+      else
+        none
+      end
+    end
+
+    scope :accessible_to, ->(user) do
+      if user
+        where(board_id: user.boards.select(:id))
+      else
+        all
+      end
+    end
+  end
+end
