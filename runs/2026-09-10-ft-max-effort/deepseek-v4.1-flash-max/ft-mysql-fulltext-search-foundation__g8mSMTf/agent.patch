+<article class="card search-result search__result" id="<%= dom_id(card, :search_result) %>" data-search-result>
+  <header class="card__header">
+    <div class="card__id">
+      <span class="for-screen-reader">Card number</span>
+      <%= card.number %>
+    </div>
+
+    <div class="card__board">
+      <div class="card__board-name">
+        <%= link_to card.board.name, board_path(card.board), class: "card__board-link", data: { turbo_frame: "_top" } %>
+      </div>
+    </div>
+  </header>
+
+  <div class="card__body">
+    <div class="card__content">
+      <h3 class="card__title">
+        <%= link_to search_highlight(card.title, query), card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } %>
+      </h3>
+
+      <% if excerpt = search_excerpt(card, query) %>
+        <p class="search-result__excerpt search__excerpt card__excerpt card__description txt-small"><%= excerpt %></p>
+      <% end %>
+    </div>
+  </div>
+
+  <footer class="card__footer">
+    <span class="card__meta-text"><%= card.creator.familiar_name %></span>
+  </footer>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
