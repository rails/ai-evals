index 0000000..da9ae55
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,159 @@
+class ZipFile::Reader
+  DEFAULT_CHUNK_SIZE = 512.kilobytes
+
+  attr_reader :io, :entries
+
+  def initialize(source, owned_io: nil)
+    case source
+    when String
+      @io = File.open(source, "rb")
+      @owned_io = true
+    when Pathname
+      @io = source.open("rb")
+      @owned_io = true
+    else
+      @io = source
+      @owned_io = owned_io
+    end
+
+    @entries = ZipKit::FileReader.read_zip_structure(io: @io)
+    @entries_by_name = @entries.index_by(&:filename)
+  end
+
+  def read(name)
+    entry = find_entry(name) or raise Errno::ENOENT, "No such entry in zip file: #{name}"
+
+    extractor = entry.extractor_from(@io)
+
+    if block_given?
+      until extractor.eof?
+        chunk = extractor.extract(DEFAULT_CHUNK_SIZE)
+        break if chunk.blank?
+
+        yield chunk
+      end
+      nil
+    else
+      data = +""
+      until extractor.eof?
+        chunk = extractor.extract(DEFAULT_CHUNK_SIZE)
+        data << chunk if chunk.present?
+      end
+      data
+    end
+  end
+  alias_method :entry, :read
+  alias_method :file, :read
+  alias_method :read_all, :read
+  alias_method :extract, :read
+
+  def open(name)
+    entry = find_entry(name) or raise Errno::ENOENT, "No such entry in zip file: #{name}"
+
+    extractor = entry.extractor_from(@io)
+    if block_given?
+      yield ZipFile::Reader::ExtractorIO.new(extractor, name)
+    else
+      ZipFile::Reader::ExtractorIO.new(extractor, name)
+    end
+  end
+
+  def each
+    return enum_for(:each) unless block_given?
+
+    @entries.each do |entry|
+      yield entry.filename, read(entry.filename)
+    end
+
+    self
+  end
+  alias_method :each_file, :each
+  alias_method :each_entry, :each
+
+  def glob(pattern)
+    @entries.map(&:filename).select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(name)
+    @entries_by_name.key?(normalize(name))
+  end
+  alias_method :include?, :exists?
+  alias_method :key?, :exists?
+
+  def names
+    @entries.map(&:filename)
+  end
+  alias_method :entry_names, :names
+  alias_method :filenames, :names
+
+  def size
+    @entries.size
+  end
+  alias_method :length, :size
+  alias_method :count, :size
+
+  def close
+    @io.close if @owned_io && @io.respond_to?(:close)
+  end
+
+  def self.open(source, **options)
+    reader = new(source, **options)
+
+    if block_given?
+      begin
+        yield reader
+      ensure
+        reader.close
+      end
+    else
+      reader
+    end
+  end
+
+  private
+    def normalize(name)
+      name.to_s.delete_prefix("./")
+    end
+
+    def find_entry(name)
+      @entries_by_name[normalize(name)] || @entries_by_name[name.to_s]
+    end
+end
+
+class ZipFile::Reader::ExtractorIO
+  def initialize(extractor, name)
+    @extractor = extractor
+    @name = name
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      data = +""
+      until eof?
+        chunk = @extractor.extract(ZipFile::Reader::DEFAULT_CHUNK_SIZE)
+        data << chunk if chunk
+      end
+    else
+      data = @extractor.extract(length).to_s
+    end
+
+    if outbuf
+      outbuf.replace(data)
+      outbuf
+    else
+      data
+    end
+  end
