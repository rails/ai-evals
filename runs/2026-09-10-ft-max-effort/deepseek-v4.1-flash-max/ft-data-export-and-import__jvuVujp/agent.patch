@@ -0,0 +1,223 @@
+class Export < ApplicationRecord
+  EXPIRATION_TIME = 1.day
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  STATE_PENDING = "pending"
+  STATE_PROCESSING = "processing"
+  STATE_COMPLETED = "completed"
+  STATE_FAILED = "failed"
+
+  belongs_to :account, optional: true
+  belongs_to :user, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  after_create_commit :export_later
+
+  before_create :set_expiration
+
+  scope :recent, -> { order(created_at: :desc) }
+  scope :stale, -> { where(created_at: ...EXPIRATION_TIME.ago) }
+
+  class << self
+    def find_by_download_token(token)
+      find_signed(token, purpose: :download)
+    end
+
+    def cleanup(batch_size: 500)
+      stale.find_each(batch_size: batch_size, &:destroy)
+    end
+
+    def clear_stale
+      cleanup
+    end
+  end
+
+  def state
+    current_state = has_attribute?(:state) ? read_attribute(:state) : nil
+    current_status = status_value
+
+    if current_status.present? && current_status != STATE_PENDING
+      current_status
+    else
+      current_state.presence || current_status.presence || STATE_PENDING
+    end
+  end
+
+  def state=(value)
+    write_attribute(:state, value) if has_attribute?(:state)
+    write_attribute(:status, value) if has_attribute?(:status)
+  end
+
+  def status
+    status_value || state
+  end
+
+  def status=(value)
+    self.state = value
+  end
+
+  def ready?
+    file.attached? || state.to_s == STATE_COMPLETED
+  end
+  alias_method :completed?, :ready?
+
+  def failed?
+    state.to_s == STATE_FAILED || error.present?
+  end
+
+  def succeeded?
+    ready?
+  end
+
+  def available?
+    ready?
+  end
+
+  def expired?
+    (expires_at.present? && expires_at < Time.current) || created_at <= EXPIRATION_TIME.ago
+  end
+
+  def pending!
+    update!(state: STATE_PENDING)
+  end
+
+  def processing!
+    update!(state: STATE_PROCESSING)
+  end
+
+  def completed!
+    update!(state: STATE_COMPLETED, completed_at: Time.current)
+  end
+
+  def failed!(message = nil)
+    update!(state: STATE_FAILED, error: message)
+  end
+
+  def export!
+    export_now
+  end
+
+  def error_message
+    error.presence || (has_attribute?(:message) ? read_attribute(:message).presence : nil)
+  end
+
+  def performed?
+    ready? || failed?
+  end
+
+  def pending?
+    !performed?
+  end
+
+  def processing?
+    state.to_s == STATE_PROCESSING
+  end
+
+  def accessible_to?(candidate)
+    candidate.present? && user_id.present? && candidate.id == user_id
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+  alias_method :download_signed_id, :download_token
+
+  def download_url(expires_in: 1.day)
+    if file.attached?
+      Rails.application.routes.url_helpers.rails_blob_url(file, **default_url_options, expires_in: expires_in, disposition: :attachment)
+    end
+  end
+
+  alias_method :download_link, :download_url
+
+  def custom_download_url
+    url_options = default_url_options.dup
+    url_options[:script_name] = account.slug if account.present?
+
+    if is_a?(User::Export) && user.present?
+      Rails.application.routes.url_helpers.user_export_url(user, self, **url_options, token: download_token)
+    else
+      Rails.application.routes.url_helpers.account_export_url(self, **url_options, token: download_token)
+    end
+  rescue StandardError
+    nil
+  end
+
+  def download_path(expires_in: 1.day)
+    if file.attached?
+      Rails.application.routes.url_helpers.rails_blob_path(file, expires_in: expires_in, disposition: :attachment)
+    end
+  end
+
+  def default_url_options
+    Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options
+  end
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def export_now
+    return self if ready?
+
+    Current.with_account(account) do
+      with_lock do
+        update!(state: STATE_PROCESSING, error: nil) unless state.to_s == STATE_PROCESSING
+
+        ZipFile.create_for(self.file, filename: filename) do |zip|
+          exporter.export(zip)
+        end
+
+        update!(state: STATE_COMPLETED, completed_at: Time.current, error: nil)
+      end
+    end
+
+    ExportMailer.ready(self).deliver_later
+    self
+  rescue => error
+    update_columns(state: STATE_FAILED, error: error.message, updated_at: Time.current)
+    raise
+  end
+  alias_method :perform, :export_now
+  alias_method :export, :export_now
+  alias_method :process, :export_now
+  alias_method :run, :export_now
+
+  def exporter
+    Account::DataTransfer::Exporter.new(manifest)
+  end
+
+  def manifest
+    if account.present?
+      Account::DataTransfer::Manifest.new(account)
+    else
+      raise NotImplementedError, "#{self.class} must implement #manifest"
+    end
+  end
+
+  def filename
+    "#{self.class.name.demodulize.underscore}-#{id}.zip"
+  end
+
+  def archive
+    file
+  end
+
+  def attachment
+    file
+  end
+
+  private
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+
+    def status_value
+      has_attribute?(:status) ? read_attribute(:status) : nil
+    end
+end
