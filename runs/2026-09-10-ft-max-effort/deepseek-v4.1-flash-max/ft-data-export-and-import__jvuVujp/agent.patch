@@ -0,0 +1,73 @@
+class Users::ExportsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user, only: :create
+
+  def create
+    @export = @user.exports.create!(account: @user.account, type: "User::Export")
+
+    respond_to do |format|
+      format.html { redirect_to @user, notice: "Your card export is being prepared. We'll email you when it's ready." }
+      format.json { head :created }
+    end
+  end
+
+  def show
+    @export = @user.exports.find(params[:id]) unless download_token_export.present?
+
+    if download_token_export.present?
+      send_download(download_token_export)
+    elsif @export.accessible_to?(Current.user)
+      redirect_to_export(@export)
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def require_authentication
+      if download_token_export.present?
+        true
+      else
+        super
+      end
+    end
+
+    def download_token_export
+      @download_token_export ||= begin
+        if params[:token].present?
+          export = User::Export.find_by_download_token(params[:token])
+          user = Current.account.users.active.find_by(id: params[:user_id])
+          export if export&.account_id == Current.account.id && export.user_id == user&.id
+        end
+      rescue StandardError
+        nil
+      end
+    end
+
+    def redirect_to_export(export)
+      if export.ready? && export.download_url
+        redirect_to export.download_url, allow_other_host: true
+      else
+        render "users/exports/show"
+      end
+    end
+
+    def send_download(export)
+      if export.ready? && export.file.attached?
+        send_data export.file.download,
+          filename: export.file.filename.to_s,
+          type: export.file.content_type,
+          disposition: "attachment"
+      else
+        render "users/exports/show"
+      end
+    end
+end
