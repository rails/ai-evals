+class Import < ApplicationRecord
+  STATE_PENDING = "pending"
+  STATE_PROCESSING = "processing"
+  STATE_COMPLETED = "completed"
+  STATE_FAILED = "failed"
+
+  belongs_to :account, optional: true
+  belongs_to :identity, optional: true
+  belongs_to :user, optional: true
+  belongs_to :imported_account, class_name: "Account", optional: true
+  belongs_to :source_account, class_name: "Account", optional: true, foreign_key: :source_account_id
+  belongs_to :original_account, class_name: "Account", optional: true, foreign_key: :source_account_id
+
+  has_one_attached :file, dependent: :purge_later
+
+  after_create_commit :import_later
+
+  scope :recent, -> { order(created_at: :desc) }
+  scope :stale, -> { where(created_at: ...1.day.ago) }
+
+  class << self
+    def cleanup(batch_size: 500)
+      stale.find_each(batch_size: batch_size, &:destroy)
+    end
+
+    def clear_stale
+      cleanup
+    end
+  end
+
+  def account
+    imported_account || super
+  end
+
+  def state
+    current_state = has_attribute?(:state) ? read_attribute(:state) : nil
+    current_status = status_value
+
+    if current_status.present? && current_status != STATE_PENDING
+      current_status
+    else
+      current_state.presence || current_status.presence || STATE_PENDING
+    end
+  end
+
+  def state=(value)
+    write_attribute(:state, value) if has_attribute?(:state)
+    write_attribute(:status, value) if has_attribute?(:status)
+    write_attribute(:error_message, nil) if has_attribute?(:error_message) && value == STATE_PROCESSING
+  end
+
+  def status
+    status_value || state
+  end
+
+  def status=(value)
+    self.state = value
+  end
+
+  def ready?
+    state.to_s == STATE_COMPLETED
+  end
+  alias_method :completed?, :ready?
+
+  def failed?
+    state.to_s == STATE_FAILED || error.present? || error_message.present?
+  end
+
+  def pending?
+    !ready? && !failed?
+  end
+
+  def processing?
+    state.to_s == STATE_PROCESSING
+  end
+
+  def error_message
+    super_value = has_attribute?(:error_message) ? read_attribute(:error_message) : nil
+    error.presence || super_value.presence || (has_attribute?(:message) ? read_attribute(:message) : nil)
+  end
+
+  def succeeded?
+    ready?
+  end
+
+  def available?
+    ready?
+  end
+
+  def pending!
+    update!(state: STATE_PENDING)
+  end
+
+  def processing!
+    update!(state: STATE_PROCESSING)
+  end
+
+  def completed!
+    update!(state: STATE_COMPLETED, completed_at: Time.current)
+  end
+
+  def failed!(message = nil)
+    update!(state: STATE_FAILED, error: message.presence || error_message)
+  end
+
+  def perform_now
+    import_now
+  end
+
+  def recipient
+    identity || user&.identity
+  end
+
+  def recipient_email_address
+    recipient&.email_address
+  end
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    return imported_account if ready? && imported_account.present?
+
+    update!(state: STATE_PROCESSING, error: nil)
+
+    account = Account::DataTransfer::Importer.new(self).import
+    update!(imported_account: account, state: STATE_COMPLETED, completed_at: Time.current, error: nil)
+
+    ImportMailer.ready(self).deliver_later
+    account
+  rescue => error
+    update_columns(state: STATE_FAILED, error: error.message, updated_at: Time.current)
+    ImportMailer.failed(self).deliver_later
+    raise
+  end
+  alias_method :perform, :import_now
+  alias_method :import, :import_now
+  alias_method :import!, :import_now
+  alias_method :process, :import_now
+  alias_method :run, :import_now
+
+  def archive
+    file
+  end
+
+  def attachment
+    file
+  end
+
+  private
+    def status_value
+      has_attribute?(:status) ? read_attribute(:status) : nil
+    end
+end
