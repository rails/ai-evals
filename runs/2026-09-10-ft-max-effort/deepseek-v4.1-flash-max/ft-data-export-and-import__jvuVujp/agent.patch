+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @download_url = export.download_url
+    @custom_download_url = export.custom_download_url
+
+    mail to: export.user&.identity&.email_address,
+      subject: "Your Fizzy export is ready",
+      template_name: "export_ready"
+  end
+
+  def export_failed(export, error = nil)
+    @export = export
+    @error = error || export.error
+
+    mail to: export.user&.identity&.email_address,
+      subject: "Your Fizzy export failed",
+      template_name: "export_failed"
+  end
+
+  def import_ready(import)
+    @import = import
+    @account = import.imported_account
+
+    mail to: import.recipient_email_address,
+      subject: "Your Fizzy account is ready",
+      template_name: "import_ready"
+  end
+
+  def import_completed(import)
+    @import = import
+    @account = import.imported_account
+
+    mail to: import.recipient_email_address,
+      subject: "Your Fizzy account is ready",
+      template_name: "import_ready"
+  end
+
+  def export_completed(export)
+    export_ready(export)
+  end
+
+  def import_succeeded(import)
+    import_completed(import)
+  end
+
+  def import_failed(import, error = nil)
+    @import = import
+    @error = error || import.error_message
+
+    mail to: import.recipient_email_address,
+      subject: "Your Fizzy import failed",
+      template_name: "import_failed"
+  end
+end
