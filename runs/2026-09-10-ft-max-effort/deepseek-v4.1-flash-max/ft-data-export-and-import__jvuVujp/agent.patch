+require "test_helper"
+
+class ExportImportControllersTest < ActionDispatch::IntegrationTest
+  test "admin can request an account export" do
+    sign_in_as :kevin
+
+    assert_difference -> { Account::Export.count }, 1 do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+    assert Account::Export.last.ready? == false
+  end
+
+  test "non-admin cannot request an account export" do
+    sign_in_as :david
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "user can request an export of their cards" do
+    sign_in_as :david
+
+    assert_difference -> { User::Export.count }, 1 do
+      post user_exports_path(users(:david))
+    end
+
+    assert_redirected_to user_path(users(:david))
+  end
+
+  test "new import page" do
+    sign_in_as :david
+    get new_account_import_path
+    assert_response :success
+  end
+
+  test "create import with an uploaded archive" do
+    sign_in_as :david
+
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("accounts/none.json", { id: "none" }.to_json)
+    writer.close
+    tempfile.rewind
+
+    assert_difference -> { Account::Import.count }, 1 do
+      post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(tempfile.path, "application/zip") } }
+    end
+
+    assert_redirected_to account_settings_path
+    assert Account::Import.last.file.attached?
+  ensure
+    tempfile&.close
+  end
+end
+
+class ExportImportControllersTest
+  test "public signed download link works without authentication" do
+    export = Current.set(account: accounts(:"37s"), session: sessions(:david)) do
+      Account::Export.create!(account: accounts(:"37s"), user: users(:david))
+    end
+    export.file.attach(io: StringIO.new("zip data"), filename: "export.zip", content_type: "application/zip")
+
+    sign_out if respond_to?(:sign_out)
+    get account_export_path(export, token: export.download_token)
+    assert_response :success
+    assert_equal "zip data", response.body
+  ensure
+    export&.file&.purge
+  end
+end
+
+class ExportImportControllersTest
+  test "public signed card download link works without authentication" do
+    user = users(:david)
+    export = Current.set(account: accounts(:"37s"), session: sessions(:david)) do
+      User::Export.create!(account: accounts(:"37s"), user: user)
+    end
+    export.file.attach(io: StringIO.new("cards zip"), filename: "cards.zip", content_type: "application/zip")
+
+    get user_export_path(user, export, token: export.download_token)
+    assert_response :success
+    assert_equal "cards zip", response.body
+  ensure
+    export&.file&.purge
+  end
+end
diff --git a/test/export_import_feature_test.rb b/test/export_import_feature_test.rb
new file mode 100644
index 0000000..499226a
--- /dev/null
+++ b/test/export_import_feature_test.rb
@@ -0,0 +1,306 @@
+require "test_helper"
+
+class ExportImportFeatureTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  def export_account_to_tempfile(account = @account)
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Current.set(account: account, session: sessions(:david)) do
+      Account::DataTransfer::Exporter.new(account).export(writer)
+    end
+    writer.close
+    tempfile.rewind
+    tempfile
+  end
+
+  test "exports account records to zip" do
+    tempfile = export_account_to_tempfile
+
+    reader = ZipFile::Reader.new(tempfile)
+    assert reader.exists?("accounts/#{@account.id}.json")
+    assert reader.exists?("users/#{@user.id}.json")
+    assert reader.exists?("cards/#{cards(:logo).id}.json")
+
+    user_json = JSON.parse(reader.read("users/#{@user.id}.json"))
+    assert_equal "david@37signals.com", user_json["email_address"]
+  ensure
+    tempfile&.close
+  end
+
+  test "imports an exported account into a new account" do
+    tempfile = export_account_to_tempfile
+
+    imported_account = nil
+    assert_difference -> { Account.count }, 1 do
+      imported_account = Account::DataTransfer::Importer.new(tempfile, creator: @user).import
+    end
+
+    assert_not_equal @account.id, imported_account.id
+    assert_equal @account.name, imported_account.name
+    assert_equal Board.where(account_id: @account.id).count, Board.where(account_id: imported_account.id).count
+    assert_equal Card.where(account_id: @account.id).count, Card.where(account_id: imported_account.id).count
+    assert_equal Card.where(account_id: @account.id).order(:number).pluck(:title), Card.where(account_id: imported_account.id).order(:number).pluck(:title)
+
+    imported_user = User.find_by(account_id: imported_account.id, name: "David")
+    assert imported_user.present?
+    assert_equal "david@37signals.com", imported_user.identity.email_address
+
+    source_card = cards(:logo)
+    imported_card = Card.find_by(account_id: imported_account.id, title: source_card.title)
+    assert_equal imported_account.id, imported_card.board.account_id
+    assert_equal imported_account.id, imported_card.creator.account_id
+    assert_not_equal source_card.id, imported_card.id
+
+    source_comment = source_card.comments.first
+    imported_comment = Comment.find_by(account_id: imported_account.id, card_id: imported_card.id)
+    assert_equal source_comment.creator.name, imported_comment.creator.name
+    assert_equal imported_card.id, imported_comment.card_id
+  ensure
+    tempfile&.close
+  end
+
+  test "imports card images and blobs" do
+    source_card = cards(:logo)
+    Current.set(account: @account, session: sessions(:david)) do
+      source_card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+    source_blob = source_card.image.blob
+    source_content = source_blob.download
+
+    tempfile = export_account_to_tempfile
+    reader = ZipFile::Reader.new(tempfile)
+    assert reader.exists?("files/#{source_blob.key}")
+
+    imported_account = Account::DataTransfer::Importer.new(tempfile, creator: @user).import
+    imported_card = Card.find_by(account_id: imported_account.id, title: source_card.title)
+
+    assert imported_card.image.attached?
+    assert_equal source_blob.filename.to_s, imported_card.image.blob.filename.to_s
+    assert_equal source_content, imported_card.image.blob.download
+    assert_not_equal source_blob.key, imported_card.image.blob.key
+  ensure
+    tempfile&.close
+  end
+
+  test "imports rich text embeds and remaps active storage links" do
+    source_comment = comments(:logo_agreement_jz)
+    source_blob = nil
+
+    Current.set(account: @account, session: sessions(:david)) do
+      source_blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "embed.jpg",
+        content_type: "image/jpeg"
+      )
+      attachment_html = ActionText::Attachment.from_attachable(source_blob).to_html
+      source_comment.update!(body: "<p>Hello #{attachment_html}</p>")
+    end
+    source_comment.reload
+
+    tempfile = export_account_to_tempfile
+    imported_account = Account::DataTransfer::Importer.new(tempfile, creator: @user).import
+    imported_card = Card.find_by(account_id: imported_account.id, title: source_comment.card.title)
+    imported_creator = User.find_by(account_id: imported_account.id, name: source_comment.creator.name)
+    imported_comment = Comment.find_by(account_id: imported_account.id, card_id: imported_card.id, creator_id: imported_creator.id)
+
+    assert imported_comment.present?
+    refute_includes imported_comment.body.to_s, source_blob.signed_id
+    assert_match %r{/rails/active_storage/}, imported_comment.body.to_s
+  ensure
+    tempfile&.close
+  end
+
+  test "export model builds an archive and sends a notification email" do
+    export = nil
+
+    Current.set(account: @account, session: sessions(:david)) do
+      export = Account::Export.create!(account: @account, user: @user)
+    end
+
+    perform_enqueued_jobs { ExportJob.perform_now(export) }
+    export.reload
+
+    assert export.ready?
+    assert export.file.attached?
+    assert export.completed_at.present?
+    assert ActionMailer::Base.deliveries.any?
+    assert_match %r{/account/exports/}, ActionMailer::Base.deliveries.last.body.encoded
+  end
+
+  test "import model reads an attached archive and sends a notification email" do
+    export_file = export_account_to_tempfile
+    import = nil
+
+    Current.set(account: @account, session: sessions(:david)) do
+      import = Account::Import.create!(
+        account: @account,
+        identity: identities(:david),
+        user: @user,
+        source_account_id: @account.id
+      )
+      import.file.attach(io: export_file.tap(&:rewind), filename: "export.zip", content_type: "application/zip")
+    end
+
+    perform_enqueued_jobs { ImportJob.perform_now(import) }
+    import.reload
+
+    assert import.ready?
+    assert import.imported_account.present?
+    assert_equal @account.name, import.imported_account.name
+    assert ActionMailer::Base.deliveries.any?
+  ensure
+    export_file&.close
+  end
+end
+
+class ExportImportFeatureTest
+  test "failed imports leave nothing behind" do
+    account_count = Account.count
+    board_count = Board.count
+    card_count = Card.count
+    user_count = User.count
+
+    import = Current.set(account: @account, session: sessions(:david)) do
+      Account::Import.create!(
+        account: @account,
+        identity: identities(:david),
+        user: @user,
+        file: { io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip" }
+      )
+    end
+
+    assert_raises ZipKit::FileReader::ReadError, ActiveSupport::MessageVerifier::InvalidSignature, StandardError do
+      import.import_now
+    end
+
+    assert_equal account_count, Account.count
+    assert_equal board_count, Board.count
+    assert_equal card_count, Card.count
+    assert_equal user_count, User.count
+    assert import.reload.failed?
+    assert import.error.present?
+  ensure
+    import&.file&.purge
+  end
+end
+
+class ExportImportFeatureTest
+  test "user export includes only cards the user can see" do
+    export = Current.set(account: @account, session: sessions(:david)) do
+      User::Export.create!(account: @account, user: @user)
+    end
+
+    tempfile = Tempfile.new([ "user-export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    Current.set(account: @account, session: sessions(:david)) do
+      Account::DataTransfer::Exporter.new(export).export(writer)
+    end
+    writer.close
+    tempfile.rewind
+    reader = ZipFile::Reader.new(tempfile)
+
+    visible_card_ids = Card.accessible_by(@user).pluck(:id)
+
+    visible_card_ids.each do |card_id|
+      assert reader.exists?("cards/#{card_id}.json")
+    end
+
+    hidden_card_id = nil
+    Current.set(account: @account, session: sessions(:kevin)) do
+      hidden_card_id = boards(:private).cards.create!(title: "Hidden from David", creator: users(:kevin)).id
+    end
+
+    assert_not Card.accessible_by(@user).exists?(hidden_card_id)
+    assert_not reader.exists?("cards/#{hidden_card_id}.json")
+  ensure
+    tempfile&.close
+    export&.file&.purge
+  end
+end
+
+class ExportImportFeatureTest
+  test "imports every record type in the account manifest" do
+    tempfile = export_account_to_tempfile
+    imported_account = Account::DataTransfer::Importer.new(tempfile, creator: @user).import
+
+    Account::DataTransfer::Manifest.new(@account).record_sets.each do |record_set|
+      model = record_set.model
+      next if model == Account || model == User
+
+      if model.column_names.include?("account_id")
+        source_count = model.where(account_id: @account.id).count
+        imported_count = model.where(account_id: imported_account.id).count
+        assert_equal source_count, imported_count, "expected #{model.name} records to be imported"
+      end
+    end
+  ensure
+    tempfile&.close
+  end
+end
+
+class ExportImportFeatureTest
+  test "round trips all account data including associations" do
+    source_account = @account
+    source_board = nil
+    source_card = nil
+
+    Current.set(account: source_account, session: sessions(:david)) do
+      source_board = Board.create!(name: "Roundtrip board", creator: @user, all_access: true)
+      source_card = source_board.cards.create!(title: "Roundtrip card", creator: @user, status: :published)
+
+      tag = Tag.create!(title: "urgent #{SecureRandom.hex(4)}")
+      Column.create!(board: source_board, name: "Imported test column", position: 99)
+      Board::Publication.create!(board: source_board)
+      webhook = Webhook.create!(board: source_board, name: "Test webhook", url: "https://example.com/hook")
+      event = Event.create!(board: source_board, creator: @user, eventable: source_card, action: "card_published")
+      Webhook::Delivery.create!(webhook: webhook, event: event)
+
+      comment = source_card.comments.create!(body: "Round trip comment", creator: @user)
+      Step.create!(card: source_card, content: "Round trip step")
+      Assignment.create!(card: source_card, assignee: users(:jz), assigner: @user)
+      Tagging.create!(card: source_card, tag: tag)
+      Watch.create!(card: source_card, user: users(:jz))
+      Pin.create!(card: source_card, user: users(:jz))
+      Reaction.create!(reactable: source_card, content: "thumbs_up", reacter: @user)
+      Mention.create!(source: comment, mentioner: @user, mentionee: users(:jz))
+      Closure.create!(card: source_card, user: @user)
+      Card::Goldness.create!(card: source_card)
+      Card::NotNow.create!(card: source_card, user: @user)
+      Card::ActivitySpike.create!(card: source_card)
+      Notification.create!(user: users(:jz), source: event, creator: @user)
+      Notification::Bundle.create!(user: users(:jz), starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+      Filter.create!(creator: @user, fields: { indexed_by: :all, sorted_by: :newest }.to_json, params_digest: SecureRandom.hex)
+      source_card.image.attach(io: file_fixture("moon.jpg").open, filename: "roundtrip.jpg", content_type: "image/jpeg")
+    end
+
+    tempfile = export_account_to_tempfile
+    imported_account = Account::DataTransfer::Importer.new(tempfile, creator: @user).import
+    imported_card = Card.find_by(account_id: imported_account.id, title: source_card.title)
+
+    assert imported_card.present?
+    assert imported_card.image.attached?
+    assert_equal "roundtrip.jpg", imported_card.image.blob.filename.to_s
+    assert_not_equal source_card.id, imported_card.id
+
+    {
+      Board::Publication => source_board, Webhook => source_board,
+      Event => source_board, Comment => imported_card, Step => imported_card,
+      Tagging => imported_card, Watch => imported_card, Pin => imported_card,
+      Reaction => imported_card, Closure => imported_card, Card::Goldness => imported_card,
+      Card::NotNow => imported_card, Card::ActivitySpike => imported_card,
+      Notification => users(:jz), Notification::Bundle => users(:jz)
+    }.each do |model, source|
+      source_count = model.where(account_id: source_account.id).count
+      imported_count = model.where(account_id: imported_account.id).count
+      assert_equal source_count, imported_count, "#{model.name} count mismatch"
+    end
+  ensure
+    tempfile&.close
+  end
+end
