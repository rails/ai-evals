diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..200b06e
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,23 @@
+class ActivitiesController < ApplicationController
+  def index
+    @events = Current.user.accessible_events
+      .preloaded
+      .includes(creator: :identity)
+      .where(action: Event::ACTIVITY_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+
+    @events = @events.where(creator_id: creator_ids) if creator_ids.any?
+    @events = @events.where(board_id: board_ids) if board_ids.any?
+
+    set_page_and_extract_portion_from @events
+  end
+
+  private
+    def creator_ids
+      @creator_ids ||= Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      @board_ids ||= Array(params[:board_ids]).compact_blank
+    end
+end
