diff --git a/test/controllers/activities_api_test.rb b/test/controllers/activities_api_test.rb
new file mode 100644
index 0000000..f360ff9
--- /dev/null
+++ b/test/controllers/activities_api_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class ActivitiesApiTest < ActionDispatch::IntegrationTest
+  setup { sign_in_as :kevin }
+
+  test "returns activity as a flat array with API representations" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    event = events(:logo_assignment_jz)
+    item = @response.parsed_body.find { |e| e["id"] == event.id }
+
+    assert_equal "card_assigned", item["action"]
+    assert_equal event.created_at.utc.iso8601(3), item["created_at"]
+    assert_equal "David assigned JZ to &quot;The logo isn&#39;t big enough&quot;", item["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, item["particulars"])
+    assert_equal card_url(cards(:logo)), item["url"]
+    assert_equal "Card", item["eventable_type"]
+    assert_equal cards(:logo).id, item.dig("eventable", "id")
+    assert_equal boards(:writebook).id, item.dig("board", "id")
+    assert_equal users(:david).id, item.dig("creator", "id")
+  end
+
+  test "comment activity url points to the card and comment" do
+    get activities_path(format: :json)
+
+    comment = comments(:layout_overflowing_david)
+    item = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+
+    assert_equal "comment_created", item["action"]
+    assert_equal "Comment", item["eventable_type"]
+    assert_equal comment.id, item.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), item["url"]
+  end
+
+  test "filters by creator and board and enforces access" do
+    get activities_path(format: :json, creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |event| event.dig("creator", "id") == users(:david).id }
+    assert @response.parsed_body.all? { |event| event.dig("board", "id") == boards(:writebook).id }
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "omits card_collection_changed and includes card_title_changed" do
+    title_event = events(:logo_published)
+    title_event.update_columns action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+    collection_event = events(:layout_published)
+    collection_event.update_columns action: "card_collection_changed", particulars: { "particulars" => { "new_collection" => "New Collection" } }
+
+    get activities_path(format: :json)
+
+    item = @response.parsed_body.find { |e| e["id"] == title_event.id }
+    assert_equal "card_title_changed", item["action"]
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, item["particulars"])
+    assert_not @response.parsed_body.any? { |e| e["id"] == collection_event.id }
+  end
+
+  test "returns empty strings for missing board, title and column details" do
+    board_event = events(:logo_published)
+    board_event.update_columns action: "card_board_changed", particulars: {}
+    title_event = events(:layout_published)
+    title_event.update_columns action: "card_title_changed", particulars: {}
+    triage_event = events(:text_published)
+    triage_event.update_columns action: "card_triaged", particulars: {}
+
+    get activities_path(format: :json)
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, @response.parsed_body.find { |e| e["id"] == board_event.id }["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, @response.parsed_body.find { |e| e["id"] == title_event.id }["particulars"])
+    assert_equal({ "column" => "" }, @response.parsed_body.find { |e| e["id"] == triage_event.id }["particulars"])
+    assert_equal({ "column" => "" }, @response.parsed_body.find { |e| e["id"] == events(:buy_domain_sent_back_to_triage).id }["particulars"])
+  end
+
+  test "paginates activity through Link headers newest first" do
+    board = boards(:writebook)
+    30.times do |index|
+      Event.create!(account: board.account, board: board, creator: users(:kevin), eventable: cards(:logo), action: "card_published", created_at: (index + 1).hours.ago)
+    end
+
+    expected_ids = users(:kevin).accessible_events.where(action: Event::ACTIVITY_ACTIONS).order(created_at: :desc, id: :desc).pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = @response.headers["Link"]&.match(/<([^>]+)>; rel="next"/)&.captures&.first
+    end
+
+    assert_equal expected_ids, actual_ids
+  end
+end
