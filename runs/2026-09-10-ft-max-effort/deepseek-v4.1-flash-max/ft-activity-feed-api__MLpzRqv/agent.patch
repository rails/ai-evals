--- a/app/models/event.rb
+++ b/app/models/event.rb
@@ -1,6 +1,23 @@
 class Event < ApplicationRecord
   include Notifiable, Particulars, Promptable
 
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_collection_changed
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+  ].freeze
+
+  ACTIVITY_ACTIONS = (TIMELINEABLE_ACTIONS - %w[card_collection_changed] + %w[card_title_changed]).freeze
+
   belongs_to :account, default: -> { board.account }
   belongs_to :board
   belongs_to :creator, class_name: "User"
@@ -37,7 +54,29 @@ class Event < ApplicationRecord
     Event::Description.new(self, user)
   end
 
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(activity_particular("assignee_ids")) }
+    when "card_board_changed"
+      { old_board: activity_particular("old_board").to_s, new_board: activity_particular("new_board").to_s }
+    when "card_title_changed"
+      { old_title: activity_particular("old_title").to_s, new_title: activity_particular("new_title").to_s }
+    when "card_triaged", "card_sent_back_to_triage"
+      { column: activity_particular("column").to_s }
+    else
+      {}
+    end
+  end
+
   private
+    def activity_particular(key)
+      data = particulars || {}
+      nested = data["particulars"]
+      details = nested.is_a?(Hash) ? data.merge(nested) : data
+      details[key] || details[key.to_sym]
+    end
+
     def dispatch_webhooks
       Event::WebhookDispatchJob.perform_later(self)
     end
