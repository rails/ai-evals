--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,12 @@
+module ActivitiesHelper
+  def activity_url(event)
+    case event.eventable
+    when Comment
+      card_url event.eventable.card, anchor: dom_id(event.eventable)
+    when Card
+      card_url event.eventable
+    else
+      polymorphic_url event.eventable
+    end
+  end
+end
