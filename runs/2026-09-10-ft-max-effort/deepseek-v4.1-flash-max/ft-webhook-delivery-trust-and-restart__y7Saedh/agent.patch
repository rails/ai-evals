@@ -0,0 +1,234 @@
+require "test_helper"
+
+class Webhook::DeliveryFlowTest < ActiveSupport::TestCase
+  test "creating an event creates a delivery for each active subscribed webhook and enqueues its job" do
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      assert_enqueued_with(job: Webhook::DeliveryJob) do
+        @event = boards(:writebook).events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo)
+        )
+      end
+    end
+
+    delivery = Webhook::Delivery.last
+    assert_equal webhooks(:active), delivery.webhook
+    assert_equal @event, delivery.event
+    assert delivery.pending?
+  end
+
+  test "creating an event does not create deliveries for unsubscribed or inactive webhooks" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      boards(:writebook).events.create!(
+        action: "card_reopened",
+        creator: users(:david),
+        eventable: cards(:logo)
+      )
+
+      boards(:private).events.create!(
+        action: "card_published",
+        creator: users(:david),
+        eventable: cards(:logo)
+      )
+    end
+  end
+
+  test "Event.suppress prevents webhook deliveries" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      Event.suppress do
+        boards(:writebook).events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo)
+        )
+      end
+    end
+  end
+
+  test "delivering posts once and logs the request and response" do
+    delivery = webhook_deliveries(:pending)
+    captured_request = nil
+
+    stub_request(:post, delivery.webhook.url).to_return do |request|
+      captured_request = request
+      { status: 200, headers: { "Content-Type" => "application/json" }, body: "{}" }
+    end
+
+    delivery.deliver
+
+    assert delivery.reload.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request[:headers]["User-Agent"]
+    assert_equal "application/json", delivery.request[:headers]["Content-Type"]
+    assert_equal delivery.event.created_at.utc.iso8601, delivery.request[:headers]["X-Webhook-Timestamp"]
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, delivery.payload), delivery.request[:headers]["X-Webhook-Signature"]
+
+    assert_includes captured_request.body, delivery.event.id
+    assert_equal delivery.payload, captured_request.body
+
+    delivery.deliver
+    assert_requested :post, delivery.webhook.url, times: 1
+  end
+
+  test "network failures are logged as errored and track a failure" do
+    delivery = webhook_deliveries(:pending)
+
+    stub_request(:post, delivery.webhook.url).to_raise(SocketError.new("getaddrinfo: Name or service not known"))
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response[:error]
+
+    tracker = delivery.webhook.reload.delinquency_tracker
+    assert_equal 1, tracker.consecutive_failures_count
+    assert_not_nil tracker.first_failure_at
+  end
+
+  test "non-2xx responses are logged as completed but count as failures" do
+    delivery = webhook_deliveries(:pending)
+
+    stub_request(:post, delivery.webhook.url).to_return(status: 422)
+
+    delivery.deliver
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 422, delivery.response[:code]
+
+    assert_equal 1, delivery.webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "successful deliveries reset the failure count" do
+    webhook = Webhook.create!(board: boards(:writebook), name: "Reset me", url: "https://reset.example.com/hook", subscribed_actions: [ "card_published" ])
+    tracker = webhook.delinquency_tracker
+    3.times { tracker.record_failure }
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    webhook.deliveries.create!(event: events(:logo_published)).deliver
+
+    tracker.reload
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "a webhook is switched off after ten consecutive failures within an hour" do
+    webhook = Webhook.create!(board: boards(:writebook), name: "Fail whale", url: "https://fail.example.com/hook", subscribed_actions: [ "card_published" ])
+    tracker = webhook.delinquency_tracker
+
+    9.times { tracker.record_failure }
+    assert webhook.reload.active?
+
+    tracker.record_failure
+    assert_not webhook.reload.active?
+    assert_equal 10, tracker.reload.consecutive_failures_count
+  end
+
+  test "the failure window resets when failures are more than an hour apart" do
+    webhook = Webhook.create!(board: boards(:writebook), name: "Slow fail", url: "https://slow.example.com/hook", subscribed_actions: [ "card_published" ])
+    tracker = webhook.delinquency_tracker
+
+    tracker.record_failure
+
+    travel 61.minutes do
+      tracker.record_failure
+    end
+
+    tracker.reload
+    assert_equal 1, tracker.consecutive_failures_count
+    assert webhook.reload.active?
+  end
+
+  test "ten consecutive failing deliveries automatically deactivate the webhook" do
+    webhook = Webhook.create!(board: boards(:writebook), name: "Dead endpoint", url: "https://dead.example.com/hook", subscribed_actions: [ "card_published" ])
+    event = events(:logo_published)
+
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    10.times do
+      webhook.deliveries.create!(event: event).deliver
+    end
+
+    assert_not webhook.reload.active?
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    old_deliveries = [ webhook_deliveries(:successfully_completed), webhook_deliveries(:errored) ]
+    old_deliveries.each { |delivery| delivery.update_columns(created_at: 8.days.ago) }
+
+    recent_delivery = webhook_deliveries(:pending)
+
+    assert_difference -> { Webhook::Delivery.count }, -2 do
+      Webhook::Delivery.cleanup
+    end
+
+    old_deliveries.each { |delivery| assert_not Webhook::Delivery.exists?(delivery.id) }
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+
+  test "reactivating a webhook resets its delinquency tracker" do
+    webhook = Webhook.create!(board: boards(:writebook), name: "Bounce back", url: "https://bounce.example.com/hook", subscribed_actions: [ "card_published" ])
+    tracker = webhook.delinquency_tracker
+    10.times { tracker.record_failure }
+    assert_not webhook.reload.active?
+
+    webhook.activate
+
+    assert webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+  end
+  test "does not deliver to hosts that resolve to private addresses" do
+    stub_dns_resolution("192.168.1.1")
+
+    webhook = Webhook.create!(board: boards(:writebook), name: "Internal", url: "https://internal.example.com/hook", subscribed_actions: [ "card_published" ])
+    stub = stub_request(:post, webhook.url)
+
+    delivery = webhook.deliveries.create!(event: events(:logo_published))
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_not_requested stub
+  end
+
+  test "does not deliver directly to private literal addresses" do
+    webhook = Webhook.create!(board: boards(:writebook), name: "Metadata", url: "http://169.254.169.254/hook", subscribed_actions: [ "card_published" ])
+    stub = stub_request(:post, webhook.url)
+
+    delivery = webhook.deliveries.create!(event: events(:logo_published))
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_not_requested stub
+  end
+
+  test "pins the resolved public address when delivering" do
+    stub_dns_resolution("93.184.216.34")
+
+    webhook = Webhook.create!(board: boards(:writebook), name: "Public", url: "https://public.example.com/hook", subscribed_actions: [ "card_published" ])
+    stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    delivery = webhook.deliveries.create!(event: events(:logo_published))
+    delivery.deliver
+
+    assert delivery.reload.succeeded?
+  end
+  test "a rolled-back event neither logs nor enqueues a delivery" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        ActiveRecord::Base.transaction do
+          boards(:writebook).events.create!(
+            action: "card_published",
+            creator: users(:david),
+            eventable: cards(:logo)
+          )
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+end
