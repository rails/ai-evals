@@ -29,4 +91,117 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def perform_delivery
+      response =
+        begin
+          post_to_webhook
+        rescue => error
+          fail_with(error)
+          return
+        end
+
+      complete_with(response)
+    end
+
+    def post_to_webhook
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.ipaddr = resolved_endpoint_ip(uri.hostname)
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |name, value| request[name] = value }
+      request.body = payload
+
+      http.request(request)
+    end
+
+    def resolved_endpoint_ip(hostname)
+      if ipaddress = parse_ipaddress(hostname)
+        raise BlockedAddressError, "destination_unreachable" if SsrfProtection.blocked_address?(ipaddress)
+
+        ipaddress.to_s
+      elsif public_ip = SsrfProtection.resolve_public_ip(hostname)
+        public_ip
+      elsif SsrfProtection.send(:resolve_dns, hostname).any?
+        raise BlockedAddressError, "destination_unreachable"
+      end
+    rescue BlockedAddressError
+      raise
+    rescue StandardError
+      nil
+    end
+
+    def parse_ipaddress(hostname)
+      IPAddr.new(hostname)
+    rescue IPAddr::InvalidAddressError
+      nil
+    end
+
+    def complete_with(http_response)
+      update!(
+        state: :completed,
+        request: { headers: request_headers },
+        response: { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+      )
+
+      if succeeded?
+        webhook.record_success!
+      else
+        webhook.record_failure!
+      end
+    end
+
+    def fail_with(error)
+      update!(
+        state: :errored,
+        request: { headers: request_headers },
+        response: { error: error_message_for(error) }
+      )
+
+      webhook.record_failure!
+    end
+
+    def error_message_for(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        "timeout"
+      when SocketError, Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Resolv::ResolvError
+        "destination_unreachable"
+      when OpenSSL::SSL::SSLError
+        "ssl_error"
+      when BlockedAddressError
+        error.message
+      else
+        error.class.name
+      end
+    end
+
+    def webhook_timestamp
+      event.created_at.utc.iso8601
+    end
+
+    def plain_message
+      @plain_message ||= event.description_for(Current.user).to_plain_text
+    end
+
+    def html_message
+      @html_message ||= render_event(:html).strip
+    end
+
+    def event_json
+      render_event(:json)
+    end
+
+    def render_event(format, layout: false)
+      renderer.render(template: "webhooks/event", formats: [ format ], layout: layout, assigns: { event: event })
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: Current.account&.slug)
+    end
 end
diff --git a/test/models/webhook/delivery_flow_test.rb b/test/models/webhook/delivery_flow_test.rb
