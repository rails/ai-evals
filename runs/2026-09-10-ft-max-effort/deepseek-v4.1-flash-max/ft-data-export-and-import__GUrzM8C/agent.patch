+class ZipFile::Reader
+  attr_reader :entries
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: @io).index_by(&:filename)
+  end
+
+  def filenames
+    entries.keys
+  end
+
+  def exists?(path)
+    entries.key?(normalize(path))
+  end
+
+  def glob(pattern)
