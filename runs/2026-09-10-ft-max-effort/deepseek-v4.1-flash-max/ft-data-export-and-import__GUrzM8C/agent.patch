+require "test_helper"
+
+class ScopedExportSmokeTest < ActiveSupport::TestCase
+  test "cards export only includes cards the user can see" do
+    account = accounts("37s")
+    jz = users(:jz)
+    private_board = boards(:private)
+    private_card = Current.set(user: users(:kevin)) { private_board.cards.create!(title: "Private card", creator: users(:kevin), status: "published") }
+    visible_card = cards(:logo)
+
+    export = account.exports.create!(user: jz, identity: jz.identity, scope: "cards")
+    Account::DataTransfer::Exporter.new(export).export
+
+    ZipFile.read(export.file) do |reader|
+      assert reader.exists?("cards/#{visible_card.id}.json"), reader.filenames.grep(/cards/)
+      assert_not reader.exists?("cards/#{private_card.id}.json")
+      assert_not reader.exists?("boards/#{private_board.id}.json")
+    end
+  end
+end
