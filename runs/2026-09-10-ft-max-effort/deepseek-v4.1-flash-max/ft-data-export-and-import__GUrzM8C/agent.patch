new file mode 100644
index 0000000..75dfa13
--- /dev/null
+++ b/app/jobs/export_job.rb
@@ -0,0 +1,16 @@
+class ExportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(export)
+    export.update!(status: "processing")
+    Account::DataTransfer::Exporter.new(export).export
+    export.complete!
+    ExportMailer.completed(export).deliver_later
+  rescue => e
+    Rails.logger.error "Export #{export.id} failed: #{e.class}: #{e.message}"
+    export.fail!(e.message)
+    ExportMailer.failed(export).deliver_later
+  end
+end
diff --git a/app/jobs/import_job.rb b/app/jobs/import_job.rb
