--- /dev/null
+++ b/app/jobs/import_job.rb
@@ -0,0 +1,16 @@
+class ImportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    import.update!(status: "processing")
+    account = Account::DataTransfer::Importer.new(import).import!
+    ImportMailer.completed(import).deliver_later
+    account
+  rescue => e
+    Rails.logger.error "Import #{import.id} failed: #{e.class}: #{e.message}"
+    import.fail!(e.message)
+    ImportMailer.failed(import).deliver_later
+  end
+end
