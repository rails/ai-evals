diff --git a/config/initializers/i18n.rb b/config/initializers/i18n.rb
new file mode 100644
index 0000000..0e52f2b
--- /dev/null
+++ b/config/initializers/i18n.rb
@@ -0,0 +1,29 @@
+# Fizzy uses readable English source text as translation keys. Some of those
+# keys end with a period, which I18n would otherwise interpret as a scope
+# separator. Normalize such keys to their sanitized form before lookup.
+module I18nSourceKeyNormalization
+  SEPARATOR = "."
+
+  def t(key, **options)
+    key, options = normalized_source_key(key, options)
+    super(key, **options)
+  end
+
+  def translate(key, **options)
+    key, options = normalized_source_key(key, options)
+    super(key, **options)
+  end
+
+  private
+    def normalized_source_key(key, options)
+      if key.is_a?(String) && key.include?(" ") && key.include?(SEPARATOR)
+        if options[:default].is_a?(String)
+          options = options.merge(default: options[:default].tr(SEPARATOR, "\u00b7"))
+        end
+        key = key.tr(SEPARATOR, "\u00b7")
+      end
+      [ key, options ]
+    end
+end
+
+I18n.singleton_class.prepend(I18nSourceKeyNormalization)
