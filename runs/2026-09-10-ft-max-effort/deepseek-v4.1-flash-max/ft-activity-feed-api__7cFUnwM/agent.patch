+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+        fresh_when etag: @page.records
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.preloaded.activity.reverse_chronologically
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
