+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,45 @@
+module ActivitiesHelper
+  def activity_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: assignment_ids_for(event) }
+    when "card_board_changed"
+      { old_board: event_particular_value(event, "old_board"), new_board: event_particular_value(event, "new_board") }
+    when "card_title_changed"
+      { old_title: event_particular_value(event, "old_title"), new_title: event_particular_value(event, "new_title") }
+    when "card_triaged"
+      { column: event_particular_value(event, "column") }
+    else
+      {}
+    end
+  end
+
+  def activity_url(event)
+    if event.eventable_type == "Comment"
+      card_url event.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)
+    else
+      card_url event.card
+    end
+  end
+
+  private
+    def assignment_ids_for(event)
+      nested = event_particulars(event)["particulars"]
+      ids = event.assignee_ids || (nested.is_a?(Hash) ? nested["assignee_ids"] : nil)
+      Array(ids)
+    end
+
+    def event_particular_value(event, key)
+      particulars = event_particulars(event)
+
+      if (nested = particulars["particulars"]).is_a?(Hash) && nested.key?(key)
+        nested[key].to_s
+      else
+        particulars[key].to_s
+      end
+    end
+
+    def event_particulars(event)
+      event.particulars.to_h
+    end
+end
