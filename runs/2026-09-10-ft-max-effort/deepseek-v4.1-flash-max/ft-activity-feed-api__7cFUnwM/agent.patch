@@ -0,0 +1,69 @@
+# Activities
+
+Activities are the events that make up an account's timeline: cards being added, moved, assigned, renamed, closed, or commented on. The activities endpoint provides the same events shown in the HTML timeline, scoped to the boards the current user can access.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity events across the boards the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by event creator user ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+Repeated values are treated as a set: activity is returned when it matches any of the given creators or any of the given boards.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David assigned JZ to \"First!\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 4,
+      "title": "First!",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/4"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the rest of the API.
+
+The `url` opens the card for card events. For comments, it opens the card where the comment was posted and jumps to the comment.
+
+The `description` is the plain-text form of the event description shown in the HTML timeline.
+
+The `particulars` object contains event-specific details:
+
+| Event | Particulars |
+|-------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| Other events | An empty object |
+
+Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_endpoint_verification_test.rb b/test/controllers/activities_endpoint_verification_test.rb
new file mode 100644
index 0000000..e039077
--- /dev/null
+++ b/test/controllers/activities_endpoint_verification_test.rb
@@ -0,0 +1,268 @@
+require "test_helper"
+
+class ActivitiesEndpointVerificationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "returns a flat, newest-first array of activities with the expected fields" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body
+
+    assert_kind_of Array, activities
+    assert_not_empty activities
+    assert_equal activities.map { |activity| Time.zone.parse(activity["created_at"]) }.sort.reverse,
+      activities.map { |activity| Time.zone.parse(activity["created_at"]) }
+
+    event = events(:logo_published)
+    activity = activities.find { |a| a["id"] == event.id }
+
+    assert_not_nil activity
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.card.id, activity.dig("eventable", "id")
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+    assert_equal card_url(event.card), activity["url"]
+  end
+
+  test "includes card title changed events and omits deprecated card collection changed events" do
+    events(:logo_published).update_columns \
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    events(:layout_published).update_columns \
+      action: "card_collection_changed",
+      particulars: { "particulars" => { "old_collection" => "Old", "new_collection" => "New" } }
+
+    get activities_path(format: :json)
+
+    actions = @response.parsed_body.pluck("action")
+    assert_includes actions, "card_title_changed"
+    assert_not_includes actions, "card_collection_changed"
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_published).id }
+    assert_equal "Old title", activity.dig("particulars", "old_title")
+    assert_equal "New title", activity.dig("particulars", "new_title")
+  end
+
+  test "returns assignee ids for assignment changes" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal event.assignee_ids, activity.dig("particulars", "assignee_ids")
+  end
+
+  test "returns board change particulars and uses empty strings for missing values" do
+    event = events(:logo_published)
+    event.update_columns \
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => nil } }
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "Old board", activity.dig("particulars", "old_board")
+    assert_equal "", activity.dig("particulars", "new_board")
+  end
+
+  test "returns title change particulars and uses empty strings for missing values" do
+    event = events(:logo_published)
+    event.update_columns \
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => nil, "new_title" => nil } }
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "", activity.dig("particulars", "old_title")
+    assert_equal "", activity.dig("particulars", "new_title")
+  end
+
+  test "returns column particulars for triage events and uses an empty string when missing" do
+    event = events(:logo_published)
+    event.update_columns action: "card_triaged", particulars: { "particulars" => { "column" => "In progress" } }
+
+    get activities_path(format: :json)
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "In progress", activity.dig("particulars", "column")
+
+    event.update_columns particulars: {}
+    get activities_path(format: :json)
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "", activity.dig("particulars", "column")
+  end
+
+  test "returns an empty particulars object for other events" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:shipping_closed).id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "comment events use the comment card url with an anchor and the existing comment representation" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "filters by creator ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+
+    assert_response :success
+    assert_equal [ users(:david).id ], @response.parsed_body.pluck("creator").pluck("id").uniq
+  end
+
+  test "filters by board ids" do
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.pluck("board").pluck("id").uniq
+  end
+
+  test "only returns activity from boards the current user can access" do
+    private_event = create_private_board_event
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_empty @response.parsed_body
+
+    logout_and_sign_in_as :kevin
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "serializes every supported activity action" do
+    card = cards(:logo)
+
+    Event::ACTIVITY_ACTIONS.each do |action|
+      Event.create!(
+        account: card.account,
+        board: card.board,
+        creator: users(:kevin),
+        eventable: card,
+        action: action,
+        created_at: 1.minute.ago,
+        particulars: {}
+      )
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal Event::ACTIVITY_ACTIONS.sort, @response.parsed_body.pluck("action").uniq.sort
+  end
+
+  test "serializes particulars created by real event flows" do
+    card = cards(:logo)
+
+    with_current_user(users(:kevin)) do
+      card.update!(title: "Renamed logo")
+      card.triage_into(columns(:writebook_in_progress))
+      card.update!(board: boards(:private))
+    end
+
+    get activities_path(format: :json)
+
+    title_change = @response.parsed_body.find { |a| a["id"] == card.events.find_by(action: "card_title_changed").id }
+    assert_equal "The logo isn't big enough", title_change.dig("particulars", "old_title")
+    assert_equal "Renamed logo", title_change.dig("particulars", "new_title")
+
+    triage = @response.parsed_body.find { |a| a["id"] == card.events.find_by(action: "card_triaged").id }
+    assert_equal "In progress", triage.dig("particulars", "column")
+
+    board_change = @response.parsed_body.find { |a| a["id"] == card.events.find_by(action: "card_board_changed").id }
+    assert_equal "Writebook", board_change.dig("particulars", "old_board")
+    assert_equal "Private board", board_change.dig("particulars", "new_board")
+  end
+
+  test "paginates newest activity first following the API conventions" do
+    card = cards(:logo)
+    start = 10.minutes.ago
+
+    10.times do |index|
+      Event.create!(
+        account: card.account,
+        board: card.board,
+        creator: users(:kevin),
+        eventable: card,
+        action: "card_postponed",
+        created_at: start + index.seconds
+      )
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_equal "21", @response.headers["X-Total-Count"]
+    assert_includes @response.headers["Link"], "page=2"
+
+    first_page_ids = @response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { page: 2 }
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert_empty first_page_ids & @response.parsed_body.pluck("id")
+  end
+
+  test "supports ETag based caching" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    etag = @response.headers["ETag"]
+    assert etag.present?
+
+    get activities_path(format: :json), headers: { "If-None-Match" => etag }
+
+    assert_response :not_modified
+  end
+
+  test "authenticates with a bearer token" do
+    cookies.delete :session_token
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get "#{activities_path}.json"
+    assert_response :success
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  private
+    def create_private_board_event
+      card = with_current_user(users(:kevin)) do
+        boards(:private).cards.create! creator: users(:kevin), title: "Private card", status: "published"
+      end
+      card.events.last
+    end
+end
