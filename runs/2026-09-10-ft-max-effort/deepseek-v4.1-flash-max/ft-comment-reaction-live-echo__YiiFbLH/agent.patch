diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..0d1cd99
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,25 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_path(reactable.card, reactable)
+    else
+      card_reactions_path(reactable)
+    end
+  end
+
+  def reaction_path_for(reaction)
+    if reaction.card_id.present?
+      card_reaction_path(reaction.card, reaction)
+    else
+      card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction)
+    end
+  end
+
+  def reaction_content_tag(reaction)
+    if EmojiHelper::REACTIONS.key?(reaction.content)
+      tag.span reaction.content, class: "txt-small txt-medium", title: EmojiHelper::REACTIONS[reaction.content]
+    else
+      tag.span reaction.content, class: "txt-small"
+    end
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..1a588f4
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  start() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.#closeForm()
+    this.triggerTarget.focus()
+  }
+
+  chooseEmoji(event) {
+    this.inputTarget.value = event.currentTarget.dataset.emoji
+    this.formTarget.requestSubmit()
+  }
+
+  reset(event) {
+    if (event.detail.success) this.#closeForm()
+  }
+
+  #closeForm() {
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+  }
+}
