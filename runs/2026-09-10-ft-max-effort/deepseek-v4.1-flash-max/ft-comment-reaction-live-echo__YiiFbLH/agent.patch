@@ -0,0 +1,58 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_reactable, only: :create
+  before_action :set_reaction, only: %i[ show destroy ]
+
+  def index
+    @reactions = @comment.reactions.chronologically.preloaded
+
+    fresh_when etag: @comment.reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+    @reactable = @comment
+
+    respond_to do |format|
+      format.turbo_stream { render "cards/reactions/create" }
+      format.json { render "cards/reactions/show", status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def show
+  end
+
+  def destroy
+    if @reaction.reacter == Current.user
+      @reaction.destroy!
+
+      respond_to do |format|
+        format.turbo_stream { render "cards/reactions/destroy" }
+        format.json { head :no_content }
+      end
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_reactable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
