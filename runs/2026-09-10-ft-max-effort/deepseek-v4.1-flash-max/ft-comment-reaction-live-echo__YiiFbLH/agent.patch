@@ -0,0 +1,49 @@
+<div id="<%= dom_id(reactable, :new_reaction) %>" class="display-contents" data-turbo-permanent>
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-target="trigger" data-action="reaction#start"
+      aria-label="Add a reaction" title="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with url: url, scope: :reaction, class: "reaction__form",
+        html: { hidden: true, autocomplete: "off" },
+        data: { reaction_target: "form", action: "turbo:submit-end->reaction#reset keydown.esc->reaction#cancel" } do |form| %>
+    <label class="reaction__form-label">
+      <%= form.text_field :content, id: dom_id(reactable, :reaction_content), class: "input reaction__input",
+            maxlength: 16, required: true, autocomplete: "off",
+            placeholder: "Add a reaction…", aria: { label: "Add a reaction" },
+            data: { reaction_target: "input" } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog"
+          data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle" data-action="click->dialog#open:stop"
+          aria-label="Add an emoji" title="Add an emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Add an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog"
+          data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn btn--circle" data-action="reaction#chooseEmoji"
+                data-emoji="<%= emoji %>" aria-label="<%= name %>" title="<%= name %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: "submit", class: "reaction__submit-btn btn btn--circle",
+          title: "Add reaction", aria: { label: "Add reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle" data-action="reaction#cancel"
+        title="Cancel" aria-label="Cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
