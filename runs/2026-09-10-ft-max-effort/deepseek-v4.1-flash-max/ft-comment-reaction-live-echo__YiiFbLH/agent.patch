diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..fd9b1f1
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,34 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { card&.account }
+  belongs_to :card, optional: true, touch: true
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  after_create :register_card_activity
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :belongs_to_a_card_or_a_comment
+
+  normalizes :content, with: ->(value) { value&.strip }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { includes(reacter: [ :account, :avatar_attachment ]) }
+
+  def card
+    super || comment&.card
+  end
+
+  private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+
+    def belongs_to_a_card_or_a_comment
+      if card_id.present? && comment_id.present?
+        errors.add(:base, "must belong to a card or a comment, not both")
+      elsif card_id.blank? && comment_id.blank?
+        errors.add(:card, "must exist")
+        errors.add(:comment, "must exist")
+      end
+    end
+end
