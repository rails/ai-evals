diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..c232974
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "permanently removes data for accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_equal 0, User.where(account_id: @account.id).count
+    assert_equal 0, Board.where(account_id: @account.id).count
+    assert_equal 0, Card.where(account_id: @account.id).count
+    assert_equal 0, Comment.where(account_id: @account.id).count
+    assert_equal 0, Event.where(account_id: @account.id).count
+    assert_equal 0, ActionText::RichText.where(account_id: @account.id).count
+  end
+
+  test "keeps an account cancelled exactly 30 days ago" do
+    account = accounts(:initech)
+
+    travel_to Time.current do
+      account.cancel(initiated_by: users(:mike))
+    end
+
+    travel 30.days do
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(account.id)
+    end
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps accounts that have not been cancelled" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..5849a1f
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "incineratable scope includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_includes Account.incineratable, @account
+    assert_not_includes Account.incineratable, accounts(:initech)
+  end
+
+  test "incineratable? reflects the incineration grace period" do
+    @account.cancel(initiated_by: @user)
+    assert_not @account.incineratable?
+
+    @account.cancellation.update!(created_at: 31.days.ago)
+    assert @account.incineratable?
+  end
+
+  test "incinerate permanently removes the account and its data" do
+    @account.cancel(initiated_by: @user)
+    card_ids = Card.where(account_id: @account.id).ids
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_not Card.exists?(card_ids.first)
+  end
+end
