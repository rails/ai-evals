diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..4c608e4 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,79 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    # Accounts whose cancellation is older than the grace period are due to be
+    # permanently removed, along with all of their data.
+    scope :incineratable, -> {
+      where(id: Account::Cancellation.where(created_at: ...INCINERATION_GRACE_PERIOD.ago).select(:account_id))
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineratable.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    transaction do
+      remove_search_records
+      remove_filters
+      remove_storage_totals
+      remove_account_records
+      delete
+    end
+  end
+
+  def incineratable?
+    cancellation.present? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    # Search records have no account_id in the FTS index, so they must be
+    # destroyed through the model to keep the index in sync.
+    def remove_search_records
+      Search::Record.for(id).where(account_id: id).destroy_all
+    end
+
+    # HABTM join rows (boards_filters, filters_tags, ...) have no account_id of
+    # their own, so destroy filters to rely on their association cleanup.
+    def remove_filters
+      Filter.where(account_id: id).destroy_all
+    end
+
+    # Storage totals are polymorphic and have no account_id for board-owned rows.
+    def remove_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: Board.where(account_id: id).select(:id)).delete_all
+    end
+
+    # Delete everything holding an account_id directly rather than relying on
+    # dependent associations, which don't cover every account-owned table.
+    def remove_account_records
+      account_owned_tables.each do |table|
+        delete_account_rows(table)
+      end
+    end
+
+    def account_owned_tables
+      connection.tables.select do |table|
+        connection.columns(table).any? { |column| column.name == "account_id" }
+      end
+    end
+
+    def delete_account_rows(table)
+      quoted_table = connection.quote_table_name(table)
+      connection.delete(Arel.sql("DELETE FROM #{quoted_table} WHERE account_id = ?", account_id_bind), "Account Incinerate")
+    end
+
+    def account_id_bind
+      ActiveRecord::Relation::QueryAttribute.new("account_id", id, ActiveRecord::Type::Uuid.new)
+    end
+
+    def connection
+      self.class.connection
+    end
 end
