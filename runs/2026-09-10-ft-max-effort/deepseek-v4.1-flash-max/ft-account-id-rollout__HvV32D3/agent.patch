+      update_join_account_id "assigners_filters", "assigner_id", "users"
+      update_join_account_id "boards_filters", "board_id", "boards"
+      update_join_account_id "closers_filters", "closer_id", "users"
+      update_join_account_id "creators_filters", "creator_id", "users"
+      update_join_account_id "filters_tags", "tag_id", "tags"
+
+      # Tags that were only ever used in filters didn't have a card to recover from.
+      execute(<<~SQL)
+        UPDATE #{qt("tags")}
+        SET account_id = (
+          SELECT #{qt("filters")}.#{qc("account_id")}
+          FROM #{qt("filters_tags")}
+          INNER JOIN #{qt("filters")} ON #{qt("filters")}.#{qc("id")} = #{qt("filters_tags")}.#{qc("filter_id")}
+          WHERE #{qt("filters_tags")}.#{qc("tag_id")} = #{qt("tags")}.#{qc("id")}
+            AND #{qt("filters")}.#{qc("account_id")} IS NOT NULL
+          LIMIT 1
+        )
+        WHERE #{qt("tags")}.#{qc("account_id")} IS NULL
+      SQL
+    end
+
+    def backfill_mentions_and_reactions
+      update_polymorphic_account_id "mentions", "source_type", "source_id",
+        "Card" => [ "cards", "account_id" ],
+        "Comment" => [ "comments", "account_id" ]
+
+      update_polymorphic_account_id "reactions", "reactable_type", "reactable_id",
+        "Card" => [ "cards", "account_id" ],
+        "Comment" => [ "comments", "account_id" ]
+    end
+
+    def backfill_storage_and_entropies
+      execute(<<~SQL)
+        UPDATE #{qt("storage_totals")}
+        SET account_id = CASE #{qt("storage_totals")}.#{qc("owner_type")}
+          WHEN 'Account' THEN #{qt("storage_totals")}.#{qc("owner_id")}
+          WHEN 'Board' THEN (SELECT #{qt("boards")}.#{qc("account_id")} FROM #{qt("boards")} WHERE #{qt("boards")}.#{qc("id")} = #{qt("storage_totals")}.#{qc("owner_id")})
+          WHEN 'User' THEN (SELECT #{qt("users")}.#{qc("account_id")} FROM #{qt("users")} WHERE #{qt("users")}.#{qc("id")} = #{qt("storage_totals")}.#{qc("owner_id")})
+        END
+        WHERE #{qt("storage_totals")}.#{qc("account_id")} IS NULL
+      SQL
+
+      execute(<<~SQL)
+        UPDATE #{qt("entropies")}
+        SET account_id = CASE #{qt("entropies")}.#{qc("container_type")}
+          WHEN 'Account' THEN #{qt("entropies")}.#{qc("container_id")}
+          WHEN 'Board' THEN (SELECT #{qt("boards")}.#{qc("account_id")} FROM #{qt("boards")} WHERE #{qt("boards")}.#{qc("id")} = #{qt("entropies")}.#{qc("container_id")})
+          WHEN 'Card' THEN (SELECT #{qt("cards")}.#{qc("account_id")} FROM #{qt("cards")} WHERE #{qt("cards")}.#{qc("id")} = #{qt("entropies")}.#{qc("container_id")})
+        END
+        WHERE #{qt("entropies")}.#{qc("account_id")} IS NULL
+      SQL
+    end
+
+    def backfill_webhooks_and_accesses
+      update_account_id "webhook_delinquency_trackers", "webhook_id", "webhooks"
+      update_account_id "webhook_deliveries", "webhook_id", "webhooks"
+      update_account_id "webhook_deliveries", "event_id", "events"
+    end
+
+    def backfill_active_storage
+      # Action text records first: attachments to them need their account.
+      update_polymorphic_account_id "action_text_rich_texts", "record_type", "record_id",
+        "Card" => [ "cards", "account_id" ],
+        "Comment" => [ "comments", "account_id" ],
+        "Board" => [ "boards", "account_id" ]
+
+      # Normal attachments get their account from the attached record.
+      update_polymorphic_account_id "active_storage_attachments", "record_type", "record_id",
+        "Card" => [ "cards", "account_id" ],
+        "ActionText::RichText" => [ "action_text_rich_texts", "account_id" ],
+        "User" => [ "users", "account_id" ],
+        "Account::Export" => [ "exports", "account_id" ],
+        "User::DataExport" => [ "exports", "account_id" ],
+        "Export" => [ "exports", "account_id" ],
+        "Account::Import" => [ "account_imports", "account_id" ],
+        "Board" => [ "boards", "account_id" ]
+
+      # A blob inherits the account of any attachment pointing at it.
+      backfill_blobs_from_attachments
+
+      # Variant records and their image attachments inherit from the parent blob.
+      update_account_id "active_storage_variant_records", "blob_id", "active_storage_blobs"
+      update_polymorphic_account_id "active_storage_attachments", "record_type", "record_id",
+        "ActiveStorage::VariantRecord" => [ "active_storage_variant_records", "account_id" ]
+
+      # Variant images are themselves blobs, now that their attachment has an account.
+      backfill_blobs_from_attachments
+    end
+
+    def backfill_blobs_from_attachments
+      execute(<<~SQL)
+        UPDATE #{qt("active_storage_blobs")}
+        SET account_id = (
+          SELECT #{qt("active_storage_attachments")}.#{qc("account_id")}
+          FROM #{qt("active_storage_attachments")}
+          WHERE #{qt("active_storage_attachments")}.#{qc("blob_id")} = #{qt("active_storage_blobs")}.#{qc("id")}
+            AND #{qt("active_storage_attachments")}.#{qc("account_id")} IS NOT NULL
+          LIMIT 1
+        )
+        WHERE #{qt("active_storage_blobs")}.#{qc("account_id")} IS NULL
+      SQL
+    end
+
+    def drop_orphans
+      (ACCOUNT_TABLES + search_record_tables).each do |table|
+        execute(<<~SQL)
+          DELETE FROM #{qt(table)}
+          WHERE #{qc("account_id")} IS NULL
+             OR #{qc("account_id")} NOT IN (SELECT #{qc("id")} FROM #{qt("accounts")})
+        SQL
+      end
+    end
+
+    # SQLite keeps a single search_records table; MySQL uses 16 shards.
+    def search_record_tables
+      connection.tables.grep(/\Asearch_records(_\d+)?\z/)
+    end
+
+    def enforce_account_id_presence
+      ACCOUNT_TABLES.each do |table|
+        column = connection.columns(table).find { |c| c.name == "account_id" }
+        change_column_null table, :account_id, false if column&.null
+      end
+    end
+
+    def add_account_id_indexes
+      ACCOUNT_TABLES.each do |table|
+        add_index table, :account_id, name: "index_#{table}_on_account_id" unless index_exists?(table, :account_id)
+      end
+    end
+
+    # Tags are unique per account, not globally: every account can have its own "urgent".
+    def reindex_tags_per_account
+      if index_exists?(:tags, :title, name: "index_tags_on_title")
+        remove_index :tags, name: "index_tags_on_title"
+      end
+
+      unless index_exists?(:tags, [ :account_id, :title ], unique: true, name: "index_tags_on_account_id_and_title")
+        add_index :tags, [ :account_id, :title ], unique: true, name: "index_tags_on_account_id_and_title"
+      end
+    end
+
+    def update_account_id(table, foreign_key, parent_table, parent_column: "account_id", scope: nil)
+      scope_sql = scope.present? ? " AND #{scope}" : ""
+      execute(<<~SQL)
+        UPDATE #{qt(table)}
+        SET #{qc("account_id")} = (
+          SELECT #{qt(parent_table)}.#{qc(parent_column)}
+          FROM #{qt(parent_table)}
+          WHERE #{qt(parent_table)}.#{qc("id")} = #{qt(table)}.#{qc(foreign_key)}
+        )
+        WHERE #{qt(table)}.#{qc("account_id")} IS NULL#{scope_sql}
+      SQL
+    end
+
+    def drop_orphan_join_rows
+      {
+        "assignees_filters" => [ [ "filter_id", "filters" ], [ "assignee_id", "users" ] ],
+        "assigners_filters" => [ [ "filter_id", "filters" ], [ "assigner_id", "users" ] ],
+        "boards_filters" => [ [ "filter_id", "filters" ], [ "board_id", "boards" ] ],
+        "closers_filters" => [ [ "filter_id", "filters" ], [ "closer_id", "users" ] ],
+        "creators_filters" => [ [ "filter_id", "filters" ], [ "creator_id", "users" ] ],
+        "filters_tags" => [ [ "filter_id", "filters" ], [ "tag_id", "tags" ] ]
+      }.each do |table, associations|
+        conditions = associations.map do |foreign_key, parent_table|
+          "#{qt(table)}.#{qc(foreign_key)} NOT IN (SELECT #{qc("id")} FROM #{qt(parent_table)})"
+        end
+
+        execute("DELETE FROM #{qt(table)} WHERE #{conditions.join(" OR ")}")
+      end
+    end
+
+    def update_join_account_id(table, foreign_key, parent_table)
+      execute(<<~SQL)
+        UPDATE #{qt(table)}
+        SET #{qc("account_id")} = COALESCE(
+          (SELECT #{qt("filters")}.#{qc("account_id")} FROM #{qt("filters")} WHERE #{qt("filters")}.#{qc("id")} = #{qt(table)}.#{qc("filter_id")}),
+          (SELECT #{qt(parent_table)}.#{qc("account_id")} FROM #{qt(parent_table)} WHERE #{qt(parent_table)}.#{qc("id")} = #{qt(table)}.#{qc(foreign_key)})
+        )
+        WHERE #{qt(table)}.#{qc("account_id")} IS NULL
+      SQL
+    end
+
+    def update_polymorphic_account_id(table, type_column, id_column, mapping)
+      mapping.each do |type, (parent_table, parent_column)|
+        update_account_id table, id_column, parent_table,
+          parent_column: parent_column,
+          scope: "#{qt(table)}.#{qc(type_column)} = #{connection.quote(type)}"
+      end
+    end
+
+    def qt(name)
+      connection.quote_table_name(name)
+    end
+
+    def qc(name)
+      connection.quote_column_name(name)
+    end
+end
