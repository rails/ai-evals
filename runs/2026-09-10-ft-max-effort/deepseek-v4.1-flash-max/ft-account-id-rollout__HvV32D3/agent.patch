+    def backfill_tags
+      execute(<<~SQL)
+        UPDATE #{qt("tags")}
+        SET account_id = (
+          SELECT #{qt("cards")}.#{qc("account_id")}
+          FROM #{qt("taggings")}
+          INNER JOIN #{qt("cards")} ON #{qt("cards")}.#{qc("id")} = #{qt("taggings")}.#{qc("card_id")}
+          WHERE #{qt("taggings")}.#{qc("tag_id")} = #{qt("tags")}.#{qc("id")}
+            AND #{qt("cards")}.#{qc("account_id")} IS NOT NULL
+          LIMIT 1
