diff --git a/config/initializers/active_storage_account_id.rb b/config/initializers/active_storage_account_id.rb
new file mode 100644
index 0000000..2ec03ab
--- /dev/null
+++ b/config/initializers/active_storage_account_id.rb
@@ -0,0 +1,20 @@
+# Every blob, attachment, variant record, and rich text belongs to an account.
+#
+# Blobs pick up Current.account at upload time. Everything else inherits the
+# account of the record it is attached to, falling back to the blob's account
+# for records (like Identity) that don't participate in tenanting.
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob&.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob&.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) }
+end
