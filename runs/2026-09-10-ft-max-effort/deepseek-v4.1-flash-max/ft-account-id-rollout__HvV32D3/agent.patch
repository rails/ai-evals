+    creators_filters
+    entropies
+    events
+    exports
+    filters
+    filters_tags
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    steps
+    storage_entries
+    storage_totals
+    taggings
+    tags
+    user_settings
+    users
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    webhooks
+  ].freeze
+
+  TABLES_WITH_ACCOUNT_ID = %w[
+    account_cancellations
+    account_imports
+    account_join_codes
+    boards
+    cards
+    columns
+    comments
+    events
+    exports
+    filters
+    notification_bundles
+    notifications
+    push_subscriptions
+    steps
+    storage_entries
+    tags
+    users
+    webhooks
+  ].freeze
+
+  def up
+    add_missing_columns
+    backfill_account_ids
+    drop_orphans
+    enforce_account_id_presence
+    add_account_id_indexes
+    reindex_tags_per_account
+  end
+
+  def down
+    raise ActiveRecord::IrreversibleMigration
+  end
+
+  private
+    def add_missing_columns
+      (ACCOUNT_TABLES - TABLES_WITH_ACCOUNT_ID).each do |table|
+        add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+      end
+    end
+
+    def backfill_account_ids
+      backfill_core_records
+      backfill_records_owned_by_boards
+      backfill_comments_and_events
+      backfill_card_records
+      backfill_tags
+      backfill_records_owned_by_users
+      backfill_filters_and_joins
+      backfill_mentions_and_reactions
+      backfill_storage_and_entropies
+      backfill_webhooks_and_accesses
+      backfill_active_storage
+    end
+
+    # Root records.
+    def backfill_core_records
+      update_account_id "boards", "creator_id", "users"
+    end
+
+    # Records whose account comes from their board.
+    def backfill_records_owned_by_boards
+      update_account_id "cards", "board_id", "boards"
+      update_account_id "cards", "creator_id", "users"
+      update_account_id "columns", "board_id", "boards"
+      update_account_id "webhooks", "board_id", "boards"
+      update_account_id "board_publications", "board_id", "boards"
+      update_account_id "accesses", "board_id", "boards"
+      update_account_id "taggings", "card_id", "cards"
+    end
+
+    def backfill_comments_and_events
+      # Comments need cards backfilled above; events only need their board.
+      update_account_id "comments", "card_id", "cards"
+      update_account_id "events", "board_id", "boards"
+      update_account_id "events", "creator_id", "users"
+    end
+
+    # Records whose account is inherited from a card.
+    def backfill_card_records
+      %w[card_activity_spikes card_goldnesses card_not_nows closures pins steps watches].each do |table|
+        update_account_id table, "card_id", "cards"
+      end
+      update_account_id "assignments", "card_id", "cards"
