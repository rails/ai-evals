@@ -0,0 +1,60 @@
+class AccountSubscription < SaasRecord
+  PLANS = Plan::PLANS
+  PLAN_KEYS = Plan::PLANS.keys.freeze
+  belongs_to :account
+
+  before_validation -> { self.plan_key ||= Plan.free.key }
+
+  validates :stripe_customer_id, uniqueness: true, allow_nil: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  def plan
+    canceled? ? Plan.free : Plan.find(plan_key)
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def storage_limit
+    plan.storage_limit
+  end
+
+  def plan=(plan)
+    self.plan_key = plan.is_a?(Plan) ? plan.key : Plan.normalize(plan)
+  end
+
+  def free?
+    plan.free?
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def active?
+    status.blank? || status.in?(%w[ active trialing ])
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def stripe?
+    stripe_subscription_id.present?
+  end
+
+  def upgrade_to!(new_plan)
+    update!(plan_key: new_plan.is_a?(Plan) ? new_plan.key : Plan.normalize(new_plan))
+  end
+  alias_method :change_plan!, :upgrade_to!
+  alias_method :update_plan!, :upgrade_to!
+
+  def cancel!
+    update!(status: "canceled", plan_key: Plan.free.key)
+  end
+end
