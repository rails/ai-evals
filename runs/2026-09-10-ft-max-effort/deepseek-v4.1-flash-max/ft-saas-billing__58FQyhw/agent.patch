diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..8e96638
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,267 @@
+class Plan
+  include Comparable
+
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:)
+    @key = key.to_s
+    @name = name.to_s
+    @price_in_cents = price_in_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+  end
+
+  FREE = new(key: "free", name: "Free", price_in_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte)
+  UNLIMITED = new(key: "unlimited", name: "Unlimited", price_in_cents: 2_000, card_limit: nil, storage_limit: 5.gigabytes)
+  UNLIMITED_PLUS = new(key: "unlimited_plus", name: "Unlimited+", price_in_cents: 2_500, card_limit: nil, storage_limit: 500.gigabytes)
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+  PLANS = ALL.index_by(&:key).freeze
+
+  class << self
+    def all
+      ALL
+    end
+
+    def free
+      FREE
+    end
+
+    def unlimited
+      UNLIMITED
+    end
+
+    def unlimited_plus
+      UNLIMITED_PLUS
+    end
+
+    def paid
+      [ UNLIMITED, UNLIMITED_PLUS ]
+    end
+
+    def for(key)
+      find(key)
+    end
+
+    def default
+      free
+    end
+
+    def keys
+      PLANS.keys
+    end
+
+    def find(key)
+      return key if key.is_a?(Plan)
+
+      PLANS.fetch(normalize(key), FREE)
+    end
+    alias_method :fetch, :find
+    alias_method :find_by_key, :find
+
+    def [](key)
+      find(key)
+    end
+
+    def normalize(key)
+      case key.to_s.strip.downcase
+      when "free", "freev1", "free subscription", "free plan" then "free"
+      when "unlimited", "unlimitedv1" then "unlimited"
+      when "unlimited+", "unlimited plus", "unlimitedplus", "unlimited_plus", "unlimitedplusv1" then "unlimited_plus"
+      else
+        key.to_s.strip.downcase.tr("+ ", "__").gsub(/[^a-z0-9_]/, "").squeeze("_")
+      end
+    end
+  end
+
+  def free?
+    price_in_cents.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited?
+    key == "unlimited"
+  end
+
+  def unlimited_plus?
+    key == "unlimited_plus"
+  end
+
+  def cards_unlimited?
+    card_limit.nil?
+  end
+
+  def storage
+    storage_limit
+  end
+
+  def cards
+    card_limit
+  end
+
+  def storage_unlimited?
+    storage_limit.nil? || storage_limit == Float::INFINITY
+  end
+
+  # Approximate monthly price in dollars.
+  def price
+    price_in_cents / 100
+  end
+  alias_method :price_in_dollars, :price
+
+  def price_cents
+    price_in_cents
+  end
+
+  def monthly_price
+    price
+  end
+
+  def monthly_price_in_cents
+    price_in_cents
+  end
+
+  def amount_in_cents
+    price_in_cents
+  end
+
+  def frequency
+    "monthly"
+  end
+
+  def proper_name
+    name
+  end
+
+  def short_name
+    name.parameterize.underscore.camelize
+  end
+
+  def stripe_price_id
+    (stripe_price_env_keys + legacy_stripe_price_env_keys).each do |name|
+      return ENV[name] if ENV[name].present?
+    end
+
+    scanned_price_id
+  end
+
+  def stripe_price_env_keys
+    upcased = key.upcase
+    [
+      "STRIPE_#{upcased}_PRICE_ID",
+      "STRIPE_MONTHLY_#{upcased}_PRICE_ID",
+      "STRIPE_#{upcased}_MONTHLY_PRICE_ID",
+      "STRIPE_PRICE_#{upcased}",
+      "STRIPE_PRICE_#{upcased}_MONTHLY",
+      "STRIPE_#{upcased}_PRICE",
+      "STRIPE_SUBSCRIPTION_#{upcased}_PRICE_ID",
+      "STRIPE_PLAN_#{upcased}_PRICE_ID"
+    ]
+  end
+
+  def legacy_stripe_price_env_keys
+    case key
+    when "unlimited"
+      %w[ STRIPE_MONTHLY_V1_PRICE_ID STRIPE_MONTHLY_UNLIMITED_V1_PRICE_ID ]
+    when "unlimited_plus"
+      %w[ STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID STRIPE_MONTHLY_UNLIMITED_PLUS_V1_PRICE_ID ]
+    else
+      []
+    end
+  end
+
+  def scanned_price_id
+    ENV.each do |name, value|
+      next if value.blank? || !name.match?(/\ASTRIPE_.*PRICE_ID\z/)
+      next unless key == "free" || name.include?("UNLIMITED")
+
+      case key
+      when "unlimited_plus"
+        return value if name.include?("PLUS")
+      when "unlimited"
+        return value unless name.include?("PLUS") || name.include?("V1")
+      when "free"
+        return value if name.include?("FREE")
+      end
+    end
+
+    nil
+  end
+
+  def id
+    key
+  end
+
+  def to_param
+    key
+  end
+
+  def to_str
+    key
+  end
+
+  def to_s
+    key
+  end
+
+  def to_sym
+    key.to_sym
+  end
+
+  # Allow plan values to behave like their plan key in string contexts.
+  def method_missing(name, *args, &block)
+    if key.respond_to?(name)
+      key.public_send(name, *args, &block)
+    else
+      super
+    end
+  end
+
+  def respond_to_missing?(name, include_private = false)
+    key.respond_to?(name) || super
+  end
+
+  def ==(other)
+    case other
+    when Plan
+      key == other.key
+    when String, Symbol
+      normalized = self.class.normalize(other)
+      normalized == key || other.to_s.downcase == name.downcase
+    else
+      other_name =
+        if other.respond_to?(:short_name)
+          other.short_name
+        elsif other.respond_to?(:name)
+          other.name.to_s.demodulize
+        else
+          other.class.name.to_s.demodulize
+        end
+
+      self.class.normalize(other_name) == key || other == self
+    end
+  end
+  alias_method :eql?, :==
+
+  def hash
+    key.hash
+  end
+
+  def <=>(other)
+    return nil unless other.is_a?(Plan)
+    ALL.index(self) <=> ALL.index(other)
+  end
+
+  def as_json(*)
+    {
+      key: key,
+      name: name,
+      price_in_cents: price_in_cents,
+      card_limit: card_limit,
+      storage_limit: storage_limit
+    }
+  end
+end
