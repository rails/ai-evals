+<% @page_title = "Upgrade" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Upgrade your account</h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow center">
+    <header class="margin-block-end">
+      <h2 class="divider txt-medium">Plans</h2>
+      <p class="txt-small txt-ink-medium">
+        Pick the plan that fits your team. Stripe hosts checkout and billing, and you can manage
+        your subscription from the customer portal at any time.
+      </p>
+    </header>
+
+    <div class="flex flex-column gap">
+      <% @plans.each do |plan| %>
+        <% current = plan == Current.account.plan %>
+        <div class="settings__section plan panel--bordered pad" id="plan_<%= plan.key %>">
+          <div class="flex align-center justify-space-between gap">
+            <div>
+              <h3 class="margin-none"><%= plan.name %></h3>
+              <% if current %>
+                <div class="txt-small txt-ink-medium">Current plan</div>
+              <% end %>
+            </div>
+
+            <div class="txt-large">
+              <% if plan.free? %>
+                <strong>Free</strong>
+              <% else %>
+                <strong><%= number_to_currency(plan.price_in_cents / 100.0, precision: 0) %></strong><span class="txt-small">/month</span>
+              <% end %>
+            </div>
+          </div>
+
+          <ul class="margin-block-start-half">
+            <li>
+              <strong><%= plan.cards_unlimited? ? "Unlimited" : number_with_delimiter(plan.card_limit) %></strong> cards
+            </li>
+            <li>
+              <strong><%= number_to_human_size(plan.storage_limit) %></strong> storage
+            </li>
+          </ul>
+
+          <div class="margin-block-start-half">
+            <% if current %>
+              <span class="btn btn--plain" aria-disabled="true">Current plan</span>
+            <% else %>
+              <%= button_to "Upgrade", upgrade_path(plan: plan.key), method: :post, class: "btn btn--reversed" %>
+            <% end %>
+          </div>
+        </div>
+      <% end %>
+    </div>
+
+    <% if Current.account.paid_plan? && Current.account.stripe_customer_id.present? %>
+      <div class="margin-block-start">
+        <%= button_to "Manage subscription", billing_portal_path, method: :get, class: "btn" %>
+      </div>
+    <% end %>
+  </div>
+</section>
