+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium">Account</h2>
+    </header>
+
+    <div class="txt-small txt-ink-medium">#<%= @account.external_account_id %></div>
+
+    <div class="margin-block-start-half">
+      <p>Plan: <strong><%= @account.plan.name %></strong></p>
+      <p>
+        Cards: <strong><%= number_with_delimiter(@account.cards_count) %></strong>
+        <% if @account.card_limit %>
+          of <%= number_with_delimiter(@account.card_limit) %>
+        <% end %>
+      </p>
+      <p>
+        Storage used: <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+        of <strong><%= @account.storage_limit == Float::INFINITY ? "Unlimited" : number_to_human_size(@account.storage_limit) %></strong>
+      </p>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Comp</h2>
+    </header>
+
+    <div class="flex gap">
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override</h2>
+    </header>
+
+    <%= form_with url: saas.admin_account_override_path(@account), method: :post, class: "flex flex-column gap-half" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+      </div>
+
+      <div class="flex gap">
+        <%= form.button "Override", type: :submit, class: "btn" %>
+        <%= form.submit "Override", class: "for-screen-reader", hidden: true, disabled: true %>
+      </div>
+    <% end %>
+
+    <div class="margin-block-start-half">
+      <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn" %>
+    </div>
+  </div>
+</section>
