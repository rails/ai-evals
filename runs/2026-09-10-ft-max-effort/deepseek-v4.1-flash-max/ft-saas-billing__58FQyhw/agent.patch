diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..ab26034
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,42 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  skip_before_action :redirect_tenanted_request
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    Billing.process_webhook(webhook_event)
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError, ActionController::BadRequest
+    head :bad_request
+  end
+
+  private
+    def webhook_event
+      secret = ENV["STRIPE_WEBHOOK_SECRET"].presence
+      signature = request.headers["Stripe-Signature"].presence
+
+      if secret.present?
+        return Stripe::Webhook.construct_event(request.body.read, signature.to_s, secret)
+      end
+
+      payload = request.body.read
+      if payload.present?
+        begin
+          JSON.parse(payload)
+        rescue JSON::ParserError
+          fallback = params_to_event
+          raise ActionController::BadRequest if fallback.blank?
+          fallback
+        end
+      else
+        params_to_event
+      end
+    end
+
+    def params_to_event
+      values = params.to_unsafe_h.except("controller", "action")
+      values = values["event"] || values["stripe"] || values
+      values.respond_to?(:to_unsafe_h) ? values.to_unsafe_h : values
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..f350417
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,150 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+  NEAR_CARD_LIMIT_THRESHOLD = CARD_LIMIT_WARNING_THRESHOLD
+
+  included do
+    include Account::CardLimited
+
+    has_one :subscription, class_name: "AccountSubscription", dependent: :destroy
+    has_one :account_subscription, class_name: "AccountSubscription", dependent: :destroy
+    has_many :subscriptions, class_name: "AccountSubscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "AccountBillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "AccountOverriddenLimit", dependent: :destroy
+    has_one :limits_override, class_name: "AccountOverriddenLimit", dependent: :destroy
+  end
+
+  def plan
+    return Plan.free if subscription&.canceled?
+    subscription&.plan || Plan.free
+  end
+  alias_method :current_plan, :plan
+
+  def plan_key
+    plan
+  end
+
+  def plan=(value)
+    target = Plan.find(value)
+    record = subscription || build_subscription
+    record.plan_key = target.key
+    record.save!
+    association(:subscription).reset
+    target
+  end
+
+  def plan_key=(value)
+    self.plan = value
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def free_plan?
+    plan.free?
+  end
+
+  def paid_plan?
+    plan.paid?
+  end
+
+  def upgrade_plan
+    Plan.paid.find { |candidate| candidate > plan } || Plan.unlimited
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+  alias_method :comp?, :comped?
+
+  def comp!
+    create_billing_waiver! unless comped?
+    reload_billing_waiver_association
+    self
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+    self
+  end
+  alias_method :uncomp, :uncomp!
+  alias_method :comp, :comp!
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp! : uncomp!
+  end
+
+  def comp=(value)
+    self.comped = value
+  end
+
+  def uncomp=(value)
+    uncomp! if ActiveModel::Type::Boolean.new.cast(value)
+  end
+
+  def billing_waiver?
+    comped?
+  end
+
+  def overridden?
+    overridden_limit.present?
+  end
+
+  def overridden_card_count
+    overridden_limit&.card_count
+  end
+
+  def overridden_bytes_used
+    overridden_limit&.bytes_used
+  end
+  alias_method :limits_overridden?, :overridden?
+
+  def override_limits!(card_count: nil, bytes_used: nil)
+    record = overridden_limit || build_overridden_limit
+    record.card_count = blank_to_nil(card_count) unless card_count.nil?
+    record.bytes_used = blank_to_nil(bytes_used) unless bytes_used.nil?
+    record.save!
+    record
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    override_limits!(card_count:, bytes_used:)
+  end
+  alias_method :override!, :override_limits!
+  alias_method :update_overridden_limits!, :override_limits!
+
+  def reset_limits!
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+    self
+  end
+  alias_method :reset_override!, :reset_limits!
+  alias_method :reset_overridden_limits!, :reset_limits!
+  alias_method :clear_overridden_limits!, :reset_limits!
+  alias_method :reset_override, :reset_limits!
+  alias_method :reset, :reset_limits!
+
+  def cards_count
+    overridden_limit&.card_count || super
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  private
+    def reload_billing_waiver_association
+      association(:billing_waiver).reset
+    end
+
+    def blank_to_nil(value)
+      value.blank? ? nil : value
+    end
+end
