diff --git a/saas/app/models/billing/webhook.rb b/saas/app/models/billing/webhook.rb
new file mode 100644
index 0000000..468be1f
--- /dev/null
+++ b/saas/app/models/billing/webhook.rb
@@ -0,0 +1,207 @@
+class Billing::Webhook
+  class << self
+    def process(event)
+      new(event).process
+    end
+    alias_method :call, :process
+    alias_method :handle, :process
+  end
+
+  def initialize(event)
+    @event = event
+  end
+
+  def process
+    case event_type
+    when "checkout.session.completed"
+      complete_checkout
+    when "customer.subscription.created", "customer.subscription.updated"
+      upsert_subscription
+    when "customer.subscription.deleted"
+      cancel_subscription
+    end
+  end
+
+  private
+    attr_reader :event
+
+    def event_type
+      fetch(event, :type)
+    end
+
+    def object
+      data = fetch(event, :data)
+      fetch(data, :object) || data
+    end
+
+    def complete_checkout
+      account = find_account(object)
+      return unless account
+
+      subscription = account.subscription || account.build_subscription
+      subscription_id = identifier(fetch(object, :subscription))
+      customer_id = identifier(fetch(object, :customer))
+      subscription.stripe_customer_id = customer_id if customer_id.present?
+      subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+      mapped_plan_key = plan_key_from(object).presence || plan_key_from_amount(object) || retrieved_plan_key(subscription_id)
+      subscription.plan_key = mapped_plan_key if mapped_plan_key.present?
+      subscription.status = "active"
+      subscription.save!
+      account.association(:subscription).reset
+    end
+
+    def upsert_subscription
+      subscription_id = identifier(fetch(object, :id))
+      customer_id = identifier(fetch(object, :customer))
+
+      subscription = AccountSubscription.find_by(stripe_subscription_id: subscription_id) if subscription_id
+      subscription ||= AccountSubscription.find_by(stripe_customer_id: customer_id) if customer_id
+      account = subscription&.account || find_account(object)
+      return unless account
+
+      subscription ||= account.subscription || account.build_subscription
+      subobject_metadata = metadata(object)
+
+      subscription.stripe_subscription_id ||= subscription_id
+      subscription.stripe_customer_id ||= customer_id
+
+      mapped_plan_key = plan_key_from(object).presence || plan_key_from_items(object).presence || retrieved_plan_key(subscription_id)
+      subscription.plan_key = mapped_plan_key if mapped_plan_key.present?
+      subscription.status = fetch(object, :status) if fetch(object, :status).present?
+      subscription.status = subobject_metadata["status"] if subobject_metadata["status"].present?
+      subscription.current_period_end = timestamp(fetch(object, :current_period_end)) if fetch(object, :current_period_end)
+      subscription.cancel_at = timestamp(fetch(object, :cancel_at)) if fetch(object, :cancel_at)
+      subscription.next_amount_due_in_cents = next_amount_due_in_cents_from(object)
+      subscription.plan_key = Plan.free.key if subscription.status == "canceled"
+      subscription.save!
+      account.association(:subscription).reset
+    end
+
+    def cancel_subscription
+      subscription = AccountSubscription.find_by(stripe_subscription_id: identifier(fetch(object, :id)))
+      subscription ||= AccountSubscription.find_by(stripe_customer_id: identifier(fetch(object, :customer)))
+      return unless subscription
+
+      subscription.cancel!
+      subscription.account.association(:subscription).reset
+    end
+
+    def find_account(source)
+      account_ids(source).each do |id|
+        account = Account.find_by(id: id) || Account.find_by(external_account_id: id)
+        return account if account
+      end
+
+      subscription = AccountSubscription.find_by(stripe_customer_id: identifier(fetch(source, :customer)))
+      subscription&.account
+    end
+
+    def account_ids(source)
+      values = [
+        metadata(source)["account_id"],
+        metadata(source)["account_external_id"],
+        metadata(source)["queenbee_id"],
+        fetch(source, :client_reference_id)
+      ]
+      values.compact.uniq
+    end
+
+    def plan_key_from(source)
+      values = metadata(source)
+      (values["plan_key"] || values["plan"] || values["plan_name"] || fetch(source, :plan_key) || fetch(source, :plan) || fetch(source, :plan_name)).presence
+    end
+
+    def plan_key_from_amount(source)
+      amount = fetch(source, :amount_total) || fetch(source, :amount_subtotal)
+      case amount
+      when Plan::UNLIMITED_PLUS.price_in_cents then Plan::UNLIMITED_PLUS.key
+      when Plan::UNLIMITED.price_in_cents then Plan::UNLIMITED.key
+      end
+    end
+
+    def retrieved_plan_key(subscription_id)
+      return nil if subscription_id.blank?
+      return nil unless defined?(Stripe::Subscription)
+
+      stripe_subscription = Stripe::Subscription.retrieve(subscription_id)
+      plan_key_from(stripe_subscription).presence || plan_key_from_items(stripe_subscription).presence
+    rescue StandardError
+      nil
+    end
+
+    def plan_key_from_items(source)
+      items = fetch(source, :items)
+      items = fetch(items, :data) || items
+      Array(items).each do |item|
+        price = fetch(item, :price)
+        next unless price
+
+        plan_key = metadata(price)["plan_key"].presence
+        return plan_key if plan_key
+
+        price_id = fetch(price, :id)
+        if price_id
+          plan = Plan.all.find { |candidate| candidate.stripe_price_id.present? && candidate.stripe_price_id == price_id }
+          return plan.key if plan
+        end
+
+        lookup_key = fetch(price, :lookup_key).presence || fetch(price, :nickname).presence
+        if lookup_key
+          normalized = Plan.normalize(lookup_key)
+          return normalized if Plan::PLANS.key?(normalized)
+        end
+      end
+
+      nil
+    end
+
+    def next_amount_due_in_cents_from(source)
+      items = fetch(source, :items)
+      items = fetch(items, :data) || items
+      price = Array(items).first && fetch(Array(items).first, :price)
+      cents = price && fetch(price, :unit_amount)
+      cents || fetch(source, :amount_due) || fetch(source, :amount_total)
+    end
+
+    def metadata(source)
+      value = fetch(source, :metadata)
+      return {} if value.nil?
+      value = value.to_h if value.respond_to?(:to_h)
+      value.respond_to?(:stringify_keys) ? value.stringify_keys : Hash(value).transform_keys(&:to_s)
+    rescue StandardError
+      {}
+    end
+
+    def identifier(value)
+      value.respond_to?(:id) ? value.id : value
+    end
+
+    def timestamp(value)
+      return value if value.is_a?(Time) || value.is_a?(DateTime) || value.is_a?(ActiveSupport::TimeWithZone)
+      Time.at(value.to_i)
+    end
+
+    def fetch(source, key)
+      return nil if source.nil?
+
+      if source.respond_to?(:[])
+        value = begin
+          source[key.to_s]
+        rescue StandardError
+          nil
+        end
+        value = begin
+          source[key.to_sym]
+        rescue StandardError
+          nil
+        end if value.nil?
+        return value unless value.nil?
+      end
+
+      if source.respond_to?(key)
+        source.public_send(key)
+      end
+    rescue StandardError
+      nil
+    end
+end
