+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+  alias_method :cards_used, :card_count
+
+  def card_limit
+    return nil if comped?
+    Plan.find(plan).card_limit
+  end
+
+  def cards_unlimited?
+    card_limit.nil?
+  end
+  alias_method :unlimited_cards?, :cards_unlimited?
+
+  def cards_limit
+    card_limit
+  end
+  alias_method :max_cards, :card_limit
+
+  def cards_remaining
+    return nil if card_limit.nil?
+    [ card_limit - card_count, 0 ].max
+  end
+  alias_method :remaining_cards, :cards_remaining
+  alias_method :cards_left, :cards_remaining
+  alias_method :card_limit_remaining, :cards_remaining
+  alias_method :cards_left_until_limit, :cards_remaining
+
+  def out_of_cards?
+    card_limit.present? && card_count >= card_limit
+  end
+  alias_method :at_card_limit?, :out_of_cards?
+  alias_method :card_limit_reached?, :out_of_cards?
+  alias_method :exceeding_card_limit?, :out_of_cards?
+  alias_method :card_limit_exceeded?, :out_of_cards?
+  alias_method :over_card_limit?, :out_of_cards?
+  alias_method :card_limit_hit?, :out_of_cards?
+
+  def within_card_limit?
+    !out_of_cards?
+  end
+  alias_method :can_create_cards?, :within_card_limit?
+
+  def nearing_card_limit?
+    card_limit.present? && !out_of_cards? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+  alias_method :near_card_limit?, :nearing_card_limit?
+  alias_method :card_limit_warning?, :nearing_card_limit?
+end
