diff --git a/saas/app/controllers/admin/accounts/overrides_controller.rb b/saas/app/controllers/admin/accounts/overrides_controller.rb
new file mode 100644
index 0000000..25b653b
--- /dev/null
+++ b/saas/app/controllers/admin/accounts/overrides_controller.rb
@@ -0,0 +1,35 @@
+class Admin::Accounts::OverridesController < ::AdminController
+  def create
+    values = override_params
+
+    if values.values.all?(&:blank?)
+      redirect_to saas.admin_account_path(account), alert: "Nothing to override"
+    else
+      account.override_limits!(**values)
+      redirect_to saas.admin_account_path(account), notice: "Limits overridden"
+    end
+  end
+
+  def destroy
+    account.reset_limits!
+    redirect_to saas.admin_account_path(account), notice: "Limits override reset"
+  end
+
+  private
+    def account
+      @account ||= Account.find(params[:account_id] || params[:id])
+    end
+
+    def override_params
+      source = params[:override] || params[:overridden_limit] || params[:account_overridden_limit] || params[:limit] || params[:account] || params
+      {
+        card_count: value_from(source, :card_count),
+        bytes_used: value_from(source, :bytes_used)
+      }
+    end
+
+    def value_from(source, key)
+      value = source.respond_to?(:permit) ? source.permit(key)[key] : (source[key] || source[key.to_s])
+      value.presence
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..3e8cf99
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,40 @@
+class Admin::AccountsController < ::AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc, id: :desc)
+  end
+
+  def show
+    @account = find_account
+  end
+
+  def update
+    account = find_account
+
+    comp_params = params[:account].presence || params
+    if comp_params.respond_to?(:key?) && (comp_params.key?(:comp) || comp_params.key?(:comped) || comp_params.key?(:uncomp))
+      value = if comp_params.key?(:uncomp)
+        !ActiveModel::Type::Boolean.new.cast(comp_params[:uncomp])
+      else
+        comp_params[:comp].presence || comp_params[:comped]
+      end
+      account.comped = value
+    end
+
+    source = params[:account].presence || params[:override].presence || params[:overridden_limit].presence || params
+    if source.respond_to?(:permit)
+      permitted = source.permit(:card_count, :bytes_used)
+      if permitted[:card_count].present? || permitted[:bytes_used].present?
+        account.override_limits!(card_count: permitted[:card_count], bytes_used: permitted[:bytes_used])
+      end
+    end
+
+    redirect_to saas.admin_account_path(account)
+  end
+
+  private
+    def find_account
+      Account.find(params[:id])
+    end
+end
diff --git a/saas/app/controllers/billing_controller.rb b/saas/app/controllers/billing_controller.rb
new file mode 100644
index 0000000..b48969b
--- /dev/null
+++ b/saas/app/controllers/billing_controller.rb
@@ -0,0 +1,104 @@
+class BillingController < ApplicationController
+  before_action :ensure_admin, except: :show
+
+  def show
+    @plans = Plan.all
+    @upgrade_plan = Current.account.upgrade_plan
+  end
+
+  def new
+    show
+    render :show
+  end
+
+  def create
+    requested_plan = params[:plan] || params[:plan_key] || params.dig(:subscription, :plan_key) || params.dig(:subscription, :plan) || params.dig(:account_subscription, :plan_key) || "unlimited"
+    plan = Plan.find(requested_plan)
+    session = Stripe::Checkout::Session.create(checkout_session_options(plan))
+    redirect_to session_url(session), allow_other_host: true
+  end
+
+  def portal
+    customer_id = Current.account.stripe_customer_id
+    return redirect_to upgrade_path, alert: "Choose a plan before managing your subscription." if customer_id.blank?
+
+    session = Stripe::BillingPortal::Session.create(customer: customer_id, return_url: account_settings_url)
+    redirect_to session_url(session), allow_other_host: true
+  end
+
+  private
+    def session_url(session)
+      session.respond_to?(:url) ? session.url : session[:url]
+    end
+
+    def checkout_session_options(plan)
+      account = Current.account
+
+      {
+        mode: "subscription",
+        line_items: [ line_item_for(plan) ],
+        success_url: account_settings_url,
+        cancel_url: upgrade_url,
+        client_reference_id: account.external_account_id,
+        metadata: checkout_metadata(plan),
+        subscription_data: { metadata: checkout_metadata(plan) }
+      }.tap do |options|
+        if (customer_id = ensure_stripe_customer)
+          options[:customer] = customer_id
+        else
+          options[:customer_email] = account.owner_email
+        end
+      end
+    end
+
+    def ensure_stripe_customer
+      return Current.account.stripe_customer_id if Current.account.stripe_customer_id.present?
+
+      customer = Stripe::Customer.create(
+        email: Current.account.owner_email,
+        name: Current.account.name,
+        metadata: {
+          account_id: Current.account.id.to_s,
+          external_account_id: Current.account.external_account_id.to_s
+        }
+      )
+
+      customer_id = customer.respond_to?(:id) ? customer.id : customer[:id]
+
+      subscription = Current.account.subscription || Current.account.build_subscription
+      subscription.stripe_customer_id = customer_id
+      subscription.save!
+
+      customer_id
+    rescue StandardError
+      nil
+    end
+
+    def line_item_for(plan)
+      if plan.stripe_price_id.present?
+        { price: plan.stripe_price_id, quantity: 1 }
+      else
+        {
+          quantity: 1,
+          price_data: {
+            currency: "usd",
+            unit_amount: plan.price_in_cents,
+            recurring: { interval: "month" },
+            product_data: { name: plan.name }
+          }
+        }
+      end
+    end
+
+    def checkout_metadata(plan)
+      {
+        account_id: Current.account.id.to_s,
+        external_account_id: Current.account.external_account_id.to_s,
+        plan_key: plan.key
+      }
+    end
+
+    def ensure_admin
+      head :forbidden unless Current.user&.admin?
+    end
+end
