diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..234a8d0 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,59 @@
 module TimeHelper
+  # Renders a timestamp as a <time> element that is formatted in the browser,
+  # using the viewer's own timezone. The server only sends the raw ISO timestamp.
+  def local_time(time, format = nil, **options, &block)
+    format = options.delete(:format) || format || :relative
+    format = format.to_s.tr("_", "-")
+    timestamp = time.to_time.utc.iso8601
+    data = options.delete(:data) || {}
+    content = block ? capture(&block) : timestamp
+
+    tag.time content,
+      class: class_names("local-time-value", options.delete(:class)),
+      datetime: timestamp,
+      data: {
+        controller: "local-time",
+        action: "turbo:morph-element->local-time#render",
+        local_time: format,
+        local_time_format_value: format,
+        local_time_format: format,
+        **data
+      },
+      **options
+  end
+
+  alias_method :local_time_tag, :local_time
+
+  def local_date(time, **options)
+    local_time(time, :date, **options)
+  end
+
+  def local_short_date(time, **options)
+    local_date(time, **options)
+  end
+
+  def local_full_date(time, **options)
+    local_time(time, :full_date, **options)
+  end
+
+  def local_weekday(time, **options)
+    local_time(time, :weekday, **options)
+  end
+
+  def local_weekday_or_date(time, **options)
+    local_weekday(time, **options)
+  end
+
+  def local_datetime(time, **options)
+    local_time(time, :datetime, **options)
+  end
+
+  def local_time_ago(time, **options)
+    local_time(time, :relative, **options)
+  end
+
+  alias_method :time_ago_tag, :local_time_ago
+  alias_method :time_ago, :local_time_ago
+  alias_method :local_relative_time, :local_time_ago
+  alias_method :local_time_or_date, :local_time_ago
 end
