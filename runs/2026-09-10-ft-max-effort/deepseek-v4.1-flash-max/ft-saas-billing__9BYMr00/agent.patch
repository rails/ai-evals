diff --git a/saas/app/models/account_subscription.rb b/saas/app/models/account_subscription.rb
new file mode 100644
index 0000000..09449af
--- /dev/null
+++ b/saas/app/models/account_subscription.rb
@@ -0,0 +1,230 @@
+class AccountSubscription < SaasRecord
+  belongs_to :account
+
+  scope :active, -> { where("status IS NULL OR status IN (?)", [ "", "active", "trialing", "past_due" ]) }
+
+  class << self
+    def for_stripe_subscription(stripe_subscription_id:)
+      find_by(stripe_subscription_id: stripe_subscription_id) if stripe_subscription_id.present?
+    end
+
+    def for_stripe_customer(stripe_customer_id:)
+      find_by(stripe_customer_id: stripe_customer_id) if stripe_customer_id.present?
+    end
+
+    def from_price_id(price_id)
+      plan = Subscription.for_price_id(price_id)
+      plan&.short_name
+    end
+
+    # Records the local side of a completed Stripe Checkout Session. The
+    # subscription will usually arrive via customer.subscription.* shortly
+    # after, but recording it here lets the customer use the app immediately.
+    def record_checkout_session(session)
+      object = normalize_hash(session)
+      account = find_account(object)
+      customer_id = id_from(object["customer"])
+
+      if object["subscription"].is_a?(Hash)
+        subscription = object["subscription"]
+        subscription["metadata"] ||= object["metadata"] if object["metadata"].present?
+        return record_stripe_subscription(subscription)
+      end
+
+      subscription_id = id_from(object["subscription"])
+      return if account.nil? && customer_id.blank? && subscription_id.blank?
+
+      if plan_key_from(object).blank? && subscription_id.present? && ENV["STRIPE_SECRET_KEY"].present?
+        begin
+          stripe_subscription = Stripe::Subscription.retrieve(subscription_id)
+          return record_stripe_subscription(stripe_subscription) if stripe_subscription
+        rescue Stripe::StripeError, NameError
+          # Fall through to recording what we know from the session.
+        end
+      end
+
+      record = find_record(account: account, customer_id: customer_id, subscription_id: subscription_id) ||
+        new(stripe_customer_id: customer_id, stripe_subscription_id: subscription_id)
+      record.account ||= account
+      record.stripe_customer_id ||= customer_id
+      record.stripe_subscription_id ||= subscription_id
+      record.plan_key = plan_key_from(object) if plan_key_from(object).present?
+      record.status = "active" if record.status.blank?
+      record.save! if record.account.present? && record.stripe_customer_id.present?
+      record
+    end
+
+    def record_stripe_subscription(subscription, event_type: nil)
+      object = normalize_hash(subscription)
+      account = find_account(object)
+      customer_id = id_from(object["customer"])
+      subscription_id = id_from(object["id"])
+      status = object["status"].presence
+      status ||= "canceled" if event_type.to_s == "customer.subscription.deleted"
+      status ||= "paused" if event_type.to_s == "customer.subscription.paused"
+
+      record = find_record(account: account, customer_id: customer_id, subscription_id: subscription_id) ||
+        new(stripe_customer_id: customer_id, stripe_subscription_id: subscription_id)
+      record.account ||= account if account
+      record.stripe_customer_id ||= customer_id
+      record.stripe_subscription_id ||= subscription_id
+      record.status = status if status.present?
+      record.plan_key = plan_key_from(object) if plan_key_from(object).present?
+      record.current_period_end = timestamp_at(object["current_period_end"]) if object.key?("current_period_end")
+      record.cancel_at = timestamp_at(object["cancel_at"]) if object.key?("cancel_at")
+      record.next_amount_due_in_cents = amount_due_from(object) if amount_due_from(object)
+      record.save! if record.account.present? && record.stripe_customer_id.present?
+      record
+    end
+
+    def record_stripe_invoice(invoice, event_type: nil)
+      object = normalize_hash(invoice)
+      subscription_id = id_from(object["subscription"])
+      customer_id = id_from(object["customer"])
+      record = find_record(customer_id: customer_id, subscription_id: subscription_id)
+      return unless record
+
+      record.stripe_customer_id ||= customer_id
+      record.stripe_subscription_id ||= subscription_id
+      if (amount = amount_due_from(object))
+        record.next_amount_due_in_cents = amount
+      end
+      if event_type.to_s == "invoice.payment_failed" || (object["status"] == "open" && object["attempted"])
+        record.status = "past_due"
+      elsif event_type.to_s.in?(%w[ invoice.paid invoice.payment_succeeded ])
+        record.status = "active" unless record.status == "canceled"
+      end
+      record.save!
+      record
+    end
+
+    private
+      def normalize_hash(value)
+        return {} if value.blank?
+
+        value = value.to_hash if value.respond_to?(:to_hash)
+        value = value.to_unsafe_h if value.respond_to?(:to_unsafe_h)
+        value.stringify_keys
+      end
+
+      def find_account(object)
+        metadata = object["metadata"].is_a?(Hash) ? object["metadata"] : {}
+        ids = [
+          metadata["account_id"],
+          metadata["account"],
+          metadata["queenbee_id"],
+          metadata["external_account_id"],
+          object["client_reference_id"]
+        ].compact_blank
+
+        ids.each do |id|
+          account = Account.find_by(id: id) || Account.find_by(external_account_id: id)
+          return account if account
+        end
+
+        customer_id = id_from(object["customer"])
+        subscription_id = id_from(object["subscription"])
+        find_record(customer_id: customer_id, subscription_id: subscription_id)&.account
+      end
+
+      def find_record(account: nil, customer_id: nil, subscription_id: nil)
+        record = nil
+        record = for_stripe_subscription(stripe_subscription_id: subscription_id) if subscription_id.present?
+        record ||= for_stripe_customer(stripe_customer_id: customer_id) if customer_id.present?
+        record ||= account.account_subscription if account.respond_to?(:account_subscription)
+        record
+      end
+
+      def id_from(value)
+        case value
+        when Hash
+          value["id"] || value[:id]
+        else
+          value.respond_to?(:id) ? value.id : value
+        end
+      end
+
+      def plan_key_from(object)
+        metadata = object["metadata"].is_a?(Hash) ? object["metadata"] : {}
+        explicit = metadata["plan_key"].presence || metadata["plan"].presence || object["plan_key"].presence
+        return canonical_key(explicit) if explicit.present?
+
+        price_id = price_id_from(object)
+        canonical_key(Subscription.for_price_id(price_id)&.short_name) || price_id
+      end
+
+      def canonical_key(key)
+        Subscription.lookup(key)&.short_name
+      end
+
+      def price_id_from(object)
+        object.dig("items", "data", 0, "price", "id") ||
+          object.dig("lines", "data", 0, "price", "id") ||
+          object.dig("plan", "id") ||
+          object.dig("price", "id")
+      end
+
+      def timestamp_at(value)
+        return nil if value.blank?
+
+        Time.zone.at(Integer(value))
+      rescue ArgumentError, TypeError
+        nil
+      end
+
+      def amount_due_from(object)
+        value = object["amount_due"] || object["amount_paid"] || object["next_amount_due_in_cents"]
+        value.to_i if value.present?
+      end
+  end
+
+  def plan
+    Subscription.lookup(plan_key) || Subscription::FreeV1
+  end
+
+  def plan=(plan)
+    self.plan_key = plan.respond_to?(:short_name) ? plan.short_name : plan.to_s
+  end
+
+  def canceled?
+    status.to_s.in?(%w[ canceled cancelled ])
+  end
+
+  alias cancelled? canceled?
+
+def plan_class
+  plan
+end
+
+def card_limit
+  plan.card_limit
+end
+
+def storage_limit
+  plan.storage_limit
+end
+
+  def plan_name
+    plan.proper_name
+  end
+
+  def plan_label
+    plan_name
+  end
+
+  def active?
+    status.blank? || status.to_s.in?(%w[ active trialing past_due ])
+  end
+
+  def paid?
+    active? && !plan.free?
+  end
+
+  def free?
+    !paid?
+  end
+
+  def current_period_end_at
+    current_period_end
+  end
+end
