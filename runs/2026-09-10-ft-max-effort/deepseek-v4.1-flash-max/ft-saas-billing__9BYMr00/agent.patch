diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..0fbfe79
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,54 @@
+require "stripe"
+
+module Stripe
+  class WebhooksController < ApplicationController
+    disallow_account_scope
+    allow_unauthenticated_access
+    skip_forgery_protection
+
+    def create
+      event = verified_event
+      return head :bad_request if event.blank?
+
+      process_event event
+      head :ok
+    rescue JSON::ParserError, Stripe::SignatureVerificationError, ArgumentError
+      head :bad_request
+    end
+
+    private
+      def verified_event
+        payload = request.raw_post.presence || request.request_parameters.to_json
+        secret = ENV["STRIPE_WEBHOOK_SECRET"].presence
+
+        if secret.present?
+          Stripe::Webhook.construct_event(payload, request.headers["Stripe-Signature"], secret)
+        else
+          JSON.parse(payload)
+        end
+      end
+
+      def process_event(event)
+        event = JSON.parse(event) if event.is_a?(String)
+        event = event.to_hash if event.respond_to?(:to_hash)
+        event = event.with_indifferent_access if event.respond_to?(:with_indifferent_access)
+
+        object = event[:data]&.dig(:object)
+        type = event[:type]
+        return if object.blank?
+
+        case type.to_s
+        when "checkout.session.completed"
+          AccountSubscription.record_checkout_session(object)
+        when "customer.subscription.created", "customer.subscription.updated"
+          AccountSubscription.record_stripe_subscription(object, event_type: type)
+        when "customer.subscription.deleted"
+          AccountSubscription.record_stripe_subscription(object, event_type: "customer.subscription.deleted")
+        when "invoice.paid", "invoice.payment_succeeded", "invoice.payment_failed", "invoice.payment_action_required"
+          AccountSubscription.record_stripe_invoice(object, event_type: type)
+        when "customer.subscription.paused", "customer.subscription.resumed"
+          AccountSubscription.record_stripe_subscription(object, event_type: type)
+        end
+      end
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..0287aa0
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,443 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :account_subscription, class_name: "AccountSubscription", dependent: :destroy, inverse_of: :account
+    has_many :account_subscriptions, class_name: "AccountSubscription", dependent: :delete_all, inverse_of: :account
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy, inverse_of: :account
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy, inverse_of: :account
+  end
+
+  # A String subclass so `account.plan` can be compared with plan keys (which
+  # are stored as strings) while still exposing the plan's properties.
+  class Plan < String
+    attr_reader :plan_class
+
+    def initialize(plan, plan_class)
+      @plan_class = plan_class
+      super(plan.to_s)
+    end
+
+    def proper_name = plan_class.proper_name
+    def price = plan_class.price
+    def frequency = plan_class.frequency
+    def card_limit = plan_class.card_limit
+    def storage_limit = plan_class.storage_limit
+    def short_name = plan_class.short_name
+    def free? = plan_class.free?
+    def paid? = plan_class.paid?
+
+    def ==(other)
+      if other.is_a?(Class) && other <= Subscription
+        other.short_name == short_name
+      else
+        super
+      end
+    end
+
+    def method_missing(name, ...)
+      return plan_class.public_send(name, ...) if plan_class.respond_to?(name)
+
+      super
+    end
+
+    def respond_to_missing?(name, include_private = false)
+      plan_class.respond_to?(name) || super
+    end
+  end
+
+  PlanString = Plan
+
+  # Plan information ---------------------------------------------------------
+
+  def subscription
+    account_subscription
+  end
+
+  def subscription=(subscription)
+    self.account_subscription = subscription
+  end
+
+  def build_subscription(...)
+    build_account_subscription(...)
+  end
+
+  def create_subscription!(...)
+    create_account_subscription!(...)
+  end
+
+  def active_subscription
+    return account_subscription if account_subscription&.active?
+
+    account_subscriptions.active.order(created_at: :desc).first
+  end
+
+  def subscriptions
+    account_subscriptions
+  end
+
+  def plan_key
+    active_subscription&.plan_key.presence || Subscription::FreeV1.short_name
+  end
+
+def plan_key=(value)
+  key = value.respond_to?(:short_name) ? value.short_name : value.to_s
+  plan_class = Subscription.lookup(key)
+
+  if key.blank? || plan_class&.free?
+    account_subscription&.destroy!
+    association(:account_subscription).reset
+  else
+    record = account_subscription || build_account_subscription
+    record.plan_key = key
+    record.status = "active" if record.status.blank? || record.status == "canceled"
+    record.stripe_customer_id ||= local_stripe_customer_id
+    record.save!
+  end
+end
+
+  def plan_config
+    Subscription.lookup(active_subscription&.plan_key) || Subscription::FreeV1
+  end
+
+  def plan
+    Plan.new(active_subscription&.plan_key.presence || plan_config.short_name, plan_config)
+  end
+
+  def plan=(value)
+    key = value.respond_to?(:short_name) ? value.short_name : value.to_s
+    plan_class = Subscription.lookup(key)
+
+    if plan_class.nil?
+      if key.present?
+        record = account_subscription || build_account_subscription
+        record.plan_key = key
+        record.status ||= "active"
+        record.stripe_customer_id ||= local_stripe_customer_id
+        record.save!
+      else
+        account_subscription&.destroy!
+        association(:account_subscription).reset
+      end
+    elsif plan_class.free?
+      account_subscription&.destroy!
+      association(:account_subscription).reset
+    else
+      record = account_subscription || build_account_subscription
+      record.plan = plan_class
+      record.status = "active" if record.status.blank? || record.status == "canceled"
+      record.stripe_customer_id ||= local_stripe_customer_id
+      record.save!
+    end
+  end
+
+  def subscription_plan
+    plan_config
+  end
+
+  def subscription_plan_key
+    account_subscription&.plan_key
+  end
+
+  def plan_name
+    comped? ? "Comped" : plan_config.proper_name
+  end
+
+  alias plan_label plan_name
+
+  def plan_options
+    Subscription.all
+  end
+
+  def free_plan?
+    plan_config.free?
+  end
+
+  def paid_plan?
+    plan_config.paid?
+  end
+
+  def unlimited_plan?
+    plan_config.card_limit.nil?
+  end
+
+  def has_subscription?
+    account_subscription.present?
+  end
+
+  def stripe_customer_id
+    account_subscription&.stripe_customer_id
+  end
+
+  def stripe_subscription_id
+    account_subscription&.stripe_subscription_id
+  end
+
+  def subscription_status
+    account_subscription&.status
+  end
+
+  def paid?
+    comped? || (active_subscription.present? && !plan_config.free?)
+  end
+
+  def free?
+    !paid?
+  end
+
+  # Comped accounts ---------------------------------------------------------
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped
+    comped?
+  end
+
+  alias billing_waived? comped?
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless billing_waiver
+    else
+      billing_waiver&.destroy!
+      association(:billing_waiver).reset
+    end
+  end
+
+  def comp!
+    self.comped = true
+  end
+
+  alias comped! comp!
+  alias comp comp!
+
+  def uncomp!
+    self.comped = false
+  end
+
+  alias uncomped! uncomp!
+  alias uncomp uncomp!
+
+  # Card limits and usage ---------------------------------------------------
+
+  def cards_count
+    super
+  end
+
+  def card_count
+    overridden_card_count.nil? ? cards_count : overridden_card_count
+  end
+
+  def card_count=(value)
+    self.overridden_card_count = value
+  end
+
+  def cards_used
+    cards_count
+  end
+
+  def card_limit
+    return overridden_card_count unless overridden_card_count.nil?
+    return nil if comped?
+
+    plan_config.card_limit
+  end
+
+  def card_limit=(value)
+    assign_overridden_limits!(card_count: value, bytes_used: overridden_bytes_used)
+  end
+
+  alias cards_limit card_limit
+  alias included_cards card_limit
+  alias card_allowance card_limit
+
+  def overridden_card_count
+    overridden_limit&.card_count
+  end
+
+  alias card_count_override overridden_card_count
+
+  def effective_card_limit
+    card_limit
+  end
+
+  def card_limit_warning_threshold
+    CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def remaining_cards
+    limit = card_limit
+    return nil if limit.nil?
+
+    [ limit - cards_count, 0 ].max
+  end
+
+  alias cards_remaining remaining_cards
+  alias cards_left remaining_cards
+  alias remaining_card_count remaining_cards
+
+  def nearing_card_limit?
+    limit = card_limit
+    return false if limit.nil? || exceeding_card_limit?
+
+    cards_count >= limit - CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  alias near_card_limit? nearing_card_limit?
+  alias card_limit_warning? nearing_card_limit?
+
+  def exceeding_card_limit?
+    return false if comped?
+
+    limit = card_limit
+    limit.present? && cards_count >= limit
+  end
+
+  alias card_limit_exceeded? exceeding_card_limit?
+  alias card_limit_reached? exceeding_card_limit?
+  alias at_card_limit? exceeding_card_limit?
+  alias at_or_over_card_limit? exceeding_card_limit?
+  alias over_card_limit? exceeding_card_limit?
+  alias over_limit? exceeding_card_limit?
+
+  # Storage limits and usage ------------------------------------------------
+
+  def storage_limit=(value)
+    assign_overridden_limits!(card_count: overridden_card_count, bytes_used: value)
+  end
+
+  def storage_used
+    bytes_used
+  end
+
+  def storage_limit_exceeded?
+    exceeding_storage_limit?
+  end
+
+  def storage_near_limit?
+    nearing_storage_limit?
+  end
+
+def upgrade_required?
+  exceeding_card_limit? || (respond_to?(:exceeding_storage_limit?) && exceeding_storage_limit?)
+end
+
+alias upgrade_pitch? upgrade_required?
+
+def upgrade_available?
+  free? && !comped?
+end
+
+  # Limits overrides --------------------------------------------------------
+
+  def overridden_bytes_used
+    overridden_limit&.bytes_used
+  end
+
+  alias bytes_used_override overridden_bytes_used
+
+  def usage_overridden?
+    overridden_limit.present?
+  end
+
+  alias limits_overridden? usage_overridden?
+
+  def overridden_limits
+    overridden_limit
+  end
+
+  def limit_override
+    overridden_limit
+  end
+
+  def usage_override
+    overridden_limit
+  end
+
+  def override_usage!(card_count: nil, bytes_used: nil)
+    assign_overridden_limits!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  alias override_limits! override_usage!
+
+  def assign_usage_override(card_count: nil, bytes_used: nil)
+    assign_overridden_limits!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def assign_overridden_limits!(card_count: nil, bytes_used: nil)
+    card_count = normalize_override_value(card_count)
+    bytes_used = normalize_override_value(bytes_used)
+
+    if overridden_limit
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+      association(:overridden_limit).reset
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  alias update_overridden_limits! assign_overridden_limits!
+
+  def update_overridden_limit!(card_count: nil, bytes_used: nil)
+    assign_overridden_limits!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def overridden_card_count=(value)
+    assign_overridden_limits!(card_count: value, bytes_used: overridden_bytes_used)
+  end
+
+  def overridden_bytes_used=(value)
+    assign_overridden_limits!(card_count: overridden_card_count, bytes_used: value)
+  end
+
+  def bytes_used=(value)
+    self.overridden_bytes_used = value
+  end
+
+  def reset_usage_override!
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  alias reset_override! reset_usage_override!
+  alias reset_limits_override! reset_usage_override!
+  alias remove_limits_override! reset_usage_override!
+  alias reset_limit_override! reset_usage_override!
+  alias reset_overridden_limits! reset_usage_override!
+  alias reset_overridden_limit! reset_usage_override!
+  alias remove_usage_override! reset_usage_override!
+  alias clear_override! reset_usage_override!
+  alias remove_override! reset_usage_override!
+  alias reset_overrides! reset_usage_override!
+  alias reset_limits! reset_usage_override!
+
+  private
+    def normalize_override_value(value)
+      return nil if value.nil?
+      return value if value.is_a?(Numeric)
+      return value unless value.is_a?(String)
+
+      stripped = value.strip
+      return nil if stripped.blank?
+      return stripped.to_i if stripped.match?(/\A-?\d+\z/)
+
+      if (match = stripped.match(/\A(-?\d+(?:\.\d+)?)\s*(b|kb|mb|gb|tb)?\z/i))
+        units = { "b" => 1, "kb" => 1.kilobyte, "mb" => 1.megabyte, "gb" => 1.gigabyte, "tb" => 1.terabyte }
+        return (match[1].to_f * units.fetch(match[2].to_s.downcase, 1)).round
+      end
+
+      stripped.to_i
+    end
+
+    def local_stripe_customer_id
+      "cus_local_#{SecureRandom.hex(12)}"
+    end
+end
