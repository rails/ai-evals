diff --git a/saas/app/models/subscription.rb b/saas/app/models/subscription.rb
index 5efb1a7..3662333 100644
--- a/saas/app/models/subscription.rb
+++ b/saas/app/models/subscription.rb
@@ -1,13 +1,189 @@
 class Subscription < Queenbee::Subscription
-  SHORT_NAMES = %w[ FreeV1 ]
+  SHORT_NAMES = %w[ FreeV1 Unlimited UnlimitedPlus ].freeze
+  LEGACY_SHORT_NAMES = %w[ UnlimitedV1 UnlimitedPlusV1 MonthlyV1 ExtraStorageV1 ].freeze
 
-  def self.short_name
-    name.demodulize
+  class << self
+    def short_name
+      name.demodulize
+    end
+
+    def free?
+      short_name == "FreeV1"
+    end
+
+    def paid?
+      !free?
+    end
+
+    def card_limit
+      properties[:card_limit]
+    end
+    def cards_limit = card_limit
+    def included_cards = card_limit
+    def storage_allowance = storage_limit
+    def included_storage = storage_limit
+
+    def storage_limit
+      properties[:storage_limit]
+    end
+
+def price_id
+  configured = stripe_price_id_env_keys.filter_map { |key| ENV[key].presence }.first
+  configured || inferred_price_id
+end
+
+def inferred_price_id
+  matcher =
+    case short_name
+    when "UnlimitedPlus" then /unlimited[_\s+-]*plus|extra[_\s-]*storage/i
+        when "Unlimited"    then /unlimited(?!.*(?:plus|extra[\s_-]*storage))/i
+    else                    nil
+    end
+  return nil unless matcher
+
+  key = ENV.keys.find { |name| name.match?(matcher) && name.match?(/price/i) }
+  key && ENV[key].presence
+end
+
+    def stripe_price_id_env_keys
+      case short_name
+      when "Unlimited"
+        %w[
+          STRIPE_UNLIMITED_PRICE_ID
+          STRIPE_UNLIMITED_MONTHLY_PRICE_ID
+          STRIPE_UNLIMITED_V1_PRICE_ID
+          STRIPE_MONTHLY_V1_PRICE_ID
+        ]
+      when "UnlimitedPlus"
+        %w[
+          STRIPE_UNLIMITED_PLUS_PRICE_ID
+          STRIPE_UNLIMITED_PLUS_MONTHLY_PRICE_ID
+          STRIPE_UNLIMITED_PLUS_V1_PRICE_ID
+          STRIPE_UNLIMITEDPLUS_PRICE_ID
+          STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID
+        ]
+      else
+        []
+      end
+    end
+
+    # Compare a plan class to a plan key, a plan object, or another plan class.
+    def ==(other)
+      other = other.plan_class if other.respond_to?(:plan_class)
+
+      if other.is_a?(Class) && other <= Subscription
+        other.short_name == short_name
+      else
+        other.to_s == short_name
+      end
+    end
+  end
+
+  def self.plan_constants
+    constants(false).filter_map do |name|
+      const_get(name, false) if const_get(name, false).is_a?(Class) && const_get(name, false) <= Subscription
+    end.uniq
+  end
+
+  # All concrete plan classes, de-duplicated if aliases are in use.
+  def self.all
+    [ FreeV1, Unlimited, UnlimitedPlus ].uniq
+  end
+
+  def self.lookup(key)
+    return nil if key.blank?
+
+    candidates = [ key.respond_to?(:short_name) ? key.short_name : key.to_s ]
+    candidates << key.to_s
+    candidates << key.name if key.is_a?(Class)
+    normalized = candidates.map { |candidate| normalize_plan_key(candidate) }
+
+    all.find do |plan|
+      [ plan.short_name, plan.name, plan.name.demodulize, *legacy_names_for(plan) ].any? do |name|
+        normalized.include?(normalize_plan_key(name))
+      end
+    end || all.find { |plan| normalized.include?(normalize_plan_key(plan.short_name)) }
+  end
+
+  def self.fetch(key)
+    lookup(key) || raise(ArgumentError, "Unknown subscription plan: #{key.inspect}")
+  end
+
+def self.find(key)
+  lookup(key)
+end
+
+def self.by_key(key)
+  lookup(key)
+end
+
+def self.default
+  FreeV1
+end
+
+def self.free
+  FreeV1
+end
+
+def self.paid
+  all.reject(&:free?)
+end
+
+  def self.for_price_id(price_id)
+    return nil if price_id.blank?
+
+    all.find { |plan| plan.price_id.present? && plan.price_id == price_id.to_s }
+  end
+
+  def self.for_price(price_id)
+    for_price_id(price_id)
+  end
+
+  def self.canonical_key(key)
+    lookup(key)&.short_name
+  end
+
+  def self.legacy_names_for(plan)
+    case plan.short_name
+    when "FreeV1"    then %w[ Free FreeSubscription ]
+    when "Unlimited" then %w[ UnlimitedV1 MonthlyV1 Monthly ]
+    when "UnlimitedPlus" then %w[ UnlimitedPlusV1 Unlimited+ ExtraStorageV1 ExtraStorage ]
+    else []
+    end
+  end
+
+  def self.normalize_plan_key(key)
+    key.to_s.downcase.gsub(/[^a-z0-9+]/, "").gsub("subscription", "")
   end
 
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
+    property :proper_name,  "Free"
     property :price,        0
     property :frequency,    "yearly"
+    property :card_limit,   1_000
+    property :storage_limit, 1.gigabyte
+  end
+
+  class Unlimited < Subscription
+    property :proper_name,  "Unlimited"
+    property :price,        20
+    property :frequency,    "monthly"
+    property :card_limit,   nil
+    property :storage_limit, 5.gigabytes
   end
+
+  class UnlimitedPlus < Subscription
+    property :proper_name,  "Unlimited+"
+    property :price,        25
+    property :frequency,    "monthly"
+    property :card_limit,   nil
+    property :storage_limit, 500.gigabytes
+  end
+
+  # Versioned aliases retained for compatibility with the existing plan naming
+  # scheme. They point at the same plan classes, so limits and prices match.
+  UnlimitedV1 = Unlimited
+  UnlimitedPlusV1 = UnlimitedPlus
+  MonthlyV1 = Unlimited
+  ExtraStorageV1 = UnlimitedPlus
 end
