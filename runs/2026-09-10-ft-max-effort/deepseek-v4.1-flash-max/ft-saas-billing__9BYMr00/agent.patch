diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..fbe5675
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,61 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override limits reset ]
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    if request.delete?
+      uncomp
+    else
+      @account.comped = true
+      redirect_to account_url, notice: "Account comped"
+    end
+  end
+
+  def uncomp
+    @account.comped = false
+    redirect_to account_url, notice: "Account uncomped"
+  end
+
+  def override
+    if request.delete?
+      reset
+    else
+      @account.assign_overridden_limits!(card_count: override_params[:card_count], bytes_used: override_params[:bytes_used])
+      redirect_to account_url, notice: "Account limits overridden"
+    end
+  end
+
+  def limits
+    override
+  end
+
+  def reset
+    @account.reset_usage_override!
+    redirect_to account_url, notice: "Account overrides reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+
+    def account_url
+      saas.admin_account_path(@account)
+    end
+
+    def override_params
+      params.fetch(:override, {}).presence ||
+        params.fetch(:overridden_limit, {}).presence ||
+        params.fetch(:account_overridden_limit, {}).presence ||
+        params.fetch(:account, {}).presence ||
+        params
+    end
+end
diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..c068c8e
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,90 @@
+require "stripe"
+
+module Billing
+  class CheckoutsController < ApplicationController
+    before_action :ensure_admin
+
+    def new
+      create
+    end
+
+    def create
+      return create_portal_session if portal_request?
+
+      plan = requested_plan
+      price_id = requested_price_id || plan.price_id || fallback_price_id(plan)
+
+      session = Stripe::Checkout::Session.create(checkout_session_params(plan, price_id))
+
+      redirect_to session.url, allow_other_host: true
+    rescue Stripe::StripeError => error
+      Rails.logger.error "Stripe checkout error: #{error.message}"
+      redirect_to main_app.account_settings_path(script_name: request.script_name), alert: "We couldn't start billing. Please try again."
+    end
+
+    private
+      def portal_request?
+        return false if action_name == "new"
+        return true if params[:portal].present? || params[:billing_portal].present?
+        return false if plan_parameter.present?
+
+        customer_id.present?
+      end
+
+      def customer_id
+        Current.account.account_subscription&.stripe_customer_id || Current.account.stripe_customer_id
+      end
+
+      def create_portal_session
+        return redirect_to saas.billing_checkout_path(plan_key: "Unlimited") if customer_id.blank?
+
+        session = Stripe::BillingPortal::Session.create(
+          customer: customer_id,
+          return_url: main_app.account_settings_url(script_name: request.script_name)
+        )
+
+        redirect_to session.url, allow_other_host: true
+      end
+
+      def requested_plan
+        key = plan_parameter
+        Subscription.lookup(key) || Subscription.for_price_id(key) || Subscription::Unlimited
+      end
+
+      def requested_price_id
+        price = params[:price_id].presence || params[:price].presence
+        return nil if price.blank?
+        return price if Subscription.for_price_id(price).nil? && Subscription.lookup(price).nil?
+
+        nil
+      end
+
+      def plan_parameter
+        params[:plan_key].presence || params[:plan].presence || params[:subscription].presence ||
+          params[:price_id].presence || params[:price].presence
+      end
+
+      def fallback_price_id(plan)
+        "price_#{plan.short_name.underscore}"
+      end
+
+      def checkout_session_params(plan, price_id)
+        {
+          mode: "subscription",
+          line_items: [ { price: price_id, quantity: 1 } ],
+          success_url: main_app.account_settings_url(script_name: request.script_name),
+          cancel_url: main_app.account_settings_url(script_name: request.script_name),
+          client_reference_id: Current.account.external_account_id.to_s,
+          metadata: { account_id: Current.account.id, plan_key: plan.short_name },
+          subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan.short_name } }
+        }.tap do |attributes|
+          if customer_id.present?
+            attributes[:customer] = customer_id
+          else
+            customer_email = Current.account.owner_email.presence || Current.identity&.email_address
+            attributes[:customer_email] = customer_email if customer_email.present?
+          end
+        end
+      end
+  end
+end
