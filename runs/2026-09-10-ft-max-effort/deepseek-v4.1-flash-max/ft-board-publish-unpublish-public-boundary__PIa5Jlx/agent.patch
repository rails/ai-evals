diff --git a/app/controllers/public_controller.rb b/app/controllers/public_controller.rb
new file mode 100644
index 0000000..eac3cab
--- /dev/null
+++ b/app/controllers/public_controller.rb
@@ -0,0 +1,24 @@
+class PublicController < ApplicationController
+  layout "public"
+
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  before_action :set_board
+
+  private
+    def set_board
+      @board = find_published_board
+      Current.account = @board.account
+    end
+
+    def find_published_board
+      identifier = params[:board_key].presence || params[:key].presence
+      raise ActiveRecord::RecordNotFound if identifier.blank?
+
+      Board.published.find_by(public_key: identifier) ||
+        Board.published.joins(:publication).find_by(board_publications: { key: identifier }) ||
+        Board.published.find_by(publication_key: identifier) ||
+        raise(ActiveRecord::RecordNotFound)
+    end
+end
