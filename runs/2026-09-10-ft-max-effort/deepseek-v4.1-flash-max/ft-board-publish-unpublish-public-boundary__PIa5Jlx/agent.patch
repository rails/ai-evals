+<% @page_title = @board.name %>
+<% @body_class = "public-board" %>
+
+<section class="public-board">
+  <header class="public-board__header">
+    <h1><%= @board.name %></h1>
+    <p class="txt-small txt-subtle">A published Fizzy board</p>
+  </header>
+
+  <div class="card-columns">
+    <% if @triage_cards.any? %>
+      <section id="maybe" class="cards public-column">
+        <h2>Maybe?</h2>
+        <div class="public-column__cards">
+          <%= render partial: "public/card", collection: @triage_cards, as: :card %>
+        </div>
+      </section>
+    <% end %>
+
+    <% if @other_cards.any? %>
+      <section class="cards public-column">
+        <h2>Not Now &amp; Done</h2>
+        <div class="public-column__cards">
+          <%= render partial: "public/card", collection: @other_cards, as: :card %>
+        </div>
+      </section>
+    <% end %>
+
+    <% @columns.each do |column| %>
+      <% cards = column.cards.published.latest %>
+      <section id="<%= dom_id(column) %>" class="cards public-column">
+        <h2>
+          <%= link_to column.name, public_board_column_path(public_board_route_key(@board), column) %>
+        </h2>
+
+        <div class="public-column__cards">
+          <% if cards.any? %>
+            <%= render partial: "public/card", collection: cards, as: :card %>
+          <% else %>
+            <p class="txt-subtle">No cards here</p>
+          <% end %>
+        </div>
+      </section>
+    <% end %>
+  </div>
+</section>
