+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public board</h2>
+
+    <% if board.published? %>
+      <p>Anyone with the secret public link can view this board.</p>
+
+      <%= tag.code public_board_url(board.public_key, script_name: nil), class: "txt-small overflow-ellipsis" %>
+
+      <%= button_to "Unpublish board", board_publication_path(board), method: :delete, class: "btn btn--negative" %>
+    <% else %>
+      <p>Publish this board to share a read-only view with anyone who has the secret link.</p>
+
+      <%= button_to "Publish board", board_publication_path(board), class: "btn" %>
+    <% end %>
+  </div>
+<% end %>
