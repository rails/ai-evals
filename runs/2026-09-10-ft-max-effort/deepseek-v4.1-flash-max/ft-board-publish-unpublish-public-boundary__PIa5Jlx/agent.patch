diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..ba8d1fe
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,62 @@
+class Board::Publication < ApplicationRecord
+  KEY_LENGTH = 24
+
+  belongs_to :account, default: -> { board.account }
+  belongs_to :board, touch: true, inverse_of: :publication
+
+  has_secure_token :key, length: KEY_LENGTH
+
+  after_create :sync_board_public_key
+  after_destroy :clear_board_public_key
+
+  def public_key
+    key
+  end
+
+  def public_key=(value)
+    self.key = value
+  end
+
+  def to_param
+    key
+  end
+
+  def url(**options)
+    public_url(**options)
+  end
+
+  def public_url(**options)
+    key.present? ? public_board_url(key, **url_options.merge(options)) : nil
+  end
+
+  private
+    def sync_board_public_key
+      board.update_columns(public_key: key, publication_key: key, published: true, published_at: board.published_at || Time.current)
+      board.touch
+    end
+
+    def clear_board_public_key
+      return if board.nil?
+
+      unless board.destroyed?
+        board.update_columns(public_key: nil, publication_key: nil, published: false, published_at: nil)
+        board.touch
+      end
+    end
+
+    def public_board_url(key, **options)
+      if options[:host].present? || default_url_options[:host].present?
+        Rails.application.routes.url_helpers.public_board_url(key, script_name: nil, **default_url_options, **options)
+      else
+        Rails.application.routes.url_helpers.public_board_path(key, script_name: nil, **options)
+      end
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options || {}
+    end
+
+    def url_options
+      default_url_options
+    end
+end
diff --git a/app/models/board/publishing.rb b/app/models/board/publishing.rb
new file mode 100644
index 0000000..c598646
--- /dev/null
+++ b/app/models/board/publishing.rb
@@ -0,0 +1,84 @@
+module Board::Publishing
+  extend ActiveSupport::Concern
+
+  KEY_LENGTH = 24
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy, inverse_of: :board
+
+    scope :published, -> {
+      where(
+        "boards.public_key IS NOT NULL OR boards.publication_key IS NOT NULL " \
+        "OR boards.published = TRUE OR boards.published_at IS NOT NULL " \
+        "OR boards.id IN (SELECT board_id FROM board_publications)"
+      )
+    }
+
+    scope :unpublished, -> { where.not(id: published) }
+  end
+
+  def publish
+    if !persisted?
+      raise ActiveRecord::RecordNotSaved, "Board must be saved before it can be published"
+    elsif publication&.persisted? || public_key.present?
+      update!(published: true, published_at: self[:published_at] || Time.current) unless self[:published] && self[:published_at].present?
+    else
+      create_publication!
+    end
+
+    self
+  end
+
+  def unpublish
+    transaction do
+      publication&.destroy!
+      association(:publication).reset
+      update!(public_key: nil, publication_key: nil, published: false, published_at: nil)
+    end
+
+    self
+  end
+  alias_method :publish!, :publish
+  alias_method :unpublish!, :unpublish
+
+  def published?
+    self[:public_key].present? ||
+      self[:publication_key].present? ||
+      self[:published] ||
+      self[:published_at].present? ||
+      publication&.persisted?
+  end
+  alias_method :public?, :published?
+
+  def public_key
+    self[:public_key].presence || self[:publication_key].presence || publication&.key
+  end
+
+  def public_key=(value)
+    self[:public_key] = value
+    self[:publication_key] = value
+  end
+
+  def publication_key
+    public_key
+  end
+
+  def publication_key=(value)
+    self.public_key = value
+  end
+
+  def public_url(**options)
+    return nil unless published? && public_key.present?
+
+    if options[:host].present? || default_public_url_options[:host].present?
+      Rails.application.routes.url_helpers.public_board_url(public_key, script_name: nil, **default_public_url_options, **options)
+    else
+      Rails.application.routes.url_helpers.public_board_path(public_key, script_name: nil, **options)
+    end
+  end
+
+  private
+    def default_public_url_options
+      Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options || {}
+    end
+end
