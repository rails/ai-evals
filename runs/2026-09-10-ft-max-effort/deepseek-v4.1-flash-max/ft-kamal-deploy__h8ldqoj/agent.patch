@@ -0,0 +1,28 @@
+# Secrets defined here are available for reference under registry/password,
+# env/secret, builder/secrets, and accessories/*/env/secret in config/deploy.yml.
+# All secrets should be pulled from either a password manager, the environment,
+# or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
+
+# Docker Hub access token (or the equivalent password for your registry).
+# Export KAMAL_REGISTRY_PASSWORD in your shell, or fetch it from your password
+# manager, e.g.:
+#
+#   KAMAL_REGISTRY_PASSWORD=$(security find-generic-password -s docker-hub -w)
+#
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Password for the SMTP server configured in config/deploy.yml. Export
+# SMTP_PASSWORD in your shell, or fetch it from your password manager.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# The Rails master key. Optional: create it (and config/credentials.yml.enc,
+# which holds secret_key_base) once with:
+#
+#   bin/rails credentials:edit
+#
+# config/master.key is gitignored and stays on your machine.
+RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || true)
+
+# A stable signing secret for cookies and links. Generated once, then cached
+# in tmp/ (which is gitignored) so redeploying does not invalidate sessions.
+SECRET_KEY_BASE=$(cat tmp/secret_key_base 2>/dev/null || (mkdir -p tmp && bin/rails secret | tee tmp/secret_key_base))
