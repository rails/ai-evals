new file mode 100644
index 0000000..9d9fc6e
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,82 @@
+# Kamal single-server deployment for Fizzy.
+#
+# This runs a complete Fizzy instance on one Linux box: SQLite databases and
+# uploaded files live on a persistent volume, the Rails app and Solid Queue
+# background workers run in the same container, and the Kamal proxy terminates
+# TLS with a Let's Encrypt certificate.
+#
+# To deploy your own instance:
+#
+#   1. Fill in your server, hostname, image/registry, and mail server below.
+#   2. Fill in the secrets in .kamal/secrets.
+#   3. Run bin/kamal setup (and bin/kamal deploy after that).
+#
+# See docs/deployment.md for a full walkthrough.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. Replace "your-dockerhub-username" with the
+# registry user/namespace you'll push to (or change the registry below for
+# GHCR, etc.).
+image: your-dockerhub-username/fizzy
+
+# Deploy to a single server. Replace this with the IP address or hostname of
+# your box. Kamal installs Docker for you during setup if needed.
+servers:
+  web:
+    - 192.168.0.1
+
+# Serve Fizzy over HTTPS. The proxy obtains a Let's Encrypt certificate for the
+# host below, so this hostname must point at the server. Make sure ports 80 and
+# 443 are reachable from the internet.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Credentials for the image registry. On Docker Hub, this is the same username
+# as in the image above, and KAMAL_REGISTRY_PASSWORD is a Docker Hub access
+# token (see .kamal/secrets).
+registry:
+  username: your-dockerhub-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Build for the server's architecture. Change to arm64 if your server is ARM.
+builder:
+  arch: amd64
+
+# Variables injected into the container. Secrets are read from .kamal/secrets.
+env:
+  clear:
+    # Public hostname, used for links in emails and notifications. Keep this
+    # in sync with proxy.host above.
+    APP_FQDN: fizzy.example.com
+
+    # Everything is stored in SQLite on the persistent volume below.
+    DATABASE_ADAPTER: sqlite
+
+    # Run Solid Queue inside Puma, so background jobs run in this container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Outbound mail. Any SMTP server can be used (Postmark, Fastmail, etc.).
+    MAILER_FROM_ADDRESS: "Fizzy <support@fizzy.example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+# SQLite databases and uploaded files are stored here, outside the container,
+# so they survive deployments. Back this volume up.
+volumes:
+  - "fizzy:/rails/storage"
+
+# Bridge fingerprinted assets between releases, so requests served by the old
+# container while the new one boots don't 404.
+asset_path: /rails/public/assets
