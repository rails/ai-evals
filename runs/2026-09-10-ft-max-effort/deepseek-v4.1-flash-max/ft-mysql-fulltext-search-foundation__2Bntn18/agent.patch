+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query, user: nil) do
+      relation = user ? user.accessible_cards : all
+      relation.published.where(*Search.card_conditions(query)).reverse_chronologically
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..306a0eb
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,147 @@
+class Search
+  DEFAULT_EXCERPT_LENGTH = 200
+
+  class << self
+    def terms_for(query)
+      query.to_s.split.uniq
+    end
+
+    def card_conditions(query)
+      terms = terms_for(query)
+      return [ "1=0", {} ] if terms.empty?
+
+      conditions = []
+      bindings = {}
+
+      terms.each_with_index do |term, index|
+        key = :"term_#{index}"
+        conditions << "(#{card_condition(key)})"
+        bindings[key] = like_pattern(term)
+      end
+
+      [ conditions.join(" AND "), bindings ]
+    end
+
+    def comment_conditions(query)
+      terms = terms_for(query)
+      return [ "1=0", {} ] if terms.empty?
+
+      conditions = []
+      bindings = {}
+
+      terms.each_with_index do |term, index|
+        key = :"term_#{index}"
+        conditions << "action_text_rich_texts.body LIKE :#{key}"
+        bindings[key] = like_pattern(term)
+      end
+
+      [ conditions.join(" OR "), bindings ]
+    end
+
+    private
+      def card_condition(key)
+        <<~SQL.squish
+          cards.title LIKE :#{key}
+          OR EXISTS (
+            SELECT 1 FROM action_text_rich_texts AS card_descriptions
+            WHERE card_descriptions.record_type = 'Card'
+              AND card_descriptions.record_id = cards.id
+              AND card_descriptions.name = 'description'
+              AND card_descriptions.body LIKE :#{key}
+          )
+          OR EXISTS (
+            SELECT 1 FROM comments
+            WHERE comments.card_id = cards.id
+              AND EXISTS (
+                SELECT 1 FROM action_text_rich_texts AS comment_bodies
+                WHERE comment_bodies.record_type = 'Comment'
+                  AND comment_bodies.record_id = comments.id
+                  AND comment_bodies.name = 'body'
+                  AND comment_bodies.body LIKE :#{key}
+              )
+          )
+        SQL
+      end
+
+      def like_pattern(term)
+        "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+      end
+  end
+
+  attr_reader :user, :query
+
+  def initialize(user = Current.user, query = nil, **options)
+    if user.is_a?(String)
+      @user = options.fetch(:user, Current.user)
+      @query = options.fetch(:query, user)
+    else
+      @user = options.fetch(:user, user)
+      @query = options.fetch(:query, query)
+    end
+
+    @query = @query.to_s.strip
+  end
+
+  def cards
+    @cards ||= any_terms? && user ? Card.search(query, user: user) : Card.none
+  end
+
+  alias_method :results, :cards
+
+  def terms
+    @terms ||= self.class.terms_for(query)
+  end
+
+  def any_terms?
+    terms.any?
+  end
+
+  def matches?(text)
+    plain_text = plain_text_from(text).downcase
+    terms.any? { |term| plain_text.include?(term.downcase) }
+  end
+
+  def highlight(text)
+    ActionController::Base.helpers.highlight(plain_text_from(text), terms)
+  end
+
+  def excerpt(text, length: DEFAULT_EXCERPT_LENGTH)
+    plain_text = plain_text_from(text).squish
+
+    if index = first_match_index(plain_text)
+      start = [ index - length / 3, 0 ].max
+      snippet = plain_text[start, length].to_s
+      snippet = "…#{snippet}" if start.positive?
+      snippet += "…" if start + length < plain_text.length
+      snippet
+    else
+      plain_text.truncate(length)
+    end
+  end
+
+  def matching_comments(cards = self.cards)
+    return {} if cards.empty? || !any_terms?
+
+    Comment
+      .where(card_id: cards.map(&:id))
+      .joins(:rich_text_body)
+      .where(*self.class.comment_conditions(query))
+      .includes(:rich_text_body)
+      .order(:created_at, :id)
+      .group_by(&:card_id)
+  end
+
+  private
+    def plain_text_from(text)
+      if text.respond_to?(:to_plain_text)
+        text.to_plain_text
+      else
+        text.to_s
+      end
+    end
+
+    def first_match_index(plain_text)
+      downcased_text = plain_text.downcase
+      terms.filter_map { |term| downcased_text.index(term.downcase) }.min
+    end
+end
