diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..b877fb5
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,44 @@
+<% comments = matching_comments.fetch(card.id, []) %>
+
+<%= card_article_tag card, class: "card search-result search__result" do %>
+  <%= link_to card_path(card), draggable: false, class: "card__link", title: card_title_tag(card), data: { turbo_frame: "_top" } do %>
+    <span class="for-screen-reader"><%= card.title %></span>
+  <% end %>
+
+  <header class="card__header">
+    <div class="card__board flex align-start">
+      <span class="card__id">
+        <span class="for-screen-reader">Card number</span>
+        <%= card.number %>
+      </span>
+      <span class="card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </span>
+    </div>
+  </header>
+
+  <div class="card__body justify-space-between">
+    <div class="card__content">
+      <h3 class="card__title search-result__title overflow-line-clamp">
+        <%= search.highlight(card.title) %>
+      </h3>
+
+      <% if search.matches?(card.description) %>
+        <div class="card__description search-result__excerpt">
+          <%= search.highlight(search.excerpt(card.description)) %>
+        </div>
+      <% end %>
+    </div>
+  </div>
+
+  <% comments.each do |comment| %>
+    <div class="search-result__comment comment align-start full-width">
+      <div class="comment__content flex flex-column flex-item-grow full-width">
+        <div class="comment__body">
+          <%= link_to search.highlight(search.excerpt(comment.body)), card_path(card, anchor: dom_id(comment)),
+                class: "txt-ink btn btn--plain fill-transparent" %>
+        </div>
+      </div>
+    </div>
+  <% end %>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..475a77a
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,39 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap", data: { turbo_frame: "_top" } do |form| %>
+    <%= form.search_field :q,
+          value: @query,
+          placeholder: "Search cards…",
+          class: "input flex-item-grow",
+          autofocus: true,
+          autocorrect: "off",
+          autocomplete: "off",
+          aria: { label: "Search cards" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="cards cards--grid search-results search__results">
+    <div class="cards__list hide-scrollbar">
+      <%= with_automatic_pagination :search_paginated_container, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card,
+              locals: { search: @search, matching_comments: @matching_comments } %>
+      <% end %>
+
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    </div>
+  </section>
+<% else %>
+  <section class="panel borderless center margin pad">
+    <p class="txt-medium">Search cards by title, description, or comment.</p>
+  </section>
+<% end %>
