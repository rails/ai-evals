diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..6f157c0
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,41 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, fullLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.update()
+  }
+
+  update() {
+    const date = new Date(this.element.getAttribute("datetime"))
+
+    if (isNaN(date)) return
+
+    this.element.textContent = formatLocalTime(date, this.#format)
+    this.element.title = fullLocalTime(date)
+  }
+
+  get #format() {
+    if (this.hasFormatValue) return this.formatValue
+
+    return {
+      "time": "time",
+      "date": "date",
+      "time-ago": "ago",
+      "relative-time": this.#relativeTimeType,
+      "weekday": "weekday_date"
+    }[this.element.dataset.local] || "time"
+  }
+
+  get #relativeTimeType() {
+    return {
+      "time": "time",
+      "date": "date",
+      "day": "day",
+      "weekday": "weekday_date",
+      "time-ago": "ago"
+    }[this.element.dataset.localRelativeTimeType] || "relative"
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..2b1a20e 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -19,6 +19,196 @@ function datePartsInTimezone(date) {
   }, {})
 }
 
+export function formatLocalTime(date, format = "time", now = new Date()) {
+  switch (format) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date)
+    case "date_with_year":
+      return formatDateWithYear(date)
+    case "weekday":
+    case "weekday_date":
+      return formatWeekdayDate(date)
+    case "short_datetime":
+      return formatShortDateTime(date)
+    case "ago":
+    case "time_ago":
+    case "time-ago":
+      return formatTimeAgo(date, now)
+    case "day":
+      return formatRelativeDay(date, now)
+    case "relative":
+    case "time_or_date":
+    case "time-or-date":
+    default:
+      return formatRelativeTime(date, now)
+  }
+}
+
+export function fullLocalTime(date) {
+  return intlFormat(date, {
+    weekday: "long",
+    year: "numeric",
+    month: "long",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit"
+  })
+}
+
+export function formatTime(date) {
+  return intlFormat(date, { hour: "numeric", minute: "2-digit" })
+}
+
+export function formatDate(date) {
+  return intlFormat(date, { month: "short", day: "numeric" })
+}
+
+export function formatDateWithYear(date) {
+  return intlFormat(date, { year: "numeric", month: "short", day: "numeric" })
+}
+
+export function formatWeekdayDate(date) {
+  return intlFormat(date, { weekday: "long", month: "long", day: "numeric" })
+}
+
+export function formatShortDateTime(date) {
+  return intlFormat(date, {
+    year: "2-digit",
+    month: "numeric",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit"
+  })
+}
+
+function localDayDifference(date, now) {
+  const startOfLocalDay = (value) => new Date(value.getFullYear(), value.getMonth(), value.getDate())
+  return Math.round((startOfLocalDay(date) - startOfLocalDay(now)) / (1000 * 60 * 60 * 24))
+}
+
+// "Yesterday", "5 days ago", or "Sep 12" — the relative day for recent dates
+// and an absolute date once they're more than a week away.
+export function formatRelativeTime(date, now = new Date()) {
+  const days = localDayDifference(date, now)
+
+  if (days === 0) {
+    if (date < now) {
+      return formatTime(date)
+    } else {
+      return relativeAmount(date - now)
+    }
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days < -1 && days > -7) {
+    return `${-days} days ago`
+  } else if (days > 1 && days < 7) {
+    return `in ${days} days`
+  } else {
+    return formatDate(date)
+  }
+}
+
+export function formatRelativeDay(date, now = new Date()) {
+  const days = localDayDifference(date, now)
+
+  if (days === 0) {
+    return "today"
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days < 0 && days > -7) {
+    return `${-days} days ago`
+  } else if (days > 0 && days < 7) {
+    return `in ${days} days`
+  } else {
+    return formatDate(date)
+  }
+}
+
+// "Less than a minute ago", "5 minutes ago", "3 days ago"... matching the
+// granularity of Rails' time_ago_in_words.
+export function formatTimeAgo(date, now = new Date()) {
+  const milliseconds = date - now
+  const magnitude = Math.abs(milliseconds)
+  const direction = Math.sign(milliseconds) || 1
+
+  if (magnitude < 45 * 1000) {
+    return "just now"
+  } else if (magnitude < 90 * 1000) {
+    return relativeAmount(milliseconds, "minute", direction)
+  } else if (magnitude < 45 * 60 * 1000) {
+    return relativeAmount(milliseconds, "minute")
+  } else if (magnitude < 90 * 60 * 1000) {
+    return relativeAmount(milliseconds, "hour", direction)
+  } else if (magnitude < 24 * 60 * 60 * 1000) {
+    return relativeAmount(milliseconds, "hour")
+  } else if (magnitude < 42 * 60 * 60 * 1000) {
+    return relativeAmount(milliseconds, "day", direction)
+  } else if (magnitude < 30 * 24 * 60 * 60 * 1000) {
+    return relativeAmount(milliseconds, "day")
+  } else if (magnitude < 60 * 24 * 60 * 60 * 1000) {
+    return relativeAmount(milliseconds, "month", direction * Math.round(magnitude / (30 * 24 * 60 * 60 * 1000)))
+  } else if (magnitude < 365 * 24 * 60 * 60 * 1000) {
+    return relativeAmount(milliseconds, "month")
+  } else {
+    return relativeAmount(milliseconds, "year")
+  }
+}
+
+function relativeAmount(milliseconds, unit = null, value = null) {
+  const units = {
+    second: 1000,
+    minute: 60 * 1000,
+    hour: 60 * 60 * 1000,
+    day: 24 * 60 * 60 * 1000,
+    month: 30 * 24 * 60 * 60 * 1000,
+    year: 365 * 24 * 60 * 60 * 1000
+  }
+
+  const chosenUnit = unit || smallestUnitFor(milliseconds)
+  const chosenValue = value ?? Math.round(milliseconds / units[chosenUnit])
+
+  return relativeTimeFormatter().format(chosenValue, chosenUnit)
+}
+
+function smallestUnitFor(milliseconds) {
+  const magnitude = Math.abs(milliseconds)
+
+  if (magnitude < 60 * 1000) return "second"
+  if (magnitude < 60 * 60 * 1000) return "minute"
+  if (magnitude < 24 * 60 * 60 * 1000) return "hour"
+  if (magnitude < 30 * 24 * 60 * 60 * 1000) return "day"
+  if (magnitude < 365 * 24 * 60 * 60 * 1000) return "month"
+  return "year"
+}
+
+let relativeTimeFormatterCache
+
+function relativeTimeFormatter() {
+  return relativeTimeFormatterCache ??= new Intl.RelativeTimeFormat("en-US", { numeric: "always" })
+}
+
+function intlFormat(date, options) {
+  return dateFormatterFor(options).format(date).replace(/\u202f/g, " ")
+}
+
+const intlFormatterCache = new Map()
+
+function dateFormatterFor(options) {
+  const key = JSON.stringify(options)
+
+  if (!intlFormatterCache.has(key)) {
+    intlFormatterCache.set(key, new Intl.DateTimeFormat("en-US", options))
+  }
+
+  return intlFormatterCache.get(key)
+}
+
 let dateFormatterCache
 let dateFormatterTimezone
 
