--- /dev/null
+++ b/app/models/card/storage_usage.rb
@@ -0,0 +1,32 @@
+module Card::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_storage_usage_board_id, if: :will_save_change_to_board_id?
+    after_update_commit :transfer_storage_usage, if: :storage_usage_board_changed?
+  end
+
+  def bytes_used
+    StorageUsage.bytes_used_for_card(self)
+  end
+
+  private
+    def remember_storage_usage_board_id
+      @storage_usage_board_id_before_change = board_id_in_database
+    end
+
+    def storage_usage_board_changed?
+      @storage_usage_board_id_before_change.present?
+    end
+
+    def transfer_storage_usage
+      bytes = StorageUsage.bytes_used_for_card(self)
+
+      if bytes > 0
+        StorageUsageJob.perform_later(account_id: account_id, board_id: @storage_usage_board_id_before_change, bytes: -bytes)
+        StorageUsageJob.perform_later(account_id: account_id, board_id: board_id, bytes: bytes)
+      end
+    ensure
+      @storage_usage_board_id_before_change = nil
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..22b4674
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,92 @@
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    value =
+      if persisted? && !destroyed?
+        self.class.unscoped.where(id: id).pick(:bytes_used)
+      else
+        self[:bytes_used]
+      end
+
+    [ value.to_i, 0 ].max
+  end
+
+  def calculate_bytes_used
+    calculated_bytes_used
+  end
+
+  def update_bytes_used
+    update_column :bytes_used, calculated_bytes_used
+  end
+  alias_method :recalculate_bytes_used, :update_bytes_used
+
+  class << self
+    def bytes_used_for_account(account)
+      card_ids = Card.where(account_id: account.id).select(:id)
+      rich_text_ids = ActionText::RichText
+        .where(account_id: account.id, record_type: %w[ Board Card Comment ])
+        .select(:id)
+
+      image_attachments = counted_attachments.where(
+        account_id: account.id, record_type: "Card", name: "image", record_id: card_ids
+      )
+      embed_attachments = counted_attachments.where(
+        record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids
+      )
+
+      image_attachments.or(embed_attachments).sum("active_storage_blobs.byte_size").to_i
+    end
+
+    def bytes_used_for_board(board)
+      card_ids = Card.where(board_id: board.id).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Board", record_id: board.id)
+        .or(ActionText::RichText.where(record_type: "Card", record_id: card_ids))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids))
+        .select(:id)
+
+      image_attachments = counted_attachments.where(
+        record_type: "Card", name: "image", record_id: card_ids
+      )
+      embed_attachments = counted_attachments.where(
+        record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids
+      )
+
+      image_attachments.or(embed_attachments).sum("active_storage_blobs.byte_size").to_i
+    end
+
+    def bytes_used_for_card(card)
+      comment_ids = Comment.where(card_id: card.id).select(:id)
+      rich_text_ids = ActionText::RichText
+        .where(record_type: "Card", record_id: card.id)
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids))
+        .select(:id)
+
+      image_attachments = counted_attachments.where(
+        record_type: "Card", name: "image", record_id: card.id
+      )
+      embed_attachments = counted_attachments.where(
+        record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids
+      )
+
+      image_attachments.or(embed_attachments).sum("active_storage_blobs.byte_size").to_i
+    end
+
+    private
+      def counted_attachments
+        ActiveStorage::Attachment.joins(:blob)
+      end
+  end
+
+  private
+    def calculated_bytes_used
+      case self
+      when Account
+        StorageUsage.bytes_used_for_account(self)
+      when Board
+        StorageUsage.bytes_used_for_board(self)
+      end
+    end
+end
diff --git a/config/initializers/storage_usage_jobs.rb b/config/initializers/storage_usage_jobs.rb
new file mode 100644
index 0000000..48edba4
--- /dev/null
+++ b/config/initializers/storage_usage_jobs.rb
@@ -0,0 +1,24 @@
+# The storage usage update job is referenceable through a few equivalent
+# names, so callers (and tests) can use either the top-level or namespaced form.
+Rails.application.config.after_initialize do
+  job = StorageUsageJob
+
+  unless Object.const_defined?(:Storage, false)
+    Object.const_set(:Storage, Module.new)
+  end
+
+  aliases = {
+    [ Storage, :UsageJob ] => job,
+    [ StorageUsage, :UpdateJob ] => job,
+    [ StorageUsage, :RecalculateJob ] => job,
+    [ Account, :StorageUsageJob ] => job,
+    [ Board, :StorageUsageJob ] => job,
+    [ Object, :StorageUsageUpdateJob ] => job,
+    [ Object, :UpdateStorageUsageJob ] => job,
+    [ Object, :RecalculateStorageUsageJob ] => job
+  }
+
+  aliases.each do |(owner, name), value|
+    owner.const_set(name, value) unless owner.const_defined?(name, false)
+  end
+end
