diff --git a/lib/rails_ext/active_storage_attachment_storage_usage.rb b/lib/rails_ext/active_storage_attachment_storage_usage.rb
new file mode 100644
index 0000000..b4727ca
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage_usage.rb
@@ -0,0 +1,104 @@
+module ActiveStorageAttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :track_storage_usage_on_create
+    before_destroy :remember_storage_usage_on_destroy
+    after_destroy_commit :track_storage_usage_on_destroy
+  end
+
+  private
+    def track_storage_usage_on_create
+      if storage_usage_counted_attachment?
+        StorageUsageJob.perform_later(
+          account_id: account_id,
+          board_id: storage_usage_board_id,
+          bytes: blob.byte_size
+        )
+      end
+    end
+
+    def remember_storage_usage_on_destroy
+      @storage_usage_change = storage_usage_removal_change
+    end
+
+    def track_storage_usage_on_destroy
+      enqueue_storage_usage_change(@storage_usage_change)
+    end
+
+    def enqueue_storage_usage_change(change)
+      StorageUsageJob.perform_later(**change) if change
+    end
+
+    def storage_usage_removal_change
+      if storage_usage_counted_attachment?
+        {
+          account_id: account_id,
+          board_id: storage_usage_board_id,
+          bytes: -blob.byte_size
+        }
+      end
+    end
+
+    def storage_usage_counted_attachment?
+      (record_type == "Card" && name == "image") ||
+        (record_type == "ActionText::RichText" && name == "embeds")
+    end
+
+    def storage_usage_board_id
+      case record_type
+      when "Card"
+        record&.board_id
+      when "ActionText::RichText"
+        storage_usage_board_id_for_rich_text
+      end
+    end
+
+    def storage_usage_board_id_for_rich_text
+      rich_text = record
+
+      case rich_text&.record_type
+      when "Board"
+        rich_text.record_id
+      when "Card"
+        rich_text.record&.board_id
+      when "Comment"
+        rich_text.record&.card&.board_id
+      end
+    end
+end
+
+module ActiveStorageAttachmentStorageUsageDelete
+  def delete
+    change = storage_usage_removal_change
+    result = super
+    enqueue_storage_usage_change(change) if change
+    result
+  end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageAttachmentStorageUsage
+  prepend ActiveStorageAttachmentStorageUsageDelete
+end
+
+module ActiveStorageDetachManyStorageUsage
+  def detach
+    changes = storage_usage_removal_changes
+
+    super.tap do
+      changes.each { |change| StorageUsageJob.perform_later(**change) }
+    end
+  end
+
+  private
+    def storage_usage_removal_changes
+      attachments.filter_map do |attachment|
+        attachment.send(:storage_usage_removal_change)
+      end
+    end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attached::Changes::DetachMany.prepend ActiveStorageDetachManyStorageUsage
+end
