diff --git a/app/jobs/storage_usage_job.rb b/app/jobs/storage_usage_job.rb
new file mode 100644
index 0000000..1b3fb2f
--- /dev/null
+++ b/app/jobs/storage_usage_job.rb
@@ -0,0 +1,55 @@
+class StorageUsageJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(record = nil, *args, account_id: nil, board_id: nil, bytes: nil)
+    if record
+      recalculate_for(record)
+      args.each { |owner| recalculate_for(owner) if owner.respond_to?(:recalculate_bytes_used) }
+    elsif account_id.present? || board_id.present? || bytes.present?
+      update_counters(account_id:, board_id:, bytes:)
+    else
+      recalculate_all
+    end
+  end
+
+  private
+    def update_counters(account_id:, board_id:, bytes:)
+      return if bytes.blank?
+
+      Account.transaction do
+        Account.where(id: account_id).update_counters(bytes_used: bytes) if account_id.present?
+        Board.where(id: board_id).update_counters(bytes_used: bytes) if board_id.present?
+      end
+    end
+
+    def recalculate_for(record)
+      owner = record.is_a?(ActiveStorage::Attachment) ? record.record : record
+
+      case owner
+      when Account
+        recalculate_account(owner)
+      when Board
+        recalculate_board_and_account(owner.account, owner)
+      when Card
+        recalculate_board_and_account(owner.account, owner.board)
+      when Comment
+        recalculate_board_and_account(owner.card.account, owner.card.board)
+      when ActionText::RichText
+        recalculate_for(owner.record)
+      end
+    end
+
+    def recalculate_account(account)
+      account.boards.find_each(&:recalculate_bytes_used)
+      account.recalculate_bytes_used
+    end
+
+    def recalculate_board_and_account(account, board)
+      board.recalculate_bytes_used
+      account.recalculate_bytes_used
+    end
+
+    def recalculate_all
+      Account.find_each { |account| recalculate_account(account) }
+    end
+end
