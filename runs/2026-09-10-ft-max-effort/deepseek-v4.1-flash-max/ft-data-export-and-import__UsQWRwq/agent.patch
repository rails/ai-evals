+      to: recipient_emails,
+      subject: "Your Fizzy import is complete"
+    )
+  end
+  alias_method :import_completed, :completed
+
+  def failed(import)
+    @import = import
+    @account = import.account
+    @user = import.user
+
+    mail(
+      to: recipient_emails,
+      subject: "Your Fizzy import failed"
+    )
+  end
+  alias_method :import_failed, :failed
+
+  private
+    def recipient_emails
+      if @user&.identity.present?
+        [ @user.identity.email_address ]
+      else
+        @account.users.admin.includes(:identity).filter_map { |admin| admin.identity&.email_address }
+      end
+    end
+end
