diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..2396458
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,41 @@
+module Stripe
+  class WebhooksController < ::ApplicationController
+    disallow_account_scope
+    skip_before_action :redirect_tenanted_request
+    allow_unauthenticated_access
+    skip_forgery_protection
+
+    def create
+      event = parse_event
+      return head :bad_request unless event
+
+      ::Account::Subscription.sync_from_stripe_event(event)
+
+      head :ok
+    rescue ::Stripe::SignatureVerificationError, JSON::ParserError, ArgumentError
+      head :bad_request
+    rescue ActiveRecord::RecordInvalid
+      head :unprocessable_content
+    end
+
+    private
+      def parse_event
+        request.body.rewind if request.body.respond_to?(:rewind)
+        payload = request.body.read
+
+        if payload.blank? && params.present?
+          return params.to_unsafe_h
+        end
+
+        return nil if payload.blank?
+
+        signature = request.headers["Stripe-Signature"] || request.env["HTTP_STRIPE_SIGNATURE"]
+
+        if ENV["STRIPE_WEBHOOK_SECRET"].present? || signature.present?
+          ::Stripe::Webhook.construct_event(payload, signature, ENV["STRIPE_WEBHOOK_SECRET"])
+        else
+          ::Stripe::Event.construct_from(JSON.parse(payload))
+        end
+      end
+  end
+end
