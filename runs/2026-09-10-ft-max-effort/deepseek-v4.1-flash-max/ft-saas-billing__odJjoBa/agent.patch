+  <h1 class="txt-x-large font-weight-black margin-none">Upgrade your account</h1>
+
+  <p class="margin-none">Choose the plan that fits your account. Billing is handled securely by Stripe.</p>
+
+  <ul class="flex flex-column gap list-style-none full-width pad border-radius border">
+    <% Plan.all.each do |plan| %>
+      <li class="flex align-center gap txt-medium txt-align-start">
+        <div class="flex-1 flex flex-column">
+          <strong><%= plan.name %></strong>
+          <span class="txt-subtle txt-x-small">
+            <%= number_with_delimiter(plan.card_count || "Unlimited") %> cards,
+            <%= number_to_human_size(plan.storage_limit) %> storage
+          </span>
+        </div>
+
+        <div class="txt-medium">
+          <% if plan.free? %>
+            <strong>Free</strong>
+          <% else %>
+            <strong><%= number_to_currency(plan.price) %></strong>
+            <span class="txt-x-small txt-ink-medium">/month</span>
+          <% end %>
+        </div>
+
+        <% if plan.paid? %>
+          <%= button_to "Upgrade", account_subscription_create_path(plan: plan.key), class: "btn txt-small", form: { class: "flex-item-no-shrink" } %>
