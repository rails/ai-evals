+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,68 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_creatorship, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def index
+    @reactions = @comment.reactions.preloaded.chronologically
+    fresh_when etag: @reactions
+    render "reactions/index" unless performed?
+  end
+
+  def new
+    @reaction = @comment.reactions.new
+    @reactable = @comment
+    render "reactions/new"
+  end
+
+  def show
+    fresh_when etag: @reaction
+    render "reactions/show" unless performed?
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render "reactions/show", status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
