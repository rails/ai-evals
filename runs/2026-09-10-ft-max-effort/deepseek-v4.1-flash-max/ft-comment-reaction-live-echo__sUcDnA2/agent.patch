diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..585ce12
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,33 @@
+module ReactionsHelper
+  def reactions_for(reactable)
+    if reactable.is_a?(Card)
+      reactable.reactions.where(comment_id: nil).preloaded.chronologically
+    else
+      reactable.reactions.preloaded.chronologically
+    end
+  end
+
+  def reactions_url_for(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_path(reactable.card, reactable, script_name: account_slug_for(reactable))
+    else
+      card_reactions_path(reactable, script_name: account_slug_for(reactable))
+    end
+  end
+
+  def reaction_url_for(reaction)
+    if reaction.comment.present?
+      card_comment_reaction_url(reaction.card, reaction.comment, reaction, script_name: account_slug_for(reaction))
+    else
+      card_reaction_url(reaction.card, reaction, script_name: account_slug_for(reaction))
+    end
+  end
+
+  private
+    def account_slug_for(record)
+      account = record.account
+      account ||= record.card&.account if record.respond_to?(:card)
+      account ||= record.comment&.account if record.respond_to?(:comment)
+      (account || Current.account)&.slug
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e26c510
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,35 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "composer", "form", "input", "trigger" ]
+
+  show(event) {
+    event.preventDefault()
+
+    this.composerTarget.hidden = false
+    this.composerTarget.classList.add("reaction")
+    this.formTarget.classList.add("expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event.preventDefault()
+
+    this.inputTarget.value = ""
+    this.composerTarget.hidden = true
+    this.composerTarget.classList.remove("reaction")
+    this.formTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  expand(event) {
+    if (event.target.closest("button, a, form")) return
+
+    const currentUserId = document.querySelector('meta[name="current-user-id"]')?.content
+    if (event.currentTarget.dataset.reacterId !== currentUserId) return
+
+    event.currentTarget.classList.toggle("expanded")
+  }
+}
