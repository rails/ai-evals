diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..28b118b
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,48 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { card&.account || comment&.account || Current.account }
+  belongs_to :card, optional: true, touch: true
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validates :card, unless: :comment, presence: true
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { includes(:reacter) }
+
+  before_validation :set_card_from_comment, if: -> { card_id.blank? && comment.present? }
+
+  after_create :register_card_activity
+  after_create_commit -> { broadcast_reactions_change }
+  after_destroy_commit -> { broadcast_reactions_change }
+
+  def card
+    super || comment&.card
+  end
+
+  private
+    def set_card_from_comment
+      self.card = comment.card
+    end
+
+    def register_card_activity
+      card&.touch_last_active_at
+    end
+
+    def broadcast_reactions_change
+      reactable = if comment_id
+        self.comment || Comment.find_by(id: comment_id)
+      elsif card_id
+        self.card || Card.find_by(id: card_id)
+      end
+
+      if reactable
+        html = ApplicationController.renderer.new(script_name: reactable.account.slug)
+          .render(partial: "reactions/reactions", locals: { reactable: reactable })
+
+        Turbo::StreamsChannel.broadcast_replace_later_to [ reactable, :reactions ],
+          target: ActionView::RecordIdentifier.dom_id(reactable, :reactions),
+          html: html
+      end
+    end
+end
