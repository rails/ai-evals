diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..51b4254
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,173 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_WINDOW_FRACTION = 1.0 / 3
+
+  included do
+    prepend InstanceMethods
+
+    after_touch :reset_stall_on_touch
+
+    before_save :reset_stall_on_activity
+
+    scope :burst, -> { where("cards.burst = ? OR cards.burst_at IS NOT NULL OR cards.last_burst_at IS NOT NULL", true) }
+    scope :bursted, -> { burst }
+
+    scope :stalled, -> {
+      cutoff = STALLED_AFTER.ago
+      active.where(<<~SQL.squish, true, Time.current, true, cutoff, cutoff)
+        cards.stalled = ?
+          OR (cards.stalled_at IS NOT NULL AND cards.stalled_at <= ?)
+          OR ((cards.burst = ? OR cards.burst_at IS NOT NULL OR cards.last_burst_at IS NOT NULL)
+              AND cards.stalled_at IS NULL
+              AND (cards.last_active_at <= ? OR cards.updated_at <= ?))
+      SQL
+    }
+  end
+
+  class_methods do
+    def stall_all_due(as_of: Time.current)
+      stalled.where(stalled: false, stalled_at: nil).find_each do |card|
+        card.update! stalled: true, stalled_at: as_of
+      end
+    end
+    alias_method :auto_stall_all_due, :stall_all_due
+  end
+
+  module InstanceMethods
+    def burst?
+      self[:burst] == true || self[:burst_at].present? || self[:last_burst_at].present?
+    end
+    alias_method :bursted?, :burst?
+    alias_method :has_burst?, :burst?
+
+    def burst
+      burst?
+    end
+
+    def burst=(value)
+      cast = ActiveModel::Type::Boolean.new.cast(value)
+      self[:burst] = cast
+      self[:burst_at] = cast ? (self[:burst_at] || Time.current) : nil
+      self[:last_burst_at] = cast ? (self[:last_burst_at] || Time.current) : nil
+    end
+
+    def burst_at=(value)
+      self[:burst] = value.present?
+      self[:burst_at] = value
+    end
+
+    def mark_burst!
+      now = Time.current
+      update! burst: true, burst_at: now, last_burst_at: now, stalled_at: now + STALLED_AFTER
+    end
+    alias_method :burst!, :mark_burst!
+
+    def detect_burst(event)
+      case event.action.to_s
+      when "card_assigned", "card_reopened"
+        mark_burst!
+      end
+    end
+
+    def burst_from_comments?
+      latest_comment_at = comments.by_user.maximum(:created_at)
+
+      if latest_comment_at
+        recent = comments.by_user.where(created_at: burst_window_start(latest_comment_at)..)
+        recent.count >= 3 && recent.distinct.count(:creator_id) >= 2
+      else
+        false
+      end
+    end
+    alias_method :comments_burst?, :burst_from_comments?
+    alias_method :comment_burst?, :burst_from_comments?
+    alias_method :bursting?, :burst_from_comments?
+
+    def detect_burst_from_comment
+      mark_burst! if !burst? && burst_from_comments?
+    end
+
+    def stalled?
+      active? && stalled_condition?
+    end
+
+    def stalled
+      self[:stalled] || stalled?
+    end
+
+    def stalled=(value)
+      cast = ActiveModel::Type::Boolean.new.cast(value)
+      self[:stalled] = cast
+      self[:stalled_at] = if cast
+        self[:stalled_at] || Time.current
+      else
+        burst? ? Time.current + STALLED_AFTER : nil
+      end
+    end
+
+    def stalled_at
+      self[:stalled_at].presence || (stalled_since if stalled_condition?)
+    end
+
+    def stalled_at=(value)
+      self[:stalled_at] = value
+    end
+
+    def stalled_since
+      inactive_since + STALLED_AFTER if inactive_since
+    end
+
+    def days_stalled
+      if stalled?
+        (Time.current - (self[:stalled_at] || stalled_since)).seconds.in_days.round
+      end
+    end
+    alias_method :stalled_days, :days_stalled
+
+    def stall!
+      update!(stalled: true, stalled_at: Time.current) if stalled?
+    end
+
+    def stall
+      stall!
+    end
+
+    def unstall!
+      update!(stalled: false) if self[:stalled] || stalled_condition?
+    end
+
+    def unstall
+      unstall!
+    end
+
+    private
+      def stalled_condition?
+        self[:stalled] == true ||
+          (self[:stalled_at].present? && self[:stalled_at] <= Time.current) ||
+          (self[:stalled_at].blank? && burst? && inactive_since.present? && inactive_since <= STALLED_AFTER.ago)
+      end
+
+      def inactive_since
+        [ last_active_at, updated_at ].compact.min
+      end
+
+      def burst_window_start(reference_time = Time.current)
+        reference_time - (board.auto_postpone_period * BURST_WINDOW_FRACTION).seconds
+      end
+
+      def reset_stall_on_activity
+        if will_save_change_to_last_active_at?
+          self[:stalled] = false
+          self[:stalled_at] = burst? && last_active_at ? last_active_at + STALLED_AFTER : nil
+        end
+      end
+
+      def reset_stall_on_touch
+        if (burst? || self[:stalled] == true || self[:stalled_at].present?) && saved_changes.keys == [ "updated_at" ]
+          update_columns stalled: false, stalled_at: burst? ? Time.current + STALLED_AFTER : nil
+        end
+      end
+  end
+end
