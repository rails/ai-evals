+++ b/lib/rails_ext/active_record_uuid_type.rb
@@ -23,7 +23,7 @@ module ActiveRecord
       def serialize(value)
         return unless value
 
-        binary = Uuid.base36_to_hex(value).scan(/../).map(&:hex).pack("C*")
+        binary = [ Uuid.base36_to_hex(value) ].pack("H*")
         super(binary)
       end
 
