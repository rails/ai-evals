diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..736c273 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,11 +24,120 @@ module Card::Entropic
   end
 
   class_methods do
-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+    AUTO_POSTPONE_BATCH_SIZE = 500
+
+    def auto_postpone_all_due(batch_size: AUTO_POSTPONE_BATCH_SIZE)
+      due_to_be_postponed.in_batches(of: batch_size, load: true) do |cards|
+        auto_postpone_batch(cards)
       end
     end
+
+    private
+      def auto_postpone_batch(cards)
+        cards = cards.load
+        return if cards.empty?
+
+        transaction do
+          now = Time.current
+          account_ids = cards.map(&:account_id).uniq
+          system_users = User.where(account_id: account_ids, role: :system).index_by(&:account_id)
+          card_ids = cards.map(&:id)
+          board_ids = cards.map(&:board_id).uniq
+          column_ids = cards.map(&:column_id).compact.uniq
+
+          Card.where(id: card_ids).update_all(column_id: nil, last_active_at: now, updated_at: now)
+          Card::ActivitySpike.where(card_id: card_ids).delete_all
+          Column.where(id: column_ids).update_all(updated_at: now) if column_ids.any?
+
+          not_nows = cards.map do |card|
+            {
+              id: generate_uuid,
+              account_id: card.account_id,
+              card_id: card.id,
+              user_id: system_users.fetch(card.account_id).id,
+              created_at: now,
+              updated_at: now
+            }
+          end
+          Card::NotNow.insert_all!(not_nows)
+
+          events = cards.map do |card|
+            {
+              id: generate_uuid,
+              account_id: card.account_id,
+              action: "card_auto_postponed",
+              board_id: card.board_id,
+              creator_id: system_users.fetch(card.account_id).id,
+              eventable_id: card.id,
+              eventable_type: "Card",
+              particulars: {},
+              created_at: now,
+              updated_at: now
+            }
+          end
+          Event.insert_all!(events)
+
+          comments = events.map do |event|
+            {
+              id: generate_uuid,
+              account_id: event[:account_id],
+              card_id: event[:eventable_id],
+              creator_id: event[:creator_id],
+              created_at: now,
+              updated_at: now
+            }
+          end
+          Comment.insert_all!(comments)
+
+          ActionText::RichText.insert_all!(comments.map do |comment|
+            {
+              id: generate_uuid,
+              account_id: comment[:account_id],
+              body: nil,
+              name: "body",
+              record_id: comment[:id],
+              record_type: "Comment",
+              created_at: now,
+              updated_at: now
+            }
+          end)
+          ActionText::RichText.where(record_type: "Comment", record_id: comments.map { |comment| comment[:id] })
+            .update_all("body = #{connection.quote(auto_postpone_comment_body)}")
+
+          auto_watch_comments(comments, card_ids, now)
+          Board.where(id: board_ids).update_all(updated_at: now)
+        end
+      end
+
+      def auto_watch_comments(comments, card_ids, now)
+        user_ids = comments.map { |comment| comment[:creator_id] }.uniq
+        existing_watches = Watch.where(card_id: card_ids, user_id: user_ids).pluck(:card_id, :user_id)
+        existing_watch_keys = existing_watches.to_h { |card_id, user_id| [ [ card_id, user_id ], true ] }
+
+        watches = comments.filter_map do |comment|
+          key = [ comment[:card_id], comment[:creator_id] ]
+          next if existing_watch_keys[key]
+
+          {
+            id: generate_uuid,
+            account_id: comment[:account_id],
+            card_id: comment[:card_id],
+            user_id: comment[:creator_id],
+            watching: true,
+            created_at: now,
+            updated_at: now
+          }
+        end
+        Watch.insert_all!(watches) if watches.any?
+      end
+
+      def auto_postpone_comment_body
+        %(<div class="action-text-content">\n  <strong>Moved</strong> to “Not Now” due to inactivity\n</div>)
+      end
+
+      def generate_uuid
+        ActiveRecord::Type::Uuid.generate
+      end
   end
 
   def entropy
diff --git a/lib/rails_ext/active_record_uuid_type.rb b/lib/rails_ext/active_record_uuid_type.rb
index f2004f2..0a5d056 100644
