diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..daf6c36
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,32 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def show
+    redirect_to published_board_path(@board)
+  end
+
+  def create
+    already_published = @board.published?
+    @board.publish
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to edit_board_path(@board), notice: "Board was successfully published." }
+      format.json { render :show, status: already_published ? :ok : :created }
+    end
+  end
+
+  def destroy
+    was_published = @board.published?
+    @board.unpublish
+    @board.reload
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to edit_board_path(@board), notice: "Board was successfully unpublished." }
+      format.json { was_published ? head(:no_content) : head(:ok) }
+    end
+  end
+end
