--- /dev/null
+++ b/app/views/public/cards/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, published_board_url(@board), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @page_title %></span>
+  </h1>
+<% end %>
+
+<section class="card card--perma panel shadow">
+  <h1 class="card__title"><%= @card.title %></h1>
+
+  <% if @card.description.present? %>
+    <div class="card__description lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <footer class="card__footer txt-small txt-subtle">
+    <p>Board: <%= @board.name %></p>
+    <% if @card.column %>
+      <p>Column: <%= @card.column.name %></p>
+    <% end %>
+    <p>Created: <%= l @card.created_at, format: :long %></p>
+  </footer>
+</section>
