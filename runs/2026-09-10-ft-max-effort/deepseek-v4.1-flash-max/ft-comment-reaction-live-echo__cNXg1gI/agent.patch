diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..2e34fb4
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,43 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { card&.account || comment&.account }
+  belongs_to :card, optional: true, touch: true
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :has_a_target
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  after_create :register_card_activity
+
+  def card
+    super || comment&.card
+  end
+
+  def to_partial_path
+    if card_id?
+      "cards/reactions/reaction"
+    else
+      "cards/comments/reactions/reaction"
+    end
+  end
+
+  def reactionable
+    card || comment
+  end
+
+  private
+    def has_a_target
+      if card_id.nil? && comment_id.nil?
+        errors.add(:comment, :blank)
+        errors.add(:base, "Reaction must belong to a card or a comment")
+      elsif card_id.present? && comment_id.present?
+        errors.add(:base, "Reaction must belong to a card or a comment, not both")
+      end
+    end
+
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
