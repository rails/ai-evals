diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..fbfa3d2
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,42 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  connect() {
+    this.#markOwnReactions()
+  }
+
+  edit() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+
+    this.inputTarget.value = ""
+  }
+
+  pickEmoji({ params: { emoji } }) {
+    this.inputTarget.value = emoji
+    this.formTarget.querySelector("form").requestSubmit()
+  }
+
+  deleting({ currentTarget }) {
+    currentTarget.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+
+  #markOwnReactions() {
+    const currentUserId = window.Current?.user?.id
+
+    if (currentUserId) {
+      this.element.querySelectorAll(`.reaction[data-creator-id="${currentUserId}"]`)
+        .forEach(reaction => reaction.classList.add("reaction--deleteable"))
+    }
+  }
+}
