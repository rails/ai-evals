+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle", title: "Confirm reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+
+    <%= button_tag type: "button", class: "reaction__cancel-btn btn btn--circle", title: "Cancel reaction", data: { action: "reaction#cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    <% end %>
+  <% end %>
+</div>
