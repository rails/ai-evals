@@ -29,4 +43,119 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  def deliver
+    if start_delivery
+      perform_request
+    end
+  end
+
+  alias_method :perform, :deliver
+  alias_method :deliver_now, :deliver
+  alias_method :deliver!, :deliver
+  alias_method :process, :deliver
+
+  def deliver_later
+    enqueue_delivery
+  end
+
+  def payload
+    @payload ||= if webhook.for_slack?
+      { text: message }.to_json
+    elsif webhook.for_campfire?
+      { message: { body: message } }.to_json
+    elsif webhook.for_basecamp?
+      { content: message, content_type: "text/html" }.to_json
+    else
+      event_payload
+    end
+  end
+
+  alias_method :body, :payload
+
+  private
+    def enqueue_delivery
+      Webhook::DeliveryJob.perform_later(self) unless Event.suppressed?
+    end
+
+    def start_delivery
+      @delivering = false
+
+      with_lock do
+        if pending?
+          update! state: :in_progress, request: { headers: request_headers }
+          @delivering = true
+        end
+      end
+
+      @delivering
+    end
+
+    def perform_request
+      response = post_request
+
+      with_lock do
+        update! state: :completed, response: {
+          code: response.code.to_i,
+          headers: response.each_header.to_h
+        }
+      end
+    rescue => error
+      with_lock do
+        update! state: :errored, response: { error: error_reason(error) }
+      end
+    ensure
+      webhook&.record_delivery(self) if @delivering
+    end
+
+    def post_request
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri, request_headers)
+      request.body = payload
+
+      http.request(request)
+    end
+
+    def request_headers
+      {
+        "Content-Type" => "application/json",
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def event_payload
+      renderer.render(template: "webhooks/event", formats: :json, assigns: { event: event })
+    end
+
+    def message
+      renderer.render(template: "webhooks/event", formats: :html, assigns: { event: event }, layout: false).strip
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: event.account.slug)
+    end
+
+    def error_reason(error)
+      case error
+      when SocketError, Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH
+        "destination_unreachable"
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        "timeout"
+      when OpenSSL::SSL::SSLError
+        "ssl_error"
+      else
+        error.class.name
+      end
+    end
 end
