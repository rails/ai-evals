diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..b930e74
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,61 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input" ]
+
+  expand(event) {
+    const reaction = event.currentTarget
+
+    if (reaction.dataset.creatorId === Current.user?.id) {
+      reaction.classList.toggle("expanded")
+    }
+  }
+
+  open(event) {
+    event.stopPropagation()
+    this.formTarget.open = true
+  }
+
+  toggled() {
+    if (this.formTarget.open) {
+      this.formTarget.classList.add("expanded")
+      this.inputTarget.focus()
+    } else {
+      this.formTarget.classList.remove("expanded")
+      this.#reset()
+    }
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.close()
+  }
+
+  close() {
+    this.formTarget.open = false
+    this.formTarget.classList.remove("expanded")
+    this.#reset()
+  }
+
+  submitEnd(event) {
+    if (event.detail.success) this.close()
+  }
+
+  chooseEmoji(event) {
+    this.inputTarget.value = event.params.emoji
+    this.dialog?.close?.()
+    this.inputTarget.form?.requestSubmit()
+  }
+
+  deleting(event) {
+    event.target.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+
+  get dialog() {
+    return this.element.querySelector("dialog[open]")
+  }
+
+  #reset() {
+    this.formTarget.querySelector("form")?.reset()
+  }
+}
