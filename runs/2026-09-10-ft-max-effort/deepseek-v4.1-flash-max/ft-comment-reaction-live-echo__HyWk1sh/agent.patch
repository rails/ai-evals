diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..19a4010
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,44 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+  MAX_LENGTH = MAX_CONTENT_LENGTH
+
+  EMOJIS = %w[
+    👍 ❤️ 😂 🎉 😄 😊 🙌 🔥 👏 🚀
+    👀 💯 🙏 😍 🤣 😅 😢 😮 🤔 🤯
+  ].freeze
+
+  belongs_to :account, default: -> { reactable&.account || reacter&.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", inverse_of: :reactions
+
+  normalizes :content, with: ->(content) { content&.strip }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :desc }
+  scope :preloaded, -> { includes(reacter: [ :avatar_attachment, :account ]) }
+
+  after_create_commit :touch_card
+  after_destroy_commit :touch_card_after_destroy
+
+  def card
+    reactable.card
+  end
+
+  private
+    def touch_card
+      # The reactable touch has already refreshed the card; update activity
+      # without triggering a second refresh broadcast.
+      card.update_column(:last_active_at, Time.current)
+    end
+
+    def touch_card_after_destroy
+      card = if reactable_type == "Card"
+        Card.find_by(id: reactable_id)
+      else
+        Comment.find_by(id: reactable_id)&.card
+      end
+
+      card&.update_column(:last_active_at, Time.current)
+    end
+end
