new file mode 100644
index 0000000..a3395f3
--- /dev/null
+++ b/app/views/reactions/_form.html.erb
@@ -0,0 +1,48 @@
+<details class="reaction__form"
+    data-reactions-target="form"
+    data-action="toggle->reactions#toggled turbo:submit-end->reactions#submitEnd keydown.esc->reactions#cancel">
+  <summary class="reaction__form-label reactions__trigger btn btn--circle" title="Add a reaction">
+    <button type="button" class="btn btn--circle borderless" aria-label="Add a reaction"
+        title="Add reaction" value="Add reaction" data-action="reactions#open">
+      <%= image_tag "boost-color.svg", alt: "" %>
+      <span class="for-screen-reader">Add a reaction</span>
+    </button>
+  </summary>
+
+  <%= form_with model: Reaction.new, url: reactions_path_for(reactable),
+        class: "flex align-center gap-half" do |form| %>
+    <div class="reaction__menu" data-controller="dialog"
+         data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless"
+          data-action="click->dialog#open:stop" title="Choose an emoji"
+          data-controller="tooltip" data-tooltip-title-value="Choose an emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Choose an emoji</span>
+      </button>
+
+      <dialog class="popup panel reaction__popup" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% Reaction::EMOJIS.each do |emoji| %>
+            <button type="button" class="btn" data-action="reactions#chooseEmoji"
+                data-reactions-emoji-param="<%= emoji %>" aria-label="React with <%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.text_field :content, class: "reaction__input input", maxlength: Reaction::MAX_CONTENT_LENGTH,
+          placeholder: "Add a reaction…", autocomplete: "off", required: true,
+          aria: { label: "Reaction" }, data: { reactions_target: "input" } %>
+
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless" title="Save reaction" aria-label="Save reaction" value="Save reaction">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Save</span>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" title="Cancel" aria-label="Cancel"
+        data-action="reactions#cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</details>
