@@ -0,0 +1,21 @@
+# Secrets for the one-box Kamal deployment (see config/deploy.yml and
+# docs/deployment.md). Kamal reads this file on the machine running the deploy
+# and passes these values to the app container as environment variables.
+#
+# Replace the placeholder values below. If you enter real secrets in this file,
+# take care not to commit them. You can also replace a value with a command,
+# e.g. SMTP_PASSWORD=$(op read "op://Private/SMTP/password").
+#
+# Quote values that contain spaces or special characters, e.g.
+# SMTP_PASSWORD='p@ss$word' (single quotes skip dotenv substitution).
+
+# Generate once with `bin/rails secret` and keep it stable: changing it will
+# invalidate sessions and encrypted cookies.
+SECRET_KEY_BASE=replace-with-a-stable-64-character-secret
+
+# Password (or API token) for the SMTP user configured in config/deploy.yml.
+SMTP_PASSWORD=replace-with-your-smtp-password
+
+# If you use Rails credentials (config/credentials.yml.enc), also set
+# RAILS_MASTER_KEY here and add it to env.secret in config/deploy.yml:
+# RAILS_MASTER_KEY=$(cat config/master.key)
