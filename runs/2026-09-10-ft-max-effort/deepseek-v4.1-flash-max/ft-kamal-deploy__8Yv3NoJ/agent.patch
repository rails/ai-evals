new file mode 100644
index 0000000..2ef71e2
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,77 @@
+# One-box Fizzy deployment with Kamal.
+#
+# Everything runs on a single Linux server: the Rails web server, background
+# jobs (Solid Queue runs inside Puma), and SQLite. kamal-proxy sits in front
+# and provisions SSL certificates from Let's Encrypt.
+#
+# To deploy:
+#
+#   1. Replace the placeholders below (server address, hostname, mail server).
+#   2. Put your secrets in .kamal/secrets.
+#   3. Run `bin/kamal setup`.
+#
+# The named volume at /rails/storage keeps the SQLite databases and uploaded
+# files across deploys. See docs/deployment.md for the full guide.
+
+service: fizzy
+image: fizzy
+
+# The Linux server where Fizzy will run. It only needs Docker and an SSH key;
+# Kamal can install Docker for you during setup. Replace with your server's IP.
+servers:
+  web:
+    - 192.168.0.1
+
+# If you log in to the server as a non-root user with Docker access,
+# uncomment and set the user here:
+# ssh:
+#   user: ubuntu
+
+# Serve static assets efficiently from the app image via Thruster.
+asset_path: /rails/public/assets
+
+# kamal-proxy terminates SSL on ports 80/443 and forwards traffic to the app.
+# Replace this host with your hostname (its DNS record must point at the server).
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+
+# No external registry account is needed: Kamal runs a temporary registry
+# locally and tunnels it to the server, so only Docker is required locally.
+registry:
+  server: localhost:5555
+
+# Build for your server's architecture. Change to arm64 for an ARM server.
+builder:
+  arch: amd64
+
+# Environment for the app container. Values referenced under `secret` are read
+# from .kamal/secrets by Kamal and never baked into the image.
+env:
+  clear:
+    APP_HOST: fizzy.example.com # Must match proxy.host above.
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite # SQLite databases live in the persistent volume below.
+    ACTIVE_STORAGE_SERVICE: local # Uploaded files live in the persistent volume below.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_ENABLE_STARTTLS_AUTO: "true" # Use "false" for a plain/local relay on port 25.
+    SOLID_QUEUE_IN_PUMA: "true" # Run background jobs in the web container.
+    WEB_CONCURRENCY: "1" # Keep one web worker on a small box; raise if you have capacity.
+    JOB_CONCURRENCY: "1" # Keep one background job process; raise if you need more throughput.
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # - RAILS_MASTER_KEY # Uncomment if you use Rails credentials.
+
+# SQLite databases and Active Storage uploads live here. The named Docker
+# volume survives container replacement, so data persists across deploys.
+volumes:
+  - fizzy:/rails/storage
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..a17f397 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,46 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Build absolute URLs for the canonical hostname so emails and background
+  # jobs can link back to the app. APP_HOST is set by the one-box Kamal deploy
+  # in config/deploy.yml (APP_FQDN is accepted as a fallback); it is unset for
+  # tasks that do not need it, such as assets:precompile during the image build.
+  app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence
+  if app_host
+    app_url_options = { host: app_host, protocol: "https" }
+    Rails.application.routes.default_url_options = app_url_options
+    config.action_controller.default_url_options = app_url_options
+    config.action_mailer.default_url_options = app_url_options
+    config.action_mailer.asset_host = "https://#{app_host}"
+  end
+
+  # Configure outgoing mail from the environment set in config/deploy.yml.
+  # SMTP_PASSWORD is provided by Kamal from .kamal/secrets.
+  if ENV["SMTP_ADDRESS"].present?
+    smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV.fetch("SMTP_DOMAIN", app_host.presence || "localhost.localdomain"),
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }
+
+    if ENV["SMTP_USERNAME"].present?
+      smtp_settings[:user_name] = ENV["SMTP_USERNAME"]
+      smtp_settings[:password] = ENV["SMTP_PASSWORD"]
+      smtp_settings[:authentication] = ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym
+    end
+
+    smtp_settings[:openssl_verify_mode] = ENV["SMTP_OPENSSL_VERIFY_MODE"] if ENV["SMTP_OPENSSL_VERIFY_MODE"].present?
+
+    # Use implicit TLS (SMTPS, usually port 465) instead of STARTTLS.
+    if ENV["SMTP_TLS"] == "true"
+      smtp_settings[:tls] = true
+      smtp_settings.delete(:enable_starttls_auto)
+    end
+
+    config.action_mailer.smtp_settings = smtp_settings
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..1716728
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,168 @@
+# Deploying Fizzy
+
+Fizzy is designed to run comfortably on a single Linux server. Everything runs
+in one container: the Rails web server, Solid Queue background jobs, the SQLite
+databases, and attached files. [Kamal](https://kamal-deploy.org) builds and
+deploys the image, [kamal-proxy](https://github.com/basecamp/kamal-proxy) fronts
+it with automatic HTTPS from Let's Encrypt, and a named Docker volume keeps your
+data across deploys.
+
+The deployment configuration lives in [`config/deploy.yml`](../config/deploy.yml).
+
+## What you need
+
+- A Linux server with a public IP and SSH access (root by default).
+- DNS: an `A`/`AAAA` record for your Fizzy hostname pointing at the server.
+  Ports `80` and `443` must be reachable so the proxy can issue its certificate.
+- An SMTP account for sign-in links and notifications.
+- Docker on your local machine. Kamal builds the image locally and pushes it
+  through a temporary local registry, so you do not need a Docker Hub account
+  or any other external registry.
+- The repository checked out locally with its gems installed
+  (`bin/setup` or `bundle install`), which also provides `bin/kamal`.
+
+## 1. Configure your hostname and mail server
+
+Open `config/deploy.yml` and replace the placeholders:
+
+- `servers.web`: your server's IP address (or SSH hostname).
+- `proxy.host`: the hostname Fizzy will be served at.
+- `APP_HOST`: the same hostname, used to build links in emails and background
+  jobs.
+- `SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_USERNAME`: your mail server.
+- `MAILER_FROM_ADDRESS`: the address recipients see in the From header. It
+  usually needs to use a domain your mail provider allows you to send from.
+
+If your server is arm64, change `builder.arch` to `arm64`. If you log in to the
+server as a non-root user, uncomment and set the `ssh.user` option.
+
+A few common mail configurations:
+
+- SMTP submission with STARTTLS (the default): port `587`,
+  `SMTP_ENABLE_STARTTLS_AUTO: "true"`.
+- Implicit TLS/SMTPS: port `465`, add `SMTP_TLS: "true"` to `env.clear`, and
+  remove `SMTP_ENABLE_STARTTLS_AUTO`.
+- A local relay with no authentication on port 25: set `SMTP_PORT: "25"`,
+  `SMTP_ENABLE_STARTTLS_AUTO: "false"`, and remove `SMTP_USERNAME` and
+  `SMTP_PASSWORD` from the `env` section.
+- If your provider needs a specific AUTH mechanism, set `SMTP_AUTHENTICATION`
+  (for example, `login`). The default is `plain`.
+
+## 2. Configure your secrets
+
+Edit `.kamal/secrets` and replace both placeholders:
+
+- `SECRET_KEY_BASE`: generate once with `bin/rails secret` (or
+  `openssl rand -hex 64`) and keep it stable. Changing it logs everyone out and
+  invalidates encrypted cookies.
+- `SMTP_PASSWORD`: the password or API token for the SMTP user you configured
+  above. If your relay does not require authentication, remove the
+  `SMTP_PASSWORD` entry from `env.secret` in `config/deploy.yml` instead.
+
+Kamal reads this file on your machine and passes the values to the container at
+runtime; they are never baked into the image. If you fill in real values, keep
+them out of version control.
+
+### Optional: browser push notifications
+
+Fizzy can send web push notifications if you supply a VAPID key pair. Generate
+one and add the keys to `config/deploy.yml` (`VAPID_PUBLIC_KEY` under
+`env.clear`, `VAPID_PRIVATE_KEY` under `env.secret`) and to `.kamal/secrets`:
+
+```sh
+bin/rails runner 'require "web-push"; key = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{key.private_key}"; puts "VAPID_PUBLIC_KEY=#{key.public_key}"'
+```
+
+Browser push notifications are optional; the rest of Fizzy works without them.
+
+## 3. Deploy
+
+From your checkout, run:
+
+```sh
+bin/kamal setup
+```
+
+(If you have Kamal installed globally, `kamal setup` works the same way.)
+
+`setup` installs Docker on the server if needed, builds the image, starts
+kamal-proxy, requests a certificate for your hostname, creates the persistent
+volume, runs `bin/rails db:prepare`, and boots the app. The first run can take
+a while because the Ruby gems and assets are built from scratch. Subsequent
+deploys use:
+
+```sh
+bin/kamal deploy
+```
+
+Open `https://your-host` when it finishes. Because a fresh instance has no
+accounts, the first person to sign up becomes the owner of the first account.
+
+## Data persistence
+
+The named volume `fizzy` is mounted at `/rails/storage`. It holds:
+
+- `production.sqlite3`: the primary database.
+- `production_cable.sqlite3`, `production_cache.sqlite3`,
+  `production_queue.sqlite3`: Action Cable, cache, and Solid Queue data.
+- `production/files`: Active Storage uploads.
+
+Kamal replaces the container on every deploy but reattaches the same volume, so
+your data survives deploys. It is still a single box: take regular backups.
+The most reliable option is a snapshot of the volume from your hosting
+provider. You can also back it up from the server:
+
+```sh
+ssh root@your-server \
+  'docker run --rm -v fizzy:/data -v /tmp:/backup alpine \
+     tar czf /backup/fizzy.tgz -C /data .'
+```
+
+Note that SQLite databases are being written while the app runs; pause writes
+or snapshot the server for a fully consistent backup. `kamal remove` removes
+the app and proxy containers, but the named volume is left alone.
+
+## Background jobs
+
+Jobs run inside the same container as the web server: `SOLID_QUEUE_IN_PUMA` is
+set to `true` in `config/deploy.yml`, and Puma starts the Solid Queue
+supervisor. Recurring tasks in `config/recurring.yml` are registered when the
+queue starts, so there is no separate worker to deploy.
+
+The deploy config also keeps `WEB_CONCURRENCY` and `JOB_CONCURRENCY` at `1` so
+a small box is not overwhelmed. Raise both on a server with more capacity.
+
+View the logs with:
+
+```sh
+bin/kamal app logs -f
+```
+
+## Updating and troubleshooting
+
+Deploying a newer version is just:
+
+```sh
+git pull
+bin/kamal deploy
+```
+
+Useful commands:
+
+```sh
+bin/kamal console          # Rails console inside the app container
+bin/kamal shell            # shell inside the app container
+bin/kamal app logs -f      # application and job logs
+bin/kamal rollback <version>
+```
+
+If the certificate cannot be issued, check that DNS resolves to the server and
+that ports 80 and 443 are open. If Kamal cannot connect, check `ssh
+root@your-server` and the `ssh.user` setting. For mail problems, check the app
+logs for `Net::SMTP` errors, and verify the address, port, credentials, and TLS
+mode against your provider's documentation.
+
+To use a different registry (for example GHCR or Docker Hub) or a remote build
+server, adjust the `registry` and `builder` sections in `config/deploy.yml`.
+See the [Kamal documentation](https://kamal-deploy.org/docs/configuration/) for
+all available options.
