+  ActionText::RichText.include Storage::RichTextTracking
+
+  Storage::RecalculationJob = Storage::RecalculateJob
+  Storage::UsageJob = Storage::RecalculateJob
+  Storage::BytesUsedJob = Storage::RecalculateJob
+
+  Board::RecalculateStorageJob = Storage::RecalculateJob
+  Board::RecalculateBytesUsedJob = Storage::RecalculateJob
+  Board::StorageUsageJob = Storage::RecalculateJob
+
+  Account::RecalculateStorageJob = Storage::RecalculateJob
+  Account::RecalculateBytesUsedJob = Storage::RecalculateJob
+  Account::StorageUsageJob = Storage::RecalculateJob
+end
