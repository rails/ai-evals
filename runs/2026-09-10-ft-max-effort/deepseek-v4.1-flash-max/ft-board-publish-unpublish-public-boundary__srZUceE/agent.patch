+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@board.public_key), class: "btn btn--back btn--circle-mobile" do %>
+      <%= icon_tag "arrow-left" %>
+      <strong class="overflow-ellipsis">Back to <%= @board.name %></strong>
+    <% end %>
+  </div>
+<% end %>
+
+<div class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <header class="card__header">
+        <div class="card__id">
+          <span class="for-screen-reader">Card number</span>
+          <%= @card.number %>
+        </div>
+        <%= render "cards/display/preview/tags", card: @card %>
+        <%= render "cards/display/preview/steps", card: @card %>
+      </header>
+
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title"><span class="card__title-link"><%= card_html_title(@card) %></span></h1>
+
+          <% if @card.description.present? %>
+            <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= @card.description %>
+            </div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ol class="steps txt-small margin-block-start">
+              <% @card.steps.each do |step| %>
+                <li class="step">
+                  <%= tag.input type: "checkbox", class: "checkbox", checked: step.completed?, disabled: true %>
+                  <span class="step__content"><%= step.content %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        </div>
+
+        <%= render "cards/display/common/stamp", card: @card %>
+      </div>
+
+      <footer class="card__footer">
+        <div class="card__meta">
+          <span class="card__meta-text card__meta-text--author">By <strong><%= @card.creator.name %></strong></span>
+          <span class="card__meta-text card__meta-text--updated">
+            <%= icon_tag "refresh--meta" %> Updated <%= local_datetime_tag(@card.last_active_at, style: :daysago) %>
+          </span>
+          <% if @card.assignees.any? %>
+            <span class="card__meta-text card__meta-text--assignees">
+              Assigned to <%= @card.assignees.map(&:familiar_name).to_sentence %>
+            </span>
+          <% end %>
+        </div>
+        <%= render "cards/display/common/background", card: @card %>
+      </footer>
+    <% end %>
+  </div>
+</div>
+
+<section class="comments flex flex-column gap">
+  <h2 class="txt-large divider">Comments</h2>
+
+  <% @comments.each do |comment| %>
+    <div id="<%= dom_id(comment) %>" class="comment align-start full-width">
+      <figure class="comment__avatar flex-item-no-shrink" aria-hidden="true">
+        <%= avatar_preview_tag comment.creator %>
+      </figure>
+
+      <div class="comment__content flex flex-column flex-item-grow full-width">
+        <div class="comment__author flex align-center gap-half">
+          <h3 class="font-weight-normal txt-normal"><strong><%= comment.creator.name %></strong></h3>
+          <span class="txt-subtle"><%= local_datetime_tag comment.created_at, style: :agoorweekday %>, <%= local_datetime_tag comment.created_at, style: :time %></span>
+        </div>
+
+        <div class="comment__body lexxy-content">
+          <%= comment.body %>
+        </div>
+      </div>
+    </div>
+  <% end %>
+</section>
