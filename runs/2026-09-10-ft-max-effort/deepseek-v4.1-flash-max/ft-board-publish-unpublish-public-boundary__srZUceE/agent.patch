diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..1bce6e5
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,51 @@
+module Board::Publication
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def publish
+    update!(public_key: generate_public_key)
+  end
+  alias_method :publish!, :publish
+
+  def unpublish
+    update!(public_key: nil)
+  end
+  alias_method :unpublish!, :unpublish
+
+  def published?
+    public_key.present?
+  end
+  alias_method :public?, :published?
+
+  def publicly_accessible?
+    published?
+  end
+
+  def public_url(**url_options)
+    return unless published?
+
+    Rails.application.routes.url_helpers.public_board_url(
+      public_key,
+      **default_url_options.merge(script_name: nil).merge(url_options)
+    )
+  end
+
+  private
+    def generate_public_key
+      loop do
+        candidate = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+        break candidate unless self.class.exists?(public_key: candidate)
+      end
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
