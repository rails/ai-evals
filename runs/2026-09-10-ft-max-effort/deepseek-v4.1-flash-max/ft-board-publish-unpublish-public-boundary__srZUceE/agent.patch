diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..a79d57c
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,33 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.turbo_stream { render_publication_update notice: "Board published" }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.turbo_stream { render_publication_update notice: "Board unpublished" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def render_publication_update(notice:)
+      render turbo_stream: [
+        turbo_stream.replace([ @board, :publication ], partial: "boards/edit/publication", locals: { board: @board }),
+        turbo_stream_flash(notice: notice)
+      ]
+    end
+end
