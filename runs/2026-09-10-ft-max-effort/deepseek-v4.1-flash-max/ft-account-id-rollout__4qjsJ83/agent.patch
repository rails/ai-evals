diff --git a/config/initializers/tenanting/record_accounts.rb b/config/initializers/tenanting/record_accounts.rb
new file mode 100644
index 0000000..1d7a3b8
--- /dev/null
+++ b/config/initializers/tenanting/record_accounts.rb
@@ -0,0 +1,18 @@
+# Records created through Rails frameworks (Active Storage, Action Text) need
+# to carry account_id like every other account-owned row. They inherit it from
+# the record they are attached to, or from the request/job's Current.account.
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob&.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob&.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) }
+end
