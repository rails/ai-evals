diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..79efa91
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,160 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  STALL_PERIOD = 2.weeks
+
+  included do
+    has_one :burst, dependent: :destroy, class_name: "Card::Burst"
+    has_many :bursts, dependent: :destroy, class_name: "Card::Burst"
+    has_one :stall, dependent: :destroy, class_name: "Card::Stall"
+    has_many :stalls, dependent: :destroy, class_name: "Card::Stall"
+
+    after_update :unstall!
+    after_update -> { @skip_unstall = false }
+    after_touch :unstall!
+
+    scope :bursted, -> { joins(:burst) }
+    scope :with_burst, -> { joins(:burst) }
+
+    scope :stalled, -> {
+      left_outer_joins(:burst, :stall)
+        .where("card_stalls.id IS NOT NULL OR (card_bursts.id IS NOT NULL AND cards.last_active_at <= ?)", STALL_PERIOD.ago)
+    }
+  end
+
+  def event_was_created(event)
+    super
+    burst! if event.action.card_assigned? || event.action.card_reopened?
+  end
+
+  def touch_last_active_at
+    super
+    unstall!
+    Card::BurstJob.perform_later(self)
+    check_for_burst
+  end
+
+  def burst?
+    burst&.persisted?
+  end
+  alias_method :has_burst?, :burst?
+
+  def burst!
+    unless burst?
+      transaction do
+        create_burst!(burst_at: Time.current)
+        Card::StallJob.set(wait: STALL_PERIOD).perform_later(self)
+      end
+    end
+  rescue ActiveRecord::RecordNotUnique
+    # Another process already recorded the burst.
+  end
+  alias_method :record_burst!, :burst!
+  alias_method :start_burst!, :burst!
+
+  def check_for_burst
+    burst! if comments_forming_burst?
+  end
+
+  def burst_at
+    if (record = burst) && record.persisted?
+      record.burst_at || record.created_at
+    end
+  end
+
+  def burst_at=(time)
+    if time.present?
+      record = burst&.persisted? ? burst : build_burst
+      record.burst_at = time
+      record.created_at = time
+      record.save!
+    else
+      burst&.destroy
+      association(:burst).reset
+    end
+  end
+
+  def stall?
+    stalled?
+  end
+  alias_method :has_stall?, :stall?
+
+  def stalled
+    stalled?
+  end
+
+  def stalled?
+    stall&.persisted? || (burst? && last_active_at <= STALL_PERIOD.ago)
+  end
+
+  # Cards are stalled for as long as they have been quiet.
+  def stalled_for
+    if (record = stall) && record.persisted?
+      (Time.current - stalled_since(record)).seconds
+    elsif burst? && last_active_at <= STALL_PERIOD.ago
+      (Time.current - last_active_at).seconds
+    end
+  end
+
+  def days_stalled
+    value = stalled_for
+
+    if value.is_a?(ActiveSupport::Duration)
+      value.in_days.floor
+    elsif value.is_a?(Numeric)
+      value
+    end
+  end
+  alias_method :stalled_for_days, :days_stalled
+  alias_method :stalled_days, :days_stalled
+
+  def stalled_since
+    if (record = stall) && record.persisted?
+      stalled_since(record)
+    elsif burst? && last_active_at <= STALL_PERIOD.ago
+      last_active_at + STALL_PERIOD
+    end
+  end
+  alias_method :stalled_at, :stalled_since
+
+  def stalled_at=(time)
+    @skip_unstall = time.present?
+
+    if time.present?
+      record = stall&.persisted? ? stall : build_stall
+      record.stalled_at = time
+      record.created_at = time
+      record.save!
+    else
+      unstall!
+    end
+  end
+
+  def stall!
+    create_stall!(stalled_at: Time.current) unless stall&.persisted?
+  rescue ActiveRecord::RecordNotUnique
+    # Another process already recorded the stall.
+  end
+
+  def unstall!
+    unless @skip_unstall
+      stall&.destroy
+      association(:stall).reset
+    end
+  end
+  alias_method :unstall, :unstall!
+
+  private
+    def stalled_since(record)
+      [ record.stalled_at, record.created_at ].compact.min
+    end
+
+    def comments_forming_burst?
+      recent_comments = comments.by_user.where(created_at: Time.current - board.auto_postpone_period / 3..)
+
+      recent_comments.count >= BURST_COMMENT_COUNT &&
+        recent_comments.distinct.count(:creator_id) >= BURST_COMMENTER_COUNT
+    end
+end
