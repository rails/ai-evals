--- /dev/null
+++ b/app/jobs/push/notification_job.rb
@@ -0,0 +1,27 @@
+class Push::NotificationJob < ApplicationJob
+  queue_as :default
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(record, target = nil)
+    if record.is_a?(Push::Subscription)
+      target = payload_for(target) if target.present?
+      record.deliver(target)
+    elsif target.is_a?(Push::Subscription)
+      target.deliver(payload_for(record))
+    else
+      record.push
+    end
+  end
+
+  private
+    def payload_for(record)
+      if record.is_a?(Push::Notification)
+        record.payload
+      elsif record.is_a?(Notification)
+        Push::Notification.new(record).payload
+      else
+        record
+      end
+    end
+end
