@@ -0,0 +1,45 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @push_subscription.assign_attributes(subscription_params.merge(user_agent: request.user_agent))
+
+    if @push_subscription.save
+      head :created
+    else
+      render json: { errors: @push_subscription.errors.full_messages }, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    subscription = find_subscription
+    subscription&.destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def find_subscription
+      if params[:id].present?
+        @user.push_subscriptions.find_by(id: params[:id])
+      else
+        @user.push_subscriptions.find_by(endpoint: params[:endpoint])
+      end
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..69bfdbd
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,184 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "toggle" ]
+  static values = { url: String, vapidPublicKey: String }
+
+  connect() {
+    if (!this.#supported) {
+      this.#showDetails()
+      this.#setEnabled(false)
+      return
+    }
+
+    this.#restoreState()
+  }
+
+  async toggle() {
+    if (this.#enabled) {
+      await this.disable()
+    } else {
+      await this.enable()
+    }
+  }
+
+  async subscribe() {
+    await this.enable()
+  }
+
+  async unsubscribe() {
+    await this.disable()
+  }
+
+  async enable() {
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    this.#setBusy(true)
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission !== "granted") {
+        this.#showDetails()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription() ||
+        await this.#subscribe(registration)
+
+      await this.#save(subscription)
+      this.#hideDetails()
+      this.#setEnabled(true)
+    } catch (error) {
+      console.error(error)
+      this.#showDetails()
+      this.#setEnabled(false)
+    } finally {
+      this.#setBusy(false)
+    }
+  }
+
+  async disable() {
+    this.#setBusy(true)
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#remove(subscription)
+        await subscription.unsubscribe()
+      }
+
+      this.#hideDetails()
+      this.#setEnabled(false)
+    } catch (error) {
+      console.error(error)
+    } finally {
+      this.#setBusy(false)
+    }
+  }
+
+  // Private
+
+  async #restoreState() {
+    if (Notification.permission === "denied") {
+      this.#showDetails()
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+      const enabled = subscription !== null && Notification.permission === "granted"
+
+      if (enabled) {
+        await this.#save(subscription)
+        this.#hideDetails()
+      }
+
+      this.#setEnabled(enabled)
+    } catch (error) {
+      console.error(error)
+      this.#setEnabled(false)
+    }
+  }
+
+  #subscribe(registration) {
+    if (!this.vapidPublicKeyValue) {
+      throw new Error("Missing VAPID public key")
+    }
+
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#decodeBase64(this.vapidPublicKeyValue)
+    })
+  }
+
+  async #save(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    await new FetchRequest("post", this.urlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      }
+    }).perform()
+  }
+
+  async #remove(subscription) {
+    const url = new URL(this.urlValue, window.location.origin)
+    url.searchParams.set("endpoint", subscription.endpoint)
+
+    await new FetchRequest("delete", url.toString()).perform()
+  }
+
+  #setEnabled(enabled) {
+    this.#enabled = enabled
+    this.element.classList.toggle("notifications--on", enabled)
+
+    if (this.hasToggleTarget) {
+      this.toggleTarget.setAttribute("aria-pressed", enabled.toString())
+    }
+  }
+
+  #setBusy(busy) {
+    if (this.hasToggleTarget) {
+      this.toggleTarget.disabled = busy
+    }
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach((details) => details.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach((details) => details.hidden = true)
+  }
+
+  #decodeBase64(value) {
+    const padding = "=".repeat((4 - value.length % 4) % 4)
+    const base64 = (value + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let index = 0; index < rawData.length; index++) {
+      outputArray[index] = rawData.charCodeAt(index)
+    }
+
+    return outputArray
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      "Notification" in window
+  }
+}
