+++ b/app/models/push/notification.rb
@@ -0,0 +1,67 @@
+class Push::Notification
+  include NotificationsHelper
+
+  attr_reader :notification
+  delegate :account, :card, :creator, :source, :user, to: :notification
+
+  def initialize(notification = nil, title: nil, body: nil, url: nil)
+    @notification = notification
+    @title = title
+    @body = body
+    @url = url
+  end
+
+  def deliver
+    return if source.nil? || card.nil?
+
+    Push::Subscription.push(user, payload)
+  end
+
+  def push
+    deliver
+  end
+
+  def title
+    return @title if @title
+
+    if source.is_a?(Mention)
+      "#{source.mentioner.first_name} @mentioned you"
+    else
+      event_notification_title(source)
+    end
+  end
+
+  def body
+    return @body if @body
+
+    if source.is_a?(Mention)
+      source.source.mentionable_content.truncate(200)
+    else
+      event_notification_body(source)
+    end
+  end
+
+  def url
+    @url || Rails.application.routes.url_helpers.card_url(card, **url_options)
+  end
+
+  def as_json(*)
+    { title: title, body: body, url: url }
+  end
+
+  def payload
+    as_json.to_json
+  end
+  alias_method :message, :payload
+
+  def to_json(*)
+    payload
+  end
+
+  private
+    def url_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence || {}
+      options.to_h.symbolize_keys.merge(script_name: account.slug)
+    end
+end
