diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..dec165c
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,64 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  class << self
+    def push(...)
+      deliver(...)
+    end
+
+    def deliver(user, payload)
+      payload = Push::Notification.new(payload).payload if payload.is_a?(Notification)
+      payload = payload.payload if payload.is_a?(Push::Notification)
+
+      user.push_subscriptions.find_each do |subscription|
+        subscription.push(payload)
+      end
+    end
+  end
+
+  belongs_to :account, default: -> { user&.account }
+  belongs_to :user
+
+  scope :ordered, -> { order(created_at: :asc) }
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, presence: true
+  validates :auth_key, presence: true
+  validate :validate_endpoint
+
+  def deliver(payload = nil, title: nil, body: nil, url: nil, message: nil, **)
+    payload ||= message || { title:, body:, url: }
+    payload = payload.to_json if payload.is_a?(Hash)
+
+    WebPush.payload_send(
+      message: payload,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  def push(...)
+    deliver(...)
+  end
+
+  def notify(...)
+    deliver(...)
+  end
+
+  private
+    def validate_endpoint
+      return if endpoint.blank?
+
+      uri = URI.parse(endpoint)
+
+      unless uri.is_a?(URI::HTTP) && uri.host.present?
+        errors.add(:endpoint, "must be a valid HTTP URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be a valid HTTP URL")
+    end
+end
