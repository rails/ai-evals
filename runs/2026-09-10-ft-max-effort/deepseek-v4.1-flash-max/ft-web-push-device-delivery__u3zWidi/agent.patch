diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..9d2b4e2 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,42 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+self.addEventListener("push", (event) => {
+  if (!event.data) return
+
+  let data
+
+  try {
+    data = event.data.json()
+  } catch {
+    data = { title: "Fizzy", body: event.data.text() }
+  }
+
+  const { title = "Fizzy", body, url } = data
+
+  event.waitUntil(
+    self.registration.showNotification(title, {
+      body,
+      icon: "/app-icon-192.png",
+      badge: "/app-icon-192.png",
+      data: { url },
+      tag: url
+    })
+  )
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url
+  if (!url) return
+
+  event.waitUntil(
+    self.clients.matchAll({ type: "window", includeUncontrolled: true }).then((clients) => {
+      const client = clients.find((client) => client.url === url)
+      return client ? client.focus() : self.clients.openWindow(url)
+    })
+  )
+})
+
 TurboOffline.start()
