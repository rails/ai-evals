index 0000000..50f8a15
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,429 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+  NEAR_LIMIT_THRESHOLD = 100
+  LIMIT_WARNING_THRESHOLD = 100
+  DEFAULT_CARD_LIMIT = 1_000
+  CARD_LIMIT = 1_000
+
+  included do
+    has_many :subscriptions, class_name: "Account::Subscription"
+    has_one :subscription, -> { recent }, class_name: "Account::Subscription", dependent: :destroy
