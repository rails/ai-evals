diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..f7d2148 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,103 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  # Has and belongs to many join tables that don't carry an account_id of
+  # their own, so they have to be cleaned up explicitly.
+  FILTER_JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  included do
+    scope :due_for_incineration, -> {
+      where(id: Account::Cancellation.where(created_at: ...INCINERATION_GRACE_PERIOD.ago).select(:account_id))
+    }
+
+    scope :incineratable, -> { due_for_incineration }
+    scope :cancelled, -> { joins(:cancellation) }
+    scope :cancelled_before, ->(time) { joins(:cancellation).where(account_cancellations: { created_at: ...time }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+
+    def incineration_models
+      @incineration_models ||= {}
+    end
+  end
+
+  def incineration_due?
+    cancellation.present? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+  alias_method :due_for_incineration?, :incineration_due?
+
+  def incinerate
+    transaction do
+      delete_filter_joins
+      delete_storage_totals
+      delete_search_index
+      delete_account_data
+      delete
+    end
+  end
+
+  private
+    def delete_filter_joins
+      if filter_ids = Filter.where(account_id: id).ids.presence
+        FILTER_JOIN_TABLES.each do |table_name|
+          model_for_table(table_name).where(filter_id: filter_ids).delete_all
+        end
+      end
+    end
+
+    def delete_storage_totals
+      board_ids = Board.where(account_id: id).ids
+
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all if board_ids.present?
+    end
+
+    def delete_search_index
+      search_record_class = Search::Record.for(id)
+      search_record_ids = search_record_class.where(account_id: id).ids
+
+      search_record_class.where(account_id: id).delete_all
+
+      # SQLite keeps search records in a companion FTS table; MySQL shards are keyed by account_key.
+      if search_record_ids.present? && search_record_class.column_names.exclude?("account_key")
+        Search::Record::SQLite::Fts.where(rowid: search_record_ids).delete_all
+      end
+    end
+
+    def delete_account_data
+      account_scoped_tables.each do |table_name|
+        model_for_table(table_name).where(account_id: id).delete_all
+      end
+    end
+
+    def account_scoped_tables
+      self.class.connection.tables.select do |table_name|
+        account_id_column?(table_name) && !search_record_table?(table_name)
+      end
+    end
+
+    def account_id_column?(table_name)
+      self.class.connection.columns(table_name).any? { |column| column.name == "account_id" }
+    end
+
+    def search_record_table?(table_name)
+      table_name == "search_records" || table_name.start_with?("search_records_")
+    end
+
+    def model_for_table(table_name)
+      self.class.incineration_models[table_name] ||= Class.new(ActiveRecord::Base) { self.table_name = table_name }
+    end
 end
