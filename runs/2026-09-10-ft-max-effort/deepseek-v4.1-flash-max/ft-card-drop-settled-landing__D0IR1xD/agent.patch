diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..bab5b64
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,263 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const CARD_SELECTOR = "article.card"
+const COLUMN_SELECTOR = "[data-drag-and-drop-place]"
+
+export default class extends Controller {
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+  }
+
+  // Actions
+
+  dragStart(event) {
+    const card = event.target.closest(CARD_SELECTOR)
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard?.classList.remove(DRAGGED_CLASS)
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(COLUMN_SELECTOR)
+    card.classList.add(DRAGGED_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.#highlightColumnFor(event)
+  }
+
+  dragOver(event) {
+    this.#highlightColumnFor(event)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFor(event.target)
+
+    if (column && column !== this.hoveredColumn) return
+    if (this.hoveredColumn?.contains(event.relatedTarget)) return
+
+    this.#clearHighlight()
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const column = this.#columnFor(event.target)
+    if (!card || !column) return
+
+    event.preventDefault()
+
+    if (column !== this.sourceColumn) {
+      this.#moveCardTo(card, column)
+      this.#updateCounts(this.sourceColumn, column)
+      this.#save(card, column)
+    }
+
+    this.dragEnd()
+  }
+
+  dragEnd() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(DRAGGED_CLASS)
+    }
+
+    this.#clearHighlight()
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  // Private
+
+  #highlightColumnFor(event) {
+    const column = this.#columnFor(event.target)
+    if (!column) return
+
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    if (column !== this.hoveredColumn) {
+      this.#clearHighlight()
+      this.hoveredColumn = column
+      column.classList.add(HOVER_CLASS)
+    }
+  }
+
+  #clearHighlight() {
+    this.hoveredColumn?.classList.remove(HOVER_CLASS)
+    this.hoveredColumn = null
+  }
+
+  #columnFor(target) {
+    const column = target?.closest(COLUMN_SELECTOR)
+    if (column && this.element.contains(column)) {
+      return column
+    }
+  }
+
+  #moveCardTo(card, column) {
+    const list = column.querySelector(".cards__list")
+    if (!list) {
+      this.#keepCardAfterFrameLoad(card, column)
+      return
+    }
+
+    const container = this.#cardContainerFor(list)
+    const reference = this.#insertionPointFor(card, column, list)
+
+    this.#updateCardColumn(card, column)
+
+    if (reference) {
+      reference.parentNode.insertBefore(card, reference)
+    } else {
+      container.append(card)
+    }
+
+    this.#keepCardAfterFrameLoad(card, column)
+  }
+
+  #cardContainerFor(list) {
+    const card = list.querySelector("article.card")
+    return card ? card.parentNode : list
+  }
+
+  #insertionPointFor(card, column, list) {
+    const cards = [ ...list.querySelectorAll("article.card") ]
+    const place = column.dataset.dragAndDropPlace
+
+    if (place === "not_now" || place === "closed") {
+      return cards[0] || null
+    }
+
+    const isGolden = card.classList.contains("golden-effect")
+    return cards.find(other => isGolden || !other.classList.contains("golden-effect")) || null
+  }
+
+  #updateCardColumn(card, column) {
+    const columnId = column.dataset.dragAndDropColumnId
+
+    card.querySelectorAll(".card__stages .card__column-name").forEach(element => {
+      element.classList.toggle("card__column-name--current", element.dataset.dragAndDropColumnId === columnId)
+    })
+
+    this.#updateColumnBadge(card, column)
+    this.#updateCardStatus(card, column)
+  }
+
+  #updateColumnBadge(card, column) {
+    const badge = card.querySelector(".card__header .card__column-name--current")
+
+    if (column.dataset.dragAndDropPlace === "column") {
+      const name = column.dataset.columnName
+      const label = badge?.querySelector(".overflow-ellipsis")
+
+      if (badge && label) {
+        label.textContent = name
+      } else if (badge) {
+        badge.textContent = name
+      } else {
+        this.#insertColumnBadge(card, name)
+      }
+    } else {
+      badge?.remove()
+    }
+  }
+
+  #insertColumnBadge(card, name) {
+    const header = card.querySelector(".card__header")
+    if (!header) return
+
+    const badge = document.createElement("span")
+    badge.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+    const label = document.createElement("span")
+    label.className = "overflow-ellipsis"
+    label.textContent = name
+
+    badge.append(label)
+    header.append(badge)
+  }
+
+  #updateCardStatus(card, column) {
+    const place = column.dataset.dragAndDropPlace
+    card.classList.toggle("card--postponed", place === "not_now")
+    card.classList.toggle("card--active", place === "maybe" || place === "column")
+  }
+
+  #keepCardAfterFrameLoad(card, column) {
+    const frame = column.querySelector("turbo-frame[src]")
+    if (!frame || frame.complete) return
+
+    frame.addEventListener("turbo:frame-load", () => {
+      const list = column.querySelector(".cards__list")
+      if (!list || card.isConnected) return
+
+      const alreadyPresent = [ ...list.querySelectorAll("article.card") ].some(element => element.id === card.id)
+      if (!alreadyPresent) {
+        this.#cardContainerFor(list).append(card)
+      }
+    }, { once: true })
+  }
+
+  async #save(card, column) {
+    const sourceColumn = this.sourceColumn
+
+    try {
+      const place = column.dataset.dragAndDropPlace
+      const triageUrl = card.dataset.cardTriageUrl
+
+      if (place === "column") {
+        await this.#assertSuccessful(post(triageUrl, { responseKind: "json", body: { column_id: column.dataset.dragAndDropColumnId } }))
+      } else if (place === "maybe") {
+        await this.#assertSuccessful(destroy(triageUrl, { responseKind: "json" }))
+      } else if (place === "not_now") {
+        await this.#assertSuccessful(post(card.dataset.dragAndDropNotNowUrl, { responseKind: "json" }))
+      } else if (place === "closed") {
+        await this.#assertSuccessful(post(card.dataset.dragAndDropClosureUrl, { responseKind: "json" }))
+      }
+    } catch (error) {
+      console.error("Failed to move card", error)
+      this.#restoreCard(card, sourceColumn, column)
+    }
+  }
+
+  async #assertSuccessful(request) {
+    const response = await request
+
+    if (!response.ok) {
+      throw new Error(`Card move failed with status ${response.statusCode}`)
+    }
+  }
+
+  #restoreCard(card, sourceColumn, targetColumn) {
+    if (sourceColumn) {
+      this.#moveCardTo(card, sourceColumn)
+      this.#updateCounts(targetColumn, sourceColumn)
+    }
+  }
+
+  #updateCounts(fromColumn, toColumn) {
+    this.#changeCount(fromColumn, -1)
+    this.#changeCount(toColumn, 1)
+  }
+
+  #changeCount(column, delta) {
+    const counter = column?.querySelector(".cards__expander-count")
+    if (!counter || counter.textContent.includes("+")) return
+
+    const count = Number.parseInt(counter.textContent, 10)
+    if (Number.isNaN(count)) return
+
+    const nextCount = Math.max(count + delta, 0)
+    counter.textContent = nextCount > 99 ? "99+" : `${nextCount}`
+  }
+}
