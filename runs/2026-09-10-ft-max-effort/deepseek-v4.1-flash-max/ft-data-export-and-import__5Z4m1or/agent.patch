diff --git a/app/mailers/account_mailer.rb b/app/mailers/account_mailer.rb
index 5cb6616..33b8a83 100644
--- a/app/mailers/account_mailer.rb
+++ b/app/mailers/account_mailer.rb
@@ -8,4 +8,73 @@ class AccountMailer < ApplicationMailer
       subject: "Your Fizzy account was cancelled"
     )
   end
+
+  def export_ready(export)
+    @export = export
+    @user = export.user
+    @account = export.account
+    @download_url = export_download_url(export)
+    @export_url = account_export_url(export)
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy export is ready"
+    )
+  end
+
+  def export_failed(export)
+    @export = export
+    @user = export.user
+    @account = export.account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy export failed"
+    )
+  end
+  alias_method :export_completed, :export_ready
+  alias_method :export_finished, :export_ready
+  alias_method :export_failure, :export_failed
+
+  def import_completed(import)
+    @import = import
+    @user = import.user
+    @account = import.imported_account || import.account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy import is complete"
+    )
+  end
+  alias_method :import_ready, :import_completed
+  alias_method :import_finished, :import_completed
+  alias_method :import_complete, :import_completed
+  alias_method :import_done, :import_completed
+
+  def import_failed(import)
+    @import = import
+    @user = import.user
+    @account = import.account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy import failed"
+    )
+  end
+  alias_method :import_failure, :import_failed
+
+  private
+    def export_download_url(export)
+      return unless export.file.attached?
+
+      ActiveStorage::Current.url_options = active_storage_url_options
+      export.file.url(expires_in: Account::Export::DOWNLOAD_LINK_EXPIRY_DURATION, disposition: :attachment, filename: export.file.filename)
+    end
+
+    def active_storage_url_options
+      default_url_options.dup.tap do |options|
+        options[:protocol] ||= "https"
+        options[:port] ||= nil
+      end
+    end
 end
