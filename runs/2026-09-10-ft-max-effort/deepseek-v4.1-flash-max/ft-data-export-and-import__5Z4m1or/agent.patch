+class Users::ExportsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_can_export
+  before_action :set_active_storage_url_options, only: %i[ show ]
+
+  def new
+    @export = @user.exports.new
+  end
+
+  def create
+    @export = Account::Export.create_for_user!(user: @user, account: @user.account)
+
+    respond_to do |format|
+      format.html { redirect_to user_path(@user), notice: "Your export is being prepared. We'll email you when it's ready." }
+      format.json { head :created }
+    end
+  end
+
+  def show
+    @export = if params[:id].present?
+      Current.account.exports.for_user(@user).find(params[:id])
+    else
+      Current.account.exports.for_user(@user).order(created_at: :desc).first!
