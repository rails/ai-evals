diff --git a/test/integration/data_transfer_flow_test.rb b/test/integration/data_transfer_flow_test.rb
new file mode 100644
index 0000000..bdb90d4
--- /dev/null
+++ b/test/integration/data_transfer_flow_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class DataTransferFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admin can start and download an account export" do
+    assert_enqueued_with(job: Account::ExportJob) do
+      post account_exports_path
+    end
+    assert_response :redirect
+    assert_equal 1, Current.account.exports.count
+
+    export = Current.account.exports.last
+    Account::ExportJob.perform_now(export)
+    export.reload
+    assert export.completed?, export.error
+
+    get account_export_path(export)
+    assert_response :redirect
+    assert export.file.attached?
+  end
+
+  test "new import page and profile export" do
+    get new_account_import_path
+    assert_response :success
+
+    post user_exports_path(users(:kevin))
+    assert_response :redirect
+    assert_equal 1, Current.account.exports.for_user(users(:kevin)).count
+  end
+
+  test "import creates a new account with the exported data" do
+    export = Account::Export.create_for_account!(account: Current.account, user: users(:kevin))
+    Account::ExportJob.perform_now(export)
+    export.reload
+    assert export.completed?, export.error
+
+    zipfile = Tempfile.new([ "export", ".zip" ])
+    zipfile.binmode
+    export.file.download { |chunk| zipfile.write(chunk) }
+    zipfile.rewind
+
+    post account_imports_path, params: { import: { file: Rack::Test::UploadedFile.new(zipfile.path, "application/zip") } }
+    assert_response :redirect
+
+    import = Current.account.imports.last
+    assert import.pending?
+
+    assert_difference -> { Account.count }, 1 do
+      Account::ImportJob.perform_now(import)
+    end
+    import.reload
+    assert import.completed?, import.error
+
+    new_account = import.imported_account
+    assert_equal Current.account.cards.count, new_account.cards.count
+    assert_equal Current.account.boards.count, new_account.boards.count
+    assert new_account.users.any?
+    assert_equal ActionText::RichText.where(account_id: Current.account.id).count, ActionText::RichText.where(account_id: new_account.id).count
+  ensure
+    import&.imported_account&.destroy
+    import&.destroy
+    export&.destroy
+  end
+end
