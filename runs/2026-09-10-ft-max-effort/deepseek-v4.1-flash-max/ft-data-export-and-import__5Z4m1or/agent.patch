 end
diff --git a/app/models/account/data_transfer/active_storage/file_record_set.rb b/app/models/account/data_transfer/active_storage/file_record_set.rb
index 1367a49..8e23978 100644
--- a/app/models/account/data_transfer/active_storage/file_record_set.rb
+++ b/app/models/account/data_transfer/active_storage/file_record_set.rb
@@ -1,15 +1,41 @@
 class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfer::RecordSet
-  def initialize(account)
-    super(account: account, model: ::ActiveStorage::Blob)
+  def initialize(account, **options)
+    super(account: account, model: ::ActiveStorage::Blob, **options)
+  end
+
+  def record_path(record)
+    File.join(model_dir, record.id.to_s)
+  end
+
+  def write_to(zip)
+    each_record do |blob|
+      begin
+        zip.add_file record_path(blob), compress: false do |sink|
+          blob.download do |chunk|
+            sink.write chunk
+          end
+        end
