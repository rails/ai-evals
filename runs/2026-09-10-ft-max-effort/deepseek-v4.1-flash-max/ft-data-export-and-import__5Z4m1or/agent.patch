+class Account::ImportsController < ApplicationController
+  before_action :set_import, only: :show
+
+  def new
+    @import = Current.account.imports.new
+  end
+
+  def create
+    @import = Current.account.imports.new(import_params.merge(user: Current.user))
+
+    if @import.save
+      respond_to do |format|
+        format.html { redirect_to account_settings_path, notice: "Your import has started. We'll email you when it's done." }
+        format.json { head :created, location: account_import_path(@import) }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: @import.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.html
+      format.json { render json: import_json(@import) }
+    end
+  end
+
+  private
+    def set_import
+      @import = Current.account.imports.find(params[:id])
+    end
+
+    def import_params
+      if params[:import].present?
+        params.expect(import: [ :file ])
+      elsif params[:account_import].present?
+        params.expect(account_import: [ :file ])
+      else
+        params.permit(:file)
+      end
+    end
+
+    def import_json(import)
+      {
+        id: import.id,
+        status: import.status,
+        error: import.error,
+        imported_account_id: import.imported_account_id
+      }
+    end
+end
