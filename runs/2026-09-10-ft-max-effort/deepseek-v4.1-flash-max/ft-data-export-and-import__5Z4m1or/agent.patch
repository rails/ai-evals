+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,98 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: %i[ show download ]
+
+  before_action :set_active_storage_url_options
+  before_action :ensure_admin, only: %i[ index new create ]
+  before_action :set_export, only: %i[ show download ]
+  before_action :ensure_can_download, only: %i[ show download ]
+
+  def index
+    @exports = Current.account.exports.order(created_at: :desc)
+
+    respond_to do |format|
+      format.html
+      format.json { render json: @exports.map { |export| export_json(export) } }
+    end
+  end
+
+  def new
+    @export = Current.account.exports.new
+  end
+
+  def create
+    @export = Account::Export.create_for_account!(account: Current.account, user: Current.user)
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready." }
+      format.json { head :created, location: account_export_path(@export) }
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.html do
+        if @export.file.attached?
+          redirect_to @export.download_url, allow_other_host: true
+        else
+          redirect_to account_settings_path, notice: "Your export is still being prepared."
+        end
+      end
+      format.json { render json: export_json(@export) }
+    end
+  end
+
+  def download
+    if @export.file.attached?
+      redirect_to @export.download_url, allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def set_export
+      if params[:token].present?
+        @export = export_from_token
+      else
+        @export = Current.account.exports.find(params[:id])
+      end
+    end
+
+    def export_from_token
+      return if params[:token].blank?
+
+      blob = ActiveStorage::Blob.find_signed(params[:token], purpose: Account::Export::DOWNLOAD_TOKEN_PURPOSE)
+      blob&.attachments&.find_by(record_type: "Account::Export")&.record
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def ensure_can_download
+      if params[:token].present?
+        return head :gone if @export.blank?
+        head :gone unless @export.file.attached?
+      else
+        head :forbidden unless @export.present? && (@export.user_id == Current.user&.id || Current.user&.admin?)
+      end
+    end
+
+    def set_active_storage_url_options
+      ActiveStorage::Current.url_options = {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.port,
+        script_name: request.script_name
+      }
+    end
+
+    def export_json(export)
+      {
+        id: export.id,
+        scope: export.scope,
+        status: export.status,
+        error: export.error,
+        created_at: export.created_at,
+        download_url: export.file.attached? ? account_export_url(export) : nil
+      }
+    end
+end
