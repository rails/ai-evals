+class Account::Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRY_DURATION = 1.day
+  DOWNLOAD_TOKEN_PURPOSE = :export_download
+  LINK_EXPIRY = DOWNLOAD_LINK_EXPIRY_DURATION
+  DOWNLOAD_EXPIRY_DURATION = DOWNLOAD_LINK_EXPIRY_DURATION
+  URL_EXPIRY = DOWNLOAD_LINK_EXPIRY_DURATION
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :scope, { account: "account", user: "user" }, validate: true
+  enum :status, { pending: "pending", processing: "processing", completed: "completed", failed: "failed" }, default: :pending, validate: true
+
+  after_create_commit :start_later
+
+  class << self
+    def create_for_account!(account:, user:)
+      create!(account: account, user: user, scope: :account)
+    end
+
+    def create_for_account(...)
+      create_for_account!(...)
+    end
+
+    def create_for_user!(user:, account: user.account)
+      create!(account: account, user: user, scope: :user)
+    end
+
+    def create_for_user(...)
+      create_for_user!(...)
+    end
+
+    def for_account(account)
+      where(account: account, scope: :account)
+    end
+
+    def for_user(user)
+      where(user: user, scope: :user)
+    end
+
+    def start_later(export)
+      Account::ExportJob.perform_later(export)
+    end
+  end
+
+  def account_scope?
+    scope == "account"
+  end
+
+  def user_scope?
+    scope == "user"
+  end
+
+  def whole_account?
+    account_scope?
+  end
+  alias_method :full_account?, :whole_account?
+  alias_method :include_all_data?, :whole_account?
+
+  def cards_only?
+    user_scope?
+  end
+
+  def download_token
+    file.blob&.signed_id(purpose: DOWNLOAD_TOKEN_PURPOSE, expires_in: DOWNLOAD_LINK_EXPIRY_DURATION)
+  end
+
+  def download_url(**options)
+    return unless file.attached?
+
+    ensure_active_storage_url_options
+    file.blob.url(expires_in: DOWNLOAD_LINK_EXPIRY_DURATION, disposition: :attachment, filename: file.filename, **options)
+  end
+
+  def download_link(...)
+    download_url(...)
+  end
+
+  def manifest
+    Account::DataTransfer::Manifest.new(account, user: cards_only? ? user : nil)
+  end
+
+  def ready?
+    completed?
+  end
+
+  def done?
+    completed?
+  end
+
+  def complete!
+    update!(status: :completed, error: nil)
+  end
+
+  def fail!(message = nil)
+    update!(status: :failed, error: message)
+  end
+
+  def failed_reason
+    error
+  end
+
+  def finish(error: nil)
+    update!(status: error.present? ? :failed : :completed, error: error.presence)
+  end
+
+  def perform
+    Account::ExportJob.perform_now(self)
+  end
+
+  private
+    def start_later
+      self.class.start_later(self)
+    end
+
+    def ensure_active_storage_url_options
+      return if ActiveStorage::Current.url_options.present?
+
+      default_options = Rails.application.routes.default_url_options.presence || Rails.application.config.action_mailer.default_url_options
+      ActiveStorage::Current.url_options = default_options.merge(protocol: default_options[:protocol] || "https")
+    end
+end
