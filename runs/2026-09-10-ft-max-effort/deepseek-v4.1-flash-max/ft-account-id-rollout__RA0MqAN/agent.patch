diff --git a/lib/rails_ext/has_and_belongs_to_many_account_id.rb b/lib/rails_ext/has_and_belongs_to_many_account_id.rb
new file mode 100644
index 0000000..1383842
--- /dev/null
+++ b/lib/rails_ext/has_and_belongs_to_many_account_id.rb
@@ -0,0 +1,34 @@
+# HABTM join tables are plain tables without a model of their own. When the
+# join table carries an account_id, populate it from the owning record so the
+# tenant column can be NOT NULL just like other tenant tables.
+module HasAndBelongsToManyAccountId
+  def through_model
+    super.tap do |join_model|
+      join_model.before_validation do
+        if has_attribute?(:account_id) && account_id.nil?
+          owner = owner_for(join_model)
+          write_attribute :account_id, owner&.account_id || Current.account&.id
+        end
+      end
+
+      join_model.define_method(:owner_for) do |model|
+        if model.respond_to?(:left_model)
+          owner_key = model.left_model.name.foreign_key
+          if has_attribute?(owner_key)
+            owner = model.left_model.find_by(id: self[owner_key])
+            owner if owner&.has_attribute?(:account_id)
+          end
+        end
+      end
+      join_model.send(:private, :owner_for)
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_record) do
+  require "active_record/associations/builder/has_and_belongs_to_many"
+
+  ActiveRecord::Associations::Builder::HasAndBelongsToMany.prepend(
+    HasAndBelongsToManyAccountId
+  )
+end
