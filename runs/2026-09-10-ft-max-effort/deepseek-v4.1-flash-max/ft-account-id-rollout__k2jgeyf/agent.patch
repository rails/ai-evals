+        WHEN 'Account' THEN owner_id
+        WHEN 'Board' THEN (SELECT account_id FROM boards WHERE boards.id = storage_totals.owner_id)
+      END
+      WHERE storage_totals.account_id IS NULL
+    SQL
+
+    # Tags are unique per account, not globally.
+    remove_index :tags, name: "index_tags_on_title" if index_exists?(:tags, :title, name: "index_tags_on_title")
+    add_index :tags, [ :account_id, :title ], unique: true, name: "index_tags_on_account_id_and_title" unless index_exists?(:tags, [ :account_id, :title ], name: "index_tags_on_account_id_and_title")
+  end
+
+  def down
+    remove_index :tags, name: "index_tags_on_account_id_and_title" if index_exists?(:tags, [ :account_id, :title ], name: "index_tags_on_account_id_and_title")
+    add_index :tags, :title, unique: true, name: "index_tags_on_title" unless index_exists?(:tags, :title, name: "index_tags_on_title")
+
+    NEW_TABLES.each do |table|
+      remove_index table, :account_id if index_exists?(table, :account_id)
+      remove_column table, :account_id if column_exists?(table, :account_id)
+    end
+
+    EXISTING_TABLES.each do |table|
+      remove_index table, :account_id if index_exists?(table, :account_id)
+      change_column_null table, :account_id, true if column_exists?(table, :account_id)
+    end
+  end
+
+  private
+    # Tables that had no account_id at all before this migration.
+    NEW_TABLES = %i[
+      accesses
+      action_text_rich_texts
+      active_storage_attachments
+      active_storage_blobs
+      active_storage_variant_records
+      assignments
+      board_publications
+      card_activity_spikes
+      card_goldnesses
+      card_not_nows
+      closures
+      entropies
+      mentions
+      pins
+      reactions
+      search_queries
+      storage_totals
+      taggings
+      user_settings
+      watches
+      webhook_delinquency_trackers
+      webhook_deliveries
+    ].freeze
+
+    # Tables that already had an optional account_id.
+    EXISTING_TABLES = %i[
+      account_imports
+      account_join_codes
+      boards
+      cards
+      columns
+      comments
+      events
+      filters
+      notification_bundles
+      notifications
+      push_subscriptions
+      steps
+      tags
+      users
+      webhooks
+    ].freeze
+
+    def add_account_id_to(table, backfill_sql: nil)
+      add_account_column(table)
+      execute(backfill_sql) if backfill_sql
+      finalize_account_id(table)
+    end
+
+    def add_account_column(table)
+      add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+    end
+
+    def finalize_account_id(table)
+      # Any row that still has no account is not reachable from an account and
+      # is considered orphaned; drop it rather than make up an owner.
+      execute "DELETE FROM #{table} WHERE account_id IS NULL"
+
+      change_column_null table, :account_id, false
+
+      add_index table, :account_id unless index_exists?(table, :account_id)
+    end
+end
