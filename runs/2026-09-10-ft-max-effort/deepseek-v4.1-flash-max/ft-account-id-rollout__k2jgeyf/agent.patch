+end
diff --git a/config/initializers/tenanting/active_storage.rb b/config/initializers/tenanting/active_storage.rb
new file mode 100644
index 0000000..a7d569b
--- /dev/null
+++ b/config/initializers/tenanting/active_storage.rb
@@ -0,0 +1,17 @@
+# Every row stored through Active Storage belongs to the account that was
+# current when it was uploaded. Rows attached to global records (Identity)
+# still get the uploading account; their account scoping is handled by the
+# attachment record, which is validated separately.
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  # Prefer the record's account, but fall back to the blob's for records that
+  # don't belong to an account themselves (e.g. Identity avatars).
+  belongs_to :account, default: -> { record.try(:account) || blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob&.account || Current.account }
+end
