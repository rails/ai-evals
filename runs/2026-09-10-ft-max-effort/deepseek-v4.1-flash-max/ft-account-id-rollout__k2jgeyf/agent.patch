index 0000000..95cee86
--- /dev/null
+++ b/config/initializers/tenanting/action_text.rb
@@ -0,0 +1,4 @@
+# Rich text records belong to the account of the record they're attached to.
+ActiveSupport.on_load(:action_text_rich_text) do
