diff --git a/app/models/card/auto_postponer.rb b/app/models/card/auto_postponer.rb
new file mode 100644
index 0000000..e7f0c83
--- /dev/null
+++ b/app/models/card/auto_postponer.rb
@@ -0,0 +1,150 @@
+# Postpones due cards by bulk inserting their postponement records and timeline
+# entries. This avoids instantiating a Card and running its callbacks for every
+# overdue card, which is prohibitively slow once an install has many cards.
+class Card::AutoPostponer
+  BATCH_SIZE = 500
+  COMMENT_BODY = "<strong>Moved</strong> to “Not Now” due to inactivity"
+
+  def self.call(relation = Card.due_to_be_postponed)
+    new(relation).call
+  end
+
+  def initialize(relation = Card.due_to_be_postponed)
+    @relation = relation.respond_to?(:in_batches) ? relation : Card.where(id: Array(relation).map { it.try(:id) || it })
+  end
+
+  def call
+    relation.in_batches(of: BATCH_SIZE) do |cards|
+      postpone cards
+    end
+  end
+
+  private
+    attr_reader :relation
+
+    def postpone(cards)
+      attributes = cards.pluck(:id, :account_id, :board_id)
+      return if attributes.empty?
+
+      events = nil
+
+      Card.transaction do
+        now = Time.current
+        system_user_ids = system_user_ids_for(attributes)
+
+        Card::NotNow.insert_all! build_not_now_rows(attributes, system_user_ids, now)
+        Card::ActivitySpike.where(card_id: card_ids(attributes)).delete_all
+
+        events = build_event_rows(attributes, system_user_ids, now)
+        Event.insert_all! events
+        insert_system_comments events
+
+        Card.where(id: card_ids(attributes)).update_all column_id: nil, last_active_at: now, updated_at: now
+        Board.where(id: board_ids(attributes)).update_all updated_at: now
+      end
+
+      dispatch_webhooks events
+    end
+
+    def system_user_ids_for(attributes)
+      account_ids = attributes.map { it.second }.uniq
+      User.where(account_id: account_ids, role: :system).pluck(:account_id, :id).to_h
+    end
+
+    def system_user_id_for(system_user_ids, account_id)
+      system_user_ids.fetch(account_id) do
+        raise ActiveRecord::RecordNotFound, "Couldn't find system user for account #{account_id}"
+      end
+    end
+
+    def build_not_now_rows(attributes, system_user_ids, now)
+      attributes.map do |card_id, account_id, _|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account_id,
+          card_id: card_id,
+          user_id: system_user_id_for(system_user_ids, account_id),
+          created_at: now,
+          updated_at: now
+        }
+      end
+    end
+
+    def build_event_rows(attributes, system_user_ids, now)
+      attributes.map do |card_id, account_id, board_id|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account_id,
+          action: "card_auto_postponed",
+          board_id: board_id,
+          creator_id: system_user_id_for(system_user_ids, account_id),
+          eventable_id: card_id,
+          eventable_type: "Card",
+          particulars: {},
+          created_at: now,
+          updated_at: now
+        }
+      end
+    end
+
+    def insert_system_comments(events)
+      comments = []
+      rich_texts = []
+
+      events.each do |event|
+        comment_id = ActiveRecord::Type::Uuid.generate
+
+        comments << {
+          id: comment_id,
+          account_id: event[:account_id],
+          card_id: event[:eventable_id],
+          creator_id: event[:creator_id],
+          created_at: event[:created_at],
+          updated_at: event[:created_at]
+        }
+
+        rich_texts << {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: event[:account_id],
+          body: COMMENT_BODY,
+          name: "body",
+          record_id: comment_id,
+          record_type: "Comment",
+          created_at: event[:created_at],
+          updated_at: event[:created_at]
+        }
+      end
+
+      Comment.insert_all! comments
+      ActionText::RichText.insert_all! rich_texts
+    end
+
+    def dispatch_webhooks(events)
+      subscribed_board_ids = Webhook.active
+        .triggered_by_action("card_auto_postponed")
+        .where(board_id: board_ids_of(events))
+        .distinct
+        .pluck(:board_id)
+        .to_set
+
+      return if subscribed_board_ids.empty?
+
+      events.each do |event|
+        if subscribed_board_ids.include?(event[:board_id])
+          Event::WebhookDispatchJob.perform_later Event.new(id: event[:id])
+        end
+      end
+    end
+
+    def card_ids(attributes)
+      attributes.map(&:first)
+    end
+
+    def board_ids(attributes)
+      attributes.map(&:third).uniq
+    end
+
+    def board_ids_of(events)
+      events.map { it[:board_id] }.uniq
+    end
+end
