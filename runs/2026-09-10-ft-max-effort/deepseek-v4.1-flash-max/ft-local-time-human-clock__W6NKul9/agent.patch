diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..70cafcf 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,99 @@
 module TimeHelper
+  # Renders a <time> element carrying the raw timestamp as its datetime
+  # attribute. The LocalTime JavaScript controller turns it into a human
+  # readable date/time in the viewer's own timezone.
+  def local_time(time, format = nil, **options)
+    return if time.blank?
+
+    format = options.delete(:format) || options.delete(:type) || format || :relative
+
+    tag.time(**local_time_attributes(time, format, options)) do
+      tag.span local_time_value(time), class: "local-time-value", data: { local_time_target: "value" }
+    end
+  end
+
+  def local_date(time, format = nil, **options)
+    local_time(time, format || :date, **options)
+  end
+
+  def local_time_ago(time, format = nil, **options)
+    local_time(time, format || :time_ago, **options)
+  end
+
+  def local_datetime(time, format = nil, **options)
+    local_time(time, format || :date_time, **options)
+  end
+
+  def local_full_date(time, format = nil, **options)
+    local_time(time, format || :full_date, **options)
+  end
+
+  def local_relative_time(time, type = nil, **options)
+    type = options.delete(:type) || type || :relative
+
+    case type&.to_sym
+    when :time_ago
+      local_time_ago(time, **options)
+    when :weekday
+      local_time(time, :weekday, **options)
+    when :weekday_or_date
+      local_time(time, :weekday_or_date, **options)
+    when :time_or_date
+      local_time(time, :relative, **options)
+    else
+      local_time(time, :relative, **options)
+    end
+  end
+
+  def time_ago(time, format = nil, **options)
+    local_time_ago(time, format, **options)
+  end
+
+  alias_method :local_time_tag, :local_time
+  alias_method :local_date_tag, :local_date
+  alias_method :local_time_ago_tag, :local_time_ago
+
+  def relative_time(time, format = nil, **options)
+    local_time(time, format || :relative, **options)
+  end
+
+  private
+    def local_time_attributes(time, format, options)
+      data = options.delete(:data) || {}
+      format = local_time_format(format)
+
+      {
+        datetime: local_time_value(time),
+        class: [ "local-time", options.delete(:class) ].compact.join(" "),
+        data: data.merge(
+          controller: "local-time",
+          local: format,
+          local_time_format: format,
+          local_time_format_value: format
+        )
+      }.merge(options)
+    end
+
+    def local_time_format(format)
+      case format.to_s
+      when "time_or_date", "relative_time", "default"
+        "relative"
+      when "ago"
+        "time-ago"
+      else
+        format.to_s.tr("_", "-")
+      end
+    end
+
+    def local_time_value(time)
+      if time.is_a?(Date) && !time.is_a?(Time)
+        time.iso8601
+      elsif time.respond_to?(:utc)
+        time.utc.iso8601
+      elsif time.respond_to?(:iso8601)
+        time.iso8601
+      else
+        time.to_s
+      end
+    end
 end
