diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..979d32f
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,41 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.datetimeObserver = new MutationObserver(() => this.#render())
+    this.datetimeObserver.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+    this.#render()
+  }
+
+  disconnect() {
+    this.datetimeObserver?.disconnect()
+  }
+
+  formatValueChanged() {
+    this.#render()
+  }
+
+  #render() {
+    const date = parseLocalTime(this.element.getAttribute("datetime"))
+    if (!date) return
+
+    const value = this.element.querySelector(".local-time-value")
+    const formatted = formatLocalTime(date, this.localFormatValue)
+
+    if (value) {
+      value.textContent = formatted
+    } else {
+      this.element.textContent = formatted
+    }
+
+    this.element.classList.add("local-time")
+    this.element.title = formatLocalTime(date, "date_time")
+  }
+
+  get localFormatValue() {
+    return this.element.dataset.local || this.formatValue
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..bfd13b4 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,152 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+const DAY_MS = 24 * 60 * 60 * 1000
+
+const formatterCache = new Map()
+
+export function formatLocalTime(date, format = "relative", referenceDate = new Date()) {
+  switch (normalizeFormat(format)) {
+    case "time":
+      return formatTimeOfDay(date)
+    case "date":
+      return formatDate(date)
+    case "date_with_year":
+      return formatDateWithYear(date)
+    case "date_time":
+      return formatDateTime(date)
+    case "full_date":
+      return formatFullDate(date)
+    case "weekday":
+      return formatWeekday(date)
+    case "weekday_or_date":
+      return weekDistance(date, referenceDate) <= 6 ? formatWeekday(date) : formatDate(date)
+    case "ago":
+    case "time_ago":
+      return formatTimeAgo(date, referenceDate)
+    case "relative":
+    default:
+      return formatRelative(date, referenceDate)
+  }
+}
+
+export function parseLocalTime(value) {
+  if (!value) return null
+
+  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  }
+
+  const date = new Date(value)
+  return Number.isNaN(date.getTime()) ? null : date
+}
+
+function formatRelative(date, referenceDate) {
+  const days = signedDifferenceInCalendarDays(date, referenceDate)
+
+  if (days === 0) {
+    return date > referenceDate ? formatFutureDuration(date - referenceDate) : formatTimeOfDay(date)
+  }
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days < 0 && days >= -6) return `${-days} days ago`
+  if (days > 0 && days <= 6) return `in ${days} days`
+
+  return formatDate(date)
+}
+
+function formatTimeAgo(date, referenceDate) {
+  const days = signedDifferenceInCalendarDays(date, referenceDate)
+
+  if (days === 0 && date > referenceDate) return formatFutureDuration(date - referenceDate)
+
+  if (days === 0) {
+    const seconds = Math.max(1, Math.round((referenceDate - date) / 1000))
+
+    if (seconds < 60) return "just now"
+
+    const minutes = Math.round(seconds / 60)
+    if (minutes < 60) return `${minutes} ${pluralize(minutes, "minute")} ago`
+
+    const hours = Math.round(minutes / 60)
+    return `${hours} ${pluralize(hours, "hour")} ago`
+  }
+
+  if (days === -1) return "yesterday"
+  if (days < -1 && days >= -6) return `${-days} days ago`
+
+  return formatDate(date)
+}
+
+function formatFutureDuration(milliseconds) {
+  const seconds = Math.round(milliseconds / 1000)
+  if (seconds < 60) return "in less than a minute"
+
+  const minutes = Math.round(seconds / 60)
+  if (minutes < 60) return `in ${minutes} ${pluralize(minutes, "minute")}`
+
+  const hours = Math.round(minutes / 60)
+  return `in ${hours} ${pluralize(hours, "hour")}`
+}
+
+function formatTimeOfDay(date, options = {}) {
+  return normalizeSpaces(intlFormatter({ hour: "numeric", minute: "2-digit", ...options }).format(date))
+}
+
+function formatDate(date) {
+  return normalizeSpaces(intlFormatter({ month: "short", day: "numeric" }).format(date))
+}
+
+function formatDateWithYear(date) {
+  return normalizeSpaces(intlFormatter({ month: "short", day: "numeric", year: "numeric" }).format(date))
+}
+
+function formatDateTime(date) {
+  return normalizeSpaces(intlFormatter({ dateStyle: "medium", timeStyle: "short" }).format(date))
+}
+
+function formatFullDate(date) {
+  return normalizeSpaces(intlFormatter({ weekday: "long", month: "long", day: "numeric" }).format(date))
+}
+
+function formatWeekday(date) {
+  return normalizeSpaces(intlFormatter({ weekday: "long" }).format(date))
+}
+
+function normalizeFormat(format) {
+  return String(format).replace(/([a-z])([A-Z])/g, "$1_$2").replace(/-/g, "_").toLowerCase()
+}
+
+function intlFormatter(options) {
+  const key = JSON.stringify(options)
+
+  if (!formatterCache.has(key)) {
+    formatterCache.set(key, new Intl.DateTimeFormat("en-US", options))
+  }
+
+  return formatterCache.get(key)
+}
+
+// Intl uses a narrow no-break space before AM/PM in newer ICU versions. The
+// server-side formatters it replaces used a regular space, so normalize it.
+function normalizeSpaces(value) {
+  return value.replace(/[\u00a0\u202f]/g, " ")
+}
+
+function signedDifferenceInCalendarDays(date, referenceDate) {
+  return calendarDayNumber(date) - calendarDayNumber(referenceDate)
+}
+
+function calendarDayNumber(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / DAY_MS
+}
+
+function weekDistance(date, referenceDate) {
+  return Math.abs(signedDifferenceInCalendarDays(date, referenceDate))
+}
+
+function pluralize(count, word) {
+  return count === 1 ? word : `${word}s`
+}
