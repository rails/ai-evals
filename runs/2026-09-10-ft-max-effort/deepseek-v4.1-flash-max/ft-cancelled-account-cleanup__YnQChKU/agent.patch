diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..bffb7d9 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,136 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  # Every account-owned table that carries an account_id. Deleting these
+  # directly is deliberate: a regular account destroy cascades through
+  # callbacks that can enqueue work or track storage for an account that is
+  # already being removed.
+  ACCOUNT_SCOPED_MODELS = %w[
+    Access
+    Account::Cancellation
+    Account::Import
+    Account::JoinCode
+    ActionText::RichText
+    ActiveStorage::Attachment
+    ActiveStorage::VariantRecord
+    ActiveStorage::Blob
+    Assignment
+    Board::Publication
+    Board
+    Card::ActivitySpike
+    Card::Goldness
+    Card::NotNow
+    Card
+    Closure
+    Column
+    Comment
+    Entropy
+    Event
+    Export
+    Filter
+    Mention
+    Notification::Bundle
+    Notification
+    Pin
+    Push::Subscription
+    Reaction
+    Search::Query
+    Step
+    Storage::Entry
+    Tagging
+    Tag
+    User::Settings
+    User
+    Watch
+    Webhook::DelinquencyTracker
+    Webhook::Delivery
+    Webhook
+  ].freeze
+
+  included do
+    scope :due_for_incineration, -> {
+      where(id: Account::Cancellation.due_for_incineration.select(:account_id))
+    }
+    scope :due, -> { due_for_incineration }
+    scope :incineratable, -> { due_for_incineration }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    transaction do
+      delete_search_data
+      delete_storage_totals
+      delete_join_table_rows
+      delete_account_scoped_records
+      delete
+    end
+  end
+  alias_method :incinerate!, :incinerate
+
+  private
+    def delete_search_data
+      search_records = Search::Record.for(id).where(account_id: id)
+
+      if search_records.connection.adapter_name == "SQLite"
+        Search::Record::SQLite::Fts.where(rowid: search_records.ids).delete_all
+      end
+
+      search_records.delete_all
+      Search::Query.where(account_id: id).delete_all
+    end
+
+    def delete_storage_totals
+      Storage::Total.where(owner_type: "Board", owner_id: Board.where(account_id: id).select(:id)).delete_all
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+    end
+
+    def delete_join_table_rows
+      user_ids = User.where(account_id: id).ids
+      filter_ids = Filter.where(account_id: id).ids
+      board_ids = Board.where(account_id: id).ids
+      tag_ids = Tag.where(account_id: id).ids
+
+      delete_join_table_rows_for "assignees_filters", assignee_id: user_ids, filter_id: filter_ids
+      delete_join_table_rows_for "assigners_filters", assigner_id: user_ids, filter_id: filter_ids
+      delete_join_table_rows_for "boards_filters", board_id: board_ids, filter_id: filter_ids
+      delete_join_table_rows_for "closers_filters", closer_id: user_ids, filter_id: filter_ids
+      delete_join_table_rows_for "creators_filters", creator_id: user_ids, filter_id: filter_ids
+      delete_join_table_rows_for "filters_tags", filter_id: filter_ids, tag_id: tag_ids
+    end
+
+    def delete_join_table_rows_for(table_name, conditions)
+      connection = self.class.connection
+
+      predicates = conditions.filter_map do |column_name, record_ids|
+        next if record_ids.empty?
+
+        quoted_ids = record_ids.map { |record_id| connection.quote(database_id_for(record_id)) }.join(", ")
+        "#{connection.quote_column_name(column_name)} IN (#{quoted_ids})"
+      end
+
+      if predicates.any?
+        connection.execute("DELETE FROM #{connection.quote_table_name(table_name)} WHERE #{predicates.join(' OR ')}")
+      end
+    end
+
+    def delete_account_scoped_records
+      ACCOUNT_SCOPED_MODELS.each do |model_name|
+        model_name.constantize.where(account_id: id).delete_all
+      end
+
+      if defined?(Account::StorageException)
+        Account::StorageException.where(account_id: id).delete_all
+      end
+    end
+
+    def database_id_for(record_id)
+      ActiveRecord::Type::Uuid.new.serialize(record_id)
+    end
 end
