--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,58 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user, inverse_of: :push_subscriptions
+
+  scope :ordered, -> { order(created_at: :asc) }
+
+  normalizes :endpoint, with: ->(endpoint) { endpoint.to_s.strip }
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def register(user:, endpoint:, p256dh_key:, auth_key:, user_agent: nil)
+      user.push_subscriptions.find_or_initialize_by(endpoint: endpoint.to_s.strip).tap do |subscription|
+        subscription.update!(p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent)
+      end
+    end
+
+    def deliver(notification)
+      notification.user.push_subscriptions.each do |subscription|
+        subscription.deliver(notification)
+      end
+    end
+    alias_method :push, :deliver
+
+    def enabled?
+      Fizzy.web_push_enabled?
+    end
+  end
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: Push::Notification.new(notification).to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: Fizzy.vapid_subject,
+        public_key: Fizzy.vapid_public_key,
+        private_key: Fizzy.vapid_private_key
+      }
+    )
+
+    true
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy
+    false
+  rescue => error
+    Rails.logger.warn "Push subscription #{id} failed: #{error.class}: #{error.message}"
+    false
+  end
+
+  alias_method :push, :deliver
+  alias_method :push_notification, :deliver
+  alias_method :notify, :deliver
+end
