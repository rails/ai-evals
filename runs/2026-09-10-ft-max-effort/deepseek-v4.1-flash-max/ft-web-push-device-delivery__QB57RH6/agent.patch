@@ -0,0 +1,58 @@
+class Push::Notification
+  include Rails.application.routes.url_helpers
+  include NotificationsHelper
+
+  attr_reader :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def title
+    case notification.source
+    when Event
+      event_notification_title(notification.source)
+    when Mention
+      "#{notification.source.mentioner.first_name} @mentioned you"
+    else
+      notification.card.title.presence || "Card #{notification.card.number}"
+    end
+  end
+
+  def body
+    case notification.source
+    when Event
+      event_notification_body(notification.source)
+    when Mention
+      notification.source.source.mentionable_content.truncate(200)
+    else
+      ""
+    end
+  end
+
+  def url
+    polymorphic_url(notification.notifiable_target || notification.card, url_options)
+  end
+
+  alias_method :link, :url
+
+  def payload
+    { title: title, body: body, url: url }
+  end
+
+  alias_method :as_json, :payload
+
+  def to_json(*)
+    payload.to_json
+  end
+
+  def url_options
+    base_url_options.merge(script_name: notification.account.slug)
+  end
+
+  private
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+end
