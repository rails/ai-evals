+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,61 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key user_agent ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+  before_action :set_subscription, only: :destroy
+
+  def create
+    @subscription = Push::Subscription.register(
+      user: @user,
+      endpoint: subscription_params[:endpoint],
+      p256dh_key: subscription_params[:p256dh_key],
+      auth_key: subscription_params[:auth_key],
+      user_agent: subscription_params[:user_agent]
+    )
+
+    head :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    @subscription.destroy!
+
+    respond_to do |format|
+      format.turbo_stream { head :no_content }
+      format.json { head :no_content }
+      format.html { redirect_to notifications_settings_path, notice: "Notifications turned off for this device" }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def set_subscription
+      @subscription = find_subscription_by_endpoint || find_subscription_by_id
+      head :not_found unless @subscription
+    end
+
+    def find_subscription_by_endpoint
+      endpoint = params.dig(:push_subscription, :endpoint).presence
+      @user.push_subscriptions.find_by(endpoint: endpoint) if endpoint
+    end
+
+    def find_subscription_by_id
+      @user.push_subscriptions.find_by(endpoint: params[:id]) || @user.push_subscriptions.find_by(id: params[:id])
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key, :user_agent ])
+        .to_h
+        .symbolize_keys
+        .tap { |attributes| attributes[:user_agent] = attributes[:user_agent].presence || request.user_agent }
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..00c0303
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,136 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "toggle" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionsUrl: String
+  }
+
+  connect() {
+    this.refresh()
+  }
+
+  async toggle() {
+    if (this.element.classList.contains("notifications--on")) {
+      await this.#disable()
+    } else {
+      await this.#enable()
+    }
+  }
+
+  async refresh() {
+    if (!this.#supported) {
+      this.#setOn(false)
+      this.#showDetails()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#setOn(false)
+      this.#showDetails()
+      return
+    }
+
+    const subscription = await this.#subscription()
+    this.#setOn(!!subscription)
+    this.#hideDetails()
+  }
+
+  async #enable() {
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.#setOn(false)
+      this.#showDetails()
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.register("/service-worker.js")
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#decodeKey(this.vapidPublicKeyValue)
+      })
+
+      await this.#save(subscription)
+      this.#setOn(true)
+      this.#hideDetails()
+    } catch (error) {
+      console.error("Could not enable push notifications", error)
+      this.#setOn(false)
+      this.#showDetails()
+    }
+  }
+
+  async #disable() {
+    try {
+      const subscription = await this.#subscription()
+      if (subscription) {
+        await this.#destroy(subscription)
+        await subscription.unsubscribe()
+      }
+    } catch (error) {
+      console.error("Could not disable push notifications", error)
+    } finally {
+      this.#setOn(false)
+    }
+  }
+
+  async #save(subscription) {
+    const data = subscription.toJSON()
+
+    await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: data.endpoint,
+          p256dh_key: data.keys.p256dh,
+          auth_key: data.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  async #destroy(subscription) {
+    await destroy(this.subscriptionsUrlValue, {
+      query: { "push_subscription[endpoint]": subscription.endpoint },
+      responseKind: "json"
+    })
+  }
+
+  async #subscription() {
+    if (!this.#supported) return null
+
+    const registration = await navigator.serviceWorker.getRegistration()
+    return await registration?.pushManager.getSubscription()
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  #setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach((element) => element.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach((element) => element.hidden = true)
+  }
+
+  #decodeKey(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    return Uint8Array.from([ ...rawData ].map((char) => char.charCodeAt(0)))
+  }
+}
