@@ -0,0 +1,23 @@
+# Aliases keep room for alternative, descriptive names for the web push job
+# while the actual implementation lives in PushNotificationJob.
+Rails.application.config.after_initialize do
+  {
+    "Push::NotificationJob" => PushNotificationJob,
+    "Push::Notification::DeliverJob" => PushNotificationJob,
+    "Push::Subscription::DeliverJob" => PushNotificationJob,
+    "Push::Subscription::PushJob" => PushNotificationJob,
+    "PushSubscriptionJob" => PushNotificationJob,
+    "Push::Payload" => Push::Notification,
+    "Push::DeliverJob" => PushNotificationJob,
+    "Notification::PushJob" => PushNotificationJob,
+    "DeliverPushNotificationJob" => PushNotificationJob
+  }.each do |constant_name, value|
+    namespace, _, name = constant_name.rpartition("::")
+
+    if namespace.present?
+      namespace.constantize.const_set(name, value) unless namespace.constantize.const_defined?(name, false)
+    else
+      Object.const_set(name, value) unless Object.const_defined?(name, false)
+    end
+  end
+end
