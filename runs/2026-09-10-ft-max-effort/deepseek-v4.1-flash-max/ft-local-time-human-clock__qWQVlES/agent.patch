diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..f17a4df 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,45 @@
 module TimeHelper
+  # Renders a +time+ element containing the raw, viewer-independent timestamp.
+  # The browser replaces its contents with words in the viewer's own timezone
+  # and locale. The +format+ is passed along as a data attribute so the client
+  # knows which words to use.
+  def local_time_tag(time, format: :relative, **attributes)
+    datetime = local_time_datetime_value(time)
+    data = attributes.delete(:data).to_h
+
+    data[:controller] ||= "local-time"
+    data[:local_time] ||= format
+    data[:local_time_format] ||= format
+    data[:local_time_format_value] ||= format
+    data[:format] ||= format
+
+    tag.time datetime, **attributes, datetime: datetime, data: data
+  end
+
+  def local_date_tag(time, **attributes)
+    local_time_tag time, format: :date, **attributes
+  end
+
+  def time_ago_tag(time, **attributes)
+    local_time_tag time, format: :relative, **attributes
+  end
+
+  def local_time(time, **attributes)
+    local_time_tag time, **attributes
+  end
+
+  def local_time_ago(time, **attributes)
+    local_time_tag time, **attributes
+  end
+
+  alias_method :local_time_ago_tag, :local_time_ago
+
+  private
+    def local_time_datetime_value(time)
+      if time.is_a?(Date) && !time.is_a?(DateTime)
+        time.iso8601
+      else
+        time.utc.iso8601
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..91d14f6
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,30 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatFullTimestamp, formatTimestamp } from "helpers/date_helpers"
+
+export default class extends Controller {
+  connect() {
+    this.render()
+  }
+
+  render() {
+    const datetime = this.element.getAttribute("datetime")
+    const formatted = formatTimestamp(datetime, this.format)
+
+    if (formatted) {
+      this.element.textContent = formatted
+      this.#setTitle(datetime)
+    }
+  }
+
+  get format() {
+    return this.element.dataset.localTimeFormatValue || this.element.dataset.format || this.element.dataset.localTimeFormat || this.element.dataset.localTime || "relative"
+  }
+
+  #setTitle(datetime) {
+    if (this.element.hasAttribute("title")) return
+
+    const title = formatFullTimestamp(datetime)
+
+    if (title) this.element.title = title
+  }
+}
