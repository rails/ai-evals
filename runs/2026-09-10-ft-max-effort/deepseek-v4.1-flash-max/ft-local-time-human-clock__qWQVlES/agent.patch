diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..a9d383b
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,79 @@
+import { formatIsoDatesInText, formatTimestamp } from "helpers/date_helpers"
+
+const TIME_SELECTOR = "time[datetime]"
+const BRIDGE_DESCRIPTION_SELECTORS = "[data-bridge-share-description], [data-bridge-description]"
+
+function formatFor(element) {
+  return element.dataset.localTimeFormatValue || element.dataset.format || element.dataset.localTimeFormat || element.dataset.localTime || "relative"
+}
+
+function renderTime(element, now = new Date()) {
+  const datetime = element.getAttribute("datetime")
+  const formatted = formatTimestamp(datetime, formatFor(element), now)
+
+  if (formatted && element.textContent !== formatted) {
+    element.textContent = formatted
+  }
+}
+
+function renderBridgeDescription(element, now = new Date()) {
+  const attribute = element.hasAttribute("data-bridge-share-description") ? "data-bridge-share-description" : "data-bridge-description"
+  const description = element.getAttribute(attribute)
+
+  if (!description) return
+
+  const formatted = formatIsoDatesInText(description, now)
+
+  if (formatted !== description) {
+    element.setAttribute(attribute, formatted)
+  }
+}
+
+function renderAll(root = document) {
+  const now = new Date()
+
+  root.querySelectorAll(TIME_SELECTOR).forEach(element => renderTime(element, now))
+  root.querySelectorAll(BRIDGE_DESCRIPTION_SELECTORS).forEach(element => renderBridgeDescription(element, now))
+}
+
+function renderAddedNodes(nodes) {
+  nodes.forEach(node => {
+    if (node.nodeType !== Node.ELEMENT_NODE) return
+
+    if (node.matches(TIME_SELECTOR)) renderTime(node)
+    if (node.matches(BRIDGE_DESCRIPTION_SELECTORS)) renderBridgeDescription(node)
+
+    renderAll(node)
+  })
+}
+
+function start() {
+  renderAll()
+
+  new MutationObserver(mutations => {
+    mutations.forEach(mutation => {
+      if (mutation.type === "attributes") {
+        if (mutation.target.matches(TIME_SELECTOR)) renderTime(mutation.target)
+        if (mutation.target.matches(BRIDGE_DESCRIPTION_SELECTORS)) renderBridgeDescription(mutation.target)
+      } else {
+        if (mutation.target.matches(TIME_SELECTOR)) renderTime(mutation.target)
+        if (mutation.target.matches(BRIDGE_DESCRIPTION_SELECTORS)) renderBridgeDescription(mutation.target)
+
+        renderAddedNodes(mutation.addedNodes)
+      }
+    })
+  }).observe(document.documentElement, {
+    subtree: true,
+    childList: true,
+    attributes: true,
+    attributeFilter: [ "datetime", "data-bridge-share-description", "data-bridge-description" ]
+  })
+
+  setInterval(renderAll, 60 * 1000)
+}
+
+if (document.readyState === "loading") {
+  document.addEventListener("DOMContentLoaded", start, { once: true })
+} else {
+  start()
+}
