new file mode 100644
index 0000000..6994bcb
--- /dev/null
+++ b/app/jobs/import_job.rb
@@ -0,0 +1,25 @@
+class ImportJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  queue_as :default
+
+  def perform(import)
+    import.processing!
+    importer = Account::DataTransfer::Importer.new(import, identity: import.identity || Current.identity)
+
+    Current.with_account(import.account) do
+      begin
+        account = importer.import!
+        import.completed!(account: account, account_name: account.name)
+        ImportMailer.ready(import).deliver_later
+      rescue => error
+        import.failed!(error.message)
+        begin
+          ImportMailer.failed(import).deliver_later
+        rescue StandardError
+          # Failure email is best-effort; the failure is recorded on the import.
+        end
+      end
+    end
+  end
+end
