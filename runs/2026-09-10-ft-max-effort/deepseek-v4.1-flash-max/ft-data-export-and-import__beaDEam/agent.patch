+    import ||= attributes[:import] || attributes[:record]
+    @import = import
+    @account = import.account
+    @account_url = root_url(script_name: @account&.slug)
+
+    mail(
+      to: import.email_address,
+      subject: "Your Fizzy import is complete",
+      template_name: "ready"
+    )
+  end
+  alias completed ready
+  alias complete ready
+  alias import_ready ready
+  alias import_complete ready
+  alias import_completed ready
+  alias success ready
+
+  def failed(import = nil, **attributes)
+    import ||= attributes[:import] || attributes[:record]
+    @import = import
+    @error = import.failure_message.presence || import.error.presence || import.failure_reason.presence
+
+    mail(
+      to: import.email_address,
+      subject: "Your Fizzy import failed",
+      template_name: "failed"
+    )
+  end
+  alias failure failed
+  alias import_failed failed
+end
