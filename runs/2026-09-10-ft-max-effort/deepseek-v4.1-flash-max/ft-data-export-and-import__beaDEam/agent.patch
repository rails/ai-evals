+    # Opens an archive (attachment, blob or IO) and yields a ZipFile::Reader.
+    def open(source, &block)
+      if source.respond_to?(:blob)
+        open_blob(source.blob, &block)
+      elsif source.is_a?(ActiveStorage::Blob)
+        open_blob(source, &block)
+      elsif source.respond_to?(:read) && !source.is_a?(String)
+        reader = Reader.new(source)
+        block ? block.call(reader) : reader
+      else
+        raise ArgumentError, "Expected an attachment, blob or IO"
+      end
+    end
+
+    def read(source, &block)
+      open(source, &block)
+    end
+
+    # Reads an archive into a hash of path => contents. Useful for tests.
+    def read_all(source)
+      open(source) { |reader| reader.to_h }
+    end
 
     private
+      def open_blob(blob)
+        tempfile = Tempfile.new([ "import", ".zip" ])
+        tempfile.binmode
+        blob.service.download(blob.key) { |chunk| tempfile.write(chunk) }
