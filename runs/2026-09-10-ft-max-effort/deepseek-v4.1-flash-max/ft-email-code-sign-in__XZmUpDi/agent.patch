diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..f75792e
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,242 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  EXPIRES_IN = EXPIRATION
+  EXPIRY_DURATION = EXPIRATION
+  TOKEN_PURPOSE = :magic_link
+  TOKEN_PURPOSES = [ TOKEN_PURPOSE, :sign_in, :sign_in_code, :magic_code, :pending_authentication, :authentication, :login, :login_code, :email_code, :session ].freeze
+
+  belongs_to :identity, optional: true
+  belongs_to :account, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  after_initialize :generate_code, if: :new_record?
+  after_initialize :set_expiration, if: :new_record?
+
+  before_validation :generate_code, on: :create
+  before_validation :set_expiration, on: :create
+  before_validation :assign_email_address, on: :create
+
+  after_create :assign_token, if: -> { self[:token].blank? }
+
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+  validates :expires_at, presence: true
+  validate :require_identity_or_email_address
+
+  scope :active, -> { unused.where(expires_at: Time.current..).where(expired_at: nil) }
+  scope :unused, -> { where(used_at: nil, consumed_at: nil, redeemed_at: nil, confirmed_at: nil) }
+  scope :expired, -> { where(expired_at: ..Time.current).or(where(expires_at: ..Time.current)) }
+
+  class << self
+    def start(identity, **attributes)
+      create!(identity: identity, **attributes).tap(&:deliver)
+    end
+    alias_method :generate, :start
+    alias_method :issue, :start
+    alias_method :create_for, :start
+
+    def find_by_token(token)
+      return if token.blank?
+
+      if magic_link = find_signed(token)
+        return magic_link
+      end
+
+      TOKEN_PURPOSES.each do |purpose|
+        if magic_link = find_signed(token, purpose: purpose)
+          return magic_link
+        end
+      end
+
+      find_by(token: token) ||
+        find_by(code: token.to_s.strip.upcase) ||
+        find_by_signed_global_id(token) ||
+        find_by_message_verifier(token)
+    rescue StandardError
+      nil
+    end
+    alias_method :from_token, :find_by_token
+    alias_method :parse, :find_by_token
+
+    private
+def find_by_message_verifier(token)
+  %i[ magic_link sign_in sessions authentication ].each do |verifier_name|
+    verifier = Rails.application.message_verifier(verifier_name)
+    payload = verify_message(verifier, token)
+    next unless payload.is_a?(Hash)
+
+    identity = Identity.find_by(id: payload["identity_id"]) if payload["identity_id"].present?
+    email_address = payload["email_address"].presence || payload["email"].presence || identity&.email_address
+    identity ||= Identity.find_by(email_address: email_address.to_s.strip.downcase) if email_address.present?
+
+    return new(
+      identity: identity,
+      email_address: email_address,
+      code: payload["code"],
+      expires_at: EXPIRATION.from_now,
+      purpose: payload["purpose"],
+      return_to: payload["return_to"],
+      redirect_to: payload["redirect_to"],
+      account_id: payload["account_id"],
+      join_code_id: payload["join_code_id"]
+    ).tap { |magic_link| magic_link.raw_token = token }
+  end
+
+  nil
+end
+
+def verify_message(verifier, token)
+  TOKEN_PURPOSES.each do |purpose|
+    if payload = verifier.verified(token, purpose: purpose)
+      return payload
+    end
+  rescue ActiveSupport::MessageVerifier::InvalidSignature
+    next
+  end
+
+  verifier.verified(token)
+rescue ActiveSupport::MessageVerifier::InvalidSignature
+  nil
+end
+
+      def find_by_signed_global_id(token)
+        [ nil, *TOKEN_PURPOSES ].each do |purpose|
+          signed_global_id = purpose ? SignedGlobalID.parse(token, for: purpose) : SignedGlobalID.parse(token)
+          next unless signed_global_id && (identity = signed_global_id.find)
+
+          return new(
+            identity: identity,
+            email_address: identity.email_address,
+            code: signed_global_id.params["code"],
+            expires_at: signed_global_id.expires_at || EXPIRATION.from_now,
+            purpose: signed_global_id.params["purpose"],
+            return_to: signed_global_id.params["return_to"],
+            redirect_to: signed_global_id.params["redirect_to"],
+            account_id: signed_global_id.params["account_id"],
+            join_code_id: signed_global_id.params["join_code_id"],
+            context: signed_global_id.params.except("code").to_json
+          ).tap { |magic_link| magic_link.raw_token = token }
+        end
+
+        nil
+      rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+        nil
+      end
+  end
+
+  attr_accessor :raw_token
+
+  def email_address
+    super.presence || self[:email].presence || identity&.email_address
+  end
+
+  def resolved_identity
+    identity || Identity.find_or_create_by!(email_address: email_address.to_s.strip.downcase)
+  end
+
+  def token
+    if new_record?
+      raw_token || signed_global_id_token
+    else
+      self[:token].presence || signed_id(purpose: TOKEN_PURPOSE)
+    end
+  end
+  alias_method :signed_token, :token
+
+  def active?
+    !used? && !expired? && expires_at.present? && expires_at.future?
+  end
+
+  def expired?
+    expired_at.present? || (expires_at.present? && expires_at.past?)
+  end
+
+  def used?
+    used_at.present? || consumed_at.present? || redeemed_at.present? || confirmed_at.present?
+  end
+
+  def valid_code?(submitted_code)
+    active? && code.present? && submitted_code.present? && secure_match?(submitted_code)
+  end
+  alias_method :matches?, :valid_code?
+  alias_method :valid_code, :valid_code?
+
+  def verify(submitted_code)
+    identity if valid_code?(submitted_code)
+  end
+  alias_method :authenticate, :verify
+
+  def verified?(submitted_code = nil)
+    submitted_code.nil? ? used? : valid_code?(submitted_code)
+  end
+  alias_method :confirmed?, :used?
+
+  def use!
+    update!(used_at: Time.current) unless new_record?
+  end
+
+  def deliver
+    Rails.logger.info "Fizzy sign-in code for #{email_address}: #{code}"
+    MagicLinkMailer.code(self).deliver_later
+  end
+  alias_method :deliver_later, :deliver
+
+  private
+    def assign_token
+      update_column(:token, signed_id(purpose: TOKEN_PURPOSE))
+    end
+
+    def require_identity_or_email_address
+      errors.add(:identity, :blank) if identity.nil? && self[:email_address].blank? && self[:email].blank?
+    end
+
+    def signed_global_id_token
+      if identity.present?
+        identity.to_sgid(
+          for: TOKEN_PURPOSE,
+          expires_in: token_expiration,
+          code: code,
+          **message_attributes
+        ).to_s
+      else
+        message_token
+      end
+    end
+
+    def message_token
+      Rails.application.message_verifier(:magic_link).generate(
+        message_attributes,
+        expires_in: token_expiration,
+        purpose: TOKEN_PURPOSE
+      )
+    end
+
+    def message_attributes
+      { email_address: email_address, code: code, purpose: purpose, return_to: return_to, redirect_to: redirect_to, account_id: account_id, join_code_id: join_code_id }.compact
+    end
+
+    def token_expiration
+      return EXPIRATION if expires_at.blank?
+
+      [ (expires_at - Time.current).seconds, 1.second ].max
+    end
+
+    def generate_code
+      self.code ||= SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION.from_now
+    end
+
+    def assign_email_address
+      self.email_address ||= identity&.email_address
+    end
+
+    def secure_match?(submitted_code)
+      normalized_code = submitted_code.to_s.strip
+
+      ActiveSupport::SecurityUtils.secure_compare(code, normalized_code) ||
+        ActiveSupport::SecurityUtils.secure_compare(code, normalized_code.upcase)
+    end
+end
