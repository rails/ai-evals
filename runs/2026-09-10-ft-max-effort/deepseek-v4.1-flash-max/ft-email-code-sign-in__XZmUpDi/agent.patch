--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,130 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  PENDING_AUTHENTICATION_COOKIE = :pending_authentication_token
+
+  def set_pending_authentication_token(magic_link)
+    cookies[PENDING_AUTHENTICATION_COOKIE] = {
+      value: magic_link.token,
+      expires: magic_link.expires_at,
+      httponly: true,
+      same_site: :lax
+    }
+  end
+
+  def pending_authentication_token
+    cookies[PENDING_AUTHENTICATION_COOKIE].presence || params[:pending_authentication_token].presence || session[:pending_authentication_token].presence
+  end
+
+  def pending_magic_link
+    MagicLink.find_by_token(pending_authentication_token)
+  end
+
+  def magic_link_code
+    request.request_parameters[:code].presence ||
+      params[:code].presence ||
+      params.dig(:signup, :code).presence ||
+      params.dig(:session, :code).presence ||
+      params.dig(:magic_link, :code).presence
+  end
+
+  def clear_pending_authentication_token
+    cookies.delete PENDING_AUTHENTICATION_COOKIE
+  end
+
+  def complete_magic_link_authentication
+    magic_link = pending_magic_link
+
+    if magic_link.nil? || !magic_link.active?
+      expired_magic_link
+    elsif magic_link.valid_code?(magic_link_code)
+      magic_link.use!
+      clear_pending_authentication_token
+      start_new_session_for magic_link.resolved_identity
+
+      respond_to do |format|
+        format.html { redirect_to magic_link_destination(magic_link) }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      invalid_magic_link_code
+    end
+  end
+
+  private
+    def native_login_request?
+      request.path.start_with?("/native/login")
+    end
+
+    def magic_link_start_path
+      native_login_request? ? native_login_email_path : new_session_path
+    end
+
+    def magic_link_code_path
+      native_login_request? ? native_login_magic_code_path : session_magic_link_path
+    end
+
+    def magic_link_destination(magic_link)
+      if join_magic_link?(magic_link)
+        join_account(magic_link)
+      elsif (redirect_to = magic_link.redirect_to.presence || magic_link.redirect_path.presence || magic_link.url.presence)
+        redirect_to
+      elsif sign_up_magic_link?(magic_link)
+        if native_login_request?
+          native_login_signup_completion_path
+        else
+          magic_link.return_to.presence || new_signup_completion_path
+        end
+      elsif magic_link.resolved_identity.users.none?
+        Account.accepting_signups? ? new_signup_completion_path : session_menu_path(script_name: nil)
+      else
+        after_authentication_url
+      end
+    end
+
+    def join_magic_link?(magic_link)
+      magic_link.join_code_id.present? || magic_link.account_id.present? || magic_link.purpose.to_s.in?(%w[ join join_code 2 ])
+    end
+
+    def sign_up_magic_link?(magic_link)
+      magic_link.purpose.to_s.in?(%w[ sign_up signup 1 ]) || magic_link.return_to.to_s.include?("signup")
+    end
+
+    def join_account(magic_link)
+      account = magic_link.account
+      join_code = magic_link.join_code || account&.join_code
+      account ||= join_code&.account
+
+      if account && join_code&.active?
+        join_code.redeem_if { |joined_account| magic_link.resolved_identity.join(joined_account) }
+
+        user = User.active.find_by!(account: account, identity: magic_link.resolved_identity)
+        if user.setup?
+          landing_url(script_name: account.slug)
+        else
+          new_users_verification_url(script_name: account.slug)
+        end
+      else
+        flash[:alert] = "That invitation is no longer valid."
+        new_session_path
+      end
+    end
+
+    def expired_magic_link
+      message = "Your sign-in code has expired. Request a new one."
+
+      respond_to do |format|
+        format.html { redirect_to magic_link_start_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def invalid_magic_link_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to magic_link_code_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+end
