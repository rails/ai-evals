diff --git a/app/views/sessions/magic_links/show.html.erb b/app/views/sessions/magic_links/show.html.erb
new file mode 100644
index 0000000..f58cc8c
--- /dev/null
+++ b/app/views/sessions/magic_links/show.html.erb
@@ -0,0 +1,38 @@
+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-none">Check your email</h1>
+
+  <p class="margin-none-block-start">
+    We sent a six-character code to <strong><%= @magic_link.email_address %></strong>.
+    Enter your code below to sign in.
+  </p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code",
+              inputmode: "text", autocapitalize: "characters", spellcheck: false,
+              maxlength: MagicLink::CODE_LENGTH, class: "input full-width", placeholder: "Enter code" %>
+      </label>
+    </div>
+
+    <% if @code.present? %>
+      <p class="txt-subtle">Psst, here's your code: <strong><%= @code %></strong></p>
+    <% end %>
+
+    <button type="submit" id="log_in" value="Continue" class="btn btn--link center">
+      <span>Sign in</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-subtle margin-none-block-start">
+    The code expires after 15 minutes.
+    <%= link_to "Request a new code", new_session_path, class: "txt-link" %>
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
