new file mode 100644
index 0000000..7d1bc74
--- /dev/null
+++ b/app/views/sessions/codes/new.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @identity %>
+    <p>We sent a six-character code to <strong><%= @identity.email_address %></strong>. Enter it below to sign in.</p>
+  <% else %>
+    <p>Enter the six-character code we sent to your email address.</p>
+  <% end %>
+
+  <% if Rails.env.local? && @code.present? %>
+    <p class="txt-subtle">Psst, here's your code: <strong id="development-code"><%= @code %></strong></p>
+  <% end %>
+
+  <%= form_with url: session_code_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <span class="for-screen-reader">Sign-in code</span>
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", inputmode: "text", maxlength: 6,
+              placeholder: "Enter the 6-character code…", data: { "1p-ignore": true } %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small">Didn't get a code? Go back and enter your email address again to request a new one.</p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
