+  EXPIRATION = 15.minutes
+  LIFETIME = EXPIRATION
+  CODE_EXPIRATION = EXPIRATION
+  VALID_FOR = EXPIRATION
+  EXPIRES_IN = EXPIRATION
+
+  belongs_to :identity
+
+  before_create :generate_code, if: -> { code.blank? }
+  before_create :set_expiration, if: -> { expires_at.blank? }
+
+  scope :active, -> {
+    where(used: false, used_at: nil)
+      .where("created_at > ?", EXPIRATION.ago)
+      .where("expires_at IS NULL OR expires_at > ?", Time.current)
+  }
+  scope :expired, -> {
+    where("created_at <= ? OR (expires_at IS NOT NULL AND expires_at <= ?)", EXPIRATION.ago, Time.current)
+  }
+
+  def self.issue(identity)
+    identity.send_verification_code
+  end
+
+  class << self
+    alias_method :issue_for, :issue
+  end
+
+  def self.verify(identity, code)
+    identity.verify_verification_code(code)
+  end
+
+  def self.generate_code
+    loop do
+      candidate = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      break candidate unless exists?(code: candidate)
+    end
+  end
+
+  def self.cleanup
+    expired.delete_all
+  end
+
+  def pending_authentication_token
+    identity&.pending_authentication_token
+  end
+  alias_method :authentication_token, :pending_authentication_token
+  alias_method :magic_link_token, :pending_authentication_token
+
+  def active?
+    !used? && used_at.nil? && created_at.present? && created_at > EXPIRATION.ago && (expires_at.nil? || expires_at > Time.current)
+  end
+
+  def expired?
+    !active?
+  end
+
+  def verify(value)
+    if active? && code.casecmp?(value.to_s.strip)
+      update_columns(used: true, used_at: Time.current)
+      true
+    else
+      false
+    end
+  end
+
+  private
+    def generate_code
+      self.code = self.class.generate_code
+    end
+
+    def set_expiration
+      self.expires_at = EXPIRATION.from_now
+    end
+end
