+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @identity = find_identity_from_pending_authentication_token
+    @code = @identity.verification_codes.active.first&.code if Rails.env.local? && @identity
+  end
+
+  def create
+    identity = find_identity_from_pending_authentication_token
+
+    if identity.nil?
+      missing_pending_authentication
+    elsif identity.verify_verification_code(code_param)
+      complete_authentication(identity)
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def code_param
+      if params[:code].present?
+        params[:code]
+      elsif params[:session].is_a?(ActionController::Parameters)
+        params[:session][:code]
+      end
+    end
+
+    def complete_authentication(identity)
+      join_code_id = session.delete(:join_code_id)
+      signup_in_progress = session.delete(:signup_in_progress)
+      session.delete(:verification_identity_id)
+      session.delete(:sign_in_identity_id)
+
+      clear_pending_authentication_token
+      start_new_session_for(identity)
+
+      respond_to do |format|
+        format.json { render json: { session_token: session_token } }
+        format.html do
+          if join_code_id.present? && (join_code = Account::JoinCode.find_by(id: join_code_id))
+            join_account(identity, join_code)
+          elsif signup_in_progress
+            redirect_to new_signup_completion_path
+          else
+            redirect_to after_authentication_url
+          end
+        end
+      end
+    end
+
+    def join_account(identity, join_code)
+      join_code.redeem_if { identity.join(join_code.account) }
+      user = User.active.find_by(account: join_code.account, identity: identity)
+
+      if user.nil?
+        redirect_to session_menu_path(script_name: nil), alert: "That join code is no longer valid."
+      elsif user.setup?
+        redirect_to landing_url(script_name: join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+
+    def missing_pending_authentication
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message, error: message, errors: [ message ] }, status: :unauthorized }
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message, error: message, errors: [ message ] }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message, error: message, errors: [ message ] }, status: :too_many_requests }
+      end
+    end
+end
