diff --git a/lib/translation.rb b/lib/translation.rb
new file mode 100644
index 0000000..2113e66
--- /dev/null
+++ b/lib/translation.rb
@@ -0,0 +1,57 @@
+# Fizzy's UI predates its internationalization: most copy is English right in
+# the templates. `Translation` bridges that copy to the locale catalogs without
+# forcing every sentence through a key-based lookup. Catalog keys are the
+# original English text, normalized for whitespace.
+#
+#     Translation.translate("Add card")                    # => "カードを追加"
+#     Translation.translate("Added to %{name}", name: "…") # => "…に追加しました"
+#
+# English (and any locale without a catalog entry) renders the original copy
+# unchanged, which keeps the English app byte-for-byte on its current output.
+class Translation
+  class << self
+    def translate(text, **options)
+      text = text.to_s
+      template = lookup(text)
+      return format(text, options) if template.nil?
+
+      format(template, options)
+    end
+
+    # Templates are static English; mark them safe so entities like &nbsp; are
+    # not double-escaped. Call only with literals, never user input.
+    def translate_text(text, **options)
+      translate(text, **options).html_safe
+    end
+
+    private
+      def lookup(text)
+        catalog[normalize(text)]
+      end
+
+      def format(template, options)
+        if options.any?
+          template % options
+        else
+          template
+        end
+      end
+
+      def normalize(text)
+        text.gsub(/\s+/, " ").strip
+      end
+
+      def catalog
+        @catalog ||= {}
+        @catalog[I18n.locale] ||= load_catalog(I18n.locale)
+      end
+
+      def load_catalog(locale)
+        path = Rails.root.join("config", "locales", "#{locale}.yml")
+        return {} unless path.exist?
+
+        data = YAML.load_file(path, aliases: true)
+        data.dig(locale.to_s, "translations") || {}
+      end
+  end
+end
