diff --git a/test/internationalization_test.rb b/test/internationalization_test.rb
new file mode 100644
index 0000000..2b32fc2
--- /dev/null
+++ b/test/internationalization_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class InternationalizationTest < ActionDispatch::IntegrationTest
+  test "the app is available in English and Japanese" do
+    assert_equal [ :en, :ja ], I18n.available_locales
+  end
+
+  test "?locale=ja switches an anonymous session to Japanese" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_equal "ja", response.body[/<html lang="([^"]+)"/, 1]
+      assert_includes response.body, "メールアドレスを入力"
+    end
+
+    untenanted do
+      get new_session_path
+      assert_equal "ja", response.body[/<html lang="([^"]+)"/, 1]
+    end
+  end
+
+  test "unsupported locales are ignored" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_equal "en", response.body[/<html lang="([^"]+)"/, 1]
+    end
+  end
+
+  test "a signed-in choice persists to the identity" do
+    sign_in_as :kevin
+
+    get root_path, params: { locale: "ja" }
+
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_equal "ja", users(:kevin).settings.reload.locale
+    assert_equal "ja", response.body[/<html lang="([^"]+)"/, 1]
+  end
+
+  test "the saved locale follows the person back to a clean browser" do
+    identities(:kevin).update!(locale: "ja")
+
+    sign_in_as :kevin
+    get root_path
+
+    assert_equal "ja", response.body[/<html lang="([^"]+)"/, 1]
+    assert_includes response.body, "ホーム"
+  end
+
+  test "a locale chosen while signing in is remembered and used for the sign-in email" do
+    identity = identities(:david)
+    identity.update!(locale: nil)
+
+    perform_enqueued_jobs do
+      untenanted do
+        post session_path, params: { email_address: identity.email_address, locale: "ja" }
+      end
+    end
+
+    assert_equal "ja", identity.reload.locale
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_includes mail.subject, "Fizzy のコードは"
+    assert_includes mail.text_part.decoded, "確認コード"
+  end
+
+test "localized emails use the recipient locale" do
+
+    identity = identities(:david)
+    identity.update!(locale: "ja")
+
+    mail = MagicLinkMailer.sign_in_instructions(identity.magic_links.create!(purpose: :sign_in))
+
+    assert_includes mail.subject, "Fizzy のコードは"
+    assert_includes mail.text_part.decoded, "確認コード"
+    assert_includes mail.html_part.decoded, "lang=\"ja\""
+  end
+end
