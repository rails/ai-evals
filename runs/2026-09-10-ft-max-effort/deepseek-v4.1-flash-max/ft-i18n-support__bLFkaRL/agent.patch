diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..d5493ec
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,84 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :switch_locale
+
+    helper_method :current_locale
+  end
+
+  def current_locale
+    I18n.locale
+  end
+
+  private
+    def switch_locale(&action)
+      if (locale = requested_locale)
+        @requested_locale = locale
+        session[:locale] = locale.to_s
+      end
+
+      I18n.with_locale(locale_for_request) do
+        persist_locale_preference(@requested_locale) if @requested_locale
+        action.call
+      end
+    end
+
+    def locale_for_request
+      @requested_locale || supported_locale(session[:locale]) || pending_authentication_locale || I18n.default_locale
+    end
+
+    # Called after the session/identity are restored so a preference saved on a
+    # previous device is applied before rendering, and so an explicit choice
+    # made in this browser is persisted for next time.
+    def sync_locale_with_identity
+      if (locale = supported_locale(session[:locale]))
+        persist_locale_preference(locale)
+        I18n.locale = locale
+      elsif (locale = locale_from_current_identity)
+        session[:locale] = locale.to_s
+        I18n.locale = locale
+      end
+    end
+
+    def locale_from_current_identity
+      locale = Current.user&.settings&.locale if Current.user
+      locale ||= Current.identity&.locale if Current.identity
+      supported_locale(locale)
+    end
+
+    def pending_authentication_locale
+      return unless respond_to?(:email_address_pending_authentication, true)
+
+      email_address = email_address_pending_authentication
+      supported_locale(Identity.find_by(email_address: email_address)&.locale) if email_address.present?
+    end
+
+    def requested_locale
+      supported_locale(request.query_parameters[:locale] || request.request_parameters[:locale])
+    end
+
+    def supported_locale(value)
+      return unless value.is_a?(String) && value.present?
+
+      locale = value.to_sym
+      locale if I18n.available_locales.include?(locale)
+    end
+
+    def remember_locale_for(identity)
+      return unless identity
+      return unless (locale = supported_locale(session[:locale]))
+
+      identity.update!(locale: locale.to_s) if identity.locale != locale.to_s
+    end
+
+    def persist_locale_preference(locale)
+      if Current.identity && Current.identity.locale != locale.to_s
+        Current.identity.update!(locale: locale.to_s)
+      end
+
+      if Current.user&.settings && Current.user.settings.locale != locale.to_s
+        Current.user.settings.update!(locale: locale.to_s)
+      end
+    end
+end
