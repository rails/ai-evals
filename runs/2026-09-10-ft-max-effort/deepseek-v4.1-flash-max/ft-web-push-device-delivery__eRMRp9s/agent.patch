diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..0f219ed
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,54 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :auth_key, :endpoint, :p256dh_key, presence: true
+  validates :endpoint, uniqueness: true
+
+  scope :ordered, -> { order(created_at: :asc) }
+  scope :for_user, ->(user) { where(user: user) }
+
+  class << self
+    def deliver(message)
+      find_each { |subscription| subscription.deliver(message) }
+    end
+
+    def register(user = nil, attributes = nil, **options)
+      attributes = (attributes ? attributes.to_h : {}).symbolize_keys.merge(options)
+      user ||= attributes.delete(:user)
+
+      find_or_initialize_by(endpoint: attributes[:endpoint]).tap do |subscription|
+        subscription.user = user
+        subscription.account = user.account if user
+        subscription.p256dh_key = attributes[:p256dh_key]
+        subscription.auth_key = attributes[:auth_key]
+        subscription.user_agent = attributes[:user_agent]
+        subscription.save!
+      end
+    end
+
+    def unregister(endpoint)
+      find_by(endpoint: endpoint)&.destroy
+    end
+  end
+
+  def deliver(message = nil, **options)
+    message ||= options[:message] || options[:payload]
+
+    Push.deliver self, message
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  def deliver_later(message = nil, **options)
+    message ||= options[:message] || options[:payload]
+
+    Push::DeliveryJob.perform_later self, message
+  end
+
+  alias push deliver
+  alias notify deliver
+  alias deliver_now deliver
+end
