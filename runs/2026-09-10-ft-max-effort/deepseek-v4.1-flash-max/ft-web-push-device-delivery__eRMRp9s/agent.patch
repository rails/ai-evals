new file mode 100644
index 0000000..108485c
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,49 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = Push::Subscription.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.assign_attributes subscription_params.merge(user: @user, account: @user.account, user_agent: request.user_agent)
+
+    if subscription.save
+      head :created
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    subscription = @user.push_subscriptions.find_by(id: subscription_id) if subscription_id
+    subscription ||= @user.push_subscriptions.find_by(endpoint: subscription_id) if subscription_id
+    subscription ||= @user.push_subscriptions.find_by(endpoint: subscription_endpoint) if subscription_endpoint
+
+    if subscription
+      subscription.destroy
+      head :no_content
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      (params[:push_subscription].presence || params).permit(:endpoint, :p256dh_key, :auth_key)
+    end
+
+    def subscription_id
+      params[:id].presence
+    end
+
+    def subscription_endpoint
+      params.dig(:push_subscription, :endpoint).presence || params[:endpoint].presence
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..480bd4e
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,127 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = { subscriptionUrl: String, vapidPublicKey: String }
+
+  connect() {
+    if (this.#supported()) {
+      this.#syncState()
+    } else {
+      this.#showDetails()
+      this.#setEnabled(false)
+    }
+  }
+
+  async enable() {
+    if (!this.#supported() || Notification.permission === "denied") {
+      this.#showDetails()
+      return
+    }
+
+    if (await Notification.requestPermission() !== "granted") {
+      this.#showDetails()
+      return
+    }
+
+    try {
+      const registration = await this.#registration()
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey()
+      })
+
+      await post(this.subscriptionUrlValue, { body: this.#subscriptionBody(subscription) })
+      this.#setEnabled(true)
+    } catch (error) {
+      console.error("Could not enable push notifications", error)
+      this.#showDetails()
+    }
+  }
+
+  async disable() {
+    try {
+      const registration = await this.#registration()
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        const endpoint = subscription.endpoint
+        await subscription.unsubscribe()
+        await destroy(`${this.subscriptionUrlValue}/unsubscribe`, {
+          body: { push_subscription: { endpoint } }
+        })
+      }
+    } catch (error) {
+      console.error("Could not disable push notifications", error)
+    } finally {
+      this.#setEnabled(false)
+    }
+  }
+
+  async #syncState() {
+    try {
+      const registration = await this.#registration()
+      const subscription = await registration.pushManager.getSubscription()
+      this.#setEnabled(Boolean(subscription))
+
+      if (Notification.permission === "denied" || (!subscription && Notification.permission !== "granted")) {
+        this.#showDetails()
+      } else {
+        this.#hideDetails()
+      }
+    } catch (error) {
+      console.error("Could not read push notification state", error)
+      this.#showDetails()
+      this.#setEnabled(false)
+    }
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+  }
+
+  #showDetails() {
+    if (this.hasDetailsTarget) {
+      this.detailsTargets.forEach((details) => { details.hidden = false })
+    }
+  }
+
+  #hideDetails() {
+    if (this.hasDetailsTarget) {
+      this.detailsTargets.forEach((details) => { details.hidden = true })
+    }
+  }
+
+  async #registration() {
+    return await navigator.serviceWorker.getRegistration() ||
+      await navigator.serviceWorker.register("/service-worker.js")
+  }
+
+  #applicationServerKey() {
+    const key = this.vapidPublicKeyValue ||
+      document.querySelector('meta[name="vapid-public-key"]')?.content
+
+    if (!key) throw new Error("The VAPID public key is not configured")
+
+    const padding = "=".repeat((4 - (key.length % 4)) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(window.atob(base64), (character) => character.charCodeAt(0))
+  }
+
+  #subscriptionBody(subscription) {
+    const json = subscription.toJSON()
+
+    return {
+      push_subscription: {
+        endpoint: json.endpoint,
+        p256dh_key: json.keys.p256dh,
+        auth_key: json.keys.auth
+      }
+    }
+  }
+
+  #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+}
