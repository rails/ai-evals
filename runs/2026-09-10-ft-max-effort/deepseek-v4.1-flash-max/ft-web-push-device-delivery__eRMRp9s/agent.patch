+# The Web Push protocol requires a contact URI ("subject") for the sender as
+# part of the VAPID authorization. The VAPID key pair itself is supplied by
+# the environment: VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY.
+Rails.application.config.x.push = ActiveSupport::OrderedOptions.new
+Rails.application.config.x.push.vapid_subject = ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do")
+Rails.application.config.x.push.public_key = ENV["VAPID_PUBLIC_KEY"]
+Rails.application.config.x.push.private_key = ENV["VAPID_PRIVATE_KEY"]
+Rails.application.config.x.push.vapid_public_key = Rails.application.config.x.push.public_key
+Rails.application.config.x.push.vapid_private_key = Rails.application.config.x.push.private_key
