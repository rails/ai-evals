@@ -0,0 +1,15 @@
+class Notification::PushJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(record, message = nil, **options)
+    message ||= options[:message] || options[:payload]
+
+    if !message.nil?
+      record.deliver(message)
+    else
+      Notification::Push.new(record).deliver_later
+    end
+  end
+end
