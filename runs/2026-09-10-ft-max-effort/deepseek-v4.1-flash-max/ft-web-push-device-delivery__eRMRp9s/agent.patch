diff --git a/lib/push.rb b/lib/push.rb
new file mode 100644
index 0000000..165b5e5
--- /dev/null
+++ b/lib/push.rb
@@ -0,0 +1,74 @@
+module Push
+  VAPID_SUBJECT = "mailto:support@fizzy.do"
+
+  class << self
+    attr_writer :vapid_subject
+
+    def deliver(subscription = nil, message = nil, **options)
+      subscription ||= options[:subscription] || options[:push_subscription]
+      message ||= options[:message] || options[:payload]
+
+      if message.nil? && (options.keys & [ :title, :body, :url ]).any?
+        message = options.slice(:title, :body, :url).to_json
+      end
+
+      message = message.to_json if message.is_a?(Hash) || message.is_a?(Array)
+
+      endpoint = options[:endpoint] || subscription.endpoint
+      p256dh = options[:p256dh] || subscription.p256dh_key
+      auth = options[:auth] || subscription.auth_key
+
+      WebPush.payload_send(
+        message: message,
+        endpoint: endpoint,
+        p256dh: p256dh,
+        auth: auth,
+        vapid: vapid
+      )
+    rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+      subscription&.destroy
+    end
+
+    def generate_key
+      WebPush.generate_key
+    end
+
+    alias deliver_to deliver
+    alias notify deliver
+    alias push deliver
+
+    def payload_send(**options)
+      WebPush.payload_send(**options)
+    end
+
+    def vapid
+      {
+        subject: subject,
+        public_key: public_key,
+        private_key: private_key
+      }
+    end
+    alias vapid_options vapid
+
+    def enabled?
+      public_key.present? && private_key.present?
+    end
+    alias configured? enabled?
+
+    def public_key
+      ENV["VAPID_PUBLIC_KEY"].presence || Rails.application&.config&.x&.push&.public_key || Rails.application&.config&.x&.push&.vapid_public_key
+    end
+
+    def private_key
+      ENV["VAPID_PRIVATE_KEY"].presence || Rails.application&.config&.x&.push&.private_key || Rails.application&.config&.x&.push&.vapid_private_key
+    end
+
+    def subject
+      ENV["VAPID_SUBJECT"].presence || @vapid_subject.presence || Rails.application&.config&.x&.push&.vapid_subject.presence || VAPID_SUBJECT
+    end
+
+    def subject=(value)
+      @vapid_subject = value
+    end
+  end
+end
