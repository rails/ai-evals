+class Notification::Push
+  include NotificationsHelper
+  include Rails.application.routes.url_helpers
+
+  attr_reader :notification
+  delegate :account, :card, :creator, :source, :source_type, :user, to: :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def deliver
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver payload
+    end
+  end
+
+  def deliver_later
+    user.push_subscriptions.find_each do |subscription|
+      Push::DeliveryJob.perform_later subscription, payload
+    end
+  end
+
+  alias deliver_now deliver
+  alias enqueue deliver_later
+
+  def payload
+    @payload ||= data.to_json
+  end
+  alias message payload
+
+  def data
+    @data ||= rendered_body.merge("url" => url)
+  end
+
+  def as_json(*)
+    data
+  end
+
+  def to_json(*)
+    payload
+  end
+
+  def title
+    rendered_body["title"]
+  end
+
+  def body
+    rendered_body["body"]
+  end
+
+  def url
+    card_path(card, script_name: account.slug)
+  end
+
+  private
+    def rendered_body
+      @rendered_body ||= JSON.parse(renderer.render(
+        partial: "notifications/notification/#{source.class.name.underscore}/body",
+        formats: :json,
+        locals: { notification: notification }
+      ))
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: account.slug, https: !Rails.env.local?)
+    end
+end
