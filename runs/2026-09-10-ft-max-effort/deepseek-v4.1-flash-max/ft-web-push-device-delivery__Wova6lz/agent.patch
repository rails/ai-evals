--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,37 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint]).tap do |subscription|
+      subscription.assign_attributes(subscription_params)
+      subscription.user_agent = request.user_agent
+      subscription.save!
+    end
+
+    head :created
+  end
+
+  def destroy
+    subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:endpoint] || params.dig(:push_subscription, :endpoint))
+    subscription&.destroy!
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..871503f
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,106 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "toggle" ]
+  static values = { vapidPublicKey: String, subscribeUrl: String }
+
+  connect() {
+    if (!this.supported) {
+      this.#hide()
+      return
+    }
+
+    this.#sync().then(() => this.#render()).catch(() => this.#render())
+  }
+
+  async toggle() {
+    if (this.#subscribed) {
+      await this.#unsubscribe()
+    } else {
+      await this.#subscribe()
+    }
+
+    this.#render()
+  }
+
+  get supported() {
+    return "Notification" in window &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window
+  }
+
+  get #subscribed() {
+    return Boolean(this.subscription)
+  }
+
+  async #sync() {
+    const registration = await navigator.serviceWorker.ready
+    this.subscription = await registration.pushManager.getSubscription()
+  }
+
+  async #subscribe() {
+    if (!this.vapidPublicKeyValue) return
+
+    if (Notification.permission !== "granted") {
+      await Notification.requestPermission()
+    }
+
+    if (Notification.permission !== "granted") return
+
+    const registration = await navigator.serviceWorker.ready
+    this.subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: decodeBase64URL(this.vapidPublicKeyValue)
+    })
+
+    await post(this.subscribeUrlValue, {
+      body: { push_subscription: subscriptionJSON(this.subscription) },
+      responseKind: "json"
+    })
+  }
+
+  async #unsubscribe() {
+    const endpoint = this.subscription.endpoint
+
+    try {
+      await this.subscription.unsubscribe()
+    } finally {
+      this.subscription = null
+    }
+
+    await destroy(this.subscribeUrlValue, { query: { endpoint }, responseKind: "json" }).catch(() => {})
+  }
+
+  #render() {
+    this.element.classList.toggle("notifications--on", this.#subscribed)
+    this.element.classList.toggle("notifications--off", !this.#subscribed)
+
+    const blocked = Notification.permission === "denied"
+    this.detailsTargets.forEach((element) => element.hidden = !blocked)
+
+    if (this.hasToggleTarget) {
+      this.toggleTarget.disabled = !this.#subscribed && !this.vapidPublicKeyValue
+    }
+  }
+
+  #hide() {
+    this.element.hidden = true
+  }
+}
+
+function subscriptionJSON(subscription) {
+  const json = subscription.toJSON()
+  return {
+    endpoint: subscription.endpoint,
+    p256dh_key: json.keys?.p256dh,
+    auth_key: json.keys?.auth
+  }
+}
+
+function decodeBase64URL(value) {
+  const padding = "=".repeat((4 - value.length % 4) % 4)
+  const base64 = (value + padding).replace(/-/g, "+").replace(/_/g, "/")
+  const binary = atob(base64)
+  return Uint8Array.from(binary, (character) => character.charCodeAt(0))
+}
