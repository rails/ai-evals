diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..7e29ac1
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,215 @@
+# Computes and tracks the storage used by the files we count:
+#
+# * Card images.
+# * Files embedded in board public descriptions, card descriptions, and comments.
+#
+# A board's usage includes its own public description plus every card that belongs
+# to it. An account's usage is the sum of all its boards. Counters live on the
+# accounts and boards tables so reads stay cheap, and are reconciled in the
+# background by Storage::RecalculateJob.
+module Storage
+  class Usage
+    attr_reader :record
+
+    def initialize(record = nil)
+      @record = record
+    end
+
+    def bytes_used
+      case record
+      when Account then self.class.for_account(record)
+      when Board then self.class.for_board(record)
+      when Card then self.class.for_card(record)
+      else 0
+      end
+    end
+    alias_method :total, :bytes_used
+
+    class << self
+      def for(record)
+        new(record).bytes_used
+      end
+
+      def for_account(account)
+        card_image_bytes(account.cards.select(:id)) + embed_bytes(rich_texts_for_account(account))
+      end
+
+      def for_board(board)
+        card_image_bytes(board.cards.select(:id)) + embed_bytes(rich_texts_for_board(board))
+      end
+
+      def for_card(card)
+        card_image_bytes(card.id) + embed_bytes(rich_texts_for_card(card))
+      end
+
+      # Called when a counted attachment is created.
+      def attachment_created(attachment)
+        if snapshot = snapshot_for(attachment)
+          adjust snapshot[:owners], snapshot[:bytes]
+        end
+      end
+
+      # Called when a counted attachment is destroyed through callbacks.
+      def attachment_destroyed(attachment, snapshot = nil)
+        if snapshot ||= snapshot_for(attachment)
+          adjust snapshot[:owners], -snapshot[:bytes]
+        end
+      end
+      alias_method :attachment_deleted, :attachment_destroyed
+
+      # Captures the owner and byte size before an attachment is removed.
+      def snapshot_for(attachment)
+        if owners = owners_for(attachment)
+          { owners: owners, bytes: attachment.blob&.byte_size.to_i }
+        end
+      end
+
+# Called when a blob is updated after being attached (for example, when a
+# direct upload learns the final byte size).
+def blob_updated(blob)
+  delta = blob.saved_change_to_byte_size&.then { |was, now| now - was }.to_i
+  return if delta.zero?
+
+  blob.attachments.each do |attachment|
+    if owners = owners_for(attachment)
+      adjust owners, delta
+    end
+  end
+end
+
+      # Moves all the storage attributed to a card from one board to another.
+      def transfer_card(card, from:, to:, bytes: nil)
+        bytes ||= for_card(card)
+        return if bytes.zero?
+
+        adjust({ board: from, account: nil }, -bytes) if from
+        adjust({ board: to, account: nil }, bytes) if to
+      end
+
+# Recalculate the counters associated with a rich text or record after a
+# bulk change that bypassed Active Storage callbacks.
+def recalculate_for_record(record)
+  case record
+  when ActionText::RichText
+    if owner = rich_text_owner(record)
+      owner.recalculate_bytes_used
+      owner.account.recalculate_bytes_used
+    end
+  when Board
+    record.recalculate_bytes_used
+    record.account.recalculate_bytes_used
+  when Card, Comment
+    board = record.is_a?(Card) ? record.board : record.card&.board
+    if board
+      board.recalculate_bytes_used
+      board.account.recalculate_bytes_used
+    end
+  end
+end
+
+      def owners_for(attachment)
+        board = owner_board_for(attachment)
+        { board: board, account: board&.account } if board
+      rescue ActiveRecord::RecordNotFound
+        nil
+      end
+
+      private
+        def owner_board_for(attachment)
+          case [ attachment.record_type, attachment.name ]
+          when [ "Card", "image" ]
+            attachment.record&.board
+          when [ "ActionText::RichText", "embeds" ]
+            rich_text_owner(attachment.record)
+          end
+        end
+
+        def rich_text_owner(rich_text)
+          case [ rich_text&.record_type, rich_text&.name ]
+          when [ "Board", "public_description" ]
+            rich_text.record
+          when [ "Card", "description" ]
+            rich_text.record.board
+          when [ "Comment", "body" ]
+            rich_text.record.card&.board
+          end
+        end
+
+        def adjust(owners, delta)
+          return if delta.zero?
+
+          update_counter(Board, owners[:board], delta)
+          update_counter(Account, owners[:account], delta)
+        end
+
+        def update_counter(model, record, delta)
+          return unless record&.id
+
+          # Claim the stale flag and update the counter atomically. Only the
+          # change that flips the flag enqueues a reconciliation job, so a burst
+          # of activity results in a single recalculation.
+          claimed = model.where(id: record.id, bytes_used_stale: false).update_all([
+            "bytes_used = COALESCE(bytes_used, 0) + ?, bytes_used_stale = 1, bytes_used_version = COALESCE(bytes_used_version, 0) + 1",
+            delta
+          ])
+
+          if claimed.zero?
+            model.where(id: record.id).update_all([
+              "bytes_used = COALESCE(bytes_used, 0) + ?, bytes_used_version = COALESCE(bytes_used_version, 0) + 1",
+              delta
+            ])
+          else
+            Storage::RecalculateJob.perform_later(record)
+          end
+        end
+
+        def card_image_bytes(card_ids)
+          ActiveStorage::Attachment
+            .joins(:blob)
+            .where(record_type: "Card", name: "image", record_id: card_ids)
+            .sum("active_storage_blobs.byte_size")
+        end
+
+        def embed_bytes(rich_text_ids)
+          ActiveStorage::Attachment
+            .joins(:blob)
+            .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+            .sum("active_storage_blobs.byte_size")
+        end
+
+        def rich_texts_for_account(account)
+          ActionText::RichText.where(account_id: account.id).where(
+            record_type: "Board", name: "public_description", record_id: account.boards.select(:id)
+          ).or(
+            ActionText::RichText.where(account_id: account.id)
+              .where(record_type: "Card", name: "description", record_id: account.cards.select(:id))
+          ).or(
+            ActionText::RichText.where(account_id: account.id)
+              .where(record_type: "Comment", name: "body", record_id: Comment.where(card_id: account.cards.select(:id)).select(:id))
+          )
+        end
+
+        def rich_texts_for_board(board)
+          card_ids = board.cards.select(:id)
+          comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+          ActionText::RichText.where(account_id: board.account_id).where(
+            record_type: "Board", name: "public_description", record_id: board.id
+          ).or(
+            ActionText::RichText.where(account_id: board.account_id)
+              .where(record_type: "Card", name: "description", record_id: card_ids)
+          ).or(
+            ActionText::RichText.where(account_id: board.account_id)
+              .where(record_type: "Comment", name: "body", record_id: comment_ids)
+          )
+        end
+
+        def rich_texts_for_card(card)
+          card
+            .then { |card| ActionText::RichText.where(account_id: card.account_id).where(record_type: "Card", name: "description", record_id: card.id) }
+            .or(ActionText::RichText.where(account_id: card.account_id)
+              .where(record_type: "Comment", name: "body", record_id: card.comments.select(:id)))
+        end
+    end
+  end
+end
