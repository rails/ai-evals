diff --git a/lib/rails_ext/active_storage_bytes_used.rb b/lib/rails_ext/active_storage_bytes_used.rb
new file mode 100644
index 0000000..aefaffe
--- /dev/null
+++ b/lib/rails_ext/active_storage_bytes_used.rb
@@ -0,0 +1,87 @@
+# Keeps account and board storage counters in step with the Active Storage
+# attachments we count. Counter updates happen in the same transaction as the
+# attachment change, and a background job reconciles the exact totals.
+module ActiveStorageBytesUsed
+  def self.prepended(base)
+    base.after_create { Storage::Usage.attachment_created(self) }
+    base.before_destroy { @storage_usage_snapshot = Storage::Usage.snapshot_for(self) }
+    base.after_destroy { Storage::Usage.attachment_destroyed(self, @storage_usage_snapshot) }
+  end
+
+  def delete
+    snapshot = Storage::Usage.snapshot_for(self)
+
+    super.tap do
+      Storage::Usage.attachment_destroyed(self, snapshot) if snapshot
+    end
+  end
+end
+
+# #detach on a has_many_attached association deletes rows in bulk, bypassing the
+# attachment callbacks above. Recalculate after the fact so the counters recover.
+module ActiveStorageDetachManyStorageUsage
+  def detach
+    super.tap { Storage::Usage.recalculate_for_record(record) if record }
+  end
+end
+
+# Relation#delete_all also bypasses callbacks. Capture the counted attachments
+# first and apply their deltas once the bulk delete succeeds.
+module ActiveStorageDeleteAllStorageUsage
+  def delete_all(...)
+    return super if Thread.current[:active_storage_storage_usage_delete_all]
+
+    snapshots = to_a.filter_map do |attachment|
+      if snapshot = Storage::Usage.snapshot_for(attachment)
+        [ attachment, snapshot ]
+      end
+    end
+
+    Thread.current[:active_storage_storage_usage_delete_all] = true
+    begin
+      result = super
+    ensure
+      Thread.current[:active_storage_storage_usage_delete_all] = nil
+    end
+
+    snapshots.each { |attachment, snapshot| Storage::Usage.attachment_destroyed(attachment, snapshot) }
+    result
+  end
+end
+
+module ActiveStorageBlobBytesUsed
+  def self.prepended(base)
+    base.after_update { Storage::Usage.blob_updated(self) if saved_change_to_byte_size? }
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend ActiveStorageBytesUsed
+end
+
+Rails.application.config.to_prepare do
+  detach_many = ActiveStorage::Attached::Changes::DetachMany
+  unless detach_many.ancestors.include?(ActiveStorageDetachManyStorageUsage)
+    detach_many.prepend ActiveStorageDetachManyStorageUsage
+  end
+
+  attachment_relation = ActiveStorage::Attachment.all.class
+  unless attachment_relation.ancestors.include?(ActiveStorageDeleteAllStorageUsage)
+    attachment_relation.prepend ActiveStorageDeleteAllStorageUsage
+  end
+
+  proxy_class =
+    begin
+      ActiveStorage::Attachment.const_get(:ActiveRecord_Associations_CollectionProxy)
+    rescue NameError
+      ActionText::RichText.new.embeds_attachments.class
+    end
+
+  unless proxy_class.ancestors.include?(ActiveStorageDeleteAllStorageUsage)
+    proxy_class.prepend ActiveStorageDeleteAllStorageUsage
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  prepend ActiveStorageBlobBytesUsed
+end
