@@ -0,0 +1,56 @@
+module Account::BytesUsed
+  extend ActiveSupport::Concern
+
+  # Reads through to the database so the returned value is current even if the
+  # caller's in-memory copy predates the background reconciliation.
+  def bytes_used
+    if new_record?
+      self[:bytes_used] || 0
+    else
+      value, version = self.class.where(id: id).pick(:bytes_used, :bytes_used_version)
+      value ||= 0
+
+      # Records created before tracking existed (or populated in bulk) have a zero
+      # version. Initialize them lazily so the first read is still accurate.
+      if value.zero? && version.to_i.zero?
+        board_total = boards.sum(:bytes_used)
+
+        if board_total.positive?
+          self.class.where(id: id, bytes_used_version: 0).update_all(bytes_used: board_total, bytes_used_stale: false, bytes_used_version: 1)
+          value = board_total
+        else
+          recalculate_bytes_used
+          value = self.class.where(id: id).pick(:bytes_used) || 0
+        end
+      end
+
+      value
+    end
+  end
+
+  def calculate_bytes_used
+    Storage::Usage.for_account(self)
+  end
+
+  def recalculate_bytes_used
+    return unless persisted?
+
+    version = self.class.where(id: id).pick(:bytes_used_version)
+    calculated = calculate_bytes_used
+
+    unless self.class.where(id: id, bytes_used_version: version)
+               .update_all(bytes_used: calculated, bytes_used_stale: false, bytes_used_version: version.to_i + 1) == 1
+      recalculate_bytes_used_later
+    end
+  end
+
+  def recalculate_bytes_used_later
+    Storage::RecalculateJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_if_stale
+    return unless persisted?
+
+    recalculate_bytes_used if self.class.where(id: id).pick(:bytes_used_stale)
+  end
+end
