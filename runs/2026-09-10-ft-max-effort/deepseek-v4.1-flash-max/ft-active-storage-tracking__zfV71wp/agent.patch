new file mode 100644
index 0000000..f4e73ea
--- /dev/null
+++ b/app/jobs/storage/recalculate_job.rb
@@ -0,0 +1,23 @@
+class Storage::RecalculateJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(*records)
+    records.flatten.compact.each do |record|
+      record = GlobalID::Locator.locate(record) if record.is_a?(String)
+
+      case record
+      when nil
+        next
+      when ActiveStorage::Attachment
+        Storage::Usage.recalculate_for_record(record.record)
+      else
+        if record.respond_to?(:recalculate_bytes_used)
+          record.recalculate_bytes_used
+          record.account.recalculate_bytes_used if record.is_a?(Board)
+        else
+          Storage::Usage.recalculate_for_record(record)
+        end
+      end
+    end
+  end
+end
