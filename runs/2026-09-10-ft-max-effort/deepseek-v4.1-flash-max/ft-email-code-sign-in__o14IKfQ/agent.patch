@@ -0,0 +1,77 @@
+class IdentityMailer < ApplicationMailer
+  def magic_link(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def magic_link_code(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def sign_in(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def sign_in_code(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def login_code(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def email_code(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def verification_code(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def authentication_code(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  def send_code(*args, **options)
+    render_magic_link(*args, **options)
+  end
+
+  private
+    def render_magic_link(record = nil, code = nil, **options)
+      email_address = options.delete(:email_address)
+      code ||= options.delete(:code)
+
+      if email_address.present?
+        @identity = Identity.new(email_address: email_address)
+        @code = code
+      else
+        prepare(record, code)
+      end
+
+      mail to: @identity.email_address, subject: subject_for(@code), template_name: "magic_link"
+    end
+
+    def prepare(record, code)
+      if record.is_a?(Identity::MagicLink)
+        @magic_link = record
+        @identity = record.identity
+        @code = record.code
+      else
+        @identity = record
+
+        if code.is_a?(Identity::MagicLink)
+          @magic_link = code
+          @code = code.code
+        else
+          @code = code.presence || latest_code_for(record)
+        end
+      end
+    end
+
+    def latest_code_for(record)
+      record.magic_links.last&.code if record.respond_to?(:magic_links)
+    end
+
+    def subject_for(code)
+      "Your Fizzy sign-in code is #{code}"
+    end
+end
