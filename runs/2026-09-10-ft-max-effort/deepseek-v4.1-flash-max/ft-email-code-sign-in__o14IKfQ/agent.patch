@@ -0,0 +1,86 @@
+class Sessions::MagicLinksController < ApplicationController
+  skip_before_action :require_account
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @magic_link = pending_authentication_magic_link
+    @email_address = @magic_link&.identity&.email_address || pending_authentication_identity&.email_address
+  end
+
+  def create
+    if magic_link = authenticate_magic_link
+      pending_authentication = self.pending_authentication
+
+      magic_link.consume
+      start_new_session_for magic_link.identity
+      clear_pending_authentication
+
+      respond_to do |format|
+        format.html { redirect_after_authentication(pending_authentication, magic_link) }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+
+    def authenticate_magic_link
+      code = submitted_code
+      return if code.blank?
+
+      if magic_link = pending_authentication_magic_link
+        magic_link if magic_link.verify(code)
+      elsif identity = pending_authentication_identity
+        identity.magic_links.active.find { |magic_link| magic_link.verify(code) }
+      end
+    end
+
+    def submitted_code
+      code = params[:code] || params.dig(:magic_link, :code)
+      code.to_s.strip
+    end
+
+    def redirect_after_authentication(pending_authentication, magic_link)
+      if join_code = pending_join_code(pending_authentication)
+        complete_join(join_code)
+      elsif return_to = pending_authentication&.dig("return_to").presence || magic_link.return_to.presence
+        redirect_to return_to
+      else
+        redirect_to after_authentication_url
+      end
+    end
+
+    def pending_join_code(pending_authentication)
+      if join_code_id = pending_authentication&.dig("join_code")
+        Account::JoinCode.find_by(id: join_code_id)
+      end
+    end
+
+    def complete_join(join_code)
+      identity = Current.identity
+      join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      if user.setup?
+        redirect_to landing_url(script_name: join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+end
