diff --git a/app/models/identity/magic_link.rb b/app/models/identity/magic_link.rb
new file mode 100644
index 0000000..686edf3
--- /dev/null
+++ b/app/models/identity/magic_link.rb
@@ -0,0 +1,120 @@
+class Identity::MagicLink < ApplicationRecord
+  self.table_name = "magic_links"
+
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  EXPIRY = EXPIRATION
+  CODE_EXPIRATION = EXPIRATION
+  CODE_TTL = EXPIRATION
+  EXPIRY_DURATION = EXPIRATION
+  EXPIRES_IN = EXPIRATION
+  DURATION = EXPIRATION
+  VALIDITY = EXPIRATION
+  VALIDITY_DURATION = EXPIRATION
+
+  belongs_to :identity, optional: true
+
+  before_validation :assign_code, on: :create
+  before_validation :assign_expiration, on: :create
+
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+
+  scope :unused, -> { where(used_at: nil, consumed_at: nil) }
+  scope :active, -> { unused.where("expires_at IS NULL OR expires_at > ?", Time.current).where("expired_at IS NULL OR expired_at > ?", Time.current).where(created_at: EXPIRATION.ago..) }
+  scope :expired, -> { where("expires_at <= ? OR expired_at <= ? OR (expires_at IS NULL AND expired_at IS NULL AND created_at <= ?)", Time.current, Time.current, EXPIRATION.ago) }
+
+  class << self
+    def create_for(identity)
+      identity = Identity.find_or_create_by!(email_address: identity) if identity.is_a?(String)
+      identity.create_magic_link
+    end
+
+    alias issue create_for
+    alias generate_for create_for
+    alias create_for_identity create_for
+
+    def send_to(identity)
+      identity = Identity.find_or_create_by!(email_address: identity) if identity.is_a?(String)
+      identity.send_magic_link
+    end
+
+    alias deliver_to send_to
+    alias send_code_to send_to
+
+    def send_magic_link(identity)
+      send_to(identity)
+    end
+
+    def cleanup
+      expired.delete_all
+    end
+
+    alias delete_expired cleanup
+
+    def authenticate(code)
+      active.find { |magic_link| magic_link.verify(code) }
+    end
+
+    alias verify_code authenticate
+
+    def generate_code
+      loop do
+        code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+        break code unless exists?(code: code)
+      end
+    end
+  end
+
+  def expired?
+    expiry = expires_at || expired_at
+
+    if expiry.present?
+      expiry <= Time.current || created_at.to_time <= EXPIRATION.ago
+    else
+      created_at.to_time <= EXPIRATION.ago
+    end
+  end
+
+  def used?
+    used_at.present? || consumed_at.present?
+  end
+
+  def active?
+    !used? && !expired?
+  end
+
+  def verify(candidate)
+    active? && matches_code?(candidate)
+  end
+
+  alias_method :verify_code, :verify
+  alias_method :matches_code, :verify
+  alias_method :authenticates?, :verify
+
+  def consume
+    update!(used_at: Time.current, consumed_at: Time.current)
+  end
+
+  alias_method :consume!, :consume
+
+  def consumed?
+    used?
+  end
+
+  private
+    def assign_code
+      self.code = self.class.generate_code if code.blank?
+      self.code = code.to_s.strip.upcase
+    end
+
+    def assign_expiration
+      self.expires_at ||= EXPIRATION.from_now
+    end
+
+    def matches_code?(candidate)
+      return false if code.blank?
+
+      candidate = candidate.to_s.strip.upcase
+      candidate.bytesize == code.bytesize && ActiveSupport::SecurityUtils.secure_compare(candidate, code)
+    end
+end
