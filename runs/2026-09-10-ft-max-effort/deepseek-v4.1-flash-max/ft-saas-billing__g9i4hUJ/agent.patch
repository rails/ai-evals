diff --git a/saas/app/controllers/account/billing_portals_controller.rb b/saas/app/controllers/account/billing_portals_controller.rb
new file mode 100644
index 0000000..1508e6f
--- /dev/null
+++ b/saas/app/controllers/account/billing_portals_controller.rb
@@ -0,0 +1,21 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_account
+
+  def new
+    redirect_to saas.account_billing_path
+  end
+
+  def create
+    session = @account.create_stripe_billing_portal_session(return_url: saas.account_billing_url)
+
+    redirect_to session.url, allow_other_host: true
+  rescue ArgumentError, Stripe::StripeError => error
+    redirect_to saas.account_billing_path, alert: error.message
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+end
diff --git a/saas/app/controllers/account/billings_controller.rb b/saas/app/controllers/account/billings_controller.rb
new file mode 100644
index 0000000..fdad6a2
--- /dev/null
+++ b/saas/app/controllers/account/billings_controller.rb
@@ -0,0 +1,47 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin, only: %i[ checkout create portal new ]
+  before_action :set_account
+
+  def show
+    @plans = [ Subscription::UnlimitedV1, Subscription::UnlimitedPlusV1 ]
+  end
+
+  def index
+    redirect_to saas.account_billing_path
+  end
+
+  def new
+    redirect_to saas.account_billing_path
+  end
+
+  def checkout
+    session = @account.create_stripe_checkout_session(
+      requested_plan_key,
+      success_url: saas.account_billing_url,
+      cancel_url: saas.account_billing_url
+    )
+
+    redirect_to session.url, allow_other_host: true
+  rescue ArgumentError, Stripe::StripeError => error
+    redirect_to saas.account_billing_path, alert: error.message
+  end
+
+  alias_method :create, :checkout
+
+  def portal
+    session = @account.create_stripe_billing_portal_session(return_url: saas.account_billing_url)
+
+    redirect_to session.url, allow_other_host: true
+  rescue ArgumentError, Stripe::StripeError => error
+    redirect_to saas.account_billing_path, alert: error.message
+  end
+
+  private
+    def requested_plan_key
+      params[:plan].presence || params[:plan_key].presence || params.dig(:subscription, :plan).presence || Subscription::UnlimitedV1.short_name
+    end
+
+    def set_account
+      @account = Current.account
+    end
+end
