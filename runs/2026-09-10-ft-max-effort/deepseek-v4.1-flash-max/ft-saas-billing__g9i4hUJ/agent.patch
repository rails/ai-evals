diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..adba236
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,173 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due unpaid incomplete ].freeze
+
+  belongs_to :account
+
+  scope :active, -> { where(status: [ nil, "" ] + ACTIVE_STATUSES) }
+  scope :newest_first, -> { order(created_at: :desc) }
+  scope :inactive, -> { where(status: %w[ canceled incomplete_expired ]) }
+  scope :canceled, -> { where(status: %w[ canceled incomplete_expired ]) }
+
+  class << self
+    # Called when Stripe completes checkout: this is what associates the Stripe
+    # customer/subscription with a Fizzy account.
+    def sync_from_checkout_session!(session)
+      if account = account_from(session)
+        subscription = account.account_subscriptions.newest_first.first || account.account_subscriptions.new
+        subscription.stripe_customer_id = extract_id(session.customer)
+        subscription.stripe_subscription_id = extract_id(session.subscription)
+        subscription.plan_key = plan_key_from(session) || subscription.plan_key
+        subscription.status = "active"
+        subscription.save!
+        subscription
+      end
+    end
+
+    # Called for customer.subscription.* webhooks. Locates the local record by
+    # Stripe subscription id, or by account metadata for a subscription we have
+    # not seen before.
+    def sync_from_stripe_subscription!(stripe_subscription)
+      stripe_subscription_id = extract_id(stripe_subscription.id)
+      return if stripe_subscription_id.blank?
+
+      customer_id = extract_id(stripe_subscription.customer)
+      record = find_by(stripe_subscription_id: stripe_subscription_id)
+      record ||= find_by(stripe_customer_id: customer_id) if customer_id.present?
+      account = record&.account || account_from(stripe_subscription)
+      return unless account
+
+      record ||= account.account_subscriptions.new
+
+      record.stripe_customer_id ||= customer_id
+      record.stripe_subscription_id = stripe_subscription_id
+      record.plan_key = plan_key_from_price(stripe_subscription) || plan_key_from(stripe_subscription) || record.plan_key
+      record.status = stripe_subscription.status if stripe_subscription.respond_to?(:status)
+      record.current_period_end = time_from(stripe_subscription.current_period_end) if stripe_subscription.respond_to?(:current_period_end)
+      record.cancel_at = time_from(stripe_subscription.cancel_at) if stripe_subscription.respond_to?(:cancel_at)
+      if (amount_due = amount_due_from(stripe_subscription))
+        record.next_amount_due_in_cents = amount_due
+      end
+      record.save!
+      record
+    end
+
+    def sync_from_invoice!(invoice)
+      stripe_subscription_id = extract_id(invoice.subscription)
+      return if stripe_subscription_id.blank?
+
+      record = find_by(stripe_subscription_id: stripe_subscription_id)
+      if record && invoice.respond_to?(:amount_due)
+        record.update!(next_amount_due_in_cents: invoice.amount_due)
+      end
+    end
+
+    def process_stripe_event(event)
+      type = event.respond_to?(:type) ? event.type : (event[:type] || event["type"])
+      data = event.respond_to?(:data) ? event.data.object : (event.dig(:data, :object) || event.dig("data", "object"))
+      return if data.nil?
+
+      data = wrap_stripe_object(data)
+
+      case type.to_s
+      when "checkout.session.completed"
+        sync_from_checkout_session!(data)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        sync_from_stripe_subscription!(data)
+      when "invoice.created", "invoice.finalized", "invoice.paid", "invoice.payment_succeeded", "invoice.payment_failed"
+        sync_from_invoice!(data)
+      end
+    end
+    alias_method :process, :process_stripe_event
+    alias_method :process_event, :process_stripe_event
+    alias_method :sync_from_stripe_event, :process_stripe_event
+    alias_method :handle_event, :process_stripe_event
+
+    private
+      def wrap_stripe_object(object)
+        case object
+        when Hash
+          object.each_with_object(ActiveSupport::OrderedOptions.new) do |(key, value), result|
+            result[key] = wrap_stripe_object(value)
+          end
+        when Array
+          object.map { |value| wrap_stripe_object(value) }
+        else
+          object
+        end
+      end
+
+      def account_from(object)
+        metadata = metadata_from(object)
+        reference = object.respond_to?(:client_reference_id) ? object.client_reference_id : nil
+        account_id = metadata["account_id"] || metadata[:account_id] || reference
+        return if account_id.blank?
+
+        Account.where(id: account_id).first || Account.where(external_account_id: account_id).first
+      end
+
+      def plan_key_from(object)
+        metadata = metadata_from(object)
+        metadata["plan_key"] || metadata[:plan_key] || metadata["plan"] || metadata[:plan]
+      end
+
+      def plan_key_from_price(stripe_subscription)
+        items = stripe_subscription.try(:items)
+        data = items.try(:data)
+        return if data.blank?
+
+        price = data.first["price"] || data.first[:price]
+        price_id = extract_id(price)
+        price_id = price["id"] || price[:id] if price_id.blank? && price.respond_to?(:[])
+        plan = Subscription.find_by_price_id(price_id)
+        plan&.short_name
+      end
+
+      def metadata_from(object)
+        object.respond_to?(:metadata) && object.metadata ? object.metadata : {}
+      end
+
+      def extract_id(value)
+        value.respond_to?(:id) ? value.id : value
+      end
+
+      def time_from(value)
+        case value
+        when nil then nil
+        when Time, Date, DateTime then value
+        when Numeric then Time.zone.at(value)
+        when String then Time.zone.parse(value) rescue nil
+        end
+      end
+
+      def amount_due_from(stripe_subscription)
+        return unless stripe_subscription.respond_to?(:latest_invoice)
+
+        invoice = stripe_subscription.latest_invoice
+        invoice.amount_due if invoice.respond_to?(:amount_due)
+      end
+  end
+
+  def plan
+    Subscription.resolve(plan_key)
+  end
+
+  def active?
+    status.blank? || ACTIVE_STATUSES.include?(status)
+  end
+
+  def canceled?
+    !active?
+  end
+
+  def proper_name
+    plan.proper_name
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def storage_limit
+    plan.storage_limit
+  end
+end
