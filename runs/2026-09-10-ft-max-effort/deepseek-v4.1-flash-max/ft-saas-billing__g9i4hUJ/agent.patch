+++ b/saas/app/controllers/admin/account/billing_waivers_controller.rb
@@ -0,0 +1,34 @@
+class Admin::Account::BillingWaiversController < AdminController
+  layout "public"
+
+  before_action :set_account
+
+  def create
+    if request.delete?
+      uncomp
+    else
+      comp
+    end
+  end
+
+  alias_method :update, :create
+
+  def destroy
+    uncomp
+  end
+
+  private
+    def comp
+      @account.comp!
+      redirect_to saas.admin_account_path(@account), notice: "Account comped"
+    end
+
+    def uncomp
+      @account.uncomp!
