+          <% end %>
+        </dd>
+      </div>
+      <div>
+        <dt class="txt-small txt-ink-medium">Bytes used</dt>
+        <dd>
+          <%= number_to_human_size(@account.bytes_used) %>
+          / <%= number_to_human_size(@account.storage_limit) %>
+        </dd>
+      </div>
+      <div>
+        <dt class="txt-small txt-ink-medium">Comped</dt>
