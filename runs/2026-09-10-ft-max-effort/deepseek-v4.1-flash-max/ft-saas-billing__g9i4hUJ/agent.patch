+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used", class: "txt-small" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, placeholder: "Bytes used", class: "input" %>
+      </div>
+
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <div class="flex gap margin-block-half">
+      <%= button_to "Reset", saas.admin_account_reset_path(@account), method: :post, class: "btn btn--negative" %>
+    </div>
+  </div>
+</section>
