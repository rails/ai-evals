+        <dt class="txt-small txt-ink-medium">Name</dt>
+        <dd><%= @account.name %></dd>
+      </div>
+      <div>
+        <dt class="txt-small txt-ink-medium">Queenbee ID</dt>
+        <dd>#<%= @account.external_account_id %></dd>
+      </div>
+      <div>
+        <dt class="txt-small txt-ink-medium">Plan</dt>
