new file mode 100644
index 0000000..18eaa59
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,229 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_PLAN_KEY = "FreeV1".freeze
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+  FREE_CARD_LIMIT = 1_000
+
+  included do
+    has_many :account_subscriptions, -> { newest_first }, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def account_subscription
+    account_subscriptions.first
+  end
+
+  def subscription
+    account_subscription
+  end
+
+  def active_subscription
+    account_subscriptions.detect(&:active?)
+  end
+
+  def plan
+    Subscription.plan_name(plan_key)
+  end
+
+  def free_plan?
+    plan.free?
+  end
+
+  def paid_plan?
+    plan.paid?
+  end
+
+  def plan_key
+    active_subscription&.plan_key.presence || FREE_PLAN_KEY
+  end
+
+  def current_subscription
+    active_subscription || account_subscription
+  end
+
+  def current_plan
+    plan
+  end
+
+  def subscription_plan
+    Subscription.resolve(plan_key)
+  end
+
+  def create_stripe_checkout_session(plan_key, success_url:, cancel_url:)
+    plan = Subscription.resolve(plan_key)
+    raise ArgumentError, "Unknown plan: #{plan_key}" unless plan&.paid?
+
+    options = {
+      mode: "subscription",
+      client_reference_id: id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      subscription_data: { metadata: stripe_metadata(plan) },
+      metadata: stripe_metadata(plan),
+      success_url: success_url,
+      cancel_url: cancel_url
+    }
+
+    if (stripe_customer_id = active_subscription&.stripe_customer_id).present?
+      options[:customer] = stripe_customer_id
+    else
+      options[:customer_email] = owner_billing_email
+    end
+
+    Stripe::Checkout::Session.create(**options)
+  end
+
+  def create_stripe_billing_portal_session(return_url:)
+    subscription = active_subscription || account_subscription
+    raise ArgumentError, "No Stripe customer" unless subscription&.stripe_customer_id.present?
+
+    Stripe::BillingPortal::Session.create(
+      customer: subscription.stripe_customer_id,
+      return_url: return_url
+    )
+  end
+
+  def card_limit
+    limit = overridden_limit
+    if limit && !limit.destroyed? && !limit.card_count.nil?
+      limit.card_count
+    else
+      plan.card_limit
+    end
+  end
+
+  alias_method :cards_limit, :card_limit
+  alias_method :card_count_limit, :card_limit
+  alias_method :max_cards, :card_limit
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+  alias_method :unlimited?, :unlimited_cards?
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - cards_count, 0 ].max
+    end
+  end
+
+  alias_method :remaining_cards, :cards_remaining
+  alias_method :cards_available, :cards_remaining
+  alias_method :remaining_card_count, :cards_remaining
+  alias_method :cards_until_limit, :cards_remaining
+  alias_method :card_limit_remaining, :cards_remaining
+
+  def cards_left
+    cards_remaining
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_count >= card_limit
+  end
+
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+  alias_method :card_limit_reached?, :exceeding_card_limit?
+  alias_method :out_of_cards?, :exceeding_card_limit?
+  alias_method :over_card_limit?, :exceeding_card_limit?
+
+  def at_card_limit?
+    exceeding_card_limit?
+  end
+
+  def nearing_card_limit?
+    !exceeding_card_limit? && cards_remaining && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  def billing_waiver?
+    billing_waiver.present?
+  end
+
+  def comped?
+    waiver = billing_waiver
+    waiver.present? && !waiver.destroyed?
+  end
+
+  alias_method :comped, :comped?
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      comp!
+    else
+      uncomp!
+    end
+  end
+
+  def comp!
+    create_billing_waiver! unless comped?
+  end
+
+  alias_method :comp, :comp!
+
+  def uncomp!
+    if billing_waiver
+      billing_waiver.destroy
+      association(:billing_waiver).reset
+    end
+  end
+
+  alias_method :uncomp, :uncomp!
+
+  def override_limits!(card_count: nil, bytes_used: nil)
+    limit = overridden_limit
+    limit = build_overridden_limit unless limit && !limit.destroyed?
+    limit.card_count = card_count unless card_count.nil?
+    limit.bytes_used = bytes_used unless bytes_used.nil?
+    limit.save!
+    limit
+  end
+
+  def reset_overridden_limits!
+    if overridden_limit
+      overridden_limit.destroy
+      association(:overridden_limit).reset
+    end
+  end
+
+  alias_method :reset_overridden_limits, :reset_overridden_limits!
+  alias_method :override_limits, :override_limits!
+
+  def create_account_subscription!(attributes = {})
+    account_subscriptions.create!(attributes)
+  end
+
+  def build_account_subscription(attributes = {})
+    account_subscriptions.build(attributes)
+  end
+
+  def subscriptions
+    account_subscriptions
+  end
+
+  def overridden_limits
+    Account::OverriddenLimit.where(account_id: id)
+  end
+
+  def billing_waivers
+    Account::BillingWaiver.where(account_id: id)
+  end
+
+  def overridden_card_limit
+    overridden_limit&.card_count
+  end
+  alias_method :overridden_card_count, :overridden_card_limit
+
+  def overridden_storage_limit
+    overridden_limit&.bytes_used
+  end
+  alias_method :overridden_bytes_used, :overridden_storage_limit
+
+  private
+    def stripe_metadata(plan)
+      { account_id: id, plan_key: plan.short_name }
+    end
+
+    def owner_billing_email
+      users.owner.first&.identity&.email_address
+    end
+end
