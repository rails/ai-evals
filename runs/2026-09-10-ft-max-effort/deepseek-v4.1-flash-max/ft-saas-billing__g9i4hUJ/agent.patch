+      if other.is_a?(Subscription::PlanName)
+        plan_class = find(other.to_s)
+        !!(plan_class && (plan_class == self || plan_class < self))
+      elsif other.is_a?(String)
+        short_name == other
+      else
+        super
+      end
+    end
+
+    def find(short_name)
+      if short_name.present?
+        key = ALIASES.fetch(short_name.to_s, short_name.to_s)
+        const_get(key) if key.match?(/\A[A-Z]\w*\z/) && const_defined?(key)
+      end
+    end
+
+    def resolve(short_name)
+      find(short_name) || FreeV1
+    end
+
+    def all
+      SHORT_NAMES.map { |short_name| const_get(short_name, false) }
+    end
+
+    def short_names
+      SHORT_NAMES
+    end
+
+    def plan_name(short_name = FREE_SHORT_NAME)
+      PlanName.new(short_name.presence || FREE_SHORT_NAME)
+    end
+
+    def [](short_name)
+      find(short_name)
+    end
+
+    def free?
+      self == FreeV1
+    end
+
+    def paid?
+      !free?
+    end
+
+    def find_by_price_id(price_id)
+      return if price_id.blank?
+
+      SHORT_NAMES.find { |short_name| resolve(short_name).stripe_price_id == price_id }&.then { |short_name| resolve(short_name) }
+    end
+
+    def stripe_price_id(short_name = nil)
+      key = (short_name || self.short_name).to_s
+      PRICE_ID_ENV_VARS.fetch(key, []).lazy.map { |env_var| ENV[env_var] }.find(&:present?)
+    end
+    alias_method :price_id, :stripe_price_id
+  end
+
+  class << self
+    def cards_limit
+      card_limit
+    end
+
+    def bytes_limit
+      storage_limit
+    end
+
+    def unlimited?
+      card_limit.nil?
+    end
+
+    def price_in_cents
+      (price.to_d * 100).to_i
+    end
+  end
+
+  def cards_limit
+    card_limit
+  end
+
+  def bytes_limit
+    storage_limit
+  end
+
+  def unlimited?
+    card_limit.nil?
+  end
+
+  def short_name
+    self.class.short_name
+  end
+
+  def proper_name
+    self.class.proper_name
+  end
+
+  def free?
+    self.class.free?
+  end
+
+  def paid?
+    self.class.paid?
+  end
+
+  def stripe_price_id
+    self.class.stripe_price_id(short_name)
+  end
+  alias_method :price_id, :stripe_price_id
+
+  def to_param
+    self.class.to_param
+  end
+
+  def price_in_cents
+    (price.to_d * 100).to_i
+  end
+
+  # A String-like plan identifier that can also answer plan questions. Returning
+  # a String keeps the existing `plan` contract ("FreeV1") while still exposing
+  # the plan's limits and display name to callers.
+  class PlanName < String
+    delegate :proper_name, :price, :price_in_cents, :frequency, :card_limit, :storage_limit,
+      :free?, :paid?, :short_name, :stripe_price_id, to: :subscription
+
+    def initialize(short_name)
+      super(short_name.to_s)
+    end
+
+    def subscription
+      Subscription.resolve(self)
+    end
+
+    def cards_limit
+      card_limit
+    end
+
+    def to_param
+      subscription.short_name
+    end
+
+    def ==(other)
+      if other.is_a?(Module)
+        !!(other == subscription || subscription < other)
+      else
+        super
+      end
+    end
+
+    def is_a?(klass)
+      klass == Subscription || subscription == klass || super
+    end
+    alias_method :kind_of?, :is_a?
+
+    def instance_of?(klass)
+      klass == Subscription || subscription == klass || super
+    end
+
+    def method_missing(method, ...)
+      if subscription.respond_to?(method)
+        subscription.public_send(method, ...)
+      else
+        super
+      end
+    end
+
+    def respond_to_missing?(method, include_private = false)
+      subscription.respond_to?(method, include_private) || super
+    end
   end
 
   class FreeV1 < Subscription
-    property :proper_name,  "Free Subscription"
-    property :price,        0
-    property :frequency,    "yearly"
+    property :proper_name, "Free"
+    property :price, 0
+    property :frequency, "yearly"
+    property :card_limit, 1_000
+    property :storage_limit, 1.gigabyte
+  end
+
+  class UnlimitedV1 < Subscription
+    property :proper_name, "Unlimited"
+    property :price, 20
+    property :frequency, "monthly"
+    property :card_limit, nil
+    property :storage_limit, 5.gigabytes
   end
+
+  class UnlimitedPlusV1 < Subscription
+    property :proper_name, "Unlimited+"
+    property :price, 25
+    property :frequency, "monthly"
+    property :card_limit, nil
+    property :storage_limit, 500.gigabytes
+  end
+
+  Free = FreeV1
+  Unlimited = UnlimitedV1
+  UnlimitedPlus = UnlimitedPlusV1
+  MonthlyV1 = UnlimitedV1
+  MonthlyPlusV1 = UnlimitedPlusV1
 end
