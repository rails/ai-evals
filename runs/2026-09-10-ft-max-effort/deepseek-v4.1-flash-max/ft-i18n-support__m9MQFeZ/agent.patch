diff --git a/lib/localization/dictionary.rb b/lib/localization/dictionary.rb
new file mode 100644
index 0000000..dcf27db
--- /dev/null
+++ b/lib/localization/dictionary.rb
@@ -0,0 +1,26 @@
+module Localization
+  module Dictionary
+    TRANSLATIONS_FILE = Rails.root.join("config/locales/fizzy_dictionary.tsv")
+
+    class << self
+      def translations
+        @translations ||= load_translations
+      end
+
+      private
+        def load_translations
+          return {} unless File.exist?(TRANSLATIONS_FILE)
+
+          File.readlines(TRANSLATIONS_FILE, chomp: true).each_with_object({}) do |line, result|
+            next if line.blank? || line.start_with?("#")
+
+            english, japanese = line.split("\t", 2)
+            next if english.blank? || japanese.blank?
+            next if english.include?("%{")
+
+            result[english] = japanese
+          end.sort_by { |english, _| -english.length }.to_h.freeze
+        end
+    end
+  end
+end
diff --git a/lib/localization/locale.rb b/lib/localization/locale.rb
new file mode 100644
index 0000000..fcfbeff
--- /dev/null
+++ b/lib/localization/locale.rb
@@ -0,0 +1,10 @@
+module Localization
+  module Locale
+    DEFAULT = :en
+    AVAILABLE = %i[ en ja ].freeze
+
+    def self.available?(locale)
+      AVAILABLE.map(&:to_s).include?(locale.to_s)
+    end
+  end
+end
diff --git a/lib/localization/mailer.rb b/lib/localization/mailer.rb
new file mode 100644
index 0000000..6be0a03
--- /dev/null
+++ b/lib/localization/mailer.rb
@@ -0,0 +1,51 @@
+module Localization
+  module Mailer
+    def mail(...)
+      locale = recipient_locale
+
+      I18n.with_locale(locale) do
+        message = super
+        localize_mail(message) if locale.to_s == "ja"
+        message
+      end
+    end
+
+    private
+      def mailer_subject(key, **options)
+        I18n.t(key, **options, locale: recipient_locale)
+      end
+
+      def recipient_locale
+        locale = recipient_locales.compact.find { |candidate| Localization::Locale.available?(candidate) }
+        locale ? locale.to_sym : I18n.default_locale
+      end
+
+      def recipient_locales
+        [
+          @identity&.locale,
+          @user&.locale,
+          @import&.identity&.locale,
+          @magic_link&.identity&.locale,
+          @bundle&.user&.locale,
+          @export&.user&.locale,
+          @cancellation&.initiated_by&.locale,
+          Current.identity&.locale,
+          Current.user&.locale
+        ]
+      end
+
+      def localize_mail(message)
+        message.subject = Localization::Translator.plain(message.subject)
+
+        if message.html_part
+          message.html_part.body = Localization::Translator.html(message.html_part.body.decoded)
+        end
+
+        if message.text_part
+          message.text_part.body = Localization::Translator.plain(message.text_part.body.decoded)
+        elsif !message.html_part
+          message.body = Localization::Translator.html(message.body.decoded)
+        end
+      end
+  end
+end
diff --git a/lib/localization/translator.rb b/lib/localization/translator.rb
new file mode 100644
index 0000000..92ff0c6
--- /dev/null
+++ b/lib/localization/translator.rb
@@ -0,0 +1,59 @@
+module Localization
+  class Translator
+    class << self
+      def plain(text)
+        return text.to_s unless translate?
+        return text.to_s if text.blank?
+
+        translate(text.to_s)
+      end
+
+      def html(html)
+        return html.to_s unless translate?
+        return html.to_s if html.blank?
+
+        html.to_s.split(%r{(<(?:script|style)\b[^>]*>.*?</(?:script|style)>)}mi).map do |segment|
+          if segment.match?(%r{\A<(?:script|style)\b}i)
+            segment
+          else
+            translate(segment)
+          end
+        end.join
+      end
+
+      private
+        def translate(text)
+          Localization::Dictionary.translations.reduce(text.to_s) do |result, (english, japanese)|
+            replace(result, english, japanese)
+          end
+        end
+
+        def replace(text, english, japanese)
+          variants_for(english).reduce(text) do |string, variant|
+            string.gsub(pattern_for(variant), japanese)
+          end
+        end
+
+        def pattern_for(english)
+          boundary = english.match?(/\A[\p{Alnum}]/) && english.match?(/[\p{Alnum}]\z/)
+          source = Regexp.escape(english)
+          source = "(?<![[:alnum:]])#{source}(?![[:alnum:]])" if boundary
+          Regexp.new(source)
+        end
+
+        def variants_for(english)
+          variants = [ english ]
+          variants << english.gsub("'", "&#39;")
+          variants << english.gsub("'", "\u2019")
+          variants << english.gsub("\u2019", "'")
+          variants << english.gsub("&", "&amp;")
+          variants << english.gsub("\"", "&quot;")
+          variants.uniq
+        end
+
+        def translate?
+          I18n.locale.to_sym == :ja
+        end
+    end
+  end
+end
