diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..75781dd
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,100 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :remember_requested_locale
+    around_action :with_locale
+    after_action :localize_response
+
+    etag { I18n.locale }
+    helper_method :current_locale
+  end
+
+  class_methods do
+    def localized_locales
+      I18n.available_locales
+    end
+  end
+
+  private
+    def remember_requested_locale
+      if locale_allowed?(params[:locale])
+        session[:locale] = params[:locale].to_s
+        @requested_locale = params[:locale].to_s
+      end
+    end
+
+    def with_locale
+      locale = resolved_locale
+
+      I18n.with_locale(locale) do
+        yield
+        persist_locale(locale)
+      end
+    end
+
+    def resolved_locale
+      @requested_locale.presence ||
+        session_locale.presence ||
+        current_user_locale.presence ||
+        I18n.default_locale
+    end
+
+    def current_user_locale
+      [ Current.identity&.locale, Current.user&.locale ].find { |locale| locale_allowed?(locale) }
+    end
+
+    def session_locale
+      locale = session[:locale]
+      locale.to_s if locale_allowed?(locale)
+    end
+
+    def persist_locale(locale)
+      return unless remembered_locale?(locale)
+
+      if Current.identity && Current.identity.locale != locale
+        Current.identity.update_column(:locale, locale)
+      end
+
+      if Current.user && Current.user.locale != locale
+        Current.user.update_column(:locale, locale)
+      end
+    end
+
+    def remembered_locale?(locale)
+      locale_allowed?(params[:locale]) || locale.to_s == session[:locale].to_s
+    end
+
+    def locale_allowed?(locale)
+      locale.present? && I18n.available_locales.map(&:to_s).include?(locale.to_s)
+    end
+
+    def current_locale
+      I18n.locale
+    end
+
+    def selected_locale
+      locale = @requested_locale.presence || session_locale.presence
+      locale.to_sym if locale_allowed?(locale)
+    end
+
+    def apply_selected_locale(identity)
+      if identity && selected_locale
+        selected = selected_locale.to_s
+        identity.update_column(:locale, selected) if identity.locale != selected
+      end
+    end
+
+    def localize_response
+      return unless I18n.locale.to_s == "ja"
+      return unless response.body.is_a?(String)
+      return if response.body.blank?
+
+      response.set_header("Content-Language", "ja")
+
+      case response.media_type
+      when "text/html", "text/vnd.turbo-stream.html"
+        response.body = Localization::Translator.html(response.body)
+      end
+    end
+end
