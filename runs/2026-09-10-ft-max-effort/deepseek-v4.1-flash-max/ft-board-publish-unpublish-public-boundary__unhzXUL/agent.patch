new file mode 100644
index 0000000..55f104e
--- /dev/null
+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,16 @@
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+  layout "public"
+
+  private
+    def set_publication
+      value = params[:key].presence || params[:board_key]
+      raise ActiveRecord::RecordNotFound if value.blank?
+
+      scope = Board::Publication.where(account: Current.account)
+      @publication = scope.find_by(key: value) || scope.find_by(token: value) || scope.find_by(public_key: value)
+      raise ActiveRecord::RecordNotFound unless @publication
+
+      @board = @publication.board
+    end
+end
