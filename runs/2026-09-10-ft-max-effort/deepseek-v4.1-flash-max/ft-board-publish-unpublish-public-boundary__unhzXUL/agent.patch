+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@publication), class: "btn" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<div id="<%= dom_id(@card, :card_container) %>">
+  <article class="card card--public card-perma" id="<%= dom_id(@card) %>">
+  <header class="card__header">
+    <h2 class="card__title"><%= @card.title %></h2>
+    <div class="card__id"><span>Card number</span> <%= @card.number %></div>
+  </header>
+
+  <div class="card__meta">
+    <span class="card__meta-text card__meta-text--board"><%= @board.name %></span>
+    <% if @card.column %>
+      <span class="card__meta-text card__meta-text--column"><%= link_to @card.column.name, public_board_column_path(@publication, @card.column) %></span>
+    <% end %>
+    <span class="card__meta-text card__meta-text--author"><%= @card.creator.familiar_name %></span>
+    <% if @card.tags.any? %>
+      <span class="card__meta-text card__meta-text--tags card__tags"><%= @card.tags.map(&:title).join(", ") %></span>
+    <% end %>
+    <% if @card.assignees.any? %>
+      <span class="card__meta-text card__meta-text--assignees">
+        Assigned to <%= @card.assignees.map(&:familiar_name).to_sentence %>
+      </span>
+    <% end %>
+  </div>
+
+  <% if @card.image.attached? %>
+    <div class="card__image">
+      <%= image_tag @card.image %>
+    </div>
+  <% end %>
+
+  <% if @card.description.present? %>
+    <div class="card__description card__content lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <section class="card__steps">
+      <h3>Steps</h3>
+      <ol class="steps">
+        <% @card.steps.each do |step| %>
+          <li class="step" id="<%= dom_id(step) %>"><%= step.content %></li>
+        <% end %>
+      </ol>
+    </section>
+  <% end %>
+
+  <% if @comments.any? %>
+    <section class="card__comments messages">
+      <h3>Comments</h3>
+      <ul>
+        <% @comments.each do |comment| %>
+          <li class="comment" id="<%= dom_id(comment) %>">
+            <div class="comment__author"><%= comment.creator.familiar_name %></div>
+            <div class="comment__body lexxy-content"><%= comment.body %></div>
+          </li>
+        <% end %>
+      </ul>
+    </section>
+  <% end %>
+</article>
+</div>
