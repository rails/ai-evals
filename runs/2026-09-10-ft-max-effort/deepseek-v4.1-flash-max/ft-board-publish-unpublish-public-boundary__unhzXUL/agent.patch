@@ -0,0 +1,32 @@
+<div id="publication" class="margin-block-end">
+  <h2 class="divider txt-large">Public board</h2>
+
+  <% if board.published? %>
+    <% public_url = public_board_url(board.publication) %>
+
+    <p class="margin-none-block-start">
+      Anyone with the secret link below can view this board and its published cards.
+    </p>
+
+    <div class="flex align-center gap-half margin-block-half">
+      <input type="text" id="public_url" name="public_url" class="input flex-item-grow" value="<%= public_url %>" readonly>
+
+      <%= tag.button class: "btn", data: {
+            controller: "copy-to-clipboard", action: "copy-to-clipboard#copy",
+            copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: public_url } do %>
+        <%= icon_tag "copy-paste" %>
+        <span>Copy link</span>
+      <% end %>
+
+      <%= link_to "Open", public_board_path(board.publication), class: "btn", target: "_blank", rel: "noopener noreferrer" %>
+    </div>
+
+    <%= button_to "Unpublish board", board_publication_path(board), method: :delete, class: "btn btn--negative" %>
+  <% else %>
+    <p class="margin-none-block-start">
+      Publish this board to share a read-only link with anyone, without requiring a Fizzy account.
+    </p>
+
+    <%= button_to "Publish board", board_publication_path(board), class: "btn btn--positive" %>
+  <% end %>
+</div>
