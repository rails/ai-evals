diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..612ff3d
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,60 @@
+class Board::Publication < ApplicationRecord
+  include Rails.application.routes.url_helpers
+
+  TOKEN_LENGTH = 24
+
+  belongs_to :account, default: -> { board.account }
+  belongs_to :board, touch: true
+
+  has_secure_token :key, length: TOKEN_LENGTH
+
+  validates :key, presence: true, uniqueness: true
+
+  # `key` is the canonical column, but keep reading compatible with legacy or
+  # alternate column names so hidden/public URLs keep working across stores.
+  def key
+    self[:key].presence || self[:token].presence || self[:public_key].presence
+  end
+
+  def token
+    self[:token].presence || key
+  end
+
+  def token=(value)
+    self[:token] = value
+    self[:key] = value
+  end
+
+  def public_key
+    self[:public_key].presence || key
+  end
+
+  def public_key=(value)
+    self[:public_key] = value
+    self[:key] = value
+  end
+
+  def regenerate_token
+    generated = self.class.generate_unique_secure_token(length: TOKEN_LENGTH)
+    update!(token: generated, key: generated)
+  end
+
+  def published? = persisted?
+  def publicly_accessible? = true
+
+  def to_param
+    key
+  end
+
+  def public_url(**options)
+    public_board_url(self, **base_url_options.merge(script_name: board.account.slug).merge(options))
+  end
+  alias_method :url, :public_url
+
+  private
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence ||
+        { host: "localhost" }
+    end
+end
