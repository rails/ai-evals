+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<section class="board board--public">
+  <p class="board__public-notice txt-subtle">Public board — anyone with the link can view it.</p>
+  <div class="card-columns hide-scrollbar">
+    <div class="card-columns__left">
+      <div class="cards cards--maybe" id="maybe">
+        <header class="cards__header">
+          <h2 class="cards__title">Maybe?</h2>
+        </header>
+        <ul class="cards__list">
+          <% @board.cards.awaiting_triage.latest.each do |card| %>
+            <li><%= render "public/card", card: card %></li>
+          <% end %>
+        </ul>
+      </div>
+    </div>
+
+    <div class="card-columns__middle">
+      <% @columns.each do |column| %>
+        <div class="cards cards--doing" id="<%= dom_id(column) %>">
+          <header class="cards__header">
+            <h2 class="cards__title">
+              <%= link_to column.name, public_board_column_path(@publication, column) %>
+            </h2>
+          </header>
+          <ul class="cards__list">
+            <% column.cards.active.latest.each do |card| %>
+              <li><%= render "public/card", card: card %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+    </div>
+
+    <div class="card-columns__right">
+      <div class="cards cards--closed" id="closed-cards">
+        <header class="cards__header">
+          <h2 class="cards__title">Done</h2>
+        </header>
+        <ul class="cards__list">
+          <% @board.cards.published.closed.latest.each do |card| %>
+            <li><%= render "public/card", card: card %></li>
+          <% end %>
+        </ul>
+      </div>
+
+      <div class="cards cards--on-deck" id="not-now">
+        <header class="cards__header">
+          <h2 class="cards__title">Not Now</h2>
+        </header>
+        <ul class="cards__list">
+          <% @board.cards.postponed.latest.each do |card| %>
+            <li><%= render "public/card", card: card %></li>
+          <% end %>
+        </ul>
+      </div>
+    </div>
+  </div>
+</section>
