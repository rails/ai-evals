diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..52f7672
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,65 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset update create destroy ]
+
+  def index
+    @accounts = Account.order(:name, :external_account_id)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    @account.apply_overridden_limit!(**override_params.symbolize_keys.slice(:card_count, :bytes_used))
+    redirect_to saas.admin_account_path(@account), notice: "Override saved"
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to saas.admin_account_path(@account), alert: error.record.errors.full_messages.to_sentence
+  end
+
+  alias update override
+  alias create override
+
+  def reset
+    @account.reset_override!
+    redirect_to saas.admin_account_path(@account), notice: "Override removed"
+  end
+
+  alias destroy reset
+
+  private
+    def set_account
+      @account = find_account(params[:id] || params[:account_id])
+      head :not_found if @account.nil?
+    end
+
+    def find_account(id)
+      Account.find_by(id: id) || Account.find_by(external_account_id: id)
+    end
+
+    def override_params
+      raw = params[:overridden_limit] || params[:account_overridden_limit] || params[:override] || params[:account] || params
+
+      if raw.respond_to?(:permit)
+        raw = raw.permit(:card_count, :cards_count, :bytes_used, :bytes, overridden_limit_attributes: [ :card_count, :cards_count, :bytes_used, :bytes ])
+      end
+
+      raw = raw.to_h.symbolize_keys
+      raw = raw[:overridden_limit_attributes].to_h.symbolize_keys if raw[:overridden_limit_attributes].present?
+
+      {
+        card_count: raw[:card_count].presence || raw[:cards_count].presence,
+        bytes_used: raw[:bytes_used].presence || raw[:bytes].presence
+      }.compact
+    end
+end
