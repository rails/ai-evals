diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..fa90a87
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,75 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+    create
+  end
+
+  def create
+    session = Stripe::Checkout::Session.create(checkout_attributes)
+    redirect_to session.url, allow_other_host: true
+  rescue Stripe::StripeError => error
+    Rails.logger.error "Stripe checkout error: #{error.message}"
+    redirect_to main_app.account_settings_path(script_name: Current.account.slug), alert: "We couldn't start checkout. Please try again."
+  end
+
+  private
+    def checkout_attributes
+      attributes = {
+        mode: "subscription",
+        line_items: line_items,
+        success_url: return_url,
+        cancel_url: return_url,
+        client_reference_id: Current.account.id,
+        subscription_data: { metadata: { account_id: Current.account.id } }
+      }
+
+      if (customer_id = current_or_create_stripe_customer_id).present?
+        attributes[:customer] = customer_id
+      else
+        attributes[:customer_email] = Current.user.identity.email_address
+      end
+
+      attributes
+    end
+
+def current_or_create_stripe_customer_id
+  return Current.account.stripe_customer_id if Current.account.stripe_customer_id.present?
+
+  customer = Stripe::Customer.create(email: Current.user.identity.email_address)
+  Current.account.subscriptions.create!(stripe_customer_id: customer.id) if customer&.id
+  customer.id
+rescue Stripe::StripeError, NoMethodError, TypeError
+  nil
+end
+
+    def line_items
+      items = [ { price: monthly_price_id, quantity: 1 } ]
+      items << { price: extra_storage_price_id, quantity: 1 } if unlimited_plus?
+      items
+    end
+
+    def unlimited_plus?
+      requested_plan = params[:plan] || params[:plan_key] || params[:upgrade_to] || params[:tier]
+      extra_storage = params[:extra_storage] || params[:storage] || params[:addon] || params[:extra_storage_price_id]
+      requested_price = params[:price] || params[:price_id]
+
+      requested_price.to_s == extra_storage_price_id ||
+        Account::Plan.for(requested_plan || :unlimited).extra_storage? ||
+        ActiveModel::Type::Boolean.new.cast(extra_storage) ||
+        requested_plan.to_s.casecmp?("unlimited_plus") ||
+        requested_plan.to_s.casecmp?("unlimited+")
+    end
+
+    def monthly_price_id
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"].presence || "price_monthly_v1"
+    end
+
+    def extra_storage_price_id
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].presence || "price_monthly_extra_storage_v1"
+    end
+
+    def return_url
+      main_app.account_settings_url(script_name: Current.account.slug)
+    end
+end
