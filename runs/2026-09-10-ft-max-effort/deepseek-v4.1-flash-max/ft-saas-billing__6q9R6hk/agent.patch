+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+    create
+  end
+
+  def create
+    customer_id = Current.account.stripe_customer_id
+
+    if customer_id.blank?
+      redirect_to main_app.account_settings_path(script_name: Current.account.slug), alert: "Subscribe to a plan before managing billing." and return
