+# Value object describing the plans hosted Fizzy can sell. Instances are
+# strings so they read naturally in views ("Free", "Unlimited", ...) while
+# still carrying the limits and pricing the rest of the app needs.
+class Account::Plan < String
+  FREE_KEY = "free"
+  UNLIMITED_KEY = "unlimited"
+  UNLIMITED_PLUS_KEY = "unlimited_plus"
+
+  FREE_CARDS_LIMIT = 1_000
+  FREE_STORAGE_LIMIT = 1.gigabyte
+  UNLIMITED_STORAGE_LIMIT = 5.gigabytes
+  UNLIMITED_PLUS_STORAGE_LIMIT = 500.gigabytes
+
+  FREE_PRICE_IN_CENTS = 0
+  UNLIMITED_PRICE_IN_CENTS = 2_000
+  UNLIMITED_PLUS_PRICE_IN_CENTS = 2_500
+
+  CARDS_LIMIT_WARNING_THRESHOLD = 100
+  CARD_LIMIT_WARNING_THRESHOLD = CARDS_LIMIT_WARNING_THRESHOLD
+  WARNING_THRESHOLD = CARDS_LIMIT_WARNING_THRESHOLD
+  FREE_CARD_LIMIT = FREE_CARDS_LIMIT
+
+  KEY_ALIASES = {
+    "free" => FREE_KEY,
+    "freev1" => FREE_KEY,
+    "free_v1" => FREE_KEY,
+    "free subscription" => FREE_KEY,
+    "free_v1 subscription" => FREE_KEY,
+    "unlimited" => UNLIMITED_KEY,
+    "unlimitedv1" => UNLIMITED_KEY,
+    "unlimited_v1" => UNLIMITED_KEY,
+    "unlimited v1" => UNLIMITED_KEY,
+    "monthly" => UNLIMITED_KEY,
+    "monthlyv1" => UNLIMITED_KEY,
+    "monthly_v1" => UNLIMITED_KEY,
+    "monthly v1" => UNLIMITED_KEY,
+    "unlimited subscription" => UNLIMITED_KEY,
+    "unlimited_plus" => UNLIMITED_PLUS_KEY,
+    "unlimitedplus" => UNLIMITED_PLUS_KEY,
+    "unlimited+" => UNLIMITED_PLUS_KEY,
+    "unlimited_plusv1" => UNLIMITED_PLUS_KEY,
+    "unlimitedplusv1" => UNLIMITED_PLUS_KEY,
+    "unlimited_plus_v1" => UNLIMITED_PLUS_KEY,
+    "unlimited plus" => UNLIMITED_PLUS_KEY,
+    "extra_storage" => UNLIMITED_PLUS_KEY,
+    "extra storage" => UNLIMITED_PLUS_KEY,
+    "extra_storage_v1" => UNLIMITED_PLUS_KEY,
+    "monthlyextrastoragev1" => UNLIMITED_PLUS_KEY,
+    "extrastoragev1" => UNLIMITED_PLUS_KEY,
+    "monthly_extra_storage_v1" => UNLIMITED_PLUS_KEY,
+    "monthly extra storage v1" => UNLIMITED_PLUS_KEY,
+    "unlimited_plus subscription" => UNLIMITED_PLUS_KEY
+  }.freeze
+
+  ATTRIBUTES = {
+    FREE_KEY => {
+      name: "Free",
+      proper_name: "Free Subscription",
+      cards_limit: FREE_CARDS_LIMIT,
+      storage_limit: FREE_STORAGE_LIMIT,
+      price_in_cents: FREE_PRICE_IN_CENTS,
+      frequency: "none"
+    },
+    UNLIMITED_KEY => {
+      name: "Unlimited",
+      proper_name: "Unlimited Subscription",
+      cards_limit: nil,
+      storage_limit: UNLIMITED_STORAGE_LIMIT,
+      price_in_cents: UNLIMITED_PRICE_IN_CENTS,
+      frequency: "monthly"
+    },
+    UNLIMITED_PLUS_KEY => {
+      name: "Unlimited+",
+      proper_name: "Unlimited+ Subscription",
+      cards_limit: nil,
+      storage_limit: UNLIMITED_PLUS_STORAGE_LIMIT,
+      price_in_cents: UNLIMITED_PLUS_PRICE_IN_CENTS,
+      frequency: "monthly"
+    }
+  }.freeze
+
+# A plan key tied to the raw value stored on a subscription. String
+# comparisons use the raw key (so account.plan reads like "FreeV1"),
+# while +to_s+/+name+ return the customer-facing name ("Free").
+class Key < String
+  attr_reader :plan
+
+  def initialize(plan, raw_key)
+    @plan = plan
+    super(raw_key.to_s)
+    freeze
+  end
+
+  def key
+    plan.key
+  end
+
+  def name
+    plan.name
+  end
+
+  alias plan_name name
+  alias display_name name
+
+  def proper_name
+    plan.proper_name
+  end
+
+  def cards_limit
+    plan.cards_limit
+  end
+
+  alias card_limit cards_limit
+  alias max_cards cards_limit
+
+  def unlimited_cards?
+    plan.unlimited_cards?
+  end
+
+  def storage_limit
+    plan.storage_limit
+  end
+
+  def price_in_cents
+    plan.price_in_cents
+  end
+
+  def price
+    plan.price
+  end
+
+  def free?
+    plan.free?
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def extra_storage?
+    plan.extra_storage?
+  end
+
+  def monthly?
+    plan.monthly?
+  end
+
+  def to_sym
+    plan.to_sym
+  end
+
+  def to_s
+    plan.name
+  end
+
+  def ==(other)
+    return true if super
+
+    other.is_a?(Account::Plan::Key) ? plan.key == other.plan.key : plan == other
+  end
+  alias eql? ==
+
+  def hash
+    plan.key.hash
+  end
+end
+
+  attr_reader :key
+
+  def initialize(key = :free)
+    @key = self.class.normalize(key)
+    super(ATTRIBUTES.fetch(@key)[:name])
+    freeze
+  end
+
+  def key_for(raw_key)
+    Key.new(self, raw_key)
+  end
+
+  def attributes
+    ATTRIBUTES.fetch(key)
+  end
+
+  def to_h
+    attributes.dup
+  end
+
+  def to_sym
+    key.to_sym
+  end
+
+  def ==(other)
+    return true if super
+    return key == other.plan.key if other.is_a?(Account::Plan::Key)
+    return key == other.key if other.is_a?(Account::Plan)
+
+    false
+  end
+
+  def plan_key
+    key
+  end
+
+  def code
+    key
+  end
+
+  def slug
+    key
+  end
+
+  def name
+    ATTRIBUTES.fetch(key)[:name]
+  end
+
+  alias title name
+  alias display_name name
+
+  def proper_name
+    ATTRIBUTES.fetch(key)[:proper_name]
+  end
+
+  def cards_limit
+    ATTRIBUTES.fetch(key)[:cards_limit]
+  end
+
+  alias card_limit cards_limit
+  alias max_cards cards_limit
+  alias included_cards cards_limit
+
+  def unlimited_cards?
+    cards_limit.nil?
+  end
+
+  def storage_limit
+    ATTRIBUTES.fetch(key)[:storage_limit]
+  end
+
+  alias storage_limit_in_bytes storage_limit
+  alias storage_in_bytes storage_limit
+
+  def gigabytes
+    storage_limit / 1.gigabyte
+  end
+
+  def price_in_cents
+    ATTRIBUTES.fetch(key)[:price_in_cents]
+  end
+
+  alias monthly_price_in_cents price_in_cents
+  alias price_cents price_in_cents
+
+  def price
+    price_in_cents / 100.0
+  end
+
+  alias monthly_price price
+
+  def frequency
+    ATTRIBUTES.fetch(key)[:frequency]
+  end
+
+  def free?
+    key == FREE_KEY
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited?
+    unlimited_cards?
+  end
+
+  def extra_storage?
+    key == UNLIMITED_PLUS_KEY
+  end
+
+  def monthly?
+    frequency == "monthly"
+  end
+
+  class << self
+def normalize(key)
+  normalized = key.to_s.strip.downcase
+  compact = normalized.gsub(/[^a-z0-9+]/, "")
+  aliased = KEY_ALIASES[normalized] || KEY_ALIASES[compact]
+  return aliased if aliased.present?
+  return UNLIMITED_PLUS_KEY if compact.include?("extrastorage") || compact.include?("unlimitedplus") || compact.include?("unlimited+") || compact.end_with?("plus")
+  return UNLIMITED_KEY if compact.include?("unlimited") || compact.include?("monthly")
+  return FREE_KEY if compact.include?("free")
+
+  ATTRIBUTES.key?(normalized.tr("-", "_")) ? normalized.tr("-", "_") : FREE_KEY
+end
+    alias lookup normalize
+
+    def for(key)
+      case key
+      when Account::Plan then key
+      else PLANS.fetch(normalize(key))
+      end
+    end
+
+    def from(key)
+      self.for(key)
+    end
+
+    alias [] for
+    alias fetch for
+
+def known?(key)
+  normalized = key.to_s.strip.downcase
+  compact = normalized.gsub(/[^a-z0-9+]/, "")
+  return true if KEY_ALIASES.key?(normalized) || KEY_ALIASES.key?(compact)
+  return true if ATTRIBUTES.key?(normalized.tr("-", "_"))
+  return true if compact.include?("extrastorage") || compact.include?("unlimitedplus") || compact.include?("unlimited+") || compact.end_with?("plus")
+  return true if compact.include?("unlimited") || compact.include?("monthly")
+  return true if compact.include?("free")
+
+  false
+end
+alias key? known?
+alias include? known?
+    alias find for
+
+    def free
+      FREE
+    end
+
+    def unlimited
+      UNLIMITED
+    end
+
+    def unlimited_plus
+      UNLIMITED_PLUS
+    end
+
+    alias default free
+    alias free_plan free
+    alias unlimited_plan unlimited
+    alias unlimited_plus_plan unlimited_plus
+
+    def codes
+      ATTRIBUTES.keys
+    end
+
+    def keys
+      codes
+    end
+
+    def all
+      PLANS.values.uniq
+    end
+
+    def paid
+      all.reject(&:free?)
+    end
+
+    def monthly_price_id
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"].presence
+    end
+
+    def extra_storage_price_id
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].presence
+    end
+
+    def for_price_id(price_id)
+      return UNLIMITED_PLUS if extra_storage_price_id.present? && price_id.to_s == extra_storage_price_id
+      return UNLIMITED if monthly_price_id.present? && price_id.to_s == monthly_price_id
+
+      nil
+    end
+
+    def paid_plans
+      paid
+    end
+  end
+  FREE = new(:free)
+  UNLIMITED = new(:unlimited)
+  UNLIMITED_PLUS = new(:unlimited_plus)
+
+PLANS = {
+  FREE_KEY => FREE,
+  UNLIMITED_KEY => UNLIMITED,
+  UNLIMITED_PLUS_KEY => UNLIMITED_PLUS
+}.freeze
+
+  Free = FREE
+  Unlimited = UNLIMITED
+  UnlimitedPlus = UNLIMITED_PLUS
+  MONTHLY_V1 = UNLIMITED
+  MONTHLY_EXTRA_STORAGE_V1 = UNLIMITED_PLUS
+  FREE_PLAN = FREE
+  UNLIMITED_PLAN = UNLIMITED
+  UNLIMITED_PLUS_PLAN = UNLIMITED_PLUS
+end
