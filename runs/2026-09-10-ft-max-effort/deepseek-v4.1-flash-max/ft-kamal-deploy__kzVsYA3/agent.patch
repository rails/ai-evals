--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,28 @@
+# Secrets for deploying Fizzy with Kamal.
+#
+# Kamal reads this file on every command, so keep it safe to commit: never put
+# raw credentials in it. Reference values from your environment, a password
+# manager, or a local file that is not checked in.
+#
+# All variables needed by config/deploy.yml are listed below. Export them in
+# your shell before running `bin/kamal setup`, e.g.:
+#
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#   export SMTP_PASSWORD=...
+#
+# Or replace `$SECRET_KEY_BASE` with a command that fetches the value, e.g.:
+#
+#   SECRET_KEY_BASE=$(op read "op://Private/Fizzy/secret_key_base")
+
+# A stable key used to sign cookies and sessions. Generate it once with
+# `bin/rails secret` and keep the same value across deploys.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for the SMTP server configured in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional: keys for browser push notifications. Generate a pair once with:
+#
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{key.private_key}"; puts "VAPID_PUBLIC_KEY=#{key.public_key}"'
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
