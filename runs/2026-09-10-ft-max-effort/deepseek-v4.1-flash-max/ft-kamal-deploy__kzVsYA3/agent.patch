diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..f90091e
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,93 @@
+# One-box deployment for Fizzy.
+#
+# This deploys the app to a single Linux server running Docker. The web server
+# and the Solid Queue background workers run in the same container, the SQLite
+# databases and Active Storage files live on a persistent Docker volume, and
+# Kamal's proxy terminates SSL with a Let's Encrypt certificate.
+#
+# Before running `bin/kamal setup`:
+#
+#   1. Point `servers.web` at your server.
+#   2. Set `proxy.host` and `APP_HOST` to the hostname Fizzy will be served from.
+#   3. Fill in the MAILER_* and SMTP_* values for the mail server that sends
+#      Fizzy's sign-in emails.
+#   4. Provide the secrets referenced under `env.secret` (see `.kamal/secrets`
+#      and docs/deployment.md).
+#
+# Then run:
+#
+#   bin/kamal setup
+#
+# Fizzy will be available at https://<proxy.host>. Future deploys are just
+# `bin/kamal deploy`; the storage volume is retained between deploys.
+
+service: fizzy
+
+# The app image is built locally and pushed to a Docker registry that runs on
+# your machine, then served to the server over an SSH tunnel. This means no
+# external registry account or image name is required.
+image: fizzy
+
+registry:
+  server: localhost:5555
+
+servers:
+  web:
+    - 192.168.0.1 # <- replace with the server's IP address or hostname
+
+# Let Kamal's proxy obtain and renew TLS certificates for this hostname.
+proxy:
+  ssl: true
+  host: fizzy.example.com # <- replace with your hostname
+
+# Build the image for the architecture of your server. Use arm64 for ARM
+# servers.
+builder:
+  arch: amd64
+
+env:
+  clear:
+    # Public hostname used for links in emails and other absolute URLs.
+    APP_HOST: fizzy.example.com # <- same value as proxy.host above
+
+    # Outbound email. Point these at the SMTP server you want Fizzy to use.
+    MAILER_FROM_ADDRESS: "Fizzy <support@fizzy.example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+
+    # Fizzy runs on SQLite in OSS mode; all databases live in the storage volume.
+    DATABASE_ADAPTER: sqlite
+
+    # Run Solid Queue inside the Puma web process so background jobs run on the
+    # box without a separate job container. This is what makes the single-box
+    # setup work.
+    SOLID_QUEUE_IN_PUMA: true
+
+  secret:
+    # Generate a stable value with `bin/rails secret` and pass it via
+    # SECRET_KEY_BASE in your environment or in `.kamal/secrets`.
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Optional: browser push notifications. Generate a VAPID key pair with
+    # `bin/rails runner 'key = WebPush.generate_key; puts key.private_key; puts key.public_key'`.
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+
+# SQLite databases (production*.sqlite3) and uploaded files live under
+# /rails/storage. The named volume persists across container replacements, so
+# data survives the next deploy.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Bridge fingerprinted assets between the old and new container during deploy.
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
