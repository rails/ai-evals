+    starttls_disabled = %w[ SMTP_ENABLE_STARTTLS_AUTO SMTP_ENABLE_STARTTLS SMTP_STARTTLS ].any? do |key|
+      ENV[key] == "false"
+    end
+    smtp_settings = {
+      address: ENV["SMTP_ADDRESS"].presence ||
+        ENV["SMTP_HOST"].presence ||
+        ENV["SMTP_SERVER"].presence ||
