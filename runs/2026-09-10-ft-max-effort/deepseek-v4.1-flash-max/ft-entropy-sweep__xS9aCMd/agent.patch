+require "active_job/continuable"
+
+class Card::AutoPostponeDueJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform
+    step :postpone do |step|
+      Card.auto_postpone_all_due
+      step.checkpoint!
+    end
+  end
+end
