diff --git a/app/views/cards/columns/update.turbo_stream.erb b/app/views/cards/columns/update.turbo_stream.erb
new file mode 100644
index 0000000..3c99aa2
--- /dev/null
+++ b/app/views/cards/columns/update.turbo_stream.erb
@@ -0,0 +1,22 @@
+<% if @target_column %>
+  <%= turbo_stream.replace dom_id(@target_column), partial: "boards/show/column", method: :morph, locals: { column: @target_column } %>
+<% elsif @destination == "maybe" %>
+  <%= turbo_stream.replace "maybe", partial: "boards/show/stream", method: :morph, locals: { board: @board, page: @page } %>
+<% elsif @destination == "not_now" %>
+  <%= turbo_stream.replace "not-now", partial: "boards/show/not_now", method: :morph, locals: { board: @board } %>
+<% elsif @destination == "closed" %>
+  <%= turbo_stream.replace "closed-cards", partial: "boards/show/closed", method: :morph, locals: { board: @board } %>
+<% end %>
+
+<% if @was_closed %>
+  <%= turbo_stream.replace "closed-cards", partial: "boards/show/closed", method: :morph, locals: { board: @board } %>
+<% elsif @was_postponed %>
+  <%= turbo_stream.replace "not-now", partial: "boards/show/not_now", method: :morph, locals: { board: @board } %>
+<% elsif @was_in_stream %>
+  <%= turbo_stream.replace "maybe", partial: "boards/show/stream", method: :morph, locals: { board: @board, page: @page } %>
+<% elsif @source_column %>
+  <%= turbo_stream.replace dom_id(@source_column), partial: "boards/show/column", method: :morph, locals: { column: @source_column } %>
+<% end %>
+
+<% container_partial = @card.drafted? ? "cards/drafts/container" : "cards/container" %>
+<%= turbo_stream.replace [ @card, :card_container ], partial: container_partial, method: :morph, locals: { card: @card.reload } %>
