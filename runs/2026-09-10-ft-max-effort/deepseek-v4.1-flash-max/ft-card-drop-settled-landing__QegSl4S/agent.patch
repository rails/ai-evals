diff --git a/app/controllers/cards/columns_controller.rb b/app/controllers/cards/columns_controller.rb
index 54a69f0..1806f61 100644
--- a/app/controllers/cards/columns_controller.rb
+++ b/app/controllers/cards/columns_controller.rb
@@ -1,8 +1,64 @@
 class Cards::ColumnsController < ApplicationController
+  include CardScoped
+
   def edit
-    @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
     @columns = @card.board.columns.sorted
 
     fresh_when etag: [ @card, @columns ]
   end
+
+  def update
+    capture_source
+    move_card_to_destination
+
+    respond_to do |format|
+      format.turbo_stream do
+        set_page_for_stream_refresh
+        render
+      end
+
+      format.json { head :no_content }
+      format.html { redirect_to @card }
+    end
+  end
+
+  private
+    def capture_source
+      @was_closed = @card.closed?
+      @was_postponed = @card.postponed?
+      @was_in_stream = @card.awaiting_triage?
+      @source_column = @card.column unless @was_closed || @was_postponed || @was_in_stream
+    end
+
+    def move_card_to_destination
+      case destination
+      when "maybe", "stream", "triage"
+        @destination = "maybe"
+        @card.send_back_to_triage
+      when "not_now", "not-now", "postponed"
+        @destination = "not_now"
+        @card.postpone
+      when "closed", "done", "closed-cards"
+        @destination = "closed"
+        @card.close
+      else
+        @destination = "column"
+        @target_column = board_column
+        @card.triage_into @target_column
+      end
+    end
+
+    def board_column
+      @card.board.columns.find destination.to_s.delete_prefix("column_")
+    end
+
+    def set_page_for_stream_refresh
+      if @destination == "maybe" || @was_in_stream
+        set_page_and_extract_portion_from @board.cards.awaiting_triage.latest.with_golden_first.preloaded
+      end
+    end
+
+    def destination
+      params[:column_id].presence || params[:destination].presence || params[:status].presence
+    end
 end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..e679b98
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,136 @@
+import { Controller } from "@hotwired/stimulus"
+import { patch } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  connect() {
+    this.draggedCard = null
+    this.hoveredColumn = null
+  }
+
+  dragStart(event) {
+    const card = this.#cardFrom(event)
+    if (!card) return
+
+    this.draggedCard = card
+    card.classList.add(this.draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragOver(event) {
+    const column = this.#columnFrom(event)
+
+    if (!column) {
+      this.#clearHoveredColumn()
+      return
+    }
+
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#setHoveredColumn(column)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFrom(event)
+    if (!column || column !== this.hoveredColumn) return
+    if (event.relatedTarget && column.contains(event.relatedTarget)) return
+
+    this.#clearHoveredColumn()
+  }
+
+  drop(event) {
+    const column = this.#columnFrom(event)
+    const card = this.draggedCard
+
+    if (!column || !card) return
+
+    event.preventDefault()
+
+    if (!column.contains(card)) {
+      this.#moveCard(card, column)
+    }
+
+    this.#reset()
+  }
+
+  dragEnd() {
+    this.#reset()
+  }
+
+  // Private
+
+  #moveCard(card, column) {
+    const list = column.querySelector(".cards__list")
+    if (!list) return
+
+    this.#insertCard(card, list, column)
+    this.#saveCardMove(card, column)
+  }
+
+  #insertCard(card, list, column) {
+    const container = this.#listContents(list)
+    const goldenCards = container.querySelectorAll(".card.golden-effect")
+    const goldenCardsFirst = ![ "not_now", "closed" ].includes(column.dataset.dragAndDropDestination)
+
+    if (goldenCardsFirst && goldenCards.length > 0) {
+      goldenCards[goldenCards.length - 1].after(card)
+    } else {
+      container.prepend(card)
+    }
+  }
+
+  #listContents(list) {
+    return list.querySelector(":scope > .display-contents > turbo-frame") || list
+  }
+
+  #saveCardMove(card, column) {
+    const url = card.dataset.dragAndDropUrl
+    const columnId = column.dataset.dragAndDropDestination
+
+    if (url && columnId) {
+      patch(url, { body: { column_id: columnId }, responseKind: "json" })
+    }
+  }
+
+  #setHoveredColumn(column) {
+    if (column === this.hoveredColumn) return
+
+    this.#clearHoveredColumn()
+    this.hoveredColumn = column
+    column.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHoveredColumn() {
+    this.hoveredColumn?.classList.remove(this.hoverContainerClass)
+    this.hoveredColumn = null
+  }
+
+  #reset() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(this.draggedItemClass)
+      this.draggedCard.removeAttribute("aria-selected")
+      this.draggedCard = null
+    }
+
+    this.#clearHoveredColumn()
+  }
+
+  #cardFrom(event) {
+    const card = event.target.closest(".card")
+    return card && this.element.contains(card) ? card : null
+  }
+
+  #columnFrom(event) {
+    const column = event.target.closest("[data-drag-and-drop-destination]")
+    return column && this.element.contains(column) ? column : null
+  }
+}
