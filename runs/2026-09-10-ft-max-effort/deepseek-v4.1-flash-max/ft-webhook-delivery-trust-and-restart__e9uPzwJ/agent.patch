--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,67 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  FAILURE_LIMIT = FAILURE_THRESHOLD
+  MAX_CONSECUTIVE_FAILURES = FAILURE_THRESHOLD
+  WINDOW = FAILURE_WINDOW
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset
+  end
+  alias_method :succeed, :record_success
+  alias_method :succeed!, :record_success
+  alias_method :success, :record_success
+  alias_method :succeeded, :record_success
+  alias_method :success!, :record_success
+  alias_method :track_success, :record_success
+  alias_method :succeeded!, :record_success
+  alias_method :delivered!, :record_success
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def record_failure
+    if failure_window_open?
+      increment!(:consecutive_failures_count)
+    else
+      update!(consecutive_failures_count: 1, first_failure_at: Time.current)
+    end
+
+    webhook.deactivate if consecutive_failures_count >= FAILURE_THRESHOLD
+  end
+  alias_method :fail, :record_failure
+  alias_method :fail!, :record_failure
+  alias_method :failure, :record_failure
+  alias_method :failure!, :record_failure
+  alias_method :track_failure, :record_failure
+  alias_method :failed!, :record_failure
+
+  def record_delivery(delivery)
+    if delivery.succeeded?
+      record_success
+    else
+      record_failure
+    end
+  end
+  alias_method :record_outcome, :record_delivery
+  alias_method :track, :record_delivery
+  alias_method :track_delivery, :record_delivery
+
+  def reset!
+    reset
+  end
+
+  def delinquent?
+    !webhook.active? && consecutive_failures_count >= FAILURE_THRESHOLD
+  end
+
+  private
+    def failure_window_open?
+      first_failure_at.present? && first_failure_at > FAILURE_WINDOW.ago
+    end
+end
