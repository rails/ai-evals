index 0000000..28cd215
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,30 @@
+module SearchesHelper
+  def highlighted_search_text(text)
+    if text.present?
+      highlight(text.to_s, search_terms)
+    end
+  end
+
+  def matching_search_description(card)
+    description = card.description&.to_plain_text
+
+    if search_text_matches?(description)
+      highlighted_search_text(description)
+    end
+  end
+
+  def matching_search_comments(card)
+    card.comments.select { |comment| search_text_matches?(comment.body&.to_plain_text) }
+  end
+
+  private
+    def search_terms
+      @search_terms ||= @query.to_s.split
+    end
+
+    def search_text_matches?(text)
+      normalized_text = text.to_s.downcase
+
+      search_terms.any? { |term| normalized_text.include?(term.downcase) }
+    end
+end
