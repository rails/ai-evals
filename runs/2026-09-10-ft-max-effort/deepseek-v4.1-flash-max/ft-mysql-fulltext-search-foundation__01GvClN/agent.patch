diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..6a3a836
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,41 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      terms = query.to_s.split
+
+      if terms.any?
+        terms.reduce(all) do |cards, term|
+          cards.where(<<~SQL.squish, pattern: like_pattern(term))
+            cards.title LIKE :pattern ESCAPE '!'
+            OR EXISTS (
+              SELECT 1 FROM action_text_rich_texts AS card_descriptions
+              WHERE card_descriptions.record_type = 'Card'
+                AND card_descriptions.record_id = cards.id
+                AND card_descriptions.name = 'description'
+                AND card_descriptions.body LIKE :pattern ESCAPE '!'
+            )
+            OR EXISTS (
+              SELECT 1 FROM comments
+              INNER JOIN action_text_rich_texts AS comment_bodies
+                ON comment_bodies.record_type = 'Comment'
+                AND comment_bodies.record_id = comments.id
+                AND comment_bodies.name = 'body'
+              WHERE comments.card_id = cards.id
+                AND comment_bodies.body LIKE :pattern ESCAPE '!'
+            )
+          SQL
+        end
+      else
+        all
+      end
+    end
+
+    private
+      def like_pattern(term)
+        escaped = term.gsub(/[!%_]/) { |character| "!#{character}" }
+        "%#{escaped}%"
+      end
+  end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..13225db
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,25 @@
+<li id="<%= dom_id(card) %>" class="search__result search-result">
+  <article class="card search__result-card search-result__card">
+    <header class="card__header">
+      <h3 class="search__result-title card__title">
+        <%= link_to highlighted_search_text(card.title), card_path(card), class: "search__result-link search__result-title-link card__link search-result__title" %>
+      </h3>
+
+      <div class="search__result-board card__board-name">
+        <span class="overflow-ellipsis"><%= card.board.name %></span>
+      </div>
+      <span class="search__result-id card__id">#<%= card.number %></span>
+    </header>
+
+    <% if description = matching_search_description(card) %>
+      <p class="search__result-snippet search__result-description search-result__description"><%= description %></p>
+    <% end %>
+
+    <% matching_search_comments(card).each do |comment| %>
+      <blockquote class="search__result-snippet search__result-comment search-result__comment">
+        <p class="search__result-comment-body"><%= highlighted_search_text(comment.body&.to_plain_text) %></p>
+      </blockquote>
+      <footer class="search__result-comment-author txt-small translucent">— <%= comment.creator.name %></footer>
+    <% end %>
+  </article>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..7cd74eb
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,23 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Search</h1>
+<% end %>
+
+<section id="search" class="panel margin-block-double pad search">
+  <%= form_with url: search_path, method: :get, class: "search__form" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width search__input", autofocus: @query.blank?, autocomplete: "off", autocorrect: "off" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <p class="search__summary txt-small translucent margin-block"><%= pluralize @cards.size, "card" %> found</p>
+
+      <ol id="search_results" class="search__results search-results flex flex-column gap">
+        <%= render partial: "searches/result", collection: @cards, as: :card %>
+      </ol>
+    <% else %>
+      <p class="search__empty center margin-block-double">No cards found for “<%= @query %>”.</p>
+    <% end %>
+  <% end %>
+</section>
