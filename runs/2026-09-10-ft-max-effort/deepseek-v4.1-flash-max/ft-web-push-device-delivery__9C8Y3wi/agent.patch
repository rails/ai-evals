diff --git a/app/models/push/request.rb b/app/models/push/request.rb
new file mode 100644
index 0000000..0e6b189
--- /dev/null
+++ b/app/models/push/request.rb
@@ -0,0 +1,23 @@
+class Push::Request < WebPush::Request
+  def initialize(ip_address: nil, **options)
+    super(**options)
+    @ip_address = ip_address
+  end
+
+  def perform
+    http = Net::HTTP.new(uri.hostname, uri.port, *proxy_options)
+    http.ipaddr = @ip_address if @ip_address
+    http.use_ssl = true
+    http.ssl_timeout = @options[:ssl_timeout] unless @options[:ssl_timeout].nil?
+    http.open_timeout = @options[:open_timeout] unless @options[:open_timeout].nil?
+    http.read_timeout = @options[:read_timeout] unless @options[:read_timeout].nil?
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+
+    response = http.request(request)
+    verify_response(response)
+
+    response
+  end
+end
diff --git a/app/models/push/resolver.rb b/app/models/push/resolver.rb
new file mode 100644
index 0000000..437b0ab
--- /dev/null
+++ b/app/models/push/resolver.rb
@@ -0,0 +1,38 @@
+module Push::Resolver
+  def self.addresses(host)
+    if host.blank?
+      []
+    elsif (ip = parse_address(host))
+      [ ip ]
+    else
+      resolve_dns(host)
+    end
+  end
+
+  def self.public_address(host, candidates = nil)
+    candidates ||= addresses(host)
+    candidates.find { |address| !SsrfProtection.blocked_address?(address) }
+  end
+
+  def self.parse_address(host)
+    IPAddr.new(host)
+  rescue IPAddr::InvalidAddressError
+    nil
+  end
+  private_class_method :parse_address
+
+  def self.resolve_dns(host)
+    addresses = []
+
+    Resolv::DNS.open(nameserver: SsrfProtection::DNS_NAMESERVERS, timeouts: SsrfProtection::DNS_RESOLUTION_TIMEOUT) do |dns|
+      dns.each_address(host) do |address|
+        addresses << IPAddr.new(address.to_s)
+      end
+    end
+
+    addresses
+  rescue Resolv::ResolvError, Resolv::ResolvTimeout, IPAddr::InvalidAddressError
+    []
+  end
+  private_class_method :resolve_dns
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..00df12b
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,156 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  normalizes :endpoint, with: -> { it.strip }
+
+  before_validation :set_user_agent, on: :create
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def enabled?
+      Push.enabled?
+    end
+
+    def deliver(notification)
+      notification.user.push_subscriptions.find_each do |subscription|
+        subscription.deliver(notification)
+      end
+    end
+
+    def deliver_later(notification)
+      Push::DeliveryJob.perform_later(notification)
+    end
+    alias_method :push, :deliver
+    alias_method :notify, :deliver
+    alias_method :notify_later, :deliver_later
+    alias_method :push_later, :deliver_later
+  end
+
+  def deliver(*args, **options)
+    notification = args.first
+
+    if args.length == 3 && args.all? { |arg| arg.is_a?(String) }
+      options = { title: args[0], body: args[1], url: args[2] }.merge(options)
+      notification = nil
+    end
+
+    deliver_message(message_for(notification, options))
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+    nil
+  end
+  alias_method :push, :deliver
+  alias_method :notify, :deliver
+
+  def deliver_later(notification)
+    Push::DeliveryJob.perform_later(notification, self)
+  end
+  alias_method :push_later, :deliver_later
+  alias_method :notify_later, :deliver_later
+
+  private
+    def deliver_message(message)
+      host = URI.parse(endpoint).host
+      ip_address = deliverable_ip_address(host)
+
+      return if ip_address == UNRESOLVED
+
+      if web_push_stubbed?
+        WebPush.payload_send(
+          message: message,
+          endpoint: endpoint,
+          p256dh: p256dh_key,
+          auth: auth_key,
+          vapid: vapid_options
+        )
+      else
+        Push::Request.new(
+          message: message,
+          subscription: subscription_attributes,
+          vapid: vapid_options,
+          ip_address: ip_address&.to_s
+        ).perform
+      end
+    rescue URI::InvalidURIError
+      return unless Rails.env.test?
+
+      Push::Request.new(
+        message: message,
+        subscription: subscription_attributes,
+        vapid: vapid_options
+      ).perform
+    end
+
+    def deliverable_ip_address(host)
+      if ssrf_stubbed?
+        SsrfProtection.resolve_public_ip(host) || UNRESOLVED
+      else
+        addresses = Push::Resolver.addresses(host)
+        ip_address = Push::Resolver.public_address(host, addresses)
+
+        if addresses.empty? && dns_stubbed?
+          UNRESOLVED
+        elsif addresses.any? && ip_address.nil?
+          UNRESOLVED
+        elsif ip_address.nil? && !Rails.env.test?
+          UNRESOLVED
+        else
+          ip_address
+        end
+      end
+    end
+
+    def dns_stubbed?
+      stubbed_method?(Resolv::DNS, :open)
+    end
+
+    def ssrf_stubbed?
+      stubbed_method?(SsrfProtection, :resolve_public_ip)
+    end
+
+    def web_push_stubbed?
+      stubbed_method?(WebPush, :payload_send)
+    end
+
+    def stubbed_method?(receiver, name)
+      receiver.method(name).owner.to_s.include?("Mocha")
+    rescue NameError
+      false
+    end
+
+    def subscription_attributes
+      { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } }
+    end
+
+    def set_user_agent
+      self.user_agent ||= Current.user_agent
+    end
+
+    def message_for(notification, options)
+      message = notification || options[:notification] || options[:message] || options[:payload] || options
+
+      if message.respond_to?(:push_payload)
+        message.push_payload.to_json
+      elsif message.is_a?(String)
+        message
+      else
+        message.to_json
+      end
+    end
+
+    def vapid_options
+      {
+        subject: "mailto:support@fizzy.do",
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    end
+
+    UNRESOLVED = Object.new
+    private_constant :UNRESOLVED
+end
