new file mode 100644
index 0000000..1992802
--- /dev/null
+++ b/app/jobs/push/delivery_job.rb
@@ -0,0 +1,25 @@
+class Push::DeliveryJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification, subscription = nil)
+    if notification.is_a?(Push::Subscription)
+      notification, subscription = subscription, notification
+    end
+
+    if subscription
+      subscription.deliver(notification)
+    elsif notification.respond_to?(:push_payload)
+      deliver_to_subscriptions(notification)
+    end
+  end
+
+  private
+    def deliver_to_subscriptions(notification)
+      Push::Subscription.deliver(notification)
+    rescue WebPush::Error, SocketError, SystemCallError, Timeout::Error, Resolv::ResolvError
+      # Push is not configured, so ignore delivery failures for stale subscriptions.
+      raise if Push.enabled?
+    end
+end
