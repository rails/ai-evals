--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,48 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def index
+    @subscriptions = @user.push_subscriptions.order(created_at: :desc)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path }
+      format.json { render json: @subscriptions.as_json(only: %i[ id endpoint ]) }
+    end
+  end
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled" }
+      format.json { render json: { id: @subscription.id }, status: :created }
+    end
+  end
+
+  def destroy
+    @subscription = @user.push_subscriptions.find_by(id: params[:id]) || @user.push_subscriptions.find_by!(endpoint: params[:id])
+    @subscription.destroy!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..5717fe7
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,167 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = ["details", "status"]
+  static values = {
+    subscriptionsUrl: String,
+    subscriptionUrl: String,
+    vapidPublicKey: String
+  }
+
+  async connect() {
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#removeEnabledClass()
+      this.#showDetails()
+      return
+    }
+
+    if (Notification.permission === "granted") {
+      this.#hideDetails()
+    }
+
+    if (await this.#currentSubscription()) {
+      await this.#syncSubscription()
+      this.#addEnabledClass()
+    } else {
+      this.#removeEnabledClass()
+    }
+  }
+
+  async enable() {
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#removeEnabledClass()
+      this.#showDetails()
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      await this.#saveSubscription(subscription)
+      this.#addEnabledClass()
+      this.#hideDetails()
+    } catch (error) {
+      console.error("Failed to enable push notifications", error)
+      this.#removeEnabledClass()
+      this.#showDetails()
+    }
+  }
+
+  async disable() {
+    try {
+      const subscription = await this.#currentSubscription()
+
+      if (subscription) {
+        await subscription.unsubscribe()
+      }
+
+      await this.#deleteSubscription()
+      this.#removeEnabledClass()
+    } catch (error) {
+      console.error("Failed to disable push notifications", error)
+    }
+  }
+
+  // Private
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const key = this.vapidPublicKeyValue || getMetaContent("vapid-public-key")
+
+    if (!key) return undefined
+
+    const padding = "=".repeat((4 - (key.length % 4)) % 4)
+    const base64 = (key + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+
+    return Uint8Array.from([...rawData].map((char) => char.charCodeAt(0)))
+  }
+
+  async #currentSubscription() {
+    if (!navigator.serviceWorker) return null
+
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #syncSubscription() {
+    const subscription = await this.#currentSubscription()
+    if (subscription) await this.#saveSubscription(subscription)
+  }
+
+  async #saveSubscription(subscription) {
+    const response = await this.#request(this.subscriptionsUrlValue, "POST", {
+      push_subscription: {
+        endpoint: subscription.endpoint,
+        p256dh_key: this.#base64FromArrayBuffer(subscription.getKey("p256dh")),
+        auth_key: this.#base64FromArrayBuffer(subscription.getKey("auth"))
+      }
+    })
+
+    if (response?.id) this.subscriptionUrlValue = this.subscriptionUrlValue.replace("ID", response.id)
+  }
+
+  async #deleteSubscription() {
+    if (!this.subscriptionUrlValue || this.subscriptionUrlValue.includes("ID")) return
+
+    await this.#request(this.subscriptionUrlValue, "DELETE")
+  }
+
+  async #request(url, method, body) {
+    const response = await fetch(url, {
+      method,
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": document.querySelector("meta[name=csrf-token]")?.content
+      },
+      body: body ? JSON.stringify(body) : undefined
+    })
+
+    if (!response.ok) throw new Error(`Request failed with status ${response.status}`)
+
+    if (response.status === 204) return null
+
+    return await response.json()
+  }
+
+  #base64FromArrayBuffer(buffer) {
+    return btoa(String.fromCharCode(...new Uint8Array(buffer)))
+  }
+
+  #addEnabledClass() {
+    this.element.classList.add("notifications--on")
+  }
+
+  #removeEnabledClass() {
+    this.element.classList.remove("notifications--on")
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach((target) => (target.hidden = false))
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach((target) => (target.hidden = true))
+  }
+}
