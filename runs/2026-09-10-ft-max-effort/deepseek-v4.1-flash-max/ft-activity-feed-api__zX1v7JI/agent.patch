+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    events = Current.user.accessible_events
+      .where(action: ACTIVITY_ACTIONS)
+      .preloaded
+      .order(created_at: :desc, id: :desc)
+
+    events = events.where(creator_id: creator_ids) if creator_ids.any?
+    events = events.where(board_id: board_ids) if board_ids.any?
+
+    set_page_and_extract_portion_from events
+  end
+
+  private
+    def creator_ids
+      @creator_ids ||= list_param(:creator_ids)
+    end
+
+    def board_ids
+      @board_ids ||= list_param(:board_ids)
+    end
+
+    def list_param(name)
+      Array(params[name]).flat_map { |value| value.to_s.split(",") }.reject(&:blank?).uniq
+    end
+end
