@@ -0,0 +1,41 @@
+module ActivitiesHelper
+  def activity_description(activity)
+    activity.description_for(Current.user).to_plain_text
+  end
+
+  def activity_particulars(activity)
+    case activity.action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: activity_assignee_ids(activity) }
+    when "card_board_changed"
+      details = activity_particulars_details(activity)
+      { old_board: details["old_board"].presence || "", new_board: details["new_board"].presence || "" }
+    when "card_title_changed"
+      details = activity_particulars_details(activity)
+      { old_title: details["old_title"].presence || "", new_title: details["new_title"].presence || "" }
+    when "card_triaged"
+      { column: activity_particulars_details(activity)["column"].presence || "" }
+    else
+      {}
+    end
+  end
+
+  def activity_url(activity)
+    if activity.eventable.is_a?(Comment)
+      card_url activity.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(activity.eventable)
+    else
+      card_url activity.eventable
+    end
+  end
+
+  private
+    def activity_assignee_ids(activity)
+      Array(activity.assignee_ids.presence || activity_particulars_details(activity)["assignee_ids"]).map(&:to_s)
+    end
+
+    def activity_particulars_details(activity)
+      particulars = activity.particulars || {}
+      nested = particulars["particulars"]
+      nested.is_a?(Hash) ? particulars.merge(nested) : particulars
+    end
+end
