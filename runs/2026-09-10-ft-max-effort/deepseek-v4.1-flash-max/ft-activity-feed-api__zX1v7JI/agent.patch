@@ -0,0 +1,261 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index returns activities as JSON" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert activities.is_a?(Array)
+    assert activities.any?
+
+    actions = activities.map { |activity| activity["action"] }
+    assert_includes actions, "card_assigned"
+    assert_includes actions, "comment_created"
+    assert_not_includes actions, "card_collection_changed"
+  end
+
+  test "each activity includes the expected fields" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.first
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url].sort, activity.keys.sort
+  end
+
+  test "assignments expose assignee ids" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal [ users(:jz).id ], activity["particulars"]["assignee_ids"]
+  end
+
+  test "comment activities link to the card comment" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "card activities link to the card" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+  end
+
+  test "uses existing representations for eventable, board, and creator" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_published).id }
+
+    assert_equal cards(:logo).number, activity.dig("eventable", "number")
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal cards(:logo).board_id, activity.dig("eventable", "board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+  end
+
+  test "descriptions are plain text" do
+    event = events(:layout_commented)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "David commented on"
+    assert_includes activity["description"], "Layout is broken"
+  end
+
+  test "board changes expose old and new board" do
+    boards(:private).events.create! action: "card_board_changed", creator: users(:kevin),
+      eventable: cards(:logo), board: boards(:private),
+      particulars: { "particulars" => { old_board: "Writebook", new_board: "Private board" } }
+    logout_and_sign_in_as :kevin
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_board_changed" }
+    assert_not_nil activity
+    assert_equal "Writebook", activity.dig("particulars", "old_board")
+    assert_equal "Private board", activity.dig("particulars", "new_board")
+  end
+
+  test "title changes are included and expose old and new title" do
+    card = cards(:logo)
+    old_title = card.title
+
+    Current.set(user: users(:david)) { card.update! title: "Renamed card" }
+
+    get activities_path(format: :json)
+
+    event = card.events.reload.find_by(action: "card_title_changed")
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_not_nil activity
+    assert_equal old_title, activity.dig("particulars", "old_title")
+    assert_equal "Renamed card", activity.dig("particulars", "new_title")
+  end
+
+  test "triage events expose the column" do
+    Current.set(user: users(:david)) { cards(:logo).triage_into columns(:writebook_in_progress) }
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_triaged" }
+    assert_not_nil activity
+    assert_equal "In progress", activity.dig("particulars", "column")
+  end
+
+  test "sent back to triage events have empty particulars" do
+    Current.set(user: users(:david)) { cards(:text).send_back_to_triage }
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_sent_back_to_triage" }
+    assert_not_nil activity
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "missing board, title, and column values are empty strings" do
+    cards(:logo).events.create! action: "card_board_changed", creator: users(:david), eventable: cards(:logo), board: boards(:writebook), particulars: {}
+    cards(:logo).events.create! action: "card_title_changed", creator: users(:david), eventable: cards(:logo), board: boards(:writebook), particulars: {}
+    cards(:logo).events.create! action: "card_triaged", creator: users(:david), eventable: cards(:logo), board: boards(:writebook), particulars: {}
+
+    get activities_path(format: :json)
+
+    board_change = @response.parsed_body.find { |a| a["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "", "new_board" => "" }, board_change["particulars"])
+
+    title_change = @response.parsed_body.find { |a| a["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "", "new_title" => "" }, title_change["particulars"])
+
+    triage = @response.parsed_body.find { |a| a["action"] == "card_triaged" }
+    assert_equal({ "column" => "" }, triage["particulars"])
+  end
+
+  test "other events have empty particulars" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_published).id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "does not include deprecated card collection changed events" do
+    cards(:logo).events.create! action: "card_collection_changed", creator: users(:david), eventable: cards(:logo), board: boards(:writebook), particulars: {}
+
+    get activities_path(format: :json)
+
+    assert_not_includes @response.parsed_body.map { |a| a["action"] }, "card_collection_changed"
+  end
+
+  test "activities are ordered newest first" do
+    get activities_path(format: :json)
+
+    created_at = @response.parsed_body.map { |activity| activity["created_at"] }
+    assert_equal created_at.sort.reverse, created_at
+  end
+
+  test "filters by creator ids" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |activity|
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+    end
+  end
+
+  test "filters by board ids" do
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    @response.parsed_body.each do |activity|
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+    end
+  end
+
+  test "only returns activity on accessible boards" do
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.where(user: users(:david)).delete_all
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "does not leak inaccessible board activity when filtered" do
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "paginates following API conventions" do
+    event = events(:logo_published)
+    20.times do |index|
+      boards(:writebook).events.create! action: "card_published", creator: users(:david),
+        eventable: cards(:logo), created_at: event.created_at + (index + 1).minutes
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_operator @response.parsed_body.size, :<, 21
+
+    link = @response.headers["Link"]
+    assert_match(/rel="next"/, link)
+    next_url = link.match(/<([^>]+)>/).captures.first
+
+    get next_url
+    assert_response :success
+  end
+
+  test "assigned events use the current user perspective in plain text" do
+    event = events(:logo_assignment_david)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "David will handle &quot;The logo isn&#39;t big enough&quot;", activity["description"]
+  end
+
+  test "supports flat particulars when building descriptions" do
+    card = cards(:logo)
+    event = boards(:writebook).events.create!(
+      action: "card_title_changed", creator: users(:david), eventable: card,
+      particulars: { old_title: "Old title", new_title: "New title" }
+    )
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity["particulars"])
+    assert_includes activity["description"], "Old title"
+  end
+
+  test "supports nested assignment particulars" do
+    event = boards(:writebook).events.create!(
+      action: "card_assigned", creator: users(:david), eventable: cards(:logo),
+      particulars: { "particulars" => { "assignee_ids" => [ users(:jz).id ] } }
+    )
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal [ users(:jz).id ], activity["particulars"]["assignee_ids"]
+    assert_includes activity["description"], "JZ"
+  end
+end
