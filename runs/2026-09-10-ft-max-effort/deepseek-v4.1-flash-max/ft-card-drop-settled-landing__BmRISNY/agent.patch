diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..ae02052
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,153 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "column" ]
+
+  dragStart(event) {
+    const card = event.target.closest(".card")
+    const sourceContainer = card && this.#containerFor(card)
+    if (!card || !card.draggable || !sourceContainer) return
+
+    this.draggedCard = card
+    this.sourceContainer = sourceContainer
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnter(event) {
+    const container = this.#containerFor(event.target)
+    if (container) {
+      event.preventDefault()
+      this.#highlight(container)
+    }
+  }
+
+  dragOver(event) {
+    const container = this.#containerFor(event.target)
+    if (container) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    }
+  }
+
+  dragLeave(event) {
+    const container = this.#containerFor(event.target)
+    if (container && !container.contains(event.relatedTarget)) {
+      this.#unhighlight(container)
+    }
+  }
+
+  drop(event) {
+    const card = this.draggedCard || this.#cardFrom(event)
+    if (!card) return
+
+    this.draggedCard = card
+    this.sourceContainer ||= this.#containerFor(card)
+
+    const targetContainer = this.#containerFor(event.target)
+
+    if (targetContainer) {
+      event.preventDefault()
+
+      if (targetContainer !== this.sourceContainer) {
+        this.#moveCard(card, targetContainer)
+        this.#saveMove(card, targetContainer)
+      }
+    }
+
+    this.#cleanup()
+  }
+
+  dragEnd() {
+    this.#cleanup()
+  }
+
+  // Private
+
+  #cardFrom(event) {
+    const id = event.dataTransfer?.getData("text/plain")
+    return id ? document.getElementById(id) : null
+  }
+
+  #containerFor(node) {
+    const element = node?.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement
+    const container = element?.closest(".cards")
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #highlight(container) {
+    if (this.hoveredContainer === container) return
+
+    this.#unhighlight()
+    this.hoveredContainer = container
+    container.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #unhighlight(container = this.hoveredContainer) {
+    if (!container) return
+
+    container.classList.remove(HOVER_CONTAINER_CLASS)
+    if (container === this.hoveredContainer) this.hoveredContainer = null
+  }
+
+  #moveCard(card, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (list) {
+      list.prepend(card)
+    } else {
+      this.#moveWhenListAppears(card, container)
+    }
+  }
+
+  #moveWhenListAppears(card, container) {
+    const observer = new MutationObserver(() => {
+      const list = container.querySelector(".cards__list")
+      if (list) {
+        observer.disconnect()
+        list.prepend(card)
+      } else if (!container.contains(card)) {
+        container.append(card)
+      }
+    })
+
+    observer.observe(container, { childList: true, subtree: true })
+    container.append(card)
+  }
+
+  #saveMove(card, container) {
+    const status = container.dataset.dragAndDropStatus
+    const columnId = container.dataset.dragAndDropColumnId
+    const options = { responseKind: "json" }
+
+    if (status === "maybe") {
+      this.#request(destroy, card.dataset.cardTriageUrl, options)
+    } else if (status === "not_now") {
+      this.#request(post, card.dataset.cardNotNowUrl, options)
+    } else if (status === "closed") {
+      this.#request(post, card.dataset.cardClosureUrl, options)
+    } else if (columnId) {
+      this.#request(post, card.dataset.cardTriageUrl, { ...options, body: { column_id: columnId } })
+    }
+  }
+
+  #request(method, url, options) {
+    if (url) method(url, options).catch(() => {})
+  }
+
+  #cleanup() {
+    this.draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#unhighlight()
+    this.draggedCard = null
+    this.sourceContainer = null
+  }
+}
