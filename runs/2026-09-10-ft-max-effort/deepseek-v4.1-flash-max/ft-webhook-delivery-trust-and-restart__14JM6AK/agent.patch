index 0000000..6069dff
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  test "posts the event payload and logs the request and response" do
+    delivery = webhook_deliveries(:pending)
+    body = delivery.payload
+    signature = OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body)
+
+    request = stub_request(:post, delivery.webhook.url).to_return(status: 200, headers: { "X-Test" => "present" })
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    delivery.reload
+
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig(:headers, "User-Agent")
+    assert_equal "application/json", delivery.request.dig(:headers, "Content-Type")
+    assert_equal delivery.event.created_at.utc.iso8601, delivery.request.dig(:headers, "X-Webhook-Timestamp")
+    assert_equal signature, delivery.request.dig(:headers, "X-Webhook-Signature")
+    assert_equal %w[ User-Agent Content-Type X-Webhook-Timestamp ], delivery.sanitized_request[:headers].keys
+
+    assert_requested :post, delivery.webhook.url do |http_request|
+      http_request.body == body &&
+        http_request.headers["X-Webhook-Signature"] == signature
+    end
+  end
+
+  test "only delivers once even if the job is performed twice" do
+    delivery = webhook_deliveries(:pending)
+    request = stub_request(:post, delivery.webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    Webhook::DeliveryJob.perform_now(delivery.reload)
+
+    assert_requested request, times: 1
+  end
+
+  test "logs and tracks failed deliveries" do
+    delivery = webhook_deliveries(:pending)
+
+    stub_request(:post, delivery.webhook.url).to_return(status: 500)
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, delivery.webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "logs unreachable destinations" do
+    delivery = webhook_deliveries(:pending)
+
+    stub_request(:post, delivery.webhook.url).to_raise(SocketError)
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, delivery.webhook.delinquency_tracker.consecutive_failures_count
+  end
+end
