+module Event::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :trigger_webhooks_later
+  end
+
+  def trigger_webhooks
+    board.webhooks.active.subscribed_to(action).find_each do |webhook|
+      webhook.deliver(self)
+    end
+  end
+  alias_method :deliver_webhooks, :trigger_webhooks
+  alias_method :trigger_webhook_deliveries, :trigger_webhooks
+
+  private
+    def trigger_webhooks_later
+      trigger_webhooks
+    end
+end
