+
+  alias_method :deliver, :deliver_now
+
+  def request_headers(body = payload)
+    {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+      "X-Webhook-Signature" => signature(body)
+    }
+  end
+
+  def payload
