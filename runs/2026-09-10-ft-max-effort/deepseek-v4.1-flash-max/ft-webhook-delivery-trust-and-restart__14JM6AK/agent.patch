index 0000000..55dc89f
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(name: "Delinquent", url: "https://example.com/hook", board: boards(:writebook))
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "is created with the webhook" do
+    assert @tracker.persisted?
+    assert_equal @webhook, @tracker.webhook
+  end
+
+  test "does not deactivate until ten failures over more than an hour" do
+    10.times { @tracker.track_failure }
+    assert @webhook.reload.active?
+
+    @tracker.update!(first_failure_at: 61.minutes.ago)
+    @tracker.track_failure
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "success resets consecutive failures" do
+    @tracker.update!(first_failure_at: 61.minutes.ago)
+    5.times { @tracker.track_failure }
+    @tracker.track_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    @tracker.track_failure
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating a webhook clears its delinquency" do
+    @tracker.update!(first_failure_at: 61.minutes.ago)
+    10.times { @tracker.track_failure }
+    assert_not @webhook.reload.active?
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+  end
+end
