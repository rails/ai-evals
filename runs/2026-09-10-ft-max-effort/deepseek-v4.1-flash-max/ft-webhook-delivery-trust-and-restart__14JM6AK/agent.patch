+++ b/test/models/webhook/delivery_cleanup_test.rb
@@ -0,0 +1,18 @@
+require "test_helper"
+
+class Webhook::DeliveryCleanupTest < ActiveSupport::TestCase
+  test "deletes deliveries older than a week" do
+    event = events(:shipping_published)
+    webhook = webhooks(:active)
+
+    old_delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    old_delivery.update_column(:created_at, 8.days.ago)
+
+    recent_delivery = webhook_deliveries(:pending)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+end
