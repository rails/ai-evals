@@ -1,4 +1,7 @@
 class Webhook::Delivery < ApplicationRecord
+  NETWORK_ERRORS = [ SocketError, Resolv::ResolvError, SystemCallError, Timeout::Error, IOError, OpenSSL::SSL::SSLError ].freeze
+  RESPONSE_TIMEOUT = 10
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +12,41 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where created_at: ...1.week.ago }
+  scope :stale, -> { where created_at: ...1.week.ago }
+
+  class << self
