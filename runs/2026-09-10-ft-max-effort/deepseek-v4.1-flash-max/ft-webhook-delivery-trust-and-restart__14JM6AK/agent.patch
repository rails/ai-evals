+++ b/test/models/event/triggerable_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Event::TriggerableTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+  end
+
+  test "creating an event creates one delivery per subscribed webhook and enqueues it" do
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      assert_enqueued_with(job: Webhook::DeliveryJob) do
+        @event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+      end
+    end
+
+    delivery = Webhook::Delivery.last
+    assert_equal webhooks(:active), delivery.webhook
+    assert_equal @event, delivery.event
+    assert delivery.pending?
+  end
+
+  test "does not create deliveries for unsubscribed actions or inactive webhooks" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "comment_created")
+    end
+  end
+
+  test "does not create duplicate deliveries for the same event and webhook" do
+    event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.trigger_webhooks
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
