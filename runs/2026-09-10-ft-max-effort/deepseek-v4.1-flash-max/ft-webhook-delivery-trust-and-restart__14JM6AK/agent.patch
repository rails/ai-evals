+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +67,64 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim(body)
+      with_lock do
+        if pending?
+          update!(state: :in_progress, request: { headers: request_headers(body) })
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def perform_request(body)
+      response = post(body)
+
+      transaction do
+        update!(state: :completed, response: { code: response.code.to_i, headers: response.to_hash })
+
+        if response.is_a?(Net::HTTPSuccess)
+          webhook.delinquency_tracker.track_success
+        else
+          webhook.delinquency_tracker.track_failure
+        end
+      end
+    end
+
+    def post(body)
+      uri = URI.parse(webhook.url)
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = RESPONSE_TIMEOUT
+      http.read_timeout = RESPONSE_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers(body).each { |name, value| request[name] = value }
+      request.body = body
+
+      http.start { |connection| connection.request(request) }
+    end
+
+    def record_error(error)
+      transaction do
+        update!(state: :errored, response: { error: error_message(error) })
+        webhook.delinquency_tracker.track_failure
+      end
+    end
+
+    def signature(body)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def error_message(error)
+      if NETWORK_ERRORS.any? { |klass| error.is_a?(klass) }
+        "destination_unreachable"
+      else
+        error.message
+      end
+    end
 end
