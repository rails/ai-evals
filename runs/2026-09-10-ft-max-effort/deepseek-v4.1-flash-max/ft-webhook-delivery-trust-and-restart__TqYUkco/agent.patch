+      elsif (public_ip = SsrfProtection.resolve_public_ip(uri.host)).present?
+        @resolved_ip = public_ip
+      elsif SsrfProtection.resolve_addresses(uri.host) == :unavailable
+        @resolved_ip = nil
+      else
+        @resolved_ip = :blocked
+      end
+    end
+
+    def localhost?(host)
+      host.to_s.downcase == "localhost" || host.to_s.downcase.end_with?(".localhost")
+    end
+
+    def ip_literal?(host)
+      IPAddr.new(host.to_s)
+      true
+    rescue IPAddr::InvalidAddressError
