+  alias_method :headers, :request_headers
+
+  def payload
+    case
+    when webhook.for_slack?
+      { text: rendered_event(:html) }.to_json
+    when webhook.for_campfire?
+      { body: rendered_event(:html) }.to_json
+    when webhook.for_basecamp?
+      { content: rendered_event(:html), content_type: "text/html" }.to_json
+    else
