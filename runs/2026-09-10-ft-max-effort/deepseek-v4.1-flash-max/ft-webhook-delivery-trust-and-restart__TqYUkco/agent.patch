+
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    return false unless claim!
+
+    request_body = payload
+    request_headers = headers_for(request_body)
+    update!(request: { headers: request_headers })
+
+    complete perform_request(request_headers, request_body)
