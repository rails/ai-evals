+    end
+  end
+
+  private
+    def remember_event_suppression
+      @event_suppression = Event.suppressed?
+    end
+
+    def event_suppression?
+      @event_suppression
+    end
+
+    def claim!
+      with_lock do
+        return false unless pending?
+
+        in_progress!
+        true
+      end
+    end
+
+    def complete(http_response)
+      code = http_response.code.to_i
+      response_headers = http_response.respond_to?(:to_hash) ? http_response.to_hash : {}
+
+      update! state: :completed, response: { code: code, headers: response_headers, error: nil }
+
+      if code.between?(200, 299)
+        webhook.delinquency_tracker.track_success
+      else
+        webhook.delinquency_tracker.track_failure
+      end
+
+      true
+    end
+
+    def fail_with(error)
+      error_key = error.is_a?(BlockedDestination) ? "destination_unreachable" : error_message_for(error)
+      update! state: :errored, response: { error: error_key }
+      webhook.delinquency_tracker.track_failure
+      false
+    end
+
+    def perform_request(request_headers, request_body)
+      uri = URI.parse(webhook.url)
+      ip = resolved_ip(uri)
+      raise BlockedDestination if ip == :blocked
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |name, value| request[name] = value }
+      request.body = request_body
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = NETWORK_TIMEOUT
+      http.read_timeout = NETWORK_TIMEOUT
+      http.ipaddr = ip if ip.present?
+
+      http.request(request)
+    end
+
+    def resolved_ip(uri)
