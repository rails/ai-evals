diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a7a90b0
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,444 @@
+// Moves cards between board columns and the Maybe, Not Now, and Done statuses.
+// Cards are moved in the DOM as soon as they are dropped, then saved in the
+// background, so the board never waits on the server.
+
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const DRAG_START_THRESHOLD = 4
+
+export default class extends Controller {
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  connect() {
+    this.desktopMediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.draggedCard = null
+    this.nativeDragging = false
+    this.pendingMouseCard = null
+
+    this.handleDragStart = this.handleDragStart.bind(this)
+    this.handleDragEnd = this.handleDragEnd.bind(this)
+    this.handleDragOver = this.handleDragOver.bind(this)
+    this.handleDragLeave = this.handleDragLeave.bind(this)
+    this.handleDrop = this.handleDrop.bind(this)
+    this.handleMouseDown = this.handleMouseDown.bind(this)
+    this.handleMouseMove = this.handleMouseMove.bind(this)
+    this.handleMouseUp = this.handleMouseUp.bind(this)
+    this.handleKeyDown = this.handleKeyDown.bind(this)
+    this.suppressClick = this.suppressClick.bind(this)
+
+    this.element.addEventListener("dragstart", this.handleDragStart, true)
+    this.element.addEventListener("dragend", this.handleDragEnd, true)
+    this.element.addEventListener("dragover", this.handleDragOver, true)
+    this.element.addEventListener("dragleave", this.handleDragLeave, true)
+    this.element.addEventListener("drop", this.handleDrop, true)
+    this.element.addEventListener("mousedown", this.handleMouseDown, true)
+    document.addEventListener("mousemove", this.handleMouseMove, true)
+    document.addEventListener("mouseup", this.handleMouseUp, true)
+    document.addEventListener("keydown", this.handleKeyDown, true)
+    document.addEventListener("click", this.suppressClick, true)
+  }
+
+  disconnect() {
+    this.element.removeEventListener("dragstart", this.handleDragStart, true)
+    this.element.removeEventListener("dragend", this.handleDragEnd, true)
+    this.element.removeEventListener("dragover", this.handleDragOver, true)
+    this.element.removeEventListener("dragleave", this.handleDragLeave, true)
+    this.element.removeEventListener("drop", this.handleDrop, true)
+    this.element.removeEventListener("mousedown", this.handleMouseDown, true)
+    document.removeEventListener("mousemove", this.handleMouseMove, true)
+    document.removeEventListener("mouseup", this.handleMouseUp, true)
+    document.removeEventListener("keydown", this.handleKeyDown, true)
+    document.removeEventListener("click", this.suppressClick, true)
+    clearTimeout(this.clickSuppressionTimer)
+    this.#cancelMouseDrag()
+    this.#endDrag()
+  }
+
+  // Native drag events
+
+  handleDragStart(event) {
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    if (!this.desktopMediaQuery.matches) {
+      event.preventDefault()
+      return
+    }
+
+    const column = card.closest(".cards")
+    if (!column) return
+
+    this.nativeDragging = true
+    this.#cancelMouseDrag()
+    this.pendingMouseCard = null
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  handleDragEnd() {
+    this.nativeDragging = false
+    this.#cancelMouseDrag()
+    this.#endDrag()
+  }
+
+  handleDragOver(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event)
+    if (!column) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    this.#highlight(column)
+  }
+
+  handleDragLeave(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event)
+    if (!column) return
+
+    // Ignore dragleave events fired while moving between children of the same column.
+    const nextTarget = event.relatedTarget
+    if (nextTarget && column.contains(nextTarget)) return
+
+    column.classList.remove(HOVER_CLASS)
+  }
+
+  handleDrop(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event)
+    if (!column) return
+
+    event.preventDefault()
+
+    const card = this.draggedCard
+    this.#endDrag()
+    this.#move(card, column)
+  }
+
+  // Pointer fallbacks, for when the browser doesn't start a native drag.
+
+  handleMouseDown(event) {
+    if (event.button !== 0 || !this.desktopMediaQuery.matches) return
+
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.pendingMouseCard = {
+      card,
+      startX: event.clientX,
+      startY: event.clientY,
+      moved: false,
+      targetColumn: null
+    }
+  }
+
+  handleMouseMove(event) {
+    const pending = this.pendingMouseCard
+    if (!pending || this.nativeDragging) return
+
+    const distance = Math.hypot(event.clientX - pending.startX, event.clientY - pending.startY)
+    const leftCard = event.target && event.target !== pending.card && !pending.card.contains(event.target)
+
+    if (!pending.moved && distance < DRAG_START_THRESHOLD && !leftCard) return
+
+    if (!pending.moved) {
+      pending.moved = true
+      pending.card.classList.add(DRAGGED_CLASS)
+    }
+
+    const column = this.#columnFor(event) || this.#columnAt(event.clientX, event.clientY)
+    pending.targetColumn = column
+
+    if (column) {
+      this.#highlight(column)
+    } else {
+      this.#clearHighlight()
+    }
+  }
+
+  handleMouseUp(event) {
+    const pending = this.pendingMouseCard
+    if (!pending) return
+
+    if (this.nativeDragging) {
+      this.pendingMouseCard = null
+      this.#cancelMouseDrag(pending.card)
+      return
+    }
+
+    const card = pending.card
+    const sourceColumn = card.closest(".cards")
+    const targetColumn = this.#columnFor(event) || pending.targetColumn || this.#columnAt(event.clientX, event.clientY)
+
+    this.pendingMouseCard = null
+    this.#cancelMouseDrag(card)
+
+    if (targetColumn && sourceColumn && targetColumn !== sourceColumn) {
+      this.#move(card, targetColumn)
+    }
+
+    if (pending.moved) this.#suppressFollowingClick()
+  }
+
+  handleKeyDown(event) {
+    if (event.key === "Escape") {
+      this.pendingMouseCard = null
+      this.#cancelMouseDrag()
+    }
+  }
+
+  // Click handling
+
+  suppressClick(event) {
+    if (this.shouldSuppressClick) {
+      event.preventDefault()
+      event.stopImmediatePropagation()
+      this.shouldSuppressClick = false
+    }
+  }
+
+  // Private
+
+  #columnFor(event) {
+    const column = event.target.closest?.(".cards")
+    return column && this.element.contains(column) ? column : null
+  }
+
+  #columnAt(x, y) {
+    const element = document.elementFromPoint(x, y)
+    const column = element?.closest(".cards")
+    return column && this.element.contains(column) ? column : null
+  }
+
+  #highlight(column) {
+    this.element.querySelectorAll(".cards").forEach(candidate => {
+      candidate.classList.toggle(HOVER_CLASS, candidate === column)
+    })
+  }
+
+  #clearHighlight() {
+    this.element.querySelectorAll(`.${HOVER_CLASS}`).forEach(column => column.classList.remove(HOVER_CLASS))
+  }
+
+  #cancelMouseDrag(card = this.pendingMouseCard?.card) {
+    card?.classList.remove(DRAGGED_CLASS)
+    this.#clearDraggedClasses()
+    this.#clearHighlight()
+  }
+
+  #endDrag() {
+    this.#clearDraggedClasses()
+    this.#clearHighlight()
+    this.draggedCard = null
+  }
+
+  #clearDraggedClasses() {
+    this.element.querySelectorAll(`.${DRAGGED_CLASS}`).forEach(card => card.classList.remove(DRAGGED_CLASS))
+  }
+
+  #move(card, targetColumn) {
+    const sourceColumn = card.closest(".cards")
+    if (!sourceColumn || sourceColumn === targetColumn) return
+
+    const sourceList = sourceColumn.querySelector(".cards__list")
+    const targetList = targetColumn.querySelector(".cards__list")
+    if (!sourceList || !targetList) return
+
+    // Remember where the card was so we can put it back if the save fails.
+    const originalParent = card.parentElement
+    const nextSibling = card.nextElementSibling
+
+    // Move the card right away so the board is already where the person dropped it.
+    this.#prepend(card, targetList, this.#columnType(targetColumn))
+    this.#updateCardState(card, targetColumn)
+    this.#updateCount(sourceColumn, -1)
+    this.#updateCount(targetColumn, 1)
+    this.#updateEmptyState(sourceColumn)
+
+    // Keep saves for a card in order so rapid drops settle on the last one.
+    const save = (card.dragAndDropSavePromise || Promise.resolve())
+      .catch(() => {})
+      .then(() => this.#save(card, targetColumn))
+
+    card.dragAndDropSavePromise = save
+
+    save.then(() => {
+      if (card.dragAndDropSavePromise === save) card.dragAndDropSavePromise = null
+    }).catch(() => {
+      if (card.dragAndDropSavePromise === save) {
+        card.dragAndDropSavePromise = null
+        this.#revert(card, sourceColumn, targetColumn, originalParent, nextSibling)
+      }
+    })
+  }
+
+  async #save(card, targetColumn) {
+    const type = this.#columnType(targetColumn)
+
+    const request = {
+      maybe: () => this.#perform(destroy, card.dataset.cardTriageUrl),
+      not_now: () => this.#perform(post, card.dataset.cardNotNowUrl),
+      closed: () => this.#perform(post, card.dataset.cardClosureUrl),
+      column: () => this.#perform(post, card.dataset.cardTriageUrl, {
+        column_id: this.#columnId(targetColumn)
+      })
+    }[type]
+
+    await request()
+  }
+
+  async #perform(fetchMethod, url, body = undefined) {
+    if (!url) throw new Error("Missing drag-and-drop url")
+
+    const response = await fetchMethod(url, { body, responseKind: "json" })
+    if (response && !response.ok) throw new Error(`Drag-and-drop request failed with ${response.statusCode}`)
+  }
+
+  #prepend(card, list, targetType) {
+    // Active columns and Maybe render golden cards first, so keep the moved card
+    // within that block; otherwise the board would shift when the refresh arrives.
+    const cards = Array.from(list.querySelectorAll(".card"))
+
+    if ((targetType === "column" || targetType === "maybe") && !card.classList.contains("golden-effect")) {
+      const firstNonGolden = cards.find(element => !element.classList.contains("golden-effect"))
+
+      if (firstNonGolden) {
+        firstNonGolden.parentNode.insertBefore(card, firstNonGolden)
+        return
+      }
+
+      // All existing cards are golden, so the moved card belongs after them.
+      const lastGolden = cards[cards.length - 1]
+      if (lastGolden) {
+        lastGolden.parentNode.insertBefore(card, lastGolden.nextElementSibling)
+        return
+      }
+    }
+
+    const container = cards[0]?.parentElement || list
+    container.prepend(card)
+  }
+
+  #revert(card, sourceColumn, targetColumn, originalParent, nextSibling) {
+    if (originalParent?.isConnected) {
+      if (nextSibling?.parentNode === originalParent) {
+        originalParent.insertBefore(card, nextSibling)
+      } else {
+        originalParent.prepend(card)
+      }
+    } else {
+      sourceColumn.querySelector(".cards__list")?.prepend(card)
+    }
+
+    this.#updateCardState(card, sourceColumn)
+    this.#updateCount(targetColumn, -1)
+    this.#updateCount(sourceColumn, 1)
+    this.#updateEmptyState(targetColumn)
+  }
+
+  #updateCardState(card, column) {
+    const type = this.#columnType(column)
+
+    card.classList.toggle("card--postponed", type === "not_now")
+    card.classList.toggle("card--active", type === "column" || type === "maybe")
+
+    this.#updateColumnBadge(card, column)
+  }
+
+  #updateColumnBadge(card, column) {
+    const header = card.querySelector(".card__header")
+    if (!header) return
+
+    let badge = card.querySelector(".card__column-name--current")
+
+    if (this.#columnType(column) === "column") {
+      if (!badge) {
+        badge = document.createElement("span")
+        badge.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+        const label = document.createElement("span")
+        label.className = "overflow-ellipsis"
+        badge.append(label)
+
+        header.append(badge)
+      }
+
+      const label = badge.querySelector(".overflow-ellipsis") || badge
+      label.textContent = column.dataset.columnName || ""
+    } else {
+      badge?.remove()
+    }
+  }
+
+  #updateEmptyState(column) {
+    if (this.#columnType(column) === "maybe") return
+
+    const list = column.querySelector(".cards__list")
+    if (!list || list.querySelector(".card") || list.querySelector(".blank-slate")) return
+
+    const defaultSlate = document.createElement("div")
+    defaultSlate.className = "blank-slate blank-slate--default"
+    defaultSlate.textContent = "No cards here"
+
+    const dragSlate = document.createElement("div")
+    dragSlate.className = "blank-slate blank-slate--drag overflow-ellipsis"
+    dragSlate.textContent = "Drag cards here"
+
+    list.append(defaultSlate, dragSlate)
+  }
+
+  #updateCount(column, delta) {
+    const count = column.querySelector(".cards__expander-count")
+    if (!count) return
+
+    const current = parseInt(count.textContent.trim(), 10)
+    if (Number.isNaN(current)) return
+
+    const next = Math.max(0, current + delta)
+    count.textContent = next > 99 ? "99+" : `${next}`
+
+    const expander = count.closest(".cards__expander")
+    expander?.style.setProperty("--card-count", `${Math.min(next, 15)}`)
+  }
+
+  #columnType(column) {
+    switch (column.id) {
+      case "maybe":
+        return "maybe"
+      case "not-now":
+        return "not_now"
+      case "closed-cards":
+        return "closed"
+      default:
+        return "column"
+    }
+  }
+
+  #columnId(column) {
+    return column.dataset.columnId || column.dataset.dragAndDropColumnId || column.id.replace(/^column_/, "")
+  }
+
+  #suppressFollowingClick() {
+    this.shouldSuppressClick = true
+
+    // Click events normally follow mouseup immediately. If no click is emitted
+    // at all, don't let the flag suppress a later, unrelated click.
+    clearTimeout(this.clickSuppressionTimer)
+    this.clickSuppressionTimer = setTimeout(() => { this.shouldSuppressClick = false }, 100)
+  }
+}
