--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,28 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: assignee_ids || details["assignee_ids"] }
+    when "card_board_changed"
+      { old_board: particular("old_board"), new_board: particular("new_board") }
+    when "card_title_changed"
+      { old_title: particular("old_title"), new_title: particular("new_title") }
+    when "card_triaged"
+      { column: particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def details
+      particulars || {}
+    end
+
+    def particular(key)
+      (details.dig("particulars", key) || details[key]).to_s
+    end
 end
