@@ -0,0 +1,30 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      scope = Current.user.accessible_events
+        .where(action: Event::ACTIVITY_ACTIONS)
+        .preloaded
+        .reverse_chronologically
+
+      scope = scope.where(creator_id: creator_ids) if creator_ids.any?
+      scope = scope.where(board_id: board_ids) if board_ids.any?
+
+      scope
+    end
+
+    def creator_ids
+      @creator_ids ||= array_param(:creator_ids)
+    end
+
+    def board_ids
+      @board_ids ||= array_param(:board_ids)
+    end
+
+    def array_param(key)
+      Array(params[key]).compact_blank.uniq
+    end
+end
