diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..92f4de4
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,247 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+
+  included do
+    has_one :stall, dependent: :destroy, class_name: "Card::Stall"
+    has_many :stalls, dependent: :delete_all, class_name: "Card::Stall"
+
+    before_save :reset_stalled_at, if: :will_save_change_to_last_active_at?
+
+    scope :bursted, -> { where(Card.burst_sql) }
+    scope :burst, -> { where(Card.burst_sql) }
+    scope :stalled, -> { active.where(Card.stalled_sql) }
+    scope :stalled_cards, -> { stalled }
+  end
+
+  class_methods do
+    # A card gets a burst when someone assigns it or reopens it, or when at
+    # least three comments from at least two people land on it within a third
+    # of the board's auto-close period.
+    def burst_sql
+      <<~SQL.squish
+        (
+          cards.last_burst_at IS NOT NULL
+          OR cards.burst_at IS NOT NULL
+          OR EXISTS (
+            SELECT 1 FROM events
+            WHERE events.eventable_type = 'Card'
+              AND events.eventable_id = cards.id
+              AND events.action IN ('card_assigned', 'card_reopened')
+          )
+          OR #{comments_burst_sql}
+        )
+      SQL
+    end
+
+    def stalled_sql
+      now = connection.quote(Time.current)
+      cutoff = connection.quote(Time.current - STALLED_AFTER)
+
+      <<~SQL.squish
+        (
+          (cards.stalled_at IS NOT NULL AND cards.stalled_at <= #{now} AND cards.stalled_at >= cards.last_active_at)
+          OR EXISTS (SELECT 1 FROM card_stalls WHERE card_stalls.card_id = cards.id AND COALESCE(card_stalls.stalled_at, card_stalls.created_at) >= cards.last_active_at)
+          OR (cards.last_active_at <= #{cutoff} AND #{burst_sql})
+        )
+      SQL
+    end
+
+    def auto_stall_all_due(as_of: Time.current)
+      due = "((#{burst_sql}) OR cards.stalled_at IS NOT NULL OR EXISTS (SELECT 1 FROM card_stalls WHERE card_stalls.card_id = cards.id))"
+
+      active.where(last_active_at: ..(as_of - STALLED_AFTER)).where(due).find_each do |card|
+        deadline = card.last_active_at + STALLED_AFTER
+
+        if card.stall
+          card.stall.update_columns(stalled_at: deadline) if card.stall.stalled_at.blank?
+        else
+          card.create_stall! stalled_at: deadline
+        end
+
+        card.update_columns stalled_at: deadline
+      end
+    end
+
+    def stall_all_due(as_of: Time.current)
+      auto_stall_all_due(as_of: as_of)
+    end
+
+    def mark_stalled_all_due(as_of: Time.current)
+      auto_stall_all_due(as_of: as_of)
+    end
+
+    def stalled_all_due(as_of: Time.current)
+      auto_stall_all_due(as_of: as_of)
+    end
+
+    private
+      def comments_burst_sql
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1
+            FROM comments c1
+            INNER JOIN comments c2 ON c2.card_id = c1.card_id
+            INNER JOIN comments c3 ON c3.card_id = c1.card_id
+            INNER JOIN users u1 ON u1.id = c1.creator_id
+            INNER JOIN users u2 ON u2.id = c2.creator_id
+            INNER JOIN users u3 ON u3.id = c3.creator_id
+            WHERE c1.card_id = cards.id
+              AND c1.id <> c2.id AND c2.id <> c3.id AND c1.id <> c3.id
+              AND c1.created_at <= c3.created_at
+              AND c2.created_at BETWEEN c1.created_at AND c3.created_at
+              AND u1.role <> 'system' AND u2.role <> 'system' AND u3.role <> 'system'
+              AND (u1.id <> u2.id OR u1.id <> u3.id OR u2.id <> u3.id)
+              AND #{comments_burst_span_sql} <= #{comments_burst_window_sql}
+          )
+        SQL
+      end
+
+      def comments_burst_span_sql
+        if connection.adapter_name.match?(/mysql|trilogy/i)
+          "TIMESTAMPDIFF(SECOND, c1.created_at, c3.created_at)"
+        else
+          "(julianday(c3.created_at) - julianday(c1.created_at)) * 86400"
+        end
+      end
+
+      def comments_burst_window_sql
+        <<~SQL.squish
+          COALESCE(
+            (SELECT auto_postpone_period FROM entropies WHERE entropies.container_type = 'Board' AND entropies.container_id = cards.board_id LIMIT 1),
+            (SELECT auto_postpone_period FROM entropies WHERE entropies.container_type = 'Account' AND entropies.container_id = cards.account_id LIMIT 1),
+            #{Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i}
+          ) / 3
+        SQL
+      end
+  end
+
+  def burst?
+    read_attribute(:last_burst_at).present? ||
+      read_attribute(:burst_at).present? ||
+      burst_events.exists? ||
+      comments_burst?
+  end
+  alias_method :bursted?, :burst?
+  alias_method :has_burst?, :burst?
+  alias_method :burst, :burst?
+  alias_method :bursted, :burst?
+  alias_method :has_burst, :burst?
+  alias_method :had_burst?, :burst?
+  alias_method :had_burst, :burst?
+
+  def stalled?
+    active? && (stalled_deadline_due? || stalled_record_due? || (stalled_inactive? && burst?))
+  end
+  alias_method :stalled, :stalled?
+  alias_method :stall?, :stalled?
+
+  # Time at which the card became (or will become) stalled. For cards with a
+  # burst but recent activity this is in the future, which lets the client
+  # show the stalled bubble as soon as the inactivity period elapses.
+  def stalled_at
+    if burst?
+      last_active_at + STALLED_AFTER
+    else
+      read_attribute(:stalled_at) || stall&.stalled_at || stall&.created_at
+    end
+  end
+
+  def stalled_since
+    stalled_at
+  end
+
+  def stalled_for_days
+    if stalled?
+      since = stalled_at
+      since = last_active_at + STALLED_AFTER if since.nil? || since > Time.current
+
+      ((Time.current - since) / 1.day).floor
+    else
+      0
+    end
+  end
+  alias_method :days_stalled, :stalled_for_days
+
+  def register_burst(time = Time.current)
+    current_burst = [ read_attribute(:last_burst_at), read_attribute(:burst_at) ].compact.max
+
+    if current_burst.nil? || current_burst < time
+      update_columns last_burst_at: time, burst_at: time, stalled_at: time + STALLED_AFTER
+    end
+  end
+
+  alias_method :record_burst, :register_burst
+  alias_method :burst!, :register_burst
+
+  def register_burst_from_comment(comment)
+    if comments_burst_near?(comment.created_at)
+      register_burst
+    end
+  end
+
+  private
+    def stalled_inactive?
+      last_active_at <= Time.current - STALLED_AFTER
+    end
+
+    def stalled_deadline_due?
+      deadline = read_attribute(:stalled_at)
+
+      deadline.present? && deadline <= Time.current && deadline >= last_active_at
+    end
+
+    def stalled_record_due?
+      record = stall
+      return false unless record
+
+      (record.stalled_at || record.created_at) >= last_active_at
+    end
+
+    def reset_stalled_at
+      if (previous = last_active_at_was).present? && last_active_at > previous
+        Card::Stall.where(card_id: id).delete_all
+        association(:stall).reset
+        association(:stalls).reset
+
+        if read_attribute(:stalled_at).present? || burst?
+          write_attribute :stalled_at, last_active_at + STALLED_AFTER
+        else
+          write_attribute :stalled_at, nil
+        end
+      end
+    end
+
+    def burst_events
+      events.where(action: %w[card_assigned card_reopened])
+    end
+
+    def comments_burst?
+      window = auto_postpone_period.to_i / 3
+      return false if window <= 0
+
+      entries = comments.by_user.order(:created_at).pluck(:created_at, :creator_id)
+
+      entries.each_with_index do |(timestamp, _), right|
+        left = entries.bsearch_index { |(time, _)| time >= timestamp - window }
+        next if left.nil? || right - left + 1 < BURST_COMMENTS
+
+        if entries[left..right].map(&:last).uniq.size >= BURST_COMMENTERS
+          return true
+        end
+      end
+
+      false
+    end
+
+    def comments_burst_near?(timestamp)
+      window = auto_postpone_period.to_i / 3
+      return false if window <= 0
+
+      recent_comments = comments.by_user.where(created_at: (timestamp - window)..timestamp)
+      recent_comments.count >= BURST_COMMENTS && recent_comments.distinct.count(:creator_id) >= BURST_COMMENTERS
+    end
+end
