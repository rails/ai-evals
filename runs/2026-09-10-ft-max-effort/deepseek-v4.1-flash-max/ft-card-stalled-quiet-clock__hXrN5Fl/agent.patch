@@ -0,0 +1,41 @@
+require "test_helper"
+
+class StalledCardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index with stalled filter renders" do
+    cards(:logo).update!(last_active_at: 3.weeks.ago)
+
+    get cards_path, params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_match "Stalled", response.body
+  end
+
+  test "index as JSON with stalled filter" do
+    card = cards(:logo)
+    card.update!(last_active_at: 3.weeks.ago)
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_equal [ card.number ], @response.parsed_body.pluck("number")
+    assert @response.parsed_body.first["stalled"]
+  end
+
+  test "stalled cards show indicator on card page" do
+    card = cards(:logo)
+    card.update!(last_active_at: 3.weeks.ago)
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select ".card--stalled"
+    assert_select ".card__stalled", text: /Stalled/
+    assert_select "[data-bubble-entropy-value]", minimum: 1 do |elements|
+      assert JSON.parse(elements.first["data-bubble-entropy-value"])["stalledAt"].present?
+    end
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..2e14b24
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,174 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "comments can form a burst" do
+    card = cards(:text)
+
+    card.comments.create!(body: "One", creator: users(:david), created_at: 2.days.ago)
+    card.comments.create!(body: "Two", creator: users(:kevin), created_at: 1.day.ago)
+    card.comments.create!(body: "Three", creator: users(:david), created_at: 1.hour.ago)
+
+    assert card.reload.burst?
+    assert card.last_burst_at.present?
+    assert_not card.stalled?
+  end
+
+  test "a single commenter cannot form a burst" do
+    card = cards(:text)
+
+    card.comments.create!(body: "One", creator: users(:david), created_at: 2.days.ago)
+    card.comments.create!(body: "Two", creator: users(:david), created_at: 1.day.ago)
+    card.comments.create!(body: "Three", creator: users(:david), created_at: 1.hour.ago)
+
+    assert_not card.reload.burst?
+  end
+
+  test "comments outside the burst window do not count" do
+    card = cards(:text)
+
+    # The board's period is 90 days, so the window is 30 days.
+    card.comments.create!(body: "One", creator: users(:david), created_at: 60.days.ago)
+    card.comments.create!(body: "Two", creator: users(:kevin), created_at: 45.days.ago)
+    card.comments.create!(body: "Three", creator: users(:david), created_at: 1.hour.ago)
+
+    assert_not card.reload.burst?
+  end
+
+test "the burst window follows the board auto-close period" do
+  entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+  card = cards(:text)
+
+  card.comments.create!(body: "One", creator: users(:david), created_at: 2.days.ago)
+  card.comments.create!(body: "Two", creator: users(:kevin), created_at: 1.day.ago)
+  card.comments.create!(body: "Three", creator: users(:david), created_at: 1.hour.ago)
+
+  assert_not card.reload.burst?
+end
+
+test "the burst window falls back to the account auto-close period" do
+  entropies(:writebook_board).destroy
+  card = cards(:text)
+
+  card.comments.create!(body: "One", creator: users(:david), created_at: 6.days.ago)
+  card.comments.create!(body: "Two", creator: users(:kevin), created_at: 3.days.ago)
+  card.comments.create!(body: "Three", creator: users(:david), created_at: 1.day.ago)
+
+  assert card.reload.burst?
+end
+
+  test "assignments and reopens are bursts" do
+    card = cards(:text)
+
+    card.toggle_assignment users(:kevin)
+    assert card.reload.burst?
+    assert card.last_burst_at.present?
+  end
+
+  test "cards become stalled after two weeks without activity" do
+    card = cards(:logo) # has assignment events
+
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+    assert_includes Card.stalled, card
+    assert_equal card.last_active_at + 2.weeks, card.stalled_at
+    assert_equal 7, card.stalled_for_days
+  end
+
+  test "cards without a burst do not become stalled" do
+    card = cards(:text)
+
+    card.update!(last_active_at: 3.weeks.ago)
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "activity resets a stalled card" do
+    card = cards(:logo)
+    card.update!(last_active_at: 3.weeks.ago)
+    assert card.stalled?
+
+    card.comments.create!(body: "Still here", creator: users(:david))
+    assert_not card.reload.stalled?
+  end
+
+  test "auto_stall_all_due marks due burst cards and records the stall" do
+    card = cards(:logo)
+    card.update_columns(last_active_at: 3.weeks.ago, stalled_at: nil)
+
+    assert_difference -> { Card::Stall.count }, +1 do
+      Card.auto_stall_all_due
+    end
+
+    assert card.reload.stalled?
+    assert card.stall.present?
+  end
+
+  test "activity removes an existing stall record" do
+    card = cards(:logo)
+    card.update!(last_active_at: 3.weeks.ago)
+    card.create_stall!
+    assert card.stalled?
+
+    card.comments.create!(body: "Back to work", creator: users(:david))
+    assert_not card.stalled?
+    assert_nil card.stall
+    assert_nil card.reload.stall
+  end
+
+  test "an existing stall record marks a card as stalled" do
+    card = cards(:text)
+    card.update_columns(last_active_at: 3.weeks.ago)
+    card.create_stall!(created_at: 1.week.ago, stalled_at: 1.week.ago)
+
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+test "destroying a card destroys its stall" do
+  card = cards(:text)
+  card.update_columns(last_active_at: 3.weeks.ago)
+  card.create_stall!
+
+  assert_difference -> { Card::Stall.count }, -1 do
+    card.destroy!
+  end
+end
+
+  test "a persisted burst marker marks a card as stalled when idle" do
+    card = cards(:text)
+    card.update_columns(last_active_at: 3.weeks.ago, last_burst_at: 4.weeks.ago, burst_at: 4.weeks.ago, stalled_at: nil)
+
+    assert card.burst?
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+end
+
+class Card::StallableFilteringTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "stalled cards can be listed with indexed_by stalled" do
+    card = cards(:logo)
+    card.update!(last_active_at: 3.weeks.ago)
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert filter.indexed_by.stalled?
+    assert_includes filter.cards, card
+  end
+
+  test "cards without a burst are not listed as stalled" do
+    card = cards(:text)
+    card.update!(last_active_at: 3.weeks.ago)
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_not_includes filter.cards, card
+  end
+end
