diff --git a/config/initializers/request_locale.rb b/config/initializers/request_locale.rb
new file mode 100644
index 0000000..aa42497
--- /dev/null
+++ b/config/initializers/request_locale.rb
@@ -0,0 +1,22 @@
+class RequestLocaleMiddleware
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    locale = requested_locale(ActionDispatch::Request.new(env))
+    return @app.call(env) unless locale
+
+    I18n.with_locale(locale) { @app.call(env) }
+  end
+
+  private
+    def requested_locale(request)
+      locale = request.params[:locale].to_s.presence
+      return if locale.blank?
+      return unless I18n.available_locales.map(&:to_s).include?(locale)
+      locale.to_sym
+    end
+end
+
+Rails.application.config.middleware.insert_after Rack::TempfileReaper, RequestLocaleMiddleware
