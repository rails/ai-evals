@@ -5,7 +5,32 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  # Render every email in the recipient's preferred language. This happens
+  # before the mailer action runs, so subjects and templates both use it.
+  def process(method_name, *args, **kwargs)
+    I18n.with_locale(locale_for_recipient(args, kwargs)) do
+      super
+    end
+  end
+
   private
+    def locale_for_recipient(args, kwargs)
+      candidates = [ kwargs[:user], kwargs[:identity], *args ]
+      identity = candidates.filter_map { |candidate| identity_for(candidate) }.first
+      locale = identity&.locale.presence || Current.locale || I18n.locale || I18n.default_locale
+      locale = I18n.default_locale unless I18n.available_locales.map(&:to_s).include?(locale.to_s)
+      locale
+    end
+
+    def identity_for(candidate)
+      return if candidate.nil?
+      return candidate if candidate.is_a?(Identity)
+      return candidate.identity if candidate.is_a?(User)
+      return candidate.identity if candidate.respond_to?(:identity) && candidate.identity
+      return candidate.user&.identity if candidate.respond_to?(:user)
+      candidate.initiated_by&.identity if candidate.respond_to?(:initiated_by)
+    end
+
     def default_url_options
       if Current.account
         super.merge(script_name: Current.account.slug)
