+
+  def call(env)
+    status, headers, body = @app.call(env)
+    return [ status, headers, body ] unless env["PATH_INFO"].to_s.match?(ERROR_PAGE_PATTERN)
+
+    content = +""
+    body.each { |part| content << part }
+    body.close if body.respond_to?(:close)
+    content.force_encoding(Encoding::UTF_8)
+
+    headers = headers.dup
+    headers["Content-Length"] = content.bytesize.to_s
+    [ status, headers, [ content ] ]
+  end
+end
+
+Rails.application.config.middleware.insert_before(0, StaticErrorPageEncodingMiddleware)
