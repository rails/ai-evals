diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..f38ca60
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,100 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :remember_requested_locale
+    before_action :set_locale
+    after_action :restore_locale
+    helper_method :current_locale
+    etag { Current.locale }
+  end
+
+  private
+    def remember_requested_locale
+      locale = valid_locale(params[:locale])
+      session[:locale] = locale.to_s if locale
+    end
+
+    def set_locale
+      @locale_before_request = I18n.locale
+      requested = valid_locale(params[:locale])
+      stored = valid_locale(session[:locale])
+      preference = valid_locale(session_identity&.locale)
+
+      locale = requested || preference || stored || I18n.default_locale
+
+      Current.locale = locale
+      I18n.locale = locale
+
+      if requested
+        @locale_choice = requested
+        session[:locale] = requested.to_s
+        persist_locale_preference(requested)
+      elsif preference.blank? && stored.present?
+        @locale_choice = stored
+        # Once someone picks a language in this browser session, remember it for
+        # future sign-ins too.
+        persist_locale_preference(stored)
+      end
+    end
+
+    def restore_locale
+      I18n.locale = @locale_before_request || I18n.default_locale
+    end
+
+    def session_identity
+      return Current.identity if Current.identity
+
+      signed_session_id = cookies.signed[:session_token]
+      return unless signed_session_id
+
+      session = Session.find_signed(signed_session_id)
+      Current.session = session if session
+      Current.identity
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def current_locale
+      Current.locale || I18n.locale
+    end
+
+    def chosen_locale
+      @locale_choice
+    end
+
+    def valid_locale(locale)
+      locale = locale.to_s.presence
+      return if locale.blank?
+      return unless I18n.available_locales.map(&:to_s).include?(locale)
+      locale.to_sym
+    end
+
+    def persist_locale_preference(locale)
+      return unless Current.identity
+      return if Current.identity.locale.to_s == locale.to_s
+
+      Current.identity.update_columns(locale: locale.to_s)
+      Current.identity.locale = locale.to_s
+    end
+
+    # Called when a session is first established, so a language chosen while
+    # signed out follows the person after they sign in.
+    def remember_locale(identity)
+      return identity unless identity
+
+      if (locale = chosen_locale)
+        if identity.locale.to_s != locale.to_s
+          identity.update_columns(locale: locale.to_s) if identity.persisted?
+          identity.locale = locale.to_s
+        end
+        session[:locale] = locale.to_s
+        Current.locale = locale
+        I18n.locale = locale
+      elsif (locale = valid_locale(identity.locale))
+        session[:locale] = locale.to_s
+      end
+
+      identity
+    end
+end
