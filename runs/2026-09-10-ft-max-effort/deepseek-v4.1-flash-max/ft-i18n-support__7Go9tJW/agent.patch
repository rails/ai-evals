diff --git a/app/lib/response_translator.rb b/app/lib/response_translator.rb
new file mode 100644
index 0000000..fd90a1e
--- /dev/null
+++ b/app/lib/response_translator.rb
@@ -0,0 +1,69 @@
+class ResponseTranslator
+  TRANSLATABLE_ATTRIBUTES = %w[
+    title placeholder aria-label aria-description alt value
+    data-bridge-description data-bridge-share-description data-bridge-title data-text data-bridge--title-title-value data-turbo-navigation-label-value
+  ].freeze
+
+  class << self
+    def call(html, locale: I18n.locale)
+      return html unless locale.to_s == "ja"
+      return html if html.blank?
+
+      document = parse(html)
+      translate_node(document, locale)
+      document.to_html
+    end
+
+    private
+      def parse(html)
+        if html.match?(/<\s*html[\s>]/i) || html.match?(/<!DOCTYPE/i)
+          Nokogiri::HTML5.parse(html)
+        else
+          Nokogiri::HTML5.fragment(html)
+        end
+      end
+
+      def translate_node(node, locale)
+        return if node.comment? || node.cdata?
+
+        if node.text?
+          translate_text_node(node, locale)
+          return
+        end
+
+        if node.element?
+          return if %w[script style].include?(node.name)
+
+          TRANSLATABLE_ATTRIBUTES.each do |attribute|
+            next unless node.key?(attribute)
+            value = node[attribute]
+            translated = LocaleCatalog.translate(value, locale)
+            node[attribute] = translated if translated != value
+          end
+        end
+
+        node.children.each { |child| translate_node(child, locale) } if node.respond_to?(:children)
+      end
+
+      def translate_text_node(node, locale)
+        return if node.ancestors.any? { |ancestor| %w[script style].include?(ancestor.name) }
+
+        text = node.content
+        return if text.blank? || !text.match?(/[A-Za-z]/)
+
+        translated = with_preserved_whitespace(text) do |content|
+          LocaleCatalog.translate(content, locale)
+        end
+
+        node.content = translated if translated != text
+      end
+
+      def with_preserved_whitespace(text, &block)
+        leading = text[/\A\s*/]
+        trailing = text[/\s*\z/]
+        content = text.strip
+        translated = yield content
+        "#{leading}#{translated}#{trailing}"
+      end
+  end
+end
