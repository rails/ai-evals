+  class << self
+    def translate(text, locale = I18n.locale)
+      return text unless locale.to_s == "ja"
+      return text unless text.is_a?(String)
+      text.empty? ? text : translated_text(text, locale)
+    end
+
+    def translated?(text, locale = I18n.locale)
+      locale.to_s == "ja" && text.is_a?(String) && translate(text, locale) != text
+    end
+
+    private
+      def translated_text(text, locale)
+        PHRASES.fetch(text) do
+          pattern = PATTERNS.find { |regex, _| regex.match?(text) }
+          return text unless pattern
+
+          match = text.match(pattern[0])
+          replacement = pattern[1]
+          if replacement.respond_to?(:call)
+            replacement.call(match, locale)
+          else
+            replacement.gsub(/\\(\d+)/) { match[$1.to_i] }
+          end
+        end
+      end
+  end
