+<%= form_with url: reactions_path_for(reactable), id: dom_id(reactable, :reaction_form), scope: :reaction, class: "reaction__form flex align-center gap-half", hidden: true,
+      data: { reactions_target: "form" } do |form| %>
+  <%= form.label :content, "Add a reaction", class: "reaction__form-label for-screen-reader" %>
+  <%= form.label :content, "Add reaction", class: "for-screen-reader" %>
+  <%= form.label :content, "Reaction", class: "for-screen-reader" %>
+  <%= form.label :content, "Boost", class: "for-screen-reader" %>
+
+  <%= form.text_field :content, class: "reaction__input input", maxlength: 16, autocomplete: "off",
+        placeholder: "Add a reaction", required: true, aria: { label: "Reaction" },
+        data: { reactions_target: "input" } %>
+
+  <div class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+    <button type="button" class="reaction__menu-btn btn" aria-label="Choose an emoji" title="Choose an emoji"
+        data-action="click->dialog#open:stop">
+      <%= icon_tag "reaction" %>
+      <span class="for-screen-reader">Add emoji</span>
+    </button>
+
+    <dialog class="reaction__popup popup" data-dialog-target="dialog">
+      <div class="reaction__emoji-list">
+        <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+          <button type="button" class="btn" aria-label="<%= label %>" title="<%= label %>"
+              data-action="reactions#selectEmoji" data-reactions-emoji-param="<%= emoji %>"><%= emoji %></button>
+        <% end %>
+      </div>
+    </dialog>
+  </div>
+
+  <button type="submit" class="reaction__submit-btn btn" aria-label="Confirm reaction" title="Confirm reaction">
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Confirm</span>
+  </button>
+
+  <button type="button" class="reaction__cancel-btn btn" data-action="reactions#cancel" aria-label="Cancel" title="Cancel">
+    <%= icon_tag "close" %>
+    <span class="for-screen-reader">Cancel</span>
+  </button>
+<% end %>
