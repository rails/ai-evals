@@ -0,0 +1,52 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preloaded.chronologically
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if @reaction.reacter != Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..f4321da
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,66 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def index
+    @reactions = @card.reactions.preloaded.chronologically
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @card.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream { render_reactions_replacement }
+      format.json { render :show, status: :created, location: card_reaction_path(@card, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream { render_reactions_replacement }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reaction
+      @reaction = @card.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if @reaction.reacter != Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions_replacement
+      render turbo_stream: [
+        *reaction_change_streams,
+        turbo_stream.replace([ @card, :card_container ], partial: "cards/container", method: :morph, locals: { card: @card.reload }),
+        turbo_stream.replace([ @card, :reactions ], partial: "cards/reactions/reactions", method: :morph, locals: { reactable: @card })
+      ]
+    end
+
+    def reaction_change_streams
+      if @reaction.persisted?
+        [
+          turbo_stream.append([ @card, :reactions ], partial: "cards/reactions/reaction", locals: { reaction: @reaction }),
+          turbo_stream.append([ @card, :reactions_list ], partial: "cards/reactions/reaction", locals: { reaction: @reaction })
+        ]
+      else
+        [ turbo_stream.remove(@reaction) ]
+      end
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..2712475
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,28 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    case reactable
+    when Card
+      card_reactions_path(reactable)
+    when Comment
+      card_comment_reactions_path(reactable.card, reactable)
+    end
+  end
+
+  def reaction_path_for(reaction)
+    case reaction.reactable
+    when Card
+      card_reaction_path(reaction.reactable, reaction)
+    when Comment
+      card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction)
+    end
+  end
+
+  def reaction_url_for(reaction)
+    case reaction.reactable
+    when Card
+      card_reaction_url(reaction.reactable, reaction)
+    when Comment
+      card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction)
+    end
+  end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..2e9a4d0
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,62 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger", "reaction" ]
+
+  connect() {
+    this.reactionTargets.forEach(reaction => this.#syncReaction(reaction))
+  }
+
+  reactionTargetConnected(reaction) {
+    this.#syncReaction(reaction)
+  }
+
+  compose(event) {
+    event.preventDefault()
+
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.triggerTarget.hidden = true
+
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    if (event) event.preventDefault()
+
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+
+    this.#closeMenu()
+  }
+
+  selectEmoji({ params: { emoji } }) {
+    this.inputTarget.value = emoji
+    this.#closeMenu()
+    this.formTarget.requestSubmit()
+  }
+
+  expand({ currentTarget }) {
+    if (this.#isOwn(currentTarget)) {
+      currentTarget.classList.toggle("expanded")
+    }
+  }
+
+  deleteReaction({ currentTarget }) {
+    currentTarget.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+
+  #syncReaction(reaction) {
+    reaction.classList.toggle("reaction--deleteable", this.#isOwn(reaction))
+  }
+
+  #isOwn(reaction) {
+    return reaction.dataset.reacterId === window.Current?.user?.id
+  }
+
+  #closeMenu() {
+    this.formTarget.querySelector(".reaction__popup[open]")?.close()
+  }
+}
