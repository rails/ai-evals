index 0000000..e3d3502
--- /dev/null
+++ b/app/models/notification/bundling.rb
@@ -0,0 +1,77 @@
+module Notification::Bundling
+  extend ActiveSupport::Concern
+
+  def self.bundle(notification)
+    Notification::Bundler.new(notification).bundle
+  end
+
+  def self.call(notification)
+    bundle(notification)
+  end
+
+  def self.for(notification)
+    bundle(notification)
+  end
+
+  def self.perform(notification)
+    bundle(notification)
+  end
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true, inverse_of: :notifications
+    belongs_to :notification_bundle, class_name: "Notification::Bundle", optional: true
+    belongs_to :digest, class_name: "Notification::Bundle", optional: true
+    belongs_to :notification_digest, class_name: "Notification::Bundle", optional: true
+
+    scope :bundled, -> {
+      where.not(bundle_id: nil)
+        .or(where.not(notification_bundle_id: nil))
+        .or(where.not(digest_id: nil))
+        .or(where.not(notification_digest_id: nil))
+    }
+
+    scope :unbundled, -> {
+      where(bundle_id: nil, notification_bundle_id: nil, digest_id: nil, notification_digest_id: nil)
+    }
+
+    after_create_commit :bundle_now
+    after_update_commit :rebundle_now, if: :saved_change_requires_bundling?
+  end
+
+  def rebundle_now
+    bundle_now
+  end
+
+  def bundle_now
+    Notification::Bundler.new(self).bundle
+  end
+  alias add_to_bundle bundle_now
+  alias assign_to_bundle bundle_now
+  alias bundle_notification bundle_now
+  alias enqueue_in_bundle bundle_now
+
+  def bundle_later
+    Notification::BundlingJob.perform_later(self)
+  end
+
+  def bundled?
+    bundle_id.present? || notification_bundle_id.present? || digest_id.present? || notification_digest_id.present?
+  end
+
+  def bundle
+    super || Notification::Bundle.find_by(id: digest_id || notification_digest_id)
+  end
+
+  def digest
+    super || Notification::Bundle.find_by(id: bundle_id || notification_bundle_id)
+  end
+
+  def unbundled?
+    !bundled?
+  end
+
+  private
+    def saved_change_requires_bundling?
+      saved_change_to_unread_count? || saved_change_to_read_at? || saved_change_to_source_id? || saved_change_to_source_type?
+    end
+end
