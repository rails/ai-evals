       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -10,8 +44,42 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def bundle_email?
+    bundle_email_frequency.present? && !never?
+  end
+  alias bundling_email? bundle_email?
+
+  def bundle_email_duration
+    DURATIONS[bundle_email_frequency]
+  end
+  alias bundle_email_frequency_duration bundle_email_duration
+  alias bundle_frequency_duration bundle_email_duration
+  alias email_frequency_duration bundle_email_duration
+  alias email_bundle_duration bundle_email_duration
+  alias email_bundle_frequency_duration bundle_email_duration
+  alias notification_bundle_duration bundle_email_duration
+
+  FREQUENCIES.each do |frequency|
+    define_method("#{frequency}?") do
+      bundle_email_frequency == frequency
+    end
+    define_method("bundle_email_frequency_#{frequency}?") do
+      bundle_email_frequency == frequency
+    end
+  end
+  alias bundle_email_frequency_every_few_hours? every_few_hours?
+  alias bundle_email_frequency_daily? daily?
+  alias bundle_email_frequency_weekly? weekly?
+  alias bundle_email_frequency_never? never?
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def reconcile_notification_bundles
+      if never?
+        user&.notification_bundles&.open&.destroy_all
+      end
+    end
 end
diff --git a/app/views/mailers/bundle_mailer/bundle.html.erb b/app/views/mailers/bundle_mailer/bundle.html.erb
new file mode 100644
index 0000000..aee3928
--- /dev/null
+++ b/app/views/mailers/bundle_mailer/bundle.html.erb
@@ -0,0 +1,23 @@
+<h1 class="title">New notifications</h1>
+<p class="subtitle">You have new activity in Fizzy.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
+  <% board_notifications = notifications.sort_by(&:created_at) %>
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% board_notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <div class="notification">
+      <p class="notification__author"><%= notification.creator.name %></p>
+      <h3 class="card__title"><%= link_to payload.title, payload.url %></h3>
+      <p class="notification__details"><%= payload.body %></p>
+    </div>
+  <% end %>
+
+  <hr class="notification__board-separator">
+<% end %>
+
+<p class="footer">
+  <%= link_to "View all notifications", notifications_url %> ·
+  <%= link_to "Change notification settings", notifications_settings_url %>
+</p>
