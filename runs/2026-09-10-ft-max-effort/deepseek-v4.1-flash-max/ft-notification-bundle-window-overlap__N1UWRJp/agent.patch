diff --git a/app/views/notifications/settings/_email.html.erb b/app/views/notifications/settings/_email.html.erb
new file mode 100644
index 0000000..6ca64c2
--- /dev/null
+++ b/app/views/notifications/settings/_email.html.erb
@@ -0,0 +1,33 @@
+<section class="settings__section">
+  <h2 class="divider">Email notifications</h2>
+
+  <%= form_with model: settings, url: notifications_settings_path, method: :patch, scope: :settings do |form| %>
+    <div class="flex flex-column gap-half txt-small margin-block-start-half">
+      <label class="flex align-center gap">
+        <%= form.radio_button :bundle_email_frequency, "never" %>
+        <span>Off (Never)</span>
+      </label>
+
+      <label class="flex align-center gap">
+        <%= form.radio_button :bundle_email_frequency, "every_few_hours" %>
+        <span>Every few hours (every four hours)</span>
+      </label>
+
+      <label class="flex align-center gap">
+        <%= form.radio_button :bundle_email_frequency, "daily" %>
+        <span>Daily</span>
+      </label>
+
+      <label class="flex align-center gap">
+        <%= form.radio_button :bundle_email_frequency, "weekly" %>
+        <span>Weekly</span>
+      </label>
+    </div>
+
+    <p class="txt-x-small txt-tinted margin-block-start-half">
+      We'll bundle your notifications and email them according to the schedule above.
+    </p>
+
+    <%= form.submit "Save", class: "btn btn--reversed txt-small margin-block-start-half" %>
+  <% end %>
+</section>
