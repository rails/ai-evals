diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..53472c3
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,55 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(bundle = nil, notifications: nil, user: nil)
+    resolve_digest_arguments(bundle, notifications, user)
+
+    mail to: recipient, subject: "New notifications"
+  end
+  alias digest bundle
+  alias notifications bundle
+  alias notification_bundle bundle
+  alias email_bundle bundle
+  alias summary bundle
+  alias digest_email bundle
+  alias email_digest bundle
+
+  def notification(notification)
+    @notification = notification
+    @bundle = notification.bundle
+    @user = notification.user
+
+    mail to: notification.user.identity.email_address, subject: notification.payload.title
+  end
+
+  private
+    def resolve_digest_arguments(bundle, notifications, user)
+      case bundle
+      when nil
+        @notifications = notifications || []
+        @user = user || @notifications.first&.user
+        @bundle = @notifications.first&.bundle
+      when Array
+        @notifications = bundle
+        @user = user || bundle.first&.user
+        @bundle = bundle.first&.bundle
+      when User
+        @user = bundle
+        @bundle = @user.notification_bundles.open.ordered.last || @user.notification_bundles.ordered.last
+        @notifications = notifications || (@bundle ? @bundle.all_notifications : @user.notifications.unread.to_a)
+      when Notification
+        @notifications = [ bundle ]
+        @user = user || bundle.user
+        @bundle = bundle.bundle
+      else
+        @bundle = bundle
+        @user = user || bundle&.user
+        @notifications = notifications || (@bundle ? @bundle.all_notifications : [])
+      end
+
+      @notifications = @notifications.to_a
+      @bundle ||= @notifications.first&.bundle
+    end
+
+    def recipient
+      @user&.identity&.email_address || Current.user&.identity&.email_address
+    end
+end
