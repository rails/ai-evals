 class User::Settings < ApplicationRecord
+  FREQUENCIES = %w[ never every_few_hours daily weekly ].freeze
+  BUNDLE_EMAIL_FREQUENCIES = FREQUENCIES
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+  BUNDLE_EMAIL_FREQUENCY_DURATIONS = DURATIONS
+
+  LABELS = {
+    "never" => "Off",
+    "every_few_hours" => "Every few hours (every four hours)",
+    "daily" => "Daily",
+    "weekly" => "Weekly"
+  }.freeze
+
+  class << self
+    def bundle_email_frequency_durations
+      DURATIONS
+    end
+
+    def bundle_email_frequency_options
+      FREQUENCIES.map { |frequency| [ LABELS[frequency], frequency ] }
+    end
+
+    def bundle_email_frequencies
+      FREQUENCIES
+    end
+  end
+
   belongs_to :account, default: -> { user.account }
   belongs_to :user
 
+  enum :bundle_email_frequency, FREQUENCIES.index_by(&:itself), default: :never
+
+  after_update_commit :reconcile_notification_bundles, if: :saved_change_to_bundle_email_frequency?
+
   def timezone
