+  # Finds cards whose title, description, or comment bodies contain every word
+  # in the given term. EXISTS subqueries keep a single row per card even when
+  # many comments match.
+  scope :search, ->(term) do
+    if term.present?
+      condition = <<~SQL.squish
+        cards.title LIKE :pattern ESCAPE '!'
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts AS card_rich_texts
+          WHERE card_rich_texts.record_type = :card_type
+            AND card_rich_texts.record_id = cards.id
+            AND card_rich_texts.name = :description_name
+            AND card_rich_texts.body LIKE :pattern ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments AS searchable_comments
+          INNER JOIN action_text_rich_texts AS comment_rich_texts
+            ON comment_rich_texts.record_type = :comment_type
+              AND comment_rich_texts.record_id = searchable_comments.id
+              AND comment_rich_texts.name = :body_name
+          WHERE searchable_comments.card_id = cards.id
+            AND comment_rich_texts.body LIKE :pattern ESCAPE '!'
+        )
+      SQL
+
+      term.to_s.scan(/\S+/).reduce(self) do |relation, word|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(word, "!")}%"
+        relation.where(condition, pattern: pattern, card_type: "Card", description_name: "description", comment_type: "Comment", body_name: "body")
+      end
+    else
+      none
+    end
+  end
+
