@@ -0,0 +1,15 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from search_results
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards
+        .published
+        .search(@query)
+        .reverse_chronologically
+        .preload(:board, :column, :closure, :goldness, :not_now, :rich_text_description, comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..8543d6a
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,47 @@
+module SearchesHelper
+  def search_highlight(text, query)
+    if phrases = search_phrases(query).presence
+      highlight(text.to_s, phrases)
+    else
+      text.to_s
+    end
+  end
+
+  def search_excerpt(card, query)
+    if match = matching_search_match(card, query)
+      {
+        html: search_highlight(excerpt(match[:text], match[:phrase], radius: 160), query),
+        class: match[:class]
+      }
+    end
+  end
+
+  private
+    def matching_search_match(card, query)
+      description = card.description.to_plain_text
+      if phrase = matching_phrase(description, query)
+        { text: description, phrase: phrase, class: "card__description" }
+      else
+        matching_comment_match(card, query)
+      end
+    end
+
+    def matching_comment_match(card, query)
+      card.comments.each do |comment|
+        body = comment.body.to_plain_text
+        if phrase = matching_phrase(body, query)
+          return { text: body, phrase: phrase, class: "comment comment__body" }
+        end
+      end
+
+      nil
+    end
+
+    def matching_phrase(text, query)
+      search_phrases(query).find { |phrase| text.downcase.include?(phrase.downcase) }
+    end
+
+    def search_phrases(query)
+      query.to_s.scan(/\S+/)
+    end
+end
