     case index
     when "stalled" then stalled
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..dd3b88e
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,30 @@
+<%= card_article_tag card, class: "card search-result", data: { navigable_list_target: "item" } do %>
+  <div class="flex flex-column flex-item-grow max-inline-size">
+    <header class="card__header">
+      <div class="card__board">
+        <div class="card__id">
+          <span class="for-screen-reader">Card number</span>
+          <%= card.number %>
+        </div>
+
+        <div class="card__board-name">
+          <span class="overflow-ellipsis"><%= link_to card.board.name, board_path(card.board) %></span>
+        </div>
+      </div>
+    </header>
+
+    <div class="card__body justify-space-between">
+      <div class="card__content">
+        <h3 class="card__title overflow-line-clamp">
+          <%= link_to card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } do %>
+            <%= search_highlight(card.title, query) %>
+          <% end %>
+        </h3>
+
+        <% if excerpt = search_excerpt(card, query) %>
+          <p class="search-result__excerpt <%= excerpt[:class] %>"><%= excerpt[:html] %></p>
+        <% end %>
+      </div>
+    </div>
+  </div>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..9ac440f
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide center margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap-half" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards by title, description, or comments…",
+          class: "input full-width", autofocus: true, autocorrect: "off", autocomplete: "off", data: { "1p-ignore": "true" } %>
+    <%= form.button class: "btn btn--reversed", type: "submit" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="panel panel--wide center margin pad">
+    <% if @page.records.any? %>
+      <p class="txt-small txt-subtle margin-none-block-start">
+        <%= pluralize @page.recordset.records_count, "card" %> found
+      </p>
+
+      <section class="cards cards--grid">
+        <div class="cards__list hide-scrollbar">
+          <%= with_automatic_pagination :search_paginated_container, @page do %>
+            <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { query: @query } %>
+          <% end %>
+        </div>
+      </section>
+    <% else %>
+      <div class="blank-slate center">No cards match “<%= @query %>”</div>
+    <% end %>
+  </section>
+<% end %>
