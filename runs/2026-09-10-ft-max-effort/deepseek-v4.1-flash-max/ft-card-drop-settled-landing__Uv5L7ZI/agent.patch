--- a/app/controllers/cards/columns_controller.rb
+++ b/app/controllers/cards/columns_controller.rb
@@ -1,8 +1,58 @@
 class Cards::ColumnsController < ApplicationController
   def edit
-    @card = Current.user.accessible_cards.find_by!(number: params[:card_id])
+    @card = find_card
     @columns = @card.board.columns.sorted
 
     fresh_when etag: [ @card, @columns ]
   end
+
+  def update
+    @card = find_card
+    move_card
+
+    respond_to do |format|
+      format.html { redirect_to @card }
+      format.turbo_stream { head :no_content }
+      format.json { render "cards/show" }
+    end
+  end
+
+  private
+    def find_card
+      Current.user.accessible_cards.find_by!(number: params[:card_id])
+    end
+
+    def move_card
+      case status
+      when "maybe", "triage"
+        @card.send_back_to_triage
+      when "not_now", "postponed"
+        @card.postpone
+      when "done", "closed"
+        @card.close
+      else
+        move_card_to_column
+      end
+    end
+
+    def status
+      params[:status].presence || params[:indexed_by].presence
+    end
+
+    def move_card_to_column
+      if column_id.present?
+        @card.triage_into @card.board.columns.find(column_id)
+      else
+        @card.send_back_to_triage
+      end
+    end
+
+    def column_id
+      params[:column_id].presence || nested_column_id
+    end
+
+    def nested_column_id
+      card = params[:card]
+      card[:column_id].presence if card.is_a?(ActionController::Parameters)
+    end
 end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..fb8849c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,273 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "item" ]
+
+  connect() {
+    this.draggedItem = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = this.#dragEnabled
+  }
+
+  dragStart(event) {
+    if (!this.#dragEnabled) return
+
+    const item = this.#itemFrom(event)
+    if (!item) return
+
+    this.draggedItem = item
+    this.sourceColumn = this.#columnFor(item)
+    item.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.#trackColumn(event)
+  }
+
+  dragOver(event) {
+    this.#trackColumn(event, { preventDefault: true })
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFor(event.target)
+    if (!column || !this.draggedItem) return
+
+    const entered = event.relatedTarget || document.elementFromPoint(event.clientX, event.clientY)
+    if (!entered || !column.contains(entered)) {
+      this.#unhighlight(column)
+    }
+  }
+
+  drop(event) {
+    const column = this.#columnFor(event.target)
+    if (!column || !this.draggedItem) return
+
+    event.preventDefault()
+    this.#unhighlight()
+
+    const item = this.draggedItem
+    const sourceColumn = this.sourceColumn
+
+    if (column !== sourceColumn) {
+      item.classList.remove(DRAGGED_ITEM_CLASS)
+
+      if (this.#move(item, column)) {
+        this.#save(item, column, sourceColumn)
+      }
+    }
+  }
+
+  dragEnd(event) {
+    const item = this.#itemFrom(event) || this.draggedItem
+    item?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#unhighlight()
+
+    this.draggedItem = null
+    this.sourceColumn = null
+  }
+
+  // Private
+
+  #trackColumn(event, { preventDefault = false } = {}) {
+    if (!this.draggedItem) return
+
+    const column = this.#columnFor(event.target)
+    if (!column) {
+      this.#unhighlight()
+      return
+    }
+
+    if (column === this.sourceColumn) {
+      this.#unhighlight()
+      return
+    }
+
+    if (preventDefault) event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(column)
+  }
+
+  #highlight(column) {
+    if (this.hoveredColumn === column) return
+
+    this.#unhighlight()
+    column.classList.add(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = column
+  }
+
+  #unhighlight(column = this.hoveredColumn) {
+    column?.classList.remove(HOVER_CONTAINER_CLASS)
+
+    if (this.hoveredColumn === column) {
+      this.hoveredColumn = null
+    }
+  }
+
+  #move(item, column) {
+    this.#insert(item, this.#listFor(column), column)
+    this.#syncCardColor(item, column)
+    this.#syncHeaderColumnName(item, column)
+    this.#syncColumnStages(item, column)
+
+    return true
+  }
+
+  #listFor(column) {
+    return column.querySelector(".cards__list") || this.#createTemporaryList(column)
+  }
+
+  #createTemporaryList(column) {
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    list.dataset.dragAndDropTemporaryList = "true"
+
+    const container = column.querySelector(".cards__transition-container") || column
+    container.appendChild(list)
+
+    container.addEventListener("turbo:frame-load", () => {
+      const loadedList = column.querySelector(".cards__list:not([data-drag-and-drop-temporary-list])")
+
+      if (loadedList) {
+        Array.from(list.querySelectorAll(".card")).forEach(card => {
+          loadedList.querySelector(`[id="${card.id}"]`)?.remove()
+          loadedList.prepend(card)
+        })
+      }
+
+      list.remove()
+    }, { once: true })
+
+    return list
+  }
+
+  #insert(item, list, column) {
+    if (this.#sortedByLatestActivity(column) && !item.classList.contains("golden-effect")) {
+      const goldenCards = Array.from(list.querySelectorAll(".card.golden-effect"))
+      const lastGoldenCard = goldenCards[goldenCards.length - 1]
+
+      if (lastGoldenCard) {
+        lastGoldenCard.after(item)
+        return
+      }
+    }
+
+    list.prepend(item)
+  }
+
+  #sortedByLatestActivity(column) {
+    const destination = column.dataset.dragAndDropDestination
+    return destination === "maybe" || destination === "column"
+  }
+
+  #syncCardColor(item, column) {
+    const color = column.style.getPropertyValue("--card-color").trim()
+
+    if (color) {
+      item.style.setProperty("--card-color", color)
+    } else {
+      item.style.removeProperty("--card-color")
+    }
+  }
+
+  #syncHeaderColumnName(item, column) {
+    const chip = item.querySelector(".card__header .card__column-name--current")
+
+    if (this.#isWorkflowColumn(column)) {
+      const name = column.dataset.columnName
+
+      if (chip) {
+        chip.querySelector("span").textContent = name
+      } else {
+        item.querySelector(".card__header")?.appendChild(this.#columnNameChip(name))
+      }
+    } else {
+      chip?.remove()
+    }
+  }
+
+  #syncColumnStages(item, column) {
+    const stages = item.querySelector(".card__stages")
+    if (!stages || column.dataset.dragAndDropDestination === "done") return
+
+    stages.querySelectorAll(".card__column-name--current").forEach(span => span.classList.remove("card__column-name--current"))
+
+    if (this.#isWorkflowColumn(column)) {
+      const columnId = column.dataset.dragAndDropColumnId
+      const stage = Array.from(stages.querySelectorAll("[data-column-id]")).find(span => span.dataset.columnId === columnId)
+      stage?.classList.add("card__column-name--current")
+    }
+  }
+
+  #isWorkflowColumn(column) {
+    return column.dataset.dragAndDropDestination === "column"
+  }
+
+  #columnNameChip(name) {
+    const chip = document.createElement("span")
+    chip.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+
+    const text = document.createElement("span")
+    text.className = "overflow-ellipsis"
+    text.textContent = name
+
+    chip.appendChild(text)
+    return chip
+  }
+
+  #itemFrom(event) {
+    return event.target?.closest?.('[data-drag-and-drop-target~="item"]') || null
+  }
+
+  get #dragEnabled() {
+    return window.matchMedia("(min-width: 640px)").matches
+  }
+
+  #columnFor(element) {
+    return element?.closest?.(".cards") || null
+  }
+
+  async #save(item, column, sourceColumn) {
+    try {
+      const response = await this.#requestFor(item, column).perform()
+      if (!response.ok) throw new Error("Failed to save card move: " + response.statusCode)
+    } catch {
+      this.#restore(item, sourceColumn)
+    }
+  }
+
+  #requestFor(item, column) {
+    switch (column.dataset.dragAndDropDestination) {
+      case "maybe":
+        return new FetchRequest("DELETE", item.dataset.cardTriageUrl, { responseKind: "json" })
+      case "not_now":
+        return new FetchRequest("POST", item.dataset.cardNotNowUrl, { responseKind: "json" })
+      case "done":
+        return new FetchRequest("POST", item.dataset.cardClosureUrl, { responseKind: "json" })
+      default:
+        return new FetchRequest("POST", item.dataset.cardTriageUrl, {
+          body: { column_id: column.dataset.dragAndDropColumnId },
+          responseKind: "json"
+        })
+    }
+  }
+
+  #restore(item, column) {
+    const list = column?.querySelector(".cards__list")
+    if (list && this.element.contains(column)) {
+      this.#insert(item, list, column)
+    }
+  }
+}
