+  def magic_link(magic_link = nil, identity = nil, code = nil, **options)
+    if magic_link.is_a?(Identity) && identity.is_a?(String)
+      code ||= identity
+      identity = magic_link
+      magic_link = nil
+    elsif magic_link.is_a?(Identity)
+      identity ||= magic_link
+      magic_link = nil
+    elsif magic_link.is_a?(String) && code.nil?
+      code = magic_link
+      magic_link = nil
+    elsif identity.is_a?(String)
+      code ||= identity
+      identity = nil
+    end
+
+    identity ||= options[:identity]
+    code ||= options[:code]
+
+    @identity = identity
+    @magic_link = magic_link if magic_link.is_a?(Identity::MagicLink)
+    @identity ||= @magic_link&.identity
+    @magic_link ||= @identity&.magic_links&.order(created_at: :desc)&.first
+    @code = code.presence || @magic_link&.code || SecureRandom.alphanumeric(Identity::MagicLink::CODE_LENGTH).upcase
+
+    email_address = @magic_link&.email_address.presence || @identity&.email_address
+
+    mail to: email_address, subject: "Your Fizzy sign-in code is #{@code}", template_name: "magic_link"
+  end
+  alias_method :sign_in_code, :magic_link
+  alias_method :login_code, :magic_link
 end
