+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,68 @@
+class Sessions::MagicLinksController < ApplicationController
+  include MagicLinkAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @magic_link = find_pending_magic_link
+
+    if @magic_link&.available?
+      render_code_form
+    else
+      redirect_to new_session_path, alert: "That code has expired. Please request a new one."
+    end
+  end
+
+  def create
+    @magic_link = find_pending_magic_link
+    code = submitted_code
+
+    if @magic_link&.available? && @magic_link.verify(code)
+      start_new_session_for @magic_link.identity
+      cookies.delete(:pending_authentication_token)
+      destination = after_magic_link_authentication_url(@magic_link)
+
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def render_code_form
+      render :new
+    end
+
+    def submitted_code
+      params[:code].presence ||
+        params.dig(:magic_link, :code).presence ||
+        params.dig(:session, :code).presence ||
+        params.dig(:signup, :code).presence ||
+        params.dig(:join, :code).presence
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
