+# Join- and signup-specific magic link route names all point at the shared,
+# account-less code entry screen. Force the canonical path so generated URLs
+# stay consistent with the redirects the application makes.
+module MagicLinkRouteHelpers
+def new_session_magic_link_path(*args, **options, &block)
+  super(*args, **options.merge(script_name: nil), &block)
+end
+
+def session_magic_link_path(*args, **options, &block)
+  super(*args, **options.merge(script_name: nil), &block)
+end
+
+def new_session_start_path(*args, **options, &block)
+  super(*args, **options.merge(script_name: nil), &block)
+end
+
+def session_start_path(*args, **options, &block)
+  super(*args, **options.merge(script_name: nil), &block)
+end
+
+  def new_join_magic_link_path(*args, **options, &block)
+    super(*args, **options.except(:code).merge(script_name: nil), &block)
+  end
+
+  def join_magic_link_path(*args, **options, &block)
+    super(*args, **options.except(:code).merge(script_name: nil), &block)
+  end
+
+  def new_join_code_magic_link_path(*args, **options, &block)
+    super(*args, **options.except(:code).merge(script_name: nil), &block)
+  end
+
+  def join_code_magic_link_path(*args, **options, &block)
+    super(*args, **options.except(:code).merge(script_name: nil), &block)
+  end
+
+  def new_signup_magic_link_path(*args, **options, &block)
+    super(*args, **options.merge(script_name: nil), &block)
+  end
+
+  def signup_magic_link_path(*args, **options, &block)
+    super(*args, **options.merge(script_name: nil), &block)
+  end
+end
+
+Rails.application.routes.url_helpers.prepend(MagicLinkRouteHelpers)
