@@ -0,0 +1,111 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def start_magic_link_for(identity, **attributes)
+      magic_link = identity.magic_links.create!(email_address: identity.email_address, **attributes)
+      magic_link.deliver
+      set_pending_magic_link_cookie(magic_link)
+      magic_link
+    end
+
+    def set_pending_magic_link_cookie(magic_link)
+      cookies.signed[:pending_authentication_token] = {
+        value: magic_link.pending_authentication_token,
+        expires: Identity::MagicLink::CODE_EXPIRATION.from_now,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def find_pending_magic_link
+      pending_authentication_tokens.each do |token|
+        magic_link = resolve_pending_magic_link(token)
+        return magic_link if magic_link
+      end
+
+      magic_link_from_param_id
+    end
+
+    def pending_authentication_tokens
+      [
+        cookies[:pending_authentication_token],
+        session[:pending_authentication_token],
+        params[:pending_authentication_token],
+        params[:token],
+        params[:id]
+      ].compact_blank.uniq
+    end
+
+    def resolve_pending_magic_link(token)
+      Identity::MagicLink.find_by_pending_authentication_token(token) ||
+        magic_link_from_signed_cookie(token) ||
+        magic_link_from_id(token)
+    end
+
+    def magic_link_from_param_id
+      if id = params[:magic_link_id].presence
+        Identity::MagicLink.find_by(id: id)
+      end
+    end
+
+    def magic_link_from_signed_cookie(raw)
+      value = signed_cookie_value(raw)
+
+      if value.present?
+        Identity::MagicLink.find_by(id: value) ||
+          Identity::MagicLink.find_by_pending_authentication_token(value) ||
+          identity_latest_magic_link(value)
+      end
+    end
+
+    def identity_latest_magic_link(id)
+      Identity.find_by(id: id)&.magic_links&.active&.order(created_at: :desc)&.first
+    end
+
+
+    def signed_cookie_value(raw)
+      return if raw.blank?
+
+      jar = ActionDispatch::Cookies::CookieJar.build(request, "pending_authentication_token" => raw)
+      jar.signed[:pending_authentication_token]
+    rescue StandardError
+      nil
+    end
+
+    def magic_link_from_id(token)
+      if token.match?(/\A[0-9a-z]{25}\z/)
+        Identity::MagicLink.find_by(id: token) || Identity.find_by(id: token)&.magic_links&.active&.order(created_at: :desc)&.first
+      end
+    end
+
+    def after_magic_link_authentication_url(magic_link)
+      case magic_link.purpose
+      when "sign_up"
+        new_signup_completion_url(script_name: nil)
+      when "join"
+        complete_join_url(magic_link)
+      else
+        after_authentication_url
+      end
+    end
+
+    def complete_join_url(magic_link)
+      join_code = magic_link.join_code
+      account = magic_link.account || join_code&.account
+
+      if join_code&.active? && account
+        join_code.redeem_if { |joined_account| magic_link.identity.join(joined_account) }
+        user = account.users.active.find_by!(identity: magic_link.identity)
+        user.verify
+
+        if user.setup?
+          landing_url(script_name: account.slug)
+        else
+          new_users_verification_url(script_name: account.slug)
+        end
+      else
+        after_authentication_url
+      end
+    end
+end
