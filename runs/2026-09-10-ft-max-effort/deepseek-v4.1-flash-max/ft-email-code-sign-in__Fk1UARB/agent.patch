diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..751cfe7
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,228 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+    @identity = identities(:kevin)
+  end
+
+  test "join magic link helper points at the shared screen" do
+    assert_equal "/session/magic_link/new", new_join_magic_link_path(code: "ABC123", script_name: nil)
+    assert_equal "/session/magic_link", join_magic_link_path(code: "ABC123", script_name: nil)
+    assert_equal "/session/magic_link/new", new_join_magic_link_path(code: "ABC123", script_name: "/897362094")
+  end
+
+  test "requesting a code emails a six-character code" do
+    assert_enqueued_emails 1 do
+      untenanted do
+        post session_path, params: { email_address: @identity.email_address }
+        assert_redirected_to new_session_magic_link_path
+      end
+    end
+
+    assert cookies[:pending_authentication_token].present?
+
+    perform_enqueued_jobs
+    mail = ActionMailer::Base.deliveries.last
+
+    assert_equal @identity.email_address, mail.to.first
+    assert_match(/\b[A-Z0-9]{6}\b/, mail.subject)
+    assert_equal 6, code_from(mail).length
+  end
+
+  test "new renders the code form" do
+    request_code
+
+    assert_response :redirect
+
+    untenanted do
+      get new_session_magic_link_path
+      assert_response :success
+      assert_select "input[name=code]"
+    end
+  end
+
+  test "submitting a valid code signs in" do
+    code = request_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "submitting a wrong code does not sign in" do
+    request_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a code expires after fifteen minutes" do
+    code = request_code
+
+    travel 16.minutes do
+      untenanted do
+        post session_magic_link_path, params: { code: code }
+
+        assert_redirected_to new_session_magic_link_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "submitting a valid code via JSON returns a session token" do
+    code = request_code
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "requesting a code via JSON returns a pending authentication token" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+
+      assert_response :created
+      assert @response.parsed_body["pending_authentication_token"].present?
+      assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+    end
+  end
+
+  test "signing up with an email leads to completion after the code" do
+    signup_email = "new-signup@example.com"
+
+    assert_difference -> { Identity.count }, 1 do
+      untenanted do
+        post signup_path, params: { signup: { email_address: signup_email } }
+        assert_redirected_to new_session_magic_link_path
+        assert_redirected_to new_signup_magic_link_path
+      end
+    end
+
+    code = last_code
+    assert_equal signup_email, ActionMailer::Base.deliveries.last.to.first
+
+    untenanted do
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "joining with a join code joins the account after the code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email = "new-joiner@example.com"
+
+    assert_difference -> { Identity.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email }
+      assert_redirected_to new_session_magic_link_path(script_name: nil)
+      assert_redirected_to new_join_magic_link_path(code: join_code.code, script_name: account.slug)
+    end
+
+    identity = Identity.find_by!(email_address: email)
+    code = last_code
+
+    post session_magic_link_path(script_name: nil), params: { code: code }
+
+    assert identity.users.exists?(account: account)
+    assert_equal 1, join_code.reload.usage_count
+    assert_response :redirect
+    assert cookies[:session_token].present?
+  end
+
+  test "opening a sign-in link signs in from the start screen" do
+    request_code
+    token = cookies[:pending_authentication_token]
+
+    cookies.delete :pending_authentication_token
+
+    untenanted do
+      get new_session_start_path(token: token)
+      assert_response :success
+
+      post session_start_path
+    end
+
+    assert_redirected_to landing_path(script_name: nil)
+    assert cookies[:session_token].present?
+  end
+
+  private
+    def request_code
+      perform_enqueued_jobs do
+        untenanted do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+      end
+
+      code_from(ActionMailer::Base.deliveries.last)
+    end
+
+    def last_code
+      perform_enqueued_jobs
+      code_from(ActionMailer::Base.deliveries.last)
+    end
+
+    def code_from(mail)
+      mail.subject[/\b([A-Z0-9]{6})\b/, 1]
+    end
+end
