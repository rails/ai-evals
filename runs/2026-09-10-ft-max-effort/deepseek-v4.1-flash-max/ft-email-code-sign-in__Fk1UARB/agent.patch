+class Sessions::StartsController < ApplicationController
+  include MagicLinkAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+
+  layout "public"
+
+  def new
+    @magic_link = find_pending_magic_link
+
+    if @magic_link&.available?
+      set_pending_magic_link_cookie(@magic_link)
+    else
+      redirect_to new_session_path, alert: "That sign-in link has expired. Please request a new code."
+    end
+  end
+
+  def create
+    @magic_link = find_pending_magic_link
+
+    if @magic_link&.available?
+      @magic_link.use!
+      start_new_session_for @magic_link.identity
+      cookies.delete(:pending_authentication_token)
+      redirect_to after_magic_link_authentication_url(@magic_link)
+    else
+      redirect_to new_session_path, alert: "That sign-in link has expired. Please request a new code."
+    end
+  end
+end
