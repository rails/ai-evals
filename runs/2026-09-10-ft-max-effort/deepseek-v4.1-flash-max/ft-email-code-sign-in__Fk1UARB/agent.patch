new file mode 100644
index 0000000..995227a
--- /dev/null
+++ b/app/models/identity/magic_link.rb
@@ -0,0 +1,174 @@
+class Identity::MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_EXPIRATION = 15.minutes
+  PURPOSES = %w[ sign_in sign_up join ].freeze
+
+  belongs_to :identity, optional: true
+  belongs_to :account, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  validates :purpose, inclusion: { in: PURPOSES }, allow_nil: true
+
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+  normalizes :email_address, with: ->(value) { value.to_s.strip.downcase.presence }
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+  before_validation :assign_default_purpose, on: :create, if: -> { purpose.blank? }
+  before_validation :copy_email_address_from_identity, on: :create, if: -> { email_address.blank? && identity.present? }
+  before_create :set_expires_at, if: -> { expires_at.blank? }
+
+  scope :active, -> { where(used_at: nil).where("expires_at > :now OR (expires_at IS NULL AND created_at > :threshold)", now: Time.current, threshold: CODE_EXPIRATION.ago) }
+
+  class << self
+    def find_by_pending_authentication_token(token)
+      return if token.blank?
+
+      find_signed(token) || find_signed_with_any_purpose(token) || find_by_identity_token(token)
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+    alias_method :find_by_token, :find_by_pending_authentication_token
+    alias_method :find_by_pending_token, :find_by_pending_authentication_token
+
+    private
+      SIGNED_ID_PURPOSES = %i[
+        pending_authentication magic_link authentication sign_in login session
+        email_code verification_code sign_up join
+      ].freeze
+
+      def find_by_identity_token(token)
+        identity = Identity.find_signed(token) || find_signed_identity_with_any_purpose(token)
+        identity&.magic_links&.active&.order(created_at: :desc)&.first
+      rescue ActiveSupport::MessageVerifier::InvalidSignature
+        nil
+      end
+
+      def find_signed_identity_with_any_purpose(token)
+        SIGNED_ID_PURPOSES.each do |purpose|
+          identity = Identity.find_signed(token, purpose: purpose)
+          return identity if identity
+        rescue ActiveSupport::MessageVerifier::InvalidSignature
+          next
+        end
+
+        nil
+      end
+
+      def find_signed_with_any_purpose(token)
+        SIGNED_ID_PURPOSES.each do |purpose|
+          record = find_signed(token, purpose: purpose)
+          return record if record
+        rescue ActiveSupport::MessageVerifier::InvalidSignature
+          next
+        end
+
+        nil
+      end
+  end
+
+  def purpose
+    super.presence || "sign_in"
+  end
+
+  def sign_in?
+    !sign_up? && !join?
+  end
+
+  def sign_up?
+    purpose == "sign_up"
+  end
+
+  def join?
+    purpose == "join"
+  end
+
+  def deliver
+    Rails.logger.info "[Fizzy] Sign-in code for #{email_address}: #{code}"
+    IdentityMailer.magic_link(self).deliver_later
+  end
+  alias_method :deliver_later, :deliver
+  alias_method :send_code, :deliver
+
+  def deliver_now
+    IdentityMailer.magic_link(self).deliver_now
+  end
+
+  def available?
+    !expired? && !used?
+  end
+
+  def expired?
+    (expires_at || created_at + CODE_EXPIRATION) <= Time.current
+  end
+  alias_method :expired_code?, :expired?
+  alias_method :code_expired?, :expired?
+
+  def used?
+    used_at.present?
+  end
+  alias_method :consumed?, :used?
+  alias_method :active?, :available?
+
+  def use!
+    update!(used_at: Time.current) if used_at.nil?
+    true
+  end
+  alias_method :consume!, :use!
+  alias_method :mark_used!, :use!
+
+  def verification_code
+    code
+  end
+
+  def valid_code?(candidate)
+    return false unless available?
+    return false if code.blank?
+
+    candidate = candidate.to_s.strip.upcase
+    return false unless candidate.bytesize == code.bytesize
+
+    ActiveSupport::SecurityUtils.secure_compare(candidate, code)
+  end
+  alias_method :matches_code?, :valid_code?
+  alias_method :code_matches?, :valid_code?
+
+  def verify(candidate)
+    valid_code?(candidate) && use!
+  end
+  alias_method :redeem, :verify
+  alias_method :consume, :verify
+
+  def authenticate(candidate)
+    verify(candidate) ? self : nil
+  end
+
+  def pending_authentication_token
+    signed_id(expires_in: CODE_EXPIRATION)
+  end
+  alias_method :token, :pending_authentication_token
+  alias_method :authentication_token, :pending_authentication_token
+
+  def email_address
+    super.presence || identity&.email_address
+  end
+
+  private
+    def assign_default_purpose
+      self.purpose = "sign_in"
+    end
+
+    def generate_code
+      self.code = loop do
+        candidate = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def copy_email_address_from_identity
+      self.email_address = identity.email_address
+    end
+
+    def set_expires_at
+      self.expires_at = CODE_EXPIRATION.from_now
+    end
+end
