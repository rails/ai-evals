@@ -0,0 +1,31 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      Current.user.accessible_events
+        .timelineable
+        .reverse_chronologically
+        .preloaded
+        .then { |relation| filter_by_creator(relation) }
+        .then { |relation| filter_by_board(relation) }
+    end
+
+    def filter_by_creator(relation)
+      creator_ids.any? ? relation.where(creator_id: creator_ids) : relation
+    end
+
+    def filter_by_board(relation)
+      board_ids.any? ? relation.where(board_id: board_ids) : relation
+    end
+
+    def creator_ids
+      @creator_ids ||= Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      @board_ids ||= Array(params[:board_ids]).compact_blank
+    end
+end
