diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..4f459be
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,45 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Matches cards whose title, description, or any comment body contains every
+    # term in the query. Returns a relation so callers can scope it to the cards
+    # a user can access.
+    scope :searching, ->(query) do
+      terms = query.to_s.split
+
+      if terms.any?
+        terms.reduce(published) { |cards, term| cards.matching(term) }
+      else
+        none
+      end
+    end
+
+    scope :search, ->(query) { searching(query).reverse_chronologically }
+
+    scope :matching, ->(term) do
+      escaped_term = term.to_s.gsub(/[!%_]/) { |character| "!#{character}" }
+      pattern = "%#{escaped_term}%"
+
+      where(<<~SQL.squish, pattern: pattern)
+        cards.title LIKE :pattern ESCAPE '!'
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Card'
+            AND action_text_rich_texts.record_id = cards.id
+            AND action_text_rich_texts.name = 'description'
+            AND action_text_rich_texts.body LIKE :pattern ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts AS comment_rich_texts
+            ON comment_rich_texts.record_type = 'Comment'
+            AND comment_rich_texts.record_id = comments.id
+            AND comment_rich_texts.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comment_rich_texts.body LIKE :pattern ESCAPE '!'
+        )
+      SQL
+    end
+  end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..008dbe5
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,32 @@
+<article id="<%= dom_id(card, :article) %>" class="card card--search-result search-result search-results__item" data-id="<%= card.number %>" data-search-result="<%= card.id %>">
+  <div id="<%= dom_id(card) %>" class="flex flex-column flex-item-grow max-inline-size">
+    <header class="card__header">
+      <%= render "cards/display/preview/board", card: card %>
+    </header>
+
+    <div class="card__body justify-space-between">
+      <div class="card__content">
+        <h3 class="card__title search-result__title overflow-line-clamp">
+          <%= link_to card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } do %>
+            <%= search_highlight(card.title, terms) %>
+          <% end %>
+        </h3>
+
+        <% if excerpt = search_excerpt(card.description, terms) %>
+          <div class="card__description search-result__description search-result__excerpt">
+            <%= search_highlight(excerpt, terms) %>
+          </div>
+        <% end %>
+
+        <% search_matching_comments(card, terms).first(3).each do |comment| %>
+          <div class="comment search-result__comment">
+            <strong class="search-result__comment-author"><%= comment.creator.name %></strong>
+            <div class="comment__body search-result__comment-body search-result__excerpt">
+              <%= search_highlight(search_excerpt(comment.body, terms), terms) %>
+            </div>
+          </div>
+        <% end %>
+      </div>
+    </div>
+  </div>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..8ac6a17
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,33 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, class: "search__form panel margin-block-half", id: "search_form" do %>
+  <div class="flex align-center gap-half">
+    <%= search_field_tag :q, @query, class: "input full-width", placeholder: "Search cards…", autofocus: true, autocorrect: "off", autocomplete: "off", aria: { label: "Search" }, data: { "1p-ignore": "true" } %>
+    <%= button_tag type: "submit", class: "btn btn--circle" do %>
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    <% end %>
+  </div>
+<% end %>
+
+<% if @query.present? %>
+  <section id="search-results" class="search-results cards cards--grid">
+    <div id="search_results" class="cards__list hide-scrollbar search-results__list">
+      <% if @cards.any? %>
+        <%= render partial: "searches/result", collection: @cards, as: :card, locals: { terms: @terms } %>
+      <% else %>
+        <div id="search_no_results" class="blank-slate search-results__empty">No cards match your search</div>
+      <% end %>
+    </div>
+  </section>
+<% else %>
+  <section class="search-results">
+    <div class="blank-slate">What are you looking for?</div>
+  </section>
+<% end %>
