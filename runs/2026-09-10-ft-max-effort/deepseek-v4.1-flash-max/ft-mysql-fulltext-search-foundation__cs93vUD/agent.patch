diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..c433a61
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,29 @@
+module SearchesHelper
+  def search_highlight(text, terms)
+    highlight(ERB::Util.html_escape(text.to_s), terms, highlighter: "<mark>\\1</mark>")
+  end
+
+  def search_excerpt(text, terms, radius: 120)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    return if plain_text.blank? || terms.empty?
+
+    match = terms.filter_map { |term| plain_text.match(/#{Regexp.escape(term)}/i) }.min_by { |result| result.begin(0) }
+    return unless match
+
+    position = match.begin(0)
+    start = [ position - radius, 0 ].max
+    finish = [ position + match[0].length + radius, plain_text.length ].min
+
+    excerpt = plain_text[start...finish].strip
+    excerpt = "…#{excerpt}" if start.positive?
+    excerpt = "#{excerpt}…" if finish < plain_text.length
+    excerpt
+  end
+
+  def search_matching_comments(card, terms)
+    card.comments.select do |comment|
+      body = comment.body&.to_plain_text.to_s
+      terms.any? { |term| body.match?(/#{Regexp.escape(term)}/i) }
+    end
+  end
+end
