     end
   end
+
+  def move_to_column(destination)
+    case destination
+    when nil, "" then send_back_to_triage
+    when Column then triage_into(destination)
+    else
+      case destination.to_s
+      when "maybe", "triage" then send_back_to_triage
+      when "not_now", "not-now", "postponed" then postpone
+      when "closed", "done" then close
+      else triage_into(board.columns.find(destination))
+      end
+    end
+  end
 end
