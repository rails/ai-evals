diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..54598f8
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,185 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  dragStart(event) {
+    const card = event.target.closest(".card")
+    if (!card || !card.closest(".cards")) return
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.dragOver(event)
+  }
+
+  dragOver(event) {
+    const column = event.target.closest(".cards")
+    if (!column?.querySelector(".cards__list")) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(column)
+  }
+
+  dragLeave(event) {
+    const column = event.target.closest(".cards")
+    if (!column || column.contains(event.relatedTarget)) return
+
+    column.classList.remove(HOVER_CONTAINER_CLASS)
+  }
+
+  drop(event) {
+    event.preventDefault()
+
+    const column = event.target.closest(".cards")
+    const card = this.draggedCard
+
+    this.#clearDragState()
+
+    if (!column?.querySelector(".cards__list") || !card) return
+
+    const sourceColumn = card.closest(".cards")
+    if (column === sourceColumn) return
+
+    this.#moveCard(card, column, sourceColumn)
+    this.#persistMove(card, column)
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+  }
+
+  // Private
+
+  #clearDragState() {
+    this.draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedCard = null
+    this.#columns.forEach(column => column.classList.remove(HOVER_CONTAINER_CLASS))
+  }
+
+  #highlight(column) {
+    this.#columns.forEach(target => target.classList.toggle(HOVER_CONTAINER_CLASS, target === column))
+  }
+
+  #moveCard(card, column, sourceColumn) {
+    const list = this.#cardContainerFor(column)
+    const cards = Array.from(list.children).filter(element => element.classList.contains("card"))
+
+    if (card.classList.contains("golden-effect")) {
+      list.prepend(card)
+    } else {
+      const firstNonGoldenCard = cards.find(candidate => !candidate.classList.contains("golden-effect"))
+
+      if (firstNonGoldenCard) {
+        list.insertBefore(card, firstNonGoldenCard)
+      } else {
+        const trailingElement = Array.from(list.children).find(element => !element.classList.contains("card"))
+        list.insertBefore(card, trailingElement || null)
+      }
+    }
+
+    this.#updateCard(card, column)
+    this.#updateCount(sourceColumn, column)
+  }
+
+  async #persistMove(card, column) {
+    const destination = this.#destinationFor(column)
+    const triageUrl = card.dataset.cardTriageUrl
+    const notNowUrl = card.dataset.cardNotNowUrl
+    const closureUrl = card.dataset.cardClosureUrl
+
+    try {
+      if (destination === "maybe" && triageUrl) {
+        await destroy(triageUrl, { responseKind: "json" })
+      } else if (destination === "not_now" && notNowUrl) {
+        await post(notNowUrl, { responseKind: "json" })
+      } else if (destination === "closed" && closureUrl) {
+        await post(closureUrl, { responseKind: "json" })
+      } else if (triageUrl) {
+        await post(triageUrl, { query: { column_id: destination }, responseKind: "json" })
+      }
+    } catch (error) {
+      console.error("Failed to move card", error)
+    }
+  }
+
+  #updateCard(card, column) {
+    const destination = this.#destinationFor(column)
+    const isCustomColumn = !["maybe", "not_now", "closed"].includes(destination)
+
+    card.style.setProperty("--card-color", this.#colorFor(column, destination))
+    card.classList.toggle("card--active", destination !== "not_now" && destination !== "closed")
+    card.classList.toggle("card--postponed", destination === "not_now")
+
+    this.#updateCardColumnName(card, isCustomColumn ? column.dataset.columnName : null)
+  }
+
+  #updateCardColumnName(card, name) {
+    const header = card.querySelector(".card__header")
+    let indicator = header?.querySelector(".card__column-name--current")
+
+    if (name) {
+      if (!indicator) {
+        indicator = document.createElement("span")
+        indicator.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        indicator.innerHTML = '<span class="overflow-ellipsis"></span>'
+        header?.appendChild(indicator)
+      }
+
+      indicator.querySelector(".overflow-ellipsis").textContent = name
+    } else {
+      indicator?.remove()
+    }
+  }
+
+  #updateCount(sourceColumn, targetColumn) {
+    if (!sourceColumn || sourceColumn === targetColumn) return
+
+    const sourceCount = sourceColumn.querySelector(".cards__expander-count")
+    const targetCount = targetColumn.querySelector(".cards__expander-count")
+
+    if (sourceCount && /^\d+$/.test(sourceCount.textContent)) {
+      sourceCount.textContent = Math.max(parseInt(sourceCount.textContent, 10) - 1, 0)
+    }
+
+    if (targetCount && /^\d+$/.test(targetCount.textContent)) {
+      targetCount.textContent = parseInt(targetCount.textContent, 10) + 1
+    }
+  }
+
+  #colorFor(column, destination) {
+    if (destination === "maybe") return "var(--color-card-default)"
+    if (destination === "not_now" || destination === "closed") return "var(--color-card-complete)"
+
+    return column.style.getPropertyValue("--card-color").trim() || "var(--color-card-default)"
+  }
+
+  #cardContainerFor(column) {
+    const list = column.querySelector(".cards__list")
+
+    return list?.querySelector("turbo-frame[id*='pagination-contents']") || list
+  }
+
+  #destinationFor(column) {
+    if (column.dataset.dragAndDropDestination) return column.dataset.dragAndDropDestination
+    if (column.id === "maybe") return "maybe"
+    if (column.id === "not-now") return "not_now"
+    if (column.id === "closed-cards") return "closed"
+    if (column.id.startsWith("column_")) return column.id.slice("column_".length)
+    return column.id
+  }
+
+  get #columns() {
+    return Array.from(this.element.querySelectorAll(".cards"))
+  }
+}
