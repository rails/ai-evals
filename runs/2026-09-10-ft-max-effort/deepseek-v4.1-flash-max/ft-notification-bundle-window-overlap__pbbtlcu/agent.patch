diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..553009b
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,48 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+    belongs_to :notification_bundle, class_name: "Notification::Bundle", foreign_key: :notification_bundle_id, optional: true, inverse_of: false
+
+    before_validation :sync_bundle_columns
+    after_save_commit :bundle_later, if: :should_bundle?
+  end
+
+  def bundled?
+    bundle.present?
+  end
+  alias_method :bundle?, :bundled?
+
+  def bundle_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  def bundle_now
+    Notification::Bundle.add(self)
+  end
+  alias_method :create_bundle, :bundle_now
+
+  def bundleable?
+    user.present? && user.active? && account.present? && account.active? && !creator&.system? && email_bundling?
+  end
+
+  alias_method :bundling?, :bundleable?
+  alias_method :email_bundling?, :bundleable?
+
+  private
+    def sync_bundle_columns
+      if has_attribute?(:notification_bundle_id)
+        self[:bundle_id] ||= self[:notification_bundle_id]
+        self[:notification_bundle_id] ||= self[:bundle_id]
+      end
+    end
+
+    def should_bundle?
+      source_id_previously_changed? && bundleable?
+    end
+
+    def email_bundling?
+      user.present? && user.settings&.bundle_email_frequency_duration.present?
+    end
+end
