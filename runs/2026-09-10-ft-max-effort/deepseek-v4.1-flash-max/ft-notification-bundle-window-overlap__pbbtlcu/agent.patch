+      <span>Off</span>
+    </label>
+
+    <label class="flex align-center gap-half">
+      <%= form.radio_button :bundle_email_frequency, "every_few_hours", checked: Current.user.settings.bundle_email_frequency == "every_few_hours" %>
+      <span>Every four hours</span>
+    </label>
+
+    <label class="flex align-center gap-half">
+      <%= form.radio_button :bundle_email_frequency, "daily", checked: Current.user.settings.bundle_email_frequency == "daily" %>
