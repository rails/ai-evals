+    </label>
+
+    <label class="flex align-center gap-half">
+      <%= form.radio_button :bundle_email_frequency, "weekly", checked: Current.user.settings.bundle_email_frequency == "weekly" %>
+      <span>Weekly</span>
+    </label>
+
+    <div class="flex justify-end">
+      <%= form.submit "Save", class: "btn btn--positive" %>
+    </div>
+  <% end %>
+</section>
