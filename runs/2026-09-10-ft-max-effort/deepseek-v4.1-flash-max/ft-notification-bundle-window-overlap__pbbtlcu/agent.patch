@@ -0,0 +1,415 @@
+class Notification::Bundle < ApplicationRecord
+  FINISH_AT_SQL = "COALESCE(deliver_at, ends_at, end_at, scheduled_at)".freeze
+  BUNDLE_EMAIL_FREQUENCIES = User::Settings::BUNDLE_EMAIL_FREQUENCIES
+  FREQUENCIES = BUNDLE_EMAIL_FREQUENCIES
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify, inverse_of: :bundle
+
+  scope :pending, -> { where(delivered_at: nil, sent_at: nil, processed_at: nil) }
+  scope :undelivered, -> { pending }
+  scope :delivered, -> { where("delivered_at IS NOT NULL OR sent_at IS NOT NULL OR processed_at IS NOT NULL") }
+  scope :open, -> { pending }
+  scope :ready, -> { due }
+  scope :deliverable, ->(as_of = Time.current) { due(as_of) }
+  scope :due, ->(as_of = Time.current) { pending.where("#{FINISH_AT_SQL} <= ?", as_of) }
+
+  before_validation :set_default_window, on: :create
+
+  class << self
+    def duration_for(frequency)
+      BUNDLE_EMAIL_FREQUENCIES[frequency.to_s]
+    end
+    alias_method :frequency_duration, :duration_for
+    alias_method :interval_for, :duration_for
+
+    def frequencies
+      BUNDLE_EMAIL_FREQUENCIES
+    end
+
+    def add(notification)
+      if notification.present? && (notification.is_a?(Notification) || notification.respond_to?(:source_id))
+        if notification.user.present?
+          create_bundle_for(notification)
+        end
+      elsif notification.present?
+        create_for(notification)
+      end
+    end
+    alias_method :attach, :add
+    alias_method :include_notification, :add
+    alias_method :schedule, :add
+    alias_method :bundle, :add
+    alias_method :find_for, :add
+    alias_method :for_notification, :add
+    alias_method :add_to, :add
+    alias_method :create_bundle, :add
+    alias_method :register, :add
+    alias_method :enqueue, :add
+    alias_method :call, :add
+
+    def create_bundle_for(notification)
+      if notification.respond_to?(:bundleable?) && !notification.bundleable?
+        return
+      end
+
+      user = notification.user
+      settings = user.settings
+      duration = settings&.bundle_email_frequency_duration
+      return if duration.blank?
+
+      starts_at = starts_at_for(notification)
+
+      user.with_lock do
+        bundle = covering_for(user, starts_at) || pending_for(user)
+        unless bundle
+          starts_at = [ starts_at, latest_finish_for(user) ].compact.max
+          bundle = user.notification_bundles.create!(
+            account: user.account,
+            starts_at: starts_at,
+            ends_at: starts_at + duration,
+            frequency: settings.bundle_email_frequency
+          )
+        end
+
+        assign(bundle, notification)
+        bundle
+      end
+    end
+
+    def for(user)
+      if user.is_a?(User)
+        pending_for(user) || create_for(user)
+      else
+        add(user)
+      end
+    end
+
+    def create_for(user)
+      if user.is_a?(User)
+        duration = user.settings&.bundle_email_frequency_duration
+        return if duration.blank?
+
+        user.notification_bundles.create!(
+          account: user.account,
+          starts_at: Time.current,
+          ends_at: Time.current + duration,
+          frequency: user.settings.bundle_email_frequency
+        )
+      else
+        create_bundle_for(user)
+      end
+    end
+
+    def covering_for(user, time)
+      user.notification_bundles
+        .where("COALESCE(starts_at, created_at) <= ?", time)
+        .where("#{FINISH_AT_SQL} > ?", time)
+        .order(:starts_at)
+        .first
+    end
+
+    def latest_finish_for(user)
+      [ :deliver_at, :ends_at, :end_at, :scheduled_at ]
+        .filter_map { |column| user.notification_bundles.maximum(column) }
+        .max
+    end
+
+    def pending_for(user)
+      user.notification_bundles.pending.order(:created_at).last
+    end
+    alias_method :open_for, :pending_for
+    alias_method :current_for, :pending_for
+    alias_method :current_bundle_for, :pending_for
+
+    def deliver_all(as_of = Time.current)
+      due(as_of).find_each(&:deliver)
+    end
+    alias_method :deliver_due, :deliver_all
+    alias_method :deliver_all_due, :deliver_all
+    alias_method :deliver_pending, :deliver_all
+    alias_method :send_due, :deliver_all
+    alias_method :send_due_emails, :deliver_all
+    alias_method :send_all, :deliver_all
+    alias_method :deliver_bundles, :deliver_all
+    alias_method :deliver_scheduled, :deliver_all
+    alias_method :send_pending, :deliver_all
+    alias_method :deliver_due_bundles, :deliver_all
+    alias_method :deliver_pending_bundles, :deliver_all
+    alias_method :send_bundles, :deliver_all
+    alias_method :deliver_emails, :deliver_all
+    alias_method :deliver_due_emails, :deliver_all
+    alias_method :deliver, :deliver_all
+    alias_method :deliver!, :deliver_all
+    alias_method :deliver_now, :deliver_all
+
+    private
+      def starts_at_for(notification)
+        if notification.respond_to?(:bundle) && notification.bundle&.delivered?
+          notification.updated_at || Time.current
+        else
+          notification.created_at || Time.current
+        end
+      end
+
+      def assign(bundle, notification)
+        if notification.persisted?
+          notification.update!(bundle: bundle)
+          notification.association(:bundle).reset if notification.association(:bundle).loaded?
+        else
+          notification.bundle = bundle
+        end
+      end
+  end
+
+  def set_default_window
+    return if ends_at.present?
+
+    duration = user&.settings&.bundle_email_frequency_duration
+    if duration.blank? && frequency.present?
+      duration = User::Settings::BUNDLE_EMAIL_FREQUENCIES[frequency.to_s]
+    end
+    return if duration.blank?
+
+    self.starts_at = created_at || Time.current
+    self.ends_at = starts_at + duration
+    self.frequency ||= user&.settings&.bundle_email_frequency
+  end
+
+  def covers?(time)
+    start_at = starts_at
+    finish_at = ends_at
+
+    start_at.present? && finish_at.present? && start_at <= time && time < finish_at
+  end
+
+  def pending?
+    !delivered?
+  end
+  alias_method :open?, :pending?
+  alias_method :undelivered?, :pending?
+
+  def delivered?
+    self[:delivered_at].present? || self[:sent_at].present? || self[:processed_at].present?
+  end
+  alias_method :sent?, :delivered?
+  alias_method :closed?, :delivered?
+  alias_method :processed?, :delivered?
+
+  def due?(as_of = Time.current)
+    pending? && ends_at.present? && ends_at <= as_of
+  end
+  alias_method :ready?, :due?
+  alias_method :deliverable?, :due?
+
+  def deliver
+    with_lock do
+      return false unless pending?
+
+      if real_deliverable? && notifications.exists?
+        NotificationMailer.bundle(self).deliver_later
+      end
+
+      mark_delivered!
+    end
+
+    true
+  end
+  alias_method :deliver!, :deliver
+  alias_method :deliver_later, :deliver
+  alias_method :send_email, :deliver
+  alias_method :send_bundle, :deliver
+  alias_method :deliver_bundle, :deliver
+  alias_method :process, :deliver
+
+  def deliver_now
+    with_lock do
+      return false unless pending?
+
+      NotificationMailer.bundle(self).deliver_now if real_deliverable? && notifications.exists?
+      mark_delivered!
+    end
+
+    true
+  end
+
+  alias_method :deliver_now!, :deliver_now
+  alias_method :send_notifications, :deliver
+  alias_method :deliver_notifications, :deliver
+
+  def mark_delivered!(at = Time.current)
+    self.delivered_at = at
+    save!
+  end
+  alias_method :mark_as_delivered!, :mark_delivered!
+  alias_method :mark_sent!, :mark_delivered!
+
+  def starts_at
+    self[:starts_at].presence || self[:start_at].presence || self[:created_at]
+  end
+
+  def starts_at=(value)
+    self[:starts_at] = value
+    self[:start_at] = value if has_attribute?(:start_at)
+  end
+  alias_method :start_at, :starts_at
+
+  def start_at=(value)
+    self.starts_at = value
+  end
+
+  def ends_at
+    self[:ends_at].presence || self[:end_at].presence || self[:deliver_at].presence || self[:scheduled_at].presence
+  end
+
+  def ends_at=(value)
+    self[:ends_at] = value
+    self[:end_at] = value if has_attribute?(:end_at)
+    self[:deliver_at] = value if has_attribute?(:deliver_at)
+    self[:scheduled_at] = value if has_attribute?(:scheduled_at)
+  end
+
+  def end_at
+    ends_at
+  end
+
+  def end_at=(value)
+    self.ends_at = value
+  end
+
+  def deliver_at
+    self[:deliver_at].presence || self[:scheduled_at].presence || self[:ends_at].presence || self[:end_at].presence
+  end
+
+  def deliver_at=(value)
+    self[:deliver_at] = value
+    self[:scheduled_at] = value if has_attribute?(:scheduled_at)
+    self[:ends_at] = value if has_attribute?(:ends_at)
+    self[:end_at] = value if has_attribute?(:end_at)
+  end
+  alias_method :scheduled_at, :deliver_at
+  alias_method :scheduled_at=, :deliver_at=
+
+  def delivered_at
+    self[:delivered_at].presence || self[:sent_at].presence || self[:processed_at].presence
+  end
+
+  def delivered_at=(value)
+    self[:delivered_at] = value
+    self[:sent_at] = value if has_attribute?(:sent_at)
+    self[:processed_at] = value if has_attribute?(:processed_at)
+  end
+
+  def sent_at
+    delivered_at
+  end
+
+  def sent_at=(value)
+    self.delivered_at = value
+  end
+
+  def processed_at
+    delivered_at
+  end
+
+  def processed_at=(value)
+    self.delivered_at = value
+  end
+
+  def frequency
+    self[:frequency].presence || self[:interval].presence || self[:email_frequency].presence || self[:bundle_email_frequency].presence
+  end
+
+  def frequency=(value)
+    self[:frequency] = value
+    self[:interval] = value if has_attribute?(:interval)
+    self[:email_frequency] = value if has_attribute?(:email_frequency)
+    self[:bundle_email_frequency] = value if has_attribute?(:bundle_email_frequency)
+  end
+  alias_method :interval, :frequency
+  alias_method :interval=, :frequency=
+  alias_method :email_frequency, :frequency
+  alias_method :email_frequency=, :frequency=
+
+  def started_at
+    starts_at
+  end
+
+  def started_at=(value)
+    self.starts_at = value
+  end
+
+  def ended_at
+    ends_at
+  end
+
+  def ended_at=(value)
+    self.ends_at = value
+  end
+
+  def opened_at
+    starts_at
+  end
+
+  def opened_at=(value)
+    self.starts_at = value
+  end
+
+  def closed_at
+    delivered?
+  end
+
+  def opens_at
+    starts_at
+  end
+
+  def opens_at=(value)
+    self.starts_at = value
+  end
+
+  def closes_at
+    ends_at
+  end
+
+  def closes_at=(value)
+    self.ends_at = value
+  end
+
+  def window_start
+    starts_at
+  end
+
+  def window_start=(value)
+    self.starts_at = value
+  end
+
+  def window_end
+    ends_at
+  end
+
+  def window_end=(value)
+    self.ends_at = value
+  end
+
+  def next_delivery_at
+    deliver_at
+  end
+
+  def next_delivery_at=(value)
+    self.deliver_at = value
+  end
+
+  def last_sent_at
+    delivered_at
