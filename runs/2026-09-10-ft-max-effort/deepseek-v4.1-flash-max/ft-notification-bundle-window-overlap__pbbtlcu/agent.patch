index 0000000..e92e65c
--- /dev/null
+++ b/app/views/mailers/notification_mailer/bundle.html.erb
@@ -0,0 +1,29 @@
+<h1 class="title">New notifications</h1>
+<p class="subtitle">You have <%= pluralize(@notifications.size, "new notification") %>. Here's what happened while you were away.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
+  <h2 class="notification__board">
+    <%= link_to board.name, board_url(board, script_name: @account.slug) %>
+  </h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <div class="notification">
+      <p class="notification__author">
+        <%= notification.creator.name %> · <%= notification.card.title.presence || "Card #{notification.card.number}" %>
+      </p>
+      <p class="notification__details">
+        <%= link_to payload.title, payload.url %>
+      </p>
+      <p class="notification__details">
+        <%= sanitize payload.body %>
+      </p>
+    </div>
+  <% end %>
+
+  <hr class="notification__board-separator">
+<% end %>
+
+<p class="footer">
+  <%= link_to "Manage your notification settings", notifications_settings_url(script_name: @account.slug) %>
+</p>
