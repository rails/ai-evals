+++ b/app/jobs/notification/bundle_job.rb
@@ -0,0 +1,24 @@
+class Notification::BundleJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(subject = nil)
+    case subject
+    when Notification::Bundle
+      subject.deliver
+    when Notification
+      subject.bundle_now
+    when User
+      subject.notification_bundles.due.find_each(&:deliver)
+    when nil
+      Notification::Bundle.deliver_all
+    else
+      if subject.respond_to?(:bundle_now)
+        subject.bundle_now
+      elsif subject.respond_to?(:deliver)
+        subject.deliver
+      else
+        Notification::Bundle.deliver_all
+      end
+    end
+  end
+end
