diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..024a40e
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "mark", text: "logo"
+    assert_select "a[href=?]", card_path(cards(:logo))
+  end
+
+  test "finds cards by description" do
+    cards(:logo).update!(description: "Contains a unique zebra description")
+
+    get search_path, params: { q: "zebra" }
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "zebra"
+  end
+
+  test "finds cards by comment body" do
+    get search_path, params: { q: "overflowing" }
+
+    assert_response :success
+    assert_match cards(:layout).title, response.body
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "orders results newest first" do
+    older = nil
+    newer = nil
+
+    with_current_user(users(:kevin)) do
+      board = boards(:writebook)
+      older = board.cards.create!(creator: users(:kevin), title: "Zebra older", status: :published, created_at: 2.days.ago, last_active_at: 2.days.ago)
+      newer = board.cards.create!(creator: users(:kevin), title: "Zebra newer", status: :published, created_at: Time.current, last_active_at: Time.current)
+    end
+
+    get search_path, params: { q: "zebra" }
+
+    assert_response :success
+    assert_operator response.body.index(dom_id_fragment(newer)), :<, response.body.index(dom_id_fragment(older))
+  end
+
+  test "does not include cards on inaccessible boards" do
+    card = nil
+
+    with_current_user(users(:kevin)) do
+      card = boards(:private).cards.create!(creator: users(:kevin), title: "A secret zebra card", status: :published, last_active_at: Time.current)
+    end
+
+    logout_and_sign_in_as :david
+
+    get search_path, params: { q: "zebra" }
+
+    assert_response :success
+    assert_no_match card.title, response.body
+  end
+
+  test "does not include cards from boards whose access was revoked" do
+    board = boards(:writebook)
+    board.update!(all_access: false)
+    board.accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "mark", text: "logo", count: 0
+    assert_no_match cards(:logo).title, response.body
+  end
+
+  test "does not include draft cards" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Draft zebra title", last_active_at: Time.current)
+
+    get search_path, params: { q: "zebra" }
+
+    assert_response :success
+    assert_no_match draft.title, response.body
+  end
+
+  test "does not include comments from draft cards" do
+    card = cards(:shipping)
+    card.comments.create!(creator: users(:kevin), body: "A hidden zebra comment")
+    card.update_column(:status, "drafted")
+
+    get search_path, params: { q: "zebra" }
+
+    assert_response :success
+    assert_no_match "A hidden zebra comment", response.body
+    assert_no_match card.title, response.body
+  end
+
+  test "returns a card only once when several comments match" do
+    cards(:logo).comments.create!(creator: users(:kevin), body: "First zebra comment")
+    cards(:logo).comments.create!(creator: users(:kevin), body: "Second zebra comment")
+
+    get search_path, params: { q: "zebra" }
+
+    assert_response :success
+    assert_select "article.search-result", count: 1
+    assert_select "mark", text: "zebra", count: 2
+  end
+
+  test "highlights matches near the end of long text" do
+    cards(:logo).update!(description: "#{"long text " * 100}unique zebra ending")
+
+    get search_path, params: { q: "zebra" }
+
+    assert_response :success
+    assert_select "mark", text: "zebra"
+  end
+
+  test "does not match words that only appear in html markup" do
+    cards(:logo).comments.create!(creator: users(:kevin), body: "This has <strong>bold</strong> text")
+
+    get search_path, params: { q: "strong" }
+
+    assert_response :success
+    assert_select "article.search-result", count: 0
+  end
+
+  test "treats wildcard characters as literal text" do
+    cards(:logo).update_column(:title, "100% zebra")
+
+    get search_path, params: { q: "100%" }
+
+    assert_response :success
+    assert_select "mark", text: "100%"
+  end
+
+  test "search is case insensitive" do
+    get search_path, params: { q: "LOGO" }
+
+    assert_response :success
+    assert_select "mark", text: "logo"
+  end
+
+  test "blank query returns no results" do
+    get search_path, params: { q: "" }
+
+    assert_response :success
+    assert_select "mark", count: 0
+  end
+
+  test "renders a search form" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "form[action=?][method=get]", search_path do
+      assert_select "input[type=search][name=q][value=logo]"
+    end
+  end
+
+  private
+    def dom_id_fragment(card)
+      ActionView::RecordIdentifier.dom_id(card, :search_result)
+    end
+end
