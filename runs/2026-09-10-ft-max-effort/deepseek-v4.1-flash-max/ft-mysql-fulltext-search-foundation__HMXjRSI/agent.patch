diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..a53a3c6
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,47 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      if query.present?
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(query.to_s, "!")}%"
+
+        where(<<~SQL.squish, pattern: pattern)
+          cards.title LIKE :pattern ESCAPE '!'
+          OR EXISTS (
+            SELECT 1
+            FROM action_text_rich_texts AS card_descriptions
+            WHERE card_descriptions.record_type = 'Card'
+              AND card_descriptions.record_id = cards.id
+              AND card_descriptions.name = 'description'
+              AND card_descriptions.body LIKE :pattern ESCAPE '!'
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments
+            INNER JOIN action_text_rich_texts AS comment_bodies
+              ON comment_bodies.record_type = 'Comment'
+             AND comment_bodies.record_id = comments.id
+             AND comment_bodies.name = 'body'
+            WHERE comments.card_id = cards.id
+              AND comment_bodies.body LIKE :pattern ESCAPE '!'
+          )
+        SQL
+      else
+        none
+      end
+    end
+  end
+
+  def matches_search?(query)
+    query = query.to_s.downcase
+    return false if query.blank?
+
+    searchable_texts.any? { |text| text.downcase.include?(query) }
+  end
+
+private
+  def searchable_texts
+    [ title, description&.to_plain_text, *comments.map { |comment| comment.body&.to_plain_text } ].compact
+  end
+end
