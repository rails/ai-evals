diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..a9b3f84
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,29 @@
+<% description_matches = search_match?(card.description, query) %>
+<% comments = card.comments.select { |comment| search_match?(comment.body, query) } %>
+
+<li class="search__result search-item" id="<%= dom_id(card, :search_result) %>">
+  <%= card_article_tag card, class: "search__card search-result", data: { id: card.number } do %>
+    <header class="card__header">
+      <span class="card__board-name search-result__board"><%= card.board.name %></span>
+    </header>
+
+    <h3 class="card__title search-result__title search__result-title">
+      <%= link_to highlight(card.title.to_s, query), card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } %>
+    </h3>
+
+    <% if description_matches %>
+      <p class="card__description search-result__excerpt search-result__description search__result-excerpt"><%= search_highlight(card.description, query) %></p>
+    <% end %>
+
+    <% if comments.any? %>
+      <ul class="search-result__comments">
+        <% comments.each do |comment| %>
+          <li class="search-result__comment">
+            <span class="search-result__comment-author"><%= comment.creator.name %></span>
+            <span class="search-result__comment-body"><%= search_highlight(comment.body, query) %></span>
+          </li>
+        <% end %>
+      </ul>
+    <% end %>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..94abe6a
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,26 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form" do |form| %>
+    <div class="search__field">
+      <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+      <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards…",
+            autofocus: true, autocorrect: "off", autocomplete: "off", aria: { label: "Search cards" } %>
+      <%= form.submit "Search", class: "btn" %>
+    </div>
+  <% end %>
+
+  <% if @cards.present? %>
+    <ol class="search__results search-results">
+      <%= render partial: "searches/result", collection: @cards, as: :card, locals: { query: @query } %>
+    </ol>
+  <% elsif @query.present? %>
+    <div class="blank-slate">No cards match this search</div>
+  <% end %>
+</section>
