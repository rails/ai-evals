index 0000000..5a67a6f
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,28 @@
+module SearchesHelper
+  def search_text(content)
+    content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+  end
+
+  def search_match?(content, query)
+    query.present? && search_text(content).downcase.include?(query.downcase)
+  end
+
+  def search_excerpt(content, query, length: 240)
+    text = search_text(content).squish
+
+    if index = text.downcase.index(query.downcase)
+      start = [ index - (length / 2), 0 ].max
+      finish = [ start + length, index + query.length ].max
+      excerpt = text[start...finish] || text
+      excerpt = "…#{excerpt}" if start.positive?
+      excerpt = "#{excerpt}…" if finish < text.length
+      excerpt
+    else
+      format_excerpt(text, length: length)
+    end
+  end
+
+  def search_highlight(content, query)
+    highlight(search_excerpt(content, query), query) if query.present?
+  end
+end
