@@ -5,7 +5,44 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  # Render and deliver every email in the recipient's preferred language.
+  def process(action, *args, **kwargs)
+    locale = preferred_locale_for(args, kwargs)
+    I18n.with_locale(locale || I18n.default_locale) { super }
+  end
+
   private
+    def preferred_locale_for(args, kwargs)
+      arguments = args.flat_map { |argument| argument.is_a?(Hash) ? argument.values : argument }
+      (arguments + kwargs.values).each do |argument|
+        locale = locale_for(argument)
+        return locale if locale.present?
+      end
+
+      nil
+    end
+
+    def locale_for(record)
+      case record
+      when Identity
+        record.preferred_locale
+      when User
+        record.preferred_locale
+      when User::Settings
+        record.preferred_locale
+      else
+        if record.respond_to?(:preferred_locale)
+          record.preferred_locale
+        elsif record.respond_to?(:user) && record.user
+          locale_for(record.user)
+        elsif record.respond_to?(:identity) && record.identity
+          locale_for(record.identity)
+        elsif record.respond_to?(:initiated_by) && record.initiated_by
+          locale_for(record.initiated_by)
+        end
+      end
+    end
+
     def default_url_options
       if Current.account
         super.merge(script_name: Current.account.slug)
