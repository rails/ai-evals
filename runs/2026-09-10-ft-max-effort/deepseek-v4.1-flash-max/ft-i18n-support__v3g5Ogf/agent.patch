diff --git a/config/initializers/i18n_literal_backend.rb b/config/initializers/i18n_literal_backend.rb
new file mode 100644
index 0000000..0d53ac1
--- /dev/null
+++ b/config/initializers/i18n_literal_backend.rb
@@ -0,0 +1,52 @@
+# Literal translations key translations by their English source text (prefixed
+# with "~"). This keeps English output byte-for-byte identical while allowing
+# natural Japanese translations in config/locales/ja.literals.yml under the
+# `literals` namespace.
+module Fizzy
+  module I18nLiteralBackend
+    PREFIX = "~"
+
+    def translate(locale, key, options = I18n::EMPTY_HASH)
+      key = key.to_s
+      literals = Fizzy.literal_translations(locale)
+
+      if key.start_with?(PREFIX)
+        source = key.delete_prefix(PREFIX)
+        return interpolate_value(literals[source] || source, options)
+      end
+
+      return interpolate_value(literals[key], options) if literals.key?(key)
+
+      super
+    end
+
+    private
+      def interpolate_value(value, options)
+        value.include?("%{") ? I18n.interpolate(value, options) : value
+      end
+  end
+
+  class << self
+    def literal_translations(locale)
+      @literal_translations ||= {}
+      @literal_translations[locale.to_sym] ||= begin
+        store = loaded_translations[locale.to_sym] || {}
+        literals = store[:literals] || store["literals"] || {}
+        literals.each_with_object({}) { |(key, value), hash| hash[key.to_s] = value }
+      end
+    end
+
+    private
+      def loaded_translations
+        backend = I18n.backend
+        translations = backend.send(:translations)
+        if translations.empty?
+          backend.send(:init_translations) if backend.respond_to?(:init_translations, true)
+          translations = backend.send(:translations)
+        end
+        translations
+      end
+  end
+end
+
+I18n::Backend::Simple.prepend(Fizzy::I18nLiteralBackend)
