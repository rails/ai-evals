diff --git a/test/zz_localization_smoke_test.rb b/test/zz_localization_smoke_test.rb
new file mode 100644
index 0000000..991d134
--- /dev/null
+++ b/test/zz_localization_smoke_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class ZzLocalizationSmokeTest < ActionDispatch::IntegrationTest
+  test "japanese switch, session persistence, invalid locale, clean browser, emails, error pages" do
+    # Switch to Japanese with a query param.
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_match "メインコンテンツへスキップ", response.body
+    assert_match 'lang="ja"', response.body
+    assert_match "検索", response.body
+    assert_no_match "Skip to main content", response.body
+
+    # Sticks for the rest of the session.
+    get root_path
+    assert_match "メインコンテンツへスキップ", response.body
+
+    # Unsupported locale does not switch or break.
+    get board_path(boards(:writebook), locale: "xx")
+    assert_response :success
+
+    # Persists to the identity, so a clean browser signs back into Japanese.
+    identity = identities(:kevin)
+    assert_equal "ja", identity.reload.locale
+    assert_equal "ja", users(:kevin).reload.settings.locale
+
+    reset!
+    sign_in_as :kevin
+    get root_path
+    assert_match "メインコンテンツへスキップ", response.body
+
+    # Static error pages carry both languages.
+    get "/404.html"
+    body = response.body.dup.force_encoding("UTF-8")
+    assert_match "Sorry, that page", body
+    assert_match "ページが見つかりません", body
+
+    # Emails are Japanese for a Japanese identity.
+    identity.update!(locale: "ja")
+    magic_link = identity.magic_links.create!(purpose: :sign_in, expires_at: 1.hour.from_now)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_match "Fizzy のコードは", email.subject
+    assert_match "この6文字の確認コード", (email.html_part.body.to_s + email.text_part.body.to_s).dup.force_encoding("UTF-8")
+  end
+end
