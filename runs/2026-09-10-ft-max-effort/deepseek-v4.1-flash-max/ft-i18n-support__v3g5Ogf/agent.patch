diff --git a/lib/fizzy/html_localizer.rb b/lib/fizzy/html_localizer.rb
new file mode 100644
index 0000000..07d9af3
--- /dev/null
+++ b/lib/fizzy/html_localizer.rb
@@ -0,0 +1,27 @@
+module Fizzy
+  class HtmlLocalizer
+    TRANSLATABLE_CONTENT_TYPES = %r{\Atext/html\b|\Atext/vnd\.turbo-stream\.html\b|\Aapplication/xhtml\+xml\b}
+
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      status, headers, body = @app.call(env)
+
+      locale = env["fizzy.locale"]
+      return [ status, headers, body ] unless locale.to_s == "ja"
+
+      content_type = headers["Content-Type"].to_s
+      return [ status, headers, body ] unless content_type.match?(TRANSLATABLE_CONTENT_TYPES)
+
+      html = +""
+      body.each { |chunk| html << chunk }
+      body.close if body.respond_to?(:close)
+
+      localized = Fizzy::TextLocalizer.translate_html(html, locale)
+      headers = headers.merge("Content-Length" => localized.bytesize.to_s)
+      [ status, headers, [ localized ] ]
+    end
+  end
+end
diff --git a/lib/fizzy/text_localizer.rb b/lib/fizzy/text_localizer.rb
new file mode 100644
index 0000000..e434dbf
--- /dev/null
+++ b/lib/fizzy/text_localizer.rb
@@ -0,0 +1,246 @@
+require "cgi"
+require "erb"
+
+module Fizzy
+  # Translates already-rendered English HTML / text into the requested locale
+  # using the literal translation table. English is never touched, so visitors
+  # who haven't chosen a locale see exactly what they saw before.
+  module TextLocalizer
+    SUFFIX = " | Fizzy"
+
+    MONTHS = {
+      "Jan" => 1, "Feb" => 2, "Mar" => 3, "Apr" => 4, "May" => 5, "Jun" => 6,
+      "Jul" => 7, "Aug" => 8, "Sep" => 9, "Oct" => 10, "Nov" => 11, "Dec" => 12
+    }.freeze
+
+    PATTERNS = [
+[ /\ATurn on notifications for (.+)\.\z/, ->(match, _map) { "#{match[1]} の通知をオンにしてください。" } ],
+[ /\ALoad page (\d+)\z/, ->(match, _map) { "ページ #{match[1]} を読み込む" } ],
+[ /\ACheck your (iOS|iPadOS|macOS|Windows|Android|Linux) settings\z/, ->(match, _map) { "#{match[1]} の設定を確認してください" } ],
+[ /\AAllow (.+) notifications\z/, ->(match, _map) { "#{match[1]} の通知を許可" } ],
+[ /\AClick (Safari|Firefox|Chrome|Google Chrome|Edge|Install|Settings|Notifications|Fizzy)\.\z/, ->(match, _map) { "「#{match[1]}」をクリックします。" } ],
+[ /\AClick (Safari|Firefox|Chrome|Google Chrome|Edge|Fizzy) in the top left\.\z/, ->(match, _map) { "左上の「#{match[1]}」をクリックします。" } ],
+[ /\AClick (Safari|Firefox|Chrome|Google Chrome|Edge|Fizzy) in the list\.\z/, ->(match, _map) { "一覧で「#{match[1]}」をクリックします。" } ],
+[ /\ATo receive push notifications in (.+) for (.+), you must first install Fizzy as a web app\.\z/, ->(match, _map) { "プッシュ通知を受け取るには、まず Fizzy をウェブアプリとしてインストールする必要があります（#{match[1]} / #{match[2]}）。" } ],
+[ /\AEnsure notifications are enabled for (.+) in your web browser settings\.\z/, ->(match, _map) { "ウェブブラウザーの設定で #{match[1]} の通知を有効にしてください。" } ],
+      [ /\ABack to (.+)\z/, ->(match, map) { "#{translated(match[1], map)} に戻る" } ],
+      [ /\AGo to (.+)\z/, ->(match, map) { "#{translated(match[1], map)} へ移動" } ],
+      [ /\ASettings for (.+)\z/, ->(match, map) { "#{translated(match[1], map)} の設定" } ],
+      [ /\AGive (.+) access\z/, ->(match, _map) { "#{match[1]} にアクセス権を付与" } ],
+      [ /\ARemove (.+) from the account\z/, ->(match, _map) { "アカウントから #{match[1]} を削除" } ],
+      [ /\AProfile avatar for (.+)\z/, ->(match, _map) { "#{match[1]} のプロフィールアバター" } ],
+      [ /\ASearch results for "(.+)"\z/, ->(match, _map) { "「#{match[1]}」の検索結果" } ],
+      [ /\ASearch results for (.+)\z/, ->(match, _map) { "「#{match[1]}」の検索結果" } ],
+      [ /\AColumn:\s*(.+)\z/, ->(match, map) { "列: #{translated(match[1], map)}" } ],
+      [ /\ARemove (.+)\z/, ->(match, map) { "#{translated(match[1], map)} を削除" } ],
+      [ /\AUnsubscribing from all email notifications as (.+)\z/, ->(match, _map) { "#{match[1]} としてすべてのメール通知の購読を解除中…" } ],
+      [ /\AWhat has (.+) been up to\?\z/, ->(match, _map) { "#{match[1]} は最近何をしていましたか？" } ],
+      [ /\AWhich cards are assigned to (.+)\?\z/, ->(match, _map) { "#{match[1]} に割り当てられたカードは？" } ],
+      [ /\AWhich cards were added by (.+)\?\z/, ->(match, _map) { "#{match[1]} が追加したカードは？" } ],
+      [ /\AEnsure notifications are allowed for (.+) in your system settings\.\z/, ->(match, _map) { "システム設定で #{match[1]} の通知が許可されていることを確認してください。" } ],
+      [ /\AEnsure notifications are enabled for (.+?)[:：]?\z/, ->(match, _map) { "#{match[1]} の通知を有効にしてください" } ],
+      [ /\AThis code has been used (\d+)\/(\d+) times\.?\z/, ->(match, _map) { "このコードは #{match[1]}/#{match[2]} 回使用されました。" } ],
+      [ /\A(\d+) people will be notified when someone comments on this\.\z/, ->(match, _map) { "コメントされると#{match[1]}人のメンバーに通知されます。" } ],
+      [ /\A(\d+) open cards?, (\d+) in (.+)\z/, ->(match, map) { "開いているカード#{match[1]}件、#{translated(match[3].strip, map)}に#{match[2]}件" } ],
+      [ /\A(\d+)\s+(day|days) ago\z/, ->(match, _map) { "#{match[1]}日前" } ],
+      [ /\A(\d+)\s+(day|days)\z/, ->(match, _map) { "#{match[1]}日" } ],
+      [ /\Ain (\d+)\s+(day|days)\z/, ->(match, _map) { "あと#{match[1]}日" } ],
+      [ /\A(\d+) hours? ago\z/, ->(match, _map) { "#{match[1]}時間前" } ],
+      [ /\A(\d+) minutes? ago\z/, ->(match, _map) { "#{match[1]}分前" } ],
+      [ /\A([A-Z][a-z]{2})\s+(\d{1,2}),\s+(\d{4})\z/, ->(match, _map) { "#{match[3]}年#{MONTHS.fetch(match[1], match[1]).to_i}月#{match[2].to_i}日" } ],
+      [ /\A([A-Z][a-z]{2})\s+(\d{1,2})\z/, ->(match, _map) { "#{MONTHS.fetch(match[1], match[1]).to_i}月#{match[2].to_i}日" } ]
+    ].freeze
+
+    TRANSLATABLE_ATTRIBUTES = %w[
+      title alt placeholder aria-label aria-description aria-roledescription
+      data-tooltip-text data-label data-title data-description data-placeholder
+      data-confirm caption data-bridge-title data-bridge-description data-bridge--title-title-value
+      data-turbo-navigation-label-value
+    ].freeze
+
+    module_function
+
+    def translate_html(html, locale = I18n.locale)
+      map = literal_map(locale)
+      return html if map.empty?
+
+      in_script = false
+      output = +""
+
+      tokenize(html).each do |type, token|
+        if type == :tag
+          in_script = false if token.match?(%r{\A</\s*(script|style)\b}i)
+          output << (in_script || style_tag?(token) ? token : translate_tag(token, map))
+          in_script = true if token.match?(/\A<\s*(script|style)\b/i) && !token.match?(%r{/>\s*\z})
+        else
+          output << (in_script ? token : translate_text_token(token, map))
+        end
+      end
+
+      translate_language_tag(output, locale)
+    end
+
+    # Plain text (e.g. text emails): translate whole lines first, then any
+    # phrase in the table, preferring the longest phrases.
+    def translate_text(text, locale = I18n.locale)
+      map = literal_map(locale)
+      return text if map.empty?
+
+      translated = text.lines.map do |line|
+        core = line.strip
+        (core.present? && (lookup(map, core) || pattern_translate(core, map))) || line
+      end.join
+
+      map.sort_by { |source, _| -source.length }.each do |source, target|
+        next if source.length < 8
+        next unless translated.include?(source)
+
+        translated = translated.gsub(source, target)
+      end
+
+      translated
+    end
+
+    def literal_map(locale)
+      Fizzy.literal_translations(locale)
+    rescue StandardError
+      {}
+    end
+
+    def translated(value, map)
+      value = value.to_s
+      lookup(map, value.strip) || pattern_translate(value.strip, map) || value
+    end
+
+    def pattern_translate(value, map)
+      PATTERNS.each do |regex, handler|
+        match = value.match(regex)
+        return handler.call(match, map) if match
+      end
+
+      nil
+    end
+
+    def lookup(map, value)
+      normalized = value.gsub(/&nbsp;|&#160;|&#xa0;/i, " ").gsub("\u00a0", " ")
+      map[value] ||
+        map[normalized] ||
+        map[normalized.gsub(/\s+/, " ").strip] ||
+        map[value.gsub(/\s+/, " ").strip]
+    end
+
+    # Split HTML into tag and text tokens without being confused by ">" inside
+    # quoted attribute values.
+    def tokenize(html)
+      tokens = []
+      index = 0
+      length = html.length
+
+      while index < length
+        if html[index] == "<"
+          cursor = index + 1
+          quote = nil
+          while cursor < length
+            char = html[cursor]
+            if quote
+              quote = nil if char == quote
+            elsif char == '"' || char == "'"
+              quote = char
+            elsif char == ">"
+              break
+            end
+            cursor += 1
+          end
+
+          if cursor < length
+            tokens << [ :tag, html[index..cursor] ]
+            index = cursor + 1
+          else
+            tokens << [ :text, html[index..] ]
+            index = length
+          end
+        else
+          cursor = html.index("<", index) || length
+          tokens << [ :text, html[index...cursor] ]
+          index = cursor
+        end
+      end
+
+      tokens
+    end
+
+    def style_tag?(tag)
+      tag.match?(/\A<\s*style\b/i)
+    end
+
+    def translate_language_tag(html, locale)
+      html.sub(/(<\s*html\b[^>]*>)/i) do
+        tag = Regexp.last_match(1)
+        if tag =~ /\blang\s*=\s*["'][^"']*["']/i
+          tag.sub(/\blang\s*=\s*["'][^"']*["']/i, %(lang="#{locale}"))
+        else
+          tag.sub(/<\s*html/i, %(<html lang="#{locale}"))
+        end
+      end
+    end
+
+    def translate_tag(tag, map)
+      return tag if tag.start_with?("<!", "<?")
+
+      tag_name = tag[/\A<\s*([a-zA-Z0-9:-]+)/, 1].to_s.downcase
+      input_type = tag[/\btype\s*=\s*["']([^"']*)["']/i, 1].to_s.downcase
+
+      tag.gsub(/((?<space>\s+)(?<name>[a-zA-Z0-9:_.-]+))\s*=\s*(?<quote>["'])(?<value>[^"']*)\k<quote>/m) do
+        match = Regexp.last_match
+        space = match[:space]
+        attr_name = match[:name]
+        quote = match[:quote]
+        value = match[:value]
+        attribute = "#{space}#{attr_name}=#{quote}#{value}#{quote}"
+
+        next attribute unless translatable_attribute?(attr_name.downcase, tag_name, input_type)
+
+        source = CGI.unescapeHTML(value)
+        next attribute if source.strip.empty?
+
+        translation = translated(source, map)
+        next attribute if translation == source
+
+        leading = source[/\A\s*/]
+        trailing = source[/\s*\z/]
+        escaped = ERB::Util.html_escape(translation)
+        "#{space}#{attr_name}=#{quote}#{leading}#{escaped}#{trailing}#{quote}"
+      end
+    end
+
+    def translatable_attribute?(name, tag_name, input_type)
+      return true if TRANSLATABLE_ATTRIBUTES.include?(name)
+      return true if name.start_with?("aria-") && name != "aria-hidden"
+      return true if name.end_with?("-label", "-label-value", "-prefix-value", "-message-value", "-title-value", "-description-value", "-confirm")
+      return true if %w[data-disable-with data-validation-message data-turbo-confirm].include?(name)
+      return true if tag_name == "meta" && name == "content"
+      return true if %w[input button].include?(tag_name) && name == "value" && %w[submit button].include?(input_type)
+
+      false
+    end
+
+    def translate_text_token(content, map)
+      core = CGI.unescapeHTML(content).strip
+      return content if core.empty?
+
+      leading = content[/\A\s*/]
+      trailing = content[/\s*\z/]
+
+      translation = nil
+      if core.end_with?(SUFFIX) && (prefix = core.delete_suffix(SUFFIX)).present?
+        translated_prefix = translated(prefix, map)
+        translation = "#{translated_prefix}#{SUFFIX}" if translated_prefix != prefix
+      end
+      translation ||= translated(core, map)
+
+      return content if translation.nil? || translation == core
+
+      "#{leading}#{ERB::Util.html_escape(translation)}#{trailing}"
+    end
+  end
+end
