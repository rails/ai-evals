+module Localizable
+  extend ActiveSupport::Concern
+
+  def self.supported_locale?(value)
+    locale = value.to_s.strip.downcase
+    locale.present? && I18n.available_locales.map(&:to_s).include?(locale)
+  end
+
+  class_methods do
+    def supported_locale?(value)
+      Localizable.supported_locale?(value)
+    end
+  end
+
+  def preferred_locale
+    locale.to_s if Localizable.supported_locale?(locale)
+  end
+end
