diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..b6402b1
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,79 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :use_locale
+    helper_method :current_locale
+    etag { current_locale.to_s }
+  end
+
+  private
+    def use_locale(&action)
+      locale = current_locale
+      request.env["fizzy.locale"] = locale.to_s
+      response.headers["Content-Language"] = locale.to_s
+      I18n.with_locale(locale, &action)
+    end
+
+    def current_locale
+      @current_locale ||= begin
+        locale = requested_locale
+        if locale
+          persist_locale(locale)
+          locale
+        else
+          stored_locale || I18n.default_locale
+        end
+      end
+    end
+
+    def requested_locale
+      supported_locale(params[:locale])
+    end
+
+    def stored_locale
+      supported_locale(session[:locale]) ||
+        supported_locale(authenticated_identity&.locale) ||
+        supported_locale(authenticated_user&.locale) ||
+        nil
+    end
+
+    def supported_locale(value)
+      locale = value.to_s.strip.downcase.tr("_", "-")
+      return nil if locale.blank?
+
+      available = I18n.available_locales.map(&:to_s)
+
+      if available.include?(locale)
+        locale
+      elsif (primary = locale[/\A([a-z]{2})(?:-[a-z0-9]+)*\z/, 1]) && available.include?(primary)
+        primary
+      end
+    end
+
+    def persist_locale(locale)
+      session[:locale] = locale
+
+      if (identity = authenticated_identity) && identity.locale != locale
+        identity.update_column(:locale, locale)
+      end
+
+      if (settings = authenticated_user&.settings) && settings.locale != locale
+        settings.update_column(:locale, locale)
+      end
+    end
+
+    def authenticated_identity
+      Current.identity || find_session_by_cookie&.identity
+    rescue StandardError
+      Current.identity
+    end
+
+    def authenticated_user
+      if Current.user&.account_id == Current.account&.id
+        Current.user
+      else
+        authenticated_identity&.users&.find_by(account: Current.account)
+      end
+    end
+end
