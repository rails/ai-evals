@@ -0,0 +1,82 @@
+# Kamal deployment configuration for running Fizzy on a single Linux server.
+#
+# Everything runs in one container: the web process also runs the Solid Queue
+# background workers, and all data is stored in SQLite databases and local
+# Active Storage files under /rails/storage. That directory is backed by the
+# named Docker volume below, so it survives future deploys.
+#
+# Fill in your server address, hostname, and mail server below, then follow
+# the steps in docs/deployment.md.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: fizzy
+
+# Bridge fingerprinted assets between the old and new containers while
+# deploying, so no request ever hits a missing asset.
+asset_path: /rails/public/assets
+
+# Deploy to these servers. Replace this with your server's IP address or
+# hostname (the box must have Docker and be reachable over SSH).
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable automatic SSL via Let's Encrypt through kamal-proxy.
+proxy:
+  ssl: true
+  # Replace with the hostname your Fizzy will be available at. This must
+  # point to the server above, and ports 80 and 443 must be open.
+  host: fizzy.example.com
+
+# Build on your machine and serve the image to the server through Kamal's
+# local registry, so no external container registry is required.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64
+
+# Environment variables injected into the container.
+#
+# `clear` values are visible in the deploy configuration, so only put
+# non-secret settings here. `secret` values are read from .kamal/secrets.
+env:
+  clear:
+    # Hostname used for absolute URLs and email links. Must match proxy.host.
+    APP_FQDN: fizzy.example.com
+
+    # The from address used on outgoing mail.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+
+    # Your mail server. Most providers need port 587 with STARTTLS.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+
+    # Fizzy uses SQLite by default for OSS deployments; make that explicit.
+    DATABASE_ADAPTER: sqlite
+
+    # Run Solid Queue's workers inside the web process rather than in a
+    # second container.
+    SOLID_QUEUE_IN_PUMA: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+
+# Keep the SQLite databases and uploaded files across deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Handy commands once deployed:
+#   bin/kamal console
+#   bin/kamal shell
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
