new file mode 100644
index 0000000..f483541
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,22 @@
+# Secrets used by config/deploy.yml. This file is read by Kamal, so the values
+# below are taken from your environment unless you replace them with literal
+# secrets. Never commit real secrets to this file.
+#
+# Set SECRET_KEY_BASE to a stable value generated with:
+#
+#   export SECRET_KEY_BASE="$(bin/rails secret)"
+#
+# Or run `bin/rails credentials:edit` to create config/master.key (which
+# contains Rails' secret_key_base), and leave SECRET_KEY_BASE unset. The file
+# is picked up automatically below.
+#
+# Finally, set the password for the SMTP account configured in
+# config/deploy.yml:
+#
+#   export SMTP_PASSWORD="..."
+#
+# Keep those environment variables exported in the shell where you run
+# `bin/kamal setup` / `bin/kamal deploy`.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || printf '%s' "$RAILS_MASTER_KEY")
+SMTP_PASSWORD=$SMTP_PASSWORD
