+      smtp_settings[:password] = smtp_password
+      smtp_settings[:authentication] = (ENV["SMTP_AUTHENTICATION"].presence || "plain").to_sym
+    end
+
+    enable_starttls_auto = ENV["SMTP_ENABLE_STARTTLS_AUTO"].presence || ENV["SMTP_ENABLE_STARTTLS"].presence
+    smtp_settings[:enable_starttls_auto] = enable_starttls_auto.nil? ? true : enable_starttls_auto == "true"
+    smtp_settings[:ssl] = true if ENV["SMTP_SSL"] == "true"
+    smtp_settings[:tls] = true if ENV["SMTP_TLS"] == "true"
+    smtp_settings[:openssl_verify_mode] = ENV["SMTP_OPENSSL_VERIFY_MODE"] if ENV["SMTP_OPENSSL_VERIFY_MODE"].present?
+    smtp_settings[:open_timeout] = Integer(ENV["SMTP_OPEN_TIMEOUT"].presence || 5)
+    smtp_settings[:read_timeout] = Integer(ENV["SMTP_READ_TIMEOUT"].presence || 5)
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = smtp_settings
+    config.action_mailer.raise_delivery_errors = true
+  end
+
+  # When no mail server is configured, delivery errors are swallowed so
+  # sign-in still works. Once SMTP_* is set above, errors are raised and
+  # logged so mail misconfiguration is visible.
 
