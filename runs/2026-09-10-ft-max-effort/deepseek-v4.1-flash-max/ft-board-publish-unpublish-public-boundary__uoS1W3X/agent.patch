diff --git a/app/views/public/cards/show.html.erb b/app/views/public/cards/show.html.erb
new file mode 100644
index 0000000..dde20c4
--- /dev/null
+++ b/app/views/public/cards/show.html.erb
@@ -0,0 +1,72 @@
+<% @page_title = @card.title %>
+<% @body_class = "contained-scrolling" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@key), class: "btn btn--circle-mobile", data: { turbo_frame: "_top" } do %>
+      <%= icon_tag "arrow-left" %>
+      <span class="for-screen-reader">Back to <%= @board.name %></span>
+    <% end %>
+  </div>
+<% end %>
+
+<article id="<%= dom_id(@card) %>" class="card card--perma" style="--card-color: <%= @card.color %>;">
+  <% if @card.image.attached? %>
+    <div class="card__background">
+      <%= image_tag url_for(@card.image), alt: "" %>
+    </div>
+  <% end %>
+
+  <header class="card__header">
+    <div class="card__board">
+      <span class="card__id">#<%= @card.number %></span>
+      <span class="card__board-name overflow-ellipsis"><%= @board.name %></span>
+    </div>
+
+    <% if @card.column.present? %>
+      <span class="card__column-name card__column-name--current txt-uppercase"><%= @card.column.name %></span>
+    <% end %>
+  </header>
+
+  <h1 class="card__title"><%= @card.title %></h1>
+
+  <% if @card.description.present? %>
+    <div class="card__description">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <footer class="card__meta">
+    <span class="card__meta-text">Added by <strong><%= @card.creator.familiar_name %></strong> <%= local_datetime_tag @card.created_at, style: :daysago %></span>
+    <span class="card__meta-text">Updated <%= local_datetime_tag @card.last_active_at, style: :daysago %></span>
+
+    <% if @card.tags.any? %>
+      <span class="card__meta-text">Tags: <%= @card.tags.map(&:title).sort.join(", ") %></span>
+    <% end %>
+
+    <% if @card.assignees.any? %>
+      <span class="card__meta-text">Assigned to <%= @card.assignees.map(&:familiar_name).to_sentence %></span>
+    <% end %>
+  </footer>
+</article>
+
+<section class="comments" id="comments" aria-label="Comments">
+  <h2 class="txt-medium txt-uppercase">Comments</h2>
+
+  <% if @comments.any? %>
+    <% @comments.each do |comment| %>
+      <article id="<%= dom_id(comment) %>" class="comment panel">
+        <header class="comment__header txt-small translucent">
+          <strong><%= comment.creator.familiar_name %></strong>
+          <span><%= local_datetime_tag comment.created_at, style: :daysago %></span>
+        </header>
+
+        <div class="comment__body">
+          <%= comment.body %>
+        </div>
+      </article>
+    <% end %>
+  <% else %>
+    <p class="txt-small translucent">No comments</p>
+  <% end %>
+</section>
