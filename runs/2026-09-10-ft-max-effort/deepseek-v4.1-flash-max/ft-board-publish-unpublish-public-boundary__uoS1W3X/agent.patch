diff --git a/app/models/publication.rb b/app/models/publication.rb
new file mode 100644
index 0000000..5b32fcb
--- /dev/null
+++ b/app/models/publication.rb
@@ -0,0 +1,29 @@
+class Publication < ApplicationRecord
+  belongs_to :board, touch: true
+  belongs_to :account, optional: true, default: -> { board&.account }
+
+  has_secure_token :key
+
+  def to_param
+    key
+  end
+
+  def url
+    public_url
+  end
+
+  def public_url
+    return if key.blank?
+
+    Rails.application.routes.url_helpers.public_board_url(self, **url_options)
+  end
+
+  private
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence ||
+        {}
+
+      base_options.merge(script_name: nil)
+    end
+end
