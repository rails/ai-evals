index 0000000..9b6c6ab
--- /dev/null
+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,22 @@
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  private
+    def set_public_board
+      @publication = Publication.find_by(key: params[:key])
+
+      @board = if @publication
+        @publication.board
+      else
+        Board.find_by(public_key: params[:key]) || Board.find_by(key: params[:key])
+      end
+
+      raise ActiveRecord::RecordNotFound unless @board&.public?
+
+      @publication ||= @board.publication
+      @key = params[:key]
+    end
+end
