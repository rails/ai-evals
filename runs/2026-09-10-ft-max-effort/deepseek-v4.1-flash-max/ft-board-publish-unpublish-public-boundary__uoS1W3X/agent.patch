diff --git a/app/models/board.rb b/app/models/board.rb
index 37ecb85..dd84083 100644
--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -7,7 +7,61 @@ class Board < ApplicationRecord
   has_many :tags, -> { distinct }, through: :cards
   has_many :events
   has_many :webhooks, dependent: :destroy
+  has_one :publication, dependent: :destroy
 
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+
+  def public?
+    publication&.persisted? || public_token.present? || published_at.present?
+  end
+  alias_method :published?, :public?
+
+  def publicly_accessible?
+    public?
+  end
+
+  def public_url
+    (publication.public_url if publication&.persisted?) || (public_board_public_url(public_token) if public_token.present?)
+  end
+
+  def public_token
+    if publication&.persisted?
+      publication.key
+    else
+      public_key.presence || self[:key].presence
+    end
+  end
+
+  def publish!
+    transaction do
+      self.publication = publication&.persisted? ? publication : Publication.create!(board: self, account: account, key: public_token)
+      sync_public_token(publication.key)
+      touch(:published_at) unless published_at.present?
+      publication
+    end
+  end
+  alias_method :publish, :publish!
+
+  def unpublish!
+    transaction do
+      publication&.destroy!
+      association(:publication).reset
+      sync_public_token(nil)
+      update!(published_at: nil) if published_at.present?
+    end
+  end
+  alias_method :unpublish, :unpublish!
+
+  private
+    def sync_public_token(token)
+      attributes = {}
+      attributes[:public_key] = token if public_key != token
+      attributes[:key] = token if self[:key] != token
+      update!(attributes) if attributes.any?
+    end
+
+    def public_board_public_url(token)
+      Publication.new(key: token).public_url
+    end
 end
