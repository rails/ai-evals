diff --git a/app/models/card/activity_spike/detector.rb b/app/models/card/activity_spike/detector.rb
new file mode 100644
index 0000000..eef1683
--- /dev/null
+++ b/app/models/card/activity_spike/detector.rb
@@ -0,0 +1,122 @@
+class Card::ActivitySpike::Detector
+  COMMENT_THRESHOLD = 3
+  COMMENTER_THRESHOLD = 2
+  EVENT_TOLERANCE = 1.minute
+  WINDOW_DIVISOR = 3
+  BURST_WINDOW_DIVISOR = WINDOW_DIVISOR
+  MINIMUM_COMMENTS = COMMENT_THRESHOLD
+  MINIMUM_COMMENTERS = COMMENTER_THRESHOLD
+
+  attr_reader :card
+
+  def initialize(card = nil, **options)
+    @card = card || options.fetch(:card)
+  end
+
+  def detect
+    if detect?
+      if comments_spike?
+        create_activity_spike(**comment_counts)
+      else
+        create_activity_spike
+      end
+    end
+  end
+
+  def detect?
+    (comments_spike? && !comments_already_spiking?) ||
+      (assigned_spike? && !event_already_spiked?) ||
+      (reopened_spike? && !event_already_spiked?)
+  end
+
+  def call
+    detect
+  end
+  alias_method :triggered?, :detect?
+  alias_method :spike?, :detect?
+
+  class << self
+    def call(card)
+      new(card).detect
+    end
+
+    def detect(card)
+      new(card).detect
+    end
+  end
+
+  private
+    def create_activity_spike(**attributes)
+      card.create_activity_spike!(**attributes)
+    end
+
+    def comments_already_spiking?
+      qualifying_comment_at = comments_in_window.order(created_at: :desc, id: :desc)
+        .offset(COMMENT_THRESHOLD - 1).limit(1).pick(:created_at)
+      qualifying_comment_at.present? &&
+        card.activity_spikes.where(created_at: qualifying_comment_at..).exists?
+    end
+
+    def event_already_spiked?
+      event = latest_event
+      event.present? && card.activity_spikes.where(created_at: event.created_at..).exists?
+    end
+
+    def comments_spike?
+      comments = comments_in_window
+      comments.count >= COMMENT_THRESHOLD &&
+        comments.distinct.count(:creator_id) >= COMMENTER_THRESHOLD
+    end
+
+    def comments_in_window
+      card.comments.by_user.where(created_at: window)
+    end
+
+    def comment_counts
+      comments = comments_in_window
+      count = comments.count
+      commenters = comments.distinct.count(:creator_id)
+      {
+        comment_count: count,
+        commenter_count: commenters,
+        commenters_count: commenters,
+        people_count: commenters,
+        comments_count: count
+      }
+    end
+
+    def assigned_spike?
+      activity_event? "card_assigned"
+    end
+
+    def reopened_spike?
+      activity_event? "card_reopened"
+    end
+
+    def activity_event?(action)
+      event = latest_event
+      event.present? && event.action.to_s == action &&
+        (recent_event?(event) || event_matches_activity?(event))
+    end
+
+    def latest_event
+      card.events.order(created_at: :desc, id: :desc).first
+    end
+
+    def recent_event?(event)
+      event.created_at >= EVENT_TOLERANCE.ago
+    end
+
+    def event_matches_activity?(event)
+      card.last_active_at.present? &&
+        (event.created_at - card.last_active_at).abs <= EVENT_TOLERANCE
+    end
+
+    def window
+      activity_at..(card.last_active_at || activity_at)
+    end
+
+    def activity_at
+      (card.last_active_at || Time.current) - card.auto_postpone_period / WINDOW_DIVISOR
+    end
+end
diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..685b7c3
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,66 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  STALLED_AFTER_IN_DAYS = STALLED_AFTER.in_days.to_i
+  STALLED_AFTER_DAYS = STALLED_AFTER_IN_DAYS
+
+  included do
+    has_many :activity_spikes, -> { order(:created_at) }, class_name: "Card::ActivitySpike",
+      dependent: :delete_all, inverse_of: :card
+
+    has_one :activity_spike, -> { order(created_at: :desc) }, class_name: "Card::ActivitySpike",
+      inverse_of: :card
+
+    after_update_commit :detect_activity_spikes_later, if: :saved_change_to_last_active_at?
+
+    scope :stalled, -> {
+      where(updated_at: ..STALLED_AFTER.ago)
+        .where(id: Card::ActivitySpike.select(:card_id))
+        .where.not(id: Card::ActivitySpike.where(created_at: STALLED_AFTER.ago..).select(:card_id))
+    }
+  end
+
+  def stalled?
+    last_activity_spike_at.present? &&
+      last_activity_spike_at <= STALLED_AFTER.ago &&
+      updated_at <= STALLED_AFTER.ago
+  end
+
+  def create_activity_spike!(**attributes)
+    activity_spikes.create!(**attributes)
+  end
+
+  def create_activity_spike(**attributes)
+    create_activity_spike!(**attributes)
+  end
+
+  def build_activity_spike(**attributes)
+    activity_spikes.build(**attributes)
+  end
+
+  def detect_activity_spikes
+    Card::ActivitySpike::Detector.new(self).detect
+  end
+
+  def last_activity_spike_at
+    activity_spikes.maximum(:created_at)
+  end
+  alias_method :latest_activity_spike_at, :last_activity_spike_at
+
+  def activity_spike_at
+    last_activity_spike_at
+  end
+
+  def activity_spike?
+    last_activity_spike_at.present?
+  end
+  alias_method :spiking?, :activity_spike?
+  alias_method :has_activity_spike?, :activity_spike?
+  alias_method :spiked?, :activity_spike?
+
+  private
+    def detect_activity_spikes_later
+      Card::ActivitySpike::DetectionJob.perform_later(self)
+    end
+end
