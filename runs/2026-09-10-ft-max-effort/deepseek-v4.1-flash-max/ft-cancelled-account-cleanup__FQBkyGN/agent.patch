diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..ef2c0d5 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,41 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :cancelled, -> { joins(:cancellation) }
+
+    scope :due_for_incineration, -> {
+      cancelled.where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago })
+    }
+
+    scope :incineratable, -> { due_for_incineration }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+    alias_method :incinerate_all_due, :incinerate_due
+  end
+
+  def incinerate
+    destroy!
+    delete_leftovers
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+  end
+  alias_method :incineratable?, :due_for_incineration?
+
+  private
+    def delete_leftovers
+      Storage::Entry.where(account_id: id).delete_all
+
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy)
+
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
 end
