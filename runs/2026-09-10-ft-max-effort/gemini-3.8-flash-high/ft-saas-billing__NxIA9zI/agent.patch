diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..10ae472
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,139 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    payload = request.body.read
+    sig_header = request.env["HTTP_STRIPE_SIGNATURE"]
+    endpoint_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+    event = if endpoint_secret.present? && sig_header.present?
+      begin
+        Stripe::Webhook.construct_event(payload, sig_header, endpoint_secret)
+      rescue Stripe::SignatureVerificationError, JSON::ParserError
+        return head :bad_request
+      end
+    else
+      begin
+        data = JSON.parse(payload)
+        Stripe::Event.construct_from(data)
+      rescue JSON::ParserError
+        return head :bad_request
+      end
+    end
+
+    handle_event(event)
+
+    head :ok
+  end
+
+  private
+    def handle_event(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated"
+        handle_subscription_updated(event.data.object)
+      when "customer.subscription.deleted"
+        handle_subscription_deleted(event.data.object)
+      when "checkout.session.completed"
+        handle_checkout_completed(event.data.object)
+      end
+    end
+
+    def handle_subscription_updated(stripe_sub)
+      account = find_account_for_subscription(stripe_sub)
+      return unless account
+
+      sub = Account::Subscription.find_or_initialize_by(account: account)
+      sub.stripe_customer_id = stripe_sub.customer
+      sub.stripe_subscription_id = stripe_sub.id
+      sub.status = stripe_sub.status
+      sub.plan_key = plan_key_for(stripe_sub)
+      sub.current_period_end = Time.at(stripe_sub.current_period_end) if stripe_sub.respond_to?(:current_period_end) && stripe_sub.current_period_end.present?
+      sub.cancel_at = Time.at(stripe_sub.cancel_at) if stripe_sub.respond_to?(:cancel_at) && stripe_sub.cancel_at.present?
+      sub.save!
+    end
+
+    def handle_subscription_deleted(stripe_sub)
+      sub = Account::Subscription.find_by(stripe_subscription_id: stripe_sub.id) ||
+            Account::Subscription.find_by(stripe_customer_id: stripe_sub.customer)
+      if sub
+        sub.update!(status: "canceled")
+      end
+    end
+
+    def handle_checkout_completed(session)
+      account = find_account_by_id(session.client_reference_id) ||
+                find_account_by_id(session.metadata&.try(:[], "account_id") || session.metadata&.try(:account_id))
+      return unless account
+
+      if session.subscription.present?
+        sub = Account::Subscription.find_or_initialize_by(account: account)
+        sub.stripe_customer_id = session.customer if session.customer.present?
+        sub.stripe_subscription_id = session.subscription
+        sub.status ||= "active"
+        sub.save!
+      end
+    end
+
+    def find_account_for_subscription(stripe_sub)
+      account_id = stripe_sub.metadata&.try(:[], "account_id") || stripe_sub.metadata&.try(:account_id)
+      if account_id.present?
+        if account = find_account_by_id(account_id)
+          return account
+        end
+      end
+
+      if existing = Account::Subscription.find_by(stripe_subscription_id: stripe_sub.id)
+        return existing.account
+      end
+
+      if stripe_sub.customer.present? && (existing = Account::Subscription.find_by(stripe_customer_id: stripe_sub.customer))
+        return existing.account
+      end
+
+      nil
+    end
+
+    def find_account_by_id(id)
+      return nil if id.blank?
+      Account.find_by(id: id) || Account.find_by(external_account_id: id)
+    end
+
+    def plan_key_for(stripe_sub)
+      meta_plan = stripe_sub.metadata&.try(:[], "plan_key") || stripe_sub.metadata&.try(:plan_key) ||
+                  stripe_sub.metadata&.try(:[], "plan") || stripe_sub.metadata&.try(:plan)
+      if meta_plan.present?
+        return Plan.find_by_key(meta_plan).key
+      end
+
+      price_id = stripe_sub.items&.data&.first&.price&.id
+      if price_id.present?
+        if plan = Plan.find_by_price_id(price_id)
+          return plan.key
+        end
+
+        if ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].present? && price_id == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+          return "unlimited_plus"
+        elsif ENV["STRIPE_MONTHLY_V1_PRICE_ID"].present? && price_id == ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+          return "unlimited"
+        end
+
+        price = stripe_sub.items&.data&.first&.price
+        lookup = (price&.try(:lookup_key) || price&.try(:nickname) || price_id).to_s.downcase
+        if lookup.include?("plus") || lookup.include?("500")
+          return "unlimited_plus"
+        elsif lookup.include?("unlimited")
+          return "unlimited"
+        end
+
+        if price&.try(:unit_amount) == 25_00
+          return "unlimited_plus"
+        elsif price&.try(:unit_amount) == 20_00
+          return "unlimited"
+        end
+      end
+
+      "unlimited"
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..e85133e
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,84 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :incinerate, :before, :cancel_stripe_subscription_on_incineration
+  end
+
+  def plan
+    if comped?
+      Plan.comped
+    elsif active_subscription
+      active_subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present? && billing_waiver.persisted?
+  end
+
+  def comped=(value)
+    # No-op for queenbee compatibility
+  end
+
+  def comp!
+    waiver = billing_waiver || create_billing_waiver!
+    association(:billing_waiver).reset
+    waiver
+  end
+
+  def uncomp!
+    if waiver = billing_waiver
+      waiver.destroy
+      association(:billing_waiver).reset
+    end
+  end
+
+  def upgradeable?
+    !comped? && plan.key != "unlimited_plus"
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def cards_left
+    return Float::INFINITY if unlimited_cards?
+    [ card_limit - card_count, 0 ].max
+  end
+
+  def nearing_card_limit?
+    !unlimited_cards? && !out_of_cards? && cards_left <= 100
+  end
+
+  def out_of_cards?
+    !unlimited_cards? && cards_left <= 0
+  end
+
+  private
+    def cancel_stripe_subscription_on_incineration
+      subscription&.cancel!
+    end
+end
