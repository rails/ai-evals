diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..aef170e
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,25 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  def active?
+    status.in?(%w[ active trialing ])
+  end
+
+  def plan
+    Plan.find_by_key(plan_key)
+  end
+
+  def cancel!
+    if stripe_subscription_id.present? && defined?(Stripe::Subscription)
+      begin
+        Stripe::Subscription.cancel(stripe_subscription_id)
+      rescue => e
+        Rails.logger.error("Failed to cancel Stripe subscription #{stripe_subscription_id}: #{e.message}")
+      end
+    end
+    update!(status: "canceled") unless destroyed? || frozen?
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..8846c88
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,106 @@
+class Plan
+  attr_reader :key, :name, :card_limit, :storage_limit, :price_in_cents
+
+  def initialize(key:, name:, card_limit:, storage_limit:, price_in_cents:, stripe_price_id_env_key: nil)
+    @key = key
+    @name = name
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_in_cents = price_in_cents
+    @stripe_price_id_env_key = stripe_price_id_env_key
+  end
+
+  def stripe_price_id
+    ENV[@stripe_price_id_env_key] if @stripe_price_id_env_key
+  end
+
+  def to_s
+    name
+  end
+
+  def free?
+    key == "free"
+  end
+
+  def paid?
+    !free?
+  end
+
+  def comped?
+    key == "comped"
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  PLANS = [
+    new(
+      key: "free",
+      name: "Free",
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte,
+      price_in_cents: 0
+    ),
+    new(
+      key: "unlimited",
+      name: "Unlimited",
+      card_limit: nil,
+      storage_limit: 5.gigabytes,
+      price_in_cents: 20_00,
+      stripe_price_id_env_key: "STRIPE_MONTHLY_V1_PRICE_ID"
+    ),
+    new(
+      key: "unlimited_plus",
+      name: "Unlimited+",
+      card_limit: nil,
+      storage_limit: 500.gigabytes,
+      price_in_cents: 25_00,
+      stripe_price_id_env_key: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+    ),
+    new(
+      key: "comped",
+      name: "Comped",
+      card_limit: nil,
+      storage_limit: 5.gigabytes,
+      price_in_cents: 0
+    )
+  ].freeze
+
+  PLANS_BY_KEY = PLANS.index_by(&:key).freeze
+
+  class << self
+    def all
+      PLANS
+    end
+
+    def free
+      PLANS_BY_KEY["free"]
+    end
+
+    def unlimited
+      PLANS_BY_KEY["unlimited"]
+    end
+
+    def unlimited_plus
+      PLANS_BY_KEY["unlimited_plus"]
+    end
+
+    def comped
+      PLANS_BY_KEY["comped"]
+    end
+
+    def find_by_key(key)
+      return free if key.blank?
+      normalized = key.to_s.underscore.sub(/_v\d+$/, "")
+      normalized = "unlimited_plus" if normalized.include?("extra") || normalized.include?("plus")
+      normalized = "unlimited" if normalized == "unlimited" || normalized == "monthly"
+      PLANS_BY_KEY[normalized] || free
+    end
+
+    def find_by_price_id(price_id)
+      return nil if price_id.blank?
+      all.find { |p| p.stripe_price_id.present? && p.stripe_price_id == price_id }
+    end
+  end
+end
