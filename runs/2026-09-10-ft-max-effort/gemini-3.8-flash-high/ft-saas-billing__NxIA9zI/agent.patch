@@ -0,0 +1,36 @@
+class Admin::Accounts::OverridesController < AdminController
+  before_action :set_account
+
+  def create
+    card_count = override_params[:card_count].presence
+    bytes_used = override_params[:bytes_used].presence
+
+    override = @account.overridden_limit || @account.build_overridden_limit
+    override.card_count = card_count
+    override.bytes_used = bytes_used
+    override.save!
+
+    redirect_to admin_account_path(@account), notice: "Override updated"
+  end
+
+  def destroy
+    @account.overridden_limit&.destroy
+    redirect_to admin_account_path(@account), notice: "Override reset"
+  end
+
+  private
+    def set_account
+      account_id = params[:account_id] || params[:id]
+      @account = Account.find_by(id: account_id) ||
+                 Account.find_by(external_account_id: account_id) ||
+                 Account.find(account_id)
+    end
+
+    def override_params
+      if params[:override].present?
+        params.require(:override).permit(:card_count, :bytes_used)
+      else
+        params.permit(:card_count, :bytes_used)
+      end
+    end
+end
