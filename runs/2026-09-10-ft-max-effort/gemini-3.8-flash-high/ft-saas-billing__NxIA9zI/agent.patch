diff --git a/saas/test/controllers/account/settings_controller_test.rb b/saas/test/controllers/account/settings_controller_test.rb
new file mode 100644
index 0000000..9ad52b6
--- /dev/null
+++ b/saas/test/controllers/account/settings_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Account::SettingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    users(:jz).update!(role: :member, active: true)
+    users(:kevin).update!(role: :admin, active: true)
+  end
+
+  test "admin sees their plan and Upgrade in settings" do
+    logout_and_sign_in_as :kevin
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "header", text: /Subscription/
+    assert_select "strong", text: "Free"
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "non-admin does not see plan and Upgrade in settings" do
+    logout_and_sign_in_as :jz
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "section.settings__section header", text: /Subscription/, count: 0
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
