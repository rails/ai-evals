+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "non-staff cannot access admin accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can access admin accounts which lists accounts with names opening their page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(@account)}']", text: @account.name
+    end
+  end
+
+  test "account show page has Comp, Uncomp, override form with Card count and Bytes used submitted by Override, and Reset" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value='Override']"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "staff can comp and uncomp an account" do
+    sign_in_as :david
+
+    assert_not @account.comped?
+
+    untenanted do
+      post saas.admin_account_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+    assert @account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+    assert_not @account.reload.comped?
+  end
+
+  test "staff can set override with Card count and Bytes used and reset it" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_override_path(@account), params: {
+        override: { card_count: 950, bytes_used: 2.gigabytes }
+      }
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+    @account.reload
+    assert_equal 950, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_override_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+    end
+    assert_nil @account.reload.overridden_limit
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..e6447c8
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    @account.update_column(:cards_count, 100)
+  end
+
+  test "free account that runs out of cards can still draft via HTML" do
+    sign_in_as :mike
+
+    @account.create_overridden_limit!(card_count: 1_000)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "creating cards through the API is refused when out of cards" do
+    sign_in_as :mike
+
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "API blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "publishing is refused when out of cards" do
+    sign_in_as :mike
+
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    post card_publish_path(@draft, script_name: @account.slug)
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "staff can create cards via JSON and publish even when out of cards" do
+    sign_in_as :mike
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Staff card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "create buttons give way to an Upgrade pitch when out of cards" do
+    sign_in_as :mike
+
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message" do
+      assert_select "strong", text: /run out of cards/
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "warning counts down from 100 cards out" do
+    sign_in_as :mike
+
+    @account.create_overridden_limit!(card_count: 950)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select "strong", text: "50 cards left"
+  end
+
+  test "paid account does not run out of cards" do
+    sign_in_as :mike
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      status: "active",
+      plan_key: "unlimited"
+    )
+    @account.create_overridden_limit!(card_count: 1_500)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select "strong", text: /cards left/, count: 0
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "comped account does not run out of cards" do
+    sign_in_as :mike
+
+    @account.comp!
+    @account.create_overridden_limit!(card_count: 1_500)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..3d96cbc
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "subscription created webhook creates subscription" do
+    payload = {
+      id: "evt_sub_created",
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_new_123",
+          customer: "cus_new_123",
+          status: "active",
+          current_period_end: 1.month.from_now.to_i,
+          cancel_at: nil,
+          items: {
+            data: [
+              { price: { id: "price_unlimited", unit_amount: 2000 } }
+            ]
+          },
+          metadata: {
+            account_id: @account.id
+          }
+        }
+      }
+    }.to_json
+
+    untenanted do
+      post "/stripe/webhooks",
+        headers: { "RAW_POST_DATA" => payload },
+        params: payload
+    end
+
+    assert_response :ok
+
+    subscription = @account.subscription.reload
+    assert_equal "sub_new_123", subscription.stripe_subscription_id
+    assert_equal "cus_new_123", subscription.stripe_customer_id
+    assert_equal "active", subscription.status
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "Unlimited", @account.plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "subscription updated to unlimited plus webhook updates plan and storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_existing",
+      stripe_subscription_id: "sub_existing",
+      status: "active",
+      plan_key: "unlimited"
+    )
+
+    payload = {
+      id: "evt_sub_updated",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_existing",
+          customer: "cus_existing",
+          status: "active",
+          current_period_end: 1.month.from_now.to_i,
+          cancel_at: nil,
+          items: {
+            data: [
+              { price: { id: "price_unlimited_plus", unit_amount: 2500 } }
+            ]
+          },
+          metadata: {
+            account_id: @account.id
+          }
+        }
+      }
+    }.to_json
+
+    untenanted do
+      post "/stripe/webhooks",
+        headers: { "RAW_POST_DATA" => payload },
+        params: payload
+    end
+
+    assert_response :ok
+
+    @account.reload
+    assert_equal "unlimited_plus", @account.subscription.plan_key
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "subscription deleted webhook cancels subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_to_delete",
+      stripe_subscription_id: "sub_to_delete",
+      status: "active",
+      plan_key: "unlimited"
+    )
+
+    payload = {
+      id: "evt_sub_deleted",
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_to_delete",
+          customer: "cus_to_delete",
+          status: "canceled"
+        }
+      }
+    }.to_json
+
+    untenanted do
+      post "/stripe/webhooks",
+        headers: { "RAW_POST_DATA" => payload },
+        params: payload
+    end
+
+    assert_response :ok
+
+    @account.reload
+    assert_equal "canceled", @account.subscription.status
+    assert_equal "Free", @account.plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "invalid stripe signature returns bad request" do
+    payload = { id: "evt_test", type: "unknown" }.to_json
+
+    untenanted do
+      post "/stripe/webhooks",
+        headers: {
+          "RAW_POST_DATA" => payload,
+          "HTTP_STRIPE_SIGNATURE" => "t=123,v1=invalid_signature"
+        },
+        params: payload
+    end
+
+    assert_response :bad_request
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..5a3aad6
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "default plan is Free with 1,000 cards and 1 GB" do
+    assert_equal "Free", @account.plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.unlimited_cards?
+  end
+
+  test "Unlimited plan has unlimited cards and 5 GB storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      status: "active",
+      plan_key: "unlimited"
+    )
+
+    assert_equal "Unlimited", @account.plan.name
+    assert_nil @account.card_limit
+    assert @account.unlimited_cards?
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "Unlimited+ plan has unlimited cards and 500 GB storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_456",
+      stripe_subscription_id: "sub_456",
+      status: "active",
+      plan_key: "unlimited_plus"
+    )
+
+    assert_equal "Unlimited+", @account.plan.name
+    assert_nil @account.card_limit
+    assert @account.unlimited_cards?
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "storage exception overrides plan storage limit" do
+    @account.add_storage_exception(10.gigabytes)
+    assert_equal 10.gigabytes, @account.storage_limit
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_789",
+      stripe_subscription_id: "sub_789",
+      status: "active",
+      plan_key: "unlimited"
+    )
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "comp and uncomp toggles billing waiver" do
+    assert_not @account.comped?
+
+    @account.comp!
+    assert @account.comped?
+    assert_equal "Comped", @account.plan.name
+    assert @account.unlimited_cards?
+
+    @account.uncomp!
+    assert_not @account.comped?
+    assert_equal "Free", @account.plan.name
+  end
+
+  test "override sets card count and bytes used, reset clears them" do
+    override = @account.create_overridden_limit!(card_count: 950, bytes_used: 2.gigabytes)
+
+    assert_equal 950, @account.card_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert_equal 50, @account.cards_left
+    assert @account.nearing_card_limit?
+    assert_not @account.out_of_cards?
+
+    override.update!(card_count: 1000)
+    assert_equal 1000, @account.card_count
+    assert_equal 0, @account.cards_left
+    assert @account.out_of_cards?
+    assert_not @account.nearing_card_limit?
+
+    override.destroy
+    @account.reload
+    assert_equal @account.cards_count, @account.card_count
+    assert_not @account.out_of_cards?
+  end
+
+  test "incinerating account cancels stripe subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_incinerate",
+      stripe_subscription_id: "sub_incinerate",
+      status: "active",
+      plan_key: "unlimited"
+    )
+
+    Stripe::Subscription.expects(:cancel).with("sub_incinerate").returns(true)
+
+    @account.incinerate
+  end
+end
