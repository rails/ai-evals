@@ -0,0 +1,32 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">All Accounts (<%= @accounts.count %>)</h2>
+    </header>
+
+    <ul class="margin-block-half">
+      <% @accounts.each do |account| %>
+        <li class="flex align-start gap-half margin-block-start-half">
+          <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+            <strong><%= link_to account.name, admin_account_path(account) %></strong>
+            <br>
+            <span class="txt-x-small txt-ink-medium">
+              #<%= account.external_account_id %> • <%= account.plan.name %>
+              <%= " • Comped" if account.comped? %>
+            </span>
+          </div>
+
+          <div class="txt-medium txt-ink-medium" style="text-align: right">
+            <%= number_with_delimiter(account.card_count) %> cards
+          </div>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+</section>
diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..1bec0f1
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,62 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+  <div class="txt-normal font-weight-normal"><%= link_to "← All Accounts", admin_accounts_path %></div>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account Details</h2>
+    </header>
+
+    <div class="margin-block-half flex flex-column gap-quarter">
+      <div><strong>External ID:</strong> #<%= @account.external_account_id %></div>
+      <div><strong>Plan:</strong> <%= @account.plan.name %></div>
+      <div><strong>Status:</strong> <%= @account.comped? ? "Comped" : "Standard" %></div>
+      <div><strong>Card Count:</strong> <%= number_with_delimiter(@account.card_count) %> <%= "(overridden)" if @account.overridden_limit&.card_count.present? %></div>
+      <div><strong>Bytes Used:</strong> <%= number_to_human_size(@account.bytes_used) %> <%= "(overridden)" if @account.overridden_limit&.bytes_used.present? %></div>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing Waiver</h2>
+    </header>
+
+    <div class="flex gap-half margin-block-half">
+      <% if @account.comped? %>
+        <%= button_to "Comp", admin_account_waiver_path(@account), method: :post, class: "btn", disabled: true %>
+        <%= button_to "Uncomp", admin_account_waiver_path(@account), method: :delete, class: "btn" %>
+      <% else %>
+        <%= button_to "Comp", admin_account_waiver_path(@account), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", admin_account_waiver_path(@account), method: :delete, class: "btn", disabled: true %>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override Limits</h2>
+    </header>
+
+    <%= form_with url: admin_account_override_path(@account), method: :post, scope: :override, class: "flex flex-column gap-half margin-block-half" do |f| %>
+      <div class="flex flex-column gap-quarter">
+        <%= f.label :card_count, "Card count", class: "txt-small" %>
+        <%= f.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input", placeholder: "e.g. 950" %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= f.label :bytes_used, "Bytes used", class: "txt-small" %>
+        <%= f.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input", placeholder: "e.g. 1073741824" %>
+      </div>
+
+      <div class="flex gap-half margin-block-start-half">
+        <%= f.submit "Override", class: "btn btn--primary" %>
+      </div>
+    <% end %>
+
+    <div class="margin-block-half">
+      <%= button_to "Reset", admin_account_override_path(@account), method: :delete, class: "btn btn--reversed" %>
+    </div>
+  </div>
+</section>
