+++ b/app/controllers/account/upgrades_controller.rb
@@ -0,0 +1,33 @@
+class Account::UpgradesController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    create
+  end
+
+  def create
+    price_id = params[:price_id] || (params[:plan] == "unlimited_plus" ? (ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] || "price_unlimited_plus") : (ENV["STRIPE_MONTHLY_V1_PRICE_ID"] || "price_unlimited"))
+
+    if Current.account.subscription&.active? && Current.account.subscription&.stripe_customer_id.present?
+      session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.subscription.stripe_customer_id,
+        return_url: account_settings_url
+      )
+      redirect_to session.url, allow_other_host: true, status: :see_other
+    else
+      session = Stripe::Checkout::Session.create(
+        customer: Current.account.subscription&.stripe_customer_id,
+        mode: "subscription",
+        line_items: [ { price: price_id, quantity: 1 } ],
+        success_url: account_settings_url,
+        cancel_url: account_settings_url,
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id },
+        subscription_data: {
+          metadata: { account_id: Current.account.id }
+        }
+      )
+      redirect_to session.url, allow_other_host: true, status: :see_other
+    end
+  end
+end
