+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+
+  def plan
+    Plan[plan_key]
+  end
+
+  def plan=(new_plan)
+    self.plan_key = new_plan.respond_to?(:key) ? new_plan.key : new_plan.to_s
+  end
+
+  def active?
+    status.in?(%w[ active trialing ])
+  end
+
+  def paid?
+    active? && plan.paid?
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def cancel_at_period_end?
+    cancel_at.present?
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..38c89c2
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,120 @@
+class Plan
+  attr_reader :key, :name, :card_limit, :storage_limit, :price_in_cents, :price_description
+
+  def initialize(key:, name:, card_limit:, storage_limit:, price_in_cents:, price_description:, stripe_price_id:)
+    @key = key
+    @name = name
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_in_cents = price_in_cents
+    @price_description = price_description
+    @stripe_price_id_proc = stripe_price_id
+  end
+
+  FREE = new(
+    key: "free",
+    name: "Free",
+    card_limit: 1000,
+    storage_limit: 1.gigabyte,
+    price_in_cents: 0,
+    price_description: "Free",
+    stripe_price_id: nil
+  )
+
+  UNLIMITED = new(
+    key: "unlimited",
+    name: "Unlimited",
+    card_limit: nil,
+    storage_limit: 5.gigabytes,
+    price_in_cents: 2000,
+    price_description: "$20/month",
+    stripe_price_id: -> { ENV["STRIPE_MONTHLY_V1_PRICE_ID"] }
+  )
+
+  UNLIMITED_PLUS = new(
+    key: "unlimited_plus",
+    name: "Unlimited+",
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    price_in_cents: 2500,
+    price_description: "$25/month",
+    stripe_price_id: -> { ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] }
+  )
+
+  COMPED = new(
+    key: "comped",
+    name: "Comped",
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    price_in_cents: 0,
+    price_description: "Comped",
+    stripe_price_id: nil
+  )
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  class << self
+    def all
+      ALL
+    end
+
+    def [](key)
+      return key if key.is_a?(Plan)
+      return FREE if key.blank?
+
+      k = key.to_s.downcase.tr("+", "_plus").underscore
+      return COMPED if k == "comped"
+
+      ALL.find { |p| p.key == k || p.name.downcase == key.to_s.downcase } ||
+        by_stripe_price_id(key.to_s) ||
+        FREE
+    end
+
+    def by_stripe_price_id(price_id)
+      return nil if price_id.blank?
+
+      if price_id == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] || price_id.to_s.include?("extra_storage") || price_id.to_s.include?("plus")
+        UNLIMITED_PLUS
+      elsif price_id == ENV["STRIPE_MONTHLY_V1_PRICE_ID"] || price_id.to_s.include?("monthly") || price_id.to_s.include?("unlimited")
+        UNLIMITED
+      else
+        nil
+      end
+    end
+  end
+
+  def stripe_price_id
+    @stripe_price_id_proc.respond_to?(:call) ? @stripe_price_id_proc.call : @stripe_price_id_proc
+  end
+
+  def free?
+    @key == "free"
+  end
+
+  def paid?
+    !free? && !comped?
+  end
+
+  def comped?
+    @key == "comped"
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def to_s
+    name
+  end
+
+  def ==(other)
+    if other.is_a?(Plan)
+      key == other.key
+    elsif other.is_a?(String) || other.is_a?(Symbol)
+      k = other.to_s.downcase.tr("+", "_plus").underscore
+      key == k || name.downcase == other.to_s.downcase
+    else
+      super
+    end
+  end
+end
diff --git a/saas/app/views/account/settings/_billing.html.erb b/saas/app/views/account/settings/_billing.html.erb
