diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..549b18d
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,59 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to "Accounts", saas.admin_accounts_path(script_name: nil), class: "txt-current" %> / <%= @page_title %>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account Details</h2>
+    </header>
+
+    <div class="flex flex-column gap-half margin-block-half">
+      <div><strong>Name:</strong> <%= @account.name %></div>
+      <div><strong>ID:</strong> <%= @account.external_account_id %></div>
+      <div><strong>Plan:</strong> <%= @account.plan.name %></div>
+      <div><strong>Status:</strong> <%= @account.comped? ? "Comped" : "Standard" %></div>
+      <div><strong>Cards:</strong> <%= number_with_delimiter(@account.cards_count) %> <%= "(overridden)" if @account.overridden_limit&.card_count.present? %></div>
+      <div><strong>Storage:</strong> <%= number_to_human_size(@account.bytes_used) %> / <%= number_to_human_size(@account.storage_limit) %> <%= "(overridden)" if @account.overridden_limit&.bytes_used.present? %></div>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Comp</h2>
+    </header>
+
+    <div class="flex gap-half margin-block-half">
+      <%= button_to "Comp", saas.comp_admin_account_path(@account, script_name: nil), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account, script_name: nil), method: :post, class: "btn btn--reversed" %>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override Limits</h2>
+    </header>
+
+    <div class="margin-block-half">
+      <%= form_with url: saas.override_admin_account_path(@account, script_name: nil), method: :post, class: "flex flex-column gap-half" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used", class: "txt-small font-weight-bold" %>
+          <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+        </div>
+
+        <div class="flex gap-half margin-block-start-quarter">
+          <button type="submit" class="btn">Override</button>
+        </div>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", saas.reset_admin_account_path(@account, script_name: nil), method: :post, class: "btn btn--reversed" %>
+      </div>
+    </div>
+  </div>
+</section>
