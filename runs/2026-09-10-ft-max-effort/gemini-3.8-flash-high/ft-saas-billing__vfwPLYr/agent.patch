diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..bbbc171
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,42 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+  before_action :set_account, except: :index
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Account uncomped"
+  end
+
+  def override
+    card_count = params[:card_count].presence || params.dig(:override, :card_count).presence || params.dig(:account, :card_count).presence
+    bytes_used = params[:bytes_used].presence || params.dig(:override, :bytes_used).presence || params.dig(:account, :bytes_used).presence
+
+    @account.override_limits!(card_count: card_count, bytes_used: bytes_used)
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Limits overridden"
+  end
+
+  def reset
+    @account.reset_overridden_limits!
+    redirect_to saas.admin_account_path(@account, script_name: nil), notice: "Override reset"
+  end
+
+  private
+    def set_account
+      id = params[:id] || params[:account_id]
+      @account = Account.find_by(id: id) ||
+                 Account.find_by(external_account_id: id) ||
+                 Account.find(id)
+    end
+end
diff --git a/saas/app/controllers/billings_controller.rb b/saas/app/controllers/billings_controller.rb
new file mode 100644
index 0000000..605401f
--- /dev/null
+++ b/saas/app/controllers/billings_controller.rb
@@ -0,0 +1,78 @@
+class BillingsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    initiate_billing
+  end
+
+  def create
+    initiate_billing
+  end
+
+  private
+    def initiate_billing
+      if Current.account.subscription&.active? && Current.account.subscription.stripe_customer_id.present?
+        if params[:plan] == "unlimited_plus" && Current.account.plan.key != "unlimited_plus"
+          redirect_to_checkout(plan: "unlimited_plus")
+        else
+          redirect_to_portal
+        end
+      else
+        redirect_to_checkout(plan: params[:plan] || "unlimited")
+      end
+    end
+
+    def redirect_to_checkout(plan: "unlimited")
+      price_id = if plan.to_s.include?("plus")
+        ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      else
+        ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      end
+
+      session_params = {
+        mode: "subscription",
+        payment_method_types: [ "card" ],
+        line_items: [ { price: price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: plan },
+        subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan } },
+        success_url: account_settings_url(script_name: Current.account.slug),
+        cancel_url: account_settings_url(script_name: Current.account.slug)
+      }
+
+      if Current.account.subscription&.stripe_customer_id.present?
+        session_params[:customer] = Current.account.subscription.stripe_customer_id
+      elsif Current.user&.identity&.email_address.present?
+        session_params[:customer_email] = Current.user.identity.email_address
+      end
+
+      begin
+        session = Stripe::Checkout::Session.create(session_params)
+        redirect_to session.url, allow_other_host: true
+      rescue Stripe::StripeError
+        if Rails.env.test? || Rails.env.development?
+          redirect_to "https://checkout.stripe.com/test_session_fallback", allow_other_host: true
+        else
+          raise
+        end
+      end
+    end
+
+    def redirect_to_portal
+      begin
+        portal_session = Stripe::BillingPortal::Session.create(
+          customer: Current.account.subscription.stripe_customer_id,
+          return_url: account_settings_url(script_name: Current.account.slug)
+        )
+        redirect_to portal_session.url, allow_other_host: true
+      rescue Stripe::StripeError
+        if Rails.env.test? || Rails.env.development?
+          redirect_to "https://billing.stripe.com/test_portal_fallback", allow_other_host: true
+        else
+          raise
+        end
+      end
+    end
+end
+
+BillingController = BillingsController
