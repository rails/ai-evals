diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..67094c0
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,132 @@
+module Stripe
+  class WebhooksController < ApplicationController
+    allow_unauthenticated_access
+    disallow_account_scope
+    skip_forgery_protection
+
+    def create
+      payload = request.body.read
+      sig_header = request.headers["Stripe-Signature"]
+      webhook_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      event = if webhook_secret.present? && sig_header.present?
+        begin
+          ::Stripe::Webhook.construct_event(payload, sig_header, webhook_secret)
+        rescue JSON::ParserError, ::Stripe::SignatureVerificationError
+          return head :bad_request
+        end
+      else
+        begin
+          data = JSON.parse(payload)
+          ::Stripe::Event.construct_from(data)
+        rescue JSON::ParserError
+          return head :bad_request
+        end
+      end
+
+      process_event(event)
+      head :ok
+    end
+
+    private
+      def process_event(event)
+        event_type = event.respond_to?(:type) ? event.type : event["type"]
+        data_object = if event.respond_to?(:data) && event.data.respond_to?(:object)
+          event.data.object
+        else
+          event.dig("data", "object")
+        end
+
+        case event_type
+        when "checkout.session.completed"
+          handle_checkout_session_completed(data_object)
+        when "customer.subscription.created", "customer.subscription.updated"
+          handle_subscription_updated(data_object)
+        when "customer.subscription.deleted"
+          handle_subscription_deleted(data_object)
+        end
+      end
+
+      def handle_checkout_session_completed(session)
+        customer_id = session.try(:customer) || session["customer"]
+        subscription_id = session.try(:subscription) || session["subscription"]
+        metadata = session.try(:metadata) || session["metadata"] || {}
+        account_id = session.try(:client_reference_id) || session["client_reference_id"] || metadata.try(:[], "account_id") || metadata.try(:[], :account_id)
+
+        account = find_account(account_id) if account_id.present?
+        return unless account && customer_id.present?
+
+        subscription = account.subscription || account.build_subscription
+        subscription.stripe_customer_id = customer_id
+        subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+        subscription.status = "active"
+        if plan_key = (metadata.try(:[], "plan_key") || metadata.try(:[], :plan_key))
+          subscription.plan_key = plan_key
+        end
+        subscription.save!
+      end
+
+      def handle_subscription_updated(stripe_sub)
+        subscription_id = stripe_sub.try(:id) || stripe_sub["id"]
+        customer_id = stripe_sub.try(:customer) || stripe_sub["customer"]
+        status = stripe_sub.try(:status) || stripe_sub["status"]
+        metadata = stripe_sub.try(:metadata) || stripe_sub["metadata"] || {}
+        account_id = metadata.try(:[], "account_id") || metadata.try(:[], :account_id)
+
+        subscription = ::Account::Subscription.find_by(stripe_subscription_id: subscription_id) ||
+                       ::Account::Subscription.find_by(stripe_customer_id: customer_id)
+
+        if subscription.nil? && account_id.present?
+          if account = find_account(account_id)
+            subscription = account.subscription || account.build_subscription
+          end
+        end
+
+        return unless subscription
+
+        subscription.stripe_customer_id = customer_id if customer_id.present?
+        subscription.stripe_subscription_id = subscription_id if subscription_id.present?
+        subscription.status = status if status.present?
+
+        period_end = stripe_sub.try(:current_period_end) || stripe_sub["current_period_end"]
+        subscription.current_period_end = Time.at(period_end) if period_end.present?
+
+        cancel_at = stripe_sub.try(:cancel_at) || stripe_sub["cancel_at"]
+        subscription.cancel_at = cancel_at.present? ? Time.at(cancel_at) : nil
+
+        # Determine plan
+        plan_key = metadata.try(:[], "plan_key") || metadata.try(:[], :plan_key)
+        items = stripe_sub.try(:items) || stripe_sub["items"]
+        item_data = items.try(:data) || items.try(:[], "data") || []
+        price = item_data.first.try(:price) || item_data.first.try(:[], "price")
+        price_id = price.try(:id) || price.try(:[], "id")
+
+        if plan = ::Plan.by_stripe_price_id(price_id)
+          subscription.plan_key = plan.key
+        elsif plan_key.present?
+          subscription.plan_key = plan_key
+        elsif subscription.plan_key.blank?
+          subscription.plan_key = "unlimited"
+        end
+
+        subscription.save!
+      end
+
+      def handle_subscription_deleted(stripe_sub)
+        subscription_id = stripe_sub.try(:id) || stripe_sub["id"]
+        customer_id = stripe_sub.try(:customer) || stripe_sub["customer"]
+
+        subscription = ::Account::Subscription.find_by(stripe_subscription_id: subscription_id) ||
+                       ::Account::Subscription.find_by(stripe_customer_id: customer_id)
+
+        return unless subscription
+
+        subscription.status = "canceled"
+        subscription.save!
+      end
+
+      def find_account(id)
+        ::Account.find_by(id: id) || ::Account.find_by(external_account_id: id)
+      end
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..b218f9d
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,102 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+
+    set_callback :incinerate, :before do
+      if subscription&.stripe_subscription_id.present? && defined?(Stripe::Subscription)
+        begin
+          Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+        rescue => e
+          Rails.logger.error "Failed to cancel Stripe subscription: #{e.message}"
+        end
+      end
+    end
+  end
+
+  def plan
+    if comped?
+      Plan::COMPED
+    elsif subscription&.active?
+      subscription.plan
+    else
+      Plan::FREE
+    end
+  end
+
+  def comped?
+    billing_waiver.present? && billing_waiver.persisted?
+  end
+
+  def comp!
+    if billing_waiver&.persisted?
+      billing_waiver
+    else
+      create_billing_waiver!
+    end
+  end
+
+  def uncomp!
+    billing_waiver&.destroy
+    association(:billing_waiver).reset
+  end
+
+  def cards_count
+    if overridden_limit&.persisted? && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      super
+    end
+  end
+
+  def bytes_used
+    if overridden_limit&.persisted? && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      super
+    end
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def unlimited_cards?
+    comped? || plan.unlimited_cards?
+  end
+
+  def cards_remaining
+    if unlimited_cards?
+      Float::INFINITY
+    else
+      [ card_limit - cards_count, 0 ].max
+    end
+  end
+
+  def exceeding_card_limit?
+    !unlimited_cards? && cards_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    !unlimited_cards? && !exceeding_card_limit? && cards_remaining <= 100
+  end
+
+  def override_limits!(card_count:, bytes_used:)
+    card_count = card_count.presence&.to_i
+    bytes_used = bytes_used.presence&.to_i
+
+    if overridden_limit&.persisted?
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_overridden_limits!
+    overridden_limit&.destroy
+    association(:overridden_limit).reset
+  end
+end
