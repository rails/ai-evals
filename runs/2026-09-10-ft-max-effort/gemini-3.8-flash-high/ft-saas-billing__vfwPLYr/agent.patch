diff --git a/saas/test/controllers/account/settings_billing_test.rb b/saas/test/controllers/account/settings_billing_test.rb
new file mode 100644
index 0000000..41070fe
--- /dev/null
+++ b/saas/test/controllers/account/settings_billing_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    sign_in_as :kevin
+  end
+
+  test "admins see their plan and Upgrade in settings" do
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings" do
+      assert_select "header", text: /Plan/
+      assert_select "strong", text: "Free"
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "admins see paid plan in settings" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_settings_test",
+      status: "active",
+      plan_key: "unlimited"
+    )
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings" do
+      assert_select "header", text: /Plan/
+      assert_select "strong", text: "Unlimited"
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "admins see comped plan in settings" do
+    @account.comp!
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings" do
+      assert_select "strong", text: "Comped"
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "non-admins do not see plan or Upgrade in settings" do
+    logout_and_sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings" do
+      assert_select "a", text: "Upgrade", count: 0
+    end
+  end
+end
