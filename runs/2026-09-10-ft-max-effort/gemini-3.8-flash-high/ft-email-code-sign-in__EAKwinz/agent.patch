+require "application_system_test_case"
+
+class SignInByEmailCodeTest < ApplicationSystemTestCase
+  include ActionMailer::TestHelper
+
+  test "sign in by email code" do
+    identity = identities(:david)
+
+    visit new_session_url(script_name: nil)
+    fill_in "Enter your email address…", with: identity.email_address
+    click_on "Let’s go"
+
+    assert_text "We sent a six-character code to #{identity.email_address}"
+
+    perform_enqueued_jobs
+
+    mail = ActionMailer::Base.deliveries.last
+    code = mail.subject[/\b[A-Z0-9]{6}\b/]
+
+    fill_in "6-character code", with: code
+    click_on "Sign in"
+
+    assert_current_path root_path
+  end
+
+  test "sign up by email code" do
+    visit new_signup_url(script_name: nil)
+    fill_in "Enter your email address…", with: "brandnewperson@example.com"
+    click_on "Let’s go"
+
+    assert_text "We sent a six-character code to brandnewperson@example.com"
+
+    perform_enqueued_jobs
+
+    mail = ActionMailer::Base.deliveries.last
+    code = mail.subject[/\b[A-Z0-9]{6}\b/]
+
+    fill_in "6-character code", with: code
+    click_on "Continue"
+
+    assert_text "Complete your sign-up"
+    fill_in "Enter your full name…", with: "Brand New Person"
+    click_on "Continue"
+
+    assert_text "Welcome"
+  end
+
