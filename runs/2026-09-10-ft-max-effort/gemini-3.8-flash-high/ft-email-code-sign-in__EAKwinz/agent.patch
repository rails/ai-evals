+require "test_helper"
+
+class SessionMailerTest < ActionMailer::TestCase
+  test "sign_in_code email has code in subject and body" do
+    email = SessionMailer.sign_in_code(email_address: "kevin@example.com", code: "ABC123")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@example.com" ], email.to
+    assert_equal "ABC123 is your Fizzy code", email.subject
+    assert email.subject.start_with?("ABC123")
+    assert_includes email.body.encoded, "ABC123"
+  end
+
+  test "sign_in_code email has both HTML and text parts" do
+    email = SessionMailer.sign_in_code(email_address: "kevin@example.com", code: "XYZ789")
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+    assert_includes email.html_part.body.encoded, "XYZ789"
+    assert_includes email.text_part.body.encoded, "XYZ789"
+  end
+end
diff --git a/test/models/email_verification_test.rb b/test/models/email_verification_test.rb
new file mode 100644
index 0000000..ff714e4
--- /dev/null
+++ b/test/models/email_verification_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class EmailVerificationTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "generate creates a 6-character code, sends email, and returns verification data" do
+    assert_emails 1 do
+      data = EmailVerification.generate("kevin@example.com")
+
+      assert_equal "kevin@example.com", data["email_address"]
+      assert_equal 6, data["code"].length
+      assert data["expires_at"] > Time.current.to_i
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "kevin@example.com" ], mail.to
+      assert_equal "#{data["code"]} is your Fizzy code", mail.subject
+      assert_includes mail.subject, data["code"]
+      assert_includes mail.body.encoded, data["code"]
+    end
+  end
+
+  test "code in email subject shows code" do
+    perform_enqueued_jobs do
+      data = EmailVerification.generate("test@example.com")
+      mail = ActionMailer::Base.deliveries.last
+
+      assert mail.subject.start_with?(data["code"])
+    end
+  end
+
+  test "verify with correct code succeeds" do
+    data = EmailVerification.generate("kevin@example.com")
+
+    assert EmailVerification.verify(data, data["code"])
+  end
+
+  test "verify is case-insensitive" do
+    data = EmailVerification.generate("kevin@example.com")
+
+    assert EmailVerification.verify(data, data["code"].downcase)
+    assert EmailVerification.verify(data, data["code"].upcase)
+  end
+
+  test "verify with incorrect code fails" do
+    data = EmailVerification.generate("kevin@example.com")
+
+    assert_not EmailVerification.verify(data, "WRONG1")
+    assert_not EmailVerification.verify(data, "")
+    assert_not EmailVerification.verify(data, nil)
+  end
+
+  test "code works for fifteen minutes and expires after" do
+    data = EmailVerification.generate("kevin@example.com")
+
+    travel 14.minutes do
+      assert_not EmailVerification.expired?(data)
+      assert EmailVerification.verify(data, data["code"])
+    end
+
+    travel 16.minutes do
+      assert EmailVerification.expired?(data)
+      assert_not EmailVerification.verify(data, data["code"])
+    end
+  end
+
+  test "email address normalization and validation" do
+    assert EmailVerification.valid_email_address?("user@example.com")
+    assert EmailVerification.valid_email_address?("  USER@EXAMPLE.COM  ")
+    assert_not EmailVerification.valid_email_address?("not-an-email")
+    assert_not EmailVerification.valid_email_address?("")
+    assert_not EmailVerification.valid_email_address?(nil)
+  end
+end
