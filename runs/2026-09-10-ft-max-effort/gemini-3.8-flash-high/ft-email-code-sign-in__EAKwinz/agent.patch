--- /dev/null
+++ b/app/mailers/session_mailer.rb
@@ -0,0 +1,12 @@
+class SessionMailer < ApplicationMailer
+  def sign_in_code(email_address = nil, code = nil, **kwargs)
+    @email_address = email_address || kwargs[:email_address]
+    @code = code || kwargs[:code]
+
+    mail(
+      to: @email_address,
+      subject: "#{@code} is your Fizzy code"
+    )
+  end
+  alias_method :code, :sign_in_code
+end
diff --git a/app/models/email_verification.rb b/app/models/email_verification.rb
new file mode 100644
index 0000000..4beb062
--- /dev/null
+++ b/app/models/email_verification.rb
@@ -0,0 +1,50 @@
+class EmailVerification
+  EXPIRATION_DURATION = 15.minutes
+  CODE_LENGTH = 6
+
+  class << self
+    def generate(email_address, purpose: nil)
+      email_address = normalize_email_address(email_address)
+      code = generate_code
+
+      SessionMailer.sign_in_code(email_address: email_address, code: code).deliver_later
+
+      {
+        "email_address" => email_address,
+        "code" => code,
+        "expires_at" => EXPIRATION_DURATION.from_now.to_i,
+        "purpose" => purpose&.to_s
+      }
+    end
+
+    def verify(verification_data, submitted_code)
+      if verification_data.is_a?(Hash) && submitted_code.present? && !expired?(verification_data)
+        submitted_code.to_s.strip.casecmp?(verification_data["code"].to_s.strip)
+      else
+        false
+      end
+    end
+
+    def expired?(verification_data)
+      if verification_data.is_a?(Hash) && verification_data["expires_at"].present?
+        Time.current.to_i > verification_data["expires_at"].to_i
+      else
+        true
+      end
+    end
+
+    def normalize_email_address(email_address)
+      email_address.to_s.strip.downcase
+    end
+
+    def valid_email_address?(email_address)
+      normalized = normalize_email_address(email_address)
+      normalized.present? && normalized.match?(URI::MailTo::EMAIL_REGEXP)
+    end
+
+    private
+      def generate_code
+        SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      end
+  end
+end
