diff --git a/test/integration/locale_switching_test.rb b/test/integration/locale_switching_test.rb
new file mode 100644
index 0000000..6487e9d
--- /dev/null
+++ b/test/integration/locale_switching_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class LocaleSwitchingTest < ActionDispatch::IntegrationTest
+  test "opening page with ?locale=ja switches to Japanese" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=?]", "ja"
+      assert_equal "ja", session[:locale]
+    end
+  end
+
+  test "choice sticks for the rest of their session" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=?]", "ja"
+      assert_equal "ja", session[:locale]
+
+      # Subsequent request without locale param
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=?]", "ja"
+      assert_equal "ja", session[:locale]
+    end
+  end
+
+  test "unsupported locale ?locale=xx does not switch anything and does not break" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=?]", "en"
+      assert_nil session[:locale]
+    end
+  end
+
+  test "unsupported locale ?locale=xx when on Japanese keeps Japanese" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_select "html[lang=?]", "ja"
+
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=?]", "ja"
+      assert_equal "ja", session[:locale]
+    end
+  end
+
+  test "person who never chose anything keeps rendering English" do
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=?]", "en"
+      assert_nil session[:locale]
+    end
+  end
+
+  test "authenticated user switching with ?locale=ja updates their identity locale" do
+    identity = identities(:kevin)
+    assert_nil identity.locale
+
+    sign_in_as identity
+
+    get root_path, params: { locale: "ja" }
+    assert_response :success
+    assert_select "html[lang=?]", "ja"
+    assert_equal "ja", identity.reload.locale
+  end
+
+  test "choice sticks next time they sign in from a clean browser" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    # Clean browser: no cookies, no session
+    cookies.delete(:session_token)
+    reset!
+
+    # Untenanted sign-in page on a clean browser defaults to English before signing in
+    untenanted do
+      get new_session_path
+      assert_select "html[lang=?]", "en"
+    end
+
+    # Sign in
+    sign_in_as identity
+
+    # Now on the authenticated page, locale is Japanese!
+    get root_path
+    assert_response :success
+    assert_select "html[lang=?]", "ja"
+  end
+
+  test "switching back to English with ?locale=en" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    sign_in_as identity
+
+    get root_path
+    assert_select "html[lang=?]", "ja"
+
+    get root_path, params: { locale: "en" }
+    assert_response :success
+    assert_select "html[lang=?]", "en"
+    assert_equal "en", identity.reload.locale
+  end
+
+  test "magic link email is in Japanese when requested by person who chose Japanese" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_select "html[lang=?]", "ja"
+
+      assert_emails 1 do
+        post session_path, params: { email_address: "new-user-ja@example.com" }
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal "new-user-ja@example.com", email.to.first
+      assert_equal "ja", Identity.find_by(email_address: "new-user-ja@example.com").locale
+    end
+  end
+end
diff --git a/test/mailers/notification/bundle_mailer_test.rb b/test/mailers/notification/bundle_mailer_test.rb
index d37ecae..4d63a7e 100644
--- a/test/mailers/notification/bundle_mailer_test.rb
+++ b/test/mailers/notification/bundle_mailer_test.rb
@@ -119,6 +119,25 @@ class Notification::BundleMailerTest < ActionMailer::TestCase
     assert_emails 1
   end
 
+test "renders in Japanese when user chose Japanese" do
+  @user.identity.update!(locale: "ja")
+  create_notification(@user, source: events(:logo_published))
+
+  mail = Notification::BundleMailer.notification(@bundle)
+  assert_equal "ja", I18n.with_locale(:ja) { @user.identity.locale }
+  assert_includes mail.subject, "新しい通知"
+
+  html = mail.html_part.body.to_s
+  assert_includes html, "以降の通知"
+  assert_includes html, "新しい通知が1件あります"
+  assert_includes html, "送信頻度を変更する"
+
+  text = mail.text_part.body.to_s
+  assert_includes text, "以降の通知"
+  assert_includes text, "新しい通知が1件あります"
+  assert_includes text, "送信頻度を変更する"
+end
+
   private
     def create_notification(user, source: events(:logo_published))
       Notification.create!(user: user, creator: user, source: source, created_at: 30.minutes.ago)
