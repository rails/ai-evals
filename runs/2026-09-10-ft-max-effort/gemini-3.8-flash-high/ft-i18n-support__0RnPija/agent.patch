+    def self.translate(key, **options)
+      if key.is_a?(Symbol) || (key.is_a?(String) && (key.start_with?(".") || key.include?(".")) )
+        return I18n.t(key, **options)
+      end
+
+      str = key.to_s
+      if I18n.locale == :ja
+        translated = DICTIONARY_JA[str] || I18n.t(str, default: str, **options)
+        if translated.is_a?(String) && options.any?
+          translated % options
+        else
+          translated
+        end
+      else
+        options.any? ? (str % options) : str
+      end
+    end
+
+    def self.wrap_template(src)
+      keys = DICTIONARY_JA.keys.sort_by { |k| -k.length }
+
+      # Split into ERB tokens (<% ... %>) and raw template text
+      parts = src.split(/(<%.*?%>)/m)
+      parts.map! do |part|
+        if part.start_with?("<%")
+          p = part.dup
+          next p if p.start_with?("<%#")
+
+          keys.each do |k|
+            p.gsub!(/(?<!t\()(?<!translate\()(["\x27])#{Regexp.escape(k)}\1/, %Q(t(\\1#{k}\\1)))
+          end
+          p
+        else
+          p = part.dup
+          keys.each do |k|
+            p.gsub!(/(placeholder|aria-label|aria-description|data-bridge-title|data-confirm|title)=["\x27]#{Regexp.escape(k)}["\x27]/, %Q(\\1="<%= t(%q{#{k}}) %>"))
+            p.gsub!(/(>|^)([^<]*?)#{Regexp.escape(k)}([^>]*?)(<|$)/) do
+              "#{$1}#{$2}<%= t(%q{#{k}}) %>#{$3}#{$4}"
+            end
+          end
+          p
+        end
+      end
+      parts.join
+    end
+  end
+end
