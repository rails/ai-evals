diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..38056aa
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,44 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  AVAILABLE_LOCALES = %w[ en ja ].freeze
+
+  included do
+    around_action :set_current_locale
+
+    helper_method :current_locale
+
+    etag { current_locale }
+  end
+
+  private
+    def set_current_locale(&action)
+      if params[:locale].present? && AVAILABLE_LOCALES.include?(params[:locale].to_s)
+        requested_locale = params[:locale].to_s
+        session[:locale] = requested_locale
+        if authenticated? && Current.identity.present?
+          Current.identity.update_column(:locale, requested_locale)
+        end
+      end
+
+      if authenticated? && Current.identity.present?
+        if session[:locale].present?
+          if Current.identity.locale != session[:locale]
+            Current.identity.update_column(:locale, session[:locale])
+          end
+        elsif Current.identity.locale.present?
+          session[:locale] = Current.identity.locale
+        end
+      end
+
+      locale = session[:locale] || Current.identity&.locale || I18n.default_locale
+      locale = locale.to_s
+      locale = I18n.default_locale.to_s unless AVAILABLE_LOCALES.include?(locale)
+
+      I18n.with_locale(locale, &action)
+    end
+
+    def current_locale
+      I18n.locale.to_s
+    end
+end
