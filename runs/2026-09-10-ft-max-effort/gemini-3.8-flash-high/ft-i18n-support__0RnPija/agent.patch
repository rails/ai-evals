diff --git a/config/initializers/fizzy_translations.rb b/config/initializers/fizzy_translations.rb
new file mode 100644
index 0000000..64255c6
--- /dev/null
+++ b/config/initializers/fizzy_translations.rb
@@ -0,0 +1,58 @@
+require Rails.root.join("lib/fizzy/translations")
+
+module FizzyTranslationHelper
+  def t(key, **options)
+    if key.is_a?(String) && !key.start_with?(".") && !key.include?(".")
+      res = Fizzy::Translations.translate(key, **options)
+      res.is_a?(String) ? res.html_safe : res
+    else
+      super
+    end
+  end
+
+  def translate(key, **options)
+    t(key, **options)
+  end
+end
+
+module FizzyControllerTranslationHelper
+  def t(key, **options)
+    if key.is_a?(String) && !key.start_with?(".") && !key.include?(".")
+      Fizzy::Translations.translate(key, **options)
+    else
+      super
+    end
+  end
+
+  def translate(key, **options)
+    t(key, **options)
+  end
+end
+
+ActiveSupport.on_load(:action_view) do
+  ActionView::Helpers::TranslationHelper.prepend(FizzyTranslationHelper)
+  ActionView::Base.prepend(FizzyTranslationHelper)
+end
+
+ActiveSupport.on_load(:action_controller) do
+  AbstractController::Translation.prepend(FizzyControllerTranslationHelper)
+end
+
+ActiveSupport.on_load(:action_mailer) do
+  ActionMailer::Base.prepend(FizzyControllerTranslationHelper)
+end
+
+module FizzyErbHandler
+  def call(template, source)
+    if template.identifier&.include?("/app/views/") &&
+       !template.identifier.include?("/mailers/") &&
+       !template.identifier.include?(".json.") &&
+       !template.identifier.include?(".svg.") &&
+       !template.identifier.include?(".js.")
+      source = Fizzy::Translations.wrap_template(source)
+    end
+    super(template, source)
+  end
+end
+
+ActionView::Template::Handlers::ERB.prepend(FizzyErbHandler)
