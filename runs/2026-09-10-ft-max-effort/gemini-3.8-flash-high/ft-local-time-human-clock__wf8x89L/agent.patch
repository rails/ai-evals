diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..44920c4
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_time with Time" do
+    time = Time.utc(2026, 9, 11, 10, 7, 34)
+    fragment = parse(local_time(time))
+    element = fragment.at_css("local-time")
+
+    assert_not_nil element
+    assert_equal "2026-09-11T10:07:34Z", element["datetime"]
+    assert_empty element.text
+  end
+
+  test "local_time with format" do
+    time = Time.utc(2026, 9, 11, 10, 7, 34)
+    fragment = parse(local_time(time, format: "%b %-d"))
+    element = fragment.at_css("local-time")
+
+    assert_equal "%b %-d", element["format"]
+  end
+
+  test "local_time with type" do
+    time = Time.utc(2026, 9, 11, 10, 7, 34)
+    fragment = parse(local_time(time, type: "auto-clean"))
+    element = fragment.at_css("local-time")
+
+    assert_equal "auto-clean", element["type"]
+  end
+
+  test "local_time with symbol shortcut" do
+    time = Time.utc(2026, 9, 11, 10, 7, 34)
+
+    element = parse(local_time(time, :time)).at_css("local-time")
+    assert_equal "time", element["type"]
+
+    element = parse(local_time(time, :date)).at_css("local-time")
+    assert_equal "date", element["type"]
+  end
+
+  test "local_date" do
+    time = Time.utc(2026, 9, 11, 10, 7, 34)
+    element = parse(local_date(time, format: "%b %-d")).at_css("local-time")
+
+    assert_equal "%b %-d", element["format"]
+    assert_equal "date", element["type"]
+  end
+
+  test "local_time_ago" do
+    time = Time.utc(2026, 9, 11, 10, 7, 34)
+    element = parse(local_time_ago(time)).at_css("local-time")
+
+    assert_equal "time-ago", element["type"]
+    assert_includes element["class"], "local-time-value"
+  end
+
+  test "local_relative_time" do
+    time = Time.utc(2026, 9, 11, 10, 7, 34)
+    element = parse(local_relative_time(time, type: "time-or-date")).at_css("local-time")
+
+    assert_equal "time-or-date", element["type"]
+  end
+
+  test "local_time with Date" do
+    date = Date.new(2026, 9, 11)
+    element = parse(local_date(date)).at_css("local-time")
+
+    assert_equal "2026-09-11", element["datetime"]
+  end
+
+  test "local_time with nil" do
+    assert_nil local_time(nil)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..e5a12a1
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,108 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders comment timestamps in browser" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+
+    now = Time.current
+    two_hours_ago = now - 2.hours
+    yesterday = now.beginning_of_day - 4.hours
+    five_days_ago = now - 5.days
+
+    comment_today = card.comments.create!(creator: users(:david), body: "Comment from today", created_at: two_hours_ago)
+    comment_yesterday = card.comments.create!(creator: users(:david), body: "Comment from yesterday", created_at: yesterday)
+    comment_past = card.comments.create!(creator: users(:david), body: "Comment from 5 days ago", created_at: five_days_ago)
+
+    visit card_url(card)
+
+    expected_time = two_hours_ago.strftime("%l:%M %p").strip
+
+    # Comment from two hours ago reads "1:42 PM" (the time of day)
+    within("##{ActionView::RecordIdentifier.dom_id(comment_today)}") do
+      assert_selector "local-time", text: expected_time
+    end
+
+    # Comment from last night reads "yesterday"
+    within("##{ActionView::RecordIdentifier.dom_id(comment_yesterday)}") do
+      assert_selector "local-time", text: /yesterday/i
+    end
+
+    # Comment from earlier in the week reads "5 days ago" or "Sep 12"
+    within("##{ActionView::RecordIdentifier.dom_id(comment_past)}") do
+      assert_selector "local-time", text: /5 days ago|#{five_days_ago.strftime('%b %-d')}/i
+    end
+  end
+
+  test "renders auto-close notice overnight and further out" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    board = card.board
+    board.entropy.update!(auto_postpone_period: 3.days.to_i)
+
+    # Auto-closing overnight: auto_clean_at should be tomorrow morning
+    card.update!(last_active_at: Time.current.beginning_of_day + 1.day + 4.hours - 3.days)
+
+    visit card_url(card)
+
+    within("##{ActionView::RecordIdentifier.dom_id(card, :closure_notice)}") do
+      assert_selector "local-time", text: "tomorrow"
+    end
+
+    # Auto-closing further out (in 3 days)
+    card.update!(last_active_at: Time.current.beginning_of_day + 3.days + 4.hours - 3.days)
+
+    visit card_url(card)
+
+    within("##{ActionView::RecordIdentifier.dom_id(card, :closure_notice)}") do
+      assert_selector "local-time", text: "in 3 days"
+    end
+  end
+
+  test "renders card metadata relative times" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    card.update!(created_at: 5.days.ago, last_active_at: 2.hours.ago)
+
+    visit card_url(card)
+
+    within("##{ActionView::RecordIdentifier.dom_id(card, :meta)}") do
+      assert_selector ".card__meta-text--added local-time.local-time-value", text: /5 days ago/i
+      assert_selector ".card__meta-text--updated local-time.local-time-value", text: /2 hours ago/i
+    end
+  end
+
+  test "renders in viewer's own timezone" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    # 10:00 AM UTC
+    utc_time = Time.utc(2026, 6, 15, 10, 0, 0)
+    comment = card.comments.create!(creator: users(:david), body: "Timezone test", created_at: utc_time)
+
+    # View with Tokyo timezone (UTC+9 -> 19:00 / 7:00 PM)
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Asia/Tokyo")
+    visit card_url(card)
+
+    # In Tokyo on 2026-06-15, it's June 15 at 7:00 PM
+    tokyo_date = utc_time.in_time_zone("Asia/Tokyo")
+    within("##{ActionView::RecordIdentifier.dom_id(comment)}") do
+      assert_selector "local-time", text: /#{tokyo_date.strftime('%b %-d')}/i
+    end
+
+    # View with New York timezone (UTC-4 -> 6:00 AM)
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+    visit card_url(card)
+
+    ny_date = utc_time.in_time_zone("America/New_York")
+    within("##{ActionView::RecordIdentifier.dom_id(comment)}") do
+      assert_selector "local-time", text: /#{ny_date.strftime('%b %-d')}/i
+    end
+
+    # Reset timezone
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+end
