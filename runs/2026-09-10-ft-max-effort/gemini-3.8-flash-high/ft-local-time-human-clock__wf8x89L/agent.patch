diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..01fa3aa 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,52 @@
 module TimeHelper
+  def local_time(time, *args, **options)
+    return if time.blank?
+
+    format = options.delete(:format)
+    type = options.delete(:type)
+
+    if args.first.is_a?(Symbol)
+      format_or_type = args.shift
+      if format_or_type == :time
+        type ||= "time"
+      elsif format_or_type == :date
+        type ||= "date"
+      else
+        format ||= format_or_type.to_s
+      end
+    elsif args.first.is_a?(String)
+      format ||= args.shift
+    end
+
+    datetime = to_iso8601(time)
+    tag_options = { datetime: datetime }
+    tag_options[:format] = format if format.present?
+    tag_options[:type] = type if type.present?
+
+    content_tag("local-time", nil, options.merge(tag_options))
+  end
+
+  def local_date(time, *args, **options)
+    local_time(time, *args, **options.reverse_merge(type: "date"))
+  end
+
+  def local_time_ago(time, **options)
+    classes = class_names("local-time-value", options.delete(:class))
+    local_time(time, **options.merge(type: "time-ago", class: classes))
+  end
+
+  def local_relative_time(time, type: "time-or-date", **options)
+    local_time(time, **options.reverse_merge(type: type))
+  end
+
+  private
+    def to_iso8601(time)
+      if time.is_a?(Date) && !time.is_a?(DateTime)
+        time.iso8601
+      elsif time.respond_to?(:iso8601)
+        time.iso8601
+      else
+        time.to_time.iso8601
+      end
+    end
 end
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..770d296
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,140 @@
+const MONTH_NAMES_SHORT = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
+const MONTH_NAMES_LONG = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
+const DAY_NAMES_SHORT = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
+const DAY_NAMES_LONG = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
+
+export function parseDate(dateString) {
+  if (!dateString) return null
+  if (dateString instanceof Date) return dateString
+  if (typeof dateString !== "string") return new Date(dateString)
+
+  const dateOnlyMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateString)
+  if (dateOnlyMatch) {
+    const [, y, m, d] = dateOnlyMatch.map(Number)
+    return new Date(y, m - 1, d)
+  }
+  return new Date(dateString)
+}
+
+export function daysDifference(date, now = new Date()) {
+  const startOfDate = new Date(date.getFullYear(), date.getMonth(), date.getDate())
+  const startOfNow = new Date(now.getFullYear(), now.getMonth(), now.getDate())
+  return Math.round((startOfDate - startOfNow) / (1000 * 60 * 60 * 24))
+}
+
+export function strftime(date, format) {
+  const year = date.getFullYear()
+  const month = date.getMonth()
+  const day = date.getDate()
+  const weekday = date.getDay()
+  const hours24 = date.getHours()
+  const hours12 = hours24 % 12 || 12
+  const minutes = date.getMinutes()
+  const seconds = date.getSeconds()
+  const ampm = hours24 >= 12 ? "PM" : "AM"
+
+  return format
+    .replace(/%A/g, DAY_NAMES_LONG[weekday])
+    .replace(/%a/g, DAY_NAMES_SHORT[weekday])
+    .replace(/%B/g, MONTH_NAMES_LONG[month])
+    .replace(/%b/g, MONTH_NAMES_SHORT[month])
+    .replace(/%d/g, String(day).padStart(2, "0"))
+    .replace(/%-d/g, String(day))
+    .replace(/%e/g, String(day))
+    .replace(/%m/g, String(month + 1).padStart(2, "0"))
+    .replace(/%-m/g, String(month + 1))
+    .replace(/%Y/g, String(year))
+    .replace(/%y/g, String(year).slice(-2))
+    .replace(/%H/g, String(hours24).padStart(2, "0"))
+    .replace(/%k/g, String(hours24))
+    .replace(/%I/g, String(hours12).padStart(2, "0"))
+    .replace(/%l/g, String(hours12))
+    .replace(/%-l/g, String(hours12))
+    .replace(/%M/g, String(minutes).padStart(2, "0"))
+    .replace(/%S/g, String(seconds).padStart(2, "0"))
+    .replace(/%p/g, ampm)
+    .replace(/%P/g, ampm.toLowerCase())
+    .trim()
+}
+
+export function formatFullDateTime(date) {
+  return strftime(date, "%A, %B %-d, %Y at %l:%M %p")
+}
+
+export function formatLocalTime(date, { type, format } = {}, now = new Date()) {
+  if (!date || isNaN(date.getTime())) return ""
+
+  if (format) {
+    return strftime(date, format)
+  }
+
+  const diffDays = daysDifference(date, now)
+
+  switch (type) {
+    case "time-or-date":
+      if (diffDays === 0) {
+        return strftime(date, "%l:%M %p")
+      } else if (diffDays === -1) {
+        return "yesterday"
+      } else if (diffDays >= -6 && diffDays <= -2) {
+        return `${Math.abs(diffDays)} days ago`
+      } else if (date.getFullYear() === now.getFullYear()) {
+        return strftime(date, "%b %-d")
+      } else {
+        return strftime(date, "%b %-d, %Y")
+      }
+
+    case "auto-clean":
+      if (diffDays <= 0) {
+        return "today"
+      } else if (diffDays === 1) {
+        return "tomorrow"
+      } else {
+        return `in ${diffDays} days`
+      }
+
+    case "time-ago": {
+      const elapsedMs = now - date
+      const elapsedSeconds = Math.round(elapsedMs / 1000)
+      const elapsedMinutes = Math.round(elapsedSeconds / 60)
+      const elapsedHours = Math.round(elapsedMinutes / 60)
+
+      if (elapsedSeconds < 45) {
+        return "just now"
+      } else if (elapsedMinutes < 60) {
+        return elapsedMinutes === 1 ? "1 minute ago" : `${elapsedMinutes} minutes ago`
+      } else if (elapsedHours < 24 && diffDays === 0) {
+        return elapsedHours === 1 ? "1 hour ago" : `${elapsedHours} hours ago`
+      } else if (diffDays === -1) {
+        return "1 day ago"
+      } else if (diffDays >= -30) {
+        return `${Math.abs(diffDays)} days ago`
+      } else {
+        const diffMonths = Math.round(Math.abs(diffDays) / 30)
+        if (diffMonths < 12) {
+          return diffMonths === 1 ? "1 month ago" : `${diffMonths} months ago`
+        } else {
+          const diffYears = Math.round(Math.abs(diffDays) / 365)
+          return diffYears === 1 ? "1 year ago" : `${diffYears} years ago`
+        }
+      }
+    }
+
+    case "date":
+      if (date.getFullYear() === now.getFullYear()) {
+        return strftime(date, "%b %-d")
+      } else {
+        return strftime(date, "%b %-d, %Y")
+      }
+
+    case "time":
+      return strftime(date, "%l:%M %p")
+
+    default:
+      if (date.getFullYear() === now.getFullYear()) {
+        return strftime(date, "%b %-d at %l:%M %p")
+      } else {
+        return strftime(date, "%b %-d, %Y at %l:%M %p")
+      }
+  }
+}
