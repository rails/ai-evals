diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..2d42576
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,60 @@
+import { parseDate, formatLocalTime, formatFullDateTime } from "helpers/local_time_helpers"
+
+export class LocalTimeElement extends HTMLElement {
+  static get observedAttributes() {
+    return ["datetime", "format", "type"]
+  }
+
+  connectedCallback() {
+    this.update()
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) {
+      this.update()
+    }
+  }
+
+  update() {
+    const datetimeStr = this.getAttribute("datetime")
+    if (!datetimeStr) return
+
+    const date = parseDate(datetimeStr)
+    if (!date || isNaN(date.getTime())) return
+
+    const type = this.getAttribute("type")
+    const format = this.getAttribute("format")
+
+    const text = formatLocalTime(date, { type, format })
+    if (text) {
+      this.textContent = text
+    }
+
+    if (!this.getAttribute("title")) {
+      this.title = formatFullDateTime(date)
+    }
+
+    const stamp = this.closest("[data-bridge-description]")
+    if (stamp && this.closest(".card__closed-date")) {
+      stamp.setAttribute("data-bridge-description", text)
+    }
+  }
+}
+
+export function updateAll() {
+  document.querySelectorAll("local-time").forEach(el => {
+    if (typeof el.update === "function") {
+      el.update()
+    }
+  })
+}
+
+if (!customElements.get("local-time")) {
+  customElements.define("local-time", LocalTimeElement)
+}
+
+setInterval(updateAll, 30_000)
+
+document.addEventListener("turbo:load", updateAll)
+document.addEventListener("turbo:render", updateAll)
+document.addEventListener("turbo:frame-load", updateAll)
