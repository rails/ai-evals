diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..d039f20
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,60 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :burst, dependent: :destroy, class_name: "Card::Burst"
+
+    scope :with_burst, -> { joins(:burst) }
+    scope :stalled, -> { active.with_burst.where(last_active_at: ..2.weeks.ago) }
+  end
+
+  def burst?
+    burst&.persisted?
+  end
+  alias_method :had_burst?, :burst?
+
+  def burst!
+    return unless persisted?
+
+    create_burst! unless burst?
+  end
+
+  def unburst
+    if burst.present?
+      burst.destroy
+      association(:burst).reset
+    end
+  end
+
+  def stalled?
+    active? && burst? && last_active_at <= 2.weeks.ago
+  end
+
+  def reset_stall
+    unburst
+  end
+
+  def check_for_burst_after_comment(comment)
+    return if !persisted? || burst?
+    return if comment.creator&.system?
+
+    auto_close_period = auto_postpone_period || Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i
+    window = auto_close_period / 3.0
+    cutoff = comment.created_at - window
+
+    recent_comments = comments.by_user.where(created_at: cutoff..comment.created_at)
+    if recent_comments.count >= 3 && recent_comments.select(:creator_id).distinct.count >= 2
+      burst!
+      return
+    end
+
+    all_nearby = comments.by_user.where(created_at: (comment.created_at - window)..(comment.created_at + window)).order(:created_at).to_a
+    all_nearby.each_with_index do |c, i|
+      c_window = all_nearby[i..].take_while { |other| other.created_at - c.created_at <= window }
+      if c_window.size >= 3 && c_window.map(&:creator_id).uniq.size >= 2
+        burst!
+        return
+      end
+    end
+  end
+end
