diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..43555dd
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,242 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @user1 = users(:david)
+    @user2 = users(:kevin)
+    @card = cards(:text)
+    @board = @card.board
+    @board.update! auto_postpone_period_in_days: 30
+  end
+
+  test "card gets a burst when someone is assigned to it" do
+    assert_not @card.burst?
+
+    @card.toggle_assignment(@user1)
+
+    assert @card.reload.burst?
+    assert @card.had_burst?
+  end
+
+  test "card gets a burst when someone reopens it" do
+    @card.close
+    assert @card.closed?
+
+    @card.reopen
+
+    assert @card.reload.burst?
+    assert @card.open?
+  end
+
+  test "card gets a burst when three or more comments from at least two people land within a third of board auto-close period" do
+    # writebook board has 30 days auto_postpone_period, so window is 10 days
+    assert_not @card.burst?
+
+    @card.comments.create!(creator: @user1, body: "First comment")
+    assert_not @card.reload.burst?
+
+    travel 2.days
+    @card.comments.create!(creator: @user2, body: "Second comment")
+    assert_not @card.reload.burst?
+
+    travel 2.days
+    @card.comments.create!(creator: @user1, body: "Third comment")
+    assert @card.reload.burst?
+  end
+
+  test "card does not get a burst when three comments are from the same person" do
+    assert_not @card.burst?
+
+    @card.comments.create!(creator: @user1, body: "First comment")
+    travel 1.day
+    @card.comments.create!(creator: @user1, body: "Second comment")
+    travel 1.day
+    @card.comments.create!(creator: @user1, body: "Third comment")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "card does not get a burst when only two comments land" do
+    assert_not @card.burst?
+
+    @card.comments.create!(creator: @user1, body: "First comment")
+    travel 1.day
+    @card.comments.create!(creator: @user2, body: "Second comment")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "card does not get a burst when three comments from two people are spread across more than a third of auto-close period" do
+    # 1/3 of 30 days is 10 days
+    assert_not @card.burst?
+
+    @card.comments.create!(creator: @user1, body: "First comment")
+    travel 12.days
+    @card.comments.create!(creator: @user2, body: "Second comment")
+    travel 12.days
+    @card.comments.create!(creator: @user1, body: "Third comment")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "system comments do not count towards burst comments" do
+    assert_not @card.burst?
+
+    @card.comments.create!(creator: @user1, body: "User comment 1")
+    @card.comments.create!(creator: @card.account.system_user, body: "System comment")
+    @card.comments.create!(creator: @user2, body: "User comment 2")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "burst respects board auto-close period" do
+    new_board = Board.create!(name: "Custom Period", account: @card.account, creator: @user1, auto_postpone_period_in_days: 90)
+    card = new_board.cards.create!(title: "Custom period card", creator: @user1, status: "published")
+
+    card.comments.create!(creator: @user1, body: "First comment")
+    travel 12.days
+    card.comments.create!(creator: @user2, body: "Second comment")
+    travel 12.days
+    card.comments.create!(creator: @user1, body: "Third comment")
+
+    # 24 days total, which is within 30 days (1/3 of 90 days)
+    assert card.reload.burst?
+  end
+
+  test "card that had a burst and sees no activity for two weeks is stalled" do
+    @card.burst!
+    @card.update!(last_active_at: Time.current)
+
+    assert_not @card.stalled?
+
+    travel 13.days
+    assert_not @card.stalled?
+
+    travel 2.days # 15 days total > 2 weeks
+    assert @card.stalled?
+  end
+
+  test "card without a burst and no activity for two weeks is not stalled" do
+    @card.update!(last_active_at: 3.weeks.ago)
+
+    assert_not @card.stalled?
+  end
+
+  test "closed or postponed card is not stalled" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.close
+    assert_not @card.stalled?
+
+    @card.reopen
+    @card.postpone
+    assert_not @card.stalled?
+  end
+
+  test "any activity on a stalled card resets it" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    # Add a single comment
+    @card.comments.create!(creator: @user1, body: "A single ping")
+
+    assert_not @card.reload.stalled?
+    assert_not @card.burst?
+
+    # Two weeks later, it should NOT stall again because the burst was cleared
+    travel 3.weeks
+    assert_not @card.reload.stalled?
+  end
+
+  test "reaction on a stalled card resets it" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.reactions.create!(content: "❤️", reacter: @user1)
+
+    assert_not @card.reload.stalled?
+    assert_not @card.burst?
+  end
+
+  test "activity on a burst card before it stalls preserves burst and resets the timer" do
+    @card.burst!
+    @card.update!(last_active_at: Time.current)
+    assert_not @card.stalled?
+
+    # Activity at 1 week (not stalled yet)
+    travel 1.week
+    @card.comments.create!(creator: @user1, body: "Working on it")
+
+    assert_not @card.reload.stalled?
+    assert @card.burst?
+
+    # 1 week after comment (2 weeks from start, but only 1 week from comment)
+    travel 1.week
+    assert_not @card.reload.stalled?
+
+    # 2 weeks after comment
+    travel 1.week + 1.day
+    assert @card.reload.stalled?
+  end
+
+  test "assigning someone to a stalled card resets the stall and starts a new burst" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.toggle_assignment(@user2)
+
+    assert_not @card.reload.stalled?
+    assert @card.burst?
+
+    travel 3.weeks
+    assert @card.reload.stalled?
+  end
+
+test "changing title on a stalled card resets it" do
+  @card.burst!
+  @card.update!(last_active_at: 3.weeks.ago)
+  assert @card.stalled?
+
+  @card.update!(title: "Brand new title")
+
+  assert_not @card.reload.stalled?
+  assert_not @card.burst?
+end
+
+test "triaging a stalled card resets it" do
+  @card.burst!
+  @card.update!(last_active_at: 3.weeks.ago)
+  assert @card.stalled?
+
+  col = columns(:writebook_triage)
+  @card.triage_into(col)
+
+  assert_not @card.reload.stalled?
+  assert_not @card.burst?
+end
+
+test "assignments.create directly gives a burst" do
+  assert_not @card.burst?
+
+  @card.assignments.create!(assignee: @user1, assigner: @user2)
+
+  assert @card.reload.burst?
+end
+
+test "Card.stalled scope" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+
+    active_card = cards(:logo)
+    active_card.update!(last_active_at: Time.current)
+
+    assert_includes Card.stalled, @card
+    assert_not_includes Card.stalled, active_card
+  end
+end
