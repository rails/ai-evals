   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ..1.week.ago) }
+
+  validates :event_id, uniqueness: { scope: :webhook_id }
+
+  class << self
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def deliver
+    return unless pending?
+
+    rows_affected = self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current)
+    return if rows_affected.zero?
+
+    reload
+
+    timestamp = (created_at || Time.current).utc.iso8601
+    body = payload_body
+    signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
