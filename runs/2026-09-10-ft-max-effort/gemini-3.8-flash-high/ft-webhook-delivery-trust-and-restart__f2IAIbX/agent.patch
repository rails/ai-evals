@@ -0,0 +1,156 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @user = users(:david)
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+  end
+
+  test "event creation enqueues Event::RelayJob" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      @board.events.create!(
+        action: "card_published",
+        creator: @user,
+        eventable: @card,
+        account: @board.account
+      )
+    end
+  end
+
+  test "relay_now delivers to active subscribed webhooks on the board" do
+    webhook = @board.webhooks.create!(
+      name: "Subscriber",
+      url: "https://example.com/receiver",
+      subscribed_actions: %w[ card_published ]
+    )
+
+    stub_request(:post, webhook.url).to_return(status: 200, body: '{"ok":true}')
+
+    event = @board.events.create!(
+      action: "card_published",
+      creator: @user,
+      eventable: @card,
+      account: @board.account
+    )
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      event.relay_now
+    end
+
+    assert_requested :post, webhook.url, times: 1
+    delivery = webhook.deliveries.find_by(event: event)
+    assert_equal "completed", delivery.state
+    assert delivery.succeeded?
+  end
+
+  test "relay_now does not deliver to webhooks not subscribed to the action" do
+    webhook = @board.webhooks.create!(
+      name: "Only Comments",
+      url: "https://example.com/receiver",
+      subscribed_actions: %w[ comment_created ]
+    )
+
+    event = @board.events.create!(
+      action: "card_published",
+      creator: @user,
+      eventable: @card,
+      account: @board.account
+    )
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now does not deliver to inactive webhooks" do
+    webhook = @board.webhooks.create!(
+      name: "Inactive Hook",
+      url: "https://example.com/receiver",
+      subscribed_actions: %w[ card_published ],
+      active: false
+    )
+
+    event = @board.events.create!(
+      action: "card_published",
+      creator: @user,
+      eventable: @card,
+      account: @board.account
+    )
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now does not deliver to webhooks on other boards" do
+    other_board = boards(:private)
+    other_webhook = other_board.webhooks.create!(
+      name: "Other Board Hook",
+      url: "https://example.com/receiver",
+      subscribed_actions: %w[ card_published ]
+    )
+
+    event = @board.events.create!(
+      action: "card_published",
+      creator: @user,
+      eventable: @card,
+      account: @board.account
+    )
+
+    assert_no_difference -> { other_webhook.deliveries.count } do
+      event.relay_now
+    end
+  end
+
+  test "deliver exactly once: multiple relay_now calls do not re-deliver" do
+    webhook = @board.webhooks.create!(
+      name: "Once Hook",
+      url: "https://example.com/receiver",
+      subscribed_actions: %w[ card_published ]
+    )
+
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    event = @board.events.create!(
+      action: "card_published",
+      creator: @user,
+      eventable: @card,
+      account: @board.account
+    )
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      event.relay_now
+      event.relay_now
+    end
+
+    assert_requested :post, webhook.url, times: 1
+  end
+
+  test "relay_now deactivates delinquent webhook without sending request" do
+    webhook = @board.webhooks.create!(
+      name: "Delinquent Hook",
+      url: "https://example.com/receiver",
+      subscribed_actions: %w[ card_published ]
+    )
+
+    webhook.delinquency_tracker.update!(
+      consecutive_failures_count: 10,
+      first_failure_at: 2.hours.ago
+    )
+
+    event = @board.events.create!(
+      action: "card_published",
+      creator: @user,
+      eventable: @card,
+      account: @board.account
+    )
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      event.relay_now
+    end
+
+    assert_not webhook.reload.active?, "webhook should have been deactivated"
+  end
+end
