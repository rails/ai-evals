+      "Content-Type" => "application/json",
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Timestamp" => timestamp
+    }
+
+    self.request = { "headers" => request_headers }
+
+    begin
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = (uri.scheme == "https")
+      http.open_timeout = 5
+      http.read_timeout = 10
+
+      http_request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |key, value| http_request[key] = value }
+      http_request.body = body
+
+      http_response = http.request(http_request)
+
+      self.state = :completed
+      self.response = {
+        "code" => http_response.code.to_i,
+        "headers" => http_response.each_header.to_h
+      }
+    rescue StandardError => error
+      self.state = :errored
+      self.response = { "error" => error.message.presence || error.class.name }
+    ensure
+      save!
+      webhook.delinquency_tracker&.record(self)
+    end
+  end
 
   def sanitized_request
-    if headers = request&.dig("headers")&.except("X-Webhook-Signature")
+    if headers = request_headers&.except("X-Webhook-Signature")
       { headers: headers }
     end
   end
 
   def response_summary
     if response.present?
-      { code: response[:code], error: response[:error] }
+      { code: response_code, error: response_error }
     end
   end
 
@@ -27,6 +84,55 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response_error.blank? && response_code&.between?(200, 299)
   end
+
+  private
+    def request_headers
+      request&.dig(:headers) || request&.dig("headers")
+    end
+
+    def response_code
+      code = response&.dig(:code) || response&.dig("code")
+      code&.to_i
+    end
+
+    def response_error
+      response&.dig(:error) || response&.dig("error")
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: account.slug)
+    end
+
+    def payload_body
+      if webhook.for_campfire? || webhook.for_basecamp?
+        { "content" => rendered_html }.to_json
+      elsif webhook.for_slack?
+        { "text" => rendered_text }.to_json
+      else
+        rendered_json
+      end
+    end
+
+    def rendered_json
+      renderer.render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: :json
+      )
+    end
+
+    def rendered_html
+      renderer.render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: :html,
+        layout: false
+      ).strip
+    end
+
+    def rendered_text
+      CGI.unescapeHTML(rendered_html.gsub(/<a\s+href="([^"]+)">([^<]+)<\/a>/, '<\1|\2>'))
