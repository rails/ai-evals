@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+    @event = events(:logo_published)
+  end
+
+  test "auto-created with webhook" do
+    new_webhook = Webhook.create!(board: boards(:writebook), name: "New", url: "https://example.com/hook")
+    assert_not_nil new_webhook.delinquency_tracker
+    assert_equal 0, new_webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil new_webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "records failure and increments consecutive_failures_count" do
+    delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :errored, response: { error: "timeout" })
+
+    assert_changes -> { @tracker.consecutive_failures_count }, from: 0, to: 1 do
+      @tracker.record(delivery)
+    end
+    assert_not_nil @tracker.first_failure_at
+  end
+
+  test "successful delivery resets consecutive failures and first_failure_at" do
+    @tracker.update!(consecutive_failures_count: 5, first_failure_at: 30.minutes.ago)
+
+    success_delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :completed, response: { code: 200 })
+    @tracker.record(success_delivery)
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "does not switch off if fewer than 10 failures over an hour" do
+    travel_to 2.hours.ago do
+      failed_delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :errored, response: { error: "fail" })
+      @tracker.record(failed_delivery)
+    end
+
+    8.times do
+      failed_delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :errored, response: { error: "fail" })
+      @tracker.record(failed_delivery)
+    end
+
+    assert_equal 9, @tracker.consecutive_failures_count
+    assert @tracker.first_failure_at <= 1.hour.ago
+    assert_not @tracker.delinquent?
+    assert @webhook.active?
+  end
+
+  test "does not switch off if 10 failures happen in less than an hour" do
+    10.times do
+      failed_delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :errored, response: { error: "fail" })
+      @tracker.record(failed_delivery)
+    end
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert_not @tracker.delinquent?
+    assert @webhook.active?
+  end
+
+  test "switches off when 10 consecutive failures happen over an hour" do
+    travel_to 70.minutes.ago do
+      failed_delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :errored, response: { error: "fail" })
+      @tracker.record(failed_delivery)
+    end
+
+    9.times do
+      failed_delivery = Webhook::Delivery.new(webhook: @webhook, event: @event, state: :errored, response: { error: "fail" })
+      @tracker.record(failed_delivery)
+    end
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert @tracker.delinquent?
+    assert_not @webhook.reload.active?, "webhook should be deactivated"
+  end
+
+  test "reactivating webhook resets delinquency tracker" do
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+
+    assert_not @webhook.active?
+
+    @webhook.activate
+
+    assert @webhook.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
