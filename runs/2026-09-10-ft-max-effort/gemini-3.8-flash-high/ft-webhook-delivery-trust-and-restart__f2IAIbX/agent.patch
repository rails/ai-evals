--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,31 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  THRESHOLD = 10
+  PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      reset
+    elsif delivery.failed?
+      self.first_failure_at ||= delivery.created_at || Time.current
+      self.consecutive_failures_count += 1
+      save!
+
+      if delinquent?
+        webhook.deactivate
+      end
+    end
+  end
+
+  def delinquent?
+    consecutive_failures_count >= THRESHOLD && first_failure_at.present? && first_failure_at <= PERIOD.ago
+  end
+
+  def reset
+    unless consecutive_failures_count.zero? && first_failure_at.nil?
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+  end
+end
