diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..28793b0
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago" do
+    account = Account.create!(name: "Due For Incineration")
+    user = account.users.create!(role: :owner, name: "Owner")
+    account.cancel(initiated_by: user)
+    account.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not Account::Cancellation.where(account_id: account.id).exists?
+  end
+
+  test "does not incinerate accounts canceled less than 30 days ago" do
+    account = Account.create!(name: "Recently Canceled")
+    user = account.users.create!(role: :owner, name: "Owner")
+    account.cancel(initiated_by: user)
+    account.cancellation.update_columns(created_at: 29.days.ago, updated_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+    assert account.reload.cancelled?
+  end
+
+  test "does not incinerate active uncanceled accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "does not incinerate reactivated accounts" do
+    account = Account.create!(name: "Reactivated Account")
+    user = account.users.create!(role: :owner, name: "Owner")
+    account.cancel(initiated_by: user)
+    account.cancellation.update_columns(created_at: 35.days.ago, updated_at: 35.days.ago)
+    account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+    assert_not account.reload.cancelled?
+  end
+
+  test "incinerates multiple due accounts when enqueued as background job" do
+    account1 = Account.create!(name: "Due Account 1")
+    user1 = account1.users.create!(role: :owner, name: "Owner 1")
+    account1.cancel(initiated_by: user1)
+    account1.cancellation.update_columns(created_at: 32.days.ago, updated_at: 32.days.ago)
+
+    account2 = Account.create!(name: "Due Account 2")
+    user2 = account2.users.create!(role: :owner, name: "Owner 2")
+    account2.cancel(initiated_by: user2)
+    account2.cancellation.update_columns(created_at: 40.days.ago, updated_at: 40.days.ago)
+
+    account3 = Account.create!(name: "Not Due Account")
+    user3 = account3.users.create!(role: :owner, name: "Owner 3")
+    account3.cancel(initiated_by: user3)
+    account3.cancellation.update_columns(created_at: 15.days.ago, updated_at: 15.days.ago)
+
+    perform_enqueued_jobs do
+      Account::IncinerateDueJob.perform_later
+    end
+
+    assert_not Account.exists?(account1.id)
+    assert_not Account.exists?(account2.id)
+    assert Account.exists?(account3.id)
+  end
+
+  test "permanently removes all associated data from the database" do
+    account = Account.create!(name: "Data Removal Test")
+    owner = account.users.create!(role: :owner, name: "Owner")
+    account_id = account.id
+
+    Current.set(account: account, user: owner) do
+      board = account.boards.create!(name: "Main Board", creator: owner)
+      column = board.columns.create!(name: "To Do")
+      card = board.cards.create!(title: "Task 1", creator: owner, column: column, status: :published)
+      comment = card.comments.create!(body: "Discussion", creator: owner)
+      tag = account.tags.create!(title: "feature")
+      card.tags << tag
+      card.reactions.create!(content: "🎉", reacter: owner)
+
+      card.image.attach(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      owner.avatar.attach(
+        io: file_fixture("moon.jpg").open,
+        filename: "avatar.jpg",
+        content_type: "image/jpeg"
+      )
+
+      # Create webhook and delivery
+      webhook = board.webhooks.create!(name: "Hook", url: "https://example.com/webhook")
+      event = Event.create!(account: account, board: board, creator: owner, eventable: card, action: "test")
+      Webhook::Delivery.create!(account: account, webhook: webhook, event: event)
+
+      # Create export
+      export = Account::Export.create!(account: account, user: owner)
+      export.file.attach(
+        io: StringIO.new("fake zip content"),
+        filename: "export.zip",
+        content_type: "application/zip"
+      )
+
+      Storage::Entry.record(account: account, board: board, recordable: card, delta: 1024, operation: "attach")
+
+      account.cancel(initiated_by: owner)
+      account.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+    end
+
+    quoted_id = Account.connection.quote(Account.type_for_attribute("id").serialize(account_id))
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account_id)
+
+    # Verify no records remain in any table with account_id
+    tables_with_records = {}
+    Account.connection.tables.each do |table|
+      columns = Account.connection.columns(table).map(&:name)
+      if columns.include?("account_id")
+        cnt = Account.connection.select_value("SELECT COUNT(*) FROM #{Account.connection.quote_table_name(table)} WHERE account_id = #{quoted_id}")
+        tables_with_records[table] = cnt if cnt > 0
+      end
+    end
+
+    assert_empty tables_with_records, "Records still exist in: #{tables_with_records.inspect}"
+  end
+end
