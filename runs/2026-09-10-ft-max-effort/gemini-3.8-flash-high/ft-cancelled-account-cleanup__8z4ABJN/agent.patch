diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..cef07ad
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "INCINERATION_GRACE_PERIOD is 30 days" do
+    assert_equal 30.days, Account::Incineratable::INCINERATION_GRACE_PERIOD
+  end
+
+  test "due_for_incineration scope returns accounts canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    recent_account = Account.create!(name: "Recent")
+    recent_user = recent_account.users.create!(role: :owner, name: "Recent Owner")
+    recent_account.cancel(initiated_by: recent_user)
+    recent_account.cancellation.update_columns(created_at: 10.days.ago, updated_at: 10.days.ago)
+
+    active_account = Account.create!(name: "Active")
+
+    due = Account.due_for_incineration
+    assert_includes due, @account
+    assert_not_includes due, recent_account
+    assert_not_includes due, active_account
+  end
+
+  test "due_for_incineration? predicate" do
+    assert_not @account.due_for_incineration?
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 20.days.ago, updated_at: 20.days.ago)
+    assert_not @account.due_for_incineration?
+
+    @account.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+    assert @account.due_for_incineration?
+  end
+
+  test "incinerate_due incinerates only accounts due for incineration" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    recent_account = Account.create!(name: "Recent Canceled")
+    recent_user = recent_account.users.create!(role: :owner, name: "Owner")
+    recent_account.cancel(initiated_by: recent_user)
+    recent_account.cancellation.update_columns(created_at: 5.days.ago, updated_at: 5.days.ago)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(recent_account.id)
+  end
+
+  test "incinerate runs callbacks" do
+    account = Account.create!(name: "Callback Account")
+    user = account.users.create!(role: :owner, name: "Owner")
+    account.cancel(initiated_by: user)
+
+    called = false
+    Account.set_callback(:incinerate, :before) { called = true }
+
+    account.incinerate
+
+    assert called
+  ensure
+    Account.reset_callbacks(:incinerate)
+  end
+
+  test "incinerate removes all account records across all database tables" do
+    account = Account.create!(name: "Full Data Test")
+    owner = account.users.create!(role: :owner, name: "Owner")
+    account_id = account.id
+
+    Current.set(account: account, user: owner) do
+      board = account.boards.create!(name: "Board", creator: owner)
+      column = board.columns.create!(name: "Col")
+      card = board.cards.create!(title: "Card", creator: owner, column: column, status: :published)
+      comment = card.comments.create!(body: "Comment", creator: owner)
+      tag = account.tags.create!(title: "Tag")
+      card.tags << tag
+
+      card.image.attach(
+        io: file_fixture("moon.jpg").open,
+        filename: "card_image.jpg",
+        content_type: "image/jpeg"
+      )
+      owner.avatar.attach(
+        io: file_fixture("moon.jpg").open,
+        filename: "avatar_image.jpg",
+        content_type: "image/jpeg"
+      )
+
+      Storage::Entry.record(account: account, board: board, recordable: card, delta: 2048, operation: "attach")
+      account.cancel(initiated_by: owner)
+      account.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+    end
+
+    quoted_id = Account.connection.quote(Account.type_for_attribute("id").serialize(account_id))
+
+    account.incinerate
+
+    assert_not Account.exists?(account_id)
+
+    Account.connection.tables.each do |table|
+      columns = Account.connection.columns(table).map(&:name)
+      if columns.include?("account_id")
+        cnt = Account.connection.select_value("SELECT COUNT(*) FROM #{Account.connection.quote_table_name(table)} WHERE account_id = #{quoted_id}")
+        assert_equal 0, cnt, "Table #{table} still has #{cnt} records with account_id #{account_id}"
+      end
+    end
+  end
+end
