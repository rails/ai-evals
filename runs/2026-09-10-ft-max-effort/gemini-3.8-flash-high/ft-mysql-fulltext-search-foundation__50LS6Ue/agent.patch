+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center borderless flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half full-width" do |form| %>
+    <div class="input flex flex-item-grow align-center gap-half">
+      <%= icon_tag "search", class: "txt-subtle" %>
+      <%= form.search_field :q, value: @query, placeholder: "Search cards by title, description, or comment…", autofocus: true, class: "input borderless full-width txt-small unpad" %>
+    </div>
+    <%= form.submit "Search", class: "btn btn--primary" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div class="search-results flex flex-column gap">
+        <% @cards.each do |card| %>
+          <%= render "searches/card", card: card, query: @query %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">
+        No cards found matching &ldquo;<%= @query %>&rdquo;
+      </div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">
+      Type something above to search cards
+    </div>
+  <% end %>
+</section>
