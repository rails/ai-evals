index 0000000..5b360a1
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,55 @@
+module SearchesHelper
+  def search_highlight(text, query)
+    if text.blank? || query.blank?
+      text
+    else
+      words = query.to_s.split(/\s+/).reject(&:blank?)
+      if words.empty?
+        text
+      else
+        highlight(text, words)
+      end
+    end
+  end
+
+  def search_content_snippet(content, query, radius: 100)
+    if content.blank?
+      nil
+    else
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text = text.gsub(/\s+/, " ").strip
+      if text.blank?
+        nil
+      else
+        words = query.to_s.split(/\s+/).reject(&:blank?)
+        if words.empty?
+          text.truncate(radius * 2)
+        else
+          first_match = words.find { |w| text.match?(Regexp.new(Regexp.escape(w), Regexp::IGNORECASE)) }
+          if first_match
+            excerpt_text = excerpt(text, first_match, radius: radius) || text.truncate(radius * 2)
+            highlight(excerpt_text, words)
+          else
+            text.truncate(radius * 2)
+          end
+        end
+      end
+    end
+  end
+
+  def search_matching_comments_for(card, query)
+    if query.blank?
+      []
+    else
+      words = query.to_s.split(/\s+/).reject(&:blank?)
+      if words.empty?
+        []
+      else
+        card.comments.select do |comment|
+          plain_text = comment.body&.to_plain_text.to_s
+          words.any? { |w| plain_text.match?(Regexp.new(Regexp.escape(w), Regexp::IGNORECASE)) }
+        end
+      end
+    end
+  end
+end
