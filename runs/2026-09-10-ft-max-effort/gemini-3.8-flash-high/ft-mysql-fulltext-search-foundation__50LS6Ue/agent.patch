+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  test "search with blank query returns none" do
+    assert_empty Card.search("")
+    assert_empty Card.search("   ")
+    assert_empty Card.search(nil)
+  end
+
+  test "search finds cards by title" do
+    results = Card.search("logo")
+    assert_includes results, cards(:logo)
+  end
+
+  test "search finds cards by description" do
+    card = cards(:logo)
+    card.update!(description: "Detailed architecture overview")
+    results = Card.search("architecture")
+    assert_includes results, card
+  end
+
+  test "search finds cards by comment body" do
+    results = Card.search("overflowing")
+    assert_includes results, cards(:layout)
+  end
+
+  test "search excludes draft cards" do
+    draft = cards(:unfinished_thoughts)
+    assert draft.drafted?
+
+    results = Card.search(draft.title)
+    assert_not_includes results, draft
+  end
+
+  test "search excludes comments on draft cards" do
+    card = nil
+    Current.set(user: users(:david)) do
+      card = boards(:writebook).cards.create!(title: "Temporary card", status: "published", creator: users(:david))
+      card.comments.create!(creator: users(:david), body: "Unique comment on draft")
+      card.update_columns(status: "drafted")
+    end
+
+    results = Card.search("Unique comment on draft")
+    assert_not_includes results, card
+  end
+
+  test "search with multiple words requires all words to match" do
+    results = Card.search("text small")
