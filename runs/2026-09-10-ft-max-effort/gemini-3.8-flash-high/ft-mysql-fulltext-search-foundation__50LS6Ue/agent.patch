+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = if @query.present?
+      Current.user.accessible_cards
+        .published
+        .search(@query)
+        .reverse_chronologically
+        .preloaded
+        .preload(comments: [ :creator, :rich_text_body ])
+    else
+      Card.none
+    end
+
+    respond_to do |format|
+      format.html
+      format.json
+    end
+  end
+end
