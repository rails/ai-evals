@@ -0,0 +1,41 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) { search_by_content(query) }
+    scope :search_by_content, ->(query) do
+      if query.blank?
+        none
+      else
+        words = query.to_s.split(/\s+/).reject(&:blank?)
+        if words.empty?
+          none
+        else
+          relation = all.published
+          words.each do |word|
+            pattern = "%#{sanitize_sql_like(word)}%"
+
+            desc_ids = ActionText::RichText
+              .where(record_type: "Card", name: "description")
+              .where("body LIKE ?", pattern)
+              .select(:record_id)
+
+            comment_card_ids = Comment
+              .joins(:card, :rich_text_body)
+              .merge(Card.published)
+              .where("action_text_rich_texts.body LIKE ?", pattern)
+              .select(:card_id)
+
+            relation = relation.where(
+              "cards.title LIKE :pattern OR cards.id IN (:desc_ids) OR cards.id IN (:comment_card_ids)",
+              pattern: pattern,
+              desc_ids: desc_ids,
+              comment_card_ids: comment_card_ids
+            )
+          end
+          relation.distinct
+        end
+      end
+    end
+  end
+end
