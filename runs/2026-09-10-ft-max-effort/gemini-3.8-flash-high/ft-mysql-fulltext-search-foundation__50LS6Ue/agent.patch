+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  include HtmlHelper
+
+  test "search_highlight wraps matched words in mark" do
+    assert_equal "The <mark>logo</mark> isn't big enough", search_highlight("The logo isn't big enough", "logo")
+  end
+
+  test "search_highlight is case-insensitive and preserves original text case" do
+    assert_equal "The <mark>LOGO</mark> isn't big enough", search_highlight("The LOGO isn't big enough", "logo")
+    assert_equal "The <mark>logo</mark> isn't big enough", search_highlight("The logo isn't big enough", "LOGO")
+  end
+
+  test "search_highlight handles multiple words" do
+    assert_equal "<mark>The</mark> <mark>logo</mark> isn't big enough", search_highlight("The logo isn't big enough", "the logo")
+  end
+
+  test "search_highlight returns blank text as-is" do
+    assert_nil search_highlight(nil, "logo")
+    assert_equal "", search_highlight("", "logo")
+  end
+
+  test "search_highlight returns text as-is when query is blank" do
+    assert_equal "The logo", search_highlight("The logo", "")
+    assert_equal "The logo", search_highlight("The logo", "   ")
+    assert_equal "The logo", search_highlight("The logo", nil)
+  end
+
+  test "search_highlight handles code and escaped html" do
+    title = card_html_title(cards(:logo).tap { _1.title = "Fix the `bug` in production" })
+    assert_equal "Fix the <code><mark>bug</mark></code> in production", search_highlight(title, "bug")
+  end
+
+  test "search_content_snippet returns nil for blank content" do
+    assert_nil search_content_snippet(nil, "term")
+    assert_nil search_content_snippet("", "term")
+  end
+
+  test "search_content_snippet wraps matched words in mark" do
+    content = "This is a detailed specification about the application header."
+    result = search_content_snippet(content, "specification")
+    assert_includes result, "<mark>specification</mark>"
+  end
+
+  test "search_content_snippet handles ActionText content" do
+    content = ActionText::Content.new("<p>This is rich text with a <a href='#'>secret</a> keyword.</p>")
+    result = search_content_snippet(content, "secret")
+    assert_includes result, "<mark>secret</mark>"
+    assert_not_includes result, "<p>"
+    assert_not_includes result, "<a"
+  end
+
+  test "search_content_snippet truncates non-matching content" do
+    content = "A" * 300
+    result = search_content_snippet(content, "nonexistent")
+    assert_equal 200, result.length
+    assert_not_includes result, "<mark>"
+  end
+
+  test "search_matching_comments_for returns only matching comments" do
+    card = cards(:logo)
+    # card logo has comments: logo_agreement_jz ("I agree.") and logo_agreement_kevin ("Same, let's do it.")
+    matching = search_matching_comments_for(card, "agree")
+    assert_equal 1, matching.size
+    assert_equal comments(:logo_agreement_jz), matching.first
+
+    assert_empty search_matching_comments_for(card, "nonexistentword")
+    assert_empty search_matching_comments_for(card, "")
+  end
+end
