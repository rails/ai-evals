@@ -0,0 +1,206 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "search page is accessible without query" do
+    get search_path
+    assert_response :success
+    assert_select "input[name='q']"
+    assert_select ".card", count: 0
+    assert_select ".blank-slate", text: /Type something/
+  end
+
+  test "search with blank or whitespace query returns no cards" do
+    get search_path, params: { q: "" }
+    assert_response :success
+    assert_select ".card", count: 0
+
+    get search_path, params: { q: "   " }
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "finds card by title with matched words wrapped in mark" do
+    get search_path, params: { q: "logo" }
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "mark", text: "logo"
+    assert_select "a[href=?]", card_path(cards(:logo))
+  end
+
+  test "finds card by description with matched words wrapped in mark" do
+    card = cards(:logo)
+    card.update!(description: "This is a detailed specification about the application header.")
+
+    get search_path, params: { q: "specification" }
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "mark", text: "specification"
+    assert_select "a[href=?]", card_path(card)
+  end
+
+  test "finds card by comment body with matched words wrapped in mark" do
+    # layout_overflowing_david comment has "The text is overflowing the container."
+    get search_path, params: { q: "overflowing" }
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "mark", text: "overflowing"
+    assert_select "a[href=?]", card_path(cards(:layout))
+  end
+
+  test "finds card when words are in different attributes (title and description)" do
+    card = cards(:logo)
+    card.update!(description: "Needs responsive layout adjustments.")
+
+    get search_path, params: { q: "logo responsive" }
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "a[href=?]", card_path(card)
+    mark_texts = css_select("mark").map(&:text).map(&:downcase)
+    assert_includes mark_texts, "logo"
+    assert_includes mark_texts, "responsive"
+  end
+
+  test "results are ordered newest first" do
+    board = boards(:writebook)
+    card1 = card2 = nil
+
+    Current.set(user: users(:david)) do
+      card1 = board.cards.create!(title: "Feature A searchterm", status: "published", creator: users(:david), created_at: 2.days.ago)
+      card2 = board.cards.create!(title: "Feature B searchterm", status: "published", creator: users(:david), created_at: 1.day.ago)
+    end
+
+    get search_path, params: { q: "searchterm" }
+    assert_response :success
+
+    assert_select ".card", count: 2
+    # card2 is newer than card1, so card2 should appear first
+    card_links = css_select(".card__title-link").map(&:text).map(&:strip)
+    assert_equal [ card2.title, card1.title ], card_links
+  end
+
+  test "people only ever see results from boards they currently have access to" do
+    # boards(:private) is accessible only to kevin, not david
+    private_card = nil
+    Current.set(user: users(:kevin)) do
+      private_card = boards(:private).cards.create!(
+        title: "Secret confidential strategy",
+        status: "published",
+        creator: users(:kevin)
+      )
+    end
+
+    # David does not have access to boards(:private)
+    get search_path, params: { q: "confidential" }
+    assert_response :success
+    assert_select ".card", count: 0
+    assert_select "mark", count: 0
+
+    # Kevin has access to boards(:private)
+    logout_and_sign_in_as :kevin
+    get search_path, params: { q: "confidential" }
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "confidential"
+    assert_select "a[href=?]", card_path(private_card)
+  end
+
+  test "revoking access from a board removes its cards from search results" do
+    logout_and_sign_in_as :kevin
+
+    # Kevin has access to boards(:private)
+    get search_path, params: { q: "private" }
+    assert_response :success
+
+    # Revoke access to writebook from kevin
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    # Now kevin should not see writebook cards (like cards(:logo))
+    get search_path, params: { q: "logo" }
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    board = boards(:writebook)
+    draft_card = nil
+
+    Current.set(user: users(:david)) do
+      draft_card = board.cards.create!(
+        title: "Draft card secretuniquekeyword",
+        description: "Secretuniquekeyword in draft description",
+        status: "published",
+        creator: users(:david)
+      )
+      draft_card.comments.create!(
+        creator: users(:david),
+        body: "Secretuniquekeyword in draft comment"
+      )
+      draft_card.update_columns(status: "drafted")
+    end
+
+    get search_path, params: { q: "secretuniquekeyword" }
+    assert_response :success
+    assert_select ".card", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "case-insensitive search" do
+    get search_path, params: { q: "LOGO" }
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "mark" do |elements|
+      assert_equal "logo", elements.first.text.downcase
+    end
+  end
+
+  test "search handles multiple words" do
+    get search_path, params: { q: "text small" }
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "a[href=?]", card_path(cards(:text))
+    mark_texts = css_select("mark").map(&:text).map(&:downcase)
+    assert_includes mark_texts, "text"
+    assert_includes mark_texts, "small"
+  end
+
+  test "search handles punctuation and apostrophes" do
+    get search_path, params: { q: "isn't" }
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "mark", text: "isn't"
+  end
+
+  test "search safely escapes HTML special characters" do
+    get search_path, params: { q: "<script>alert('xss')</script>" }
+    assert_response :success
+    assert_not_includes response.body, "<script>alert('xss')</script>"
+  end
+
+  test "no results displays blank slate" do
+    get search_path, params: { q: "nonexistentuniquekeyword12345" }
+    assert_response :success
+
+    assert_select ".card", count: 0
+    assert_select ".blank-slate", text: /No cards found matching/
+  end
+
+  test "JSON format returns matching cards" do
+    get search_path(format: :json), params: { q: "logo" }
+    assert_response :success
+
+    numbers = @response.parsed_body.pluck("number")
+    assert_equal [ cards(:logo).number ], numbers
+  end
+end
