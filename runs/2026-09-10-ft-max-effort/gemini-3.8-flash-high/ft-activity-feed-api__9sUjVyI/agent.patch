+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, payload["particulars"])
+  end
+
+  test "particulars for title changes returns empty strings when missing" do
