+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.user = users(:david)
+  end
+
+  test "index returns flat array of activities as JSON" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_operator @response.parsed_body.length, :>, 0
+  end
+
+  test "index works with direct account slug URL" do
+    account = accounts("37s")
+    get "/#{account.external_account_id}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index with bearer token authentication" do
+    account = accounts("37s")
+    token = identity_access_tokens(:davids_api_token).token
+    bearer_env = { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+
+    get "/#{account.external_account_id}/activities.json", env: bearer_env
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index rejects HTML format" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "each event contains all required fields" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    required_keys = %w[ id action created_at description particulars url eventable_type eventable board creator ]
+
+    @response.parsed_body.each do |event|
+      required_keys.each do |key|
+        assert event.key?(key), "Event #{event['id']} missing key #{key}"
+      end
+    end
+  end
+
+  test "uses existing API representations for board, creator, and eventable" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    event = @response.parsed_body.first
+    assert event["board"].key?("id")
+    assert event["board"].key?("name")
+    assert event["board"].key?("url")
+
+    assert event["creator"].key?("id")
+    assert event["creator"].key?("name")
+    assert event["creator"].key?("email_address")
+    assert event["creator"].key?("url")
+
+    assert event["eventable"].key?("id")
+    assert event["eventable"].key?("url")
+  end
+
+  test "description is plain text" do
+    event = events(:logo_published)
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal event.description_for(users(:david)).to_plain_text, payload["description"]
+  end
+
+  test "card event url opens the card" do
+    event = events(:logo_published)
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal card_url(event.card), payload["url"]
+  end
+
+  test "comment event url opens the card and jumps to the comment" do
+    event = events(:layout_commented)
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    expected_url = card_url(event.card, anchor: "comment_#{event.eventable_id}")
+    assert_equal expected_url, payload["url"]
+  end
+
+  test "particulars for assignment changes contains assignee_ids" do
+    event = events(:logo_assignment_jz)
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, payload["particulars"])
+  end
+
+  test "particulars for board changes contains old_board and new_board" do
+    card = cards(:logo)
+    event = card.events.create!(
+      action: "card_board_changed",
+      creator: users(:david),
+      board: card.board,
+      particulars: { particulars: { old_board: "Old Board", new_board: "New Board" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal({ "old_board" => "Old Board", "new_board" => "New Board" }, payload["particulars"])
+  end
+
+  test "particulars for board changes returns empty strings when missing" do
+    card = cards(:logo)
+    event = card.events.create!(
+      action: "card_board_changed",
+      creator: users(:david),
+      board: card.board,
+      particulars: {}
