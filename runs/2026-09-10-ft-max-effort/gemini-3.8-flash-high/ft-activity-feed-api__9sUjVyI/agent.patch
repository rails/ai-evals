+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal({ "column" => "" }, payload["particulars"])
+  end
+
+  test "particulars for other events is empty object" do
+    card = cards(:logo)
+    event = card.events.create!(
+      action: "card_published",
+      creator: users(:david),
+      board: card.board,
+      particulars: { something: "else" }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal({}, payload["particulars"])
+  end
+
+  test "particulars for card_sent_back_to_triage is empty object" do
+    event = events(:buy_domain_sent_back_to_triage)
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal({}, payload["particulars"])
+  end
+
+  test "omits deprecated card_collection_changed events" do
+    card = cards(:logo)
+    event = card.events.create!(
+      action: "card_collection_changed",
+      creator: users(:david),
+      board: card.board,
+      particulars: { particulars: { old_board: "Old", new_board: "New" } }
