diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..36892c8 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,64 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def particulars_for_api
+    case action
+    when "card_assigned", "card_unassigned"
+      { "assignee_ids" => api_assignee_ids }
+    when "card_board_changed"
+      { "old_board" => api_old_board, "new_board" => api_new_board }
+    when "card_title_changed"
+      { "old_title" => api_old_title, "new_title" => api_new_title }
+    when "card_triaged"
+      { "column" => api_column }
+    else
+      {}
+    end
+  end
+
+  private
+    def raw_particulars
+      case particulars
+      when Hash
+        particulars
+      when String
+        JSON.parse(particulars) rescue {}
+      else
+        {}
+      end
+    end
+
+    def extract_particular(key)
+      key_s = key.to_s
+      key_sym = key.to_sym
+      nested = raw_particulars["particulars"] || raw_particulars[:particulars]
+      value = nested.is_a?(Hash) ? (nested[key_s] || nested[key_sym]) : nil
+      value || raw_particulars[key_s] || raw_particulars[key_sym]
+    end
+
+    def api_assignee_ids
+      ids = assignee_ids || extract_particular("assignee_ids") || []
+      Array(ids).map(&:to_s)
+    end
+
+    def api_old_board
+      (extract_particular("old_board") || extract_particular("old_collection")).to_s
+    end
+
+    def api_new_board
+      (extract_particular("new_board") || extract_particular("new_collection")).to_s
+    end
+
+    def api_old_title
+      extract_particular("old_title").to_s
+    end
+
+    def api_new_title
+      extract_particular("new_title").to_s
+    end
+
+    def api_column
+      extract_particular("column").to_s
+    end
 end
