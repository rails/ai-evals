+  test "supports pagination" do
+    # Create enough events to paginate
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    20.times do |i|
+      card.events.create!(
+        action: "card_published",
+        creator: users(:david),
+        board: board,
+        created_at: Time.current + i.minutes
