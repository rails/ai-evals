+    assert_equal event.eventable.title, payload["eventable"]["title"]
+    assert_equal event.eventable.number, payload["eventable"]["number"]
+    assert_equal card_url(event.eventable), payload["eventable"]["url"]
+  end
+
+  test "eventable representation for comment event" do
+    event = events(:layout_commented)
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert_equal "Comment", payload["eventable_type"]
+    assert_equal event.eventable.id, payload["eventable"]["id"]
+    assert_equal event.eventable.body.to_plain_text, payload["eventable"]["body"]["plain_text"]
+    assert_equal card_comment_url(event.card, event.eventable), payload["eventable"]["url"]
+  end
+end
