@@ -0,0 +1,54 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Event
+        .preloaded
+        .includes(creator: :identity, board: [ :creator, :publication ])
+        .where(board: boards)
+        .where(action: Event::ACTIVITIES_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      if creator_ids.present?
+        events = events.where(creator_id: creator_ids)
+      end
+
+      events
+    end
+
+    def boards
+      if board_ids.present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def creator_ids
+      extract_ids(params[:creator_ids] || params.dig(:filter, :creator_ids))
+    end
+
+    def board_ids
+      extract_ids(params[:board_ids] || params.dig(:filter, :board_ids))
+    end
+
+    def extract_ids(value)
+      case value
+      when Array
+        value.compact_blank
+      when ActionController::Parameters
+        value.values.compact_blank
+      when String
+        value.split(",").map(&:strip).compact_blank
+      else
+        []
+      end
+    end
+end
