+    assert_nil @response.parsed_body.find { |e| e["id"] == event.id }
+  end
+
+  test "includes card_title_changed events" do
+    card = cards(:logo)
+    event = card.events.create!(
+      action: "card_title_changed",
+      creator: users(:david),
+      board: card.board,
+      particulars: { particulars: { old_title: "Old", new_title: "New" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert @response.parsed_body.any? { |e| e["id"] == event.id }
+  end
+
+  test "orders activities newest first" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    created_ats = @response.parsed_body.map { |e| Time.iso8601(e["created_at"]) }
+    assert_equal created_ats, created_ats.sort.reverse
+  end
+
+  test "filters activities by board_ids" do
+    writebook = boards(:writebook)
+    other_board = boards(:private)
+
+    # Make sure both boards have events
+    writebook_event = events(:logo_published)
+    card = other_board.cards.create!(creator: users(:david), title: "Private card", status: :published)
+    other_event = card.events.create!(
+      action: "card_published",
+      creator: users(:david),
+      board: other_board
+    )
+
+    get activities_path(format: :json, board_ids: [ writebook.id ])
+    assert_response :success
+
+    returned_board_ids = @response.parsed_body.map { |e| e["board"]["id"] }.uniq
+    assert_equal [ writebook.id ], returned_board_ids
+    assert @response.parsed_body.any? { |e| e["id"] == writebook_event.id }
+    assert_not @response.parsed_body.any? { |e| e["id"] == other_event.id }
+  end
+
+  test "filters activities by board_ids as comma-separated string" do
+    writebook = boards(:writebook)
+    get activities_path(format: :json, board_ids: writebook.id)
+    assert_response :success
