+  end
+
+  test "particulars for triage events contains column" do
+    card = cards(:logo)
+    event = card.events.create!(
+      action: "card_triaged",
+      creator: users(:david),
+      board: card.board,
+      particulars: { particulars: { column: "Doing" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    payload = @response.parsed_body.find { |e| e["id"] == event.id }
+    assert payload.present?
+    assert_equal({ "column" => "Doing" }, payload["particulars"])
+  end
+
+  test "particulars for triage events returns empty string when column is missing" do
+    card = cards(:logo)
+    event = card.events.create!(
+      action: "card_triaged",
+      creator: users(:david),
+      board: card.board,
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
