diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..7e26902
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,26 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track_failure(at = Time.current)
+    self.first_failure_at ||= at
+    self.consecutive_failures_count += 1
+    save!
+
+    if delinquent?
+      webhook.deactivate
+    end
+  end
+
+  def track_success
+    reset if consecutive_failures_count > 0 || first_failure_at.present?
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def delinquent?
+    consecutive_failures_count >= 10 && first_failure_at.present? && first_failure_at <= 1.hour.ago
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..5ed423d 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -9,6 +9,69 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...1.week.ago) }
+
+  def self.cleanup
+    stale.delete_all
+  end
+
+  def deliver_later
+    DeliverJob.perform_later(self)
+  end
+
+  def deliver
+    return unless pending? && webhook.active?
+
+    Current.with_account(account) do
+      with_lock do
+        return unless pending? && webhook.active?
+        in_progress!
+      end
+
+      headers = nil
+
+      begin
+        payload = webhook.payload_for(event)
+        signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+        headers = {
+          "User-Agent" => "fizzy/1.0.0 Webhook",
+          "Content-Type" => "application/json",
+          "X-Webhook-Signature" => signature,
+          "X-Webhook-Timestamp" => (event.created_at || Time.current).utc.iso8601
+        }
+
+        uri = URI.parse(webhook.url)
+        http = Net::HTTP.new(uri.host, uri.port)
+        http.use_ssl = (uri.scheme == "https")
+        http.open_timeout = 5
+        http.read_timeout = 5
+
+        http_request = Net::HTTP::Post.new(uri.request_uri, headers)
+        http_request.body = payload
+
+        http_response = http.request(http_request)
+
+        update!(
+          state: :completed,
+          request: { headers: headers },
+          response: { code: http_response.code.to_i }
+        )
+      rescue StandardError => error
+        update!(
+          state: :errored,
+          request: headers ? { headers: headers } : nil,
+          response: { error: error.message }
+        )
+      ensure
+        if succeeded?
+          webhook.delinquency_tracker.track_success
+        elsif failed?
+          webhook.delinquency_tracker.track_failure
+        end
+      end
+    end
+  end
+  alias_method :deliver_now, :deliver
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
diff --git a/test/integration/webhooks_test.rb b/test/integration/webhooks_test.rb
new file mode 100644
index 0000000..ed100c4
--- /dev/null
+++ b/test/integration/webhooks_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class WebhookIntegrationTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @user = users(:david)
+    @webhook = webhooks(:active) # on writebook board, subscribed to card_published, card_assigned, card_closed
+    Current.user = @user
+  end
+
+  test "event creation triggers POST to subscribed webhook and logs the delivery" do
+    stub = stub_request(:post, @webhook.url)
+      .with { |request|
+        body = JSON.parse(request.body)
+        body["action"] == "card_closed" &&
+          request.headers["User-Agent"] == "fizzy/1.0.0 Webhook" &&
+          request.headers["Content-Type"] == "application/json" &&
+          request.headers["X-Webhook-Signature"].present? &&
+          request.headers["X-Webhook-Timestamp"].present?
+      }
+      .to_return(status: 200)
+
+    card = cards(:logo)
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: Webhook::Delivery::DeliverJob do
+        card.close
+      end
+    end
+
+    assert_requested stub, times: 1
+
+    delivery = @webhook.deliveries.ordered.first
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "card_closed", delivery.event.action
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig("headers", "User-Agent")
+    assert_equal "application/json", delivery.request.dig("headers", "Content-Type")
+  end
+
+  test "event does not trigger webhook if action is not subscribed" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    card = cards(:logo)
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: Webhook::Delivery::DeliverJob do
+        card.comments.create!(body: "A comment", creator: @user)
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "event does not trigger inactive webhook" do
+    @webhook.deactivate
+
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+    card = cards(:logo)
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: Webhook::Delivery::DeliverJob do
+        card.close
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "event does not trigger webhook on different board" do
+    other_board = boards(:private)
+    other_webhook = Webhook.create!(
+      board: other_board,
+      name: "Other Board Webhook",
+      url: "https://example.com/other",
+      subscribed_actions: [ "card_closed" ]
+    )
+
+    stub_other = stub_request(:post, other_webhook.url).to_return(status: 200)
+    stub_main = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    card = cards(:logo) # on writebook board
+
+    perform_enqueued_jobs only: Webhook::Delivery::DeliverJob do
+      card.close
+    end
+
+    assert_requested stub_main, times: 1
+    assert_not_requested stub_other
+  end
+
+  test "delivers exactly once even when job is re-run" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+    card = cards(:logo)
+
+    perform_enqueued_jobs only: Webhook::Delivery::DeliverJob do
+      card.close
+    end
+
+    assert_requested stub, times: 1
+
+    delivery = @webhook.deliveries.ordered.first
+    assert delivery.completed?
+
+    # Attempting to deliver the same delivery again
+    delivery.deliver
+    assert_requested stub, times: 1
+  end
+
+  test "receiver that keeps failing ten in a row over an hour gets switched off" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    # First failure
+    event1 = @board.events.create!(action: "card_closed", creator: @user, eventable: cards(:logo))
+    delivery1 = @webhook.deliveries.create!(event: event1)
+    delivery1.deliver
+
+    assert @webhook.reload.active?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+
+    # Failures 2 through 9 within the hour
+    2.upto(9) do |i|
+      event = @board.events.create!(action: "card_closed", creator: @user, eventable: cards(:logo))
+      delivery = @webhook.deliveries.create!(event: event)
+      delivery.deliver
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 9, @webhook.delinquency_tracker.consecutive_failures_count
+
+    # Travel over an hour since the first failure
+    travel 1.hour + 1.minute
+
+    # 10th failure
+    event10 = @board.events.create!(action: "card_closed", creator: @user, eventable: cards(:logo))
+    delivery10 = @webhook.deliveries.create!(event: event10)
+    delivery10.deliver
+
+    assert_not @webhook.reload.active?, "Receiver should get switched off after 10 consecutive failures over an hour"
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+    assert @webhook.delinquency_tracker.delinquent?
+  end
+
+  test "cleanup keeps a week of delivery log" do
+    assert_difference -> { Webhook::Delivery.count }, -2 do
+      Webhook::Delivery.cleanup
+    end
+
+    # Recent deliveries remain in the log
+    assert Webhook::Delivery.exists?(webhook_deliveries(:unsuccessfully_completed).id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:pending).id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:in_progress).id)
+  end
+end
