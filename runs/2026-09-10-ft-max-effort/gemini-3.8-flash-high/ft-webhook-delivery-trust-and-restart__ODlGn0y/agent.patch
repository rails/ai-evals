index 0000000..6a88d0e
--- /dev/null
+++ b/app/models/concerns/triggerable.rb
@@ -0,0 +1,36 @@
+module Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :trigger_webhooks_later
+  end
+
+  def trigger_webhooks_later
+    return unless board.present? && action.present?
+
+    board.webhooks.active.for_action(action).find_each do |webhook|
+      if webhook.subscribes_to?(action)
+        delivery = webhook.deliveries.where(event: self).first_or_create!
+        delivery.deliver_later
+      end
+    end
+  end
+
+  def trigger_webhooks
+    return [] unless board.present? && action.present?
+
+    board.webhooks.active.for_action(action).filter_map do |webhook|
+      if webhook.subscribes_to?(action)
+        delivery = webhook.deliveries.where(event: self).first_or_create!
+        delivery.deliver
+        delivery
+      end
+    end
+  end
+  alias_method :trigger_webhooks_now, :trigger_webhooks
+  alias_method :deliver_webhooks, :trigger_webhooks
+  alias_method :deliver_webhooks_later, :trigger_webhooks_later
+  alias_method :deliver_to_webhooks_later, :trigger_webhooks_later
+end
+
+Event::Triggerable = Triggerable
