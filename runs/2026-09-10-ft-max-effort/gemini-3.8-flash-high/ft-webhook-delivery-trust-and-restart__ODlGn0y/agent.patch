@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "auto-created with webhook" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+
+    assert webhook.delinquency_tracker.present?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+  end
+
+  test "track_failure records first failure time and increments count" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+    tracker = webhook.delinquency_tracker
+
+    freeze_time do
+      tracker.track_failure
+
+      assert_equal 1, tracker.consecutive_failures_count
+      assert_equal Time.current, tracker.first_failure_at
+
+      tracker.track_failure
+      assert_equal 2, tracker.consecutive_failures_count
+      assert_equal Time.current, tracker.first_failure_at
+    end
+  end
+
+  test "does not deactivate receiver if fewer than 10 failures" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+    tracker = webhook.delinquency_tracker
+
+    tracker.track_failure
+    travel 2.hours
+    8.times { tracker.track_failure }
+
+    assert_equal 9, tracker.consecutive_failures_count
+    assert webhook.reload.active?
+    assert_not tracker.delinquent?
+  end
+
+  test "does not deactivate receiver if 10 failures happen in less than an hour" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+    tracker = webhook.delinquency_tracker
+
+    10.times { tracker.track_failure }
+
+    assert_equal 10, tracker.consecutive_failures_count
+    assert webhook.reload.active?
+    assert_not tracker.delinquent?
+  end
+
+  test "deactivates receiver when 10 consecutive failures occur over an hour" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+    tracker = webhook.delinquency_tracker
+
+    tracker.track_failure
+    travel 1.hour + 1.minute
+    9.times { tracker.track_failure }
+
+    assert_equal 10, tracker.consecutive_failures_count
+    assert_not webhook.reload.active?
+    assert tracker.delinquent?
+  end
+
+  test "deactivates receiver when more than 10 consecutive failures occur over an hour" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+    tracker = webhook.delinquency_tracker
+
+    10.times { tracker.track_failure }
+    assert webhook.reload.active?
+
+    travel 1.hour + 1.minute
+    tracker.track_failure
+
+    assert_equal 11, tracker.consecutive_failures_count
+    assert_not webhook.reload.active?
+    assert tracker.delinquent?
+  end
+
+  test "track_success resets failure streak" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+    tracker = webhook.delinquency_tracker
+
+    tracker.track_failure
+    travel 1.hour + 1.minute
+    tracker.track_success
+
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+
+    9.times { tracker.track_failure }
+    assert webhook.reload.active?
+  end
+
+  test "webhook activation resets delinquency tracker" do
+    webhook = Webhook.create!(name: "Delinquency Test", url: "https://example.com/webhook", board: boards(:writebook))
+    tracker = webhook.delinquency_tracker
+
+    tracker.track_failure
+    travel 1.hour + 1.minute
+    9.times { tracker.track_failure }
+
+    assert_not webhook.reload.active?
+
+    webhook.activate
+
+    assert webhook.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+end
