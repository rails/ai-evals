@@ -0,0 +1,64 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "valid reaction" do
+    reaction = @comment.reactions.build(content: "👍")
+    assert reaction.valid?
+    assert_equal Current.user, reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "content presence" do
+    reaction = @comment.reactions.build(content: "")
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content maximum length 16 characters" do
+    reaction = @comment.reactions.build(content: "a" * 16)
+    assert reaction.valid?
+
+    reaction = @comment.reactions.build(content: "a" * 17)
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "content strips whitespace" do
+    reaction = @comment.reactions.create!(content: "  👍  ")
+    assert_equal "👍", reaction.content
+  end
+
+  test "touch comment on create and destroy" do
+    reaction = nil
+    assert_changes -> { @comment.reload.updated_at } do
+      reaction = @comment.reactions.create!(content: "🎉")
+    end
+
+    assert_changes -> { @comment.reload.updated_at } do
+      reaction.destroy
+    end
+  end
+
+  test "broadcasts refresh to card" do
+    ActiveJob::Base.queue_adapter = :test
+
+    @comment.reactions.create!(content: "🔥")
+    sleep 0.6
+    assert_includes ActiveJob::Base.queue_adapter.enqueued_jobs.map { _1[:job] }, Turbo::Streams::BroadcastStreamJob
+  end
+
+  test "emoji_only helper" do
+    assert ApplicationController.helpers.emoji_only?("👍")
+    assert ApplicationController.helpers.emoji_only?("🎉")
+    assert ApplicationController.helpers.emoji_only?("❤️")
+    assert ApplicationController.helpers.emoji_only?("👏🏼")
+    assert_not ApplicationController.helpers.emoji_only?("Awesome")
+    assert_not ApplicationController.helpers.emoji_only?("Great 👍")
+    assert_not ApplicationController.helpers.emoji_only?("123")
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..3a1e665
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,127 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding and removing reactions on a comment" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    reactions_dom = "##{dom_id(@comment, :reactions)}"
+
+    assert_selector reactions_dom
+
+    # Existing reactions
+    assert_selector "#{reactions_dom} .reaction", text: "👍"
+    assert_selector "#{reactions_dom} .reaction", text: "❤️"
+    assert_selector "#{reactions_dom} button[aria-label='Add reaction']"
+
+    # Click the add reaction trigger
+    find("#{reactions_dom} button[aria-label='Add reaction']").click
+
+    # Button is hidden, form is visible
+    assert_selector "#{reactions_dom} button[aria-label='Add reaction']", visible: false
+    assert_selector "#{reactions_dom} form.reaction__form", visible: true
+
+    # Cancel closes the form
+    find("#{reactions_dom} button[aria-label='Cancel']").click
+    assert_selector "#{reactions_dom} form.reaction__form", visible: false
+    assert_selector "#{reactions_dom} button[aria-label='Add reaction']", visible: true
+
+    # Open again and submit a new reaction
+    find("#{reactions_dom} button[aria-label='Add reaction']").click
+    within(reactions_dom) { fill_in "reaction[content]", with: "🚀" }
+    find("#{reactions_dom} button[aria-label='Confirm']").click
+
+    # Reaction is added to the strip, input is gone, button is back
+    assert_selector "#{reactions_dom} .reaction", text: "🚀"
+    assert_selector "#{reactions_dom} form.reaction__form", visible: false
+    assert_selector "#{reactions_dom} button[aria-label='Add reaction']", visible: true
+
+    # Clicking own reaction reveals a way to remove it
+    own_reaction = find("#{reactions_dom} .reaction", text: "🚀")
+    own_reaction.click
+
+    assert_selector "#{reactions_dom} button[aria-label='Remove reaction']", visible: true
+
+    # Click remove to delete the reaction
+    find("#{reactions_dom} button[aria-label='Remove reaction']").click
+
+    # The reaction is removed
+    assert_no_selector "#{reactions_dom} .reaction", text: "🚀"
+  end
+
+  test "confirming reaction with enter key" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    reactions_dom = "##{dom_id(@comment, :reactions)}"
+
+    find("#{reactions_dom} button[aria-label='Add reaction']").click
+    within(reactions_dom) { fill_in "reaction[content]", with: "🎉" }
+    send_keys :enter
+
+    assert_selector "#{reactions_dom} .reaction", text: "🎉"
+    assert_selector "#{reactions_dom} form.reaction__form", visible: false
+    assert_selector "#{reactions_dom} button[aria-label='Add reaction']", visible: true
+  end
+
+  test "canceling reaction with escape key" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    reactions_dom = "##{dom_id(@comment, :reactions)}"
+
+    find("#{reactions_dom} button[aria-label='Add reaction']").click
+    assert_selector "#{reactions_dom} form.reaction__form", visible: true
+
+    send_keys :escape
+
+    assert_selector "#{reactions_dom} form.reaction__form", visible: false
+    assert_selector "#{reactions_dom} button[aria-label='Add reaction']", visible: true
+  end
+
+  test "cannot remove another user's reaction" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    reactions_dom = "##{dom_id(@comment, :reactions)}"
+
+    # JZ's reaction
+    jz_reaction = find("#{reactions_dom} .reaction", text: "❤️")
+    jz_reaction.click
+
+    # No remove button revealed
+    assert_no_selector "#{reactions_dom} .reaction.expanded", text: "❤️"
+    assert_no_selector "#{reactions_dom} button[aria-label='Remove reaction']", visible: true
+  end
+
+  test "everyone looking at the card sees reactions land as they happen without reloading" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+
+    wait_for_cable_subscriptions
+
+    reactions_dom = "##{dom_id(@comment, :reactions)}"
+
+    assert_no_selector "#{reactions_dom} .reaction", text: "🔥"
+
+    # Kevin reacts elsewhere
+    @comment.reactions.create!(content: "🔥", reacter: users(:kevin))
+    sleep 0.6
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "#{reactions_dom} .reaction", text: "🔥", wait: 5
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
