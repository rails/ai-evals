diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..d066568
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,52 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.isOwnReaction) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("role", "button")
+    } else {
+      this.element.classList.remove("reaction--deleteable")
+      this.element.removeAttribute("tabindex")
+      this.element.removeAttribute("role")
+    }
+  }
+
+  toggle(event) {
+    if (!this.isOwnReaction) return
+    if (event.target.closest(".reaction__delete")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  remove(event) {
+    event.stopPropagation()
+    this.element.classList.add("reaction--deleting")
+  }
+
+  closeOnClickOutside(event) {
+    if (!this.element.contains(event.target)) {
+      this.element.classList.remove("expanded")
+    }
+  }
+
+  keydown(event) {
+    if (!this.isOwnReaction) return
+
+    if ((event.key === "Enter" || event.key === " ") && !event.target.closest(".reaction__delete")) {
+      event.preventDefault()
+      this.element.classList.toggle("expanded")
+    } else if (event.key === "Escape" && this.element.classList.contains("expanded")) {
+      event.preventDefault()
+      this.element.classList.remove("expanded")
+    }
+  }
+
+  get isOwnReaction() {
+    const currentUserId = document.querySelector('meta[name="current-user-id"]')?.content
+    return !!currentUserId && this.reacterIdValue === currentUserId
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..3409e3d
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  showForm() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  hideForm() {
+    this.inputTarget.value = ""
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  submitted(event) {
+    if (!event.detail.success) {
+      this.formTarget.classList.add("shake")
+      this.formTarget.addEventListener("animationend", () => {
+        this.formTarget.classList.remove("shake")
+      }, { once: true })
+    }
+  }
+
+  preventCloseOnMorphing(event) {
+    if (!this.formTarget.hidden && (event.detail?.attributeName === "hidden" || event.detail?.attributeName === "class")) {
+      event.preventDefault()
+    }
+  }
+}
