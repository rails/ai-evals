+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+
+    first_reaction = @response.parsed_body.first
+    assert first_reaction.key?("id")
+    assert first_reaction.key?("content")
+    assert first_reaction.key?("reacter")
+    assert first_reaction.key?("url")
+    assert_equal @comment.reactions.chronologically.first.id, first_reaction["id"]
+    assert_equal users(:kevin).id, first_reaction.dig("reacter", "id")
+  end
+
+  test "create as Turbo Stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "🎉" } },
+        as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: ActionView::RecordIdentifier.dom_id(@comment, :reactions)
+    assert_equal "🎉", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "Great 👍" } },
+        as: :json
+    end
+
+    assert_response :created
+    reaction = Reaction.last
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), @response.parsed_body["url"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { content: "🙌" },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "🙌", Reaction.last.content
+  end
+
+  test "create on draft card is forbidden" do
+    draft_card = boards(:writebook).cards.create!(status: :drafted, creator: users(:kevin))
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(draft_card, @comment),
+        params: { reaction: { content: "👍" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    get card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal reaction.content, @response.parsed_body["content"]
+    assert_equal reaction.reacter.id, @response.parsed_body.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), @response.parsed_body["url"]
+  end
+
+  test "destroy as Turbo Stream" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: ActionView::RecordIdentifier.dom_id(@comment, :reactions)
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_jz_heart) # created by jz
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
