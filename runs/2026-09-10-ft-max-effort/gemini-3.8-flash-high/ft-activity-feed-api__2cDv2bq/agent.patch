@@ -0,0 +1,482 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns activities with required structure" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+    assert activities.any?
+
+    activity = activities.first
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort,
+                 activity.keys.sort
+
+    # Validate board representation
+    assert_equal %w[ id name all_access created_at auto_postpone_period_in_days url creator ].sort,
+                 (activity["board"].keys & %w[ id name all_access created_at auto_postpone_period_in_days url creator ]).sort
+
+    # Validate creator representation
+    assert_equal %w[ id name role active email_address created_at url avatar_url ].sort,
+                 activity["creator"].keys.sort
+  end
+
+  test "index via direct path /:account_slug/activities.json" do
+    account = accounts("37s")
+    get "/#{account.external_account_id}/activities.json"
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+    assert activities.any?
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "index ordered newest first" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = @response.parsed_body
+    created_ats = activities.map { |a| Time.iso8601(a["created_at"]) }
+
+    assert_equal created_ats, created_ats.sort.reverse
+  end
+
+  test "card event url opens the card" do
+    card_event = events(:logo_published)
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == card_event.id }
+    assert_not_nil json_event
+    assert_equal card_url(card_event.eventable), json_event["url"]
+    assert_equal "Card", json_event["eventable_type"]
+    assert_equal card_event.eventable.title, json_event["eventable"]["title"]
+  end
+
+  test "comment event url opens the card and jumps to the comment" do
+    comment_event = events(:layout_commented)
+    comment = comment_event.eventable
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == comment_event.id }
+    assert_not_nil json_event
+
+    expected_url = card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment))
+    assert_equal expected_url, json_event["url"]
+    assert_equal "Comment", json_event["eventable_type"]
+    assert_equal comment.id, json_event["eventable"]["id"]
+  end
+
+  test "description is in plain-text form" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    event = events(:logo_published)
+    json_event = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_not_nil json_event
+    assert_equal event.description_for(users(:kevin)).to_plain_text, json_event["description"]
+  end
+
+  test "particulars for assignment changes contain assignee_ids" do
+    assignment_event = events(:logo_assignment_jz)
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == assignment_event.id }
+    assert_not_nil json_event
+    assert_equal [ users(:jz).id ], json_event["particulars"]["assignee_ids"]
+  end
+
+  test "particulars for unassignment changes contain assignee_ids" do
+    card = cards(:logo)
+    unassigned_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_unassigned",
+      particulars: { assignee_ids: [ users(:jz).id ] }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == unassigned_event.id }
+    assert_not_nil json_event
+    assert_equal [ users(:jz).id ], json_event["particulars"]["assignee_ids"]
+  end
+
+  test "particulars for assignment changes with empty assignee_ids" do
+    card = cards(:logo)
+    unassigned_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_unassigned",
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == unassigned_event.id }
+    assert_not_nil json_event
+    assert_equal [], json_event["particulars"]["assignee_ids"]
+  end
+
+  test "particulars for board changes contain old_board and new_board" do
+    card = cards(:logo)
+    board_change_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Old Board", new_board: "New Board" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == board_change_event.id }
+    assert_not_nil json_event
+    assert_equal({ "old_board" => "Old Board", "new_board" => "New Board" }, json_event["particulars"])
+  end
+
+  test "particulars for title changes contain old_title and new_title" do
+    card = cards(:logo)
+    title_change_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old Title", new_title: "New Title" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == title_change_event.id }
+    assert_not_nil json_event
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, json_event["particulars"])
+  end
+
+  test "particulars for triage events contain column" do
+    card = cards(:logo)
+    triage_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_triaged",
+      particulars: { particulars: { column: "In Progress" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_event = @response.parsed_body.find { |a| a["id"] == triage_event.id }
+    assert_not_nil json_event
+    assert_equal({ "column" => "In Progress" }, json_event["particulars"])
+  end
+
+  test "particulars for other events return empty object" do
+    card = cards(:logo)
+
+    other_actions = %w[
+      card_published
+      card_closed
+      card_reopened
+      card_postponed
+      card_auto_postponed
+      card_sent_back_to_triage
+      comment_created
+    ]
+
+    other_actions.each do |action|
+      eventable = action == "comment_created" ? comments(:layout_overflowing_david) : card
+      event = Event.create!(
+        board: boards(:writebook),
+        creator: users(:david),
+        eventable: eventable,
+        action: action,
+        particulars: { something: "extra" }
+      )
+
+      get activities_path(format: :json)
+      assert_response :success
+
+      json_event = @response.parsed_body.find { |a| a["id"] == event.id }
+      assert_not_nil json_event, "Event for #{action} should be found"
+      assert_equal({}, json_event["particulars"], "Particulars for #{action} should be empty object")
+    end
+  end
+
+  test "missing board, title, or column values are returned as empty strings" do
+    card = cards(:logo)
+
+    board_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_board_changed",
+      particulars: {}
+    )
+    title_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: {}
+    )
+    triage_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_triaged",
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_board = @response.parsed_body.find { |a| a["id"] == board_event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, json_board["particulars"])
+
+    json_title = @response.parsed_body.find { |a| a["id"] == title_event.id }
+    assert_equal({ "old_title" => "", "new_title" => "" }, json_title["particulars"])
+
+    json_triage = @response.parsed_body.find { |a| a["id"] == triage_event.id }
+    assert_equal({ "column" => "" }, json_triage["particulars"])
+  end
+
+  test "partially missing board values return empty strings for missing ones" do
+    card = cards(:logo)
+
+    board_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_board_changed",
+      particulars: { particulars: { new_board: "New Board" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_board = @response.parsed_body.find { |a| a["id"] == board_event.id }
+    assert_equal({ "old_board" => "", "new_board" => "New Board" }, json_board["particulars"])
+  end
+
+  test "partially missing title values return empty strings for missing ones" do
+    card = cards(:logo)
+
+    title_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old Title" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    json_title = @response.parsed_body.find { |a| a["id"] == title_event.id }
+    assert_equal({ "old_title" => "Old Title", "new_title" => "" }, json_title["particulars"])
+  end
+
+  test "omits deprecated card_collection_changed events" do
+    card = cards(:logo)
+    deprecated_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_collection_changed",
+      particulars: { particulars: { new_collection: "Some Collection" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    ids = @response.parsed_body.pluck("id")
+    assert_not_includes ids, deprecated_event.id
+  end
+
+  test "includes card_title_changed events" do
+    card = cards(:logo)
+    title_event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old", new_title: "New" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, title_event.id
+  end
+
+  test "filters activity by creator_ids array" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert activities.any?
+    assert activities.all? { |a| a["creator"]["id"] == users(:david).id }
+  end
+
+  test "filters activity by creator_ids single string" do
+    get activities_path(format: :json), params: { creator_ids: users(:david).id }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert activities.any?
+    assert activities.all? { |a| a["creator"]["id"] == users(:david).id }
+  end
+
+  test "filters activity by multiple creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id, users(:kevin).id ] }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert activities.any?
+    allowed_ids = [ users(:david).id, users(:kevin).id ]
+    assert activities.all? { |a| allowed_ids.include?(a["creator"]["id"]) }
