+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "particulars_for_api returns assignee_ids for card_assigned" do
+    event = Event.new(
+      action: "card_assigned",
+      particulars: { assignee_ids: [ "user_1", "user_2" ] }
+    )
+
+    assert_equal({ "assignee_ids" => [ "user_1", "user_2" ] }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api returns assignee_ids for card_unassigned" do
+    event = Event.new(
+      action: "card_unassigned",
+      particulars: { assignee_ids: [ "user_1" ] }
+    )
+
+    assert_equal({ "assignee_ids" => [ "user_1" ] }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api handles nested particulars for assignment" do
+    event = Event.new(
+      action: "card_assigned",
+      particulars: { "particulars" => { "assignee_ids" => [ "user_1" ] } }
+    )
+
+    assert_equal({ "assignee_ids" => [ "user_1" ] }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api handles missing assignee_ids as empty array" do
+    event = Event.new(action: "card_assigned", particulars: {})
+    assert_equal({ "assignee_ids" => [] }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api returns old_board and new_board for card_board_changed" do
+    event = Event.new(
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Old", new_board: "New" } }
+    )
+
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api handles flat particulars for board changes" do
+    event = Event.new(
+      action: "card_board_changed",
+      particulars: { old_board: "Old", new_board: "New" }
+    )
+
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api returns empty strings for missing board values" do
+    event = Event.new(action: "card_board_changed", particulars: {})
+    assert_equal({ "old_board" => "", "new_board" => "" }, event.particulars_for_api)
+
+    event_with_nil = Event.new(
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: nil, new_board: "New" } }
+    )
+    assert_equal({ "old_board" => "", "new_board" => "New" }, event_with_nil.particulars_for_api)
+  end
+
+  test "particulars_for_api returns old_title and new_title for card_title_changed" do
+    event = Event.new(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old Title", new_title: "New Title" } }
+    )
+
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api returns empty strings for missing title values" do
+    event = Event.new(action: "card_title_changed", particulars: {})
+    assert_equal({ "old_title" => "", "new_title" => "" }, event.particulars_for_api)
+
+    event_with_nil = Event.new(
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old", new_title: nil } }
+    )
+    assert_equal({ "old_title" => "Old", "new_title" => "" }, event_with_nil.particulars_for_api)
+  end
+
+  test "particulars_for_api returns column for card_triaged" do
+    event = Event.new(
+      action: "card_triaged",
+      particulars: { particulars: { column: "Doing" } }
+    )
+
+    assert_equal({ "column" => "Doing" }, event.particulars_for_api)
+  end
+
+  test "particulars_for_api returns empty string for missing column" do
+    event = Event.new(action: "card_triaged", particulars: {})
+    assert_equal({ "column" => "" }, event.particulars_for_api)
+
+    event_with_nil = Event.new(
+      action: "card_triaged",
+      particulars: { particulars: { column: nil } }
+    )
+    assert_equal({ "column" => "" }, event_with_nil.particulars_for_api)
+  end
+
+  test "particulars_for_api returns empty object for other events" do
