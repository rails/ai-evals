@@ -0,0 +1,34 @@
+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events
+
+      if filtered_board_ids.present?
+        events = events.where(board_id: filtered_board_ids)
+      end
+
+      if filtered_creator_ids.present?
+        events = events.where(creator_id: filtered_creator_ids)
+      end
+
+      events.where(action: Event::ACTIVITY_ACTIONS)
+            .preloaded
+            .order(created_at: :desc, id: :desc)
+    end
+
+    def filtered_board_ids
+      Array(params[:board_ids]).compact_blank.presence
+    end
+
+    def filtered_creator_ids
+      Array(params[:creator_ids]).compact_blank.presence
+    end
+end
