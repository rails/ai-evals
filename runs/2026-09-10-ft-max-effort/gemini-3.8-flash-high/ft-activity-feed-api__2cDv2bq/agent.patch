+
+  test "filters activity by board_ids array" do
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert activities.any?
+    assert activities.all? { |a| a["board"]["id"] == boards(:writebook).id }
+  end
+
+  test "filters activity by board_ids single string" do
+    get activities_path(format: :json), params: { board_ids: boards(:writebook).id }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert activities.any?
+    assert activities.all? { |a| a["board"]["id"] == boards(:writebook).id }
+  end
+
+  test "filters activity by creator_ids and board_ids combined" do
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:david).id ],
+      board_ids: [ boards(:writebook).id ]
+    }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert activities.any?
+    assert activities.all? { |a| a["creator"]["id"] == users(:david).id && a["board"]["id"] == boards(:writebook).id }
+  end
+
+  test "empty creator_ids or board_ids params are ignored" do
+    get activities_path(format: :json), params: { creator_ids: [ "" ], board_ids: [ "" ] }
+    assert_response :success
+
+    all_activities = @response.parsed_body
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_equal @response.parsed_body.size, all_activities.size
+  end
+
+  test "only returns activity the current user can access" do
+    secret_board = Board.create!(
+      name: "Secret Board",
+      account: accounts("37s"),
+      creator: users(:david),
+      all_access: false
+    )
+    Current.set(user: users(:david)) do
+      secret_board.cards.create!(
+        title: "Secret Card",
+        creator: users(:david),
+        status: "published"
+      )
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    board_ids = @response.parsed_body.map { |a| a["board"]["id"] }
+    assert_not_includes board_ids, secret_board.id
+
+    # Filtering by the inaccessible board should return empty
+    get activities_path(format: :json), params: { board_ids: [ secret_board.id ] }
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "pagination follows existing API conventions" do
+    card = cards(:logo)
+    20.times do |i|
+      Event.create!(
+        board: boards(:writebook),
+        creator: users(:david),
+        eventable: card,
+        action: "card_published",
+        created_at: Time.current + i.seconds
+      )
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_not_nil @response.headers["Link"], "Link header should be present when there are multiple pages"
+    assert_match(/rel="next"/, @response.headers["Link"])
+    assert_equal 15, @response.parsed_body.size
+
+    # Fetch page 2
+    get activities_path(format: :json), params: { page: 2 }
+    assert_response :success
+    assert @response.parsed_body.size > 0
+  end
+
+  test "authenticates with personal access token" do
+    sign_out
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+    assert_response :success
+  end
+
+  test "fails to authenticate with invalid access token" do
+    sign_out
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer invalid_token" }
+    assert_response :unauthorized
+  end
+
+  test "caching works with actionview partial caching" do
+    with_actionview_partial_caching do
+      get activities_path(format: :json)
+      assert_response :success
+      first_response = @response.parsed_body
+
+      get activities_path(format: :json)
+      assert_response :success
+      assert_equal first_response, @response.parsed_body
+    end
+  end
+end
