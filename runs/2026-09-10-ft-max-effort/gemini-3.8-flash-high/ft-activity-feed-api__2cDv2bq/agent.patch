diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..73d4d3e 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,30 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def particulars_for_api
+    data = particulars
+    data = JSON.parse(data) if data.is_a?(String)
+    data = (data || {}).with_indifferent_access
+    nested = (data[:particulars].is_a?(Hash) ? data[:particulars] : {}).with_indifferent_access
+
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      ids = nested[:assignee_ids] || data[:assignee_ids] || try(:assignee_ids) || []
+      { "assignee_ids" => Array(ids).map(&:to_s) }
+    when "card_board_changed", "card_collection_changed"
+      old_board = nested[:old_board] || data[:old_board] || nested[:old_collection] || data[:old_collection]
+      new_board = nested[:new_board] || data[:new_board] || nested[:new_collection] || data[:new_collection]
+      { "old_board" => old_board.to_s, "new_board" => new_board.to_s }
+    when "card_title_changed"
+      old_title = nested[:old_title] || data[:old_title]
+      new_title = nested[:new_title] || data[:new_title]
+      { "old_title" => old_title.to_s, "new_title" => new_title.to_s }
+    when "card_triaged"
+      column = nested[:column] || data[:column]
+      { "column" => column.to_s }
+    else
+      {}
+    end
+  end
 end
