diff --git a/test/models/multi_tenant_rollout_test.rb b/test/models/multi_tenant_rollout_test.rb
new file mode 100644
index 0000000..0c69ba6
--- /dev/null
+++ b/test/models/multi_tenant_rollout_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+require_relative "../../db/migrate/20260710000000_finish_multi_tenant_rollout"
+
+class MultiTenantRolloutTest < ActiveSupport::TestCase
+  ACCOUNT_DATA_TABLES = %i[
+    accesses
+    account_cancellations
+    account_imports
+    account_join_codes
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignments
+    board_publications
+    boards
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    cards
+    closures
+    columns
+    comments
+    entropies
+    events
+    exports
+    filters
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    search_records
+    steps
+    storage_entries
+    taggings
+    tags
+    user_settings
+    users
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    webhooks
+  ].freeze
+
+  test "every account data table has account_id column which is required and indexed" do
+    conn = ActiveRecord::Base.connection
+
+    ACCOUNT_DATA_TABLES.each do |table|
+      col = conn.columns(table).find { |c| c.name == "account_id" }
+      assert_not_nil col, "Expected #{table} to have an account_id column"
+      assert_equal false, col.null, "Expected #{table}.account_id to be required (null: false)"
+
+      indexes = conn.indexes(table)
+      has_acc_index = indexes.any? { |idx| idx.columns.include?("account_id") }
+      assert has_acc_index, "Expected #{table} to have an index on account_id"
+    end
+  end
+
+  test "orphaned rows are dropped by migration" do
+    migration = FinishMultiTenantRollout.new
+
+    fake_account_id = ActiveRecord::Type::Uuid.generate
+    user = users(:david)
+
+    ActiveRecord::Base.connection.execute(<<~SQL)
+      INSERT INTO user_settings (id, user_id, bundle_email_frequency, created_at, updated_at, account_id)
+      VALUES ('#{ActiveRecord::Type::Uuid.generate}', '#{user.id}', 0, datetime('now'), datetime('now'), '#{fake_account_id}')
+    SQL
+
+    assert ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM user_settings WHERE account_id = '#{fake_account_id}'") > 0
+
+    migration.send(:drop_orphaned_rows)
+
+    assert_equal 0, ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM user_settings WHERE account_id = '#{fake_account_id}'")
+  end
+end
