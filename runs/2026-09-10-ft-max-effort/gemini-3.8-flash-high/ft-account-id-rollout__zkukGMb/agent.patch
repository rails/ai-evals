+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (SELECT active_storage_blobs.account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id)
+        WHERE account_id IS NULL
+      SQL
+
+      execute <<~SQL
+        UPDATE active_storage_attachments
+        SET account_id = (SELECT active_storage_variant_records.account_id FROM active_storage_variant_records WHERE active_storage_variant_records.id = active_storage_attachments.record_id)
+        WHERE account_id IS NULL AND record_type = 'ActiveStorage::VariantRecord'
+      SQL
+
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def drop_orphaned_rows
+      ALL_ACCOUNT_DATA_TABLES.each do |table|
+        execute <<~SQL
+          DELETE FROM #{table}
+          WHERE account_id IS NULL OR account_id NOT IN (SELECT id FROM accounts)
+        SQL
+      end
+
+      execute <<~SQL
+        DELETE FROM active_storage_attachments
+        WHERE blob_id NOT IN (SELECT id FROM active_storage_blobs)
+      SQL
+
+      execute <<~SQL
+        DELETE FROM active_storage_variant_records
+        WHERE blob_id NOT IN (SELECT id FROM active_storage_blobs)
+      SQL
+    end
+end
