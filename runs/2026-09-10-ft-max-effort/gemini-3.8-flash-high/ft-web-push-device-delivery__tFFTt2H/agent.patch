@@ -0,0 +1,137 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "validates required attributes" do
+    sub = Push::Subscription.new
+    assert_not sub.valid?
+    assert_includes sub.errors[:endpoint], "can't be blank"
+    assert_includes sub.errors[:p256dh_key], "can't be blank"
+    assert_includes sub.errors[:auth_key], "can't be blank"
+  end
+
+  test "validates uniqueness of endpoint scoped to user" do
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/unique",
+      p256dh_key: "key1",
+      auth_key: "auth1"
+    )
+
+    duplicate = @user.push_subscriptions.build(
+      endpoint: "https://push.example.com/unique",
+      p256dh_key: "key2",
+      auth_key: "auth2"
+    )
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:endpoint], "has already been taken"
+  end
+
+  test "configured? returns true when both VAPID keys are present" do
+    with_env("VAPID_PUBLIC_KEY" => "pubkey", "VAPID_PRIVATE_KEY" => "privkey") do
+      assert Push::Subscription.configured?
+      assert_equal "pubkey", Push::Subscription.vapid_public_key
+      assert_equal "privkey", Push::Subscription.vapid_private_key
+    end
+  end
+
+  test "configured? returns false when either VAPID key is missing" do
+    with_env("VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => "privkey") do
+      assert_not Push::Subscription.configured?
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => "pubkey", "VAPID_PRIVATE_KEY" => nil) do
+      assert_not Push::Subscription.configured?
+    end
+  end
+
+  test "push does nothing when unconfigured" do
+    with_env("VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil) do
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "https://push.example.com/sub",
+        p256dh_key: "key",
+        auth_key: "auth"
+      )
+
+      WebPush.expects(:payload_send).never
+      subscription.push(@notification)
+    end
+  end
+
+  test "push delivers web push with notification title, body, and card url" do
+    with_env("VAPID_PUBLIC_KEY" => "pubkey", "VAPID_PRIVATE_KEY" => "privkey") do
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "https://push.example.com/sub",
+        p256dh_key: "key",
+        auth_key: "auth"
+      )
+
+      expected_url = Rails.application.routes.url_helpers.card_path(
+        @notification.card,
+        script_name: @notification.account.slug
+      )
+
+      WebPush.expects(:payload_send).with do |params|
+        data = JSON.parse(params[:message])
+        data["title"] == @notification.title &&
+          data["body"] == @notification.body &&
+          data["url"] == expected_url &&
+          params[:endpoint] == subscription.endpoint &&
+          params[:p256dh] == subscription.p256dh_key &&
+          params[:auth] == subscription.auth_key &&
+          params[:vapid][:public_key] == "pubkey" &&
+          params[:vapid][:private_key] == "privkey"
+      end
+
+      subscription.push(@notification)
+    end
+  end
+
+  test "push destroys subscription on ExpiredSubscription" do
+    with_env("VAPID_PUBLIC_KEY" => "pubkey", "VAPID_PRIVATE_KEY" => "privkey") do
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "https://push.example.com/expired",
+        p256dh_key: "key",
+        auth_key: "auth"
+      )
+
+      fake_response = Net::HTTPGone.new("1.1", "410", "Gone")
+      fake_response.stubs(:body).returns("")
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(fake_response, "push.example.com"))
+
+      subscription.push(@notification)
+
+      assert_not Push::Subscription.exists?(id: subscription.id)
+    end
+  end
+
+  test "push destroys subscription on InvalidSubscription" do
+    with_env("VAPID_PUBLIC_KEY" => "pubkey", "VAPID_PRIVATE_KEY" => "privkey") do
+      subscription = @user.push_subscriptions.create!(
+        endpoint: "https://push.example.com/invalid",
+        p256dh_key: "key",
+        auth_key: "auth"
+      )
+
+      fake_response = Net::HTTPNotFound.new("1.1", "404", "Not Found")
+      fake_response.stubs(:body).returns("")
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(fake_response, "push.example.com"))
+
+      subscription.push(@notification)
+
+      assert_not Push::Subscription.exists?(id: subscription.id)
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
