+    phone = kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/phone",
+      p256dh_key: "phone_key",
+      auth_key: "phone_auth"
+    )
+
+    delivered_endpoints = []
+    Push::Subscription.any_instance.stubs(:push).with do |notif|
+      delivered_endpoints << notif
+      true
+    end
+
+    notification.push_now
+    assert_equal 2, delivered_endpoints.size
+  end
 end
