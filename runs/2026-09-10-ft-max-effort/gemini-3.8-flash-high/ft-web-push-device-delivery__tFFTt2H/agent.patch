diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..fdbc80d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,159 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "status", "details", "explainer" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  async connect() {
+    if (!("Notification" in window) || !("serviceWorker" in navigator)) {
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.showDetails()
+      this.element.classList.remove("notifications--on")
+      return
+    }
+
+    this.hideDetails()
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        this.element.classList.add("notifications--on")
+      } else {
+        this.element.classList.remove("notifications--on")
+      }
+    } catch (error) {
+      console.warn("Could not check push subscription:", error)
+    }
+  }
+
+  async subscribe() {
+    if (!("Notification" in window) || !("serviceWorker" in navigator)) {
+      return
+    }
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "denied") {
+        this.showDetails()
+        this.element.classList.remove("notifications--on")
+        return
+      }
+
+      if (permission !== "granted") {
+        return
+      }
+
+      this.hideDetails()
+
+      const registration = await navigator.serviceWorker.ready
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (!subscription) {
+        const options = { userVisibleOnly: true }
+        if (this.hasVapidPublicKeyValue && this.vapidPublicKeyValue) {
+          options.applicationServerKey = this.urlBase64ToUint8Array(this.vapidPublicKeyValue)
+        }
+        subscription = await registration.pushManager.subscribe(options)
+      }
+
+      await this.recordSubscription(subscription)
+      this.element.classList.add("notifications--on")
+    } catch (error) {
+      console.error("Failed to subscribe to notifications:", error)
+    }
+  }
+
+  async unsubscribe() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.deleteSubscription(subscription)
+        await subscription.unsubscribe()
+      }
+    } catch (error) {
+      console.error("Failed to unsubscribe:", error)
+    } finally {
+      this.element.classList.remove("notifications--on")
+    }
+  }
+
+  async recordSubscription(subscription) {
+    const json = subscription.toJSON()
+    const p256dhKey = json.keys?.p256dh || this.arrayBufferToBase64(subscription.getKey?.("p256dh"))
+    const authKey = json.keys?.auth || this.arrayBufferToBase64(subscription.getKey?.("auth"))
+
+    await post(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: p256dhKey,
+          auth_key: authKey
+        }
+      }
+    })
+  }
+
+  async deleteSubscription(subscription) {
+    await destroy(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint
+        }
+      },
+      query: {
+        endpoint: subscription.endpoint
+      }
+    })
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = true
+    }
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = false
+    }
+  }
+
+  urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding)
+      .replace(/-/g, "+")
+      .replace(/_/g, "/")
+
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+    return outputArray
+  }
+
+  arrayBufferToBase64(buffer) {
+    if (!buffer) return ""
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    for (let i = 0; i < bytes.byteLength; i++) {
+      binary += String.fromCharCode(bytes[i])
+    }
+    return window.btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+}
