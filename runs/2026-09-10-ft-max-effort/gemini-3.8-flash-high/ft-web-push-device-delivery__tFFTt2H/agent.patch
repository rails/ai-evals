+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "test-p256dh-key",
+          auth_key: "test-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/sub/123", subscription.endpoint
+    assert_equal "test-p256dh-key", subscription.p256dh_key
+    assert_equal "test-auth-key", subscription.auth_key
+  end
+
+  test "create updates existing subscription with same endpoint" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: "old-key",
+      auth_key: "old-auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/123",
+          p256dh_key: "new-key",
+          auth_key: "new-auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-key", existing.reload.p256dh_key
+    assert_equal "new-auth", existing.auth_key
+  end
+
+  test "create is forbidden for another user" do
+    other_user = users(:kevin)
+
+    post user_push_subscriptions_path(other_user), params: {
+      push_subscription: {
+        endpoint: "https://push.example.com/sub/123",
+        p256dh_key: "key",
+        auth_key: "auth"
+      }
+    }, as: :json
+
+    assert_response :forbidden
+  end
+
+  test "destroy by endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint
+        }
+      }, as: :json
+    end
+
+    assert_response :no_content
+    assert_not Push::Subscription.exists?(id: subscription.id)
+  end
+
+  test "destroy by id" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+    assert_not Push::Subscription.exists?(id: subscription.id)
+  end
+
+  test "destroy is forbidden for another user" do
+    other_user = users(:kevin)
+    subscription = other_user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/456",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    delete user_push_subscription_path(other_user, subscription), as: :json
+    assert_response :forbidden
+  end
+  test "create push subscription via form parameters" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/form_test",
+          p256dh_key: "form-p256dh-key",
+          auth_key: "form-auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/sub/form_test", subscription.endpoint
+    assert_equal "form-p256dh-key", subscription.p256dh_key
+    assert_equal "form-auth-key", subscription.auth_key
+  end
+end
