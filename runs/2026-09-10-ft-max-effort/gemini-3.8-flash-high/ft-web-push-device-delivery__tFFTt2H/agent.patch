+
+    # Add a push subscription for Kevin
+    sub = kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/kevin",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    # New comment event on the same card
+    comment = card.comments.create!(creator: david, body: "Another comment on this card")
+    event = Event.create!(account: card.account, board: card.board, creator: david, action: "comment_created", eventable: comment)
+
+    Push::Subscription.any_instance.expects(:push)
+
+    perform_enqueued_jobs do
+      Notifier.for(event).notify
+    end
