new file mode 100644
index 0000000..61bed9e
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,59 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user&.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  class << self
+    def vapid_public_key
+      (ENV["VAPID_PUBLIC_KEY"].presence || Rails.application.credentials.vapid_public_key).to_s.strip.presence
+    end
+
+    def vapid_private_key
+      (ENV["VAPID_PRIVATE_KEY"].presence || Rails.application.credentials.vapid_private_key).to_s.strip.presence
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+  end
+
+  def push(notification)
+    return unless self.class.configured?
+
+    WebPush.payload_send(
+      message: message_for(notification),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Unauthorized => error
+    Rails.logger.error("WebPush unauthorized for subscription #{id}: #{error.message}")
+  rescue => error
+    Rails.logger.error("WebPush delivery failed for subscription #{id}: #{error.message}")
+  end
+
+  private
+    def message_for(notification)
+      {
+        title: notification.title,
+        body: notification.body,
+        url: Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug),
+        card_id: notification.card_id
+      }.to_json
+    end
+
+    def vapid_options
+      {
+        subject: ENV["VAPID_SUBJECT"].presence || "mailto:admin@example.com",
+        public_key: self.class.vapid_public_key,
+        private_key: self.class.vapid_private_key
+      }
+    end
+end
+
+PushSubscription = Push::Subscription
