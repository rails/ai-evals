+  test "push_now skips when user is inactive" do
+    kevin = users(:kevin)
+    kevin.update_column(:active, false)
+    notification = notifications(:logo_assignment_kevin)
+    kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/test",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
