diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..f2af0c7 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,56 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  if (!event.data) return
+
+  let payload = {}
+  try {
+    payload = event.data.json()
+  } catch (e) {
+    payload = { title: "Fizzy", body: event.data.text() }
+  }
+
+  const title = payload.title || "Fizzy"
+  const options = {
+    body: payload.body,
+    icon: payload.icon || "/app-icon-192.png",
+    badge: payload.badge || "/app-icon-192.png",
+    tag: payload.tag || (payload.card_id ? `card-${payload.card_id}` : undefined),
+    data: {
+      url: payload.url
+    }
+  }
+
+  event.waitUntil(self.registration.showNotification(title, options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const targetUrl = event.notification.data?.url
+  if (!targetUrl) return
+
+  event.waitUntil(
+    clients.matchAll({ type: "window", includeUncontrolled: true }).then((clientList) => {
+      const urlToOpen = new URL(targetUrl, self.location.origin).href
+
+      for (const client of clientList) {
+        if (client.url === urlToOpen && "focus" in client) {
+          return client.focus()
+        }
+      }
+
+      for (const client of clientList) {
+        if ("navigate" in client && "focus" in client) {
+          return client.navigate(urlToOpen).then((c) => c?.focus())
+        }
+      }
+
+      if (clients.openWindow) {
+        return clients.openWindow(urlToOpen)
+      }
+    })
+  )
+})
