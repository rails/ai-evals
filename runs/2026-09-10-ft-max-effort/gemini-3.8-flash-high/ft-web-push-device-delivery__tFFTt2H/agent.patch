--- /dev/null
+++ b/test/integration/push_notifications_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class PushNotificationsTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "complete push notification lifecycle: subscribe, notify, and unsubscribe" do
+    with_env("VAPID_PUBLIC_KEY" => "test_public_key", "VAPID_PRIVATE_KEY" => "test_private_key") do
+      # 1. User views notification settings
+      get notifications_settings_path
+      assert_response :success
+      assert_select "[data-controller~=notifications]"
+      assert_select ".notifications__on-message"
+      assert_select ".notifications__off-message"
+
+      # 2. Browser subscribes and posts to /users/:user_id/push_subscriptions
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/user_1",
+          p256dh_key: "p256dh_test_key",
+          auth_key: "auth_test_key"
+        }
+      }, as: :json
+      assert_response :created
+
+      subscription = @user.push_subscriptions.find_by(endpoint: "https://push.example.com/sub/user_1")
+      assert_not_nil subscription
+
+      # 3. Notification is created (e.g. David is assigned to a card or mentioned)
+      card = cards(:layout)
+      event = events(:layout_commented)
+
+      # Expect WebPush to be sent when notification job runs
+      expected_card_url = Rails.application.routes.url_helpers.card_path(card, script_name: @user.account.slug)
+
+      notification = nil
+      WebPush.expects(:payload_send).with do |params|
+        payload = JSON.parse(params[:message])
+        payload["title"] == "RE: Layout is broken" &&
+          payload["body"] == "The text is overflowing the container." &&
+          payload["url"] == expected_card_url &&
+          params[:endpoint] == subscription.endpoint &&
+          params[:p256dh] == subscription.p256dh_key &&
+          params[:auth] == subscription.auth_key
+      end
+
+      perform_enqueued_jobs do
+        # Destroy any existing notification for this card to simulate clean notification landing in tray
+        @user.notifications.where(card: card).destroy_all
+        notification = Notification.create!(
+          user: @user,
+          source: event,
+          creator: users(:kevin)
+        )
+      end
+
+      assert_equal "RE: Layout is broken", notification.title
+      assert_equal "The text is overflowing the container.", notification.body
+
+      # 4. Browser unsubscribes
+      delete user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint
+        }
+      }, as: :json
+      assert_response :no_content
+
+      assert_not Push::Subscription.exists?(id: subscription.id)
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
