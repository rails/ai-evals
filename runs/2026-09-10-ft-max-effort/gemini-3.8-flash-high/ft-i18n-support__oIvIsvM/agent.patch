+<% @page_title = "個人用アクセストークン" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "マイプロフィール", user_path(Current.user), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center webhooks">
+  <% if @access_tokens.any? %>
+    <p class="margin-none-block-start">Fizzy APIへのアクセスに使用できる生成済みトークンです。</p>
+    <table class="access-tokens margin-block-end-double max-width txt-small">
+      <thead>
+        <tr>
+          <th>説明</th>
+          <th>権限</th>
+          <th>作成日</th>
+          <th></th>
+        </tr>
+      </thead>
+      <tbody>
+        <%= render partial: "my/access_tokens/access_token", collection: @access_tokens %>
+      </tbody>
+    </table>
+  <% else %>
+    <p class="margin-none-block-start">個人用アクセストークンは、Fizzy開発者APIへのアクセスのためのパスワードのように使用できます。必要なだけトークンを作成でき、いつでもアクセスを取り消すことができます。</p>
+  <% end %>
+
+  <%= link_to new_my_access_token_path, class: "btn btn--link" do %>
+    <%= icon_tag "add" %>
+    <span>新しいアクセストークンを生成</span>
+  <% end %>
+</section>
diff --git a/app/views/my/access_tokens/new.ja.html.erb b/app/views/my/access_tokens/new.ja.html.erb
