+        <% else %>
+          <%= @join_code.usage_count %>/<%= @join_code.usage_limit %> 回使用済み
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="flex gap-half margin-block-start" data-controller="clipboard" data-clipboard-success-content-value="コピーしました！">
+    <input type="hidden" value="<%= join_code_url(code: @join_code.code, script_name: nil) %>" data-clipboard-target="source">
+    <button class="btn btn--link flex-item-grow" data-action="clipboard#copy" data-clipboard-target="button">リンクをコピー</button>
+    <%= link_to "完了", account_settings_path, class: "btn" %>
+  </div>
+</article>
