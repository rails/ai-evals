diff --git a/app/views/notifications/settings/_browser.ja.html.erb b/app/views/notifications/settings/_browser.ja.html.erb
new file mode 100644
index 0000000..47d8510
--- /dev/null
+++ b/app/views/notifications/settings/_browser.ja.html.erb
@@ -0,0 +1,109 @@
+<% unless (platform.safari? || platform.chrome?) && platform.ios? %>
+  <div class="notifications-help" data-notifications-target="details">
+    <% case
+      when platform.firefox? && platform.android? %>
+        <h3><%= platform.browser.capitalize %> の通知を有効にする</h3>
+        <ol>
+          <li>アドレスバーの <em><%= icon_tag "lock", alt: "サイト情報ボタン" %></em> をタップします。</li>
+          <li><em>通知</em> をタップして <em>許可</em> に変更します。</li>
+        </ol>
+      <% when platform.edge? && platform.desktop? %>
+        <h3>このウェブサイトの通知を有効にする</h3>
+        <ol>
+          <li>アドレスバー左側の <em><%= icon_tag "lock", alt: "サイト情報ボタン" %></em> をクリックします。</li>
+          <li><em>このサイトの権限 &gt; 通知</em> で <em>許可</em> を選択します。</li>
+        </ol>
+        <h3><%= platform.browser.capitalize %> の通知を有効にする</h3>
+        <ol>
+          <% if platform.windows? %>
+            <li><em>スタート</em> をクリックし、<em>設定</em> をクリックします。</li>
+            <li><em>システム &gt; 通知</em> に移動します。</li>
+            <li><%= platform.browser.capitalize %> の <em><%= icon_tag "switch", alt: "スイッチ" %></em> を <em>ON</em> にします。</li>
+          <% else %>
+            <li>左上の <em aria-label="Appleメニュー"></em> をクリックします。</li>
+            <li><em>システム設定…</em> をクリックします。</li>
+            <li><em>通知</em> をクリックします。</li>
+            <li><em><%= platform.browser.capitalize %></em> をクリックします。</li>
+            <li><em><%= icon_tag "switch", alt: "スイッチ" %></em> をクリックして <em>通知を許可</em> にします。</li>
+          <% end %>
+        </ol>
+      <% when platform.firefox? && platform.desktop? %>
+        <h3>このウェブサイトの通知を有効にする</h3>
+        <ol>
+          <li>左上の <em><%= platform.browser.capitalize %></em> をクリックします。</li>
+          <li><em>設定…</em> をクリックします。</li>
+          <li>サイドバーの <em>プライバシーとセキュリティ</em> をクリックします。</li>
+          <li><em>許可設定</em> までスクロールします。</li>
+          <li><em>通知</em> の横にある <em>設定</em> をクリックします。</li>
+          <li><em><%= root_url %></em> の横で <em>許可</em> を選択します。</li>
+        </ol>
+
