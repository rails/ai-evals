+        <%= icon_tag "arrow-path" %>
+        <span class="for-screen-reader">新しいコードを生成</span>
+      <% end %>
+
+      <div data-controller="dialog">
+        <button class="btn btn--circle" data-action="dialog#open">
+          <%= icon_tag "qrcode" %>
+          <span class="for-screen-reader">自動参加QRコードを表示</span>
+        </button>
+
+        <dialog class="dialog panel shadow gap align-center" data-dialog-target="dialog">
+          <%= render "qr_codes/qr_code", url: join_code_url(code: @join_code.code, script_name: nil) %>
+          <button class="btn btn--link full-width" data-action="dialog#close">完了</button>
+        </dialog>
+      </div>
+    </div>
+
+    <div class="txt-small">
+      <%= link_to edit_account_join_code_path, class: "txt-underline" do %>
