+    <% case
+      when platform.edge? %>
+        <ol>
+          <li>アドレスバーの<em><%= icon_tag "install-edge", alt: "Fizzyをインストールボタン" %></em>をクリックします。</li>
+          <li><em>インストール</em>をクリックします。</li>
+        </ol>
+      <% when platform.chrome? && platform.android? %>
+        <ol>
+          <li><em><%= icon_tag "menu-dots-vertical", alt: "その他のオプション" %></em>メニューボタンをタップします。</li>
+          <li>メニューの<em>アプリをインストール</em>をタップします。</li>
+        </ol>
+      <% when platform.firefox? && platform.android? %>
+        <ol>
+          <li><em><%= icon_tag "menu-dots-vertical", alt: "その他のオプション" %></em>メニューボタンをタップします。</li>
+          <li>メニューの<em>インストール</em>をタップします。</li>
+        </ol>
+      <% when platform.safari? && platform.desktop? %>
+        <ol>
+          <li>左上の<em>ファイル</em>をクリックします。</li>
+          <li><em>Dockに追加…</em>をクリックします。</li>
+        </ol>
+      <% when (platform.safari? || platform.chrome?) && platform.ios? %>
+        <p><%= platform.operating_system %> の <%= platform.browser.capitalize %> でプッシュ通知を受信するには、まずFizzyをウェブアプリとしてインストールする必要があります。</p>
+        <ol>
+          <li><em><%= icon_tag "share", alt: "共有ボタン" %></em>をタップします。</li>
+          <li><em>ホーム画面に追加</em>をタップします。</li>
+        </ol>
+      <% else %>
