diff --git a/app/views/webhooks/show.ja.html.erb b/app/views/webhooks/show.ja.html.erb
new file mode 100644
index 0000000..3c71c7c
--- /dev/null
+++ b/app/views/webhooks/show.ja.html.erb
@@ -0,0 +1,62 @@
+<% @page_title = @webhook.name %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <div class="header__actions header__actions--start">
+      <%= back_link_to "Webhook", board_webhooks_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+    </div>
+  </div>
+
+  <div class="header__actions header__actions--end">
+    <%= link_to edit_board_webhook_path(@webhook.board_id, @webhook), class: "btn" do %>
+      <%= icon_tag "pencil" %>
+      <span class="for-screen-reader">編集</span>
+    <% end %>
+  </div>
+<% end %>
+
+<div class="panel panel--wide shadow center flex flex-column gap txt-align-start">
+  <header>
+    <h1 class="txt-x-large margin-none"><%= @webhook.name %></h1>
+    <span class="txt-medium txt-break"><%= @webhook.url %></span>
+  </header>
+  <% unless @webhook.active? %>
+    <div>
+      <%= button_to "再有効化", board_webhook_activation_path(@webhook.board_id, @webhook), method: :post %>
+    </div>
+  <% end %>
+
+  <div>
+    <h2 class="margin-none txt-uppercase txt-medium">シークレット</h2>
+    <strong><code><%= @webhook.signing_secret %></code></strong>
+    <p class="txt-small txt-subtle margin-none">
+      リクエストごとに <code>X-Webhook-Signature</code> ヘッダーを送信します。
+      このシークレットを使用してリクエスト本文の <code>SHA256 HMAC</code> を生成することで、
+      リクエストがFizzyから送信されたことを確認できます。
+    </p>
+  </div>
+
+    <div class="flex flex-column">
+      <h2 class="margin-none txt-uppercase txt-medium">購読中のイベント</h2>
+      <% if @webhook.subscribed_actions.empty? %>
+        <p class="margin-none txt-subtle">このWebhookはどのイベントも購読していません。トリガーされることはありません。</p>
+      <% else %>
+        <ul class="margin-none unpad-block">
+          <% @webhook.subscribed_actions.each do |action| %>
+            <li><%= webhook_action_label(action) %></li>
+          <% end %>
+        </ul>
+      <% end %>
+    </div>
+
+    <div class="flex flex-column">
+      <h2 class="margin-none txt-uppercase txt-medium">配信履歴</h2>
+      <% if @webhook.deliveries.empty? %>
+        <p class="margin-none txt-subtle">このWebhookはまだトリガーされていません</p>
+      <% else %>
+        <ul class="margin-none unpad-block">
+          <%= render partial: "webhooks/delivery", collection: @webhook.deliveries.ordered.limit(20), as: :delivery %>
+        </ul>
+      <% end %>
+    </div>
+</div>
