@@ -0,0 +1,32 @@
+<% @page_title = "アカウントのインポート" %>
+<div class="panel panel--centered flex flex-column gap" style="--panel-size: 54ch;">
+  <header>
+    <h1 class="txt-x-large font-weight-black txt-tight-lines margin-block-end-none">Fizzyアカウントのインポート</h1>
+
+    <% if Fizzy.saas? %>
+      <div class="font-weight-semibold margin-block-end">独自のサーバーでFizzyを実行しており、代わりに <a class="txt-ink txt-underline" href="https://fizzy.do" target="_blank" rel="noopener noreferrer">fizzy.do</a> でホストすることを希望しますか？</div>
+      <div>セルフホストのアカウントをエクスポートし、以下の.zipファイルをアップロードしてください。</div>
+    <% else %>
+      <div class="font-weight-semibold margin-block-end">独自のサーバーでFizzyをホストする準備はできましたか？</div>
+      <div><a class="txt-ink txt-underline" href="https://fizzy.do" target="_blank" rel="noopener noreferrer">fizzy.do</a> アカウントをエクスポートし、以下の.zipファイルをアップロードしてください。</div>
+    <% end %>
+  </header>
+
+  <%= form_with url: account_imports_path, class: "flex flex-column gap", data: { controller: "form upload-preview" }, multipart: true do |form| %>
+    <label class="btn input--upload">
+      <div data-upload-preview-target="placeholder">ファイルを選択…</div>
+      <div data-upload-preview-target="fileName" hidden></div>
+      <%= form.file_field :file, accept: ".zip", required: true, data: { action: "upload-preview#previewFileName", upload_preview_target: "input" } %>
+    </label>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>インポートを開始 →</span>
+    </button>
+  <% end %>
+
+  <p class="txt-small">問題が発生した場合やサポートが必要な場合は、<a href="mailto:support@fizzy.do" class="txt-ink txt-underline">メールでお問い合わせください</a>。</p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
diff --git a/app/views/account/imports/show.ja.html.erb b/app/views/account/imports/show.ja.html.erb
new file mode 100644
index 0000000..9bed4e8
--- /dev/null
+++ b/app/views/account/imports/show.ja.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "インポート状況" %>
+
+<%= turbo_stream_from @import %>
+
+<div class="panel panel--centered flex flex-column gap-half" style="--panel-size: 54ch;">
+  <h1 class="txt-x-large font-weight-black margin-block-end">インポート状況</h1>
+
+  <% case @import.status %>
+  <% when "pending", "processing" %>
+    <div class="import-status">
+      インポート処理中です。大きなアカウントの場合は時間がかかることがあります。
+    </div>
+  <% when "completed" %>
+    <div class="import-status import-status--success">
+      <div><strong>インポートが成功しました！</strong></div>
+      <%= link_to "アカウントへ移動 →", landing_url(script_name: @import.account.slug), class: "btn btn--link" %>
+    </div>
+  <% when "failed" %>
+    <div class="import-status import-status--error">
+      <div><strong>インポート失敗</strong></div>
+      <% if @import.failed_due_to_conflict? %>
+        <div>インポートしようとしているアカウントはすでに存在します。<%= Fizzy.saas? ? "セルフホスト" : "fizzy.do" %> のアカウントをインポートしていることを確認してください。</div>
+      <% elsif @import.failed_due_to_invalid_export? %>
+        <div>アップロードされた.zipファイルはFizzyアカウントのエクスポートデータではないようです。</div>
+      <% else %>
+        <div>エクスポートデータの破損、または既存データとの競合が原因の可能性があります。新しくエクスポートしたデータでもう一度お試しください。</div>
+      <% end %>
+      <%= link_to "もう一度試す", new_account_import_path, class: "btn" %>
+    </div>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
