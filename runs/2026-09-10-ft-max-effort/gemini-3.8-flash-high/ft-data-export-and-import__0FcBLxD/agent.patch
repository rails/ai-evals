diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..cc13ad4
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:jason)
+  end
+
+  test "exports whole account as zip and sends email" do
+    export = @account.exports.create!(user: @admin)
+
+    assert_emails 1 do
+      export.process_now
+    end
+
+    assert_equal "completed", export.status
+    assert export.file.attached?
+
+    # Verify zip content
+    export.file.open do |tempfile|
+      ZipFile.open(tempfile.path) do |zip|
+        assert zip.exists?("accounts/#{@account.id}.json")
+        assert zip.exists?("users/#{@admin.id}.json")
+        assert zip.exists?("cards.json")
+
+        cards_data = JSON.parse(zip.read("cards.json"))
+        assert cards_data.is_a?(Array)
+        assert cards_data.any?
+      end
+    end
+
+    # Verify email
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    token = email.text_part.body.to_s[%r{/exports/([^/]+)/download}, 1]
+    assert token.present?
+    assert_equal export, Export.find_signed(token, purpose: :download)
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..55bea68
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @source_account = accounts(:"37s")
+    @admin = users(:jason)
+    @importer_identity = identities(:david)
+  end
+
+  test "imports whole account from export zip and sends completion email" do
+    # 1. Export the source account
+    export = @source_account.exports.create!(user: @admin)
+    export.process_now
+    assert export.file.attached?
+
+    # 2. Prepare import with the exported zip
+    tempfile = Tempfile.new([ "import", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.flush
+
+    new_account = Account.create!(name: "Pending Account")
+    import = Current.with_account(new_account) do
+      Account::Import.create!(
+        account: new_account,
+        identity: @importer_identity,
+        file: { io: File.open(tempfile.path), filename: "export.zip", content_type: "application/zip" }
+      )
+    end
+
+    # 3. Process import
+    assert_emails 1 do
+      import.process_now
+    end
+
+    assert_equal "completed", import.status
+    imported_account = import.account.reload
+
+    # Verify boards, cards, comments, users imported
+    assert_equal @source_account.name, imported_account.name
+    assert_not_equal @source_account.id, imported_account.id
+
+    assert_equal @source_account.boards.count, imported_account.boards.count
+    assert_equal @source_account.cards.count, imported_account.cards.count
+    assert_equal Comment.where(account: @source_account).count, Comment.where(account: imported_account).count
+
+    # Verify importer is owner
+    importer_user = imported_account.users.find_by(identity: @importer_identity)
+    assert importer_user.present?
+    assert importer_user.owner?
+
+    # Verify completion email was sent to importer
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @importer_identity.email_address ], email.to
+    assert_match "complete", email.subject
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "failed import leaves nothing behind and sends failure email" do
+    tempfile = Tempfile.new([ "bad_import", ".zip" ])
+    tempfile.binmode
+    ZipFile::Writer.new(tempfile).tap do |w|
+      # Invalid accounts json
+      w.add_file("accounts/1.json", "invalid json data")
+      w.close
+    end
+    tempfile.flush
+
+    initial_accounts_count = Account.count
+    initial_cards_count = Card.count
+    initial_imports_count = Account::Import.count
+
+    new_account = Account.create!(name: "Failing Account")
+    import = Current.with_account(new_account) do
+      Account::Import.create!(
+        account: new_account,
+        identity: @importer_identity,
+        file: { io: File.open(tempfile.path), filename: "bad.zip", content_type: "application/zip" }
+      )
+    end
+
+    assert_emails 1 do
+      import.process_now
+    end
+
+    # Leaves nothing behind:
+    assert_equal initial_accounts_count, Account.count
+    assert_equal initial_cards_count, Card.count
+    assert_equal initial_imports_count, Account::Import.count
+    assert_not Account.exists?(id: new_account.id)
+
+    # Email sent explaining why
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @importer_identity.email_address ], email.to
+    assert_match "failed", email.subject
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+
+  test "imports account with card image attachments" do
+    card = @source_account.cards.first
+    card.image.attach(
+      io: File.open(Rails.root.join("test/fixtures/files/avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    export = @source_account.exports.create!(user: @admin)
+    export.process_now
+
+    tempfile = Tempfile.new([ "import_att", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.flush
+
+    new_account = Account.create!(name: "Account with attachments")
+    import = Current.with_account(new_account) do
+      Account::Import.create!(
+        account: new_account,
+        identity: @importer_identity,
+        file: { io: File.open(tempfile.path), filename: "export.zip", content_type: "application/zip" }
+      )
+    end
+
+    import.process_now
+    assert_equal "completed", import.status
+
+    imported_account = import.account.reload
+    imported_card = imported_account.cards.find_by(number: card.number)
+
+    assert imported_card.present?
+    assert imported_card.image.attached?
+    assert_equal "avatar.png", imported_card.image.filename.to_s
+    assert_equal card.image.byte_size, imported_card.image.byte_size
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+
+  test "imports account with action text embeds" do
+    card = @source_account.cards.first
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(Rails.root.join("test/fixtures/files/avatar.png")),
+      filename: "embedded.png",
+      content_type: "image/png"
+    )
+    card.description = ActionText::Content.new("<action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment><p>Description with embed</p>")
+    card.save!
+
+    export = @source_account.exports.create!(user: @admin)
+    export.process_now
+
+    tempfile = Tempfile.new([ "import_embed", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.flush
+
+    new_account = Account.create!(name: "Account with embeds")
+    import = Current.with_account(new_account) do
+      Account::Import.create!(
+        account: new_account,
+        identity: @importer_identity,
+        file: { io: File.open(tempfile.path), filename: "export.zip", content_type: "application/zip" }
+      )
+    end
+
+    import.process_now
+    assert_equal "completed", import.status
+
+    imported_account = import.account.reload
+    imported_card = imported_account.cards.find_by(number: card.number)
+
+    assert imported_card.present?
+    assert_match "Description with embed", imported_card.description.to_plain_text
+    assert_equal 1, imported_card.description.embeds.count
+    assert_equal "embedded.png", imported_card.description.embeds.first.filename.to_s
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
diff --git a/test/models/user/export_test.rb b/test/models/user/export_test.rb
new file mode 100644
index 0000000..e504feb
--- /dev/null
+++ b/test/models/user/export_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class User::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "exports accessible cards as JSON with comments and attachments" do
+    export = @user.exports.create!(account: @account)
+
+    assert_emails 1 do
+      export.process_now
+    end
+
+    assert_equal "completed", export.status
+    assert export.file.attached?
+
+    # Verify zip content
+    export.file.open do |tempfile|
+      ZipFile.open(tempfile.path) do |zip|
+        assert zip.exists?("cards.json")
+        cards = JSON.parse(zip.read("cards.json"))
+        assert_equal @user.accessible_cards.count, cards.size
+
+        first_card = @user.accessible_cards.first
+        assert zip.exists?("cards/#{first_card.number}/card.json")
+
+        card_json = JSON.parse(zip.read("cards/#{first_card.number}/card.json"))
+        assert_equal first_card.title, card_json["title"]
+        assert card_json.key?("comments")
+      end
+    end
+
+    # Verify email
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    token = email.text_part.body.to_s[%r{/exports/([^/]+)/download}, 1]
+    assert token.present?
+    assert_equal export, Export.find_signed(token, purpose: :download)
+  end
+
+
+  test "user export only includes cards the user can see" do
+    # Create a private board that user cannot see
+    private_board = Board.create!(name: "Secret Board", creator: users(:jason), account: @account)
+    private_board.accesses.where(user: @user).destroy_all
+    private_card = private_board.cards.create!(title: "Secret Card", creator: users(:jason), account: @account)
+
+    export = @user.exports.create!(account: @account)
+    export.process_now
+
+    export.file.open do |tempfile|
+      ZipFile.open(tempfile.path) do |zip|
+        cards = JSON.parse(zip.read("cards.json"))
+        card_titles = cards.map { |c| c["title"] }
+
+        assert_not_includes card_titles, "Secret Card"
+        assert_not zip.exists?("cards/#{private_card.number}/card.json")
+      end
+    end
+  end
+
+  test "user export includes card image and embeds" do
+    card = @user.accessible_cards.first
+    card.image.attach(
+      io: File.open(Rails.root.join("test/fixtures/files/avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    export = @user.exports.create!(account: @account)
+    export.process_now
+
+    export.file.open do |tempfile|
+      ZipFile.open(tempfile.path) do |zip|
+        assert zip.exists?("cards/#{card.number}/avatar.png")
+        card_json = JSON.parse(zip.read("cards/#{card.number}/card.json"))
+        assert_equal "cards/#{card.number}/avatar.png", card_json.dig("image", "path")
+      end
+    end
+  end
+end
