diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..f4cb1bb
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+  end
+
+  test "unauthenticated user is redirected to sign in" do
+    get new_account_import_path
+    assert_response :redirect
+  end
+
+  test "authenticated user can view import page" do
+    sign_in_as @user
+    get new_account_import_path
+    assert_response :success
+  end
+
+  test "authenticated user can upload account file" do
+    sign_in_as @user
+
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+    ZipFile::Writer.new(tempfile).tap do |w|
+      w.add_file("accounts/1.json", { id: "1", name: "Imported Corp" }.to_json)
+      w.close
+    end
+    tempfile.flush
+
+    uploaded_file = fixture_file_upload(tempfile.path, "application/zip")
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_with(job: Account::ImportJob) do
+        post account_imports_path, params: { file: uploaded_file }
+      end
+    end
+
+    assert_response :redirect
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "fails gracefully when no file is uploaded" do
+    sign_in_as @user
+
+    assert_no_difference -> { Account::Import.count } do
+      post account_imports_path, params: { file: "" }
+    end
+
+    assert_redirected_to new_account_import_path
+    assert_equal "Please select a .zip file to import.", flash[:alert]
+  end
+
+  test "fails gracefully when invalid zip file is uploaded" do
+    sign_in_as @user
+
+    tempfile = Tempfile.new([ "not_a_zip", ".txt" ])
+    tempfile.write("hello world not zip")
+    tempfile.flush
+
+    uploaded_file = fixture_file_upload(tempfile.path, "application/zip")
+
+    assert_no_difference -> { Account::Import.count } do
+      post account_imports_path, params: { file: uploaded_file }
+    end
+
+    assert_redirected_to new_account_import_path
+    assert flash[:alert].present?
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
diff --git a/test/controllers/exports/downloads_controller_test.rb b/test/controllers/exports/downloads_controller_test.rb
new file mode 100644
index 0000000..992417a
--- /dev/null
+++ b/test/controllers/exports/downloads_controller_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Exports::DownloadsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+    @export = @account.exports.create!(user: @user)
+
+    Current.with_account(@account) do
+      @export.file.attach(
+        io: StringIO.new("fake zip data"),
+        filename: "export.zip",
+        content_type: "application/zip"
+      )
+    end
+  end
+
+  test "downloads file with valid signed id" do
+    token = @export.signed_id(purpose: :download, expires_in: 1.day)
+
+    get export_download_path(token)
+    assert_response :success
+    assert_equal "application/zip", response.content_type
+    assert_equal "fake zip data", response.body
+  end
+
+  test "returns not found for expired token" do
+    token = @export.signed_id(purpose: :download, expires_in: 1.second)
+    sleep 2
+
+    get export_download_path(token)
+    assert_response :not_found
+  end
+
+  test "returns not found for invalid token" do
+    get export_download_path("invalid-token")
+    assert_response :not_found
+  end
+
+
+  test "download link works within a day and expires after a day" do
+    token = @export.signed_id(purpose: :download, expires_in: 1.day)
+
+    travel 23.hours do
+      get export_download_path(token)
+      assert_response :success
+    end
+
+    travel 25.hours do
+      get export_download_path(token)
+      assert_response :not_found
+    end
+  end
+end
