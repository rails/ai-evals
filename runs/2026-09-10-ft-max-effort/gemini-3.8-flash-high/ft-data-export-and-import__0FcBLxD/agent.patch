diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..a11a354
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,52 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+  skip_before_action :ensure_can_access_account, raise: false
+  before_action :require_authentication
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    uploaded_file = params[:file] || params.dig(:account_import, :file) || params.dig(:import, :file)
+
+    if uploaded_file.blank?
+      redirect_to new_account_import_path, alert: "Please select a .zip file to import."
+      return
+    end
+
+    account_name = extract_account_name(uploaded_file)
+    unless account_name
+      redirect_to new_account_import_path, alert: "The file you uploaded is not a valid Fizzy export archive."
+      return
+    end
+
+    new_account = Account.create!(name: account_name)
+
+    @import = Current.with_account(new_account) do
+      Account::Import.create!(account: new_account, identity: Current.identity, file: uploaded_file)
+    end
+
+    @import.process_later
+
+    redirect_url = Current.account.present? ? root_path : session_menu_path(script_name: nil)
+    redirect_to redirect_url, notice: "Import has started. We’ll email you when your new account is ready."
+  rescue Zip::Error, StandardError => e
+    new_account&.destroy rescue nil
+    redirect_to new_account_import_path, alert: "Could not import file: #{e.message}"
+  end
+
+  private
+    def extract_account_name(file)
+      path = file.respond_to?(:path) ? file.path : file.to_s
+      ZipFile.open(path) do |zip|
+        entries = zip.glob("accounts/*.json")
+        if entry = entries.first
+          data = JSON.parse(zip.read(entry))
+          data["name"]
+        end
+      end
+    rescue Zip::Error, StandardError
+      nil
+    end
+end
