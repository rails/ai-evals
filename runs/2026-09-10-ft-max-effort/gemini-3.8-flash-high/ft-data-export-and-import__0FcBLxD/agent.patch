diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..2203c88
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,60 @@
+require "zip"
+
+class ZipFile::Reader
+  class << self
+    def open(file_or_path_or_io, &block)
+      reader = new(file_or_path_or_io)
+      if block_given?
+        begin
+          yield reader
+        ensure
+          reader.close
+        end
+      else
+        reader
+      end
+    end
+  end
+
+  def initialize(file_or_path_or_io)
+    if file_or_path_or_io.is_a?(String) || file_or_path_or_io.is_a?(Pathname)
+      @zip = Zip::File.open(file_or_path_or_io.to_s)
+    elsif file_or_path_or_io.respond_to?(:path) && file_or_path_or_io.path.present?
+      @zip = Zip::File.open(file_or_path_or_io.path)
+    else
+      @zip = Zip::File.open_buffer(file_or_path_or_io)
+    end
+  end
+
+  def entries
+    @zip.entries.map(&:name)
+  end
+
+  def file_names
+    entries
+  end
+
+  def exists?(path)
+    @zip.find_entry(path).present?
+  end
+
+  def glob(pattern)
+    @zip.entries.map(&:name).select { |name| File.fnmatch(pattern, name, File::FNM_PATHNAME | File::FNM_DOTMATCH) || File.fnmatch(pattern, name) }.sort
+  end
+
+  def read(path)
+    entry = @zip.find_entry(path)
+    entry&.get_input_stream&.read
+  end
+
+  def open_stream(path, &block)
+    entry = @zip.find_entry(path)
+    if entry
+      entry.get_input_stream(&block)
+    end
+  end
+
+  def close
+    @zip.close
+  end
+end
