+    Current.with_account(account) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        manifest = Account::DataTransfer::Manifest.new(account)
+        manifest.export(zip)
+        export_cards_json(zip)
+      end
+    end
+
+    update!(status: "completed")
+    AccountMailer.export_completed(self).deliver_later
+  end
+
+  private
+    def export_cards_json(zip)
+      cards_data = account.cards.chronologically.includes(:tags, :steps, :assignees, :creator, :board, :column).map do |card|
+        card_hash_for(card)
+      end
+      zip.add_file("cards.json", JSON.pretty_generate(cards_data))
+    end
+
+    def card_hash_for(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        created_at: card.created_at.iso8601,
+        updated_at: card.updated_at.iso8601,
+        last_active_at: card.last_active_at&.iso8601,
+        board: { id: card.board.id, name: card.board.name },
+        column: card.column ? { id: card.column.id, name: card.column.name } : nil,
+        creator: { id: card.creator.id, name: card.creator.name },
+        assignees: card.assignees.map { |a| { id: a.id, name: a.name } },
+        tags: card.tags.pluck(:title).sort,
+        steps: card.steps.map { |s| { id: s.id, content: s.content, completed: s.completed? } },
+        comments: card.comments.chronologically.includes(:creator).map do |c|
+          {
+            id: c.id,
+            body: c.body.to_plain_text,
+            body_html: c.body.to_s,
+            creator: { id: c.creator.id, name: c.creator.name },
+            created_at: c.created_at.iso8601,
+            updated_at: c.updated_at.iso8601
+          }
+        end
+      }
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..b54c8bb
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,118 @@
+class Account::Import < ApplicationRecord
+  self.table_name = "imports"
+
+  belongs_to :account, optional: true
+  belongs_to :identity
+
+  has_one_attached :file, dependent: :purge_later
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    update!(status: "processing")
+
+    created_account = nil
+
+    file.open do |temp_file|
+      ZipFile.open(temp_file.path) do |zip|
+        account_entries = zip.glob("accounts/*.json")
+        if account_entries.empty?
+          raise "Invalid import file: missing account data"
+        end
+
+        account_data = JSON.parse(zip.read(account_entries.first))
+
+        ApplicationRecord.transaction do
+          created_account = Account.create!(name: account_data["name"])
+          update!(account: created_account)
+
+          Current.with_account(created_account) do
+            Event.suppress do
+              Storage::Entry.suppressing_recording do
+                id_map = {}
+                id_map[account_data["id"]] = created_account.id
+
+                manifest = Account::DataTransfer::Manifest.new(created_account)
+                manifest.import(zip, id_map)
+
+                ensure_importer_user!(created_account)
+
+                max_card_number = created_account.cards.maximum(:number) || 0
+                created_account.update_columns(cards_count: max_card_number)
+
+                created_account.cards.find_each(&:reindex)
+                Comment.where(account_id: created_account.id).find_each(&:reindex)
+              end
+            end
+          end
+        end
+      end
+    end
+
+    update!(status: "completed")
+    AccountMailer.import_completed(self).deliver_later
+  rescue => e
+    handle_failure(e, created_account)
+  end
+
+  private
+    def ensure_importer_user!(target_account)
+      user = target_account.users.find_by(identity: identity)
+      if user
+        user.update!(active: true, role: :owner)
+      else
+        name = identity.email_address.split("@").first.humanize
+        target_account.users.create!(
+          identity: identity,
+          name: name,
+          role: :owner,
+          active: true,
+          verified_at: Time.current
+        )
+      end
+
+      importer_user = target_account.users.find_by(identity: identity)
+      if importer_user
+        target_account.boards.find_each do |board|
+          board.accesses.find_or_create_by!(user: importer_user, account: target_account)
+        end
+      end
+    end
+
+    def handle_failure(exception, created_account)
+      error_msg = exception.message
+      importer_identity = identity
+
+      AccountMailer.import_failed(identity: importer_identity, error_message: error_msg).deliver_later
+
+      target_account = created_account || account
+      if target_account.present?
+        ActiveStorage::Blob.where(account_id: target_account.id).find_each do |blob|
+          blob.purge rescue nil
+        end
+
+        target_account.destroy rescue nil
+
+        models_to_clean = [
+          Account, User, User::Settings, Tag, Board, Column, Entropy,
+          Board::Publication, Webhook, Access, Card, Comment, Step, Assignment,
+          Tagging, Closure, Card::Goldness, Card::NotNow, Card::ActivitySpike,
+          Watch, Pin, Reaction, Mention, Filter, Webhook::DelinquencyTracker,
+          Event, Notification, Notification::Bundle, Webhook::Delivery,
+          ActiveStorage::Blob, ActiveStorage::VariantRecord, ActiveStorage::Attachment,
+          ActionText::RichText
+        ]
+
+        models_to_clean.each do |m|
+          if m.column_names.include?("account_id")
+            m.where(account_id: target_account.id).delete_all rescue nil
+          end
+        end
+      end
+
+      file.purge rescue nil
+      destroy rescue nil
+    end
+end
