diff --git a/app/models/user/export.rb b/app/models/user/export.rb
new file mode 100644
index 0000000..f329093
--- /dev/null
+++ b/app/models/user/export.rb
@@ -0,0 +1,92 @@
+class User::Export < Export
+  def process_now
+    filename = "cards-export-#{user.id}-#{Time.current.strftime('%Y%m%d%H%M%S')}.zip"
+    Current.with_account(account) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        cards = user.accessible_cards.chronologically.includes(:tags, :steps, :assignees, :creator, :board, :column)
+        cards_data = []
+
+        cards.find_each do |card|
+          card_data = export_card(card, zip)
+          cards_data << card_data
+        end
+
+        zip.add_file("cards.json", JSON.pretty_generate(cards_data))
+      end
+    end
+
+    update!(status: "completed")
+    UserMailer.export_completed(self).deliver_later
+  end
+
+  private
+    def export_card(card, zip)
+      card_dir = "cards/#{card.number}"
+      attachments_data = []
+
+      if card.image.attached?
+        image_path = "#{card_dir}/#{card.image.filename}"
+        zip.add_file(image_path) do |sink|
+          card.image.download { |chunk| sink.write(chunk) }
+        end
+        attachments_data << { filename: card.image.filename.to_s, path: image_path, content_type: card.image.content_type }
+      end
+
+      card.description.embeds.each do |embed|
+        file_path = "#{card_dir}/files/#{embed.filename}"
+        zip.add_file(file_path) do |sink|
+          embed.download { |chunk| sink.write(chunk) }
+        end
+        attachments_data << { filename: embed.filename.to_s, path: file_path, content_type: embed.content_type }
+      end
+
+      comments_data = card.comments.chronologically.includes(:creator).map do |comment|
+        comment_attachments = []
+        comment.body.embeds.each do |embed|
+          file_path = "#{card_dir}/comments/#{comment.id}/files/#{embed.filename}"
+          zip.add_file(file_path) do |sink|
+            embed.download { |chunk| sink.write(chunk) }
+          end
+          comment_attachments << { filename: embed.filename.to_s, path: file_path, content_type: embed.content_type }
+        end
+
+        {
+          id: comment.id,
+          body: comment.body.to_plain_text,
+          body_html: comment.body.to_s,
+          creator: { id: comment.creator.id, name: comment.creator.name },
+          created_at: comment.created_at.iso8601,
+          updated_at: comment.updated_at.iso8601,
+          attachments: comment_attachments
+        }
+      end
+
+      data = {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        created_at: card.created_at.iso8601,
+        updated_at: card.updated_at.iso8601,
+        last_active_at: card.last_active_at&.iso8601,
+        board: { id: card.board.id, name: card.board.name },
+        column: card.column ? { id: card.column.id, name: card.column.name } : nil,
+        creator: { id: card.creator.id, name: card.creator.name },
+        assignees: card.assignees.map { |a| { id: a.id, name: a.name } },
+        tags: card.tags.pluck(:title).sort,
+        steps: card.steps.map { |s| { id: s.id, content: s.content, completed: s.completed? } },
+        comments: comments_data,
+        image: card.image.attached? ? { filename: card.image.filename.to_s, path: "#{card_dir}/#{card.image.filename}", content_type: card.image.content_type } : nil,
+        attachments: attachments_data
+      }
+
+      zip.add_file("#{card_dir}/card.json", JSON.pretty_generate(data))
+      zip.add_file("#{card_dir}.json", JSON.pretty_generate(data))
+      data
+    end
+end
