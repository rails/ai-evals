diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..8e9c35b
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,61 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+  wrap_parameters :reaction, include: %i[ content ]
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_commentable, only: :create
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.chronologically
+  end
+
+  def show
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @comment }
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @comment }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_reacter
+      head :forbidden unless Current.user == @reaction.reacter
+    end
+
+    def reaction_params
+      if params[:reaction].present?
+        params.expect(reaction: [ :content ])
+      else
+        params.permit(:content)
+      end
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..36b1932
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,55 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "deleteButton" ]
+
+  connect() {
+    this.#updateDeleteability()
+  }
+
+  toggle(event) {
+    if (!this.#isDeletable) return
+    if (event.target.closest(".reaction__delete")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  closeOnClickOutside(event) {
+    if (!this.element.contains(event.target)) {
+      this.element.classList.remove("expanded")
+    }
+  }
+
+  closeOnEscape(event) {
+    if (event.key === "Escape") {
+      this.element.classList.remove("expanded")
+    }
+  }
+
+  delete() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #currentUserId() {
+    return document.head.querySelector("meta[name='current-user-id']")?.content
+  }
+
+  get #isDeletable() {
+    return Boolean(this.element.dataset.creatorId && this.element.dataset.creatorId === this.#currentUserId)
+  }
+
+  #updateDeleteability() {
+    if (this.#isDeletable) {
+      this.element.classList.add("reaction--deleteable")
+      if (this.hasDeleteButtonTarget) {
+        this.deleteButtonTarget.hidden = false
+      }
+    } else {
+      this.element.classList.remove("reaction--deleteable")
+      this.element.classList.remove("expanded")
+      if (this.hasDeleteButtonTarget) {
+        this.deleteButtonTarget.hidden = true
+      }
+    }
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..a78cfad
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,45 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+  }
+
+  submit(event) {
+    if (this.inputTarget.value.trim().length === 0) {
+      event.preventDefault()
+      return
+    }
+
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  submitEnd(event) {
+    if (event.detail.success) {
+      this.inputTarget.value = ""
+    } else {
+      this.open()
+    }
+  }
+
+  closeOnClickOutside(event) {
+    if (this.formTarget.hidden) return
+    if (this.element.contains(event.target)) return
+
+    this.cancel()
+  }
+}
