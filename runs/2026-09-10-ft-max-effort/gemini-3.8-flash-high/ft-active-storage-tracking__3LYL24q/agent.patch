diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..cb118d0 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,80 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    before_destroy { capture_storage_board }
+    after_create_commit { refresh_storage_usage_later }
+    after_destroy_commit { refresh_storage_usage_later }
+  end
+
+  def purge
+    board = capture_storage_board
+    super
+  ensure
+    board&.refresh_storage_usage_later
+  end
+
+  def purge_later
+    board = capture_storage_board
+    super
+  ensure
+    board&.refresh_storage_usage_later
+  end
+
+  def capture_storage_board
+    @storage_board ||= resolve_storage_board
+  end
+
+  def refresh_storage_usage_later
+    board = @storage_board || resolve_storage_board
+    board&.refresh_storage_usage_later
+  end
+
+  private
+    def resolve_storage_board
+      case record_type
+      when "Card"
+        if name == "image"
+          card = (record.is_a?(Card) ? record : nil) || Card.find_by(id: record_id)
+          card&.board
+        end
+      when "ActionText::RichText"
+        if name == "embeds"
+          rich_text = (record.is_a?(ActionText::RichText) ? record : nil) || ActionText::RichText.find_by(id: record_id)
+          parent = rich_text&.record || find_rich_text_parent(rich_text)
+          case parent
+          when Board
+            parent
+          when Card
+            parent.board
+          when Comment
+            parent.card&.board
+          end
+        end
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def find_rich_text_parent(rich_text)
+      if rich_text&.record_type && rich_text&.record_id
+        case rich_text.record_type
+        when "Board" then Board.find_by(id: rich_text.record_id)
+        when "Card" then Card.find_by(id: rich_text.record_id)
+        when "Comment" then Comment.find_by(id: rich_text.record_id)
+        end
+      end
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend ActiveStorageAttachmentStorageTracking
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.prepend ActiveStorageAttachmentStorageTracking
+end
