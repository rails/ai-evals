+module Account::Storage
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def refresh_all_storage_usage_later
+      find_each(&:refresh_storage_usage_later)
+    end
+  end
+
+  def bytes_used
+    boards.sum(:bytes_used)
+  end
+
+  def refresh_storage_usage_later
+    Account::StorageUsageJob.perform_later(self)
+  end
+  alias_method :calculate_bytes_used_later, :refresh_storage_usage_later
+
+  def refresh_storage_usage_now
+    boards.find_each(&:refresh_storage_usage_now)
+    refresh_storage_usage
+  end
+  alias_method :calculate_bytes_used_now, :refresh_storage_usage_now
+
+  def refresh_storage_usage
+    total = boards.sum(:bytes_used)
+    update_columns(bytes_used: total) if has_attribute?(:bytes_used) && self[:bytes_used] != total
+    total
+  end
+
+  def calculate_bytes_used
+    boards.to_a.sum(&:calculate_bytes_used)
+  end
+end
