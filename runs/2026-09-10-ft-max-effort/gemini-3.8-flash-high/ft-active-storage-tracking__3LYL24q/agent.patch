diff --git a/test/models/storage_test.rb b/test/models/storage_test.rb
new file mode 100644
index 0000000..ac72b74
--- /dev/null
+++ b/test/models/storage_test.rb
@@ -0,0 +1,305 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+
+    @board1 = @account.boards.create!(name: "Storage Board 1", creator: @user)
+    @board2 = @account.boards.create!(name: "Storage Board 2", creator: @user)
+    @fixture_path = file_fixture("moon.jpg")
+    @file_size = @fixture_path.size
+  end
+
+  test "new board and account start with zero bytes used" do
+    fresh_account = Account.create!(name: "Zero Storage Account")
+    fresh_board = fresh_account.boards.create!(name: "Fresh Board", creator: @user)
+
+    assert_equal 0, fresh_board.bytes_used
+    assert_equal 0, fresh_account.bytes_used
+  end
+
+  test "card image is counted towards board and account usage in the background" do
+    card = @board1.cards.create!(title: "Card with image", status: :published, creator: @user)
+
+    assert_difference -> { @board1.reload.bytes_used }, @file_size do
+      assert_difference -> { @account.reload.bytes_used }, @file_size do
+        card.image.attach(io: @fixture_path.open, filename: "moon.jpg", content_type: "image/jpeg")
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "files embedded in board description are counted towards board and account usage" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: @fixture_path.open, filename: "board_embed.jpg", content_type: "image/jpeg")
+    embed_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    assert_difference -> { @board1.reload.bytes_used }, @file_size do
+      assert_difference -> { @account.reload.bytes_used }, @file_size do
+        @board1.update!(public_description: "<p>#{embed_html}</p>")
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "files embedded in card description are counted towards board and account usage" do
+    card = @board1.cards.create!(title: "Card with embed", status: :published, creator: @user)
+    blob = ActiveStorage::Blob.create_and_upload!(io: @fixture_path.open, filename: "card_embed.jpg", content_type: "image/jpeg")
+    embed_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    assert_difference -> { @board1.reload.bytes_used }, @file_size do
+      assert_difference -> { @account.reload.bytes_used }, @file_size do
+        card.update!(description: "<p>#{embed_html}</p>")
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "files embedded in comments are counted towards board and account usage" do
+    card = @board1.cards.create!(title: "Card for comment", status: :published, creator: @user)
+    comment = card.comments.create!(creator: @user)
+    blob = ActiveStorage::Blob.create_and_upload!(io: @fixture_path.open, filename: "comment_embed.jpg", content_type: "image/jpeg")
+    embed_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    assert_difference -> { @board1.reload.bytes_used }, @file_size do
+      assert_difference -> { @account.reload.bytes_used }, @file_size do
+        comment.update!(body: "<p>#{embed_html}</p>")
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "purging a card image decreases bytes used" do
+    card = @board1.cards.create!(title: "Purge Card", status: :published, creator: @user)
+    card.image.attach(io: @fixture_path.open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_difference -> { @board1.reload.bytes_used }, -@file_size do
+      assert_difference -> { @account.reload.bytes_used }, -@file_size do
+        card.image.purge
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "replacing a card image updates bytes used" do
+    card = @board1.cards.create!(title: "Replace Card", status: :published, creator: @user)
+    small_content = "small"
+    large_content = "a" * 5000
+
+    card.image.attach(io: StringIO.new(small_content), filename: "small.txt", content_type: "text/plain")
+    perform_enqueued_jobs
+    assert_equal small_content.bytesize, @board1.reload.bytes_used
+
+    card.image.attach(io: StringIO.new(large_content), filename: "large.txt", content_type: "text/plain")
+    perform_enqueued_jobs
+    assert_equal large_content.bytesize, @board1.reload.bytes_used
+    assert_equal large_content.bytesize, @account.reload.bytes_used
+  end
+
+  test "removing embeds from card description decreases bytes used" do
+    card = @board1.cards.create!(title: "Embed Card", status: :published, creator: @user)
+    blob = ActiveStorage::Blob.create_and_upload!(io: @fixture_path.open, filename: "embed.jpg", content_type: "image/jpeg")
+    embed_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    card.update!(description: "<p>#{embed_html}</p>")
+    perform_enqueued_jobs
+    assert_equal @file_size, @board1.reload.bytes_used
+
+    assert_difference -> { @board1.reload.bytes_used }, -@file_size do
+      assert_difference -> { @account.reload.bytes_used }, -@file_size do
+        card.update!(description: "<p>No attachments anymore</p>")
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "destroying a comment decreases bytes used" do
+    card = @board1.cards.create!(title: "Comment Card", status: :published, creator: @user)
+    comment = card.comments.create!(creator: @user)
+    blob = ActiveStorage::Blob.create_and_upload!(io: @fixture_path.open, filename: "comment_embed.jpg", content_type: "image/jpeg")
+    embed_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    comment.update!(body: "<p>#{embed_html}</p>")
+    perform_enqueued_jobs
+    assert_equal @file_size, @board1.reload.bytes_used
+
+    assert_difference -> { @board1.reload.bytes_used }, -@file_size do
+      assert_difference -> { @account.reload.bytes_used }, -@file_size do
+        comment.destroy
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "destroying a card decreases bytes used" do
+    card = @board1.cards.create!(title: "Destroy Card", status: :published, creator: @user)
+    card.image.attach(io: @fixture_path.open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+    assert_equal @file_size, @board1.reload.bytes_used
+
+    assert_difference -> { @board1.reload.bytes_used }, -@file_size do
+      assert_difference -> { @account.reload.bytes_used }, -@file_size do
+        card.destroy
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "moving a card to another board moves its usage between boards without altering account total" do
+    card = @board1.cards.create!(title: "Moving Card", status: :published, creator: @user)
+    card.image.attach(io: @fixture_path.open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal @file_size, @board1.reload.bytes_used
+    assert_equal 0, @board2.reload.bytes_used
+    initial_account_bytes = @account.reload.bytes_used
+
+    card.update!(board: @board2)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board1.reload.bytes_used
+    assert_equal @file_size, @board2.reload.bytes_used
+    assert_equal initial_account_bytes, @account.reload.bytes_used
+  end
+
+  test "destroying a board decreases account usage" do
+    card = @board2.cards.create!(title: "Card on board 2", status: :published, creator: @user)
+    card.image.attach(io: @fixture_path.open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal @file_size, @board2.reload.bytes_used
+
+    assert_difference -> { @account.reload.bytes_used }, -@file_size do
+      @board2.destroy
+      perform_enqueued_jobs
+    end
+  end
+
+  test "non-counted attachments are not included in bytes used" do
+    initial_board_bytes = @board1.reload.bytes_used
+    initial_account_bytes = @account.reload.bytes_used
+
+    # User avatar
+    @user.avatar.attach(io: @fixture_path.open, filename: "avatar.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    # Export file
+    export = Account::Export.create!(account: @account, user: @user)
+    export.file.attach(io: StringIO.new("export content"), filename: "export.zip", content_type: "application/zip")
+    perform_enqueued_jobs
+
+    assert_equal initial_board_bytes, @board1.reload.bytes_used
+    assert_equal initial_account_bytes, @account.reload.bytes_used
+  end
+
+  test "account usage sums across all boards" do
+    card1 = @board1.cards.create!(title: "Card on board 1", status: :published, creator: @user)
+    card2 = @board2.cards.create!(title: "Card on board 2", status: :published, creator: @user)
+
+    card1.image.attach(io: @fixture_path.open, filename: "moon1.jpg", content_type: "image/jpeg")
+    card2.image.attach(io: @fixture_path.open, filename: "moon2.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal @file_size, @board1.reload.bytes_used
