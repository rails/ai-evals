new file mode 100644
index 0000000..6708a91
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,65 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    has_rich_text :description
+
+    after_destroy_commit { refresh_account_storage_usage_later }
+  end
+
+  class_methods do
+    def refresh_all_storage_usage_later
+      find_each(&:refresh_storage_usage_later)
+    end
+  end
+
+  def bytes_used
+    read_attribute(:bytes_used).to_i
+  end
+
+  def refresh_storage_usage_later
+    Board::StorageUsageJob.perform_later(self)
+  end
+  alias_method :calculate_bytes_used_later, :refresh_storage_usage_later
+
+  def refresh_storage_usage_now
+    new_bytes = calculate_bytes_used
+    update_columns(bytes_used: new_bytes) if bytes_used != new_bytes
+    account&.refresh_storage_usage
+    new_bytes
+  end
+  alias_method :calculate_bytes_used_now, :refresh_storage_usage_now
+  alias_method :refresh_storage_usage, :refresh_storage_usage_now
+
+  def calculate_bytes_used
+    cards_scope = cards.select(:id)
+    comments_scope = Comment.where(card_id: cards_scope).select(:id)
+
+    # 1. Card images
+    card_images_bytes = ActiveStorage::Attachment.where(
+      record_type: "Card",
+      name: "image",
+      record_id: cards_scope
+    ).joins(:blob).sum("active_storage_blobs.byte_size")
+
+    # 2. Rich text embeds (board description, card descriptions, and comment bodies)
+    board_rich_texts = ActionText::RichText.where(record_type: "Board", record_id: id).select(:id)
+    card_rich_texts = ActionText::RichText.where(record_type: "Card", record_id: cards_scope).select(:id)
+    comment_rich_texts = ActionText::RichText.where(record_type: "Comment", record_id: comments_scope).select(:id)
+
+    rich_texts_scope = board_rich_texts.or(card_rich_texts).or(comment_rich_texts)
+
+    embeds_bytes = ActiveStorage::Attachment.where(
+      record_type: "ActionText::RichText",
+      name: "embeds",
+      record_id: rich_texts_scope
+    ).joins(:blob).sum("active_storage_blobs.byte_size")
+
+    card_images_bytes + embeds_bytes
+  end
+
+  private
+    def refresh_account_storage_usage_later
+      account&.refresh_storage_usage_later
+    end
+end
