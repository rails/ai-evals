@@ -9,6 +9,24 @@ You are welcome -- and encouraged -- to modify Fizzy to your liking.
 Please see our [Development guide](docs/development.md) for how to get Fizzy set up for local development.
 
 
+## Deployment
+
+Fizzy is configured to deploy to a single Linux server with Docker using [Kamal](https://kamal-deploy.org/).
+
+1. Configure `config/deploy.yml`:
+   - Set your server IP address under `servers.web`
+   - Set your hostname under `proxy.host`
+   - Set your Docker registry username under `image` and `registry.username`
+   - Set your outgoing mail server under `env.clear` (`SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_USERNAME`)
+2. Configure `.kamal/secrets`:
+   - `KAMAL_REGISTRY_PASSWORD`: Your Docker registry token or password
+   - `SECRET_KEY_BASE`: Secret key generated via `bin/rails secret`
+   - `SMTP_PASSWORD`: Password for your SMTP server
+3. Run `kamal setup` (or `bin/kamal setup`)
+
+Everything runs in a single container with SQLite data stored in a Docker volume (`fizzy_storage`) that survives deploys, background jobs managed by Solid Queue inside Puma, and SSL certificates automatically provisioned by the proxy via Let's Encrypt.
+
+
 ## Contributing
 
 We welcome contributions! Please read our [style guide](STYLE.md) before submitting code.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..0ad8512
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,63 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: your-user/fizzy
+
+# Deploy to this server.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt and allow for multiple apps on a single web server.
+proxy:
+  ssl: true
+  host: &app_host app.example.com
+
+# Credentials for your image host.
+registry:
+  # Specify the registry server, if you're not using Docker Hub
+  # server: registry.digitalocean.com / ghcr.io / ...
+  username: your-user
+
+  # Always use an access token rather than real password (pulled from .kamal/secrets).
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Configure builder setup.
+builder:
+  arch: amd64
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run the Solid Queue Supervisor inside the web server's Puma process to do jobs.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # The hostname where Fizzy is accessible.
+    APP_HOST: *app_host
+
+    # Outbound email configuration (SMTP)
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    # MAILER_FROM_ADDRESS: "Fizzy <notifications@example.com>"
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS_AUTO: true
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+# Use a persistent storage volume for sqlite database files and local Active Storage files.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
