diff --git a/test/integration/deployment_configuration_test.rb b/test/integration/deployment_configuration_test.rb
new file mode 100644
index 0000000..5703169
--- /dev/null
+++ b/test/integration/deployment_configuration_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+require "kamal"
+
+class DeploymentConfigurationTest < ActiveSupport::TestCase
+  test "kamal deploy config is valid for single box deployment" do
+    config = Kamal::Configuration.create_from(config_file: Rails.root.join("config/deploy.yml"))
+
+    assert_equal "fizzy", config.service
+    assert_equal [ "web" ], config.roles.map(&:name)
+    assert_equal 1, config.all_hosts.size
+    assert config.proxy.ssl?, "SSL should be enabled on the proxy"
+    assert config.proxy.hosts.present?, "Proxy host should be configured"
+    assert_includes config.raw_config.volumes, "fizzy_storage:/rails/storage"
+    assert_equal "/rails/public/assets", config.asset_path
+    assert_equal true, config.env.clear["SOLID_QUEUE_IN_PUMA"]
+    assert_equal config.proxy.hosts.first, config.env.clear["APP_HOST"]
+    assert config.env.clear.key?("SMTP_ADDRESS")
+    assert_includes config.env.secret_keys, "SECRET_KEY_BASE"
+    assert_includes config.env.secret_keys, "SMTP_PASSWORD"
+  end
+
+  test "kamal secrets file exists and defines required secrets" do
+    secrets_path = Rails.root.join(".kamal/secrets")
+    assert File.exist?(secrets_path), ".kamal/secrets should exist"
+
+    content = File.read(secrets_path)
+    assert_match(/KAMAL_REGISTRY_PASSWORD/, content)
+    assert_match(/SECRET_KEY_BASE/, content)
+    assert_match(/SMTP_PASSWORD/, content)
+  end
+
+  test "production environment configures host and mailer from environment" do
+    # Verify that production configuration logic works
+    app = Rails.application
+    env_backup = ENV.to_h
+
+    begin
+      ENV["APP_HOST"] = "https://fizzy.example.com/"
+      ENV["SMTP_ADDRESS"] = "smtp.example.com"
+      ENV["SMTP_PORT"] = "587"
+      ENV["SMTP_USERNAME"] = "user@example.com"
+      ENV["SMTP_PASSWORD"] = "smtp-secret"
+      ENV["SMTP_AUTHENTICATION"] = "plain"
+
+      # Re-evaluate the production configuration block
+      load Rails.root.join("config/environments/production.rb")
+
+      assert_equal({ host: "fizzy.example.com", protocol: "https" }, app.config.action_mailer.default_url_options)
+      assert_equal({ host: "fizzy.example.com", protocol: "https" }, app.config.action_controller.default_url_options)
+      assert_equal({ host: "fizzy.example.com", protocol: "https" }, app.routes.default_url_options)
+      assert_equal :smtp, app.config.action_mailer.delivery_method
+      assert_equal "smtp.example.com", app.config.action_mailer.smtp_settings[:address]
+      assert_equal 587, app.config.action_mailer.smtp_settings[:port]
+      assert_equal "fizzy.example.com", app.config.action_mailer.smtp_settings[:domain]
+      assert_equal "user@example.com", app.config.action_mailer.smtp_settings[:user_name]
+      assert_equal "smtp-secret", app.config.action_mailer.smtp_settings[:password]
+      assert_equal :plain, app.config.action_mailer.smtp_settings[:authentication]
+      assert_equal true, app.config.action_mailer.smtp_settings[:enable_starttls_auto]
+    ensure
+      ENV.replace(env_backup)
+      load Rails.root.join("config/environments/test.rb")
+    end
+  end
+end
