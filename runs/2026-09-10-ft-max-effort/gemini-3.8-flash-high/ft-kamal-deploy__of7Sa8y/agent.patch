   config.action_mailer.perform_caching = false
 
+  # Set host to be used by links generated in mailer templates and background jobs.
+  if host = (ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence)
+    host = host.sub(%r{\Ahttps?://}, "").chomp("/")
+    config.action_mailer.default_url_options = { host: host, protocol: "https" }
+    config.action_controller.default_url_options = { host: host, protocol: "https" }
+    routes.default_url_options = { host: host, protocol: "https" }
+  end
+
+  # Configure outgoing email server (SMTP).
+  if ENV["SMTP_ADDRESS"].present?
+    config.action_mailer.delivery_method = :smtp
+    smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV["SMTP_DOMAIN"].presence || host,
+      enable_starttls_auto: ENV["SMTP_ENABLE_STARTTLS_AUTO"] != "false" && ENV["SMTP_STARTTLS"] != "false"
+    }
+
+    if user_name = ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence
+      smtp_settings[:user_name] = user_name
+      smtp_settings[:password] = ENV["SMTP_PASSWORD"]
+      smtp_settings[:authentication] = (ENV["SMTP_AUTHENTICATION"].presence || "plain").to_sym
+    end
+
+    smtp_settings[:tls] = true if ENV["SMTP_TLS"] == "true" || ENV["SMTP_PORT"] == "465"
+    smtp_settings[:ssl] = true if ENV["SMTP_SSL"] == "true"
+
+    if ENV["SMTP_OPENSSL_VERIFY_MODE"].present?
+      smtp_settings[:openssl_verify_mode] = ENV["SMTP_OPENSSL_VERIFY_MODE"]
+    end
+
+    config.action_mailer.smtp_settings = smtp_settings
+  end
+
