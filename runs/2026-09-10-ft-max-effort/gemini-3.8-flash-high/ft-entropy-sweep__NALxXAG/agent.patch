diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..6f20ae3 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,56 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due_to_be_postponed scope ignores closed, drafted, or already postponed cards" do
+    overdue_time = entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days
+
+    cards(:logo).update!(last_active_at: overdue_time, status: :published)
+    assert_includes Card.due_to_be_postponed, cards(:logo)
+
+    # Closed card should not be due
+    cards(:logo).close
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+    cards(:logo).reopen
+
+    # Postponed card should not be due
+    cards(:logo).postpone
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+    cards(:logo).resume
+
+    # Drafted card should not be due
+    cards(:logo).update!(status: :drafted)
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+  end
+
+  test "board-scoped due_to_be_postponed and postponing_soon scopes" do
+    board = boards(:writebook)
+    overdue_time = board.entropy.auto_postpone_period.seconds.ago - 2.days
+    soon_time = board.entropy.auto_postpone_period.seconds.ago + 2.days
+
+    cards(:logo).update!(board: board, last_active_at: overdue_time, status: :published)
+    cards(:layout).update!(board: board, last_active_at: soon_time, status: :published)
+
+    assert_includes board.cards.due_to_be_postponed, cards(:logo)
+    assert_not_includes board.cards.due_to_be_postponed, cards(:layout)
+
+    assert_includes board.cards.postponing_soon, cards(:layout)
+    assert_not_includes board.cards.postponing_soon, cards(:logo)
+  end
+
+  test "account-scoped due_to_be_postponed and postponing_soon scopes" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    overdue_time = board.entropy.auto_postpone_period.seconds.ago - 2.days
+    soon_time = board.entropy.auto_postpone_period.seconds.ago + 2.days
+
+    cards(:logo).update!(account: account, board: board, last_active_at: overdue_time, status: :published)
+    cards(:layout).update!(account: account, board: board, last_active_at: soon_time, status: :published)
+
+    assert_includes account.cards.due_to_be_postponed, cards(:logo)
+    assert_not_includes account.cards.due_to_be_postponed, cards(:layout)
+
+    assert_includes account.cards.postponing_soon, cards(:layout)
+    assert_not_includes account.cards.postponing_soon, cards(:logo)
+  end
 end
