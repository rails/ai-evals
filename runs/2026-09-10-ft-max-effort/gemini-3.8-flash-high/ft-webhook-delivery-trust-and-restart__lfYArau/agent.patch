diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..34c95ed
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "initial state" do
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert_not @tracker.delinquent?
+  end
+
+  test "record_failure increments count and sets first_failure_at" do
+    freeze_time do
+      @tracker.record_failure
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+
+      @tracker.record_failure
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+  end
+
+  test "record_success resets failures count and first_failure_at" do
+    @tracker.record_failure
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert_not_nil @tracker.first_failure_at
+
+    @tracker.record_success
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "does not switch off webhook with fewer than ten failures" do
+    @tracker.update!(first_failure_at: 2.hours.ago, consecutive_failures_count: 8)
+
+    @tracker.record_failure
+    assert_equal 9, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "does not switch off webhook with ten failures under an hour" do
+    @tracker.update!(first_failure_at: 30.minutes.ago, consecutive_failures_count: 9)
+
+    @tracker.record_failure
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "switches off webhook after ten failures in a row over an hour" do
+    @tracker.update!(first_failure_at: 65.minutes.ago, consecutive_failures_count: 9)
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      @tracker.record_failure
+    end
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert_not @webhook.active?
+  end
+
+  test "activating webhook resets delinquency tracker" do
+    @webhook.deactivate
+    @tracker.update!(first_failure_at: 2.hours.ago, consecutive_failures_count: 10)
+
+    @webhook.activate
+    @tracker.reload
+
+    assert @webhook.active?
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
