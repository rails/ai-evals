diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..a5f82e7
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,31 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  THRESHOLD = 10
+  DELINQUENCY_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset unless consecutive_failures_count.zero? && first_failure_at.nil?
+  end
+
+  def record_failure
+    with_lock do
+      self.first_failure_at ||= Time.current
+      self.consecutive_failures_count += 1
+      save!
+
+      if delinquent?
+        webhook.deactivate
+      end
+    end
+  end
+
+  def delinquent?
+    consecutive_failures_count >= THRESHOLD && first_failure_at.present? && first_failure_at <= DELINQUENCY_PERIOD.ago
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..6ef29c0 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,6 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +11,34 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+  scope :stale, -> { expired }
+
+  Job = Webhook::DeliveryJob
+
+  def self.cleanup
+    expired.delete_all
+  end
+
+  def deliver_later
+    Current.with(account: account) do
+      Webhook::DeliveryJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    return unless pending? && webhook.active?
+
+    in_progress!
+
+    post_payload
+
+    if succeeded?
+      webhook.delinquency_tracker.record_success
+    else
+      webhook.delinquency_tracker.record_failure
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +59,44 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def post_payload
+      payload = webhook.payload_for(event)
+      headers = request_headers_for(payload)
+
+      update! request: { headers: headers }
+
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = (uri.scheme == "https")
+      http.open_timeout = 10
+      http.read_timeout = 10
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = payload
+
+      response = http.request(request)
+
+      update! state: :completed, response: { code: response.code.to_i }
+    rescue StandardError => error
+      update! state: :errored, response: { error: error.message }
+    end
+
+    def request_headers_for(payload)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => signature_for(payload),
+        "X-Webhook-Timestamp" => timestamp
+      }
+    end
+
+    def signature_for(payload)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret.to_s, payload.to_s)
+    end
+
+    def timestamp
+      (event&.created_at || created_at || Time.current).utc.iso8601
+    end
 end
