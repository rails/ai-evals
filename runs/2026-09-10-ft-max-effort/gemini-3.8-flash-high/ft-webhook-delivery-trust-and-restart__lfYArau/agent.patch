--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,111 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "cleanup deletes deliveries older than a week" do
+    old_delivery = Webhook::Delivery.create!(
+      webhook: webhooks(:active),
+      event: events(:layout_commented),
+      created_at: 8.days.ago
+    )
+    recent_delivery = Webhook::Delivery.create!(
+      webhook: webhooks(:active),
+      event: events(:layout_commented),
+      created_at: 6.days.ago
+    )
+
+    assert_changes -> { Webhook::Delivery.where(id: old_delivery.id).exists? }, from: true, to: false do
+      Webhook::Delivery.cleanup
+    end
+
+    assert Webhook::Delivery.where(id: recent_delivery.id).exists?
+  end
+
+  test "deliver successfully" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 200, body: "ok")
+
+    delivery.deliver
+
+    assert_equal "completed", delivery.state
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig("headers", "User-Agent")
+    assert_equal "application/json", delivery.request.dig("headers", "Content-Type")
+    assert delivery.request.dig("headers", "X-Webhook-Signature").present?
+    assert_equal event.created_at.utc.iso8601, delivery.request.dig("headers", "X-Webhook-Timestamp")
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "deliver with HTTP failure" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 500, body: "Internal Error")
+
+    delivery.deliver
+
+    assert_equal "completed", delivery.state
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "deliver with network error" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_raise(Errno::ECONNREFUSED.new("Connection refused"))
+
+    delivery.deliver
+
+    assert_equal "errored", delivery.state
+    assert delivery.failed?
+    assert_includes delivery.response[:error], "Connection refused"
+    assert_equal 1, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "deliver delivers exactly once" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 200, body: "ok")
+
+    delivery.deliver
+    assert_equal "completed", delivery.state
+
+    # Second delivery attempt should do nothing
+    delivery.deliver
+    assert_requested :post, webhook.url, times: 1
+  end
+
+  test "deliver does not deliver when webhook is inactive" do
+    webhook = webhooks(:inactive)
+    event = events(:layout_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    delivery.deliver
+    assert_equal "pending", delivery.state
+  end
+
+  test "deliver switches off webhook after ten consecutive failures over an hour" do
+    webhook = webhooks(:active)
+    event = events(:layout_published)
+    tracker = webhook.delinquency_tracker
+    tracker.update!(first_failure_at: 70.minutes.ago, consecutive_failures_count: 9)
+
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    delivery.deliver
+
+    assert_not webhook.reload.active?
+    assert_equal 10, tracker.reload.consecutive_failures_count
+  end
 end
