diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..fbf1aaa
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "board is not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_nil @board.public_url
+  end
+
+  test "publish creates publication and generates key" do
+    publication = @board.publish
+
+    assert @board.published?
+    assert_equal publication, @board.publication
+    assert publication.key.present?
+    assert_equal @board.account, publication.account
+    assert_equal "http://example.com/public/boards/#{publication.key}", @board.public_url
+  end
+
+  test "publish is idempotent" do
+    pub1 = @board.publish
+    pub2 = @board.publish
+
+    assert_equal pub1, pub2
+  end
+
+  test "unpublish destroys publication and resets public_url" do
+    @board.publish
+    assert @board.published?
+
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_nil @board.public_url
+  end
+
+  test "unpublish is idempotent when not published" do
+    assert_nil @board.unpublish
+    assert_not @board.published?
+  end
+
+  test "destroying board destroys publication" do
+    @board.publish
+    publication_id = @board.publication.id
+
+    @board.destroy
+
+    assert_nil Board::Publication.find_by(id: publication_id)
+  end
+end
