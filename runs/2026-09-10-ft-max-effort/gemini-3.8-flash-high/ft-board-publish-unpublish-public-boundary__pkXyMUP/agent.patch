diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..b166211
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,93 @@
+<% @page_title = "#{@card.title} - #{@board.name}" %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <meta property="og:title" content="<%= "#{@card.title} | #{@board.name}" %>">
+  <meta property="og:description" content="<%= format_excerpt(@card&.description, length: 200) %>">
+  <meta property="og:url" content="<%= public_board_card_url(@publication.key, @card) %>">
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@publication.key), class: "btn btn--circle-mobile borderless" do %>
+      <%= icon_tag "arrow-left" %>
+      <span><%= @board.name %></span>
+    <% end %>
+  </div>
+<% end %>
+
+<div data-controller="lightbox">
+  <section id="<%= dom_id(@card, :card_container) %>" class="card-perma" style="--card-color: <%= @card.color %>;">
+    <div class="card-perma__bg">
+      <%= card_article_tag @card, class: "card" do %>
+        <header class="card__header">
+          <div class="card__board">
+            <%= render "cards/display/common/board", card: @card %>
+          </div>
+          <% if @card.tags.any? %>
+            <div class="card__tags-list min-width">
+              <% @card.tags.each_with_index do |tag, index| %>
+                <span class="card__tag min-width txt-uppercase">
+                  <%= tag.title %><%= "," unless index == @card.tags.size - 1 %>
+                </span>
+              <% end %>
+            </div>
+          <% end %>
+        </header>
+
+        <div class="card__body justify-space-between">
+          <div class="card__content">
+            <h1 class="card__title flex align-start gap-half">
+              <%= card_html_title(@card) %>
+            </h1>
+
+            <% unless @card.description.blank? %>
+              <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+                <%= @card.description %>
+              </div>
+            <% end %>
+
+            <% if @card.steps.any? %>
+              <ol class="steps txt-small margin-block-start-auto">
+                <% @card.steps.each do |step| %>
+                  <li class="step">
+                    <input type="checkbox" class="checkbox" <%= "checked" if step.completed? %> disabled>
+                    <span class="step__content <%= "completed" if step.completed? %>"><%= step.content %></span>
+                  </li>
+                <% end %>
+              </ol>
+            <% end %>
+          </div>
+
+          <% if @card.triaged? %>
+            <div class="card__column-name card__column-name--current btn" style="--column-color: <%= @card.column.color %>">
+              <span class="overflow-ellipsis"><%= @card.column.name %></span>
+            </div>
+          <% end %>
+
+          <%= render "cards/display/common/stamp", card: @card %>
+        </div>
+
+        <footer class="card__footer">
+          <%= render "cards/display/preview/meta", card: @card %>
+          <%= render "cards/display/perma/background", card: @card %>
+          <% if @card.reactions.any? %>
+            <div class="reactions">
+              <div id="<%= dom_id(@card, :reactions) %>" class="reactions__list">
+                <%= render partial: "reactions/reaction", collection: @card.reactions %>
+              </div>
+            </div>
+          <% end %>
+        </footer>
+      <% end %>
+    </div>
+  </section>
+
+  <% if @card.comments.any? %>
+    <%= messages_tag(@card) do %>
+      <%= render partial: "cards/comments/comment", collection: @card.comments.preloaded.chronologically, cached: true %>
+    <% end %>
+  <% end %>
+
+  <%= render "layouts/lightbox" %>
+</div>
