+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish a board" do
+    assert_not @board.published?
+
+    post board_publication_path(@board)
+
+    assert_redirected_to @board
+    assert @board.reload.published?
+    assert @board.publication.key.present?
+  end
+
+  test "admin can publish a board using direct id path" do
+    assert_not @board.published?
+
+    post "#{@board.account.slug}/boards/#{@board.id}/publication"
+
+    assert_redirected_to @board
+    assert @board.reload.published?
+  end
+
+  test "admin can publish a board as JSON" do
+    assert_not @board.published?
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal public_board_url(@board.publication.key, script_name: nil), @response.parsed_body["public_url"]
+  end
+
+  test "admin can unpublish a board" do
+    @board.publish
+    assert @board.published?
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to @board
+    assert_not @board.reload.published?
+  end
+
+  test "admin can unpublish a board as JSON" do
+    @board.publish
+    assert @board.published?
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot publish a board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot unpublish a board" do
+    @board.publish
+
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "non-admin cannot publish a board as JSON" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "unauthenticated user cannot publish a board" do
+    sign_out
+
+    post board_publication_path(@board)
+
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "publishing is idempotent" do
+    @board.publish
+    initial_key = @board.publication.key
+
+    post board_publication_path(@board)
+
+    assert_redirected_to @board
+    assert_equal initial_key, @board.reload.publication.key
+  end
+end
