+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+    @card = cards(:logo)
+  end
+
+  test "anyone can view a published card on a published board without authentication" do
+    get public_board_card_path(@key, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_select "a[href=?]", public_board_path(@key)
+  end
+
+  test "anyone can view a published card as JSON" do
+    get public_board_card_path(@key, @card), as: :json
+
+    assert_response :success
+    assert_equal @card.title, @response.parsed_body["title"]
+    assert_equal @card.number, @response.parsed_body["number"]
+  end
+
+  test "drafted card on published board returns 404" do
+    drafted_card = @board.cards.create!(creator: users(:kevin), title: "Draft card", status: "drafted")
+
+    get public_board_card_path(@key, drafted_card)
+
+    assert_response :not_found
+  end
+
+  test "drafted card as JSON returns 404" do
+    drafted_card = @board.cards.create!(creator: users(:kevin), title: "Draft card", status: "drafted")
+
+    get public_board_card_path(@key, drafted_card), as: :json
+
+    assert_response :not_found
+  end
+
+  test "card of another board returns 404" do
+    other_card = Current.set(user: users(:kevin)) { boards(:private).cards.create!(creator: users(:kevin), title: "Private card", status: "published", number: 999) }
+
+    get public_board_card_path(@key, other_card)
+
+    assert_response :not_found
+  end
+
+  test "non-existent card number returns 404" do
+    get public_board_card_path(@key, number: 999999)
+
+    assert_response :not_found
+  end
+
+  test "card on unpublished board returns 404" do
+    @board.unpublish
+
+    get public_board_card_path(@key, @card)
+
+    assert_response :not_found
+  end
+
+  test "card with non-existent board key returns 404" do
+    get public_board_card_path("nonexistent-key", @card)
+
+    assert_response :not_found
+  end
+end
