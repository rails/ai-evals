diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..cbb6ec1
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,29 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    publication&.destroy
+    reload_publication
+  end
+
+  def public_url
+    if published?
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+      Rails.application.routes.url_helpers.public_board_url(publication.key, **options.merge(script_name: nil))
+    end
+  end
+end
