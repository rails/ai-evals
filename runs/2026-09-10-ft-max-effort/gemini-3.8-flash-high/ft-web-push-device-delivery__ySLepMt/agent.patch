diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..75c83a7
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    @other_user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/kevin-1",
+          p256dh_key: "p256dh_sample_key",
+          auth_key: "auth_sample_key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/sub/kevin-1", subscription.endpoint
+    assert_equal "p256dh_sample_key", subscription.p256dh_key
+    assert_equal "auth_sample_key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create as HTML" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/kevin-html",
+          p256dh_key: "p256dh_sample_key",
+          auth_key: "auth_sample_key"
+        }
+      }
+    end
+
+    assert_redirected_to notifications_settings_path
+    assert_equal "Push notifications enabled", flash[:notice]
+  end
+
+  test "create updates existing subscription with same endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/kevin-existing",
+      p256dh_key: "old_p256dh",
+      auth_key: "old_auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "new_p256dh",
+          auth_key: "new_auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    subscription.reload
+    assert_equal "new_p256dh", subscription.p256dh_key
+    assert_equal "new_auth", subscription.auth_key
+  end
+
+  test "create reassigns endpoint if previously owned by another user" do
+    other_subscription = @other_user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/shared-device",
+      p256dh_key: "p256dh_key",
+      auth_key: "auth_key"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      assert_difference -> { @other_user.push_subscriptions.count }, -1 do
+        post user_push_subscriptions_path(@user), params: {
+          push_subscription: {
+            endpoint: other_subscription.endpoint,
+            p256dh_key: "p256dh_key",
+            auth_key: "auth_key"
+          }
+        }, as: :json
+      end
+    end
+
+    assert_response :created
+    assert @user.push_subscriptions.exists?(endpoint: other_subscription.endpoint)
+    assert_not @other_user.push_subscriptions.exists?(endpoint: other_subscription.endpoint)
+  end
+
+  test "cannot create subscription for another user" do
+    assert_no_difference "Push::Subscription.count" do
+      post user_push_subscriptions_path(@other_user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/hack",
+          p256dh_key: "p256dh_key",
+          auth_key: "auth_key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create requires authentication" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://push.example.com/sub/1",
+        p256dh_key: "p256dh_key",
+        auth_key: "auth_key"
+      }
+    }, as: :json
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "destroy all subscriptions for user" do
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "key1",
+      auth_key: "auth1"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy subscription by endpoint" do
+    sub1 = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "key1",
+      auth_key: "auth1"
+    )
+    sub2 = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/2",
+      p256dh_key: "key2",
+      auth_key: "auth2"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { endpoint: sub1.endpoint }, as: :json
+    end
+
+    assert_response :no_content
+    assert_not @user.push_subscriptions.exists?(sub1.id)
+    assert @user.push_subscriptions.exists?(sub2.id)
+  end
+
+  test "destroy specific subscription by id" do
+    sub = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "key1",
+      auth_key: "auth1"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, sub), as: :json
+    end
+
+    assert_response :no_content
+    assert_not @user.push_subscriptions.exists?(sub.id)
+  end
+end
