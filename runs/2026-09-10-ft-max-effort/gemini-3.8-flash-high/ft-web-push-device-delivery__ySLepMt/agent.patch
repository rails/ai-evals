new file mode 100644
index 0000000..0164fe8
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,51 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    Push::Subscription.where(endpoint: push_subscription_params[:endpoint]).where.not(user_id: @user.id).destroy_all
+
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.assign_attributes(push_subscription_params.merge(user_agent: request.user_agent))
+
+    if @push_subscription.save
+      respond_to do |format|
+        format.html { redirect_back fallback_location: notifications_settings_path, notice: "Push notifications enabled" }
+        format.json { render json: @push_subscription, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_back fallback_location: notifications_settings_path, alert: "Could not enable push notifications" }
+        format.json { render json: @push_subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    if params[:endpoint].present?
+      @user.push_subscriptions.where(endpoint: params[:endpoint]).destroy_all
+    elsif params[:id].present?
+      @user.push_subscriptions.find_by(id: params[:id])&.destroy
+    else
+      @user.push_subscriptions.destroy_all
+    end
+
+    respond_to do |format|
+      format.html { redirect_back fallback_location: notifications_settings_path, notice: "Push notifications disabled" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..3ec679e
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,185 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "button", "help" ]
+  static values = {
+    url: String,
+    vapidPublicKey: String
+  }
+
+  connect() {
+    this.boundUpdateState = this.updateState.bind(this)
+    window.addEventListener("focus", this.boundUpdateState)
+    document.addEventListener("visibilitychange", this.boundUpdateState)
+
+    this.updateState()
+  }
+
+  disconnect() {
+    window.removeEventListener("focus", this.boundUpdateState)
+    document.removeEventListener("visibilitychange", this.boundUpdateState)
+  }
+
+  async subscribe() {
+    if (!this.supported) return
+
+    try {
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") {
+        this.updateState()
+        return
+      }
+
+      const registration = await this.serviceWorkerRegistration
+      if (!registration) return
+
+      let subscription = await registration.pushManager.getSubscription()
+      if (!subscription) {
+        const vapidKey = this.vapidKey
+        const options = { userVisibleOnly: true }
+        if (vapidKey) {
+          options.applicationServerKey = this.urlBase64ToUint8Array(vapidKey)
+        }
+        subscription = await registration.pushManager.subscribe(options)
+      }
+
+      await this.saveSubscription(subscription)
+      this.element.classList.add("notifications--on")
+      this.hideDetails()
+    } catch (error) {
+      console.error("Error subscribing to push notifications:", error)
+      this.updateState()
+    }
+  }
+
+  async unsubscribe() {
+    if (!this.supported) return
+
+    try {
+      const registration = await this.serviceWorkerRegistration
+      if (registration) {
+        const subscription = await registration.pushManager.getSubscription()
+        if (subscription) {
+          await this.removeSubscription(subscription)
+          await subscription.unsubscribe()
+        }
+      }
+    } catch (error) {
+      console.error("Error unsubscribing from push notifications:", error)
+    } finally {
+      this.element.classList.remove("notifications--on")
+      this.updateState()
+    }
+  }
+
+  async updateState() {
+    if (!this.supported) {
+      this.hideDetails()
+      if (this.hasButtonTarget) {
+        this.buttonTarget.disabled = true
+      }
+      return
+    }
+
+    const permission = Notification.permission
+
+    if (permission === "granted") {
+      this.element.classList.add("notifications--on")
+      this.hideDetails()
+      if (this.hasButtonTarget) {
+        this.buttonTarget.disabled = false
+      }
+    } else if (permission === "denied") {
+      this.element.classList.remove("notifications--on")
+      this.showDetails()
+      if (this.hasButtonTarget) {
+        this.buttonTarget.disabled = true
+      }
+    } else {
+      this.element.classList.remove("notifications--on")
+      this.hideDetails()
+      if (this.hasButtonTarget) {
+        this.buttonTarget.disabled = false
+      }
+    }
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach((element) => {
+      element.hidden = false
+    })
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach((element) => {
+      element.hidden = true
+    })
+  }
+
+  get supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get serviceWorkerRegistration() {
+    return navigator.serviceWorker.ready
+  }
+
+  get vapidKey() {
+    if (this.hasVapidPublicKeyValue && this.vapidPublicKeyValue) {
+      return this.vapidPublicKeyValue
+    }
+    return document.querySelector('meta[name="vapid-public-key"]')?.content
+  }
+
+  get subscriptionUrl() {
+    if (this.hasUrlValue && this.urlValue) {
+      return this.urlValue
+    }
+    const userId = document.querySelector('meta[name="current-user-id"]')?.content
+    return `/users/${userId}/push_subscriptions`
+  }
+
+  async saveSubscription(subscription) {
+    const json = subscription.toJSON()
+    const p256dhKey = json.keys?.p256dh || this.arrayBufferToBase64(subscription.getKey?.("p256dh"))
+    const authKey = json.keys?.auth || this.arrayBufferToBase64(subscription.getKey?.("auth"))
+
+    await post(this.subscriptionUrl, {
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: p256dhKey,
+          auth_key: authKey
+        }
+      }),
+      contentType: "application/json"
+    })
+  }
+
+  async removeSubscription(subscription) {
+    await destroy(this.subscriptionUrl, {
+      body: JSON.stringify({ endpoint: subscription.endpoint }),
+      contentType: "application/json"
+    })
+  }
+
+  urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+    return outputArray
+  }
+
+  arrayBufferToBase64(buffer) {
+    if (!buffer) return ""
+    return btoa(String.fromCharCode.apply(null, new Uint8Array(buffer)))
+      .replace(/\+/g, "-")
+      .replace(/\//g, "_")
+      .replace(/=+$/, "")
+  }
+}
