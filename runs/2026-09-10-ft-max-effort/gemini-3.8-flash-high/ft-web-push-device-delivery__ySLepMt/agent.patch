 end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..eafee5a
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @vapid_keys = WebPush.generate_key
+  end
+
+  test "validates required attributes" do
+    subscription = Push::Subscription.new(user: @user)
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+
+    subscription.endpoint = "https://push.example.com/sub/1"
+    subscription.p256dh_key = "test_p256dh"
+    subscription.auth_key = "test_auth"
+    assert subscription.valid?
+  end
+
+  test "belongs to user and account" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "test_p256dh",
+      auth_key: "test_auth"
+    )
+
+    assert_equal @user, subscription.user
+    assert_equal @user.account, subscription.account
+  end
+
+  test "vapid_configured? checks for public and private keys" do
+    with_env "VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil do
+      assert_not Push::Subscription.vapid_configured?
+    end
+
+    with_env "VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => nil do
+      assert_not Push::Subscription.vapid_configured?
+    end
+
+    with_env "VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key do
+      assert Push::Subscription.vapid_configured?
+    end
+  end
+
+  test "deliver sends payload to push service" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "test_p256dh",
+      auth_key: "test_auth"
+    )
+
+    with_env "VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key do
+      WebPush.expects(:payload_send).with(
+        endpoint: subscription.endpoint,
+        message: @notification.to_push_payload.to_json,
+        p256dh: subscription.p256dh_key,
+        auth: subscription.auth_key,
+        vapid: {
+          public_key: @vapid_keys.public_key,
+          private_key: @vapid_keys.private_key,
+          subject: Push::Subscription.vapid_subject
+        }
+      )
+
+      subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver does nothing if vapid is not configured" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "test_p256dh",
+      auth_key: "test_auth"
+    )
+
+    with_env "VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil do
+      WebPush.expects(:payload_send).never
+      subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver destroys subscription on ExpiredSubscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "test_p256dh",
+      auth_key: "test_auth"
+    )
+
+    with_env "VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key do
+      response = stub(inspect: "410 Gone", body: "Expired")
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver(@notification)
+      end
+
+      assert_not Push::Subscription.exists?(subscription.id)
+    end
+  end
+
+  test "deliver destroys subscription on InvalidSubscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "test_p256dh",
+      auth_key: "test_auth"
+    )
+
+    with_env "VAPID_PUBLIC_KEY" => @vapid_keys.public_key, "VAPID_PRIVATE_KEY" => @vapid_keys.private_key do
+      response = stub(inspect: "404 Not Found", body: "Not Found")
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        subscription.deliver(@notification)
+      end
+
+      assert_not Push::Subscription.exists?(subscription.id)
+    end
+  end
+
+  private
+    def with_env(hash)
+      old = {}
+      hash.each { |k, v| old[k] = ENV[k]; ENV[k] = v }
+      yield
+    ensure
+      old.each { |k, v| ENV[k] = v }
+    end
+end
