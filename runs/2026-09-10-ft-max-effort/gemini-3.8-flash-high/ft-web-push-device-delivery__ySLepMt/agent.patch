+  test "push notification is delivered on create when user has subscription and vapid is configured" do
+    kevin = users(:kevin)
+    notifications(:layout_commented_kevin).destroy
+    kevin.push_subscriptions.destroy_all
+
+    vapid_keys = WebPush.generate_key
+    subscription = kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    with_env "VAPID_PUBLIC_KEY" => vapid_keys.public_key, "VAPID_PRIVATE_KEY" => vapid_keys.private_key do
+      WebPush.expects(:payload_send).once
+
+      perform_enqueued_jobs do
+        Notification.create!(user: kevin, source: events(:layout_commented), creator: users(:david))
+      end
+    end
+  end
+
+  test "push notification is delivered on update with new source" do
+    kevin = users(:kevin)
+    notification = notifications(:logo_assignment_kevin)
+    kevin.push_subscriptions.destroy_all
+
+    vapid_keys = WebPush.generate_key
+    subscription = kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    with_env "VAPID_PUBLIC_KEY" => vapid_keys.public_key, "VAPID_PRIVATE_KEY" => vapid_keys.private_key do
